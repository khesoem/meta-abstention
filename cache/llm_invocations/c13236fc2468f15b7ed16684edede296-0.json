n    vector<int> res;\n    int total_masks = 1 << cnt;\n    for (int mask = 0; mask < total_masks; ++mask) {\n        int total = 0;\n        for (int bit = 0; bit < 20; ++bit) {\n            if (mask & (1 << bit)) {\n                total += a[start + bit];\n            }\n        }\n        res.push_back(total % m);\n    }\n    return res;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<int> a(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> a[i];\n    }\n    int half = n / 2 + n % 2;\n    vector<int> b = get_sums(a, 0, half);\n    sort(b.begin(), b.end());\n    int otv = 0;\n    int second_half_size = n / 2;\n    int total_masks_second = 1 << second_half_size;\n    for (int mask = 0; mask < total_masks_second; ++mask) {\n        int t = 0;\n        for (int bit = 0; bit < 20; ++bit) {\n            if (mask & (1 << bit)) {\n                t += a[half + bit];\n            }\n        }\n        t %= m;\n        int target = m - t - 1;\n        auto it = upper_bound(b.begin(), b.end(), target);\n        int idx = it - b.begin() - 1;\n        int t2;\n        if (idx >= 0) {\n            t2 = b[idx];\n        } else {\n            t2 = b[0];\n        }\n        otv = max(otv, (t + t2) % m);\n        otv = max(otv, (t + b.back()) % m);\n    }\n    cout << otv % m << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.364403477869928e-06, -0.0010536124464124441, -5.960462772236497e-07, 0.0, 0.0, -8.093983342405409e-05, -0.0002967870968859643, -2.3841855067985307e-07, -0.00020418466010596603, -1.0132738680113107e-05, 0.0, 0.0, -8.344646857949556e-07, -1.7881377516459906e-06, 0.0, 0.0, 0.0, -0.47413694858551025, -0.3868751525878906, 0.0, -0.17045682668685913, -0.1305212676525116, -0.009349136613309383, -5.960462772236497e-07, 0.0, -5.245195097813848e-06, -0.10146281123161316, -0.0007099968497641385, 0.0, -8.344646857949556e-07, -3.6238969187252223e-05, -2.3841855067985307e-07, -0.00047612775233574