) { started = true; neg = true; continue; }\n        if (ch >= '0' && ch <= '9') { started = true; res = res * 10 + ch - '0'; }\n        else if (started) break;\n      }\n    } catch (IOException e) {}\n    return neg ? -res : res;\n  }\n\n  static String nextString() {\n    StringBuilder sb = new StringBuilder();\n    try {\n      boolean started = false;\n      for (int ch; (ch = System.in.read()) != -1; ) {\n        if (!Character.isWhitespace(ch)) { started = true; sb.append((char) ch); }\n        else if (started) break;\n      }\n    } catch (IOException e) {}\n    return sb.toString();\n  }\n\n  void dfs(long x, long y, int v1, int v2) {\n    long diff = Math.abs(x - y);\n    if (best <= 1 || diff - binom[v1][R] * binom[v2][R] >= best) return;\n    if (v1 == R - 1 && v2 == R - 1) { if (diff < best) best = diff; return; }\n    long key = x * 10000L + v1 * 100L + v2;\n    if (visited.contains(key)) return;\n    if (v1 >= R) {\n      long cur = binom[v1][R] - binom[v1 - 1][R];\n      long other = binom[v2][R];\n      dfs(x, y + cur * other, v1 - 1, v2);\n    }\n    if (v2 >= R) {\n      long cur = binom[v2][R] - binom[v2 - 1][R];\n      long other = binom[v1][R];\n      dfs(x + cur * other, y, v1, v2 - 1);\n    }\n    visited.add(key);\n  }\n\n  long solve(long x, long y, int v1, int v2) {\n    long diff = Math.abs(x - y);\n    if (diff - binom[v1][R] * binom[v2][R] > best) return 0;\n    long key = x * 10000L + v1 * 100L + v2;\n    Long cached = memo.get(key);\n    if (cached != null) return cached;\n    if (v1 < R || v2 < R) {\n      if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n        int sum = v1 + v2;\n        v1 -= cntA[sum];\n        v2 -= cntB[sum];\n        return binom[v1 + v2][v1];\n      }\n      return 0;\n    }\n    long ans = 0;\n    char c = s.charAt(v1 + v2 - 1);\n    if (c != 'B') {\n      long cur = binom[v1][R] - binom[v1 - 1][R];\n      long other = binom[v2][R];\n      ans += solve(x, y + cur * other, v1 - 1, v2);\n    }\n    if (c !