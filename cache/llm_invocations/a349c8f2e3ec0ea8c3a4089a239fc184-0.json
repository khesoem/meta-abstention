r (int j = 1; j <= k + 1; j++) {\n                res.a[id(i, step, k)][id(j, step, k)] = Base.a[i][j];\n            }\n        }\n        return res;\n    }\n    \n    static Matrix multiply(Matrix lhs, Matrix rhs) {\n        Matrix res = new Matrix();\n        for (int i = 1; i <= lhs.a.length - 1; i++) {\n            for (int kk = 1; kk <= lhs.a.length - 1; kk++) {\n                if (lhs.a[i][kk] != 0) {\n                    for (int j = 1; j <= lhs.a.length - 1; j++) {\n                        res.a[i][j] = (int)((res.a[i][j] + 1L * lhs.a[i][kk] * rhs.a[kk][j]) % Mod);\n                    }\n                }\n            }\n        }\n        return res;\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        long n = Long.parseLong(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        \n        Matrix[] A = new Matrix[K];\n        for (int i = 0; i < K; i++) {\n            A[i] = new Matrix();\n        }\n        \n        A[0].Unit(k + 1);\n        for (int i = 1; i <= k + 1; i++) {\n            A[0].a[1][i] = 1;\n        }\n        \n        List<Integer> V = new ArrayList<>();\n        long tempN = n;\n        while (tempN > 0) {\n            V.add((int)(tempN % k));\n            tempN /= k;\n        }\n        \n        for (int len = 0; len < V.size(); len++) {\n            if (len > 0) {\n                A[len].Unit(k + 1);\n            }\n            Matrix x = A[len];\n            if (len == 0) {\n                x = A[0];\n            }\n            \n            for (long power = k, p = 0; power > 0; power >>= 1) {\n                if ((power & 1) == 1) {\n                    A[len + 1] = multiply(A[len + 1], Move(x, (int)((power ^ 1) << p), k));\n                }\n                x = multiply(Move(x, (int)(1 << p), k), x);\n                p++;\n