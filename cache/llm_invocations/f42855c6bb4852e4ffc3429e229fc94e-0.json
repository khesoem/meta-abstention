if (residual(id) == 0) continue;\n            int u = to[id];\n            int w = cost[id];\n            if (dist[u] > dist[v] + w) {\n                dist[u] = dist[v] + w;\n                parent[u] = v;\n                parentEdge[u] = id;\n                if (!inQueue[u]) {\n                    inQueue[u] = 1;\n                    q.push(u);\n                }\n            }\n        }\n    }\n\n    int cur = sink;\n    while (cur != source) {\n        int id = parentEdge[cur];\n        flow[id]++;\n        flow[id ^ 1]--;\n        cur = parent[cur];\n    }\n    answer += dist[sink];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        addEdge(source, x, 1, 0);\n    }\n\n    const int TIMES = 101;\n\n    for (int i = 0; i < TIMES; ++i) {\n        addEdge(0 + i * n, sink, k, i * c);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n\n        for (int tm = 0; tm < TIMES - 1; ++tm) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(x + tm * n, y + tm * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n        for (int tm = 0; tm < TIMES - 1; ++tm) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(y + tm * n, x + tm * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n\n    for (int i = 0; i < n; ++i) {\n        for (int tm = 0; tm < TIMES - 1; ++tm) {\n            addEdge(i + tm * n, i + tm * n + n, k, 0);\n        }\n    }\n\n    for (int i = 0; i < k; ++i) {\n        push_flow();\n    }\n\n    cout << answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    TIMES = 101\n    total_nodes = n * TIMES + 2\n    source = total_nodes - 2\n    sink = total_nodes - 1\n\n    adj = [[] for _ in range(total_nodes)]\n    to = []\n    cap = []\n    flow = []\n    cost = []\n\n    INF = 10**18\n\n    def add_edge(u: int, v: int, c: int, w: int) -> None:\n        id = len(to)\n        adj[u].append(id)\n        to.append(v)\n        cap.append(c)\n        flow.append(0)\n        cost.append(w)\n\n        adj[v].append(id + 1)\n        to.append(u)\n        cap.append(0)\n        flow.append(0)\n        cost.append(-w)\n\n    # read starting positions\n    for _ in range(k):\n        x = int(next(it)) - 1\n        add_edge(source, x, 1, 0)\n\n    # edges from each time layer to sink\n    for i in range(TIMES):\n        add_edge(0 + i * n, sink, k, i * c)\n\n    # read roads and add edges for each time step\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for tm in range(TIMES - 1):\n            for j in range(k):\n                add_edge(x + tm * n, y + tm * n + n, 1, d * (j * 2 + 1))\n        for tm in range(TIMES - 1):\n            for j in range(k):\n                add_edge(y + tm * n, x + tm * n + n, 1, d * (j * 2 + 1))\n\n    # self-loop edges (stay in place)\n    for i in range(n):\n        for tm in range(TIMES - 1):\n            add_edge(i + tm * n, i + tm * n + n, k, 0)\n\n    answer = 0\n\n    def push_flow() -> None:\n        nonlocal answer\n        dist = [INF] * total_nodes\n        parent = [-1] * total_nodes\n        parent_edge = [-1] * total_nodes\n        in_queue = [0] * total_nodes\n\n        dist[source] = 0\n        q = deque()\n        q.append(source)\n        in_queue[source] = 1\n\n        while q:\n            v = q.popleft()\n            in_queue[v] = 0\n            for eid in adj[v]:\n                if cap[eid] - flow[eid] == 0:\n                    continue\n                u = to[eid]\n                w = cost[eid]\n                if dist[u] > dist[v] + w:\n                    dist[u] = dist[v] + w\n                    parent[u] = v\n                    parent_edge[u] = eid\n                    if not in_queue[u]:\n                        in_queue[u] = 1\n                        q.append(u)\n\n        cur = sink\n        while cur != source:\n            eid = parent_edge[cur]\n            flow[eid] += 1\n            flow[eid ^ 1] -= 1\n            cur = parent[cur]\n        answer += dist[sink]\n\n    for _ in range(k):\n        push_flow()\n\n    print(answer)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.2411095415009186e-05, 0.0, 0.0, -0.0001821352052502334, -0.07943128794431686, -4.589452510117553e-05, -3.814624506048858e-05, -3.58813522325363e-05, -1.5497195136049413e-06, 0.0, -2.861018856492592e-06, -0.0005595310358330607, -0.6091272830963135, -0.1979600340127945, -0.4741111397743225, -1.6093124941107817e-05, -1.6689160474925302e-05, -1.4305104514278355e-06, -4.768370445162873e-07, -0.10344578325748444, -4.172316494077677e-06, -0.008691812865436077, 0.0, -0.00333574740216136, -1.4305104514278355e-06, -0.3868773281574249, -2.264974000354414e-06, 0.0, -1.9073468138230965e-06, -2.3841855067985307e-07, -0.0007110689766705036, 0.0, 0.0, -0.00020346954988781363, -2.3841855067985307e-07, 0.0, -1.0251946150674485e-05, -4.768370445162873e-07, -4.851700214203447e-05, 0.0, 0.0, -7.497983460780233e-05, -0.002478862414136529, -0.0011703077470883727, -5.9960475482512265e-05, -5.364403477869928e-06, -1.1920928244535389e-07, 0.0, 0.0, -0.004095738288015127, 0.0, -1.1920928244535389e-07, -6.9141146923357155e-06, 0.0, -1.1920928244535389e-07, 0.0, -2.9802276912960224e-06, -1.1920928244535389e-07, -3.576272320060525e-06, -0.0006283930852077901, 