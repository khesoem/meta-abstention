  continue;\n        if(int df = dfs(v, min(f, e.cap - e.f))) {\n            e.f += df;\n            adj[v][e.rev].f -= df;\n            return df;\n        }\n    }\n    return 0;\n}\n\nint mf() {\n    int res = 0;\n    while(bfs()) {\n        memset(ptr, 0, sizeof ptr);\n        while(int df = dfs(src, INF))\n            res += df;\n    }\n    return res;\n}\n\nint dx[] = {-1, 0, 0, 1};\nint dy[] = {0, -1, 1, 0};\n\nint n, m;\ntypedef vector<vector<int>> grid;\ntypedef array<int, 2> pa;\ngrid obs, tim, dii;\n\nvoid gbfs(int r, int c, grid &dis, bool chk = false) {\n    for(int i = 0; i < n; i++)\n        fill(dis[i].begin(), dis[i].end(), -1);\n    dis[r][c] = 0;\n    queue<pa> q;\n    q.push({r, c});\n    while(q.size()) {\n        auto p = q.front(); q.pop();\n        if(chk && dis[p[0]][p[1]] == tim[p[0]][p[1]])\n        \tcontinue;\n        pa r;\n        for(int i = 0; i < 4; i++) {\n            r = {p[0] + dx[i], p[1] + dy[i]};\n            if(r[0] < 0 || r[0] >= n || r[1] < 0 || r[1] >= n || dis[r[0]][r[1]] != -1 || obs[r[0]][r[1]]) \n                continue;\n            if(chk && tim[r[0]][r[1]] > -1 && dis[p[0]][p[1]] + 1 > tim[r[0]][r[1]])\n            \tcontinue;\n            dis[r[0]][r[1]] = dis[p[0]][p[1]] + 1;\n            q.push(r);\n        }\n    }\n}\n\nvector<string> lab, rea;\n\nint main() {\n    cin >> n >> m;\n    lab.resize(n);\n    rea.resize(n);\n    for(auto &x : lab)\n        cin >> x;\n    for(auto &x : rea)\n        cin >> x;\n    obs.assign(n, vector<int>(n));\n    tim.assign(n, vector<int>(n));\n    dii.assign(n, vector<int>(n));\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tobs[i][j] = (lab[i][j] == 'Y');\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tif(lab[i][j] == 'Z')\n    \t\t\tgbfs(i, j, tim);\n    src = 2*n*n + 5;\n    dst = src + 1;\n    for(int x = 0; x < n; x++) {\n    \tfor(int y = 0; y < n; y++) {\n    \t\tif(lab[x][y] == 'Z' || lab[x][y] == 'Y')\n    \t\t\tcontinue;\n    \t\tadd_edge(src, n*x + y, lab[x][y] - '0');\n    \t\tadd_edge(n*n + n*x + y, dst, rea[x][y] - '0');\n    \t\tgbfs(x, y, dii, true);\n    \t\tfor(int xp = 0; xp < n; xp++) {\n    \t\t\tfor(int yp = 0; yp < n; yp++) {\n    \t\t\t\tif(dii[xp][yp] != -1 && dii[xp][yp] <= m) {\n    \t\t\t\t\tadd_edge(n*x + y, n*n + n*xp + yp, INF);\n    \t\t\t\t}\n    \t\t\t}\n    \t\t}\n    \t}\n    }\n    cout << mf() << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 300\nINF = 10**9\n\nclass Edge:\n    def __init__(self, to, rev, f, cap):\n        self.to = to\n        self.rev = rev\n        self.f = f\n        self.cap = cap\n\nadj = [[] for _ in range(MAXN)]\ndis = [-1] * MAXN\nptr = [0] * MAXN\nsrc = 0\ndst = 0\n\ndef add_edge(u, v, c, rc=0):\n    a = Edge(v, len(adj[v]), 0, c)\n    b = Edge(u, len(adj[u]), 0, rc)\n    adj[u].append(a)\n    adj[v].append(b)\n\ndef bfs():\n    for i in range(len(dis)):\n        dis[i] = -1\n    dis[src] = 0\n    q = deque([src])\n    while q and dis[dst] == -1:\n        u = q.popleft()\n        for e in adj[u]:\n            v = e.to\n            if dis[v] == -1 and e.f < e.cap:\n                dis[v] = dis[u] + 1\n                q.append(v)\n    return dis[dst] != -1\n\ndef dfs(u, f):\n    if u == dst or f == 0:\n        return f\n    for i in range(ptr[u], len(adj[u])):\n        e = adj[u][i]\n        v = e.to\n        if dis[v] != dis[u] + 1:\n            continue\n        df = dfs(v, min(f, e.cap - e.f))\n        if df:\n            e.f += df\n            adj[v][e.rev].f -= df\n            return df\n        ptr[u] = i + 1\n    return 0\n\ndef mf():\n    res = 0\n    while bfs():\n        for i in range(len(ptr)):\n            ptr[i] = 0\n        while True:\n            df = dfs(src, INF)\n            if df == 0:\n                break\n            res += df\n    return res\n\ndx = [-1, 0, 0, 1]\ndy = [0, -1, 1, 0]\n\nn, m = map(int, sys.stdin.readline().split())\nlab = [sys.stdin.readline().strip() for _ in range(n)]\nrea = [sys.stdin.readline().strip() for _ in range(n)]\nobs = [[0]*n for _ in range(n)]\ntim = [[-1]*n for _ in range(n)]\ndii = [[-1]*n for _ in range(n)]\n\nfor i in range(n):\n    for j in range(n):\n        obs[i][j] = 1 if lab[i][j]=='Y' else 0\n\ndef gbfs(r, c, dis, chk=False):\n    for i in range(n):\n        for j in range(n):\n            dis[i][j] = -1\n    dis[r][c] = 0\n    q = deque()\n    q.append((r, c))\n    while q:\n        p = q.popleft()\n        if chk and dis[p[0]][p[1]] == tim[p[0]][p[1]]:\n            continue\n        for i in range(4):\n            nr, nc = p[0] + dx[i], p[1] + dy[i]\n            if 0 <= nr < n and 0 <= nc < n and dis[nr][nc] == -1 and not obs[nr][nc]:\n                if chk and tim[nr][nc] > -1 and dis[p[0]][p[1]] + 1 > tim[nr][nc]:\n                    continue\n                dis[nr][nc] = dis[p[0]][p[1]] + 1\n                q.append((nr, nc))\n\nfor i in range(n):\n    for j in range(n):\n        if lab[i][j] == 'Z':\n            gbfs(i, j, tim)\nfor i in range(n):\n    for j in range(n):\n        if lab[i][j] == 'Z':\n            continue\n        if lab[i][j] != 'Y':\n            add_edge(0, n * i + j, int(lab[i][j]))\n        add_edge(n * n + n * i + j, 1, int(rea[i][j]))\n        gbfs(i, j, dii, True)\n        for xp in range(n):\n            for yp in range(n):\n                if dii[xp][yp] != -1 and dii[xp][yp] <= m:\n                    add_edge(n * i + j, n * n + n * xp + yp, INF)\n\nprint(mf())\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00046510808169841766, -0.002997196977958083, -1.9361264946837764e-07, -2.3915141355246305e-05, -0.11114395409822464, -3.380904672667384e-05, -8.77627644513268e-06, -0.00483617652207613, -1.1279553291387856e-05, 0.0, -2.45848218582978e-06, -0.0893268883228302, -0.000301738531561