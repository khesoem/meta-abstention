dx) {\n            if (!nxt_st[idx]) {\n                int ol = a & idx;\n                bool ok = false;\n                while (ol) {\n                    int b = get_lb(ol);\n                    if (st[idx ^ b]) {\n                        nxt_st[idx] = 1;\n                        ok = true;\n                        break;\n                    }\n                    ol -= b;\n                }\n                if (!ok) nxt_st[idx] = 0;\n            }\n        }\n        trie[node][a] = traverse(nxt_st);\n    }\n    return node;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N;\n    traverse({1});\n    \n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            cin >> adj[i][j];\n            adj[i][j] = mod_mul(adj[i][j], mod_exp(100, MOD - 2));\n        }\n    }\n    \n    for (int i = 0; i < N; ++i) {\n        for (int mask = 0; mask < (1 << N); ++mask) {\n            prob_table[i][mask] = 1;\n            for (int k = 0; k < N; ++k) {\n                if ((mask >> k) & 1)\n                    prob_table[i][mask] = mod_mul(prob_table[i][mask], adj[i][k]);\n                else\n                    prob_table[i][mask] = mod_mul(prob_table[i][mask], mod_dec(1, adj[i][k]));\n            }\n        }\n    }\n    \n    dp[0][1] = 1;\n    for (int step = 1; step <= N; ++step) {\n        for (int node = 1; node <= node_cnt; ++node) {\n            for (int act = 0; act < (1 << N); ++act) {\n                int next_node = trie[node][act];\n                dp[step][next_node] = mod_inc(dp[step][next_node], mod_mul(dp[step - 1][node], prob_table[step - 1][act]));\n            }\n        }\n    }\n    \n    bitset<128> full;\n    for (int i = 0; i < 128; ++i) full[i] = 1;\n    cout << dp[N][state_to_node[full]] << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport