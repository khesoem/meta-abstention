n\npublic class Main {\n    static final int N = 505;\n    static int n, m, md;\n    static long[] fac, inv, f, g;\n    static long[][][] dp, dp2;\n\n    static long add(long x, long y) {\n        x += y;\n        if (x >= md) x -= md;\n        return x;\n    }\n\n    static long sub(long x, long y) {\n        x -= y;\n        if (x < 0) x += md;\n        return x;\n    }\n\n    static long mul(long x, long y) {\n        return (x * y) % md;\n    }\n\n    static long fpow(long x, long y) {\n        long ans = 1;\n        while (y > 0) {\n            if ((y & 1) == 1) ans = mul(ans, x);\n            y >>= 1;\n            x = mul(x, x);\n        }\n        return ans;\n    }\n\n    static long C(int n, int m) {\n        if (m < 0 || m > n) return 0;\n        return mul(fac[n], mul(inv[m], inv[n - m]));\n    }\n\n    static long readLong() throws IOException {\n        long f = 0;\n        int c = System.in.read();\n        boolean neg = false;\n        while (c < '0' || c > '9') {\n            if (c == '-') neg = true;\n            c = System.in.read();\n        }\n        while (c >= '0' && c <= '9') {\n            f = (f << 3) + (f << 1) + (c & 15);\n            c = System.in.read();\n        }\n        if (neg) f = -f;\n        return f;\n    }\n\n    static void print(long x) {\n        if (x < 0) {\n            System.out.write('-');\n            x = -x;\n        }\n        if (x < 10) {\n            System.out.write((int)(x + 48));\n        } else {\n            print(x / 10);\n            System.out.write((int)(x % 10 + 48));\n        }\n    }\n\n    static void print(long x, char t) {\n        print(x);\n        System.out.write(t);\n    }\n\n    public static void main(String[] args) throws IOException {\n        n = (int)readLong();\n        m = (int)readLong();\n        md = (int)readLong();\n\n        fac = new long[N];\n        inv = new long[N];\n        f = new long[N];\n        g = new long[N];\n        dp = new long[N][N][2];\n        dp2 = new long[N][N][2];\n\n        fac[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            fac[i] = mul(fac[i - 1], i);\n        }\n        inv[n] = fpow(fac[n], md - 2);\n        for (int i = n; i >= 1; i--) {\n            inv[i - 1] = mul(inv[i], i);\n        }\n\n        f[0] = 0;\n        g[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= i; j++) {\n                long now = mul(C(i - 1, j - 1), i + 1);\n                g[i] = add(g[i], mul(mul(g[j - 1], g[i - j]), now));\n                f[i] = add(f[i], mul(mul(f[j - 1], g[i - j]), now));\n                f[i] = add(f[i], mul(mul(g[j - 1], f[i - j]), now));\n                f[i] = add(f[i], mul(mul(C(i - 1, j - 1), mul(g[j - 1], g[i - j])), (j - 1) * j / 2 + (i - j) * (i - j + 1) / 2));\n            }\n        }\n\n        dp[0][0][1] = 0;\n        dp2[0][0][1] = 1;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= i; j++) {\n                dp[i][j][1] = add(dp[i - 1][j][0], dp[i - 1][j][1]);\n                dp2[i][j][1] = add(dp2[i - 1][j][0], dp2[i - 1][j][1]);\n                for (int k = 1; k <= j; k++) {\n                    dp[i][j][0] = add(dp[i][j][0], mul(C(j, k), mul(dp2[i - k][j - k][1], f[k])));\n                    dp[i][j][0] = add(dp[i][j][0], mul(C(j, k), mul(dp[i - k][j - k][1], g[k])));\n                    dp2[i][j][0] = add(dp2[i][j][0], mul(C(j, k), mul(dp2[i - k][j - k][1], g[k])));\n                }\n            }\n        }\n\n        print(add(dp[n][m][0], dp[n][m][1]), '\\n');\n        System.out.flush();\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-3.3378547e-06, 0.0, -1.1920928e-07, -0.0005623905, -0.0009778724, -8.106199e-06, -1.3137816, -0.08335911, -8.225407e-06, -2.3841855e-07, -0.0015060285, -0.0037132616, -4.005352e-05, -3.576278e-07, -0.0056029656, -0.008960986, -0.0011800715, -0.16393848, -0.34128222, -0.00017998983, -0.00041905206, -1.1086402e-05, -9.5367386e-07, -3.81469e-06, 