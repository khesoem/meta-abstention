e\n                if cap > 0 and dis[v] > dis[u] + cost:\n                    dis[v] = dis[u] + cost\n                    pre[v] = u\n                    pre_edge[v] = i\n                    if not vis[v]:\n                        vis[v] = True\n                        q.append(v)\n        return pre[t] != -1, pre, pre_edge\n\n    flow = 0\n    cost = 0\n    while True:\n        found, pre, pre_edge = spfa(S, T)\n        if not found:\n            break\n        Min = INF\n        v = T\n        while v != S:\n            u = pre[v]\n            edge = graph[u][pre_edge[v]]\n            Min = min(Min, edge[1])\n            v = u\n        v = T\n        while v != S:\n            u = pre[v]\n            edge = graph[u][pre_edge[v]]\n            edge[1] -= Min\n            rev = edge[3]\n            graph[edge[0]][rev][1] += Min\n            cost += edge[2] * Min\n            v = u\n        flow += Min\n\n    print(cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000219321038457565, 0.0, -4.768370445162873e-07, -0.0003446938644628972, -0.0007406114018522203, -2.3841855067985307e-07, -0.25195831060409546, -0.023735083639621735, -3.5523738915799186e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.3112935448589269e-05, -0.1271388679742813, -8.344646857949556e-07, -4.0531076592742465e-06, -3.218599158572033e-05, -0.029750648885965347, -0.00014661667228210717, -0.09788916260004044, -0.009716124273836613, -0.3142714500427246, -0.011062833480536938, -8.344646857949556e-07, -2.6464111215318553e-05, 0.0, -0.029762450605630875, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -2.2411095415009186e-05, 0.0, -0.0024756519123911858, -1.4305104514278355e-06, -2.9802276912960224e-06, -0.3893662989139557, -1.1920928244535389e-07, 0.0, -0.00015841660206206143, -1.1920928244535389e-07, 0.0, -1.7404405298293568e-05, -1.7881377516459906e-06, -0.05860820412635803, 0.0, -1.0132738680113107e-05, 0.0, -9.17