        q.pop();\n        vis[u] = false;\n        for(int i = head[u]; i != -1; i = nxt[i])\n        {\n            int v = to[i];\n            if(cap[i] > flow[i] && dis[v] > dis[u] + cost[i])\n            {\n                dis[v] = dis[u] + cost[i];\n                pre[v] = i;\n                if(!vis[v])\n                {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return pre[t] != -1;\n}\nint minCostMaxflow(int s, int t, int &cost_)\n{\n    int flow_ = 0;\n    cost_ = 0;\n    while(spfa(s,t))\n    {\n        int Min = INF;\n        for(int i = pre[t]; i != -1; i = pre[to[i^1]])\n        {\n            if(Min > cap[i] - flow[i])\n                Min = cap[i] - flow[i];\n        }\n        for(int i = pre[t]; i != -1; i = pre[to[i^1]])\n        {\n            flow[i] += Min;\n            flow[i^1] -= Min;\n            cost_ += cost[i] * Min;\n        }\n        flow_ += Min;\n    }\n    return flow_;\n}\n#define id(x,y) ((x-1)*50+y)\nint main(){\n    int S = 101*55, T = S + 1;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int tmp;\n    init(T+1);\n    for(int i = 1; i <= k; i++){\n        scanf(\"%d\", &tmp);\n        add_edge(S, tmp, 1, 0);\n    }\n    for(int i = 1; i <= 50; i++){\n        for(int j = 1; j <= 103; j++){\n            int x = id(j, i);\n            int y = id(j+1, i);\n            add_edge(x, y, INF, c);\n        }\n    }\n    for(int i = 0; i < 102; i++){\n        tmp = i*50 + 1;\n        add_edge(tmp, T, INF, 0);\n    }\n    for(int i = 1; i <= m; i++){\n        int u, v;\n        scanf(\"%d%d\", &u, &v);\n        for(int j = 1; j <= 102; j++){\n            int x = id(j, u), x1 = id(j+1, u);\n            int y1 = id(j+1, v), y = id(j, v);\n            for(int kk = 0; kk < 50; kk++){\n                int val = d*(kk*2+1) + c;\n                add_edge(x, y1, 1, val);\n                add_edge(y, x1, 1, val);\n            }\n        }\n    }\n    int cost =