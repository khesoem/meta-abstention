urn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef main():\n    x, y, n = map(int, input().split())\n    \n    best_a = -1\n    best_b = -1\n    \n    def check(a, b):\n        nonlocal best_a, best_b\n        \n        if a < 0:\n            return\n        \n        if best_a == -1:\n            best_a = a\n            best_b = b\n            return\n        \n        left = abs(b * x - a * y) * best_b\n        right = abs(best_b * x - best_a * y) * b\n        \n        if left < right:\n            best_a = a\n            best_b = b\n        elif left == right:\n            if b < best_b or (b == best_b and a < best_a):\n                best_a = a\n                best_b = b\n    \n    for i in range(1, n + 1):\n        base = (i * x) // y\n        check(base - 1, i)\n        check(base, i)\n        check(base + 1, i)\n    \n    print(f\"{best_a}/{best_b}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.508615479106084e-05, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0009439303539693356, -0.523246169090271, -0.07889635860919952, -0.0008126770262606442, -0.0002474478678777814, -1.9430925021879375e-05, -2.3841855067985307e-07, -0.0005452338373288512, -1.5497195136049413e-06, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -4.9470632802695036e-05, -1.7762025890988298e-05, -3.576278118089249e-07, -3.6477376852417365e-05, -5.960462772236497e-07, -7.211902266135439e-05, -7.390948667307384e-06, 0.0, -5.960446742392378e-06, -8.344646857949556e-07, 0.0, -1.1920928244535389e-07, -2.264974000354414e-06, 0.0, -4.768370445162873e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -3.2186455882765586e-06, -8.344646857949556e-07, -4.291525328881107e-06, -3.158996332786046e-05, -9.536738616588991e