ce k{\n    ll n,m,k,c,d;\n}\nvector <ll> vr[55];\nll lr[50];\nint main()\n{\n    ll n=50*99+1, m, k=INF;\n    vector < vector<rib> > g (n);\n    ll s, t;\n\n    scanf(\"%lld%lld%lld%lld%lld\",&k::n,&k::m,&k::k,&k::c,&k::d);\n\n    ll tim=99;\n    for(int i=1;i<=k::k;i++)\n    {\n        scanf(\"%lld\",&lr[i]);\n        add_rib(g,0,lr[i],1,0);\n    }\n    for(int j=0;j<tim-1;j++)\n    {\n        for(int i=2;i<=k::n;i++)\n            add_rib(g,j*50+i,(j+1)*50+i,50,k::c);\n    }\n    for(int j=1;j<tim;j++)\n    {\n        add_rib(g,j*50+1,1,50,0);\n    }\n    for(int i=0;i<k::m;i++)\n    {\n        ll x,y;\n        scanf(\"%lld%lld\",&x,&y);\n        vr[x].push_back(y);\n        vr[y].push_back(x);\n        \n        for(int j=0;j<tim-1;j++)\n        {\n            for(int l=0;l<50;l++)\n            {\n                add_rib(g,j*50+x,(j+1)*50+y,1,(k::c)+(k::d)*((l+1)*(l+1)-(l*l)));\n                add_rib(g,j*50+y,(j+1)*50+x,1,(k::c)+(k::d)*((l+1)*(l+1)-(l*l)));\n            }\n        }\n    }\n    s=0,t=1;\n\n    ll flow = 0,  cost = 0;\n    while (flow < k) {\n        vector<ll> id (n, 0);\n        vector<ll> d (n, INF);\n        vector<ll> q (n);\n        vector<ll> p (n);\n        vector<size_t> p_rib (n);\n        ll qh=0, qt=0;\n        q[qt++] = s;\n        d[s] = 0;\n        while (qh != qt) {\n            ll v = q[qh++];\n            id[v] = 2;\n            if (qh == n)  qh = 0;\n            for (size_t i=0; i<g[v].size(); ++i) {\n                rib & r = g[v][i];\n                if (r.f < r.u && d[v] + r.c < d[r.b]) {\n                    d[r.b] = d[v] + r.c;\n                    if (id[r.b] == 0) {\n                        q[qt++] = r.b;\n                        if (qt == n)  qt = 0;\n                    }\n                    else if (id[r.b] == 2) {\n                        if (--qh == -1)  qh = n-1;\n                        q[qh] = r.b;\n                    }\n                    id[r.b] = 1;\n                    p[r.b] = v;\n                    p_rib[r.b] = i;\n                }\n            }\n        }\n        if (d[t] == INF)  break;\n        ll addflow = k - flow;\n        for (ll v=t; v!=s; v=p[v]) {\n            ll pv = p[v];  size_t pr = p_rib[v];\n            addflow = min (addflow, g[pv][pr].u - g[pv][pr].f);\n        }\n        for (ll v=t; v!=s; v=p[v]) {\n            ll pv = p[v];  size_t pr = p_rib[v],  r = g[pv][pr].back;\n            g[pv][pr].f += addflow;\n            g[v][r].f -= addflow;\n            cost += g[pv][pr].c * addflow;\n        }\n        flow += addflow;\n    }\n    printf(\"%lld\\n\",cost);\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost', 'flow')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n        self.flow = 0\n\ndef add_edge(g, fr, to, cap, cost):\n    g[fr].append(Edge(to, len(g[to]), cap, cost))\n    g[to].append(Edge(fr, len(g[fr]) - 1, 0, -cost))\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n_nodes = next(it)   # k::n\n    m_edges = next(it)   # k::m\n    num_people = next(it) # k::k\n    c_cost = next(it)    # k::c\n    d_cost = next(it)    # k::d\n\n    tim = 99\n    total_nodes = 50 * tim + 1  # 4951\n    g = [[] for _ in range(total_nodes)]\n\n    lr = [0] * (num_people + 1)\n    for i in range(1, num_people + 1):\n        lr[i] = next(it)\n        add_edge(g, 0, lr[i], 1, 0)\n\n    # edges for staying in place\n    for j in range(tim - 1):\n        for i in range(2, n_nodes + 1):\n            add_edge(g, j * 50 + i, (j + 1) * 50 + i, 50, c_cost)\n\n    # edges to sink\n    for j in range(1, tim):\n        add_edge(g, j * 50 + 1, 1, 50, 0)\n\n    # edges for moving along original graph edges\n    for _ in range(m_edges):\n        x = next(it)\n        y = next(it)\n        for j in range(tim - 1):\n            for l in range(50):\n                cost = c_cost + d_cost * ((l + 1) * (l + 1) - l * l)\n                add_edge(g, j * 50 + x, (j + 1) * 50 + y, 1, cost)\n                add_edge(g, j * 50 + y, (j + 1) * 50 + x, 1, cost)\n\n    s = 0\n    t = 1\n    flow = 0\n    cost = 0\n    target_flow = INF\n\n    while flow < target_flow:\n        id = [0] * total_nodes\n        d = [INF] * total_nodes\n        p = [-1] * total_nodes\n        p_rib = [-1] * total_nodes\n        q = deque()\n        d[s] = 0\n        q.append(s)\n        id[s] = 1\n\n        while q:\n            v = q.popleft()\n            id[v] = 2\n            for i, r in enumerate(g[v]):\n                if r.flow < r.cap and d[v] + r.cost < d[r.to]:\n                    d[r.to] = d[v] + r.cost\n                    if id[r.to] == 0:\n                        q.append(r.to)\n                    elif id[r.to] == 2:\n                        q.appendleft(r.to)\n                    id[r.to] = 1\n                    p[r.to] = v\n                    p_rib[r.to] = i\n\n        if d[t] == INF:\n            break\n\n        addflow = target_flow - flow\n        v = t\n        while v != s:\n            pv = p[v]\n            pr = p_rib[v]\n            addflow = min(addflow, g[pv][pr].cap - g[pv][pr].flow)\n            v = pv\n\n        v = t\n        while v != s:\n            pv = p[v]\n            pr = p_rib[v]\n            rev = g[pv][pr].rev\n            g[pv][pr].flow += addflow\n            g[v][rev].flow -= addflow\n            cost += g[pv][pr].cost * addflow\n            v = pv\n\n        flow += addflow\n\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.0794889577664435e-05, 0.0, 0.0, -0.0003411188081372529, -0.0005645350320264697, 0.0, -0.00016711745411157608, -0.003181635867804289, -1.43