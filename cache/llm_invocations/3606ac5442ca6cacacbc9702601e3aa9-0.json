[j + len] = (u - t) % MOD;\n                curRoot = (roots[s] * curRoot) % MOD;\n            }\n        }\n    }\n}\n\nint main() {\n    int n, m;\n    cin >> n;\n    n /= 2;\n    cin >> m;\n    vector<int> nums(m);\n    int maxVal = 0;\n    for (int i = 0; i < m; i++) {\n        cin >> nums[i];\n        maxVal = max(maxVal, nums[i]);\n    }\n    int min_size = n * maxVal + 1;\n    int k = 0;\n    int size = 1;\n    while (size < min_size) {\n        size *= 2;\n        k++;\n    }\n    vector<ll> a(size, 0);\n    for (int i = 0; i < m; i++) {\n        a[nums[i]] = 1;\n    }\n    numberTheoreticTransform(a, k, false);\n    for (int i = 0; i < size; i++) {\n        a[i] = modPow(a[i], n);\n    }\n    numberTheoreticTransform(a, k, true);\n    ll ans = 0;\n    for (int i = 0; i < size; i++) {\n        ans = (ans + a[i] * a[i]) % MOD;\n    }\n    ll invSizeSq = modPow(size, MOD - 3);\n    cout << (ans * invSizeSq) % MOD << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.009013913571834564, -1.7762025890988298e-05, 0.0, -1.1920928244535389e-07, -0.0002503081923350692, -0.0003784178989008069, -1.1920928244535389e-07, -1.2040065485052764e-05, -7.867782187531702e-06, 0.0, 0.0, 0.0, -0.25193625688552856, -0.018409928306937218, -1.1920928244535389e-07, -0.22047169506549835, -0.13215205073356628, -0.06495959311723709, -2.038458114839159e-05, 0.0, -0.03804382309317589, -0.03819747641682625, 0.0, 0.0, -3.576278118089249e-07, -0.00408066064119339, -0.0001234931987710297, -0.0015074567636474967, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.04859164357185364, -8.344646857949556e-07, -8.344646857949556e-07, -3.540453326422721e-05, -0.0031894787680357695, -3.576278118089249e-07, 0.0, 0.0, 0.0, -2.9802276912960224e-06, -1.0728830375228426e-06, -0.0003355178632773459, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -6.437280717364047e-06, -0.16631682217121124, -4.768370445162873e-07, -5.60