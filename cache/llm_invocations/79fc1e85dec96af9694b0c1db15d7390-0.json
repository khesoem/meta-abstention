(dist, dist + t + 1, INT_MAX);\n        fill(inq, inq + t + 1, false);\n        fill(flow, flow + t + 1, INT_MAX);\n        queue<int> q;\n\n        dist[s] = 0;\n        flow[s] = INT_MAX;\n        q.push(s);\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n\n            for (int idx : AL[u]) {\n                arc& e = EL[idx];\n                if (e.cap > e.f && dist[e.t] > dist[u] + e.c) {\n                    dist[e.t] = dist[u] + e.c;\n                    par[e.t] = idx;\n                    flow[e.t] = min(flow[u], e.cap - e.f);\n                    if (!inq[e.t]) {\n                        inq[e.t] = true;\n                        q.push(e.t);\n                    }\n                }\n            }\n        }\n\n        if (dist[t] == INT_MAX) return false;\n        total_flow += flow[t];\n        total_cost += dist[t] * flow[t];\n        int cur = t;\n        while (cur != s) {\n            int idx = par[cur];\n            EL[idx].f += flow[t];\n            EL[idx ^ 1].f -= flow[t];\n            cur = EL[idx].s;\n        }\n        return true;\n    }\n\n    int solve(int s, int t) {\n        int flow = 0, cost = 0;\n        while (dijkstra(s, t, flow, cost));\n        return cost;\n    }\n} solver;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> m >> k >> C >> D;\n\n    for (int i = 1; i <= k; ++i) {\n        scanf(\"%d\", &P[i]);\n    }\n\n    src = 0;\n    dst = n * 100 + 1;\n\n    for (int i = 1; i <= k; ++i) {\n        solver.link(src, 1 + (P[i] - 1) * 100, 1, 0);\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        int base = (i - 1) * 100;\n        for (int j = 1; j < 100; ++j) {\n            solver.link(base + j, base + j + 1, INT_MAX, C);\n        }\n    }\n\n    for (int i = 1; i <= 100; ++i) {\n        solver.link(i, dst, INT_MAX, 0);\n    }\n\n    while (m--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n        for (int i = 1; i < 100; 