;\n            EL.add(new Arc(v, u, 0, 0, -cost));\n            int sz = EL.size();\n            AL[u].add(sz - 2);\n            AL[v].add(sz - 1);\n        }\n\n        boolean dijkstra(int s, int t, int[] totalFlow, int[] totalCost) {\n            Arrays.fill(dist, Integer.MAX_VALUE);\n            Arrays.fill(inq, false);\n            Arrays.fill(flow, Integer.MAX_VALUE);\n            Queue<Integer> q = new LinkedList<>();\n\n            dist[s] = 0;\n            flow[s] = Integer.MAX_VALUE;\n            q.offer(s);\n\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n\n                for (int idx : AL[u]) {\n                    Arc e = EL.get(idx);\n                    if (e.cap > e.f && dist[e.t] > dist[u] + e.c) {\n                        dist[e.t] = dist[u] + e.c;\n                        par[e.t] = idx;\n                        flow[e.t] = Math.min(flow[u], e.cap - e.f);\n                        if (!inq[e.t]) {\n                            inq[e.t] = true;\n                            q.offer(e.t);\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == Integer.MAX_VALUE) {\n                return false;\n            }\n            totalFlow[0] += flow[t];\n            totalCost[0] += dist[t] * flow[t];\n            int cur = t;\n            while (cur != s) {\n                int idx = par[cur];\n                EL.get(idx).f += flow[t];\n                EL.get(idx ^ 1).f -= flow[t];\n                cur = EL.get(idx).s;\n            }\n            return true;\n        }\n\n        int solve(int s, int t) {\n            int[] totalFlow = new int[1];\n            int[] totalCost = new int[1];\n            while (dijkstra(s, t, totalFlow, totalCost));\n            return totalCost[0];\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        int[] P = new int[5005];\n        for (int i = 1; i <= k; i++) {\n            P[i] = sc.nextInt();\n        }\n\n        int src = 0;\n        int dst = n * 100 + 1;\n\n        MinCostFlow solver = new MinCostFlow();\n\n        for (int i = 1; i <= k; i++) {\n            solver.link(src, 1 + (P[i] - 1) * 100, 1, 0);\n        }\n\n        for (int i = 1; i <= n; i++) {\n            int base = (i - 1) * 100;\n            for (int j = 1; j < 100; j++) {\n                solver.link(base + j, base + j + 1, Integer.MAX_VALUE, C);\n            }\n        }\n\n        for (int i = 1; i <= 100; i++) {\n            solver.link(i, dst, Integer.MAX_VALUE, 0);\n        }\n\n        while (m-- > 0) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int i = 1; i < 100; i++) {\n                int u = (x - 1) * 100 + i;\n                int v = (y - 1) * 100 + i + 1;\n                for (int j = 1; j <= 50; j++) {\n                    int w = D * (j * j - (j - 1) * (j - 1)) + C;\n                    solver.link(u, v, 1, w);\n                }\n            }\n\n            for (int i = 1; i < 100; i++) {\n                int u = (y - 1) * 100 + i;\n                int v = (x - 1) * 100 + i + 1;\n                for (int j = 1; j <= 50; j++) {\n                    int w = D * (j * j - (j - 1) * (j - 1)) + C;\n                    solver.link(u, v, 1, w);\n                }\n            }\n        }\n\n        System.out.println(solver.solve(src, dst));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020108585886191577, -2.622600959512056e-06, -3.576278118089249e-07, -0.008812346495687962, -4.5298504119273275e-05, -0.31326931715011597, -0.42877939343452454, -1.4543427823809907e-05, -5.960462772236497e-07, -5.221230458118953e-05, -0.016035521402955055, -6.639736966462806e-05, -0.0058