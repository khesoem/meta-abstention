\n    def __iadd__(self, b):\n        self.v = self.normS(self.v + b.v)\n        return self\n    \n    def __isub__(self, b):\n        self.v = self.normS(self.v + MOD - b.v)\n        return self\n    \n    def __imul__(self, b):\n        self.v = (self.v * b.v) % MOD\n        return self\n    \n    def __itruediv__(self, b):\n        self.v = (self * b).v\n        return self\n    \n    def __iadd1__(self):\n        self.v = self.normS(self.v + 1)\n        return self\n    \n    def __isub1__(self):\n        self.v = self.normS(self.v + MOD - 1)\n        return self\n    \n    def extgcd(self, a, b):\n        p = [a, 1, 0]\n        q = [b, 0, 1]\n        while q[0]:\n            t = p[0] // q[0]\n            for i in range(3):\n                p[i], q[i] = q[i], p[i] - t * q[i]\n        if p[0] < 0:\n            for i in range(3):\n                p[i] = -p[i]\n        return p[1], p[2], p[0]\n    \n    def inv(self):\n        x, y, _ = self.extgcd(self.v, MOD)\n        return ModInt.make(self.normS(x + MOD))\n    \n    def pow(self, p):\n        if p < 0:\n            return self.inv().pow(-p)\n        a = ModInt(1)\n        x = self\n        while p:\n            if p & 1:\n                a *= x\n            x *= x\n            p >>= 1\n        return a\n    \n    def __eq__(self, b):\n        return self.v == b.v\n    \n    def __ne__(self, b):\n        return self.v != b.v\n    \n    def __hash__(self):\n        return hash(self.v)\n    \n    def __repr__(self):\n        return str(self.v)\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx])\n    idx += 1\n    \n    p = [[ModInt(0) for _ in range(N)] for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            val = int(data[idx])\n            idx += 1\n            p[i][j] = ModInt(val) / ModInt(100)\n    \n    # Using dictionary to simulate unordered_map<bitset<128>, mint>\n    cur = {}\n    nxt = {}\n    \n    # Initialize with bitset where bit 0 is set\n    initial_state = 1  # bit 0 set\n    cur[initial_state] = ModInt(1)\n    \n    for i in range(N):\n        for state, prob in cur.items():\n            # Get positions where bit is set\n            ones = []\n            for pos in range(N):\n                if state & (1 << pos):\n                    ones.append(pos)\n            \n            # Iterate over all possible outcomes (2^N)\n            for e in range(1 << N):\n                pr = ModInt(1)\n                for j in range(N):\n                    if (e >> j) & 1:\n                        pr *= p[i][j]\n                    else:\n                        pr *= (ModInt(1) - p[i][j])\n                \n                # Compute new state\n                nb = 0\n                for x in ones:\n                    for r in range(N):\n                        if ((e >> r) & 1) and not ((x >> r) & 1):\n                            nb |= (1 << (x | (1 << r)))\n                \n                # Add to next state\n                if nb in nxt:\n                    nxt[nb] += prob * pr\n                else:\n                    nxt[nb] = prob * pr\n        \n        cur, nxt = nxt, {}\n    \n    ans = ModInt(0)\n    full_mask = (1 << N) - 1\n    for state, prob in cur.items():\n        if state & full_mask:\n            ans += prob\n    \n    print(ans.v)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.35\n</confidence>", "token_logprobs": [-0.0005243833875283599, -8.583032467868179e-06, -4.6491513785440475e-06, -0.1037755161523819, -0.0002217047003796324, -8.583032467868179e-06, -0.00877122487872839, -0.04190924018621445, -1.1920928244535389e-07, -0.00015448330668732524, -0.16034626960754395, -0.040980443358421326, -2.3841855067985307e-07, -8.344646857949556e-07, 0.0, -7.152555099310121e-07, -0.0021856960374861956, 0.0, -1.0251946150674485e-05, 0.0, 0.0, 0.0, -1.9073468138230965e-06, -4.768370445162873e-07, -1.5735502529423684e-05, -0.0059357793