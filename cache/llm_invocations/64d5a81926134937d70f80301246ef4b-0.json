(n+1)\n    for i in range(1<<n):\n        pc = popcount(i)\n        v[pc].append(i)\n        mp[i] = tot[pc]\n        tot[pc] += 1\n    \n    m = n // 2\n    M = n - m\n    \n    # first half\n    f = [0]*(1<<tot[m])\n    for mask in range(1<<(m*n)):\n        p = 1\n        S = [0]*m\n        for j in range(m*n):\n            bit = (mask >> j) & 1\n            if bit:\n                p = p * b[j] % MOD\n            else:\n                p = p * (MOD + 1 - b[j]) % MOD\n        for j in range(m):\n            S[j] = (mask >> (j*n)) & ((1<<n)-1)\n        st = 0\n        for j in v[m]:\n            # get positions of bits in j\n            bits = []\n            k = j\n            while k:\n                bits.append(ctz(k))\n                k &= k-1\n            bits.sort()\n            # generate all permutations\n            for perm in itertools.permutations(bits):\n                ok = True\n                for jj in range(m):\n                    if (S[jj] >> perm[jj]) & 1 == 0:\n                        ok = False\n                        break\n                if ok:\n                    st |= 1 << mp[j]\n        f[st] = (f[st] + p) % MOD\n    \n    # second half\n    g = [0]*(1<<tot[m])\n    for mask in range(1<<(M*n)):\n        p = 1\n        S = [0]*M\n        for j in range(M*n):\n            bit = (mask >> j) & 1\n            if bit:\n                p = p * b[j + n*m] % MOD\n            else:\n                p = p * (MOD + 1 - b[j + n*m]) % MOD\n        for j in range(M):\n            S[j] = (mask >> (j*n)) & ((1<<n)-1)\n        st = 0\n        for j in v[n-m]:\n            bits = []\n            k = j\n            while k:\n                bits.append(ctz(k))\n                k &= k-1\n            bits.sort()\n            for perm in itertools.permutations(bits):\n                ok = True\n                for jj in range(M):\n                    if (S[jj] >> perm[jj]) & 1 == 0:\n                        ok = False\n                        break\n      