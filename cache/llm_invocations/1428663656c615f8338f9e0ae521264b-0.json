if isinstance(other, Modular):\n            return Modular(self.v + other.v, self.mod)\n        return Modular(self.v + other, self.mod)\n    \n    def __sub__(self, other):\n        if isinstance(other, Modular):\n            return Modular(self.v - other.v, self.mod)\n        return Modular(self.v - other, self.mod)\n    \n    def __mul__(self, other):\n        if isinstance(other, Modular):\n            return Modular(self.v * other.v, self.mod)\n        return Modular(self.v * other, self.mod)\n    \n    def __truediv__(self, other):\n        if isinstance(other, Modular):\n            return self * other.inv()\n        return self * Modular(other, self.mod).inv()\n    \n    def __radd__(self, other):\n        return self + other\n    \n    def __rsub__(self, other):\n        return Modular(other, self.mod) - self\n    \n    def __rmul__(self, other):\n        return self * other\n    \n    def __rtruediv__(self, other):\n        return Modular(other, self.mod) / self\n    \n    def __eq__(self, other):\n        if isinstance(other, Modular):\n            return self.v == other.v and self.mod == other.mod\n        return self.v == other\n    \n    def __ne__(self, other):\n        return not self.__eq__(other)\n    \n    def __pow__(self, n):\n        return self.pow(n)\n    \n    def __neg__(self):\n        return Modular(-self.v, self.mod)\n    \n    def __repr__(self):\n        return str(self.v)\n    \n    def inv(self):\n        return self.pow(self.mod - 2)\n    \n    def pow(self, n):\n        res = Modular(1, self.mod)\n        x = Modular(self.v, self.mod)\n        while n:\n            if n & 1:\n                res *= x\n            x *= x\n            n >>= 1\n        return res\n\n# Precompute factorials\nVMAX = 10010\nFACT = [Modular(1)] * VMAX\nFINV = [Modular(1)] * VMAX\nINVS = [Modular(1)] * VMAX\n\ndef init_fact():\n    global FACT, FINV, INVS\n    FACT = [Modular(1)] * VMAX\n    FINV = [Modular(1)] * VMAX\n    INVS = [Modular(1)] * VMAX\n    \n    for i in range(1, VMAX):\n        FACT[i] = FACT[i-1] * i\n    \n    FINV[VMAX-1] = FACT[VMAX-1].inv()\n    for i in range(VMAX-2, -1, -1):\n        FINV[i] = FINV[i+1] * (i+1)\n    \n    for i in range(VMAX-1, 0, -1):\n        INVS[i] = FINV[i] * FACT[i-1]\n\ndef choose(n, k):\n    if k < 0 or k > n:\n        return Modular(0)\n    return FACT[n] * FINV[n-k] * FINV[k]\n\ndef binom(a, b):\n    return FACT[a+b] * FINV[a] * FINV[b]\n\ndef catalan(n):\n    if n < 0:\n        return Modular(0)\n    return binom(n, n) - (binom(n-1, n+1) if n-1 >= 0 else Modular(0))\n\ndef solve():\n    n, m, mod = read_ints()\n    global MOD\n    MOD = mod\n    \n    init_fact()\n    \n    ans = Modular(0, mod)\n    \n    for length in range(1, m):\n        f = Modular(length + 1, mod).pow(length) * length / (n - length) * FINV[length]\n        \n        for i in range(m - length):\n            j = i + length\n            g = Modular(n - length, mod).pow(i) * FINV[i]\n            h = Modular(n - j, mod) * Modular(n + 1, mod).pow(m - 1 - j) * FACT[j]\n            ans += f * g * h\n    \n    ans *= Modular(2, mod).pow(m - 1) * (n + 1 - m)\n    \n    print(str(ans.v) + \"\\n\")\n\ndef main():\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00024125049822032452, -1.5497195136049413e-06, -3.576278118089249e-07, -0.003961098380386829, -0.00034374051028862596, -6.9141146923357155e-06, -0.02226848341524601, -0.33299505710601807, -3.325883881188929e-05, -0.22541481256484985, -0.07102697342634201, -0.03804531693458557, -0.007627766579389572, -0.5320291519165039, -3.576272320060525e-06, -0.14358733594417572, -3.504691630951129e-05, -7.438383181579411e-05, -0.2524176239967346, -0.912672758102417, -1.2638829946517944, -0.0819346234202385, -2.9802276912960224e-06, -0.2847405672073364, -0.01261811051517725, -0.0007656264933757484, -7.855583680793643e-05, -1.0847986231965479e-05, -0.00673630740493536, -0.5760039