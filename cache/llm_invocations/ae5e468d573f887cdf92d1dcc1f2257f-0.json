oolean[n + 1];\n\n            outer:\n            for (int i = 1; i <= n; i++) {\n                for (int j = 1; j <= n; j++) {\n                    if (i == j) {\n                        continue;\n                    }\n                    for (int k = 1; k <= n; k++) {\n                        if (j == k || k == i) {\n                            continue;\n                        }\n\n                        long ax = a[j] - a[i];\n                        long bx = b[j] - b[i];\n                        long cx = c[j] - c[i];\n                        long dx = d[j] - d[i];\n                        long ex = e[j] - e[i];\n\n                        long ay = a[k] - a[i];\n                        long by = b[k] - b[i];\n                        long cy = c[k] - c[i];\n                        long dy = d[k] - d[i];\n                        long ey = e[k] - e[i];\n\n                        double val = ax * ay + bx * by + cx * cy + dx * dy + ex * ey;\n                        long m1 = ax * ax + bx * bx + cx * cx + dx * dx + ex * ex;\n                        long m2 = ay * ay + by * by + cy * cy + dy * dy + ey * ey;\n\n                        val = val / Math.sqrt(m1);\n                        val = val / Math.sqrt(m2);\n\n                        if (Math.toDegrees(Math.acos(val)) + 0.000000001 < 90) {\n                            bad[i] = true;\n                            continue outer;\n                        }\n                    }\n                }\n            }\n\n            int cnt = 0;\n            for (int i = 1; i <= n; i++) {\n                if (!bad[i]) {\n                    cnt++;\n                }\n            }\n\n            out.println(cnt);\n            for (int i = 1; i <= n; i++) {\n                if (!bad[i]) {\n                    out.println(i);\n                }\n            }\n        }\n    }\n\n    static class InputReader {\n        public BufferedReader reader;\n        public StringTokenizer tokenizer;\n\n        public InputRead