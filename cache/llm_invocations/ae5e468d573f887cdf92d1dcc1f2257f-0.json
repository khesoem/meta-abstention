 + ex * ey\n                m1 = ax * ax + bx * bx + cx * cx + dx * dx + ex * ex\n                m2 = ay * ay + by * by + cy * cy + dy * dy + ey * ey\n\n                # Avoid division by zero (if either vector is zero, skip)\n                if m1 == 0 or m2 == 0:\n                    continue\n\n                val = dot / math.sqrt(m1)\n                val = val / math.sqrt(m2)\n\n                # Clamp to avoid domain errors due to floating point\n                if val > 1.0:\n                    val = 1.0\n                elif val < -1.0:\n                    val = -1.0\n\n                angle_deg = math.degrees(math.acos(val))\n                if angle_deg + 0.000000001 < 90.0:\n                    bad[i] = True\n                    found = True\n                    break\n            if found:\n                break\n\n    cnt = sum(1 for i in range(1, n + 1) if not bad[i])\n    print(cnt)\n    for i in range(1, n + 1):\n        if not bad[i]:\n            print(i)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-6.318072337307967e-06, 0.0, 0.0, -9.381330892210826e-05, -2.8729025871143676e-05, -9.60780744208023e-05, -0.004090514499694109, -1.0728830375228426e-06, 0.0, -0.0001805857609724626, -0.029760252684354782, -0.006784143857657909, -0.023279106244444847, -1.1920922133867862e-06, -0.00039200251922011375, -1.0728830375228426e-06, -0.1274612993001938, 0.0, -0.0011978124966844916, -1.1920928244535389e-07, -0.10020895302295685, 0.0, 0.0, -1.9073468138230965e-06, -1.1920928244535389e-07, -0.00043358939001336694, 0.0, 0.0, -7.486063259420916e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -1.764281842042692e-05, -9.536738616588991e-07, -0.011088770814239979, 0.0, -7.152555099310121e-07, -4.5536911784438416e-05, -3.015949550899677e-05, -3.540453326422721e-05, -0.000433112756581977, -2.9802276912960224e-06, -2.3841855067985307e-07, 0.0, 0.0, -0.001931350794620812, -0.0011704268399