nk) return f;\n    for (int &i = nextEdge[u]; i < (int)G[u].size(); ++i) {\n        int id = G[u][i];\n        int v = E[id].v;\n        if (level[v] != level[u] + 1) continue;\n        long long pushed = blockFlow(v, min(f, E[id].capacity - E[id].flow));\n        if (pushed) {\n            E[id].flow += (int)pushed;\n            E[id ^ 1].flow -= (int)pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nlong long dinic() {\n    long long ans = 0;\n    while (findLevel()) {\n        fill(nextEdge.begin(), nextEdge.end(), 0);\n        while (long long pushed = blockFlow(src, INF)) ans += pushed;\n    }\n    return ans;\n}\n\nint n, m, deadline;\nchar sci[101][101], rea[101][101];\nvector<vector<int>> danger;\n\nbool valid(int r, int c) { return r >= 0 && c >= 0 && r < n && c < m; }\nint getID(int x, int y) { return 1 + m * x + y; }\n\nbool canReach(int sx, int sy, int tx, int ty) {\n    bool seen[101][101];\n    memset(seen, 0, sizeof(seen));\n    queue<ppi> q;\n    q.push(ppi(pii(sx, sy), 1));\n    seen[sx][sy] = true;\n    while (!q.empty()) {\n        int x = q.front().first.first;\n        int y = q.front().first.second;\n        int tim = q.front().second;\n        q.pop();\n        if (x == tx && y == ty) {\n            seen[tx][ty] = true;\n            break;\n        }\n        if (tim >= danger[x][y] || tim >= deadline) continue;\n        for (int dx = -1; dx <= 1; ++dx) {\n            for (int dy = -1; dy <= 1; ++dy) {\n                if (abs(dx) + abs(dy) != 1) continue;\n                int nx = x + dx, ny = y + dy;\n                if (valid(nx, ny) && !seen[nx][ny] &&\n                    sci[nx][ny] != 'Y' && sci[nx][ny] != 'Z' &&\n                    tim + 1 <= danger[nx][ny]) {\n                    seen[nx][ny] = true;\n                    q.push(ppi(pii(nx, ny), tim + 1));\n                }\n            }\n        }\n    }\n    return seen[tx][ty];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin >> n >> deadline