++;\n    }\n    \n    static boolean spfa(int s, int t) {\n        Queue<Integer> q = new LinkedList<>();\n        Arrays.fill(dis, INF);\n        Arrays.fill(vis, false);\n        Arrays.fill(pre, -1);\n        dis[s] = 0;\n        vis[s] = true;\n        q.offer(s);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != -1; i = edge[i].next) {\n                int v = edge[i].to;\n                if (edge[i].cap > edge[i].flow && dis[v] > dis[u] + edge[i].cost) {\n                    dis[v] = dis[u] + edge[i].cost;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return pre[t] != -1;\n    }\n    \n    static int minCostMaxflow(int s, int t, int[] cost) {\n        int flow = 0;\n        cost[0] = 0;\n        while (spfa(s, t)) {\n            int Min = INF;\n            for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n                if (Min > edge[i].cap - edge[i].flow) {\n                    Min = edge[i].cap - edge[i].flow;\n                }\n            }\n            for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n                edge[i].flow += Min;\n                edge[i ^ 1].flow -= Min;\n                cost[0] += edge[i].cost * Min;\n            }\n            flow += Min;\n        }\n        return flow;\n    }\n    \n    static int point(int x, int y) {\n        return (x - 1) * 50 + y;\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int S = 101 * 55, T = S + 1;\n        n = read(scanner);\n        m = read(scanner);\n        k = read(scanner);\n        c = read(scanner);\n        d = read(scanner);\n        \n        init(T + 1);\n        \n        for (int i = 0; i < k; i++) {\n            int tmp = read(scanner);\n            addedge(S, tmp, 1, 0);\n        }\n        \n        for (int i = 1; i <= 50; i++) {\n            for (int j = 1; j <= 103; j++) {\n                int x = point(j, i);\n                int y = point(j + 1, i);\n                addedge(x, y, INF, c);\n            }\n        }\n        \n        for (int i = 0; i < 102; i++) {\n            int tmp = i * 50 + 1;\n            addedge(tmp, T, INF, 0);\n        }\n        \n        for (int i = 0; i < m; i++) {\n            int u = read(scanner);\n            int v = read(scanner);\n            for (int j = 1; j <= 102; j++) {\n                int x = point(j, u);\n                int x1 = point(j + 1, u);\n                int y1 = point(j + 1, v);\n                int y = point(j, v);\n                for (int k_val = 0; k_val < 50; k_val++) {\n                    int val = d * (k_val * 2 + 1) + c;\n                    addedge(x, y1, 1, val);\n                    addedge(y, x1, 1, val);\n                }\n            }\n        }\n        \n        int[] cost = new int[1];\n        minCostMaxflow(S, T, cost);\n        System.out.println(cost[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001839230244513601, -2.145764938177308e-06, -4.768370445162873e-07, -0.0005620330339297652, -4.815939246327616e-05, -0.22542299330234528, -0.20154528319835663, -2.753696753643453e-05, -1.1920928244535389e-07, -3.325883881188929e-05, -0.023246845230460167, -8.49926145747304e-05, -0.034568965435028076, -0.008423750288784504, -3.576272320060525e-06, -8.821448318485636e-06, 0.0, -3.6000557884108275e-05, -1.1920928244535389e-07, -4.017272294731811e-05, -7.152555099310121e-07, -4.172316494077677e-06, 0.0, -2.0265558760002023e-06, -2.7418097943154862e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -2.264974000354414e-06, -3.576278118089249e-07, -2.50339189733495e-06, -8.344646857949556e-07, -5.9126061387360096e-05, -2.3841855067985307e-07, -0.00033742457162588835, -3.5762781180