\n            j -= 1\n        ans += a * len(rem2) + totalrsum - (len(rem2) - 1 - j) * MOD\n    return ans\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    n_str = str(n)\n    # precompute powers of 10 up to 17 (enough for up to 10^16)\n    pw10 = [1]\n    for i in range(1, 18):\n        pw10.append(pw10[-1] * 10)\n\n    ans = 0\n    MOD_FINAL = 1000000007\n\n    # main loop over lengths\n    for length in range(1, len(n_str) + 1):\n        cur = 0\n        curst = \"\"\n        for firstdiff in range(0, min(len(n_str), length)):\n            if firstdiff:\n                cur = 10 * cur + (ord(n_str[firstdiff - 1]) - 48)\n                curst += n_str[firstdiff - 1]\n            for lastdig in range(0, 10):\n                if firstdiff == 0 and lastdig == 0:\n                    continue\n                if lastdig == ord(n_str[firstdiff]) - 48:\n                    continue\n                if length == len(n_str) and lastdig > ord(n_str[firstdiff]) - 48:\n                    continue\n                curp = 10 * cur + lastdig\n                curstp = curst + chr(48 + lastdig)\n\n                # compute base\n                base = 0\n                tmp = \"\"\n                for pos in range(len(curstp)):\n                    start_dig = '1' if pos == 0 else '0'\n                    for dig in range(ord(start_dig), ord(curstp[pos])):\n                        base += count_with_prefix(tmp + chr(dig), n, n_str, pw10)\n                    tmp += curstp[pos]\n                base += length - 1  # all strict prefixes are smaller\n\n                # build variables\n                variables = []\n                tmp2 = tmp[:]  # copy\n                for pos in range(len(curstp), length):\n                    variables.append(count_with_prefix(tmp2 + '0', n, n_str, pw10) % 998244353)\n                    tmp2 += '0'\n\n                base += 1  # 1-based\n                base -= curp * pw10[length - len(curstp)]\n                for t in range(len(variables)):\n                    variables[len(variables) - 1 - t] -= pw10[t] % 998244353\n\n                base %= 998244353\n                if base < 0:\n                    base += 998244353\n                for i in range(len(variables)):\n                    variables[i] %= 998244353\n                    if variables[i] < 0:\n                        variables[i] += 998244353\n\n                ans += solve(variables, base)\n\n    # special case: numbers that are prefixes of n\n    cur = 0\n    curst = \"\"\n    for length in range(1, len(n_str) + 1):\n        curst += n_str[length - 1]\n        cur = 10 * cur + (ord(n_str[length - 1]) - 48)\n\n        val = 1  # 1-based\n        tmp = \"\"\n        for pos in range(len(curst)):\n            start_dig = '1' if pos == 0 else '0'\n            for dig in range(ord(start_dig), ord(curst[pos])):\n                val += count_with_prefix(tmp + chr(dig), n, n_str, pw10)\n            tmp += curst[pos]\n        val += length - 1  # all strict prefixes are smaller\n\n        val -= cur\n        val %= 998244353\n        if val < 0:\n            val += 998244353\n\n        ans += val\n\n    ans %= MOD_FINAL\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-1.2278481335670222e-05, 0.0, -1.1920928244535389e-07, -0.0002044230350293219, -0.03980085253715515, -7.152555099310121e-07, -0.038067348301410675, -0.5573704242706299, -0.8276983499526978, -0.00016544880054425448, -1.1920928244535389e-07, -2.8371408916427754e-05, -0.01815745420753956, 0.0, -5.9126061387360096e-05, -2.3603161025675945e-05, -1.0728830375228426e-06, -4.589452510117553e-05, -4.053033626405522e-05, -0.0002615109842736274, -4.9470632802695036e-05, -1.1920928244535389e-07, -0.027546975761651993, -2.2053474822314456e-05, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, 0.0, -0.009535717777907848, -0.0040894462