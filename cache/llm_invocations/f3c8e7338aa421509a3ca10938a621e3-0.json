e>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdint>\n\nusing namespace std;\n\nconst int MOD = 998244353;\nconst int TWO_POW = 23;\nconst int ROOT = 15311432;\n\nint bitReverse(int n, int k) {\n    n = ((n & 0x55555555) << 1) | ((n & 0xAAAAAAAA) >> 1);\n    n = ((n & 0x33333333) << 2) | ((n & 0xCCCCCCCC) >> 2);\n    n = ((n & 0x0F0F0F0F) << 4) | ((n & 0xF0F0F0F0) >> 4);\n    n = ((n & 0x00FF00FF) << 8) | ((n & 0xFF00FF00) >> 8);\n    n = (n << 16) | (n >> 16);\n    return n >> (32 - k);\n}\n\nlong long modPow(long long base, long long exp) {\n    long long res = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) res = (res * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nlong long modInverse(long long a) {\n    return modPow(a, MOD - 2);\n}\n\nvector<long long> buildRoots(int k, bool inverse) {\n    long long root = modPow(ROOT, modPow(2, TWO_POW - k));\n    if (inverse) root = modInverse(root);\n    vector<long long> rts(k, 0);\n    if (k > 0) {\n        rts[k - 1] = root;\n        for (int i = k - 1; i > 0; i--) {\n            rts[i - 1] = (rts[i] * rts[i]) % MOD;\n        }\n    }\n    return rts;\n}\n\nvector<long long> permute(const vector<long long>& arr, int k) {\n    vector<long long> res(arr.size(), 0);\n    for (int i = 0; i < arr.size(); i++) {\n        res[bitReverse(i, k)] = arr[i];\n    }\n    return res;\n}\n\nvector<long long> ntt(vector<long long> coef, int k, bool inverse) {\n    coef = permute(coef, k);\n    vector<long long> roots = buildRoots(k, inverse);\n    for (int s = 0; s < k; s++) {\n        int len = 1 << s;\n        for (int st = 0; st < (int)coef.size(); st += 2 * len) {\n            long long curRoot = 1;\n            for (int j = st; j < st + len; j++) {\n                long long t = (curRoot * coef[j + len]) % MOD;\n                long long u = coef[j];\n                coef[j] = (u + t) % MOD;\n                long long diff = u - t;\n                coef[j + len] = (diff < 0 ? diff + MOD : diff) % MOD;\n                curRoot = (roots[s] * curRoot) % MOD;\n            }\n        }\n    }\n    return coef;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    n /= 2;\n    vector<int> nums(m);\n    int maxVal = 0;\n    for (int i = 0; i < m; i++) {\n        cin >> nums[i];\n        maxVal = max(maxVal, nums[i]);\n    }\n    int requiredSize = n * maxVal + 1;\n    int k = 0, size = 1;\n    while (size < requiredSize) {\n        size <<= 1;\n        k++;\n    }\n    vector<long long> poly(size, 0);\n    for (int num : nums) poly[num] = 1;\n    poly = ntt(poly, k, false);\n    for (int i = 0; i < size; i++) poly[i] = modPow(poly[i], n);\n    poly = ntt(poly, k, true);\n    long long total = 0;\n    for (int i = 0; i < size; i++) total = (total + poly[i] * poly[i]) % MOD;\n    long long invSize = modInverse(size);\n    cout << ((total * invSize % MOD) * invSize % MOD) << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017426878912374377, -1.0728830375228426e-06, -1.1920922133867862e-06, -0.001444607158191502, -4.768370445162873e-07, -0.00015221867943182588, -1.8000440832111053e-05, -2.145764938177308e-06, -2.50339189733495e-06, -6.890059739816934e-05, -4.768370445162873e-07, -3.2305197237292305e-05, -5.722029527532868e-06, -0.0003034608089365065, -0.12693141400814056, -0.054899346083402634, -7.152555099310121e-07, -0.616066038608551, -0.00975756160914898, -0.07355760782957077, -2.7894584491150454e-05, -2.7418097943154862e-06, -1.1920922133867862e-06, -0.02986404299736023, -0.04862502962350845, -0.00027855331427417696, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, 0.0, -5.960462772236497e-07, -3.2186455882765586e-06, -2.3841830625315197e-06, -4.172316494077677e-06, -9.