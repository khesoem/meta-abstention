urn true;\n            if (!(o instanceof Key)) return false;\n            Key key = (Key) o;\n            return N == key.N && k == key.k && flag == key.flag;\n        }\n        @Override\n        public int hashCode() {\n            return Objects.hash(N, k, flag);\n        }\n    }\n\n    static long calc(int N, int k, boolean flag) {\n        Key key = new Key(N, k, flag);\n        if (memo.containsKey(key)) return memo.get(key);\n\n        long res;\n        if (N == 1) {\n            long base = flag ? -1 : (k < 0 ? 1 : 0);\n            res = (base % mod + mod) % mod;\n        } else {\n            int inv = N * (N - 1) / 2;\n            if (k < -inv - 1) {\n                res = calc(N, -inv - 1, flag);\n            } else if (k >= inv) {\n                res = 0;\n            } else {\n                res = 0;\n                int start = -N + 1;\n                int end = flag ? 0 : N - 1;\n                for (int d = start; d <= end; d++) {\n                    long term = calc(N - 1, k - d, flag && (d == 0));\n                    int multiplier = Math.min(N - d, N + d);\n                    res = (res + term * multiplier) % mod;\n                }\n            }\n        }\n        memo.put(key, res);\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        mod = sc.nextInt();\n        System.out.println(calc(n, 0, true) % mod);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.01443491317331791, -2.3841855067985307e-07, 0.0, 0.0, -7.510157047363464e-06, -1.7523612768854946e-05, 0.0, -8.4638240878121e-06, -0.03182569146156311, -2.253030106658116e-05, 0.0, -0.0034803315065801144, -0.0011709030950441957, -0.0002640137099660933, -0.25289854407310486, -0.48362112045288086, -0.2014186978340149, -0.00664051016792655, -3.540453326422721e-05, -0.00026246439665555954, -0.12699377536773682, -0.004809003323316574, -0.00036