{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = (ll)1e18;\nconst int MAXN = 6000;\n\nstruct Edge {\n    int to, rev;\n    ll cap, cost;\n};\n\nvector<Edge> g[MAXN];\nll dis[MAXN];\nint pv[MAXN], pe[MAXN];\nbool ins[MAXN];\nint ncnt, src, snk;\n\nvoid init_graph(int n, int s, int t) {\n    for (int i = 0; i <= n; ++i) g[i].clear();\n    ncnt = n;\n    src = s;\n    snk = t;\n}\n\nvoid add_arc(int u, int v, ll cap, ll cost) {\n    g[u].push_back({v, (int)g[v].size(), cap, cost});\n    g[v].push_back({u, (int)g[u].size() - 1, 0, -cost});\n}\n\nll min_cost_max_flow(ll need) {\n    ll ans = 0;\n    while (need > 0) {\n        fill(dis, dis + ncnt, INF);\n        dis[src] = 0;\n        deque<int> q;\n        q.push_back(src);\n        ins[src] = true;\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop_front();\n            ins[u] = false;\n            for (int i = 0; i < (int)g[u].size(); ++i) {\n                Edge &e = g[u][i];\n                if (e.cap > 0 && dis[u] + e.cost < dis[e.to]) {\n                    dis[e.to] = dis[u] + e.cost;\n                    pv[e.to] = u;\n                    pe[e.to] = i;\n                    if (!ins[e.to]) {\n                        ins[e.to] = true;\n                        q.push_back(e.to);\n                    }\n                }\n            }\n        }\n        if (dis[snk] == INF) return -1;\n        ll add = need;\n        for (int v = snk; v != src; v = pv[v])\n            add = min(add, g[pv[v]][pe[v]].cap);\n        need -= add;\n        ans += add * dis[snk];\n        for (int v = snk; v != src; v = pv[v]) {\n            Edge &e = g[pv[v]][pe[v]];\n            e.cap -= add;\n            g[v][e.rev].cap += add;\n        }\n    }\n    return ans;\n}\n\nll N, M, K, C, D;\nll A[58];\nvector<int> H[57];\n\nint32_t main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cin >> N >> M >> K >> C >> D;\n    for (ll i = 1; i <= K; ++i) {\n        int x;\n        cin >> x;\n        A[x]++;\n    }\n    for (int i = 1; i <= M; ++i) {\n        int x, y;\n        cin >> x >> y;\n        H[x].push_back(y);\n        H[y].push_back(x);\n    }\n\n    init_graph(5103, 0, 5101);\n    for (int i = 2; i <= N; ++i) add_arc(0, i, A[i], 0);\n    for (int i = 0; i <= 100; ++i) {\n        for (int l = 1; l <= N; ++l) {\n            add_arc(50 * i + l, 50 * (i + 1) + l, K, 0);\n            for (int j : H[l]) {\n                for (ll k = 1; k <= K; ++k) {\n                    add_arc(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                }\n            }\n        }\n    }\n    for (int i = 1; i <= 101; ++i) add_arc(50 * i + 1, 5101, K, C * i);\n    cout << min_cost_max_flow(K) << endl;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\ng = []\nncnt = 0\nsrc = 0\nsnk = 0\n\ndef add_arc(u, v, cap, cost):\n    global g\n    g[u].append([v, len(g[v]), cap, cost])\n    g[v].append([u, len(g[u]) - 1, 0, -cost])\n\ndef min_cost_max_flow(need):\n    global g, ncnt, src, snk, INF\n    ans = 0\n    while need > 0:\n        dis = [INF] * ncnt\n        dis[src] = 0\n        q = deque([src])\n        ins = [False] * ncnt\n        ins[src] = True\n        pv = [0] * ncnt\n        pe = [0] * ncnt\n        while q:\n            u = q.popleft()\n            ins[u] = False\n            for i, e in enumerate(g[u]):\n                if e[2] > 0 and dis[u] + e[3] < dis[e[0]]:\n                    dis[e[0]] = dis[u] + e[3]\n                    pv[e[0]] = u\n                    pe[e[0]] = i\n                    if not ins[e[0]]:\n                        ins[e[0]] = True\n                        q.append(e[0])\n        if dis[snk] == INF:\n            return -1\n        add = need\n        v = snk\n        while v != src:\n            add = min(add, g[pv[v]][pe[v]][2])\n            v = pv[v]\n        need -= add\n        ans += add * dis[snk]\n        v = snk\n        while v != src:\n            e = g[pv[v]][pe[v]]\n            e[2] -= add\n            rev = e[1]\n            g[v][rev][2] += add\n            v = pv[v]\n    return ans\n\ndef main():\n    global g, ncnt, src, snk, INF\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    N = next(it); M = next(it); K = next(it); C = next(it); D = next(it)\n    A = [0] * (N + 1)\n    for _ in range(K):\n        x = next(it)\n        A[x] += 1\n    H = [[] for _ in range(N + 1)]\n    for _ in range(M):\n        x = next(it); y = next(it)\n        H[x].append(y)\n        H[y].append(x)\n\n    ncnt = 5103\n    src = 0\n    snk = 5101\n    g = [[] for _ in range(ncnt)]\n\n    # source to rooms (2..N)\n    for i in range(2, N + 1):\n        if A[i] > 0:\n            add_arc(0, i, A[i], 0)\n\n    # time layers\n    for i in range(0, 101):          # i = 0 .. 100\n        for l in range(1, N + 1):\n            u = 50 * i + l\n            v = 50 * (i + 1) + l\n     