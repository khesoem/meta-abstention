ong ans = powmod(m, n, mod);\n    for (int i = 1; i <= n; i++) popcnt[i] = popcnt[i >> 1] + (i & 1);\n    if (n & 1) {\n        cout << ans << endl;\n        return 0;\n    }\n    dp[0][0] = 1;\n    int limit = min(0LL + popcnt[n], m);\n    for (int i = 0; i < limit; i++) {\n        for (int j = 0; j < n; j++) {\n            if (!dp[i][j]) continue;\n            int x = n ^ j;\n            for (int k = x, r; k > j; k = (k - 1) & x) {\n                r = k | j;\n                add(dp[i + 1][r], dp[i][j] * inv_fact[k]);\n            }\n        }\n    }\n    long long sum = 0;\n    for (int i = 1; i <= m; i++)\n        sum = (sum + dp[i][n] * fact[m] % mod * inv_fact[m - i] % mod * fact[n]) % mod;\n    ans = (ans - sum + mod) % mod;\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static final int MAXN = 250010;\n    static long[] fact = new long[MAXN];\n    static long[] inv_fact = new long[MAXN];\n    static long[][] dp = new long[30][MAXN];\n    static int[] popcnt = new int[MAXN];\n    static long n, m, mod;\n\n    static long modinv(long a, long mod) {\n        long b = mod, u = 1, v = 0;\n        while (b != 0) {\n            long t = a / b;\n            a -= t * b;\n            long temp = a; a = b; b = temp;\n            u -= t * v;\n            temp = u; u = v; v = temp;\n        }\n        u %= mod;\n        if (u < 0) u += mod;\n        return u;\n    }\n\n    static long powmod(long a, long b, long mod) {\n        long res = 1;\n        while (b != 0) {\n            if ((b & 1) != 0) res = res * a % mod;\n            a = a * a % mod;\n            b >>= 1;\n        }\n        return res;\n    }\n\n    static void add(long[] x, int index, long y) {\n        x[index] += y;\n        if (x[index] >= mod) x[index] %= mod;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextLong();\n        m = sc.nextLong();\n        mod = sc.nextLong();\n        \n        fact[0] = fact[1] = 1;\n        for (int i = 2; i <= n; i++) fact[i] = fact[i - 1] * i % mod;\n        \n        inv_fact[0] = inv_fact[1] = 1;\n        for (int i = 2; i <= n; i++) {\n            long inv_i = modinv(i, mod);\n            inv_fact[i] = inv_fact[i - 1] * inv_i % mod;\n        }\n        \n        long ans = powmod(m, n, mod);\n        for (int i = 1; i <= n; i++) popcnt[i] = popcnt[i >> 1] + (i & 1);\n        \n        if ((n & 1) != 0) {\n            System.out.println(ans);\n            return;\n        }\n        \n        dp[0][0] = 1;\n        int limit = (int) Math.min(popcnt[(int)n], m);\n        for (int i = 0; i < limit; i++) {\n            for (int j = 0; j < n; j++) {\n                if (dp[i][j] == 0) continue;\n                int x = (int)n ^ j;\n                for (int k = x; k > j; k = (k - 1) & x) {\n                    int r = k | j;\n                    add(dp[i + 1], r, dp[i][j] * inv_fact[k] % mod);\n                }\n            }\n        }\n        \n        long sum = 0;\n        for (int i = 1; i <= m; i++) {\n            sum = (sum + dp[i][(int)n] * fact[(int)m] % mod * inv_fact[(int)m - i] % mod * fact[(int)n]) % mod;\n        }\n        ans = (ans - sum + mod) % mod;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.3378547e-06, 0.0, 0.0, -0.00016091959, -0.00020919042, -2.0265559e-06, -0.04042534, -0.22823444, -0.011072737, -1.2159274e-05, -2.3841855e-07, -0.007941931, -0.0011778092, -0.00034397884, -0.012633883, -0.002230301, -0.0001234932, -7.152555e-07, -5.245195e-06, -1.1920928e-07, -2.264974e-06, -9.298281e-06, -4.5894525e-05, -1.3232144e-05, -1.3113013e-06, -2.0265559e-06, -1.0132739e-05, -0.0007258403, -7.152555e-07, -0.0012937756, 0.0, 0.0, -1.7881378e-06, 0.0, 