es = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        \n        int total_states = 1 << n;\n        \n        // Initialize data structures\n        int[][] child = new int[100010][total_states];\n        long[][] prob = new long[n][n];\n        long[][] trans = new long[n][total_states];\n        long[][] dp = new long[n + 1][100010];\n        Map<Long, Integer> state_map = new HashMap<>();\n        int[] timer = {0};\n        \n        // DFS function\n        class DFS {\n            int dfs(long state) {\n                if (state_map.containsKey(state)) {\n                    return state_map.get(state);\n                }\n                state_map.put(state, ++timer[0]);\n                int sid = timer[0];\n                \n                for (int mask = 0; mask < total_states; ++mask) {\n                    long next_state = state;\n                    for (int j = 0; j < total_states; ++j) {\n                        for (int k = 0; k < n; ++k) {\n                            if ((j >> k & 1) == 1 && (mask >> k & 1) == 1 && (state >> (j ^ (1 << k)) & 1) == 1) {\n                                next_state |= (1L << j);\n                            }\n                        }\n                    }\n                    child[sid][mask] = dfs(next_state);\n                }\n                return sid;\n            }\n        }\n        \n        DFS dfs = new DFS();\n        dfs.dfs(1);\n        \n        // Read probabilities\n        for (int i = 0; i < n; ++i) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0