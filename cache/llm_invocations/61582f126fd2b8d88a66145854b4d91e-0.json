{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = (ll)1e18;\n\nstruct Edge {\n    int to, rev;\n    ll cap, cost;\n};\n\nclass MinCostFlow {\n    int n, s, t;\n    vector<vector<Edge>> g;\n    vector<ll> dist;\n    vector<int> prevv, preve, inq;\npublic:\n    MinCostFlow(int n_, int s_, int t_) : n(n_), s(s_), t(t_), g(n_+1), dist(n_+1), prevv(n_+1), preve(n_+1), inq(n_+1, 0) {}\n    void add_edge(int from, int to, ll cap, ll cost) {\n        Edge f{to, (int)g[to].size(), cap, cost};\n        Edge r{from, (int)g[from].size(), 0, -cost};\n        g[from].push_back(f);\n        g[to].push_back(r);\n    }\n    ll min_cost_flow(ll f) {\n        ll res = 0;\n        while (f > 0) {\n            fill(dist.begin(), dist.end(), INF);\n            dist[s] = 0;\n            queue<int> q;\n            q.push(s);\n            inq[s] = 1;\n            while (!q.empty()) {\n                int now = q.front(); q.pop();\n                inq[now] = 0;\n                for (int i = 0; i < (int)g[now].size(); ++i) {\n                    Edge &e = g[now][i];\n                    if (e.cap > 0 && dist[now] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[now] + e.cost;\n                        prevv[e.to] = now;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = 1;\n                            q.push(e.to);\n                        }\n                    }\n                }\n            }\n            if (dist[t] == INF) return -1;\n            ll d = f;\n            for (int v = t; v != s; v = prevv[v])\n                d = min(d, g[prevv[v]][preve[v]].cap);\n            f -= d;\n            res += d * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= d;\n                g[v][e.rev].cap += d;\n            }\n        }\n        return res;\n    }\n};\n\nll N, M, K, C, D;\nll A[58];\nvector<int> H[57];\n\nint32_t main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cin >> N >> M >> K >> C >> D;\n    for (ll i = 1; i <= K; ++i) {\n        int x;\n        cin >> x;\n        A[x]++;\n    }\n    for (int i = 1; i <= M; ++i) {\n        int x, y;\n        cin >> x >> y;\n        H[x].push_back(y);\n        H[y].push_back(x);\n    }\n\n    MinCostFlow mcf(5103, 0, 5101);\n    for (int i = 2; i <= N; ++i) mcf.add_edge(0, i, A[i], 0);\n    for (int i = 0; i <= 100; ++i) {\n        for (int l = 1; l <= N; ++l) {\n            mcf.add_edge(50*i + l, 50*(i+1) + l, K, 0);\n            for (int j : H[l]) {\n                for (ll k = 1; k <= K; ++k) {\n                    mcf.add_edge(50*i + l, 50*(i+1) + j, 1, D * (2*k - 1));\n                }\n            }\n        }\n    }\n    for (int i = 1; i <= 101; ++i) mcf.add_edge(50*i + 1, 5101, K, C * i);\n    cout << mcf.min_cost_flow(K) << endl;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\nclass Edge:\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\nclass MinCostFlow:\n    def __init__(self, n, s, t):\n        self.n = n\n        self.s = s\n        self.t = t\n        self.g = [[] for _ in range(n+1)]\n        self.dist = [0]*(n+1)\n        self.prevv = [0]*(n+1)\n        self.preve = [0]*(n+1)\n        self.inq = [0]*(n+1)\n\n    def add_edge(self, fr, to, cap, cost):\n        fwd = Edge(to, len(self.g[to]), cap, cost)\n        rev = Edge(fr, len(self.g[fr]), 0, -cost)\n        self.g[fr].append(fwd)\n        self.g[to].append(rev)\n\n    def min_cost_flow(self, f):\n        res = 0\n        while f > 0:\n            self.dist = [INF]*(self.n+1)\n            self.dist[self.s] = 0\n            q = deque()\n            q.append(self.s)\n            self.inq[self.s] = 1\n            while q:\n                now = q.popleft()\n                self.inq[now] = 0\n                for i, e in enumerate(self.g[now]):\n                    if e.cap > 0 and self.dist[now] + e.cost < self.dist[e.to]:\n                        self.dist[e.to] = self.dist[now] + e.cost\n                        self.prevv[e.to] = now\n                        self.preve[e.to] = i\n                        if not self.inq[e.to]:\n                            self.inq[e.to] = 1\n                            q.append(e.to)\n            if self.dist[self.t] == INF:\n                return -1\n            d = f\n            v = self.t\n            while v != self.s:\n                d = min(d, self.g[self.prevv[v]][self.preve[v]].cap)\n                v = self.prevv[v]\n            f -= d\n            res += d * self.dist[self.t]\n            v = self.t\n            while v != self.s:\n                e = self.g[self.prevv[v]][self.preve[v]]\n                e.cap -= d\n                self.g[v][e.rev].cap += d\n                v = self.prevv[v]\n        return res\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    A = [0]*(N+1)\n    for _ in range(K):\n        x = int(next(it))\n        A[x] += 1\n    H = [[] for _ in range(N+1)]\n    for _ in range(M):\n        x = int(next(it))\n        y = int(next(it))\n        H[x].append(y)\n        H[y].append(x)\n\n    mcf = MinCostFlow(5103, 0, 5101)\n    for i in range(2, N+1):\n        if A[i] > 0:\n            mcf.add_edge(0, i, A[i], 0)\n    for i in range(0, 101):  # time steps 0 to 100\n        for l in range(1, N+1):\n            mcf.add_edge(50*i + l, 50*(i+1) + l, K, 0)\n            for j in H[l]:\n                for k in range(1, K+1):\n                    mcf.add_edge(50*i + l, 50*(i+1) + j, 1, D * (2*k - 1))\n    for i in range(1, 102):  # i from 1 to 101 inclusive\n        mcf.add_edge(50*i + 1, 5101, K, C * i)\n    print(mcf.min_cost_flow(K))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.152531907195225e-06, 0.0, 0.0, -0.0005078217945992947, -0.2059508115053177, -4.6132929128361866e-05, -2.992108420585282e-05, -9.667406266089529e-05, -2.264974000354414e-06, 0.0, -1.847726889536716e-05, -0.004419915843755007, -0.03911338374018669, -1.311301275563892e-06, -0.00041654970846138895, -1.3589766240329482e-05, -0.00043072958942502737, -0.00010144196130568162, -0.0006020640721544623, -9.775113539944869e-06, -0.25193923711776733, -4.768370445162873e-07, -3.576278118089249e-07, -0.12693528831005096, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -0.00043561504571698606, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.5497195136049413e-06, 0.0, -2.9802276912960224e-06, 0.0, 0.0, 0.0, -7.152555099310121e-07, 0.0, -0.00023326536756940186, 0.0, 0.0