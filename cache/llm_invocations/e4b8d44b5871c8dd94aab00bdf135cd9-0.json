{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int INF = 0x7f7f7f7f;\nint n,m,s,t,p,c,d,x[505],y[505];\nint total_flow,total_cost;\nint edge_num=1,head[5000005],nxt[5000005<<1],to[5000005<<1],cap[5000005<<1],cost[5000005<<1];\nint dist[5000005],parent[5000005],last[5000005],augment[5000005];\nbool mark[5000005];\n\nvoid add(int u,int v,int w,int c) {\n\tnxt[++edge_num]=head[u];\n\tto[edge_num]=v;\n\tcap[edge_num]=w;\n\tcost[edge_num]=c;\n\thead[u]=edge_num;\n}\n\nbool spfa() {\n\tfor(int i=0;i<5000005;i++) dist[i]=INF;\n\tfor(int i=0;i<5000005;i++) mark[i]=0;\n\tqueue<int> q;\n\tq.push(s);\n\tmark[s]=1;\n\tdist[s]=0;\n\taugment[s]=INF;\n\tparent[t]=-1;\n\twhile(!q.empty()) {\n\t\tint u=q.front(); q.pop();\n\t\tmark[u]=0;\n\t\tfor(int i=head[u];i;i=nxt[i]) {\n\t\t\tif(cap[i] && dist[to[i]]>dist[u]+cost[i]) {\n\t\t\t\tdist[to[i]]=dist[u]+cost[i];\n\t\t\t\tparent[to[i]]=u;\n\t\t\t\tlast[to[i]]=i;\n\t\t\t\taugment[to[i]]=min(augment[u],cap[i]);\n\t\t\t\tif(!mark[to[i]]) {\n\t\t\t\t\tmark[to[i]]=1;\n\t\t\t\t\tq.push(to[i]);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn parent[t]!=-1;\n}\n\nvoid min_cost_flow() {\n\ttotal_flow=total_cost=0;\n\twhile(spfa()) {\n\t\tint v=t;\n\t\ttotal_flow+=augment[t];\n\t\ttotal_cost+=augment[t]*dist[t];\n\t\twhile(v!=s) {\n\t\t\tcap[last[v]]-=augment[t];\n\t\t\tcap[last[v]^1]+=augment[t];\n\t\t\tv=parent[v];\n\t\t}\n\t}\n}\n\nint compress(int t,int x) {\n\treturn t*n+x;\n}\n\nint main() {\n\tcin>>n>>m>>p>>c>>d;\n\ts=0; t=n*99+1;\n\tfor(int i=1,tmp;i<=p&&cin>>tmp;i++) {\n\t\tadd(s,compress(0,tmp),1,0);\n\t\tadd(compress(0,tmp),s,0,0);\n\t}\n\tfor(int i=1;i<=m;i++) cin>>x[i]>>y[i];\n\tfor(int i=0;i<=99;i++) {\n\t\tadd(compress(i,1),compress(i+1,1),INF,0);\n\t\tadd(compress(i+1,1),compress(i,1),0,0);\n\t\tfor(int j=2;j<=n;j++) {\n\t\t\tadd(compress(i,j),compress(i+1,j),INF,c);\n\t\t\tadd(compress(i+1,j),compress(i,j),0,-c);\n\t\t}\n\t\tfor(int j=1;j<=m;j++) {\n\t\t\tfor(int k=1;k<=p;k++) {\n\t\t\t\tint w=d*k*k-d*(k-1)*(k-1)+c;\n\t\t\t\tadd(compress(i,x[j]),compress(i+1,y[j]),1,w);\n\t\t\t\tadd(compress(i+1,y[j]),compress(i,x[j]),0,-w);\n\t\t\t\tadd(compress(i,y[j]),compress(i+1,x[j]),1,w);\n\t\t\t\tadd(compress(i+1,x[j]),compress(i,y[j]),0,-w);\n\t\t\t}\n\t\t}\n\t}\n\tmin_cost_flow();\n\tcout<<total_cost<<endl;\n\treturn 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**15\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_edge(fr, to, cap, cost):\n    graph[fr].append(Edge(to, len(graph[to]), cap, cost))\n    graph[to].append(Edge(fr, len(graph[fr])-1, 0, -cost))\n\ndef spfa():\n    global dist, mark, parent_v, parent_edge, augment\n    dist = [INF] * N\n    mark = [False] * N\n    parent_v = [-1] * N\n    parent_edge = [-1] * N\n    augment = [0] * N\n    q = deque()\n    q.append(s)\n    mark[s] = True\n    dist[s] = 0\n    augment[s] = INF\n    parent_v[t] = -1\n    while q:\n        u = q.popleft()\n        mark[u] = False\n        for i, e in enumerate(graph[u]):\n            if e.cap > 0 and dist[e.to] > dist[u] + e.cost:\n                dist[e.to] = dist[u] + e.cost\n                parent_v[e.to] = u\n                parent_edge[e.to] = i\n                augment[e.to] = min(augment[u], e.cap)\n                if not mark[e.to]:\n                    mark[e.to] = True\n                    q.append(e.to)\n    return parent_v[t] != -1\n\ndef min_cost_flow():\n    flow = 0\n    cost = 0\n    while spfa():\n        f = augment[t]\n        flow += f\n        cost += f * dist[t]\n        v = t\n        while v != s:\n            e = graph[parent_v[v]][parent_edge[v]]\n            e.cap -= f\n            graph[v][e.rev].cap += f\n            v = parent_v[v]\n    return flow, cost\n\ndef compress(time, node):\n    return time * n + node\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    global n, m, p, c, d, s, t, N, graph\n    n = int(next(it))\n    m = int(next(it))\n    p = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    start_nodes = [int(next(it)) for _ in range(p)]\n    edges = []\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        edges.append((x, y))\n\n    # Maximum node index: time 0..100 (since edges go to time+1)\n    max_time = 100\n    max_node_index = max_time * n + n  # compress(100, n) = 100*n+n = 101*n\n    N = max_node_index + 2  # safe margin\n    graph = [[] for _ in range(N)]\n\n    s = 0\n    t = n * 99 + 1  # compress(99, 1)\n\n    # Source to starting nodes at time 0\n    for nd in start_nodes:\n        add_edge(s, compress(0, nd), 1, 0)\n\n    # Time step edges\n    for i in range(100):\n        # Node 1: infinite capacity, cost 0\n        add_edge(compress(i, 1), compress(i+1, 1), INF, 0)\n        # Nodes 2..n\n        for j in range(2, n+1):\n            add_edge(compress(i, j), compress(i+1, j), INF, c)\n\n    # Month edges\n    for (x, y) in edges:\n        for i in range(100):\n            for k in range(1, p+1):\n                w = d * k * k - d * (k-1) * (k-1) + c\n                add_edge(compress(i, x), compress(i+1, y), 1, w)\n                add_edge(compress(i, y), compress(i+1, x), 1, w)\n\n    flow, total_cost = min_cost_flow()\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.4305104514278355e-06, -1.1920928244535389e-07, 0.0, -0.00029976642690598965, -0.002359108766540885, -6.318072337307967e-06, -8.070142939686775e-05, -0.001536261523142457, -7.152555099310121e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.0011850723531097174, -0.07990650832653046, -0.00011157367407577112, -1.8715683836489916e-05, -0.00029345019720494747, -0.12692900002002716, -1.329867959022522, -0.02146081253886223, -0.12885041534900665, -0.0018898261478170753, -1.311301275563892e-06, -4.410734163684538e-06, -0.1002216786146164, -1.1920928244535389e-07, -2.3841855067985307e-07, -5.722029527532868e-06, -9.298280929215252e-06, -0.017326654866337776, -2.3841855067985307e-07, -0.0009115354623645544, 0.0, -4.768370445162873e-07, -2.3841855067985307e-07, 0.0, -2.861018856492592e-06, -2.3841855067985307e-07, -2.145764938177308e-06, -1.1920928244535389e-07, -2.753696753643453e-05, -7.152555099310121e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, -0.018189411610364914, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -3.3378546504536644e-06, -1.1920928244535389e-07, 0.0, 0.0, -2.264974000354414e-06, 0.0, -0.00029905137489549816, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -4.768370445162873e-07, -1.311301275563892e-06, -1.1920928244535389e-07, 0.0, -2.38418