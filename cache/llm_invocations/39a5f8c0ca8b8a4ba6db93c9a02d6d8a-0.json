_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static long INF_VAL = 1000000007L;\n    static double EPSILON = 1e-15;\n    \n    static long n, x, y;\n    static double smallest_error = Double.MAX_VALUE;\n    static long[] best_answer = new long[2];\n    \n    static void assess(long denominator, long numerator) {\n        if (denominator <= 0) return;\n        double ratio = (double) numerator / denominator;\n        double target_ratio = (double) x / y;\n        double error = Math.abs(ratio - target_ratio);\n        \n        if (error + EPSILON < smallest_error) {\n            smallest_error = error;\n            best_answer[0] = denominator;\n            best_answer[1] = numerator;\n        }\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        x = scanner.nextLong();\n        y = scanner.nextLong();\n        n = scanner.nextLong();\n        \n        for (long b = 1; b <= n; ++b) {\n            long a = (x * b) / y;\n            assess(b, a);\n            assess(b, a + 1);\n        }\n        \n        System.out.println(best_answer[1] + \"/\" + best_answer[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015162272029556334, -2.622600959512056e-06, -3.576278118089249e-07, -0.00020644917094614357, -2.8967437174287625e-05, -0.07955239713191986, -0.1397475153207779, -1.597391747054644e-05, -3.576278118089249e-07, -3.683499380713329e-05, -0.0017025275155901909, -5.173549288883805e-05, -0.16678640246391296, -0.3521021902561188, -0.01047954149544239, -2.276871418871451e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, 0.0, 0.0, 0.0, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.264974000354414e-06, -4.768370445162873e-07, -7.510157047363464