ystem.in));\n             PrintWriter pw = new PrintWriter(System.out)) {\n            InputReader in = new InputReader(br);\n            TaskC solver = new TaskC();\n            solver.solve(1, in, pw);\n        } catch (Exception e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    static class TaskC {\n        static final int INF = (int) 1e9;\n\n        public void solve(int testNumber, InputReader in, PrintWriter out) {\n            int n = in.nextInt();\n            String s = in.next();\n            int nk = 0, nv = 0, no = 0;\n            int[] kpos = new int[n], vpos = new int[n], opos = new int[n];\n            int[] snk = new int[n + 1], snv = new int[n + 1], sno = new int[n + 1];\n            \n            for (int i = 0; i < n; ++i) {\n                char ch = s.charAt(i);\n                if (ch == 'V') vpos[nv++] = i;\n                else if (ch == 'K') kpos[nk++] = i;\n                else opos[no++] = i;\n                snk[i + 1] = nk;\n                snv[i + 1] = nv;\n                sno[i + 1] = no;\n            }\n\n            int[][][][] best = new int[2][nk + 1][nv + 1][no + 1];\n            for (int[][][] x : best) \n                for (int[][] y : x) \n                    for (int[] z : y) \n                        Arrays.fill(z, INF);\n            \n            best[0][0][0][0] = 0;\n\n            for (int k = 0; k <= nk; ++k) {\n                for (int v = 0; v <= nv; ++v) {\n                    for (int o = 0; o <= no; ++o) {\n                        for (int hv = 0; hv < 2; ++hv) {\n                            int cur = best[hv][k][v][o];\n                            if (cur == INF) continue;\n                            \n                            if (k < nk && hv == 0) {\n                                int cost = Math.max(snv[kpos[k]] - v, 0) + Math.max(sno[kpos[k]] - o, 0);\n                                best[0][k + 1][v][o] = Math.min(best[0][k + 1][v][o], cur + cost);\n                            }\n