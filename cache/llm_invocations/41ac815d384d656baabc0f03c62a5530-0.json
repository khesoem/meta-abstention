ead()) {\n            input = new FileInputStream(f);\n            output = new PrintStream(\"a.out\");\n        }\n        br = new BufferedReader(new InputStreamReader(input));\n        out = new PrintWriter(output);\n        solve();\n        br.close();\n        out.close();\n    }\n\n    void solve() {\n        long n = nextLong(), m = nextLong();\n        if (n > m) {\n            long tmp = n;\n            n = m;\n            m = tmp;\n        }\n        if (n > 3) {\n            long total = n * m;\n            out.println(total - (total % 2));\n        } else {\n            long s = m - (m % 6);\n            long h = 0;\n            long remainder = m % 6;\n            if (n == 1) {\n                if (remainder == 4) h = 2;\n                else if (remainder == 5) h = 4;\n            } else if (n == 2) {\n                if (remainder == 3) h = 4;\n                else if (remainder == 4) h = 8;\n                else if (remainder == 5) h = 10;\n            } else if (n == 3) {\n                if (remainder == 2) h = 4;\n                else if (remainder == 3) h = 8;\n                else if (remainder == 4) h = 12;\n                else if (remainder == 5) h = 14;\n            }\n            if (n + m > 9 && n > 1) {\n                long total = n * m;\n                out.println(total - (total % 2));\n                return;\n            }\n            out.println(s * n + h);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport os\n\nclass TaskD:\n    def __init__(self):\n        self.eof = False\n        self.br = None\n        self.st = None\n        self.out = None\n\n    def nextToken(self):\n        while self.st is None or not self.st.hasMoreTokens():\n            try:\n                line = self.br.readline()\n                if not line:\n                    self.eof = True\n                 