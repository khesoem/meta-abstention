{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nconst int MAXN = 5500;\nconst ll INF = 1e9 + 7;\n\nstruct Edge {\n    int to;\n    int cost;\n    int back;\n    int cap;\n};\n\nint n, m, k, c, d;\nint u, v, mx, s = MAXN - 2, t = MAXN - 1, mf = 0;\nint tr[MAXN];\nll ans = 0, dis[MAXN];\nvector<Edge> g[MAXN];\npriority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n\ninline void add_edge(int u, int v, int cost, int cap) {\n    int iu = g[u].size();\n    int iv = g[v].size();\n    g[u].push_back({v, cost, iv, cap});\n    g[v].push_back({u, -cost, iu, 0});\n}\n\nvoid dijkstra() {\n    fill(dis, dis + MAXN, INF);\n    pq.push({dis[s] = 0, s});\n    while (!pq.empty()) {\n        auto [du, x] = pq.top();\n        pq.pop();\n        if (du > dis[x]) continue;\n        for (const Edge &e : g[x]) {\n            if (e.cap > 0 && dis[e.to] > du + e.cost) {\n                tr[e.to] = e.back;\n                pq.push({dis[e.to] = du + e.cost, e.to});\n            }\n        }\n    }\n}\n\nvoid trace() {\n    int delta = k, v = t;\n    while (v != s) {\n        const Edge &rev = g[v][tr[v]];\n        int u = rev.to;\n        int fwd = rev.back;\n        delta = min(delta, g[u][fwd].cap);\n        v = u;\n    }\n    mf += delta;\n    ans += delta * dis[t];\n    v = t;\n    while (v != s) {\n        Edge &rev = g[v][tr[v]];\n        int u = rev.to;\n        int fwd = rev.back;\n        rev.cap += delta;\n        g[u][fwd].cap -= delta;\n        v = u;\n    }\n}\n\nint at(int u, int time) {\n    return u + time * n;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    mx = n + k;\n    for (int i = 0; i < k; i++) {\n        cin >> u;\n        add_edge(s, at(u, 0), 0, 1);\n    }\n    for (int i = 0; i <= mx; i++)\n        add_edge(at(1, i), t, c * i, k);\n    for (int i = 1; i <= n; i++)\n        for (int j = 0; j < mx; j++)\n            add_edge(at(i, j), at(i, j + 1), 0, k);\n    while (m--) {\n        cin >> u >> v;\n        for (int i = 1; i <= k; i++)\n            for (int j = 0; j < mx; j++) {\n                add_edge(at(u, j), at(v, j + 1), d * (2 * i - 1), 1);\n                add_edge(at(v, j), at(u, j + 1), d * (2 * i - 1), 1);\n            }\n    }\n    while (mf < k) {\n        dijkstra();\n        trace();\n    }\n    cout << ans;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 5500;\n    static final long INF = (long)1e9 + 7;\n    \n    static class Edge {\n        int to;\n        int cost;\n        int back;\n        int cap;\n        Edge(int to, int cost, int back, int cap) {\n            this.to = to;\n            this.cost = cost;\n            this.back = back;\n            this.cap = cap;\n        }\n    }\n    \n    static int n, m, k, c, d;\n    static int u, v, mx, s = MAXN - 2, t = MAXN - 1, mf = 0;\n    static int[] tr = new int[MAXN];\n    static long ans = 0;\n    static long[] dis = new long[MAXN];\n    static List<Edge>[] g = new ArrayList[MAXN];\n    static PriorityQueue<Pair> pq = new PriorityQueue<>();\n    \n    static class Pair implements Comparable<Pair> {\n        long dist;\n        int node;\n        Pair(long dist, int node) {\n            this.dist = dist;\n            this.node = node;\n        }\n        public int compareTo(Pair other) {\n            return Long.compare(this.dist, other.dist);\n        }\n    }\n    \n    static void add_edge(int u, int v, int cost, int cap) {\n        int iu = g[u].size();\n        int iv = g[v].size();\n        g[u].add(new Edge(v, cost, iv, cap));\n        g[v].add(new Edge(u, -cost, iu, 0));\n    }\n    \n    static void dijkstra() {\n        Arrays.fill(dis, INF);\n        pq.clear();\n        pq.add(new Pair(dis[s] = 0, s));\n        while (!pq.isEmpty()) {\n            Pair cur = pq.poll();\n            long du = cur.dist;\n            int x = cur.node;\n            if (du > dis[x]) continue;\n            for (Edge e : g[x]) {\n                if (e.cap > 0 && dis[e.to] > du + e.cost) {\n                    tr[e.to] = e.back;\n                    pq.add(new Pair(dis[e.to] = du + e.cost, e.to));\n                }\n            }\n        }\n    }\n    \n    static void trace() {\n        int delta = k, v = t;\n        while (v != s) {\n            Edge rev = g[v].get(tr[v]);\n            int u = rev.to;\n            int fwd = rev.back;\n            delta = Math.min(delta, g[u].get(fwd).cap);\n            v = u;\n        }\n        mf += delta;\n        ans += delta * dis[t];\n        v = t;\n        while (v != s) {\n            Edge rev = g[v].get(tr[v]);\n            int u = rev.to;\n            int fwd = rev.back;\n            rev.cap += delta;\n            g[u].get(fwd).cap -= delta;\n            v = u;\n        }\n    }\n    \n    static int at(int u, int time) {\n        return u + time * n;\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        mx = n + k;\n        \n        for (int i = 0; i < MAXN; i++) {\n            g[i] = new ArrayList<>();\n        }\n        \n        for (int i = 0; i < k; i++) {\n            u = sc.nextInt();\n            add_edge(s, at(u, 0), 0, 1);\n        }\n        \n        for (int i = 0; i <= mx; i++) {\n            add_edge(at(1, i), t, c * i, k);\n        }\n        \n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                add_edge(at(i, j), at(i, j + 1), 0, k);\n            }\n        }\n        \n        while (m-- > 0) {\n            u = sc.nextInt();\n            v = sc.nextInt();\n            for (int i = 1; i <= k; i++) {\n                for (int j = 0; j < mx; j++) {\n                    add_edge(at(u, j), at(v, j + 1), d * (2 * i - 1), 1);\n                    add_edge(at(v, j), at(u, j + 1), d * (2 * i - 1), 1);\n                }\n            }\n        }\n        \n        while (mf < k) {\n            dijkstra();\n            trace();\n        }\n        \n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.986991e-06, 0.0, 0.0, -5.125868e-05, -7.903264e-05, -9.5367386e-07, -0.04858767, -0.07903196, -0.00020680673, -2.3841855e-07, -0.0010280092, -0.0031844878, -0.0009190388, -0.06292056, -0.4742262, -3.0397907e-05, -1.6808368e-05, -4.0531077e-06, 0.0, -1.1920928e-07, -0.00017760607, -5.1259863e-06, -9.298281e-06, -2.3841855e-07, -7.152555e-07, -9.667406e-05, -0.00020978635, 0.0, -1.5497195e-06, -0.07935113, -0.00012432756, -0.0005529782, -0.31385687, -2.3841855e-07, -0.00046599974, -1.6689287e-06, -1.1920928e-07, -2.3841855e-07, -0.5781473, -0.02324661, -3.576278e-07, -2.503392e-06, -7.8436635e-05, -4.7683704e-07, -1.6927