l x, int p) {\n    if (p == 0) return 1;\n    if (p % 2 == 1) return mod_pow(x, p - 1) * x % MOD;\n    ll y = mod_pow(x, p / 2);\n    return y * y % MOD;\n}\n\nll mod_inv(ll a) {\n    // extended Euclidean algorithm\n    ll t = 0, newt = 1;\n    ll r = MOD, newr = a;\n    while (newr != 0) {\n        ll quotient = r / newr;\n        ll tmp = t - quotient * newt;\n        t = newt;\n        newt = tmp;\n        tmp = r - quotient * newr;\n        r = newr;\n        newr = tmp;\n    }\n    if (r != 1) return -1; // not invertible\n    if (t < 0) t += MOD;\n    return t;\n}\n\nclass Vector {\npublic:\n    int sz;\n    vector<ll> v;\n    ll *warr, *winvarr;\n    ll mod, w, winv, szinv;\n\n    Vector(vector<ll>& a, ll mod, ll w, ll winv, ll szinv, ll* warr, ll* winvarr)\n        : sz(SZ), v(SZ, 0), mod(mod), w(w), winv(winv), szinv(szinv), warr(warr), winvarr(winvarr) {\n        for (int i = 0; i < (int)a.size(); i++) {\n            v[i] = a[i];\n        }\n    }\n\n    vector<ll> FFT() {\n        return DFT(0, 1, true);\n    }\n\n    vector<ll> FFT1() {\n        vector<ll> x = DFT(0, 1, false);\n        for (int i = 0; i < (int)x.size(); i++) {\n            x[i] = x[i] * szinv % mod;\n        }\n        return x;\n    }\n\n    vector<ll> DFT(int first, int pow, bool straight) {\n        if (pow == sz) {\n            return { v[first] };\n        }\n        vector<ll> zero = DFT(first, 2 * pow, straight);\n        vector<ll> one = DFT(first + pow, 2 * pow, straight);\n        int n = zero.size();\n        vector<ll> ans(2 * n);\n        ll* roots = straight ? warr : winvarr;\n        for (int i = 0; i < n; i++) {\n            ll t = roots[i * pow] * one[i] % mod;\n            ans[i] = (zero[i] + t) % mod;\n            ans[n + i] = ((zero[i] - t) % mod + mod) % mod;\n        }\n        return ans;\n    }\n};\n\nvector<ll> fft_naive(vector<ll>& a, ll w, ll mod) {\n    vector<ll> ans(SZ, 0);\n    ll wth = 1;\n    for (int i = 0; i < SZ; i++) {\n        ll x = 1;\n        for (int j = 0; j < (int)a.size(); j++) {\n            ans[i] = (ans[i] + a[j] * x) % mod;\n            x = x * wth % mod;\n        }\n        wth = wth * w % mod;\n    }\n    return ans;\n}\n\nvector<ll> pow_vec(vector<ll>& ans, int p) {\n    for (int i = 0; i < (int)ans.size(); i++) {\n        ans[i] = mod_pow(ans[i], p);\n    }\n    return ans;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n\n    int n, k;\n    cin >> n >> k;\n    vector<ll> arr(10, 0);\n    for (int i = 0; i < k; i++) {\n        int d;\n        cin >> d;\n        arr[d] = 1;\n    }\n\n    ll winv = mod_inv(W);\n    ll szinv = mod_inv(SZ);\n\n    // precompute roots\n    vector<ll> warr(SZ, 0), winvarr(SZ, 0);\n    warr[0] = 1;\n    winvarr[0] = 1;\n    for (int i = 1; i < SZ; i++) {\n        warr[i] = warr[i - 1] * W % MOD;\n        winvarr[i] = winvarr[i - 1] * W % MOD; // same as warr (as in original code)\n    }\n\n    vector<ll> x = fft_naive(arr, W, MOD);\n    x = pow_vec(x, n / 2);\n    Vector v(x, MOD, W, winv, szinv, warr.data(), winvarr.data());\n    x = v.FFT1();\n    ll ans = 0;\n    for (int i = 0; i < (int)x.size(); i++) {\n        ans = (ans + x[i] * x[i]) % MOD;\n    }\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.5856063365936279, -6.0794889577664435e-05, 0.0, -1.1920928244535389e-07, -0.0002094287920044735, -0.0006255338666960597, -8.22540732769994e-06, -0.47409969568252563, -3.123234637314454e-05, 0.0, 0.0, -0.00013565097469836473, -1.0728830375228426e-06, -2.3841855067985307e-07, 0.0, -0.13681736588478088, -0.0015124559868127108, -0.0024775543715804815, -1.1920928244535389e-07, -0.5082896947860718, -0.06201052665710449, -0.011063659563660622, -1.1920928244535389e-07, -0.4145621955394745, -0.813541054725647, -0.029794618487358093, -0.01816939376294613, -7.152555099310121e-07, -0.8205366134643555, -0.00024720950750634074, -0.00010084597306558862, 0.0, -0.021480998024344444, -4.76