) { inq[q[qs] = v] = qs; qs++; }\n\t\t\t\t\tfor( int i = inq[v], j = ( i - 1 )/2, t;\n\t\t\t\t\t\t\tdist[q[i]] < dist[q[j]]; i = j, j = ( i - 1 )/2 )\n\t\t\t\t\t\tBUBL;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif (dist[t] >= INF) return 0; ll df = INF;\n\t\tfor (int e, i = t; i != s; i = ep[e])\n\t\t\te = par[i], df = min(df, cap[e] - flo[e]);\n\t\tfor (int e, i = t; i != s; i = ep[e])\n\t\t\te = par[i], flo[e] += df, flo[e^1] -= df, price += df*cost[e];\n\t\tfor (int i = 0; i < n; ++i) pot[i] = min(INF, dist[i] + pot[i]);\n\t\treturn df; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\tFlow::init();\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tFlow::mcf_pot_init(Flow::N);\n\tll price = 0;\n\tll flow = 0;\n\twhile (ll df = Flow::mcf_update(source, sink, price, Flow::N)) flow += df;\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport heapq\n\n# Constants\nT = 99\nC = 15\nINF = 0x3f3f3f3f\n\n# Flow namespace as a class\nclass Flow:\n    N = 50 * T + 2\n    M = 2 * N * C + N + 7\n\n    def __init__(self):\n        self.par = [-1] * self.N\n        self.first = [-1] * self.N\n        self.nxt = [-1] * (2 * self.M)\n        self.ep = [-1] * (2 * self.M)\n        self.flo = [0] * (2 * self.M)\n        self.cap = [0] * (2 * self.M)\n        self.cost = [0] * (2 * self.M)\n        self.m = 0\n\n    def init(self):\n        self.m = 0\n        for i in range(self.N):\n            self.first[i] = -1\n        for i in range(len(self.flo)):\n            self.flo[i] = 0\n\n    def add_edge(self, a, b, c=1, p=0):\n        e1 = self.m\n        self.nxt[e1] = self.first[a]\n        self.first[a] = e1\n        self.ep[e1] = b\n        self.cap[e1] = c\n        self.cost[e1] = p\n        self.m += 1\n\n        e2 = self.m\n        self.nxt[e2] = self.first[b]\n        self.first[b] = e2\n        self.ep[e2] = a\n        self.cap[e2] = 0\n        self.cost[e2] = -p\n        self.m += 1\n\n    def mcf_pot_init(self, n):\n        self.pot = [0] * n\n        for _ in range(1, n):\n            for e in range(self.m):\n                if self.cap[e]:\n                    u = self.ep[e ^ 1]\n                    v = self.ep[e]\n                    self.pot[v] = min(self.pot[v], self.pot[u] + self.cost[e]) if self.pot[v] != 0 else self.pot[v]\n\n    def mcf_update(self, s, t, price, n):\n        INF_DIST = 10**15\n        vis = [False] * n\n        dist = [INF_DIST] * n\n        inq = [-1] * n\n        dist[s] = 0\n        q = []\n        heapq.heappush(q, (0, s))\n        while q:\n            d, u = heapq.heappop(q)\n            if vis[u]:\n                continue\n            vis[u] = True\n            for e in range(self.first[u], -1, self.nxt[e] if hasattr(self, 'nxt') else -1):\n                v = self.ep[e]\n                if self.cap[e] - self.flo[e] > 0:\n                    nd = dist[u] + self.cost[e] + self.pot[u] - self.pot[v]\n                    if nd < dist[v]:\n                        dist[v] = nd\n                        self.par[v] = e\n                        heapq.heappush(q, (dist[v], v))\n        if dist[t] == INF_DIST:\n            return 0\n        df = INF_DIST\n        i = t\n        while i != s:\n            e = self.par[i]\n            df = min(df, self.cap[e] - self.flo[e])\n            i = self.ep[e ^ 1]\n        i = t\n        while i != s:\n            e = self.par[i]\n            self.flo[e] += df\n            self.flo[e ^ 1] -= df\n            price[0] += df * self.cost[e]\n            i = self.ep[e ^ 1]\n        for i in range(n):\n            self.pot[i] = min(10**15, self.pot[i] + dist[i])\n        return df\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n, m, k, c, d = map(int, data[:5])\n    idx = 5\n\n    source = 0\n    sink = n * T + 1\n\n    flow = Flow()\n    flow.init()\n\n    for _ in range(k):\n        a = int(data[idx])\n        idx += 1\n        flow.add_edge(source, a, 1, 0)\n\n    for t in range(T):\n        flow.add_edge(1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(data[idx])\n        b = int(data[idx + 1])\n        idx += 2\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    flow.mcf_pot_init(flow.m)\n    price = [0]\n    flow_value = 0\n    while True:\n        df = flow.mcf_update(source, sink, price, flow.m)\n        if df == 0:\n            break\n        flow_value += df\n\n    assert flow_value == k\n    print(price[0])\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.002114097122102976, -0.0006507210782729089, -1.7432603272027336e-06, -4.417976379045285e-05, -0.0024066928308457136, -0.0013305948814377189, -0.0006371428607963026, -0.008322600275278091, -0.0003573919821064919, -0.11283976584672928, -0.5811317563