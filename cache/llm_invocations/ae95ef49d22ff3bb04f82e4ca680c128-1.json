   x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for i in args:\n                r = self.mult_two(r, i)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            assert g == 1\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    raise EOFError()\n                self.tokenizer = line.strip().split()\n            except EOFError:\n                raise RuntimeError(\"No more input\")\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    input_index = 0\n    \n    def next_input():\n        nonlocal input_index\n        val = input_data[input_index]\n        input_index += 1\n        return val\n    \n    n = int(next_input())\n    m = int(next_input())\n\n    mod = NumberTheory.Mod998()\n    mod.fInv(n + m)\n\n    phaseSize = 1\n    p = 1\n    for i in range(n + 1):\n        if p == 0:\n            break\n   