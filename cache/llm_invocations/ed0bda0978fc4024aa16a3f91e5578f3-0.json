;\n            }\n            d[s] = 0;\n            inq[s] = true;\n            p[s] = 0;\n            a[s] = Long.MAX_VALUE;\n\n            ArrayDeque<Integer> Q = new ArrayDeque<>();\n            Q.add(s);\n            while (!Q.isEmpty()) {\n                int u = Q.poll();\n                inq[u] = false;\n\n                for (int i = 0; i < G[u].size(); i++) {\n                    Edge e = E.get(G[u].get(i));\n                    if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                        d[e.v] = d[u] + e.cost;\n                        p[e.v] = G[u].get(i);\n                        a[e.v] = Math.min(a[u], e.cap - e.flow);\n\n                        if (!inq[e.v]) {\n                            Q.add(e.v);\n                            inq[e.v] = true;\n                        }\n                    }\n                }\n            }\n\n            if (d[t] == Long.MAX_VALUE) {\n                return false;\n            }\n            flow[0] = a[t];\n            cost[0] = d[t];\n            int u = t;\n            while (u != s) {\n                E.get(p[u]).flow += a[t];\n                E.get(p[u] ^ 1).flow -= a[t];\n                u = E.get(p[u]).u;\n            }\n            return true;\n        }\n\n        public long[] Mincost(int s, int t) {\n            this.s = s;\n            this.t = t;\n            long Mcost = 0;\n            long Flow = 0;\n            long f = 0;\n            long d = 0;\n\n            while (BelmanFord(new long[]{f}, new long[]{d})) {\n                Flow += f;\n                Mcost += f * d;\n            }\n            return new long[]{Flow, Mcost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int C = Integer.parseInt(st.nextToken());\n        int D = Integer.parseInt(st.nextToken());\n\n        MCMF solver = new MCMF(n * k + 2);\n        int source = n * k;\n        int sink = n * k + 1;\n\n        for (int i = 0; i < k; i++) {\n            solver.addEdge(i, sink, k, C * i);\n        }\n\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(br.readLine()) - 1;\n            solver.addEdge(source, x * k, 1, 0);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 1; j < k; j++) {\n                solver.addEdge(i * k + j - 1, i * k + j, k, 0);\n            }\n        }\n\n        while (m-- > 0) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken()) - 1;\n            int v = Integer.parseInt(st.nextToken()) - 1;\n\n            for (int j = 1; j < k; j++) {\n                int a = u * k + j - 1;\n                int b = v * k + j;\n                int c = v * k + j - 1;\n                int d = u * k + j;\n\n                for (int i = 1, cc = D; i <= k; i++, cc += 2 * D) {\n                    solver.addEdge(a, b, 1, cc);\n                    solver.addEdge(c, d, 1, cc);\n                }\n            }\n        }\n\n        long[] pr = solver.Mincost(source, sink);\n        pw.println(pr[1]);\n        pw.close();\n    }\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.5252753496170044, -0.003062701551243663, -0.5776993632316589, -0.008152906782925129, -0.00011134767555631697, -0.5238273739814758, -0.4971482753753662, -3.3736796467565e-05, -2.1100266167195514e-05, -2.1934749383945018e-05, -2.5749537599040195e-05, -0.08582648634910583, -3.576279254957626e-07, -2.2649790025752736e-06, -1.2755474926962052e-05, -5.841272468387615e-06, -0.004631499294191599, -6.640177889494225e-05, -1.0371261851105373e-05, -1.2159421203250531e-05, 