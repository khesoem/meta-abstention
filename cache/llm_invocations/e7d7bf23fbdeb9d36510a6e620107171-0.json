f ((rmask & (1 << i)) && p[i] > 1e-5) {\n\t\t\t\t\tdp[mask | (1 << i)] += dp[mask] * p[i] / sum[rmask];\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tvector<double> ans(n, 0.0);\n\t\tfor (int mask = 0; mask < (1 << n); mask++) {\n\t\t\tint bitCount = 0;\n\t\t\tfor (int i = 0; i < n; i++) {\n\t\t\t\tif (mask & (1 << i)) bitCount++;\n\t\t\t}\n\t\t\tif (bitCount != k) continue;\n\t\t\tfor (int i = 0; i < n; i++) {\n\t\t\t\tif (mask & (1 << i)) {\n\t\t\t\t\tans[i] += dp[mask];\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tfor (int i = 0; i < n; i++) {\n\t\t\tif (i == n - 1) cout << ans[i] << '\\n';\n\t\t\telse cout << ans[i] << ' ';\n\t\t}\n\t}\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef main():\n    import sys\n    sys.setrecursionlimit(1000000)\n    \n    # Check if we're not in an online judge environment\n    # In Python, we can't directly check for ONLINE_JUDGE, so we'll assume console I/O\n    # If needed, we can redirect input/output using sys.stdin/sys.stdout\n    \n    # Set precision\n    # Python's print formatting will handle precision\n    \n    data = sys.stdin.read().split()\n    idx = 0\n    \n    while idx < len(data):\n        n = int(data[idx])\n        k = int(data[idx + 1])\n        idx += 2\n        \n        p = []\n        for i in range(n):\n            p.append(float(data[idx]))\n            idx += 1\n        \n        # Calculate sum for each subset\n        sum_arr = [0.0] * (1 << n)\n        for i in range(1 << n):\n            for j in range(n):\n                if i & (1 << j):\n                    sum_arr[i] += p[j]\n        \n        # Count non-negligible probabilities\n        cnt = sum(1 for i in range(n) if p[i] > 1e-5)\n        \n        if cnt <= k:\n            result = []\n            for i in range(n):\n                pp = 1.0 if p[i] > 1e-5 else 0.0\n                result.append(str(pp))\