   while (cur != s) {\n        e[pe[cur]].f++;\n        e[pe[cur] ^ 1].f--;\n        cur = p[cur];\n    }\n    ans += d[t];\n}\n\nvoid add_edge(int x, int y, int c, int cost) {\n    g[x].push_back(e.size());\n    e.push_back(edge(y, c, 0, cost));\n    g[y].push_back(e.size());\n    e.push_back(edge(x, 0, 0, -cost));\n}\n\nint main() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        add_edge(s, x, 1, 0);\n    }\n    int T = 101;\n    for (int i = 0; i < T; ++i)\n        add_edge(0 + i * n, t, k, i * c);\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        for (int i = 0; i < T - 1; ++i)\n            for (int j = 0; j < k; ++j)\n                add_edge(x + i * n, y + i * n + n, 1, d * (j * 2 + 1));\n        for (int i = 0; i < T - 1; ++i)\n            for (int j = 0; j < k; ++j)\n                add_edge(y + i * n, x + i * n + n, 1, d * (j * 2 + 1));\n    }\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < T - 1; ++j)\n            add_edge(i + j * n, i + j * n + n, k, 0);\n    for (int i = 0; i < k; ++i)\n        push_flow();\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\nN = 14043\ns = N - 2\nt = N - 1\n\nclass Edge:\n    __slots__ = ('y', 'c', 'f', 'cost')\n    def __init__(self, y, c, f, cost):\n        self.y = y\n        self.c = c\n        self.f = f\n        self.cost = cost\n\ne = []  # list of edges\ng = [[] for _ in range(N)]  # adjacency list\n\ndef rem(x):\n    return e[x].c - e[x].f\n\ndef push_flow():\n    d = [INF] * N\n    p = [-1] * N\n    pe = [-1] * N\n    inq = [0] * N\n    d[s] = 0\n    q = deque()\n    q.append(s)\n    inq[s] = 1\n    while q:\n        k = q.p