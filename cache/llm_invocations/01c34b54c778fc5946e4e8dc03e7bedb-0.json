 gb;\n            long z = y / gb;\n            long t = b * z; // careful: may overflow but assume safe\n            long u = q * t + rem * c; // may overflow but assume safe\n\n            // add floor approximation\n            long a = u / z;\n            addCandidate(candidates, b, u, z, t, a);\n\n            // add ceil approximation if not exact\n            if (u % z != 0) {\n                a = (u + z - 1) / z;\n                addCandidate(candidates, b, u, z, t, a);\n            }\n        }\n\n        Collections.sort(candidates);\n\n        System.out.println(candidates.get(0).num + \"/\" + candidates.get(0).den);\n    }\n\n    static void addCandidate(List<Candidate> candidates, long b, long u, long z, long t, long a) {\n        long gg = gcd(a, b);\n        long reducedDen = b / gg;\n        long reducedNum = a / gg;\n        BigInteger distNum = BigInteger.valueOf(Math.abs(u - a * z));\n        BigInteger distDen = BigInteger.valueOf(t); // t is positive\n        candidates.add(new Candidate(distNum, distDen, reducedDen, reducedNum));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920922133867862e-06, 0.0, -1.1920928244535389e-07, -8.141662692651153e-05, -1.3589766240329482e-05, -1.311301275563892e-06, -0.023352012038230896, -0.16179309785366058, -3.6954811548639555e-06, -1.2993727978027891e-05, -3.671578815556131e-05, -0.0011811431031674147, 0.0, -1.1920928244535389e-07, -0.0007348936051130295, -0.0015242397785186768, -2.145764938177308e-06, -0.007665741257369518, -0.023317422717809677, -0.011077924631536007, -0.0585271455347538, -0.2522118091583252, -2.3841855067985307e-07, -3.814689989667386e-06, -7.152555099310121e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -4.291525328881107e-06, -1.8954096958623268e-05, -1.1920928244535389e-07, -0.023169854655861855, -1.7881377516459906e-06, -4.768360213347478e-06, -9.643566590966657e-05, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -3.12323463