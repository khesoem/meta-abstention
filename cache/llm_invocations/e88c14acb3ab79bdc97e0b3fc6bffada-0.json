;\n    vector<vector<int>> dp0(k+1, vector<int>(2*n+1, INF));\n    vector<vector<int>> dp1(k+1, vector<int>(2*n+1, INF));\n    dp0[k][n] = 0;\n    dp1[k][n] = 0;\n    RMQ rmq0(dp0[k]);\n    RMQ rmq1(dp1[k]);\n    for (int i = k-1; i >= 0; --i) {\n        for (int j = 0; j <= 2*n; ++j) {\n            // dp0[i][j]\n            if (j + l[i] + delt[i] <= 2*n) dp0[i][j] = dp0[i+1][j + l[i] + delt[i]];\n            else dp0[i][j] = INF;\n            dp0[i][j] = min(dp0[i][j], 1 + rmq1.query(j, min(j + l[i], 2*n)));\n            // dp1[i][j]\n            dp1[i][j] = dp1[i+1][j];\n            if (j + delt[i] <= 2*n) {\n                dp1[i][j] = min(dp1[i][j], 1 + rmq0.query(j + delt[i], min(j + l[i] + delt[i], 2*n)));\n                dp0[i][j] = min(dp0[i][j], 2 + rmq0.query(j + delt[i], min(j + l[i] + delt[i], 2*n)));\n            }\n            dp1[i][j] = min(dp1[i][j], 2 + rmq1.query(j, min(j + l[i], 2*n)));\n        }\n        rmq0 = RMQ(dp0[i]);\n        rmq1 = RMQ(dp1[i]);\n    }\n    int ans = dp1[0][0];\n    if (ans == INF) {\n        cout << \"Hungry\\n\";\n    } else {\n        cout << \"Full\\n\" << ans << \"\\n\";\n    }\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.106198947643861e-06, 0.0, 0.0, -0.00011586471373448148, -0.0002169373765354976, -9.762764238985255e-05, -0.1025114357471466, 0.0, -4.768370445162873e-07, 0.0, -0.00031263710116036236, -3.93382906622719e-05, -2.622600959512056e-06, 0.0, -0.0009148702956736088, -0.7366169691085815, -0.023278523236513138, 0.0, -7.748573807475623e-06, -4.0649541915627196e-05, -0.004078523721545935, -0.0006185048841871321, -0.10128981620073318, -0.002940261736512184, -0.00024816294899210334, 0.0, -1.1920928244535389e-07, -3.957670196541585e-05, -8.344646857949556e-07, -0.00020358874462544918, -0.002873817225918174, -0.23233050107955933, -0.005235414020717144, -0.01578889787197113, 0.0, -0.14750072360038757, -1.1920928244535389e-07, 0.0, -0.00015841660206206143, -1.347