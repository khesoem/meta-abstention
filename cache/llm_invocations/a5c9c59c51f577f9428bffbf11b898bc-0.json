{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst int MAX_NODES = 5010;\nconst int INF = 1 << 30;\n\nstruct Edge {\n    int to, capacity, cost, reverse;\n};\n\nclass NetworkFlow {\npublic:\n    int nodeCount;\n    vector<Edge> edges[MAX_NODES];\n    int potential[MAX_NODES];\n    int distance[MAX_NODES];\n    int parentVertex[MAX_NODES], parentEdge[MAX_NODES];\n\n    void configure(int nodes) { nodeCount = nodes; }\n\n    void connect(int from, int to, int cap, int cst) {\n        edges[from].push_back({to, cap, cst, (int)edges[to].size()});\n        edges[to].push_back({from, 0, -cst, (int)edges[from].size() - 1});\n    }\n\n    int compute(int source, int sink, int requiredFlow) {\n        int result = 0;\n        memset(potential, 0, sizeof(potential));\n        while (requiredFlow > 0) {\n            priority_queue<pii, vector<pii>, greater<pii>> pq;\n            fill(distance, distance + nodeCount, INF);\n            distance[source] = 0;\n            pq.emplace(0, source);\n            while (!pq.empty()) {\n                auto [d, u] = pq.top(); pq.pop();\n                if (distance[u] < d) continue;\n                for (int i = 0; i < edges[u].size(); ++i) {\n                    auto& e = edges[u][i];\n                    if (e.capacity > 0 && distance[e.to] > distance[u] + e.cost + potential[u] - potential[e.to]) {\n                        distance[e.to] = distance[u] + e.cost + potential[u] - potential[e.to];\n                        parentVertex[e.to] = u;\n                        parentEdge[e.to] = i;\n                        pq.emplace(distance[e.to], e.to);\n                    }\n                }\n            }\n            if (distance[sink] == INF) return -1;\n            for (int i = 0; i < nodeCount; ++i) potential[i] += distance[i];\n            int flow = requiredFlow;\n            for (int v = sink; v != source; v = parentVertex[v])\n                flow = min(flow, edges[parentVertex[v]][parentEdge[v]].capacity);\n            requiredFlow -= flow;\n            result += flow * potential[sink];\n            for (int v = sink; v != source; v = parentVertex[v]) {\n                auto& e = edges[parentVertex[v]][parentEdge[v]];\n                e.capacity -= flow;\n                edges[v][e.reverse].capacity += flow;\n            }\n        }\n        return result;\n    }\n};\n\nNetworkFlow network;\nint n, m, k, c, d;\nint values[50], counts[50];\nvector<int> connections[50];\nconst int TIME_LIMIT = 100;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 0; i < k; ++i) {\n        cin >> values[i];\n        ++counts[values[i] - 1];\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        connections[u].push_back(v);\n        connections[v].push_back(u);\n    }\n    network.configure(n * TIME_LIMIT + 2);\n    for (int i = 0; i < n; ++i)\n        network.connect(n * TIME_LIMIT, i, counts[i], 0);\n    for (int t = 0; t < TIME_LIMIT; ++t)\n        network.connect(t * n, n * TIME_LIMIT + 1, k, c * t);\n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < TIME_LIMIT - 1; ++t)\n            network.connect(t * n + i, (t + 1) * n + i, k, 0);\n        for (int neighbor : connections[i]) {\n            for (int t = 0; t < TIME_LIMIT - 1; ++t) {\n                for (int u = 0; u < k; ++u) {\n                    int cost = (u + 1) * (u + 1) * d - u * u * d;\n                    network.connect(t * n + i, (t + 1) * n + neighbor, 1, cost);\n                }\n            }\n        }\n    }\n    cout << network.compute(n * TIME_LIMIT, n * TIME_LIMIT + 1, k) << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\nfrom collections import defaultdict\n\nMAX_NODES = 5010\nINF = 1 << 30\n\nclass Edge:\n    __slots__ = ('to', 'capacity', 'cost', 'reverse')\n    def __init__(self, to, capacity, cost, reverse):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.reverse = reverse\n\nclass NetworkFlow:\n    def __init__(self):\n        self.nodeCount = 0\n        self.edges = [[] for _ in range(MAX_NODES)]\n        self.potential = [0] * MAX_NODES\n        self.distance = [0] * MAX_NODES\n        self.parentVertex = [0] * MAX_NODES\n        self.parentEdge = [0] * MAX_NODES\n\n    def configure(self, nodes):\n        self.nodeCount = nodes\n\n    def connect(self, from_node, to_node, cap, cst):\n        idx1 = len(self.edges[from_node])\n        idx2 = len(self.edges[to_node])\n        self.edges[from_node].append(Edge(to_node, cap, cst, idx2))\n        self.edges[to_node].append(Edge(from_node, 0, -cst, idx1))\n\n    def compute(self, source, sink, requiredFlow):\n        result = 0\n        self.potential = [0] * self.nodeCount\n        \n        while requiredFlow > 0:\n            # Dijkstra's algorithm with priority queue\n            pq = []\n            self.distance = [INF] * self.nodeCount\n            self.distance[source] = 0\n            heapq.heappush(pq, (0, source))\n            \n            while pq:\n                d, u = heapq.heappop(pq)\n                if self.distance[u] < d:\n                    continue\n                for i in range(len(self.edges[u])):\n                    e = self.edges[u][i]\n                    if e.capacity > 0 and self.distance[e.to] > self.distance[u] + e.cost + self.potential[u] - self.potential[e.to]:\n                        self.distance[e.to] = self.distance[u] + e.cost + self.potential[u] - self.potential[e.to]\n                        self.parentVertex[e.to] = u\n                        self.parentEdge[e.to] = i\n                        heapq.heappush(pq, (self.distance[e.to], e.to))\n            \n            if self.distance[sink] == INF:\n                return -1\n            \n            for i in range(self.nodeCount):\n                self.potential[i] += self.distance[i]\n            \n            flow = requiredFlow\n            v = sink\n            while v != source:\n                u = self.parentVertex[v]\n                edge_idx = self.parentEdge[v]\n                flow = min(flow, self.edges[u][edge_idx].capacity)\n                v = u\n            \n            requiredFlow -= flow\n            result += flow * self.potential[sink]\n            \n            v = sink\n            while v != source:\n                u = self.parentVertex[v]\n                edge_idx = self.parentEdge[v]\n                e = self.edges[u][edge_idx]\n                e.capacity -= flow\n                rev_edge = self.edges[v][e.reverse]\n                rev_edge.capacity += flow\n                v = u\n        \n        return result\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    values = []\n    counts = [0] * 50\n    \n    for _ in range(k):\n        val = int(next(it))\n        values.append(val)\n        counts[val - 1] += 1\n    \n    connections = [[] for _ in range(50)]\n    \n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        connections[u].append(v)\n        connections[v].append(u)\n    \n    network = NetworkFlow()\n    TIME_LIMIT = 100\n    network.configure(n * TIME_LIMIT + 2)\n    \n    # Connect source to nodes\n    for i in range(n):\n        network.connect(n * TIME_LIMIT, i, counts[i], 0)\n    \n    # Connect time layers to sink\n    for t in range(TIME_LIMIT):\n        network.connect(t * n, n * TIME_LIMIT + 1, k, c * t)\n    \n    # Connect same node across time layers\n    for i in range(n):\n        for t in range(TIME_LIMIT - 1):\n            network.connect(t * n + i, (t + 1) * n + i, k, 0)\n    \n    # Connect neighbors across time layers\n    for i in range(n):\n        for neighbor in connections[i]:\n            for t in range(TIME_LIMIT - 1):\n                for u in range(k):\n                    cost = (u + 1) * (u + 1) * d - u * u * d\n                    network.connect(t * n + i, (t + 1) * n + neighbor, 1, cost)\n    \n    result = network.compute(n * TIME_LIMIT, n * TIME_LIMIT + 1, k)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015472168161068112, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0002992897352669388, -0.2017374485731125, -0.0032440200448036194, -0.0430004820227623, -0.000788139586802572, -0.07924144715070724, -0.0002739054325502366, -0.00319126108661294, -3.576278118089249e-07, -0.0011710221879184246, -0.0006138585740700364, -0.26986247301101685, -3.3378546504536644e-06, 0.0, 0.0, -1.1920928244535389e-07, -1.43051045