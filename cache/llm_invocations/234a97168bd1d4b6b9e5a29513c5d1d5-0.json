ng modPower(long long base, long long exp) {\n    long long res = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) res = (res * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nvoid sortArray(std::vector<int>& arr) {\n    if (arr.size() <= 1) return;\n    int mid = arr.size() / 2;\n    std::vector<int> left(arr.begin(), arr.begin() + mid);\n    std::vector<int> right(arr.begin() + mid, arr.end());\n    \n    sortArray(left);\n    sortArray(right);\n    \n    int i = 0, j = 0, k = 0;\n    while (i < left.size() && j < right.size()) {\n        arr[k++] = (left[i] <= right[j]) ? left[i++] : right[j++];\n    }\n    while (i < left.size()) arr[k++] = left[i++];\n    while (j < right.size()) arr[k++] = right[j++];\n}\n\nint main() {\n    MyScanner sc;\n    \n    long long a = sc.nextLong();\n    long long b = sc.nextLong();\n    \n    long long n = std::min(a, b);\n    long long m = std::max(a, b);\n    \n    if (n <= 2 && m <= 2) {\n        std::cout << 0 << std::endl;\n    } else if (n == 1) {\n        long long q = m / 6;\n        long long r = m % 6;\n        long long ans = q * 6;\n        if (r >= 4) {\n            ans += (r - 3) * 2;\n        }\n        std::cout << ans << std::endl;\n    } else if (n == 2) {\n        long long ans = 2 * m;\n        if (m == 3) ans = 4;\n        else if (m == 7) ans = 12;\n        std::cout << ans << std::endl;\n    } else {\n        std::cout << (n * m) - ((n * m) % 2) << std::endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00041416651220060885, -4.768360213347478e-06, -4.768370445162873e-07, -9.357491217087954e-05, -7.152555099310121e-07, -6.9141146923357155e-06, -4.410734163684538e-06, -1.2159273865108844e-05, -1.1920928244535389e-07, -0.10403864830732346, -1.1920922133867862e-06, -4.529942543740617e-06, -2.145764938177308e-06, -1.085161566734314, -0.001843778183683753, -0.002806179691106