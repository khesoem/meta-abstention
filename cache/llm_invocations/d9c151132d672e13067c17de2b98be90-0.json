{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cmath>\n#include <algorithm>\n#include <map>\n#include <numeric>\n\nusing namespace std;\n\nusing ll = long long;\n\nll mod_pow(ll base, int exp, int mod) {\n    ll res = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1)\n            res = (res * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k, p;\n    cin >> n >> k >> p;\n\n    if (n & 1) {\n        cout << mod_pow(k, n, p) << '\\n';\n        return 0;\n    }\n\n    vector<ll> fact(n + 1), inv_fact(n + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i)\n        fact[i] = fact[i-1] * i % p;\n    inv_fact[n] = mod_pow(fact[n], p-2, p);\n    for (int i = n; i > 0; --i)\n        inv_fact[i-1] = inv_fact[i] * i % p;\n\n    vector<vector<ll>> dp(1 << 18, vector<ll>(17, 0));\n    dp[0][0] = 1;\n\n    for (int m = 1; m <= n; ++m) {\n        if ((m & n) != m) continue;\n\n        vector<int> ones;\n        for (int b = 0; b < 18; ++b)\n            if (m & (1 << b)) ones.push_back(b);\n\n        if (ones.empty()) continue;\n\n        int ssz = ones.size();\n        for (int mask = 1; mask < (1 << ssz); ++mask) {\n            int l = 0;\n            for (int b = 0; b < ssz; ++b)\n                if (mask & (1 << b)) l ^= (1 << ones[b]);\n\n            ll w = inv_fact[l];\n            for (int t = 1; t <= 16; ++t)\n                dp[m][t] = (dp[m][t] + w * dp[m ^ l][t-1]) % p;\n        }\n    }\n\n    for (int i = 0; i <= n; ++i)\n        for (int t = 0; t < 17; ++t)\n            dp[i][t] = (dp[i][t] % p + p) % p;\n\n    ll total = 0;\n    for (int t = 1; t <= min(16, k); ++t) {\n        ll cur = fact[n] * dp[n][t] % p;\n        cur = cur * fact[k] % p;\n        cur = cur * inv_fact[k - t] % p;\n        total = (total + cur) % p;\n    }\n\n    ll all = mod_pow(k, n, p);\n    ll res = (all - total + p) % p;\n    cout << res << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        \n        int n = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int p = Integer.parseInt(st.nextToken());\n        \n        if ((n & 1) == 1) {\n            pw.println(modPow(k, n, p));\n            pw.close();\n            return;\n        }\n        \n        long[] fact = new long[n + 1];\n        long[] invFact = new long[n + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = fact[i - 1] * i % p;\n        }\n        invFact[n] = modPow(fact[n], p - 2, p);\n        for (int i = n; i > 0; --i) {\n            invFact[i - 1] = invFact[i] * i % p;\n        }\n        \n        long[][] dp = new long[1 << 18][17];\n        dp[0][0] = 1;\n        \n        for (int m = 1; m <= n; ++m) {\n            if ((m & n) != m) continue;\n            \n            List<Integer> ones = new ArrayList<>();\n            for (int b = 0; b < 18; ++b) {\n                if ((m & (1 << b)) != 0) ones.add(b);\n            }\n            \n            if (ones.isEmpty()) continue;\n            \n            int ssz = ones.size();\n            for (int mask = 1; mask < (1 << ssz); ++mask) {\n                int l = 0;\n                for (int b = 0; b < ssz; ++b) {\n                    if ((mask & (1 << b)) != 0) l ^= (1 << ones.get(b));\n                }\n                \n                long w = invFact[l];\n                for (int t = 1; t <= 16; ++t) {\n                    dp[m][t] = (dp[m][t] + w * dp[m ^ l][t - 1]) % p;\n                }\n            }\n        }\n        \n        for (int i = 0; i <= n; ++i) {\n            for (int t = 0; t < 17; ++t) {\n                dp[i][t] = (dp[i][t] % p + p) % p;\n            }\n        }\n        \n        long total = 0;\n        int minVal = Math.min(16, k);\n        for (int t = 1; t <= minVal; ++t) {\n            long cur = fact[n] * dp[n][t] % p;\n            cur = cur * fact[k] % p;\n            cur = cur * invFact[k - t] % p;\n            total = (total + cur) % p;\n        }\n        \n        long all = modPow(k, n, p);\n        long res = (all - total + p) % p;\n        pw.println(res);\n        pw.close();\n    }\n    \n    public static long modPow(long base, int exp, int mod) {\n        long res = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>",