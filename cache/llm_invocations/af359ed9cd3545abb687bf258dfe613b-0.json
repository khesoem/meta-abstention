        }\n    }\n    \n    std::cout << bestNum << \"/\" << bestDen << std::endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef main():\n    x, y, n = map(int, input().split())\n    \n    minError = 1e12\n    bestNum = 0\n    bestDen = 1\n    \n    for b in range(1, n + 1):\n        a = x * b // y\n        \n        # Check exact matches\n        if a > 0 and x * b == (a - 1) * y:\n            print(f\"{a - 1}/{b}\")\n            return\n        if x * b == a * y:\n            print(f\"{a}/{b}\")\n            return\n        if x * b == (a + 1) * y:\n            print(f\"{a + 1}/{b}\")\n            return\n        \n        # Update best approximation with all three candidates\n        for candidate in [a - 1, a, a + 1]:\n            if candidate <= 0:\n                continue\n            error = abs((x * b - candidate * y) / (y * b))\n            if error < minError:\n                minError = error\n                bestNum = candidate\n                bestDen = b\n    \n    print(f\"{bestNum}/{bestDen}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.128461584215984e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -0.0002787916746456176, -0.428870290517807, -0.02630462683737278, -0.0019731116481125355, -8.22540732769994e-06, -1.1801649634435307e-05, -1.1920928244535389e-07, -0.0003914067056030035, -7.152531907195225e-06, 0.0, 0.0, -1.1920928244535389e-07, -3.099436753473128e-06, -2.169585604860913e-05, -5.674201020156033e-05, -7.152555099310121e-07, -2.4676019165781327e-05, -4.768370445162873e-07, -1.6569954823353328e-05, -4.6491513785440475e-06, 0.0, -1.5497195136049413e-06, -3.6954811548639555e-06, -0.026306716725230217, 0.0, -0.014165212400257587, 0.0, -0.00010918975021922961, -2.3841855067985307e-07, -2.3841855067985307e-07,