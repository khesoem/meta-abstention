{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n<your_rewritten_code_5>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 10005;\nconst long long INF = 1LL << 50;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nvector<Edge> adj[MAX_NODES];\nint dist[MAX_NODES], prevv[MAX_NODES], preve[MAX_NODES];\nbool inq[MAX_NODES];\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    adj[u].emplace_back(v, cap, cost, (int)adj[v].size());\n    adj[v].emplace_back(u, 0, -cost, (int)adj[u].size() - 1);\n}\n\nlong long minCostFlow(int src, int dst) {\n    long long totalCost = 0;\n    while (true) {\n        fill(dist, dist + MAX_NODES, INF);\n        fill(inq, inq + MAX_NODES, false);\n        queue<int> q;\n        dist[src] = 0;\n        q.push(src);\n        inq[src] = true;\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            for (int i = 0; i < adj[u].size(); ++i) {\n                auto& e = adj[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[dst] == INF) break;\n\n        long long flow = INF;\n        for (int v = dst; v != src; v = prevv[v]) {\n            flow = min(flow, (long long)adj[prevv[v]][preve[v]].cap);\n        }\n\n        for (int v = dst; v != src; v = prevv[v]) {\n            auto& e = adj[prevv[v]][preve[v]];\n            e.cap -= flow;\n            adj[v][e.rev].cap += flow;\n            totalCost += flow * e.cost;\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> positions(k + 1);\n    for (int i = 1; i <= k; ++i) cin >> positions[i];\n\n    int source = 0;\n    int sink = n * 100 + 1;\n\n    for (int floor = 1; floor <= 100; ++floor) {\n        addEdge(floor, sink, INT_MAX, 0);\n    }\n\n    for (int i = 1; i <= k; ++i) {\n        addEdge(source, (positions[i] - 1) * 100 + 1, 1, 0);\n    }\n\n    for (int floor = 2; floor <= n; ++floor) {\n        for (int level = 1; level < 100; ++level) {\n            addEdge((floor - 1) * 100 + level, (floor - 1) * 100 + level + 1, INT_MAX, c);\n        }\n    }\n\n    int u, v;\n    for (int _ = 0; _ < m; ++_) {\n        cin >> u >> v;\n        for (int level = 1; level < 100; ++level) {\n            for (int group = 1; group <= k; ++group) {\n                int edgeCost = c + d * (group * group - (group - 1) * (group - 1));\n                addEdge((u - 1) * 100 + level, (v - 1) * 100 + level + 1, 1, edgeCost);\n                addEdge((v - 1) * 100 + level, (u - 1) * 100 + level + 1, 1, edgeCost);\n            }\n        }\n    }\n\n    cout << minCostFlow(source, sink) << '\\n';\n    return 0;\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_NODES = 10005;\n    static final long INF = 1L << 50;\n\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int t, int c, int co, int r) {\n            to = t;\n            cap = c;\n            cost = co;\n            rev = r;\n        }\n    }\n\n    static List<Edge>[] adj = new List[MAX_NODES];\n    static int[] dist = new int[MAX_NODES];\n    static int[] prevv = new int[MAX_NODES];\n    static int[] preve = new int[MAX_NODES];\n    static boolean[] inq = new boolean[MAX_NODES];\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        adj[u].add(new Edge(v, cap, cost, adj[v].size()));\n        adj[v].add(new Edge(u, 0, -cost, adj[u].size() - 1));\n    }\n\n    static long minCostFlow(int src, int dst) {\n        long totalCost = 0;\n        while (true) {\n            Arrays.fill(dist, (int) INF);\n            Arrays.fill(inq, false);\n            Queue<Integer> q = new LinkedList<>();\n            dist[src] = 0;\n            q.offer(src);\n            inq[src] = true;\n\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n                for (int i = 0; i < adj[u].size(); ++i) {\n                    Edge e = adj[u].get(i);\n                    if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n\n            if (dist[dst] == (int) INF) break;\n\n            long flow = INF;\n            for (int v = dst; v != src; v = prevv[v]) {\n                flow = Math.min(flow, adj[prevv[v]].get(preve[v]).cap);\n            }\n\n            for (int v = dst; v != src; v = prevv[v]) {\n                Edge e = adj[prevv[v]].get(preve[v]);\n                e.cap -= (int) flow;\n                adj[v].get(e.rev).cap += (int) flow;\n                totalCost += flow * e.cost;\n            }\n        }\n        return totalCost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int[] positions = new int[k + 1];\n        for (int i = 1; i <= k; ++i) {\n            positions[i] = sc.nextInt();\n        }\n\n        int source = 0;\n        int sink = n * 100 + 1;\n\n        for (int i = 0; i < MAX_NODES; ++i) {\n            adj[i] = new ArrayList<>();\n        }\n\n        for (int floor = 1; floor <= 100; ++floor) {\n            addEdge(floor, sink, Integer.MAX_VALUE, 0);\n        }\n\n        for (int i = 1; i <= k; ++i) {\n            addEdge(source, (positions[i] - 1) * 100 + 1, 1, 0);\n        }\n\n        for (int floor = 2; floor <= n; ++floor) {\n            for (int level = 1; level < 100; ++level) {\n                addEdge((floor - 1) * 100 + level, (floor - 1) * 100 + level + 1, Integer.MAX_VALUE, c);\n            }\n        }\n\n        for (int _ = 0; _ < m; ++_) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int level = 1; level < 100; ++level) {\n                for (int group = 1; group <= k; ++group) {\n                    int edgeCost = c + d * (group * group - (group - 1) * (group - 1));\n                    addEdge((u - 1) * 100 + level, (v - 1) * 100 + level + 1, 1, edgeCost);\n                    addEdge((v - 1) * 100 + level, (u - 1) * 100 + level + 1, 1, edgeCost);\n                }\n            }\n        }\n\n        System.out.println(minCostFlow(source, sink));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013433984713628888, -2.7418097943154862e-06, -9.536738616588991e-07, -0.0006656814948655665, -3.111314072157256e-05, -0.03365015238523483, -0.14281286299228668, -1.597391747054644e-05, -3.576278118089249e-07, -0.0002019201492657885, -0.006716414820402861, -3.123234637314454e-05, -0.010096784681081772, -0.002691101748496294, -1.4185804502631072e-05, -2.3841830625315197e-06, -5.483612312673358e-06, 0.0, 0.0, -3.576278118089249e-07, -8.344646857949556e-07, -1.1920928244535389e-07, -5.4834770708112046e-05, -5.960462772236497e-07, -6.9141146923357155e-06, -2.145764938177308e-06, -1.4305104514278355e-06, -2.658331868587993e-05, -4.2676016164477915e-05, -6.9141146923357155e-06, -2.3841855067985307e-07, -1.07287787614041e-05, 0.0, -0.00017951308109331876, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, 0.0, -0.17974524199962616, -2.3841855067985307e-07, -3.3378546504536644e-06, -1.2516897186287679e-05, -1.7762025890988298e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, -3.576278118089249e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -8.702239938429557e-06, 0.0, -1.6689286894688848e-06, 0.0, -2.264974000354414e-06, -0.033646002411842346, -0.00017963226127903908, -1.6569954823353328e-05, -1.1920922133867862e-06, -0.008615348488092422, 0.0, -3.576278118089249e-07, -0.0006986799417063594, -8.821448318485636e-06, -1.6689286894688848e-06, -6.5205356804654e-05, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.0636318115284666e-05, -4.291525328881107e-06, -0.0004888770054094493, -1.4305104514278355e-06, 0.0, -0.0007101159426383674, -4.2437604861333966e-05, -9.536738616588991e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -5.960462772236497e-07, -1.1920922133867862e-06, -1.311301275563892e-06, 0.0, -1.1920922133867862e-06