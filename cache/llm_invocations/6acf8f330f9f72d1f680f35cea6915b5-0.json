{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3.11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3.11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int N = 10000010, INF = 0x3f3f3f3f;\nint n, m, c, d, k, s = 0, t, ans = 0;\nint cnt = 1, hed[N], to[N], nxt[N], val[N], w[N];\nint dis[N], incf[N], pre[N]; bool inq[N];\n\nvoid add(int x, int y, int z, int v) {\n\tto[++cnt] = y, nxt[cnt] = hed[x], hed[x] = cnt, val[cnt] = z, w[cnt] = v;\n\tto[++cnt] = x, nxt[cnt] = hed[y], hed[y] = cnt, val[cnt] = 0, w[cnt] = -v;\n}\nbool spfa() {\n\tmemset(incf, 0, sizeof(incf)), memset(dis, INF, sizeof(dis));\n\tmemset(inq, 0, sizeof(inq)); queue<int> q;\n\tq.push(s), incf[s] = INF, inq[s] = 1, dis[s] = 0;\n\tfor(; !q.empty();) {\n\t\tint u = q.front(); q.pop(); inq[u] = 0;\n\t\tfor(int i = hed[u]; i; i = nxt[i]) {\n\t\t\tif(!val[i] || dis[to[i]] <= dis[u] + w[i]) continue;\n\t\t\tdis[to[i]] = dis[u] + w[i];\n\t\t\tincf[to[i]] = min(incf[u], val[i]);\n\t\t\tpre[to[i]] = i; if(!inq[to[i]]) inq[to[i]] = 1, q.push(to[i]);\n\t\t}\n\t}\n\treturn dis[t] != INF;\n}\nvoid update() {\n\tint tmp = t;\n\tfor(; tmp != s;) {\n\t\tint i = pre[tmp];\n\t\tval[i] -= incf[t], val[i ^ 1] += incf[t], tmp = to[i ^ 1];\n\t}\n\tans += incf[t] * dis[t];\n}\nint main() {\n\tscanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d), t = (n + k - 1) * n + 1;\n\tfor(int i = 1, x; i <= k; i++) scanf(\"%d\", &x), add(s, x, 1, 0);\n\tfor(int i = 1, x, y; i <= m; i++) {\n\t\tscanf(\"%d%d\", &x, &y);\n\t\tfor(int j = 1; j <= n + k; j++)\n\t\t\tfor(int h = 1; h <= k; h++) {\n\t\t\t\tadd(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n\t\t\t\tadd(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c);\n\t\t\t}\n\t}\n\tfor(int i = 1; i < n + k; i++) {\n\t\tfor(int j = 2; j <= n; j++)\n\t\t\tadd(j + (i - 1) * n, j + i * n, INF, c);\n\t\tadd(1 + (i - 1) * n, 1 + i * n, INF, 0);\n\t}\n\tfor(; spfa();) update();\n\tprintf(\"%d\\n\", ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nN = 10000010\nINF = 0x3f3f3f3f\n\ndef add_edge(x, y, z, v):\n    global cnt, to, nxt, hed, val, w\n    cnt += 1\n    to[cnt] = y\n    nxt[cnt] = hed[x]\n    hed[x] = cnt\n    val[cnt] = z\n    w[cnt] = v\n    cnt += 1\n    to[cnt] = x\n    nxt[cnt] = hed[y]\n    hed[y] = cnt\n    val[cnt] = 0\n    w[cnt] = -v\n\ndef spfa():\n    global dis, incf, inq, pre, s, t, hed, to, nxt, val, w\n    for i in range(N):\n        incf[i] = 0\n        dis[i] = INF\n        inq[i] = False\n    queue = deque()\n    queue.append(s)\n    incf[s] = INF\n    inq[s] = True\n    dis[s] = 0\n    while queue:\n        u = queue.popleft()\n        inq[u] = False\n        i = hed[u]\n        while i:\n            if val[i] and dis[to[i]] > dis[u] + w[i]:\n                dis[to[i]] = dis[u] + w[i]\n                incf[to[i]] = min(incf[u], val[i])\n                pre[to[i]] = i\n                if not inq[to[i]]:\n                    inq[to[i]] = True\n                    queue.append(to[i])\n            i = nxt[i]\n    return dis[t] != INF\n\ndef update():\n    global ans, t, pre, to, val, w, s\n    tmp = t\n    while tmp != s:\n        i = pre[tmp]\n        val[i] -= incf[t]\n        val[i ^ 1] += incf[t]\n        tmp = to[i ^ 1]\n    ans += incf[t] * dis[t]\n\ninput_data = list(map(int, sys.stdin.read().split()))\nn, m, k, c, d = input_data[0:5]\npos = 5\n\ns = 0\nt = (n + k - 1) * n + 1\n\nmax_size = (n + k) * n + 2\nhed = [0] * max_size\nto = [0] * (2 * m * (n + k) + 2 * max_size)\nnxt = [0] * (2 * m * (n + k) + 2 * max_size)\nval = [0] * (2 * m * (n + k) + 2 * max_size)\nw = [0] * (2 * m * (n + k) + 2 * max_size)\nincf = [0] * max_size\ndis = [0] * max_size\npre = [0] * max_size\ninq = [False] * max_size\n\ncnt = 0\n\n# Add initial source edges\nfor i in range(k):\n    x = input_data[pos]\n    pos += 1\n    add_edge(s, x, 1, 0)\n\n# Add edges for the m connections\nfor _ in range(m):\n    x, y = input_data[pos], input_data[pos+1]\n    pos += 2\n    for j in range(1, n + k + 1):\n        for h in range(1, k + 1):\n            add_edge(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c)\n            add_edge(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c)\n\n# Add edges within layers\nfor i in range(1, n + k):\n    for j in range(2, n + 1):\n        add_edge(j + (i - 1) * n, j + i * n, INF, c)\n    add_edge(1 + (i - 1) * n, 1 + i * n, INF, 0)\n\nans = 0\nwhile spfa():\n    update()\n\nprint(ans)\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00040910433745011687, -0.0005539863486774266, -3.128163257315464e-07, -1.5690089639974758e-05, -0.042334720492362976, -4.127333340875339e-06, -2.975612187583465e-05, -0.012075847946107388, -0.0002907718007918447, 0.0, -1.0683535037969705e-05, -0.009846041910350323, -0.2713016867637634, -5.526570384972729e-05, -3.7697225252486533e-06, -0.0010329303331673145, -0.0004879915213678032, -4.320199877838604e-07, -3.5954712075181305e-05, -3.7697225252486533e-06, -2.2200749754119897e-06, -0.009816180914640427, -0.0004894073354080319, 0.0, 0.0, -9.253090865968261e-06, 0.0, 0.0, -1.936