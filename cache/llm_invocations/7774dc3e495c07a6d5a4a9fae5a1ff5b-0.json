{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\n#include<math.h>\n#define rep(i,k,n) for(int i=k;i<n;i++)\n#define ll long long\n#define MOD1 998244353ll\n#define MOD2 1000000009ll\n#define MOD3 1000000007ll\n#define MIN(a,b) (a>b?b:a)\nusing namespace std;\n#define mp make_pair\n#define pb push_back\n#define piii pair<pair<ll,ll>,ll>\n#define pii pair<ll,ll>\n#define fi first\n#define se second\n#define debug(...) fprintf(stderr, __VA_ARGS__), fflush(stderr)\n#define time__(d) \\\n    for ( \\\n        auto blockTime = make_pair(chrono::high_resolution_clock::now(), true); \\\n        blockTime.second; \\\n        debug(\"%s: %lld ms\\n\", d, chrono::duration_cast<chrono::milliseconds>(chrono::high_resolution_clock::now() - blockTime.first).count()), blockTime.second = false \\\n    )\n#define MAXN 100005\nconst ll INF = 1000*1000*1000;\n\nstruct edge {\n    ll to, cap, cost, flow;\n    size_t rev;\n};\n\nvoid add_edge(vector<vector<edge>>& g, ll a, ll b, ll u, ll c) {\n    edge e1 = {b, u, c, 0, g[b].size()};\n    edge e2 = {a, 0, -c, 0, g[a].size()};\n    g[a].push_back(e1);\n    g[b].push_back(e2);\n}\n\nnamespace k{\n    ll n,m,k,c,d;\n}\nvector <ll> vr[55];\nll lr[50];\nint main()\n{\n    ll n=50*99+1, m, k=INF;\n    vector<vector<edge>> g(n);\n    ll s, t;\n\n    cin>>k::n>>k::m>>k::k>>k::c>>k::d;\n\n    ll tim=99;\n    for(int i=1;i<=k::k;++i)\n    {\n        cin>>lr[i];\n        add_edge(g,0,lr[i],1,0);\n    }\n    for(int j=0;j<tim-1;++j)\n    {\n        for(int i=2;i<=k::n;++i)\n            add_edge(g,j*50+i,(j+1)*50+i,50,k::c);\n    }\n    for(int j=1;j<tim;++j)\n    {\n        add_edge(g,j*50+1,1,50,0);\n    }\n    for(int i=0;i<k::m;++i)\n    {\n        ll x,y;\n        cin>>x>>y;\n        vr[x].push_back(y);\n        vr[y].push_back(x);\n        \n        for(int j=0;j<tim-1;++j)\n        {\n            for(int l=0;l<50;++l)\n            {\n                add_edge(g,j*50+x,(j+1)*50+y,1,(k::c)+(k::d)*((l+1)*(l+1)-(l*l)));\n                add_edge(g,j*50+y,(j+1)*50+x,1,(k::c)+(k::d)*((l+1)*(l+1)-(l*l)));\n            }\n        }\n    }\n    s=0,t=1;\n\n    ll flow = 0, cost = 0;\n    while (flow < k) {\n        vector<ll> dist(n, INF);\n        vector<ll> prevv(n, -1);\n        vector<size_t> preve(n);\n        vector<ll> q(n);\n        vector<ll> inq(n, 0);\n        ll qh=0, qt=0;\n        q[qt++] = s;\n        dist[s] = 0;\n        inq[s] = 1;\n        while (qh != qt) {\n            ll v = q[qh++];\n            inq[v] = 0;\n            if (qh == n) qh = 0;\n            for (size_t i=0; i<g[v].size(); ++i) {\n                edge &e = g[v][i];\n                if (e.flow < e.cap && dist[v] + e.cost < dist[e.to]) {\n                    dist[e.to] = dist[v] + e.cost;\n                    prevv[e.to] = v;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        q[qt++] = e.to;\n                        if (qt == n) qt = 0;\n                        inq[e.to] = 1;\n                    }\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        ll add = k - flow;\n        for (ll v=t; v!=s; v=prevv[v]) {\n            ll pv = prevv[v]; size_t pe = preve[v];\n            add = min(add, g[pv][pe].cap - g[pv][pe].flow);\n        }\n        for (ll v=t; v!=s; v=prevv[v]) {\n            ll pv = prevv[v]; size_t pe = preve[v];\n            size_t re = g[pv][pe].rev;\n            g[pv][pe].flow += add;\n            g[v][re].flow -= add;\n            cost += g[pv][pe].cost * add;\n        }\n        flow += add;\n    }\n    cout<<cost<<\"\\n\";\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'flow', 'rev')\n    def __init__(self, to, cap, cost, flow, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.flow = flow\n        self.rev = rev\n\ndef add_edge(g, a, b, u, c):\n    g[a].append(Edge(b, u, c, 0, len(g[b])))\n    g[b].append(Edge(a, 0, -c, 0, len(g[a]) - 1))\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    N = next(it)          # number of nodes in original graph (k::n)\n    M = next(it)          # number of edges (k::m)\n    K = next(it)          # number of people (k::k)\n    C = next(it)          # cost per time (k::c)\n    D = next(it)          # congestion coefficient (k::d)\n\n    # initial positions\n    lr = [0] * (K + 1)\n    for i in range(1, K + 1):\n        lr[i] = next(it)\n\n    # graph size: 50 time layers * 50 nodes + 1 (source/sink)\n    tim = 99\n    graph_size = 50 * tim + 1\n    g = [[] for _ in range(graph_size)]\n\n    # source to initial positions\n    for i in range(1, K + 1):\n        add_edge(g, 0, lr[i], 1, 0)\n\n    # staying edges (except node 1 which is sink)\n    for j in range(tim - 1):\n        for i in range(2, N + 1):\n            add_edge(g, j * 50 + i, (j + 1) * 50 + i, 50, C)\n\n    # edges to sink from node 1 at each time step (except time 0)\n    for j in range(1, tim):\n        add_edge(g, j * 50 + 1, 1, 50, 0)\n\n    # read graph edges and add time-expanded edges\n    for _ in range(M):\n        x = next(it)\n        y = next(it)\n        for j in range(tim - 1):\n            for l in range(50):\n                cost = C + D * ((l + 1) * (l + 1) - l * l)\n                add_edge(g, j * 50 + x, (j + 1) * 50 + y, 1, cost)\n                add_edge(g, j * 50 + y, (j + 1) * 50 + x, 1, cost)\n\n    s = 0\n    t = 1\n    INF = 10**18\n    flow = 0\n    cost = 0\n    maxf = INF  # target flow (effectively unlimited, but limited by source capacities)\n\n    while flow < maxf:\n        dist = [INF] * graph_size\n        prevv = [-1] * graph_size\n        preve = [0] * graph_size\n        inq = [False] * graph_size\n        q = deque()\n        dist[s] = 0\n        q.append(s)\n        inq[s] = True\n\n        while q:\n            v = q.popleft()\n            inq[v] = False\n            for i, e in enumerate(g[v]):\n                if e.flow < e.cap and dist[v] + e.cost < dist[e.to]:\n                    dist[e.to] = dist[v] + e.cost\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        q.append(e.to)\n                        inq[e.to] = True\n\n        if dist[t] == INF:\n            break\n\n        add = maxf - flow\n        v = t\n        while v != s:\n            pv = prevv[v]\n            pe = preve[v]\n            add = min(add, g[pv][pe].cap - g[pv][pe].flow)\n            v = pv\n\n        v = t\n        while v != s:\n            pv = prevv[v]\n            pe = preve[v]\n            re = g[pv][pe].rev\n            g[pv][pe].flow += add\n            g[v][re].flow -= add\n            cost += g[pv][pe].cost * add\n            v = pv\n\n        flow += add\n\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": 