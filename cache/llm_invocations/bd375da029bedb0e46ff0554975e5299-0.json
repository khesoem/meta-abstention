           res += resmul;\n            i += imul;\n        }\n        return new Step(res, i);\n    }\n\n    public static void main(String[] args) {\n        java.util.Scanner sc = new java.util.Scanner(System.in);\n        long n = sc.nextLong();\n\n        PriorityQueue<Step> pq = new PriorityQueue<>();\n        pq.add(new Step(n, 0));\n\n        while (true) {\n            Step current = pq.peek();\n            if (current.val == 0) {\n                System.out.println(current.cost);\n                break;\n            }\n            pq.poll();\n\n            if (wasVisited(current.val))\n                continue;\n            visited.add(current.val);\n\n            for (Step next : new Step[]{ lower(current.val), upper(current.val), uupper(current.val) }) {\n                next.cost += current.cost;\n                next.val = Math.abs(current.val - next.val);\n                pq.add(next);\n            }\n        }\n\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0034716592635959387, -0.0005903251585550606, -3.4121114822482923e-06, -0.00011808603449026123, -1.8624639324116288e-06, -1.9361264946837764e-07, -0.0002625278721097857, -1.0354454517364502, -3.292907877039397e-06, -4.008129963040119e-06, 0.0, -3.128163257315464e-07, -1.8624639324116288e-06, -0.0077200825326144695, -4.320199877838604e-07, -0.03805159032344818, -4.320199877838604e-07, -7.896309739408025e-07, -2.7610454708337784e-05, -0.0017764460062608123, -0.1429198831319809, -0.07889793813228607, -3.128163257315464e-07, -0.00026968008023686707, -0.3868938982486725, -0.06397464871406555, -0.0013213115744292736, -0.00034142236108891666, -1.0280383548888494e-06, -0.007613613270223141, -1.0683535037969705e-05, -1.9361264946837764e-07, -2.2200749754119897e-06, -6.134509021649137e-05, -6.704273118884885e-07, -1.9361264946837764e-07, -0.0024962294846773148, -6.623244553338736e-05, -0.008615042082965374, 0.0, -9.088346359931165e-07, -4.3201998