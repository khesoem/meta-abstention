 MAX_LG = 18\n    MAX_N = (1 << MAX_LG) + 10\n    \n    fact = [0] * MAX_N\n    invFact = [0] * MAX_N\n    \n    fact[0] = 1\n    for i in range(1, MAX_N):\n        fact[i] = (i * fact[i - 1]) % MOD\n    \n    invFact[MAX_N - 1] = mod_pow(fact[MAX_N - 1], MOD - 2, MOD)\n    for i in range(MAX_N - 2, -1, -1):\n        invFact[i] = ((i + 1) * invFact[i + 1]) % MOD\n    \n    dp = [[0] * (MAX_LG + 3) for _ in range(nMask + 1)]\n    \n    for mask in range(nMask + 1):\n        real_val = 0\n        for j in range(N):\n            if mask & (1 << j):\n                real_val += 1 << bit_positions[j]\n        popcount = bin(mask).count('1')\n        dp[mask][popcount] = invFact[real_val]\n    \n    zeta_transform(dp, N, nMask, MOD)\n    \n    for mask in range(nMask + 1):\n        k = K\n        buf2 = [0] * (MAX_LG + 3)\n        buf2[0] = 1\n        \n        while k:\n            if k & 1:\n                mul_poly(buf2, buf2, dp[mask], MOD)\n            mul_poly(dp[mask], dp[mask], dp[mask], MOD)\n            k >>= 1\n        \n        for i in range(len(buf2)):\n            dp[mask][i] = buf2[i]\n    \n    mobius_transform(dp, N, nMask, MOD)\n    \n    contrib = (dp[nMask][N] * fact[origN]) % MOD\n    ans = (total - contrib) % MOD\n    if ans < 0:\n        ans += MOD\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018320789968129247, -9.536738616588991e-07, -4.768370445162873e-07, -0.046320345252752304, -0.0003106111544184387, -0.22549311816692352, -0.07553573697805405, -0.32149264216423035, -0.00044967554276809096, -0.13863003253936768, -0.54835045337677, -0.5793933868408203, -2.264974000354414e-06, -4.768370445162873e-07, -0.00010609064338495955, -3.3378546504536644e-06, -0.0003197873884346336, -0.00010847456724150106, -7.152555099310121e-07, -0.00016068121476564556, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -0.5759418606758118, -0.6326709389686584, -9.536738616588