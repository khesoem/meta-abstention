s[s[i]]++;\n        }\n      }\n\n      char mostCommonChar = 'a';\n      for (int c = 0; c < 128; c++) {\n        if (charOccurrences[c] > charOccurrences[mostCommonChar]) {\n          mostCommonChar = (char) c;\n        }\n      }\n\n      int ans = totalBeauty;\n      for (int idx : equalPairs) {\n        ans -= Math.min(beauty[idx], beauty[n - 1 - idx]);\n      }\n\n      if (charOccurrences[mostCommonChar] > equalPairs.size() / 2) {\n        List<Integer> penalties = new ArrayList<>();\n        for (int i = 0; i < half; ++i) {\n          if (s[i] != s[n - 1 - i] && s[i] != mostCommonChar && s[n - 1 - i] != mostCommonChar) {\n            penalties.add(Math.min(beauty[i], beauty[n - 1 - i]));\n          }\n        }\n        Collections.sort(penalties);\n        int rem = 2 * charOccurrences[mostCommonChar] - equalPairs.size();\n        for (int i = 0; i < rem; ++i) {\n          ans -= penalties.get(i);\n        }\n      }\n\n      out.println(ans);\n    }\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <algorithm>\n#include <sstream>\n#include <climits>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    int n;\n    ss >> n;\n\n    getline(cin, line);\n    string s = line;\n\n    getline(cin, line);\n    stringstream ss2(line);\n    vector<int> beauty(n);\n    int totalBeauty = 0;\n    for (int i = 0; i < n; ++i) {\n        ss2 >> beauty[i];\n        totalBeauty += beauty[i];\n    }\n\n    int half = n / 2;\n    vector<int> charOccurrences(128, 0);\n    vector<int> equalPairs;\n    for (int i = 0; i < half; ++i) {\n        if (s[i] == s[n - 1 - i]) {\n            equalPairs.push_back(i);\n            charOccurrences[s[i]]++;\n        }\n    }\n\n   