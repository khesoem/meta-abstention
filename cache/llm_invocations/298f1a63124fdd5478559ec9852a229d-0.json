wen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nclass FastScanner:\n    def __init__(self):\n        self.in_stream = sys.stdin.buffer\n        self.buffer = bytearray()\n        self.ptr = 0\n        self.buflen = 0\n    \n    def _read_buffer(self):\n        if self.ptr < self.buflen:\n            return True\n        self.ptr = 0\n        data = self.in_stream.read(1024)\n        if data:\n            self.buffer = data\n            self.buflen = len(data)\n            return True\n        return False\n    \n    def _read_byte(self):\n        if self._read_buffer():\n            self.ptr += 1\n            return self.buffer[self.ptr - 1]\n        return -1\n    \n    def _is_printable_char(self, c):\n        return c > 32 or c < 0\n    \n    def _is_number(self, c):\n        return ord('0') <= c <= ord('9')\n    \n    def _skip_whitespace(self):\n        while self._read_buffer() and not self._is_printable_char(self.buffer[self.ptr]):\n            self.ptr += 1\n    \n    def has_next(self):\n        self._skip_whitespace()\n        return self._read_buffer()\n    \n    def next(self):\n        if not self.has_next():\n            raise StopIteration()\n        sb = []\n        b = self.buffer[self.ptr - 1]\n        while self._is_printable_char(b):\n            sb.append(chr(b))\n            b = self._read_byte()\n        return ''.join(sb)\n    \n    def next_long(self):\n        if not self.has_next():\n            raise StopIteration()\n        n = 0\n        sign = 1\n        b = self.buffer[self.ptr - 1]\n        if b == ord('-'):\n            sign = -1\n            b = self._read_byte()\n        while self._is_number(b):\n            n = n * 10 + (b - ord('0'))\n            b = self._read_byte()\n        return n * sign\n    \n    def next_int(self):\n        return int(self.next_long())\n    \n    def next_double(self):\n        return float(self.next())\n\nclass IntMath:\n    @staticmethod\n    def gcd(a, b):\n        while a != 0:\n            if (b % a) != 0:\n                a, b = b % a, a\n            else:\n                return a\n        return b\n    \n    @staticmethod\n    def gcd_array(array):\n        ret = array[0]\n        for i in range(1, len(array)):\n            ret = IntMath.gcd(ret, array[i])\n        return ret\n    \n    @staticmethod\n    def lcm(a, b):\n        return a // IntMath.gcd(a, b) * b\n    \n    @staticmethod\n    def pow(a, b):\n        ans = 1\n        mul = a\n        while b > 0:\n            if b & 1:\n                ans *= mul\n            b >>= 1\n            mul *= mul\n        return ans\n    \n    @staticmethod\n    def pow_mod(a, b, mod):\n        if b < 0:\n            b = b % (mod - 1) + mod - 1\n        ans = 1\n        mul = a\n        while b > 0:\n            if b & 1:\n                ans = (ans * mul) % mod\n            b >>= 1\n            mul = (mul * mul) % mod\n        return ans\n    \n    @staticmethod\n    def floor_sqrt(n):\n        return int(math.sqrt(n + 0.1))\n    \n    @staticmethod\n    def ceil_sqrt(n):\n        if n <= 1:\n            return int(n)\n        return int(math.sqrt(n - 0.1)) + 1\n\ndef solve():\n    fs = FastScanner()\n    out = sys.stdout\n    \n    n = fs.next_int()\n    k = fs.next_long()\n    MOD = 998244353\n    \n    fact = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    \n    fact[0] = 1\n    for i in range(n):\n        fact[i + 1] = fact[i] * (i + 1) % MOD\n    \n    inv[n] = IntMath.pow_mod(fact[n], MOD - 2, MOD)\n    for i in range(n, 0, -1):\n        inv[i - 1] = inv[i] * i % MOD\n    \n    def comb(i, j):\n        return fact[i] * inv[j] % MOD * inv[i - j] % MOD\n    \n    if k == 0:\n        out.write(str(fact[n]) + '\\n')\n    elif k > n:\n        out.write('0\\n')\n    else:\n        k2 = int(k)\n        k3 = n - k2\n        ans = 0\n        for i in range(1, k3 + 1):\n            tmp = comb(k3, i) * IntMath.pow_mod(i, n, MOD) % MOD\n            if (k3 - i) & 1