[i][j])) {\n                k = g2[i][j] - '0';\n                if (k > 0) cells[i][j].used = true;\n                cells[i][j].sz = k;\n                for (l = 1; l <= k; ++l)\n                    cells[i][j].nums[l] = cnt++;\n            }\n\n    cnt = 1;\n    for (i = 0; i < N; ++i)\n        for (j = 0; j < N; ++j)\n            if (isdigit(g1[i][j])) {\n                k = g1[i][j] - '0';\n                for (l = 1; l <= k; ++l) {\n                    p.r = i; p.c = j; p.idx = cnt++;\n                    BFS2(p);\n                }\n            }\n\n    printf(\"%d\\n\", bipartite(cnt - 1));\n    return 0;\n}\n\nbool augment(int u) {\n    if (seen[u]) return false;\n    seen[u] = 1;\n    for (int i = 0; i < (int)graph[u].size(); ++i) {\n        int v = graph[u][i];\n        if (L[v] == -1) {\n            L[v] = u;\n            R[u] = i;\n            return true;\n        } else if (augment(L[v])) {\n            L[v] = u;\n            R[u] = i;\n            return true;\n        }\n    }\n    return false;\n}\n\nint bipartite(int m) {\n    memset(L, -1, sizeof(L));\n    memset(R, -1, sizeof(R));\n    bool done;\n    do {\n        done = true;\n        memset(seen, 0, sizeof(seen));\n        for (int i = 1; i <= m; ++i)\n            if (R[i] == -1 && augment(i))\n                done = false;\n    } while (!done);\n    int ans = 0;\n    for (int i = 1; i <= m; ++i)\n        if (R[i] != -1) ++ans;\n    return ans;\n}\n\nvoid BFS2(Point s) {\n    int i, j, k, l;\n    Point p, q;\n    for (i = 0; i <= N; ++i)\n        for (j = 0; j <= N; ++j)\n            D2[i][j] = BIG;\n    i = s.r; j = s.c;\n    D2[i][j] = 0;\n    Q.push(s);\n    while (!Q.empty()) {\n        p = Q.front(); Q.pop();\n        i = p.r; j = p.c;\n        if (D2[i][j] > T) continue;\n        if (g1[i][j] == 'Y') continue;\n        if (cells[i][j].used) {\n            if (D2[i][j] <= T && D2[i][j] <= D1[i][j]) {\n                for (k = 1; k <= cells[i][j].sz; ++k)\n                    graph[s.idx].push_back(cells[i][j].nums[k]);\n            }\n        }\n        if (D2[i][j] >= D1[i][j]) continue;\n        // four directions\n        int dr[] = {-1, 1, 0, 0};\n        int dc[] = {0, 0, -1, 1};\n        for (int d = 0; d < 4; ++d) {\n            int nr = i + dr[d];\n            int nc = j + dc[d];\n            if (nr >= 0 && nr < N && nc >= 0 && nc < N) {\n                if (D2[nr][nc] > D2[i][j] + 1) {\n                    D2[nr][nc] = D2[i][j] + 1;\n                    q.r = nr; q.c = nc;\n                    Q.push(q);\n                }\n            }\n        }\n    }\n}\n\nvoid BFS1(Point s) {\n    int i, j;\n    Point p, q;\n    i = s.r; j = s.c;\n    D1[i][j] = 0;\n    Q.push(s);\n    while (!Q.empty()) {\n        p = Q.front(); Q.pop();\n        i = p.r; j = p.c;\n        if (g1[i][j] == 'Y') continue;\n        int dr[] = {-1, 1, 0, 0};\n        int dc[] = {0, 0, -1, 1};\n        for (int d = 0; d < 4; ++d) {\n            int nr = i + dr[d];\n            int nc = j + dc[d];\n            if (nr >= 0 && nr < N && nc >= 0 && nc < N) {\n                if (D1[nr][nc] > D1[i][j] + 1) {\n                    D1[nr][nc] = D1[i][j] + 1;\n                    q.r = nr; q.c = nc;\n                    Q.push(q);\n                }\n            }\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nBIG = 12345678\n\nclass Point:\n    def __init__(self, r=0, c=0, idx=0):\n        self.r = r\n        self.c = c\n        self.idx = idx\n\nclass Cell:\n    def __init__(self):\n        self.used = False\n        self.sz = 0\n        self.nums = [0]  # 1-indexed, index 0 unused\n\nN = 0\nT = 0\ng1 = []\ng2 = []\nD1 = []\nD2 = []\ncells = []\ngraph = []\nL = []\nR = []\nseen = []\nQ = deque()\n\ndef BFS1(s):\n    global D1, Q\n    i, j = s.r, s.c\n    D1[i][j] = 0\n    Q.append(s)\n    while Q:\n        p = Q.popleft()\n        i, j = p.r, p.c\n        if g1[i][j] == 'Y':\n            continue\n        dr = [-1, 1, 0, 0]\n        dc = [0, 0, -1, 1]\n        for d in range(4):\n            nr = i + dr[d]\n            nc = j + dc[d]\n            if 0 <= nr < N and 0 <= nc < N:\n                if D1[nr][nc] > D1[i][j] + 1:\n                    D1[nr][nc] = D1[i][j] + 1\n                    q = Point(nr, nc)\n                    Q.append(q)\n\ndef BFS2(s):\n    global D2, graph, cells, Q\n    for i in range(N):\n        for j in range(N):\n            D2[i][j] = BIG\n    i, j = s.r, s.c\n    D2[i][j] = 0\n    Q.append(s)\n    while Q:\n        p = Q.popleft()\n        i, j = p.r, p.c\n        if D2[i][j] > T:\n            continue\n        if g1[i][j] == 'Y':\n            continue\n        if cells[i][j].used:\n            if D2[i][j] <= T and D2[i][j] <= D1[i][j]:\n                for k in range(1, cells[i][j].sz + 1):\n                    graph[s.idx].append(cells[i][j].nums[k])\n        if D2[i][j] >= D1[i][j]:\n            continue\n        dr = [-1, 1, 0, 0]\n        dc = [0, 0, -1, 1]\n        for d in range(4):\n            nr = i + dr[d]\n            nc = j + dc[d]\n            if 0 <= nr < N and 0 <= nc < N:\n                if D2[nr][nc] > D2[i][j] + 1:\n                    D2[nr][nc] = D2[i][j] + 1\n                    q = Point(nr, nc)\n                    Q.append(q)\n\ndef augment(u):\n    global seen, L, R, graph\n    if seen[u]:\n        return False\n    seen[u] = 1\n    for i in range(len(graph[u])):\n        v = graph[u][i]\n        if L[v] == -1:\n            L[v] = u\n            R[u] = i\n            return True\n        elif augment(L[v]):\n            L[v] = u\n            R[u] = i\n            return True\n    return False\n\ndef bipartite(m):\n    global L, R, seen\n    L = [-1] * (max_target + 1)\n    R = [-1] * (m + 1)\n    done = False\n    while not done:\n        done = True\n        seen = [0] * (m + 1)\n        for i in range(1, m + 1):\n            if R[i] == -1 and augment(i):\n                done = False\n    ans = 0\n    for i in range(1, m + 1):\n        if R[i] != -1:\n            ans += 1\n    return ans\n\ndef main():\n    global N, T, g1, g2, D1, D2, cells, graph, max_target\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    T = int(next(it))\n    g1 = [next(it) for _ in range(N)]\n    g2 = [next(it) for _ in range(N)]\n\n    D1 = [[BIG] * N for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            if g1[i][j] == 'Z':\n                p = Point(i, j)\n                BFS1(p)\n\n    cells = [[Cell() for _ in range(N)] for _ in range(N)]\n    cnt = 1\n    for i in range(N):\n        for j in range(N):\n            if g2[i][j].isdigit():\n                k = int(g2[i][j])\n                if k > 0:\n                    cells[i][j].used = True\n                cells[i][j].sz = k\n                cells[i][j].nums = [0] * (k + 1)\n                for l in range(1, k + 1):\n                    cells[i][j].nums[l] = cnt\n                    cnt += 1\n    max_target = cnt - 1\n\n    cnt = 1\n    graph = [[] for _ in range(1000)]  # will be resized later\n    for i in range(N):\n        for j in range(N):\n            if g1[i][j].isdigit():\n                k = int(g1[i][j])\n                for l in range(1, k + 1):\n                    p = Point(i, j, cnt)\n                    cnt += 1\n                    BFS2(p)\n    total_sources = cnt - 1\n    # resize graph to total_sources+1\n    graph = graph[:total_sources + 1]\n\n    ans = bipartite(total_sources)\n    print(ans)\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(10000)\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.50339189733495e-06, 0.0, -1.1920928244535389e-07, -4.8040190449682996e-05, -0.008634967729449272, 0.0, -6.794906312279636e-06, -0.0012155532604083419, -3.576278118089249e-07, -2.3841855067985307e-07,