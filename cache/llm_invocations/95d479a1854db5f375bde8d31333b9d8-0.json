() {\n\tfreopen(\".in\", \"r\", stdin);\n\tfreopen(\".out\", \"w\", stdout);\n}\nint $, _;\nconst int MO = 1000000007;\nconst int oo = 0x3f3f3f3f;\nconst int MAXN = 100005;\nconst int MAXM = 1000005;\n\n//EOT\n\nint K, P;\nbool vis[MAXM];\n\ninline int qpow(int x, int n) {\n\tint ans = 1;\n\tfor (; n; n >>= 1) {\n\t\tif (n & 1) ans = 1LL * ans * x % MO;\n\t\tx = 1LL * x * x % MO;\n\t}\n\treturn ans;\n}\n\nint main() {\n\tint P_val = 0, K_val = 0;\n\tread(P_val), read(K_val);\n\tK = K_val, P = P_val;\n\n\tif (K == 0) {\n\t\twrite(qpow(P, P - 1));\n\t\treturn 0;\n\t}\n\n\tif (K == 1) {\n\t\twrite(qpow(P, P));\n\t\treturn 0;\n\t}\n\n\tint p = 1;\n\tint cnt = 0;\n\tstd::fill(vis, vis + P + 1, false);\n\twhile (!vis[p]) {\n\t\tcnt++;\n\t\tvis[p] = true;\n\t\tp = (1LL * K * p) % P;\n\t}\n\n\twrite(qpow(P, P / cnt));\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static int MO = 1000000007;\n    static int oo = 0x3f3f3f3f;\n    static int MAXN = 100005;\n    static int MAXM = 1000005;\n    \n    static boolean[] vis = new boolean[MAXM];\n    \n    static int qpow(int x, int n) {\n        int ans = 1;\n        for (; n > 0; n >>= 1) {\n            if ((n & 1) == 1) {\n                ans = (int)((1L * ans * x) % MO);\n            }\n            x = (int)((1L * x * x) % MO);\n        }\n        return ans;\n    }\n    \n    static int readInt() throws IOException {\n        int f = 1;\n        int x = 0;\n        int c;\n        while ((c = System.in.read()) != -1 && !Character.isDigit(c)) {\n            if (c == '-') f = -f;\n        }\n        for (; c != -1 && Character.isDigit(c); c = System.in.read()) {\n            x = x * 10 + (c - 48);\n        }\n        return x * f;\n    }\n    \n    static void write(int x) {\n        if (x < 0) {\n            System.out.print('-');