\n\ndef addEdge(u, v, cap, cost, adj, edges):\n    adj[u].append(len(edges))\n    edges.append(Edge(u, v, cap, 0, cost))\n    adj[v].append(len(edges))\n    edges.append(Edge(v, u, 0, 0, -cost))\n\ndef minCostMaxFlow(s, t, nodes, adj, edges):\n    potential = [INF] * nodes\n    inQueue = [False] * nodes\n    potential[s] = 0\n    q = [s]\n    inQueue[s] = True\n    while q:\n        u = q.pop(0)\n        inQueue[u] = False\n        for ei in adj[u]:\n            e = edges[ei]\n            if e.rem() > 0 and potential[e.v] > potential[u] + e.cost + 1e-9:\n                potential[e.v] = potential[u] + e.cost\n                if not inQueue[e.v]:\n                    q.append(e.v)\n                    inQueue[e.v] = True\n\n    maxFlow = 0\n    minCost = 0\n    while True:\n        dist = [INF] * nodes\n        pre = [-1] * nodes\n        capacity = [0] * nodes\n        dist[s] = 0\n        pre[s] = 0\n        capacity[s] = INF\n        pq = [(0, s)]\n        while pq:\n            d, u = heapq.heappop(pq)\n            if d != dist[u]:\n                continue\n            for ei in adj[u]:\n                e = edges[ei]\n                reduced = e.cost + potential[u] - potential[e.v]\n                if e.rem() > 0 and dist[e.v] > dist[u] + reduced + 1e-9:\n                    dist[e.v] = dist[u] + reduced\n                    pre[e.v] = ei\n                    capacity[e.v] = min(capacity[u], e.rem())\n                    heapq.heappush(pq, (dist[e.v], e.v))\n        if pre[t] < 0:\n            break\n        for v in range(nodes):\n            if dist[v] < INF:\n                potential[v] += dist[v]\n        maxFlow += capacity[t]\n        minCost += capacity[t] * potential[t]\n        v = t\n        while v != s:\n            e = edges[pre[v]]\n            e.flow += capacity[t]\n            edges[pre[v] ^ 1].flow -= capacity[t]\n            v = e.u\n    return minCost\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        retur