              for (int[][] layer : updated) {\n                    for (int[] row : layer) {\n                        Arrays.fill(row, Integer.MAX_VALUE);\n                    }\n                }\n\n                for (int plus = maxn; plus >= 0; plus--) {\n                    for (int minus = maxn; minus >= 0; minus--) {\n                        for (int carry = 0; carry <= 2 * shift; carry++) {\n                            int currentValue = dp[plus][minus][carry];\n                            if (currentValue == Integer.MAX_VALUE) continue;\n\n                            int effectiveCarry = carry - shift;\n                            int nValue = plus - minus + effectiveCarry;\n                            int dValue = (nValue % 10 + 10) % 10;\n                            int nextCarry = (nValue - dValue) / 10;\n\n                            if (dValue == targetDigit) {\n                                int totalCost = plus + minus + currentValue;\n                                updated[plus][minus][nextCarry + shift] = Math.min(updated[plus][minus][nextCarry + shift], totalCost);\n                            }\n\n                            if (plus + 1 <= maxn) {\n                                updated[plus][minus][carry] = Math.min(updated[plus][minus][carry], dp[plus + 1][minus][carry]);\n                            }\n                            if (minus + 1 <= maxn) {\n                                updated[plus][minus][carry] = Math.min(updated[plus][minus][carry], dp[plus][minus + 1][carry]);\n                            }\n                        }\n                    }\n                }\n\n                dp = updated;\n            }\n\n            int finalAnswer = Integer.MAX_VALUE;\n            for (int i = 0; i <= maxn; i++) {\n                for (int j = 0; j <= maxn; j++) {\n                    finalAnswer = Math.min(finalAnswer, dp[i][j][shift]);\n                }\n            }\n            out.println(finalAnswer);\n        }\n    }\n\