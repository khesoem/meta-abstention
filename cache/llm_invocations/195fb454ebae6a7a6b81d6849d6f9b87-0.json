cond;\n    ll total = 0;\n    for (int i = 0; i < n; ++i) {\n        total += recurse(i, h-1, memo) * recurse(n-1-i, h-1, memo);\n    }\n    memo[key] = total;\n    return total;\n}\n\nll compute(int n, int h, map<pair<int,int>, ll>& memo) {\n    return recurse(n, h, memo);\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    int n, h;\n    ss >> n >> h;\n    map<pair<int,int>, ll> memo;\n    ll total_all = compute(n, n, memo);\n    ll total_less = compute(n, (h > 0 ? h-1 : 0), memo);\n    cout << total_all - total_less << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.3378546504536644e-06, 0.0, 0.0, -0.0007387054502032697, -0.00022206225548870862, -3.576278118089249e-07, -2.3841855067985307e-07, -1.1444026313256472e-05, 0.0, 0.0, -0.07904242724180222, -1.7881377516459906e-06, 0.0, 0.0, -0.019369738176465034, -2.145764938177308e-06, 0.0, 0.0, -1.0490362910786644e-05, 0.0, -0.048610493540763855, -0.00015853578224778175, 0.0, -8.702239938429557e-06, -0.0012450808426365256, -0.008614876307547092, -2.3841855067985307e-07, 0.0, -0.02325674518942833, -9.536738616588991e-07, -5.960462772236497e-07, 0.0, -5.960462772236497e-07, -4.0531076592742465e-06, -6.329813186312094e-05, -1.7881377516459906e-06, 0.0, -2.264974000354414e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.0728830375228426e-06, -5.960462772236497e-07, 0.0, -0.018149960786104202, 0.0, -7.486063259420916e-05, -7.486063259420916e-05, -7.152555099310121e-07, -1.6093124941107817e-05, -4.768370445162873e-07, -3.099436753473128e-06, -0.00012385078298393637, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.0011701886542141438, -0.01105906069278717, 0.0, 0.0, -0.0016563518438488245, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -0.003