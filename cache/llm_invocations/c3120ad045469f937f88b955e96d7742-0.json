                raise RuntimeError()\n            if self.len <= 0:\n                return -1\n        ret = self.buffer[self.ptr]\n        self.ptr += 1\n        return ret\n\n    def nextInt(self):\n        c = self.read()\n        while c <= ord(' ') and c != -1:\n            c = self.read()\n        val = 0\n        while c > ord(' ') and c != -1:\n            val = val * 10 + (c - ord('0'))\n            c = self.read()\n        return val\n\nclass Solver:\n    def __init__(self):\n        self.nCr = [[0] * 100 for _ in range(100)]\n    \n    def comb(self, base, a, b, c, d):\n        base = (base * self.nCr[a][b]) % MOD\n        base = (base * self.nCr[c][d]) % MOD\n        return base\n\n    def solve(self, testNum, in_reader, out):\n        n = in_reader.nextInt()\n        K = in_reader.nextInt()\n        cnt50 = 0\n        cnt100 = 0\n        for _ in range(n):\n            val = in_reader.nextInt()\n            if val == 50:\n                cnt50 += 1\n            else:\n                cnt100 += 1\n\n        # Precompute binomial coefficients\n        for i in range(100):\n            for j in range(i + 1):\n                if j == 0 or j == i:\n                    self.nCr[i][j] = 1\n                else:\n                    self.nCr[i][j] = (self.nCr[i-1][j] + self.nCr[i-1][j-1]) % MOD\n\n        dist = [[[INF] * 2 for _ in range(200)] for _ in range(200)]\n        ways = [[[0] * 2 for _ in range(200)] for _ in range(200)]\n\n        dist[0][0][0] = 0\n        ways[0][0][0] = 1\n\n        queue = deque()\n        queue.append((0, 0, 0, 0))\n\n        while queue:\n            x, y, side, d = queue.popleft()\n            \n            if side == 0:\n                rem50 = cnt50 - x\n                rem100 = cnt100 - y\n                for take50 in range(rem50 + 1):\n                    for take100 in range(rem100 + 1):\n                        if take50 == 0 and take100 == 0:\n                            continue\n                        weight = take50 * 50 + take100 * 100\n                        if weight > K:\n                            break\n                        nx = x + take50\n                        ny = y + take100\n                        next_side = side ^ 1\n                        if dist[nx][ny][next_side] >= d + 1:\n                            if dist[nx][ny][next_side] > d + 1:\n                                dist[nx][ny][next_side] = d + 1\n                                queue.append((nx, ny, next_side, d + 1))\n                            ways[nx][ny][next_side] = (ways[nx][ny][next_side] + self.comb(ways[x][y][side], rem50, take50, rem100, take100)) % MOD\n            else:\n                rem50 = x\n                rem100 = y\n                for take50 in range(rem50 + 1):\n                    for take100 in range(rem100 + 1):\n                        if take50 == 0 and take100 == 0:\n                            continue\n                        weight = take50 * 50 + take100 * 100\n                        if weight > K:\n                            break\n                        nx = x - take50\n                        ny = y - take100\n                        next_side = side ^ 1\n                        if dist[nx][ny][next_side] >= d + 1:\n                            if dist[nx][ny][next_side] > d + 1:\n                                dist[nx][ny][next_side] = d + 1\n                                queue.append((nx, ny, next_side, d + 1))\n                            ways[nx][ny][next_side] = (ways[nx][ny][next_side] + self.comb(ways[x][y][side], rem50, take50, rem100, take100)) % MOD\n\n        if dist[cnt50][cnt100][1] == INF:\n            out.write(\"-1\\n\")\n        else:\n            out.write(f\"{dist[cnt50][cnt100][1]}\\n\")\n        out.write(f\"{ways[cnt50][cnt100][1]}\\n\")\n\ndef main():\n    in_reader = InputReader(sys.stdin)\n    out = sys.stdout\n    solver = Solver()\n    solver.solve(1, in_reader, out)\n    out.close()\n\nif __name__ == \"__main__\":\n    main()