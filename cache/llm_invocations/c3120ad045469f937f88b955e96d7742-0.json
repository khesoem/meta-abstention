mb(ways[x][y][side], rem50, take50, rem100, take100)) % MOD;\n                                } else {\n                                    ways[nx][ny][nextSide] = (ways[nx][ny][nextSide] + comb(ways[x][y][side], rem50, take50, rem100, take100)) % MOD;\n                                }\n                            }\n                        }\n                    }\n                } else {\n                    int rem50 = x;\n                    int rem100 = y;\n                    for (int take50 = 0; take50 <= rem50; take50++) {\n                        for (int take100 = 0; take100 <= rem100; take100++) {\n                            if (take50 == 0 && take100 == 0) continue;\n                            int weight = take50 * 50 + take100 * 100;\n                            if (weight > K) break;\n                            int nx = x - take50;\n                            int ny = y - take100;\n                            int nextSide = side ^ 1;\n                            if (dist[nx][ny][nextSide] >= d + 1) {\n                                if (dist[nx][ny][nextSide] > d + 1) {\n                                    dist[nx][ny][nextSide] = d + 1;\n                                    queue.add(new State(nx, ny, nextSide, d + 1));\n                                    ways[nx][ny][nextSide] = (ways[nx][ny][nextSide] + comb(ways[x][y][side], rem50, take50, rem100, take100)) % MOD;\n                                } else {\n                                    ways[nx][ny][nextSide] = (ways[nx][ny][nextSide] + comb(ways[x][y][side], rem50, take50, rem100, take100)) % MOD;\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n\n            if (dist[cnt50][cnt100][1] == INF) {\n                out.println(-1);\n            } else {\n                out.println(dist[cnt50][cnt100][1]);\n            }\n            out.println(ways[cnt50][cnt100][1]);\n        }\n\n    