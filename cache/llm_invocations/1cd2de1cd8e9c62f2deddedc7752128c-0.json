  if (dist[v] > nd) {\n                pq.erase({dist[v], v});\n                dist[v] = nd;\n                pq.insert({nd, v});\n            }\n        }\n    }\n\n    return used[t];\n}\n\nbool buildLevelGraph(int s, int t) {\n    fill(level, level + nodeCnt, 0);\n    queue<int> q;\n    q.push(s);\n    level[s] = 1;\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n\n        for (const Edge &e : g[u]) {\n            int v = e.v;\n            if (!e.cap || level[v]) continue;\n\n            if (dist[v] == dist[u] + e.cost - pot[v] + pot[u]) {\n                level[v] = level[u] + 1;\n                q.push(v);\n            }\n        }\n    }\n\n    return level[t] != 0;\n}\n\nint dfs(int u, int t, int f) {\n    if (u == t) return f;\n\n    int sent = 0;\n    for (int &i = cur[u]; i < (int)g[u].size(); ++i) {\n        Edge &e = g[u][i];\n        int v = e.v;\n\n        if (!e.cap || level[v] != level[u] + 1) continue;\n        if (dist[v] != dist[u] + e.cost - pot[v] + pot[u]) continue;\n\n        int ret = dfs(v, t, min(f, e.cap));\n        if (ret) {\n            sent += ret;\n            f -= ret;\n            e.cap -= ret;\n            g[v][e.rev].cap += ret;\n            if (!f) break;\n        }\n    }\n\n    return sent;\n}\n\npair<int,int> minCostFlow(int s, int t, int maxFlow) {\n    int flow = 0, cost = 0;\n    fill(pot, pot + nodeCnt, 0);\n\n    while (dijkstra(s, t)) {\n        int phaseFlow = 0;\n\n        while (buildLevelGraph(s, t)) {\n            fill(cur, cur + nodeCnt, 0);\n            int df = dfs(s, t, maxFlow);\n            maxFlow -= df;\n            phaseFlow += df;\n            if (!maxFlow) break;\n        }\n\n        flow += phaseFlow;\n        cost += (dist[t] + pot[t]) * phaseFlow;\n\n        for (int i = 0; i < nodeCnt; ++i)\n            if (dist[i] != INF) pot[i] += dist[i];\n\n        if (!maxFlow) break;\n    }\n\n    return {flow, cost};\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n\n    nodeCnt = 0;\n    int L = max(n, k) * 2;\n\n    addNodes(L * n);\n    int s = addNodes(1);\n    int t = addNodes(1);\n\n    for (int j = 0; j < k; ++j) {\n        int a;\n        scanf(\"%d\", &a);\n        --a;\n        addEdge(s, a, 1, 0);\n    }\n\n    for (int z = 0; z < m; ++z) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        --u;\n        --v;\n\n        for (int i = 0; i + 1 < L; ++i) {\n            int u1 = u + i * n;\n            int v1 = v + (i + 1) * n;\n            int u2 = u + (i + 1) * n;\n            int v2 = v + i * n;\n\n            for (int j = 0; j < k; ++j) {\n                int w = c + d * (2 * j + 1);\n                addEdge(u1, v1, 1, w);\n                addEdge(v2, u2, 1, w);\n            }\n        }\n    }\n\n    for (int i = 0; i + 1 < L; ++i) {\n        for (int j = 0; j < n; ++j) {\n            int u = j + i * n;\n            int v = j + (i + 1) * n;\n            addEdge(u, v, INF, c);\n        }\n    }\n\n    for (int i = 0; i < L; ++i)\n        addEdge(i * n, t, INF, 0);\n\n    printf(\"%d\\n\", minCostFlow(s, t, INF).second);\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\nfrom collections import deque\n\nINF = 10**18\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_nodes(cnt):\n    global node_cnt, g\n    for _ in range(cnt):\n        g.append([])\n        node_cnt += 1\n    return node_cnt - 1\n\ndef add_edge(u, v, cap, cost):\n    g[u].append(Edge(v, len(g[v]), cap, cost))\n    g[v].append(Edge(u, len(g[u]) - 1, 0, -cost))\n\ndef dijkstra(s, t):\n    global dist, used, pot\n    dist = [INF] * node_cnt\n    used = [False] * node_cnt\n    pq = []\n    dist[s] = 0\n    heapq.heappush(pq, (0, s))\n    while pq:\n        du, u = heapq.heappop(pq)\n        if used[u]:\n            continue\n        used[u] = True\n        for e in g[u]:\n            if e.cap == 0 or used[e.to]:\n                continue\n            nd = du + pot[u] + e.cost - pot[e.to]\n            if dist[e.to] > nd:\n                dist[e.to] = nd\n                heapq.heappush(pq, (nd, e.to))\n    return used[t]\n\ndef build_level_graph(s, t):\n    global level\n    level = [0] * node_cnt\n    q = deque()\n    q.append(s)\n    level[s] = 1\n    while q:\n        u = q.popleft()\n        for e in g[u]:\n            v = e.to\n            if e.cap == 0 or level[v]:\n                continue\n            if dist[v] == dist[u] + e.cost - pot[v] + pot[u]:\n                level[v] = level[u] + 1\n                q.append(v)\n    return level[t] != 0\n\ndef dfs(u, t, f):\n    if u == t:\n        return f\n    sent = 0\n    while cur[u] < len(g[u]):\n        i = cur[u]\n        e = g[u][i]\n        v = e.to\n        if e.cap and level[v] == level[u] + 1 and dist[v] == dist[u] + e.cost - pot[v] + pot[u]:\n            ret = dfs(v, t, min(f, e.cap))\n            if ret:\n                sent += ret\n                f -= ret\n                e.cap -= ret\n                g[v][e.rev].cap += ret\n                if f == 0:\n                    break\n        cur[u] += 1\n    return sent\n\ndef min_cost_flow(s, t, max_flow):\n    global pot, cur\n    flow = 0\n    cost = 0\n    pot = [0] * node_cnt\n    while dijkstra(s, t):\n        phase_flow = 0\n        while build_level_graph(s, t):\n            cur = [0] * node_cnt\n            while True:\n                df = dfs(s, t, max_flow)\n                if df == 0:\n                    break\n                max_flow -= df\n                phase_flow += df\n                if max_flow == 0:\n                    break\n            if max_flow == 0:\n                break\n        flow += phase_flow\n        cost += (dist[t] + pot[t]) * phase_flow\n        for i in range(node_cnt):\n            if dist[i] != INF:\n                pot[i] += dist[i]\n        if max_flow == 0:\n            break\n    return (flow, cost)\n\ndef main():\n    global node_cnt, g, dist, used, pot, level, cur\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    node_cnt = 0\n    g = []\n    L = max(n, k) * 2\n    add_nodes(L * n)\n    s = add_nodes(1)\n    t = add_nodes(1)\n    for _ in range(k):\n        a = next(it) - 1\n        add_edge(s, a, 1, 0)\n    for _ in range(m):\n        u = next(it) - 1\n        v = next(it) - 1\n        for i in range(L - 1):\n            u1 = u + i * n\n            v1 = v + (i + 1) * n\n            u2 = u + (i + 1) * n\n            v2 = v + i * n\n            for j in range(k):\n                w = c + d * (2 * j + 1)\n                add_edge(u1, v1, 1, w)\n                add_edge(v2, u2, 1, w)\n    for i in range(L - 1):\n        for j in range(n):\n            u = j + i * n\n            v = j + (i + 1) * n\n            add_edge(u, v, INF, c)\n    for i in range(L):\n        add_edge(i * n, t, INF, 0)\n    result = min_cost_flow(s, t, INF)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.0006914132391102612, -5.960462772236497e-07, -1.1920928244535389e-07, -0.0005844315164722502, -0.008778788149356842, -2.1457441107486375e-05, -0.014185662381350994, -0.029813479632139206, -0.00388177833519876, -0.0013766345800831914, -0.023600967600941658, -1.311301275563892e-06, -1.311301275563892e-06, -1.537788011773955e-05, -0.02982354536652565, -0.013646171428263187, -0.0009024838218465447, -0.0001908358681248501, -0.0001397035230183974, -0.03804221749305725, -0.007267112378031015, -0.18084090948104858, -0.0010319390567019582, -3.480850500636734e-05, -2.3841830625315197e-06, -2.0