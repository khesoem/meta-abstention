turn lim;\n    inq[x] = true;\n    int flow, res = lim;\n    for (int i = head[x]; i; i = edges[i].nxt) {\n        int y = edges[i].to, cap = edges[i].cap;\n        if (dist[y] != dist[x] + edges[i].cost || !cap || inq[y]) continue;\n        flow = dfs(y, min(res, cap));\n        if (flow) {\n            res -= flow;\n            edges[i].cap -= flow;\n            edges[i ^ 1].cap += flow;\n            if (!res) break;\n        }\n    }\n    return lim - res;\n}\n\nint dinic() {\n    int flow, sum = 0;\n    while (spfa())\n        while (flow = dfs(s, INF))\n            sum += flow * dist[t];\n    return sum;\n}\n\nint main() {\n    auto read_int = [](int &x) {\n        x = 0; char c = getchar(); bool neg = false;\n        while (!isdigit(c)) { if (c == '-') neg = true; c = getchar(); }\n        while (isdigit(c)) { x = (x << 1) + (x << 3) + (c ^ 48); c = getchar(); }\n        if (neg) x = -x;\n    };\n    read_int(n); read_int(m); read_int(k); read_int(v1); read_int(v2);\n    t = idx(n, 110, n) + 1;\n    for (int i = 2; i <= 110; ++i) add_edge(idx(1, i, n), t, INF, 0);\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 110; ++j)\n            add_edge(idx(i, j, n), idx(i, j + 1, n), INF, v1);\n    for (int i = 1, x; i <= k; ++i) { read_int(x); add_edge(s, idx(x, 1, n), 1, 0); }\n    for (int i = 1; i <= m; ++i) {\n        int x, y; read_int(x); read_int(y);\n        for (int j = 1; j < 110; ++j)\n            for (int l = 1; l <= k; ++l) {\n                add_edge(idx(x, j, n), idx(y, j + 1, n), 1, v2 * (2 * l - 1) + v1);\n                add_edge(idx(y, j, n), idx(x, j + 1, n), 1, v2 * (2 * l - 1) + v1);\n            }\n    }\n    printf(\"%d\", dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 5000010;\n    static final int INF = 1000000000;\n    static int n, m, k, v1, v2, s, t;\n    static int[] dist = new int[MAXN];\n    static boolean[] inq = new boolean[MAXN];\n    \n    static class Edge {\n        int to, nxt, cap, cost;\n        Edge(int to, int nxt, int cap, int cost) {\n            this.to = to;\n            this.nxt = nxt;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n    static Edge[] edges = new Edge[MAXN];\n    static int[] head = new int[MAXN];\n    static int ecnt = 1;\n    \n    static int idx(int x, int k, int n) {\n        return x + (k - 1) * n;\n    }\n    \n    static void add_edge(int from, int to, int cap, int cost) {\n        edges[++ecnt] = new Edge(to, head[from], cap, cost);\n        head[from] = ecnt;\n        edges[++ecnt] = new Edge(from, head[to], 0, -cost);\n        head[to] = ecnt;\n    }\n    \n    static boolean spfa() {\n        Queue<Integer> q = new LinkedList<>();\n        for (int i = s; i <= t; ++i) {\n            dist[i] = INF;\n            inq[i] = false;\n        }\n        q.add(s);\n        dist[s] = 0;\n        inq[s] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            inq[x] = false;\n            for (int i = head[x]; i > 0; i = edges[i].nxt) {\n                int y = edges[i].to, c = edges[i].cost;\n                if (dist[y] <= dist[x] + c || edges[i].cap == 0) continue;\n                dist[y] = dist[x] + c;\n                if (!inq[y]) {\n                    inq[y] = true;\n                    q.add(y);\n                }\n            }\n        }\n        return dist[t] != INF;\n    }\n    \n    static int dfs(int x, int lim) {\n        if (x == t) return lim;\n        inq[x] = true;\n        int flow, res = lim;\n        for (int i = head[x]; i > 0; i = edges[i].nxt) {\n            int y = edges[i].to, cap = edges[i].cap;\n            if (dist[y] != dist[x] + edges[i].cost || cap == 0 || inq[y]) continue;\n            flow = dfs(y, Math.min(res, cap));\n            if (flow > 0