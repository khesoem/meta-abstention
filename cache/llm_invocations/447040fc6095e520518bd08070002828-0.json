.size(); ++i) {\n        Edge& e = g[u][i];\n        int v = e.dest;\n        if (lvl[v] != lvl[u] + 1) continue;\n        int pushed = augment(v, min(f, e.cap - e.flow));\n        if (pushed) {\n            e.flow += pushed;\n            g[v][e.rev].flow -= pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nint dinic() {\n    int total = 0;\n    while (level_graph()) {\n        fill(cur, cur + MAX_N, 0);\n        int pushed;\n        while ((pushed = augment(s, INF))) {\n            total += pushed;\n        }\n    }\n    return total;\n}\n\nconst int dr[4] = {-1, 0, 0, 1};\nconst int dc[4] = {0, -1, 1, 0};\n\nint N, M;\nvector<vector<int>> wall, limit, dist;\nvector<string> grid1, grid2;\n\nvoid bfs(int r, int c, vector<vector<int>>& d, bool use_limit = false) {\n    for (int i = 0; i < N; ++i)\n        fill(d[i].begin(), d[i].end(), -1);\n    d[r][c] = 0;\n    queue<array<int, 2>> q;\n    q.push({r, c});\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        if (use_limit && d[x][y] == limit[x][y]) continue;\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + dr[k], ny = y + dc[k];\n            if (nx < 0 || nx >= N || ny < 0 || ny >= N || d[nx][ny] != -1 || wall[nx][ny]) continue;\n            if (use_limit && limit[nx][ny] > -1 && d[x][y] + 1 > limit[nx][ny]) continue;\n            d[nx][ny] = d[x][y] + 1;\n            q.push({nx, ny});\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N >> M;\n    grid1.resize(N);\n    grid2.resize(N);\n    for (auto& s : grid1) cin >> s;\n    for (auto& s : grid2) cin >> s;\n    wall.assign(N, vector<int>(N));\n    limit.assign(N, vector<int>(N));\n    dist.assign(N, vector<int>(N));\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            wall[i][j] = (grid1[i][j] == 'Y');\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            if (grid1[i][j] == 'Z')\n      