an spfa(int[] dist, int[] prevv, int[] preve) {\n        Arrays.fill(dist, INF);\n        Arrays.fill(prevv, -1);\n        Arrays.fill(preve, -1);\n        boolean[] inq = new boolean[fn];\n        Queue<Integer> q = new LinkedList<>();\n        dist[s] = 0;\n        q.add(s);\n        inq[s] = true;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            for (int i = 0; i < graph[u].size(); i++) {\n                Edge e = graph[u].get(i);\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        q.add(e.to);\n                        inq[e.to] = true;\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n\n    private static int minCostMaxFlow() {\n        int flow = 0, cost = 0;\n        int[] dist = new int[fn];\n        int[] prevv = new int[fn];\n        int[] preve = new int[fn];\n        while (spfa(dist, prevv, preve)) {\n            int d = INF;\n            for (int u = t; u != s; u = prevv[u]) {\n                d = Math.min(d, graph[prevv[u]].get(preve[u]).cap);\n            }\n            flow += d;\n            cost += d * dist[t];\n            for (int u = t; u != s; u = prevv[u]) {\n                Edge e = graph[prevv[u]].get(preve[u]);\n                e.cap -= d;\n                graph[u].get(e.rev).cap += d;\n            }\n        }\n        // assert flow == k;\n        return cost;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n      