s[v]) dis[v]=dis[u]+w,q.push(node(v,dis[v]));\n            }\n        }\n        for(int i=1;i<=all;i++) tag[i]=min(tag[i]+dis[i],winf);\n        if(!vis[s]) return false;\n        for(int i=1;i<=all;i++) vis[i]=false;\n        return true;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && tag[v]+r[i].w==tag[u] && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(dij(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*tag[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.BufferedReader;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.io.PrintWriter;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, f, w;\n        Edge next;\n\n        public Edge(int to, int f, int w) {\n            this.to = to;\n            this.f = f;\n            this.w = w;\n        }\n    }\n\n    static class Node implements Comparable<Node> {\n        int u, v;\n\n        public Node(int U, int V) {\n            this.u = U;\n            this.v = V;\n        }\n\n        @Override\n        public int compareTo(Node a) {\n            return a.v - this.v;\n        }\n    }\n\n    static class MinCostFlow {\n        static int[] dis, tag, cur;\n        static boolean[] vis;\n        static PriorityQueue<Node> q;\n\n        static int maxf;\n        static int minw;\n\n        static void add(int u, int v, int f, int w) {\n            Edge e = new Edge(v, f, w);\n            e.next = graph[u];\n            graph[u] = e;\n            Edge e1 = new Edge(u, 0, -w);\n            e1.next = graph[v];\n            graph[v] = e1;\n        }\n\n        static Edge[] graph;\n\n        static void dij(int s, int t) {\n            Arrays.fill(dis, Integer.MAX_VALUE);\n            Arrays.fill(cur, graph.length);\n            dis[t] = 0;\n            q.add(new Node(t, 0));\n            while (!q.isEmpty()) {\n                int u = q.peek().u;\n                q.poll();\n                if (vis[u]) continue;\n                vis[u] = true;\n                for (Edge e = graph[u]; e != null; e = e.next) {\n                    int v = e.to, w = tag[u] + e.w - tag[v];\n                    if (e.f > 0 && dis[u] + w < dis[v]) {\n                        dis[v] = dis[u] + w;\n                        q.add(new Node(v, dis[v]));\n                    }\n                }\n            }\n            for (int i = 0; i < graph.length; i++) {\n                tag[i] = Math.min(tag[i] + dis[i], Integer.MAX_VALUE);\n            }\n            if (!vis[s]) return;\n            for (int i = 0; i < graph.length; i++) {\n                vis[i] = false;\n            }\n        }\n\n        static int dfs(int u, int t, int fl) {\n            if (u == t || fl == 0) return fl;\n            int res = 0;\n            vis[u] = true;\n            for (Edge e = graph[u]; e != null; e = e.next) {\n                if (e.f > 0) {\n                    int v = e.to;\n                    if (!vis[v] && tag[v] + e.w == tag[u] && (int f = dfs(v, t, Math.min(fl, e.f)))) {\n                        e.f -= f;\n                        e.next.f += f;\n                        res += f;\n                        fl -= f;\n                        if (fl == 0) break;\n                    }\n                }\n            }\n            vis[u] = false;\n            return res;\n        }\n\n        static void work(int s, int t) {\n            while (dij(s, t)) {\n                int w = dfs(s, t, Integer.MAX_VALUE);\n                maxf += w;\n                minw += w * tag[s];\n            }\n        }\n    }\n\n    static int ss, tt, n, m, k, c, d;\n    static List<Integer>[] g;\n\n    static int id(int t, int x) {\n        return t * n + x + 2;\n    }\n\n    static Edge[] edges;\n\n    static void work(int t) {\n        int all = n + 2;\n        for (int u = 1; u <= n; u++) {\n            for (int v : g[u]) {\n                for (int p = 1; p <= k; p++) {\n                    MinCostFlow.add(id(t, u), id(t + 1, v), 1, d * (2 * p - 1));\n                }\n            }\n        }\n        for (int u = 1; u <= n; u++) {\n            MinCostFlow.add(id(t, u), id(t + 1, u), Integer.MAX_VALUE, 0);\n        }\n        MinCostFlow.add(id(t + 1, 1), tt, Integer.MAX_VALUE, c * (t + 1));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n        g = new List[n + 1];\n        for (int i = 1; i <= n; i++) {\n            g[i] = new ArrayList<>();\n        }\n        for (int i = 1; i <= k; i++) {\n            int a = Integer.parseInt(br.readLine());\n            MinCostFlow.add(ss, id(0, a), 1, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            g[u].add(v);\n            g[v].add(u);\n        }\n        MinCostFlow.add(id(0, 1), tt, Integer.MAX_VALUE, 0);\n        for (int i = 0; i <= n + k; i++) {\n            work(i);\n        }\n        MinCostFlow.work(ss, tt);\n        pw.println(MinCostFlow.minw);\n        pw.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.16456100344657898, -0.006146206986159086, -0.024675849825143814, -0.00403837114572525, -0.00038571644108742476, -0.34920787811279297, -0.5108698606491089, -0.00012493913527578115, -6.9141628955549095e-06, -2.3484506527893245e-05, -1.5378116586362012e-05, -0.10749142616987228, -3.576279254957626e-07, -4.768372718899627e-07, -1.5974172129062936e-05, -3.814704541582614e-06, -0.005254040006548166, -5.245222382654902e-06, -4.529963462118758e-06, -1.3947584193374496e-05, -0.3142492473125458, -0.028708580881357193, -1.7285496141994372e-05, -5.364432581700385e-06, -2.5034263671841472e-05, -0.0019227858865633607, -0.8964129090309143, -0.4019000828266144, -2.098105505865533e-05, -0.04477789252996445, -0.4812222123146057, -0.009461677633225918, -0.05142482370138168, -0.31647762656211853, -0.5492390394210815, -0.08772523701190948, -0.0001255352544831112, -0.0049411337822675705, -0.21033500134944916, -0.09040259569883347, -0.8538970351219177, -0.2546