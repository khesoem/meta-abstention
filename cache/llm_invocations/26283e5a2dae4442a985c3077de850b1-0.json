{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int MAXN = 10000;\nconst int MAXM = 2000000;\nconst int INF = 0x3f3f3f3f;\n\nstruct Edge {\n    int to, cap, flow, cost, rev;\n    Edge(int t, int c, int f, int co, int r) : to(t), cap(c), flow(f), cost(co), rev(r) {}\n};\n\nvector<vector<Edge>> graph;\nint dist[MAXN], prevv[MAXN], preve[MAXN];\n\nvoid add_edge(int from, int to, int cap, int cost) {\n    graph[from].emplace_back(to, cap, 0, cost, graph[to].size());\n    graph[to].emplace_back(from, 0, 0, -cost, graph[from].size() - 1);\n}\n\npair<int, int> min_cost_flow(int s, int t) {\n    int flow = 0, cost = 0;\n    while (true) {\n        fill(dist, dist + MAXN, INF);\n        dist[s] = 0;\n        bool update = true;\n        while (update) {\n            update = false;\n            for (int v = 0; v < MAXN; ++v) {\n                if (dist[v] == INF) continue;\n                for (int i = 0; i < graph[v].size(); ++i) {\n                    Edge &e = graph[v][i];\n                    if (e.cap > e.flow && dist[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        update = true;\n                    }\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        \n        int d = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            d = min(d, graph[prevv[v]][preve[v]].cap - graph[prevv[v]][preve[v]].flow);\n        }\n        \n        flow += d;\n        cost += d * dist[t];\n        for (int v = t; v != s; v = prevv[v]) {\n            Edge &e = graph[prevv[v]][preve[v]];\n            e.flow += d;\n            graph[v][e.rev].flow -= d;\n        }\n    }\n    return {flow, cost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    graph.resize(MAXN);\n    \n    for (int i = 0; i < k; i++) {\n        int x; cin >> x;\n        add_edge(0, x, 1, 0);\n    }\n    \n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j < k; j++) {\n            add_edge(1 + i * n, 9999, 1, i * c);\n        }\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v; cin >> u >> v;\n        for (int j = 1; j < 100; j++) {\n            for (int gg = 1; gg <= k; gg++) {\n                add_edge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                add_edge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n            }\n        }\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j < 100; j++) {\n            add_edge(i + (j - 1) * n, i + j * n, k, 0);\n        }\n    }\n    \n    auto result = min_cost_flow(0, 9999);\n    cout << result.second << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\nimport heapq\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    MAXN = 10000\n    INF = 0x3f3f3f3f\n    \n    # Graph representation: adjacency list with edges\n    # Each edge: [to, cap, flow, cost, rev_index]\n    graph = [[] for _ in range(MAXN)]\n    \n    def add_edge(from_node, to_node, cap, cost):\n        # Forward edge\n        rev_to = len(graph[to_node])\n        rev_from = len(graph[from_node])\n        graph[from_node].append([to_node, cap, 0, cost, rev_to])\n        \n        # Backward edge\n        graph[to_node].append([from_node, 0, 0, -cost, rev_from])\n    \n    # Read k starting positions\n    for _ in range(k):\n        x = int(data[idx]); idx += 1\n        add_edge(0, x, 1, 0)\n    \n    # Add edges from time layers to sink (node 9999)\n    for i in range(100):\n        for _ in range(k):\n            add_edge(1 + i * n, 9999, 1, i * c)\n    \n    # Read m edges\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                cost = (2 * gg - 1) * d\n                add_edge(u + (j - 1) * n, v + j * n, 1, cost)\n                add_edge(v + (j - 1) * n, u + j * n, 1, cost)\n    \n    # Add edges for staying in place across time layers\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            add_edge(i + (j - 1) * n, i + j * n, k, 0)\n    \n    # Min cost flow implementation using Bellman-Ford (since there might be negative costs)\n    def min_cost_flow(s, t):\n        flow = 0\n        cost = 0\n        \n        while True:\n            dist = [INF] * MAXN\n            prevv = [-1] * MAXN\n            preve = [-1] * MAXN\n            dist[s] = 0\n            update = True\n            \n            # Bellman-Ford style relaxation\n            while update:\n                update = False\n                for v in range(MAXN):\n                    if dist[v] == INF:\n                        continue\n                    for i, edge in enumerate(graph[v]):\n                        to, cap, flow_val, cost_val, rev = edge\n                        if cap > flow_val and dist[to] > dist[v] + cost_val:\n                            dist[to] = dist[v] + cost_val\n                            prevv[to] = v\n                            preve[to] = i\n                            update = True\n            \n            if dist[t] == INF:\n                break\n            \n            # Find the minimum residual capacity along the path\n            d = INF\n            v = t\n            while v != s:\n                prev = prevv[v]\n                e_idx = preve[v]\n                cap = graph[prev][e_idx][1]\n                flow_val = graph[prev][e_idx][2]\n                d = min(d, cap - flow_val)\n                v = prev\n            \n            # Update flow\n            flow += d\n            cost += d * dist[t]\n            v = t\n            while v != s:\n                prev = prevv[v]\n                e_idx = preve[v]\n                graph[prev][e_idx][2] += d\n                rev_idx = graph[prev][e_idx][4]\n                graph[v][rev_idx][2] -= d\n                v = prev\n        \n        return flow, cost\n    \n    result = min_cost_flow(0, 9999)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001532914029667154, -9.536738616588991e-07, -2.3841855067985307e-07, -0.0007801587926223874, -0.010006029158830643, -4.0411134250462055e-05, -0.012532057240605354, -0.0074249738827347755, -8.344646857949556e-07, -0.20142142474651337, -0.15226560831069946, -0.004085765685886145, -0.018773723393678665, -0.00011205045302631333