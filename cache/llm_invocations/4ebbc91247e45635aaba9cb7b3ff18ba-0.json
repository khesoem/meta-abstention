numerate(line):\n            if ch == 'Y':\n                block[x][y] = True\n            elif ch == 'Z':\n                red[x][y] = True\n            else:\n                a[x][y] = int(ch)\n\n    for x in range(n):\n        line = next(it).strip()\n        for y, ch in enumerate(line):\n            if ch != 'Y' and ch != 'Z':\n                b[x][y] = int(ch)\n\n    m = n * n\n    INF = 1000000000\n    dis = [[INF] * m for _ in range(m)]\n    for i in range(m):\n        dis[i][i] = 0\n\n    dx = [0, -1, 0, 1]\n    dy = [1, 0, -1, 0]\n\n    for x in range(n):\n        for y in range(n):\n            if block[x][y] or red[x][y]:\n                continue\n            for d in range(4):\n                i = x + dx[d]\n                j = y + dy[d]\n                if 0 <= i < n and 0 <= j < n and not block[i][j] and not red[i][j]:\n                    dis[x * n + y][i * n + j] = 1\n\n    # Floyd-Warshall\n    for k in range(m):\n        for i in range(m):\n            if dis[i][k] == INF:\n                continue\n            for j in range(m):\n                if dis[k][j] == INF:\n                    continue\n                nd = dis[i][k] + dis[k][j]\n                if nd < dis[i][j]:\n                    dis[i][j] = nd\n\n    # BFS for red distances\n    dred = [INF] * m\n    q = deque()\n    for i in range(n):\n        for j in range(n):\n            if red[i][j]:\n                q.append((i, j))\n                dred[i * n + j] = 0\n\n    while q:\n        x, y = q.popleft()\n        cur_id = x * n + y\n        for d in range(4):\n            i = x + dx[d]\n            j = y + dy[d]\n            if 0 <= i < n and 0 <= j < n and not block[i][j] and not red[i][j]:\n                nid = i * n + j\n                if dred[nid] > INF:\n                    dred[nid] = dred[cur_id] + 1\n                    q.append((i, j))\n\n    # Build flow network\n    source = 203  # N-2\n    sink = 204    # N-1\n    max_node = max(2 * m, sink) + 5\n    head = [-1] * max_node\n    nxt = []\n    to = []\n    cap = []\n    ec = 0\n\n    def add_edge(u, v, uv, vu):\n        nonlocal ec\n        nxt.append(head[u])\n        to.append(v)\n        cap.append(uv)\n        head[u] = ec\n        ec += 1\n        nxt.append(head[v])\n        to.append(u)\n        cap.append(vu)\n        head[v] = ec\n        ec += 1\n\n    seen = [False] * m\n    for cur in range(m):\n        sx = cur // n\n        sy = cur % n\n        if block[sx][sy] or red[sx][sy]:\n            continue\n        # reset seen\n        for i in range(m):\n            seen[i] = False\n        q = deque()\n        q.append((sx, sy))\n        seen[cur] = True\n        while q:\n            x, y = q.popleft()\n            id = x * n + y\n            if dis[cur][id] <= dt:\n                add_edge(cur << 1, (id << 1) | 1, 1000, 0)\n            if dis[cur][id] == dred[id]:\n                continue\n            for d in range(4):\n                i = x + dx[d]\n                j = y + dy[d]\n                nid = i * n + j\n                if (0 <= i < n and 0 <= j < n and not block[i][j] and not red[i][j] and\n                    dis[cur][nid] <= dred[nid] and dis[cur][nid] <= dt and\n                    dis[cur][nid] > dis[cur][id] and not seen[nid]):\n                    seen[nid] = True\n                    q.append((i, j))\n\n    # Add source edges\n    for i in range(n):\n        for j in range(n):\n            add_edge(source, (i * n + j) << 1, a[i][j], 0)\n\n    # Add sink edges\n    for i in range(n):\n        for j in range(n):\n            add_edge((i * n + j) << 1 | 1, sink, b[i][j], 0)\n\n    # Max flow\n    mark = [0] * max_node\n\n    def dfs(v, sink, flow):\n        if v == sink:\n            return flow\n        if mark[v]:\n            return 0\n        mark[v] = 1\n        e = head[v]\n        while e != -1:\n            if cap[e]:\n                u = to[e]\n                x = dfs(u, sink, min(flow, cap[e]))\n                if x:\n                    cap[