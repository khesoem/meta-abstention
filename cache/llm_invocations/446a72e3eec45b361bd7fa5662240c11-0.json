nt cnt1 = 0, cnt2 = 0;\n    vector<int> idx0(1 << n, -1), idx1(1 << n, -1);\n\n    for (int mask = 0; mask < (1 << n); ++mask) {\n        if (__builtin_popcount(mask) == half1) {\n            idx0[mask] = cnt1++;\n            subsets1.push_back(mask);\n        }\n        if (__builtin_popcount(mask) == half2) {\n            idx1[mask] = cnt2++;\n            subsets2.push_back(mask);\n        }\n    }\n\n    vector<int> f_arr(1 << cnt1), g_arr(1 << cnt2);\n    vector<vector<bool>> adj(2 * n, vector<bool>(2 * n, false));\n\n    auto compute = [&](vector<int>& out, const vector<int>& L, const vector<int>& R,\n                       const vector<int>& subgs, vector<int>& idx_map) {\n        vector<pair<int, int>> edges;\n        for (int u : L) for (int v : R) edges.emplace_back(u, v);\n        int m = edges.size();\n\n        for (int mask = 0; mask < (1 << m); ++mask) {\n            long long weight = 1;\n            for (int i = 0; i < m; ++i) {\n                int u = edges[i].first, v = edges[i].second;\n                if (mask & (1 << i)) {\n                    weight = (weight * prob[u][v]) % MOD;\n                    adj[u][v] = true;\n                } else {\n                    weight = (weight * ((1 - prob[u][v] + MOD) % MOD)) % MOD;\n                    adj[u][v] = false;\n                }\n            }\n\n            int new_mask = 0;\n            for (int gr : subgs) {\n                vector<int> perm(L.begin(), L.end());\n                vector<int> idxs;\n                for (int i = 0; i < n; ++i)\n                    if (gr & (1 << i)) idxs.push_back(i + n);\n\n                sort(idxs.begin(), idxs.end());\n                bool found = false;\n                do {\n                    bool ok = true;\n                    for (size_t i = 0; i < perm.size(); ++i)\n                        if (!adj[perm[i]][idxs[i]]) { ok = false; break; }\n                    if (ok) { found = true; break; }\n                } while (next_permutation(idxs.begin(),