rn\n\n    half1 = n // 2\n    half2 = n - half1\n\n    left1 = list(range(half1))\n    left2 = list(range(half1, n))\n    right = list(range(n, 2 * n))\n\n    subsets1 = []\n    subsets2 = []\n    cnt1 = 0\n    cnt2 = 0\n    idx0 = [-1] * (1 << n)\n    idx1 = [-1] * (1 << n)\n\n    for mask in range(1 << n):\n        if bin(mask).count('1') == half1:\n            idx0[mask] = cnt1\n            cnt1 += 1\n            subsets1.append(mask)\n        if bin(mask).count('1') == half2:\n            idx1[mask] = cnt2\n            cnt2 += 1\n            subsets2.append(mask)\n\n    f_arr = [0] * (1 << cnt1)\n    g_arr = [0] * (1 << cnt2)\n    adj = [[False] * (2 * n) for _ in range(2 * n)]\n\n    def compute(out, L, R, subgs, idx_map):\n        edges = []\n        for u in L:\n            for v in R:\n                edges.append((u, v))\n        m = len(edges)\n\n        for mask in range(1 << m):\n            weight = 1\n            for i in range(m):\n                u, v = edges[i]\n                if mask & (1 << i):\n                    weight = (weight * prob[u][v]) % MOD\n                    adj[u][v] = True\n                else:\n                    weight = (weight * ((1 - prob[u][v] + MOD) % MOD)) % MOD\n                    adj[u][v] = False\n\n            new_mask = 0\n            for gr in subgs:\n                perm = L[:]\n                idxs = []\n                for i in range(n):\n                    if gr & (1 << i):\n                        idxs.append(i + n)\n\n                idxs.sort()\n                found = False\n                while True:\n                    ok = True\n                    for i in range(len(perm)):\n                        if not adj[perm[i]][idxs[i]]:\n                            ok = False\n                            break\n                    if ok:\n                        found = True\n                        break\n                    if not next_permutation(idxs):\n                        break\n\n                if found:\n                    new_mask |= (1 << idx_map[gr])\n            out[new_mask] = (out[new_mask] + int(weight)) % MOD\n\n    def next_permutation(arr):\n        i = len(arr) - 2\n        while i >= 0 and arr[i] >= arr[i + 1]:\n            i -= 1\n        if i < 0:\n            return False\n        j = len(arr) - 1\n        while arr[j] <= arr[i]:\n            j -= 1\n        arr[i], arr[j] = arr[j], arr[i]\n        arr[i + 1:] = reversed(arr[i + 1:])\n        return True\n\n    compute(f_arr, left1, right, subsets1, idx0)\n    compute(g_arr, left2, right, subsets2, idx1)\n\n    for i in range(cnt1):\n        for mask in range(1 << cnt1):\n            if mask & (1 << i):\n                f_arr[mask] = (f_arr[mask] + f_arr[mask ^ (1 << i)]) % MOD\n\n    ans = 0\n    rev_map = [0] * cnt2\n    for i in range(cnt2):\n        mask = subsets2[i]\n        complement = ((1 << n) - 1) ^ mask\n        rev_map[i] = idx0[complement]\n\n    for mask in range(1, 1 << cnt2):\n        complement = (1 << cnt2) - 1 - mask\n        rev_mask = 0\n        for i in range(cnt2):\n            if complement & (1 << i):\n                rev_mask |= (1 << rev_map[i])\n\n        inv_complement = ((1 << cnt1) - 1) ^ rev_mask\n        weight = (1 - f_arr[inv_complement] + MOD) % MOD\n        ans = (ans + weight * g_arr[mask]) % MOD\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020680672605521977, -1.0728830375228426e-06, -3.576278118089249e-07, -0.020545637235045433, -0.0011330381967127323, -0.04860810935497284, -0.7032572031021118, -0.016654154285788536, -0.20142307877540588, -0.005392647814005613, -1.1920928244535389e-07, -2.264974000354414e-06, 0.0, -7.152555099310121e-07, -0.008621849119663239, 0.0, -3.5523738915799186e-05, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -4.768370445162873e-07, -3.576278118089249e-07, -2.9802276912960224e-06, -2.0265558760002023e-06, -0.0052601983770