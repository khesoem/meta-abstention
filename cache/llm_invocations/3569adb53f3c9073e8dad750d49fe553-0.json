n\n    public static void main(String[] args) throws IOException {\n        BufferedReader in = new BufferedReader(new InputStreamReader(System.in));\n        s = in.readLine().toCharArray();\n        result = 0;\n\n        if (s.length >= 2) {\n            for (String t : TARGETS) {\n                evaluate(s[s.length - 2], s[s.length - 1], t);\n            }\n        } else {\n            if (s[0] == '0' || s[0] == 'X' || s[0] == '_') {\n                result++;\n            }\n        }\n\n        System.out.println(result);\n        in.close();\n    }\n\n    private static void evaluate(char c1, char c2, String target) {\n        char x = c1;\n        char y = c2;\n\n        if (x == '_' && target.charAt(0) == '0' && s.length - 2 == 0) return;\n\n        if (x == 'X') {\n            x = target.charAt(0);\n            if (y == 'X') y = target.charAt(0);\n        }\n        if (y == 'X') {\n            y = target.charAt(1);\n            if (x == 'X') x = target.charAt(1);\n        }\n        if (x == '_') x = target.charAt(0);\n        if (y == '_') y = target.charAt(1);\n\n        char xVal = 'n';\n        if (c1 == 'X') xVal = x;\n        if (c2 == 'X') xVal = y;\n\n        if (x == target.charAt(0) && y == target.charAt(1)) {\n            countSolutions(xVal);\n        }\n    }\n\n    private static void countSolutions(char x) {\n        if ((x == '0' && s[0] == 'X') || s[0] == '0') return;\n\n        long factor = 1;\n        boolean usedX = x != 'n';\n\n        for (int i = 0; i < s.length - 2; i++) {\n            if (s[i] == '_') {\n                factor *= (i == 0) ? 9 : 10;\n            }\n            if (!usedX && s[i] == 'X') {\n                usedX = true;\n                factor *= (i == 0) ? 9 : 10;\n            }\n        }\n\n        result += factor;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport 