ayList<>();\n    static int mod;\n    static long su;\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        if (line == null) return;\n        String[] parts = line.trim().split(\"\\\\s+\");\n        if (parts.length < 2) return;\n        int n = Integer.parseInt(parts[0]);\n        mod = Integer.parseInt(parts[1]);\n\n        mem.add(0);\n        mem.add(1);\n        su = 1;\n\n        for (int i = 2; i <= n; i++) {\n            int cur = computeCur(i);\n            su = (su + cur) % mod;\n            mem.add(cur);\n        }\n        System.out.println(mem.get(mem.size() - 1));\n    }\n\n    static int computeCur(int i) {\n        int sq = (int) Math.sqrt(i) + 1;\n        long cur = su;\n        for (int f = 2; f < sq; f++) {\n            cur = (cur + mem.get(i / f)) % mod;\n        }\n        int be = i;\n        int limit = i / sq;\n        for (int j = 1; j <= limit; j++) {\n            int nxt = i / (j + 1);\n            cur = (cur + (long) (be - nxt) * mem.get(j)) % mod;\n            be = nxt;\n        }\n        return (int) cur;\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.038786500692367554, -5.245195097813848e-06, 0.0, -1.1920928244535389e-07, -4.386805812828243e-05, -9.65590606938349e-06, 0.0, -0.023245446383953094, -0.16022826731204987, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.31326183676719666, -2.3841855067985307e-07, -9.536697689327411e-06, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -2.3841830625315197e-06, 0.0, 0.0, -1.1920928244535389e-07, -0.0005536930402740836, -0.011048685759305954, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -0.0001245659514097497, -2.3841830625315197e-06, 0.0, -9.417489309271332e-06, -0.0003361137059982866, -1.3232143828645349e-05, -0.5759450197219849, -0.005244426429271698, -0.00020346954988781363, 0.0, -5.960