         long s1 = choose[v1][r];\n            long c2 = choose[v2][r] - choose[v2 - 1][r];\n            dfs(x + s1 * c2, y, v1, v2 - 1);\n        }\n    }\n\n    long solve(long x, long y, int v1, int v2) {\n        long key = x * 10000 + v1 * 100 + v2;\n        Long cached = memo.get(key);\n        if (cached != null) return cached;\n        long ans = 0L;\n        long d = abs(x - y);\n        if (d - choose[v1][r] * choose[v2][r] > best) {\n            memo.put(key, ans);\n            return ans;\n        }\n        if (v1 == 0 && v2 == 0) return 1;\n        char ch = s[v1 + v2 - 1];\n        if (v1 > 0 && ch != 'B') {\n            long c1 = choose[v1][r] - choose[v1 - 1][r];\n            long s2 = choose[v2][r];\n            ans += solve(x, y + c1 * s2, v1 - 1, v2);\n        }\n        if (v2 > 0 && ch != 'A') {\n            long s1 = choose[v1][r];\n            long c2 = choose[v2][r] - choose[v2 - 1][r];\n            ans += solve(x + s1 * c2, y, v1, v2 - 1);\n        }\n        memo.put(key, ans);\n        return ans;\n    }\n\n    void start() {\n        r = in.nextInt(); c = in.nextInt(); in.nextLine();\n        s = in.nextLine().toCharArray();\n        int n = 2 * (r + c);\n        buildTable(n);\n        int v1 = r + c, v2 = r + c;\n        long x = 0, y = 0;\n        while (v1 >= r && v2 >= r) {\n            if (x > y) {\n                long c1 = choose[v1][r] - choose[v1 - 1][r];\n                long s2 = choose[v2][r];\n                y += c1 * s2;\n                v1--;\n            } else {\n                long s1 = choose[v1][r];\n                long c2 = choose[v2][r] - choose[v2 - 1][r];\n                x += s1 * c2;\n                v2--;\n            }\n        }\n        best = abs(x - y);\n        dfs(0, 0, r + c, r + c);\n        long ans = solve(0, 0, r + c, r + c);\n        System.out.println(ans);\n    }\n\n    public static void main(String[] args) {\n        new Test().start();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_s