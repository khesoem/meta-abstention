it(bits);\n    dp_table[depth][bits] = 0;\n    for (int subset = remainder; subset; subset = (subset - 1) & remainder)\n        dp_table[depth][bits] = (dp_table[depth][bits] + 1LL * solve(depth + 1, subset) * inv_factorial[bits - subset] % MOD) % MOD;\n    dp_table[depth][bits] = (dp_table[depth][bits] + 1LL * solve(depth + 1, 0) * inv_factorial[bits] % MOD) % MOD;\n    return dp_table[depth][bits];\n}\n\nint main() {\n    scanf(\"%d %d %d\", &N, &K, &MOD);\n    prepare();\n    int total = fast_power(K, N);\n    if (N % 2 == 0) {\n        memset(dp_table, -1, sizeof(dp_table));\n        total = (total - solve(0, N) + MOD) % MOD;\n    }\n    printf(\"%d\", total);\n    return 0;\n}\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef extract_lowest_bit(x):\n    return x & -x\n\ndef fast_power(b, e, mod):\n    res = 1\n    while e:\n        if e & 1:\n            res = (res * b) % mod\n        b = (b * b) % mod\n        e >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.readline().split()\n    N = int(data[0])\n    K = int(data[1])\n    MOD = int(data[2])\n    \n    factorial = [0] * 250003\n    inv_factorial = [0] * 250003\n    \n    factorial[0] = 1\n    for i in range(1, N + 1):\n        factorial[i] = (factorial[i-1] * i) % MOD\n    \n    inv_factorial[N] = fast_power(factorial[N], MOD - 2, MOD)\n    for i in range(N - 1, -1, -1):\n        inv_factorial[i] = (inv_factorial[i+1] * (i + 1)) % MOD\n    \n    # Initialize dp_table with -1\n    dp_table = [[-1] * 250003 for _ in range(27)]\n    \n    def solve(depth, bits):\n        if dp_table[depth][bits] != -1:\n            return dp_table[depth][bits]\n        if bits == 0:\n            dp_table[depth][bits] = (factorial[N] * factorial[K] % MOD) * inv_factorial[K - depth] % MOD\n            return dp_table[depth][bits]\n        remainder = bits - extract_lowest_bit(bits)\n        dp_table[depth][bits] = 0\n        subset = remainder\n        while subset:\n            dp_table[depth][bits] = (dp_table[depth][bits] + solve(depth + 1, subset) * inv_factorial[bits - subset] % MOD) % MOD\n            subset = (subset - 1) & remainder\n        dp_table[depth][bits] = (dp_table[depth][bits] + solve(depth + 1, 0) * inv_factorial[bits] % MOD) % MOD\n        return dp_table[depth][bits]\n    \n    total = fast_power(K, N, MOD)\n    if N % 2 == 0:\n        total = (total - solve(0, N) + MOD) % MOD\n    \n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013028726971242577, -1.0728830375228426e-06, -9.536738616588991e-07, -0.08658153563737869, -0.00011646069469861686, -0.003604345954954624, -0.0031522843055427074, -0.18131276965141296, -1.764281842042692e-05, -2.3841855067985307e-07, -1.311301275563892e-06, 0.0, -2.9205850296420977e-05, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -7.152555099310121e-07, 0.0, -1.5497195136049413e-06, -2.9802276912960224e-06, -8.344646857949556e-07, -9.775113539944869e-06, -1.6689160474925302e-05, -0.0004897110629826784, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.0008060067193582654, -0.4291735589504242, -8.940656698541716e-06, -1.1920928244535389e-07, -2.861018856492592e-06, 0.0, 0.0, 0.0, -8.344646857949556e-07, 0.0, -0.001178047270514071, 0.0, -4.0531076592742465e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.291525328881107e-06, 0.0, 0.0, 0.0, 0.0, -9.536738616588991e-07, -2.3841855067985307e-07, 0.0, -1.0728830375228426e-06, -6.318072337307967e-06, 0.0, 0.0, 0.0, 0.0, -8.344646857949556e-07, -4.768370445162873e-07, -1.6689286894688848e-06, -3.576278118089249e-07, 0.0, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, -1.4305104514278355e-06, -3.576278118089249e-07, -1.4305104514278