j.get(dst).size(), 0, cap, cost));\n            if (src == dst) {\n                adj.get(src).get(adj.get(src).size() - 1).rev++;\n            }\n            adj.get(dst).add(new Edge(dst, src, adj.get(src).size() - 1, 0, 0, -cost));\n        }\n\n        long rcost(Edge e) {\n            return e.cost + potential[e.src] - potential[e.dst];\n        }\n\n        long dijkstra(int source, int sink) {\n            Arrays.fill(dist, oo);\n            PriorityQueue<Node> pq = new PriorityQueue<>(Comparator.comparingLong(node -> node.cost));\n            dist[source] = 0;\n            pq.offer(new Node(0, source));\n\n            while (!pq.isEmpty()) {\n                Node node = pq.poll();\n                if (dist[node.vertex] < node.cost) continue;\n                if (node.vertex == sink) break;\n                for (Edge e : adj.get(node.vertex)) {\n                    if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e)) {\n                        back[e.dst] = e;\n                        dist[e.dst] = dist[e.src] + rcost(e);\n                        pq.offer(new Node(dist[e.dst], e.dst));\n                    }\n                }\n            }\n            return dist[sink];\n        }\n\n        long[] maxFlow(int source, int sink) {\n            long flow = 0;\n            long cost = 0;\n\n            for (int u = 0; u < n; u++) {\n                for (Edge e : adj.get(u)) {\n                    e.flow = 0;\n                }\n            }\n\n            Arrays.fill(potential, 0);\n            Arrays.fill(dist, oo);\n            Arrays.fill(back, null);\n\n            while (dijkstra(source, sink) < oo) {\n                for (int u = 0; u < n; u++) {\n                    if (dist[u] < dist[sink]) {\n                        potential[u] += dist[u] - dist[sink];\n                    }\n                }\n\n                long f = Long.MAX_VALUE;\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    f = Math.min(f, e.cap - e.flow);\n                }\n\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    e.flow += f;\n                    adj.get(e.dst).get(e.rev).flow -= f;\n                }\n\n                flow += f;\n                cost += f * (potential[sink] - potential[source]);\n            }\n\n            return new long[]{flow, cost};\n        }\n\n        static class Node {\n            long cost;\n            int vertex;\n\n            Node(long cost, int vertex) {\n                this.cost = cost;\n                this.vertex = vertex;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MinCostMaxFlow g = new MinCostMaxFlow((n + 2) * 102);\n\n        for (int i = 0; i < 102; i++) {\n            g.addEdge(i * (n + 2) + 1, i * (n + 2), 100, (long) i * c);\n        }\n\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < n + 1; j++) {\n                g.addEdge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0);\n            }\n        }\n\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            g.addEdge(n + 1, u, 1, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                    g.addEdge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                }\n            }\n        }\n\n        long[] result = g.maxFlow(n + 1, 101 * (n + 2));\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confid