int adjust(pedge e, int d) {\n  if (!e) return d;\n  d = adjust(e->from->back, min(d, e->flow));\n  e->flow -= d;\n  e->opposite->flow += d;\n  return d;\n}\n\nvoid connect(pnode &a, pnode &b, int w) {\n  pedge ea = make_shared<edge>();\n  pedge eb = make_shared<edge>();\n  ea->from = a; ea->to = b; ea->flow = w; ea->opposite = eb;\n  eb->from = b; eb->to = a; eb->flow = 0; eb->opposite = ea;\n  a->adjusted.emplace_back(ea);\n  b->adjusted.emplace_back(eb);\n}\n\nint max_flow(vector<pnode> &g, pnode &source, pnode &sink) {\n  int result = 0;\n  while (true) {\n    for (auto u : g) u->age = 0;\n    queue<pnode> q;\n    q.push(source); source->age = 1;\n    while (!(q.empty() || sink->age != 0)) {\n      auto u = q.front(); q.pop();\n      for (auto e : u->adjusted) {\n        auto v = e->to;\n        if (v->age != 0 || e->flow == 0) continue;\n        v->back = e;\n        v->age = u->age + 1;\n        q.push(v);\n      }\n    }\n    if (sink->age == 0) break;\n    for (auto e : sink->adjusted) {\n      auto o = e->opposite;\n      if (o->from->age != sink->age - 1 || o->flow == 0) continue;\n      result += adjust(o, o->flow);\n    }\n  }\n  return result;\n} // ^ max flow\n\nl n;\n\nl linear(l t, l r, l c) {\n  return t * n * n + r * n + c;\n}\n\nint main() {\n  ios_base::sync_with_stdio(false); cin.tie(0);\n  l T;\n  while (cin >> n >> T) {\n    vector<string> lab(n);\n    vector<pnode> g((T + 1) * n * n + 2);\n    for (auto& u : g) u = make_shared<node>();\n    auto source = g[linear(T, n-1, n-1) + 1];\n    auto sink = g[linear(T, n-1, n-1) + 2];\n    vector<ll> z;\n    for (l r = 0; r < n; r++) {\n      cin >> lab[r];\n      for (l c = 0; c < n; c++) {\n        if (lab[r][c] == 'Y') continue;\n        if (lab[r][c] == 'Z') {\n          z.emplace_back(r, c);\n          continue;\n        }\n        connect(source, g[linear(0, r, c)], lab[r][c] - '0');\n        lab[r][c] = '0';\n      }\n    }\n    for (l r = 0; r < n; r++) {\n      string row; cin >> row;\n      for (l c = 0; c < n; c++) {\n        if (row[c] == 'Y' or row[c] == 'Z') continue;\n        connect(g[linear(T, r, c)], sink, row[c] - '0');\n      }\n    }\n    const l dr[] = {1, 0, -1, 0};\n    const l dc[] = {0, 1, 0, -1};\n    for (l t = 0; t < T; t++) {\n      // connect corridors\n      for (l r = 0; r < n; r++) {\n        for (l c = 0; c < n; c++) {\n          connect(g[linear(t, r, c)], g[linear(t + 1, r, c)], INF);\n          if (lab[r][c] != '0') continue;\n          for (l d = 0; d < 4; d++) {\n            l r_ = r + dr[d];\n            l c_ = c + dc[d];\n            if (r_ < 0 or r_ >= n or c_ < 0 or c_ >= n or lab[r_][c_] != '0')\n              continue;\n            connect(g[linear(t, r, c)], g[linear(t + 1, r_, c_)], INF);\n          }\n        }\n      }\n      // spread\n      vll z_;\n      for (auto e : z) {\n        l r, c; tie(r, c) = e;\n        for (l d = 0; d < 4; d++) {\n          l r_ = r + dr[d];\n          l c_ = c + dc[d];\n          if (r_ < 0 or r_ >= n or c_ < 0 or c_ >= n or lab[r_][c_] != '0')\n            continue;\n          z_.emplace_back(r_, c_);\n          lab[r_][c_] = 'Z';\n        }\n      }\n      swap(z_, z);\n    }\n    cout << max_flow(g, source, sink) << '\\n';\n  }\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\nfrom typing import List, Tuple, Optional\n\nINF = float('inf')\nEPS = 1e-10\n\nclass Node:\n    def __init__(self):\n        self.age = 0\n        self.adjusted = []\n        self.back = None\n\nclass Edge:\n    def __init__(self):\n        self.from_node = None\n        self.to_node = None\n        self.flow = 0\n        self.opposite = None\n\ndef adjust(e: Optional[Edge], d: int) -> int:\n    if e is None:\n        return d\n    d = adjust(e.from_node.back, min(d, e.flow))\n    e.flow -= d\n    e.opposite.flow += d\n    return d\n\ndef connect(a: Node, b: Node, w: int):\n    ea = Edge()\n    eb = Edge()\n    ea.from_node = a\n    ea.to_node = b\n    ea.flow = w\n    ea.opposite = eb\n    eb.from_node = b\n    eb.to_node = a\n    eb.flow = 0\n    eb.opposite = ea\n    a.adjusted.append(ea)\n    b.adjusted.append(eb)\n\ndef max_flow(g: List[Node], source: Node, sink: Node) -> int:\n    result = 0\n    while True:\n        for u in g:\n            u.age = 0\n        q = deque()\n        q.append(source)\n        source.age = 1\n        while q and sink.age == 0:\n            u = q.popleft()\n            for e in u.adjusted:\n                v = e.to_node\n                if v.age != 0 or e.flow == 0:\n                    continue\n                v.back = e\n                v.age = u.age + 1\n                q.append(v)\n        if sink.age == 0:\n            break\n        for e in sink.adjusted:\n            o = e.opposite\n            if o.from_node.age != sink.age - 1 or o.flow == 0:\n                continue\n            result += adjust(o, o.flow)\n    return result\n\ndef linear(t: int, r: int, c: int, n: int) -> int:\n    return t * n * n + r * n + c\n\ndef main():\n    data = sys.stdin.read().strip().split('\\n')\n    idx = 0\n    output = []\n    while idx < len(data):\n        if not data[idx].strip():\n            idx += 1\n            continue\n        n, T = map(int, data[idx].split())\n        idx += 1\n        \n        lab = []\n        for _ in range(n):\n            lab.append(data[idx])\n            idx += 1\n        \n        total_nodes = (T + 1) * n * n + 2\n        g = [Node() for _ in range(total_nodes)]\n        source = g[linear(T, n-1, n-1, n) + 1]\n        sink = g[linear(T, n-1, n-1, n) + 2]\n        \n        z = []\n        for r in range(n):\n            for c in range(n):\n                if lab[r][c] == 'Y':\n                    continue\n                if lab[r][c] == 'Z':\n                    z.append((r, c))\n                    continue\n                connect(g[0], g[linear(0, r, c, n)], ord(lab[r][c]) - ord('0'))\n                lab[r] = lab[r][:c] + '0' + lab[r][c+1:]\n        \n        row_data = []\n        for _ in range(n):\n            row_data.append(data[idx])\n            idx += 1\n        \n        for r in range(n):\n            for c in range(n):\n                if row_data[r][c] in ('Y', 'Z'):\n                    continue\n                connect(g[linear(T, r, c, n)], sink, ord(row_data[r][c]) - ord('0'))\n        \n        dr = [1, 0, -1, 0]\n        dc = [0, 1, 0, -1]\n        \n        for t in range(T):\n            for r in range(n):\n                for c in range(n):\n                    connect(g[linear(t, r, c, n)], g[linear(t + 1, r, c, n)], INF)\n                    if lab[r][c] != '0':\n                        continue\n                    for d in range(4):\n                        r_ = r + dr[d]\n                        c_ = c + dc[d]\n                        if r_ < 0 or r_ >= n or c_ < 0 or c_ >= n or lab[r_][c_] != '0':\n                            continue\n                        connect(g[linear(t, r, c, n)], g[linear(t + 1, r_, c_, n)], INF)\n            \n            z_ = []\n            for r, c in z:\n                for d in range(4):\n                    r_ = r + dr[d]\n                    c_ = c + dc[d]\n                    if r_ < 0 or r_ >= n or c_ < 0 or c_ >= n or lab[r_][c_] != '0':\n                        continue\n                    z_.append((r_, c_))\n                    lab[r_] = lab[r_][:c_] + 'Z' + lab[r_][c_+1:]\n            z = z_\n        \n        result = max_flow(g, source, sink)\n        output.append(str(result))\n    \n    print('\\n'.join(output))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00021002470748499036, -2.145764938177308e-06, -3.576278118089249e-07, -0.001374610816128552, -0.0009305914281867445, -2.3841855067985307e-07, -0.0001245659514097497, -0.00013517419574782252, -1.43