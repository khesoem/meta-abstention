d + mod) % mod;\n            \n            ord += len;\n        }\n        return;\n    }\n    \n    ord++;\n    res = (res + ((ord - num) % MOD + MOD) % MOD) % mod;\n    \n    for (int d = 0; d <= 9; ++d) {\n        traverse(num * 10 + d);\n    }\n}\n\nint main() {\n    scanf(\"%lld\", &n);\n    \n    ord = 0;\n    precompute(0, 0);\n    \n    for (int i = 0; i < K; ++i) {\n        sort(seq[i].begin(), seq[i].end());\n    }\n    \n    ord = 0;\n    for (int first = 1; first <= 9; ++first) {\n        traverse(first);\n    }\n    \n    printf(\"%d\\n\", res);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD = 998244353\nmod = 1000000007\nK = 7\nB = 1000000\n\ndef main():\n    n = int(sys.stdin.readline().strip())\n    \n    seq = [[] for _ in range(K)]\n    accum = [0] * K\n    ord_val = 0\n    res = 0\n\n    def precompute(num, depth):\n        nonlocal ord_val\n        ord_val += 1\n        val = ((ord_val - num) % MOD + MOD) % MOD\n        seq[depth].append(val)\n        accum[depth] = (accum[depth] + val) % mod\n        \n        if depth == K - 1:\n            return\n        \n        for d in range(10):\n            precompute(num * 10 + d, depth + 1)\n    \n    def traverse(num):\n        nonlocal ord_val, res\n        if num > n:\n            return\n        \n        if num * B + B - 1 <= n and num * B * 10 > n:\n            cur_ord = ord_val\n            for k in range(K):\n                mult = 10 ** k\n                len_seq = len(seq[k])\n                diff = ((cur_ord - num * mult) % MOD + MOD) % MOD\n                pos = bisect.bisect_left(seq[k], MOD - diff)\n                \n                res = (res + diff * len_seq % mod + accum[k]) % mod\n                res = (res - MOD * (len_seq - pos) % mod + mod) % mod\n                \n                ord_val += len_seq\n            retu