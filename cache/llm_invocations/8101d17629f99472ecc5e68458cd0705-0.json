=a[i]*b[j];\n    for(int i=0;i<=lv;i++) c[i]%=mod;\n    return c;\n}\nvector<long long> poly_power(vector<long long> a,int e){\n    vector<long long> c(lv+1,0); c[0]=1;\n    while(e){\n        if(e&1) c=multiply(c,a);\n        a=multiply(a,a);\n        e>>=1;\n    }\n    return c;\n}\nint main(){\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n    cin>>n>>k>>mod;\n    calc_fact(n);\n    if(n&1){ cout<<my_pow(k,n)<<\"\\n\"; return 0; }\n    m=1; lv=0; while(m<=n){ m<<=1; lv++; }\n    for(int i=0;i<m;i++) cnt[i]=cnt[i>>1]+(i&1);\n    calc_fact(m);\n    for(int i=0;i<m;i++) f[cnt[i]][i]=invfact[i];\n    for(int i=0;i<=lv;i++) fwt(f[i],m,1);\n    vector<long long> tmp(lv+1);\n    for(int s=0;s<m;s++){\n        for(int i=0;i<=lv;i++) tmp[i]=f[i][s];\n        tmp=poly_power(tmp,k);\n        for(int i=0;i<=lv;i++) f[i][s]=tmp[i];\n    }\n    fwt(f[cnt[n]],m,-1);\n    int ans=my_pow(k,n) - 1LL*f[cnt[n]][n]*fact[n]%mod;\n    ans=fix(ans);\n    cout<<ans<<\"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.util.stream.*;\n\npublic class Main {\n    static final int MAXN = 270005;\n    static int n, k, mod = 1, m, lv;\n    static int[] cnt = new int[MAXN];\n    static int[] fact = new int[MAXN];\n    static int[] invfact = new int[MAXN];\n    static int[][] f = new int[19][MAXN];\n    \n    static int fix(int x) {\n        if (x < 0) return x + mod;\n        if (x >= mod) return x - mod;\n        return x;\n    }\n    \n    static void addmod(int[] a, int b) {\n        a[0] = fix(a[0] + b);\n    }\n    \n    static int my_pow(int a, int b) {\n        if (b == 0) return 1;\n        int h = my_pow(a, b / 2);\n        h = (int)((long)h * h % mod);\n        if ((b & 1) == 1) h = (int)((long)h * a % mod);\n        return h;\n    }\n    \n    static void calc_fact(int N) {\n        fact[0] = 1;\n  