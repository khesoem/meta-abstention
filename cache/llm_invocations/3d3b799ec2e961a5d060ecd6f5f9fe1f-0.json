{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst int INF = 0x3f3f3f3f;\nconst int MOD = 1000000007;\nconst int MAX_TIME = 100;\nconst int MAX_NODES = MAX_TIME * MAX_TIME;\nconst int MAX_EDGES = MAX_NODES * MAX_NODES;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nvector<vector<Edge>> graph;\nvector<int> dist, prevv, preve;\n\nvoid add_edge(int from, int to, int cap, int cost) {\n    graph[from].emplace_back(to, cap, cost, graph[to].size());\n    graph[to].emplace_back(from, 0, -cost, graph[from].size() - 1);\n}\n\nbool spfa(int s, int t) {\n    fill(dist.begin(), dist.end(), INF);\n    queue<int> q;\n    vector<bool> inq(graph.size(), false);\n    dist[s] = 0;\n    q.push(s);\n    inq[s] = true;\n\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = false;\n        for (int i = 0; i < graph[u].size(); ++i) {\n            auto& e = graph[u][i];\n            if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                dist[e.to] = dist[u] + e.cost;\n                prevv[e.to] = u;\n                preve[e.to] = i;\n                if (!inq[e.to]) {\n                    inq[e.to] = true;\n                    q.push(e.to);\n                }\n            }\n        }\n    }\n    return dist[t] < INF;\n}\n\nint min_cost_flow(int s, int t) {\n    int flow = 0, cost = 0;\n    while (spfa(s, t)) {\n        int f = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            f = min(f, graph[prevv[v]][preve[v]].cap);\n        }\n        flow += f;\n        cost += dist[t] * f;\n        for (int v = t; v != s; v = prevv[v]) {\n            auto& e = graph[prevv[v]][preve[v]];\n            e.cap -= f;\n            graph[v][e.rev].cap += f;\n        }\n    }\n    return cost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int source = 0;\n    int sink = n * MAX_TIME + 1;\n    graph.resize(sink + 1);\n    dist.resize(sink + 1);\n    prevv.resize(sink + 1);\n    preve.resize(sink + 1);\n    \n    // Connect each node's last time layer to sink with capacity 100, cost 0\n    for (int i = 1; i <= n; ++i) {\n        add_edge((i - 1) * MAX_TIME + MAX_TIME, sink, 100, 0);\n    }\n    \n    // Connect source to starting positions at time 1\n    for (int i = 0; i < k; ++i) {\n        int v;\n        cin >> v;\n        add_edge(source, (v - 1) * MAX_TIME + 1, 1, 0);\n    }\n    \n    // Time progression edges within each node\n    for (int i = 1; i <= n; ++i) {\n        for (int t = 1; t < MAX_TIME; ++t) {\n            add_edge((i - 1) * MAX_TIME + t, (i - 1) * MAX_TIME + t + 1, 100, c);\n        }\n    }\n    \n    // Process bidirectional edges\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        for (int t = 1; t < MAX_TIME; ++t) {\n            for (int j = 1; j <= 20; ++j) {\n                int cost = c + (j * j - (j - 1) * (j - 1)) * d;\n                add_edge((u - 1) * MAX_TIME + t, (v - 1) * MAX_TIME + t + 1, 1, cost);\n                add_edge((v - 1) * MAX_TIME + t, (u - 1) * MAX_TIME + t + 1, 1, cost);\n            }\n        }\n    }\n    \n    cout << min_cost_flow(source, sink) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 0x3f3f3f3f\nMOD = 1000000007\nMAX_TIME = 100\nMAX_NODES = MAX_TIME * MAX_TIME\nMAX_EDGES = MAX_NODES * MAX_NODES\n\nclass Edge:\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    source = 0\n    sink = n * MAX_TIME + 1\n    graph = [[] for _ in range(sink + 1)]\n    dist = [INF] * (sink + 1)\n    prevv = [0] * (sink + 1)\n    preve = [0] * (sink + 1)\n    \n    def add_edge(from_node, to_node, cap, cost):\n        graph[from_node].append(Edge(to_node, cap, cost, len(graph[to_node])))\n        graph[to_node].append(Edge(from_node, 0, -cost, len(graph[from_node]) - 1))\n    \n    # Connect each node's last time layer to sink with capacity 100, cost 0\n    for i in range(1, n + 1):\n        add_edge((i - 1) * MAX_TIME + MAX_TIME, sink, 100, 0)\n    \n    # Connect source to starting positions at time 1\n    for _ in range(k):\n        v = int(data[idx]); idx += 1\n        add_edge(source, (v - 1) * MAX_TIME + 1, 1, 0)\n    \n    # Time progression edges within each node\n    for i in range(1, n + 1):\n        for t in range(1, MAX_TIME):\n            add_edge((i - 1) * MAX_TIME + t, (i - 1) * MAX_TIME + t + 1, 100, c)\n    \n    # Process bidirectional edges\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for t in range(1, MAX_TIME):\n            for j in range(1, 21):\n                cost = c + (j * j - (j - 1) * (j - 1)) * d\n                add_edge((u - 1) * MAX_TIME + t, (v - 1) * MAX_TIME + t + 1, 1, cost)\n                add_edge((v - 1) * MAX_TIME + t, (u - 1) * MAX_TIME + t + 1, 1, cost)\n    \n    def spfa(s, t):\n        for i in range(len(dist)):\n            dist[i] = INF\n        q = deque()\n        inq = [False] * (len(graph))\n        dist[s] = 0\n        q.append(s)\n        inq[s] = True\n        \n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for i in range(len(graph[u])):\n                e = graph[u][i]\n                if e.cap > 0 and dist[e.to] > dist[u] + e.cost:\n                    dist[e.to] = dist[u] + e.cost\n                    prevv[e.to] = u\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n        return dist[t] < INF\n    \n    def min_cost_flow(s, t):\n        flow = 0\n        cost = 0\n        while spfa(s, t):\n            f = INF\n            v = t\n            while v != s:\n                f = min(f, graph[prevv[v]][preve[v]].cap)\n                v = prevv[v]\n            flow += f\n            cost += dist[t] * f\n            v = t\n            while v != s:\n                e = graph[prevv[v]][preve[v]]\n                e.cap -= f\n                graph[v][e.rev].cap += f\n                v = prevv[v]\n        return cost\n    \n    print(min_cost_flow(source, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000169382052263245, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.006980318576097488, -0.0019183820113539696, -4.768370445162873e-07, -0.000232431106269359