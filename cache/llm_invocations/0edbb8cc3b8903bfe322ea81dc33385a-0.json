or (int i = 1; i <= n; ++i) {\n        if ((i & n) != i) continue;\n        int head = mx[i];\n        int tail = i ^ head;\n        for (int k = tail; ; k = (k - 1) & tail) {\n            int c1 = k + head, c2 = i ^ c1;\n            int uplim = min(K - 1, cnt[c2]);\n            long long coef = C(i, c1);\n            for (int j = 0; j <= uplim; ++j) {\n                dp[i][j + 1] = (dp[i][j + 1] + dp[c2][j] * coef) % mod;\n            }\n            if (!k) break;\n        }\n    }\n\n    long long res = 0;\n    int lim = min(cnt[n], K);\n    for (int j = 1; j <= lim; ++j) {\n        res = (res + dp[n][j] * C(K, j) % mod * fact[j]) % mod;\n    }\n    res = (modexp(K, n, mod) - res + mod) % mod;\n    cout << res << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static long modexp(long b, long e, int m) {\n        long r = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) r = (r * b) % m;\n            b = (b * b) % m;\n            e >>= 1;\n        }\n        return r;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] tokens = br.readLine().split(\" \");\n        int n = Integer.parseInt(tokens[0]);\n        int K = Integer.parseInt(tokens[1]);\n        int mod = Integer.parseInt(tokens[2]);\n\n        if ((n & 1) == 1) {\n            System.out.println(modexp(K, n, mod));\n            return;\n        }\n\n        long[] fact = new long[300010];\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = fact[i - 1] * i % mod;\n        }\n\n        long[] invfact = new long[300010];\n        invfact[n] = modexp(fact[n], mod - 2, mod);\n        for (int i = n - 1; i >= 0; --i) {\n            invfact[i] = invfact[i + 1] * (i + 1) % mod;\n        }\n\n        class Combinatorics {\n            long C(int nn, int kk) {\n                if (kk < 0 || kk > nn) return 0L;\n                return fact[nn] * invfact[kk] % mod * invfact[nn - kk] % mod;\n            }\n        }\n        Combinatorics comb = new Combinatorics();\n\n        int[] cnt = new int[300010];\n        int[] mx = new int[300010];\n        for (int i = 1; i <= n; ++i) {\n            mx[i] = i & (-i);\n            int t = i;\n            while (t != 0) {\n                cnt[i] += t & 1;\n                t >>= 1;\n            }\n        }\n\n        long[][] dp = new long[300010][20];\n        dp[0][0] = 1;\n\n        for (int i = 1; i <= n; ++i) {\n            if ((i & n) != i) continue;\n            int head = mx[i];\n            int tail = i ^ head;\n            for (int k = tail; ; k = (k - 1) & tail) {\n                int c1 = k + head;\n                int c2 = i ^ c1;\n                int uplim = Math.min(K - 1, cnt[c2]);\n                long coef = comb.C(i, c1);\n                for (int j = 0; j <= uplim; ++j) {\n                    dp[i][j + 1] = (dp[i][j + 1] + dp[c2][j] * coef) % mod;\n                }\n                if (k == 0) break;\n            }\n        }\n\n        long res = 0;\n        int lim = Math.min(cnt[n], K);\n        for (int j = 1; j <= lim; ++j) {\n            res = (res + dp[n][j] * comb.C(K, j) % mod * comb.C(K, j) % mod * fact[j]) % mod;\n        }\n        res = (modexp(K, n, mod) - res + mod) % mod;\n        System.out.println(res);\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00010525626566959545, -1.6689286894688848e-06, -4.768370445162873e-07, -0.0004166688595432788, -2.002696055569686e-05, -0.01255536638200283, -0.42943647503852844, -0.0013574680779129267, -1.0371154530730564e-05, -0.0003570872650016099, -0.00028427375946193933, -1.4066597032069694e-05, -2.0265558760002023e-06, -4.7205765440594405e-05, -0.001