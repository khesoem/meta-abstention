       if self.v >= MOD:\n            self.v -= MOD\n        return self\n\n    def __isub__(self, other):\n        self.v -= other.v\n        if self.v < 0:\n            self.v += MOD\n        return self\n\n    def __imul__(self, other):\n        self.v = (self.v * other.v) % MOD\n        return self\n\n    def __itruediv__(self, other):\n        return self.__imul__(other.inv())\n\n    def __add__(self, other):\n        res = Mint(self.v)\n        res += other\n        return res\n\n    def __sub__(self, other):\n        res = Mint(self.v)\n        res -= other\n        return res\n\n    def __mul__(self, other):\n        res = Mint(self.v)\n        res *= other\n        return res\n\n    def __truediv__(self, other):\n        res = Mint(self.v)\n        res /= other\n        return res\n\n    def __neg__(self):\n        return Mint(-self.v)\n\n    def __eq__(self, other):\n        return self.v == other.v\n\n    def __ne__(self, other):\n        return self.v != other.v\n\n    def inv(self):\n        a, b = self.v, MOD\n        x, y = 1, 0\n        while b:\n            t = a // b\n            a, b = b, a - t * b\n            x, y = y, x - t * y\n        return Mint(x if x >= 0 else x + MOD)\n\n    def pow(self, p):\n        if p < 0:\n            return self.inv().pow(-p)\n        a = Mint(1)\n        x = Mint(self.v)\n        while p:\n            if p & 1:\n                a *= x\n            x *= x\n            p >>= 1\n        return a\n\n    def __repr__(self):\n        return str(self.v)\n\ndef B(x, i):\n    return (x >> i) & 1\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    p = [[Mint(0) for _ in range(N)] for _ in range(N)]\n    inv100 = Mint(100).inv()\n    for i in range(N):\n        for j in range(N):\n            val = int(next(it))\n            p[i][j] = Mint(val) * inv100\n\n    cur = {1 << 0: Mint(1)}  # bitset with only bit 0 set\n    for i in range(N):\n     