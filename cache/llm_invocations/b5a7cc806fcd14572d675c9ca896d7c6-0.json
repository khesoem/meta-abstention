{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\nconst int INF = 0x3f3f3f3f;\nconst int T = 99;\nconst int C = 15;\n\nstruct Edge {\n    int to, rev;\n    ll cap, cost;\n};\n\nclass MinCostFlow {\npublic:\n    int n;\n    vector<vector<Edge>> g;\n    vector<ll> pot, dist;\n    vector<int> prevv, preve;\n\n    MinCostFlow(int n_) : n(n_), g(n_), pot(n_, 0), dist(n_), prevv(n_), preve(n_) {}\n\n    void add_edge(int from, int to, ll cap, ll cost) {\n        g[from].push_back({to, (int)g[to].size(), cap, cost});\n        g[to].push_back({from, (int)g[from].size() - 1, 0, -cost});\n    }\n\n    ll min_cost_flow(int s, int t, ll maxf) {\n        ll res = 0;\n        ll flow = 0;\n        while (flow < maxf) {\n            fill(dist.begin(), dist.end(), INF);\n            dist[s] = 0;\n            // Dijkstra with a binary heap implemented using vector and push_heap/pop_heap\n            vector<pair<ll,int>> heap;\n            heap.push_back({0, s});\n            push_heap(heap.begin(), heap.end(), greater<pair<ll,int>>());\n            while (!heap.empty()) {\n                pop_heap(heap.begin(), heap.end(), greater<pair<ll,int>>());\n                auto [d, v] = heap.back();\n                heap.pop_back();\n                if (dist[v] < d) continue;\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        heap.push_back({dist[e.to], e.to});\n                        push_heap(heap.begin(), heap.end(), greater<pair<ll,int>>());\n                    }\n                }\n            }\n            if (dist[t] >= INF) break;\n            for (int v = 0; v < n; ++v) pot[v] += dist[v];\n            ll add = maxf - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                add = min(add, g[prevv[v]][preve[v]].cap);\n            }\n            flow += add;\n            res += add * pot[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= add;\n                g[v][e.rev].cap += add;\n            }\n        }\n        return res;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0); cout.tie(0);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n    MinCostFlow mcf(n * T + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        mcf.add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        mcf.add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                mcf.add_edge(i + (t-1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            int cost = (j+1)*(j+1) - j*j;\n            for (int t = 1; t < T; ++t) {\n                mcf.add_edge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                mcf.add_edge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price = mcf.min_cost_flow(source, sink, k);\n    cout << price << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.BufferedReader;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.util.*;\n\npublic class Main {\n    private static final long INF = 0x3f3f3f3fL; // same as C++ INF for distances\n    private static final long INF_CAP = 0x3f3f3f3fL; // for capacities\n    private static final int T = 99;\n    private static final int C = 15;\n\n    static class Edge {\n        int to, rev;\n        long cap, cost;\n        Edge(int to, int rev, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MinCostFlow {\n        int n;\n        List<List<Edge>> g;\n        long[] pot, dist;\n        int[] prevv, preve;\n\n        MinCostFlow(int n_) {\n            n = n_;\n            g = new ArrayList<>(n_);\n            for (int i = 0; i < n_; i++) g.add(new ArrayList<>());\n            pot = new long[n_];\n            dist = new long[n_];\n            prevv = new int[n_];\n            preve = new int[n_];\n        }\n\n        void add_edge(int from, int to, long cap, long cost) {\n            g.get(from).add(new Edge(to, g.get(to).size(), cap, cost));\n            g.get(to).add(new Edge(from, g.get(from).size() - 1, 0, -cost));\n        }\n\n        long min_cost_flow(int s, int t, long maxf) {\n            long res = 0;\n            long flow = 0;\n            while (flow < maxf) {\n                Arrays.fill(dist, INF);\n                dist[s] = 0;\n                PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n                pq.offer(new long[]{0, s});\n                while (!pq.isEmpty()) {\n                    long[] top = pq.poll();\n                    long d = top[0];\n                    int v = (int) top[1];\n                    if (d > dist[v]) continue;\n                    for (int i = 0; i < g.get(v).size(); i++) {\n                        Edge e = g.get(v).get(i);\n                        if (e.cap > 0) {\n                            long nd = dist[v] + e.cost + pot[v] - pot[e.to];\n                            if (nd < dist[e.to]) {\n                                dist[e.to] = nd;\n                                prevv[e.to] = v;\n                                preve[e.to] = i;\n                                pq.offer(new long[]{nd, e.to});\n                            }\n                        }\n                    }\n                }\n                if (dist[t] >= INF) break;\n                for (int v = 0; v < n; v++) {\n                    if (dist[v] < INF) pot[v] += dist[v];\n                }\n                long add = maxf - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    add = Math.min(add, g.get(prevv[v]).get(preve[v]).cap);\n                }\n                flow += add;\n                res += add * pot[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.cap -= add;\n                    g.get(v).get(e.rev).cap += add;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int source = 0;\n        int sink = n * T + 1;\n        MinCostFlow mcf = new MinCostFlow(n * T + 2);\n\n        // read starting nodes\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int a = Integer.parseInt(st.nextToken());\n            mcf.add_edge(source, a, 1, 0);\n        }\n\n        // time expansion edges\n        for (int t = 0; t < T; t++) {\n            // from node 1 at time t to sink\n            mcf.add_edge(1 + t * n, sink, INF_CAP, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; i++) {\n                    mcf.add_edge(i + (t - 1) * n, i + t * n, INF_CAP, c);\n                }\n            }\n        }\n\n        // road edges\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int a = Integer.parseInt(st.nextToken());\n            int b = Integer.parseInt(st.nextToken());\n            for (int j = 0; j < C; j++) {\n                int cost = (j + 1) * (j + 1) - j * j; // = 2*j+1\n                long edgeCost = (long) cost * d + c;\n                for (int t = 1; t < T; t++) {\n                    mcf.add_edge(a + (t - 1) * n, b + t * n, 1, edgeCost);\n                    mcf.add_edge(b + (t - 1) * n, a + t * n, 1, edgeCost);\n                }\n            }\n        }\n\n        long price = mcf.min_cost_flow(source, sink, k);\n        System.out.println(price);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1457674503326416, -0.00010144196130568162, 0.0, -1.1920928244535389e-07, -5.6265202147187665e-05, -8.129743218887597e-05, -1.1920928244535389e-07, -0.07888985425233841, -2.578939437866211, -4.768