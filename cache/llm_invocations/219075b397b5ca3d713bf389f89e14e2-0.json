ntity_matrix(n):\n    I = [[0] * n for _ in range(n)]\n    for i in range(n):\n        I[i][i] = 1\n    return I\n\ndef compute():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    B = int(data[1])\n    dimension = B + 1\n    \n    # Precomputed matrices: 60 levels, B matrices per level\n    precomputed = [[None for _ in range(B)] for _ in range(60)]\n    \n    for b in range(B):\n        precomputed[0][b] = identity_matrix(dimension)\n        for i in range(dimension):\n            for j in range(dimension):\n                if i == j or b == i:\n                    precomputed[0][b][i][j] = 1\n    \n    for p in range(1, 60):\n        for b in range(B):\n            precomputed[p][b] = identity_matrix(dimension)\n            for k in range(B):\n                precomputed[p][b] = matrix_multiply(precomputed[p][b], precomputed[p-1][(b + k) % B])\n    \n    result = identity_matrix(dimension)\n    p = 0\n    step = 1\n    while step <= N // B:\n        p += 1\n        step *= B\n    \n    current_b = 0\n    while p >= 0:\n        repetitions = (N // step) % B\n        for r in range(repetitions):\n            result = matrix_multiply(result, precomputed[p][current_b])\n            current_b += 1\n            if current_b >= B:\n                current_b -= B\n        p -= 1\n        if p >= 0:\n            step //= B\n    \n    final_value = 0\n    for i in range(dimension):\n        final_value = (final_value + result[i][B]) % MOD\n    print(final_value)\n\nif __name__ == \"__main__\":\n    compute()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00021169328829273582, -4.768370445162873e-07, -1.1920928244535389e-07, -0.04933912679553032, -0.00010358751023886725, -0.04859437048435211, -0.051479607820510864, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -0.0015047191409394145, 0.0, -1.5497195136049413e-06, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -2.384185506798