       edge e = G[u][i];\n          if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n            q.emplace(-D[e.v], e.v);\n            PV[e.v] = u;\n            PE[e.v] = i;\n          }\n        }\n      }\n      if (D[t] == INF) return -1;\n      for (int i = 0; i < N; i++) H[i] += D[i];\n      long long d = f;\n      for (int i = t; i != s; i = PV[i]) {\n        d = min(d, G[PV[i]][PE[i]].c);\n      }\n      f -= d;\n      res += d * H[t];\n      for (int i = t; i != s; i = PV[i]) {\n        edge &e = G[PV[i]][PE[i]];\n        e.c -= d;\n        G[i][e.r].c += d;\n      }\n    }\n    return res;\n  }\n};\n\nint main() {\n  cin.tie(nullptr);\n  ios::sync_with_stdio(false);\n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  rep(i, K) cin >> A[i], A[i]--;\n  vector<int> us(M), vs(M);\n  rep(i, M) {\n    cin >> us[i] >> vs[i];\n    us[i]--;\n    vs[i]--;\n  }\n  mincostflow mcf(N*101+2);\n  int s = N*101;\n  int t = s + 1;\n  for (int i = 0; i < K; i++) {\n    mcf.add(s, A[i], 1, 0);\n  }\n  for (int i = 0; i <= 100; i++) {\n    mcf.add(N * i, t, K, C*i);\n  }\n  for (int i = 0; i < 100; i++) {\n    for (int j = 0; j < N; j++) {\n      mcf.add(i*N+j, (i+1)*N+j, K, 0);\n    }\n    for (int j = 0; j < M; j++) {\n      for (int k = 1; k <= K; k++) {\n        mcf.add(N*i + us[j], N*(i+1) + vs[j], 1, (2*k-1)*D);\n        mcf.add(N*i + vs[j], N*(i+1) + us[j], 1, (2*k-1)*D);\n      }\n    }\n  }\n  cout << mcf.run(s, t, K) << '\\n';\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nclass MincostFlow:\n    class Edge:\n        __slots__ = ('v', 'c', 'w', 'r')\n        def __init__(self, v, c, w, r):\n            self.v = v\n            self.c = c\n            self.w = w\n            self.r = r\n\n    def __init__(self, n):\n        self.G = [[] for _