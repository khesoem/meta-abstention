{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <algorithm>\n#include <string>\n#include <cstring>\n#include <vector>\n#include <queue>\n#include <limits>\n#include <utility>\n#include <iomanip>\n#include <cassert>\n#include <cmath>\n#include <map>\n#include <stack>\n#include <numeric>\n#include <set>\n\n#define endl '\\n'\nusing namespace std;\n\ntypedef long long ll;\n\nstruct Fraction {\n    ll a, b;\n};\n\npair<ll, ll> geta(int x, int y, int b) {\n    ll lower = (ll)b * x / y;\n    ll upper = ((ll)b * x + (y-1)) / y;\n    return {lower, upper};\n}\n\nint gcd(int a, int b) {\n    if (b == 0) return a;\n    return gcd(b, a % b);\n}\n\nvoid solve(int x, int y, int n) {\n    vector<Fraction> cands;\n    for (int b = 1; b <= n; b++) {\n        auto ap = geta(x, y, b);\n        cands.push_back({ap.first, b});\n        cands.push_back({ap.second, b});\n    }\n\n    auto comp = [&](Fraction fa, Fraction fb)-> bool {\n        ll a1 = fa.a;\n        ll b1 = fa.b;\n        ll a2 = fb.a;\n        ll b2 = fb.b;\n\n        ll left = abs(x * b1 * b2 - a1 * b2 * y);\n        ll right = abs(x * b1 * b2 - a2 * b1 * y);\n\n        if (left < right) return true;\n        else if (left > right) return false;\n\n        if (b1 < b2) return true;\n        else if (b1 > b2) return false;\n\n        if (a1 < a2) return true;\n        return false;\n    };\n\n    sort(cands.begin(), cands.end(), comp);\n\n    //cout << (double)x / y << endl;\n    //cout << comp({0, 1}, {2, 5}) << endl;\n    //for (auto f : cands) {\n    //    cout << f.a << \"/\" << f.b << \" \" << (double)f.a / f.b << endl;\n    //}\n\n    cout << cands.front().a << \"/\" << cands.front().b << endl;\n}\n\nint main(){\n    std::ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    int x, y, n;\n    cin >> x >> y >> n;\n\n    solve(x, y, n);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nfrom fractions import Fraction as PyFraction\n\ndef geta(x, y, b):\n    lower = (b * x) // y\n    upper = ((b * x) + (y - 1)) // y\n    return (lower, upper)\n\ndef solve(x, y, n):\n    cands = []\n    for b in range(1, n + 1):\n        ap = geta(x, y, b)\n        cands.append((ap[0], b))\n        cands.append((ap[1], b))\n    \n    def comp(fa):\n        a1, b1 = fa\n        # Create a key for sorting\n        # We want to sort by:\n        # 1. Absolute difference |x/b - a/b| = |x*b - a*y| / (b*y)\n        # Since denominator is positive, we can compare numerators: |x*b - a*y|\n        # But the original code uses |x*b1*b2 - a1*b2*y| vs |x*b1*b2 - a2*b1*y|\n        # This is equivalent to comparing |x/b - a1/y| vs |x/b - a2/y| scaled by b1*b2*y\n        # For sorting, we can use the absolute difference |x*b - a*y| as primary key\n        # Then b as secondary, then a as tertiary\n        diff = abs(x * b1 - a1 * y)\n        return (diff, b1, a1)\n    \n    # Sort using the comparison logic from the original code\n    # The original comp function compares two fractions fa and fb\n    # We'll use a custom comparator\n    def compare(fa, fb):\n        a1, b1 = fa\n        a2, b2 = fb\n        \n        # Calculate the absolute differences scaled by b1*b2\n        left = abs(x * b1 * b2 - a1 * b2 * y)\n        right = abs(x * b1 * b2 - a2 * b1 * y)\n        \n        if left < right:\n            return -1\n        elif left > right:\n            return 1\n        else:\n            if b1 < b2:\n                return -1\n            elif b1 > b2:\n                return 1\n            else:\n                if a1 < a2:\n                    return -1\n                elif a1 > a2:\n                    return 1\n                else:\n                    return 0\n    \n    from functools import cmp_to_key\n    cands.sort(key=cmp_to_key(compare))\n    \n    result = cands[0]\n    print(f\"{result[0]}/{result[1]}\")\n\nif __name__ == \"__main__\":\n    x, y, n = map(int, input().split())\n    solve(x, y, n)\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00011491115583339706, -9.536738616588991e-07, -1.1920928244535389e-07, -0.01623997651040554, -0.25235843658447266, -0.06224600970745087, -0.026319025084376335, -0.23563718795776367, -7.152555099310121e-07, -0.0012284121476113796, -0.07127366960048676, -0.03254103660583496, -0.0012540103634819388, -0.04644940420985222, -0.0011199399596080184, -0.012920002453029156, -2.7418097943154862e-06, -9.179073458653875e-06, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, 0.0, -9.536738616588991e-07, -1.1920928244535389e-07, -5.507317473529838e-05, -4.768370445162873e-07, -0.3484628200531006, -5.960462772236497e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -3.576278118089249e-07, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, -8.583032467868179e-06, -2.4318398573086597e-05, -4.6491513785440475e-06, -0.17976856231689453, -7.152555099310121e-07, -2.3841855067985307e-07, -8.344646857949556e-07, -9.63164638960734e-05, 0.0, -6.198863957251888e-06, -1.1920928244535389e-07, -1.