                for (int[] row : layer) {\n                        Arrays.fill(row, Integer.MAX_VALUE);\n                    }\n                }\n\n                for (int plus = MAXN; plus >= 0; plus--) {\n                    for (int minus = MAXN; minus >= 0; minus--) {\n                        for (int carry = 0; carry <= 2 * SHIFT; carry++) {\n                            int val = dp[plus][minus][carry];\n                            if (val == Integer.MAX_VALUE) continue;\n\n                            int realCarry = carry - SHIFT;\n                            int curN = plus - minus + realCarry;\n                            int curD = (curN % 10 + 10) % 10;\n                            int newCarry = (curN - curD) / 10;\n\n                            if (curD == digit) {\n                                int cost = plus + minus + val;\n                                nextDP[plus][minus][newCarry + SHIFT] = Math.min(nextDP[plus][minus][newCarry + SHIFT], cost);\n                            }\n\n                            if (plus + 1 <= MAXN) {\n                                nextDP[plus][minus][carry] = Math.min(nextDP[plus][minus][carry], dp[plus + 1][minus][carry]);\n                            }\n                            if (minus + 1 <= MAXN) {\n                                nextDP[plus][minus][carry] = Math.min(nextDP[plus][minus][carry], dp[plus][minus + 1][carry]);\n                            }\n                        }\n                    }\n                }\n\n                dp = nextDP;\n            }\n\n            int answer = Integer.MAX_VALUE;\n            for (int i = 0; i <= MAXN; i++) {\n                for (int j = 0; j <= MAXN; j++) {\n                    answer = Math.min(answer, dp[i][j][SHIFT]);\n                }\n            }\n            out.println(answer);\n        }\n    }\n\n    static class FastScanner extends BufferedReader {\n        public FastScanner(InputStream is) {\n            super(new InputStreamReader(is))