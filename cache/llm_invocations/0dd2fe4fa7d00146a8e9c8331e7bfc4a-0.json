.get(x, []):\n        if d.get(y, 0) != d.get(x, 0) + 1 or cap == 0:\n            continue\n        t = dinic(y, min(flow - total_flow, cap))\n        if t > 0:\n            # Update capacities\n            for edge in a[x]:\n                if edge[0] == y:\n                    edge[1] -= t\n            for edge in a[y]:\n                if edge[0] == x:\n                    edge[1] += t\n            total_flow += t\n            if total_flow == flow:\n                break\n    if total_flow == 0:\n        d[x] = -1\n    return total_flow\n\n# Main logic\n# Initialize variables\ntot = 1\nS = 0\nT = 1\nt = 1\n\n# Build initial graph\nfor i in range(n):\n    for j in range(n):\n        if '0' < ma_grid[i][j] <= '9':\n            p[i][j] = t + 1\n            add(S, p[i][j], int(ma_grid[i][j]))\n            t += 1\n        if '0' < mb_grid[i][j] <= '9':\n            s[i][j] = t + 1\n            add(s[i][j], T, int(mb_grid[i][j]))\n            t += 1\n\n# Compute dep using BFS from Z\nfor i in range(n):\n    for j in range(n):\n        if ma_grid[i][j] == 'Z':\n            bfs(i, j, False)\n\n# Copy dep to dis\nfor i in range(n):\n    for j in range(n):\n        dep[i][j] = dis[i][j]\n\n# Run BFS for each p[i][j]\nfor i in range(n):\n    for j in range(n):\n        if p[i][j]:\n            bfs(i, j, True)\n\n# Max flow calculation\nans = 0\nwhile build():\n    ans += dinic(S, float('inf'))\n\nprint(ans)\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.002006791764870286, -7.338466093642637e-05, -7.896309739408025e-07, -1.8074162653647363e-05, -0.3112120032310486, -0.040939345955848694, -0.0062262024730443954, -4.008129963040119e-06, -0.0709933191537857, -0.00026217024424113333, -2.9160102712921798e-05, -3.128163257315464e-07, 0.0, -0.2826305031776428, -0.071019746363163, -2.4153549020411447e-05, -0.02737947180867195, -0.00831384863704443, -4.4849443838757e-06, -0.17975039780139923, -0.0032144265715032816, -1.1472419600977446e-06, -4.961759