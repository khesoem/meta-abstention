on;\n            long total_flow = 0;\n            long min_cost = 0;\n            long[] flow = new long[1];\n            long[] cost = new long[1];\n\n            while (shortestPath(flow, cost)) {\n                total_flow += flow[0];\n                min_cost += flow[0] * cost[0];\n            }\n            return new long[]{total_flow, min_cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner cin = new Scanner(System.in);\n        int n = cin.nextInt();\n        int m = cin.nextInt();\n        int k = cin.nextInt();\n        int C = cin.nextInt();\n        int D = cin.nextInt();\n\n        MinCostMaxFlow g = new MinCostMaxFlow(n * MAX_T + 2);\n        int src_node = n * MAX_T;\n        int dst_node = n * MAX_T + 1;\n\n        for (int t = 0; t < MAX_T; ++t) {\n            g.connect(t, dst_node, k, (long) C * t);\n        }\n\n        for (int i = 0; i < k; ++i) {\n            int x = cin.nextInt();\n            --x;\n            g.connect(src_node, x * MAX_T, 1, 0);\n        }\n\n        for (int i = 0; i < n; ++i) {\n            for (int t = 1; t < MAX_T; ++t) {\n                g.connect(i * MAX_T + t - 1, i * MAX_T + t, k, 0);\n            }\n        }\n\n        while (m-- > 0) {\n            int u = cin.nextInt();\n            int v = cin.nextInt();\n            --u;\n            --v;\n\n            for (int t = 1; t < MAX_T; ++t) {\n                int edge1_from = u * MAX_T + t - 1;\n                int edge1_to = v * MAX_T + t;\n                int edge2_from = v * MAX_T + t - 1;\n                int edge2_to = u * MAX_T + t;\n\n                for (int idx = 1, price = D; idx <= k; ++idx, price += 2 * D) {\n                    g.connect(edge1_from, edge1_to, 1, (long) price);\n                    g.connect(edge2_from, edge2_to, 1, (long) price);\n                }\n            }\n        }\n\n        long[] ans = g.solve(src_node, dst_node);\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<conf