ue<int> q;\n        q.push(src);\n\n        while (!q.empty()) {\n            int node = q.front();\n            q.pop();\n            visited[node] = false;\n\n            for (int eid : adj[node]) {\n                Edge &e = edge_list[eid];\n                if (e.cap > e.flow && dist_arr[e.to] > dist_arr[node] + e.cost) {\n                    dist_arr[e.to] = dist_arr[node] + e.cost;\n                    parent_edge[e.to] = eid;\n                    bottleneck[e.to] = min(bottleneck[node], e.cap - e.flow);\n\n                    if (!visited[e.to]) {\n                        q.push(e.to);\n                        visited[e.to] = true;\n                    }\n                }\n            }\n        }\n\n        if (dist_arr[dst] == BIG) return false;\n\n        flow = bottleneck[dst];\n        cost_per_unit = dist_arr[dst];\n        int cur = dst;\n        while (cur != src) {\n            edge_list[parent_edge[cur]].flow += bottleneck[dst];\n            edge_list[parent_edge[cur] ^ 1].flow -= bottleneck[dst];\n            cur = edge_list[parent_edge[cur]].from;\n        }\n        return true;\n    }\n\n    pair<lint, lint> solve(int source, int destination) {\n        src = source;\n        dst = destination;\n        lint total_flow = 0;\n        lint min_cost = 0;\n        lint f, c;\n\n        while (shortest_path(f, c)) {\n            total_flow += f;\n            min_cost += f * c;\n        }\n        return {total_flow, min_cost};\n    }\n};\n\nint main() {\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MinCostMaxFlow g(n * MAX_T + 2);\n    int src_node = n * MAX_T;\n    int dst_node = n * MAX_T + 1;\n\n    for (int t = 0; t < MAX_T; ++t)\n        g.connect(t, dst_node, k, C * t);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        g.connect(src_node, x * MAX_T, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int t = 1; t < MAX_T; ++t)\n            g.connect(i * MAX_T + t - 1, i