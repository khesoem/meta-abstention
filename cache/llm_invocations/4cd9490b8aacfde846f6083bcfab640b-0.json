ew_val)\n            return self.factorial.get(n)\n\n        def fInv(self, n):\n            last_known = self.invFactorial.size() - 1\n            if last_known < n:\n                f_inv = []\n                f_inv.append(self.inv(self.fact(n)))\n                for i in range(1, n - last_known):\n                    f_inv.append(self.mult(f_inv[i - 1], n - i + 1))\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(f_inv[i])\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError(\"n must be non-negative\")\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = (r * x) % self.modulus()\n            return r\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise ValueError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n\n    def solve(self, testNumber, in_reader, out_writer):\n        n = in_reader.nextInt()\n        m = in_reader.nextInt()\n\n        self.mod.fInv(n + m)\n\n        phase_size = 1\n        p = 1\n        for i in range(n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, n - i, self.mod.smallInv(n + m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, n + 1):\n            num_phases = self.mod.mult(m + k, self.mod.smallInv(k))\n            term = self.mod.mult(self.mod.ncr(n, k), num_phases, phase_size)\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out_writer.println(answer)\n\n\ndef main():\n    input_reader = InputReader(sys.stdin)\n    output_writer = sys.stdout\n\n    solver = HZSShufflesCards()\n    solver.solve(1, input_reader, output_writer)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.427741704508662e-05, -7.152555099310121e-07, -5.960462772236497e-07, -0.0006317288498394191, -0.02356906421482563, -0.003935806918889284, -0.14270856976509094, -0.34540197253227234, -0.012841506861150265, -0.038732945919036865, -0.7971287965774536, -1.7881377516459906e-06, -4.291525328881107e-06, -1.9073304429184645e-05, -4.768370445162873e-07, -6.83045873302035e-05, -1.1920922133867862e-06, -3.576278118089249e-07, -2.145764938177308e-06, -4.768370445162873e-07, -2.3364747903542593e-05, -1.1086402082582936e-05, -2.0265558760002023e-06, -4.1483970562694594e-05, -9.023735765367746e-05, -2.3841855067985307e-07, -0.014127247966825962, -0.0007304860628210008, -3.4570634852570947e-06, -1.2874520507466514e-05, -0.0005106813623569906, -9.536697689327411e-06, -8.344646857949556e-07, -0.0002553137019276619, -0.021059593185782433, -2.3841855067985307e-07, -1.1920922133867862e-06, -0.00028046013903804123, -0.000162588257808238