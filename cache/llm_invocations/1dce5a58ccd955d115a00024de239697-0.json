nt sc) {\n    queue<pair<int, int>> q;\n    memset(dist, -1, sizeof(dist));\n    q.push({sr, sc});\n    dist[sr][sc] = 0;\n    while (!q.empty()) {\n        auto [r, c] = q.front(); q.pop();\n        for (int i = 0; i < 4; ++i) {\n            int nr = r + dr[i], nc = c + dc[i];\n            if (nr >= 0 && nr < GRID && nc >= 0 && nc < GRID &&\n                A[nr][nc] >= 0 && dist[nr][nc] == -1) {\n                dist[nr][nc] = dist[r][c] + 1;\n                q.push({nr, nc});\n            }\n        }\n    }\n}\n\nvoid bfs_propagate(int sr, int sc, int cnt, int T, int &nodeIdx) {\n    int vis[GRID][GRID];\n    queue<pair<int, int>> q;\n    memset(vis, -1, sizeof(vis));\n    q.push({sr, sc});\n    vis[sr][sc] = 0;\n    while (!q.empty()) {\n        auto [r, c] = q.front(); q.pop();\n        if (vis[r][c] > min(T, dist[r][c])) continue;\n        for (int e : exits[r][c]) {\n            for (int k = 0; k < cnt; ++k) {\n                graph[nodeIdx + k].push_back(e);\n            }\n        }\n        if (vis[r][c] == min(T, dist[r][c])) continue;\n        for (int i = 0; i < 4; ++i) {\n            int nr = r + dr[i], nc = c + dc[i];\n            if (nr >= 0 && nr < GRID && nc >= 0 && nc < GRID &&\n                A[nr][nc] >= 0 && vis[nr][nc] == -1) {\n                vis[nr][nc] = vis[r][c] + 1;\n                q.push({nr, nc});\n            }\n        }\n    }\n    nodeIdx += cnt;\n}\n\nint main() {\n    int n, T;\n    cin >> n >> T;\n    memset(A, -1, sizeof(A));\n    memset(B, -1, sizeof(B));\n    int sr = -1, sc = -1;\n\n    for (int i = 1; i <= n; ++i) {\n        string s;\n        getline(cin, s);\n        for (int j = 1; j <= n; ++j) {\n            char c = cin.get();\n            if (isdigit(c)) A[i][j] = c - '0';\n            if (c == 'Z') { sr = i; sc = j; }\n        }\n    }\n    cin.ignore();\n\n    bfs(sr, sc);\n\n    for (int i = 1; i <= n; ++i) {\n        string s;\n        getline(cin, s);\n        for (int j = 1; j <= n; ++j) {\n            char c = cin.get();\n            if (isdigit(c)) B[i][j] = c - '0';\n            for (int k = 0; k < B[i][j]; ++k) {\n                exits[i][j].push_back((int)exits[i][j].size());\n            }\n        }\n    }\n    cin.ignore();\n\n    for (int i = 0; i < GRID; ++i)\n        for (int j = 0; j < GRID; ++j)\n            if (dist[i][j] == -1) dist[i][j] = INF;\n\n    int nodeCount = 0;\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (A[i][j] > 0) bfs_propagate(i, j, A[i][j], T, nodeCount);\n\n    Hungarian solver;\n    cout << solver.solve(nodeCount, graph) << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 2000\nGRID = 12\nINF = 10**9\n\ndist = [[-1] * GRID for _ in range(GRID)]\nA = [[-1] * GRID for _ in range(GRID)]\nB = [[-1] * GRID for _ in range(GRID)]\ngraph = [[] for _ in range(MAXN)]\nexits = [[[] for _ in range(GRID)] for _ in range(GRID)]\n\ndr = [0, -1, 0, 1]\ndc = [1, 0, -1, 0]\n\nclass Hungarian:\n    def __init__(self):\n        self.matchCount = 0\n        self.matchL = [-1] * MAXN\n        self.matchR = [-1] * MAXN\n        self.seen = [False] * MAXN\n\n    def solve(self, n, adj):\n        self.matchCount = 0\n        self.matchL = [-1] * MAXN\n        self.matchR = [-1] * MAXN\n        for u in range(n):\n            self.seen = [False] * MAXN\n            if self.dfs(u, adj):\n                self.matchCount += 1\n        return self.matchCount\n\n    def dfs(self, u, adj):\n        for v in adj[u]:\n            if self.seen[v]:\n                continue\n            self.seen[v] = True\n            if self.matchR[v] == -1 or self.dfs(self.matchR[v], adj):\n                self.matchL[u] = v\n                self.matchR[v] = u\n                return True\n        return False\n\ndef bfs(sr, sc):\n    q = deque()\n    global dist\n    dist = [[-1] * GRID for _ in range(GRID)]\n    q.append((sr, sc))\n    dist[sr][sc] = 0\n    while q:\n        r, c = q.popleft()\n        for i in range(4):\n            nr = r + dr[i]\n            nc = c + dc[i]\n            if 0 <= nr < GRID and 0 <= nc < GRID and A[nr][nc] >= 0 and dist[nr][nc] == -1:\n                dist[nr][nc] = dist[r][c] + 1\n                q.append((nr, nc))\n\ndef bfs_propagate(sr, sc, cnt, T, nodeIdx):\n    global graph\n    vis = [[-1] * GRID for _ in range(GRID)]\n    q = deque()\n    q.append((sr, sc))\n    vis[sr][sc] = 0\n    while q:\n        r, c = q.popleft()\n        if vis[r][c] > min(T, dist[r][c]):\n            continue\n        for e in exits[r][c]:\n            for k in range(cnt):\n                graph[nodeIdx + k].append(e)\n        if vis[r][c] == min(T, dist[r][c]):\n            continue\n        for i in range(4):\n            nr = r + dr[i]\n            nc = c + dc[i]\n            if 0 <= nr < GRID and 0 <= nc < GRID and A[nr][nc] >= 0 and vis[nr][nc] == -1:\n                vis[nr][nc] = vis[r][c] + 1\n                q.append((nr, nc))\n    return nodeIdx + cnt\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    if not data:\n        return\n    \n    n, T = map(int, data[0].split())\n    global A, B, dist, exits\n    A = [[-1] * GRID for _ in range(GRID)]\n    B = [[-1] * GRID for _ in range(GRID)]\n    sr = -1\n    sc = -1\n    \n    line_idx = 1\n    for i in range(1, n + 1):\n        s = data[line_idx]\n        line_idx += 1\n        for j in range(1, n + 1):\n            if j <= len(s):\n                c = s[j-1]\n            else:\n                c = ' '\n            if c.isdigit():\n                A[i][j] = int(c)\n            if c == 'Z':\n                sr = i\n                sc = j\n    \n    bfs(sr, sc)\n    \n    for i in range(1, n + 1):\n        s = data[line_idx]\n        line_idx += 1\n        for j in range(1, n + 1):\n            if j <= len(s):\n                c = s[j-1]\n            else:\n                c = ' '\n            if c.isdigit():\n                B[i][j] = int(c)\n            for k in range(B[i][j]):\n                exits[i][j].append(len(exits[i][j]))\n    \n    for i in range(GRID):\n        for j in range(GRID):\n            if dist[i][j] == -1:\n                dist[i][j] = INF\n    \n    nodeCount = 0\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if A[i][j] > 0:\n                nodeCount = bfs_propagate(i, j, A[i][j], T, nodeCount)\n    \n    solver = Hungarian()\n    print(solver.solve(nodeCount, graph))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00011872540198964998, -1.6689286894688848e-06, -1.1920928244535389e-07, -0.012801256962120533, -0.001321038813330233, -7.152555099310121e-07, -0.00020585325546562672, -0.00025138078490272164, -8.344646857949556e-07, -0.00019524575327523053, -0.006863588932901621, -0.060325123369693756, -2.7418097943154862e-06, 0.0, 0.0, -1.311301275563892e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.50339189733495e-06, -8.344646857949556e-07, -3.349725011503324e-05, -0.00023278864682652056, 0.0, -2.622600959512056e-06, -1.311301275563892e-06, -1.6689286894688848e-06, -2.1815061700181104e-05, -1.7881377516459906e-06, -0.0337226502597332, 0.0, -7.688703772146255e-05, -0.00018070495571009815, -3.576278118089249e-07, -5.483612312673358e-06, -0.1257174164056778, -0.0005445189890451729, -3.635817120084539e-05, -0.0017043125117197633, -2.3841855067985307e-07, -0.16552984714508057, -8.22540732769994e-06, -1.1801649634435307e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -6.6756979322235566e-06, -0.00014232576359063387, -4.529942543740617e-06, -1.5497195136049413e-06, -2.145764938177308e-06, -0.0008173224050551653, -5.960462772236497e-07, -7.033323527139146e-06, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -1.919251189974