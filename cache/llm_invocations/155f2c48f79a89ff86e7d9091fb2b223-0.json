\nint main(int argc, char **argv) {\n    precompute();\n    ll n;\n    cin >> n;\n    priority_queue<pair<int, ll>, vector<pair<int, ll>>, greater<pair<int, ll>>> pq;\n    pq.push({0, n});\n    while (pq.top().second != 0) {\n        int cost = pq.top().first;\n        ll val = pq.top().second;\n        pq.pop();\n        if (visited.find(val) != visited.end())\n            continue;\n        visited.insert(val);\n        for (step next : {lower(val), upper(val), uupper(val)}) {\n            ll nval = abs(val - next.val);\n            int ncost = cost + next.cost;\n            pq.push({ncost, nval});\n        }\n    }\n    cout << pq.top().first << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static List<Long> repunits = new ArrayList<>();\n    static Set<Long> visited = new HashSet<>();\n\n    static void precompute() {\n        long r = 0;\n        while (r <= 1_000_000_000_000_000_000L) {\n            r = r * 10 + 1;\n            repunits.add(r);\n        }\n    }\n\n    static Step uupper(long n) {\n        int idx = lowerBound(repunits, n);\n        long val = repunits.get(idx);\n        int cost = idx + 1;\n        return new Step(val, cost);\n    }\n\n    static Step upper(long n) {\n        int idx = upperBound(repunits, n) - 1;\n        if (idx < 0) idx = 0; // should not happen for n >= 1\n        long base = repunits.get(idx);\n        int baseCost = idx + 1;\n        long res = base;\n        int cost = baseCost;\n        while (res < n) {\n            res += base;\n            cost += baseCost;\n        }\n        return new Step(res, cost);\n    }\n\n    static Step lower(long n) {\n        int idx = upperBound(repunits, n) - 1;\n        if (idx < 0) idx = 0;\n        long base = repunits.get(idx);\n        int baseCost = idx + 1;\n        long res = base;\n   