{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following PyPy 3 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original PyPy 3 code you have to translate:\n<original_code>\nfrom functools import lru_cache\r\nimport itertools\r\ndef invnum(seq):\r\n    N=len(seq)\r\n    res=0\r\n    for i in range(N):\r\n        for j in range(i+1,N):\r\n            if seq[i]>seq[j]:\r\n                res+=1\r\n    return res\r\ndef naive(N,k,flag):\r\n    res=0\r\n    for p in itertools.permutations(range(N),N):\r\n        for q in itertools.permutations(range(N),N):\r\n            if ((p<q) or (not(flag))) and (invnum(p)-invnum(q)>k):\r\n                res+=1\r\n    return res\r\nn,mod=map(int,input().split())\r\nmemo=[[{},{}] for _ in range(n+1)]\r\ndef solve(N,k,flag):\r\n    if k in memo[N][flag]:\r\n        return memo[N][flag][k]\r\n    '''\r\n    \u9577\u3055N\u306e\u9806\u5217\r\n    invnum(p)-invnum(q)>k\u3068\u306a\u308b\u5834\u5408\u306e\u6570\r\n    flag=True p<q\u306e\u6761\u4ef6\u3042\u308a\r\n    flag=False p<q\u306e\u6761\u4ef6\u306a\u3057\r\n    '''\r\n    if N==1:\r\n        res=-1\r\n        if flag:\r\n            res=0\r\n        else:\r\n            if k<0:\r\n                res=1\r\n            else:\r\n                res=0\r\n        memo[N][flag][k]=res\r\n        return res\r\n    invnum_INF=(N*(N-1))//2\r\n    if k<-invnum_INF-1:\r\n        res=solve(N,-invnum_INF-1,flag)\r\n        memo[N][flag][k]=res\r\n        return res\r\n    if k>=invnum_INF:\r\n        memo[N][flag][k]=0\r\n        return 0\r\n    res=0\r\n\r\n    for delta in range(-N+1,N):\r\n        if flag and (delta>0):\r\n            continue\r\n        wt=min(N-delta,delta+N)\r\n        res+=solve(N-1,k-delta,(delta==0)&flag)*wt\r\n        res%=mod\r\n    memo[N][flag][k]=res%mod\r\n    return res%mod\r\nans=solve(n,0,1)%mod\r\nprint(ans)\r\n\r\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "#include <bits/stdc++.h>\nusing namespace std;\n\nint invnum(const std::vector<int>& seq) {\n    int N = seq.size();\n    int res = 0;\n    for (int i = 0; i < N; ++i) {\n        for (int j = i + 1; j < N; ++j) {\n            if (seq[i] > seq[j]) {\n                res++;\n            }\n        }\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, mod;\n    cin >> n >> mod;\n\n    // Initialize memoization structure: vector of size n+1, each element is array of two unordered_maps\n    std::vector<std::array<std::unordered_map<int, int>, 2>> memo(n + 1);\n    \n    // Recursive function with memoization\n    std::function<int(int, int, bool)> solve = [&](int N, int k, bool flag) -> int {\n        int flag_idx = flag ? 1 : 0;\n        if (memo[N][flag_idx].count(k)) {\n            return memo[N][flag_idx][k];\n        }\n        int res;\n        if (N == 1) {\n            res = -1;\n            if (flag) {\n                res = 0;\n            } else {\n                if (k < 0) {\n                    res = 1;\n                } else {\n                    res = 0;\n                }\n            }\n            memo[N][flag_idx][k] = res;\n            return res;\n        }\n        int invnum_INF = (N * (N - 1)) / 2;\n        if (k < -invnum_INF - 1) {\n            res = solve(N, -invnum_INF - 1, flag);\n            memo[N][flag_idx][k] = res;\n            return res;\n        }\n        if (k >= invnum_INF) {\n            memo[N][flag_idx][k] = 0;\n            return 0;\n        }\n        res = 0;\n        for (int delta = -N + 1; delta < N; ++delta) {\n            if (flag && delta > 0) continue;\n            int wt = std::min(N - delta, delta + N);\n            int next_flag = (delta == 0) && flag;\n            res += (long long)solve(N - 1, k - delta, next_flag) * wt;\n            res %= mod;\n        }\n        memo[N][flag_idx][k] = res % mod;\n        return res % mod;\n    };\n\n    int ans = solve(n, 0, true) % mod;\n    cout << ans << \"\\n\";\n\n    return 0;\n}\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.004192013759166002, -3.35706390615087e-05, -0.03806604817509651, -1.7432603272027336e-06, -1.3306015716807451e-05, -5.512236498361744e-07, -0.019423851743340492, -0.0001422770437784493, -1.1472419600977446e-06, -1.9361264946837764e-07, -0.003218349302187562, -0.0618874616920948, -0.07541102170944214, -3.607391408877447e-05, -0.004651792347431183, -0.42872846126556396, -7.3458322731312364e-06, -1.0087516784551553e-05, -5.512236498361744e-07, -0.005234713666141033, -2.451116051815916e-05, -0.007108075078576803, -2.129266067640856e-05, -7.302704761968926e-05, -0.00010568885772954673, -0.009786666370928288, -0.016605034470558167, -0.2564241886138916, 0.0, -0.008849618956446648, -1.6240566083070007e-06, -3.1424973713001236e-05, -7.636475493200123e-05, -0.007610532455146313, -0.00010902655776590109, 0.0, -1.9146995327901095e-05, -2.1008713702030946e-06, -2.5776860184123507e-06, -0.03365077078342438, -3.173704271830502e-06, -1.9361264946837764e-07, -0.02630401775240898, -7.493430894101039e-05, -1.9361264946837764e-07, -3.7697225252486533e-06, -1.2664456789934775e-06, -3.03521392197581e-05, -5.512236498361744e-07, -1.1041145626222715e-05, -