     permute(arr, k + 1, result);\n            Collections.swap(arr, k, i);\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        int n = val();\n        int[] items = li();\n        int rock1 = items[0], sci1 = items[1], paper1 = items[2];\n        items = li();\n        int rock2 = items[0], sci2 = items[1], paper2 = items[2];\n\n        int min = minimum(rock1, sci1, paper1, rock2, sci2, paper2);\n        int max = maximum(rock1, sci1, paper1, rock2, sci2, paper2);\n        System.out.println(min + \" \" + max);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.072883e-06, 0.0, 0.0, -0.00015293382, -0.0002512616, -3.7311813e-05, -0.061988454, -0.0025097798, -1.4305105e-06, -4.76836e-06, -1.2956327, -0.47417128, -0.0001349358, -0.0007136897, -0.41287142, -0.40282878, -6.2344516e-05, 0.0, -0.00047386385, -0.002527735, -0.0011803096, -0.013948694, -0.026437918, -1.5028741, -0.029000998, -5.960463e-07, -3.81469e-06, -1.5497195e-06, -8.344647e-07, 0.0, -0.4748156, -0.22549883, -0.47409412, -0.0088560665, -0.03576636, -0.16182281, -0.0072661657, -1.1920928e-07, -1.1920928e-07, -1.1920928e-07, -1.9073468e-06, -3.576278e-07, 0.0, -0.029756203, -0.006715941, -1.6689287e-06, -0.00089879165, -9.655906e-06, -0.033219084, -1.1920922e-06, -0.014554874, -3.110009, -0.015028234, -0.03712372, -0.0019367049, -0.07888975, -0.00015877417, -1.1920928e-07, -0.00021729493, -7.521823e-05, -1.1920928e-07, -1.5497195e-06, -2.3841855e-07, 0.0, -4.7683704e-07, -1.1920928e-07, 0.0, -8.344647e-07, -0.014164506, -0.2014148, -0.20173685, -9.5367386e-07, -0.0011724511, 0.0, 0.0, 0.0, -1.1920922e-06, 0.0, -1.3133821, -4.7683704e-07, -1.072883e-06, -1.1920928e-07, 0.0, 0.0, 0.0, -2.0265559e-06, -1.072883e-06, -0.0067158225, 0.0, -1.1920922e-06, -0.0012030514, -0.062410325, -1.5497195e-06, -2.3841855e-07, 0.0, -1.072883e-06, -0.0011703077, 0.0, -8.344647e-07, 0.0, 0.0, -4.7683704e-07, -5.3644035e-06, -1.4305105e-06, -0.0