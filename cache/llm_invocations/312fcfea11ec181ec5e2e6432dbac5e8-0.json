urr2 = 0\n    # print(l1, l2)\n    while l1 or l2:\n        try:\n            if 0 == curr1:curr1 = l1.pop()\n            if 0 == curr2:curr2 = l2.pop()\n        except:return ans\n\n        ans += max(0, min(curr1[0], curr2[0]) * match(curr1[1], curr2[1]))\n        # print(curr1, curr2)\n        if curr1[0] < curr2[0]:\n            curr2[0] -= curr1[0]\n            curr1 = 0\n        elif curr1[0] > curr2[0]:\n            curr1[0] -= curr2[0]\n            curr2 = 0\n        else:curr1 = curr2 = 0\n    # print(\"ANS FOR THIS : \", ans)\n    return ans    \n\n\n\n\n\n\n\n\ndef minimum():\n    ans = n\n    l = [[rock1, 1], [sci1, 2], [paper1, 3]]\n    l1 = [list(i) for i in list(permutations(l))]\n    l = [[rock2, 1], [sci2, 2], [paper2, 3]]\n    l2 = [list(i) for i in list(permutations(l))]\n\n\n    ans = float('inf')\n    for i in l1:\n        for j in l2:\n            mylist1 = [temp[:] for temp in i]\n            mylist2 = [temp[:] for temp in j]\n            ans = min(ans, give(mylist1, mylist2))\n\n    \n    return ans\n\n\n\nprint(minimum(), maximum())\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.lang.*;\nimport java.io.*;\nimport java.math.*;\n\npublic class Main {\n    static final int MOD = 998244353;\n    static final long mod = 998244353;\n\n    public static long inv_mod(long n) {\n        return BigInteger.valueOf(n).modPow(BigInteger.valueOf(mod - 2), BigInteger.valueOf(mod)).longValue();\n    }\n\n    public static List<Long> factors(long n) {\n        Set<Long> set = new TreeSet<>();\n        for (long i = 1; i * i <= n; i++) {\n            if (n % i == 0) {\n                set.add(i);\n                set.add(n / i);\n            }\n        }\n        return new ArrayList<>(set);\n    }\n\n    public static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        String nextLine() {\n            String str = \"\";\n            try {\n                str = br.readLine();\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n            return str;\n        }\n\n        int[] readIntArray() {\n            String[] tokens = nextLine().split(\" \");\n            int[] arr = new int[tokens.length];\n            for (int i = 0; i < tokens.length; i++) {\n                arr[i] = Integer.parseInt(tokens[i]);\n            }\n            return arr;\n        }\n    }\n\n    public static int match(int a, int b) {\n        if (a == b) return 0;\n        else if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n        else return -1;\n    }\n\n    public static int give(ArrayList<ArrayList<Integer>> l1, ArrayList<ArrayList<Integer>> l2) {\n        int ans = 0;\n        int[] curr1 = null;\n        int[] curr2 = null;\n        while (!l1.isEmpty() || !l2.isEmpty()) {\n            try {\n                if (curr1 == null) {\n                    ArrayList<Integer> temp = l1.remove(l1.size()-1);\n                    curr1 = new int[]{temp.get(0), temp.get(1)};\n                }\n                if (curr2 == null) {\n                    ArrayList<Integer> temp = l2.remove(l2.size()-1);\n                    curr2 = new int[]{temp.get(0), temp.get(1)};\n                }\n            } catch (Exception e) {\n                return ans;\n            }\n\n            int m = match(curr1[1], curr2[1]);\n            ans += Math.max(0, Math.min(curr1[0], curr2[0]) * m);\n            if (curr1[0] < curr2[0]) {\n                curr2[0] -= curr1[0];\n                curr1 = null;\n            } else if (curr1[0] > curr2[0]) {\n                curr1[0] -= curr2[0];\n                curr2 = null;\n            } else {\n                curr1 = null;\n                curr2 = null;\n            }\n        }\n        return ans;\n    }\n\n    public static int maximum(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        return Math.min(rock1, sci2) + Math.min(sci1, paper2) + Math.min(paper1, rock2);\n    }\n\n    public static int minimum(int n, int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        int ans = n;\n        int[][] base1 = {{rock1, 1}, {sci1, 2}, {paper1, 3}};\n        int[][] base2 = {{rock2, 1}, {sci2, 2}, {paper2, 3}};\n\n        List<int[][]> perms1 = permute(base1);\n        List<int[][]> perms2 = permute(base2);\n\n        ans = Integer.MAX_VALUE;\n        for (int[][] p1 : perms1) {\n            for (int[][] p2 : perms2) {\n                ArrayList<ArrayList<Integer>> l1 = new ArrayList<>();\n                ArrayList<ArrayList<Integer>> l2 = new ArrayList<>();\n                for (int[] arr : p1) {\n                    l1.add(new ArrayList<>(Arrays.asList(arr[0], arr[1])));\n                }\n                for (int[] arr : p2) {\n                    l2.add(new ArrayList<>(Arrays.asList(arr[0], arr[1])));\n                }\n                ans = Math.min(ans, give(l1, l2));\n            }\n        }\n        return ans;\n    }\n\n    public static List<int[][]> permute(int[][] arr) {\n        List<int[][]> result = new ArrayList<>();\n        permuteHelper(arr, 0, result);\n        return result;\n    }\n\n    private static void permuteHelper(int[][] arr, int index, List<int[][]> result) {\n        if (index == arr.length) {\n            int[][] copy = new int[arr.length][2];\n            for (int i = 0; i < arr.length; i++) {\n                copy[i] = arr[i].clone();\n            }\n            result.add(copy);\n            return;\n        }\n        for (int i = index; i < arr.length; i++) {\n            swap(arr, index, i);\n            permuteHelper(arr, index + 1, result);\n            swap(arr, index, i);\n        }\n    }\n\n    private static void swap(int[][] arr, int i, int j) {\n        int[] temp = arr[i];\n        arr[i] = arr[j];\n        arr[j] = temp;\n    }\n\n    public static void main(String[] args) {\n        FastReader fr = new FastReader();\n        int n = fr.nextInt();\n        int[] vals1 = fr.readIntArray();\n        int rock1 = vals1[0], sci1 = vals1[1], paper1 = vals1[2];\n        int[] vals2 = fr.readIntArray();\n        int rock2 = vals2[0], sci2 = vals2[1], paper2 = vals2[2];\n\n        int max = maximum(rock1, sci1, paper1, rock2, sci2, paper2);\n        int min = minimum(n, rock1, sci1, paper1, rock2, sci2, paper2);\n        System.out.println(min + \" \" + max);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-3.576278e-07, 0.0, 0.0, -8.225103e-05, -0.00022694873, -1.5020258e-05, -0.048610948, -0.0025035962, -1.072883e-06, -1.7881378e-06, -4.197998, -0.0029208877, -2.264974e-06, -5.960463e-07, -0.043505996, -0.31330776, -6.2940526e-05, -0.0001596085, -0.38687733, -0.6941778, -0.00046516565, -3.576278e-07, -0.00048577905, -0.0054749306, -0.0040914644, -0.06885731, -0.027390752, -0.31329215, -0.040602777, -1.3113013e-06, -2.1576649e-05, -5.960463e-07, -1.6689287e-06, 0.0, -0.11290828, -0.6931789, -0.011542445, -1.184619, -0.39962238, -0.1915119, -8.4635016e-05, -0.03804876, -3.576278e-07, 0.0, 0.0, -1.4151788, -8.821448e-06, -1.3164473, 0.0, -0.7530838, -0.24292886, -0.07893469, -5.4836123e-06, -0.00016139635, -0.00076955743, -0.0015023384, -1.1920928e-07, -7.