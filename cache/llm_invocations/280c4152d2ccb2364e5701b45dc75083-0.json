m * 2)\n        self.m = 0\n\n    def link(self, u, v, c, w):\n        h = self.m\n        self.m += 1\n        self.uu[h] = u\n        self.vv[h] = v\n        self.uv[h] = u ^ v\n        self.cost[h] = w\n        self.cap[h << 1] = c\n        self.adj[u].append(h << 1)\n        self.adj[v].append(h << 1 | 1)\n\n    def enqueue(self, v):\n        if self.inq[v]:\n            return\n        self.qq[self.tail] = v\n        self.tail += 1\n        if self.tail == len(self.qq):\n            self.tail = 0\n        self.inq[v] = True\n\n    def dequeue(self):\n        u = self.qq[self.head]\n        self.head += 1\n        if self.head == len(self.qq):\n            self.head = 0\n        self.inq[u] = False\n        return u\n\n    def spfa(self, s, t):\n        self.pi = [INF] * self.n\n        self.pi[s] = 0\n        self.head = 0\n        self.tail = 0\n        self.enqueue(s)\n        while self.head != self.tail:\n            u = self.dequeue()\n            d = self.dd[u] + 1\n            for h_ in self.adj[u]:\n                if self.cap[h_] > 0:\n                    h = h_ >> 1\n                    p = self.pi[u] + (self.cost[h] if (h_ & 1) == 0 else -self.cost[h])\n                    v = u ^ self.uv[h]\n                    if self.pi[v] > p or (self.pi[v] == p and self.dd[v] > d):\n                        self.pi[v] = p\n                        self.dd[v] = d\n                        self.bb[v] = h_\n                        self.enqueue(v)\n        return self.pi[t] != INF\n\n    def push1(self, s, t):\n        u = t\n        while u != s:\n            h_ = self.bb[u]\n            h = h_ >> 1\n            self.cap[h_] -= 1\n            self.cap[h_ ^ 1] += 1\n            u ^= self.uv[h]\n\n    def edmonds_karp(self, s, t):\n        while self.spfa(s, t):\n            self.push1(s, t)\n        flow = 0\n        for h in range(self.m):\n            flow += self.cost[h] * self.cap[h << 1 | 1]\n        return flow\n\n    def solve(self):\n        data = list(map(int, sys.stdin.buffer.read().split()))\n        it = iter(data)\n        N = next(it)\n        M = next(it)\n        K = next(it)\n        C = next(it)\n        D = next(it)\n\n        start = [next(it) - 1 for _ in range(K)]\n\n        graph = [[] for _ in range(N)]\n        for _ in range(M):\n            a = next(it) - 1\n            b = next(it) - 1\n            graph[a].append(b)\n            graph[b].append(a)\n\n        T = N + K + 1\n        self.n = N * T + 1\n        self.m = K + (M * 2 * K + N) * (T - 1)\n        self.init()\n\n        # edges for original graph\n        for i in range(N):\n            for s in range(T - 1):\n                u = i * T + s\n                for j in graph[i]:\n                    v = j * T + s + 1\n                    for x in range(1, K + 1):\n                        self.link(u, v, 1, C + (x * 2 - 1) * D)\n\n        # stay edges\n        for i in range(N):\n            for s in range(T - 1):\n                u = i * T + s\n                v = u + 1\n                self.link(u, v, K, 0 if i == 0 else C)\n\n        # source to start positions\n        for h in range(K):\n            self.link(self.n - 1, start[h] * T, 1, 0)\n\n        result = self.edmonds_karp(self.n - 1, 0 * T + T - 1)\n        sys.stdout.write(str(result))\n\nif __name__ == \"__main__\":\n    CF1187G().solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.4066597032069694e-05, -1.1920928244535389e-07, 0.0, -0.00012051333033014089, -0.00016175392374861985, -3.576278118089249e-07, -0.20150162279605865, -0.4986220598220825, -1.1920928244535389e-07, -2.3007127310847864e-05, -0.00010084597306558862, 0.0, -2.3841855067985307e-07, -0.00043108707177452743, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.9073468138230965e-06, -8.344646857949556e-07, -0.0008045773720368743, -0.16025131940841675, -0.006410511676222086, -4.625213477993384e-05, 0.0, -3.099436753473128e-06, -2.253030106658116e-05, -1.907