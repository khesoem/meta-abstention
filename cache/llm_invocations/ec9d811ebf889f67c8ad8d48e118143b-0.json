   int v = Q.begin()->second;\n        Q.erase(Q.begin());\n        for (int i = 0; i < (int)Adj[v].size(); i++) {\n            int id = Adj[v][i];\n            Edge &e = Edges[id];\n            if (e.cap == e.flow) continue;\n            int to = e.to;\n            ll w = e.cost + Pot[v] - Pot[to];\n            if (Dist[v] + w < Dist[to]) {\n                Q.erase({Dist[to], to});\n                Dist[to] = Dist[v] + w;\n                Parent[to] = id;\n                Q.insert({Dist[to], to});\n            }\n        }\n    }\n}\n\npair<ll, ll> MCMF(int s, int t) {\n    FordBellman(s, 50);\n    Dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (true) {\n        if (Dist[t] == INF) break;\n        ll pushed = INF, sum = 0;\n        for (int v = t; v != s; v = Edges[Parent[v]].from) {\n            pushed = min(pushed, Edges[Parent[v]].cap - Edges[Parent[v]].flow);\n            sum += Edges[Parent[v]].cost;\n        }\n        flow += pushed;\n        cost += pushed * sum;\n        for (int v = t; v != s; v = Edges[Parent[v]].from) {\n            int id = Parent[v];\n            Edges[id].flow += pushed;\n            Edges[id ^ 1].flow -= pushed;\n        }\n        Dijkstra(s);\n        copy(Dist, Dist + N, Pot);\n    }\n    return {cost, flow};\n}\n\nvoid Solve() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnt(n, 0);\n    for (int i = 0; i < k; i++) {\n        int a;\n        cin >> a;\n        cnt[--a]++;\n    }\n    for (int i = 0; i < n; i++) AddEdge(5000, i, cnt[i], 0);\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        u--, v--;\n        for (int j = 0; j < 99; j++) {\n            ll cost = d;\n            for (int t = 0; t < 50; t++) {\n                AddEdge(u + j * 50, v + (j + 1) * 50, 1, cost);\n                AddEdge(v + j * 50, u + (j + 1) * 50, 1, cost);\n                cost += 2 * d;\n            }\n        }\n    }\n    for (int i = 0; i <= 99; i++) AddEdge(0 + i * 50, 5001