 }\n    }\n}\n\nvoid BFS2(int sr, int sc)\n{\n    for (int i = 0; i < Maxn; i++) for (int j = 0; j < Maxn; j++) dist[i][j] = Inf;\n    dist[sr][sc] = 0;\n    for (int i = 0; i < Maxn; i++) for (int j = 0; j < Maxn; j++) pos[i][j] = false;\n    pos[sr][sc] = true;\n    queue <ii> Q; Q.push(ii(sr, sc));\n    while (!Q.empty()) {\n        ii v = Q.front(); int d = dist[v.first][v.second]; Q.pop();\n        pos[v.first][v.second] = d <= bum[v.first][v.second];\n        if (d >= bum[v.first][v.second]) continue;\n        for (int i = 0; i < Maxd; i++) {\n            ii u = ii(v.first + dy[i], v.second + dx[i]);\n            if (0 <= u.first && u.first < n && 0 <= u.second && u.second < n && a[u.first][u.second] != 'Y' && d + 1 < dist[u.first][u.second])\n                dist[u.first][u.second] = d + 1, Q.push(u);\n        }\n    }\n}\n\nvoid BFS(int sr, int sc, int dist[][Maxn], int Inf)\n{\n    for (int i = 0; i < Maxn; i++) for (int j = 0; j < Maxn; j++) dist[i][j] = Inf;\n    dist[sr][sc] = 0;\n    queue <ii> Q; Q.push(ii(sr, sc));\n    while (!Q.empty()) {\n        ii v = Q.front(); int d = dist[v.first][v.second]; Q.pop();\n        for (int i = 0; i < Maxd; i++) {\n            ii u = ii(v.first + dy[i], v.second + dx[i]);\n            if (0 <= u.first && u.first < n && 0 <= u.second && u.second < n && a[u.first][u.second] != 'Y' && d + 1 < dist[u.first][u.second])\n                dist[u.first][u.second] = d + 1, Q.push(u);\n        }\n    }\n}\n\nint getFlow()\n{\n    fill(F, F + N, 0); F[0] = Inf;\n    priority_queue <ii> Q; Q.push(ii(Inf, 0));\n    while (!Q.empty()) {\n        int v = Q.top().second, f = Q.top().first; Q.pop();\n        if (F[v] != f) continue;\n        for (int i = 0; i < (int)neigh[v].size(); i++) {\n            int u = neigh[v][i];\n            if (min(f, R[v][u]) > F[u]) F[u] = min(f, R[v][u]), P[u] = v, Q.push(ii(F[u], u));\n        }\n    }\n    int v = N - 1;\n    if (F[v] == 0) return 0;\n    int res = F[v];\n    while (v) {\n        int u = P[v];\n        R[u][v] -= res; R[v][u] += res;\n        v = u;\n    }\n    return res;\n}\n\nint main()\n{\n    scanf(\"%d %d\", &n, &t);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < n; j++) {\n            scanf(\" %c\", &a[i][j]);\n            if (a[i][j] == 'Z') { br = i; bc = j; }\n        }\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < n; j++)\n            scanf(\" %c\", &b[i][j]);\n    BFS1();\n    N = 2 * n * n + 2;\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < n; j++) if (isdigit(a[i][j]) && a[i][j] > '0') {\n            int v = i * n + j + 1; R[0][v] = a[i][j] - '0'; neigh[0].push_back(v); neigh[v].push_back(0);\n            BFS2(i, j);\n            for (int i2 = 0; i2 < n; i2++)\n                for (int j2 = 0; j2 < n; j2++) if (pos[i2][j2] && isdigit(b[i2][j2]) && b[i2][j2] > '0') {\n                    int u = n * n + i2 * n + j2 + 1; R[v][u] = Inf; neigh[v].push_back(u); neigh[u].push_back(v);\n                }\n        }\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < n; j++) if (isdigit(b[i][j]) && b[i][j] > '0') {\n            int u = n * n + i * n + j + 1; R[u][N - 1] = b[i][j] - '0'; neigh[u].push_back(N - 1); neigh[N - 1].push_back(u);\n        }\n    int f;\n    while ((f = getFlow()) != 0) res += f;\n    printf(\"%d\\n\", res);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\nimport heapq\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    t = int(data[idx]); idx += 1\n    \n    a = [['' for _ in range(n)] for _ in range(n)]\n    b = [['' for _ in range(n)] for _ in range(n)]\n    \n    br, bc = 0, 0\n    for i in range(n):\n        for j in range(n):\n            a[i][j] = data[idx]; idx += 1\n            if a[i][j] == 'Z':\n                br, bc = i, j\n    \n    for i in range(n):\n        for j in range(n):\n            b[i][j] = data[idx]; idx += 1\n    \n    # BFS1: compute bum array\n    Inf = 1000000000\n    Maxn = 11\n    Maxd = 4\n    dy = [-1, 0, 1, 0]\n    dx = [0, -1, 0, 1]\n    \n    bum = [[t for _ in range(Maxn)] for _ in range(Maxn)]\n    bum[br][bc] = 0\n    Q = deque()\n    Q.append((br, bc))\n    \n    while Q:\n        v = Q.popleft()\n        d = bum[v[0]][v[1]]\n        for i in range(Maxd):\n            u = (v[0] + dy[i], v[1] + dx[i])\n            if 0 <= u[0] < n and 0 <= u[1] < n and a[u[0]][u[1]] != 'Y' and d + 1 < bum[u[0]][u[1]]:\n                bum[u[0]][u[1]] = d + 1\n                Q.append(u)\n    \n    # BFS2 function\n    def BFS2(sr, sc):\n        dist = [[Inf for _ in range(Maxn)] for _ in range(Maxn)]\n        pos = [[False for _ in range(Maxn)] for _ in range(Maxn)]\n        dist[sr][sc] = 0\n        pos[sr][sc] = True\n        Q = deque()\n        Q.append((sr, sc))\n        \n        while Q:\n            v = Q.popleft()\n            d = dist[v[0]][v[1]]\n            pos[v[0]][v[1]] = d <= bum[v[0]][v[1]]\n            if d >= bum[v[0]][v[1]]:\n                continue\n            for i in range(Maxd):\n                u = (v[0] + dy[i], v[1] + dx[i])\n                if 0 <= u[0] < n and 0 <= u[1] < n and a[u[0]][u[1]] != 'Y' and d + 1 < dist[u[0]][u[1]]:\n                    dist[u[0]][u[1]] = d + 1\n                    Q.append(u)\n        return dist, pos\n    \n    # Build graph for max flow\n    N = 2 * n * n + 2\n    R = [[0 for _ in range(N)] for _ in range(N)]\n    neigh = [[] for _ in range(N)]\n    \n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit() and a[i][j] > '0':\n                v = i * n + j + 1\n                R[0][v] = ord(a[i][j]) - ord('0')\n                neigh[0].append(v)\n                neigh[v].append(0)\n                \n                dist, pos = BFS2(i, j)\n                for i2 in range(n):\n                    for j2 in range(n):\n                        if pos[i2][j2] and b[i2][j2].isdigit() and b[i2][j2] > '0':\n                            u = n * n + i2 * n + j2 + 1\n                            R[v][u] = Inf\n                            neigh[v].append(u)\n                            neigh[u].append(v)\n    \n    for i in range(n):\n        for j in range(n):\n            if b[i][j].isdigit() and b[i][j] > '0':\n                u = n * n + i * n + j + 1\n                R[u][N - 1] = ord(b[i][j]) - ord('0')\n                neigh[u].append(N - 1)\n                neigh[N - 1].append(u)\n    \n    # Max flow using Dijkstra-like algorithm (similar to Edmonds-Karp but with priority queue)\n    F = [0] * N\n    P = [0] * N\n    res = 0\n    \n    def getFlow():\n        F = [0] * N\n        F[0] = Inf\n        P = [0] * N\n        Q = []\n        heapq.heappush(Q, (-Inf, 0))  # Use negative for max-heap behavior\n        \n        while Q:\n            f, v = heapq.heappop(Q)\n            f = -f\n            if F[v] != f:\n                continue\n            for u in neigh[v]:\n                if min(f, R[v][u]) > F[u]:\n                    F[u] = min(f, R[v][u])\n                    P[u] = v\n                    heapq.heappush(Q, (-F[u], u))\n        \n        v = N - 1\n        if F[v] == 0:\n            return 0\n        flow = F[v]\n        while v:\n            u = P[v]\n            R[u][v] -= flow\n            R[v][u] += flow\n            v = u\n        return flow\n    \n    f = getFlow()\n    while f != 0:\n        res += f\n        f = getFlow()\n    \n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002087136817863211, -1.311301275563892e-06, -8.344646857949556e-07, -0.0055837612599134445, -0.0012263881508260965, -2.3841855067985307e-07, -0.011048685759305954, -0.0008015995263122022, -4.768370445162873e-07, -0.0001935771433636546, -0.033