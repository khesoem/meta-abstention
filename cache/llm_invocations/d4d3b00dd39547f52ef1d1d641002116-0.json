lated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long INF = Long.MAX_VALUE / 2;\n    static final int N = 50;\n    static int n, m, k, c, d, mxt;\n    static int s, t, fn;\n    static ArrayList<ArrayList<Edge>> graph;\n    static long[] dist, h;\n    static int[] prevv, preve;\n\n    static class Edge {\n        int to, rev;\n        long cap, cost;\n        Edge(int to, int rev, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static void addEdge(int from, int to, long cap, long cost) {\n        graph.get(from).add(new Edge(to, graph.get(to).size(), cap, cost));\n        graph.get(to).add(new Edge(from, graph.get(from).size() - 1, 0, -cost));\n    }\n\n    static boolean dijkstra() {\n        Arrays.fill(dist, INF);\n        dist[s] = 0;\n        PriorityQueue<long[]> pq = new PriorityQueue<>((a, b) -> Long.compare(a[0], b[0]));\n        pq.offer(new long[]{0, s});\n        while (!pq.isEmpty()) {\n            long[] cur = pq.poll();\n            long d = cur[0];\n            int u = (int) cur[1];\n            if (dist[u] < d) continue;\n            for (int i = 0; i < graph.get(u).size(); i++) {\n                Edge e = graph.get(u).get(i);\n                if (e.cap > 0) {\n                    long nd = d + e.cost + h[u] - h[e.to];\n                    if (dist[e.to] > nd) {\n                        dist[e.to] = nd;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        pq.offer(new long[]{nd, e.to});\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n\n    static long minCostMaxFlow() {\n        h = new long[fn];\n        long flow = 0, cost = 0;\n        while (dijkstra()) {\n            long f = INF;\n            for (int u = t; u != s; u = prevv[u]) {\n                f = Math.min(f, graph.get(prevv[u]).get(preve[u]).cap);\n            }\n            for (int u = t; u != s; u = prevv[u]) {\n                Edge e = graph.get(prevv[u]).get(preve[u]);\n                e.cap -= f;\n                graph.get(e.to).get(e.rev).cap += f;\n            }\n            flow += f;\n            cost += (dist[t] + h[t]) * f;\n            for (int u = 0; u < fn; u++) {\n                if (dist[u] < INF) h[u] += dist[u];\n            }\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        mxt = N * 3 + 1;\n        s = n * mxt;\n        t = s + 1;\n        fn = t + 1;\n        graph = new ArrayList<>(fn);\n        for (int i = 0; i < fn; i++) graph.add(new ArrayList<>());\n        dist = new long[fn];\n        prevv = new int[fn];\n        preve = new int[fn];\n\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt() - 1;\n            addEdge(s, u, 1, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int i2 = 0; i2 < mxt - 1; i2++) {\n                for (int p = 1; p <= k; p++) {\n                    long cost = 2L * d * p - d;\n                    addEdge(i2 * n + u, (i2 + 1) * n + v, 1, cost);\n                    addEdge(i2 * n + v, (i2 + 1) * n + u, 1, cost);\n                }\n            }\n        }\n        for (int u = 0; u < n; u++) {\n            for (int i = 0; i < mxt - 1; i++) {\n                addEdge(i * n + u, (i + 1) * n + u, k, 0);\n            }\n        }\n        for (int i = 0; i < mxt; i++) {\n            addEdge(i * n, t, k, (long) i * c);\n        }\n        long ans = minCostMaxFlow();\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.4570634852570947e-0