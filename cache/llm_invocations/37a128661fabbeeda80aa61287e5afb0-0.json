\n            for (int i = head[u]; i != 0; i = edges[i].next) {\n                int v = edges[i].target;\n                if (edges[i].cap > 0 && dist[v] > dist[u] + edges[i].cost) {\n                    dist[v] = dist[u] + edges[i].cost;\n                    flowToNode[v] = Math.min(flowToNode[u], edges[i].cap);\n                    lastEdge[v] = i;\n                    predecessor[v] = u;\n                    if (!inQueue[v]) {\n                        inQueue[v] = true;\n                        queueObj.add(v);\n                    }\n                }\n            }\n        }\n        return flowToNode[sink];\n    }\n\n    static int n, m, k, C, D;\n    static int[][] locationPlan = new int[105][105];\n    static int[][] state = new int[105][105];\n    static class Route {\n        int from, to;\n        Route(int from, int to) {\n            this.from = from;\n            this.to = to;\n        }\n    }\n    static Route[] routes = new Route[105];\n\n    static int NODE(int x, int y) {\n        return x * n + y;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        k = scanner.nextInt();\n        C = scanner.nextInt();\n        D = scanner.nextInt();\n        source = NODE(n + k, n) + 1;\n        sink = source + 2;\n\n        addEdge(NODE(0, 1), sink, INF, 0);\n\n        for (int i = 1; i <= k; ++i) {\n            int port = scanner.nextInt();\n            addEdge(source, NODE(0, port), 1, 0);\n        }\n\n        for (int i = 1; i <= m; ++i) {\n            int from = scanner.nextInt();\n            int to = scanner.nextInt();\n            routes[i * 2] = new Route(from, to);\n            routes[i * 2 - 1] = new Route(to, from);\n        }\n        m <<= 1;\n\n        for (int day = 1; day <= n + k; ++day) {\n            for (int i = 1; i <= n; ++i)\n                addEdge(NODE(day - 1, i), NODE(day, i), INF, 0);\n            for (int i = 1; i <= m; ++i) {\n                addEdge(NODE(day - 1, routes[i].from), NODE(day, routes[i].to), 1, D);\n                locationPlan[day][i] = edgeCount;\n                state[day][i] = 1;\n            }\n            addEdge(NODE(day, 1), sink, INF, day * C);\n        }\n\n        int augment;\n        int totalCost = 0;\n        while ((augment = spfa()) > 0) {\n            int node = sink;\n            while (node != source) {\n                int prevNode = predecessor[node];\n                edges[lastEdge[node]].cap -= augment;\n                edges[lastEdge[node] ^ 1].cap += augment;\n                node = prevNode;\n            }\n            totalCost += dist[sink] * augment;\n\n            for (int day = 1; day <= n + n; ++day)\n                for (int i = 1; i <= m; ++i)\n                    if (edges[locationPlan[day][i]].cap > 0) {\n                        state[day][i]++;\n                        addEdge(NODE(day - 1, routes[i].from), NODE(day, routes[i].to), 1, D * (state[day][i] * 2 - 1));\n                        locationPlan[day][i] = edgeCount;\n                    }\n        }\n\n        System.out.println(totalCost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018261195509694517, -1.6689286894688848e-06, -1.5497195136049413e-06, -0.003853991162031889, -3.683499380713329e-05, -0.014165329746901989, -0.04876162111759186, -2.1576648578047752e-05, -2.3841855067985307e-07, -6.329813186312094e-05, -0.005234227981418371, -2.753696753643453e-05, -0.005785149987787008, -0.04920363426208496, -2.145764938177308e-06, -4.541770613286644e-05, -2.5510462364763953e-05, 0.0, 0.0, -3.3378546504536644e-06, -2.3841855067985307e-07, -9.619726915843785e-05, -5.722029527532868e-06, -8.940656698541716e-06, 0.0, -7.629365427419543e-06, -4.172316494077677e-06, -9.536738616588991e-07, -6.389413465512916e-05, -9.65590606938349e-06, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, -1.7881377516459906e-06, -3.45