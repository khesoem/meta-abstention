push_back(i);\n            else if (s[i] == 'K') kPos.push_back(i);\n            else otherPos.push_back(i);\n        }\n\n        int V = vPos.size(), K = kPos.size(), O = otherPos.size();\n        int dp[2][81][81][81];\n        for (int a = 0; a < 2; a++)\n            for (int b = 0; b <= V; b++)\n                for (int c = 0; c <= K; c++)\n                    for (int d = 0; d <= O; d++)\n                        dp[a][b][c][d] = INF;\n\n        dp[0][0][0][0] = 0;\n\n        for (int v = 0; v <= V; v++) {\n            for (int k = 0; k <= K; k++) {\n                for (int o = 0; o <= O; o++) {\n                    for (int last = 0; last < 2; last++) {\n                        int cur = dp[last][v][k][o];\n                        if (cur == INF) continue;\n                        if (v < V) {\n                            dp[1][v+1][k][o] = min(dp[1][v+1][k][o], cur + count(vPos[v], k, kPos) + count(vPos[v], o, otherPos));\n                        }\n                        if (k < K && last == 0) {\n                            dp[0][v][k+1][o] = min(dp[0][v][k+1][o], cur + count(kPos[k], v, vPos) + count(kPos[k], o, otherPos));\n                        }\n                        if (o < O) {\n                            dp[0][v][k][o+1] = min(dp[0][v][k][o+1], cur + count(otherPos[o], v, vPos) + count(otherPos[o], k, kPos));\n                        }\n                    }\n                }\n            }\n        }\n\n        return min(dp[0][V][K][O], dp[1][V][K][O]);\n    }\n\n    int stupid(vector<char>& s) {\n        string st(s.begin(), s.end());\n        queue<string> q;\n        unordered_map<string, int> dist;\n        q.push(st);\n        dist[st] = 0;\n        while (!q.empty()) {\n            st = q.front(); q.pop();\n            int cur = dist[st];\n            if (st.find(\"VK\") == string::npos) return cur;\n            for (int pos = 0; pos < (int)st.size() - 1; pos++) {\n                string next = st.substr(0, pos) + st[pos+1] + st[pos]