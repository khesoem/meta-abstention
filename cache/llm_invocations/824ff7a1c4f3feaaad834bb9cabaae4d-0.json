n                start = true;\n                neg = true;\n            } else if (c >= '0' && c <= '9') {\n                start = true;\n                ans = ans * 10 + (c - '0');\n            } else if (start) {\n                break;\n            }\n        }\n        return neg ? -ans : ans;\n    }\n\n    long readLong() {\n        long ans = 0;\n        bool neg = false;\n        char c;\n        bool start = false;\n        while (cin.get(c)) {\n            if (c == '-') {\n                start = true;\n                neg = true;\n            } else if (c >= '0' && c <= '9') {\n                start = true;\n                ans = ans * 10 + (c - '0');\n            } else if (start) {\n                break;\n            }\n        }\n        return neg ? -ans : ans;\n    }\n\n    string readString() {\n        string b;\n        char c;\n        bool start = false;\n        while (cin.get(c)) {\n            if (isalnum(c) || c == '?') {\n                start = true;\n                b.push_back(c);\n            } else if (start) {\n                break;\n            }\n        }\n        return b;\n    }\n\n    long solve(long x, long y, int v1, int v2) {\n        long diff = abs(x - y);\n        if (diff - ch[v1][R] * ch[v2][R] > best) return 0;\n        long key = x * 10000 + v1 * 100 + v2;\n        auto it = cache.find(key);\n        if (it != cache.end()) return it->second;\n\n        if (v1 < R || v2 < R) {\n            int sum = v1 + v2;\n            if (v1 >= cntA[sum] && v2 >= cntB[sum]) {\n                int new_v1 = v1 - cntA[sum];\n                int new_v2 = v2 - cntB[sum];\n                return ch[new_v1 + new_v2][new_v1];\n            }\n            return 0;\n        }\n\n        long ans = 0;\n        char c = str[v1 + v2 - 1];\n        if (c != 'B') {\n            long cur = ch[v1][R] - ch[v1 - 1][R];\n            long other = ch[v2][R];\n            ans += solve(x, y + cur * other, v1 - 1, v2);\n        }\n        if (c != 'A') {\