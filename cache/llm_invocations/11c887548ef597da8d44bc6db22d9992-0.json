 }\n\n        int[][][][] dp = new int[3][countV + 1][countK + 1][countE + 1];\n        for (int[][][] plane : dp) {\n            for (int[][] row : plane) {\n                for (int[] col : row) {\n                    Arrays.fill(col, Integer.MAX_VALUE / 2);\n                }\n            }\n        }\n        dp[2][0][0][0] = 0;\n\n        int[][][][] positions = new int[3][countV + 1][countK + 1][countE + 1];\n        for (int i = 0; i <= countV; i++) {\n            for (int j = 0; j <= countK; j++) {\n                for (int k = 0; k <= countE; k++) {\n                    for (int t = 0; t < 3; t++) {\n                        positions[t][i][j][k] = locate(sequence, i, j, k, t);\n                    }\n                }\n            }\n        }\n\n        for (int i = 0; i <= countV; i++) {\n            for (int j = 0; j <= countK; j++) {\n                for (int k = 0; k <= countE; k++) {\n                    if (i + 1 <= countV && positions[0][i][j][k] != -1) {\n                        int val = positions[0][i][j][k];\n                        dp[0][i + 1][j][k] = Math.min(dp[0][i + 1][j][k], val + dp[2][i][j][k]);\n                        dp[0][i + 1][j][k] = Math.min(dp[0][i + 1][j][k], val + dp[1][i][j][k]);\n                        dp[0][i + 1][j][k] = Math.min(dp[0][i + 1][j][k], val + dp[0][i][j][k]);\n                    }\n                    if (j + 1 <= countK && positions[1][i][j][k] != -1) {\n                        int val = positions[1][i][j][k];\n                        dp[1][i][j + 1][k] = Math.min(dp[1][i][j + 1][k], val + dp[2][i][j][k]);\n                        dp[1][i][j + 1][k] = Math.min(dp[1][i][j + 1][k], val + dp[1][i][j][k]);\n                    }\n                    if (k + 1 <= countE && positions[2][i][j][k] != -1) {\n                        int val = positions[2][i][j][k];\n                        dp[2][i][j][k + 1] = Math.min(dp[2][i][j][k + 1], val + dp[0][i][j][k]);\n                        dp[2][i][j][k + 1] = Math.min(dp[2][i][j][k + 1], val + dp[1][i][j][k]);\n                        dp[2][i][j][k + 1] = Math.min(dp[2][i][j][k + 1], val + dp[2][i][j][k]);\n                    }\n                }\n            }\n        }\n\n        int ans = Math.min(dp[0][countV][countK][countE],\n                Math.min(dp[1][countV][countK][countE], dp[2][countV][countK][countE]));\n        writer.println(ans);\n    }\n\n    int locate(char[] seq, int needV, int needK, int needE, int t) {\n        int idx = 0;\n        for (char ch : seq) {\n            if (ch == 'V') {\n                if (needV == 0) {\n                    if (t == 0) return idx;\n                    idx++;\n                } else {\n                    needV--;\n                }\n            } else if (ch == 'K') {\n                if (needK == 0) {\n                    if (t == 1) return idx;\n                    idx++;\n                } else {\n                    needK--;\n                }\n            } else {\n                if (needE == 0) {\n                    if (t == 2) return idx;\n                    idx++;\n                } else {\n                    needE--;\n                }\n            }\n        }\n        return -1;\n    }\n\n    private int nextByte() {\n        try {\n            return inputStream.read();\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    private boolean isWhitespace(int c) {\n        return c < 33 || c > 126;\n    }\n\n    private int advance() {\n        int c;\n        while ((c = nextByte()) != -1 && isWhitespace(c));\n        return c;\n    }\n\n    private String nextToken() {\n        int c = advance();\n        StringBuilder sb = new StringBuilder();\n        while (!isWhitespace(c)) {\n            sb.appendCodePoint(c);\n            c = nextByte();\n        }\n        return sb.toString();\n    }\n\n    private char[] nextCharArray(int length) {\n        char[] arr = new char[length];\n        int c = advance(), i 