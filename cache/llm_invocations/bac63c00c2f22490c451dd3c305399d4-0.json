l.get(n)\n\n        def fInv(self, n):\n            last_known = self.invFactorial.size() - 1\n            if last_known < n:\n                f_inv = [0.0] * (n - last_known)\n                f_inv[0] = self.inv(self.fact(n))\n                for i in range(1, len(f_inv)):\n                    f_inv[i] = self.mult(f_inv[i - 1], n - i + 1)\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(int(f_inv[i]))\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_reader, out):\n        self.n = in_reader.nextInt()\n        self.m = in_reader.nextInt()\n\n        self.mod.fInv(self.n + self.m)\n\n        phase_size = 1\n        p = 1\n        for i in range(self.n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, self.n - i, self.mod.smallInv(self.n + self.m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, self.n + 1):\n            num_phases = self.mod.mult(self.m + k, self.mod.smallInv(k))\n            e = self.mod.mult(num_phases, phase_size)\n            term = self.mod.mult(self.mod.ncr(self.n, k), e)\n\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out.println(answer)\n\n\ndef main():\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out = outputStream\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out)\n    outputStream.flush()\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-6.437094270950183e-05, -9.536738616588991e-07, -3.576278118089249e-07, -0.002220309805124998, -0.01450564619153738, -0.007516318466514349, -0.12697498500347137, -0.23129628598690033, -0.012648244388401508, -0.0389782153069973, -0.8742194175720215, -1.6689286894688848e-06, -5.960446742392378e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -0.0001662831346038729, -1.0728830375228426e-06, -3.576278118089249e-07, -2.264974000354414e-06, -3.576278118089249e-07, -3.8265450712060556e-05, -1.0847986231965479e-05, -2.145764938177308e-06, -9.417489309271332e-06, -8.415821503149346e-05, -2.3841855067985307e-07, -0.017491135746240616, -0.00024101213784888387, -1.9073468138230965e-06, -1.585470999998506e-05, -0.000448