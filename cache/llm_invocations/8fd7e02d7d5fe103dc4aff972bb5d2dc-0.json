/2) && !(cnta == n/2);\n            if (ok) {\n                cnta++;\n                msum -= rsc2[n/2 - cnta] * rsc[n/2 - cntb];\n            } else {\n                cntb++;\n                msum += rsc2[n/2 - cntb] * rsc[n/2 - cnta];\n            }\n        }\n        msum = Math.abs(msum);\n        \n        mm.put(new Pair(0, 0), 1L);\n        \n        for (int i = n-1; i >= 2*r-1; --i) {\n            nm.clear();\n            for (Map.Entry<Pair, Long> entry : mm.entrySet()) {\n                Pair p = entry.getKey();\n                long sum = p.first;\n                long ncnt = entry.getValue();\n                int cnt = p.second;\n                int ast = n/2 - cnt;\n                int bst = i + 1 - ast;\n                long asum = sum + rsc2[ast-1] * rsc[bst];\n                long bsum = sum - rsc2[bst-1] * rsc[ast];\n                \n                if (s[i] == 'A') {\n                    Pair newPair = new Pair(asum, cnt+1);\n                    nm.put(newPair, nm.getOrDefault(newPair, 0L) + ncnt);\n                } else if (s[i] == 'B') {\n                    Pair newPair = new Pair(bsum, cnt);\n                    nm.put(newPair, nm.getOrDefault(newPair, 0L) + ncnt);\n                } else {\n                    Pair pairA = new Pair(asum, cnt+1);\n                    nm.put(pairA, nm.getOrDefault(pairA, 0L) + ncnt);\n                    Pair pairB = new Pair(bsum, cnt);\n                    nm.put(pairB, nm.getOrDefault(pairB, 0L) + ncnt);\n                }\n            }\n            nsum -= lsc[i];\n            mm.clear();\n            for (Map.Entry<Pair, Long> entry : nm.entrySet()) {\n                Pair p = entry.getKey();\n                long sum = p.first;\n                long ncnt = entry.getValue();\n                int cnt = p.second;\n                int ast = n/2 - cnt;\n                int bst = i - ast;\n                if (cnt > n/2 || (i - cnt) > n/2) continue;\n                if (sum < -msum - rsc[ast]*rsc[bst] || sum > msum + rsc[ast]*rsc[bst]) continue;\n                mm.put(new Pair(sum, cnt), mm.getOrDefault(new Pair(sum, cnt), 0L) + ncnt);\n            }\n        }\n        \n        long bsum = Long.MAX_VALUE;\n        for (Map.Entry<Pair, Long> entry : mm.entrySet()) {\n            bsum = Math.min(bsum, Math.abs(entry.getKey().first));\n        }\n        \n        long rasp = 0;\n        for (Map.Entry<Pair, Long> entry : mm.entrySet()) {\n            Pair p = entry.getKey();\n            long sum = p.first;\n            long ncnt = entry.getValue();\n            int cnt = p.second;\n            if (sum == bsum || sum == -bsum) {\n                int sem = 0;\n                for (int j = 0; j < 2*r-1; ++j) {\n                    if (s[j] == '?') sem++;\n                    else if (s[j] == 'A') cnt++;\n                }\n                ncnt *= comb(sem, n/2 - cnt);\n                rasp += ncnt;\n            }\n        }\n        \n        System.out.println(rasp);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000164018536452204, -2.50339189733495e-06, -7.152555099310121e-07, -0.0005438040825538337, -1.8954096958623268e-05, -0.018630515784025192, -0.6932501792907715, -0.00599159300327301, -2.4199192921514623e-05, -0.00016497205069754273, -0.00020680672605521977, -3.433168603805825e-05, -4.768370445162873e-07, -9.405170567333698e-05, -0.004622962791472673, -3.707340147229843e-05, -0.014673646539449692, -0.00015948931104503572, -0.002738299546763301, -7.152555099310121e-07, 0.0, -3.2186455882765586e-06, -9.536738616588991e-07, -2.622600959512056e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920922133867862e-06, -1.6689286894688848e-06, -2.3841830625315197e-06, -1.6689286894688848e-06, -1.0728830375228426e-06, -5.125986263010418e-06, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -1.5139465176616795e-05, -1.3470558769768104e-05