{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\n#ifdef Adrian\n#include \"debug.h\"\n#else\n#define debug(...) 9999\n#endif\n\nusing ll = long long;\nusing ld = long double;\nusing pii = pair<ll, ll>;\ntemplate <typename G>\nstruct triple { G F, S, T; };\n\nstruct UnionFind {\n    vector<int> root;\n    vector<int> rank;\n    int numComponents;\n    UnionFind(int n) : root(n), rank(n, 0), numComponents(n) {\n        iota(root.begin(), root.end(), 0);\n    }\n    int find(int x) {\n        if (root[x] != x) root[x] = find(root[x]);\n        return root[x];\n    }\n    bool merge(int x, int y) {\n        int rx = find(x), ry = find(y);\n        if (rx == ry) return false;\n        if (rank[rx] < rank[ry]) swap(rx, ry);\n        numComponents -= (rank[rx] > 0 && rank[ry] > 0);\n        numComponents += (rank[rx] == 0 && rank[ry] == 0);\n        root[ry] = rx;\n        rank[rx] += (rank[rx] == rank[ry]);\n        return true;\n    }\n};\n\nint main() {\n#ifdef Adrian\n    //freopen(\"test.txt\", \"r\", stdin);\n#else\n    std::ios::sync_with_stdio(false); std::cin.tie(nullptr); std::cout.tie(nullptr);\n#endif\n\n    const int MOD = 1000000007;\n    int p, k;\n    std::cin >> p >> k;\n\n    int res = 1;\n    if (k == 0) {\n        for (int i = 0; i < p - 1; ++i)\n            res = (ll)res * p % MOD;\n    } else {\n        UnionFind uf(p);\n        for (int i = 0; i < p; ++i)\n            uf.merge(i, (ll)k * i % p);\n        int compCount = (k > 1) ? uf.numComponents : p - uf.rank.size();\n        for (int i = 0; i < compCount; ++i)\n            res = (ll)res * p % MOD;\n    }\n\n    std::cout << res << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class UnionFind {\n        int[] root;\n        int[] rank;\n        int numComponents;\n\n        UnionFind(int n) {\n            root = new int[n];\n            rank = new int[n];\n            numComponents = n;\n            for (int i = 0; i < n; i++) {\n                root[i] = i;\n                rank[i] = 0;\n            }\n        }\n\n        int find(int x) {\n            if (root[x] != x) {\n                root[x] = find(root[x]);\n            }\n            return root[x];\n        }\n\n        boolean merge(int x, int y) {\n            int rx = find(x);\n            int ry = find(y);\n            if (rx == ry) {\n                return false;\n            }\n            if (rank[rx] < rank[ry]) {\n                int temp = rx;\n                rx = ry;\n                ry = temp;\n            }\n            if (rank[rx] > 0 && rank[ry] > 0) {\n                numComponents--;\n            }\n            if (rank[rx] == 0 && rank[ry] == 0) {\n                numComponents++;\n            }\n            root[ry] = rx;\n            if (rank[rx] == rank[ry]) {\n                rank[rx]++;\n            }\n            return true;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        final int MOD = 1000000007;\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n        \n        int res = 1;\n        if (k == 0) {\n            for (int i = 0; i < p - 1; i++) {\n                res = (int)((long)res * p % MOD);\n            }\n        } else {\n            UnionFind uf = new UnionFind(p);\n            for (int i = 0; i < p; i++) {\n                uf.merge(i, (int)((long)k * i % p));\n            }\n            int compCount;\n            if (k > 1) {\n                compCount = uf.numComponents;\n            } else {\n                compCount = p - uf.rank.length;\n            }\n            for (int i = 0; i < compCount; i++) {\n                res = (int)((long)res * p % MOD);\n            }\n        }\n        \n        System.out.println(res);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00026854246971197426, -2.264974000354414e-06, -3.576278118089249e-07, -0.0004543225804809481, -1.2278481335670222e-05, -0.17978468537330627, -0.3871767818927765, -3.93382906622719e-05, -1.311301275563892e-06, -6.151010165922344e-05, -0.03804221749305725, -0.0011725700460374355, -0.10776703804731369, -0.13216353952884674, -4.8636207793606445e-05, -3.075552376685664e-05, -5.960462772236497e-07, -2.0265558760002023e-06, -0.002883683191612363, -4.410734163684538e-06, -5.960462772236497e-07, -4.291525328881107e-06, -8.344646857949556e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.264974000354414e-06, -2.455681169521995e-05, -1.7881377516459906e-06, -1.6689286894688848e-06, -1.1920922133867862e-06, -1.7404405298293568e-05, -0.002805228577926755, -3.3378044463461265e-05, -0.009782706387341022, -0.00041130665340460837, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, -2.145764938177308e-06, -3.3378546504536644e-06, 0.0, -3.099436753473128e-06, 0.0, -2.3841855067985307e-07, -5.722029527532868e-06, -