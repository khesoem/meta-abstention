urn r\n\ndef reorder(a, n):\n    j = n >> 1\n    for i in range(1, n - 1):\n        if i < j:\n            a[i], a[j] = a[j], a[i]\n        step = n >> 1\n        while j >= step:\n            j -= step\n            step >>= 1\n        if j < step:\n            j += step\n\ndef transform(a, n, dir):\n    reorder(a, n)\n    block = 2\n    while block <= n:\n        omega = pow_mod(G, (MOD - 1) // block)\n        if dir == -1:\n            omega = pow_mod(omega, MOD - 2)\n        start = 0\n        while start < n:\n            w = 1\n            half = block >> 1\n            for i in range(start, start + half):\n                x = a[i]\n                y = (w * a[i + half]) % MOD\n                a[i] = (x + y) % MOD\n                a[i + half] = (x - y + MOD) % MOD\n                w = (w * omega) % MOD\n            start += block\n        block <<= 1\n    if dir == -1:\n        invN = pow_mod(n, MOD - 2)\n        for i in range(n):\n            a[i] = (a[i] * invN) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    m = int(data[1])\n    \n    size = 1\n    halfN = n // 2\n    while size < 9 * halfN + 1:\n        size <<= 1\n    poly = [0] * size\n    \n    idxs = list(map(int, data[2:2+m]))\n    for idx in idxs:\n        poly[idx] = 1\n    \n    transform(poly, size, 1)\n    for i in range(size):\n        if poly[i] != 0:\n            poly[i] = pow_mod(poly[i], halfN)\n    \n    transform(poly, size, -1)\n    \n    ans = 0\n    for i in range(size):\n        ans = (ans + poly[i] * poly[i]) % MOD\n    print((ans + MOD) % MOD)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.332382276421413e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.0032613680232316256, -0.000974537746515125, -0.043255098164081573, -0.0010941001819446683, 0.0, 0.0, 0.0, 0.0, -8.344646857949556e-07, -1.0728830375228426e-06, -5.960462772236497e-07, -6.532455881824717e-05, -0.0001