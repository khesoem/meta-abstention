        self.curChar = 0\n\n    def read(self):\n        if self.numChars == -1:\n            raise Exception(\"Input mismatch\")\n        if self.curChar >= self.numChars:\n            self._fill_buffer()\n            if self.numChars <= 0:\n                return -1\n        char = self.buf[self.curChar]\n        self.curChar += 1\n        return char\n\n    def nextInt(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.isSpaceChar(c):\n            if c < ord('0') or c > ord('9'):\n                raise Exception(\"Input mismatch\")\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        return res * sgn\n\n    def isSpaceChar(self, c):\n        return self.isWhitespace(c)\n\n    @staticmethod\n    def isWhitespace(c):\n        return c in (ord(' '), ord('\\n'), ord('\\r'), ord('\\t'), -1)\n\ndef main():\n    inputStream = sys.stdin.buffer\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out_writer = OutputWriter(outputStream)\n    \n    n = in_reader.nextInt()\n    m = in_reader.nextInt()\n    mod = ModInt(m)\n    \n    factorial = [0] * (n + 1)\n    factorial[0] = n\n    for i in range(1, n):\n        factorial[i] = mod.multiply(factorial[i - 1], n - i)\n    \n    dp = [0] * (n * (n - 1) + 1)\n    middle = (n * (n - 1)) // 2\n    temp = dp.copy()\n    dp[middle] = 1\n    answer = 0\n    \n    for i in range(n - 1, -1, -1):\n        c = n - 1 - i\n        temp = dp.copy()\n        dp = [0] * len(dp)\n        limit = (c * (c - 1)) // 2\n        count = 0\n        for cur in range(-c, 0):\n            pairs = c + cur + 1\n            for j in range(middle - cur + 1, middle + limit + 1):\n                count = mod.add(count, mod.multiply(temp[j], pairs))\n        \n        if i == 0:\n            answer = mod.add(answer, count)\n        else:\n            answer = mod.add(answer, mod.multiply(count, factorial[i - 1]))\n        \n        for j in range(middle - limit, middle + limit + 1):\n            for cur in range(-c, c + 1):\n                pairs = c - abs(cur) + 1\n                if 0 <= j + cur < len(dp):\n                    dp[j + cur] = mod.add(dp[j + cur], mod.multiply(pairs, temp[j]))\n    \n    out_writer.println(answer)\n    out_writer.close()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013839241000823677, -2.0265558760002023e-06, -1.311301275563892e-06, -0.0007317964336834848, -0.019045811146497726, -0.05043068155646324, -0.5231886506080627, -0.6521446704864502, -0.014209285378456116, -0.007645511534065008, -0.03209367394447327, -1.9073468138230965e-06, -9.536738616588991e-07, -1.1920928244535389e-07, -1.9073468138230965e-06, -8.106198947643861e-06, -5.245195097813848e-06, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -2.3007127310847864e-05, -3.6954811548639555e-06, -1.6689286894688848e-06, -9.536738616588991e-07, -0.0003409996279515326, -4.0411134250462055e-05, 0.0, 0.0, -0.22618438303470612, -4.410734163684538e-06, -2.3841855067985307e-07, -1.6689286894688848e-06, -1.1920928244535389e-07, 0.0, 0.0, -7.152555099310121e-07, -0.00020823694649152458, -1.2755313036905136e-05, -8.106198947643861e-06, -1.1920928244535389e-07, -9.643566590966657e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -2.0265558760002023e-06, -1.0728830375228426e-06, -2.3841855067985307e-07, -2.50339189733495e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -1.9073468138230965e-06, -4.0531076592742465e-06, -1.1920922133867862e-06, -4.291525328881107e-06, -5.364403477869928e-06, -1.1920928244535389e-07, -2.7418097943154862e-06, -3.576278118089249e-07, -6.663577369181439e-05, -3.09