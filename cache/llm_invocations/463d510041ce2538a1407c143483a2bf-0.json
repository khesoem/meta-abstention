 0) {\n                int[] cur = qb.pollFirst();\n                int x = cur[0];\n                int y = cur[1];\n\n                for (int i = 0; i < 4; i++) {\n                    int nx = x + dx[i];\n                    int ny = y + dy[i];\n                    if (ok(nx, ny) && d2[nx][ny] < 0) {\n                        d2[nx][ny] = d2[x][y] + 1;\n                        qb.add(new int[]{nx, ny});\n                    }\n                }\n            }\n        }\n    }\n\n    static int[] pre = new int[MAXN];\n    static boolean[] vis = new boolean[MAXN];\n\n    static boolean findPath() {\n        Arrays.fill(vis, false);\n        Arrays.fill(pre, -1);\n        Queue<Integer> q = new LinkedList<>();\n        vis[S] = true;\n        q.add(S);\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            for (int e = head[u]; e != -1; e = edges[e].nxt) {\n                int v = edges[e].to;\n                if (edges[e].cap > 0 && !vis[v]) {\n                    pre[v] = e;\n                    if (v == T) return true;\n                    vis[v] = true;\n                    q.add(v);\n                }\n            }\n        }\n        return false;\n    }\n\n    static int maxFlow() {\n        int ans = 0;\n        while (findPath()) {\n            int add = Integer.MAX_VALUE;\n            for (int v = T; v != S; ) {\n                int e = pre[v];\n                add = Math.min(add, edges[e].cap);\n                v = edges[e ^ 1].to;\n            }\n            for (int v = T; v != S; ) {\n                int e = pre[v];\n                edges[e].cap -= add;\n                edges[e ^ 1].cap += add;\n                v = edges[e ^ 1].to;\n            }\n            ans += add;\n        }\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        limitT = sc.nextInt();\n        for (int i = 0; i < n; i++) {\n            String s = sc.next