lic class Main {\n    static long comb(int n, int k) {\n        if (n < k || k < 0) return 0;\n        long rez = 1;\n        for (int i = 0; i < k; i++) rez = rez * (n - i) / (i + 1);\n        return rez;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int r = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int n = 2 * (r + c);\n        String s = br.readLine();\n        long[] lsc = new long[62];\n        long[] rsc = new long[62];\n        long[] rsc2 = new long[62];\n        lsc[2 * r - 1] = 1;\n        for (int i = 2 * r; i < n; i++) {\n            lsc[i] = lsc[i - 1] * i / (long)(i - 2 * r + 1);\n        }\n        for (int i = 0; i <= n; i++) {\n            rsc[i] = comb(i, r);\n            rsc2[i] = comb(i, r - 1);\n        }\n        long msum = 0;\n        int cnta = 0, cntb = 0;\n        long nsum = rsc[n/2] * rsc[n/2];\n        for (int i = n - 1; i >= 0; i--) {\n            int ok;\n            if (msum > 0) ok = 1; else ok = 0;\n            if (cntb == n/2) ok = 1;\n            if (cnta == n/2) ok = 0;\n            if (ok == 1) {\n                cnta++;\n                msum = msum - rsc2[n/2 - cnta] * rsc[n/2 - cntb];\n            } else {\n                cntb++;\n                msum = msum + rsc2[n/2 - cntb] * rsc[n/2 - cnta];\n            }\n        }\n        msum = Math.max(msum, -msum);\n        \n        Map<Map.Entry<Long,Integer>, Long> mm = new HashMap<>();\n        Map<Map.Entry<Long,Integer>, Long> nm = new HashMap<>();\n        mm.put(new AbstractMap.SimpleEntry<>(0L, 0), 1L);\n        \n        for (int i = n - 1; i >= 2 * r - 1; i--) {\n            nm.clear();\n            for (Map.Entry<Map.Entry<Long,Integer>, Long> entry : mm.entrySet()) {\n                long sum = entry.getKey().getKey();\n             