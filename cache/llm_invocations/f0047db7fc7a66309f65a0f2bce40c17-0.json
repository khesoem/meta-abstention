utReader(InputStream in) { this.in = in; }\n\n        private int read() {\n            if (len == -1) throw new RuntimeException();\n            if (ptr >= len) {\n                ptr = 0;\n                try { len = in.read(buffer); } catch (IOException e) { throw new RuntimeException(); }\n                if (len <= 0) return -1;\n            }\n            return buffer[ptr++];\n        }\n\n        public int nextInt() {\n            int c = read();\n            while (isSpace(c)) c = read();\n            int val = 0, sign = 1;\n            if (c == '-') { sign = -1; c = read(); }\n            for (; '0' <= c && c <= '9'; c = read()) val = val * 10 + c - '0';\n            return val * sign;\n        }\n\n        private boolean isSpace(int c) { return c == ' ' || c == '\\n' || c == '\\r' || c == '\\t' || c == -1; }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nconst long long MOD = 1000000007LL;\nconst long long INF = (long long)1e18 + 1;\n\nstatic long long nCr[100][100];\n\nlong long comb(long long base, int a, int b, int c, int d) {\n    base = (base * nCr[a][b]) % MOD;\n    base = (base * nCr[c][d]) % MOD;\n    return base;\n}\n\nstruct State {\n    int x, y, side;\n    long long d;\n    State(int x, int y, int side, long long d) : x(x), y(y), side(side), d(d) {}\n};\n\nvoid solve(int testNum, istream& in, ostream& out) {\n    int n, K;\n    in >> n >> K;\n    int cnt50 = 0, cnt100 = 0;\n    for (int i = 0; i < n; i++) {\n        int val;\n        in >> val;\n        if (val == 50) cnt50++;\n        else cnt100++;\n    }\n\n    // Precompute binomial coefficients\n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j <= i; j++) {\n            if (j == 0 || j == i) nCr[i][j] = 1;\