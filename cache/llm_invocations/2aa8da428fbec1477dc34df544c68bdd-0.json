           scanf(\"%d\", &p[i][j]);\n            p[i][j]=MUL(p[i][j], power(100, MOD-2));\n        }\n    }\n    for(int i=0; i<n; i++) {\n        for(int j=0; j<(1<<n); j++) {\n            q[i][j]=1;\n            for(int k=0; k<n; k++) {\n                if((j>>k)&1) q[i][j]=MUL(q[i][j], p[i][k]);\n                else q[i][j]=MUL(q[i][j], SUB(1, p[i][k]));\n            }\n        }\n    }\n    dp[0][1]=1;\n    for(int i=1; i<=n; i++) {\n        for(int j=1; j<=cnt; j++) {\n            for(int m=0; m<(1<<n); m++) {\n                int to = nxt[j][m];\n                dp[i][to] = ADD(dp[i][to], MUL(dp[i-1][j], q[i-1][m]));\n            }\n        }\n    }\n    bitset<128> full;\n    for(int i=0; i<(1<<n); i++) full[i]=1;\n    printf(\"%d\\n\", dp[n][id[full]]);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add(a, b):\n    s = a + b\n    return s - MOD if s >= MOD else s\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef sub(a, b):\n    d = a - b\n    return d + MOD if d < 0 else d\n\ndef lowbit(x):\n    return x & -x\n\ndef power(a, b):\n    r = 1\n    while b:\n        if b & 1:\n            r = mul(r, a)\n        a = mul(a, a)\n        b >>= 1\n    return r\n\ndef dfs(s):\n    if s in id_map:\n        return id_map[s]\n    cnt = len(id_map) + 1  # ids start from 1\n    id_map[s] = cnt\n    nxt.append([0] * (1 << n))  # placeholder for this state\n    for m in range(1 << n):\n        t = s\n        for j in range(1 << n):\n            if not (t >> j) & 1:\n                x = m & j\n                while x:\n                    lb = lowbit(x)\n                    if (s >> (j ^ lb)) & 1:\n                        t |= (1 << j)\n                        break\n                    x -= lb\n        nxt[cnt][m] = dfs(t)\n    return cnt\n\ndef main():\n    global n, id_map, nxt\n    data = list(ma