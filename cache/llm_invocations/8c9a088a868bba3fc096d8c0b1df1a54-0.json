raph[v])])\n        # backward edge\n        self.graph[v].append([u, 0, 0, len(self.graph[u]) - 1])\n\n    def bfs(self, s, t):\n        level = [-1] * self.n\n        q = deque([s])\n        level[s] = 0\n        while q:\n            u = q.popleft()\n            for v, cap, flow, rev in self.graph[u]:\n                if level[v] < 0 and flow < cap:\n                    level[v] = level[u] + 1\n                    q.append(v)\n        self.level = level\n        return level[t] >= 0\n\n    def dfs(self, u, t, f):\n        if u == t:\n            return f\n        for i in range(self.it[u], len(self.graph[u])):\n            self.it[u] = i\n            v, cap, flow, rev = self.graph[u][i]\n            if flow < cap and self.level[u] < self.level[v]:\n                ret = self.dfs(v, t, min(f, cap - flow))\n                if ret > 0:\n                    self.graph[u][i][2] += ret\n                    self.graph[v][rev][2] -= ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    R = int(next(it))\n    T = int(next(it))\n\n    m1 = [list(next(it).strip()) for _ in range(R)]\n    m2 = [list(next(it).strip()) for _ in range(R)]\n\n    # find Z position\n    zi = zj = -1\n    for i in range(R):\n        for j in range(R):\n            if m1[i][j] == 'Z':\n                zi, zj = i, j\n                break\n        if zi != -1:\n            break\n\n    # node numbering: first grid (non-Y, non-Z) then second grid (non-Y, non-Z)\n    nod = [[[0]*R for _ in range(R)] for _ in range(2)]\n    n = 0\n    for i in range(R):\n        for j in range(R):\n            if m1[i][j] != 'Y' and m1[i][j] != 'Z':\n                n += 1\n                nod[0][i][j] = n\n    for i in range(R):\n        for j in range(R):\n            if m2[i][j] != 'Y' and m2[i][j] != 'Z':\n                n += 1\n                nod[1][i][j] = n\n    n += 1  # total nodes including source and sink? Actually source=0, sink=n, so n is sink index\n    s = 0\n    t = n\n    dinic = Dinic(n+1)  # nodes from 0 to n inclusive\n\n    # add edges from source to first grid and from second grid to sink\n    for i in range(R):\n        for j in range(R):\n            if m1[i][j] != 'Z' and m1[i][j] != 'Y':\n                cap1 = ord(m1[i][j]) - ord('0')\n                dinic.add_edge(s, nod[0][i][j], cap1)\n                cap2 = ord(m2[i][j]) - ord('0')\n                dinic.add_edge(nod[1][i][j], t, cap2)\n\n    # BFS from Z (cc=0)\n    movI = [0, 1, 0, -1]\n    movJ = [1, 0, -1, 0]\n\n    def can_move(i, j):\n        return 0 <= i < R and 0 <= j < R and m1[i][j] != 'Y' and m1[i][j] != 'Z'\n\n    tim = [[[0]*R for _ in range(R)] for _ in range(2)]\n\n    def bfs2(si, sj, cc):\n        # reset tim[cc] to 0\n        for i in range(R):\n            for j in range(R):\n                tim[cc][i][j] = 0\n        tim[cc][si][sj] = 1\n        q = deque()\n        q.append((si, sj))\n        while q:\n            ci, cj = q.popleft()\n            if cc == 1 and tim[0][ci][cj] and tim[0][ci][cj] <= tim[1][ci][cj]:\n                continue\n            for k in range(4):\n                ni = ci + movI[k]\n                nj = cj + movJ[k]\n                if can_move(ni, nj) and tim[cc][ni][nj] == 0:\n                    tim[cc][ni][nj] = tim[cc][ci][cj] + 1\n                    q.append((ni, nj))\n\n    bfs2(zi, zj, 0)\n\n    # add edges from first grid cells to second grid cells\n    for i in range(R):\n        for j in range(R):\n            if '1' <= m1[i][j] <= '9':\n                bfs2(i, j, 1)\n                for ii in range(R):\n                    for jj in range(R):\n  