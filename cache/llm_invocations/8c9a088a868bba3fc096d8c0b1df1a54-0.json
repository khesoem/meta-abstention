eturn F;\n    for( int &e = now[u]; e != -1; e = edges[e].nxt ){\n        int v = edges[e].to;\n        if( lev[u] < lev[v] && edges[e].flow < edges[e].cap ){\n            int f = dfs( v , min( F , edges[e].cap - edges[e].flow ) );\n            if( f ){\n                edges[e].flow += f;\n                edges[e^1].flow -= f;\n                return f;\n            }\n        }\n    }\n    return 0;\n}\nint max_flow(){\n    int F = 0;\n    while( bfs() ){\n        memcpy(now, last, sizeof(last));\n        int f;\n        while( (f = dfs( s , oo )) ) F += f;\n    }\n    return F;\n}\n\nint R;\nstring m1[MAXR];\nstring m2[MAXR];\n\nint movI[] = { 0 , 1 , 0 , -1 };\nint movJ[] = { 1 , 0 , -1 , 0 };\n\nbool can_move( int i, int j ){\n    return ( i >= 0 && j >= 0 && i < R && j < R && m1[i][j] != 'Y' && m1[i][j] != 'Z' );\n}\n\nint tim[2][MAXR][MAXR];\n\nvoid bfs2( int i, int j, int cc ){\n    for( int k = 0; k < R; k++ ){\n        for( int l = 0; l < R; l++ ){\n            tim[cc][k][l] = 0;\n        }\n    }\n\n    tim[cc][i][j] = 1;\n    queue<par> q;\n    q.push( make_pair( i , j ) );\n    while( !q.empty() ){\n        int ci = q.front().first;\n        int cj = q.front().second;\n        q.pop();\n\n        if( cc == 1 && (tim[0][ci][cj] && tim[0][ci][cj] <= tim[1][ci][cj]) ){\n            continue;\n        }\n\n        for( int k = 0; k < 4; k++ ){\n            int ii = ci + movI[k];\n            int jj = cj + movJ[k];\n\n            if( can_move( ii , jj ) && !tim[cc][ii][jj] ){\n                tim[cc][ii][jj] = tim[cc][ci][cj] + 1;\n                q.push( make_pair( ii , jj ) );\n            }\n        }\n    }\n}\n\nint nod[2][MAXR][MAXR];\n\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n\n    int T; cin >> R >> T;\n\n    int zi = 0, zj = 0;\n\n    int n = 0, s = 0, t = 0;\n\n    for( int i = 0; i < R; i++ ){\n        cin >> m1[i];\n        for( int j = 0; j < R; j++ ){\n            if( m1[i][j] == 'Z' ){\n                zi = i;\n            