extIntArray(n)\n    odd = [0] * (n + 1)\n    even = [0] * (n + 1)\n    odd[0] = 0\n    even[0] = 0\n    for i in range(1, n + 1):\n        if a[i - 1] % 2 == 1:\n            odd[i] = odd[i - 1] + 1\n            even[i] = even[i - 1]\n        else:\n            odd[i] = odd[i - 1]\n            even[i] = even[i - 1] + 1\n    prev = 0\n    cost = []\n    for i in range(1, n):\n        oc = odd[i] - odd[prev]\n        ec = even[i] - even[prev]\n        if oc == ec:\n            cost.append(abs(a[i] - a[i - 1]))\n            prev = i\n    cost.sort()\n    sum = 0\n    count = 0\n    while cost and sum <= b:\n        sum += cost.pop(0)\n        count += 1\n    if count == 0:\n        print(0)\n    else:\n        if not cost and sum <= b:\n            print(count)\n        else:\n            print(count - 1)\n\nif __name__ == \"__main__\":\n    main()\n\n</original_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.43133237957954407, -0.00016297238471452147, -0.5808757543563843, -0.22627021372318268, -0.7166569828987122, -0.29319989681243896, -0.38274794816970825, -0.0017614371608942747, -0.007902531884610653, -0.6440728306770325, -0.7655308842658997, -0.07428049296140671, -0.008447764441370964, -0.067841075360775, -0.8488228917121887, -0.4293301999568939, -0.2368731051683426, -0.1331678330898285, -0.0025003792252391577, -0.04749705642461777, -0.008080978877842426, -0.0003829735505860299, -3.480972009128891e-05, -7.867844033171423e-06, -1.5497220147153712e-06, -2.062341991404537e-05, -0.043144140392541885, -0.025332272052764893, -0.012806289829313755, -0.0010389717062935233, -0.003209909191355109, -0.0015010172501206398, -7.772747630951926e-05, -0.0014872279716655612, -0.005509445909410715, -0.0001119437874876894, -0.0001394845894537866, -0.023661717772483826, -0.04099966585636139, -0.036221884191036224, -0.0005913336644880474, -0.00046478581498377025, -9.536747711536009e-07, -0.00041499402141198516, -5.960482212685747e-06, -2.622607780722319e-06, -0.01027696