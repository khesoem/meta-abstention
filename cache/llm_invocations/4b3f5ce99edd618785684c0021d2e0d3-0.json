e());\n        long w = Long.parseLong(token.nextToken());\n        long m = Long.parseLong(token.nextToken());\n        \n        // Special case for w=2: always possible\n        if (w == 2) {\n            System.out.println(\"YES\");\n            return;\n        }\n        \n        // Generate all possible combinations of weights on both sides\n        // Each weight can be: not used, on left pan (with the item), or on right pan\n        // This corresponds to coefficients -1, 0, or 1 in the equation:\n        // m + sum(left_weights) = sum(right_weights)\n        // => m = sum(right_weights) - sum(left_weights)\n        \n        List<Long> possible = new ArrayList<>();\n        possible.add(0L);\n        \n        long weight = 1;\n        for (int i = 0; i <= 100; i++) {\n            if (weight > 2 * m && i > 0) {\n                break;\n            }\n            \n            List<Long> newPossible = new ArrayList<>();\n            for (Long val : possible) {\n                // Three choices: don't use weight, put on right pan (+weight), put on left pan (-weight)\n                newPossible.add(val);           // not used\n                newPossible.add(val + weight);  // on right pan\n                newPossible.add(val - weight);  // on left pan\n            }\n            possible = newPossible;\n            weight *= w;\n        }\n        \n        // Check if m can be achieved\n        for (Long val : possible) {\n            if (val == m) {\n                System.out.println(\"YES\");\n                return;\n            }\n        }\n        \n        System.out.println(\"NO\");\n    }\n\n}\n</repaired_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -2.3007127310847864e-05, -1.7881377516459906e-06, 0.0, -6.19869097135961e-05, -2.3364747903542593e-05, -1.1920922133867862e-06, -7.664863369427621e-05, -1.4305104514278355e-06, -2.109982233378105e-05, -5.7338023907504976e-05, 0.0, -0.00016640232934150845, -7.