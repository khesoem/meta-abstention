 add = f(dp[x][y][z], rx, a, ry, b);\n                        if (dist[nx][ny][nz] > d + 1) {\n                            dist[nx][ny][nz] = d + 1;\n                            q.push(State(nx, ny, nz));\n                        }\n                        dp[nx][ny][nz] = (dp[nx][ny][nz] + add) % MOD;\n                    }\n                }\n            }\n        } else {\n            int rx = x;\n            int ry = y;\n            for (int a = 0; a <= rx; a++) {\n                for (int b = 0; b <= ry; b++) {\n                    if (a + b == 0) continue;\n                    if (a * 50 + b * 100 > K) break;\n                    int nx = x - a;\n                    int ny = y - b;\n                    int nz = 0;\n                    if (dist[nx][ny][nz] >= d + 1) {\n                        long long add = f(dp[x][y][z], rx, a, ry, b);\n                        if (dist[nx][ny][nz] > d + 1) {\n                            dist[nx][ny][nz] = d + 1;\n                            q.push(State(nx, ny, nz));\n                        }\n                        dp[nx][ny][nz] = (dp[nx][ny][nz] + add) % MOD;\n                    }\n                }\n            }\n        }\n    }\n\n    if (dist[cnt1][cnt2][1] == INF) cout << -1 << '\\n';\n    else cout << dist[cnt1][cnt2][1] << '\\n';\n    cout << dp[cnt1][cnt2][1] << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-5.6980417866725475e-05, -1.1920928244535389e-07, -1.1920922133867862e-06, -0.00027998341829515994, -0.0004961451631970704, -1.811964830267243e-05, -0.6932551860809326, 0.0, -1.1920928244535389e-07, 0.0, -0.00195609824731946, -4.482168878894299e-05, -1.1920928244535389e-07, 0.0, -0.25194600224494934, -0.49370115995407104, -5.328513361746445e-05, -3.6954811548639555e-06, 0.0, -5.960462772236497e-07, -2.3841855067985307e-07, -3.540453326422721e-05, 0.0, -1.1920928244535389e-07, 0.0, -0.0074321916326880455, -2.145764938177308e-06, -3.576278118089249e-07, 