ompare_and_update(base, i);\n        compare_and_update(base + 1, i);\n    }\n    \n    cout << best_num << \"/\" << best_den << endl;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        \n        long best_num = -1;\n        int best_den = -1;\n        \n        for (int i = 1; i <= n; ++i) {\n            long base = i * x / y;\n            compareAndUpdate(base - 1, i, x, y, best_num, best_den);\n            compareAndUpdate(base, i, x, y, best_num, best_den);\n            compareAndUpdate(base + 1, i, x, y, best_num, best_den);\n        }\n        \n        System.out.println(best_num + \"/\" + best_den);\n    }\n    \n    private static void compareAndUpdate(long num, int den, long x, long y, long best_num, int best_den) {\n        if (num < 0) return;\n        \n        if (best_num == -1) {\n            best_num = num;\n            best_den = den;\n            return;\n        }\n        \n        long current_error = Math.abs(den * x - num * y) * best_den;\n        long best_error = Math.abs(best_den * x - best_num * y) * den;\n        \n        if (current_error < best_error) {\n            best_num = num;\n            best_den = den;\n        } else if (current_error == best_error) {\n            if (den < best_den || (den == best_den && num < best_num)) {\n                best_num = num;\n                best_den = den;\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00010871296399272978, -2.0265558760002023e-06, -3.576278118089249e-07, -0.00011562632425921038, -1.4066597032069694e-05, -0.00084614707