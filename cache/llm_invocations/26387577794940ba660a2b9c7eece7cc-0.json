mr[i];\n            int tc=sc+mc[i];\n            if(a[tr][tc]>=0 && v[tr][tc]<0){\n                v[tr][tc]=v[sr][sc]+1;\n                qr.push(tr);\n                qc.push(tc);\n            }\n        }\n    }\n    //printf(\" %d\\n\",e[m].size());\n    m+=cnt;\n}\n\nHungary match;\n\nint main(){\n    int n,sr,sc,o=m=0;\n    scanf(\"%d%d\",&n,&t);\n    memset(a,255,sizeof(a));\n    memset(b,255,sizeof(b));\n    for(int i=1;i<=n;i++){\n        while(getchar()!='\\n');\n        for(int j=1;j<=n;j++){\n            char ch=getchar();\n            if(ch>='0' && ch<='9') a[i][j]=ch-'0';\n            if(ch=='Z'){\n                sr=i;\n                sc=j;\n            }\n        }\n    }\n    floodfill(sr,sc);\n    while(getchar()!='\\n');\n    for(int i=1;i<=n;i++){\n        while(getchar()!='\\n');\n        for(int j=1;j<=n;j++){\n            char ch=getchar();\n            if(ch>='0' && ch<='9') b[i][j]=ch-'0';\n            for(int k=0;k<b[i][j];k++) c[i][j].push_back(o++);\n        }\n    }\n    for(int i=1;i<=n;i++) for(int j=1;j<=n;j++) if(f[i][j]<0) f[i][j]=INF;\n    for(int i=1;i<=n;i++) for(int j=1;j<=n;j++) if(a[i][j]>0) setmark(i,j,a[i][j]);\n    /*\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",a[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",b[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n        for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",f[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n    printf(\"%d %d -> \",m,o);\n    //*/\n    printf(\"%d\\n\",match.gao(m,e));\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Hungary {\n    private static final int SIZE = 2000;\n    private int cnt;\n    private int[] pos = new int[SIZE];\n    private int[] rev = new int[SIZE];\n    private int[] v = new int[SIZE];\n\n    public int gao(int n, ArrayList<Integer>[] e) {\n        cnt = 0;\n        Arrays.fill(pos, -1);\n        Arrays.fill(rev, -1);\n        for (int i = 0; i < n; i++) {\n            Arrays.fill(v, 0);\n            if (match(i, e)) cnt++;\n        }\n        return cnt;\n    }\n\n    private boolean match(int x, ArrayList<Integer>[] e) {\n        for (int y : e[x]) {\n            if (v[y] == 0) v[y] = 1;\n            else continue;\n            if (rev[y] < 0 || match(rev[y], e)) {\n                pos[x] = y;\n                rev[y] = x;\n                return true;\n            }\n        }\n        return false;\n    }\n}\n\npublic class Main {\n    private static final int INF = 1000000000;\n    private static final int[] mr = {0, -1, 0, 1};\n    private static final int[] mc = {1, 0, -1, 0};\n\n    private static int[][] a = new int[12][12];\n    private static int[][] b = new int[12][12];\n    private static int[][] f = new int[12][12];\n    private static int m;\n    private static int t;\n    private static ArrayList<Integer>[] e = new ArrayList[2000];\n    private static ArrayList<Integer>[][] c = new ArrayList[12][12];\n\n    private static void floodfill(int sr, int sc) {\n        Queue<Integer> qr = new LinkedList<>();\n        Queue<Integer> qc = new LinkedList<>();\n        for (int i = 0; i < 12; i++) Arrays.fill(f[i], -1);\n        qr.add(sr);\n        qc.add(sc);\n        f[sr][sc] = 0;\n        while (!qr.isEmpty()) {\n            sr = qr.poll();\n            sc = qc.poll();\n            for (int i = 0; i < 4; i++) {\n                int tr = sr + mr[i];\n                int tc = sc + mc[i];\n                if (tr >= 0 && tr < 12 && tc >= 0 && tc < 12 && a[tr][tc] >= 0 && f[tr][tc] < 0) {\n                    f[tr][tc] = f[sr][sc] + 1;\n                    qr.add(tr);\n                    qc.add(tc);\n                }\n            }\n        }\n    }\n\n    private static void setmark(int sr, int sc, int cnt) {\n        int[][] v = new int[12][12];\n        Queue<Integer> qr = new LinkedList<>();\n        Queue<Integer> qc = new LinkedList<>();\n        for (int i = 0; i < 12; i++) Arrays.fill(v[i], -1);\n        qr.add(sr);\n        qc.add(sc);\n        v[sr][sc] = 0;\n        while (!qr.isEmpty()) {\n            sr = qr.poll();\n            sc = qc.poll();\n            if (v[sr][sc] > Math.min(t, f[sr][sc])) continue;\n            for (int j = 0; j < c[sr][sc].size(); j++) {\n                for (int i = 0; i < cnt; i++) {\n                    e[m + i].add(c[sr][sc].get(j));\n                }\n            }\n            if (v[sr][sc] == Math.min(t, f[sr][sc])) continue;\n            for (int i = 0; i < 4; i++) {\n                int tr = sr + mr[i];\n                int tc = sc + mc[i];\n                if (tr >= 0 && tr < 12 && tc >= 0 && tc < 12 && a[tr][tc] >= 0 && v[tr][tc] < 0) {\n                    v[tr][tc] = v[sr][sc] + 1;\n                    qr.add(tr);\n                    qc.add(tc);\n                }\n            }\n        }\n        m += cnt;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n, sr = 0, sc = 0;\n        m = 0;\n        n = scanner.nextInt();\n        t = scanner.nextInt();\n        for (int i = 0; i < 12; i++) {\n            Arrays.fill(a[i], -1);\n            Arrays.fill(b[i], -1);\n        }\n        for (int i = 1; i <= n; i++) {\n            scanner.nextLine();\n            String line = scanner.nextLine();\n            for (int j = 1; j <= n; j++) {\n                char ch = line.charAt(j - 1);\n                if (ch >= '0' && ch <= '9') a[i][j] = ch - '0';\n                if (ch == 'Z') {\n                    sr = i;\n                    sc = j;\n                }\n            }\n        }\n        floodfill(sr, sc);\n        scanner.nextLine();\n        int o = 0;\n        for (int i = 0; i < 12; i++) {\n            for (int j = 0; j < 12; j++) {\n                c[i][j] = new ArrayList<>();\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            scanner.nextLine();\n            String line = scanner.nextLine();\n            for (int j = 1; j <= n; j++) {\n                char ch = line.charAt(j - 1);\n                if (ch >= '0' && ch <= '9') b[i][j] = ch - '0';\n                for (int k = 0; k < b[i][j]; k++) c[i][j].add(o++);\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                if (f[i][j] < 0) f[i][j] = INF;\n            }\n        }\n        for (int i = 0; i < 2000; i++) e[i] = new ArrayList<>();\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                if (a[i][j] > 0) setmark(i, j, a[i][j]);\n            }\n        }\n        Hungary match = new Hungary();\n        System.out.println(match.gao(m, e));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -0.00041083002, -0.00038997675, -7.152555e-07, -0.02324603, -0.06384644, -0.31412587, -1.1920922e-06, -0.7006332, -0.01451857, -9.750845e-05, -0.43558967, -0.00026389453, -4.8993817e-05, -4.7683704e-07, -0.000102514736, -5.960463e-07, -2.3841855e-07, -1.2516897e-05, -9.1790735e-06, -0.0019643074, -0.00026186852, -0.051743507, -0.00016616394, -0.006774908, -0.006785446, -8.344647e-07, -0.001035988, -1.668916e-05, -2.3007127e-05, -2.5868081e-05, -0.06211237, 0.0, 0.0, -3.170917e-05, 0.0, -0.00035708727, 0.0, -4.5299425e-06, -2.3841855e-07, -1.1920928e-07, 0.0, -3.3378547e-06, 0.0, 0.0, -6.198864e-06, 0.0, -0.0005812148, -0.0011716175, -0.00017605662, -0.018268893, -1.7285198e-05, -0.00084042986, -0.009961534, -2.7418098e-06, 0.0, -3.564294e-05, 0.0, -0.20163484, -1.3113013e-06, -0.0026372436, -0.030048108, -0.0008890252, -1.1920928e-07, -2.3841855e-07, -2.3841855e-07, -1.3113013e-06, -0.8479848, -0.011057529, -3.576278e-07, -5.8410846e-05, -7.152555e-07