arseDouble(next());\n    }\n\n    String nextLine() {\n      try {\n        return reader.readLine();\n      } catch (IOException e) {\n        e.printStackTrace();\n        return \"\";\n      }\n    }\n  }\n\n  static final long[] ones = {0, 1, 11, 111, 1111, 11111, 111111, 1111111, 11111111, 111111111, 1111111111L, 11111111111L, 111111111111L, 1111111111111L, 11111111111111L, 111111111111111L};\n\n  public static void main(String[] args) throws Exception {\n    Reader reader = new Reader(System.in);\n    long n = reader.nextLong();\n    System.out.println(decompose(n));\n  }\n\n  public static long decompose(long n) {\n    if (n <= 6) {\n      return n;\n    }\n    long digits = (long)(Math.log10(n) + 1e-9) + 1;\n    long lower = ones[(int)digits];\n    long upper;\n    if (n < lower) {\n      upper = lower;\n      lower = ones[(int)(digits - 1)];\n    } else if (n > lower) {\n      upper = ones[(int)(digits + 1)];\n    } else {\n      return digits;\n    }\n    long resLower = decompose(n % lower) + (n / lower) * digits;\n    long resUpper = Long.MAX_VALUE;\n    if (upper - n < n) {\n      resUpper = decompose(upper - n) + (digits + (n > lower ? 1 : 0));\n    }\n    return Math.min(resLower, resUpper);\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n  static class Reader {\n    BufferedReader reader;\n    StringTokenizer tokenizer;\n\n    Reader(InputStream input) {\n      reader = new BufferedReader(new InputStreamReader(input));\n      tokenizer = new StringTokenizer(\"\");\n    }\n\n    String next() throws IOException {\n      while (!tokenizer.hasMoreTokens()) {\n        tokenizer = new StringTokenizer(reader.readLine());\n      }\n      return tokenizer.nextToken();\n    }\n\n    int nextInt() throws IOException {\n      return Integer.parseInt(next());\n    }\n\n    long nex