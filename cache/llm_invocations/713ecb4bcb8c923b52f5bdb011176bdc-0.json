ont(); bfs.pop();\n        inQueue[u] = false;\n        \n        for (int idx : graph[u]) {\n            Edge& e = edges[idx];\n            if (e.capacity <= e.flow) continue;\n            int v = e.destination;\n            long long newDist = distance[u] + e.cost;\n            if (newDist < distance[v]) {\n                distance[v] = newDist;\n                parentVertex[v] = u;\n                parentEdgeIndex[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    bfs.push(v);\n                }\n            }\n        }\n    }\n    \n    if (distance[sink] == INF) return false;\n    \n    int cur = sink;\n    while (cur != source) {\n        edges[parentEdgeIndex[cur]].flow++;\n        edges[parentEdgeIndex[cur] ^ 1].flow--;\n        cur = parentVertex[cur];\n    }\n    \n    return true;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int nodes, edgesCount, commodities, baseCost, delayFactor;\n    cin >> nodes >> edgesCount >> commodities >> baseCost >> delayFactor;\n    \n    const int sourceNode = 9998;\n    const int sinkNode = 9999;\n    \n    for (int i = 0; i < commodities; i++) {\n        int node;\n        cin >> node;\n        node--;\n        insertEdge(sourceNode, node, 1, 0);\n    }\n    \n    for (int layer = 1; layer <= 101; layer++) {\n        insertEdge((layer - 1) * nodes, sinkNode, commodities, (layer - 1) * baseCost);\n    }\n    \n    for (int i = 0; i < edgesCount; i++) {\n        int u, v;\n        cin >> u >> v;\n        u--; v--;\n        for (int layer = 1; layer <= 100; layer++) {\n            for (int commodity = 1; commodity <= commodities; commodity++) {\n                int cost = delayFactor * ((commodity - 1) * 2 + 1);\n                insertEdge(u + (layer - 1) * nodes, v + (layer - 1) * nodes + nodes, 1, cost);\n                insertEdge(v + (layer - 1) * nodes, u + (layer - 1) * nodes + nodes, 1, cost);\n            }\n        