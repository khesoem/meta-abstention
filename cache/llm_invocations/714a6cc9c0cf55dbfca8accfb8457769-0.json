hi, d, x, y) ? hi : lo;\n        if (diff(cand, d, x, y) < diff(best_num, best_den, x, y)) {\n            best_num = cand;\n            best_den = d;\n        }\n    }\n    \n    cout << best_num << \"/\" << best_den;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        \n        long bestNum = 0;\n        long bestDen = 1;\n        double target = (double) x / (double) y;\n        \n        for (long d = 1; d <= n; ++d) {\n            long lo = 1;\n            long hi = 1000000;\n            while (lo < hi - 1) {\n                long mid = (lo + hi) / 2;\n                double val = (double) mid / (double) d;\n                if (val < target) {\n                    lo = mid;\n                } else {\n                    hi = mid;\n                }\n            }\n            \n            double diffLo = diff(lo, d, x, y);\n            double diffHi = diff(hi, d, x, y);\n            long cand = diffLo > diffHi ? hi : lo;\n            \n            double diffCand = diff(cand, d, x, y);\n            double diffBest = diff(bestNum, bestDen, x, y);\n            \n            if (diffCand < diffBest) {\n                bestNum = cand;\n                bestDen = d;\n            }\n        }\n        \n        System.out.println(bestNum + \"/\" + bestDen);\n    }\n    \n    private static long gcd(long a, long b) {\n        return b != 0 ? gcd(b, a % b) : a;\n    }\n    \n    private static long lcm(long a, long b) {\n        return a / gcd(a, b) * b;\n    }\n    \n    private static double diff(long a1, long b1, long a2, long b2) {\n        long c = lcm(b1, b2);\n        