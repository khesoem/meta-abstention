act[i] = i * fact[i - 1] % mod\n\nif n <= 3:\n    ans = 0\nelse:\n    dp = [0] * 2000\n    dp[0], dp[1], dp[2], dp[3] = 1, 2, 2, 1\n    for i in range(4):\n        update(i, dp[i])\n    m = 3\n    ans = 0\n    for i in range(n - 3):\n        dp0 = dp[:]\n        ans0 = 0\n        for j in range(i + 3):\n            for k in range(1, m + 2):\n                ans0 = (ans0 + get_sum(j + k + 1, 2004) * dp0[k - 1]) % mod\n                dp[j + k] = (dp[j + k] + dp0[k - 1]) % mod\n                update(j + k, dp[j + k])\n        m += i + 3\n        ans = (ans + f(i + 4, n) * ans0) % mod\n    print(ans)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static int mod;\n    static int B = 64;\n    static int N = 2005;\n    static int[] val = new int[N];\n    static int[] blocks = new int[(N + B - 1) / B];\n\n    static void update(int i, int x) {\n        int delta = x - val[i];\n        val[i] = x;\n        blocks[i / B] += delta;\n    }\n\n    static int getSum(int l, int r) {\n        if (l > r) return 0;\n        int bl = l / B;\n        int br = r / B;\n        if (bl == br) {\n            int sum = 0;\n            for (int i = l; i <= r; i++) sum += val[i];\n            return sum;\n        }\n        int res = 0;\n        for (int i = l; i < (bl + 1) * B; i++) res += val[i];\n        for (int b = bl + 1; b < br; b++) res += blocks[b];\n        for (int i = br * B; i <= r; i++) res += val[i];\n        return res;\n    }\n\n    static List<Integer> primeFactorize(int n) {\n        List<Integer> ans = new ArrayList<>();\n        for (int i = 2; i * i <= n; i++) {\n            while (n % i == 0) {\n                ans.add(i);\n                n /= i;\n            }\n            if (n == 1) break;\n        }\n        if (n != 1) ans.add(n);\n        return ans;\n    }\n\n    static int eulerFunc(int n) {\n        Set<Integer> p = new HashSet<>(primeFactorize(n));\n        int x = n;\n        for (int i : p) {\n            x *= (i - 1);\n            x /= i;\n        }\n        return x;\n    }\n\n    static int f(int a, int b) {\n        long ans = 1;\n        for (int i = a + 1; i <= b; i++) {\n            ans = (ans * i) % mod;\n        }\n        return (int) ans;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        mod = Integer.parseInt(st.nextToken());\n        int _ = eulerFunc(mod); // result ignored\n        int l = n + 5;\n        int[] fact = new int[l + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= l; i++) {\n            fact[i] = (int)((long)i * fact[i - 1] % mod);\n        }\n\n        if (n <= 3) {\n            System.out.println(0);\n            return;\n        }\n\n        int[] dp = new int[2000];\n        dp[0] = 1;\n        dp[1] = 2;\n        dp[2] = 2;\n        dp[3] = 1;\n        for (int i = 0; i < 4; i++) {\n            update(i, dp[i]);\n        }\n        int m = 3;\n        long ans = 0;\n        for (int i = 0; i < n - 3; i++) {\n            int[] dp0 = dp.clone();\n            long ans0 = 0;\n            for (int j = 0; j < i + 3; j++) {\n                for (int k = 1; k <= m + 1; k++) {\n                    ans0 = (ans0 + (long)getSum(j + k + 1, 2004) * dp0[k - 1]) % mod;\n                    dp[j + k] = (int)((dp[j + k] + dp0[k - 1]) % mod);\n                    update(j + k, dp[j + k]);\n                }\n            }\n            m += i + 3;\n            ans = (ans + (long)f(i + 4, n) * ans0) % mod;\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -3.349725011503324e-05, -6.35365358