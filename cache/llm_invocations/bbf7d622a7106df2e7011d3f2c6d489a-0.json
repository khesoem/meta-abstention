;\n        int rows, cols;\n\n        Matrix(int r, int c) {\n            rows = r;\n            cols = c;\n            data = new long[r][c];\n        }\n\n        void init(int a, int b) {\n            rows = a;\n            cols = b;\n            data = new long[a][b];\n        }\n    }\n\n    static Matrix[] R = new Matrix[K_MAX + 1];\n    static Matrix[][] D = new Matrix[D_MAX + 1][K_MAX];\n\n    static void mat_init(Matrix A, int a, int b) {\n        A.init(a, b);\n        for (int i = 0; i < a; i++) {\n            for (int j = 0; j < b; j++) {\n                A.data[i][j] = 0;\n            }\n        }\n    }\n\n    static void addMod(long[] a, int idx, long val) {\n        a[idx] = (a[idx] + val) % MOD;\n    }\n\n    static Matrix mul(Matrix A, Matrix B) {\n        Matrix C = new Matrix(A.rows, B.cols);\n        for (int i = 0; i < A.rows; i++) {\n            for (int k = 0; k < A.cols; k++) {\n                for (int j = 0; j < B.cols; j++) {\n                    C.data[i][j] = (C.data[i][j] + A.data[i][k] * B.data[k][j]) % MOD;\n                }\n            }\n        }\n        return C;\n    }\n\n    static void show_mat(Matrix A) {\n        for (int i = 0; i < A.rows; i++) {\n            for (int j = 0; j < A.cols; j++) {\n                System.out.print(A.data[i][j] + \" \");\n            }\n            System.out.println();\n        }\n        System.out.println();\n    }\n\n    public static void main(String[] args) throws IOException {\n        Scanner sc = new Scanner(System.in);\n        long N = sc.nextLong();\n        int K = sc.nextInt();\n\n        int cnt = 0;\n        long nN = 1;\n        while (nN <= N) {\n            nN *= K;\n            cnt++;\n        }\n        nN /= K;\n\n        int[] d = new int[cnt];\n        for (int i = 0; i < cnt; i++) {\n            d[i] = (int) (N / nN);\n            N %= nN;\n            nN /= K;\n        }\n\n        for (int i = 0; i <= K; i++) {\n            R[i] = new Matrix(1, 1);\n            mat_