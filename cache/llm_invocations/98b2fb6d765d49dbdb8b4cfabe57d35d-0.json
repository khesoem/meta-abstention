+) {\n                    long t = (cur * a[j + len]) % MOD;\n                    long u = a[j];\n                    a[j] = (u + t) % MOD;\n                    a[j + len] = ((u - t) % MOD + MOD) % MOD;\n                    cur = (cur * ws[s]) % MOD;\n                }\n            }\n        }\n        if (inv) {\n            long invN = modInv(a.length);\n            for (int i = 0; i < a.length; i++) a[i] = (a[i] * invN) % MOD;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt() / 2;\n        int m = sc.nextInt();\n        int[] arr = new int[m];\n        for (int i = 0; i < m; i++) arr[i] = sc.nextInt();\n        Arrays.sort(arr);\n        int minLen = n * arr[m - 1] + 2;\n        int lg = 0, len = 1;\n        while (len < minLen) {\n            len <<= 1;\n            lg++;\n        }\n        long[] poly = new long[len];\n        for (int v : arr) poly[bitReverse(v, lg)] = 1;\n        ntt(poly, lg, false);\n        for (int i = 0; i < len; i++) poly[i] = modPow((int) poly[i], n);\n        long[] buf = new long[len];\n        for (int i = 0; i < len; i++) buf[bitReverse(i, lg)] = (poly[i] % MOD + MOD) % MOD;\n        poly = buf;\n        ntt(poly, lg, true);\n        long sum = 0;\n        for (int i = 0; i < len; i++) sum = (sum + poly[i] * poly[i]) % MOD;\n        long invLen = modInv(len);\n        System.out.println((sum * invLen % MOD) * invLen % MOD);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nMOD = 998244353\nROOT = 15311432\nINVROOT = 469870224\n\ndef bit_reverse(n, k):\n    # Reverse bits of n and shift right to get k bits\n    rev = 0\n    for _ in range(k):\n        rev = (rev << 1) | (n & 1)\n        n >>= 1\n    return rev\n\ndef mod_pow(b, e):\n    r = 1\n    b %= MOD\n    while e > 0:\n        if e & 1:\n            r = (r * b) % MOD\n        b = (b * b) % MOD\n        e >>= 1\n    return r\n\ndef mod_inv(x):\n    return mod_pow(x, MOD - 2)\n\ndef ntt(a, lg, inv):\n    br = INVROOT if inv else ROOT\n    w = mod_pow(br, 1 << (23 - lg))\n    ws = [0] * lg\n    ws[lg - 1] = w\n    for i in range(lg - 1, 0, -1):\n        ws[i - 1] = (ws[i] * ws[i]) % MOD\n    \n    a = a[:]  # Make a copy to avoid modifying original\n    for s in range(lg):\n        len_ = 1 << s\n        for st in range(0, len(a), 2 * len_):\n            cur = 1\n            for j in range(st, st + len_):\n                t = (cur * a[j + len_]) % MOD\n                u = a[j]\n                a[j] = (u + t) % MOD\n                a[j + len_] = ((u - t) % MOD + MOD) % MOD\n                cur = (cur * ws[s]) % MOD\n    \n    if inv:\n        inv_n = mod_inv(len(a))\n        for i in range(len(a)):\n            a[i] = (a[i] * inv_n) % MOD\n    return a\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0]) // 2\n    m = int(data[1])\n    arr = [int(data[2 + i]) for i in range(m)]\n    arr.sort()\n    min_len = n * arr[-1] + 2\n    lg = 0\n    length = 1\n    while length < min_len:\n        length <<= 1\n        lg += 1\n    \n    poly = [0] * length\n    for v in arr:\n        poly[bit_reverse(v, lg)] = 1\n    \n    poly = ntt(poly, lg, False)\n    for i in range(length):\n        poly[i] = mod_pow(int(poly[i]), n)\n    \n    buf = [0] * length\n    for i in range(length):\n        buf[bit_reverse(i, lg)] = (poly[i] % MOD + MOD) % MOD\n    poly = buf\n    \n    poly = ntt(poly, lg, True)\n    \n    total_sum = 0\n    for i in range(length):\n        total_sum = (total_sum + poly[i] * poly[i]) % MOD\n    \n    inv_length = mod_inv(length)\n    result = (total_sum * inv_length % MOD) * inv_length % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.972207145532593e-05, -5.960462772236497e-07