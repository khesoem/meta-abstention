ic long long[] d;\n    static int[] p;\n    static int[] pe;\n    static int[] inq;\n\n    static long long INF64 = (long long)(1e18);\n\n    static int s = N - 2;\n    static int t = N - 1;\n\n    static int rem(int x) {\n        return e.get(x).c - e.get(x).f;\n    }\n\n    static void push_flow() throws IOException {\n        for (int i = 0; i < N; i++) {\n            d[i] = INF64;\n            p[i] = -1;\n            pe[i] = -1;\n            inq[i] = 0;\n        }\n        d[s] = 0;\n        ArrayDeque<Integer> q = new ArrayDeque<>();\n        q.add(s);\n        inq[s] = 1;\n        while (!q.isEmpty()) {\n            int k = q.poll();\n            inq[k] = 0;\n            for (int x : g[k]) {\n                if (rem(x) == 0) continue;\n                int c = e.get(x).cost;\n                int y = e.get(x).y;\n                if (d[y] > d[k] + c) {\n                    d[y] = d[k] + c;\n                    p[y] = k;\n                    pe[y] = x;\n                    if (inq[y] == 0) {\n                        inq[y] = 1;\n                        q.add(y);\n                    }\n                }\n            }\n        }\n        int cur = t;\n        while (cur != s) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = p[cur];\n        }\n        ans += d[t];\n    }\n\n    static void add_edge(int x, int y, int c, int cost) {\n        g[x].add(e.size());\n        e.add(new Edge(y, c, 0, cost));\n        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        e = new ArrayList<>();\n        g = new ArrayList[N];\n        for (int i = 0; i < N; i++) {\n            g[i] = new ArrayList<>();\n        }\n        d = new long[N];\n        p = new int[N];\n        pe = new int[N];\n        inq = new int[N];\n        for (int i = 0; i < k; i++) {\n            int x;\n            x = Integer.parseInt(br.readLine());\n            --x;\n            add_edge(s, x, 1, 0);\n        }\n        int tt = 101;\n        for (int i = 0; i < tt; i++) {\n            add_edge(0 + i * n, t, k, i * c);\n        }\n        for (int i = 0; i < m; i++) {\n            int x, y;\n            st = new StringTokenizer(br.readLine());\n            x = Integer.parseInt(st.nextToken());\n            y = Integer.parseInt(st.nextToken());\n            --x;\n            --y;\n            for (int j = 0; j < tt - 1; j++) {\n                for (int l = 0; l < k; l++) {\n                    add_edge(x + j * n, y + j * n + n, 1, d * (l * 2 + 1));\n                }\n            }\n            for (int j = 0; j < tt - 1; j++) {\n                for (int l = 0; l < k; l++) {\n                    add_edge(y + j * n, x + j * n + n, 1, d * (l * 2 + 1));\n                }\n            }\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < tt - 1; j++) {\n                add_edge(i + j * n, i + j * n + n, k, 0);\n            }\n        }\n        for (int i = 0; i < k; i++) {\n            push_flow();\n        }\n        pw.println(ans);\n        pw.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.2543857991695404, -0.007836689241230488, -0.22705595195293427, -0.035139430314302444, -0.00012255465844646096, -0.3489931523799896, -0.6759709715843201, -3.71939895558171e-05, -9.417578439752106e-06, -7.391003236989491e-06, -1.5974172129062936e-05, -0.08911296725273132, -3.576279254957626e-07, -5.960466182841628e-07,