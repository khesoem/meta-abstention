D = 1000000007;\n    static final int MAXN = 32;\n    static int n;\n\n    static class Matrix {\n        int[][] val = new int[MAXN][MAXN];\n\n        Matrix() {\n            for (int i = 0; i < MAXN; i++) {\n                for (int j = 0; j < MAXN; j++) {\n                    val[i][j] = 0;\n                }\n            }\n        }\n\n        void set_identity() {\n            for (int i = 0; i < MAXN; i++) {\n                for (int j = 0; j < MAXN; j++) {\n                    val[i][j] = 0;\n                }\n            }\n            for (int i = 1; i <= n + 1; i++) {\n                val[i][i] = 1;\n            }\n        }\n\n        Matrix multiply(Matrix rhs) {\n            Matrix res = new Matrix();\n            for (int i = 1; i <= n + 1; i++) {\n                for (int j = 1; j <= n + 1; j++) {\n                    for (int k = 1; k <= n + 1; k++) {\n                        res.val[i][j] = (int) ((res.val[i][j] + 1L * val[i][k] * rhs.val[k][j]) % MOD);\n                    }\n                }\n            }\n            return res;\n        }\n    }\n\n    static int input_int() throws IOException {\n        int x = 0, sign = 1;\n        int c = System.in.read();\n        while (c != '-' && (c < '0' || c > '9')) {\n            c = System.in.read();\n        }\n        if (c == '-') {\n            sign = -1;\n            c = System.in.read();\n        }\n        while (c >= '0' && c <= '9') {\n            x = x * 10 + (c - '0');\n            c = System.in.read();\n        }\n        return x * sign;\n    }\n\n    static long input_ll() throws IOException {\n        long x = 0, sign = 1;\n        int c = System.in.read();\n        while (c != '-' && (c < '0' || c > '9')) {\n            c = System.in.read();\n        }\n        if (c == '-') {\n            sign = -1;\n            c = System.in.read();\n        }\n        while (c >= '0' && c <= '9') {\n            x = x * 10 + (c - '0');\n            c = System.in.read();\n        }\n        return