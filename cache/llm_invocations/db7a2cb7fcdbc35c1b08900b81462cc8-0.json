[j]<='9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        if (t<m) for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    n, m = map(int, data[0].split())\n    buf = []\n    idx = 1\n    for i in range(n):\n        buf.append(data[idx])\n        idx += 1\n    \n    # Initialize edge as list of dictionaries\n    edge = [dict() for _ in range(7000)]\n    \n    # enc function\n    def enc(x, y, t):\n        return x + y * n + t * n * n + 2\n    \n    # Calculate tox array\n    tox = [[m + 1] * n for _ in range(n)]\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    \n    bfs = deque()\n    for i in range(n):\n        for j in range(n):\n            if buf[i][j] == 'Z':\n                tox[i][j] = 0\n                bfs.append((i, j))\n    \n    while bfs:\n        x, y = bfs.popleft()\n        t = tox[x][y]\n        for i in range(4):\n            nx = x + dx[i]\n            ny = y + dy[i]\n            if 0 <= nx < n and 0 <= ny < n and buf[nx][ny] != 'Y' and t + 1 < tox[nx][ny]:\n                tox[nx][ny] = t + 1\n                bfs.append((nx, ny))\n    \n    # Process first part of input\n    for i in range(n):\n        for j in range(n):\n            if buf[i][j] > '0' and buf[i][j] <= '9':\n                edge[0][enc(i, j, 0)] = ord(buf[i][j]) - ord('0')\n    \n    # Process second part of input\n    for i in range(n):\n        if idx < len(data):\n            buf[i] = data[idx]\n            idx += 1\n    \n    # Reset tox for second pass\n    tox = [[m + 1] * n for _ in range(n)]\n    bfs = deque()\n    for i in range(n):\n        for j in range(n):\n            if buf[i][j] == 'Z':\n                tox[i][j] = 0\n                bfs.append((i, j))\n    \n    while bfs:\n        x, y = bfs.popleft()\n        t = tox[x][y]\n        for i in range(4):\n            nx = x + dx[i]\n            ny = y + dy[i]\n            if 0 <= nx < n and 0 <= ny < n and buf[nx][ny] != 'Y' and t + 1 < tox[nx][ny]:\n                tox[nx][ny] = t + 1\n                bfs.append((nx, ny))\n    \n    vn = enc(n-1, n-1, m) + 1\n    \n    # Build the graph\n    for i in range(n):\n        for j in range(n):\n            for t in range(m):\n                for q in range(4):\n                    x = i + dx[q]\n                    y = j + dy[q]\n                    if (0 <= x < n and 0 <= y < n and \n                        buf[x][y] != 'Y' and \n                        t + 1 < tox[x][y] + (1 if (buf[x][y] > '0' and buf[x][y] <= '9') else 0) and \n                        t < tox[i][j]):\n                        edge[enc(i, j, t)][enc(x, y, t + 1)] = 1000\n                \n                if buf[i][j] > '0' and buf[i][j] <= '9':\n                    edge[enc(i, j, t)][enc(i, j, m)] = ord(buf[i][j]) - ord('0')\n            \n            if buf[i][j] > '0' and buf[i][j] <= '9':\n                edge[enc(i, j, m)][1] = ord(buf[i][j]) - ord('0')\n    \n    # Augmenting path function\n    def aug(s, t, cap):\n        result = 0\n        for _ in range(1):\n            from_arr = [-1] * vn\n            flow = [0] * vn\n            from_arr[s] = s\n            flow[s] = cap\n            bfs = deque()\n            bfs.append(s)\n            \n            while bfs:\n                x = bfs.popleft()\n                if x == t:\n                    aug_flow = flow[t]\n                    cur = t\n                    while cur != s:\n                        prev = from_arr[cur]\n                        edge[prev][cur] -= aug_flow\n                        if cur in edge[prev]:\n                            edge[prev][cur] -= aug_flow\n                        else:\n                            edge[prev][cur] = -aug_flow\n                        if prev in edge[cur]:\n                            edge[cur][prev] += aug_flow\n                        else:\n                            edge[cur][prev] = aug_flow\n                        cur = prev\n                    result += aug_flow\n                    break\n                \n                if x in edge:\n                    for e in edge[x]:\n                        if edge[x][e] >= cap and from_arr[e] == -1:\n                            from_arr[e] = x\n                            flow[e] = min(edge[x][e], flow[x])\n                            bfs.append(e)\n        \n        return result\n    \n    res = 0\n    u = 8\n    while u:\n        res += aug(0, 1, u)\n        u //= 2\n    \n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.45\n</confidence>", "token_logprobs": [-0.00015090756642166525, -1.0728830375228426e-06, -3.576278118089249e-07, -0.049239493906497955, -0.006330437492579222, -2.3841855067985307e-07, -3.158996332786046e-05, -0.0001426833332516253, -7.152555099310121e-07, -0.016037866473197937, -0.014375925995409489, -0.026077480986714363, -0.48654693365097046, -6.007967749610543e-05, -1.1920922133867862e-06, -0.16160285472869873, -0.15219905972480774, -2.47952248173533e-05, -9.298280929215252e-06, -0.11046719551086426, -0.0017779747722670436, -4.291525328881107e-06, -0.0011961455456912518, -3.576278118089249e-07, -1.9550132492440753e-05, -2.0265558760002023e-06, -0.0003859252028632909, -0.264395147562027, -1.7881377516459906e-06, -0.6326024532318115, -1.0728830375228426e-06, -0.2791523337364197, -0.00195526541210711, -1.1920928244535389e-07, -1.4305104514278355e-06, -0.00017915551143232733, -2.622600959512056e-06, -2.3841855067985307e-07, -1.0728830375228426e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.00011538793478393927, -9.536697689327411e-06, -5.364403477869928e-06, -0.3484545052051544, -0.0717887207865715, -3.802703940891661e-05, -0.0031884093768894672, -0.012511925771832466, -0.05453423783183098, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, -0.6326563954353333, -2.3841855067985307e-07, -5.125868119648658e-05, -0.002186052966862917, -7.152555099310121e-07, -1.1920928244535389e-07, -2.3841830625315197e-06, -1.0728830375228426e-06, -4.768370445162873e-07, -0.5350236892700195, -1.823885577323381e-05, -0.05502515286207199, -2.7418097943154862e-06, -0.01573515497148037, -1.1920928244535389e-07, -1.0013530300057027e-05, -5.960462772236497e-07, 0.0, 0.0, -0.015253910794854164, -4.6491513785440475e-06, -0.3033168613910675, -0.15333083271980286, -0.29848480224609375, -0.03846558928489685, -0.320067435503006, -3.576272320060525e-06, -0.01730814203619957, -0.06913880258798599, -8.344646857949556e-07, -0.66878992319