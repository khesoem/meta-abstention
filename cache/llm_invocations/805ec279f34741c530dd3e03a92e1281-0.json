h:\n    def __init__(self, vNum, src, sink):\n        self.vNum = vNum\n        self.src = src\n        self.sink = sink\n        self.edges = []\n        self.p = [-1] * vNum\n        self.d = [0] * vNum\n\n    def addEdge(self, from_, to, capacity, cost):\n        self.edges.append(Edge(from_, to, capacity, cost, len(self.edges) + 1))\n        self.edges.append(Edge(to, from_, 0, -cost, len(self.edges) - 1))\n\n    def findCheapestPath(self):\n        INF = 10**9\n        self.d = [INF] * self.vNum\n        self.p = [-1] * self.vNum\n        self.d[self.src] = 0\n        for _ in range(self.vNum - 1):\n            changed = False\n            for e in self.edges:\n                if e.cap > 0 and self.d[e.from_] != INF and self.d[e.from_] + e.cost < self.d[e.to]:\n                    self.d[e.to] = self.d[e.from_] + e.cost\n                    self.p[e.to] = e.from_\n                    changed = True\n            if not changed:\n                break\n        return self.p[self.sink] != -1\n\n    def augmentPath(self, from_, to, flow):\n        pathCost = 0\n        # find min capacity along path\n        cur = to\n        while cur != from_:\n            prev = self.p[cur]\n            for e in self.edges:\n                if e.from_ == prev and e.to == cur and e.cap > 0:\n                    flow = min(flow, e.cap)\n                    break\n            cur = prev\n        # augment\n        cur = to\n        while cur != from_:\n            prev = self.p[cur]\n            for e in self.edges:\n                if e.from_ == prev and e.to == cur and e.cap > 0:\n                    e.cap -= flow\n                    self.edges[e.rev].cap += flow\n                    pathCost += e.cost * flow\n                    break\n            cur = prev\n        return [flow, pathCost]\n\n    def getMinCostMaxFlow(self):\n        flow = 0\n        totalCost = 0\n        while self.findCheapestPath():\n            result = self.augmentPath(self.src, self.sink, 10**9)\n     