io.*;\nimport java.util.*;\nimport java.math.*;\nimport java.lang.*;\n\nimport static java.lang.Math.*;\n\npublic class Main implements Runnable {\n    static class Reader {\n        private final BufferedReader in;\n        private String line;\n        private StringTokenizer tokenizer;\n\n        public Reader() {\n            in = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        private void readLine() {\n            try {\n                line = in.readLine();\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n\n        private void tokenize() {\n            tokenizer = new StringTokenizer(line);\n        }\n\n        private String nextToken() {\n            if (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                readLine();\n                tokenize();\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(nextToken());\n        }\n\n        public long nextLong() {\n            return Long.parseLong(nextToken());\n        }\n\n        public double nextDouble() {\n            return Double.parseDouble(nextToken());\n        }\n    }\n\n    static long modPow(long base, long exponent, long modulus) {\n        long result = 1;\n        base = base % modulus;\n        while (exponent > 0) {\n            if ((exponent & 1) == 1) result = (result * base) % modulus;\n            exponent = exponent >> 1;\n            base = (base * base) % modulus;\n        }\n        return result;\n    }\n\n    static long modInverse(long a, long m) {\n        return modPow(a, m - 2, m);\n    }\n\n    static int[][][][] cache;\n\n    int explore(int index, int[] data, int total, int threshold, int accumulated, int odd, int taken) {\n        if (index == total) return 0;\n        if (cache[index][accumulated][odd][taken] != -1)\n            return cache[index][accumulated][odd][taken];\n\n        int include = 0;\n        if (accumulated + Math.abs(data[index] - data[index - 1]) <= threshold && taken - odd == odd) {\n            include = 1 + explore(index + 1, data, total, threshold,\n                    accumulated + Math.abs(data[index] - data[index - 1]),\n                    odd + (data[index] % 2 == 1 ? 1 : 0), taken + 1);\n        }\n\n        int exclude = explore(index + 1, data, total, threshold,\n                accumulated, odd + (data[index] % 2 == 1 ? 1 : 0), taken + 1);\n\n        return cache[index][accumulated][odd][taken] = Math.max(include, exclude);\n    }\n\n    public void run() {\n        Reader reader = new Reader();\n        PrintWriter output = new PrintWriter(System.out);\n\n        int n = reader.nextInt();\n        int k = reader.nextInt();\n        int[] sequence = new int[n];\n        for (int i = 0; i < n; i++) {\n            sequence[i] = reader.nextInt();\n        }\n\n        cache = new int[101][101][101][101];\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < 101; j++) {\n                for (int k1 = 0; k1 < 101; k1++) {\n                    Arrays.fill(cache[i][j][k1], -1);\n                }\n            }\n        }\n\n        int finalResult = explore(1, sequence, n, k, 0, (sequence[0] % 2 == 1) ? 1 : 0, 1);\n        output.println(finalResult);\n        output.close();\n    }\n\n    public static void main(String[] args) throws Exception {\n        new Thread(null, new Main(), \"Main\", 1 << 26).start();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\nimport java.math.*;\nimport java.lang.*;\n\nimport static java.lang.Math.*;\n\npublic class Main implements Runnable {\n    static class Reader {\n        private final BufferedReader in;\n        private String line;\n        private StringTokenizer tokenizer;\n\n        public Reader() {\n            in = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        private void readLine() {\n            try {\n                line = in.readLine();\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n\n        private void tokenize() {\n            tokenizer = new StringTokenizer(line);\n        }\n\n        private String nextToken() {\n            if (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                readLine();\n                tokenize();\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(nextToken());\n        }\n\n        public long nextLong() {\n            return Long.parseLong(nextToken());\n        }\n\n        public double nextDouble() {\n            return Double.parseDouble(nextToken());\n        }\n    }\n\n    public void run() {\n        Reader reader = new Reader();\n        PrintWriter output = new PrintWriter(System.out);\n\n        int n = reader.nextInt();\n        int budget = reader.nextInt();\n        int[] sequence = new int[n];\n        for (int i = 0; i < n; i++) {\n            sequence[i] = reader.nextInt();\n        }\n\n        // Precompute prefix sums for odd and even counts\n        int[] oddPrefix = new int[n + 1];\n        int[] evenPrefix = new int[n + 1];\n        for (int i = 0; i < n; i++) {\n            oddPrefix[i + 1] = oddPrefix[i] + (sequence[i] % 2 == 1 ? 1 : 0);\n            evenPrefix[i + 1] = evenPrefix[i] + (sequence[i] % 2 == 0 ? 1 : 0);\n        }\n\n        // Find all valid cut positions\n        List<Integer> cutPositions = new ArrayList<>();\n        List<Integer> cutCosts = new ArrayList<>();\n        \n        for (int i = 1; i < n; i++) {\n            // Check if prefix [0, i) has equal odd and even counts\n            int oddCount = oddPrefix[i];\n            int evenCount = evenPrefix[i];\n            if (oddCount == evenCount) {\n                // This position is a valid cut point\n                int cost = Math.abs(sequence[i - 1] - sequence[i]);\n                cutPositions.add(i);\n                cutCosts.add(cost);\n            }\n        }\n\n        // Now we need to select maximum number of cuts with total cost <= budget\n        // This is a classic knapsack problem where we want to maximize count (each cut = 1)\n        int m = cutPositions.size();\n        if (m == 0) {\n            output.println(0);\n            output.close();\n            return;\n        }\n\n        // dp[i][j] = maximum number of cuts we can make using first i cuts with total cost j\n        // But budget can be up to 10^4, and number of cuts up to 50, so we can do DP on cuts\n        // Alternative: greedy won't work, so use DP where dp[i] = minimum cost to make i cuts\n        int[] minCost = new int[m + 1];\n        Arrays.fill(minCost, Integer.MAX_VALUE);\n        minCost[0] = 0;\n\n        for (int i = 0; i < m; i++) {\n            int cost = cutCosts.get(i);\n            for (int j = m; j >= 1; j--) {\n                if (minCost[j - 1] != Integer.MAX_VALUE) {\n                    minCost[j] = Math.min(minCost[j], minCost[j - 1] + cost);\n                }\n            }\n        }\n\n        int maxCuts = 0;\n        for (int i = m; i >= 0; i--) {\n            if (minCost[i] <= budget) {\n                maxCuts = i;\n                break;\n            }\n        }\n\n        output.println(maxCuts);\n        output.close();\n    }\n\n    public static void main(String[] args) throws Exception {\n        new Thread(null, new Main(), \"Main\", 1 << 26).start();\n    }\n}\n</repaired_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, -8.916457591112703e-05, -2.264974000354414e-06, 0.0, -2.7179348762729205e-05, -2.1815061700181104e-05, -1.5497195136049413e-06, -1.1086402082582936e-05, -3.0517112463712692e-05, -1.168244216387393e-05