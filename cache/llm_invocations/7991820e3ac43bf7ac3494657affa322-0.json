ask < totalMasks; ++mask) {\n\t\t\tfor (int i = 0; i < n; ++i) {\n\t\t\t\tif (mask & (1 << i)) bits[mask].push_back(i);\n\t\t\t}\n\t\t}\n\n\t\tvector<double> dp(totalMasks, 0.0);\n\t\tdp[0] = 1.0;\n\t\tfor (int mask = 0; mask < totalMasks; ++mask) {\n\t\t\tint rmask = (~mask) & (totalMasks - 1);\n\t\t\tfor (int i : bits[rmask]) {\n\t\t\t\tif (p[i] > 1e-5) {\n\t\t\t\t\tdp[mask | (1 << i)] += dp[mask] * p[i] / sum[rmask];\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tvector<double> ans(n, 0.0);\n\t\tfor (int mask = 0; mask < totalMasks; ++mask) {\n\t\t\tif (bits[mask].size() != k) continue;\n\t\t\tfor (int i : bits[mask]) ans[i] += dp[mask];\n\t\t}\n\n\t\tfor (int i = 0; i < n; i++) cout << ans[i] << \" \\n\"[i + 1 == n];\n\t}\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    idx = 0\n    out_lines = []\n    while idx < len(data):\n        n = int(data[idx]); k = int(data[idx+1]); idx += 2\n        p = [float(data[idx+i]) for i in range(n)]; idx += n\n\n        totalMasks = 1 << n\n        # compute sum using lowbit DP\n        sum_mask = [0.0] * totalMasks\n        for mask in range(1, totalMasks):\n            lowbit = mask & -mask\n            # index of lowbit (0-based)\n            bit_idx = (lowbit.bit_length() - 1)\n            sum_mask[mask] = sum_mask[mask ^ lowbit] + p[bit_idx]\n\n        cnt = sum(1 for pi in p if pi > 1e-5)\n        if cnt <= k:\n            ans = [1.0 if pi > 1e-5 else 0.0 for pi in p]\n            out_lines.append(' '.join(f\"{x:.15f}\" for x in ans))\n            continue\n\n        # Precompute list of set bits for each mask\n        bits = [[] for _ in range(totalMasks)]\n        for mask in range(totalMasks):\n            for i in range(n):\n                if mask & (1 << i):\n                    bits[