{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3.11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3.11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int maxn = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, cnt, ans, a[maxn], x[maxn], y[maxn];\nint head[maxn], pre[maxn], dist[maxn], inq[maxn];\nqueue<int> q;\nstruct edge { int to, cap, cost, nxt; } e[2000010];\nint id(int t, int v) { return t * n + v; }\n\nvoid add(int from, int to, int cap, int cost) {\n    e[cnt] = (edge){to, cap, cost, head[from]}, head[from] = cnt++;\n    e[cnt] = (edge){from, 0, -cost, head[to]}, head[to] = cnt++;\n}\n\nbool spfa(int s, int t) {\n    memset(dist, 0x3f, sizeof(dist));\n    q.push(s), dist[s] = 0;\n    while (!q.empty()) {\n        int v = q.front(); q.pop(), inq[v] = 0;\n        for (int i = head[v], u; ~i; i = e[i].nxt) {\n            if (e[i].cap && dist[u = e[i].to] > dist[v] + e[i].cost) {\n                dist[u] = dist[v] + e[i].cost, pre[u] = i;\n                if (!inq[u]) q.push(u), inq[u] = 1;\n            }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid upd(int s, int t) {\n    for (int i = t; i ^ s; i = e[pre[i] ^ 1].to) {\n        e[pre[i]].cap--, e[pre[i] ^ 1].cap++;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &a[i]), add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &x[i], &y[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            for (int j = 1; j <= min(k, 25); j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn, m, k, c, d = map(int, input().split())\nmaxn = 6010\nINF = 10**9\n\na = [0] * maxn\nx = [0] * (maxn)\ny = [0] * (maxn)\n\nhead = [-1] * maxn\npre = [0] * maxn\ndist = [INF] * maxn\ninq = [0] * maxn\n\nclass Edge:\n    def __init__(self, to, cap, cost, nxt):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.nxt = nxt\n\ne = []\n\ndef id_node(t, v):\n    return t * n + v\n\ndef add(from_, to, cap, cost):\n    global cnt\n    e.append(Edge(to, cap, cost, head[from_]))\n    head[from_] = cnt\n    cnt += 1\n    e.append(Edge(from_, 0, -cost, head[to]))\n    head[to] = cnt\n    cnt += 1\n\ndef spfa(s, t):\n    for i in range(maxn):\n        dist[i] = INF\n    from collections import deque\n    q = deque()\n    q.append(s)\n    dist[s] = 0\n    for i in range(maxn):\n        inq[i] = 0\n    inq[s] = 1\n    while q:\n        v = q.popleft()\n        inq[v] = 0\n        i = head[v]\n        while i != -1:\n            u = e[i].to\n            if e[i].cap > 0 and dist[u] > dist[v] + e[i].cost:\n                dist[u] = dist[v] + e[i].cost\n                pre[u] = i\n                if not inq[u]:\n                    q.append(u)\n                    inq[u] = 1\n            i = e[i].nxt\n    return dist[t] < INF\n\ndef upd(s, t):\n    nonlocal ans\n    i = t\n    while i != s:\n        e[pre[i]].cap -= 1\n        e[pre[i]^1].cap +=1\n        i = e[pre[i]^1].to\n    ans += dist[t]\n\n\nn, m, k, c, d = map(int, input().split())\nS = 0\nT = 6000\n\ncnt = 0\ne.clear()\n\nfor i in range(maxn):\n    head[i] = -1\n    pre[i] = 0\n    dist[i] = INF\n    inq[i] = 0\n\nfor i in range(1, k+1):\n    a[i] = int(input())\n    add(S, id_node(0, a[i]), 1, 0)\n\nfor i in range(1, m+1):\n    x[i], y[i] = map(int, input().split())\n\nfor t in range(0, 101):\n    for i in range(2, n+1):\n        add(id_node(t, i), id_node(t + 1, i), k, c)\n    add(id_node(t, 1), T, k, 0)\n    for i in range(1, m+1):\n        for j in range(1, min(k, 25)+1):\n            add(id_node(t, x[i]), id_node(t + 1, y[i]), 1, c + (2*j - 1)*d)\n            add(id_node(t, y[i]), id_node(t + 1, x[i]), 1, c + (2*j - 1)*d)\n\nans = 0\nwhile spfa(S, T):\n    upd(S, T)\n\nprint(ans)\n</translated_code>\n<confidence>\n0.8\n</confidence>", "token_logprobs": [-0.00022642381372861564, -0.0006103330524638295, -3.128163257315464e-07, -7.3458322731312364e-06, -0.7052440643310547, -0.04907882586121559, 0.0, -1.5048530030981055e-06, -1.7432603272027336e-06, -1.3856492842023727e-06, -1.9361264946837764e-07, -6.749814019713085e-06, 0.0, -7.896309739408025e-07, -3.128163257315464e-07, -6.704273118884885e-07, -9.088346359931165e-07, -1.9361264946837764e-07, 0.0, -1.7432603272027336e-06, -0.31349271535873413, -0.8478419184684753, -0.0004801240866072476, -0.00012689977302215993, 0.0, -9.849109119386412e-06, -7.896309739408025e-07, -0.020593974739313126, -0.0004934602184221148, -3.173704271830502e-06, -0.023679593577980995, -0.033872976899147034, 