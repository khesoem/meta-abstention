tring>\n#include <sstream>\nusing namespace std;\n\nint ncr(int n, int r) {\n    if (r > n) return 0;\n    int ans = 1;\n    for (int i = n; i > n - r; i--) ans *= i;\n    for (int i = 2; i <= r; i++) ans /= i;\n    return ans;\n}\n\ndouble probab(int n, int x) {\n    int a = ncr(x, 3) * ncr(n - x, 0);\n    int b = ncr(x, 2) * ncr(n - x, 1);\n    int c = ncr(x, 1) * ncr(n - x, 2);\n    return (1.0 * ((3.0 / 6) * c + a + b)) / ncr(n, 3);\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    int n;\n    double p;\n    iss >> n >> p;\n    int i;\n    for (i = 0; i <= n; i++) {\n        if (probab(n, i) >= p) break;\n    }\n    cout << i << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.352353764465079e-05, 0.0, -4.768370445162873e-07, -0.0002740246127359569, -9.595887240720913e-05, -2.145764938177308e-06, -0.0020048771984875202, -0.008649740368127823, -0.2014247328042984, -1.1920928244535389e-07, -0.32646167278289795, -0.018173959106206894, -0.023246262222528458, 0.0, -0.03216686472296715, 0.0, -0.20149198174476624, -0.16022847592830658, -5.960462772236497e-07, 0.0, -1.4305104514278355e-06, -0.001437702914699912, -2.3841855067985307e-07, -4.565611743601039e-05, -3.576278118089249e-07, -1.1920928244535389e-07, -0.0024757706560194492, 0.0, 0.0, -0.0007194076315499842, -7.152555099310121e-07, -3.3378546504536644e-06, 0.0, -0.004078404977917671, 0.0, -3.6954811548639555e-06, 0.0, -2.622600959512056e-06, 0.0, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.3589766240329482e-05, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -0.00012432756193447858, 0.0, -6.317892984952778e-05, -8.940656698541716e-06, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -4.768360213347478e-06, 0.0, 0.0, -0.2014138251543045, -0.00026127262390218675, -6.556489552167477e-06, -1.1920928244535389e-07, 0.0, -1.4305104514278355e-06, 0.0, -1.1920928