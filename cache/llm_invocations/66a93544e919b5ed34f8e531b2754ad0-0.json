     for (int idx : node_edges[u]) {\n            int v = edge_list[idx].dst;\n            if (edge_list[idx].capacity > edge_list[idx].flow && distance[v] > distance[u] + edge_list[idx].weight) {\n                distance[v] = distance[u] + edge_list[idx].weight;\n                prev_edge[v] = idx;\n                flow_limit[v] = min(flow_limit[u], edge_list[idx].capacity - edge_list[idx].flow);\n                if (!in_queue[v]) {\n                    q.push(v);\n                    in_queue[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (distance[sink_node] == INF) return {0, 0};\n\n    int augment = flow_limit[sink_node];\n    int cur = sink_node;\n    while (cur != source_node) {\n        int eid = prev_edge[cur];\n        edge_list[eid].flow += augment;\n        edge_list[eid ^ 1].flow -= augment;\n        cur = edge_list[eid].src;\n    }\n\n    return {augment, augment * distance[sink_node]};\n}\n\npair<int, int> min_cost_max_flow(int n) {\n    int total_flow = 0, total_cost = 0;\n    while (true) {\n        auto [f, c] = shortest_path(n);\n        if (f == 0) break;\n        total_flow += f;\n        total_cost += c;\n    }\n    return {total_flow, total_cost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        adj_list[u].push_back(v);\n        adj_list[v].push_back(u);\n    }\n\n    source_node = 0;\n    sink_node = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            insert_edge(n * t + i, n * (t + 1) + i, k, 0);\n            for (int neighbor : adj_list[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    insert_edge(n * t + i, n * (t + 1) + neighbor, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        if (freq[i]) {\n            insert_edge(source_node, i, freq[i], 0);\n        }\n    }\n\n    for (int t = 0; t <= 100; ++t) {\n        insert_edge(n * t + 1, sink_node, k, c * t);\n    }\n\n    cout << min_cost_max_flow(sink_node).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_NODES = 1000002;\n    static final int INF = 1000000000;\n\n    static int[] freq = new int[MAX_NODES];\n    static int source_node, sink_node;\n    static ArrayList<Integer>[] adj_list = new ArrayList[MAX_NODES];\n\n    static class Edge {\n        int src, dst, flow, capacity, weight;\n        Edge(int src, int dst, int flow, int capacity, int weight) {\n            this.src = src;\n            this.dst = dst;\n            this.flow = flow;\n            this.capacity = capacity;\n            this.weight = weight;\n        }\n    }\n\n    static ArrayList<Edge> edge_list = new ArrayList<>();\n    static ArrayList<Integer>[] node_edges = new ArrayList[MAX_NODES];\n\n    static void insert_edge(int u, int v, int cap, int w) {\n        edge_list.add(new Edge(u, v, 0, cap, w));\n        node_edges[u].add(edge_list.size() - 1);\n        edge_list.add(new Edge(v, u, 0, 0, -w));\n        node_edges[v].add(edge_list.size() - 1);\n    }\n\n    static int[] distance = new int[MAX_NODES];\n    static int[] in_queue = new int[MAX_NODES];\n    static int[] flow_limit = new int[MAX_NODES];\n    static int[] prev_edge = new int[MAX_NODES];\n\n    static class Result {\n        int flow;\n        int cost;\n        Result(int flow, int cost) {\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static Result shortest_path(int n) {\n        Arrays.fill(distance, 0, n + 2, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(source_node);\n        distance[source_node] = 0;\n        in_queue[source_node] = 1;\n        flow_limit[source_node] = INF;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            in_queue[u] = 0;\n            for (int idx : node_edges[u]) {\n                Edge e = edge_list.get(idx);\n                int v = e.dst;\n                if (e.capacity > e.flow && distance[v] > distance[u] + e.weight) {\n                    distance[v] = distance[u] + e.weight;\n                    prev_edge[v] = idx;\n                    flow_limit[v] = Math.min(flow_limit[u], e.capacity - e.flow);\n                    if (in_queue[v] == 0) {\n                        q.offer(v);\n                        in_queue[v] = 1;\n                    }\n                }\n            }\n        }\n\n        if (distance[sink_node] == INF) return new Result(0, 0);\n\n        int augment = flow_limit[sink_node];\n        int cur = sink_node;\n        while (cur != source_node) {\n            int eid = prev_edge[cur];\n            Edge e = edge_list.get(eid);\n            e.flow += augment;\n            edge_list.get(eid ^ 1).flow -= augment;\n            cur = e.src;\n        }\n\n        return new Result(augment, augment * distance[sink_node]);\n    }\n\n    static Result min_cost_max_flow(int n) {\n        int total_flow = 0, total_cost = 0;\n        while (true) {\n            Result res = shortest_path(n);\n            if (res.flow == 0) break;\n            total_flow += res.flow;\n            total_cost += res.cost;\n        }\n        return new Result(total_flow, total_cost);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        for (int i = 0; i < MAX_NODES; i++) {\n            adj_list[i] = new ArrayList<>();\n            node_edges[i] = new ArrayList<>();\n        }\n\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            freq[x]++;\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            adj_list[u].add(v);\n            adj_list[v].add(u);\n        }\n\n        source_node = 0;\n        sink_node = 100 * n + n + 1;\n\n        for (int t = 0; t < 100; ++t) {\n            for (int i = 1; i <= n; ++i) {\n                insert_edge(n * t + i, n * (t + 1) + i, k, 0);\n                for (int neighbor : adj_list[i]) {\n                    for (int cp = 1; cp <= k; ++cp) {\n                        insert_edge(n * t + i, n * (t + 1) + neighbor, 1, d * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; ++i) {\n            if (freq[i] > 0) {\n                insert_edge(source_node, i, freq[i], 0);\n            }\n        }\n\n        for (int t = 0; t <= 100; ++t) {\n            insert_edge(n * t + 1, sink_node, k, c * t);\n        }\n\n        System.out.println(min_cost_max_flow(sink_node).cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017796363681554794, -3.4570634852570947e-06, -3.576278118089249e-07, -0.00259515387006104, -4.994744449504651e-05, -0.28115522861480713, -0.20149344205856323, -4.434487345861271e-05, -2.3841855067985307e-07, -9.703165414975956e-05, -0.029750879853963852, -0.0002308817347511649, -0.002859553089365363, -0.0945698544383049, -0.0002628219372127205, -0.0008099374244920909, -1.2636104656849056e-05, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -1.4305104514278355e-06, -1.1920928244535389e-07, -9.536738616588991e-07, -1.311301275563892e-06, -8.344646857949556e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -4.529942543740617e-06, -9.179073458653875e-06