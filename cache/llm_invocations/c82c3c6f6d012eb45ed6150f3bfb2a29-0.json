mnf[sn]};\n}\npair<int,int>mcmf(int n)\n{\n  int flow=0,cost=0;\n  while(true)\n  {\n    pair<int,int>p=spfa(n);\n    if(!p.first)return {flow,cost};\n    flow+=p.first,cost+=p.second;\n  }\n}\n\nint main()\n{\n  ios_base::sync_with_stdio(0);cin.tie(0);\n  int n,m,k,c,d;cin>>n>>m>>k>>c>>d;\n  for(int i=1;i<=k;i++)\n  {\n    int x;cin>>x;fr[x]++;\n  }\n  for(int i=1;i<=m;i++)\n  {\n    int u,v;cin>>u>>v;\n    gr[u].push_back(v);\n    gr[v].push_back(u);\n  }\n  sr=0,sn=100*n+n+1;\n  for(int tm=0;tm<=99;tm++)\n  {\n    for(int i=1;i<=n;i++)\n    {\n      addEdge(n*tm+i,n*(tm+1)+i,k,0);\n      for(auto x:gr[i])\n      {\n        for(int cp=1;cp<=k;cp++)\n        {\n          addEdge(n*tm+i,n*(tm+1)+x,1,d*(2*cp-1));\n        }\n      }\n    }\n  }\n  for(int i=1;i<=n;i++)\n    if(fr[i])addEdge(sr,i,fr[i],0);\n  for(int tm=0;tm<=100;tm++)\n    addEdge(n*tm+1,sn,k,c*tm);\n  cout<<mcmf(sn).second<<endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    fr = [0] * (n + 1)\n    for _ in range(k):\n        x = next(it)\n        fr[x] += 1\n\n    gr = [[] for _ in range(n + 1)]\n    for _ in range(m):\n        u = next(it)\n        v = next(it)\n        gr[u].append(v)\n        gr[v].append(u)\n\n    sr = 0\n    sn = 100 * n + n + 1\n    N = sn  # maximum node index\n\n    adj = [[] for _ in range(N + 1)]\n    ed = []  # list of edges\n\n    def add_edge(a, b, cap, cost):\n        # forward edge\n        ed.append({'a': a, 'b': b, 'f': 0, 'c': cap, 'd': cost})\n        adj[a].append(len(ed) - 1)\n        # backward edge\n        ed.append({'a': b, 'b': a, 'f': 0, 'c': 0, 