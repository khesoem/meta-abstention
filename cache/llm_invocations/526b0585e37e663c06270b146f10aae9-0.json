\n        for i in range(n_cur, low - 1, -2):\n            if cum_trail[i] + cum_trail[n_cur - i] == cum_trail[n_cur]:\n                dp[n_cur][k_cur] = (dp[n_cur][k_cur] + binom(n_cur, i, fact, inv_fact, mod) * dp[n_cur - i][k_cur - 1] % mod * k_cur) % mod\n    return dp[n][k]\n\ndef main():\n    data = read_ints()\n    if len(data) < 3:\n        return\n    N, K, MOD = data[0], data[1], data[2]\n    # Precompute factorials and inverse factorials up to MAX_N\n    fact = [0] * (MAX_N + 5)\n    inv_fact = [0] * (MAX_N + 5)\n    fact[0] = 1\n    for i in range(1, MAX_N + 1):\n        fact[i] = (fact[i - 1] * i) % MOD\n    inv_fact[MAX_N] = mod_pow(fact[MAX_N], MOD - 2, MOD)\n    for i in range(MAX_N - 1, -1, -1):\n        inv_fact[i] = (inv_fact[i + 1] * (i + 1)) % MOD\n    inv_fact[0] = inv_fact[1]  # as in original code\n\n    # Precompute log2_val and cum_trail\n    log2_val = [0] * (MAX_N + 5)\n    log2_val[0] = -1\n    cum_trail = [0] * (MAX_N + 5)\n    for i in range(1, MAX_N + 1):\n        log2_val[i] = log2_val[i >> 1] + 1\n        cum_trail[i] = cum_trail[i - 1] + trailing_zeros(i)\n\n    # Determine DP size: second dimension is K+1, but original uses fixed 31. If K>30, we would exceed bounds, but assume K<=30.\n    max_k = K + 1\n    # Allocate dp and visited\n    dp = [[0] * (max_k) for _ in range(MAX_N + 5)]\n    visited = [[False] * (max_k) for _ in range(MAX_N + 5)]\n\n    if N & 1:\n        print(mod_pow(K, N, MOD))\n    else:\n        ans = mod_pow(K, N, MOD)\n        dp_val = bfs_dp(N, K, MOD, log2_val, cum_trail, fact, inv_fact, dp, visited)\n        ans = (ans - dp_val + MOD) % MOD\n        print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-8.106198947643861e-06, -2.0265558760002023e-06, 0.0, -0.00035720644518733025, -0.0009263038518838584, 0.0, -5.543078441405669e-05, -0.0007454953738488257, -1.490105023549404e-05, -2.3841855067985307e-07, -7.152555099310121e-07, -0.0