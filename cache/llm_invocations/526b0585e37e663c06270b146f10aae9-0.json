hile(x && x % 2 == 0) {\n        ++cnt;\n        x /= 2;\n    }\n    return cnt;\n}\n\nint cumTrail[262155];\n\ninline int binom(int n, int m) {\n    return (long long)fact[n] * invFact[m] % MOD * invFact[n - m] % MOD;\n}\n\ninline int dfsDP(int n, int k) {\n    if(n == 0) return 1;\n    if(k == 0) return 0;\n    if(dp[n][k] != -1) return dp[n][k];\n    int low = (1 << log2Val[n]), ret = 0;\n    for(int i = n; i >= low; i -= 2) {\n        ret = (ret + (long long)binom(n, i) * dfsDP(n - i, k - 1) % MOD * k) % MOD;\n    }\n    return dp[n][k] = ret;\n}\n\nvector<pair<int,int>> order;\ninline int bfsDP(int n, int k) {\n    static queue<pair<int,int>> q;\n    q.push({n, k});\n    while(!q.empty()) {\n        n = q.front().first, k = q.front().second;\n        q.pop();\n        order.push_back({n, k});\n        if(n == 0 || k == 0) continue;\n        int low = (1 << log2Val[n]);\n        for(int i = n; i >= low; i -= 2) {\n            if(cumTrail[i] + cumTrail[n - i] == cumTrail[n] && !visited[n - i][k - 1]) {\n                visited[n - i][k - 1] = 1;\n                q.push({n - i, k - 1});\n            }\n        }\n    }\n    for(int idx = order.size() - 1; idx >= 0; --idx) {\n        n = order[idx].first, k = order[idx].second;\n        if(n == 0) { dp[n][k] = 1; continue; }\n        if(k == 0) { dp[n][k] = 0; continue; }\n        int low = (1 << log2Val[n]);\n        for(int i = n; i >= low; i -= 2) {\n            if(cumTrail[i] + cumTrail[n - i] == cumTrail[n])\n                dp[n][k] = (dp[n][k] + (long long)binom(n, i) * dp[n - i][k - 1] % MOD * k) % MOD;\n        }\n    }\n    return dp[n][k];\n}\n\nint main() {\n    readLL(N), readLL(K), readLL(MOD);\n    fact[0] = 1;\n    memset(visited, 0, sizeof(visited));\n    log2Val[0] = -1;\n    for(int i = 1; i <= 262150; ++i) {\n        fact[i] = (long long)fact[i - 1] * i % MOD;\n        log2Val[i] = log2Val[i >> 1] + 1;\n        cumTrail[i] = cumTrail[i - 1] + trailingZeros(i);\n    }\n    invFact[262150] = modPo