nt from, int to, long long cap, long long cost) {\n        int m = pos.size();\n        pos.emplace_back(from, g[from].size());\n        g[from].emplace_back(to, g[to].size(), cap, cost);\n        g[to].emplace_back(from, g[from].size()-1, 0, -cost);\n        return m;\n    }\n\n    bool _dual_ref(int s, int t) {\n        dist.assign(n, LLONG_MAX);\n        pv.assign(n, -1);\n        pe.assign(n, -1);\n        vis.assign(n, false);\n\n        typedef pair<long long, int> P;\n        priority_queue<P, vector<P>, greater<P>> pq;\n        dist[s] = 0;\n        pq.emplace(0, s);\n\n        while (!pq.empty()) {\n            P p = pq.top(); pq.pop();\n            int v = p.second;\n            if (p.first != dist[v]) continue;\n            vis[v] = true;\n            if (v == t) break;\n            for (int i = 0; i < g[v].size(); ++i) {\n                Edge &e = g[v][i];\n                if (e.cap == 0 || vis[e.to]) continue;\n                long long cost = e.cost - dual[e.to] + dual[v];\n                if (dist[e.to] > dist[v] + cost) {\n                    dist[e.to] = dist[v] + cost;\n                    pv[e.to] = v;\n                    pe[e.to] = i;\n                    pq.emplace(dist[e.to], e.to);\n                }\n            }\n        }\n        if (!vis[t]) return false;\n\n        for (int v = 0; v < n; ++v) {\n            if (vis[v]) {\n                dual[v] -= dist[t] - dist[v];\n            }\n        }\n        return true;\n    }\n\n    vector<pair<long long, long long>> slope(int s, int t, long long flow_limit = 1LL<<60) {\n        dual.assign(n, 0);\n        long long flow = 0, cost = 0, prev_cost = -1;\n        vector<pair<long long, long long>> result;\n        result.emplace_back(flow, cost);\n        while (flow < flow_limit) {\n            if (!_dual_ref(s, t)) break;\n            long long c = flow_limit - flow;\n            for (int v = t; v != s; v = pv[v]) {\n                c = min(c, g[pv[v]][pe[v]].cap);\n            }\n          