{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nusing llong = long long;\nusing P = pair<llong, int>;\n\nconst int MAX_NODES = 5500;\nconst llong INF = 1000000007LL;\n\nint N, M, K, C, D;\nint SOURCE, SINK;\nint total_flow = 0;\nllong total_cost = 0;\nllong dist[MAX_NODES];\nint prev_edge_idx[MAX_NODES];\n\nstruct Edge {\n    int dest;\n    int weight;\n    int reverse_index;\n    int cap;\n};\n\nvector<Edge> adj[MAX_NODES];\n\nvoid connect(int u, int v, int w, int capacity) {\n    int sz_u = adj[u].size();\n    int sz_v = adj[v].size();\n    adj[u].emplace_back(Edge{v, w, sz_v, capacity});\n    adj[v].emplace_back(Edge{u, -w, sz_u, 0});\n}\n\nvoid shortest_path() {\n    fill(dist, dist + MAX_NODES, INF);\n    priority_queue<P, vector<P>, greater<P>> heap;\n    dist[SOURCE] = 0;\n    heap.emplace(0, SOURCE);\n    \n    while (!heap.empty()) {\n        auto [d_val, u] = heap.top();\n        heap.pop();\n        if (d_val != dist[u]) continue;\n        \n        for (const auto& e : adj[u]) {\n            if (e.cap > 0 && dist[e.dest] > d_val + e.weight) {\n                dist[e.dest] = d_val + e.weight;\n                prev_edge_idx[e.dest] = e.reverse_index;\n                heap.emplace(dist[e.dest], e.dest);\n            }\n        }\n    }\n}\n\nvoid update_flow() {\n    int bottleneck = K;\n    int cur = SINK;\n    while (cur != SOURCE) {\n        int prev = adj[cur][prev_edge_idx[cur]].dest;\n        int idx = adj[cur][prev_edge_idx[cur]].reverse_index;\n        bottleneck = min(bottleneck, adj[prev][idx].cap);\n        cur = prev;\n    }\n    \n    total_flow += bottleneck;\n    total_cost += bottleneck * dist[SINK];\n    \n    cur = SINK;\n    while (cur != SOURCE) {\n        int prev = adj[cur][prev_edge_idx[cur]].dest;\n        int idx = adj[cur][prev_edge_idx[cur]].reverse_index;\n        adj[cur][prev_edge_idx[cur]].cap += bottleneck;\n        adj[prev][idx].cap -= bottleneck;\n        cur = prev;\n    }\n}\n\nint get_node(int vertex, int time_step) {\n    return vertex + time_step * N;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> M >> K >> C >> D;\n    SOURCE = MAX_NODES - 2;\n    SINK = MAX_NODES - 1;\n    int max_time = N + K;\n    \n    for (int i = 0; i < K; ++i) {\n        cin >> u;\n        connect(SOURCE, get_node(u, 0), 0, 1);\n    }\n    \n    for (int t = 0; t <= max_time; ++t) {\n        connect(get_node(1, t), SINK, 1LL * C * t, K);\n    }\n    \n    for (int v = 1; v <= N; ++v) {\n        for (int t = 0; t < max_time; ++t) {\n            connect(get_node(v, t), get_node(v, t + 1), 0, K);\n        }\n    }\n    \n    while (M--) {\n        cin >> u >> v;\n        for (int i = 1; i <= K; ++i) {\n            for (int t = 0; t < max_time; ++t) {\n                int w = D * (2 * i - 1);\n                connect(get_node(u, t), get_node(v, t + 1), w, 1);\n                connect(get_node(v, t), get_node(u, t + 1), w, 1);\n            }\n        }\n    }\n    \n    while (total_flow < K) {\n        shortest_path();\n        update_flow();\n    }\n    \n    cout << total_cost;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    \n    MAX_NODES = 5500\n    SOURCE = MAX_NODES - 2\n    SINK = MAX_NODES - 1\n    \n    INF = 1000000007\n    total_flow = 0\n    total_cost = 0\n    \n    # Initialize adjacency list\n    adj = [[] for _ in range(MAX_NODES)]\n    \n    def connect(u, v, w, capacity):\n        sz_u = len(adj[u])\n        sz_v = len(adj[v])\n        adj[u].append([v, w, sz_v, capacity])\n        adj[v].append([u, -w, sz_u, 0])\n    \n    def get_node(vertex, time_step):\n        return vertex + time_step * N\n    \n    # Read K starting positions\n    for _ in range(K):\n        u = int(next(it))\n        connect(SOURCE, get_node(u, 0), 0, 1)\n    \n    max_time = N + K\n    \n    # Connect to sink with cost C * t\n    for t in range(max_time + 1):\n        connect(get_node(1, t), SINK, C * t, K)\n    \n    # Time progression edges\n    for v in range(1, N + 1):\n        for t in range(max_time):\n            connect(get_node(v, t), get_node(v, t + 1), 0, K)\n    \n    # Read M edges\n    for _ in range(M):\n        u = int(next(it))\n        v = int(next(it))\n        for i in range(1, K + 1):\n            for t in range(max_time):\n                w = D * (2 * i - 1)\n                connect(get_node(u, t), get_node(v, t + 1), w, 1)\n                connect(get_node(v, t), get_node(u, t + 1), w, 1)\n    \n    def shortest_path():\n        dist = [INF] * MAX_NODES\n        dist[SOURCE] = 0\n        heap = [(0, SOURCE)]\n        prev_edge_idx = [-1] * MAX_NODES\n        \n        while heap:\n            d_val, u = heapq.heappop(heap)\n            if d_val != dist[u]:\n                continue\n            \n            for e in adj[u]:\n                dest, weight, reverse_idx, cap = e\n                if cap > 0 and dist[dest] > d_val + weight:\n                    dist[dest] = d_val + weight\n                    prev_edge_idx[dest] = reverse_idx\n                    heapq.heappush(heap, (dist[dest], dest))\n        \n        return dist, prev_edge_idx\n    \n    def update_flow(dist, prev_edge_idx):\n        nonlocal total_flow, total_cost\n        bottleneck = K\n        cur = SINK\n        path_nodes = []\n        \n        while cur != SOURCE:\n            path_nodes.append(cur)\n            reverse_idx = prev_edge_idx[cur]\n            if reverse_idx == -1:\n                break\n            prev_node = adj[cur][reverse_idx][0]\n            idx = adj[cur][reverse_idx][2]\n            bottleneck = min(bottleneck, adj[prev_node][idx][3])\n            cur = prev_node\n        \n        if cur != SOURCE:\n            return False\n        \n        total_flow += bottleneck\n        total_cost += bottleneck * dist[SINK]\n        \n        cur = SINK\n        while cur != SOURCE:\n            reverse_idx = prev_edge_idx[cur]\n            prev_node = adj[cur][reverse_idx][0]\n            idx = adj[cur][reverse_idx][2]\n            adj[cur][reverse_idx][3] += bottleneck\n            adj[prev_node][idx][3] -= bottleneck\n            cur = prev_node\n        \n        return True\n    \n    while total_flow < K:\n        dist, prev_edge_idx = shortest_path()\n        if dist[SINK] == INF:\n            break\n        if not update_flow(dist, prev_edge_idx):\n            break\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00024399164249189198, -4.768370445162873e-07, -2.3841855067985307e-07, -0.00012659224739763886, -0.10047033429145813, -0.112909026443