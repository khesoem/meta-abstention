= 3) or (a == 3 and b == 1):\n        return 1\n    return -1\n\ndef simulate(p1, p2):\n    total = 0\n    c1 = c2 = 0\n    while p1 or p2:\n        try:\n            if c1 == 0:\n                c1 = p1.pop()\n            if c2 == 0:\n                c2 = p2.pop()\n        except:\n            break\n\n        total += max(0, min(c1[0], c2[0]) * outcome(c1[1], c2[1]))\n        if c1[0] < c2[0]:\n            c2[0] -= c1[0]\n            c1 = 0\n        elif c1[0] > c2[0]:\n            c1[0] -= c2[0]\n            c2 = 0\n        else:\n            c1 = c2 = 0\n    return total\n\ndef compute_min():\n    base1 = [[rock1, 1], [sci1, 2], [paper1, 3]]\n    base2 = [[rock2, 1], [sci2, 2], [paper2, 3]]\n    perms1 = [list(p) for p in permutations(base1)]\n    perms2 = [list(p) for p in permutations(base2)]\n    \n    min_score = float('inf')\n    for p1 in perms1:\n        for p2 in perms2:\n            arr1 = [x[:] for x in p1]\n            arr2 = [x[:] for x in p2]\n            min_score = min(min_score, simulate(arr1, arr2))\n    return min_score\n\nprint(compute_min(), compute_max())\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 998244353;\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        int n = Integer.parseInt(br.readLine().trim());\n        String[] line1 = br.readLine().trim().split(\" \");\n        int rock1 = Integer.parseInt(line1[0]);\n        int sci1 = Integer.parseInt(line1[1]);\n        int paper1 = Integer.parseInt(line1[2]);\n        \n        String[] line2 = br.readLine().trim().split(\" \");\n        int rock2 = Integer.parseInt(line2[0]);\n        int sci2 = Integer.parseInt(line2[1]);\n        int paper2 = Integer.parseInt(line2[2]);\n        \n        System.out.println(computeMin(rock1, sci1, paper1, rock2, sci2, paper2) + \" \" + computeMax(rock1, sci1, paper1, rock2, sci2, paper2));\n    }\n    \n    static int computeMax(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        return Math.min(rock1, sci2) + Math.min(sci1, paper2) + Math.min(paper1, rock2);\n    }\n    \n    static int outcome(int a, int b) {\n        if (a == b) {\n            return 0;\n        } else if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) {\n            return 1;\n        }\n        return -1;\n    }\n    \n    static int simulate(List<int[]> p1, List<int[]> p2) {\n        int total = 0;\n        int[] c1 = new int[]{0, 0};\n        int[] c2 = new int[]{0, 0};\n        boolean c1Valid = false;\n        boolean c2Valid = false;\n        \n        int idx1 = 0;\n        int idx2 = 0;\n        \n        while (idx1 < p1.size() || idx2 < p2.size()) {\n            if (!c1Valid && idx1 < p1.size()) {\n                c1 = p1.get(idx1++);\n                c1Valid = true;\n            }\n            if (!c2Valid && idx2 < p2.size()) {\n                c2 = p2.get(idx2++);\n                c2Valid = true;\n            }\n            \n            if (!c1Valid || !c2Valid) {\n                break;\n            }\n            \n            int match = Math.min(c1[0], c2[0]);\n            total += Math.max(0, match * outcome(c1[1], c2[1]));\n            \n            if (c1[0] < c2[0]) {\n                c2[0] -= c1[0];\n                c1Valid = false;\n            } else if (c1[0] > c2[0]) {\n                c1[0] -= c2[0];\n                c2Valid = false;\n            } else {\n                c1Valid = false;\n                c2Valid = false;\n            }\n        }\n        return total;\n    }\n    \n    static int computeMin(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        List<int[]> base1 = new ArrayList<>();\n        base1.add(new int[]{rock1, 1});\n        base1.add(new int[]{sci1, 2});\n        base1.add(new int[]{paper1, 3});\n        \n        List<int[]> base2 = new ArrayList<>();\n        base2.add(new int[]{rock2, 1});\n        base2.add(new int[]{sci2, 2});\n        base2.add(new int[]{paper2, 3});\n        \n        List<List<int[]>> perms1 = permute(base1);\n        List<List<int[]>> perms2 = permute(base2);\n        \n        int minScore = Integer.MAX_VALUE;\n        for (List<int[]> p1 : perms1) {\n            for (List<int[]> p2 : perms2) {\n                List<int[]> arr1 = new ArrayList<>();\n                List<int[]> arr2 = new ArrayList<>();\n                for (int[] x : p1) arr1.add(x.clone());\n                for (int[] x : p2) arr2.add(x.clone());\n                minScore = Math.min(minScore, simulate(arr1, arr2));\n            }\n        }\n        return minScore;\n    }\n    \n    static List<List<int[]>> permute(List<int[]> nums) {\n        List<List<int[]>> result = new ArrayList<>();\n        permuteHelper(nums, 0, result);\n        return result;\n    }\n    \n    static void permuteHelper(List<int[]> nums, int start, List<List<int[]>> result) {\n        if (start == nums.size()) {\n            result.add(new ArrayList<>(nums));\n            return;\n        }\n        for (int i = start; i < nums.size(); i++) {\n            Collections.swap(nums, i, start);\n            permuteHelper(nums, start + 1, result);\n            Collections.swap(nums, i, start);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016389934171456844, -1.1920922133867862e-06, -2.3841855067985307e-07, -5.638440416078083e-05, -4.076874756719917e-05, -0.3132897913455963, -0.38688817620277405, -0.00020454221521504223, -2.074220174108632e-05, -0.0033188757952302694, -0.023335007950663567, -1.0132738680113107e-05, -3.6954811548639555e-06, -4.51792984677013e-05, -0.0699687972664833, -0.004080898128449917, -0.011887660250067711, -0.0453631728887558, -0.6326144