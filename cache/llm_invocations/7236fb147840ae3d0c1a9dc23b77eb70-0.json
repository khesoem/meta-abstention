{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdio>\n#include <cstring>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint add_mod(int a, int b) {\n    a += b;\n    if (a >= MOD) a -= MOD;\n    return a;\n}\n\nint sub_mod(int a, int b) {\n    a -= b;\n    if (a < 0) a += MOD;\n    return a;\n}\n\nint mul_mod(int a, int b) {\n    return (long long)a * b % MOD;\n}\n\nint pow_mod(int base, int exp) {\n    int result = 1;\n    while (exp > 0) {\n        if (exp & 1) result = mul_mod(result, base);\n        base = mul_mod(base, base);\n        exp >>= 1;\n    }\n    return result;\n}\n\nint inv_mod(int a) {\n    return pow_mod(a, MOD - 2);\n}\n\nint div_mod(int a, int b) {\n    return mul_mod(a, inv_mod(b));\n}\n\nint main() {\n#ifdef LOCAL\n    freopen(\"input.in\", \"r\", stdin);\n    freopen(\"output.out\", \"w\", stdout);\n#endif\n\n    int n;\n    scanf(\"%d\", &n);\n\n    vector<vector<int>> a(n, vector<int>(n));\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &a[i][j]);\n            a[i][j] = div_mod(a[i][j], 100);\n        }\n    }\n\n    struct State {\n        vector<char> masks;\n        int value;\n    };\n\n    vector<State> current = {{{0}, 1}};\n\n    for (int g = 0; g < n; ++g) {\n        vector<State> next;\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prob = 1;\n            for (int j = 0; j < n; ++j) {\n                if (mask & (1 << j)) {\n                    prob = mul_mod(prob, a[j][g]);\n                } else {\n                    prob = mul_mod(prob, sub_mod(1, a[j][g]));\n                }\n            }\n\n            for (const auto& state : current) {\n                vector<char> new_masks;\n                for (char mask2 : state.masks) {\n                    int remaining = ~mask2 & mask;\n                    while (remaining) {\n                        int pos = remaining & -remaining;\n                        new_masks.push_back(mask2 | pos);\n                        remaining ^= pos;\n                    }\n                }\n\n                if (new_masks.empty()) continue;\n                sort(new_masks.begin(), new_masks.end());\n                new_masks.erase(unique(new_masks.begin(), new_masks.end()), new_masks.end());\n                \n                next.push_back({new_masks, mul_mod(state.value, prob)});\n            }\n        }\n\n        sort(next.begin(), next.end(), [](const State& a, const State& b) {\n            return a.masks < b.masks;\n        });\n\n        current.clear();\n        for (int i = 0; i < (int)next.size(); ) {\n            int j = i;\n            int total = 0;\n            while (j < (int)next.size() && next[j].masks == next[i].masks) {\n                total = add_mod(total, next[j].value);\n                ++j;\n            }\n            current.push_back({next[i].masks, total});\n            i = j;\n        }\n    }\n\n    int result = 0;\n    for (const auto& state : current) {\n        result = add_mod(result, state.value);\n    }\n\n    cout << result << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\n\ndef add_mod(a, b):\n    a += b\n    if a >= MOD:\n        a -= MOD\n    return a\n\ndef sub_mod(a, b):\n    a -= b\n    if a < 0:\n        a += MOD\n    return a\n\ndef mul_mod(a, b):\n    return (a * b) % MOD\n\ndef pow_mod(base, exp):\n    result = 1\n    while exp > 0:\n        if exp & 1:\n            result = mul_mod(result, base)\n        base = mul_mod(base, base)\n        exp >>= 1\n    return result\n\ndef inv_mod(a):\n    return pow_mod(a, MOD - 2)\n\ndef div_mod(a, b):\n    return mul_mod(a, inv_mod(b))\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    index = 1\n    \n    a = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            a[i][j] = div_mod(int(data[index]), 100)\n            index += 1\n    \n    # State representation: masks as tuple (immutable for dict keys), value\n    current = [([0], 1)]\n    \n    for g in range(n):\n        next_states = []\n        \n        for mask in range(1 << n):\n            prob = 1\n            for j in range(n):\n                if mask & (1 << j):\n                    prob = mul_mod(prob, a[j][g])\n                else:\n                    prob = mul_mod(prob, sub_mod(1, a[j][g]))\n            \n            for masks_list, value in current:\n                new_masks = []\n                for mask2 in masks_list:\n                    remaining = (~mask2) & mask\n                    while remaining:\n                        pos = remaining & -remaining\n                        new_masks.append(mask2 | pos)\n                        remaining ^= pos\n                \n                if not new_masks:\n                    continue\n                \n                new_masks.sort()\n                # Remove duplicates\n                unique_masks = []\n                prev = None\n                for m in new_masks:\n                    if m != prev:\n                        unique_masks.append(m)\n                        prev = m\n                \n                next_states.append((tuple(unique_masks), mul_mod(value, prob)))\n        \n        # Group by masks and sum values\n        state_dict = defaultdict(int)\n        for masks, value in next_states:\n            state_dict[masks] = add_mod(state_dict[masks], value)\n        \n        current = [(list(masks), value) for masks, value in state_dict.items()]\n    \n    result = 0\n    for masks, value in current:\n        result = add_mod(result, value)\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001770101225702092, -7.152555099310121e-07, -2.3841855067985307e-07, -0.03219376131892204, -0.0002029928145930171, -0.38688454031944275, -0.3250006437301636, -0.09765025228261948, -4.768370445162873e-07, -0.0010387268848717213, -0.07896443456411362, -0.00028832571115344763, 0.0, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -0.0007142852991819382, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -1.9788545614574105e-05, -1.0728830375228426e-06, -2.3364747903542593e-05, -4.291525328881107e-06, -1.1920928244535389e-07, -4.768370445162873e-07, -7.152555099310121e-07, -3.814689989667386e-06, -1.1920928244535389e-07, -2.3841830625315197e-06, -0.03804313391447067, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, 0.0, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.4185804502631072e-05, -3.576278118089249e-07, -1.0728830375228426e-06, -3.576278118089249e-07, -1.1920928244535389e-07, -6.6756979322235566e-06, -2.0265558760002023e-06, -7.152555099310121e-07, -2.3841855067985307e-07, -2.38418