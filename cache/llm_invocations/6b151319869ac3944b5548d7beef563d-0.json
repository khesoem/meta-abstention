;\n    }\n\n    private static void addEdge(int u, int v, int costVal, int capVal) {\n        ecnt++;\n        to[ecnt] = v;\n        cap[ecnt] = capVal;\n        cost[ecnt] = costVal;\n        nxt[ecnt] = head[u];\n        head[u] = ecnt;\n        ecnt++;\n        to[ecnt] = u;\n        cap[ecnt] = 0;\n        cost[ecnt] = -costVal;\n        nxt[ecnt] = head[v];\n        head[v] = ecnt;\n    }\n\n    private static boolean spfa() {\n        for (int i = 1; i <= nodeCnt; i++) {\n            used[i] = false;\n            dist[i] = INF;\n        }\n        Queue<Integer> q = new LinkedList<>();\n        dist[src] = 0;\n        q.offer(src);\n        used[src] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            used[x] = false;\n            for (int e = head[x]; e != 0; e = nxt[e]) {\n                if (cap[e] == 0) continue;\n                int y = to[e];\n                if (dist[y] > dist[x] + cost[e]) {\n                    dist[y] = dist[x] + cost[e];\n                    if (!used[y]) {\n                        used[y] = true;\n                        q.offer(y);\n                    }\n                }\n            }\n        }\n        return dist[sink] < INF;\n    }\n\n    private static int augment(int x, int flow) {\n        if (x == src) return flow;\n        used[x] = true;\n        int rem = flow;\n        for (int e = head[x]; e != 0; e = nxt[e]) {\n            int y = to[e];\n            int rev = e ^ 1;\n            if (used[y] || cap[rev] == 0 || dist[x] < dist[y] + cost[rev]) continue;\n            int got = augment(y, Math.min(rem, cap[rev]));\n            if (got > 0) {\n                rem -= got;\n                cap[rev] -= got;\n                cap[e] += got;\n                if (rem == 0) break;\n            }\n        }\n        return flow - rem;\n    }\n\n    public static void main(String[] args) throws IOException {\n        n = readInt();\n        m = readInt();\n        k = readInt();\n        c = readInt();\n        d = readInt();\n\n        for (int i = 1; i <= k; ++i) {\n            int p = readInt();\n            people[p]++;\n        }\n\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j <= k + m + 2; ++j) {\n                id[i][j] = ++nodeCnt;\n                if (i == 1) {\n                    addEdge(id[i][j], sink, c * (j - 1), INF);\n                }\n                if (j > 1) {\n                    addEdge(id[i][j - 1], id[i][j], 0, INF);\n                }\n            }\n            if (people[i] > 0) {\n                addEdge(src, id[i][1], 0, people[i]);\n            }\n        }\n\n        for (int i = 1; i <= m; ++i) {\n            int a = readInt();\n            int b = readInt();\n            for (int j = 1; j <= k + m + 1; ++j) {\n                for (int costInc = 1; costInc <= 2 * k - 1; costInc += 2) {\n                    addEdge(id[a][j], id[b][j + 1], costInc * d, 1);\n                    addEdge(id[b][j], id[a][j + 1], costInc * d, 1);\n                }\n            }\n        }\n\n        int sent = 0;\n        while (spfa()) {\n            int add;\n            while (true) {\n                Arrays.fill(used, false);\n                add = augment(sink, INF);\n                if (add == 0) break;\n                sent += add;\n                answer += dist[sink] * add;\n            }\n        }\n\n        if (sent != k) {\n            throw new AssertionError(\"Assertion failed: sent != k\");\n        }\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n1\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -0.0002444683632347733, -0.00012242044613230973, -9.059865078597795e-06, -0.16022521257400513, -0.2428618222475052, -0.008647141046822071, -9.179073458653875e-06, -1.4781842764932662e-05, -0.0024958669673651457, -4.042843341827393, -0.0006691362359561026, -1.9073468138230965e-06, -0.0001908358681248501, -0.0486266165971756, -0.00034457468427717686, -0.169950038194656