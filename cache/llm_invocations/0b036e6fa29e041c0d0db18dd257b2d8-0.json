      if (charOccurrences[mostCommon] > equalPairs.size() / 2) {\n        List<Integer> penalties = new ArrayList<>();\n        for (int i = 0; i < n / 2; ++i) {\n          if (s[i] != s[n - 1 - i] && s[i] != mostCommon && s[n - 1 - i] != mostCommon) {\n            penalties.add(Math.min(beauty[i], beauty[n - 1 - i]));\n          }\n        }\n        Collections.sort(penalties);\n        int rem = 2 * charOccurrences[mostCommon] - equalPairs.size();\n        for (int i = 0; i < rem && i < penalties.size(); ++i) {\n          ans -= penalties.get(i);\n        }\n      }\n\n      pw.println(ans);\n    } catch (Exception e) {\n      e.printStackTrace();\n    }\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cctype>\n#include <climits>\n\nint main() {\n    int n;\n    std::cin >> n;\n    std::cin.ignore(); // Ignore newline after reading n\n\n    std::string s;\n    std::getline(std::cin, s);\n    \n    std::vector<int> beauty(n);\n    int totalBeauty = 0;\n    for (int i = 0; i < n; ++i) {\n        std::cin >> beauty[i];\n        totalBeauty += beauty[i];\n    }\n\n    std::vector<int> equalPairs;\n    int charOccurrences[128] = {0};\n    char mostCommon = 'a';\n    \n    for (int i = 0; i < n / 2; ++i) {\n        if (s[i] == s[n - 1 - i]) {\n            equalPairs.push_back(i);\n            if (++charOccurrences[static_cast<int>(s[i])] > charOccurrences[static_cast<int>(mostCommon)]) {\n                mostCommon = s[i];\n            }\n        }\n    }\n\n    int ans = totalBeauty;\n    for (int idx : equalPairs) {\n        ans -= std::min(beauty[idx], beauty[n - 1 - idx]);\n    }\n\n    if (charOccurrences[static_cast<int>(mostCommon)] > static_cast<int>(equalPairs.size()) / 2) {\n        std::vector<int> penalties;\n        for (int i = 0; i < n / 2; ++i) {\n            if 