n    prevv = [0] * n\n    preve = [0] * n\n    flow = 0\n    while flow < maxf:\n        dist = [INF] * n\n        dist[s] = 0\n        pq = [(0, s)]\n        while pq:\n            d, v = heapq.heappop(pq)\n            if dist[v] < d:\n                continue\n            for i, e in enumerate(graph[v]):\n                if e.cap > 0 and dist[e.to] > dist[v] + e.cost + potential[v] - potential[e.to]:\n                    dist[e.to] = dist[v] + e.cost + potential[v] - potential[e.to]\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    heapq.heappush(pq, (dist[e.to], e.to))\n        if dist[t] == INF:\n            break\n        for v in range(n):\n            potential[v] += dist[v]\n        d = maxf - flow\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            d = min(d, e.cap)\n            v = prevv[v]\n        cost_sum = 0\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            cost_sum += e.cost\n            v = prevv[v]\n        res += d * cost_sum\n        flow += d\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            e.cap -= d\n            graph[v][e.rev].cap += d\n            v = prevv[v]\n    return res\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    s = list(next(it).strip())\n    a = [int(next(it)) for _ in range(n)]\n\n    freq = Counter(s)\n    for v in freq.values():\n        if v > n // 2:\n            print(-1)\n            return\n\n    for i in range(n // 2):\n        if a[i] > a[n - 1 - i]:\n            a[i], a[n - 1 - i] = a[n - 1 - i], a[i]\n            s[i], s[n - 1 - i] = s[n - 1 - i], s[i]\n\n    N = n + 2\n    src = n\n    sink = n + 1\n    graph = [[] for _ in range(N)]\n\n    for i in range(n // 2):\n        add_edge(graph, src, i, 1, 0)\n    for i in range(n // 2):\n        right = n - 1 - i\