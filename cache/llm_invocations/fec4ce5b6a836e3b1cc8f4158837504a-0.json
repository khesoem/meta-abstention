n                if (s[i] != s[n - 1 - j]) {\n                    es.add(new Edge(i, n - 1 - j, 1, i == j ? 0 : a[i]));\n                }\n            }\n        }\n\n        long ans = 0;\n        for (int x : a) ans += x;\n        System.out.println(ans - solveMinCostFlow(compileWD(sink + 1, es), src, sink, n));\n    }\n\n    static class Edge {\n        int from, to, capacity, cost, flow;\n        Edge complement;\n        Edge(int from, int to, int capacity, int cost) {\n            this.from = from; this.to = to; this.capacity = capacity; this.cost = cost;\n        }\n    }\n\n    static Edge[][] compileWD(int n, List<Edge> edges) {\n        Edge[][] g = new Edge[n][];\n        for (int i = edges.size() - 1; i >= 0; i--) {\n            Edge origin = edges.get(i);\n            Edge clone = new Edge(origin.to, origin.from, origin.capacity, -origin.cost);\n            clone.flow = origin.capacity;\n            clone.complement = origin;\n            origin.complement = clone;\n            edges.add(clone);\n        }\n        int[] p = new int[n];\n        for (Edge e : edges) p[e.from]++;\n        for (int i = 0; i < n; i++) g[i] = new Edge[p[i]];\n        for (Edge e : edges) g[e.from][--p[e.from]] = e;\n        return g;\n    }\n\n    static long solveMinCostFlow(Edge[][] g, int source, int sink, long all) {\n        int n = g.length;\n        long mincost = 0;\n        int[] potential = new int[n];\n        int[] d = new int[n];\n        Edge[] inedge = new Edge[n];\n        while (all > 0) {\n            Arrays.fill(d, Integer.MAX_VALUE / 2);\n            Arrays.fill(inedge, null);\n            d[source] = 0;\n            boolean[] visited = new boolean[n];\n            for (int iter = 0; iter < n; iter++) {\n                int u = -1;\n                int best = Integer.MAX_VALUE / 2;\n                for (int v = 0; v < n; v++) {\n                    if (!visited[v] && d[v] < best) {\n                        best = d[v];\n                        u = v;\n 