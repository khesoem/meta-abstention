A;\n    stage1_counter++;\n    for (int d = 0; d <= 9; d++) {\n        generate_first_phase(depth + 1, num * 10 + d);\n    }\n}\n\nbool is_special(int64 x) {\n    return (x * 1000000LL + 999999LL <= N) && (x * 10000000LL > N);\n}\n\nint64 stage2_counter = 0;\nint64 pow10[7] = {1, 10, 100, 1000, 10000, 100000, 1000000};\n\nvoid generate_second_phase(int depth, int64 num) {\n    if (num > N) return;\n    if (is_special(num)) {\n        for (int idx = 0; idx <= 6; idx++) {\n            int64 off = ((stage2_counter + 1 - num * pow10[idx]) % MOD_A + MOD_A) % MOD_A;\n            int64 pos = lower_bound(stored[idx].begin(), stored[idx].end(), MOD_A - off) - stored[idx].begin();\n            int64 contrib = (stored_sum[idx] + off * (int64)stored[idx].size() - MOD_A * ((int64)stored[idx].size() - pos)) % MOD_B;\n            result = (result + contrib) % MOD_B;\n        }\n        stage2_counter += stage1_counter;\n    } else {\n        stage2_counter++;\n        int64 diff = ((stage2_counter - num) % MOD_A + MOD_A) % MOD_A;\n        result = (result + diff) % MOD_B;\n        for (int d = (depth ? 0 : 1); d <= 9; d++) {\n            generate_second_phase(depth + 1, num * 10 + d);\n        }\n    }\n}\n\nint main() {\n    cin >> N;\n    generate_first_phase(0, 0);\n    for (int i = 0; i <= 6; i++) sort(stored[i].begin(), stored[i].end());\n    stage2_counter = -1;\n    generate_second_phase(0, 0);\n    cout << ((result % MOD_B) + MOD_B) % MOD_B << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nusing int64 = long long;\n\nconst int64 MOD_A = 998244353LL;\nconst int64 MOD_B = 1000000007LL;\n\nint64 result = 0;\nint64 N;\nint64 stage1_counter = 0;\nvector<int64> stored[7];\nint64 stored_sum[7] = {0};\n\nvoid generate_first_phase(int depth, int64 num) {\n    if (