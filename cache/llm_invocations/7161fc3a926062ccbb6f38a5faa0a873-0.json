{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<algorithm>\n#include<cstdio>\n#include<queue>\n#define Maxn 5500\n#define Maxm 35500\n#define INF 1000000000\nusing namespace std;\nstruct Line\n{int nxt,t,c,l;}g[Maxm];\nint fir[Maxn],tl=1;\nvoid adl(int f,int t,int c,int cost){\n  g[++tl]=(Line){fir[f],t,c,cost};fir[f]=tl;\n  g[++tl]=(Line){fir[t],f,0,-cost};fir[t]=tl;\n}\nint S,T,pre[Maxn],lp[Maxn],flow[Maxn],dis[Maxn];\nbool in[Maxn];\nqueue<int> q;\nint spfa()\n{\n  for (int i=1;i<=T;i++)\n    {dis[i]=INF;flow[i]=0;}\n  flow[S]=INF;dis[S]=0;\n  q.push(S);in[S]=1;\n  while(!q.empty()){\n    int u=q.front();\n    in[u]=0;q.pop();\n    for (int i=fir[u],v;i;i=g[i].nxt)\n      if (g[i].c&&dis[v=g[i].t]>dis[u]+g[i].l){\n        dis[v]=dis[u]+g[i].l;\n        flow[v]=min(flow[u],g[i].c);\n        lp[v]=i;pre[v]=u;\n        if (!in[v]){in[v]=1;q.push(v);}\n     }\n  }return flow[T];\n}\nint n,m,k,C,D,pl[105][105],st[105][105];\nstruct Data\n{int f,t;}s[105];\n#define P(x,y) ((x)*n+(y))\nint main()\n{\n  scanf(\"%d%d%d%d%d\",&n,&m,&k,&C,&D);\n  S=P(n+k,n)+1;T=S+2;\n  adl(P(0,1),T,INF,0);\n  for (int i=1,p;i<=k;i++){\n    scanf(\"%d\",&p);\n    adl(S,P(0,p),1,0);\n  }for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&s[i*2].f,&s[i*2].t);\n    s[i*2-1]=(Data){s[i*2].t,s[i*2].f};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      adl(P(t-1,i),P(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      adl(P(t-1,s[i].f),P(t,s[i].t),1,D);\n      pl[t][i]=tl;st[t][i]=1;\n    }adl(P(t,1),T,INF,t*C);\n  }\n  int sav,cans=0;\n  while(sav=spfa()){\n    int u=T;\n    while(u!=S){\n      int las=pre[u];\n      g[lp[u]].c-=sav;\n      g[lp[u]^1].c+=sav;\n      u=las;\n    }cans+=dis[T]*sav;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (g[pl[t][i]].c){\n          st[t][i]++;\n          adl(P(t-1,s[i].f),P(t,s[i].t),1,D*(st[t][i]*2-1));\n          pl[t][i]=tl;\n        }\n  }printf(\"%d\\n\",cans);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class MaxFlowMinCost {\n    static class Line {\n        int nxt, t, c, l;\n        Line(int nxt, int t, int c, int l) {\n            this.nxt = nxt;\n            this.t = t;\n            this.c = c;\n            this.l = l;\n        }\n    }\n\n    static final int Maxn = 5500;\n    static final int Maxm = 35500;\n    static final int INF = 1000000000;\n    static Line[] g = new Line[Maxm];\n    static int[] fir = new int[Maxn];\n    static int tl = 1;\n\n    static int S, T, n, m, k, C, D;\n    static int[][] pl = new int[105][105];\n    static int[][] st = new int 105][105];\n    static Data[] s = new Data[105];\n    static boolean[] in = new boolean[Maxn];\n    static int[] pre = new int[Maxn];\n    static int[] lp = new int[Maxn];\n    static int[] flow = new int[Maxn];\n    static int[] dis = new int[Maxn];\n    static Queue<Integer> q = new LinkedList<>();\n\n    static class Data {\n        int f, t;\n        Data(int f, int t) {\n            this.f = f;\n            this.t = t;\n        }\n    }\n\n    static int P(int x, int y) {\n        return x * n + y;\n    }\n\n    static void adl(int f, int t, int c, int cost) {\n        g[++tl] = new Line(fir[f], t, c, cost);\n        fir[f] = tl;\n        g[++tl] = new Line(fir[t], f, 0, -cost);\n        fir[t] = tl;\n    }\n\n    static int spfa() {\n        Arrays.fill(dis, INF);\n        Arrays.fill(flow, 0);\n        flow[S] = INF;\n        dis[S] = 0;\n        q.clear();\n        q.offer(S);\n        Arrays.fill(in, false);\n        in[S] = true;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            in[u] = false;\n            for (int i = fir[u]; i != 0; i = g[i].nxt) {\n                int v = g[i].t;\n                if (g[i].c > 0 && dis[v] > dis[u] + g[i].l) {\n                    dis[v] = dis[u] + g[i].l;\n                    flow[v] = Math.min(flow[u], g[i].c);\n                    lp[v] = i;\n                    pre[v] = u;\n                    if (!in[v]) {\n                        in[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return flow[T];\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer stoken = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(stoken.nextToken());\n        m = Integer.parseInt(stoken.nextToken());\n        k = Integer.parseInt(stoken.nextToken());\n        C = Integer.parseInt(stoken.nextToken());\n        D = Integer.parseInt(stoken.nextToken());\n\n        int totalNodes = n + k;\n        S = P(n + k, n) + 1;\n        T = S + 1;\n\n        for (int i = 0; i <= Maxm; i++) g[i] = null;\n        Arrays.fill(fir, 0);\n        tl = 1;\n\n        // add edge from S to super-source\n        adl(P(0, 1), T, INF, 0);\n\n        int p;\n        String line = br.readLine();\n        stoken = new StringTokenizer(line);\n        for (int i = 1; i <= k; i++) {\n            p = Integer.parseInt(stoken.nextToken());\n            adl(S, P(0, p), 1, 0);\n        }\n\n        s = new Data[m * 2 + 1];\n        for (int i = 1; i <= m; i++) {\n            line = br.readLine();\n            stoken = new StringTokenizer(line);\n            int f1 = Integer.parseInt(stoken.nextToken());\n            int t1 = Integer.parseInt(stoken.nextToken());\n            s[2 * i] = new Data(f1, t1);\n            s[2 * i - 1] = new Data(t1, f1);\n        }\n        m *= 2;\n\n        for (int t = 1; t <= n + k; t++) {\n            for (int i = 1; i <= n; i++) {\n                adl(P(t - 1, i), P(t, i), INF, 0);\n            }\n            for (int i = 1; i <= m; i++) {\n                adl(P(t - 1, s[i].f), P(t, s[i].t), 1, D);\n                pl[t][i] = tl;\n                st[t][i] = 1;\n            }\n            adl(P(t, 1), T, INF, t * C);\n        }\n\n        int cans = 0;\n        while (true) {\n            int sav = spfa();\n            if (sav == 0) break;\n            int u = T;\n            while (u != S) {\n                int las = pre[u];\n                g[lp[u]].c -= sav;\n                g[lp[u] ^ 1].c += sav;\n                u = las;\n            }\n            cans += dis[T] * sav;\n\n            for (int t2 = 1; t2 <= n + n; t2++) {\n                for (int i = 1; i <= m; i++) {\n                    if (g[pl[t2][i]].c > 0) {\n                        st[t2][i]++;\n                        adl(P(t2 - 1, s[i].f), P(t2, s[i].t), 1, D * (st[t2][i] * 2 - 1));\n                        pl[t2][i] = tl;\n                    }\n                }\n            }\n        }\n        System.out.println(cans);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.02737622894346714, -6.217951886355877e-05, -6.704273118884885e-07, -0.00024358915106859058, -4.60414821645827e-06, -4.320199877838604e-07, -0.0009117019944824278, -1.2463892698287964, 