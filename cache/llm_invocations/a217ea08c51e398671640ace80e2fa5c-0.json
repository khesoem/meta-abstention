{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cstring>\n#include <cstdio>\nusing namespace std;\n\nconst int MAX_SIZE = 300005;\nint MOD = 1000000007;\n\nint add_mod(int a, int b) { return (a += b) >= MOD ? a - MOD : a; }\nint mul_mod(int a, int b) { return (long long)a * b % MOD; }\nint sub_mod(int a, int b) { return (a -= b) < 0 ? a + MOD : a; }\n\nint pow_mod(int x, int y) {\n    int res = 1;\n    while (y) {\n        if (y & 1) res = mul_mod(res, x);\n        x = mul_mod(x, x);\n        y >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout.tie(nullptr);\n\n    int n, k, mod_val;\n    cin >> n >> k >> mod_val;\n    MOD = mod_val;\n\n    vector<int> fact(n + 1), inv_fact(n + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = mul_mod(fact[i - 1], i);\n    inv_fact[n] = pow_mod(fact[n], MOD - 2);\n    for (int i = n - 1; i >= 0; --i) inv_fact[i] = mul_mod(inv_fact[i + 1], i + 1);\n\n    auto comb = [&](int x, int y) -> int {\n        if (y < 0 || y > x) return 0;\n        return mul_mod(fact[x], mul_mod(inv_fact[x - y], inv_fact[y]));\n    };\n\n    if (n & 1) {\n        cout << pow_mod(k, n) << '\\n';\n        return 0;\n    }\n\n    vector<int> dp_prev(n + 1, 0), dp_cur(n + 1, 0);\n    dp_prev[n] = 1;\n    int ans = 0;\n\n    for (int i = 1; i <= k; ++i) {\n        fill(dp_cur.begin(), dp_cur.end(), 0);\n        int res = 0;\n        for (int j = 1; j <= n; ++j) {\n            int val = dp_prev[j];\n            if (!val) continue;\n            int u = j ^ (j & -j);\n            for (int sub = u; sub; sub = (sub - 1) & u)\n                dp_cur[sub] = add_mod(dp_cur[sub], mul_mod(val, comb(j, sub)));\n            res = add_mod(res, val);\n        }\n        ans = add_mod(ans, mul_mod(res, inv_fact[k - i]));\n        swap(dp_prev, dp_cur);\n    }\n\n    ans = mul_mod(ans, fact[k]);\n    ans = sub_mod(pow_mod(k, n), ans);\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    MOD = int(next(it))\n\n    # modular arithmetic functions using MOD from outer scope\n    def add_mod(a, b):\n        res = a + b\n        return res - MOD if res >= MOD else res\n\n    def mul_mod(a, b):\n        return (a * b) % MOD\n\n    def sub_mod(a, b):\n        res = a - b\n        return res + MOD if res < 0 else res\n\n    def pow_mod(x, y):\n        res = 1\n        while y:\n            if y & 1:\n                res = mul_mod(res, x)\n            x = mul_mod(x, x)\n            y >>= 1\n        return res\n\n    # precompute factorials and inverse factorials\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = mul_mod(fact[i - 1], i)\n    inv_fact = [1] * (n + 1)\n    inv_fact[n] = pow_mod(fact[n], MOD - 2)\n    for i in range(n - 1, -1, -1):\n        inv_fact[i] = mul_mod(inv_fact[i + 1], i + 1)\n\n    def comb(x, y):\n        if y < 0 or y > x:\n            return 0\n        return mul_mod(fact[x], mul_mod(inv_fact[x - y], inv_fact[y]))\n\n    if n & 1:\n        sys.stdout.write(str(pow_mod(k, n)) + '\\n')\n        return\n\n    dp_prev = [0] * (n + 1)\n    dp_cur = [0] * (n + 1)\n    dp_prev[n] = 1\n    ans = 0\n\n    for i in range(1, k + 1):\n        dp_cur = [0] * (n + 1)\n        res = 0\n        for j in range(1, n + 1):\n            val = dp_prev[j]\n            if val == 0:\n                continue\n            u = j ^ (j & -j)\n            sub = u\n            while sub:\n                dp_cur[sub] = add_mod(dp_cur[sub], mul_mod(val, comb(j, sub)))\n                sub = (sub - 1) & u\n            res = add_mod(res, val)\n        ans = add_mod(ans, mul_mod(res, inv_fact[k - i]))\n        dp_prev, dp_cur = dp_cur, dp_prev\n\n    ans = mul_mod(ans, fact[k])\n    ans = sub_mod(pow_mod(k, n), ans)\n    sys.stdout.write(str(ans) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010132275929208845, 0.0, 0.0, -0.00020990552729927003, -0.00018594920402392745, 0.0, -0.00151078961789608, -0.005253320559859276, -0.4083315432071686, -0.0004328744253143668, -2.50339189733495e-06, -0.0017260904423892498, -8.344646857949556e-07, -0.0005538121913559735, 0.0, -0.201865553855896, -9.536738616588991e-07, -0.5759412050247192, -2.264974000354414e-06, -1.1920928244535389e-07, -2.3841830625315197e-06, -1.1920928244535389e-07, -3.1470757676288486e-05, -1.1920928244535389e-07, 0.0, -0.0015023384476080537, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -3.576278118089249e-07, -0.3134497106075287, -1.1920928244535389e-07, 0.0, -1.2993727978027891e-05, -2.145764938177308e-06, -2.3841855067985307e-07, -7.390948667307384e-06, -7.748573807475623e-06, -2.3841855067985307e-07, 0.0, 0.0, -7.033100700937212