{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3.11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3.11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n \nusing namespace std;\n \n#define fore(i, s, e) for(int i = s; i < e; i++)\n#define pb push_back\n#define ALL(a) a.begin(), a.end()\n#define SZ(a) ((int)a.size())\n#define mset(a, b) memset(a, b, sizeof(a))\n#define fst first\n#define snd second\n \ntypedef long long ll;\n \ntypedef int tf;\ntypedef int tc;\nconst tf INF=1e9;\nstruct MCF{\n\tint n;\n\tvector<tc> prio, pot; vector<tf> curflow; vector<int> prevedge,prevnode;\n\tpriority_queue<pair<tc, int>, vector<pair<tc, int>>, greater<pair<tc, int>>> q;\n\tstruct edge{int to, rev; tf f, cap; tc cost;};\n\tvector<vector<edge>> g;\n\tMCF(int n):n(n),prio(n),curflow(n),prevedge(n),prevnode(n),pot(n),g(n){}\n\tvoid add_edge(int s, int t, tf cap, tc cost) {\n    // cout << s << \" \" << t << \" \" << cap << endl;\n\t\tg[s].pb((edge){t,SZ(g[t]),0,cap,cost});\n\t\tg[t].pb((edge){s,SZ(g[s])-1,0,0,-cost});\n\t}\n\tpair<tf,tc> get_flow(int s, int t) {\n\t\ttf flow=0; tc flowcost=0;\n    // cout << s << \" \" << t << endl;\n\t\twhile(1){\n\t\t\tq.push({0, s});\n\t\t\tfill(ALL(prio),INF); \n\t\t\tprio[s]=0; curflow[s]=INF;\n\t\t\twhile(!q.empty()) {\n\t\t\t\tauto cur=q.top();\n\t\t\t\ttc d=cur.fst;\n        int u=cur.snd;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u]) continue;\n\t\t\t\tfor(int i=0; i<SZ(g[u]); ++i) {\n\t\t\t\t\tedge &e=g[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif(e.cap<=e.f) continue;\n\t\t\t\t\ttc nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif(prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push({nprio, v});\n\t\t\t\t\t\tprevnode[v]=u; prevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INF) break;\n\t\t\tfore(i,0,n) pot[i]+=prio[i];\n\t\t\ttf df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tedge &e=g[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df; g[v][e.rev].f-=df;\n\t\t\t\tflowcost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn {flow,flowcost};\n\t}\n};\n\nint T = 150; // I'm supposing this works\n\nint main() {\n  int n, m, k, c, d; cin >> n >> m >> k >> c >> d;\n  int N = n*T;\n  MCF mcf(N + 2);\n  fore(i, 0, n) fore(j, 0, T - 1) {\n    mcf.add_edge(i * T + j, i * T + j + 1, INF, c); // Wait a minute on this city\n  }\n  fore(i, 0, T) mcf.add_edge(i, N + 1, INF, 0); // Arrive to city 0 on time i\n  fore(i, 0, k) {\n    int x; cin >> x; x--;\n    mcf.add_edge(N, x * T, 1, 0); // One person in city x at time 0\n  }\n  fore(i, 0, m) {\n    int x, y; cin >> x >> y; x--, y--;\n    fore(j, 0, T - 1) { // for each time\n      int cur = 1;\n      fore(_, 0, k) { // k different people can go there\n        mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n        mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n        cur += 2; // squared cost\n      }\n    }\n  }\n  auto p = mcf.get_flow(N, N + 1);\n  assert(p.fst == k); \n  cout << p.snd << endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\n# Python 3.11 translation of the given C++ code\nimport sys\nimport heapq\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n, m, k, c, d = map(int, data[:5])\n    idx = 5\n    T = 150\n\n    class Edge:\n        def __init__(self, to, rev, f, cap, cost):\n            self.to = to\n            self.rev = rev\n            self.f = f\n            self.cap = cap\n            self.cost = cost\n\n    class MCF:\n        def __init__(self, n):\n            self.n = n\n            self.prio = [0] * n\n            self.pot = [0] * n\n            self.curflow = [0] * n\n            self.prevedge = [0] * n\n            self.prevnode = [0] * n\n            self.g = [[] for _ in range(n)]\n\n        def add_edge(self, s, t, cap, cost):\n            self.g[s].append(Edge(t, len(self.g[t]), 0, cap, cost))\n            self.g[t].append(Edge(s, len(self.g[s]) - 1, 0, 0, -cost))\n\n        def get_flow(self, s, t):\n            flow = 0\n            flowcost = 0\n            INF = 10**9\n            while True:\n                q = []\n                heapq.heappush(q, (0, s))\n                for i in range(self.n):\n                    self.prio[i] = INF\n                self.prio[s] = 0\n                self.curflow[s] = INF\n                while q:\n                    d, u = heapq.heappop(q)\n                    if d != self.prio[u]:\n                        continue\n                    for i, e in enumerate(self.g[u]):\n                        v = e.to\n                        if e.cap <= e.f:\n                            continue\n                        nprio = self.prio[u] + e.cost + self.pot[u] - self.pot[v]\n                        if self.prio[v] > nprio:\n                            self.prio[v] = nprio\n                            heapq.heappush(q, (nprio, v))\n                            self.prevnode[v] = u\n                            self.prevedge[v] = i\n                            self.curflow[v] = min(self.curflow[u], e.cap - e.f)\n                if self.prio[t] == INF:\n                    break\n                for i in range(self.n):\n                    self.pot[i] += self.prio[i]\n                df = min(self.curflow[t], INF - flow)\n                flow += df\n                v = t\n                while v != s:\n                    u = self.prevnode[v]\n                    e = self.g[u][self.prevedge[v]]\n                    e.f += df\n                    self.g[v][e.rev].f -= df\n                    flowcost += df * e.cost\n                    v = u\n            return (flow, flowcost)\n\n    mcf = MCF(n * T + 2)\n    INF = 10**9\n\n    # Read the rest of input for city pairs\n    pairs = data[idx:]\n    total_pairs = m\n    pairs_list = []\n    for i in range(total_pairs):\n        x = int(pairs[2*i]) - 1\n        y = int(pairs[2*i+1]) - 1\n        pairs_list.append((x, y))\n    idx += 2 * m\n\n    # Add edges for wait times\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c)\n    # Arrival edges to city 0 at all times\n    for i in range(T):\n        mcf.add_edge(i, n * T + 1, INF, 0)\n\n    # Place initial persons\n    for i in range(k):\n        x = int(data[idx+i]) - 1\n        mcf.add_edge(n * T, x * T, 1, 0)\n    idx += k\n\n    # Connect city pairs\n    for (x, y) in pairs_list:\n        for j in range(T - 1):\n            cur = 1\n            for _ in range(k):\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c)\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c)\n                cur += 2\n\n    flow_result = mcf.get_flow(n * T, n * T + 1)\n    # Assert flow == k\n    if flow_result[0] != k:\n        # Assertion failure (can be handled differently but just raising error)\n        raise AssertionError(\"Flow does not match k\")\n    print(flow_result[1])\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00053849