rue;\n        if (acnt == T/2) u = false;\n        if (u) {\n            ++acnt;\n            mval -= r1score[T/2 - acnt] * rscore[T/2 - bcnt];\n        } else {\n            ++bcnt;\n            mval += r1score[T/2 - bcnt] * rscore[T/2 - acnt];\n        }\n        --pos;\n    }\n    mval = max(mval, -mval);\n\n    ll tsum = 0;\n    for (int i=0; i<T; ++i) tsum += lscore[i];\n    tsum = rscore[T/2] * rscore[T/2];\n\n    map<pair<ll,int>, ll> mmap, nmap;\n    mmap[make_pair(0LL, 0)] = 1;\n\n    for (int i=T-1; i>=2*R-1; --i) {\n        nmap.clear();\n        for (auto& kv : mmap) {\n            ll sum = kv.first.first;\n            int a = kv.first.second;\n            ll cnt = kv.second;\n\n            int aleft = T/2 - a;\n            int bleft = i + 1 - aleft;\n\n            ll asum = sum + r1score[aleft-1] * rscore[bleft];\n            ll bsum = sum - r1score[bleft-1] * rscore[aleft];\n\n            if (c[i] == 'A') {\n                nmap[make_pair(asum, a+1)] += cnt;\n                nmap[make_pair(bsum, a)] += 0;\n            } else if (c[i] == 'B') {\n                nmap[make_pair(asum, a+1)] += 0;\n                nmap[make_pair(bsum, a)] += cnt;\n            } else {\n                nmap[make_pair(asum, a+1)] += cnt;\n                nmap[make_pair(bsum, a)] += cnt;\n            }\n        }\n\n        tsum -= lscore[i];\n\n        mmap.clear();\n        for (auto& kv : nmap) {\n            ll sum = kv.first.first;\n            int a = kv.first.second;\n            ll cnt = kv.second;\n\n            int aleft = T/2 - a;\n            int bleft = i - a;\n            if (a > T/2 || (T-i-a) > T/2) continue;\n            ll lsum = rscore[aleft] * rscore[bleft];\n            if (sum < -mval - lsum || sum > mval + lsum) continue;\n            mmap[make_pair(sum, a)] += cnt;\n        }\n    }\n\n    ll bscore = (ll)1e18;\n    for (auto& kv : mmap) {\n        ll s = kv.first.first;\n        if (abs(s) < bscore) bscore = abs(s);\n    }\n\n    ll ans = 0;\n    for (