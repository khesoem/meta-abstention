nvFactorial.size() - 1\n            if last_known < n:\n                f_inv = [0.0] * (n - last_known)\n                f_inv[0] = self.inv(self.fact(n))\n                for i in range(1, len(f_inv)):\n                    f_inv[i] = self.mult(f_inv[i - 1], n - i + 1)\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(int(f_inv[i]))\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for arg in args:\n                r = self.mult_two(r, arg)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_reader, out_writer):\n        self.n = in_reader.nextInt()\n        self.m = in_reader.nextInt()\n\n        phase_size = 1\n        p = 1\n        i = 0\n        while p != 0:\n            p = self.mod.mult(p, self.n - i, self.mod.smallInv(self.n + self.m - i))\n            phase_size = self.mod.add(phase_size, p)\n            i += 1\n\n        answer = 0\n        for k in range(1, self.n + 1):\n            num_phases = self.mod.mult(self.m + k, self.mod.smallInv(k))\n            term = self.mod.mult(self.mod.ncr(self.n, k), num_phases, phase_size)\n            if (k & 1) == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out_writer.println(answer)\n\n\ndef main():\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out_writer = PrintWriter(outputStream)\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out_writer)\n    out_writer.close()\n\n\nclass PrintWriter:\n    def __init__(self, stream):\n        self.stream = stream\n\n    def println(self, obj):\n        self.stream.write(str(obj) + '\\n')\n        self.stream.flush()\n\n    def close(self):\n        pass\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.328513361746445e-05, -9.536738616588991e-07, -5.960462772236497e-07, -0.0006428082706406713, -0.0793156698346138, -0.0030359390657395124, -0.14270278811454773, -0.5943322777748108, -0.0182338934391737, -0.07104673981666565, -0.5363543033599854, -1.9073468138230965e-06, -5.006777428206988e-06, -1.1920928244535389e-07, -4.768370445162873e-07, -0.00018439977429807186, -1.4305104514278355e-06, -3.576278118089249e-07, -3.099436753473128e-06, -4.768370445162873e-07, -3.0397906812140718e-05, -9.65590606938349e-06, -2.145764938177308e-06, -2.539125671319198e-05, -8.689979586051777e-05, -2.3841855067985307e-07, -0.02526