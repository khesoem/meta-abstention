        }\n            } else {\n                possible = false;\n                break;\n            }\n        }\n        \n        System.out.println(possible ? \"YES\" : \"NO\");\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <stack>\n#include <string>\n#include <sstream>\n\nint main() {\n    std::string line;\n    std::getline(std::cin, line);\n    std::istringstream iss(line);\n    \n    int w, m;\n    iss >> w >> m;\n    \n    std::stack<int> stack;\n    while (m != 0) {\n        stack.push(m % w);\n        m /= w;\n    }\n    \n    bool possible = true;\n    // Convert stack to vector for indexed access\n    std::vector<int> vec;\n    while (!stack.empty()) {\n        vec.push_back(stack.top());\n        stack.pop();\n    }\n    \n    for (int i = 0; i < vec.size(); i++) {\n        int val = vec[i];\n        if (val == 0 || val == 1) {\n            continue;\n        } else if (val == w - 1) {\n            int k = i + 1;\n            while (k < vec.size()) {\n                if (vec[k] == w - 1) {\n                    vec[k] = 0;\n                } else {\n                    vec[k] = vec[k] + 1;\n                    break;\n                }\n                k++;\n            }\n        } else {\n            possible = false;\n            break;\n        }\n    }\n    \n    std::cout << (possible ? \"YES\" : \"NO\") << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015066919149830937, -3.933898824470816e-06, -2.3841855067985307e-07, -0.00010525626566959545, -8.344646857949556e-07, -2.7418097943154862e-06, -4.291525328881107e-06, -4.0531076592742465e-06, -2.3841855067985307e-07, -0.08477576076984406, -2.622600959512056e-06, -1.764281842042692e-05, -5.960462772236497e-07, -0.6992719769477844, -0.03805885836482048, -0.0001646144810365513