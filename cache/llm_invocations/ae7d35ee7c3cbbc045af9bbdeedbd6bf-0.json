nt == T/2) u = true;\n        if (acnt == T/2) u = false;\n\n        if (u) {\n            ++acnt;\n            mval -= r1score[T/2 - acnt] * rscore[T/2 - bcnt];\n        } else {\n            ++bcnt;\n            mval += r1score[T/2 - bcnt] * rscore[T/2 - acnt];\n        }\n    }\n    mval = max(mval, -mval);\n\n    ll tsum = 0;\n    for (int i=0; i<T; ++i) tsum += lscore[i];\n    tsum = rscore[T/2] * rscore[T/2];\n\n    // Use nested map: sum -> (cnt -> value)\n    map<ll, map<int, ll>> mmap, nmap;\n    mmap[0][0] = 1;\n\n    for (int i=T-1; i>=2*R-1; --i) {\n        nmap.clear();\n        for (auto& outer1 : mmap) {\n            ll sum = outer1.first;\n            for (auto& inner1 : outer1.second) {\n                int a = inner1.first;\n                ll cnt = inner1.second;\n\n                int aleft = T/2 - a;\n                int bleft = i+1 - aleft;\n\n                ll asum = sum + r1score[aleft-1] * rscore[bleft];\n                ll bsum = sum - r1score[bleft-1] * rscore[aleft];\n\n                if (c[i] == 'A') {\n                    nmap[asum][a+1] += cnt;\n                    nmap[bsum][a] += 0;\n                } else if (c[i] == 'B') {\n                    nmap[asum][a+1] += 0;\n                    nmap[bsum][a] += cnt;\n                } else {\n                    nmap[asum][a+1] += cnt;\n                    nmap[bsum][a] += cnt;\n                }\n            }\n        }\n\n        tsum -= lscore[i];\n\n        mmap.clear();\n        for (auto& outer2 : nmap) {\n            ll sum = outer2.first;\n            for (auto& inner2 : outer2.second) {\n                int a = inner2.first;\n                ll cnt = inner2.second;\n\n                int aleft = T/2 - a;\n                int bleft = i - a;\n                if (a > T/2 || (T-i-a) > T/2) continue;\n                ll lsum = rscore[aleft] * rscore[bleft];\n                if (sum < -mval - lsum || sum > mval + lsum) continue;\n                mmap[sum][a] += cnt;\n            }\n  