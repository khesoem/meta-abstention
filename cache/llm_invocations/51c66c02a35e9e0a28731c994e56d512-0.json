}\n            dp_table[used][mask] = (int) result;\n            return dp_table[used][mask];\n        }\n\n        if (used > k) {\n            return 0;\n        }\n\n        int lsb = mask & -mask;\n        int upper_mask = mask - lsb;\n        int result = 0;\n\n        for (int sub = upper_mask; ; sub = (sub - 1) & upper_mask) {\n            int complement = mask - sub;\n            result = (int) ((result + (long) inv_factorial[complement] * compute(used + 1, sub)) % MOD);\n            if (sub == 0) break;\n        }\n\n        dp_table[used][mask] = result;\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        k = sc.nextInt();\n        MOD = sc.nextInt();\n\n        if ((n & 1) == 1) {\n            System.out.println(mod_exp(k, n));\n            return;\n        }\n\n        factorial = new int[n + 1];\n        inv_factorial = new int[n + 1];\n        modular_inverse = new int[n + 1];\n\n        factorial[0] = inv_factorial[0] = factorial[1] = inv_factorial[1] = modular_inverse[1] = 1;\n\n        for (int i = 2; i <= n; ++i) {\n            factorial[i] = (int) ((long) factorial[i - 1] * i % MOD);\n            modular_inverse[i] = (int) ((long) (MOD - MOD / i) * modular_inverse[MOD % i] % MOD);\n            inv_factorial[i] = (int) ((long) inv_factorial[i - 1] * modular_inverse[i] % MOD);\n        }\n\n        dp_table = new int[19][n + 1];\n        for (int i = 0; i < 19; ++i) {\n            Arrays.fill(dp_table[i], -1);\n        }\n\n        int total_ways = mod_exp(k, n);\n        int bad_ways = compute(0, n);\n        int answer = (total_ways - bad_ways + MOD) % MOD;\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015233787416946143, -1.5497195136049413e-06, -2.3841855067985307e-07, -0.00040570611599832773, -2.2649508537142538e-05, -0.026327965781092644, -0.31381446123123