h.min(paper1, rock2);\n    }\n\n    static int match(int a, int b) {\n        if (a == b) {\n            return 0;\n        } else if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) {\n            return 1;\n        } else {\n            return -1;\n        }\n    }\n\n    static int give(List<int[]> l1, List<int[]> l2) {\n        int ans = 0;\n        int[] curr1 = new int[2];\n        int[] curr2 = new int[2];\n        boolean curr1Valid = false;\n        boolean curr2Valid = false;\n\n        while (!l1.isEmpty() || !l2.isEmpty()) {\n            try {\n                if (!curr1Valid && !l1.isEmpty()) {\n                    int[] item = l1.remove(l1.size() - 1);\n                    curr1[0] = item[0];\n                    curr1[1] = item[1];\n                    curr1Valid = true;\n                }\n                if (!curr2Valid && !l2.isEmpty()) {\n                    int[] item = l2.remove(l2.size() - 1);\n                    curr2[0] = item[0];\n                    curr2[1] = item[1];\n                    curr2Valid = true;\n                }\n            } catch (Exception e) {\n                return ans;\n            }\n\n            if (!curr1Valid || !curr2Valid) {\n                break;\n            }\n\n            int matchResult = match(curr1[1], curr2[1]);\n            ans += Math.max(0, Math.min(curr1[0], curr2[0]) * matchResult);\n\n            if (curr1[0] < curr2[0]) {\n                curr2[0] -= curr1[0];\n                curr1Valid = false;\n            } else if (curr1[0] > curr2[0]) {\n                curr1[0] -= curr2[0];\n                curr2Valid = false;\n            } else {\n                curr1Valid = false;\n                curr2Valid = false;\n            }\n        }\n        return ans;\n    }\n\n    static int minimum(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        List<int[]> l = new ArrayList<>();\n        l.add(new int[]{rock1, 1});\n        l.add(new int[]{sci1, 2});\n     