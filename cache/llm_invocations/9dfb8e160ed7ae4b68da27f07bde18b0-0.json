.readLine().split(\" \");\n        int N = Integer.parseInt(input[0]);\n        long K = Long.parseLong(input[1]);\n        \n        if (K >= N) {\n            writer.println(0);\n            writer.flush();\n            return;\n        }\n        if (K == 0) {\n            writer.println(fact[N]);\n            writer.flush();\n            return;\n        }\n        if (K == N - 1) {\n            writer.println(2 * N);\n            writer.flush();\n            return;\n        }\n        \n        int filled = N - (int)K;\n        long colWays = comb(N, filled);\n        \n        long sum = 0;\n        for (int empty = 0; empty <= filled; empty++) {\n            long choose = comb(filled, empty);\n            long fillWays = modExp(filled - empty, N);\n            long term = (choose * fillWays) % MOD;\n            if (empty % 2 == 1) term = (MOD - term) % MOD;\n            sum = (sum + term) % MOD;\n        }\n        \n        sum = (sum * colWays) % MOD;\n        sum = (sum * 2) % MOD;\n        \n        writer.println(sum);\n        writer.flush();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\nusing namespace std;\n\nconst int MOD = 998244353;\n\nlong long modExp(long long b, long long e) {\n    long long res = 1;\n    b %= MOD;\n    while (e > 0) {\n        if ((e & 1) == 1) res = (res * b) % MOD;\n        b = (b * b) % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nvector<long long> fact;\n\nlong long comb(int n, int r) {\n    if (r < 0 || r > n) return 0;\n    long long numerator = fact[n];\n    long long denominator = (fact[n - r] * fact[r]) % MOD;\n    return (numerator * modExp(denominator, MOD - 2)) % MOD;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    fact.resize(200001);\n    fact[0] = 1;\n    for