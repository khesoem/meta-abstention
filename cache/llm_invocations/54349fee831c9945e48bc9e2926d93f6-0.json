2 + P2) % P2;\n                }\n                for (int i = 0; i <= 6; i++) cnt += val[i].size();\n                return;\n            }\n            ans = (ans + (++cnt - v % P1 + P1) % P1) % P2;\n        }\n        for (int c = !d; c < 10; c++) dfs2(d + 1, v * 10 + c);\n    };\n    cnt = 0, dfs2(0, 0);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n      \t\t \t     \t\t\t\t\t \t   \t    \t\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int B = 1000000;\n    static final int P1 = 998244353;\n    static final int P2 = 1000000007;\n    static long n;\n    static long cnt;\n    static ArrayList<Integer>[] val = new ArrayList[7];\n    static int ans;\n    static int[] sum = new int[7];\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        n = Long.parseLong(br.readLine());\n        \n        for (int i = 0; i < 7; i++) {\n            val[i] = new ArrayList<>();\n        }\n        \n        cnt = 0;\n        dfs1(0, 0);\n        \n        for (int d = 0; d <= 6; d++) {\n            Collections.sort(val[d]);\n            for (int x : val[d]) {\n                sum[d] = (sum[d] + x) % P2;\n            }\n        }\n        \n        cnt = 0;\n        ans = 0;\n        dfs2(0, 0);\n        \n        System.out.println(ans);\n    }\n    \n    static void dfs1(int d, int v) {\n        cnt++;\n        val[d].add((int)((cnt - v + P1) % P1));\n        if (d == 6) return;\n        for (int c = 0; c < 10; c++) {\n            dfs1(d + 1, v * 10 + c);\n        }\n    }\n    \n    static void dfs2(int d, long v) {\n        if (v > n) return;\n        if (d != 0) {\n            if (v * B > n / 10 && (v + 1) * B - 1 <= n) {\n                for (int i = 0, pw = 1; i <= 6; i++, pw *=