             inQue[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return d[sink] < inf;\n}\n\nint minCostMaxFlow() {\n    int total = 0;\n    while (spfa()) {\n        int add = inf;\n        for (int v = sink; v != src; v = from[v])\n            add = min(add, eCap[edgeIdx[v]]);\n        for (int v = sink; v != src; v = from[v]) {\n            int e = edgeIdx[v];\n            eCap[e] -= add;\n            eCap[e ^ 1] += add;\n        }\n        total += d[sink] * add;\n    }\n    return total;\n}\n\nint main() {\n    memset(h, -1, sizeof(h));\n    int n, m, k, C, D;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &C, &D);\n    src = 0;\n    sink = n * 100 + 1;\n    auto nodeId = [](int v, int tm) { return (v - 1) * 100 + tm; };\n    for (int tm = 1; tm <= 100; ++tm)\n        addEdge(tm, sink, 100, 0);\n    for (int i = 0; i < k; ++i) {\n        int v;\n        scanf(\"%d\", &v);\n        addEdge(src, nodeId(v, 1), 1, 0);\n    }\n    for (int v = 1; v <= n; ++v) {\n        for (int tm = 1; tm < 100; ++tm) {\n            addEdge(nodeId(v, tm), nodeId(v, tm + 1), 100, C);\n        }\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        scanf(\"%d%d\", &u, &v);\n        for (int tm = 1; tm < 100; ++tm) {\n            int a = nodeId(u, tm), b = nodeId(v, tm + 1);\n            for (int p = 1; p <= 50; ++p) {\n                int cost = C + (2 * p - 1) * D;\n                addEdge(a, b, 1, cost);\n            }\n        }\n        for (int tm = 1; tm < 100; ++tm) {\n            int a = nodeId(v, tm), b = nodeId(u, tm + 1);\n            for (int p = 1; p <= 50; ++p) {\n                int cost = C + (2 * p - 1) * D;\n                addEdge(a, b, 1, cost);\n            }\n        }\n    }\n    printf(\"%d\\n\", minCostMaxFlow());\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 0x3f3f3f3f;\n    static final int MAXN = 10000;\n    static final int MAXM = 3000000;\n\n    static int[] h = new int[MAXN];\n    static int[] eTo = new int[MAXM];\n    static int[] eCap = new int[MAXM];\n    static int[] eCost = new int[MAXM];\n    static int[] eNext = new int[MAXM];\n    static int[] d = new int[MAXN];\n    static int[] inQue = new int[MAXN];\n    static int[] from = new int[MAXN];\n    static int[] edgeIdx = new int[MAXN];\n    static int src, sink, edgeCnt;\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        eTo[edgeCnt] = v; eCap[edgeCnt] = cap; eCost[edgeCnt] = cost; eNext[edgeCnt] = h[u]; h[u] = edgeCnt++;\n        eTo[edgeCnt] = u; eCap[edgeCnt] = 0; eCost[edgeCnt] = -cost; eNext[edgeCnt] = h[v]; h[v] = edgeCnt++;\n    }\n\n    static boolean spfa() {\n        Queue<Integer> q = new LinkedList<>();\n        Arrays.fill(d, INF);\n        Arrays.fill(inQue, 0);\n        Arrays.fill(from, -1);\n        d[src] = 0;\n        q.offer(src);\n        inQue[src] = 1;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQue[u] = 0;\n            for (int i = h[u]; i != -1; i = eNext[i]) {\n                int v = eTo[i];\n                if (eCap[i] > 0 && d[v] > d[u] + eCost[i]) {\n                    d[v] = d[u] + eCost[i];\n                    from[v] = u;\n                    edgeIdx[v] = i;\n                    if (inQue[v] == 0) {\n                        inQue[v] = 1;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return d[sink] < INF;\n    }\n\n    static int minCostMaxFlow() {\n        int total = 0;\n        while (spfa()) {\n            int add = INF;\n            for (int v = sink; v != src; v = from[v])\n                add = Math.min(add, eCap[edgeIdx[v]]);\n            for (int v = sink; v != src; v = from[v]) {\n                int e = edgeIdx[v];\n                eCap[e] -= add;\n                eCap[e ^ 1] += add;\n            }\n            total += d[sink] * add;\n        }\n        return total;\n    }\n\n    static int nodeId(int v, int tm) {\n        return (v - 1) * 100 + tm;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        Arrays.fill(h, -1);\n        src = 0;\n        sink = n * 100 + 1;\n\n        for (int tm = 1; tm <= 100; ++tm)\n            addEdge(tm, sink, 100, 0);\n\n        for (int i = 0; i < k; ++i) {\n            int v = sc.nextInt();\n            addEdge(src, nodeId(v, 1), 1, 0);\n        }\n\n        for (int v = 1; v <= n; ++v) {\n            for (int tm = 1; tm < 100; ++tm) {\n                addEdge(nodeId(v, tm), nodeId(v, tm + 1), 100, C);\n            }\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int tm = 1; tm < 100; ++tm) {\n                int a = nodeId(u, tm), b = nodeId(v, tm + 1);\n                for (int p = 1; p <= 50; ++p) {\n                    int cost = C + (2 * p - 1) * D;\n                    addEdge(a, b, 1, cost);\n                }\n            }\n            for (int tm = 1; tm < 100; ++tm) {\n                int a = nodeId(v, tm), b = nodeId(u, tm + 1);\n                for (int p = 1; p <= 50; ++p) {\n                    int cost = C + (2 * p - 1) * D;\n                    addEdge(a, b, 1, cost);\n                }\n            }\n        }\n\n        System.out.println(minCostMaxFlow());\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0847986231965479e-05, -1.1920928244535389e-07, -7.152555099310121e-07, -0.0002554328821133822, -0.00034791138023138046, -1.1920928244535389e-07, -0.8259400725364685, -0.