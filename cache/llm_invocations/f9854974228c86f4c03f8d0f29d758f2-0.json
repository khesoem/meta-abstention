al byte[] buf = new byte[1 << 16];\n        private int ptr = 0, len = 0;\n\n        public InputReader(InputStream is) {\n            this.is = is;\n        }\n\n        private int read() {\n            if (ptr >= len) {\n                ptr = 0;\n                try {\n                    len = is.read(buf);\n                } catch (IOException e) {\n                    throw new UncheckedIOException(e);\n                }\n                if (len <= 0) return -1;\n            }\n            return buf[ptr++];\n        }\n\n        public int nextInt() {\n            int c;\n            while ((c = read()) <= 32 && c != -1) {}\n            if (c == -1) throw new NoSuchElementException();\n            int sign = 1;\n            if (c == '-') {\n                sign = -1;\n                c = read();\n            }\n            int val = 0;\n            while (c > 32) {\n                if (c < '0' || c > '9') throw new InputMismatchException();\n                val = val * 10 + c - '0';\n                c = read();\n            }\n            return val * sign;\n        }\n\n        @Override\n        public void close() {\n            try { is.close(); } catch (IOException ignored) {}\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n#include <stdexcept>\n#include <cstdio>\n\nclass InputReader {\nprivate:\n    std::istream& is;\n    char buf[1 << 16];\n    int ptr, len;\n\npublic:\n    InputReader(std::istream& stream) : is(stream), ptr(0), len(0) {}\n\n    int read() {\n        if (ptr >= len) {\n            ptr = 0;\n            is.read(buf, sizeof(buf));\n            len = is.gcount();\n            if (len <= 0) return -1;\n        }\n        return static_cast<unsigned char>(buf[ptr++]);\n    }\n\n    int nextInt() {\n        int c;\n        while 