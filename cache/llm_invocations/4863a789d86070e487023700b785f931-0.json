or j in range(20):\n        tmp1[j] = array('i', [0]) * (maxi + 1)\n        t[j] = array('q', [0]) * (maxi + 1)\n    # fill tmp1\n    for j in range(maxi + 1):\n        tmp1[ct[j]][j] = f[j]\n    # FWT on tmp1\n    for j in range(20):\n        FWT(tmp1[j], maxi + 1, p, t[0])\n    # accumulate into t\n    for q in range(20):\n        for l in range(20 - q):\n            for s in range(maxi + 1):\n                t[q + l][s] += tmp1[q][s] * tmp2[l][s]\n                if t[q + l][s] >= pp:\n                    t[q + l][s] -= pp\n    # copy to tmp3\n    for q in range(20):\n        for s in range(maxi + 1):\n            tmp3[q][s] = t[q][s] % p\n    # inverse FWT on tmp3\n    for j in range(20):\n        FWT(tmp3[j], maxi + 1, p, t[0], True)\n    # update f\n    for j in range(maxi + 1):\n        f[j] = tmp3[ct[j]][j]\n\ndef multi2(maxi, p, pp, ct, tmp2, t):\n    # clear t\n    for j in range(20):\n        t[j] = array('q', [0]) * (maxi + 1)\n    # accumulate into t\n    for q in range(20):\n        for l in range(20 - q):\n            for s in range(maxi + 1):\n                t[q + l][s] += tmp2[q][s] * tmp2[l][s]\n                if t[q + l][s] >= pp:\n                    t[q + l][s] -= pp\n    # create tmp array\n    tmp = [array('i', [0]) * (maxi + 1) for _ in range(20)]\n    for q in range(20):\n        for s in range(maxi + 1):\n            tmp[q][s] = t[q][s] % p\n    # inverse FWT on tmp\n    for i in range(20):\n        FWT(tmp[i], maxi + 1, p, t[0], True)\n    # update tmp2\n    for j in range(20):\n        for i in range(maxi + 1):\n            tmp2[j][i] = 0\n    for i in range(maxi + 1):\n        tmp2[ct[i]][i] = tmp[ct[i]][i]\n    # forward FWT on tmp2\n    for i in range(20):\n        FWT(tmp2[i], maxi + 1, p, t[0])\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    pp = p * p\n    if n & 1:\n        print(fast_pow(k, n, p))\n        return\n    maxi = lower(n + 1) - 1\n    # allocate arrays\n    ct = array('i', [0]) * (maxi + 1)\n    f = array('i', [0]) * (maxi + 1)\n    f[0] = 1\n    fac, inv = init(maxi, p)\n    # compute ct (popcount)\n    for i in range(maxi + 1):\n        ct[i] = i.bit_count()\n    # initialize tmp2\n    tmp2 = [array('i', [0]) * (maxi + 1) for _ in range(20)]\n    for i in range(maxi + 1):\n        tmp2[ct[i]][i] = inv[i]\n    # forward FWT on tmp2\n    t = [array('q', [0]) * (maxi + 1) for _ in range(20)]\n    for i in range(20):\n        FWT(tmp2[i], maxi + 1, p, t[0])\n    # prepare tmp1 and tmp3\n    tmp1 = [array('i', [0]) * (maxi + 1) for _ in range(20)]\n    tmp3 = [array('i', [0]) * (maxi + 1) for _ in range(20)]\n    res_k = k\n    while k:\n        if k & 1:\n            multi(maxi, p, pp, ct, f, tmp1, tmp2, tmp3, t)\n        k >>= 1\n        if k:\n            multi2(maxi, p, pp, ct, tmp2, t)\n    result = (fast_pow(res_k, n, p) - fac[n] * f[n] % p + p) % p\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1444026313256472e-05, 0.0, -2.3841855067985307e-07, -0.00046623803791590035, -0.030205072835087776, 0.0, -7.271740287251305e-06, -3.58813522325363e-05, -4.887569048150908e-06, 0.0, 0.0, -0.0002051381452474743, -0.26033174991607666, -0.3327776789665222, -4.768370445162873e-07, 0.0, -6.079655122448457e-06, -0.00012337400403339416, 0.0, -0.20145797729492188, -0.12698180973529816, -5.8530047681415454e-05, -5.960462772236497e-07, -0.0206285510212183, 0.0, -3.6954811548639555e-06, -2.4318398573086597e-05, -1.1920928244535389e-07, -5.960462772236497e-07, -3.576278118089249e-07, -0.004101555794477463, -0.001462343498133123, -0.1271899938583374, -3.2186455882765586e-06, -1.811964830267243e-05, 0.0, -0.6965656280517578, -1.1920928244535389e-07, 0.0, 0.0, -0.07897886633872986, -2.753696753643453e-05, -0.03804313391447067, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -6.198863957251888e-06, -0.000715