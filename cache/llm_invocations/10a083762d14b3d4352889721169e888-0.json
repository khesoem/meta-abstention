ODA * ((int)ok[R][o].size() - pos);\n            }\n            num += (int)lv[R].size();\n        }\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n;\n    cin >> n;\n    N = to_string(n).size();\n    p10[0] = 1;\n    for (int i = 1; i <= 14; ++i) p10[i] = p10[i-1] * 10;\n    string s = to_string(n);\n    string cur = \"\";\n    for (int i = 0; i < MAXN; ++i) {\n        gd[i] = to_string(i);\n        string now = gd[i];\n        while ((int)now.size() <= 6) {\n            lv[(int)now.size()].push_back(now);\n            now = \"0\" + now;\n        }\n    }\n    for (int i = 1; i <= 6; ++i) {\n        for (auto key : lv[i-1]) lv[i].push_back(key);\n        sort(lv[i].begin(), lv[i].end());\n        for (int j = 0; j < (int)lv[i].size(); ++j) {\n            ok[i][lv[i][j].size()].push_back((j - stoi(lv[i][j]) + MODA) % MODA);\n        }\n        for (int j = 1; j <= i; ++j) {\n            sort(ok[i][j].begin(), ok[i][j].end());\n            for (auto key : ok[i][j]) sm[i][j] += key;\n        }\n    }\n    vector<pair<string, int>> Q;\n    for (int i = 0; i < (int)s.size(); ++i) {\n        for (int j = 0; j <= 9; ++j) {\n            if (j == s[i] - '0') continue;\n            if (i == 0 && j == 0) continue;\n            cur += char('0' + j);\n            if (j <= s[i] - '0') {\n                Q.push_back({cur, (int)s.size() - i - 1});\n            } else {\n                Q.push_back({cur, (int)s.size() - i - 2});\n            }\n            cur.pop_back();\n        }\n        cur += s[i];\n        Q.push_back({cur, 0});\n    }\n    num = 1;\n    i128 ans = 0;\n    sort(Q.begin(), Q.end());\n    for (auto key : Q) {\n        if (s[(int)key.first.size() - 1] == key.first.back()) {\n            ans += (-str2int(key.first) + num + MODA * MODA) % MODA;\n            num += 1;\n            continue;\n        }\n        ans += calc(key.first, key.second);\n    }\n    ans %= MODB;\n    cout << (long long)ans;\n   