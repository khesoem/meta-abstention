ce k{\n    ll n,m,k,c,d;\n}\nvector <ll> vr[55];\nll lr[50];\nint main()\n{\n    ll n=50*99+1, m, k=INF;\n    vector<vector<edge>> g(n);\n    ll s, t;\n\n    cin>>k::n>>k::m>>k::k>>k::c>>k::d;\n\n    ll tim=99;\n    for(int i=1;i<=k::k;++i)\n    {\n        cin>>lr[i];\n        add_edge(g,0,lr[i],1,0);\n    }\n    for(int j=0;j<tim-1;++j)\n    {\n        for(int i=2;i<=k::n;++i)\n            add_edge(g,j*50+i,(j+1)*50+i,50,k::c);\n    }\n    for(int j=1;j<tim;++j)\n    {\n        add_edge(g,j*50+1,1,50,0);\n    }\n    for(int i=0;i<k::m;++i)\n    {\n        ll x,y;\n        cin>>x>>y;\n        vr[x].push_back(y);\n        vr[y].push_back(x);\n        \n        for(int j=0;j<tim-1;++j)\n        {\n            for(int l=0;l<50;++l)\n            {\n                add_edge(g,j*50+x,(j+1)*50+y,1,(k::c)+(k::d)*((l+1)*(l+1)-(l*l)));\n                add_edge(g,j*50+y,(j+1)*50+x,1,(k::c)+(k::d)*((l+1)*(l+1)-(l*l)));\n            }\n        }\n    }\n    s=0,t=1;\n\n    ll flow = 0, cost = 0;\n    while (flow < k) {\n        vector<ll> dist(n, INF);\n        vector<ll> prevv(n, -1);\n        vector<size_t> preve(n);\n        vector<ll> q(n);\n        vector<ll> inq(n, 0);\n        ll qh=0, qt=0;\n        q[qt++] = s;\n        dist[s] = 0;\n        inq[s] = 1;\n        while (qh != qt) {\n            ll v = q[qh++];\n            inq[v] = 0;\n            if (qh == n) qh = 0;\n            for (size_t i=0; i<g[v].size(); ++i) {\n                edge &e = g[v][i];\n                if (e.flow < e.cap && dist[v] + e.cost < dist[e.to]) {\n                    dist[e.to] = dist[v] + e.cost;\n                    prevv[e.to] = v;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        q[qt++] = e.to;\n                        if (qt == n) qt = 0;\n                        inq[e.to] = 1;\n                    }\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        ll add = k - flow;\n        for (ll v=t; v!=s;