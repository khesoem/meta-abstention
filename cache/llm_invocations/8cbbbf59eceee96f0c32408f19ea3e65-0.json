elf.dp[i][j] = self.cnt[i][j]\n        \n        def clean(self):\n            for i in range(d + 1):\n                for j in range(d + 1):\n                    self.dp[i][j] = 0\n                    self.cnt[i][j] = 0\n        \n        def shift(self, x):\n            for i in range(d + 1):\n                for j in range(d + 1):\n                    self.cnt[i][j] = 0\n            \n            for i in range(d):\n                for j in range(d):\n                    self.cnt[(i + x) % d][(j + x) % d] = self.dp[i][j]\n                self.cnt[(i + x) % d][d] = self.dp[i][d]\n            \n            for i in range(d):\n                self.cnt[d][(i + x) % d] = self.dp[d][i]\n            \n            self.cnt[d][d] = self.dp[d][d]\n            \n            for i in range(d + 1):\n                for j in range(d + 1):\n                    self.dp[i][j] = self.cnt[i][j]\n            \n            for i in range(d):\n                self.tark[i] = self.mark[(i + x) % d]\n            for i in range(d):\n                self.mark[i] = self.tark[i]\n    \n    # Initialize arrays\n    md = [Node() for _ in range(lg + 5)]\n    hp = [Node() for _ in range(lg + 5)]\n    ht = Node()\n    \n    def get(x):\n        h = x\n        pw = 1\n        t = -1\n        while h >= d:\n            h //= d\n            pw *= d\n            t += 1\n        x %= pw\n        if t == -1:\n            return hp[h]\n        ans = Node()\n        ans.dp = deepcopy(md[t].dp)\n        ans.mark = md[t].mark[:]\n        ht = Node()\n        ht.dp = deepcopy(md[t].dp)\n        ht.mark = md[t].mark[:]\n        for i in range(1, h + 1):\n            ht.shift(1)\n            ans.mrg(ht)\n        ht = get(x)\n        ht.shift(h)\n        ans.mrg(ht)\n        return ans\n    \n    # Initialize hp[0] and md[0]\n    hp[0].dp[d][d] = 2\n    hp[0].dp[d][0] = -1\n    hp[0].dp[0][d] = 1\n    hp[0].mark[0] = True\n    md[0] = deepcopy(hp[0])\n    \n    for i in range(1, d):\n        hp[i].dp[d][d] = 2