t[e[0]] = self.pot[u] + e[4]\n\n    def mcf(self, s, t, price, sparse, lb=1):\n        self.vis = [False]*self.n\n        self.dist = [INF]*self.n\n        self.dist[s] = 0\n        if sparse:\n            pq = [(0, s)]\n            while pq:\n                d, u = heapq.heappop(pq)\n                if self.vis[u]:\n                    continue\n                self.vis[u] = True\n                for e in self.adj[u]:\n                    if e[2] <= e[3] - lb:  # e.f <= e.c - lb\n                        nd = d + self.pot[u] - self.pot[e[0]] + e[4]\n                        if self.dist[e[0]] > nd:\n                            self.dist[e[0]] = nd\n                            self.par[e[0]] = e[1]\n                            heapq.heappush(pq, (nd, e[0]))\n        else:\n            while True:\n                u = -1\n                best = INF\n                for i in range(self.n):\n                    if not self.vis[i] and self.dist[i] < best:\n                        best = self.dist[i]\n                        u = i\n                if u == -1:\n                    break\n                self.vis[u] = True\n                for e in self.adj[u]:\n                    if e[2] <= e[3] - lb:\n                        nd = self.dist[u] + self.pot[u] - self.pot[e[0]] + e[4]\n                        if self.dist[e[0]] > nd:\n                            self.dist[e[0]] = nd\n                            self.par[e[0]] = e[1]\n        if self.dist[t] >= INF:\n            return 0\n        df = INF\n        u = t\n        while u != s:\n            r = self.adj[u][self.par[u]]\n            df = min(df, self.adj[r[0]][r[1]][3] - self.adj[r[0]][r[1]][2])\n            u = r[0]\n        u = t\n        while u != s:\n            r = self.adj[u][self.par[u]]\n            e = self.adj[r[0]][r[1]]\n            e[2] += df\n            r[2] -= df\n            price += df * e[4]\n            u = r[0]\n        for i in range(self.n):\n            self.pot[i] = min(INF, self.dist[i] + self.pot[i])\n        return df\n\n    def min_cost_flow(self, s, t, price, sparse=False):\n        self.pot_init()\n        flow = 0\n        price = 0\n        lb = 1 << 30\n        while lb > 0:\n            while True:\n                df = self.mcf(s, t, price, sparse, lb)\n                if df == 0:\n                    break\n                flow += df\n            lb //= 2\n        return flow\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    SRC = 0\n    SNK = n * T + 1\n    flow = Flow(SNK + 1)\n\n    for _ in range(k):\n        a = int(next(it))\n        flow.add_edge(SRC, a, 1, 0)\n\n    for t in range(T):\n        flow.add_edge(1 + t * n, SNK, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    price = 0\n    flow_val = flow.min_cost_flow(SRC, SNK, price, sparse=True)\n    assert flow_val == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.756337511935271e-05, 0.0, -1.1920928244535389e-07, -0.0009267802815884352, -0.0019591916352510452, -3.576272320060525e-06, -0.02378839999437332, -0.006788761354982853, -0.2520833909511566, -0.31339627504348755, -0.4129630923271179, -0.0014224658953025937, -0.03804577514529228, -0.5174111723899841, -0.00014029949670657516, -0.0003375437227077782, -3.576214658096433e-05, -0.0011701886542141438, -0.0013010379625484347, -0.4761202335357666, -0.2185448706150055, -9