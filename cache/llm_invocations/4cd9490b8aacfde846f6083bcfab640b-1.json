      last_known = self.invFactorial.size() - 1\n            if last_known < n:\n                f_inv = []\n                f_inv.append(self.inv(self.fact(n)))\n                for i in range(1, n - last_known):\n                    f_inv.append(self.mult(f_inv[i - 1], n - i + 1))\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(f_inv[i])\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n\n    def solve(self, testNumber, in_reader, out_writer):\n        n = in_reader.nextInt()\n        m = in_reader.nextInt()\n\n        self.mod.fInv(n + m)\n\n        phase_size = 1\n        p = 1\n        for i in range(n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, n - i, self.mod.smallInv(n + m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, n + 1):\n            num_phases = self.mod.mult(m + k, self.mod.smallInv(k))\n            term = self.mod.mult(self.mod.ncr(n, k), num_phases, phase_size)\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out_writer.println(answer)\n\n\ndef main():\n    input_reader = InputReader(sys.stdin)\n    output_writer = sys.stdout\n\n    solver = HZSShufflesCards()\n    solver.solve(1, input_reader, output_writer)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.652943895664066e-05, -7.152555099310121e-07, -3.576278118089249e-07, -0.0005535738891921937, -0.04890761896967888, -0.006480274721980095, -0.28119322657585144, -0.39657947421073914, -0.011225990951061249, -0.08995302766561508, -0.6029205918312073, -1.5497195136049413e-06, -5.245195097813848e-06, -1.1920928244535389e-07, -4.768370445162873e-07, -0.00017391123401466757, -1.5497195136049413e-06, -3.576278118089249e-07, -3.099436753473128e-06, -3.576278118089249e-07, -3.111314072157256e-05, -9.298280929215252e-06, -1.7881377516459906e-06, -1.4066597032069694e-05, -0.0001072826053132303, -2.3841855067985307e-07, -0.02243739925324917, -0.0003607814433053136, -1.7881377516459906e-06, -8.940656698541716e-06, -0.0004683827864937484, -9.65590606938349e-06, -7.152555099310121e-07, -0.0004275123355910182, -0.009961297735571861, -3.576278118089249e-07, -1.0728830375228426e-06, -0.0004757702990900725, -0.0001289761275984347, -9.894321920000948e-06, -2.38418550