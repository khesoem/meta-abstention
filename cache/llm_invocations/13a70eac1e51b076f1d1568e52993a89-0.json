             for (int id : adj[v]) {\n                    Edge &e = edges[id];\n                    if (e.cap - e.flow <= 0) continue;\n\n                    int nd = d + e.cost + pot[v] - pot[e.to];\n                    if (nd < dist[e.to]) {\n                        dist[e.to] = nd;\n                        prevv[e.to] = v;\n                        preve[e.to] = id;\n                        pq.push({nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n            int add = INF - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = edges[preve[v]];\n                add = min(add, e.cap - e.flow);\n            }\n\n            flow += add;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = edges[preve[v]];\n                e.flow += add;\n                edges[preve[v] ^ 1].flow -= add;\n                flow_cost += add * e.cost;\n            }\n        }\n\n        return {flow, flow_cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MinCostFlow mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * 