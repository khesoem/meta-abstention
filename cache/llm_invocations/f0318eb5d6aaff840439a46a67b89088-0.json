X) m = min(n, 11 - n + 2);\n    printf(\"%lld\", m);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nn = 0\ni = 0\ntop = 0\nt = 0\nk = 0\narr = [0] * 500000\nm = 2**31 - 1  # INT_MAX\nbs = 0\n\ndef f_iter(x0, s0, k0, kk0):\n    stack = [(x0, s0, k0, kk0)]\n    while stack:\n        x, s, k, kk = stack.pop()\n        if s >= i:\n            continue\n        if x == 0:\n            print(s)\n            sys.exit(0)\n        while k > x:\n            k //= 10\n            kk -= 1\n        # Push in reverse order to simulate original recursion order\n        stack.append((x - (k * (x // k)), s + (kk * (x // k)), k, kk))\n        stack.append(((k * 10 + 1) - x, s + kk + 1, k, kk))\n        stack.append((0, s + ((k * 10 + 1) - x) + kk + 1, k * 10 + 1, kk + 1))\n\ndef main():\n    global n, i, k, bs, m\n    n = int(sys.stdin.readline().strip())\n    k = 1\n    bs = 1\n    while k * 10 + 1 <= n:\n        k = k * 10 + 1\n        bs += 1\n    for i in range(n):\n        f_iter(n, 0, k, bs)\n    if m == 2**31 - 1:\n        m = min(n, 11 - n + 2)\n    print(m)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.9802277e-06, 0.0, -5.960463e-07, -0.00020501897, -0.0010902897, -0.00016032365, -0.47446, -1.9815053, -0.055475347, -0.041212123, -9.298281e-06, -0.00070678047, -0.06079885, -0.000487328, -9.059865e-06, -9.417489e-06, -0.0013030618, -0.10562317, -8.821448e-06, -4.2199197e-05, -3.6954812e-06, -7.092701e-05, -0.002618458, -1.7881378e-06, -1.6689287e-06, -3.81469e-06, -5.4238757e-05, -0.0004545609, -0.00036030475, -2.9802277e-06, -0.0031816359, -2.0265374e-05, -0.003274795, -1.1563234e-05, -0.0002683041, -8.106199e-06, -0.00091713323, -4.7683704e-07, -1.5497195e-06, -5.1259863e-06, -2.145765e-06, -0.00011002412, -0.00014351768, -9.5367386e-07, -1.3879757