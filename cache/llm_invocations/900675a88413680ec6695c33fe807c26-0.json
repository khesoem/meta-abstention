 0)\n            x = gcd(x, y);\n        return x;\n    }\n\n    static long lcm(long x, long y) {\n        return (long) (x * y) / gcd(x, y);\n    }\n\n    static double func(long x1, long y1, long x2, long y2) {\n        long s = lcm(y1, y2);\n        long s1 = Math.abs(s / y1 * x1 - s / y2 * x2);\n        return (double) s1 / s;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        x = Long.parseLong(st.nextToken());\n        y = Long.parseLong(st.nextToken());\n        n = Long.parseLong(st.nextToken());\n        long a = 0, b = 1;\n        double t1 = (double) x / (double) y;\n        for (i = 1; i <= n; i++) {\n            long l = 1, r = 1000000, ave;\n            while (r - l > 1) {\n                ave = (l + r) / 2;\n                double t2 = (double) ave / (double) i;\n                if (t2 < t1)\n                    l = ave;\n                else\n                    r = ave;\n            }\n            ave = l;\n            if ((func(l, i, x, y) > func(r, i, x, y)))\n                ave = r;\n            if (func(ave, i, x, y) < func(a, b, x, y)) {\n                a = ave;\n                b = i;\n            }\n        }\n        pw.print(a + \"/\" + b);\n        pw.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.2264632135629654, -0.0001541494857519865, -0.09548260271549225, -0.5876523852348328, -0.004432952497154474, -0.000692607369273901, -7.188578456407413e-05, -5.92487704125233e-05, -2.9445127438521013e-05, -0.009836314246058464, -0.0010861094342544675, -2.0504208805505186e-05, -7.176656799856573e-05, -0.0005059329560026526, -6.198902156029362e-06, -0.0007207010057754815, -4.410753263073275e-06, -7.152582838898525e-06, -0.05647789686918259, -0.0003807077300734818, -