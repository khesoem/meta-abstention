  static final int ZERO = 10001;\n    static final int YJSNPI = 8101919;\n    static final int INF = 1 << 28;\n    static long ADD(long a, long b) {\n        return (a + b) % MOD;\n    }\n    static long MUL(long a, long b) {\n        return (a * b) % MOD;\n    }\n    static long MAX(long a, long b) {\n        return Math.max(a, b);\n    }\n    static long MIN(long a, long b) {\n        return Math.min(a, b);\n    }\n\n    static class Mat {\n        int rows, cols;\n        long[][] mat;\n\n        Mat(int a, int b) {\n            rows = a;\n            cols = b;\n            mat = new long[a][b];\n        }\n    }\n\n    static void mat_init(Mat A, int a, int b) {\n        A.rows = a;\n        A.cols = b;\n        A.mat = new long[a][b];\n        for(int i = 0; i < a; i++) {\n            Arrays.fill(A.mat[i], 0);\n        }\n    }\n\n    static Mat mul(Mat A, Mat B) {\n        Mat C = new Mat(A.rows, B.cols);\n        for(int i = 0; i < A.rows; i++) {\n            for(int k = 0; k < A.cols; k++) {\n                for(int j = 0; j < B.cols; j++) {\n                    C.mat[i][j] = ADD(C.mat[i][j], MUL(A.mat[i][k], B.mat[k][j]));\n                }\n            }\n        }\n        return C;\n    }\n\n    static void show_mat(Mat A) {\n        for(int i = 0; i < A.rows; i++) {\n            for(int j = 0; j < A.cols; j++) {\n                System.out.print(A.mat[i][j] + \" \");\n            }\n            System.out.println();\n        }\n        System.out.println();\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long N = sc.nextLong();\n        int K = sc.nextInt();\n\n        int cnt = 0;\n        long nN = 1;\n        while(nN <= N) {\n            nN *= K;\n            cnt++;\n        }\n        nN /= K;\n\n        long[] d = new long[cnt];\n        long tempN = N;\n        long tempN2 = nN;\n        for(int i = 0; i < cnt; i++) {\n            d[i] = tempN / tempN2;\n            tempN %= tempN2;\n