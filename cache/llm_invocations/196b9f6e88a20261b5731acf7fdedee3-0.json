elf.N = N\n        self.M = M\n        self.h = [-1] * N\n        self.ing = [0] * N\n        self.pre = [0] * N\n        self.to = [0] * M\n        self.ne = [0] * M\n        self.cap = [0] * M\n        self.dis = [float('inf')] * N\n        self.cost = [0] * M\n        self.e = 0\n        self.s = 0\n        self.t = 0\n        self.n = 0\n\n    def ini(self, _n=30000):\n        self.n = _n\n        self.h = [-1] * self.n\n        self.e = 0\n\n    def liu(self, u, v, c, w):\n        self.to[self.e] = v\n        self.ne[self.e] = self.h[u]\n        self.cap[self.e] = c\n        self.cost[self.e] = w\n        self.h[u] = self.e\n        self.e += 1\n\n    def link(self, u, v, c, w):\n        self.liu(u, v, c, w)\n        self.liu(v, u, 0, -w)\n\n    def spfa(self):\n        Q = deque()\n        self.dis = [float('inf')] * self.n\n        self.ing = [0] * self.n\n        self.pre = [-1] * self.n\n        self.dis[self.s] = 0\n        Q.append(self.s)\n        self.ing[self.s] = 1\n        while Q:\n            c = Q.popleft()\n            self.ing[c] = 0\n            k = self.h[c]\n            while k != -1:\n                v = self.to[k]\n                if self.cap[k] > 0 and self.dis[c] + self.cost[k] < self.dis[v]:\n                    self.dis[v] = self.dis[c] + self.cost[k]\n                    self.pre[v] = k\n                    if not self.ing[v]:\n                        Q.append(v)\n                        self.ing[v] = 1\n                k = self.ne[k]\n        return self.dis[self.t] != float('inf')\n\n    def run(self, _s, _t):\n        self.s = _s\n        self.t = _t\n        flow = 0\n        mincost = 0\n        while self.spfa():\n            pl = float('inf')\n            p = self.t\n            while p != self.s:\n                k = self.pre[p]\n                pl = min(pl, self.cap[k])\n                p = self.to[k ^ 1]\n            p = self.t\n            while p != self.s:\n                k = self.pre[p]\n                self.cap[k] -= pl\n                self.cap[k ^ 1] += pl\n                p = self.to[k ^ 1]\n            mincost += pl * self.dis[self.t]\n            flow += pl\n        return flow, mincost\n\ndef main():\n    input = sys.stdin.read().strip().split()\n    n, m, k, c, d = map(int, input[0:5])\n    a = [0] + list(map(int, input[5:5 + k]))\n    flow = MCMF()\n    flow.ini(50 * 50 * 4 + 10)\n    s = flow.n - 2\n    t = flow.n - 3\n    cnt = 0\n    mx = 100\n    id_map = [[0] * (mx + 1) for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        for j in range(mx + 1):\n            cnt += 1\n            id_map[i][j] = cnt\n    index = 5 + k\n    for _ in range(m):\n        u, v = map(int, input[index:index+2])\n        index += 2\n        for j in range(mx):\n            for h in range(1, k + 1):\n                tmp = h * h * d - (h - 1) * (h - 1) * d\n                flow.link(id_map[u][j], id_map[v][j + 1], 1, c + tmp)\n                flow.link(id_map[v][j], id_map[u][j + 1], 1, c + tmp)\n    for i in range(1, n + 1):\n        for j in range(mx):\n            flow.link(id_map[i][j], id_map[i][j + 1], float('inf'), c)\n    for i in range(1, k + 1):\n        flow.link(s, id_map[a[i]][0], 1, 0)\n    for j in range(1, mx + 1):\n        flow.link(id_map[1][j], t, float('inf'), 0)\n    _, ans = flow.run(s, t)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0002656271681189537, -0.0006143859936855733, -1.9361264946837764e-07, -1.4259644558478612e-05, -0.004401036538183689, -3.881560041918419e-05, -5.0020742492051795e-05, -0.2843397855758667, -0.006505874451249838, 0.0, -1.1398757123970427e-05, -0.005478248931467533, -0.9236962199211121, -0.0022537452168762684, -5.6934557505883276e-05, -3.128163257315464e-07, -6.034592388459714e-06, -2.1008713702030946e-06, -0.16220055520534515, -3.173704271830502e-06, 0.0, 0.0, -1.9361264946837764e-07, -0.3133499026298523, -0.6459668278694153, -0.03285906091332