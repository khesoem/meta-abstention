 = 1; // sum of mem[0..i-1] initially for i=1\n\n        for (int i = 2; i <= n; i++) {\n            int sq = (int) Math.sqrt(i) + 1;\n            long cur = su;\n\n            // first loop: f from 2 to sq-1\n            for (int f = 2; f < sq; f++) {\n                cur = (cur + mem[i / f]) % mod;\n            }\n\n            // second loop: j from 1 to i/sq\n            int be = i;\n            int limit = i / sq;\n            for (int j = 1; j <= limit; j++) {\n                int nxt = i / (j + 1);\n                long addVal = (long) (be - nxt) * mem[j] % mod;\n                cur = (cur + addVal) % mod;\n                be = nxt;\n            }\n\n            su = (su + cur) % mod;\n            mem[i] = (int) cur;\n        }\n\n        System.out.println(mem[n]);\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -1.3947389561508317e-05, -1.1920928244535389e-07, 0.0, -1.9073468138230965e-06, -0.0015091231325641274, -0.000914393924176693, -1.311301275563892e-06, 0.0, -0.010754483751952648, -2.8132995794294402e-05, -1.0847986231965479e-05, -0.04101625829935074, 0.0, -0.00020644917094614357, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -1.311301275563892e-06, 0.0, -5.960462772236497e-07, -0.003226077649742365, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, -6.437280717364047e-06, -1.1920922133867862e-06, -7.152555099310121e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920922133867862e-06, 0.0, -5.876845170860179e-05, -4.5536911784438416e-05, -9.536738616588991e-07, 0.0, 0.0, -0.011049510911107063, -0.07889051735401154, -0.3871941864490509, -1.0728830375228426e-06, -0.12695230543613434, -1.1920928244535389e-07, -0.012959188781678677, -2.3841855067985307e-07, -1.6331539882230572e-05, 0.0, 0.0, 0.0, -3.814689989667386e-06, -4.589452510117553e-05, 0.0, -9.655486064730212e-05, -0.0013265152228996158, 0.0, -0.0017189502250403166, 0.0, -0.0004306104383431375,