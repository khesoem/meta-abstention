aringInt(a -> a[0]));\n                pq.offer(new int[]{0, s});\n\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int d = cur[0];\n                    int v = cur[1];\n                    if (d != dist[v]) continue;\n\n                    for (int i = 0; i < graph.get(v).size(); i++) {\n                        Edge e = graph.get(v).get(i);\n                        if (e.cap <= 0) continue;\n                        int nd = d + e.cost + pot[v] - pot[e.to];\n                        if (nd < dist[e.to]) {\n                            dist[e.to] = nd;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.offer(new int[]{nd, e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] == INF) break;\n\n                int pathCost = dist[t] + pot[t] - pot[s];\n\n                for (int v = 0; v < n; v++) {\n                    if (dist[v] < INF) pot[v] += dist[v];\n                }\n\n                int add = maxf - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    add = Math.min(add, graph.get(prevv[v]).get(preve[v]).cap);\n                }\n\n                flow += add;\n                cost += add * pathCost;\n\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = graph.get(prevv[v]).get(preve[v]);\n                    e.cap -= add;\n                    graph.get(v).get(e.rev).cap += add;\n                }\n            }\n\n            return new int[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = sc.nextInt();\n        int K = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        int[] starts = new int[N];\n        for (int i = 0; i < K; i++) {\n            int a =