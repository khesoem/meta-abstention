em.out.println(res);\n        }\n    }\n    \n    private static long modExp(long base, long exp, int mod) {\n        base = ((base % mod) + mod) % mod;\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % mod;\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_exp(base, exp, mod):\n    base = ((base % mod) + mod) % mod\n    res = 1\n    while exp > 0:\n        if (exp & 1) == 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.readline().strip().split()\n    n = int(data[0])\n    m = int(data[1])\n    l = int(data[2])\n    r = int(data[3])\n    \n    total = n * m\n    MOD = 998244353\n    \n    if total & 1:\n        base = r - l + 1\n        print(mod_exp(base, total, MOD))\n    else:\n        k = r - l + 1\n        evens = r // 2 - l // 2\n        if l % 2 == 0:\n            evens += 1\n        odds = k - evens\n        \n        p1 = mod_exp(evens + odds, total, MOD)\n        p2 = mod_exp(evens - odds, total, MOD)\n        inv2 = mod_exp(2, MOD - 2, MOD)\n        res = ((p1 + p2) % MOD * inv2) % MOD\n        print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-6.687417771900073e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.18060539662837982, -0.0007585985003970563, -0.0015046000480651855, -0.00028463127091526985, -0.0003131137927994132, -0.1603255569934845, -2.622600959512056e-06, 0.0, -5.364403477869928e-06, 0.0, -2.50339189733495e-06, -8.22540732769994e-06, -4.768370445162873e-07, -8.344646857949556e-07, -8.344646857949556e-07, -6.806619057897478e-05, -4.768370445162873e-07, 0.0, -5.9604627