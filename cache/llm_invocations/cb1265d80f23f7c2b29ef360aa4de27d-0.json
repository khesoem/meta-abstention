 return 0\n\ndef maxflow():\n    global current, headEdge, src, INF\n    ans = 0\n    while bfs():\n        current = headEdge[:]  # copy\n        while True:\n            pushed = dfs(src, INF)\n            if pushed == 0:\n                break\n            ans += pushed\n    return ans\n\ndef valid(r, c, n, m):\n    return 0 <= r < n and 0 <= c < m\n\ndef idCell(x, y, m):\n    return 1 + m * x + y\n\ndef main():\n    global headEdge, toNode, nextEdge, edgeCap, distLevel, current, src, sink\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    deadline = int(next(it))\n    deadline += 1\n    m = n\n\n    sci = []\n    for _ in range(n):\n        sci.append(next(it))\n    rea = []\n    for _ in range(n):\n        rea.append(next(it))\n\n    # danger array\n    danger = [[INF] * m for _ in range(n)]\n    q0 = deque()\n    for i in range(n):\n        for j in range(m):\n            if rea[i][j] == 'Z':\n                q0.append((i, j))\n                danger[i][j] = 1\n\n    while q0:\n        x, y = q0.popleft()\n        for dx in (-1, 0, 1):\n            for dy in (-1, 0, 1):\n                if abs(dx) + abs(dy) != 1:\n                    continue\n                nx, ny = x + dx, y + dy\n                if valid(nx, ny, n, m) and danger[nx][ny] == INF and sci[nx][ny] != 'Y':\n                    danger[nx][ny] = danger[x][y] + 1\n                    q0.append((nx, ny))\n\n    src = 0\n    sink = n * n + n * n + 1\n    nodes = n * n * 2 + 2\n    headEdge = [-1] * nodes\n    toNode.clear()\n    nextEdge.clear()\n    edgeCap.clear()\n    distLevel = [-1] * nodes\n    current = [-1] * nodes\n\n    # Build graph\n    for x in range(n):\n        for y in range(m):\n            # source edges from sci digits\n            if '1' <= sci[x][y] <= '9':\n                addEdge(src, idCell(x, y, m), ord(sci[x][y]) - ord('0'))\n            # sink edges to rea digits\n            if '1' <= rea[x][y] <= '9':\n                addEdge(n * n + idCell(x, y, m), sink, ord(rea[x][y]) - ord('0'))\n\n            # edges between sci and rea cells\n            for X in range(n):\n                for Y in range(m):\n                    if sci[x][y] == 'Y' or sci[x][y] == 'Z' or rea[X][Y] == 'Y' or rea[X][Y] == 'Z':\n                        continue\n                    # BFS from (x,y) to (X,Y) with time constraints\n                    seen = [[False] * m for _ in range(n)]\n                    q1 = deque()\n                    q1.append(((x, y), 1))\n                    seen[x][y] = True\n                    found = False\n                    while q1:\n                        (cx, cy), tim = q1.popleft()\n                        if cx == X and cy == Y:\n                            found = True\n                            break\n                        if tim >= danger[cx][cy] or tim >= deadline:\n                            continue\n                        for dx in (-1, 0, 1):\n                            for dy in (-1, 0, 1):\n                                if abs(dx) + abs(dy) != 1:\n                                    continue\n                                nx, ny = cx + dx, cy + dy\n                                if valid(nx, ny, n, m) and not seen[nx][ny] and \\\n                                   sci[nx][ny] != 'Y' and sci[nx][ny] != 'Z' and \\\n                                   tim + 1 <= danger[nx][ny]:\n                                    seen[nx][ny] = True\n                                    q1.append(((nx, ny), tim + 1))\n                    if found:\n                        addEdge(idCell(x, y, m), n * n + idCell(X, Y, m), INF)\n\n    print(maxflow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.3881147323409095e-05, 0.0, 0.0, -0.0001431601122021675, -0.00031573555315844715, 0.0, -2.0265558760002023e-06, -8.272782724816352e-05, 0.0, 0.0, -1.1920922133867862e-06, -0.001965259201824