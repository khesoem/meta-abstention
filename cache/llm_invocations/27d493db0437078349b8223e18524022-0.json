     self.M = 7010010\n        self.h = [-1] * self.N\n        self.ing = [0] * self.N\n        self.pre = [0] * self.N\n        self.to = [0] * self.M\n        self.ne = [0] * self.M\n        self.e = 0\n        self.s = 0\n        self.t = 0\n        self.n = 0\n        self.cap = [0] * self.M\n        self.cost = [0] * self.M\n        self.flow = 0\n        self.mincost = 0\n\n    def ini(self, _n=None):\n        if _n is None:\n            _n = self.N\n        self.h = [-1] * _n\n        self.e = 0\n        self.n = _n\n\n    def liu(self, u, v, c, w):\n        self.to[self.e] = v\n        self.ne[self.e] = self.h[u]\n        self.cap[self.e] = c\n        self.cost[self.e] = w\n        self.h[u] = self.e\n        self.e += 1\n\n    def link(self, u, v, c, w):\n        self.liu(u, v, c, w)\n        self.liu(v, u, 0, -w)\n\n    def spfa(self):\n        dis = [float('inf')] * self.n\n        Q = deque()\n        Q.append(self.s)\n        self.ing = [0] * self.n\n        self.ing[self.s] = 1\n        dis[self.s] = 0\n\n        while Q:\n            c = Q.popleft()\n            self.ing[c] = 0\n            k = self.h[c]\n            while k != -1:\n                if self.cap[k] > 0:\n                    v = self.to[k]\n                    if dis[c] + self.cost[k] < dis[v]:\n                        dis[v] = dis[c] + self.cost[k]\n                        self.pre[v] = k\n                        if not self.ing[v]:\n                            Q.append(v)\n                            self.ing[v] = 1\n                k = self.ne[k]\n\n        return dis[self.t] != float('inf')\n\n    def run(self, _s, _t):\n        self.s = _s\n        self.t = _t\n        self.flow = 0\n        self.mincost = 0\n\n        while self.spfa():\n            pl = float('inf')\n            p = self.t\n            while p != self.s:\n                k = self.pre[p]\n                pl = min(pl, self.cap[k])\n                p = self.to[k ^ 1]\n\n            p = self.t\n            while p != 