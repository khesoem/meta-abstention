], Aux, K + 1)\n            else:\n                copy_mat(A_cnt[0], S[cnt - 1][0], K + 1)\n        copy_mat(P_cnt[0], A_cnt[0], K + 1)\n        copy_mat(S_cnt[K - 1], A_cnt[K - 1], K + 1)\n        for x in range(1, K):\n            mul(P_cnt[x - 1], A_cnt[x], P_cnt[x], K + 1, K + 1, K + 1)\n        for x in range(K - 2, -1, -1):\n            mul(A_cnt[x], S_cnt[x + 1], S_cnt[x], K + 1, K + 1, K + 1)\n        A.append(A_cnt)\n        P.append(P_cnt)\n        S.append(S_cnt)\n        if m > N // K:\n            break\n        m *= K\n        cnt += 1\n\n    # main decomposition\n    init = N\n    ind2 = 0\n    Res = zero_mat(K + 1)\n    Res[0][K] = 1\n    for i in range(ind, -1, -1):\n        power = pows[i]\n        while power <= init:\n            mul(Res, A[i][ind2], Aux, K + 1, K + 1, K + 1)\n            copy_mat(Res, Aux, K + 1)\n            ind2 += 1\n            if ind2 == K:\n                ind2 = 0\n            init -= power\n\n    ans = sum(Res[0][j] for j in range(K + 1)) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n```\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.025262653827667236, -0.6953318119049072, -5.364403477869928e-06, -0.000849601230584085, -0.0001299296854995191, 0.0, -0.00021228920377325267, -2.8013790142722428e-05, -2.264974000354414e-06, -5.960446742392378e-06, -0.0005676327273249626, -1.7881377516459906e-06, -2.3841855067985307e-07, -6.318072337307967e-06, -0.0015354283386841416, -3.0874729418428615e-05, -0.38726621866226196, -0.004091108217835426, -0.00011646069469861686, -4.589452510117553e-05, -1.4305104514278355e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -4.410734163684538e-06, -1.3351351299206726e-05, -9.536738616588991e-07, -0.06209500506520271, -1.1920928244535389e-07, -1.4305104514278355e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -0.003330044448375702, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -1.1920922133867862e-06, -3.576278118089249e-07, -9.53673