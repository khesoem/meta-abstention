{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int MAXN = 10000010, BIG = 0x3f3f3f3f;\nint n, m, k, c, d, src = 0, sink, total = 0;\nint edge_cnt = 1, head[MAXN], to[MAXN], nxt[MAXN], cap[MAXN], cost[MAXN];\nint dist[MAXN], flow[MAXN], prev_edge[MAXN]; bool in_queue[MAXN];\n\nvoid add_edge(int x, int y, int z, int v) {\n    to[++edge_cnt] = y; nxt[edge_cnt] = head[x]; head[x] = edge_cnt; cap[edge_cnt] = z; cost[edge_cnt] = v;\n    to[++edge_cnt] = x; nxt[edge_cnt] = head[y]; head[y] = edge_cnt; cap[edge_cnt] = 0; cost[edge_cnt] = -v;\n}\n\nbool spfa() {\n    fill(flow, flow + MAXN, 0);\n    fill(dist, dist + MAXN, BIG);\n    fill(in_queue, in_queue + MAXN, false);\n    queue<int> q;\n    q.push(src); flow[src] = BIG; in_queue[src] = true; dist[src] = 0;\n    while (!q.empty()) {\n        int u = q.front(); q.pop(); in_queue[u] = false;\n        for (int i = head[u]; i; i = nxt[i]) {\n            if (!cap[i] || dist[to[i]] <= dist[u] + cost[i]) continue;\n            dist[to[i]] = dist[u] + cost[i];\n            flow[to[i]] = min(flow[u], cap[i]);\n            prev_edge[to[i]] = i;\n            if (!in_queue[to[i]]) {\n                in_queue[to[i]] = true;\n                q.push(to[i]);\n            }\n        }\n    }\n    return dist[sink] != BIG;\n}\n\nvoid augment() {\n    int cur = sink;\n    while (cur != src) {\n        int e = prev_edge[cur];\n        cap[e] -= flow[sink];\n        cap[e ^ 1] += flow[sink];\n        cur = to[e ^ 1];\n    }\n    total += flow[sink] * dist[sink];\n}\n\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    sink = (n + k - 1) * n + 1;\n    for (int i = 1, x; i <= k; i++) {\n        cin >> x;\n        add_edge(src, x, 1, 0);\n    }\n    for (int i = 1, x, y; i <= m; i++) {\n        cin >> x >> y;\n        for (int j = 1; j <= n + k; j++)\n            for (int h = 1; h <= k; h++) {\n                add_edge(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n                add_edge(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c);\n            }\n    }\n    for (int i = 1; i < n + k; i++) {\n        for (int j = 2; j <= n; j++)\n            add_edge(j + (i - 1) * n, j + i * n, BIG, c);\n        add_edge(1 + (i - 1) * n, 1 + i * n, BIG, 0);\n    }\n    while (spfa()) augment();\n    cout << total << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**15\n\ndef min_cost_flow(n_nodes, edges, src, sink):\n    flow_val = 0\n    cost_val = 0\n    N = n_nodes\n    potential = [0] * N  # not used, but keep for compatibility\n    in_queue = [False] * N\n    dist = [INF] * N\n    prevv = [0] * N\n    preve = [0] * N\n    while True:\n        dist = [INF] * N\n        in_queue = [False] * N\n        dist[src] = 0\n        q = deque([src])\n        in_queue[src] = True\n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            for i, (v, cap, cost, rev) in enumerate(edges[u]):\n                if cap > 0 and dist[v] > dist[u] + cost:\n                    dist[v] = dist[u] + cost\n                    prevv[v] = u\n                    preve[v] = i\n                    if not in_queue[v]:\n                        in_queue[v] = True\n                        q.append(v)\n        if dist[sink] == INF:\n            break\n        # find augment flow\n        d = INF\n        v = sink\n        while v != src:\n            u = prevv[v]\n            e = preve[v]\n            d = min(d, edges[u][e][1])\n            v = u\n        v = sink\n        while v != src:\n            u = prevv[v]\n            e = preve[v]\n            edges[u][e][1] -= d\n            edges[v][edges[u][e][3]][1] += d\n            v = u\n        flow_val += d\n        cost_val += d * dist[sink]\n    return cost_val\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    src = 0\n    # sink = (n + k - 1) * n + 1\n    # maximum node index needed: n * (n + k + 1) (from j = n+k, second vertex = y + (n+k)*n)\n    max_time = n + k + 1\n    N = n * max_time + 1  # nodes from 1 to n*max_time, plus source 0\n    sink = (n + k - 1) * n + 1\n    edges = [[] for _ in range(N)]\n\n    def add_edge(x, y, cap, cost):\n        edges[x].append([y, cap, cost, len(edges[y])])\n        edges[y].append([x, 0, -cost, len(edges[x]) - 1])\n\n    for _ in range(k):\n        x = next(it)\n        add_edge(src, x, 1, 0)\n\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for j in range(1, n + k + 1):\n            for h in range(1, k + 1):\n                # first vertex at time j, second at time j+1\n                add_edge(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c)\n                add_edge(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c)\n\n    for i in range(1, n + k):\n        for j in range(2, n + 1):\n            add_edge(j + (i - 1) * n, j + i * n, INF, c)\n        add_edge(1 + (i - 1) * n, 1 + i * n, INF, 0)\n\n    total_cost = min_cost_flow(N, edges, src, sink)\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001397035230183974, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.0012165057705715299, -0.0009653675369918346, -8.344646857949556e-07, -0.00011205045302631333, -0.0015126940561458468, -7.152555099310121e-07, -1.1920928244535389e-07, -4.768360213347478e-06, -0.001212338567711413, -1.7021013498306274, -2.634490556374658e-05, -3.933898824470816e-06, -0.00020644917094614357, -0.20141498744487762, -0.06145644187927246, -0.006185435689985752, -0.00175691198091954, -5.109515190124512, -0.0053005157969892025, -0.000912250077817589, 0.0, -1.428336262702942, -1.5388903617858887, -0.0008429311565123498, -2.346243381500244, -0.001597201102413237, -0.23980523645877838, -5.483612312673358e-06, -3.8980677345534787e-05, -0.20152394473552704, -6.198863957251888e-06, -2.0605287551879883, -0.7941763997077942, -4.7444173105759546e-05, -0.08352568745613098, -1.311301275563892e-06, -0.00044347942457534373, 0.0, -0.26457706093788147, -0.05373380705714226, -4.768370445162873e-07, -2.8967437174287625e-05, -1.4305104514278355e-06, -0.0004781533498317003, -4.768370445162873e-07, -0.391603022813797, -3.755022044060752e-05, -0.0011739989276975393, 0.0, -0.0016089839627966285, -3.576278118089249e-07, -3.509030342102051, -2.7417760065873154e-05, -0.0003800861886702478, -9.691245941212401e-05, -0.07890891283750534, -1.728519782773219e-05, -7.223821739898995e-05, -0.3967491090297699, -7.152555099310121e-07, -0.20726768672466278, -0.20499810576438904, -0.7597634196281433, -0.43844476342201233, -1.2279397249221802, -0.4674510955810547, -1.5597087144851685, -0.691948652267456, -1.311301275563892e-06, -8.561315536499023, -0.05753736197948456, -5.411955135059543e-05, -3.802703940891661e-05, -0.0005707303644157946, -2.1576648578047752