\n        self.level = [0] * n\n        self.ptr = [0] * n\n\n    def add_edge(self, u, v, cap):\n        self.g[u].append([v, cap, len(self.g[v])])\n        self.g[v].append([u, 0, len(self.g[u]) - 1])\n\n    def bfs(self):\n        self.level = [-1] * self.n\n        q = deque()\n        q.append(self.s)\n        self.level[self.s] = 0\n        while q:\n            cur = q.popleft()\n            for e in self.g[cur]:\n                if self.level[e[0]] == -1 and e[1] > 0:\n                    self.level[e[0]] = self.level[cur] + 1\n                    q.append(e[0])\n        return self.level[self.t] != -1\n\n    def dfs(self, cur, pushed):\n        if cur == self.t:\n            return pushed\n        i = self.ptr[cur]\n        while i < len(self.g[cur]):\n            e = self.g[cur][i]\n            if self.level[e[0]] == self.level[cur] + 1 and e[1] > 0:\n                tr = self.dfs(e[0], min(pushed, e[1]))\n                if tr:\n                    e[1] -= tr\n                    self.g[e[0]][e[2]][1] += tr\n                    self.ptr[cur] = i\n                    return tr\n            i += 1\n        self.ptr[cur] = i\n        return 0\n\n    def max_flow(self):\n        flow = 0\n        INF = 10 ** 9\n        while self.bfs():\n            self.ptr = [0] * self.n\n            while True:\n                pushed = self.dfs(self.s, INF)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\n\ndef solve():\n    global n, tLimit, grid, exits, dist, sy, sx\n    q = deque()\n    q.append((sy, sx))\n    dist[sy][sx] = 1\n    depth = 1\n    while q:\n        sz = len(q)\n        for _ in range(sz):\n            y, x = q.popleft()\n            for d in range(4):\n                ny = y + dy[d]\n                nx = x + dx[d]\n                if ny < 0 or ny >= n or nx < 0 or nx >= n:\n                    continue\n                if dist[ny][nx] or grid[ny][nx] == 'Y':\n                    continue\n                dist[ny][nx] = depth\n                q.append((ny, nx))\n        depth += 1\n        depth = min(depth, tLimit)\n\n\ndef main():\n    global n, tLimit, grid, exits, dist, sy, sx\n    input_data = sys.stdin.read().splitlines()\n    # first line\n    first = input_data[0].split()\n    n = int(first[0])\n    tLimit = int(first[1])\n    grid = []\n    idx = 1\n    for i in range(n):\n        grid.append(input_data[idx].strip())\n        idx += 1\n    # skip two blank lines\n    idx += 2  # because there are two blank lines after grid\n    exits = []\n    for i in range(n):\n        exits.append(input_data[idx].strip())\n        idx += 1\n\n    # find start\n    sy = sx = -1\n    for i in range(n):\n        for j in range(n):\n            if grid[i][j] == 'Z':\n                sy, sx = i, j\n                break\n        if sy != -1:\n            break\n\n    dist = [[0] * n for _ in range(n)]\n    solve()\n\n    # assign node ids\n    nodeId = [[[0] * (tLimit + 2) for _ in range(n)] for _ in range(n)]\n    nodes = 0\n    for i in range(n):\n        for j in range(n):\n            if '0' <= grid[i][j] <= '9':\n                if dist[i][j] == 0:\n                    dist[i][j] = tLimit\n                for t in range(dist[i][j]):\n                    nodes += 1\n                    nodeId[i][j][t] = nodes\n            if '1' <= exits[i][j] <= '9':\n                nodes += 1\n                nodeId[i][j][dist[i][j]] = nodes\n\n    INF = 10 ** 9\n    S = 0\n    T = nodes + 3\n    mf = Dinic(nodes + 5, S, T)\n\n    for i in range(n):\n        for j in range(n):\n            if '1' <= grid[i][j] <= '9':\n                mf.add_edge(S, nodeId[i][j][0], ord(grid[i][j]) - ord('0'))\n            for d in range(4):\n                ny = i + dy[d]\n                nx = j + dx[d]\n                if ny < 0 or ny >= n or nx < 0 or nx >= n:\n                    continue\n                if grid[ny][nx] == 'Y' or grid[ny][nx] == 'Z':\n                    continue\n                t = 0\n                while True:\n                    if nodeId[i][j][t] == 0:\n                        break\n                    if t == dist[i][j] and '1' <= exits[i][j] <= '9':\n                        break\n                    if nodeId[ny][nx][t + 1]:\n                        mf.add_edge(nodeId[i][j][t], nodeId[ny][nx][t + 1], INF)\n                    t += 1\n            if '1' <= exits[i][j] <= '9':\n                for t in range(dist[i][j]):\n                    mf.add_edge(nodeId[i][j][t], nodeId[i][j][t + 1], INF)\n                mf.add_edge(nodeId[i][j][dist[i][j]], T, ord(exits[i][j]) - ord('0'))\n\n    print(mf.max_flow())\n\n\ndy = [1, -1, 0, 0]\ndx = [0, 0, 1, -1]\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.12814770638942719, -0.0025009801611304283, -1.1920928244535389e-07, -9.536738616588991e-07, -0.000607782625593245, -0.029886141419410706, 0.0, -1.4185804502631072e-05, -0.06688777357339859, -1.1920928244535389e-07, 0.0, -4.6491513785440475e-06, -0.16039998829364777, -0.003698534332215786, 0.0, 0.0, -1.0490362910786644e-05, 0.0, -1.1920928244535389e-07, -0.0036557766143232584, -4.565611743601039e-05, -0.0002269487304147333, -0.00500758271664381, -0.00318508199416101, 0.0, 0.0, -2.3841855067985307e-07, -3.576278118089249e-07, -7.510157047363464e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -5.864924969500862e-05, -1.6569954823353328e-05, -0.0005637010326609015, -7.152555099310121e-07, 0.0, -9.536738616588991e-07, 0.0, 0.0, -0.00013136000779923052, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -0.0007378716254606843, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, -0.0031836561392992735, 0.0, -1.1920928244535389e-07, -1.1920928