r (int &i = ptr[cur]; i < (int)g[cur].size(); ++i) {\n            Edge &e = g[cur][i];\n            if (level[e.to] == level[cur] + 1 && e.cap != 0) {\n                int tr = dfs(e.to, min(pushed, e.cap));\n                if (tr) {\n                    e.cap -= tr;\n                    g[e.to][e.rev].cap += tr;\n                    return tr;\n                }\n            }\n        }\n        return 0;\n    }\n    ll maxFlow() {\n        ll flow = 0;\n        while (bfs()) {\n            fill(ptr.begin(), ptr.end(), 0);\n            while (true) {\n                int pushed = dfs(src, 2e9);\n                if (!pushed) break;\n                flow += pushed;\n            }\n        }\n        return flow;\n    }\n};\nint n, tLimit;\nstring grid[15], exits[15];\nint dist[15][15];\nint sy, sx;\nconst int dy[4] = {1, -1, 0, 0};\nconst int dx[4] = {0, 0, 1, -1};\nvoid solve() {\n    queue<pair<int,int>> q;\n    q.push({sy,sx});\n    dist[sy][sx] = 1;\n    int depth = 1;\n    while (!q.empty()) {\n        int sz = (int)q.size();\n        for (int it = 0; it < sz; ++it) {\n            auto p = q.front(); q.pop();\n            for (int d = 0; d < 4; ++d) {\n                int ny = p.first + dy[d];\n                int nx = p.second + dx[d];\n                if (ny < 0 || ny >= n || nx < 0 || nx >= n) continue;\n                if (dist[ny][nx] || grid[ny][nx] == 'Y') continue;\n                dist[ny][nx] = depth;\n                q.push({ny,nx});\n            }\n        }\n        ++depth;\n        depth = min(depth, tLimit);\n    }\n}\nint nodeId[15][15][65];\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> tLimit;\n    for (int i = 0; i < n; ++i) {\n        cin >> grid[i];\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] == 'Z') { sy = i; sx = j; }\n        }\n    }\n    getline(cin, grid[n]);\n    getline(cin, grid[n]);\n    for (int i = 0; i < n; ++i) cin >> exits[i];\n    solve();\n    int nodes = 0;\