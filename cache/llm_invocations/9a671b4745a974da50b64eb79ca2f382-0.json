ivate final InputStream is = System.in;\n        private final byte[] buffer = new byte[1 << 16];\n        private int ptr = 0, len = 0;\n\n        private int read() throws IOException {\n            if (ptr >= len) {\n                len = is.read(buffer);\n                ptr = 0;\n                if (len <= 0) return -1;\n            }\n            return buffer[ptr++];\n        }\n\n        private long nextLong() {\n            try {\n                int c = read();\n                while (c <= 32) c = read();\n                int sign = 1;\n                if (c == '-') {\n                    sign = -1;\n                    c = read();\n                }\n                long val = 0;\n                while (c > 32) {\n                    val = val * 10 + c - '0';\n                    c = read();\n                }\n                return val * sign;\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <cmath>\n#include <vector>\n#include <algorithm>\n#include <climits>\n#include <cctype>\n#include <iomanip>\n#include <queue>\n#include <map>\n#include <set>\n#include <stack>\n#include <cstring>\n#include <cstdio>\n#include <cstdlib>\nusing namespace std;\n\nconst long long MOD = 998244353;\n\nlong long modPow(long long b, long long e, long long m) {\n    b %= m;\n    long long res = 1;\n    while (e > 0) {\n        if ((e & 1) == 1) res = (res * b) % m;\n        b = (b * b) % m;\n        e >>= 1;\n    }\n    return res;\n}\n\nclass FastInput {\nprivate:\n    FILE* file;\n    char buffer[1 << 16];\n    int ptr, len;\n\npublic:\n    FastInput() : ptr(0), len(0) {\n        file = stdin;\n    }\n\n    int read() {\n        if (ptr >= len) {\n            len = fread(buffer, 1, sizeof(buffer), file);\n     