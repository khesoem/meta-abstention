n}\n\nint main() {\n\tscanf(\"%d%d%d\",&L,&k,&Mo);\n\tint all=pwr(k,L);\n\tif (L&1) {\n\t\tprintf(\"%d\\n\",all);\n\t\treturn 0;\n\t}\n\tfac[0]=1;fo(i,1,L) fac[i]=(ll)fac[i-1]*i%Mo;\n\tinv[L]=pwr(fac[L],Mo-2);fd(i,L-1,0) inv[i]=(ll)inv[i+1]*(i+1)%Mo;\n\tfo(s,1,L) cnt[s]=cnt[s^(s&-s)]+1;\n\tfo(i,0,18) if (L>>i&1) bit[++n]=1<<i;\n\tlen=1<<n;\n\tfo(i,0,len-1) {\n\t\tint s=0;\n\t\tfo(j,1,n) if (i>>(j-1)&1) s+=bit[j];\n\t\tg[cnt[i]][i]=inv[s];\n\t}\n\tfo(i,0,n) FWT(g[i],len);\n\tfo(s,0,len-1) {\n\t\tfo(i,0,n) h[i]=g[i][s];\n\t\tget_ln(h,p,n);\n\t\tfo(i,0,n) p[i]=(ll)p[i]*k%Mo;\n\t\tget_exp(p,h,n);\n\t\tfo(i,0,n) f[i][s]=h[i];\n\t}\n\tIFWT(f[n],len);\n\tint ans=(ll)f[n][len-1]*fac[L]%Mo;\n\tans=(all-ans+Mo)%Mo;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef pwr(x, y, Mo):\n    z = 1\n    while y:\n        if y & 1:\n            z = (z * x) % Mo\n        x = (x * x) % Mo\n        y >>= 1\n    return z\n\ndef inc(x, y, Mo):\n    res = x + y\n    return res if res < Mo else res - Mo\n\ndef dec(x, y, Mo):\n    res = x - y\n    return res if res >= 0 else res + Mo\n\ndef FWT(a, len_, Mo):\n    i = 1\n    while i < len_:\n        j = 0\n        while j < len_:\n            for k in range(i):\n                a[j + k + i] = inc(a[j + k + i], a[j + k], Mo)\n            j += i << 1\n        i <<= 1\n\ndef IFWT(a, len_, Mo):\n    i = 1\n    while i < len_:\n        j = 0\n        while j < len_:\n            for k in range(i):\n                a[j + k + i] = dec(a[j + k + i], a[j + k], Mo)\n            j += i << 1\n        i <<= 1\n\ndef get_ln(a, b, n, Mo):\n    b[0] = 0\n    for i in range(1, n + 1):\n        b[i] = (a[i] * i) % Mo\n        for j in range(1, i):\n            b[i] = (b[i] - b[j] * a[i - j] % Mo * j) % Mo\n        b[i] = (b[i] * pwr(i, Mo - 2, Mo)) % Mo\n\ndef get_exp(a, b, n, Mo):\n    