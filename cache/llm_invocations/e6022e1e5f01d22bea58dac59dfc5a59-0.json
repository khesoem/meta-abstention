        Edge e = g.get(par[v]).get(par_e[v]);\n                e.cap -= f;\n                g.get(v).get(e.rev).cap += f;\n            }\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n\n        cnt = new int[N + 1];\n        for (int i = 0; i < K; ++i) {\n            int x = sc.nextInt();\n            cnt[x]++;\n        }\n\n        id = new int[N + 1][K + M + 3];\n        n_nodes = 2;\n        S = 0;\n        T = 1;\n        g = new ArrayList<>();\n        for (int i = 0; i < 2 + N * (K + M + 2); ++i) {\n            g.add(new ArrayList<>());\n        }\n\n        for (int i = 1; i <= N; ++i) {\n            for (int j = 1; j <= K + M + 2; ++j) {\n                id[i][j] = ++n_nodes;\n                if (i == 1) {\n                    add_edge(id[i][j], T, Integer.MAX_VALUE, C * (j - 1));\n                }\n                if (j > 1) {\n                    add_edge(id[i][j - 1], id[i][j], Integer.MAX_VALUE, 0);\n                }\n            }\n            if (cnt[i] > 0) {\n                add_edge(S, id[i][1], cnt[i], 0);\n            }\n        }\n\n        for (int i = 0; i < M; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 1; j <= K + M + 1; ++j) {\n                for (int k = 1; k <= 2 * K - 1; k += 2) {\n                    add_edge(id[a][j], id[b][j + 1], 1, k * D);\n                    add_edge(id[b][j], id[a][j + 1], 1, k * D);\n                }\n            }\n        }\n\n        int result = mcmf();\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00028153270250186324, -2.0265558760002023e-06, -1.0728830375228426e-06, -0.0011317284079268575, -4.51792984677013e-05, -0.12693318724632263, -0.2520220577