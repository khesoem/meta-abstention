 base = base * base % p;\n        expo >>= 1;\n    }\n    return res;\n}\n\null comb(int N, int M) {\n    return fact[N] * invfact[M] % p * invfact[N - M] % p;\n}\n\nint main() {\n#ifndef ONLINE_JUDGE\n    freopen(\"255x.in\", \"r\", stdin);\n    freopen(\"255x.out\", \"w\", stdout);\n#endif\n\n    fast_input::read(n);\n    fast_input::read(k);\n    fast_input::read(p);\n\n    for (int i = 1; i <= n; ++i) pc[i] = pc[i >> 1] + (i & 1);\n\n    ull powv = mod_pow(k, n);\n    if (n & 1) {\n        printf(\"%d\\n\", powv);\n        return 0;\n    }\n\n    lim = min(k, pc[n]);\n\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i % p;\n\n    invfact[n] = mod_pow(fact[n], p - 2);\n    for (int i = n; i >= 1; --i) invfact[i - 1] = invfact[i] * i % p;\n\n    vector<int> masks;\n    for (int s = n;; s = (s - 1) & n) {\n        masks.push_back(s);\n        if (s == 0) break;\n    }\n\n    for (int s : masks) dp[1][s] = (pc[s] >= 1) ? invfact[s] : 0;\n\n    for (int K = 2; K <= lim; ++K) {\n        for (int s : masks) {\n            if (pc[s] < K) {\n                dp[K][s] = 0;\n                continue;\n            }\n\n            ull cur = 0;\n            int cnt = 0;\n            for (int sub = (s - 1) & s; sub; sub = (sub - 1) & s) {\n                if (pc[sub] >= K - 1) {\n                    cur += dp[K - 1][sub] * invfact[s ^ sub];\n                    if (++cnt == 18) {\n                        cnt = 0;\n                        cur %= p;\n                    }\n                }\n            }\n            dp[K][s] = cur % p;\n        }\n    }\n\n    ull total = 0;\n    for (int i = lim; i >= 1; --i) total += comb(k, i) * dp[i][n];\n\n    ull ans = (powv - total % p * fact[n] % p + p) % p;\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```python\nimport sys\n\ndef mod_pow(base, expo, mod):\n    res = 1\n    while expo > 0:\n        if expo & 1:\n            res = res * base % mod\n        base = base * base % mod\n        expo >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    p = int(next(it))\n\n    # pc[i] = popcount of i\n    pc = [0] * (n + 1)\n    for i in range(1, n + 1):\n        pc[i] = pc[i >> 1] + (i & 1)\n\n    powv = mod_pow(k, n, p)\n    if n & 1:\n        print(powv)\n        return\n\n    lim = min(k, pc[n])\n\n    # factorials\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i - 1] * i % p\n\n    invfact = [1] * (n + 1)\n    invfact[n] = mod_pow(fact[n], p - 2, p)\n    for i in range(n, 0, -1):\n        invfact[i - 1] = invfact[i] * i % p\n\n    # generate all submasks of n\n    masks = []\n    s = n\n    while True:\n        masks.append(s)\n        if s == 0:\n            break\n        s = (s - 1) & n\n\n    # map mask to its index in masks list\n    mask_to_idx = {mask: idx for idx, mask in enumerate(masks)}\n    m = len(masks)\n\n    # dp[K][idx] for K from 1 to lim\n    dp = [[0] * m for _ in range(lim + 1)]\n\n    # initialize K=1\n    for idx, s in enumerate(masks):\n        if pc[s] >= 1:\n            dp[1][idx] = invfact[s]\n        else:\n            dp[1][idx] = 0\n\n    # DP for K >= 2\n    for K in range(2, lim + 1):\n        for idx, s in enumerate(masks):\n            if pc[s] < K:\n                dp[K][idx] = 0\n                continue\n            cur = 0\n            sub = (s - 1) & s\n            while sub:\n                if pc[sub] >= K - 1:\n                    cur = (cur + dp[K - 1][mask_to_idx[sub]] * invfact[s ^ sub]) % p\n                sub = (sub - 1) & s\n            dp[K][idx] = cur\n\n    # compute total\n    total = 0\n    idx_n = mask_to_idx[n]\n    for i in range(lim, 0, -1):\n        comb_val = fact[k] * invfact[i] % p * invfact[k -