 {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        long val = Long.parseLong(br.readLine().trim());\n        int cap = 50;\n        memo = new int[20][cap][cap][100];\n        for (int a = 0; a < 20; a++) {\n            for (int b = 0; b < cap; b++) {\n                for (int c = 0; c < cap; c++) {\n                    Arrays.fill(memo[a][b][c], -1);\n                }\n            }\n        }\n        digits = String.valueOf(val);\n        while (digits.length() < 17) digits = \"0\" + digits;\n        digits = new StringBuilder(digits).reverse().toString();\n        int result = INF;\n        for (int pos = 0; pos < cap; pos++) {\n            for (int neg = 0; neg < cap; neg++) {\n                int candidate = compute(0, pos, neg, 50);\n                if (candidate < result) result = candidate;\n            }\n        }\n        System.out.println(result);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport functools\n\ndef main():\n    INF = int(1e6)\n    digits_str = sys.stdin.readline().strip()\n    cap = 50\n    \n    # Initialize memoization table\n    memo = [[[[ -1 for _ in range(100)] for _ in range(cap)] for _ in range(cap)] for _ in range(20)]\n    \n    # Pad digits to length 17 and reverse\n    digits = digits_str.zfill(17)\n    digits = digits[::-1]\n    \n    @functools.lru_cache(maxsize=None)\n    def compute(i, p, n, c):\n        tc = c - 50\n        if i == 17:\n            return 0 if (p + n + tc == 0) else INF\n        \n        if memo[i][p][n][c] != -1:\n            return memo[i][p][n][c]\n        \n        min_val = INF\n        limit_p = min(15, p)\n        limit_n = min(15, n)\n        \n        for x in range(limit_p + 1):\n            for y in range(limit_n + 1):\n                s = p - n + tc\n                cur_digit = (s % 10 + 10) % 10\n          