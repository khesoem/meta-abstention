cit State(int c) : count(c), total(0) {}\n  State(int c, int s) : count(c), total(s) {}\n  \n  State operator*(const State& rhs) const {\n    int t_val = mult_mod(count, rhs.total);\n    add_mod(t_val, mult_mod(total, rhs.count));\n    return State(mult_mod(count, rhs.count), t_val);\n  }\n  \n  State operator+(const State& rhs) const {\n    int c_val = count;\n    add_mod(c_val, rhs.count);\n    int t_val = total;\n    add_mod(t_val, rhs.total);\n    return State(c_val, t_val);\n  }\n};\n\nState dp_line[MX];\nState dp_table[MX][MX];\n\nvoid run_computation() {\n  // Build combination table\n  for (int i = 0; i <= M_edges; ++i) {\n    comb_table[i][0] = 1;\n    for (int j = 1; j <= i; ++j) {\n      comb_table[i][j] = comb_table[i - 1][j - 1];\n      add_mod(comb_table[i][j], comb_table[i - 1][j]);\n    }\n  }\n  \n  // Fill dp_line\n  dp_line[0] = State(1);\n  for (int k = 1; k <= M_edges; ++k) {\n    auto& entry = dp_line[k];\n    entry = State(0);\n    for (int left = 0; left < k; ++left) {\n      State temp = dp_line[left] * dp_line[k - left - 1];\n      temp = temp * State(comb_table[k - 1][left]);\n      for (int pos = 0; pos < k; ++pos) {\n        State term = temp * State(1 + (pos == left), abs(left - pos));\n        entry = entry + term;\n      }\n    }\n    prnt_err(\"%d %d\\n\", entry.count, entry.total);\n  }\n  \n  // Initialize dp_table\n  for (int i = 0; i <= N_nodes; ++i) {\n    for (int j = 0; j <= M_edges; ++j) {\n      dp_table[i][j] = State(0);\n    }\n  }\n  dp_table[0][0] = State(1);\n  \n  // Fill dp_table\n  for (int i = 0; i < N_nodes; ++i) {\n    for (int j = 0; j <= M_edges; ++j) {\n      State current = dp_table[i][j];\n      if (current.count == 0 && current.total == 0) continue;\n      \n      auto& same_level = dp_table[i + 1][j];\n      same_level = same_level + current;\n      \n      for (int step = 1; j + step <= M_edges && i + step <= N_nodes; ++step) {\n        auto& jump_level = dp_table[min(N_nodes, i + step + 1)][j + step];\n  