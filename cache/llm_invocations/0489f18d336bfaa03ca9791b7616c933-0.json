{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing int64 = long long;\nconstexpr int MOD = 1000000007;\n\ninline int add_(int x, int y) { x += y; if (x >= MOD) x -= MOD; return x; }\ninline int sub_(int x, int y) { x -= y; if (x < 0) x += MOD; return x; }\ninline int mul_(int64 x, int64 y) { return (x * y) % MOD; }\n\nint binpow_(int b, int e) {\n    int r = 1;\n    while (e) {\n        if (e & 1) r = mul_(r, b);\n        b = mul_(b, b);\n        e >>= 1;\n    }\n    return r;\n}\n\nint inv_(int a) { return binpow_(a, MOD - 2); }\nint div_(int a, int b) { return mul_(a, inv_(b)); }\n\nint main() {\n#ifdef LOCAL\n    freopen(\"A.in\", \"r\", stdin);\n    freopen(\"A.out\", \"w\", stdout);\n#endif\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n\n    vector<vector<int>> val(n, vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> val[i][j];\n            val[i][j] = div_(val[i][j], 100);\n        }\n\n    using State = pair<vector<char>, int>;\n    vector<State> cur;\n    cur.reserve(100);\n    cur.emplace_back(vector<char>{0}, 1);\n\n    for (int g = 0; g < n; ++g) {\n        vector<State> nxt;\n        nxt.reserve(1024);\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prob = 1;\n            for (int j = 0; j < n; ++j) {\n                if (mask >> j & 1)\n                    prob = mul_(prob, val[j][g]);\n                else\n                    prob = mul_(prob, sub_(1, val[j][g]));\n            }\n\n            for (const auto& [prev_masks, coef] : cur) {\n                vector<char> cur_masks;\n                for (char base : prev_masks) {\n                    int rem = mask & ~base;\n                    while (rem) {\n                        int bit = rem & -rem;\n                        cur_masks.push_back(base | bit);\n                        rem ^= bit;\n                    }\n                }\n                if (cur_masks.empty()) continue;\n\n                sort(cur_masks.begin(), cur_masks.end());\n                cur_masks.erase(unique(cur_masks.begin(), cur_masks.end()), cur_masks.end());\n\n                nxt.emplace_back(cur_masks, mul_(coef, prob));\n            }\n        }\n\n        sort(nxt.begin(), nxt.end(),\n            [](const State& a, const State& b) {\n                return a.first < b.first;\n            });\n\n        cur.clear();\n        for (int i = 0; i < (int)nxt.size(); ) {\n            int j = i;\n            int cum = 0;\n            const auto& key = nxt[i].first;\n            while (j < (int)nxt.size() && nxt[j].first == key)\n                cum = add_(cum, nxt[j++].second);\n            cur.emplace_back(key, cum);\n            i = j;\n        }\n    }\n\n    int ans = 0;\n    for (const auto& [_, coef] : cur)\n        ans = add_(ans, coef);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\n\ndef add_(x, y):\n    x += y\n    if x >= MOD:\n        x -= MOD\n    return x\n\ndef sub_(x, y):\n    x -= y\n    if x < 0:\n        x += MOD\n    return x\n\ndef mul_(x, y):\n    return (x * y) % MOD\n\ndef binpow_(b, e):\n    r = 1\n    while e:\n        if e & 1:\n            r = mul_(r, b)\n        b = mul_(b, b)\n        e >>= 1\n    return r\n\ndef inv_(a):\n    return binpow_(a, MOD - 2)\n\ndef div_(a, b):\n    return mul_(a, inv_(b))\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    \n    val = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            v = int(next(it))\n            val[i][j] = div_(v, 100)\n    \n    # State: (tuple of masks (as frozenset), coefficient)\n    # Using list of (frozenset, coef) for current states\n    cur = [(frozenset({0}), 1)]\n    \n    for g in range(n):\n        nxt = []\n        \n        for mask in range(1 << n):\n            prob = 1\n            for j in range(n):\n                if (mask >> j) & 1:\n                    prob = mul_(prob, val[j][g])\n                else:\n                    prob = mul_(prob, sub_(1, val[j][g]))\n            \n            for prev_masks, coef in cur:\n                cur_masks = set()\n                for base in prev_masks:\n                    rem = mask & ~base\n                    while rem:\n                        bit = rem & -rem\n                        cur_masks.add(base | bit)\n                        rem ^= bit\n                \n                if not cur_masks:\n                    continue\n                \n                cur_masks_frozen = frozenset(cur_masks)\n                nxt.append((cur_masks_frozen, mul_(coef, prob)))\n        \n        # Group by mask set\n        grouped = defaultdict(int)\n        for masks, coef in nxt:\n            grouped[masks] = add_(grouped[masks], coef)\n        \n        cur = [(masks, coef) for masks, coef in grouped.items()]\n    \n    ans = 0\n    for _, coef in cur:\n        ans = add_(ans, coef)\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00021217002358753234, -1.7881377516459906e-06, -7.152555099310121e-07, -0.017410187050700188, -0.00025293012731708586, -0.014181078411638737, -0.006992156617343426, -0.20733629167079926, -3.576278118089249e-07, -0.011175066232681274, -0.5760447382926941, -0.00013636612857226282, 0.0, -4.768370445162873e-07, 0.0, -4.768370445162873e-07, -0.0007113072206266224, 0.0, -5.960462772236497e-07, 0.0, -2.861018856492592e-06, -4.768370445162873e-07, -5.960462772236497e-07, -1.0728830375228426e-06, -1.3470558769768104e-05, -1.9907753085135482e-05, -0.018625717610120773, -0.00021765247220173478, -2.3841855067985307e-07, -2.50339189733495e-06, -6.318072337307967e-06, -2.264974000354414e-06, -2.3841855067985307e-07, -2.50339189733495e-06, -0.014166387729346752, -3.576278118089249e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.7418097943154862e-06, -9.536738616588991e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.862306402879767e-05, -8.344646857949556e-07, -1.4305104514278355e-06, -2.3841855067985307e-07, -1.4305104514278355e-06, -8.702239938429557e-06, -2.3841855067985307e-07, -2.622600959512056e-06, -1.8358061424805783e-05, 0.0, 0.0, -1.764281842042692e-05, -1.1920922133867862e-06, 0.0, -2.50339189733495e-06, -6.6756979322235566e-06, -1.7881377516459906e-06, -1.1920928244535389e-07, 0.0, -2.622600959512056e-06, 0.0, -3.576278118089249e-07, -2.1457441107486375e-05, 0.0, -4.768370445162873e-07, -1.311301275563892e-06, -1.6689286894688848e-06, -9.417489309271332e-06, -9.536697689327411e-06, -5.960462772236497e-07, -3.576278118089249e-07, -3.576278118089249e-07, -9.536738616588991e-07,