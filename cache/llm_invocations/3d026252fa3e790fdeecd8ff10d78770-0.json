   Mint() { x = 0; }\n        Mint(long v) {\n            v %= MOD;\n            if (v < 0) v += MOD;\n            x = (int) v;\n        }\n        Mint(int v) { this((long) v); }\n\n        Mint add(Mint o) {\n            int res = x + o.x;\n            if (res >= MOD) res -= MOD;\n            return new Mint(res);\n        }\n        Mint sub(Mint o) {\n            int res = x - o.x;\n            if (res < 0) res += MOD;\n            return new Mint(res);\n        }\n        Mint mul(Mint o) {\n            long res = (long) x * o.x % MOD;\n            return new Mint(res);\n        }\n        Mint div(Mint o) {\n            return this.mul(inv(o));\n        }\n\n        static Mint inv(Mint a) {\n            long[] xy = new long[2];\n            long g = gcdExtended(a.x, MOD, xy);\n            // g should be 1\n            return new Mint(xy[0]);\n        }\n\n        static long gcdExtended(long a, long b, long[] xy) {\n            if (b == 0) {\n                xy[0] = 1;\n                xy[1] = 0;\n                return a;\n            }\n            long[] xy1 = new long[2];\n            long g = gcdExtended(b, a % b, xy1);\n            xy[0] = xy1[1];\n            xy[1] = xy1[0] - (a / b) * xy1[1];\n            return g;\n        }\n    }\n\n    static long po(int x) {\n        return 1L << x;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        Mint[][] p = new Mint[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int val = sc.nextInt();\n                p[i][j] = new Mint(val).div(new Mint(100));\n            }\n        }\n\n        long[] no = new long[n];\n        for (int i = 0; i < n; i++) {\n            no[i] = 0;\n            for (int j = 0; j < (1 << n); j++) {\n                if (((j >> i) & 1) == 0) {\n                    no[i] |= po(j);\n                }\n            }\n        }\n\n        HashMap<Lo