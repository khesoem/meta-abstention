tf cap[MAXN],mxflow;\nbool in_queue[MAXN];\nvoid flow(int s, int t){\n\tmemset(in_queue,0,sizeof(in_queue));\n\tmxflow=mncost=0;\n\twhile(1){\n\t\tfill(dist,dist+nodes,INFCOSTO);dist[s]=0;\n\t\tmemset(pre,-1,sizeof(pre));pre[s]=0;\n\t\tmemset(cap,0,sizeof(cap));cap[s]=INFFLUJO;\n\t\tqueue<int> q;q.push(s);in_queue[s]=1;\n\t\twhile(SZ(q)){\n\t\t\tint u=q.front();q.pop();in_queue[u]=0;\n\t\t\tfore(_,0,SZ(g[u])){\n\t\t\t\tint i=g[u][_];\n\t\t\t\tedge &E=e[i];\n\t\t\t\tif(E.rem()&&dist[E.v]>dist[u]+E.cost+1e-9){\n\t\t\t\t\tdist[E.v]=dist[u]+E.cost;\n\t\t\t\t\tpre[E.v]=i;\n\t\t\t\t\tcap[E.v]=min(cap[u],E.rem());\n\t\t\t\t\tif(!in_queue[E.v])q.push(E.v),in_queue[E.v]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(pre[t]<0)break;\n\t\tmxflow+=cap[t];mncost+=cap[t]*dist[t];\n\t\tfor(int v=t;v!=s;v=e[pre[v]].u){\n\t\t\te[pre[v]].flow+=cap[t];e[pre[v]^1].flow-=cap[t];\n\t\t}\n\t}\n}\nint main() {\n  ios::sync_with_stdio(false);\n\tll n,m,k,c,d;\n  cin>>n>>m>>k>>c>>d;\n\tint MAXT=n+k;\n\tif(DEBUG)cout<<\"MAXT: \"<<MAXT<<endl;\n\tvector<int>a(k);\n\tfore(i,0,k){\n\t\tcin>>a[i];a[i]--;\n\t\tadd_edge(SRC,a[i]*MAXT,1,0);\n\t}\n\tfore(j,0,MAXT)add_edge(j,SNC,k,0);\n\tfore(i,0,m) {\n\t\tint x,y;cin>>x>>y;x--,y--;\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(x*MAXT+j,y*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(y*MAXT+j,x*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t}\n\tfore(i,0,n) {\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(i*MAXT+j,i*MAXT+j+1,1,c);\n\t\t}\n\t}\n\tflow(SRC,SNC);\n\tif(DEBUG)cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n\tcout<<mncost<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int u, v;\n        long cap, flow;\n        int cost;\n\n        public Edge(int u, int v, long cap, int cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.cost = cost;\n        }\n\n        public long rem() {\n            return cap - flow;\n        }\n    }\n\n    static class Pair implements Comparable<Pair> {\n        int u, v;\n        long cost;\n\n        public Pair(int u, int v, long cost) {\n            this.u = u;\n            this.v = v;\n            this.cost = cost;\n        }\n\n        @Override\n        public int compareTo(Pair o) {\n            return Long.compare(cost, o.cost);\n        }\n    }\n\n    static class Graph {\n        int nodes;\n        List<Integer>[] g;\n        List<Edge> e;\n\n        public Graph(int nodes) {\n            this.nodes = nodes;\n            g = new ArrayList[nodes];\n            e = new ArrayList<>();\n            for (int i = 0; i < nodes; i++) {\n                g[i] = new ArrayList<>();\n            }\n        }\n\n        public void addEdge(int u, int v, long cap, int cost) {\n            g[u].add(e.size());\n            e.add(new Edge(u, v, cap, cost));\n            g[v].add(e.size());\n            e.add(new Edge(v, u, 0, -cost));\n        }\n\n        public void flow(int s, int t) {\n            long mncost = 0;\n            long mxflow = 0;\n            boolean[] inQueue = new boolean[nodes];\n            long[] dist = new long[nodes];\n            int[] pre = new int[nodes];\n            long[] cap = new long[nodes];\n\n            while (true) {\n                Arrays.fill(inQueue, false);\n                Arrays.fill(dist, Long.MAX_VALUE);\n                dist[s] = 0;\n                Arrays.fill(pre, -1);\n                pre[s] = 0;\n                Arrays.fill(cap, 0);\n                cap[s] = Long.MAX_VALUE;\n                Queue<Integer> q = new LinkedList<>();\n                q.add(s);\n                inQueue[s] = true;\n\n                while (!q.isEmpty()) {\n                    int u = q.poll();\n                    inQueue[u] = false;\n                    for (int i = 0; i < g[u].size(); i++) {\n                        int v = g[u].get(i);\n                        Edge e = this.e.get(v);\n                        if (e.rem() > 0 && dist[e.v] > dist[u] + e.cost + 1e-9) {\n                            dist[e.v] = dist[u] + e.cost;\n                            pre[e.v] = v;\n                            cap[e.v] = Math.min(cap[u], e.rem());\n                            if (!inQueue[e.v]) {\n                                q.add(e.v);\n                                inQueue[e.v] = true;\n                            }\n                        }\n                    }\n                }\n\n                if (pre[t] < 0) break;\n                mxflow += cap[t];\n                mncost += cap[t] * dist[t];\n                for (int v = t; v != s; v = this.e.get(pre[v]).u) {\n                    this.e.get(pre[v]).flow += cap[t];\n                    this.e.get(pre[v] ^ 1).flow -= cap[t];\n                }\n            }\n\n            System.out.println(mncost);\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        long n = Long.parseLong(st.nextToken());\n        long m = Long.parseLong(st.nextToken());\n        long k = Long.parseLong(st.nextToken());\n        long c = Long.parseLong(st.nextToken());\n        long d = Long.parseLong(st.nextToken());\n        int MAXT = (int) (n + k);\n        Graph g = new Graph(MAXT * k + 2);\n        int SRC = MAXT * k;\n        int SNC = MAXT * k + 1;\n\n        for (int i = 0; i < k; i++) {\n            int a = Integer.parseInt(br.readLine());\n            g.addEdge(SRC, a * MAXT, 1, 0);\n        }\n\n        for (int j = 0; j < MAXT; j++) {\n            for (int K = 1; K <= k; K++) {\n                g.addEdge(j, j + 1, 1, c + d * (2 * K - 1));\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = Integer.parseInt(br.readLine());\n            int y = Integer.parseInt(br.readLine());\n            x--;\n            y--;\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    g.addEdge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                    g.addEdge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    g.addEdge(i * MAXT + j, i * MAXT + j + 1, 1, c);\n                }\n            }\n        }\n\n        g.flow(SRC, SNC);\n    }\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.20356346666812897, -0.030238481238484383, -0.1619042456150055, -0.021373752504587173, -0.0001527187559986487, -0.34908685088157654, -0.6436449885368347, -0.0008173348032869399, -1.2517053619376384e-05, -0.006514023523777723, -0.08877575397491455, -0.02468537911772728, -1.1920999895664863e-05, -0.057188987731933594, -0.18362268805503845, -0.5238165855407715, -0.27302420139312744, -0.8989841341972351, -0.24108697474002838, -0.03231404721736908, -0.0016010099789127707, -0.01209860760718584, -0.11334464699029922, -0.01672060787677765, -5.948720354354009e-05, -0.01883806474506855, -4.184333738521673e-05, -0.4984426200389862, -0.022455114871263504, -0.003618939546868205, -0.001143871108070016, -0.02227993682026863, -6.07969241173123e-06, -0.5921815633773804, -0.0003500597376842052, -0.6332096457481384, -6.49711728328839e-05, -0.7452220320701599, -0.001278084353543818, -0.0020525644067674875, -0.00699217151850462, -8.082716522039846e-05, -2.145769485650817e-06, -2.2649790025752736e-06, -0.00034457421861588955, -0.0015201792120933533, -0.0002454224450048059, -4.08896230510436e-05, -0.005255957134068012, -3.242545426