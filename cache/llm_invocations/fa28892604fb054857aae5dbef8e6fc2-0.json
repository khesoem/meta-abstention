inue;\n        if(int df = dfs(v, min(f, e.cap - e.f))) {\n            e.f += df;\n            adj[v][e.rev].f -= df;\n            return df;\n        }\n    }\n    return 0;\n}\n\nint mf() {\n    int res = 0;\n    while(bfs()) {\n        memset(ptr, 0, sizeof ptr);\n        while(int df = dfs(src, INF))\n            res += df;\n    }\n    return res;\n}\n\nint dx[] = {-1, 0, 0, 1};\nint dy[] = {0, -1, 1, 0};\n\nint n, m;\ntypedef vector<vector<int>> grid;\ntypedef array<int, 2> pa;\ngrid obs, tim, dii;\n\nvoid gbfs(int r, int c, grid &dis, bool chk = false) {\n    for(int i = 0; i < n; i++)\n        fill(dis[i].begin(), dis[i].end(), -1);\n    dis[r][c] = 0;\n    queue<pa> q;\n    q.push({r, c});\n    while(q.size()) {\n        auto p = q.front(); q.pop();\n        if(chk && dis[p[0]][p[1]] == tim[p[0]][p[1]])\n        \tcontinue;\n        pa r;\n        for(int i = 0; i < 4; i++) {\n            r = {p[0] + dx[i], p[1] + dy[i]};\n            if(r[0] < 0 || r[0] >= n || r[1] < 0 || r[1] >= n || dis[r[0]][r[1]] != -1 || obs[r[0]][r[1]]) \n                continue;\n            if(chk && tim[r[0]][r[1]] > -1 && dis[p[0]][p[1]] + 1 > tim[r[0]][r[1]])\n            \tcontinue;\n            dis[r[0]][r[1]] = dis[p[0]][p[1]] + 1;\n            q.push(r);\n        }\n    }\n}\n\nvector<string> lab, rea;\n\nint main() {\n    cin >> n >> m;\n    lab.resize(n);\n    rea.resize(n);\n    for(auto &x : lab)\n        cin >> x;\n    for(auto &x : rea)\n        cin >> x;\n    obs.assign(n, vector<int>(n));\n    tim.assign(n, vector<int>(n));\n    dii.assign(n, vector<int>(n));\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tobs[i][j] = (lab[i][j] == 'Y');\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tif(lab[i][j] == 'Z')\n    \t\t\tgbfs(i, j, tim);\n    src = 2*n*n + 5;\n    dst = src + 1;\n    for(int x = 0; x < n; x++) {\n    \tfor(int y = 0; y < n; y++) {\n    \t\tif(lab[x][y] == 'Z' || lab[x][y] == 'Y')\n    \t\t\tcontinue;\n    \t\tadd_edge(src, n*x + y, lab[x][y] - '0');\n    \t\tadd_edge(n*n + n*x + y, dst, rea[x][y] - '0');\n    \t\tgbfs(x, y, dii, true);\n    \t\tfor(int xp = 0; xp < n; xp++) {\n    \t\t\tfor(int yp = 0; yp < n; yp++) {\n    \t\t\t\tif(dii[xp][yp] != -1 && dii[xp][yp] <= m) {\n    \t\t\t\t\tadd_edge(n*x + y, n*n + n*xp + yp, INF);\n    \t\t\t\t}\n    \t\t\t}\n    \t\t}\n    \t}\n    }\n    cout << mf() << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    \n    lab = [list(next(it).strip()) for _ in range(n)]\n    rea = [list(next(it).strip()) for _ in range(n)]\n    \n    obs = [[0]*n for _ in range(n)]\n    tim = [[-1]*n for _ in range(n)]\n    dii = [[-1]*n for _ in range(n)]\n    \n    for i in range(n):\n        for j in range(n):\n            obs[i][j] = 1 if lab[i][j] == 'Y' else 0\n    \n    # BFS for Z positions (tim)\n    dx = [-1, 0, 0, 1]\n    dy = [0, -1, 1, 0]\n    \n    def gbfs(r, c, dist, chk=False):\n        for i in range(n):\n            dist[i][:] = [-1]*n\n        dist[r][c] = 0\n        q = deque()\n        q.append((r, c))\n        while q:\n            p = q.popleft()\n            if chk and dist[p[0]][p[1]] == tim[p[0]][p[1]]:\n                continue\n            for k in range(4):\n                r2 = p[0] + dx[k]\n                c2 = p[1] + dy[k]\n                if r2 < 0 or r2 >= n or c2 < 0 or c2 >= n:\n                    continue\n                if dist[r2][c2] != -1 or obs[r2][c2]:\n                    continue\n                if chk and tim[r2][c2] > -1 and dist[p[0]][p[1]] + 1 > tim[r2][c2]:\n                    continue\n                dist[r2][c2] = dist[p[0]][p[1]] + 1\n                q.append((r2, c2))\n    \n    for i in range(n):\n        for j in range(n):\n            if lab[i][j] == 'Z':\n                gbfs(i, j, tim)\n    \n    # max flow setup\n    MAXN = 2*n*n + 5\n    INF = 10**9\n    adj = [[] for _ in range(MAXN)]\n    \n    def add_edge(u, v, c, rc=0):\n        adj[u].append([v, len(adj[v]), 0, c])\n        adj[v].append([u, len(adj[u])-1, 0, rc])\n    \n    src = 2*n*n\n    dst = src + 1\n    \n    for x in range(n):\n        for y in range(n):\n            if lab[x][y] == 'Z' or lab[x][y] == 'Y':\n                continue\n            cap_from = ord(lab[x][y]) - ord('0')\n            cap_to = ord(rea[x][y]) - ord('0')\n            add_edge(src, n*x + y, cap_from)\n            add_edge(n*n + n*x + y, dst, cap_to)\n            gbfs(x, y, dii, True)\n            for xp in range(n):\n                for yp in range(n):\n                    if dii[xp][yp] != -1 and dii[xp][yp] <= m:\n                        add_edge(n*x + y, n*n + n*xp + yp, INF)\n    \n    # Dinic\n    dis = [-1]*MAXN\n    ptr = [0]*MAXN\n    \n    def bfs():\n        nonlocal dis\n        dis = [-1]*MAXN\n        dis[src] = 0\n        q = deque([src])\n        while q:\n            u = q.popleft()\n            for e in adj[u]:\n                v, _, f, cap = e\n                if dis[v] == -1 and f < cap:\n                    dis[v] = dis[u] + 1\n                    q.append(v)\n        return dis[dst] != -1\n    \n    def dfs(u, f):\n        if u == dst or f == 0:\n            return f\n        for i in range(ptr[u], len(adj[u])):\n            e = adj[u][i]\n            v, rev, f_e, cap = e\n            if dis[v] != dis[u] + 1:\n                continue\n            df = dfs(v, min(f, cap - f_e))\n            if df:\n                e[2] += df\n                adj[v][rev][2] -= df\n                return df\n            ptr[u] += 1\n        return 0\n    \n    def mf():\n        flow = 0\n        while bfs():\n            ptr[:] = [0]*MAXN\n            while True:\n                df = dfs(src, INF)\n                if df == 0:\n                    break\n                flow += df\n        return flow\n    \n    print(mf())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-7.986991e-06, 0.0, -1.1920922e-06, -0.0024836191, -0.25356668, -0.00062112586, -1.1920928e-07, -7.5814234e-05, -0.10164169, -0.0034006168, -0.0010738565, -0.014212577, -3.3305247, -0.6882052, -0.82605803, -7.235742e-05, -0.0001236124, -5.245195e-06, -4.1723165e-06, -1.056323, -8.225407e-06, -0.00012611547, -1.9073468e-06, -6.329813e-05, -2.8610189e-06, -0.38690916, -0.048691683, -2.801379e-05, -0.8282759, -8.344647e-07, 0.0, -0.00091141637, -1.1920922e-06, -1.7881378e-06, -0.00043096792, -3.576278e-07, -0.002777768, -1.1920928e-07, -1.1920928e-07, -1.1920928e-07, -2.801379e-05, -2.7536968e-05, -0.0002684233, -6.5086155e-05, -1.1920928e-07, -3.576278e-07, 0.0, -0.0011774519, -1.1920928e-07, -4.3510445e-05, -0.0035023084, -1.1920928e-07, 0.0, 0.0, -0.07889404, -1.1368905, -4.7683704e-07, -0.013479174, -3.0397907e-05, -0.32162684, -0.049318135, -5.4836123e-06, -1.1920928e-07, -0.10021564, -0.00012385078, -1.668916e-05, -2.3841855e-07, -1.1920928e-07, -3.576278e-07, 0.0, -8.344647e-07, -7.569503e-05, -2.8610189e-06, -6.7708585e-05, -1.633154e-05, -0.00027366707, -2.3841574e-05, -6.3180723e-06, -2.8610189e-06, 0.0, -2.264974e-06, 0.0, -2.0265559e-06, -1.1920928e-07, -1.1920928e-07, -2.3841855e-07, 0.0, -9.5367386e-07, -0.018154996, -0.00013612774, -2.264974e-06, -0.726283, -1.6689287e-06, -6.079489e-05, -0.011040079, -0.06282586, -2.7656173e-05, 0.0, 0.0, -1.072883e-06, 0.0, -9.5367386e-07, -1.0132739e-05, -3.564294e-05, -0.011445339, -0.00011181206, -1.6689287e-06, -0.38717774, -1.0967195e-05, -2.503392e-06, -3.576278e-07, 0.0, -3.576278e-07, -3.576278e-07, 0.0, -2.3841855e-07, -0.0005402298, -0.38691732, -0.052798405, -0.00039879474, -0.0009595319, -2.3841574e-05, -0.16031002, -9.1790735e-06,