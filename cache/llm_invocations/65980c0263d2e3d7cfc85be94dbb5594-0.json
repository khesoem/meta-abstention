rn 0;\n    return (i64)factorial[total] * inv_factorial[total - choose] % mod * inv_factorial[choose] % mod;\n}\n\nint main() {\n#ifdef rqgao2014\n    freopen(\"input.txt\", \"r\", stdin);\n#endif\n    scanf(\"%d %d %d\", &n, &k_val, &mod);\n    \n    factorial[0] = inv_factorial[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        factorial[i] = (i64)factorial[i - 1] * i % mod;\n    }\n    \n    inv_factorial[n] = mod_pow(factorial[n], mod - 2, mod);\n    for (int i = n - 1; i >= 1; --i) {\n        inv_factorial[i] = (i64)inv_factorial[i + 1] * (i + 1) % mod;\n    }\n    \n    if (n & 1) {\n        printf(\"%d\\n\", mod_pow(k_val, n, mod));\n        return 0;\n    }\n    \n    int total_ans = 0;\n    dp[0][n] = 1;\n    \n    for (int step = 1; step <= k_val; ++step) {\n        memset(dp[step & 1], 0, sizeof(dp[step & 1]));\n        int current_sum = 0;\n        \n        for (int j = 1; j <= n; ++j) {\n            int prev_val = dp[(step - 1) & 1][j];\n            if (!prev_val) continue;\n            \n            int lower = j & -j;\n            int cleared = j ^ lower;\n            \n            for (int submask = cleared; submask; submask = (submask - 1) & cleared) {\n                add_mod(dp[step & 1][submask], (i64)prev_val * comb(j, submask) % mod);\n            }\n            add_mod(current_sum, prev_val);\n        }\n        \n        add_mod(total_ans, (i64)current_sum * inv_factorial[k_val - step] % mod);\n    }\n    \n    total_ans = (i64)total_ans * factorial[k_val] % mod;\n    total_ans = (mod_pow(k_val, n, mod) - total_ans + mod) % mod;\n    printf(\"%d\\n\", total_ans);\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k_val = int(data[1])\n    mod = int(data[2])\n    \n    MAX_N = 300005\n    \n    factorial = [1] * MAX_N\n    inv_factorial = [1] * MAX_N\n    \n    def mod_pow(base, exp, modulus):\n        result = 1\n        base %= modulus\n        while exp > 0:\n            if exp & 1:\n                result = (result * base) % modulus\n            base = (base * base) % modulus\n            exp >>= 1\n        return result\n    \n    def comb(total, choose):\n        if choose < 0 or choose > total:\n            return 0\n        return (factorial[total] * inv_factorial[total - choose] % mod * inv_factorial[choose] % mod)\n    \n    factorial[0] = 1\n    for i in range(1, n + 1):\n        factorial[i] = (factorial[i - 1] * i) % mod\n    \n    inv_factorial[n] = mod_pow(factorial[n], mod - 2, mod)\n    for i in range(n - 1, 0, -1):\n        inv_factorial[i] = (inv_factorial[i + 1] * (i + 1)) % mod\n    \n    if n & 1:\n        print(mod_pow(k_val, n, mod))\n        return\n    \n    dp = [[0] * MAX_N for _ in range(2)]\n    \n    total_ans = 0\n    dp[0][n] = 1\n    \n    for step in range(1, k_val + 1):\n        current_dp = dp[step & 1]\n        prev_dp = dp[(step - 1) & 1]\n        \n        for j in range(MAX_N):\n            current_dp[j] = 0\n        \n        current_sum = 0\n        \n        for j in range(1, n + 1):\n            prev_val = prev_dp[j]\n            if not prev_val:\n                continue\n            \n            lower = j & -j\n            cleared = j ^ lower\n            \n            submask = cleared\n            while submask:\n                current_dp[submask] = (current_dp[submask] + prev_val * comb(j, submask)) % mod\n                submask = (submask - 1) & cleared\n            \n            current_sum = (current_sum + prev_val) % mod\n        \n        total_ans = (total_ans + current_sum * inv_factorial[k_val - step]) % mod\n    \n    total_ans = (total_ans * factorial[k_val]) % mod\n    total_ans = (mod_pow(k_val, n, mod) - total_ans + mod) % mod\n    print(total_ans)\n\nif __name__ == \"__main_