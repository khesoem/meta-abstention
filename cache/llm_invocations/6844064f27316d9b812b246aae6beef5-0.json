{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n\nconst int MAX_N = 50;\nconst int MAX_M = 50;\nconst int MAX_K = 50;\nconst int MAX_T = MAX_N + MAX_K + 1;\nconst int MAX_NODES = MAX_N * MAX_T + 1;\nconst int MAX_EDGES = MAX_K + (MAX_M * 2 * MAX_K + MAX_N) * (MAX_T - 1);\nconst int INF = 0x3f3f3f3f;\n\nstruct Edge {\n    int u, v, uv, cost, cap;\n};\n\nint edge_cnt;\nint uu[MAX_EDGES], vv[MAX_EDGES], uv[MAX_EDGES], cost[MAX_EDGES], ccost[MAX_EDGES];\nint cc[MAX_EDGES * 2];\n\nstd::vector<int> adj_list[MAX_NODES];\n\nvoid add_edge(int u, int v, int cap, int cos) {\n    int h = edge_cnt++;\n    uu[h] = u; vv[h] = v; uv[h] = u ^ v;\n    cost[h] = cos;\n    cc[h * 2] = cap;\n    cc[h * 2 + 1] = 0;\n    adj_list[u].push_back(h * 2);\n    adj_list[v].push_back(h * 2 + 1);\n}\n\nint pi[MAX_NODES], kk[MAX_NODES], bb[MAX_NODES];\nint pq[1 + MAX_NODES], iq[MAX_NODES], pq_cnt;\n\n#define LT(u, v) (pi[u] < pi[v] || (pi[u] == pi[v] && kk[u] < kk[v]))\n\nint i2(int i) {\n    return (i *= 2) > pq_cnt ? 0 : i < pq_cnt && LT(pq[i + 1], pq[i]) ? i + 1 : i;\n}\n\nvoid pq_up(int u) {\n    int i, j;\n    for (i = iq[u]; (j = i / 2) && LT(u, pq[j]); i = j)\n        pq[iq[pq[j]] = i] = pq[j];\n    pq[iq[u] = i] = u;\n}\n\nvoid pq_dn(int u) {\n    int i, j;\n    for (i = iq[u]; (j = i2(i)) && LT(pq[j], u); i = j)\n        pq[iq[pq[j]] = i] = pq[j];\n    pq[iq[u] = i] = u;\n}\n\nvoid pq_add(int u) {\n    iq[u] = ++pq_cnt;\n    pq_up(u);\n}\n\nint pq_pop() {\n    int u = pq[1], v = pq[pq_cnt--];\n    iq[v] = 1;\n    pq_dn(v);\n    return u;\n}\n\nvoid dijkstra(int s) {\n    memset(pi, 0x3f, sizeof(int) * MAX_NODES);\n    pi[s] = 0;\n    kk[s] = 0;\n    pq_add(s);\n    while (pq_cnt) {\n        int u = pq_pop();\n        int v;\n        for (int he : adj_list[u]) {\n            if (cc[he] == 0) continue;\n            int h = he / 2;\n            int p = pi[u] + ((he & 1) == 0 ? ccost[h] : -ccost[h]);\n            v = u ^ uv[h];\n            if (pi[v] == INF) {\n                pi[v] = p;\n                kk[v] = kk[u] + 1;\n                bb[v] = he;\n                pq_add(v);\n            } else if (pi[v] > p || (pi[v] == p && kk[v] > kk[u] + 1)) {\n                pi[v] = p;\n                kk[v] = kk[u] + 1;\n                bb[v] = he;\n                pq_up(v);\n            }\n        }\n    }\n}\n\nvoid push(int s, int t) {\n    int u, h, he;\n    for (u = t; u != s; u ^= uv[h]) {\n        he = bb[u];\n        h = he / 2;\n        cc[he]--;\n        cc[he ^ 1]++;\n    }\n}\n\nint edmonds_karp(int s, int t) {\n    memcpy(ccost, cost, sizeof(int) * edge_cnt);\n    while (true) {\n        dijkstra(s);\n        if (pi[t] == INF) break;\n        push(s, t);\n        for (int h = 0; h < edge_cnt; h++) {\n            int u = uu[h], v = vv[h];\n            if (pi[u] != INF && pi[v] != INF)\n                ccost[h] += pi[u] - pi[v];\n        }\n    }\n    int total_cost = 0;\n    for (int h = 0; h < edge_cnt; h++)\n        total_cost += cost[h] * cc[h * 2 + 1];\n    return total_cost;\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    std::vector<int> start(k);\n    for (int i = 0; i < k; i++) {\n        scanf(\"%d\", &start[i]);\n        start[i]--;\n    }\n    std::vector<int> base_adj[MAX_N];\n    for (int i = 0; i < m; i++) {\n        int a, b;\n        scanf(\"%d%d\", &a, &b);\n        a--; b--;\n        base_adj[a].push_back(b);\n        base_adj[b].push_back(a);\n    }\n    int t = n + k + 1;\n    int N_total = n * t + 1;\n    edge_cnt = 0;\n    for (int i = 0; i < n; i++) {\n        for (int s = 0; s < t - 1; s++) {\n            int u = i * t + s;\n            for (int j : base_adj[i]) {\n                int v = j * t + s + 1;\n                for (int x = 1; x <= k; x++)\n                    add_edge(u, v, 1, c + (2 * x - 1) * d);\n            }\n        }\n    }\n    for (int i = 0; i < n; i++) {\n        for (int s = 0; s < t - 1; s++) {\n            int u = i * t + s, v = u + 1;\n            add_edge(u, v, k, i == 0 ? 0 : c);\n        }\n    }\n    int source = N_total - 1;\n    for (int h = 0; h < k; h++)\n        add_edge(source, start[h] * t, 1, 0);\n    printf(\"%d\\n\", edmonds_karp(source, 0 * t + t - 1));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    start = [int(next(it)) - 1 for _ in range(k)]\n    base_adj = [[] for _ in range(n)]\n    for _ in range(m):\n        a = int(next(it)) - 1\n        b = int(next(it)) - 1\n        base_adj[a].append(b)\n        base_adj[b].append(a)\n\n    T = n + k + 1\n    N_total = n * T + 1\n    source = N_total - 1\n    sink = 0 * T + T - 1\n\n    # Edge data structures\n    uu = []\n    vv = []\n    uv = []\n    cost = []\n    ccost = []\n    cc = []  # capacity per arc (2 per edge)\n    adj_list = [[] for _ in range(N_total)]\n    edge_cnt = 0\n\n    def add_edge(u, v, cap, cos):\n        nonlocal edge_cnt\n        h = edge_cnt\n        uu.append(u)\n        vv.append(v)\n        uv.append(u ^ v)\n        cost.append(cos)\n        ccost.append(0)  # placeholder, will be copied later\n        cc.append(cap)\n        cc.append(0)\n        adj_list[u].append(h * 2)\n        adj_list[v].append(h * 2 + 1)\n        edge_cnt += 1\n\n    # Build time-expanded graph\n    for i in range(n):\n        for s in range(T - 1):\n            u = i * T + s\n            for j in base_adj[i]:\n                v = j * T + s + 1\n                for x in range(1, k + 1):\n                    add_edge(u, v, 1, c + (2 * x - 1) * d)\n    for i in range(n):\n        for s in range(T - 1):\n            u = i * T + s\n            v = u + 1\n            add_edge(u, v, k, 0 if i == 0 else c)\n    for h in range(k):\n        add_edge(source, start[h] * T, 1, 0)\n\n    # Min-cost max-flow (successive shortest augmenting path with potentials)\n    INF = 10 ** 9\n    pi = [0] * N_total\n    kk = [0] * N_total\n    bb = [0] * N_total\n    pq = [0] * (N_total + 1)\n    iq = [0] * N_total\n    pq_cnt = 0\n\n    def LT(u, v):\n        return pi[u] < pi[v] or (pi[u] == pi[v] and kk[u] < kk[v])\n\n    def i2(i):\n        i2_val = i * 2\n        if i2_val > pq_cnt:\n            return 0\n        if i2_val < pq_cnt and LT(pq[i2_val + 1], pq[i2_val]):\n            return i2_val + 1\n        return i2_val\n\n    def pq_up(u):\n        nonlocal pq_cnt\n        i = iq[u]\n        while True:\n            j = i // 2\n            if j == 0 or not LT(u, pq[j]):\n                break\n            pq[i] = pq[j]\n            iq[pq[j]] = i\n            i = j\n        pq[i] = u\n        iq[u] = i\n\n    def pq_dn(u):\n        nonlocal pq_cnt\n        i = iq[u]\n        while True:\n            j = i2(i)\n            if j == 0 or not LT(pq[j], u):\n                break\n            pq[i] = pq[j]\n            iq[pq[j]] = i\n            i = j\n        pq[i] = u\n        iq[u] = i\n\n    def pq_add(u):\n        nonlocal pq_cnt\n        pq_cnt += 1\n        iq[u] = pq_cnt\n        pq_up(u)\n\n    def pq_pop():\n        nonlocal pq_cnt\n        u = pq[1]\n        v = pq[pq_cnt]\n        pq_cnt -= 1\n        iq[v] = 1\n        pq_dn(v)\n        return u\n\n    def dijkstra(s):\n        nonlocal pq_cnt\n        for i in range(N_total):\n            pi[i] = INF\n        pi[s] = 0\n        kk[s] = 0\n        pq_cnt = 0\n        pq_add(s)\n        while pq_cnt:\n            u = pq_pop()\n            for he in adj_list[u]:\n                if cc[he] == 0:\n                    continue\n                h = he // 2\n                p = pi[u] + (ccost[h] if (he & 1) == 0 else -ccost[h])\n                v = u ^ uv[h]\n                if pi[v] == INF:\n                    pi[v] = p\n                    kk[v] = kk[u] + 1\n                    bb[v] = he\n                    pq_add(v)\n                elif pi[v] > p or (pi[v] == p and kk[v] > kk[u] + 1):\n                    pi[v] = p\n                    kk[v] = kk[u] + 1\n                    bb[v] = he\n                    pq_up(v)\n\n    def push(s, t):\n        u = t\n        while u != s:\n            he = bb[u]\n            h = he // 2\n            cc[he] -= 1\n            cc[he ^ 1] += 1\n            u ^= uv[h]\n\n    def edmonds_karp(s, t):\n        nonlocal ccost\n        ccost = cost[:]  # copy\n        while True:\n            dijkstra(s)\n            if pi[t] == INF:\n                break\n            push(s, t)\n            for h in range(edge_cnt):\n                u = uu[h]\n                v = vv[h]\n                if pi[u] != INF and pi[v] != INF:\n                    ccost[h] += pi[u] - pi[v]\n        total_cost = 0\n        for h in range(edge_cnt):\n            total_cost += cost[h] * cc[h * 2 + 1]\n        return total_cost\n\n    result = edmonds_karp(source, sink)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.7508447652217e-05, -1.1920928244535389e-07, -3.576278118089249e-07, -0.0011197017738595605, -0.08757434040307999, -3.576278118089249e-07, -0.06204794719815254, -0.16029590368270874, -0.3354066014289856, -0.16058935225009918, -7.152531907195225e-06, -0.16955499351024628, -4.0531076592742465e-06, -0.12754400074481964, 0.0, -0.0005267662927508354, -2.3841855067985307e-07, -0.38687247037887573, -7.152555099310121e-07, 0.0, -5.245195097813848e-06, -5.960462772236497e-07, -0.003178308717906475, 0.0, 0.0, -0.0009114163694903255, -3.576278118089249e-07, -2.3841855067985307e-07, -1.9073468138230965e-06, -4.768370445162873e-07, -0.0003846143954433501, -4.768370445162873e-07, -2.3841855067985307e-07, -0.0005550036439672112, -1.4543427823809907e-05, -7.867782187531702e-06, -5.602820692729438e-06, -3.6000557884108275e-05, -2.3841855067985307e-07, 0.0, 0.0, -0.04864490032196045, 0.0, 0.0, -2.074220174108632e-05, 0.0, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, 0.0, -0.00012396997772157192, -0.0005078217945992947, 0.0, 0.0, 0.0, -3.6954811548639555e-06, 0.0, -0.00012396997772157192, -0.004812681116163731, -7.152555099310121e-07, -2.3841855067985307e-07, 0.0, -1.0251946150674485e-05, 0.0, -6.318072337307967e-06, -0.0014705568319186568, 0.0, -5.960462772236497e-07, 0.0, -0.31326305866241455, -0.25193625688552856, -0.002529280725866556, -0.0006193388253450394, -0.04858982563018799, -0.0007320346776396036, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.038097530603408813, -3.099436753473128e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.9802276912960224e-06, -1.0728830375228426e-06, 0.0, -8.344646857949556e-07, -0.10059668123722076, -0.06196851283311844, -0.012543358840048313, -0.00020346954988781363, 0.0, -8.344646857949556e-07, -5.960462772236497e-07, 0.0, -1.1920928244