{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\n#include <utility>\nusing namespace std;\n\ntypedef pair<int,int> pii;\nconst int N = 11;\nconst int INF = 1e9;\nconst int MAXV = 2 * N * N + 5;\n\nstruct Edge {\n    int to, c, f, rev;\n    Edge() {}\n    Edge(int to_, int c_, int f_, int rev_): to(to_), c(c_), f(f_), rev(rev_) {}\n};\n\nstruct Dinic {\n    vector<Edge> g[MAXV];\n    int d[MAXV], ptr[MAXV];\n\n    void addEdge(int v, int u, int cap) {\n        g[v].push_back(Edge(u, cap, 0, 0));\n        g[u].push_back(Edge(v, 0, 0, 0));\n        g[v].back().rev = (int)g[u].size() - 1;\n        g[u].back().rev = (int)g[v].size() - 1;\n    }\n\n    bool buildLevel(int s, int t) {\n        for (int i = 0; i <= t; ++i) d[i] = INF;\n        queue<int> q;\n        d[s] = 0;\n        q.push(s);\n        while (!q.empty()) {\n            int v = q.front(); q.pop();\n            for (size_t i = 0; i < g[v].size(); ++i) {\n                const Edge &e = g[v][i];\n                if (d[e.to] == INF && e.c > e.f) {\n                    d[e.to] = d[v] + 1;\n                    q.push(e.to);\n                }\n            }\n        }\n        return d[t] != INF;\n    }\n\n    int dfs(int v, int t, int curFlow) {\n        if (v == t) return curFlow;\n        for (int &i = ptr[v]; i < (int)g[v].size(); ++i) {\n            Edge &e = g[v][i];\n            int cf = e.c - e.f;\n            if (d[e.to] == d[v] + 1 && cf > 0) {\n                int add = dfs(e.to, t, min(curFlow, cf));\n                if (add) {\n                    e.f += add;\n                    g[e.to][e.rev].f -= add;\n                    return add;\n                }\n            }\n        }\n        return 0;\n    }\n\n    int maxflow(int s, int t) {\n        int flow = 0;\n        while (buildLevel(s, t)) {\n            memset(ptr, 0, sizeof(ptr));\n            int add;\n            while ((add = dfs(s, t, INF)) != 0) flow += add;\n        }\n        return flow;\n    }\n};\n\nint n, tbad;\nchar a[N][N], b[N][N];\nint badDist[N][N], curDist[N][N];\npii bad;\nconst int dx[4] = {-1, 1, 0, 0};\nconst int dy[4] = {0, 0, -1, 1};\n\nbool ok(pii v) {\n    return v.first >= 0 && v.first < n && v.second >= 0 && v.second < n &&\n           a[v.first][v.second] != 'Y' && a[v.first][v.second] != 'Z';\n}\n\nvoid bfsGrid(int sx, int sy, int dist[N][N], bool isBadSource) {\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            dist[i][j] = INF;\n\n    queue<pii> q;\n    dist[sx][sy] = 0;\n    q.push(make_pair(sx, sy));\n\n    while (!q.empty()) {\n        pii v = q.front(); q.pop();\n\n        if (!isBadSource && dist[v.first][v.second] == badDist[v.first][v.second])\n            continue;\n\n        for (int k = 0; k < 4; ++k) {\n            int nx = v.first + dx[k];\n            int ny = v.second + dy[k];\n            pii nv = make_pair(nx, ny);\n            if (ok(nv) && dist[nx][ny] == INF &&\n                dist[v.first][v.second] + 1 <= badDist[nx][ny]) {\n                dist[nx][ny] = dist[v.first][v.second] + 1;\n                q.push(nv);\n            }\n        }\n    }\n}\n\nint main() {\n    cin >> n >> tbad;\n\n    int px = 0, py = 0;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            if (a[i][j] == 'Z') px = i, py = j;\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            cin >> b[i][j];\n\n    bad = make_pair(px, py);\n    bfsGrid(px, py, badDist, true);\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            badDist[i][j] = min(badDist[i][j], tbad);\n\n    Dinic din;\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (a[i][j] != '0') din.addEdge(0, i * n + j + 1, a[i][j] - '0');\n            if (b[i][j] != '0') din.addEdge(i * n + j + 1 + n * n, 2 * n * n + 1, b[i][j] - '0');\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (!ok(make_pair(i, j))) continue;\n            bfsGrid(i, j, curDist, false);\n            for (int i1 = 0; i1 < n; ++i1)\n                for (int j1 = 0; j1 < n; ++j1)\n                    if (ok(make_pair(i1, j1)) && curDist[i1][j1] <= badDist[i1][j1])\n                        din.addEdge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF);\n        }\n\n    cout << din.maxflow(0, 2 * n * n + 1);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Dinic:\n    def __init__(self, n):\n        self.n = n\n        self.graph = [[] for _ in range(n)]\n\n    def add_edge(self, fr, to, cap):\n        forward = [to, cap, 0, None]  # to, cap, flow, rev index\n        backward = [fr, 0, 0, None]\n        forward[3] = len(self.graph[to])\n        backward[3] = len(self.graph[fr])\n        self.graph[fr].append(forward)\n        self.graph[to].append(backward)\n\n    def bfs(self, s, t):\n        level = [INF] * self.n\n        q = deque()\n        level[s] = 0\n        q.append(s)\n        while q:\n            v = q.popleft()\n            for to, cap, flow, rev in self.graph[v]:\n                if level[to] == INF and cap > flow:\n                    level[to] = level[v] + 1\n                    q.append(to)\n        self.level = level\n        return level[t] != INF\n\n    def dfs(self, v, t, f):\n        if v == t:\n            return f\n        for i in range(self.it[v], len(self.graph[v])):\n            self.it[v] = i\n            to, cap, flow, rev = self.graph[v][i]\n            if cap > flow and self.level[v] + 1 == self.level[to]:\n                ret = self.dfs(to, t, min(f, cap - flow))\n                if ret:\n                    self.graph[v][i][2] += ret\n                    self.graph[to][rev][2] -= ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if not f:\n                    break\n                flow += f\n        return flow\n\ndef ok(v, n, a):\n    x, y = v\n    return 0 <= x < n and 0 <= y < n and a[x][y] != 'Y' and a[x][y] != 'Z'\n\ndef bfs_grid(sx, sy, n, a, bad_dist, is_bad_source):\n    dist = [[INF]*n for _ in range(n)]\n    q = deque()\n    dist[sx][sy] = 0\n    q.append((sx, sy))\n    dx = [-1, 1, 0, 0]\n    dy = [0, 0, -1, 1]\n    while q:\n        x, y = q.popleft()\n        if not is_bad_source and dist[x][y] == bad_dist[x][y]:\n            continue\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if ok((nx, ny), n, a) and dist[nx][ny] == INF and dist[x][y] + 1 <= bad_dist[nx][ny]:\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n    return dist\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    tbad = int(next(it))\n    a = [['']*n for _ in range(n)]\n    b = [['']*n for _ in range(n)]\n    px = py = 0\n    for i in range(n):\n        for j in range(n):\n            a[i][j] = next(it)\n            if a[i][j] == 'Z':\n                px, py = i, j\n    for i in range(n):\n        for j in range(n):\n            b[i][j] = next(it)\n\n    bad_dist = bfs_grid(px, py, n, a, None, True)\n    for i in range(n):\n        for j in range(n):\n            bad_dist[i][j] = min(bad_dist[i][j], tbad)\n\n    total_nodes = 2 * n * n + 2\n    din = Dinic(total_nodes)\n    source = 0\n    sink = 2 * n * n + 1\n\n    for i in range(n):\n        for j in range(n):\n            node_a = i * n + j + 1\n            node_b = node_a + n * n\n            if a[i][j] != '0':\n                din.add_edge(source, node_a, int(a[i][j]))\n            if b[i][j] != '0':\n                din.add_edge(node_b, sink, int(b[i][j]))\n\n    for i in range(n):\n        for j in range(n):\n            if not ok((i, j), n, a):\n                continue\n            cur_dist = bfs_grid(i, j, n, a, bad_dist, False)\n            node_a = i * n + j + 1\n            for i1 in range(n):\n                for j1 in range(n):\n                    if ok((i1, j1), n, a) and cur_dist[i1][j1] <= bad_dist[i1][j1]:\n                        node_b = i1 * n + j1 + 1 + n * n\n                        din.add_edge(node_a, node_b, INF)\n\n    print(din.max_flow(source, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -1.9073468138230965e-06, 0.0, -0.00012563870404846966, -0.0010457528987899423, -2.3841855067985307e-07, -2.145764938177308e-06, -0.00027426297310739756, -3.576278118089249e-07, 0.0, -1.7881377516459906e-06, -0.029787791892886162, -0.05617634207010269, -0.00019965562387369573, -0.0002615109842736274, -2.0265373677830212e-05, -0.2519310712814331