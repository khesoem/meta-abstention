g = 1.0 - sum_mask[mask];\n        if (remaining < 1e-6) continue;\n        for (int i = 0; i < n; ++i) {\n            if (mask & (1 << i)) continue;\n            double move_prob = dp[mask] * prob[i] / remaining;\n            dp[mask | (1 << i)] += move_prob;\n        }\n    }\n\n    vector<double> ans(n, 0.0);\n    bool found = false;\n    for (int mask = 0; mask < MAX_MASK; ++mask) {\n        if (popcount(mask) == k && dp[mask] > 1e-100) {\n            found = true;\n            break;\n        }\n    }\n\n    if (!found) {\n        for (int i = 0; i < n; ++i) {\n            ans[i] = (prob[i] < 1e-6) ? 0.0 : 1.0;\n        }\n    } else {\n        for (int mask = 0; mask < MAX_MASK; ++mask) {\n            if (popcount(mask) == k) {\n                for (int i = 0; i < n; ++i) {\n                    if (mask & (1 << i)) {\n                        ans[i] += dp[mask];\n                    }\n                }\n            }\n        }\n    }\n\n    cout << fixed << setprecision(12);\n    for (int i = 0; i < n; ++i) {\n        if (i) cout << \" \";\n        cout << ans[i];\n    }\n    cout << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int k = sc.nextInt();\n        \n        double[] prob = new double[n];\n        for (int i = 0; i < n; ++i) {\n            prob[i] = sc.nextDouble();\n        }\n        \n        final int MAX_MASK = 1 << n;\n        double[] sum_mask = new double[MAX_MASK];\n        for (int mask = 0; mask < MAX_MASK; ++mask) {\n            double s = 0.0;\n            for (int i = 0; i < n; ++i) {\n                if ((mask & (1 << i)) != 0) {\n                    s += prob[i];\n                }\n        