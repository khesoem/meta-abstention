g base, long exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static long[][] matrixExp(long[][] base, long exp) {\n        long[][] res = {{1, 0}, {0, 1}};\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = multiply(res, base);\n            }\n            base = multiply(base, base);\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static long[][] multiply(long[][] A, long[][] B) {\n        long[][] C = new long[2][2];\n        for (int i = 0; i < 2; i++) {\n            for (int j = 0; j < 2; j++) {\n                C[i][j] = 0;\n                for (int k = 0; k < 2; k++) {\n                    C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD;\n                }\n            }\n        }\n        return C;\n    }\n\n    static class FastScanner {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastScanner() {\n            br = new BufferedReader(new InputStreamReader(System.in), 32768);\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        String nextLine() {\n            String str = \"\";\n            try {\n                str = br.readLine();\n            } catch (IOException e) {\n                e