n range(k):\n        x = int(next(it))\n        addedge(0, x, 1, 0)\n    for i in range(100):\n        for _ in range(k):\n            addedge(1 + i * n, 9999, 1, i * c)\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d)\n                addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d)\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            addedge(i + (j - 1) * n, i + j * n, k, 0)\n    cost = minCostMaxflow(0, 9999)\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022146634000819176, -1.1920928244535389e-07, -3.576278118089249e-07, -0.00021717573690693825, -0.002524167764931917, 0.0, -7.390948667307384e-06, -7.593343616463244e-05, 0.0, 0.0, 0.0, -3.218599158572033e-05, -0.4986335039138794, -1.0967194612021558e-05, -3.576278118089249e-07, 0.0, -2.145764938177308e-06, -1.549708758830093e-05, -6.079655122448457e-06, -0.10021822899580002, -1.311301275563892e-06, -4.768370445162873e-07, -3.576278118089249e-07, -9.417489309271332e-06, -1.1920928244535389e-07, -1.823885577323381e-05, -0.00013445904187392443, -1.1920928244535389e-07, 0.0, -1.764281842042692e-05, -0.029008755460381508, 0.0, -1.1920928244535389e-07, -0.00043072958942502737, -7.152555099310121e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -0.02342328056693077, -0.35111066699028015, -0.03743736818432808, -0.0021193204447627068, -0.00021550717065110803, -3.576278118089249e-07, -2.1934269170742482e-05, -0.0052503556944429874, -1.7881377516459906e-06, -0.12697908282279968, -8.344646857949556e-07, -2.0503786799963564e-05, -0.01815206930041313, -0.31336402893066406, -0.06207013130187988, 0.0, -9.536738616588991e-07, 0.0, -3.576278118089249e-07, -3.099436753473128