]  # reverse to get most significant digit first\n    a_len = len(a)\n    \n    # Pad a with a leading 0 to make indexing 1-based (like in C++ code)\n    a = [0] + a  # now a[1..a_len]\n    \n    b = [0] * 15\n    ans = 0\n    \n    def dig(arr, l):\n        re = 0\n        for i in range(1, l + 1):\n            re = re * 10 + arr[i]\n        return re\n    \n    def Rank(arr, l):\n        ans_rank = 0\n        for di in range(1, a_len + 1):\n            for i in range(1, min(l, di) + 1):\n                for j in range((1 if i == 1 else 0), arr[i]):\n                    numl = 0\n                    numr = 0\n                    for p in range(1, i):\n                        numl = numr = numl * 10 + arr[p]\n                    numl = numr = numl * 10 + j\n                    for p in range(i + 1, di + 1):\n                        numl = numl * 10\n                        numr = numr * 10 + 9\n                    numr = min(numr, n)\n                    if numl <= numr:\n                        ans_rank += numr - numl + 1\n            if di <= l:\n                ans_rank += 1\n        return ans_rank\n    \n    def F(arr, di):\n        return ((-dig(arr, di) + Rank(arr, di)) % mo1 + mo1) % mo1\n    \n    dif = [0] * 15\n    q1 = [0] * 1000010\n    q2 = [0] * 1000010\n    \n    def dfs(t, ed, q, v):\n        if t == ed:\n            for i in range(10):\n                q[0] += 1\n                q[q[0]] = (v + i * dif[t]) % mo1\n            return\n        for i in range(10):\n            dfs(t + 1, ed, q, (v + i * dif[t]) % mo1)\n    \n    def update(di, i, j):\n        nonlocal ans\n        # Copy a to b\n        for p in range(1, a_len + 1):\n            b[p] = a[p]\n        b[i] = j\n        for p in range(i + 1, di + 1):\n            b[p] = 0\n        bas = F(b, di)\n        for p in range(i + 1, di + 1):\n            b[p] = 1\n            dif[p] = (F(b, di) + mo1 - bas) % mo1\n            b[p] = 0\n        if di - i == 0:\n            ans = (ans + bas) % mo2\n            return\n        if di - i == 1:\n            for p in range(10):\n                ans = (ans + (bas + p * dif[di]) % mo1) % mo2\n            return\n        mid = (di + i) // 2\n        q1[0] = 0\n        q2[0] = 0\n        dfs(i + 1, mid, q1, bas)\n        dfs(mid + 1, di, q2, 0)\n        # Sort q2[1..q2[0]]\n        sorted_q2 = sorted(q2[1:q2[0] + 1])\n        sq2_sum = 0\n        for idx in range(1, q2[0] + 1):\n            sq2_sum = (sq2_sum + sorted_q2[idx - 1]) % mo2\n        for idx in range(1, q1[0] + 1):\n            val = q1[idx]\n            # Find first position in sorted_q2 where element >= (mo1 - val)\n            target = (mo1 - val) % mo1\n            pos = bisect.bisect_left(sorted_q2, target)\n            count_greater = len(sorted_q2) - pos\n            ans = (ans + sq2_sum + val * len(sorted_q2)) % mo2\n            ans = (ans + count_greater * (mo2 - mo1)) % mo2\n    \n    # Main loop\n    for di in range(1, a_len + 1):\n        for i in range(1, di + 1):\n            l = 1 if i == 1 else 0\n            r = a[i] - 1 if di == a_len else 9\n            for j in range(l, r + 1):\n                if j != a[i]:\n                    update(di, i, j)\n        ans = (ans + F(a, di)) % mo2\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00034517052699811757, -1.5497195136049413e-06, -1.1920922133867862e-06, -0.1515381932258606, -0.024705732241272926, -0.04864569380879402, -0.5819606781005859, -0.07791154086589813, -4.768370445162873e-07, -0.026330985128879547, -0.044929035007953644, 0.0, -5.960462772236497e-07, -2.3841855067985307e-07, 0.0, 0.0, -1.5497195136049413e-06, -5.8412379075889476e-06, -1.6689160474925302e-05, -6.723177648382261e-05, -2.3841855067985307e-07, -1.5139465176616795e-05, -2.7418097943154862e-06, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -9.536738616588991e-07, 0.0, 0.0, 0.0, 