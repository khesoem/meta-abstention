ODULO, memo, fact, inv_fact) * inv_fact[mask - sub] % MODULO\n        memo[level][mask] = (memo[level][mask] + term) % MODULO\n        sub = (sub - 1) & rest\n    \n    term = recursive_solve(level + 1, 0, N, K, MODULO, memo, fact, inv_fact) * inv_fact[mask] % MODULO\n    memo[level][mask] = (memo[level][mask] + term) % MODULO\n    \n    return memo[level][mask]\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n    MODULO = int(data[2])\n    \n    fact, inv_fact = build_tables(N, MODULO)\n    \n    answer = modular_exponentiation(K, N, MODULO)\n    \n    if N % 2 == 0:\n        # Initialize memo with -1\n        memo = [[-1] * (N + 1) for _ in range(27)]\n        result = recursive_solve(0, N, N, K, MODULO, memo, fact, inv_fact)\n        answer = (answer - result + MODULO) % MODULO\n    \n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002337421028641984, -1.311301275563892e-06, -1.4305104514278355e-06, -0.116783507168293, -0.00010871296399272978, -0.004624268040060997, -0.0027882291469722986, -0.13263002038002014, -1.2755313036905136e-05, 0.0, -5.960462772236497e-07, -5.245195097813848e-06, -3.576278118089249e-07, -6.615896563744172e-05, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.1920922133867862e-06, -2.3841855067985307e-07, -1.311301275563892e-06, -1.6689160474925302e-05, -1.311301275563892e-06, -1.7165990357170813e-05, -1.9073468138230965e-06, -5.8412379075889476e-06, -4.768370445162873e-07, -2.9802276912960224e-06, 0.0, -2.0265558760002023e-06, -0.04860345274209976, -0.09250148385763168, -4.0531076592742465e-06, -3.576278118089249e-07, -7.497983460780233e-05, 0.0, 0.0, 0.0, -4.410734163684538e-06, -1.1920928244535389e-07, -0.06995134800672531, -5.483612312673358e-06, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -3.576214658096433e-