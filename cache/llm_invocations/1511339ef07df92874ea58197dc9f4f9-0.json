 (v == t) return pushed;\n\n    for (int &e = ptr[v]; e != -1; e = edges[e].next) {\n        Edge &ed = edges[e];\n        int cf = ed.cap - ed.flow;\n\n        if (d[ed.to] == d[v] + 1 && cf > 0) {\n            int add = dfs(ed.to, t, min(pushed, cf));\n            if (add) {\n                ed.flow += add;\n                edges[e ^ 1].flow -= add;\n                return add;\n            }\n        }\n    }\n    return 0;\n}\n\nint dinic(int s, int t) {\n    int flow = 0;\n    while (levelGraph(s, t)) {\n        for (int i = 0; i <= t; ++i) ptr[i] = head[i];\n        int add;\n        while ((add = dfs(s, t, INF)) > 0) flow += add;\n    }\n    return flow;\n}\n\nint n, tbad;\nchar a[N][N], b[N][N];\nint badDist[N][N], curDist[N][N];\npii bad;\n\nconst int dx[4] = {-1, 1, 0, 0};\nconst int dy[4] = {0, 0, -1, 1};\n\nbool ok(pii v) {\n    return v.first >= 0 && v.first < n && v.second >= 0 && v.second < n &&\n           a[v.first][v.second] != 'Y' && a[v.first][v.second] != 'Z';\n}\n\nvoid bfsGrid(int sx, int sy, int dist[N][N], bool isBadSource) {\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            dist[i][j] = INF;\n\n    queue<pii> q;\n    dist[sx][sy] = 0;\n    q.push(make_pair(sx, sy));\n\n    while (!q.empty()) {\n        pii v = q.front(); q.pop();\n\n        if (!isBadSource && dist[v.first][v.second] == badDist[v.first][v.second])\n            continue;\n\n        for (int k = 0; k < 4; ++k) {\n            int nx = v.first + dx[k];\n            int ny = v.second + dy[k];\n            pii nv = make_pair(nx, ny);\n\n            if (ok(nv) && dist[nx][ny] == INF &&\n                dist[v.first][v.second] + 1 <= badDist[nx][ny]) {\n                dist[nx][ny] = dist[v.first][v.second] + 1;\n                q.push(nv);\n            }\n        }\n    }\n}\n\nint main() {\n    cin >> n >> tbad;\n\n    int px = 0, py = 0;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            if (a[i][j] == 'Z') px = i, py = j;\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            cin >> b[i][j];\n\n    fill(head, head + MAXV, -1);\n\n    bad = make_pair(px, py);\n    bfsGrid(px, py, badDist, true);\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            badDist[i][j] = min(badDist[i][j], tbad);\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (a[i][j] != '0') addEdge(0, i * n + j + 1, a[i][j] - '0');\n            if (b[i][j] != '0') addEdge(i * n + j + 1 + n * n, 2 * n * n + 1, b[i][j] - '0');\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (!ok(make_pair(i, j))) continue;\n            bfsGrid(i, j, curDist, false);\n\n            for (int i1 = 0; i1 < n; ++i1)\n                for (int j1 = 0; j1 < n; ++j1)\n                    if (ok(make_pair(i1, j1)) && curDist[i1][j1] <= badDist[i1][j1])\n                        addEdge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF);\n        }\n\n    cout << dinic(0, 2 * n * n + 1);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\ndef add_edge(graph, u, v, cap):\n    graph[u].append([v, len(graph[v]), cap])\n    graph[v].append([u, len(graph[u]) - 1, 0])\n\ndef bfs(graph, s, t, level):\n    for i in range(len(level)):\n        level[i] = -1\n    q = deque()\n    level[s] = 0\n    q.append(s)\n    while q:\n        v = q.popleft()\n        for to, rev, cap in graph[v]:\n            if cap > 0 and level[to] < 0:\n                level[to] = level[v] + 1\n                q.append(to)\n    return level[t] >= 0\n\ndef dfs(graph, v, t, f, level, it):\n    if v == t:\n        return f\n    for i in range(it[v], len(graph[v])):\n        it[v] = i\n        to, rev, cap = graph[v][i]\n        if cap > 0 and level[v] + 1 == level[to]:\n            ret = dfs(graph, to, t, min(f, cap), level, it)\n            if ret > 0:\n                graph[v][i][2] -= ret\n                graph[to][rev][2] += ret\n                return ret\n    return 0\n\ndef dinic(graph, s, t):\n    flow = 0\n    n = len(graph)\n    level = [-1] * n\n    it = [0] * n\n    while bfs(graph, s, t, level):\n        for i in range(n):\n            it[i] = 0\n        while True:\n            f = dfs(graph, s, t, INF, level, it)\n            if f == 0:\n                break\n            flow += f\n    return flow\n\ndef ok(v, n, a):\n    x, y = v\n    return 0 <= x < n and 0 <= y < n and a[x][y] != 'Y' and a[x][y] != 'Z'\n\ndef bfs_grid(sx, sy, n, a, badDist, is_bad_source):\n    dist = [[INF] * n for _ in range(n)]\n    q = deque()\n    dist[sx][sy] = 0\n    q.append((sx, sy))\n    dx = [-1, 1, 0, 0]\n    dy = [0, 0, -1, 1]\n    while q:\n        x, y = q.popleft()\n        if not is_bad_source and dist[x][y] == badDist[x][y]:\n            continue\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if ok((nx, ny), n, a) and dist[nx][ny] == INF and dist[x][y] + 1 <= badDist[nx][ny]:\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n    return dist\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    tbad = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n\n    # find Z position\n    px = py = 0\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                px, py = i, j\n\n    # compute badDist from Z\n    badDist = [[INF] * n for _ in range(n)]\n    badDist = bfs_grid(px, py, n, a, badDist, True)\n    for i in range(n):\n        for j in range(n):\n            badDist[i][j] = min(badDist[i][j], tbad)\n\n    # build graph\n    total_nodes = 2 * n * n + 2\n    graph = [[] for _ in range(total_nodes)]\n    source = 0\n    sink = 2 * n * n + 1\n\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] != '0':\n                add_edge(graph, source, i * n + j + 1, int(a[i][j]))\n            if b[i][j] != '0':\n                add_edge(graph, i * n + j + 1 + n * n, sink, int(b[i][j]))\n\n    for i in range(n):\n        for j in range(n):\n            if not ok((i, j), n, a):\n                continue\n            curDist = bfs_grid(i, j, n, a, badDist, False)\n            for i1 in range(n):\n                for j1 in range(n):\n                    if ok((i1, j1), n, a) and curDist[i1][j1] <= badDist[i1][j1]:\n                        add_edge(graph, i * n + j + 1, i1 * n + j1 + 1 + n * n, INF)\n\n    print(dinic(graph, source, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, 0.0, 0.0, -0.0004893536097370088, -0.008448218926787376, -0.00014053787162993103, -0.00012778419477399439, -0.00014888131408952177, -5.602820692729438e-06, 0.0, -4.529942543740617e-06, -0.014281327836215496, -0.014452890492975712, -3.933898824470816e-06, -2.7656173188006505e-05, -1.0490362910786644e-05, -0.3132627010345459, -8.344646857949556e-07, -0.6934463381767273, -0.14115476608276367, -0.36701664328575134, -6.282132380874828e-05, -0.010516110807657242, -1.0251946150674485e-05, -0.07549196481704712, -3.576278118089249e-07, 0.0, 0.0, -8.940656698541716e-06, -2.3841830625315197e-06, -4.768370445162873e-07, -0.02923049032688141, -3.576214658096433e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -9.417489309271332e-06, -2.3841855067985307e-07, 0.0, -0.5759969353675842, -1.1920928244535389e-07, -9.536738616588991e-07, -2.264974000354414e-06, -1.1920928244535389e-07, -0.0007103541865944862, 0.0, -5.960462772236497e-07, 0.0, -1.5497195136049413e-06, 0.0, 0.0, 0