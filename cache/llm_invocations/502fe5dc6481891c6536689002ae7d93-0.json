* (j + j - 1));\n                }\n            }\n            // swap x and y\n            int tmp = x; x = y; y = tmp;\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    MCMF.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n        }\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= n; j++) {\n                MCMF.addEdge(get(j, i), get(j, i + 1), INF, 0);\n            }\n            MCMF.addEdge(get(1, i), t, INF, c * (i - 1));\n        }\n        System.out.println(MCMF.solve(s, t));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.6491513785440475e-06, 0.0, 0.0, -5.709961988031864e-05, -7.199982064776123e-05, 0.0, -7.486063259420916e-05, -0.008491363376379013, -0.011620688252151012, 0.0, -0.003053290769457817, -0.011055524460971355, -0.00033885458833537996, -0.009720138274133205, -0.47563832998275757, -1.7881377516459906e-06, -0.13255077600479126, -1.5497195136049413e-06, -0.0002196785935666412, -0.0009160612826235592, -0.0005529781919904053, -1.5497195136049413e-06, -0.0128256194293499, -2.753696753643453e-05, -0.0011707840021699667, -0.00035279724397696555, 0.0, -0.0861998200416565, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0015257871709764004, -7.271740287251305e-06, -0.6108238697052002, -3.576278118089249e-07, -0.038043707609176636, -7.724463648628443e-05, -0.2520235478878021, -0.00012373158824630082, 0.0, -9.536738616588991e-07, -1.1920928244535389e-07, -0.00043501926120370626, -0.6397022604942322, -0.02980850450694561, -0.004086359404027462, 0.0, -2.3841855067985307e-07, -0.5005009770393372, -0.25208359956741333, -9.738924563862383e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -0.0009704885887913406, -1.0132738680113107e-05, -1.4305104514278355e-06, -0.002517271088436246, -0.0027692087460309267, -0.12734144926071167, -2.9682672902708873e-05, 0.