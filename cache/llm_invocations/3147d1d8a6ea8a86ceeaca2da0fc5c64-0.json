ber of bits (increasing)\n        sort(subsets.begin(), subsets.end(), [](int a, int b) {\n            return __builtin_popcount(a) < __builtin_popcount(b);\n        });\n        int maxbits = __builtin_popcount(n);\n        f.assign(maxbits + 2, vector<int>(n + 1, -1));\n        // Initialize base cases: S=0 for all cur\n        for (int cur = 0; cur <= maxbits; ++cur) {\n            int val = fac[n];\n            for (int i = 1; i <= cur; ++i)\n                val = 1LL * val * (k - i + 1) % p;\n            f[cur][0] = val;\n        }\n        // Iterate over subsets in increasing bit count\n        for (int s : subsets) {\n            if (s == 0) continue;\n            int bits = __builtin_popcount(s);\n            for (int cur = 0; cur <= maxbits - bits; ++cur) {\n                int U = s - lowbit(s);\n                int res = 0;\n                for (int T = U; T; T = (T - 1) & U)\n                    res = (res + 1LL * inv[s - T] * f[cur + 1][T]) % p;\n                res = (res + 1LL * inv[s] * f[cur + 1][0]) % p;\n                f[cur][s] = res;\n            }\n        }\n        ans = (ans - f[0][n] + p) % p;\n    }\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef fpow(a, b, p):\n    ans = 1\n    t = a\n    while b:\n        if b & 1:\n            ans = (ans * t) % p\n        t = (t * t) % p\n        b >>= 1\n    return ans\n\ndef lowbit(x):\n    return x & -x\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    \n    ans = 1\n    for _ in range(n):\n        ans = (ans * k) % p\n    \n    if n % 2 == 0:\n        # Precompute factorials and inverse factorials\n        fac = [0] * (n + 1)\n        inv = [0] * (n + 1)\n        fac[0] = 1\n        for i in range(1, n 