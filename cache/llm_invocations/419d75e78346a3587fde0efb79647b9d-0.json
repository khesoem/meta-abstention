self.E[i][1]\n            self.cur[u] = i\n        if flow < flow_in:\n            self.d[u] = -1\n        return flow\n\n    def dinic(self, src, sink):\n        self.src = src\n        self.sink = sink\n        flow = 0\n        while self.bfs():\n            flow += self.dfs(src, self.inf)\n        return flow\n\ndef isdigit(ch):\n    return '1' <= ch <= '9'\n\ndef bfs_f(sx, sy, d, f, n, t, capsule, Z, F):\n    d[sx][sy] = 0\n    q = deque()\n    q.append(sx)\n    q.append(sy)\n    if f and isdigit(capsule[sx][sy]):\n        F.add_edge(sx*n+sy, sx*n+sy+n*n, 10**9)\n    while q:\n        x = q.popleft()\n        y = q.popleft()\n        if d[x][y] == t:\n            break\n        for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n            xx = x + dx\n            yy = y + dy\n            if 0 <= xx < n and 0 <= yy < n and d[xx][yy] == 10**9 and capsule[xx][yy] != 'Y':\n                if Z[xx][yy] > d[x][y] + 1 or (Z[xx][yy] == d[x][y] + 1 and isdigit(capsule[xx][yy])):\n                    d[xx][yy] = d[x][y] + 1\n                    if f and isdigit(capsule[xx][yy]):\n                        F.add_edge(sx*n+sy, xx*n+yy+n*n, 10**9)\n                    if Z[xx][yy] > d[x][y] + 1 or not f:\n                        q.append(xx)\n                        q.append(yy)\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    N = n\n    INF = 10**9\n    field = [['']*N for _ in range(N)]\n    capsule = [['']*N for _ in range(N)]\n    Z = [[INF]*N for _ in range(N)]\n    S = [[INF]*N for _ in range(N)]\n    for i in range(n):\n        row = next(it)\n        for j,ch in enumerate(row):\n            field[i][j] = ch\n            if ch == 'Z':\n                zx, zy = i, j\n    for i in range(n):\n        row = next(it)\n        for j,ch in enumerate(row):\n            capsule[i][j] = ch\n    total_nodes = n*n*2 + 2\n    F = MaxFlow(total_nodes)\n    src = n*n*2\n    sink = src + 1\n    for i in range(n):\n  