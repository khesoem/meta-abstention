nit__(self, v=0):\n        self.x = v % MOD\n        if self.x < 0:\n            self.x += MOD\n    \n    def val(self):\n        return self.x\n    \n    def __add__(self, other):\n        s = self.x + other.x\n        if s >= MOD:\n            s -= MOD\n        return Mint(s)\n    \n    def __sub__(self, other):\n        d = self.x - other.x\n        if d < 0:\n            d += MOD\n        return Mint(d)\n    \n    def __mul__(self, other):\n        return Mint((self.x * other.x) % MOD)\n\ndef mod_pow(base, exp):\n    result = Mint(1)\n    while exp:\n        if exp & 1:\n            result = result * base\n        base = base * base\n        exp >>= 1\n    return result\n\nN_val = 0\npos_counter = 0\nsuffix_count = 0\nsum_table = [Mint() for _ in range(K + 2)]\nsuffix_lists = [[] for _ in range(K + 1)]\n\ndef precompute_dfs(level, num):\n    global pos_counter\n    current_val = ((pos_counter - num) % MOD_ALT + MOD_ALT) % MOD_ALT\n    sum_table[level] = sum_table[level] + Mint(current_val)\n    suffix_lists[level].append(current_val)\n    if level == K:\n        return\n    for digit in range(10):\n        precompute_dfs(level + 1, num * 10 + digit)\n\ndef query_dfs(num):\n    global pos_counter\n    if num >= N_val:\n        return\n    if (num + 1) * BASE <= N_val and num * BASE * 10 >= N_val:\n        power = 1\n        for level in range(K + 1):\n            list_size = len(suffix_lists[level])\n            offset = ((pos_counter - power * num) % MOD_ALT + MOD_ALT) % MOD_ALT\n            comp_val = (MOD_ALT - offset) % MOD_ALT\n            match_count = bisect.bisect_left(suffix_lists[level], comp_val)\n            contribution = Mint(list_size * offset) + sum_table[level] - Mint((list_size - match_count) * MOD_ALT)\n            sum_table[K + 1] = sum_table[K + 1] + contribution\n            power *= 10\n        pos_counter += suffix_count\n        return\n    term = ((pos_counter - num) % MOD_ALT + MOD_ALT) % MOD_ALT\n    sum_table[K + 1] = sum_table[K + 1]