r j in range(1, n + 1):\n            kraw.append((i, j))\n    \n    mod = 10**9 + 7\n    \n    # Compute modular inverse of 100\n    odw = pow(100, mod - 2, mod)\n    \n    # Initialize dp\n    dp = [[0] * 2 for _ in range(1 << 20)]\n    \n    # Process for k = 0 and k = 1\n    for k_val in range(2):\n        for i in range(1 << 18):\n            p = 1\n            xd_list = []\n            for j in range(18):\n                if (1 << j) & i:\n                    pos = j + k_val * 18\n                    p = p * tab[kraw[pos][0]][kraw[pos][1]] % mod * odw % mod\n                    xd_list.append(kraw[pos])\n                else:\n                    pos = j + k_val * 18\n                    p = p * (100 - tab[kraw[pos][0]][kraw[pos][1]]) % mod * odw % mod\n            \n            cur = 0\n            for i_idx in range(len(xd_list)):\n                for j_idx in range(i_idx + 1, len(xd_list)):\n                    if (xd_list[i_idx][0] != xd_list[j_idx][0] and \n                        xd_list[i_idx][1] != xd_list[j_idx][1]):\n                        for k_idx in range(j_idx + 1, len(xd_list)):\n                            if (xd_list[i_idx][0] != xd_list[k_idx][0] and \n                                xd_list[j_idx][0] != xd_list[k_idx][0] and \n                                xd_list[i_idx][1] != xd_list[k_idx][1] and \n                                xd_list[j_idx][1] != xd_list[k_idx][1]):\n                                cur |= maska[(126 if k_val else 0) ^ \n                                            ((1 << xd_list[i_idx][1]) + \n                                             (1 << xd_list[j_idx][1]) + \n                                             (1 << xd_list[k_idx][1]))]\n            \n            dp[cur][k_val] = (dp[cur][k_val] + p) % mod\n    \n    # Prefix sums for dp[][0]\n    for i in range(20):\n        for j in range(1 << 20):\n            if (1 << i) & j:\n                dp[j][0] = (dp[j][0] + dp[j ^ (1 << i)][0]) % mod\n    \n    # Calculate