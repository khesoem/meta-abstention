return Vec.eq(self.x, other.x) and Vec.eq(self.y, other.y)\n    \n    def __hash__(self):\n        return hash((round(self.x, 9), round(self.y, 9)))\n\nclass Circle:\n    def __init__(self, c, r):\n        self.c = c\n        self.r = r\n    \n    def contains(self, v):\n        return self.c.sub(v).mag2() - Vec.EPS * Vec.EPS <= self.r * self.r\n    \n    def intersect(self, o):\n        if self.c == o.c:\n            return None\n        dir_vec = o.c.sub(self.c)\n        d2 = dir_vec.mag2()\n        d = math.sqrt(d2)\n        \n        if self.r + o.r < d or self.r + d < o.r or o.r + d < self.r:\n            return None\n        \n        if Vec.eq(self.r + o.r, d) or Vec.eq(o.r + d, self.r):\n            return [self.c.add(dir_vec.scale(self.r / d))]\n        \n        if Vec.eq(self.r + d, o.r):\n            return [self.c.sub(dir_vec.scale(self.r / d))]\n        \n        d1 = (self.r * self.r + d2 - o.r * o.r) / (2 * d)\n        h = math.sqrt(max(0, self.r * self.r - d1 * d1))\n        unit_dir = dir_vec.unit()\n        r_int = self.c.add(unit_dir.scale(d1).add(unit_dir.rot270().scale(h)))\n        l_int = self.c.add(unit_dir.scale(d1).add(unit_dir.rot90().scale(h)))\n        return [r_int, l_int]\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n = int(input_data[0])\n    circles = []\n    index = 1\n    for i in range(n):\n        x = int(input_data[index])\n        y = int(input_data[index + 1])\n        r = int(input_data[index + 2])\n        index += 3\n        circles.append(Circle(Vec(x, y), r))\n    \n    points = []\n    par = list(range(n))\n    \n    def find(x):\n        if par[x] != x:\n            par[x] = find(par[x])\n        return par[x]\n    \n    def union(a, b):\n        root_a = find(a)\n        root_b = find(b)\n        if root_a != root_b:\n            par[root_a] = root_b\n    \n    res = 1\n    for i in range(n):\n        points2 = []\n        for j in range(n):\n            if i == j:\n                continue\n            arr = circles[i].intersect(circles[j])\n            if arr is None:\n                continue\n            union(i, j)\n            for e in arr:\n                found = False\n                for e2 in points2:\n                    if e == e2:\n                        found = True\n                        break\n                if not found:\n                    points2.append(e)\n        \n        res += len(points2)\n        for e in points2:\n            found = False\n            for e2 in points:\n                if e == e2:\n                    found = True\n                    break\n            if not found:\n                points.append(e)\n    \n    res -= len(points)\n    \n    # Count connected components\n    components = 0\n    for i in range(n):\n        if find(i) == i:\n            components += 1\n    \n    res += components\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010179955279454589, -1.4305104514278355e-06, -3.099436753473128e-06, -6.687417771900073e-05, -0.011288229376077652, -3.4570634852570947e-06, -0.01603599078953266, -0.0004180987598374486, -0.06997935473918915, -0.42871400713920593, -0.2813200056552887, -1.5497195136049413e-06, -0.12825341522693634, -0.03206261992454529, -0.040812570601701736, -0.0005198557628318667, -3.2186455882765586e-06, -3.814689989667386e-06, -9.179073458653875e-06, -3.3378546504536644e-06, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -0.2830652892589569, -1.6689286894688848e-06, -8.344646857949556e-07, -9.65590606938349e-06, -3.3378546504536644e-06, -2.3841855067985307e-07, -3.576272320060525e-06, 0.0, 0.0, -6.854299135738984e-05, -1.1920928244535389e-07, -9.536738616588991e-07, -1.0967194612021558e-05, -7.152555099310121e-07, 0.0, -8.487341256113723e-05, -1.1920922133867862e-06, -2.7418097943154862e-06, 0.0, -4.768370445162873