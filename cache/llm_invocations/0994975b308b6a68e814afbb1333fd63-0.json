hile (e) {\n        if (e & 1) res = 1LL * res * b % MOD;\n        b = 1LL * b * b % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    cin >> n >> k >> MOD;\n    \n    invf[0] = invf[1] = fact[0] = 1;\n    \n    for (int i = 2; i <= n; ++i) {\n        invf[i] = 1LL * (MOD - MOD / i) * invf[MOD % i] % MOD;\n    }\n    \n    for (int i = 1; i <= n; i <<= 1) {\n        for (int j = i >> 1; j < i && j <= n; ++j) {\n            hp[j] = i;\n        }\n    }\n    \n    for (int i = 1; i <= n; ++i) {\n        fact[i] = 1LL * fact[i-1] * i % MOD;\n        invf[i] = 1LL * invf[i-1] * invf[i] % MOD;\n    }\n    \n    result = mpow(k, n);\n    \n    if (n % 2 == 0) {\n        memset(f, 0, sizeof(f));\n        f[0][0] = 1;\n        for (int i = 0; i < 26; ++i) {\n            for (int j = 0; j <= n; ++j) {\n                if (f[i][j] && (j & n) == j) {\n                    for (int nxt = j + hp[j]; nxt <= n; nxt = (nxt + 1) | j) {\n                        if ((nxt & n) == nxt) {\n                            f[i+1][nxt] = (f[i+1][nxt] + 1LL * f[i][j] * invf[nxt - j] % MOD) % MOD;\n                        }\n                    }\n                }\n            }\n        }\n        \n        int sum = 0;\n        for (int i = 1; i <= 26; ++i) {\n            sum = (sum + 1LL * f[i][n] * invf[k - i] % MOD) % MOD;\n        }\n        result = (result - 1LL * sum * fact[n] % MOD * fact[k] % MOD + MOD) % MOD;\n    }\n    \n    cout << result << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <iostream>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int MAXN = 250005;\nint n, k, MOD, result;\nint hp[MAXN], fact[MAXN], invf[MAXN], f[27][MAXN];\n\ninline int mpow(int b, int e) {\n    int res = 1;\n    b %= MOD;\n    while (e) {\n        if (