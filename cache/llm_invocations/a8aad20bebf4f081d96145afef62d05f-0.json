D) x -= MOD;\n        return x;\n    }\n\n    static int sub_mod(int x, int y) {\n        x -= y;\n        if (x < 0) x += MOD;\n        return x;\n    }\n\n    static long mul_mod(int x, int y) {\n        return ((long) x * y) % MOD;\n    }\n\n    static List<List<Integer>> matrix_product(List<List<Integer>> A, List<List<Integer>> B) {\n        int n = K + 1;\n        List<List<Integer>> C = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            List<Integer> row = new ArrayList<>();\n            for (int j = 0; j < n; j++) {\n                row.add(0);\n            }\n            C.add(row);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int k = 0; k < n; k++) {\n                int sum = 0;\n                for (int j = 0; j < n; j++) {\n                    long product = mul_mod(A.get(i).get(j), B.get(j).get(k));\n                    sum = add_mod(sum, (int) product);\n                }\n                C.get(i).set(k, sum);\n            }\n        }\n        return C;\n    }\n\n    static List<List<Integer>> rotate_matrix(List<List<Integer>> M) {\n        int n = K + 1;\n        List<List<Integer>> R = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            List<Integer> row = new ArrayList<>();\n            for (int j = 0; j < n; j++) {\n                row.add(0);\n            }\n            R.add(row);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int ni = i;\n                if (ni < K) ni = (ni + K - 1) % K;\n                int nj = j;\n                if (nj < K) nj = (nj + K - 1) % K;\n                R.get(i).set(j, M.get(ni).get(nj));\n            }\n        }\n        return R;\n    }\n\n    static void setup() {\n        long digits = 0;\n        long temp = N;\n        while (temp > 0) {\n            temp /= K;\n            ++digits;\n        }\n        pre = new ArrayList<>();\n        for (int i = 0; i <= digits; i++) {\n      