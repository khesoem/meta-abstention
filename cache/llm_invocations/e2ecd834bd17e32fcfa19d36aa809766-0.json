t > 0:\n            for i in range(1, n + 1):\n                add_edge(i + (t - 1) * n, i + t * n, INF, c)\n    \n    # Read edges\n    for _ in range(m):\n        a = int(data[idx]); idx += 1\n        b = int(data[idx]); idx += 1\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n    \n    # Min cost max flow using Dijkstra (sparse version)\n    source = 0\n    sink = n * T + 1\n    price = 0\n    flow = 0\n    \n    # Potential initialization\n    pot = [0] * N\n    \n    while True:\n        # Dijkstra's algorithm\n        dist = [INF] * N\n        par = [-1] * N\n        vis = [False] * N\n        dist[source] = 0\n        \n        # Priority queue: (distance, node)\n        heap = [(0, source)]\n        \n        while heap:\n            d, u = heapq.heappop(heap)\n            if vis[u]:\n                continue\n            vis[u] = True\n            \n            for e in adj[u]:\n                v, r, f, c, p = e\n                if f < c and dist[v] > dist[u] + pot[u] - pot[v] + p:\n                    dist[v] = dist[u] + pot[u] - pot[v] + p\n                    par[v] = r\n                    heapq.heappush(heap, (dist[v], v))\n        \n        if dist[sink] >= INF:\n            break\n        \n        # Find minimum flow along the path\n        df = INF\n        u = sink\n        while u != source:\n            r = par[u]\n            e = adj[u][r]\n            prev_node = e[0]\n            # Find the reverse edge index\n            rev_idx = e[1]\n            rev_e = adj[prev_node][rev_idx]\n            df = min(df, rev_e[3] - rev_e[2])\n            u = prev_node\n        \n        # Update flow\n        u = sink\n        while u != source:\n            r = par[u]\n            e = adj[u][r]\n            prev_node = e[0]\n            rev_idx = e[1]\n   