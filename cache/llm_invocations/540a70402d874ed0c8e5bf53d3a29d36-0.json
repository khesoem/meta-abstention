{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define MOD 1000000007LL\nusing namespace std;\nusing ll = long long;\nconst int MAXK = 30;\nconst int MAXLOG = 200;\n\nstruct vec {\n    array<ll, MAXK> a;\n};\nstruct mat {\n    array<array<ll, MAXK>, MAXK> a;\n};\n\nll n, k;\nmat M[MAXK], MI[MAXK];\nmat E[MAXLOG][MAXK], EI[MAXLOG][MAXK];\nvec cur;\n\nll val(ll um) {\n    while (um >= k) {\n        um = (um + um / k) % k;\n    }\n    return um;\n}\n\nmat mult(const mat& m1, const mat& m2) {\n    mat m3;\n    for (int i = 0; i < k; ++i) {\n        for (int j = 0; j < k; ++j) {\n            ll s = 0;\n            for (int l = 0; l < k; ++l) {\n                s = (s + m1.a[i][l] * m2.a[l][j]) % MOD;\n            }\n            m3.a[i][j] = s;\n        }\n    }\n    return m3;\n}\n\nvec mult(const mat& m, const vec& v) {\n    vec v2;\n    for (int i = 0; i < k; ++i) {\n        ll s = 0;\n        for (int j = 0; j < k; ++j) {\n            s = (s + v.a[j] * m.a[i][j]) % MOD;\n        }\n        v2.a[i] = s;\n    }\n    return v2;\n}\n\nvoid pre_comp() {\n    for (int i = 0; i < k; ++i) {\n        E[0][i] = M[i];\n        EI[0][i] = MI[i];\n    }\n    int LOG = 0;\n    ll t = n;\n    while (t > 0) {\n        ++LOG;\n        t /= k;\n    }\n    for (int j = 1; j <= LOG; ++j) {\n        E[j][0] = E[j-1][0];\n        EI[j][0] = EI[j-1][0];\n        for (int l = 1; l < k; ++l) {\n            E[j][0] = mult(E[j-1][l], E[j][0]);\n            EI[j][0] = mult(EI[j][0], EI[j-1][l]);\n        }\n        for (int i = 1; i < k; ++i) {\n            E[j][i] = mult(E[j-1][i-1], mult(E[j][i-1], EI[j-1][i-1]));\n            EI[j][i] = mult(E[j-1][i-1], mult(EI[j][i-1], EI[j-1][i-1]));\n        }\n    }\n}\n\nvec solve(ll n, vec v, int at) {\n    if (n == 0) return v;\n    int w = val(n / k);\n    v = solve(n / k, v, at + 1);\n    for (int i = 0; i < n % k; ++i) {\n        v = mult(E[at][(w + i) % k], v);\n    }\n    return v;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> k;\n    for (int i = 0; i < k; ++i) {\n        cur.a[i] = 1;\n        for (int j = 0; j < k; ++j) {\n            for (int l = 0; l < k; ++l) {\n                if (j == l) {\n                    M[i].a[j][l] = 1;\n                    MI[i].a[j][l] = 1;\n                } else if (j == i) {\n                    M[i].a[j][l] = 1;\n                    MI[i].a[j][l] = -1;\n                } else {\n                    M[i].a[j][l] = 0;\n                    MI[i].a[j][l] = 0;\n                }\n            }\n        }\n    }\n    pre_comp();\n    cur = solve(n, cur, 0);\n    ll tot = 0;\n    for (int i = 0; i < k; ++i) tot += cur.a[i];\n    --tot;\n    tot %= MOD;\n    if (tot < 0) tot += MOD;\n    while (tot % (k - 1) != 0) tot += MOD;\n    cout << tot / (k - 1) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef val(um, k):\n    while um >= k:\n        um = (um + um // k) % k\n    return um\n\ndef mat_mult(m1, m2, k):\n    m3 = [[0]*k for _ in range(k)]\n    for i in range(k):\n        for j in range(k):\n            s = 0\n            for l in range(k):\n                s = (s + m1[i][l] * m2[l][j]) % MOD\n            m3[i][j] = s\n    return m3\n\ndef vec_mult(mat, vec, k):\n    v2 = [0]*k\n    for i in range(k):\n        s = 0\n        for j in range(k):\n            s = (s + vec[j] * mat[i][j]) % MOD\n        v2[i] = s\n    return v2\n\ndef pre_comp(n, k, M, MI):\n    LOG = 0\n    t = n\n    while t > 0:\n        LOG += 1\n        t //= k\n    # E and EI as list of lists of matrices\n    E = [[None]*k for _ in range(LOG+1)]\n    EI = [[None]*k for _ in range(LOG+1)]\n    for i in range(k):\n        E[0][i] = M[i]\n        EI[0][i] = MI[i]\n    for j in range(1, LOG+1):\n        E[j][0] = E[j-1][0]\n        EI[j][0] = EI[j-1][0]\n        for l in range(1, k):\n            E[j][0] = mat_mult(E[j-1][l], E[j][0], k)\n            EI[j][0] = mat_mult(EI[j][0], EI[j-1][l], k)\n        for i in range(1, k):\n            E[j][i] = mat_mult(E[j-1][i-1], mat_mult(E[j][i-1], EI[j-1][i-1], k), k)\n            EI[j][i] = mat_mult(E[j-1][i-1], mat_mult(EI[j][i-1], EI[j-1][i-1], k), k)\n    return E, EI\n\ndef solve(n, k, v, at, E):\n    if n == 0:\n        return v\n    w = val(n // k, k)\n    v = solve(n // k, k, v, at+1, E)\n    for i in range(n % k):\n        v = vec_mult(E[at][(w + i) % k], v, k)\n    return v\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    # Initialize M and MI as lists of matrices\n    M = [[[0]*k for _ in range(k)] for _ in range(k)]\n    MI = [[[0]*k for _ in range(k)] for _ in range(k)]\n    for i in range(k):\n        for j in range(k):\n            for l in range(k):\n                if j == l:\n                    M[i][j][l] = 1\n                    MI[i][j][l] = 1\n                elif j == i:\n                    M[i][j][l] = 1\n                    MI[i][j][l] = -1\n                else:\n                    M[i][j][l] = 0\n                    MI[i][j][l] = 0\n    # Precompute exponentiation matrices\n    E, EI = pre_comp(n, k, M, MI)\n    # Initial vector cur: all ones\n    cur = [1]*k\n    cur = solve(n, k, cur, 0, E)\n    tot = sum(cur) % MOD\n    tot = (tot - 1) % MOD\n    if tot < 0:\n        tot += MOD\n    while tot % (k - 1) != 0:\n        tot += MOD\n    print(tot // (k - 1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.014484379440546036, -5.364403477869928e-06, 0.0, 0.0, -0.0003578022588044405, -0.007367938291281462, -2.3841855067985307e-07, -0.1269555538892746, -0.00026723151677288115, -3.576278118089249e-07, -8.344646857949556e-07, -8.67805938469246e-05, 0.0, 0.0, -3.576278118089249e-07, -0.06215841323137283, -0.0006927236099727452, -0.004121263511478901, -0.0058580380864441395, 0.0, -0.022165067493915558, -3.933898824470816e-06, -0.0001802282058633864, 0.0, -0.003589973319321871, -3.099436753473128e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.6689286894688848e-06, -1.1920928244535389e-07, -4.660974445869215e-05, -1.1920928244535389e-07, -9.894321920000948e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.540453326422721e-05, -1.311301275563892e-06, 0.0, -4.768370445162873e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -3.242440288886428e-05, -3.123234637314454e-05, -9.179073458653875e-06, -2.169585604860913e-05, -4.31528314948082e-05, -0.00010823617776622996, -0.018181100487709045, -0.011051987297832966, -0.0007522851810790598, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -0.011049393564462662, -2.1219027985353023e-05, -0.01106483768671751, -2.3841855067985307e-07, -0.1856699436903, -0.0004316828562878072, -1.1920928244535389e-07, -9.989239333663136e-05, 0.0, -0.2534294128417969, -6.318072337307967e-06, 0.0, 0.0, -7.152555099310121e-07, 0.0, -3.576278118089249e-07, -2.1457649381773