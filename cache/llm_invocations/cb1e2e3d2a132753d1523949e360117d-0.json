0], j = trip[t][1], k = trip[t][2]\n            if check(i, j, k):\n                sta |= (1 << t)\n        updata(Ans, mul(now, p[all ^ sta]))\n        return\n    g[x-3][y] = 1\n    nxt = mul(now, a[x][y])\n    if y == 6:\n        dfs2(nxt, x+1, 1)\n    else:\n        dfs2(nxt, x, y+1)\n    g[x-3][y] = 0\n    nxt = mul(now, dec(1, a[x][y]))\n    if y == 6:\n        dfs2(nxt, x+1, 1)\n    else:\n        dfs2(nxt, x, y+1)\n\ndef main():\n    global n, a, g, p, trip, comp, cnt, all, Ans, inv100\n    n = int(sys.stdin.readline())\n    inv100 = power(100, MOD-2)\n    # initialize a as 7x7 zeros\n    a = [[0]*7 for _ in range(7)]\n    for i in range(1, n+1):\n        line = sys.stdin.readline().split()\n        for j in range(1, n+1):\n            a[i][j] = mul(int(line[j-1]), inv100)\n    for i in range(n+1, 7):\n        a[i][i] = 1\n    # initialize g as 7x7 zeros\n    g = [[0]*7 for _ in range(7)]\n    # generate trips\n    cnt = 0\n    trip = [[0]*3 for _ in range(20)]\n    tripIndex = [[[0]*7 for _ in range(7)] for _ in range(7)]\n    for i in range(1, 7):\n        for j in range(i+1, 7):\n            for k in range(j+1, 7):\n                trip[cnt][0] = i\n                trip[cnt][1] = j\n                trip[cnt][2] = k\n                tripIndex[i][j][k] = cnt\n                cnt += 1\n    # compute comp array\n    comp = [0]*20\n    for t in range(cnt):\n        i = trip[t][0], j = trip[t][1], k = trip[t][2]\n        found = [0]*7\n        found[i] = 1\n        found[j] = 1\n        found[k] = 1\n        compTri = []\n        for a in range(1, 7):\n            if not found[a]:\n            compTri.append(a)\n        comp[t] = 1 << tripIndex[compTri[0]][compTri[1]][compTri[2]]\n    all = (1 << cnt) - 1\n    # initialize p array\n    p = [0]*SZ\n    dfs1(1, 1, 1)\n    # SOS DP\n    for j in range(cnt):\n        for i in range(1 << cnt):\n            if i & (1 << j):\n                updata(p[i], p[i ^ (1 << j)])\n    Ans = 0\n    dfs2(1, 4, 1)\n    Ans = dec