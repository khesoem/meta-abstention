sn]};\n}\npair<int,int>mcmf(int n)\n{\n  int flow=0,cost=0;\n  while(true)\n  {\n    pair<int,int>p=spfa(n);\n    if(!p.first)return {flow,cost};\n    flow+=p.first,cost+=p.second;\n  }\n}\n\nint main()\n{\n  ios_base::sync_with_stdio(0);cin.tie(0);\n  int n,m,k,c,d;cin>>n>>m>>k>>c>>d;\n  for(int i=1;i<=k;i++)\n  {\n    int x;cin>>x;fr[x]++;\n  }\n  for(int i=1;i<=m;i++)\n  {\n    int u,v;cin>>u>>v;\n    gr[u].push_back(v);\n    gr[v].push_back(u);\n  }\n  sr=0,sn=100*n+n+1;\n  for(int tm=0;tm<=99;tm++)\n  {\n    for(int i=1;i<=n;i++)\n    {\n      addEdge(n*tm+i,n*(tm+1)+i,k,0);\n      for(auto x:gr[i])\n      {\n        for(int cp=1;cp<=k;cp++)\n        {\n          addEdge(n*tm+i,n*(tm+1)+x,1,d*(2*cp-1));\n        }\n      }\n    }\n  }\n  for(int i=1;i<=n;i++)\n    if(fr[i])addEdge(sr,i,fr[i],0);\n  for(int tm=0;tm<=100;tm++)\n    addEdge(n*tm+1,sn,k,c*tm);\n  cout<<mcmf(sn).second<<endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int N = 1000000;\n    static int[] fr = new int[N + 2];\n    static int sr, sn;\n    static ArrayList<Integer>[] gr = new ArrayList[N + 2];\n\n    static final int inf = (int) 1e9;\n\n    static class Edge {\n        int a, b, f, c, d;\n        Edge(int a, int b, int f, int c, int d) {\n            this.a = a;\n            this.b = b;\n            this.f = f;\n            this.c = c;\n            this.d = d;\n        }\n    }\n\n    static ArrayList<Edge> ed = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[N + 2];\n\n    static void addEdge(int a, int b, int c, int d) {\n        Edge e = new Edge(a, b, 0, c, d);\n        adj[a].add(ed.size());\n        ed.add(e);\n\n        e = new Edge(b, a, 0, 0, -d);\n        adj[b].add(ed.size());\n        ed.add(e);\n    }\n\n    static int[] dis = new int[N + 2];\n    static int[] inq = new int[N + 2];\n    static int[] mnf = new int[N + 2];\n    static int[] pth = new int[N + 2];\n\n    static class Pair {\n        int first, second;\n        Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    static Pair spfa(int n) {\n        Arrays.fill(dis, inf);\n        Queue<Integer> q = new LinkedList<>();\n        q.add(sr);\n        dis[sr] = 0;\n        inq[sr] = 1;\n        mnf[sr] = inf;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = 0;\n            for (int id : adj[u]) {\n                Edge edge = ed.get(id);\n                int v = edge.b;\n                if (edge.c > edge.f && dis[v] > dis[u] + edge.d) {\n                    dis[v] = dis[u] + edge.d;\n                    pth[v] = id;\n                    mnf[v] = Math.min(mnf[u], edge.c - edge.f);\n                    if (inq[v] == 0) {\n                        q.add(v);\n                        inq[v] = 1;\n                    }\n                }\n            }\n        }\n\n        if (dis[sn] == inf) {\n            return new Pair(0, 0);\n        }\n\n        int v = sn;\n        while (v != sr) {\n            int id = pth[v];\n            ed.get(id).f += mnf[sn];\n            ed.get(id ^ 1).f -= mnf[sn];\n            v = ed.get(id).a;\n        }\n\n        return new Pair(mnf[sn], dis[sn] * mnf[sn]);\n    }\n\n    static Pair mcmf(int n) {\n        int flow = 0, cost = 0;\n        while (true) {\n            Pair p = spfa(n);\n            if (p.first == 0) {\n                return new Pair(flow, cost);\n            }\n            flow += p.first;\n            cost += p.second;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        for (int i = 0; i <= N + 1; i++) {\n            gr[i] = new ArrayList<>();\n            adj[i] = new ArrayList<>();\n        }\n\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        for (int i = 1; i <= k; i++) {\n            int x = sc.nextInt();\n            fr[x]++;\n        }\n\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            gr[u].add(v);\n            gr[v].add(u);\n        }\n\n        sr = 0;\n        sn = 100 * n + n + 1;\n\n        for (int tm = 0; tm <= 99; tm++) {\n            for (int i = 1; i <= n; i++) {\n                addEdge(n * tm + i, n * (tm + 1) + i, k, 0);\n                for (int x : gr[i]) {\n                    for (int cp = 1; cp <= k; cp++) {\n                        addEdge(n * tm + i, n * (tm + 1) + x, 1, d * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            if (fr[i] > 0) {\n                addEdge(sr, i, fr[i], 0);\n            }\n        }\n\n        for (int tm = 0; tm <= 100; tm++) {\n            addEdge(n * tm + 1, sn, k, c * tm);\n        }\n\n        System.out.println(mcmf(sn).second);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013672371278516948, -2.3841830625315197e-06, -3.576278118089249e-07, -0.008780442178249359, -6.5205356804654e-05, -0.06196996942162514, -0.1270378679037094, -1.07287787614041e-05, -2.3841855067985307e-07, -0.00010132275929208845, -0.006716059520840645, -4.529942543740617e-06, -0.0018356868531554937, -0.017169997096061707, -7.152531907195225e-06, -0.00720983138307929, -2.3841855067985307e-07, -0.018150195479393005, 0.0, -0.1269296258687973, -3.576278118089249e-07, -3.576278118089249e-07, -8.34461570775602e-06, -5.960462772236497e-07, -4.291525328881107e-06, -9.035655966727063e-05, -5.006777428206988e-06, -1.4305104514278355e-06, -0.020586160942912102, -0.00010287232726113871, -3.4570634852570947e-06, -2.9802276912960224e-06, -5.960462772236497e-07, -1