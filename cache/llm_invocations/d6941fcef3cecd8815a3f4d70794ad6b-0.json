 1]) % Mod;\n        }\n    }\n\n    for (int i = 1; i <= n; i ++)\n        for (int j = 0; j <= m && j <= i; j ++)\n        {\n            res[i][j] = res[i - 1][j];\n            res2[i][j] = res2[i - 1][j];\n            for (int h = 1; h < j; h ++)\n            {\n                res[i][j] = (res[i][j] + res[i - h - 1][j - h] * 1LL * dp[h] % Mod * C[h][j]) % Mod;\n                res2[i][j] = (res2[i][j] + res2[i - h - 1][j - h] * 1LL * dp[h] % Mod * C[h][j]) % Mod;\n                res2[i][j] = (res2[i][j] + res[i - h - 1][j - h] * 1LL * dp2[h] % Mod * C[h][j]) % Mod;\n            }\n            res[i][j] = (res[i][j] + dp[j]) % Mod;\n            res2[i][j] = (res2[i][j] + dp2[j]) % Mod;\n        }\n    return !printf(\"%d\\n\", res2[n][m]);\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn, m, Mod = map(int, input().split())\n\nN = 577\nC = [[0]*(N) for _ in range(N)]\ndp = [0]*(N)\ndp2 = [0]*(N)\nres = [[0]*(N) for _ in range(N)]\nres2 = [[0]*(N) for _ in range(N)]\n\ndef GetSum(l, r):\n    return ((l + r) * (r - l + 1) // 2) % Mod\n\n# Precompute binomial coefficients\nC[0][0] = 1\nfor i in range(1, N):\n    C[0][i] = 1\n    C[i][i] = 1\n    for j in range(1, i):\n        C[j][i] = (C[j][i-1] + C[j-1][i-1]) % Mod\n\ndp[0] = 1\ndp2[0] = 0\n\nfor length in range(1, n+1):\n    for i in range(1, length+1):\n        sm = GetSum(1, i - 1) + GetSum(1, length - i)\n        cnt = length + 1\n        dp[length] = (dp[length] + dp[i - 1] * cnt % Mod * dp[length - i] * C[i - 1][length - 1]) % Mod\n        dp2[length] = (dp2[length] + sm * dp[i - 1] * dp[length - i] * C[i - 1][length - 1]) % Mod\n        dp2[length] = (dp2[length] + dp2[i - 1] * cnt * dp[length - i] * C[i - 1][length - 1]) % Mod\n        dp2[length] = (dp2[length] + dp2[length - i] * cnt * dp[i - 1] * C[i - 1][length - 1]) % Mod\n\nfor i in range(1, n + 1):\n    for j in range(0, min(m, i) 