{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\ntypedef pair<int,int> ii;\nconst int INF=1e9;\n\nstruct MCF {\n    int n;\n    struct Edge { int to, f, cap, cost, rev; };\n    vector<vector<Edge>> adj;\n    vector<int> prio, curflow, prevedge, prevnode, pot;\n    MCF(int n): n(n), adj(n), prio(n), curflow(n), prevedge(n), prevnode(n), pot(n) {}\n    void addEdge(int s, int t, int cap, int cost) {\n        Edge a{t,0,cap,cost,(int)adj[t].size()};\n        Edge b{s,0,0,-cost,(int)adj[s].size()};\n        adj[s].push_back(a);\n        adj[t].push_back(b);\n    }\n    pair<int,int> minCostFlow(int s, int t) {\n        int flow=0, flowCost=0;\n        while(flow<INF) {\n            priority_queue<ii, vector<ii>, greater<ii>> q;\n            fill(prio.begin(), prio.end(), INT_MAX);\n            prio[s]=0;\n            curflow[s]=INT_MAX;\n            q.push({0,s});\n            while(!q.empty()) {\n                int d=q.top().first, u=q.top().second;\n                q.pop();\n                if(d!=prio[u]) continue;\n                for(int i=0;i<(int)adj[u].size();++i) {\n                    Edge &e=adj[u][i];\n                    if(e.cap<=e.f) continue;\n                    int v=e.to;\n                    int nd=d+e.cost+pot[u]-pot[v];\n                    if(prio[v]>nd) {\n                        prio[v]=nd;\n                        q.push({nd,v});\n                        prevnode[v]=u;\n                        prevedge[v]=i;\n                        curflow[v]=min(curflow[u], e.cap-e.f);\n                    }\n                }\n            }\n            if(prio[t]==INT_MAX) break;\n            for(int i=0;i<n;++i) pot[i]+=prio[i];\n            int df=min(curflow[t], INF-flow);\n            flow+=df;\n            for(int v=t; v!=s; v=prevnode[v]) {\n                Edge &e=adj[prevnode[v]][prevedge[v]];\n                e.f+=df;\n                adj[v][e.rev].f-=df;\n                flowCost+=df*e.cost;\n            }\n        }\n        return {flow, flowCost};\n    }\n};\n\nint main(){\n    int n,m,k,c,d;\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    MCF nt(6+107*n);\n    for(int _=0;_<k;++_) {\n        int x; scanf(\"%d\",&x); --x;\n        nt.addEdge(0,1+x,1,0);\n    }\n    for(int _=0;_<m;++_) {\n        int x,y; scanf(\"%d%d\",&x,&y); --x; --y;\n        for(int i=0;i<105;++i) {\n            for(int j=0;j<51;++j) {\n                nt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n                nt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n            }\n        }\n    }\n    for(int i=0;i<105;++i)\n        for(int j=0;j<n;++j)\n            nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n    for(int i=0;i<105;++i)\n        nt.addEdge(1+i*n,1+105*n,51,0);\n    auto ans=nt.minCostFlow(0,1+105*n);\n    printf(\"%d\\n\",ans.second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.prio = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n\n    def addEdge(self, s, t, cap, cost):\n        # Edge: [to, f, cap, cost, rev]\n        a = [t, 0, cap, cost, len(self.adj[t])]\n        b = [s, 0, 0, -cost, len(self.adj[s])]\n        self.adj[s].append(a)\n        self.adj[t].append(b)\n\n    def minCostFlow(self, s, t):\n        INF = 10**9\n        flow = 0\n        flowCost = 0\n        while flow < INF:\n            pq = []\n            self.prio = [10**18] * self.n\n            self.prio[s] = 0\n            self.curflow[s] = 10**18\n            heapq.heappush(pq, (0, s))\n            while pq:\n                d, u = heapq.heappop(pq)\n                if d != self.prio[u]:\n                    continue\n                for i, e in enumerate(self.adj[u]):\n                    if e[2] <= e[1]:  # cap <= f\n                        continue\n                    v = e[0]\n                    nd = d + e[3] + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nd:\n                        self.prio[v] = nd\n                        heapq.heappush(pq, (nd, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e[2] - e[1])\n            if self.prio[t] == 10**18:\n                break\n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            v = t\n            while v != s:\n                u = self.prevnode[v]\n                e = self.adj[u][self.prevedge[v]]\n                e[1] += df\n                rev = self.adj[v][e[4]]\n                rev[1] -= df\n                flowCost += df * e[3]\n                v = u\n        return flow, flowCost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data: