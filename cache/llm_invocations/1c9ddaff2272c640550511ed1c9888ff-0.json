om\nfrom collections import defaultdict\n\nclass DStress2:\n    def solve(self):\n        n = self.in_.nextInt()\n        s = self.in_.nextToken()\n        print(self.solve_char_array(list(s)))\n\n    def stress(self):\n        rng = random.Random(123)\n        for IT in range(10000):\n            n = 1 + rng.randint(0, 11)\n            c = []\n            for i in range(n):\n                c.append(\"AVK\"[rng.randint(0, 2)])\n            \n            ans1 = self.solve_char_array(c)\n            ans2 = self.stupid(c)\n            if ans1 != ans2:\n                print(f\"{IT} {ans1} {ans2} {''.join(c)}\", file=sys.stderr)\n                break\n\n    INF = float('inf')\n\n    def stupid(self, s):\n        st = ''.join(s)\n        q = queue.Queue()\n        dist = {}\n        q.put(st)\n        dist[st] = 0\n        while not q.empty():\n            st = q.get()\n            cur = dist[st]\n            if \"VK\" not in st:\n                return cur\n            \n            for pos in range(len(st) - 1):\n                next_str = st[:pos] + st[pos+1] + st[pos] + st[pos+2:]\n                if next_str not in dist:\n                    dist[next_str] = cur + 1\n                    q.put(next_str)\n        return 0\n\n    def solve_char_array(self, s):\n        vPos = []\n        kPos = []\n        otherPos = []\n        \n        for i in range(len(s)):\n            if s[i] == 'V':\n                vPos.append(i)\n            elif s[i] == 'K':\n                kPos.append(i)\n            else:\n                otherPos.append(i)\n        \n        # Initialize dp array with INF\n        dp = [[[[self.INF for _ in range(len(otherPos) + 2)] for _ in range(len(kPos) + 2)] for _ in range(len(vPos) + 2)] for _ in range(2)]\n        dp[0][0][0][0] = 0\n        \n        for V in range(len(vPos) + 1):\n            for K in range(len(kPos) + 1):\n                for O in range(len(otherPos) + 1):\n                    for last in range(2):\n                        cur = dp[last][V][K][O]\n                        if cur == self.INF:\n                            continue\n                        if V < len(vPos):\n                            costV = 0\n                            for idx in range(len(kPos)):\n                                if kPos[idx] < vPos[V]:\n                                    costV += 1\n                            for idx in range(len(otherPos)):\n                                if otherPos[idx] < vPos[V]:\n                                    costV += 1\n                            dp[1][V+1][K][O] = min(dp[1][V+1][K][O], cur + costV)\n                        if K < len(kPos) and last == 0:\n                            costK = 0\n                            for idx in range(len(vPos)):\n                                if vPos[idx] < kPos[K]:\n                                    costK += 1\n                            for idx in range(len(otherPos)):\n                                if otherPos[idx] < kPos[K]:\n                                    costK += 1\n                            dp[0][V][K+1][O] = min(dp[0][V][K+1][O], cur + costK)\n                        if O < len(otherPos):\n                            costO = 0\n                            for idx in range(len(vPos)):\n                                if vPos[idx] < otherPos[O]:\n                                    costO += 1\n                            for idx in range(len(kPos)):\n                                if kPos[idx] < otherPos[O]:\n                                    costO += 1\n                            dp[0][V][K][O+1] = min(dp[0][V][K][O+1], cur + costO)\n        \n        return min(dp[0][len(vPos)][len(kPos)][len(otherPos)], dp[1][len(vPos)][len(kPos)][len(otherPos)])\n\n    class FastScanner:\n        def __init__(self):\n            self.br = sys.stdin\n            self.st = []\n\n        def nextToken(self):\n            while not self.st:\n                line = self.br.readline()\n                if not line:\n                    return None\n                self.st = line.strip().split()\n            return self.st.pop(0)\n\n        def nextInt(self):\n            return int(self.nextToken())\n\n        def nextLong(self):\n            return int(self.nextToken())\n\n        def nextDouble(self):\n            return float(self.nextToken())\n\n    def run(self):\n        self.in_ = self.FastScanner()\n        self.solve()\n        sys.stdout.close()\n\nif __name__ == \"__main__\":\n    DStress2().run()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00010024998482549563, -5.960462772236497e-07, -2.3841855067985307e-07, -0.00014697425649501383, -0.0029658162966370583, -2.9802276912960224e-06, -0.6931582689285278, -0.6283128261566162, -0.006729913409799337, -0.3132648766040802, -0.008849331177771091, -0.4742872714996338, -0.1602393388748169, -0.011847606860101223, -1.1920928244535389e-07, -0.38693344593048096, -0.07716548442840576, -0.13108712434768677, -0.6330724358558655, -1.1920858014491387e-05, -2.50339189733495e-06, -0.00029690624796785414, -0.005935305263847113, -0.003181754844263196, -0.0009267802815884352, -0.6326878070831299, -0.029589328914880753, -0.00141258561052382, -3.933898824470816e-06, -0.003225721186026931, -3.576278118089249e-07, -0.5232712626457214, -0.0007826602668501437, -1.314743995666504, -0.00978908035904169, -1.4305012882687151e-05, -6.198863957251888e-06, -1.6927575416048057e-05, -7.152555099310121e-07, -5.8412379075889476e-06, -1.0728830375228426e-06, -3.4570634852570947e-06, -0.00035661060246638954, -0.00012957210128661245, -1.1324817933200393e-05, -1.1920928244535389e-07, -0.0662996768951416, -2.3603161025675945e-05, -2.992108420585282e-05, -1.02195143699646, -0.09153389930725098, -0.01817712001502514, -7.152555099310121e-07, -0.31330111622810364, -6.9141146923357155e-06, -5.602820692729438e-06, -0.00013481661153491586, -1.5258672647178173e-05, -8.583032467868179e-06, -4.768370445162873e-07, -0.001760719926096499, -1.192092