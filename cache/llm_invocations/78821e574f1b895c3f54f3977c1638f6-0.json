{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <limits>\n\nusing namespace std;\nusing ll = long long;\n\nstruct Edge {\n    int to;\n    ll cap;\n    ll cost;\n    int rev;\n};\n\nclass MinCostFlowSolver {\n    vector<vector<Edge>> graph;\n    int node_count;\n\npublic:\n    MinCostFlowSolver(int n) : node_count(n), graph(n) {}\n\n    void add_edge(int from, int to, ll capacity, ll weight) {\n        graph[from].emplace_back(Edge{to, capacity, weight, (int)graph[to].size()});\n        graph[to].emplace_back(Edge{from, 0, -weight, (int)graph[from].size() - 1});\n    }\n\n    ll compute(int source, int sink, ll required_flow) {\n        vector<ll> distance(node_count, numeric_limits<ll>::max());\n        vector<ll> potential(node_count, 0);\n        vector<int> previous_node(node_count);\n        vector<int> previous_edge_index(node_count);\n\n        ll total_cost = 0;\n\n        while (required_flow > 0) {\n            fill(distance.begin(), distance.end(), numeric_limits<ll>::max());\n            priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n            distance[source] = 0;\n            pq.emplace(0, source);\n\n            while (!pq.empty()) {\n                auto [d, u] = pq.top();\n                pq.pop();\n                if (d != distance[u]) continue;\n                for (int idx = 0; idx < graph[u].size(); ++idx) {\n                    auto& e = graph[u][idx];\n                    if (e.cap > 0 && distance[e.to] > distance[u] + e.cost + potential[u] - potential[e.to]) {\n                        distance[e.to] = distance[u] + e.cost + potential[u] - potential[e.to];\n                        previous_node[e.to] = u;\n                        previous_edge_index[e.to] = idx;\n                        pq.emplace(distance[e.to], e.to);\n                    }\n                }\n            }\n\n            if (distance[sink] == numeric_limits<ll>::max()) return -1;\n            for (int i = 0; i < node_count; ++i) {\n                potential[i] += distance[i];\n            }\n\n            ll flow = required_flow;\n            for (int v = sink; v != source; v = previous_node[v]) {\n                flow = min(flow, graph[previous_node[v]][previous_edge_index[v]].cap);\n            }\n\n            required_flow -= flow;\n            total_cost += flow * potential[sink];\n\n            for (int v = sink; v != source; v = previous_node[v]) {\n                auto& e = graph[previous_node[v]][previous_edge_index[v]];\n                e.cap -= flow;\n                graph[v][e.rev].cap += flow;\n            }\n        }\n        return total_cost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    ll N, M, K, C, D;\n    cin >> N >> M >> K >> C >> D;\n\n    vector<int> A(K);\n    for (int i = 0; i < K; ++i) {\n        cin >> A[i];\n        --A[i];\n    }\n\n    vector<int> U(M), V(M);\n    for (int i = 0; i < M; ++i) {\n        cin >> U[i] >> V[i];\n        --U[i];\n        --V[i];\n    }\n\n    MinCostFlowSolver mcf(N * 101 + 2);\