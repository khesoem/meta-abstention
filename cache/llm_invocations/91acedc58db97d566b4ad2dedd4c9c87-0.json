erate all permutations of waysToLose\n        List<int[][]> allPermutations = new ArrayList<>();\n        permute(waysToLose, 0, allPermutations);\n        \n        int maxLost = 0;\n        \n        for (int[][] permutation : allPermutations) {\n            int[] losts = new int[3];\n            int[] inputACopy = Arrays.copyOf(inputA, 3);\n            int[] inputBCopy = Arrays.copyOf(inputB, 3);\n            \n            for (int[] wayToLose : permutation) {\n                int lost_add = Math.min(inputACopy[wayToLose[0]], inputBCopy[wayToLose[1]]);\n                inputACopy[wayToLose[0]] -= lost_add;\n                inputBCopy[wayToLose[1]] -= lost_add;\n                losts[wayToLose[0]] += lost_add;\n            }\n            \n            int lostSum = losts[0] + losts[1] + losts[2];\n            \n            if (lostSum > maxLost) {\n                maxLost = lostSum;\n            }\n        }\n        \n        return maxLost;\n    }\n    \n    private static void permute(int[][] arr, int k, List<int[][]> result) {\n        for (int i = k; i < arr.length; i++) {\n            int[][] temp = new int[arr.length][2];\n            for (int j = 0; j < arr.length; j++) {\n                temp[j][0] = arr[j][0];\n                temp[j][1] = arr[j][1];\n            }\n            \n            // Swap\n            int[] tempSwap = temp[k];\n            temp[k] = temp[i];\n            temp[i] = tempSwap;\n            \n            if (k == arr.length - 1) {\n                result.add(temp);\n            } else {\n                permute(temp, k + 1, result);\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.929640509653836e-05, -1.311301275563892e-06, -3.576278118089249e-07, -1.883488948806189e-05, -1.5735502529423684e-05, -0.08894174546003342, -0.2820884883403778, -1.6927575416048057e-05, -1.1920922133867862e-06, -4.756337511935271e-05, -0.14267684519290924, -0.004082916304469109, -8.6184605