 for j in range(n):\n            if p[i][j]:\n                add_edge(S, p[i][j], int(ma[i][j]))\n            if s[i][j]:\n                add_edge(s[i][j], T, int(mb[i][j]))\n\n    # BFS for distances\n    def bfs_from(x0, y0, flag):\n        # returns dis matrix (2D list) for distances from (x0,y0)\n        # if flag, also add edges from source node at (x0,y0) to sink nodes\n        dis = [[INF]*n for _ in range(n)]\n        dq = deque()\n        dq.append((x0, y0))\n        dis[x0][y0] = 0\n        id_node = p[x0][y0] if flag else -1  # not used when flag=False\n        while dq:\n            x, y = dq.popleft()\n            d = dis[x][y]\n            if flag and s[x][y] != 0 and d <= tt and d <= dep[x][y]:\n                add_edge(id_node, s[x][y], INF)\n            if d > tt or (flag and d >= dep[x][y]):\n                continue\n            for dx, dy in dirs:\n                nx, ny = x + dx, y + dy\n                if 0 <= nx < n and 0 <= ny < n and ma[nx][ny].isdigit() and dis[nx][ny] == INF:\n                    dis[nx][ny] = d + 1\n                    dq.append((nx, ny))\n        return dis\n\n    # First BFS from all 'Z' cells to compute dep (distance to nearest Z)\n    dep = [[INF]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            if ma[i][j] == 'Z':\n                dis = bfs_from(i, j, False)\n                # update dep to min of current dep and dis\n                for ii in range(n):\n                    for jj in range(n):\n                        if dis[ii][jj] < dep[ii][jj]:\n                            dep[ii][jj] = dis[ii][jj]\n\n    # Now BFS from each source node (ma digit) to add edges\n    for i in range(n):\n        for j in range(n):\n            if p[i][j]:\n                bfs_from(i, j, True)\n\n    # Dinic max flow\n    level = [0]*node_count\n    it_edges = [0]*node_count\n\n    def bfs_level():\n        for i in range(node_count):\n            level[i] = -1\n        dq = deque()\n        level[S] = 0\n        dq.append(S)\n        while dq:\n            u = dq.popleft()\n            for v, cap, rev in graph[u]:\n                if cap > 0 and level[v] == -1:\n                    level[v] = level[u] + 1\n                    dq.append(v)\n        return level[T] != -1\n\n    def dfs(u, flow):\n        if u == T:\n            return flow\n        for i in range(it_edges[u], len(graph[u])):\n            it_edges[u] = i\n            v, cap, rev = graph[u][i]\n            if cap > 0 and level[v] == level[u] + 1:\n                pushed = dfs(v, min(flow, cap))\n                if pushed:\n                    graph[u][i][1] -= pushed\n                    graph[v][rev][1] += pushed\n                    return pushed\n        return 0\n\n    flow = 0\n    while bfs_level():\n        it_edges = [0]*node_count\n        while True:\n            pushed = dfs(S, INF)\n            if not pushed:\n                break\n            flow += pushed\n\n    print(flow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0003405229654163122, -0.0008756855386309326, -5.960462772236497e-07, -2.407998726994265e-05, -6.317892984952778e-05, 0.0, 0.0, -2.3841855067985307e-07, -0.00016556799528189003, -0.8602955341339111, -1.4305012882687151e-05, -8.344646857949556e-07, -1.811964830267243e-05, -0.10020798444747925, -1.0371154530730564e-05, -0.31569814682006836, -0.0033279056660830975, 0.0, -1.1920928244535389e-07, -0.00012146688823122531, -1.7881377516459906e-06, 0.0, 0.0, -0.47408032417297363, -0.25192978978157043, -1.0728830375228426e-06, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -3.2186455882765586e-06, -3.576278118089249e-07, -1.1920928244535389e-07, -0.001328420010395348, -0.08578436821699142, -0.6391698718070984, -0.023264780640602112, -1.5497195136049413e-06, -0.6233605146408081, -1.9192511899746023e-05, -0.00044371772673912346, 0.