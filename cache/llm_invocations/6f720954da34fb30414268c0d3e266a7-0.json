         \n            int val = 0;\n            while (next != -1 && !isSpace(next))\n            {\n                val = val * 10 + (next - '0');\n                next = read();\n            }\n            return val * sign;\n        }\n    }\n    \n    public static void main(String[] args) throws IOException\n    {\n        FastReader fr = new FastReader(System.in);\n        int n = fr.nextInt();\n        int b = fr.nextInt();\n        \n        int[] a = new int[n];\n        for (int i = 0; i < n; i++)\n        {\n            a[i] = fr.nextInt();\n        }\n        \n        int[] odd = new int[n + 1];\n        int[] even = new int[n + 1];\n        \n        for (int i = 1; i <= n; i++)\n        {\n            if ((a[i - 1] & 1) == 1)\n            {\n                odd[i] = odd[i - 1] + 1;\n                even[i] = even[i - 1];\n            }\n            else\n            {\n                odd[i] = odd[i - 1];\n                even[i] = even[i - 1] + 1;\n            }\n        }\n        \n        List<Integer> costs = new ArrayList<Integer>();\n        int prev = 0;\n        \n        for (int i = 1; i < n; i++)\n        {\n            if (odd[i] - odd[prev] == even[i] - even[prev])\n            {\n                costs.add(Math.abs(a[i] - a[i - 1]));\n                prev = i;\n            }\n        }\n        \n        Collections.sort(costs);\n        int total = 0;\n        int ans = 0;\n        \n        for (int c : costs)\n        {\n            if (total + c > b) break;\n            total += c;\n            ans++;\n        }\n        \n        System.out.println(ans);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <cstdio>\n#include <vector>\n#include <algorithm>\n#include <cstdlib>\n\nusing namespace std;\n\nint readInt() {\n    int c = getchar();\n    while (c == ' ' || c == '\\n' || c