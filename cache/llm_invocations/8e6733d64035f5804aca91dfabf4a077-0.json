 n2 = n * n\n    total = n2 * 2 + 2\n    din = Dinic(total, 0, total - 1)\n\n    # pos array: 1-indexed\n    global pos\n    pos = [[0]*n for _ in range(n)]\n    cnt = 1\n    for i in range(n):\n        for j in range(n):\n            pos[i][j] = cnt\n            cnt += 1\n\n    sc = [list(next(it)) for _ in range(n)]\n    caps = [list(next(it)) for _ in range(n)]\n\n    zi = zj = 0\n    for i in range(n):\n        for j in range(n):\n            if sc[i][j] == 'Z':\n                zi, zj = i, j\n\n    global tempo, alc\n    tempo = [[-1]*n for _ in range(n)]\n    dfsTempo(zi, zj, sc, n, 0)\n\n    for i in range(n):\n        for j in range(n):\n            if tempo[i][j] == -1 and sc[i][j].isdigit():\n                tempo[i][j] = t\n\n    for i in range(n):\n        for j in range(n):\n            if sc[i][j].isdigit():\n                lim = int(sc[i][j])\n                din.add(0, pos[i][j], lim)\n                alc = [[-1]*n for _ in range(n)]\n                dfsAlc(i, j, sc, n, 0)\n                for k in range(n):\n                    for l in range(n):\n                        if (alc[k][l] != -1 and tempo[k][l] != -1 and\n                            alc[k][l] <= tempo[k][l] and alc[k][l] <= t):\n                            ok = True\n                            if alc[k][l] == tempo[k][l]:\n                                ok = False\n                                if k+1 < n and alc[k+1][l] != -1 and alc[k+1][l] < tempo[k+1][l]:\n                                    ok = True\n                                if k-1 >= 0 and alc[k-1][l] != -1 and alc[k-1][l] < tempo[k-1][l]:\n                                    ok = True\n                                if l+1 < n and alc[k][l+1] != -1 and alc[k][l+1] < tempo[k][l+1]:\n                                    ok = True\n                                if l-1 >= 0 and alc[k][l-1] != -1 and alc[k][l-1] < tempo[k][l-1]:\n                                    ok = True\n                            if ok:\n         