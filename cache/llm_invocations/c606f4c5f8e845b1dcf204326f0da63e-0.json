urn 0;\n        return fact[a] * invFact[b] % mod * invFact[a - b] % mod;\n    };\n\n    vector<int> cnt(n + 1), mx(n + 1);\n    for (int i = 1; i <= n; ++i) {\n        cnt[i] = __builtin_popcount(i);\n        mx[i] = 1 << (31 - __builtin_clz(i));\n    }\n\n    vector<vector<long long>> dp(n + 1, vector<long long>(20, 0));\n    dp[0][0] = 1;\n\n    for (int i = 1; i <= n; ++i) {\n        if ((n & i) != i) continue;\n        int pivot = mx[i];\n        int rest = i ^ pivot;\n        for (int k = rest; ; k = (k - 1) & rest) {\n            int cur1 = k + pivot;\n            int cur2 = i ^ cur1;\n            int maxJ = min(K - 1, cnt[cur2]);\n            long long comb = C(i, cur1);\n            for (int j = 0; j <= maxJ; ++j) {\n                dp[i][j + 1] = (dp[i][j + 1] + dp[cur2][j] * comb) % mod;\n            }\n            if (k == 0) break;\n        }\n    }\n\n    long long ans = 0;\n    int maxJ = min(cnt[n], K);\n    for (int j = 1; j <= maxJ; ++j) {\n        ans = (ans + dp[n][j] * C(K, j) % mod * fact[j]) % mod;\n    }\n    long long total = modPow(K % mod, n);\n    ans = (total - ans + mod) % mod;\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    input = sys.stdin.readline\n    n, K, mod = map(int, input().split())\n    \n    if n % 2 == 1:\n        res = 1\n        base = K % mod\n        exp = n\n        while exp:\n            if exp & 1:\n                res = (res * base) % mod\n            base = (base * base) % mod\n            exp >>= 1\n        print(res)\n        return\n    \n    fact = [1] * (n + 1)\n    invFact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i - 1] * i % mod\n    \n    def modPow(base, exp):\n        res = 1\n        while exp:\n            if exp & 1:\n                res = (res * base) % mod\n            base = (base