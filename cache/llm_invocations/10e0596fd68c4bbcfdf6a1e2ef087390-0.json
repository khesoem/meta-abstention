.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nfrom decimal import Decimal, getcontext\nfrom functools import cmp_to_key\n\ndef go(n):\n    if n == 0:\n        return 0\n    k = 1\n    cnt = 1\n    while k * 10 + 1 < n:\n        k = k * 10 + 1\n        cnt += 1\n    return min(go(n % k) + n // k * cnt, go((k * 10 + 1 - n) % k) + (cnt + 1) + (k * 10 + 1 - n) // k * cnt)\n\ndef solve():\n    n = int(sys.stdin.readline())\n    print(go(n))\n\nif __name__ == \"__main__\":\n    solve()\n\nclass SegmentTree:\n    def __init__(self):\n        self.maxn = 100010\n        self.st = [0] * (4 * self.maxn)\n\n    def update(self, node, i, L, R, val):\n        if i < L or i > R:\n            return\n        if L == R:\n            self.st[node] += val\n            return\n        mid = (L + R) >> 1\n        self.update(node << 1, i, L, mid, val)\n        self.update((node << 1) + 1, i, mid + 1, R, val)\n        self.st[node] = self.st[node << 1] + self.st[(node << 1) + 1]\n\n    def query(self, node, l, r, L, R):\n        if l > R or r < L:\n            return 0\n        if l <= L and r >= R:\n            return self.st[node]\n        mid = (L + R) >> 1\n        return self.query(node << 1, l, r, L, mid) + self.query((node << 1) + 1, l, r, mid + 1, R)\n\nclass Matrix:\n    def __init__(self):\n        self.maxn = 2\n        self.x = [[0] * self.maxn for _ in range(self.maxn)]\n\n    def mul(self, A):\n        res = Matrix()\n        for i in range(self.maxn):\n            for j in range(self.maxn):\n                for k in range(self.maxn):\n                    res.x[i][j] = (res.x[i][j] + self.x[i][k] * A.x[k][j]) % MOD\n        return res\n\n    def pow(self, k):\n        res = Matrix()\n        for i in range(self.maxn):\n            res.x[i][i] = 1\n        T = self\n        k -= 1\n        while k > 0:\n            if k & 1:\n                res = res.mul(T)\n            T = T.mul(T)\n            k >>= 1\n        return res\n\nclass Pair:\n    def __init__(self, fi, se):\n        self.fi = fi\n        self.se = se\n\n    def compare_to(self, oth):\n        if self.fi > oth.fi:\n            return 1\n        elif self.fi < oth.fi:\n            return -1\n        elif self.se > oth.se:\n            return 1\n        elif self.se < oth.se:\n            return -1\n        else:\n            return 0\n\ndef gcd(a, b):\n    while b != 0:\n        a, b = b, a % b\n    return a\n\ndef lcm(a, b):\n    return a // gcd(a, b) * b\n\ndef fpow(n, k, p):\n    r = 1\n    while k > 0:\n        if k & 1:\n            r = r * n % p\n        n = n * n % p\n        k >>= 1\n    return r\n\ndef FloorOfNthRoot(x, n):\n    sign = 1 if x >= 0 else -1\n    if n <= 0 or sign < 0:\n        raise ValueError()\n    if x == 0:\n        return 0\n    if n == 1:\n        return x\n    getcontext().prec = 100\n    bigN = n\n    bigNMinusOne = n - 1\n    a = Decimal(1 << (x.bit_length() // n + 1))\n    x_dec = Decimal(x)\n    while True:\n        b = (a * (bigNMinusOne) + x_dec / (a ** (n - 1))) / bigN\n        if abs(b - a) < Decimal('1e-20'):\n            break\n        a = b\n    return int(a) * sign\n\ndef sqrt(A, SCALE):\n    getcontext().prec = SCALE\n    x0 = Decimal('0')\n    x1 = Decimal(A).sqrt()\n    while True:\n        prev_x1 = x1\n        x1 = (Decimal(A) / x1 + x1) / 2\n        if abs(x1 - prev_x1) < Decimal('1e-20'):\n            break\n    return x1\n\nclass Input:\n    @staticmethod\n    def nextInt():\n        return int(sys.stdin.readline())\n\n    @staticmethod\n    def nextLong():\n        return int(sys.stdin.readline())\n\n    @staticmethod\n    def nextDouble():\n        return float(sys.stdin.readline())\n\n    @staticmethod\n    def nextString():\n        return sys.stdin.readline().strip()\n\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0032084921840578318, -0.00011629798245849088, -3.128163257315464e-07, -1.2471589798224159e-05, -0.0002557369298301637, -0.17982709407806396, -8.1802