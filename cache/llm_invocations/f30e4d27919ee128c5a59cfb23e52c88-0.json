{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    long mod = 1_000_000_007;\n    long[] fact;\n    long[] invFact;\n\n    long inv(long n) {\n        long k = mod - 2;\n        long res = 1;\n        long a = n;\n        while(k > 0) {\n            if ((k & 1) > 0) res = (res * a) % mod;\n            a = (a * a) % mod;\n            k >>= 1;\n        }\n        return res;\n    }\n\n    long comb(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return fact[n] * invFact[r] % mod * invFact[n - r] % mod;\n    }\n\n    class Node {\n        int c50, c100, b, n;\n        long am;\n        ArrayList<Node> s;\n        Node(int x, int y, int z) {\n            c50 = x;\n            c100 = y;\n            b = z;\n            s = new ArrayList<>();\n            n = 0;\n            am = 0;\n        }\n    }\n\n    public void solve() {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int k = sc.nextInt();\n        int c50 = 0, c100 = 0;\n        for (int i = 0; i < n; i++) {\n            if (sc.nextInt() == 100) c100++;\n            else c50++;\n        }\n\n        fact = new long[51];\n        invFact = new long[51];\n        fact[0] = 1;\n        for (int i = 1; i < 51; i++) fact[i] = fact[i - 1] * i % mod;\n        for (int i = 0; i < 51; i++) invFact[i] = inv(fact[i]);\n\n        Node[][][] ns = new Node[c50 + 1][c100 + 1][2];\n        for (int i = 0; i <= c50; i++) {\n            for (int j = 0; j <= c100; j++) {\n                ns[i][j][0] = new Node(i, j, 0);\n                ns[i][j][1] = new Node(i, j, 1);\n            }\n        }\n\n        for (int i = 0; i <= c50; i++) {\n            for (int j = 0; j <= c100; j++) {\n                int p50c = Math.min(k / 50, i);\n                int p100c = Math.min(k / 100, j);\n                for (int x = p100c; x >= 0; x--) {\n                    for (int y = Math.min(p50c, (k - 100 * x) / 50); y >= 0; y--) {\n                        if (x == 0 && y == 0) continue;\n                        ns[i][j][0].s.add(ns[i - y][j - x][1]);\n                        ns[i - y][j - x][1].s.add(ns[i][j][0]);\n                    }\n                }\n            }\n        }\n\n        ArrayList<Node> level = new ArrayList<>();\n        ns[c50][c100][0].n = 1;\n        ns[c50][c100][0].am = 1;\n        level.add(ns[c50][c100][0]);\n\n        while (!level.isEmpty()) {\n            ArrayList<Node> next = new ArrayList<>();\n            for (Node cur : level) {\n                for (Node ch : cur.s) {\n                    if (ch.n == 0 || ch.n == cur.n + 1) {\n                        long p1 = comb(cur.b == 0 ? cur.c50 : c50 - cur.c50, Math.abs(cur.c50 - ch.c50));\n                        long p2 = comb(cur.b == 0 ? cur.c100 : c100 - cur.c100, Math.abs(cur.c100 - ch.c100));\n                        ch.am = (ch.am + (cur.am * ((p1 * p2) % mod)) % mod) % mod;\n                        if (ch.n == 0) {\n                            ch.n = cur.n + 1;\n                            next.add(ch);\n                        }\n                    }\n                }\n            }\n            level = next;\n        }\n\n        PrintWriter pw = new PrintWriter(System.out);\n        pw.println((ns[0][0][1].n - 1) + \"\\n\" + ns[0][0][1].am);\n        pw.flush();\n    }\n\n    public static void main(String[] args) {\n        new Main().solve();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef inv(n):\n    return pow(n, MOD - 2, MOD)\n\ndef comb(n, r, fact, inv_fact):\n    if r < 0 or r > n:\n        return 0\n    return fact[n] * inv_fact[r] % MOD * inv_fact[n - r] % MOD\n\nclass Node:\n    def __init__(self, c50, c100, b):\n        self.c50 = c50\n        self.c100 = c100\n        self.b = b\n        self.n = 0\n        self.am = 0\n        self.s = []\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    n = data[0]\n    k = data[1]\n    coins = data[2:2+n]\n    c50 = 0\n    c100 = 0\n    for v in coins:\n        if v == 100:\n            c100 += 1\n        else:\n            c50 += 1\n\n    # precompute factorials up to 50\n    fact = [1] * 51\n    for i in range(1, 51):\n        fact[i] = fact[i-1] * i % MOD\n    inv_fact = [0] * 51\n    for i in range(51):\n        inv_fact[i] = inv(fact[i])\n\n    # create nodes\n    ns = [[[None for _ in range(2)] for _ in range(c100+1)] for _ in range(c50+1)]\n    for i in range(c50+1):\n        for j in range(c100+1):\n            ns[i][j][0] = Node(i, j, 0)\n            ns[i][j][1] = Node(i, j, 1)\n\n    # build graph\n    for i in range(c50+1):\n        for j in range(c100+1):\n            p50c = min(k // 50, i)\n            p100c = min(k // 100, j)\n            for x in range(p100c, -1, -1):\n                max_y = min(p50c, (k - 100 * x) // 50)\n                for y in range(max_y, -1, -1):\n                    if x == 0 and y == 0:\n                        continue\n                    ns[i][j][0].s.append(ns[i-y][j-x][1])\n                    ns[i-y][j-x][1].s.append(ns[i][j][0])\n\n    # BFS\n    start = ns[c50][c100][0]\n    start.n = 1\n    start.am = 1\n    level = [start]\n    while level:\n        next_level = []\n        for cur in level:\n            for ch in cur.s:\n                if ch.n == 0 or ch.n == cur.n + 1:\n                    moved50 = abs(cur.c50 - ch.c50)\n                    moved100 = abs(cur.c100 - ch.c100)\n                    avail50 = cur.c50 if cur.b == 0 else c50 - cur.c50\n                    avail100 = cur.c100 if cur.b == 0 else c100 - cur.c100\n                    p1 = comb(avail50, moved50, fact, inv_fact)\n                    p2 = comb(avail100, moved100, fact, inv_fact)\n                    ch.am = (ch.am + cur.am * p1 % MOD * p2) % MOD\n                    if ch.n == 0:\n                        ch.n = cur.n + 1\n                        next_level.append(ch)\n        level = next_level\n\n    goal = ns[0][0][1]\n    print(goal.n - 1)\n    print(goal.am)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-4.446407547220588e-05, -1.1920928244535389e-07, 0.0, -0.00023922442051116377, -0.008630713447928429, -7.152555099310121e-07, -0.0067187827080488205, -0.009175869636237621, -1.1920928244535389e-07, -4.768370445162873e-07, -0.38692185282707214, -1.311301275563892e-06, 0.0, 0.0, -0.0007160721579566598, -0.007314923219382763, -0.598391056060791, -0.004844593815505505, -0.0037465158384293318, -1.1920928244535389e-07, -0.0020227227360010147, 0.0, -2.861018856492592e-06, -2.3841855067985307e-07, 0.0, -0.12692825496196747, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, -3.85038583772257e-05, -0.0885399803519249, -0.06584753096103668, -0.018169745802879333, -1.6689286894688848e-06, -1.1920928244535389e-07, -0.3868764340877533, -9.536738616588991e-07, -3.576278118089249e-07, -7.152555099310121e-07, -0.38694217801094055, 