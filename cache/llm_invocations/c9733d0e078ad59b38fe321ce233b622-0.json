{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nusing i64 = long long;\n\nconst i64 MOD1 = 998244353LL;\nconst i64 MOD2 = 1000000007LL;\n\ni64 total = 0;\ni64 N;\ni64 step1 = 0;\nvector<i64> seq[7];\ni64 cumsum[7];\n\nvoid build(int d, i64 cur) {\n    if (d == 7) return;\n    i64 val = (step1 - cur + MOD1) % MOD1;\n    seq[d].push_back(val);\n    cumsum[d] += val;\n    step1++;\n    for (int x = 0; x <= 9; ++x) {\n        build(d + 1, cur * 10 + x);\n    }\n}\n\nbool isComplete(i64 p) {\n    const i64 block = 1000000LL;\n    return p * block + 999999 <= N && p * block * 10 > N;\n}\n\ni64 step2 = 0;\nconst i64 pow10[7] = {1, 10, 100, 1000, 10000, 100000, 1000000};\n\nvoid solve(int d, i64 p) {\n    if (p > N) return;\n    if (isComplete(p)) {\n        for (int k = 0; k <= 6; ++k) {\n            i64 off = ((step2 + 1 - (p * pow10[k])) % MOD1 + MOD1) % MOD1;\n            auto lb = lower_bound(seq[k].begin(), seq[k].end(), MOD1 - off);\n            i64 pos = lb - seq[k].begin();\n            total = (total + cumsum[k] + off * (i64)seq[k].size() - MOD1 * ((i64)seq[k].size() - pos)) % MOD2;\n        }\n        step2 += step1;\n    } else {\n        step2++;\n        total = (total + ((step2 - p) % MOD1 + MOD1) % MOD1) % MOD2;\n        for (int dig = (d ? 0 : 1); dig <= 9; ++dig) {\n            solve(d + 1, p * 10 + dig);\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N;\n    build(0, 0);\n    for (int i = 0; i <= 6; ++i) sort(seq[i].begin(), seq[i].end());\n    step2 = -1;\n    solve(0, 0);\n    cout << total % MOD2 << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nsys.setrecursionlimit(1000000)\n\nMOD1 = 998244353\nMOD2 = 1000000007\n\ntotal = 0\nN = 0\nstep1 = 0\nseq = [[] for _ in range(7)]\ncumsum = [0] * 7\n\ndef build(d, cur):\n    global step1\n    if d == 7:\n        return\n    val = (step1 - cur + MOD1) % MOD1\n    seq[d].append(val)\n    cumsum[d] += val\n    step1 += 1\n    for x in range(10):\n        build(d + 1, cur * 10 + x)\n\ndef isComplete(p):\n    block = 1000000\n    return p * block + 999999 <= N and p * block * 10 > N\n\nstep2 = 0\npow10 = [1, 10, 100, 1000, 10000, 100000, 1000000]\n\ndef solve(d, p):\n    global step2, total\n    if p > N:\n        return\n    if isComplete(p):\n        for k in range(7):\n            off = ((step2 + 1 - (p * pow10[k])) % MOD1 + MOD1) % MOD1\n            lb = bisect.bisect_left(seq[k], MOD1 - off)\n            pos = lb\n            size_k = len(seq[k])\n            total = (total + cumsum[k] + off * size_k - MOD1 * (size_k - pos)) % MOD2\n        step2 += step1\n    else:\n        step2 += 1\n        val = ((step2 - p) % MOD1 + MOD1) % MOD1\n        total = (total + val) % MOD2\n        start_dig = 0 if d else 1\n        for dig in range(start_dig, 10):\n            solve(d + 1, p * 10 + dig)\n\ndef main():\n    global N, step2\n    input_data = sys.stdi