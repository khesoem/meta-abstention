b = 1 << (31 - __builtin_clz(i));\n            ull sum = 0;\n            int cnt = 0;\n            int j = i - hb;\n\n            while (true) {\n                int jj = j + hb;\n                sum += prev[i ^ jj] * (ull)ifact[jj];\n\n                if (cnt++ == 17) {\n                    sum %= MOD;\n                    cnt = 0;\n                }\n\n                if (j == 0) break;\n                j = (j - 1) & i;\n            }\n\n            next[i] = sum % MOD;\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= K; ++i)\n        (ans += 1LL * fact[n] * dp[i][n] % MOD * arrange(K, i) % MOD) %= MOD;\n\n    printf(\"%d\\n\", (modpow(K, n) + MOD - ans) % MOD);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\ndef modpow(a, e, MOD):\n    res = 1\n    while e:\n        if e & 1:\n            res = (res * a) % MOD\n        a = (a * a) % MOD\n        e >>= 1\n    return res\n\ndef main():\n    import sys\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    K = int(data[1])\n    MOD = int(data[2])\n\n    if n & 1:\n        print(modpow(K, n, MOD))\n        return\n\n    max_n = max(n, K)\n    fact = [1] * (max_n + 1)\n    for i in range(1, max_n + 1):\n        fact[i] = (fact[i-1] * i) % MOD\n\n    ifact = [1] * (max_n + 1)\n    ifact[max_n] = modpow(fact[max_n], MOD-2, MOD)\n    for i in range(max_n, 0, -1):\n        ifact[i-1] = (ifact[i] * i) % MOD\n\n    def arrange(nn, mm):\n        return (fact[nn] * ifact[nn - mm]) % MOD\n\n    dp = [[0] * (n + 1) for _ in range(K + 1)]\n    dp[0][0] = 1\n\n    for k in range(K):\n        prev = dp[k]\n        nxt = dp[k+1]\n        for i in range(1, n + 1):\n            if (i & n) != i:\n                continue\n            hb = 1 << (i.bit_length() - 1)\n            total = 0\n            cnt = 0\n            j = i - hb\n  