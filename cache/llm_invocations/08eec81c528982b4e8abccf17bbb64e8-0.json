{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nusing pii = pair<int, int>;\nusing vi = vector<int>;\nusing vvi = vector<vi>;\nusing vii = vector<pii>;\n\nstruct Edge {\n    int u, v, f, c, w;\n};\n\nconst int MAXN = 1000002;\nconst int INF = 1e9;\n\nint freq[MAXN];\nint src, dst;\nvector<int> g[MAXN];\n\nvector<Edge> e;\nvector<int> adj[MAXN];\n\nvoid link(int u, int v, int cap, int cost) {\n    e.push_back({u, v, 0, cap, cost});\n    adj[u].push_back(e.size() - 1);\n    e.push_back({v, u, 0, 0, -cost});\n    adj[v].push_back(e.size() - 1);\n}\n\nint dist[MAXN], inq[MAXN], flow[MAXN], par[MAXN];\n\npii spfa(int n) {\n    fill(dist, dist + n + 2, INF);\n    queue<int> q;\n    q.push(src);\n    dist[src] = 0;\n    inq[src] = 1;\n    flow[src] = INF;\n\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = 0;\n        for (int id : adj[u]) {\n            int v = e[id].v;\n            if (e[id].c > e[id].f && dist[v] > dist[u] + e[id].w) {\n                dist[v] = dist[u] + e[id].w;\n                par[v] = id;\n                flow[v] = min(flow[u], e[id].c - e[id].f);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (dist[dst] == INF) return {0, 0};\n\n    int aug = flow[dst];\n    int cur = dst;\n    while (cur != src) {\n        int id = par[cur];\n        e[id].f += aug;\n        e[id ^ 1].f -= aug;\n        cur = e[id].u;\n    }\n\n    return {aug, aug * dist[dst]};\n}\n\npii mcmf(int n) {\n    int flow_sum = 0, cost_sum = 0;\n    while (true) {\n        pii res = spfa(n);\n        if (res.first == 0) break;\n        flow_sum += res.first;\n        cost_sum += res.second;\n    }\n    return {flow_sum, cost_sum};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        g[u].push_back(v);\n        g[v].push_back(u);\n    }\n\n    src = 0;\n    dst = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            link(t * n + i, (t + 1) * n + i, k, 0);\n            for (int nb : g[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    link(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        if (freq[i]) link(src, i, freq[i], 0);\n    }\n\n    for (int t = 0; t <= 100; ++t) {\n        link(t * n + 1, dst, k, c * t);\n    }\n\n    cout << mcmf(dst).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    def __init__(self, u, v, f, c, w):\n        self.u = u\n        self.v = v\n        self.f = f\n        self.c = c\n        self.w = w\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    freq = [0] * (n + 1)\n    for _ in range(k):\n        x = int(data[idx]); idx += 1\n        freq[x] += 1\n    \n    g = [[] for _ in range(n + 1)]\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        g[u].append(v)\n        g[v].append(u)\n    \n    src = 0\n    dst = 100 * n + n + 1\n    \n    e = []\n    adj = [[] for _ in range(dst + 2)]\n    \n    def link(u, v, cap, cost):\n        e.append(Edge(u, v, 0, cap, cost))\n        adj[u].append(len(e) - 1)\n        e.append(Edge(v, u, 0, 0, -cost))\n        adj[v].append(len(e) - 1)\n    \n    for t in range(100):\n        for i in range(1, n + 1):\n            link(t * n + i, (t + 1) * n + i, k, 0)\n            for nb in g[i]:\n                for cp in range(1, k + 1):\n                    link(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1))\n    \n    for i in range(1, n + 1):\n        if freq[i]:\n            link(src, i, freq[i], 0)\n    \n    for t in range(101):\n        link(t * n + 1, dst, k, c * t)\n    \n    INF = 10**9\n    \n    def spfa(n):\n        dist = [INF] * (n + 2)\n        inq = [0] * (n + 2)\n        flow = [0] * (n + 2)\n        par = [-1] * (n + 2)\n        \n        q = deque()\n        q.append(src)\n        dist[src] = 0\n        inq[src] = 1\n        flow[src] = INF\n        \n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for id in adj[u]:\n                v = e[id].v\n                if e[id].c > e[id].f and dist[v] > dist[u] + e[id].w:\n                    dist[v] = dist[u] + e[id].w\n                    par[v] = id