dst]) - 1\n        \n        # Special case for self-loop\n        if src == dst:\n            reverse_edge.rev += 1\n\n    def _rcost(self, e):\n        return e.cost + self.potential[e.src] - self.potential[e.dst]\n\n    def dijkstra(self, source, sink):\n        self.dist = [float('inf')] * self.n\n        pq = [(0, source)]\n        self.dist[source] = 0\n        \n        while pq:\n            d, u = heapq.heappop(pq)\n            if self.dist[u] < d:\n                continue\n            if u == sink:\n                break\n            for e in self.adj[u]:\n                if e.flow < e.cap and self.dist[e.dst] > self.dist[e.src] + self._rcost(e):\n                    self.back[e.dst] = e\n                    self.dist[e.dst] = self.dist[e.src] + self._rcost(e)\n                    heapq.heappush(pq, (self.dist[e.dst], e.dst))\n        \n        return self.dist[sink]\n\n    def max_flow(self, source, sink):\n        flow = 0\n        cost = 0\n        \n        # Reset flows\n        for u in range(self.n):\n            for e in self.adj[u]:\n                e.flow = 0\n        \n        self.potential = [0] * self.n\n        self.dist = [float('inf')] * self.n\n        self.back = [None] * self.n\n        \n        while True:\n            dist_sink = self.dijkstra(source, sink)\n            if dist_sink == float('inf'):\n                break\n            \n            # Update potential\n            for u in range(self.n):\n                if self.dist[u] < self.dist[sink]:\n                    self.potential[u] += self.dist[u] - self.dist[sink]\n            \n            # Find minimum residual capacity along the path\n            f = float('inf')\n            e = self.back[sink]\n            while e is not None:\n                f = min(f, e.cap - e.flow)\n                e = self.back[e.src]\n            \n            # Update flows along the path\n            e = self.back[sink]\n            while e is not None:\n                e.flow += f\n                e.rev_edge.flow -= f\n                e = self.back[e.src]\n            \n            flow += f\n            cost += f * (self.potential[sink] - self.potential[source])\n        \n        return flow, cost\n\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    \n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    g = MinCostMaxFlow((n + 2) * 102)\n    \n    # Add edges for time layers\n    for i in range(102):\n        g.add_edge(i * (n + 2) + 1, i * (n + 2), 100, i * c)\n    \n    # Add edges between consecutive time layers\n    for i in range(101):\n        for j in range(n + 1):\n            g.add_edge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0)\n    \n    # Add edges from source to nodes\n    for _ in range(k):\n        u = int(next(it))\n        g.add_edge(n + 1, u, 1, 0)\n    \n    # Add edges for roads\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(101):\n            for f in range(k):\n                cost = (2 * f + 1) * d\n                g.add_edge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, cost)\n                g.add_edge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, cost)\n    \n    # Find max flow and min cost\n    _, min_cost = g.max_flow(n + 1, 101 * (n + 2))\n    print(min_cost)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00012790338951162994, -1.311301275563892e-06, -2.3841855067985307e-07, -0.0003209791029803455, -0.5761668086051941, -7.152555099310121e-07, -0.001329015358351171, -0.004736750852316618, -0.07899285852909088, -0.08896573632955551, -0.2592511475086212, -3.576278118089249e-07, -0.0011738798348233104, -0.282920777797699, -0.03605731949210167, -0.016591547057032585, -0.00017379203927703202, -0.001462819636799395, -3.6238969187252223e-05