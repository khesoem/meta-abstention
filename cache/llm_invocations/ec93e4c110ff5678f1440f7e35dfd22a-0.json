                addPoly(Ans[msk],Ans[msk^(1<<i)]);\n    }\n    void mobiusTransform() {\n        for(int i=0;i<N;i++)\n            for(int msk=n;msk>=0;msk--)\n                if(bit(msk,i))\n                    subPoly(Ans[msk],Ans[msk^(1<<i)]);\n    }\npublic:\n    void run() {\n        cin>>n>>K>>mod;\n        ll ans=powmod(K,n);\n        if(n&1){ cout<<ans<<\"\\n\"; return; }\n        N=__builtin_popcount(n);\n        int Nbef=n;\n        int vec[Lg]; int cnt=0;\n        for(int i=0;i<Lg;i++)\n            if(bit(n,i)) vec[cnt++]=i;\n        n=(1<<N)-1;\n        fac[0]=1;\n        for(int i=1;i<Max;i++) fac[i]=1LL*i*fac[i-1]%mod;\n        ifac[Max-1]=powmod(fac[Max-1],mod-2);\n        for(int i=Max-2;i>=0;i--) ifac[i]=1LL*(i+1)*ifac[i+1]%mod;\n        for(int i=0;i<=n;i++){\n            int Real=0;\n            for(int j=0;j<N;j++)\n                if(bit(i,j)) Real+=(1<<vec[j]);\n            Ans[i][__builtin_popcount(i)]=ifac[Real];\n        }\n        zetaTransform();\n        for(int i=0;i<=n;i++){\n            int KK=K;\n            memset(tmp2,0,sizeof(tmp2)); tmp2[0]=1;\n            while(KK){\n                if(KK&1) mulPoly(tmp2,tmp2,Ans[i]);\n                mulPoly(Ans[i],Ans[i],Ans[i]);\n                KK>>=1;\n            }\n            memcpy(Ans[i],tmp2,sizeof(tmp2));\n        }\n        mobiusTransform();\n        ans=(ans-1LL*Ans[n][N]*fac[Nbef])%mod;\n        if(ans<0) ans+=mod;\n        cout<<ans<<\"\\n\";\n    }\n};\n\nint main(){\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    Solver solver;\n    solver.run();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nclass Solver:\n    def __init__(self):\n        self.Lg = 18\n        self.Tw = 1 << self.Lg\n        self.Max = self.Tw + 10\n        self.N = 0\n        self.n = 0\n        self.mod = 0\n        self.K = 0\n        self.Ans = None\n        self.tmp = None\n        self.tmp2 = None\n        self.fac = None\n        self.ifac = None\n\n    def bit(self, x, k):\n        return (x >> k) & 1\n\n    def powmod(self, a, b):\n        return pow(a, b, self.mod)\n\n    def addPoly(self, a, b):\n        for i in range(self.N + 1):\n            a[i] = (a[i] + b[i]) % self.mod\n\n    def subPoly(self, a, b):\n        for i in range(self.N + 1):\n            a[i] = (a[i] - b[i]) % self.mod\n\n    def mulPoly(self, res, a, b):\n        tmp = [0] * (self.N + 1)\n        for i in range(self.N + 1):\n            for j in range(i + 1):\n                tmp[i] = (tmp[i] + a[j] * b[i - j]) % self.mod\n        res[:] = tmp\n\n    def zetaTransform(self):\n        for i in range(self.N):\n            for msk in range(self.n, -1, -1):\n                if self.bit(msk, i):\n                    self.addPoly(self.Ans[msk], self.Ans[msk ^ (1 << i)])\n\n    def mobiusTransform(self):\n        for i in range(self.N):\n            for msk in range(self.n, -1, -1):\n                if self.bit(msk, i):\n                    self.subPoly(self.Ans[msk], self.Ans[msk ^ (1 << i)])\n\n    def run(self):\n        data = sys.stdin.read().split()\n        if not data:\n            return\n        self.n = int(data[0])\n        self.K = int(data[1])\n        self.mod = int(data[2])\n\n        ans = self.powmod(self.K, self.n)\n        if self.n & 1:\n            sys.stdout.write(str(ans) + \"\\n\")\n            return\n\n        self.N = bin(self.n).count('1')\n        Nbef = self.n\n        vec = []\n        for i in range(self.Lg):\n            if self.bit(self.n, i):\n                vec.append(i)\n        self.n = (1 << self.N) - 1\n\n        self.fac = [1] * self.Max\n        for i in range(1, self.Max):\n            self.fac[i] = (i * self.fac[i - 1]) % self.mod\n        self.ifac = [1] * self.Max\n        self.ifac[self.Max - 1] = self.powmod(self.fac[self.Max - 1], self.mod - 2)\n        for i in range(self.Max -