{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nstatic ll MO;\nstruct mint {\n    ll x;\n    mint(ll a=0) { if (MO && (a>=MO || a<0)) a=(a%MO+MO)%MO; x=a; }\n    mint pw(ll e=MO-2) { mint a(*this), r(1); for(;e;e>>=1) { if(e&1) r*=a; a*=a; } return r; }\n    mint& operator+=(mint a) { x+=a.x; if(x>=MO) x-=MO; return *this; }\n    mint& operator-=(mint a) { x+=MO-a.x; if(x>=MO) x-=MO; return *this; }\n    mint& operator*=(mint a) { x=x*a.x%MO; return *this; }\n    mint& operator/=(mint a) { assert(a.x); *this*=a.pw(); return *this; }\n    mint operator+(mint a) const { mint r(*this); return r+=a; }\n    mint operator-(mint a) const { mint r(*this); return r-=a; }\n    mint operator*(mint a) const { mint r(*this); return r*=a; }\n    mint operator/(mint a) const { mint r(*this); return r/=a; }\n    friend ostream& operator<<(ostream& os, mint a) { os<<a.x; return os; }\n};\nint N, M;\nmint dpA[505], dpB[505], dpC[505][505], dpD[505][505];\nll Cnk(ll n, ll k) {\n    static ll fac[400005], inv[400005], finv[400005];\n    if (fac[0]==0) {\n        inv[1]=fac[0]=finv[0]=1;\n        for (int i=2;i<=400004;i++) inv[i]=inv[MO%i]*(MO-MO/i)%MO;\n        for (int i=1;i<=400004;i++) fac[i]=fac[i-1]*i%MO, finv[i]=finv[i-1]*inv[i]%MO;\n    }\n    if (k<0 || k>n) return 0;\n    return finv[k]*fac[n]%MO*finv[n-k]%MO;\n}\nvoid solve() {\n    cin>>N>>M>>MO;\n    dpA[0]=1;\n    for (int i=1; i<=N; ++i) {\n        for (int j=1; j<=i; ++j) {\n            dpA[i] += mint(i+1)*dpA[j-1]*dpA[i-j]*Cnk(i-1,j-1);\n        }\n    }\n    for (int i=1; i<=N; ++i) {\n        for (int j=1; j<=i; ++j) {\n            dpB[i] += mint(i+1)*(dpB[i-j]*dpA[j-1] + dpA[i-j]*dpB[j-1])*Cnk(i-1,j-1);\n            dpB[i] += dpA[j-1]*dpA[i-j]*Cnk(i-1,j-1)*(Cnk(j,2)+Cnk(i-j+1,2));\n        }\n    }\n    dpC[0][0]=1;\n    for (int i=1; i<=N; ++i) {\n        for (int j=0; j<i; ++j) {\n            dpC[i][j]=dpC[i-1][j];\n            dpD[i][j]=dpD[i-1][j];\n            for (int l=1; l<=j; ++l) {\n                dpC[i][j] += dpA[l]*dpC[i-l-1][j-l]*Cnk(j,l);\n                dpD[i][j] += (dpA[l]*dpD[i-l-1][j-l] + dpB[l]*dpC[i-l-1][j-l])*Cnk(j,l);\n            }\n        }\n        dpC[i][i]=dpA[i];\n        dpD[i][i]=dpB[i];\n    }\n    cout<<dpD[N][M]<<'\\n';\n}\nint main(int argc, char** argv) {\n    if (argc==1) ios::sync_with_stdio(false), cin.tie(0);\n    else {\n        string s;\n        for (int i=1;i<argc;i++) s+=argv[i], s+='\\n';\n        for (int i=(int)s.size()-1;i>=0;i--) ungetc(s[i],stdin);\n    }\n    cout.tie(0);\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMO = 0\n\nclass Mint:\n    __slots__ = ('x',)\n    def __init__(self, a=0):\n        global MO\n        if MO and (a >= MO or a < 0):\n            a = (a % MO + MO) % MO\n        self.x = a\n\n    def __pow__(self, e):\n        if e < 0:\n            e = MO - 2  # default exponent for division\n        a = self.x\n        r = 1\n        while e:\n            if e & 1:\n                r = (r * a) % MO\n            a = (a * a) % MO\n            e >>= 1\n        return Mint(r)\n\n    def __iadd__(self, other):\n        if isinstance(other, Mint):\n            self.x += other.x\n        else:\n            self.x += other\n        if self.x >= MO:\n            self.x -= MO\n        return self\n\n    def __isub__(self, other):\n        if isinstance(other, Mint):\n            self.x += MO - other.x\n        else:\n            self.x += MO - other\n        if self.x >= MO:\n            self.x -= MO\n        return self\n\n    def __imul__(self, other):\n        if isinstance(other, Mint):\n            self.x = (self.x * other.x) % MO\n        else:\n            self.x = (self.x * other) % MO\n        return self\n\n    def __itruediv__(self, other):\n        if isinstance(other, Mint):\n            inv = pow(other.x, MO - 2, MO)\n        else:\n            inv = pow(other, MO - 2, MO)\n        self.x = (self.x * inv) % MO\n        return self\n\n    def __add__(self, other):\n        res = Mint(self.x)\n        res += other\n        return res\n\n    def __sub__(self, other):\n        res = Mint(self.x)\n        res -= other\n        return res\n\n    def __mul__(self, other):\n        res = Mint(self.x)\n        res *= other\n        return res\n\n    def __truediv__(self, other):\n        res = Mint(self.x)\n        res /= other\n        return res\n\n    def __repr__(self):\n        return str(self.x)\n\n# Precomputed factorials for Cnk\nfac = [0] * 400005\ninv = [0] * 400005\nfinv = [0] * 400005\nfac_initialized = False\n\ndef Cnk(n, k):\n    global fac, inv, finv, fac_initialized, MO\n    if not fac_initialized:\n        inv[1] = 1\n        fac[0] = finv[0] = 1\n        for i in range(2, 400005):\n            inv[i] = inv[MO % i] * (MO - MO // i) % MO\n        for i in range(1, 400005):\n            fac[i] = fac[i-1] * i % MO\n            finv[i] = finv[i-1] * inv[i] % MO\n        fac_initialized = True\n    if k < 0 or k > n:\n        return 0\n    return finv[k] * fac[n] % MO * finv[n-k] % MO\n\ndef solve():\n    global MO\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    N = int(data[0])\n    M = int(data[1])\n    MO = int(data[2])\n\n    dpA = [Mint(0) for _ in range(N+1)]\n    dpB = [Mint(0) for _ in range(N+1)]\n    dpC = [[Mint(0) for _ in range(N+1)] for _ in range(N+1)]\n    dpD = [[Mint(0) for _ in range(N+1)] for _ in range(N+1)]\n\n    dpA[0] = Mint(1)\n    for i in range(1, N+1):\n        for j in range(1, i+1):\n            dpA[i] += Mint(i+1) * dpA[j-1] * dpA[i-j] * Mint(Cnk(i-1, j-1))\n\n    for i in range(1, N+1):\n        for j in range(1, i+1):\n            dpB[i] += Mint(i+1) * (dpB[i-j] * dpA[j-1] + dpA[i-j] * dpB[j-1]) * Mint(Cnk(i-1, j-1))\n            dpB[i] += dpA[j-1] * dpA[i-j] * Mint(Cnk(i-1, j-1)) * Mint(Cnk(j, 2) + Cnk(i-j+1, 2))\n\n    dpC[0][0] = Mint(1)\n    for i in range(1, N+1):\n        for j in range(0, i):\n            dpC[i][j] = dpC[i-1][j]\n            dpD[i][j] = dpD[i-1][j]\n            for l in range(1, j+1):\n                dpC[i][j] += dpA[l] * dpC[i-l-1][j-l] * Mint(Cnk(j, l))\n                dpD[i][j] += (dpA[l] * dpD[i-l-1][j-l] + dpB[l] * dpC[i-l-1][j-l]) * Mint(Cnk(j, l))\n        dpC[i][i] = dpA[i]\n        dpD[i][i] = dpB[i]\n\n    print(dpD[N][M].x)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0016628975281491876, -0.00013565097469836473, -1.1920928244535389e-07, 0.0, -8.284702198579907e-05, -0.004277841653674841, 0.0, -0.01816307194530964, -0.4811764061450958, -0.000266278104390949, -0.014184016734361649, -0.0009117737063206732, -0.07536472380161285, -0.01817302219569683, -0.004080423153936863, -1.311301275563892e-06, -7.152555099310121e-07, -0.07963452488183975, -1.6689286894688848e-06, -7.152555099310121e-07, -3.099436753473128e-06, -5.960462772236497e-07, -0.024158738553524017, -1.2516897186287679e