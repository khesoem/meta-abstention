ge &e = g[v][i];\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.push(e.to);\n                        }\n                    }\n                }\n            }\n            if (dist[t] == INF) break;\n            int add = need - flow;\n            for (int v = t; v != s; v = prevv[v])\n                add = min(add, g[prevv[v]][preve[v]].cap);\n            flow += add;\n            cost += add * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= add;\n                g[v][e.rev].cap += add;\n            }\n        }\n        return {flow, cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin.exceptions(ios::failbit);\n\n    int N, M, K, C, D;\n    cin >> N >> M >> K >> C >> D;\n    vector<int> starts(N, 0);\n    for (int i = 0; i < K; ++i) {\n        int a;\n        cin >> a;\n        --a;\n        ++starts[a];\n    }\n\n    int maxT = K + N + 1;\n    int V = (maxT + 1) * N + 2;\n    int src = V - 2;\n    int sink = V - 1;\n\n    MCMF mcf(V);\n\n    for (int i = 0; i < N; ++i)\n        if (starts[i])\n            mcf.addEdge(src, i, starts[i], 0);\n\n    for (int t = 0; t <= maxT; ++t)\n        mcf.addEdge(t * N, sink, K, 0);\n\n    for (int i = 0; i < N; ++i)\n        for (int t = 0; t < maxT; ++t)\n            mcf.addEdge(t * N + i, (t + 1) * N + i, K, C);\n\n    for (int i = 0; i < M; ++i) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        for (int t = 0; t < maxT; ++t) {\n            for (int j = 0; j < K; ++j) {\n                int c = C + (2 * j + 1) * D;\n                mcf.addEdge(t * N + u, (t + 1) * N + v, 1, c);\n       