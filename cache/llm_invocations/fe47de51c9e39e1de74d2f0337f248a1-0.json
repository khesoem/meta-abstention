{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n \nusing namespace std;\n \nusing ll = long long;\nusing tf = ll;\nusing tc = ll;\nconst tf INF = 1e9;\n\nstruct MCF {\n    int n;\n    vector<tc> prio, pot;\n    vector<tf> curflow;\n    vector<int> prevedge, prevnode;\n    priority_queue<pair<tc, int>, vector<pair<tc, int>>, greater<pair<tc, int>>> q;\n    \n    struct edge {\n        int to, rev;\n        tf f, cap;\n        tc cost;\n    };\n    \n    vector<vector<edge>> g;\n    \n    MCF(int n) : n(n), prio(n), curflow(n), prevedge(n), prevnode(n), pot(n), g(n) {}\n    \n    void add_edge(int s, int t, tf cap, tc cost) {\n        g[s].push_back({t, (int)g[t].size(), 0, cap, cost});\n        g[t].push_back({s, (int)g[s].size() - 1, 0, 0, -cost});\n    }\n    \n    pair<tf, tc> get_flow(int s, int t) {\n        tf flow = 0;\n        tc flowcost = 0;\n        \n        while (true) {\n            q.push({0, s});\n            fill(prio.begin(), prio.end(), INF);\n            prio[s] = 0;\n            curflow[s] = INF;\n            \n            while (!q.empty()) {\n                auto cur = q.top();\n                tc d = cur.first;\n                int u = cur.second;\n                q.pop();\n                \n                if (d != prio[u]) continue;\n                \n                for (int i = 0; i < (int)g[u].size(); ++i) {\n                    edge &e = g[u][i];\n                    int v = e.to;\n                    \n                    if (e.cap <= e.f) continue;\n                    \n                    tc nprio = prio[u] + e.cost + pot[u] - pot[v];\n                    if (prio[v] > nprio) {\n                        prio[v] = nprio;\n                        q.push({nprio, v});\n                        prevnode[v] = u;\n                        prevedge[v] = i;\n                        curflow[v] = min(curflow[u], e.cap - e.f);\n                    }\n                }\n            }\n            \n            if (prio[t] == INF) break;\n            \n            for (int i = 0; i < n; ++i)\n                pot[i] += prio[i];\n            \n            tf df = min(curflow[t], INF - flow);\n            flow += df;\n            \n            for (int v = t; v != s; v = prevnode[v]) {\n                edge &e = g[prevnode[v]][prevedge[v]];\n                e.f += df;\n                g[v][e.rev].f -= df;\n                flowcost += df * e.cost;\n            }\n        }\n        \n        return {flow, flowcost};\n    }\n};\n\nint main() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    const int T = 500;\n    int N = n * T;\n    MCF mcf(N + 2);\n    \n    // Wait edges: stay in same city for next time unit\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < T - 1; ++j)\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n    \n    // Source connections: arrival at city 0 at time i\n    for (int i = 0; i < T; ++i)\n        mcf.add_edge(i, N + 1, INF, 0);\n    \n    // People starting at their cities at time 0\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n    \n    // Travel edges between cities\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        \n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int _ = 0; _ < k; ++_) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n    \n    auto p = mcf.get_flow(N, N + 1);\n    assert(p.first == k);\n    cout << p.second << endl;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long INF = (long) 1e9;\n\n    static class Edge {\n        int to, rev;\n        long f, cap;\n        long cost;\n\n        Edge(int to, int rev, long f, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.f = f;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MCF {\n        int n;\n        long[] prio, pot;\n        long[] curflow;\n        int[] prevedge, prevnode;\n        PriorityQueue<Pair> q;\n        List<List<Edge>> g;\n\n        MCF(int n) {\n            this.n = n;\n            this.prio = new long[n];\n            this.pot = new long[n];\n            this.curflow = new long[n];\n            this.prevedge = new int[n];\n            this.prevnode = new int[n];\n            this.q = new PriorityQueue<>(Comparator.comparingLong(p -> p.first));\n            this.g = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                g.add(new ArrayList<>());\n            }\n        }\n\n        void addEdge(int s, int t, long cap, long cost) {\n            g.get(s).add(new Edge(t, g.get(t).size(), 0, cap, cost));\n            g.get(t).add(new Edge(s, g.get(s).size() - 1, 0, 0, -cost));\n        }\n\n        Pair<Long, Long> getFlow(int s, int t) {\n            long flow = 0;\n            long flowcost = 0;\n\n            while (true) {\n                q.add(new Pair<>(0L, s));\n                Arrays.fill(prio, INF);\n                prio[s] = 0;\n                curflow[s] = INF;\n\n                while (!q.isEmpty()) {\n                    Pair<Long, Integer> cur = q.poll();\n                    long d = cur.first;\n                    int u = cur.second;\n\n                    if (d != prio[u]) continue;\n\n                    for (int i = 0; i < g.get(u).size(); ++i) {\n                        Edge e = g.get(u).get(i);\n                        int v = e.to;\n\n                        if (e.cap <= e.f) continue;\n\n                        long nprio = prio[u] + e.cost + pot[u] - pot[v];\n                        if (prio[v] > nprio) {\n                            prio[v] = nprio;\n                            q.add(new Pair<>(nprio, v));\n                            prevnode[v] = u;\n                            prevedge[v] = i;\n                            curflow[v] = Math.min(curflow[u], e.cap - e.f);\n                        }\n                    }\n                }\n\n                if (prio[t] == INF) break;\n\n                for (int i = 0; i < n; ++i)\n                    pot[i] += prio[i];\n\n                long df = Math.min(curflow[t], INF - flow);\n                flow += df;\n\n                for (int v = t; v != s; v = prevnode[v]) {\n                    Edge e = g.get(prevnode[v]).get(prevedge[v]);\n                    e.f += df;\n                    g.get(v).get(e.rev).f -= df;\n                    flowcost += df * e.cost;\n                }\n            }\n\n            return new Pair<>(flow, flowcost);\n        }\n    }\n\n    static class Pair<F, S> {\n        F first;\n        S second;\n\n        Pair(F first, S second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        final int T = 500;\n        int N = n * T;\n        MCF mcf = new MCF(N + 2);\n\n        // Wait edges: stay in same city for next time unit\n        for (int i = 0; i < n; ++i)\n            for (int j = 0; j < T - 1; ++j)\n                mcf.addEdge(i * T + j, i * T + j + 1, INF, c);\n\n        // Source connections: arrival at city 0 at time i\n        for (int i = 0; i < T; ++i)\n            mcf.addEdge(i, N + 1, INF, 0);\n\n        // People starting at their cities at time 0\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            --x;\n            mcf.addEdge(N, x * T, 1, 0);\n        }\n\n        // Travel edges between cities\n        for (int i = 0; i < m; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x; --y;\n\n            for (int j = 0; j < T - 1; ++j) {\n                int cur = 1;\n                for (int _ = 0; _ < k; ++_) {\n                    mcf.addEdge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                    mcf.addEdge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        Pair<Long, Long> p = mcf.getFlow(N, N + 1);\n        System.out.println(p.second);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002153879904653877, -2.3841830625315197e-06, -7.152555099310121e-07, -0.0009831124916672707, -3.862306402879767e-05, -0.2014351636171341, -0.14287610352039337, -0.00012683063687290996, -4.768370445162873e-07, -0.0001501924270996824, -0.061968062072992325, -0.0007117837085388601, -0.014588827267289162, -0.6705386638641357, -0.01032912265509367, -8.02246358