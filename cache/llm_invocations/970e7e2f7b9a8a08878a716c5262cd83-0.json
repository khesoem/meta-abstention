sponse": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[20];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n        \n        List<Integer> leftSums = new ArrayList<>();\n        int leftSize = n / 2 + n % 2;\n        for (int mask = 0; mask < (1 << leftSize); mask++) {\n            int total = 0;\n            int temp = mask;\n            for (int idx = 0; idx < 20; idx++) {\n                if ((temp & 1) == 1) {\n                    total += a[idx];\n                }\n                temp >>= 1;\n            }\n            leftSums.add(total % m);\n        }\n        Collections.sort(leftSums);\n        \n        int result = 0;\n        int rightSize = n / 2;\n        for (int mask = 0; mask < (1 << rightSize); mask++) {\n            int total = 0;\n            int temp = mask;\n            for (int idx = 0; idx < 20; idx++) {\n                if ((temp & 1) == 1) {\n                    total += a[leftSize + idx];\n                }\n                temp >>= 1;\n            }\n            total %= m;\n            if (total < 0) total += m;\n            \n            int complement = (m - total - 1) % m;\n            if (complement < 0) complement += m;\n            \n            int pos = binarySearchLeftmost(leftSums, complement);\n            int candidate = leftSums.get(leftSums.size() - 1);\n            \n            if (pos < leftSums.size()) {\n                if (leftSums.get(pos) > complement) {\n                    if (pos > 0) {\n                        candidate = leftSums.get(pos - 1);\n                    }\n                } else {\n                    candidate = leftSums.get(pos);\n                }\n            }\n            \n            int val1 = (total + candidate) % m;\n            int val2 = (total + leftSums.get(leftSums.size() - 1)) % m;\n            result = Math.max(result, Math.max(val1, val2));\n        }\n        \n        System.out.println(result % m);\n    }\n    \n    private static int binarySearchLeftmost(List<Integer> list, int target) {\n        int left = 0;\n        int right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) >= target) {\n                right = mid;\n            } else {\n                left = mid + 1;\n            }\n        }\n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014745102089364082, -2.0265558760002023e-06, -9.536738616588991e-07, -0.000658057106193155, -2.634490556374658e-05, -0.002185577293857932, -0.10444089025259018, -4.172316494077677e-06, -1.311301275563892e-06, -0.0001392267586197704, -2.622600959512056e-06, -7.152555099310121e-07, -9.536738616588991e-07, -2.3841855067985307e-07, -1.6689286894688848e-06, -1.7881377516459906e-06, -1.1920922133867862e-06, -1.1920928244535389e-07, -8.165503095369786e-05, -1.1920922133867862e-06, -3.576278118089249e-07, -1.6689286894688848e-06, -3.3378044463461265e-05, -0.25421619415283203, -2.3841830625315197e-06, -1.1920928244535389e-07, -1.0609570381348021e-05, -4.887569048150908e-06, -1.7881377516459906e-06, -1.549708758830093e-05, -0.001505433232523501, -0.00010990492592100054, 0.0, -1.1920928244535389e-07, -1.7881377516459906e-06, -2.0265558760002023e-06, -1.7881377516459906e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -7.510157047363464e-06, -9.536738616588991e-07, -7.152555099310121e-07, -2.7418097943154862e-06, -0.0548832081258297, -3.242440288886428e-05, -5.960462772236497e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -1.5497195136049413e-06, -1.1920928244535389e-07, -0.1709166318178177, -1.8596476365928538e-05, -5.113947918289341e-05, -0.004082678817212582, -6.031808152329177e-05, -4.768370445