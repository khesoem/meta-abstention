       if x == nn+1:\n            return True, p\n        for h in range(nn+2):\n            if g[x][h] > 0 and not c[h]:\n                c[h] = True\n                p[h] = x\n                q.append(h)\n    return False, p\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n    sx = int(next(it))\n    sy = int(next(it))\n    \n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                sx = i\n                sy = j\n    \n    v = [[0]*n for _ in range(n)]\n    bfs(v, sx, sy, a, n)\n    \n    # dp[yt][sx][sy][x][y] but we only need up to t, and we compress by using set of states\n    # Actually we need to follow the original logic precisely. We'll use 4D boolean for current yt.\n    dp_cur = [[[[False]*n for _ in range(n)] for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            if '0' <= a[i][j] <= '9':\n                dp_cur[i][j][i][j] = True\n    \n    dp_states = [None]*(t+1)\n    dp_states[0] = dp_cur\n    \n    for yt in range(t):\n        dp_next = [[[[False]*n for _ in range(n)] for _ in range(n)] for _ in range(n)]\n        for sx in range(n):\n            for sy in range(n):\n                for x in range(n):\n                    for y in range(n):\n                        if not dp_cur[sx][sy][x][y]:\n                            continue\n                        if v[x][y] <= yt:\n                            continue\n                        for i in range(4):\n                            hx = x + dx[i]\n                            hy = y + dy[i]\n                            if 0 <= hx < n and 0 <= hy < n and '0' <= a[hx][hy] <= '9':\n                                if v[hx][hy] >= yt+1:\n                                    dp_next[sx][sy][hx][hy] = True\n        dp_cur = dp_next\n        dp_states[yt+1] = dp_cur\n    \n    u = [[[[False]*n for _ in range(n)] for _ in range(n)] for _ in range(n)]\n    for yt in range(t+1):\n        for sx in range(n):\n            for sy in range(n):\n                for x in range(n):\n                    for y in range(n):\n                        if dp_states[yt][sx][sy][x][y]:\n                            u[sx][sy][x][y] = True\n    \n    nn = 2*n*n\n    g = [[0]*(nn+2) for _ in range(nn+2)]\n    \n    for x1 in range(n):\n        for y1 in range(n):\n            if '0' <= a[x1][y1] <= '9':\n                g[0][x1*n + y1 + 1] = int(a[x1][y1])\n    \n    for x2 in range(n):\n        for y2 in range(n):\n            if '0' <= b[x2][y2] <= '9':\n                g[n*n + x2*n + y2 + 1][nn+1] = int(b[x2][y2])\n    \n    for x1 in range(n):\n        for y1 in range(n):\n            if not ('0' <= a[x1][y1] <= '9'):\n                continue\n            for x2 in range(n):\n                for y2 in range(n):\n                    if not ('0' <= a[x2][y2] <= '9'):\n                        continue\n                    if u[x1][y1][x2][y2]:\n                        g[x1*n + y1 + 1][n*n + x2*n + y2 + 1] = INF\n    \n    while True:\n        found, p = bfs1(g, nn)\n        if not found:\n            break\n        minu = INF\n        i = nn+1\n        while i != 0:\n            minu = min(minu, g[p[i]][i])\n            i = p[i]\n        i = nn+1\n        while i != 0:\n            g[p[i]][i] -= minu\n            g[i][p[i]] += minu\n            i = p[i]\n    \n    ans = sum(g[i][0] for i in range(nn+2))\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.521823e-05, 0.0, -2.0265559e-06, -0.0019582398, -0.106765375, -0.00019464982, -0.003237366, -0.0021064728, -9.8342825e-05, -1.1920928e-07, -6.0675688e-05, -0.018817244, -1.7729979, -0.00010418349, -1.6689287e-06, -6.5086155e-05, -5.7814836e-05, -8.344647e-07,