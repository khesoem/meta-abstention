[i];\n                if (cumulative == 0) {\n                    validDifferences.add(Math.abs(data[i] - data[i + 1]));\n                }\n            }\n\n            Collections.sort(validDifferences);\n            long spent = 0;\n            int selectedCount = 0;\n            \n            for (int diff : validDifferences) {\n                if ((spent += diff) <= budget) {\n                    selectedCount++;\n                } else {\n                    break;\n                }\n            }\n            \n            out.write(selectedCount);\n        }\n    }\n\n    static class InputHandler {\n        private final BufferedReader reader;\n        private StringTokenizer tokens;\n\n        public InputHandler(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream));\n        }\n\n        private String nextToken() {\n            try {\n                while (tokens == null || !tokens.hasMoreTokens()) {\n                    tokens = new StringTokenizer(reader.readLine());\n                }\n                return tokens.nextToken();\n            } catch (IOException e) {\n                throw new UncheckedIOException(e);\n            }\n        }\n\n        int readInteger() {\n            return Integer.parseInt(nextToken());\n        }\n\n        long readLong() {\n            return Long.parseLong(nextToken());\n        }\n    }\n\n    static class OutputHandler {\n        private final PrintWriter writer;\n\n        public OutputHandler(OutputStream stream) {\n            writer = new PrintWriter(stream);\n        }\n\n        void write(int value) {\n            writer.println(value);\n        }\n\n        void close() {\n            writer.close();\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport io\n\nclass InputHandler:\n    def __init__(self, stream):\n 