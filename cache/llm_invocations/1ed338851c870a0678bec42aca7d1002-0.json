ring p, String c) {\n        char a = p.charAt(0), b = p.charAt(1);\n        char x = c.charAt(0), y = c.charAt(1);\n\n        if (Character.isDigit(a)) {\n            if (Character.isDigit(b)) return p.equals(c);\n            if (b == '_') return a == x;\n        } else if (a == '_') {\n            if (Character.isDigit(b)) return b == y;\n            if (b == '_') return true;\n        } else if (a == 'X') {\n            if (Character.isDigit(b)) return b == y;\n            if (b == '_') return true;\n        }\n        return false;\n    }\n\n    private static boolean matches(String pattern, String candidate) {\n        Set<Character> digits = new HashSet<>();\n        for (int i = 0; i < pattern.length(); i++) {\n            char pc = pattern.charAt(i);\n            char cc = candidate.charAt(i);\n            if (pc == '_') continue;\n            if (pc == 'X') {\n                digits.add(cc);\n                if (digits.size() > 1) return false;\n            } else if (pc != cc) {\n                return false;\n            }\n        }\n        return digits.size() <= 1;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    s = sys.stdin.readline().strip()\n    n = len(s)\n\n    if n == 1:\n        if s in [\"0\", \"_\", \"X\"]:\n            print(1)\n        else:\n            print(0)\n        return\n\n    if n == 2:\n        cnt = 0\n        for i in range(25, 96, 25):\n            cand = f\"{i:02d}\"\n            if two_char_match(s, cand):\n                cnt += 1\n        print(cnt)\n        return\n\n    start = 10 ** (n - 1)\n    end = 10 ** n\n    count = 0\n\n    for num in range(start, end, 25):\n        num_str = str(num)\n        if matches(s, num_str):\n            count += 1\n\n    print(count)\n\ndef two_char_match(p, c):\n    a = p[0]\n    b = p[1]\n    x = c[0]\n    y = c[1]\n\n    if a.isd