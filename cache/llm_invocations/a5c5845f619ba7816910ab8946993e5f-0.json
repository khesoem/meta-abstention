changed\n        }\n\n        // If ends with \".\", replace last dot with \"dot\"\n        if (data.endsWith(\".\")) {\n            data = data.substring(0, data.length() - 1) + \"dot\";\n        }\n\n        // Replace first occurrence of \"at\" with \"@\" from index 1 onward\n        if (data.length() > 1) {\n            String rest = data.substring(1);\n            if (rest.contains(\"at\")) {\n                rest = rest.replaceFirst(\"at\", \"@\");\n                data = data.charAt(0) + rest;\n            }\n        }\n\n        // If ends with \"@\", replace last \"@\" with \"at\"\n        if (data.endsWith(\"@\")) {\n            data = data.substring(0, data.length() - 1) + \"at\";\n        }\n\n        System.out.println(data);\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -4.1126360883936286e-05, -2.0265558760002023e-06, -1.1920928244535389e-07, -0.00015841660206206143, -0.014495306648314, -0.004085409455001354, -1.07287787614041e-05, 0.0, -0.030836274847388268, -2.264974000354414e-06, -3.099436753473128e-06, -3.576278118089249e-07, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -5.960462772236497e-07, -3.4570634852570947e-06, 0.0, -9.059865078597795e-06, -0.038089726120233536, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -3.933898824470816e-06, -8.344646857949556e-07, -0.0019539566710591316, -0.00011812942830147222, -4.768370445162873e-07, -1.1920928244535389e-07, -6.198863957251888e-06, -0.03834892064332962, -0.4740836024284363, -0.779723584651947, 0.0, -0.20145533978939056, -5.960462772236497e-07, -0.017517374828457832, -0.5270581245422363, -0.5772783160209656, -2.145764938177308e-06, -2.3841855067985307e-07, -0.0001618731184862554, -5.364274329622276e-05, -0.7437601089477539, -0.059998590499162674, -1.9073468138230965e-06, -5.960462772236497e-07, -0.1276979148387909, -0.48898065