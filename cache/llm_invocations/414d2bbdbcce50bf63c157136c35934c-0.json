2)\n    return s1 / s\n\ndef main():\n    x, y, n = map(int, input().split())\n    a, b = 0, 1\n    t1 = x / y\n    for i in range(1, n + 1):\n        l, r, ave = 1, 1000000, 0\n        while r - l > 1:\n            ave = (l + r) // 2\n            t2 = ave / i\n            if t2 < t1:\n                l = ave\n            else:\n                r = ave\n        ave = l\n        if (func(l, i, x, y) > func(r, i, x, y)):\n            ave = r\n        if func(ave, i, x, y) < func(a, b, x, y):\n            a, b = ave, i\n    print(f\"{a}/{b}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.05001801624894142, -0.001739894854836166, -0.022937802597880363, -0.00011467275908216834, -0.00010990492592100054, -3.480850500636734e-05, -1.597391747054644e-05, -0.00012742661056108773, -8.34461570775602e-06, -0.015814948827028275, -1.4305012882687151e-05, -0.0006243425305001438, -4.887569048150908e-06, -2.634490556374658e-05, -3.0874729418428615e-05, -3.266281055402942e-05, -2.0265558760002023e-06, -0.001290561049245298, -2.3841830625315197e-06, -3.4570634852570947e-06, -2.622600959512056e-06, -0.0009819215629249811, -0.0003601856005843729, -3.909988299710676e-05, -3.576272320060525e-06, -9.536697689327411e-06, -2.706014311115723e-05, -2.861018856492592e-06, -1.1920922133867862e-06, -0.012773245573043823, -0.00015793983766343445, -3.576278118089249e-07, -0.00011503035057103261, -3.933898824470816e-06, -1.311301275563892e-06, -9.536738616588991e-07, -4.1960789531003684e-05, -1.0728830375228426e-06, -2.0265558760002023e-06, -8.344646857949556e-07, -0.00020489977032411844, -0.00031442465842701495, -1.9073468138230965e-06, -1.0132738680113107e-05, -2.145764938177308e-06, -3.2186455882765586e-06, -1.5497195136049413e-06, -3.0874729418428615e-05, -1.0728830375228426e-06, -2.145764938177308e-06, -1.1444026313256472e-05, -0.0003471963864285499, -4.6491513785440475e-06, -1.966933996300213e-05, -2.9802276912960224