alW > K:\n                    break\n                ways = nCk(fifty - f, i, comb) * nCk(hundred - h, j, comb) % MOD\n                ans = (ans + ways * solve2(0, f + i, h + j, r - 1, N, fifty, hundred, K, memo2, comb)) % MOD\n    else:\n        for i in range(f + 1):\n            if i * 50 > K:\n                break\n            for j in range(h + 1):\n                if i == 0 and j == 0:\n                    continue\n                totalW = i * 50 + j * 100\n                if totalW > K:\n                    break\n                ways = nCk(f, i, comb) * nCk(h, j, comb) % MOD\n                ans = (ans + ways * solve2(1, f - i, h - j, r - 1, N, fifty, hundred, K, memo2, comb)) % MOD\n    memo2[t][f][h][r] = ans\n    return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    N = int(data[idx]); idx += 1\n    K = int(data[idx]); idx += 1\n    fifty = 0\n    hundred = 0\n    for _ in range(N):\n        v = int(data[idx]); idx += 1\n        if v == 50:\n            fifty += 1\n        else:\n            hundred += 1\n    \n    memo = [[None] * (hundred + 1) for _ in range(2)]\n    for i in range(2):\n        for j in range(fifty + 1):\n            memo[i][j] = [None] * (hundred + 1)\n    \n    comb = [[None] * 101 for _ in range(101)]\n    \n    min_steps = solve(0, fifty, hundred, N, fifty, hundred, K, memo)\n    \n    if min_steps >= 10**6:\n        print(-1)\n        print(0)\n    else:\n        memo2 = [[[None] * (min_steps + 1) for _ in range(hundred + 1)] for _ in range(2)]\n        for i in range(2):\n            for j in range(fifty + 1):\n                memo2[i][j] = [[None] * (min_steps + 1) for _ in range(hundred + 1)]\n        print(min_steps)\n        print(solve2(0, fifty, hundred, min_steps, N, fifty, hundred, K, memo2, comb))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.6980417866725475e-05, -8.344646857949556e