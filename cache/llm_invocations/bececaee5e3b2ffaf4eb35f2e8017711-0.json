(int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            u--; v--;\n            for (int j = 0; j < 99; j++) {\n                long cost = d;\n                for (int t = 0; t < 50; t++) {\n                    addEdge(u + j * 50, v + (j + 1) * 50, 1, cost);\n                    addEdge(v + j * 50, u + (j + 1) * 50, 1, cost);\n                    cost += 2 * d;\n                }\n            }\n        }\n        for (int i = 0; i <= 99; i++) addEdge(0 + i * 50, 5001, INF, (long)c * i);\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < 99; j++)\n                addEdge(i + j * 50, i + (j + 1) * 50, INF, 0);\n        long[] res = mcmf(5000, 5001);\n        // assert res[1] == k;\n        System.out.println(res[0]);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.13879793882369995, -0.3139728903770447, -2.825220326485578e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -7.390703103737906e-05, -6.603976362384856e-05, -5.960462772236497e-07, -0.006715704221278429, -0.005581034813076258, -0.0005036516231484711, -1.1920928244535389e-07, -0.014020166359841824, -0.011053401976823807, -0.00016068121476564556, -0.004407098051160574, -0.06212838739156723, -0.00026127262390218675, -1.0728830375228426e-06, -3.3378546504536644e-06, -1.1920928244535389e-07, -1.0728830375228426e-06, -0.0001438752660760656, -7.390948667307384e-06, -2.8609820219571702e-05, 0.0, -3.576278118089249e-07, -2.753696753643453e-05, -5.245195097813848e-06, 0.0, -8.344646857949556e-07, -0.12731100618839264, -1.0490362910786644e-05, -6.198863957251888e-06, -0.31326723098754883, -1.1920928244535389e-07, -0.017770130187273026, -0.0020714986603707075, -1.9073468138230965e-06, -2.7656173188006505e-05, -3.969590397900902e-05, -1.6689160474925302e-05, -3.576278118089249e-07, -2.3841855067985307e-07, -0.0015026956098154187, -6.198863957251888e-06, -0.0024756519123911858, -2.372