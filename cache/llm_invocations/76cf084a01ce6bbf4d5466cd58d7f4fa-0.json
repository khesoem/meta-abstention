{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define fst first\n#define snd second\n#define fore(i,a,b) for(int i=a,ThxDem=b;i<ThxDem;++i)\n#define pb push_back\n#define ALL(s) s.begin(),s.end()\n#define FIN ios_base::sync_with_stdio(0);cin.tie(0);cout.tie(0)\n#define SZ(s) int(s.size())\nusing namespace std;\ntypedef long long ll;\ntypedef pair<int,int> ii;\n\nconst int INF=1e9;\nstruct MCF {\n\tint n, m, k, t;\n\tvector<int> u,v,prio,curflow,prevedge,prevnode,pot;\n\tstruct Edge {\n\t\tint to, f, cap, cost, rev;\n\t};\n\tvector<vector<Edge>> adj;\n\tMCF(int n):n(n),u(n),v(n),prio(n),curflow(n),prevedge(n),prevnode(n),pot(n),adj(n){}\n\tpriority_queue<ll, vector<ll>, greater<ll> > q;\n\tinline void addEdge(int s, int t, int cap, int cost) {\n\t\tEdge a = {t, 0, cap, cost, SZ(adj[t])};\n\t\tEdge b = {s, 0, 0, -cost, SZ(adj[s])};\n\t\tadj[s].push_back(a);\n\t\tadj[t].push_back(b);\n\t}\n\tinline pair<int, int> minCostFlow(int s, int t) {\n\t\tint flow=0, flowCost=0;\n\t\twhile(flow<INF) {\n\t\t\tq.push(s);\n\t\t\tfill(ALL(prio), INT_MAX);\n\t\t\tprio[s]=0;\n\t\t\tcurflow[s]=INT_MAX;\n\t\t\twhile(!q.empty()) {\n\t\t\t\tll cur=q.top();\n\t\t\t\tint d=cur>>32, u=cur;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u])\n\t\t\t\t\tcontinue;\n\t\t\t\tfor(int i=0; i<SZ(adj[u]); ++i) {\n\t\t\t\t\tEdge &e=adj[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif (e.cap<=e.f)\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\tint nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif (prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push(((ll)nprio<<32)+v);\n\t\t\t\t\t\tprevnode[v]=u;\n\t\t\t\t\t\tprevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INT_MAX)\n\t\t\t\tbreak;\n\t\t\tfor(int i=0; i<n; ++i)\n\t\t\t\tpot[i]+=prio[i];\n\t\t\tint df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tEdge &e=adj[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df;\n\t\t\t\tadj[v][e.rev].f-=df;\n\t\t\t\tflowCost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn make_pair(flow, flowCost);\n\t}\n};\n\nint n,m,k,c,d;\n \nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tMCF nt(6+107*n);\n\tfore(_,0,k){\n\t\tint x;\n\t\tscanf(\"%d\",&x);x--;\n\t\tnt.addEdge(0,1+x,1,0);\n\t}\n\tfore(_,0,m){\n\t\tint x,y;\n\t\tscanf(\"%d%d\",&x,&y);x--;y--;\n\t\tfore(i,0,105){\n\t\t\tfore(j,0,51){\n\t\t\t\tnt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n\t\t\t\tnt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n\t\t\t}\n\t\t}\n\t}\n\tfore(i,0,105)fore(j,0,n)nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n\tfore(i,0,105)nt.addEdge(1+i*n,1+105*n,51,0);\n\tauto ans=nt.minCostFlow(0,1+105*n);\n\tprintf(\"%d\\n\",ans.snd);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nINF = 10**9\n\nclass MCF:\n    class Edge:\n        __slots__ = ('to', 'f', 'cap', 'cost', 'rev')\n        def __init__(self, to, f, cap, cost, rev):\n            self.to = to\n            self.f = f\n            self.cap = cap\n            self.cost = cost\n            self.rev = rev\n    \n    def __init__(self, n):\n        self.n = n\n        self.u = [0] * n\n        self.v = [0] * n\n        self.prio = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n        self.adj = [[] for _ in range(n)]\n    \n    def addEdge(self, s, t, cap, cost):\n        a = self.Edge(t, 0, cap, cost, len(self.adj[t]))\n        b = self.Edge(s, 0, 0, -cost, len(self.adj[s]))\n        self.adj[s].append(a)\n        self.adj[t].append(b)\n    \n    def minCostFlow(self, s, t):\n        flow = 0\n        flowCost = 0\n        while flow < INF:\n            # Dijkstra's algorithm with priority queue\n            pq = []\n            heapq.heappush(pq, (0, s))\n            self.prio = [INF] * self.n\n            self.prio[s] = 0\n            self.curflow = [0] * self.n\n            self.curflow[s] = INF\n            \n            while pq:\n                d, u = heapq.heappop(pq)\n                if d != self.prio[u]:\n                    continue\n                for i in range(len(self.adj[u])):\n                    e = self.adj[u][i]\n                    v = e.to\n                    if e.cap <= e.f:\n                        continue\n                    nprio = self.prio[u] + e.cost + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nprio:\n                        self.prio[v] = nprio\n                        heapq.heappush(pq, (nprio, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e.cap - e.f)\n            \n            if self.prio[t] == INF:\n                break\n            \n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            \n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            v = t\n            while v != s:\n                e = self.adj[self.prevnode[v]][self.prevedge[v]]\n                e.f += df\n                self.adj[v][e.rev].f -= df\n                flowCost += df * e.cost\n                v = self.prevnode[v]\n        \n        return (flow, flowCost)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    nt = MCF(6 + 107 * n)\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        nt.addEdge(0, 1 + x, 1, 0)\n    \n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for i in range(105):\n            for j in range(51):\n                nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1))\n                nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1))\n    \n    for i in range(105):\n        for j in range(n):\n            nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c)\n    \n    for i in range(105):\n        nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0)\n    \n    ans = nt.minCostFlow(0, 1 + 105 * n)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021407696476671845, -1.0728830375228426e-06, -1.1920928244535389e-07, -5.221230458118953e-05, -0.3135431706905365, -0.02074403502047062, -0.003205401822924614, -0.026607872918248177, -0.5232619047164917, -1.0195034742355347, -1.5497195136049413e-06, -0.0008575814426876605, -1.8954096958623268e-05, -4.0411134250462055e-05, -8.260862523457035e-05, -2.0265558760002023e-06, -0.005937438458204269, -0.0019545515533536673, -0.31410568952560425, -6.6756979322235566e-06, -8.583032467868179e-06, -2.3841855067985307e-07, -0.3484659492969513, -2.753696753643453e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.1128246933221817, -7.784063927829266e-05, -3.81