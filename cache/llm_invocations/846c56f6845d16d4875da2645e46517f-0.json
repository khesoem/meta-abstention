urn;\n    \n    if (is_valid(value)) {\n        for (int i = 0; i <= 6; i++) {\n            ll v1 = ((counter2 + 1 - value * powers[i]) % MOD1 + MOD1) % MOD1;\n            int idx = lower_bound(vec[i].begin(), vec[i].end(), MOD1 - v1) - vec[i].begin();\n            ll contribution = (sum_arr[i] + (ll)vec[i].size() * v1 - (ll)MOD1 * (vec[i].size() - idx)) % MOD2;\n            answer = (answer + contribution) % MOD2;\n        }\n        counter2 += counter1;\n    } else {\n        if (length > 0) counter2++;\n        ll temp = ((counter2 - value) % MOD1 + MOD1) % MOD1;\n        answer = (answer + temp) % MOD2;\n        \n        for (int i = (length == 0 ? 1 : 0); i <= 9; i++) {\n            dfs2(length + 1, value * 10 + i);\n        }\n    }\n}\n\nint main() {\n    n = read();\n    counter1 = 0;\n    dfs1(0, 0);\n    \n    for (int i = 0; i <= 6; i++) {\n        sort(vec[i].begin(), vec[i].end());\n    }\n    \n    counter2 = 0;\n    answer = 0;\n    dfs2(0, 0);\n    \n    printf(\"%lld\\n\", answer);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long MOD1 = 998244353L;\n    static long MOD2 = 1000000007L;\n    static long n;\n    static long counter1, counter2, answer;\n    static long[] sum_arr = new long[10];\n    static ArrayList<Long>[] vec = new ArrayList[10];\n    static long[] powers = {1, 10, 100, 1000, 10000, 100000, 1000000};\n\n    static long read() throws IOException {\n        long x = 0;\n        int sign = 1;\n        int ch = System.in.read();\n        while (ch < '0' || ch > '9') {\n            if (ch == '-') sign = -1;\n            ch = System.in.read();\n        }\n        while (ch >= '0' && ch <= '9') {\n            x = x * 10 + (ch - '0');\n            ch = System.in.read();\n        }\n        return x * sign;\n    }\n\n    static void d