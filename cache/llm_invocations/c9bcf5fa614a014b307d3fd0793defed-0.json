\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            e[1] -= d\n            graph[e[0]][e[3]][1] += d\n            v = prevv[v]\n        if flow_needed is not None and res_flow == flow_needed:\n            break\n    return res_flow, res_cost\n\ndef add_edge(graph, fr, to, cap, cost):\n    # forward edge\n    graph[fr].append([to, cap, cost, len(graph[to])])\n    # backward edge\n    graph[to].append([fr, 0, -cost, len(graph[fr])-1])\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    src = [int(next(it))-1 for _ in range(K)]\n    roads = []\n    for _ in range(m):\n        x = int(next(it))-1\n        y = int(next(it))-1\n        roads.append((x, y))\n    # total nodes: n * M + 2 (source and sink)\n    sz = 0\n    # assign ids: id[i][j] = sz++\n    id = [[0]*M for _ in range(n)]\n    for i in range(n):\n        for j in range(M):\n            id[i][j] = sz\n            sz += 1\n    s = sz\n    t = sz + 1\n    total_nodes = sz + 2\n    graph = [[] for _ in range(total_nodes)]\n    # source to each source vertex at time 0\n    for i in range(K):\n        add_edge(graph, s, id[src[i]][0], 1, 0)\n    # from node 0 (destination) at each time to sink\n    for j in range(M):\n        add_edge(graph, id[0][j], t, K, C * j)\n    # within same vertex: from time j to j+1\n    for i in range(n):\n        for j in range(M-1):\n            add_edge(graph, id[i][j], id[i][j+1], K, 0)\n    # roads between vertices\n    for (x, y) in roads:\n        for j in range(M-1):\n            cost_mult = D\n            for k in range(K):\n                # cost = D * (2*k + 1)\n                c = cost_mult * (2*k + 1)\n                add_edge(graph, id[x][j], id[y][j+1], 1, c)\n                add_edge(graph, id[y][j], id[x][j+1], 1, c)\n    # compute min-cost flow from s to t (max flow is K)\n    flow, cost = min_cost_flow(total_nodes, graph, s, t)\n    # The C++ code prints only the cost (ans = max_flow returns cost, and prints flow via DBG)\n    # For exact output, we print cost (ans)\n    # DBG(res) is commented out, but it prints to stderr; we ignore.\n    print(cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -0.0011162485461682081, -0.002118725562468171, -3.576278118089249e-07, -0.12724310159683228, -0.49600863456726074, -0.00012361239350866526, -2.3841855067985307e-07, -0.00013016807497479022, -0.05007108300924301, -0.4479731321334839, -4.076874756719917e-05, -3.397406908334233e-05, -0.2018839716911316, -0.04860913008451462, -0.007622087839990854, -0.061069607734680176, -1.4305104514278355e-06, -5.829164365422912e-05, -0.1491236835718155, -0.02415710873901844, -1.311301275563892e-06, -0.003441841108724475, -0.2014661580324173, -7.152555099310121e-07, -2.3841855067985307e-07, -5.125986263010418e-06, -0.576839029788971, -1.3206273317337036, -0.0014142522122710943, -1.0609570381348021e-05, -0.0022754985839128494, -3.731181277544238e-05, -0.05316143482923508, -3.2305197237292305e-05, -0.00025197668583132327, -3.576278118089249e-07, -5.125986263010418e-06, -0.029679596424102783, -0.38912421464920044, -3.103564739227295, -0.013242626562714577, -0.006716414820402861, -2.3841855067985307e-07, -1.9609233140945435, -0.0035095547791570425, -0.1439468264579773, -0.0011960265692323446, -0.0010386077919974923, -9.536738616588991e-07, 0.0, -0.693381667137146, -5.755675792694092, -1.7086647748947144, -1.1920928244535389e-07, -0.4348483383655548, -0.0007502601947635412, -3.3378044463461265e-05, -0.49642014503479004, -0.8062502145767212, -0.2017918974161148, -1.31443190574646, -3.0517112463712692e-05, -0.6342071890830994, -0.004629489034414291, -0.2580886781215668, -0.23067735135555267, -0.004431427922099829, -0.00010740180005086586, -4.8040771484375, -0.011397724971175194, -0.0002673506969586015, -2.384185506798