{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nusing ll = long long;\nusing PII = pair<int, int>;\n\nconst int INF = 0x3f3f3f3f;\nconst int MAXN = 6555;\n\nstruct Edge {\n    int dest, cap, cost, reverse;\n    Edge(int d, int c, int cst, int r) : dest(d), cap(c), cost(cst), reverse(r) {}\n};\n\nstruct MinCostFlow {\n    int nodeCount;\n    int potential[MAXN + 5], distance[MAXN + 5], parentV[MAXN + 5], parentE[MAXN + 5];\n    vector<Edge> graph[MAXN + 5];\n\n    void setup(int n) {\n        nodeCount = n;\n        for (int i = 0; i <= n; ++i) graph[i].clear();\n    }\n\n    void connect(int u, int v, int capacity, int cost) {\n        graph[u].emplace_back(v, capacity, cost, (int)graph[v].size());\n        graph[v].emplace_back(u, 0, -cost, (int)graph[u].size() - 1);\n    }\n\n    int compute(int source, int target, int requiredFlow) {\n        int totalFlow = 0, totalExpense = 0;\n        memset(potential, 0, sizeof(potential));\n        while (requiredFlow > 0) {\n            priority_queue<PII, vector<PII>, greater<PII>> heap;\n            fill(distance, distance + nodeCount + 1, INF);\n            distance[source] = 0;\n            heap.emplace(0, source);\n            while (!heap.empty()) {\n                auto [d, u] = heap.top(); heap.pop();\n                if (d > distance[u]) continue;\n                for (int idx = 0; idx < graph[u].size(); ++idx) {\n                    auto& e = graph[u][idx];\n                    if (e.cap > 0 && distance[e.dest] > distance[u] + e.cost + potential[u] - potential[e.dest]) {\n                        distance[e.dest] = distance[u] + e.cost + potential[u] - potential[e.dest];\n                        parentV[e.dest] = u;\n                        parentE[e.dest] = idx;\n                        heap.emplace(distance[e.dest], e.dest);\n                    }\n                }\n            }\n            if (distance[target] == INF) break;\n            for (int i = 0; i <= nodeCount; ++i) potential[i] += distance[i];\n            int augment = requiredFlow;\n            for (int v = target; v != source; v = parentV[v])\n                augment = min(augment, graph[parentV[v]][parentE[v]].cap);\n            requiredFlow -= augment;\n            totalFlow += augment;\n            totalExpense += augment * potential[target];\n            for (int v = target; v != source; v = parentV[v]) {\n                auto& e = graph[parentV[v]][parentE[v]];\n                e.cap -= augment;\n                graph[v][e.reverse].cap += augment;\n            }\n        }\n        return totalExpense;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    MinCostFlow solver;\n    solver.setup(n * (n + 55) + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int u; cin >> u;\n        solver.connect(0, u, 1, 0);\n    }\n\n    vector<PII> edgeList(m);\n    for (int i = 0; i < m; ++i) {\n        cin >> edgeList[i].first >> edgeList[i].second;\n    }\n\n    int sink = n * (n + 55) + 1;\n    for (int t = 0; t < n + 54; ++t) {\n        for (const auto& e : edgeList) {\n            for (int j = 1; j <= k; ++j) {\n                int cost = c + d * (2 * j - 1);\n                solver.connect(e.first + t * n, e.second + (t + 1) * n, 1, cost);\n                solver.connect(e.second + t * n, e.first + (t + 1) * n, 1, cost);\n            }\n        }\n        for (int i = 2; i <= n; ++i) {\n            solver.connect(i + t * n, i + (t + 1) * n, k, c);\n        }\n        solver.connect(1 + t * n, sink, k, 0);\n    }\n\n    cout << solver.compute(0, sink, k) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\nfrom collections import defaultdict\n\nclass Edge:\n    __slots__ = ('dest', 'cap', 'cost', 'reverse')\n    def __init__(self, dest, cap, cost, reverse):\n        self.dest = dest\n        self.cap = cap\n        self.cost = cost\n        self.reverse = reverse\n\nclass MinCostFlow:\n    def __init__(self):\n        self.nodeCount = 0\n        self.graph = defaultdict(list)\n        self.potential = {}\n        self.distance = {}\n        self.parentV = {}\n        self.parentE = {}\n    \n    def setup(self, n):\n        self.nodeCount = n\n        self.graph = defaultdict(list)\n        self.potential = {}\n        self.distance = {}\n        self.parentV = {}\n        self.parentE = {}\n    \n    def connect(self, u, v, capacity, cost):\n        # Forward edge\n        forward_idx = len(self.graph[v])\n        reverse_idx = len(self.graph[u])\n        self.graph[u].append(Edge(v, capacity, cost, forward_idx))\n        # Backward edge\n        self.graph[v].append(Edge(u, 0, -cost, reverse_idx))\n    \n    def compute(self, source, target, requiredFlow):\n        totalFlow = 0\n        totalExpense = 0\n        \n        # Initialize potential\n        self.potential = {i: 0 for i in range(self.nodeCount + 1)}\n        \n        while requiredFlow > 0:\n            # Dijkstra's algorithm with priority queue\n            self.distance = {i: float('inf') for i in range(self.nodeCount + 1)}\n            self.distance[source] = 0\n            heap = [(0, source)]\n            \n            while heap:\n                d, u = heapq.heappop(heap)\n                if d > self.distance[u]:\n                    continue\n                for idx, e in enumerate(self.graph[u]):\n                    if e.cap > 0:\n                        new_dist = self.distance[u] + e.cost + self.potential.get(u, 0) - self.potential.get(e.dest, 0)\n                        if new_dist < self.distance[e.dest]:\n                            self.distance[e.dest] = new_dist\n                            self.parentV[e.dest] = u\n                            self.parentE[e.dest] = idx\n                            heapq.heappush(heap, (new_dist, e.dest))\n            \n            if self.distance.get(target, float('inf')) == float('inf'):\n                break\n            \n            # Update potential\n            for i in range(self.nodeCount + 1):\n                if i in self.distance:\n                    self.potential[i] = self.potential.get(i, 0) + self.distance[i]\n            \n            # Find augmenting path capacity\n            augment = requiredFlow\n            v = target\n            while v != source:\n                u = self.parentV[v]\n                idx = self.parentE[v]\n                augment = min(augment, self.graph[u][idx].cap)\n                v = u\n            \n            # Update flow\n            requiredFlow -= augment\n            totalFlow += augment\n            totalExpense += augment * self.potential.get(target, 0)\n            \n            # Update capacities\n            v = target\n            while v != source:\n                u = self.parentV[v]\n                idx = self.parentE[v]\n                e = self.graph[u][idx]\n                e.cap -= augment\n                rev_idx = e.reverse\n                self.graph[v][rev_idx].cap += augment\n                v = u\n        \n        return totalExpense\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    \n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    solver = MinCostFlow()\n    solver.setup(n * (n + 55) + 2)\n    \n    # Read sources\n    for _ in range(k):\n        u = int(input_data[idx]); idx += 1\n        solver.connect(0, u, 1, 0)\n    \n    # Read edges\n    edgeList = []\n    for _ in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        edgeList.append((u, v))\n    \n    sink = n * (n + 55) + 1\n    for t in range(n + 54):\n        for u, v in edgeList:\n            for j in range(1, k + 1):\n                cost = c + d * (2 * j - 1)\n                solver.connect(u + t * n, v + (t + 1) * n, 1, cost)\n                solver.connect(v + t * n, u + (t + 1) * n, 1, cost)\n        \n        for i in range(2, n + 1):\n            solver.connect(i + t * n, i + (t + 1) * n, k, c)\n        \n        solver.connect(1 + t * n, sink, k, 0)\n    \n    print(solver.compute(0, sink, k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00023684080224484205, -8.344646857949556e-07, -1.1920928244535389e-07, -0.00010895135346800089, -0.16058386862277985, -0.012544889003038406, -0.11282501369714737, -0.0003449321957305074, -0.25226423144340515, -9.83428253675811e-05, -0.030360395088791847, -4.768370445162873e-07, -0.00011002412065863609, -0.001158996019512415, -0.9319037199020386, -0.0010888606775552034, -3.576278118089249e-07, -1.19209282