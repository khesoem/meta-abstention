 = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exponent /= 2;\n    }\n    return result;\n}\n\nint main() {\n    long long p, k;\n    cin >> p >> k;\n    long long MOD = 1000000007;\n    long long result = 0;\n    if (k == 0) {\n        result = opow(p, p - 1, MOD);\n    } else {\n        for (long long i = 1; i < p; i++) {\n            if ((p - 1) % i == 0 && opow(k, i, p) == 1) {\n                result = opow(p, (p - 1) / i, MOD);\n                if (k == 1) {\n                    result = (result * p) % MOD;\n                }\n                break;\n            }\n        }\n    }\n    cout << result << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.11782301752828e-05, -1.7881377516459906e-06, -2.3841855067985307e-07, -7.390948667307384e-06, -3.576278118089249e-07, -6.198863957251888e-06, -3.2186455882765586e-06, -0.142680361866951, -4.887569048150908e-06, -0.6416600942611694, -0.005234109237790108, -0.38693496584892273, -1.5616295058862306e-05, -4.0531076592742465e-06, -7.152555099310121e-07, -0.0004987664869986475, -3.4570634852570947e-06, -0.018240565434098244, -2.3841855067985307e-07, -7.867782187531702e-06, -3.576272320060525e-06, -1.3351351299206726e-05, -1.1920928244535389e-07, -9.536738616588991e-07, -1.0728830375228426e-06, 0.0, 0.0, -0.0006295844214037061, -1.4305104514278355e-06, -7.152555099310121e-07, -5.960462772236497e-07, -3.576278118089249e-07, -3.576278118089249e-07, -8.344646857949556e-07, -1.0728830375228426e-06, -1.311301275563892e-06, 0.0, 0.0, -1.1920928244535389e-07, -5.245195097813848e-06, -5.328513361746445e-05, -5.602820692729438e-06, -1.1444026313256472e-05, -4.768370445162873e-07, 0.0, -2.145764938177308e-06, 0.0, -7.152555099310121e-07, -5.960462772236497e-07, -0.00013791563105769455, -4.291525328881107e-06, -5.006777428206988e-06, 0.0, 0.0, 0.0, -5.483612312673358e-06, -0.00016723664884921163, -2.145764938177308e-06, -5.960462772236497e-0