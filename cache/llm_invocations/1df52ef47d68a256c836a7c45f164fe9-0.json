h_back(cap_);\n        cost[fr].push_back(cost_);\n        to[to_].push_back(fr);\n        rev[to_].push_back(to[fr].size() - 1);\n        cap[to_].push_back(0);\n        cost[to_].push_back(-cost_);\n        return m;\n    }\n\n    struct Edge {\n        int fr, to;\n        ll cap, flow, cost;\n        Edge(int fr, int to, ll cap, ll flow, ll cost) : fr(fr), to(to), cap(cap), flow(flow), cost(cost) {}\n    };\n\n    Edge get_edge(int i) {\n        int fr = pos[i].first;\n        int idx = pos[i].second;\n        int to_ = to[fr][idx];\n        int rev_idx = rev[fr][idx];\n        ll cap_ = cap[fr][idx];\n        ll rev_cap = cap[to_][rev_idx];\n        ll cost_ = cost[fr][idx];\n        return Edge(fr, to_, cap_ + rev_cap, rev_cap, cost_);\n    }\n\n    vector<Edge> edges() {\n        vector<Edge> res;\n        for (int i = 0; i < (int)pos.size(); i++) {\n            int fr = pos[i].first;\n            int idx = pos[i].second;\n            int to_ = to[fr][idx];\n            int rev_idx = rev[fr][idx];\n            ll cap_ = cap[fr][idx];\n            ll rev_cap = cap[to_][rev_idx];\n            ll cost_ = cost[fr][idx];\n            res.emplace_back(fr, to_, cap_ + rev_cap, rev_cap, cost_);\n        }\n        return res;\n    }\n\n    bool _dual_ref(int s, int t) {\n        const ll INF = 1e18;\n        vector<ll> dist(n, INF);\n        vector<int> pv(n, -1), pe(n, -1);\n        vector<bool> vis(n, false);\n        dist[s] = 0;\n        priority_queue<pair<ll,int>, vector<pair<ll,int>>, greater<pair<ll,int>>> pq;\n        pq.push(make_pair(0, s));\n        while (!pq.empty()) {\n            pair<ll,int> top = pq.top(); pq.pop();\n            ll d = top.first;\n            int v = top.second;\n            if (vis[v]) continue;\n            vis[v] = true;\n            if (v == t) break;\n            for (int i = 0; i < (int)to[v].size(); i++) {\n                if (vis[to[v][i]] || cap[v][i] == 0) continue;\n                ll nd = d + cost[v][i] - dual[to[v][i]] + dual[v];\n                if (dist[to[v][i]] > nd) {\n                    dist[to[v][i]] = nd;\n                    pv[to[v][i]] = v;\n                    pe[to[v][i]] = i;\n                    pq.push(make_pair(nd, to[v][i]));\n                }\n            }\n        }\n        if (!vis[t]) return false;\n        for (int v = 0; v < n; v++) {\n            if (vis[v]) {\n                dual[v] -= dist[t] - dist[v];\n            }\n        }\n        this->pv = pv;\n        this->pe = pe;\n        return true;\n    }\n\n    vector<pair<ll,ll>> slope(int s, int t, ll flow_limit = 1e18) {\n        dual.assign(n, 0);\n        ll flow = 0, cost = 0;\n        ll prev_cost = -1;\n        vector<pair<ll,ll>> result;\n        result.push_back(make_pair(flow, cost));\n        while (flow < flow_limit) {\n            if (!_dual_ref(s, t)) break;\n            ll c = flow_limit - flow;\n            int v = t;\n            while (v != s) {\n                c = min(c, cap[pv[v]][pe[v]]);\n                v = pv[v];\n            }\n            v = t;\n            while (v != s) {\n                int idx = pe[v];\n                cap[pv[v]][idx] -= c;\n                int rev_idx = rev[pv[v]][idx];\n                cap[v][rev_idx] += c;\n                v = pv[v];\n            }\n            ll d = -dual[s];\n            flow += c;\n            cost += c * d;\n            if (prev_cost == d) {\n                result.pop_back();\n            }\n            result.push_back(make_pair(flow, cost));\n            prev_cost = d;\n        }\n        return result;\n    }\n\n    pair<ll,ll> flow(int s, int t, ll flow_limit = 1e18) {\n        vector<pair<ll,ll>> res = slope(s, t, flow_limit);\n        return res.back();\n    }\n};\n\nint main() {\n    int n;\n    cin >> n;\n    ll a1, a2, a3, b1, b2, b3;\n    cin >> a1 >> a2 >> a3;\n    cin >> b1 >> b2 >> b3;\n\n    MCFGraph g(8);\n    g.add_edge(0, 1, a1, 0);\n    g.add_edge(0, 2, a2, 0);\n    g.add_edge(0, 3, a3, 0);\n    g.add_edge