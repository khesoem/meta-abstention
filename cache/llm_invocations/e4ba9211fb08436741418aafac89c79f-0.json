n            result = (result * fast_pow(k, sz[i], p)) % MOD;\n        }\n    }\n    \n    cout << result;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n\n    static long fast_pow(long b, long e, long m) {\n        long res = 1;\n        b %= m;\n        while (e > 0) {\n            if ((e & 1) == 1) res = (res * b) % m;\n            b = (b * b) % m;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner cin = new Scanner(System.in);\n        \n        int p = cin.nextInt();\n        int k = cin.nextInt();\n        \n        if (k == 0) {\n            System.out.println(fast_pow(p, p - 1, MOD));\n            return;\n        }\n        \n        int[] dsu = new int[p];\n        int[] sz = new int[p];\n        for (int i = 0; i < p; ++i) {\n            dsu[i] = i;\n            sz[i] = 1;\n        }\n        \n        java.util.function.Function<Integer, Integer> find = new java.util.function.Function<Integer, Integer>() {\n            @Override\n            public Integer apply(Integer x) {\n                if (dsu[x] == x) return x;\n                dsu[x] = apply(dsu[x]);\n                return dsu[x];\n            }\n        };\n        \n        java.util.function.BiConsumer<Integer, Integer> join = new java.util.function.BiConsumer<Integer, Integer>() {\n            @Override\n            public void accept(Integer x, Integer y) {\n                x = apply(x);\n                y = apply(y);\n                if (x != y) {\n                    dsu[y] = x;\n                    sz[x] += sz[y];\n                }\n            }\n        };\n        \n        for (int i = 0; i < p; ++i) {\n            join.accept((int)((1L * k * i) % p), i);\n        }\n        \n        long res