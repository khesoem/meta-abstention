;\n    }\n\n    int m = min(len(goods), k);\n    loop(step, 0, m) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int idx : goods) {\n                if (mask & (1 << idx)) continue;\n                dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / s[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    loop(i, 0, n) {\n        if (!ok[i]) {\n            cout << fixed << setprecision(12) << 0.0 << \"\\n\";\n        } else {\n            T res = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    res += dp[cur][mask];\n            }\n            cout << fixed << setprecision(12) << (double)res << \"\\n\";\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << fixed << setprecision(6) << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        while (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            solve(n, sc);\n        }\n    }\n\n    static void solve(int n, Scanner sc) {\n        int k = sc.nextInt();\n        double[] p = new double[n];\n        for (int i = 0; i < n; ++i) {\n            p[i] = sc.nextDouble();\n        }\n\n        double[][] dp = new double[2][1 << n];\n        for (int i = 0; i < 2; ++i) {\n            Arrays.fill(dp[i], 0.0);\n        }\n\n        boolean[] ok = new boolean[n];\n        List<Integer> goods = new ArrayList<>();\n        for (int i = 0; i < n; ++i) {\n            if (p[i] != 0) {\n                ok[i] = true;\n                goods.add(i);\n            }\n        }\n\n        dp[0][0] = 1.0;\n        int cur = 1;\n\n        double[] s = new double[1 << n];\n        s[0] = 1.0;\n        for (int mask = 1; mask < (1 << n); ++mask) {\n            int bit = Integer.numberOfTrailingZeros(mask);\n            s[mask] = s[mask ^ (1 << bit)] - p[bit];\n        }\n\n        int m = Math.min(goods.size(), k);\n        for (int step = 0; step < m; ++step) {\n            Arrays.fill(dp[cur], 0.0);\n\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (Integer.bitCount(mask) != step) continue;\n\n                for (int idx : goods) {\n                    if ((mask & (1 << idx)) != 0) continue;\n                    dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / s[mask];\n                }\n            }\n\n            cur ^= 1;\n        }\n\n        cur ^= 1;\n        for (int i = 0; i < n; ++i) {\n            if (!ok[i]) {\n                System.out.printf(\"%.12f%n\", 0.0);\n            } else {\n                double res = 0.0;\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    if ((mask & (1 << i)) != 0) {\n                        res += dp[cur][mask];\n                    }\n                }\n                System.out.printf(\"%.12f%n\", res);\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017998983094003052, -2.0265558760002023e-06, -9.536738616588991e-07, -0.0008945039589889348, -6.186770770000294e-05, -0.5244264006614685, -0.023260004818439484, -1.3232143828645349e-05, -2.5629668016335927e-05, -0.023591071367263794, -0.38692396879196167, -0.000590865034610033, -8.344646857949556e-07, -5.221230458118953e-05