em.in));\n             PrintWriter pw = new PrintWriter(System.out)) {\n            \n            String token = br.readLine().trim();\n            char[] s = token.toCharArray();\n            int ans = 0;\n\n            if (s.length == 1) {\n                if (s[0] == '0' || s[0] == '_' || s[0] == 'X') {\n                    ans = 1;\n                }\n            } else {\n                int n = s.length;\n                if (!(s[n - 1] == 'X' && s[n - 2] == 'X')) {\n                    // put 25\n                    if (canPut(s, n - 1, '5') && canPut(s, n - 2, '2')) {\n                        char[] s1 = s.clone();\n                        put(s1, n - 1, '5');\n                        put(s1, n - 2, '2');\n                        ans += possible(s1);\n                    }\n                    // put 50\n                    if (canPut(s, n - 1, '0') && canPut(s, n - 2, '5')) {\n                        char[] s1 = s.clone();\n                        put(s1, n - 1, '0');\n                        put(s1, n - 2, '5');\n                        ans += possible(s1);\n                    }\n                    // put 75\n                    if (canPut(s, n - 1, '5') && canPut(s, n - 2, '7')) {\n                        char[] s1 = s.clone();\n                        put(s1, n - 1, '5');\n                        put(s1, n - 2, '7');\n                        ans += possible(s1);\n                    }\n                }\n                // put 00\n                if (s[n - 1] == 'X' && s[n - 2] == 'X') {\n                    char[] s1 = s.clone();\n                    put(s1, n - 1, '0');\n                    ans += possible(s1);\n                } else if (canPut(s, n - 1, '0') && canPut(s, n - 2, '0')) {\n                    char[] s1 = s.clone();\n                    put(s1, n - 1, '0');\n                    put(s1, n - 2, '0');\n                    ans += possible(s1);\n                }\n            }\n            pw.println(ans);\n        }\n    }\n\n    private static boolean canPut(char[] s, int p, char d) {\n        return s[p] == 'X' || s[p] == '_' || s[p] == d;\n    }\n\n    private static void put(char[] s, int p, char d) {\n        if (s[p] == 'X') {\n            replace(s, d);\n        } else {\n            s[p] = d;\n        }\n    }\n\n    private static void replace(char[] s, char d) {\n        for (int i = 0; i < s.length; i++) {\n            if (s[i] == 'X') {\n                s[i] = d;\n            }\n        }\n    }\n\n    private static int possible(char[] s) {\n        int p = 1;\n\n        if (s[0] == '0') {\n            return 0;\n        }\n        if (s[0] == '_') {\n            p *= 9;\n        }\n        for (int i = 1; i < s.length; i++) {\n            if (s[i] == '_') {\n                p *= 10;\n            }\n        }\n\n        return p;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class P1575D {\n    public static void main(String[] args) throws IOException {\n        try (BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n             PrintWriter pw = new PrintWriter(System.out)) {\n            \n            String token = br.readLine().trim();\n            char[] s = token.toCharArray();\n            long ans = 0;\n\n            if (s.length == 1) {\n                if (s[0] == '0' || s[0] == '_' || s[0] == 'X') {\n                    ans = 1;\n                }\n            } else {\n                int n = s.length;\n                \n                // Try all valid endings for divisibility by 25: 00, 25, 50, 75\n                String[] endings = {\"00\", \"25\", \"50\", \"75\"};\n                \n                for (String end : endings) {\n                    char last1 = end.charAt(0);\n                    char last2 = end.charAt(1);\n                    \n                    // Check if 