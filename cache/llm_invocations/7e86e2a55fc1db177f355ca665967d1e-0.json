; i <= max; i++) {\n        fac[i] = (fac[i - 1] * i) % MOD;\n        invFac[i] = modExp(fac[i], MOD - 2);\n    }\n}\n\nlong long nCr(int r, int n) {\n    return (fac[n] * invFac[r] % MOD) * invFac[n - r] % MOD;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    int N, K;\n    iss >> N >> K;\n    \n    if (K >= N) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    int C = N - K;\n    precomputeFactorials(200000);\n    \n    long long result = modExp(C, N);\n    for (int i = 1; i < C; i++) {\n        long long term = modExp(C - i, N);\n        term = (term * nCr(i, C)) % MOD;\n        if (i % 2 == 1) {\n            result = (result - term + MOD) % MOD;\n        } else {\n            result = (result + term) % MOD;\n        }\n    }\n    result = (result * nCr(C, N)) % MOD;\n    if (K > 0) {\n        result = (2 * result) % MOD;\n    }\n    cout << result << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015186110977083445, -4.887569048150908e-06, -7.152555099310121e-07, -0.0008702066843397915, -2.3841855067985307e-07, -0.000285584683297202, -9.65590606938349e-06, -1.6689286894688848e-06, -2.3841855067985307e-07, -0.09857618063688278, -8.702239938429557e-06, -8.5588610090781e-05, -2.7418097943154862e-06, -0.03077743761241436, -2.145764938177308e-06, -0.0005536930402740836, -1.9311717551317997e-05, -0.0007773000397719443, -0.018152419477701187, -0.2519609034061432, -4.768370445162873e-07, -0.11425638943910599, -0.42870330810546875, -0.05492755398154259, -1.5258672647178173e-05, -4.0531076592742465e-06, -1.1920922133867862e-06, -0.0019766809418797493, -5.125986263010418e-06, -8.4638240878121e-06, -3.814689989667386e-06, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1205610462639015e-05, -5.960462772236497e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -0.7829021215438843, -0.048588238656520