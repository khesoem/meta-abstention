  long ans = 1;\n        for (int i = 1; i <= n; i++) {\n            ans = (ans * i) % MOD;\n        }\n        return ans;\n    }\n\n    // Precomputed all permutations of [1,2,3,4,5,6]\n    static List<int[]> perms = new ArrayList<>();\n\n    static void generatePermutations(int[] arr, int idx) {\n        if (idx == arr.length) {\n            perms.add(arr.clone());\n            return;\n        }\n        for (int i = idx; i < arr.length; i++) {\n            swap(arr, idx, i);\n            generatePermutations(arr, idx + 1);\n            swap(arr, idx, i);\n        }\n    }\n\n    static void swap(int[] a, int i, int j) {\n        int t = a[i];\n        a[i] = a[j];\n        a[j] = t;\n    }\n\n    static void solve() throws IOException {\n        // Generate permutations once\n        if (perms.isEmpty()) {\n            int[] base = {1, 2, 3, 4, 5, 6};\n            generatePermutations(base, 0);\n        }\n\n        // t = 1 (single test case)\n        int n = nextInt();\n        int a1 = nextInt(), a2 = nextInt(), a3 = nextInt();\n        int b1 = nextInt(), b2 = nextInt(), b3 = nextInt();\n\n        int mx = Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n        int temp = 0;\n\n        for (int[] per : perms) {\n            int ta1 = a1, ta2 = a2, ta3 = a3;\n            int tb1 = b1, tb2 = b2, tb3 = b3;\n            int tmx = 0;\n\n            for (int el : per) {\n                if (el == 1) {\n                    int t1 = Math.min(ta1, tb1);\n                    ta1 -= t1;\n                    tb1 -= t1;\n                    tmx += t1;\n                } else if (el == 2) {\n                    int t1 = Math.min(ta1, tb3);\n                    ta1 -= t1;\n                    tb3 -= t1;\n                    tmx += t1;\n                } else if (el == 3) {\n                    int t1 = Math.min(ta2, tb2);\n                    ta2 -= t1;\n                    tb2 -= t1;\n                    tmx += t1;\n                } else if (el == 4) {\n       