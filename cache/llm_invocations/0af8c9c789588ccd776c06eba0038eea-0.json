       ans %= MOD;\n            }\n            p >>= 1;\n            a *= a;\n            a %= MOD;\n        }\n        return ans;\n    }\n\n    private static long facCal(int n) {\n        long ans = 1;\n        for (int i = 1; i <= n; i++) {\n            ans *= i;\n            ans %= MOD;\n        }\n        return ans;\n    }\n\n    private static void solve() throws IOException {\n        int t = 1;\n\n        // Generate all permutations of numbers 1 through 6\n        List<List<Integer>> perms = new ArrayList<>();\n        List<Integer> nums = Arrays.asList(1, 2, 3, 4, 5, 6);\n        permute(nums, 0, perms);\n\n        int n = giveInt();\n        int[] arr1 = giveList();\n        int[] arr2 = giveList();\n        int a1 = arr1[0], a2 = arr1[1], a3 = arr1[2];\n        int b1 = arr2[0], b2 = arr2[1], b3 = arr2[2];\n\n        int mx = Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n        int temp = 0;\n\n        for (List<Integer> per : perms) {\n            int ta1 = a1, ta2 = a2, ta3 = a3;\n            int tb1 = b1, tb2 = b2, tb3 = b3;\n            int tmx = 0;\n            for (int el : per) {\n                int t1;\n                if (el == 1) {\n                    t1 = Math.min(ta1, tb1);\n                    ta1 -= t1;\n                    tb1 -= t1;\n                    tmx += t1;\n                } else if (el == 2) {\n                    t1 = Math.min(ta1, tb3);\n                    ta1 -= t1;\n                    tb3 -= t1;\n                    tmx += t1;\n                } else if (el == 3) {\n                    t1 = Math.min(ta2, tb2);\n                    ta2 -= t1;\n                    tb2 -= t1;\n                    tmx += t1;\n                } else if (el == 4) {\n                    t1 = Math.min(ta2, tb1);\n                    tb1 -= t1;\n                    ta2 -= t1;\n                    tmx += t1;\n                } else if (el == 5) {\n                    t1 = Math.min(ta3, tb3);\n                    ta3 -= t1;\n                    tb3 -= t1;\n                    tmx += t1;\n                } else if (el == 6) {\n                    t1 = Math.min(ta3, tb2);\n                    tb2 -= t1;\n                    ta3 -= t1;\n                    tmx += t1;\n                }\n            }\n            temp = Math.max(temp, tmx);\n        }\n        fout.print((n - temp) + \" \");\n        fout.println(mx);\n    }\n\n    private static void heyYashwant() throws IOException {\n        try {\n            int t = 1;\n            // t = giveInt();\n            for (int i = 0; i < t; i++) {\n                solve();\n            }\n        } finally {\n            fin.close();\n            fout.close();\n        }\n    }\n\n    private static void permute(List<Integer> arr, int k, List<List<Integer>> result) {\n        for (int i = k; i < arr.size(); i++) {\n            Collections.swap(arr, i, k);\n            permute(arr, k + 1, result);\n            Collections.swap(arr, k, i);\n        }\n        if (k == arr.size() - 1) {\n            result.add(new ArrayList<>(arr));\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        fin = new BufferedReader(new InputStreamReader(System.in));\n        fout = new PrintWriter(new OutputStreamWriter(System.out));\n        heyYashwant();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.7683704e-07, 0.0, 0.0, -3.397407e-05, -2.6344906e-05, -2.0265559e-06, -0.16027448, -0.0015294771, 0.0, 0.0, -0.0011875727, -0.20155962, -1.8358061e-05, 0.0, -0.011399965, -0.0142755695, -0.006750753, -0.7768512, -0.02805978, -0.25407222, -0.0024912294, -8.344647e-07, -3.2186456e-06, -0.038679503, -0.00033551786, -5.245195e-06, 0.0, -0.0052830847, -0.0067187827, -0.0020647177, -0.34298837, -0.032453105, -6.198864e-06, -0.0016674199, -2.4079987e-05, -2.7894584e-05, -6.544376e-05, -2.3841855e-07, -0.00861854, -3.576278e-07, -1.1920928e-07, -0.5763757, -6.198864e-06, -4.340154, -8.106199e-06, -0.033