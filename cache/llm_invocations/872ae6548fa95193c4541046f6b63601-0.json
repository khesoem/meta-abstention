{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <cmath>\n#include <limits>\n#include <cmath>\n\nusing namespace std;\n\nlong long my_gcd(long long a, long long b) {\n    a = llabs(a);\n    b = llabs(b);\n    while (b) {\n        long long temp = b;\n        b = a % b;\n        a = temp;\n    }\n    return a ? a : 1;\n}\n\nlong long my_lcm(long long a, long long b) {\n    return a / my_gcd(a, b) * b;\n}\n\nint main() {\n    long long x, y, n;\n    cin >> x >> y >> n;\n    \n    if (y <= n) {\n        long long g = my_gcd(x, y);\n        while (g != 1) {\n            x /= g;\n            y /= g;\n            g = my_gcd(x, y);\n        }\n        cout << x << \"/\" << y;\n        return 0;\n    }\n    \n    long long best_numer = 1, best_denom = 1;\n    double min_err = numeric_limits<double>::max();\n    \n    for (long long i = 1; i <= n; i++) {\n        long long L = my_lcm(i, y);\n        long long target = x * (L / y);\n        long long unit = L / i;\n        \n        // Floor approximation\n        long long q_floor = target / unit;\n        long long approx_floor = q_floor * unit;\n        double err_floor = abs(target - approx_floor) / (double)L;\n        \n        if (err_floor < min_err) {\n            min_err = err_floor;\n            best_numer = q_floor;\n            best_denom = i;\n        }\n        \n        // Ceiling approximation\n        long long q_ceil = (target + unit - 1) / unit;\n        long long approx_ceil = q_ceil * unit;\n        double err_ceil = abs(target - approx_ceil) / (double)L;\n        \n        if (err_ceil < min_err) {\n            min_err = err_ceil;\n            best_numer = q_ceil;\n            best_denom = i;\n        }\n    }\n    \n    long long g = my_gcd(best_numer, best_denom);\n    best_numer /= g;\n    best_denom /= g;\n    \n    cout << best_numer << \"/\" << best_denom;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nimport sys\n\ndef my_gcd(a, b):\n    a = abs(a)\n    b = abs(b)\n    while b:\n        temp = b\n        b = a % b\n        a = temp\n    return a if a else 1\n\ndef my_lcm(a, b):\n    return a // my_gcd(a, b) * b\n\ndef main():\n    data = sys.stdin.read().split()\n    x = int(data[0])\n    y = int(data[1])\n    n = int(data[2])\n    \n    if y <= n:\n        g = my_gcd(x, y)\n        while g != 1:\n            x //= g\n            y //= g\n            g = my_gcd(x, y)\n        print(f\"{x}/{y}\")\n        return\n    \n    best_numer = 1\n    best_denom = 1\n    min_err = float('inf')\n    \n    for i in range(1, n + 1):\n        L = my_lcm(i, y)\n        target = x * (L // y)\n        unit = L // i\n        \n        # Floor approximation\n        q_floor = target // unit\n        approx_floor = q_floor * unit\n        err_floor = abs(target - approx_floor) / L\n        \n        if err_floor < min_err:\n            min_err = err_floor\n            best_numer = q_floor\n            best_denom = i\n        \n        # Ceiling approximation\n        q_ceil = (target + unit - 1) // unit\n        approx_ceil = q_ceil * unit\n        err_ceil = abs(target - approx_ceil) / L\n        \n        if err_ceil < min_err:\n            min_err = err_ceil\n            best_numer = q_ceil\n            best_denom = i\n    \n    g = my_gcd(best_numer, best_denom)\n    best_numer //= g\n    best_denom //= g\n    \n    print(f\"{best_numer}/{best_denom}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018451895448379219, -8.344646857949556e-07, -1.1920928244535389e-07, -0.00013386306818574667, -0.023289471864700317, -0.07890550047159195, -0.020556848496198654, -0.0003500564198475331, -5.173549288883805e-05, -3.933898824470816e-06, -1.823885577323381e-05, -1.0728830375228426e-06, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -4.172316494077677e-06, -6.794906312279636e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -7.390703103737906e-05, 0.0, -2.3841855067985307e-07, -9.536738616588991e-07, -2.2649508537142538e-05, -1.6927575416048057e-05, -7.271740287251305e-06, -1.5497195136049413e-06, -2.3841855067985307e-07, 0.0, -9.536738616588991e-07, -1.1920922133867862e-06, -1.9907753085135482e-05, -2.3841855067985307e-07, -0.06199551373720169, 0.0, 0.0, -8.344646857949556e-07, 0.0, -7.152555099310121e-07, 0.0, -3.576278118089249e-07, 0.0, -1.6689286894688848e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -6.3774932641536e-05, 0.0, -3.099436753473128e-06, -3.4570634852570947e-06, -4.768370445162873e-07, -4.768370445162873e-07, -5.364403477869928e-06, -4.768370445162873e-07, -1.1920928244535389e-07, -0.0036041084676980972, 0.0, -1.1920928244535389e-07, -7.152555099310121e-07, 0.0, -5.483612312673358e-06, -8.344646857949556e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -4.6491513785440475e-06, -2.3841855067985307e-07, -5.364403477869928e-06, -0.00031680811662226915, -2.3841855067985307e-07, -4.625213477993384e-05, -4.768370445162873e-07, -4.76