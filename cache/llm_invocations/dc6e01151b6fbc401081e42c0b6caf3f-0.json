mport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] tokens = br.readLine().split(\" \");\n        int N = Integer.parseInt(tokens[0]);\n        int K = Integer.parseInt(tokens[1]);\n        long l = Long.parseLong(tokens[2]);\n        br.close();\n        \n        long MOD = 998244353;\n        \n        long invL = modInverse(l, MOD);\n        long[] inv = new long[5005];\n        for (int i = 1; i < 5005; i++) {\n            inv[i] = modInverse(i, MOD);\n        }\n        \n        long[] pow = new long[5005];\n        pow[0] = 1;\n        for (int i = 1; i < 5005; i++) {\n            pow[i] = (pow[i-1] * l) % MOD;\n        }\n        \n        long invL2 = (invL * invL) % MOD;\n        long res = 0;\n        \n        long[] poly = new long[]{l, -1};\n        long[] other = new long[]{(l * l) % MOD, (-2 * l) % MOD, 2};\n        long[] cur = new long[4050];\n        cur[0] = 1;\n        \n        for (int i = 0; i < N; i++) {\n            long[] next = new long[cur.length];\n            for (int j = 0; j < cur.length - 1; j++) {\n                next[j] = (next[j] + cur[j] * poly[0]) % MOD;\n                next[j+1] = (next[j+1] + cur[j] * poly[1]) % MOD;\n            }\n            cur = next;\n        }\n        \n        long comb = 1;\n        for (int i = N; i >= K; i--) {\n            long now = 0;\n            for (int j = 0; j < cur.length; j++) {\n                now = (now + (pow[j+1] * inv[j+1]) % MOD * cur[j]) % MOD;\n            }\n            now = (now * modPow(2, i, MOD)) % MOD;\n            now = (now * comb) % MOD;\n            res = (res + now) % MOD;\n            \n            long[] newCur = new long[cur.length];\n            for (int j = 0; j < cur.length; j++) {\n                newCur[j] = (cur[j] * other[0]) % MOD;\n                for (int k = 1; k <= 2; k++) {\n                    if (j >= k) {\n                        newCur[j] = (newCur[j] + cur[j-k] * other[k]) % MOD;\n                    }\n                }\n            }\n            cur = newCur;\n            \n            long val = cur[cur.length - 1];\n            for (int j = cur.length - 1; j >= 1; j--) {\n                cur[j] = (-val + MOD) % MOD;\n                val = (cur[j-1] + l * val) % MOD;\n            }\n            for (int j = 0; j < cur.length - 1; j++) {\n                cur[j] = (j + 2 < cur.length) ? cur[j+2] : 0;\n            }\n            \n            comb = (comb * inv[N - i + 1]) % MOD;\n            comb = (comb * i) % MOD;\n        }\n        \n        res = (res * modPow(invL2, N, MOD)) % MOD;\n        \n        System.out.println(res);\n    }\n    \n    private static long modPow(long base, long exp, long mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n    \n    private static long modInverse(long a, long mod) {\n        long[] gcd = extendedGCD(a, mod);\n        return (gcd[1] % mod + mod) % mod;\n    }\n    \n    private static long[] extendedGCD(long a, long b) {\n        if (a == 0) {\n            return new long[]{b, 0, 1};\n        }\n        long[] next = extendedGCD(b % a, a);\n        long tempX = next[1];\n        next[1] = next[2] - (b / a) * next[1];\n        next[2] = tempX;\n        return next;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] to