{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nconst int N = 1000007;\nconst int SOURCE = N - 2;\nconst int TARGET = N - 1;\nconst ll INF = (ll)1e18;\n\nint head[N], tail[N];\nvector<int> to, capacity, flow, cost, nxt;\nll dist[N];\nint pred[N], pe[N];\nbool inq[N];\nll answer = 0;\n\nvoid initGraph() {\n    fill(head, head + N, -1);\n    fill(tail, tail + N, -1);\n}\n\nint residual(int id) {\n    return capacity[id] - flow[id];\n}\n\nvoid addEdge(int u, int v, int cap, int costValue) {\n    int id = (int)to.size();\n    to.push_back(v);\n    capacity.push_back(cap);\n    flow.push_back(0);\n    cost.push_back(costValue);\n    nxt.push_back(-1);\n    if (head[u] == -1) head[u] = id;\n    else nxt[tail[u]] = id;\n    tail[u] = id;\n\n    int rid = (int)to.size();\n    to.push_back(u);\n    capacity.push_back(0);\n    flow.push_back(0);\n    cost.push_back(-costValue);\n    nxt.push_back(-1);\n    if (head[v] == -1) head[v] = rid;\n    else nxt[tail[v]] = rid;\n    tail[v] = rid;\n}\n\nvoid pushFlow() {\n    fill(dist, dist + N, INF);\n    fill(pred, pred + N, -1);\n    fill(pe, pe + N, -1);\n    fill(inq, inq + N, false);\n\n    queue<int> q;\n    dist[SOURCE] = 0;\n    q.push(SOURCE);\n    inq[SOURCE] = true;\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inq[u] = false;\n        for (int id = head[u]; id != -1; id = nxt[id]) {\n            if (residual(id) == 0) continue;\n            int v = to[id];\n            ll nd = dist[u] + cost[id];\n            if (dist[v] > nd) {\n                dist[v] = nd;\n                pred[v] = u;\n                pe[v] = id;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n\n    for (int cur = TARGET; cur != SOURCE; cur = pred[cur]) {\n        int id = pe[cur];\n        flow[id]++;\n        flow[id ^ 1]--;\n    }\n    answer += dist[TARGET];\n}\n\nint main() {\n    initGraph();\n\n    int n, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        --x;\n        addEdge(SOURCE, x, 1, 0);\n    }\n\n    const int LAYERS = 101;\n    for (int t = 0; t < LAYERS; ++t) {\n        addEdge(t * n, TARGET, k, t * c);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        scanf(\"%d %d\", &x, &y);\n        --x; --y;\n        for (int t = 0; t < LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n        for (int t = 0; t < LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n\n    for (int v = 0; v < n; ++v) {\n        for (int t = 0; t < LAYERS - 1; ++t) {\n            addEdge(v + t * n, v + t * n + n, k, 0);\n        }\n    }\n\n    for (int i = 0; i < k; ++i) pushFlow();\n\n    printf(\"%lld\\n\", answer);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nN = 1000007\nSOURCE = N - 2\nTARGET = N - 1\nINF = 10**18\n\nhead = [-1] * N\ntail = [-1] * N\nto = []\ncapacity = []\nflow = []\ncost = []\nnxt = []\ndist = [INF] * N\npred = [-1] * N\npe = [-1] * N\ninq = [False] * N\nanswer = 0\n\ndef residual(id):\n    return capacity[id] - flow[id]\n\ndef add_edge(u, v, cap, cost_value):\n    global to, capacity, flow, cost, nxt, head, tail\n    id = len(to)\n    to.append(v)\n    capacity.append(cap)\n    flow.append(0)\n    cost.append(cost_value)\n    nxt.append(-1)\n    if head[u] == -1:\n        head[u] = id\n    else:\n        nxt[tail[u]] = id\n    tail[u] = id\n\n    rid = len(to)\n    to.append(u)\n    capacity.append(0)\n    flow.append(0)\n    cost.append(-cost_value)\n    nxt.append(-1)\n    if head[v] == -1:\n        head[v] = rid\n    else:\n        nxt[tail[v]] = rid\n    tail[v] = rid\n\ndef push_flow():\n    global dist, pred, pe, inq, answer\n    dist = [INF] * N\n    pred = [-1] * N\n    pe = [-1] * N\n    inq = [False] * N\n\n    q = deque()\n    dist[SOURCE] = 0\n    q.append(SOURCE)\n    inq[SOURCE] = True\n\n    while q:\n        u = q.popleft()\n        inq[u] = False\n        id = head[u]\n        while id != -1:\n            if residual(id) > 0:\n                v = to[id]\n                nd = dist[u] + cost[id]\n                if dist[v] > nd:\n                    dist[v] = nd\n                    pred[v] = u\n                    pe[v] = id\n                    if not inq[v]:\n                        inq[v] = True\n                        q.append(v)\n            id = nxt[id]\n\n    cur = TARGET\n    while cur != SOURCE:\n        id = pe[cur]\n        flow[id] += 1\n        flow[id ^ 1] -= 1\n        cur = pred[cur]\n    answer += dist[TARGET]\n\ndef main():\n    global answer\n    n, m, k, c, d = map(int, sys.stdin.readline().split())\n    \n    for _ in range(k):\n        x = int(sys.stdin.readline()) - 1\n        add_edge(SOURCE, x, 1, 0)\n    \n    LAYERS = 101\n    for t in range(LAYERS):\n        add_edge(t * n, TARGET, k, t * c)\n    \n    for _ in range(m):\n        x, y = map(int, sys.stdin.readline().split())\n        x -= 1\n        y -= 1\n        for t in range(LAYERS - 1):\n            for j in range(k):\n                add_edge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1))\n        for t in range(LAYERS - 1):\n            for j in range(k):\n                add_edge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1))\n    \n    for v in range(n):\n        for t in range(LAYERS - 1):\n            add_edge(v + t * n, v + t * n + n, k, 0)\n    \n    for _ in range(k):\n        push_flow()\n    \n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.4836123e-06, 0.0, -2.3841855e-07, -0.0031945885, -0.39280668, -0.002117893, -0.011087239, -0.00058836315, -0.00020537652, -1.1920928e-07, -0.00020692592, -0.006847369, -0.14116481, -6.377493e-05, -1.6689287e-06, -1.3708975e-05, -0.005249644, -5.6265202e-05, -0.00013112162, -1.0728779e-05, -2.7775379e-05, -5.6028207e-06, -2.384183e-06, 0.0, -4.0531077e-06, -1.2636105e-05, 0.0, 0.0, -5.960463e-07, -2.3841855e-07, -3.576278e-07, -1.1920922e-06, -2.145765e-06, -9.786604e-05, -2.264974e-06, -4.887569e-06, -0.011332783, -7.903264e-05, -0.0052347025, -0.000120632525, -0.00014685506, -0.016592719, -1.6689287e-06, -8.4635016e-05, -1.1920922e-06, -0.0009184433, -2.3841855e-07, -5.2093103e-05, -3.5166122e-05, -0.0034481375, -1.1086402e-05, -1.1324818e-05, -9.5367386e-07, -1.1920928e-07, -1.1920928e-07, -1.1920928e-07, -0.00020740266, -1.537788e-05, -8.4992615e-05, -6.0437284e-05, -0.00018547245, -1.6927575e-05, -2.1695856e-05, -2.2053475e-05, -0.0008033862, -2.4556812e-05, -5.161629e-05, -0.004271432, -7.748574e-06, -0.00019536