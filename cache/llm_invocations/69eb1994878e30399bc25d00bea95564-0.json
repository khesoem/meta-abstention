 dfs(v, min(flow, cap), level, iter)\n            if pushed > 0:\n                graph[u][i][1] -= pushed\n                graph[v][rev][1] += pushed\n                return pushed\n        iter[u] += 1\n    return 0\n\ndef max_flow():\n    flow = 0\n    while True:\n        level = bfs()\n        if level[ed] < 0:\n            break\n        iter = [0] * (2*tot+2)\n        while True:\n            pushed = dfs(st, INF, level, iter)\n            if pushed == 0:\n                break\n            flow += pushed\n    return flow\n\n# Check if position is valid\ndef check(x, y):\n    if x < 0 or y < 0 or x >= n or y >= n:\n        return False\n    if c[x][y] == 'Z':\n        return True\n    if c[x][y] < '0' or c[x][y] > '9':\n        return False\n    return True\n\n# BFS to compute distances from (sx, sy)\ndef bfs_distance():\n    dis = [[float('inf')] * n for _ in range(n)]\n    vis = [[False]*n for _ in range(n)]\n    dis[sx][sy] = 0\n    vis[sx][sy] = True\n    queue = deque()\n    queue.append((sx, sy))\n    while queue:\n        x, y = queue.popleft()\n        for i in range(4):\n            nx, ny = x + dx[i], y + dy[i]\n            if check(nx, ny) and not vis[nx][ny]:\n                dis[nx][ny] = dis[x][y] + 1\n                vis[nx][ny] = True\n                queue.append((nx, ny))\n    return dis\n\ndis_map = bfs_distance()\n\n# For each cell, compute distances to all other cells\ndef find_distances(tx, ty, idx):\n    Dis = [[float('inf')] * n for _ in range(n)]\n    vis = [[False]*n for _ in range(n)]\n    Dis[tx][ty] = 0\n    vis[tx][ty] = True\n    queue = deque()\n    queue.append((tx, ty))\n    while queue:\n        x, y = queue.popleft()\n        for i in range(4):\n            nx, ny = x + dx[i], y + dy[i]\n            if check(nx, ny) and not vis[nx][ny]:\n                Dis[nx][ny] = Dis[x][y] + 1\n                vis[nx][ny] = True\n                queue.append((nx, ny))\n    for i in range(n):\n        for j in range(n):\n            if Dis[i][j] <= t and S[i][j] > '0' and S[i][j] <= '9' and Dis[i][j] <= dis_map[i][j]:\n                add_edge(idx, id_map[i][j] + tot, INF)\n\n# Build the flow network\nfor i in range(n):\n    for j in range(n):\n        if c[i][j] > '0' and c[i][j] <= '9':\n            add_edge(st, id_map[i][j], int(c[i][j]) - ord('0'))\n            find_distances(i, j, id_map[i][j])\n\nfor i in range(n):\n    for j in range(n):\n        if S[i][j] > '0' and S[i][j] <= '9':\n            add_edge(id_map[i][j] + tot, ed, int(S[i][j]) - ord('0'))\n\n# Compute max flow\nresult = max_flow()\nprint(result)\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002019907406065613, -5.6934557505883276e-05, -1.9361264946837764e-07, -1.4736459888808895e-05, -0.08228257298469543, -0.1198931410908699, -0.12786342203617096, -4.320199877838604e-07, -0.017237721011042595, -1.3856492842023727e-06, -0.0004885728703811765, 0.0, 0.0, -0.4772873520851135, -1.1756367712223437e-05, -3.464347173576243e-05, -2.7729658540920354e-05, -0.10022197663784027, -1.981667537620524e-06, -0.033646274358034134, -0.0004973902832716703, -4.320199877838604e-07, -1.8624639324116288e-06, 0.0, -7.896309739408025e-07, 0.0, 0.0, -1.7120533811976202e-05, -1.0325924449716695e-05, -6.034592388459714e-06, 0.0, -6.749814019713085e-06, 0.0, -3.128163257315464e-07, -1.9361264946837764e-07, -4.320199877838604e-07, -2.935296834039036e-06, 0.0, -3.128163257315464e-07, 0.0, -8.41866585687967e-06, -0.02105095237493515, -0.7006472945213318, -0.4579079747200012, -0.608349084854126, -0.6371991634368896, -0.4137418270111084, -1.2401330471038818, -0.18645456433296204, -1.9361264946837764e-07, -0.0031337514519691467, -0.02168668434023857, -0.18777531385421753, -0.01163986325263977, -0.08896443992853165, -9.849109119386412e-06, -1.3902033970225602e-05, -0.5960795879364014, -3.128163257315464e-07, -4.320199877838604e-07, 0.0, -3.128163257315464e-07, -3.8889261304575484e-06, -0.005271111149340868, -0.0013338132994249463