ow(evens - odds, total, MOD);\n            long inv2 = fastPow(2, MOD - 2, MOD);\n            long result = (term1 + term2) % MOD;\n            result = (result * inv2) % MOD;\n            System.out.println(result);\n        }\n    }\n    \n    private static long fastPow(long base, long exp, int mod) {\n        base %= mod;\n        if (base < 0) base += mod;\n        long result = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <sstream>\n#include <vector>\n#include <cmath>\n#include <algorithm>\n\nusing namespace std;\n\nlong long fastPow(long long base, long long exp, int mod) {\n    base %= mod;\n    if (base < 0) base += mod;\n    long long result = 1;\n    while (exp > 0) {\n        if ((exp & 1) == 1) {\n            result = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    \n    vector<string> tokens;\n    istringstream iss(line);\n    string token;\n    while (iss >> token) {\n        tokens.push_back(token);\n    }\n    \n    int n = stoi(tokens[0]);\n    int m = stoi(tokens[1]);\n    int l = stoi(tokens[2]);\n    int r = stoi(tokens[3]);\n    \n    long long total = (long long) n * m;\n    const int MOD = 998244353;\n    \n    if (total % 2 == 1) {\n        long long base = r - l + 1;\n        cout << fastPow(base, total, MOD) << endl;\n    } else {\n        int k = r - l + 1;\n        int evens = r / 2 - l / 2;\n        if (l % 2 == 0) evens++;\n        int odds = k - evens;\n        \n        long long term1 = fastPow(evens