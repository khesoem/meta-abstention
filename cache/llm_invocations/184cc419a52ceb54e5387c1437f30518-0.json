st < potential[v]:\n                        potential[v] = potential[u] + cost\n                    i += 1\n        \n        totalCost = 0\n        \n        while True:\n            dist = [self.INF] * totalNodes\n            prevNode = [-1] * totalNodes\n            prevEdge = [-1] * totalNodes\n            dist[src] = 0\n            \n            pq = []\n            heapq.heappush(pq, (0, src))\n            visited = [False] * totalNodes\n            \n            while pq:\n                d, u = heapq.heappop(pq)\n                if visited[u]:\n                    continue\n                visited[u] = True\n                \n                i = 1\n                while i <= adj[u][0]:\n                    e = adj[u][i]\n                    v, cap, cost = to[e][0], to[e][1], to[e][2]\n                    if cap > 0 and dist[u] + cost + potential[u] - potential[v] < dist[v]:\n                        dist[v] = dist[u] + cost + potential[u] - potential[v]\n                        prevNode[v] = u\n                        prevEdge[v] = e\n                        heapq.heappush(pq, (dist[v], v))\n                    i += 1\n            \n            if dist[dst] == self.INF:\n                break\n            \n            for i in range(totalNodes):\n                if dist[i] < self.INF:\n                    potential[i] += dist[i]\n            \n            f = self.INF\n            v = dst\n            while v != src:\n                e = prevEdge[v]\n                f = min(f, to[e][1])\n                v = prevNode[v]\n            \n            v = dst\n            while v != src:\n                e = prevEdge[v]\n                to[e][1] -= f\n                to[e ^ 1][1] += f\n                totalCost += f * to[e][2]\n                v = prevNode[v]\n        \n        return totalCost\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00010716341057559475, -1.1920922133867862e-06, -2