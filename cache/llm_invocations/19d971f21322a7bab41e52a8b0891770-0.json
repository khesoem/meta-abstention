.tree[idx] = nodes[l]\n            return\n        mid = (l + r) // 2\n        self._build(2 * idx + 1, l, mid, nodes)\n        self._build(2 * idx + 2, mid + 1, r, nodes)\n        self.tree[idx] = self.merge(self.tree[2 * idx + 1], self.tree[2 * idx + 2])\n    \n    def update(self, pos: int, node: Node):\n        self._update(0, 0, self.n - 1, pos, node)\n    \n    def _update(self, idx: int, l: int, r: int, pos: int, node: Node):\n        if pos < l or pos > r:\n            return\n        if l == r:\n            self.tree[idx] = node\n            return\n        mid = (l + r) // 2\n        self._update(2 * idx + 1, l, mid, pos, node)\n        self._update(2 * idx + 2, mid + 1, r, pos, node)\n        self.tree[idx] = self.merge(self.tree[2 * idx + 1], self.tree[2 * idx + 2])\n    \n    def query(self, ql: int, qr: int) -> Node:\n        return self._query(0, 0, self.n - 1, ql, qr)\n    \n    def _query(self, idx: int, l: int, r: int, ql: int, qr: int) -> Node:\n        if qr < l or ql > r:\n            return Node()\n        if ql <= l and r <= qr:\n            return self.tree[idx]\n        mid = (l + r) // 2\n        left_res = self._query(2 * idx + 1, l, mid, ql, qr)\n        right_res = self._query(2 * idx + 2, mid + 1, r, ql, qr)\n        return self.merge(left_res, right_res)\n    \n    def merge(self, a: Node, b: Node) -> Node:\n        if a is None:\n            return b\n        if b is None:\n            return a\n        overlap = min(a.open, b.close)\n        return Node(a.data + b.data + 2 * overlap, a.open + b.open - overlap, a.close + b.close - overlap)\n\ndef calc(m: int, n: int) -> float:\n    total = n * (n - 1) * (n - 2) // 6\n    favorable = 0.0\n    if m >= 3:\n        favorable += m * (m - 1) * (m - 2) / 6\n    if m >= 2:\n        favorable += m * (m - 1) / 2 * (n - m)\n    if m >= 1 and n - m >= 2:\n        favorable += 0.5 * m * (n - m) * (n - m - 1) / 2\n    return favorable / total\n\ndef solve():\n    in_reader = FastReader()\n    out =