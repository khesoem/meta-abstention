en(\"out.out\", \"w\", stdout);\n#endif // ONLINE_JUDGE\n\n\tscanf(\"%d\",&n);\n    int r100 = power(100, mod-2, mod);\n    for(int i=0; i<n; i++) {\n        for(int j=0; j<n; j++) {\n            scanf(\"%d\", p[i]+j);\n            p[i][j] = (INT)p[i][j] * r100 % mod;\n        }\n    }\n    for(int i=0; i<n; i++) {\n        for(int j=0; j<1<<n; j++) {\n            pro[i][j] = 1;\n            for(int k=0; k<n; k++) if((j>>k)&1) {\n                pro[i][j] = (INT)pro[i][j] * p[i][k] % mod;\n            } else pro[i][j] = (INT)pro[i][j] * (mod+1-p[i][k]) % mod;\n        }\n    }\n\n    for(int i=0; i<1<<n; i++) bpt[i] = __builtin_popcount(i);\n    for(int i=0; i<1<<n; i++) vec[bpt[i]].pb(i), id[i] = vec[bpt[i]].size() - 1;\n\tfor(int i=0; i<1<<n; i++) {\n        for(int j=0; j<n; j++) if(not ((i>>j)&1)) q[i][1<<j] = 1LL<<id[i|(1<<j)];\n        for(int j=0; j<1<<n; j++) q[i][j] = q[i][j&-j] | q[i][j ^ (j&-j)];\n\t}\n\tcout << calc(0, 1) << endl;\n}\n\n                      \n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nmod = 10**9 + 7\n\ndef power(a, n, mod, ans=1):\n    a %= mod\n    while n:\n        if n & 1:\n            ans = (ans * a) % mod\n        a = (a * a) % mod\n        n >>= 1\n    return ans\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    \n    r100 = power(100, mod - 2, mod)\n    \n    p = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            p[i][j] = int(next(it))\n            p[i][j] = (p[i][j] * r100) % mod\n    \n    pro = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        for j in range(1 << n):\n            pro[i][j] = 1\n            for k in range(n):\n                if (j >> k) & 1:\n                    pro[i][j] = (pro[i][j] * p[i][k]) % mod\n                else:\n                    pro[i][j] = (pro[i][j] * (mod + 1 - p[i][k])) % mod\n    \n    bpt = [bin(i).count('1') for i in range(1 << n)]\n    vec = [[] for _ in range(n + 1)]\n    id_map = [0] * (1 << n)\n    for i in range(1 << n):\n        vec[bpt[i]].append(i)\n        id_map[i] = len(vec[bpt[i]]) - 1\n    \n    q = [[0] * (1 << n) for _ in range(1 << n)]\n    for i in range(1 << n):\n        for j in range(n):\n            if not ((i >> j) & 1):\n                q[i][1 << j] = 1 << id_map[i | (1 << j)]\n        for j in range(1 << n):\n            if j == 0:\n                continue\n            lowbit = j & -j\n            q[i][j] = q[i][lowbit] | q[i][j ^ lowbit]\n    \n    mp = {}\n    \n    def calc(now, st):\n        if st == 0:\n            return 0\n        if now == n:\n            return 1\n        if (now, st) in mp:\n            return mp[(now, st)]\n        ans = 0\n        for j in range(1, 1 << n):\n            nst = 0\n            for k in range(len(vec[bpt[st]])):\n                if not (st & (1 << k)):\n                    continue\n                cur = vec[bpt[st]][k]\n                nxt = j - (j & cur)\n                nst |= q[cur][nxt]\n            ans = (ans + pro[now][j] * calc(now + 1, nst)) % mod\n        mp[(now, st)] = ans\n        return ans\n    \n    print(calc(0, 1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00034505134681239724, -1.4305104514278355e-06, -2.3841855067985307e-07, -0.003504090243950486, -0.00013779645087197423, -0.00014244495832826942, -0.044054146856069565, -0.5284175872802734, -5.960462772236497e-07, -3.4570634852570947e-06, -0.10039884597063065, -0.2478097379207611, -2.3841855067985307e-07, -3.540453326422721e-05, 0.0, -1.0132738680113107e-05, -0.02328050322830677, 0.0, -0.00012337400403339416, 0.0, -1.1920928244535389e-07, -0.0013263961300253868, -0.00010263393050990999, -0.018485531210899353, -2.55