.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static final int MAXN = 6000;\n    static final int INF = Integer.MAX_VALUE;\n    static final long INF_LL = (long)1e18;\n    static final long MOD = (long)1e9 + 7;\n\n    static List<Edge>[] G = new ArrayList[MAXN];\n    static int[] dist = new int[MAXN];\n    static int[] prevv = new int[MAXN];\n    static int[] preve = new int[MAXN];\n    static boolean[] inq = new boolean[MAXN];\n\n    static int n, s, t;\n\n    static void init(int _n, int _s, int _t) {\n        for (int i = 0; i <= _n; i++) {\n            G[i] = new ArrayList<>();\n        }\n        n = _n;\n        s = _s;\n        t = _t;\n    }\n\n    static void addEdge(int from, int to, int cap, int cost) {\n        G[from].add(new Edge(to, cap, cost, G[to].size()));\n        G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n    }\n\n    static long minCostFlow(int f) {\n        long res = 0;\n        while (f > 0) {\n            Arrays.fill(dist, 0, n, INF);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            Arrays.fill(inq, false, 0, n, false);\n            inq[s] = true;\n\n            while (!q.isEmpty()) {\n                int now = q.poll();\n                inq[now] = false;\n                for (int i = 0; i < G[now].size(); i++) {\n                    Edge e = G[now].get(i);\n                    if (e.cap > 0 && dist[now] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[now] + e.cost;\n                        prevv[e.to] = now;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) return -1;\n\n            int d = f;\n            for (int v = t; v != s; v = prevv[v]) {\n   