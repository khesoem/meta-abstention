flow = 0\n        self.dist = [0] * self.N\n        self.prev = [None] * self.N\n        while self.spfa(s, t):\n            f = 10**18\n            e = self.prev[t]\n            while e:\n                f = min(f, e.cap - e.flow)\n                e = self.prev[e.src]\n            e = self.prev[t]\n            while e:\n                e.flow += f\n                self.G[e.dst][e.rev].flow -= f\n                e = self.prev[e.src]\n            flow += f\n            cost += f * self.dist[t]\n        return flow, cost\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    g = MCMF((n + 2) * 102)\n    for i in range(102):\n        g.add_edge((i * (n + 2)) + 1, i * (n + 2), 100, i * c)\n    for i in range(101):\n        for j in range(n + 2):\n            g.add_edge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0)\n    for _ in range(k):\n        u = int(next(it))\n        g.add_edge(n + 1, u, 1, 0)\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(101):\n            for f in range(k):\n                g.add_edge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, ((2 * f) + 1) * d)\n                g.add_edge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, ((2 * f) + 1) * d)\n    flow, cost = g.max_flow(n + 1, 101 * (n + 2))\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012492353562265635, 0.0, 0.0, -0.00010287232726113871, -0.00795801542699337, -3.099436753473128e-06, -0.00026341783814132214, -0.006735952105373144, -5.960446742392378e-06, -2.3841855067985307e-07, -2.0265558760002023e-06, -0.018220080062747, -0.0005133026279509068, -0.576193630695343, -8.344646857949556e-07, -4.172316494077677e-06, -0.0009159421897493303, 0.0, -3.576278118089249e-07, -1.311301275563892e-06, -1.7881377516459906e-06, -