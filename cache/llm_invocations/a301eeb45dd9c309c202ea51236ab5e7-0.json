           inq[u] = false;\n            for (Edge &e : G[u])\n                if (e.flow < e.cap && dist[e.dst] > dist[e.src] + e.cost)\n                {\n                    dist[e.dst] = dist[e.src] + e.cost;\n                    prev[e.dst] = &e;\n                    if (!inq[e.dst])\n                    {\n                        q.push(e.dst);\n                        inq[e.dst] = true;\n                    }\n                }\n        }\n        return dist[t] < INF;\n    }\n\n    pair<flow_type, cost_type> max_flow(int s, int t)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < N; ++u)\n            for (Edge &e : G[u])\n                e.flow = 0;\n        dist.assign(N, 0);\n        prev.assign(N, nullptr);\n        while (spfa(s, t))\n        {\n            flow_type f = numeric_limits<flow_type>::max();\n            for (Edge *e = prev[t]; e; e = prev[e->src])\n                f = min(f, e->cap - e->flow);\n            for (Edge *e = prev[t]; e; e = prev[e->src])\n            {\n                e->flow += f;\n                G[e->dst][e->rev].flow -= f;\n            }\n            flow += f;\n            cost += f * dist[t];\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n    int n, m, k, c, d, u, v;\n    cin >> n >> m >> k >> c >> d;\n    MCMF<int, ll> g((n + 2) * 102);\n    for (int i = 0; i < 102; ++i)\n        g.add_edge((i * (n + 2)) + 1, i * (n + 2), 100, (ll)i * c);\n    for (int i = 0; i < 101; ++i)\n        for (int j = 0; j < n + 1; ++j)\n            g.add_edge(j + (i * (n + 2)), j + ((i + 1) * (n + 2)), 100, 0);\n    for (int i = 0; i < k; ++i)\n    {\n        cin >> u;\n        g.add_edge(n + 1, u, 1, 0);\n    }\n    for (int i = 0; i < m; ++i)\n    {\n        cin >> u >> v;\n        for (int j = 0; j < 101; ++j)\n            for (int f = 0; f < k; ++f)\n            {\n                g.add_edge(u + (j * (n + 2)), v + ((j + 1)