pread(2);\n        if (seenA[tx][ty] == 2) return false;\n    }\n    return false;\n}\n\nbool make_level_graph(int src, int sink) {\n    memset(level, -1, sizeof(level));\n    queue<int> q;\n    level[src] = 0;\n    q.push(src);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (int v=0; v<=sink; ++v) {\n            if (level[v] == -1 && cap[u][v] > 0) {\n                level[v] = level[u] + 1;\n                q.push(v);\n            }\n        }\n    }\n    return level[sink] != -1;\n}\n\nint dinic_dfs(int u, int sink, int pushed) {\n    if (u == sink) return pushed;\n    for (int &v = ptr[u]; v <= sink; ++v) {\n        if (cap[u][v] > 0 && level[v] == level[u] + 1) {\n            int got = dinic_dfs(v, sink, min(pushed, cap[u][v]));\n            if (got) {\n                cap[u][v] -= got;\n                cap[v][u] += got;\n                return got;\n            }\n        }\n    }\n    return 0;\n}\n\nint main() {\n    memset(dist, 1, sizeof(dist));\n    cin >> n >> t;\n    int infx=0, infy=0;\n    for (int i=1; i<=n; ++i) {\n        cin >> (sci[i]+1);\n        for (int j=1; j<=n; ++j) {\n            dist[i][j][i][j] = 0;\n            if (sci[i][j] == 'Z') { infx=i; infy=j; }\n        }\n    }\n    for (int i=1; i<=n; ++i) cin >> (rec[i]+1);\n    for (int i=1; i<=n; ++i)\n        for (int j=1; j<=n; ++j)\n            for (int k=0; k<4; ++k) {\n                int ni=i+dx[k], nj=j+dy[k];\n                if (ni>0 && ni<=n && nj>0 && nj<=n && sci[i][j]!='Y' && sci[ni][nj]!='Y')\n                    dist[i][j][ni][nj] = 1;\n            }\n    for (int kx=1; kx<=n; ++kx)\n        for (int ky=1; ky<=n; ++ky)\n            for (int sx=1; sx<=n; ++sx)\n                for (int sy=1; sy<=n; ++sy)\n                    for (int tx=1; tx<=n; ++tx)\n                        for (int ty=1; ty<=n; ++ty)\n                            dist[sx][sy][tx][ty] = min(dist[sx][sy][tx][ty],\n                                                       dist[sx][sy]