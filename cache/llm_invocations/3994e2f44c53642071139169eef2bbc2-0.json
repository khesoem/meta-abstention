tep in range(100):\n        spread(seenA, seenB, 1, n, sci)\n        if seenA[tx][ty] == 1:\n            return True\n        spread(seenA, seenB, 2, n, sci)\n        if seenA[tx][ty] == 2:\n            return False\n    return False\n\ndef make_level_graph(src, sink, cap, level):\n    for i in range(len(level)):\n        level[i] = -1\n    q = deque()\n    level[src] = 0\n    q.append(src)\n    while q:\n        u = q.popleft()\n        for v in range(sink+1):\n            if level[v] == -1 and cap[u][v] > 0:\n                level[v] = level[u] + 1\n                q.append(v)\n    return level[sink] != -1\n\ndef dinic_dfs(u, sink, pushed, cap, level, ptr):\n    if u == sink:\n        return pushed\n    for v in range(ptr[u], sink+1):\n        if cap[u][v] > 0 and level[v] == level[u] + 1:\n            got = dinic_dfs(v, sink, min(pushed, cap[u][v]), cap, level, ptr)\n            if got:\n                cap[u][v] -= got\n                cap[v][u] += got\n                return got\n        ptr[u] = v + 1\n    return 0\n\ndef main():\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    t = int(next(it))\n    sci = [['']*(n+1) for _ in range(n+1)]\n    rec = [['']*(n+1) for _ in range(n+1)]\n    infx = infy = 0\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            sci[i][j] = line[j-1]\n            if sci[i][j] == 'Z':\n                infx, infy = i, j\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            rec[i][j] = line[j-1]\n\n    # Initialize dist with large number\n    INF = 10**9\n    dist = [[[[INF]*(n+1) for _ in range(n+1)] for _ in range(n+1)] for _ in range(n+1)]\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            dist[i][j][i][j] = 0\n\n    # Set direct edges\n    dx = [1,0,-1,0]\n    dy = [0,1,0,-1]\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            for k in range(4):\n                ni = i + dx[k]\n                nj = j + dy[k]\n                if 1 <= ni <= n and 1 <= nj <= n and sci[i][j] != 'Y' and sci[ni][nj] != 'Y':\n                    dist[i][j][ni][nj] = 1\n\n    # Floyd-Warshall\n    for kx in range(1, n+1):\n        for ky in range(1, n+1):\n            for sx in range(1, n+1):\n                for sy in range(1, n+1):\n                    for tx in range(1, n+1):\n                        for ty in range(1, n+1):\n                            if dist[sx][sy][kx][ky] + dist[kx][ky][tx][ty] < dist[sx][sy][tx][ty]:\n                                dist[sx][sy][tx][ty] = dist[sx][sy][kx][ky] + dist[kx][ky][tx][ty]\n\n    # Build flow network\n    total_cells = n*n\n    src = 2*total_cells + 1\n    sink = 2*total_cells + 2\n    max_nodes = sink + 1\n    cap = [[0]*max_nodes for _ in range(max_nodes)]\n\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if sci[i][j].isdigit():\n                cap[src][getnode(i,j,n)] = int(sci[i][j])\n            if rec[i][j].isdigit():\n                cap[total_cells + getnode(i,j,n)][sink] = int(rec[i][j])\n            if sci[i][j].isdigit() and int(sci[i][j]) > 0:\n                for a in range(1, n+1):\n                    for b in range(1, n+1):\n                        if rec[a][b].isdigit() and int(rec[a][b]) > 0 and dist[i][j][a][b] <= t and reachable(i,j,a,b,infx,infy,n,sci):\n                            cap[getnode(i,j,n)][total_cells + getnode(a,b,n)] = 1000\n\n    # Dinic max flow\n    answer = 0\n    level = [0]*max_nodes\n    ptr = [0]*max_nodes\n    while make_level_graph(src, sink, cap, level):\n        for i in range(max_nodes):\n            ptr[i] = 0\n        while True:\n            f = dinic_dfs(src, sink, 1000000000, cap, level, ptr)\n            if f == 0:\n                break\n            answer += f\n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.