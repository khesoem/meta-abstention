{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nconst int INF=1e9;\n\nstruct MCF {\n    int n;\n    struct Edge { int to, f, cap, cost, rev; };\n    vector<vector<Edge>> adj;\n    vector<int> prio, curflow, prevedge, prevnode, pot;\n    MCF(int n): n(n), adj(n), prio(n), curflow(n), prevedge(n), prevnode(n), pot(n) {}\n    void addEdge(int s, int t, int cap, int cost) {\n        Edge a{t,0,cap,cost,(int)adj[t].size()};\n        Edge b{s,0,0,-cost,(int)adj[s].size()};\n        adj[s].push_back(a);\n        adj[t].push_back(b);\n    }\n    pair<int,int> minCostFlow(int s, int t) {\n        int flow=0, flowCost=0;\n        while(flow<INF) {\n            fill(prio.begin(), prio.end(), INT_MAX);\n            prio[s]=0;\n            curflow[s]=INT_MAX;\n            set<pair<int,int>> st;\n            st.insert({0,s});\n            while(!st.empty()) {\n                auto it=st.begin();\n                int d=it->first, u=it->second;\n                st.erase(it);\n                if(d!=prio[u]) continue;\n                for(int i=0;i<(int)adj[u].size();++i) {\n                    Edge &e=adj[u][i];\n                    if(e.cap<=e.f) continue;\n                    int v=e.to;\n                    int nd=d+e.cost+pot[u]-pot[v];\n                    if(prio[v]>nd) {\n                        if(prio[v]!=INT_MAX) st.erase({prio[v], v});\n                        prio[v]=nd;\n                        st.insert({nd,v});\n                        prevnode[v]=u;\n                        prevedge[v]=i;\n                        curflow[v]=min(curflow[u], e.cap-e.f);\n                    }\n                }\n            }\n            if(prio[t]==INT_MAX) break;\n            for(int i=0;i<n;++i) pot[i]+=prio[i];\n            int df=min(curflow[t], INF-flow);\n            flow+=df;\n            for(int v=t; v!=s; v=prevnode[v]) {\n                Edge &e=adj[prevnode[v]][prevedge[v]];\n                e.f+=df;\n                adj[v][e.rev].f-=df;\n                flowCost+=df*e.cost;\n            }\n        }\n        return {flow, flowCost};\n    }\n};\n\nint main(){\n    int n,m,k,c,d;\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    MCF nt(6+107*n);\n    for(int _=0;_<k;++_) {\n        int x; scanf(\"%d\",&x); --x;\n        nt.addEdge(0,1+x,1,0);\n    }\n    for(int _=0;_<m;++_) {\n        int x,y; scanf(\"%d%d\",&x,&y); --x; --y;\n        for(int i=0;i<105;++i)\n            for(int j=0;j<51;++j) {\n                nt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n                nt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n            }\n    }\n    for(int i=0;i<105;++i)\n        for(int j=0;j<n;++j)\n            nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n    for(int i=0;i<105;++i)\n        nt.addEdge(1+i*n,1+105*n,51,0);\n    auto ans=nt.minCostFlow(0,1+105*n);\n    printf(\"%d\\n\",ans.second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.prio = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n\n    def add_edge(self, s, t, cap, cost):\n        # forward edge: [to, f, cap, cost, rev]\n        forward = [t, 0, cap, cost, len(self.adj[t])]\n        # reverse edge\n        reverse = [s, 0, 0, -cost, len(self.adj[s])]\n        self.adj[s].append(forward)\n        self.adj[t].append(reverse)\n\n    def min_cost_flow(self, s, t):\n        flow = 0\n        flow_cost = 0\n        while flow < INF:\n            self.prio = [INF] * self.n\n            self.prio[s] = 0\n            self.curflow[s] = INF\n            heap = [(0, s)]\n            while heap:\n                d, u = heapq.heappop(heap)\n                if d != self.prio[u]:\n                    continue\n                for i, e in enumerate(self.adj[u]):\n                    if e[1] >= e[2]:  # f >= cap\n                        continue\n                    v = e[0]\n                    nd = d + e[3] + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nd:\n                        self.prio[v] = nd\n                        heapq.heappush(heap, (nd, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e[2] - e[1])\n            if self.prio[t] == INF:\n                break\n            for i in range(self.n):\n                if self.prio[i] < INF:\n                    self.pot[i] += self.prio[i]\n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            v = t\n            while v != s:\n                u = self.prevnode[v]\n                e = self.adj[u][self.prevedge[v]]\n                e[1] += df\n                rev = self.adj[v][e[4]]\n                rev[1] -= df\n                flow_cost += df * e[3]\n                v = u\n        return flow, flow_cost\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    nt = MCF(6 + 107 * n)\n    # source = 0, sink = 1 + 105 * n\n    sink = 1 + 105 * n\n\n    for _ in range(k):\n        x = next(it) - 1\n        nt.add_edge(0, 1 + x, 1, 0)\n\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        for i in range(105):\n            for j in range(51):\n                nt.add_edge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1))\n                nt.add_edge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1))\n\n    for i in range(105):\n        for j in range(n):\n            nt.add_edge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c)\n\n    for i in range(105):\n        nt.add_edge(1 + i * n, sink, 51, 0)\n\n    ans = nt.min_cost_flow(0, sink)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-4.827859811484814e-05, 0.0, 0.0, -0.0005595310358330607, -0.0009192770230583847, -0.00020346954988781363, -0.03804359585046768, -2.3841855067985307e-07, -1.4424220353248529e-05, -0.0052625699900090694, -0.6987472772598267, -3.1709168979432434e-05, -1.1920922133867862e-06, -7.867782187531702e-06, -0.023245446383953094, -0.0005038899253122509, -0.0017863045213744044, -3.099436753473128e-06, -4.9232225137529895e-05, -1.1920928244535389e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.168244216387393e-05, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -2.622600959512056e-06, -0.0003449321957305074, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -4.541770613286644e-05, -1.4305104514278355e-06, 0.0, 0.0, -5.960462772236497e-07, 0.0, 0.0, -8.344646857949556e-07, 0.0, -7.152555099310121e-07, -0.0002971446083392948, 0.0, -0.0001233