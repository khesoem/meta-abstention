                    int lb = get_bit(ov);\n                    if (S[i ^ lb]) { ns[i] = 1; found = true; break; }\n                    ov -= lb;\n                }\n                if (!found) ns[i] = 0;\n            }\n        }\n        trans[u][mask] = build_state(ns);\n    }\n    return u;\n}\n\nint main() {\n    scanf(\"%d\", &n);\n    build_state(1);\n    \n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &A[i][j]);\n            A[i][j] = mul_mod(A[i][j], pow_mod(100, MOD - 2));\n        }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int msk = 0; msk < (1 << n); ++msk) {\n            prob[i][msk] = 1;\n            for (int k = 0; k < n; ++k) {\n                if ((msk >> k) & 1)\n                    prob[i][msk] = mul_mod(prob[i][msk], A[i][k]);\n                else\n                    prob[i][msk] = mul_mod(prob[i][msk], sub_mod(1, A[i][k]));\n            }\n        }\n    }\n    \n    DP[0][1] = 1;\n    for (int step = 1; step <= n; ++step) {\n        for (int u = 1; u <= node_count; ++u) {\n            for (int choice = 0; choice < (1 << n); ++choice) {\n                int v = trans[u][choice];\n                DP[step][v] = add_mod(DP[step][v], mul_mod(DP[step-1][u], prob[step-1][choice]));\n            }\n        }\n    }\n    \n    bitset<128> full;\n    full.flip();\n    printf(\"%d\\n\", DP[n][state_ids[full]]);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n\n    static int add_mod(int x, int y) {\n        return (x += y) >= MOD ? x - MOD : x;\n    }\n\n    static int mul_mod(int x, int y) {\n        return (int) ((1L * x * y) % MOD);\n    }\n\n    static int sub_mod(int x, int y) {\n        return (x -= y) < 0 ? x + MOD : x;\n    }\n\n    static int pow_mod(int b, int e) {\n