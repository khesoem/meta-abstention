{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Edge {\n    int to, cap, flow, cost;\n    Edge() {}\n    Edge(int to, int cap, int flow, int cost) : to(to), cap(cap), flow(flow), cost(cost) {}\n};\n\nvector<Edge> edges;\nconst int MAX_NODES = 14043;\nvector<int> adj[MAX_NODES];\n\nlong long totalCost = 0;\nlong long dist[MAX_NODES];\nint parent[MAX_NODES];\nint parentEdge[MAX_NODES];\nbool inQueue[MAX_NODES];\n\nconst long long INF64 = 1e18;\n\nint source = MAX_NODES - 2;\nint sink = MAX_NODES - 1;\n\nint remaining(int idx) {\n    return edges[idx].cap - edges[idx].flow;\n}\n\nvoid augmentPath() {\n    fill(dist, dist + MAX_NODES, INF64);\n    fill(parent, parent + MAX_NODES, -1);\n    fill(parentEdge, parentEdge + MAX_NODES, -1);\n    fill(inQueue, inQueue + MAX_NODES, false);\n    \n    dist[source] = 0;\n    queue<int> q;\n    q.push(source);\n    inQueue[source] = true;\n    \n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inQueue[u] = false;\n        \n        for (int idx : adj[u]) {\n            if (remaining(idx) == 0) continue;\n            int v = edges[idx].to;\n            int cost = edges[idx].cost;\n            if (dist[v] > dist[u] + cost) {\n                dist[v] = dist[u] + cost;\n                parent[v] = u;\n                parentEdge[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    int cur = sink;\n    while (cur != source) {\n        int edgeIdx = parentEdge[cur];\n        edges[edgeIdx].flow++;\n        edges[edgeIdx ^ 1].flow--;\n        cur = parent[cur];\n    }\n    \n    totalCost += dist[sink];\n}\n\nvoid addEdge(int u, int v, int capacity, int cost) {\n    adj[u].push_back(edges.size());\n    edges.emplace_back(v, capacity, 0, cost);\n    adj[v].push_back(edges.size());\n    edges.emplace_back(u, 0, 0, -cost);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d_val;\n    cin >> n >> m >> k >> c >> d_val;\n    \n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        --x;\n        addEdge(source, x, 1, 0);\n    }\n    \n    const int TIME_STEPS = 101;\n    for (int t = 0; t < TIME_STEPS; t++) {\n        addEdge(0 + t * n, sink, k, t * c);\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        \n        for (int t = 0; t < TIME_STEPS - 1; t++) {\n            for (int j = 0; j < k; j++) {\n                addEdge(u + t * n, v + t * n + n, 1, d_val * (j * 2 + 1));\n            }\n        }\n        for (int t = 0; t < TIME_STEPS - 1; t++) {\n            for (int j = 0; j < k; j++) {\n                addEdge(v + t * n, u + t * n + n, 1, d_val * (j * 2 + 1));\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; i++) {\n        for (int t = 0; t < TIME_STEPS - 1; t++) {\n            addEdge(i + t * n, i + t * n + n, k, 0);\n        }\n    }\n    \n    for (int i = 0; i < k; i++) {\n        augmentPath();\n    }\n    \n    cout << totalCost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    def __init__(self, to, cap, flow, cost):\n        self.to = to\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d_val = int(data[idx]); idx += 1\n    \n    edges = []\n    MAX_NODES = 14043\n    adj = [[] for _ in range(MAX_NODES)]\n    \n    totalCost = 0\n    dist = [0] * MAX_NODES\n    parent = [-1] * MAX_NODES\n    parentEdge = [-1] * MAX_NODES\n    inQueue = [False] * MAX_NODES\n    \n    INF64 = 10**18\n    \n    source = MAX_NODES - 2\n    sink = MAX_NODES - 1\n    \n    def remaining(edge_idx):\n        return edges[edge_idx].cap - edges[edge_idx].flow\n    \n    def augmentPath():\n        nonlocal totalCost\n        for i in range(MAX_NODES):\n            dist[i] = INF64\n            parent[i] = -1\n            parentEdge[i] = -1\n            inQueue[i] = False\n        \n        dist[source] = 0\n        q = deque()\n        q.append(source)\n        inQueue[source] = True\n        \n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            \n            for edge_idx in adj[u]:\n                if remaining(edge_idx) == 0:\n                    continue\n                v = edges[edge_idx].to\n                cost = edges[edge_idx].cost\n                if dist[v] > dist[u] + cost:\n                    dist[v] = dist[u] + cost\n                    parent[v] = u\n                    parentEdge[v] = edge_idx\n                    if not inQueue[v]:\n                        inQueue[v] = True\n                        q.append(v)\n        \n        cur = sink\n        while cur != source:\n            edge_idx = parentEdge[cur]\n            edges[edge_idx].flow += 1\n            edges[edge_idx ^ 1].flow -= 1\n            cur = parent[cur]\n        \n        totalCost += dist[sink]\n    \n    def addEdge(u, v, capacity, cost):\n        adj[u].append(len(edges))\n        edges.append(Edge(v, capacity, 0, cost))\n        adj[v].append(len(edges))\n        edges.append(Edge(u, 0, 0, -cost))\n    \n    for i in range(k):\n        x = int(data[idx]); idx += 1\n        x -= 1\n        addEdge(source, x, 1, 0)\n    \n    TIME_STEPS = 101\n    for t in range(TIME_STEPS):\n        addEdge(0 + t * n, sink, k, t * c)\n    \n    for i in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        u -= 1\n        v -= 1\n        \n        for t in range(TIME_STEPS - 1):\n            for j in range(k):\n                addEdge(u + t * n, v + t * n + n, 1, d_val * (j * 2 + 1))\n        \n        for t in range(TIME_STEPS - 1):\n            for j in range(k):\n                addEdge(v + t * n, u + t * n + n, 1, d_val * (j * 2 + 1))\n    \n    for i in range(n):\n        for t in range(TIME_STEPS - 1):\n            addEdge(i + t * n, i + t * n + n, k, 0)\n    \n    for i in range(k):\n        augmentPath()\n    \n    print(totalCost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016485285595990717, -1.1920922133867862e-06, -2.3841855067985307e-07, -0.0629323199391365, -0.008282006718218327, -4.768370445162873e-07, -5.23315102327615e-05, -0.0002786724944598973, -1.9073468138230965e-06, -0.0002646096108946949, -0.00013290952483657748, -0.3619335889816284, -1.7523612768854946e-05, -3.576278118089249e-07, -2.3841855067985307e-07, -0.12692835927009583, 0.0, -9.536738616588991e-07, 0.0, -8.344646857949556e-07, -3.576278118089249e-07, -2.145764938177308e-06, -0.0002