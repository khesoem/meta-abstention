nau = [next(it).decode() for _ in range(n)]\n    pom = [next(it).decode() for _ in range(n)]\n\n    # Directions: up, right, down, left, stay\n    dx = [-1, 0, 1, 0, 0]\n    dy = [0, 1, 0, -1, 0]\n\n    def inside(x, y):\n        return 0 <= x < n and 0 <= y < n\n\n    def is_digit(c):\n        return '0' <= c <= '9'\n\n    # Find start position 'Z'\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if nau[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n\n    # BFS distances to digit cells\n    INF = 1000\n    odl = [[INF]*n for _ in range(n)]\n    q = deque()\n    odl[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx, ny = x + dx[d], y + dy[d]\n            if inside(nx, ny) and is_digit(nau[nx][ny]) and odl[nx][ny] == INF:\n                odl[nx][ny] = odl[x][y] + 1\n                q.append((nx, ny))\n\n    # Flattened 5D index: [k][i][j][l][m] -> ((k*10 + i)*10 + j)*10 + l)*10 + m\n    K = 60\n    D = 10\n    total = K * D * D * D * D\n    moge = [False] * total\n\n    def idx(k, i, j, l, m):\n        return ((((k * D + i) * D + j) * D + l) * D + m)\n\n    # Initialize k=0\n    for i in range(n):\n        for j in range(n):\n            if not is_digit(nau[i][j]):\n                continue\n            for d in range(5):\n                ni, nj = i + dx[d], j + dy[d]\n                if inside(ni, nj) and is_digit(nau[ni][nj]):\n                    moge[idx(0, i, j, ni, nj)] = True\n\n    # DP for k from 0 to t-2\n    for k in range(t - 1):\n        for i in range(n):\n            for j in range(n):\n                for l in range(n):\n                    for m in range(n):\n                        if not moge[idx(k, i, j, l, m)]:\n                            continue\n                        for d in range(5):\n                            nl, nm = l + dx[d], m + dy[d]\n                            if inside(nl, nm) and is_digit(nau[nl][nm]) and odl[l][m] >= k+2 and odl[nl][nm] >= k+2:\n                                moge[idx(k+1, i, j, nl, nm)] = True\n\n    # Collect digit cells\n    a = []\n    for i in range(n):\n        for j in range(n):\n            if is_digit(nau[i][j]):\n                a.append((i, j))\n\n    # Build flow network\n    V = 2 * len(a) + 2\n    G = [[] for _ in range(V)]  # each element: [to, cap, rev]\n\n    def add_edge(fr, to, cap):\n        G[fr].append([to, cap, len(G[to])])\n        G[to].append([fr, 0, len(G[fr]) - 1])\n\n    # Source to in-nodes, out-nodes to sink\n    for i, (x, y) in enumerate(a):\n        cap1 = int(nau[x][y])\n        add_edge(0, i + 1, cap1)\n        cap2 = int(pom[x][y])\n        add_edge(len(a) + 1 + i, V - 1, cap2)\n\n    # In-nodes to out-nodes if reachable in time\n    for i in range(len(a)):\n        for j in range(len(a)):\n            reachable = False\n            for k in range(t):  # k = 0 .. t-1\n                if moge[idx(k, a[i][0], a[i][1], a[j][0], a[j][1])]:\n                    reachable = True\n                    break\n            if reachable:\n                add_edge(i + 1, len(a) + 1 + j, 10**9)\n\n    # Edmonds-Karp max flow\n    flow = 0\n    INF_CAP = 10**9\n    while True:\n        parent = [-1] * V\n        parent_edge = [-1] * V\n        q = deque()\n        q.append(0)\n        parent[0] = 0\n        while q:\n            u = q.popleft()\n            for idx_e, e in enumerate(G[u]):\n                if parent[e[0]] == -1 and e[1] > 0:\n                    parent[e[0]] = u\n                    parent_edge[e[0]] = idx_e\n                    q.append(e[0])\n        if parent[V-1] == -1:\n            break\n        # Find bottleneck capacity\n        add = INF_CAP\n        v = V - 1\n        while v != 0:\n            u = parent[v]\n            e = G[u][parent_edge[v]]\n            add = min(add, e[1])\n            v = u\n        # Augment flow\n        v = V - 1\n        while