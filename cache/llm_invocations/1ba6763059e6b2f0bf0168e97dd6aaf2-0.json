        for (int i = 0; i <= k; i++) {\n            for (int j = 0; j <= k; j++) {\n                int ni = i;\n                if (ni < k) ni = (ni + k - 1) % k;\n                int nj = j;\n                if (nj < k) nj = (nj + k - 1) % k;\n                c.get(i).set(j, mat.get(ni).get(nj));\n            }\n        }\n        return c;\n    }\n\n    static void init() {\n        long digs = 0;\n        long cop = n;\n        while (cop > 0) {\n            cop /= k;\n            digs++;\n        }\n\n        pref = new ArrayList<>();\n        for (int i = 0; i <= 100; i++) {\n            pref.add(null);\n        }\n\n        List<List<Integer>> p0 = new ArrayList<>();\n        for (int i = 0; i <= k; i++) {\n            List<Integer> row = new ArrayList<>();\n            for (int j = 0; j <= k; j++) {\n                row.add(0);\n            }\n            p0.add(row);\n        }\n\n        for (int i = 1; i < k; i++) {\n            p0.get(i).set(i, 1);\n        }\n        p0.get(0).set(k, 1);\n        p0.get(k).set(0, mod - 1);\n        p0.get(k).set(k, 2);\n\n        pref.set(0, p0);\n\n        for (int step = 0; step < digs; step++) {\n            List<List<Integer>> cur = pref.get(step);\n            pref.set(step + 1, new ArrayList<>());\n            for (List<Integer> row : cur) {\n                pref.get(step + 1).add(new ArrayList<>(row));\n            }\n\n            for (int i = 1; i <= k - 1; i++) {\n                cur = shift_by_1(cur);\n                pref.set(step + 1, matrix_mult(pref.get(step + 1), cur));\n            }\n        }\n    }\n\n    static List<List<Integer>> solve(long n) {\n        if (n == 0) {\n            List<List<Integer>> c = new ArrayList<>();\n            for (int i = 0; i <= k; i++) {\n                List<Integer> row = new ArrayList<>();\n                for (int j = 0; j <= k; j++) {\n                    if (i == j) row.add(1);\n                    else row.add(0);\n                }\n                c.add(row);\n            }\n            return c;\n        }\n\n        long dig = 0;\n        long pw = 1;\n        while (pw <= n / k) {\n            pw *= k;\n            dig++;\n        }\n\n        if (n == pw) {\n            return pref.get((int)dig);\n        }\n\n        long steps = n / pw;\n        long left = n - steps * pw;\n\n        List<List<Integer>> cur_mat = solve(0);\n        List<List<Integer>> cur_coef = pref.get((int)dig);\n\n        for (int i = 0; i < steps; i++) {\n            cur_mat = matrix_mult(cur_mat, cur_coef);\n            cur_coef = shift_by_1(cur_coef);\n        }\n\n        List<List<Integer>> other_mat = solve(left);\n        for (int i = 0; i < steps; i++) {\n            other_mat = shift_by_1(other_mat);\n        }\n\n        return matrix_mult(cur_mat, other_mat);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextLong();\n        k = sc.nextInt();\n        init();\n        List<List<Integer>> mat = solve(n);\n        System.out.println(mat.get(k).get(k));\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00013600854435935616, -3.814689989667386e-06, -7.152555099310121e-07, -8.201262971851975e-05, -2.6940935640595853e-05, -0.005343085154891014, -0.20168210566043854, -1.7881233361549675e-05, -7.152555099310121e-07, -8.594620157964528e-05, -0.016034934669733047, -2.622600959512056e-06, -0.04784348979592323, -0.005267194472253323, -0.00010918975021922961, -0.10029435902833939, 0.0, -0.42870157957077026, 0.0, -0.12693792581558228, -0.0950876846909523, -2.50339189733495e-06, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -0.001032891683280468, -0.07889415323734283, -2.038458114839159e-05, -0.001500552985817194, -1.7881377516459906e-06, -1.6689286894688848e-06, -8.344646857949556e-07, -9.536738616588991e-07, -2.777537883957848e-05, -9.536738616588991e-07, -0.00023576818057335913, -0.018151482567191124, -1.0967194612021558e-05, -0.291122287511825