ar& operator/=(const Modular& o) { return *this *= ~o; }\n\tfriend Modular operator+(const Modular& a, const Modular& b) { return Modular(a) += b; }\n\tfriend Modular operator-(const Modular& a, const Modular& b) { return Modular(a) -= b; }\n\tfriend Modular operator*(const Modular& a, const Modular& b) { return Modular(a) *= b; }\n\tfriend Modular operator/(const Modular& a, const Modular& b) { return Modular(a) /= b; }\n};\nusing num = Modular<1000000007>;\n\nint main() {\n\tios_base::sync_with_stdio(false);\n\tcin.tie(NULL);\n\n\tconst int N = 6, F = 20;\n\tvector<num> p(N * N, 0);\n\tint K; cin >> K;\n\tfor (int i = 0; i < N; i++) p[i * N + i] = 1;\n\tfor (int i = 0; i < K; i++)\n\t\tfor (int j = 0; j < K; j++) {\n\t\t\tint x; cin >> x;\n\t\t\tp[i * N + j] = num(x) / num(100);\n\t\t}\n\n\tvector<num> dp0(1 << F, 0), dp1(1 << F, 0);\n\tvector<int> m0, m1;\n\n\tfor (int i = 0; i < N; i++) {\n\t\tfor (int j = 0; j < i; j++) {\n\t\t\tfor (int k = 0; k < j; k++) {\n\t\t\t\tint mm = (1 << i) ^ (1 << j) ^ (1 << k);\n\t\t\t\tm0.push_back(mm);\n\t\t\t\tm1.push_back(((1 << N) - 1) ^ mm);\n\t\t\t}\n\t\t}\n\t}\n\n\tauto process = [&](int t, vector<int>& masks, vector<num>& dp) {\n\t\tfor (int e = 0; e < (1 << (N / 2 * N)); e++) {\n\t\t\tnum cur = 1;\n\t\t\tint edges[3] = {0, 0, 0};\n\t\t\tfor (int i = 0; i < N / 2 * N; i++) {\n\t\t\t\tint bit = (e >> i) & 1;\n\t\t\t\tnum pp = p[((i / N) * 2 + t) * N + (i % N)];\n\t\t\t\tcur *= bit ? pp : (1 - pp);\n\t\t\t\tedges[i / N] |= bit << (i % N);\n\t\t\t}\n\t\t\tint w = 0;\n\t\t\tfor (int idx = 0; idx < (int)masks.size(); idx++) {\n\t\t\t\tint mask = masks[idx];\n\t\t\t\tint r[3];\n\t\t\t\tfor (int ii = 0; ii < 3; ii++) r[ii] = edges[ii] & mask;\n\t\t\t\tif (r[0] && r[1] && r[2] &&\n\t\t\t\t\t__builtin_popcount(r[0] | r[1] | r[2]) == 3) {\n\t\t\t\t\tint x = __builtin_popcount(r[0] | r[1]);\n\t\t\t\t\tint y = __builtin_popcount(r[0] | r[2]);\n\t\t\t\t\tint z = __builtin_popcount(r[1] | r[2]);\n\t\t\t\t\tif (x >= 2 && y >= 2 && z >= 2