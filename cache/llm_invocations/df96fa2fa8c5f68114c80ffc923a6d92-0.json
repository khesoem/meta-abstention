}\n\t\t\ttot_flow += flow[sink];\n\t\t}\n\t}\n};\n#define IN(a) (2*(a))\n#define OUT(a) (2*(a)+1)\nMinCostMaxFlow mcf;\nvoid add_edge(int i,int j,int x,int y)\n{\n\tint n1 = i*N+j;\n\tint n2 = x*N+y + N*N;\n\tmcf.add_edge(OUT(n1),IN(n2),0,1000000);\n}\nint main()\n{\n#ifndef ONLINE_JUDGE\n\tfreopen(\"in.txt\",\"rt\",stdin);\n#endif\n\tint n,t;\n\tcin>>n>>t;\n\tvector<string> a,b;\n\tN = n;\n\ta.resize(n);\n\tb.resize(n);\n\tint si,sj;\n\tfor(int i=0;i<n;i++)\n\t{\n\t\tcin>>a[i];\n\t\tfor(int j=0;j<n;j++)\n\t\t\tif(a[i][j] == 'Z')\n\t\t\t{\n\t\t\t\tsi = i;\n\t\t\t\tsj = j;\n\t\t\t}\n\t}\n\tmat = a;\n\tfor(int i=0;i<n;i++)\n\t\tcin>>b[i];\n\tmat2 = b;\n\tvector<vector<int> >v;\n\tvector<vector<vector<int> > >vv;\n\tv1 = vector<vector<int> >(N,vector<int>(N,1000000));\n\tini(si,sj,v);\n\tv1 = v;\n\tget(a,vv);\n\tmcf.clear(4*N*N+2);\n\tint src = 4*N*N;\n\tfor(int i=0;i<N*N;i++)\n\t{\n\t\tmcf.add_edge(src,IN(i),0,1000000);\n\t\tmcf.add_edge(OUT(N*N+i),src+1,0,1000000);\n\t}\n\n\tfor(int x=0;x<N;x++)\n\t\tfor(int y=0;y<N;y++)\n\t\t{\n\t\t\tif(isdigit(a[x][y]) )\n\t\t\t{\n\t\t\t\tint k = x*N+y;\n\t\t\t\tmcf.add_edge(IN(k),OUT(k),0,a[x][y]-'0');\n\t\t\t}\n\t\t\tif(isdigit(b[x][y]) )\n\t\t\t{\n\t\t\t\tint k = x*N+y + N*N;\n\t\t\t\tmcf.add_edge(IN(k),OUT(k),0,b[x][y]-'0');\n\t\t\t}\n\n\t\t}\n\n\t\tfor(int i=0;i<N;i++)\n\t\t\tfor(int j=0;j<N;j++)\n\t\t\t\tif(isdigit(b[i][j]) &&b[i][j]!='0')\n\t\t\t\t{\n\t\t\t\t\tfor(unsigned int k=0;k<vv.size();k++)\n\t\t\t\t\t{\n\t\t\t\t\t\tif(vv[k].size())\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tint x = k/N;\n\t\t\t\t\t\t\tint y = k%N;\n\t\t\t\t\t\t\t//if(v[x][y]!=-1 && v[x][y]< vv[k][i][j] || vv[k][i][i]>t) continue;\n\t\t\t\t\t\t\tif(vv[k][i][j]==-1 || vv[k][i][j]>t) continue;\n\t\t\t\t\t\t\tadd_edge(x,y,i,j);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tmcf.cost_flow(src,src+1);\n\n\t\t\t\tcout<<mcf.get_flow()<<endl;\n\t\t\t\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"