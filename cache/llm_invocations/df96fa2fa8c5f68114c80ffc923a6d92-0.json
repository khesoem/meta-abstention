      cur = sink\n            while cur != src:\n                rI = self.p[cur] - 1 if self.p[cur] % 2 else self.p[cur] + 1\n                self.edges[self.p[cur]].Flow -= self.flow[sink]\n                self.edges[rI].Flow += self.flow[sink]\n                self.tot_cost += self.edges[self.p[cur]].Cost * self.flow[sink]\n                cur = self.edges[self.p[cur]].From\n            self.tot_flow += self.flow[sink]\n\ndef IN(a):\n    return 2 * a\n\ndef OUT(a):\n    return 2 * a + 1\n\ndef add_edge_util(i, j, x, y):\n    n1 = i * N + j\n    n2 = x * N + y + N * N\n    mcf.add_edge(OUT(n1), IN(n2), 0, 1000000)\n\ndef ff(x, y, v):\n    q = deque()\n    q.append(x * N + y)\n    while q:\n        x = q[0] // N\n        y = q[0] % N\n        q.popleft()\n        for i in range(4):\n            nx = x + dx[i]\n            ny = y + dy[i]\n            if nx < 0 or nx >= N or ny < 0 or ny >= N or v[nx][ny] != -1 or mat[nx][ny] == 'Y':\n                continue\n            if mat2[nx][ny].isdigit() and mat2[nx][ny] != '0' and (v[x][y] + 1 <= v1[nx][ny] or v1[nx][ny] == -1):\n                v[nx][ny] = v[x][y] + 1\n                if v[nx][ny] != v1[nx][ny]:\n                    q.append(nx * N + ny)\n            elif v1[nx][ny] == -1 or v1[nx][ny] > v[x][y] + 1:\n                v[nx][ny] = v[x][y] + 1\n                q.append(nx * N + ny)\n\ndef ini(x, y, v):\n    v.clear()\n    for _ in range(N):\n        v.append([-1] * N)\n    v[x][y] = 0\n    ff(x, y, v)\n\ndef get(m, vv):\n    vv.clear()\n    for _ in range(N * N):\n        vv.append([])\n    for i in range(N):\n        for j in range(N):\n            if m[i][j].isdigit() and m[i][j] != '0':\n                temp = []\n                ini(i, j, temp)\n                vv[i * N + j] = temp\n\ndef main():\n    global N, mat, mat2, v1, mcf\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    t = int(data[1])\n    idx = 2\n    a = []\n    b = []\n    N = n\n    a = [\"\"] * n\n    b = [\"\"] * n\n    si = sj = 0\n    for i in range(n):\n        a[i] = data[idx]\n        idx += 1\n        for j in range(n):\n            if a[i][j] == 'Z':\n                si = i\n                sj = j\n    mat = a[:]\n    for i in range(n):\n        b[i] = data[idx]\n        idx += 1\n    mat2 = b[:]\n    v = []\n    vv = []\n    v1 = [[1000000] * N for _ in range(N)]\n    ini(si, sj, v)\n    v1 = [row[:] for row in v]\n    get(a, vv)\n    mcf = MinCostMaxFlow(4 * N * N + 2)\n    src = 4 * N * N\n    for i in range(N * N):\n        mcf.add_edge(src, IN(i), 0, 1000000)\n        mcf.add_edge(OUT(N * N + i), src + 1, 0, 1000000)\n    for x in range(N):\n        for y in range(N):\n            if a[x][y].isdigit():\n                k = x * N + y\n                mcf.add_edge(IN(k), OUT(k), 0, int(a[x][y]))\n            if b[x][y].isdigit():\n                k = x * N + y + N * N\n                mcf.add_edge(IN(k), OUT(k), 0, int(b[x][y]))\n    for i in range(N):\n        for j in range(N):\n            if b[i][j].isdigit() and b[i][j] != '0':\n                for k in range(len(vv)):\n                    if vv[k]:\n                        x = k // N\n                        y = k % N\n                        if vv[k][i][j] == -1 or vv[k][i][j] > t:\n                            continue\n                        add_edge_util(x, y, i, j)\n    mcf.cost_flow(src, src + 1)\n    print(mcf.get_flow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920922e-06, 0.0, -1.1920928e-07, -0.00014673587, -0.20898762, -0.00047803417, -0.029881282, -0.004300869, -0.0036695541, -1.1920928e-07, -0.00018356545, -0.04920125, -0.06126977, -8.106199e-06, -5.1377883e-05, 0.0, -1.1920928e-07, -0.0028067739, -3.3378547e-06, -1.072883e-06, -5.960463e-07, -2.3841855e-07, -7.152555e-07, -8.344647e-07, -2.3841855e-07, -1.7404405e-05, 0.0, 0.0, -1.1920928e-07, -8.344647e-07, -2.3841855e-07, -4.29152