 static int daj(List<int[]> kraw, boolean f) {\n        int mask = 0;\n        for (int i = 0; i < kraw.size(); i++) {\n            int[] a = kraw.get(i);\n            for (int j = i + 1; j < kraw.size(); j++) {\n                int[] b = kraw.get(j);\n                if (a[0] != b[0] && a[1] != b[1]) {\n                    for (int k = j + 1; k < kraw.size(); k++) {\n                        int[] c = kraw.get(k);\n                        if (a[0] != c[0] && b[0] != c[0] &&\n                            a[1] != c[1] && b[1] != c[1]) {\n                            mask |= maska[((f ? 126 : 0) ^ (1 << a[1]) ^ (1 << b[1]) ^ (1 << c[1]))];\n                        }\n                    }\n                }\n            }\n        }\n        return mask;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st;\n\n        // read n\n        int n = Integer.parseInt(br.readLine().trim());\n        for (int i = 1; i <= n; i++) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 1; j <= n; j++) {\n                tab[i][j] = Integer.parseInt(st.nextToken());\n            }\n        }\n        int xd = 0;\n        for (int i = 1; i <= 6; i++) {\n            for (int j = i + 1; j <= 6; j++) {\n                for (int k = j + 1; k <= 6; k++) {\n                    maska[(1 << i) ^ (1 << j) ^ (1 << k)] = (1 << xd++);\n                }\n            }\n        }\n        for (int i = n + 1; i <= 6; i++) {\n            tab[i][i] = 100;\n        }\n\n        List<int[]> kraw = new ArrayList<>();\n        int totalNodes = 6;\n        for (int i = 1; i <= totalNodes; i++) {\n            for (int j = 1; j <= totalNodes; j++) {\n                kraw.add(new int[]{i, j});\n            }\n        }\n\n        long odw = pot(100, mod - 2);\n        for (int k = 0; k < 2; k++) {\n            for (int i = 0; i < (1 << 18); i++) {\n                long p = 1;\n                List<int[]> xdList = new ArrayList<>();\n                for (int j = 0; j < 18; j++) {\n                    if (((1 << j) & i) != 0) {\n                        int[] edge = kraw.get(j + k * 18);\n                        p = (p * tab[edge[0]][edge[1]] % mod) * odw % mod;\n                        xdList.add(edge);\n                    } else {\n                        int[] edge = kraw.get(j + k * 18);\n                        p = (p * (100 - tab[edge[0]][edge[1]]) % mod) * odw % mod;\n                    }\n                }\n                int cur = daj(xdList, k == 1);\n                dp[cur][k] = (dp[cur][k] + p) % mod;\n            }\n        }\n\n        long res = 1;\n        for (int i = 0; i < 20; i++) {\n            for (int j = 0; j < (1 << 20); j++) {\n                if (((1 << i) & j) != 0) {\n                    dp[j][0] = (dp[j][0] + dp[j ^ (1 << i)][0]) % mod;\n                }\n            }\n        }\n\n        for (int i = 0; i < (1 << 20); i++) {\n            long val = (dp[i][0] * dp[((1 << 20) - 1) ^ i][1]) % mod;\n            res = (res - val + mod) % mod;\n        }\n\n        System.out.println(res);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0011043755803257227, -0.0006237993948161602, -1.3856492842023727e-06, -0.0008465526043437421, -2.816093228830141e-06, -1.9361264946837764e-07, -0.003184244269505143, -0.04959193989634514, -0.0025074053555727005, -1.2113979209971149e-05, -0.5271315574645996, -0.00296581513248384, -2.2603901015827432e-05, -3.128163257315464e-07, -0.0002446509897708893, -0.07895477861166, -0.013890448957681656, -0.0028786994516849518, -0.02987648919224739, -0.0006285638664849102, -0.7577077150344849, -0.7622886896133423, -2.3319124011322856e-05, -0.00017982252757064998, -2.935296834039036e-06, -0.02630332112312317, -2.2007883671903983e-05, -1.9361264946837764e-07, -7.553032628493384e-05, -1.6240566083070007e-06, -0.0001798225275706