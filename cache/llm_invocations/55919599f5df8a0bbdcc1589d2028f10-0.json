  }\n\n    private static long readLong(DataInputStream dis) throws IOException {\n        long num = 0;\n        int c;\n        boolean neg = false;\n        while ((c = dis.read()) <= ' ') {\n            if (c == -1) return Long.MIN_VALUE;\n        }\n        if (c == '-') {\n            neg = true;\n            c = dis.read();\n        }\n        while (c > ' ') {\n            num = (num << 3) + num + c - '0';\n            c = dis.read();\n        }\n        return neg ? -num : num;\n    }\n\n    private static long modPow(long base, long exp) {\n        base %= MOD;\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef read_long(stream):\n    num = 0\n    c = stream.read(1)\n    while c and c <= b' '[0]:\n        if not c:\n            return -2**63\n        c = stream.read(1)\n    if not c:\n        return -2**63\n    \n    neg = False\n    if c == b'-':\n        neg = True\n        c = stream.read(1)\n    \n    while c and c > b' '[0]:\n        num = (num << 3) + num + c[0] - ord('0')\n        c = stream.read(1)\n    \n    return -num if neg else num\n\ndef mod_pow(base, exp):\n    base %= MOD\n    res = 1\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.buffer.read()\n    stream = iter(data)\n    \n    # Read N, M, L, R\n    values = []\n    current = 0\n    sign = 1\n    parsing = False\n    \n    for byte in data:\n        if byte == ord('-'):\n            sign = -1\n            parsing = True\n        elif byte >= ord('0') and byte <= ord('9'):\n            current