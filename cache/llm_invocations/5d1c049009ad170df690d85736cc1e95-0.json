)\n    for mask in range(max_mask):\n        pc = popcount(mask)\n        v[pc].append(mask)\n        mp[mask] = tot[pc]\n        tot[pc] += 1\n    m = n // 2\n    M = n - m\n    size = 1 << tot[m]\n    f = [0] * size\n    g = [0] * size\n    # first half\n    lim1 = 1 << (m * n)\n    for i in range(lim1):\n        p = 1\n        for j in range(m * n):\n            if (i >> j) & 1:\n                p = p * b[j] % MOD\n            else:\n                p = p * (MOD + 1 - b[j]) % MOD\n        S = [0] * m\n        for row in range(m):\n            S[row] = (i >> (row * n)) & (max_mask - 1)\n        st = 0\n        for mask in v[m]:\n            # extract bits of mask\n            bits = []\n            k = mask\n            while k:\n                bits.append(ctz(k))\n                k &= k - 1\n            bits.sort()\n            found = False\n            for perm in itertools.permutations(bits):\n                ok = True\n                for row in range(m):\n                    if (S[row] >> perm[row]) & 1 == 0:\n                        ok = False\n                        break\n                if ok:\n                    st |= 1 << mp[mask]\n                    found = True\n                    break\n            # if not found, st unchanged\n        f[st] = (f[st] + p) % MOD\n    # second half\n    lim2 = 1 << (M * n)\n    for i in range(lim2):\n        p = 1\n        for j in range(M * n):\n            if (i >> j) & 1:\n                p = p * b[j + n * m] % MOD\n            else:\n                p = p * (MOD + 1 - b[j + n * m]) % MOD\n        S = [0] * M\n        for row in range(M):\n            S[row] = (i >> (row * n)) & (max_mask - 1)\n        st = 0\n        for mask in v[n - m]:\n            # complement mask\n            comp = (max_mask - 1) ^ mask\n            # extract bits of mask (size n-m)\n            bits = []\n            k = mask\n            while k:\n                bits.append(ctz(k))\n                k &= k - 1\n            bits.sort(