h >>> (idx - 64)) & 1) == 1;\n            }\n        }\n\n        StateKey setBit(int idx) {\n            long newLow = low;\n            long newHigh = high;\n            if (idx < 64) {\n                newLow |= (1L << idx);\n            } else {\n                newHigh |= (1L << (idx - 64));\n            }\n            return new StateKey(newLow, newHigh);\n        }\n\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            StateKey stateKey = (StateKey) o;\n            return low == stateKey.low && high == stateKey.high;\n        }\n\n        @Override\n        public int hashCode() {\n            return (int) (low ^ (low >>> 32)) * 31 + (int) (high ^ (high >>> 32));\n        }\n    }\n\n    static int totalMasks;\n    static Map<StateKey, Integer> idMap;\n    static List<int[]> transList;\n    static int idCounter;\n\n    static int dfs(StateKey s) {\n        if (idMap.containsKey(s)) {\n            return idMap.get(s);\n        }\n        int id = ++idCounter;\n        idMap.put(s, id);\n        transList.add(new int[totalMasks]);\n\n        for (int i = 0; i < totalMasks; i++) {\n            StateKey tmp = new StateKey(s.low, s.high);\n            for (int j = 0; j < totalMasks; j++) {\n                if (!tmp.getBit(j)) {\n                    int x = i & j;\n                    while (x != 0) {\n                        int t = lowbit(x);\n                        if (s.getBit(j ^ t)) {\n                            tmp = tmp.setBit(j);\n                            break;\n                        }\n                        x -= t;\n                    }\n                }\n            }\n            int nextId = dfs(tmp);\n            transList.get(id - 1)[i] = nextId;\n        }\n        return id;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        totalMasks = 1 << n;\n\n        int[][] a = new int[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                a[i][j] = sc.nextInt();\n                a[i][j] = mult(a[i][j], power(100, MOD - 2));\n            }\n        }\n\n        int[][] q = new int[n][totalMasks];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < totalMasks; j++) {\n                int prod = 1;\n                for (int k = 0; k < n; k++) {\n                    if ((j >> k & 1) == 1) {\n                        prod = mult(prod, a[i][k]);\n                    } else {\n                        prod = mult(prod, dec(1, a[i][k]));\n                    }\n                }\n                q[i][j] = prod;\n            }\n        }\n\n        idMap = new HashMap<>();\n        transList = new ArrayList<>();\n        idCounter = 0;\n        StateKey initial = new StateKey(1L, 0L);\n        dfs(initial);\n\n        int maxStates = idCounter;\n        int[][] dp = new int[n + 1][maxStates + 1];\n        dp[0][1] = 1;\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= maxStates; j++) {\n                for (int k = 0; k < totalMasks; k++) {\n                    int nextState = transList.get(j - 1)[k];\n                    dp[i][nextState] = add(dp[i][nextState], mult(dp[i - 1][j], q[i - 1][k]));\n                }\n            }\n        }\n\n        // Build full mask: all bits 0..totalMasks-1 set\n        StateKey fullMask;\n        if (totalMasks <= 64) {\n            long low = (totalMasks == 64) ? -1L : (1L << totalMasks) - 1;\n            fullMask = new StateKey(low, 0L);\n        } else {\n            long low = -1L;\n            long high = (totalMasks == 128) ? -1L : (1L << (totalMasks - 64)) - 1;\n            fullMask = new StateKey(low, high);\n        }\n        int finalId = idMap.get(fullMask);\n        System.out.println(dp[n][finalId]);\n        sc.close();\n    }\n}\n```", "token_logp