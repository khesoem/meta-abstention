/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, n = map(int, data[:3])\n    min_diff = float('inf')\n    a2 = b2 = 0\n    for b in range(1, n + 1):\n        a = x * b // y\n        # Check exact matches\n        if a > 0 and x * b - (a - 1) * y == 0:\n            print(f\"{a - 1}/{b}\")\n            return\n        if x * b - a * y == 0:\n            print(f\"{a}/{b}\")\n            return\n        if x * b - (a + 1) * y == 0:\n            print(f\"{a + 1}/{b}\")\n            return\n        # Update best approximation\n        def update(num):\n            nonlocal min_diff, a2, b2\n            diff = abs(x * b - num * y) / (y * b)\n            if diff < min_diff:\n                min_diff = diff\n                a2 = num\n                b2 = b\n        if a > 0:\n            update(a - 1)\n        update(a)\n        update(a + 1)\n    print(f\"{a2}/{b2}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [0.0, 0.0, -0.000125281119835563, -0.0009192770230583847, -2.1457441107486375e-05, -0.06199898570775986, -4.768370445162873e-07, -0.014176612719893456, -0.005235176533460617, -1.311301275563892e-06, -0.2526712715625763, 0.0, -0.015323647297918797, 0.0, -0.029750416055321693, -1.1920928244535389e-07, -0.023245563730597496, -1.7881377516459906e-06, 0.0, -2.264974000354414e-06, -1.1920928244535389e-07, -2.8132995794294402e-05, -0.03804175928235054, -1.1920928244535389e-07, -2.7656173188006505e-05, -2.3841855067985307e-07, -3.576278118089249e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -3.6954811548639555e-06, -0.01815675012767315, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.6927575416048057e-05, -1.3112935448589269e-05, 0.0, -1.1920928244535389e-07, -0.08204806596040726, -3.576278118089249e-07, -0.006799891125410795, -0.00091