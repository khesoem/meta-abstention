101 + j + 1, 1, d*K*K - d*(K-1)*(K-1));\n\t\t\t}\n\t\t}\n\t}\n\tint s, t;\n\ts = n-2;\n\tt = n-1;\n\tint flow = 0, cost = 0;\n\twhile (flow < k) {\n\t\tvector<int> id (n, 0);\n\t\tvector<int> d (n, INF);\n\t\tvector<int> q (n);\n\t\tvector<int> p (n);\n\t\tvector<size_t> p_rib (n);\n\t\tint qh=0, qt=0;\n\t\tq[qt++] = s;\n\t\td[s] = 0;\n\t\twhile (qh != qt) {\n\t\t\tint v = q[qh++];\n\t\t\tid[v] = 2;\n\t\t\tif (qh == n)  qh = 0;\n\t\t\tfor (size_t i=0; i<g[v].size(); ++i) {\n\t\t\t\trib & r = g[v][i];\n\t\t\t\tif (r.f < r.u && d[v] + r.c < d[r.b]) {\n\t\t\t\t\td[r.b] = d[v] + r.c;\n\t\t\t\t\tif (id[r.b] == 0) {\n\t\t\t\t\t\tq[qt++] = r.b;\n\t\t\t\t\t\tif (qt == n)  qt = 0;\n\t\t\t\t\t}\n\t\t\t\t\telse if (id[r.b] == 2) {\n\t\t\t\t\t\tif (--qh == -1)  qh = n-1;\n\t\t\t\t\t\tq[qh] = r.b;\n\t\t\t\t\t}\n\t\t\t\t\tid[r.b] = 1;\n\t\t\t\t\tp[r.b] = v;\n\t\t\t\t\tp_rib[r.b] = i;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif (d[t] == INF)  break;\n\t\tint addflow = k - flow;\n\t\tfor (int v=t; v!=s; v=p[v]) {\n\t\t\tint pv = p[v];  size_t pr = p_rib[v];\n\t\t\taddflow = min (addflow, g[pv][pr].u - g[pv][pr].f);\n\t\t}\n\t\tfor (int v=t; v!=s; v=p[v]) {\n\t\t\tint pv = p[v];  size_t pr = p_rib[v],  r = g[pv][pr].back;\n\t\t\tg[pv][pr].f += addflow;\n\t\t\tg[v][r].f -= addflow;\n\t\t\tcost += g[pv][pr].c * addflow;\n\t\t}\n\t\tflow += addflow;\n\t}\n\tassert(flow == k);\n\tcout<<cost<<endl;\n\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1000 * 1000 * 1000;\n\n    static class Rib {\n        int b, u, c, f;\n        int back;\n\n        Rib(int b, int u, int c, int f, int back) {\n            this.b = b;\n            this.u = u;\n            this.c = c;\n            this.f = f;\n            this.back = back;\n        }\n    }\n\n    static void addRib(List<List<Rib>> g, int a, int b, int u, int c) {\n        Rib r1 = new Rib(b, u, c, 0, g.get(b).size());\n        Rib r2 = new Rib(a, 0, -c, 0, g.get(a).size());\n        g.get(a).add(r1);\n        g.get(b).add(r2);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int n = N * 101 + 2;\n        List<List<Rib>> g = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            g.add(new ArrayList<>());\n        }\n        \n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            x--;\n            addRib(g, n - 2, x * 101, 1, 0);\n        }\n        \n        for (int i = 0; i < 101; i++) {\n            addRib(g, i, n - 1, INF, i * c);\n        }\n        \n        for (int i = 1; i < N; i++) {\n            for (int j = 0; j + 1 < 101; j++) {\n                addRib(g, i * 101 + j, i * 101 + j + 1, INF, 0);\n            }\n        }\n        \n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            u--;\n            v--;\n            for (int j = 0; j + 1 < 101; j++) {\n                for (int K = 1; K <= k; K++) {\n                    int cost = d * K * K - d * (K - 1) * (K - 1);\n                    addRib(g, u * 101 + j, v * 101 + j + 1, 1, cost);\n                    addRib(g, v * 101 + j, u * 101 + j + 1, 1, cost);\n                }\n            }\n        }\n        \n        int s = n - 2;\n        int t = n - 1;\n        int flow = 0, cost = 0;\n        \n        while (flow < k) {\n            int[] id = new int[n];\n            int[] dist = new int[n];\n            int[] q = new int[n];\n            int[] p = new int[n];\n            int[] pRib = new int[n];\n            \n            Arrays.fill(dist, INF);\n            int qh = 0, qt = 0;\n            q[qt++] = s;\n            dist[s] = 0;\n            \n            while (qh != qt) {\n                int v = q[qh++];\n                id[v] = 2;\n                if (qh == n) qh = 0;\n                \n                for (int i = 0; i < g.get(v).size(); i++) {\n                    Rib r = g.get(v).get(i);\n                    if (r.f < r.u && dist[v] + r.c < dist[r.b]) {\n                        dist[r.b] = dist[v] + r.c;\n                        if (id[r.b] == 0) {\n                            q[qt++] = r.b;\n                            if (qt == n) qt = 0;\n                        } else if (id[r.b] == 2) {\n                            if (--qh == -1) qh = n - 1;\n                            q[qh] = r.b;\n                        }\n                        id[r.b] = 1;\n                        p[r.b] = v;\n                        pRib[r.b] = i;\n                    }\n                }\n            }\n            \n            if (dist[t] == INF) break;\n            \n            int addflow = k - flow;\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = pRib[v];\n                addflow = Math.min(addflow, g.get(pv).get(pr).u - g.get(pv).get(pr).f);\n            }\n            \n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = pRib[v];\n                int r = g.get(pv).get(pr).back;\n                g.get(pv).get(pr).f += addflow;\n                g.get(v).get(r).f -= addflow;\n                cost += g.get(pv).get(pr).c * addflow;\n            }\n            \n            flow += addflow;\n        }\n        \n        System.out.println(cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001770101225702092, -4.6491513785440475e-06, -9.536738616588991e-07, -0.0003657863999251276, -1.811964830267243e-05, -0.04300664737820625, -0.1806793361902237, -4.029192859889008e-05, -3.576278118089249e-07, -0.00021979777375236154, -0.061970192939043