tf cap[MAXN],mxflow;\nbool in_queue[MAXN];\nvoid flow(int s, int t){\n\tmemset(in_queue,0,sizeof(in_queue));\n\tmxflow=mncost=0;\n\twhile(1){\n\t\tfill(dist,dist+nodes,INFCOSTO);dist[s]=0;\n\t\tmemset(pre,-1,sizeof(pre));pre[s]=0;\n\t\tmemset(cap,0,sizeof(cap));cap[s]=INFFLUJO;\n\t\tqueue<int> q;q.push(s);in_queue[s]=1;\n\t\twhile(SZ(q)){\n\t\t\tint u=q.front();q.pop();in_queue[u]=0;\n\t\t\tfore(_,0,SZ(g[u])){\n\t\t\t\tint i=g[u][_];\n\t\t\t\tedge &E=e[i];\n\t\t\t\tif(E.rem()&&dist[E.v]>dist[u]+E.cost+1e-9){\n\t\t\t\t\tdist[E.v]=dist[u]+E.cost;\n\t\t\t\t\tpre[E.v]=i;\n\t\t\t\t\tcap[E.v]=min(cap[u],E.rem());\n\t\t\t\t\tif(!in_queue[E.v])q.push(E.v),in_queue[E.v]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(pre[t]<0)break;\n\t\tmxflow+=cap[t];mncost+=cap[t]*dist[t];\n\t\tfor(int v=t;v!=s;v=e[pre[v]].u){\n\t\t\te[pre[v]].flow+=cap[t];e[pre[v]^1].flow-=cap[t];\n\t\t}\n\t}\n}\nint main() {\n  ios::sync_with_stdio(false);\n\tll n,m,k,c,d;\n  cin>>n>>m>>k>>c>>d;\n\tint MAXT=n+k;\n\tif(DEBUG)cout<<\"MAXT: \"<<MAXT<<endl;\n\tvector<int>a(k);\n\tfore(i,0,k){\n\t\tcin>>a[i];a[i]--;\n\t\tadd_edge(SRC,a[i]*MAXT,1,0);\n\t}\n\tfore(j,0,MAXT)add_edge(j,SNC,k,0);\n\tfore(i,0,m) {\n\t\tint x,y;cin>>x>>y;x--,y--;\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(x*MAXT+j,y*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(y*MAXT+j,x*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t}\n\tfore(i,0,n) {\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(i*MAXT+j,i*MAXT+j+1,1,c);\n\t\t}\n\t}\n\tflow(SRC,SNC);\n\tif(DEBUG)cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n\tcout<<mncost<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAXN = 50 * 100 + 15;\n    static int SRC = MAXN - 1;\n    static int SNC = MAXN - 2;\n    static final long INFFLUJO = (long)1e14;\n    static final long INFCOSTO = (long)1e14;\n    static int nodes = MAXN;\n    static List<Integer>[] g = new List[MAXN];\n    static List<Edge> e = new ArrayList<>();\n    static long[] dist = new long[MAXN];\n    static long mncost;\n    static int[] pre = new int[MAXN];\n    static long[] cap = new long[MAXN];\n    static long mxflow;\n    static boolean[] in_queue = new boolean[MAXN];\n    \n    static class Edge {\n        int u, v;\n        long cap, flow;\n        long cost;\n        \n        Edge(int u, int v, long cap, long flow, long cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n        \n        long rem() {\n            return cap - flow;\n        }\n    }\n    \n    static void add_edge(int u, int v, long cap, long cost) {\n        g[u].add(e.size());\n        e.add(new Edge(u, v, cap, 0, cost));\n        g[v].add(e.size());\n        e.add(new Edge(v, u, 0, 0, -cost));\n    }\n    \n    static void flow(int s, int t) {\n        Arrays.fill(in_queue, false);\n        mxflow = 0;\n        mncost = 0;\n        \n        while (true) {\n            Arrays.fill(dist, INFCOSTO);\n            dist[s] = 0;\n            Arrays.fill(pre, -1);\n            pre[s] = 0;\n            Arrays.fill(cap, 0);\n            cap[s] = INFFLUJO;\n            \n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            in_queue[s] = true;\n            \n            while (!q.isEmpty()) {\n                int u = q.poll();\n                in_queue[u] = false;\n                \n                for (int idx : g[u]) {\n                    Edge E = e.get(idx);\n                    if (E.rem() > 0 && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                        dist[E.v] = dist[u] + E.cost;\n                        pre[E.v] = idx;\n                        cap[E.v] = Math.min(cap[u], E.rem());\n                        if (!in_queue[E.v]) {\n                            q.offer(E.v);\n                            in_queue[E.v] = true;\n                        }\n                    }\n                }\n            }\n            \n            if (pre[t] < 0) break;\n            \n            mxflow += cap[t];\n            mncost += cap[t] * dist[t];\n            \n            for (int v = t; v != s; v = e.get(pre[v]).u) {\n                e.get(pre[v]).flow += cap[t];\n                e.get(pre[v] ^ 1).flow -= cap[t];\n            }\n        }\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        long n = Long.parseLong(st.nextToken());\n        long m = Long.parseLong(st.nextToken());\n        long k = Long.parseLong(st.nextToken());\n        long c = Long.parseLong(st.nextToken());\n        long d = Long.parseLong(st.nextToken());\n        \n        int MAXT = (int)(n + k);\n        \n        for (int i = 0; i < MAXN; i++) {\n            g[i] = new ArrayList<>();\n        }\n        \n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int a_val = Integer.parseInt(st.nextToken()) - 1;\n            add_edge(SRC, a_val * MAXT, 1, 0);\n        }\n        \n        for (int j = 0; j < MAXT; j++) {\n            add_edge(j, SNC, (int)k, 0);\n        }\n        \n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            \n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    add_edge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n            \n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    add_edge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n        }\n        \n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c);\n                }\n            }\n        }\n        \n        flow(SRC, SNC);\n        System.out.println(mncost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.260862523457035e-05, -1.7881377516459906e-06, -3.576278118089249e-07, -0.0032795476727187634, -5.1973900554003194e-05, -0.06198408454656601, -0.6931948661804199, -0.011167403310537338, -0.00012373158824630082, -7.128461584215984e-05, -0.0003601856005843729, -4.207999518257566e-05, -1.1920922133867862e-06, -5.709961988031864e-05, -0.0019349202048033476, -2.8609820219571702e-05, -0.07955878227949142, -0.026434434577822685, -0.2813540995121002, -0.201506108045578, -1.1205610462639015e-05, -3.576278118089249e-07, -1.7881377516459906e-06, 0.0, -1.2636104656849056e-05, -0.10132180899381638, 0.0, 0.0, 0.0, -1.1444026313256472e-05, -2.7418097943154862e-06, 0.0, -1.4305104514278355e-06, 0.0, -8.344646857949556e-07, -6.6756979322235566e-06, -1.311301275563892e-06, -0.31327131390571594, -1.8000440832111053e-05, -1.7881377516459906e-06, -3.504691630951129e-05, -1.7881377516459906e-06, -1.9073468138230965e-06, 0.0, -4.768370445162873e-07, -1.1920922133867862e-06, 0.0, -3.814689989667386e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -1.7881377516459906e-06, -6.198863957251888e-06, -6.556489552167477e-06, -4.768370445162873e-07, -1.1920928244535389e-07, -1.2159273865108844e-05, -0.17974644899368286, -0.313276469707489, -1.9550132492440753e-05, -0.45795851945877075, -0.15367008745670319, -0.0019704941660165787, -1.0013530300057027e-05, -1.4781842764932662e-05, -1.13248