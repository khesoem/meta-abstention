while node != source:\n            edge_idx = parent_edge[node]\n            graph_edges[edge_idx].capacity -= flow\n            graph_edges[edge_idx ^ 1].capacity += flow\n            node = graph_edges[edge_idx ^ 1].to\n    \n    # In Python, we won't print to stderr, but we keep the logic\n    # print(f\"flow={total_flow}\", file=sys.stderr)\n    \n    return total_cost\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    \n    positions = []\n    for _ in range(K):\n        pos = int(next(it)) - 1\n        positions.append(pos)\n    \n    connections = []\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        connections.append((u, v))\n    \n    node_count = 0\n    id_map = [[0] * MAX_M for _ in range(51)]\n    for i in range(n):\n        for j in range(MAX_M):\n            id_map[i][j] = node_count\n    \n    source = node_count\n    sink = source + 1\n    \n    global edge_count, adjacency_list\n    adjacency_list = [-1] * MAX_N\n    edge_count = 0\n    \n    for pos in positions:\n        insert_edge(source, id_map[pos][0], 1, 0)\n    \n    for i in range(MAX_M):\n        insert_edge(id_map[0][i], sink, K, C * i)\n    \n    for i in range(n):\n        for j in range(MAX_M - 1):\n            insert_edge(id_map[i][j], id_map[i][j + 1], K, 0)\n    \n    for u, v in connections:\n        for j in range(MAX_M - 1):\n            for k in range(K):\n                insert_edge(id_map[u][j], id_map[v][j + 1], 1, D * (2 * k + 1))\n                insert_edge(id_map[v][j], id_map[u][j + 1], 1, D * (2 * k + 1))\n    \n    result = min_cost_flow(source, sink)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001829695247579366, -5.96046277223649