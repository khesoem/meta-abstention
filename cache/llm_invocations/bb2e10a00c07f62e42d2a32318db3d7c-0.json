{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n#define int long long\nconst int N = 1000000;\nint fr[N+2], src, snk;\nvector<int> gr[N+2];\nconst int INF = 1e9;\nstruct Edge { int a,b,f,c,d; };\nvector<Edge> ed;\nvector<int> adj[N+2];\nvoid addEdge(int a, int b, int cap, int cost) {\n    ed.push_back({a,b,0,cap,cost});\n    adj[a].push_back(ed.size()-1);\n    ed.push_back({b,a,0,0,-cost});\n    adj[b].push_back(ed.size()-1);\n}\nint dis[N+2], inq[N+2], mnf[N+2], pth[N+2];\npair<int,int> spfa(int n) {\n    for (int i=0;i<=n;++i) dis[i]=INF;\n    queue<int> q; q.push(src);\n    dis[src]=0; inq[src]=1; mnf[src]=INF;\n    while (!q.empty()) {\n        int u = q.front(); q.pop(); inq[u]=0;\n        for (int id : adj[u]) {\n            int v = ed[id].b;\n            if (ed[id].c > ed[id].f && dis[v] > dis[u] + ed[id].d) {\n                dis[v] = dis[u] + ed[id].d;\n                pth[v] = id;\n                mnf[v] = min(mnf[u], ed[id].c - ed[id].f);\n                if (!inq[v]) { q.push(v); inq[v]=1; }\n            }\n        }\n    }\n    if (dis[snk] == INF) return {0,0};\n    int v = snk;\n    while (v != src) {\n        int id = pth[v];\n        ed[id].f += mnf[snk];\n        ed[id^1].f -= mnf[snk];\n        v = ed[id].a;\n    }\n    return {mnf[snk], dis[snk] * mnf[snk]};\n}\npair<int,int> mcmf(int n) {\n    int flow = 0, cost = 0;\n    while (true) {\n        auto p = spfa(n);\n        if (!p.first) break;\n        flow += p.first;\n        cost += p.second;\n    }\n    return {flow, cost};\n}\nint32_t main() {\n    ios_base::sync_with_stdio(0); cin.tie(0);\n    int n, m, k, c, d; cin >> n >> m >> k >> c >> d;\n    for (int i=1; i<=k; ++i) { int x; cin >> x; fr[x]++; }\n    for (int i=1; i<=m; ++i) {\n        int u, v; cin >> u >> v;\n        gr[u].push_back(v); gr[v].push_back(u);\n    }\n    src = 0; snk = 100 * n + n + 1;\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            addEdge(n*t+i, n*(t+1)+i, k, 0);\n            for (int x : gr[i])\n                for (int cp = 1; cp <= k; ++cp)\n                    addEdge(n*t+i, n*(t+1)+x, 1, d * (2*cp - 1));\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        if (fr[i]) addEdge(src, i, fr[i], 0);\n    for (int t = 0; t <= 100; ++t)\n        addEdge(n*t+1, snk, k, c * t);\n    cout << mcmf(snk).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    fr = [0] * (n + 1)\n    for _ in range(k):\n        x = int(next(it))\n        fr[x] += 1\n\n    gr = [[] for _ in range(n + 1)]\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        gr[u].append(v)\n        gr[v].append(u)\n\n    src = 0\n    snk = 100 * n + n + 1\n    total_nodes = snk + 1  # include src and snk\n\n    # Edge list and adjacency\n    ed = []  # list of tuples (a, b, f, c, d)\n    adj = [[] for _ in range(total_nodes)]\n\n    def addEdge(a: int, b: int, cap: int, cost: int) -> None:\n        ed.append([a, b, 0, cap, cost])\n        adj[a].append(len(ed) - 1)\n        ed.append([b, a, 0, 0, -cost])\n        adj[b].append(len(ed) - 1)\n\n    # Build time-expanded graph\n    for t in range(100):\n        for i in range(1, n + 1):\n            # stay in place\n            addEdge(n * t + i, n * (t + 1) + i, k, 0)\n            # move to neighbor\n            for x in gr[i]:\n                for cp in range(1, k + 1):\n                    addEdge(n * t + i, n * (t + 1) + x, 1, d * (2 * cp - 1))\n\n    # Source edges\n    for i in range(1, n + 1):\n        if fr[i]:\n            addEdge(src, i, fr[i], 0)\n\n    # Sink edges\n    for t in range(101):\n        addEdge(n * t + 1, snk, k, c * t)\n\n    # MCMF using SPFA\n    dis = [0] * total_nodes\n    inq = [0] * total_nodes\n    mnf = [0] * total_nodes\n    pth = [0] * total_nodes\n\n    def spfa() -> tuple:\n        for i in range(total_nodes):\n            dis[i] = INF\n        q = deque()\n        q.append(src)\n        dis[src] = 0\n        inq[src] = 1\n        mnf[src] = INF\n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for idx in adj[u]:\n                e = ed[idx]\n                v = e[1]\n                if e[3] > e[2] and dis[v] > dis[u] + e[4]:\n                    dis[v] = dis[u] + e[4]\n                    pth[v] = idx\n                    mnf[v] = min(mnf[u], e[3] - e[2])\n                    if not inq[v]:\n                        q.append(v)\n                        inq[v] = 1\n        if dis[snk] == INF:\n            return (0, 0)\n        v = snk\n        while v != src:\n            idx = pth[v]\n            e = ed[idx]\n            e[2] += mnf[snk]\n            ed[idx ^ 1][2] -= mnf[snk]\n            v = e[0]\n        return (mnf[snk], dis[snk] * mnf[snk])\n\n    flow = 0\n    cost = 0\n    while True:\n        f, cst = spfa()\n        if f == 0:\n            break\n        flow += f\n        cost += cst\n\n    print(cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.861018856492592e-06, 0.0, 0.0, -9.905801562126726e-05, -0.0003270567976869643, -1.1920928244535389e-07, -3.3854863431770355e-05, -0.0001267114421352744, -1.1920928244535389e-07, 0.0, -3.6954811548639555e-06, -0.004086715634912252, -0.5506024956703186, -1.1920922133867862e-06, -1.5139465176616795e-05, -2.2172682292875834e-05, -0.008614994585514069, -0.05109841004014015, -0.3164947032928467, -0.09345423430204391, -0.5043947696685791, -0.31327489018440247, -1.5497195136049413e-06, -2.9802276912960224e-06, -7.152555099310121e-07, -9.536738616588991e-07, -0.00034683887497521937, -4.768370445162873e-07, -0.018162604421377182, 0.0, -0.25200381875038147, -1.1920928244535389e-07, -0.5759414434432983, -1.0728830375228426e-06, 0.0, -1.4305104514278355e-06, -1.1920928244535389e-07, -0.0019292091019451618, 0.0, 0.0, -0.00015841660206206143, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -4.768370445162873e-07, -2.5152843591058627e-05, -1.1920928244535389e-07, 0.0, -0.00020358874462544918, -4.6491513785440475e-06, -1.7881377516459906e-06, -2.1934269170742482e-05, -0.00012396997772157192, -1.1920928244535389e-07, 0.0, 0.0, -0.00866604968905449, 0.0, 0.0, -3.6954811548639555e-06, 0.0, -2.3841855067985307e-07, 0.0, -9.536738616588991e-07, 0.0, -1.1444026313256472e-05, -0.00020585325546562672, 0.0, -5.960462772236497e-07, -2.3841855067985307e-07, -1.1444026313256472e-05, 0.0, -1.9550132492440753e-05, -0.000592890428379178, -1.1920928244535389e-07, -1.1920922133867862e-06, 0.0, -1.680836794548668e-05, 0.0, -1.4305104514278355e-06, -0.00036054308293387294, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0,