ntent": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, flow, cost;\n        Edge() { to = 0; cap = 0; flow = 0; cost = 0; }\n        Edge(int to, int cap, int flow, int cost) {\n            this.to = to;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final int MAXV = 14043;\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[MAXV];\n\n    static long answer = 0;\n    static long[] dist = new long[MAXV];\n    static int[] parent = new int[MAXV];\n    static int[] parentEdge = new int[MAXV];\n    static boolean[] inQueue = new boolean[MAXV];\n    static final long INF = (long) 1e18;\n    static int src = MAXV - 2, sink = MAXV - 1;\n\n    static int residual(int id) {\n        return edges.get(id).cap - edges.get(id).flow;\n    }\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        adj[u].add(edges.size());\n        edges.add(new Edge(v, cap, 0, cost));\n        adj[v].add(edges.size());\n        edges.add(new Edge(u, 0, 0, -cost));\n    }\n\n    static void augmentOnce() {\n        for (int i = 0; i < MAXV; ++i) {\n            dist[i] = INF;\n            parent[i] = -1;\n            parentEdge[i] = -1;\n            inQueue[i] = false;\n        }\n        dist[src] = 0;\n\n        ArrayDeque<Integer> q = new ArrayDeque<>();\n        q.addLast(src);\n        inQueue[src] = true;\n\n        while (!q.isEmpty()) {\n            int v = q.pollFirst();\n            inQueue[v] = false;\n            for (int id : adj[v]) {\n                if (residual(id) <= 0) continue;\n                int to = edges.get(id).to;\n                int w = edges.get(id).cost;\n                if (dist[to] > dist[v] + w) {\n                    dist[to] = dist[v] + w;\n                    parent[to] = v;\n                    parentEdge[to] = id;\n                    i