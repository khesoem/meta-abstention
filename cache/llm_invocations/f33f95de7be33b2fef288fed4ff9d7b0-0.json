     Arrays.fill(mark, false);\n        Arrays.fill(dis, 0x3f3f3f3f3f3f3f3fL);\n        q.clear();\n        q.offer(T);\n        dis[T] = 0;\n        mark[T] = true;\n        \n        while (!q.isEmpty()) {\n            int x = q.poll();\n            mark[x] = false;\n            for (int i = head[x]; i != 0; i = nxt[i]) {\n                int y = to[i];\n                if (w[i ^ 1] > 0 && dis[y] > dis[x] + c[i ^ 1]) {\n                    dis[y] = dis[x] + c[i ^ 1];\n                    if (!mark[y]) {\n                        q.offer(y);\n                        mark[y] = true;\n                    }\n                }\n            }\n        }\n        return dis[S] < 1e18;\n    }\n\n    static int dfs(int x, int lim, long[] cost) {\n        int flow = 0;\n        mark[x] = true;\n        if (x == T) return lim;\n        \n        for (int i = head[x]; i != 0; i = nxt[i]) {\n            int y = to[i];\n            if (w[i] == 0 || mark[y]) continue;\n            if (dis[x] != dis[y] + c[i]) continue;\n            \n            int t = dfs(y, Math.min(w[i], lim - flow), cost);\n            w[i] -= t;\n            w[i ^ 1] += t;\n            flow += t;\n            cost[0] += (long) t * c[i];\n            \n            if (flow == lim) return lim;\n        }\n        return flow;\n    }\n\n    static long costflow() {\n        int flow = 0;\n        long[] cost = new long[1];\n        cost[0] = 0;\n        \n        while (spfa()) {\n            Arrays.fill(mark, false);\n            do {\n                Arrays.fill(mark, false);\n                flow += dfs(S, inf, cost);\n            } while (mark[T]);\n        }\n        return cost[0];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int lim = 101;\n        \n        for (int i = 0; i < k; i++) {