{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n<your_rewritten_code_2>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 10005;\nconst int MAX_EDGES = 1000000;\nconst long long INF = 1LL << 50;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nvector<Edge> adj[MAX_NODES];\nint dist[MAX_NODES], prevv[MAX_NODES], preve[MAX_NODES];\nbool inq[MAX_NODES];\n\nvoid add_edge(int u, int v, int cap, int cost) {\n    adj[u].emplace_back(v, cap, cost, adj[v].size());\n    adj[v].emplace_back(u, 0, -cost, adj[u].size() - 1);\n}\n\nlong long min_cost_flow(int s, int t) {\n    long long total_cost = 0;\n    while (true) {\n        fill(dist, dist + MAX_NODES, INF);\n        fill(inq, inq + MAX_NODES, false);\n        queue<int> q;\n        dist[s] = 0;\n        q.push(s);\n        inq[s] = true;\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            for (int i = 0; i < adj[u].size(); ++i) {\n                auto& e = adj[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[t] == INF) break;\n\n        long long flow = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            flow = min(flow, (long long)adj[prevv[v]][preve[v]].cap);\n        }\n\n        for (int v = t; v != s; v = prevv[v]) {\n            auto& e = adj[prevv[v]][preve[v]];\n            e.cap -= flow;\n            adj[v][e.rev].cap += flow;\n            total_cost += flow * e.cost;\n        }\n    }\n    return total_cost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> a(k + 1);\n    for (int i = 1; i <= k; ++i) cin >> a[i];\n\n    int source = 0;\n    int sink = n * 100 + 1;\n\n    for (int f = 1; f <= 100; ++f) {\n        add_edge(f, sink, INT_MAX, 0);\n    }\n\n    for (int i = 1; i <= k; ++i) {\n        add_edge(source, (a[i] - 1) * 100 + 1, 1, 0);\n    }\n\n    for (int floor = 2; floor <= n; ++floor) {\n        for (int lvl = 1; lvl < 100; ++lvl) {\n            add_edge((floor - 1) * 100 + lvl, (floor - 1) * 100 + lvl + 1, INT_MAX, c);\n        }\n    }\n\n    int u, v;\n    for (int _ = 0; _ < m; ++_) {\n        cin >> u >> v;\n        for (int lvl = 1; lvl < 100; ++lvl) {\n            for (int grp = 1; grp <= k; ++grp) {\n                int cost_val = c + d * (grp * grp - (grp - 1) * (grp - 1));\n                add_edge((u - 1) * 100 + lvl, (v - 1) * 100 + lvl + 1, 1, cost_val);\n                add_edge((v - 1) * 100 + lvl, (u - 1) * 100 + lvl + 1, 1, cost_val);\n            }\n        }\n    }\n\n    cout << min_cost_flow(source, sink) << '\\n';\n    return 0;\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_NODES = 10005;\n    static final int MAX_EDGES = 1000000;\n    static final long INF = 1L << 50;\n\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int t, int c, int co, int r) {\n            to = t;\n            cap = c;\n            cost = co;\n            rev = r;\n        }\n    }\n\n    static List<Edge>[] adj = new List[MAX_NODES];\n    static int[] dist = new int[MAX_NODES];\n    static int[] prevv = new int[MAX_NODES];\n    static int[] preve = new int[MAX_NODES];\n    static boolean[] inq = new boolean[MAX_NODES];\n\n    static void add_edge(int u, int v, int cap, int cost) {\n        adj[u].add(new Edge(v, cap, cost, adj[v].size()));\n        adj[v].add(new Edge(u, 0, -cost, adj[u].size() - 1));\n    }\n\n    static long min_cost_flow(int s, int t) {\n        long total_cost = 0;\n        while (true) {\n            Arrays.fill(dist, Integer.MAX_VALUE);\n            Arrays.fill(inq, false);\n            Queue<Integer> q = new LinkedList<>();\n            dist[s] = 0;\n            q.offer(s);\n            inq[s] = true;\n\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n                for (int i = 0; i < adj[u].size(); ++i) {\n                    Edge e = adj[u].get(i);\n                    if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == Integer.MAX_VALUE) break;\n\n            long flow = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                flow = Math.min(flow, (long) adj[prevv[v]][preve[v]].cap);\n            }\n\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = adj[prevv[v]][preve[v]];\n                e.cap -= flow;\n                adj[v].get(e.rev).cap += flow;\n                total_cost += flow * e.cost;\n            }\n        }\n        return total_cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int[] a = new int[k + 1];\n        for (int i = 1; i <= k; ++i) {\n            a[i] = sc.nextInt();\n        }\n\n        int source = 0;\n        int sink = n * 100 + 1;\n\n        for (int i = 0; i < MAX_NODES; ++i) {\n            adj[i] = new ArrayList<>();\n        }\n\n        for (int f = 1; f <= 100; ++f) {\n            add_edge(f, sink, Integer.MAX_VALUE, 0);\n        }\n\n        for (int i = 1; i <= k; ++i) {\n            add_edge(source, (a[i] - 1) * 100 + 1, 1, 0);\n        }\n\n        for (int floor = 2; floor <= n; ++floor) {\n            for (int lvl = 1; lvl < 100; ++lvl) {\n                add_edge((floor - 1) * 100 + lvl, (floor - 1) * 100 + lvl + 1, Integer.MAX_VALUE, c);\n            }\n        }\n\n        for (int _ = 0; _ < m; ++_) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int lvl = 1; lvl < 100; ++lvl) {\n                for (int grp = 1; grp <= k; ++grp) {\n                    int cost_val = c + d * (grp * grp - (grp - 1) * (grp - 1));\n                    add_edge((u - 1) * 100 + lvl, (v - 1) * 100 + lvl + 1, 1, cost_val);\n                    add_edge((v - 1) * 100 + lvl, (u - 1) * 100 + lvl + 1, 1, cost_val);\n                }\n            }\n        }\n\n        System.out.println(min_cost_flow(source, sink));\n    }\n}