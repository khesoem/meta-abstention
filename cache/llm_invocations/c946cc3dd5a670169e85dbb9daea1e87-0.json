\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, p = map(int, data[:3])\n    p2 = p * p\n    if n & 1:\n        print(fp(k, n, p))\n        return\n    coeff = [0] * (MaxB)\n    coeff[0] = 1\n    limit = roundToPow(n + 1) - 1\n    fac, invF = prepare(limit, p)\n    bt = [0] * (MaxB)\n    for i in range(limit+1):\n        bt[i] = bin(i).count('1')\n    boxB = [[0]*(MaxB) for _ in range(Layers)]\n    for i in range(limit+1):\n        boxB[bt[i]][i] = invF[i]\n    for u in range(Layers):\n        FWTh(boxB[u], limit+1, p=p)\n    ok = k\n    mods = [[0]*(MaxB) for _ in range(Layers)]\n    boxA = [[0]*(MaxB) for _ in range(Layers)]\n    boxC = [[0]*(MaxB) for _ in range(Layers)]\n    while k:\n        if k & 1:\n            conv(False, boxA, boxB, boxC, bt, coeff, limit, p, p2, mods)\n        k >>= 1\n        if k:\n            conv(True, boxA, boxB, boxC, bt, coeff, limit, p, p2, mods)\n    ans = (fp(ok, n, p) - fac[n] * coeff[n] % p + p) % p\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.1973900554003194e-05, -2.3841855067985307e-07, 0.0, -0.00015496007108595222, -0.0004702892620116472, -5.960462772236497e-07, -0.04861390218138695, -0.03531664237380028, 0.0, -7.152555099310121e-07, -3.540453326422721e-05, 0.0, -1.2993727978027891e-05, 0.0, -2.9802276912960224e-06, 0.0, 0.0, 0.0, -1.4305104514278355e-06, -7.950943836476654e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -3.576272320060525e-06, -0.0005613181856460869, -0.27884840965270996, -0.3328826129436493, -1.764281842042692e-05, -0.0019306369358673692, 0.0, -0.011056703515350819, -0.0789518803358078, -0.0016469499096274376, 0.0, -0.0014083001296967268, -2.3841855067985307e-07, 0.0, 0.0, -0.0005530973430722952, 0.0, -0.04863763228058815, 0.0, -0.00026174934464506805, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -2.50339189733495e-06, -2.38418550