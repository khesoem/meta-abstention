      q.pop();\n            inq[now]=0;\n            for (int i=0;i<sz(G[now]);i++)\n            {\n                edge &e=G[now][i];\n                if (e.cap>0&&dist[now]+e.cost<dist[e.to])\n                {\n                    dist[e.to]=dist[now]+e.cost;\n                    prevv[e.to]=now;\n                    preve[e.to]=i;\n                    if (!inq[e.to]) inq[e.to]=1,q.push(e.to);\n                }\n            }\n        }\n\n        if (dist[t]==inff) return -1;\n\n        int d=f;\n        for (int v=t;v!=s;v=prevv[v])\n        {\n            d=min(d,G[prevv[v]][preve[v]].cap);\n        }\n        f-=d;\n        res+=d*dist[t];\n        for (int v=t;v!=s;v=prevv[v])\n        {\n            edge &e=G[prevv[v]][preve[v]];\n            e.cap-=d;\n            G[v][e.rev].cap+=d;\n        }\n    }\n    return res;\n}\n\nint N,M,K,C,D,X,Y;\nint A[58];\nvector<int> H[57];\n\nint32_t main()\n{\n    IOS\n    cin>>N>>M>>K>>C>>D;\n    for (int i=1;i<=K;i++)\n    {\n        cin>>X;\n        A[X]++;\n    }\n    for (int i=1;i<=M;i++)\n    {\n        cin>>X>>Y;\n        H[X].pb(Y);\n        H[Y].pb(X);\n    }\n\n    init(5103,0,5101);\n    for (int i=2;i<=N;i++) add_edge(0,i,A[i],0);\n    for (int i=0;i<=100;i++)\n    {\n        for (int l=1;l<=N;l++)\n        {\n            add_edge(50*i+l,50*(i+1)+l,K,0);\n            for (int j:H[l])\n            {\n                for (int k=1;k<=K;k++)\n                {\n                    add_edge(50*i+l,50*(i+1)+j,1,D*(2*k-1));\n                }\n            }\n        }\n    }\n    for (int i=1;i<=101;i++) add_edge(50*i+1,5101,K,C*i);\n    cout<<min_cost_flow(K)<<endl;\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, cost, rev;\n    }\n\n    static class Pair implements Comparable<Pair> {\n        int first, second;\n\n        public Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n\n        @Override\n        public int compareTo(Pair o) {\n            return Integer.compare(this.first, o.first);\n        }\n    }\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        String nextLine() {\n            String str = \"\";\n            try {\n                str = br.readLine();\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n            return str;\n        }\n    }\n\n    static FastReader sc = new FastReader();\n    static PrintWriter out = new PrintWriter(System.out);\n\n    static int mod = (int) 1e9 + 7;\n    static int inf = (int) 1e9;\n    static int inff = (int) 1e18;\n\n    static int n, s, t;\n    static ArrayList<Edge>[] G;\n    static int[] dist;\n    static int[] prevv;\n    static int[] preve;\n    static boolean[] inq;\n\n    static void init(int _n, int _s, int _t) {\n        n = _n;\n        s = _s;\n        t = _t;\n        G = new ArrayList[n + 1];\n        for (int i = 0; i <= n; i++) {\n            G[i] = new ArrayList<>();\n        }\n        dist = new int[n + 1];\n        prevv = new int[n + 1];\n        preve = new int[n + 1];\n        inq = new boolean[n + 1];\n    }\n\n    static void add_edge(int from, int to, int cap, int cost) {\n        G[from].add(new Edge(to, cap, cost, G[to].size()));\n        G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n    }\n\n    static int min_cost_flow(int f) {\n        int res = 0;\n        while (f > 0) {\n            Arrays.fill(dist, inff);\n            dist[s] = 0;\n            PriorityQueue<Pair> q = new PriorityQueue<>();\n            q.add(new Pair(s, 0));\n            inq[s] = true;\n            while (!q.isEmpty()) {\n                int now = q.peek().first;\n                int cost = q.peek().second;\n                q.poll();\n                inq[now] = false;\n                for (Edge e : G[now]) {\n                    if (e.cap > 0 && dist[now] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[now] + e.cost;\n                        prevv[e.to] = now;\n                        preve[e.to] = G[now].indexOf(e);\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.add(new Pair(e.to, dist[e.to]));\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == inff) return -1;\n\n            int d = f;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = Math.min(d, G[prevv[v]][preve[v]].cap);\n            }\n            f -= d;\n            res += d * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = G[prevv[v]][preve[v]];\n                e.cap -= d;\n                G[v][e.rev].cap += d;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        int N, M, K, C, D;\n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n        int[] A = new int[58];\n        for (int i = 1; i <= K; i++) {\n            int X = sc.nextInt();\n            A[X]++;\n        }\n        for (int i = 1; i <= M; i++) {\n            int X = sc.nextInt();\n            int Y = sc.nextInt();\n            A[X]++;\n            A[Y]++;\n        }\n\n        init(5103, 0, 5101);\n        for (int i = 2; i <= N; i++) {\n            add_edge(0, i, A[i], 0);\n        }\n        for (int i = 0; i <= 100; i++) {\n            for (int l = 1; l <= N; l++) {\n                add_edge(50 * i + l, 50 * (i + 1) + l, K, 0);\n                for (int j : A) {\n                    if (j != l) {\n                        for (int k = 1; k <= K; k++) {\n                            add_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                        }\n                    }\n                }\n            }\n        }\n        for (int i = 1; i <= 101; i++) {\n            add_edge(50 * i + 1, 5101, K, C * i);\n        }\n        out.println(min_cost_flow(K));\n        out.close();\n    }\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.28448784351348877, -0.01649177260696888, -0.31552544236183167, -0.04300736263394356, -0.00013984227553009987, -0.474666029214859, -0.7078676819801331, -0.00028405647026374936, -9.059946933120955e-06, -0.005467013455927372, -0.05121971294283867, -0.07271554321050644, -3.325994475744665e-05, -0.052245426923036575, -0.3023735284805298, -0.04213989898562431, -0.1797207146883011, -0.48753446340560913, -0.3593268096446991, -0.0290511641651392, -0.00032096292125061154, -0.008008274249732494, -0.012730403803288937, -0.022230448201298714, -0.01288151741027832, -8.976862591225654e-05, -0.0004022334178443998, -0.003237834433093667, -0.001118391053751111, -0.2822131812572479, -0.4742906987667084, -0.35025760531425476, -5.69836629438214e-05, -0.03772074729204178, -0.6936284303665161, -1.2304693460464478, -0.6430754065513611, -0.000987301697023213, -0.005612237844616175, -0.000878063787240535, -