{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long double dbl;\n\nstruct Val {\n    dbl a, b;\n    Val(dbl a_ = 0.0L, dbl b_ = 0.0L) : a(a_), b(b_) {}\n};\n\nint n, k;\ndbl p[25];\nvector<Val> dp;\nvector<char> vis;\n\nVal getDp(int msk, int vr) {\n    if (vis[msk]) return dp[msk];\n    vis[msk] = 1;\n\n    if (msk == 0) return dp[msk] = Val(1.0L, 0.0L);\n\n    Val ri;\n    dbl same = 0.0L;\n\n    for (int i = 0; i < n; ++i) {\n        if (i != vr && (msk & (1 << i))) {\n            same += p[i];\n            Val t = getDp(msk ^ (1 << i), vr);\n            ri.a += t.a * p[i];\n            ri.b += t.b * p[i];\n        }\n    }\n\n    return dp[msk] = Val(ri.a / (1.0L - same), ri.b / (1.0L - same));\n}\n\ndouble Solve(int vr) {\n    const double EPS = 1E-9;\n    if (p[vr] < EPS) return 0.0;\n\n    fill(vis.begin(), vis.end(), 0);\n    dp.assign((size_t)1 << 20, Val());\n\n    int total = 1 << n;\n    for (int msk = 1; msk < total; ++msk)\n        if (!(msk & (1 << vr)))\n            getDp(msk, vr);\n\n    Val tot(1.0L, 0.0L);\n    for (int msk = 1; msk < total; ++msk)\n        if (!(msk & (1 << vr))) {\n            tot.a += dp[msk].a;\n            tot.b += dp[msk].b;\n        }\n\n    dbl alp = (1.0L - tot.b) / tot.a;\n\n    Val bad;\n    for (int msk = 0; msk < total; ++msk)\n        if (!(msk & (1 << vr)) && __builtin_popcount(msk) >= k) {\n            bad.a += dp[msk].a;\n            bad.b += dp[msk].b;\n        }\n\n    return (double)(1.0L - (alp * bad.a + bad.b));\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> k;\n    for (int i = 0; i < n; ++i) cin >> p[i];\n\n    dp.resize((size_t)1 << 20);\n    vis.resize((size_t)1 << 20);\n\n    cout << fixed << setprecision(12);\n    for (int i = 0; i < n; ++i) {\n        if (i) cout << ' ';\n        cout << (double)Solve(i);\n    }\n    cout << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef solve(vr, n, k, p):\n    EPS = 1e-9\n    if p[vr] < EPS:\n        return 0.0\n\n    total = 1 << n\n    dp = [None] * total\n    vis = [False] * total\n\n    def get_dp(msk):\n        if vis[msk]:\n            return dp[msk]\n        vis[msk] = True\n\n        if msk == 0:\n            dp[msk] = (1.0, 0.0)\n            return dp[msk]\n\n        ri_a = 0.0\n        ri_b = 0.0\n        same = 0.0\n\n        for i in range(n):\n            if i != vr and (msk & (1 << i)):\n                same += p[i]\n                t = get_dp(msk ^ (1 << i))\n                ri_a += t[0] * p[i]\n                ri_b += t[1] * p[i]\n\n        if abs(1.0 - same) < 1e-12:\n            dp[msk] = (0.0, 0.0)\n        else:\n            dp[msk] = (ri_a / (1.0 - same), ri_b / (1.0 - same))\n        return dp[msk]\n\n    for msk in range(1, total):\n        if not (msk & (1 << vr)):\n            get_dp(msk)\n\n    tot_a = 1.0\n    tot_b = 0.0\n    for msk in range(1, total):\n        if not (msk & (1 << vr)):\n            if dp[msk] is not None:\n                tot_a += dp[msk][0]\n                tot_b += dp[msk][1]\n\n    if abs(tot_a) < 1e-12:\n        return 0.0\n    alp = (1.0 - tot_b) / tot_a\n\n    bad_a = 0.0\n    bad_b = 0.0\n    for msk in range(total):\n        if not (msk & (1 << vr)) and bin(msk).count('1') >= k:\n            if dp[msk] is not None:\n                bad_a += dp[msk][0]\n                bad_b += dp[msk][1]\n\n    result = 1.0 - (alp * bad_a + bad_b)\n    return result\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = list(map(float, data[2:2+n]))\n\n    results = []\n    for i in range(n):\n        results.append(solve(i, n, k, p))\n\n    sys.stdout.write(' '.join(f\"{r:.12f}\" for r in results) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.7656173e-05, 0.0, -2.3841855e-07, -0.0007253638, -0.054065663, -0.0001677134, -0.12728351, -0.7587805, -0.0018275955, -0.07892643, -0.15907794, -0.061998203, -0.13887379, -6.830459e-05, -0.97683406, -0.04933493, -1.001353e-05, -0.0004365683, -1.3113013e-06, -0.0010875508, -0.029819496, -2.264974e-06, -0.0114398, -1.1920922e-06, -3.576278e-07, -4.0531077e-06, -0.25195676, -1.1920922e-06, -0.0069039604, -1.4662635e-05, 0.0, -0.0004606378, -6.1152496e-05, -9.5367386e-07, 0.0, 0.0, -1.4781843e-05, -1.4305105e-06, -1.633154e-05, -7.152555e-07, 0.0, -8.344647e-07, -5.960463e-07, -3.576278e-07, 0.0, -0.5767349, -1.1920928e-07, -0.20141089, -0.052166436, -1.5139465e-05, -2.8610189e-06, 0.0, -5.0067774e-06, -0.002009755, -4.7683704e-07, -0.034722, -0.004416118, -0.08341482, -0.0015942256, -0.0015056713, -1.4305105e-06, -0.12798463, -0.0036758492, -4.7683704e-07, -0.004224306, -8.821448e-06, -0.00016056202, -0.2519358, 0.0, -1.1920928e-07, -2.9802277e-06, -0.022000538, -1.1920922e-06, -0.056758255, -0.00014935808, -0.009793448, 0.0, -2.1