.close();\n    }\n\n    static int nextInt(BufferedReader in) throws IOException {\n        int c = in.read();\n        while (c <= ' ') c = in.read();\n        int x = 0;\n        while (c > ' ') {\n            x = x * 10 + (c - '0');\n            c = in.read();\n        }\n        return x;\n    }\n\n    static long inv(long a) {\n        long g = MOD, x = 0, y = 1;\n        for (long r = a; r != 0; ) {\n            long q = g / r;\n            g %= r;\n            long temp = g;\n            g = r;\n            r = temp;\n            x -= q * y;\n            temp = x;\n            x = y;\n            y = temp;\n        }\n        x %= MOD;\n        if (x < 0) x += MOD;\n        return x;\n    }\n\n    static long ncr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return fact[n] * inv(fact[r]) % MOD * inv(fact[n - r]) % MOD;\n    }\n\n    static long mul(long... vals) {\n        long res = 1;\n        for (long v : vals) res = res * v % MOD;\n        return res;\n    }\n\n    static long add(long a, long b) {\n        long res = a + b;\n        return res >= MOD ? res - MOD : res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <cstdint>\n\nusing namespace std;\n\nconst long long MOD = 998244353LL;\nvector<long long> fact;\n\nlong long add(long long a, long long b) {\n    long long res = a + b;\n    return res >= MOD ? res - MOD : res;\n}\n\nlong long mul(long long v) {\n    return v % MOD;\n}\n\ntemplate<typename... Args>\nlong long mul(long long first, Args... rest) {\n    return (first % MOD) * mul(rest...) % MOD;\n}\n\nlong long inv(long long a) {\n    long long g = MOD, x = 0, y = 1;\n    for (long long r = a; r != 0; ) {\n        long long q = g / r;\n        g %= r;\n        long long temp = g;\n        g = r;\n        r = temp;\n        x -= q * y;\n        temp =