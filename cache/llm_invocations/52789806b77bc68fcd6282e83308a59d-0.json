.popleft()\n            self.inq[u] = False\n\n            for idx in self.G[u]:\n                e = self.edges[idx]\n                if e.cap > e.flow and self.dist[e.v] > self.dist[u] + e.cost:\n                    self.dist[e.v] = self.dist[u] + e.cost\n                    self.prev_edge[e.v] = idx\n                    self.min_cap[e.v] = min(self.min_cap[u], e.cap - e.flow)\n                    if not self.inq[e.v]:\n                        q.append(e.v)\n                        self.inq[e.v] = True\n\n        if self.dist[self.t] == INF:\n            return False, 0, 0\n        \n        flow_sent = self.min_cap[self.t]\n        total_cost = self.dist[self.t]\n        cur = self.t\n        while cur != self.s:\n            self.edges[self.prev_edge[cur]].flow += flow_sent\n            self.edges[self.prev_edge[cur] ^ 1].flow -= flow_sent\n            cur = self.edges[self.prev_edge[cur]].u\n        \n        return True, flow_sent, total_cost\n\n    def compute_min_cost_flow(self, source, sink):\n        self.s = source\n        self.t = sink\n        total_cost = 0\n        total_flow = 0\n\n        while True:\n            found, flow_per_iteration, cost_per_flow = self.bellman_ford()\n            if not found:\n                break\n            total_flow += flow_per_iteration\n            total_cost += flow_per_iteration * cost_per_flow\n        \n        return total_flow, total_cost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D_val = int(next(it))\n\n    solver = MCMF(n * MAX_TIME + 2)\n    source = n * MAX_TIME\n    sink = n * MAX_TIME + 1\n\n    for t in range(MAX_TIME):\n        solver.add_edge(t, sink, k, C * t)\n\n    for i in range(k):\n        x = int(next(it)) - 1\n        solver.add_edge(source, x * MAX_TIME, 1, 0)\n\n    for i in range(n):\n        for t in range(1, MAX_TIME):\n            solver.add_edge(i * MAX_TIME + t - 1, i * MAX_TIME + t, k, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n\n        for t in range(1, MAX_TIME):\n            from1 = u * MAX_TIME + t - 1\n            to1 = v * MAX_TIME + t\n            from2 = v * MAX_TIME + t - 1\n            to2 = u * MAX_TIME + t\n\n            cost_val = D_val\n            for j in range(1, k + 1):\n                solver.add_edge(from1, to1, 1, cost_val)\n                solver.add_edge(from2, to2, 1, cost_val)\n                cost_val += 2 * D_val\n\n    result = solver.compute_min_cost_flow(source, sink)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015889335190877318, -7.152555099310121e-07, -1.1920928244535389e-07, -0.017936529591679573, -0.006733584217727184, -5.960462772236497e-07, -0.00012575789878610522, -0.00031609306461177766, -1.5497195136049413e-06, -0.0004954302567057312, -0.00043752157944254577, -0.07169829308986664, -7.652943895664066e-05, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, -5.960462772236497e-07, -9.417489309271332e-06, -2.0265558760002023e-06, -7.271740287251305e-06, -0.0011039836099371314, -1.0728830375228426e-06, -0.006716533098369837, 0.0, -2.3841855067985307e-07, -0.043135106563568115, 0.0, 0.0, 0.0, -2.0265558760002023e-06, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, -0.00016592556494288146, -3.4570634852570947e-06, -7.152555099310121e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -1.4305104514278355e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -6.031808152329177e-05, -4.160317621426657e-05, -1.9907753085135482e-05, -4.768370445162873e-07, -2.3841855067985307e-07, -0.16022491455078125, -4.768360213347478e-06, -5.245195097813848e-06, -1.1920928244535389e-07, -2.9802276912960224e-06, -6.615896563744172e-05, -3.576278118089249e-07, -2.50339189733495e-06, -1.1920928244535389e-07