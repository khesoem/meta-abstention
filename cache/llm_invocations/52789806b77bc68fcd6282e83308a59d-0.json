{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 5005;\nusing ll = long long;\nconst ll INF = 1000000007LL;\nconst int MAX_TIME = 100;\n\nstruct Edge {\n    int u, v;\n    ll cap, flow, cost;\n};\n\nstruct MCMF {\n    int n, m, s, t;\n    vector<int> G[MAX_NODES];\n    vector<Edge> edges;\n    ll dist[MAX_NODES];\n    bool inq[MAX_NODES];\n    int prev_edge[MAX_NODES];\n    ll min_cap[MAX_NODES];\n\n    MCMF(int total_nodes) : n(total_nodes) {}\n\n    void add_edge(int u, int v, ll capacity, ll expense) {\n        edges.push_back({u, v, capacity, 0, expense});\n        edges.push_back({v, u, 0, 0, -expense});\n        m = edges.size();\n        G[u].push_back(m - 2);\n        G[v].push_back(m - 1);\n    }\n\n    bool bellman_ford(ll &flow_sent, ll &total_cost) {\n        fill(dist, dist + n, INF);\n        fill(inq, inq + n, false);\n        dist[s] = 0;\n        inq[s] = true;\n        prev_edge[s] = 0;\n        min_cap[s] = INF;\n\n        queue<int> q;\n        q.push(s);\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n            inq[u] = false;\n\n            for (int idx : G[u]) {\n                Edge &e = edges[idx];\n                if (e.cap > e.flow && dist[e.v] > dist[u] + e.cost) {\n                    dist[e.v] = dist[u] + e.cost;\n                    prev_edge[e.v] = idx;\n                    min_cap[e.v] = min(min_cap[u], e.cap - e.flow);\n                    if (!inq[e.v]) {\n                        q.push(e.v);\n                        inq[e.v] = true;\n                    }\n                }\n            }\n        }\n\n        if (dist[t] == INF) return false;\n        flow_sent = min_cap[t];\n        total_cost = dist[t];\n        int cur = t;\n        while (cur != s) {\n            edges[prev_edge[cur]].flow += min_cap[t];\n            edges[prev_edge[cur] ^ 1].flow -= min_cap[t];\n            cur = edges[prev_edge[cur]].u;\n        }\n        return true;\n    }\n\n    pair<ll, ll> compute_min_cost_flow(int source, int sink) {\n        s = source;\n        t = sink;\n        ll total_cost = 0;\n        ll total_flow = 0;\n        ll flow_per_iteration, cost_per_flow;\n\n        while (bellman_ford(flow_per_iteration, cost_per_flow)) {\n            total_flow += flow_per_iteration;\n            total_cost += flow_per_iteration * cost_per_flow;\n        }\n        return {total_flow, total_cost};\n    }\n};\n\nint main() {\n    int n, m, k, C, D_val;\n    cin >> n >> m >> k >> C >> D_val;\n\n    MCMF solver(n * MAX_TIME + 2);\n    int source = n * MAX_TIME, sink = n * MAX_TIME + 1;\n\n    for (int t = 0; t < MAX_TIME; t++)\n        solver.add_edge(t, sink, k, C * t);\n\n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        x--;\n        solver.add_edge(source, x * MAX_TIME, 1, 0);\n    }\n\n    for (int i = 0; i < n; i++)\n        for (int t = 1; t < MAX_TIME; t++)\n            solver.add_edge(i * MAX_TIME + t - 1, i * MAX_TIME + t, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        u--; v--;\n\n        for (int t = 1