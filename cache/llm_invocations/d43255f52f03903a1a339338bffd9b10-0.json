{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\n//Start\ntypedef long long ll;\ntypedef double db;\n#define mp(a,b) make_pair((a),(b))\n#define x first\n#define y second\n#define bg begin()\n#define ed end()\n#define sz(a) int((a).size())\n#define pb(a) push_back(a)\n#define R(i,a,b) for(int i=(a),i##E=(b);i<i##E;i++)\n#define L(i,a,b) for(int i=(b)-1,i##E=(a)-1;i>i##E;i--)\nconst int iinf=0x3f3f3f3f;\nconst ll linf=0x3f3f3f3f3f3f3f3f;\n\n//Data\nconst int N=50;\nint n,m,k,c,d,mxt;\n\n//Flows\nconst int fN=(N*3+1)*N+2;\nint s,t,fn;\nvector<int> e[fN],to,fw,co;\nvoid adde(int u,int v,int w,int c){\n    e[u].pb(sz(to)),to.pb(v),fw.pb(w),co.pb(+c);\n    e[v].pb(sz(to)),to.pb(u),fw.pb(0),co.pb(-c);\n}\nint dep[fN],pre[fN]; bool vis[fN];\nbool spfa(){\n    fill(dep,dep+fn,iinf),fill(pre,pre+fn,-1),fill(vis,vis+fn,false);\n    queue<int> q; q.push(s),vis[s]=true,dep[s]=0;\n    while(sz(q)){\n        int u=q.front(); q.pop(),vis[u]=false;\n        for(int v:e[u])if(fw[v]&&dep[to[v]]>dep[u]+co[v])\n            dep[to[v]]=dep[u]+co[v],pre[to[v]]=v,\n            (!vis[to[v]])&&(q.push(to[v]),vis[to[v]]=true);\n    }\n    return dep[t]<iinf;\n}\npair<int,int> mcmf(){\n    pair<int,int> res(0,0);\n    while(spfa()){\n        int f=iinf;\n        for(int u=t;u!=s;u=to[pre[u]^1]) f=min(f,fw[pre[u]]);\n        for(int u=t;u!=s;u=to[pre[u]^1]) fw[pre[u]]-=f,fw[pre[u]^1]+=f;\n        res.x+=f,res.y+=dep[t]*f;\n    }\n    return res;\n}\n\n//Main\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0),cout.tie(0);\n    cin>>n>>m>>k>>c>>d,mxt=N*3+1;\n    fn=(t=(s=n*mxt)+1)+1;\n    R(i,0,k){int u;cin>>u,--u,adde(s,u,1,0);}\n    while(m--){\n        int u,v; cin>>u>>v,--u,--v;\n        R(i,0,mxt-1)R(p,1,k+1)\n            adde(i*n+u,(i+1)*n+v,1,2*d*p-d),\n            adde(i*n+v,(i+1)*n+u,1,2*d*p-d);\n    }\n    R(u,0,n)R(i,0,mxt-1) adde(i*n+u,(i+1)*n+u,k,0);\n    R(i,0,mxt) adde(i*n,t,k,i*c);\n    pair<int,int> ans=mcmf();\n    assert(ans.x==k);\n    cout<<ans.y<<'\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev;\n        long cap, cost;\n        Edge(int to, int rev, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static void addEdge(ArrayList<ArrayList<Edge>> graph, int from, int to, int cap, long cost) {\n        graph.get(from).add(new Edge(to, graph.get(to).size(), cap, cost));\n        graph.get(to).add(new Edge(from, graph.get(from).size() - 1, 0, -cost));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        final int MAXCITIES = 50;\n        int mxt = MAXCITIES * 3 + 1; // 151\n        int tn = n * mxt;\n        int s = tn;\n        int t = s + 1;\n        int fn = t + 1;\n\n        ArrayList<ArrayList<Edge>> graph = new ArrayList<>(fn);\n        for (int i = 0; i < fn; i++) {\n            graph.add(new ArrayList<>());\n        }\n\n        // Source to initial positions\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt() - 1;\n            addEdge(graph, s, u, 1, 0L);\n        }\n\n        // Roads: edges between adjacent time steps\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int time = 0; time < mxt - 1; time++) {\n                for (int p = 1; p <= k; p++) {\n                    long cost = 2L * d * p - d;\n                    addEdge(graph, time * n + u, (time + 1) * n + v, 1, cost);\n                    addEdge(graph, time * n + v, (time + 1) * n + u, 1, cost);\n                }\n            }\n        }\n\n        // Staying edges (capacity k)\n        for (int city = 0; city < n; city++) {\n            for (int time = 0; time < mxt - 1; time++) {\n                addEdge(graph, time * n + city, (time + 1) * n + city, k, 0L);\n            }\n        }\n\n        // Sink edges from city 0 (cost per time step)\n        for (int time = 0; time < mxt; time++) {\n            addEdge(graph, time * n, t, k, (long) time * c);\n        }\n\n        // Min-cost max-flow\n        long flow = 0;\n        long cost = 0;\n        final long INF = Long.MAX_VALUE;\n\n        while (true) {\n            long[] dist = new long[fn];\n            int[] prevv = new int[fn];\n            int[] preve = new int[fn];\n            boolean[] inq = new boolean[fn];\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            inq[s] = true;\n\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                inq[v] = false;\n                for (int i = 0; i < graph.get(v).size(); i++) {\n                    Edge e = graph.get(v).get(i);\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.offer(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            long f = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                f = Math.min(f, graph.get(prevv[v]).get(preve[v]).cap);\n            }\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = graph.get(prevv[v]).get(preve[v]);\n                e.cap -= f;\n                graph.get(v).get(e.rev).cap += f;\n            }\n            flow += f;\n            cost += f * dist[t];\n        }\n\n        System.out.println(cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.6491513785440475e-06, -1.1920928244535389e-07, 0.0, -0.0004478881892282516, -0.00947053637355566, -1.1920928244535389e-07, -4.0649541915627196e-05, -0.016413314267992973, -0.001553520211018622, 0.0, -8.106198947643861e-06, -0.006728137377649546, -0.0003457663697190583, -1.7022383213043213, -0.011066960170865059, 0.0, -8.344646857949556e-07, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -0.0001591317413840443, -1.1920928244535389e-07, -4.529942543740617e-06, 0.0, -2.3841855067985307e-07, 0.0, -1.1444026313256472e-05, 0.0, -0.0031949449330568314, -5.876845170860179e-05, -4.768360213347478e-06, -3.576278118089249e-07, -0.00026127262390218675, -5.960462772236497e-07, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -1.4305104514278355e-06, -4.768370445162873e-