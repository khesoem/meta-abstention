     res += df\n    return res\n\ndx = [-1, 0, 0, 1]\ndy = [0, -1, 1, 0]\n\nn, m = map(int, sys.stdin.readline().split())\nlab = [sys.stdin.readline().strip() for _ in range(n)]\nrea = [sys.stdin.readline().strip() for _ in range(n)]\n\nobs = [[0]*n for _ in range(n)]\ntim = [[0]*n for _ in range(n)]\ndii = [[0]*n for _ in range(n)]\n\nfor i in range(n):\n    for j in range(n):\n        obs[i][j] = 1 if lab[i][j] == 'Y' else 0\n\ndef gbfs(r, c, dis_grid, chk=False):\n    for i in range(n):\n        for j in range(n):\n            dis_grid[i][j] = -1\n    dis_grid[r][c] = 0\n    q = deque()\n    q.append((r, c))\n    while q:\n        p = q.popleft()\n        if chk and dis_grid[p[0]][p[1]] == tim[p[0]][p[1]]:\n            continue\n        for i in range(4):\n            nr = p[0] + dx[i]\n            nc = p[1] + dy[i]\n            if nr < 0 or nr >= n or nc < 0 or nc >= n:\n                continue\n            if dis_grid[nr][nc] != -1:\n                continue\n            if obs[nr][nc]:\n                continue\n            if chk and tim[nr][nc] > -1 and dis_grid[p[0]][p[1]] + 1 > tim[nr][nc]:\n                continue\n            dis_grid[nr][nc] = dis_grid[p[0]][p[1]] + 1\n            q.append((nr, nc))\n\nfor i in range(n):\n    for j in range(n):\n        if lab[i][j] == 'Z':\n            gbfs(i, j, tim)\n        elif lab[i][j] == 'Y':\n            pass\n\nsrc = 2 * n * n + 5\ndst = src + 1\n\nfor x in range(n):\n    for y in range(n):\n        if lab[x][y] == 'Z' or lab[x][y] == 'Y':\n            continue\n        add_edge(src, n * x + y, int(lab[x][y]))\n        add_edge(n * n + n * x + y, dst, int(rea[x][y]))\n        gbfs(x, y, dii, True)\n        for xp in range(n):\n            for yp in range(n):\n                if dii[xp][yp] != -1 and dii[xp][yp] <= m:\n                    add_edge(n * x + y, n * n + n * xp + yp, INF)\n\nprint(mf())\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.03997860103845596, -0.000550529453