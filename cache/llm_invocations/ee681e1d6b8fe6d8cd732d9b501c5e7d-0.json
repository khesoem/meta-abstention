{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <climits>\n#include <algorithm>\n#include <cstdio>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst int INF = 1e9;\n\nstruct MCF {\n    int n;\n    vector<int> prio, curflow, prevedge, prevnode, pot;\n    struct Edge {\n        int to, f, cap, cost, rev;\n    };\n    vector<vector<Edge>> adj;\n\n    MCF(int n) : n(n), prio(n), curflow(n), prevedge(n), prevnode(n), pot(n), adj(n) {}\n\n    void addEdge(int s, int t, int cap, int cost) {\n        Edge a = {t, 0, cap, cost, (int)adj[t].size()};\n        Edge b = {s, 0, 0, -cost, (int)adj[s].size()};\n        adj[s].push_back(a);\n        adj[t].push_back(b);\n    }\n\n    pii minCostFlow(int s, int t) {\n        int flow = 0, flowCost = 0;\n        while (flow < INF) {\n            priority_queue<ll, vector<ll>, greater<ll>> q;\n            q.push(s);\n            fill(prio.begin(), prio.end(), INT_MAX);\n            prio[s] = 0;\n            curflow[s] = INT_MAX;\n\n            while (!q.empty()) {\n                ll cur = q.top(); q.pop();\n                int d = cur >> 32, u = cur;\n                if (d != prio[u]) continue;\n                for (int i = 0; i < (int)adj[u].size(); ++i) {\n                    Edge &e = adj[u][i];\n                    int v = e.to;\n                    if (e.cap <= e.f) continue;\n                    int nprio = prio[u] + e.cost + pot[u] - pot[v];\n                    if (prio[v] > nprio) {\n                        prio[v] = nprio;\n                        q.push(((ll)nprio << 32) + v);\n                        prevnode[v] = u;\n                        prevedge[v] = i;\n                        curflow[v] = min(curflow[u], e.cap - e.f);\n                    }\n                }\n            }\n\n            if (prio[t] == INT_MAX) break;\n\n            for (int i = 0; i < n; ++i)\n                pot[i] += prio[i];\n\n            int df = min(curflow[t], INF - flow);\n            flow += df;\n\n            for (int v = t; v != s; v = prevnode[v]) {\n                Edge &e = adj[prevnode[v]][prevedge[v]];\n                e.f += df;\n                adj[v][e.rev].f -= df;\n                flowCost += df * e.cost;\n            }\n        }\n        return {flow, flowCost};\n    }\n};\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n\n    MCF nt(6 + 107 * n);\n\n    for (int _ = 0; _ < k; ++_) {\n        int x;\n        scanf(\"%d\", &x); --x;\n        nt.addEdge(0, 1 + x, 1, 0);\n    }\n\n    for (int _ = 0; _ < m; ++_) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y); --x; --y;\n        for (int i = 0; i < 105; ++i) {\n            for (int j = 0; j < 51; ++j) {\n                nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1));\n                nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1));\n            }\n        }\n    }\n\n    for (int i = 0; i < 105; ++i)\n        for (int j = 0; j < n; ++j)\n            nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c);\n\n    for (int i = 0; i < 105; ++i)\n        nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0);\n\n    auto ans = nt.minCostFlow(0, 1 + 105 * n);\n    printf(\"%d\\n\", ans.second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nINF = 10**9\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.prio = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n        self.adj = [[] for _ in range(n)]\n    \n    class Edge:\n        def __init__(self, to, f, cap, cost, rev):\n            self.to = to\n            self.f = f\n            self.cap = cap\n            self.cost = cost\n            self.rev = rev\n    \n    def addEdge(self, s, t, cap, cost):\n        a = self.Edge(t, 0, cap, cost, len(self.adj[t]))\n        b = self.Edge(s, 0, 0, -cost, len(self.adj[s]))\n        self.adj[s].append(a)\n        self.adj[t].append(b)\n    \n    def minCostFlow(self, s, t):\n        flow = 0\n        flowCost = 0\n        while flow < INF:\n            q = []\n            heapq.heappush(q, (0, s))\n            self.prio = [sys.maxsize] * self.n\n            self.prio[s] = 0\n            self.curflow = [0] * self.n\n            self.curflow[s] = sys.maxsize\n            \n            while q:\n                d, u = heapq.heappop(q)\n                if d != self.prio[u]:\n                    continue\n                for i in range(len(self.adj[u])):\n                    e = self.adj[u][i]\n                    v = e.to\n                    if e.cap <= e.f:\n                        continue\n                    nprio = self.prio[u] + e.cost + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nprio:\n                        self.prio[v] = nprio\n                        heapq.heappush(q, (nprio, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e.cap - e.f)\n            \n            if self.prio[t] == sys.maxsize:\n                break\n            \n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            \n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            \n            v = t\n            while v != s:\n                e = self.adj[self.prevnode[v]][self.prevedge[v]]\n                e.f += df\n                self.adj[v][e.rev].f -= df\n                flowCost += df * e.cost\n                v = self.prevnode[v]\n        \n        return (flow, flowCost)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    nt = MCF(6 + 107 * n)\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        nt.addEdge(0, 1 + x, 1, 0)\n    \n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for i in range(105):\n            for j in range(51):\n                nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1))\n                nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1))\n    \n    for i in range(105):\n        for j in range(n):\n            nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c)\n    \n    for i in range(105):\n        nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0)\n    \n    ans = nt.minCostFlow(0, 1 + 105 * n)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002033503697020933, -7.152555099310121e-07, -2.3841855067985307e-07, -9.97731985989958e-05, -0.6330937743186951, -0.0017131189815700054, -0.0002649671514518559, -0.0006739014061167836, 