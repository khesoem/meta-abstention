{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<queue>\n#include<vector>\n#define N 100010\nusing namespace std;\ntypedef int typ;\n#define M 1000010\n#define inf 1000000000\n#define winf 1000000000\nstruct edge{\n    int to,rev;\n    int cap;\n    typ cost;\n};\nvector<edge> G[N];\nint all;\nvoid add_edge(int u,int v,int cap,typ cost)\n{\n    G[u].push_back((edge){v,(int)G[v].size(),cap,cost});\n    G[v].push_back((edge){u,(int)G[u].size()-1,0,-cost});\n}\nnamespace min_cost_flow{\n    int prevv[N],preve[N];\n    typ dist[N];\n    bool inq[N];\n    bool spfa(int s,int t)\n    {\n        for(int i=1;i<=all;i++) dist[i]=winf,inq[i]=false;\n        dist[s]=0;\n        queue<int>q;\n        q.push(s);\n        inq[s]=true;\n        while(!q.empty())\n        {\n            int u=q.front();q.pop();\n            inq[u]=false;\n            for(int i=0;i<(int)G[u].size();i++)\n            {\n                edge &e=G[u][i];\n                if(e.cap>0 && dist[u]+e.cost<dist[e.to])\n                {\n                    dist[e.to]=dist[u]+e.cost;\n                    prevv[e.to]=u;\n                    preve[e.to]=i;\n                    if(!inq[e.to]) q.push(e.to),inq[e.to]=true;\n                }\n            }\n        }\n        return dist[t]!=winf;\n    }\n    int maxf;typ minw;\n    void work(int s,int t)\n    {\n        while(spfa(s,t))\n        {\n            int d=inf;\n            for(int v=t;v!=s;v=prevv[v])\n                d=min(d,G[prevv[v]][preve[v]].cap);\n            maxf+=d;\n            minw+=d*dist[t];\n            for(int v=t;v!=s;v=prevv[v])\n            {\n                edge &e=G[prevv[v]][preve[v]];\n                e.cap-=d;\n                G[v][e.rev].cap+=d;\n            }\n        }\n    }\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add_edge(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add_edge(id(t,u),id(t+1,u),inf,0);\n    add_edge(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add_edge(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add_edge(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev;\n        int cap;\n        long cost;\n        Edge(int t, int r, int c, long co) {\n            to = t;\n            rev = r;\n            cap = c;\n            cost = co;\n        }\n    }\n\n    static final long WINFL = Long.MAX_VALUE / 2;\n    static final int INF = Integer.MAX_VALUE / 2;\n    static int all; // total number of vertices\n    static List<List<Edge>> G;\n    static long minw;\n    static int maxf;\n\n    static void add_edge(int u, int v, int cap, long cost) {\n        G.get(u).add(new Edge(v, G.get(v).size(), cap, cost));\n        G.get(v).add(new Edge(u, G.get(u).size() - 1, 0, -cost));\n    }\n\n    static class MinCostFlow {\n        static int[] prevv, preve;\n        static long[] dist;\n        static boolean[] inq;\n\n        static boolean spfa(int s, int t) {\n            Arrays.fill(dist, 1, all + 1, WINFL);\n            Arrays.fill(inq, 1, all + 1, false);\n            dist[s] = 0;\n            Queue<Integer> q = new ArrayDeque<>();\n            q.add(s);\n            inq[s] = true;\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n                for (int i = 0; i < G.get(u).size(); i++) {\n                    Edge e = G.get(u).get(i);\n                    if (e.cap > 0 && dist[u] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.add(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n            return dist[t] != WINFL;\n        }\n\n        static void work(int s, int t) {\n            while (spfa(s, t)) {\n                int d = INF;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, G.get(prevv[v]).get(preve[v]).cap);\n                }\n                maxf += d;\n                minw += d * dist[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = G.get(prevv[v]).get(preve[v]);\n                    e.cap -= d;\n                    G.get(v).get(e.rev).cap += d;\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int maxT = n + k; // t runs 0..n+k inclusive\n        int totalV = n * (maxT + 2) + 5; // ss=1, tt=2, plus vertices for time steps\n        all = totalV;\n        G = new ArrayList<>(all + 1);\n        for (int i = 0; i <= all; i++) G.add(new ArrayList<>());\n\n        // read initial positions\n        st = new StringTokenizer(br.readLine());\n        int[] start = new int[k];\n        for (int i = 0; i < k; i++) {\n            start[i] = Integer.parseInt(st.nextToken());\n        }\n\n        // adjacency list g (1-indexed)\n        List<List<Integer>> g = new ArrayList<>(n + 1);\n        for (int i = 0; i <= n; i++) g.add(new ArrayList<>());\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            g.get(u).add(v);\n            g.get(v).add(u);\n        }\n\n        int ss = 1, tt = 2;\n        // add source edges\n        for (int i = 0; i < k; i++) {\n            int a = start[i];\n            add_edge(ss, id(0, a, n), 1, 0);\n        }\n\n        // add initial infinite edge from time 0 node 1 to sink\n        add_edge(id(0, 1, n), tt, INF, 0);\n\n        // expand graph for time steps\n        for (int t = 0; t <= n + k; t++) {\n            work(t, n, k, c, d, g, tt);\n        }\n\n        MinCostFlow.prevv = new int[all + 1];\n        MinCostFlow.preve = new int[all + 1];\n        MinCostFlow.dist = new long[all + 1];\n        MinCostFlow.inq = new boolean[all + 1];\n        minw = 0;\n        maxf = 0;\n        MinCostFlow.work(ss, tt);\n        System.out.println(minw);\n    }\n\n    static int id(int t, int x, int n) {\n        return t * n + x + 2;\n    }\n\n    static void work(int t, int n, int k, int c, int d, List<List<Integer>> g, int tt) {\n        // all is already set globally\n        for (int u = 1; u <= n; u++) {\n            for (int v : g.get(u)) {\n                for (int p = 1; p <= k; p++) {\n                    add_edge(id(t, u, n), id(t + 1, v, n), 1, d * (2L * p - 1));\n                }\n            }\n        }\n        for (int u = 1; u <= n; u++) {\n            add_edge(id(t, u, n), id(t + 1, u, n), INF, 0);\n        }\n        add_edge(id(t + 1, 1, n), tt, INF, c * (t + 1L));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -7.772143726469949e-05, -3.266281055402942e-05, -2.3841855067985307e-07, -0.07888985425233841, -0.16029132902622223, 0.0, 0.0, -7.152555099310121e-07, -0.00018082413589581847, -0.0004362108593340963, -1.1920928244535389e-07, -0.03899117186665535, -0.004119245335459709, -0.00021920185827184469, -0.014218805357813835, -0.6988635659217834, -1.7881377516459906e-06, -1.0967194612021558e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -0.0007114263135008514, -1.311301275563892e-06, -0.25196924805641174, 0.0, -0.003177833277732134, -1.4305104514278355e-06, -1.2993727978027891e-05, 0.0, -1.4185804502631072e-05, -4.768370445162873e-07, -0.021238166838884354, -0.0002631794777698815, -0.0019290901254862547, -8.391981828026474e-05, -1.5019606351852417, -2.3841855067985307e-07, 0.0, -2.47952248173533e-05, -1.311301275563892e-06, 0.0, -0.011091010645031929, -4.768370445162873e-07, 0.0, -0.017999405041337013, -3.576214658096433e-05, -0.02324544