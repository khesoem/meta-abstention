{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\n<your_rewritten_code_3>\n//package com.company;\n\nimport java.io.*;\nimport java.math.BigInteger;\nimport java.util.*;\n\npublic class Main {\n    public static class Task {\n        private static final int MOD = 998244353;\n\n        private int add(int x, int y) {\n            int res = x + y;\n            if (res >= MOD) res -= MOD;\n            if (res < 0) res += MOD;\n            return res;\n        }\n\n        private int mul(int a, int b) {\n            return (int) ((long) a * b % MOD);\n        }\n\n        private int mul(int... nums) {\n            int prod = 1;\n            for (int num : nums) {\n                prod = mul(prod, num);\n            }\n            return prod;\n        }\n\n        private int[][] stirlingTable;\n        \n        private void buildStirling() {\n            stirlingTable = new int[5001][5001];\n            for (int i = 0; i < 5001; i++) {\n                stirlingTable[i][0] = 0;\n                stirlingTable[0][i] = (i == 1) ? 1 : 0;\n            }\n            for (int i = 1; i < 5001; i++) {\n                stirlingTable[i][i] = 1;\n            }\n            for (int i = 2; i < 5001; i++) {\n                for (int j = 1; j < i; j++) {\n                    stirlingTable[i][j] = add(mul(stirlingTable[i-1][j], i-1), stirlingTable[i-1][j-1]);\n                }\n            }\n        }\n\n        public void solve(Scanner sc, PrintWriter pw) throws IOException {\n            buildStirling();\n            int n = sc.nextInt();\n            int m = sc.nextInt();\n            int k = sc.nextInt();\n            \n            int invM = BigInteger.valueOf(m).modInverse(BigInteger.valueOf(MOD)).intValue();\n            \n            int[] pArray = new int[5001];\n            pArray[0] = 1;\n            int currentN = n;\n            int powerVal = 1;\n            \n            for (int i = 1; i <= k; i++) {\n                powerVal = mul(powerVal, currentN, invM);\n                currentN = add(currentN, MOD - 1);\n                \n                int inner = powerVal;\n                for (int j = i-1; j >= 1; j--) {\n                    int term = mul(stirlingTable[i][j], pArray[j]);\n                    if ((i - j) % 2 == 1) {\n                        inner = add(inner, term);\n                    } else {\n                        inner = add(inner, MOD - term);\n                    }\n                }\n                pArray[i] = inner;\n            }\n            \n            pw.println(pArray[k]);\n        }\n    }\n\n    private static long beginTime, finishTime;\n\n    public static void main(String[] args) throws IOException {\n        Scanner sc = new Scanner(System.in);\n        PrintWriter pw = new PrintWriter(new BufferedOutputStream(System.out));\n\n        Runtime rt = Runtime.getRuntime();\n        long memBefore = rt.totalMemory() - rt.freeMemory();\n        beginTime = System.currentTimeMillis();\n        \n        Task solver = new Task();\n        solver.solve(sc, pw);\n        \n        finishTime = System.currentTimeMillis();\n        long memAfter = rt.totalMemory() - rt.freeMemory();\n        \n        pw.close();\n        System.err.println(\"Memory increased: \" + (memAfter - memBefore) / 1000000);\n        System.err.println(\"Time used: \" + (finishTime - beginTime) + \".\");\n    }\n\n    static class Scanner {\n        private StringTokenizer tokenizer;\n        private BufferedReader reader;\n\n        public Scanner(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream));\n        }\n\n        public Scanner(FileReader file) throws FileNotFoundException {\n            reader = new BufferedReader(file);\n        }\n\n        public String next() throws IOException {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                tokenizer = new StringTokenizer(reader.readLine());\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() throws IOException {\n            return Integer.parseInt(next());\n        }\n\n        public long nextLong() throws IOException {\n            return Long.parseLong(next());\n        }\n\n        public String nextLine() throws IOException {\n            return reader.readLine();\n        }\n\n        public double nextDouble() throws IOException {\n            return Double.parseDouble(next());\n        }\n\n        public boolean ready() throws IOException {\n            return reader.ready();\n        }\n    }\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nfrom collections import defaultdict\n\nMOD = 998244353\n\ndef add(x, y):\n    res = x + y\n    if res >= MOD:\n        res -= MOD\n    if res < 0:\n        res += MOD\n    return res\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef mul_many(*nums):\n    prod = 1\n    for num in nums:\n        prod = mul(prod, num)\n    return prod\n\ndef build_stirling_table(max_n):\n    stirling_table = [[0] * (max_n + 1) for _ in range(max_n + 1)]\n    for i in range(max_n + 1):\n        stirling_table[i][0] = 0\n        stirling_table[0][i] = 1 if i == 1 else 0\n    for i in range(1, max_n + 1):\n        stirling_table[i][i] = 1\n    for i in range(2, max_n + 1):\n        for j in range(1, i):\n            stirling_table[i][j] = add(mul(stirling_table[i-1][j], i-1), stirling_table[i-1][j-1])\n    return stirling_table\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    sc = iter(input_data)\n    \n    n = int(next(sc))\n    m = int(next(sc))\n    k = int(next(sc))\n    \n    # Compute modular inverse of m modulo MOD\n    inv_m = pow(m, MOD - 2, MOD)\n    \n    # Build Stirling table\n    stirling_table = build_stirling_table(5001)\n    \n    p_array = [0] * 5001\n    p_array[0] = 1\n    current_n = n\n    power_val = 1\n    \n    for i in range(1, k + 1):\n        power_val = mul(power_val, current_n, inv_m)\n        current_n = add(current_n, MOD - 1)\n        \n        inner = power_val\n        for j in range(i - 1, 0, -1):\n            term = mul(stirling_table[i][j], p_array[j])\n            if (i - j) % 2 == 1:\n                inner = add(inner, term)\n            else:\n                inner = add(inner, add(0, MOD - term))\n        p_array[i] = inner\n    \n    print(p_array[k])\n\n# Custom iterator for reading tokens\nclass Scanner:\n    def __init__(self, input_stream):\n        self.tokens = input_stream.split()\n        self.index = 0\n    \n    def next(self):\n        if self.index >= len(self.tokens):\n            raise StopIteration(\"No more tokens\")\n        token = self.tokens[self.index]\n        self.index += 1\n        return token\n    \n    def nextInt(self):\n        return int(self.next())\n\nif __name__ == \"__main__\":\n    input_data = sys.stdin.read()\n    tokens = input_data.split()\n    sc_iter = iter(tokens)\n    \n    def next_token():\n        return next(sc_iter)\n    \n    n = int(next_token())\n    m = int(next_token())\n    k = int(next_token())\n    \n    # Compute modular inverse of m modulo MOD\n    inv_m = pow(m, MOD - 2, MOD)\n    \n    # Build Stirling table\n    stirling_table = build_stirling_table(5001)\n    \n    p_array = [0] * 5001\n    p_array[0] = 1\n    current_n = n\n    power_val = 1\n    \n    for i in range(1, k + 1):\n        power_val = mul(power_val, current_n, inv_m)\n        current_n = add(current_n, MOD - 1)\n        \n        inner = power_val\n        for j in range(i - 1, 0, -1):\n            term = mul(stirling_table[i][j], p_array[j])\n            if (i - j) % 2 == 1:\n                inner = add(inner, term)\n            else:\n                inner = add(inner, add(0, MOD - term))\n        p_array[i] = inner\n    \n    print(p_array[k])\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.507317473529838e-05, -1.1920922133867862e-06, -3.576278118089249e-07, -0.23881223797798157, -0.3487892150878906, -1.0728830375228426e-06, -0.033647846430540085, -0.014995352365076542, -0.026302652433514595, -0.007609547581523657, -0.31563547253608704, -3.576278118089249e-07, -0.08134278655052185, -0.00449005514383316, -0.02581450343132019, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.861018856492592e-06, -2.9802276912960224e-06, -2.1457441107486375e-05, -4.95898348162882e-05, -0.0006668727728538215, -7.867782187531702e-06, -2.7418097943154862e-06, -3.4570634852570947e-06, -0.1128820851445198, -0.009844443760812283, -7.188061863416806e-05, -3.4570634852570947e-06, -2.3841855067985307e-07, -1.1205610462639015e-05, -7.152555099310121e-07, -5.8412379075889476e-06, 0.0, -0.012510748580098152, -1.1920928244535389e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -4.5536911784438416e-05, -4.768370445162873e-07, 0.0, -1.2516897186287679e-05, -7.152555099310121e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e