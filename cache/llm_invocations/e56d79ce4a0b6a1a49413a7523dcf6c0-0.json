f && dist[v] > dist[u] + edgeList[idx].d) {\n                dist[v] = dist[u] + edgeList[idx].d;\n                parentEdge[v] = idx;\n                flow[v] = min(flow[u], edgeList[idx].c - edgeList[idx].f);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (dist[sink] == INF) return {0, 0};\n\n    int aug = flow[sink];\n    int cur = sink;\n    while (cur != source) {\n        int eid = parentEdge[cur];\n        edgeList[eid].f += aug;\n        edgeList[eid ^ 1].f -= aug;\n        cur = edgeList[eid].u;\n    }\n\n    return {aug, aug * dist[sink]};\n}\n\npii mcmf(int n) {\n    int totalFlow = 0, totalCost = 0;\n    while (true) {\n        pii res = spfa(n);\n        if (res.first == 0) break;\n        totalFlow += res.first;\n        totalCost += res.second;\n    }\n    return {totalFlow, totalCost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        neighbors[u].push_back(v);\n        neighbors[v].push_back(u);\n    }\n\n    source = 0;\n    sink = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            addEdge(t * n + i, (t + 1) * n + i, k, 0);\n            for (int nb : neighbors[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    addEdge(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        if (freq[i]) {\n            addEdge(source, i, freq[i], 0);\n        }\n    }\n\n    for (int t = 0; t <= 100; ++t) {\n        addEdge(t * n + 1, sink, k, c * t);\n    }\n\n    cout << mcmf(sink).second << '\\n';\n    return 0;\n}\n