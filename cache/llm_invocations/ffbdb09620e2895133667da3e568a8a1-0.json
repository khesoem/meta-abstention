ompute(n, n).subtract(compute(n, h > 0 ? h - 1 : 0));\n        System.out.println(result);\n    }\n\n    public static BigInteger compute(int n, int h) {\n        Map<String, BigInteger> memo = new HashMap<>();\n        return recurse(n, h, memo);\n    }\n\n    private static BigInteger recurse(int n, int h, Map<String, BigInteger> memo) {\n        String key = n + \",\" + h;\n        if (memo.containsKey(key)) {\n            return memo.get(key);\n        }\n        BigInteger result;\n        if (n == 0) {\n            result = BigInteger.ONE;\n        } else if (h == 0) {\n            result = BigInteger.ZERO;\n        } else {\n            BigInteger total = BigInteger.ZERO;\n            for (int i = 0; i < n; i++) {\n                BigInteger left = recurse(i, h - 1, memo);\n                BigInteger right = recurse(n - 1 - i, h - 1, memo);\n                total = total.add(left.multiply(right));\n            }\n            result = total;\n        }\n        memo.put(key, result);\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.004222644027322531, -3.58813522325363e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.0251946150674485e-05, -1.311301275563892e-06, -1.1920928244535389e-07, -0.0002628219372127205, -0.0009614374139346182, -1.1920928244535389e-07, 0.0, 0.0, -0.00012396997772157192, 0.0, -1.1920928244535389e-07, -2.6225699912174605e-05, -1.1920928244535389e-07, 0.0, -4.529942543740617e-06, -2.145764938177308e-06, -2.3841830625315197e-06, -7.152555099310121e-07, 0.0, -3.540453326422721e-05, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, 0.0, -9.536738616588991e-07, -2.1457441107486375e-05, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -1.0728830375228426e-06, 0.0, -4.172316494077677e-06, -1.8000440832111053e-05, 0.0, 0.0, -1.1920928244535389e-07, -6.05564855504781e-05, 0.0, -2.50339189733495e-06, 0.0