o 71 x 31, but we only fill up to lg and k\n    M = [[None] * 31 for _ in range(71)]\n\n    # Initialize M[0][i] for i in range(k)\n    for i in range(k):\n        M[0][i] = Matrix(k + 1)\n        for j in range(k + 1):\n            M[0][i].m[i][j] = 1\n\n    kp = [1, k]  # kp[0] = 1, kp[1] = k\n    lg = 2\n    while kp[lg - 1] <= n // k:\n        kp.append(kp[-1] * k)\n        lg += 1\n\n    # Build matrices for i from 1 to lg-1\n    for i in range(1, lg):\n        M[i][0] = Matrix(k + 1)  # identity\n        for j in range(1, k):\n            M[i][j] = M[i - 1][j - 1] * M[i][j - 1]\n        cpro = Matrix(k + 1)  # identity\n        for j in range(k - 1, -1, -1):\n            cpro = cpro * M[i - 1][j]\n            M[i][j] = M[i][j] * cpro\n\n    ans = Matrix(k + 1)  # identity\n    cc = 0\n    for i in range(lg - 1, -1, -1):\n        while kp[i] <= n:\n            n -= kp[i]\n            ans = M[i][cc] * ans\n            cc = (cc + 1) % k\n\n    ret = 0\n    for i in range(k + 1):\n        ret += ans.m[i][k]\n        ret %= MOD\n    print(ret)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.65590606938349e-06, 0.0, -1.1920928244535389e-07, -0.0012166248634457588, -0.42314329743385315, -1.0251946150674485e-05, -1.1920928244535389e-07, -1.311301275563892e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00021300431399140507, -2.0265558760002023e-06, 0.0, -4.768370445162873e-07, -9.536738616588991e-07, -1.823885577323381e-05, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00043072958942502737, -4.8874615458771586e-05, 0.0, 0.0, -7.152555099310121e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -0.0024780300445854664, -1.1920928244535389e-07, 0.0, -2.777537883957848e-05, -1.0728830375228426e-06, -0.38789185881614685, -1.1920922133867862e-06, -0.0005470209871418774, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -5.209310256759636e-05, 0.0, -2.38418