    \n    INF = int(1e7)\n    \n    seg = [[None, None], [None, None]]\n    \n    for j in range(2):\n        a = [INF] * (n // 2 + 2)\n        a[n // 2] = 0\n        seg[1][j] = SparseTable(a)\n    \n    p = 0\n    \n    for i in range(k - 1, -1, -1):\n        for j in range(2):\n            a = [INF] * (n // 2 + 2)\n            for c in range(min(l[i] + 1, len(a))):\n                best = seg[1 - p][j].query(c + l[i + 1] - l[i], c + l[i + 1] - l[i])\n                best = min(best, 1 + seg[1 - p][1 - j].query(l[i + 1] - (c + r[i] - l[i]), l[i + 1] - c))\n                if r[i] > l[i]:\n                    best = min(best, 2 + seg[1 - p][j].query(c + l[i + 1] - r[i], c + l[i + 1] - l[i] - 1))\n                a[c] = best\n            seg[p][j] = SparseTable(a)\n        p ^= 1\n    \n    p ^= 1\n    ans = min(seg[p][0].query(l[0], l[0]), seg[p][1].query(l[0], l[0]))\n    \n    if ans > 2 * k:\n        print(\"Hungry\")\n    else:\n        print(\"Full\")\n        print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.6503606174374e-05, -1.4305104514278355e-06, -4.768370445162873e-07, -5.4596363042946905e-05, -0.3878691494464874, -2.0265558760002023e-06, -4.649054244509898e-05, -0.00015639036428183317, -0.012510748580098152, -0.5759565830230713, -1.2550022602081299, -0.001141849672421813, -0.5713990330696106, -0.00024101213784888387, -7.152555099310121e-07, -9.059865078597795e-06, -1.0728830375228426e-06, -7.724463648628443e-05, -1.0371154530730564e-05, -4.6491513785440475e-06, -2.3841855067985307e-07, -3.6954811548639555e-06, 0.0, -0.004635896533727646, -0.0001463782973587513, -4.768370445162873e-07, -0.061968959867954254, -0.004091820679605007, -4.768370445162873e-07, -0.00012420836719684303, -0.00261869584210217, -2.3841855067985307e-07, -4.815939246327616e-05, -4.768370445162873e-07, -4.172316494077677e-06, -1.680836794548668e-05, -2.3841855067985307e-07, -2.861018856492592e-06, -0.