             long[] cur = pq.poll();\n                    long d = cur[0];\n                    int u = (int) cur[1];\n                    if (d != dist[u]) continue;\n                    for (int i = 0; i < adj.get(u).size(); ++i) {\n                        Edge e = adj.get(u).get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[u] + e.cost + pot[u] - pot[e.to]) {\n                            dist[e.to] = dist[u] + e.cost + pot[u] - pot[e.to];\n                            par_node[e.to] = u;\n                            par_edge[e.to] = i;\n                            pq.offer(new long[]{dist[e.to], e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] == Long.MAX_VALUE) return -1;\n                for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n                long flow = f;\n                for (int v = t; v != s; v = par_node[v]) {\n                    flow = Math.min(flow, adj.get(par_node[v]).get(par_edge[v]).cap);\n                }\n\n                f -= flow;\n                total_cost += flow * pot[t];\n\n                for (int v = t; v != s; v = par_node[v]) {\n                    Edge e = adj.get(par_node[v]).get(par_edge[v]);\n                    e.cap -= flow;\n                    adj.get(v).get(e.rev).cap += flow;\n                }\n            }\n            return total_cost;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        long N = sc.nextLong();\n        long M = sc.nextLong();\n        long K = sc.nextLong();\n        long C = sc.nextLong();\n        long D = sc.nextLong();\n\n        int[] A = new int[(int)K];\n        for (int i = 0; i < K; ++i) {\n            A[i] = sc.nextInt() - 1;\n        }\n\n        int[] U = new int[(int)M];\n        int[] V = new int[(int)M];\n        for (int i = 0; i < M; ++i) {\n            U[i] = sc.nextInt() - 1;\n            V[i] = sc.nextInt() - 1;\n        }\n\n        MCF network = new MCF((int)(N * 101 + 2));\n        int src = (int)(N * 101);\n        int dst = src + 1;\n\n        for (int i = 0; i < K; ++i) {\n            network.add_edge(src, A[i], 1, 0);\n        }\n\n        for (int day = 0; day <= 100; ++day) {\n            network.add_edge(day * (int)N, dst, (int)K, C * day);\n        }\n\n        for (int day = 0; day < 100; ++day) {\n            for (int node = 0; node < N; ++node) {\n                network.add_edge(day * (int)N + node, (day + 1) * (int)N + node, (int)K, 0);\n            }\n            for (int edge_idx = 0; edge_idx < M; ++edge_idx) {\n                for (int k = 1; k <= K; ++k) {\n                    network.add_edge(day * (int)N + U[edge_idx], (day + 1) * (int)N + V[edge_idx], 1, (2 * k - 1) * D);\n                    network.add_edge(day * (int)N + V[edge_idx], (day + 1) * (int)N + U[edge_idx], 1, (2 * k - 1) * D);\n                }\n            }\n        }\n\n        System.out.println(network.solve(src, dst, K));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010966652916977182, -2.0265558760002023e-06, -5.960462772236497e-07, -0.006081054452806711, -8.082063141046092e-05, -0.47408774495124817, -0.11292926222085953, -0.0006299418746493757, -4.768370445162873e-07, -0.001209242851473391, -0.008614758029580116, -3.194758028257638e-05, -3.8980677345534787e-05, -0.00011836781777674332, -2.586808113846928e-05, -3.576278118089249e-07, -1.0728830375228426e-06, -2.777537883957848e-05, -4.768370445162873e-07, -0.0008051729528233409, -6.794906312279636e-06, -2.861018856492592e-06, -1.0371154530730564e-05, -1.2040065485052764e-05, -2.3841855067985307e-07, -3.576278118089249e-07, -2.9802276912960224e-06, -1.0728830375228426e-06, -4.768370445162873e-07, -2.9802276912960224e-06, -2.264974000354414e-06, -0.0015023384476080537, -3.576278118089249e-07, -0.00013672371278516948, -2.0265558760002023e-06, -2.145764938177308e-06, -1.1920928244535389e-07, -5.