h_back(m-2);\n        g[to].push_back(m-1);\n    }\n    bool bellman(int s,int t,int& flow,int& cost)\n    {\n        for(int i = 0;i <= t; i++)\n            d[i] = inf,inq[i] = 0;\n        d[s] = 0;inq[s] = 1;p[s] = 0;a[s] = inf;\n        queue<int>Q;\n        Q.push(s);\n        while(!Q.empty())\n        {\n            int u = Q.front();\n\n            Q.pop();\n            inq[u] = 0;\n\n            for(int i = 0;i < g[u].size(); i++)\n            {\n                edge& ee = e[g[u][i]];\n\n                //cout<<ee.cap<<\"  \"<<ee.flow<<\"  \"<<d[ee.to]<<\"  \"<<d[u]<<\"  \"<<ee.cost<<endl;\n                if(ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost)\n                {\n                    //cout<<\"zzzz\"<<endl;\n                    d[ee.to] = d[u] + ee.cost;\n                    p[ee.to] = g[u][i];\n                    a[ee.to] = min(a[u],ee.cap - ee.flow);\n                    if(!inq[ee.to])\n                    {\n                        Q.push(ee.to);\n                        //cout<<\"in=\"<<ee.to<<endl;\n                        inq[ee.to] = 1;\n                    }\n                }\n            }\n        }\n\n        //cout<<\"hahaha\"<<endl;\n        if(d[t] == inf)\n            return false;\n        flow += a[t];\n        cost += d[t] * a[t];\n        int u = t;\n        while(u != s){\n            e[p[u]].flow += a[t];\n            e[p[u]^1].flow -= a[t];\n            u = e[p[u]].from;\n        }\n\n        return true;\n    }\n    int minCost(int s,int t)\n    {\n        int flow = 0,cost = 0;\n        while(bellman(s,t,flow,cost));\n        return cost;\n    }\n}solve;\n\n\nint main(){\n    int k,c,d;\n    cin>>n>>m>>k>>c>>d;\n\n    for(int i=1;i<=k;i++){\n        scanf(\"%d\",&a[i]);\n    }\n\n    startPoint=0,endPoint=n*100+1;\n\n    for(int i=1;i<=k;i++){\n        solve.add(startPoint,1+(a[i]-1)*100,1,0);\n    }\n\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<100;j++){\n            int p=(i-1)*100LL;\n            solve.add(p+j,p+j+1,inf,c);\n        }\n    }\n\n    for(int i=1;i<=100;i++)solve.add(i,endPoint,inf,0);\n\n    while(m--){\n        int x,y;\n        scanf(\"%d%d\",&x,&y);\n        for(int i=1;i<100;i++){\n            int p=(x-1)*100+i;\n            int pp=(y-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n        for(int i=1;i<100;i++){\n            int p=(y-1)*100+i;\n            int pp=(x-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n    }\n\n    printf(\"%d\\n\",solve.minCost(startPoint,endPoint));\n    return 0;\n\n\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ninf = 10**9 + 7\n\nclass Edge:\n    def __init__(self, from_node, to_node, cap, flow, cost):\n        self.from_node = from_node\n        self.to_node = to_node\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nclass MCMF:\n    def __init__(self):\n        self.n = 0\n        self.m = 0\n        self.e = []\n        self.g = [[] for _ in range(50005)]\n        self.inq = [0] * 50005\n        self.d = [0] * 50005\n        self.p = [0] * 50005\n        self.a = [0] * 50005\n    \n    def Init(self, n):\n        self.n = n\n        for i in range(n + 1):\n            self.g[i] = []\n        self.e = []\n    \n    def add(self, from_node, to_node, cap, cost):\n        self.e.append(Edge(from_node, to_node, cap, 0, cost))\n        self.e.append(Edge(to_node, from_node, 0, 0, -cost))\n        self.m = len(self.e)\n        self.g[from_node].append(self.m - 2)\n        self.g[to_node].append(self.m - 1)\n    \n    def bellman(self, s, t):\n        for i in range(t + 1):\n            self.d[i] = inf\n            self.inq[i] = 0\n        self.d[s] = 0\n        self.inq[s] = 1\n        self.p[s] = 0\n        self.a[s] = inf\n        Q = deque()\n        Q.append(s)\n        \n        while Q:\n            u = Q.popleft()\n            self.inq[u] = 0\n            \n            for i in range(len(self.g[u])):\n                ee = self.e[self.g[u][i]]\n                if ee.cap > ee.flow and self.d[ee.to_node] > self.d[u] + ee.cost:\n                    self.d[ee.to_node] = self.d[u] + ee.cost\n                    self.p[ee.to_node] = self.g[u][i]\n                    self.a[ee.to_node] = min(self.a[u], ee.cap - ee.flow)\n                    if not self.inq[ee.to_node]:\n                        Q.append(ee.to_node)\n                        self.inq[ee.to_node] = 1\n        \n        if self.d[t] == inf:\n            return False, 0, 0\n        \n        flow = self.a[t]\n        cost = self.d[t] * self.a[t]\n        u = t\n        while u != s:\n            self.e[self.p[u]].flow += self.a[t]\n            self.e[self.p[u] ^ 1].flow -= self.a[t]\n            u = self.e[self.p[u]].from_node\n        \n        return True, flow, cost\n    \n    def minCost(self, s, t):\n        total_flow = 0\n        total_cost = 0\n        while True:\n            success, flow, cost = self.bellman(s, t)\n            if not success:\n                break\n            total_flow += flow\n            total_cost += cost\n        return total_cost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d_val = int(next(it))\n    \n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = int(next(it))\n    \n    startPoint = 0\n    endPoint = n * 100 + 1\n    \n    solve = MCMF()\n    solve.Init(endPoint)\n    \n    for i in range(1, k + 1):\n        solve.add(startPoint, 1 + (a[i] - 1) * 100, 1, 0)\n    \n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            p = (i - 1) * 100\n            solve.add(p + j, p + j + 1, inf, c)\n    \n    for i in range(1, 101):\n        solve.add(i, endPoint, inf, 0)\n    \n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        \n        for i in range(1, 100):\n            p = (x - 1) * 100 + i\n            pp = (y - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost_val = d_val * (j * j - (j - 1) * (j - 1)) + c\n                solve.add(p, pp, 1, cost_val)\n        \n        for i in range(1, 100):\n            p = (y - 1) * 100 + i\n            pp = (x - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost_val = d_val * (j * j - (j - 1) * (j - 1)) + c\n                solve.add(p, pp, 1, cost_val)\n    \n    result = solve.minCost(startPoint, endPoint)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014184899919200689, -1.1920922133867862e-06, -4.768370445162873e-07, -0.0004314445541240275, -0.0008236353169195354, -7.152555099310121e-07, -0.0001811817055568099, -0.00027247529942542315, -1.9073468138230965e-06, -0.004082797560840845, -0.007633681409060955, -0.9137245416641235, -6.318072337307967e-06, -0.01818695291876793, -1.1920928244535389e-07, -0.00016091958968900144, -0.00028880240279249847, -9.059865078597795e-06, 0.0, 0.0, 0.0, -0.0005554801900871098, -0.16036292910575867, -0.01128540001809597, -8.702239938429557e-06, -4.768370445162873e-07, -0.0059287878684699535, -2.0265558760002023e-06, -1.4305104514278355e-06, -1.1920928244535389e-07, -3.2186455882765586e-06, -9.536738616588991e-07, -0.17586608231067657, -0.0015044810716062784, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.00034421717282384634, 0.0, -0.0036487688776105642, -1.5497195136049413e-06, -2.264974000354414e-06, -0.0006529344827868044, -1.311301275563892e-06, -1.2159273865108844e-05, -2.1934269170742482e-05, -2.3841855067985307e-07, -1.66892