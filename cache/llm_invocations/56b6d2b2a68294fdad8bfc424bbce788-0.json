ext(it)\n            pers[i][j] = p * INV100 % MOD\n\ndef solve(pers, al):\n    # Precompute row products: for row r (0,1,2) and each possible 6\u2011bit mask,\n    # the product of (pers[al+r][c] if bit set else 1-pers[al+r][c]) modulo MOD.\n    row_mul = [[0] * 64 for _ in range(3)]\n    for r in range(3):\n        for mask in range(64):\n            prod = 1\n            row = pers[al + r]\n            for c in range(6):\n                if (mask >> c) & 1:\n                    prod = prod * row[c] % MOD\n                else:\n                    prod = prod * (MOD + 1 - row[c]) % MOD\n            row_mul[r][mask] = prod\n\n    l_nums = [0] * FLAGS_SIZE\n    for xx in range(1 << 18):\n        per = row_mul[0][xx & 0x3F]\n        per = per * row_mul[1][(xx >> 6) & 0x3F] % MOD\n        per = per * row_mul[2][(xx >> 12) & 0x3F] % MOD\n        flags = flags_by_xx[xx]\n        l_nums[flags] = (l_nums[flags] + per) % MOD\n    return l_nums\n\ndef main():\n    pers = [[0] * 6 for _ in range(6)]\n    init(pers)\n    u_nums = solve(pers, 0)\n    d_nums = solve(pers, 3)\n\n    # SOS DP: d_nums[mask] becomes sum over submasks of original d_nums\n    for bit in range(20):\n        x = 1 << bit\n        for i in range(FLAGS_SIZE):\n            if (i & x) == 0:\n                d_nums[i | x] = (d_nums[i | x] + d_nums[i]) % MOD\n\n    ans = 0\n    full_mask = FLAGS_SIZE - 1\n    for i in range(FLAGS_SIZE):\n        if u_nums[i] != 0:\n            need = 0\n            for x in range(20):\n                if (i >> x) & 1:\n                    need |= 1 << (19 - x)\n            reach = full_mask ^ need\n            nans = u_nums[i] * (MOD + 1 - d_nums[reach]) % MOD\n            ans = (ans + nans) % MOD\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00075049843871966, -3.576278118089249e-07, -2.264974000354414e-06, -0.002533442573621869, -0.003318163100630045, -2.264974000354414e-06, -1.3