 MOD;\n        cnt2 += cnt2;\n    } else {\n        cnt2++;\n        ll diff = (cnt2 - val) % MOD2;\n        if (diff < 0) diff += MOD2;\n        ans = (ans + (int)diff) % MOD;\n        int start = val ? 0 : 1;\n        for (int i = start; i < 10; ++i) {\n            if (val * 10 + i <= n) {\n                dfs2(val * 10 + i);\n            }\n        }\n    }\n}\n\nint main() {\n    cnt2 = 0;\n    dfs(0, 0);\n    for (int i = 0; i < 7; ++i) {\n        sort(pos[i].begin(), pos[i].end());\n    }\n    pw[0] = 1;\n    for (int i = 1; i < 13; ++i) {\n        pw[i] = pw[i - 1] * 10;\n    }\n    scanf(\"%lld\", &n);\n    cnt2 = -1;\n    dfs2(0);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD = 1000000007\nMOD2 = 998244353\n\npos = [[] for _ in range(7)]\npw = [0] * 15\ns = [0] * 7\ncnt2 = 0\nn = 0\nans = 0\n\ndef query(fixpre, val):\n    global MOD2, MOD\n    res = 0\n    for d in range(7):\n        base = fixpre * pw[d]\n        offset = (val - base) % MOD2\n        if offset < 0:\n            offset += MOD2\n        p = bisect.bisect_left(pos[d], MOD2 - offset)\n        res = (res + s[d] + offset * len(pos[d]) - MOD2 * (len(pos[d]) - p)) % MOD\n    return int(res % MOD)\n\ndef dfs(val, d):\n    global cnt2, MOD2\n    x = (cnt2 - val + MOD2) % MOD2\n    pos[d].append(x)\n    cnt2 += 1\n    s[d] = (s[d] + x) % MOD2\n    if d == 6:\n        return\n    for i in range(10):\n        dfs(val * 10 + i, d + 1)\n\ndef dfs2(val):\n    global cnt2, ans, n, MOD2, MOD\n    if val * 1000000 + 999999 <= n and val * 10000000 > n:\n        ans = (ans + query(val, cnt2 + 1)) % MOD\n        cnt2 += cnt2\n    else:\n        cnt2 += 1\n        diff = (cnt2 - val) % MOD2\n        if diff < 0:\n            diff += MOD2\n        ans = (ans + int(diff)) % MOD\n        start = 0 if val else 1\n        f