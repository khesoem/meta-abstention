007;\n    static final int ZERO = 10001;\n    static final int YJSNPI = 8101919;\n    static final int INF = (1 << 28);\n\n    static class Pair {\n        int first;\n        int second;\n\n        public Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    static class Matrix {\n        int[][] data;\n\n        public Matrix(int n, int m) {\n            data = new int[n][m];\n        }\n\n        public void set(int i, int j, int value) {\n            data[i][j] = value;\n        }\n\n        public int get(int i, int j) {\n            return data[i][j];\n        }\n\n        public Matrix multiply(Matrix other) {\n            Matrix result = new Matrix(data.length, other.data[0].length);\n            for (int i = 0; i < data.length; i++) {\n                for (int k = 0; k < other.data.length; k++) {\n                    for (int j = 0; j < other.data[0].length; j++) {\n                        result.set(i, j, (int) ((result.get(i, j) + (long) data[i][k] * other.get(k, j)) % MOD));\n                    }\n                }\n            }\n            return result;\n        }\n\n        public void print() {\n            for (int i = 0; i < data.length; i++) {\n                for (int j = 0; j < data[0].length; j++) {\n                    System.out.print(data[i][j] + \" \");\n                }\n                System.out.println();\n            }\n            System.out.println();\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int N = Integer.parseInt(st.nextToken());\n        int K = Integer.parseInt(st.nextToken());\n        int cnt = 0;\n        long nN = 1;\n        while (nN <= N) {\n            nN *= K;\n            cnt++;\n        }\n        nN /= K;\n        int[] d = new int[cnt];\n        