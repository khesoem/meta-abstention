\n    if( u == t ) return F;\n    for( int e = now[u]; e; e = now[u] = nxt[e] ){\n        int v = ady[e];\n        if( lev[u] < lev[v] && flow[e] < cap[e] ){\n            int f = dfs( v , min( F , cap[e] - flow[e] ) );\n            if( f ){\n                flow[e] += f;\n                flow[e^1] -= f;\n                return f;\n            }\n        }\n    }\n    return 0;\n}\nint max_flow(){\n    int F = 0;\n    while( bfs() ){\n        for( int i = 0; i <= n; i++ ) now[i] = last[i];\n        int f;\n        while( (f = dfs( s , oo )) ) F += f;\n    }\n    return F;\n}\n\nint R;\nstring m1[MAXR];\nstring m2[MAXR];\n\nint movI[] = { 0 , 1 , 0 , -1 };\nint movJ[] = { 1 , 0 , -1 , 0 };\n\nbool can_move( int i, int j ){\n    return ( i >= 0 && j >= 0 && i < R && j < R && m1[i][j] != 'Y' && m1[i][j] != 'Z' );\n}\n\nint tim[2][MAXR][MAXR];\n\nvoid bfs2( int i, int j, int cc ){\n    for( int k = 0; k < R; k++ ){\n        for( int l = 0; l < R; l++ ){\n            tim[cc][k][l] = 0;\n        }\n    }\n\n    tim[cc][i][j] = 1;\n    queue<pair<int,int>> q;\n    q.push( make_pair( i , j ) );\n    while( !q.empty() ){\n        int ci = q.front().first;\n        int cj = q.front().second;\n        q.pop();\n\n        if( cc == 1 && (tim[0][ci][cj] && tim[0][ci][cj] <= tim[1][ci][cj]) ){\n            continue;\n        }\n\n        for( int k = 0; k < 4; k++ ){\n            int ii = ci + movI[k];\n            int jj = cj + movJ[k];\n\n            if( can_move( ii , jj ) && !tim[cc][ii][jj] ){\n                tim[cc][ii][jj] = tim[cc][ci][cj] + 1;\n                q.push( make_pair( ii , jj ) );\n            }\n        }\n    }\n}\n\nint nod[2][MAXR][MAXR];\n\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n\n    int T; cin >> R >> T;\n\n    int zi = 0, zj = 0;\n\n    int n = 0, s = 0, t = 0;\n\n    for( int i = 0; i < R; i++ ){\n        cin >> m1[i];\n        for( int j = 0; j < R; j++ ){\n            if( m1[i][j] == 'Z' ){\n                zi = i;\n                zj = j;\n            }\n            else if( m1[i][j] != 'Y' ){\n                n++;\n                nod[0][i][j] = n;\n            }\n        }\n    }\n\n    for( int i = 0; i < R; i++ ){\n        cin >> m2[i];\n        for( int j = 0; j < R; j++ ){\n            if( m2[i][j] != 'Y' && m2[i][j] != 'Z' ){\n                n++;\n                nod[1][i][j] = n;\n            }\n        }\n    }\n\n    n++;\n    s = 0;\n    t = n;\n\n    init_maxflow( n , s , t );\n\n    for( int i = 0; i < R; i++ ){\n        for( int j = 0; j < R; j++ ){\n            if( m1[i][j] != 'Z' && m1[i][j] != 'Y' ){\n                add_edge( s , nod[0][i][j] , m1[i][j] - '0' );\n                add_edge( nod[1][i][j] , t , m2[i][j] - '0' );\n            }\n        }\n    }\n\n    bfs2( zi , zj, 0 );\n\n    for( int i = 0; i < R; i++ ){\n        for( int j = 0; j < R; j++ ){\n            if( m1[i][j] > '0' && m1[i][j] <= '9' ){\n                bfs2( i , j , 1 );\n                for( int ii = 0; ii < R; ii++ ){\n                    for( int jj = 0; jj < R; jj++ ){\n                        if( m2[ii][jj] > '0' && m2[ii][jj] <= '9' ){\n                            if( tim[1][ii][jj] && (!tim[0][ii][jj] || tim[0][ii][jj] >= tim[1][ii][jj]) &&\n                                tim[1][ii][jj]-1 <= T ){\n                                add_edge( nod[0][i][j] , nod[1][ii][jj] , oo );\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    cout << max_flow() << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Dinic:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.level = [0] * n\n        self.it = [0] * n\n\n    def add_edge(self, u, v, cap):\n        # forward edge\n        self.adj[u].append([v, cap, len(self.adj[v])])\n        # reverse edge\n        self.adj[v].append([u, 0, len(self.adj[u]) - 1])\n\n    def bfs(self, s, t):\n        self.level = [-1] * self.n\n        q = deque()\n        self.level[s] = 0\n        q.append(s)\n        while q:\n            u = q.popleft()\n            for v, cap, rev in self.adj[u]:\n                if cap > 0 and self.level[v] < 0:\n                    self.level[v] = self.level[u] + 1\n                    q.append(v)\n        return self.level[t] >= 0\n\n    def dfs(self, u, t, f):\n        if u == t:\n            return f\n        for i in range(self.it[u], len(self.adj[u])):\n            self.it[u] = i\n            v, cap, rev = self.adj[u][i]\n            if cap > 0 and self.level[u] < self.level[v]:\n                ret = self.dfs(v, t, min(f, cap))\n                if ret > 0:\n                    # update forward edge\n                    self.adj[u][i][1] -= ret\n                    # update reverse edge\n                    self.adj[v][rev][1] += ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        INF = 10**18\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    R = int(next(it))\n    T = int(next(it))\n    m1 = [list(next(it).strip()) for _ in range(R)]\n    m2 = [list(next(it).strip()) for _ in range(R)]\n\n    # find Z position\n    zi = zj = -1\n    for i in range(R):\n        for j in range(R):\n            if m1[i][j] == 'Z':\n                zi, zj = i, j\n                break\n        if zi != -1:\n            break\n\n    # node numbering: source = 0, sink = last node\n    n = 0\n    nod = [[[0]*R for _ in range(R)] for _ in range(2)]\n    # first grid (m1) nodes\n    for i in range(R):\n        for j in range(R):\n            if m1[i][j] != 'Y' and m1[i][j] != 'Z':\n                n += 1\n                nod[0][i][j] = n\n    # second grid (m2) nodes\n    for i in range(R):\n        for j in range(R):\n            if m2[i][j] != 'Y' and m2[i][j] != 'Z':\n                n += 1\n                nod[1][i][j] = n\n    n += 1  # now n is the sink node index\n    s = 0\n    t = n\n    dinic = Dinic(n + 1)  # nodes 0..n inclusive\n\n    # add edges from source to m1 nodes and from m2 nodes to sink\n    for i in range(R):\n        for j in range(R):\n            if m1[i][j] != 'Z' and m1[i][j] != 'Y':\n                cap = int(m1[i][j])\n                dinic.add_edge(s, nod[0][i][j], cap)\n            if m2[i][j] != 'Y' and m2[i][j] != 'Z':\n                cap = int(m2[i][j])\n                dinic.add_edge(nod[1][i][j], t, cap)\n\n    # BFS from Z to compute tim[0]\n    movI = [0, 1, 0, -1]\n    movJ = [1, 0, -1, 0]\n\n    def can_move(i, j):\n        return 0 <= i < R and 0 <= j < R and m1[i][j] != 'Y' and m1[i][j] != 'Z'\n\n    tim = [[[0]*R for _ in range(R)] for _ in range(2)]\n\n    def bfs2(si, sj, cc):\n        # reset tim[cc]\n        for i in range(R):\n            for j in range(R):\n                tim[cc][i][j] = 0\n        tim[cc][si][sj] = 1\n        q = deque()\n        q.append((si, sj))\n        while q:\n            ci, cj = q.popleft()\n            if cc == 1 and tim[0][ci][cj] and tim[0][ci][cj] <= tim[1][ci][cj]:\n                continue\n            for k in range(4):\n                ni = ci + movI[k]\n                nj = cj + movJ[k]\n                if can_move(ni, nj) and tim[cc][ni][nj] == 0:\n                    tim[cc][ni][nj] = tim[cc][ci][cj] + 1\n                    q.append((ni, nj))\n\n    bfs2(zi, zj, 0)\n\n    INF = 1 << 29\n    # for each m1 cell that is a digit > '0'\n    for i in range(R):\n        for j in range(R):\n            if '1' <= m1[i][j] <= '9':\n                bfs2(i, j, 1)\n                for ii in range(R):\n                    for jj in range(R):\n                        if '1' <= m2[ii][jj] <= '9':\n                            if tim[1][ii][jj] and (not tim[0][ii][jj] or tim[0][ii][jj] >= tim[1][ii][jj]) and (tim[1][ii][jj] - 1 <= T):\n                                dinic.add_edge(nod[0][i][j], nod[1][ii][jj], INF)\n\n    print(dinic.max_flow(s, t))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.02080066315829754, -0.16193728148937225, -6.568216485902667e-05, 0.0, -1.1920928244535389e-07, -0.0002972637885250151, -0.016688739880919456, -3.814689989667386e-06, -4.6491513785440475e-06, -3.766942609217949e-05, -1.1920928244535389e-07, 0.0, -1.5497195136049413e-06, -0.0011994794476777315, -0.8571045994758606, -0.04927966371178627, 0.0, -1.9430925021879375e-05, -1.7881377516459906e-06, -0.00022075122979003936, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -2.622600959512056e-06, -0.16028036177158356, -0.0032463965471833944, 0.0, -1.1920922133867862e-06, -7.509902934543788e-05, -5.960462772236497e-07, 0.0, -0.00028975578607060015, 0.0, -4.768360213347478e-06, -0.6935850381851196, -1.156323378381785e-05, 0.0, -5.245195097813848e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.4305104514278355e-06, -0.704258382320404, -0.32311317324638367, -3.814689989667386e-06, -0.00558186462149024, 0.0, -0.0032242953311651945, -1.1920928244535389e-07, -0.16022542119026184, -1.1920928244535389e-07, -7.510157047363464e-06, -6.389413465512916e-05, 0.0, 0.0, -0.023526916280388832, -1.4305104514278355e-06, -4.768360213347478e-06, 0.0, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, -0.009560749866068363, -1.0728830375228426e-06, -2.9802276912960224e-06, -3.933898824470816e-06, -1.0728830375228426e-06, 0.0, 0.0, -0.006731689441949129, -1.5497195136049413e-06, 0.0, 0.0, -0.3868875503540039, -6.556489552167477e-0