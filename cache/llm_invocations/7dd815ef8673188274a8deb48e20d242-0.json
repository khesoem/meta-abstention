4):\n            nx = vx + dx[k]\n            ny = vy + dy[k]\n            if ok((nx, ny), n, a) and dist[nx][ny] == INF and dist[vx][vy] + 1 <= badDist[nx][ny]:\n                dist[nx][ny] = dist[vx][vy] + 1\n                q.append((nx, ny))\n    return dist\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    tbad = int(next(it))\n    a = [[''] * n for _ in range(n)]\n    b = [[''] * n for _ in range(n)]\n    px = py = 0\n    for i in range(n):\n        row = next(it)\n        for j, ch in enumerate(row):\n            a[i][j] = ch\n            if ch == 'Z':\n                px, py = i, j\n    for i in range(n):\n        row = next(it)\n        for j, ch in enumerate(row):\n            b[i][j] = ch\n\n    badDist = bfs_grid(px, py, n, a, None, tbad, True)\n    for i in range(n):\n        for j in range(n):\n            badDist[i][j] = min(badDist[i][j], tbad)\n\n    nodes = 2 * n * n + 2\n    flow = Flow(nodes)\n    source = 0\n    sink = 2 * n * n + 1\n\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] != '0':\n                flow.add_edge(source, i * n + j + 1, ord(a[i][j]) - ord('0'))\n            if b[i][j] != '0':\n                flow.add_edge(i * n + j + 1 + n * n, sink, ord(b[i][j]) - ord('0'))\n\n    for i in range(n):\n        for j in range(n):\n            if not ok((i, j), n, a):\n                continue\n            curDist = bfs_grid(i, j, n, a, badDist, tbad, False)\n            for i1 in range(n):\n                for j1 in range(n):\n                    if ok((i1, j1), n, a) and curDist[i1][j1] <= badDist[i1][j1]:\n                        flow.add_edge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF)\n\n    print(flow.maxflow(source, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.2186455882765586e-06, 0.0, 0.0, -0.00015138434537220746, -0.0006027788622304797,