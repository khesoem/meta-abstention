          long d = cur[0];\n                    int u = (int) cur[1];\n                    if (d != prio[u]) continue;\n                    for (int i = 0; i < adj.get(u).size(); ++i) {\n                        Edge e = adj.get(u).get(i);\n                        int v = e.to;\n                        if (e.cap <= e.f) continue;\n                        int nprio = prio[u] + e.cost + pot[u] - pot[v];\n                        if (prio[v] > nprio) {\n                            prio[v] = nprio;\n                            q.offer(new long[]{nprio, v});\n                            prevnode[v] = u;\n                            prevedge[v] = i;\n                            curflow[v] = Math.min(curflow[u], e.cap - e.f);\n                        }\n                    }\n                }\n\n                if (prio[t] == Integer.MAX_VALUE) break;\n\n                for (int i = 0; i < n; ++i)\n                    pot[i] += prio[i];\n\n                int df = Math.min(curflow[t], INF - flow);\n                flow += df;\n\n                for (int v = t; v != s; v = prevnode[v]) {\n                    Edge e = adj.get(prevnode[v]).get(prevedge[v]);\n                    e.f += df;\n                    adj.get(v).get(e.rev).f -= df;\n                    flowCost += df * e.cost;\n                }\n            }\n            return new int[]{flow, flowCost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MCF nt = new MCF(6 + 107 * n);\n\n        for (int _ = 0; _ < k; ++_) {\n            int x = sc.nextInt();\n            --x;\n            nt.addEdge(0, 1 + x, 1, 0);\n        }\n\n        for (int _ = 0; _ < m; ++_) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x; --y;\n            for (int i = 0; i < 105; ++i) {\n                for (int j = 0; j < 51; ++j) {\n                    nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1));\n                    nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1));\n                }\n            }\n        }\n\n        for (int i = 0; i < 105; ++i)\n            for (int j = 0; j < n; ++j)\n                nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c);\n\n        for (int i = 0; i < 105; ++i)\n            nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0);\n\n        int[] ans = nt.minCostFlow(0, 1 + 105 * n);\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012790338951162994, -2.622600959512056e-06, -7.152555099310121e-07, -0.003955874126404524, -3.361645576660521e-05, -0.28115615248680115, -0.20150981843471527, -9.226373367710039e-05, -4.768370445162873e-07, -7.199982064776123e-05, -0.07889030128717422, -7.60526381782256e-05, -0.0021402565762400627, -0.3196565508842468, -0.0002044230350293219, -1.9311717551317997e-05, -2.3841855067985307e-07, -0.474096417427063, -3.6954811548639555e-06, -0.3868746757507324, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.048587556928396225, -3.099436753473128e-06, -1.5258672647178173e-05, -6.437280717364047e-06, -0.11324683576822281, -1.4305104514278355e-06, -4.768370445162873e-07, -1.4305104514278355e-06, -9.536738616588991e-07, -0.004620708059519529, -0.00011014331539627165, -1.1920928244535389e-07, -2.7418097943154862e-06, 0.0, -2.145764938177308e-06, -1.1920928244535389e-07, -4.172316494077677e-06, -0.07888996601104736, -0.054884787648916245, -6.103329360485077e-05, -2.145764938177308e-06, -2.7418097943154862e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -2.622600959512056e-06, 0.0, -2.3841855067985307e-07, -3.933898824470816e-06, 0.0, 0.0, -1.823885577323381e