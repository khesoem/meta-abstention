   edge e = G[u][i];\n          if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n            q.emplace(-D[e.v], e.v);\n            PV[e.v] = u;\n            PE[e.v] = i;\n          }\n        }\n      }\n      if (D[t] == INF) return -1;\n      for (int i = 0; i < N; i++) H[i] += D[i];\n      long long d = f;\n      for (int i = t; i != s; i = PV[i]) {\n        d = min(d, G[PV[i]][PE[i]].c);\n      }\n      f -= d;\n      res += d * H[t];\n      for (int i = t; i != s; i = PV[i]) {\n        edge &e = G[PV[i]][PE[i]];\n        e.c -= d;\n        G[i][e.r].c += d;\n      }\n    }\n    return res;\n  }\n};\n\nint main() {\n  cin.tie(nullptr);\n  ios::sync_with_stdio(false);\n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  rep(i, K) cin >> A[i], A[i]--;\n  vector<int> us(M), vs(M);\n  rep(i, M) {\n    cin >> us[i] >> vs[i];\n    us[i]--;\n    vs[i]--;\n  }\n  mincostflow mcf(N*101+2);\n  int s = N*101;\n  int t = s + 1;\n  for (int i = 0; i < K; i++) {\n    mcf.add(s, A[i], 1, 0);\n  }\n  for (int i = 0; i <= 100; i++) {\n    mcf.add(N * i, t, K, C*i);\n  }\n  for (int i = 0; i < 100; i++) {\n    for (int j = 0; j < N; j++) {\n      mcf.add(i*N+j, (i+1)*N+j, K, 0);\n    }\n    for (int j = 0; j < M; j++) {\n      for (int k = 1; k <= K; k++) {\n        mcf.add(N*i + us[j], N*(i+1) + vs[j], 1, (2*k-1)*D);\n        mcf.add(N*i + vs[j], N*(i+1) + us[j], 1, (2*k-1)*D);\n      }\n    }\n  }\n  cout << mcf.run(s, t, K) << '\\n';\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class MinCostFlow {\n        static class Edge {\n            int v;\n            long c;\n            long w;\n            int r;\n\n            Edge(int v, long c, long w, int r) {\n                this.v = v;\n                this.c = c;\n                this.w = w;\n                this.r = r;\n            }\n        }\n\n        List<List<Edge>> G;\n\n        MinCostFlow(int n) {\n            G = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                G.add(new ArrayList<>());\n            }\n        }\n\n        void add(int u, int v, long c, long w) {\n            int i = G.get(u).size();\n            int j = G.get(v).size();\n            G.get(u).add(new Edge(v, c, w, j));\n            G.get(v).add(new Edge(u, 0, -w, i));\n        }\n\n        long run(int s, int t, long f) {\n            int N = G.size();\n            long res = 0;\n            long[] H = new long[N];\n            long[] D = new long[N];\n            final long INF = (long) 1e18;\n            int[] PE = new int[N], PV = new int[N];\n\n            PriorityQueue<long[]> q = new PriorityQueue<>(Comparator.comparingLong(a -> -a[0]));\n            while (f > 0) {\n                Arrays.fill(D, INF);\n                D[s] = 0;\n                q.clear();\n                q.offer(new long[]{0, s});\n                while (!q.isEmpty()) {\n                    long[] top = q.poll();\n                    long d = -top[0];\n                    int u = (int) top[1];\n                    if (D[u] < d) continue;\n                    for (int i = 0; i < G.get(u).size(); i++) {\n                        Edge e = G.get(u).get(i);\n                        if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n                            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n                            q.offer(new long[]{-D[e.v], e.v});\n                            PV[e.v] = u;\n                            PE[e.v] = i;\n                        }\n                    }\n                }\n                if (D[t] == INF) return -1;\n                for (int i = 0; i < N; i++) H[i] += D[i];\n                long d = f;\n                for (int i = t; i != s; i = PV[i]) {\n                    d = Math.min(d, G.get(PV[i]).get(PE[i]).c);\n                }\n                f -= d;\n                res += d * H[t];\n                for (int i = t; i != s; i = PV[i]) {\n                    Edge e = G.get(PV[i]).get(PE[i]);\n                    e.c -= d;\n                    G.get(i).get(e.r).c += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long N = sc.nextLong();\n        long M = sc.nextLong();\n        long K = sc.nextLong();\n        long C = sc.nextLong();\n        long D = sc.nextLong();\n\n        int[] A = new int[(int) K];\n        for (int i = 0; i < K; i++) {\n            A[i] = sc.nextInt() - 1;\n        }\n\n        int[] us = new int[(int) M];\n        int[] vs = new int[(int) M];\n        for (int i = 0; i < M; i++) {\n            us[i] = sc.nextInt() - 1;\n            vs[i] = sc.nextInt() - 1;\n        }\n\n        int size = (int) (N * 101 + 2);\n        MinCostFlow mcf = new MinCostFlow(size);\n        int s = size - 2;\n        int t = size - 1;\n\n        for (int i = 0; i < K; i++) {\n            mcf.add(s, A[i], 1, 0);\n        }\n\n        for (int i = 0; i <= 100; i++) {\n            mcf.add(N * i, t, K, C * i);\n        }\n\n        for (int i = 0; i < 100; i++) {\n            for (int j = 0; j < N; j++) {\n                mcf.add(i * (int) N + j, (i + 1) * (int) N + j, K, 0);\n            }\n            for (int j = 0; j < M; j++) {\n                for (int k = 1; k <= K; k++) {\n                    long cost = (2 * k - 1) * D;\n                    mcf.add((int) (N * i + us[j]), (int) ((i + 1) * N + vs[j]), 1, cost);\n                    mcf.add((int) (N * i + vs[j]), (int) ((i + 1) * N + us[j]), 1, cost);\n                }\n            }\n        }\n\n        System.out.println(mcf.run(s, t, K));\n        sc.close();\n    }\n}\n\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0027813392225652933, -4.320199877838604e-07, -0.00