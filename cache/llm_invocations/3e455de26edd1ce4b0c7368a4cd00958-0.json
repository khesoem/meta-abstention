{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n \nusing namespace std;\n \nusing ll = long long;\nusing tf = ll;\nusing tc = ll;\nconst tf INF = 1e9;\n\nstruct MCF {\n    int n;\n    vector<tc> prio, pot;\n    vector<tf> curflow;\n    vector<int> prevedge, prevnode;\n    priority_queue<pair<tc, int>, vector<pair<tc, int>>, greater<pair<tc, int>>> q;\n    \n    struct edge {\n        int to, rev;\n        tf f, cap;\n        tc cost;\n    };\n    \n    vector<vector<edge>> g;\n    \n    MCF(int n) : n(n), prio(n), curflow(n), prevedge(n), prevnode(n), pot(n), g(n) {}\n    \n    void add_edge(int s, int t, tf cap, tc cost) {\n        g[s].push_back({t, (int)g[t].size(), 0, cap, cost});\n        g[t].push_back({s, (int)g[s].size() - 1, 0, 0, -cost});\n    }\n    \n    pair<tf, tc> get_flow(int s, int t) {\n        tf flow = 0;\n        tc flowcost = 0;\n        \n        while (true) {\n            q.push({0, s});\n            fill(prio.begin(), prio.end(), INF);\n            prio[s] = 0;\n            curflow[s] = INF;\n            \n            while (!q.empty()) {\n                auto cur = q.top();\n                tc d = cur.first;\n                int u = cur.second;\n                q.pop();\n                \n                if (d != prio[u]) continue;\n                \n                for (int i = 0; i < (int)g[u].size(); ++i) {\n                    edge &e = g[u][i];\n                    int v = e.to;\n                    \n                    if (e.cap <= e.f) continue;\n                    \n                    tc nprio = prio[u] + e.cost + pot[u] - pot[v];\n                    if (prio[v] > nprio) {\n                        prio[v] = nprio;\n                        q.push({nprio, v});\n                        prevnode[v] = u;\n                        prevedge[v] = i;\n                        curflow[v] = min(curflow[u], e.cap - e.f);\n                    }\n                }\n            }\n            \n            if (prio[t] == INF) break;\n            \n            for (int i = 0; i < n; ++i)\n                pot[i] += prio[i];\n            \n            tf df = min(curflow[t], INF - flow);\n            flow += df;\n            \n            for (int v = t; v != s; v = prevnode[v]) {\n                edge &e = g[prevnode[v]][prevedge[v]];\n                e.f += df;\n                g[v][e.rev].f -= df;\n                flowcost += df * e.cost;\n            }\n        }\n        \n        return {flow, flowcost};\n    }\n};\n\nint main() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    const int T = 500;\n    int N = n * T;\n    MCF mcf(N + 2);\n    \n    // Wait edges: stay in same city for next time unit\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < T - 1; ++j)\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n    \n    // Source connections: arrival at city 0 at time i\n    for (int i = 0; i < T; ++i)\n        mcf.add_edge(i, N + 1, INF, 0);\n    \n    // People starting at their cities at time 0\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n    \n    // Travel edges between cities\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        \n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int _ = 0; _ < k; ++_) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n    \n    auto p = mcf.get_flow(N, N + 1);\n    assert(p.first == k);\n    cout << p.second << endl;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nINF = 10**9\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.prio = [INF] * n\n        self.pot = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.g = [[] for _ in range(n)]\n    \n    def add_edge(self, s, t, cap, cost):\n        # Forward edge\n        self.g[s].append({'to': t, 'rev': len(self.g[t]), 'f': 0, 'cap': cap, 'cost': cost})\n        # Backward edge\n        self.g[t].append({'to': s, 'rev': len(self.g[s]) - 1, 'f': 0, 'cap': 0, 'cost': -cost})\n    \n    def get_flow(self, s, t):\n        flow = 0\n        flowcost = 0\n        \n        while True:\n            # Dijkstra's algorithm with priority queue\n            q = []\n            heapq.heappush(q, (0, s))\n            self.prio = [INF] * self.n\n            self.prio[s] = 0\n            self.curflow = [0] * self.n\n            self.curflow[s] = INF\n            \n            while q:\n                d, u = heapq.heappop(q)\n                if d != self.prio[u]:\n                    continue\n                \n                for i, e in enumerate(self.g[u]):\n                    v = e['to']\n                    \n                    if e['cap'] <= e['f']:\n                        continue\n                    \n                    nprio = self.prio[u] + e['cost'] + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nprio:\n                        self.prio[v] = nprio\n                        heapq.heappush(q, (nprio, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e['cap'] - e['f'])\n            \n            if self.prio[t] == INF:\n                break\n            \n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            \n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            \n            v = t\n            while v != s:\n                e = self.g[self.prevnode[v]][self.prevedge[v]]\n                e['f'] += df\n                self.g[v][e['rev']]['f'] -= df\n                flowcost += df * e['cost']\n                v = self.prevnode[v]\n        \n        return (flow, flowcost)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    T = 500\n    N = n * T\n    mcf = MCF(N + 2)\n    \n    # Wait edges: stay in same city for next time unit\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c)\n    \n    # Source connections: arrival at city 0 at time i\n    for i in range(T):\n        mcf.add_edge(i, N + 1, INF, 0)\n    \n    # People starting at their cities at time 0\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcf.add_edge(N, x * T, 1, 0)\n    \n    # Travel edges between cities\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        \n        for j in range(T - 1):\n            cur = 1\n            for _ in range(k):\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c)\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c)\n                cur += 2\n    \n    p = mcf.get_flow(N, N + 1)\n    assert p[0] == k\n    print(p[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002379134384682402, -1.6689286894688848e-06, -1.1920928244535389e-07, -0.00011276562872808427, -0.5233925580978394, -0.10037092119455338, -0.201456218957901, -0.00010752100206445903, -0.4301275908946991, -0.37372085452079773, -5.960462772236497e-07, -0.006000243593007326, -1.1920928244535389e-07, -1.4066597032069694e-05, -0.0008357845945283771, -7.986990567587782e-06, -2.9802276912960224e-06, -0.0005577438860200346, -0.07023997604846954, -2.50339189733495e-06, -2.9802276912960224e-06, -1.1920928244535389e-07, -0.05488399788737297, -7.73638384998776e-05, -4.0531076592742465e-06, -2.3841855067985307e-07, -3.6954811548639555e-06, 0.0, 0.0, -1.1205610462639015e-05, -1.311301275563892e-06, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, -5.006777428206988e-06, -3.576278118089249e-07, -1.7881377516459906e-06, -1.2636104656849056e-05, -2.50339189733495e-06, -1.1920922133867862e-06, -1.7881377516459906e-06, -0.0041946289129555225, -3.576278118089249e-07, 0.0, 0.0, -1.4305104514278355e-06, -5.960462772236497e-07, -7.152555099310121e-07, -0.6330819129943848, -1.4305104514278355e-06, -7.867782187531702e-06, -4.768370445162873e-07, -0.0005534547381103039, -2.3841855067985307e-07, -5.960462772236497e-07, -2.3841855067985307e-07, -2.50339189733495e-06, -3.576278118089249e-07, -4.768370445162873e-07, -2.2411095415009186e-05, -3.504691630951129e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.5232191681861877, -5.960462772236497e-07, -2.3841830625315197e-06, -2.3841855067985307e-07, -1.4305104514278355e-06, -1.1920928244535389e-07, -2.384185506798