    static long[] dist = new long[MAXN];\n    static int[] prevv = new int[MAXN];\n    static int[] preve = new int[MAXN];\n    static boolean[] inq = new boolean[MAXN];\n\n    static class Edge {\n        int to;\n        long cap, cost;\n        int rev;\n        Edge(int to, long cap, long cost, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static void init(int _n, int _s, int _t) {\n        n = _n;\n        s = _s;\n        t = _t;\n        G = new ArrayList<>(n + 1);\n        for (int i = 0; i <= n; i++) {\n            G.add(new ArrayList<>());\n        }\n    }\n\n    static void addEdge(int from, int to, long cap, long cost) {\n        G.get(from).add(new Edge(to, cap, cost, G.get(to).size()));\n        G.get(to).add(new Edge(from, 0, -cost, G.get(from).size() - 1));\n    }\n\n    static long minCostFlow(long f) {\n        long res = 0;\n        while (f > 0) {\n            Arrays.fill(dist, 0, n, INF);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            inq[s] = true;\n            while (!q.isEmpty()) {\n                int now = q.poll();\n                inq[now] = false;\n                for (int i = 0; i < G.get(now).size(); i++) {\n                    Edge e = G.get(now).get(i);\n                    if (e.cap > 0 && dist[now] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[now] + e.cost;\n                        prevv[e.to] = now;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.add(e.to);\n                        }\n                    }\n                }\n            }\n            if (dist[t] == INF) return -1;\n            long d = f;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = Math.min(d, G.get(prevv[v]).get(preve[v]).cap);\n            }\n            f -= d;\n            res += d * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = G.get(prevv[v]).get(preve[v]);\n                e.cap -= d;\n                G.get(v).get(e.rev).cap += d;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long N = sc.nextLong();\n        long M = sc.nextLong();\n        long K = sc.nextLong();\n        long C = sc.nextLong();\n        long D = sc.nextLong();\n\n        long[] A = new long[58];\n        for (int i = 1; i <= K; i++) {\n            long X = sc.nextLong();\n            A[(int) X]++;\n        }\n\n        ArrayList<ArrayList<Integer>> H = new ArrayList<>();\n        for (int i = 0; i <= N; i++) {\n            H.add(new ArrayList<>());\n        }\n        for (int i = 1; i <= M; i++) {\n            long X = sc.nextLong();\n            long Y = sc.nextLong();\n            H.get((int) X).add((int) Y);\n            H.get((int) Y).add((int) X);\n        }\n\n        init(5103, 0, 5101);\n\n        for (int i = 2; i <= N; i++) {\n            addEdge(0, i, A[i], 0);\n        }\n\n        for (int i = 0; i <= 100; i++) {\n            for (int l = 1; l <= N; l++) {\n                addEdge(50 * i + l, 50 * (i + 1) + l, K, 0);\n                for (int j : H.get(l)) {\n                    for (int k = 1; k <= K; k++) {\n                        addEdge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= 101; i++) {\n            addEdge(50 * i + 1, 5101, K, C * i);\n        }\n\n        System.out.println(minCostFlow(K));\n    }\n}\n```", "token_logprobs": [-0.0001662831346038729, -0.7012460231781006, -1.311301275563892e-06, -6.723177648382261e-05, -3.981510963058099e-05, 0.0, -1.0371154530730564e-05, -0.0019823915790766478, -0.0007321537705138326, -3.57627811808