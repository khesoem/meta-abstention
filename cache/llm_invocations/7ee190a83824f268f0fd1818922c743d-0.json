{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 2000005;\n\nstruct Edge {\n    int to, cap, cost, rev;\n};\n\nvector<vector<Edge>> graph;\nvector<int> dist, prevv, preve;\nint n, m, k, c, d;\nint S, T;\nint X[2000005], Y[2000005];\n\nvoid add_edge(int from, int to, int cap, int cost) {\n    graph[from].push_back({to, cap, cost, (int)graph[to].size()});\n    graph[to].push_back({from, 0, -cost, (int)graph[from].size()-1});\n}\n\nbool bellman_ford() {\n    fill(dist.begin(), dist.end(), 1e9);\n    dist[S] = 0;\n    bool updated = true;\n    while (updated) {\n        updated = false;\n        for (int v = 0; v < graph.size(); ++v) {\n            if (dist[v] == 1e9) continue;\n            for (int i = 0; i < graph[v].size(); ++i) {\n                Edge &e = graph[v][i];\n                if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                    dist[e.to] = dist[v] + e.cost;\n                    prevv[e.to] = v;\n                    preve[e.to] = i;\n                    updated = true;\n                }\n            }\n        }\n    }\n    return dist[T] < 1e9;\n}\n\nint min_cost_flow() {\n    int flow = 0, cost = 0;\n    while (bellman_ford()) {\n        int f = 1e9;\n        for (int v = T; v != S; v = prevv[v]) {\n            f = min(f, graph[prevv[v]][preve[v]].cap);\n        }\n        flow += f;\n        cost += f * dist[T];\n        for (int v = T; v != S; v = prevv[v]) {\n            Edge &e = graph[prevv[v]][preve[v]];\n            e.cap -= f;\n            graph[v][e.rev].cap += f;\n        }\n    }\n    return cost;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    S = 0; T = 1;\n    int nodes = 2 + (n + k + 1) * (n + 1);\n    graph.resize(nodes);\n    dist.resize(nodes);\n    prevv.resize(nodes);\n    preve.resize(nodes);\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        add_edge(S, x + 1, 1, 0);\n    }\n    \n    for (int i = 1; i <= m; ++i) {\n        scanf(\"%d%d\", &X[i], &Y[i]);\n    }\n    \n    for (int i = 0; i <= n + k; ++i) {\n        add_edge(2 + i * (n + 1), T, k, 0);\n        if (i == n + k) break;\n        for (int j = 1; j <= m; ++j) {\n            for (int l = k; l >= 0; --l) {\n                int cost = (l * 2 + 1) * d + c;\n                add_edge(X[j] + 1 + i * (n + 1), Y[j] + 1 + i * (n + 1) + n, 1, cost);\n                add_edge(Y[j] + 1 + i * (n + 1), X[j] + 1 + i * (n + 1) + n, 1, cost);\n            }\n        }\n        for (int j = 1; j <= n; ++j) {\n            add_edge(j + 1 + i * (n + 1), j + 1 + i * (n + 1) + n, k, c);\n        }\n    }\n    \n    printf(\"%d\\n\", min_cost_flow());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 2000005;\n\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int to, int cap, int cost, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static List<List<Edge>> graph;\n    static int[] dist, prevv, preve;\n    static int n, m, k, c, d;\n    static int S, T;\n    static int[] X = new int[MAXN];\n    static int[] Y = new int[MAXN];\n\n    static void add_edge(int from, int to, int cap, int cost) {\n        graph.get(from).add(new Edge(to, cap, cost, graph.get(to).size()));\n        graph.get(to).add(new Edge(from, 0, -cost, graph.get(from).size() - 1));\n    }\n\n    static boolean bellman_ford() {\n        Arrays.fill(dist, 1000000000);\n        dist[S] = 0;\n        boolean updated = true;\n        while (updated) {\n            updated = false;\n            for (int v = 0; v < graph.size(); ++v) {\n                if (dist[v] == 1000000000) continue;\n                for (int i = 0; i < graph.get(v).size(); ++i) {\n                    Edge e = graph.get(v).get(i);\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        updated = true;\n                    }\n                }\n            }\n        }\n        return dist[T] < 1000000000;\n    }\n\n    static int min_cost_flow() {\n        int flow = 0, cost = 0;\n        while (bellman_ford()) {\n            int f = 1000000000;\n            for (int v = T; v != S; v = prevv[v]) {\n                f = Math.min(f, graph.get(prevv[v]).get(preve[v]).cap);\n            }\n            flow += f;\n            cost += f * dist[T];\n            for (int v = T; v != S; v = prevv[v]) {\n                Edge e = graph.get(prevv[v]).get(preve[v]);\n                e.cap -= f;\n                graph.get(v).get(e.rev).cap += f;\n            }\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m 