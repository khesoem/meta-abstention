{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <queue>\n#include <cstring>\n#include <cstdio>\n#include <algorithm>\nusing namespace std;\nconst int INF = 0x3f3f3f3f;\nconst int maxm = 2000015;\nconst int maxn = 105*55;\nint n, m, k, c, d;\ninline int read()\n{\n    int x=0,f=1;char ch=getchar();\n    while (ch<'0'||ch>'9'){if (ch=='-') f=-1;ch=getchar();}\n    while (ch>='0'&&ch<='9'){x=x*10+ch-'0';ch=getchar();}\n    return x*f;\n}\nstruct Edge\n{\n    int to, next, cap, flow, cost;\n}edge[maxm];\nint head[maxn], tol;\nint pre[maxn], dis[maxn];\nint pot[maxn];\nint N ;\nvoid init(int n)\n{\n    N = n;\n    tol = 0;\n    memset(head, -1, sizeof(head));\n}\nvoid addedge(int u, int v, int cap, int cost)\n{\n    edge[tol].to = v;\n    edge[tol].cap = cap;\n    edge[tol].cost = cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[u];\n    head[u] = tol++;\n    edge[tol].to = u;\n    edge[tol].cap = 0;\n    edge[tol].cost = -cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[v];\n    head[v] = tol++;\n}\nbool dijkstra(int s, int t)\n{\n    priority_queue<pair<int,int>> pq;\n    for(int i = 0; i < N; i++)\n    {\n        dis[i] = INF;\n        pre[i] = -1;\n    }\n    dis[s] = 0;\n    pq.push({0, s});\n    while(!pq.empty())\n    {\n        int d = -pq.top().first;\n        int u = pq.top().second;\n        pq.pop();\n        if(dis[u] < d) continue;\n        for(int i = head[u]; i != -1; i = edge[i].next)\n        {\n            int v = edge[i].to;\n            if(edge[i].cap > edge[i].flow)\n            {\n                int reduced = edge[i].cost + pot[u] - pot[v];\n                if(dis[v] > dis[u] + reduced)\n                {\n                    dis[v] = dis[u] + reduced;\n                    pre[v] = i;\n                    pq.push({-dis[v], v});\n                }\n            }\n        }\n    }\n    return pre[t] != -1;\n}\nint minCostMaxflow(int s, int t, int &cost)\n{\n    int flow = 0;\n    cost = 0;\n    memset(pot, 0, sizeof(pot));\n    while(dijkstra(s,t))\n    {\n        for(int i = 0; i < N; i++)\n        {\n            if(dis[i] < INF) pot[i] += dis[i];\n        }\n        int Min = INF;\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            if(Min > edge[i].cap - edge[i].flow)\n                Min = edge[i].cap - edge[i].flow;\n        }\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            edge[i].flow += Min;\n            edge[i^1].flow -= Min;\n            cost += edge[i].cost * Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\nint point(int x, int y){\n    return (x-1)*50+y;\n}\nint main(){\n    int S = 101*55, T = S + 1;\n    n = read(), m = read(), k = read(), c = read(), d = read();\n    int tmp;\n    init(T+1);\n    for(int i = 1; i <= k; i++){\n        tmp = read();\n        addedge(S, tmp, 1, 0);\n    }\n    for(int i = 1; i <= 50; i++){\n        for(int j = 1; j <= 103; j++){\n            int x = point(j, i);\n            int y = point(j+1, i);\n            addedge(x, y, INF, c);\n        }\n    }\n    for(int i = 0; i < 102; i++){\n        int tmp = i*50+1;\n        addedge(tmp, T, INF, 0);\n    }\n    for(int i = 1; i <= m; i++){\n        int u, v;\n        u = read(), v = read();\n        for(int j = 1; j <= 102; j++){\n            int x = point(j, u), x1 = point(j+1, u);\n            int y1 = point(j+1, v), y = point(j, v);\n            for(int k = 0; k < 50; k++){\n                int val = d*(k*2+1)+c;\n                addedge(x, y1, 1, val);\n                addedge(y, x1, 1, val);\n            }\n        }\n    }\n    int cost = 0;\n    minCostMaxflow(S, T, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**9\n\nclass Edge:\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_edge(graph, fr, to, cap, cost):\n    graph[fr].append(Edge(to, len(graph[to]), cap, cost))\n    graph[to].append(Edge(fr, len(graph[fr]) - 1, 0, -cost))\n\ndef min_cost_max_flow(graph, s, t):\n    n = len(graph)\n    flow = 0\n    cost = 0\n    pot = [0] * n\n    while True:\n        dist = [INF] * n\n        prevv = [-1] * n\n        preve = [-1] * n\n        dist[s] = 0\n        pq = [(0, s)]\n        while pq:\n            d, v = heapq.heappop(pq)\n            if dist[v] < d:\n                continue\n            for i, e in enumerate(graph[v]):\n                if e.cap > 0 and dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]:\n                    dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to]\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    heapq.heappush(pq, (dist[e.to], e.to))\n        if prevv[t] == -1:\n            break\n        for v in range(n):\n            if dist[v] < INF:\n                pot[v] += dist[v]\n        d = INF\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            d = min(d, e.cap)\n            v = prevv[v]\n        flow += d\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            e.cap -= d\n            graph[v][e.rev].cap += d\n            cost += d * e.cost\n            v = prevv[v]\n    return flow, cost\n\ndef point(x, y):\n    return (x - 1) * 50 + y\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    S = 101 * 55\n    T = S + 1\n    N = T + 1\n    graph = [[] for _ in range(N + 1)]  # 1-indexed nodes\n\n    for _ in range(k):\n        tmp = next(it)\n        add_edge(graph, S, tmp, 1, 0)\n\n    for i in range(1, 51):\n        for j in range(1, 104):\n            x = point(j, i)\n            y = point(j + 1, i)\n            add_edge(graph, x, y, INF, c)\n\n    for i in range(0, 102):\n        tmp = i * 50 + 1\n        add_edge(graph, tmp, T, INF, 0)\n\n    for _ in range(m):\n        u = next(it)\n        v = next(it)\n        for j in range(1, 103):\n            x = point(j, u)\n            x1 = point(j + 1, u)\n            y = point(j, v)\n            y1 = point(j + 1, v)\n            for kk in range(50):\n                val = d * (kk * 2 + 1) + c\n                add_edge(graph, x, y1, 1, val)\n                add_edge(graph, y, x1, 1, val)\n\n    flow, cost = min_cost_max_flow(graph, S, T)\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015293381875380874, 0.0, -1.1920928244535389e-07, -0.00045885046711191535, -0.0015464978059753776, -7.486063259420916e-05, -0.001958953682333231, -0.0003420721332076937, -4.458328112377785e-05, -0.005276681389659643, -0.0036703855730593204, -1.597391747054644e-05, -1.537788011773955e-05, -0.00020859450160060078, -0.04858744144439697, -0.00023505308490712196, -0.0