fact[10009] = fact[10009].pow(mod - 2)\n    for i in range(10008, -1, -1):\n        invfact[i] = invfact[i+1] * ModInt(mod, i+1)\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    mod = int(next(it))\n    init_fact(mod)\n\n    def pw(base, exp):\n        res = ModInt(mod, 1)\n        b = ModInt(mod, base)\n        while exp:\n            if exp & 1:\n                res *= b\n            b *= b\n            exp >>= 1\n        return res\n\n    ans = ModInt(mod, 0)\n    for length in range(1, m):\n        f = pw(length + 1, length) * ModInt(mod, length) / ModInt(mod, n - length) * invfact[length]\n        for i in range(0, m - length):\n            j = i + length\n            g = pw(n - length, i) * invfact[i]\n            h = ModInt(mod, n - j) * pw(n + 1, m - 1 - j) * fact[j]\n            ans += f * g * h\n    ans *= pw(2, m - 1) * ModInt(mod, n + 1 - m)\n    print(ans.x)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.536738616588991e-07, -2.3841855067985307e-07, 0.0, -4.017272294731811e-05, -0.0004812512779608369, 0.0, -0.00013982271775603294, -0.00020072828920092434, 0.0, 0.0, -3.576278118089249e-07, -1.4305104514278355e-06, -0.0789262130856514, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -2.706014311115723e-05, -0.0005654881824739277, -2.622600959512056e-06, -1.9550132492440753e-05, 0.0, -3.576272320060525e-06, 0.0, -4.660974445869215e-05, 0.0, 0.0, -1.680836794548668e-05, -2.3841855067985307e-07, 0.0, -0.0003591130953282118, -2.3841855067985307e-07, 0.0, -0.003273844253271818, 0.0, -0.0002037079248111695, -6.23445157543756e-05, -2.3841855067985307e-07, -9.536738616588991e-07, -5.006777428206988e-06, -1.1920928244535389e-07, -1.0728830375228426e-06, 0.0, 0.0, -1.7881377516459906e-06, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -0.0004307295894250