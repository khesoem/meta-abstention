n            }\n        }\n        return dist;\n    }\n\n    static void addEdges(String[] A, String[] B, int i, int j, int x, int y) {\n        int L = 100 * i + 10 * j;\n        int R = 100 * x + 10 * y;\n        int digitA = A[i].charAt(j) - '0';\n        int digitB = B[x].charAt(y) - '0';\n        for (int u = 1; u <= digitA; u++) {\n            for (int v = 1; v <= digitB; v++) {\n                adj[L + u].add(R + v);\n            }\n        }\n    }\n\n    static boolean augment(int v) {\n        if (seen[v]) return false;\n        seen[v] = true;\n        for (int to : adj[v]) {\n            if (matched[to] == 0 || augment(matched[to])) {\n                matched[to] = v;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int t = Integer.parseInt(st.nextToken());\n\n        String[] A = new String[n];\n        String[] B = new String[n];\n        for (int i = 0; i < n; i++) A[i] = br.readLine();\n        for (int i = 0; i < n; i++) B[i] = br.readLine();\n\n        int zx = 0, zy = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (A[i].charAt(j) == 'Z') {\n                    zx = i;\n                    zy = j;\n                }\n            }\n        }\n\n        long[][] toReactor = getDist(zx, zy, A);\n\n        for (int i = 0; i < MAXN; i++) adj[i] = new ArrayList<>();\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (!isGood(i, j, A)) continue;\n                long[][] fromStart = getDist(i, j, A);\n                for (int x = 0; x < n; x++) {\n                    for (int y = 0; y < n; y++) {\n                        if (!isGood(x, y, A)) continue;\n                        if (fromStart[x][y] > t || fromStart[x][y] > toReactor[x][y]) continue;\n                        if (fromStart[x][y] == toReactor[x][y]) {\n                            boolean better = false;\n                            for (int d = 0; d < 4; d++) {\n                                int nx = x + dX[d];\n                                int ny = y + dY[d];\n                                if (!isGood(nx, ny, A)) continue;\n                                if (fromStart[nx][ny] < toReactor[nx][ny]) {\n                                    better = true;\n                                    break;\n                                }\n                            }\n                            if (!better) continue;\n                        }\n                        addEdges(A, B, i, j, x, y);\n                    }\n                }\n            }\n        }\n\n        for (int i = 0; i < MAXN; i++) {\n            augment(i);\n            Arrays.fill(seen, false);\n        }\n\n        int result = 0;\n        for (int i = 0; i < MAXN; i++) {\n            if (matched[i] != 0) result++;\n        }\n        System.out.print(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.198863957251888e-06, 0.0, -1.1920928244535389e-07, -2.2053474822314456e-05, -8.940656698541716e-06, 0.0, -0.47407713532447815, -0.011054816655814648, -1.1920928244535389e-07, 0.0, -0.00011753345461329445, -0.0007153574260883033, -3.93382906622719e-05, 0.0, -7.033323527139146e-06, -0.0024779110681265593, -1.1086402082582936e-05, -0.008642885833978653, -2.0265373677830212e-05, -0.02324567921459675, 0.0, 0.0, -0.6939011216163635, -0.01107827853411436, -1.0728830375228426e-06, 0.0, -8.344646857949556e-07, -2.0265558760002023e-06, -0.13226883113384247, 0.0, -0.4740910828113556, 0.0, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -3.4570634852570947e-06, 0.0, 0.0, -1.1920922133867862e-06, -1.3