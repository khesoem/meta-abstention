code>\nimport sys\nfrom collections import deque\n\nMAXN = 20\nMAXV = 2 * MAXN * MAXN  # 800\nINF = 10**9\n\ndx = [1, 0, -1, 0]\ndy = [0, 1, 0, -1]\n\ndef is_zero_to_nine(c):\n    return '0' <= c <= '9'\n\ndef is_one_to_nine(c):\n    return '1' <= c <= '9'\n\nclass Dinic:\n    def __init__(self, n):\n        self.n = n\n        self.g = [[] for _ in range(n)]\n\n    def add_edge(self, u, v, c):\n        if u == v:\n            return\n        # check if edge already exists\n        for e in self.g[u]:\n            if e[0] == v:\n                e[2] = c\n                self.g[v][e[1]][2] = 0\n                return\n        # add new edge\n        forward = [v, len(self.g[v]), c]\n        backward = [u, len(self.g[u]), 0]\n        self.g[u].append(forward)\n        self.g[v].append(backward)\n\n    def bfs(self, s, t):\n        level = [-1] * self.n\n        q = deque()\n        level[s] = 0\n        q.append(s)\n        while q:\n            u = q.popleft()\n            for e in self.g[u]:\n                if e[2] > 0 and level[e[0]] == -1:\n                    level[e[0]] = level[u] + 1\n                    q.append(e[0])\n        self.level = level\n        return level[t] != -1\n\n    def dfs(self, u, t, f):\n        if u == t:\n            return f\n        self.seen[u] = True\n        for e in self.g[u]:\n            if e[2] > 0 and not self.seen[e[0]] and self.level[e[0]] == self.level[u] + 1:\n                ret = self.dfs(e[0], t, min(f, e[2]))\n                if ret > 0:\n                    e[2] -= ret\n                    self.g[e[0]][e[1]][2] += ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.seen = [False] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef add_all_source_edges(solver, sx, sy, N, time_limit, first_grid, second_grid, infect_time):\n    dist = [[INF] * N for _ in range(N)]\n    dist[sx][sy] = 0\n    if is_one_to_nine(second_grid[sx][sy]):\n        solver.add_edge(N * sx + sy, N * N + N * sx + sy, INF)\n    q = deque()\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx, ny = x + dx[d], y + dy[d]\n            if 0 <= nx < N and 0 <= ny < N:\n                if dist[nx][ny] != INF:\n                    continue\n                if not is_zero_to_nine(first_grid[nx][ny]):\n                    continue\n                nt = dist[x][y] + 1\n                if nt <= min(infect_time[nx][ny] - 1, time_limit):\n                    dist[nx][ny] = nt\n                    q.append((nx, ny))\n                if nt <= min(infect_time[nx][ny], time_limit) and is_one_to_nine(second_grid[nx][ny]):\n                    solver.add_edge(N * sx + sy, N * N + N * nx + ny, INF)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    time_limit = int(next(it))\n\n    first_grid = []\n    for _ in range(N):\n        line = next(it)\n        first_grid.append(list(line))\n\n    # find zombie start\n    zx = zy = 0\n    for i in range(N):\n        for j in range(N):\n            if first_grid[i][j] == 'Z':\n                zx, zy = i, j\n                break\n        else:\n            continue\n        break\n\n    # create flow network\n    total_nodes = 2 * N * N + 2\n    source = 2 * N * N\n    sink = 2 * N * N + 1\n    solver = Dinic(total_nodes)\n\n    # add edges from source to first grid digits\n    for i in range(N):\n        for j in range(N):\n            c = first_grid[i][j]\n            if is_one_to_nine(c):\n                solver.add_edge(source, i * N + j, int(c))\n\n    # zombie traversal\n    infect_time = [[INF] * N for _ in range(N)]\n    infect_time[zx][zy] = 0\n    q = deque()\n    q.append((zx, zy))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx, ny = x + dx[k], y + dy[k]\n            if 0 <= nx < N and 0 <= ny < N:\n                if is_zero_to_nine(first_grid[nx][ny]) and infect_time[nx][ny] == INF:\n                    infect_time[nx][ny] = infect_time[x][y] + 1\n                    q.append((nx, ny))\n\n    # read second grid\n    second_grid = []\n    for _ in range(N):\n        line = next(it)\n        second_grid.append(list(line))\n\n    # add edges from second grid digits to sink\n    for i in range(N):\n        for j in range(N):\n            c = second_grid[i][j]\n            if is_one_to_nine(c):\n                solver.add_edge(N * N + i * N + j, sink, int(c))\n\n    # add edges from first grid digits to second grid digits\n    for i in range(N):\n        for j in range(N):\n            if is_one_to_nine(first_grid[i][j]):\n                add_all_source_edges(solver, i, j, N, time_limit, first_grid, second_grid, infect_time)\n\n    # compute and print max flow\n    result = solver.max_flow(source, sink)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0011723319767042994, -6.318072337307967e-06, 0.0, 0.0, -7.807903602952138e-05, -0.00019798702851403505, 0.0, -2.50339189733495e-06, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -4.386805812828243e-05, -0.27666518092155457, -0.0015274535398930311, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, -5.6622808187967166e-05, -0.0794370174407959, -4.768360213347478e-06, -1.847726889536716e-05, -3.576278118089249e-07, -4.124556289752945e-05, -5.960462772236497e-07, -4.768360213347478e-06, 0.0, -5.960462772236497e-07, 0.0, 0.0, -0.5872730016708374, -4.768370445162873e-07, -0.09859670698642731, -9.65590606938349e-06, -0.263254314661026, -1.0728830375228426e-06, -1.4424220353248529e-05, -7.629365427419543e-06, -4.970903682988137e-05, -0.16022460162639618, -5.483612312673358e-06, -0.0005641775787808001, -0.0001