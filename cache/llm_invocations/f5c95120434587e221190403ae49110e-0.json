< '0' or b[i][j] > '9':\n                continue\n            qq = i*n + j\n            if vis[qq] != INF:\n                continue\n            vis[qq] = dis + 1\n            q.append((i, j))\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n    bi = bj = -1\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                bi, bj = i, j\n    # mat: distances between cells (index = i*n+j)\n    size = n*n\n    mat = [[INF]*size for _ in range(size)]\n    # BFS from Z\n    solve(bi, bj, mat[bi*n+bj], False, n, bi, bj, mat, b, t)\n    # BFS from each a-digit cell\n    for i in range(n):\n        for j in range(n):\n            if '1' <= a[i][j] <= '9':\n                solve(i, j, mat[i*n+j], True, n, bi, bj, mat, b, t)\n    # Build flow network\n    total_nodes = 2 + 2*size\n    flow = [[0]*total_nodes for _ in range(total_nodes)]\n    cap = [[0]*total_nodes for _ in range(total_nodes)]\n    ca = []\n    cb = []\n    # b-digit cells to sink\n    for i in range(n):\n        for j in range(n):\n            if b[i][j] > '0' and b[i][j] <= '9':\n                ca.append(i)\n                cb.append(j)\n                p = i*n + j\n                cap[p+2+size][1] = int(b[i][j])\n    # a-digit cells to source and to b-digit cells\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] > '0' and a[i][j] <= '9':\n                p = i*n + j\n                cap[0][p+2] = int(a[i][j])\n                for k in range(len(ca)):\n                    ii = ca[k]\n                    jj = cb[k]\n                    q = ii*n + jj\n                    if mat[p][q] < INF:\n                        cap[p+2][q+2+size] = INF\n    maxflow = edmondsKarp(total_nodes, 0, 1, flow, cap)\n    print(maxflow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.0265558760002023e-06, 0.0, -2.3841855067985307e-07, -0.00048387263086624444, -0.0007257211836986244, -1.1920928244535389e-07, -3.4570634852570947e-06, -1.5616295058862306e-05, -5.960462772236497e-07, 0.0, 0.0, -0.0004343043256085366, -0.023433877155184746, -5.960462772236497e-07, -5.960446742392378e-06, -0.011424832046031952, -0.008614521473646164, -4.768370445162873e-07, -0.24658285081386566, -0.0022960747592151165, -0.009764999151229858, 0.0, -1.1920928244535389e-07, -0.03804348036646843, 0.0, -0.0011528043542057276, -4.172316494077677e-06, -0.008882769383490086, -2.3841855067985307e-07, 0.0, -0.20144325494766235, -0.2519417405128479, -3.099436753473128e-06, -2.9802276912960224e-06, -1.1801649634435307e-05, -2.50339189733495e-06, -0.6291418671607971, -0.22968274354934692, -0.0008356655016541481, -1.6689160474925302e-05, -0.10079167038202286, 0.0, -0.21067176759243011, -1.1920922133867862e-06, -1.1920928244535389e-07, 0.0, -0.000945121340919286, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -0.02975134178996086, 0.0, -1.1920922133867862e-06, -1.3947389561508317e-05, 0.0, -0.0033391928300261497, -0.00043704494601115584, -7.152555099310121e-07, -0.018151015043258667, -2.9802276912960224e-06, -5.960462772236497e-07, -9.536738616588991e-07, -0.00020823694649152458, -1.1920928244535389e-07, -0.004702935926616192, -1.4305104514278355e-06, -2.3841855067985307e-07, 0.0, 0.0, -7.152555099310121e-07, -6.318072337307967e-06, 0.0, -0.08194197714328766, -9.536738616588991e-07, -0.0001586549769854173, -0.16022512316703796, 0.0, -8.344646857949556e-07, -4.768370445162873e-07, -2.264974000354414e-06, -5.602820692729438e-06, -8.344646857949556e-07, -0.10193348675966263, -3.099436753473128e-06, -0.061983413994312286, -1.7881377516459906e-06, -1.1920928244535389e-07, 0.0, 0.0, -0.008615466766059399, 0.0, -1.1920922133867862e-06, -0.00026127262390218675, 0.0, -0.0005783553933724761