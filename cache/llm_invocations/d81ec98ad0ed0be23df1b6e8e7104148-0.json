x = t\n        while x != s:\n            E[pre[x]].cap -= f\n            E[pre[x] ^ 1].cap += f\n            x = E[pre[x] ^ 1].to\n    return cost\n\ndef main():\n    global E_cnt, head\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    \n    pos = []\n    for _ in range(K):\n        p = int(next(it)) - 1\n        pos.append(p)\n    \n    conn = []\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        conn.append((u, v))\n    \n    id_table = [[0] * MAX_M for _ in range(51)]\n    node_cnt = 0\n    for i in range(n):\n        for j in range(MAX_M):\n            id_table[i][j] = node_cnt\n            node_cnt += 1\n    \n    src = node_cnt\n    dst = src + 1\n    \n    head = [-1] * MAX_NODES\n    E_cnt = 0\n    \n    for i in range(K):\n        link(src, id_table[pos[i]][0], 1, 0)\n    \n    for i in range(MAX_M):\n        link(id_table[0][i], dst, K, C * i)\n    \n    for i in range(n):\n        for j in range(MAX_M - 1):\n            link(id_table[i][j], id_table[i][j + 1], K, 0)\n    \n    for i in range(m):\n        u = conn[i][0]\n        v = conn[i][1]\n        for j in range(MAX_M - 1):\n            for k in range(K):\n                link(id_table[u][j], id_table[v][j + 1], 1, D * (2 * k + 1))\n                link(id_table[v][j], id_table[u][j + 1], 1, D * (2 * k + 1))\n    \n    ans = mcmf(src, dst)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012957210128661245, -7.152555099310121e-07, -1.1920928244535389e-07, -0.0006357794045470655, -0.0006157647585496306, -7.152555099310121e-07, -0.004623081535100937, -0.00036793138133361936, -1.5497195136049413e-06, -0.0004349001101218164, -0.01251993142068386, -0.14697352051734924, -3.576278118089249e-07, -5.602820692729438e-06, 0.0, -2.861018856492592e-06, -