        \n        for (i32 i = head[u]; ~i; i = E[i].next) {\n            i32 v = E[i].to;\n            if (E[i].cap && d[v] > d[u] + E[i].cost) {\n                d[v] = d[u] + E[i].cost;\n                pre[v] = i;\n                if (!inq[v]) {\n                    inq[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return d[t] < INF;\n}\n\ninline i32 mcmf(i32 s, i32 t) {\n    i32 flow = 0, cost = 0;\n    while (spfa(s, t)) {\n        i32 f = INF;\n        for (i32 x = t; x != s; x = E[pre[x] ^ 1].to) {\n            f = min(f, E[pre[x]].cap);\n        }\n        cost += f * d[t];\n        flow += f;\n        for (i32 x = t; x != s; x = E[pre[x] ^ 1].to) {\n            E[pre[x]].cap -= f;\n            E[pre[x] ^ 1].cap += f;\n        }\n    }\n    cerr << \"flow=\" << flow << \"\\n\";\n    return cost;\n}\n\nint main() {\n    i32 n, m, K, C, D;\n    scanf(\"%d%d%d%d%d\", &n, &m, &K, &C, &D);\n    \n    vi pos(K);\n    for (i32 i = 0; i < K; ++i) {\n        scanf(\"%d\", &pos[i]);\n        --pos[i];\n    }\n    \n    vector<pii> conn(m);\n    for (i32 i = 0; i < m; ++i) {\n        scanf(\"%d%d\", &conn[i].first, &conn[i].second);\n        --conn[i].first;\n        --conn[i].second;\n    }\n    \n    i32 id[51][MAX_M];\n    i32 node_cnt = 0;\n    for (i32 i = 0; i < n; ++i) {\n        for (i32 j = 0; j < MAX_M; ++j) {\n            id[i][j] = node_cnt++;\n        }\n    }\n    \n    i32 src = node_cnt;\n    i32 dst = src + 1;\n    \n    memset(head, -1, sizeof(head));\n    E_cnt = 0;\n    \n    for (i32 i = 0; i < K; ++i) {\n        link(src, id[pos[i]][0], 1, 0);\n    }\n    \n    for (i32 i = 0; i < MAX_M; ++i) {\n        link(id[0][i], dst, K, C * i);\n    }\n    \n    for (i32 i = 0; i < n; ++i) {\n        for (i32 j = 0; j < MAX_M - 1; ++j) {\n            link(id[i][j], id[i][j + 1], K, 0);\n        }\n    }\n    \n    for (i32 i = 0; i < m; ++i) {\n        i32 u = conn[i].first;\n        i32 v = conn[i].second;