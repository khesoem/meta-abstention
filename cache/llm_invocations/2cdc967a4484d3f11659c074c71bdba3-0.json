nRoot(P, 0);\n    for (int i = 1; i < P; ++i) {\n        int r = find(i);\n        if (!seenRoot[r]) {\n            seenRoot[r] = 1;\n            ++groups;\n        }\n    }\n\n    long long ways;\n    if (K == 0)\n        ways = binpow(P, P - 1);\n    else if (K == 1)\n        ways = binpow(P, P);\n    else\n        ways = binpow(P, groups);\n\n    printf(\"%lld\\n\", ways);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n\n    static long binpow(long base, long exp) {\n        long result = 1;\n        while (exp > 0) {\n            if ((exp & 1L) == 1L)\n                result = result * base % MOD;\n            base = base * base % MOD;\n            exp >>= 1L;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int P = sc.nextInt();\n        int K = sc.nextInt();\n        sc.close();\n\n        int[] parent = new int[P];\n        int[] compSize = new int[P];\n        for (int i = 0; i < P; ++i) {\n            parent[i] = i;\n            compSize[i] = 1;\n        }\n\n        // Union-Find with path compression and union by size\n        class UnionFind {\n            int find(int x) {\n                if (parent[x] != x)\n                    parent[x] = find(parent[x]);\n                return parent[x];\n            }\n\n            void unite(int a, int b) {\n                int ra = find(a);\n                int rb = find(b);\n                if (ra == rb) return;\n                if (compSize[ra] < compSize[rb]) {\n                    int temp = ra;\n                    ra = rb;\n                    rb = temp;\n                }\n                parent[rb] = ra;\n                compSize[ra] += compSize[rb];\n            }\n        }\n\n   