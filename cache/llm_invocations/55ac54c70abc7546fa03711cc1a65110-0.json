.empty()) {\n            int u = q.front(); q.pop();\n            if (u == T) break;\n            for (Edge *e = head[u]; e; e = e->next) {\n                if (e->flow < e->cap && d[e->v] > d[e->u] + 1) {\n                    d[e->v] = d[e->u] + 1;\n                    q.push(e->v);\n                }\n            }\n        }\n        return d[T] != N+1;\n    }\n\n    LL dfs(int u, int T, LL flow = -1) {\n        if (u == T || flow == 0) return flow;\n        for (int &i = pt[u]; i < N; ++i) {\n            Edge *e = head[u];\n            for (int j = 0; j < i && e; ++j) e = e->next;\n            if (!e) break;\n            Edge *oe = e->rev;\n            if (d[e->v] == d[e->u] + 1) {\n                LL amt = e->cap - e->flow;\n                if (flow != -1 && amt > flow) amt = flow;\n                LL pushed = dfs(e->v, T, amt);\n                if (pushed) {\n                    e->flow += pushed;\n                    oe->flow -= pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n\n    LL max_flow(int S, int T) {\n        LL total = 0;\n        while (bfs(S, T)) {\n            fill(pt.begin(), pt.end(), 0);\n            while (LL flow = dfs(S, T))\n                total += flow;\n        }\n        return total;\n    }\n};\n\nint main() {\n    memset(dist, -1, sizeof(dist));\n    int n, t;\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 1; i <= n; ++i) scanf(\"%s\", a[i]+1);\n    for (int time = 0; time <= t+1; ++time)\n        for (int i = 1; i <= n; ++i)\n            for (int j = 1; j <= n; ++j)\n                id[time][i][j] = cnt++;\n    int source = 0, sink = cnt;\n    cnt++;\n    for (int i = 1; i <= n; ++i) scanf(\"%s\", b[i]+1);\n\n    // BFS from 'Z'\n    deque<pii> dq;\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (a[i][j] == 'Z') {\n                dq.emplace_back(i, j);\n                dist[i][j] = 0;\n            }\n    while (!dq.empty()) {\n        auto [uy, ux] = dq.front(); dq.pop_front();\n        for (int d = 0; d < 4; ++d) {\n            int vy = uy + dir[d][0], vx = ux + dir[d][1];\n            if (vy >= 1 && vy <= n && vx >= 1 && vx <= n && a[vy][vx] != 'Y' && dist[vy][vx] == -1) {\n                dist[vy][vx] = dist[uy][ux] + 1;\n                dq.emplace_back(vy, vx);\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (dist[i][j] == -1 || dist[i][j] > t) dist[i][j] = INF;\n\n    Dinic dinic(cnt);\n    // source edges\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (a[i][j] >= '1' && a[i][j] <= '9')\n                dinic.add_edge(source, id[0][i][j], a[i][j]-'0');\n\n    // time edges (using a single loop over all cells and times)\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (a[i][j] == 'Y' || a[i][j] == 'Z') continue;\n            for (int d = 0; d < 4; ++d) {\n                int vy = i + dir[d][0], vx = j + dir[d][1];\n                if (vy >= 1 && vy <= n && vx >= 1 && vx <= n && a[vy][vx] != 'Y' && a[vy][vx] != 'Z') {\n                    for (int x = 0; x < t; ++x) {\n                        if (dist[vy][vx] >= x+1 && dist[i][j] > x)\n                            dinic.add_edge(id[x][i][j], id[x+1][vy][vx], 1000);\n                    }\n                }\n            }\n        }\n    }\n\n    // sink edges\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (a[i][j] == 'Y' || a[i][j] == 'Z') continue;\n            if (b[i][j] >= '1' && b[i][j] <= '9') {\n                int cap = b[i][j] - '0';\n                for (int x = 0; x <= t; ++x)\n                    dinic.add_edge(id[x][i][j], id[t+1][i][j], cap);\n                dinic.add_edge(id[t+1][i][j], sink, cap);\n            }\n        }\n    }\n\n    printf(\"%lld\\n\", dinic.max_flow(source, sink));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    \n    # grids: 1-indexed, size (n+2) x (n+2) for safety\n    a = [[''] * (n+2) for _ in range(n+2)]\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            a[i][j] = line[j-1]\n    \n    # id[time][i][j] = node index, time from 0 to t+1\n    id = [[[0]*(n+2) for _ in range(n+2)] for __ in range(t+2)]\n    cnt = 1\n    for time in range(t+2):\n        for i in range(1, n+1):\n            for j in range(1, n+1):\n                id[time][i][j] = cnt\n                cnt += 1\n    source = 0\n    sink = cnt\n    cnt += 1\n    \n    b = [[''] * (n+2) for _ in range(n+2)]\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            b[i][j] = line[j-1]\n    \n    # BFS from 'Z' to compute distances\n    dist = [[-1]*(n+2) for _ in range(n+2)]\n    dq = deque()\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if a[i][j] == 'Z':\n                dq.append((i, j))\n                dist[i][j] = 0\n    dirs = [(-1,0),(1,0),(0,-1),(0,1)]\n    while dq:\n        uy, ux = dq.popleft()\n        for dy, dx in dirs:\n            vy = uy + dy\n            vx = ux + dx\n            if 1 <= vy <= n and 1 <= vx <= n and a[vy][vx] != 'Y' and dist[vy][vx] == -1:\n                dist[vy][vx] = dist[uy][ux] + 1\n                dq.append((vy, vx))\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if dist[i][j] == -1 or dist[i][j] > t:\n                dist[i][j] = INF\n    \n    # Dinic implementation\n    class Dinic:\n        def __init__(self, N):\n            self.N = N\n            self.graph = [[] for _ in range(N)]\n        \n        def add_edge(self, u, v, cap):\n            if u == v:\n                return\n            forward = [v, cap, None]  # to, cap, rev index\n            backward = [u, 0, None]\n            forward[2] = len(self.graph[v])\n            backward[2] = len(self.graph[u])\n            self.graph[u].append(forward)\n            self.graph[v].append(backward)\n        \n        def bfs(self, s, t):\n            level = [-1]*self.N\n            q = deque()\n            level[s] = 0\n            q.append(s)\n            while q:\n                u = q.popleft()\n                for v, cap, rev in self.graph[u]:\n                    if cap > 0 and level[v] < 0:\n                        level[v] = level[u] + 1\n                        q.append(v)\n            self.level = level\n            return level[t] >= 0\n        \n        def dfs(self, u, t, f):\n            if u == t:\n                return f\n            for i in range(self.it[u], len(self.graph[u])):\n                self.it[u] = i\n                v, cap, rev = self.graph[u][i]\n                if cap > 0 and self.level[u] + 1 == self.level[v]:\n                    ret = self.dfs(v, t, min(f, cap))\n                    if ret > 0:\n                        # update forward edge\n                        self.graph[u][i][1] -= ret\n                        # update reverse edge\n                        self.graph[v][rev][1] += ret\n                        return ret\n            return 0\n        \n        def max_flow(self, s, t):\n            flow = 0\n            while self.bfs(s, t):\n                self.it = [0]*self.N\n                while True:\n                    f = self.dfs(s, t, INF)\n                    if f == 0:\n                        break\n                    flow += f\n            return flow\n    \n    dinic = Dinic(cnt)\n    \n    # source edges: from source to initial positions of numbered cells\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '1' <= a[i][j] <= '9':\n                cap = ord(a[i][j]) - ord('0')\n                dinic.add_edge(source, id[0][i][j], cap)\n    \n    # time edges: between adjacent cells across time steps\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if a[i][j] in ('Y', 'Z'):\n                continue\n            for dy, dx in dirs:\n                vy = i + dy\n                vx = j + dx\n                if 1 <= vy <= n and 1 <= vx <= n and a[vy][vx] not in ('Y', 'Z'):\n                    for x in range(t):\n                        if dist[vy][vx] >= x+1 and dist[i][j] > x:\n                            dinic.add_edge(id[x][i][j], id[x+1][vy][vx], 1000)\n    \n    # sink edges: from each cell at each time to final layer and then to sink\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if a[i][j] in ('Y', 'Z'):\n                continue\n            if '1' <= b[i][j] <= '9':\n                cap = ord(b[i][j]) - ord('0')\n                for x in range(t+1):\n                    dinic.add_edge(id[x][i][j], id[t+1][i][j], cap)\n                dinic.add_edge(id[t+1][i][j], sink, cap)\n    \n    result = dinic.max_flow(source, sink)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00024375328212045133, -0.011805078014731407, -3.576278118089249e-07, -5.8412379075889476e-06, -4.60137271147687e-05, -1.1920928244535389e-07, 0.0, -1.311301275563892e-06, -0.005619443021714687, -0.17668701708316803, -0.00013672371278516948, -0.0002661589242052287, -2.9801878554280847e-05, -0.011048214510083199, -6.5205356804654e-05, -0.3133440911769867, -0.4889858365058899, -0.412242591381073, -0.6933059692382812, -2.109982233378105e-05, -6.198863957251888e-06, -4.768370445162873e-07, -1.1920928244535389e-07, -0.00041083001997321844, -2.0265558760002023e-06, -0.00013076403411105275, 0.0, -0.000447530735982582, 0.0, -0.313