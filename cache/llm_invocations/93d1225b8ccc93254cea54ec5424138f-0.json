ew long[n + 1];\n\t\t\n\t\tfact[0] = 1;\n\t\tfor (int i = 1; i <= n; i++) {\n\t\t\tfact[i] = (fact[i-1] * i) % MOD;\n\t\t}\n\t\t\n\t\tinvFact[n] = power(fact[n], MOD-2);\n\t\tfor (int i = n-1; i >= 0; i--) {\n\t\t\tinvFact[i] = (invFact[i+1] * (i+1)) % MOD;\n\t\t}\n\t\t\n\t\t// The number of ways to place n rooks with exactly k attacking pairs\n\t\t// is equal to: C(n, n-k) * C(n, n-k) * (n-k)! * S(n, n-k) * 2\n\t\t// where S(n, n-k) is the Stirling numbers of the second kind\n\t\t// But actually, the correct formula is: C(n, k) * C(n, k) * k! * S(n, k+1) * 2\n\t\t// However, after analyzing the problem more carefully:\n\t\t// The number of ways to place n rooks on n x n board so that exactly k pairs attack each other\n\t\t// is equal to: C(n, n-k) * C(n, n-k) * (n-k)! * S(n, n-k) * 2\n\t\t// But actually, the correct formula is: C(n, k+1) * C(n, k+1) * (k+1)! * S(n, k+1) * 2\n\t\t\n\t\t// After research, the correct formula is:\n\t\t// Let m = n - k (number of rows/columns with rooks)\n\t\t// Then the number of ways is: C(n, m) * C(n, m) * m! * S(n, m) * 2\n\t\t// where S(n, m) is the Stirling numbers of the second kind\n\t\t\n\t\tint m = n - k;\n\t\tif (m <= 0 || m > n) {\n\t\t\tout.println(0);\n\t\t\tout.close();\n\t\t\treturn;\n\t\t}\n\t\t\n\t\t// Compute Stirling numbers of the second kind S(n, m)\n\t\tlong[][] S = new long[n+1][m+1];\n\t\tS[0][0] = 1;\n\t\tfor (int i = 1; i <= n; i++) {\n\t\t\tfor (int j = 1; j <= Math.min(i, m); j++) {\n\t\t\t\tS[i][j] = (S[i-1][j-1] + j * S[i-1][j]) % MOD;\n\t\t\t}\n\t\t}\n\t\t\n\t\tlong stirling = S[n][m];\n\t\t\n\t\t// C(n, m) = fact[n] * invFact[m] * invFact[n-m] % MOD\n\t\tlong comb = fact[n] * invFact[m] % MOD * invFact[n-m] % MOD;\n\t\t\n\t\t// Final answer: 2 * C(n, m)^2 * m! * S(n, m)\n\t\tlong ans = 2 * comb % MOD * comb % MOD * fact[m] % MOD * stirling % MOD;\n\t\t\n\t\tout.println(ans);\n\t\tout.close();\n\t}\n\t\n\tstatic long power(long x, int y) {\n\t\tlong res = 1;\n\t\tx %= MOD;\n\t\twhile (y > 0) {\n\t\t\tif