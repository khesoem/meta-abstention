atic int[] data;\n    \n    public static void main(String[] args) throws Exception {\n        int totalItems = input.nextInt();\n        int budget = input.nextInt();\n        data = new int[totalItems];\n        for (int idx = 0; idx < totalItems; idx++) {\n            data[idx] = input.nextInt();\n        }\n        \n        if (totalItems % 2 == 1) {\n            System.out.print(0);\n            return;\n        }\n        \n        int evenCount = 0, oddCount = 0;\n        for (int i = 0; i < totalItems; i++) {\n            if (data[i] % 2 == 0) evenCount++;\n            else oddCount++;\n            \n            if (evenCount > 0 && oddCount > 0 && evenCount == oddCount && i + 1 < totalItems) {\n                cache.put(i, Math.abs(data[i] - data[i + 1]));\n            }\n        }\n        \n        if (cache.isEmpty()) {\n            System.out.print(0);\n            return;\n        }\n        \n        List<Integer> costs = new ArrayList<>(cache.values());\n        Collections.sort(costs);\n        \n        int selectedCount = 0;\n        for (int cost : costs) {\n            if (cost <= budget) {\n                budget -= cost;\n                selectedCount++;\n            } else {\n                break;\n            }\n        }\n        System.out.print(selectedCount);\n    }\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nclass Reader:\n    def __init__(self):\n        self.lines = []\n        self.index = 0\n    \n    def read_line(self):\n        if self.index >= len(self.lines):\n            line = sys.stdin.readline()\n            if not line:\n                return None\n            self.lines.append(line)\n            self.index = 1\n            return line.strip()\n        else:\n            self.index += 1\n            return self.lines[self.index - 1].strip()\n    \n    def next(self):\n        line = self.read_line()\n        while line is None or line == \"\":\n            line = self.read_line()\n        tokens = line.split()\n        if not hasattr(self, 'token_index'):\n            self.token_index = 0\n            self.current_tokens = tokens\n        while self.token_index >= len(self.current_tokens):\n            line = self.read_line()\n            if line is None:\n                return None\n            tokens = line.split()\n            self.current_tokens = tokens\n            self.token_index = 0\n        token = self.current_tokens[self.token_index]\n        self.token_index += 1\n        return token\n    \n    def next_int(self):\n        return int(self.next())\n    \n    def next_long(self):\n        return int(self.next())\n    \n    def next_double(self):\n        return float(self.next())\n    \n    def next_line(self):\n        return self.read_line()\n\ninput = Reader()\ncache = {}\ndata = []\n\ndef main():\n    total_items = input.next_int()\n    budget = input.next_int()\n    data = [0] * total_items\n    for idx in range(total_items):\n        data[idx] = input.next_int()\n    \n    if total_items % 2 == 1:\n        print(0)\n        return\n    \n    even_count = 0\n    odd_count = 0\n    for i in range(total_items):\n        if data[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        \n        if even_count > 0 and odd_count > 0 and even_count == odd_count and i + 1 < total_items:\n            cache[i] = abs(data[i] - data[i + 1])\n    \n    if not cache:\n        print(0)\n        return\n    \n    costs = sorted(cache.values())\n    \n    selected_count = 0\n    for cost in costs:\n        if cost <= budget:\n            budget -= cost\n            selected_count += 1\n        else:\n            break\n    print(selected_count)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "tok