e <vector>\n#include <queue>\n#include <map>\n#include <string>\n#include <algorithm>\n#include <climits>\n#include <random>\n#include <fstream>\n#include <sstream>\n#include <unordered_map>\n#include <unordered_set>\n\nusing namespace std;\n\nconst int INF = INT_MAX / 3;\n\nclass DStress2 {\npublic:\n    void solve() {\n        int n;\n        cin >> n;\n        string s;\n        cin >> s;\n        cout << solve(s) << endl;\n    }\n\n    void stress() {\n        mt19937 rng(123);\n        for (int IT = 0; IT < 10000; IT++) {\n            int n = 1 + rng() % 12;\n            string c(n, ' ');\n            for (int i = 0; i < n; i++) {\n                c[i] = \"AVK\"[rng() % 3];\n            }\n\n            int ans1 = solve(c);\n            int ans2 = stupid(c);\n            if (ans1 != ans2) {\n                cerr << IT << \" \" << ans1 << \" \" << ans2 << \" \" << c << endl;\n                break;\n            }\n        }\n    }\n\n    int stupid(string s) {\n        queue<string> q;\n        unordered_map<string, int> dist;\n        q.push(s);\n        dist[s] = 0;\n        while (!q.empty()) {\n            s = q.front();\n            q.pop();\n            int cur = dist[s];\n            if (s.find(\"VK\") == string::npos) {\n                return cur;\n            }\n\n            for (int pos = 0; pos < (int)s.length() - 1; pos++) {\n                string next = s.substr(0, pos) + s[pos+1] + s[pos] + s.substr(pos+2);\n                if (dist.find(next) == dist.end()) {\n                    dist[next] = cur + 1;\n                    q.push(next);\n                }\n            }\n        }\n        return 0;\n    }\n\n    int solve(string s) {\n        vector<int> vPos, kPos, otherPos;\n\n        for (int i = 0; i < s.length(); i++) {\n            if (s[i] == 'V') {\n                vPos.push_back(i);\n            } else if (s[i] == 'K') {\n                kPos.push_back(i);\n            } else {\n                otherPos.push_back(i);\n            }\n  