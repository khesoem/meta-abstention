1 << (n * h)):\n        p = 1\n        for bit in range(n * h):\n            row = bit // n\n            col = bit % n\n            if mask & (1 << bit):\n                p = (p * P[row][col]) % MOD\n                p = (p * inv100) % MOD\n            else:\n                p = (p * (100 - P[row][col])) % MOD\n                p = (p * inv100) % MOD\n        \n        success_mask = 0\n        for m_idx, m in enumerate(masks):\n            selected = []\n            for k in range(n):\n                if m & (1 << k):\n                    selected.append(k)\n            selected.sort()\n            valid_found = False\n            for perm in permutations(selected):\n                valid = True\n                for idx, val in enumerate(perm):\n                    bit_pos = idx * n + val\n                    if not (mask & (1 << bit_pos)):\n                        valid = False\n                        break\n                if valid:\n                    valid_found = True\n                    break\n            if valid_found:\n                success_mask |= (1 << m_idx)\n        \n        prob[success_mask] = (prob[success_mask] + p) % MOD\n    \n    # Second part: process all masks for second half\n    for mask in range(1 << (n * h2)):\n        p = 1\n        for bit in range(n * h2):\n            row = bit // n + h\n            col = bit % n\n            if mask & (1 << bit):\n                p = (p * P[row][col]) % MOD\n                p = (p * inv100) % MOD\n            else:\n                p = (p * (100 - P[row][col])) % MOD\n                p = (p * inv100) % MOD\n        \n        success_mask = 0\n        for m_idx, m in enumerate(masks):\n            selected = []\n            for k in range(n):\n                if not (m & (1 << k)):\n                    selected.append(k)\n            selected.sort()\n            valid_found = False\n            for perm in permutations(selected):\n                valid = True\n                for idx, val in enumerate(perm):\n                    bit_pos = idx * n + val\n                    if not (mask & (1 << bit_pos)):\n                        valid = False\n                        break\n                if valid:\n                    valid_found = True\n                    break\n            if valid_found:\n                success_mask |= (1 << m_idx)\n        \n        prob2[success_mask] = (prob2[success_mask] + p) % MOD\n    \n    # Sum over subsets for prob2\n    num_masks = len(masks)\n    for i in range(1 << num_masks):\n        for j in range(num_masks):\n            if i & (1 << j):\n                prob2[i] = (prob2[i] + prob2[i ^ (1 << j)]) % MOD\n    \n    # Calculate final answer\n    answer = 0\n    for i in range(1 << num_masks):\n        answer = (answer + prob[i] * prob2[((1 << num_masks) - 1) ^ i]) % MOD\n    \n    print((MOD + 1 - answer) % MOD)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012861855793744326, -1.1920922133867862e-06, -4.768370445162873e-07, -0.005319488234817982, -0.015606298111379147, -0.0336533784866333, -0.35124894976615906, -0.08038546144962311, -4.768370445162873e-07, -0.10047841817140579, -0.008101577870547771, -0.00018749863374978304, -0.02328609488904476, -0.14882828295230865, -4.768370445162873e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -0.0007107115816324949, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -5.8412379075889476e-06, -2.622600959512056e-06, -1.1920928244535389e-07, -4.076874756719917e-05, -0.00011062010162277147, -0.000163541772053577, -0.38786670565605164, -1.7881377516459906e-06, -1.1920928244535389e-07, -4.1483970562694594e-05, -0.023255929350852966, -5.960462772236497e-07, -1.3470558769768104e-05, 0.0, 0.0, -1.1920928244535389e-07, -1.07287787614041e-05, 0.0, -8.344646857949556e-07, -0.00010990492592100054, -1.7762025890988298e-05, -2.3841855067985307e-07, -2.753696753643453e-05, -4.17