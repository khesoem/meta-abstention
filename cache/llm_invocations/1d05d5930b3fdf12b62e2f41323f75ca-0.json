inus >= 0; minus--) {\n                        for (int carry = 0; carry <= 2 * shift; carry++) {\n                            int val = dp[plus][minus][carry];\n                            if (val == Integer.MAX_VALUE) continue;\n\n                            int realCarry = carry - shift;\n                            int curN = plus - minus + realCarry;\n                            int curD = ((curN % 10) + 10) % 10;\n                            int newCarry = (curN - curD) / 10;\n\n                            if (curD == digit) {\n                                int cost = plus + minus + val;\n                                nextDP[plus][minus][newCarry + shift] = Math.min(nextDP[plus][minus][newCarry + shift], cost);\n                            }\n\n                            if (plus + 1 <= maxn) {\n                                nextDP[plus][minus][carry] = Math.min(nextDP[plus][minus][carry], dp[plus + 1][minus][carry]);\n                            }\n                            if (minus + 1 <= maxn) {\n                                nextDP[plus][minus][carry] = Math.min(nextDP[plus][minus][carry], dp[plus][minus + 1][carry]);\n                            }\n                        }\n                    }\n                }\n\n                dp = nextDP;\n            }\n\n            int ans = Integer.MAX_VALUE;\n            for (int i = 0; i <= maxn; i++) {\n                for (int j = 0; j <= maxn; j++) {\n                    ans = Math.min(ans, dp[i][j][shift]);\n                }\n            }\n            out.println(ans);\n        }\n\n        private void initializeDP(int[][][] arr) {\n            for (int[][] layer : arr) {\n                for (int[] row : layer) {\n                    Arrays.fill(row, Integer.MAX_VALUE);\n                }\n            }\n        }\n    }\n\n    static class FastScanner extends BufferedReader {\n        public FastScanner(InputStream is) {\n            super(new InputStreamReader(is));\n        }\n\n      