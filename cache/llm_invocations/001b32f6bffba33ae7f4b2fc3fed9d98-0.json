0_000]; // max edges\n    static ArrayList<Integer>[] adj;\n    static int[] dist = new int[1_000_000];\n    static int[] prevEdge = new int[1_000_000];\n    static boolean[] inQueue = new boolean[1_000_000];\n    static ArrayDeque<Integer> queue = new ArrayDeque<>();\n\n    @SuppressWarnings(\"unchecked\")\n    static void initFlow(int _sink) {\n        sink = _sink;\n        adj = new ArrayList[sink + 1];\n        for (int i = 0; i <= sink; i++) adj[i] = new ArrayList<>();\n        edgeCnt = 0;\n    }\n\n    static void addEdge(int x, int y, int cap, int cost, int type) {\n        adj[x].add(edgeCnt);\n        edges[edgeCnt++] = new Edge(y, cap, cost, type);\n        adj[y].add(edgeCnt);\n        if (type == 1) {\n            edges[edgeCnt++] = new Edge(x, 0, -C + d, type);\n        } else {\n            edges[edgeCnt++] = new Edge(x, 0, -cost, type);\n        }\n    }\n\n    static int augment() {\n        for (int i = 0; i <= sink; i++) {\n            dist[i] = INF;\n            inQueue[i] = false;\n        }\n        queue.clear();\n        queue.addLast(0);\n        dist[0] = 0;\n        inQueue[0] = true;\n        while (!queue.isEmpty()) {\n            int x = queue.removeFirst();\n            inQueue[x] = false;\n            for (int idx = 0; idx < adj[x].size(); idx++) {\n                int r = adj[x].get(idx);\n                Edge e = edges[r];\n                if (e.c > 0 && dist[x] + e.v < dist[e.y]) {\n                    dist[e.y] = dist[x] + e.v;\n                    prevEdge[e.y] = r;\n                    if (!inQueue[e.y]) {\n                        inQueue[e.y] = true;\n                        queue.addLast(e.y);\n                    }\n                }\n            }\n        }\n        if (dist[sink] == INF) return -1;\n        int cur = sink;\n        while (cur != 0) {\n            int r = prevEdge[cur];\n            Edge e = edges[r];\n            if (e.ty == 1) {\n                e.v += 2 * d;\n                edges[r ^ 1].v -= 2 * d;\n  