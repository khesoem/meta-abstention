\twhile(pq.top().val != 0){\n\t\tll val = pq.top().val;\n\t\tint cost = pq.top().cost;\n\t\tpq.pop();\n\n\t\tif(wasVisited(val))\n\t\t\tcontinue;\n\t\tvisited.insert(val);\n\n\t\tfor (step next : { lower(val), upper(val), uupper(val) }) {\n\t\t\tnext.cost += cost;\n\t\t\tnext.val = abs(val - next.val);\n\t\t\tpq.push(next);\n\n\t\t}\n\n\t}\n\n\tcout << pq.top().cost << endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Step {\n        long val;\n        int cost;\n\n        Step(long val, int cost) {\n            this.val = val;\n            this.cost = cost;\n        }\n\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            Step step = (Step) o;\n            return val == step.val && cost == step.cost;\n        }\n\n        @Override\n        public int hashCode() {\n            return Objects.hash(val, cost);\n        }\n    }\n\n    static class StepComparator implements Comparator<Step> {\n        @Override\n        public int compare(Step a, Step b) {\n            return Integer.compare(b.cost, a.cost);\n        }\n    }\n\n    static Set<Long> visited = new HashSet<>();\n\n    static boolean wasVisited(long c) {\n        return visited.contains(c);\n    }\n\n    static Step uupper(long n) {\n        long res = 0;\n        int i = 0;\n        while (res < n) {\n            res = res * 10 + 1;\n            i++;\n        }\n        return new Step(res, i);\n    }\n\n    static Step upper(long n) {\n        long res = 0;\n        int i = 0;\n        while (res * 10 + 1 <= n) {\n            res = res * 10 + 1;\n            i++;\n        }\n        long resmul = res;\n        int imul = i;\n        while (res < n) {\n            res += resmul;\n            i += imul;\n        }\n        return new Step(res, i);\n    }\n\n    static Step lower(long n) {\n        long res = 0;\n        int i = 0;\n        while (res * 10 + 1 <= n) {\n            res = res * 10 + 1;\n            i++;\n        }\n        long resmul = res;\n        int imul = i;\n        while (res + resmul <= n) {\n            res += resmul;\n            i += imul;\n        }\n        return new Step(res, i);\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long n = scanner.nextLong();\n\n        PriorityQueue<Step> pq = new PriorityQueue<>(new StepComparator());\n        pq.offer(new Step(n, 0));\n\n        while (pq.peek().val != 0) {\n            long val = pq.peek().val;\n            int cost = pq.peek().cost;\n            pq.poll();\n\n            if (wasVisited(val)) {\n                continue;\n            }\n            visited.add(val);\n\n            Step[] nextSteps = {lower(val), upper(val), uupper(val)};\n            for (Step next : nextSteps) {\n                next.cost += cost;\n                next.val = Math.abs(val - next.val);\n                pq.offer(next);\n            }\n        }\n\n        System.out.println(pq.peek().cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013064485392533243, -3.099436753473128e-06, -3.576278118089249e-07, -6.627816765103489e-05, -3.421248038648628e-05, -0.005240868777036667, -0.0036283391527831554, -0.00011276562872808427, -2.145764938177308e-06, -5.352353764465079e-05, -0.08894076198339462, -0.04892135411500931, -0.03208305314183235, -0.10747384279966354, -0.0001879753835964948, -0.01604033075273037, -4.768370445162873e-07, -1.764281842042692e-05, -2.0265558760002023e-06, -1.4305104514278355e-06, -8.344646857949556e-07, -3.3378546504536644e-06, -1.1920922133867862e-06, -0.3132619857788086, -4.529942543740617e-06, -0.008677513338625431, -4.172316494077677e-06, -0.0007107115816324949,