        while x > 0:\n            self.read()\n            x -= 1\n\n    def next_int(self):\n        return int(self.next())\n\n    def next_long(self):\n        return int(self.next())\n\n    def next_string(self):\n        return self.next()\n\n    def next(self):\n        c = self.read()\n        while self._is_space_char(c):\n            c = self.read()\n        res = []\n        while not self._is_space_char(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def next_line(self):\n        res = []\n        c = self.read()\n        while c != ord('\\n') and c != -1:\n            if c != ord('\\r'):\n                res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def next_double(self):\n        c = self.read()\n        while self._is_space_char(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0.0\n        while not self._is_space_char(c) and c != ord('.'):\n            if c == ord('e') or c == ord('E'):\n                return res * (10 ** self.next_int())\n            if c < ord('0') or c > ord('9'):\n                raise ValueError(\"Input mismatch\")\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        if c == ord('.'):\n            c = self.read()\n            m = 1.0\n            while not self._is_space_char(c):\n                if c == ord('e') or c == ord('E'):\n                    return res * (10 ** self.next_int())\n                if c < ord('0') or c > ord('9'):\n                    raise ValueError(\"Input mismatch\")\n                m /= 10.0\n                res += (c - ord('0')) * m\n                c = self.read()\n        return res * sgn\n\n    def has_next(self):\n        value = self.peek()\n        while self._is_space_char(value) and value != -1:\n            self.read()\n            value = self.peek()\n        return value != -1\n\n    def _is_space_char(self, c):\n        return c == ord(' ') or c == ord('\\n') or c == ord('\\r') or c == ord('\\t') or c == -1\n\n\ndef main():\n    inp = InputReader(sys.stdin.buffer)\n    n = inp.next_int()\n    b = inp.next_int()\n    arr1 = [0] * n\n    for i in range(n):\n        arr1[i] = inp.next_int()\n    \n    odd = 0\n    even = 0\n    pf1 = [0] * n\n    pf2 = [0] * n\n    sum1 = 0\n    sum2 = 0\n    for i in range(n):\n        if arr1[i] % 2 == 0:\n            sum1 += 1\n        else:\n            sum2 += 1\n        pf1[i] = sum1\n        pf2[i] = sum2\n    \n    prev = 0\n    arr = [0] * n\n    p = 0\n    for i in range(1, n - 2, 2):\n        if prev == 0:\n            x = pf1[i]\n            y = pf2[i]\n        else:\n            x = pf1[i] - pf1[prev]\n            y = pf2[i] - pf2[prev]\n        if x == y:\n            arr[p] = abs(arr1[i + 1] - arr1[i])\n            p += 1\n    \n    val = [1] * p\n    K = [[0] * (b + 1) for _ in range(p + 1)]\n    for i in range(p + 1):\n        for w in range(b + 1):\n            if i == 0 or w == 0:\n                K[i][w] = 0\n            elif arr[i - 1] <= w:\n                K[i][w] = max(val[i - 1] + K[i - 1][w - arr[i - 1]], K[i - 1][w])\n            else:\n                K[i][w] = K[i - 1][w]\n    \n    print(K[p][b])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.6808368e-05, 0.0, -7.152555e-07, -0.00033849708, -0.01731646, -0.00024172722, -0.030051462, -0.9758705, -0.001086479, -2.145765e-06, -1.1086402e-05, -3.6954812e-06, -1.8238856e-05, -8.344647e-07, -3.576278e-07, -1.1920928e-07, 0.0, -3.5404533e-05, -0.0016217188, -0.038336646, -3.576278e-07, -5.960463e-07, -0.00015984688, 0.0, -1.1920928e-07, -8.082063e-05, -1.1920928e-07, -8.344647e-07, -1.001353e-05, -0.0019290901, -1.1920928e-07, -0.07877737, 0.0, -0.00524917, -5.078187e-05, -3.3378547e-06, -2.002696e-05, 0.0, -1.1920928e-07, -0.00015114596, -5.960463e-07, -0.160