{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\nconst int MAXV=2000005;\nint edge_cnt=1,head[MAXV],nxt[MAXV],to[MAXV],cap[MAXV],cost[MAXV],dist[MAXV],S,T,n,m,x[2005],y[2005],vis[MAXV],cur[MAXV],k,c,d;\nqueue<int> q;\nvoid add(int u,int v,int c,int w){\n\tnxt[++edge_cnt]=head[u]; head[u]=edge_cnt; to[edge_cnt]=v; cap[edge_cnt]=c; cost[edge_cnt]=w;\n\tnxt[++edge_cnt]=head[v]; head[v]=edge_cnt; to[edge_cnt]=u; cap[edge_cnt]=0; cost[edge_cnt]=-w;\n}\nbool bellman_ford(){\n\tfill(dist,dist+MAXV,0x3f3f3f3f);\n\tdist[S]=0; q.push(S); vis[S]=1;\n\twhile(!q.empty()){\n\t\tint u=q.front(); q.pop(); vis[u]=0;\n\t\tfor(int i=head[u];i;i=nxt[i]){\n\t\t\tint v=to[i];\n\t\t\tif(cap[i] && dist[v]>dist[u]+cost[i]){\n\t\t\t\tdist[v]=dist[u]+cost[i];\n\t\t\t\tif(!vis[v]){ vis[v]=1; q.push(v); }\n\t\t\t}\n\t\t}\n\t}\n\treturn dist[T]<=1e9;\n}\nint dfs(int u,int f){\n\tif(u==T) return f;\n\tvis[u]=1;\n\tint flow=0,used;\n\tfor(int &i=cur[u];i;i=nxt[i]){\n\t\tint v=to[i];\n\t\tif(!vis[v] && cap[i] && dist[v]==dist[u]+cost[i] && (used=min(f,dfs(v,min(f,cap[i]))))){\n\t\t\tcap[i]-=used;\n\t\t\tcap[i^1]+=used;\n\t\t\tflow+=used; f-=used;\n\t\t\tif(!f) break;\n\t\t}\n\t}\n\tvis[u]=0;\n\treturn flow;\n}\nint mincost(){\n\tint ans=0;\n\twhile(bellman_ford()){\n\t\tfor(int i=S;i<=n+1+n*(n+k);i++) cur[i]=head[i];\n\t\tans+=dfs(S,1e9)*dist[T];\n\t\tfill(vis,vis+MAXV,0);\n\t}\n\treturn ans;\n}\nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tS=0; T=1;\n\tfor(int i=1;i<=k;i++){\n\t\tint t; scanf(\"%d\",&t);\n\t\tadd(S,t+1,1,0);\n\t}\n\tfor(int i=1;i<=m;i++) scanf(\"%d%d\",&x[i],&y[i]);\n\tfor(int i=0;i<=n+k;i++){\n\t\tadd(2+i*n,T,k,0);\n\t\tif(i==n+k) break;\n\t\tfor(int j=1;j<=m;j++)\n\t\t\tfor(int l=k;l>=0;l--){\n\t\t\t\tadd(x[j]+1+i*n, y[j]+1+i*n+n, 1, (l*2+1)*d+c);\n\t\t\t\tadd(y[j]+1+i*n, x[j]+1+i*n+n, 1, (l*2+1)*d+c);\n\t\t\t}\n\t\tfor(int j=1;j<=n;j++) add(j+1+i*n, j+1+i*n+n, k, c);\n\t}\n\tprintf(\"%d\\n\",mincost());\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXV = 2000005\nedge_cnt = 1\nhead = [0] * (MAXV + 5)\nnxt = [0] * (MAXV * 10)  # allocate large enough, will extend dynamically\nto = [0] * (MAXV * 10)\ncap = [0] * (MAXV * 10)\ncost = [0] * (MAXV * 10)\ndist = [0] * (MAXV + 5)\nvis = [0] * (MAXV + 5)\ncur = [0] * (MAXV + 5)\n\ndef add(u, v, c, w):\n    global edge_cnt\n    edge_cnt += 1\n    nxt[edge_cnt] = head[u]\n    head[u] = edge_cnt\n    to[edge_cnt] = v\n    cap[edge_cnt] = c\n    cost[edge_cnt] = w\n    edge_cnt += 1\n    nxt[edge_cnt] = head[v]\n    head[v] = edge_cnt\n    to[edge_cnt] = u\n    cap[edge_cnt] = 0\n    cost[edge_cnt] = -w\n\ndef bellman_ford():\n    INF = 0x3f3f3f3f\n    for i in range(MAXV + 1):\n        dist[i] = INF\n    dist[S] = 0\n    q = deque()\n    q.append(S)\n    vis[S] = 1\n    while q:\n        u = q.popleft()\n        vis[u] = 0\n        i = head[u]\n        while i:\n            v = to[i]\n            if cap[i] and dist[v] > dist[u] + cost[i]:\n                dist[v] = dist[u] + cost[i]\n                if not vis[v]:\n                    vis[v] = 1\n                    q.append(v)\n            i = nxt[i]\n    return dist[T] <= 1e9\n\ndef dfs(u, f):\n    if u == T:\n        return f\n    vis[u] = 1\n    flow = 0\n    i = cur[u]\n    while i:\n        v = to[i]\n        if not vis[v] and cap[i] and dist[v] == dist[u] + cost[i]:\n            used = min(f, dfs(v, min(f, cap[i])))\n            if used:\n                cap[i] -= used\n                cap[i ^ 1] += used\n                flow += used\n                f -= used\n                if f == 0:\n                    break\n        i = nxt[i]\n        cur[u] = i\n    vis[u] = 0\n    return flow\n\ndef mincost():\n    ans = 0\n    while bellman_ford():\n        for i in range(S, n + 1 + n * (n + k) + 1):\n            cur[i] = head[i]\n        ans += dfs(S, 10**9) * dist[T]\n        for i in range(MAXV + 1):\n            vis[i] = 0\n    return ans\n\ndef main():\n    global S, T, n, m, k, c, d\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    S = 0\n    T = 1\n    for _ in range(k):\n        t = next(it)\n        add(S, t + 1, 1, 0)\n    x = [0] * (m + 1)\n    y = [0] * (m + 1)\n    for i in range(1, m + 1):\n        x[i] = next(it)\n        y[i] = next(it)\n    for i in range(0, n + k + 1):\n        add(2 + i * n, T, k, 0)\n        if i == n + k:\n            break\n        for j in range(1, m + 1):\n            for l in range(k, -1, -1):\n                add(x[j] + 1 + i * n, y[j] + 1 + i * n + n, 1, (l * 2 + 1) * d + c)\n                add(y[j] + 1 + i * n, x[j] + 1 + i * n + n, 1, (l * 2 + 1) * d + c)\n        for j in range(1, n + 1):\n            add(j + 1 + i * n, j + 1 + i * n + n, k, c)\n    print(mincost())\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(1000000)\n    main()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_lo