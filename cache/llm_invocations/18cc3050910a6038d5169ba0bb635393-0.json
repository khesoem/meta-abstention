\n    for (int i = 1; i < n; i++) {\n        for (int u = 0; u < n; u++) {\n            for (const Edge& e : adj[u]) {\n                if (e.c) {\n                    pot[e.v] = min(pot[e.v], pot[u] + e.p);\n                }\n            }\n        }\n    }\n}\n\nll min_cost_augment(int s, int t, ll& price, int n, bool sparse) {\n    fill(vis, vis + n, false);\n    fill(dist, dist + n, INF);\n    dist[s] = 0;\n\n    if (sparse) {\n        priority_queue<pair<ll, int>> dk;\n        dk.push({0, s});\n        while (!dk.empty()) {\n            int u = dk.top().second;\n            dk.pop();\n            if (vis[u]) continue;\n            for (const Edge& e : adj[u]) {\n                if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                    dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                    par[e.v] = e.r;\n                    dk.push({-dist[e.v], e.v});\n                }\n            }\n        }\n    } else {\n        for (int u = s; u != -1; ) {\n            vis[u] = true;\n            for (const Edge& e : adj[u]) {\n                if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                    dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                    par[e.v] = e.r;\n                }\n            }\n            u = -1;\n            ll best = INF;\n            for (int i = 0; i < n; i++) {\n                if (!vis[i] && dist[i] < best) {\n                    best = dist[u = i];\n                }\n            }\n        }\n    }\n\n    if (dist[t] >= INF) {\n        return 0;\n    }\n\n    ll df = INF;\n    for (int u = t; u != s; ) {\n        const Edge& r = adj[u][par[u]];\n        df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f);\n        u = r.v;\n    }\n\n    for (int u = t; u != s; ) {\n        Edge& r = adj[u][par[u]];\n        Edge& e = adj[r.v][r.r];\n        e.f += df;\n        r.f -= df;\n        price += df * e.p;\n        u = r.v;\n    }\n\n    for (int i = 0; i < n; i++) {\n        pot[i] = min(INF, dist[i] + pot[i]);\n    }\n\n    return df;\n}\n\nll min_cost_flow(int s, int t, ll& price, int n = MAX_NODES, bool sparse = false) {\n    ll flow = 0;\n    price = 0;\n    while (ll df = min_cost_augment(s, t, price, n, sparse)) {\n        flow += df;\n    }\n    return flow;\n}\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0); cout.tie(0);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n\n    for (int i = 0; i < k; i++) {\n        int a;\n        cin >> a;\n        add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; t++) {\n        add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; i++) {\n                add_edge(i + (t - 1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; i++) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; j++) {\n            int cost = (j + 1) * (j + 1) - j * j;\n            for (int t = 1; t < T; t++) {\n                add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price, flow = min_cost_flow(source, sink, price, sink + 1, true);\n    assert(flow == k);\n    cout << price << nl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport heapq\nfrom collections import defaultdict\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(map(int, data))\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    \n    T = 99\n    C = 12\n    MAX_NODES = 50 * T + 2\n    \n    # Edge structure: v, r, f, c, p\n    adj = [[] for _ in range(MAX_NODES)]\n    sz = [0] * MAX_NODES\n    mc = 0\n    \n    def add_edge(a, b, cap=1, cost=0):\n        nonlocal mc\n        mc = max(mc, cap)\n        # Forward edge\n        adj[a].append([b, len(adj[b]), 0, cap, cost])\n        # Backward edge\n        adj[b].append([a, len(adj[a]) - 1, 0, 0, -cost])\n        sz[a] += 1\n        sz[b] += 1\n    \n    source = 0\n    sink = n * T + 1\n    \n    for _ in range(k):\n        a = next(it)\n        add_edge(source, a, 1, 0)\n    \n    for t in range(T):\n        add_edge(1 + t * n, sink, float('inf'), 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                add_edge(i + (t - 1) * n, i + t * n, float('inf'), c)\n    \n    for _ in range(m):\n        a = next(it)\n        b = next(it)\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n    \n    INF = float('inf')\n    INFLL = INF\n    \n    # Min cost flow implementation\n    def min_cost_flow(s, t, n):\n        price = 0\n        flow = 0\n        pot = [0] * n\n        \n        # Initialize potentials using Bellman-Ford-like approach\n        for _ in range(n):\n            updated = False\n            for u in range(n):\n                for e in adj[u]:\n                    if e[3] > 0 and pot[e[0]] > pot[u] + e[4]:\n                        pot[e[0]] = pot[u] + e[4]\n                        updated = True\n            if not updated:\n                break\n        \n        while True:\n            dist = [INF] * n\n            par = [-1] * n\n            vis = [False] * n\n            dist[s] = 0\n            \n            # Dijkstra with potential\n            heap = [(0, s)]\n            while heap:\n                d, u = heapq.heappop(heap)\n                if vis[u]:\n                    continue\n                vis[u] = True\n                for e in adj[u]:\n                    if e[2] < e[3] and dist[e[0]] > dist[u] + pot[u] - pot[e[0]] + e[4]:\n                        dist[e[0]] = dist[u] + pot[u] - pot[e[0]] + e[4]\n                        par[e[0]] = e[1]\n                        heapq.heappush(heap, (dist[e[0]], e[0]))\n            \n            if dist[t] >= INF:\n                break\n            \n            df = INF\n            u = t\n            while u != s:\n                e = adj[u][par[u]]\n                rev_e = adj[e[0]][e[1]]\n                df = min(df, rev_e[3] - rev_e[2])\n                u = e[0]\n            \n            u = t\n            while u != s:\n                e = adj[u][par[u]]\n                rev_e = adj[e[0]][e[1]]\n                rev_e[2] += df\n                e[2] -= df\n                price += df * rev_e[4]\n                u = e[0]\n            \n            for i in range(n):\n                pot[i] = min(INF, dist[i] + pot[i])\n            \n            flow += df\n        \n        return flow, price\n    \n    flow, price = min_cost_flow(source, sink, sink + 1)\n    \n    if flow != k:\n        print(-1)\n    else:\n        print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00021479207498487085, -9.536738616588991e-07, -1.1920928244535389e-07, -8.487341256113723e-05, -0.0023360364139080048, -7.152555099310121e-07, -0.0019315887475386262, -0.47910410165786743, -1.1920928244535389e-07, -0.004622369538992643, -0.1500098556280136, -0.005930802319198847, -0.0008322112844325602, -0.010490866377949715, -2.3841855067985307e-07, -0.008622794412076473, -0.019461050629615784, -0.3816841244697571, -0.006177142728120089, -4.1126360883936286e-05, -1.5497195136049413e-06, -0.012970838695764542, -0.6952322721481323, -6.198863957251888e-06, -3.707340147229843e-05, -0.012812908738851547, -0.0005492847412824631, -2.622600959512056e-06, -0.00012563870404846966, -1.19209