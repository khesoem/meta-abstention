k as signed long long\n            return struct.unpack('>q', struct.pack('>d', v))[0]\n        hx = double_to_long(self.x)\n        hy = double_to_long(self.y)\n        return hx ^ (hy * 31)\n\n    @staticmethod\n    def eq(a, b):\n        return abs(a - b) < EPS\n\n    @staticmethod\n    def leq(a, b):\n        return a - EPS < b\n\n    @staticmethod\n    def geq(a, b):\n        return a + EPS > b\n\n\nclass Circle:\n    def __init__(self, c, r):\n        self.c = c\n        self.r = r\n\n    def contains(self, v):\n        return self.c.sub(v).mag2() - EPS*EPS <= self.r * self.r\n\n    def intersect(self, o):\n        if self.c == o.c:\n            return None\n        dir = o.c.sub(self.c)\n        d2 = dir.mag2()\n        d = math.sqrt(d2)\n        if self.r + o.r < d or self.r + d < o.r or o.r + d < self.r:\n            return None\n        if Vec.eq(self.r + o.r, d) or Vec.eq(o.r + d, self.r):\n            return [self.c.add(dir.scale(self.r / d))]\n        if Vec.eq(self.r + d, o.r):\n            return [self.c.sub(dir.scale(self.r / d))]\n\n        d1 = (self.r * self.r + d2 - o.r * o.r) / (2 * d)\n        h = math.sqrt(self.r * self.r - d1 * d1)\n        unitDir = dir.unit()\n        rInt = self.c.add(unitDir.scale(d1).add(unitDir.rot270().scale(h)))\n        lInt = self.c.add(unitDir.scale(d1).add(unitDir.rot90().scale(h)))\n        return [rInt, lInt]\n\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    circ = []\n    for _ in range(n):\n        x = int(next(it))\n        y = int(next(it))\n        r = int(next(it))\n        circ.append(Circle(Vec(x, y), r))\n\n    points = set()\n    par = list(range(n))\n    res = 1\n\n    for i in range(n):\n        points2 = set()\n        for j in range(n):\n            if i == j:\n                continue\n            arr = circ[i].intersect(circ[j])\n            if arr is None:\n                continue\n            # path compression to grandparent\n       