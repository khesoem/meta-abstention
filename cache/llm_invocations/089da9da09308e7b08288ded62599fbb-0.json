 * (j - 1), INF);\n                if (j > 1) addEdge(id[i][j - 1], id[i][j], 0, INF);\n            }\n            if (people[i] > 0) addEdge(src, id[i][1], 0, people[i]);\n        }\n        for (int i = 1; i <= m; i++) {\n            int a = scanner.nextInt();\n            int b = scanner.nextInt();\n            for (int j = 1; j <= k + m + 1; j++) {\n                for (int cost = 1; cost <= 2 * k - 1; cost += 2) {\n                    addEdge(id[a][j], id[b][j + 1], cost * d, 1);\n                    addEdge(id[b][j], id[a][j + 1], cost * d, 1);\n                }\n            }\n        }\n        scanner.close();\n        int sent = 0;\n        while (spfa()) {\n            int add;\n            do {\n                Arrays.fill(used, false);\n                add = augment(sink, INF);\n                sent += add;\n                answer += dist[sink] * add;\n            } while (add != 0);\n        }\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.198864e-06, 0.0, -1.1920928e-07, -9.95348e-05, -0.000104302686, -7.152555e-07, -0.16022502, -0.049618676, -0.0005858612, -1.7881378e-06, -0.007512059, -0.0019458662, -0.0005579822, -0.06469234, -0.018693699, -9.5367386e-07, -0.00020358874, -2.7894584e-05, -7.152555e-07, -1.1920928e-07, -5.483477e-05, -0.00013052566, 0.0, -4.7683704e-07, -4.5656117e-05, 0.0, -7.2717403e-06, -3.1351552e-05, 0.0, -1.0490363e-05, -3.6954812e-06, -4.7683704e-07, -2.3841855e-07, 0.0, -2.920585e-05, -1.1920928e-07, -1.6689287e-06, -0.00015865498, -4.7683704e-07, -1.883489e-05, -7.867782e-06, -2.3841855e-07, -1.1920922e-06, -2.264974e-06, 0.0, -1.1920928e-07, -1.1920928e-07, -0.0005590545, -7.152532e-06, -1.7404405e-05, -0.00014792779, -5.960463e-07, -0.003199817, -6.079655e-06, -7.152555e-07, -9.894322e-06, -0.00012921452, -1.1920928e-07, -2.264974e-06, -6.7949063e-06, 0.0, -4.0531077e-06, -3.576278e-07, -4.2915253e-06, -4.7683704e-07, -3.576278e-07, -0.00090165