              for i in range(1, n - last_known):\n                    f_inv.append(self.mult(f_inv[i - 1], n - i + 1))\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(f_inv[i])\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g %= r\n                g, r = r, g\n                x -= q * y\n                x, y = y, x\n            if g != 1:\n                raise AssertionError()\n            if y != self.modulus() and y != -self.modulus():\n                raise AssertionError()\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n\n    def solve(self, testNumber, in_reader, out_writer):\n        n = in_reader.nextInt()\n        m = in_reader.nextInt()\n\n        self.mod.fInv(n + m)\n\n        phase_size = 1\n        p = 1\n        i = 0\n        while p != 0:\n            p = self.mod.mult(se