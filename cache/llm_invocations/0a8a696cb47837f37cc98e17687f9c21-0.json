 += sign;\n    res2 = aux(n-10*ones_d-1, sign, acc+d+1, res1, already_in);\n    already_in[d+1] -= sign;\n  }\n  return res1 < res2 ? res1 : res2;\n}\n\nint main() {\n  int64_t n;\n  std::cin >> n;\n  std::vector<int> already_in(20, 0);\n  int64_t initial_max = aux2(n);\n  int64_t result = aux(n, 1, 0, initial_max, already_in);\n  std::cout << result << std::endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\ndef nb_digits(n):\n    if n == 0:\n        return 1\n    n = abs(n)\n    digits = 0\n    while n:\n        digits += 1\n        n //= 10\n    return digits\n\ndef ones(n):\n    res = 0\n    for i in range(n):\n        res = 10 * res + 1\n    return res\n\ndef aux2(n):\n    if n == 0:\n        return 0\n    n = abs(n)\n    d = nb_digits(n)\n    return d + aux2(n - ones(d))\n\ndef aux(n, sign, acc, max_val, already_in):\n    if acc >= max_val:\n        return max_val\n    if n == 0:\n        return acc\n    if n < 0:\n        n = abs(n)\n        sign = -sign\n    d = nb_digits(n)\n    ones_d = ones(d)\n    res1 = max_val\n    res2 = max_val\n\n    if 0 <= already_in[d] * sign and -10 < already_in[d] < 10:\n        already_in[d] += sign\n        res1 = aux(n - ones_d, sign, acc + d, max_val, already_in)\n        already_in[d] -= sign\n\n    if 0 <= already_in[d + 1] * sign and -10 < already_in[d + 1] < 10:\n        already_in[d + 1] += sign\n        res2 = aux(n - 10 * ones_d - 1, sign, acc + d + 1, res1, already_in)\n        already_in[d + 1] -= sign\n\n    return res1 if res1 < res2 else res2\n\ndef main():\n    n = int(input())\n    already_in = [0] * 20\n    initial_max = aux2(n)\n    result = aux(n, 1, 0, initial_max, already_in)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015567521040793508, -8.344646857949556e-07, 0.0, -0.523152