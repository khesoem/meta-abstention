1.0L, 0.0L);\n    for (int mask = 1; mask < total; ++mask) {\n        if (!(mask & vbit)) {\n            totalVal.coeff += dp[mask].coeff;\n            totalVal.cnst += dp[mask].cnst;\n        }\n    }\n\n    dbl alpha = (1.0L - totalVal.cnst) / totalVal.coeff;\n\n    Val badVal(0.0L, 0.0L);\n    for (int mask = 0; mask < total; ++mask) {\n        if (!(mask & vbit) && __builtin_popcount(mask) >= k) {\n            badVal.coeff += dp[mask].coeff;\n            badVal.cnst += dp[mask].cnst;\n        }\n    }\n\n    return (double)(1.0L - (alpha * badVal.coeff + badVal.cnst));\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &k);\n    for (int i = 0; i < n; ++i) scanf(\"%lf\", &prob[i]);\n\n    for (int i = 0; i < n; ++i) {\n        if (i) putchar(' ');\n        printf(\"%.12f\", Solve(i));\n    }\n    putchar('\\n');\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXM = 1 << 20;\n    static double[] dpCoeff = new double[MAXM];\n    static double[] dpCnst = new double[MAXM];\n    static int n, k;\n    static double[] prob;\n    static final double EPS = 1e-9;\n\n    static double solve(int victim) {\n        if (prob[victim] < EPS) return 0.0;\n\n        Arrays.fill(dpCoeff, 0.0);\n        Arrays.fill(dpCnst, 0.0);\n        dpCoeff[0] = 1.0;\n        dpCnst[0] = 0.0;\n\n        int total = 1 << n;\n        int vbit = 1 << victim;\n\n        for (int mask = 1; mask < total; ++mask) {\n            if ((mask & vbit) != 0) continue;\n\n            double curCoeff = 0.0, curCnst = 0.0;\n            double same = 0.0;\n\n            for (int i = 0; i < n; ++i) {\n                if (i == victim) continue;\n                if ((mask & (1 << i)) != 0) {\n                    same += prob[i];\n                    int prevMask = mask ^ (1 << i);\n                    curCoeff += dpCoeff[prevMask] * prob[i];\n                    curCnst += dpCnst[prevMask] * prob[i];\n                }\n            }\n\n            dpCoeff[mask] = curCoeff / (1.0 - same);\n            dpCnst[mask] = curCnst / (1.0 - same);\n        }\n\n        double totalCoeff = 1.0, totalCnst = 0.0;\n        for (int mask = 1; mask < total; ++mask) {\n            if ((mask & vbit) == 0) {\n                totalCoeff += dpCoeff[mask];\n                totalCnst += dpCnst[mask];\n            }\n        }\n\n        double alpha = (1.0 - totalCnst) / totalCoeff;\n\n        double badCoeff = 0.0, badCnst = 0.0;\n        for (int mask = 0; mask < total; ++mask) {\n            if ((mask & vbit) == 0 && Integer.bitCount(mask) >= k) {\n                badCoeff += dpCoeff[mask];\n                badCnst += dpCnst[mask];\n            }\n        }\n\n        return 1.0 - (alpha * badCoeff + badCnst);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        k = sc.nextInt();\n        prob = new double[n];\n        for (int i = 0; i < n; ++i) {\n            prob[i] = sc.nextDouble();\n        }\n\n        for (int i = 0; i < n; ++i) {\n            if (i > 0) System.out.print(' ');\n            System.out.printf(\"%.12f\", solve(i));\n        }\n        System.out.println();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.10302022844552994, -1.2397689715726301e-05, 0.0, 0.0, -2.7417760065873154e-05, -7.497983460780233e-05, -3.576278118089249e-07, -1.0371154530730564e-05, -0.12042027711868286, -4.768258077092469e-05, 0.0, -0.0009261847590096295, -0.002477316651493311, -2.8729025871143676e-05, -0.00408434122800827, -9.536738616588991e-07, -0.0019288521725684404, 0.0, -1.0967194612021558e-05, 0.0, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, 0.0, 0.0, -8.105902816168964e-05, -2.3841855067985307e-07, -5.245195097813848e-06, -0.5767855048179626, -0.0008144637104123831