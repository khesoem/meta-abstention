  cnt = 0;\n        pos = new int[SIZE];\n        rev = new int[SIZE];\n    }\n\n    public int gao(int n, int[][] e) {\n        cnt = 0;\n        Arrays.fill(pos, 255);\n        Arrays.fill(rev, 255);\n        for (int i = 0; i < n; i++) {\n            int[] v = new int[SIZE];\n            if (match(i, e)) cnt++;\n        }\n        return cnt;\n    }\n\n    private boolean match(int x, int[][] e) {\n        int[] v = new int[SIZE];\n        for (int i = 0; i < e[x].length; i++) {\n            int y = e[x][i];\n            if (v[y] == 0) v[y] = 1; else continue;\n            if (rev[y] < 0 || match(rev[y], e)) {\n                pos[x] = y;\n                rev[y] = x;\n                return true;\n            }\n        }\n        return false;\n    }\n}\n\npublic class Main {\n    static int a[][], b[][], f[][], m, t;\n    static int[][] e, c;\n    static Scanner sc = new Scanner(System.in);\n\n    public static void floodfill(int sr, int sc) {\n        Queue<int[]> q = new LinkedList<>();\n        q.add(new int[]{sr, sc});\n        f[sr][sc] = 0;\n        while (!q.isEmpty()) {\n            int[] p = q.poll();\n            int sr1 = p[0], sc1 = p[1];\n            for (int i = 0; i < 4; i++) {\n                int tr = sr1 + 1;\n                int tc = sc1 + 1;\n                if (a[tr][tc] >= 0 && f[tr][tc] < 0) {\n                    f[tr][tc] = f[sr1][sc1] + 1;\n                    q.add(new int[]{tr, tc});\n                }\n            }\n        }\n    }\n\n    public static void setmark(int sr, int sc, int cnt) {\n        int[][] v = new int[12][12];\n        Queue<int[]> q = new LinkedList<>();\n        q.add(new int[]{sr, sc});\n        v[sr][sc] = 0;\n        while (!q.isEmpty()) {\n            int[] p = q.poll();\n            int sr1 = p[0], sc1 = p[1];\n            if (v[sr1][sc1] > Math.min(t, f[sr1][sc1])) continue;\n            for (int j = 0; j < c[sr1][sc1].length; j++)\n                for (int i = 0; i < cnt; i++) e[m + i].add(c[sr1][sc1][j]);\n            if (v[sr1][sc1] == Math.min(t, f[sr1][sc1])) continue;\n            for (int i = 0; i < 4; i++) {\n                int tr = sr1 + 1;\n                int tc = sc1 + 1;\n                if (a[tr][tc] >= 0 && v[tr][tc] < 0) {\n                    v[tr][tc] = v[sr1][sc1] + 1;\n                    q.add(new int[]{tr, tc});\n                }\n            }\n        }\n        m += cnt;\n    }\n\n    public static void main(String[] args) {\n        int n, sr, sc, o = 0, m = 0;\n        t = sc.nextInt();\n        n = sc.nextInt();\n        a = new int[12][12];\n        b = new int[12][12];\n        f = new int[12][12];\n        e = new int[2000][];\n        c = new int[12][12];\n        for (int i = 1; i <= n; i++) {\n            while (sc.next().charAt(0) != '\\n');\n            for (int j = 1; j <= n; j++) {\n                char ch = sc.next().charAt(0);\n                if (ch >= '0' && ch <= '9') a[i][j] = ch - '0';\n                if (ch == 'Z') {\n                    sr = i;\n                    sc = j;\n                }\n            }\n        }\n        floodfill(sr, sc);\n        while (sc.next().charAt(0) != '\\n');\n        for (int i = 1; i <= n; i++) {\n            while (sc.next().charAt(0) != '\\n');\n            for (int j = 1; j <= n; j++) {\n                char ch = sc.next().charAt(0);\n                if (ch >= '0' && ch <= '9') b[i][j] = ch - '0';\n                for (int k = 0; k < b[i][j]; k++) c[i][j].add(o++);\n            }\n        }\n        for (int i = 1; i <= n; i++) for (int j = 1; j <= n; j++) if (f[i][j] < 0) f[i][j] = 1000000000;\n        for (int i = 1; i <= n; i++) for (int j = 1; j <= n; j++) if (a[i][j] > 0) setmark(i, j, a[i][j]);\n        System.out.println(new Hungary().gao(m, e));\n    }\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.18176282942295074, -0.00785879697650671, -0.10183875262737274, -0.017305662855505943, -0.00019582042295951396, -0.6345273852348328, -0.2103