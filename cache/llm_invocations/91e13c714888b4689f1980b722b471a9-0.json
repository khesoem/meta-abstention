{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 10000;\nconst int MAXM = 2000000;\nconst int INF = 0x3f3f3f3f;\n\nint n, m, k, c, d;\n\nstruct Edge {\n    int to, next, cap, flow, cost;\n} edge[MAXM];\nint head[MAXN], tol;\nint pre[MAXN], dis[MAXN];\nbool vis[MAXN];\nint N;\n\nvoid init(int n) {\n    N = n;\n    tol = 0;\n    memset(head, -1, sizeof(head));\n}\n\nvoid addedge(int u, int v, int cap, int cost) {\n    edge[tol].to = v;\n    edge[tol].cap = cap;\n    edge[tol].cost = cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[u];\n    head[u] = tol++;\n    edge[tol].to = u;\n    edge[tol].cap = 0;\n    edge[tol].cost = -cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[v];\n    head[v] = tol++;\n}\n\nbool spfa(int s, int t) {\n    queue<int> q;\n    for (int i = 0; i < N; ++i) {\n        dis[i] = INF;\n        vis[i] = false;\n        pre[i] = -1;\n    }\n    dis[s] = 0;\n    vis[s] = true;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        vis[u] = false;\n        for (int i = head[u]; i != -1; i = edge[i].next) {\n            int v = edge[i].to;\n            if (edge[i].cap > edge[i].flow && dis[v] > dis[u] + edge[i].cost) {\n                dis[v] = dis[u] + edge[i].cost;\n                pre[v] = i;\n                if (!vis[v]) {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return pre[t] != -1;\n}\n\nint minCostMaxflow(int s, int t, int& cost) {\n    int flow = 0;\n    cost = 0;\n    while (spfa(s, t)) {\n        int Min = INF;\n        for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n            Min = min(Min, edge[i].cap - edge[i].flow);\n        }\n        for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n            edge[i].flow += Min;\n            edge[i ^ 1].flow -= Min;\n            cost += edge[i].cost * Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\n\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    init(MAXN);\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        addedge(0, x, 1, 0);\n    }\n    for (int i = 0; i < 100; ++i) {\n        for (int j = 0; j < k; ++j) {\n            addedge(1 + i * n, 9999, 1, i * c);\n        }\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        for (int j = 1; j < 100; ++j) {\n            for (int gg = 1; gg <= k; ++gg) {\n                addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            addedge(i + (j - 1) * n, i + j * n, k, 0);\n        }\n    }\n    int cost;\n    minCostMaxflow(0, 9999, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\ndef init(n):\n    global N, head, tol, edges\n    N = n\n    head = [-1] * (N + 1)  # ensure enough size for all node indices\n    edges = []\n    tol = 0\n\ndef addedge(u, v, cap, cost):\n    global tol\n    # forward edge\n    edges.append([v, head[u], cap, 0, cost])\n    head[u] = tol\n    tol += 1\n    # reverse edge\n    edges.append([u, head[v], 0, 0, -cost])\n    head[v] = tol\n    tol += 1\n\ndef spfa(s, t):\n    dis = [INF] * N\n    vis = [False] * N\n    pre = [-1] * N\n    dis[s] = 0\n    vis[s] = True\n    q = deque([s])\n    while q:\n        u = q.popleft()\n        vis[u] = False\n        i = head[u]\n        while i != -1:\n            v = edges[i][0]\n            cap = edges[i][2]\n            flow = edges[i][3]\n            cost = edges[i][4]\n            if cap > flow and dis[v] > dis[u] + cost:\n                dis[v] = dis[u] + cost\n                pre[v] = i\n                if not vis[v]:\n                    vis[v] = True\n                    q.append(v)\n            i = edges[i][1]\n    return pre[t] != -1\n\ndef minCostMaxflow(s, t):\n    flow = 0\n    cost = 0\n    while spfa(s, t):\n        Min = INF\n        i = pre[t]\n        while i != -1:\n            cap = edges[i][2]\n            flow_i = edges[i][3]\n            Min = min(Min, cap - flow_i)\n            i = pre[edges[i ^ 1][0]]\n        i = pre[t]\n        while i != -1:\n            edges[i][3] += Min\n            edges[i ^ 1][3] -= Min\n            cost += edges[i][4] * Min\n            i = pre[edges[i ^ 1][0]]\n        flow += Min\n    return flow, cost\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    # compute maximum node index needed\n    max_node = max(9999, 1 + 99 * n)\n    init(max_node)\n    for _ in range(k):\n        x = next(it)\n        addedge(0, x, 1, 0)\n    for i in range(100):\n        for j in range(k):\n            addedge(1 + i * n, 9999, 1, i * c)\n    for _ in range(m):\n        u = next(it)\n        v = next(it)\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d)\n                addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d)\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            addedge(i + (j - 1) * n, i + j * n, k, 0)\n    flow, cost = minCostMaxflow(0, 9999)\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0005793085438199341, -2.3841855067985307e-07, -1.4305104514278355e-06, -0.00024732868769206107, -0.008802657015621662, -8.344646857949556e-07, -2.8729025871143676e-05, -0.0009167758980765939, -4.768370445162873e-07, 0.0, -3.2186455882765586e-06, -0.002005472080782056, -0.17089833319187164, -5.960462772236497e-07, -0.0005809764843434095, -0.00863284058868885, -0.005233872216194868, -0.004634116776287556, -0.009349373169243336, -0.34066247940063477, -0.009779518470168114, -0.3385859429836273, -0.049228373914957047, -7.152555099310121e-07, -0.000545472139492631, -0.014563803561031818, -1.4305104514278355e-06, -0.16237638890743256, -5.8412379075889476e-06, -0.31484466791152954, -0.008615703321993351, -0.0019528857665136456, -0.001510551548562944, 0.0, -0.00013934595335740596, -1.1920928244535389e-07, -0.00043132537393830717, -0.007260248530656099, -4.768370445162873e-07, -0.4778381586074829, -2.145764938177308e-06, -3.266281055402942e-05, -1.1920928244535389e-07, -3.790783375734463e-05, -2.264974000354414e-06, -0.1316043734550476, -0.6705336570739746, -0.019043121486902237, -1.9073468138230965e-06, -0.013131331652402878, -0.4740781784057617, -0.01869065687060356, -2.50339189733495e-06, -1.612251877784729, -0.676629900932312, -0.36226609349250793, -0.673404335975647, -0.7839294672012329, -0.40703490376472473, -0.