{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <algorithm>\n#include <cstring>\n#include <cstdio>\n#include <string>\n#include <queue>\n#include <cmath>\n#include <set>\n#include <map>\n#include <bitset>\nusing namespace std;\ntypedef long long LL;\ntypedef double db;\nconst int oo=2139063143;\nconst int N=5010000;\nconst int P=1000000007;\nconst db eps=1e-7;\n#define pritnf printf\n\ntemplate <typename T>\ninline void sc (T &x)\n{\n    x=0; static int p; p=1; static char c; c=getchar();\n    while (!isdigit(c)) { if (c=='-') p=-1; c=getchar(); }\n    while ( isdigit(c)) { x=(x<<1)+(x<<3)+(c-48); c=getchar(); }\n    x*=p;\n}\ntemplate <typename T>\ninline void print (T x)\n{\n    if (x< 0) putchar('-'),x=-x;\n    if (x>=10) print(x/10);\n    putchar(x%10+'0');\n}\ntemplate <typename T>\ninline void pr (T x) { print(x),putchar('\\n'); }\n\nstruct EDGE { int v,w,c,nx; }lb[N<<1]; int tot=1,top[N];\nvoid add (int u,int v,int w,int c)\n{\n\tlb[++tot]=(EDGE){v,w, c,top[u]},top[u]=tot;\n\tlb[++tot]=(EDGE){u,0,-c,top[v]},top[v]=tot;\n}\n\nint s,t;\nint dist[N],flow[N],pre[N],las[N],pot[N];\n\nbool dijkstra()\n{\n    priority_queue<pair<int,int>> pq;\n    for(int i=1; i<=t; i++) dist[i]=1e9, flow[i]=pre[i]=las[i]=0;\n    dist[s]=0; flow[s]=1e9;\n    pq.push({0,s});\n    while(!pq.empty())\n    {\n        int d = -pq.top().first, u = pq.top().second; pq.pop();\n        if(d != dist[u]) continue;\n        for(int kb=top[u]; kb; kb=lb[kb].nx)\n        {\n            int v=lb[kb].v, w=lb[kb].w, c=lb[kb].c;\n            int nd = d + c + pot[u] - pot[v];\n            if(w && dist[v] > nd)\n            {\n                dist[v]=nd;\n                flow[v]=min(flow[u], w);\n                pre[v]=u;\n                las[v]=kb;\n                pq.push({-nd, v});\n            }\n        }\n    }\n    if(dist[t]==1e9) return false;\n    for(int i=1; i<=t; i++) if(dist[i]<1e9) pot[i] += dist[i];\n    return true;\n}\n\nint maflow,micost;\nvoid mcmf ()\n{\n\twhile (dijkstra())\n\t{\n\t\tint u=t,fl=flow[t]; maflow+=fl,micost+=fl*pot[t];\n\t\twhile (u!=s)\n\t\t{\n\t\t\tlb[las[u]].w-=fl,lb[las[u]^1].w+=fl;\n\t\t\tu=pre[u];\n\t\t}\n\t}\n}\n\nint n,m,k,c,d;\nint main ()\n{\n    // freopen (\".in\",\"r\",stdin);\n    // freopen (\".out\",\"w\",stdout);\n\tsc(n),sc(m),sc(k),sc(c),sc(d);\n\tconst int B=max (n,k);\n\ts=n*(B*2+1)+1,t=s+1;\n\tfor (int i=1; i<=k; i++)\n\t{\n\t\tint x; sc(x);\n\t\tadd (s,x,1,0);\n\t}\n\tadd (n*(B*2)+1,t,1e9,0);\n\tfor (int o=0; o< B*2; o++)\n\t{\n\t\tadd (o*n+1,(o+1)*n+1,1e9,0);\n\t\tfor (int i=2; i<=n; i++)\n\t\t\tadd (o*n+i,(o+1)*n+i,1e9,c);\n\t}\n\twhile (m--)\n\t{\n\t\tint x,y; sc(x),sc(y);\n\t\tfor (int o=0; o< B*2; o++)\n\t\t{\n\t\t\tfor (int i=1; i<=k; i++)\n\t\t\t\tadd (o*n+x,(o+1)*n+y,1,d*(2*i-1)+c),add (o*n+y,(o+1)*n+x,1,d*(2*i-1)+c);\n\t\t}\n\t}\n\tmcmf ();\n\tpr(micost);\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_edge(graph, u, v, cap, cost):\n    forward = Edge(v, len(graph[v]), cap, cost)\n    backward = Edge(u, len(graph[u]), 0, -cost)\n    graph[u].append(forward)\n    graph[v].append(backward)\n\ndef dijkstra(graph, s, t, pot):\n    n = len(graph)\n    dist = [INF] * n\n    flow = [0] * n\n    pre = [-1] * n\n    las = [-1] * n\n    dist[s] = 0\n    flow[s] = INF\n    pq = [(0, s)]\n    while pq:\n        d, u = heapq.heappop(pq)\n        if d != dist[u]:\n            continue\n        for ei, e in enumerate(graph[u]):\n            if e.cap > 0:\n                v = e.to\n                nd = d + e.cost + pot[u] - pot[v]\n                if nd < dist[v]:\n                    dist[v] = nd\n                    flow[v] = min(flow[u], e.cap)\n                    pre[v] = u\n                    las[v] = ei\n                    heapq.heappush(pq, (nd, v))\n    if dist[t] == INF:\n        return False\n    for i in range(n):\n        if dist[i] < INF:\n            pot[i] += dist[i]\n    return True\n\ndef mcmf(graph, s, t):\n    n = len(graph)\n    pot = [0] * n\n    maflow = 0\n    micost = 0\n    while dijkstra(graph, s, t, pot):\n        fl = flow[t]\n        maflow += fl\n        micost += fl * pot[t]\n        u = t\n        while u != s:\n            e = graph[pre[u]][las[u]]\n            e.cap -= fl\n            graph[e.to][e.rev].cap += fl\n            u = pre[u]\n    return maflow, micost\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    B = max(n, k)\n    # node indices: 1..n*(B*2+1) for layers, then s, t\n    total_layers = B * 2 + 1\n    total_nodes = n * total_layers\n    s = total_nodes + 1\n    t = total_nodes + 2\n    graph = [[] for _ in range(t + 1)]  # 1-indexed, index 0 unused\n    # source to initial positions\n    for _ in range(k):\n        x = next(it)\n        add_edge(graph, s, x, 1, 0)\n    # last layer to sink\n    add_edge(graph, n * (B * 2) + 1, t, INF, 0)\n    # edges within layers (stay in place)\n    for o in range(B * 2):\n        # node 1: cost 0\n        add_edge(graph, o * n + 1, (o + 1) * n + 1, INF, 0)\n        # nodes 2..n: cost c\n        for i in range(2, n + 1):\n            add_edge(graph, o * n + i, (o + 1) * n + i, INF, c)\n    # edges for each given road\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for o in range(B * 2):\n            for i in range(1, k + 1):\n                cost = d * (2 * i - 1) + c\n                add_edge(graph, o * n + x, (o + 1) * n + y, 1, cost)\n                add_edge(graph, o * n + y, (o + 1) * n + x, 1, cost)\n    # run MCMF\n    maflow, micost = mcmf(graph, s, t)\n    sys.stdout.write(str(micost) + '\\n')\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.970903682988137e-05, 0.0, 0.0, -0.0009288049186579883, -0.0019375376868993044, -4.768360213347478e-06, -0.008615821599960327, -1.9073468138230965e-06, -1.3828182090946939e-05, -0.04861503466963768, -0.3528461158275604, -0.00010442188795423135, -7.152555099310121e-07, -1.0251946150674485e-05, -0.16022419929504395, -0.00030393750057555735, -0.0017287085065618157, -0.6804193258285522, -4.410734163684538e-06, -3.576278118089249e-07, -3.576278118089249e-07, -2.0265558760002023e-06, 0.0, 0.0, -8.344646857949556e-07, -4.768360213347478e-06, -0.0005895545473322272, -7.986990567587782e-06, -3.540453326422721e-05, 0.0, -0.0011703077470883727, -7.152555099310121e-07, 0.0, -8.344646857949556e-07, 0.0, 0.0, -6.198863957251888e-06, -5.602820692729438e-06, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.00012563870404846966, -7.86778218753170