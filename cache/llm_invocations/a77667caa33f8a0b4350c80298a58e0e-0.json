= mask) continue;\n        \n        vector<int> bits;\n        for (int b = 0; b < 18; ++b) {\n            if (mask & (1 << b)) {\n                bits.push_back(b);\n            }\n        }\n        \n        // Iterate over all non-empty subsets\n        int total_subsets = 1 << bits.size();\n        for (int sub = 1; sub < total_subsets; ++sub) {\n            int l = 0;\n            for (int j = 0; j < (int)bits.size(); ++j) {\n                if (sub & (1 << j)) {\n                    l ^= (1 << bits[j]);\n                }\n            }\n            \n            lint coef = inv_fact[l];\n            for (int t = 1; t <= 16; ++t) {\n                dp[mask][t] = (dp[mask][t] + coef * dp[mask ^ l][t-1]) % p;\n            }\n        }\n    }\n\n    lint ans = 0;\n    for (int t = 1; t <= min(16, k); ++t) {\n        lint term = fact[n] * dp[n][t] % p;\n        term = term * fact[k] % p;\n        term = term * inv_fact[k - t] % p;\n        ans = (ans + term) % p;\n    }\n    ans = (mod_exp(k, n, p) - ans + p) % p;\n    cout << ans << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_exp(base, exp, mod):\n    res = 1 % mod\n    base %= mod\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    \n    # Handle odd case directly\n    if n & 1:\n        print(mod_exp(k, n, p))\n        return\n    \n    # Precompute factorials and inverse factorials modulo p\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % p\n    \n    inv_fact = [1] * (n + 1)\n    inv_fact[n] = mod_exp(fact[n], p - 2, p)\n    for i in range(n, 0, -1):\n        inv_fact[i-1] = inv_fact[i] * i % p\n    \n    # DP table: dp[mask][t] represents count of ways to partition mask into exactly t non-empty subsets\n    # Since n <= 18 in the original code (mask up to 1<<18), we use 1<<18 as max mask size\n    max_mask = 1 << 18\n    dp = [[0] * 17 for _ in range(max_mask)]\n    dp[0][0] = 1\n    \n    # Iterate over masks that are subsets of n\n    for mask in range(1, n + 1):\n        if (mask & n) != mask:\n            continue\n        \n        # Extract bits set in mask\n        bits = []\n        for b in range(18):\n            if mask & (1 << b):\n                bits.append(b)\n        \n        # Iterate over all non-empty subsets of bits\n        total_subsets = 1 << len(bits)\n        for sub in range(1, total_subsets):\n            l = 0\n            for j in range(len(bits)):\n                if sub & (1 << j):\n                    l ^= (1 << bits[j])\n            \n            coef = inv_fact[l]\n            for t in range(1, 17):\n                dp[mask][t] = (dp[mask][t] + coef * dp[mask ^ l][t-1]) % p\n    \n    ans = 0\n    for t in range(1, min(16, k) + 1):\n        term = fact[n] * dp[n][t] % p\n        term = term * fact[k] % p\n        term = term * inv_fact[k - t] % p\n        ans = (ans + term) % p\n    \n    ans = (mod_exp(k, n, p) - ans + p) % p\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00029595286468975246, -9.536738616588991e-07, -1.1920928244535389e-07, -0.5333186984062195, -0.00014768941036891192, -0.012516752816736698, -0.00013207517622504383, -2.002696055569686e-05, -2.264974000354414e-06, -3.3378546504536644e-06, -1.3112935448589269e-05, -2.2172682292875834e-05, 0.0, -2.9802276912960224e-06, -2.145764938177308e-06, -2.3841855067985307e-07, -1.0728830375228426e-06, 0.0, -5.960462772236497e-07, 0.0, 0.0, -1.4305104514278355e-06, -2.3841855067985307e-07, 0.0, -8.344646857949556e-07, -0.00014840454969089478, -1