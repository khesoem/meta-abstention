ow++;\n            E.get(idx ^ 1).flow--;\n            cur = pre[cur];\n        }\n        costSum += dis[dst];\n    }\n\n    static void connect(int u, int v, int cap, int cost) {\n        G[u].add(E.size());\n        E.add(new Edge(u, v, cap, 0, cost));\n        G[v].add(E.size());\n        E.add(new Edge(v, u, 0, 0, -cost));\n    }\n\n    static int n, m, k, c, d;\n    static final int T_LAYERS = 101;\n\n    static void setup(Scanner sc) {\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt(); --x;\n            connect(src, x, 1, 0);\n        }\n        \n        for (int t = 0; t < T_LAYERS; ++t) {\n            connect(t * n, dst, k, t * c);\n        }\n        \n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int t = 0; t < T_LAYERS - 1; ++t) {\n                for (int j = 0; j < k; ++j) {\n                    connect(u + t * n, v + (t + 1) * n, 1, d * (2 * j + 1));\n                }\n            }\n            for (int t = 0; t < T_LAYERS - 1; ++t) {\n                for (int j = 0; j < k; ++j) {\n                    connect(v + t * n, u + (t + 1) * n, 1, d * (2 * j + 1));\n                }\n            }\n        }\n    }\n\n    static void compute() {\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            for (int i = 0; i < n; ++i) {\n                connect(i + t * n, i + (t + 1) * n, k, 0);\n            }\n        }\n        \n        for (int i = 0; i < k; ++i) {\n            updateFlow();\n        }\n        \n        System.out.println(costSum);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        for (int i = 0; i < 1000007; ++i) {\n            G[i] = new ArrayList<>();\n        }\n        \n        setup(sc);\n        compute();