            pre[v] = u;\n                preEdge[v] = idx;\n                if (!vis[v]) {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n}\n\nvoid updateFlow() {\n    shortestPath();\n    if (dis[dst] >= INF) return;\n    \n    int cur = dst;\n    while (cur != src) {\n        int idx = preEdge[cur];\n        E[idx].flow++;\n        E[idx ^ 1].flow--;\n        cur = pre[cur];\n    }\n    costSum += dis[dst];\n}\n\nvoid connect(int u, int v, int cap, int cost) {\n    G[u].push_back(E.size());\n    E.emplace_back(u, v, cap, 0, cost);\n    G[v].push_back(E.size());\n    E.emplace_back(v, u, 0, 0, -cost);\n}\n\nint n, m, k, c, d;\nconst int T_LAYERS = 101;\n\nvoid setup() {\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    \n    for (int i = 0; i < k; ++i) {\n        int x; scanf(\"%d\", &x); --x;\n        connect(src, x, 1, 0);\n    }\n    \n    for (int t = 0; t < T_LAYERS; ++t) {\n        connect(t * n, dst, k, t * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int u, v; scanf(\"%d %d\", &u, &v); --u, --v;\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                connect(u + t * n, v + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                connect(v + t * n, u + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n    }\n}\n\nvoid compute() {\n    for (int t = 0; t < T_LAYERS - 1; ++t) {\n        for (int i = 0; i < n; ++i) {\n            connect(i + t * n, i + (t + 1) * n, k, 0);\n        }\n    }\n    \n    for (int i = 0; i < k; ++i) {\n        updateFlow();\n    }\n    \n    printf(\"%lld\\n\", costSum);\n}\n\nint main() {\n    setup();\n    compute();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples":