elf.curChar >= self.snumChars:\n            self.curChar = 0\n            try:\n                self.snumChars = self.stream.readinto(self.buf)\n            except:\n                raise EOFError(\"Input mismatch\")\n            if self.snumChars <= 0:\n                return -1\n        res = self.buf[self.curChar]\n        self.curChar += 1\n        return res\n\n    def nextInt(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.isSpaceChar(c):\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n        return res * sgn\n\n    def nextLong(self):\n        c = self.read()\n        while self.isSpaceChar(c)):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.isSpaceChar(c):\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n        return res * sgn\n\n    def nextIntArray(self, n):\n        a = [0] * n\n        for i in range(n):\n            a[i] = self.nextInt()\n        return a\n\n    def readString(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        res = []\n        while not self.isSpaceChar(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def nextLine(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        res = []\n        while not self.isEndOfLine(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def isSpaceChar(self, c):\n        return c == ord(' ') or c == ord('\\n') or c == ord('\\r') or c == ord('\\t') or c == -1\n\n    def isEndOfLine(self, c):\n        return c == ord('\\n') or c == ord('\\r') or c == -1\n\n\ndef main():\n    in_reader = InputReader(sys.stdin.buffer)\n    n = in_reader.nextInt()\n    b = in_reader.nextInt()\n    a = in_reader.nextIntArray(n)\n    \n    odd = [0] * (n + 1)\n    even = [0] * (n + 1)\n    odd[0] = 0\n    even[0] = 0\n    \n    for i in range(1, n + 1):\n        if a[i - 1] % 2 == 1:\n            odd[i] = odd[i - 1] + 1\n            even[i] = even[i - 1]\n        else:\n            odd[i] = odd[i - 1]\n            even[i] = even[i - 1] + 1\n    \n    prev = 0\n    cost = []\n    \n    for i in range(1, n):\n        oc = odd[i] - odd[prev]\n        ec = even[i] - even[prev]\n        if oc == ec:\n            heapq.heappush(cost, abs(a[i] - a[i - 1]))\n            prev = i\n    \n    total_sum = 0\n    count = 0\n    \n    while cost and total_sum <= b:\n        total_sum += cost[0]\n        heapq.heappop(cost)\n        count += 1\n    \n    if count == 0:\n        print(\"0\")\n    else:\n        if not cost and total_sum <= b:\n            print(count)\n        else:\n            print(count - 1)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.2569914259947836e-05, -1.4305104514278355e-06, -2.3841855067985307e-07, -0.00010215714428341016, -0.006222161930054426, -0.0031798535492271185, -0.03365752846002579, -0.2748728096485138, -0.014374633319675922, -0.0019317077239975333, -3.6000557884108275e-05, -1.0728830375228426e-06, -1.1920922133867862e-06, -3.576278118089249e-07, -5.960462772236497e-07, -3.2186455882765586e-06, -1.4305104514278355e-06, -3.576278118089249e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -5.447716102935374e-05, -9.7508447652217e-05, -7.152555099310121e-07, -8.344646857949556e-07, -4.291525328881107e-06, 0.0, -2.0265373677830212e-05, -0.0005787128466181457, -5.960462772236497e-07, -2.861018856492592e-06, -0.0006448334897868335, -1.0728830375228426e-06, -0.010590896010398865, -0.0011711412807926536, 0.0, -1.19209221