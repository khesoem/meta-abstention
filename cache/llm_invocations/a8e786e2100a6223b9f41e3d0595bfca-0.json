< i)) res[i] += dp[mask];\n        }\n    }\n}\n\nint main() {\n    int total, k;\n    scanf(\"%d %d\", &total, &k);\n\n    int n = 0;\n    for (int i = 0; i < total; ++i) {\n        scanf(\"%lf\", &inP[i]);\n        if (inP[i] > EPS) {\n            p[n] = inP[i];\n            id[i] = n++;\n        } else {\n            id[i] = -1;\n        }\n    }\n\n    k = min(k, n);\n\n    computeSum(n);\n    computeDp(n);\n    gather(n, k);\n\n    for (int i = 0; i < total; ++i) {\n        if (id[i] == -1) printf(\"0 \");\n        else printf(\"%.10lf \", res[id[i]]);\n    }\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static final double EPS = 1e-9;\n    static final int MAXN = 20;\n    \n    static double[] inP = new double[MAXN];\n    static double[] p = new double[MAXN];\n    static double[] dp = new double[1 << MAXN];\n    static double[] sm = new double[1 << MAXN];\n    static double[] res = new double[MAXN];\n    static int[] id = new int[MAXN];\n    \n    static void computeSum(int n) {\n        sm[0] = 0.0;\n        for (int mask = 1; mask < (1 << n); ++mask) {\n            for (int j = 0; j < n; ++j) {\n                if ((mask & (1 << j)) != 0) {\n                    sm[mask] = sm[mask ^ (1 << j)] + p[j];\n                    break;\n                }\n            }\n        }\n    }\n    \n    static void computeDp(int n) {\n        dp[0] = 1.0;\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            for (int i = 0; i < n; ++i) {\n                if ((mask & (1 << i)) != 0) continue;\n                assert(p[i] > EPS);\n                dp[mask | (1 << i)] += dp[mask] * p[i] / (1.0 - sm[mask]);\n            }\n        }\n    }\n    \n    static void gather(int n, int k) {\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int cnt = 0;\n      