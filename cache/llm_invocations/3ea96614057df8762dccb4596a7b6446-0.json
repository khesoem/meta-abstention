{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Cand {\n    long long num, den;\n    __int128 err;\n};\n\nstatic inline __int128 Abs128(__int128 v) {\n    return v < 0 ? -v : v;\n}\n\nint main() {\n    long long x, y, n;\n    scanf(\"%lld%lld%lld\", &x, &y, &n);\n\n    if (y <= n) {\n        long long g = __gcd(x, y);\n        printf(\"%lld/%lld\", x / g, y / g);\n        return 0;\n    }\n\n    vector<Cand> candidates;\n    if (n > 0) candidates.reserve((size_t)n);\n\n    for (long long i = 1; i <= n; ++i) {\n        long long j = (long long)((__int128)i * x / y);\n\n        __int128 d1 = Abs128((__int128)i * x - (__int128)j * y);\n        __int128 d2 = Abs128((__int128)i * x - (__int128)(j + 1) * y);\n        if (d1 > d2) ++j;\n\n        __int128 err = Abs128((__int128)i * x - (__int128)j * y);\n        candidates.push_back({j, i, err});\n    }\n\n    if (candidates.empty()) {\n        printf(\"-1/0\");\n        return 0;\n    }\n\n    auto best = min_element(candidates.begin(), candidates.end(),\n        [](const Cand& a, const Cand& b) {\n            __int128 lhs = a.err * b.den;\n            __int128 rhs = b.err * a.den;\n            if (lhs != rhs) return lhs < rhs;\n            return a.den < b.den;\n        });\n\n    printf(\"%lld/%lld\", best->num, best->den);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, n = map(int, data[:3])\n\n    if y <= n:\n        g = math.gcd(x, y)\n        print(f\"{x // g}/{y // g}\")\n        return\n\n    candidates = []\n    for i in range(1, n + 1):\n        j = (i * x) // y\n        d1 = abs(i * x - j * y)\n        d2 = abs(i * x - (j + 1) * y)\n        if d1 > d2:\n            j += 1\n        err = abs(i * x - j * y)\n        candidates.append((j, i, err))\n\n    if not candidates:\n        print(\"-1/0\")\n        return\n\n    # Find best candidate using custom comparator\n    best = candidates[0]\n    for cand in candidates[1:]:\n        # Compare best and cand\n        lhs = best[2] * cand[1]\n        rhs = cand[2] * best[1]\n        if lhs != rhs:\n            if lhs > rhs:\n                best = cand\n        else:\n            if best[1] > cand[1]:\n                best = cand\n\n    print(f\"{best[0]}/{best[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [0.0, 0.0, -0.00016068121476564556, -0.0004188137245364487, -0.00015841660206206143, -0.029753077775239944, -0.0011703077470883727, -1.1920928244535389e-07, -0.31326809525489807, -0.003949699457734823, -0.06427299976348877, -0.018150780349969864, -8.344646857949556e-07, -4.1960789531003684e-05, 0.0, -0.0007108307327143848, 0.0, -6.4490144723095e-05, -4.768360213347478e-06, -0.004078404977917671, -3.540453326422721e-05, -1.1920928244535389e-07, -1.4305104514278355e-06, 0.0, -1.1920928244535389e-07, -0