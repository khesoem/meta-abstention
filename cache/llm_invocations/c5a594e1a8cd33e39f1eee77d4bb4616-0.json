        ch = sys.stdin.read(1)\n    return -xi if f else xi\n\ndef pi(k, ch=0):\n    if k < 0:\n        k = -k\n        sys.stdout.write('-')\n    if k >= 10:\n        pi(k // 10)\n    sys.stdout.write(chr(k % 10 + 48))\n    if ch:\n        sys.stdout.write(chr(ch))\n\ndef fpow(a, b, c=1):\n    P = globals()['P']\n    while b:\n        if b & 1:\n            c = c * a % P\n        a = a * a % P\n        b >>= 1\n    return c\n\ndef init(n):\n    fac = globals()['fac']\n    ifac = globals()['ifac']\n    inv = globals()['inv']\n    P = globals()['P']\n    fac[0] = 1\n    for i in range(1, n + 1):\n        fac[i] = fac[i - 1] * i % P\n    ifac[n] = fpow(fac[n], P - 2)\n    for i in range(n - 1, -1, -1):\n        ifac[i] = ifac[i + 1] * (i + 1) % P\n    inv[1] = 1\n    for i in range(2, n + 1):\n        inv[i] = (P - P // i) * inv[P % i] % P\n\ndef add(x, y):\n    P = globals()['P']\n    x[0] += y\n    if x[0] >= P:\n        x[0] -= P\n\ndef sub(x, y):\n    P = globals()['P']\n    x[0] -= y\n    x[0] -= (x[0] >> 31) * P\n\ndef sub_val(x):\n    P = globals()['P']\n    return x - (x >> 31) * P\n\ndef fpow_arr(f, n, k):\n    P = globals()['P']\n    t = f[:]\n    g = [0] * n\n    f[0] = 1 - f[0]\n    g[0] = 0\n    inv = globals()['inv']\n    for i in range(1, n):\n        f[i] = g[i] = 0\n        for j in range(1, i):\n            f[i] = (f[i] + f[i - j] * g[j]) % P\n            g[i] = (g[i] + t[i - j] * g[j]) % P\n        f[i] = sub_val(f[i] - g[i])\n        f[i] = (t[i] + f[i] * inv[i]) % P * k % P\n        g[i] = (t[i] - g[i] * inv[i]) % P * i % P\n\ndef FMT(f, n):\n    P = globals()['P']\n    l = 1\n    while l < n:\n        for i in range(0, n, l << 1):\n            for j in range(l):\n                add([f[i + j + l]], f[i + j])\n        l <<= 1\n\ndef IFMT(f, n):\n    P = globals()['P']\n    l = 1\n    while l < n:\n        for i in range(0, n, l << 1):\n            for j in range(l):\n                sub([f[i + j + l]], f[i + j])\n        l <<= 1\n\ndef popcount(x):\n    return bin(x).count('1')\n\ndef main():\n    global P, fac, ifac, inv\n    n = geti()\n    k = geti()\n    P = geti()\n    \n    ans = fpow(k, n)\n    \n    if n & 1 == 0:\n        m = int(math.log2(n)) + 1\n        size = 1 << m\n        fac = [0] * (size + 1)\n        ifac = [0] * (size + 1)\n        inv = [0] * (size + 1)\n        init(size)\n        \n        f = [[0] * size for _ in range(20)]\n        for i in range(size):\n            f[popcount(i)][i] = ifac[i]\n        \n        for i in range(m + 1):\n            FMT(f[i], size)\n        \n        F = [0] * 20\n        for i in range(n + 1):\n            for j in range(m + 1):\n                F[j] = f[j][i]\n            fpow_arr(F, m + 1, k)\n            for j in range(m + 1):\n                f[j][i] = F[j]\n        \n        IFMT(f[popcount(n)], size)\n        ans = (P + ans - f[popcount(n)][n] * fac[n] % P) % P\n    \n    pi(ans)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00011491115583339706, -1.0728830375228426e-06, -8.344646857949556e-07, -0.004408165812492371, -0.009861323982477188, -0.07889778912067413, -0.02320374920964241, -0.00036197309964336455, -0.03366974741220474, -0.014778661541640759, -0.14117050170898438, -0.0008909308817237616, -2.264974000354414e-06, -3.4570634852570947e-06, -2.9444261599564925e-05, -4.291525328881107e-06, -0.011128501035273075, -0.00012492353562265635, -0.0019331354415044188, -0.34924429655075073, -0.0004828002711292356, -0.6225822567939758, -0.20503732562065125, -0.08792398124933243, -2.145764938177308e-06, -0.8580249547958374, -2.253030106658116e-05, -2.3841855067985307e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -1.311301275563892e-06, -0.0012981806648895144, -2.3841574147809297e-05, -0.0002549561613705009, -1.6689286894688848e-06, -4.291525328881107e-06, -1.1920928244535389e-07, 0.0, -3.3378546504536644e-06, -7.152555099310121e-07, -0.025744101032614708, -1.3113012755638