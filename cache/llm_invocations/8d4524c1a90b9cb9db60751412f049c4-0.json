urr2 = 0\n    # print(l1, l2)\n    while l1 or l2:\n        try:\n            if 0 == curr1:curr1 = l1.pop()\n            if 0 == curr2:curr2 = l2.pop()\n        except:return ans\n\n        ans += max(0, min(curr1[0], curr2[0]) * match(curr1[1], curr2[1]))\n        # print(curr1, curr2)\n        if curr1[0] < curr2[0]:\n            curr2[0] -= curr1[0]\n            curr1 = 0\n        elif curr1[0] > curr2[0]:\n            curr1[0] -= curr2[0]\n            curr2 = 0\n        else:curr1 = curr2 = 0\n    # print(\"ANS FOR THIS : \", ans)\n    return ans    \n\n\n\n\n\n\n\n\ndef minimum():\n    ans = n\n    l = [[rock1, 1], [sci1, 2], [paper1, 3]]\n    l1 = [list(i) for i in list(permutations(l))]\n    l = [[rock2, 1], [sci2, 2], [paper2, 3]]\n    l2 = [list(i) for i in list(permutations(l))]\n\n\n    ans = float('inf')\n    for i in l1:\n        for j in l2:\n            mylist1 = [temp[:] for temp in i]\n            mylist2 = [temp[:] for temp in j]\n            ans = min(ans, give(mylist1, mylist2))\n\n    \n    return ans\n\n\n\nprint(minimum(), maximum())\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final long MOD = 998244353;\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        int n = Integer.parseInt(br.readLine().trim());\n        String[] line1 = br.readLine().trim().split(\" \");\n        int rock1 = Integer.parseInt(line1[0]);\n        int sci1 = Integer.parseInt(line1[1]);\n        int paper1 = Integer.parseInt(line1[2]);\n        \n        String[] line2 = br.readLine().trim().split(\" \");\n        int rock2 = Integer.parseInt(line2[0]);\n        int sci2 = Integer.parseInt(line2[1]);\n        int paper2 = Integer.parseInt(line2[2]);\n        \n        int maxResult = maximum(rock1, sci1, paper1, rock2, sci2, paper2);\n        int minResult = minimum(rock1, sci1, paper1, rock2, sci2, paper2);\n        \n        System.out.println(minResult + \" \" + maxResult);\n    }\n    \n    public static int maximum(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        int ans = Math.min(rock1, sci2) + Math.min(sci1, paper2) + Math.min(paper1, rock2);\n        return ans;\n    }\n    \n    public static int match(int a, int b) {\n        if (a == b) return 0;\n        else if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n        else return -1;\n    }\n    \n    public static int give(List<int[]> l1, List<int[]> l2) {\n        int ans = 0;\n        int[] curr1 = null;\n        int[] curr2 = null;\n        \n        while (!l1.isEmpty() || !l2.isEmpty()) {\n            try {\n                if (curr1 == null && !l1.isEmpty()) {\n                    curr1 = l1.remove(l1.size() - 1);\n                }\n                if (curr2 == null && !l2.isEmpty()) {\n                    curr2 = l2.remove(l2.size() - 1);\n                }\n            } catch (Exception e) {\n                return ans;\n            }\n            \n            if (curr1 == null || curr2 == null) {\n                return ans;\n            }\n            \n            int common = Math.min(curr1[0], curr2[0]);\n            ans += Math.max(0, common * match(curr1[1], curr2[1]));\n            \n            if (curr1[0] < curr2[0]) {\n                curr2[0] -= curr1[0];\n                curr1 = null;\n            } else if (curr1[0] > curr2[0]) {\n                curr1[0] -= curr2[0];\n                curr2 = null;\n            } else {\n                curr1 = null;\n                curr2 = null;\n            }\n        }\n        \n        return ans;\n    }\n    \n    public static int minimum(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        List<int[]> l = new ArrayList<>();\n        l.add(new int[]{rock1, 1});\n        l.add(new int[]{sci1, 2});\n        l.add(new int[]{paper1, 3});\n        \n        List<List<int[]>> l1 = generatePermutations(l);\n        \n        l = new ArrayList<>();\n        l.add(new int[]{rock2, 1});\n        l.add(new int[]{sci2, 2});\n        l.add(new int[]{paper2, 3});\n        \n        List<List<int[]>> l2 = generatePermutations(l);\n        \n        int ans = Integer.MAX_VALUE;\n        for (List<int[]> perm1 : l1) {\n            for (List<int[]> perm2 : l2) {\n                List<int[]> mylist1 = new ArrayList<>();\n                for (int[] arr : perm1) {\n                    mylist1.add(new int[]{arr[0], arr[1]});\n                }\n                List<int[]> mylist2 = new ArrayList<>();\n                for (int[] arr : perm2) {\n                    mylist2.add(new int[]{arr[0], arr[1]});\n                }\n                ans = Math.min(ans, give(mylist1, mylist2));\n            }\n        }\n        \n        return ans;\n    }\n    \n    public static List<List<int[]>> generatePermutations(List<int[]> list) {\n        List<List<int[]>> result = new ArrayList<>();\n        permute(list, 0, result);\n        return result;\n    }\n    \n    public static void permute(List<int[]> list, int start, List<List<int[]>> result) {\n        if (start == list.size()) {\n            result.add(new ArrayList<>(list));\n            return;\n        }\n        \n        for (int i = start; i < list.size(); i++) {\n            Collections.swap(list, i, start);\n            permute(list, start + 1, result);\n            Collections.swap(list, start, i);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010775939153973013, -6.794906312279636e-06, -2.3841855067985307e-07, -2.9801878554280847e-05, -4.136476854910143e-05, -0.17976078391075134, -0.34846654534339905, -0.0004140473320148885, -2.6702524337451905e-05, -0.0011071987682953477, -0.04309103265404701, -3.