{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = INT_MAX;\nconst int MAXN = 10001;\n\nstruct Edge {\n    int to, rev, cap, cost;\n};\n\nvector<Edge> g[MAXN];\nint nodeCnt;\nint dist[MAXN], prevV[MAXN], prevE[MAXN];\nbool inQueue[MAXN];\n\nint addNodes(int cnt) {\n    while (cnt--) g[nodeCnt++].clear();\n    return nodeCnt - 1;\n}\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    g[u].push_back({v, (int)g[v].size(), cap, cost});\n    g[v].push_back({u, (int)g[u].size() - 1, 0, -cost});\n}\n\nbool spfa(int s, int t) {\n    fill(dist, dist + nodeCnt, INF);\n    fill(inQueue, inQueue + nodeCnt, false);\n\n    queue<int> q;\n    dist[s] = 0;\n    q.push(s);\n    inQueue[s] = true;\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inQueue[u] = false;\n\n        for (int i = 0; i < (int)g[u].size(); ++i) {\n            Edge &e = g[u][i];\n            int v = e.to;\n\n            if (e.cap > 0 && dist[v] > dist[u] + e.cost) {\n                dist[v] = dist[u] + e.cost;\n                prevV[v] = u;\n                prevE[v] = i;\n\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n\n    return dist[t] != INF;\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n\n    nodeCnt = 0;\n    int L = max(n, k) * 2;\n\n    addNodes(L * n);\n    int s = addNodes(1);\n    int t = addNodes(1);\n\n    for (int j = 0; j < k; ++j) {\n        int a;\n        scanf(\"%d\", &a);\n        --a;\n        addEdge(s, a, 1, 0);\n    }\n\n    for (int z = 0; z < m; ++z) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        --u;\n        --v;\n\n        for (int i = 0; i + 1 < L; ++i) {\n            int u1 = u + i * n;\n            int v1 = v + (i + 1) * n;\n            int u2 = u + (i + 1) * n;\n            int v2 = v + i * n;\n\n            for (int j = 0; j < k; ++j) {\n                int w = c + d * (2 * j + 1);\n                addEdge(u1, v1, 1, w);\n                addEdge(v2, u2, 1, w);\n            }\n        }\n    }\n\n    for (int i = 0; i + 1 < L; ++i) {\n        for (int j = 0; j < n; ++j) {\n            int u = j + i * n;\n            int v = j + (i + 1) * n;\n            addEdge(u, v, INF, c);\n        }\n    }\n\n    for (int i = 0; i < L; ++i)\n        addEdge(i * n, t, INF, 0);\n\n    int flow = 0, cost = 0;\n\n    while (flow < k) {\n        if (!spfa(s, t)) break;\n\n        int add = INF;\n        for (int v = t; v != s; v = prevV[v])\n            add = min(add, g[prevV[v]][prevE[v]].cap);\n\n        for (int v = t; v != s; v = prevV[v]) {\n            Edge &e = g[prevV[v]][prevE[v]];\n            e.cap -= add;\n            g[v][e.rev].cap += add;\n        }\n\n        flow += add;\n        cost += add * dist[t];\n    }\n\n    printf(\"%d\\n\", cost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**15\n\ndef solve() -> None:\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    # graph as list of lists, each element is [to, rev, cap, cost]\n    g = []\n    L = max(n, k) * 2\n\n    # addNodes: add cnt empty adjacency lists, return index of last added node\n    def addNodes(cnt: int) -> int:\n        for _ in range(cnt):\n            g.append([])\n        return len(g) - 1\n\n    # add directed edge with reverse edge\n    def addEdge(u: int, v: int, cap: int, cost: int) -> None:\n        g[u].append([v, len(g[v]), cap, cost])\n        g[v].append([u, len(g[u]) - 1, 0, -cost])\n\n    # initial nodes: L*n nodes\n    addNodes(L * n)\n    s = addNodes(1)\n    t = addNodes(1)\n\n    # source edges for starting positions\n    for _ in range(k):\n        a = next(it) - 1\n        addEdge(s, a, 1, 0)\n\n    # road edges\n    for _ in range(m):\n        u = next(it) - 1\n        v = next(it) - 1\n        for i in range(L - 1):\n            u1 = u + i * n\n            v1 = v + (i + 1) * n\n            u2 = u + (i + 1) * n\n            v2 = v + i * n\n            for j in range(k):\n                w = c + d * (2 * j + 1)\n                addEdge(u1, v1, 1, w)\n                addEdge(v2, u2, 1, w)\n\n    # stay edges (waiting)\n    for i in range(L - 1):\n        for j in range(n):\n            u = j + i * n\n            v = j + (i + 1) * n\n            addEdge(u, v, INF, c)\n\n    # edges to sink from each time layer\n    for i in range(L):\n        addEdge(i * n, t, INF, 0)\n\n    # min-cost max-flow using SPFA\n    flow = 0\n    cost = 0\n    nodeCnt = len(g)\n\n    while flow < k:\n        # SPFA\n        dist = [INF] * nodeCnt\n        prevV = [-1] * nodeCnt\n        prevE = [-1] * nodeCnt\n        inQueue = [False] * nodeCnt\n\n        q = deque()\n        dist[s] = 0\n        q.append(s)\n        inQueue[s] = True\n\n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            for i, e in enumerate(g[u]):\n                v = e[0]\n                if e[2] > 0 and dist[v] > dist[u] + e[3]:\n                    dist[v] = dist[u] + e[3]\n                    prevV[v] = u\n                    prevE[v] = i\n                    if not inQueue[v]:\n                        inQueue[v] = True\n                        q.append(v)\n\n        if dist[t] == INF:\n            break\n\n        # find bottleneck capacity\n        add = INF\n        v = t\n        while v != s:\n            u = prevV[v]\n            e_idx = prevE[v]\n            add = min(add, g[u][e_idx][2])\n            v = u\n\n        # update residual capacities\n        v = t\n        while v != s:\n            u = prevV[v]\n            e_idx = prevE[v]\n            e = g[u][e_idx]\n            e[2] -= add\n            rev = e[1]\n            g[v][rev][2] += add\n            v = u\n\n        flow += add\n        cost += add * dist[t]\n\n    sys.stdout.write(str(cost))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0002079985715681687, 0.0, 0.0, -0.00026842328952625394, -0.00047195740626193583, 0.0, -0.00033909291960299015, -0.0003406421164982021, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, -0.0001262346631847322, -0.008620903827250004, -2.3841855067985307e-07, -1.9073468138230965e-06, -7.152555099310121e-07, -0.06196761503815651, -0.030959948897361755, -0.10324614495038986, -0.10301592946052551, -0.6724643707275391, -0.47411319613456726, -4.6491513785440475e-06, -9.60780744208023e-05, -5.960462772236497e-07, -3.576278118089249e-07, -4.386805812828243e-05, 0.0, -0.20141927897930145, -1.7881377516459906e-06, 0.0, 0.0, 0.0, 0.0, -1.2993727978027891e-05, -2.3841855067985307e-07, 0.0, 0.0, -2.3841855067985307e-07, -9.536738616588991e-07, -1.0132738680113107e-05, -0.3882741332054138, 0.0, -1.78813