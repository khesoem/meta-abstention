;\n            Edge(int to, int f, int cap, int cost) {\n                this.to = to;\n                this.f = f;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n        ArrayList<Edge> edges;\n        ArrayList<ArrayList<Integer>> g;\n        int[] prio, curflow, prevedge, prevnode, pot;\n        final int INF = 1_000_000_000;\n\n        MCF(int n) {\n            this.n = n;\n            edges = new ArrayList<>();\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) g.add(new ArrayList<>());\n            prio = new int[n];\n            curflow = new int[n];\n            prevedge = new int[n];\n            prevnode = new int[n];\n            pot = new int[n];\n        }\n\n        void addEdge(int s, int t, int cap, int cost) {\n            edges.add(new Edge(t, 0, cap, cost));\n            edges.add(new Edge(s, 0, 0, -cost));\n            g.get(s).add(edges.size() - 2);\n            g.get(t).add(edges.size() - 1);\n        }\n\n        int[] minCostFlow(int s, int t) {\n            int flow = 0, flowCost = 0;\n            while (flow < INF) {\n                PriorityQueue<Long> q = new PriorityQueue<>();\n                Arrays.fill(prio, Integer.MAX_VALUE);\n                prio[s] = 0;\n                curflow[s] = Integer.MAX_VALUE;\n                q.add((long)s); // distance 0, node s\n                while (!q.isEmpty()) {\n                    long cur = q.poll();\n                    int d = (int)(cur >> 32);\n                    int u = (int)cur;\n                    if (d != prio[u]) continue;\n                    for (int ei : g.get(u)) {\n                        Edge e = edges.get(ei);\n                        if (e.cap <= e.f) continue;\n                        int v = e.to;\n                        int nd = d + e.cost + pot[u] - pot[v];\n                        if (prio[v] > nd) {\n                            prio[v] = nd;\n                            q.add(((long)nd << 32) | (v