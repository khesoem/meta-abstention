)) {\n            int u = pq.top().id;\n            pq.pop();\n            if (vis[u]) continue;\n            vis[u] = true;\n            \n            for (int i = head[u]; i; i = e[i].next) {\n                int v = e[i].to;\n                ll w = pot[u] + e[i ^ 1].cost - pot[v];\n                if (e[i ^ 1].cap && dist[u] + w < dist[v]) {\n                    dist[v] = dist[u] + w;\n                    pq.push(Node(v, dist[v]));\n                }\n            }\n        }\n        \n        for (int i = 1; i <= node_cnt; ++i)\n            pot[i] = min(pot[i] + dist[i], INF);\n        \n        if (!vis[s]) return false;\n        fill(vis + 1, vis + node_cnt + 1, false);\n        return true;\n    }\n    \n    int dfs(int u, int t, int f) {\n        if (u == t || !f) return f;\n        int pushed = 0;\n        vis[u] = true;\n        \n        for (int& i = cur[u]; i; i = e[i].next) {\n            if (e[i].cap) {\n                int v = e[i].to;\n                int flow;\n                if (!vis[v] && pot[v] + e[i].cost == pot[u] &&\n                    (flow = dfs(v, t, min(f, e[i].cap)))) {\n                    e[i].cap -= flow;\n                    e[i ^ 1].cap += flow;\n                    pushed += flow;\n                    f -= flow;\n                    if (!f) break;\n                }\n            }\n        }\n        \n        vis[u] = false;\n        return pushed;\n    }\n    \n    int total_flow;\n    ll total_cost;\n    \n    void run(int s, int t) {\n        while (dijkstra(s, t)) {\n            int flow = dfs(s, t, INF);\n            total_flow += flow;\n            total_cost += (ll)flow * pot[s];\n        }\n    }\n}\n\nint src = 1, dst = 2, n, m, k, c, d;\n\ninline int idx(int t, int x) { return t * n + x + 2; }\n\nvoid layer(int t) {\n    node_cnt += n;\n    \n    for (int u = 1; u <= n; ++u)\n        for (int v : g[u])\n            for (int p = 1; p <= k; ++p)\n                add_edge(idx(t, u), idx(t + 1, v), 1, d * (2 * p - 1));\n    \n    for (int u = 1; u <= n; ++u)\n        add_edge(idx(t, u), idx(t + 1, u), INF, 0);\n    \n    add_edge(idx(t + 1, 1), dst, INF, c * (t + 1));\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    node_cnt = n + 2;\n    \n    for (int i = 1; i <= k; ++i) {\n        int a;\n        scanf(\"%d\", &a);\n        add_edge(src, idx(0, a), 1, 0);\n    }\n    \n    for (int i = 1; i <= m; ++i) {\n        int u, v;\n        scanf(\"%d%d\", &u, &v);\n        g[u].push_back(v);\n        g[v].push_back(u);\n    }\n    \n    add_edge(idx(0, 1), dst, INF, 0);\n    \n    for (int i = 0; i <= n + k; ++i)\n        layer(i);\n    \n    MCMF::run(src, dst);\n    printf(\"%lld\\n\", MCMF::total_cost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\nfrom collections import defaultdict\n\nINF = 10**18\n\nclass Edge:\n    def __init__(self, next_edge, to_node, cap, cost):\n        self.next = next_edge\n        self.to = to_node\n        self.cap = cap\n        self.cost = cost\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    \n    it = iter(map(int, input_data))\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    \n    MAXN = 100010\n    MAXM = 2000020\n    \n    e = [None] * MAXM\n    head = [-1] * MAXN\n    ecnt = 1\n    node_cnt = n + 2\n    \n    g = defaultdict(list)\n    \n    def add_edge(u, v, cap, cost):\n        nonlocal ecnt\n        e[ecnt] = Edge(head[u], v, cap, cost)\n        head[u] = ecnt\n        ecnt += 1\n        e[ecnt] = Edge(head[v], u, 0, -cost)\n        head[v] = ecnt\n        ecnt += 1\n    \n    def idx(t, x):\n        return t * n + x + 2\n    \n    class MCMF:\n        def __init__(self, node_cnt):\n            self.node_cnt = node_cnt\n            self.cur = [0] * MAXN\n            self.vis = [False] * MAXN\n            self.dist = [INF] * MAXN\n            self.pot = [0] * MAXN\n            self.total_flow = 0\n            self.total_cost = 0\n        \n        def dijkstra(self, s, t):\n            for i in range(1, self.node_cnt + 1):\n                self.dist[i] = INF\n            for i in range(1, self.node_cnt + 1):\n                self.cur[i] = head[1]\n            self.dist[t] = 0\n            pq = [(0, t)]\n            \n            while pq:\n                d_val, u = heapq.heappop(pq)\n                if self.vis[u]:\n                    continue\n                self.vis[u] = True\n                \n                i = head[u]\n                while i != -1:\n                    v = e[i].to\n                    w = self.pot[u] + e[i ^ 1].cost - self.pot[v]\n                    if e[i ^ 1].cap and self.dist[u] + w < self.dist[v]:\n                        self.dist[v] = self.dist[u] + w\n                        heapq.heappush(pq, (self.dist[v], v))\n                    i = e[i].next\n            \n            for i in range(1, self.node_cnt + 1):\n                self.pot[i] = min(self.pot[i] + self.dist[i], INF)\n            \n            if not self.vis[s]:\n                return False\n            for i in range(1, self.node_cnt + 1):\n                self.vis[i] = False\n            return True\n        \n        def dfs(self, u, t, f):\n            if u == t or not f:\n                return f\n            pushed = 0\n            self.vis[u] = True\n            \n            i = self.cur[u]\n            while i != -1:\n                if e[i].cap:\n                    v = e[i].to\n                    if not self.vis[v] and self.pot[v] + e[i].cost == self.pot[u]:\n                        flow = self.dfs(v, t, min(f, e[i].cap))\n                        if flow:\n                            e[i].cap -= flow\n                            e[i ^ 1].cap += flow\n                            pushed += flow\n                            f -= flow\n                            if not f:\n                                break\n                self.cur[u] = i\n                i = e[i].next\n            \n            self.vis[u] = False\n            return pushed\n        \n        def run(self, s, t):\n            while self.dijkstra(s, t):\n                flow = self.dfs(s, t, INF)\n                self.total_flow += flow\n                self.total_cost += flow * self.pot[s]\n    \n    src = 1\n    dst = 2\n    \n    for i in range(k):\n        a = next(it)\n        add_edge(src, idx(0, a), 1, 0)\n    \n    for i in range(m):\n        u = next(it)\n        v = next(it)\n        g[u].append(v)\n        g[v].append(u)\n    \n    add_edge(idx(0, 1), dst, INF, 0)\n    \n    def layer(t):\n        nonlocal node_cnt\n        node_cnt += n\n        \n        for u in range(1, n + 1):\n            for v in g[u]:\n                for p in range(1, k + 1):\n                    add_edge(idx(t, u), idx(t + 1, v), 1, d * (2 * p - 1))\n        \n        for u in range(1, n + 1):\n            add_edge(idx(t, u), idx(t + 1, u), INF, 0)\n        \n        add_edge(idx(t + 1, 1), dst, INF, c * (t + 1))\n    \n    for i in range(n + k + 1):\n        layer(i)\n    \n    mcmf = MCMF(node_cnt)\n    mcmf.run(src, dst)\n    print(mcmf.total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0002217047003796324, -1.311301275563892e-06, -1.1920928244535389e-07, -3.755022044060752e-05, -0.25222182273864746, -7.152555099310121e-07, -0.005931513383984566, -0.0017849955474957824, -0.6933946013450623, -0.0006361367995850742, -0.0003670972364488989, -4.768370445162873e-07, -0.018153004348278046, -0.04939109459519386, -0.8753020763397217, -3.6954811548639555e-06, -0.0028246049769222736, 0.0, -3.576278118089249e-07, -0.42968326807022095, -0.08893967419862747, -0.016783228144049644, -0.018317701295018196, -0.021771596744656563, -9.154854342341423e-