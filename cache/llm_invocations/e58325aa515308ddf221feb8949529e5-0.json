nt[n][m];\n        int cnt = 0;\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < m; j++)\n                grid[i][j] = cnt++;\n\n        int evenCount = (n * m + 1) / 2;\n        int oddCount = n * m / 2;\n        int[][] even = new int[evenCount][2];\n        int[][] odd = new int[oddCount][2];\n        int ei = 0, oi = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                if (((i + j) & 1) == 0) { even[ei][0] = i; even[ei][1] = j; ei++; }\n                else { odd[oi][0] = i; odd[oi][1] = j; oi++; }\n            }\n        }\n\n        boolean[][] match = new boolean[evenCount][oddCount];\n        for (int i = 0; i < evenCount; i++) {\n            for (int j = 0; j < oddCount; j++) {\n                int d = Math.abs(even[i][0] - odd[j][0]) + Math.abs(even[i][1] - odd[j][1]);\n                if (d == 3) match[i][j] = true;\n            }\n        }\n\n        return 2 * maxMatching(match);\n    }\n\n    int maxMatching(boolean[][] g) {\n        int n1 = g.length, n2 = n1 == 0 ? 0 : g[0].length;\n        int[] matchR = new int[n2];\n        Arrays.fill(matchR, -1);\n        int res = 0;\n        for (int u = 0; u < n1; u++) {\n            if (bpm(g, u, new boolean[n1], matchR)) res++;\n        }\n        return res;\n    }\n\n    boolean bpm(boolean[][] g, int u, boolean[] seen, int[] matchR) {\n        for (int v = 0; v < matchR.length; v++) {\n            if (g[u][v] && !seen[v]) {\n                seen[v] = true;\n                if (matchR[v] == -1 || bpm(g, matchR[v], seen, matchR)) {\n                    matchR[v] = u;\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n\n    public static void main(String[] args) throws IOException {\n        new CFA3().run();\n    }\n\n    void run() throws IOException {\n        br = new BufferedReader(new InputStreamReader(System.in));\n        out = new PrintWriter(System.out);\n        solve(