; v != s; v = pv[v]) {\n                Edge &e = g[pv[v]][pe[v]];\n                e.cap--;\n                g[v][e.rev].cap++;\n            }\n            total += dist[t];\n        }\n        return total;\n    }\n\n    void run() {\n        cin >> n;\n        n /= 2;\n        N = 1 + n + A + 1;\n        S = 0;\n        T = N - 1;\n        g.assign(N, vector<Edge>());\n\n        string s;\n        cin >> s;\n        vector<int> b(2 * n);\n        for (int i = 0; i < 2 * n; i++) cin >> b[i];\n\n        for (int i = 0; i < n; i++) addEdge(S, 1 + i, 2, 0);\n        for (int i = 0; i < n; i++) {\n            int j = 2 * n - 1 - i;\n            int ai = s[i] - 'a';\n            int aj = s[j] - 'a';\n            for (int a = 0; a < A; a++) {\n                int val;\n                if (a == ai && a == aj) val = max(b[i], b[j]);\n                else if (a == ai) val = b[i];\n                else if (a == aj) val = b[j];\n                else val = 0;\n                addEdge(1 + i, 1 + n + a, 1, -val);\n            }\n        }\n\n        vector<int> cnt(A, 0);\n        for (int i = 0; i < 2 * n; i++) cnt[s[i] - 'a']++;\n        for (int a = 0; a < A; a++) addEdge(1 + n + a, T, cnt[a], 0);\n\n        cout << -minCostFlow(S, T) << endl;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    CF884F solver;\n    solver.run();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.00011407678539399058, 0.0, -1.1920928244535389e-07, -0.0007578838267363608, -0.0008101756684482098, -3.6954195820726454e-05, -0.5761440992355347, -2.3841855067985307e-07, 0.0, 0.0, -0.001141611486673355, -0.00017796363681554794, -1.4305104514278355e-06, 0.0, -0.0067215063609182835, -0.059341274201869965, -3.814689989667386e-06, -0.07897743582725525, -2.4199192921514623e-05, -9.536738616588991e-07, 0.0, -0.16036780178546906, -7.390948667307384e-06, -1.3112935448589269e-05, 0.0, -4.768360213347478e-06, -0.0053217415697872