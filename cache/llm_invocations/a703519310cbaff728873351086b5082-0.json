)\n\ndef pow_convol(a, k, p):\n    n = len(a)\n    if k == 1:\n        return a[:]\n    elif k & 1:\n        r = pow_convol(a, k - 1, p)\n        res = [0] * n\n        for i in range(n):\n            for j in range(n - i):\n                res[i + j] = (res[i + j] + r[i] * a[j]) % p\n        return res\n    else:\n        r = pow_convol(a, k >> 1, p)\n        res = [0] * n\n        for i in range(n):\n            for j in range(n - i):\n                res[i + j] = (res[i + j] + r[i] * r[j]) % p\n        return res\n\ndef subset_pow_convol(a, k, p):\n    logn = 19\n    fa = [[0] * (1 << logn) for _ in range(logn)]\n    fb = [[0] * (1 << logn) for _ in range(logn)]\n    fc = [[0] * (1 << logn) for _ in range(logn)]\n    n = len(a)\n    while n != (n & -n):\n        n += n & -n\n    res = [0] * n\n    for i in range(logn):\n        for j in range(n):\n            if bitcount(j) == i:\n                fa[i][j] = a[j] if j < len(a) else 0\n            else:\n                fa[i][j] = 0\n            fc[i][j] = 0\n        transform(fa[i], n, p, 0)\n    \n    for i in range(n):\n        va = []\n        for j in range(logn):\n            va.append(fa[j][i])\n        va = pow_convol(va, k, p)\n        for j in range(logn):\n            fc[j][i] = va[j]\n    \n    for i in range(logn):\n        transform(fc[i], n, p, 1)\n        for j in range(n):\n            if bitcount(j) == i:\n                res[j] = fc[i][j]\n    return res\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    n = int(input_data[0])\n    k = int(input_data[1])\n    p = int(input_data[2])\n    \n    nn = n\n    f = {}\n    for i in range(n + 1):\n        if (n & i) == i:\n            t = 0\n            for j in range(20):\n                if bit(n, j):\n                    t <<= 1\n                    t |= bit(i, j)\n            f[t] = i\n            nn = t\n    \n    if n & 1:\n        print(fpow(k, n, p))\n        return\n    \n    maxn = 10**6 + 5\n    fac = [1] * maxn\n    for i in range(1, maxn):\n        fac[i] = (fac[i-1] * i) % p\n    \n    ifac = [0] * maxn\n    for i in range(maxn):\n        ifac[i] = inv(fac[i], p)\n    \n    a = [0] * (nn + 1)\n    for i in range(nn + 1):\n        a[i] = ifac[f[i]]\n    \n    res = fpow(k, n, p)\n    a = subset_pow_convol(a, k, p)\n    res = submod(res, (a[nn] * fac[n]) % p, p)\n    print(res)\n\ndef main():\n    data = sys.stdin.read().strip()\n    if not data:\n        return\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0001938155182870105, -7.152555099310121e-07, -4.768370445162873e-07, -0.0007221474661491811, -0.6344941258430481, -1.6331539882230572e-05, -0.0020443748217076063, -0.0019585967529565096, -0.6326056122779846, -0.4301629960536957, -0.4393831491470337, -1.311301275563892e-06, -0.14382831752300262, -3.45700973412022e-05, -0.00028200942324474454, -0.00013052565918769687, -0.6848624348640442, -2.622600959512056e-06, -0.011925826780498028, 0.0, -2.3841855067985307e-07, -0.00023457636416424066, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -0.02630067989230156, -0.08019975572824478, -2.861018856492592e-06, -1.7881377516459906e-06, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -9.536738616588991e-07, -1.8715683836489916e-05, -6.437280717364047e-06, -1.1324817933200393e-05, -7.748573807475623e-06, -5.960462772236497e-07, -2.861018856492592e-06, -3.1709168979432434e-05, -1.1920928244535389e-07, -4.708655978902243e-05, -5.8412379075889476e-06, -7.152555099310121e-07, -4.768370445162873e-07, -2.1457441107486375e-05, -1.4305104514278355e-06, -3.576278118089249e-07, -4.005352093372494e-05, -1.1920928244535389e-07, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.0006282739923335612, -0.10046472400426865, -4.768370445162873e-07, -8.868777513271198e-05, -0.0028555116150528193, -2.3841855067985307e-07, -1.1920928244535389e-