ront(); qq.pop();\n        i = p.x; j = p.y;\n        if (distDst[i][j] > limit) continue;\n        if (gridSrc[i][j] == 'Y') continue;\n        if (buckets[i][j].active) {\n            if (distDst[i][j] <= limit && distDst[i][j] <= distSrc[i][j]) {\n                for (k = 1; k <= buckets[i][j].cnt; k++)\n                    adjList[s.id].push_back(buckets[i][j].vals[k]);\n            }\n        }\n        if (distDst[i][j] >= distSrc[i][j]) continue;\n        // up\n        if (i - 1 >= 0 && distDst[i - 1][j] > distDst[i][j] + 1) {\n            distDst[i - 1][j] = distDst[i][j] + 1;\n            q.x = i - 1; q.y = j;\n            qq.push(q);\n        }\n        // down\n        if (i + 1 < size && distDst[i + 1][j] > distDst[i][j] + 1) {\n            distDst[i + 1][j] = distDst[i][j] + 1;\n            q.x = i + 1; q.y = j;\n            qq.push(q);\n        }\n        // left\n        if (j - 1 >= 0 && distDst[i][j - 1] > distDst[i][j] + 1) {\n            distDst[i][j - 1] = distDst[i][j] + 1;\n            q.x = i; q.y = j - 1;\n            qq.push(q);\n        }\n        // right\n        if (j + 1 < size && distDst[i][j + 1] > distDst[i][j] + 1) {\n            distDst[i][j + 1] = distDst[i][j] + 1;\n            q.x = i; q.y = j + 1;\n            qq.push(q);\n        }\n    }\n}\n\nvoid bfsSource(Point s) {\n    int i, j;\n    Point p, q;\n    i = s.x; j = s.y;\n    distSrc[i][j] = 0;\n    qq.push(s);\n    while (!qq.empty()) {\n        p = qq.front(); qq.pop();\n        i = p.x; j = p.y;\n        if (gridSrc[i][j] == 'Y') continue;\n        // up\n        if (i - 1 >= 0 && distSrc[i - 1][j] > distSrc[i][j] + 1) {\n            distSrc[i - 1][j] = distSrc[i][j] + 1;\n            q.x = i - 1; q.y = j;\n            qq.push(q);\n        }\n        // down\n        if (i + 1 < size && distSrc[i + 1][j] > distSrc[i][j] + 1) {\n            distSrc[i + 1][j] = distSrc[i][j] + 1;\n            q.x = i + 1; q.y = j;\n            qq.push(q);\n        }\n        // left\n    