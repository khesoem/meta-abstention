      continue\n        if buckets[i][j]['active']:\n            if distDst[i][j] <= limit and distDst[i][j] <= distSrc[i][j]:\n                for val in buckets[i][j]['vals']:\n                    adjList[sid].append(val)\n        if distDst[i][j] >= distSrc[i][j]:\n            continue\n        # up\n        if i - 1 >= 0 and distDst[i-1][j] > distDst[i][j] + 1:\n            distDst[i-1][j] = distDst[i][j] + 1\n            q.append((i-1, j))\n        # down\n        if i + 1 < size and distDst[i+1][j] > distDst[i][j] + 1:\n            distDst[i+1][j] = distDst[i][j] + 1\n            q.append((i+1, j))\n        # left\n        if j - 1 >= 0 and distDst[i][j-1] > distDst[i][j] + 1:\n            distDst[i][j-1] = distDst[i][j] + 1\n            q.append((i, j-1))\n        # right\n        if j + 1 < size and distDst[i][j+1] > distDst[i][j] + 1:\n            distDst[i][j+1] = distDst[i][j] + 1\n            q.append((i, j+1))\n\ndef maxMatch(nodes, max_node):\n    global leftSide, rightSide, color\n    leftSide = [-1] * (max_node + 1)\n    rightSide = [-1] * (max_node + 1)\n    color = [0] * (max_node + 1)\n\n    def tryAugment(u):\n        if color[u]:\n            return False\n        color[u] = 1\n        for v in adjList[u]:\n            if leftSide[v] == -1:\n                leftSide[v] = u\n                rightSide[u] = v\n                return True\n            elif tryAugment(leftSide[v]):\n                leftSide[v] = u\n                rightSide[u] = v\n                return True\n        return False\n\n    changed = True\n    while changed:\n        changed = False\n        color = [0] * (max_node + 1)\n        for i in range(1, nodes + 1):\n            if rightSide[i] == -1 and tryAugment(i):\n                changed = True\n    res = 0\n    for i in range(1, nodes + 1):\n        if rightSide[i] != -1:\n            res += 1\n    return res\n\ndef main():\n    global size, limit, gridSrc, gridDst, distSrc, distDst, buckets, adjList\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    size = int(first[0])\n    limit = int(first[1])\n    gridSrc = [list(data[i+1].strip()) for i in range(size)]\n    gridDst = [list(data[i+1+size].strip()) for i in range(size)]\n\n    distSrc = [[INF]*size for _ in range(size)]\n    for i in range(size):\n        for j in range(size):\n            if gridSrc[i][j] == 'Z':\n                bfsSource((i, j))\n\n    buckets = [[{'active':0, 'cnt':0, 'vals':[]} for _ in range(size)] for _ in range(size)]\n    idx = 1\n    for i in range(size):\n        for j in range(size):\n            if gridDst[i][j].isdigit():\n                k = int(gridDst[i][j])\n                if k > 0:\n                    buckets[i][j]['active'] = 1\n                buckets[i][j]['cnt'] = k\n                for _ in range(k):\n                    buckets[i][j]['vals'].append(idx)\n                    idx += 1\n    dest_max = idx - 1\n\n    adjList = [[] for _ in range(1000)]  # will be extended if needed\n    idx = 1\n    for i in range(size):\n        for j in range(size):\n            if gridSrc[i][j].isdigit():\n                k = int(gridSrc[i][j])\n                for _ in range(k):\n                    if idx >= len(adjList):\n                        adjList.append([])\n                    bfsDest((i, j, idx))\n                    idx += 1\n    src_max = idx - 1\n    max_node = max(src_max, dest_max)\n    result = maxMatch(src_max, max_node)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.245195097813848e-06, 0.0, 0.0, -0.0001006075763143599, -0.00038926175329834223, 0.0, -5.245195097813848e-06, -0.005574633367359638, 0.0, 0.0, -5.960462772236497e-07, -0.16024644672870636, -0.31443214416503906, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.034057069569826126, -1.2993727978027891e-05, -0.00020632999076042324, -0.16023151576519012, -0