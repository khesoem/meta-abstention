rintWriter(new BufferedWriter(new OutputStreamWriter(outputStream)));\n        }\n\n        public void close() {\n            writer.close();\n        }\n\n        public void println(int i) {\n            writer.println(i);\n        }\n    }\n\n    static class InputReader {\n        private final InputStream stream;\n        private final byte[] buffer = new byte[65536];\n        private int pos = 0, count = 0;\n\n        public InputReader(InputStream stream) {\n            this.stream = stream;\n        }\n\n        private int nextByte() {\n            if (pos == count) {\n                pos = 0;\n                try {\n                    count = stream.read(buffer);\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n                if (count <= 0) return -1;\n            }\n            return buffer[pos++];\n        }\n\n        public int nextInt() {\n            int b;\n            while ((b = nextByte()) <= 32) if (b == -1) throw new NoSuchElementException();\n            byte sign = 1;\n            if (b == 45) {\n                sign = -1;\n                b = nextByte();\n            }\n            int res = 0;\n            while (b > 32) {\n                res = res * 10 + b - 48;\n                b = nextByte();\n            }\n            return res * sign;\n        }\n\n        public long nextLong() {\n            int b;\n            while ((b = nextByte()) <= 32) if (b == -1) throw new NoSuchElementException();\n            byte sign = 1;\n            if (b == 45) {\n                sign = -1;\n                b = nextByte();\n            }\n            long res = 0L;\n            while (b > 32) {\n                res = res * 10L + b - 48;\n                b = nextByte();\n            }\n            return res * sign;\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<r