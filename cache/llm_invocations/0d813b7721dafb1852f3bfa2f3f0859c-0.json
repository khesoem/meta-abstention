{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int INF = 0x7f7f7f7f;\nint n,m,s,t,p,c,d,x[505],y[505];\nint mxf,mnc;\nint ee=1,h[5000005],nex[5000005<<1],to[5000005<<1],val[5000005<<1],cost[5000005<<1];\nint dis[5000005],pre[5000005],last[5000005],flow[5000005];\nbool vis[5000005];\nvoid addedge(int x,int y,int z,int c)\n{\n\tnex[++ee] = h[x];\n\tto[ee] = y;\n\tval[ee] = z;\n\tcost[ee] = c;\n\th[x] = ee;\n}\nbool spfa()\n{\n\tfill(dis, dis+5000005, INF);\n\tmemset(vis, false, sizeof(vis));\n\tqueue<int> q;\n\tq.push(s);\n\tvis[s] = true;\n\tdis[s] = 0;\n\tflow[s] = INF;\n\tpre[t] = -1;\n\twhile(!q.empty())\n\t{\n\t\tint x=q.front();\n\t\tq.pop();\n\t\tvis[x] = false;\n\t\tfor(int i=h[x];i;i=nex[i])\n\t\t\tif(val[i] && dis[to[i]]>dis[x]+cost[i])\n\t\t\t{\n\t\t\t\tdis[to[i]] = dis[x]+cost[i];\n\t\t\t\tpre[to[i]] = x;\n\t\t\t\tlast[to[i]] = i;\n\t\t\t\tflow[to[i]] = min(flow[x],val[i]);\n\t\t\t\tif(!vis[to[i]])\n\t\t\t\t{\n\t\t\t\t\tvis[to[i]] = true;\n\t\t\t\t\tq.push(to[i]);\n\t\t\t\t}\n\t\t\t}\n\t}\n\treturn pre[t]!=-1;\n}\nvoid mcmf()\n{\n\tmxf = mnc = 0;\n\twhile(spfa())\n\t{\n\t\tint now=t;\n\t\tmxf += flow[t];\n\t\tmnc += flow[t]*dis[t];\n\t\twhile(now!=s)\n\t\t{\n\t\t\tval[last[now]] -= flow[t]; \n\t\t\tval[last[now]^1] += flow[t];\n\t\t\tnow = pre[now];\n\t\t}\n\t}\n}\nint zh(int t,int x)\n{\n\treturn t*n+x;\n}\nint main()\n{\n\tcin>>n>>m>>p>>c>>d;\n\ts = 0, t = n*99+1;\n\tfor(int i=1,x;i<=p&&cin>>x;i++)\n\t\taddedge(s,zh(0,x),1,0), addedge(zh(0,x),s,0,0);\n\tfor(int i=1;i<=m;cin>>x[i]>>y[i],i++);\n\tfor(int i=0;i<=99;i++)\n\t{\n\t\taddedge(zh(i,1),zh(i+1,1),INF,0), addedge(zh(i+1,1),zh(i,1),0,0);\n\t\tfor(int j=2;j<=n;j++)\n\t\t\taddedge(zh(i,j),zh(i+1,j),INF,c), addedge(zh(i+1,j),zh(i,j),0,-c);\n\t\tfor(int j=1;j<=m;j++)\n\t\t\tfor(int k=1;k<=p;k++)\n\t\t\t{\n\t\t\t\tint cst=d*k*k-d*(k-1)*(k-1)+c;\n\t\t\t\taddedge(zh(i,x[j]),zh(i+1,y[j]),1,cst), addedge(zh(i+1,y[j]),zh(i,x[j]),0,-cst);\n\t\t\t\taddedge(zh(i,y[j]),zh(i+1,x[j]),1,cst), addedge(zh(i+1,x[j]),zh(i,y[j]),0,-cst);\n\t\t\t}\n\t}\n\tmcmf();\n\tcout<<mnc<<endl;\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 0x7f7f7f7f\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    p = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    s = 0\n    t = n * 99 + 1\n    \n    # Initialize graph structures\n    MAX_NODES = 5000005\n    h = [0] * MAX_NODES\n    nex = [0] * (MAX_NODES * 2)\n    to = [0] * (MAX_NODES * 2)\n    val = [0] * (MAX_NODES * 2)\n    cost_arr = [0] * (MAX_NODES * 2)\n    \n    ee = 1  # Edge index starts at 1\n    \n    def addedge(x, y, z, c):\n        nonlocal ee\n        ee += 1\n        nex[ee] = h[x]\n        to[ee] = y\n        val[ee] = z\n        cost_arr[ee] = c\n        h[x] = ee\n    \n    # Add edges for passengers\n    for _ in range(p):\n        x_val = int(next(it))\n        addedge(s, zh(0, x_val), 1, 0)\n        addedge(zh(0, x_val), s, 0, 0)\n    \n    # Read m edges\n    x_list = [0] * (m + 1)\n    y_list = [0] * (m + 1)\n    for i in range(1, m + 1):\n        x_list[i] = int(next(it))\n        y_list[i] = int(next(it))\n    \n    # Build the time-expanded graph\n    for i in range(100):\n        # Edge from (i,1) to (i+1,1)\n        addedge(zh(i, 1), zh(i + 1, 1), INF, 0)\n        addedge(zh(i + 1, 1), zh(i, 1), 0, 0)\n        \n        # Edges from (i,j) to (i+1,j) for j >= 2\n        for j in range(2, n + 1):\n            addedge(zh(i, j), zh(i + 1, j), INF, c)\n            addedge(zh(i + 1, j), zh(i, j), 0, -c)\n        \n        # Edges for m edges (bidirectional)\n        for j in range(1, m + 1):\n            for k in range(1, p + 1):\n                cst = d * k * k - d * (k - 1) * (k - 1) + c\n                addedge(zh(i, x_list[j]), zh(i + 1, y_list[j]), 1, cst)\n                addedge(zh(i + 1, y_list[j]), zh(i, x_list[j]), 0, -cst)\n                addedge(zh(i, y_list[j]), zh(i + 1, x_list[j]), 1, cst)\n                addedge(zh(i + 1, x_list[j]), zh(i, y_list[j]), 0, -cst)\n    \n    # MCMF algorithm\n    mxf = 0\n    mnc = 0\n    \n    dis = [INF] * MAX_NODES\n    pre = [-1] * MAX_NODES\n    last = [-1] * MAX_NODES\n    flow = [0] * MAX_NODES\n    vis = [False] * MAX_NODES\n    \n    def spfa():\n        nonlocal dis, pre, last, flow, vis\n        for i in range(MAX_NODES):\n            dis[i] = INF\n        for i in range(MAX_NODES):\n            vis[i] = False\n        \n        q = deque()\n        q.append(s)\n        vis[s] = True\n        dis[s] = 0\n        flow[s] = INF\n        pre[t] = -1\n        \n        while q:\n            x = q.popleft()\n            vis[x] = False\n            i = h[x]\n            while i:\n                if val[i] and dis[to[i]] > dis[x] + cost_arr[i]:\n                    dis[to[i]] = dis[x] + cost_arr[i]\n                    pre[to[i]] = x\n                    last[to[i]] = i\n                    flow[to[i]] = min(flow[x], val[i])\n                    if not vis[to[i]]:\n                        vis[to[i]] = True\n                        q.append(to[i])\n                i = nex[i]\n        \n        return pre[t] != -1\n    \n    def mcmf():\n        nonlocal mxf, mnc\n        mxf = 0\n        mnc = 0\n        while spfa():\n            now = t\n            mxf += flow[t]\n            mnc += flow[t] * dis[t]\n            while now != s:\n                edge_idx = last[now]\n                val[edge_idx] -= flow[t]\n                val[edge_idx ^ 1] += flow[t]\n                now = pre[now]\n    \n    mcmf()\n    print(mnc)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016807096835691482, -1.0728830375228426e-06, -3.576278118089249e-07, -0.021228129044175148, -0.012500271201133728, -3.576278118089249e-07, -6.151010165922344e-05, -0.0003194298769813031, -1.3351351299206726e-05, -0.00016044282529037446, -0.002482073148712516, -0.6339214444160461, -5.960462772236497e-07, -0.0006293461774475873, -7.033323527139146e-06, -2.264974000354414e-06, -0.00017951308109331876, -6.9141146923357155e-06, -1.0728830375228426e-06, -8.344646857949556e-07, -2.861018856492592e-06, -9.536738616588991e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -0.020549023523926735, -0.02371610887348652, -0.007788882590830326, -3.302042750874534e-05, -1.4305104514278355e-06, -0.2888355851173401, -1.9073468138230965e-06, -0.012269378639757633, -1.8358061424805783e-05, -0.0008247073274105787, -7.510157047363464e-06, -0.07891563326120377, -4.410646579344757e-05, -1.6689286894688848e-06, -0.4322407841682434, -5.960446742392378e-06, -2.3841855067985307e-07, -0.0001805857609724626, -2.3841855067985307e-07, -7.247662142617628e-05, -0.009788254275918007, -8.344646857949556e-07, -0.07392016053199768, -2.0265558760002023e-06, -4.2199197196168825e-05, -0.28123217821121216, 