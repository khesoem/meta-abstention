[][] g = new long[n + 1][len];\n        long[][] f = new long[n + 1][len];\n        \n        for (int mask = 0; mask < len; ++mask) {\n            int sum = 0;\n            for (int j = 0; j < n; ++j) {\n                if (((mask >> j) & 1) == 1) {\n                    sum += bits.get(j);\n                }\n            }\n            g[cnt[mask]][mask] = inv[sum];\n        }\n        \n        for (int i = 2; i <= n; ++i) {\n            inv[i] = (mod - mod / i) * inv[(int)(mod % i)] % mod;\n        }\n        \n        FWT(g, len, false);\n        \n        long[] h = new long[n + 1];\n        long[] p = new long[n + 1];\n        \n        for (int s = 0; s < len; ++s) {\n            for (int i = 0; i <= n; ++i) {\n                h[i] = g[i][s];\n            }\n            \n            // log\n            p[0] = 0;\n            for (int i = 1; i <= n; ++i) {\n                p[i] = (h[i] * i) % mod;\n                for (int j = 1; j < i; ++j) {\n                    p[i] = (p[i] - (p[j] * h[i - j] % mod) * j % mod + mod) % mod;\n                }\n                p[i] = (p[i] * inv[i]) % mod;\n            }\n            for (int i = 0; i <= n; ++i) {\n                h[i] = (p[i] + mod) % mod;\n            }\n            \n            // scale by k\n            for (int i = 0; i <= n; ++i) {\n                h[i] = (h[i] * k) % mod;\n            }\n            \n            // exp\n            p[0] = 1;\n            for (int i = 1; i <= n; ++i) {\n                p[i] = 0;\n                for (int j = 1; j <= i; ++j) {\n                    p[i] = (p[i] + (h[j] * p[i - j] % mod) * j) % mod;\n                }\n                p[i] = (p[i] * inv[i]) % mod;\n            }\n            for (int i = 0; i <= n; ++i) {\n                h[i] = p[i];\n            }\n            \n            for (int i = 0; i <= n; ++i) {\n                f[i][s] = h[i];\n            }\n        }\n        \n        FWT(f, len, true);\n        \n        long ans = (f[n][len - 1] * fac[L]) % mod;\n        ans = (total - ans + mod) % mod;\n        System.out.println(ans);\n    }\n    \n    static void FWT(long[][] g, int len, boolean inverse) {\n        for (int step = 1; step < len; step <<= 1) {\n            for (int i = 0; i < len; i += step << 1) {\n                for (int j = 0; j < step; ++j) {\n                    for (int i2 = 0; i2 <= g.length - 1; ++i2) {\n                        if (!inverse) {\n                            g[i2][i + j + step] = (g[i2][i + j + step] + g[i2][i + j]) % mod;\n                        } else {\n                            g[i2][i + j + step] = (g[i2][i + j + step] - g[i2][i + j] + mod) % mod;\n                        }\n                    }\n                }\n            }\n        }\n    }\n    \n    static void FWT(long[] a, int sz, boolean inverse) {\n        for (int step = 1; step < sz; step <<= 1) {\n            for (int i = 0; i < sz; i += step << 1) {\n                for (int j = 0; j < step; ++j) {\n                    if (!inverse) {\n                        a[i + j + step] = (a[i + j + step] + a[i + j]) % mod;\n                    } else {\n                        a[i + j + step] = (a[i + j + step] - a[i + j] + mod) % mod;\n                    }\n                }\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00014518637908622622, -2.3841830625315197e-06, -9.536738616588991e-07, -0.00038378025055862963, -4.8397800128441304e-05, -0.12707041203975677, -0.31355008482933044, -0.003668366465717554, -5.543078441405669e-05, -0.00020072828920092434, -0.00046456989366561174, -2.1576648578047752e-05, -9.536738616588991e-07, -5.817244164063595e-05, -0.006721861660480499, -9.83428253675811e-05, -0.4896831512451172, -0.6478522419929504, -0.00011205045302631333, -7.819823804311454e-05, -1.4066597032069694e-05, 0.0, 0.0, 0.0, -1.9073468138230965e-06, -1.1920928244535389e-07, -2.145764938177308e-06, -1.311301275563892e-06, -9.536738616588991e-0