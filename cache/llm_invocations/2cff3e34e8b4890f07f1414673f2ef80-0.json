L = solvePart(L, 0);\n            long f0R = solvePart(R, 0);\n            long f1L = solvePart(L, 1);\n            long f1R = solvePart(R, 1);\n\n            if (type == 0) {\n                res = (f0L * f0R + f1L * f1R) % MOD;\n            } else {\n                res = (f0L * f1R + f1L * f0R) % MOD;\n            }\n        }\n\n        cache[type].put(n, res);\n        return res;\n    }\n\n    static void solve() {\n        long n = in.nextInt();\n        long m = in.nextInt();\n        long l = in.nextInt();\n        long r = in.nextInt();\n        long sz = n * m;\n\n        if (sz % 2 == 0) {\n            even = (r - l + 1) / 2;\n            if ((r - l) % 2 == 0 && l % 2 == 0) {\n                even++;\n            }\n            odd = r - l + 1 - even;\n            out.println(solvePart(sz, 0));\n        } else {\n            out.println(pow(r - l + 1, sz));\n        }\n    }\n\n    public static void main(String[] args) {\n        in = new FastReader(System.in);\n        out = new PrintWriter(System.out);\n        int tests = 1;\n        while (tests-- > 0) {\n            solve();\n        }\n        out.close();\n    }\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        FastReader(InputStream is) {\n            br = new BufferedReader(new InputStreamReader(is));\n        }\n\n        Integer nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        Long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        Double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                st = new StringTokenizer(nextLine());\n            }\n            return st.nextToken();\n        }\n\n        String nextLine() {\n            String s = \"\";\n            try {\n                s = br.readLine();\n            } catch (IOException e) {\n                e.print