{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nconst int N = 1000007;\nconst int SOURCE = N - 2;\nconst int TARGET = N - 1;\nconst ll INF = (ll)1e18;\n\nstruct Edge {\n    int to, cap, flow, cost;\n};\n\nvector<Edge> edges;\nvector<int> adj[N];\nll dist[N];\nint pred[N], pe[N];\nbool inq[N];\nll answer = 0;\n\nint residual(int id) {\n    return edges[id].cap - edges[id].flow;\n}\n\nvoid addEdge(int u, int v, int capacity, int costValue) {\n    adj[u].push_back((int)edges.size());\n    edges.push_back({v, capacity, 0, costValue});\n    adj[v].push_back((int)edges.size());\n    edges.push_back({u, 0, 0, -costValue});\n}\n\nvoid pushFlow() {\n    fill(dist, dist + N, INF);\n    fill(pred, pred + N, -1);\n    fill(pe, pe + N, -1);\n    fill(inq, inq + N, false);\n\n    dist[SOURCE] = 0;\n    queue<int> q;\n    q.push(SOURCE);\n    inq[SOURCE] = true;\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inq[u] = false;\n\n        for (int id : adj[u]) {\n            if (residual(id) == 0) continue;\n            int v = edges[id].to;\n            ll nd = dist[u] + edges[id].cost;\n            if (dist[v] > nd) {\n                dist[v] = nd;\n                pred[v] = u;\n                pe[v] = id;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n\n    for (int cur = TARGET; cur != SOURCE; cur = pred[cur]) {\n        int id = pe[cur];\n        edges[id].flow++;\n        edges[id ^ 1].flow--;\n    }\n    answer += dist[TARGET];\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        --x;\n        addEdge(SOURCE, x, 1, 0);\n    }\n\n    const int LAYERS = 101;\n    for (int t = 0; t < LAYERS; ++t) {\n        addEdge(t * n, TARGET, k, t * c);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        scanf(\"%d %d\", &x, &y);\n        --x; --y;\n        for (int t = 0; t < LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n        for (int t = 0; t < LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n\n    for (int v = 0; v < n; ++v) {\n        for (int t = 0; t < LAYERS - 1; ++t) {\n            addEdge(v + t * n, v + t * n + n, k, 0);\n        }\n    }\n\n    for (int i = 0; i < k; ++i) pushFlow();\n\n    printf(\"%lld\\n\", answer);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    LAYERS = 101\n    N = LAYERS * n + 2\n    SOURCE = N - 2\n    TARGET = N - 1\n    INF = 10**18\n\n    edges = []  # list of [to, cap, flow, cost]\n    adj = [[] for _ in range(N)]\n    dist = [0] * N\n    pred = [-1] * N\n    pe = [-1] * N\n    inq = [False] * N\n    answer = 0\n\n    def residual(eid):\n        return edges[eid][1] - edges[eid][2]\n\n    def addEdge(u, v, capacity, costValue):\n        adj[u].append(len(edges))\n        edges.append([v, capacity, 0, costValue])\n        adj[v].append(len(edges))\n        edges.append([u, 0, 0, -costValue])\n\n    def pushFlow():\n        nonlocal answer\n        for i in range(N):\n            dist[i] = INF\n            pred[i] = -1\n            pe[i] = -1\n            inq[i] = False\n\n        dist[SOURCE] = 0\n        q = deque()\n        q.append(SOURCE)\n        inq[SOURCE] = True\n\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for eid in adj[u]:\n                if residual(eid) == 0:\n                    continue\n                v = edges[eid][0]\n                nd = dist[u] + edges[eid][3]\n                if dist[v] > nd:\n                    dist[v] = nd\n                    pred[v] = u\n                    pe[v] = eid\n                    if not inq[v]:\n                        inq[v] = True\n                        q.append(v)\n\n        cur = TARGET\n        while cur != SOURCE:\n            eid = pe[cur]\n            edges[eid][2] += 1\n            edges[eid ^ 1][2] -= 1\n            cur = pred[cur]\n        answer += dist[TARGET]\n\n    # read starting positions\n    for _ in range(k):\n        x = next(it) - 1\n        addEdge(SOURCE, x, 1, 0)\n\n    # connect each layer's node to target\n    for t in range(LAYERS):\n        addEdge(t * n, TARGET, k, t * c)\n\n    # roads\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        for t in range(LAYERS - 1):\n            for j in range(k):\n                addEdge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1))\n        for t in range(LAYERS - 1):\n            for j in range(k):\n                addEdge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1))\n\n    # stay edges\n    for v in range(n):\n        for t in range(LAYERS - 1):\n            addEdge(v + t * n, v + t * n + n, k, 0)\n\n    # run flow k times\n    for _ in range(k):\n        pushFlow()\n\n    print(answer)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.12873198091983795, -0.0002076410164590925, -1.1920928244535389e-07, -5.960462772236497e-07, -0.0004371640970930457, -0.0024861162528395653, 0.0, -0.0004343043256085366, -5.018585216021165e-05, -3.576278118089249e-07, -1.1920928244535389e-07, -8.821448318485636e-06, -0.0007552632014267147, -0.03082217276096344, -0.26789170503616333, -0.2519523799419403, -5.960462772236497e-07, -0.00016425691137555987, 0.0, -0.1269550323486328, -8.344646857949556e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -0.0009216589969582856, 0.0, -0.0019286142196506262, -2.0265558760002023e-06, -8.106198947643861e-06, -0.20818224549293518, -1.1920928244535389e-07, -0.0015023384476080537, 0.0, -0.00023767507809679955, -0.0015023384476080537, -3.2186455882765586e-06, -0.0001234931987710297, -4.887569048150908e-06, 0.0, -0.16026411950588226, 0.0, 0.0, -2.145764938177308e-06, 0.0, 0.0, -9.417489309271332e-06, 0.0, -2.3841830625315197e-06, -0.0002975021197926253, 0.0, 0.0, -2.1815061700181104e-05, 0.0, -3.814689989667386e-06, -0.0007651500636711717, 0.0, 0.0, -3.6954195820726454e-05, 0.0, -4.6491513785440475e-06, -0.00044979469384998083, 0.0, 0.0, -0.07889007776975632, -1.1920928244535389e-07, -0.16257359087467194, -4.541770613286644e-05, -4.768370445162873e-07, 0.0, 0.0, -1.1920928244535389e-07, -0.0005071069463156164, 0.0, -0.3674088716506958, -0.005835638847202063, -0.003184250323101878, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -2.264974