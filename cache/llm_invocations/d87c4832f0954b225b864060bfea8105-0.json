{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n//typedef long double ld;\n\nconst int maxn=5007;\n\n//const ll INF = 1e18;\nconst ll INF =  1e9;\nconst ll mod = 1e9+7;\n\nstruct Edge {\n    int from,to;\n    ll cap, cost, flow;\n    Edge(int from, int to, ll cap, ll cost): from(from), to(to), cap(cap), cost(cost), flow(0) {};\n};\n\nvector<Edge> edges;\nll d[maxn], phi[maxn];\nvector<int> g[maxn];\nint par[maxn];\n\nvoid add_edge(int u, int v, ll cap, ll cost) {\n    g[u].push_back(edges.size());\n    edges.push_back({u,v,cap,cost});\n    g[v].push_back(edges.size());\n    edges.push_back({v,u,0,-cost});\n}\nvoid ford_bellman(int s, int n) {\n    for (int i=0;i<maxn;i++) {\n        phi[i] = INF;\n    }\n    phi[s] = 0;\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<edges.size();j++) {\n            if (edges[j].cap==edges[j].flow) continue;\n            int from = edges[j].from;\n            int to = edges[j].to;\n            ll len = edges[j].cost;\n            if (phi[from]==INF) continue;\n            phi[to] = min(phi[to], phi[from]+len);\n        }\n    }\n}\n\nvoid dijkstra(int s) {\n    for (int i=0;i<maxn;i++) {\n        d[i] = INF;\n    }\n    d[s] = 0;\n    set<pair<ll,int>> q;\n    q.insert({0,s});\n    while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i=0;i<g[v].size();i++) {\n            int eid = g[v][i];\n            if (edges[eid].cap==edges[eid].flow) continue;\n            int to = edges[eid].to;\n            ll len = edges[eid].cost + phi[v] - phi[to];\n            if (d[v]+len<d[to]) {\n                q.erase({d[to],to});\n                d[to] = d[v]+len;\n                par[to] = eid;\n                q.insert({d[to],to});\n            }\n        }\n    }\n}\n\npair<ll,ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (1) {\n        if (d[t]==INF) break;\n        ll pushed=  INF, sum = 0;\n        for (int tmp = t;tmp!=s;) {\n//            if (tmp==100) {\n//                cout << \"xyu\";\n//            }\n            int eid = par[tmp];\n            pushed = min(pushed, edges[eid].cap-edges[eid].flow);\n            sum+=edges[eid].cost;\n            tmp = edges[eid].from;\n        }\n        flow+=pushed;\n        cost+=pushed*sum;\n        //cout << \"flow: \" << flow << \", cost: \" << cost << endl <<  t << \" \";\n        for (int tmp=t;tmp!=s;) {\n            int eid = par[tmp];\n            edges[eid].flow+=pushed;\n            edges[eid^1].flow-=pushed;\n            tmp = edges[eid].from;\n          //  cout << tmp << \" \";\n        }\n        //cout << endl;\n\n        dijkstra(s);\n        for (int i=0;i<maxn;i++) {\n            phi[i] = d[i];\n        }\n    }\n    return {cost, flow};\n}\nvoid solve() {\n    int n,m,k,c,d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnts(n,0);\n    for (int i=0;i<k;i++) {\n        int ai;\n        cin >> ai;\n        ai--;\n        cnts[ai]++;\n    }\n    for (int i=0;i<n;i++) {\n        add_edge(5000, i, cnts[i],0);\n    }\n    for (int it=0;it<m;it++) {\n        int u,v;\n        cin >> u >> v;\n        u--; v--;\n        for (int i=0;i<99;i++) {\n            ll cost = d;\n            for (int j=0;j<50;j++) {\n                add_edge(u+i*50, v+(i+1)*50, 1, cost);\n                add_edge(v+i*50, u+(i+1)*50, 1, cost);\n                cost+=2*d;\n            }\n        }\n    }\n    for (int i=0;i<=99;i++) {\n        add_edge(0+i*50, 5001, INF, c*i);\n    }\n\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<99;j++) {\n            add_edge(i+j*50, i+(j+1)*50, INF, 0);\n        }\n    }\n    //add_edge(0+99*50, 5001, INF, 0);\n\n    auto p = mincost_maxflow(5000, 5001);\n    assert(p.second==k);\n    cout << p.first;\n}\nint main() {\n    cin.tie(0);\n    cout.tie(0);\n    ios_base::sync_with_stdio(false);\n    cout << setprecision(20) << fixed;\n   // freopen(\"input.txt\",\"r\", stdin);\n//    int t;\n//    cin >> t;\n//    for (int i=0;i<t;i++)\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nINF = 10**9\nMOD = 10**9 + 7\nMAXN = 5007\n\nedges = []\nd = [INF] * MAXN\nphi = [INF] * MAXN\ng = [[] for _ in range(MAXN)]\npar = [0] * MAXN\n\nclass Edge:\n    def __init__(self, from_, to, cap, cost):\n        self.from_ = from_\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.flow = 0\n\ndef add_edge(u, v, cap, cost):\n    g[u].append(len(edges))\n    edges.append(Edge(u, v, cap, cost))\n    g[v].append(len(edges))\n    edges.append(Edge(v, u, 0, -cost))\n\ndef ford_bellman(s, n):\n    global phi\n    phi = [INF] * MAXN\n    phi[s] = 0\n    for _ in range(n):\n        for j in range(len(edges)):\n            if edges[j].cap == edges[j].flow:\n                continue\n            from_ = edges[j].from_\n            to = edges[j].to\n            length = edges[j].cost\n            if phi[from_] == INF:\n                continue\n            if phi[from_] + length < phi[to]:\n                phi[to] = phi[from_] + length\n\ndef dijkstra(s):\n    global d, par\n    d = [INF] * MAXN\n    d[s] = 0\n    q = [(0, s)]\n    import heapq\n    heapq.heapify(q)\n    while q:\n        dist, v = heapq.heappop(q)\n        if dist != d[v]:\n            continue\n        for i in range(len(g[v])):\n            eid = g[v][i]\n            if edges[eid].cap == edges[eid].flow:\n                continue\n            to = edges[eid].to\n            length = edges[eid].cost + phi[v] - phi[to]\n            if d[v] + length < d[to]:\n                d[to] = d[v] + length\n                par[to] = eid\n                heapq.heappush(q, (d[to], to))\n\ndef mincost_maxflow(s, t):\n    global phi\n    ford_bellman(s, 50)\n    dijkstra(s)\n    flow = 0\n    cost = 0\n    while True:\n        if d[t] == INF:\n            break\n        pushed = INF\n        sum_ = 0\n        tmp = t\n        while tmp != s:\n            eid = par[tmp]\n            pushed = min(pushed, edges[eid].cap - edges[eid].flow)\n            sum_ += edges[eid].cost\n            tmp = edges[eid].from_\n        flow += pushed\n        cost += pushed * sum_\n        tmp = t\n        while tmp != s:\n            eid = par[tmp]\n            edges[eid].flow += pushed\n            edges[eid ^ 1].flow -= pushed\n            tmp = edges[eid].from_\n        dijkstra(s)\n        for i in range(MAXN):\n            phi[i] = d[i]\n    return (cost, flow)\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    cnts = [0] * n\n    for _ in range(k):\n        ai = int(next(it)) - 1\n        cnts[ai] += 1\n    for i in range(n):\n        add_edge(5000, i, cnts[i], 0)\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for i in range(99):\n            cost = d\n            for j in range(50):\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cost)\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost)\n                cost += 2 * d\n    for i in range(100):\n        add_edge(0 + i * 50, 5001, INF, c * i)\n    for i in range(n):\n        for j in range(99):\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n    p = mincost_maxflow(5000, 5001)\n    assert p[1] == k\n    print(p[0])\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.8954097e-05, 0.0, -4.7683704e-07, -0.0019732306, -0.020175595, -0.006089467, -0.03067201, -0.31845877, -0.3153654, -1.3133469, -0.06246072, -0.00046004204, -0.014209991, -0.00012218206, -0.0031798535, -0.008096611, -0.10794341, -0.19619308, -1.9073468e-06, -3.70734e-05, -0.00023576818, -4.7683704e-07, -1.072883e-06, -0.20141402, -5.4836123e-06, -1.4305105e-06, -0.25198418, -0.038073316, -0.0012042421, -1.1920928e-07, -8.225407e-06, -0.0014666287, -0.000115626324, -0.0047299876, -1.5062602, -3.0517112e-05, -0.0019480077, -0.14784895, -3.576278e-07, -2.503392e-06, -0.07892434, -0.00071797817, 0.0, -0.00058228703, 0.0, -3.4570635e-06, -1.4305105e-06, -9.298281e-06, -1.1920928e-07, -0.0067167697, -2.3841855e-07, 0.0, -2.3841855e-07, 0.0, -6.4372807e-06, -0.0018549631, -2.3841855e-07, -3.576278e-07, -1.1920928e-07, 0.0, -1.1920928e-07, 0.0, -2.145765e-06, -6.854299e-05, -1.1920928e-07, -6.019888e-05, -0.001941345, 0.0, -0.003178784, -1.20400655e-05, -5.960463e-07, -1.1920928e-07, -6.4372807e-06, -1.6689287e-06, -0.0011147006, -0.16029783, -8.344647e-07, -1.1920922e-06, -1.4305105e-06, -0.06197344, -3.6954812e-06, 0.0, -2.3841855e-07, -1.1920928e-07, -3.576278e-07, -0.20228252, -0.26500186, -2.3841855e-07, -0.12693109, -1.1920928e-07, -1.6689287e-06, -1.1920928e-07, -0.00523577, -3.576278e-07, 0.0, -0.00020084748, -6.675698e-06, -5.841238e-06, -3.576278e-07, -3.552374