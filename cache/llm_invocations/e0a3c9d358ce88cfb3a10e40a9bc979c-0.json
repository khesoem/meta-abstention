; j <=n; j++)\n            treach[i][j] = reach[i][j];\n    for (i = 1; i <= n; i++) {\n        for (j = 1; j <= n; j++) {\n            if (treach[i][j] == val) {\n                for (k = 0; k < 4; k++) {\n                    int ni = i + dx[k];\n                    int nj = j + dy[k];\n                    if (ni > 0 && nj > 0 && ni <= n && nj <= n && treach[ni][nj] < val && scien[ni][nj] != 'Y') {\n                        reach[ni][nj] = val;\n                    }\n                }\n            }\n        }\n    }\n}\nbool canreach(int sx, int sy, int tx, int ty, int ix, int iy) {\n    memset(reach, 0, sizeof(reach));\n    reach[sx][sy] = 1;\n    reach[ix][iy] = 2;\n    int iters = 100;\n    while (iters--) {\n        expand(1);\n        if (reach[tx][ty] == 1)\n            return true;\n        expand(2);\n        if (reach[tx][ty] == 2)\n            return false; \n    }\n    return false;\n}\nint main() {\n    int infx, infy;\n    memset(shortest, 1, sizeof(shortest));\n    cin >> n >> t;\n    int i, j;\n    for (i = 1; i <= n; i++) {\n        scanf(\" %s\", scien[i] + 1);\n        for (j = 1; j <= n; j++) {\n            shortest[i][j][i][j] = 0;\n            if (scien[i][j] == 'Z') {\n                infx = i;\n                infy = j;\n            }\n        }\n    }\n    for (i = 1; i <= n; i++) {\n        scanf(\" %s\", reac[i] + 1);\n    }\n    for (i = 1; i <= n; i++) {\n        for (j = 1; j <= n; j++) {\n            for (int k = 0; k < 4; k++) {\n                int ni = i + dx[k];\n                int nj = j + dy[k];\n                if (ni <= n && ni > 0 && nj <= n && nj > 0) {\n                    if (scien[i][j] != 'Y' && scien[ni][nj] != 'Y')\n                        shortest[i][j][ni][nj] = 1;\n                }\n            }\n        }\n    }\n    int ki, kj, ii, ij, ji, jj;\n    for (ki = 1; ki <= n; ki++) {\n        for (kj = 1; kj <= n; kj++) {\n            for (ii = 1; ii <= n; ii++) {\n                for (ij = 1; ij <= n; ij++) {\n                    for (ji = 1; ji <= n; ji++) {\n                        for (jj = 1; jj <= n; jj++) {\n                            shortest[ii][ij][ji][jj] = min(\n                                    shortest[ii][ij][ji][jj], \n                                    shortest[ii][ij][ki][kj] + shortest[ki][kj][ji][jj]\n                                    );\n                        }\n                    }\n                }\n            }\n        }\n    }\n    int src = n * n * 2 + 1;\n    int dest = n * n * 2 + 2;\n    for (i = 1; i <= n; i++) {\n        for (j = 1; j <= n; j++) {\n            if (isdigit(scien[i][j])) {\n                cap[src][getnode(i, j)] = scien[i][j] - '0';\n            }\n            if (isdigit(reac[i][j])) {\n                cap[n * n + getnode(i, j)][dest] = reac[i][j] - '0';\n            }\n\n            if (isdigit(scien[i][j])) {\n                for (ki = 1; ki <= n; ki++) {\n                    for (kj = 1; kj <= n; kj++) {\n                        if (scien[i][j] > '0' && reac[ki][kj] > '0') {\n                            if (isdigit(reac[ki][kj]) && shortest[i][j][ki][kj] <= t && canreach(i, j, ki, kj, infx, infy)) {\n                                // printf(\"(%d, %d) can reach (%d, %d)\\n\", i, j, ki, kj);\n                                cap[getnode(i, j)][n * n + getnode(ki, kj)] = 1000;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    int mflow = 0, ret;\n    while ((ret = aug(src, dest, 1000))) {\n        // cout << endl;\n        mflow += ret;\n        iter ++;\n    }\n    cout << mflow << endl;\n    return 0;\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn = int(input())\nt = int(input())\n\n# Read the grid for science and reaction\nscien = [list(input().strip()) for _ in range(n)]\nreac = [list(input().strip()) for _ in range(n)]\n\n# Initialize shortest distances\nshortest = [[[[float('inf')] * n for _ in range(n)] for _ in range(n)] for _ in range(n)]\nfor i in range(n):\n    for j in range(n):\n        shortest[i][j][i][j] = 0\n\n# Directions for adjacency\ndx = [1, 0, -1, 0]\ndy = [0, 1, 0, -1]\n\n# Find the position of 'Z'\ninfx, infy = -1, -1\nfor i in range(n):\n    for j in range(n):\n        if scien[i][j] == 'Z':\n            infx, infy = i, j\n\n# Compute shortest paths (Floyd-Warshall)\nfor k in range(n):\n    for i in range(n):\n        for j in range(n):\n            for ii in range(n):\n                for jj in range(n):\n                    if shortest[i][j][ii][jj] > shortest[i][j][k][ii] + shortest[k][k][jj]:\n                        shortest[i][j][ii][jj] = shortest[i][j][k] + shortest[k][k][j]\n\n# Build capacity graph\nsize = n * n\nsrc = size * 2\ndest = size * 2 + 1\n\ncap = [[0] * (size * 2 + 2) for _ in range(size * 2 + 2)]\n\ndef getnode(x, y):\n    return x * n + y\n\n# Initialize reachability\nreach = [[0] * n for _ in range(n)]\n\ndef expand(val):\n    for i in range(n):\n        for j in range(n):\n            if reach[i][j] == val:\n                for k in range(4):\n                    ni = i + dx[k]\n                    nj = j + dy[k]\n                    if 0 <= ni < n and 0 <= nj < n:\n                        if reach[ni][nj] < val and scien[ni][nj] != 'Y':\n                            reach[ni][nj] = val\n\ndef canreach(sx, sy, tx, ty, ix, iy):\n    for i in range(n):\n        for j in range(n):\n            reach[i][j] = 0\n    reach[sx][sy] = 1\n    reach[ix][iy] = 2\n    for _ in range(100):\n        expand(1)\n        if reach[tx][ty] == 1:\n            return True\n        expand(2)\n        if reach[tx][ty] == 2:\n            return False\n    return False\n\n# Set capacities from source and to sink\nfor i in range(n):\n    for j in range(n):\n        node_in = getnode(i, j)\n        node_out = node_in + size\n        if scien[i][j].isdigit():\n            cap[src][node_in] = int(scien[i][j])\n        if reac[i][j].isdigit():\n            cap[node_out][dest] = int(reac[i][j])\n        # Connect in to out with capacity if needed\n        if scien[i][j].isdigit():\n            cap[node_in][node_out] = float('inf')\n\n# Connect nodes based on shortest paths and reachability\nfor i in range(n):\n    for j in range(n):\n        if scien[i][j].isdigit():\n            for ki in range(n):\n                for kj in range(n):\n                    if reac[ki][kj].isdigit():\n                        if int(scien[i][j]) > 0 and int(reac[ki][kj]) > 0:\n                            if shortest[i][j][ki][kj] <= t and canreach(i, j, ki, kj, infx, infy):\n                                cap[getnode(i, j) + size][getnode(ki, kj)] = 1000\n\n# Implementing Edmonds-Karp for max flow\ndef bfs(s, t, parent):\n    visited = [False] * (size * 2 + 2)\n    queue = []\n    queue.append(s)\n    visited[s] = True\n    while queue:\n        u = queue.pop(0)\n        for v in range(size * 2 + 2):\n            if not visited[v] and cap[u][v] > 0:\n                queue.append(v)\n                visited[v] = True\n                parent[v] = u\n                if v == t:\n                    return True\n    return False\n\nmax_flow = 0\nparent = [-1] * (size * 2 + 2)\nwhile bfs(src, dest, parent):\n    path_flow = float('inf')\n    s_ = dest\n    while s_ != src:\n        path_flow = min(path_flow, cap[parent[s_]][s_])\n        s_ = parent[s_]\n    max_flow += path_flow\n    v = dest\n    while v != src:\n        u = parent[v]\n        cap[u][v] -= path_flow\n        cap[v][u] += path_flow\n        v = u\n\nprint(max_flow)\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00135499844327569, -4.56102097814437e-05, -9.088346359931165e-07, -7.584239938296378e-06, -0.5944168567657471, -0.48042699694633484, -0.023472340777516365, -2.45848218582978e-06, -0.07340226322412491, -1.5048530030981055e-06, -1.72