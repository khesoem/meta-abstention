[j]<='9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        if (t<m) for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first_line = data[0].split()\n    n = int(first_line[0])\n    m = int(first_line[1])\n    lines = data[1:]\n    first_grid = [list(line.rstrip()) for line in lines[:n]]\n    second_grid = [list(line.rstrip()) for line in lines[n:2*n]]\n\n    def enc(x, y, t):\n        return x + y * n + t * n * n + 2\n\n    vn = enc(n - 1, n - 1, m) + 1\n    edge = [dict() for _ in range(vn)]\n\n    # source edges from first grid\n    for i in range(n):\n        for j in range(n):\n            c = first_grid[i][j]\n            if '1' <= c <= '9':\n                u = 0\n                v = enc(i, j, 0)\n                edge[u][v] = int(c)\n\n    buf = second_grid\n    tox = [[m + 1] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            if buf[i][j] == 'Z':\n                tox[i][j] = 0\n\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    q = deque()\n    for i in range(n):\n        for j in range(n):\n            if buf[i][j] == 'Z':\n                q.append((i, j))\n    while q:\n        i, j = q.popleft()\n        t = tox[i][j]\n        for d in range(4):\n            x = i + dx[d]\n            y = j + dy[d]\n            if 0 <= x < n and 0 <= y < n and buf[x][y] != 'Y' and t + 1 < tox[x][y]:\n                tox[x][y] = t + 1\n                q.append((x, y))\n\n    # build flow network from second grid\n    for i in range(n):\n        for j in range(n):\n            for t in range(m):\n                # edges to neighbors\n                for d in range(4):\n                    x = i + dx[d]\n                    y = j + dy[d]\n                    if 0 <= x < n and 0 <= y < n and buf[x][y] != 'Y':\n                        extra = 1 if '1' <= buf[x][y] <= '9' else 0\n                        if t + 1 < tox[x][y] + extra and t < tox[i][j]:\n                            u = enc(i, j, t)\n                            v = enc(x, y, t + 1)\n                            edge[u][v] = 1000\n                # edge to intermediate node\n                if '1' <= buf[i][j] <= '9':\n                    u = enc(i, j, t)\n                    v = enc(i, j, m)\n                    edge[u][v] = int(buf[i][j])\n            # edge from intermediate node to sink\n            if '1' <= buf[i][j] <= '9':\n                u = enc(i, j, m)\n                v = 1\n                edge[u][v] = int(buf[i][j])\n\n    def aug(s, t, cap):\n        result = 0\n        while True:\n            from_ = [-1] * vn\n            flow_ = [0] * vn\n            from_[s] = s\n            flow_[s] = cap\n            q = deque([s])\n            found = False\n            while q:\n                x = q.popleft()\n                if x == t:\n                    aug_flow = flow_[t]\n                    result += aug_flow\n                    v = t\n                    while v != s:\n                        u = from_[v]\n                        edge[u][v] -= aug_flow\n                        if edge[u][v] == 0:\n                            del edge[u][v]\n                        edge[v][u] = edge[v].get(u, 0) + aug_flow\n                        v = u\n                    found = True\n                    break\n                for nxt, cap_edge in edge[x].items():\n                    if cap_edge >= cap and from_[nxt] == -1:\n                        from_[nxt] = x\n                        flow_[nxt] = min(cap_edge, flow_[x])\n                        q.append(nxt)\n            if not found:\n                break\n        return result\n\n    res = 0\n    for cap in [8, 4, 2, 1]:\n        res += aug(0, 1, cap)\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.6954811548639555e-06, 0.0, 0.0, -0.00044955636258237064, -0.0043459730222821236, 0.0, -7.152555099310121e-07, -3.576278118089249e-07, 0.0, 0.0, -2.3841855067985307e-07, -1.0251946150674485e-05, -5.960446742392378e-06, -0.12422402948141098, -0.0015047191409394145, -3.2186455882765586e-06, -0.007292201276868582, -2.932505594799295e-05, -2.9205850296420977e-05, 0.0, -7.939023635117337e-05, -1.1920928244535389e-07, -2.1576648578047752e-05, -3.2186455882765586e-06, -5.602820692729438e-06, -1.3112935448589269e-05, -0.197221577167511, -2.1457441107486375e-05, 0.0, -0.00026127262390218675, -1.1920928244535389e-