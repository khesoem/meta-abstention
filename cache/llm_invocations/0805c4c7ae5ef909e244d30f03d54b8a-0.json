ts_vec = []\n    while temp > 0:\n        digits_vec.append(temp % k_val)\n        temp //= k_val\n    \n    A = [Matrix() for _ in range(len(digits_vec))]\n    \n    for j in range(k_val + 1):\n        A[0].data[0][j] = 1\n        A[0].data[j][j] = 1\n    \n    for i in range(1, len(digits_vec)):\n        cur = identity_matrix()\n        for j in range(k_val):\n            cur = multiply(cur, rotate_matrix(A[i-1], j))\n        A[i] = cur\n    \n    carry = 0\n    result = identity_matrix()\n    \n    for i in range(len(digits_vec) - 1, -1, -1):\n        for j in range(digits_vec[i]):\n            result = multiply(result, rotate_matrix(A[i], (j + carry) % k_val))\n        carry = (carry + digits_vec[i]) % k_val\n    \n    answer = 0\n    for i in range(k_val + 1):\n        answer = (answer + result.data[i][k_val]) % MOD\n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018499570433050394, -7.152555099310121e-07, -1.1920928244535389e-07, -0.015450075268745422, -0.00010311071673640981, -0.16027314960956573, -0.09182724356651306, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.002188194077461958, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.5152843591058627e-05, -3.4570634852570947e-06, -7.152555099310121e-07, 0.0, 0.0, -1.1920928244535389e-07, -2.3841574147809297e-05, -0.016040917485952377, -0.13536985218524933, -5.364403477869928e-06, -2.3841855067985307e-07, -1.883488948806189e-05, -0.0019327785121276975, -0.03804565966129303, -0.0010351543314754963, -2.109982233378105e-05, -1.1920922133867862e-06, -4.768370445162873e-07, -0.000262106885202229, -2.145764938177308e-06, -1.4305104514278355e-06, -3.576278118089249e-07, -5.960462772236497e-07, -8.535020606359467e-05, -2.0861407392658293e-05, -3.576272320060525e-06, 0.0, -4.768360213347478e-06, -3.421248038648628e-05, 0.0, -0.001769763883203268, -8.3446468579495