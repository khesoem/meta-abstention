1+MOD-p[j][k+3]) % MOD;\n            }\n        }\n    }\n}\n\nbool okPermutation(vi perm, int mask) {\n    int ord[3] = {0,1,2};\n    do {\n        bool ok = true;\n        for (int j = 0; j < 3; ++j) {\n            int val = perm[ord[j]];\n            int loc = val*3 + j;\n            if (!(mask & (1<<loc))) {\n                ok = false;\n                break;\n            }\n        }\n        if (ok) return true;\n    } while (next_permutation(ord, ord+3));\n    return false;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n\n    computePerms();\n\n    int n;\n    cin >> n;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> p[i][j];\n            p[i][j] = (p[i][j] * INV) % MOD;\n        }\n\n    for (int i = 0; i < 6; ++i) {\n        for (int j = n; j <= 5; ++j) {\n            if (i == j) p[i][j] = 1;\n            else { p[i][j] = 0; p[j][i] = 0; }\n        }\n    }\n    n = 6;\n\n    for (int mask = 0; mask < (1<<18); ++mask) {\n        ll prob1, prob2;\n        buildMaskProb(mask, prob1, prob2);\n        int bma = 0, bmb = 0;\n        for (int ot = 0; ot < 20; ++ot) {\n            if (okPermutation(permsA[ot], mask)) bma |= (1<<ot);\n            if (okPermutation(permsB[ot], mask)) bmb |= (1<<ot);\n        }\n        bmA[bma] = (bmA[bma] + prob1) % MOD;\n        bmB[bmb] = (bmB[bmb] + prob2) % MOD;\n    }\n\n    copy(bmA, bmA+(1<<20), f);\n    for (int i = 0; i < 20; ++i) {\n        for (int mask = 0; mask < (1<<20); ++mask) {\n            if (mask & (1<<i)) {\n                f[mask] = (f[mask] + f[mask ^ (1<<i)]) % MOD;\n            }\n        }\n    }\n\n    ll ans = 0;\n    int full = (1<<20)-1;\n    for (int i = 0; i < (1<<20); ++i) {\n        ans = (ans + bmB[i] * f[full ^ i]) % MOD;\n    }\n    cout << (1 + MOD - ans) % MOD << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples"