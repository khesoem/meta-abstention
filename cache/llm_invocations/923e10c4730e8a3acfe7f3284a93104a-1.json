{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<algorithm>\n#include<cstdio>\n#include<queue>\n#define Maxn 5500\n#define Maxm 35500\n#define INF 1000000000\nusing namespace std;\nstruct Line\n{int nxt,t,c,l;}g[Maxm];\nint fir[Maxn],tl=1;\nvoid adl(int f,int t,int c,int cost){\n  g[++tl]=(Line){fir[f],t,c,cost};fir[f]=tl;\n  g[++tl]=(Line){fir[t],f,0,-cost};fir[t]=tl;\n}\nint S,T,pre[Maxn],lp[Maxn],flow[Maxn],dis[Maxn];\nbool in[Maxn];\nqueue<int> q;\nint spfa()\n{\n  for (int i=1;i<=T;i++)\n    {dis[i]=INF;flow[i]=0;}\n  flow[S]=INF;dis[S]=0;\n  q.push(S);in[S]=1;\n  while(!q.empty()){\n    int u=q.front();\n    in[u]=0;q.pop();\n    for (int i=fir[u],v;i;i=g[i].nxt)\n      if (g[i].c&&dis[v=g[i].t]>dis[u]+g[i].l){\n        dis[v]=dis[u]+g[i].l;\n        flow[v]=min(flow[u],g[i].c);\n        lp[v]=i;pre[v]=u;\n        if (!in[v]){in[v]=1;q.push(v);}\n     }\n  }return flow[T];\n}\nint n,m,k,C,D,pl[105][105],st[105][105];\nstruct Data\n{int f,t;}s[105];\n#define P(x,y) ((x)*n+(y))\nint main()\n{\n  scanf(\"%d%d%d%d%d\",&n,&m,&k,&C,&D);\n  S=P(n+k,n)+1;T=S+2;\n  adl(P(0,1),T,INF,0);\n  for (int i=1,p;i<=k;i++){\n    scanf(\"%d\",&p);\n    adl(S,P(0,p),1,0);\n  }for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&s[i*2].f,&s[i*2].t);\n    s[i*2-1]=(Data){s[i*2].t,s[i*2].f};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      adl(P(t-1,i),P(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      adl(P(t-1,s[i].f),P(t,s[i].t),1,D);\n      pl[t][i]=tl;st[t][i]=1;\n    }adl(P(t,1),T,INF,t*C);\n  }\n  int sav,cans=0;\n  while(sav=spfa()){\n    int u=T;\n    while(u!=S){\n      int las=pre[u];\n      g[lp[u]].c-=sav;\n      g[lp[u]^1].c+=sav;\n      u=las;\n    }cans+=dis[T]*sav;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (g[pl[t][i]].c){\n          st[t][i]++;\n          adl(P(t-1,s[i].f),P(t,s[i].t),1,D*(st[t][i]*2-1));\n          pl[t][i]=tl;\n        }\n  }printf(\"%d\\n\",cans);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    C = int(data[idx]); idx += 1\n    D = int(data[idx]); idx += 1\n    \n    Maxn = 5500\n    Maxm = 35500\n    INF = 1000000000\n    \n    class Line:\n        __slots__ = ('nxt', 't', 'c', 'l')\n        def __init__(self, nxt, t, c, l):\n            self.nxt = nxt\n            self.t = t\n            self.c = c\n            self.l = l\n    \n    g = [None] * (Maxm + 10)\n    fir = [-1] * (Maxn + 10)\n    tl = [1]  # Using list to allow modification in nested function\n    \n    def adl(f, t, c, cost):\n        tl[0] += 1\n        g[tl[0]] = Line(fir[f], t, c, cost)\n        fir[f] = tl[0]\n        tl[0] += 1\n        g[tl[0]] = Line(fir[t], f, 0, -cost)\n        fir[t] = tl[0]\n    \n    def P(x, y):\n        return x * n + y\n    \n    S = P(n + k, n) + 1\n    T = S + 2\n    \n    adl(P(0, 1), T, INF, 0)\n    \n    for i in range(1, k + 1):\n        p = int(data[idx]); idx += 1\n        adl(S, P(0, p), 1, 0)\n    \n    s = [None] * (m * 2 + 10)\n    for i in range(1, m + 1):\n        f = int(data[idx]); idx += 1\n        t_val = int(data[idx]); idx += 1\n        s[i * 2] = {'f': f, 't': t_val}\n        s[i * 2 - 1] = {'f': t_val, 't': f}\n    m *= 2\n    \n    pl = [[0] * (m + 10) for _ in range(n + k + 10)]\n    st = [[0] * (m + 10) for _ in range(n + k + 10)]\n    \n    for t in range(1, n + k + 1):\n        for i in range(1, n + 1):\n            adl(P(t - 1, i), P(t, i), INF, 0)\n        for i in range(1, m + 1):\n            adl(P(t - 1, s[i]['f']), P(t, s[i]['t']), 1, D)\n            pl[t][i] = tl[0]\n            st[t][i] = 1\n        adl(P(t, 1), T, INF, t * C)\n    \n    def spfa():\n        dis = [INF] * (T + 10)\n        flow = [0] * (T + 10)\n        pre = [0] * (T + 10)\n        lp = [0] * (T + 10)\n        inq = [False] * (T + 10)\n        \n        for i in range(1, T + 1):\n            dis[i] = INF\n            flow[i] = 0\n        \n        flow[S] = INF\n        dis[S] = 0\n        q = deque()\n        q.append(S)\n        inq[S] = True\n        \n        while q:\n            u = q.popleft()\n            inq[u] = False\n            i = fir[u]\n            while i != -1:\n                edge = g[i]\n                v = edge.t\n                if edge.c > 0 and dis[v] > dis[u] + edge.l:\n                    dis[v] = dis[u] + edge.l\n                    flow[v] = min(flow[u], edge.c)\n                    lp[v] = i\n                    pre[v] = u\n                    if not inq[v]:\n                        inq[v] = True\n                        q.append(v)\n                i = edge.nxt\n        \n        return flow[T]\n    \n    cans = 0\n    while True:\n        sav = spfa()\n        if sav == 0:\n            break\n        \n        u = T\n        while u != S:\n            las = pre[u]\n            edge_idx = lp[u]\n            g[edge_idx].c -= sav\n            g[edge_idx ^ 1].c += sav\n            u = las\n        \n        cans += dis[T] * sav\n        \n        for t in range(1, n + k + 1):\n            for i in range(1, m + 1):\n                if g[pl[t][i]].c > 0:\n                    st[t][i] += 1\n                    adl(P(t - 1, s[i]['f']), P(t, s[i]['t']), 1, D * (st[t][i] * 2 - 1))\n                    pl[t][i] = tl[0]\n    \n    print(cans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-8.701899787411094e-05, -1.5497195136049413e-06, -9.536738616588991e-07, -0.00539596751332283, -0.003261249279603362, -3.576278118089249e-07, -3.7431014789035544e-05, -0.0001958416833076626, -1.9073468138230965e-06, -4.684815212385729e-05, -0.0005558376433327794, -0.24240213632583618, -0.16156746447086334, -7.795983401592821e-05, -4.6491513785440475e-06, -0.16891849040985107, -0.34301722049713135, -1.6212332411669195e-05, -5.483612312673358e-06, -0.011980482377111912, -0.0006324436399154365, -1.7881377516459906e-06, -0.00014077626110520214, -1.1920928244535389e-07, -0.004645389039069414, -1.7881377516459906e-06, -0.0013325868640094995, -7.819823804311454e-05, -0.47408196330070496, -2.3841830625315197e-06, -0.2713914215564728, -1.1920928244535389e-07, -1.6689286894688848e-06, -3.576278118089249e-07, -3.731181277544238e-05, 0.0, -3.182837463100441e-05, -0.0028054662980139256, -1.1920922133867862e-06, -1.7881377516459906e-06, -8.344646857949556e-07, -0.0011383965611457825, -0.0001134808044298552, -0.0007099968497641385, -7.152555099310121e-07, 0.0, -1.9073468138230965e-06, -1.0728830375228426e-06, -3.576278118089249e-07, -0.0007257211836986244, -1.0728830375228426e-06, -2.3841830625315197e-06, -2.264974000354414e-06, -0.00021205084340181202, -5.8412379075889476e-06, -1.9073468138230965e-06, 0.0, -6.318072337307967e-06, -2.3841830625315197e-06, -7.152555099310121e-07, -8.821448318485636e-06, -7.986990567587782e-0