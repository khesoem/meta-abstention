) {\n    if (memo[N][flag][k] != -1) {\n        return memo[N][flag][k];\n    }\n    if (N == 1) {\n        int64 res = -1;\n        if (flag) {\n            res = 0;\n        } else {\n            if (k < 0) {\n                res = 1;\n            } else {\n                res = 0;\n            }\n        }\n        memo[N][flag][k] = res;\n        return res;\n    }\n    int64 invnum_INF = (N * (N - 1)) / 2;\n    if (k < -invnum_INF - 1) {\n        memo[N][flag][k] = solve(N, -invnum_INF - 1, flag, memo);\n        return memo[N][flag][k];\n    }\n    if (k >= invnum_INF) {\n        memo[N][flag][k] = 0;\n        return 0;\n    }\n    int64 res = 0;\n    for (int64 delta = -N + 1; delta <= N; delta++) {\n        if (flag && delta > 0) {\n            continue;\n        }\n        int64 wt = min(N - delta, delta + N);\n        res += solve(N - 1, k - delta, (delta == 0 && flag), memo) * wt;\n        res %= MOD;\n    }\n    memo[N][flag][k] = res % MOD;\n    return res % MOD;\n}\n\nint main() {\n    int n, mod;\n    cin >> n >> mod;\n    vector<vector<int64>> memo(n + 1, vector<int64>(2, -1));\n    int64 ans = solve(n, 0, 1, memo) % mod;\n    cout << ans << endl;\n    return 0;\n}\n```\n\nConfidence: 0.95", "token_logprobs": [-0.8240125775337219, -0.6274453401565552, -0.2337876260280609, -0.5259969234466553, -0.043803583830595016, -0.10540908575057983, -0.002718325238674879, -0.0019571848679333925, -0.0004929326823912561, -0.8217830657958984, -0.05504375323653221, -0.035165853798389435, -0.0005107037723064423, -1.0005311965942383, -0.2521588206291199, -0.16728191077709198, -0.0003642507072072476, -1.7645819187164307, -0.16692502796649933, -0.03276035189628601, -0.000504621013533324, -0.6703124046325684, -0.6326862573623657, -0.18468628823757172, -0.0007284551975317299, -1.746312141418457, -0.18062707781791687, -0.41795459389686584, -0.0062223742716014385, -7.319718133658171e-05, -0.023336898535490036, -1.45847749710083, -0.7791181802749634, -0.00011802415974671021, -