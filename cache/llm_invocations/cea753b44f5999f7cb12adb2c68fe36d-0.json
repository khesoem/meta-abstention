                   level[to] = level[v] + 1\n                    q.append(to)\n        self.level = level\n        return level[t] >= 0\n\n    def dfs(self, v: int, t: int, f: int) -> int:\n        if v == t:\n            return f\n        while self.it[v] < len(self.graph[v]):\n            to, rev, cap = self.graph[v][self.it[v]]\n            if cap > 0 and self.level[v] + 1 == self.level[to]:\n                ret = self.dfs(to, t, min(f, cap))\n                if ret:\n                    self.graph[v][self.it[v]][2] -= ret\n                    self.graph[to][rev][2] += ret\n                    return ret\n            self.it[v] += 1\n        return 0\n\n    def max_flow(self, s: int, t: int) -> int:\n        flow = 0\n        INF = 10**9\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef main() -> None:\n    it = iter(sys.stdin.read().split())\n    n = int(next(it))\n    t = int(next(it))\n    field: List[str] = [next(it) for _ in range(n)]\n    capsule: List[str] = [next(it) for _ in range(n)]\n\n    # find zombie start\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n\n    INF = 10**9\n    dirs = [(-1,0),(1,0),(0,-1),(0,1)]\n\n    # flow network: nodes = 2*n*n + 2 (source, sink)\n    N = 2 * n * n + 2\n    src = 2 * n * n\n    sink = src + 1\n    F = Flow(N)\n\n    # add edges from capsule to sink\n    for i in range(n):\n        for j in range(n):\n            ch = capsule[i][j]\n            if ch.isdigit():\n                F.add_edge(i * n + j + n * n, sink, int(ch))\n\n    # zombie BFS (f = False) to compute Z distances\n    Z: List[List[int]] = [[INF] * n for _ in range(n)]\n    q = deque()\n    q.append((sx, sy))\n  