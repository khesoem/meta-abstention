   tb[bi] -= t1\n            tmx += t1\n        temp = max(temp, tmx)\n    print(n - temp, end=' ')\n    print(mx)\n\ndef Hey_Yashwant():\n    try:\n        t = 1\n        for i in range(t):\n            solve()\n    finally:\n        fin.close()\n        fout.close()\n        sys.stdout = original_stdout\n\nif __name__ == '__main__':\n    original_stdout = sys.stdout\n    Hey_Yashwant()\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static int[][] pairings = {\n        {0, 0}, // 1: a1 with b1\n        {0, 2}, // 2: a1 with b3\n        {1, 1}, // 3: a2 with b2\n        {1, 0}, // 4: a2 with b1\n        {2, 2}, // 5: a3 with b3\n        {2, 1}  // 6: a3 with b2\n    };\n\n    static int maxSum = 0;\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int[] a = new int[3];\n        int[] b = new int[3];\n        for (int i = 0; i < 3; i++) a[i] = sc.nextInt();\n        for (int i = 0; i < 3; i++) b[i] = sc.nextInt();\n\n        int mx = Math.min(a[0], b[1]) + Math.min(a[1], b[2]) + Math.min(a[2], b[0]);\n\n        // Generate all permutations of indices 0..5\n        boolean[] used = new boolean[6];\n        int[] perm = new int[6];\n        maxSum = 0;\n        permute(0, used, perm, a, b);\n\n        System.out.print((n - maxSum) + \" \" + mx);\n        sc.close();\n    }\n\n    static void permute(int pos, boolean[] used, int[] perm, int[] a, int[] b) {\n        if (pos == 6) {\n            // Compute sum for this permutation\n            int[] ta = a.clone();\n            int[] tb = b.clone();\n            int sum = 0;\n            for (int idx : perm) {\n                int ai = pairings[idx][0];\n                int bi = pairings[idx][1];\n                int t = Math.min(ta[ai], tb[bi]);\n                ta[ai] -= 