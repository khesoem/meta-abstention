; i++) {\n            for (int j = 1; j <= 103; j++) {\n                int x = point(j, i);\n                int y = point(j + 1, i);\n                add_edge(x, y, INF, c);\n            }\n        }\n\n        for (int i = 0; i < 102; i++) {\n            tmp = i * 50 + 1;\n            add_edge(tmp, T, INF, 0);\n        }\n\n        for (int i = 1; i <= m; i++) {\n            int u = readInt(br);\n            int v = readInt(br);\n            for (int j = 1; j <= 102; j++) {\n                int x = point(j, u);\n                int x1 = point(j + 1, u);\n                int y = point(j, v);\n                int y1 = point(j + 1, v);\n                for (int kk = 0; kk < 50; kk++) {\n                    int val = d * (kk * 2 + 1) + c;\n                    add_edge(x, y1, 1, val);\n                    add_edge(y, x1, 1, val);\n                }\n            }\n        }\n\n        int[] costRef = new int[1];\n        minCostMaxflow(S, T, costRef);\n        System.out.println(costRef[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, 0.0, 0.0, -4.339123915997334e-05, -9.97731985989958e-05, 0.0, -0.0024756519123911858, -0.20142415165901184, 0.0, 0.0, 0.0, -5.3881147323409095e-05, -1.764281842042692e-05, 0.0, -0.0033545196056365967, -0.014166505075991154, -0.0001591317413840443, -0.023288074880838394, -0.5761355757713318, -8.344646857949556e-07, -3.576278118089249e-07, 0.0, -0.2520039975643158, 0.0, 0.0, -0.0004353767435532063, -1.1920928244535389e-07, -0.0004102342063561082, -0.01825145073235035, -1.7881377516459906e-06, -0.00012575789878610522, -0.00037150635034777224, 0.0, -8.4638240878121e-06, -6.258291978156194e-05, 0.0, -1.156323378381785e-05, -0.00035613393993116915, -0.03804187476634979, 0.0, -1.6927575416048057e-05, -1.1920928244535389e-07, 0.0, -0.0003404037852305919, -0.03406202048063278, -0.004078642465174198, -2.9802276912960224e-06, -0.13394618034362793, -0.10023030638694763, -1.1920928244