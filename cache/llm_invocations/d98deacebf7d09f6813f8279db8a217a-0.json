) % d] = 1;\n        }\n        res.data[d][d] = 1;\n        return res;\n    }\n\n    static void initialize_base() {\n        for (int i = 1; i < d; i++) {\n            base[0].data[i][i] = 1;\n        }\n        base[0].data[d][0] = 1;\n        base[0].data[d][d] = 2;\n        base[0].data[0][d] = MOD - 1;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Long.parseLong(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n\n        while (n > 0) {\n            digits.add((int)(n % d));\n            n /= d;\n        }\n\n        for (int i = 0; i < 100; i++) {\n            base[i] = new Matrix();\n        }\n\n        initialize_base();\n\n        for (int i = 1; i < digits.size(); i++) {\n            base[i] = cyclic_shift(0);\n            for (int j = 0; j < d; j++) {\n                base[i] = base[i].multiply(base[i-1]).multiply(cyclic_shift(1));\n            }\n        }\n\n        Matrix ans = cyclic_shift(0);\n        for (int i = digits.size() - 1; i >= 0; i--) {\n            for (int j = 0; j < digits.get(i); j++) {\n                ans = ans.multiply(base[i]).multiply(cyclic_shift(1));\n            }\n        }\n\n        long result = (ans.data[d][d] % MOD + MOD) % MOD;\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018475732940714806, -4.768360213347478e-06, -4.768370445162873e-07, -0.0007914748275652528, -3.0517112463712692e-05, -0.0300773736089468, -0.6358592510223389, -0.0014184186002239585, -4.1483970562694594e-05, -0.00015925093612167984, -0.00024399164249189198, -0.00012206286191940308, -1.6689286894688848e-06, -5.924526340095326e-05, -0.018152887001633644, -0.00017998983094003052, -0.0054259649477899075, -0.0005026984144933522, -9.417489309271332e-06, -0.00218926463276147