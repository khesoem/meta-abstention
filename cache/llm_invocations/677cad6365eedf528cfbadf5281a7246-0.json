ic long[] invFact;\n\n    static void build(int max) {\n        fact = new long[max + 1];\n        invFact = new long[max + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= max; i++) fact[i] = fact[i - 1] * i % MOD;\n        invFact[max] = pow(fact[max], MOD - 2);\n        for (int i = max; i >= 1; i--) invFact[i - 1] = invFact[i] * i % MOD;\n    }\n\n    static long ncr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n    }\n\n    public static void main(String[] args) {\n        FastScanner in = new FastScanner();\n        int n = in.nextInt();\n        int m = in.nextInt();\n\n        build(n + m);\n\n        long phaseSize = 1;\n        long p = 1;\n        for (int i = 0; p != 0; i++) {\n            p = p * (n - i) % MOD * inv(n + m - i) % MOD;\n            phaseSize = (phaseSize + p) % MOD;\n        }\n\n        long answer = 0;\n        for (int k = 1; k <= n; k++) {\n            long numPhases = (m % MOD + k) % MOD * inv(k) % MOD;\n            long term = ncr(n, k) * numPhases % MOD * phaseSize % MOD;\n            if ((k & 1) == 1) answer = (answer + term) % MOD;\n            else answer = (answer - term + MOD) % MOD;\n        }\n\n        System.out.println(answer);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nconst long long MOD = 998244353LL;\n\nlong long pow(long long a, long long e) {\n    long long r = 1;\n    while (e > 0) {\n        if (e & 1) r = r * a % MOD;\n        a = a * a % MOD;\n        e >>= 1;\n    }\n    return r;\n}\n\nlong long inv(long long x) {\n    return pow(x, MOD - 2);\n}\n\nvector<long long> fact;\nvector<long long> invFact;\n\nvoid build(int max) {\n    fact.resize(max + 1);\n    invFact.resize(max + 1);\n    fact[0] = 1;\n    for (i