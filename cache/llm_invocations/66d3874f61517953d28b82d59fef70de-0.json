   if a >= MOD:\n        a -= MOD\n    return a\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef mat_mul(a, b):\n    n = len(a)\n    c = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            s = 0\n            for t in range(n):\n                s = add(s, mul(a[i][t], b[t][j])\n            c[i][j] = s\n    return c\n\ndef solve(n, k):\n    if n == 0:\n        print(1)\n        return\n    num = []\n    while n > 0:\n        num.append(n % k)\n        n //= k\n    m = len(num)\n    amat = [None] * m\n    ident = [[1 if i == j else 0 for j in range(k + 1)] for i in range(k + 1)]\n    amat[0] = [None] * k\n    for d in range(k):\n        mat = [row[:] for row in ident]\n        for i in range(k + 1):\n            mat[i][d] = 1\n        amat[0][d] = mat\n    for r in range(1, m):\n        pr = [ident]\n        for i in range(k):\n            pr.append(mat_mul(pr[-1], amat[r - 1][i]))\n        amat[r] = [None] * k\n        for sh in range(k):\n            mat = ident\n            for i in range(k - sh):\n                mat = mat_mul(mat, amat[r - 1][(i + sh) % k])\n            mat = mat_mul(mat, pr[sh])\n            amat[r][sh] = mat\n    dp = [[0] * (k + 1) for _ in range(k + 1)]\n    dp[0][k] = 1\n    rem = 0\n    for i in range(m - 1, -1, -1):\n        while num[i] > 0:\n            dp = mat_mul(dp, amat[i][rem])\n            rem = (rem + 1) % k\n            num[i] -= 1\n    ans = 0\n    for j in range(k + 1):\n        ans = add(ans, dp[0][j])\n    print(ans)\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    for i in range(0, len(data), 2):\n        n = data[i]\n        k = data[i + 1]\n        solve(n, k)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-7.510157047363464e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -6.115249561844394e-05, -0.004231191240251064, 0.0, -0.0002631794777698815, -1.1920928244535389e-07, -2.38418