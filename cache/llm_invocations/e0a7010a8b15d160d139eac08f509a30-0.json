(s);\n        while(!Q.empty() ) {\n            int u = Q.front(); Q.pop();\n            inq[u] = 0;\n\n            for( int i = 0 ; i < G[u].size() ; i ++ ) {\n                Edge &e = E[G[u][i]];\n                if( e.cap > e.flow && d[e.v] > d[u] + e.cost ) {\n                    d[e.v] = d[u] + e.cost;\n                    p[e.v] = G[u][i];\n                    a[e.v] = min( a[u] , e.cap - e.flow );\n\n                    if( inq[e.v ] == 0 ) {\n                        Q.push(e.v);\n                        inq[e.v] = 1;\n                    }\n                }\n            }\n        }\n\n        if( d[t] == INF ) return false;     // No augmenting Path\n        flow = a[t];\n        cost = d[t] ;               // Unit cost\n        int u = t ;\n        while( u  != s ) {\n            E[p[u]].flow += a[t];\n            E[p[u]^1].flow -= a[t];\n            u = E[p[u]].u;\n        }\n        return true;\n    }\n\n    pair<T,T> Mincost (int s, int t) {\n        this->s=s,this->t=t;\n        T Mcost = 0;\n        T Flow = 0;\n        T f = 0 ;    // For Each CaT , The flow\n        T d = 0;      // Shortest Distance / Cost Per Flow\n\n        while(BelmanFord(f,d)) {\n            Flow += f;\n            Mcost += f *d ;\n        }\n        return make_pair(Flow, Mcost);\n    }\n};\n\nint main() {\n    int n, m, k, C, D;\n    cin>>n>>m>>k>>C>>D;\n\n    MCMF solver(n*K+2);\n    int source = n*K, sink = n*K+1;\n\n    for (int i=0; i<K; i++)\n        solver.addEdge(i, sink, k, C*i);\n\n\n    for (int i=0; i<k; i++) {\n        int x;\n        cin>>x;\n        x--;\n        solver.addEdge(source, x*K, 1, 0);\n    }\n\n    for (int i=0; i<n; i++)\n        for (int j=1; j<K; j++)\n            solver.addEdge(i*K+j-1, i*K+j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin>>u>>v;\n        u--; v--;\n\n        for (int j=1; j<K; j++) {\n            int a = u*K+j-1, b = v*K+j;\n            int c = v*K+j-1, d = u*K+j;\n\n            for (int i=1, cc = D; i<=k; i++, cc += 2*D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n    auto pr = solver.Mincost(source, sink);\n    cout<<pr.second<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int maxn = 5005;\n    static final int INF = 1000000007;\n    static final int K = 100;\n\n    static class Edge {\n        int u, v;\n        long cap, flow, cost;\n\n        Edge(int u, int v, long cap, long flow, long cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static class MCMF {\n        int n, m, s, t;\n        List<Integer>[] G;\n        List<Edge> E;\n        long[] d;\n        boolean[] inq;\n        int[] p;\n        long[] a;\n\n        MCMF(int n) {\n            this.n = n;\n            G = new List[n];\n            for (int i = 0; i < n; i++) {\n                G[i] = new ArrayList<>();\n            }\n            E = new ArrayList<>();\n            d = new long[n];\n            inq = new boolean[n];\n            p = new int[n];\n            a = new long[n];\n        }\n\n        void addEdge(int u, int v, long cap, long cost) {\n            E.add(new Edge(u, v, cap, 0, cost));\n            E.add(new Edge(v, u, 0, 0, -cost));\n            m = E.size();\n            G[u].add(m - 2);\n            G[v].add(m - 1);\n        }\n\n        boolean bellmanFord(long[] flowResult, long[] costResult) {\n            for (int i = 0; i < n; i++) {\n                d[i] = INF;\n            }\n            Arrays.fill(inq, false);\n            d[s] = 0;\n            inq[s] = true;\n            p[s] = 0;\n            a[s] = INF;\n\n            Queue<Integer> Q = new LinkedList<>();\n            Q.add(s);\n\n            while (!Q.isEmpty()) {\n                int u = Q.poll();\n                inq[u] = false;\n\n                for (int i = 0; i < G[u].size(); i++) {\n                    Edge e = E.get(G[u].get(i));\n                    if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                        d[e.v] = d[u] + e.cost;\n                        p[e.v] = G[u].get(i);\n                        a[e.v] = Math.min(a[u], e.cap - e.flow);\n\n                        if (!inq[e.v]) {\n                            Q.add(e.v);\n                            inq[e.v] = true;\n                        }\n                    }\n                }\n            }\n\n            if (d[t] == INF) {\n                return false;\n            }\n\n            flowResult[0] = a[t];\n            costResult[0] = d[t];\n\n            int u = t;\n            while (u != s) {\n                E.get(p[u]).flow += a[t];\n                E.get(p[u] ^ 1).flow -= a[t];\n                u = E.get(p[u]).u;\n            }\n            return true;\n        }\n\n        long[] mincost(int s, int t) {\n            this.s = s;\n            this.t = t;\n            long Mcost = 0;\n            long Flow = 0;\n            long[] flowResult = new long[1];\n            long[] costResult = new long[1];\n\n            while (bellmanFord(flowResult, costResult)) {\n                Flow += flowResult[0];\n                Mcost += flowResult[0] * costResult[0];\n            }\n            return new long[]{Flow, Mcost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        int m = scanner.nextInt();\n        int k = scanner.nextInt();\n        int C = scanner.nextInt();\n        int D = scanner.nextInt();\n\n        MCMF solver = new MCMF(n * K + 2);\n        int source = n * K;\n        int sink = n * K + 1;\n\n        for (int i = 0; i < K; i++) {\n            solver.addEdge(i, sink, k, C * i);\n        }\n\n        for (int i = 0; i < k; i++) {\n            int x = scanner.nextInt();\n            x--;\n            solver.addEdge(source, x * K, 1, 0);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 1; j < K; j++) {\n                solver.addEdge(i * K + j - 1, i * K + j, k, 0);\n            }\n        }\n\n        while (m-- > 0) {\n            int u = scanner.nextInt();\n            int v = scanner.nextInt();\n            u--;\n            v--;\n\n            for (int j = 1; j < K; j++) {\n                int a = u * K + j - 1;\n                int b = v * K + j;\n                int c = v * K + j - 1;\n                int d = u * K + j;\n\n                for (int i = 1, cc = D; i <= k; i++, cc += 2 * D) {\n                    solver.addEdge(a, b, 1, cc);\n                    solver.addEdge(c, d, 1, cc);\n                }\n            }\n        }\n\n        long[] result = solver.mincost(source, sink);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001787979417713359, -2.145764938177308e-06, -1.5497195136049413e-06, -0.0004650464979931712, -3.576214658096433e-05, -0.06994345784187317, -0.023339783772826195, -0.0001858300092862919, -3.576278118089249e-07, -0.001754413009621203, -0.03364623337984085, -4.017272294731811e-05, -0.0035182263236492872, -0.019479289650917053, -2.253030106658116e-05, -0.0025888520758599043, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, 0.0, -1.6689286894688848e-06, -1.0728830375228426e-06, -1.6569954823353328e-05, -0.013513869605958462, -0.524032473564148, -0.03812403604388237, -7.748573807475623e-06, -0.016059452667832375, -3.576278118089249e-07, -0.026302652433514595, -1.0490362910786644e-05, 0.0, -2.50339189733495e-06, 0.0, 0.0, 0.0, -5.960462772236497e-07, -2.8967437174287625e-05, -3.814689989667386e-06, -4.291525328881107e-06, -7.152555099310121e-07, -5.245195097813848e-06, -8.344646857949556e-0