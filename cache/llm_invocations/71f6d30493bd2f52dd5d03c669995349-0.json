      return e.cost + potential[e.src] - potential[e.dst];\n    }\n    const cost_type oo = numeric_limits<cost_type>::max();\n    vector<cost_type> dist;\n    vector<edge*> back;\n    cost_type dijkstra(int source, int sink)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        using node = pair<cost_type, int>;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        dist[source] = 0;\n        pq.push({0, source});\n        while (!pq.empty())\n        {\n            auto [cost_val, cur] = pq.top(); pq.pop();\n            if (dist[cur] < cost_val) continue;\n            if (cur == sink) break;\n            for (edge &e : adj[cur])\n                if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    dist[e.dst] = dist[e.src] + rcost(e);\n                    pq.push({dist[e.dst], e.dst});\n                }\n        }\n        return dist[sink];\n    }\n    pair<flow_type, cost_type> max_flow(int source, int sink)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, oo);\n        back.assign(n, nullptr);\n        while (dijkstra(source, sink) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n                if (dist[u] < dist[sink])\n                    potential[u] += dist[u] - dist[sink];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (edge * e = back[sink]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (edge * e = back[sink]; e; e = back[e->src])\n                e->flow += f, adj[e->dst][e->rev].flow -= f;\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n,m,k,c,d,u,v;\n    cin >> n >> m >> k >> c >> d;\n    min_cost_max_flow<int,int> g((n+2)*102);\n    for(int i=0;i<102;i++)\n        g.add_edge((i*(n+2))+1,i*(n+2),100,(i*c));\n    for(int i=0;i<101;i++)\n        for(int j=0;j<n+1;j++)\n            g.add_edge(j+(i*(n+2)),j+((i+1)*(n+2)),100,0);\n    for(int i=0;i<k;i++)\n    {\n        cin >> u;\n        g.add_edge(n+1,u,1,0);\n    }\n    for(int i=0;i<m;i++)\n    {\n        cin >> u >> v;\n        for(int j=0;j<101;j++)\n            for(int f=0;f<k;f++)\n            {\n                g.add_edge(u+(j*(n+2)),v+((j+1)*(n+2)),1,((2*f)+1)*d);\n                g.add_edge(v+(j*(n+2)),u+((j+1)*(n+2)),1,((2*f)+1)*d);\n            }\n    }\n    cout << g.max_flow(n+1,(101*(n+2))).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int src, dst, rev;\n        long flow, cap;\n        long cost;\n\n        Edge(int src, int dst, int rev, long flow, long cap, long cost) {\n            this.src = src;\n            this.dst = dst;\n            this.rev = rev;\n            this.flow = flow;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int n;\n        List<List<Edge>> adj;\n        long[] potential;\n        long[] dist;\n        Edge[] back;\n        final long oo = Long.MAX_VALUE;\n\n        MinCostMaxFlow(int n) {\n            this.n = n;\n            this.adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                adj.add(new ArrayList<>());\n            }\n            this.potential = new long[n];\n            this.dist = new long[n];\n            this.back = new Edge[n];\n        }\n\n        void addEdge(int src, int dst, long cap, long cost) {\n            adj.get(src).add(new Edge(src, dst, adj.get(dst).size(), 0, cap, cost));\n            if (src == dst) {\n                adj.get(src).get(adj.get(src).size() - 1).rev++;\n            }\n            adj.get(dst).add(new Edge(dst, src, adj.get(src).size() - 1, 0, 0, -cost));\n        }\n\n        long rcost(Edge e) {\n            return e.cost + potential[e.src] - potential[e.dst];\n        }\n\n        long dijkstra(int source, int sink) {\n            Arrays.fill(dist, oo);\n            PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n            dist[source] = 0;\n            pq.offer(new long[]{0, source});\n\n            while (!pq.isEmpty()) {\n                long[] node = pq.poll();\n                long costVal = node[0];\n                int cur = (int) node[1];\n\n                if (dist[cur] < costVal) continue;\n                if (cur == sink) break;\n\n                for (Edge e : adj.get(cur)) {\n                    if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e)) {\n                        back[e.dst] = e;\n                        dist[e.dst] = dist[e.src] + rcost(e);\n                        pq.offer(new long[]{dist[e.dst], e.dst});\n                    }\n                }\n            }\n            return dist[sink];\n        }\n\n        long[] maxFlow(int source, int sink) {\n            long flow = 0;\n            long cost = 0;\n\n            for (int u = 0; u < n; u++) {\n                for (Edge e : adj.get(u)) {\n                    e.flow = 0;\n                }\n            }\n\n            Arrays.fill(potential, 0);\n            Arrays.fill(dist, oo);\n            Arrays.fill(back, null);\n\n            while (dijkstra(source, sink) < oo) {\n                for (int u = 0; u < n; u++) {\n                    if (dist[u] < dist[sink]) {\n                        potential[u] += dist[u] - dist[sink];\n                    }\n                }\n\n                long f = Long.MAX_VALUE;\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    f = Math.min(f, e.cap - e.flow);\n                }\n\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    e.flow += f;\n                    adj.get(e.dst).get(e.rev).flow -= f;\n                }\n\n                flow += f;\n                cost += f * (potential[sink] - potential[source]);\n            }\n\n            return new long[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MinCostMaxFlow g = new MinCostMaxFlow((n + 2) * 102);\n\n        for (int i = 0; i < 102; i++) {\n            g.addEdge(i * (n + 2) + 1, i * (n + 2), 100, (long) i * c);\n        }\n\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < n + 1; j++) {\n                g.addEdge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0);\n            }\n        }\n\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            g.addEdge(n + 1, u, 1, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                    g.addEdge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                }\n            }\n        }\n\n        long[] result = g.maxFlow(n + 1, 101 * (n + 2));\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018690270371735096, -4.0531076592742465e-06, -3.576278118089249e-07, -0.002644971711561084, -6.139089964563027e-05, -0.47