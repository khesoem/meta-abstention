trix[] suf = new Matrix[75];\n    static Matrix[] ans;\n\n    static void addMod(int[] x, int y, int m) {\n        // We can directly do modular addition\n        int temp = x[0] + y;\n        if (temp >= m) temp -= m;\n        x[0] = temp;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextLong();\n        K = sc.nextInt();\n\n        // Process n into array a\n        work(n);\n\n        ans = new Matrix[K + 1];\n        for (int i = 0; i <= K; i++) {\n            ans[i] = new Matrix();\n        }\n        // Initialize ans as identity\n        for (int i = 0; i <= K; i++) {\n            ans[i].v[i][i] = 1;\n        }\n\n        for (int i = 0; i < 75; i++) {\n            s[i] = new Matrix();\n            pre[i] = new Matrix();\n            suf[i] = new Matrix();\n        }\n\n        // Initialize s[0][i]\n        for (int i = 0; i < K; i++) {\n            for (int j = 0; j <= K; j++) {\n                s[0][i].v[j][j] = 1;\n                s[0][i].v[i][j] = 1;\n            }\n        }\n\n        // Build the prefix/suffix matrices\n        for (int i = 1; i <= m; i++) {\n            int idx = i - 1;\n            System.arraycopy(s[idx], 0, pre[i - 1], 0, K); // copy array\n            System.arraycopy(s[idx], 0, suf[i - 1], 0, K);\n            for (int j = 1; j < K; j++) {\n                pre[i - 1] = pre[i - 1].multiply(s[idx][j]);\n            }\n            for (int j = K - 2; j >= 0; j--) {\n                suf[i - 1] = s[idx][j].multiply(suf[i - 1]);\n            }\n            for (int j = 0; j < K; j++) {\n                if (j > 0) {\n                    s[i][j] = suf[i - 1].multiply(pre[i - 1][j - 1]);\n                } else {\n                    s[i][j] = suf[i - 1];\n                }\n            }\n        }\n\n        int now = 0;\n        for (int i = 1; i <= m; i++) {\n            int ai = a[i];\n            if (ai > 0) {\n                if (now + ai - 1 >= K) {\n                    for (int j = now; j < K; j++) {\n                        ans = ansMultiply(ans, s[m - i][j]);\n                    }\n                    for (int j = 0; j <= (now + ai - 1) - K; j++) {\n                        ans = ansMultiply(ans, s[m - i][j]);\n                    }\n                } else {\n                    for (int j = now; j <= now + ai - 1; j++) {\n                        ans = ansMultiply(ans, s[m - i][j]);\n                    }\n                }\n                now = (now + ai) % K;\n            }\n        }\n\n        int totalSum = 0;\n        for (int i = 0; i <= K; i++) {\n            totalSum += ans[i].v[i][K];\n            totalSum %= Mod;\n        }\n        System.out.println(totalSum);\n        sc.close();\n    }\n\n    static void work(long n) {\n        long tmp = n;\n        m = 0;\n        while (tmp > 0) {\n            a[++m] = (int) (tmp % K);\n            tmp /= K;\n        }\n        // reverse array a[1..m]\n        int left = 1, right = m;\n        while (left < right) {\n            int temp = a[left];\n            a[left] = a[right];\n            a[right] = temp;\n            left++;\n            right--;\n        }\n    }\n\n    static Matrix[] ansMultiply(Matrix[] matArr, Matrix mtx) {\n        Matrix[] result = new Matrix[matArr.length];\n        for (int i = 0; i < matArr.length; i++) {\n            result[i] = matArr[i].multiply(mtx);\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0003839597338810563, -7.278864359250292e-05, -2.696889623621246e-06, -7.052377623040229e-05, -1.0280383548888494e-06, 0.0, -0.001128902193158865, -4.085144996643066, -0.00012511172099038959, -3.128163257315464e-07, -0.0008153468370437622, -0.023282751441001892, -0.0014704647473990917, -0.001269993488676846, -0.001665065879933536, -0.061967797577381134, -0.004638622514903545, -0.0004903609515167773, -0.004078758880496025, -0.011081072501838207, 0.0, 0.0, -9.08834