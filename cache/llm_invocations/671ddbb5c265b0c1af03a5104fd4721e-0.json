V\n    INQ = [0] * MAX_V\n    \n    EDGES = [{'TO': 0, 'CAP': 0, 'COST': 0, 'NXT': 0} for _ in range(2000010)]\n    \n    def encode(t, v):\n        return t * N + v\n    \n    def connect(from_node, to_node, cap, cost):\n        nonlocal EIDX\n        EDGES[EIDX] = {'TO': to_node, 'CAP': cap, 'COST': cost, 'NXT': HEAD[from_node]}\n        HEAD[from_node] = EIDX\n        EIDX += 1\n        EDGES[EIDX] = {'TO': from_node, 'CAP': 0, 'COST': -cost, 'NXT': HEAD[to_node]}\n        HEAD[to_node] = EIDX\n        EIDX += 1\n    \n    def find_path(src, dst):\n        for i in range(MAX_V):\n            DIST[i] = INF\n        Q = deque()\n        Q.append(src)\n        DIST[src] = 0\n        while Q:\n            cur = Q.popleft()\n            INQ[cur] = 0\n            i = HEAD[cur]\n            while i != -1:\n                nxt = EDGES[i]['TO']\n                if EDGES[i]['CAP'] and DIST[nxt] > DIST[cur] + EDGES[i]['COST']:\n                    DIST[nxt] = DIST[cur] + EDGES[i]['COST']\n                    PREV_E[nxt] = i\n                    if not INQ[nxt]:\n                        Q.append(nxt)\n                        INQ[nxt] = 1\n                i = EDGES[i]['NXT']\n        return DIST[dst] < 1000000000\n    \n    def push_flow(src, dst):\n        nonlocal COST_SUM\n        node = dst\n        while node != src:\n            edge_idx = PREV_E[node]\n            EDGES[edge_idx]['CAP'] -= 1\n            EDGES[edge_idx ^ 1]['CAP'] += 1\n            node = EDGES[edge_idx ^ 1]['TO']\n        COST_SUM += DIST[dst]\n    \n    SOURCE = 0\n    SINK = 6000\n    \n    for i in range(1, K + 1):\n        ARR[i] = int(next(it))\n        connect(SOURCE, encode(0, ARR[i]), 1, 0)\n    \n    for i in range(1, M + 1):\n        U[i] = int(next(it))\n        V_ARR[i] = int(next(it))\n    \n    for t in range(101):\n        for i in range(2, N + 1):\n            connect(encode(t, i), encode(t + 1, i), K, C)\n        connect(encode(t, 1), SINK, K, 0)\n        for i in range(1, M + 1):\n  