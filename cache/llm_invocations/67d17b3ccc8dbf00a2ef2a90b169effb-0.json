nt(st.nextToken()) - 1;\n        }\n        \n        int sz = 0;\n        cnt = 0;\n        Arrays.fill(head, -1);\n        \n        int[][] id = new int[51][M];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < M; j++) {\n                id[i][j] = sz++;\n            }\n        }\n        \n        int s = sz;\n        int t = s + 1;\n        \n        for (int i = 0; i < K; i++) {\n            add_edge(s, id[a[i]][0], 1, 0);\n        }\n        \n        for (int i = 0; i < M; i++) {\n            add_edge(id[0][i], t, K, C * i);\n        }\n        \n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < M - 1; j++) {\n                add_edge(id[i][j], id[i][j + 1], K, 0);\n            }\n        }\n        \n        for (int i = 0; i < m; i++) {\n            int x = b[i][0];\n            int y = b[i][1];\n            for (int j = 0; j < M - 1; j++) {\n                for (int k = 0; k < K; k++) {\n                    add_edge(id[x][j], id[y][j + 1], 1, D * (2 * k + 1));\n                    add_edge(id[y][j], id[x][j + 1], 1, D * (2 * k + 1));\n                }\n            }\n        }\n        \n        int ans = min_cost_max_flow(s, t);\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019429226813372225, -3.6954811548639555e-06, -8.344646857949556e-07, -0.004146906081587076, -2.95634672511369e-05, -0.2519702613353729, -0.3132772445678711, -0.001347706071101129, -7.891343557275832e-05, -0.00014220656885299832, -0.00045944625162519515, -6.270212179515511e-05, -3.576278118089249e-07, -3.707340147229843e-05, -0.03365291655063629, -8.940656698541716e-06, -0.003694971324875951, -0.2684817314147949, -7.211902266135439e-05, -0.018983235582709312, -3.576278118089249e-07, -2.0265558760002023e-06, -1.1920928244535389e-07, -8.940656698541716e-06, 0.0, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07