pth;\n    tmp /= k;\n  }\n  \n  for (int lvl = 1; lvl <= depth; ++lvl) {\n    E[lvl][0] = E[lvl-1][0];\n    EI[lvl][0] = EI[lvl-1][0];\n    \n    for (int idx = 1; idx < k; ++idx) {\n      E[lvl][0] = mul(M[idx], E[lvl][0]);\n      EI[lvl][0] = mul(EI[lvl][0], MI[idx]);\n    }\n    \n    for (int idx = 1; idx < k; ++idx) {\n      Mat tmp1 = mul(E[lvl][idx-1], MI[idx-1]);\n      E[lvl][idx] = mul(M[idx-1], tmp1);\n      \n      Mat tmp2 = mul(EI[lvl][idx-1], MI[idx-1]);\n      EI[lvl][idx] = mul(M[idx-1], tmp2);\n    }\n  }\n}\n\nVec solve_rec(ll num, Vec v, int lvl) {\n  if (num == 0) return v;\n  int w = digit_sum_mod(num / k);\n  v = solve_rec(num / k, v, lvl + 1);\n  for (int i = 0; i < num % k; ++i)\n    v = mul(E[lvl][(w + i) % k], v);\n  return v;\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(0);\n  \n  cin >> n >> k;\n  \n  for (int i = 0; i < k; ++i) {\n    cur.a[i] = 1;\n    for (int j = 0; j < k; ++j) {\n      for (int l = 0; l < k; ++l) {\n        if (j == l) {\n          M[i].a[j][l] = 1;\n          MI[i].a[j][l] = 1;\n        } else if (j == i) {\n          M[i].a[j][l] = 1;\n          MI[i].a[j][l] = -1;\n        } else {\n          M[i].a[j][l] = 0;\n          MI[i].a[j][l] = 0;\n        }\n      }\n    }\n  }\n  \n  build_tables();\n  cur = solve_rec(n, cur, 0);\n  \n  ll total = 0;\n  for (int i = 0; i < k; ++i)\n    total = (total + cur.a[i]) % MOD;\n  total = ((total - 1) % MOD + MOD) % MOD;\n  \n  while (total % (k - 1) != 0)\n    total = (total + MOD) % (MOD * (k - 1));\n  \n  cout << total / (k - 1) << '\\n';\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef digit_sum_mod(x, k):\n    if x < k:\n        return x\n    return (x + digit_sum_mod(x // k, k)) % k\n\nclass Vec:\n    def __init__(self, init_val=0):\n        self.a = [init_val] * 30\n\nclass Mat:\n    def _