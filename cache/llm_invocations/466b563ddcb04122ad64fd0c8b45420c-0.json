\n    }\n\n    vector<long long> b;\n    long long otv = 0;\n    int limit1 = 1 << ((n / 2) + (n % 2));\n    for (int i = 0; i < limit1; ++i) {\n        long long t = 0;\n        int k = i;\n        for (int j = 0; j < 20; ++j) {\n            if (k & 1) {\n                t += a[j];\n            }\n            k >>= 1;\n        }\n        b.push_back(t % m);\n    }\n    std::sort(b.begin(), b.end());\n\n    int limit2 = 1 << (n / 2);\n    for (int i = 0; i < limit2; ++i) {\n        long long t = 0;\n        int k = i;\n        for (int j = 0; j < 20; ++j) {\n            if (k & 1) {\n                t += a[(n / 2) + (n % 2) + j];\n            }\n            k >>= 1;\n        }\n        t %= m;\n        int idx = (int)(std::lower_bound(b.begin(), b.end(), m - t - 1) - b.begin());\n        long long t2;\n        if (idx < (int)b.size()) {\n            t2 = b[idx];\n            if (t2 > m - t - 1) {\n                if (idx - 1 >= 0) {\n                    t2 = b[idx - 1];\n                }\n            }\n        } else {\n            t2 = b.back();\n        }\n        otv = max(otv, max((t + t2) % m, (t + b.back()) % m));\n    }\n    cout << otv % m << \"\\n\";\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.019603181630373, -8.41866585687967e-06, -0.07031996548175812, -2.339278580620885e-06, -6.153795766294934e-06, -1.9361264946837764e-07, -0.0017674085684120655, -9.805981972021982e-05, -1.9361264946837764e-07, 0.0, -0.001910073566250503, -5.512236498361744e-07, -1.1472419600977446e-06, -7.541112427134067e-05, -3.7697225252486533e-06, -1.6405310816480778e-05, -0.0010534112807363272, -0.012545561417937279, -1.2233183042553719e-05, -1.3856492842023727e-06, -2.5776860184123507e-06, -2.816093228830141e-06, -3.6312321753939614e-05, -6.511406809295295e-06, -2.176947600673884e-05, -4.320199877838604e-07, -0.018183303996920586, -0.6329600214958191, -2.935296834039036e-06, -1.6240566083070007e-06, 0.0, -0.018192317336797714