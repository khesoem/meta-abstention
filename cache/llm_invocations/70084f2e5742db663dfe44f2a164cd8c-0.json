{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1e9;\nconst int T = 150;\n\nstruct MinCostMaxFlow {\n    struct Edge {\n        int to, rev, cap, flow, cost;\n    };\n    int n;\n    vector<vector<Edge>> g;\n    vector<int> dist, pot, prevv, preve;\n\n    MinCostMaxFlow(int n_) : n(n_), g(n_), dist(n_), pot(n_, 0), prevv(n_), preve(n_) {}\n\n    void add_edge(int from, int to, int cap, int cost) {\n        g[from].push_back({to, (int)g[to].size(), cap, 0, cost});\n        g[to].push_back({from, (int)g[from].size() - 1, 0, 0, -cost});\n    }\n\n    pair<int, int> min_cost_flow(int s, int t) {\n        int flow = 0, flow_cost = 0;\n        while (true) {\n            fill(dist.begin(), dist.end(), INF);\n            dist[s] = 0;\n            priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n            pq.push({0, s});\n\n            while (!pq.empty()) {\n                pair<int, int> cur = pq.top();\n                pq.pop();\n                int d = cur.first;\n                int v = cur.second;\n                if (d != dist[v]) continue;\n\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap - e.flow <= 0) continue;\n\n                    int nd = d + e.cost + pot[v] - pot[e.to];\n                    if (nd < dist[e.to]) {\n                        dist[e.to] = nd;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        pq.push({nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n            int add = INF - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                add = min(add, e.cap - e.flow);\n            }\n\n            flow += add;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.flow += add;\n                g[v][e.rev].flow -= add;\n                flow_cost += add * e.cost;\n            }\n        }\n        return {flow, flow_cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MinCostMaxFlow mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    pair<int, int> ans = mcf.min_cost_flow(N, N + 1);\n    assert(ans.first == k);\n    cout << ans.second << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int INF = 1_000_000_000;\n    static final int T = 150;\n\n    static class MinCostMaxFlow {\n        static class Edge {\n            int to, rev, cap, flow, cost;\n            Edge(int to, int rev, int cap, int flow, int cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.flow = flow;\n                this.cost = cost;\n            }\n        }\n\n        int n;\n        List<List<Edge>> g;\n        int[] dist, pot, prevv, preve;\n\n        MinCostMaxFlow(int n_) {\n            n = n_;\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) g.add(new ArrayList<>());\n            dist = new int[n];\n            pot = new int[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void add_edge(int from, int to, int cap, int cost) {\n            g.get(from).add(new Edge(to, g.get(to).size(), cap, 0, cost));\n            g.get(to).add(new Edge(from, g.get(from).size() - 1, 0, 0, -cost));\n        }\n\n        int[] min_cost_flow(int s, int t) {\n            int flow = 0, flow_cost = 0;\n            while (true) {\n                Arrays.fill(dist, INF);\n                dist[s] = 0;\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                pq.offer(new int[]{0, s});\n\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int d = cur[0];\n                    int v = cur[1];\n                    if (d != dist[v]) continue;\n\n                    for (int i = 0; i < g.get(v).size(); i++) {\n                        Edge e = g.get(v).get(i);\n                        if (e.cap - e.flow <= 0) continue;\n\n                        int nd = d + e.cost + pot[v] - pot[e.to];\n                        if (nd < dist[e.to]) {\n                            dist[e.to] = nd;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.offer(new int[]{nd, e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] == INF) break;\n\n                for (int i = 0; i < n; i++) pot[i] += dist[i];\n\n                int add = INF - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    add = Math.min(add, e.cap - e.flow);\n                }\n\n                flow += add;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.flow += add;\n                    g.get(v).get(e.rev).flow -= add;\n                    flow_cost += add * e.cost;\n                }\n            }\n            return new int[]{flow, flow_cost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int N = n * T;\n        MinCostMaxFlow mcf = new MinCostMaxFlow(N + 2);\n\n        // stay edges\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        // edges to sink from first T nodes (node 0 at all times)\n        for (int i = 0; i < T; i++) {\n            mcf.add_edge(i, N + 1, INF, 0);\n        }\n\n        // initial robots\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            mcf.add_edge(N, x * T, 1, 0);\n        }\n\n        // movement edges\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j < T - 1; j++) {\n                int cur = 1;\n                for (int z = 0; z < k; z++) {\n                    mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                    mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        int[] ans = mcf.min_cost_flow(N, N + 1);\n        // assert ans[0] == k; // optional, but we can check\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002644904307089746, -2.3841855067985307e-07, 0.0, -6.425174069590867e-05, -0.00022742546570952982, 0.0, -0.2519291341304779, -0.006727308500558138, -3.576278118089249e-07, 0.0, -1.6331539882230572e-05, -0.00034254882484674454, -0.0015231685247272253, 0.0, -0.0003420721332076937, -0.006735597271472216, -0.00043096792069263756, -0.012593978084623814, -0.038062069565057755, -1.2993727978027891e-05, -3.576278118089249e-07, 0.0, -0.03804256021976471, -0.3868718147277832, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.0011431594612076879, -3.576278118089249e-07, 0.0, 0.0, 0.0, -8