            dp[nx][ny][nz] = (dp[nx][ny][nz] + dp[x][y][z] * nCr[rem_x][i] % MOD * nCr[rem_y][j]) % MOD\n        else:\n            rem_x = x\n            rem_y = y\n            for i in range(rem_x + 1):\n                for j in range(rem_y + 1):\n                    if i + j == 0:\n                        continue\n                    if i * 50 + j * 100 > K:\n                        break\n                    nx, ny, nz = x - i, y - j, z ^ 1\n                    if dist[nx][ny][nz] >= d + 1:\n                        if dist[nx][ny][nz] > d + 1:\n                            dist[nx][ny][nz] = d + 1\n                            queue.append((nx, ny, nz))\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + dp[x][y][z] * nCr[rem_x][i] % MOD * nCr[rem_y][j]) % MOD\n                        else:\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + dp[x][y][z] * nCr[rem_x][i] % MOD * nCr[rem_y][j]) % MOD\n    \n    if dist[cnt1][cnt2][1] == INF:\n        print(-1)\n        print(0)\n    else:\n        print(dist[cnt1][cnt2][1])\n        print(dp[cnt1][cnt2][1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.103329360485077e-05, -1.0728830375228426e-06, -3.576278118089249e-07, -0.001166140311397612, -0.0026223815511912107, -6.949660019017756e-05, -0.014220803044736385, -0.00020632999076042324, -5.960462772236497e-07, -9.440929716220126e-05, -0.00043025295599363744, -0.6446696519851685, -4.768370445162873e-07, -5.483612312673358e-06, 0.0, -1.1920928244535389e-07, -0.0004314445541240275, 0.0, -5.125986263010418e-06, 0.0, -2.3841855067985307e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -0.34844860434532166, -8.77341881277971e-05, -9.179073458653875e-06, -0.47757723927497864, 0.0, -0.0001532914029667154, -3.2305197237292305e-05, 0.0, 0.0, -0.00020358874462544918, 0.0, 0.0, -2.2291887944447808e-05, -0.28913694620132446, -0.4055480659008026, -8.9