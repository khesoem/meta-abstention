<int[][]> dp = new ArrayList<>(maxDepth);\n        // initial level\n        int[][] init = new int[k + 1][k + 1];\n        for (int i = 0; i <= k; ++i) {\n            for (int j = 0; j <= k; ++j) {\n                init[i][j] = (i == j || j == 0) ? 1 : 0;\n            }\n        }\n        dp.add(init);\n\n        // identity matrix\n        int[][] e = new int[k + 1][k + 1];\n        for (int i = 0; i <= k; ++i) {\n            e[i][i] = 1;\n        }\n\n        for (int depth = 1; depth < maxDepth; ++depth) {\n            int[][] cur = new int[k + 1][k + 1];\n            for (int i = 0; i <= k; ++i) {\n                System.arraycopy(e[i], 0, cur[i], 0, k + 1);\n            }\n            int[][] bs = dp.get(depth - 1);\n            int curx = k;\n            for (int i = 0; (1 << i) <= curx; ++i) {\n                if ((curx & (1 << i)) != 0) {\n                    cur = multiply(bs, shift(cur, 1 << i));\n                    curx ^= (1 << i);\n                }\n                bs = multiply(bs, shift(bs, 1 << i));\n            }\n            dp.add(cur);\n        }\n\n        int[][] base = new int[1][k + 1];\n        base[0][k] = 1;\n\n        int sl = 0;\n        long x = n;\n        List<Integer> vec = new ArrayList<>();\n        while (x != 0) {\n            vec.add((int)(x % k));\n            x /= k;\n        }\n        int len = vec.size();\n        for (int curDepth = len - 1; curDepth >= 0; --curDepth) {\n            int rest = vec.get(curDepth);\n            for (int it = 0; it < rest; ++it, sl = (sl + 1) % k) {\n                base = multiply(base, shift(dp.get(curDepth), sl));\n            }\n        }\n\n        int res = 0;\n        for (int i = 0; i <= k; ++i) {\n            res = (res + base[0][i]) % MOD;\n        }\n        System.out.println(res);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -3.0397906812140718e-05, -0.0007130940794013441, 0.0, -0.003190667135640979, -0.4421297609806061, 