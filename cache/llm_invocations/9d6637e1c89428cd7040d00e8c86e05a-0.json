N]; int sz[N]; ll mc;\n  void init(int n=N) { mc=0; fill(sz,sz+n,0); fill(adj,adj+n,vector<Edge>()); }\n  void add_edge(int a, int b, ll c=1, ll p=0) { mc = max(mc,c);\n    adj[a].push_back({b, sz[b]++, 0, c, p});\n    adj[b].push_back({a, sz[a]++, 0, 0, -p}); }\n\n  bool vis[N]; int par[N]; ll pot[N], dist[N];\n  void pot_init(int n) { fill(pot, pot+n, 0);\n    for(int i=1; i<n; i++) for(int u=0; u<n; u++) for(const Edge& e:adj[u])\n      if(e.c) pot[e.v] = min(pot[e.v], pot[u] + e.p); }\n  ll mcf(int s, int t, ll& price, int n, bool sparse, ll lb=1) {\n    fill(vis, vis+n, 0); fill(dist, dist+n, INF); dist[s] = 0;\n    if(sparse) {\n      priority_queue<pair<ll,int>> dk; dk.push({0,s}); while(!dk.empty()) {\n        int u = dk.top().second; dk.pop(); if(vis[u]) continue;\n        for(const Edge& e:adj[u]) {\n          if (e.f <= e.c-lb && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r;\n            dk.push({-dist[e.v], e.v}); } } }\n    } else {\n      for(int u = s; u != -1; ) { vis[u] = true; for(const Edge& e: adj[u]) {\n        if (e.f <= e.c-lb && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n          dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r; } }\n      u = -1; ll best = INF;\n      for(int i=0; i<n; i++) if(!vis[i] && dist[i]<best) best = dist[u=i]; }\n    }\n    if (dist[t] >= INF) { return 0; } ll df = INF;\n    for(int u = t; u != s; ) { const Edge& r = adj[u][par[u]];\n      df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f); u = r.v; }\n    for(int u = t; u != s; ) { Edge& r=adj[u][par[u]], &e=adj[r.v][r.r];\n      e.f += df; r.f -= df; price += df*e.p; u = r.v; }\n    for(int i=0; i<n; i++) { pot[i] = min(INF, dist[i]+pot[i]); } return df; }\n  ll min_cost_flow(int s, int t, ll& price, int n=N, bool sparse=false) {\n    pot_init(n); ll flow = price = 0;\n\t\tfor(ll lb=1<<30;lb>0;lb/=2) {\n\t\t\twhile(ll df=mcf(s, t, price, n, sparse, lb)) { flow += df; }\n\t\t} return flow; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int S = 0;\n\tconst int Tn = n*T+1;\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(S, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, Tn, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tll price, flow = Flow::min_cost_flow(S, Tn, price, Tn+1, true);\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\nimport math\n\nINF = 10**18\n\nclass Flow:\n    def __init__(self, N):\n        self.N = N\n        self.adj = [[] for _ in range(N)]\n        self.sz = [0]*N\n        self.mc = 0\n\n    def add_edge(self, a, b, c=1, p=0):\n        self.mc = max(self.mc, c)\n        self.adj[a].append([b, self.sz[b], 0, c, p])\n        self.adj[b].append([a, self.sz[a], 0, 0, -p])\n        self.sz[a] += 1\n        self.sz[b] += 1\n\n    def pot_init(self, n):\n        self.pot = [0]*n\n        for _ in range(1, n):\n            for u in range(n):\n                for e in self.adj[u]:\n                    if e[3] > 0:  # e.c > 0\n                        if self.pot[e[0]] > self.pot[u] + e[4]:\n                            self.pot[e[0]] = self.pot[u] + e[4]\n\n    def mcf(self, s, t, price, n, sparse, lb=1):\n        vis = [False]*n\n        dist = [INF]*n\n        dist[s] = 0\n        par = [0]*n\n        if sparse:\n            pq = [(0, s)]\n            while pq:\n                d, u = heapq.heappop(pq)\n                if vis[u]:\n                    continue\n                vis[u] = True\n                for e in self.adj[u]:\n                    if e[2] <= e[3] - lb:  # e.f <= e.c - lb\n                        nd = d + self.pot[u] - self.pot[e[0]] + e[4]\n                        if dist[e[0]] > nd:\n                            dist[e[0]] = nd\n                            par[e[0]] = e[1]  # e.r\n                            heapq.heappush(pq, (nd, e[0]))\n        else:\n            u = s\n            while u != -1:\n                vis[u] = True\n                for e in self.adj[u]:\n                    if e[2] <= e[3] - lb:\n                        nd = dist[u] + self.pot[u] - self.pot[e[0]] + e[4]\n                        if dist[e[0]] > nd:\n                            dist[e[0]] = nd\n                            par[e[0]] = e[1]\n                u = -1\n                best = INF\n                for i in range(n):\n                    if not vis[i] and dist[i] < best:\n                        best = dist[i]\n                        u = i\n        if dist[t] >= INF:\n            return 0\n        df = INF\n        u = t\n        while u != s:\n            r = self.adj[u][par[u]]\n            df = min(df, self.adj[r[0]][r[1]][3] - self.adj[r[0]][r[1]][2])\n            u = r[0]\n        u = t\n        while u != s:\n            r = self.adj[u][par[u]]\n            e = self.adj[r[0]][r[1]]\n            e[2] += df\n            r[2] -= df\n            price += df * e[4]\n            u = r[0]\n        for i in range(n):\n            self.pot[i] = min(INF, dist[i] + self.pot[i])\n        return df\n\n    def min_cost_flow(self, s, t, n, sparse=False):\n        self.pot_init(n)\n        flow = 0\n        price = 0\n        lb = 1 << 30\n        while lb > 0:\n            while True:\n                df = self.mcf(s, t, price, n, sparse, lb)\n                if df == 0:\n                    break\n                flow += df\n            lb //= 2\n        return flow, price\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    T = 99\n    C = 12\n    S = 0\n    Tn = n * T + 1\n\n    flow = Flow(Tn + 1)\n\n    for _ in range(k):\n        a = int(next(it))\n        flow.add_edge(S, a, 1, 0)\n\n    for t in range(T):\n        flow.add_edge(1 + t * n, Tn, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    flow_amt, price = flow.min_cost_flow(S, Tn, Tn + 1, sparse=True)\n    # assert flow_amt == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.2066785934148356e-05, 0.0, 0.0, -0.0007871866691857576, -0.0032103925477713346, -6.794906312279636e-06, -0.00862149428576231, -0.0009136793087236583, -0.07896410673856735, -0.25219178199768066, -0.4027431309223175, -0.0008263748604804277, -0.06197534501552582, -0.08554801344871521, -0.00014375607133843005, -0.0001599660754436627, -1.6212332411669195e-05, -0.0015023384476080537, -0.0009818024700507522, -0.1282816231250763, -0.001811888418160379, -0.025003299117088318, -0.0011456600623205304, -1.311301275563892e-06, -0.5116651654243469, -4.172316494077677e-06, 0.0, -1.1920928244535389e-07, 0.0, -0.038043249398469925, -0.5241053700447083, -0.3825087249279022, 0.0, -1.1920922133867862e-06, -7.86750388215296e-05, -2.980227