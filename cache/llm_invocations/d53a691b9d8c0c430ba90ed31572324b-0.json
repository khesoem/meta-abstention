long c, long w, int r) {\n                this.v = v;\n                this.c = c;\n                this.w = w;\n                this.r = r;\n            }\n        }\n\n        ArrayList<ArrayList<Edge>> G;\n\n        MinCostFlow(int n) {\n            G = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                G.add(new ArrayList<>());\n            }\n        }\n\n        void add(int u, int v, long c, long w) {\n            int i = G.get(u).size();\n            int j = G.get(v).size();\n            G.get(u).add(new Edge(v, c, w, j));\n            G.get(v).add(new Edge(u, 0, -w, i));\n        }\n\n        long run(int s, int t, long f) {\n            int N = G.size();\n            long res = 0;\n            long[] H = new long[N];\n            long[] D = new long[N];\n            final long INF = Long.MAX_VALUE / 2;\n            int[] PE = new int[N];\n            int[] PV = new int[N];\n            while (f > 0) {\n                PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n                Arrays.fill(D, INF);\n                D[s] = 0;\n                pq.offer(new long[]{0, s});\n                while (!pq.isEmpty()) {\n                    long[] cur = pq.poll();\n                    long d = cur[0];\n                    int u = (int) cur[1];\n                    if (D[u] < d) continue;\n                    for (int i = 0; i < G.get(u).size(); i++) {\n                        Edge e = G.get(u).get(i);\n                        if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n                            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n                            pq.offer(new long[]{D[e.v], e.v});\n                            PV[e.v] = u;\n                            PE[e.v] = i;\n                        }\n                    }\n                }\n                if (D[t] == INF) return -1;\n                for (int i = 0; i < N; i++) {\n                    H[i] += D[i];\n                