initeField') -> 'FiniteField':\n        result = FiniteField(self.x)\n        result += other\n        return result\n\n    def __sub__(self, other: 'FiniteField') -> 'FiniteField':\n        result = FiniteField(self.x)\n        result -= other\n        return result\n\n    def __mul__(self, other: 'FiniteField') -> 'FiniteField':\n        result = FiniteField(self.x)\n        result *= other\n        return result\n\n    def __truediv__(self, other: 'FiniteField') -> 'FiniteField':\n        result = FiniteField(self.x)\n        result /= other\n        return result\n\n    def __iadd__(self, other: 'FiniteField'):\n        self.x = (self.x + other.x) % 1000000007\n\n    def __isub__(self, other: 'FiniteField'):\n        self.x = (self.x + 1000000007 - other.x) % 1000000007\n\n    def __imul__(self, other: 'FiniteField'):\n        self.x = (self.x * other.x) % 1000000007\n\n    def __itruediv__(self, other: 'FiniteField'):\n        p = 1000000007 - 2\n        while p:\n            if p % 2:\n                self *= other\n            other *= other\n            p //= 2\n\ndef matrix_multiply(a: List[List[int]], b: List[List[int]]) -> List[List[int]]:\n    n = len(a)\n    m = len(a[0])\n    if len(b) != m:\n        print(\"Matrix dimensions don't match for multiplication!\")\n        sys.exit(1)\n    l = len(b[0])\n    result = [[0 for _ in range(l)] for _ in range(n)]\n    for i in range(n):\n        for j in range(l):\n            for k in range(m):\n                result[i][j] += a[i][k] * b[k][j]\n    return result\n\ndef matrix_multiply_vector(matrix: List[List[int]], vector: List[int]) -> List[int]:\n    n = len(matrix)\n    m = len(matrix[0])\n    if len(vector) != m:\n        print(\"Matrix and vector dimensions don't match for multiplication!\")\n        sys.exit(1)\n    result = [0 for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            result[i] += matrix[i][j] * vector[j]\n    return result\n\ndef make_2d_vector(d1: int, d2: int, default_value: int) -> List[List[int]]:\n    return [[default_value for _ in range(d2)] for _ in range(d1)]\n\ndef make_3d_vector(d1: int, d2: int, d3: int, default_value: int) -> List[List[List[int]]]:\n    return [[[default_value for _ in range(d3)] for _ in range(d2)] for _ in range(d1)]\n\n@lru_cache(maxsize=None)\ndef find_matrix(p: int) -> List[List[FiniteField]]:\n    if p <= d:\n        matrix = [[FiniteField(1) if i == j else FiniteField(0) for j in range(d + 1)] for i in range(d + 1)]\n        for k in range(p):\n            matrix = matrix_multiply(units[k], matrix)\n        return matrix\n    child_p = d\n    while (p + child_p - 1) // child_p > d:\n        child_p *= d\n    child = find_matrix(child_p)\n    matrix = child\n    remaining_p = p\n    remaining_p -= child_p\n    for k in range(1, d):\n        if remaining_p >= child_p:\n            matrix = matrix_multiply(shifts[d - k], child, shifts[k], matrix)\n            remaining_p -= child_p\n        elif remaining_p > 0:\n            matrix = matrix_multiply(shifts[d - k], find_matrix(remaining_p), shifts[k], matrix)\n            remaining_p = 0\n        else:\n            break\n    return matrix\n\ndef main():\n    global d\n    n = int(input())\n    d = int(input())\n\n    shifts = make_3d_vector(d, d + 1, d + 1, 0)\n    for k in range(d):\n        for i in range(d):\n            shifts[k][i][(i + k) % d] = FiniteField(1)\n    shifts[d][d] = FiniteField(1)\n\n    units = make_3d_vector(d, d + 1, d + 1, 0)\n    for k in range(d):\n        for i in range(d + 1):\n            units[k][i][i] = FiniteField(1)\n        for i in range(d + 1):\n            units[k][k][i] = FiniteField(1)\n\n    identity = make_2d_vector(d + 1, d + 1, 0)\n    for i in range(d + 1):\n        identity[i][i] = FiniteField(1)\n\n    matrix = find_matrix(n)\n    final_vector = matrix_multiply(matrix, [FiniteField(0) if i != d else FiniteField(1) for i in range(d + 1)])\n    ans = FiniteField(0)\n    for x in final_vector:\