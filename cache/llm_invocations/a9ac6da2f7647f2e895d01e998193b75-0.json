riginal_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport collections\n\ndef solve():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    n = int(first[0])\n    t = int(first[1])\n    a = [list(line.rstrip()) for line in data[1:1+n]]\n    b = [list(line.rstrip()) for line in data[1+n:1+2*n]]\n\n    INF = 10**9\n    # distance to nearest 'Z'\n    Dis = [[INF]*n for _ in range(n)]\n    q = collections.deque()\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                Dis[i][j] = 0\n                q.append((i,j))\n    dirs = [(-1,0),(1,0),(0,-1),(0,1)]\n    while q:\n        x,y = q.popleft()\n        for dx,dy in dirs:\n            nx,ny = x+dx, y+dy\n            if 0 <= nx < n and 0 <= ny < n and '0' <= a[nx][ny] <= '9':\n                if Dis[nx][ny] > Dis[x][y] + 1:\n                    Dis[nx][ny] = Dis[x][y] + 1\n                    q.append((nx,ny))\n\n    # node mapping\n    source = 0\n    sink = 1\n    def src_node(i,j):\n        return 2 + i*n + j\n    def sink_node(i,j):\n        return 2 + n*n + i*n + j\n    N = 2 + 2*n*n\n    graph = [[] for _ in range(N)]\n\n    def add_edge(u,v,cap):\n        graph[u].append([v, len(graph[v]), cap])\n        graph[v].append([u, len(graph[u])-1, 0])\n\n    # source to source-side nodes\n    for i in range(n):\n        for j in range(n):\n            if '0' <= a[i][j] <= '9':\n                add_edge(source, src_node(i,j), int(a[i][j]))\n\n    # sink-side nodes to sink\n    for i in range(n):\n        for j in range(n):\n            if '0' <= b[i][j] <= '9':\n                add_edge(sink_node(i,j), sink, int(b[i][j]))\n\n    # BFS from each source cell and add edges\n    for si in range(n):\n        for sj in range(n):\n            if not ('0' <= a[si][sj] <= '9'):\n                continue\n            dist = [[INF]*n for _ in range(n)]\n            dist[si][sj] = 0\n            q = collections.deque()\n            q.append((si,sj))\n            while q:\n                x,y = q.popleft()\n                d = dist[x][y]\n                if d >= Dis[x][y]:\n                    continue\n                for dx,dy in dirs:\n                    nx,ny = x+dx, y+dy\n                    if 0 <= nx < n and 0 <= ny < n and '0' <= a[nx][ny] <= '9':\n                        if dist[nx][ny] > d + 1:\n                            dist[nx][ny] = d + 1\n                            q.append((nx,ny))\n            for ti in range(n):\n                for tj in range(n):\n                    if '0' <= a[ti][tj] <= '9':\n                        if dist[ti][tj] <= min(Dis[ti][tj], t):\n                            add_edge(src_node(si,sj), sink_node(ti,tj), 10000)\n\n    # Dinic\n    level = [-1]*N\n    it = [0]*N\n\n    def bfs():\n        for i in range(N):\n            level[i] = -1\n        q = collections.deque()\n        level[source] = 0\n        q.append(source)\n        while q:\n            v = q.popleft()\n            for e in graph[v]:\n                if e[2] > 0 and level[e[0]] < 0:\n                    level[e[0]] = level[v] + 1\n                    q.append(e[0])\n        return level[sink] >= 0\n\n    def dfs(v, f):\n        if v == sink:\n            return f\n        for i in range(it[v], len(graph[v])):\n            it[v] = i\n            e = graph[v][i]\n            if e[2] > 0 and level[v] < level[e[0]]:\n                ret = dfs(e[0], min(f, e[2]))\n                if ret:\n                    e[2] -= ret\n                    graph[e[0]][e[1]][2] += ret\n                    return ret\n        return 0\n\n    flow = 0\n    while bfs():\n        for i in range(N):\n            it[i] = 0\n        while True:\n            pushed = dfs(source, INF)\n            if not pushed:\n                break\n            flow += pushed\n    print(flow)\n\nif __name__ ==