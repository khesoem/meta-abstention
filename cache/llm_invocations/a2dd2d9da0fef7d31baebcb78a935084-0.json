\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = Mod998()\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_stream, out):\n        self.n = int(next_token(in_stream))\n        self.m = int(next_token(in_stream))\n        self.mod.precomputeFactorials(self.n + self.m + 1)\n\n        phaseSize = 1\n        p = 1\n        for i in range(self.n + 1):\n            if p == 0:\n                break\n            numerator = self.mod.mul(self.n - i, self.mod.modInv(self.n + self.m - i))\n            p = self.mod.mul(p, numerator)\n            phaseSize = self.mod.add(phaseSize, p)\n\n        answer = 0\n        for k in range(1, self.n + 1):\n            numPhases = self.mod.mul(self.m + k, self.mod.modInv(k))\n            e = self.mod.mul(numPhases, phaseSize)\n            term = self.mod.mul(self.mod.ncr(self.n, k), e)\n\n            if (k & 1) == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.sub(answer, term)\n\n        out.println(answer)\n\n\ndef next_token(stream):\n    while True:\n        line = stream.readline()\n        if not line:\n            raise StopIteration()\n        tokens = line.strip().split()\n        for token in tokens:\n            yield token\n\n\nclass InputReader:\n    def __init__(self, stream):\n        self.stream = stream\n        self.token_gen = next_token(stream)\n\n    def next(self):\n        return next(self.token_gen)\n\n    def nextInt(self):\n        return int(self.next())\n\n\nclass PrintWriter:\n    def __init__(self, stream):\n        self.stream = stream\n\n    def println(self, obj):\n        self.stream.write(str(obj) + '\\n')\n        self.stream.flush()\n\n\ndef main():\n    solver = HZSShufflesCards()\n    in_reader = InputReader(sys.stdin)\n    out_writer = PrintWriter(sys.stdout)\n    solver.solve(1, in_reader, out_writer)\n    out_writer.stream.close()\n\n\nif __name__ == \"__main__\":\n    main()\n</trans