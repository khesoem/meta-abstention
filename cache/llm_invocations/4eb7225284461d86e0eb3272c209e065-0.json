ode>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nclass Mod998:\n    def __init__(self):\n        self.modulus_val = 998244353\n        self.factorial = [1]\n        self.invFactorial = [1]\n    \n    def modulus(self):\n        return self.modulus_val\n    \n    def fact(self, n):\n        while len(self.factorial) <= n:\n            next_val = self.mult(self.factorial[-1], len(self.factorial))\n            self.factorial.append(next_val)\n        return self.factorial[n]\n    \n    def fInv(self, n):\n        last_known = len(self.invFactorial) - 1\n        if last_known < n:\n            f_inv = [0] * (n - last_known)\n            f_inv[0] = self.inv(self.fact(n))\n            for i in range(1, len(f_inv)):\n                f_inv[i] = self.mult(f_inv[i-1], n - i + 1)\n            for i in range(len(f_inv) - 1, -1, -1):\n                self.invFactorial.append(int(f_inv[i]))\n        return self.invFactorial[n]\n    \n    def ncr(self, n, r):\n        if r < 0 or n < r:\n            return 0\n        return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n    \n    def smallInv(self, n):\n        return self.mult(self.fInv(n), self.fact(n - 1))\n    \n    def normalize(self, x):\n        x %= self.modulus_val\n        return x if x >= 0 else x + self.modulus_val\n    \n    def add(self, a, b):\n        v = a + b\n        return v if v < self.modulus_val else v - self.modulus_val\n    \n    def subtract(self, a, b):\n        v = a - b\n        return v if v >= 0 else v + self.modulus_val\n    \n    def mult(self, *args):\n        r = 1\n        for v in args:\n            r = self.mult_two(r, v)\n        return r\n    \n    def mult_two(self, a, b):\n        return (a * b) % self.modulus_val\n    \n    def inv(self, value):\n        g, x, y = self.modulus_val, 0, 1\n        r = value\n        while r != 0:\n            q = g // r\n            g, r = r, g % r\n            x, y = y, x - q * y\n        return self.normalize(x)\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = Mod998()\n    \n    def solve(self, testNumber, in_stream, out):\n        line = in_stream.readline().strip()\n        parts = line.split()\n        n = int(parts[0])\n        m = int(parts[1])\n        \n        phaseSize = 1\n        p = 1\n        i = 0\n        while p != 0:\n            numerator = (n - i) % self.mod.modulus()\n            denominator = (n + m - i) % self.mod.modulus()\n            p = self.mod.mult(p, self.mod.mult(numerator, self.mod.inv(denominator)))\n            phaseSize = self.mod.add(phaseSize, p)\n            i += 1\n        \n        answer = 0\n        for k in range(1, n + 1):\n            numPhases = self.mod.mult((m + k) % self.mod.modulus(), self.mod.inv(k))\n            comb = self.mod.ncr(n, k)\n            term = self.mod.mult(comb, self.mod.mult(numPhases, phaseSize))\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n        \n        out.println(answer)\n\n\nclass PrintWriter:\n    def __init__(self, out_stream):\n        self.out_stream = out_stream\n    \n    def println(self, value):\n        self.out_stream.write(str(value) + '\\n')\n        self.out_stream.flush()\n\n\nclass InputReader:\n    def __init__(self, in_stream):\n        self.in_stream = in_stream\n    \n    def next(self):\n        while True:\n            line = self.in_stream.readline().strip()\n            if not line:\n                continue\n            return line.split()[0]\n    \n    def nextInt(self):\n        return int(self.next())\n\n\ndef main():\n    in_reader = InputReader(sys.stdin)\n    out_writer = PrintWriter(sys.stdout)\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out_writer)\n    out_writer.out_stream.close()\n\n\nif __name__ == \"_