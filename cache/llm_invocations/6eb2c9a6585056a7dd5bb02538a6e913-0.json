                   q.append(e[0])\n        return levelGraph[sink]\n    \n    def dfs(u, flow):\n        if u == sink or flow == 0:\n            return flow\n        while ptr[u] < len(adj[u]):\n            idx = adj[u][ptr[u]]\n            e = edges[idx]\n            if levelGraph[e[0]] and e[1] > e[2]:\n                pushed = dfs(e[0], min(flow, e[1] - e[2]))\n                if pushed > 0:\n                    edges[idx][2] += pushed\n                    edges[idx ^ 1][2] -= pushed\n                    return pushed\n            ptr[u] += 1\n        return 0\n    \n    max_flow = 0\n    while bfs_level():\n        pushed = dfs(source, INF)\n        while pushed > 0:\n            max_flow += pushed\n            pushed = dfs(source, INF)\n    \n    print(max_flow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.583967766957358e-05, -1.4305104514278355e-06, -1.1920928244535389e-07, -0.0126411821693182, -0.001110175740905106, -1.1920928244535389e-07, -0.0001597276859683916, -0.00013469743134919554, -1.6689286894688848e-06, -0.00016985881666187197, -0.008625039830803871, -0.6947571039199829, -0.001783329644240439, -5.304672595229931e-05, -4.768370445162873e-07, -0.37109437584877014, -0.10211024433374405, -7.748573807475623e-06, -5.960446742392378e-06, -0.0043173679150640965, -0.0009482178138568997, -1.1920922133867862e-06, -0.0001081169830285944, 0.0, -1.4781842764932662e-05, -2.0265558760002023e-06, -0.0019345632754266262, -0.49558722972869873, -2.9802276912960224e-06, -0.08894043415784836, -4.768370445162873e-07, -0.6350222826004028, -4.660974445869215e-05, -3.576278118089249e-07, -1.2397689715726301e-05, -0.00014625910262111574, -2.2291887944447808e-05, 0.0, -7.152555099310121e-07, -2.7418097943154862e-06, 0.0, -2.7418097943154862e-06, -1.8358061424805783e-05, -2.3841830625315197e-06, -0.0015025765169411898, -9.464769391342998e-05, -0.000816012208815664, -0.00911031011492014, -4.7683704451