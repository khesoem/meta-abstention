 self.dist[v]\n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[self.prevv[v]][self.preve[v]].cap)\n                v = self.prevv[v]\n            f -= d\n            res += d * self.h[t]\n            v = t\n            while v != s:\n                e = self.G[self.prevv[v]][self.preve[v]]\n                e.cap -= d\n                self.G[v][e.rev].cap += d\n                v = self.prevv[v]\n        return res\n\nimport sys\ninput = sys.stdin.readline\n\nn, m, k, c, d = map(int, input().split())\na = list(map(int, input().split()))\ncnt = [0] * 50\nfor x in a:\n    cnt[x - 1] += 1\ne = [[] for _ in range(50)]\n\nfor _ in range(m):\n    x, y = map(int, input().split())\n    x -= 1\n    y -= 1\n    e[x].append(y)\n    e[y].append(x)\n\nT = 100\nmax_v = n * T + 2\nmcf = MinCostFlow(max_v)\nmcf.init(max_v)\n\nfor i in range(n):\n    mcf.add_edge(n * T, i, cnt[i], 0)\nfor i in range(T):\n    mcf.add_edge(i * n, n * T + 1, k, c * i)\n\nfor i in range(n):\n    for j in range(T - 1):\n        mcf.add_edge(j * n + i, (j + 1) * n + i, k, 0)\n    for to_node in e[i]:\n        for j in range(T - 1):\n            for u in range(k):\n                cost = (u + 1) * (u + 1) * d - u * u * d\n                mcf.add_edge(j * n + i, (j + 1) * n + to_node, 1, cost)\n\nprint(mcf.min_cost_flow(n * T, n * T + 1, k))\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.021603155881166458, -0.000504658033605665, -3.128163257315464e-07, -2.8087270038668066e-05, -3.6723413467407227, -0.002444977406412363, -1.5928495486150496e-05, -6.630610641877865e-06, -6.2729995988775045e-06, -3.128163257315464e-07, 0.0, 0.0, 0.0, -4.127333340875339e-06, -1.2664456789934775e-06, -0.0008218993316404521, -0.00038229089113883674, -2.696889623621246e-06, -3.173704271830502e-06, -1.3856492842023727e-06, -1.8624639324116288e-06, -6.869017852295656e-06, 0.0, -7.896309739408025e-07, 0.0, -7.107425062713446e-06, -1.981667537620524e-06,