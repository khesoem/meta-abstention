\n                            q[r++] = to[i];\n                            if (r == MAXN) r = 0;\n                        }\n                    }\n                }\n            }\n            return dis[t] != -1;\n        }\n\n        private long dfs(int u, long flow) {\n            if (u == t) return flow;\n            vis[u] = true;\n            long tmp = flow;\n            for (int i = (cur[u] != -1 ? cur[u] : head[u]); i != -1; i = nxt[i]) {\n                if (!vis[to[i]] && w[i] > 0 && dis[to[i]] == dis[u] + cap[i]) {\n                    cur[u] = i;\n                    long fl = dfs(to[i], Math.min(flow, w[i]));\n                    cost += fl * cap[i];\n                    w[i] -= fl;\n                    w[i ^ 1] += fl;\n                    flow -= fl;\n                    if (flow == 0) break;\n                }\n            }\n            return tmp - flow;\n        }\n\n        public long dinic(int s, int t) {\n            cost = 0;\n            this.t = t;\n            while (spfa(s, t)) {\n                Arrays.fill(cur, -1);\n                dfs(s, INF);\n            }\n            return cost;\n        }\n\n        public Flow() {\n            Arrays.fill(head, -1);\n            Arrays.fill(nxt, -1);\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int kk = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int[] a = new int[55];\n        st = new StringTokenizer(br.readLine());\n        for (int i = 1; i <= kk; i++) {\n            a[i] = Integer.parseInt(st.nextToken());\n        }\n\n        Flow g = new Flow();\n        int s = 0;\n        int t = n * 100 + 1;\n\n        // sink edges from node 1 at each time\n        for (int i = 1; i <= 100; i++) {\n            g.add_edge(i, t, Flow.INF, 0);\n        }\n\n        // source edges for each person\n        for (int i = 1; i <= kk; i++) {\n            g.add_edge(s, (a[i] - 1) * 100 + 1, 1, 0);\n        }\n\n        // stay edges for nodes 2..n\n        for (int i = 2; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                g.add_edge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, Flow.INF, c);\n            }\n        }\n\n        // movement edges\n        for (int _ = 1; _ <= m; _++) {\n            st = new StringTokenizer(br.readLine());\n            int t1 = Integer.parseInt(st.nextToken());\n            int t2 = Integer.parseInt(st.nextToken());\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= kk; j++) {\n                    int val = c + d * (j * j - (j - 1) * (j - 1));\n                    g.add_edge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val);\n                    g.add_edge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val);\n                }\n            }\n        }\n\n        System.out.println(g.dinic(s, t));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.38720640540122986, -4.410734163684538e-06, 0.0, 0.0, -7.152301259338856e-05, -8.34430247778073e-05, 0.0, -0.023245446383953094, -0.10023149102926254, 0.0, 0.0, -9.536738616588991e-07, -0.0006425699684768915, -0.014297897927463055, -1.1920928244535389e-07, -0.004347872454673052, -0.0015309053706005216, -4.660974445869215e-05, -0.4745921194553375, -0.38691067695617676, -0.001932302606292069, 0.0, 0.0, -0.300459086894989, -0.00868874043226242, -4.768360213347478e-06, -2.861018856492592e-06, -8.344646857949556e-07, -3.2186455882765586e-06, 0.0, -7.152555099310121e-07, -5.960462772236497e-07, -8.34461570775602e-06, -0.003202312160283327, 0.0, -7.152555099310121e-07, -2.3841855067985307e-07, -1.1920928244535389