atic_cast<uint64_t>(v) * o.v);\n        return *this;\n    }\n    \n    ModInt& operator/=(const ModInt& o) {\n        return *this *= o.mod_inverse();\n    }\n    \n    friend ModInt operator+(const ModInt& a, const ModInt& b) { return ModInt(a) += b; }\n    friend ModInt operator-(const ModInt& a, const ModInt& b) { return ModInt(a) -= b; }\n    friend ModInt operator*(const ModInt& a, const ModInt& b) { return ModInt(a) *= b; }\n    friend ModInt operator/(const ModInt& a, const ModInt& b) { return ModInt(a) /= b; }\n    \n    ModInt& operator++() {\n        v = (v == MOD - 1) ? 0 : v + 1;\n        return *this;\n    }\n    \n    ModInt& operator--() {\n        v = (v == 0) ? MOD - 1 : v - 1;\n        return *this;\n    }\n    \n    ModInt operator++(int) { ModInt tmp = *this; ++*this; return tmp; }\n    ModInt operator--(int) { ModInt tmp = *this; --*this; return tmp; }\n    \n    ModInt operator-() const { return v ? MOD - v : 0; }\n    \n    bool operator==(const ModInt& o) const { return v == o.v; }\n    bool operator!=(const ModInt& o) const { return v != o.v; }\n    \n    ModInt mod_inverse() const { return ModInt::mod_inverse(v); }\n    \n    ModInt pow(long long e) const {\n        assert(e >= 0);\n        ModInt b = *this, res = 1;\n        while (e > 0) {\n            if (e & 1) res *= b;\n            b *= b;\n            e >>= 1;\n        }\n        return res;\n    }\n};\n\nconst int MAX_N = 7;\nint N;\nModInt prob[MAX_N][MAX_N];\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N;\n    \n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            int p;\n            cin >> p;\n            prob[i][j] = ModInt(p) / ModInt(100);\n        }\n    }\n    \n    vector<vector<int>> masks_by_pop(MAX_N + 1);\n    vector<int> pos_map(1 << N, -1);\n    \n    for (int mask = 0; mask < (1 << N); ++mask) {\n        int pop = __builtin_popcount(mask);\n        pos_map[mask] = masks_by_pop[pop].size()