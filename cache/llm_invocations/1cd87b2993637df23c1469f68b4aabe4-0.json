od\n    def mod_inverse(a, m=MOD):\n        g, r, x, y = m, a % m, 0, 1\n        while r != 0:\n            q = g // r\n            g, r = r, g % r\n            x, y = y, x - q * y\n        return x % m if x >= 0 else x + m\n    \n    def __int__(self):\n        return self.v\n    \n    def __iadd__(self, other):\n        self.v += other.v\n        if self.v >= MOD:\n            self.v -= MOD\n        return self\n    \n    def __isub__(self, other):\n        self.v -= other.v\n        if self.v < 0:\n            self.v += MOD\n        return self\n    \n    def __imul__(self, other):\n        self.v = (self.v * other.v) % MOD\n        return self\n    \n    def __itruediv__(self, other):\n        return self.__imul__(ModInt(self.mod_inverse(other.v)))\n    \n    def __add__(self, other):\n        return ModInt(self.v + other.v)\n    \n    def __sub__(self, other):\n        return ModInt(self.v - other.v)\n    \n    def __mul__(self, other):\n        return ModInt(self.v * other.v)\n    \n    def __truediv__(self, other):\n        return ModInt(self.v * self.mod_inverse(other.v))\n    \n    def __iadd__(self, other):\n        self.v = (self.v + other.v) % MOD\n        return self\n    \n    def __isub__(self, other):\n        self.v = (self.v - other.v) % MOD\n        if self.v < 0:\n            self.v += MOD\n        return self\n    \n    def __imul__(self, other):\n        self.v = (self.v * other.v) % MOD\n        return self\n    \n    def __itruediv__(self, other):\n        inv = self.mod_inverse(other.v)\n        self.v = (self.v * inv) % MOD\n        return self\n    \n    def __neg__(self):\n        return ModInt(MOD - self.v) if self.v != 0 else ModInt(0)\n    \n    def __eq__(self, other):\n        return self.v == other.v\n    \n    def __ne__(self, other):\n        return self.v != other.v\n    \n    def __hash__(self):\n        return hash(self.v)\n    \n    def pow(self, e):\n        assert e >= 0\n        b, res = ModInt(self.v), ModInt(1)\n        w