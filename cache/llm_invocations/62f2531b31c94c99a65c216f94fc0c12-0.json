            addEdge(source, nodeID(x, y), ord(scientists[x][y]) - ord('0'))\n            if '1' <= reactors[x][y] <= '9':\n                addEdge(N * N + nodeID(x, y), sink, ord(reactors[x][y]) - ord('0'))\n            for X in range(N):\n                for Y in range(M):\n                    if scientists[x][y] in ['Y', 'Z'] or reactors[X][Y] in ['Y', 'Z']:\n                        continue\n                    vis = [[0] * M for _ in range(N)]\n                    bq = deque()\n                    bq.append((x, y, 1))\n                    vis[x][y] = 1\n                    found = False\n                    while bq:\n                        cx, cy, t = bq.popleft()\n                        if cx == X and cy == Y:\n                            vis[cx][cy] = 1\n                            found = True\n                            break\n                        if t >= unusable[cx][cy] or t >= T:\n                            continue\n                        for di, dj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                            nx, ny = cx + di, cy + dj\n                            if inBounds(nx, ny) and not vis[nx][ny] and \\\n                               scientists[nx][ny] not in ['Y', 'Z'] and \\\n                               t + 1 <= unusable[nx][ny]:\n                                vis[nx][ny] = 1\n                                bq.append((nx, ny, t + 1))\n                    if found:\n                        addEdge(nodeID(x, y), N * N + nodeID(X, Y), INF)\n    \n    # Dinic's algorithm\n    ptr = [0] * (M * M * 2 + 2)\n    dist = [-1] * (M * M * 2 + 2)\n    \n    def bfs():\n        for i in range(len(dist)):\n            dist[i] = -1\n        dist[source] = 0\n        q = deque()\n        q.append(source)\n        while q:\n            u = q.popleft()\n            for edge_idx in graph[u]:\n                e = edges[edge_idx]\n                if dist[e.v] == -1 and e.flow < e.capacity:\n                    dist[e.v] = dist[u] + 1\n                    q.append(e.v)\n                    if e.v == sink:\n                        return True\n        return False\n    \n    def dfs(u, flow):\n        if u == sink or flow == 0:\n            return flow\n        for i in range(ptr[u], len(graph[u])):\n            ptr[u] = i\n            edge_idx = graph[u][i]\n            e = edges[edge_idx]\n            if dist[e.v] != dist[u] + 1:\n                continue\n            pushed = dfs(e.v, min(flow, e.capacity - e.flow))\n            if pushed:\n                e.flow += pushed\n                edges[edge_idx ^ 1].flow -= pushed\n                return pushed\n        return 0\n    \n    totalFlow = 0\n    while bfs():\n        ptr = [0] * (M * M * 2 + 2)\n        pushed = dfs(source, INF)\n        while pushed > 0:\n            totalFlow += pushed\n            pushed = dfs(source, INF)\n    \n    print(totalFlow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.011816291604191e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.3872610330581665, -0.0016627785516902804, -1.1920928244535389e-07, -0.00012659224739763886, -0.0001902399235405028, -8.344646857949556e-07, -0.0001629458274692297, -0.01420446764677763, -0.069391630589962, -7.152555099310121e-07, -1.2636104656849056e-05, 0.0, -8.344646857949556e-07, -0.0017060976242646575, 0.0, 0.0, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -8.344646857949556e-07, -3.099436753473128e-06, -9.179073458653875e-06, -0.011141468770802021, -2.1219027985353023e-05, -9.536738616588991e-07, -1.1920928244535389e-07, -0.22541320323944092, -1.1920928244535389e-07, -1.311301275563892e-06, -1.1920928244535389e-07, -1.7881377516459906e-06, 0.0, -8.344646857949556e-07, 0.0, 0.0, 0.0, -8.821448318485636e-06, -5.960462772236497e-07, -2.622600959512056e-06, -1.0728830375228426e-06, -3.933898824470816e-06, -1.1920928244535389e-07, -1.4305104514278355e-06, -1.1920928244535389e-07, -4.768370445162873e