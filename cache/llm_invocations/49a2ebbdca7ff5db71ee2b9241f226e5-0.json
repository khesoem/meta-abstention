xtendedGcd(b % a, a, subXY);\n        xy[0] = subXY[1] - (b / a) * subXY[0];\n        xy[1] = subXY[0];\n        return gcd;\n    }\n\n    public static long modInverse(long a, long m) {\n        long[] xy = new long[2];\n        long gcd = extendedGcd(a, m, xy);\n        if (gcd != 1) return -1;\n        long inv = (xy[0] % m + m) % m;\n        return inv;\n    }\n\n    public static void main(String[] args) {\n        solve();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class EducationalRound86E {\n\n    public static final long MOD = 998244353;\n    public static final int MAX = (int)4e5 + 10;\n    public static long[] fact;\n    public static long[] invFact;\n\n    public static void precompute() {\n        fact = new long[MAX];\n        invFact = new long[MAX];\n        fact[0] = 1;\n        invFact[0] = 1;\n        for (int i = 1; i < MAX; i++) {\n            fact[i] = (fact[i - 1] * i) % MOD;\n        }\n        invFact[MAX - 1] = modPow(fact[MAX - 1], MOD - 2);\n        for (int i = MAX - 2; i >= 1; i--) {\n            invFact[i] = (invFact[i + 1] * (i + 1)) % MOD;\n        }\n    }\n\n    public static long nCr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        long res = fact[n];\n        res = (res * invFact[r]) % MOD;\n        res = (res * invFact[n - r]) % MOD;\n        return res;\n    }\n\n    public static long modPow(long base, long exp) {\n        long result = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) result = (result * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    public static void solve() {\n        precompute();\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int k = sc.nextInt();\n        \n       