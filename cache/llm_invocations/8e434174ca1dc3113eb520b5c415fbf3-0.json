ner(System.in);\n        long n = sc.nextLong();\n        int k = sc.nextInt();\n        int N = k + 1;\n\n        Mat[][] M = new Mat[71][31];\n        for (int i = 0; i < 71; ++i) {\n            for (int j = 0; j < 31; ++j) {\n                M[i][j] = new Mat(N);\n            }\n        }\n\n        for (int i = 0; i < k; ++i) {\n            for (int j = 0; j <= k; ++j) {\n                M[0][i].d[i][j] = 1;\n            }\n        }\n\n        long[] kp = new long[100];\n        kp[0] = 1;\n        kp[1] = k;\n        int lg = 2;\n        while (kp[lg - 1] <= n / k) {\n            kp[lg] = kp[lg - 1] * k;\n            ++lg;\n        }\n\n        for (int i = 1; i < lg; ++i) {\n            // M[i][0] is already identity\n            for (int j = 1; j < k; ++j) {\n                M[i][j] = M[i - 1][j - 1].mul(M[i][j - 1]);\n            }\n            Mat cpro = new Mat(N);\n            for (int j = k - 1; j >= 0; --j) {\n                cpro = cpro.mul(M[i - 1][j]);\n                M[i][j] = M[i][j].mul(cpro);\n            }\n        }\n\n        Mat ans = new Mat(N);\n        int cc = 0;\n        for (int i = lg - 1; i >= 0; --i) {\n            while (kp[i] <= n) {\n                n -= kp[i];\n                ans = M[i][cc].mul(ans);\n                cc = (cc + 1) % k;\n            }\n        }\n\n        long ret = 0;\n        for (int i = 0; i <= k; ++i) {\n            ret = (ret + ans.d[i][k]) % MOD;\n        }\n        System.out.println(ret);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002205128694185987, -4.887569048150908e-06, 0.0, -2.3841855067985307e-07, -5.686121585313231e-05, -0.00010430268594063818, 0.0, -1.4305104514278355e-06, -0.0004391897819004953, -0.0005557184922508895, -1.3708974620385561e-05, 0.0, -6.318072337307967e-06, -0.0011718557216227055, -1.8596476365928538e-05, -0.00326350680552423, -3.0397906812140718e-05, -1.0728830375228426e-06, 0.0, 0.0, -2.3841855067985307e-07, 