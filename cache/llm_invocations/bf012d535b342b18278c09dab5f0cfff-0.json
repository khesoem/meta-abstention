ge a = { (int)g[v].size(), v, cap, 0, cost };\n    edge b = { (int)g[u].size(), u, 0, 0, -cost };\n    g[u].pb(a);\n    g[v].pb(b);\n}\n\ntc dist[MAXN], mncost;\nint pre[MAXN], pre_edge[MAXN]; // pre[node] = previous node, pre_edge[node] = index in g[pre[node]]\ntf cap[MAXN], mxflow;\nbool in_queue[MAXN];\n\nvoid flow(int s, int t) {\n    mset(in_queue,0);\n    mxflow = mncost = 0;\n    while(1) {\n        fill(dist, dist+nodes, INFCOSTO); dist[s] = 0;\n        mset(pre, -1); pre[s] = s;\n        mset(cap, 0); cap[s] = INFFLUJO;\n        queue<int> q; q.push(s); in_queue[s] = 1;\n        while(SZ(q)) {\n            int u = q.front(); q.pop(); in_queue[u] = 0;\n            fore(i, 0, SZ(g[u])) {\n                edge &E = g[u][i];\n                if(E.rem() && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                    dist[E.v] = dist[u] + E.cost;\n                    pre[E.v] = u;\n                    pre_edge[E.v] = i;\n                    cap[E.v] = min(cap[u], E.rem());\n                    if(!in_queue[E.v]) { q.push(E.v); in_queue[E.v] = 1; }\n                }\n            }\n        }\n        if(pre[t] < 0) break;\n        mxflow += cap[t];\n        mncost += cap[t] * dist[t];\n        for(int v = t; v != s; v = pre[v]) {\n            int u = pre[v];\n            edge &E = g[u][pre_edge[v]];\n            E.flow += cap[t];\n            g[v][E.rev].flow -= cap[t];\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    ll n,m,k,c,d;\n    cin>>n>>m>>k>>c>>d;\n    int MAXT = n + k;\n    if(DEBUG) cout<<\"MAXT: \"<<MAXT<<endl;\n    vector<int> a(k);\n    fore(i,0,k) {\n        cin>>a[i]; a[i]--;\n        add_edge(SRC, a[i]*MAXT, 1, 0);\n    }\n    fore(j,0,MAXT) add_edge(j, SNC, k, 0);\n    fore(i,0,m) {\n        int x,y; cin>>x>>y; x--,y--;\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(x*MAXT+j, y*MAXT+j+1, 1, c + d*(2*K-1));\n        }\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(y*MAXT+j, x*MAXT+j+1, 1