 int v1, int v2) {\n    ll state = x * 10000 + v1 * 100 + v2;\n    if (dp.count(state)) return dp[state];\n    ll &res = dp[state];\n    ll diff = abs(x - y);\n    if (diff - sumC[v1] * sumC[v2] > best) return res = 0;\n    if (v1 < R || v2 < R) {\n        if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n            int sum = v1 + v2;\n            v1 -= cntA[sum];\n            v2 -= cntB[sum];\n            return res = binom[v1 + v2][v1];\n        }\n        return res = 0;\n    }\n    res = 0;\n    char c = s[v1 + v2 - 1];\n    if (c != 'B') {\n        ll cur1 = diffC[v1];\n        ll sum2 = sumC[v2];\n        res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n    }\n    if (c != 'A') {\n        ll sum1 = sumC[v1];\n        ll cur2 = diffC[v2];\n        res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n    }\n    return res;\n}\nint main() {\n    scanf(\"%d %d\", &R, &C);\n    for (int i = 0; i <= 2 * (R + C); i++) {\n        for (int j = 0; j <= 2 * (R + C); j++) {\n            if (j == 0) binom[i][j] = 1;\n            else if (i == 0) binom[i][j] = 0;\n            else binom[i][j] = binom[i - 1][j] + binom[i - 1][j - 1];\n        }\n    }\n    total = binom[R + C][R] * binom[R + C][R];\n    precompute();\n    {\n        ll x = 0, y = 0;\n        int v1 = R + C, v2 = R + C;\n        while (v1 >= R && v2 >= R) {\n            if (x > y) {\n                ll cur1 = diffC[v1];\n                ll sum2 = sumC[v2];\n                y += cur1 * sum2;\n                v1--;\n            } else {\n                ll sum1 = sumC[v1];\n                ll cur2 = diffC[v2];\n                x += sum1 * cur2;\n                v2--;\n            }\n        }\n        best = abs(x - y);\n    }\n    dfs(0, 0, R + C, R + C);\n    scanf(\"%s\", s);\n    cntA[0] = cntB[0] = 0;\n    for (int i = 0; i < 2 * (R + C); i++) {\n        cntA[i + 1] = cntA[i] + (s[i] == 'A');\n        cntB[i + 1] = cntB[i] + (s[i] == 'B');\n    }\n    ll ans = solve(0, 0, R + C, R + C);\n    cout << ans << \"\\n