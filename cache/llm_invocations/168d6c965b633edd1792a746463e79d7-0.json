_ctz(lsb);\n        pref[mask] = pref[mask ^ (1 << bit)] - p[bit];\n    }\n\n    int steps = min(SIZE(idxs), k);\n    FOR(step, 0, steps) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int j : idxs) {\n                if (mask & (1 << j)) continue;\n                dp[cur][mask ^ (1 << j)] += dp[cur ^ 1][mask] * p[j] / pref[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    FOR(i, 0, n) {\n        if (!good[i]) {\n            printf(\"%.12f\\n\", 0.0);\n        } else {\n            T val = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    val += dp[cur][mask];\n            }\n            printf(\"%.12f\\n\", (double)val);\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport time\n\ndef solve(n):\n    data = input().split()\n    k = int(data[0])\n    \n    p = list(map(float, input().split()))\n    \n    dp = [[0.0] * (1 << n) for _ in range(2)]\n    \n    good = [0] * n\n    idxs = []\n    for i in range(n):\n        if p[i] != 0:\n            good[i] = 1\n            idxs.append(i)\n    \n    dp[0][0] = 1.0\n    cur = 1\n    \n    pref = [0.0] * (1 << n)\n    pref[0] = 1.0\n    for mask in range(1, 1 << n):\n        lsb = mask & -mask\n        bit = (lsb.bit_length() - 1)\n        pref[mask] = pref[mask ^ (1 << bit)] - p[bit]\n    \n    steps = min(len(idxs), k)\n    for step in range(steps):\n        dp[cur] = [0.0] * (1 << n)\n        \n        for mask in range(1 << n):\n            if bin(mask).count('1') != step:\n                continue\n            \n            for j in idxs:\n                if mask & (1 << j):\n                    continue\n                dp[cur][mask ^ (1 << j)] += dp[cur ^ 1][mask] * p[j] / pref[mask]\n        \n        cur ^= 1\n    \n    cur ^= 1\n    for i in range(n):\n        if not good[i]:\n            print(\"{:.12f}\".format(0.0))\n        else:\n            val = 0.0\n            for mask in range(1 << n):\n                if mask & (1 << i):\n                    val += dp[cur][mask]\n            print(\"{:.12f}\".format(val))\n\ndef main():\n    input = sys.stdin.readline\n    try:\n        while True:\n            line = input().strip()\n            if not line:\n                break\n            n = int(line)\n            solve(n)\n    except EOFError:\n        pass\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001958416833076626, -9.536738616588991e-07, -1.1920928244535389e-07, -0.00031442465842701495, -0.00035637227119877934, -4.172316494077677e-06, -0.0007191693875938654, -0.000979420612566173, -0.006715822499245405, -0.14268262684345245, -0.15025657415390015, -0.0549098402261734, -0.0003301552205812186, -0.0012509147636592388, -0.013271212577819824, -0.001085764612071216, -3.4570634852570947e-06, -0.6473926305770874, -0.02605576254427433, -0.7731026411056519, -7.10462118149735e-05, -0.00594525970518589, -2.264974000354414e-06, -5.960462772236497e-07, -0.010663198307156563, -9.536738616588991e-07, -3.576278118089249e-07, -2.264974000354414e-06, -0.00014125302550382912, -1.1920928244535389e-07, -0.02975492924451828, -0.06994079053401947, -4.768370445162873e-07, -0.30866551399230957, -0.045393362641334534, -0.012435871176421642, -2.109982233378105e-05,