int d) { return p * k + d; };\n\n    vector<Mat> base(60 * k, Mat(k + 1));\n    for (int d = 0; d < k; ++d) {\n        base[idx(0, d)].make_identity();\n        for (int r = 0; r <= k; ++r) base[idx(0, d)].at(r, d) = 1;\n    }\n    vector<Mat> pref(60 * k, Mat(k + 1)), suf(60 * k, Mat(k + 1));\n    for (int p = 1; p < len; ++p) {\n        pref[idx(p - 1, 0)] = base[idx(p - 1, 0)];\n        for (int j = 1; j < k; ++j)\n            pref[idx(p - 1, j)] = mul(pref[idx(p - 1, j - 1)], base[idx(p - 1, j)]);\n        suf[idx(p - 1, k - 1)] = base[idx(p - 1, k - 1)];\n        for (int j = k - 2; j >= 0; --j)\n            suf[idx(p - 1, j)] = mul(base[idx(p - 1, j)], suf[idx(p - 1, j + 1)]);\n        base[idx(p, 0)] = pref[idx(p - 1, k - 1)];\n        for (int j = 1; j < k; ++j)\n            base[idx(p, j)] = mul(suf[idx(p - 1, j)], pref[idx(p - 1, j - 1)]);\n    }\n    Mat trans(k + 1);\n    trans.make_identity();\n    int sum = 0;\n    for (int p = len - 1; p >= 0; --p) {\n        int x = digit[p];\n        for (int j = 0; j < x; ++j) {\n            trans = mul(trans, base[idx(p, sum)]);\n            ++sum;\n            if (sum == k) sum = 0;\n        }\n    }\n    ll ans = 1;\n    for (int i = 0; i < k; ++i) ans = (ans + trans.at(k, i)) % MOD;\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nMOD = 1000000007\n\nclass Mat:\n    def __init__(self, sz=0):\n        self.n = sz\n        self.v = [0] * (sz * sz)\n    \n    def at(self, r, c):\n        return self.v[r * self.n + c]\n    \n    def set_at(self, r, c, val):\n        self.v[r * self.n + c] = val\n    \n    def make_identity(self):\n        for i in range(len(self.v)):\n            self.v[i] = 0\n        for i in range(self.n):\n            self.set_at(i, i, 1)\n\ndef mul(a, b):\n    n = a.n\n    r = Mat(n)\n    for i in range(n):\n        for j in range(n