um * 10 + i);\n}\n\nvoid solve(ll d, ll num) {\n    if (num > n) return;\n    if (valid(num)) {\n        for (ll i = 0; i <= 6; ++i) {\n            ll target = ((cnt2 + 1 - num * pow10[i]) % MOD1 + MOD1) % MOD1;\n            auto lb = lower_bound(bucket[i].begin(), bucket[i].end(), target);\n            ll idx = lb - bucket[i].begin();\n            ll sz = bucket[i].size();\n            ll sum_part = 0;\n            for (ll j = idx; j < sz; ++j) sum_part = (sum_part + bucket[i][j]) % MOD2;\n            ans = (ans + (sum_part + target * (sz - idx) % MOD2) % MOD2) % MOD2;\n        }\n        cnt2 += cnt1;\n    } else {\n        cnt2++;\n        ans = (ans + ((cnt2 - num) % MOD1 + MOD1) % MOD2) % MOD2;\n        for (ll i = (d == 0); i <= 9; ++i) solve(d + 1, num * 10 + i);\n    }\n}\n\nint main() {\n    n = input();\n    precompute(0, 0);\n    for (int i = 0; i <= 6; ++i) sort(bucket[i].begin(), bucket[i].end());\n    cnt2 = -1;\n    solve(0, 0);\n    print(ans);\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final long MOD1 = 998244353L;\n    static final long MOD2 = 1000000007L;\n\n    static long n, ans, cnt1, cnt2;\n    static long[] pow10 = {1, 10, 100, 1000, 10000, 100000, 1000000};\n    static ArrayList<Long>[] bucket = new ArrayList[7];\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n    }\n\n    static void output(long x) {\n        if (x < 0) {\n            System.out.print('-');\n            output(-x);\n            return;\n        }\n        if (x > 9) output(x / 10);\n        System.out.print(x % 10);\n    }\n\n    static void print(long x) {\n        output(x);\n        System.out.println();\n    }\n\n    static boolean valid(long x) {\n        return x * 1000000 + 999999 <= n && x * 10000000 > n;\n    }\n\n    static void precompute(int d, long num) {\n        if (d == 7) return;\n        long val = (cnt1 - num % MOD1 + MOD1) % MOD1;\n        bucket[d].add(val);\n        cnt1++;\n        for (long i = 0; i <= 9; ++i) precompute(d + 1, num * 10 + i);\n    }\n\n    static void solve(int d, long num) {\n        if (num > n) return;\n        if (valid(num)) {\n            for (int i = 0; i <= 6; ++i) {\n                long target = ((cnt2 + 1 - num * pow10[i]) % MOD1 + MOD1) % MOD1;\n                int idx = Collections.binarySearch(bucket[i], target);\n                if (idx < 0) idx = -idx - 1;\n                long sz = bucket[i].size();\n                long sum_part = 0;\n                for (long j = idx; j < sz; ++j) {\n                    sum_part = (sum_part + bucket[i].get((int)j)) % MOD2;\n                }\n                ans = (ans + (sum_part + target * (sz - idx) % MOD2) % MOD2) % MOD2;\n            }\n            cnt2 += cnt1;\n        } else {\n            cnt2++;\n            ans = (ans + ((cnt2 - num) % MOD1 + MOD1) % MOD2) % MOD2;\n            for (long i = (d == 0 ? 0 : 0); i <= 9; ++i) {\n                if (d == 0 && i == 0) continue;\n                solve(d + 1, num * 10 + i);\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        for (int i = 0; i < 7; ++i) {\n            bucket[i] = new ArrayList<>();\n        }\n        FastReader fr = new FastReader();\n        n = fr.nextLong();\n        cnt1