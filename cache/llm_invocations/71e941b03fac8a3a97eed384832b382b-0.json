(s);\n        vis[s] = true;\n        dis[s] = 0;\n        flow[s] = INF;\n        pre[t] = -1;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            vis[x] = false;\n            for (int i = h[x]; i != 0; i = nex[i]) {\n                if (val[i] > 0 && dis[to[i]] > dis[x] + cost[i]) {\n                    dis[to[i]] = dis[x] + cost[i];\n                    pre[to[i]] = x;\n                    last[to[i]] = i;\n                    flow[to[i]] = Math.min(flow[x], val[i]);\n                    if (!vis[to[i]]) {\n                        vis[to[i]] = true;\n                        q.offer(to[i]);\n                    }\n                }\n            }\n        }\n        return pre[t] != -1;\n    }\n\n    static void mcmf() {\n        mxf = 0;\n        mnc = 0;\n        while (spfa()) {\n            int now = t;\n            mxf += flow[t];\n            mnc += flow[t] * dis[t];\n            while (now != s) {\n                val[last[now]] -= flow[t];\n                val[last[now] ^ 1] += flow[t];\n                now = pre[now];\n            }\n        }\n    }\n\n    static int zh(int t, int x) {\n        return t * n + x;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        p = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        s = 0;\n        t = n * 99 + 1;\n\n        for (int i = 1; i <= p && sc.hasNextInt(); i++) {\n            int xVal = sc.nextInt();\n            x[i] = xVal;\n            addedge(s, zh(0, xVal), 1, 0);\n            addedge(zh(0, xVal), s, 0, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            y[i] = sc.nextInt();\n            x[i] = sc.nextInt();\n        }\n        for (int i = 0; i <= 99; i++) {\n            // add capacity edges for the same level\n            addedge(zh(i, 1), zh(i + 1, 1), INF, 0);\n            addedge(zh(i + 1, 1), zh(i, 1), 0, 0);\n            