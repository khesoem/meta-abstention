 - 1)\n                    right = get_dp(nn - 1 - i, hh - 1)\n                    total += left * right\n                dp[(nn, hh)] = total\n\n    return cat[n] - dp[(n, h)]\n\nn, h = map(int, raw_input().split())\nprint compute(n, h)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.math.BigInteger;\nimport java.util.HashMap;\nimport java.util.Objects;\nimport java.util.Scanner;\n\npublic class Main {\n    static class Pair {\n        int n, h;\n        Pair(int n, int h) {\n            this.n = n;\n            this.h = h;\n        }\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            Pair pair = (Pair) o;\n            return n == pair.n && h == pair.h;\n        }\n        @Override\n        public int hashCode() {\n            return Objects.hash(n, h);\n        }\n    }\n\n    static BigInteger get_dp(int nn, int hh, HashMap<Pair, BigInteger> dp, BigInteger[] cat) {\n        if (nn < 0 || hh <= 0) return BigInteger.ZERO;\n        // check nn >= 2^(hh-1)\n        if (BigInteger.valueOf(nn).compareTo(BigInteger.ONE.shiftLeft(hh - 1)) >= 0) {\n            return BigInteger.ZERO;\n        }\n        if (nn < 2) return BigInteger.ONE;\n        if (nn < hh) return cat[nn];\n        return dp.get(new Pair(nn, hh));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int h = sc.nextInt();\n        sc.close();\n\n        // Catalan numbers\n        BigInteger[] cat = new BigInteger[n + 1];\n        cat[0] = BigInteger.ONE;\n        if (n >= 1) cat[1] = BigInteger.ONE;\n        for (int m = 2; m <= n; m++) {\n            BigInteger total = BigInteger.ZERO;\n            for (int i = 0; i < m; i++) {\n                total = total.add(cat[i].multiply(cat[m - 1 - i]));\n            }\n            cat[m] = total;\n        }\n\n        HashMap<Pair, BigInteger> dp = new HashMap<>();\n        for (int hh = 1; hh <= h; hh++) {\n            for (int nn = 0; nn <= n; nn++) {\n                if (nn < 0 || hh <= 0) continue;\n                if (BigInteger.valueOf(nn).compareTo(BigInteger.ONE.shiftLeft(hh - 1)) >= 0) continue;\n                if (nn < 2) {\n                    dp.put(new Pair(nn, hh), BigInteger.ONE);\n                } else if (nn < hh) {\n                    dp.put(new Pair(nn, hh), cat[nn]);\n                } else {\n                    BigInteger total = BigInteger.ZERO;\n                    for (int i = 0; i < nn; i++) {\n                        BigInteger left = get_dp(i, hh - 1, dp, cat);\n                        BigInteger right = get_dp(nn - 1 - i, hh - 1, dp, cat);\n                        total = total.add(left.multiply(right));\n                    }\n                    dp.put(new Pair(nn, hh), total);\n                }\n            }\n        }\n\n        BigInteger result = cat[n].subtract(get_dp(n, h, dp, cat));\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.655486064730212e-05, 0.0, -1.1920928244535389e-07, -2.9682672902708873e-05, -2.634490556374658e-05, 0.0, -0.3132674992084503, -1.7881377516459906e-06, 0.0, -1.1920928244535389e-07, -3.3378546504536644e-06, -1.1920928244535389e-07, 0.0, 0.0, -0.10028573870658875, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.30044689774513245, -1.1920922133867862e-06, -5.960462772236497e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -6.556489552167477e-06, -0.0011725700460374355, 0.0, -0.045681536197662354, -0.07889129221439362, -0.006716059520840645, -0.16534264385700226, -0.0002779574424494058, -1.1920928244535389e-07, 0.0, 0.0, -0.00015853578224778175, -0.049061086028814316, -0.018152887001633644, -2.3841855067985307e-07, -5.924526340095326e-05,