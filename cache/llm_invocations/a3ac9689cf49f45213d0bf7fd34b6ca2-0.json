ase*10 + i);\n}\n\ninline bool valid(LL x) {\n    const LL LIMIT = 1000000;\n    return x * LIMIT + 999999 <= n && x * LIMIT * 10 > n;\n}\n\nLL cnt2;\nLL powers[7] = {1, 10, 100, 1000, 10000, 100000, 1000000};\n\ninline void enumerate(LL level, LL current) {\n    if (current > n) return;\n    if (valid(current)) {\n        REP(i, 0, 6) {\n            LL diff = (cnt2 + 1 - (current * powers[i])) % MOD1;\n            if (diff < 0) diff += MOD1;\n            LL idx = lower_bound(values[i].begin(), values[i].end(), MOD1 - diff) - values[i].begin();\n            total = (total + prefix[i] + diff * (LL)values[i].size() - MOD1 * (LL)(values[i].size() - idx)) % MOD2;\n        }\n        cnt2 += cnt1;\n    } else {\n        cnt2++;\n        LL term = (cnt2 - current) % MOD1;\n        if (term < 0) term += MOD1;\n        total = (total + term) % MOD2;\n        REP(i, !level, 9) enumerate(level+1, current*10 + i);\n    }\n}\n\nint main() {\n    IO::Read(n);\n    precompute(0, 0);\n    REP(i, 0, 6) sort(values[i].begin(), values[i].end());\n    cnt2 = -1;\n    enumerate(0, 0);\n    IO::Write(total);\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef read_int():\n    line = sys.stdin.readline().strip()\n    if not line:\n        return None\n    return int(line)\n\nMOD1 = 998244353\nMOD2 = 1000000007\n\ndef main():\n    n = read_int()\n    \n    total = 0\n    cnt1 = 0\n    prefix = [0] * 7\n    values = [[] for _ in range(7)]\n    \n    def precompute(level, base):\n        nonlocal cnt1\n        if level == 7:\n            return\n        diff = (cnt1 - base + MOD1) % MOD1\n        values[level].append(diff)\n        prefix[level] = (prefix[level] + diff) % MOD2\n        cnt1 += 1\n        for i in range(10):\n            precompute(level + 1, base * 10 + i)\n    \n    def valid(x):\n        LIMIT = 1000000\n        return x * LIMIT + 999999 <= n