   x = -x;\n    }\n    if (x > 9) print(x / 10);\n    putchar(x % 10 + '0');\n}\n\ninline void print(ll x, ll y) {\n    print(x);\n    putchar(' ');\n    print(y);\n}\n\ninline void print(ll x, ll y, ll z) {\n    print(x);\n    putchar(' ');\n    print(y);\n    putchar(' ');\n    print(z);\n}\n\n// Merge sort implementation\nvoid merge(vector<int>& l, vector<int>& r, vector<int>& a) {\n    int i = 0, j = 0, k = 0;\n    while (i < (int)l.size() && j < (int)r.size() && k < (int)a.size()) {\n        if (l[i] < r[j]) {\n            a[k] = l[i];\n            i++;\n        } else {\n            a[k] = r[j];\n            j++;\n        }\n        k++;\n    }\n    while (i < (int)l.size()) {\n        a[k] = l[i];\n        i++;\n        k++;\n    }\n    while (j < (int)r.size()) {\n        a[k] = r[j];\n        j++;\n        k++;\n    }\n}\n\nvoid mergeSort(vector<int>& A) {\n    int n = A.size();\n    if (n < 2) return;\n    vector<int> l(n/2);\n    vector<int> r(n - n/2);\n    \n    for (int i = 0; i < n/2; i++) {\n        l[i] = A[i];\n    }\n    for (int j = n/2; j < n; j++) {\n        r[j - n/2] = A[j];\n    }\n    \n    mergeSort(l);\n    mergeSort(r);\n    merge(l, r, A);\n}\n\n// Power functions\nll pow(ll a, ll N) {\n    if (N == 0) return 1;\n    else if (N == 1) return a;\n    else {\n        ll R = pow(a, N/2);\n        if (N % 2 == 0) {\n            return R * R;\n        } else {\n            return R * R * a;\n        }\n    }\n}\n\nll powMod(ll a, ll N) {\n    if (N == 0) return 1;\n    else if (N == 1) return a % MOD;\n    else {\n        ll R = powMod(a, N/2) % MOD;\n        R = (R * R) % MOD;\n        if (N % 2 == 1) {\n            R = (R * (a % MOD)) % MOD;\n        }\n        return R % MOD;\n    }\n}\n\nint main() {\n    ll n, m;\n    fastscan(n, m);\n    \n    if (m < n) {\n        ll temp = n;\n        n = m;\n        m = temp;\n    }\n    \n    if (n <= 2 && m <= 2) {\n        cout << 0 << endl;\n    } else if (n == 1) {\n        ll res = m / 6;\n        res *= 6;\n        ll mod_val = m % 6;\n        if (mod_val >= 4) {\n            mod_val -= 3;\n            res += mod_val * 2;\n        }\n        cout << res << endl;\n    } else if (n == 2) {\n        ll res = n * m;\n        if (m == 3) res = 4;\n        else if (m == 7) res = 12;\n        cout << res << endl;\n    } else {\n        cout << (n * m / 2) * 2 << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00023707917716819793, -7.271740287251305e-06, -8.344646857949556e-07, -9.369411418447271e-05, -1.5497195136049413e-06, -1.1444026313256472e-05, -2.145764938177308e-06, -4.577531944960356e-05, -2.3841855067985307e-07, -0.666419267654419, -2.50339189733495e-06, -5.960446742392378e-06, -4.768370445162873e-07, -0.28845563530921936, -3.6954811548639555e-06, -8.821448318485636e-06, -9.536738616588991e-07, -0.8258548974990845, -1.6927575416048057e-05, -0.00014161060971673578, -8.344646857949556e-07, -0.9336181879043579, -0.0012163867941126227, -0.0019345632754266262, -4.172316494077677e-06, -0.03692509979009628, -0.01416732743382454, -0.008628821931779385, -1.0728830375228426e-06, -0.4462180733680725, -0.061973217874765396, -0.11294863373041153, -7.748573807475623e-06, -0.3358907401561737, -3.2186455882765586e-06, -0.06993856281042099, -0.2256225049495697, -4.172316494077677e-06, -0.8247460126876831, -0.0007107115816324949, -0.00011014331539627165, -0.002186171943321824, -9.059865078597795e-06, -0.44108784198760986, -0.009756498970091343, -0.043009959161281586, -3.576272320060525e-06, -1.093393087387085, -1.1920922133867862e-06, -3.8980677345534787e-05, -1.311301275563892e-06, -0.00022909401741344482, -0.0006267252028919756, -0.03365141898393631, -5.245195097813848e-06, -0.04589482396841049, -1.3470558769768104e-05, -9.691245941212401e-05, -4.768370445162873e-07, -0.027225106954574585, -0.0003361137059982866, -0.008616885170340538, -1.585470999998506e-05, -0.21131034195423126, -0.0001803473860491