{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing int64 = long long;\n\nconstexpr int64 MOD = 1000000007LL;\n\nint64 pow_mod(int64 base, int64 exp) {\n    int64 result = 1;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return result;\n}\n\nstruct UnionFind {\n    vector<int> parent;\n    vector<int> height;\n    int numComponents;\n    \n    explicit UnionFind(int size) : parent(size), height(size, 0), numComponents(size) {\n        for (int i = 0; i < size; ++i) parent[i] = i;\n    }\n    \n    int find(int node) {\n        if (parent[node] != node) {\n            parent[node] = find(parent[node]);\n        }\n        return parent[node];\n    }\n    \n    void connect(int a, int b) {\n        a = find(a);\n        b = find(b);\n        if (a == b) return;\n        if (height[a] > height[b]) {\n            swap(a, b);\n        }\n        parent[a] = b;\n        if (height[a] == height[b]) ++height[b];\n        --numComponents;\n    }\n    \n    int getComponentCount() const { return numComponents; }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int64 p, k;\n    cin >> p >> k;\n    \n    vector<char> visited(p, 0);\n    UnionFind uf(p);\n    \n    for (int64 start = 0; start < p; ++start) {\n        for (int64 pos = start; !visited[pos]; pos = (pos * k) % p) {\n            visited[pos] = 1;\n            uf.connect(start, pos);\n        }\n    }\n    \n    int componentCount = uf.getComponentCount();\n    if (k != 1) componentCount--;\n    \n    cout << pow_mod(p, componentCount) << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\ndef pow_mod(base, exp, MOD=1000000007):\n    result = 1\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return result\n\nclass UnionFind:\n    def __init__(self, size):\n        self.parent = list(range(size))\n        self.height = [0] * size\n        self.numComponents = size\n    \n    def find(self, node):\n        if self.parent[node] != node:\n            self.parent[node] = self.find(self.parent[node])\n        return self.parent[node]\n    \n    def connect(self, a, b):\n        a = self.find(a)\n        b = self.find(b)\n        if a == b:\n            return\n        if self.height[a] > self.height[b]:\n            a, b = b, a\n        self.parent[a] = b\n        if self.height[a] == self.height[b]:\n            self.height[b] += 1\n        self.numComponents -= 1\n    \n    def getComponentCount(self):\n        return self.numComponents\n\ndef main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    p = int(data[0])\n    k = int(data[1])\n    \n    visited = [0] * p\n    uf = UnionFind(p)\n    \n    for start in range(p):\n        pos = start\n        while not visited[pos]:\n            visited[pos]