t;\n                par[e.dest] = u;\n                parIdx[e.dest] = i;\n                if (!inQ[e.dest]) {\n                    inQ[e.dest] = true;\n                    q.push(e.dest);\n                }\n            }\n        }\n    }\n    return dist[dst] < INF;\n}\n\nint minCostFlow(int s, int t) {\n    int totalCost = 0;\n    while (dijkstraLike(s, t)) {\n        int f = INF;\n        for (int v = t; v != s; v = par[v]) {\n            f = min(f, adjList[par[v]][parIdx[v]].flow);\n        }\n        totalCost += dist[t] * f;\n        for (int v = t; v != s; v = par[v]) {\n            auto& e = adjList[par[v]][parIdx[v]];\n            e.flow -= f;\n            adjList[v][e.rev].flow += f;\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int src = 0;\n    int dst = n * MAX_T + 1;\n    adjList.resize(dst + 1);\n    dist.resize(dst + 1);\n    par.resize(dst + 1);\n    parIdx.resize(dst + 1);\n    \n    // Connect all nodes' last time layer to sink\n    for (int i = 1; i <= n; ++i) {\n        connect((i - 1) * MAX_T + MAX_T, dst, 100, 0);\n    }\n    \n    // Connect source to initial positions\n    for (int i = 0; i < k; ++i) {\n        int v;\n        cin >> v;\n        connect(src, (v - 1) * MAX_T + 1, 1, 0);\n    }\n    \n    // Time progression edges\n    for (int i = 1; i <= n; ++i) {\n        for (int t = 1; t < MAX_T; ++t) {\n            connect((i - 1) * MAX_T + t, (i - 1) * MAX_T + t + 1, 100, c);\n        }\n    }\n    \n    // Bidirectional edges with capacity splitting\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        for (int t = 1; t < MAX_T; ++t) {\n            for (int j = 1; j <= 20; ++j) {\n                int cost = c + (j * j - (j - 1) * (j - 1)) * d;\n                connect((u - 1) * MAX_T + t, (v - 1) * MAX_T + t + 1, 1, cost);\n                connect((v - 1) *