   while i != -1:\n                v, nxt, cap = self.edges[i]\n                if self.d[v] == -1 and cap > 0:\n                    self.d[v] = self.d[u] + 1\n                    q.append(v)\n                i = nxt\n        return self.d[t] != -1\n\n    def dfs(self, u, flow, t):\n        if u == t:\n            return flow\n        i = self.cur[u]\n        while i != -1:\n            v, nxt, cap = self.edges[i]\n            if self.d[v] == self.d[u] + 1 and cap > 0:\n                f = self.dfs(v, min(flow, cap), t)\n                if f:\n                    self.edges[i][2] -= f\n                    self.edges[i ^ 1][2] += f\n                    self.cur[u] = i\n                    return f\n            i = nxt\n            self.cur[u] = i\n        self.d[u] = -1\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            while True:\n                f = self.dfs(s, INF, t)\n                if not f:\n                    break\n                flow += f\n        return flow\n\n\ndef isdigit(ch):\n    return '1' <= ch <= '9'\n\n\ndef In(i, j, n):\n    return 0 <= i < n and 0 <= j < n\n\n\ndef bfs(x, y, d, f, n, t, capsule, Z, F):\n    sx, sy = x, y\n    # reset d to INF\n    for i in range(n):\n        for j in range(n):\n            d[i][j] = INF\n    d[x][y] = 0\n    q = deque()\n    q.append(x)\n    q.append(y)\n    if f and isdigit(capsule[x][y]):\n        F.add_edge(sx * n + sy, sx * n + sy + n * n, INF)\n    while q:\n        x = q.popleft()\n        y = q.popleft()\n        if d[x][y] == t:\n            break\n        for o in range(4):\n            xx = x + dx[o]\n            yy = y + dy[o]\n            if In(xx, yy, n) and d[xx][yy] == INF and capsule[xx][yy] != 'Y':\n                if Z[xx][yy] > d[x][y] + 1 or (Z[xx][yy] == d[x][y] + 1 and isdigit(capsule[xx][yy])):\n                    d[xx][yy] = d[x][y] + 1\n                    if f and isdigit(capsule[xx][yy]):\n                        F.add_edge(sx * n + sy, xx * n + yy + n * n, INF)\n                    if Z[xx][yy] > d[x][y] + 1 or not f:\n                        q.append(xx)\n                        q.append(yy)\n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    field = []\n    for _ in range(n):\n        field.append(next(it))\n    capsule = []\n    for _ in range(n):\n        capsule.append(next(it))\n\n    N = 15\n    Z = [[INF] * N for _ in range(N)]\n    S = [[INF] * N for _ in range(N)]\n\n    src = n * n * 2\n    sink = src + 1\n    F = Dinic(sink + 1)\n\n    # find zombie start\n    zx = zy = -1\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                zx, zy = i, j\n                break\n        if zx != -1:\n            break\n\n    # add capsule edges\n    for i in range(n):\n        for j in range(n):\n            if isdigit(capsule[i][j]):\n                F.add_edge(i * n + j + n * n, sink, int(capsule[i][j]))\n\n    # bfs from zombie\n    bfs(zx, zy, Z, False, n, t, capsule, Z, F)\n\n    # for each field digit\n    for i in range(n):\n        for j in range(n):\n            if isdigit(field[i][j]):\n                F.add_edge(src, i * n + j, int(field[i][j]))\n                bfs(i, j, S, True, n, t, capsule, Z, F)\n\n    print(F.max_flow(src, sink))\n\n\ndx = [-1, 1, 0, 0]\ndy = [0, 0, -1, 1]\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.16056518256664276, -1.9430925021879375e-05, 0.0, 0.0, -0.0009220162755809724, -0.001609936123713851, -1.0728830375228426e-06, -1.4185804502631072e-05, -0.0003268184664193541, -5.960462772236497e-07, 0.0, -9.536738616588991e-07, -0.0007340597221627831, -0.7408406734466553, -5.876845170860179e-05, -0.014163566753268242, -0.00033623288618400693, -0.2519319951534271, -8.344646857949556e-07, -0.10654046386480331, -0.0501756183