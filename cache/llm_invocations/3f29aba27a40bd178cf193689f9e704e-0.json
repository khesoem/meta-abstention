ink) return in;\n        int flow = 0, f;\n        for (int &i = cur[u]; ~i; i = E[i].nxt) {\n            v = E[i].v;\n            if (d[v] == d[u] + 1 && E[i].cap) {\n                f = dfs(v, min(in - flow, E[i].cap));\n                if (f) {\n                    flow += f;\n                    E[i].cap -= f;\n                    E[i ^ 1].cap += f;\n                    if (flow == in) break;\n                }\n            }\n        }\n        if (flow < in) d[u] = -1;\n        return flow;\n    }\n\n    const int inf = 1e9;\n    int dinic(int _src, int _sink) {\n        src = _src, sink = _sink;\n        int flow = 0;\n        while (bfs())\n            flow += dfs(src, inf);\n        return flow;\n    }\n};\n\nint n;\nconst int N = 15;\nchar field[N][N], capsule[N][N];\nint Z[N][N], S[N][N];\nint dx[] = {-1, 1, 0, 0};\nint dy[] = {0, 0, -1, 1};\n\ninline bool In(int i, int j) {\n    return i >= 0 && i < n && j >= 0 && j < n;\n}\n\nDinic<210> F;\nint t;\nconst int inf = 1e9;\n\ninline bool isdigit(char ch) {\n    return ch >= '1' && ch <= '9';\n}\n\nvoid bfs(int x, int y, int d[][N], bool f) {\n    int sx = x, sy = y;\n    fill(d[0], d[N], inf);\n    d[x][y] = 0;\n    queue<int> Q;\n    Q.push(x);\n    Q.push(y);\n    if (f && isdigit(capsule[x][y])) {\n        F.add(sx * n + sy, sx * n + sy + n * n, inf);\n    }\n    while (!Q.empty()) {\n        x = Q.front(); Q.pop();\n        y = Q.front(); Q.pop();\n        if (d[x][y] == t) break;\n        for (int o = 0; o < 4; ++o) {\n            int xx = x + dx[o];\n            int yy = y + dy[o];\n            if (In(xx, yy) && d[xx][yy] == inf && capsule[xx][yy] != 'Y') {\n                if (Z[xx][yy] > d[x][y] + 1 || (Z[xx][yy] == d[x][y] + 1 && isdigit(capsule[xx][yy]))) {\n                    d[xx][yy] = d[x][y] + 1;\n                    if (f && isdigit(capsule[xx][yy])) {\n                        F.add(sx * n + sy, xx * n + yy + n * n, inf);\n                    }\n                    if (Z[xx][yy] > d[x][y] +