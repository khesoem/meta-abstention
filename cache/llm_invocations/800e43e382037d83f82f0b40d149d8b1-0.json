ng A = 0, B = 0, k = 0;\n        \n        for (long i = 1; i <= n; i++) {\n            if (i == 1) {\n                A = k;\n                B = i;\n            }\n            k = x * i / y;\n            for (long j = 0; j <= 10; j++) {\n                k += j;\n                long mn1 = Math.abs(x * i - y * k) * y * B;\n                long mn2 = Math.abs(x * B - y * A) * y * i;\n                if (mn1 < mn2) {\n                    A = k;\n                    B = i;\n                }\n            }\n        }\n        \n        long g = gcd(A, B);\n        System.out.println((A / g) + \"/\" + (B / g));\n    }\n    \n    private static long gcd(long a, long b) {\n        if (b == 0) return a;\n        return gcd(b, a % b);\n    }\n}\n</translated_code>\n<confidence>\n0.7\n</confidence>", "token_logprobs": [-0.000102037942269817, -1.4305104514278355e-06, -8.344646857949556e-07, -0.0006354220095090568, -1.2755313036905136e-05, -0.0007680088747292757, -0.5830274820327759, -0.011079457588493824, -1.1920858014491387e-05, -0.1307021528482437, -0.0008295908919535577, -8.702239938429557e-06, -7.152555099310121e-07, -2.3007127310847864e-05, -2.0503786799963564e-05, -0.0001426833332516253, -0.0009433348895981908, -8.344646857949556e-07, -0.00029666791670024395, -1.1920922133867862e-06, -7.986990567587782e-06, -5.6622808187967166e-05, -9.476689592702314e-05, -3.576278118089249e-07, -0.3133426904678345, -0.004656780045479536, -1.0371154530730564e-05, -2.9802276912960224e-06, -0.1785108745098114, -0.002155958442017436, -7.152555099310121e-07, -4.768370445162873e-07, -2.50339189733495e-06, -1.0847986231965479e-05, -3.2543604902457446e-05, -1.5735502529423684e-05, -2.264974000354414e-06, -1.680836794548668e-05, -1.1920922133867862e-06, -0.24022279679775238, -2.50339189733495e-06, -0.6608352661132812, -1.1920922133867862e-06, -2.0265373677830212e-05, -4.0531076592742465e-06, -2.3841855067985307e-07, -0.00146246247459203, -0.0015113847330212593, -7.64102369430475e-05, -1.907330