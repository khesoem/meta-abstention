          q.push(v);\n                }\n            }\n        }\n    }\n    return dist[t] < INF;\n}\n\nint minCostMaxFlow(int s, int t) {\n    int result = 0;\n    while (spfa(s, t)) {\n        int add = INF;\n        for (int v = t; v != s; v = pre[v]) {\n            add = min(add, cap[preEdge[v]]);\n        }\n        for (int v = t; v != s; v = pre[v]) {\n            int e = preEdge[v];\n            cap[e] -= add;\n            cap[e ^ 1] += add;\n        }\n        result += dist[t] * add;\n    }\n    return result;\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int s = 0, t = n * 100 + 1;\n    int nodeCount = t + 1;\n\n    head.assign(nodeCount, -1);\n    dist.resize(nodeCount);\n    pre.resize(nodeCount);\n    preEdge.resize(nodeCount);\n    inq.resize(nodeCount);\n\n    for (int i = 1; i <= 100; ++i) addEdge(i, t, 100, 0);\n    for (int i = 1; i <= k; ++i) {\n        int v; scanf(\"%d\", &v);\n        addEdge(s, (v - 1) * 100 + 1, 1, 0);\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n        }\n    }\n    for (int i = 1; i <= m; ++i) {\n        int u, v; scanf(\"%d%d\", &u, &v);\n        for (int j = 1; j < 100; ++j) {\n            int idx = (u - 1) * 100 + j;\n            int idy = (v - 1) * 100 + j + 1;\n            for (int p = 1; p <= 20; ++p) {\n                addEdge(idx, idy, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n            }\n            int idx2 = (v - 1) * 100 + j;\n            int idy2 = (u - 1) * 100 + j + 1;\n            for (int p = 1; p <= 20; ++p) {\n                addEdge(idx2, idy2, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n            }\n        }\n    }\n\n    printf(\"%d\\n\", minCostMaxFlow(s, t));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translate