= u;\n                parent_edge[v] = idx;\n                if (!in_queue[v]) {\n                    in_queue[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    int cur = sink;\n    while (cur != src) {\n        e[parent_edge[cur]].flow++;\n        e[parent_edge[cur] ^ 1].flow--;\n        cur = parent[cur];\n    }\n    ans += dist[sink];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> n >> m >> k >> c >> d;\n    int x, y;\n    for (int i = 1; i <= k; i++) {\n        cin >> x;\n        x--;\n        add_edge(src, x, 1, 0);\n    }\n    for (int i = 1; i <= 101; i++)\n        add_edge((i - 1) * n, sink, k, (i - 1) * c);\n    for (int i = 1; i <= m; i++) {\n        cin >> x >> y;\n        x--; y--;\n        for (int i = 1; i <= 100; i++)\n            for (int j = 1; j <= k; j++) {\n                add_edge(x + (i - 1) * n, y + (i - 1) * n + n, 1, d * ((j - 1) * 2 + 1));\n                add_edge(y + (i - 1) * n, x + (i - 1) * n + n, 1, d * ((j - 1) * 2 + 1));\n            }\n    }\n    for (int i = 1; i <= n; i++)\n        for (int j = 1; j <= 100; j++)\n            add_edge(i - 1 + (j - 1) * n, i - 1 + (j - 1) * n + n, k, 0);\n    for (int i = 1; i <= k; i++) push_rebel();\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 15000\nsrc = 9998\nsink = 9999\n\ne = []  # list of edges: [to, cap, flow, cost]\nadj = [[] for _ in range(10000)]  # enough for src, sink and up to 15000\nans = 0\ndist = [0] * 10000\nparent = [0] * 10000\nparent_edge = [0] * 10000\nin_queue = [0] * 10000\n\ndef add_edge(x, y, cap, cost):\n    adj[x].append(len(e))\n    e.append([y, cap, 0, cost])\n    adj[y].append(len(e))\n    e.append([x, 0, 0, -cost])\n\ndef push_rebel():\n    global ans\n    INF = 10**18\n    for i in range(10000):\n        dist[i] = INF\n        parent[i] = -1\n        parent_edge[i] = -1\n        in_queue[i] = 0\n    dist[src] = 0\n    q = deque([src])\n    in_queue[src] = 1\n    while q:\n        u = q.popleft()\n        in_queue[u] = 0\n        for idx in adj[u]:\n            if e[idx][1] - e[idx][2] == 0:\n                continue\n            cost = e[idx][3]\n            v = e[idx][0]\n            if dist[v] > dist[u] + cost:\n                dist[v] = dist[u] + cost\n                parent[v] = u\n                parent_edge[v] = idx\n                if not in_queue[v]:\n                    in_queue[v] = 1\n                    q.append(v)\n    cur = sink\n    while cur != src:\n        e[parent_edge[cur]][2] += 1\n        e[parent_edge[cur] ^ 1][2] -= 1\n        cur = parent[cur]\n    ans += dist[sink]\n\ndef main():\n    global ans\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    for _ in range(k):\n        x = int(next(it))\n        x -= 1\n        add_edge(src, x, 1, 0)\n    for i in range(1, 102):  # 1..101 inclusive\n        add_edge((i - 1) * n, sink, k, (i - 1) * c)\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        x -= 1\n        y -= 1\n        for i in range(1, 101):  # 1..100 inclusive\n            for j in range(1, k + 1):\n                cost_val = d * ((j - 1) * 2 + 1)\n                add_edge(x + (i - 1) * n, y + (i - 1) * n + n, 1, cost_val)\n                add_edge(y + (i - 1) * n, x + (i - 1) * n + n, 1, cost_val)\n    for i in range(1, n + 1):\n        for j in range(1, 101):  # 1..100 inclusive\n            add_edge(i - 1 + (j - 1) * n, i - 1 + (j - 1) * n + n, k, 0)\n    for _ in range(k):\n        push_rebel()\n    print(ans)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.7165990