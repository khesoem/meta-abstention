  if (!file) {\n            throw runtime_error(\"Cannot open file: \" + filename);\n        }\n    }\n\n    string next() {\n        while (true) {\n            if (pos < (int)tokens.size()) {\n                return tokens[pos++];\n            }\n            if (!hasLine) {\n                if (fgets((char*)line.data(), line.size(), file) == nullptr) {\n                    throw runtime_error(\"No more input\");\n                }\n                line = string(line.c_str());\n                hasLine = true;\n            }\n            istringstream iss(line);\n            tokens.clear();\n            pos = 0;\n            string token;\n            while (iss >> token) {\n                tokens.push_back(token);\n            }\n            if (!tokens.empty()) {\n                break;\n            }\n            hasLine = false;\n        }\n        return tokens[pos++];\n    }\n\n    int nextInt() {\n        return stoi(next());\n    }\n\n    long long nextLong() {\n        return stoll(next());\n    }\n\n    double nextDouble() {\n        return stod(next());\n    }\n\n    string nextLine() {\n        if (fgets((char*)line.data(), line.size(), file) == nullptr) {\n            return \"\";\n        }\n        string res(line.c_str());\n        if (!res.empty() && res.back() == '\\n') {\n            res.pop_back();\n        }\n        return res;\n    }\n\n    vector<int> intArr(int n) {\n        vector<int> res(n);\n        for (int i = 0; i < n; i++) {\n            res[i] = nextInt();\n        }\n        return res;\n    }\n\n    vector<long long> longArr(int n) {\n        vector<long long> res(n);\n        for (int i = 0; i < n; i++) {\n            res[i] = nextLong();\n        }\n        return res;\n    }\n\n    vector<int> intSortedArr(int n) {\n        vector<int> res = intArr(n);\n        shuffle(res);\n        sort(res.begin(), res.end());\n        return res;\n    }\n\n    vector<long long> longSortedArr(int n) {\n        vector<long long> res = longArr(n);\n        shuffle(res);\n        sort(res.begin(), res.end());\n        return res;\n    }\n\n    void shuffle(vector<int>& in) {\n        random_device rd;\n        mt19937 g(rd());\n        shuffle(in.begin(), in.end(), g);\n    }\n\n    void shuffle(vector<long long>& in) {\n        random_device rd;\n        mt19937 g(rd());\n        shuffle(in.begin(), in.end(), g);\n    }\n\n    vector<long> LongArr(int n) {\n        vector<long> res(n);\n        for (int i = 0; i < n; i++) {\n            res[i] = nextLong();\n        }\n        return res;\n    }\n\n    vector<int> IntegerArr(int n) {\n        vector<int> res(n);\n        for (int i = 0; i < n; i++) {\n            res[i] = nextInt();\n        }\n        return res;\n    }\n\n    ~MScanner() {\n        if (file) fclose(file);\n    }\n};\n\nvoid addX(vector<int>& in, int x) {\n    for (int i = 0; i < (int)in.size(); i++) in[i] += x;\n}\n\nvoid addX(vector<long long>& in, int x) {\n    for (int i = 0; i < (int)in.size(); i++) in[i] += x;\n}\n\nint main() {\n    MScanner sc(stdin);\n    long long n = sc.nextLong(), m = sc.nextLong(), l = sc.nextLong(), r = sc.nextLong();\n\n    if (l == r) {\n        cout << 1 << endl;\n        return 0;\n    }\n\n    long long odds = ((r + 1) / 2) - (l / 2);\n    long long evens = (r / 2) - ((l - 1) / 2);\n\n    long long ans;\n\n    if ((n * m) % 2 == 1) {\n        ans = fastpow(odds + evens, n * m);\n    } else {\n        ans = (fastpow(odds + evens, n * m) + fastpow(odds - evens, n * m)) % mod;\n        ans = (ans * modInv(2)) % mod;\n    }\n\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00014709345123264939, -7.748573807475623e-06, -1.9073468138230965e-06, -0.0001736728590913117, -7.152555099310121e-07, -0.0003383779258001596, -8.4638240878121e-06, -4.8040190449682996e-05, -4.768370445162873e-07, -0.5885370373725891, -0.0004948345012962818, -0.002944659674540162, -2.861018856492592e-06, -0.732