  q.pop();\n        inQueue[v] = false;\n\n        for (int id : adj[v]) {\n            if (residualCapacity(id) == 0) continue;\n            int to = edges[id].to;\n            int w = edges[id].cost;\n            if (dist[to] > dist[v] + w) {\n                dist[to] = dist[v] + w;\n                parent[to] = v;\n                parentEdge[to] = id;\n                if (!inQueue[to]) {\n                    inQueue[to] = true;\n                    q.push(to);\n                }\n            }\n        }\n    }\n\n    int cur = T;\n    while (cur != S) {\n        int id = parentEdge[cur];\n        edges[id].flow++;\n        edges[id ^ 1].flow--;\n        cur = parent[cur];\n    }\n\n    totalCost += dist[T];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        addEdge(S, x, 1, 0);\n    }\n\n    const int TIMES = 101;\n\n    for (int i = 0; i < TIMES; ++i) {\n        addEdge(i * n, T, k, i * c);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n\n        for (int tm = 0; tm < TIMES - 1; ++tm) {\n            for (int p = 0; p < k; ++p) {\n                addEdge(x + tm * n, y + (tm + 1) * n, 1, d * (2 * p + 1));\n            }\n        }\n        for (int tm = 0; tm < TIMES - 1; ++tm) {\n            for (int p = 0; p < k; ++p) {\n                addEdge(y + tm * n, x + (tm + 1) * n, 1, d * (2 * p + 1));\n            }\n        }\n    }\n\n    for (int i = 0; i < n; ++i) {\n        for (int tm = 0; tm < TIMES - 1; ++tm) {\n            addEdge(i + tm * n, i + (tm + 1) * n, k, 0);\n        }\n    }\n\n    for (int i = 0; i < k; ++i) {\n        augmentOne();\n    }\n\n    cout << totalCost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 14043\nINF = 10**18\n\nedges = []  # each edge: [to, cap, flow, cost]\nadj = [[] for _ in range(MAXN)]\n\nS = MAXN - 2\nT = MAXN - 1\n\ntotalCost = 0\n\ndef residualCapacity(id):\n    return edges[id][1] - edges[id][2]\n\ndef addEdge(u, v, cap, cost):\n    adj[u].append(len(edges))\n    edges.append([v, cap, 0, cost])\n    adj[v].append(len(edges))\n    edges.append([u, 0, 0, -cost])\n\ndef augmentOne():\n    global totalCost\n    dist = [INF] * MAXN\n    parent = [-1] * MAXN\n    parentEdge = [-1] * MAXN\n    inQueue = [False] * MAXN\n\n    dist[S] = 0\n    q = deque()\n    q.append(S)\n    inQueue[S] = True\n\n    while q:\n        v = q.popleft()\n        inQueue[v] = False\n        for id in adj[v]:\n            if residualCapacity(id) == 0:\n                continue\n            to = edges[id][0]\n            w = edges[id][3]\n            if dist[to] > dist[v] + w:\n                dist[to] = dist[v] + w\n                parent[to] = v\n                parentEdge[to] = id\n                if not inQueue[to]:\n                    inQueue[to] = True\n                    q.append(to)\n\n    cur = T\n    while cur != S:\n        id = parentEdge[cur]\n        edges[id][2] += 1\n        edges[id ^ 1][2] -= 1\n        cur = parent[cur]\n\n    totalCost += dist[T]\n\ndef main():\n    global totalCost\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        addEdge(S, x, 1, 0)\n\n    TIMES = 101\n\n    for i in range(TIMES):\n        addEdge(i * n, T, k, i * c)\n\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for tm in range(TIMES - 1):\n            for p in range(k):\n                addEdge(x + tm * n, y + (tm + 1) * n, 1, d * (2 * p + 1))\n        for tm in range(TIMES - 1):\n            for p in range(k):\n                addEdge(y + tm * n, x + (tm + 1) * n, 1, d * (2 * p + 1))\n\n    for i in range(n):\n        for tm in range(TIMES - 1):\n            addEdge(i + tm * n, i + (tm + 1) * n, k, 0)\n\n    for _ in range(k):\n        augmentOne()\n\n    sys.stdout.write(str(totalCost) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.6967357775429264e-05, 0.0, -1.1920928244535389e-07, -0.0002169373765354976, -0.0008213722030632198, -1.1920928244535389e-07, -1.0013530300057027e-05, -0.0003361137059982866, 0.0, 0.0, -4.768370445162873e-07, -0.00021669900161214173, -0.5189939141273499, -1.7881233361549675e-05, -1.0132738680113107e-05, -3.576278118089249e-07, -1.1920858014491387e-05, -5.125986263010418e-06, -0.0011630444787442684, -0.6339809894561768, 0.0, -0.0003067976504098624, -2.50339189733495e-06, -0.04858744144439697, -3.099436753473128e-06, -0.03808066248893738, -0.5297693014144897, -6.437280717364047e-06, -0.3132825791835785, -0.377503901720047, 0.0, -0.10068777203559875, -0.029930684715509415, -0.06310513615608215, -5.328513361746445e-05, -1.7881377516459906e-06, 0.0, -2.8132995794294402e-05, 0.0, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -0.0001597276859683916, -7.152555099310121e-07, -1.1920928244535389e-07, -1.7881377516459906e-06, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -0.10245451331138611, -0.6943976283073425, -4.6491513785440475e-06, 0.0, 0.0, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, -3.2186455882765586e-06, 0.0, -1.4305104514278355e-06, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -7.152555099310121e-07, -5.960462772236497e-07, -0.06208503246307373, -0.5762075781822205, -0.16022948920726776, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00712721748277545, -0.00022110878489911556, -0.00035553809721022844, -0.3869999051094