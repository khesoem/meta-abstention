 for j in range(1, i + 1):\n            p[i] = (p[i] + h[j] * p[i - j] % Mo * j) % Mo\n        p[i] = p[i] * inv[i] % Mo\n    for i in range(0, n + 1):\n        h[i] = p[i] % Mo\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    L = int(data[0])\n    k = int(data[1])\n    Mo = int(data[2])\n\n    all_val = pwr(k, L, Mo)\n    if L & 1:\n        print(all_val)\n        return\n\n    # find bits of L\n    bits = []\n    for i in range(19):\n        if (L >> i) & 1:\n            bits.append(1 << i)\n    n = len(bits)\n    length = 1 << n\n\n    # factorials and inverses up to L\n    fac = [1] * (L + 1)\n    for i in range(1, L + 1):\n        fac[i] = fac[i - 1] * i % Mo\n    inv = [0] * (L + 1)\n    inv[L] = pwr(fac[L], Mo - 2, Mo)\n    for i in range(L - 1, -1, -1):\n        inv[i] = inv[i + 1] * (i + 1) % Mo\n\n    # popcount for numbers up to L\n    cnt = [0] * (L + 1)\n    for s in range(1, L + 1):\n        cnt[s] = cnt[s ^ (s & -s)] + 1\n\n    # initialize g\n    g = [[0] * length for _ in range(n + 1)]\n    for i in range(length):\n        s = 0\n        for j in range(n):\n            if (i >> j) & 1:\n                s += bits[j]\n        g[cnt[i]][i] = inv[s] % Mo\n\n    # recompute inverses for numbers 2..n (used in ln/exp)\n    for i in range(2, n + 1):\n        inv[i] = (Mo - Mo // i) * inv[Mo % i] % Mo\n\n    # FWT each row of g\n    for i in range(n + 1):\n        FWT(g[i], length, Mo)\n\n    h = [0] * (n + 1)\n    p = [0] * (n + 1)\n    f = [[0] * length for _ in range(n + 1)]\n    for s in range(length):\n        for i in range(n + 1):\n            h[i] = g[i][s]\n        get_ln(h, p, n, inv, Mo)\n        for i in range(n + 1):\n            h[i] = h[i] * k % Mo\n        get_exp(h, p, n, inv, Mo)\n        for i in range(n + 1):\n            f[i][s] = h[i] % Mo\n\n    IFWT(f[n], length, Mo)\n    ans = f[n][length - 1] * fac[L] % Mo\n    ans = (all_val - ans) % Mo\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.00035744477645494044, -1.1920928244535389e-07, -3.099436753473128e-06, -0.0009417866240255535, -0.21023984253406525, -3.576278118089249e-07, -0.0009270184673368931, -0.023654639720916748, -0.0005343916127458215, 0.0, -7.152555099310121e-07, -0.00021288513380568475, 0.0, -1.2278481335670222e-05, -0.06825322657823563, -6.9141146923357155e-06, -2.682172998902388e-05, -0.0032736065331846476, -4.565611743601039e-05, 0.0, -1.1920928244535389e-07, -2.1576648578047752e-05, 0.0, -0.002539625857025385, 0.0, -0.000554288737475872, 0.0, -2.3841855067985307e-07, -1.4305104514278355e-06, -7.152555099310121e-07, 0.0, 0.0, -1.8954096958623268e-05, -3.2186455882765586e-06, 0.0, 0.0, -0.0015028145862743258, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -8.344646857949556e-07, 0.0, -1.7881377516459906e-06, -4.541770613286644e-05, 0.0, -1.5497195136049413e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -9.536738616588991e-07, 0.0, 0.0, 0.0, -0.00043072958942502737, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -4.768370445162873e-07, -0.00044431351125240326, -1.6689286894688848e-06, -0.00039986721822060645, -1.1920928244535389e-07, -2.2053474822314456e-05, -8.344646857949556e-07, -0.30763790011405945, -3.3378546504536644e-06, -7.1403817855753e-05, -7.152531907195225e-06, -1.1920928244535389e-07, -0.004254694562405348, -2.264974000354414e-06, 0.0, -1.1920922133867862e-06, 0.0, 0.0, -7.152555099310121e-07, -2.3841855067985307e-07, 0.0, -1.5497195136049413e-06, -5.960462772236497e-07, -1.1920928244535389e-07, -0.006811849772930145, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -1.9907753085135482e-05, 0.0, -2.753696753643453e-05, -6.198863957251888e-06, -1.1920922133867862e-06, -2.3841855067985307e-07, -3.2066785934148356e-05, -3.576278118089249e-07, -1.4305104514278355e-06, 0.0, -5.960462772236497