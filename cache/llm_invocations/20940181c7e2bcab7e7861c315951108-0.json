der(new InputStreamReader(is));\n        }\n\n        String next() {\n            try {\n                while (st == null || !st.hasMoreTokens())\n                    st = new StringTokenizer(br.readLine());\n                return st.nextToken();\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n\n    static class OutputHandler {\n        PrintWriter pw;\n\n        OutputHandler(OutputStream os) {\n            pw = new PrintWriter(os);\n        }\n\n        void println(long value) {\n            pw.println(value);\n        }\n\n        void close() {\n            pw.close();\n        }\n    }\n}\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nMOD = 998244353\n\nclass CardShuffleProblem:\n    def __init__(self):\n        self.fact = None\n        self.invFact = None\n\n    def compute(self, testNo, in_obj, out_obj):\n        n = in_obj.nextInt()\n        m = in_obj.nextInt()\n        self.precompute(n + m + 1)\n\n        phaseCount = 1\n        current = 1\n        i = 0\n        while current != 0:\n            current = self.multiply(current, self.multiply(n - i, self.modInverse(n + m - i)))\n            phaseCount = self.add(phaseCount, current)\n            i += 1\n\n        result = 0\n        for k in range(1, n + 1):\n            phases = self.multiply(m + k, self.modInverse(k))\n            expectation = self.multiply(phases, phaseCount)\n            contribution = self.multiply(self.binomial(n, k), expectation)\n\n            if k % 2 == 1:\n                result = self.add(result, contribution)\n            else:\n                result = self.subtract(result, contribution)\n\n        out_obj.println(result)\n\n    def precompute(self, limit):\n        self.fact = [0] * limit\n        self.invFact = [0] * limit\n        self.fact[0] = 1\n        for i in range(1, limit):\n            self.fact[i] = (self.fact[i - 1] * i) % MOD\n        self.invFact[limit - 1] = self.modPow(self.fact[limit - 1], MOD - 2)\n        for i in range(limit - 2, -1, -1):\n            self.invFact[i] = (self.invFact[i + 1] * (i + 1)) % MOD\n\n    def binomial(self, n, r):\n        if r < 0 or r > n:\n            return 0\n        return self.fact[n] * self.invFact[r] % MOD * self.invFact[n - r] % MOD\n\n    def modInverse(self, x):\n        return self.modPow(x, MOD - 2)\n\n    def modPow(self, base, exp):\n        res = 1\n        base %= MOD\n        while exp > 0:\n            if exp & 1:\n                res = (res * base) % MOD\n            base = (base * base) % MOD\n            exp >>= 1\n        return res\n\n    def add(self, a, b):\n        a += b\n        return a - MOD if a >= MOD else a\n\n    def subtract(self, a, b):\n        a -= b\n        return a + MOD if a < 0 else a\n\n    def multiply(self, a, b):\n        return (a * b) % MOD\n\n\nclass InputScanner:\n    def __init__(self, is_obj):\n        self.lines = []\n        for line in sys.stdin:\n            self.lines.extend(line.strip().split())\n        self.index = 0\n\n    def next(self):\n        if self.index >= len(self.lines):\n            raise RuntimeError(\"No more tokens\")\n        token = self.lines[self.index]\n        self.index += 1\n        return token\n\n    def nextInt(self):\n        return int(self.next())\n\n\nclass OutputHandler:\n    def __init__(self, os_obj):\n        self.output = []\n\n    def println(self, value):\n        self.output.append(str(value))\n\n    def close(self):\n        print(\"\\n\".join(self.output))\n\n\ndef main():\n    solver = CardShuffleProblem()\n    in_obj = InputScanner(sys.stdin)\n    out_obj = OutputHandler(sys.stdout)\n    solver.compute(1, in_obj, out_obj)\n    out_obj.close()\n\n\nif __name__ =