] = mod_pow(fact[n], p - 2);\n    for (int i = n; i >= 1; --i) invfact[i - 1] = invfact[i] * i % p;\n\n    memo.assign(26, vector<ull>(n + 1, 0));\n\n    function<ull(int, int)> dfs;\n    dfs = [&](int K, int N) -> ull {\n        if (pcv[N] < K) return 0;\n        if (K == 1) return invfact[N];\n        if (memo[K][N]) return memo[K][N];\n\n        ull cur = 0;\n        int cnt = 0;\n        for (int sub = N & (N - 1); sub; sub = N & (sub - 1)) {\n            if (pcv[sub] >= K - 1) {\n                cur += dfs(K - 1, sub) * invfact[N ^ sub];\n                if (++cnt == 18) {\n                    cnt = 0;\n                    cur %= p;\n                }\n            }\n        }\n        return memo[K][N] = cur % p;\n    };\n\n    ull total = 0;\n    for (int i = lim; i >= 1; --i) total += comb(k, i) * dfs(i, n);\n\n    ull ans = (powv - total % p * fact[n] % p + p) % p;\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static long[] fact, invfact;\n    static int[] pcv;\n    static long[][] memo;\n    static int p;\n    static int n;\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        int k = sc.nextInt();\n        p = sc.nextInt();\n\n        pcv = new int[n + 1];\n        for (int i = 1; i <= n; ++i) {\n            pcv[i] = pcv[i >> 1] + (i & 1);\n        }\n\n        long powv = modPow(k, n);\n        if ((n & 1) == 1) {\n            System.out.println(powv);\n            return;\n        }\n\n        int lim = Math.min(k, pcv[n]);\n\n        int MAXN = 250010;\n        fact = new long[MAXN];\n        invfact = new long[MAXN];\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = fact[i - 1] * i % p;\n        }\n        invfact[n] = modPow(fact[n], p - 2);\n        for (int i = n; i >= 1; --i) {\n            invfact[i - 1] = invfact[i] * i % p;\n        }\n\n        memo = new long[26][n + 1];\n\n        long total = 0;\n        for (int i = lim; i >= 1; --i) {\n            total += comb(k, i) * dfs(i, n);\n        }\n\n        long ans = (powv - total % p * fact[n] % p + p) % p;\n        System.out.println(ans);\n    }\n\n    static long modPow(long base, int exp) {\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = res * base % p;\n            }\n            base = base * base % p;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static long comb(int N, int M) {\n        return fact[N] * invfact[M] % p * invfact[N - M] % p;\n    }\n\n    static long dfs(int K, int N) {\n        if (pcv[N] < K) return 0;\n        if (K == 1) return invfact[N];\n        if (memo[K][N] != 0) return memo[K][N];\n\n        long cur = 0;\n        int cnt = 0;\n        for (int sub = N & (N - 1); sub != 0; sub = N & (sub - 1)) {\n            if (pcv[sub] >= K - 1) {\n                cur += dfs(K - 1, sub) * invfact[N ^ sub];\n                ++cnt;\n                if (cnt == 18) {\n                    cnt = 0;\n                    cur %= p;\n                }\n            }\n        }\n        return memo[K][N] = cur % p;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.01156330294907093, -6.079655122448457e-06, 0.0, -1.1920928244535389e-07, -5.2927523938706145e-05, -0.00038020533975213766, -1.1920928244535389e-07, -1.0728830375228426e-06, -0.0001517419150331989, -7.64102369430475e-05, -1.4305104514278355e-06, 0.0, -5.602820692729438e-06, -0.00020549570035655051, -2.062299427052494e-05, -0.00012361239350866526, -0.0026337956078350544, -8.344646857949556e-07, 0.0, -0.02324765920639038, 0.0, -0.00020346954988781363, -1.0728830375228426e-06, 0.0, 0.0, -1.2993727978027891e-05, -1.1920928244535389e-07, -2.