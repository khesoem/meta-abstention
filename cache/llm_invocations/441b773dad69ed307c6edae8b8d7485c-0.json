1] = inv[1] = 1;\n    for (int i = 2; i <= n; ++i) {\n        fac[i] = (LL)fac[i-1] * i % MOD;\n        inv[i] = (LL)(MOD - MOD / i) * inv[MOD % i] % MOD;\n        dfac[i] = (LL)dfac[i-1] * inv[i] % MOD;\n    }\n    for (int i = 0; i <= 18; ++i)\n        for (int j = 0; j <= n; ++j)\n            f[i][j] = -1;\n    printf(\"%d\\n\", (ksm(k, n) - solve(0, n) + MOD) % MOD);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom array import array\n\ndef solve(use, S, f, fac, dfac, k, MOD, n):\n    if f[use][S] != -1:\n        return f[use][S]\n    if S == 0:\n        ret = fac[n]\n        for i in range(1, use + 1):\n            ret = (ret * (k - i + 1)) % MOD\n        f[use][S] = ret\n        return ret\n    if use > k:\n        f[use][S] = 0\n        return 0\n    low = S & -S\n    U = S - low\n    ret = 0\n    T = U\n    while True:\n        ret = (ret + dfac[S - T] * solve(use + 1, T, f, fac, dfac, k, MOD, n)) % MOD\n        if T == 0:\n            break\n        T = (T - 1) & U\n    f[use][S] = ret\n    return ret\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    MOD = int(data[2])\n    if n & 1:\n        print(pow(k, n, MOD))\n        return\n    # factorials up to n\n    fac = [0] * (n + 1)\n    dfac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    fac[0] = dfac[0] = fac[1] = dfac[1] = inv[1] = 1\n    for i in range(2, n + 1):\n        fac[i] = (fac[i-1] * i) % MOD\n        inv[i] = (MOD - MOD // i) * inv[MOD % i] % MOD\n        dfac[i] = (dfac[i-1] * inv[i]) % MOD\n    # memoization table: 19 rows, each an array of ints initialized to -1\n    f = [array('i', [-1]) * (n + 1) for _ in range(19)]\n    ans = (pow(k, n, MOD) - solve(0, n, f, fac, dfac, k, MOD, n) + MOD) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main