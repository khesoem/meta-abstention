 == '@') {\n                std::string a = q.substr(0, q.length() - 1);\n                result = a + \"at\";\n            } else {\n                result = q;\n            }\n        }\n        \n        if (s.substr(0, 2) == \"at\") {\n            std::string t = s.substr(2);\n            std::vector<std::string> parts;\n            size_t start = 0;\n            size_t end = t.find(\"dot\");\n            while (end != std::string::npos) {\n                parts.push_back(t.substr(start, end - start));\n                start = end + 3;\n                end = t.find(\"dot\", start);\n            }\n            parts.push_back(t.substr(start));\n            \n            std::string l = \"\";\n            for (size_t i = 0; i < parts.size(); ++i) {\n                if (i > 0) l += \".\";\n                l += parts[i];\n            }\n            \n            size_t b = l.find(\"at\");\n            std::string o = replace_at(l, b);\n            std::string q = \"at\" + o;\n            \n            if (!q.empty() && q.back() == '.') {\n                std::string a = q.substr(0, q.length() - 1);\n                result = a + \"dot\";\n            } else if (!q.empty() && q.back() == '@') {\n                std::string a = q.substr(0, q.length() - 1);\n                result = a + \"at\";\n            } else {\n                result = q;\n            }\n        }\n        \n        if (s.length() >= 3 && s.substr(s.length() - 3) == \"dot\" && \n            s.substr(0, 3) != \"dot\" && s.substr(0, 2) != \"at\") {\n            std::string t = s.substr(0, s.length() - 3);\n            std::vector<std::string> parts;\n            size_t start = 0;\n            size_t end = t.find(\"dot\");\n            while (end != std::string::npos) {\n                parts.push_back(t.substr(start, end - start));\n                start = end + 3;\n                end = t.find(\"dot\", start);\n            }\n            parts.push_back(t.substr(start));\n            \n            