\n\ndx = [-1, 1, 0, 0]\ndy = [0, 0, -1, 1]\n\nclass Dinic:\n    def __init__(self, n):\n        self.n = n\n        self.e = []\n        self.g = [[] for _ in range(n)]\n        self.d = [0] * n\n        self.ptr = [0] * n\n\n    def add_edge(self, a, b, cap):\n        e1 = [a, b, cap, 0]\n        e2 = [b, a, 0, 0]\n        self.g[a].append(len(self.e))\n        self.e.append(e1)\n        self.g[b].append(len(self.e))\n        self.e.append(e2)\n\n    def bfs(self, s, t):\n        q = deque()\n        q.append(s)\n        self.d = [-1] * self.n\n        self.d[s] = 0\n        while q:\n            v = q.popleft()\n            for id in self.g[v]:\n                to = self.e[id][1]\n                if self.d[to] == -1 and self.e[id][2] > self.e[id][3]:\n                    q.append(to)\n                    self.d[to] = self.d[v] + 1\n        return self.d[t] != -1\n\n    def dfs(self, v, fl, t):\n        if not fl:\n            return 0\n        if v == t:\n            return fl\n        for i in range(self.ptr[v], len(self.g[v])):\n            id = self.g[v][i]\n            to = self.e[id][1]\n            if self.d[to] != self.d[v] + 1:\n                continue\n            pushed = self.dfs(to, min(fl, self.e[id][2] - self.e[id][3]), t)\n            if pushed:\n                self.e[id][3] += pushed\n                self.e[id ^ 1][3] -= pushed\n                return pushed\n            self.ptr[v] += 1\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.ptr = [0] * self.n\n            while True:\n                pushed = self.dfs(s, INF, t)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\ndef can_reach(sx, sy, tx, ty, N, T, G1, A):\n    if G1[sx][sy] == 'Y' or G1[sx][sy] == 'Z' or G1[tx][ty] == 'Y' or G1[tx][ty] == 'Z':\n        return False\n    dist = [[INF] * N for _ in range(N)]\n    q = deque()\n    dist[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        if x == tx and y == ty:\n            return True\n        if dist[x][y] >= T or dist[x][y] >= A[x][y]:\n            continue\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 0 <= nx < N and 0 <= ny < N and G1[nx][ny] != 'Y' and G1[nx][ny] != 'Z' and dist[nx][ny] == INF and dist[x][y] + 1 <= A[nx][ny]:\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n    return False\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    T = int(next(it))\n    G1 = []\n    for _ in range(N):\n        G1.append(list(next(it)))\n    G2 = []\n    for _ in range(N):\n        G2.append(list(next(it)))\n\n    A = [[INF] * N for _ in range(N)]\n    q = deque()\n    for x in range(N):\n        for y in range(N):\n            if G1[x][y] == 'Z':\n                for d in range(4):\n                    nx = x + dx[d]\n                    ny = y + dy[d]\n                    if 0 <= nx < N and 0 <= ny < N and G1[nx][ny] != 'Y':\n                        A[nx][ny] = 1\n                        q.append((nx, ny))\n\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 0 <= nx < N and 0 <= ny < N and G1[nx][ny] != 'Y' and G1[nx][ny] != 'Z' and A[nx][ny] == INF:\n                A[nx][ny] = A[x][y] + 1\n                q.append((nx, ny))\n\n    R = [[[[False] * N for _ in range(N)] for _ in range(N)] for _ in range(N)]\n    for x1 in range(N):\n        for y1 in range(N):\n            for x2 in range(N):\n                for y2 in range(N):\n                    R[x1][y1][x2][y2] = can_reach(x1, y1, x2, y2, N, T, G1, A)\n\n    total_nodes = 2 * N * N + 2\n    din = Dinic(total_nodes)\n    s = 0\n    t = 2 * N * N + 1\n\n    for i in range(N):\n        for j in range(N):\n            if '1' <= G1[i][j] <= '9':\n                din.add_edge(s, 1 + i * N + j, ord(G1[i][j]) - ord('0'))\n            if '1' <= G2[i][j] <= '9':\n                din.add_edge(N * N + 1 + i * N + j, t, ord(G2[i][j]) - ord('0'))\n\n    for x1 in range(N):\n        for y1 in range(N):\n            for x2 in range(N):\n                for y2 in range(N):\n                    if R[x1][y1][x2][y2]:\n                        din.add_edge(1 + x1 * N + y1, N * N + 1 + x2 * N + y2, INF)\n\n    print(din.max_flow(s, t))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.4676019165781327e-05, 0.0, 0.0, -0.0002233732520835474, -0.018550360575318336, -0.00019464982324279845, -0.00010322991875000298, -0.00010823617776622996, -7.748573807475623e-06, -1.1920928244535389e-07, -1.6689286894688848e-06, -0.00419557886198163, -0.17762257158756256, -4.887569048150908e-06, -7.152531907195225e-06, -0.47464513778686523, -3.576272320060525e-06, -0.0001829695247579366, -0.3137509524822235, -0.012723341584205627, -0.0007121411035768688, -0.20170216262340546, -3.576278118089249e-07, -0.00011932138295378536, -0.16389375925064087, -0.31755295395851135, -9.83428253675811e-05, -2.90866428258596e-05, -5.960462772236497e-07, -1.0728830375228426e-06, -0.002603120170533657, -0.10095375776290894, -0.05573638901114464, -3.576278118089249e-07, -0.0007117837085388601, 0.0, 0.0, -0.008614876307547092, -1.7881377516459906e-06, -1.1920928244535389e-07, -1.311301275563892e-06, -1.1920928244535389e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.9802276912960224e-06, 0.0, 0.0, -1.1920928244535389e-07, -2.145764938177308e-06, -1.1920928244535389e-07, -4.410734163684538e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -2.50339189733495e-06, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.011050808243453503, -0.0029697385616600513, -0.00043084874050691724, 0.0, -