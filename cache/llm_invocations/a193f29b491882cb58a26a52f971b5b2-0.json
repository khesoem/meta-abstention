              d[to] = d[v] + 1;\n                }\n            }\n        }\n        return d[t] != -1;\n    }\n\n    int dfs(int v, int fl) {\n        if (!fl) return 0;\n        if (v == t) return fl;\n        for (; ptr[v] < (int)g[v].size(); ++ptr[v]) {\n            int id = g[v][ptr[v]], to = e[id].b;\n            if (d[to] != d[v] + 1) continue;\n            int pushed = dfs(to, min(fl, e[id].cap - e[id].flow));\n            if (pushed) {\n                e[id].flow += pushed;\n                e[id^1].flow -= pushed;\n                return pushed;\n            }\n        }\n        return 0;\n    }\n\n    int maxflow() {\n        int flow = 0;\n        for (;;) {\n            if (!bfs()) break;\n            memset(ptr, 0, n * sizeof ptr[0]);\n            while (int pushed = dfs(s, INF))\n                flow += pushed;\n        }\n        return flow;\n    }\n};\n\nbool canReach(int sx,int sy,int tx,int ty) {\n    if (G1[sx][sy]=='Y' || G1[sx][sy]=='Z' || G1[tx][ty]=='Y' || G1[tx][ty]=='Z')\n        return false;\n\n    int dist[MAXN][MAXN];\n    for(int i=0;i<N;i++)\n        for(int j=0;j<N;j++)\n            dist[i][j]=INF;\n\n    queue<pair<int,int>> q;\n    dist[sx][sy]=0;\n    q.push({sx,sy});\n\n    while(!q.empty()) {\n        int x=q.front().first, y=q.front().second;\n        q.pop();\n        if (x==tx && y==ty) return true;\n        if (dist[x][y] >= T || dist[x][y] >= A[x][y]) continue;\n        for(int d=0;d<4;d++) {\n            int nx=x+dx[d], ny=y+dy[d];\n            if (nx>=0 && nx<N && ny>=0 && ny<N &&\n                G1[nx][ny]!='Y' && G1[nx][ny]!='Z' &&\n                dist[nx][ny]==INF &&\n                dist[x][y]+1 <= A[nx][ny]) {\n                dist[nx][ny]=dist[x][y]+1;\n                q.push({nx,ny});\n            }\n        }\n    }\n    return false;\n}\n\nint main() {\n    scanf(\"%d%d\",&N,&T);\n    for(int i=0;i<N;i++) scanf(\"%s\",G1[i]);\n    getchar();\n    for(int i=0;i<N;i++) scanf(\"%s\",G2[i]);\n\n    for(int i=0;i<