n    global n, t, m, temp, INF\n    INF = 10**9\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    t = int(next(it))\n    m = [[False]*11 for _ in range(11)]\n    temp = [[0]*11 for _ in range(11)]\n    kaps = [[0]*11 for _ in range(11)]\n    xb = yb = 0\n    \n    e = []\n    g = [[] for _ in range(500)]\n    \n    def add_edge(a, b, cap):\n        e.append([a, b, cap, 0])\n        e.append([b, a, 0, 0])\n        g[a].append(len(e)-2)\n        g[b].append(len(e)-1)\n    \n    k = 1\n    for i in range(n):\n        for j in range(n):\n            x = next(it)\n            temp[i][j] = t\n            if x == 'Z':\n                xb, yb = i, j\n                m[i][j] = False\n            elif x == 'Y':\n                m[i][j] = False\n            else:\n                m[i][j] = True\n            cap = 0 if (x == 'Z' or x == 'Y') else ord(x)-48\n            add_edge(0, k, cap)\n            k += 1\n    k = n*n + 1\n    for i in range(n):\n        for j in range(n):\n            x = next(it)\n            if '0' <= x <= '9':\n                kaps[i][j] = ord(x)-48\n            cap = 0 if (x == 'Z' or x == 'Y') else ord(x)-48\n            add_edge(k, n*n*2+1, cap)\n            k += 1\n    \n    l = deque()\n    l.append((0, xb, yb))\n    while l:\n        v, x, y = l.popleft()\n        temp[x][y] = v\n        if x > 0 and v+1 < temp[x-1][y] and m[x-1][y]:\n            l.append((v+1, x-1, y))\n        if y > 0 and v+1 < temp[x][y-1] and m[x][y-1]:\n            l.append((v+1, x, y-1))\n        if x < n-1 and v+1 < temp[x+1][y] and m[x+1][y]:\n            l.append((v+1, x+1, y))\n        if y < n-1 and v+1 < temp[x][y+1] and m[x][y+1]:\n            l.append((v+1, x, y+1))\n    \n    def way(x1, y1, x2, y2):\n        l = deque()\n        l.append((0, x1, y1))\n        h = [[INF]*11 for _ in range(11)]\n        h[x1][y1] = 0\n        while l:\n            v, x, y = l.popleft()\n            if x > 0 and m[x-1][y] and h[x-1][y] >