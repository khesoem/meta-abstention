\n        if (i) msb[i] = 1 << (int)log2(i);\n    }\n\n    vector<vector<long long>> dp(n + 1, vector<long long>(20, 0));\n    dp[0][0] = 1;\n\n    for (int i = 1; i <= n; i++) {\n        if ((i & n) != i) continue;\n        int pb = msb[i];\n        int rem = i ^ pb;\n        for (int k = rem; ; k = (k - 1) & rem) {\n            int a = k + pb, b = i ^ a;\n            int lim = min(K - 1, bitcnt[b]);\n            long long comb = C(i, a);\n            for (int j = 0; j <= lim; j++) {\n                dp[i][j + 1] = (dp[i][j + 1] + dp[b][j] * comb) % mod;\n            }\n            if (!k) break;\n        }\n    }\n\n    long long ans = 0;\n    int top = min(bitcnt[n], K);\n    for (int j = 1; j <= top; j++) {\n        ans = (ans + dp[n][j] * C(K, j) % mod * fact[j]) % mod;\n    }\n    ans = (mod_pow(K, n, mod) - ans + mod) % mod;\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef mod_pow(b, e, m):\n    r = 1\n    while e:\n        if e & 1:\n            r = (r * b) % m\n        b = (b * b) % m\n        e >>= 1\n    return r\n\ndef main():\n    input = sys.stdin.readline\n    n, K, mod = map(int, input().split())\n    \n    if n & 1:\n        print(mod_pow(K, n, mod))\n        return\n\n    fact = [1] * (n + 1)\n    invfact = [1] * (n + 1)\n    fact[0] = 1\n    for i in range(1, n + 1):\n        fact[i] = fact[i - 1] * i % mod\n\n    invfact[n] = mod_pow(fact[n], mod - 2, mod)\n    for i in range(n, 0, -1):\n        invfact[i - 1] = invfact[i] * i % mod\n\n    def C(nn, kk):\n        if kk < 0 or kk > nn:\n            return 0\n        return fact[nn] * invfact[kk] % mod * invfact[nn - kk] % mod\n\n    bitcnt = [0] * (n + 1)\n    msb = [0] * (n + 1)\n    for i in range(1, n + 1):\n        tmp = i\n        cnt = 0\n        while tmp:\n            cnt += 1\n            tmp &= tmp - 