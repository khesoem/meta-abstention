lic double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        public String nextLine() {\n            try {\n                if (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                }\n                return tokenizer.nextToken(\"\\n\");\n            } catch (IOException e) {\n                System.err.println(e);\n                return \"\";\n            }\n        }\n    }\n\n    private static final long MOD = 998244353L;\n    private static final int MAX_N = 200005;\n    private static final long[] factorial = new long[MAX_N];\n\n    private static long modPow(long base, long exp, long mod) {\n        if (exp == 0) return 1L;\n        if (exp % 2 == 1) return base * modPow(base, exp - 1, mod) % mod;\n        return modPow(base * base % mod, exp / 2, mod) % mod;\n    }\n\n    private static long nCr(int n, int r) {\n        if (r > n) return 0L;\n        return factorial[n] * modPow(factorial[r], MOD - 2, MOD) % MOD\n                * modPow(factorial[n - r], MOD - 2, MOD) % MOD;\n    }\n\n    private static long compute(int n, int k) {\n        long result = 0;\n        for (int i = 0; i <= n - k; i++) {\n            long term = nCr(n - k, i) * modPow(n - k - i, n, MOD) % MOD;\n            if (i % 2 == 0) {\n                result = (result + term) % MOD;\n            } else {\n                result = (result - term + MOD) % MOD;\n            }\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner();\n        int t = 1;\n        for (int caseNum = 1; caseNum <= t; caseNum++) {\n            long n = scanner.nextLong();\n            long k = scanner.nextLong();\n\n            factorial[0] = 1;\n            for (long i = 1; i <= n; i++) {\n                factorial[(int) i] = factorial[(int) (i - 1)] * i % MOD;\n            }\n\n            if (k >= n) {\n             