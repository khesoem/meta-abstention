final int N = 30000, M = 7010010;\n        int[] h, ing, pre, to = new int[M], ne = new int[M];\n        long[] cap = new long[M], dis = new long[N], cost = new long[M];\n        int e, s, t, n;\n\n        void ini(int _n) {\n            Arrays.fill(h, -1);\n            e = 0;\n            n = _n;\n        }\n\n        void liu(int u, int v, long c, long w) {\n            to[e] = v;\n            ne[e] = h[u];\n            cap[e] = c;\n            cost[e] = w;\n            h[u] = e++;\n        }\n\n        void link(int u, int v, long c, long w) {\n            liu(u, v, c, w);\n            liu(v, u, 0, -w);\n        }\n\n        boolean spfa() {\n            Queue<Integer> Q = new LinkedList<>();\n            Arrays.fill(dis, Long.MAX_VALUE);\n            Arrays.fill(ing, 0);\n            Q.add(s);\n            ing[s] = 1;\n            dis[s] = 0;\n            while (!Q.isEmpty()) {\n                int c = Q.poll();\n                ing[c] = 0;\n                for (int k = h[c]; k != -1; k = ne[k]) {\n                    if (cap[k] > 0) {\n                        int v = to[k];\n                        if (dis[c] + cost[k] < dis[v]) {\n                            dis[v] = dis[c] + cost[k];\n                            pre[v] = k;\n                            if (!ing[v]) {\n                                Q.add(v);\n                                ing[v] = 1;\n                            }\n                        }\n                    }\n                }\n            }\n            return dis[t] != Long.MAX_VALUE;\n        }\n\n        long flow, mincost;\n\n        Pair run(int _s, int _t) {\n            s = _s;\n            t = _t;\n            flow = mincost = 0;\n            while (spfa()) {\n                long pl = Long.MAX_VALUE;\n                int p, k;\n                for (p = t; p != s; p = to[k ^ 1]) {\n                    pl = Math.min(pl, cap[k = pre[p]]);\n                }\n                for (p = t; p != s; p = to[k ^ 1]) {\n                    cap[k = pre[p]] -= pl;\n                    cap[k ^ 1] += pl;\n                }\n                mincost += pl * dis[t];\n                flow += pl;\n            }\n            return new Pair(flow, mincost);\n        }\n    }\n\n    static class Pair {\n        long first, second;\n\n        Pair(long first, long second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        MCMF flow = new MCMF();\n        flow.ini(50 * 50 * 4 + 10);\n        int s = flow.n - 2;\n        int t = flow.n - 3;\n        int cnt = 0;\n        int mx = 100;\n        int[][] id = new int[n + 1][mx + 1];\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= mx; j++) {\n                id[i][j] = ++cnt;\n            }\n        }\n        int[] a = new int[k + 1];\n        for (int i = 1; i <= k; i++) {\n            st = new StringTokenizer(br.readLine());\n            a[i] = Integer.parseInt(st.nextToken());\n        }\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            for (int j = 0; j <= mx; j++) {\n                for (int h = 1; h <= k; h++) {\n                    long tmp = h * h * d - (h - 1) * (h - 1) * d;\n                    flow.link(id[u][j], id[v][j + 1], 1, c + tmp);\n                    flow.link(id[v][j], id[u][j + 1], 1, c + tmp);\n                }\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= mx; j++) {\n                flow.link(id[i][j], id[i][j + 1], Long.MAX_VALUE, c);\n            }\n        }\n        for (int i = 1; i <= k; i++) {\n            flow.link(s, id[a[i]][0], 1, 0);\n        }\n        for (int j = 1; j <= mx; j++) {\n            flow.link(id[1][j], t, Long.MAX_VALUE, 0);\n        }\n        long ans = flow.run(s, t).second;\n        System.out.println(ans);\n    }\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.07306885719299316, -0.010006616823375225, -0.161934033036232, -0.009214464575052261, -0.00020058974041603506, -0.349133163690567, -0.5771905183792114, -0.0003572148270905018, -2.360371763643343e-05, -0.013623468577861786, -0.09114829450845718, -0.03240085393190384, -2.9921979148639366e-05, -0.04166652262210846, -0.20746882259845734, -0.16131232678890228, -0.14830394089221954, -0.40381231904029846, -0.7294101715087891, -0.000800512672867626, -0.0007345393532887101, -0.09010551869869232, -0.0005255530122667551, -0.6786335706710815, -0.7240901589393616, -0.006880775094032288, -0.023368198424577713, -0.00024089138605631888, -0.0016522937221452594, -0.045834582298994064, -0.05235571041703224, -0.13020485639572144, -0.00028453345294110477, -1.978893851628527e-05, -0.0004988961154595017, -0.0014252085238695145, -0.002302255015820265, -0.00041570959729142487, -0.058432262390851974, -4.94730775244534e-05, -0.012013907544314861, -0.5429620742797852, -0.006592798978090286, -0.06185435503721237, -0.007196810096502304, -0.0029482152312994003, -0.001390947261825204, -0.31567955017089844, -0.0906662866473198, -0.3988785743713379, -1.1086525773862377e-05, -1.7881409348774469e-06, -0.0002808369172271341, -0.22721318900585175, -0.08710284531116486, -0.0020525644067674875, -6.318112355074845e-06, -8.344653679159819e-07, -3.635949542513117e-05, -0.6989234089851379, -1.3709161976294126e-05, -0.36240068078041077, -0.11093537509441376, -0.007035749033