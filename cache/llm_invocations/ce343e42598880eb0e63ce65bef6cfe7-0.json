 = k + 1\n    \n    class Mat:\n        def __init__(self):\n            self.a = [[0] * MM_N for _ in range(MM_N)]\n        \n        def plus(self):\n            for i in range(mm_n):\n                for j in range(mm_n):\n                    self.a[i][j] = (self.a[i][j] % mo + mo) % mo\n        \n        def copy(self):\n            new_mat = Mat()\n            for i in range(mm_n):\n                for j in range(mm_n):\n                    new_mat.a[i][j] = self.a[i][j]\n            return new_mat\n    \n    one = Mat()\n    for i in range(mm_n):\n        one.a[i][i] = 1\n    \n    def mat_mult(a, b):\n        ans = [[0] * MM_N for _ in range(MM_N)]\n        infa = 8 * 10**18\n        for k in range(mm_n):\n            for i in range(mm_n):\n                for j in range(mm_n):\n                    ans[i][j] += a.a[i][k] * b.a[k][j]\n                    if ans[i][j] >= infa:\n                        ans[i][j] %= mo\n        c = Mat()\n        for i in range(mm_n):\n            for j in range(mm_n):\n                c.a[i][j] = ans[i][j] % mo\n        return c\n    \n    def mat_pow(a, b):\n        a = a.copy()\n        a.plus()\n        n = one.copy()\n        while b > 0:\n            if b & 1:\n                n = mat_mult(n, a)\n            a = mat_mult(a, a)\n            b >>= 1\n        return n\n    \n    def jia(x, d):\n        ret = Mat()\n        for i in range(mm_n):\n            for j in range(mm_n):\n                new_i = (i + d) % (mm_n - 1) if i != mm_n - 1 else mm_n - 1\n                new_j = (j + d) % (mm_n - 1) if j != mm_n - 1 else mm_n - 1\n                ret.a[new_i][new_j] = x.a[i][j]\n        return ret\n    \n    tot = 0\n    nu = []\n    if n == 0:\n        nu.append(0)\n    else:\n        while n > 0:\n            nu.append(n % k)\n            n //= k\n            tot += 1\n    \n    a = [Mat() for _ in range(100)]\n    \n    for j in range(k + 1):\n        a[0].a[0][j] = 1\n    for j in range(k + 1):\n        a[0].a[j][j] = 1\n    \n    for i in range(1, tot):\n        now = one.copy()\n        for j in range(k):\n            now = mat_mult(now, jia(a[i-1], j))\n        a[i] = now.copy()\n    \n    ad = 0\n    ans = one.copy()\n    for i in range(tot - 1, -1, -1):\n        for j in range(nu[i]):\n            ans = mat_mult(ans, jia(a[i], (j + ad) % k))\n        ad = (ad + nu[i]) % k\n    \n    ret = 0\n    for i in range(k + 1):\n        ret = upmo(ret, ans.a[i][k])\n    \n    print(ret)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00026174934464506805, -1.1920922133867862e-06, -4.768370445162873e-07, -0.04045155644416809, -0.00025948495022021234, -0.0010350352386012673, -0.11609923094511032, -0.6508708596229553, -0.008724665269255638, -2.3841855067985307e-07, -3.933898824470816e-06, -1.680836794548668e-05, -5.125986263010418e-06, -0.0019760860595852137, -0.22546076774597168, -0.001327705685980618, -0.07068681716918945, -0.6667805314064026, -0.2600209414958954, -2.3841855067985307e-07, -0.02630799449980259, -0.0017134760273620486, -0.3021334409713745, -5.006777428206988e-06, -2.3841855067985307e-07, -0.12490792572498322, -0.05548075959086418, -4.768360213347478e-06, -0.008615585044026375, -1.4424220353248529e-05, -8.272782724816352e-05, -8.344646857949556e-07, -0.005487853195518255, 0.0, 0.0, -2.1934269170742482e-05, 0.0, -0.0003800861886702478, 0.0, -1.1920928244535389e-07, -1.1086402082582936e-05, -0.3873429298400879, -0.39658939838409424, -1.5497195136049413e-06, -1.0967194612021558e-05, -0.7728102207183838, -1.1920928244535389e-07, -9.059865078597795e-06, 0.0, -4.768370445162873e-07, -0.0009120118920691311, -1.0728830375228426e-06, -2.264974000354414e-06, 0.0, -1.1920922133867862e-06, -0.03812748193740845, -1.5497195136049413e-06, -0.0015825617592781782, -8.34461570775602e-06, 0.0, -5.960462772236497e-07, -8.344646857949556e-07, -4.434487345861271e-05, -0.017727384343743324, -5.602820692729438e-06, -0.4316730