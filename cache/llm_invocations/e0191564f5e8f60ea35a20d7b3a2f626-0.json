            \n            return buffer.substr(start, pos - start);\n        }\n    }\n\n    int nextInt() {\n        std::string token = next();\n        try {\n            return std::stoi(token);\n        } catch (...) {\n            throw std::runtime_error(\"Invalid integer: \" + token);\n        }\n    }\n\n    void close() {\n        // Nothing to close for standard streams\n    }\n};\n\nint main() {\n    FastScanner fs(std::cin);\n    int n = fs.nextInt();\n    int B = fs.nextInt();\n    std::vector<int> arr(n);\n    for (int i = 0; i < n; i++) {\n        arr[i] = fs.nextInt();\n    }\n\n    std::vector<int> candidateDiffs;\n    int evenCount = 0, oddCount = 0;\n\n    for (int i = 0; i < n - 1; i++) {\n        if (arr[i] % 2 == 0) evenCount++;\n        else oddCount++;\n\n        if (evenCount == oddCount) {\n            candidateDiffs.push_back(std::abs(arr[i] - arr[i + 1]));\n        }\n    }\n\n    std::sort(candidateDiffs.begin(), candidateDiffs.end());\n\n    int spent = 0;\n    int selected = 0;\n    for (int diff : candidateDiffs) {\n        if (spent + diff > B) break;\n        spent += diff;\n        selected++;\n    }\n\n    std::cout << selected << std::endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012385078298393637, -7.390948667307384e-06, -2.3841855067985307e-07, -0.00015269544383045286, -9.536738616588991e-07, -6.318072337307967e-06, -9.536738616588991e-07, -5.960462772236497e-07, -1.311301275563892e-06, -0.0012285312404856086, -1.4305104514278355e-06, -1.490105023549404e-05, -2.3841855067985307e-07, -0.0019946456886827946, -3.576278118089249e-07, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.09060457348823547, -2.1934269170742482e-05, -5.1616290875244886e-05, -1.0728830375228426e-06, -0.5042720437049866, -0.00040082051418721676, -2.8132995794294402e-05, -9.775113539944869e-06, -0.009695582091808319, -0.17974993586540222, -1.0371154530730564e-05, -1.1920922133867862e-06, -0.75