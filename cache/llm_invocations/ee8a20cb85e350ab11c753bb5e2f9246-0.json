lse);\n\tcin.tie(0); cout.tie(0);\n\tcin >> n >> m >> mod;\n\n\tfor (int i = 0; i <= m; ++i) {\n\t\tC[i][0] = 1;\n\t\tfor (int j = 1; j <= i; ++j)\n\t\t\tC[i][j] = add(C[i-1][j-1], C[i-1][j]);\n\t}\n\n\tway[0] = 1;\n\tfor (int i = 1; i <= m; ++i)\n\t\tfor (int j = 0; j < i; ++j) {\n\t\t\tint c = C[i-1][j];\n\t\t\tway[i] = add(way[i], mul(mul(i+1, c), mul(way[j], way[i-j-1])));\n\t\t\tsum[i] = add(sum[i], mul(mul(mul(add(get(j), get(i-j-1)), way[j]), way[i-j-1]), c));\n\t\t\tsum[i] = add(sum[i], mul(mul(i+1, add(mul(sum[j], way[i-j-1]), mul(way[j], sum[i-j-1]))), c));\n\t\t}\n\n\tn++;\n\tcalcF(n, m);\n\tcalcG(n, m);\n\tcout << g[n][m] << endl;\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(10000)\n\ndef add(a, b):\n    return (a + b) % mod\n\ndef mul(a, b):\n    return (a * b) % mod\n\ndef get(i):\n    return i * (i + 1) // 2\n\ndef calcF(i, j):\n    if i == 0 and j == 0:\n        return 1\n    if visF[i][j]:\n        return f[i][j]\n    visF[i][j] = True\n    res = 0\n    for k in range(0, min(j, i - 1) + 1):\n        ni = i - k - 1\n        nj = j - k\n        res = add(res, mul(mul(calcF(ni, nj), way[k]), C[j][nj]))\n    f[i][j] = res\n    return res\n\ndef calcG(i, j):\n    if i == 0 and j == 0:\n        return 0\n    if visG[i][j]:\n        return g[i][j]\n    visG[i][j] = True\n    res = 0\n    for k in range(0, min(j, i - 1) + 1):\n        ni = i - k - 1\n        nj = j - k\n        a = mul(calcF(ni, nj), sum[k])\n        b = mul(calcG(ni, nj), way[k])\n        res = add(res, mul(add(a, b), C[j][nj]))\n    g[i][j] = res\n    return res\n\ndef main():\n    global mod, C, way, sum, f, g, visF, visG\n    data = sys.stdin.readline().strip().split()\n    if not data:\n        return\n    n, m, mod = map(int, data)\n    \n    # Precompute binomial coefficients up to m\n    C = [[0] * (m + 1) for _ 