][R]));\n}\n\nvoid dfsR(int id,int a,int b,int mask,ll p){\n if(id==C+1){dpR[a].push_back({p,mask});return;}\n dfsR(id+1,a-1,b,mask^(1<<id),p+(comb[a][R]-comb[a-1][R])*(comb[R+C][R]-comb[b][R]));\n dfsR(id+1,a,b-1,mask,p-(comb[b][R]-comb[b-1][R])*(comb[R+C][R]-comb[a][R]));\n}\n\nll ans=0;\n\nint rev(int x,int y){\n int z=0;\n for(int i=0;i<y;i++)if(x&(1<<i))z^=1<<(y-1-i);\n return z;\n}\n\nvoid check(ll x,int t){\n int a=0,b=0;\n for(int i=0;i<=2*C+1;i++){\n  if(x&(1LL<<i))a++;else b++;\n  if(a&&b){\n   for(int j=i;j<=2*C+1;j++){\n    if(x&(1LL<<j)){if(S[S.size()-(2*C+2)+j]=='B')return;}\n    else{if(S[S.size()-(2*C+2)+j]=='A')return;}\n   }\n   int aa=0,bb=0;\n   for(int j=0;j<S.size()-(2*C+2)+i;j++){\n    if(S[j]=='A')aa++;\n    if(S[j]=='B')bb++;\n   }\n   ll tmp;\n   if(x&(1LL<<i))tmp=comb[R-1-aa+b+R-1-bb][R-1-aa];\n   else tmp=comb[a+R-1-aa+R-1-bb][a+R-1-aa];\n   ans+=t*tmp;\n   return;\n  }\n }\n}\n\nbool ok(ll x){\n for(int i=0;i<=C;i++){\n  if(x&(1<<i)){if(S[S.size()-C-1+i]=='B')return 0;}\n  else{if(S[S.size()-C-1+i]=='A')return 0;}\n }\n return 1;\n}\n\nint main(){\n init();\n dfsL(0,R-1,R-1,0,0);\n dfsR(0,R+C,R+C,0,0);\n ll dif=INF;\n for(int i=0;i<=R+C;i++){\n  sort(dpL[i].begin(),dpL[i].end());\n  sort(dpR[i].begin(),dpR[i].end(),greater<pair<ll,int>>());\n  int idx=0;\n  for(auto&p:dpL[i]){\n   while(idx+1<dpR[i].size()&&p.first+dpR[i][idx+1].first>=0)idx++;\n   dif=min(dif,abs(p.first+dpR[i][idx].first));\n   if(idx+1<dpR[i].size())dif=min(dif,abs(p.first+dpR[i][idx+1].first));\n  }\n }\n for(int i=0;i<=R+C;i++){\n  vector<pair<ll,int>> z;\n  for(auto&p:dpR[i])if(ok(rev(p.second,C+1)))z.push_back(p);\n  int l=0,r=-1;\n  for(auto&p:dpL[i]){\n   while(l<z.size()&&p.first+z[l].first>dif)l++;\n   while(r+1<z.size()&&p.first+z[r+1].first>=-dif)r++;\n   if(l<=r)check(p.second|(rev(z[l].second,C+1)<<(C+1)),r-l+1);\n  }\n }\n cout<<ans<<'\\n';\n return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4