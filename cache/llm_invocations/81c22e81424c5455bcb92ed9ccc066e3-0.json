= [0]  # mutable to allow modification inside check\n\n    def check(x, t):\n        a = 0\n        b = 0\n        for i in range(2*C+2):\n            if x & (1 << i):\n                a += 1\n            else:\n                b += 1\n            if a and b:\n                # check remaining bits from i to 2*C+1\n                for j in range(i, 2*C+2):\n                    if x & (1 << j):\n                        if S[len(S)-(2*C+2)+j] == 'B':\n                            return\n                    else:\n                        if S[len(S)-(2*C+2)+j] == 'A':\n                            return\n                # count A and B before position i\n                aa = 0\n                bb = 0\n                for j in range(len(S)-(2*C+2)+i):\n                    if S[j] == 'A':\n                        aa += 1\n                    if S[j] == 'B':\n                        bb += 1\n                # compute combinatorial term\n                if x & (1 << i):\n                    tmp = comb[R-1-aa + b + R-1-bb][R-1-aa]\n                else:\n                    tmp = comb[a + R-1-aa + R-1-bb][a + R-1-aa]\n                ans[0] += t * tmp\n                return\n\n    # perform DFS\n    dfsL(0, R-1, R-1, 0, 0)\n    dfsR(0, R+C, R+C, 0, 0)\n\n    # compute dif\n    dif = INF\n    for i in range(R+C+1):\n        dpL[i].sort(key=lambda x: x[0])\n        dpR[i].sort(key=lambda x: x[0], reverse=True)\n        idx = 0\n        for p in dpL[i]:\n            while idx+1 < len(dpR[i]) and p[0] + dpR[i][idx+1][0] >= 0:\n                idx += 1\n            dif = min(dif, abs(p[0] + dpR[i][idx][0]))\n            if idx+1 < len(dpR[i]):\n                dif = min(dif, abs(p[0] + dpR[i][idx+1][0]))\n\n    # second loop\n    for i in range(R+C+1):\n        z = []\n        for p in dpR[i]:\n            if ok(rev(p[1], C+1)):\n                z.append(p)\n        l = 0\n        r = -1\n        for p in dpL[i]:\n            while l < len(z) and p[0] + z[l][0] > dif:\n        