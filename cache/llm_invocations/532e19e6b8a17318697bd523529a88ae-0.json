nt(data[1])\n    p = int(data[2])\n    \n    nn = n\n    for i in range(n + 1):\n        if (n & i) == i:\n            t = 0\n            for j in range(20):\n                if n & (1 << j):\n                    t <<= 1\n                    t |= (i >> j & 1)\n            f_arr[t] = i\n            nn = t\n    \n    if n & 1:\n        print(modpow(k, n, p))\n        return\n    \n    fact[0] = 1\n    for i in range(1, MAXN):\n        fact[i] = modmul(fact[i-1], i, p)\n    for i in range(MAXN):\n        invfact[i] = modinv(fact[i], p)\n    \n    a = [0] * (nn + 1)\n    for i in range(nn + 1):\n        a[i] = invfact[f_arr[i]]\n    \n    res = modpow(k, n, p)\n    a = subset_convolution(a, k, p)\n    res = modsub(res, modmul(a[nn], fact[n], p), p)\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00020919041708111763, -1.1920922133867862e-06, -1.1920922133867862e-06, -0.05218261852860451, -0.003796870354562998, -0.17984464764595032, -0.49302560091018677, -9.536738616588991e-07, 0.0, 0.0, -1.1920928244535389e-07, -0.0002967870968859643, 0.0, -0.0001431601122021675, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1086402082582936e-05, -0.004622132051736116, -7.497983460780233e-05, -9.536738616588991e-07, -0.0009966888464987278, 0.0, -6.23445157543756e-05, -0.0032133632339537144, -1.1920928244535389e-07, -8.106198947643861e-06, -0.0003660247311927378, -0.02118191309273243, -3.6954811548639555e-06, -1.6689286894688848e-06, 0.0, -3.3378546504536644e-06, -2.3841855067985307e-07, -0.05094820261001587, -0.06044352054595947, -6.437280717364047e-06, -1.5497195136049413e-06, -4.768370445162873e-07, -2.3841855067985307e-07, -5.960462772236497e-07, -3.576278118089249e-07, -4.768360213347478e-06, -1.1920928244535389e-07, -0.00043442347669042647, -4.172316494077677e-06, -5.722029527532868e-06, -3.576278118089249e-07, -7.152555099310121e-07, -4.768370445162873e-0