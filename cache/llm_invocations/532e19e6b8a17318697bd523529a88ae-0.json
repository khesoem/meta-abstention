{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define rep(i, a, b) for(int i = (a); i < (b); ++i)\n#define repr(i, a, b) for(int i = (a)-1; i >= (b); --i)\n#define all(x) (x).begin(), (x).end()\n#define sz(x) (int)(x).size()\n#define pb push_back\n#define mp make_pair\n#define fi first\n#define se second\ntypedef long long ll;\ntypedef pair<int, int> pii;\ntypedef vector<int> vi;\n\nconst int MOD = 1000000007;\nconst int INF = 1e9;\n\ninline ll gcd(ll a, ll b) { return b ? gcd(b, a % b) : a; }\ninline ll lcm(ll a, ll b) { return a / gcd(a, b) * b; }\n\nll modpow(ll base, ll exp, ll mod) {\n    ll result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\ninline int modadd(int a, int b, int mod = MOD) {\n    a += b;\n    if (a >= mod) a -= mod;\n    return a;\n}\n\ninline int modsub(int a, int b, int mod = MOD) {\n    a -= b;\n    if (a < 0) a += mod;\n    return a;\n}\n\ninline int modmul(int a, int b, int mod = MOD) {\n    return (int)((ll)a * b % mod);\n}\n\ninline int modinv(int a, int mod = MOD) {\n    return modpow(a, mod - 2, mod);\n}\n\nvoid fwht(int *a, int n, bool invert) {\n    for (int len = 1; len < n; len <<= 1) {\n        for (int i = 0; i < n; i += len << 1) {\n            for (int j = 0; j < len; ++j) {\n                int x = a[i + j], y = a[i + j + len];\n                if (!invert) {\n                    a[i + j] = modadd(x, y);\n                    a[i + j + len] = x;\n                } else {\n                    a[i + j] = modadd(x, modsub(y));\n                    a[i + j + len] = y;\n                }\n            }\n        }\n    }\n}\n\nvector<int> subset_convolution(vector<int> a, int k, int mod) {\n    int n = a.size();\n    int N = 1;\n    while (N < n) N <<= 1;\n    a.resize(N);\n    \n    const int LOG = 19;\n    vector<vector<int>> f(LOG, vector<int>(N, 0));\n    \n    for (int i = 0; i < LOG; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (__builtin_popcount(j) == i) {\n                f[i][j] = (j < (int)a.size()) ? a[j] : 0;\n            }\n        }\n        fwht(f[i].data(), N, false);\n    }\n    \n    vector<vector<int>> g(LOG, vector<int>(N, 0));\n    \n    for (int i = 0; i < N; ++i) {\n        vector<int> vals(LOG);\n        for (int j = 0; j < LOG; ++j) {\n            vals[j] = f[j][i];\n        }\n        \n        vector<int> res(LOG, 0);\n        res[0] = 1;\n        for (int _ = 0; _ < k; ++_) {\n            vector<int> tmp(LOG, 0);\n            for (int j = 0; j < LOG; ++j) {\n                for (int l = 0; l + j < LOG; ++l) {\n                    tmp[j + l] = modadd(tmp[j + l], modmul(res[j], vals[l], mod), mod);\n                }\n            }\n            res = tmp;\n        }\n        \n        for (int j = 0; j < LOG; ++j) {\n            g[j][i] = res[j];\n        }\n    }\n    \n    vector<int> result(N, 0);\n    for (int i = 0; i < LOG; ++i) {\n        vector<int> temp = g[i];\n        fwht(temp.data(), N, true);\n        for (int j = 0