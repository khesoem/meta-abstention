{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n//typedef long double ld;\n\nconst int maxn=5007;\n\n//const ll INF = 1e18;\nconst ll INF =  1e9;\nconst ll mod = 1e9+7;\n\nstruct Edge {\n    int from,to;\n    ll cap, cost, flow;\n    Edge(int from, int to, ll cap, ll cost): from(from), to(to), cap(cap), cost(cost), flow(0) {};\n};\n\nvector<Edge> edges;\nll d[maxn], phi[maxn];\nvector<int> g[maxn];\nint par[maxn];\n\nvoid add_edge(int u, int v, ll cap, ll cost) {\n    g[u].push_back(edges.size());\n    edges.push_back({u,v,cap,cost});\n    g[v].push_back(edges.size());\n    edges.push_back({v,u,0,-cost});\n}\nvoid ford_bellman(int s, int n) {\n    for (int i=0;i<maxn;i++) {\n        phi[i] = INF;\n    }\n    phi[s] = 0;\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<edges.size();j++) {\n            if (edges[j].cap==edges[j].flow) continue;\n            int from = edges[j].from;\n            int to = edges[j].to;\n            ll len = edges[j].cost;\n            if (phi[from]==INF) continue;\n            phi[to] = min(phi[to], phi[from]+len);\n        }\n    }\n}\n\nvoid dijkstra(int s) {\n    for (int i=0;i<maxn;i++) {\n        d[i] = INF;\n    }\n    d[s] = 0;\n    set<pair<ll,int>> q;\n    q.insert({0,s});\n    while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i=0;i<g[v].size();i++) {\n            int eid = g[v][i];\n            if (edges[eid].cap==edges[eid].flow) continue;\n            int to = edges[eid].to;\n            ll len = edges[eid].cost + phi[v] - phi[to];\n            if (d[v]+len<d[to]) {\n                q.erase({d[to],to});\n                d[to] = d[v]+len;\n                par[to] = eid;\n                q.insert({d[to],to});\n            }\n        }\n    }\n}\n\npair<ll,ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (1) {\n        if (d[t]==INF) break;\n        ll pushed=  INF, sum = 0;\n        for (int tmp = t;tmp!=s;) {\n//            if (tmp==100) {\n//                cout << \"xyu\";\n//            }\n            int eid = par[tmp];\n            pushed = min(pushed, edges[eid].cap-edges[eid].flow);\n            sum+=edges[eid].cost;\n            tmp = edges[eid].from;\n        }\n        flow+=pushed;\n        cost+=pushed*sum;\n        //cout << \"flow: \" << flow << \", cost: \" << cost << endl <<  t << \" \";\n        for (int tmp=t;tmp!=s;) {\n            int eid = par[tmp];\n            edges[eid].flow+=pushed;\n            edges[eid^1].flow-=pushed;\n            tmp = edges[eid].from;\n          //  cout << tmp << \" \";\n        }\n        //cout << endl;\n\n        dijkstra(s);\n        for (int i=0;i<maxn;i++) {\n            phi[i] = d[i];\n        }\n    }\n    return {cost, flow};\n}\nvoid solve() {\n    int n,m,k,c,d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnts(n,0);\n    for (int i=0;i<k;i++) {\n        int ai;\n        cin >> ai;\n        ai--;\n        cnts[ai]++;\n    }\n    for (int i=0;i<n;i++) {\n        add_edge(5000, i, cnts[i],0);\n    }\n    for (int it=0;it<m;it++) {\n        int u,v;\n        cin >> u >> v;\n        u--; v--;\n        for (int i=0;i<99;i++) {\n            ll cost = d;\n            for (int j=0;j<50;j++) {\n                add_edge(u+i*50, v+(i+1)*50, 1, cost);\n                add_edge(v+i*50, u+(i+1)*50, 1, cost);\n                cost+=2*d;\n            }\n        }\n    }\n    for (int i=0;i<=99;i++) {\n        add_edge(0+i*50, 5001, INF, c*i);\n    }\n\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<99;j++) {\n            add_edge(i+j*50, i+(j+1)*50, INF, 0);\n        }\n    }\n    //add_edge(0+99*50, 5001, INF, 0);\n\n    auto p = mincost_maxflow(5000, 5001);\n    assert(p.second==k);\n    cout << p.first;\n}\nint main() {\n    cin.tie(0);\n    cout.tie(0);\n    ios_base::sync_with_stdio(false);\n    cout << setprecision(20) << fixed;\n   // freopen(\"input.txt\",\"r\", stdin);\n//    int t;\n//    cin >> t;\n//    for (int i=0;i<t;i++)\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport heapq\n\nmaxn = 5007\nINF = 10**9\nmod = 10**9 + 7\n\nclass Edge:\n    def __init__(self, from_, to, cap, cost):\n        self.from_ = from_\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.flow = 0\n\nedges = []\ng = [[] for _ in range(maxn)]\npar = [0] * maxn\nd = [0] * maxn\nphi = [0] * maxn\n\ndef add_edge(u, v, cap, cost):\n    g[u].append(len(edges))\n    edges.append(Edge(u, v, cap, cost))\n    g[v].append(len(edges))\n    edges.append(Edge(v, u, 0, -cost))\n\ndef ford_bellman(s, n):\n    for i in range(maxn):\n        phi[i] = INF\n    phi[s] = 0\n    for _ in range(n):\n        for j in range(len(edges)):\n            e = edges[j]\n            if e.cap == e.flow:\n                continue\n            from_ = e.from_\n            to = e.to\n            len_ = e.cost\n            if phi[from_] == INF:\n                continue\n            phi[to] = min(phi[to], phi[from_] + len_)\n\ndef dijkstra(s):\n    for i in range(maxn):\n        d[i] = INF\n    d[s] = 0\n    q = []\n    heapq.heappush(q, (0, s))\n    while q:\n        dist_v, v = heapq.heappop(q)\n        if dist_v > d[v]:\n            continue\n        for eid in g[v]:\n            e = edges[eid]\n            if e.cap == e.flow:\n                continue\n            to = e.to\n            len_ = e.cost + phi[v] - phi[to]\n            if d[v] + len_ < d[to]:\n                d[to] = d[v] + len_\n                par[to] = eid\n                heapq.heappush(q, (d[to], to))\n\ndef mincost_maxflow(s, t):\n    ford_bellman(s, 50)\n    dijkstra(s)\n    flow = 0\n    cost = 0\n    while True:\n        if d[t] == INF:\n            break\n        pushed = INF\n        sum_cost = 0\n        tmp = t\n        while tmp != s:\n            eid = par[tmp]\n            e = edges[eid]\n            pushed = min(pushed, e.cap - e.flow)\n            sum_cost += e.cost\n            tmp = e.from_\n        flow += pushed\n        cost += pushed * sum_cost\n        tmp = t\n        while tmp != s:\n            eid = par[tmp]\n            edges[eid].flow += pushed\n            edges[eid ^ 1].flow -= pushed\n            tmp = edges[eid].from_\n        dijkstra(s)\n        for i in range(maxn):\n            phi[i] = d[i]\n    return (cost, flow)\n\ndef solve():\n    input = sys.stdin.read\n    data = input().split()\n    n, m, k, c, d = map(int, data[0:5])\n    cnts = [0] * n\n    idx = 5\n    for _ in range(k):\n        ai = int(data[idx]) - 1\n        idx += 1\n        cnts[ai] += 1\n    for i in range(n):\n        add_edge(5000, i, cnts[i], 0)\n    for _ in range(m):\n        u = int(data[idx]) - 1\n        v = int(data[idx + 1]) - 1\n        idx += 2\n        for i in range(99):\n            cost = d\n            for j in range(50):\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cost)\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost)\n                cost += 2 * d\n    for i in range(100):\n        add_edge(i * 50, 5001, INF, c * i)\n    for i in range(n):\n        for j in range(99):\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n    cost, flow = mincost_maxflow(5000, 5001)\n    assert flow == k\n    print(cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-6.599403423024341e-05, -9.412610233994201e-05, -5.512236498361744e-07, -1.7835754988482222e-05, -0.014145639725029469, -4.1557283111615106e-05, -4.56102097814437e-05, -0.01795559749007225, -0.030458979308605194, -0.00026169343618676066, -0.08055434376001358, -0.0029155495576560497, 0.0, -0.002228525234386325, -0.2154056578874588, -1.3856492842023727e-06, -0.03804252669215202, -3.128163257315464e-07, -5.512236498361744e-07, -9.088346359931165e-07, -0.012554510496556759, -1.1279553291387856e-05, -1.3544423381972592e-05, -0.5760285258293152, -0.1602521538734436, -0.009755974635481834, -1.0564331205387134e-05, -0.4311198890209198, -0.010100039653480053, -3.452426608419046e-05, -0.0002614550176076591, -0.0005563704180531204, -1.9027791495318525e-05, 0.0, -0.06993643194437027, -0.001730510382913053, -1.9361264946837764e-07, -0.0028776300605386496, -0.00026634239475242794, -6.704273118884885e-07, -1.0280383548888494e-06, -5.512236498361744e-07, -3.03521392197581e-05, -1.1472419600977446e-06, 0.0, 0.0, -3.128163257315464e-07, -1.3856492842023727e-06, -0.082332082092762, -0.03492869809269905, -4.0126840758603066e-05, -0.0013276183744892478, -1.0921942703134846e-05, -1.0280383548888494e-06, -5.512236498361744e-07, -7.107425062713446e-06, -4.320199877838604e-07, -5.5577775128767826e-06, -1.6405310816480778e-05, -4.966313281329349e-05, -3.173704271830502e-06, -5.5577775128767826e-06, -2.963691804325208e-05, 0.0, 0.0, 0.0, -0.00011272187111899257, -4.723352049040841e-06, -1.6240566083070007e-06, 0