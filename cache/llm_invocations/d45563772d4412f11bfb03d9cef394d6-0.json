st<>();\n      for (int i = 0; i < n / 2; i++) {\n        if (s[i] != s[n - 1 - i] && s[i] != dominant && s[n - 1 - i] != dominant) {\n          cutCosts.add(Math.min(beauty[i], beauty[n - 1 - i]));\n        }\n      }\n      cutCosts.sort(Integer::compareTo);\n      int extra = 2 * freq[dominant] - eqPairs.size();\n      for (int i = 0; i < extra && i < cutCosts.size(); i++) {\n        result -= cutCosts.get(i);\n      }\n    }\n    \n    pw.println(result);\n    pw.close();\n    br.close();\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cctype>\n#include <climits>\n\nint main() {\n    int n;\n    std::cin >> n;\n    std::cin.ignore(); // Ignore newline after reading n\n    \n    std::string s;\n    std::getline(std::cin, s);\n    \n    std::vector<int> beauty(n);\n    int totalBeauty = 0;\n    \n    for (int i = 0; i < n; i++) {\n        std::cin >> beauty[i];\n        totalBeauty += beauty[i];\n    }\n    \n    std::vector<int> eqPairs;\n    int freq[128] = {0};\n    char dominant = 'a';\n    \n    for (int i = 0; i < n / 2; i++) {\n        if (s[i] == s[n - 1 - i]) {\n            eqPairs.push_back(i);\n            freq[s[i]]++;\n            if (freq[s[i]] > freq[dominant]) {\n                dominant = s[i];\n            }\n        }\n    }\n    \n    int result = totalBeauty;\n    for (int i : eqPairs) {\n        result -= std::min(beauty[i], beauty[n - 1 - i]);\n    }\n    \n    if (freq[dominant] > eqPairs.size() / 2) {\n        std::vector<int> cutCosts;\n        for (int i = 0; i < n / 2; i++) {\n            if (s[i] != s[n - 1 - i] && s[i] != dominant && s[n - 1 - i] != dominant) {\n                cutCosts.push_back(std::min(beauty[i], beauty[n - 1 - i]));\n            }\n        }\n        std::sort(cutCosts.begin(), cutCosts.end());\n        int extra = 2 * fre