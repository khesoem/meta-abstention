g best = (long) 1e18, best_z = -1;\n    static String s;\n    static int[] cntA, cntB;\n    static HashMap<Long, Long> mp;\n\n    static void dfs(long x, long y, int v1, int v2) {\n        long diff = Math.abs(x - y);\n        if (best <= 1 || diff - C[v1][r] * C[v2][r] >= best)\n            return;\n        if (v1 == r - 1 && v2 == r - 1) {\n            long diff2 = Math.abs(x - y);\n            if (diff2 < best) {\n                best = diff2;\n                best_z = x;\n            }\n            return;\n        }\n        if (v1 >= r) {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            dfs(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (v2 >= r) {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v2 - 1][r];\n            dfs(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n    }\n\n    static long solve(long x, long y, int v1, int v2) {\n        long state = x * 10000 + v1 * 100 + v2;\n        if (mp.containsKey(state))\n            return mp.get(state);\n        long res;\n        long diff = Math.abs(x - y);\n        if (diff - C[v1][r] * C[v2][r] > best) {\n            res = 0;\n            mp.put(state, res);\n            return res;\n        }\n        if (v1 < r || v2 < r) {\n            if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n                int sum = v1 + v2;\n                v1 -= cntA[sum];\n                v2 -= cntB[sum];\n                res = C[v1 + v2][v1];\n                mp.put(state, res);\n                return res;\n            }\n            res = 0;\n            mp.put(state, res);\n            return res;\n        }\n        res = 0;\n        char c = s.charAt(v1 + v2 - 1);\n        if (c != 'B') {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (c != 'A') {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v