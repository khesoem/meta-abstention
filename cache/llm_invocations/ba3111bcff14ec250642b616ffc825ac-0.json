_diff = d;\n            ans1 = a; ans2 = b;\n        }\n    }\n    printf(\"%d/%d\\n\",ans1,ans2);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nimport sys\n\nINF = 1e9\n\ndef Tabs(n):\n    return n if n >= 0 else -n\n\ndef solve_it(x, y, b):\n    target = x / y\n    lb = 0\n    ub = 1000000\n    for i in range(25):\n        a = (lb + ub) >> 1\n        if a / b < target:\n            lb = a\n        else:\n            ub = a\n    res = None\n    diff = float('inf')\n    for a in range(lb - 10, ub + 11):\n        d = Tabs(a / b - target)\n        if d < diff or (d == diff and (res is None or a < res)):\n            diff = d\n            res = a\n    return res\n\ndef main():\n    data = sys.stdin.readline().split()\n    x = int(data[0])\n    y = int(data[1])\n    n = int(data[2])\n    ans1 = 0\n    ans2 = 1\n    best_diff = float('inf')\n    for b in range(1, n + 1):\n        a = solve_it(x, y, b)\n        d = Tabs(a / b - x / y)\n        if d < best_diff or (d == best_diff and b < ans2):\n            best_diff = d\n            ans1 = a\n            ans2 = b\n    print(f\"{ans1}/{ans2}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011860620725201443, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0002498314715921879, -0.22549235820770264, -0.03804256021976471, -3.909988299710676e-05, -0.000270091783022508, -6.639736966462806e-05, -0.22606980800628662, -3.576278118089249e-07, -6.198863957251888e-06, 0.0, -1.3470558769768104e-05, -2.3841855067985307e-07, -8.344646857949556e-07, -3.814689989667386e-06, -0.00041500062798149884, -2.3841855067985307e-07, -8.344646857949556e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -9.059865078597795e-06, -0.005930683575570583, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985