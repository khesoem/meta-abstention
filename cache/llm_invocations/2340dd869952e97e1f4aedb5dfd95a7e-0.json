            }\n            a = (a * a) % p;\n            b >>= 1;\n        }\n        return (res == 1) ? (int)p : 1;\n    }\n\n    static int binpow(long a, long b) {\n        long res = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) {\n                res = (res * a) % MOD;\n            }\n            a = (a * a) % MOD;\n            b >>= 1;\n        }\n        return (int)res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n\n        if (k == 0) {\n            System.out.println(binpow(p, p - 1));\n            return;\n        }\n\n        snm = new int[p];\n        sz = new int[p];\n        for (int i = 0; i < p; i++) {\n            snm[i] = i;\n            sz[i] = 1;\n        }\n\n        for (int i = 0; i < p; i++) {\n            merge((int)((k * 1L * i) % p), i);\n        }\n\n        long ans = 1;\n        for (int i = 0; i < p; i++) {\n            if (getroot(i) == i) {\n                ans = (ans * isok(k, sz[i], p)) % MOD;\n            }\n        }\n\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-4.768370445162873e-07, 0.0, 0.0, -3.4927710657939315e-05, -2.2291887944447808e-05, 0.0, -4.8397800128441304e-05, -0.25289762020111084, -0.004083628766238689, -7.271740287251305e-06, -1.1920928244535389e-07, -0.08895941078662872, -0.029757706448435783, -0.0002329078270122409, -0.014550174586474895, -0.06199450418353081, -0.0005558376433327794, -0.011226816102862358, 0.0, -0.011048096232116222, 0.0, -0.00012337400403339416, -0.20199677348136902, -2.1576648578047752e-05, -1.4305104514278355e-06, -0.0007098776986822486, -7.152555099310121e-07, 0.0, -0.0005664412747137249, -7.867782187531702e-06, -2.0265558760002023e-06, -0.0031789029017090797, -0.0005240259342826903, -0.008625749498605728, 0.0, -0.017621155828237534, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -2.777537883