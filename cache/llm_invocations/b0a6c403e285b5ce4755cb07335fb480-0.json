    a[i] = sc.nextInt();\n        }\n        int n1 = n / 2;\n\n        List<Integer> left = new ArrayList<>();\n        List<Integer> right = new ArrayList<>();\n\n        left_dfs(a, 0, n1, m, 0, left);\n        right_dfs(a, n1, n, m, 0, right);\n\n        // Remove duplicates and sort left list\n        Set<Integer> leftSet = new HashSet<>(left);\n        List<Integer> leftSorted = new ArrayList<>(leftSet);\n        Collections.sort(leftSorted);\n\n        int result = 0;\n        for (int val : right) {\n            int target = m - val;\n            int k = Collections.binarySearch(leftSorted, target);\n            if (k < 0) {\n                k = -(k + 1);\n            }\n            if (k > 0) {\n                int temp = leftSorted.get(k - 1) + val;\n                if (temp > result) {\n                    result = temp;\n                }\n            }\n        }\n\n        System.out.println(result);\n    }\n\n    private static void left_dfs(int[] a, int i, int n1, int m, int s, List<Integer> left) {\n        if (i == n1) {\n            left.add(s);\n            return;\n        }\n        left_dfs(a, i + 1, n1, m, (s + a[i]) % m, left);\n        left_dfs(a, i + 1, n1, m, s, left);\n    }\n\n    private static void right_dfs(int[] a, int i, int n, int m, int s, List<Integer> right) {\n        if (i == n) {\n            right.add(s);\n            return;\n        }\n        right_dfs(a, i + 1, n, m, (s + a[i]) % m, right);\n        right_dfs(a, i + 1, n, m, s, right);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.772143726469949e-05, -1.311301275563892e-06, -2.3841855067985307e-07, -3.862306402879767e-05, -1.8000440832111053e-05, -0.001503052655607462, -0.03581535816192627, -2.50339189733495e-06, -1.311301275563892e-06, -0.0001280225842492655, -6.663577369181439e-05, -1.0728830375228426e-06, -0.020581956952810287, -2.3841855067985307e-07, -1.4662635294371285e-05, -2.50339189733495e-06, -1.0728830375228426e-06,