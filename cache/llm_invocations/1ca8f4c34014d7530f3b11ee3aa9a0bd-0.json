 + 2; i++) {\n                e[i] = new ArrayList<>();\n            }\n        }\n\n        void addEdge(int u, int v, int w, int c) {\n            e[u].add(new Edge(v, w, c, sz(to)));\n            to[sz(to)] = v;\n            fw[sz(to)] = w;\n            co[sz(to)] = +c;\n            e[v].add(new Edge(u, 0, -c, sz(to)));\n            to[sz(to)] = u;\n            fw[sz(to)] = 0;\n            co[sz(to)] = -c;\n        }\n\n        boolean spfa() {\n            Arrays.fill(dep, iinf);\n            Arrays.fill(pre, -1);\n            Arrays.fill(vis, false);\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            vis[s] = true;\n            dep[s] = 0;\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                vis[u] = false;\n                for (Edge edge : e[u]) {\n                    if (fw[edge.rev] > 0 && dep[edge.to] > dep[u] + co[edge.rev]) {\n                        dep[edge.to] = dep[u] + co[edge.rev];\n                        pre[edge.to] = edge.rev;\n                        if (!vis[edge.to]) {\n                            q.add(edge.to);\n                            vis[edge.to] = true;\n                        }\n                    }\n                }\n            }\n            return dep[t] < iinf;\n        }\n\n        Pair mcmf() {\n            Pair res = new Pair(0, 0);\n            while (spfa()) {\n                int f = iinf;\n                for (int u = t; u != s; u = to[pre[u] ^ 1]) {\n                    f = Math.min(f, fw[pre[u]]);\n                }\n                for (int u = t; u != s; u = to[pre[u] ^ 1]) {\n                    fw[pre[u]] -= f;\n                    fw[pre[u] ^ 1] += f;\n                }\n                res.x += f;\n                res.y += dep[t] * f;\n            }\n            return res;\n        }\n    }\n\n    static class Pair {\n        int x, y;\n\n        Pair(int x, int y) {\n            this.x = x;\n            this.y = y;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        int mxt = n * 3 + 1;\n        Flow flow = new Flow(n * mxt);\n        for (int i = 0; i < k; i++) {\n            int u = Integer.parseInt(br.readLine()) - 1;\n            flow.addEdge(flow.s, u, 1, 0);\n        }\n        while (m-- > 0) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken()) - 1;\n            int v = Integer.parseInt(st.nextToken()) - 1;\n            for (int i = 0; i < mxt - 1; i++) {\n                for (int p = 1; p <= k; p++) {\n                    flow.addEdge(i * n + u, (i + 1) * n + v, 1, 2 * d * p - d);\n                    flow.addEdge(i * n + v, (i + 1) * n + u, 1, 2 * d * p - d);\n                }\n            }\n        }\n        for (int u = 0; u < n; u++) {\n            for (int i = 0; i < mxt; i++) {\n                flow.addEdge(i * n + u, (i + 1) * n + u, k, 0);\n            }\n        }\n        for (int i = 0; i < mxt; i++) {\n            flow.addEdge(i * n + t, i * n + t, k, i * c);\n        }\n        Pair ans = flow.mcmf();\n        pw.println(ans.y);\n        pw.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.3151114583015442, -0.005452869459986687, -0.0360567606985569, -0.015420285984873772, -0.000142703705932945, -0.47450506687164307, -0.671190619468689, -0.00024279918579850346, -9.536788638797589e-06, -0.004718151409178972, -0.08464912325143814, -0.05020376294851303, -1.609338323760312e-05, -0.033