n            if last_known < n:\n                f_inv = [0.0] * (n - last_known)\n                f_inv[0] = self.inv(self.fact(n))\n                for i in range(1, len(f_inv)):\n                    f_inv[i] = self.mult(f_inv[i - 1], n - i + 1)\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(int(f_inv[i]))\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_reader, out):\n        self.n = in_reader.nextInt()\n        self.m = in_reader.nextInt()\n\n        self.mod.fInv(self.n + self.m)\n\n        phase_size = 1\n        p = 1\n        for i in range(self.n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, self.n - i, self.mod.smallInv(self.n + self.m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, self.n + 1):\n            term = self.mod.mult(self.mod.ncr(self.n, k), self.m + k, self.mod.smallInv(k), phase_size)\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out.println(answer)\n\n\ndef main():\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out = outputStream\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out)\n    outputStream.flush()\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-5.0424259825376794e-05, -9.536738616588991e-07, -4.768370445162873e-07, -0.0009873997187241912, -0.020873749628663063, -0.006957352627068758, -0.20147687196731567, -0.2728571891784668, -0.011380163952708244, -0.04362833872437477, -0.8553909063339233, -1.6689286894688848e-06, -4.410734163684538e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -8.856858039507642e-05, -1.1920922133867862e-06, -3.576278118089249e-07, -2.861018856492592e-06, -5.960462772236497e-07, -3.969590397900902e-05, -1.6212332411669195e-05, -2.861018856492592e-06, -1.2516897186287679e-05, -9.989239333663136e-05, -2.3841855067985307e-07, -0.015571909956634045, -0.00041786045767366886, -1.7881377516459906e-06, -1.728519782773219e-05, -0.0004247716860845685, -9.417489309271332e-06, -5.960462772236497e-07, -0.0006455483380705118, -0.00998856220394373, -4.768370445162873e-07, -1.1920922133867862e-06, -0.000271641067229211