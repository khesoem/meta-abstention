teger square root (floor)\nlong long isqrt(long long x) {\n    long long r = (long long) sqrt(x);\n    while ((r + 1) * (r + 1) <= x) ++r;\n    while (r * r > x) --r;\n    return r;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n\n    long long n, mod;\n    cin >> n >> mod;\n\n    vector<long long> mem;\n    mem.push_back(0);\n    mem.push_back(1);\n    long long su = 1;\n\n    for (long long i = 2; i <= n; ++i) {\n        long long sq = isqrt(i) + 1;\n        long long cur = su;\n\n        // first loop: large divisors (f from 2 to sq-1)\n        long long f = 2;\n        while (f < sq) {\n            cur = (cur + mem[i / f]) % mod;\n            ++f;\n        }\n\n        // second loop: small divisors (j from 1 to i//sq)\n        long long be = i;\n        long long j = 1;\n        long long limit = i / sq;\n        while (j <= limit) {\n            long long nxt = i / (j + 1);\n            long long add = ((be - nxt) % mod) * (mem[j] % mod) % mod;\n            cur = (cur + add) % mod;\n            be = nxt;\n            ++j;\n        }\n\n        su = (su + cur) % mod;\n        mem.push_back(cur);\n    }\n\n    cout << mem.back() << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.576278118089249e-07, 0.0, 0.0, -0.00012599628826137632, -4.410646579344757e-05, -7.152555099310121e-07, -0.0027829986065626144, -1.1444026313256472e-05, 0.0, 0.0, -0.00011514954530866817, -3.3378546504536644e-06, 0.0, 0.0, -0.00024673278676345944, -0.3135766386985779, -0.0052384971641004086, -1.1920928244535389e-07, -0.5782442092895508, -0.018173841759562492, -0.018816309049725533, -1.9311717551317997e-05, 0.0, -4.0531076592742465e-06, -0.24102425575256348, -0.693436324596405, -0.11409974098205566, -2.3841855067985307e-07, -0.012033368460834026, -5.483612312673358e-06, -0.2590923607349396, -0.12736138701438904, 0.0, -0.0007163104019127786, -4.768370445162873e-07, -3.4570634852570947e-06, 0.0, -2.26497400035