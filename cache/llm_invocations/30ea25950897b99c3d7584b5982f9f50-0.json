    // state: 0 = first visit, 1 = after processing a child, etc.\n    // We'll use explicit state to handle the block condition.\n    st.emplace(x, 0, 0, 0); // (x, phase, dummy, dummy)\n    while (!st.empty()) {\n        auto [cur, phase, _, __] = st.top(); st.pop();\n        if (phase == 0) {\n            if (cur > n) continue;\n            // Check block condition\n            if (cur * BASE + BASE - 1 <= n && cur * BASE * 10 > n) {\n                ll rk = gg;\n                for (int i = 0, bit = 1; i <= 6; ++i, bit *= 10) {\n                    int mae = ((rk - cur * bit) % MOD1 + MOD1) % MOD1;\n                    int pos = lower_bound(tab[i].begin(), tab[i].end(), -mae + MOD1) - tab[i].begin();\n                    ans = (ans + ( (1LL * mae * tab[i].size() % MOD2 + sum[i]) % MOD2 - 1LL * (tab[i].size() - pos) * MOD1 % MOD2 + MOD2) % MOD2) % MOD2;\n                    gg += tab[i].size();\n                }\n                continue; // block processed, no further recursion\n            }\n            // single number\n            ans = (ans + ((++gg) - cur + MOD1) % MOD1) % MOD2;\n            // push state to process children (digits 0..9)\n            st.emplace(cur, 1, 0, 9); // state 1, next_digit = 0, last = 9\n            // Actually we need to process digits in order 0..9.\n            // We'll push a special marker to iterate.\n            // Simpler: push a task to process children iteratively.\n            // We'll push the parent state that will push children in reverse.\n            // Alternative: use a different approach: push all children in reverse order.\n            // For state 0 we already processed current node. For children, we'll push them now in reverse.\n            // We'll push a task that after returning we need to do nothing, so we can just push children.\n            // To preserve order, push children in reverse order: 9..0.\n            for (int d = 9; d >= 0; --d) {\n                st.emplace(cur * 10 + d, 0, 0, 0);\n      