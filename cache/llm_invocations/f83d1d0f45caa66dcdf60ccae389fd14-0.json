) != i) continue;\n            now = i ^ mx[i];\n            for (k = now; k >= 0; k = (k - 1) & now) {\n                cur1 = k + mx[i];\n                cur2 = i ^ cur1;\n                up = Math.min(K - 1, cnt[cur2]);\n                tmp = C(i, cur1);\n                for (j = 0; j <= up; j++) {\n                    dp[i][j + 1] = (dp[i][j + 1] + (long) dp[cur2][j] * tmp % mod) % mod;\n                }\n                if (k == 0) break;\n            }\n        }\n        for (j = 1; j <= Math.min(cnt[n], K); j++) {\n            ans = (ans + (long) dp[n][j] * C(K, j) % mod * cj[j]) % mod;\n        }\n        ans = (power(K, n) - ans + mod) % mod;\n        writer.println(ans);\n        writer.close();\n    }\n}\n\n</translated_code>\n\n<confidence>0.95</confidence>", "token_logprobs": [-0.577834963798523, -0.0001375769788865, -0.2900533378124237, -0.128867506980896, -0.0003830928180832416, -0.0002738016191869974, -0.0012976002180948853, -0.004271677229553461, -0.0008148293709382415, -0.007953058928251266, -0.019636664539575577, -0.14307862520217896, -0.01231696642935276, -0.0017440618248656392, -0.0004170214233454317, -0.0007209395989775658, -1.0967314665322192e-05, -2.3126869564293884e-05, -0.0002530537312850356, -0.030147500336170197, -0.0003022412129212171, -0.0005037861410528421, -0.004089779686182737, -4.768372718899627e-07, -0.0007848242530599236, -0.000499969522934407, -0.005631538573652506, -0.0009424954187124968, -0.05668963864445686, -0.007629517000168562, -0.0015118815936148167, -0.0002759479684755206, -0.00016857613809406757, -0.002256015781313181, -0.0010050219716504216, -0.00195312371943146, -0.009279676713049412, -0.09668166190385818, -0.00010502889927010983, -6.318112355074845e-06, -2.5987963454099372e-05, -1.1324947081448045e-05, -3.4571290598250926e-05, -0.0015938460128381848, -0.019748032093048096, -0.0005033090710639954, -0.002045576460659504, -0.0002797637425828725, -5.972563667455688e-05, -0.004070568364113569, -0.20353233814239502, -0.02