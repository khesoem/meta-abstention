teNumbers(llong num) {\n    if (num > n) return;\n    if ((num + 1) * 1000000LL <= n + 1 && num * 10000000LL > n) {\n        process(num, counter2);\n        counter2 += counter1;\n    } else {\n        llong diff = ((counter2++ - num) % MOD2 + MOD2) % MOD2;\n        total = (total + diff) % MOD1;\n        for (int digit = (num ? 0 : 1); digit <= 9; ++digit) {\n            enumerateNumbers(num * 10 + digit);\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n;\n    buildBuckets(0, 0);\n    for (int i = 1; i <= 6; ++i) {\n        sort(bucket[i].begin(), bucket[i].end());\n    }\n    power10[0] = 1;\n    for (int i = 1; i <= 12; ++i) {\n        power10[i] = power10[i-1] * 10;\n    }\n    enumerateNumbers(0);\n    cout << ((total % MOD1) + MOD1) % MOD1 << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long MOD1 = 1000000007L;\n    static long MOD2 = 998244353L;\n    static long n;\n    static long counter1 = 0;\n    static long counter2 = 0;\n    static long total = 0;\n    static long[] power10 = new long[20];\n    static long[] prefixSum = new long[10];\n    static List<Long>[] bucket = new List[10];\n\n    @SuppressWarnings(\"unchecked\")\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        n = Long.parseLong(br.readLine());\n        \n        for (int i = 0; i < 10; i++) {\n            bucket[i] = new ArrayList<>();\n        }\n        \n        buildBuckets(0, 0);\n        \n        for (int i = 1; i <= 6; i++) {\n            Collections.sort(bucket[i]);\n        }\n        \n        power10[0] = 1;\n        for (int i = 1; i <= 12; i++) {\n            power10[i] = power10[i-1] * 10;\n        }\n        \n        enumerateNumbers(0);\n        \n        long result = ((total % MOD1) + MOD1) % MOD1;\n        System.out.println(result);\n    }\n\n    static void process(long base, long offset) {\n        for (int i = 0; i <= 6; ++i) {\n            long val = ((offset - base * power10[i]) % MOD2 + MOD2) % MOD2;\n            total = (total + val * bucket[i].size() + prefixSum[i]) % MOD1;\n            \n            long target = MOD2 - val;\n            int idx = Collections.binarySearch(bucket[i], target);\n            if (idx < 0) idx = -idx - 1;\n            else {\n                while (idx > 0 && bucket[i].get(idx - 1) >= target) idx--;\n            }\n            \n            long count = bucket[i].size() - idx;\n            total = (total - count * MOD2) % MOD1;\n        }\n    }\n\n    static void buildBuckets(long num, int depth) {\n        long diff = ((counter1++ - num) % MOD2 + MOD2) % MOD2;\n        prefixSum[depth] = (prefixSum[depth] + diff) % MOD1;\n        bucket[depth].add(diff);\n        if (depth == 6) return;\n        for (int digit = 0; digit <= 9; ++digit) {\n            buildBuckets(num * 10 + digit, depth + 1);\n        }\n    }\n\n    static void enumerateNumbers(long num) {\n        if (num > n) return;\n        if ((num + 1) * 1000000L <= n + 1 && num * 10000000L > n) {\n            process(num, counter2);\n            counter2 += counter1;\n        } else {\n            long diff = ((counter2++ - num) % MOD2 + MOD2) % MOD2;\n            total = (total + diff) % MOD1;\n            int startDigit = (num == 0) ? 1 : 0;\n            for (int digit = startDigit; digit <= 9; ++digit) {\n                enumerateNumbers(num * 10 + digit);\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011932138295378536, -1.9073468138230965e-06, -8.344646857949556e-07, -0.0001431601122021675, -2.038458114839159e-05, -0.20146283507347107, -0.22559911012649536, -0.0011968599865213037, -3.2