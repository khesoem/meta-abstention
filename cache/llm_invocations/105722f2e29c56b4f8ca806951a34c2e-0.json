rity(c - i), ncr(c, i), pow(i, n));\n            answer = add(answer, term);\n            i++;\n        }\n        answer = mult(answer, 2, ncr(n, c));\n        out.println(answer);\n        out.close();\n    }\n\n    static long fact(int n) {\n        if (n >= fact.length) {\n            int old = fact.length;\n            long[] newFact = new long[n + 1];\n            long[] newInv = new long[n + 1];\n            System.arraycopy(fact, 0, newFact, 0, old);\n            System.arraycopy(invFact, 0, newInv, 0, old);\n            for (int j = old; j <= n; j++) {\n                newFact[j] = newFact[j - 1] * j % MOD;\n            }\n            newInv[n] = pow(newFact[n], (int)(MOD - 2));\n            for (int j = n - 1; j >= old; j--) {\n                newInv[j] = newInv[j + 1] * (j + 1) % MOD;\n            }\n            fact = newFact;\n            invFact = newInv;\n        }\n        return fact[n];\n    }\n\n    static long invFact(int n) {\n        fact(n);\n        return invFact[n];\n    }\n\n    static long ncr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return mult(fact(n), invFact(r), invFact(n - r));\n    }\n\n    static long parity(long k) {\n        return (k & 1) == 0 ? 1 : MOD - 1;\n    }\n\n    static long add(long a, long b) {\n        long v = a + b;\n        return v >= MOD ? v - MOD : v;\n    }\n\n    static long mult(long... x) {\n        long r = 1;\n        for (long v : x) r = r * v % MOD;\n        return r;\n    }\n\n    static long pow(long x, int e) {\n        if (e < 0) {\n            x = inv(x);\n            e = -e;\n        }\n        long res = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) res = res * x % MOD;\n            x = x * x % MOD;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static long inv(long x) {\n        return pow(x, (int)(MOD - 2));\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response":