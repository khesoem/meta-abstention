'to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nclass MinCostFlow:\n    def __init__(self, n):\n        self.n = n\n        self.g = [[] for _ in range(n + 1)]\n        self.h = [0] * (n + 1)\n        self.d = [0] * (n + 1)\n        self.pv = [0] * (n + 1)\n        self.pe = [0] * (n + 1)\n\n    def add_edge(self, fr, to, cap, cost):\n        self.g[fr].append(Edge(to, cap, cost, len(self.g[to])))\n        self.g[to].append(Edge(fr, 0, -cost, len(self.g[fr]) - 1))\n\n    def min_cost(self, s, t, f):\n        flow = 0\n        ans = 0\n        self.h = [0] * (self.n + 1)\n        while f > 0:\n            self.d = [INF] * (self.n + 1)\n            pq = []\n            self.d[s] = 0\n            heapq.heappush(pq, (0, s))\n            while pq:\n                dist, v = heapq.heappop(pq)\n                if self.d[v] < dist:\n                    continue\n                for i, e in enumerate(self.g[v]):\n                    if e.cap > 0 and self.d[e.to] > self.d[v] + e.cost + self.h[v] - self.h[e.to]:\n                        self.d[e.to] = self.d[v] + e.cost + self.h[v] - self.h[e.to]\n                        self.pv[e.to] = v\n                        self.pe[e.to] = i\n                        heapq.heappush(pq, (self.d[e.to], e.to))\n            if self.d[t] == INF:\n                break\n            for i in range(self.n + 1):\n                self.h[i] += self.d[i]\n            add = f\n            v = t\n            while v != s:\n                add = min(add, self.g[self.pv[v]][self.pe[v]].cap)\n                v = self.pv[v]\n            f -= add\n            flow += add\n            ans += add * self.h[t]\n            v = t\n            while v != s:\n                e = self.g[self.pv[v]][self.pe[v]]\n                e.cap -= add\n                self.g[v][e.rev].cap += add\n                v = self.pv[v]\n        return ans\n\ndef m