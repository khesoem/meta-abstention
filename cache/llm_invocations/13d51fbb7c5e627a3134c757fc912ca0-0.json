+j]+=a[i]*b[j];\n    for(int i=0;i<=lv;i++) c[i]%=mod;\n    return c;\n}\nvector<long long> poly_power(vector<long long> a,int e){\n    vector<long long> c(lv+1,0); c[0]=1;\n    while(e){\n        if(e&1) c=multiply(c,a);\n        a=multiply(a,a);\n        e>>=1;\n    }\n    return c;\n}\nint main(){\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n    cin>>n>>k>>mod;\n    calc_fact(n);\n    if(n&1){ cout<<my_pow(k,n)<<\"\\n\"; return 0; }\n    m=1; lv=0; while(m<=n){ m<<=1; lv++; }\n    for(int i=0;i<m;i++) cnt[i]=cnt[i>>1]+(i&1);\n    calc_fact(m);\n    for(int i=0;i<m;i++) f[cnt[i]][i]=invfact[i];\n    for(int i=0;i<=lv;i++) fwt(f[i],m,1);\n    vector<long long> tmp(lv+1);\n    for(int s=0;s<m;s++){\n        for(int i=0;i<=lv;i++) tmp[i]=f[i][s];\n        tmp=poly_power(tmp,k);\n        for(int i=0;i<=lv;i++) f[i][s]=tmp[i];\n    }\n    fwt(f[cnt[n]],m,-1);\n    int ans=my_pow(k,n) - 1LL*f[cnt[n]][n]*fact[n]%mod;\n    ans=fix(ans);\n    cout<<ans<<\"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef fix(x, mod):\n    if x < 0:\n        return x + mod\n    if x >= mod:\n        return x - mod\n    return x\n\ndef addmod(a, b, mod):\n    return fix(a + b, mod)\n\ndef my_pow(a, b, mod):\n    if b == 0:\n        return 1\n    h = my_pow(a, b // 2, mod)\n    h = (h * h) % mod\n    if b & 1:\n        h = (h * a) % mod\n    return h\n\ndef calc_fact(N, mod):\n    fact = [0] * (N + 1)\n    invfact = [0] * (N + 1)\n    fact[0] = 1\n    for i in range(1, N + 1):\n        fact[i] = (fact[i - 1] * i) % mod\n    invfact[N] = my_pow(fact[N], mod - 2, mod)\n    for i in range(N - 1, -1, -1):\n        invfact[i] = (invfact[i + 1] * (i + 1)) % mod\n    return fact, invfact\n\ndef fwt(A, length, sgn, mod):\n    q = 1\n    while q < length:\n        off = 0\n        while off < length:\n            for i in range(