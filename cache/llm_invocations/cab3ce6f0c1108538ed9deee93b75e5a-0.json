 term3) % MOD) % MOD;\n        }\n        \n        System.out.println(ans);\n    }\n    \n    public static long modPow(long base, long exp, long mod) {\n        long res = 1;\n        base = ((base % mod) + mod) % mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nlong long modPow(long long base, long long exp, long long mod) {\n    long long res = 1;\n    base = ((base % mod) + mod) % mod;\n    while (exp > 0) {\n        if ((exp & 1) == 1) {\n            res = (res * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    long long S[5005][5005];\n    const long long MOD = 998244353LL;\n    \n    S[0][0] = 1;\n    for (int i = 1; i <= 5000; i++) {\n        S[i][0] = 0;\n        S[i][i] = 1;\n        for (int j = 1; j <= i; j++) {\n            S[i][j] = (S[i-1][j] * j % MOD + S[i-1][j-1]) % MOD;\n        }\n    }\n    \n    long long n, m;\n    int k;\n    cin >> n >> m >> k;\n    \n    m = modPow(m, MOD - 2, MOD);\n    \n    vector<long long> dp(5005, 0);\n    dp[0] = 1;\n    int limit = min((int)n, k);\n    for (int i = 1; i <= limit; i++) {\n        dp[i] = dp[i-1] * ((n - i + 1) % MOD) % MOD;\n    }\n    \n    long long ans = 0;\n    for (int i = 1; i <= limit; i++) {\n        long long term1 = modPow(m, i, MOD);\n        long long term2 = S[k][i];\n        long long term3 = dp[i];\n        ans = (ans + ((term1 * term2 % MOD) * term3) % MOD) % MOD;\n    }\n    \n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>",