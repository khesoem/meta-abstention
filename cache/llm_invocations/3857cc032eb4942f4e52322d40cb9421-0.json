{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <unordered_map>\n\nusing namespace std;\ntypedef long long ll;\nconst ll MOD = 1e9+7;\nll add(ll x, ll y) {\n\treturn (x + y) % MOD;\n}\nll sub(ll x, ll y) {\n\tx -= y;\n\treturn (x<0 ? x+MOD : x);\n}\nll mult(ll x, ll y) {\n\treturn (x * y) % MOD;\n}\nll modpow(ll x, ll p) {\n\tif (p == 0) return 1;\n\tif (p & 1) return mult(x, modpow(x, p - 1));\n\treturn modpow(mult(x, x), p>>1);\n}\nll modinv(ll x) {\n\treturn modpow(x, MOD-2);\n}\n\nint n;\nvector<vector<ll>> A;\nll T[8][1<<7][1<<7];\nvector<unordered_map<ll,ll>> DP;\nvector<int> family(1<<7,0);\nvector<int> family_id(1<<7,0);\nvector<vector<int>> family_mask;\n\nvoid calc() {\n    family_mask.resize(n+1);\n    for (int mask=1; mask<(1<<n); ++mask) {\n        family[mask] = family[mask>>1] + (mask & 1);\n    }\n    for (int mask=0; mask<(1<<n); ++mask) {\n        family_id[mask] = (int)family_mask[family[mask]].size();\n        family_mask[family[mask]].push_back(mask);\n    }\n    for (int k=0; k<=n; ++k) {\n        for (int i=0; i<(int)family_mask[k].size(); ++i) {\n            int cm = family_mask[k][i];\n            for (int mask=0; mask<(1<<n); ++mask) {\n                ll ans = 0;\n                if ((mask & cm) == mask) continue;\n                for (int x=0; x<n; ++x) {\n                    if (cm & (1<<x)) continue;\n                    if ((mask & (1<<x))==0) continue;\n                    int newmask = cm | (1<<x);\n                    ans |= (1ll << family_id[newmask]);\n                }\n                T[k][i][mask] = ans;\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin>>n;\n    A.resize(n);\n    for (int i=0; i<n; ++i) {\n        A[i].resize(n);\n        for (int j=0; j<n; ++j) {\n            cin>>A[i][j];\n            A[i][j] = mult(A[i][j],modinv(100));\n        }\n    }\n    calc();\n    DP.resize(n+1);\n    DP[0][1] = 1;\n    for (int k=0; k<n; ++k) {\n        for (int edges=0; edges<(1<<n); ++edges) {\n            ll prob = 1;\n            for (int i=0; i<n; ++i) {\n                if (edges & (1<<i)) prob = mult(prob, A[k][i]);\n                else prob = mult(prob, sub(1,A[k][i]));\n            }\n            for (auto S : DP[k]) {\n                ll mask = S.first;\n                ll newmask = 0;\n                ll p = mult(prob, S.second);\n                for (int i=0; i<(int)family_mask[k].size(); ++i) {\n                    if (mask & (1<<i)) {\n                        newmask |= T[k][i][edges];\n                    }\n                }\n                if (newmask != 0) DP[k+1][newmask] = add(DP[k+1][newmask], p);\n            }\n        }\n    }\n    cout << DP[n][1] << endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final long MOD = 1000000007;\n    \n    static long add(long x, long y) {\n        return (x + y) % MOD;\n    }\n    \n    static long sub(long x, long y) {\n        x -= y;\n        return (x < 0 ? x + MOD : x);\n    }\n    \n    static long mult(long x, long y) {\n        return (x * y) % MOD;\n    }\n    \n    static long modpow(long x, long p) {\n        if (p == 0) return 1;\n        if ((p & 1) == 1) return mult(x, modpow(x, p - 1));\n        return modpow(mult(x, x), p >> 1);\n    }\n    \n    static long modinv(long x) {\n        return modpow(x, MOD - 2);\n    }\n    \n    static int n;\n    static long[][] A;\n    static long[][][] T;\n    static List<Map<Long, Long>> DP;\n    static int[] family;\n    static int[] family_id;\n    static List<List<Integer>> family_mask;\n    \n    static void calc() {\n        family_mask = new ArrayList<>(n + 1);\n        for (int i = 0; i <= n; i++) {\n            family_mask.add(new ArrayList<>());\n        }\n        \n        for (int mask = 1; mask < (1 << n); ++mask) {\n            family[mask] = family[mask >> 1] + (mask & 1);\n        }\n        \n        for (int mask = 0; mask < (1 << n); ++mask) {\n            family_id[mask] = family_mask.get(family[mask]).size();\n            family_mask.get(family[mask]).add(mask);\n        }\n        \n        for (int k = 0; k <= n; ++k) {\n            for (int i = 0; i < family_mask.get(k).size(); ++i) {\n                int cm = family_mask.get(k).get(i);\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    long ans = 0;\n                    if ((mask & cm) == mask) continue;\n                    for (int x = 0; x < n; ++x) {\n                        if ((cm & (1 << x)) != 0) continue;\n                        if ((mask & (1 << x)) == 0) continue;\n                        int newmask = cm | (1 << x);\n                        ans |= (1L << family_id[newmask]);\n                    }\n                    T[k][i][mask] = ans;\n                }\n            }\n        }\n    }\n    \n    public static void main(String[] args) throws IOException {\n        Buffer