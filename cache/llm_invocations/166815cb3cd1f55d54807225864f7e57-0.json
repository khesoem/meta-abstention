   }\n    }\n    return dis[t]!=inf;\n}\nint dfs(int x,int lim)\n{\n    if(x==t) return lim;\n    vis[x]=true;\n    int flow,res=lim;\n    for(int i=head[x];i;i=e[i].nxt)\n    {\n        int y=e[i].to,v=e[i].v;\n        if(dis[y]!=dis[x]+e[i].c||!v||vis[y]) continue;\n        if(flow=dfs(y,min(res,v)))\n        {\n            res-=flow;\n            e[i].v-=flow;\n            e[i^1].v+=flow;\n            if(!res) break;\n        }\n    }\n    return lim-res;\n}\nint dinic()\n{\n    int flow,sum=0;\n    while(spfa())\n        while(flow=dfs(s,inf))\n            sum+=flow*dis[t];\n    return sum;\n}\nint main()\n{\n    read(n),read(m),read(k),read(v1),read(v2),t=p(n,110)+1;\n    for(int i=2;i<=110;++i) add(p(1,i),t,inf,0);\n    for(int i=2;i<=n;++i)\n        for(int j=1;j<110;++j)\n            add(p(i,j),p(i,j+1),inf,v1);\n    for(int i=1,x;i<=k;++i) read(x),add(s,p(x,1),1,0);\n    for(int i=1;i<=m;++i)\n    {\n        int x,y;\n        read(x),read(y);\n        for(int j=1;j<110;++j)\n            for(int l=1;l<=k;++l)\n                add(p(x,j),p(y,j+1),1,v2*(2*l-1)+v1),add(p(y,j),p(x,j+1),1,v2*(2*l-1)+v1);\n    }\n    printf(\"%d\",dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef read():\n    return list(map(int, sys.stdin.readline().split()))\n\ndef main():\n    data = read()\n    n, m, k, v1, v2 = data[0], data[1], data[2], data[3], data[4]\n    \n    def p(x, k_val):\n        return x + (k_val - 1) * n\n    \n    t = p(n, 110) + 1\n    s = 0\n    \n    maxn = 5000010\n    inf = 1000000000\n    \n    # Initialize graph structures\n    dis = [inf] * maxn\n    vis = [False] * maxn\n    head = [0] * maxn\n    edge_cnt = 1\n    \n    # Edge structure: (to, nxt, v, c)\n    e = [(0, 0, 0, 0)] * maxn\n    \n    def add(from_node, to_node, val, cost):\n        nonlocal edge_cnt\n        edge_cnt += 1\n        e[edge_cnt] = (to_node, head[from_node], val, cost)\n        head[from_node] = edge_cnt\n        \n        edge_cnt += 1\n        e[edge_cnt] = (from_node, head[to_node], 0, -cost)\n        head[to_node] = edge_cnt\n    \n    # Build graph\n    for i in range(2, 111):\n        add(p(1, i), t, inf, 0)\n    \n    for i in range(2, n + 1):\n        for j in range(1, 110):\n            add(p(i, j), p(i, j + 1), inf, v1)\n    \n    # Read k values\n    for i in range(1, k + 1):\n        x = read()[0]\n        add(s, p(x, 1), 1, 0)\n    \n    # Read m edges\n    for _ in range(m):\n        x, y = read()\n        for j in range(1, 110):\n            for l in range(1, k + 1):\n                cost = v2 * (2 * l - 1) + v1\n                add(p(x, j), p(y, j + 1), 1, cost)\n                add(p(y, j), p(x, j + 1), 1, cost)\n    \n    # SPFA implementation\n    def spfa():\n        for i in range(s, t + 1):\n            dis[i] = inf\n            vis[i] = False\n        \n        q = deque()\n        q.append(s)\n        dis[s] = 0\n        vis[s] = True\n        \n        while q:\n            x = q.popleft()\n            vis[x] = False\n            \n            i = head[x]\n            while i:\n                to_node, nxt, v_val, c = e[i]\n                if dis[to_node] <= dis[x] + c or v_val == 0:\n                    i = nxt\n                    continue\n                dis[to_node] = dis[x] + c\n                if not vis[to_node]:\n                    vis[to_node] = True\n                    q.append(to_node)\n                i = nxt\n        return dis[t] != inf\n    \n    # DFS for flow\n    def dfs(x, lim):\n        if x == t:\n            return lim\n        vis[x] = True\n        flow = 0\n        res = lim\n        i = head[x]\n        while i:\n            to_node, nxt, v_val, c = e[i]\n            if dis[to_node] != dis[x] + c or v_val == 0 or vis[to_node]:\n                i = nxt\n                continue\n            flow = dfs(to_node, min(res, v_val))\n            if flow:\n                res -= flow\n                # Update edge capacities\n                e[i] = (to_node, nxt, e[i][2] - flow, c)\n                e[i ^ 1] = (e[i ^ 1][0], e[i ^ 1][1], e[i ^ 1][2] + flow, e[i ^ 1][3])\n                if not res:\n                    break\n            i = nxt\n        return lim - res\n    \n    # Dinic's algorithm\n    def dinic():\n        total_flow = 0\n        while spfa():\n            while True:\n                flow = dfs(s, inf)\n                if flow == 0:\n                    break\n                total_flow += flow * dis[t]\n        return total_flow\n    \n    result = dinic()\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00013600854435935616, -8.344646857949556e-07, -4.768370445162873e-07, -0.0025076393503695726, -0.0003883084573317319, -2.0265558760002023e-06, -0.00011038171214750037, -0.0002037079248111695, -1.5497195136049413e-06, -0.0002989322238136083, -0.00038342276820912957, -0.026805998757481575, -0.010929246433079243, -0.36407408118247986, -1.311301275563892e-06, -0.06385885179042816, -0.1143750548362732, -4.887569048150908e-06, -2.3603161025675945e-05, -9.536738616588991e-07, -7.819823804311454e-05, -1.311301275563892e-06, -0.024096714332699776, -2.2053474822314456e-05, -0.005483110900968313, -0.0014515112852677703, -0.06280167400836945, -0.19262032210826874, -1.311301275563892e-06, -1.4305104514278355e-06, -0.11119330674409866, -1.7881377516459906e-06, -0.0054518114775419235, -3.099436753473128e-06, -4.768370445162873e-07, -0.008632367476820946, -0.1602260321378708, -1.5497195136049413e-06, -1.680836794548668e-05, -6.318072337307967e-06, -0.0008045773720368743, -2.3841830625315197e-06, 0.0, -6.9141146923357155e-06, -7.152555099310121e-07, -3.576278118089249e-07, -1.0251946150674485e-05, -1.6689286894688848e-06, -0.041507795453071594, -1.1920928244535389e-07, -2.