0) > k:\n                    continue\n                if take50 != curr50 or take100 != curr100:\n                    comb = (binom[count50 - curr50][take50 - curr50] * binom[count100 - curr100][take100 - curr100]) % MOD\n                    next_state = pack(1, take50, take100)\n                    update(next_state, state, comb)\n\ndef update(next_state, prev_state, comb):\n    new_depth = memo[prev_state].steps + 1\n    if next_state not in memo:\n        memo[next_state] = Result(new_depth, 0)\n        deque.append(next_state)\n    if memo[next_state].steps == new_depth:\n        new_paths = (memo[next_state].paths + memo[prev_state].paths * comb % MOD) % MOD\n        memo[next_state].paths = new_paths\n\ndef main():\n    global n, k, count50, count100\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k = int(data[1])\n    count50 = 0\n    count100 = 0\n    index = 2\n    for i in range(n):\n        weight = int(data[index])\n        index += 1\n        if weight == 50:\n            count50 += 1\n        else:\n            count100 += 1\n\n    compute_binomial()\n    initial = pack(1, count50, count100)\n    deque.append(initial)\n    memo[initial] = Result(0, 1)\n\n    while deque:\n        expand(deque.popleft())\n\n    final_result = memo.get(0)\n    if final_result is not None:\n        print(f\"{final_result.steps}\\n{final_result.paths}\")\n    else:\n        print(\"-1\\n0\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.7338023907504976e-05, -7.152555099310121e-07, -3.576278118089249e-07, -0.42951592803001404, -0.012311299331486225, -7.152531907195225e-06, -1.8358061424805783e-05, -9.059495641849935e-05, -2.3841855067985307e-07, -0.0006370898918248713, -0.06307301670312881, -0.0002455409849062562, -8.010543388081715e-05, -0.18367072939872742, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -8.940656698541716e-06, -2.4