d[u]\n            while i != -1:\n                edge = e[i]\n                v = edge.to\n                w = edge.cost\n                if edge.cap > 0 and dist[v] > dist[u] + w:\n                    dist[v] = dist[u] + w\n                    if not inq[v]:\n                        inq[v] = True\n                        q.append(v)\n                i = edge.next\n        return dist[t] != INF\n    \n    def dfs(u, flow, vis):\n        if u == t:\n            return flow\n        vis[u] = True\n        pushed = 0\n        remain = flow\n        i = head[u]\n        while i != -1:\n            edge = e[i]\n            v = edge.to\n            cap = edge.cap\n            if vis[v] or cap == 0 or dist[v] != dist[u] + edge.cost:\n                i = edge.next\n                continue\n            f = dfs(v, min(remain, cap), vis)\n            if f > 0:\n                remain -= f\n                e[i].cap -= f\n                e[i ^ 1].cap += f\n                pushed += f\n                if remain == 0:\n                    break\n            i = edge.next\n        return pushed\n    \n    def solve():\n        cost = 0\n        while spfa():\n            vis = [False] * (t + 1)\n            flow = dfs(s, INF, vis)\n            if flow:\n                cost += flow * dist[t]\n        return cost\n    \n    result = solve()\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00019786784832831472, -1.0728830375228426e-06, -3.576278118089249e-07, -0.0002474478678777814, -0.0010719512356445193, -9.059865078597795e-06, -0.004082322586327791, -0.00028451209072954953, -2.0265558760002023e-06, -0.00038580605178140104, -6.12716976320371e-05, -0.4731423258781433, -0.5126973390579224, -0.00037293630884960294, -2.3841855067985307e-07, -9.536738616588991e-07, -3.576278118089249e-07, 0.0, -0.00011181206355104223, -1.4305104514278355e-06, -5.960462772236497e-07, 0.0, 0.0, 0.0, -2.384185506