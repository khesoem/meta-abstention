{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <limits>\nusing namespace std;\n\nstruct Edge {\n    int destination;\n    int capacity;\n    int flow;\n    int cost;\n};\n\nconst int MAX_VERTEX = 10000;\nconst long long INF = 1e18;\n\nvector<Edge> edges;\nvector<int> graph[MAX_VERTEX];\nlong long distance[MAX_VERTEX];\nint parentVertex[MAX_VERTEX];\nint parentEdgeIndex[MAX_VERTEX];\nbool inQueue[MAX_VERTEX];\n\nvoid insertEdge(int from, int to, int cap, int cst) {\n    graph[from].push_back(edges.size());\n    edges.push_back({to, cap, 0, cst});\n    graph[to].push_back(edges.size());\n    edges.push_back({from, 0, 0, -cst});\n}\n\nbool findMinCostPath(int source, int sink) {\n    fill(distance, distance + MAX_VERTEX, INF);\n    fill(parentVertex, parentVertex + MAX_VERTEX, -1);\n    fill(parentEdgeIndex, parentEdgeIndex + MAX_VERTEX, -1);\n    fill(inQueue, inQueue + MAX_VERTEX, false);\n    \n    queue<int> bfs;\n    bfs.push(source);\n    distance[source] = 0;\n    inQueue[source] = true;\n    \n    while (!bfs.empty()) {\n        int u = bfs.front(); bfs.pop();\n        inQueue[u] = false;\n        \n        for (int idx : graph[u]) {\n            Edge& e = edges[idx];\n            if (e.capacity <= e.flow) continue;\n            int v = e.destination;\n            long long newDist = distance[u] + e.cost;\n            if (newDist < distance[v]) {\n                distance[v] = newDist;\n                parentVertex[v] = u;\n                parentEdgeIndex[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    bfs.push(v);\n                }\n            }\n        }\n    }\n    \n    if (distance[sink] == INF) return false;\n    \n    int cur = sink;\n    while (cur != source) {\n        edges[parentEdgeIndex[cur]].flow++;\n        edges[parentEdgeIndex[cur] ^ 1].flow--;\n        cur = parentVertex[cur];\n    }\n    \n    return true;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int nodes, edgesCount, commodities, baseCost, delayFactor;\n    cin >> nodes >> edgesCount >> commodities >> baseCost >> delayFactor;\n    \n    const int sourceNode = 9998;\n    const int sinkNode = 9999;\n    \n    for (int i = 0; i < commodities; i++) {\n        int node;\n        cin >> node;\n        node--;\n        insertEdge(sourceNode, node, 1, 0);\n    }\n    \n    for (int layer = 1; layer <= 101; layer++) {\n        insertEdge((layer - 1) * nodes, sinkNode, commodities, (layer - 1) * baseCost);\n    }\n    \n    for (int i = 0; i < edgesCount; i++) {\n        int u, v;\n        cin >> u >> v;\n        u--; v--;\n        for (int layer = 1; layer <= 100; layer++) {\n            for (int commodity = 1; commodity <= commodities; commodity++) {\n                int cost = delayFactor * ((commodity - 1) * 2 + 1);\n                insertEdge(u + (layer - 1) * nodes, v + (layer - 1) * nodes + nodes, 1, cost);\n                insertEdge(v + (layer - 1) * nodes, u + (layer - 1) * nodes + nodes, 1, cost);\n            }\n        }\n    }\n    \n    for (int node = 0; node < nodes; node++) {\n        for (int layer = 1; layer <= 100; layer++) {\n            insertEdge(node + (layer - 1) * nodes, node + (layer - 1) * nodes + nodes, commodities, 0);\n        }\n    }\n    \n    long long totalCost = 0;\n    for (int i = 0; i < commodities; i++) {\n        if (findMinCostPath(sourceNode, sinkNode)) {\n            totalCost += distance[sinkNode];\n        }\n    }\n    \n    cout << totalCost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int destination;\n        int capacity;\n        int flow;\n        int cost;\n\n        Edge(int destination, int capacity, int flow, int cost) {\n            this.destination = destination;\n            this.capacity = capacity;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final int MAX_VERTEX = 10000;\n    static final long INF = (long) 1e18;\n\n    static List<Edge> edges = new ArrayList<>();\n    static List<Integer>[] graph = new List[MAX_VERTEX];\n    static long[] distance = new long[MAX_VERTEX];\n    static int[] parentVertex = new int[MAX_VERTEX];\n    static int[] parentEdgeIndex = new int[MAX_VERTEX];\n    static boolean[] inQueue = new boolean[MAX_VERTEX];\n\n    static void insertEdge(int from, int to, int cap, int cst) {\n        graph[from].add(edges.size());\n        edges.add(new Edge(to, cap, 0, cst));\n        graph[to].add(edges.size());\n        edges.add(new Edge(from, 0, 0, -cst));\n    }\n\n    static boolean findMinCostPath(int source, int sink) {\n        Arrays.fill(distance, INF);\n        Arrays.fill(parentVertex, -1);\n        Arrays.fill(parentEdgeIndex, -1);\n        Arrays.fill(inQueue, false);\n\n        Queue<Integer> bfs = new LinkedList<>();\n        bfs.offer(source);\n        distance[source] = 0;\n        inQueue[source] = true;\n\n        while (!bfs.isEmpty()) {\n            int u = bfs.poll();\n            inQueue[u] = false;\n\n            for (int idx : graph[u]) {\n                Edge e = edges.get(idx);\n                if (e.capacity <= e.flow) continue;\n                int v = e.destination;\n                long newDist = distance[u] + e.cost;\n                if (newDist < distance[v]) {\n                    distance[v] = newDist;\n                    parentVertex[v] = u;\n                    parentEdgeIndex[v] = idx;\n                    if (!inQueue[v]) {\n                        inQueue[v] = true;\n                        bfs.offer(v);\n                    }\n                }\n            }\n        }\n\n        if (distance[sink] == INF) return false;\n\n        int cur = sink;\n        while (cur != source) {\n            edges.get(parentEdgeIndex[cur]).flow++;\n            edges.get(parentEdgeIndex[cur] ^ 1).flow--;\n            cur = parentVertex[cur];\n        }\n\n        return true;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        int nodes = scanner.nextInt();\n        int edgesCount = scanner.nextInt();\n        int commodities = scanner.nextInt();\n        int baseCost = scanner.nextInt();\n        int delayFactor = scanner.nextInt();\n\n        final int sourceNode = 9998;\n        final int sinkNode = 9999;\n\n        for (int i = 0; i < MAX_VERTEX; i++) {\n            graph[i] = new ArrayList<>();\n        }\n\n        for (int i = 0; i < commodities; i++) {\n            int node = scanner.nextInt();\n            node--;\n            insertEdge(sourceNode, node, 1, 0);\n        }\n\n        for (int layer = 1; layer <= 101; layer++) {\n            insertEdge((layer - 1) * nodes, sinkNode, commodities, (layer - 1) * baseCost);\n        }\n\n        for (int i = 0; i < edgesCount; i++) {\n            int u = scanner.nextInt();\n            int v = scanner.nextInt();\n            u--;\n            v--;\n            for (int layer = 1; layer <= 100; layer++) {\n                for (int commodity = 1; commodity <= commodities; commodity++) {\n                    int cost = delayFactor * ((commodity - 1) * 2 + 1);\n                    insertEdge(u + (layer - 1) * nodes, v + (layer - 1) * nodes + nodes, 1, cost);\n                    insertEdge(v + (layer - 1) * nodes, u + (layer - 1) * nodes + nodes, 1, cost);\n                }\n            }\n        }\n\n        for (int node = 0; node < nodes; node++) {\n            for (int layer = 1; layer <= 100; layer++) {\n                insertEdge(node + (layer - 1) * nodes, node + (layer - 1) * nodes + nodes, commodities, 0);\n            }\n        }\n\n        long totalCost = 0;\n        for (int i = 0; i < commodities; i++) {\n            if (findMinCostPath(sourceNode, sinkNode)) {\n                totalCost += distance[sinkNode];\n            }\n        }\n\n        System.out.println(totalCost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012230125139467418, -1.311301275563892e-06, -4.768370445162873e-07, -0.002819374669343233, -4.827859811484814e-05, -0.054893478751182556, -0.2015121579170227, -4.9828242481453344e-05, -5.960462772236497e-07, -0.00010680581908673048, -0.016034934669733047, -0.002476959954947233, -0.0003864018653985113, -0.01839693821966648, -1.537788011773955e-05, -2.3841855067985307e-07, -1.1920922133867862e-06, -2.3841830625315197e-06, -1.7881377516459906e-06, -5.960446742392378e-06, -9.536738616588991e-07, -0.0013262771535664797, -2.3841830625315197e-06, -7.510157047363464e-06, -2.9802276912960224e-06, -8.106198947643861e-06, -7.152555099310121e-07, -4.184158387943171e-05, -9.894321920000948e-06, -0.00018106251081917435, -8.344646857949556e-07, -0.6325994729995728, -1.0490362910786644e-05, -0.001946580014191568, -3.576278118089249e-07, -0.16912364959716797, 0.0, 0.0