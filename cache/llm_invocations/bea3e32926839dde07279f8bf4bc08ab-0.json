le)(p[i] * ans));\n\t}\n\n\tprintf(\"\\n\");\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef main():\n    import sys\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k = int(data[1])\n    p = [0.0] * 20\n    \n    idx = 2\n    for i in range(n):\n        p[i] = float(data[idx])\n        idx += 1\n    \n    # Initialize binomial coefficients\n    c = [[0.0] * 21 for _ in range(21)]\n    c[0][0] = 1.0\n    for i in range(1, n + 1):\n        c[i][0] = 1.0\n        for j in range(1, i + 1):\n            c[i][j] = c[i-1][j-1] + c[i-1][j]\n    \n    # Precompute sz and sum for all masks\n    max_mask = 1 << n\n    sz = [0] * max_mask\n    sum_arr = [0.0] * max_mask\n    \n    for msk in range(max_mask):\n        sz[msk] = 0\n        sum_arr[msk] = 0.0\n        for j in range(n):\n            if (msk >> j) & 1:\n                sz[msk] += 1\n                sum_arr[msk] += p[j]\n    \n    # Compute coefficients\n    coef = [0.0] * 21\n    for i in range(k - 1, -1, -1):\n        coef[i] = 1.0 - coef[i]\n        j = 1\n        while i - j >= 0:\n            coef[i - j] += c[n - 1 - i + j][j] * coef[i]\n            j += 1\n    \n    # Calculate and print answers\n    results = []\n    for i in range(n):\n        ans = 0.0\n        if p[i] > 0.005:\n            for msk in range(max_mask):\n                if (msk >> i) & 1:\n                    continue\n                if sz[msk] >= k:\n                    continue\n                if (1.0 - sum_arr[msk]) > 0:\n                    ans += coef[sz[msk]] / (1.0 - sum_arr[msk])\n        results.append(p[i] * ans)\n    \n    print(\" \".join(f\"{x:.12f}\" for x in results))\n    print()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000139465148095041