nclude <set>\n\nusing namespace std;\n\nvector<int> gen(const vector<int>& a, int lo, int hi, int m) {\n    vector<int> sums = {0};\n    for (int idx = lo; idx < hi; ++idx) {\n        int cur = a[idx];\n        vector<int> new_sums;\n        for (int s : sums) {\n            new_sums.push_back(( (long long)s + cur ) % m);\n        }\n        sums.insert(sums.end(), new_sums.begin(), new_sums.end());\n    }\n    return sums;\n}\n\nint max_less(const vector<int>& lst, int x) {\n    // binary search for largest element < x\n    auto it = lower_bound(lst.begin(), lst.end(), x);\n    if (it == lst.begin()) return -1;\n    return *(it - 1);\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<int> a(n);\n    for (int i = 0; i < n; ++i) cin >> a[i];\n\n    int n1 = n / 2;\n\n    vector<int> a1 = gen(a, 0, n1, m);\n    sort(a1.begin(), a1.end());\n    a1.erase(unique(a1.begin(), a1.end()), a1.end());\n\n    vector<int> a2 = gen(a, n1, n, m);\n\n    int ans = 0;\n    for (int i : a2) {\n        int cand = max_less(a1, m - i);\n        if (cand != -1) {\n            int total = (cand + i) % m;\n            if (total > ans) ans = total;\n        }\n    }\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00012933371181134135, -3.4570634852570947e-06, -9.536738616588991e-07, -0.0017501289257779717, -0.0016669438919052482, -5.960462772236497e-07, -9.715084888739511e-05, -1.680836794548668e-05, 0.0, 0.0, -9.536738616588991e-07, -3.2186455882765586e-06, 0.0, 0.0, -1.5497195136049413e-06, -0.3132820427417755, -0.5759444832801819, -4.768370445162873e-07, -0.3270813226699829, -0.4754379987716675, -2.8013790142722428e-05, -2.3841855067985307e-07, 0.0, -3.85038583772257e-05, -0.4947032928466797, -0.0004312062228564173, 0.0, -0.008667468093335629, -0.00033802041434682906, 0.0, -8.344646857949556e-07, -0.00012337400403339416, -3.683499380713329e-05, -1.1920928244535389e-07, -8.344646857949556e-07, -1.78