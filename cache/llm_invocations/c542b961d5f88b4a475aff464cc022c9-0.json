ent to #ifdef _DEBUG in C++\n        if (System.getProperty(\"DEBUG\") != null) {\n            System.setIn(new FileInputStream(\"input.txt\"));\n            System.setOut(new PrintStream(new FileOutputStream(\"output.txt\")));\n        }\n        \n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        if (n == 1) {\n            int x = scanner.nextInt();\n            System.out.print(x);\n            scanner.close();\n            return;\n        }\n        \n        List<Integer> list = new ArrayList<>(n);\n        for (int i = 0; i < n; ++i) {\n            list.add(scanner.nextInt());\n        }\n        \n        // Use nth_element-like behavior to find median without full sort\n        int k = (n - 1) / 2;\n        // Quickselect algorithm for O(n) average\n        int median = quickSelect(list, 0, n - 1, k);\n        System.out.print(median);\n        scanner.close();\n    }\n    \n    private static int quickSelect(List<Integer> list, int left, int right, int k) {\n        if (left == right) {\n            return list.get(left);\n        }\n        \n        // Choose a random pivot index between left and right\n        int pivotIndex = left + (int)(Math.random() * (right - left + 1));\n        int pivotValue = list.get(pivotIndex);\n        \n        // Move pivot to end\n        Collections.swap(list, pivotIndex, right);\n        \n        // Partition\n        int storeIndex = left;\n        for (int i = left; i < right; ++i) {\n            if (list.get(i) < pivotValue) {\n                Collections.swap(list, storeIndex, i);\n                storeIndex++;\n            }\n        }\n        \n        // Move pivot to its final place\n        Collections.swap(list, storeIndex, right);\n        \n        // The pivot is now at storeIndex\n        if (k == storeIndex) {\n            return pivotValue;\n        } else if (k < storeIndex) {\n            return quickSelect(list, left, storeIndex - 1, k);\n        } else 