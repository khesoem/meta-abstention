;\n    static long best = (long) 1e18, best_z = -1;\n    static String s;\n    static int[] cntA, cntB;\n    static Map<Long, Long> mp = new HashMap<>();\n\n    static void dfs(long x, long y, int v1, int v2) {\n        long diff = Math.abs(x - y);\n        if (best <= 1 || diff - C[v1][r] * C[v2][r] >= best) {\n            return;\n        }\n        if (v1 == r - 1 && v2 == r - 1) {\n            long diff2 = Math.abs(x - y);\n            if (diff2 < best) {\n                best = diff2;\n                best_z = x;\n            }\n            return;\n        }\n        if (v1 >= r) {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            dfs(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (v2 >= r) {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v2 - 1][r];\n            dfs(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n    }\n\n    static long solve(long x, long y, int v1, int v2) {\n        long state = x * 10000 + v1 * 100 + v2;\n        if (mp.containsKey(state)) {\n            return mp.get(state);\n        }\n        long res = 0;\n        long diff = Math.abs(x - y);\n        if (diff - C[v1][r] * C[v2][r] > best) {\n            mp.put(state, res);\n            return res;\n        }\n        if (v1 < r || v2 < r) {\n            int sum = v1 + v2;\n            if (v1 >= cntA[sum] && v2 >= cntB[sum]) {\n                v1 -= cntA[sum];\n                v2 -= cntB[sum];\n                res = C[v1][r] >= 0 && v1 >= 0 && v2 >= 0 ? C[v1][r] : 0;\n                mp.put(state, res);\n                return res;\n            }\n            mp.put(state, 0L);\n            return 0;\n        }\n        res = 0;\n        char c = s.charAt(v1 + v2 - 1);\n        if (c != 'B') {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (c != 'A') {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v2 - 1][r];\n            res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n        mp.put(state, res);\n        return res;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        r = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n\n        int size = 2 * (r + c) + 1;\n        C = new long[size][size];\n\n        for (int i = 0; i <= 2 * (r + c); i++) {\n            for (int j = 0; j <= 2 * (r + c); j++) {\n                if (j == 0) {\n                    C[i][j] = 1;\n                } else if (i == 0) {\n                    C[i][j] = 0;\n                } else {\n                    C[i][j] = C[i - 1][j] + C[i - 1][j - 1];\n                }\n            }\n        }\n\n        total = C[r + c][r] * C[r + c][r];\n\n        long x = 0, y = 0;\n        int v1 = r + c, v2 = r + c;\n        while (v1 >= r && v2 >= r) {\n            if (x > y) {\n                long cur1 = C[v1][r] - C[v1 - 1][r];\n                long sum2 = C[v2][r];\n                y += cur1 * sum2;\n                v1--;\n            } else {\n                long sum1 = C[v1][r];\n                long cur2 = C[v2][r] - C[v2 - 1][r];\n                x += sum1 * cur2;\n                v2--;\n            }\n        }\n        best = Math.abs(x - y);\n\n        dfs(0, 0, r + c, r + c);\n\n        s = br.readLine();\n        cntA = new int[2 * (r + c) + 1];\n        cntB = new int[2 * (r + c) + 1];\n\n        for (int i = 0; i < 2 * (r + c); i++) {\n            cntA[i + 1] = cntA[i] + (s.charAt(i) == 'A' ? 1 : 0);\n            cntB[i + 1] = cntB[i] + (s.charAt(i) == 'B' ? 1 : 0);\n        }\n\n        long ans = solve(0, 0, r + c, r + c);\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_lo