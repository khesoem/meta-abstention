-1:\n            b = self.next_byte()\n        while b > ord(' ') and b != -1:\n            ret.append(chr(b))\n            b = self.next_byte()\n        return ''.join(ret)\n\ndef log2(n):\n    return int(math.ceil(math.log10(n) / math.log10(2)))\n\nclass BIT:\n    def __init__(self, length):\n        self.tree = [0] * (length + 5)\n    \n    def update(self, index, val):\n        index += 1\n        while index < len(self.tree):\n            self.tree[index] ^= val\n            index += index & -index\n    \n    def query(self, index):\n        result = 0\n        index += 1\n        while index > 0:\n            result ^= self.tree[index]\n            index -= index & -index\n        return result\n    \n    def range_sum(self, low, high):\n        return self.query(high) - self.query(low - 1)\n\n# Global variables for binary lifting\nadjList = None\ntin = None\ntout = None\nBL = None\nct = 0\n\ndef preprocess(root):\n    global ct, adjList, tin, tout, BL\n    ct = 0\n    n = len(adjList)\n    tin = [0] * n\n    tout = [0] * n\n    BL = [[0] * (log2(n) + 1) for _ in range(n)]\n    \n    def recur_bl(v, p):\n        global ct\n        ct += 1\n        tin[v] = ct\n        BL[v][0] = p\n        for i in range(1, log2(n) + 1):\n            BL[v][i] = BL[BL[v][i-1]][i-1]\n        \n        for neighbor in adjList[v]:\n            if neighbor != p:\n                recur_bl(neighbor, v)\n        \n        ct += 1\n        tout[v] = ct\n    \n    recur_bl(root, root)\n\ndef is_ancestor(u, v):\n    return tin[u] <= tin[v] and tout[u] >= tout[v]\n\ndef lca(u, v):\n    if is_ancestor(u, v):\n        return u\n    if is_ancestor(v, u):\n        return v\n    \n    for i in range(log2(len(adjList)), -1, -1):\n        if not is_ancestor(BL[u][i], v):\n            u = BL[u][i]\n    \n    return BL[u][0]\n\ndef main():\n    global adjList\n    \n    if DEBUG:\n        scan = FastScanner(sys.stdin.buffer)\n        out = sys.stdout\n    else:\n        scan = FastScanner(name + \".in\")\n        out = open(name + \".out\", 'w')\n    \n    N = float(scan.next_string())\n    P = float(scan.next_string())\n    \n    for i in range(int(N) + 1):\n        val = i * (i - 1) * (i - 2) / 6 + i * (i - 1) * (N - i) / 2 + i * (N - i) * (N - i - 1) / 4\n        val = val / (N * (N - 1) * (N - 2) / 6)\n        \n        if val >= P:\n            print(int(i), file=out)\n            break\n    \n    if not DEBUG:\n        out.close()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.107174992095679e-05, -5.960462772236497e-07, -5.960462772236497e-07, -0.00021491125517059118, -0.037638068199157715, -0.00010990492592100054, -7.807903602952138e-05, -0.0013250865740701556, -0.3868732154369354, -0.14289480447769165, -0.011188151314854622, -0.007639478426426649, -0.18359245359897614, -9.536738616588991e-07, -0.0032417625188827515, -1.1920928244535389e-07, -4.184158387943171e-05, -2.0265558760002023e-06, 0.0, -1.1920922133867862e-06, -0.007633917964994907, -0.11393094062805176, -0.006134727504104376, -2.884823152271565e-05, -3.6954811548639555e-06, -0.00010918975021922961, -2.145764938177308e-06, -8.809178689261898e-05, -4.768370445162873e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -0.07495967298746109, -4.172316494077677e-06, -8.344646857949556e-07, -0.0009159421897493303, -2.622600959512056e-06, -8.344646857949556e-07, -2.3841855067985307e-07, -0.0004159538948442787, -1.311301275563892e-06, -5.960462772236497e-07, -3.2186455882765586e-06, -0.2656450867652893, -7.152555099310121e-07, -2.90866428258596e-05, -3.4570634852570947e-06, 0.0, -0.00013982271775603294, -2.074220174108632e-05, -8.642300235806033e-05, -0.0011703077470883727, -3.6954811548639555e-06, -7.152555099310121e-07, -2.9802276912960224e-06, -1.9311717551317997e-05, -0.00012396997772157192, 0.0, -0.12913689017295837, -0.3445897698402405, -0.00020346954988781363, -6.198863957251888e-06, -7.0333