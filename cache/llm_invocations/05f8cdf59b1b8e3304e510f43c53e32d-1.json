nit__(self, to, capacity, cost, rev):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.rev = rev\n\nclass Min_Cost_Max_Flow:\n    def __init__(self):\n        self.V = 0\n        self.H = []\n        self.dis = []\n        self.PreV = []\n        self.PreE = []\n        self.G = []\n    \n    def Init(self, n):\n        self.V = n\n        self.H = [0] * (n + 5)\n        self.dis = [0] * (n + 5)\n        self.PreV = [0] * (n + 5)\n        self.PreE = [0] * (n + 5)\n        self.G = [[] for _ in range(n + 5)]\n    \n    def add_edge(self, from_node, to_node, cap, cost):\n        self.G[from_node].append(Edge(to_node, cap, cost, len(self.G[to_node])))\n        self.G[to_node].append(Edge(from_node, 0, -cost, len(self.G[from_node]) - 1))\n    \n    def minCost(self, s, t, f):\n        flow = 0\n        res = 0\n        self.H = [0] * (self.V + 1)\n        \n        while f > 0:\n            # Dijkstra with priority queue\n            dist = [float('inf')] * (self.V + 1)\n            dist[s] = 0\n            heap = [(0, s)]\n            \n            while heap:\n                d, v = heapq.heappop(heap)\n                if dist[v] < d:\n                    continue\n                for i in range(len(self.G[v])):\n                    e = self.G[v][i]\n                    if e.capacity > 0 and dist[e.to] > dist[v] + e.cost + self.H[v] - self.H[e.to]:\n                        dist[e.to] = dist[v] + e.cost + self.H[v] - self.H[e.to]\n                        self.PreV[e.to] = v\n                        self.PreE[e.to] = i\n                        heapq.heappush(heap, (dist[e.to], e.to))\n            \n            if dist[t] == float('inf'):\n                break\n            \n            for i in range(self.V + 1):\n                self.H[i] += dist[i]\n            \n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[self.PreV[v]][self.PreE[v]].capacity)\n                v = self.PreV[v]\n            \n            f -= d\n            flow += d\n            res += d * self.H[t]\n            \n            v = t\n            while v != s:\n                e = self.G[self.PreV[v]][self.PreE[v]]\n                e.capacity -= d\n                self.G[v][e.rev].capacity += d\n                v = self.PreV[v]\n        \n        return res\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    mcmf = Min_Cost_Max_Flow()\n    mcmf.Init(n * (n + 55) + 2)\n    \n    for i in range(k):\n        u = int(input_data[idx]); idx += 1\n        mcmf.add_edge(0, u, 1, 0)\n    \n    edges = []\n    for i in range(m):\n        x = int(input_data[idx]); idx += 1\n        y = int(input_data[idx]); idx += 1\n        edges.append((x, y))\n    \n    tar = n * (n + 55) + 1\n    \n    for t in range(n + 54):\n        for (x, y) in edges:\n            for j in range(1, k + 1):\n                cost = c + d * (j * 2 - 1)\n                mcmf.add_edge(x + t * n, y + (t + 1) * n, 1, cost)\n                mcmf.add_edge(y + t * n, x + (t + 1) * n, 1, cost)\n        \n        for i in range(2, n + 1):\n            mcmf.add_edge(i + t * n, i + (t + 1) * n, k, c)\n        \n        mcmf.add_edge(1 + t * n, tar, k, 0)\n    \n    result = mcmf.minCost(0, tar, k)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002366024418734014, -1.1920922133867862e-06, -3.576278118089249e-07, -6.3774932641536e-05, -0.05510243773460388, -0.18010681867599487, -0.08896137773990631, -0.00011646069469861686, -0.1801050305366516, -0.408018559217453, -0.0009702504030428827, -7.152555099310121e-07, -1.1920928244535389e-07, -0.0297508798