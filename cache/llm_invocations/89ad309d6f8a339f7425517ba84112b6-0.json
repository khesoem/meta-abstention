rial[0] = invFactorial[0] = 1L;\n            for (int i = 1; i < maxN; i++) {\n                factorial[i] = factorial[i - 1] * i % MOD;\n                invFactorial[i] = invFactorial[i - 1] * modPow(i, MOD - 2) % MOD;\n            }\n\n            int n = in.nextInt();\n            long k = in.nextLong();\n\n            if (k >= n) {\n                out.println(0);\n                return;\n            }\n            if (k == 0) {\n                out.println(factorial[n]);\n                return;\n            }\n\n            int m = n - (int)k;\n            long ans = 0;\n            for (int i = 0; i <= m; i++) {\n                long term = comb(m, i) * modPow(m - i, n) % MOD;\n                ans = (i % 2 == 0) ? (ans + term) % MOD : (ans - term + MOD) % MOD;\n            }\n\n            long result = 2L * factorial[n] % MOD;\n            result = result * invFactorial[n - m] % MOD;\n            result = result * ans % MOD;\n            result = result * invFactorial[m] % MOD;\n            out.println(result);\n        }\n\n        private long comb(int n, int r) {\n            return factorial[n] * invFactorial[r] % MOD * invFactorial[n - r] % MOD;\n        }\n    }\n\n    static class InputReader {\n        private BufferedReader br;\n        private StringTokenizer st;\n\n        public InputReader(InputStream in) {\n            br = new BufferedReader(new InputStreamReader(in));\n        }\n\n        private String nextToken() throws IOException {\n            while (st == null || !st.hasMoreTokens()) {\n                st = new StringTokenizer(br.readLine());\n            }\n            return st.nextToken();\n        }\n\n        public int nextInt() throws IOException {\n            return Integer.parseInt(nextToken());\n        }\n\n        public long nextLong() throws IOException {\n            return Long.parseLong(nextToken());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-code