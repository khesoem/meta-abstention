   p = self.prex[x]\n            i = self.prei[x]\n            flow = min(flow, self.cap[p][i])\n            x = p\n        x = t\n        while self.prex[x] != -1:\n            p = self.prex[x]\n            i = self.prei[x]\n            j = self.rev[p][i]\n            self.cap[p][i] -= flow\n            self.cap[x][j] += flow\n            x = p\n        return flow\n\n    def solve(self, s, t):\n        ans = 0\n        tot = 0\n        while True:\n            f = self.spfa_and_augment(s, t)\n            if f == 0:\n                break\n            tot += f * self.dist[t]\n            ans += f\n        return (ans, tot)\n\ndef get_node(x, tim):\n    return tim * 52 - 52 + x\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    s = NN - 1\n    t = NN - 2\n    mcmf = MCMF()\n    kk = k\n    for _ in range(k):\n        x = int(next(it))\n        mcmf.add_edge(s, get_node(x, 1), 1, 0)\n    k = kk\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf.add_edge(get_node(x, i), get_node(y, i + 1), 1, d * (j + j - 1))\n        x, y = y, x\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf.add_edge(get_node(x, i), get_node(y, i + 1), 1, d * (j + j - 1))\n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            mcmf.add_edge(get_node(j, i), get_node(j, i + 1), INF, 0)\n        mcmf.add_edge(get_node(1, i), t, INF, c * (i - 1))\n    result = mcmf.solve(s, t)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.2993728e-05, 0.0, -2.3841855e-07, -0.0007273889, -0.2689325, -0.016679596, -0.004185844, -0.018614016, -0.00038699768, -8