if (dist[y] > cc && cap[x][i]) {\n                    dist[y] = cc;\n                    prex[y] = x;\n                    prei[y] = i;\n                    if (!vis[y]) {\n                        vis[y] = 1;\n                        q.push(y);\n                    }\n                }\n            }\n        }\n        if (dist[t] > 1e9) return 0;\n        // Augment\n        int flow = inf;\n        int x = t;\n        while (prex[x] != -1) {\n            int p = prex[x];\n            int i = prei[x];\n            flow = min(flow, cap[p][i]);\n            x = p;\n        }\n        x = t;\n        while (prex[x] != -1) {\n            int p = prex[x];\n            int i = prei[x];\n            int j = rev[p][i];\n            cap[p][i] -= flow;\n            cap[x][j] += flow;\n            x = p;\n        }\n        return flow;\n    }\n\n    pii solve(int s, int t) {\n        int ans = 0, tot = 0;\n        while (1) {\n            int f = spfa_and_augment(s, t);\n            if (f == 0) break;\n            tot += f * dist[t];\n            ans += f;\n        }\n        return mp(ans, tot);\n    }\n};\n\nint n, m, s = nn - 1, t = nn - 2;\nint k, c, d;\nint get(int x, int tim) {\n    return tim * 52 - 52 + x;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int kk = k;\n    while (k--) {\n        int x;\n        scanf(\"%d\", &x);\n        mcmf::add_edge(s, get(x, 1), 1, 0);\n    }\n    k = kk;\n    while (m--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n        for (int i = 1; i < 100; i++)\n            for (int j = 1; j <= k; j++)\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n        swap(x, y);\n        for (int i = 1; i < 100; i++)\n            for (int j = 1; j <= k; j++)\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n    }\n    for (int i = 1; i < 100; i++) {\n        for (int j = 1; j <= n; j++)\n            mcmf::add_edge(get(j, i), get(j, i + 1), inf, 0);\n   