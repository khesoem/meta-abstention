.add(i + n);\n                    }\n                }\n                if (hasMatching(l, indices)) {\n                    newmask |= (1 << idxArr[gr]);\n                }\n            }\n            f[newmask] = (int)((f[newmask] + rate) % MOD);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int val = sc.nextInt();\n                p[i][j + n] = (int)((long)val * fpow(100, MOD - 2) % MOD);\n            }\n        }\n\n        if (n == 1) {\n            System.out.println(p[0][1]);\n            return;\n        }\n\n        int m1 = n / 2;\n        int m2 = n - m1;\n\n        int cnt = 0, cnt2 = 0;\n        List<Integer> sub1 = new ArrayList<>();\n        List<Integer> sub2 = new ArrayList<>();\n        for (int mask = 0; mask < (1 << n); mask++) {\n            if (Integer.bitCount(mask) == m1) {\n                idx[0][mask] = cnt++;\n                sub1.add(mask);\n            }\n            if (Integer.bitCount(mask) == m2) {\n                idx[1][mask] = cnt2++;\n                sub2.add(mask);\n            }\n        }\n\n        for (int i = 0; i < sub2.size(); i++) {\n            int mask = sub2.get(i);\n            for (int bigmask = 0; bigmask < (1 << cnt2); bigmask++) {\n                if ((bigmask & (1 << i)) != 0) {\n                    rev[bigmask] |= (1 << idx[0][(1 << n) - 1 - mask]);\n                }\n            }\n        }\n\n        List<Integer> l1 = new ArrayList<>();\n        List<Integer> l2 = new ArrayList<>();\n        List<Integer> r = new ArrayList<>();\n        for (int i = 0; i < m1; i++) l1.add(i);\n        for (int i = m1; i < n; i++) l2.add(i);\n        for (int i = n; i < n + n; i++) r.add(i);\n\n        work(f, l1, r, sub1, idx[0]);\n        work(g, l2, r, sub2, idx[1]);\n\n        for (int i = 0; i < cnt; i++) {\n            for (int ma