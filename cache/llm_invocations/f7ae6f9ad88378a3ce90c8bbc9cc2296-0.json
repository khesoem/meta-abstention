owMod(p, p, MOD));\n        } else {\n            long n = p - 1;\n            long sqrtN = (long) Math.sqrt(n);\n            long z = -1;\n\n            // First pass: i from 1 to sqrtN\n            for (long i = 1; i <= sqrtN; i++) {\n                if (n % i == 0) {\n                    if (powMod(k, i, p) == 1) {\n                        z = i;\n                        break;\n                    }\n                    long j = n / i;\n                    if (j != i && powMod(k, j, p) == 1) {\n                        z = j;\n                        break;\n                    }\n                }\n            }\n\n            // If not found, second pass: i from sqrtN down to 1\n            if (z == -1) {\n                for (long i = sqrtN; i >= 1; i--) {\n                    if (n % i == 0) {\n                        if (powMod(k, i, p) == 1) {\n                            z = i;\n                            break;\n                        }\n                        long j = n / i;\n                        if (j != i && powMod(k, j, p) == 1) {\n                            z = j;\n                            break;\n                        }\n                    }\n                }\n            }\n\n            long result = powMod(p, n / z, MOD);\n            System.out.println(result);\n        }\n    }\n\n    // Fast modular exponentiation: (base^exp) % mod\n    static long powMod(long base, long exp, long mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.2186455882765586e-06, 0.0, 0.0, -1.8000440832111053e-05, -7.033323527139146e-06, -1.1920928244535389e-07, -0.0015046000480651855, -0.005785742308944464, -0.06197870895266533, -9.655906069383