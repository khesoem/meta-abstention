t * 10 + (isNegative ? -1 : 1);\n        val /= 10;\n    }\n    adjustment = adjustment * 10 + 1;\n    return isNegative ? original + adjustment : original - adjustment;\n}\n\ni64 getFirstDigit(i64 val) {\n    if (val < 0) val = -val;\n    while (val >= 10) {\n        val /= 10;\n    }\n    return val;\n}\n\ni64 removeLastDigit(i64 val) {\n    if (val < 0) val = -val;\n    vector<int> digits;\n    while (val >= 10) {\n        digits.push_back(val % 10);\n        val /= 10;\n    }\n    i64 res = 0;\n    for (int i = digits.size() - 1; i >= 0; --i) {\n        res = res * 10 + digits[i];\n    }\n    return res;\n}\n\nunordered_map<i64, i64> cache;\n\ni64 compute(i64 val) {\n    if (val <= 11) return min(13 - val, val);\n    if (cache.count(val)) return cache[val];\n    i64 n = 0, threshold = 1;\n    while (threshold < val) {\n        threshold *= 10;\n        threshold += 1;\n        ++n;\n    }\n    if (val * 2 >= threshold) {\n        i64 option1 = compute(threshold - val) + n + 1;\n        i64 base = threshold / 10;\n        i64 option2 = (val / base) * n + compute(val % base);\n        return cache[val] = min(option1, option2);\n    }\n    i64 base = threshold / 10;\n    return cache[val] = (val / base) * n + compute(val % base);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    i64 input;\n    cin >> input;\n    cout << compute(input) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    private static Map<Long, Long> cache = new HashMap<>();\n\n    public static long digitCount(long val) {\n        if (val == 0) return 1;\n        if (val < 0) val = -val;\n        long cnt = 0;\n        while (val > 0) {\n            ++cnt;\n            val /= 10;\n        }\n        return cnt;\n    }\n\n    public static long incrementEachDigit(long val) {\n        List<Integer> digits = new ArrayList<>();\n        boolean isNegative = val < 0;\n        if (isNegative) val = -val;\n        while (val > 0) {\n            int d = (int)(val % 10);\n            digits.add(d - (isNegative ? -1 : 1));\n            val /= 10;\n        }\n        long res = 0;\n        for (int i = digits.size() - 1; i >= 0; --i) {\n            res = res * 10 + digits.get(i);\n        }\n        return isNegative ? -res : res;\n    }\n\n    public static long decrementEachDigit(long val) {\n        boolean isNegative = val < 0;\n        if (isNegative) val = -val;\n        long adjustment = 0;\n        long original = val;\n        while (val > 0) {\n            adjustment = adjustment * 10 + (isNegative ? -1 : 1);\n            val /= 10;\n        }\n        adjustment = adjustment * 10 + 1;\n        return isNegative ? original + adjustment : original - adjustment;\n    }\n\n    public static long getFirstDigit(long val) {\n        if (val < 0) val = -val;\n        while (val >= 10) {\n            val /= 10;\n        }\n        return val;\n    }\n\n    public static long removeLastDigit(long val) {\n        if (val < 0) val = -val;\n        List<Integer> digits = new ArrayList<>();\n        while (val >= 10) {\n            digits.add((int)(val % 10));\n            val /= 10;\n        }\n        long res = 0;\n        for (int i = digits.size() - 1; i >= 0; --i) {\n            res = res * 10 + digits.get(i);\n        }\n        return res;\n    }\n\n    public static long compute(long val) {\n        if (val <= 11) return Math.min(13 - val, val);\n        if (cache.containsKey(val)) return cache.get(val);\n        long n = 0, threshold = 1;\n        while (threshold < val) {\n            threshold *= 10;\n            threshold += 1;\n            ++n;\n        }\n        if (val * 2 >= threshold) {\n            long option1 = compute(threshold - val) + n + 1;\n            long base = threshold / 10;\n            long option2 = (val / base) * n + compu