\n            parts.push_back(part);\n        }\n        \n        int currentMax = 0;\n        for (const std::string& p : parts) {\n            currentMax = std::max(currentMax, static_cast<int>(p.length()));\n        }\n        maxLen = std::max(maxLen, currentMax);\n    }\n    \n    long underscoreCount = 0;\n    size_t idx = 0;\n    while (idx < line.length()) {\n        size_t open = line.find('(', idx);\n        if (open == std::string::npos) break;\n        size_t close = line.find(')', open);\n        if (close == std::string::npos) break;\n        \n        std::string content = line.substr(open + 1, close - open - 1);\n        if (!content.empty()) {\n            int underscoreParts = 1;\n            for (char c : content) {\n                if (c == '_') underscoreParts++;\n            }\n            underscoreCount += underscoreParts;\n            if (content.back() == '_') {\n                underscoreCount--;\n            }\n        }\n        \n        idx = close + 1;\n    }\n    \n    std::cout << maxLen << \" \" << underscoreCount << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00011145447206217796, -4.529942543740617e-06, -2.3841855067985307e-07, -6.437280717364047e-06, -1.1920922133867862e-06, -2.3841830625315197e-06, -2.0265558760002023e-06, -9.179073458653875e-06, -1.2874520507466514e-05, -0.018774425610899925, -2.3841830625315197e-06, -4.291525328881107e-06, -1.311301275563892e-06, -0.0363064669072628, -8.344646857949556e-07, -5.960462772236497e-07, -2.3841855067985307e-07, -0.6795230507850647, -1.7881377516459906e-06, -7.152555099310121e-07, 0.0, -0.004828697070479393, -0.00017975145601667464, -1.9192511899746023e-05, -1.1920928244535389e-07, -0.08394087105989456, -4.470248313737102e-05, -0.20141752064228058, -0.6378794312477112, -0.00018475732940714806, -1.7881377516459906e-06, -2.3841855067985307e-07, -3.4570634852570947e-06, -0.023571044206619263, -2.0265558760002023e-06