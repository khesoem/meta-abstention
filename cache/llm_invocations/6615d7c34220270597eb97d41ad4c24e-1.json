              for i in range(1, n - last_known):\n                    f_inv.append(self.mult(f_inv[i - 1], n - i + 1))\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(f_inv[i])\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g %= r\n                g, r = r, g\n                x -= q * y\n                x, y = y, x\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            if not (y == self.modulus() or y == -self.modulus()):\n                pass  # assertion check skipped\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n\n    def solve(self, testNumber, in_reader, out_writer):\n        n = in_reader.nextInt()\n        m = in_reader.nextInt()\n\n        self.mod.fInv(n + m)\n\n        phase_size = 1\n        p = 1\n        for i in range(n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(self.mod.mult(p, n - i), self.mod.smallInv(n + m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, n + 1):\n            num_phases = self.mod.mult(m + k, self.mod.smallInv(k))\n            term = self.mod.mult(self.mod.ncr(n, k), self.mod.mult(num_phases, phase_size))\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out_writer.println(answer)\n\n\ndef main():\n    input_stream = sys.stdin\n    output_stream = sys.stdout\n\n    in_reader = InputReader(input_stream)\n    out_writer = lambda x: output_stream.write(str(x) + '\\n')\n\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out_writer)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.594620157964528e-05, -1.0728830375228426e-06, -4.768370445162873e-07, -0.0006095697171986103, -0.023583153262734413, -0.0036086218897253275, -0.12695786356925964, -0.49432915449142456, -0.011099145747721195, -0.05022652447223663, -0.812241792678833, -1.9073468138230965e-06, -4.172316494077677e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -0.00017426878912374377, -1.0728830375228426e-06, -5.960462772236497e-07, -4.529942543740617e-06, -3.576278118089249e-07, -2.586808113846928e-05, -1.07287787614041e-05, -1.9073468138230965e-06, -6.747018051100895e-05, -0.00013660451804753393, -1.1920928244535389e-07, -0.013524924404919147, -0.0008081507403403521, -2.3841830625315197e-06, -1.764281842042692e-05, -0.0005264088395051658, -7.152531907195225e-06, -5.960462772236497e-07, -0.00039295581518672407, -0.009940407238900661, -3.576278118089249e-07, -8.344646857949556e-07, -0.00033849707688204944, -8.356221951544285e-05, -1.1086402082582936e-05, -2.3841855067985307e-07, -9.65590606938349e