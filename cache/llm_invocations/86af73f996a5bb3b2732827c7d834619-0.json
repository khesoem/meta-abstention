nominator = -denominator;\n        }\n    }\n    \n    void display() const {\n        cout << numerator << \"/\" << denominator;\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> x >> y >> n;\n    \n    Fraction target(x, y);\n    Fraction bestDiff(50, 1);\n    Fraction bestFraction;\n    \n    for (long long i = 1; i <= n; ++i) {\n        long long q = (target.numerator * i) / target.denominator;\n        long long r = (target.numerator * i) % target.denominator;\n        \n        if (r > target.denominator / 2) {\n            q++;\n            r = target.denominator - r;\n        }\n        \n        Fraction diff(r, i * target.denominator);\n        diff.simplify();\n        \n        if (diff < bestDiff) {\n            bestDiff = diff;\n            bestFraction.numerator = q;\n            bestFraction.denominator = i;\n        }\n    }\n    \n    bestFraction.display();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static long gcd(long a, long b) {\n        if (b == 0) return a;\n        return gcd(b, a % b);\n    }\n\n    static class Fraction {\n        long numerator, denominator;\n\n        Fraction() {\n            numerator = 0;\n            denominator = 1;\n        }\n\n        Fraction(long n, long d) {\n            numerator = n;\n            denominator = d;\n        }\n\n        void subtract(Fraction other) {\n            numerator = numerator * other.denominator - other.numerator * denominator;\n            denominator = denominator * other.denominator;\n        }\n\n        boolean lessThan(Fraction other) {\n            return numerator * other.denominator < other.numerator * denominator;\n        }\n\n        void simplify() {\n            long g = gcd(Math.abs(numerator), Math.abs(denominator));\n            if (g > 0) {\n                numerator /= g;\n                denominator /= g;\n            }\n            if (denominator < 0) {\n                numerator = -numerator;\n                denominator = -denominator;\n            }\n        }\n\n        void display() {\n            System.out.println(numerator + \"/\" + denominator);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        \n        Fraction target = new Fraction(x, y);\n        Fraction bestDiff = new Fraction(50, 1);\n        Fraction bestFraction = new Fraction();\n        \n        for (long i = 1; i <= n; ++i) {\n            long q = (target.numerator * i) / target.denominator;\n            long r = (target.numerator * i) % target.denominator;\n            \n            if (r > target.denominator / 2) {\n                q++;\n                r = target.denominator - r;\n            }\n            \n            Fraction diff = new Fraction(r, i * target.denominator);\n            diff.simplify();\n            \n            if (diff.lessThan(bestDiff)) {\n                bestDiff = diff;\n                bestFraction.numerator = q;\n                bestFraction.denominator = i;\n            }\n        }\n        \n        bestFraction.display();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.297892393078655e-05, -2.7418097943154862e-06, -9.536738616588991e-07, -0.0006226746481843293, -9.65590606938349e-06, -0.045972131192684174, -0.08500627428293228, -0.011057528667151928, -2.3841855067985307e-07, -2.753696753643453e-05, -0.006715585943311453, -0.002185577293857932, -0.06223447248339653, -0.016054995357990265, -0.3142186999320984, -1.537788011773955e-05, -3.576278118089249e-07, 0.0, -9.298280929215252e-06, -5.960462772236497e-07, -1.0728830375228426e-06, 0.0, -3