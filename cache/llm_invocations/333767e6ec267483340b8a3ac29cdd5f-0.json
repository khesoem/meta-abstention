 not data:\n            return\n        n, m = data[0], data[1]\n        answer = 0\n\n        if n > 100:\n            rem = (n - 100) % 6\n            q = (n - 100) // 6\n            answer += q * 6 * m\n            n = 100 + rem\n\n        if m > 100:\n            rem = (m - 100) % 6\n            q = (m - 100) // 6\n            answer += q * 6 * n\n            m = 100 + rem\n\n        # 1-indexed id array\n        id = [[0] * (m + 1) for _ in range(n + 1)]\n        even = 1\n        odd = 1\n\n        for i in range(1, n + 1):\n            for j in range(1, m + 1):\n                if ((i + j) & 1) == 0:\n                    id[i][j] = even\n                    even += 1\n        for i in range(1, n + 1):\n            for j in range(1, m + 1):\n                if ((i + j) & 1) != 0:\n                    id[i][j] = odd\n                    odd += 1\n\n        L = even - 1\n        R = odd - 1\n        graph = [[] for _ in range(L + 1)]  # index 0 unused\n\n        for i in range(1, n + 1):\n            for j in range(1, m + 1):\n                if ((i + j) & 1) == 0:\n                    self.add_edge(graph, id, i, j, i - 3, j, n, m)\n                    self.add_edge(graph, id, i, j, i - 2, j - 1, n, m)\n                    self.add_edge(graph, id, i, j, i - 2, j + 1, n, m)\n                    self.add_edge(graph, id, i, j, i, j - 3, n, m)\n                    self.add_edge(graph, id, i, j, i - 1, j - 2, n, m)\n                    self.add_edge(graph, id, i, j, i + 1, j - 2, n, m)\n                    self.add_edge(graph, id, i, j, i, j + 3, n, m)\n                    self.add_edge(graph, id, i, j, i - 1, j + 2, n, m)\n                    self.add_edge(graph, id, i, j, i + 1, j + 2, n, m)\n                    self.add_edge(graph, id, i, j, i + 3, j, n, m)\n                    self.add_edge(graph, id, i, j, i + 2, j - 1, n, m)\n                    self.add_edge(graph, id, i, j, i + 2, j + 1, n, m)\n\n        kuhn = KuhnMatching(L, R, graph)\n        answer += 2 * kuhn.max_matching()\n        print(answer)\n\n    def add_edge(self, graph, id, i, j, s, t, n, m):\n        if s <= 0 or t <= 0 or s > n or t > m:\n            return\n        graph[id[i][j]].append(id[s][t])\n\n\nclass KuhnMatching:\n    def __init__(self, m, n, graph):\n        self.m = m  # number of left vertices (even cells)\n        self.n = n  # number of right vertices (odd cells)\n        self.graph = graph\n        self.matchR = [-1] * (n + 1)\n        self.used = [False] * (m + 1)\n\n    def max_matching(self):\n        # greedy matching\n        for u in range(1, self.m + 1):\n            for v in self.graph[u]:\n                if self.matchR[v] == -1:\n                    self.matchR[v] = u\n                    break\n\n        matching = 0\n        # count already matched left vertices\n        matched_left = [False] * (self.m + 1)\n        for v in range(1, self.n + 1):\n            if self.matchR[v] != -1:\n                matched_left[self.matchR[v]] = True\n        matching = sum(matched_left)\n\n        for u in range(1, self.m + 1):\n            if not matched_left[u]:\n                self.used = [False] * (self.m + 1)\n                if self.dfs(u):\n                    matching += 1\n        return matching\n\n    def dfs(self, u):\n        if self.used[u]:\n            return False\n        self.used[u] = True\n        for v in self.graph[u]:\n            if self.matchR[v] == -1 or self.dfs(self.matchR[v]):\n                self.matchR[v] = u\n                return True\n        return False\n\n\nif __name__ == \"__main__\":\n    Solver().solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.1086402082582936e-05, 0.0, 0.0, -4.446407547220588e-05, -3.015949550899677e-05, 0.0, -0.029756896197795868, -0.02977830357849598, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.00253700977191329, -0.47408056259155273, -0.012223806232213974, -3.957670196541585e-05, -0.029759211465716362, -0.102179020