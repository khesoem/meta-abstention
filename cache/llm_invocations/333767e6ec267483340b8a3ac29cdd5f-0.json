dd = 1;\n\n            for (int i = 1; i <= n; i++) {\n                for (int j = 1; j <= m; j++) {\n                    if (((i + j) & 1) == 0) id[i][j] = even++;\n                }\n            }\n            for (int i = 1; i <= n; i++) {\n                for (int j = 1; j <= m; j++) {\n                    if (((i + j) & 1) != 0) id[i][j] = odd++;\n                }\n            }\n\n            int L = even - 1;\n            int R = odd - 1;\n            List<Integer>[] graph = new List[L + 1];\n            for (int i = 0; i <= L; i++) graph[i] = new ArrayList<>();\n\n            for (int i = 1; i <= n; i++) {\n                for (int j = 1; j <= m; j++) {\n                    if (((i + j) & 1) == 0) {\n                        addEdge(graph, id, i, j, i - 3, j);\n                        addEdge(graph, id, i, j, i - 2, j - 1);\n                        addEdge(graph, id, i, j, i - 2, j + 1);\n                        addEdge(graph, id, i, j, i, j - 3);\n                        addEdge(graph, id, i, j, i - 1, j - 2);\n                        addEdge(graph, id, i, j, i + 1, j - 2);\n                        addEdge(graph, id, i, j, i, j + 3);\n                        addEdge(graph, id, i, j, i - 1, j + 2);\n                        addEdge(graph, id, i, j, i + 1, j + 2);\n                        addEdge(graph, id, i, j, i + 3, j);\n                        addEdge(graph, id, i, j, i + 2, j - 1);\n                        addEdge(graph, id, i, j, i + 2, j + 1);\n                    }\n                }\n            }\n\n            KuhnMatching kuhn = new KuhnMatching(L, R, graph);\n            answer += 2L * kuhn.maxMatching();\n            out.println(answer);\n        }\n\n        void addEdge(List<Integer>[] graph, int[][] id, int i, int j, int s, int t) {\n            if (s <= 0 || t <= 0 || s > n || t > m) return;\n            graph[id[i][j]].add(id[s][t]);\n        }\n    }\n\n    static class KuhnMatching {\n        int m, n;\n        List<Integer>[] graph;\n  