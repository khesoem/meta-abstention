 reader;\n    unique_ptr<StringTokenizer> stt;\n};\n\nclass StringTokenizer {\npublic:\n    StringTokenizer(const string& line) {\n        istringstream iss(line);\n        tokens.clear();\n        string token;\n        while (iss >> token) {\n            tokens.push_back(token);\n        }\n        pos = 0;\n    }\n\n    bool hasMoreTokens() const {\n        return pos < tokens.size();\n    }\n\n    string nextToken() {\n        if (pos < tokens.size()) {\n            return tokens[pos++];\n        }\n        return \"\";\n    }\n\nprivate:\n    vector<string> tokens;\n    size_t pos;\n};\n\nclass TaskC {\npublic:\n    void solve(int testNumber, InputReader& in, ostream& out) {\n        n = in.nextInt();\n        m = in.nextInt();\n        if (n > m) {\n            swap(n, m);\n        }\n        \n        f = vector<vector<int>>(n, vector<int>(m, 0));\n        res = INT_MAX;\n        cur = 0;\n        step = 1;\n        numFree = n * m;\n        rec(0, 0);\n        out << n * m - res << endl;\n    }\n\nprivate:\n    void rec(int x, int y) {\n        if (numFree == 0) {\n            res = min(res, cur);\n            return;\n        }\n        if (x >= n) return;\n        if (y >= m) {\n            rec(x + 1, 0);\n            return;\n        }\n        if (f[x][y] != 0) {\n            rec(x, y + 1);\n            return;\n        }\n\n        put(x, y);\n        rec(x, y + 1);\n        remove(x, y);\n\n        if (isValid(x + 1, y)) {\n            put(x + 1, y);\n            rec(x, y + 1);\n            remove(x + 1, y);\n        }\n\n        if (isValid(x, y + 1)) {\n            put(x, y + 1);\n            rec(x, y + 1);\n            remove(x, y + 1);\n        }\n    }\n\n    void put(int x, int y) {\n        for (int i = 0; i < 5; ++i) {\n            int nx = x + dx[i];\n            int ny = y + dy[i];\n            if (isValid(nx, ny)) {\n                if (f[nx][ny] == 0) {\n                    --numFree;\n                    f[nx][ny] = step;\n                }\n            }\n        }\n        ++step;\n        ++cur;\n    }\n\n    void remove(int x, int y) {\n        --step;\n        for (int i = 0; i < 5; ++i) {\n            int nx = x + dx[i];\n            int ny = y + dy[i];\n            if (isValid(nx, ny)) {\n                if (f[nx][ny] == step) {\n                    ++numFree;\n                    f[nx][ny] = 0;\n                }\n            }\n        }\n        --cur;\n    }\n\n    bool isValid(int x, int y) {\n        return x >= 0 && y >= 0 && x < n && y < m;\n    }\n\n    int n, m;\n    vector<int> dx = {-1, 0, 1, 0, 0};\n    vector<int> dy = {0, 1, 0, -1, 0};\n\n    int step;\n    int numFree;\n    int cur;\n    int res;\n    vector<vector<int>> f;\n};\n\nint main() {\n    InputReader in(cin);\n    TaskC solver;\n    solver.solve(1, in, cout);\n    return 0;\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-8.05822346592322e-05, -2.145764938177308e-06, -2.3841855067985307e-07, -0.0012159105390310287, -1.0728830375228426e-06, -3.814624506048858e-05, -1.311301275563892e-06, -1.6689286894688848e-06, -1.4305104514278355e-06, -0.01968982070684433, -1.0728830375228426e-06, -1.0609570381348021e-05, -2.3841855067985307e-07, -0.5239739418029785, -2.50339189733495e-06, -9.178694017464295e-05, -1.1920922133867862e-06, -0.4864668846130371, -5.364403477869928e-06, -6.198863957251888e-06, -1.1920928244535389e-07, -0.6952630281448364, -3.635817120084539e-05, -0.00015901254664640874, -0.004078879952430725, -7.152555099310121e-07, -0.00041083001997321844, -0.1797478348016739, -0.01816798932850361, -1.7404405298293568e-05, -1.5497195136049413e-06, -1.0728830375228426e-06, -0.0023913378827273846, -0.3484945595264435, -2.264974000354414e-06, -3.3378546504536644e-06, -0.5760208964347839, -2.3841855067985307e-07, -2.3841855067985307e-07, -0.6581358313560486, -1.5497195136049413e-06, -0.15104570984840393, -0.011701046489179134, -0.002410722430795431, -7.795983401592821e-05, -2.276871418871451e-0