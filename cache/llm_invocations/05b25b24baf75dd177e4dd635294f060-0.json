ort sys\nfrom collections import deque\n\nMAX_SIZE = 7100\nINF = 1000000000\n\nclass Dinic:\n    def __init__(self):\n        self.S = 0\n        self.T = MAX_SIZE - 2\n        self.E = []  # list of [from, to, flow, cap]\n        self.G = [[] for _ in range(MAX_SIZE)]\n        self.level = [0]*MAX_SIZE\n        self.mark = [0]*MAX_SIZE\n        self.ptr = [0]*MAX_SIZE\n\n    def addEdge(self, u, v, cap):\n        self.E.append([u, v, 0, cap])\n        self.E.append([v, u, 0, 0])\n        self.G[u].append(len(self.E)-2)\n        self.G[v].append(len(self.E)-1)\n\n    def bfs(self):\n        self.mark = [0]*MAX_SIZE\n        self.level = [0]*MAX_SIZE\n        q = deque()\n        q.append(self.S)\n        self.mark[self.S] = 1\n        self.level[self.S] = 0\n        while q:\n            v = q.popleft()\n            for idx in self.G[v]:\n                e = self.E[idx]\n                if not self.mark[e[1]] and e[3] > e[2]:\n                    self.level[e[1]] = self.level[v] + 1\n                    q.append(e[1])\n                    self.mark[e[1]] = 1\n        return self.mark[self.T]\n\n    def dfs(self, v, flow):\n        if v == self.T or flow == 0:\n            return flow\n        pushed = 0\n        i = self.ptr[v]\n        while i < len(self.G[v]):\n            e_idx = self.G[v][i]\n            e = self.E[e_idx]\n            if self.level[v] + 1 == self.level[e[1]]:\n                minf = min(flow, e[3] - e[2])\n                add = self.dfs(e[1], minf)\n                if add > 0:\n                    e[2] += add\n                    self.E[e_idx ^ 1][2] -= add\n                    pushed += add\n                    flow -= add\n                    if flow == 0:\n                        break\n            i += 1\n            self.ptr[v] = i\n        return pushed\n\n    def maxFlow(self):\n        flow = 0\n        while self.bfs():\n            self.ptr = [0]*MAX_SIZE\n            flow += self.dfs(self.S, INF)\n        return flow\n\ndef BFS(sx, sy, n, g1):\n    dist = [[111]*(n+1) for _ in range(n+1)]\n    seen = [[False]*(n+1) for _ in range(n+1)]\n    q = deque()\n    dist[sx][sy] = 0\n    q.append(((sx, sy), 0))\n    dx = [1, 0, 0, -1]\n    dy = [0, 1, -1, 0]\n    while q:\n        (cx, cy), d = q.popleft()\n        if seen[cx][cy]:\n            continue\n        seen[cx][cy] = True\n        dist[cx][cy] = d\n        for i in range(4):\n            nx = cx + dx[i]\n            ny = cy + dy[i]\n            if 1 <= nx <= n and 1 <= ny <= n and not seen[nx][ny] and g1[nx][ny] != 'Y':\n                q.append(((nx, ny), d+1))\n    return dist\n\ndef idx(l, x, y, n):\n    return l * n * n + (x-1) * n + y\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    g1 = [['']*(n+1) for _ in range(n+1)]\n    g2 = [['']*(n+1) for _ in range(n+1)]\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            g1[i][j] = line[j-1]\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            g2[i][j] = line[j-1]\n\n    mf = Dinic()\n    mf.S = 0\n    mf.T = MAX_SIZE - 2\n\n    sx = 0\n    sy = 0\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if g1[i][j] == 'Z':\n                sx = i\n                sy = j\n                break\n        if sx:\n            break\n\n    tgt = [0]*(n*n+1)\n    for i in range(1, n*n+1):\n        tgt[i] = MAX_SIZE - 3 - (n*n - i)\n\n    dist = BFS(sx, sy, n, g1)\n\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '0' <= g1[i][j] <= '9':\n                mf.addEdge(mf.S, idx(0, i, j, n), ord(g1[i][j]) - ord('0'))\n            if '0' <= g2[i][j] <= '9':\n                mf.addEdge(tgt[idx(0, i, j, n)], mf.T, ord(g2[i][j]) - ord('0'))\n            mf.addEdge(idx(0, i, j, n), tgt[idx(0, i, j, n)], INF)\n\n    dx = [1, 0, 0, -1]\n    dy = [0, 1, -1, 0]\n    for i in range(1, t+1):\n        for j in range(1, n+1):\n            for k in range(1, n+1):\n                if g1[j][k] == 'Y' or g1[j][k] == 'Z':\n                    continue\n                for l in range(4):\n                    tx = dx[l] + j\n                    ty = dy[l] + k\n                    if 1 <= tx <= n and 1 <= ty <= n and g1[tx][ty] != 'Y' and g1[tx][ty] != 'Z':\n                        if dist[j][k] >= i and dist[tx][ty] >= i:\n                            mf.addEdge(idx(i-1, tx, ty, n), idx(i, j, k, n), INF)\n                mf.addEdge(idx(i, j, k, n), tgt[idx(0, j, k, n)], INF)\n\n    print(mf.maxFlow())\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(1000000)\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, 0.0, 0.0, -4.911301948595792e-05, -0.0009192770230583847, 0.0, -9.536738616588991e-07, -2.50339189733495e-06, 0.0, 0.0, 0.0, -4.577531944960356e-05, -0.0009180859779007733, -2.3841855067985307e-07, 0.0, 0.0, -4.768370445162873e-07, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.7418097943154862e-06, -7.510157047363464e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.0728830375228426e-06, -0.000916418619453907, -1.6689286894688848e-06, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -8.344646857949556e-07, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, 0.0, 0.0, -3.576272320060525e-06, 0.0, 0.0, -5.829164365422912e-05, 0.0, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -2.264974000354414e-06, 0.0, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -0.014163566753268242, -0.020929669961333275, 0.0, -0.06681529432535172, -1.2159273865108844e-05, -1.07287787614041e-05, -0.0002703301142901182, -8.344646857949556e-07, -2.0265558760002023e-06, 0.0, 0.0, 0.0, -5.125986263010418e-06, -1.311301275563892e-06,