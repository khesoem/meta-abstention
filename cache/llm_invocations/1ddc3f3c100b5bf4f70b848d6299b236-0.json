ble y) { this.x = x; this.y = y; }\n            Point add(Point o) { return new Point(x + o.x, y + o.y); }\n            Point sub(Point o) { return new Point(x - o.x, y - o.y); }\n            Point rotate(double alpha) {\n                double c = Math.cos(alpha), s = Math.sin(alpha);\n                return new Point(x * c - y * s, x * s + y * c);\n            }\n            Point norm() { double len = length(); return scale(1.0 / len); }\n            Point scale(double f) { return new Point(f * x, f * y); }\n            double length() { return Math.sqrt(x * x + y * y); }\n            public String toString() { return String.format(\"%.6f %.6f\", x, y); }\n            public boolean equals(Object obj) {\n                Point o = (Point) obj;\n                return Math.abs(x - o.x) < eps && Math.abs(y - o.y) < eps;\n            }\n            public int compareTo(Point o) {\n                if (Math.abs(x - o.x) > eps) return x < o.x ? -1 : 1;\n                if (Math.abs(y - o.y) > eps) return y < o.y ? -1 : 1;\n                return 0;\n            }\n        }\n\n        static class Circle {\n            Point o; double r;\n            boolean contains(Point p) {\n                double dist = p.sub(o).length();\n                return Math.abs(dist - r) < eps;\n            }\n        }\n\n        public void solve(int testNumber, FastScanner in, PrintWriter out) {\n            int n = in.nextInt();\n            Circle[] circles = new Circle[n];\n            for (int i = 0; i < n; i++) {\n                int x = in.nextInt(), y = in.nextInt(), r = in.nextInt();\n                circles[i] = new Circle();\n                circles[i].o = new Point(x, y);\n                circles[i].r = r;\n            }\n\n            Set<Point> all = new TreeSet<>();\n            for (int i = 0; i < n; i++) {\n                for (int j = i + 1; j < n; j++) {\n                    List<Point> inter = intersect(circles[i], circles[j]);\n                    if (inter == null)