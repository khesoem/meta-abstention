{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cmath>\n#include <algorithm>\n#include <map>\n\nusing namespace std;\n\nusing ll = long long;\n\nll mod_pow(ll base, int exp, int mod) {\n    ll result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) \n            result = (result * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k, p;\n    cin >> n >> k >> p;\n\n    if (n % 2 == 1) {\n        cout << mod_pow(k, n, p) << '\\n';\n        return 0;\n    }\n\n    vector<ll> fact(n + 1), rfact(n + 1);\n    fact[0] = 1;\n    rfact[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        fact[i] = fact[i-1] * i % p;\n        rfact[i] = mod_pow(fact[i], p-2, p);\n    }\n\n    vector<vector<ll>> g(n + 1, vector<ll>(17, 0));\n    g[0][0] = 1;\n\n    for (int mask = 1; mask <= n; ++mask) {\n        if ((mask & n) != mask) continue;\n        \n        vector<int> bits;\n        for (int j = 0; j < 18; ++j) {\n            if (mask & (1 << j)) \n                bits.push_back(j);\n        }\n\n        if (bits.empty()) continue;\n\n        // Count subsets\n        int total_subsets = 1 << bits.size();\n        for (int subset = 1; subset < total_subsets; ++subset) {\n            int l = 0;\n            for (int j = 0; j < (int)bits.size(); ++j) {\n                if (subset & (1 << j)) {\n                    l ^= (1 << bits[j]);\n                }\n            }\n            for (int i = 1; i < 17; ++i) {\n                g[mask][i] = (g[mask][i] + rfact[l] * g[mask ^ l][i-1]) % p;\n            }\n        }\n    }\n\n    for (int i = 0; i <= n; ++i) {\n        for (int j = 0; j < 17; ++j) {\n            g[i][j] %= p;\n            if (g[i][j] < 0) g[i][j] += p;\n        }\n    }\n\n    ll ans = 0;\n    int upper = min(16, k);\n    for (int i = 1; i <= upper; ++i) {\n        ll term = fact[n] * g[n][i] % p;\n        term = term * fact[k] % p;\n        term = term * rfact[k - i] % p;\n        ans = (ans + term) % p;\n    }\n\n    ans = (mod_pow(k, n, p) - ans + p) % p;\n    cout << ans << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_pow(base, exp, mod):\n    result = 1\n    base %= mod\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return result\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    \n    if n % 2 == 1:\n        print(mod_pow(k, n, p))\n        return\n    \n    fact = [1] * (n + 1)\n    rfact = [1] * (n + 1)\n    \n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % p\n        rfact[i] = mod_pow(fact[i], p-2, p)\n    \n    g = [[0] * 17 for _ in range(n + 1)]\n    g[0][0] = 1\n    \n    for mask in range(1, n + 1):\n        if (mask & n) != mask:\n            continue\n        \n        bits = []\n        for j in range(18):\n            if mask & (1 << j):\n                bits.append(j)\n        \n        if not bits:\n            continue\n        \n        total_subsets = 1 << len(bits)\n        for subset in range(1, total_subsets):\n            l = 0\n            for j in range(len(bits)):\n                if subset & (1 << j):\n                    l ^= (1 << bits[j])\n            \n            for i in range(1, 17):\n                g[mask][i] = (g[mask][i] + rfact[l] * g[mask ^ l][i-1]) % p\n    \n    for i in range(n + 1):\n        for j in range(17):\n            g[i][j] %= p\n            if g[i][j] < 0:\n                g[i][j] += p\n    \n    ans = 0\n    upper = min(16, k)\n    for i in range(1, upper + 1):\n        term = fact[n] * g[n][i] % p\n        term = term * fact[k] % p\n        term = term * rfact[k - i] % p\n        ans = (ans + term) % p\n    \n    ans = (mod_pow(k, n, p) - ans + p) % p\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002632986579556018, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.18025635182857513, -0.0011100566480308771, -0.28117072582244873, -0.00016425691137555987, -4.279521817807108e-05, -1.1086402082582936e-05, -1.7881377516459906e-06, -4.887569048150908e-06, -6.198863957251888e-06, -2.7418097943154862e-06, -9.059865078597795e-06, -1.3351351299206726e-05, -1.1920928244535389e-07, -1.1920922133867862e-06, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -0.0007640779949724674, -7.152555099310121e-07, -3.576278118089249e-07, 0.0, -1.4305104514278355e-06, -7.271740287251305e-06, -3.576278118089249e-07, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.3987260141875595e-05, -3.576278118089249e-07, 0.0, 0.0, -0.0002040654799202457, -9.536738616588991e-07, -1.1920928244535389e-07, 0.0, -2.38418550