 flow_graph[MAX_NODES << 2];\ni32 edge_idx = 0;\ni32 head[MAX_NODES];\ni32 dist[MAX_NODES], prev_edge[MAX_NODES], inq[MAX_NODES];\n\nvoid add_flow_edge(i32 u, i32 v, i32 cap, i32 cost) {\n    flow_graph[edge_idx] = {v, cap, cost, head[u]};\n    head[u] = edge_idx++;\n    flow_graph[edge_idx] = {u, 0, -cost, head[v]};\n    head[v] = edge_idx++;\n}\n\nbool spfa(i32 src, i32 dst) {\n    fill(dist, dist + dst + 1, INF);\n    fill(inq, inq + dst + 1, 0);\n    queue<i32> q;\n    q.push(src);\n    dist[src] = 0;\n    \n    while (!q.empty()) {\n        i32 u = q.front(); q.pop();\n        inq[u] = 0;\n        \n        for (i32 e = head[u]; ~e; e = flow_graph[e].next) {\n            i32 v = flow_graph[e].to;\n            if (flow_graph[e].capacity && dist[v] > dist[u] + flow_graph[e].cost) {\n                dist[v] = dist[u] + flow_graph[e].cost;\n                prev_edge[v] = e;\n                if (!inq[v]) {\n                    inq[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return dist[dst] < INF;\n}\n\ni32 min_cost_flow(i32 src, i32 dst) {\n    i32 total_flow = 0, total_cost = 0;\n    while (spfa(src, dst)) {\n        i32 flow = INF;\n        for (i32 node = dst; node != src; node = flow_graph[prev_edge[node] ^ 1].to) {\n            chmin(flow, flow_graph[prev_edge[node]].capacity);\n        }\n        total_cost += flow * dist[dst];\n        total_flow += flow;\n        for (i32 node = dst; node != src; node = flow_graph[prev_edge[node] ^ 1].to) {\n            flow_graph[prev_edge[node]].capacity -= flow;\n            flow_graph[prev_edge[node] ^ 1].capacity += flow;\n        }\n    }\n    cerr << \"flow=\" << total_flow << \"\\n\";\n    return total_cost;\n}\n\nint main() {\n    i32 n, m, K, C, D;\n    scanf(\"%d%d%d%d%d\", &n, &m, &K, &C, &D);\n    \n    vi pos(K);\n    for (i32 i = 0; i < K; ++i) {\n        scanf(\"%d\", &pos[i]);\n        --pos[i];\n    }\n    \n    vector<pii> edges(m);\n    for (i32 i = 0;