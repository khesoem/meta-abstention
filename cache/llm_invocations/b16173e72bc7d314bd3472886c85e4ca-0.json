nq = [0] * MAX_NODES\n\ndef add_flow_edge(u, v, cap, cost):\n    global edge_idx\n    flow_graph[edge_idx] = FlowEdge(v, cap, cost, head[u])\n    head[u] = edge_idx\n    edge_idx += 1\n    flow_graph[edge_idx] = FlowEdge(u, 0, -cost, head[v])\n    head[v] = edge_idx\n    edge_idx += 1\n\ndef spfa(src, dst):\n    global dist, inq, prev_edge\n    dist = [INF] * (dst + 1)\n    inq = [0] * (dst + 1)\n    q = deque()\n    q.append(src)\n    dist[src] = 0\n    \n    while q:\n        u = q.popleft()\n        inq[u] = 0\n        \n        e = head[u]\n        while e != -1:\n            edge = flow_graph[e]\n            v = edge.to\n            if edge.capacity > 0 and dist[v] > dist[u] + edge.cost:\n                dist[v] = dist[u] + edge.cost\n                prev_edge[v] = e\n                if inq[v] == 0:\n                    inq[v] = 1\n                    q.append(v)\n            e = edge.next\n    \n    return dist[dst] < INF\n\ndef min_cost_flow(src, dst):\n    total_flow = 0\n    total_cost = 0\n    \n    while spfa(src, dst):\n        flow = INF\n        node = dst\n        while node != src:\n            e = prev_edge[node]\n            flow = min(flow, flow_graph[e].capacity)\n            node = flow_graph[e ^ 1].to\n        \n        total_cost += flow * dist[dst]\n        total_flow += flow\n        \n        node = dst\n        while node != src:\n            e = prev_edge[node]\n            flow_graph[e].capacity -= flow\n            flow_graph[e ^ 1].capacity += flow\n            node = flow_graph[e ^ 1].to\n    \n    print(f\"flow={total_flow}\", file=sys.stderr)\n    return total_cost\n\ndef main():\n    global edge_idx, head, flow_graph\n    \n    data = sys.stdin.read().split()\n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    K = int(data[idx]); idx += 1\n    C = int(data[idx]); idx += 1\n    D = int(data[idx]); idx += 1\n    \n    pos = []\n    for i in range(K):\n        p = int(data[idx]); idx += 1\n        pos.append(p - 1)\n    \n    edges = []\n    for i in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        edges.append((u - 1, v - 1))\n    \n    node_id = [[0] * MAX_M for _ in range(51)]\n    node_count = 0\n    for i in range(n):\n        for j in range(MAX_M):\n            node_id[i][j] = node_count\n            node_count += 1\n    \n    source = node_count\n    sink = source + 1\n    \n    head = [-1] * MAX_NODES\n    edge_idx = 0\n    \n    for i in range(K):\n        add_flow_edge(source, node_id[pos[i]][0], 1, 0)\n    \n    for i in range(MAX_M):\n        add_flow_edge(node_id[0][i], sink, K, C * i)\n    \n    for i in range(n):\n        for j in range(MAX_M - 1):\n            add_flow_edge(node_id[i][j], node_id[i][j + 1], K, 0)\n    \n    for i in range(m):\n        u = edges[i][0]\n        v = edges[i][1]\n        for j in range(MAX_M - 1):\n            for k in range(K):\n                add_flow_edge(node_id[u][j], node_id[v][j + 1], 1, D * (2 * k + 1))\n                add_flow_edge(node_id[v][j], node_id[u][j + 1], 1, D * (2 * k + 1))\n    \n    result = min_cost_flow(source, sink)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016091958968900144, -7.152555099310121e-07, -2.3841855067985307e-07, -0.0031305374577641487, -0.0014569868799299002, -4.768370445162873e-07, -0.0059318686835467815, -0.00035446559195406735, -1.311301275563892e-06, -0.0002992897352669388, -0.011056585237383842, -0.08640594780445099, -3.576278118089249e-07, -4.768360213347478e-06, 0.0, -2.50339189733495e-06, -2.1457441107486375e-05, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -5.483612312673358e-06, -5.960462772236497e-07, -4.768370445162873e-07, -5.960462772236497e-07, -2.861018856492592e-06, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -1.7881377516459906e-06, -3.576278118089249e-07, -4.410734