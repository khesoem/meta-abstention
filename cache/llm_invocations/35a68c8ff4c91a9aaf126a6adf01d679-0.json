{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 510;\nint m, n, mod;\n\ninline int add(int x, int y) { return (1LL * x + y) % mod; }\ninline int sub(int x, int y) { return x - y < 0 ? x - y + mod : x - y; }\ninline int mul(int x, int y) { return 1LL * x * y % mod; }\n\nint factorial[MAXN], inverse[MAXN], inv_fact[MAXN];\nvoid init_factorials(int N) {\n    factorial[0] = inverse[1] = factorial[1] = inv_fact[0] = inv_fact[1] = 1;\n    for (int i = 2; i <= N; i++) inverse[i] = mul(mod - mod / i, inverse[mod % i]);\n    for (int i = 2; i <= N; i++) {\n        factorial[i] = mul(factorial[i - 1], i);\n        inv_fact[i] = mul(inv_fact[i - 1], inverse[i]);\n    }\n}\ninline int choose(int N, int K) {\n    if (N < K || K < 0) return 0;\n    return mul(mul(factorial[N], inv_fact[K]), inv_fact[N - K]);\n}\ninline int multiset_choose(int a, int b) { return choose(a + b - 1, b - 1); }\n\nint A[MAXN], B[MAXN], sumA[MAXN];\nint dpA[MAXN][MAXN], dpB[MAXN][MAXN];\n\nint main() {\n    scanf(\"%d %d %d\", &n, &m, &mod);\n    init_factorials(500);\n    for (int i = 1; i <= n; i++) sumA[i] = add(sumA[i - 1], i);\n    A[0] = 1; A[1] = 2;\n    B[0] = 0; B[1] = 0;\n    for (int i = 2; i <= n; i++) {\n        // Use a single loop for both updates\n        for (int j = 0; j < i; j++) {\n            int comb = choose(i - 1, j);\n            int prod_f = mul(A[j], A[i - 1 - j]);\n            int prod_g = add(mul(B[j], A[i - 1 - j]), mul(B[i - 1 - j], A[j]));\n            int add_f = mul(comb, prod_f);\n            A[i] = add(A[i], mul(add_f, i + 1));\n            B[i] = add(B[i], mul(add_f, sumA[j] + sumA[i - 1 - j]));\n            B[i] = add(B[i], mul(mul(prod_g, i + 1), comb));\n        }\n    }\n    dpA[0][0] = 1; dpB[0][0] = 0;\n    for (int i = 0; i <= m; i++)\n        for (int j = 0; j <= m; j++) {\n            if (!dpA[i][j]) continue;\n            for (int k = 1; k + j <= m; k++) {\n                int c = choose(j + k, k);\n                dpA[i + 1][j + k] = add(dpA[i + 1][j + k], mul(mul(dpA[i][j], A[k]), c));\n                dpB[i + 1][j + k] = add(dpB[i + 1][j + k], mul(add(mul(dpB[i][j], A[k]), mul(dpA[i][j], B[k])), c));\n            }\n        }\n    int ans = 0;\n    for (int i = 1; i <= m; i++)\n        if (n + 1 - m >= i)\n            ans = add(ans, mul(dpB[i][m], multiset_choose(n + 1 - m - i, i + 1)));\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef add(x, y):\n    return (x + y) % mod\n\ndef sub(x, y):\n    return (x - y) % mod\n\ndef mul(x, y):\n    return (x * y) % mod\n\nMAXN = 510\nfactorial = [0] * MAXN\ninverse = [0] * MAXN\ninv_fact = [0] * MAXN\n\ndef init_factorials(N):\n    factorial[0] = 1\n    inverse[1] = 1\n    factorial[1] = 1\n    inv_fact[0] = 1\n    inv_fact[1] = 1\n    for i in range(2, N+1):\n        inverse[i] = mul(mod - mod // i, inverse[mod % i])\n    for i in range(2, N+1):\n        factorial[i] = mul(factorial[i-1], i)\n        inv_fact[i] = mul(inv_fact[i-1], inverse[i])\n\ndef choose(N, K):\n    if N < K or K < 0:\n        return 0\n    return mul(mul(factorial[N], inv_fact[K]), inv_fact[N-K])\n\ndef multiset_choose(a, b):\n    return choose(a + b - 1, b - 1)\n\ndef main():\n    global mod\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, m, mod = map(int, data[:3])\n    init_factorials(500)\n\n    A = [0] * (n+1)\n    B = [0] * (n+1)\n    sumA = [0] * (n+1)\n    for i in range(1, n+1):\n        sumA[i] = add(sumA[i-1], i)\n\n    A[0] = 1\n    A[1] = 2\n    B[0] = 0\n    B[1] = 0\n\n    for i in range(2, n+1):\n        for j in range(i):\n            comb = choose(i-1, j)\n            prod_f = mul(A[j], A[i-1-j])\n            prod_g = add(mul(B[j], A[i-1-j]), mul(B[i-1-j], A[j]))\n            add_f = mul(comb, prod_f)\n            A[i] = add(A[i], mul(add_f, i+1))\n            B[i] = add(B[i], mul(add_f, add(sumA[j], sumA[i-1-j])))\n            B[i] = add(B[i], mul(mul(prod_g, i+1), comb))\n\n    dpA = [[0]*(m+1) for _ in range(m+1)]\n    dpB = [[0]*(m+1) for _ in range(m+1)]\n    dpA[0][0] = 1\n    dpB[0][0] = 0\n\n    for i in range(m+1):\n        for j in range(m+1):\n            if dpA[i][j] == 0:\n                continue\n            for k in range(1, m - j + 1):\n                c = choose(j + k, k)\n                dpA[i+1][j+k] = add(dpA[i+1][j+k], mul(mul(dpA[i][j], A[k]), c))\n                dpB[i+1][j+k] = add(dpB[i+1][j+k], mul(add(mul(dpB[i][j], A[k]), mul(dpA[i][j], B[k])), c))\n\n    ans = 0\n    for i in range(1, m+1):\n        if n + 1 - m >= i:\n            ans = add(ans, mul(dpB[i][m], multiset_choose(n + 1 - m - i, i + 1)))\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.7431014789035544e-05, 0.0, 0.0, -0.00044764988706447184, -0.011588873341679573, -1.1920928244535389e-07, -0.0005560758872888982, -0.10148251801729202, -0.3766971230506897