;\n      for (int i = 0; i < n / 2; i++) {\n        if (s[i] != s[n - 1 - i] && s[i] != mostCommon && s[n - 1 - i] != mostCommon) {\n          minPenalties.add(Math.min(beauty[i], beauty[n - 1 - i]));\n        }\n      }\n      Collections.sort(minPenalties);\n      int toRemove = 2 * charFreq[mostCommon] - equalPairs.size();\n      for (int i = 0; i < toRemove && i < minPenalties.size(); i++) {\n        answer -= minPenalties.get(i);\n      }\n    }\n    \n    pw.println(answer);\n    pw.close();\n    sc.close();\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <climits>\n\nint main() {\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    \n    int n;\n    std::cin >> n;\n    \n    std::string str;\n    std::cin >> str;\n    \n    std::vector<int> beauty(n);\n    int totalBeauty = 0;\n    \n    for (int i = 0; i < n; i++) {\n        std::cin >> beauty[i];\n        totalBeauty += beauty[i];\n    }\n    \n    std::vector<int> equalPairs;\n    std::vector<int> charFreq(128, 0);\n    char mostCommon = 'a';\n    \n    for (int i = 0; i < n / 2; i++) {\n        if (str[i] == str[n - 1 - i]) {\n            equalPairs.push_back(i);\n            charFreq[str[i]]++;\n            if (charFreq[str[i]] > charFreq[mostCommon]) {\n                mostCommon = str[i];\n            }\n        }\n    }\n    \n    int answer = totalBeauty;\n    for (int idx : equalPairs) {\n        answer -= std::min(beauty[idx], beauty[n - 1 - idx]);\n    }\n    \n    if (charFreq[mostCommon] > (int)equalPairs.size() / 2) {\n        std::vector<int> minPenalties;\n        for (int i = 0; i < n / 2; i++) {\n            if (str[i] != str[n - 1 - i] && str[i] != mostCommon && str[n - 1 - i] != mostCommon) {\n                minPenalties.push_back(std::min(beauty[i], beauty[n - 1 - i]));\n 