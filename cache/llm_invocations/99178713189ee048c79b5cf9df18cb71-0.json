 dst[i], dst[rev] = dst[rev], dst[i]\n    if inverse:\n        inv_n = pow(n, P - 2, P)\n        for i in range(n):\n            dst[i] = (dst[i] * inv_n) % P\n    return dst\n\ndef convolute_simply(a, b, P, g):\n    m = max(2, highest_one_bit(max(len(a), len(b)) - 1) << 2)\n    fa = nttmb(a, m, False, P, g)\n    fb = fa if a is b else nttmb(b, m, False, P, g)\n    for i in range(m):\n        fa[i] = (fa[i] * fb[i]) % P\n    return nttmb(fa, m, True, P, g)\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    k = int(next(it))\n    dig = [0] * 11\n    for _ in range(k):\n        d = int(next(it))\n        dig[10 - d] = 1\n    power = N // 2\n    res = [1]\n    while power > 0:\n        if power & 1:\n            res = convolute_simply(res[:], dig[:], MOD, G)\n        dig = convolute_simply(dig[:], dig[:], MOD, G)\n        power >>= 1\n    output = 0\n    for v in res:\n        output = (output + v * v) % MOD\n    print(output)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.821448318485636e-06, 0.0, -1.1920928244535389e-07, -0.00023112009512260556, -0.00034528967808000743, -4.768370445162873e-07, -0.10022782534360886, -0.00011777184408856556, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -8.34461570775602e-06, -0.00016830935783218592, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -0.3146594166755676, -0.008641467429697514, -0.05854007601737976, -7.497983460780233e-05, 0.0, -1.9073468138230965e-06, -0.0031805664766579866, -1.1920928244535389e-07, -0.03723938390612602, 0.0, -0.16031377017498016, -2.3841855067985307e-07, -4.172316494077677e-06, -4.541770613286644e-05, 0.0, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.004088496323674917, -8.344646857949556e-07, 0.0, -1.7404405298293568e-05, 0.0, 0.0, 0.0, -2.9802276912960224e-06, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -2.38418550679853