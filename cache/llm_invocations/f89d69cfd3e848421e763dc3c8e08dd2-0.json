Edge:\n    def __init__(self, to, capacity, cost, rev):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.rev = rev\n\nclass MinCostMaxFlow:\n    def __init__(self, n):\n        self.V = n\n        self.G = [[] for _ in range(n + 5)]\n        self.H = [0] * (n + 5)\n        self.dis = [0] * (n + 5)\n        self.PreV = [0] * (n + 5)\n        self.PreE = [0] * (n + 5)\n    \n    def Init(self, n):\n        self.V = n\n        for i in range(n + 1):\n            self.G[i].clear()\n    \n    def add_edge(self, fr, to, cap, cost):\n        self.G[fr].append(Edge(to, cap, cost, len(self.G[to])))\n        self.G[to].append(Edge(fr, 0, -cost, len(self.G[fr]) - 1))\n    \n    def minCost(self, s, t, f):\n        flow = 0\n        res = 0\n        self.H = [0] * (self.V + 1)\n        while f:\n            INF = 10**18\n            self.dis = [INF] * (self.V + 1)\n            self.dis[s] = 0\n            q = [(0, s)]\n            while q:\n                d, v = heapq.heappop(q)\n                if self.dis[v] < d:\n                    continue\n                for i, e in enumerate(self.G[v]):\n                    if e.capacity > 0 and self.dis[e.to] > self.dis[v] + e.cost + self.H[v] - self.H[e.to]:\n                        self.dis[e.to] = self.dis[v] + e.cost + self.H[v] - self.H[e.to]\n                        self.PreV[e.to] = v\n                        self.PreE[e.to] = i\n                        heapq.heappush(q, (self.dis[e.to], e.to))\n            if self.dis[t] == INF:\n                break\n            for i in range(self.V + 1):\n                self.H[i] += self.dis[i]\n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[self.PreV[v]][self.PreE[v]].capacity)\n                v = self.PreV[v]\n            f -= d\n            flow += d\n            res += d * self.H[t]\n            v = t\n            while v != s:\n                e = self.G[self.PreV[v]][self.PreE[v]]\n  