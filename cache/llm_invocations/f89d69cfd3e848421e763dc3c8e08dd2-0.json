 = q.top(); q.pop();\n\t\t\t\tint v = now.second;\n\t\t\t\tif (dis[v] < now.first)continue;\n\t\t\t\tfor (int i = 0; i < G[v].size(); ++i) {\n   \t\t\t\t\tedge& e = G[v][i];\n\t\t\t\t\tif (e.capacity > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n   \t\t\t\t\t\tdis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n   \t\t\t\t\t\tPreV[e.to] = v;\n   \t\t\t\t\t\tPreE[e.to] = i;\n   \t\t\t\t\t\tq.push(pii(dis[e.to], e.to));\n\t   \t\t\t\t}\n\t   \t\t\t}\n\t   \t\t}\n\t\t\tif (dis[t] == inf)   break;\n\t\t\tfor (int i = 0; i <= V; ++i)H[i] += dis[i];\n\t\t\tint d = f;\n\t\t\tfor (int v = t; v != s; v = PreV[v])d = min(d, G[PreV[v]][PreE[v]].capacity);\n   \t\t\tf -= d; flow += d; res += d*H[t];\n\t\t\tfor (int v = t; v != s; v = PreV[v]) {\n   \t\t\t\tedge& e = G[PreV[v]][PreE[v]];\n   \t\t\t\te.capacity -= d;\n   \t\t\t\tG[v][e.rev].capacity += d;\n\t\t\t}\n   \t\t}\n\t\treturn res;\n   \t}\n} mcmf;\n\nint main (){\n#ifndef ONLINE_JUDGE\n\tfreopen (\"in.in\", \"r\", stdin);\n\tfreopen (\"out.out\", \"w\", stdout);\n#endif\n\t\n\tint n, m, k, c, d;\n\t\n\tcin >> n >> m >> k >> c >> d;\n\t\n\tmcmf.Init(n*(n+55)+2);\n\tfor(int i=0; i<k; i++){\n\t\tint u; cin >> u;\n\t\tmcmf.add_edge(0, u, 1, 0);\n\t}\n\t\n\tvector <pii> edge=vector <pii> (m);\n\tfor(int i=0; i<m; i++) cin >> edge[i].x >> edge[i].y;\n\t\n\tint tar=n*(n+55)+1;\n\tfor(int t=0; t<n+54; t++){\n\t\tfor(pii e : edge){\n\t\t\tfor(int j=1; j<=k; j++){\n\t\t\t\tmcmf.add_edge(e.x+t*n, e.y+(t+1)*n, 1, c+d*(j*2-1));\n\t\t\t\tmcmf.add_edge(e.y+t*n, e.x+(t+1)*n, 1, c+d*(j*2-1));\n\t\t\t}\n\t\t}\n\t\tfor(int i=2; i<=n; i++){\n\t\t\tmcmf.add_edge(i+t*n, i+(t+1)*n, k, c);\n\t\t}\n\t\tmcmf.add_edge(1+t*n, tar, k, 0);\n\t}\n\t\n\tcout << mcmf.minCost(0, tar, k) << endl;\n\t\n\treturn 0;\n}\n\n                  \n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MinCostMaxFlow:\n    def __init__(self, n):\n        self.V = n\n        self.G = [[] for _ in range(n + 1)]  # 0-indexed, but we use up to V inclusive\n        self.H = [0] * (n + 1)\n        self.dis = [0] * (n + 1)\n        self.Prev = [0] * (n + 1)\n        self.PreE = [0] * (n + 1)\n\n    def add_edge(self, fr, to, cap, cost):\n        # forward edge\n        self.G[fr].append([to, cap, cost, len(self.G[to])])\n        # reverse edge\n        self.G[to].append([fr, 0, -cost, len(self.G[fr]) - 1])\n\n    def min_cost(self, s, t, f):\n        flow = 0\n        res = 0\n        INF = 10**18\n        self.H = [0] * (self.V + 1)\n        while f > 0:\n            # Dijkstra with potentials\n            self.dis = [INF] * (self.V + 1)\n            self.dis[s] = 0\n            pq = [(0, s)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if self.dis[v] < d:\n                    continue\n                for i, e in enumerate(self.G[v]):\n                    to, cap, cost, rev = e\n                    if cap > 0 and self.dis[to] > self.dis[v] + cost + self.H[v] - self.H[to]:\n                        self.dis[to] = self.dis[v] + cost + self.H[v] - self.H[to]\n                        self.Prev[to] = v\n                        self.PreE[to] = i\n                        heapq.heappush(pq, (self.dis[to], to))\n            if self.dis[t] == INF:\n                break\n            for i in range(self.V + 1):\n                self.H[i] += self.dis[i]\n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[self.Prev[v]][self.PreE[v]][1])\n                v = self.Prev[v]\n            f -= d\n            flow += d\n            res += d * self.H[t]\n            v = t\n            while v != s:\n                e = self.G[self.Prev[v]][self.PreE[v]]\n                e[1] -= d\n                rev = e[3]\n                self.G[v][rev][1] += d\n                v = self.Prev[v]\n        return res\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    V = n * (n + 55) + 2\n    mcmf = MinCostMaxFlow(V)\n    # source = 0, sink = V-1? Actually tar = n*(n+55)+1\n    tar = n * (n + 55) + 1\n\n    # initial positions\n    for _ in range(k):\n        u = int(next(it))\n        mcmf.add_edge(0, u, 1, 0)\n\n    edges = []\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        edges.append((u, v))\n\n    # time steps\n    for t in range(n + 54):\n        for u, v in edges:\n            for j in range(1, k + 1):\n                cost = c + d * (2 * j - 1)\n                mcmf.add_edge(u + t * n, v + (t + 1) * n, 1, cost)\n                mcmf.add_edge(v + t * n, u + (t + 1) * n, 1, cost)\n        for i in range(2, n + 1):\n            mcmf.add_edge(i + t * n, i + (t + 1) * n, k, c)\n        mcmf.add_edge(1 + t * n, tar, k, 0)\n\n    ans = mcmf.min_cost(0, tar, k)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0005581013392657042, 0.0, 0.0, -0.00047386385267600417, -0.0019658540841192007, -0.00020346954988781363, -0.00153840403072536, -0.00020418466010596603, -4.887569048150908e-06, -0.023311134427785873, -0.12929685413837433, -0.008671131916344166, -5.960462772236497e-07, -3.576278118089249e-07, 0.0, -1.1920922133867862e-06, -1.6689286894688848e-06, -0.0008102948195300996, -4.768370445162873e-07, 0.0, -4.768370445162873e-07, 0.0, -0.0110483318567276, -0.08689054101705551, -3.85038583772257e-05, 0.0, -0.00010072677832795307, -0.0012634160229936242, 0.0, -5.960462772236497e-07, -0.0002787916746456176, 0.0, -0.00015853578224778175, -0.0015182883944362402, 0.0, -1.9073468138230965e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.0009133219718933105, -0.030360164120793343, -1.1920928244535389e-07, -0.0