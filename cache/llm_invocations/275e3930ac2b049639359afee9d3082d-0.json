n():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    n = N * 101 + 2\n    g = [[] for _ in range(n)]\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        add_rib(g, n - 2, x * 101, 1, 0)\n    \n    for i in range(101):\n        add_rib(g, i, n - 1, INF, i * c)\n    \n    for i in range(1, N):\n        for j in range(100):\n            add_rib(g, i * 101 + j, i * 101 + j + 1, INF, 0)\n    \n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(100):\n            for K in range(1, k + 1):\n                cost = d * K * K - d * (K - 1) * (K - 1)\n                add_rib(g, u * 101 + j, v * 101 + j + 1, 1, cost)\n                add_rib(g, v * 101 + j, u * 101 + j + 1, 1, cost)\n    \n    s = n - 2\n    t = n - 1\n    flow = 0\n    cost = 0\n    \n    while flow < k:\n        id_ = [0] * n\n        dist = [INF] * n\n        q = deque()\n        p = [-1] * n\n        p_rib = [0] * n\n        \n        q.append(s)\n        dist[s] = 0\n        \n        while q:\n            v = q.popleft()\n            id_[v] = 2\n            for i, r in enumerate(g[v]):\n                if r.f < r.u and dist[v] + r.c < dist[r.b]:\n                    dist[r.b] = dist[v] + r.c\n                    if id_[r.b] == 0:\n                        q.append(r.b)\n                    elif id_[r.b] == 2:\n                        q.appendleft(r.b)\n                    id_[r.b] = 1\n                    p[r.b] = v\n                    p_rib[r.b] = i\n        \n        if dist[t] == INF:\n            break\n        \n        addflow = k - flow\n        v = t\n        while v != s:\n            pv = p[v]\n            pr = p_rib[v]\n            addflow = min(addflow, g[pv][pr].u - g[pv][pr].f)\n            v = pv\n        \n        v = t\n        while v != s:\n            pv = p[v]\n            pr = p_rib[v]\n            r = g[pv][pr].back\n            g[pv][pr].f += addflow\n            g[v][r].f -= addflow\n            cost += g[pv][pr].c * addflow\n            v = pv\n        \n        flow += addflow\n    \n    assert flow == k\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010549465514486656, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.0011380392825230956, -0.0005628670332953334, -0.20141683518886566, -0.01824875921010971, -0.0005635818815790117, -7.152555099310121e-07, -0.00038532938924618065, -0.00036483307485468686, -0.09194783866405487, -5.960462772236497e-07, -2.47952248173533e-05, 0.0, -1.1920928244535389e-07, -3.6954811548639555e-06, -1.1920928244535389e-07, -0.029959838837385178, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -9.536738616588991e-07, -2.50339189733495e-06, 0.0, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -0.00023314618738368154, -0.00017736769223120064, -0.013691795989871025, -3.6954811548639555e-06, -1.6689286894688848e-06, -0.47407907247543335, -4.207999518257566e-05, -1.5497195136049413e-06, -4.768370445162873e-07, -0.1128351241350174, 0.0, -4.768360213347478e-06, -7.986990567587782e-06, -1.0728830375228426e-06, -3.576278118089249e-07, -5.960462772236497e-07, -5.960462772236497e-07, -1.6689286894688848e-06, -5.960462772236497e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920922133867862e-06, -1.5258672647178173e-05, -0.1002069041132927, -5.960462772236497e-07, -5.364403477869928e-06, -5.960462772236497e-07, -3.576278118089249e-07, -1.6689286894688848e-06, -2.7894584491150454e-05, -1.1920928244535389e-07, -0.00010084597306558862, -3.576278118089249e-07, -5.960462772236497e-07, -2.0265558760002023e-06, -4.291525328881107e-06, -5.960462772236497e-07, -3.814689989667386e-06, -4.291525328881107e-06, -2.264974000354414e-06, -1.239768