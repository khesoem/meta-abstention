adInt();\n    d = readInt();\n\n    for (int i = 1; i <= k; ++i) ++people[readInt()];\n\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= k + m + 2; ++j) {\n            id[i][j] = ++nodeCnt;\n            if (i == 1) addEdge(id[i][j], sink, c * (j - 1), INF);\n            if (j > 1) addEdge(id[i][j - 1], id[i][j], 0, INF);\n        }\n        if (people[i]) addEdge(src, id[i][1], 0, people[i]);\n    }\n\n    for (int i = 1; i <= m; ++i) {\n        int a = readInt(), b = readInt();\n        for (int j = 1; j <= k + m + 1; ++j) {\n            for (int cost = 1; cost <= 2 * k - 1; cost += 2) {\n                addEdge(id[a][j], id[b][j + 1], cost * d, 1);\n                addEdge(id[b][j], id[a][j + 1], cost * d, 1);\n            }\n        }\n    }\n\n    auto spfa = [&]() -> bool {\n        for (int i = 1; i <= nodeCnt; ++i) {\n            used[i] = false;\n            dist[i] = INF;\n        }\n        queue<int> q;\n        dist[src] = 0;\n        q.push(src);\n        used[src] = true;\n        while (!q.empty()) {\n            int x = q.front();\n            q.pop();\n            used[x] = false;\n            for (int e = head[x]; e; e = edges[e].nxt) {\n                if (!edges[e].cap) continue;\n                int y = edges[e].to;\n                if (dist[y] > dist[x] + edges[e].cost) {\n                    dist[y] = dist[x] + edges[e].cost;\n                    if (!used[y]) {\n                        used[y] = true;\n                        q.push(y);\n                    }\n                }\n            }\n        }\n        return dist[sink] < INF;\n    };\n\n    function<int(int,int)> augment;\n    augment = [&](int x, int flow) -> int {\n        if (x == src) return flow;\n        used[x] = true;\n        int rem = flow;\n        for (int e = head[x]; e; e = edges[e].nxt) {\n            int y = edges[e].to;\n            if (used[y] || !edges[e ^ 1].cap || dist[x] < dist[y] + edges[e ^ 1].cost) continue;\n            int got = augment(y