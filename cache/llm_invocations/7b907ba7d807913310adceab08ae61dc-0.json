   edge e = G[u][i];\n          if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n            q.emplace(-D[e.v], e.v);\n            PV[e.v] = u;\n            PE[e.v] = i;\n          }\n        }\n      }\n      if (D[t] == INF) return -1;\n      for (int i = 0; i < N; i++) H[i] += D[i];\n      long long d = f;\n      for (int i = t; i != s; i = PV[i]) {\n        d = min(d, G[PV[i]][PE[i]].c);\n      }\n      f -= d;\n      res += d * H[t];\n      for (int i = t; i != s; i = PV[i]) {\n        edge &e = G[PV[i]][PE[i]];\n        e.c -= d;\n        G[i][e.r].c += d;\n      }\n    }\n    return res;\n  }\n};\n\nint main() {\n  cin.tie(nullptr);\n  ios::sync_with_stdio(false);\n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  rep(i, K) cin >> A[i], A[i]--;\n  vector<int> us(M), vs(M);\n  rep(i, M) {\n    cin >> us[i] >> vs[i];\n    us[i]--;\n    vs[i]--;\n  }\n  mincostflow mcf(N*101+2);\n  int s = N*101;\n  int t = s + 1;\n  for (int i = 0; i < K; i++) {\n    mcf.add(s, A[i], 1, 0);\n  }\n  for (int i = 0; i <= 100; i++) {\n    mcf.add(N * i, t, K, C*i);\n  }\n  // Combine loops: for each time step, add stay edges and movement edges\n  for (int i = 0; i < 100; i++) {\n    for (int j = 0; j < N; j++) {\n      mcf.add(i*N+j, (i+1)*N+j, K, 0);\n    }\n    for (int j = 0; j < M; j++) {\n      ll cost_base = D;\n      for (int k = 1; k <= K; k++) {\n        ll cost = (2*k - 1) * cost_base;\n        mcf.add(N*i + us[j], N*(i+1) + vs[j], 1, cost);\n        mcf.add(N*i + vs[j], N*(i+1) + us[j], 1, cost);\n      }\n    }\n  }\n  cout << mcf.run(s, t, K) << '\\n';\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class MinCostFlow {\n\n    static class Edge {\n        int to;\n        long cap;\n        long cost;\n        int rev;\n\n        Edge(int to, long cap, long cost, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static class MinCostFlow {\n        final long INF = Long.MAX_VALUE / 2;\n        ArrayList<ArrayList<Edge>> G;\n        int n;\n\n        MinCostFlow(int n) {\n            this.n = n;\n            G = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                G.add(new ArrayList<>());\n            }\n        }\n\n        void add(int from, int to, long cap, long cost) {\n            int revFrom = G.get(to).size();\n            int revTo = G.get(from).size();\n            G.get(from).add(new Edge(to, cap, cost, revFrom));\n            G.get(to).add(new Edge(from, 0, -cost, revTo));\n        }\n\n        long run(int s, int t, long f) {\n            long res = 0;\n            long[] H = new long[n];\n            long[] D = new long[n];\n            int[] prevV = new int[n];\n            int[] prevE = new int[n];\n\n            while (f > 0) {\n                Arrays.fill(D, INF);\n                D[s] = 0;\n                PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n                pq.offer(new long[]{0, s});\n\n                while (!pq.isEmpty()) {\n                    long[] p = pq.poll();\n                    long d = p[0];\n                    int v = (int) p[1];\n                    if (D[v] < d) continue;\n\n                    for (int i = 0; i < G.get(v).size(); i++) {\n                        Edge e = G.get(v).get(i);\n                        if (e.cap > 0) {\n                            long nd = D[v] + e.cost + H[v] - H[e.to];\n                            if (D[e.to] > nd) {\n                                D[e.to] = nd;\n                                prevV[e.to] = v;\n                                prevE[e.to] = i;\n                                pq.offer(new long[]{nd, e.to});\n                            }\n                        }\n                    }\n                }\n\n                if (D[t] == INF) return -1;\n\n                for (int i = 0; i < n; i++) {\n                    H[i] += D[i];\n                }\n\n                long d = f;\n                for (int v = t; v != s; v = prevV[v]) {\n                    d = Math.min(d, G.get(prevV[v]).get(prevE[v]).cap);\n                }\n\n                f -= d;\n                res += d * H[t];\n\n                for (int v = t; v != s; v = prevV[v]) {\n                    Edge e = G.get(prevV[v]).get(prevE[v]);\n                    e.cap -= d;\n                    G.get(v).get(e.rev).cap += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = sc.nextInt();\n        int K = sc.nextInt();\n        long C = sc.nextLong();\n        long D = sc.nextLong();\n\n        int[] A = new int[K];\n        for (int i = 0; i < K; i++) {\n            A[i] = sc.nextInt() - 1;\n        }\n\n        int[] us = new int[M];\n        int[] vs = new int[M];\n        for (int i = 0; i < M; i++) {\n            us[i] = sc.nextInt() - 1;\n            vs[i] = sc.nextInt() - 1;\n        }\n\n        int V = N * 101 + 2;\n        MinCostFlow mcf = new MinCostFlow(V);\n        int s = N * 101;\n        int t = s + 1;\n\n        for (int i = 0; i < K; i++) {\n            mcf.add(s, A[i], 1, 0);\n        }\n\n        for (int i = 0; i <= 100; i++) {\n            mcf.add(N * i, t, K, C * i);\n        }\n\n        for (int i = 0; i < 100; i++) {\n            for (int j = 0; j < N; j++) {\n                mcf.add(i * N + j, (i + 1) * N + j, K, 0);\n            }\n            for (int j = 0; j < M; j++) {\n                for (int k = 1; k <= K; k++) {\n                    long cost = (2L * k - 1) * D;\n                    mcf.add(N * i + us[j], N * (i + 1) + vs[j], 1, cost);