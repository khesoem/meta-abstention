\n                if (i == j) C[i][j] = A[i][j];\n                else C[i][(j + shift_amount) % K] = A[i][j];\n    return C;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> K;\n    \n    while (N > 0) {\n        digits.emplace_back(N % K);\n        N /= K;\n    }\n    \n    for (int i = 0; i < K; ++i) {\n        M_base[0][i].resize(K + 1, vl(K + 1, 0));\n        for (int j = 0; j <= K; ++j) {\n            M_base[0][i][j][j] = 1;\n            M_base[0][i][j][i] = 1;\n        }\n    }\n    \n    for (int lvl = 1; lvl < (int)digits.size(); ++lvl) {\n        M_prefix[lvl - 1][0] = M_base[lvl - 1][0];\n        for (int j = 1; j < K; ++j) {\n            M_prefix[lvl - 1][j] = multiply(M_prefix[lvl - 1][j - 1], M_base[lvl - 1][j]);\n        }\n        \n        M_suffix[lvl - 1][K - 1] = M_base[lvl - 1][K - 1];\n        for (int j = K - 2; j >= 0; --j) {\n            M_suffix[lvl - 1][j] = multiply(M_base[lvl - 1][j], M_suffix[lvl - 1][j + 1]);\n        }\n        \n        M_base[lvl][0] = M_prefix[lvl - 1][K - 1];\n        for (int j = 1; j < K; ++j) {\n            M_base[lvl][j] = multiply(M_suffix[lvl - 1][j], M_prefix[lvl - 1][j - 1]);\n        }\n    }\n    \n    M_trans.resize(K + 1, vl(K + 1, 0));\n    for (int i = 0; i <= K; ++i) M_trans[i][i] = 1;\n    \n    int accumulator = 0;\n    for (int pos = (int)digits.size() - 1; pos >= 0; --pos) {\n        int d = digits[pos];\n        for (int step = 0; step < d; ++step) {\n            M_trans = multiply(M_trans, M_base[pos][accumulator]);\n            accumulator++; if (accumulator >= K) accumulator -= K;\n        }\n    }\n    \n    result = 1;\n    for (int i = 0; i < K; ++i) {\n        result = (result + M_trans[K][i]) % MOD;\n    }\n    \n    cout << result << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD 