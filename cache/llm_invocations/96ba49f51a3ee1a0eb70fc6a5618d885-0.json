eturn ans\n\ndef main():\n    global n, limitT, A, B, id, cnt, S, T, zx, zy, G, level, ptr, dx, dy\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    limitT = int(next(it))\n    A = [list(next(it).strip()) for _ in range(n)]\n    B = [list(next(it).strip()) for _ in range(n)]\n\n    id = [[-1] * n for _ in range(n)]\n    cnt = 0\n    zx = zy = -1\n\n    for i in range(n):\n        for j in range(n):\n            if A[i][j] == 'Z':\n                zx, zy = i, j\n            elif inside(i, j):\n                cnt += 1\n                id[i][j] = cnt\n\n    S = 0\n    T = 2 * cnt + 1\n    G = [[] for _ in range(T + 1)]\n    level = [0] * (T + 1)\n    ptr = [0] * (T + 1)\n\n    dx = [0, 0, 1, -1]\n    dy = [1, -1, 0, 0]\n\n    for i in range(n):\n        for j in range(n):\n            if inside(i, j):\n                buildNetwork(i, j)\n\n    print(maxFlow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.106198947643861e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.001534238108433783, -0.0008784249657765031, 0.0, -1.5020257706055418e-05, -1.4066597032069694e-05, -1.1920928244535389e-07, 0.0, -1.9073468138230965e-06, -0.00046623803791590035, -0.0832635760307312, -2.6225699912174605e-05, -2.9802276912960224e-06, -4.768370445162873e-07, -0.016066374257206917, -0.0004732680681627244, -0.1579582542181015, -0.729570209980011, -0.10175109654664993, -9.894321920000948e-06, -0.00010966652916977182, 0.0, -0.5759605765342712, -9.536738616588991e-07, -0.003218353958800435, -0.023944489657878876, 0.0, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, -3.5523738915799186e-05, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -0.5759751200675964, -4.768370445162873e-07, 0.0, -1.1920928244535389e-