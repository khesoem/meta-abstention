{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class CFA4 {\n    \n    public static void main(String[] args) throws IOException {\n        new CFA4().run();\n    }\n    \n    void run() throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter out = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        \n        if (n > m) { int t = n; n = m; m = t; }\n\n        if (n == 1) {\n            m--;\n            int[] left = {0,0,0,2,4,6};\n            out.println(m / 6 * 6L + left[m % 6]);\n        } else if (n == 2) {\n            out.println(m < 20 ? bruteForce(n, m) : (long)n * m);\n        } else if (n == 3) {\n            if (m < 20) out.println(bruteForce(n, m));\n            else {\n                long res = (long)n * m;\n                if (res % 2 != 0) res--;\n                out.println(res);\n            }\n        } else {\n            long res = (long)n * m;\n            if (res < 1000) out.println(bruteForce(n, m));\n            else {\n                if (res % 2 != 0) res--;\n                out.println(res);\n            }\n        }\n        out.close();\n    }\n\n    int bruteForce(int n, int m) {\n        List<int[]> even = new ArrayList<>();\n        List<int[]> odd = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                if ((i + j) % 2 == 0) even.add(new int[]{i, j});\n                else odd.add(new int[]{i, j});\n            }\n        }\n        int es = even.size(), os = odd.size();\n        boolean[][] graph = new boolean[es][os];\n        for (int i = 0; i < es; i++) {\n            for (int j = 0; j < os; j++) {\n                if (calcDist(even.get(i), odd.get(j)) == 3) graph[i][j] = true;\n            }\n        }\n        return 2 * maxMatching(graph);\n    }\n\n    int calcDist(int[] a, int[] b) {\n        return Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]);\n    }\n\n    int maxMatching(boolean[][] g) {\n        int n1 = g.length, n2 = n1 == 0 ? 0 : g[0].length;\n        int[] matchR = new int[n2];\n        Arrays.fill(matchR, -1);\n        int result = 0;\n        for (int u = 0; u < n1; u++) {\n            if (dfs(g, u, new boolean[n1], matchR)) result++;\n        }\n        return result;\n    }\n\n    boolean dfs(boolean[][] g, int u, boolean[] vis, int[] matchR) {\n        for (int v = 0; v < matchR.length; v++) {\n            if (g[u][v] && !vis[v]) {\n                vis[v] = true;\n                if (matchR[v] == -1 || dfs(g, matchR[v], vis, matchR)) {\n                    matchR[v] = u;\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve():\n    data = sys.stdin.readline().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n    \n    if n > m:\n        n, m = m, n\n    \n    if n == 1:\n        m -= 1\n        left = [0, 0, 0, 2, 4, 6]\n        ans = (m // 6) * 6 + left[m % 6]\n        print(ans)\n    elif n == 2:\n        if m < 20:\n            print(brute_force(n, m))\n        else:\n            print(n * m)\n    elif n == 3:\n        if m < 20:\n            print(brute_force(n, m))\n        else:\n            res = n * m\n            if res % 2 != 0:\n                res -= 1\n            print(res)\n    else:\n        res = n * m\n        if res < 1000:\n            print(brute_force(n, m))\n        else:\n            if res % 2 != 0:\n                res -= 1\n            print(res)\n\ndef brute_force(n, m):\n    even = []\n    odd = []\n    for i in range(n):\n        for j in range(m):\n            if (i + j) % 2 == 0:\n                even.append((i, j))\n            else:\n                odd.append((i, j))\n    es = len(even)\n    os = len(odd)\n    graph = [[False] * os for _ in range(es)]\n    for i in range(es):\n        for j in range(os):\n            if calc_dist(even[i], odd[j]) == 3:\n                graph[i][j] = True\n    return 2 * max_matching(graph)\n\ndef calc_dist(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\ndef max_matching(g):\n    n1 = len(g)\n    n2 = len(g[0]) if n1 > 0 else 0\n    match_r = [-1] * n2\n    result = 0\n    for u in range(n1):\n        vis = [False] * n1  # size n1 (left side) but used for right side indices; safe because n1 >= n2\n        if dfs(g, u, vis, match_r):\n            result += 1\n    return result\n\ndef dfs(g, u, vis, match_r):\n    for v in range(len(match_r)):\n        if g[u][v] and not vis[v]:\n            vis[v] = True\n            if match_r[v] == -1 or dfs(g, match_r[v], vis, match_r):\n                match_r[v] = u\n                return True\n    return False\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code