{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nconst int MOD = 1000000007;\n\nstruct BitSet {\n    unsigned long long lo, hi;\n    void set(int x) {\n        if (x < 64) lo |= 1ULL << x;\n        else hi |= 1ULL << (x - 64);\n    }\n    void reset() { lo = hi = 0; }\n    BitSet& operator|=(const BitSet& o) { lo |= o.lo; hi |= o.hi; return *this; }\n    bool operator==(const BitSet& o) const { return lo == o.lo && hi == o.hi; }\n    bool operator[](int x) const {\n        return x < 64 ? (lo >> x) & 1 : (hi >> (x - 64)) & 1;\n    }\n    bool operator<(const BitSet& o) const {\n        return hi < o.hi || (hi == o.hi && lo < o.lo);\n    }\n};\n\nll fpm(ll a, ll b) {\n    ll c = 1;\n    for (; b; b >>= 1, a = a * a % MOD)\n        if (b & 1) c = c * a % MOD;\n    return c;\n}\n\nint n;\nll a[11][11];\nll f[11][131];\nint is[131];\nll i100;\nmap<BitSet, ll> st[8];\nBitSet mx, stt;\n\nll dfs(int x, BitSet w) {\n    if (x == n) return w == mx ? 1 : 0;\n    auto it = st[x].find(w);\n    if (it != st[x].end()) return it->second;\n    ll ans = 0;\n    BitSet s[11];\n    for (int j = 0; j < n; ++j) s[j].reset();\n    for (int i = 0; i < (1 << n); ++i) if (w[i])\n        for (int j = 0; j < n; ++j) if (!(i & (1 << j)))\n            s[j].set(i | (1 << j));\n    for (int i = 0; i < (1 << n); ++i) {\n        BitSet ng = w;\n        for (int j = 0; j < n; ++j) if (i & (1 << j)) ng |= s[j];\n        ans = (ans + f[x][i] * dfs(x + 1, ng)) % MOD;\n    }\n    return st[x][w] = ans;\n}\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(0);\n    cin >> n;\n    for (int i = 0; i < (1 << n); ++i) mx.set(i);\n    stt.set(0);\n    i100 = fpm(100, MOD - 2);\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            a[i][j] = a[i][j] * i100 % MOD;\n        }\n    for (int i = 0; i < n; ++i) is[1 << i] = i;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < (1 << n); ++j) {\n            f[i][j] = 1;\n            for (int k = 0; k < n; ++k)\n                if (j & (1 << k))\n                    f[i][j] = f[i][j] * a[k][i] % MOD;\n                else\n                    f[i][j] = f[i][j] * (MOD + 1 - a[k][i]) % MOD;\n        }\n    cout << dfs(0, stt) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass BitSet:\n    def __init__(self, val=0):\n        self.val = val  # integer representing bits, bits 0..127\n\n    def set(self, x):\n        self.val |= 1 << x\n\n    def reset(self):\n        self.val = 0\n\n    def __ior__(self, other):\n        self.val |= other.val\n        return self\n\n    def __eq__(self, other):\n        return self.val == other.val\n\n    def __getitem__(self, x):\n        return (self.val >> x) & 1\n\n    def __hash__(self):\n        return hash(self.val)\n\n    def __repr__(self):\n        return bin(self.val)\n\ndef fpm(a, b):\n    c = 1\n    while b:\n        if b & 1:\n            c = c * a % MOD\n        a = a * a % MOD\n        b >>= 1\n    return c\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    n = data[0]\n    idx = 1\n    a = [[0]*n for _ in range(n)]\n    i100 = fpm(100, MOD-2)\n    for i in range(n):\n        for j in range(n):\n            a[i][j] = data[idx] * i100 % MOD\n            idx += 1\n\n    # f[i][mask] = product over k of (a[k][i] if bit k set else (1-a[k][i]))\n    f = [[1]*(1<<n) for _ in range(n)]\n    for i in range(n):\n        for mask in range(1<<n):\n            prod = 1\n            for k in range(n):\n                if mask & (1<<k):\n                    prod = prod * a[k][i] % MOD\n                else:\n                    prod = prod * (MOD + 1 - a[k][i]) % MOD\n            f[i][mask] = prod\n\n    mx = BitSet()\n    for i in range(1<<n):\n        mx.set(i)\n    stt = BitSet()\n    stt.set(0)\n\n    st = [{} for _ in range(n+1)]  # st[x] maps BitSet to count\n\n    def dfs(x, w):\n        if x == n:\n            return 1 if w == mx else 0\n        key = w.val  # use integer as key for dict\n        if key in st[x]:\n            return st[x][key]\n        ans = 0\n        s = [BitSet() for _ in range(n)]\n        for j in range(n):\n            s[j].reset()\n        for i in range(1<<n):\n            if w[i]:\n                for j in range(n):\n                    if not (i & (1<<j)):\n                        s[j].set(i | (1<<j))\n        for i in range(1<<n):\n            ng = BitSet(w.val)\n            for j in range(n):\n                if i & (1<<j):\n                    ng |= s[j]\n            ans = (ans + f[x][i] * dfs(x+1, ng)) % MOD\n        st[x][key] = ans\n        return ans\n\n    result = dfs(0, stt)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.05947203189134598, -0.000713213172275573, -2.3841855067985307e-07, -1.1920928244535389e-0