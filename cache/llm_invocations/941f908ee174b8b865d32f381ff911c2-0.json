\n}\n\nMtx Base[65];\n\nMtx gen(int i, int K) {\n    return qpow(Base[i + K], K - i) * qpow(Base[i], i);\n}\n\nlint proc(lint N, lint K) {\n    if (N == 0) return 1;\n    vector<lint> base_repr;\n    lint x = N;\n    while (x) {\n        base_repr.push_back(x % K);\n        x /= K;\n    }\n    reverse(base_repr.begin(), base_repr.end());\n    int L = base_repr.size();\n    vector<Mtx> T(L + 5), P(L + 5);\n    T[0] = Base[K - 1];\n    P[0] = qpow(T[0], K - 1);\n    if (L > 1) {\n        T[1] = gen(K - 1, K);\n        P[1] = qpow(T[1], K - 1);\n    }\n    Mtx suf = Mtx::I(2 * K + 1);\n    for (int j = 2; j <= L; ++j) {\n        int idx = K - (j % K);\n        if (idx == K) idx = 0;\n        T[j] = gen(idx, K);\n        suf = suf * P[j - 1];\n        T[j] = T[j] * suf;\n        P[j] = qpow(T[j], K - 1);\n    }\n    lint rem = N % K;\n    N -= rem;\n    lint sh = 0;\n    x = N;\n    if (x > 0) {\n        while (x % K == 0) {\n            ++sh;\n            x /= K;\n        }\n    }\n    sh = (K - sh % K) % K;\n    Mtx ans = Mtx::I(2 * K + 1);\n    ans = qpow(Base[sh], rem) * qpow(Base[sh + K], max(rem - sh, (lint)0));\n    N /= K;\n    if (!N) {\n        return (ans(2 * K, 0) + ans(0, 0)) % MOD;\n    }\n    --N;\n    vector<lint> digits;\n    while (N) {\n        digits.push_back(N % K);\n        N /= K;\n    }\n    int p = 1;\n    for (lint d : digits) {\n        if (d > 0) ans = ans * qpow(T[p], d);\n        ++p;\n    }\n    ans = ans * T[1];\n    return (ans(2 * K, 0) + ans(0, 0)) % MOD;\n}\n\nint main() {\n    lint N, K;\n    cin >> N >> K;\n    for (lint i = 0; i < 2 * K + 1; ++i) {\n        Base[i] = Mtx(2 * K + 1, 2 * K + 1);\n        for (lint j = 0; j < i; ++j) Base[i](0, j) = 1;\n        for (lint j = 0; j < 2 * K - 1; ++j) Base[i](j + 1, j) = 1;\n        Base[i](2 * K, 0) = 1;\n        Base[i](2 * K, 2 * K) = 1;\n    }\n    cout << proc(N, K) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass Mtx:\n    def __init__(self, n=0, rr=None, cc=None):\n        if rr is not None and cc is not None:\n            self.r = rr\n            self.c = cc\n        else:\n            self.r = n\n            self.c = n\n        self.v = [[0] * self.c for _ in range(self.r)]\n    \n    def __call__(self, i, j):\n        return self.v[i][j]\n    \n    def __setitem__(self, idx, value):\n        i, j = idx\n        self.v[i][j] = value\n    \n    def __mul__(self, o):\n        res = Mtx(rr=self.r, cc=o.c)\n        for i in range(self.r):\n            for k in range(self.c):\n                if self.v[i][k]:\n                    for j in range(o.c):\n                        res.v[i][j] = (res.v[i][j] + self.v[i][k] * o.v[k][j]) % MOD\n        return res\n    \n    @staticmethod\n    def I(n):\n        res = Mtx(n)\n        for i in range(n):\n            res.v[i][i] = 1\n        return res\n\ndef qpow(base, e):\n    res = Mtx.I(base.r)\n    while e:\n        if e & 1:\n            res = res * base\n        base = base * base\n        e >>= 1\n    return res\n\nBase = [None] * 65\n\ndef gen(i, K):\n    return qpow(Base[i + K], K - i) * qpow(Base[i], i)\n\ndef proc(N, K):\n    if N == 0:\n        return 1\n    base_repr = []\n    x = N\n    while x:\n        base_repr.append(x % K)\n        x //= K\n    base_repr.reverse()\n    L = len(base_repr)\n    T = [None] * (L + 5)\n    P = [None] * (L + 5)\n    T[0] = Base[K - 1]\n    P[0] = qpow(T[0], K - 1)\n    if L > 1:\n        T[1] = gen(K - 1, K)\n        P[1] = qpow(T[1], K - 1)\n    suf = Mtx.I(2 * K + 1)\n    for j in range(2, L + 1):\n        idx = K - (j % K)\n        if idx == K:\n            idx = 0\n        T[j] = gen(idx, K)\n        suf = suf * P[j - 1]\n        T[j] = T[j] * suf\n        P[j] = qpow(T[j], K - 1)\n    rem = N % K\n    N -= rem\n    sh = 0\n    x = N\n    if x > 0:\n        while x % K == 0:\n            sh += 1\n            x //= K\n    sh = (K - sh % K) % K\n    ans = Mtx.I(2 * K + 1)\n    ans = qpow(Base[sh], rem) * qpow(Base[sh + K], max(rem - sh, 0))\n    N //= K\n    if not N:\n        return (ans.v[2 * K][0] + ans.v[0][0]) % MOD\n    N -= 1\n    digits = []\n    while N:\n        digits.append(N % K)\n        N //= K\n    p = 1\n    for d in digits:\n        if d > 0:\n            ans = ans * qpow(T[p], d)\n        p += 1\n    ans = ans * T[1]\n    return (ans.v[2 * K][0] + ans.v[0][0]) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n    for i in range(2 * K + 1):\n        Base[i] = Mtx(2 * K + 1, 2 * K + 1)\n        for j in range(i):\n            Base[i].v[0][j] = 1\n        for j in range(2 * K - 1):\n            Base[i].v[j + 1][j] = 1\n        Base[i].v[2 * K][0] = 1\n        Base[i].v[2 * K][2 * K] = 1\n    print(proc(N, K))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016723664884921163, -7.152555099310121e-07, -1.1920928244535389e-07, -0.025575976818799973, -0.0015574480639770627, -0.048723701387643814, -0.0009579836623743176, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -0.01253711897879839, 0.0, -3.40932747349143e-05, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -4.3748852476710454e-05, -2.109982233378105e-05, -0.0011731653939932585, -0.008621258661150932, -1.311301275563892e-06, -2.264974000354414e-06, -1.1920928244535389e-07, -9.536738616588991e-07, -1.7881377516459906e-06, -3.2186455882765586e-06, -1.1920928244535389e-07, -1.6689286894688848e-06, -5.960462772236497e-07, -0.056002434343099594, -0.008676094934344292, -3.576278118089249e-07, -0.0003829461056739092, -0.4831412434577942, -0.12697719037532806, -8.344646857949556e-07, -3.814689989667386e-06, -3.099436753473128e-06, -0.00029774048016406596, -4.6491513785440475e-06, -5.9604627722364