er-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        String[] data = scanner.nextLine().split(\" \");\n        int n = Integer.parseInt(data[0]);\n        int h = Integer.parseInt(data[1]);\n        \n        // Create memoization table\n        long[][] memo = new long[36][36];\n        memo[0][0] = 1;\n        \n        // Compute number of binary trees with n nodes and minimum height h\n        for (int total_nodes = 1; total_nodes < 36; total_nodes++) {\n            for (int target_height = 0; target_height <= total_nodes; target_height++) {\n                long ways = 0;\n                for (int root_val = 1; root_val <= total_nodes; root_val++) {\n                    int left_nodes = root_val - 1;\n                    int right_nodes = total_nodes - root_val;\n                    long left_all = memo[left_nodes][0];\n                    long right_all = memo[right_nodes][0];\n                    long left_low = memo[left_nodes][Math.max(target_height - 1, 0)];\n                    long right_low = memo[right_nodes][Math.max(target_height - 1, 0)];\n                    ways += left_all * right_all - (left_all - left_low) * (right_all - right_low);\n                }\n                memo[total_nodes][target_height] = ways;\n            }\n        }\n        \n        System.out.println(memo[n][h]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.794698856538162e-05, -1.311301275563892e-06, -4.768370445162873e-07, -4.386805812828243e-05, -4.184158387943171e-05, -0.0011712603736668825, -0.28289562463760376, -8.702239938429557e-06, -2.3841855067985307e-07, -4.017272294731811e-05, -0.01603516936302185, -0.00014149141497910023, -7.271740287251305e-06, -4.768370445162873e-07, -1.7881377516459906e-06, -2.3841855067985307e-07, -1.0967194612021558e-05, -7.15255509931