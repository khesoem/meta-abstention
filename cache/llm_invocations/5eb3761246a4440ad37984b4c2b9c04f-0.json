int cnt = 0;\n            int hb = (1 << (31 - __builtin_clz(i)));\n\n            for (int j = i - hb; j >= 0; j = (j - 1) & i) {\n                int jj = j + hb;\n                total += dp[k][i ^ jj] * invfact[jj];\n                if (cnt++ == 17) {\n                    total %= mod_value;\n                    cnt = 0;\n                }\n                if (j == 0) break;\n            }\n\n            dp[k + 1][i] = total % mod_value;\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= K; ++i)\n        (ans += 1LL * fact[n] * dp[i][n] % mod_value * P(K, i) % mod_value) %= mod_value;\n\n    printf(\"%d\\n\", (fast_pow(K, n) + mod_value - ans) % mod_value);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef fast_pow(x, n, mod):\n    return pow(x, n, mod)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    K = int(data[1])\n    mod_value = int(data[2])\n\n    if n & 1:\n        print(fast_pow(K, n, mod_value))\n        return\n\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % mod_value\n\n    invfact = [1] * (n + 1)\n    invfact[n] = fast_pow(fact[n], mod_value - 2, mod_value)\n    for i in range(n - 1, -1, -1):\n        invfact[i] = invfact[i+1] * (i + 1) % mod_value\n\n    # dp[k][i] for k = 0..K, i = 0..n\n    dp = [[0] * (n + 1) for _ in range(K + 1)]\n    dp[0][0] = 1\n\n    for k in range(K):\n        for i in range(1, n + 1):\n            if (i & n) != i:\n                continue\n            # highest bit of i\n            hb = 1 << (i.bit_length() - 1)\n            total = 0\n            cnt = 0\n            j = i - hb\n            while True:\n                jj = j + hb\n                total += dp[k][i ^ jj] * invfact[jj]\n                cnt += 1\n                if cnt == 18:  # every