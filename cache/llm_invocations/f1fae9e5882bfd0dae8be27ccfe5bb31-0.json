{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int maxn = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, cnt, ans, a[maxn], x[maxn], y[maxn];\nint head[maxn], pre[maxn], dist[maxn], inq[maxn];\nqueue<int> q;\nstruct edge { int to, cap, cost, nxt; } e[2000010];\nint id(int t, int v) { return t * n + v; }\n\nvoid add(int from, int to, int cap, int cost) {\n    e[cnt] = (edge){to, cap, cost, head[from]}, head[from] = cnt++;\n    e[cnt] = (edge){from, 0, -cost, head[to]}, head[to] = cnt++;\n}\n\nbool spfa(int s, int t) {\n    memset(dist, 0x3f, sizeof(dist));\n    q.push(s), dist[s] = 0;\n    while (!q.empty()) {\n        int v = q.front(); q.pop(), inq[v] = 0;\n        for (int i = head[v], u; ~i; i = e[i].nxt) {\n            if (e[i].cap && dist[u = e[i].to] > dist[v] + e[i].cost) {\n                dist[u] = dist[v] + e[i].cost, pre[u] = i;\n                if (!inq[u]) q.push(u), inq[u] = 1;\n            }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid upd(int s, int t) {\n    for (int i = t; i ^ s; i = e[pre[i] ^ 1].to) {\n        e[pre[i]].cap--, e[pre[i] ^ 1].cap++;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &a[i]), add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &x[i], &y[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            for (int j = 1; j <= min(k, 25); j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    maxn = 6010\n    INF = 0x3f3f3f3f\n    \n    a = [0] * (k + 1)\n    x = [0] * (m + 1)\n    y = [0] * (m + 1)\n    \n    for i in range(1, k + 1):\n        a[i] = int(data[idx]); idx += 1\n    \n    for i in range(1, m + 1):\n        x[i] = int(data[idx]); idx += 1\n        y[i] = int(data[idx]); idx += 1\n    \n    # Graph representation\n    head = [-1] * maxn\n    e = []\n    cnt = 0\n    \n    def id_func(t, v):\n        return t * n + v\n    \n    def add(from_node, to_node, cap, cost):\n        nonlocal cnt\n        e.append([to_node, cap, cost, head[from_node]])\n        head[from_node] = cnt\n        cnt += 1\n        e.append([from_node, 0, -cost, head[to_node]])\n        head[to_node] = cnt\n        cnt += 1\n    \n    # Add edges for initial positions\n    S = 0\n    T = 6000\n    for i in range(1, k + 1):\n        add(S, id_func(0, a[i]), 1, 0)\n    \n    # Build the graph for time steps\n    for t in range(0, 101):\n        # Move from node i at time t to node i at time t+1\n        for i in range(2, n + 1):\n            add(id_func(t, i), id_func(t + 1, i), k, c)\n        \n        # Edge from node 1 at time t to sink T\n        add(id_func(t, 1), T, k, 0)\n        \n        # Add edges for the m roads\n        for i in range(1, m + 1):\n            for j in range(1, min(k, 25) + 1):\n                cost = c + (2 * j - 1) * d\n                add(id_func(t, x[i]), id_func(t + 1, y[i]), 1, cost)\n                add(id_func(t, y[i]), id_func(t + 1, x[i]), 1, cost)\n    \n    # SPFA and min cost max flow\n    dist = [INF] * maxn\n    pre = [0] * maxn\n    inq = [0] * maxn\n    ans = 0\n    \n    def spfa(s, t):\n        nonlocal dist, pre, inq\n        dist = [INF] * maxn\n        q = deque()\n        q.append(s)\n        dist[s] = 0\n        \n        while q:\n            v = q.popleft()\n            inq[v] = 0\n            i = head[v]\n            while i != -1:\n                u = e[i][0]\n                if e[i][1] > 0 and dist[u] > dist[v] + e[i][2]:\n                    dist[u] = dist[v] + e[i][2]\n                    pre[u] = i\n                    if not inq[u]:\n                        q.append(u)\n                        inq[u] = 1\n                i = e[i][3]\n        return dist[t] < 1e9\n    \n    def upd(s, t):\n        nonlocal ans\n        i = t\n        while i != s:\n            edge_idx = pre[i]\n            e[edge_idx][1] -= 1\n            e[edge_idx ^ 1][1] += 1\n            i = e[edge_idx ^ 1][0]\n        ans += dist[t]\n    \n    while spfa(S, T):\n        upd(S, T)\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.9