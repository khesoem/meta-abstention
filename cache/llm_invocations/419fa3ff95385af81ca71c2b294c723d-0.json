{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int N = 12;\nconst int INF = 1000000009;\nconst int dx[4] = {0, 1, 0, -1};\nconst int dy[4] = {1, 0, -1, 0};\n\nint n, t;\nchar a[N][N], b[N][N];\nint sx, sy;\n\nint dist[N][N];\n\nvoid bfs(int startX, int startY) {\n    for (int i = 0; i < n; ++i)\n        fill(dist[i], dist[i] + n, INF);\n    bool vis[N][N] = {};\n    queue<pair<int,int>> q;\n    vis[startX][startY] = true;\n    dist[startX][startY] = 0;\n    q.emplace(startX, startY);\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + dx[k], ny = y + dy[k];\n            if (nx >= 0 && nx < n && ny >= 0 && ny < n && !vis[nx][ny] && isdigit(a[nx][ny])) {\n                vis[nx][ny] = true;\n                dist[nx][ny] = dist[x][y] + 1;\n                q.emplace(nx, ny);\n            }\n        }\n    }\n}\n\n// Flatten 4D state to 1D index\ninline int idx(int sx, int sy, int x, int y) {\n    return ((sx * N + sy) * N + x) * N + y;\n}\n\nconst int STATES = N * N * N * N; // 20736\nbitset<STATES> dp[72]; // dp[yt] bitset\nbitset<STATES> reachable; // u flattened\n\n// Max flow using adjacency list\nstruct Edge {\n    int to, rev, cap;\n};\nvector<vector<Edge>> graph;\nvector<int> level, it;\n\nvoid add_edge(int from, int to, int cap) {\n    graph[from].push_back({to, (int)graph[to].size(), cap});\n    graph[to].push_back({from, (int)graph[from].size() - 1, 0});\n}\n\nbool bfs_level() {\n    fill(level.begin(), level.end(), -1);\n    queue<int> q;\n    level[0] = 0;\n    q.push(0);\n    while (!q.empty()) {\n        int v = q.front(); q.pop();\n        for (const Edge& e : graph[v]) {\n            if (e.cap > 0 && level[e.to] < 0) {\n                level[e.to] = level[v] + 1;\n                q.push(e.to);\n            }\n        }\n    }\n    return level[2 * n * n + 1] >= 0;\n}\n\nint dfs(int v, int f) {\n    if (v == 2 * n * n + 1) return f;\n    for (int &i = it[v]; i < (int)graph[v].size(); ++i) {\n        Edge &e = graph[v][i];\n        if (e.cap > 0 && level[v] < level[e.to]) {\n            int ret = dfs(e.to, min(f, e.cap));\n            if (ret > 0) {\n                e.cap -= ret;\n                graph[e.to][e.rev].cap += ret;\n                return ret;\n            }\n        }\n    }\n    return 0;\n}\n\nvoid solv() {\n    cin >> n >> t;\n    for (int i = 0; i < n; ++i) cin >> a[i];\n    for (int i = 0; i < n; ++i) cin >> b[i];\n    cin >> sx >> sy;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (a[i][j] == 'Z') { sx = i; sy = j; }\n    bfs(sx, sy);\n\n    // Initialize dp[0]\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (isdigit(a[i][j]))\n                dp[0].set(idx(i, j, i, j));\n\n    // DP transitions\n    for (int yt = 0; yt < t; ++yt) {\n        for (int s = 0; s < STATES; ++s) {\n            if (!dp[yt].test(s)) continue;\n            int sx_ = s / (N * N * N);\n            int sy_ = (s / (N * N)) % N;\n            int x = (s / N) % N;\n            int y = s % N;\n            if (dist[x][y] <= yt) continue;\n            for (int k = 0; k < 4; ++k) {\n                int nx = x + dx[k], ny = y + dy[k];\n                if (nx >= 0 && nx < n && ny >= 0 && ny < n && isdigit(a[nx][ny]) && dist[nx][ny] >= yt + 1) {\n                    dp[yt + 1].set(idx(sx_, sy_, nx, ny));\n                }\n            }\n        }\n    }\n\n    // Build reachable set\n    for (int yt = 0; yt <= t; ++yt)\n        reachable |= dp[yt];\n\n    // Build flow network\n    int V = 2 * n * n + 2;\n    graph.assign(V, vector<Edge>());\n    level.resize(V);\n    it.resize(V);\n\n    // Source to first layer\n    for (int x = 0; x < n; ++x)\n        for (int y = 0; y < n; ++y)\n            if (isdigit(a[x][y]))\n                add_edge(0, x * n + y + 1, a[x][y] - '0');\n\n    // Second layer to sink\n    for (int x = 0; x < n; ++x)\n        for (int y = 0; y < n; ++y)\n            if (isdigit(b[x][y]))\n                add_edge(n * n + x * n + y + 1, 2 * n * n + 1, b[x][y] - '0');\n\n    // Edges between layers based on reachable\n    for (int x1 = 0; x1 < n; ++x1)\n        for (int y1 = 0; y1 < n; ++y1)\n            if (isdigit(a[x1][y1]))\n                for (int x2 = 0; x2 < n; ++x2)\n                    for (int y2 = 0; y2 < n; ++y2)\n                        if (isdigit(a[x2][y2]) && reachable.test(idx(x1, y1, x2, y2)))\n                            add_edge(x1 * n + y1 + 1, n * n + x2 * n + y2 + 1, INF);\n\n    // Dinic max flow\n    int flow = 0;\n    while (bfs_level()) {\n        fill(it.begin(), it.end(), 0);\n        int f;\n        while ((f = dfs(0, INF)) > 0)\n            flow += f;\n    }\n\n    cout << flow << \"\\n\";\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    solv();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nN = 12\nINF = 10**9\ndx = [0, 1, 0, -1]\ndy = [1, 0, -1, 0]\n\ndef bfs(startX, startY, a, n):\n    dist = [[INF]*n for _ in range(n)]\n    vis = [[False]*n for _ in range(n)]\n    q = deque()\n    vis[startX][startY] = True\n    dist[startX][startY] = 0\n    q.append((startX, startY))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx, ny = x + dx[k], y + dy[k]\n            if 0 <= nx < n and 0 <= ny < n and not vis[nx][ny] and a[nx][ny].isdigit():\n                vis[nx][ny] = True\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n    return dist\n\ndef idx(sx, sy, x, y):\n    return ((sx * N + sy) * N + x) * N + y\n\nSTATES = N * N * N * N  # 20736\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n    sx = int(next(it))\n    sy = int(next(it))\n    # Override if 'Z' found\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                sx, sy = i, j\n    dist = bfs(sx, sy, a, n)\n\n    # dp[yt] as integer bitset\n    dp = [0] * (t + 1)\n    # Initialize dp[0]\n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit():\n                dp[0] |= (1 << idx(i, j, i, j))\n\n    # DP transitions\n    for yt in range(t):\n        for s in range(STATES):\n            if (dp[yt] >> s) & 1:\n                sx_ = s // (N * N * N)\n                sy_ = (s // (N * N)) % N\n                x = (s // N) % N\n                y = s % N\n                if dist[x][y] <= yt:\n                    continue\n                for k in range(4):\n                    nx, ny = x + dx[k], y + dy[k]\n                    if 0 <= nx < n and 0 <= ny < n and a[nx][ny].isdigit() and dist[nx][ny] >= yt + 1:\n                        dp[yt + 1] |= (1 << idx(sx_, sy_, nx, ny))\n\n    # reachable = OR of all dp[yt]\n    reachable = 0\n    for yt in range(t + 1):\n        reachable |= dp[yt]\n\n    # Build flow network\n    V = 2 * n * n + 2\n    graph = [[] for _ in range(V)]\n    level = [0] * V\n    it_ptr = [0] * V\n\n    def add_edge(fr, to, cap):\n        graph[fr].append([to, len(graph[to]), cap])\n        graph[to].append([fr, len(graph[fr]) - 1, 0])\n\n    # Source to first layer (a cells)\n    for x in range(n):\n        for y in range(n):\n            if a[x][y].isdigit():\n                add_edge(0, x * n + y + 1, int(a[x][y]))\n\n    # Second layer to sink (b cells)\n    for x in range(n):\n        for y in range(n):\n            if b[x][y].isdigit():\n                add_edge(n * n + x * n + y + 1, 2 * n * n + 1, int(b[x][y]))\n\n    # Edges between layers based on reachable\n    for x1 in range(n):\n        for y1 in range(n):\n            if a[x1][y1].isdigit():\n                for x2 in range(n):\n                    for y2 in range(n):\n                        if a[x2][y2].isdigit() and (reachable >> idx(x1, y1, x2, y2)) & 1:\n                            add_edge(x1 * n + y1 + 1, n * n + x2 * n + y2 + 1, INF)\n\n    # Dinic max flow\n    def bfs_level():\n        for i in range(V):\n            level[i] = -1\n        q = deque()\n        level[0] = 0\n        q.append(0)\n        while q:\n            v = q.popleft()\n            for to, rev, cap in graph[v]:\n                if cap > 0 and level[to] < 0:\n                    level[to] = level[v] + 1\n                    q.append(to)\n        return level[2 * n * n + 1] >= 0\n\n    def dfs(v, f):\n        if v == 2 * n * n + 1:\n            return f\n        for i in range(it_ptr[v], len(graph[v])):\n            it_ptr[v] = i\n            to, rev, cap = graph[v][i]\n            if cap > 0 and level[v] < level[to]:\n                ret = dfs(to, min(f, cap))\n                if ret:\n                    graph[v][i][2] -= ret\n                    graph[to][rev][2] += ret\n                    return ret\n        return 0\n\n    flow = 0\n    while bfs_level():\n        it_ptr = [0] * V\n        while True:\n            f = dfs(0, INF)\n            if not f:\n                break\n            flow += f\n\n    print(flow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0609570381348021e-05, 0.0, 0.0, -0.00027295202016830444, -0.0015244778478518128, -1.1920928244535389e-07, -2.4676019165781327e-05, -5.8410845667822286e-05, -1.4305104514278355e-06, 0.0, -1.311301275563892e-06, -0.008837515488266945, -0.22315089404582977, -2.0503786799963564e-05, -2.3841855067985307e-07, -3.576278118089249e-07, -1.1801649634435307e-05, -2.9801878554280847e-05, -8.22540732769994e-06, -1.3589766240329482e-05, -0.47428613901138306, -0.014237256720662117, -0.0010202685371041298, -0.09584704041481018, -0.0015698263887315989, -8.344646857949556e-07, -0.0005529781919904053, -3.3378546504536644e-06, 0.0, -0.0003358753747306764, -5.960462772236497e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -1.6689160474925302e-05, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -3.3378546504536644e-06, -0.0001382732152706012, -0.09617062658071518, -0.27380242943763733, -0.03302014619112015, -0.07898063212633133, -1.2993727978027891e-05, -1.1920928244535389e-07, 0.0, -0.029750995337963104, -0.5765365958213806, -0.000920825288631022, -0.001176618505269289, -0.03804841265082359, -3.576278118089249e-07, -0.00025090406415984035, -1.5497195136049413e-06, -7.152555099310121e-07, -6.198863957251888e-06, -0.049263663589954376, -0.005240275990217924, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.3470558769768104e-05, -2.861018856492592e-06, 0.0, -0.00091856240760535, 0.0, -1.19209282