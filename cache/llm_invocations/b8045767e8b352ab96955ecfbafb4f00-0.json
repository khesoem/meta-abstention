  pair<int, int> augmentPath(int from, int to, int flow) {\n        int pathCost = 0;\n        for (int cur = to; cur != from; cur = p[cur]) {\n            flow = min(flow, res[p[cur]][cur]);\n        }\n        for (; to != from; to = p[to]) {\n            res[p[to]][to] -= flow;\n            res[to][p[to]] += flow;\n            pathCost += cost[p[to]][to] * flow;\n        }\n        return {flow, pathCost};\n    }\n\n    pair<int, int> getMinCostMaxFlow() {\n        int flow = 0;\n        int totalCost = 0;\n        while (findCheapestPath()) {\n            auto result = augmentPath(src, sink, INT_MAX);\n            flow += result.first;\n            totalCost += result.second;\n        }\n        return {flow, totalCost};\n    }\n};\n\nint main() {\n    const int letters = 'z' - 'a' + 1;\n    int n;\n    string s;\n    cin >> n >> s;\n    vector<int> b(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> b[i];\n    }\n\n    vector<int> letCount(letters, 0);\n    for (int i = 0; i < n; ++i) {\n        letCount[s[i] - 'a']++;\n    }\n\n    int source = 0;\n    int charOffSet = 1;\n    int pairOffSet = charOffSet + letters;\n    int sinkOffSet = pairOffSet + n / 2;\n    int sink = sinkOffSet;\n    int vNum = sinkOffSet + 1;\n\n    Graph g(vNum, source, sink);\n\n    // Source -> Letters\n    for (int i = 0; i < letters; ++i) {\n        g.addEdge(source, charOffSet + i, letCount[i], 0);\n    }\n\n    // Letters -> Pairs\n    for (int i = 0; i < letters; ++i) {\n        for (int j = 0; j < n / 2; ++j) {\n            char c1 = s[j];\n            char c2 = s[n - j - 1];\n            if (c1 == 'a' + i) {\n                if (c1 == c2) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -max(b[j], b[n - j - 1]));\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[j]);\n                }\n            } else {\n                if (c2 == 'a' + i) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[n - j - 1]);\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, 0);\n                }\n            }\n        }\n    }\n\n    // Pairs -> Sink\n    for (int i = 0; i < n / 2; ++i) {\n        g.addEdge(pairOffSet + i, sink, 2, 0);\n    }\n\n    auto ans = g.getMinCostMaxFlow();\n    cout << -ans.second << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.17041097581386566, -2.8132995794294402e-05, 0.0, -1.1920928244535389e-07, -0.0002335037279408425, -9.762764238985255e-05, -5.245195097813848e-06, -0.3133080005645752, -2.1457441107486375e-05, 0.0, 0.0, -0.005427506286650896, -9.536738616588991e-07, 0.0, 0.0, -0.1877198964357376, -2.0265558760002023e-06, 0.0, 0.0, -0.3141268491744995, -7.986990567587782e-06, 0.0, 0.0, -5.98412734689191e-05, 0.0, 0.0, -0.47411349415779114, -0.0032448519486933947, -3.540453326422721e-05, 0.0, -9.536738616588991e-07, -0.20409278571605682, -0.011753004975616932, -2.3841830625315197e-06, -0.03065825253725052, -2.3841855067985307e-07, -3.6954811548639555e-06, -2.8013790142722428e-05, -0.00021753329201601446, -2.3483953555114567e-05, -0.16026462614536285, 0.0, -2.3841855067985307e-07, -1.6689286894688848e-06, -0.00671901972964406, 0.0, 0.0, -4.768360213347478e-06, -0.016070010140538216, -0.0024760086089372635, -1.1920922133867862e-06, -6.198863957251888e-06, -1.4305104514278355e-06, -9.60780744208023e-05, -5.006777428206988e-06, -0.011088770814239979, 0.0, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -0.00011669908417388797, -0.0007397775771096349, -0.0011705459328368306, -0.07898040860891342, -0.2852133810520172, -0.16022521257400513, -0.0028383941389620304, -0.018186016008257866, 0.0, -0.2519294023513794, -2.3841855067985307e-07, -2.0265558760002023e-06, -0.32373905181884766, -0.006797404494136572, -0.00029869386344216764, -0.001178642618469894, -0.06860791146755219, -0.05525270104408264, -5.125868119648658e-05, -0.576066851615