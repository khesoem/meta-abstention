n\n        def fact(self, n):\n            while len(self.fact_arr) <= n:\n                self.fact_arr.append(self.fact_arr[-1] * len(self.fact_arr) % self.MOD)\n            return self.fact_arr[n]\n\n        def inv_fact(self, n):\n            L = len(self.inv_fact_arr)\n            if L > n:\n                return self.inv_fact_arr[n]\n            # ensure factorial up to n\n            self.fact(n)\n            # size of missing part: n - (L - 1) = n - L + 1\n            f_inv = [0] * (n - L + 1)\n            f_inv[0] = pow(self.fact(n), self.MOD - 2, self.MOD)\n            for i in range(1, len(f_inv)):\n                f_inv[i] = f_inv[i - 1] * (n - i + 1) % self.MOD\n            for i in range(len(f_inv) - 1, -1, -1):\n                self.inv_fact_arr.append(f_inv[i])\n            return self.inv_fact_arr[n]\n\n        def parity_sign(self, k):\n            return 1 if (k & 1) == 0 else self.MOD - 1\n\n        def ncr(self, n, r):\n            if r < 0 or n < r:\n                return 0\n            return self.fact(n) * self.inv_fact(r) % self.MOD * self.inv_fact(n - r) % self.MOD\n\n        def normalize(self, x):\n            x %= self.MOD\n            if x < 0:\n                x += self.MOD\n            return x\n\n        def add(self, a, b):\n            return (a + b) % self.MOD\n\n        def mult(self, *args):\n            res = 1\n            for a in args:\n                res = (res * a) % self.MOD\n            return res\n\n        def pow(self, x, e):\n            if e < 0:\n                x = self.inv(x)\n                e = -e\n            return pow(x, e, self.MOD)\n\n        def inv(self, value):\n            return pow(value, self.MOD - 2, self.MOD)\n\n\nclass EPlacingRooks:\n    def solve(self, testNumber, inp, out):\n        mod = NumberTheory.Mod998()\n        n = inp.nextInt()\n        k = inp.nextLong()\n        if k == 0:\n            out.write(str(mod.fact(n)) + \"\\n\")\n            return\n        if k > n - 1:\n            o