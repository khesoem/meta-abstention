{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <cassert>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\nconst int iinf = 0x3f3f3f3f;\nconst ll linf = 0x3f3f3f3f3f3f3f3f;\n\nconst int N = 50;\nint n, m, k, c, d, mxt;\n\nconst int fN = (N * 3 + 1) * N + 2;\nint s, t, fn;\nvector<int> e[fN];\nvector<int> to, fw, co;\n\nvoid adde(int u, int v, int w, int c) {\n    e[u].push_back((int)to.size());\n    to.push_back(v);\n    fw.push_back(w);\n    co.push_back(+c);\n    e[v].push_back((int)to.size());\n    to.push_back(u);\n    fw.push_back(0);\n    co.push_back(-c);\n}\n\nint dep[fN], pre[fN];\nbool vis[fN];\n\nbool spfa() {\n    fill(dep, dep + fn, iinf);\n    fill(pre, pre + fn, -1);\n    fill(vis, vis + fn, false);\n    queue<int> q;\n    q.push(s);\n    vis[s] = true;\n    dep[s] = 0;\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        vis[u] = false;\n        for (int v : e[u]) {\n            if (fw[v] && dep[to[v]] > dep[u] + co[v]) {\n                dep[to[v]] = dep[u] + co[v];\n                pre[to[v]] = v;\n                if (!vis[to[v]]) {\n                    q.push(to[v]);\n                    vis[to[v]] = true;\n                }\n            }\n        }\n    }\n    return dep[t] < iinf;\n}\n\npair<int, int> mcmf() {\n    pair<int, int> res(0, 0);\n    while (spfa()) {\n        int f = iinf;\n        for (int u = t; u != s; u = to[pre[u] ^ 1]) {\n            f = min(f, fw[pre[u]]);\n        }\n        for (int u = t; u != s; u = to[pre[u] ^ 1]) {\n            fw[pre[u]] -= f;\n            fw[pre[u] ^ 1] += f;\n        }\n        res.first += f;\n        res.second += dep[t] * f;\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    mxt = N * 3 + 1;\n    fn = (t = (s = n * mxt) + 1) + 1;\n    for (int i = 0; i < k; i++) {\n        int u;\n        cin >> u;\n        --u;\n        adde(s, u, 1, 0);\n    }\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        for (int i2 = 0; i2 < mxt - 1; i2++) {\n            for (int p = 1; p <= k; p++) {\n                adde(i2 * n + u, (i2 + 1) * n + v, 1, 2 * d * p - d);\n                adde(i2 * n + v, (i2 + 1) * n + u, 1, 2 * d * p - d);\n            }\n        }\n    }\n    for (int u = 0; u < n; u++) {\n        for (int i = 0; i < mxt - 1; i++) {\n            adde(i * n + u, (i + 1) * n + u, k, 0);\n        }\n    }\n    for (int i = 0; i < mxt; i++) {\n        adde(i * n, t, k, i * c);\n    }\n    pair<int, int> ans = mcmf();\n    assert(ans.first == k);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    mxt = n * 3 + 1  # maximum time steps\n    # node indices: 0 .. n*mxt-1 are time-state nodes, then s, t\n    s = n * mxt\n    t = s + 1\n    fn = t + 1\n\n    # adjacency list: each entry is list of edge indices\n    e = [[] for _ in range(fn)]\n    # edges: each edge is [to, rev, cap, cost]\n    edges = []\n\n    def add_edge(u: int, v: int, cap: int, cost: int) -> None:\n        # forward edge\n        e[u].append(len(edges))\n        edges.append([v, -1, cap, cost])\n        # reverse edge\n        e[v].append(len(edges))\n        edges.append([u, -1, 0, -cost])\n        # set rev indices\n        edges[-2][1] = len(edges) - 1\n        edges[-1][1] = len(edges) - 2\n\n    # read starting positions\n    for _ in range(k):\n        u = int(next(it)) - 1\n        add_edge(s, u, 1, 0)\n\n    # roads\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for i2 in range(mxt - 1):\n            for p in range(1, k + 1):\n                cost = 2 * d * p - d\n                add_edge(i2 * n + u, (i2 + 1) * n + v, 1, cost)\n                add_edge(i2 * n + v, (i2 + 1) * n + u, 1, cost)\n\n    # stay edges\n    for u in range(n):\n        for i in range(mxt - 1):\n            add_edge(i * n + u, (i + 1) * n + u, k, 0)\n\n    # sink edges from node 0 at each time\n    for i in range(mxt):\n        add_edge(i * n, t, k, i * c)\n\n    INF = 10**18\n    dep = [0] * fn\n    pre = [0] * fn\n    vis = [False] * fn\n\n    def spfa() -> bool:\n        for i in range(fn):\n            dep[i] = INF\n            pre[i] = -1\n            vis[i] = False\n        q = deque()\n        q.append(s)\n        vis[s] = True\n        dep[s] = 0\n        while q:\n            u = q.popleft()\n            vis[u] = False\n            for ei in e[u]:\n                edge = edges[ei]\n                if edge[2] > 0 and dep[edge[0]] > dep[u] + edge[3]:\n                    dep[edge[0]] = dep[u] + edge[3]\n                    pre[edge[0]] = ei\n                    if not vis[edge[0]]:\n                        q.append(edge[0])\n                        vis[edge[0]] = True\n        return dep[t] < INF\n\n    flow = 0\n    cost = 0\n    while spfa():\n        # find min capacity along path\n        f = INF\n        v = t\n        while v != s:\n            ei = pre[v]\n            f = min(f, edges[ei][2])\n            v = edges[ei ^ 1][0]  # reverse edge's to node\n        # augment\n        v = t\n        while v != s:\n            ei = pre[v]\n            edges[ei][2] -= f\n            edges[ei ^ 1][2] += f\n            v = edges[ei ^ 1][0]\n        flow += f\n        cost += dep[t] * f\n\n    # assert flow == k\n    if flow != k:\n        # should not happen per problem constraints\n        pass\n    sys.stdout.write(str(cost) + '\\n')\n\nif __name__ == '__main__':\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.00012659224739763886, -2.7418097943154862e-06, 0.0, -0.00013040646445006132, -0.0015430459752678871, -1.1920928244535389e-07, -1.4662635294371285e-05, -0.0003358753747306764, -2.3841855067985307e-07, 0.0, -1.1920922133867862e-06, -0.0011857867939397693, -0.05542775243520737, -0.3547224998474121, -0.12697425484657288, -2.861018856492592e-06, -1.680836794548668e-05, -5.960462772236497e-07, -3.576278118089249e-07, -0.0008509114268235862, -7.152555099310121e-07, -0.47421684861183167, 0.0, -0.5759549140930176, -1.1920922133867862e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.3351351299206726e-05, -4.768370445162873e-07, -2.3841855067985307e-07, -0.12694872915744781, 0.0, -2.3841855067985307e-07, -2.753696753643453e-05, -0.0002983363519888371, -0.00026127262390218675, -2.312633478140924e-05, -3.933898824470816e-06, 0.0, 0.0, 0.0, -0.00533122755587101, 0.0, 0.0, -4.768360213347478e-06, 0.0, -1.1920928244535389e-07, 0.0, -3.3378546504536644e-06, 0.0, -1.2040065485052764e-05, -0.000169024482602253