\n\t\t\t}\n\n\t\t\tif(!seen[t])\n\t\t\t\tbreak;\n\n\t\t\tint add = INF;\n\t\t\tfor(int v = t; v != s; v = parent[v])\n\t\t\t\tadd = min(add, cap[parent[v]][v] - flow[parent[v]][v]);\n\n\t\t\tfor(int v = t; v != s; v = parent[v]) {\n\t\t\t\tflow[parent[v]][v] += add;\n\t\t\t\tflow[v][parent[v]] -= add;\n\t\t\t}\n\n\t\t\tret += add;\n\t\t}\n\t\treturn ret;\n\t}\n} mf;\n\n#define MAX 12\nint n, t, zx, zy;\nchar smp[MAX][MAX], cmp[MAX][MAX], work[MAX][MAX];\nint vis[MAX][MAX];\nint dx[4] = {1, 0, -1, 0};\nint dy[4] = {0, -1, 0, 1};\n\ninline int X(int i, int j) { return i * n + j; }\ninline int Y(int i, int j) { return n * n + i * n + j; }\ninline int S() { return n * n * 2; }\ninline int T() { return S() + 1; }\ninline int N() { return T() + 1; }\n\nstruct qNode {\n\tint x, y, t, type;\n\tqNode() {}\n\tqNode(int x, int y, int t, int type): x(x), y(y), t(t), type(type) {}\n};\n\nvoid bfs(int sx, int sy) {\n\tqueue<qNode> q;\n\tq.push(qNode(sx, sy, 0, 0));\n\tvis[sx][sy] = 1;\n\tq.push(qNode(zx, zy, 0, 1));\n\twhile(!q.empty()) {\n\t\tqNode u = q.front();\n\t\tint nx, ny;\n\t\tq.pop();\n\t\tif(u.t == t)\n\t\t\tbreak;\n\t\tif(u.type == 0 && isalpha(work[u.x][u.y]))\n\t\t\tcontinue;\n\t\tfor(int i = 0; i < 4; ++i) {\n\t\t\tnx = u.x + dx[i];\n\t\t\tny = u.y + dy[i];\n\t\t\tif(nx >= 0 && nx < n && ny >= 0 && ny < n) {\n\t\t\t\tif(u.type == 0 && !vis[nx][ny] && !isalpha(work[nx][ny])) {\n\t\t\t\t\tvis[nx][ny] = 1;\n\t\t\t\t\tq.push(qNode(nx, ny, u.t + 1, 0));\n\t\t\t\t}\n\t\t\t\telse if(u.type == 1 && !isalpha(work[nx][ny])) {\n\t\t\t\t\twork[nx][ny] = 'Z';\n\t\t\t\t\tq.push(qNode(nx, ny, u.t + 1, 1));\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\nint main() {\n\twhile(scanf(\"%d%d\", &n, &t) != EOF) {\n\t\tmf.init(N(), S(), T());\n\t\tfor(int i = 0; i < n; ++i) {\n\t\t\tscanf(\"%s\", smp[i]);\n\t\t\tfor(int j = 0; j < n; ++j)\n\t\t\t\tif(isdigit(smp[i][j]) && smp[i][j] > '0')\n\t\t\t\t\tmf.addEdge(S(), X(i, j), smp[i][j] - '0');\n\t\t\t\telse if(smp[i][j] == 'Z') {\n\t\t\t\t\tzx = i;\n\t\t\t\t\tzy = j;\n\t\t\t\t}\n\t\t}\n\t\tfor(int i = 0; i < n; ++i) {\n\t\t\tscanf(\"%s\", cmp[i]);\n\t\t\tfor(int j = 0; j < n; ++j)\n\t\t\t\tif(isdigit(cmp[i][j]) && cmp[i][j] > '0')\n\t\t\t\t\tmf.addEdge(Y(i, j), T(), cmp[i][j] - '0');\n\t\t}\n\t\tfor(int i = 0; i < n; ++i)\n\t\t\tfor(int j = 0; j < n; ++j) {\n\t\t\t\tif(!isdigit(smp[i][j]) || smp[i][j] <= '0')\n\t\t\t\t\tcontinue;\n\t\t\t\tmemset(vis, 0, sizeof(vis));\n\t\t\t\tmemcpy(work, smp, sizeof(smp));\n\t\t\t\tbfs(i, j);\n\t\t\t\tfor(int xi = 0; xi < n; ++xi)\n\t\t\t\t\tfor(int yi = 0; yi < n; ++yi) {\n\t\t\t\t\t\tif(!isdigit(cmp[xi][yi]) || cmp[xi][yi] <= '0')\n\t\t\t\t\t\t\tcontinue;\n\t\t\t\t\t\tif(vis[xi][yi])\n\t\t\t\t\t\t\tmf.addEdge(X(i, j), Y(xi, yi), INF);\n\t\t\t\t\t}\n\t\t\t}\n\t\tprintf(\"%d\\n\", mf.maxFlow());\n\t}\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass MaxFlow:\n    def __init__(self, n, s, t):\n        self.n = n\n        self.s = s\n        self.t = t\n        self.cap = [[0] * n for _ in range(n)]\n        self.flow = [[0] * n for _ in range(n)]\n        self.parent = [0] * n\n        self.seen = [0] * n\n\n    def addEdge(self, u, v, c):\n        self.cap[u][v] += c\n\n    def maxFlow(self):\n        ret = 0\n        while True:\n            self.seen = [0] * self.n\n            q = deque()\n            q.append(self.s)\n            self.seen[self.s] = 1\n            self.parent[self.s] = -1\n            while q:\n                u = q.popleft()\n                for v in range(self.n):\n                    if not self.seen[v] and self.cap[u][v] - self.flow[u][v] > 0:\n                        self.seen[v] = 1\n                        self.parent[v] = u\n                        if v == self.t:\n                            break\n                        q.append(v)\n                if self.seen[self.t]:\n                    break\n            if not self.seen[self.t]:\n                break\n            add = INF\n            v = self.t\n            while v != self.s:\n                u = self.parent[v]\n                add = min(add, self.cap[u][v] - self.flow[u][v])\n                v = u\n            v = self.t\n            while v != self.s:\n                u = self.parent[v]\n                self.flow[u][v] += add\n                self.flow[v][u] -= add\n                v = u\n            ret += add\n        return ret\n\ndef solve():\n    data = sys.stdin.read().splitlines()\n    idx = 0\n    out = []\n    dx = [1, 0, -1, 0]\n    dy = [0, -1, 0, 1]\n    while idx < len(data):\n        line = data[idx].strip()\n        if not line:\n            idx += 1\n            continue\n        n, t = map(int, line.split())\n        idx += 1\n        smp = []\n        for _ in range(n):\n            smp.append(data[idx].strip())\n            idx += 1\n        cmp = []\n        for _ in range(n):\n            cmp.append(data[idx].strip())\n            idx += 1\n\n        # find zombie position\n        zx = zy = -1\n        for i in range(n):\n            for j in range(n):\n                if smp[i][j] == 'Z':\n                    zx, zy = i, j\n                    break\n            if zx != -1:\n                break\n\n        # node index helpers\n        def X(i, j): return i * n + j\n        def Y(i, j): return n * n + i * n + j\n        def S(): return n * n * 2\n        def T(): return S() + 1\n        def N(): return T() + 1\n\n        mf = MaxFlow(N(), S(), T())\n\n        # source edges\n        for i in range(n):\n            for j in range(n):\n                if smp[i][j].isdigit() and smp[i][j] > '0':\n                    mf.addEdge(S(), X(i, j), int(smp[i][j]))\n\n        # sink edges\n        for i in range(n):\n            for j in range(n):\n                if cmp[i][j].isdigit() and cmp[i][j] > '0':\n                    mf.addEdge(Y(i, j), T(), int(cmp[i][j]))\n\n        # BFS for each source cell\n        for i in range(n):\n            for j in range(n):\n                if not (smp[i][j].isdigit() and smp[i][j] > '0'):\n                    continue\n                vis = [[0] * n for _ in range(n)]\n                work = [list(row) for row in smp]  # mutable copy\n                q = deque()\n                q.append((i, j, 0, 0))\n                vis[i][j] = 1\n                q.append((zx, zy, 0, 1))\n                while q:\n                    x, y, time, typ = q.popleft()\n                    if time == t:\n                        break\n                    if typ == 0 and work[x][y].isalpha():\n                        continue\n                    for d in range(4):\n                        nx = x + dx[d]\n                        ny = y + dy[d]\n                        if 0 <= nx < n and 0 <= ny < n:\n                            if typ == 0 and not vis[nx][ny] and not work[nx][ny].isalpha():\n                                vis[nx][ny] = 1\n                                q.append((nx, ny, time + 1, 0))\n                            elif typ == 1 and not work[nx][ny].isalpha():\n                                work[nx][ny] = 'Z'\n                                q.append((nx, ny, time + 1, 1))\n                # add edges to reachable sinks\n                for xi in range(n):\n                    for yi in range(n):\n                        if cmp[xi][yi].isdigit() and cmp[xi][yi] > '0' and vis[xi][yi]:\n                            mf.addEdge(X(i, j), Y(xi, yi), INF)\n\n        out.append(str(mf.maxFlow()))\n    sys.stdout.write(\"\\n\".join(out))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.344646857949556e-07, 0.0, 0.0, -3.6000557884108275e-05, -3.981510963058099e-05, 0.0, -1.6689286894688848e-06, -8.344646857949556e-07, 0.0, 0.0, 0.0, -0.001503052655607462, -0.0016750366194173694, 0.0, -1.9073468