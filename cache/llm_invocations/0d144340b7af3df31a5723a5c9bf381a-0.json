D;\n\n    int ans = powmod(k, n);\n    if (n % 2 == 0) {\n        f[n] = fac[n];\n        for (int z = 1; z <= k; ++z) {\n            update(n, k, f, g);\n            for (int i = 0; i <= n; ++i) swap(f[i], g[i]);\n            int res = f[0];\n            for (int j = 0; j < z; ++j) res = (ll)res * (k - j) % MOD;\n            ans = (ans - res) % MOD;\n        }\n    }\n    if (ans < 0) ans += MOD;\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(1000000)\n\nMAXN = 1000010\n\ndef powmod(a, b):\n    res = 1 % MOD\n    a %= MOD\n    while b:\n        if b & 1:\n            res = res * a % MOD\n        a = a * a % MOD\n        b >>= 1\n    return res\n\ndef inv(x):\n    if x <= 1:\n        return 1\n    return inv(MOD % x) * (MOD - MOD // x) % MOD\n\ndef update(n, k, a, b):\n    for i in range(n + 1):\n        b[i] = 0\n    i = n\n    while i:\n        if a[i] != 0:\n            j = i\n            while 2 * j >= i:\n                b[i ^ j] = (b[i ^ j] + a[i] * ifac[j]) % MOD\n                j = (j - 1) & i\n        i = (i - 1) & n\n\ndef main():\n    global MOD, ifac\n    n, k, MOD = map(int, sys.stdin.readline().split())\n    fac = [0] * MAXN\n    ifac = [0] * MAXN\n    fac[0] = 1\n    for i in range(1, MAXN):\n        fac[i] = fac[i - 1] * i % MOD\n    ifac[MAXN - 1] = inv(fac[MAXN - 1])\n    for i in range(MAXN - 2, -1, -1):\n        ifac[i] = ifac[i + 1] * (i + 1) % MOD\n\n    ans = powmod(k, n)\n    if n % 2 == 0:\n        f = [0] * (n + 1)\n        g = [0] * (n + 1)\n        f[n] = fac[n]\n        for z in range(1, k + 1):\n            update(n, k, f, g)\n            f, g = g, f\n            res = f[0]\n            for j in range(z):\n                res = res * (k - j) % MOD\n            ans = (ans - res) % MOD\n    if ans < 0:\n        ans += MOD\n    print(ans)\n