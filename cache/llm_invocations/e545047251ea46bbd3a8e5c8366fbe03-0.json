sert exp >= 0\n        base = self\n        res = Mod(1)\n        while exp > 0:\n            if exp & 1:\n                res *= base\n            base *= base\n            exp >>= 1\n        return res\n\nMAX_N = 7\nN = 0\nP = [[Mod(0) for _ in range(MAX_N)] for _ in range(MAX_N)]\n\ndef main():\n    global N, P\n    \n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx])\n    idx += 1\n    \n    for i in range(N):\n        for j in range(N):\n            p = int(data[idx])\n            idx += 1\n            P[i][j] = Mod(p) / Mod(100)\n    \n    masks_by_pop = [[] for _ in range(MAX_N + 1)]\n    idx_map = [-1] * (1 << N)\n    \n    for mask in range(1 << N):\n        pop = bin(mask).count('1')\n        idx_map[mask] = len(masks_by_pop[pop])\n        masks_by_pop[pop].append(mask)\n    \n    dp = defaultdict(lambda: Mod(0))\n    dp[1 << idx_map[0]] = Mod(1)\n    \n    for step in range(N):\n        new_dp = defaultdict(lambda: Mod(0))\n        \n        for cur in range(1 << N):\n            prod = Mod(1)\n            for j in range(N):\n                if (cur >> j) & 1:\n                    prod *= P[step][j]\n                else:\n                    prod *= (Mod(1) - P[step][j])\n            \n            for state, prob in list(dp.items()):\n                cur_state = state\n                cur_prob = prob\n                \n                next_state = 0\n                \n                for mask in masks_by_pop[step]:\n                    if (cur_state >> idx_map[mask]) & 1:\n                        for i in range(N):\n                            if ((cur >> i) & 1) and not ((mask >> i) & 1):\n                                next_state |= 1 << idx_map[mask | (1 << i)]\n                \n                new_dp[next_state] += cur_prob * prod\n        \n        dp = new_dp\n    \n    answer = Mod(0)\n    full = (1 << N) - 1\n    \n    for state, prob in dp.items():\n        if (state >> idx_map[full]) & 1:\n      