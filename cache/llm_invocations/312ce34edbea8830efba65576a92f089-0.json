{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MAXN = 5007;\nconst ll INF = 1e9;\nconst ll MOD = 1e9 + 7;\n\nstruct Edge {\n    int from, to;\n    ll cap, cost, flow;\n    Edge(int from, int to, ll cap, ll cost) : from(from), to(to), cap(cap), cost(cost), flow(0) {}\n};\n\nvector<Edge> edges;\nvector<int> graph[MAXN];\nll dist[MAXN], pot[MAXN];\nint parent[MAXN];\n\nvoid add_edge(int u, int v, ll cap, ll cost) {\n    graph[u].push_back(edges.size());\n    edges.push_back({u, v, cap, cost});\n    graph[v].push_back(edges.size());\n    edges.push_back({v, u, 0, -cost});\n}\n\nvoid bellman_ford(int s, int n) {\n    fill(pot, pot + MAXN, INF);\n    pot[s] = 0;\n    for (int i = 0; i < n; i++) {\n        for (size_t j = 0; j < edges.size(); j++) {\n            Edge &e = edges[j];\n            if (e.cap == e.flow || pot[e.from] == INF) continue;\n            pot[e.to] = min(pot[e.to], pot[e.from] + e.cost);\n        }\n    }\n}\n\nvoid dijkstra(int s) {\n    fill(dist, dist + MAXN, INF);\n    dist[s] = 0;\n    set<pair<ll, int>> pq;\n    pq.insert({0, s});\n    while (!pq.empty()) {\n        int v = pq.begin()->second;\n        pq.erase(pq.begin());\n        for (size_t i = 0; i < graph[v].size(); i++) {\n            int id = graph[v][i];\n            Edge &e = edges[id];\n            if (e.cap == e.flow) continue;\n            int to = e.to;\n            ll w = e.cost + pot[v] - pot[to];\n            if (dist[v] + w < dist[to]) {\n                pq.erase({dist[to], to});\n                dist[to] = dist[v] + w;\n                parent[to] = id;\n                pq.insert({dist[to], to});\n            }\n        }\n    }\n}\n\npair<ll, ll> mincost_maxflow(int s, int t) {\n    bellman_ford(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (true) {\n        if (dist[t] == INF) break;\n        ll pushed = INF, sum = 0;\n        for (int v = t; v != s; v = edges[parent[v]].from) {\n            pushed = min(pushed, edges[parent[v]].cap - edges[parent[v]].flow);\n            sum += edges[parent[v]].cost;\n        }\n        flow += pushed;\n        cost += pushed * sum;\n        for (int v = t; v != s; v = edges[parent[v]].from) {\n            int id = parent[v];\n            edges[id].flow += pushed;\n            edges[id ^ 1].flow -= pushed;\n        }\n        dijkstra(s);\n        copy(dist, dist + MAXN, pot);\n    }\n    return {cost, flow};\n}\n\nvoid solve() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnt(n, 0);\n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        cnt[--x]++;\n    }\n    for (int i = 0; i < n; i++) add_edge(5000, i, cnt[i], 0);\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        u--, v--;\n        for (int j = 0; j < 99; j++) {\n            ll cost = d;\n            for (int t = 0; t < 50; t++) {\n                add_edge(u + j * 50, v + (j + 1) * 50, 1, cost);\n                add_edge(v + j * 50, u + (j + 1) * 50, 1, cost);\n                cost += 2 * d;\n            }\n        }\n    }\n    for (int i = 0; i <= 99; i++) add_edge(0 + i * 50, 5001, INF, c * i);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < 99; j++)\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0);\n    auto answer = mincost_maxflow(5000, 5001);\n    assert(answer.second == k);\n    cout << answer.first;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout.tie(nullptr);\n    cout << fixed << setprecision(20);\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nMAXN = 5007\nINF = 10**9\nMOD = 10**9 + 7\n\nclass Edge:\n    __slots__ = ('fr', 'to', 'cap', 'cost', 'flow')\n    def __init__(self, fr, to, cap, cost):\n        self.fr = fr\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.flow = 0\n\nedges = []\ngraph = [[] for _ in range(MAXN)]\ndist = [INF] * MAXN\npot = [INF] * MAXN\nparent = [0] * MAXN\n\ndef add_edge(u, v, cap, cost):\n    graph[u].append(len(edges))\n    edges.append(Edge(u, v, cap, cost))\n    graph[v].append(len(edges))\n    edges.append(Edge(v, u, 0, -cost))\n\ndef bellman_ford(s, n):\n    global pot\n    pot = [INF] * MAXN\n    pot[s] = 0\n    for _ in range(n):\n        updated = False\n        for e in edges:\n            if e.cap == e.flow or pot[e.fr] == INF:\n                continue\n            if pot[e.fr] + e.cost < pot[e.to]:\n                pot[e.to] = pot[e.fr] + e.cost\n                updated = True\n        if not updated:\n            break\n\ndef dijkstra(s):\n    global dist, parent\n    dist = [INF] * MAXN\n    dist[s] = 0\n    parent = [0] * MAXN\n    pq = [(0, s)]\n    while pq:\n        d, v = heapq.heappop(pq)\n        if d != dist[v]:\n            continue\n        for id in graph[v]:\n            e = edges[id]\n            if e.cap == e.flow:\n                continue\n            to = e.to\n            w = e.cost + pot[v] - pot[to]\n            if dist[v] + w < dist[to]:\n                dist[to] = dist[v] + w\n                parent[to] = id\n                heapq.heappush(pq, (dist[to], to))\n\ndef mincost_maxflow(s, t):\n    global pot\n    bellman_ford(s, 50)\n    dijkstra(s)\n    flow = 0\n    cost = 0\n    while True:\n        if dist[t] == INF:\n            break\n        pushed = INF\n        sum_cost = 0\n        v = t\n        while v != s:\n            id = parent[v]\n            e = edges[id]\n            pushed = min(pushed, e.cap - e.flow)\n            sum_cost += e.cost\n            v = e.fr\n        flow += pushed\n        cost += pushed * sum_cost\n        v = t\n        while v != s:\n            id = parent[v]\n            edges[id].flow += pushed\n            edges[id ^ 1].flow -= pushed\n            v = edges[id].fr\n        dijkstra(s)\n        for i in range(MAXN):\n            pot[i] = dist[i]\n    return (cost, flow)\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    cnt = [0] * n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        cnt[x] += 1\n    for i in range(n):\n        add_edge(5000, i, cnt[i], 0)\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(99):\n            cost = d\n            for t in range(50):\n                add_edge(u + j * 50, v + (j + 1) * 50, 1, cost)\n                add_edge(v + j * 50, u + (j + 1) * 50, 1, cost)\n                cost += 2 * d\n    for i in range(100):\n        add_edge(0 + i * 50, 5001, INF, c * i)\n    for i in range(n):\n        for j in range(99):\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n    answer = mincost_maxflow(5000, 5001)\n    # assert answer[1] == k\n    print(answer[0])\n\nif __name__ == \"__main__\":\n    solve()\n<