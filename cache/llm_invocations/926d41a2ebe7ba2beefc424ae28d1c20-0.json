 rock2, int sci2, int paper2) {\n        return Math.min(rock1, sci2) + Math.min(sci1, paper2) + Math.min(paper1, rock2);\n    }\n\n    static int outcome(int a, int b) {\n        if (a == b) return 0;\n        if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n        return -1;\n    }\n\n    static int simulate(List<int[]> countsA, List<int[]> countsB) {\n        int total = 0;\n        int[] curA = null;\n        int[] curB = null;\n        try {\n            while (!countsA.isEmpty() || !countsB.isEmpty()) {\n                if (curA == null) {\n                    curA = countsA.remove(countsA.size() - 1);\n                }\n                if (curB == null) {\n                    curB = countsB.remove(countsB.size() - 1);\n                }\n                int amt = Math.min(curA[0], curB[0]);\n                int pts = amt * outcome(curA[1], curB[1]);\n                if (pts > 0) {\n                    total += pts;\n                }\n                if (curA[0] < curB[0]) {\n                    curB[0] -= curA[0];\n                    curA = null;\n                } else if (curA[0] > curB[0]) {\n                    curA[0] -= curB[0];\n                    curB = null;\n                } else {\n                    curA = null;\n                    curB = null;\n                }\n            }\n        } catch (IndexOutOfBoundsException e) {\n            // expected when one list empties before the other\n        }\n        return total;\n    }\n\n    static int minimum(int n, int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        int best = n;\n        int[][] perms = {\n            {0, 1, 2}, {0, 2, 1}, {1, 0, 2}, {1, 2, 0}, {2, 0, 1}, {2, 1, 0}\n        };\n        int[] counts1 = {rock1, sci1, paper1};\n        int[] types1 = {1, 2, 3};\n        int[] counts2 = {rock2, sci2, paper2};\n        int[] types2 = {1, 2, 3};\n\n        for (int[] perm1 : perms) {\n            for (int[] perm2 : perms) {\n  