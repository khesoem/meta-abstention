for i in range(n - 1, -1, -1):\n            c = n - 1 - i\n            temp = dp[:]\n            dp = [0] * (maxPairs + 1)\n            limit = (c * (c - 1)) // 2\n            count = 0\n            \n            for cur in range(-c, 0):\n                pairs = c + cur + 1\n                for j in range(middle - cur + 1, middle + limit + 1):\n                    if 0 <= j <= maxPairs and 0 <= j <= len(temp) - 1:\n                        count = mod.add(count, mod.multiply(temp[j], pairs))\n            \n            if i == 0:\n                answer = mod.add(answer, count)\n            else:\n                answer = mod.add(answer, mod.multiply(count, factorial[i - 1]))\n            \n            for j in range(middle - limit, middle + limit + 1):\n                if 0 <= j <= maxPairs:\n                    for cur in range(-c, c + 1):\n                        pairs = c - abs(cur) + 1\n                        new_idx = j + cur\n                        if 0 <= new_idx <= maxPairs:\n                            dp[new_idx] = mod.add(dp[new_idx], mod.multiply(pairs, temp[j]))\n        \n        out_writer.println(answer)\n\ndef main():\n    solver = E2AbnormalPermutationPairsHardVersion()\n    in_reader = InputReader(sys.stdin.buffer)\n    out_writer = OutputWriter(sys.stdout)\n    solver.solve(1, in_reader, out_writer)\n    out_writer.close()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001627074379939586, -1.6689286894688848e-06, -1.1920928244535389e-07, -0.00038425691309385, -0.010535219684243202, -0.1802082657814026, -0.20210565626621246, -0.5833026170730591, -0.004000162705779076, -0.0004320403386373073, -0.21322716772556305, -1.311301275563892e-06, -3.576278118089249e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -3.6954811548639555e-06, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -0.0003420721332076937, -3.099436753473128e-06, -2.2649740003