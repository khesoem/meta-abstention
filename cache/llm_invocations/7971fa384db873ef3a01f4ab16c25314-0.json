f level > K:\n            level = K\n            # still need to process remaining nodes? Actually we cap at K, but BFS continues with level=K\n            # The original code does: level = min(level, K) after increment, so it stays at K.\n            # We'll break after processing all nodes at level K? Actually the while loop continues but level stays K.\n            # We'll just set level = K and continue, but we need to ensure we don't increment beyond K.\n            # The original code: ++level; level = min(level, K); so after increment, it caps at K.\n            # So we'll do the same.\n    # After BFS, for cells with D==0 (unreachable), set to K\n    for i in range(N):\n        for j in range(N):\n            if D[i][j] == 0:\n                D[i][j] = K\n\n    # assign ids\n    id = [[[0]*65 for _ in range(N)] for __ in range(N)]\n    cnt = 0\n    for i in range(N):\n        for j in range(N):\n            if '0' <= A[i][j] <= '9':\n                for t in range(D[i][j]):\n                    id[i][j][t] = cnt + 1\n                    cnt += 1\n            if '1' <= B[i][j] <= '9':\n                id[i][j][D[i][j]] = cnt + 1\n                cnt += 1\n\n    INF = 1000000000\n    S = 0\n    E = cnt + 3\n    fg = FlowGraph(cnt + 5, S, E)\n\n    for i in range(N):\n        for j in range(N):\n            if '1' <= A[i][j] <= '9':\n                fg.add_edge(S, id[i][j][0], ord(A[i][j]) - ord('0'))\n            for d in range(4):\n                ni = i + moveX[d]\n                nj = j + moveY[d]\n                if ni < 0 or ni >= N or nj < 0 or nj >= N:\n                    continue\n                if A[ni][nj] == 'Y' or A[ni][nj] == 'Z':\n                    continue\n                for t in range(0, 65):\n                    if id[i][j][t] == 0:\n                        break\n                    if t == D[i][j] and '1' <= B[i][j] <= '9':\n                        break\n                    if id[ni][nj][t+1]:\n                        fg.add_edge(id[i