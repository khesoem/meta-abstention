al_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef fpow(a, b, p):\n    ans = 1\n    t = a % p\n    while b:\n        if b & 1:\n            ans = (ans * t) % p\n        t = (t * t) % p\n        b >>= 1\n    return ans\n\ndef lowbit(x):\n    return x & (-x)\n\ndef main():\n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    \n    ans = 1\n    for i in range(1, n + 1):\n        ans = (ans * k) % p\n    \n    if n % 2 == 0:\n        # Initialize factorials and inverse factorials\n        fac = [1] * (n + 1)\n        for i in range(1, n + 1):\n            fac[i] = (fac[i - 1] * i) % p\n        \n        inv = [1] * (n + 1)\n        inv[n] = fpow(fac[n], p - 2, p)\n        for i in range(n, 0, -1):\n            inv[i - 1] = (inv[i] * i) % p\n        \n        # Initialize memoization table\n        # f[cur][S] where cur ranges from 0 to k (but we'll use up to n) and S ranges from 0 to n\n        max_S = n\n        max_cur = n + 1\n        f = [[-1] * (max_S + 1) for _ in range(max_cur + 1)]\n        \n        def solve(cur, S):\n            if f[cur][S] != -1:\n                return f[cur][S]\n            \n            if S == 0:\n                res = fac[n]\n                for i in range(1, cur + 1):\n                    res = (res * (k - i + 1)) % p\n                f[cur][S] = res\n                return res\n            \n            res = 0\n            U = S - lowbit(S)\n            T = U\n            while T:\n                res = (res + (inv[S - T] * solve(cur + 1, T)) % p) % p\n                T = (T - 1) & U\n            \n            res = (res + (inv[S] * solve(cur + 1, 0)) % p) % p\n            f[cur][S] = res\n            return res\n        \n        ans = (ans - solve(0, n) + p) % p\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confi