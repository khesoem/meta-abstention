]) continue;\n\t\tint t=dfs(y,min(w[i],lim-flow),cost);\n\t\tw[i]-=t; w[i^1]+=t;\n\t\tflow+=t; cost+=t*c[i];\n\t\tif (flow==lim) return lim;\n\t}\n\treturn flow;\n}\n\ninline ll costflow(){\n\tint flow=0; ll cost=0;\n\twhile (spfa())\n\t\tdo{\n\t\t\tmemset(mark,0,sizeof(mark));\n\t\t\tflow+=dfs(S,inf,cost);\n\t\t}while (mark[T]);\n\treturn cost;\n}\n\nint main(){\n\tint n,m,k,c,d,lim=101;\n\tcin>>n>>m>>k>>c>>d;\n\tfor (int i=0;i<k;i++){\n\t\tint x; cin>>x; x--;\n\t\taddedge(S,x,1,0);\n\t}\n\tfor (int i=0;i<lim;i++)\n\t\taddedge(i*n,T,k,c*i);\n\tfor (int i=0;i<n;i++)\n\t\tfor (int j=0;j<lim-1;j++)\n\t\t\taddedge(i+j*n,i+(j+1)*n,k,0);\n\twhile (m--){\n\t\tint x,y; cin>>x>>y; x--,y--;\n\t\tfor (int i=0;i<lim-1;i++)\n\t\t\tfor (int j=k-1;j>=0;j--){\n\t\t\t\taddedge(x+i*n,y+(i+1)*n,1,d*(j<<1|1));\n\t\t\t\taddedge(y+i*n,x+(i+1)*n,1,d*(j<<1|1));\n\t\t\t}\n\t}\n\tcout<<costflow();\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int N = 10005;\n    static final int S = N - 2;\n    static final int T = N - 1;\n    static final int M = 2000010;\n    static final int inf = 2000000000;\n\n    static int[] head = new int[N];\n    static int[] to = new int[M];\n    static int[] nxt = new int[M];\n    static int[] w = new int[M];\n    static int[] c = new int[M];\n    static int cnt = 1;\n\n    static void addedge(int x, int y, int flow, int cost) {\n        cnt++;\n        to[cnt] = y;\n        nxt[cnt] = head[x];\n        head[x] = cnt;\n        w[cnt] = flow;\n        c[cnt] = cost;\n\n        cnt++;\n        to[cnt] = x;\n        nxt[cnt] = head[y];\n        head[y] = cnt;\n        w[cnt] = 0;\n        c[cnt] = -cost;\n    }\n\n    static Queue<Integer> q = new LinkedList<>();\n    static long[] dis = new long[N];\n    static boolean[] mark = new boolean[N];\n\n    static boolean spfa() {\n        Arrays.fill(mark, false);\n        Arrays.fill(dis, 0x3f3f3f3f3f3f3f3fL);\n        q.clear();\n        q.offer(T);\n        dis[T] = 0;\n        mark[T] = true;\n\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            mark[x] = false;\n            for (int i = head[x]; i != 0; i = nxt[i]) {\n                int y = to[i];\n                if (w[i ^ 1] > 0 && dis[y] > dis[x] + c[i ^ 1]) {\n                    dis[y] = dis[x] + c[i ^ 1];\n                    if (!mark[y]) {\n                        q.offer(y);\n                        mark[y] = true;\n                    }\n                }\n            }\n        }\n        return dis[S] < 1e18;\n    }\n\n    static int dfs(int x, int lim, long[] cost) {\n        int flow = 0;\n        mark[x] = true;\n        if (x == T) return lim;\n        for (int i = head[x]; i != 0; i = nxt[i]) {\n            int y = to[i];\n            if (w[i] == 0 || mark[y]) continue;\n            if (dis[x] != dis[y] + c[i]) continue;\n            int t = dfs(y, Math.min(w[i], lim - flow), cost);\n            w[i] -= t;\n            w[i ^ 1] += t;\n            flow += t;\n            cost[0] += (long) t * c[i];\n            if (flow == lim) return lim;\n        }\n        return flow;\n    }\n\n    static long costflow() {\n        int flow = 0;\n        long[] cost = new long[1];\n        while (spfa()) {\n            Arrays.fill(mark, false);\n            do {\n                Arrays.fill(mark, false);\n                flow += dfs(S, inf, cost);\n            } while (mark[T]);\n        }\n        return cost[0];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int lim = 101;\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            x--;\n            addedge(S, x, 1