lue = mul(value, a[j][g]);\n                    else\n                        value = mul(value, sub(1, a[j][g]));\n                }\n                for (Pair<List<Integer>, Integer> np : sets) {\n                    newSet.clear();\n                    for (int mask2 : np.first) {\n                        int possible = (~mask2) & mask;\n                        while (possible != 0) {\n                            int pos = possible & (-possible);\n                            newSet.add(mask2 | pos);\n                            possible ^= pos;\n                        }\n                    }\n                    if (newSet.isEmpty())\n                        continue;\n                    Collections.sort(newSet);\n                    // Remove duplicates\n                    int last = -1;\n                    List<Integer> uniqueSet = new ArrayList<>();\n                    for (int val : newSet) {\n                        if (val != last) {\n                            uniqueSet.add(val);\n                            last = val;\n                        }\n                    }\n                    newSets.add(new Pair<>(uniqueSet, mul(np.second, value)));\n                }\n            }\n            Collections.sort(newSets, (p1, p2) -> {\n                int size1 = p1.first.size();\n                int size2 = p2.first.size();\n                for (int i = 0; i < Math.min(size1, size2); i++) {\n                    int cmp = Integer.compare(p1.first.get(i), p2.first.get(i));\n                    if (cmp != 0)\n                        return cmp;\n                }\n                return Integer.compare(size1, size2);\n            });\n            sets.clear();\n            int i = 0;\n            while (i < newSets.size()) {\n                int j = i;\n                int sumVal = 0;\n                while (j < newSets.size() && newSets.get(j).first.equals(newSets.get(i).first)) {\n                    sumVal = add(sumVal, newSets.get(j).second);\n     