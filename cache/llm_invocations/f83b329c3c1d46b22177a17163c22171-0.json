level][K - 1], A[level][K - 1], K + 1)\n        for x in range(1, K):\n            P[level][x] = mul(P[level][x - 1], A[level][x], K + 1, K + 1, K + 1)\n        for x in range(K - 2, -1, -1):\n            S[level][x] = mul(A[level][x], S[level][x + 1], K + 1, K + 1, K + 1)\n        m *= K\n        if m > N // K:\n            break\n\n    return A, P, S\n\ndef main():\n    import sys\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n\n    Power = [1]\n    i = 1\n    while Power[i - 1] <= N // K:\n        Power.append(Power[i - 1] * K)\n        i += 1\n    ind = i - 1\n\n    A, P, S = precalcA(N, K)\n\n    Res = [[0] * (K + 1) for _ in range(K + 1)]\n    Res[0][K] = 1\n    init = N\n    ind2 = 0\n    for i in range(ind, -1, -1):\n        while Power[i] <= init:\n            Aux = mul(Res, A[i][ind2], K + 1, K + 1, K + 1)\n            copy_matrix(Res, Aux, K + 1)\n            ind2 += 1\n            if ind2 == K:\n                ind2 = 0\n            init -= Power[i]\n\n    ans = 0\n    for i in range(K + 1):\n        ans = add(ans, Res[0][i])\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95</confidence>", "token_logprobs": [-0.00021169328829273582, 0.0, -7.152555099310121e-07, -0.0011968599865213037, -0.3911341726779938, -2.145764938177308e-06, 0.0, -1.0013530300057027e-05, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.00043335105874575675, -3.516612196108326e-05, -0.024147100746631622, -0.00327313132584095, -4.9470632802695036e-05, 0.0, -6.913899414939806e-05, -2.50339189733495e-06, -4.351044481154531e-05, -1.5497195136049413e-06, -2.3841855067985307e-07, -6.198863957251888e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -5.483612312673358e-06, -0.00012420836719684303, -0.0007811117684468627, -0.00023052419419400394, 0.0, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.0001436368766007945, -3.099436753473128e-06, -7.15255509931012