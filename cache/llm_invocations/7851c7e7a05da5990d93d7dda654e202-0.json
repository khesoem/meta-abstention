{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int N = 5007;\nconst ll INF = 1e9;\nconst ll MOD = 1e9 + 7;\n\nstruct Edge {\n    int from, to;\n    ll cap, cost, flow;\n    Edge(int from, int to, ll cap, ll cost) : from(from), to(to), cap(cap), cost(cost), flow(0) {}\n};\n\nvector<Edge> Edges;\nvector<int> Adj[N];\nll Dist[N], Pot[N];\nint Parent[N];\n\nvoid AddEdge(int u, int v, ll cap, ll cost) {\n    Adj[u].push_back(Edges.size());\n    Edges.push_back({u, v, cap, cost});\n    Adj[v].push_back(Edges.size());\n    Edges.push_back({v, u, 0, -cost});\n}\n\nvoid FordBellman(int s, int n) {\n    fill(Pot, Pot + N, INF);\n    Pot[s] = 0;\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < (int)Edges.size(); j++) {\n            Edge &e = Edges[j];\n            if (e.cap == e.flow || Pot[e.from] == INF) continue;\n            Pot[e.to] = min(Pot[e.to], Pot[e.from] + e.cost);\n        }\n    }\n}\n\nvoid Dijkstra(int s) {\n    fill(Dist, Dist + N, INF);\n    Dist[s] = 0;\n    set<pair<ll, int>> Q;\n    Q.insert({0, s});\n    while (!Q.empty()) {\n        int v = Q.begin()->second;\n        Q.erase(Q.begin());\n        for (int i = 0; i < (int)Adj[v].size(); i++) {\n            int id = Adj[v][i];\n            Edge &e = Edges[id];\n            if (e.cap == e.flow) continue;\n            int to = e.to;\n            ll w = e.cost + Pot[v] - Pot[to];\n            if (Dist[v] + w < Dist[to]) {\n                Q.erase({Dist[to], to});\n                Dist[to] = Dist[v] + w;\n                Parent[to] = id;\n                Q.insert({Dist[to], to});\n            }\n        }\n    }\n}\n\npair<ll, ll> MCMF(int s, int t) {\n    FordBellman(s, 50);\n    Dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (true) {\n        if (Dist[t] == INF) break;\n        ll pushed = INF, sum = 0;\n        for (int v = t; v != s; v = Edges[Parent[v]].from) {\n            pushed = min(pushed, Edges[Parent[v]].cap - Edges[Parent[v]].flow);\n            sum += Edges[Parent[v]].cost;\n        }\n        flow += pushed;\n        cost += pushed * sum;\n        for (int v = t; v != s; v = Edges[Parent[v]].from) {\n            int id = Parent[v];\n            Edges[id].flow += pushed;\n            Edges[id ^ 1].flow -= pushed;\n        }\n        Dijkstra(s);\n        copy(Dist, Dist + N, Pot);\n    }\n    return {cost, flow};\n}\n\nvoid Solve() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnt(n, 0);\n    for (int i = 0; i < k; i++) {\n        int a;\n        cin >> a;\n        cnt[--a]++;\n    }\n    for (int i = 0; i < n; i++) AddEdge(5000, i, cnt[i], 0);\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        u--, v--;\n        for (int j = 0; j < 99; j++) {\n            ll cost = d;\n            for (int t = 0; t < 50; t++) {\n                AddEdge(u + j * 50, v + (j + 1) * 50, 1, cost);\n                AddEdge(v + j * 50, u + (j + 1) * 50, 1, cost);\n                cost += 2 * d;\n            }\n        }\n    }\n    for (int i = 0; i <= 99; i++) AddEdge(0 + i * 50, 5001, INF, c * i);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < 99; j++)\n            AddEdge(i + j * 50, i + (j + 1) * 50, INF, 0);\n    auto ans = MCMF(5000, 5001);\n    assert(ans.second == k);\n    cout << ans.first;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cout.tie(0);\n    cout << fixed << setprecision(20);\n    Solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\nN = 5002  # enough for source=5000, sink=5001, and nodes up to 4999\n\nedges = []  # list of [from, to, cap, cost, flow]\nadj = [[] for _ in range(N)]\npot = [INF] * N\ndist = [INF] * N\nparent = [-1] * N\n\ndef add_edge(u, v, cap, cost):\n    adj[u].append(len(edges))\n    edges.append([u, v, cap, cost, 0])\n    adj[v].append(len(edges))\n    edges.append([v, u, 0, -cost, 0])\n\ndef ford_bellman(s, n):\n    global pot\n    pot = [INF] * N\n    pot[s] = 0\n    for _ in range(n):\n        for e in edges:\n            if e[4] == e[2] or pot[e[0]] == INF:\n                continue\n            if pot[e[0]] + e[3] < pot[e[1]]:\n                pot[e[1]] = pot[e[0]] + e[3]\n\ndef dijkstra(s):\n    global dist, parent\n    dist = [INF] * N\n    dist[s] = 0\n    parent = [-1] * N\n    heap = [(0, s)]\n    while heap:\n        d, v = heapq.heappop(heap)\n        if d != dist[v]:\n            continue\n        for idx in adj[v]:\n            e = edges[idx]\n            if e[4] == e[2]:\n                continue\n            to = e[1]\n            w = e[3] + pot[v] - pot[to]\n            if dist[v] + w < dist[to]:\n                dist[to] = dist[v] + w\n                parent[to] = idx\n                heapq.heappush(heap, (dist[to], to))\n\ndef mcmf(s, t):\n    global pot, dist, parent\n    ford_bellman(s, 50)\n    dijkstra(s)\n    flow = 0\n    cost = 0\n    while dist[t] != INF:\n        pushed = INF\n        sum_cost = 0\n        v = t\n        while v != s:\n            e = edges[parent[v]]\n            pushed = min(pushed, e[2] - e[4])\n            sum_cost += e[3]\n            v = e[0]\n        flow += pushed\n        cost += pushed * sum_cost\n        v = t\n        while v != s:\n            idx = parent[v]\n            edges[idx][4] += pushed\n            edges[idx ^ 1][4] -= pushed\n            v = edges[idx][0]\n        dijkstra(s)\n        pot = dist[:]  # copy\n    return cost, flow\n\ndef solve():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    cnt = [0] * n\n    for _ in range(k):\n        a = next(it) - 1\n        cnt[a] += 1\n    # source edges\n    for i in range(n):\n        add_edge(5000, i, cnt[i], 0)\n    # original edges with time layers\n    for _ in range(m):\n        u = next(it) - 1\n        v = next(it) - 1\n        for j in range(99):\n            for t in range(50):\n                cost = d + 2 * d * t\n                add_edge(u + j * 50, v + (j + 1) * 50, 1, cost)\n                add_edge(v + j * 50, u + (j + 1) * 50, 1, cost)\n    # waiting edges to sink\n    for i in range(100):\n        add_edge(0 + i * 50, 5001, INF, c * i)\n    # stay edges\n    for i in range(n):\n        for j in range(99):\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n    ans_cost, ans_flow = mcmf(5000, 5001)\n    # assert ans_flow == k\n    sys.stdout.write(str(ans_cost))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.8530047681415454e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.0007668177131563425, -0.018216921016573906, -4.541770613286644e-05, -0.018152302131056786, -4.768370445162873e-07, -4.529942543740617e-06, -0.002481002826243639, -0.04937361925840378, -2.264974000354414e-06, -5.9604627722