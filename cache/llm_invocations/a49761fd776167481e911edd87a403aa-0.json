r (int idx = 2; idx <= n; ++idx) {\n        int limit = isqrt(idx) + 1;\n        long long cur = total;\n\n        int d = 2;\n        while (d < limit) {\n            cur = (cur + dp[idx / d]) % mod;\n            ++d;\n        }\n\n        int start = idx;\n        int k = 1;\n        while (k <= idx / limit) {\n            int end = idx / (k + 1);\n            cur = (cur + (start - end) * dp[k]) % mod;\n            start = end;\n            ++k;\n        }\n\n        total = (total + cur) % mod;\n        dp[idx] = cur;\n    }\n\n    cout << dp[n] << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0009167758980765939, -4.6491513785440475e-06, 0.0, -1.1920928244535389e-07, -0.00013100242358632386, -0.00034445550409145653, -1.1920928244535389e-07, -1.4305104514278355e-06, -8.940656698541716e-06, 0.0, 0.0, -1.1920928244535389e-07, -4.160317621426657e-05, -1.2993727978027891e-05, 0.0, -0.0005659647285938263, -0.5765202641487122, -0.2519308924674988, 0.0, -0.023250920698046684, -0.07892246544361115, -0.0009329734020866454, -4.172316494077677e-06, 0.0, -1.311301275563892e-06, -0.12016543745994568, -0.0900847390294075, 0.0, -7.712543447269127e-05, -0.00012337400403339416, -8.702239938429557e-06, -9.536738616588991e-07, -3.3378546504536644e-06, -0.07796458154916763, -0.0005789510905742645, 0.0, -0.08416829258203506, 0.0, -2.264974000354414e-06, -0.07944989949464798, -0.12836046516895294, -0.0003195490571670234, 0.0, -0.011075449176132679, -0.0005852655158378184, -0.2519357204437256, -0.4740777313709259, -1.1920928244535389e-07, -0.00025233422638848424, -1.0728830375228426e-06, -2.3841855067985307e-07, -3.576278118089249e-07, -2.9802276912960224e-06, -1.1920928244535389e-07, 0.0, -7.867782187531702e-06, -0.25198909640312195, -7.271740287251305e-06, 0.0, -1.1205610462639015e-05, -5.483612312673358e-06, -1.1920922133867862e-06, -0.00014423283573705703, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -2.50339189733495e-06, 0.0, -1