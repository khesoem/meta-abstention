 & 1) == 0) {\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (2 * n - 2)))] + 2);\n                }\n                if (col != n - 1 && ((mask >> (2 * n + 1)) & 1) == 0) {\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (2 * n)))] + 2);\n                }\n                if (col >= 2 && ((mask >> (n - 2)) & 1) == 0) {\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (n - 3)))] + 2);\n                }\n                if (col < n - 1 && ((mask >> (n + 2)) & 1) == 0) {\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (n + 1)))] + 2);\n                }\n                dp[idx(m, n, states, row, col, mask)] = val;\n            }\n        }\n    }\n    return dp[idx(m, n, states, 0, 0, 0)];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    long long a, b;\n    cin >> a >> b;\n    \n    if (a > b) {\n        long long t = a;\n        a = b;\n        b = t;\n    }\n    \n    long long ans;\n    if (a == 1) {\n        long long r = b % 6;\n        if (r <= 3) ans = b - r;\n        else if (r == 4) ans = b - 2;\n        else ans = b - 1;\n    } else if (a <= 5 && b <= 30) {\n        ans = solveSmall((int)a, (int)b);\n    } else {\n        ans = a * b - a * b % 2;\n    }\n    \n    cout << ans << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.074220174108632e-05, 0.0, -2.3841855067985307e-07, -0.00017975145601667464, -0.0003271759778726846, 0.0, -1.0728830375228426e-06, -1.1444026313256472e-05, 0.0, 0.0, -4.7444173105759546e-05, -1.4305104514278355e-06, 0.0, 0.0, -7.867782187531702e-06, -1.4305104514278355e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.38690608739852905, -0.00023112009512260556, -5.960462772236497e-07, 0.0, -8.4638240878121e-06, -0.18687543272972107, -0.014749296009540558, -2.2291887944447