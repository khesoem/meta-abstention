STATES];\nbool reachable[STATES];\n\nvoid solve() {\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 0; i < n; ++i) {\n        scanf(\" %s\", a + i * n); // read row into flattened array\n    }\n    for (int i = 0; i < n; ++i) {\n        scanf(\" %s\", b + i * n);\n    }\n    scanf(\"%d%d\", &sx, &sy);\n    for (int i = 0; i < n * n; ++i) {\n        if (a[i] == 'Z') {\n            sx = i / n;\n            sy = i % n;\n        }\n    }\n    bfsDist(id(sx, sy));\n\n    // Initialize dp[0]\n    for (int i = 0; i < n * n; ++i) {\n        if (digit(a[i])) {\n            int state = (i * n * n) + i; // (sx,sy,x,y) all same\n            dp[0][state] = true;\n        }\n    }\n\n    // DP transitions\n    for (int yt = 0; yt < t; ++yt) {\n        for (int state = 0; state < STATES; ++state) {\n            if (!dp[yt][state]) continue;\n            int s = state / (n * n);\n            int x = (state % (n * n)) / n;\n            int y = (state % (n * n)) % n;\n            if (dist[id(x, y)] <= yt) continue;\n            for (int k = 0; k < 4; ++k) {\n                int nx = x + dx[k], ny = y + dy[k];\n                if (nx >= 0 && nx < n && ny >= 0 && ny < n && digit(a[id(nx, ny)]) && dist[id(nx, ny)] >= yt + 1) {\n                    int nstate = s * n * n + id(nx, ny);\n                    dp[yt + 1][nstate] = true;\n                }\n            }\n        }\n    }\n\n    // Build reachable\n    for (int yt = 0; yt <= t; ++yt)\n        for (int s = 0; s < STATES; ++s)\n            if (dp[yt][s])\n                reachable[s] = true;\n\n    // Max flow graph\n    int V = 2 * n * n + 2;\n    int cap[V][V] = {};\n    // Source to first layer\n    for (int i = 0; i < n * n; ++i) {\n        if (digit(a[i]))\n            cap[0][i + 1] = a[i] - '0';\n    }\n    // Second layer to sink\n    for (int i = 0; i < n * n; ++i) {\n        if (digit(b[i]))\n            cap[n * n + i + 1][2 * n * n + 1] = b[i] - '0';\n    }\n    // Between layers\n    for (int i = 0; i < n * n; ++i) {\n        if (!digit(a[i])) continue;\n        for (int j = 0; j < n * n; ++j) {\n            if (!digit(a[j])) continue;\n            if (reachable[i * n * n + j])\n                cap[i + 1][n * n + j + 1] = INF;\n        }\n    }\n\n    // Ford-Fulkerson with BFS\n    int parent[V];\n    bool vis[V];\n    while (true) {\n        memset(vis, 0, sizeof(vis));\n        memset(parent, 0, sizeof(parent));\n        queue<int> q;\n        vis[0] = true;\n        q.push(0);\n        while (!q.empty()) {\n            int v = q.front(); q.pop();\n            if (v == 2 * n * n + 1) break;\n            for (int u = 0; u < V; ++u) {\n                if (cap[v][u] > 0 && !vis[u]) {\n                    vis[u] = true;\n                    parent[u] = v;\n                    q.push(u);\n                }\n            }\n        }\n        if (!vis[2 * n * n + 1]) break;\n        int flow = INF;\n        for (int v = 2 * n * n + 1; v; v = parent[v])\n            flow = min(flow, cap[parent[v]][v]);\n        for (int v = 2 * n * n + 1; v; v = parent[v]) {\n            cap[parent[v]][v] -= flow;\n            cap[v][parent[v]] += flow;\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i < V; ++i)\n        ans += cap[i][0];\n    printf(\"%d\\n\", ans);\n}\n\nint main() {\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int N = 12;\n    static final int INF = 1000000009;\n    static final int[] dx = {0, 1, 0, -1};\n    static final int[] dy = {1, 0, -1, 0};\n\n    static int n, t;\n    static char[] a, b; // flattened grids\n    static int sx, sy;\n    static int[] dist;\n\n    static int id(int x, int y) { return x * n + y; }\n    static boolean isDigit(char c) { return c >= '0' && c <= '9'; }\n\n    static void bfsDist(int start) {\n        dist = new int[n * n];\n 