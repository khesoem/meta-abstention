or<int> base(n);\n    for (int i = 0; i < n; i++) base[i] = i;\n    \n    vector<bool> used(n, false);\n    vector<int> q(n);\n    int qend = 0;\n    used[root] = true;\n    q[qend++] = root;\n    \n    for (int qbeg = 0; qbeg < qend; qbeg++) {\n        int u = q[qbeg];\n        for (int v : graph[u]) {\n            if (base[u] == base[v] || match[u] == v) continue;\n            if (v == root || (match[v] != -1 && prev[match[v]] != -1)) {\n                // Find LCA\n                vector<bool> used_lca(match.size(), false);\n                int a = u, b = v;\n                while (true) {\n                    a = base[a];\n                    used_lca[a] = true;\n                    if (match[a] == -1) break;\n                    a = prev[match[a]];\n                }\n                while (true) {\n                    b = base[b];\n                    if (used_lca[b]) {\n                        int cb = b;\n                        // Mark blossom\n                        vector<bool> blossom(n, false);\n                        // Path from u to cb\n                        for (int cur = u; base[cur] != cb; cur = prev[match[cur]]) {\n                            blossom[base[cur]] = true;\n                            blossom[base[match[cur]]] = true;\n                            prev[cur] = v;\n                            v = match[cur];\n                        }\n                        blossom[cb] = true;\n                        // Path from v to cb\n                        v = u; // reset v\n                        for (int cur = v; base[cur] != cb; cur = prev[match[cur]]) {\n                            blossom[base[cur]] = true;\n                            blossom[base[match[cur]]] = true;\n                            prev[cur] = u;\n                            u = match[cur];\n                        }\n                        blossom[cb] = true;\n                        \n                        for (int i = 0; i < n; i++) {\n                            if (blossom[base[i]]) {\n                                base[i] = cb;\n                                if (!used[i]) {\n                                    used[i] = true;\n                                    q[qend++] = i;\n                                }\n                            }\n                        }\n                        break;\n                    }\n                    b = prev[match[b]];\n                }\n            } else if (prev[v] == -1) {\n                prev[v] = u;\n                if (match[v] == -1) return v;\n                v = match[v];\n                used[v] = true;\n                q[qend++] = v;\n            }\n        }\n    }\n    return -1;\n}\n\nint findMaxMatching(vector<vector<int>>& graph) {\n    int n = graph.size();\n    vector<int> match(n, -1);\n    vector<int> prev(n);\n    \n    for (int i = 0; i < n; i++) {\n        if (match[i] == -1) {\n            int end = findPath(graph, match, prev, i);\n            while (end != -1) {\n                int p = prev[end];\n                int pp = match[p];\n                match[end] = p;\n                match[p] = end;\n                end = pp;\n            }\n        }\n    }\n    \n    int count = 0;\n    for (int x : match) {\n        if (x != -1) count++;\n    }\n    return count / 2;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    vector<string> parts;\n    string current = \"\";\n    for (char c : line) {\n        if (c == ' ' || c == '\\t' || c == '\\r') {\n            if (!current.empty()) {\n                parts.push_back(current);\n                current = \"\";\n            }\n        } else {\n            current += c;\n        }\n    }\n    if (!current.empty()) {\n        parts.push_back(current);\n    }\n    \n    int n = stoi(parts[0]);\n    int m = stoi(parts[1]);\n    \n    if (n > m) {\n        int temp = n;\n        n = m;\n        m = temp;\n    }\n\n    long long total = (long long)n * m;\n\n    if (total < 100) {\n        vector<vector<int>> adj(total);\n        \n        for (int i = 0; i < total; i++) {\n            for (int j = 0; j < total; j++) {\n                int r1 = i / m, c1 = i % m;\n                int r2 = j / m, c2 = j % m;\n                if (abs(r1 - r2) + abs(c1 - c2) == 3) {\n                    adj[i].push_back(j);\n                }\n            }\n        }\n\n        int count = findMaxMatching(adj);\n        cout << count * 2 << endl;\n    } else {\n        long long result;\n        if (n == 1) {\n            result = (m / 6) * 6 + ((m % 6 == 4) ? 2 : 0) + ((m % 6 == 5) ? 4 : 0);\n        } else {\n            result = (long long)n * m;\n            result -= result % 2;\n        }\n        cout << result << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-9.643566590966657e-05, -1.7881377516459906e-06, -1.0728830375228426e-06, -0.002017725957557559, -9.536738616588991e-07, -3.3378546504536644e-06, -3.576278118089249e-07, -4.6491513785440475e-06, -2.861018856492592e-06, -0.0012057899730280042, -2.3841855067985307e-07, -4.625213477993384e-05, -1.0728830375228426e-06, -0.3277053236961365, -5.006777428206988e-06, -5.364403477869928e-06, -5.960462772236497e-07, -0.007005059625953436, -4.768370445162873e-07, -9.298280929215252e-06, -2.264974000354414e-06, -0.43717098236083984, -0.0019293281948193908, -0.04859164357185364, -2.5033637939486653e-05, -0.322340726852417, -0.5759454369544983, -0.42880362272262573, -1.5258672647178173e-05, -2.3841830625315197e-06, -1.4305104514278355e-06, -0.04739553481340408, -0.16628077626228333, -0.02991853654384613, -0.07064416259527206, -0.00020632999076042324, 0.0, -8.082063141046092e-05, -7.152531907195225e-06, 0.0, -1.597391747054644e-05, -7.152555099310121e-07, -7.152555099310121e-07, -2.0265558760002023e-06, -1.1920928244535389e-07, -4.2437604861333966e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -6.9141146923357155e-06, -0.0007135705673135817, -0.0232