{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\n<your_rewritten_code_5>\nimport java.io.*;\nimport java.util.*;\nimport java.util.stream.IntStream;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] parts = br.readLine().trim().split(\"\\\\s+\");\n        int n = Integer.parseInt(parts[0]);\n        int m = Integer.parseInt(parts[1]);\n        \n        if (n > m) {\n            int temp = n;\n            n = m;\n            m = temp;\n        }\n\n        long total = (long) n * m;\n\n        if (total < 100) {\n            List<Integer>[] adj = new List[(int) total];\n            for (int i = 0; i < total; i++) {\n                adj[i] = new ArrayList<>();\n            }\n            \n            for (int i = 0; i < total; i++) {\n                for (int j = 0; j < total; j++) {\n                    int r1 = i / m, c1 = i % m;\n                    int r2 = j / m, c2 = j % m;\n                    if (Math.abs(r1 - r2) + Math.abs(c1 - c2) == 3) {\n                        adj[i].add(j);\n                    }\n                }\n            }\n\n            int count = findMaxMatching(adj);\n            System.out.println(count * 2);\n        } else {\n            long result;\n            if (n == 1) {\n                result = m / 6 * 6 + (m % 6 == 4 ? 2 : 0) + (m % 6 == 5 ? 4 : 0);\n            } else {\n                result = (long) n * m;\n                result -= result % 2;\n            }\n            System.out.println(result);\n        }\n    }\n\n    private static int findMaxMatching(List<Integer>[] graph) {\n        int n = graph.length;\n        int[] match = new int[n];\n        Arrays.fill(match, -1);\n        int[] prev = new int[n];\n        \n        for (int i = 0; i < n; i++) {\n            if (match[i] == -1) {\n                int end = findPath(graph, match, prev, i);\n                while (end != -1) {\n                    int p = prev[end];\n                    int pp = match[p];\n                    match[end] = p;\n                    match[p] = end;\n                    end = pp;\n                }\n            }\n        }\n        \n        return (int) Arrays.stream(match).filter(x -> x != -1).count() / 2;\n    }\n\n    private static int findPath(List<Integer>[] graph, int[] match, int[] prev, int root) {\n        Arrays.fill(prev, -1);\n        int n = graph.length;\n        int[] base = IntStream.range(0, n).toArray();\n        \n        boolean[] used = new boolean[n];\n        int[] q = new int[n];\n        int qend = 0;\n        used[root] = true;\n        q[qend++] = root;\n        \n        for (int qbeg = 0; qbeg < qend; qbeg++) {\n            int u = q[qbeg];\n            for (int v : graph[u]) {\n                if (base[u] == base[v] || match[u] == v) continue;\n                if (v == root || match[v] != -1 && prev[match[v]] != -1) {\n                    int cb = lca(match, base, prev, u, v);\n                    boolean[] blossom = new boolean[n];\n                    markPath(match, base, blossom, prev, u, cb, v);\