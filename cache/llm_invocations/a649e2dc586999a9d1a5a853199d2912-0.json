es, row, col, mask)] = dp[idx(m, n, states, row, col + 1, mask >> 1)]\n                    continue\n                val = dp[idx(m, n, states, row, col + 1, mask >> 1)]\n                # Place vertical domino (2x1) covering current cell and cell below\n                val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (3 * n - 1)))] + 2)\n                # Place horizontal domino (1x2) to the left (col-1, col)\n                if col != 0 and ((mask >> (2 * n - 1)) & 1) == 0:\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (2 * n - 2)))] + 2)\n                # Place horizontal domino to the right (col, col+1)\n                if col != n - 1 and ((mask >> (2 * n + 1)) & 1) == 0:\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (2 * n)))] + 2)\n                # Place L-shaped? Actually these are for placing dominoes in other orientations? The original code has these conditions.\n                # They correspond to placing a domino that covers two cells in the same row but with offset? Let's keep as is.\n                if col >= 2 and ((mask >> (n - 2)) & 1) == 0:\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (n - 3)))] + 2)\n                if col < n - 1 and ((mask >> (n + 2)) & 1) == 0:\n                    val = max(val, dp[idx(m, n, states, row, col + 1, (mask >> 1) + (1 << (n + 1)))] + 2)\n                dp[idx(m, n, states, row, col, mask)] = val\n    return dp[idx(m, n, states, 0, 0, 0)]\n\ndef main():\n    a = read_int()\n    b = read_int()\n    if a > b:\n        a, b = b, a\n    if a == 1:\n        r = b % 6\n        if r <= 3:\n            ans = b - r\n        elif r == 4:\n            ans = b - 2\n        else:\n            ans = b - 1\n    elif a <= 5 and b <= 30:\n        ans = solve_small(a, b)\n    else:\n        ans = a * b - (a * b) % 2\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\