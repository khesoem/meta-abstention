n        if (src == dst)\n            adj[src].back().rev++;\n        adj[dst].push_back({dst, src, adj[src].size() - 1, 0, 0, -cost});\n    }\n    vector<cost_type> potential;\n    inline cost_type rcost(const edge &e)\n    {\n        return e.cost + potential[e.src] - potential[e.dst];\n    }\n\n//    void bellman_ford(int source)\n//    {\n//        for (int k = 0; k < n; ++k)\n//            for (int u = 0; u < n; ++u)\n//                for (edge &e : adj[u])\n//                    if (e.cap > 0 && rcost(e) < 0)\n//                        potential[e.dst] += rcost(e);\n//    }\n    const cost_type oo = numeric_limits<cost_type>::max();\n    vector<cost_type> dist;\n    vector<edge * > back;\n    cost_type dijkstra(int source, int sink)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> node;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        for (pq.push({dist[source] = 0, source}); !pq.empty();)\n        {\n            node p = pq.top();\n            pq.pop();\n            if (dist[p.second] < p.first)\n                continue;\n            if (p.second == sink)\n                break;\n            for (edge &e : adj[p.second])\n                if (e.flow < e.cap &&\n                        dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({\n                        dist[e.dst] = dist[e.src] + rcost(e),\n                        e.dst\n                    });\n                }\n        }\n        return dist[sink];\n    }\n    pair<flow_type, cost_type> max_flow(int source, int sink)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        back.assign(n, nullptr);\n//        bellman_ford(source); // remove negative costs\n        while (dijkstra(source, sink) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n            if (dist[u] < dist[sink])\n                potential[u] += dist[u] - dist[sink];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (edge * e = back[sink]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (edge * e = back[sink]; e; e = back[e->src])\n                e->flow += f, adj[e->dst][e->rev].flow -= f;\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n\n    int n,m,k,c,d,u,v;\n    cin >> n >> m >> k >> c >> d;\n    min_cost_max_flow<int,int> g((n+2)*102);\n    for(int i=0;i<102;i++)\n        g.add_edge((i*(n+2))+1,i*(n+2),100,(i*c));\n    for(int i=0;i<101;i++)\n        for(int j=0;j<n+1;j++)\n            g.add_edge(j+(i*(n+2)),j+((i+1)*(n+2)),100,0);\n    for(int i=0;i<k;i++)\n    {\n        cin >> u;\n        g.add_edge(n+1,u,1,0);\n    }\n\n    for(int i=0;i<m;i++)\n    {\n        cin >> u >> v;\n        for(int j=0;j<101;j++)\n            for(int f=0;f<k;f++)\n            {\n                g.add_edge(u+(j*(n+2)),v+((j+1)*(n+2)),1,((2*f)+1)*d);\n                g.add_edge(v+(j*(n+2)),u+((j+1)*(n+2)),1,((2*f)+1)*d);\n            }\n    }\n\n    db(g.max_flow(n+1,(101*(n+2))).second)\n\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MinCostMaxFlow:\n    class Edge:\n        __slots__ = ('src', 'dst', 'rev', 'flow', 'cap', 'cost')\n        def __init__(self, src, dst, rev, flow, cap, cost):\n            self.src = src\n            self.dst = dst\n            self.rev = rev\n            self.flow = flow\n            self.cap = cap\n            self.cost = cost\n\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.potential = [0] * n\n        self.dist = [0] * n\n        self.back = [None] * n\n\n    def add_edge(self, src, dst, cap, cost):\n        self.adj[src].append(self.Edge(src, dst, len(self.adj[dst]), 0, cap, cost))\n        if src == dst:\n            self.adj[src][-1].rev += 1\n        self.adj[dst].append(self.Edge(dst, src, len(self.adj[src]) - 1, 0, 0, -cost))\n\n    def rcost(self, e):\n        return e.cost + self.potential[e.src] - self.potential[e.dst]\n\n    def dijkstra(self, source, sink):\n        oo = 10**18\n        self.dist = [oo] * self.n\n        self.back = [None] * self.n\n        pq = [(0, source)]\n        self.dist[source] = 0\n        while pq:\n            d, u = heapq.heappop(pq)\n            if self.dist[u] < d:\n                continue\n            if u == sink:\n                break\n            for e in self.adj[u]:\n                if e.flow < e.cap and self.dist[e.dst] > self.dist[e.src] + self.rcost(e):\n                    self.dist[e.dst] = self.dist[e.src] + self.rcost(e)\n                    self.back[e.dst] = e\n                    heapq.heappush(pq, (self.dist[e.dst], e.dst))\n        return self.dist[sink]\n\n    def max_flow(self, source, sink):\n        flow = 0\n        cost = 0\n        for u in range(self.n):\n            for e in self.adj[u]:\n                e.flow = 0\n        self.potential = [0] * self.n\n        oo = 10**18\n        while True:\n            d = self.dijkstra(source, sink)\n            if d >= oo:\n                break\n            for u in range(self.n):\n                if self.dist[u] < self.dist[sink]:\n                    self.potential[u] += self.dist[u] - self.dist[sink]\n            f = 10**18\n            e = self.back[sink]\n            while e is not None:\n                f = min(f, e.cap - e.flow)\n                e = self.back[e.src]\n            e = self.back[sink]\n            while e is not None:\n                e.flow += f\n                self.adj[e.dst][e.rev].flow -= f\n                e = self.back[e.src]\n            flow += f\n            cost += f * (self.potential[sink] - self.potential[source])\n        return (flow, cost)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    total_nodes = (n + 2) * 102\n    g = MinCostMaxFlow(total_nodes)\n    # waiting edges (cost per time)\n    for i in range(102):\n        src = i * (n + 2) + 1\n        dst = i * (n + 2)\n        g.add_edge(src, dst, 100, i * c)\n    # stay edges (zero cost)\n    for i in range(101):\n        for j in range(n + 1):\n            src = j + i * (n + 2)\n            dst = j + (i + 1) * (n + 2)\n            g.add_edge(src, dst, 100, 0)\n    # initial positions\n    for _ in range(k):\n        u = int(next(it))\n        g.add_edge(n + 1, u, 1, 0)\n    # movement edges\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(101):\n            for f in range(k):\n                cost_val = ((2 * f) + 1) * d\n                g.add_edge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, cost_val)\n                g.add_edge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, cost_val)\n    source = n + 1\n    sink = 101 * (n + 2)\n    result = g.max_flow(source, sink)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.0636318115284666e-05, 0.0, 0.0, -0.00013243274588603526, -0.006747201085090637, -3.540453326422721e-05, -0.0012453190283849835, -0.0005532164941541851, -0.000337305391440168, -0.038055989891290665, -0.00045372682507149875, -0.386935293674469, 0.0, -2.3841855067985307e-07, 0.0, -8.344646857949556e-07, -2.3841855067985307e-07, -0.6934331059455872, -1.4305104514278355e-06, -3.576278118089249e-0