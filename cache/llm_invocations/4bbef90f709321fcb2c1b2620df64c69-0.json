t)) && !(prevMask & (1 << bit))) {\n                    nxt |= 1ULL << id[prevMask | (1 << bit)];\n                }\n            }\n        }\n        res = (res + 1LL * f[pos][mask] * dfs(pos + 1, nxt)) % MOD;\n    }\n    \n    return memo[key] = res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n;\n    int inv100 = modPow(100, MOD - 2);\n    \n    for (int i = 0; i < n; ++i) {\n        f[i][0] = 1;\n        for (int j = 0; j < n; ++j) {\n            int P;\n            cin >> P;\n            int p1 = (1LL * P * inv100) % MOD;\n            int p0 = (1 + MOD - p1) % MOD;\n            for (int k = 0; k < (1 << j); ++k) {\n                f[i][k | (1 << j)] = (1LL * f[i][k] * p1) % MOD;\n                f[i][k] = (1LL * f[i][k] * p0) % MOD;\n            }\n        }\n    }\n    \n    for (int i = 0; i < (1 << n); ++i) {\n        cnt[i] = __builtin_popcount(i);\n    }\n    \n    for (int i = 0; i < (1 << n); ++i) {\n        vec[cnt[i]].push_back(i);\n        id[i] = vec[cnt[i]].size() - 1;\n    }\n    \n    cout << dfs(0, 1) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static int n, S;\n    static int[] cnt = new int[250];\n    static int[] id = new int[250];\n    static int[][] f = new int[10][250];\n    static List<Integer>[] vec = new List[10];\n    static Map<Long, Integer> memo = new HashMap<>();\n\n    static long modPow(long b, long e) {\n        long r = 1;\n        b %= MOD;\n        while (e > 0) {\n            if ((e & 1) == 1) r = (r * b) % MOD;\n            b = (b * b) % MOD;\n            e >>= 1;\n        }\n        return r;\n    }\n\n    static int dfs(int pos, long state) {\n        if (state == 0) return 0;\n        if (pos == n) return 1;\n        \n   