r[k][i] + 1, arr[k][i] + tn[i] + 1, V - v) - arr[k][i]) + 1) % X;\n    }\n    for (int i = 0; i <= k; ++i) p += tn[i];\n}\nint main() {\n    scanf(\"%lld\", &n);\n    tn[0] = 1;\n    for (int i = 1; i <= 6; ++i) tn[i] = tn[i-1] * 10;\n    for (int k = 0; k <= 6; ++k) {\n        p = 0;\n        build(0, 0, k);\n        for (int i = 0; i <= k; ++i) sort(arr[k][i] + 1, arr[k][i] + tn[i] + 1);\n    }\n    p = 0;\n    if (n < 1000000) {\n        for (int d = 1; d <= 9; ++d) brute_force(d, 1);\n    } else {\n        nn = n;\n        while (nn >= 1000000) nn /= 10;\n        for (int d = 1; d <= 9; ++d) process(d, 1);\n    }\n    printf(\"%d\\n\", (int)((ll)(X - ans) * V % X));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nV = 998244353\nX = 1000000007\nSZ = 1000000\n\ntn = [1] * 7\nfor i in range(1, 7):\n    tn[i] = tn[i-1] * 10\n\narr = [[[] for _ in range(7)] for _ in range(7)]\n\np = 0\nans = 0\nn = 0\nnn = 0\n\ndef build(x, l, k):\n    global p, arr\n    p += 1\n    arr[k][l].append(p - x)\n    if l == k:\n        return\n    for d in range(10):\n        build(x * 10 + d, l + 1, k)\n\ndef brute_force(x, l):\n    global p, ans, n\n    if x > n:\n        return\n    p += 1\n    term = (p - x) // V - (1 if p < x else 0) + X\n    ans = (ans + term) % X\n    for d in range(10):\n        brute_force(x * 10 + d, l + 1)\n\ndef process(x, l):\n    global p, ans, n, nn, arr\n    if l != 6:\n        p += 1\n        term = (p - x) // V - (1 if p < x else 0) + X\n        ans = (ans + term) % X\n        for d in range(10):\n            process(x * 10 + d, l + 1)\n        return\n    if x == nn:\n        brute_force(x, 0)\n        return\n    k = 0\n    v = x\n    while k <= 6 and v <= n:\n        k += 1\n        v *= 10\n    k -= 1\n    for i in range(k + 1):\n        v = p - x * tn[i]\n        term = (v // V - (1 if