      stirling[i][i] = 1;\n            }\n            for (int i = 2; i < 5001; i++) {\n                for (int j = 1; j < i; j++) {\n                    stirling[i][j] = add(multiply(stirling[i-1][j], i-1), stirling[i-1][j-1]);\n                }\n            }\n        }\n\n        public void solve(Scanner sc, PrintWriter pw) throws IOException {\n            computeStirling();\n            int n = sc.nextInt();\n            int m = sc.nextInt();\n            int k = sc.nextInt();\n            \n            int invM = BigInteger.valueOf(m).modInverse(BigInteger.valueOf(MOD)).intValue();\n            \n            int[] pValues = new int[5001];\n            pValues[0] = 1;\n            int remaining = n;\n            int power = 1;\n            \n            for (int i = 1; i <= k; i++) {\n                power = multiply(power, remaining, invM);\n                remaining = add(remaining, MOD - 1);\n                \n                int temp = power;\n                for (int j = i-1; j >= 1; j--) {\n                    int term = multiply(stirling[i][j], pValues[j]);\n                    if ((i - j) % 2 == 1) {\n                        temp = add(temp, term);\n                    } else {\n                        temp = add(temp, MOD - term);\n                    }\n                }\n                pValues[i] = temp;\n            }\n            \n            pw.println(pValues[k]);\n        }\n    }\n\n    private static long startTime, endTime;\n\n    public static void main(String[] args) throws IOException {\n        Scanner sc = new Scanner(System.in);\n        PrintWriter pw = new PrintWriter(new BufferedOutputStream(System.out));\n\n        Runtime rt = Runtime.getRuntime();\n        long memBefore = rt.totalMemory() - rt.freeMemory();\n        startTime = System.currentTimeMillis();\n        \n        Task solver = new Task();\n        solver.solve(sc, pw);\n        \n        endTime = System.currentTimeMillis();\n        long memAfter = rt.totalMemory