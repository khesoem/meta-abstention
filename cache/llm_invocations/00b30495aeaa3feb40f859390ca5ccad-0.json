for j in range(1, n+1):\n            if s[i][j] == 'Z' or s[i][j] == 'Y':\n                sc[i][j] = -1\n                ir[i][j] = 0\n            if s[i][j] == 'Z':\n                rx, ry = i, j\n                ir[i][j] = 0\n            if '0' <= s[i][j] <= '9':\n                sc[i][j] = ord(s[i][j]) - ord('0')\n            for k in range(sc[i][j]):\n                ns[i][j].append(sp)\n                sp += 1\n    \n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '0' <= p[i][j] <= '9':\n                pc[i][j] = ord(p[i][j]) - ord('0')\n            for k in range(pc[i][j]):\n                np[i][j].append(pp)\n                pp += 1\n    \n    q = deque()\n    q.append((rx, ry))\n    while q:\n        rx, ry = q.popleft()\n        for d in range(4):\n            nx = rx + dx[d]\n            ny = ry + dy[d]\n            if ir[nx][ny] > ir[rx][ry] + 1 and sc[nx][ny] != -1:\n                ir[nx][ny] = ir[rx][ry] + 1\n                q.append((nx, ny))\n    \n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if sc[i][j] > 0:\n                wk(i, j)\n    \n    print(hkp())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00013684290752280504, -1.1920922133867862e-06, -4.768370445162873e-07, -0.12794256210327148, -0.0062363785691559315, -1.6689286894688848e-06, -5.6622808187967166e-05, -6.305972783593461e-05, -5.960462772236497e-07, -0.0003393312799744308, -0.002868587151169777, -0.002984951948747039, -0.019682925194501877, -7.152555099310121e-07, -1.311301275563892e-06, -0.006567205302417278, -0.22959935665130615, -1.6093124941107817e-05, -1.0251946150674485e-05, -0.01113698910921812, -0.0014698426239192486, -2.145764938177308e-06, -0.00010501786891836673, -1.1920928244535389e-07, -3.397406908334233e-05, -2.3841830625315197e-06, -0.0010368215152993798, -0.2086065411567688, -0.22541756927967072, -5.960462772236497e-07, -0.05252426490