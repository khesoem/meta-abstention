i)\n\t\tA[0].a[1][i] = 1;\n\n\tvector<int> V;\n\tfor (int len = 0; n; V.push_back(n % k), n /= k) {\n\t\tMatrix x = A[len]; A[++ len].Unit(k + 1);\n\t\tfor (ll power = k, p = 0; power; power >>= 1) {\n\t\t\tif (power & 1) A[len] = multiply(A[len], Move(x, (power ^ 1) << p));\n\t\t\tx = multiply(Move(x, 1 << p), x); ++ p;\n\t\t}\n\t}\n\n\tint step = 0; ans[k + 1] = 1;\n\n\tfor (int T = (int)V.size() - 1; T >= 0; --T) {\n\t\tint cur = V[T];\n\t\tif (cur) {\n\t\t\tstatic int tmp[K];\n\t\t\tfor (int times = 0; times < cur; ++times) {\n\t\t\t\tfor (int i = 1; i <= k + 1; ++i) tmp[i] = ans[i], ans[i] = 0;\n\t\t\t\tMatrix B = Move(A[T], times + step);\n\t\t\t\tfor (int i = 1; i <= k + 1; ++i)\n\t\t\t\t\tfor (int j = 1; j <= k + 1; ++j)\n\t\t\t\t\t\tans[i] = (ans[i] + 1ll * tmp[j] * B.a[i][j]) % Mod;\n\t\t\t}\n\t\t}\n\t\tstep += cur;\n\t}\n\n\tint res = 0;\n\tfor (int i = 1; i <= k + 1; ++i) (res += ans[i]) %= Mod;\n\tprintf(\"%d\\n\", res);\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n = int(data[0])\n    k = int(data[1])\n    \n    K = 105\n    Mod = 1000000007\n\n    def id_func(x, step):\n        return ((x + step - 1) % k + 1) if x <= k else x\n\n    class Matrix:\n        def __init__(self):\n            self.a = [[0] * (K + 1) for _ in range(K + 1)]\n        \n        def Unit(self, length):\n            for i in range(1, length + 1):\n                self.a[i][i] = 1\n\n    def move_matrix(base, step):\n        step %= k\n        res = Matrix()\n        for i in range(1, k + 2):\n            for j in range(1, k + 2):\n                res.a[id_func(i, step)][id_func(j, step)] = base.a[i][j]\n        return res\n\n    def multiply_matrices(lhs, rhs):\n        res = Matrix()\n        for i in range(1, k + 2):\n            for kk in range(1, k + 2):\