            half = length // 2\n                for j in range(0, m, length):\n                    for k in range(half):\n                        a[t][j + k + half] += a[t][j + k]\n                length //= 2\n            for j in range(m):\n                a[t][j] %= P\n\n    def inverse_zeta_transform(a, rows):\n        for t in range(rows + 1):\n            length = 2\n            while length <= m:\n                half = length // 2\n                for j in range(0, m, length):\n                    for k in range(half):\n                        a[t][j + k + half] -= a[t][j + k]\n                length <<= 1\n            for j in range(m):\n                a[t][j] = (a[t][j] % P + P) % P\n\n    zeta_transform(suma, n)\n\n    # dp = copy of suma\n    dp = [row[:] for row in suma]\n\n    # helper functions for exponentiation\n    def square_dp():\n        nonlocal dp\n        tmp = [[0] * m for _ in range(n + 1)]\n        for a in range(n + 1):\n            for b in range(n + 1 - a):\n                f = tmp[a + b]\n                g = dp[a]\n                h = dp[b]\n                for j in range(m):\n                    f[j] += g[j] * h[j]\n        for t in range(n + 1):\n            for j in range(m):\n                dp[t][j] = tmp[t][j] % P\n\n    def multiply_by_suma():\n        nonlocal dp\n        tmp = [[0] * m for _ in range(n + 1)]\n        for a in range(n + 1):\n            for b in range(n + 1 - a):\n                f = tmp[a + b]\n                g = dp[a]\n                h = suma[b]\n                for j in range(m):\n                    f[j] += g[j] * h[j]\n        for t in range(n + 1):\n            for j in range(m):\n                dp[t][j] = tmp[t][j] % P\n\n    # binary exponentiation on reversed bits of K\n    revK = 0\n    cc = 0\n    tempK = K\n    while tempK:\n        revK = (revK << 1) | (tempK & 1)\n        cc += 1\n        tempK >>= 1\n    revK >>= 1\n    cc -= 1\n    while cc:\n        square_dp()\n        if revK & 1:\n      