mask = (1<<e1[1]) | (1<<e2[1]) | (1<<e3[1])\n                    if k == 1:\n                        right_mask ^= 126  # 126 = (1<<1)|...|(1<<6)\n                    contrib = maska[right_mask]\n                    triple_mask = (1<<a) | (1<<b) | (1<<c)\n                    res[triple_mask] |= contrib\n        # SOS DP for OR over 18 bits\n        for bit in range(18):\n            step = 1 << bit\n            for mask in range(size):\n                if mask & step:\n                    res[mask] |= res[mask ^ step]\n        daj_res[k] = res\n\n    # dp arrays: two lists of length 1<<20\n    dp0 = [0] * (1<<20)\n    dp1 = [0] * (1<<20)\n\n    for k in (0, 1):\n        edges = kraw[k*18 : (k+1)*18]\n        daj = daj_res[k]\n        size = 1 << 18\n        for mask in range(size):\n            p = 1\n            # compute probability for this subset\n            for j in range(18):\n                edge = edges[j]\n                if (mask >> j) & 1:\n                    p = p * tab[edge[0]][edge[1]] % MOD * odw % MOD\n                else:\n                    p = p * (100 - tab[edge[0]][edge[1]]) % MOD * odw % MOD\n            cur = daj[mask]\n            if k == 0:\n                dp0[cur] = (dp0[cur] + p) % MOD\n            else:\n                dp1[cur] = (dp1[cur] + p) % MOD\n\n    # SOS DP on dp0 (sum over submasks)\n    for bit in range(20):\n        step = 1 << bit\n        for mask in range(1<<20):\n            if mask & step:\n                dp0[mask] = (dp0[mask] + dp0[mask ^ step]) % MOD\n\n    full = (1<<20) - 1\n    res = 1\n    for i in range(1<<20):\n        res = (res - dp0[i] * dp1[full ^ i]) % MOD\n    res = (res + MOD) % MOD\n    sys.stdout.write(str(res))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.3589766240329482e-05, 0.0, -4.768370445162873e-07, -0.0011928117601200938, -0.002503001829609275, 0.0, -0.0024852838832885027, -0.026612747460603714, -2.3841855067985