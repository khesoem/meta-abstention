{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing frac = pair<ll, ll>;\n\nfrac diff_abs(frac a, frac b) {\n    ll common = lcm(a.second, b.second);\n    ll na = a.first * (common / a.second);\n    ll nb = b.first * (common / b.second);\n    ll d = na - nb;\n    if (d < 0) d = -d;\n    ll g = gcd(d, common);\n    return {d / g, common / g};\n}\n\nint cmp_frac(frac a, frac b) {\n    ll common = lcm(a.second, b.second);\n    ll na = a.first * (common / a.second);\n    ll nb = b.first * (common / b.second);\n    if (na == nb) return 0;\n    return na < nb ? -1 : 1;\n}\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n\n    ll x, y, n;\n    cin >> x >> y >> n;\n\n    ll g = gcd(x, y);\n    x /= g;\n    y /= g;\n\n    frac target = {x, y};\n    frac bestDiff = {1000000000000LL, 1};\n    frac best = {0, 0};\n\n    for (ll den = 1; den <= n; ++den) {\n        ll left = 0;\n        double limit = (double)x / (double)y;\n        limit += (double)bestDiff.first / (double)bestDiff.second;\n        ll right = (ll)((limit + 2.0) * (double)den);\n\n        while (left <= right) {\n            ll mid = left + (right - left) / 2;\n            frac candidate = {mid, den};\n            frac curDiff = diff_abs(target, candidate);\n\n            int comparison = cmp_frac(curDiff, bestDiff);\n            if (comparison == 0) {\n                if (candidate.second < best.second ||\n                    (candidate.second == best.second && candidate.first < best.first)) {\n                    best = candidate;\n                }\n            } else if (comparison < 0) {\n                bestDiff = curDiff;\n                best = candidate;\n            }\n\n            if (cmp_frac(candidate, target) < 0)\n                left = mid + 1;\n            else\n                right = mid - 1;\n        }\n    }\n\n    cout << best.first << \"/\" << best.second;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef lcm(a, b):\n    return a // math.gcd(a, b) * b\n\ndef diff_abs(a, b):\n    # a and b are tuples (num, den)\n    common = lcm(a[1], b[1])\n    na = a[0] * (common // a[1])\n    nb = b[0] * (common // b[1])\n    d = abs(na - nb)\n    g = math.gcd(d, common)\n    return (d // g, common // g)\n\ndef cmp_frac(a, b):\n    common = lcm(a[1], b[1])\n    na = a[0] * (common // a[1])\n    nb = b[0] * (common // b[1])\n    if na == nb:\n        return 0\n    return -1 if na < nb else 1\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, n = map(int, data[:3])\n    g = math.gcd(x, y)\n    x //= g\n    y //= g\n    target = (x, y)\n    bestDiff = (10**12, 1)\n    best = (0, 0)\n\n    for den in range(1, n + 1):\n        left = 0\n        # compute right bound using float (as in original C++ code)\n        limit = x / y + bestDiff[0] / bestDiff[1] + 2.0\n        right = int(limit * den)\n        while left <= right:\n            mid = (left + right) // 2\n            candidate = (mid, den)\n            curDiff = diff_abs(target, candidate)\n            comp = cmp_frac(curDiff, bestDiff)\n            if comp == 0:\n                if candidate[1] < best[1] or (candidate[1] == best[1] and candidate[0] < best[0]):\n                    best = candidate\n            elif comp < 0:\n                bestDiff = curDiff\n                best = candidate\n            if cmp_frac(candidate, target) < 0:\n                left = mid + 1\n            else:\n                right = mid - 1\n\n    print(f\"{best[0]}/{best[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -0.0005545270396396518, -0.00018523407925385982, -0.4740769863128662, -0.0019328974885866046, -0.00015853578224778175, 0.0, -0.003181992331519723, -0.0010147904977202415, -0.7629069089889526, 0.0, -6.9141146923357155e-06, -0.018164126202464104, 0.0, -1.728519782773219e-05, -1.1920928244535389e-07, -6.69933797325939e-05, -1.0490362910786644e-05, -0.04858766868710518, -1.1920928244535389e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.9802276912960224e-06, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.018414728343486786, -4.291525328881107e-06, -0.00033766290289349854, 0.0, -1.1920928244535389e-07, -0.00037651124875992537, -2.706014311115723e-05, 0.0, -8.689979586051777e-05, -7.152555099310121e-07, -0.7001804113388062, -0.0001641377166379243, -0.10810016840696335, -2.3841855067985307e-07, -2.5510462364763953e-05, -0.003967035561800003, -5.125986263010418e-06, -0.004205906298011541, -1.1920928244535389e-07, -3.2186455882765586e-06, -0.00021681819634977728, 0.0, -0.0012025751639157534, -7.152555099310121e-07, -3.814689989667386e-06, -1.1920928244535389e-07, -2.622600959512056e-06, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -2.4318