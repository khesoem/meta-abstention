ng nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n    }\n\n    public static void main(String[] args) {\n        FastScanner in = new FastScanner(System.in);\n        int n = in.nextInt();\n        int B = in.nextInt();\n\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = in.nextInt();\n        }\n\n        int even = 0, odd = 0;\n        List<Integer> diffs = new ArrayList<>();\n        for (int i = 0; i < n - 1; i++) {\n            if (a[i] % 2 == 0) even++;\n            else odd++;\n            if (even == odd) {\n                diffs.add(Math.abs(a[i] - a[i + 1]));\n            }\n        }\n\n        Collections.sort(diffs);\n        int count = 0;\n        for (int diff : diffs) {\n            if (B < diff) break;\n            B -= diff;\n            count++;\n        }\n        System.out.println(count);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass FastScanner:\n    def __init__(self, f):\n        if isinstance(f, str):\n            try:\n                self.br = open(f, 'r')\n            except FileNotFoundError:\n                raise\n        else:\n            self.br = sys.stdin\n            \n        self.line_queue = deque()\n    \n    def nextLine(self):\n        try:\n            if self.line_queue:\n                return self.line_queue.popleft()\n            return self.br.readline().rstrip('\\n\\r')\n        except Exception:\n            return None\n    \n    def next(self):\n        while not self.line_queue or not self.line_queue[0]:\n            line = self.br.readline()\n            if not line:\n                return None\n            self.line_queue.extend(line.strip().split())\n        return self.line_queu