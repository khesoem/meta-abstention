 (n - 1));\n\t\tvector<double> p(n - 1);\n\t\tint c = 0;\n\t\tfor (int j = 0; j < n; ++j) {\n\t\t\tif (i != j) {\n\t\t\t\tp[c++] = allp[j];\n\t\t\t}\n\t\t}\n\t\tdp[0] = allp[i];\n\t\tdouble ans = dp[0];\n\t\tfor (int mask = 1; mask < (1 << (n - 1)); ++mask) {\n\t\t\tdouble sumP = 0;\n\t\t\tdouble sum = 0;\n\t\t\tint cnt = 0;\n\t\t\tfor (int t = 0; t < (n - 1); ++t) {\n\t\t\t\tif (mask & (1 << t)) {\n\t\t\t\t\tsumP += p[t];\n\t\t\t\t\tsum += p[t] * dp[mask ^ (1 << t)];\n\t\t\t\t\t++cnt;\n\t\t\t\t}\n\t\t\t}\n\t\t\tdp[mask] = sum / (1 - sumP);\n\t\t\tif (cnt < k) {\n\t\t\t\tans += dp[mask];\n\t\t\t}\n\t\t}\n\t\tout << ans << \" \";\n\n\t}\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport time\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    \n    allp = []\n    for i in range(n):\n        allp.append(float(input_data[idx])); idx += 1\n    \n    results = []\n    \n    for i in range(n):\n        if abs(allp[i]) < 1e-6:\n            results.append(\"0\")\n            continue\n        \n        dp = [0.0] * (1 << (n - 1))\n        p = []\n        c = 0\n        for j in range(n):\n            if i != j:\n                p.append(allp[j])\n                c += 1\n        \n        dp[0] = allp[i]\n        ans = dp[0]\n        \n        for mask in range(1, 1 << (n - 1)):\n            sumP = 0.0\n            total_sum = 0.0\n            cnt = 0\n            for t in range(n - 1):\n                if mask & (1 << t):\n                    sumP += p[t]\n                    total_sum += p[t] * dp[mask ^ (1 << t)]\n                    cnt += 1\n            dp[mask] = total_sum / (1 - sumP)\n            if cnt < k:\n                ans += dp[mask]\n        \n        results.append(str(ans))\n    \n    print(\" \".join(results)