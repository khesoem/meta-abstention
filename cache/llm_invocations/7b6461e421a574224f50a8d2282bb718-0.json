n        sts.clear();\n        for (auto& p : merged) {\n            sts.push_back(p);\n        }\n        // No need to sort again because map is ordered by key (vector<int>)\n    }\n\n    Mint ans = (sts.empty() ? Mint(0) : sts[0].second);\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 10**9 + 7\n\nclass ModInt:\n    __slots__ = ('v',)\n    def __init__(self, v=0):\n        self.v = v % MOD\n        if self.v < 0:\n            self.v += MOD\n\n    def __neg__(self):\n        return ModInt(-self.v)\n\n    def __add__(self, other):\n        if isinstance(other, ModInt):\n            return ModInt(self.v + other.v)\n        return ModInt(self.v + other)\n\n    def __sub__(self, other):\n        if isinstance(other, ModInt):\n            return ModInt(self.v - other.v)\n        return ModInt(self.v - other)\n\n    def __mul__(self, other):\n        if isinstance(other, ModInt):\n            return ModInt(self.v * other.v)\n        return ModInt(self.v * other)\n\n    def __truediv__(self, other):\n        if isinstance(other, ModInt):\n            return self * other.inv()\n        return self * ModInt(other).inv()\n\n    def __iadd__(self, other):\n        self.v = (self.v + other.v) % MOD\n        return self\n\n    def __isub__(self, other):\n        self.v = (self.v - other.v) % MOD\n        return self\n\n    def __imul__(self, other):\n        self.v = (self.v * other.v) % MOD\n        return self\n\n    def __itruediv__(self, other):\n        self.v = (self.v * other.inv().v) % MOD\n        return self\n\n    def __eq__(self, other):\n        if isinstance(other, ModInt):\n            return self.v == other.v\n        return self.v == other\n\n    def __bool__(self):\n        return self.v != 0\n\n    def __repr__(self):\n        return str(self.v)\n\n    def pow(self, n):\n        x = self\n        r = ModInt(1)\n        while n:\n            if n & 1:\n                r *= x\n            x *= x\n            n >>= 1\n        return r\n\n    def inv(self):\n        return self.pow(MOD - 2)\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n\n    mat = [[ModInt(0) for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            x = int(next(it))\n            mat[i][j] = ModInt(x) / ModInt(100)\n\n    sts = [([0], ModInt(1)]\n\n    for ph in range(n):\n        nsts = []\n        for f in range(1, 1 << n):\n            freq = ModInt(1)\n        for i in range(n):\n            if (f >> i) & 1:\n                freq *= mat[ph][i]\n            else:\n                freq *= ModInt(1) - mat[ph][i]\n        for st in sts:\n            nst = []\n            for d in st[0]:\n                for i in range(n):\n                    if (d >> i) & 1:\n                        continue\n                    if not ((f >> i) & 1):\n                        continue\n                    nst.append(d ^ (1 << i))\n            if not nst:\n                continue\n            nst.sort()\n            # remove duplicates\n            uniq = []\n            for x in nst:\n                if not uniq or x != uniq[-1]:\n                    uniq.append(x)\n            nsts.append((uniq, st[1] * freq))\n        # merge using dict\n        merged = {}\n        for key_list, val in nsts:\n            key = tuple(key_list)\n            if key in merged:\n                merged[key] += val\n            else:\n                merged[key] = val\n        # convert back to list of (list, ModInt) sorted by key\n        sts = [(list(k), v) for k, v in sorted(merged.items())]\n\n    ans = ModInt(0) if not sts else sts[0][1]\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.4570634852570947e-06, 0.0, -1.