\t\t\tbottleneck[to[e]] = min(bottleneck[u], capacity[e]);\n\t\t\tprev_edge[to[e]] = e;\n\t\t\tif (!in_queue[to[e]]) {\n\t\t\t\tin_queue[to[e]] = true;\n\t\t\t\tq.push(to[e]);\n\t\t\t}\n\t\t}\n\t}\n\treturn dist[sink] != INF;\n}\nvoid augment() {\n\tint flow = bottleneck[sink];\n\tint cur = sink;\n\twhile (cur != source) {\n\t\tint e = prev_edge[cur];\n\t\tcapacity[e] -= flow;\n\t\tcapacity[e ^ 1] += flow;\n\t\tcur = to[e ^ 1];\n\t}\n\ttotal_cost += flow * dist[sink];\n}\nint main() {\n\tscanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n\tsink = (n + k - 1) * n + 1;\n\tfor (int i = 1, x; i <= k; i++) {\n\t\tscanf(\"%d\", &x);\n\t\tinsert_edge(source, x, 1, 0);\n\t}\n\tfor (int i = 1, u, v; i <= m; i++) {\n\t\tscanf(\"%d%d\", &u, &v);\n\t\tfor (int layer = 1; layer <= n + k; layer++) {\n\t\t\tfor (int hop = 1; hop <= k; hop++) {\n\t\t\t\tint weight = d * hop * 2 - d + c;\n\t\t\t\tinsert_edge(u + (layer - 1) * n, v + layer * n, 1, weight);\n\t\t\t\tinsert_edge(v + (layer - 1) * n, u + layer * n, 1, weight);\n\t\t\t}\n\t\t}\n\t}\n\tfor (int layer = 1; layer < n + k; layer++) {\n\t\tfor (int node = 2; node <= n; node++) {\n\t\t\tinsert_edge(node + (layer - 1) * n, node + layer * n, INF, c);\n\t\t}\n\t\tinsert_edge(1 + (layer - 1) * n, 1 + layer * n, INF, 0);\n\t}\n\twhile (bellman_ford()) {\n\t\taugment();\n\t}\n\tprintf(\"%d\\n\", total_cost);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 10000010;\n    static final int INF = 0x3f3f3f3f;\n    \n    static int n, m, c, d, k, source = 0, sink, total_cost = 0;\n    static int edge_cnt = 1;\n    static int[] head = new int[MAXN];\n    static int[] to = new int[MAXN];\n    static int[] next_edge = new int[MAXN];\n    static int[] capacity = new int[MAXN];\n    static int[] cost = new int[MAXN];\n    static int[] dist = new int[M