r (int i = 0; i < 102; i++) {\n            int tmp2 = i * 50 + 1;\n            addedge(tmp2, T, INF, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            int u = readInt(sc);\n            int v = readInt(sc);\n            for (int j = 1; j <= 102; j++) {\n                int x = point(j, u);\n                int x1 = point(j + 1, u);\n                int y1 = point(j + 1, v);\n                int y = point(j, v);\n                for (int k = 0; k < 50; k++) {\n                    int val = d * (k * 2 + 1) + c;\n                    addedge(x, y1, 1, val);\n                    addedge(y, x1, 1, val);\n                }\n            }\n        }\n        int[] cost = new int[1];\n        minCostMaxflow(S, T, cost);\n        System.out.println(cost[0]);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0008245145436376333, -1.6047699318733066e-05, -6.704273118884885e-07, -0.00016516048344783485, -2.45848218582978e-06, -3.128163257315464e-07, -0.0024758970830589533, -0.3178783357143402, -1.8119031190872192, -8.578184497309849e-05, -0.00018565983918961138, -0.0018759206868708134, -0.00016325322212651372, -3.128163257315464e-07, -0.1063435897231102, -0.06207076087594032, -0.004926685243844986, -0.0038463904056698084, -0.0024144190829247236, -2.165027217415627e-05, -9.968312951968983e-06, -6.511406809295295e-06, -0.0006371428607963026, -8.828512363834307e-05, -1.8624639324116288e-06, -1.9361264946837764e-07, -0.0001137947037932463, 0.0, -1.9361264946837764e-07, 0.0, 0.0, -1.9361264946837764e-07, 0.0, -0.002246246440336108, -1.5048530030981055e-06, -6.349075556499884e-05, -0.0701480507850647, -0.00010914575977949426, -0.20143750309944153, -8.363617962459102e-05, -5.438573680294212e-06, -3.128163257315464e-07, -1.9361264946837764e-07, -7.600714161526412e-05, -1.2471589798224159e-05, -0.00038300611777231097, -1.1398757123970427e-05, -2.8325677703833207e-05, -0.0046844263561069965, -2.935296834039036e-0