    }\n    return invFact;\n}\n\nlong long paritySign(long long k) {\n    return (k & 1) == 0 ? 1 : MOD - 1;\n}\n\nlong long ncr(int n, int r, const vector<long long>& fact, const vector<long long>& invFact) {\n    if (r < 0 || n < r) return 0;\n    return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n}\n\nlong long add(long long a, long long b) {\n    long long v = a + b;\n    return v < MOD ? v : v - MOD;\n}\n\nlong long pow(long long x, int e) {\n    if (e < 0) {\n        // compute modular inverse of x\n        long long g = MOD, a = 0, b = 1;\n        long long r = x;\n        while (r != 0) {\n            long long q = g / r;\n            g %= r;\n            swap(g, r);\n            a -= q * b;\n            swap(a, b);\n        }\n        a %= MOD;\n        if (a < 0) a += MOD;\n        x = a;\n        e = -e;\n    }\n    long long res = 1;\n    while (e > 0) {\n        if (e & 1) res = res * x % MOD;\n        x = x * x % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n\n    int n;\n    long long k;\n    cin >> n >> k;\n\n    if (k == 0) {\n        vector<long long> factArr = precomputeFactorials(n);\n        cout << factArr[n] << '\\n';\n        return 0;\n    }\n\n    if (k > n - 1) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    int c = (int)(n - k);\n\n    vector<long long> factArr = precomputeFactorials(n);\n    vector<long long> invFactArr = precomputeInvFactorials(n, factArr);\n\n    long long answer = 0;\n    for (int i = 1; i <= c; ++i) {\n        long long term = paritySign(c - i);\n        term = term * ncr(c, i, factArr, invFactArr) % MOD;\n        term = term * pow(i, n) % MOD;\n        answer = add(answer, term);\n    }\n\n    answer = answer * 2 % MOD;\n    answer = answer * ncr(n, c, factArr, invFactArr) % MOD;\n    cout << answer << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.3126334