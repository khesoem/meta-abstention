rue\n        prev_node = [-1] * total_nodes\n        prev_edge = [-1] * total_nodes\n        \n        while queue:\n            u = queue.pop(0)\n            in_queue[u] = False\n            for i, (to, cap, cost, rev_idx) in enumerate(graph[u]):\n                if cap > 0 and dist[to] > dist[u] + cost:\n                    dist[to] = dist[u] + cost\n                    prev_node[to] = u\n                    prev_edge[to] = i\n                    if not in_queue[to]:\n                        in_queue[to] = True\n                        queue.append(to)\n        \n        if dist[sink] == INF:\n            break\n        \n        flow_amount = 10**9\n        v = sink\n        while v != source:\n            u = prev_node[v]\n            edge_idx = prev_edge[v]\n            flow_amount = min(flow_amount, graph[u][edge_idx][1])\n            v = u\n        \n        v = sink\n        while v != source:\n            u = prev_node[v]\n            edge_idx = prev_edge[v]\n            graph[u][edge_idx][1] -= flow_amount\n            rev_idx = graph[u][edge_idx][3]\n            graph[v][rev_idx][1] += flow_amount\n            v = u\n        \n        total_flow += flow_amount\n        total_cost += flow_amount * dist[sink]\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0003271759778726846, -1.4305104514278355e-06, -2.3841855067985307e-07, -0.00031096869497559965, -0.016384700313210487, -1.2040065485052764e-05, -0.04300504922866821, -0.006731808185577393, -7.152555099310121e-07, -0.28116515278816223, -0.03424324095249176, -0.05488422513008118, -0.012946361675858498, -0.00046528480015695095, -0.5685998797416687, -0.22714108228683472, -3.659658250398934e-05, -4.768370445162873e-07, -0.02259020321071148, -0.009735013358294964, -8.583032467868179e-06, -1.2874520507466514e-05, -0.00521442387253046, -0.0012648447882384062, -1.7881377516459906e-06, -7.402622577501461e-05, 0.0