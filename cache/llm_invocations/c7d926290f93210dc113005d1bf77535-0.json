t_flow(int src, int dst) {\n        source_node = src;\n        sink_node = dst;\n        int total_flow = 0;\n        ll total_cost = 0;\n\n        while (true) {\n            fill(distances.begin(), distances.end(), INF);\n            distances[src] = 0;\n            bool updated = true;\n\n            while (updated) {\n                updated = false;\n                for (int u = 0; u < node_count; ++u) {\n                    if (distances[u] == INF) continue;\n                    for (int i = 0; i < graph[u].size(); ++i) {\n                        Edge &e = graph[u][i];\n                        if (e.capacity > 0 && distances[e.to] > distances[u] + e.cost) {\n                            distances[e.to] = distances[u] + e.cost;\n                            previous_node[e.to] = u;\n                            previous_edge[e.to] = i;\n                            updated = true;\n                        }\n                    }\n                }\n            }\n\n            if (distances[sink_node] == INF) break;\n\n            int flow_amount = INF;\n            for (int v = sink_node; v != source_node; v = previous_node[v]) {\n                flow_amount = min(flow_amount, graph[previous_node[v]][previous_edge[v]].capacity);\n            }\n\n            total_flow += flow_amount;\n            total_cost += (ll)flow_amount * distances[sink_node];\n\n            for (int v = sink_node; v != source_node; v = previous_node[v]) {\n                Edge &e = graph[previous_node[v]][previous_edge[v]];\n                e.capacity -= flow_amount;\n                graph[v][e.reverse_index].capacity += flow_amount;\n            }\n        }\n\n        return {total_flow, total_cost};\n    }\n};\n\nint n, m, k, c, d, a[1005], node_id[55][2505];\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 1; i <= k; ++i) {\n        cin >> a[i];\n    }\n\n    MinCostMaxFlow solver(50 * 50 * 4 + 10);\n    i