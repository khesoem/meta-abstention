if (!(o instanceof Mint)) return false;\n            Mint m = (Mint) o;\n            return v == m.v;\n        }\n        @Override\n        public int hashCode() {\n            return v;\n        }\n    }\n\n    static int compareLists(ArrayList<Integer> a, ArrayList<Integer> b) {\n        int len = Math.min(a.size(), b.size());\n        for (int i = 0; i < len; i++) {\n            int cmp = Integer.compare(a.get(i), b.get(i));\n            if (cmp != 0) return cmp;\n        }\n        return Integer.compare(a.size(), b.size());\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n\n        Mint[][] mat = new Mint[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int x = sc.nextInt();\n                mat[i][j] = new Mint(x).divide(new Mint(100));\n            }\n        }\n\n        Map<ArrayList<Integer>, Mint> sts_map = new HashMap<>();\n        ArrayList<Integer> initialKey = new ArrayList<>();\n        initialKey.add(0);\n        sts_map.put(initialKey, new Mint(1));\n\n        for (int ph = 0; ph < n; ph++) {\n            Map<ArrayList<Integer>, Mint> nsts_map = new HashMap<>();\n            int totalMask = 1 << n;\n            for (int f = 1; f < totalMask; f++) {\n                Mint freq = new Mint(1);\n                for (int i = 0; i < n; i++) {\n                    if ((f >> i & 1) == 1) {\n                        freq = freq.multiply(mat[ph][i]);\n                    } else {\n                        freq = freq.multiply(new Mint(1).subtract(mat[ph][i]));\n                    }\n                }\n\n                for (Map.Entry<ArrayList<Integer>, Mint> entry : sts_map.entrySet()) {\n                    ArrayList<Integer> st = entry.getKey();\n                    Mint stVal = entry.getValue();\n                    ArrayList<Integer> nst = new ArrayList<>();\n\n                    for (int d : st) {\n               