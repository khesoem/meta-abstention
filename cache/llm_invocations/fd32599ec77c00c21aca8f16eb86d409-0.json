xt"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        \n        double minRelError = 1e12;\n        long bestA = 0;\n        long bestB = 1;\n        \n        for (long b = 1; b <= n; ++b) {\n            long a = x * b / y;\n            \n            // Check exact fractions first\n            for (long k : new long[]{a - 1, a, a + 1}) {\n                if (k <= 0) continue;\n                if (x * b == k * y) {\n                    System.out.println(k + \"/\" + b);\n                    return;\n                }\n            }\n            \n            // Update best approximation\n            for (long k : new long[]{a - 1, a, a + 1}) {\n                if (k <= 0) continue;\n                double error = Math.abs((double)(x * b - k * y) / (y * b));\n                if (error < minRelError) {\n                    minRelError = error;\n                    bestA = k;\n                    bestB = b;\n                }\n            }\n        }\n        \n        System.out.println(bestA + \"/\" + bestB);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.941560711013153e-05, -2.622600959512056e-06, -2.3841855067985307e-07, -0.001862459466792643, -1.2278481335670222e-05, -0.0005718026659451425, -0.29545843601226807, -0.0040803044103085995, -1.1920858014491387e-05, -4.768370445162873e-07, -3.659658250398934e-05, -5.173549288883805e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.814689989667386e-06, -2.622600959512056e-06, -2.145764938177308e-06, -1.9550132492440753e-05, -1.0728830375228426e-06, -2.3841855067985307e-07, -2.0265558760002023e-06, -7.986990567587782e-06, -0.0011632826644927263, -2.1