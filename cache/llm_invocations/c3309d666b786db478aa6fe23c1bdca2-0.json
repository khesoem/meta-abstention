 = 1 << bit;\n        for (int mask = 0; mask < (1<<17); ++mask) {\n            if (mask & bitmask) ans_arr[mask] -= ans_arr[mask ^ bitmask];\n        }\n    }\n}\n\nint main() {\n    scanf(\"%d %d %d\", &n, &k, &mod);\n    if (n & 1) {\n        printf(\"%lld\\n\", powmod(k, n));\n        return 0;\n    }\n    precompute_fact();\n    n >>= 1;\n    for (int i = 0; i <= n; ++i) {\n        int pc = __builtin_popcount(i);\n        mat[pc][i] = invf[i*2];\n    }\n    sos_transform();\n    int target_pc = __builtin_popcount(n);\n    for (int mask = 0; mask < (1<<17); ++mask) {\n        memset(dp, 0, sizeof(dp));\n        dp[0][0] = 1;\n        for (int j = 1; j <= k; ++j) {\n            for (int u = 0; u <= 17; ++u) {\n                long long cu = mat[u][mask];\n                for (int v = 0; u + v <= 17; ++v) {\n                    dp[j][u+v] += cu * dp[j-1][v];\n                }\n            }\n            for (int v = 0; v <= 17; ++v) dp[j][v] %= mod;\n        }\n        ans_arr[mask] = dp[k][target_pc];\n    }\n    inverse_sos();\n    long long result = (powmod(k, n*2) - (ans_arr[n] % mod) * fact[n*2] % mod + mod) % mod;\n    printf(\"%lld\\n\", result);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef powmod(a, e, mod):\n    res = 1\n    while e:\n        if e & 1:\n            res = res * a % mod\n        a = a * a % mod\n        e >>= 1\n    return res\n\ndef precompute_fact(n, mod):\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % mod\n    invf = [1] * (n + 1)\n    invf[n] = powmod(fact[n], mod-2, mod)\n    for i in range(n-1, -1, -1):\n        invf[i] = invf[i+1] * (i+1) % mod\n    return fact, invf\n\ndef sos_transform(mat, mod):\n    for idx in range(17):\n        for bit in range(17):\n            bitmask = 1 << bit\n            for mask in range(1 << 17):\n                if mask & bitmask:\n                    mat[idx][mask] += mat[idx][mask ^ bitmask]\n    for idx in range(17):\n        for mask in range(1 << 17):\n            mat[idx][mask] %= mod\n\ndef inverse_sos(ans_arr):\n    for bit in range(17):\n        bitmask = 1 << bit\n        for mask in range(1 << 17):\n            if mask & bitmask:\n                ans_arr[mask] -= ans_arr[mask ^ bitmask]\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n    if n & 1:\n        print(powmod(k, n, mod))\n        return\n    fact, invf = precompute_fact(n, mod)\n    n >>= 1\n    size = 1 << 17\n    mat = [[0] * size for _ in range(18)]\n    for i in range(n + 1):\n        pc = i.bit_count()\n        mat[pc][i] = invf[i * 2]\n    sos_transform(mat, mod)\n    target_pc = n.bit_count()\n    ans_arr = [0] * size\n    for mask in range(size):\n        dp = [[0] * 18 for _ in range(k + 1)]\n        dp[0][0] = 1\n        for j in range(1, k + 1):\n            for u in range(18):\n                cu = mat[u][mask]\n                if cu == 0:\n                    continue\n                for v in range(18 - u):\n                    dp[j][u + v] += cu * dp[j-1][v]\n            for v in range(18):\n                dp[j][v] %= mod\n        ans_arr[mask] = dp[k][target_pc]\n    inverse_sos(ans_arr)\n    result = (powmod(k, n * 2, mod) - (ans_arr[n] % mod) * fact[n * 2] % mod + mod) % mod\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0004401430196594447, -0.03952988609671593, -1.6927575416048057e-05, -0.004098231438547373, -0.045163676142692566, -0.00014077626110520214, -4.541770613286644e-05, -2.3841830625315197e-06, -0.006715585943311453, -1.1920928244535389e-07, -0.2519451677799225, -7.915183232398704e-05, -0.00018070495571009815, -1.1920928244535389e-07, -3.2186455882765586e-