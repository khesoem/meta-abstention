 lb = lowbit(x);\n                        if(s[j ^ lb]) { t[j] = 1; break; }\n                        x -= lb;\n                    }\n                }\n            }\n            trans[idcnt][mask] = dfs(t);\n        }\n        return idcnt;\n    };\n    dfs(1);\n    vector<vector<int>> prob(n, vector<int>(1<<n));\n    vector<vector<int>> a(n, vector<int>(n));\n    for(int i=0; i<n; ++i)\n        for(int j=0; j<n; ++j) {\n            cin >> a[i][j];\n            a[i][j] = mul(a[i][j], power(100, MOD-2));\n        }\n    for(int i=0; i<n; ++i) {\n        for(int mask = 0; mask < (1<<n); ++mask) {\n            prob[i][mask] = 1;\n            for(int k=0; k<n; ++k) {\n                if(mask & (1<<k)) prob[i][mask] = mul(prob[i][mask], a[i][k]);\n                else prob[i][mask] = mul(prob[i][mask], sub(1, a[i][k]));\n            }\n        }\n    }\n    vector<vector<int>> dp(n+1, vector<int>(idcnt+1, 0));\n    dp[0][1] = 1;\n    for(int i=1; i<=n; ++i) {\n        for(int st=1; st<=idcnt; ++st) {\n            for(int mask=0; mask<(1<<n); ++mask) {\n                int nxt = trans[st][mask];\n                dp[i][nxt] = add(dp[i][nxt], mul(dp[i-1][st], prob[i-1][mask]));\n            }\n        }\n    }\n    bitset<128> full;\n    for(int i=0; i<(1<<n); ++i) full[i]=1;\n    cout << dp[n][id[full]] << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n\n    static int add(int a, int b) {\n        int c = a + b;\n        if (c >= MOD) c -= MOD;\n        return c;\n    }\n\n    static int mul(int a, int b) {\n        return (int)((long)a * b % MOD);\n    }\n\n    static int sub(int a, int b) {\n        int c = a - b;\n        if (c < 0) c += MOD;\n        return c;\n    }\n\n    static int power(int a, int b) {\n        int r = 1;\n        while 