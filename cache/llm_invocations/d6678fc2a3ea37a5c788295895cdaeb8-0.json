>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        String[] line = scanner.nextLine().split(\" \");\n        int n = Integer.parseInt(line[0]);\n        int h = Integer.parseInt(line[1]);\n        \n        // Initialize DP table with zeros\n        long[][] dp = new long[36][36];\n        dp[0][0] = 1; // Empty tree\n        \n        // Fill DP table\n        for (int nodes = 1; nodes < 36; nodes++) {\n            for (int minheight = 0; minheight <= nodes; minheight++) {\n                long total = 0;\n                for (int topnode = 1; topnode <= nodes; topnode++) {\n                    int left_nodes = topnode - 1;\n                    int right_nodes = nodes - topnode;\n                    \n                    long left_total = dp[left_nodes][0];\n                    long right_total = dp[right_nodes][0];\n                    int left_min_h_index = Math.max(minheight - 1, 0);\n                    int right_min_h_index = Math.max(minheight - 1, 0);\n                    long left_min_h = dp[left_nodes][left_min_h_index];\n                    long right_min_h = dp[right_nodes][right_min_h_index];\n                    \n                    total += left_total * right_total - (left_total - left_min_h) * (right_total - right_min_h);\n                }\n                dp[nodes][minheight] = total;\n            }\n        }\n        \n        System.out.println(dp[n][h]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.07141511561349e-05, -1.4305104514278355e-06, -3.576278118089249e-07, -2.5152843591058627e-05, -1.3947389561508317e-05, -0.002845883136615157, -0.08635204285383224, -2.3841574147809297e-05, -2.3841855067985307e-07, -0.0003383779258001596, -0.0005538121913559735, -3.3