tart_val > N) return;\n    if (start_val * BASE + BASE - 1 <= N && start_val * BASE * 10 > N) {\n        ll current_total = global_counter;\n        for (int i = 0, multiplier = 1; i <= 6; ++i, multiplier *= 10) {\n            ll size = digit_groups[i].size();\n            ll diff = ((current_total - start_val * multiplier) % MOD_A + MOD_A) % MOD_A;\n            ll index = lower_bound(digit_groups[i].begin(), digit_groups[i].end(), MOD_A - diff) - digit_groups[i].begin();\n            answer = (answer + diff * size + partial_sums[i]) % MOD_B;\n            answer = (answer - MOD_A * (size - index) % MOD_B + MOD_B) % MOD_B;\n            global_counter += size;\n        }\n        return;\n    }\n    global_counter++;\n    ll value = ((global_counter - start_val) % MOD_A + MOD_A) % MOD_A;\n    answer = (answer + value) % MOD_B;\n    for (int d = 0; d <= 9; ++d) {\n        handle_number(start_val * 10 + d);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long MOD_A = 998244353L;\n    static long MOD_B = 1000000007L;\n    static long BASE = 1000000L;\n\n    static int N;\n    static long global_counter = 0;\n    static long answer = 0;\n    static long[] partial_sums = new long[8];\n    static List<Long>[] digit_groups = new List[8];\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        N = Integer.parseInt(br.readLine());\n        \n        for (int i = 0; i < 8; i++) {\n            digit_groups[i] = new ArrayList<>();\n        }\n        \n        build_data(0, 0);\n        for (int i = 0; i <= 7; i++) {\n            Collections.sort(digit_groups[i]);\n        }\n        global_counter = 0;\n        for (int d = 1; d <= 9; d++) {\n            handle_number(d);\n        }