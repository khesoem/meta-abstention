tatic class Edge {\n        int dst, cap, flow, cost;\n        Edge(int dst, int cap, int flow, int cost) {\n            this.dst = dst;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final long INF = (long) 1e18;\n    static final int V = 1000007;\n    static final int LAYERS = 101;\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] graph = new ArrayList[V];\n    static long[] distCost = new long[V];\n    static int[] parent = new int[V];\n    static int[] parentEdge = new int[V];\n    static int[] inQueue = new int[V];\n    static int source = V - 2;\n    static int sink = V - 1;\n    static long total = 0;\n    static int n, m, k, c, d;\n\n    static int capLeft(int id) {\n        return edges.get(id).cap - edges.get(id).flow;\n    }\n\n    static void addEdge(int u, int v, int capacity, int cost) {\n        graph[u].add(edges.size());\n        edges.add(new Edge(v, capacity, 0, cost));\n        graph[v].add(edges.size());\n        edges.add(new Edge(u, 0, 0, cost));\n    }\n\n    static void spfa() {\n        for (int i = 0; i < V; i++) {\n            distCost[i] = INF;\n            parent[i] = -1;\n            parentEdge[i] = -1;\n            inQueue[i] = 0;\n        }\n        Queue<Integer> q = new LinkedList<>();\n        distCost[source] = 0;\n        inQueue[source] = 1;\n        q.add(source);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = 0;\n            for (int id : graph[u]) {\n                if (capLeft(id) == 0) continue;\n                int v = edges.get(id).dst;\n                if (distCost[v] > distCost[u] + edges.get(id).cost) {\n                    distCost[v] = distCost[u] + edges.get(id).cost;\n                    parent[v] = u;\n                    parentEdge[v] = id;\n                    if (inQueue[v] == 0) {\n                        inQueue[v] = 1;\n                        q.add(v);\