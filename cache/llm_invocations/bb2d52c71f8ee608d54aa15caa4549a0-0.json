 new ArrayList<>();\n        List<Integer> a2 = new ArrayList<>();\n        int n1 = n / 2;\n        \n        sums1(a, a1, m, 0, n1, 0);\n        sums2(a, a2, m, n1, n, 0);\n        \n        int ans = 0;\n        Collections.sort(a1);\n        a1 = new ArrayList<>(new HashSet<>(a1)); // Remove duplicates and sort\n        \n        int end = a2.size() - 1;\n        \n        for (int i : a2) {\n            int j = Collections.binarySearch(a1, m - i);\n            if (j < 0) {\n                j = -(j + 1);\n            }\n            \n            int k = 0;\n            if (j > 0) {\n                k = a1.get(j - 1) + i;\n            }\n            \n            if (k > ans) {\n                ans = k;\n            }\n        }\n        \n        System.out.println(ans);\n    }\n    \n    private static void sums1(int[] a, List<Integer> result, int m, int i, int n1, int sum) {\n        if (i == n1) {\n            result.add(sum % m);\n        } else {\n            sums1(a, result, m, i + 1, n1, (sum + a[i]) % m);\n            sums1(a, result, m, i + 1, n1, sum);\n        }\n    }\n    \n    private static void sums2(int[] a, List<Integer> result, int m, int i, int n, int sum) {\n        if (i == n) {\n            result.add(sum % m);\n        } else {\n            sums2(a, result, m, i + 1, n, (sum + a[i]) % m);\n            sums2(a, result, m, i + 1, n, sum);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001072826053132303, -1.9073468138230965e-06, -2.3841855067985307e-07, -4.351044481154531e-05, -1.4305012882687151e-05, -0.002806060714647174, -0.1289304792881012, -3.4570634852570947e-06, -5.960462772236497e-07, -7.855583680793643e-05, -0.00018046658078674227, -2.7418097943154862e-06, -0.0014225849881768227, -5.960462772236497e-07, -1.2516897186287679e-05, -1.311301275563892e-06, -9.536738616588991e-07, -1.6689286894688848e-06, -2.47952248173533e-05, -1.1920922133867862e-06, -4.768370445162873e-07, -2.38418