j-1)+F(i-j))%mod);\n\t\t\tnw.g=1ll*nw.g*inv[i]%mod;\n\t\t\tnw.f=1ll*nw.f*(i+1)%mod*inv[i]%mod;\n\t\t\tdp[i]=dp[i]+nw;\n\t\t}\n\t//\tprintf(\"i=%d,dp=%lld,%lld\\n\",i,1ll*dp[i].f*fr[i]%mod,1ll*dp[i].g*fr[i]%mod);\n\t}\n\tup[0][0]=pt(1,0);\n\tfor(int i=1;i<=n;i++)\n\t\tfor(int j=0;j<=min(i,m);j++)\n\t\t{\n\t\t\tif(i==j) up[i][j]=dp[i];\n\t\t\tfor(int k=0;k<=j&&k<i;k++)\n\t\t\t\tup[i][j]=up[i][j]+dp[k]*up[i-k-1][j-k];\n\t\t}\n\tint ans=1ll*up[n][m].g*fr[m]%mod;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    m = int(data[1])\n    mod = int(data[2])\n    \n    def addmod(x):\n        return x - mod if x >= mod else x\n    \n    def submod(x):\n        return x + mod if x < 0 else x\n    \n    def fpow(x, y):\n        ans = 1\n        while y:\n            if y & 1:\n                ans = (ans * x) % mod\n            x = (x * x) % mod\n            y //= 2\n        return ans\n    \n    class pt:\n        def __init__(self, f=0, g=0):\n            self.f = f\n            self.g = g\n        \n        def __add__(self, other):\n            return pt(addmod(self.f + other.f), addmod(self.g + other.g))\n        \n        def __mul__(self, other):\n            return pt(\n                (self.f * other.f) % mod,\n                addmod((self.f * other.g) % mod + (self.g * other.f) % mod)\n            )\n    \n    pn = 100000\n    fr = [0] * (pn + 1)\n    infr = [0] * (pn + 1)\n    inv = [0] * (pn + 1)\n    \n    fr[0] = 1\n    infr[0] = 1\n    for i in range(1, pn + 1):\n        fr[i] = (i * fr[i - 1]) % mod\n        infr[i] = fpow(fr[i], mod - 2)\n        inv[i] = fpow(i, mod - 2)\n    \n    def F(x):\n        return (x * (x + 1) // 2) % mod\n    \n    dp = [pt() for _ in range(n + 1)]\n    dp[0] = pt(1, 0)\n    \n    for i i