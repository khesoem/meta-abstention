n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\nclass FlowGraph:\n    def __init__(self, n):\n        self.n = n\n        self.head = [-1] * (n + 5)\n        self.v = []\n        self.nxt = []\n        self.w = []\n        self.c = []\n        self.ptr = 0\n        self.t = -1\n        self.cost = 0\n\n    def padd_edge(self, uu, vv, ww, cc):\n        self.v.append(vv)\n        self.w.append(ww)\n        self.c.append(cc)\n        self.nxt.append(self.head[uu])\n        self.head[uu] = self.ptr\n        self.ptr += 1\n\n    def add_edge(self, uu, vv, ww, cc):\n        self.padd_edge(uu, vv, ww, cc)\n        self.padd_edge(vv, uu, 0, -cc)\n\n    def spfa(self, s, t):\n        dis = [-1] * (self.n + 5)\n        vis = [False] * (self.n + 5)\n        q = deque()\n        q.append(s)\n        dis[s] = 0\n        while q:\n            nd = q.popleft()\n            vis[nd] = False\n            i = self.head[nd]\n            while i != -1:\n                if self.w[i] and (dis[self.v[i]] == -1 or dis[self.v[i]] > dis[nd] + self.c[i]):\n                    dis[self.v[i]] = dis[nd] + self.c[i]\n                    if not vis[self.v[i]]:\n                        vis[self.v[i]] = True\n                        q.append(self.v[i])\n                i = self.nxt[i]\n        self.dis = dis\n        return dis[t] != -1\n\n    def dfs(self, pos, flow):\n        if pos == self.t:\n            return flow\n        self.vis[pos] = True\n        tmp = flow\n        i = self.cur[pos] if self.cur[pos] != -1 else self.head[pos]\n        while i != -1:\n            if not self.vis[self.v[i]] and self.w[i] and self.dis[self.v[i]] == self.dis[pos] + self.c[i]:\n                self.cur[pos] = i\n                fl = self.dfs(self.v[i], min(flow, self.w[i]))\n                self.cost += fl * self.c[i]\n                self.w[i] -= fl\n                self.w[i ^ 1] += fl\n                flow -= fl\n                if not flow:\n                    break\n            i = self.nxt[i]\n        return tmp - flow\n\n    def dinic(self, s, t):\n        self.cost = 0\n        self.t = t\n        while self.spfa(s, t):\n            self.cur = [-1] * (self.n + 5)\n            self.vis = [False] * (self.n + 5)\n            self.dfs(s, INF)\n        return self.cost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    kk = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    a = [0] * (kk + 1)\n    for i in range(1, kk + 1):\n        a[i] = int(next(it))\n\n    total_nodes = n * 100 + 2\n    g = FlowGraph(total_nodes)\n    s = 0\n    t = n * 100 + 1\n\n    # edges from time 100 to sink\n    for i in range(1, n + 1):\n        node = (i - 1) * 100 + 100\n        g.add_edge(node, t, INF, 0)\n\n    # edges from source to starting positions\n    for i in range(1, kk + 1):\n        start_node = (a[i] - 1) * 100 + 1\n        g.add_edge(s, start_node, 1, 0)\n\n    # stay edges (waiting)\n    for i in range(2, n + 1):\n        for j in range(1, 100):\n            u = (i - 1) * 100 + j\n            v = (i - 1) * 100 + j + 1\n            g.add_edge(u, v, INF, c)\n\n    # road edges\n    for _ in range(m):\n        t1 = int(next(it))\n        t2 = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, kk + 1):\n                val = c + d * (j * j - (j - 1) * (j - 1))\n                u = (t1 - 1) * 100 + i\n                v = (t2 - 1) * 100 + i + 1\n                g.add_edge(u, v, 1, val)\n                u = (t2 - 1) * 100 + i\n                v = (t1 - 1) * 100 + i + 1\n                g.add_edge(u, v, 1, val)\n\n    result = g.dinic(s, t)\n    print(result)\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(1000000)\n    main()\n<