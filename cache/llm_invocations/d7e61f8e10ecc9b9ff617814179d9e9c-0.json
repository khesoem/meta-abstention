int x = qu.front(); qu.pop();\n        for (int i = head[x]; i; i = e[i].nxt) {\n            int y = e[i].v;\n            if (!seen[y] && e[i].fl < e[i].c) {\n                parentEdge[y] = i;\n                seen[y] = 1;\n                depth[y] = depth[x] + 1;\n                qu.push(y);\n                if (y == SNK) return true;\n            }\n        }\n    }\n    return false;\n}\n\ninline int sendFlow(int x, int now) {\n    if (x == SNK || !now) return now;\n    int rest = now;\n    for (int i = head[x]; i; i = e[i].nxt) {\n        int y = e[i].v;\n        if (e[i].c > e[i].fl && depth[y] == depth[x] + 1) {\n            int pushed = sendFlow(y, min(rest, e[i].c - e[i].fl));\n            if (!pushed) depth[y] = 0;\n            e[i].fl += pushed;\n            e[((i - 1) ^ 1) + 1].fl -= pushed;\n            rest -= pushed;\n            if (rest == 0) break;\n        }\n    }\n    return now - rest;\n}\n\ninline void dinic() {\n    while (bfsLevel()) answer += sendFlow(SRC, INF);\n}\n\nint main() {\n    int n, timeLimit;\n    cin >> n >> timeLimit;\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= n; j++) {\n            safeDist[i][j] = 10000;\n            cin >> gridA[i][j];\n            if (gridA[i][j] == 'Z') {\n                bfs.push(id(i, j, n));\n                safeDist[i][j] = 0;\n            }\n            if (gridA[i][j] <= '9')\n                addEdge(SRC, id(i, j, n), gridA[i][j] - '0');\n        }\n    }\n    while (!bfs.empty()) {\n        int code = bfs.front(); bfs.pop();\n        int x = getX(code, n), y = getY(code, n);\n        for (int d = 0; d < 4; d++) {\n            int nx = x + moveX[d], ny = y + moveY[d];\n            if (nx > 0 && ny > 0 && nx <= n && ny <= n && gridA[nx][ny] <= '9' &&\n                safeDist[nx][ny] > safeDist[x][y] + 1) {\n                safeDist[nx][ny] = safeDist[x][y] + 1;\n                bfs.push(id(nx, ny, n));\n            }\n        }\n    }\n    for (int i = 1; i <= n; i++) {\n      