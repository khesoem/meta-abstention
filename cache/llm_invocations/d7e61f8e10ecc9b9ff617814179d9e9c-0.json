 getY(code, n):\n    return (code - 1) % n + 1\n\nclass Dinic:\n    def __init__(self, n):\n        self.n = n\n        self.graph = [[] for _ in range(n)]\n        self.level = [0] * n\n        self.it = [0] * n\n\n    def add_edge(self, fr, to, cap):\n        forward = [to, cap, None]  # to, cap, rev\n        backward = [fr, 0, None]\n        forward[2] = backward\n        backward[2] = forward\n        self.graph[fr].append(forward)\n        self.graph[to].append(backward)\n\n    def bfs(self, s, t):\n        self.level = [-1] * self.n\n        q = deque()\n        self.level[s] = 0\n        q.append(s)\n        while q:\n            v = q.popleft()\n            for e in self.graph[v]:\n                if e[1] > 0 and self.level[e[0]] < 0:\n                    self.level[e[0]] = self.level[v] + 1\n                    q.append(e[0])\n        return self.level[t] >= 0\n\n    def dfs(self, v, t, f):\n        if v == t:\n            return f\n        for i in range(self.it[v], len(self.graph[v])):\n            self.it[v] = i\n            e = self.graph[v][i]\n            if e[1] > 0 and self.level[v] < self.level[e[0]]:\n                ret = self.dfs(e[0], t, min(f, e[1]))\n                if ret > 0:\n                    e[1] -= ret\n                    e[2][1] += ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    timeLimit = int(next(it))\n\n    gridA = [[''] * (n+1) for _ in range(n+1)]\n    safeDist = [[10000] * (n+1) for _ in range(n+1)]\n\n    # read gridA\n    for i in range(1, n+1):\n        line = next(it)\n        for j, ch in enumerate(line, 1):\n            gridA[i][j] = ch\n\n    dinic = Dinic(SNK+1)\n\n    # BFS for safeDist from 'Z'\n    q = deque()\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if gridA[i][j] == 'Z':\n                code = id(i, j, n)\n                q.append(code)\n                safeDist[i][j] = 0\n            if gridA[i][j] <= '9':\n                dinic.add_edge(SRC, id(i, j, n), int(gridA[i][j]))\n\n    while q:\n        code = q.popleft()\n        x = getX(code, n)\n        y = getY(code, n)\n        for d in range(4):\n            nx = x + moveX[d]\n            ny = y + moveY[d]\n            if 1 <= nx <= n and 1 <= ny <= n and gridA[nx][ny] <= '9':\n                if safeDist[nx][ny] > safeDist[x][y] + 1:\n                    safeDist[nx][ny] = safeDist[x][y] + 1\n                    q.append(id(nx, ny, n))\n\n    # For each digit cell in gridA, compute distances to other digit cells\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if gridA[i][j] > '9':\n                continue\n            start = id(i, j, n)\n            # BFS from (i,j)\n            dist = [[10000] * (n+1) for _ in range(n+1)]\n            dist[i][j] = 0\n            q = deque()\n            q.append(start)\n            while q:\n                code = q.popleft()\n                x = getX(code, n)\n                y = getY(code, n)\n                cur_dist = dist[x][y]\n                if cur_dist >= safeDist[x][y]:\n                    continue  # cannot move further from this cell\n                for d in range(4):\n                    nx = x + moveX[d]\n                    ny = y + moveY[d]\n                    if 1 <= nx <= n and 1 <= ny <= n and gridA[nx][ny] <= '9':\n                        if dist[nx][ny] > cur_dist + 1:\n                            dist[nx][ny] = cur_dist + 1\n                            q.append(id(nx, ny, n))\n            # add edges from start to sink cells\n            for k in range(1, n+1):\n                for l in range(1, n+1):\n                    if gridA[k][l] <= '9' and dist[k][l] <= min(safeDist[k][l], timeLimit):\n                        dinic.add_edge(start, id(k, l, n) + 100, 10000)\n\n    # read gridB\n    gridB = [[''] * (n+1) for _ in range(n+1)]\n    for i in range(1, n+1):\n        line = next(it)\n        for j, ch in enumerate(line, 1):\n            gridB[i][j] = ch\n            if ch <= '9':\n                dinic.add_edge(id(i, j, n) + 100, SNK, int(ch))\n\n    answer = dinic.max_flow(SRC, SNK)\n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-7.414542778860778e-05, -0.38822174072265625, -1.1920928244535389e-07, -9.738924563862383e-05, -3.3378044463461265e-05, 0.0, -3.576278118089249e-07, -0.00018594920402392745, 0.0, 0.0, -4.768370445162873e-07, -0.006724229548126459, -0.6081175208091736, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, 0.0, -1.1920928244535389e-07, -0.2605714499950409, -1.3589766240329482e-05, -0.0009265420376323164, -0.018192103132605553, -0.7522766590118408, -0.0010851691477000713, -1.4305104514278355e-06, 0.0, -5.3881147323409095e-05, -1.2874520507466514e-05, -0.33051902055740356, -0.002469111466780305, -8.344646857949556e-07, 0.0, -3.2066785934148356e-05, -2.038458114839159e-05, -4.446407547220588e-05, -2.264974000354414e-06, -8.702239938429557e-06, -2.264974000354414e-06, -0.0004129749140702188, -7.152555099310121e-07, -1.1920922133867862e-06, -4.529942543740617e-06, -7.784063927829266e-05, -3.576278118089249e-07, -1.1920928244535389e-07, -4.529942543740617e-06, 0.0, -0.00017855956684798002, -9.536697689327411e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -0.006732518319040537, -0.7089691758155823, -0.062476400285959244, 0.0, -0.0019358720164746046, 0.0, 0.0, -1.0251946150674485e-05, -9.536738616588991e-07, 0.0, -2.0265558760002023e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, -5.960462772236