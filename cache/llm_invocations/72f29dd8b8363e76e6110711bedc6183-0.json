            }\n                }\n            }\n        }\n        return d[t] < INF;\n    }\n\n    static int max_flow(int s, int t) {\n        int ans = 0, res = 0;\n        while (shortest_path(s, t)) {\n            int x = t, f = INF;\n            while (x != s) {\n                f = Math.min(f, c[p[x]]);\n                x = v[p[x] ^ 1];\n            }\n            ans += f * d[t];\n            res += f;\n            x = t;\n            while (x != s) {\n                c[p[x]] -= f;\n                c[p[x] ^ 1] += f;\n                x = v[p[x] ^ 1];\n            }\n        }\n        System.err.println(\"res=\" + res);\n        return ans;\n    }\n\n    static void Max(int[] a, int b) {\n        if (a[0] < b) a[0] = b;\n    }\n\n    static void Min(int[] a, int b) {\n        if (a[0] > b) a[0] = b;\n    }\n\n    static void add_mod(int[] a, int b) {\n        a[0] += b;\n        while (a[0] >= MOD) a[0] -= MOD;\n    }\n\n    static int gcd(int a, int b) {\n        if (b == 0) return a;\n        return gcd(b, a % b);\n    }\n\n    static int pow_mod(int a, int b) {\n        int ans = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) ans = (int)((long)ans * a % MOD);\n            a = (int)((long)a * a % MOD);\n            b >>= 1;\n        }\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int K = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        int[] src = new int[K];\n        for (int i = 0; i < K; i++) {\n            src[i] = sc.nextInt() - 1;\n        }\n\n        int[] edge_x = new int[m];\n        int[] edge_y = new int[m];\n        for (int i = 0; i < m; i++) {\n            edge_x[i] = sc.nextInt() - 1;\n            edge_y[i] = sc.nextInt() - 1;\n        }\n\n        int sz = 0;\n        cnt = 0;\n        Arrays.fill(head, -1);\n\n        int[][] id = new int[n][M];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < M; j++) {\n                id[i][j] = sz++;\n            }\n        }\n\n        int s = sz;\n        int t = s + 1;\n\n        for (int i = 0; i < K; i++) {\n            add_edge(s, id[src[i]][0], 1, 0);\n        }\n\n        for (int i = 0; i < M; i++) {\n            add_edge(id[0][i], t, K, C * i);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < M - 1; j++) {\n                add_edge(id[i][j], id[i][j + 1], K, 0);\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = edge_x[i];\n            int y = edge_y[i];\n            for (int j = 0; j < M - 1; j++) {\n                for (int k = 0; k < K; k++) {\n                    add_edge(id[x][j], id[y][j + 1], 1, D * (2 * k + 1));\n                    add_edge(id[y][j], id[x][j + 1], 1, D * (2 * k + 1));\n                }\n            }\n        }\n\n        int ans = max_flow(s, t);\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.3378546504536644e-06, 0.0, 0.0, -0.00016950124700088054, -0.0029113786295056343, -1.1920928244535389e-07, -0.0007101159426383674, -0.02540096454322338, -5.340433563105762e-05, 0.0, -1.0132738680113107e-05, -0.0024804084096103907, -4.529942543740617e-06, -0.00015031162183731794, -4.768370445162873e-07, 0.0, -0.018369199708104134, -2.3841855067985307e-07, -1.1920928244535389e-07, -5.602820692729438e-06, -3.099436753473128e-06, -6.01988795096986e-05, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -3.909988299710676e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.6689286894688848e-06, 0.0, 0.0, -4.768370445162873e-07, -5.960462772236497e-07, -5.364403477869928e-06, 0.0, -9.536738616588991e-07, -8.4638240878121e-06, 0.0, -4.768370445162873e-07, -5.960462772236497e-07, -0.07895816117525101, -0.12692920863628387, -7.521823135903105e-05