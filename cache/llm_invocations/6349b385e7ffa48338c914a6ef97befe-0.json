)\n            i = self.head[u]\n            while i != -1:\n                v, _, cap = self.edges[i]\n                if self.dist[v] == -1 and cap:\n                    self.dist[v] = self.dist[u] + 1\n                    q.append(v)\n                i = self.edges[i][1]\n        return self.dist[sink] != -1\n\n    def dfs(self, u, flow, sink):\n        if u == sink:\n            return flow\n        i = self.cur[u]\n        while i != -1:\n            v, _, cap = self.edges[i]\n            if self.dist[v] == self.dist[u] + 1 and cap:\n                f = self.dfs(v, min(flow, cap), sink)\n                if f:\n                    self.edges[i][2] -= f\n                    self.edges[i ^ 1][2] += f\n                    return f\n            i = self.edges[i][1]\n            self.cur[u] = i\n        return 0\n\n    def dinic(self, src, sink):\n        flow = 0\n        while self.bfs(src, sink):\n            while True:\n                f = self.dfs(src, INF, sink)\n                if not f:\n                    break\n                flow += f\n        return flow\n\ndef is_digit(ch):\n    return '1' <= ch <= '9'\n\ndef bfs_zombie(x, y, d, n, T, caps, distZ, flag, mf):\n    # flag indicates whether to add edges to caps digits\n    sx, sy = x, y\n    for i in range(n):\n        for j in range(n):\n            d[i][j] = INF\n    d[x][y] = 0\n    q = deque()\n    q.append((x, y))\n    if flag and is_digit(caps[x][y]):\n        mf.add(sx * n + sy, sx * n + sy + n * n, INF)\n    while q:\n        x, y = q.popleft()\n        if d[x][y] == T:\n            continue\n        for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n            xx, yy = x + dx, y + dy\n            if 0 <= xx < n and 0 <= yy < n and d[xx][yy] == INF and caps[xx][yy] != 'Y':\n                if distZ[xx][yy] > d[x][y] + 1 or (distZ[xx][yy] == d[x][y] + 1 and is_digit(caps[xx][yy])):\n                    d[xx][yy] = d[x][y] + 1\n                    if flag and is_digit(caps[xx][yy]):\n                        mf.add(sx * n + sy, xx * n + yy + n * n, INF)\n                    if distZ[xx][yy] > d[x][y] + 1 or not flag:\n                        q.append((xx, yy))\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    T = int(next(it))\n    grid = []\n    for _ in range(n):\n        grid.append(list(next(it)))\n    caps = []\n    for _ in range(n):\n        caps.append(list(next(it)))\n\n    # find Z position\n    zx = zy = -1\n    for i in range(n):\n        for j in range(n):\n            if grid[i][j] == 'Z':\n                zx, zy = i, j\n                break\n        if zx != -1:\n            break\n\n    src = n * n * 2\n    sink = src + 1\n    mf = MaxFlow(sink + 1)\n\n    # add edges from caps digits to sink\n    for i in range(n):\n        for j in range(n):\n            if is_digit(caps[i][j]):\n                mf.add(i * n + j + n * n, sink, ord(caps[i][j]) - ord('0'))\n\n    # BFS from Z to compute distZ\n    distZ = [[INF]*n for _ in range(n)]\n    bfs_zombie(zx, zy, distZ, n, T, caps, distZ, False, mf)\n\n    # for each source in grid\n    for i in range(n):\n        for j in range(n):\n            if is_digit(grid[i][j]):\n                mf.add(src, i * n + j, ord(grid[i][j]) - ord('0'))\n                distS = [[INF]*n for _ in range(n)]\n                bfs_zombie(i, j, distS, n, T, caps, distZ, True, mf)\n\n    print(mf.dinic(src, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.5765218734741211, -5.1616290875244886e-05, 0.0, -1.1920928244535389e-07, -0.00020752183627337217, -0.00167444150429219, -2.9802276912960224e-06, -0.003185794921591878, -0.000533795915544033, -1.7523612768854946e-05, 0.0, -2.9802276912960224e-06, -0.000962032878305763, -0.4789959490299225, -6.508615479106084e-05, -3.540453326422721e-05, -7.271740287251305e-06, -0.16022491455078125, -7.748573807475623e-06, -0.01230541