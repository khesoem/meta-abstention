ons import deque\n\nINF = 10**9\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    dim = int(next(it))\n    time_to_die = int(next(it))\n    \n    L = 2 * dim * dim + 2\n    cap = [[0] * L for _ in range(L)]\n    gr = [[] for _ in range(L)]\n    vert = [[[0, 0] for _ in range(dim)] for _ in range(dim)]\n    \n    labsci = []\n    N = 2\n    for i in range(dim):\n        s = next(it)\n        labsci.append(s)\n        for j, ch in enumerate(s):\n            if '1' <= ch <= '9':\n                val = ord(ch) - ord('0')\n                cap[0][N] = val\n                gr[0].append(N)\n                gr[N].append(0)\n                vert[i][j][0] = N\n                N += 1\n            elif ch == 'Z':\n                malfunc = i * 100 + j\n                labsci[i] = labsci[i][:j] + 'Y' + labsci[i][j+1:]\n    \n    M = N\n    labcap = []\n    for i in range(dim):\n        s = next(it)\n        labcap.append(s)\n        for j, ch in enumerate(s):\n            if '1' <= ch <= '9':\n                val = ord(ch) - ord('0')\n                cap[M][1] = val\n                gr[M].append(1)\n                gr[1].append(M)\n                vert[i][j][1] = M\n                M += 1\n    \n    # BFS for die\n    die = [[time_to_die + 1] * dim for _ in range(dim)]\n    mi = malfunc // 100\n    mj = malfunc % 100\n    die[mi][mj] = 0\n    q = deque()\n    q.append((mi, mj))\n    ds = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n    while q:\n        x, y = q.popleft()\n        for dx, dy in ds:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < dim and 0 <= ny < dim and labsci[nx][ny] != 'Y' and die[nx][ny] > die[x][y] + 1:\n                die[nx][ny] = die[x][y] + 1\n                q.append((nx, ny))\n    \n    # Reachability and edge construction\n    for i in range(dim):\n        for j in range(dim):\n            if '1' <= labsci[i][j] <= '9':\n                reach = [[time_to_die + 1] * dim for _ in range(dim)]\n                reach[i][j] = 0\n                if '1' <= labcap[i][j] <= '9':\n                    u = vert[i][j][0]\n                    v = vert[i][j][1]\n                    cap[u][v] = INF\n                    gr[u].append(v)\n                    gr[v].append(u)\n                q = deque()\n                q.append((i, j))\n                while q:\n                    x, y = q.popleft()\n                    for dx, dy in ds:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < dim and 0 <= ny < dim and labsci[nx][ny] != 'Y' and reach[nx][ny] > reach[x][y] + 1:\n                            if '1' <= labcap[nx][ny] <= '9':\n                                if reach[x][y] + 1 <= die[nx][ny]:\n                                    u = vert[i][j][0]\n                                    v = vert[nx][ny][1]\n                                    cap[u][v] = INF\n                                    gr[u].append(v)\n                                    gr[v].append(u)\n                            if reach[x][y] + 1 < die[nx][ny]:\n                                reach[nx][ny] = reach[x][y] + 1\n                                q.append((nx, ny))\n    \n    # Max flow\n    parent = [-1] * L\n    vis = [False] * L\n    \n    def augment(u):\n        if u == 1:\n            return INF\n        vis[u] = True\n        for v in gr[u]:\n            if not vis[v] and cap[u][v]:\n                r = augment(v)\n                if r:\n                    parent[v] = u\n                    return min(r, cap[u][v])\n        return 0\n    \n    ans = 0\n    flow = 0\n    parent[0] = -1\n    while True:\n        ans += flow\n        vis = [False] * M\n        flow = augment(0)\n        if not flow:\n            break\n        v = 1\n        while v != 0:\n            u = parent[v]\n            cap[u][v] -= flow\n            cap[v][u] += flow\n            v = u\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_cod