  if (d[e.v] != d[u] + 1) continue;\n        ll pushed = augment(e.v, min(f, (ll)e.c - e.f));\n        if (pushed) {\n            e.f += pushed;\n            edg[id ^ 1].f -= pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nll flow() {\n    ll total = 0;\n    while (levelGraph()) {\n        memset(p, 0, sizeof(p));\n        ll pushed;\n        while ((pushed = augment(src, INF)) > 0)\n            total += pushed;\n    }\n    return total;\n}\n\nstring sci[101], rec[101];\nbool connected[10][10][10][10];\nint mark[101][101];\nint failAt[10][10];\nint n, m;\n\nbool inGrid(int r, int c) {\n    return r >= 0 && c >= 0 && r < n && c < m;\n}\n\nint node(int r, int c) {\n    return 1 + m * r + c;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int T;\n    cin >> n >> T;\n    ++T;\n    m = n;\n    snk = m * m * 2 + 1;\n    src = 0;\n    gph.resize(m * m * 2 + 2);\n    queue<pair<int, int>> q;\n    for (int i = 0; i < n; ++i) cin >> sci[i];\n    for (int i = 0; i < n; ++i) {\n        cin >> rec[i];\n        for (int j = 0; j < m; ++j) {\n            failAt[i][j] = INF;\n            if (rec[i][j] == 'Z') {\n                q.push({i, j});\n                failAt[i][j] = 1;\n            }\n        }\n    }\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        for (int di = -1; di <= 1; ++di)\n            for (int dj = -1; dj <= 1; ++dj)\n                if (abs(di) + abs(dj) == 1) {\n                    int nx = x + di, ny = y + dj;\n                    if (inGrid(nx, ny) && failAt[nx][ny] == INF && sci[nx][ny] != 'Y') {\n                        failAt[nx][ny] = failAt[x][y] + 1;\n                        q.push({nx, ny});\n                    }\n                }\n    }\n    for (int x = 0; x < n; ++x)\n        for (int y = 0; y < m; ++y) {\n            if (sci[x][y] >= '1' && sci[x][y] <= '9')\n                link(src, node(x, y), sci[x][y] - '0');\n            if (rec[x][y] >= '1' && rec[x][y] <= '9')\n                link(n * n + node(x, y), snk, rec[x][y] - '0');\n            for (int X = 0; X < n; ++X)\n                for (int Y = 0; Y < m; ++Y) {\n                    if (sci[x][y] == 'Y' || sci[x][y] == 'Z' ||\n                        rec[X][Y] == 'Y' || rec[X][Y] == 'Z')\n                        continue;\n                    memset(mark, 0, sizeof(mark));\n                    queue<tuple<int, int, int>> bq;\n                    bq.emplace(x, y, 1);\n                    mark[x][y] = 1;\n                    while (!bq.empty()) {\n                        auto [cx, cy, t] = bq.front(); bq.pop();\n                        if (cx == X && cy == Y) {\n                            mark[cx][cy] = 1;\n                            break;\n                        }\n                        if (t >= failAt[cx][cy] || t >= T) continue;\n                        for (int di = -1; di <= 1; ++di)\n                            for (int dj = -1; dj <= 1; ++dj)\n                                if (abs(di) + abs(dj) == 1) {\n                                    int nx = cx + di, ny = cy + dj;\n                                    if (inGrid(nx, ny) && !mark[nx][ny] &&\n                                        sci[nx][ny] != 'Y' && sci[nx][ny] != 'Z' &&\n                                        t + 1 <= failAt[nx][ny]) {\n                                        mark[nx][ny] = 1;\n                                        bq.emplace(nx, ny, t + 1);\n                                    }\n                                }\n                    }\n                    if (mark[X][Y])\n                        link(node(x, y), n * n + node(X, Y), INF);\n                }\n        }\n    cout << flow() << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\nimport sys\n\nINF = 1000000009\n\nclass Edge:\n    def __init__(self, u, v, f, c):\n        self.u = u\n  