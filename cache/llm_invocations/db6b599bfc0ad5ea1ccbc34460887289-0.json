for _ in range(10)]\n    q = deque()\n    \n    for i in range(n):\n        for j in range(m):\n            if rec[i][j] == 'Z':\n                q.append((i, j))\n                failAt[i][j] = 1\n    \n    while q:\n        x, y = q.popleft()\n        for di in (-1, 0, 1):\n            for dj in (-1, 0, 1):\n                if abs(di) + abs(dj) == 1:\n                    nx, ny = x + di, y + dj\n                    if 0 <= nx < n and 0 <= ny < m and failAt[nx][ny] == INF and sci[nx][ny] != 'Y':\n                        failAt[nx][ny] = failAt[x][y] + 1\n                        q.append((nx, ny))\n    \n    def inGrid(r, c):\n        return 0 <= r < n and 0 <= c < m\n    \n    def node(r, c):\n        return 1 + m * r + c\n    \n    for x in range(n):\n        for y in range(m):\n            if '1' <= sci[x][y] <= '9':\n                link(src, node(x, y), ord(sci[x][y]) - ord('0'))\n            if '1' <= rec[x][y] <= '9':\n                link(n * n + node(x, y), snk, ord(rec[x][y]) - ord('0'))\n            \n            for X in range(n):\n                for Y in range(m):\n                    if sci[x][y] in ('Y', 'Z') or rec[X][Y] in ('Y', 'Z'):\n                        continue\n                    \n                    mark = [[0] * 10 for _ in range(10)]\n                    bq = deque()\n                    bq.append((x, y, 1))\n                    mark[x][y] = 1\n                    found = False\n                    \n                    while bq:\n                        cx, cy, t = bq.popleft()\n                        if cx == X and cy == Y:\n                            mark[cx][cy] = 1\n                            found = True\n                            break\n                        \n                        if t >= failAt[cx][cy] or t >= T:\n                            continue\n                        \n                        for di in (-1, 0, 1):\n                            for dj in (-1, 0, 1):\n                                if abs(di) + 