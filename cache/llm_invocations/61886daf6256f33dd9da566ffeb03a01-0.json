und + 1; j <= n; j++) {\n            total = total * j % MOD;\n        }\n\n        for (int j = 1; j <= n - bound; j++) {\n            total = total * modPow(j, MOD - 2) % MOD;\n        }\n\n        if (k != 0) {\n            total = total * 2 % MOD;\n        }\n\n        System.out.println(total);\n    }\n\n    private static long modPow(long x, long p) {\n        long res = 1;\n        x %= MOD;\n        while (p > 0) {\n            if ((p & 1) == 1) res = res * x % MOD;\n            x = x * x % MOD;\n            p >>= 1;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\nconst int MOD = 998244353;\n\nlong long modPow(long long x, long long p) {\n    long long res = 1;\n    x %= MOD;\n    while (p > 0) {\n        if ((p & 1) == 1) res = (res * x) % MOD;\n        x = (x * x) % MOD;\n        p >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    vector<string> tokens;\n    string token;\n    for (char c : line) {\n        if (c == ' ' || c == '\\t') {\n            if (!token.empty()) {\n                tokens.push_back(token);\n                token.clear();\n            }\n        } else {\n            token += c;\n        }\n    }\n    if (!token.empty()) {\n        tokens.push_back(token);\n    }\n    \n    int n = stoi(tokens[0]);\n    long long k = stoll(tokens[1]);\n    \n    if (k > n) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    int a = n - (int)k;\n    long long total = 0;\n    \n    if (a > 0) {\n        long long binom = 1;\n        for (int i = a; i > 0; i--) {\n            long long contribution = binom * modPow(i, n) % MOD;\n            if ((a - i) % 2 == 1) {\n                contribution = (MOD - contribution) %