          q.append((xx, yy))\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    n = int(data[idx]); idx += 1\n    t = int(data[idx]); idx += 1\n    field = []\n    capsule = []\n    for _ in range(n):\n        field.append(data[idx]); idx += 1\n    for _ in range(n):\n        capsule.append(data[idx]); idx += 1\n\n    Z = [[0]*15 for _ in range(15)]\n    S = [[0]*15 for _ in range(15)]\n    src = n * n * 2\n    sink = src + 1\n    F = Dinic(210)\n    F.init = lambda: None  # head already initialized in __init__\n    # Actually reinitialize\n    F = Dinic(210)\n    \n    x = y = 0\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                x, y = i, j\n    \n    for i in range(n):\n        for j in range(n):\n            if isDigit(capsule[i][j]):\n                F.add(i * n + j + n * n, sink, int(capsule[i][j]))\n    \n    INF = 10**9\n    bfs(x, y, Z, False, n, t, F, capsule, Z)  # Z is parameter, but careful: Z is used as distance? Actually in bfs Z is passed as last parameter, which is the Z array defined earlier. This is tricky.\n    # The original code uses Z as both the global array and the parameter in bfs. We need to fix: The bfs function uses Z[xx][yy] from the passed array (which is global Z). In the first call, we pass Z itself as the last argument, meaning it reads from the same Z that is being updated. That is intentional? In original code: bfs(x,y,Z,false); where Z is the global array. So we need to pass the global Z.\n    \n    for i in range(n):\n        for j in range(n):\n            if isDigit(field[i][j]):\n                F.add(src, i * n + j, int(field[i][j]))\n                bfs(i, j, S, True, n, t, F, capsule, Z)\n    \n    print(F.dinic(src, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-1.5258673e-05, 0.0, -5.960463e-07, -0.0015316195, -0.06349286, -0.00026615892