 ((mask & (1 << b)) && !(prev & (1 << b))) {\n                    nextSt |= 1LL << id[prev | (1 << b)];\n                }\n            }\n        }\n        total = (total + 1LL * f[pos][mask] * compute(pos + 1, nextSt)) % MOD;\n    }\n    \n    return dpMemo[key] = total;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    cin >> n;\n    int inv100 = modExp(100, MOD - 2);\n    \n    for (int i = 0; i < n; i++) {\n        f[i][0] = 1;\n        for (int j = 0; j < n; j++) {\n            int P;\n            cin >> P;\n            int p1 = (1LL * P * inv100) % MOD;\n            int p0 = (1 + MOD - p1) % MOD;\n            for (int k = 0; k < (1 << j); k++) {\n                f[i][k | (1 << j)] = (1LL * f[i][k] * p1) % MOD;\n                f[i][k] = (1LL * f[i][k] * p0) % MOD;\n            }\n        }\n    }\n    \n    for (int i = 0; i < (1 << n); i++) {\n        cnt[i] = cnt[i >> 1] + (i & 1);\n    }\n    \n    for (int i = 0; i < (1 << n); i++) {\n        vec[cnt[i]].push_back(i);\n        id[i] = vec[cnt[i]].size() - 1;\n    }\n    \n    cout << compute(0, 1) << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static int n, S;\n    static int[] cnt = new int[250];\n    static int[] id = new int[250];\n    static int[][] f = new int[10][250];\n    static Vector<Integer>[] vec = new Vector[10];\n    static Map<Long, Integer> dpMemo = new HashMap<>();\n\n    static long modExp(long base, long exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static int compute(int pos, long state) {\n        if (state =