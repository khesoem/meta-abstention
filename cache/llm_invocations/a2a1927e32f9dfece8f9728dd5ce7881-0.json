int f = 0; f <= fMoved; f++) {\n            for (int s = 0; s <= sMoved; s++) {\n                if (f + s > 0 && 2 * f + s <= maxCapacity) {\n                    long long ways = (comb[fMoved][f] * comb[sMoved][s]) % MOD;\n                    total = (total + ways * countWays(fatLeft + f, slimLeft + s, tripsLeft - 1, !leftBank)) % MOD;\n                }\n            }\n        }\n    }\n    return memo[fatLeft][slimLeft][tripsLeft][boatSide] = total;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    int cap_input;\n    cin >> cap_input;\n    maxCapacity = cap_input / 50;\n    totalFat = 0;\n    totalSlim = 0;\n\n    for (int i = 0; i < n; i++) {\n        int w;\n        cin >> w;\n        if (w == 100) totalFat++;\n        else totalSlim++;\n    }\n\n    memset(memo, -1, sizeof(memo));\n\n    for (int i = 0; i <= 50; i++) {\n        comb[i][0] = 1;\n        for (int j = 1; j <= i; j++) {\n            comb[i][j] = (comb[i-1][j-1] + comb[i-1][j]) % MOD;\n        }\n    }\n\n    for (int t = 1; t <= 200; t++) {\n        long long ans = countWays(totalFat, totalSlim, t, true);\n        if (ans != 0) {\n            cout << t << endl;\n            cout << ans << endl;\n            return 0;\n        }\n    }\n    cout << -1 << endl;\n    cout << 0 << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014137222024146467, -1.4305104514278355e-06, -2.0265558760002023e-06, -0.007761085405945778, -9.536738616588991e-07, -1.3232143828645349e-05, -8.344646857949556e-07, -3.576272320060525e-06, 0.0, -0.24366985261440277, -1.5497195136049413e-06, -5.722029527532868e-06, -9.536738616588991e-07, -0.06025160849094391, -5.9960475482512265e-05, -0.0008048156159929931, -1.490105023549404e-05, -0.6017348766326904, -0.0009120118920691311, -0.054887495934963226, -2.0265558760002023e-06, -0.4609413743019104, -0.11282447725534439, -0.05492134764790535, -9.179073458653875