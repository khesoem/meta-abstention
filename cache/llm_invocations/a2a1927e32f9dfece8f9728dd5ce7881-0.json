        } else {\n            int fMoved = totalFat - fatLeft;\n            int sMoved = totalSlim - slimLeft;\n            for (int f = 0; f <= fMoved; f++) {\n                for (int s = 0; s <= sMoved; s++) {\n                    if (f + s > 0 && 2 * f + s <= maxCapacity) {\n                        long ways = (comb[fMoved][f] * comb[sMoved][s]) % MOD;\n                        total = (total + ways * countWays(fatLeft + f, slimLeft + s, tripsLeft - 1, !leftBank)) % MOD;\n                    }\n                }\n            }\n        }\n        return memo[fatLeft][slimLeft][tripsLeft][boatSide] = total;\n    }\n\n    static long modExp(long base, long exp, long mod) {\n        long res = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % mod;\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        int n = Integer.parseInt(br.readLine().trim());\n        maxCapacity = Integer.parseInt(br.readLine().trim()) / 50;\n        totalFat = 0;\n        totalSlim = 0;\n        for (int i = 0; i < n; i++) {\n            int w = Integer.parseInt(br.readLine().trim());\n            if (w == 100) totalFat++;\n            else totalSlim++;\n        }\n\n        memo = new long[totalFat + 1][totalSlim + 1][201][2];\n        for (int i = 0; i <= totalFat; i++) {\n            for (int j = 0; j <= totalSlim; j++) {\n                for (int k = 0; k <= 200; k++) {\n                    memo[i][j][k][0] = -1;\n                    memo[i][j][k][1] = -1;\n                }\n            }\n        }\n\n        comb = new long[51][51];\n        for (int i = 0; i <= 50; i++) {\n            comb[i][0] = 1;\n            for (int j = 1; j <= i; j++) {\n                comb[i][j] = (comb[i-1][j-1] + comb[i-1][j]) % MOD;\n            }\