          in_queue[u] = 0;\n                \n                for (int i = 0; i < graph.get(u).size(); ++i) {\n                    Edge e = graph.get(u).get(i);\n                    if (e.flow < e.cap && dist[u] + e.cost < dist[(int)e.to]) {\n                        dist[(int)e.to] = dist[u] + e.cost;\n                        parent[(int)e.to] = u;\n                        parent_edge_idx[(int)e.to] = i;\n                        if (in_queue[(int)e.to] == 0) {\n                            q.offer((int)e.to);\n                            in_queue[(int)e.to] = 1;\n                        }\n                    }\n                }\n            }\n            \n            if (dist[(int)t] == INF) break;\n            \n            long flow_add = k_in - total_flow;\n            for (long v = t; v != s; v = parent[v]) {\n                long u = parent[v];\n                int idx = parent_edge_idx[(int)v];\n                flow_add = Math.min(flow_add, graph.get((int)u).get(idx).cap - graph.get((int)u).get(idx).flow);\n            }\n            \n            for (long v = t; v != s; v = parent[v]) {\n                long u = parent[v];\n                int idx = parent_edge_idx[(int)v];\n                int rev_idx = graph.get((int)u).get(idx).rev;\n                graph.get((int)u).get(idx).flow += flow_add;\n                graph.get((int)v).get(rev_idx).flow -= flow_add;\n                total_cost += graph.get((int)u).get(idx).cost * flow_add;\n            }\n            \n            total_flow += flow_add;\n        }\n        \n        System.out.println(total_cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019500737835187465, -3.933898824470816e-06, -8.344646857949556e-07, -0.0016776548000052571, -5.864924969500862e-05, -0.07890131324529648, -0.11293043196201324, -2.6702524337451905e-05, -8.344646857949556e-07, -4.625213477993384e-05, -0.016034699976444244, -0.00023135847004596144, -0.0007433511782437563, -0.110