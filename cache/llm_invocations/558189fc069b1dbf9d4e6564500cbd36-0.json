\\n\";\n    }\n    cout << \"\\n\";\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> K;\n    \n    // Convert N to base-K digits\n    vector<int> digits;\n    ll base = 1;\n    while (base <= N) {\n        if (base > N / K) break;\n        base *= K;\n    }\n    if (base > N) base /= K;\n    \n    ll temp = base;\n    while (temp > 0) {\n        digits.push_back(N / temp);\n        N %= temp;\n        temp /= K;\n    }\n    reverse(digits.begin(), digits.end());\n    \n    int cnt = digits.size();\n    \n    // Pre-allocate R matrices\n    for (int j = 0; j <= K; ++j) {\n        R[j] = vector<vector<ll>>(K + 1, vector<ll>(K + 1, 0LL));\n    }\n    \n    // Pre-allocate D matrices\n    for (int i = 0; i <= cnt; ++i) {\n        for (int j = 0; j < K; ++j) {\n            D[i][j] = vector<vector<ll>>(K + 1, vector<ll>(K + 1, 0LL));\n        }\n    }\n    \n    // Setup R[0], R[1]\n    R[0][K][K] = R[1][K][K] = 1;\n    for (int j = 0; j < K; ++j) {\n        R[0][j][j] = 1;\n        R[1][(j + K - 1) % K][j] = 1;\n    }\n    \n    // Build R[j] for j >= 2\n    for (int j = 2; j <= K; ++j) {\n        R[j] = mat_mult(R[j - 1], R[1]);\n    }\n    \n    // Initialize D[0][0]\n    for (int j = 0; j <= K; ++j) {\n        D[0][0][j][j] = 1;\n        D[0][0][j][0] = 1;\n    }\n    \n    // Build D matrices\n    for (int i = 0; i <= cnt; ++i) {\n        for (int j = 1; j < K; ++j) {\n            vector<vector<ll>> temp1 = mat_mult(R[K - j], D[i][0]);\n            vector<vector<ll>> temp2 = mat_mult(temp1, R[j]);\n            D[i][j] = mat_mult(D[i][j - 1], temp2);\n        }\n        if (i < cnt) {\n            D[i + 1][0] = D[i][K - 1];\n        }\n    }\n    \n    // Final computation\n    vector<vector<ll>> res(1, vector<ll>(K + 1, 0LL));\n    res[0][K] = 1;\n    int mod_state = 0;\n    \n    for (int i = 0; i < cnt; ++i) {\n        if (digits[i] != 0) {\n            vector<vector<ll>> temp1 = mat_mult(R[K - mod_state], D[cnt - i - 1][digits[i] - 1]);\n            vector<vector<ll>> temp2 = mat_mult(temp1, R[mod_state]);\n            res = mat_mult(res, temp2);\n        }\n        mod_state = (mod_state + digits[i]) % K;\n    }\n    \n    ll ans = 0;\n    for (int i = 0; i <= K; ++i) {\n        ans = (ans + res[0][i]) % MOD;\n    }\n    cout << ans << endl;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\nMAX_D = 100\nMAX_K = 40\n\ndef mat_mult(A, B):\n    n = len(A)\n    m = len(B)\n    p = len(B[0]) if B else 0\n    C = [[0] * p for _ in range(n)]\n    for i in range(n):\n        for k in range(m):\n            if A[i][k] != 0:\n                for j in range(p):\n                    C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD\n    return C\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n    \n    # Convert N to base-K digits\n    digits = []\n    base = 1\n    while base <= N:\n        if base > N // K:\n            break\n        base *= K\n    if base > N:\n        base //= K\n    \n    temp = base\n    while temp > 0:\n        digits.append(N // temp)\n        N %= temp\n        temp //= K\n    digits.reverse()\n    \n    cnt = len(digits)\n    \n    # Pre-allocate R matrices\n    R = {}\n    for j in range(K + 1):\n        R[j] = [[0] * (K + 1) for _ in range(K + 1)]\n    \n    # Pre-allocate D matrices\n    D = {}\n    for i in range(cnt + 1):\n        D[i] = {}\n        for j in range(K):\n            D[i][j] = [[0] * (K + 1) for _ in range(K + 1)]\n    \n    # Setup R[0], R[1]\n    R[0][K][K] = 1\n    R[1][K][K] = 1\n    for j in range(K):\n        R[0][j][j] = 1\n        R[1][(j + K - 1) % K][j] = 1\n    \n    # Build R[j] for j >= 2\n    for j in range(2, K + 1):\n        R[j] = mat_mult(R[j - 1], R[1])\n    \n    # Initialize D[0][0]\n    for j in range(K + 1):\n        D[0][0][j][j] = 1\n        D[0][0][j][0] = 1\n    \n    # Build D matrices\n    for i in range(cnt + 1):\n        for j in range(1, K):\n            temp1 = mat_mult(R[K - j], D[i][0])\n            temp2 = mat_mult(temp1, R[j])\n            D[i][j] = mat_mult(D[i][j - 1], temp2)\n        if i < cnt:\n            D[i + 1][0] = D[i][K - 1]\n    \n    # Final computation\n    res = [[0] * (K + 1)]\n    res[0][K] = 1\n    mod_state = 0\n    \n    for i in range(cnt):\n        if digits[i] != 0:\n            temp1 = mat_mult(R[K - mod_state], D[cnt - i - 1][digits[i] - 1])\n            temp2 = mat_mult(temp1, R[mod_state])\n            res = mat_mult(res, temp2)\n        mod_state = (mod_state + digits[i]) % K\n    \n    ans = 0\n    for i in range(K + 1):\n        ans = (ans + res[0][i]) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012694983161054552, -9.536738616588991e-07, -1.1920928244535389e-07, -0.017678897827863693, -0.0001685477327555418, -0.011072029359638691, -0.14304421842098236, 0.0, 0.0, 0.0, -3.576278118089249e-07, -0.000380324519937858, -1.1920928244535389e-07, -3.135155202471651e-05, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.01815534569323063, -0.6933164596557617, -1.156323378381785e-05, -4.6491513785440475e-06, -1.1920928244535389e-07, 0.0, 0.0, -1.0728830375228426e-06, -8.344646857949556e-07, -0.00023338454775512218, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, -8.344646857949556e-07, -0.00026341783814132214, -1.3470558769768104e-05, -0.037652648985385895, -0.9706099629402161, -0.00012468514614738524, -5.960446742392378e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -0.020544586703181267, -1.1920928244535389e-07, -7.867782187531702e-06, -1.6689286894688848e-06, -0.00014590153296012431, 0.0, -1.4305104514278355e-06, 0.0, -3.576278118089249e-07, -2.9802276912960224e