[1] = 1;\n    long long answer = 0;\n    \n    for (int step = 1; step < 2 * n; step++) {\n        int maxPrev = min(2 * n - step, step);\n        int maxNext = min(2 * n - step - 1, step + 1);\n        \n        for (int running = 0; running <= maxPrev; running++) {\n            long long cur = dp[step - 1][running];\n            if (cur == 0) continue;\n            \n            if (running > 0) {\n                long long term = cur * running % MOD;\n                term = term * inv[2 * n - step] % MOD;\n                dp[step][running - 1] = (dp[step][running - 1] + term) % MOD;\n            }\n            \n            if (running < maxNext) {\n                long long term = cur * (2 * n - step - running) % MOD;\n                term = term * inv[2 * n - step] % MOD;\n                dp[step][running + 1] = (dp[step][running + 1] + term) % MOD;\n            }\n            \n            if (running >= k) {\n                answer = (answer + cur) % MOD;\n            }\n        }\n    }\n    \n    if (k <= 1) {\n        answer = (answer + dp[2 * n - 1][1]) % MOD;\n    }\n    \n    answer = answer * l % MOD;\n    answer = answer * inv[2 * n + 1] % MOD;\n    cout << answer << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012003655137959868, -1.311301275563892e-06, -3.576278118089249e-07, -9.381330892210826e-05, -8.344646857949556e-07, -2.145764938177308e-06, -2.3841830625315197e-06, -1.9073468138230965e-06, -1.1920928244535389e-07, -0.010525665245950222, -4.6491513785440475e-06, -8.535020606359467e-05, -8.344646857949556e-07, -0.38748064637184143, -0.14267829060554504, -0.03806643187999725, -9.298280929215252e-06, -1.6689286894688848e-06, -5.960462772236497e-07, -0.0030119314324110746, -5.364403477869928e-06, -6.198863957251888e-06, 0.0, -3.6954811548639555e-06, -0.14065983891487122, -0.05492258816957474, -3.4570634852570947e-06, -9.512448741588742e-05, -0.00030155404238030314, -0.000143517681863