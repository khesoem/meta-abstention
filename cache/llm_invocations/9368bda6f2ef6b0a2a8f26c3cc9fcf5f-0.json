tR : distL;\n            ll chosenNum = useR ? candR : candL;\n            if ((float)chosenDist < (float)best) {\n                best = chosenDist;\n                bestNum = chosenNum;\n                bestDen = denom;\n            }\n        }\n    }\n    ll g = gcd(bestNum, bestDen);\n    cout << bestNum / g << \"/\" << bestDen / g;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static long gcd(long a, long b) {\n        while (b != 0) {\n            long t = a % b;\n            a = b;\n            b = b;\n        }\n        return a;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long x = sc.nextLong();\n        long y = sc.nextLong();\n        long n = sc.nextLong();\n        if (y <= n) {\n            long g = gcd(x, y);\n            System.out.println(x / g + \"/\" + y / g);\n            return;\n        }\n        if (x == y) {\n            System.out.println(\"1/1\");\n            return;\n        }\n        double goal = (double) x / y;\n        double best = 1e18;\n        long bestNum = 0, bestDen = 0;\n        long left = 0, right = y;\n        for (long denom = 1; denom <= n; ++denom) {\n            while (denom * x > right) {\n                left += y;\n                right += y;\n            }\n            if (denom * x >= left && denom * x <= right) {\n                long candL = left / y;\n                long candR = right / y;\n                double distL = Math.abs(goal - (double) candL / denom);\n                double distR = Math.abs(goal - (double) candR / denom);\n                boolean useR = distR < distL;\n                double chosenDist = useR ? distR : distL;\n                long chosenNum = useR ? candR : candL;\n                if ((float) chosenDist < (float) best) {\n   