ultiplier) % MOD);\n        \n        pw.close();\n    }\n    \n    public static long binomial(int n, int k) {\n        long denominator = (factorial[k] * factorial[n - k]) % MOD;\n        long invDenom = modPow(denominator, MOD - 2, MOD);\n        return (factorial[n] * invDenom) % MOD;\n    }\n    \n    public static long modPow(long base, long exp, long mod) {\n        if (exp < 0) return 0L;\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n    \n    static class FastScanner {\n        BufferedReader br;\n        StringTokenizer st;\n        \n        public FastScanner() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n        \n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n        \n        int ni() {\n            return Integer.parseInt(next());\n        }\n        \n        long nl() {\n            return Long.parseLong(next());\n        }\n        \n        double nd() {\n            return Double.parseDouble(next());\n        }\n        \n        String nextLine() {\n            String str = \"\";\n            try {\n                str = br.readLine();\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n            return str;\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nMOD = 998244353\n\ndef mod_pow(base, exp, mod):\n    if exp < 0:\n        return 0\n    result = 1\n    base %= mod\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return result\n\ndef precompute_factorials(max_n):\n    factorial = [1] * (max_n + 1)\n    for i in range(1, max_n + 1):\n        factorial[i] = (i * factorial[i-1]) % MOD\n    return factorial\n\ndef binomial(n, k, factorial):\n    denominator = (factorial[k] * factorial[n - k]) % MOD\n    inv_denom = mod_pow(denominator, MOD - 2, MOD)\n    return (factorial[n] * inv_denom) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    N = int(data[0])\n    K = int(data[1])\n    \n    if K >= N:\n        print(0)\n        return\n    \n    C = N - K\n    \n    max_fact = 200000\n    factorial = precompute_factorials(max_fact)\n    \n    ans = 0\n    sign = 1\n    for i in range(C, 0, -1):\n        val = (binomial(C, i, factorial) * mod_pow(i, N, MOD)) % MOD\n        ans = (ans + sign * val + 2 * MOD) % MOD\n        sign *= -1\n    \n    if C == N:\n        multiplier = 1\n    else:\n        multiplier = (2 * binomial(N, C, factorial)) % MOD\n    \n    result = (ans * multiplier) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.357491217087954e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -9.321732068201527e-05, -0.004727496299892664, -0.0003361137059982866, -0.007195273879915476, -0.0018353299237787724, -0.08894043415784836, -0.0001037067049765028, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -3.576278118089249e-07, -6.437280717364047e-06, -7.152531907195225e-06, -1.7881377516459906e-06, -8.070142939686775e-05, -4.768360213347478e-06, -8.344646857949556e-07, -0.011049393564462662, -0.789011538028717, -0.006187449675053358, -0.0766376182436943, -1.5497195136049413e-06, -1.1920928244535389e-07, -1.013273