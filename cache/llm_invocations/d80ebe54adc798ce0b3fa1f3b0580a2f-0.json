{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing big = long long;\nstruct vert;\nstruct edge;\nusing vptr = shared_ptr<vert>;\nusing eptr = shared_ptr<edge>;\nstruct vert {\n    int mark;\n    vector<eptr> edges;\n    eptr parent;\n};\nstruct edge {\n    vptr from, to;\n    int flow;\n    eptr twin;\n};\nint INF = 1 << 30;\nint augment(eptr e, int f) {\n    if (!e) return f;\n    f = augment(e->from->parent, min(f, e->flow));\n    e->flow -= f;\n    e->twin->flow += f;\n    return f;\n}\nvoid connect(vptr& a, vptr& b, int w) {\n    eptr e1 = make_shared<edge>();\n    eptr e2 = make_shared<edge>();\n    e1->from = a; e1->to = b; e1->flow = w; e1->twin = e2;\n    e2->from = b; e2->to = a; e2->flow = 0; e2->twin = e1;\n    a->edges.push_back(e1);\n    b->edges.push_back(e2);\n}\nint maxFlow(vector<vptr>& g, vptr& src, vptr& snk) {\n    int ans = 0;\n    while (true) {\n        for (auto u : g) u->mark = 0;\n        queue<vptr> q;\n        q.push(src); src->mark = 1;\n        while (!(q.empty() || snk->mark != 0)) {\n            auto u = q.front(); q.pop();\n            for (auto e : u->edges) {\n                auto v = e->to;\n                if (v->mark != 0 || e->flow == 0) continue;\n                v->parent = e;\n                v->mark = u->mark + 1;\n                q.push(v);\n            }\n        }\n        if (snk->mark == 0) break;\n        for (auto e : snk->edges) {\n            auto rev = e->twin;\n            if (rev->from->mark != snk->mark - 1 || rev->flow == 0) continue;\n            ans += augment(rev, rev->flow);\n        }\n    }\n    return ans;\n}\nint main() {\n    ios::sync_with_stdio(0); cin.tie(0);\n    big n, steps;\n    while (cin >> n >> steps) {\n        vector<string> M(n);\n        big sz = (steps + 1) * n * n + 2;\n        vector<vptr> V(sz);\n        for (auto& v : V) v = make_shared<vert>();\n        big srcIdx = (steps * n * n) + (n - 1) * n + (n - 1) + 1;\n        big snkIdx = (steps * n * n) + (n - 1) * n + (n - 1) + 2;\n        vptr S = V[srcIdx];\n        vptr T = V[snkIdx];\n        vector<pair<big,big>> zombies;\n        for (big r = 0; r < n; r++) {\n            cin >> M[r];\n            for (big c = 0; c < n; c++) {\n                if (M[r][c] == 'Y') continue;\n                if (M[r][c] == 'Z') {\n                    zombies.push_back({r, c});\n                    continue;\n                }\n                connect(S, V[r * n + c], M[r][c] - '0');\n                M[r][c] = '0';\n            }\n        }\n        for (big r = 0; r < n; r++) {\n            string row; cin >> row;\n            for (big c = 0; c < n; c++) {\n                if (row[c] == 'Y' || row[c] == 'Z') continue;\n                connect(V[steps * n * n + r * n + c], T, row[c] - '0');\n            }\n        }\n        const big dr[] = {1, 0, -1, 0};\n        const big dc[] = {0, 1, 0, -1};\n        for (big t = 0; t < steps; t++) {\n            for (big r = 0; r < n; r++) {\n                for (big c = 0; c < n; c++) {\n                    connect(V[t * n * n + r * n + c], V[(t+1) * n * n + r * n + c], INF);\n                    if (M[r][c] != '0') continue;\n                    for (big d = 0; d < 4; d++) {\n                        big nr = r + dr[d];\n                        big nc = c + dc[d];\n                        if (nr < 0 || nr >= n || nc < 0 || nc >= n || M[nr][nc] != '0') continue;\n                        connect(V[t * n * n + r * n + c], V[(t+1) * n * n + nr * n + nc], INF);\n                    }\n                }\n            }\n            vector<pair<big,big>> nz;\n            for (auto& p : zombies) {\n                big r, c; tie(r, c) = p;\n                for (big d = 0; d < 4; d++) {\n                    big nr = r + dr[d];\n                    big nc = c + dc[d];\n                    if (nr < 0 || nr >= n || nc < 0 || nc >= n || M[nr][nc] != '0') continue;\n                    nz.push_back({nr, nc});\n                    M[nr][nc] = 'Z';\n                }\n            }\n            swap(nz, zombies);\n        }\n        cout << maxFlow(V, S, T) << '\\n';\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(1000000)\n\nclass Vert:\n    def __init__(self):\n        self.mark = 0\n        self.edges = []\n        self.parent = None\n\nclass Edge:\n    def __init__(self):\n        self.from_ = None\n        self.to = None\n        self.flow = 0\n        self.twin = None\n\nINF = 1 << 30\n\ndef augment(e, f):\n    if e is None:\n        return f\n    f = augment(e.from_.parent, min(f, e.flow))\n    e.flow -= f\n    e.twin.flow += f\n    return f\n\ndef connect(a, b, w):\n    e1 = Edge()\n    e2 = Edge()\n    e1.from_ = a\n    e1.to = b\n    e1.flow = w\n    e1.twin = e2\n    e2.from_ = b\n    e2.to = a\n    e2.flow = 0\n    e2.twin = e1\n    a.edges.append(e1)\n    b.edges.append(e2)\n\ndef maxFlow(g, src, snk):\n    ans = 0\n    while True:\n        for u in g:\n            u.mark = 0\n        q = [src]\n