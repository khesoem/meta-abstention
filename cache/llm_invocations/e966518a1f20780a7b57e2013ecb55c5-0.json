{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\n#define maxn 5000010\n#define inf 1000000000\nusing namespace std;\n\nint n, m, k, v1, v2, s, t;\nint dis[maxn], pot[maxn];\nbool vis[maxn];\nstruct edge {\n    int to, nxt, v, c;\n} e[maxn];\nint head[maxn], edge_cnt = 1;\n\nvoid add(int from, int to, int val, int cost) {\n    e[++edge_cnt] = {to, head[from], val, cost};\n    head[from] = edge_cnt;\n    e[++edge_cnt] = {from, head[to], 0, -cost};\n    head[to] = edge_cnt;\n}\n\nbool dijkstra() {\n    priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;\n    for (int i = s; i <= t; ++i) dis[i] = inf, vis[i] = false;\n    dis[s] = 0;\n    pq.push({0, s});\n    while (!pq.empty()) {\n        int d = pq.top().first, x = pq.top().second; pq.pop();\n        if (vis[x]) continue;\n        vis[x] = true;\n        for (int i = head[x]; i; i = e[i].nxt) {\n            int y = e[i].to, c = e[i].c + pot[x] - pot[y];\n            if (dis[y] > dis[x] + c && e[i].v) {\n                dis[y] = dis[x] + c;\n                pq.push({dis[y], y});\n            }\n        }\n    }\n    for (int i = s; i <= t; ++i)\n        if (dis[i] < inf) pot[i] += dis[i];\n    return dis[t] != inf;\n}\n\nint dfs(int x, int lim) {\n    if (x == t) return lim;\n    vis[x] = true;\n    int flow, res = lim;\n    for (int i = head[x]; i; i = e[i].nxt) {\n        int y = e[i].to, v = e[i].v;\n        int rc = e[i].c + pot[x] - pot[y];\n        if (dis[y] != dis[x] + rc || !v || vis[y]) continue;\n        flow = dfs(y, min(res, v));\n        if (flow) {\n            res -= flow;\n            e[i].v -= flow;\n            e[i ^ 1].v += flow;\n            if (!res) break;\n        }\n    }\n    return lim - res;\n}\n\nint dinic() {\n    int flow, sum = 0;\n    memset(pot, 0, sizeof(pot));\n    while (dijkstra())\n        while (flow = dfs(s, inf))\n            sum += flow * (pot[t] - pot[s]);\n    return sum;\n}\n\nint main() {\n    auto read = [](int &x) {\n        x = 0; char c = getchar(); bool flag = false;\n        while (!isdigit(c)) { if (c == '-') flag = true; c = getchar(); }\n        while (isdigit(c)) { x = (x << 1) + (x << 3) + (c ^ 48); c = getchar(); }\n        if (flag) x = -x;\n    };\n    read(n); read(m); read(k); read(v1); read(v2);\n    t = n * 110 + 1;\n    for (int i = 2; i <= 110; ++i) add(1 + (i - 1) * n, t, inf, 0);\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 110; ++j)\n            add(i + (j - 1) * n, i + j * n, inf, v1);\n    for (int i = 1, x; i <= k; ++i) { read(x); add(s, x, 1, 0); }\n    for (int i = 1; i <= m; ++i) {\n        int x, y; read(x); read(y);\n        for (int j = 1; j < 110; ++j)\n            for (int l = 1; l <= k; ++l) {\n                add(x + (j - 1) * n, y + j * n, 1, v2 * (2 * l - 1) + v1);\n                add(y + (j - 1) * n, x + j * n, 1, v2 * (2 * l - 1) + v1);\n            }\n    }\n    printf(\"%d\", dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**9\n\ndef solve():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    v1 = next(it)\n    v2 = next(it)\n    \n    s = 0\n    t = n * 110 + 1\n    \n    head = [-1] * (t + 1)\n    edges = []  # each edge: [to, nxt, cap, cost]\n    \n    def add_edge(u, v, cap, cost):\n        edges.append([v, head[u], cap, cost])\n        head[u] = len(edges) - 1\n        edges.append([u, head[v], 0, -cost])\n        head[v] = len(edges) - 1\n    \n    # edges from last layer to sink (only for node 1)\n    for i in range(2, 111):\n        add_edge(1 + (i - 1) * n, t, INF, 0)\n    \n    # vertical edges for nodes 2..n\n    for i in range(2, n + 1):\n        for j in range(1, 110):\n            add_edge(i + (j - 1) * n, i + j * n, INF, v1)\n    \n    # source edges\n    for _ in range(k):\n        x = next(it)\n        add_edge(s, x, 1, 0)\n    \n    # pair edges\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for j in range(1, 110):\n            for l in range(1, k + 1):\n                cost = v2 * (2 * l - 1) + v1\n                add_edge(x + (j - 1) * n, y + j * n, 1, cost)\n                add_edge(y + (j - 1) * n, x + j * n, 1, cost)\n    \n    dis = [0] * (t + 1)\n    pot = [0] * (t + 1)\n    vis = [False] * (t + 1)\n    \n    def dijkstra():\n        for i in range(s, t + 1):\n            dis[i] = INF\n            vis[i] = False\n        dis[s] = 0\n        pq = [(0, s)]\n        while pq:\n            d, x = heapq.heappop(pq)\n            if vis[x]:\n                continue\n            vis[x] = True\n            i = head[x]\n            while i != -1:\n                y = edges[i][0]\n                c = edges[i][3] + pot[x] - pot[y]\n                if dis[y] > dis[x] + c and edges[i][2] > 0:\n                    dis[y] = dis[x] + c\n                    heapq.heappush(pq, (dis[y], y))\n                i = edges[i][1]\n        for i in range(s, t + 1):\n            if dis[i] < INF:\n                pot[i] += dis[i]\n        return dis[t] != INF\n    \n    def dfs_iterative(lim):\n        # returns flow\n        stack = [(s, head[s], lim)]  # (node, next_edge_index, flow_so_far)\n        path = []  # list of edge indices taken\n        while stack:\n            x, i, flow = stack[-1]\n            if x == t:\n                # augment\n                for e_idx in path:\n                    edges[e_idx][2] -= flow\n                    edges[e_idx ^ 1][2] += flow\n                return flow\n            found = False\n            while i != -1:\n                y = edges[i][0]\n                cap = edges[i][2]\n                rc = edges[i][3] + pot[x] - pot[y]\n                if dis[y] == dis[x] + rc and cap > 0 and not vis[y]:\n                    vis[y] = True\n                    path.append(i)\n                    # update current node's next edge pointer\n                    stack[-1] = (x, edges[i][1], flow)\n                    # push child\n                    stack.append((y, head[y], min(flow, cap)))\n                    found = True\n                    break\n                i = edges[i][1]\n            if not found:\n                stack.pop()\n                if path:\n                    path.pop()\n                # vis is not reset\n        return 0\n    \n    total_flow = 0\n    while dijkstra():\n        while True:\n            flow = dfs_iterative(INF)\n            if flow == 0:\n                break\n            total_flow += flow * (pot[t] - pot[s])\n    print(total_flow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-7.152531907195225e-06, 0.0, 0.0, -0.00016759421851020306, -0.00020704510097857565, -1.7881377516459906e-06, -0.011049039661884308, -1.1920928244535389e-07, -7.033323527139146e-06, -0.0009145130170509219, -0.16031895577907562, -2.3841855067985307e-07, -4.768360