ate() {\n\tint f = aug[t];\n\tint cur = t;\n\twhile (cur != s) {\n\t\tint e = prevv[cur];\n\t\tcap[e] -= f;\n\t\tcap[e ^ 1] += f;\n\t\tcur = to[e ^ 1];\n\t}\n\ttotal += f * ddist[t];\n}\nint main() {\n\tscanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n\tt = (n + k - 1) * n + 1;\n\tfor (int i = 1, x; i <= k; i++) {\n\t\tscanf(\"%d\", &x);\n\t\tlink(s, x, 1, 0);\n\t}\n\tfor (int i = 1, u, v; i <= m; i++) {\n\t\tscanf(\"%d%d\", &u, &v);\n\t\tfor (int lvl = 1; lvl <= n + k; lvl++) {\n\t\t\tfor (int hop = 1; hop <= k; hop++) {\n\t\t\t\tint w = d * hop * 2 - d + c;\n\t\t\t\tlink(u + (lvl - 1) * n, v + lvl * n, 1, w);\n\t\t\t\tlink(v + (lvl - 1) * n, u + lvl * n, 1, w);\n\t\t\t}\n\t\t}\n\t}\n\tfor (int lvl = 1; lvl < n + k; lvl++) {\n\t\tfor (int node = 2; node <= n; node++) {\n\t\t\tlink(node + (lvl - 1) * n, node + lvl * n, 1000000000, c);\n\t\t}\n\t\tlink(1 + (lvl - 1) * n, 1 + lvl * n, 1000000000, 0);\n\t}\n\twhile (dijkstra_like()) flow_update();\n\tprintf(\"%d\\n\", total);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 10000010;\n    static final int INF = 0x3f3f3f3f;\n    \n    static int n, m, c, d, k, s, t, total;\n    static int idx = 1;\n    static int[] adj = new int[MAXN];\n    static int[] to = new int[MAXN];\n    static int[] nxt = new int[MAXN];\n    static int[] cap = new int[MAXN];\n    static int[] cost = new int[MAXN];\n    static int[] ddist = new int[MAXN];\n    static int[] aug = new int[MAXN];\n    static int[] prevv = new int[MAXN];\n    static boolean[] inq = new boolean[MAXN];\n    \n    static void link(int u, int v, int c_val, int w) {\n        to[++idx] = v;\n        nxt[idx] = adj[u];\n        adj[u] = idx;\n        cap[idx] = c_val;\n        cost[idx] = w;\n        \n        to[++idx] = u;\n        nxt[idx] = adj[v];\n        adj[v] = idx;\n        cap[idx] = 0;\n        cost[idx] = -w;\n    }\n    \n    static boolean dijkstra_like() {\n        Arrays.fill(aug, 0);\n        Arrays.fill(ddist, INF);\n        Arrays.fill(inq, false);\n        \n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        aug[s] = INF;\n        ddist[s] = 0;\n        inq[s] = true;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            \n            for (int e = adj[u]; e != 0; e = nxt[e]) {\n                if (cap[e] == 0 || ddist[to[e]] <= ddist[u] + cost[e]) continue;\n                \n                ddist[to[e]] = ddist[u] + cost[e];\n                aug[to[e]] = Math.min(aug[u], cap[e]);\n                prevv[to[e]] = e;\n                \n                if (!inq[to[e]]) {\n                    inq[to[e]] = true;\n                    q.offer(to[e]);\n                }\n            }\n        }\n        \n        return ddist[t] != INF;\n    }\n    \n    static void flow_update() {\n        int f = aug[t];\n        int cur = t;\n        \n        while (cur != s) {\n            int e = prevv[cur];\n            cap[e] -= f;\n            cap[e ^ 1] += f;\n            cur = to[e ^ 1];\n        }\n        \n        total += f * ddist[t];\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        k = scanner.nextInt();\n        c = scanner.nextInt();\n        d = scanner.nextInt();\n        \n        t = (n + k - 1) * n + 1;\n        s = 0;\n        \n        for (int i = 1; i <= k; i++) {\n            int x = scanner.nextInt();\n            link(s, x, 1, 0);\n        }\n        \n        for (int i = 1; i <= m; i++) {\n            int u = scanner.nextInt();\n            int v = scanner.nextInt();\n            for (int lvl = 1; lvl <= n + k; lvl++) {\n                for (int hop = 1; hop <= k; hop++) {\n                    int w = d * hop * 2 - d + c;\n                    link(u + (lvl - 1) * n, v + lvl * n, 1, w);\n                    link(v + (lvl - 1) * n, u + lvl * n, 1, w);\n                }\n            }\n        }\n        \n        for (int lvl = 1; lvl < n + k; lvl++) {\n            for (int node = 2; node <= n; node++) {\n                link(node + (lvl - 1) * n, node + lvl * n, 1000000000, c);\n            }\n            link(1 + (lvl - 1) * n, 1 + lvl * n, 1000000000, 0);\n        }\n        \n        while (dijkstra_like()) {\n            flow_update();\n        }\n        \n        System.out.println(total);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012289722508285195, -2.3841830625315197e-06, -8.344646857949556e-07, -0.0032948751468211412, -4.2676016164477915e-05, -0.048591189086437225, -0.14282174408435822, -5.006777428206988e-06, -1.1920928244535389e-07, -6.568216485902667e-05, -0.0007103541865944862, -2.3841830625315197e-06, -0.009459435939788818, -0.0007188120507635176, -2.622600959512056e-06, -8.093983342405409e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -2.50339189733495e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -1.0371154530730564e-05, -2.50339189733495e-06, -2.753696753643453e-05, -4.768370445162873e-07, 0.0, -1.5497195136049413e-06, -3.2186455882765586e-06, -1.0728830375228426e-06, -5.2927523938706145e-05, -8.4638240878121e-06, -7.510157047363464e-06, -3.576278118089249e-07, -1.0490362910786644e-05, 0.0, -1.6689160474925302e-05, -8.344646857949556e-07, -2.264974000354414e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, -9.536738616588991e-07, -5.960462772236497e-07, -0.007606353145092726, -0.2811570465564728, -1.0728830375228426e-06, -2.1815061700181104e-05, -0.0004951919545419514, -0.0014194899704307318, 0.0, -1.1920928244535389e-07, 0.0, -0.000553335587028414, -3.2066785934148356e-05, -5.8412379075889476e-06, -5.006777428206988e-06, -1.88348894880