n\n        ArrayList<ArrayList<Mint>> mat = new ArrayList<>(n);\n        for (int i = 0; i < n; i++) {\n            ArrayList<Mint> row = new ArrayList<>(n);\n            for (int j = 0; j < n; j++) {\n                int x = sc.nextInt();\n                row.add(new Mint(x).divide(new Mint(100)));\n            }\n            mat.add(row);\n        }\n\n        ArrayList<Pair<ArrayList<Integer>, Mint>> sts = new ArrayList<>();\n        ArrayList<Integer> initList = new ArrayList<>();\n        initList.add(0);\n        sts.add(new Pair<>(initList, Mint.one()));\n\n        for (int ph = 0; ph < n; ph++) {\n            ArrayList<Pair<ArrayList<Integer>, Mint>> nsts = new ArrayList<>();\n            int maxF = 1 << n;\n            for (int f = 1; f < maxF; f++) {\n                Mint freq = Mint.one();\n                for (int i = 0; i < n; i++) {\n                    if ((f >> i & 1) == 1) {\n                        freq = freq.multiply(mat.get(ph).get(i));\n                    } else {\n                        freq = freq.multiply(Mint.one().subtract(mat.get(ph).get(i)));\n                    }\n                }\n                for (Pair<ArrayList<Integer>, Mint> st : sts) {\n                    ArrayList<Integer> nst = new ArrayList<>();\n                    for (int d : st.getKey()) {\n                        for (int i = 0; i < n; i++) {\n                            if ((d >> i & 1) == 1) continue;\n                            if ((f >> i & 1) == 0) continue;\n                            nst.add(d ^ (1 << i));\n                        }\n                    }\n                    if (nst.isEmpty()) continue;\n                    Collections.sort(nst);\n                    ArrayList<Integer> uniqueNst = new ArrayList<>();\n                    for (int val : nst) {\n                        if (uniqueNst.isEmpty() || uniqueNst.get(uniqueNst.size() - 1) != val) {\n                            uniqueNst.add(val);\n                        }\n                    }\n                    nsts.add(new Pair<>(uniqueNst, st.getValue().multiply(freq)));\n                }\n            }\n\n            HashMap<ArrayList<Integer>, Mint> merged = new HashMap<>();\n            for (Pair<ArrayList<Integer>, Mint> p : nsts) {\n                merged.merge(p.getKey(), p.getValue(), (a, b) -> a.add(b));\n            }\n\n            ArrayList<Map.Entry<ArrayList<Integer>, Mint>> entries = new ArrayList<>(merged.entrySet());\n            Collections.sort(entries, new Comparator<Map.Entry<ArrayList<Integer>, Mint>>() {\n                @Override\n                public int compare(Map.Entry<ArrayList<Integer>, Mint> e1, Map.Entry<ArrayList<Integer>, Mint> e2) {\n                    ArrayList<Integer> l1 = e1.getKey();\n                    ArrayList<Integer> l2 = e2.getKey();\n                    int minLen = Math.min(l1.size(), l2.size());\n                    for (int i = 0; i < minLen; i++) {\n                        int cmp = Integer.compare(l1.get(i), l2.get(i));\n                        if (cmp != 0) return cmp;\n                    }\n                    return Integer.compare(l1.size(), l2.size());\n                }\n            });\n\n            sts.clear();\n            for (Map.Entry<ArrayList<Integer>, Mint> e : entries) {\n                sts.add(new Pair<>(e.getKey(), e.getValue()));\n            }\n        }\n\n        Mint ans = sts.isEmpty() ? Mint.zero() : sts.get(0).getValue();\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -9.894321920000948e-06, -0.002062100451439619, -1.764281842042692e-05, -3.576278118089249e-07, -0.0016608743462711573, -0.03804359585046768, -0.005236955359578133, -0.04348031431436539, -0.1602552831172943, -3.814624506048858e-05, 0.0, 0.0, -3.814689989667386e-06, -0.0019286142196506262, -2.9802276912960224e-06, 0.0, -3.576278118089249e-07, -0.0003432638186495751, -0.07955988496541977, 0.0, -0.005391580518335104, -4.7683704451628