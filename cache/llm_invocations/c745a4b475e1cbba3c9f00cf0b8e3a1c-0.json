 0; j < M; ++j) res.data[i][j] = add(data[i][j], other.data[i][j]);\n        return res;\n    }\n\n    Matrix<N, M> operator*(int scalar) const {\n        Matrix<N, M> res = *this;\n        for (int i = 0; i < N; ++i)\n            for (int j = 0; j < M; ++j) res.data[i][j] = (int)mul(res.data[i][j], scalar);\n        return res;\n    }\n\n    int* operator[](int idx) { return data[idx]; }\n    const int* operator[](int idx) const { return data[idx]; }\n};\n\nusing ll = long long;\n\nll n;\nint K;\nvector<int> digits;\nMatrix<35, 35> A[65][35], S[65][35], P[65][35], ans;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> K;\n\n    for (int i = 0; i < K; ++i) {\n        A[0][i].setIdentity();\n        for (int j = 0; j <= K; ++j) A[0][i][i][j] = 1;\n    }\n\n    ll len = K;\n    for (int i = 1; len <= n; ++i, len *= K) {\n        S[i-1][K-1] = A[i-1][K-1];\n        for (int j = K-2; j >= 0; --j)\n            S[i-1][j] = Matrix<35,35>::multiply(A[i-1][j], S[i-1][j+1]);\n\n        P[i-1][0] = A[i-1][0];\n        for (int j = 1; j < K; ++j)\n            P[i-1][j] = Matrix<35,35>::multiply(P[i-1][j-1], A[i-1][j]);\n\n        A[i][0] = S[i-1][0];\n        for (int j = 1; j < K; ++j)\n            A[i][j] = Matrix<35,35>::multiply(S[i-1][j], P[i-1][j-1]);\n    }\n\n    while (n) {\n        digits.push_back(n % K);\n        n /= K;\n    }\n\n    int carry = 0;\n    ans.setIdentity();\n    for (int i = (int)digits.size() - 1; i >= 0; --i) {\n        for (int j = 0; j < digits[i]; ++j)\n            ans = Matrix<35,35>::multiply(ans, A[i][(j + carry) % K]);\n        carry = (carry + digits[i]) % K;\n    }\n\n    int res = 1;\n    for (int i = 0; i < K; ++i)\n        res = add(res, ans[i][K]);\n    cout << res << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add(a, b):\n    a += b\n    return a - MOD if a >= MOD else a\n\ndef mul(a, b):\n    return (a * b) % MOD\n\nclass Matrix:\n    def __init__(self, N, M):\n        self.N = N\n        self.M = M\n        self.data = [[0] * M for _ in range(N)]\n    \n    def reset(self):\n        self.data = [[0] * self.M for _ in range(self.N)]\n    \n    def setIdentity(self):\n        self.reset()\n        for i in range(min(self.N, self.M)):\n            self.data[i][i] = 1\n    \n    @staticmethod\n    def multiply(a, b):\n        N = a.N\n        M = b.M\n        X = a.M\n        res = Matrix(N, M)\n        res.reset()\n        for i in range(N):\n            for j in range(X):\n                if a.data[i][j]:\n                    for k in range(M):\n                        res.data[i][k] = add(res.data[i][k], int(mul(a.data[i][j], b.data[j][k])))\n        return res\n    \n    def __add__(self, other):\n        res = Matrix(self.N, self.M)\n        for i in range(self.N):\n            for j in range(self.M):\n                res.data[i][j] = add(self.data[i][j], other.data[i][j])\n        return res\n    \n    def __mul__(self, scalar):\n        res = Matrix(self.N, self.M)\n        for i in range(self.N):\n            for j in range(self.M):\n                res.data[i][j] = int(mul(self.data[i][j], scalar))\n        return res\n    \n    def __getitem__(self, idx):\n        return self.data[idx]\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    K = int(data[1])\n    \n    # Initialize matrices\n    A = [[[Matrix(35, 35) for _ in range(35)] for __ in range(65)] for ___ in range(65)]\n    S = [[[Matrix(35, 35) for _ in range(35)] for __ in range(65)] for ___ in range(65)]\n    P = [[[Matrix(35, 35) for _ in range(35)] for __ in range(65)] for ___ in range(65)]\n    ans = Matrix(35, 35)\n    \n    for i in range(K):\n        A[0][i].setIdentity()\n        for j in range(K + 1):\n            A[0][i].data[i][j] = 1\n    \n    len_val = K\n    i = 1\n    while len_val <= n:\n        S[i-1][K-1] = A[i-1][K-1]\n        for j in range(K-2, -1, -1):\n            S[i-1][j] = Matrix.multiply(A[i-1][j], S[i-1][j+1])\n        \n        P[i-1][0] = A[i-1][0]\n        for j in range(1, K):\n            P[i-1][j] = Matrix.multiply(P[i-1][j-1], A[i-1][j])\n        \n        A[i][0] = S[i-1][0]\n        for j in range(1, K):\n            A[i][j] = Matrix.multiply(S[i-1][j], P[i-1][j-1])\n        \n        i += 1\n        len_val *= K\n    \n    digits = []\n    while n:\n        digits.append(n % K)\n        n //= K\n    \n    carry = 0\n    ans.setIdentity()\n    for i in range(len(digits)-1, -1, -1):\n        for j in range(digits[i]):\n            ans = Matrix.multiply(ans, A[i][(j + carry) % K])\n        carry = (carry + digits[i]) % K\n    \n    res = 1\n    for i in range(K):\n        res = add(res, ans.data[i][K])\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00016246906307060272, -8.344646857949556e-07, -1.1920922133867862e-06, -0.015774114057421684, -0.0002791491860989481, -0.34846460819244385, -0.001412466517649591, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -1.4305104514278355e-06, -0.004081729333847761, 0.0, -2.50339189733495e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.8371408916427754e-05, -2.622600959512056e-06, -0.020543301478028297, -0.0003053675754927099, -6.675497570540756e-05, -2.7656173188006505e-05, -5.960462772236497e-07, -8.4638240878121e-06, -1.6689286894688848e-06, -0.31585583090782166, -0.011067667976021767, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.50339189733495e-06, -0.05488388612866402, -2.9802276912960224e-06, -0.04302343353629112, -2.861018856492592e-06, -5.960462772236497e-07, -8.344646857949556e-07, -1.1920928244535389e-07, -5.602820692729438e-06, -3.576278118089249e-07, -4.768370445162873e-07, -2.264974000354414e-06, -2.026555876000202