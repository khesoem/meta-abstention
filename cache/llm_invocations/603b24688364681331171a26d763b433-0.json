ntinue;\n        for (int i = 9; i >= 0; --i) {\n            st.push_back({val * 10 + i, d + 1});\n        }\n    }\n}\n\nvoid dfs2(ll val) {\n    if (val * 1000000LL + 999999LL <= n && val * 10000000LL > n) {\n        ans = (ans + query(val, cnt2 + 1)) % MOD;\n        cnt2 += cnt;\n    } else {\n        ++cnt2;\n        ans = (ans + ((cnt2 - val) % MOD2 + MOD2) % MOD2) % MOD;\n        for (int i = (val == 0 ? 1 : 0); i < 10; ++i) {\n            if (val * 10 + i <= n) dfs2(val * 10 + i);\n        }\n    }\n}\n\nint main() {\n    build_positions();\n    for (int i = 0; i < 7; ++i) sort(pos[i].begin(), pos[i].end());\n    pw[0] = 1;\n    for (int i = 1; i < 13; ++i) pw[i] = pw[i - 1] * 10;\n    scanf(\"%lld\", &n);\n    cnt2 = -1;\n    dfs2(0);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD = 1000000007\nMOD2 = 998244353\n\npos = [[] for _ in range(10)]\ncnt = 0\npw = [0] * 13\ns = [0] * 15\ncnt2 = 0\nn = 0\nans = 0\n\ndef query(fixpre, val):\n    res = 0\n    for d in range(7):\n        offset = (val - fixpre * pw[d]) % MOD2\n        p = bisect.bisect_left(pos[d], MOD2 - offset)\n        res = (res + s[d] + offset * len(pos[d]) - MOD2 * (len(pos[d]) - p)) % MOD\n    return res\n\ndef build_positions():\n    global cnt\n    st = [(0, 0)]\n    while st:\n        val, d = st.pop()\n        x = (cnt - val) % MOD2\n        pos[d].append(x)\n        cnt += 1\n        s[d] += x\n        if d == 6:\n            continue\n        for i in range(9, -1, -1):\n            st.append((val * 10 + i, d + 1))\n\ndef dfs2(val):\n    global cnt2, ans\n    if val * 1000000 + 999999 <= n and val * 10000000 > n:\n        ans = (ans + query(val, cnt2 + 1)) % MOD\n        cnt2 += cnt\n    else:\n        cnt2 += 1\n        ans = (ans + ((cnt2 - val) % MOD2)) % MOD\n        start = 1 if val == 0