r();\n        }\n        std::string token;\n        tokenizer >> token;\n        return token;\n    }\n\n    int nextInt() {\n        return std::stoi(next());\n    }\n\n    long long nextLong() {\n        return std::stoll(next());\n    }\n};\n\nclass GTakeMetro {\npublic:\n    int n, m, s;\n    long long t;\n\n    void step() {\n        int curJump = static_cast<int>((t--) % n);\n        int sign = (s < m) ? 1 : -1;\n        s += sign * curJump;\n        s %= n;\n        if (s < 0) s += n;\n    }\n\n    void doLoop() {\n        for (int i = 0; i < n; i++) {\n            step();\n        }\n    }\n\n    void solve(int testNumber, InputReader& in, std::ostream& out) {\n        n = in.nextInt();\n        m = in.nextInt();\n        s = in.nextInt() - 1;\n        t = in.nextLong();\n\n        while ((t % n) != 0) {\n            step();\n        }\n\n        std::vector<long long> lastSeen(n, -1);\n        while (t != 0) {\n            doLoop();\n            if (lastSeen[s] != -1) {\n                long long interval = lastSeen[s] - t;\n                t %= interval;\n                break;\n            } else {\n                lastSeen[s] = t;\n            }\n        }\n        while (t != 0) {\n            step();\n        }\n        out << s + 1 << std::endl;\n    }\n};\n\nclass Main {\npublic:\n    void run() {\n        InputReader in(std::cin);\n        std::ostream out(std::cout.rdbuf());\n        GTakeMetro solver;\n        solver.solve(1, in, out);\n    }\n};\n\nint main() {\n    Main mainInstance;\n    mainInstance.run();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0003064401389565319, -3.2186455882765586e-06, -5.960462772236497e-07, -0.0006164796068333089, -1.7881377516459906e-06, -1.3112935448589269e-05, -1.1920922133867862e-06, -4.887569048150908e-06, -1.0728830375228426e-06, -0.10137254744768143, -8.344646857949556e-07, -7.116541382856667e-05, -3.576278118089249e-07, -0.7690834999084473, -0.00020621081