   if (idx2 == center || idx2 == idx1) continue;\n                    \n                    int[] dir1 = new int[5];\n                    int[] dir2 = new int[5];\n                    for (int dim = 0; dim < 5; dim++) {\n                        dir1[dim] = points[idx1][dim] - points[center][dim];\n                        dir2[dim] = points[idx2][dim] - points[center][dim];\n                    }\n                    \n                    long dot = 0;\n                    for (int dim = 0; dim < 5; dim++) {\n                        dot += (long)dir1[dim] * dir2[dim];\n                    }\n                    \n                    if (dot > 0) {\n                        isCenterGood = false;\n                    }\n                }\n            }\n            \n            if (isCenterGood) {\n                result.push(center + 1);\n            }\n        }\n        \n        if (result.isEmpty()) {\n            pw.println(\"0\");\n        } else {\n            pw.println(result.size());\n            for (int idx : result) {\n                pw.println(idx);\n            }\n        }\n        \n        pw.close();\n        br.close();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <stack>\n\nint main() {\n    std::string line;\n    std::getline(std::cin, line);\n    int n = std::stoi(line);\n    \n    if (n > 11) {\n        std::cout << \"0\" << std::endl;\n        return 0;\n    }\n    \n    std::vector<std::vector<int>> points(n, std::vector<int>(5));\n    for (int i = 0; i < n; i++) {\n        std::getline(std::cin, line);\n        std::istringstream iss(line);\n        std::string token;\n        for (int j = 0; j < 5; j++) {\n            iss >> token;\n            points[i][j] = std::stoi(token);\n        }\n    }\n    \n    std::stack<int> result