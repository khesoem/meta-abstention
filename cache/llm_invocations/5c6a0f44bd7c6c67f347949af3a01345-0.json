{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 5005;\nconst int INF = 1000000007;\nconst int K = 100;\n\nstruct Edge {\n    int u, v;\n    int cap, flow, cost;\n};\n\nstruct MCMF {\n    int n, m, s, t;\n    vector<int> G[MAXN];\n    vector<Edge> E;\n    int d[MAXN];\n    int prev[MAXN];\n    int aug[MAXN];\n\n    MCMF(int n) : n(n) {}\n\n    void addEdge(int u, int v, int cap, int cost) {\n        E.push_back({u, v, cap, 0, cost});\n        E.push_back({v, u, 0, 0, -cost});\n        m = (int)E.size();\n        G[u].push_back(m - 2);\n        G[v].push_back(m - 1);\n    }\n\n    bool shortestPath(int &f, int &cost) {\n        fill(d, d + n, INF);\n        fill(aug, aug + n, INF);\n        fill(prev, prev + n, -1);\n        d[s] = 0;\n        prev[s] = -1;\n        aug[s] = INF;\n\n        for (int iter = 0; iter < n - 1; ++iter) {\n            bool any = false;\n            for (int u = 0; u < n; ++u) {\n                if (d[u] == INF) continue;\n                for (int id : G[u]) {\n                    Edge &e = E[id];\n                    if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                        d[e.v] = d[u] + e.cost;\n                        prev[e.v] = id;\n                        aug[e.v] = min(aug[u], e.cap - e.flow);\n                        any = true;\n                    }\n                }\n            }\n            if (!any) break;\n        }\n\n        if (d[t] == INF) return false;\n\n        f = aug[t];\n        cost = d[t];\n        for (int v = t; v != s; v = E[prev[v]].u) {\n            E[prev[v]].flow += aug[t];\n            E[prev[v] ^ 1].flow -= aug[t];\n        }\n        return true;\n    }\n\n    pair<int,int> minCost(int s, int t) {\n        this->s = s;\n        this->t = t;\n        int totalFlow = 0;\n        int totalCost = 0;\n        int f, c;\n        while (shortestPath(f, c)) {\n            totalFlow += f;\n            totalCost += f * c;\n        }\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MCMF solver(n * K + 2);\n    int source = n * K, sink = n * K + 1;\n\n    for (int i = 0; i < K; ++i)\n        solver.addEdge(i, sink, k, C * i);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        solver.addEdge(source, x * K, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 1; j < K; ++j)\n            solver.addEdge(i * K + j - 1, i * K + j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n\n        for (int j = 1; j < K; ++j) {\n            int a = u * K + j - 1, b = v * K + j;\n            int c = v * K + j - 1, d = u * K + j;\n\n            for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n\n    auto ans = solver.minCost(source, sink);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nINF = 10**9 + 7\nK = 100\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.G = [[] for _ in range(n)]\n        self.E = []  # each edge: [u, v, cap, flow, cost]\n\n    def addEdge(self, u, v, cap, cost):\n        self.E.append([u, v, cap, 0, cost])\n        self.E.append([v, u, 0, 0, -cost])\n        m = len(self.E)\n        self.G[u].append(m - 2)\n        self.G[v].append(m - 1)\n\n    def shortestPath(self):\n        n = self.n\n        d = [INF] * n\n        aug = [0] * n\n        prev = [-1] * n\n        d[self.s] = 0\n        aug[self.s] = INF\n        prev[self.s] = -1\n\n        for _ in range(n - 1):\n            any_update = False\n            for u in range(n):\n                if d[u] == INF:\n                    continue\n                for idx in self.G[u]:\n                    e = self.E[idx]\n                    if e[2] > e[3] and d[e[1]] > d[u] + e[4]:\n                        d[e[1]] = d[u] + e[4]\n                        prev[e[1]] = idx\n                        aug[e[1]] = min(aug[u], e[2] - e[3])\n                        any_update = True\n            if not any_update:\n                break\n\n        if d[self.t] == INF:\n            return False, 0, 0\n\n        f = aug[self.t]\n        cost = d[self.t]\n        v = self.t\n        while v != self.s:\n            e = self.E[prev[v]]\n            e[3] += f\n            self.E[prev[v] ^ 1][3] -= f\n            v = e[0]\n        return True, f, cost\n\n    def minCost(self, s, t):\n        self.s = s\n        self.t = t\n        totalFlow = 0\n        totalCost = 0\n        while True:\n            found, f, c = self.shortestPath()\n            if not found:\n                break\n            totalFlow += f\n            totalCost += f * c\n        return totalFlow, totalCost\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    C = next(it)\n    D = next(it)\n\n    solver = MCMF(n * K + 2)\n    source = n * K\n    sink = n * K + 1\n\n    # initial positions\n    for _ in range(k):\n        x = next(it) - 1\n        solver.addEdge(source, x * K, 1, 0)\n\n    # stay edges (time steps)\n    for i in range(n):\n        for j in range(1, K):\n            solver.addEdge(i * K + j - 1, i * K + j, k, 0)\n\n    # movement edges\n    for _ in range(m):\n        u = next(it) - 1\n        v = next(it) - 1\n        for j in range(1, K):\n            a = u * K + j - 1\n            b = v * K + j\n            c = v * K + j - 1\n            d = u * K + j\n            for i in range(1, k + 1):\n                cc = (2 * i - 1) * D\n                solver.addEdge(a, b, 1, cc)\n                solver.addEdge(c, d, 1, cc)\n\n    # sink edges (only from node 0)\n    for i in range(K):\n        solver.addEdge(i, sink, k, C * i)\n\n    ans = solver.minCost(source, sink)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.00026925752172246575, 0.0, -1.311301275563892e-06, -0.0002674698771443218, -0.00016592556494288146, 0.0, -0.029780039563775063, -0.03093845024704933, -2.3841855067985307e-07, -1.9073468138230965e-06, -0.011061065830290318, -0.018160145729780197, -7.152555099310121e-07, -0.00318068522028625, -1.1920928244535389e-07, -1.9073468138230965e-06, -0.1026606559753418, -0.0004378790326882154, -0.0012516292044892907, 0.0, -3.576278118089249e-07, -0.012875165790319443, -2.062299427052494e-05, -0.023248357698321342, -3.540453326422721e-05, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, -2.264974000354414e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.6689286894688848e-06, -0.00026842328952625394, 0.0, 0.0, -1.1920928244535389e-07,