br.readLine();\n        int[] b = Arrays.stream(br.readLine().trim().split(\"\\\\s+\")).mapToInt(Integer::parseInt).toArray();\n        char[] res = s.toCharArray();\n\n        List<Integer> queue = new ArrayList<>();\n        for (int i = 0; i < n / 2; i++) {\n            if (res[i] == res[mirror(n, i)]) {\n                if (queue.isEmpty()) {\n                    queue.add(i);\n                } else {\n                    boolean found = false;\n                    for (int j : queue) {\n                        if (res[j] != res[i]) {\n                            int p1 = b[j] < b[mirror(n, j)] ? j : mirror(n, j);\n                            int p2 = b[i] < b[mirror(n, i)] ? i : mirror(n, i);\n                            swap(res, p1, p2);\n                            b[p1] = 0;\n                            b[p2] = 0;\n                            queue.remove(Integer.valueOf(j));\n                            found = true;\n                            break;\n                        }\n                    }\n                    if (!found) queue.add(i);\n                }\n            }\n        }\n\n        NavigableMap<Integer, Set<Integer>> map = new TreeMap<>();\n        for (int i = 0; i < n; i++) {\n            map.computeIfAbsent(b[i], k -> new HashSet<>()).add(i);\n        }\n\n        for (int i = 0; i < n / 2; i++) {\n            if (res[i] == res[mirror(n, i)]) {\n                int pivot = b[i] < b[mirror(n, i)] ? i : mirror(n, i);\n                boolean fixed = false;\n                for (Map.Entry<Integer, Set<Integer>> kv : map.entrySet()) {\n                    for (int k : kv.getValue()) {\n                        if (k == i || k == pivot || res[pivot] == res[k] || res[pivot] == res[mirror(n, k)]) continue;\n                        swap(res, pivot, k);\n                        b[k] = 0;\n                        b[pivot] = 0;\n                        map.get(0).add(k);\n                        map.get(0).add(pivot);\n                        