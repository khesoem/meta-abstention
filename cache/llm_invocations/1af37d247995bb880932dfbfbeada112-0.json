ap[e] || shortest_dist[dest[e]] <= shortest_dist[u] + edge_cost[e]) continue;\n\t\t\tshortest_dist[dest[e]] = shortest_dist[u] + edge_cost[e];\n\t\t\taugment_flow[dest[e]] = min(augment_flow[u], flow_cap[e]);\n\t\t\tlast_edge[dest[e]] = e;\n\t\t\tif (!visited[dest[e]]) {\n\t\t\t\tvisited[dest[e]] = true;\n\t\t\t\tq.push(dest[e]);\n\t\t\t}\n\t\t}\n\t}\n\treturn shortest_dist[dst] != INF;\n}\nvoid update_flow() {\n\tint f = augment_flow[dst];\n\tint cur = dst;\n\twhile (cur != src) {\n\t\tint e = last_edge[cur];\n\t\tflow_cap[e] -= f;\n\t\tflow_cap[e ^ 1] += f;\n\t\tcur = dest[e ^ 1];\n\t}\n\tcost_sum += f * shortest_dist[dst];\n}\nint main() {\n\tscanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n\tdst = (n + k - 1) * n + 1;\n\tfor (int i = 1, x; i <= k; i++) {\n\t\tscanf(\"%d\", &x);\n\t\tadd_edge(src, x, 1, 0);\n\t}\n\tfor (int i = 1, u, v; i <= m; i++) {\n\t\tscanf(\"%d%d\", &u, &v);\n\t\tfor (int layer = 1; layer <= n + k; layer++) {\n\t\t\tfor (int hop = 1; hop <= k; hop++) {\n\t\t\t\tint w = d * hop * 2 - d + c;\n\t\t\t\tadd_edge(u + (layer - 1) * n, v + layer * n, 1, w);\n\t\t\t\tadd_edge(v + (layer - 1) * n, u + layer * n, 1, w);\n\t\t\t}\n\t\t}\n\t}\n\tfor (int layer = 1; layer < n + k; layer++) {\n\t\tfor (int node = 2; node <= n; node++) {\n\t\t\tadd_edge(node + (layer - 1) * n, node + layer * n, 1000000000, c);\n\t\t}\n\t\tadd_edge(1 + (layer - 1) * n, 1 + layer * n, 1000000000, 0);\n\t}\n\twhile (find_shortest_path()) update_flow();\n\tprintf(\"%d\\n\", cost_sum);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 10000010;\n    static final int INF = 0x3f3f3f3f;\n    \n    static int n, m, c, d, k, src, dst, cost_sum;\n    static int edge_num = 1;\n    static int[] first_node = new int[MAXN];\n    static int[] dest = new int[MAXN];\n    static int[] next_link = new int[MAXN];\n    static int[] flow_cap = new int[MAXN];\n    static int[] edge_cost = new int[MAXN];\n    static int[] shortest_dist = new int[MAXN];\n    static int[] augment_flow = new int[MAXN];\n    static int[] last_edge = new int[MAXN];\n    static boolean[] visited = new boolean[MAXN];\n    \n    static void add_edge(int u, int v, int cap, int w) {\n        dest[++edge_num] = v;\n        next_link[edge_num] = first_node[u];\n        first_node[u] = edge_num;\n        flow_cap[edge_num] = cap;\n        edge_cost[edge_num] = w;\n        \n        dest[++edge_num] = u;\n        next_link[edge_num] = first_node[v];\n        first_node[v] = edge_num;\n        flow_cap[edge_num] = 0;\n        edge_cost[edge_num] = -w;\n    }\n    \n    static boolean find_shortest_path() {\n        Arrays.fill(augment_flow, 0);\n        Arrays.fill(shortest_dist, INF);\n        Arrays.fill(visited, false);\n        \n        Queue<Integer> q = new LinkedList<>();\n        q.offer(src);\n        augment_flow[src] = INF;\n        shortest_dist[src] = 0;\n        visited[src] = true;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            visited[u] = false;\n            \n            for (int e = first_node[u]; e != 0; e = next_link[e]) {\n                if (flow_cap[e] == 0 || shortest_dist[dest[e]] <= shortest_dist[u] + edge_cost[e]) {\n                    continue;\n                }\n                shortest_dist[dest[e]] = shortest_dist[u] + edge_cost[e];\n                augment_flow[dest[e]] = Math.min(augment_flow[u], flow_cap[e]);\n                last_edge[dest[e]] = e;\n                if (!visited[dest[e]]) {\n                    visited[dest[e]] = true;\n                    q.offer(dest[e]);\n                }\n            }\n        }\n        \n        return shortest_dist[dst] != INF;\n    }\n    \n    static void update_flow() {\n        int f = augment_flow[dst];\n        int cur = dst;\n        \n        while (cur != src) {\n            int e = last_edge[cur];\n            flow_cap[e] -= f;\n            flow_cap[e ^ 1] += f;\n            cur = dest[e ^ 1];\n        }\n        \n        cost_sum += f * shortest_dist[dst];\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        k = scanner.nextInt();\n        c = scanner.nextInt();\n        d = scanner.nextInt();\n        \n        dst = (n + k - 1) * n + 1;\n        \n        for (int i = 1; i <= k; i++) {\n            int x = scanner.nextInt();\n            add_edge(src, x, 1, 0);\n        }\n        \n        for (int i = 1; i <= m; i++) {\n            int u = scanner.nextInt();\n            int v = scanner.nextInt();\n            for (int layer = 1; layer <= n + k; layer++) {\n                for (int hop = 1; hop <= k; hop++) {\n                    int w = d * hop * 2 - d + c;\n                    add_edge(u + (layer - 1) * n, v + layer * n, 1, w);\n                    add_edge(v + (layer - 1) * n, u + layer * n, 1, w);\n                }\n            }\n        }\n        \n        for (int layer = 1; layer < n + k; layer++) {\n            for (int node = 2; node <= n; node++) {\n                add_edge(node + (layer - 1) * n, node + layer * n, 1000000000, c);\n            }\n            add_edge(1 + (layer - 1) * n, 1 + layer * n, 1000000000, 0);\n        }\n        \n        while (find_shortest_path()) {\n            update_flow();\n        }\n        \n        System.out.println(cost_sum);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.131014667218551e-05, -1.5497195136049413e-06, -5.960462772236497e-07, -0.0018076046835631132, -4.2676016164477915e-05, -0.04300733283162117, -0.12711094319820404, -4.529942543740617e-06, -1.1920928244535389e-07, -4.7205765440594405e-05, -0.0004884004010818899, -2.7418097943154862e-06, -0.011152432300150394, -0.0006777135422453284, -2.503