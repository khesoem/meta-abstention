}\n        }\n\n        public void solve(Scanner sc, PrintWriter pw) throws IOException {\n            pre();\n            int n = sc.nextInt();\n            int m = sc.nextInt();\n            int k = sc.nextInt();\n            int invm = BigInteger.valueOf(m).modInverse(BigInteger.valueOf(mod)).intValue();\n            int[] pVal = new int[5001];\n            pVal[0] = 1;\n            int md = n;\n            int prp = 1;\n            for (int i = 1; i <= k; i++) {\n                prp = mult(prp, md, invm);\n                md = add(md, -1);\n                int sub = prp;\n                for (int j = i - 1; j >= 1; j--) {\n                    sub = add(sub, mult(stirling[i][j], ((i - j) % 2 == 1) ? pVal[j] : add(0, -pVal[j])));\n                }\n                pVal[i] = sub;\n            }\n            pw.println(pVal[k]);\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(new BufferedOutputStream(System.out));\n        Task t = new Task();\n        t.solve(new Scanner(br), pw);\n        pw.close();\n    }\n\n    static class Scanner {\n        StringTokenizer st;\n        BufferedReader br;\n        public Scanner(BufferedReader br) { this.br = br; }\n        public String next() throws IOException {\n            while (st == null || !st.hasMoreTokens()) st = new StringTokenizer(br.readLine());\n            return st.nextToken();\n        }\n        public int nextInt() throws IOException { return Integer.parseInt(next()); }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstring>\n#include <cmath>\n#include <cstdlib>\n#include <cstdio>\n#include <string>\n#include <sstream>\nusing namespace std;\n\nconst int MOD = 998244353;\n\ninline int add(int a, int b) {\n    int c = a + b;\n    if (c >= MOD) return c - MOD;\n    if (c < 0) return c + MOD;\n    return c;\n}\n\ninline int mult(int a, int b) {\n    return (int)((long long)a * b % MOD);\n}\n\nint powmod(int a, int e) {\n    int res = 1;\n    while (e) {\n        if (e & 1) res = mult(res, a);\n        a = mult(a, a);\n        e >>= 1;\n    }\n    return res;\n}\n\nint inv(int a) {\n    return powmod(a, MOD - 2);\n}\n\nstruct Task {\n    vector<vector<int>> stirling;\n\n    void pre() {\n        stirling.assign(5001, vector<int>(5001, 0));\n        for (int i = 0; i < 5001; i++) {\n            stirling[i][0] = 0;\n        }\n        stirling[0][1] = 0; // as in Java\n        for (int i = 0; i < 5001; i++) {\n            stirling[i][i] = 1;\n        }\n        for (int i = 2; i < 5001; i++) {\n            for (int j = 1; j < i; j++) {\n                stirling[i][j] = add(mult(stirling[i-1][j], i-1), stirling[i-1][j-1]);\n            }\n        }\n    }\n\n    void solve() {\n        pre();\n        int n, m, k;\n        cin >> n >> m >> k;\n        int invm = inv(m);\n        vector<int> pVal(5001, 0);\n        pVal[0] = 1;\n        int md = n;\n        int prp = 1;\n        for (int i = 1; i <= k; i++) {\n            prp = mult(mult(prp, md), invm);\n            md = add(md, -1);\n            int sub = prp;\n            for (int j = i - 1; j >= 1; j--) {\n                int sign = ((i - j) % 2 == 1) ? 1 : -1;\n                int term = mult(stirling[i][j], (sign == 1) ? pVal[j] : add(0, -pVal[j]));\n                sub = add(sub, term);\n            }\n            pVal[i] = sub;\n        }\n        cout << pVal[k] << endl;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    Task t;\n    t.solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.264974000354414e-06, 0.0, 0.0, -3.659658250398934e-05, -4.470248313737102e-05, -9.