{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.util.*;\npublic class PIEFLAVORED{\n   private static final long mod = 998244353;\n   public static void main(String[] args) {\n      Scanner ray = new Scanner(System.in);\n      int n = ray.nextInt();\n      long kk = ray.nextLong();\n      if(kk >= n) {\n         System.out.println(\"0\");\n      } else {\n         int k = (int)kk;\n         int r = n - k;\n         long[] rChoose = new long[r+1];\n         rChoose[0] = 1L;\n         long num = 1, den = 1;\n         for(int i=1; i<=r; i++) {\n            num = (num * (r+1-i)) % mod;\n            den = (den * i) % mod;\n            rChoose[i] = (num * modInverse(den, mod)) % mod;\n         }\n         long ans = 0;\n         long sign = 1;\n         for(int i=0; i<=r; i++) {\n            ans += power((long)(r-i), (long)n) * sign % mod * rChoose[i] % mod;\n            ans %= mod;\n            sign = -sign;\n         }\n         ans = ans * choose((long)n, (long)k) % mod;\n         if(k > 0) ans = (ans * 2) % mod;\n         if(ans < 0) ans += mod;\n         System.out.println(\"\"+ans);\n      }\n   }\n   public static long choose(long n, long k) {\n      long num = 1, den = 1;\n      for(int i=(int)(n-k+1); i<=n; i++) num = (num * i) % mod;\n      for(int i=1; i<=k; i++) den = (den * i) % mod;\n      den = modInverse(den, mod);\n      return (num * den) % mod;\n   }\n   public static long modInverse(long a, long m) {\n      long m0 = m, y = 0, x = 1;\n      if (m == 1) return 0;\n      while (a > 1) {\n         long q = a / m;\n         long t = m;\n         m = a % m;\n         a = t;\n         t = y;\n         y = x - q * y;\n         x = t;\n      }\n      if (x < 0) x += m0;\n      return x;\n   }\n   public static long power(long x, long y) {\n      long res = 1;\n      x %= mod;\n      while (y > 0) {\n         if ((y & 1) == 1) { res = (res * x) % mod; }\n         y >>= 1;\n         x = (x * x) % mod;\n      }\n      return res;\n   }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef mod_inverse(a, m):\n    m0, y, x = m, 0, 1\n    if m == 1:\n        return 0\n    while a > 1:\n        q = a // m\n        t = m\n        m = a % m\n        a = t\n        t = y\n        y = x - q * y\n        x = t\n    if x < 0:\n        x += m0\n    return x\n\ndef power(x, y):\n    res = 1\n    x %= MOD\n    while y > 0:\n        if y & 1:\n            res = (res * x) % MOD\n        y >>= 1\n        x = (x * x) % MOD\n    return res\n\ndef choose(n, k):\n    num = 1\n    den = 1\n    for i in range(int(n - k + 1), int(n) + 1):\n        num = (num * i) % MOD\n    for i in range(1, int(k) + 1):\n        den = (den * i) % MOD\n    den = mod_inverse(den, MOD)\n    return (num * den) % MOD\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    kk = int(data[1])\n    if kk >= n:\n        print(0)\n        return\n    k = kk\n    r = n - k\n    r_choose = [0] * (r + 1)\n    r_choose[0] = 1\n    num = 1\n    den = 1\n    for i in range(1, r + 1):\n        num = (num * (r + 1 - i)) % MOD\n        den = (den * i) % MOD\n        r_choose[i] = (num * mod_inverse(den, MOD)) % MOD\n    ans = 0\n    sign = 1\n    for i in range(r + 1):\n        ans = (ans + power(r - i, n) * sign % MOD * r_choose[i] % MOD) % MOD\n        sign = -sign\n    ans = ans * choose(n, k) % MOD\n    if k > 0:\n        ans = (ans * 2) % MOD\n    if ans < 0:\n        ans += MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.668916e-05, 0.0, -1.1920928e-07, -0.0003486264, -1.3627315, -0.0006555554, -0.0068299645, -0.12733746, -3.3378547e-06, -1.1920928e-07, -1.1920928e-07, 0.0, 0.0, -4.482169e-05, -3.2066786e-05, -0.0029642712, -0.009271778, -0.00033551786, -1.1920928e-07, -0.04883746, -0.0007113072, -0.0025096608, -4.7683704e-07, -0.0026997805, 0.0, -0.31326234, -0.014165447, -8.344616e-06, 0.0, -4.1723165e-06, -2.503392e-06, -1.1920928e-07, 0.0, -2.0265559e-06, -1.1920928e-07, 0.0, -2.3841855e-07, -3.576278e-07, 0.0, -1.4305105e-06, 0.0, -7.152555e-07, 0.0, -5.960463e-07, -5.8291644e-05, -1.1920928e-07, 0.0, -1.1920928e-07, -1.7881378e-06, -1.1920928e-07, 0.0, -1.1563234e-05, -1.1920928e-07, 0.0, -1.1920928e-07, -3.576278e-07, -8.344647e-07, 0.0, -2.3841855e-07, -4.5417706e-05, 0.0, -1.1920928e-07, 0.0, -2.3841855e-07, 0.0, -0.023941115, -2.9802277e-06, -1.1920928e-07, -1.1920928e-07, 0.0, -9.1790735e-06, -7.509903e-05, 0.0, -3.576278e-07, 0.0, -1.072883e-06, 0.0, 0.0, -7.867782e-06, -1.1920928e-07, -3.576278e-07, -2.3841855e-07, -0.0007121411, -9.417489e-06, 0.0, -2.3841855e-07, 0.0, -1.1920928e-07, -1.0132739e-05, -7.152555e-07, 0.0, -1.1920928e-07, -1.1920928e-07, 0.0, -1.1920928e-07, -2.3841855e-07, -3.576278e-07, -1.1920928e-07, 0.0, -1.1920928e-07, -1.1444026e-05, -0.023383921, 0.0, -1.1920928e-07, -2.3841855e-07, -3.576278e-07, -1.7881378e-06, -2.3841855e-07, 0.0, -4.7683704e-07, -1.19209