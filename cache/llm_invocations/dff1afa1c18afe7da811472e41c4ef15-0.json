         self.e[id ^ 1][3] -= pushed\n                    return pushed\n            self.ptr[v] += 1\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.ptr = [0] * self.n\n            while True:\n                pushed = self.dfs(s, INF, t)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\ndef way(x1, y1, x2, y2, n, m, temp):\n    q = deque()\n    q.append((0, x1, y1))\n    h = [[INF] * n for _ in range(n)]\n    while q:\n        v, x, y = q.popleft()\n        if h[x][y] <= v:\n            continue\n        h[x][y] = v\n        if x == x2 and y == y2:\n            continue\n        # four directions\n        for dx, dy in ((-1,0),(1,0),(0,-1),(0,1)):\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < n and 0 <= ny < n and m[nx][ny] and h[nx][ny] > v + 1:\n                target = (nx == x2 and ny == y2)\n                lim = temp[nx][ny]\n                if (target and lim >= v + 1) or (not target and lim > v + 1):\n                    q.append((v + 1, nx, ny))\n    return h[x2][y2]\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    # first grid\n    m = [[False] * n for _ in range(n)]\n    temp = [[t] * n for _ in range(n)]\n    sx = sy = 0\n    flow = Flow(n * n * 2 + 2)\n    k = 1\n    for i in range(n):\n        row = next(it)\n        for j, ch in enumerate(row):\n            if ch == 'Z':\n                sx, sy = i, j\n                m[i][j] = False\n                cap = 0\n            elif ch == 'Y':\n                m[i][j] = False\n                cap = 0\n            else:\n                m[i][j] = True\n                cap = int(ch)\n            flow.add_edge(0, k, cap)\n            k += 1\n    # second grid\n    k = n * n + 1\n    for i in range(n):\n        row = next(it)\n        for j, ch in enumerate(row):\n            cap = 0 if ch in ('Z','Y') else int(ch)\n            flow.add_edge(k, n * n * 2 + 1, cap)\n            k += 1\n    # BFS from start to compute distances\n    q = deque()\n    q.append((0, sx, sy))\n    while q:\n        v, x, y = q.popleft()\n        if temp[x][y] <= v:\n            continue\n        temp[x][y] = v\n        for dx, dy in ((-1,0),(1,0),(0,-1),(0,1)):\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < n and 0 <= ny < n and m[nx][ny] and v + 1 < temp[nx][ny]:\n                q.append((v + 1, nx, ny))\n    # add edges between first and second grid cells\n    k = 0\n    for i in range(n):\n        for j in range(n):\n            k += 1\n            k1 = n * n\n            for z in range(n):\n                for w in range(n):\n                    k1 += 1\n                    if m[i][j] and m[z][w] and way(i, j, z, w, n, m, temp) <= t:\n                        flow.add_edge(k, k1, INF)\n    print(flow.max_flow(0, n * n * 2 + 1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0005812147865071893, -0.002351378323510289, -1.4305104514278355e-06, -8.821448318485636e-06, -3.6238969187252223e-05, -3.2186455882765586e-06, 0.0, -1.8715683836489916e-05, -0.007267585955560207, -0.0015162649797275662, -5.960462772236497e-07, -9.536738616588991e-07, -4.768370445162873e-07, -4.529942543740617e-06, 0.0, -4.970903682988137e-05, -0.05121529847383499, -1.8715683836489916e-05, -0.003731076605618, -8.106198947643861e-06, -1.1920928244535389e-07, -0.014166269451379776, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, 0.0, -0.20141644775867462, -0.17261771857738495, -0.2565121054649353, 0.0, -9.667406266089529e-05, -0.0093173673376441, -1.3828182090946939e-05, -4.410734163684538e-06, -0.030536970123648643, 0.0, -1.0728830375228426e-06, -0.024062151089310646, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -6.19886395725