{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <cmath>\n#include <climits>\nusing namespace std;\n\nlong long min_diff_num = LLONG_MAX, min_diff_den = 1;\nlong long best_a = 0, best_b = 0;\n\nlong long compute_gcd(long long a, long long b) {\n    a = a < 0 ? -a : a;\n    b = b < 0 ? -b : b;\n    if (a == 0) return b;\n    if (b == 0) return a;\n    for (long long t; b != 0; t = b, b = a % b, a = t);\n    return a;\n}\n\nvoid evaluate(long long x, long long y, long long b, long long a) {\n    if (a < 0) return;\n    \n    long long g = compute_gcd(a, b);\n    a /= g;\n    b /= g;\n    \n    long long num = llabs(b * x - a * y);\n    long long den = b * y;\n    g = compute_gcd(num, den);\n    num /= g;\n    den /= g;\n    \n    if (num * min_diff_den < min_diff_num * den) {\n        min_diff_num = num;\n        min_diff_den = den;\n        best_a = a;\n        best_b = b;\n    } else if (num * min_diff_den == min_diff_num * den) {\n        if (b < best_b || (b == best_b && a < best_a)) {\n            best_a = a;\n            best_b = b;\n        }\n    }\n}\n\nint main() {\n    long long x, y, n;\n    cin >> x >> y >> n;\n    \n    for (long long i = 1; i <= n; ++i) {\n        evaluate(x, y, i, (i * x) / y);\n        evaluate(x, y, i, (i * x) / y + 1);\n        evaluate(x, y, i, (i * x) / y - 1);\n    }\n    \n    cout << best_a << \"/\" << best_b << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nimport sys\n\nmin_diff_num = float('inf')\nmin_diff_den = 1\nbest_a = 0\nbest_b = 0\n\ndef compute_gcd(a, b):\n    a = abs(a)\n    b = abs(b)\n    if a == 0:\n        return b\n    if b == 0:\n        return a\n    while b != 0:\n        t = b\n        b = a % b\n        a = t\n    return a\n\ndef evaluate(x, y, b, a):\n    global min_diff_num, min_diff_den, best_a, best_b\n    \n    if a < 0:\n        return\n    \n    g = compute_gcd(a, b)\n    a //= g\n    b //= g\n    \n    num = abs(b * x - a * y)\n    den = b * y\n    g = compute_gcd(num, den)\n    num //= g\n    den //= g\n    \n    # Compare fractions: num/den vs min_diff_num/min_diff_den\n    if num * min_diff_den < min_diff_num * den:\n        min_diff_num = num\n        min_diff_den = den\n        best_a = a\n        best_b = b\n    elif num * min_diff_den == min_diff_num * den:\n        if b < best_b or (b == best_b and a < best_a):\n            best_a = a\n            best_b = b\n\ndef main():\n    global min_diff_num, min_diff_den, best_a, best_b\n    \n    # Reset global variables for multiple runs if needed\n    min_diff_num = float('inf')\n    min_diff_den = 1\n    best_a = 0\n    best_b = 0\n    \n    data = sys.stdin.read().split()\n    x = int(data[0])\n    y = int(data[1])\n    n = int(data[2])\n    \n    for i in range(1, n + 1):\n        evaluate(x, y, i, (i * x) // y)\n        evaluate(x, y, i, (i * x) // y + 1)\n        evaluate(x, y, i, (i * x) // y - 1)\n    \n    print(f\"{best_a}/{best_b}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.225102646974847e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.0015235256869345903, -0.004153673071414232, -0.5231263637542725, -0.16023913025856018, -0.001379848807118833, -5.960462772236497e-07, -0.12736716866493225, -2.0265558760002023e-06, -5.006777428206988e-06, -2.3841855067985307e-07, -0.0020368797704577446, -6.186770770000294e-05, -5.364403477869928e-06, -1.5497195136049413e-06, -2.3841855067985307e-07, -4.887569048150908e-06, -4.529942543740617e-06, 0.0, 0.0, 0.0, 0.0, -1.5497195136049413e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -4.351044481154531e-05, -6.16293036728166e-05, -1.1920928244535389e-07, -5.960462772236497e-07, -0.0017021704697981477, -1.07287787614041e-05, -9.536738616588991e-07, -0.00013410145766101778, -2.264974000354414e-06, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -3.576272320060525e-06, -3.576278118089249e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -5.435795901576057e-05, 0.0, -2.1815061700181104e-05, -4.768370445162873e-07, -2.145764938177308e-06, -8.34461570775602e-06, -1.6093124941107817e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, 0.0, -2.861018856492592e-06, -4.768370445162873e-07, 0.0, 0.0, -2.3841855067985307e-07, -5.960462772236497e-07, -6.198863957251888e-06, -2.264974000354414e-06, 0.0, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -1.1920922133867862e-06, -9.536738616588991e-07, -4.6491513785440475e-06, -1.7404405298293568e-05, -3.576278118089249e-07, -0.00014578233822248876, -5.960462772236497e-07, -1.0371154530730564e-05, 0.0, 0.0, -5.960462772236497e-07, -1.5497195136049413e-06, -0.0077531603164970875, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -4.768370445162873e-07, -1.6689286894688848e-06, -2