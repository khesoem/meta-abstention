llections import deque\n\ndef is_valid(r, c, n):\n    return 0 <= r < n and 0 <= c < n\n\ndef get_path(flo, counter):\n    parent = [-1] * (counter + 1)\n    parent[0] = 0\n    stack = [0]\n    while stack:\n        top = stack.pop()\n        if top == counter:\n            break\n        for i in range(counter + 1):\n            if flo[top][i] and parent[i] == -1:\n                parent[i] = top\n                stack.append(i)\n    if parent[counter] == -1:\n        return 0\n    ans = 10000\n    pos = counter\n    while pos != 0:\n        ans = min(ans, flo[parent[pos]][pos])\n        pos = parent[pos]\n    pos = counter\n    while pos != 0:\n        flo[parent[pos]][pos] -= ans\n        flo[pos][parent[pos]] += ans\n        pos = parent[pos]\n    return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    # read first grid\n    inp = [list(next(it).strip()) for _ in range(n)]\n    # initialize arrays\n    source_cap = [[0]*n for _ in range(n)]\n    sink_cap = [[0]*n for _ in range(n)]\n    source_num = [[-1]*n for _ in range(n)]\n    sink_num = [[-1]*n for _ in range(n)]\n    plant = [[[0]*(t+1) for _ in range(n)] for _ in range(n)]\n    # process first grid\n    for i in range(n):\n        for j in range(n):\n            ch = inp[i][j]\n            if ch == 'Y' or ch == 'Z':\n                plant[i][j][0] = ord(ch) - ord('X')  # Y->1, Z->2\n                source_cap[i][j] = 0\n            else:\n                plant[i][j][0] = 0\n                source_cap[i][j] = ord(ch) - ord('0')\n    # read second grid\n    inp = [list(next(it).strip()) for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            ch = inp[i][j]\n            if ch == 'Y' or ch == 'Z':\n                plant[i][j][0] = ord(ch) - ord('X')\n                sink_cap[i][j] = 0\n            else:\n                plant[i][j][0] = 0\n                sink_cap[i][j] = ord(ch) - ord('0')\n    # propagate plant over time\n    dr = [0, 0, -1, 1]\n    dc = [-1, 1, 0, 0]\n    for curr_time in range(1, t+1):\n        for i in range(n):\n            for j in range(n):\n                plant[i][j][curr_time] = plant[i][j][curr_time-1]\n        for i in range(n):\n            for j in range(n):\n                if plant[i][j][curr_time-1] == 2:\n                    for k in range(4):\n                        ni = i + dr[k]\n                        nj = j + dc[k]\n                        if is_valid(ni, nj, n) and plant[ni][nj][curr_time-1] == 0:\n                            plant[ni][nj][curr_time] = 2\n    # assign node numbers for source and sink cells\n    counter = 1\n    for i in range(n):\n        for j in range(n):\n            if source_cap[i][j] != 0:\n                source_num[i][j] = counter\n                counter += 1\n            else:\n                source_num[i][j] = -1\n    for i in range(n):\n        for j in range(n):\n            if sink_cap[i][j] != 0:\n                sink_num[i][j] = counter\n                counter += 1\n            else:\n                sink_num[i][j] = -1\n    # initialize flow matrix (size counter+1)\n    flo = [[0]*(counter+1) for _ in range(counter+1)]\n    # BFS from each source to find reachable sinks within time t\n    for i in range(n):\n        for j in range(n):\n            if source_cap[i][j] == 0:\n                continue\n            source = source_num[i][j]\n            vis = [[False]*n for _ in range(n)]\n            q = deque()\n            q.append((0, i, j))\n            vis[i][j] = True\n            while q:\n                curr_time, r, c = q.popleft()\n                if sink_cap[r][c] != 0:\n                    flo[source][sink_num[r][c]] = 10000\n                if curr_time == t:\n                    continue\n                if plant[r][c][curr_time] != 0:\n                    continue\n                for k in range(4):\n                    nr = r + dr[k]\n    