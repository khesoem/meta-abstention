 State2 {\n    LL A, B;\n    int next_i;\n};\n\nvoid DFS2_iter() {\n    vector<State2> stack;\n    stack.push_back({0, 0, 1});\n    while (!stack.empty()) {\n        State2 cur = stack.back();\n        stack.pop_back();\n        if (cur.B > n) continue;\n        if (check(cur.B)) {\n            for (LL i = 0; i <= 6; i++) {\n                LL cur_val = ((Cnt2 + 1 - (cur.B * Tpow[i])) % Mod1 + Mod1) % Mod1;\n                LL pos = lower_bound(val[i].begin(), val[i].end(), Mod1 - cur_val) - val[i].begin();\n                ans = (ans + sum[i] + cur_val * val[i].size() - Mod1 * (val[i].size() - pos)) % Mod2;\n            }\n            Cnt2 += Cnt1;\n        } else {\n            Cnt2++;\n            ans = (ans + ((Cnt2 - cur.B) % Mod1 + Mod1) % Mod1) % Mod2;\n            for (LL i = 9; i >= cur.next_i; i--) {\n                stack.push_back({cur.A + 1, cur.B * 10 + i, !(cur.A + 1)});\n            }\n        }\n    }\n}\n\nLL readLL() {\n    LL k=0, f=1; char c=getchar();\n    while (c<'0' || c>'9') { if (c=='-') f=-1; c=getchar(); }\n    while (c>='0' && c<='9') { k=(k<<3)+(k<<1)+(c-'0'); c=getchar(); }\n    return k*f;\n}\n\nvoid writeLL(LL x) {\n    if (x < 0) { putchar('-'); x=-x; }\n    if (x > 9) writeLL(x/10);\n    putchar(x%10+'0');\n}\n\nint main() {\n    n = readLL();\n    DFS1_iter();\n    for (LL i = 0; i <= 6; i++) sort(val[i].begin(), val[i].end());\n    Cnt2 = -1;\n    DFS2_iter();\n    writeLL(ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final long Mod1 = 998244353;\n    static final long Mod2 = 1000000007;\n    static final long Cut = 1000000;\n    static long ans, n, Cnt1, Cnt2;\n    static long[] sum = new long[7];\n    static ArrayList<Long>[] val = new ArrayList[7];\n    static long[] Tpow = {1, 10, 100, 1000, 10000, 100000, 1000000};\n\n    static class State1 {\n        long A, B;\n        int next;\n        State1(long A, long B, int next) {\n            this.A = A;\n            this.B = B;\n            this.next = next;\n        }\n    }\n\n    static class State2 {\n        long A, B;\n        int next_i;\n        State2(long A, long B, int next_i) {\n            this.A = A;\n            this.B = B;\n            this.next_i = next_i;\n        }\n    }\n\n    static void DFS1_iter() {\n        ArrayList<State1> stack = new ArrayList<>();\n        stack.add(new State1(0, 0, 0));\n        while (!stack.isEmpty()) {\n            State1 top = stack.get(stack.size() - 1);\n            if (top.A == 7) {\n                stack.remove(stack.size() - 1);\n                continue;\n            }\n            if (top.next == 0) {\n                long t = (Cnt1 - top.B + Mod1) % Mod1;\n                val[(int)top.A].add(t);\n                sum[(int)top.A] += t;\n                Cnt1++;\n            }\n            if (top.next < 10) {\n                int i = top.next;\n                top.next++;\n                if (top.A + 1 < 7) {\n                    stack.add(new State1(top.A + 1, top.B * 10 + i, 0));\n                }\n            } else {\n                stack.remove(stack.size() - 1);\n            }\n        }\n    }\n\n    static boolean check(long x) {\n        return x * Cut + 999999 <= n && x * Cut * 10 > n;\n    }\n\n    static int lowerBound(ArrayList<Long> list, long key) {\n        int idx = Collections.binarySearch(list, key);\n        if (idx < 0) {\n            return -idx - 1;\n        }\n        // If key is found, we need first occurrence\n        while (idx > 0 && list.get(idx - 1).equals(key)) {\n            idx--;\n        }\n        return idx;\n    }\n\n    static void DFS2_iter() {\n        ArrayList<State2> stack = new ArrayList<>();\n        stack.add(new State2(0, 0, 1));\n        while (!stack.isEmpty()) {\n            State2 cur = stack.remove(stack.size() -