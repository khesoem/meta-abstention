ge e = g.get(u).get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                            dist[e.to] = dist[u] + e.cost;\n                            prevv[e.to] = u;\n                            preve[e.to] = i;\n                            if (!inq[e.to]) {\n                                inq[e.to] = true;\n                                q.offer(e.to);\n                            }\n                        }\n                    }\n                }\n\n                if (dist[T] == Integer.MAX_VALUE) {\n                    break;\n                }\n\n                int flow = Integer.MAX_VALUE;\n                for (int v = T; v != S; v = prevv[v]) {\n                    flow = Math.min(flow, g.get(prevv[v]).get(preve[v]).cap);\n                }\n\n                result[0] += flow;\n                result[1] += flow * dist[T];\n\n                for (int v = T; v != S; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.cap -= flow;\n                    g.get(v).get(e.rev).cap += flow;\n                }\n            }\n            return result;\n        }\n    }\n\n    static int idx(int i, int j, int n) {\n        return i * n + j;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int cs = 2 * k;\n        int total = cs * n + 2;\n        int src = total - 2;\n        int dst = total - 1;\n\n        MCMF solver = new MCMF(total, src, dst);\n\n        for (int i = 0; i < k; i++) {\n            int tp = sc.nextInt();\n            solver.link(src, idx(0, tp, n), 1, 0);\n        }\n\n        int[][] E = new int[m][2];\n        for (int i = 0; i < m; i++) {\n            E[i][0] = sc.nextInt();\n            E[i][1] = sc.nextInt();\n        }\n\n        for (int layer = 1; layer <= cs - 1; layer++) {\n            solver.link(idx(layer, 1, n), dst, k, c * layer);\n            for (int node = 1; node <= n; node++) {\n                solver.link(idx(layer - 1, node, n), idx(layer, node, n), k, 0);\n            }\n            for (int i = 0; i < m; i++) {\n                int u = E[i][0];\n                int v = E[i][1];\n                for (int t = 1; t <= k; t++) {\n                    int w = (2 * t - 1) * d;\n                    solver.link(idx(layer - 1, u, n), idx(layer, v, n), 1, w);\n                    solver.link(idx(layer - 1, v, n), idx(layer, u, n), 1, w);\n                }\n            }\n        }\n\n        int[] result = solver.solve();\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.63164638960734e-05, -2.50339189733495e-06, -3.576278118089249e-07, -0.0009685831028036773, -4.458328112377785e-05, -0.06994156539440155, -0.04311900585889816, -0.00038354191929101944, -1.6689286894688848e-06, -0.0003960540343541652, -0.0336461178958416, -0.0017032414907589555, -0.0010121704544872046, -0.13054241240024567, -5.0424259825376794e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, -9.536738616588991e-07, -4.768370445162873e-07, -1.9192511899746023e-05, -1.764281842042692e-05, 0.0, -2.50339189733495e-06, 0.0, -3.576272320060525e-06, -0.31326183676719666, -0.14267787337303162, -3.1470757676288486e-05, -8.344646857949556e-07, -0.0002315968304174021, 0.0, 0.0, -6.103329360485077e-05, 0.0, -3.576278118089249e-07, -5.602820692729438e-06, 0.0, 0.0, -6.198863957251888e-06, 0.0, -2.3841855067985307e-07, -1.9907753085135482e-05, -2.7418097943154862e-06, -2.3841855067985307e-07, 0.0, 0.0, -3.135155202471651e-05, -2.7418097943154862e-06, -1.311301275563892e-06, -2.884823152271565e-05, 0.0, -1.0728830375228426e-06, -2.3841855067985307e-07, -7.152531907195225e-06, -2.3841830625315197e-06, -1.9073304429184645e-05, 0.0, -3.814689989667386e-0