{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1e9;\nconst int T = 150;\n\nstruct Edge {\n    int to, rev, cap, flow, cost;\n};\n\nclass MCMF {\n    int n;\n    vector<vector<Edge>> g;\n    vector<int> dist, pot, prevv, preve;\n\npublic:\n    MCMF(int n_) : n(n_), g(n_), dist(n_), pot(n_, 0), prevv(n_), preve(n_) {}\n\n    void add_edge(int from, int to, int cap, int cost) {\n        g[from].push_back({to, (int)g[to].size(), cap, 0, cost});\n        g[to].push_back({from, (int)g[from].size() - 1, 0, 0, -cost});\n    }\n\n    pair<int, int> run(int s, int t) {\n        int flow = 0, flow_cost = 0;\n\n        while (true) {\n            fill(dist.begin(), dist.end(), INF);\n            dist[s] = 0;\n\n            set<pair<int, int>> pq;\n            pq.insert({0, s});\n\n            while (!pq.empty()) {\n                auto it = pq.begin();\n                int d = it->first;\n                int v = it->second;\n                pq.erase(it);\n\n                if (d != dist[v]) continue;\n\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap - e.flow <= 0) continue;\n\n                    int nd = d + e.cost + pot[v] - pot[e.to];\n                    if (nd < dist[e.to]) {\n                        if (dist[e.to] != INF) {\n                            pq.erase({dist[e.to], e.to});\n                        }\n                        dist[e.to] = nd;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        pq.insert({nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n            int add = INF - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                add = min(add, e.cap - e.flow);\n            }\n\n            flow += add;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.flow += add;\n                g[v][e.rev].flow -= add;\n                flow_cost += add * e.cost;\n            }\n        }\n\n        return {flow, flow_cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MCMF mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    pair<int, int> ans = mcf.run(N, N + 1);\n    assert(ans.first == k);\n    cout << ans.second << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**9\nT = 150\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'flow', 'cost')\n    def __init__(self, to, rev, cap, flow, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.g = [[] for _ in range(n)]\n        self.dist = [0] * n\n        self.pot = [0] * n\n        self.prevv = [0] * n\n        self.preve = [0] * n\n\n    def add_edge(self, from_, to, cap, cost):\n        self.g[from_].append(Edge(to, len(self.g[to]), cap, 0, cost))\n        self.g[to].append(Edge(from_, len(self.g[from_]) - 1, 0, 0, -cost))\n\n    def run(self, s, t):\n        flow = 0\n        flow_cost = 0\n        n = self.n\n        g = self.g\n        dist = self.dist\n        pot = self.pot\n        prevv = self.prevv\n        preve = self.preve\n\n        while True:\n            dist = [INF] * n\n            dist[s] = 0\n            pq = [(0, s)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if d != dist[v]:\n                    continue\n                for i, e in enumerate(g[v]):\n                    if e.cap - e.flow <= 0:\n                        continue\n                    nd = d + e.cost + pot[v] - pot[e.to]\n                    if nd < dist[e.to]:\n                        dist[e.to] = nd\n                        prevv[e.to] = v\n                        preve[e.to] = i\n                        heapq.heappush(pq, (nd, e.to))\n            if dist[t] == INF:\n                break\n            for i in range(n):\n                pot[i] += dist[i]\n            add = INF - flow\n            v = t\n            while v != s:\n                e = g[prevv[v]][preve[v]]\n                add = min(add, e.cap - e.flow)\n                v = prevv[v]\n            flow += add\n            v = t\n            while v != s:\n                e = g[prevv[v]][preve[v]]\n                e.flow += add\n                g[v][e.rev].flow -= add\n                flow_cost += add * e.cost\n                v = prevv[v]\n        return (flow, flow_cost)\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    N = n * T\n    mcf = MCMF(N + 2)\n\n    # stay edges\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c)\n\n    # exit edges from node 0 at each time to sink\n    for i in range(T):\n        mcf.add_edge(i, N + 1, INF, 0)\n\n    # source to initial positions\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcf.add_edge(N, x * T, 1, 0)\n\n    # movement edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for j in range(T - 1):\n            cur = 1\n            for z in range(k):\n                cost = cur * d + c\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cost)\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cost)\n                cur += 2\n\n    ans = mcf.run(N, N + 1)\n    assert ans[0] == k\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.651657167822123e-05, 0.0, -1.1920928244535389e-07, -0.0002169373765354976, -8.296622399939224e-05, -0.3132696747779846, -0.005279764533042908, -0.00012861855793744326, -5.93