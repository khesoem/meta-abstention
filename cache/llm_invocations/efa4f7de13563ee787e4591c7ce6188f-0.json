{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing ll = long long;\nusing tf = int;\nusing tc = int;\nconstexpr tf INF = 1000000000;\n\nstruct Edge {\n    int to, rev;\n    tf f, cap;\n    tc cost;\n};\n\nclass MinCostFlow {\nprivate:\n    int nodeCount;\n    vector<tc> dist, potential;\n    vector<tf> flow;\n    vector<int> lastEdge, lastNode;\n    priority_queue<pair<tc, int>, vector<pair<tc, int>>, greater<pair<tc, int>>> heap;\n    vector<vector<Edge>> adj;\n\npublic:\n    MinCostFlow(int n) : nodeCount(n), dist(n), flow(n), lastEdge(n), lastNode(n), potential(n), adj(n) {}\n\n    void connect(int u, int v, tf capacity, tc cost) {\n        adj[u].push_back({v, (int)adj[v].size(), 0, capacity, cost});\n        adj[v].push_back({u, (int)adj[u].size() - 1, 0, 0, -cost});\n    }\n\n    pair<tf, tc> minCostMaxFlow(int src, int dst) {\n        tf totalFlow = 0;\n        tc totalCost = 0;\n\n        while (true) {\n            heap.emplace(0, src);\n            fill(dist.begin(), dist.end(), INF);\n            dist[src] = 0;\n            flow[src] = INF;\n\n            while (!heap.empty()) {\n                auto [d, u] = heap.top();\n                heap.pop();\n\n                if (d != dist[u]) continue;\n\n                for (int i = 0; i < (int)adj[u].size(); ++i) {\n                    Edge &e = adj[u][i];\n                    int v = e.to;\n\n                    if (e.cap <= e.f) continue;\n\n                    tc nd = dist[u] + e.cost + potential[u] - potential[v];\n                    if (dist[v] > nd) {\n                        dist[v] = nd;\n                        heap.emplace(nd, v);\n                        lastNode[v] = u;\n                        lastEdge[v] = i;\n                        flow[v] = min(flow[u], e.cap - e.f);\n                    }\n                }\n            }\n\n            if (dist[dst] == INF) break;\n\n            for (int i = 0; i < nodeCount; ++i)\n                potential[i] += dist[i];\n\n            tf df = min(flow[dst], INF - totalFlow);\n            totalFlow += df;\n\n            for (int v = dst; v != src; v = lastNode[v]) {\n                Edge &e = adj[lastNode[v]][lastEdge[v]];\n                e.f += df;\n                adj[v][e.rev].f -= df;\n                totalCost += df * e.cost;\n            }\n        }\n\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int T = 150;\n    int N = n * T;\n    MinCostFlow solver(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            solver.connect(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        solver.connect(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        solver.connect(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n\n        for (int j = 0; j < T - 1; ++j) {\