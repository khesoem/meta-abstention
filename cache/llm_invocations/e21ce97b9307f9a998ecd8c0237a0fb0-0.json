l[11], target[11];\nint Zr, Zc, offsets[4][2] = {{0,1},{0,-1},{1,0},{-1,0}};\nint dists[101][101];\nint N, T;\nvector<int> rowsB, colsB;\n\nvoid bfs_run(int r, int c, int* outDists, bool withCheck) {\n    queue<pair<int,int>> Q;\n    outDists[r*N + c] = 0;\n    Q.emplace(r, c);\n    while (!Q.empty()) {\n        auto [x, y] = Q.front(); Q.pop();\n        int idx = x*N + y;\n        int curDist = outDists[idx];\n        if (withCheck && (dists[Zr*N + Zc][idx] <= curDist || T <= curDist)) {\n            if (dists[Zr*N + Zc][idx] < curDist || T < curDist) outDists[idx] = INF + 1;\n            continue;\n        }\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + offsets[k][0], ny = y + offsets[k][1];\n            if (nx < 0 || ny < 0 || nx == N || ny == N) continue;\n            if (target[nx][ny] < '0' || target[nx][ny] > '9') continue;\n            int nidx = nx*N + ny;\n            if (outDists[nidx] != INF) continue;\n            outDists[nidx] = curDist + 1;\n            Q.emplace(nx, ny);\n        }\n    }\n}\n\nvoid setup() {\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            if (target[i][j] >= '1' && target[i][j] <= '9') {\n                rowsB.emplace_back(i);\n                colsB.emplace_back(j);\n                capacity[(i*N + j) + 2 + N*N][1] = target[i][j] - '0';\n            }\n    int zIdx = Zr*N + Zc;\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            if (initial[i][j] >= '1' && initial[i][j] <= '9') {\n                int idx = i*N + j;\n                capacity[0][idx + 2] = initial[i][j] - '0';\n                for (int k = 0; k < rowsB.size(); ++k) {\n                    int ri = rowsB[k], ci = colsB[k];\n                    int qi = ri*N + ci;\n                    if (dists[idx][qi] < INF)\n                        capacity[idx + 2][qi + 2 + N*N] = INF;\n                }\n            }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin >> N >> T;\n    mem