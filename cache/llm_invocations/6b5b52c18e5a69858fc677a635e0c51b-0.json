edge(graph, 0, lr[(int)i], 1, 0);\n        }\n        \n        final long TIME_STEPS = 99;\n        for (long j = 0; j < TIME_STEPS - 1; ++j) {\n            for (long i = 2; i <= n_in; ++i) {\n                add_edge(graph, j * 50 + i, (j + 1) * 50 + i, 50, c_in);\n            }\n        }\n        \n        for (long j = 1; j < TIME_STEPS; ++j) {\n            add_edge(graph, j * 50 + 1, 1, 50, 0);\n        }\n        \n        List<List<Long>> adj = new ArrayList<>();\n        for (int i = 0; i < 55; i++) {\n            adj.add(new ArrayList<>());\n        }\n        \n        for (long i = 0; i < m_in; ++i) {\n            long x = sc.nextLong();\n            long y = sc.nextLong();\n            adj.get((int)x).add(y);\n            adj.get((int)y).add(x);\n            \n            for (long j = 0; j < TIME_STEPS - 1; ++j) {\n                for (long l = 0; l < 50; ++l) {\n                    long delta_cost = c_in + d_in * ((l + 1) * (l + 1) - l * l);\n                    add_edge(graph, j * 50 + x, (j + 1) * 50 + y, 1, delta_cost);\n                    add_edge(graph, j * 50 + y, (j + 1) * 50 + x, 1, delta_cost);\n                }\n            }\n        }\n        \n        long total_flow = 0;\n        long total_cost = 0;\n        \n        while (total_flow < k_in) {\n            long[] dist = new long[(int)N_NODES];\n            int[] parent = new int[(int)N_NODES];\n            int[] parent_edge_idx = new int[(int)N_NODES];\n            int[] in_queue = new int[(int)N_NODES];\n            Queue<Integer> q = new LinkedList<>();\n            \n            Arrays.fill(dist, (int)N_NODES, (int)N_NODES, (int)INF);\n            Arrays.fill(parent, -1);\n            \n            dist[(int)s] = 0;\n            q.offer((int)s);\n            in_queue[(int)s] = 1;\n            \n            while (!q.isEmpty()) {\n                int u = q.poll();\n                in_queue[u] = 0;\n                \n                for (int i = 0; i < graph.get(u).size(); ++i) {\n                    Edge e = graph.get(u).get(i);\n                    if (e.flow < e.cap && dist[u] + e.cost < dist[(int)e.to]) {\n                        dist[(int)e.to] = dist[u] + e.cost;\n                        parent[(int)e.to] = u;\n                        parent_edge_idx[(int)e.to] = i;\n                        if (in_queue[(int)e.to] == 0) {\n                            q.offer((int)e.to);\n                            in_queue[(int)e.to] = 1;\n                        }\n                    }\n                }\n            }\n            \n            if (dist[(int)t] == INF) break;\n            \n            long flow_add = k_in - total_flow;\n            for (long v = t; v != s; v = parent[v]) {\n                long u = parent[v];\n                int idx = parent_edge_idx[(int)v];\n                flow_add = Math.min(flow_add, graph.get((int)u).get(idx).cap - graph.get((int)u).get(idx).flow);\n            }\n            \n            for (long v = t; v != s; v = parent[v]) {\n                long u = parent[v];\n                int idx = parent_edge_idx[(int)v];\n                int rev_idx = graph.get((int)u).get(idx).rev;\n                graph.get((int)u).get(idx).flow += flow_add;\n                graph.get((int)v).get(rev_idx).flow -= flow_add;\n                total_cost += graph.get((int)u).get(idx).cost * flow_add;\n            }\n            \n            total_flow += flow_add;\n        }\n        \n        System.out.println(total_cost);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018463814922142774, -2.622600959512056e-06, -4.768370445162873e-07, -0.0021045696921646595, -4.7205765440594405e-05, -0.08894971013069153, -0.07004893571138382, -1.2040065485052764e-05, -2.3841855067985307e-07, -6.472854875028133e-05, -0.007606589701026678, -0.00018010901112575084, -0.0010145523119717836, -0.17573200166225433, -1.7046782886609435e-05, -2.3841855067985307e-07, -1.311301275563892e-0