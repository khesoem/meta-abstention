\n        int testCases = 1;\n        StringBuilder output = new StringBuilder();\n\n        for (int t = 0; t < testCases; t++) {\n            char[] s = br.readLine().trim().toCharArray();\n            int len = s.length;\n\n            if (len == 1) {\n                if (s[0] == '0' || s[0] == '_' || s[0] == 'X' || s[0] == '1') {\n                    output.append(1).append('\\n');\n                    continue;\n                }\n            }\n\n            long total = 0;\n            boolean hasX = false;\n            for (char c : s) {\n                if (c == 'X') {\n                    hasX = true;\n                    break;\n                }\n            }\n\n            if (hasX) {\n                for (char digit = '0'; digit <= '9'; digit++) {\n                    total += computeValidNumbers(replaceXWith(s, digit), len);\n                }\n            } else {\n                total += computeValidNumbers(s, len);\n            }\n\n            output.append(total).append('\\n');\n        }\n\n        System.out.print(output);\n    }\n\n    public static long countForSuffix(char[] digits, String target, int length, int unknownCount) {\n        if (length < 2) return 0;\n        char last = target.charAt(1);\n        char first = target.charAt(0);\n\n        if ((digits[length - 1] == '_' || digits[length - 1] == last) &&\n            (digits[length - 2] == '_' || digits[length - 2] == first)) {\n            return (long) Math.pow(10, unknownCount);\n        }\n        return 0;\n    }\n\n    public static long computeValidNumbers(char[] digits, int n) {\n        if (n == 1 || digits[0] == '0') return 0;\n\n        int unknownCount = 0;\n        for (int i = 1; i < n - 2; i++) {\n            if (digits[i] == '_') unknownCount++;\n        }\n\n        long result = 0;\n        result += countForSuffix(digits, \"25\", n, unknownCount);\n        result += countForSuffix(digits, \"50\", n, unknownCount);\n        result += countForSuffix(digits, \"75\