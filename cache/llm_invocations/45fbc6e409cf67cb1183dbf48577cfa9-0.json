 - 2);\n    for (int i = 0; i < n; ++i) {\n        f[i][0] = 1;\n        for (int j = 0; j < n; ++j) {\n            int P;\n            scanf(\"%d\", &P);\n            int p1 = 1LL * P * inv100 % MOD;\n            int p0 = (MOD + 1 - p1) % MOD;\n            for (int k = 0; k < (1 << j); ++k) {\n                f[i][k | (1 << j)] = 1LL * f[i][k] * p1 % MOD;\n                f[i][k] = 1LL * f[i][k] * p0 % MOD;\n            }\n        }\n    }\n    for (int i = 0; i < (1 << n); ++i)\n        cnt[i] = cnt[i >> 1] + (i & 1);\n    for (int i = 0; i < (1 << n); ++i) {\n        vec[cnt[i]].push_back(i);\n        id[i] = (int)vec[cnt[i]].size() - 1;\n    }\n    printf(\"%d\\n\", DP(0, 1));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef qpow(x, y):\n    return pow(x, y, MOD)\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    inv100 = qpow(100, MOD - 2)\n    f = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        f[i][0] = 1\n        for j in range(n):\n            P = next(it)\n            p1 = P * inv100 % MOD\n            p0 = (MOD + 1 - p1) % MOD\n            for k in range(1 << j):\n                f[i][k | (1 << j)] = f[i][k] * p1 % MOD\n                f[i][k] = f[i][k] * p0 % MOD\n    cnt = [0] * (1 << n)\n    for i in range(1 << n):\n        cnt[i] = cnt[i >> 1] + (i & 1)\n    vec = [[] for _ in range(n + 1)]\n    id = [0] * (1 << n)\n    for i in range(1 << n):\n        c = cnt[i]\n        vec[c].append(i)\n        id[i] = len(vec[c]) - 1\n    memo = {}\n    def DP(x, sta):\n        if sta == 0:\n            return 0\n        if x == n:\n            return 1\n        key = (x, sta)\n        if key in memo:\n            return memo[key]\n        ans = 0\n        for j in range(1, 1 <<