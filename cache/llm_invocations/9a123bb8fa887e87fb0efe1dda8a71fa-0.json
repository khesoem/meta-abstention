port sys\n\nMOD = 10**9 + 7\n\nclass Matrix:\n    def __init__(self, n):\n        self.n = n\n        self.a = [[0] * n for _ in range(n)]\n\n    def set_identity(self):\n        for i in range(self.n):\n            self.a[i][i] = 1\n\n    def __mul__(self, rhs):\n        n = self.n\n        # Use a temporary list of lists for accumulation to avoid repeated mod\n        tmp = [[0] * n for _ in range(n)]\n        for i in range(n):\n            for k in range(n):\n                aik = self.a[i][k]\n                if aik == 0:\n                    continue\n                row_rhs = rhs.a[k]\n                for j in range(n):\n                    tmp[i][j] += aik * row_rhs[j]\n                    if tmp[i][j] >= MOD * MOD:\n                        tmp[i][j] -= MOD * MOD\n        # Apply modulo\n        res = Matrix(n)\n        for i in range(n):\n            for j in range(n):\n                res.a[i][j] = tmp[i][j] % MOD\n        return res\n\ndef solver1_main(n, k):\n    # Convert n to base k digits (least significant first)\n    num = []\n    temp = n\n    while temp:\n        num.append(temp % k)\n        temp //= k\n    cnt = len(num)\n    # If n == 0, cnt == 0, handle specially\n    if cnt == 0:\n        # No digits, ans is identity, result is 1 (last column sum)\n        print(1)\n        return\n\n    # f[level][digit] matrices\n    f = [[None] * k for _ in range(cnt)]\n    sump = [[None] * k for _ in range(cnt)]\n    sums = [[None] * k for _ in range(cnt)]\n\n    # Level 0\n    for d in range(k):\n        mat = Matrix(k + 1)\n        mat.set_identity()\n        # Set row d to all ones (0-indexed)\n        for j in range(k + 1):\n            mat.a[d][j] = 1\n        f[0][d] = mat\n\n    sump[0][0] = f[0][0]\n    for d in range(1, k):\n        sump[0][d] = f[0][d] * sump[0][d - 1]\n\n    sums[0][k - 1] = f[0][k - 1]\n    for d in range(k - 2, -1, -1):\n        sums[0][d] = sums[0][d + 1] * f[0][d]\n\n    # Higher levels\n    for level in range(1, cnt):\n        for d in range(k):\n            if d == 0:\n                f[level][d] = sums[level - 1][d]\n            else:\n                f[level][d] = sump[level - 1][d - 1] * sums[level - 1][d]\n\n        sump[level][0] = f[level][0]\n        for d in range(1, k):\n            sump[level][d] = f[level][d] * sump[level][d - 1]\n\n        sums[level][k - 1] = f[level][k - 1]\n        for d in range(k - 2, -1, -1):\n            sums[level][d] = sums[level][d + 1] * f[level][d]\n\n    # Combine digits from most significant to least\n    ans = Matrix(k + 1)\n    ans.set_identity()\n    sum_digits = 0\n    for i in range(cnt - 1, -1, -1):\n        digit = num[i]\n        for j in range(digit):\n            idx = (sum_digits + j) % k\n            ans = f[i][idx] * ans\n        sum_digits = (sum_digits + digit) % k\n\n    # Compute result: sum of last column\n    res = 0\n    for i in range(k + 1):\n        res = (res + ans.a[i][k]) % MOD\n    print(res)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    solver1_main(n, k)\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-0.0003418338019400835, -0.3876664340496063, -1.1920928244535389e-07, -0.0001299296854995191, -0.2524775266647339, -7.152555099310121e-07, -0.0002628219372127205, -2.3841830625315197e-06, -1.1920928244535389e-07, -3.6000557884108275e-05, -0.10103123635053635, -0.04858914390206337, 0.0, -0.00026127262390218675, -1.4305104514278355e-06, 0.0, -0.011064484715461731, -0.00412446865811944, -4.887569048150908e-06, -2.3841855067985307e-07, -8.344646857949556e-07, -0.0029264739714562893, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -0.0007211944903247058, -0.03842475265264511, 0.0, -1.1920928244535389e-07, -3.8742269680369645e-05, 0.0, 0.0, -1.0728830375228426e-06, 0.0, -0.00020346954988781363, -0.0012711548479273915, 0.0, -6.198863957251888e-06, -1.1920928244535389e-07, -0.3133776485919