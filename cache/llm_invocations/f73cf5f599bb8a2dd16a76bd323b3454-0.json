is.cost = cost;\n        }\n    }\n\n    int n;\n    List<List<Edge>> adj;\n    long[] potential;\n    long oo = Long.MAX_VALUE;\n    long[] dist;\n    Edge[] back;\n\n    public MinCostMaxFlow(int n) {\n        this.n = n;\n        this.adj = new ArrayList<>();\n        for (int i=0; i<n; i++) {\n            adj.add(new ArrayList<>());\n        }\n        potential = new long[n];\n        dist = new long[n];\n        back = new Edge[n];\n    }\n\n    public void addEdge(int src, int dst, long cap, long cost) {\n        Edge e1 = new Edge(src, dst, adj.get(dst).size(), 0, cap, cost);\n        Edge e2 = new Edge(dst, src, adj.get(src).size(), 0, 0, -cost);\n        adj.get(src).add(e1);\n        adj.get(dst).add(e2);\n    }\n\n    private long rcost(Edge e) {\n        return e.cost + potential[e.src] - potential[e.dst];\n    }\n\n    private long dijkstra(int source, int sink) {\n        Arrays.fill(dist, oo);\n        PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n        dist[source] = 0;\n        pq.offer(new long[]{0, source});\n        while (!pq.isEmpty()) {\n            long[] p = pq.poll();\n            long d = p[0];\n            int u = (int)p[1];\n            if (dist[u] < d) continue;\n            if (u == sink) break;\n            for (Edge e : adj.get(u)) {\n                if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e)) {\n                    dist[e.dst] = dist[e.src] + rcost(e);\n                    back[e.dst] = e;\n                    pq.offer(new long[]{dist[e.dst], e.dst});\n                }\n            }\n        }\n        return dist[sink];\n    }\n\n    public long[] maxFlow(int source, int sink) {\n        long flow = 0;\n        long cost = 0;\n        for (List<Edge> edges : adj) {\n            for (Edge e : edges) e.flow = 0;\n        }\n        Arrays.fill(potential, 0);\n        Arrays.fill(dist, 0);\n        Arrays.fill(back, null);\n        while (dijkstra(source, sink) < oo) {\n            for (int u=0; u<n; u++) {\n                if (dist[u] < dist[sink]) {\n                    potential[u] += dist[u] - dist[sink];\n                }\n            }\n            long f = Long.MAX_VALUE;\n            for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                f = Math.min(f, e.cap - e.flow);\n            }\n            for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                e.flow += f;\n                adj.get(e.dst).get(e.rev).flow -= f;\n            }\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return new long[]{flow, cost};\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br=new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st=new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int size = (n + 2) * 102;\n        MinCostMaxFlow g = new MinCostMaxFlow(size);\n        for (int i=0; i<102; i++) {\n            g.addEdge(i*(n+2)+1, i*(n+2), 100, i*c);\n        }\n        for (int i=0; i<101; i++) {\n            for (int j=0; j<n+1; j++) {\n                int from = j + (i*(n+2));\n                int to = j + ((i+1)*(n+2));\n                g.addEdge(from, to, 100, 0);\n            }\n        }\n\n        int[] uArr = new int[k];\n        for (int i=0; i<k; i++) {\n            uArr[i] = Integer.parseInt(br.readLine());\n            g.addEdge(n+1, uArr[i], 1, 0);\n        }\n\n        for (int i=0; i<m; i++) {\n            st=new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            for (int j=0; j<101; j++) {\n                for (int f=0; f<k; f++) {\n                    long costVal = ((2*f)+1)*d;\n                    g.addEdge(u + (j*(n+2)), v + ((j+1)*(n+2)), 1, costVal);\n                    g.addEdge(v + (j*(n+2)), u + ((j+1)*(n+2)), 1, costVal);\n                }\n            }\n        }\n\n        long[] result = g.maxFlow(n+1, 101*(n+2));\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002087853499688208, -9.674858301877975e-05, -9.088346359931165e-07, -0.00024299313372466713, -7.465036105713807e-06, -4.320199877838604e-07, -0.0013302408624440432, -0.09040699899196625, -0.08341917395591736, -0.00025073037249967456, -0.30790117383003235, -0.0012114259880036116, -4.141046047210693, -0.057057783007621765, -7.584239938296378e-06, -7.541112427134067e-05, -1.9361264946837764e-07, -0.07703596353530884, -0.002727013546973467, -0.14777635037899017, -0.0001431114797014743, -9.729906196298543e-06, -9.610702363715973e-06, -1.1472419600977446e-06, -4.7994282795116305e-05, -4.334533878136426e-05, -0.00027456742827780545, -0.0024821963161230087, -7.44574936106801e-05, -4.961759259458631e-06, -0.0006320207612589002, -1.9361264946837764e-07, -0.17975328862667084, -9.729906196298543e-06, -2.2603901015827432e-05, -0.001034595537930727, -3.35706390615087e-05, -5.512236498361744e-07, -0.014174441806972027, -1.0280383548888494e-06, -0.757716953754425, -0.03169145807623863, -1.1369686126708984, -1.652451464906335e-05, -6.754368223482743e-05, -0.0141702089458704, -6.957014556974173e-05, 0.0, -3.128163257315464e-07, -1.3856492842023727e-06, -7.493430894101039e-05, -1.6240566083070007e-06, -4.842555426876061e-06, -7.896309739408025e-07, -1.5332478142227046e-05, -1.0087516784551553e-05, -1.9361264946837764e-07, -8.061054359131958e-06, -9.968312951968983e-06, -5.512236498361744e-07, -5.080963092041202e-06, -0.007677965331822634, -1.1517960956552997e-05, -2.816093228830141e-06, -3.128163257315464e-07, -3.4