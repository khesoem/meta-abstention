== center) continue;\n                        for (int j = 0; j < n; j++) {\n                            if (j == center || j == i) continue;\n                            Point v1 = points.get(i).diff(points.get(center));\n                            Point v2 = points.get(j).diff(points.get(center));\n                            if (v1.isAcute(v2)) return false;\n                        }\n                    }\n                    return true;\n                })\n                .map(i -> i + 1)\n                .collect(Collectors.toList());\n        writer.println(result.size());\n        result.forEach(writer::println);\n        writer.close();\n    }\n\n    static class Point {\n        final long a, b, c, d, e;\n\n        Point(long a, long b, long c, long d, long e) {\n            this.a = a;\n            this.b = b;\n            this.c = c;\n            this.d = d;\n            this.e = e;\n        }\n\n        Point diff(Point other) {\n            return new Point(a - other.a, b - other.b, c - other.c, d - other.d, e - other.e);\n        }\n\n        boolean isAcute(Point other) {\n            return a * other.a + b * other.b + c * other.c + d * other.d + e * other.e > 0;\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <iterator>\n\nusing namespace std;\n\nclass Point {\npublic:\n    long long a, b, c, d, e;\n\n    Point(long long a, long long b, long long c, long long d, long long e) \n        : a(a), b(b), c(c), d(d), e(e) {}\n\n    Point diff(const Point& other) const {\n        return Point(a - other.a, b - other.b, c - other.c, d - other.d, e - other.e);\n    }\n\n    bool isAcute(const Point& other) const {\n        return a * other.a + b * other.b + c * other.c + d * other.d + e * other.e > 0;\n    }\n};\n\nint main() {\n    ios_base::sync_with_