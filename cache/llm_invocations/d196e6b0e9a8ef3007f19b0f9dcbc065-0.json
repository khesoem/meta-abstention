ys = (ways + comb * compute(heavyRemaining - h, lightRemaining - l, movesRemaining - 1, !boatLeft)) % MOD;\n                    }\n                }\n            }\n        } else {\n            int hTaken = numHeavy - heavyRemaining;\n            int lTaken = numLight - lightRemaining;\n            for (int h = 0; h <= hTaken; h++) {\n                for (int l = 0; l <= lTaken; l++) {\n                    if (h + l > 0 && 2 * h + l <= boatLimit) {\n                        long comb = (binomial[hTaken][h] * binomial[lTaken][l]) % MOD;\n                        ways = (ways + comb * compute(heavyRemaining + h, lightRemaining + l, movesRemaining - 1, !boatLeft)) % MOD;\n                    }\n                }\n            }\n        }\n        return cache[heavyRemaining][lightRemaining][movesRemaining][side] = ways;\n    }\n\n    static long fastPow(long base, long exp, long mod) {\n        long res = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % mod;\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        int n = Integer.parseInt(br.readLine().trim());\n        boatLimit = Integer.parseInt(br.readLine().trim()) / 50;\n        numHeavy = 0;\n        numLight = 0;\n        for (int i = 0; i < n; i++) {\n            int weight = Integer.parseInt(br.readLine().trim());\n            if (weight == 100) numHeavy++;\n            else numLight++;\n        }\n\n        cache = new long[numHeavy + 1][numLight + 1][201][2];\n        for (int i = 0; i <= numHeavy; i++) {\n            for (int j = 0; j <= numLight; j++) {\n                for (int k = 0; k <= 200; k++) {\n                    cache[i][j][k][0] = -1;\n                    cache[i][j][k][1] = -1;\n                }\n            }\n        }\n\n        bino