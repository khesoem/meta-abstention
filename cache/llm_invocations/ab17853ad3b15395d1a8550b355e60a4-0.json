uare(a):\n    n = len(a)\n    res = [0] * (2 * n - 1)\n    for i in range(n):\n        for j in range(i, n):\n            prod = a[i] * a[j]\n            if i == j:\n                res[i + j] = (res[i + j] + prod) % MOD\n            else:\n                res[i + j] = (res[i + j] + 2 * prod) % MOD\n    return res\n\ndef multiply(a, b):\n    lenA = len(a)\n    lenB = len(b)\n    res = [0] * (lenA + lenB - 1)\n    for i in range(lenA):\n        for j in range(lenB):\n            res[i + j] = (res[i + j] + a[i] * b[j]) % MOD\n    return res\n\ndef solve():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    K = int(data[1])\n    d = [int(data[i+2]) for i in range(K)]\n    \n    f = [0] * 20\n    for i in range(K):\n        for j in range(K):\n            f[10 + d[i] - d[j]] += 1\n    \n    n //= 2\n    g = [1]\n    \n    for D in range(17, -1, -1):\n        g = trimZeros(square(g))\n        if (n << (D)) != 0:  # Check if bit D is set in n\n            g = trimZeros(multiply(g, f))\n    \n    result = g[n * 10] % MOD if n * 10 < len(g) else 0\n    print(result)\n\ndef main():\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-5.566918844124302e-05, -4.768370445162873e-07, -1.1920928244535389e-07, -0.0009380945703014731, -0.006054394878447056, -0.00029690624796785414, -0.008705402724444866, -0.17427536845207214, -0.061968736350536346, -8.189342770492658e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.9073468138230965e-06, -2.145764938177308e-06, -5.125986263010418e-06, -5.900685573578812e-05, -1.07287787614041e-05, -2.777537883957848e-05, -7.271740287251305e-06, -2.586808113846928e-05, -2.3007127310847864e-05, -0.02071554586291313, -0.2162349820137024, -0.3872534930706024, -4.768370445162873e-07, -1.0728830375228426e-06, -3.2186455882765586e-06, -2.50339189733495e-06, -0.00011157367407577112, -2.3841855067985307e-07, -2.145764938177308e-06, -7.152555099310121e-