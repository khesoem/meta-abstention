k/deepseek-v4-flash"}, "response": {"samples": [{"content": "```java\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int to, int cap, int cost, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static class MinCostFlow {\n        int V;\n        ArrayList<Edge>[] G;\n        int[] dist;\n        int[] prevv;\n        int[] preve;\n        final int INF = Integer.MAX_VALUE / 2;\n\n        void init(int n) {\n            V = n;\n            G = new ArrayList[V];\n            for (int i = 0; i < V; i++) {\n                G[i] = new ArrayList<>();\n            }\n            dist = new int[V];\n            prevv = new int[V];\n            preve = new int[V];\n        }\n\n        void addEdge(int from, int to, int cap, int cost) {\n            G[from].add(new Edge(to, cap, cost, G[to].size()));\n            G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n        }\n\n        int minCostFlow(int s, int t, int f) {\n            int res = 0;\n            while (f > 0) {\n                Arrays.fill(dist, INF);\n                dist[s] = 0;\n                boolean updated;\n                for (int i = 0; i < V; i++) {\n                    updated = false;\n                    for (int v = 0; v < V; v++) {\n                        if (dist[v] == INF) continue;\n                        for (int j = 0; j < G[v].size(); j++) {\n                            Edge e = G[v].get(j);\n                            if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                                dist[e.to] = dist[v] + e.cost;\n                                prevv[e.to] = v;\n                                preve[e.to] = j;\n                                updated = true;\n                            }\n                        }\n                    }\n                    if (!updated) break;\n                }\n                if (dist[t] == INF) {\n                    return -1;\n                }\n                int d = f;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, G[prevv[v]].get(preve[v]).cap);\n                }\n                f -= d;\n                res += d * dist[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = G[prevv[v]].get(preve[v]);\n                    e.cap -= d;\n                    G[v].get(e.rev).cap += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] a = new int[50];\n        int[] cnt = new int[50];\n        for (int i = 0; i < k; i++) {\n            a[i] = sc.nextInt();\n            cnt[a[i] - 1]++;\n        }\n\n        ArrayList<Integer>[] e = new ArrayList[50];\n        for (int i = 0; i < 50; i++) {\n            e[i] = new ArrayList<>();\n        }\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            e[x].add(y);\n            e[y].add(x);\n        }\n\n        final int T = 100;\n        MinCostFlow mcf = new MinCostFlow();\n        mcf.init(n * T + 2);\n\n        // source to initial positions\n        for (int i = 0; i < n; i++) {\n            mcf.addEdge(n * T, i, cnt[i], 0);\n        }\n\n        // time nodes to sink\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i * n, n * T + 1, k, c * i);\n        }\n\n        // stay edges\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(j * n + i, (j + 1) * n + i, k, 0);\n            }\n        }\n\n        // move edges\n        for (int i = 0; i < n; i++