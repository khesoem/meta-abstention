k < m; ++mask) {\n                if (__builtin_popcount(mask) != used) {\n                    continue;\n                }\n\n                for (int gi = 0; gi < (int)good.size(); ++gi) {\n                    int nxt = good[gi];\n                    if ((mask >> nxt) & 1) {\n                        continue;\n                    }\n\n                    dp[layer][mask | (1 << nxt)] +=\n                        dp[layer ^ 1][mask] * p[nxt] / sum[mask];\n                }\n            }\n\n            layer ^= 1;\n        }\n\n        layer ^= 1;\n\n        for (int i = 0; i < n; ++i) {\n            if (!is_good[i]) {\n                printf(\"%.12f \\n\", 0.0);\n            } else {\n                double ans = 0.0;\n                for (int mask = 0; mask < m; ++mask) {\n                    if ((mask >> i) & 1) {\n                        ans += dp[layer][mask];\n                    }\n                }\n                printf(\"%.12f \\n\", ans);\n            }\n        }\n    }\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    out_lines = []\n    while True:\n        try:\n            n = int(next(it))\n            k = int(next(it))\n        except StopIteration:\n            break\n        p = [float(next(it)) for _ in range(n)]\n        m = 1 << n\n\n        # sum[mask] = 1 - sum_{i in mask} p[i]\n        sum_mask = [0.0] * m\n        sum_mask[0] = 1.0\n        for mask in range(1, m):\n            lsb = mask & -mask\n            bit = lsb.bit_length() - 1\n            sum_mask[mask] = sum_mask[mask ^ (1 << bit)] - p[bit]\n\n        good = [i for i, val in enumerate(p) if val != 0.0]\n        is_good = [1 if val != 0.0 else 0 for val in p]\n        limit = min(len(good), k)\n\n        # precompute popcount for all masks\n        popcnt = [i.bit_count() for i in range(m)]\n\n        dp = [[0.0] * m for _ in range(2)]\n        dp[0][0] = 1.0\n        cur, nxt = 0, 1\n\n        for used in range(limit):\n            dp[nxt] = [0.0] * m\n            for mask in range(m):\n                if popcnt[mask] != used:\n                    continue\n                val = dp[cur][mask]\n                if val == 0.0:\n                    continue\n                for gi in good:\n                    if mask & (1 << gi):\n                        continue\n                    new_mask = mask | (1 << gi)\n                    dp[nxt][new_mask] += val * p[gi] / sum_mask[mask]\n            cur, nxt = nxt, cur\n\n        for i in range(n):\n            if not is_good[i]:\n                out_lines.append(f\"{0.0:.12f} \")\n            else:\n                ans = 0.0\n                for mask in range(m):\n                    if mask & (1 << i):\n                        ans += dp[cur][mask]\n                out_lines.append(f\"{ans:.12f} \")\n\n    sys.stdout.write('\\n'.join(out_lines))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.775113539944869e-06, 0.0, -5.960462772236497e-07, -0.0002762889489531517, -0.00047434045700356364, 0.0, -9.905801562126726e-05, -5.960462772236497e-07, -0.005234346725046635, -0.3132639229297638, -1.6689286894688848e-06, -3.576278118089249e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -1.2755313036905136e-05, -1.4305104514278355e-06, -0.0004312062228564173, 0.0, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, 0.0, -0.00014053787162993103, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.2172682292875834e-05, 0.0, -0.0002083561266772449, -0.02985212579369545, -7.486063259420916e-05, -0.31327202916145325, -0.01104797888547182, -4.6491513785440475e-06, 0.0, -2.3841855067985307e-07, 0.0, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.192