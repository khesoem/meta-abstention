int):\n            other = other.v\n        self.v = self.v * mint(other).inv().v % MOD\n        return self\n\n    def inv(self):\n        # extended Euclidean algorithm\n        a, b = self.v, MOD\n        x, y, u, v = 1, 0, 0, 1\n        while b:\n            q = a // b\n            a, b = b, a - q * b\n            x, u = u, x - q * u\n            y, v = v, y - q * v\n        # a is gcd, should be 1\n        return mint(x % MOD)\n\n    def pow(self, p):\n        if p < 0:\n            return self.inv().pow(-p)\n        res = mint(1)\n        base = mint(self.v)\n        while p:\n            if p & 1:\n                res *= base\n            base *= base\n            p >>= 1\n        return res\n\n    def __eq__(self, other):\n        if isinstance(other, mint):\n            return self.v == other.v\n        return self.v == other\n\n    def __ne__(self, other):\n        return not self.__eq__(other)\n\n    def __repr__(self):\n        return str(self.v)\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    p = [[mint(0) for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            val = int(next(it))\n            p[i][j] = mint(val) / mint(100)\n\n    cur = {}\n    # initial bitset: only bit 0 set (subset 0)\n    cur[1] = mint(1)  # 1 << 0 = 1\n\n    for i in range(n):\n        nxt = {}\n        for b, prob in cur.items():\n            # iterate over all x such that bit x is set in b\n            for x in range(1 << n):\n                if (b >> x) & 1:\n                    for e in range(1 << n):\n                        pr = mint(1)\n                        for j in range(n):\n                            if (e >> j) & 1:\n                                pr *= p[i][j]\n                            else:\n                                pr *= mint(1) - p[i][j]\n                        nb = 0\n                        for r in range(n):\n                            if ((e >> r) & 1) and not ((x >> r) & 1):\n                                nb |= (1 << (x | (1 << r)))\n                        if nb:\n                            nxt[nb] = nxt.get(nb, mint(0)) + prob * pr\n        cur = nxt\n\n    ans = mint(0)\n    full_mask = (1 << n) - 1\n    for b, prob in cur.items():\n        if (b >> full_mask) & 1:\n            ans += prob\n    print(ans.v)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.10068313032388687, -4.768258077092469e-05, 0.0, 0.0, -0.00033909291960299015, -0.0012416280806064606, 0.0, -0.023249756544828415, -0.004253745079040527, -1.6689286894688848e-06, -2.3841855067985307e-07, -9.154854342341423e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.549708758830093e-05, -0.03823992982506752, -0.7320103049278259, -2.50339189733495e-06, -3.3378546504536644e-06, -0.47966665029525757, -7.152555099310121e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.004103455226868391, -2.3603161025675945e-05, 0.0, -2.4914430468925275e-05, -5.960462772236497e-07, -0.3139890730381012, -0.00017510310863144696, -1.1920928244535389e-07, -1.5497195136049413e-06, -0.10025705397129059, -1.2278481335670222e-05, -1.5497195136049413e-06, -9.60780744208023e-05, -1.5497195136049413e-06, 0.0, -2.7418097943154862e-06, 0.0, -0.0009116546134464443, -0.00033539868309162557, -0.0024756519123911858, -2.3841855067985307e-07, -1.311301275563892e-06, -0.02158413454890251, -1.1920928244535389e-07, 0.0, -0.0229553934186697, -2.264974000354414e-06, 0.0, -0.041107214987277985, -0.027230674400925636, -0.0001559135998832062, -4.172316494077677e-06, 0.0, -6.556489552167477e-06, -4.017272294731811e-05, -4.768370445162873e-07, -0.00026127262390218675, -3.576278118089249e-07, 0.0, 0.0, -5.960462772236497e-07, 0.0, -0.032114915549755096, -2.3841830625315197e-06, -0.10028347373008728, -0.0012902038870379329, -0.0165229551