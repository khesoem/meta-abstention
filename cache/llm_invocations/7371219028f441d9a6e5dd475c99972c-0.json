is*b.inv();}\n\tModInt& operator+=(const ModInt& b){ return *this=*this+b;}\n\tModInt& operator-=(const ModInt& b){ return *this=*this-b;}\n\tModInt& operator*=(const ModInt& b){ return *this=*this*b;}\n\tModInt& operator/=(const ModInt& b){ return *this=*this/b;}\n\tModInt inv() const {\n\t\tll x,y;\n\t\textgcd(v,mod,x,y);\n\t\treturn make(normS(x+mod));\n\t}\n\tModInt pow(ll p) const {\n\t\tif(p<0) return inv().pow(-p);\n\t\tModInt a=1, x=*this;\n\t\twhile(p){ if(p&1) a*=x; x*=x; p>>=1; }\n\t\treturn a;\n\t}\n\tll extgcd(ll a,ll b,ll &x,ll &y) const{\n\t\tll p[]={a,1,0},q[]={b,0,1};\n\t\twhile(*q){\n\t\t\tll t=*p/ *q;\n\t\t\trep(i,3) swap(p[i]-=t*q[i],q[i]);\n\t\t}\n\t\tif(p[0]<0) rep(i,3) p[i]=-p[i];\n\t\tx=p[1]; y=p[2];\n\t\treturn p[0];\n\t}\n\tbool operator==(const ModInt& b) const { return v==b.v;}\n\tbool operator!=(const ModInt& b) const { return v!=b.v;}\n\tfriend istream& operator>>(istream &o,ModInt& x){ ll tmp; o>>tmp; x=ModInt(tmp); return o;}\n\tfriend ostream& operator<<(ostream &o,const ModInt& x){ return o<<x.v;}\n};\nusing mint = ModInt<1000000007>;\n\nusing BS = bitset<128>;\nbool B(int x,int i){return (x>>i)&1;}\n\nint main(){\n\tios::sync_with_stdio(false);\n\tcin.tie(0);\n\tcout << fixed << setprecision(20);\n\tint n;\n\tcin >> n;\n\tVV<mint> p(n, V<mint>(n));\n\tfor(int i=0; i<n; ++i) for(int j=0; j<n; ++j){ cin >> p[i][j]; p[i][j] /= 100; }\n\n\tunordered_map<BS,mint> cur, nxt;\n\t{\n\t\tBS b; b[0] = true; cur[b] = 1;\n\t}\n\tfor(int i=0; i<n; ++i){\n\t\tfor(auto &kv : cur){\n\t\t\tBS b = kv.first;\n\t\t\t// iterate over all subsets that are set in b, without building a vector\n\t\t\tfor(int x=0; x < (1<<n); ++x){\n\t\t\t\tif(!b[x]) continue;\n\t\t\t\tfor(int e=0; e < (1<<n); ++e){\n\t\t\t\t\tmint pr = 1;\n\t\t\t\t\tfor(int j=0; j<n; ++j){\n\t\t\t\t\t\tif(B(e,j)) pr *= p[i][j];\n\t\t\t\t\t\telse pr *= mint(1) - p[i][j];\n\t\t\t\t\t}\n\t\t\t\t\tBS nb;\n\t\t\t\t\tfor(int r=0; r<n; ++r){\n\t\t\t\t\t\tif(B(e,r) && !B(x,r)) nb[x | (1<<r)] = true;