epseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static long gcd(long a, long b) {\n        while (b != 0) {\n            a %= b;\n            long temp = a;\n            a = b;\n            b = temp;\n        }\n        return a;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        scanner.close();\n\n        long g = gcd(x, y);\n        x /= g;\n        y /= g;\n\n        if (y <= n) {\n            System.out.println(x + \"/\" + y);\n            return;\n        }\n\n        long bestNum = 1000000000L;\n        long bestDen = 1L;\n        long i = 1L;\n        while (i <= n) {\n            long cur = (x * i) / y;\n            // candidate cur\n            if (bestDen * Math.abs(x * i - cur * y) < i * Math.abs(x * bestDen - bestNum * y)) {\n                bestDen = i;\n                bestNum = cur;\n            }\n            cur++;\n            // candidate cur+1\n            if (bestDen * Math.abs(x * i - cur * y) < i * Math.abs(x * bestDen - bestNum * y)) {\n                bestDen = i;\n                bestNum = cur;\n            }\n            i++;\n        }\n        System.out.println(bestNum + \"/\" + bestDen);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-7.390948667307384e-06, 0.0, 0.0, -1.1920858014491387e-05, -2.9801878554280847e-05, -1.1920928244535389e-07, -5.8410845667822286e-05, -0.008662622421979904, -0.001510551548562944, -5.960446742392378e-06, 0.0, -0.0017177602276206017, -4.8874615458771586e-05, -0.0004325169720686972, -0.6950797438621521, 0.0, -0.47407907247543335, -7.152555099310121e-07, -3.576278118089249e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -1.5497195136049413e-06, -1.7881377516459906e-06, -1.1920928244535389e-07, -0.000263