{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <queue>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long LL;\n\ntemplate<int MAXN>\nstruct MaxFlow {\n    int head[MAXN], tot, cur[MAXN], d[MAXN], u, v, s, t, src, sink;\n\n    struct Edge {\n        int v, nxt, cap;\n    } E[111111];\n\n    void add(int u, int v, int cap) {\n        E[tot] = {v, head[u], cap};\n        head[u] = tot++;\n        E[tot] = {u, head[v], 0};\n        head[v] = tot++;\n    }\n\n    void init() {\n        memset(head, -1, sizeof head);\n        tot = 0;\n    }\n\n    bool bfs() {\n        memset(d, -1, sizeof d);\n        memcpy(cur, head, sizeof head);\n        d[src] = 0;\n        queue<int> Q;\n        Q.push(src);\n        while (!Q.empty()) {\n            u = Q.front(); Q.pop();\n            for (int i = head[u]; ~i; i = E[i].nxt) {\n                v = E[i].v;\n                if (d[v] == -1 && E[i].cap) {\n                    d[v] = d[u] + 1;\n                    Q.push(v);\n                }\n            }\n        }\n        return d[sink] != -1;\n    }\n\n    int dfs(int u, int in) {\n        if (u == sink) return in;\n        int flow = 0, f;\n        for (int &i = cur[u]; ~i; i = E[i].nxt) {\n            v = E[i].v;\n            if (d[v] == d[u] + 1 && E[i].cap) {\n                f = dfs(v, min(in - flow, E[i].cap));\n                if (f) {\n                    flow += f;\n                    E[i].cap -= f;\n                    E[i ^ 1].cap += f;\n                    if (flow == in) break;\n                }\n            }\n        }\n        if (flow < in) d[u] = -1;\n        return flow;\n    }\n\n    const int INF = 1e9;\n    int dinic(int _src, int _sink) {\n        src = _src, sink = _sink;\n        int flow = 0;\n        while (bfs())\n            flow += dfs(src, INF);\n        return flow;\n    }\n};\n\nint n;\nconst int SZ = 15;\nchar field[SZ][SZ], capsule[SZ][SZ];\nint Z[SZ][SZ], S[SZ][SZ];\nint dx[] = {-1, 1, 0, 0};\nint dy[] = {0, 0, -1, 1};\n\ninline bool In(int i, int j) {\n    return i >= 0 && i < n && j >= 0 && j < n;\n}\n\nMaxFlow<210> F;\nint t;\nconst int INF = 1e9;\n\ninline bool isDigit(char ch) {\n    return ch >= '1' && ch <= '9';\n}\n\nvoid bfs(int x, int y, int d[][SZ], bool f) {\n    int sx = x, sy = y;\n    fill(d[0], d[SZ], INF);\n    d[x][y] = 0;\n    queue<pair<int,int>> Q;\n    Q.push({x, y});\n    if (f && isDigit(capsule[x][y])) {\n        F.add(sx * n + sy, sx * n + sy + n * n, INF);\n    }\n    while (!Q.empty()) {\n        auto [x, y] = Q.front(); Q.pop();\n        if (d[x][y] == t) break;\n        for (int o = 0; o < 4; ++o) {\n            int xx = x + dx[o];\n            int yy = y + dy[o];\n            if (In(xx, yy) && d[xx][yy] == INF && capsule[xx][yy] != 'Y') {\n                if (Z[xx][yy] > d[x][y] + 1 || (Z[xx][yy] == d[x][y] + 1 && isDigit(capsule[xx][yy]))) {\n                    d[xx][yy] = d[x][y] + 1;\n                    if (f && isDigit(capsule[xx][yy])) {\n                        F.add(sx * n + sy, xx * n + yy + n * n, INF);\n                    }\n                    if (Z[xx][yy] > d[x][y] + 1 || !f) {\n                        Q.push({xx, yy});\n                    }\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    int x, y;\n    scanf(\"%d%d\", &n, &t);\n    int src = n * n * 2, sink = src + 1;\n    F.init();\n    for (int i = 0; i < n; ++i) {\n        scanf(\"%s\", field[i]);\n        for (int j = 0; j < n; ++j) {\n            if (field[i][j] == 'Z') {\n                x = i, y = j;\n            }\n        }\n    }\n    for (int i = 0; i < n; ++i) {\n        scanf(\"%s\", capsule[i]);\n        for (int j = 0; j < n; ++j) {\n            if (isDigit(capsule[i][j])) {\n                F.add(i * n + j + n * n, sink, capsule[i][j] - '0');\n            }\n        }\n    }\n    bfs(x, y, Z, false);\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (isDigit(field[i][j])) {\n                F.add(src, i * n + j, field[i][j] - '0');\n                bfs(i, j, S, true);\n            }\n        }\n    }\n    printf(\"%d\\n\", F.dinic(src, sink));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Dinic:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n\n    def add_edge(self, u, v, cap):\n        self.adj[u].append([v, cap, len(self.adj[v])])\n        self.adj[v].append([u, 0, len(self.adj[u]) - 1])\n\n    def bfs(self, s, t):\n        self.level = [-1] * self.n\n        q = deque([s])\n        self.level[s] = 0\n        while q:\n            u = q.popleft()\n            for v, cap, rev in self.adj[u]:\n                if cap > 0 and self.level[v] == -1:\n                    self.level[v] = self.level[u] + 1\n                    q.append(v)\n        return self.level[t] != -1\n\n    def dfs(self, u, t, f):\n        if u == t:\n            return f\n        for i in range(self.it[u], len(self.adj[u])):\n            self.it[u] = i\n            v, cap, rev = self.adj[u][i]\n            if cap > 0 and self.level[u] + 1 == self.level[v]:\n                ret = self.dfs(v, t, min(f, cap))\n                if ret > 0:\n                    self.adj[u][i][1] -= ret\n                    self.adj[v][rev][1] += ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef is_digit(ch):\n    return '1' <= ch <= '9'\n\ndef bfs(start_x, start_y, dist, f, n, t, capsule, Z, F, src_node):\n    # dist is a 2D list to fill, f is boolean indicating whether to add edges\n    for i in range(n):\n        for j in range(n):\n            dist[i][j] = INF\n    dist[start_x][start_y] = 0\n    q = deque()\n    q.append((start_x, start_y))\n    if f and is_digit(capsule[start_x][start_y]):\n        F.add_edge(src_node, start_x * n + start_y + n * n, INF)\n    while q:\n        x, y = q.popleft()\n        if dist[x][y] == t:\n            break\n        for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]:\n            xx, yy = x + dx, y + dy\n            if 0 <= xx < n and 0 <= yy < n and dist[xx][yy] == INF and capsule[xx][yy] != 'Y':\n                if Z[xx][yy] > dist[x][y] + 1 or (Z[xx][yy] == dist[x][y] + 1 and is_digit(capsule[xx][yy])):\n                    dist[xx][yy] = dist[x][y] + 1\n                    if f and is_digit(capsule[xx][yy]):\n                        F.add_edge(src_node, xx * n + yy + n * n, INF)\n                    if Z[xx][yy] > dist[x][y] + 1 or not f:\n                        q.append((xx, yy))\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    field = [list(next(it).strip()) for _ in range(n)]\n    capsule = [list(next(it).strip()) for _ in range(n)]\n\n    # find Z position\n    zx = zy = -1\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                zx, zy = i, j\n                break\n        if zx != -1:\n            break\n\n    # node indices: 0..n*n-1 for field cells, n*n..2*n*n-1 for capsule cells, then src, sink\n    src = 2 * n * n\n    sink = src + 1\n    F = Dinic(2 * n * n + 2)\n\n    # add edges from capsule cells to sink\n    for i in range(n):\n        for j in range(n):\n            if is_digit(capsule[i][j]):\n                cap = int(capsule[i][j])\n                F.add_edge(i * n + j + n * n, sink, cap)\n\n    # BFS from Z to compute Z distances\n    Z = [[0]*n for _ in range(n)]\n    bfs(zx, zy, Z, False, n, t, capsule, Z, F, None)  # f=False, no edges added\n\n    # for each field cell with digit, add edge from src and run BFS\n    for i in range(n):\n        for j in range(n):\n            if is_digit(field[i][j]):\n                cap = int(field[i][j])\n                src_node = i * n + j\n                F.add_edge(src, src_node, cap)\n                S = [[0]*n for _ in range(n)]  # not used later, just for BFS\n                bfs(i, j, S, True, n, t, capsule, Z, F, src_node)\n\n    result = F.max_flow(src, sink)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.77468371274881e-05, -1.1920928244535389e-07, 0.0, -0.0002903516869992018, -0.06501064449548721, -1.3470558769768104e-05, -6.794906312279636e-06, -1.4424220353248529e-05, 0.0, 0.0, -9.536738616588991e-07, -0.004089802503585815, -0.12909634411334991, -5.9960475482512265e-05, -5.829164365422912e-05, -5.8412379075889476e-06, -0.3132624328136444, -6.079655122448457e-06, -0.062497228384017944, -0.47675028443336487, -0.00015889335190877318, 0.0, -2.3841855067985307e-07, -1.19209282445