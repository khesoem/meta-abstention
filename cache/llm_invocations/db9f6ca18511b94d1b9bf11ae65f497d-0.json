 example, the string above consists of seven words: \"Hello\", \"Vasya\", \"and\", \"Petya\", \"bye\", \"and\" and \"OK\". Write a program that finds:  the length of the longest word outside the parentheses (print 0, if there is no word outside the parentheses),  the number of words inside the parentheses (print 0, if there is no word inside the parentheses). \n</problem_description>\n\nHere is the Java 8 code you have to repair:\n<original_code>\nimport java.io.*;\npublic class test {\n    public static void main(String[] args) throws IOException {\n        DataInputStream dis = new DataInputStream(System.in);\n        int n = Integer.parseInt(dis.readLine());\n        String s = dis.readLine() + \"  \";\n        int maxUnderscoreSeq = 0, parenCount = 0, tempCount = 0, pos = 0, innerCount = 0;\n        char current, next;\n        \n        while (pos < n) {\n            current = s.charAt(pos);\n            if (current == '(') {\n                int innerPos = pos + 1;\n                innerCount = 0;\n                while (innerPos < s.length() && s.charAt(innerPos) != ')') {\n                    if (s.charAt(innerPos) != '_') {\n                        innerCount++;\n                    } else {\n                        if (innerCount > 0) parenCount++;\n                        innerCount = 0;\n                    }\n                    innerPos++;\n                }\n                pos = innerPos + 1;\n                if (innerCount > 0) parenCount++;\n            } else {\n                if (current != '_') tempCount++;\n                next = s.charAt(pos + 1);\n                if (current == '_' || next != '(') {\n                    if (tempCount > maxUnderscoreSeq) maxUnderscoreSeq = tempCount;\n                    tempCount = 0;\n                }\n                pos++;\n            }\n        }\n        if (tempCount > maxUnderscoreSeq) maxUnderscoreSeq = tempCount;\n        System.out.println(maxUnderscoreSeq + \" \" + parenCount);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\npublic class test {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String s = br.readLine();\n        s = s + \"  \"; // Add padding to avoid index out of bounds\n        \n        int maxOutside = 0;\n        int parenCount = 0;\n        int tempCount = 0;\n        boolean insideParen = false;\n        \n        for (int i = 0; i < s.length(); i++) {\n            char c = s.charAt(i);\n            \n            if (c == '(') {\n                // Check if we have a word before this parenthesis\n                if (tempCount > 0) {\n                    if (insideParen) {\n                        parenCount++;\n                    } else {\n                        if (tempCount > maxOutside) {\n                            maxOutside = tempCount;\n                        }\n                    }\n                    tempCount = 0;\n                }\n                insideParen = true;\n            } else if (c == ')') {\n                // Check if we have a word before this closing parenthesis\n                if (tempCount > 0) {\n                    if (insideParen) {\n                        parenCount++;\n                    } else {\n                        if (tempCount > maxOutside) {\n                            maxOutside = tempCount;\n                        }\n                    }\n                    tempCount = 0;\n                }\n                insideParen = false;\n            } else if (c == '_') {\n                // Check if we have a word before this underscore\n                if (tempCount > 0) {\n                    if (insideParen) {\n                        parenCount++;\n                    } else {\n                        if (tempCount > maxOutside) {\n    