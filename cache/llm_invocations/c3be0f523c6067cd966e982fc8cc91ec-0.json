        int idx = e.size();\n            g[u].add(idx - 2);\n            g[v].add(idx - 1);\n        }\n\n        boolean find_path(long[] fc) {\n            Arrays.fill(dist, INF);\n            Arrays.fill(vis, false);\n            Queue<Integer> q = new LinkedList<>();\n            dist[0] = 0;\n            vis[0] = true;\n            cap_on_path[0] = INF;\n            q.add(0);\n\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                vis[u] = false;\n                for (int idx : g[u]) {\n                    Edge ed = e.get(idx);\n                    if (ed.capacity > ed.flow && dist[ed.dst] > dist[u] + ed.cost_val) {\n                        dist[ed.dst] = dist[u] + ed.cost_val;\n                        par_edge[ed.dst] = idx;\n                        cap_on_path[ed.dst] = Math.min(cap_on_path[u], ed.capacity - ed.flow);\n                        if (!vis[ed.dst]) {\n                            vis[ed.dst] = true;\n                            q.add(ed.dst);\n                        }\n                    }\n                }\n            }\n\n            if (dist[1] == INF) return false;\n            fc[0] = cap_on_path[1];\n            fc[1] = dist[1];\n            int cur = 1;\n            while (cur != 0) {\n                int idx = par_edge[cur];\n                e.get(idx).flow += fc[0];\n                e.get(idx ^ 1).flow -= fc[0];\n                cur = e.get(idx).src;\n            }\n            return true;\n        }\n\n        long[] mincost(int src, int dst) {\n            long total_flow = 0, total_cost = 0;\n            long[] fc = new long[2];\n\n            while (find_path(fc)) {\n                total_flow += fc[0];\n                total_cost += fc[0] * fc[1];\n            }\n\n            return new long[]{total_flow, total_cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner cin = new Scanner(System.in);\n        int n = cin.nextInt();\n        int m = cin.nextInt();\n        int k = cin.nextInt();\n        int C = cin.nextInt();\n        int D = cin.nextInt();\n\n        MinCostFlowSolver g = new MinCostFlowSolver(n * MAX_T + 2);\n        int source_id = n * MAX_T;\n        int sink_id = n * MAX_T + 1;\n\n        for (int t = 0; t < MAX_T; ++t) {\n            g.link(t, sink_id, k, C * t);\n        }\n\n        for (int i = 0; i < k; ++i) {\n            int x = cin.nextInt();\n            --x;\n            g.link(source_id, x * MAX_T, 1, 0);\n        }\n\n        for (int i = 0; i < n; ++i) {\n            for (int t = 1; t < MAX_T; ++t) {\n                g.link(i * MAX_T + t - 1, i * MAX_T + t, k, 0);\n            }\n        }\n\n        while (m-- > 0) {\n            int u = cin.nextInt();\n            int v = cin.nextInt();\n            --u;\n            --v;\n\n            for (int t = 1; t < MAX_T; ++t) {\n                int a = u * MAX_T + t - 1;\n                int b = v * MAX_T + t;\n                int c = v * MAX_T + t - 1;\n                int d = u * MAX_T + t;\n\n                for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                    g.link(a, b, 1, cc);\n                    g.link(c, d, 1, cc);\n                }\n            }\n        }\n\n        long[] ans = g.mincost(source_id, sink_id);\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002115741081070155, -2.145764938177308e-06, -4.768370445162873e-07, -0.00014911970356479287, -4.827859811484814e-05, -0.22542861104011536, -0.07906137406826019, -0.000302030734019354, -2.3841855067985307e-07, -0.0015470929211005569, -0.02324649505317211, -9.679325739853084e-05, -0.0017364437226206064, -0.14516468346118927, -0.0003587556129787117, -1.2993727978027891e-05, 0.0, -2.3841855067985307e-07, 0.0, -6.9141146923357155e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, -9.536738616588991e-07, -8.106198947643861e-06, -2.3841855067985307e-07, 0.0, -5