ctor<int>(vNum, 0));\n        cost.assign(vNum, vector<int>(vNum, 0));\n        d.resize(vNum);\n        p.resize(vNum);\n    }\n\n    void addEdge(int from, int to, int capacity, int costVal) {\n        res[from][to] += capacity;\n        cost[from][to] = costVal;\n        cost[to][from] = -costVal;\n    }\n\n    bool findCheapestPath() {\n        costGraph.clear();\n        for (int i = 0; i < vNum; ++i) {\n            for (int j = 0; j < vNum; ++j) {\n                if (res[i][j] > 0) {\n                    costGraph.emplace_back(i, j, cost[i][j]);\n                }\n            }\n        }\n        fill(d.begin(), d.end(), INF);\n        fill(p.begin(), p.end(), -1);\n        d[src] = 0;\n        bool changed = false;\n        for (int i = 0; i < vNum - 1; ++i) {\n            changed = false;\n            for (const Edge& e : costGraph) {\n                if (d[e.from] != INF && d[e.from] + e.cost < d[e.to]) {\n                    d[e.to] = d[e.from] + e.cost;\n                    p[e.to] = e.from;\n                    changed = true;\n                }\n            }\n            if (!changed) break;\n        }\n        return p[sink] != -1;\n    }\n\n    pair<int,int> augmentPath(int from, int to, int flow) {\n        int pathCost = 0;\n        for (int cur = to; cur != from; cur = p[cur]) {\n            flow = min(flow, res[p[cur]][cur]);\n        }\n        for (; to != from; to = p[to]) {\n            res[p[to]][to] -= flow;\n            res[to][p[to]] += flow;\n            pathCost += cost[p[to]][to] * flow;\n        }\n        return {flow, pathCost};\n    }\n\n    pair<int,int> getMinCostMaxFlow() {\n        int flow = 0;\n        int totalCost = 0;\n        while (findCheapestPath()) {\n            auto result = augmentPath(src, sink, INF);\n            flow += result.first;\n            totalCost += result.second;\n        }\n        return {flow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    