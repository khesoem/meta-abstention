ine.trim().isEmpty()) {\n            return;\n        }\n        String[] parts = line.trim().split(\"\\\\s+\");\n        if (parts.length < 2) {\n            return;\n        }\n        int n = Integer.parseInt(parts[0]);\n        int mod = Integer.parseInt(parts[1]);\n        \n        int[] mem = new int[n + 1];\n        mem[0] = 0;\n        if (n >= 1) {\n            mem[1] = 1;\n        }\n        int su = 1; // sum of mem[0..1] mod mod? Actually su = (mem[0]+mem[1])%mod = 1%mod, but mod may be 1? We'll keep as int.\n        // In Python, su = 1 (not modulo), but later su = (su+cur)%mod. So su is always modulo mod.\n        // We'll keep su modulo mod from start.\n        su = 1 % mod;\n        \n        for (int i = 2; i <= n; i++) {\n            int sq = (int) Math.sqrt(i) + 1;\n            long cur = su; // use long to avoid overflow during additions\n            // large divisors: f from 2 to sq-1\n            for (int f = 2; f < sq; f++) {\n                cur = (cur + mem[i / f]) % mod;\n            }\n            // small divisors using direct difference\n            int limit = i / sq;\n            for (int j = 1; j <= limit; j++) {\n                int diff = i / j - i / (j + 1);\n                cur = (cur + (long) diff * mem[j]) % mod;\n            }\n            mem[i] = (int) cur;\n            su = (su + (int) cur) % mod;\n        }\n        System.out.println(mem[n]);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -4.6132929128361866e-05, -1.5616295058862306e-05, 0.0, -0.0015023384476080537, -0.6934873461723328, -0.0005529781919904053, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.00016425691137555987, -1.0728830375228426e-06, 0.0, -0.03307389095425606, -9.810443589231e-05, -2.7418097943154862e-06, -1.8358061424805783e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.06196783855557442, -1.1920928244535389e-07, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -0.02975377254188