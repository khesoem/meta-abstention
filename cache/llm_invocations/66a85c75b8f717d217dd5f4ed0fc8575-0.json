        }\n\n        int ni() {\n            return in.nextInt();\n        }\n\n        void pn(long zx) {\n            out.println(zx);\n        }\n\n        class Tuple {\n            long d;\n            int x;\n            int y;\n            int z;\n\n            Tuple(long d, int x, int y, int z) {\n                this.d = d;\n                this.x = x;\n                this.y = y;\n                this.z = z;\n            }\n\n        }\n\n    }\n\n    static class InputReader {\n        private InputStream stream;\n        private byte[] buf = new byte[1024];\n        private int curChar;\n        private int numChars;\n\n        public InputReader(InputStream stream) {\n            this.stream = stream;\n        }\n\n        public int read() {\n            if (numChars == -1) {\n                throw new UnknownError();\n            }\n            if (curChar >= numChars) {\n                curChar = 0;\n                try {\n                    numChars = stream.read(buf);\n                } catch (IOException e) {\n                    throw new UnknownError();\n                }\n                if (numChars <= 0) {\n                    return -1;\n                }\n            }\n            return buf[curChar++];\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        public String next() {\n            int c = read();\n            while (isSpaceChar(c)) {\n                c = read();\n            }\n            StringBuffer res = new StringBuffer();\n            do {\n                res.appendCodePoint(c);\n                c = read();\n            } while (!isSpaceChar(c));\n\n            return res.toString();\n        }\n\n        private boolean isSpaceChar(int c) {\n            return c == ' ' || c == '\\n' || c == '\\r' || c == '\\t' || c == -1;\n        }\n\n    }\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <cstring>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst ll MOD = 1000000007;\nconst ll INF = (ll)1e18 + 1;\n\nll nCr[100][100];\n\nll f(ll p, int a, int b, int c, int d) {\n    p = p * nCr[a][b] % MOD;\n    p = p * nCr[c][d] % MOD;\n    return p;\n}\n\nstruct Tuple {\n    ll d;\n    int x, y, z;\n    Tuple(ll d, int x, int y, int z) : d(d), x(x), y(y), z(z) {}\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n\n    // Precompute nCr\n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j <= i; j++) {\n            if (j == 0 || j == i)\n                nCr[i][j] = 1;\n            else\n                nCr[i][j] = (nCr[i-1][j] + nCr[i-1][j-1]) % MOD;\n        }\n    }\n\n    int n, K;\n    cin >> n >> K;\n    int cnt1 = 0, cnt2 = 0;\n    for (int i = 0; i < n; i++) {\n        int w;\n        cin >> w;\n        if (w == 50) cnt1++;\n        else cnt2++;\n    }\n\n    // dist and dp arrays: [200][200][2]\n    vector<vector<vector<ll>>> dist(200, vector<vector<ll>>(200, vector<ll>(2, INF)));\n    vector<vector<vector<ll>>> dp(200, vector<vector<ll>>(200, vector<ll>(2, 0)));\n\n    dist[0][0][0] = 0;\n    dp[0][0][0] = 1;\n\n    queue<Tuple> q;\n    q.push(Tuple(0, 0, 0, 0));\n\n    while (!q.empty()) {\n        Tuple cur = q.front();\n        q.pop();\n        int x = cur.x, y = cur.y, z = cur.z;\n        ll d = dist[x][y][z];\n\n        if (z == 0) {\n            int rem_x = cnt1 - x;\n            int rem_y = cnt2 - y;\n            for (int i = 0; i <= rem_x; i++) {\n                for (int j = 0; j <= rem_y; j++) {\n                    if (i + j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int nx = x + i, ny = y + j, nz = z ^ 1;\n                    if (dist[nx][ny][nz] >= d + 1) {\n                        ll add = f(dp[x][y][z], rem_x, i, rem_y, j);\n                        if (dist[nx][ny][nz] > d + 1) {\n                            dist[nx][ny][nz] = d + 1;\n                            q.push(Tuple(dist[nx][ny][nz], nx, ny, nz));\n                            dp[nx][ny][nz] = add;\n                        } else {\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + add) % MOD;\n                        }\n                    }\n                }\n            }\n        } else {\n            int rem_x = x;\n            int rem_y = y;\n            for (int i = 0; i <= rem_x; i++) {\n                for (int j = 0; j <= rem_y; j++) {\n                    if (i + j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int nx = x - i, ny = y - j, nz = z ^ 1;\n                    if (dist[nx][ny][nz] >= d + 1) {\n                        ll add = f(dp[x][y][z], rem_x, i, rem_y, j);\n                        if (dist[nx][ny][nz] > d + 1) {\n                            dist[nx][ny][nz] = d + 1;\n                            q.push(Tuple(dist[nx][ny][nz], nx, ny, nz));\n                            dp[nx][ny][nz] = add;\n                        } else {\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + add) % MOD;\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    if (dist[cnt1][cnt2][1] == INF) {\n        cout << -1 << '\\n';\n    } else {\n        cout << dist[cnt1][cnt2][1] << '\\n';\n    }\n    cout << dp[cnt1][cnt2][1] << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.0265558760002023e-06, 0.0, 0.0, -0.00039402826223522425, -0.00013851160474587232, -2.2411095415009186e-05, -0.47481489181518555, -1.0132738680113107e-05, 0.0, 0.0, -0.15876859426498413, -1.5497195136049413e-06, 0.0, 0.0, -0.009990096092224121, -1.0728830375228426e-06, 0.0, 0.0, -0.3871173560619354, -0.0003401654539629817, -0.0007102350937202573, -1.1920928244535