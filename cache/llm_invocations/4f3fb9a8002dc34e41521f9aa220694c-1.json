ple_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\nROOT = 15311432\nINVROOT = 469870224\n\ndef mod_pow(a, p):\n    return pow(a, p, MOD)\n\ndef mod_inv(a):\n    return pow(a, MOD - 2, MOD)\n\ndef bit_reverse(n, k):\n    \"\"\"Reverse the lowest k bits of n and return as an integer.\"\"\"\n    result = 0\n    for i in range(k):\n        result = (result << 1) | ((n >> i) & 1)\n    return result\n\ndef number_theoretic_transform(coef, k, inverse):\n    base_root = INVROOT if inverse else ROOT\n    # root = base_root ^ (2^(23-k)) mod MOD\n    root = pow(base_root, 1 << (23 - k), MOD)  # use bit shift for 2^(23-k)\n    roots = [0] * k\n    roots[k - 1] = root\n    for i in range(k - 1, 0, -1):\n        roots[i - 1] = (roots[i] * roots[i]) % MOD\n    for s in range(k):\n        length = 1 << s\n        for st in range(0, len(coef), 2 * length):\n            cur_root = 1\n            for j in range(st, st + length):\n                t = (cur_root * coef[j + length]) % MOD\n                u = coef[j]\n                coef[j] = (u + t) % MOD\n                coef[j + length] = (u - t) % MOD\n                cur_root = (roots[s] * cur_root) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it)) // 2\n    m = int(next(it))\n    nums = [int(next(it)) for _ in range(m)]\n    nums.sort()\n    min_size = n * nums[-1] + 2\n    k = 0\n    size = 1\n    while size < min_size:\n        size <<= 1\n        k += 1\n    a = [0] * size\n    for num in nums:\n        a[bit_reverse(num, k)] = 1\n    number_theoretic_transform(a, k, False)\n    for i in range(size):\n        a[i] = pow(a[i], n, MOD)\n    temp = [0] * size\n    for i in range(size):\n        temp[bit_reverse(i, k)] = a[i] % MOD\n    a = temp\n    number_theoretic_transform(a, k, True)\n    ans = 0\n    for val in a:\n        ans = (ans + val * val) % MOD\n    multiplier = mod_inv(size)\n    result = (ans * multiplier % MOD) * multiplier % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1\n</confidence>", "token_logprobs": [-2.3841830625315197e-06, -1.0728830375228426e-06, 0.0, -0.00011062010162277147, -0.0007313199457712471, -1.7881377516459906e-06, -0.01419494766741991, -1.8000440832111053e-05, -2.861018856492592e-06, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -0.0006529344827868044, -8.4638240878121e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.001341634662821889, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.0132738680113107e-05, 0.0, -2.3841855067985307e-07, -8.344646857949556e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0024924185127019882, -2.95634672511369e-05, -0.3133329451084137, -0.21903125941753387, 0.0, -0.02327130362391472, -0.0019288521725684404, -0.10904170572757721, -0.03812748193740845, -2.0265558760002023e-06, -0.02874400094151497, 0.0, -0.0001586549769854173, -0.0009129646932706237, -3.814689989667386e-06, -0.00023112009512260556, -7.152555099310121e-07, -0.000276765669696033, -0.00026782741770148277, -0.0009197533945553005, -8.22540732769994e-06, -1.1920928244535389e-07, -1.5497195136049413e-06, -1.9073468138230965e-06, 0.0, -6.437280717364047e-06, -0.07889657467603683, 0.0, 0.0, -2.3841855067985307e-07, -0.07889283448457718, -1.1920928244535389e-07, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -3.933898824470816e-06, -1.6927575416048057e-05, -1.4305104514278355e-06, -4.768370445162873e-07, -9.536738616588991e-07, -0.014239137060940266, -2.1576648578047752e-05, -4.768370445162873e-07, -9.536738616588991e-07, -7.152555099310121e-07, -1.698481559753418, -0.2223256379365921, -0.005457146558910608, -0.0778428390622139, -1.4543427823809907e-05, -9.536738616588991e-07, -6.794906312279636e-06, -0.002099335426464