           ++acnt;\n                mval -= r1score[T / 2 - acnt] * rscore[T / 2 - bcnt];\n            } else {\n                ++bcnt;\n                mval += r1score[T / 2 - bcnt] * rscore[T / 2 - acnt];\n            }\n        }\n        if (mval < 0) mval = -mval;\n\n        long tsum = 0;\n        for (int i = 0; i < T; ++i) tsum += lscore[i];\n        tsum = rscore[T / 2] * rscore[T / 2];\n\n        Map<Pair, Long> mmap = new HashMap<>();\n        Map<Pair, Long> nmap = new HashMap<>();\n        mmap.put(new Pair(0L, 0), 1L);\n\n        for (int i = T - 1; i >= 2 * R - 1; --i) {\n            nmap.clear();\n            for (Map.Entry<Pair, Long> kv : mmap.entrySet()) {\n                long sum = kv.getKey().sum;\n                int a = kv.getKey().a;\n                long cnt = kv.getValue();\n\n                int aleft = T / 2 - a;\n                int bleft = i + 1 - aleft;\n\n                long asum = sum + r1score[aleft - 1] * rscore[bleft];\n                long bsum = sum - r1score[bleft - 1] * rscore[aleft];\n\n                if (s.charAt(i) == 'A') {\n                    nmap.merge(new Pair(asum, a + 1), cnt, Long::sum);\n                    nmap.merge(new Pair(bsum, a), 0L, Long::sum);\n                } else if (s.charAt(i) == 'B') {\n                    nmap.merge(new Pair(asum, a + 1), 0L, Long::sum);\n                    nmap.merge(new Pair(bsum, a), cnt, Long::sum);\n                } else {\n                    nmap.merge(new Pair(asum, a + 1), cnt, Long::sum);\n                    nmap.merge(new Pair(bsum, a), cnt, Long::sum);\n                }\n            }\n\n            tsum -= lscore[i];\n\n            mmap.clear();\n            for (Map.Entry<Pair, Long> kv : nmap.entrySet()) {\n                long sum = kv.getKey().sum;\n                int a = kv.getKey().a;\n                long cnt = kv.getValue();\n\n                int aleft = T / 2 - a;\n                int bleft = i - a;\n                if (a > T / 2 || (T - i - a) > T / 2) continue;\n                long lsum = rscore[aleft] * rscore[bleft];\n                if (sum < -mval - lsum || sum > mval + lsum) continue;\n                mmap.merge(new Pair(sum, a), cnt, Long::sum);\n            }\n        }\n\n        long bscore = (long) 1e18;\n        for (Map.Entry<Pair, Long> kv : mmap.entrySet()) {\n            long sval = kv.getKey().sum;\n            bscore = Math.min(bscore, Math.abs(sval));\n        }\n\n        long ans = 0;\n        for (Map.Entry<Pair, Long> kv : mmap.entrySet()) {\n            long sval = kv.getKey().sum;\n            int a = kv.getKey().a;\n            long cnt = kv.getValue();\n            if (sval == bscore || sval == -bscore) {\n                int nleft = 0;\n                for (int j = 0; j < 2 * R - 1; ++j) {\n                    if (s.charAt(j) == 'A') a++;\n                    if (s.charAt(j) == '?') nleft++;\n                }\n                cnt *= choose(nleft, T / 2 - a);\n                ans += cnt;\n            }\n        }\n\n        System.out.println(ans);\n    }\n\n    static class Pair {\n        long sum;\n        int a;\n\n        Pair(long sum, int a) {\n            this.sum = sum;\n            this.a = a;\n        }\n\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            Pair pair = (Pair) o;\n            return sum == pair.sum && a == pair.a;\n        }\n\n        @Override\n        public int hashCode() {\n            return Objects.hash(sum, a);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.3180723e-06, 0.0, 0.0, -0.00010311072, -0.00022277735, -1.1920922e-06, -0.47464493, -0.023966836, -1.8119648e-05, -4.76836e-06, -0.1752759, -0.023270953, -2.8729026e-05, 0.0, -0.018419292, -0.006832451, -0.005251067, -0.018207556, -0.07969815, -0.0068472507, -0.011049394, -3.6954812e-06, -1.1920928e-07, -3.576