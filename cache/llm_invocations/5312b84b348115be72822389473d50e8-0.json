n            f_inv[0] = self.inv(self.fact(n))\n            for i in range(1, len(f_inv)):\n                f_inv[i] = (f_inv[i-1] * (n - i + 1)) % self.modulus_val\n            for i in range(len(f_inv) - 1, -1, -1):\n                self.inv_factorial.append(f_inv[i])\n        return self.inv_factorial[n]\n\n    def parity_sign(self, k):\n        return 1 if (k & 1) == 0 else self.modulus_val - 1\n\n    def ncr(self, n, r):\n        if r < 0 or n < r:\n            return 0\n        return (self.fact(n) * self.inv(self.fact(r)) % self.modulus_val) * self.inv(self.fact(n - r)) % self.modulus_val\n\n    def small_inv(self, n):\n        return (self.inv(self.fact(n)) * self.fact(n - 1)) % self.modulus_val\n\n    def normalize(self, x):\n        x %= self.modulus_val\n        return x if x >= 0 else x + self.modulus_val\n\n    def add(self, a, b):\n        v = a + b\n        return v if v < self.modulus_val else v - self.modulus_val\n\n    def mult(self, *args):\n        r = 1\n        for x in args:\n            r = (r * x) % self.modulus_val\n        return r\n\n    def inv(self, value):\n        g, x, y = self.modulus_val, 0, 1\n        r = value\n        while r != 0:\n            q = g // r\n            g, r = r, g % r\n            x, y = y, x - q * y\n        return self.normalize(x)\n\ndef main():\n    input_data = sys.stdin.read().split()\n    n = int(input_data[0])\n    m = int(input_data[1])\n    \n    mod = Mod998()\n    mod.fInv(n + m)\n    \n    phase_size = 1\n    p = 1\n    for i in range(n + 1):\n        if p == 0:\n            break\n        p = mod.mult(p, mod.mult(n - i, mod.small_inv(n + m - i)))\n        phase_size = mod.add(phase_size, p)\n    \n    answer = 0\n    for k in range(1, n + 1):\n        sign = mod.parity_sign(k + 1)\n        num_phases = mod.mult(m + k, mod.small_inv(k))\n        term = mod.mult(sign, mod.ncr(n, k), num_phases, phase_size)\n        answer = mod.add(answer, term)\n    \n    print(answer)\n\nif __name__ == \"__main__\":