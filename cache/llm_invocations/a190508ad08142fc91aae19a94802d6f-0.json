  S = 202\n    T = 203\n    \n    # graph structures\n    head = [-1] * MAXN\n    edge_to = []\n    edge_cap = []\n    edge_next = []\n    edge_cnt = 0\n    \n    # grid and node ids\n    grid = [None] * n\n    grid2 = [None] * n\n    src_id = [[-1] * n for _ in range(n)]\n    sink_id = [[-1] * n for _ in range(n)]\n    rp = cp = 0\n    node_cnt = 0\n    \n    # directions\n    dr = [-1, 0, 1, 0]\n    dc = [0, 1, 0, -1]\n    \n    # helper functions\n    def add_edge(f, t, c):\n        nonlocal edge_cnt\n        edge_to.append(t)\n        edge_cap.append(c)\n        edge_next.append(head[f])\n        head[f] = edge_cnt\n        edge_cnt += 1\n        # reverse edge\n        edge_to.append(f)\n        edge_cap.append(0)\n        edge_next.append(head[t])\n        head[t] = edge_cnt\n        edge_cnt += 1\n    \n    def bfs(source, sink):\n        nonlocal level_arr\n        level_arr = [-1] * MAXN\n        q = deque()\n        level_arr[source] = 0\n        q.append(source)\n        while q:\n            v = q.popleft()\n            e = head[v]\n            while e != -1:\n                if edge_cap[e] > 0 and level_arr[edge_to[e]] == -1:\n                    level_arr[edge_to[e]] = level_arr[v] + 1\n                    q.append(edge_to[e])\n                e = edge_next[e]\n        return level_arr[sink] != -1\n    \n    def dfs(v, sink, flow):\n        nonlocal level_arr, it_arr\n        if v == sink:\n            return flow\n        while it_arr[v] != -1:\n            e = it_arr[v]\n            if edge_cap[e] > 0 and level_arr[v] + 1 == level_arr[edge_to[e]]:\n                pushed = dfs(edge_to[e], sink, min(flow, edge_cap[e]))\n                if pushed:\n                    edge_cap[e] -= pushed\n                    edge_cap[e ^ 1] += pushed\n                    return pushed\n            it_arr[v] = edge_next[e]\n        return 0\n    \n    def max_flow(source, sink):\n        nonlocal level_arr, it_arr\n        ans = 0\n        while bfs(source, sink):\n  