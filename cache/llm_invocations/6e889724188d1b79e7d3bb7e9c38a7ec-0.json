ent = mask - subset;\n            res = (int) ((res + (long) inv_fact[complement] * solve(used + 1, subset)) % MOD);\n            if (subset == 0) break;\n        }\n        \n        memo[used][mask] = res;\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        k = sc.nextInt();\n        MOD = sc.nextInt();\n        \n        if ((n & 1) == 1) {\n            System.out.println(mod_exp(k, n));\n            return;\n        }\n        \n        fact = new int[n + 1];\n        inv_fact = new int[n + 1];\n        inv = new int[n + 1];\n        fact[0] = inv_fact[0] = fact[1] = inv_fact[1] = inv[1] = 1;\n        \n        for (int i = 2; i <= n; ++i) {\n            fact[i] = (int) ((long) fact[i-1] * i % MOD);\n            inv[i] = (int) ((long) (MOD - MOD / i) * inv[MOD % i] % MOD);\n            inv_fact[i] = (int) ((long) inv_fact[i-1] * inv[i] % MOD);\n        }\n        \n        memo = new int[19][n + 1];\n        for (int i = 0; i < 19; ++i) {\n            Arrays.fill(memo[i], -1);\n        }\n        \n        int ans = (mod_exp(k, n) - solve(0, n) + MOD) % MOD;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001560327800689265, -2.0265558760002023e-06, -1.1920928244535389e-07, -0.000571326119825244, -2.932505594799295e-05, -0.04862184822559357, -0.1804947406053543, -2.4437606043647975e-05, -1.1920922133867862e-06, -3.540453326422721e-05, -0.005929380189627409, -4.565611743601039e-05, -0.07114255428314209, -5.8053239627042785e-05, -7.033323527139146e-06, -9.846202738117427e-05, -0.3868759572505951, -2.9801878554280847e-05, -0.009906649589538574, -0.530677080154419, -4.124556289752945e-05, -3.099436753473128e-06, -0.0017033604672178626, -6.675497570540756e-05, -3.576272320060525e-06, -0.02308645285665989, -0.0025274972431361675, -1.07287787614041e-05, -9.417489309271332e-06, -2.0384581148