emp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class DSU {\n        long[] r, p;\n        \n        void init(int n) {\n            r = new long[n];\n            p = new long[n];\n            for (int i = 0; i < n; i++) {\n                p[i] = i;\n                r[i] = 1;\n            }\n        }\n        \n        int par(int i) {\n            if (i == p[i]) return i;\n            return (int)(p[i] = par((int)p[i]));\n        }\n        \n        void unite(int i, int j) {\n            i = par(i);\n            j = par(j);\n            if (i == j) return;\n            if (r[i] < r[j]) {\n                int temp = i;\n                i = j;\n                j = temp;\n            }\n            p[j] = i;\n            r[i] += r[j];\n        }\n    }\n    \n    static final long MOD = 1000000007;\n    \n    static long pw(long x, long p, long M) {\n        long r = 1;\n        while (p-- > 0) {\n            r = (r * x) % M;\n        }\n        return r;\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        \n        if (k == 0) {\n            System.out.println(pw(n, n - 1, MOD));\n            return;\n        }\n        \n        DSU d = new DSU();\n        d.init(n);\n        \n        for (int i = 0; i < n; i++) {\n            d.unite(i, (int)((i * 1L * k) % n));\n        }\n        \n        long ans = 1;\n        for (int i = 0; i < n; i++) {\n            if (d.par(i) != i) continue;\n            long t = pw(k, d.r[i], n);\n            if (t == 1) {\n                ans = (ans * n) % MOD;\n            }\n        }\n    