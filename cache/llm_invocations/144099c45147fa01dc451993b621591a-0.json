eturn dist, prex, prei\n    \n    def dfs(self, x, flow, prex, prei):\n        if prex[x] == -1:\n            return flow\n        y = x\n        x = prex[y]\n        i = prei[y]\n        j = self.rev[x][i]\n        f = self.dfs(x, min(flow, self.edge_cap[x][i]), prex, prei)\n        self.edge_cap[x][i] -= f\n        self.edge_cap[y][j] += f\n        return f\n    \n    def solve(self, s, t, n):\n        ans = 0\n        tot = 0\n        while True:\n            dist, prex, prei = self.spfa(s, n)\n            if dist[t] > 1e9:\n                break\n            f = self.dfs(t, INF, prex, prei)\n            tot += f * dist[t]\n            ans += f\n        return (ans, tot)\n\ndef get(x, tim):\n    return tim * 52 - 52 + x\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    kk = k\n    \n    s = MAXN - 1\n    t = MAXN - 2\n    \n    mcmf_solver = MCMF()\n    mcmf_solver.init(MAXN)\n    \n    while k:\n        x = int(next(it))\n        mcmf_solver.add_edge(s, get(x, 1), 1, 0)\n        k -= 1\n    \n    k = kk\n    \n    while m:\n        x = int(next(it))\n        y = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf_solver.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        x, y = y, x\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf_solver.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        m -= 1\n    \n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            mcmf_solver.add_edge(get(j, i), get(j, i + 1), INF, 0)\n        mcmf_solver.add_edge(get(1, i), t, INF, c * (i - 1))\n    \n    result = mcmf_solver.solve(s, t, MAXN)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confid