", powMod(p, p - 1));\n        return 0;\n    }\n\n    parent = new int[p];\n    sz = new int[p];\n    rnk = new int[p];\n\n    for (int i = 0; i < p; ++i) {\n        parent[i] = i;\n        sz[i] = 1;\n        rnk[i] = 0;\n    }\n\n    for (int i = 0; i < p; ++i) {\n        int nxt = (int)((k * 1LL * i) % p);\n        unite(nxt, i);\n    }\n\n    ll ans = 1;\n    for (int i = 0; i < p; ++i) {\n        if (findRoot(i) == i) {\n            ans = ans * powCheck(k, sz[i], p) % MOD;\n        }\n    }\n\n    printf(\"%lld\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef findRoot(v, parent):\n    root = v\n    while parent[root] != root:\n        root = parent[root]\n    # path compression\n    while parent[v] != v:\n        nxt = parent[v]\n        parent[v] = root\n        v = nxt\n    return root\n\ndef unite(a, b, parent, sz, rnk):\n    a = findRoot(a, parent)\n    b = findRoot(b, parent)\n    if a == b:\n        return\n    if rnk[a] < rnk[b]:\n        a, b = b, a\n    sz[a] += sz[b]\n    parent[b] = a\n    if rnk[a] == rnk[b]:\n        rnk[a] += 1\n\ndef powMod(a, b):\n    return pow(a, b, MOD)\n\ndef powCheck(a, b, p):\n    res = pow(a, b, p)\n    return p if res == 1 else 1\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    p = int(data[0])\n    k = int(data[1])\n\n    if k == 0:\n        print(powMod(p, p - 1))\n        return\n\n    parent = list(range(p))\n    sz = [1] * p\n    rnk = [0] * p\n\n    for i in range(p):\n        nxt = (k * i) % p\n        unite(nxt, i, parent, sz, rnk)\n\n    ans = 1\n    for i in range(p):\n        if findRoot(i, parent) == i:\n            ans = (ans * powCheck(k, sz[i], p)) % MOD\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logpr