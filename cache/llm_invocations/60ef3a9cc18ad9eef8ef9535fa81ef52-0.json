m.in);\n        int n = sc.nextInt();\n        int t = sc.nextInt();\n        sc.nextLine(); // consume newline\n        String[] a = new String[n];\n        String[] b = new String[n];\n        for (int i = 0; i < n; i++) a[i] = sc.next();\n        for (int i = 0; i < n; i++) b[i] = sc.next();\n\n        int zx = 0, zy = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (a[i].charAt(j) == 'Z') {\n                    zx = i;\n                    zy = j;\n                }\n            }\n        }\n\n        long[][] toReactor = bfsFrom(zx, zy, a);\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (!okCell(i, j, a)) continue;\n                long[][] fromStart = bfsFrom(i, j, a);\n                for (int x = 0; x < n; x++) {\n                    for (int y = 0; y < n; y++) {\n                        if (!okCell(x, y, a)) continue;\n                        if (fromStart[x][y] > t || fromStart[x][y] > toReactor[x][y]) continue;\n                        if (fromStart[x][y] == toReactor[x][y]) {\n                            boolean good = false;\n                            for (int d = 0; d < 4; d++) {\n                                int nx = x + dx[d];\n                                int ny = y + dy[d];\n                                if (!okCell(nx, ny, a) || fromStart[nx][ny] >= toReactor[nx][ny]) continue;\n                                good = true;\n                            }\n                            if (!good) continue;\n                        }\n                        int leftBase = 100 * i + 10 * j;\n                        int rightBase = 100 * x + 10 * y;\n                        int digitA = a[i].charAt(j) - '0';\n                        int digitB = b[x].charAt(y) - '0';\n                        for (int u = 1; u <= digitA; u++) {\n                            for (int v = 1; v <= digitB; v++) {\n                                graph[leftBase + u].add(rightBase + v);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    static boolean tryKuhn(int v) {\n        if (used[v]) return false;\n        used[v] = true;\n        for (int to : graph[v]) {\n            if (parent[to] == 0 || tryKuhn(parent[to])) {\n                parent[to] = v;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    public static void main(String[] args) {\n        for (int i = 0; i < MAXN; i++) graph[i] = new ArrayList<>();\n        buildGraph();\n        for (int i = 0; i < MAXN; i++) {\n            tryKuhn(i);\n            Arrays.fill(used, false);\n        }\n        int answer = 0;\n        for (int i = 0; i < MAXN; i++) {\n            if (parent[i] != 0) answer++;\n        }\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.018520286306738853, -8.22540732769994e-06, 0.0, -1.1920928244535389e-07, -2.8132995794294402e-05, -0.000562271336093545, 0.0, -2.3841830625315197e-06, -0.0001879753835964948, -2.407998726994265e-05, 0.0, -0.0021491781808435917, -0.0052352952770888805, -2.8490614567999728e-05, -0.0015447123441845179, -1.5616295058862306e-05, -0.0002613918040879071, 0.0, 0.0, -0.313381552696228, -1.1920928244535389e-07, -5.829164365422912e-05, -0.25198817253112793, 0.0, -4.0531076592742465e-06, -9.65590606938349e-06, 0.0, 0.0, -0.00020966715237591416, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, 0.0, -4.172316494077677e-06, 0.0, -1.1920928244535389e-07, -1.4305104514278355e-06, -3.576278118089249e-07, -0.5234261751174927, -0.1269294172525406, -2.9802276912960224e-06, -0.6984503269195557, 0.0, 0.0, -3.6954811548639555e-06, 0.0, -0.061971310526132584, -5.006777428206988e-06, 0.0, 0.0, 0.0, -2.2411095415009186e-05, 0.0, 0.0, -3.6954811548639555e-06, -7.867782187531702e-06, 0.0, -2.1457441107486375e-05, 0.0, 0