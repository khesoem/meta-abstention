(a, b)\n\ndef MIN(a, b):\n    return min(a, b)\n\ndef mat_init(a, b):\n    return [[0 for _ in range(b)] for _ in range(a)]\n\ndef mul(A, B):\n    C = [[0 for _ in range(len(B[0]))] for _ in range(len(A))]\n    for i in range(len(A)):\n        for k in range(len(B)):\n            for j in range(len(B[0])):\n                C[i][j] = ADD(C[i][j], A[i][k] * B[k][j])\n    return C\n\ndef show_mat(A):\n    for row in A:\n        print(' '.join(map(str, row)))\n    print()\n\nN, K = map(int, input().split())\ncnt = 0\nnN = 1\nwhile nN <= N:\n    nN *= K\n    cnt += 1\nnN //= K\nd = [0] * cnt\nfor i in range(cnt):\n    d[i] = N // nN\n    N %= nN\n    nN //= K\n\nR = [None] * 40\nD = [[None for _ in range(40)] for _ in range(100)]\n\nfor i in range(41):\n    R[i] = mat_init(K + 1, K + 1)\n\nfor i in range(cnt + 1):\n    for j in range(K):\n        D[i][j] = mat_init(K + 1, K + 1)\n\n# Initialize R[0] and R[1]\nR[0][K][K] = 1\nR[1][K][K] = 1\nfor j in range(K):\n    R[0][j][j] = 1\n    R[1][(j + K - 1) % K][j] = 1\n\nfor j in range(2, K + 1):\n    R[j] = mul(R[j - 1], R[1])\n\n# Initialize D[0][0]\nfor j in range(K + 1):\n    D[0][0][j][j] = 1\n    D[0][0][j][0] = 1\n\nfor i in range(cnt + 1):\n    for j in range(1, K):\n        temp1 = R[K - j]\n        temp2 = D[i][0]\n        temp3 = R[j]\n        D[i][j] = mul(mul(temp1, temp2), temp3)\n    if i < cnt:\n        D[i + 1][0] = D[i][K - 1]\n\nans = [[0 for _ in range(K + 1)]]\nans[0][K] = 1\nmd = 0\n\nfor i in range(cnt):\n    if d[i] != 0:\n        temp1 = R[K - md]\n        temp2 = D[cnt - i - 1][d[i] - 1]\n        temp3 = R[md]\n        ans = mul(ans, mul(mul(temp1, temp2), temp3))\n    md += d[i]\n    md %= K\n\nres = 0\nfor i in range(K + 1):\n    res = ADD(res, ans[0][i])\n\nprint(res)\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00023333763238042593, -0.002857774496078491, -3.128163257315464e-07, -1.0921942703134846e-05, -0.3635135293006897, -0.42875251173973083, -0.2015717923641204