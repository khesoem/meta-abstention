  static void calculateCuts(int[] arr) {\n        int evens = 0;\n        int odds = 0;\n        for (int i = 0; i < arr.length - 1; i++) {\n            if (arr[i] % 2 == 0) evens++;\n            else odds++;\n            if (evens == odds) {\n                cuts.add(Math.abs(arr[i + 1] - arr[i]));\n            }\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n\nint evenCount = 0;\nint oddCount = 0;\nstd::vector<int> cuts;\n\nvoid calculateCuts(std::vector<int>& arr) {\n    int evens = 0;\n    int odds = 0;\n    for (int i = 0; i < static_cast<int>(arr.size()) - 1; i++) {\n        if (arr[i] % 2 == 0) evens++;\n        else odds++;\n        if (evens == odds) {\n            cuts.push_back(std::abs(arr[i + 1] - arr[i]));\n        }\n    }\n}\n\nint main() {\n    int n, budget;\n    std::cin >> n >> budget;\n    \n    std::vector<int> arr(n);\n    \n    for (int i = 0; i < n; i++) {\n        std::cin >> arr[i];\n        if (arr[i] % 2 == 0) evenCount++;\n        else oddCount++;\n    }\n    \n    if (evenCount != oddCount) {\n        std::cout << 0 << std::endl;\n    } else {\n        calculateCuts(arr);\n        std::sort(cuts.begin(), cuts.end());\n        int total = 0;\n        int numCuts = 0;\n        for (size_t i = 0; i < cuts.size(); i++) {\n            int cut = cuts[i];\n            if (total + cut <= budget) {\n                total += cut;\n                numCuts++;\n            } else {\n                break;\n            }\n        }\n        std::cout << numCuts << std::endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001426833332516253, -5.125986263010418e-06, -2.3841855067985307e-07, -3.504691630951129e-05, -1.0728830375228426e-06, -2.2053474822314456e-05, -1.907346813