{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\n#define rep(i, n) for (int i = 0; i < (n); i++)\n#define repr(i, n) for (int i = (n) - 1; i >= 0; i--)\n\nusing namespace std;\nusing ll = long long;\n\nstruct mincostflow {\n  struct edge {\n    int v;\n    long long c;\n    long long w;\n    int r;\n  };\n\n  vector<vector<edge>> G;\n\n  mincostflow(int n) : G(n) {}\n\n  void add(int u, int v, long long c, long long w) {\n    int i = G[u].size();\n    int j = G[v].size();\n    G[u].push_back({v, c, w, j});\n    G[v].push_back({u, 0, -w, i});\n  }\n\n  long long run(int s, int t, long long f) {\n    const int N = G.size();\n    long long res = 0;\n    const long long INF = 1e18;\n    vector<int> PE(N), PV(N);\n    while (f > 0) {\n      vector<long long> D(N, INF);\n      vector<bool> inq(N, false);\n      queue<int> q;\n      D[s] = 0;\n      q.push(s);\n      inq[s] = true;\n      while (!q.empty()) {\n        int u = q.front(); q.pop(); inq[u] = false;\n        for (int i = 0; i < G[u].size(); i++) {\n          edge &e = G[u][i];\n          if (e.c > 0 && D[e.v] > D[u] + e.w) {\n            D[e.v] = D[u] + e.w;\n            PV[e.v] = u;\n            PE[e.v] = i;\n            if (!inq[e.v]) {\n              q.push(e.v);\n              inq[e.v] = true;\n            }\n          }\n        }\n      }\n      if (D[t] == INF) return -1;\n      long long d = f;\n      for (int i = t; i != s; i = PV[i]) {\n        d = min(d, G[PV[i]][PE[i]].c);\n      }\n      f -= d;\n      res += d * D[t];\n      for (int i = t; i != s; i = PV[i]) {\n        edge &e = G[PV[i]][PE[i]];\n        e.c -= d;\n        G[i][e.r].c += d;\n      }\n    }\n    return res;\n  }\n};\n\nint main() {\n  cin.tie(nullptr);\n  ios::sync_with_stdio(false);\n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  rep(i, K) cin >> A[i], A[i]--;\n  vector<int> us(M), vs(M);\n  rep(i, M) {\n    cin >> us[i] >> vs[i];\n    us[i]--;\n    vs[i]--;\n  }\n  mincostflow mcf(N*101+2);\n  int s = N*101;\n  int t = s + 1;\n  for (int i = 0; i < K; i++) {\n    mcf.add(s, A[i], 1, 0);\n  }\n  for (int i = 0; i <= 100; i++) {\n    mcf.add(N * i, t, K, C*i);\n  }\n  for (int i = 0; i < 100; i++) {\n    for (int j = 0; j < N; j++) {\n      mcf.add(i*N+j, (i+1)*N+j, K, 0);\n    }\n    for (int j = 0; j < M; j++) {\n      for (int k = 1; k <= K; k++) {\n        mcf.add(N*i + us[j], N*(i+1) + vs[j], 1, (2*k-1)*D);\n        mcf.add(N*i + vs[j], N*(i+1) + us[j], 1, (2*k-1)*D);\n      }\n    }\n  }\n  cout << mcf.run(s, t, K) << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class MinCostFlow {\n        static class Edge {\n            int to;\n            long cap;\n            long cost;\n            int rev;\n            Edge(int to, long cap, long cost, int rev) {\n                this.to = to;\n                this.cap = cap;\n                this.cost = cost;\n                this.rev = rev;\n            }\n        }\n\n        ArrayList<ArrayList<Edge>> G;\n\n        MinCostFlow(int n) {\n            G = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                G.add(new ArrayList<>());\n            }\n        }\n\n        void addEdge(int from, int to, long cap, long cost) {\n            int i = G.get(from).size();\n            int j = G.get(to).size();\n            G.get(from).add(new Edge(to, cap, cost, j));\n            G.get(to).add(new Edge(from, 0, -cost, i));\n        }\n\n        long run(int s, int t, long f) {\n            int N = G.size();\n            long res = 0;\n            final long INF = 1_000_000_000_000_000_000L;\n            int[] prevV = new int[N];\n            int[] prevE = new int[N];\n            while (f > 0) {\n                long[] dist = new long[N];\n                Arrays.fill(dist, INF);\n                boolean[] inQueue = new boolean[N];\n                Queue<Integer> q = new LinkedList<>();\n                dist[s] = 0;\n                q.add(s);\n                inQueue[s] = true;\n                while (!q.isEmpty()) {\n                    int u = q.poll();\n                    inQueue[u] = false;\n                    for (int i = 0; i < G.get(u).size(); i++) {\n                        Edge e = G.get(u).get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                            dist[e.to] = dist[u] + e.cost;\n                            prevV[e.to] = u;\n                            prevE[e.to] = i;\n                            if (!inQueue[e.to]) {\n                                q.add(e.to);\n                                inQueue[e.to] = true;\n                            }\n                        }\n                    }\n                }\n                if (dist[t] == INF) return -1;\n                long d = f;\n                for (int v = t; v != s; v = prevV[v]) {\n                    d = Math.min(d, G.get(prevV[v]).get(prevE[v]).cap);\n                }\n 