o, skip)\n                if m1 == 0 or m2 == 0:\n                    continue\n\n                val = dot / math.sqrt(m1) / math.sqrt(m2)\n                # Clamp to avoid math domain error\n                val = max(-1.0, min(1.0, val))\n                angle_deg = math.degrees(math.acos(val))\n                if angle_deg + 1e-9 < 90.0:\n                    bad[i] = True\n\n    good_count = n - sum(bad)\n    print(good_count)\n    for i in range(n):\n        if not bad[i]:\n            print(i + 1)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-5.960462772236497e-07, 0.0, 0.0, -2.729855441430118e-05, -1.1205610462639015e-05, -0.00026127262390218675, -0.0011732844868674874, -2.3841855067985307e-07, 0.0, -0.0009124883217737079, -0.02975492924451828, -0.011080282740294933, -0.12704479694366455, -9.536738616588991e-07, -0.0005388000281527638, -8.344646857949556e-07, -0.06253250688314438, 0.0, -5.960446742392378e-06, -1.1920928244535389e-07, -0.038042448461055756, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, 0.0, -4.172316494077677e-06, 0.0, 0.0, -2.1457441107486375e-05, 0.0, -1.1920928244535389e-07, -8.344646857949556e-07, -5.960462772236497e-07, -0.03216813504695892, 0.0, 0.0, -1.2993727978027891e-05, -3.576272320060525e-06, -5.960462772236497e-07, -0.00012420836719684303, -5.125986263010418e-06, -3.576278118089249e-07, 0.0, 0.0, -0.0040800669230520725, -0.0019286142196506262, -3.0278701160568744e-05, 0.0, -2.145764938177308e-06, 0.0, -4.768370445162873e-07, -3.099436753473128e-06, 0.0, -0.002572681289166212, -3.373566141817719e-05, 0.0, -6.079655122448457e-06, -0.00015841660206206143, -9.536738616588991e-07, -0.6335209608078003, -1.1920928244535389e-07, -0.062402594834566116, -0.0011736417654901743, -1.1205610462639015e-05, -2.3841855067985307e-07, -0.5759401917457581, -9.63164638960734e-05, -0.01527281291782856, -6.437280717364047e-06, 0.0, 0.0, -0.00014494798961095512, -9.5367386