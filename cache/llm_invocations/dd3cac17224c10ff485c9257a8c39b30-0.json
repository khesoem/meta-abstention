  inq[u] = false;\n                for (int i = 0; i < (int)graph[u].size(); ++i) {\n                    Edge& e = graph[u][i];\n                    if (e.capacity > 0 && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.push(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n            \n            if (dist[sink] == INF) break;\n            \n            int flow = INF;\n            for (int v = sink; v != source; v = prevv[v])\n                flow = min(flow, graph[prevv[v]][preve[v]].capacity);\n            \n            total_flow += flow;\n            total_cost += flow * dist[sink];\n            \n            for (int v = sink; v != source; v = prevv[v]) {\n                Edge& e = graph[prevv[v]][preve[v]];\n                e.capacity -= flow;\n                graph[v][e.rev].capacity += flow;\n            }\n        }\n        return {total_flow, total_cost};\n    }\n};\n\nint node_index(int i, int j) { return i * n + j; }\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n_in, m_in, k_in, c_in, d_in;\n    cin >> n_in >> m_in >> k_in >> c_in >> d_in;\n    n = n_in;\n    \n    int cs = 2 * k_in;\n    int total_nodes = cs * n_in + 2;\n    int src = total_nodes - 2, dst = total_nodes - 1;\n    \n    MinCostMaxFlow mcmf(total_nodes, src, dst);\n    \n    for (int i = 0; i < k_in; ++i) {\n        int tp;\n        cin >> tp;\n        mcmf.connect(src, node_index(0, tp), 1, 0);\n    }\n    \n    vector<pair<int, int>> edge_list(m_in);\n    for (int i = 0; i < m_in; ++i) {\n        cin >> edge_list[i].first >> edge_list[i].second;\n    }\n    \n    for (int layer = 1; layer <= cs - 1; ++layer) {\n        mcmf.connect(node_index(layer, 1), dst, k