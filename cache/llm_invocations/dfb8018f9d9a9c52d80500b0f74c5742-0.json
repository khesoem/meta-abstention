 == 6:\n                t1 = min(ta3, tb2)\n                tb2 -= t1; ta3 -= t1; tmx += t1\n        temp = max(temp, tmx)\n    sys.stdout.write(f\"{n - temp} {mx}\\n\")\n\nif __name__ == '__main__':\n    solve()\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cstring>\n\nusing namespace std;\n\nvoid solve() {\n    // Read all integers from stdin\n    vector<int> data;\n    int x;\n    while (cin >> x) {\n        data.push_back(x);\n    }\n    if (data.empty()) return;\n    int n = data[0];\n    int a1 = data[1], a2 = data[2], a3 = data[3];\n    int b1 = data[4], b2 = data[5], b3 = data[6];\n    \n    int mx = min(a1, b2) + min(a2, b3) + min(a3, b1);\n    int temp = 0;\n    \n    int perm[6] = {1, 2, 3, 4, 5, 6};\n    do {\n        int ta1 = a1, ta2 = a2, ta3 = a3;\n        int tb1 = b1, tb2 = b2, tb3 = b3;\n        int tmx = 0;\n        for (int i = 0; i < 6; ++i) {\n            int el = perm[i];\n            int t1;\n            if (el == 1) {\n                t1 = min(ta1, tb1);\n                ta1 -= t1; tb1 -= t1; tmx += t1;\n            } else if (el == 2) {\n                t1 = min(ta1, tb3);\n                ta1 -= t1; tb3 -= t1; tmx += t1;\n            } else if (el == 3) {\n                t1 = min(ta2, tb2);\n                ta2 -= t1; tb2 -= t1; tmx += t1;\n            } else if (el == 4) {\n                t1 = min(ta2, tb1);\n                tb1 -= t1; ta2 -= t1; tmx += t1;\n            } else if (el == 5) {\n                t1 = min(ta3, tb3);\n                ta3 -= t1; tb3 -= t1; tmx += t1;\n            } else if (el == 6) {\n                t1 = min(ta3, tb2);\n                tb2 -= t1; ta3 -= t1; tmx += t1;\n            }\n        }\n        temp = max(temp, tmx);\n    } while (next_permutation(perm, perm + 6));\n    