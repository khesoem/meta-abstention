ong[] a = new long[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextLong();\n        }\n        int n1 = n / 2;\n        ArrayList<Long> a1 = new ArrayList<>();\n        ArrayList<Long> a2 = new ArrayList<>();\n        sums(0, n1, a, m, a1, 0L);\n        sums(n1, n, a, m, a2, 0L);\n        \n        // Deduplicate and sort a1\n        Collections.sort(a1);\n        ArrayList<Long> a1Dedup = new ArrayList<>();\n        for (long val : a1) {\n            if (a1Dedup.isEmpty() || a1Dedup.get(a1Dedup.size()-1) != val) {\n                a1Dedup.add(val);\n            }\n        }\n        long[] a1Arr = new long[a1Dedup.size()];\n        for (int i = 0; i < a1Dedup.size(); i++) {\n            a1Arr[i] = a1Dedup.get(i);\n        }\n        \n        long ans = 0;\n        for (long i : a2) {\n            long target = m - i;\n            int j = binarySearch(a1Arr, target);\n            // j is first index where a1Arr[j] >= target\n            // Since a1Arr always contains 0, j > 0 for target > 0\n            if (j > 0) {\n                ans = Math.max(ans, a1Arr[j-1] + i);\n            }\n        }\n        System.out.println(ans);\n    }\n    \n    static void sums(int i, int end, long[] a, int m, ArrayList<Long> lst, long cur) {\n        if (i == end) {\n            lst.add(cur);\n        } else {\n            sums(i+1, end, a, m, lst, (cur + a[i]) % m);\n            sums(i+1, end, a, m, lst, cur);\n        }\n    }\n    \n    static int binarySearch(long[] arr, long x) {\n        int lo = 0, hi = arr.length;\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            if (arr[mid] < x) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        return lo;\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.9073468138230965e-06, 0.0, 0.0, -1.168244216387393e-05, -1.2159273865108844e-05, 0.0, -2.7656173188006505e-05, -0.018324723467230797