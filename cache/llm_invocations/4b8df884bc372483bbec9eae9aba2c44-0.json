for (int a = 0; a < 4; a++) {\n            for (int b = a + 1; b < 5; b++) {\n                for (int c = b + 1; c < 6; c++) {\n                    int[] first = {a, b, c};\n                    // remaining three in increasing order\n                    int[] second = new int[3];\n                    int idx = 0;\n                    for (int x = 0; x < 6; x++) {\n                        if (x != a && x != b && x != c) {\n                            second[idx++] = x;\n                        }\n                    }\n                    A.add(first);\n                    B.add(second);\n                }\n            }\n        }\n    }\n\n    static boolean check(int[] perm, int mask) {\n        // All permutations of {0,1,2}\n        int[][] orders = {\n            {0,1,2}, {0,2,1}, {1,0,2}, {1,2,0}, {2,0,1}, {2,1,0}\n        };\n        for (int[] order : orders) {\n            boolean ok = true;\n            for (int j = 0; j < 3; j++) {\n                int pos = perm[order[j]] * 3 + j;\n                if ((mask & (1 << pos)) == 0) {\n                    ok = false;\n                    break;\n                }\n            }\n            if (ok) return true;\n        }\n        return false;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        init();\n\n        int n = sc.nextInt();\n        long[][] p = new long[6][6];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int val = sc.nextInt();\n                p[i][j] = (val * INV) % MOD;\n            }\n        }\n        // Fill missing entries for 6x6\n        for (int i = 0; i < 6; i++) {\n            for (int j = n; j < 6; j++) {\n                if (i == j) {\n                    p[i][j] = 1;\n                } else {\n                    p[i][j] = 0;\n                    p[j][i] = 0;\n                }\n            }\n        }\n\n        int size = 1 << 20;\n        long[] pa = new long[size];\