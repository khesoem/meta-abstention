 [1, 0, -1, 0]\ndy = [0, 1, 0, -1]\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    Sgrid = [list(next(it).strip()) for _ in range(n)]\n    Tgrid = [list(next(it).strip()) for _ in range(n)]\n\n    # find Z in Tgrid\n    zx = zy = -1\n    for i in range(n):\n        for j in range(n):\n            if Tgrid[i][j] == 'Z':\n                zx, zy = i, j\n                break\n        if zx != -1:\n            break\n\n    # BFS from Z\n    distZ = [[-1]*n for _ in range(n)]\n    q = deque()\n    distZ[zx][zy] = 0\n    q.append((zx, zy))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 0 <= nx < n and 0 <= ny < n:\n                if distZ[nx][ny] == -1 and Tgrid[nx][ny] not in ('Y', 'Z'):\n                    distZ[nx][ny] = distZ[x][y] + 1\n                    q.append((nx, ny))\n\n    for i in range(n):\n        for j in range(n):\n            if distZ[i][j] == -1:\n                distZ[i][j] = INF\n\n    starts = []\n    ends = []\n    for i in range(n):\n        for j in range(n):\n            c = Sgrid[i][j]\n            if c not in ('Z', 'Y', '0'):\n                starts.append((i, j))\n    for i in range(n):\n        for j in range(n):\n            c = Tgrid[i][j]\n            if c not in ('Z', 'Y', '0'):\n                ends.append((i, j))\n\n    # dp[t][x0][y0][x][y] = -1 (uncomputed), 0 (false), 1 (true)\n    # allocate as list of lists: dp[t][x0][y0][x][y]\n    dp = [[[[[-1]*n for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(MAXT)]\n\n    def ok(t, x0, y0, x, y):\n        if distZ[x0][y0] < t:\n            return 0\n        if x0 == x and y0 == y:\n            return 1\n        if t >= k:\n            return 0\n        if distZ[x0][y0] <= t:\n            return 0\n        res = dp[t][x0][y0][x][y]\n        if res != -1:\n            return res\n        for d in range(4):\n            nx = x0 + dx[d]\n            ny = y0 + dy[d]\n            if 0 <= nx < n and 0 <= ny < n:\n                if Sgrid[nx][ny] not in ('Y', 'Z'):\n                    if ok(t+1, nx, ny, x, y):\n                        dp[t][x0][y0][x][y] = 1\n                        return 1\n        dp[t][x0][y0][x][y] = 0\n        return 0\n\n    # Dinic\n    class Dinic:\n        def __init__(self, n):\n            self.n = n\n            self.g = [[] for _ in range(n)]\n            self.level = [0]*n\n            self.ptr = [0]*n\n\n        def add_edge(self, v, to, cap):\n            forward = [to, len(self.g[to]), cap]\n            backward = [v, len(self.g[v]), 0]\n            self.g[v].append(forward)\n            self.g[to].append(backward)\n\n        def bfs(self, s, t):\n            self.level = [-1]*self.n\n            q = deque()\n            self.level[s] = 0\n            q.append(s)\n            while q:\n                v = q.popleft()\n                for e in self.g[v]:\n                    if e[2] > 0 and self.level[e[0]] == -1:\n                        self.level[e[0]] = self.level[v] + 1\n                        q.append(e[0])\n            return self.level[t] != -1\n\n        def dfs(self, v, t, pushed):\n            if pushed == 0:\n                return 0\n            if v == t:\n                return pushed\n            while self.ptr[v] < len(self.g[v]):\n                e = self.g[v][self.ptr[v]]\n                if self.level[e[0]] == self.level[v] + 1 and e[2] > 0:\n                    tr = self.dfs(e[0], t, min(pushed, e[2]))\n                    if tr > 0:\n                        e[2] -= tr\n                        self.g[e[0]][e[1]][2] += tr\n                        return tr\n                self.ptr[v] += 1\n            return 0\n\n        def max_flow(self, s, t):\n            flow = 0\n            while self.bfs(s, t):\n                self.ptr = [0]*self.n\n                while True:\n                    pushed = self.dfs(s, t, 10**9)\n                    if pushed == 0:\n                        break\n                    flow += pushed\n            return flow\n\n    S = 0\n    T = len(starts) + len(ends) + 1\n    dinic = Dinic(T+1)\n\n    for i, (x, y) in enumerate(starts):\n        cap = int(Sgrid[x][y])\n        dinic.add_edge(S, i+1, cap)\n\n    for i, (x, y) in enumerate(ends):\n        cap = int(Tgrid[x][y])\n        dinic.add_edge(len(starts)+i+1, T, cap)\n\n    for i, (sx, sy) in enumerate(starts):\n        for j, (ex, ey) in enumerate(ends):\n            if ok(0, sx, sy, ex, ey):\n                dinic.add_edge(i+1, len(starts)+j+1, INF)\n\n    print(dinic.max_flow(S, T))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.748573807475623e-06, -0.005774482619017363, -1.1205610462639015e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.0005594118847511709, -0.0010236029047518969, 0.0, -1.7762025890988298e-05, -0.020581139251589775, -7.867782187531702e-06, 0.0, -7.152555099310121e-07, -0.023332329466938972, -1.096730351448059, -3.2186455882765586e-06, 0.0, -7.152531907195225e-06, -1.2516897186287679e-05, -0.2528899312019348, -0.06305275857448578, -0.09555715322494507, -1.311301275563892e-06, -1.1920928244535389e-07, -3.6000557884108275e-05, -0.481161892414093, -0.038538772612810135, -1.7881377516459906e-06, -0.00012373158824630082, -3.6954811548639555e-06, 0.0, -0.000362807244528085, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -7.152555099310121e-07, -7.867782187531702e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.0728830375228426e-06, 0.0, -1.1920922133867862e-06, 0.0, -1.1920928244535389e-07, -3.2186455882765586e-06, -3.576278118089249e-07, -3.576278118089249e-07, -2.0265558760002023e-06, -1.1920928244535389e-07, -0.0003232433518860489, -0.39713674783706665, -0.4670