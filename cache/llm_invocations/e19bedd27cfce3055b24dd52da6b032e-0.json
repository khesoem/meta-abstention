t i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (g[i][j] == 'Y' || g[i][j] == 'Z') {\n                pl[i][j][0] = g[i][j] - 'X';\n                sc[i][j] = 0;\n            } else {\n                pl[i][j][0] = 0;\n                sc[i][j] = g[i][j] - '0';\n            }\n        }\n\n    for (int i = 0; i < n; ++i) cin >> g[i];\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (g[i][j] == 'Y' || g[i][j] == 'Z') {\n                pl[i][j][0] = g[i][j] - 'X';\n                tc[i][j] = 0;\n            } else {\n                pl[i][j][0] = 0;\n                tc[i][j] = g[i][j] - '0';\n            }\n        }\n\n    for (int tm = 1; tm <= T; ++tm) {\n        for (int i = 0; i < n; ++i)\n            for (int j = 0; j < n; ++j)\n                pl[i][j][tm] = pl[i][j][tm-1];\n\n        for (int i = 0; i < n; ++i)\n            for (int j = 0; j < n; ++j)\n                if (pl[i][j][tm-1] == 2)\n                    for (int k = 0; k < 4; ++k) {\n                        int nr = i + dr[k], nc = j + dc[k];\n                        if (valid(nr,nc) && pl[nr][nc][tm-1] == 0)\n                            pl[nr][nc][tm] = 2;\n                    }\n    }\n\n    memset(sn, -1, sizeof(sn));\n    memset(tn, -1, sizeof(tn));\n    S = 1;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (sc[i][j] != 0) sn[i][j] = S++;\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (tc[i][j] != 0) tn[i][j] = S++;\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (sc[i][j] == 0) continue;\n            queue<pair<int,pair<int,int>>> q;\n            q.push({0,{i,j}});\n            vector<vector<bool>> vis(n, vector<bool>(n, false));\n            vis[i][j] = true;\n            int s = sn[i][j];\n            while (!q.empty()) {\n                auto cur = q.front(); q.pop();\n                int tm = cur.first;\