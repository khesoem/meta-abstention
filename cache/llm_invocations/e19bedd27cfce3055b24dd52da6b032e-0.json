 = [[0]*n for _ in range(n)]\n    sn = [[-1]*n for _ in range(n)]\n    tn = [[-1]*n for _ in range(n)]\n    pl = [[[0]*(T+1) for _ in range(n)] for _ in range(n)]\n\n    for i in range(n):\n        for j in range(n):\n            ch = g[i][j]\n            if ch == 'Y' or ch == 'Z':\n                pl[i][j][0] = ord(ch) - ord('X')\n                sc[i][j] = 0\n            else:\n                pl[i][j][0] = 0\n                sc[i][j] = int(ch)\n\n    g2 = [list(next(it).strip()) for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            ch = g2[i][j]\n            if ch == 'Y' or ch == 'Z':\n                pl[i][j][0] = ord(ch) - ord('X')\n                tc[i][j] = 0\n            else:\n                pl[i][j][0] = 0\n                tc[i][j] = int(ch)\n\n    # propagate pl over time\n    dr = [0, 0, -1, 1]\n    dc = [-1, 1, 0, 0]\n    for tm in range(1, T+1):\n        for i in range(n):\n            for j in range(n):\n                pl[i][j][tm] = pl[i][j][tm-1]\n        for i in range(n):\n            for j in range(n):\n                if pl[i][j][tm-1] == 2:\n                    for k in range(4):\n                        nr, nc = i + dr[k], j + dc[k]\n                        if valid(nr, nc, n) and pl[nr][nc][tm-1] == 0:\n                            pl[nr][nc][tm] = 2\n\n    # assign node indices\n    S = 1\n    for i in range(n):\n        for j in range(n):\n            if sc[i][j] != 0:\n                sn[i][j] = S\n                S += 1\n    for i in range(n):\n        for j in range(n):\n            if tc[i][j] != 0:\n                tn[i][j] = S\n                S += 1\n\n    # initialize flow network\n    f = [[0]*(S+1) for _ in range(S+1)]\n    for i in range(n):\n        for j in range(n):\n            if sc[i][j] == 0:\n                continue\n            q = deque()\n            q.append((0, i, j))\n            vis = [[False]*n for _ in range(n)]\n            vis[i][j] = True\n            s_node = sn[i][j]\n            while q:\n                tm, r, c = q.popleft()\n                if tc[r][c] != 0:\n                    f[s_node][tn[r][c]] = 10000\n                if tm == T:\n                    continue\n                if pl[r][c][tm] != 0:\n                    continue\n                for k in range(4):\n                    nr, nc = r + dr[k], c + dc[k]\n                    if valid(nr, nc, n) and pl[nr][nc][tm] == 0 and not vis[nr][nc]:\n                        vis[nr][nc] = True\n                        q.append((tm+1, nr, nc))\n\n    # source/sink edges\n    for i in range(n):\n        for j in range(n):\n            if sc[i][j] != 0:\n                f[0][sn[i][j]] = sc[i][j]\n            if tc[i][j] != 0:\n                f[tn[i][j]][S] = tc[i][j]\n\n    ans = 0\n    add = edmondsKarp(S, f)\n    while add != 0:\n        ans += add\n        add = edmondsKarp(S, f)\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.344647e-07, 0.0, -1.1920928e-07, -0.00057930854, -0.21618073, -0.00056227134, -0.0007528808, -6.472855e-05, -0.0003449322, -1.1920928e-07, -7.295342e-05, -0.002438312, -0.41334975, -0.55878305, -6.258292e-05, -0.00025567124, -2.0265559e-06, -0.004079948, -4.76836e-06, -2.0861407e-05, -2.384183e-06, -1.1920928e-07, -1.1920928e-07, 0.0, 0.0, 0.0, -3.552374e-05, 0.0, 0.0, -1.1920928e-07, 0.0, -2.3841855e-07, 0.0, -2.622601e-06, -3.81469e-06, -1.2993728e-05, -0.0023630334, -0.00041666886, 0.0, -1.3351351e-05, -0.160244, 0.0, -3.0559373, -0.0040823226, -0.005659035, -0.0026259485, -1.1920928e-07, -0.032614656, 0.0, -5.0067774e-06, 0.0, -1.7046783e-05, -0.00033551786, -1.1920928e-07, -4.7683704e-07, -0.018150195, 0.0, -3.0159496e-05, -4.410734e-06, 0.0, -0.0002641329, -1.1920928e-07, -7.152555e-07, -2.3841855e-07, 0.0, -5.0067774e-06, -2.622601e-06, -5.1259863e-06, 0.0, -3.933899e-06, -1.1920928e-07, -2.384183e-06, -0.9740779, -2.3841855e-07, -2.002696e-05, -0.000123374, -6