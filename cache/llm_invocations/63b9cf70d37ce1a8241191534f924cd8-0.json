n        }\n    }\n    return 0;\n}\n\nint maximumFlow(vector<vector<Edge>>& G, int s, int t) {\n    int flow = 0;\n    level.resize(G.size());\n    iter.resize(G.size());\n    while(true) {\n        bfs(s, G);\n        if(level[t] < 0) return flow;\n        fill(iter.begin(), iter.end(), 0);\n        int f;\n        while((f = dfs(s, t, 1e9, G)) > 0) flow += f;\n    }\n}\n\nconst int dy[]={-1,0,1,0}, dx[]={0,-1,0,1};\nint n,t,xx,yy,lim[10][10];\nstring person[10],capsul[10];\n\nint dist[10][10];\nbool canReach(int sy,int sx,int gy,int gx){\n    rep(i,n)rep(j,n)dist[i][j]=1000;\n    dist[sy][sx]=0;\n    queue<pi> q; q.push(mp(sy,sx));\n    while(!q.empty()){\n        int y=q.front().first, x=q.front().second; q.pop();\n        if(y==gy&&x==gx)return dist[y][x] <= t;\n        rep(d,4){\n            int ny=y+dy[d], nx=x+dx[d];\n            if(ny<0||nx<0||ny>=n||nx>=n)continue;\n            if(person[ny][nx]=='Y')continue; // reactor is impassable\n            if(dist[ny][nx] != 1000)continue;\n            if(dist[y][x] + 1 >= lim[ny][nx])continue; // will be infected before arrival\n            dist[ny][nx] = dist[y][x] + 1;\n            q.push(mp(ny,nx));\n        }\n    }\n    return false;\n}\n\nvoid run()\n{\n    cin>>n>>t;\n    rep(i,n)cin>>person[i];\n    rep(i,n)cin>>capsul[i];\n    \n    vi px,py,cx,cy;\n    rep(i,n)rep(j,n){\n        if('0'<person[i][j]&&person[i][j]<='9')py.pb(i), px.pb(j);\n        if('0'<capsul[i][j]&&capsul[i][j]<='9')cy.pb(i), cx.pb(j);\n        if(person[i][j]=='Z')yy=i, xx=j;\n        lim[i][j]=1000;\n    }\n    \n    // BFS from reactor to compute infection times\n    lim[yy][xx]=0;\n    queue<pi> q; q.push(mp(yy,xx));\n    while(!q.empty()){\n        int y=q.front().first, x=q.front().second; q.pop();\n        rep(d,4){\n            int ny=y+dy[d], nx=x+dx[d];\n            if(ny<0||nx<0||ny>=n||nx>=n)continue;\n            if(person[ny][nx]=='Y')continue; // reactor is impassable\n            if(lim[ny][nx] != 1000)continue;\n            lim[ny][nx] = lim[y][x] + 1;\n            q.push(mp(ny,nx));\n        }\n    }\n    \n    int m = px.size() + cx.size() + 2;\n    g.assign(m, vector<Edge>());\n    int source = m-2, sink = m-1;\n    \n    // Connect source to scientists\n    rep(i,px.size()) {\n        int cap = person[py[i]][px[i]] - '0';\n        addEdge(g, source, i, cap);\n    }\n    \n    // Connect labs to sink\n    rep(i,cx.size()) {\n        int cap = capsul[cy[i]][cx[i]] - '0';\n        addEdge(g, i+px.size(), sink, cap);\n    }\n    \n    // Connect scientists to labs if reachable\n    rep(i,px.size())rep(j,cx.size()) {\n        if(canReach(py[i],px[i],cy[j],cx[j])) {\n            addEdge(g, i, j+px.size(), 1000);\n        }\n    }\n    \n    cout<<maximumFlow(g, source, sink)<<endl;\n}\n\nint main() {\n    run();\n    return 0;\n}\n</repaired_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.536738616588991e-07, -3.2782016205601394e-05, -2.50339189733495e-06, -3.576278118089249e-07, -0.00017808281700126827, -2.3841855067985307e-07, -5.9126061387360096e-05, -1.3232143828645349e-05, -5.722029527532868e-06, -2.9802276912960224e-06, -2.0265558760002023e-06, -3.564294092939235e-05, -8.583032467868179e-06, -5.125986263010418e-06, -0.17974753677845, -6.639736966462806e-05, -5.960446742392378e-06, -1.1920928244535389e-07, -0.0004357342259027064, 0.0, -0.005030830856412649, -5.722029527532868e-06, -1.645074735279195e-05, -5.602820692729438e-06, -1.5497195136049413e-06, -4.768370445162873e-07, -3.218599158572033e-05, -1.680836794548668e-05, -1.5139465176616795e-05, -1.0490362910786644e-05, -9.536738616588991e-07, -8.106198947643861e-06, -7.152555099310121e-07, -1.311301275563892e-06, -1.1920922133867862e-06, -5.960462772236497e-07, -9.536738616588991e-07, -1.1920928244535389e-07, -4.768360213347478e-06, -3.1470757676288486e-05, -1.0609570381348021e-05, -4.410734163684538e-06, -1.2874520507466514e-05, -8.344646857949556e-07, -6.318072337307967e-06, -1.1920922133867862e-06, -0.000