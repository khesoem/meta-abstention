t uninitialized use\n\n        if (n > y) {\n            int gc = gcd((int) x, (int) y);\n            if (gc != 1) {\n                x = x / gc;\n                y = y / gc;\n            }\n            System.out.println((int) x + \"/\" + (int) y);\n            sc.close();\n            return;\n        }\n\n        for (double b = n; b >= 1; b--) {\n            double a = (x * b) / y;\n            if (Math.floor(a) == a) {\n                mina = (int) a;\n                minb = (int) b;\n                break;\n            } else {\n                double[] tempNumDen = new double[2];\n                diff(x, y, Math.floor(a), b, tempNumDen);\n                double temp = tempNumDen[0] / tempNumDen[1];\n\n                if (temp < min) {\n                    mina = (int) Math.floor(a);\n                    minb = (int) b;\n                    min = temp;\n                } else if (temp == min) {\n                    if (Math.floor(a) < mina) {\n                        mina = (int) Math.floor(a);\n                        minb = (int) b;\n                    }\n                }\n\n                diff(x, y, Math.ceil(a), b, tempNumDen);\n                temp = tempNumDen[0] / tempNumDen[1];\n\n                if (temp < min) {\n                    mina = (int) Math.ceil(a);\n                    minb = (int) b;\n                    min = temp;\n                } else if (temp == min) {\n                    if (Math.ceil(a) < mina) {\n                        mina = (int) Math.ceil(a);\n                        minb = (int) b;\n                    }\n                }\n            }\n        }\n\n        int gc = gcd(mina, minb);\n        if (gc != 1) {\n            mina = mina / gc;\n            minb = minb / gc;\n        }\n\n        System.out.println(mina + \"/\" + minb);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-1.227746605873108, -0.0007321976590901613, -2.696889623621246e-06, -0.0001556241913931