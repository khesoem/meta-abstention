:\n            if (state & bitu128(mask)) != 0:\n                for i in range(n):\n                    pred_hall[i] |= bitu128(mask | bit(i))\n        for mask in range(N):\n            nxt = state\n            for i in range(n):\n                if mask & bit(i):\n                    nxt |= pred_hall[i]\n            nxttt[mask][k] = get_ind(nxt)\n        # compute match[k]\n        for i in range(n, -1, -1):\n            if (state & fixed_size[i]) != 0:\n                match[k] = i\n                break\n\ndef expectedMaximumMatching(n, m):\n    global len_states, nxttt, match\n    N = bit(n)\n    prv = [0] * len_states\n    prv[0] = 1\n    for j in range(m):\n        cur = [0] * len_states\n        for mask in range(N):\n            prob = 1\n            for i in range(n):\n                if mask & bit(i):\n                    prob = prob * p[i][j] % mod\n                else:\n                    prob = prob * (mod + 1 - p[i][j]) % mod\n            for k in range(len_states):\n                cur[nxttt[mask][k]] = (cur[nxttt[mask][k]] + prob * prv[k]) % mod\n        prv = cur\n    ans = 0\n    for k in range(len_states):\n        if match[k] == n:\n            ans = (ans + prv[k]) % mod\n    return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = n\n    precalc(n)\n    global p\n    p = [[0] * m for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            val = int(next(it))\n            p[i][j] = val * powmod(100, mod - 2) % mod\n    ans = expectedMaximumMatching(n, m)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.585470999998506e-05, 0.0, 0.0, -0.0009209443815052509, -0.0009632238652557135, 0.0, -0.0009130837861448526, -0.16027306020259857, -1.1920928244535389e-07, -2.3841855067985307e-07, -4.625213477993384e-05, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -0.12693004310131