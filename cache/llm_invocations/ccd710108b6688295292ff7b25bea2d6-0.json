{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstring>\n#include <cstdio>\nusing namespace std;\n\nconst int MAXN = 300005;\nint MOD = 1000000007;\n\ninline int mod_add(int a, int b) { return (a += b) >= MOD ? a - MOD : a; }\ninline int mod_mul(int a, int b) { return (long long)a * b % MOD; }\ninline int mod_sub(int a, int b) { return (a -= b) < 0 ? a + MOD : a; }\n\nint power(int x, int y) {\n    int res = 1;\n    while (y) {\n        if (y & 1) res = mod_mul(res, x);\n        x = mod_mul(x, x);\n        y >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cout.tie(0);\n\n    int n, k, mod_val;\n    cin >> n >> k >> mod_val;\n    MOD = mod_val;\n\n    vector<int> fac(n + 1), ifac(n + 1);\n    fac[0] = 1;\n    for (int i = 1; i <= n; ++i) fac[i] = mod_mul(fac[i - 1], i);\n    for (int i = 0; i <= n; ++i) ifac[i] = power(fac[i], MOD - 2);\n\n    auto C = [&](int x, int y) -> int {\n        if (y < 0 || y > x) return 0;\n        return mod_mul(fac[x], mod_mul(ifac[x - y], ifac[y]));\n    };\n\n    if (n & 1) {\n        cout << power(k, n) << '\\n';\n        return 0;\n    }\n\n    vector<int> dp_prev(n + 1, 0), dp_cur(n + 1, 0);\n    dp_prev[n] = 1;\n    int ans = 0;\n\n    for (int i = 1; i <= k; ++i) {\n        fill(dp_cur.begin(), dp_cur.end(), 0);\n        int res = 0;\n        for (int j = 1; j <= n; ++j) {\n            int tmp = dp_prev[j];\n            if (!tmp) continue;\n            int u = j ^ (j & -j);\n            for (int sub = u; sub; sub = (sub - 1) & u)\n                dp_cur[sub] = mod_add(dp_cur[sub], mod_mul(tmp, C(j, sub)));\n            res = mod_add(res, tmp);\n        }\n        ans = mod_add(ans, mod_mul(res, ifac[k - i]));\n        swap(dp_prev, dp_cur);\n    }\n\n    ans = mod_mul(ans, fac[k]);\n    ans = mod_sub(power(k, n), ans);\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef mod_add(a, b):\n    return (a + b) % MOD\n\ndef mod_mul(a, b):\n    return (a * b) % MOD\n\ndef mod_sub(a, b):\n    return (a - b) % MOD\n\ndef power(x, y):\n    return pow(x, y, MOD)\n\ndef main():\n    global MOD\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, mod_val = map(int, data[:3])\n    MOD = mod_val\n\n    fac = [0] * (n + 1)\n    ifac = [0] * (n + 1)\n    fac[0] = 1\n    for i in range(1, n + 1):\n        fac[i] = mod_mul(fac[i - 1], i)\n    for i in range(n + 1):\n        ifac[i] = power(fac[i], MOD - 2)\n\n    def C(x, y):\n        if y < 0 or y > x:\n            return 0\n        return mod_mul(fac[x], mod_mul(ifac[x - y], ifac[y]))\n\n    if n & 1:\n        print(power(k, n))\n        return\n\n    dp_prev = [0] * (n + 1)\n    dp_cur = [0] * (n + 1)\n    dp_prev[n] = 1\n    ans = 0\n\n    for i in range(1, k + 1):\n        dp_cur = [0] * (n + 1)\n        res = 0\n        for j in range(1, n + 1):\n            tmp = dp_prev[j]\n            if not tmp:\n                continue\n            u = j ^ (j & -j)\n            sub = u\n            while sub:\n                dp_cur[sub] = mod_add(dp_cur[sub], mod_mul(tmp, C(j, sub)))\n                sub = (sub - 1) & u\n            res = mod_add(res, tmp)\n        ans = mod_add(ans, mod_mul(res, ifac[k - i]))\n        dp_prev, dp_cur = dp_cur, dp_prev\n\n    ans = mod_mul(ans, fac[k])\n    ans = mod_sub(power(k, n), ans)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.680836794548668e-05, 0.0, 0.0, -0.0004419303731992841, -0.0016817011637613177, 0.0, -0.0019328974885866046, -0.3871172070503235, -9.595887240720913e-05, -0.0019527667900547385, -0.42013856768608093, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.3874816298484802, -8.606540359323844e-05, -0.003921558149158955, -0.0009882333688437939, -1.1920928244535389e-07, -0.00020680672605521977, 0.0, -0.00916382111608982, -1.4305104514278355e-06, -0.19608472287654877, -4.160317621426657e-05, -1.5497195136049413e-06, -3.4570634852570947e-06, -2.3841855067985307e-07, 0.0, -7.557583012385294e-05, -1.1920928244535389e-07, -0.0010561132803559303, -2.3841855067985307e-07, 0.0, -0.0024756519123911858, 0.0, 0.0, 0.0, 0.0, -2.861018856492592e-06, 0.0, -1.1920928244535389e-07, -3.540453326422721e-05, 0.0, -4.768370445162873e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -4.541770613286644e-05, -2.861018856492592e-06, 0.0, -3.576278118089249e-07, 0.0, -2.50339189733495e-06, 0.0, -8.22540732769994e-06, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, 0.0, -0.0019286142196506262, -1.1920928244535389e-07, 0.0, -7.533743337262422e-05, -2.3007127310847864e-05, -0.0008355463505722582, -0.0002053765201708302, -3.576278118089249e-07, 0.0, -5.4834770708112046e-05, 0.0, -0.0026897939387708902, -1.1920928244535389e-07, -2.861018856492592e-06, -1.14440