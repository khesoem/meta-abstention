xtLong(self):\n        return int(self.next())\n\ndef binomialCoeff(n, r):\n    if r > n:\n        return 0\n    m = 1000000007\n    inv = [0] * (int(r) + 1)\n    inv[0] = 1\n    if r + 1 >= 2:\n        inv[1] = 1\n    for i in range(2, int(r) + 1):\n        inv[i] = m - (m // i) * inv[int(m % i)] % m\n    ans = 1\n    for i in range(2, int(r) + 1):\n        ans = ans * inv[i] % m\n    for i in range(int(n), int(n - r), -1):\n        ans = ans * (i % m) % m\n    return ans\n\ndef gcd(a, b):\n    return a if b == 0 else gcd(b, a % b)\n\ndef mul(a, b):\n    mod = 1000000007\n    return (a * b) % mod\n\ndef add(a, b):\n    mod = 1000000007\n    return (a + b) % mod\n\ndef bi(str_val):\n    import decimal\n    return decimal.Decimal(str_val)\n\ndef can(v, s):\n    ss = str(v)\n    king_me = '?'\n    for i in range(len(ss)):\n        sc = s[i]\n        vc = ss[i]\n        if sc != '_' and sc != 'X':\n            if sc != vc:\n                return False\n        elif sc == '_':\n            continue\n        elif sc == 'X':\n            if king_me != '?' and vc != king_me:\n                return False\n            elif king_me == '?':\n                king_me = vc\n    return True\n\ndef main():\n    scanner = FastScanner()\n    \n    t = 1\n    for _ in range(t):\n        s = scanner.next()\n        length = len(s)\n        max_val = int(math.pow(10, length)) - 1\n        min_val = int(math.pow(10, length - 1))\n        if min_val == 1:\n            min_val -= 1\n        if s[0] == '0' and len(s) > 1:\n            print(0)\n            continue\n        ans = 0\n        for i in range(min_val, max_val + 1):\n            if i % 25 == 0 and can(i, s):\n                ans += 1\n        print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-5.793403761344962e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -2.3483953555114567e-05, -0.043104276061058044, -9.298280929215252e-06, -0.6931610107