\t\t\te[i ^ 1].f -= minf;\n\t\t\t\t\treturn minf;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn 0;\n\t}\n\npublic:\n\tvoid init(int n, int src, int dst) {\n\t\tthis->n = n;\n\t\tthis->src = src;\n\t\tthis->dst = dst;\n\t\tm = 0;\n\t\tmemset(head, -1, sizeof(int) * n);\n\t}\n\n\tvoid addEdge(int u, int v, int c) {\n\t\te[m] = edge(u, v, 0, c, head[u]);\n\t\thead[u] = m++;\n\t\te[m] = edge(v, u, 0, 0, head[v]);\n\t\thead[v] = m++;\n\t}\n\n\tint maxFlow() {\n\t\tint ret = 0, delta;\n\t\twhile(_bfs()) {\n\t\t\tmemcpy(work, head, sizeof(int) * n);\n\t\t\twhile(true) {\n\t\t\t\tdelta = _dfs(src, INF);\n\t\t\t\tif(delta == 0)\n\t\t\t\t\tbreak;\n\t\t\t\tret += delta;\n\t\t\t}\n\t\t}\n\t\treturn ret;\n\t}\n} dinic;\n\n#define MAX 12\nint n, t, zx, zy;\nchar smp[MAX][MAX], cmp[MAX][MAX], work[MAX][MAX];\nint vis[MAX][MAX];\nint dx[4] = {1, 0, -1, 0};\nint dy[4] = {0, -1, 0, 1};\n\ninline int X(int i, int j) { return i * n + j; }\ninline int Y(int i, int j) { return n * n + i * n + j; }\ninline int S() { return n * n * 2; }\ninline int T() { return S() + 1; }\ninline int N() { return T() + 1; }\n\nstruct qNode {\n\tint x, y, t, type;\n\tqNode() {}\n\tqNode(int x, int y, int t, int type): x(x), y(y), t(t), type(type) {}\n};\n\nvoid bfs(int sx, int sy) {\n\tqNode q[600];\n\tint le = 0, ri = 0;\n\tvis[sx][sy] = 1;\n\tq[ri++] = qNode(sx, sy, 0, 0);\n\tq[ri++] = qNode(zx, zy, 0, 1);\n\twhile(le < ri) {\n\t\tqNode u = q[le++];\n\t\tint nx, ny;\n\t\tif(u.t == t)\n\t\t\tbreak;\n\t\tif(u.type == 0 && isalpha(work[u.x][u.y]))\n\t\t\tcontinue;\n\t\tfor(int i = 0; i < 4; ++i) {\n\t\t\tnx = u.x + dx[i];\n\t\t\tny = u.y + dy[i];\n\t\t\tif(nx >= 0 && nx < n && ny >= 0 && ny < n) {\n\t\t\t\tif(u.type == 0 && !vis[nx][ny] && !isalpha(work[nx][ny])) {\n\t\t\t\t\tvis[nx][ny] = 1;\n\t\t\t\t\tq[ri++] = qNode(nx, ny, u.t + 1, 0);\n\t\t\t\t}\n\t\t\t\telse if(u.type == 1 && !isalpha(work[nx][ny])) {\n\t\t\t\t\twork[nx][ny] = 'Z';\n\t\t\t\t\tq[ri++] = qNode(nx, ny, u.t + 1, 1);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\nint main() {\n\twhile(scanf(\"%d%d\", &n, &t) != EOF) {\n\t\tdinic.init(N(), S(), T());\n\t\tfor(int i = 0; i < n; ++i) {\n\t\t\tscanf(\"%s\", smp[i]);\n\t\t\tfor(int j = 0; j < n; ++j)\n\t\t\t\tif(isdigit(smp[i][j]) && smp[i][j] > '0')\n\t\t\t\t\tdinic.addEdge(S(), X(i, j), smp[i][j] - '0');\n\t\t\t\telse if(smp[i][j] == 'Z') {\n\t\t\t\t\tzx = i;\n\t\t\t\t\tzy = j;\n\t\t\t\t}\n\t\t}\n\t\tfor(int i = 0; i < n; ++i) {\n\t\t\tscanf(\"%s\", cmp[i]);\n\t\t\tfor(int j = 0; j < n; ++j)\n\t\t\t\tif(isdigit(cmp[i][j]) && cmp[i][j] > '0')\n\t\t\t\t\tdinic.addEdge(Y(i, j), T(), cmp[i][j] - '0');\n\t\t}\n\t\tfor(int i = 0; i < n; ++i)\n\t\t\tfor(int j = 0; j < n; ++j) {\n\t\t\t\tif(!isdigit(smp[i][j]) || smp[i][j] <= '0')\n\t\t\t\t\tcontinue;\n\t\t\t\tmemset(vis, 0, sizeof(vis));\n\t\t\t\tmemcpy(work, smp, sizeof(smp));\n\t\t\t\tbfs(i, j);\n\t\t\t\tfor(int xi = 0; xi < n; ++xi)\n\t\t\t\t\tfor(int yi = 0; yi < n; ++yi) {\n\t\t\t\t\t\tif(!isdigit(cmp[xi][yi]) || cmp[xi][yi] <= '0')\n\t\t\t\t\t\t\tcontinue;\n\t\t\t\t\t\tif(vis[xi][yi])\n\t\t\t\t\t\t\tdinic.addEdge(X(i, j), Y(xi, yi), INF);\n\t\t\t\t\t}\n\t\t\t}\n\t\tprintf(\"%d\\n\", dinic.maxFlow());\n\t}\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Dinic:\n    def __init__(self, n):\n        self.n = n\n        self.graph = [[] for _ in range(n)]\n\n    def add_edge(self, u, v, cap):\n        # forward edge\n        self.graph[u].append([v, cap, len(self.graph[v])])\n        # reverse edge\n        self.graph[v].append([u, 0, len(self.graph[u]) - 1])\n\n    def bfs(self, s, t):\n        level = [-1] * self.n\n        q = deque([s])\n        level[s] = 0\n        while q:\n            u = q.popleft()\n            for v, cap, rev in self.graph[u]:\n                if cap > 0 and level[v] == -1:\n                    level[v] = level[u] + 1\n                    q.append(v)\n        self.level = level\n        return level[t] != -1\n\n    def dfs(self, u, t, f):\n        if u == t:\n            return f\n        for i in range(self.it[u], len(self.graph[u])):\n            self.it[u] = i\n            v, cap, rev = self.graph[u][i]\n            if cap > 0 and self.level[u] + 1 == self.level[v]:\n                ret = self.dfs(v, t, min(f, cap))\n                if ret > 0:\n                    # update forward edge\n                    self.graph[u][i][1] -= ret\n                    # update reverse edge\n                    self.graph[v][rev][1] += ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    out_lines = []\n    while True:\n        try:\n            n = int(next(it))\n            t = int(next(it))\n        except StopIteration:\n            break\n        smp = []\n        for _ in range(n):\n            line = next(it)\n            smp.append(list(line))\n        cmp_grid = []\n        for _ in range(n):\n            line = next(it)\n            cmp_grid.append(list(line))\n\n        # find zombie position\n        zx = zy = -1\n        for i in range(n):\n            for j in range(n):\n                if smp[i][j] == 'Z':\n                    zx, zy = i, j\n                    break\n            if zx != -1:\n                break\n\n        # node indices\n        def X(i, j):\n            return i * n + j\n        def Y(i, j):\n            return n * n + i * n + j\n        S = n * n * 2\n        T = S + 1\n        N = T + 1\n\n        dinic = Dinic(N)\n\n        # source to source cells\n        for i in range(n):\n            for j in range(n):\n                if smp[i][j].isdigit() and smp[i][j] > '0':\n                    cap = ord(smp[i][j]) - ord('0')\n                    dinic.add_edge(S, X(i, j), cap)\n\n        # sink cells to sink\n        for i in range(n):\n            for j in range(n):\n                if cmp_grid[i][j].isdigit() and cmp_grid[i][j] > '0':\n                    cap = ord(cmp_grid[i][j]) - ord('0')\n                    dinic.add_edge(Y(i, j), T, cap)\n\n        # directions\n        dx = [1, 0, -1, 0]\n        dy = [0, -1, 0, 1]\n\n        # for each source cell, run BFS\n        for i in range(n):\n            for j in range(n):\n                if not (smp[i][j].isdigit() and smp[i][j] > '0'):\n                    continue\n                # copy smp to work\n                work = [row[:] for row in smp]\n                vis = [[0]*n for _ in range(n)]\n                q = deque()\n                # source start\n                vis[i][j] = 1\n                q.append((i, j, 0, 0))  # (x, y, time, type)\n                # zombie start\n                q.append((zx, zy, 0, 1))\n                while q:\n                    x, y, time, typ = q.popleft()\n                    if time == t:\n                        continue\n                    if typ == 0 and work[x][y].isalpha():\n                        continue\n                    for d in range(4):\n                        nx = x + dx[d]\n                        ny = y + dy[d]\n                        if 0 <= nx < n and 0 <= ny < n:\n                            if typ == 0:\n                                if not vis[nx][ny] and not work[nx][ny].isalpha():\n                                    vis[nx][ny] = 1\n                                    q.append((nx, ny, time+1, 0))\n                            else:  # typ == 1\n                                if not work[nx][ny].isalpha():\n                                    work[nx][ny] = 'Z'\n                                    q.append((nx, ny,