]] = e;\n                if (!in_queue[to[e]]) {\n                    in_queue[to[e]] = 1;\n                    q.push(to[e]);\n                }\n            }\n        }\n    }\n    return dist[T] < 0x3f3f3f3f;\n}\n\nint min_cost_max_flow() {\n    int total_cost = 0;\n    while (spfa()) {\n        int flow = 1e9;\n        for (int v = T; v != S; v = prevv[v]) {\n            flow = min(flow, cap[preve[v]]);\n        }\n        total_cost += flow * dist[T];\n        for (int v = T; v != S; v = prevv[v]) {\n            cap[preve[v]] -= flow;\n            cap[preve[v] ^ 1] += flow;\n        }\n    }\n    return total_cost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    cin >> n >> m >> k >> c >> d;\n    S = 0; T = 1;\n    memset(head, 0, sizeof(head));\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        add_edge(S, x + 1, 1, 0);\n    }\n    \n    for (int i = 1; i <= m; ++i) {\n        cin >> X[i] >> Y[i];\n    }\n    \n    for (int i = 0; i <= n + k; ++i) {\n        add_edge(2 + i * (n + 1), T, k, 0);\n        if (i == n + k) break;\n        for (int j = 1; j <= m; ++j) {\n            for (int l = k; l >= 0; --l) {\n                int w = (l * 2 + 1) * d + c;\n                add_edge(X[j] + 1 + i * (n + 1), Y[j] + 1 + i * (n + 1) + n, 1, w);\n                add_edge(Y[j] + 1 + i * (n + 1), X[j] + 1 + i * (n + 1) + n, 1, w);\n            }\n        }\n        for (int j = 1; j <= n; ++j) {\n            add_edge(j + 1 + i * (n + 1), j + 1 + i * (n + 1) + n, k, c);\n        }\n    }\n    \n    cout << min_cost_max_flow() << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx +