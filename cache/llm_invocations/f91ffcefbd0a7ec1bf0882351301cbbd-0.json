{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 10000;\nconst int MAX_EDGES = 2000000;\nconst int INF = 0x3f3f3f3f;\n\nint n, m, k, c, d;\n\nstruct Edge {\n    int to, cap, flow, cost, next;\n} edges[MAX_EDGES];\n\nint head[MAX_NODES], edgeCount;\nint dist[MAX_NODES], prevEdge[MAX_NODES];\nbool inQueue[MAX_NODES];\nint nodeCount;\n\nvoid initialize(int totalNodes) {\n    nodeCount = totalNodes;\n    edgeCount = 0;\n    memset(head, -1, sizeof(head));\n}\n\nvoid addEdge(int u, int v, int capacity, int cost) {\n    edges[edgeCount] = {v, capacity, 0, cost, head[u]};\n    head[u] = edgeCount++;\n    \n    edges[edgeCount] = {u, 0, 0, -cost, head[v]};\n    head[v] = edgeCount++;\n}\n\nbool findShortestPath(int source, int sink) {\n    fill(dist, dist + nodeCount, INF);\n    fill(inQueue, inQueue + nodeCount, false);\n    fill(prevEdge, prevEdge + nodeCount, -1);\n    \n    queue<int> q;\n    dist[source] = 0;\n    inQueue[source] = true;\n    q.push(source);\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inQueue[u] = false;\n        \n        for (int i = head[u]; i != -1; i = edges[i].next) {\n            int v = edges[i].to;\n            if (edges[i].cap > edges[i].flow && dist[v] > dist[u] + edges[i].cost) {\n                dist[v] = dist[u] + edges[i].cost;\n                prevEdge[v] = i;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    return prevEdge[sink] != -1;\n}\n\npair<int, int> minCostMaxFlow(int source, int sink) {\n    int totalFlow = 0, totalCost = 0;\n    \n    while (findShortestPath(source, sink)) {\n        int bottleneck = INF;\n        for (int i = prevEdge[sink]; i != -1; i = prevEdge[edges[i ^ 1].to]) {\n            bottleneck = min(bottleneck, edges[i].cap - edges[i].flow);\n        }\n        \n        for (int i = prevEdge[sink]; i != -1; i = prevEdge[edges[i ^ 1].to]) {\n            edges[i].flow += bottleneck;\n            edges[i ^ 1].flow -= bottleneck;\n            totalCost += edges[i].cost * bottleneck;\n        }\n        \n        totalFlow += bottleneck;\n    }\n    \n    return {totalFlow, totalCost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> k >> c >> d;\n    initialize(MAX_NODES);\n    \n    for (int i = 0; i < k; i++) {\n        int x; cin >> x;\n        addEdge(0, x, 1, 0);\n    }\n    \n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j < k; j++) {\n            addEdge(1 + i * n, 9999, 1, i * c);\n        }\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v; cin >> u >> v;\n        for (int j = 1; j < 100; j++) {\n            for (int gg = 1; gg <= k; gg++) {\n                addEdge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                addEdge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n            }\n        }\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j < 100; j++) {\n            addEdge(i + (j - 1) * n, i + j * n, k, 0);\n        }\n    }\n    \n    auto result = minCostMaxFlow(0, 9999);\n    cout << result.second << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAX_NODES = 10000\nMAX_EDGES = 2000000\nINF = 0x3f3f3f3f\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'flow', 'cost', 'next')\n    def __init__(self, to, cap, flow, cost, next):\n        self.to = to\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n        self.next = next\n\nedges = [None] * MAX_EDGES\nhead = [-1] * MAX_NODES\nedgeCount = 0\ndist = [INF] * MAX_NODES\nprevEdge = [-1] * MAX_NODES\ninQueue = [False] * MAX_NODES\nnodeCount = 0\n\ndef initialize(totalNodes):\n    global nodeCount, edgeCount, head, edges, dist, prevEdge, inQueue\n    nodeCount = totalNodes\n    edgeCount = 0\n    head = [-1] * MAX_NODES\n    edges = [None] * MAX_EDGES\n    dist = [INF] * MAX_NODES\n    prevEdge = [-1] * MAX_NODES\n    inQueue = [False] * MAX_NODES\n\ndef addEdge(u, v, capacity, cost):\n    global edgeCount\n    edges[edgeCount] = Edge(v, capacity, 0, cost, head[u])\n    head[u] = edgeCount\n    edgeCount += 1\n    \n    edges[edgeCount] = Edge(u, 0, 0, -cost, head[v])\n    head[v] = edgeCount\n    edgeCount += 1\n\ndef findShortestPath(source, sink):\n    global dist, inQueue, prevEdge\n    dist = [INF] * MAX_NODES\n    inQueue = [False] * MAX_NODES\n    prevEdge = [-1] * MAX_NODES\n    \n    q = deque()\n    dist[source] = 0\n    inQueue[source] = True\n    q.append(source)\n    \n    while q:\n        u = q.popleft()\n        inQueue[u] = False\n        \n        i = head[u]\n        while i != -1:\n            edge = edges[i]\n            v = edge.to\n            if edge.cap > edge.flow and dist[v] > dist[u] + edge.cost:\n                dist[v] = dist[u] + edge.cost\n                prevEdge[v] = i\n                if not inQueue[v]:\n                    inQueue[v] = True\n                    q.append(v)\n            i = edge.next\n    \n    return prevEdge[sink] != -1\n\ndef minCostMaxFlow(source, sink):\n    totalFlow = 0\n    totalCost = 0\n    \n    while findShortestPath(source, sink):\n        bottleneck = INF\n        i = prevEdge[sink]\n        while i != -1:\n            bottleneck = min(bottleneck, edges[i].cap - edges[i].flow)\n            i = prevEdge[edges[i ^ 1].to]\n        \n        i = prevEdge[sink]\n        while i != -1:\n            edges[i].flow += bottleneck\n            edges[i ^ 1].flow -= bottleneck\n            totalCost += edges[i].cost * bottleneck\n            i = prevEdge[edges[i ^ 1].to]\n        \n        totalFlow += bottleneck\n    \n    return (totalFlow, totalCost)\n\ndef main():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    initialize(MAX_NODES)\n    \n    for i in range(k):\n        x = int(input_data[idx]); idx += 1\n        addEdge(0, x, 1, 0)\n    \n    for i in range(100):\n        for j in range(k):\n            addEdge(1 + i * n, 9999, 1, i * c)\n    \n    for i in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                addEdge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d)\n                addEdge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d)\n    \n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            addEdge(i + (j - 1) * n, i + j * n, k, 0)\n    \n    result = minCostMaxFlow(0, 9999)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs":