rn\n    if not (sc[i][j].isdigit() or sc[i][j] == 'Z'):\n        return\n    if tMat[i][j] != -1 and tMat[i][j] <= cur:\n        return\n    if tMat[i][j] == -1:\n        tMat[i][j] = cur\n    else:\n        tMat[i][j] = min(tMat[i][j], cur)\n    computeT(i + 1, j, sc, n, cur + 1, tMat)\n    computeT(i - 1, j, sc, n, cur + 1, tMat)\n    computeT(i, j + 1, sc, n, cur + 1, tMat)\n    computeT(i, j - 1, sc, n, cur + 1, tMat)\n\ndef computeA(i, j, sc, n, cur, aMat):\n    if i < 0 or i >= n or j < 0 or j >= n:\n        return\n    if not sc[i][j].isdigit():\n        return\n    if aMat[i][j] != -1 and aMat[i][j] <= cur:\n        return\n    if aMat[i][j] == -1:\n        aMat[i][j] = cur\n    else:\n        aMat[i][j] = min(aMat[i][j], cur)\n    computeA(i + 1, j, sc, n, cur + 1, aMat)\n    computeA(i - 1, j, sc, n, cur + 1, aMat)\n    computeA(i, j + 1, sc, n, cur + 1, aMat)\n    computeA(i, j - 1, sc, n, cur + 1, aMat)\n\nclass Edge:\n    def __init__(self, to, rev, cap):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n\nclass Dinic:\n    def __init__(self, N, S, T):\n        self.N = N\n        self.S = S\n        self.T = T\n        self.adj = [[] for _ in range(N)]\n        self.level = [0] * N\n        self.ptr = [0] * N\n\n    def addEdge(self, u, v, c):\n        self.adj[u].append(Edge(v, len(self.adj[v]), c))\n        self.adj[v].append(Edge(u, len(self.adj[u]) - 1, 0))\n\n    def bfs(self):\n        from collections import deque\n        self.level = [-1] * self.N\n        q = deque()\n        self.level[self.S] = 0\n        q.append(self.S)\n        while q:\n            u = q.popleft()\n            for e in self.adj[u]:\n                if e.cap > 0 and self.level[e.to] == -1:\n                    self.level[e.to] = self.level[u] + 1\n                    q.append(e.to)\n        return self.level[self.T] != -1\n\n    def dfs(self, u, f):\n        if u == self.T:\n            return f\n        while self.ptr[u] < len(self.adj[u]):\n       