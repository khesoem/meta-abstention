rue;\n                    q.push(e.to);\n                }\n            }\n        }\n    }\n    return dist[t] != INF;\n}\n\nint minCostMaxflow(int s, int t, int& cost) {\n    int flow = 0;\n    cost = 0;\n    vector<int> pre(N), pre_edge(N);\n    while (bellman_ford(s, t, pre, pre_edge)) {\n        int add = INF;\n        for (int v = t; v != s; v = pre[v]) {\n            int u = pre[v];\n            int ei = pre_edge[v];\n            add = min(add, g[u][ei].cap);\n        }\n        for (int v = t; v != s; v = pre[v]) {\n            int u = pre[v];\n            int ei = pre_edge[v];\n            g[u][ei].cap -= add;\n            g[v][g[u][ei].rev].cap += add;\n            cost += add * g[u][ei].cost;\n        }\n        flow += add;\n    }\n    return flow;\n}\n\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    init(MAXN);\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        addedge(0, x, 1, 0);\n    }\n    for (int i = 0; i < 100; ++i) {\n        for (int j = 0; j < k; ++j) {\n            addedge(1 + i * n, 9999, 1, i * c);\n        }\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        for (int j = 1; j < 100; ++j) {\n            for (int gg = 1; gg <= k; ++gg) {\n                addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            addedge(i + (j - 1) * n, i + j * n, k, 0);\n        }\n    }\n    int cost;\n    minCostMaxflow(0, 9999, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 10000\nINF = 10**9\n\ndef init(n):\n    global N, g\n    N = n\n    g = [[] for _ in range(n