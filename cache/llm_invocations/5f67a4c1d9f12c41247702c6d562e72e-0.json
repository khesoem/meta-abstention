": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nfrom fractions import Fraction\n\nclass FFT:\n    SIZE = 1 << 20\n    MOD = 998244353\n    ROOT = 646\n    ROOT_POWERS = [0] * SIZE\n    ROOT_INV_POWERS = [0] * SIZE\n    SIZE_INVERSE = 0\n\n    @staticmethod\n    def mod_inverse(a, m):\n        # Extended Euclidean Algorithm\n        def extended_gcd(a, b):\n            if a == 0:\n                return b, 0, 1\n            gcd, x1, y1 = extended_gcd(b % a, a)\n            x = y1 - (b // a) * x1\n            y = x1\n            return gcd, x, y\n        \n        gcd, x, _ = extended_gcd(a % m, m)\n        if gcd != 1:\n            raise ValueError(\"Modular inverse does not exist\")\n        else:\n            return (x % m + m) % m\n\n    @staticmethod\n    def initialize():\n        FFT.ROOT_POWERS[0] = 1\n        FFT.ROOT_INV_POWERS[0] = 1\n        for i in range(1, FFT.SIZE):\n            FFT.ROOT_POWERS[i] = (FFT.ROOT_POWERS[i-1] * FFT.ROOT) % FFT.MOD\n            FFT.ROOT_INV_POWERS[i] = (FFT.ROOT_INV_POWERS[i-1] * FFT.ROOT) % FFT.MOD\n        FFT.SIZE_INVERSE = FFT.mod_inverse(FFT.SIZE, FFT.MOD)\n\n    class CoefficientArray:\n        def __init__(self, input_list):\n            self.values = [0] * FFT.SIZE\n            for i in range(len(input_list)):\n                self.values[i] = input_list[i]\n\n        def transform(self, forward):\n            return self._recursive_transform(0, 1, forward)\n\n        def _recursive_transform(self, start, step, forward):\n            if step == FFT.SIZE:\n                return [self.values[start]]\n            even = self._recursive_transform(start, step << 1, forward)\n            odd = self._recursive_transform(start + step, step << 1, forward)\n            half = len(even)\n            combined = [0] * (half << 1)\n            for i in range(half):\n                twiddle = FFT.ROOT_POWERS[i * step] if forward else FFT.ROOT_INV_POWERS[i * step]\n                combined[i] = (even[i] + twiddle * odd[i]) % FFT.MOD\n            for i in range(half):\n                twiddle = FFT.ROOT_POWERS[i * step] if forward else FFT.ROOT_INV_POWERS[i * step]\n                combined[half + i] = ((even[i] - twiddle * odd[i]) % FFT.MOD + FFT.MOD) % FFT.MOD\n            return combined\n\n    def direct_fourier_transform(self, input_list):\n        output = [0] * FFT.SIZE\n        w_power = 1\n        for i in range(FFT.SIZE):\n            x = 1\n            for j in range(len(input_list)):\n                output[i] = (output[i] + input_list[j] * x) % FFT.MOD\n                x = (x * w_power) % FFT.MOD\n            w_power = (w_power * FFT.ROOT) % FFT.MOD\n        return output\n\n    def raise_to_exponent(self, arr, exponent):\n        for i in range(len(arr)):\n            arr[i] = self.fast_exponentiate(arr[i], exponent)\n        return arr\n\n    def fast_exponentiate(self, base, exp):\n        if exp == 0:\n            return 1\n        if exp & 1:\n            return (self.fast_exponentiate(base, exp - 1) * base) % FFT.MOD\n        half = self.fast_exponentiate(base, exp >> 1)\n        return (half * half) % FFT.MOD\n\n    def run(self):\n        n = int(sys.stdin.readline().strip())\n        k = int(sys.stdin.readline().strip())\n        poly = [0] * 10\n        for _ in range(k):\n            idx = int(sys.stdin.readline().strip())\n            poly[idx] = 1\n        \n        transformed = self.direct_fourier_transform(poly)\n        transformed = self.raise_to_exponent(transformed, n // 2)\n        buffer = self.CoefficientArray(transformed)\n        transformed = buffer.transform(False)\n        for i in range(len(transformed)):\n            transformed[i] = (transformed[i] * FFT.SIZE_INVERSE) % FFT.MOD\n        \n        answer = 0\n        for val in transformed:\n            answer = (answer + val * val) % FFT.MOD\n        print(answer)\n\n    def setup(self):\n        FFT.initialize()\n        self.run()\n\nif __name__ == \"__main__\":\n    fft_instance = FFT()\n    fft_instance.setup()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-7.998623186722398e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.0012325793504714966, -0.0023204563185572624, -1.3828182090946939e-05, -0.11309801787137985, -0.04549132660031319, -0.5759475827217102, -0.008630003780126572, -0.5303030610084534, -1.311301275563892e-06, -0.008330005221068859, -0.0013756821863353252, -0.28455889225006104, -0.00010466027742950246, -2.7656173188006505e-05, -7.152555099310121e-07, -3.3378546504536644e-06, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, 0.0, -2.7418097943154862e-06, -3.2066785934148356e-05, -1.9073468138230965e-06, 0.0, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -3.576272320060525e-06, -1.1920922133867862e-06, -4.768370445162873e-07, -1.1920922133867862e-06, -1.0728830375228426e-06, -9.536738616588991e-07, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -8.106198947643861e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.4543427823809907e-05, -3.576272320060525e-06, -5.722029527532868e-06, -0.0031925681978464127, -3.576278118089249e-07, -0.006805100943893194, -0.0001567479339428246, -3.576272320060525e-06, -8.344646857949556e-07, -9.536738616588991e-07, -0.23017273843288422, -0.0005806190893054008, -1.0728830375228426e-06, 0.0, -1.5497195136049413e-06, -7.152555099310121e-07, -1.1920928244535389e-07, -8.702239938429557e-06, -0.00010847456724150106, -4.768370445162873e-07, -7.152555099310121e-07, -9.536738616588991e-07, -8.821448318485636e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.6689286894688848e-06, -5.960446742392378e-06, -0.0002971446083392948, -2.3841855067985307e-07, -4.172316494077677e-06, -5.6980417866725475e-05, -2.90866428258596e-05, -1.1920928244535389e-07, -0.0017046695575118065, -0.004620233550667763, -0.0067187827080488205, -1.8119