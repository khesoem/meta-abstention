      line = data[line_idx]\n        for j in range(1, n + 1):\n            if j <= len(line):\n                c = line[j-1]\n                if c.isdigit():\n                    gridA[i][j] = int(c)\n                if c == 'Z':\n                    startR = i\n                    startC = j\n        line_idx += 1\n    \n    bfsFrom(startR, startC)\n    \n    for i in range(1, n + 1):\n        line = data[line_idx]\n        for j in range(1, n + 1):\n            if j <= len(line):\n                c = line[j-1]\n                if c.isdigit():\n                    gridB[i][j] = int(c)\n                count = gridB[i][j] if gridB[i][j] >= 0 else 0\n                for k in range(count):\n                    exitList[i][j].append(len(exitList[i][j]))\n        line_idx += 1\n    \n    for i in range(MAXG):\n        for j in range(MAXG):\n            if dist[i][j] == -1:\n                dist[i][j] = INF\n    \n    nodeCount = 0\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if gridA[i][j] > 0:\n                nodeCount = expandFrom(i, j, gridA[i][j], T, nodeCount)\n    \n    solver = Matching()\n    print(solver.compute(nodeCount, adj))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00010752100206445903, -9.536738616588991e-07, -1.1920928244535389e-07, -0.16067594289779663, -0.0011273226700723171, -5.960462772236497e-07, -0.00011157367407577112, -0.0002236116270069033, -1.0728830375228426e-06, -0.0007128558354452252, -0.0004951919545419514, -0.01840793900191784, -6.794698856538162e-05, 0.0, 0.0, -4.768370445162873e-07, 0.0, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -2.777537883957848e-05, -2.4676019165781327e-05, -1.1920922133867862e-06, -2.6940935640595853e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, 0.0, -1.2993727978027891e-05, -0.0001401803019689396, 0.0,