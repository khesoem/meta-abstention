] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        pv[e.to] = u;\n                        pe[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.push(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            int add = INF;\n            for (int v = t; v != s; v = pv[v]) {\n                add = min(add, G[pv[v]][pe[v]].cap);\n            }\n            flow += add;\n            cost += add * dist[t];\n            for (int v = t; v != s; v = pv[v]) {\n                Edge &e = G[pv[v]][pe[v]];\n                e.cap -= add;\n                G[v][e.rev].cap += add;\n            }\n        }\n        return {flow, cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MinCostFlow mcf(n * K + 2);\n    int src = n * K;\n    int sink = src + 1;\n\n    for (int i = 0; i < K; ++i)\n        mcf.addEdge(i, sink, k, C * i);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.addEdge(src, x * K, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 1; j < K; ++j)\n            mcf.addEdge(i * K + j - 1, i * K + j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n\n        for (int j = 1; j < K; ++j) {\n            int a = u * K + j - 1, b = v * K + j;\n            int c = v * K + j - 1, d = u * K + j;\n\n            for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                mcf.addEdge(a, b, 1, cc);\n                mcf.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n\n    auto res = mcf.minCost(src, sink);\n    cout << res.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepsee