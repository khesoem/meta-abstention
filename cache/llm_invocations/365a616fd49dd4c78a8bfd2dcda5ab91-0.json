\n    def __add__(self, m):\n        res = Matrix(self.h, self.w, self.a)\n        res += m\n        return res\n    \n    def __sub__(self, m):\n        res = Matrix(self.h, self.w, self.a)\n        res -= m\n        return res\n    \n    def __mul__(self, m):\n        res = Matrix(self.h, self.w, self.a)\n        res *= m\n        return res\n\ndef unit_matrix(n):\n    ret = Matrix(n)\n    for i in range(n):\n        ret.set(i, i, 1)\n    return ret\n\ndef mat_pow(matrix, n):\n    assert matrix.h == matrix.w\n    ret = unit_matrix(matrix.h)\n    base = Matrix(matrix.h, matrix.w, matrix.a)\n    while n > 0:\n        if n & 1:\n            ret *= base\n        base *= base\n        n >>= 1\n    return ret\n\ndef calc_matrix(a_list, i, k):\n    return mat_pow(a_list[i + k], k - i) * mat_pow(a_list[i], i)\n\ndef solve(n, k):\n    cnt = 0\n    tmp = n\n    while tmp:\n        tmp //= k\n        cnt += 1\n    \n    b = [None] * (cnt + 5)\n    c = [None] * (cnt + 5)\n    d = [None] * (k + 1)\n    \n    a_list = [None] * (65)\n    \n    # Initialize a_list as in main()\n    for i in range(2 * k + 1):\n        a_list[i] = Matrix(2 * k + 1)\n        for j in range(i):\n            a_list[i].set(0, j, 1)\n        for j in range(2 * k - 1):\n            a_list[i].set(j + 1, j, 1)\n        a_list[i].set(2 * k, 0, 1)\n        a_list[i].set(2 * k, 2 * k, 1)\n    \n    b[0] = a_list[k - 1]\n    c[0] = mat_pow(b[0], k - 1)\n    \n    b[1] = calc_matrix(a_list, k - 1, k)\n    c[1] = mat_pow(b[1], k - 1)\n    \n    s = unit_matrix(2 * k + 1)\n    \n    for j in range(2, cnt + 2):\n        b[j] = calc_matrix(a_list, k - j % k, k)\n        s *= c[j - 1]\n        b[j] *= s\n        c[j] = mat_pow(b[j], k - 1)\n    \n    idx = 1\n    rem = n % k\n    n -= rem\n    q = 0\n    tmp = n\n    if tmp:\n        while tmp % k == 0:\n            q += 1\n            tmp //= k\n    \n    q = (k - q % k) % k\n    \n    ans = unit_matrix(2 * k + 1)\n    ans = mat_pow(a_list[q], rem) * mat_pow(a_list[q + k], max(rem - q, 0))\n    n //= k\n    \n    if not n:\n        return (ans.get(2 * k, 0) + ans.get(0, 0)) % mod\n    \n    n -= 1\n    while n:\n        t = n % k\n        if t:\n            ans *= mat_pow(b[idx], t)\n        n //= k\n        idx += 1\n    \n    ans *= b[1]\n    \n    return (ans.get(2 * k, 0) + ans.get(0, 0)) % mod\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    print(solve(n, k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00028308198670856655, -1.4305104514278355e-06, -9.536738616588991e-07, -0.2901110053062439, -0.0011199399596080184, -0.0431385301053524, -0.258019357919693, -3.576278118089249e-07, -0.0002961912250611931, 0.0, -3.3378546504536644e-06, -0.026303697377443314, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -0.0011720937909558415, -0.1797551065683365, -1.3828182090946939e-05, -2.861018856492592e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -3.099436753473128e-06, -2.622600959512056e-06, -1.1920928244535389e-07, -1.4305104514278355e-06, -1.4305104514278355e-06, -0.012886698357760906, -0.2569892406463623, -3.576278118089249e-07, -0.0020320022013038397, -0.12693434953689575, -0.05834813788533211, -0.00026556302327662706, -3.814689989667386e-06, -4.768360213347478e-06, -0.00014006110723130405, -4.529942543740617e-06, -4.887569048150908e-06, -2.9802276912960224e-06, -8.22540732769994e-06, -4.768370445162873e-07, -0.2812337875366211, -2.3841830625315197e-06, -0.0003357561945449561, -1.1920858014491387e-05, -1.1920928244535389e-07, -5.364403477869928e-06, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, -0.0021865288726985455, -0.1117100715637207, -7.331102824537084e-05, -5.960462772236497e-07, -0.00027164106722921133, -1.1920922133867862e-06, -9.691245941212401e-05, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, -1.1920928244535389e-07, -5.960