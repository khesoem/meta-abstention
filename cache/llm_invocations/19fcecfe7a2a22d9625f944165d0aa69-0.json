d2);\r\n\t}\r\n\tfor(int i=(pos==1?1:0);i<=9;++i) solve(pos+1,now*10+i);\r\n}\r\nint main(){\r\n\tscanf(\"%lld\",&n);\r\n\tpw[0]=1;for(int i=1;i<9;++i) pw[i]=10*pw[i-1];\r\n\tdfs(1,0);\r\n\tfor(int i=0;i<7;++i)\r\n\t\tsort(ve[i].begin(),ve[i].end()); \r\n\tsolve(1,0);\r\n\tprintf(\"%d\\n\",ans);\r\n\treturn 0;\r\n}\r\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int mod1 = 998244353;\n    static final int mod2 = 1000000007;\n    static final int N = 2000000;\n    static final int MX = 1000000;\n    \n    static long n, c;\n    static int tot, ans, lim;\n    static int[] pw = new int[9];\n    static int[] sum = new int[7];\n    static ArrayList<Integer>[] ve = new ArrayList[7];\n    \n    static int dec(int x, int y, int mod) {\n        return (x - y < 0) ? x - y + mod : x - y;\n    }\n    \n    static int add(int x, int y, int mod) {\n        return (x + y >= mod) ? x + y - mod : x + y;\n    }\n    \n    static void dfs(int pos, int now) {\n        if (now <= n) {\n            ++tot;\n            int x = dec(tot, now, mod1);\n            ve[pos - 1].add(x);\n            sum[pos - 1] = add(sum[pos - 1], x, mod2);\n        }\n        if (pos > 6) return;\n        for (int i = 0; i <= 9; ++i) {\n            dfs(pos + 1, now * 10 + i);\n        }\n    }\n    \n    static void solve(int pos, long now) {\n        if (now > n) return;\n        if (pos > 1) {\n            if (10L * now * MX > n && 1L * (now + 1) * MX - 1 <= n) {\n                for (int i = 0; i < 7; ++i) {\n                    long x = ((c - 1L * now * pw[i]) % mod1 + mod1) % mod1;\n                    int xi = (int)x;\n                    int p = lowerBound(ve[i], mod1 - xi);\n                    int temp1 = (int)((1L * x * ve[i].size()) % mod2);\n                    int temp2 = add(temp1, sum[i], mod2);\n   