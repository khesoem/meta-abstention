{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nvector<vector<ll>> comb;\n\nint R, C;\nll total;\nll best = 1e18, best_z = -1;\n\nvoid dfs(ll x, ll y, int v1, int v2) {\n    ll diff = abs(x - y);\n    if (best <= 1 || diff - comb[v1][R] * comb[v2][R] >= best)\n        return;\n    if (v1 == R - 1 && v2 == R - 1) {\n        ll diff = abs(x - y);\n        if (diff < best) {\n            best = diff;\n            best_z = x;\n        }\n        return;\n    }\n    if (v1 >= R) {\n        ll cur1 = comb[v1][R] - comb[v1 - 1][R];\n        ll sum2 = comb[v2][R];\n        dfs(x, y + cur1 * sum2, v1 - 1, v2);\n    }\n    if (v2 >= R) {\n        ll sum1 = comb[v1][R];\n        ll cur2 = comb[v2][R] - comb[v2 - 1][R];\n        dfs(x + sum1 * cur2, y, v1, v2 - 1);\n    }\n}\n\nstring s;\nvector<int> cntA, cntB;\nunordered_map<ll, ll> memo;\n\nll solve(ll x, ll y, int v1, int v2) {\n    ll state = x * 10000 + v1 * 100 + v2;\n    auto it = memo.find(state);\n    if (it != memo.end()) return it->second;\n    ll &res = memo[state];\n    ll diff = abs(x - y);\n    if (diff - comb[v1][R] * comb[v2][R] > best) {\n        return res = 0;\n    }\n    if (v1 < R || v2 < R) {\n        if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n            int sum = v1 + v2;\n            v1 -= cntA[sum];\n            v2 -= cntB[sum];\n            return res = comb[v1 + v2][v1];\n        }\n        return res = 0;\n    }\n    res = 0;\n    char c = s[v1 + v2 - 1];\n    if (c != 'B') {\n        ll cur1 = comb[v1][R] - comb[v1 - 1][R];\n        ll sum2 = comb[v2][R];\n        res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n    }\n    if (c != 'A') {\n        ll sum1 = comb[v1][R];\n        ll cur2 = comb[v2][R] - comb[v2 - 1][R];\n        res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n    }\n    return res;\n}\n\nint main() {\n    scanf(\"%d %d\", &R, &C);\n    int maxN = 2 * (R + C);\n    comb.assign(maxN + 1, vector<ll>(maxN + 1, 0));\n    for (int i = 0; i <= maxN; ++i) {\n        comb[i][0] = 1;\n        for (int j = 1; j <= i; ++j)\n            comb[i][j] = comb[i - 1][j] + comb[i - 1][j - 1];\n    }\n    total = comb[R + C][R] * comb[R + C][R];\n    {\n        ll x = 0, y = 0;\n        int v1 = R + C, v2 = R + C;\n        while (v1 >= R && v2 >= R) {\n            if (x > y) {\n                ll cur1 = comb[v1][R] - comb[v1 - 1][R];\n                ll sum2 = comb[v2][R];\n                y += cur1 * sum2;\n                v1--;\n            } else {\n                ll sum1 = comb[v1][R];\n                ll cur2 = comb[v2][R] - comb[v2 - 1][R];\n                x += sum1 * cur2;\n                v2--;\n            }\n        }\n        best = abs(x - y);\n    }\n    dfs(0, 0, R + C, R + C);\n    char buf[12345];\n    scanf(\"%s\", buf);\n    s = buf;\n    int len = 2 * (R + C);\n    cntA.assign(len + 1, 0);\n    cntB.assign(len + 1, 0);\n    for (int i = 0; i < len; ++i) {\n        cntA[i + 1] = cntA[i] + (s[i] == 'A');\n        cntB[i + 1] = cntB[i] + (s[i] == 'B');\n    }\n    ll ans = solve(0, 0, R + C, R + C);\n    cout << ans << endl;\n    return 0;\n}