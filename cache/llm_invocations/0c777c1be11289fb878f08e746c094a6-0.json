{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nclass MinCostMaxFlow {\nprivate:\n    static constexpr int MX = 5500;\n    static constexpr ll INF = 1000000007LL;\n\n    struct Edge {\n        int to, cost, rev, cap;\n    };\n\n    int n, m, k, c, d;\n    int u, v, mx;\n    int s, t, mf;\n    int tr[MX];\n    ll ans, dis[MX];\n    vector<Edge> adj[MX];\n    priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n\n    int at(int node, int time) const {\n        return node + time * n;\n    }\n\n    void addEdge(int u, int v, int cost, int cap) {\n        int szu = adj[u].size();\n        int szv = adj[v].size();\n        adj[u].push_back({v, cost, szv, cap});\n        adj[v].push_back({u, -cost, szu, 0});\n    }\n\n    void dijkstra() {\n        fill(dis, dis + MX, INF);\n        pq.push({dis[s] = 0, s});\n        while (!pq.empty()) {\n            auto [du, x] = pq.top();\n            pq.pop();\n            if (du > dis[x]) continue;\n            for (const Edge &e : adj[x]) {\n                if (e.cap > 0 && dis[e.to] > du + e.cost) {\n                    tr[e.to] = e.rev;\n                    pq.push({dis[e.to] = du + e.cost, e.to});\n                }\n            }\n        }\n    }\n\n    void trace() {\n        int aug = k, cur = t;\n        while (cur != s) {\n            const Edge &rev = adj[cur][tr[cur]];\n            int pre = rev.to;\n            int fwd = rev.rev;\n            aug = min(aug, adj[pre][fwd].cap);\n            cur = pre;\n        }\n        mf += aug;\n        ans += aug * dis[t];\n        cur = t;\n        while (cur != s) {\n            Edge &rev = adj[cur][tr[cur]];\n            int pre = rev.to;\n            int fwd = rev.rev;\n            rev.cap += aug;\n            adj[pre][fwd].cap -= aug;\n            cur = pre;\n        }\n    }\n\npublic:\n    void run() {\n        ios::sync_with_stdio(false);\n        cin.tie(nullptr);\n        cin >> n >> m >> k >> c >> d;\n        s = MX - 2;\n        t = MX - 1;\n        mf = 0;\n        ans = 0;\n        mx = n + k;\n        for (int i = 0; i < k; i++) {\n            cin >> u;\n            addEdge(s, at(u, 0), 0, 1);\n        }\n        for (int i = 0; i <= mx; i++) {\n            addEdge(at(1, i), t, c * i, k);\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                addEdge(at(i, j), at(i, j + 1), 0, k);\n            }\n        }\n        while (m--) {\n            cin >> u >> v;\n            for (int i = 1; i <= k; i++) {\n                for (int j = 0; j < mx; j++) {\n                    addEdge(at(u, j), at(v, j + 1), d * (2 * i - 1), 1);\n                    addEdge(at(v, j), at(u, j + 1), d * (2 * i - 1), 1);\n                }\n            }\n        }\n        while (mf < k) {\n            dijkstra();\n            trace();\n        }\n        cout << ans;\n    }\n};\n\nint main() {\n    MinCostMaxFlow solver;\n    solver.run();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MinCostMaxFlow:\n    def __init__(self):\n        self.n = 0\n        self.m = 0\n        self.k = 0\n        self.c = 0\n        self.d = 0\n        self.mx = 0\n        self.s = 0\n        self.t = 0\n        self.mf = 0\n        self.ans = 0\n        self.adj = []\n        self.dis = []\n        self.tr = []\n        self.pq = []\n\n    def at(self, node, time):\n        return node + time * self.n\n\n    def add_edge(self, u, v, cost, cap):\n        szu = len(self.adj[u])\n        szv = len(self.adj[v])\n        self.adj[u].append([v, cost, szv, cap])\n        self.adj[v].append([u, -cost, szu, 0])\n\n    def dijkstra(self):\n        INF = 1000000007\n        self.dis = [INF] * len(self.adj)\n        self.tr = [-1] * len(self.adj)\n        self.pq = []\n        self.dis[self.s] = 0\n        heapq.heappush(self.pq, (0, self.s))\n        while self.pq:\n            du, x = heapq.heappop(self.pq)\n            if du > self.dis[x]:\n                continue\n            for e in self.adj[x]:\n                if e[3] > 0 and self.dis[e[0]] > du + e[1]:\n                    self.dis[e[0]] = du + e[1]\n                    self.tr[e[0]] = e[2]\n                    heapq.heappush(self.pq, (self.dis[e[0]], e[0]))\n\n    def trace(self):\n        aug = self.k\n        cur = self.t\n        while cur != self.s:\n            rev = self.adj[cur][self.tr[cur]]\n            pre = rev[0]\n            fwd = rev[2]\n            aug = min(aug, self.adj[pre][fwd][3])\n            cur = pre\n        self.mf += aug\n        self.ans += aug * self.dis[self.t]\n        cur = self.t\n        while cur != self.s:\n            rev = self.adj[cur][self.tr[cur]]\n            pre = rev[0]\n            fwd = rev[2]\n            rev[3] += aug\n            self.adj[pre][fwd][3] -= aug\n            cur = pre\n\n    def run(self):\n        data = sys.stdin.read().split()\n        it = iter(data)\n        self.n = int(next(it))\n        self.m = int(next(it))\n        self.k = int(next(it))\n        self.c = int(next(it))\n        self.d = int(next(it))\n        self.mx = self.n + self.k\n        # total nodes: n*(mx+1) + 2 (s and t)\n        total_nodes = self.n * (self.mx + 1) + 2\n        self.s = total_nodes - 2\n        self.t = total_nodes - 1\n        self.adj = [[] for _ in range(total_nodes)]\n        self.mf = 0\n        self.ans = 0\n\n        # read starting positions\n        for _ in range(self.k):\n            u = int(next(it))\n            self.add_edge(self.s, self.at(u, 0), 0, 1)\n\n        # connect node 1 to sink at each time\n        for i in range(self.mx + 1):\n            self.add_edge(self.at(1, i), self.t, self.c * i, self.k)\n\n        # stay edges (waiting)\n        for i in range(1, self.n + 1):\n            for j in range(self.mx):\n                self.add_edge(self.at(i, j), self.at(i, j + 1), 0, self.k)\n\n        # movement edges\n        for _ in range(self.m):\n            u = int(next(it))\n            v = int(next(it))\n            for i in range(1, self.k + 1):\n                cost = self.d * (2 * i - 1)\n                for j in range(self.mx):\n                    self.add_edge(self.at(u, j), self.at(v, j + 1), cost, 1)\n                    self.add_edge(self.at(v, j), self.at(u, j + 1), cost, 1)\n\n        while self.mf < self.k:\n            self.dijkstra()\n            self.trace()\n\n        print(self.ans)\n\nif __name__ == \"__main__\":\n    solver = MinCostMaxFlow()\n    solver.run()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0234645027667284, -5.924526340095326e-05, 0.0, 0.0, -0.00035553809721022844, -0.0015182883944362402, -0.00020346954988781363, -0.0024792193435132504, -1.6689160474925302e-05, -1.0251946150674485e-05, -0.0010924329981207848, -0.008625749498605728, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -6.794906312279636e-06, -9.536738616588991e-07, -0.20146888494491577, -0.0052472725