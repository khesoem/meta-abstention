{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int MAXN = 10000010, BIG = 0x3f3f3f3f;\nint n, m, k, c, d, src = 0, sink, total = 0;\nint edge_cnt = 1, head[MAXN], to[MAXN], nxt[MAXN], cap[MAXN], cost[MAXN];\nint dist[MAXN], flow[MAXN], prev_edge[MAXN]; bool in_queue[MAXN];\n\nvoid add_edge(int x, int y, int z, int v) {\n    to[++edge_cnt] = y; nxt[edge_cnt] = head[x]; head[x] = edge_cnt; cap[edge_cnt] = z; cost[edge_cnt] = v;\n    to[++edge_cnt] = x; nxt[edge_cnt] = head[y]; head[y] = edge_cnt; cap[edge_cnt] = 0; cost[edge_cnt] = -v;\n}\n\nbool spfa() {\n    fill(flow, flow + MAXN, 0);\n    fill(dist, dist + MAXN, BIG);\n    fill(in_queue, in_queue + MAXN, false);\n    queue<int> q;\n    q.push(src); flow[src] = BIG; in_queue[src] = true; dist[src] = 0;\n    while (!q.empty()) {\n        int u = q.front(); q.pop(); in_queue[u] = false;\n        for (int i = head[u]; i; i = nxt[i]) {\n            if (!cap[i] || dist[to[i]] <= dist[u] + cost[i]) continue;\n            dist[to[i]] = dist[u] + cost[i];\n            flow[to[i]] = min(flow[u], cap[i]);\n            prev_edge[to[i]] = i;\n            if (!in_queue[to[i]]) {\n                in_queue[to[i]] = true;\n                q.push(to[i]);\n            }\n        }\n    }\n    return dist[sink] != BIG;\n}\n\nvoid augment() {\n    int cur = sink;\n    while (cur != src) {\n        int e = prev_edge[cur];\n        cap[e] -= flow[sink];\n        cap[e ^ 1] += flow[sink];\n        cur = to[e ^ 1];\n    }\n    total += flow[sink] * dist[sink];\n}\n\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    sink = (n + k - 1) * n + 1;\n    for (int i = 1, x; i <= k; i++) {\n        cin >> x;\n        add_edge(src, x, 1, 0);\n    }\n    for (int i = 1, x, y; i <= m; i++) {\n        cin >> x >> y;\n        for (int j = 1; j <= n + k; j++)\n            for (int h = 1; h <= k; h++) {\n                add_edge(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n                add_edge(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c);\n            }\n    }\n    for (int i = 1; i < n + k; i++) {\n        for (int j = 2; j <= n; j++)\n            add_edge(j + (i - 1) * n, j + i * n, BIG, c);\n        add_edge(1 + (i - 1) * n, 1 + i * n, BIG, 0);\n    }\n    while (spfa()) augment();\n    cout << total << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```python\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    # sink node index\n    sink = (n + k - 1) * n + 1\n    # maximum node index used in the graph (including possible extra nodes from road edges)\n    max_node = n * (n + k + 1)  # covers all nodes up to (n+k)*n + n\n    N = max_node + 1  # include node 0 (source)\n\n    # graph representation: list of lists of edges\n    graph = [[] for _ in range(N)]\n\n    class Edge:\n        __slots__ = ('to', 'rev', 'cap', 'cost')\n        def __init__(self, to: int, rev: int, cap: int, cost: int):\n            self.to = to\n            self.rev = rev\n            self.cap = cap\n            self.cost = cost\n\n    def add_edge(x: int, y: int, z: int, v: int) -> None:\n        graph[x].append(Edge(y, len(graph[y]), z, v))\n        graph[y].append(Edge(x, len(graph[x]) - 1, 0, -v))\n\n    INF = 10**18\n    src = 0\n\n    # read starting positions and add edges from source\n    for _ in range(k):\n        x = next(it)\n        add_edge(src, x, 1, 0)\n\n    # read roads and add edges for each time step and each h\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for j in range(1, n + k + 1):  # j from 1 to n+k inclusive (as in original)\n            for h in range(1, k + 1):\n                cost_val = d * h * 2 - d + c\n                add_edge(x + (j - 1) * n, y + j * n, 1, cost_val)\n                add_edge(y + (j - 1) * n, x + j * n, 1, cost_val)\n\n    # staying edges (waiting)\n    for i in range(1, n + k):  # i from 1 to n+k-1\n        for j in range(2, n + 1):\n            add_edge(j + (i - 1) * n, j + i * n, INF, c)\n        add_edge(1 + (i - 1) * n, 1 + i * n, INF, 0)\n\n    # Min-cost max-flow using SPFA\n    dist = [INF] * N\n    flow = [0] * N\n    prev = [(-1, -1)] * N  # (node, edge index)\n    inq = [False] * N\n    total_cost = 0\n\n    def spfa() -> bool:\n        nonlocal total_cost\n        # reset arrays (only needed fields)\n        for i in range(N):\n            dist[i] = INF\n            flow[i] = 0\n            inq[i] = False\n        q = deque()\n        dist[src] = 0\n        flow[src] = INF\n        inq[src] = True\n        q.append(src)\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for i, e in enumerate(graph[u]):\n                if e.cap == 0:\n                    continue\n                if dist[e.to] > dist[u] + e.cost:\n                    dist[e.to] = dist[u] + e.cost\n                    flow[e.to] = min(flow[u], e.cap)\n                    prev[e.to] = (u, i)\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n        return dist[sink] != INF\n\n    def augment() -> None:\n        nonlocal total_cost\n        cur = sink\n        while cur != src:\n            u, ei = prev[cur]\n            e = graph[u][ei]\n            e.cap -= flow[sink]\n            graph[e.to][e.rev].cap += flow[sink]\n            cur = u\n        total_cost += flow[sink] * dist[sink]\n\n    while spfa():\n        augment()\n\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    solve()\n```", "token_logprobs": [-0.4748189449310303, -1.1920928244535389e-07, -4.8993817472364753e-05, -2.4199192921514623e-05, -1.1920928244535389e-07, -4.172316494077677e-06, -5.8410845667822286e-05, 0.0, 0.0, -2.3841855067985307e-07, -0.0019340872531756759, -0.1440414935350418, -0.2076311707496643, -0.12693193554878235, -1.5497195136049413e-06, -3.540453326422721e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.00015686711412854493, 0.0, -0.16027091443538666, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -0.023247892037034035, 0.0, -0.005233753472566605, -5.960462772236497e-07, -8.344646857949556e-07, -0.5765351057052612, -1.1920928244535389e-07, -9.60780744208023e-05, 0.0, -0.00010239553375868127, -7.486063259420916e-05, -7.760223525110632e-05, -0.00015853578224778175, -8.344646857949556e-07, 0.0, -0.4741551876068115, 0.0, 0.0, -3.2186455882765586e-06, 0.0, 0.0, -1.0132738680113107e-05, 0.0, -3.576278118089249e-07, -0.00012885693286079913, 0.0, 0.0, -1.490105023549404e-05, 0.0, -3.9219088648678735e-05, -0.0008247073274105787, 0.0, 0.0, -1.3112935448589269e-05, 0.0, -8.344646857949556e-07, -6.246371776796877e-05, 0.0, -3.576278118089249e-07, -0.02975284680724144, -3.576278118089249e-07, -0.24363453686237335, -1.156716227531433, -0.5977426171302795, -0.22041212022304535, -0.31871500611305237, 0.0, -0