; ++i) {\n        table[0][0].val[i][i] = 1;\n        table[0][0].val[0][i] = 1;\n    }\n\n    ULL y = 1, add = 0;\n    int x = 0, z = 0;\n\n    while (y * m <= n) {\n        y *= m;\n        ++x;\n    }\n\n    for (int t = 0; t <= x; ++t) {\n        if (t) {\n            table[t][0] = table[t-1][0];\n            for (int i = 1; i < m; ++i) {\n                table[t][0] = table[t][0] * table[t-1][i];\n            }\n        }\n\n        for (int i = 1; i < m; ++i) {\n            table[t][i] = table[t][i-1];\n            for (int j = m - 2; j >= 0; --j) {\n                for (int k = 0; k <= m; ++k) {\n                    swap(table[t][i].val[j][k], table[t][i].val[j+1][k]);\n                }\n            }\n            for (int j = m - 2; j >= 0; --j) {\n                for (int k = 0; k <= m; ++k) {\n                    swap(table[t][i].val[k][j], table[t][i].val[k][j+1]);\n                }\n            }\n        }\n    }\n\n    unit.sz = m + 1;\n    for (int i = 0; i <= m; ++i) {\n        unit.val[i][i] = 1;\n    }\n\n    while (add < n) {\n        if (add + y <= n) {\n            add += y;\n            unit = unit * table[x][z];\n            z = (z + 1) % m;\n        } else {\n            y /= m;\n            --x;\n        }\n    }\n\n    ULL ans = 0;\n    for (int i = 0; i <= m; ++i) {\n        ans = (ans + unit.val[i][m]) % MOD;\n    }\n    printf(\"%llu\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass Mat:\n    def __init__(self, sz=0):\n        self.sz = sz\n        self.val = [[0] * 35 for _ in range(35)]\n    \n    def __copy__(self):\n        new_mat = Mat(self.sz)\n        for i in range(35):\n            for j in range(35):\n                new_mat.val[i][j] = self.val[i][j]\n        return new_mat\n    \n    def __mul__(self, rhs):\n        res = Mat()\n        res.sz