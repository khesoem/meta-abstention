treturn;\n\t}\n\tma[a[x]][y]=0;\n\tif (y==n) dfs2(x+1,1,(LL)pro*(1-p[a[x]][y])%MOD);\n\telse dfs2(x,y+1,(LL)pro*(1-p[a[x]][y])%MOD);\n\tma[a[x]][y]=1;\n\tif (y==n) dfs2(x+1,1,(LL)pro*p[a[x]][y]%MOD);\n\telse dfs2(x,y+1,(LL)pro*p[a[x]][y]%MOD);\n}\n \nvoid dfs1(int x,int y,int s)\n{\n\tif (y==3)\n\t{\n\t\tid[s]=++tot;sta[tot]=s;\n\t\tfor (int i=1;i<=3;i++) pts[tot][i]=a[i];\n\t\treturn;\n\t}\n\tif (x>n) return;\n\tdfs1(x+1,y,s);\n\ta[y+1]=x;\n\tdfs1(x+1,y+1,s+bin[x-1]);\n}\n \nvoid pre()\n{\n\tfor (int i=0;i<tot;i++)\n\t\tfor (int j=0;j<bin[tot];j++)\n\t\t\tif (j&bin[i]) (g[j]+=g[j^bin[i]])%=MOD;\n}\n \nint main()\n{\n\tinit();\n\tdfs1(1,0,0);\n\ta[1]=1;a[2]=2;a[3]=3;\n\tdfs2(1,1,1);\n\tfor (int i=0;i<bin[tot];i++)\n\t{\n\t\tint t=0;\n\t\tfor (int j=1;j<=tot;j++)\n\t\t{\n\t\t\tint rev=id[bin[n]-1-sta[j]];\n\t\t\tif (i&bin[j-1]) t+=bin[rev-1];\n\t\t}\n\t\tg[t]=f[i];f[i]=0;\n\t}\n\ta[1]=4;a[2]=5;a[3]=6;\n\tdfs2(1,1,1);\n\tpre();\n\tint ans=0;\n\tfor (int i=0;i<bin[tot];i++)\n\t\t(ans+=(LL)f[i]*g[bin[tot]-1-i]%MOD)%=MOD;\n\tprintf(\"%d\\n\",(1-ans+MOD)%MOD);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef ksm(x, y):\n    ans = 1\n    while y:\n        if y & 1:\n            ans = (ans * x) % MOD\n        x = (x * x) % MOD\n        y >>= 1\n    return ans\n\ndef main():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    \n    n = int(input_data[idx]); idx += 1\n    \n    # Initialize arrays\n    p = [[0] * (n + 1) for _ in range(n + 1)]\n    ma = [[0] * (n + 1) for _ in range(n + 1)]\n    a = [0] * 7  # a[1], a[2], a[3] used\n    b = [0] * 7  # b[1], b[2], b[3] used\n    pts = [[0] * 7 for _ in range(26)]  # pts[M][N]\n    sta = [0] * 26  # sta[M]\n    id_map = [0] * 70  # id[70]\n    \n    # Precompute binomial coefficients\n    binomial = [1] * 21\n    for i in range(1, 21):\n        binomial[i] = binomial[i-1] * 2\n    \n    inv = ksm(100, MOD - 2)\n    \n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            p[i][j] = int(input_data[idx]); idx += 1\n            p[i][j] = (p[i][j] * inv) % MOD\n    \n    while n < 6:\n        n += 1\n        p[n][n] = 1\n    \n    # Initialize vis array\n    vis = [False] * 7  # vis[1..6]\n    \n    def get_match(x):\n        if x > 3:\n            return 1\n        for i in range(1, 4):\n            if not vis[i] and ma[a[x]][b[i]]:\n                vis[i] = 1\n                flag = get_match(x + 1)\n                vis[i] = 0\n                if flag:\n                    return 1\n        return 0\n    \n    def dfs2(x, y, pro):\n        if x > 3:\n            s = 0\n            for i in range(1, tot + 1):\n                for j in range(1, 4):\n                    b[j] = pts[i][j]\n                if get_match(1):\n                    s += binomial[i - 1]\n            f[s] = (f[s] + pro) % MOD\n            return\n        \n        # Case 1: ma[a[x]][y] = 0\n        ma[a[x]][y] = 0\n        if y == n:\n            dfs2(x + 1, 1, (pro * (1 - p[a[x]][y])) % MOD)\n        else:\n            dfs2(x, y + 1, (pro * (1 - p[a[x]][y])) % MOD)\n        \n        # Case 2: ma[a[x]][y] = 1\n        ma[a[x]][y] = 1\n        if y == n:\n            dfs2(x + 1, 1, (pro * p[a[x]][y]) % MOD)\n        else:\n            dfs2(x, y + 1, (pro * p[a[x]][y]) % MOD)\n    \n    def dfs1(x, y, s):\n        if y == 3:\n            id_map[s] = tot + 1\n            sta[tot + 1] = s\n            for i in range(1, 4):\n                pts[tot + 1][i] = a[i]\n            return tot + 1\n        \n        if x > n:\n            return 0\n        \n        # Skip x\n        result = dfs1(x + 1, y, s)\n        \n        # Take x\n        a[y + 1] = x\n        result = dfs1(x + 1, y + 1, s + binomial[x - 1])\n        return result\n    \n    # Initialize f and g arrays\n    f = [0] * (1 << 20)  # f[S]\n    g = [0] * (1 << 20)  # g[S]\n    \n    # First dfs1 call\n    tot = 0\n    dfs1(1, 0, 0)\n    \n    # Set initial values for a\n    a[1] = 1\n    a[2] = 2\n    a[3] = 3\n    dfs2(1, 1, 1)\n    \n    # Transform f to g\n    for i in range(binomial[tot]):\n        t = 0\n        for j in range(1, tot + 1):\n            rev = id_map[binomial[n] - 1 - sta[j]]\n            if i & binomial[j - 1]:\n                t += binomial[rev - 1]\n        g[t] = f[i]\n        f[i] = 0\n    \n    # Set new values for a\n    a[1] = 4\n    a[2] = 5\n    a[3] = 6\n    dfs2(1, 1, 1)\n    \n    # Precompute g\n    for i in range(tot):\n        for j in range(binomial[tot]):\n            if j & binomial[i]:\n                g[j] = (g[j] + g[j ^ binomial[i]]) % MOD\n    \n    # Calculate answer\n    ans = 0\n    for i in range(binomial[tot]):\n        ans = (ans + f[i] * g[binomial[tot] - 1 - i]) % MOD\n    \n    result = (1 - ans + MOD) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.000163541772053577, -8.344646857949556e-07, -7.152555099310121e-07, -0.040714606642723083, -0.00017808281700126827, -0.012525228783488274, -0.2536981403827667, -3.576278118089249e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -5.602820692729438e-06, 0.0, -3.576272320060525e-06, 0.0, -2.3841855067985307e-07, -1.2397689715726301e-05, -5.960462772236497e-07, -4.768370445162873e-07, -0.38687247037887573, -0.002369217574596405, -0.04633912444114685, -1.311301275563892e-06, -6.079655122448457e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -2.109982233378105e-05, -8.344646857949556e-07, -1.5020257706055418e-05, -1.1920928244535389e-07, 0.0, 0.0, -9.536738616588991e-07, -2.5510462364763953e-05, -0.0013469918631017208, -7.152555099310121e-07, -4.172316494077677e-06, 0.0, -1.1920928244535389e-07, -2.264974000354414e-06, -1.4305104514278355e-06, 0.0, 0.0, -2.3841855067985307e-07, -5.960462772236497e-07, -5.602820692729438e-