\n        if sb:\n            res += float(sb) / f\n        return res * (-1 if neg else 1)\n    \n    def nextIntArr(self, n):\n        return [self.nextInt() for _ in range(n)]\n    \n    def nextLongArr(self, n):\n        return [self.nextLong() for _ in range(n)]\n    \n    def close(self):\n        if hasattr(self.br, 'close'):\n            self.br.close()\n\ndef main():\n    sc = Scanner(sys.stdin)\n    n = sc.nextInt()\n    k = sc.nextLong()\n    \n    if k > n - 1:\n        print(0)\n        return\n    \n    fac = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = (fac[i - 1] * i) % mod\n    \n    pop = n - int(k)\n    ans = 0\n    for i in range(pop + 1):\n        notPop = (ncr(pop, i, fac) * pow_mod(pop - i, n, mod)) % mod\n        if i % 2 == 1:\n            notPop = (-notPop) % mod\n        ans = (ans + notPop) % mod\n    \n    ans = (ans * ncr(n, pop, fac)) % mod\n    if k != 0:\n        ans = (ans * 2) % mod\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.58813522325363e-05, -1.311301275563892e-06, -7.784063927829266e-05, -0.000666277133859694, -0.01708832010626793, -1.490105023549404e-05, -0.014268635772168636, -0.0025384367909282446, -0.3133547306060791, -0.04859970510005951, -0.0013994909822940826, -0.12273325771093369, -0.3873561918735504, -7.033323527139146e-06, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -1.1920922133867862e-06, -3.4570634852570947e-06, -9.775113539944869e-06, -2.0265558760002023e-06, -0.00043525759247131646, -6.198863957251888e-06, -5.602820692729438e-06, -0.0002548369811847806, -0.011974004097282887, -0.006766856648027897, -0.3816702961921692, -0.01815686747431755, -1.5497195136049413e-06, -1.1920928244535389e-07, -0.00026246439665555954, -0.1454380750656128, -0.003908258862793446, -2.9802276912960224e-06, -0.0027053682133555412, -5.960462772236497e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -0.001942534