       self.p[s] = 0\n        self.flow_a[s] = INF\n        q = deque()\n        q.append(s)\n        while q:\n            u = q.popleft()\n            self.inq[u] = 0\n            for ei in self.g[u]:\n                ee = self.e[ei]\n                if ee.cap > ee.flow and self.d[ee.to_] > self.d[u] + ee.cost:\n                    self.d[ee.to_] = self.d[u] + ee.cost\n                    self.p[ee.to_] = ei\n                    self.flow_a[ee.to_] = min(self.flow_a[u], ee.cap - ee.flow)\n                    if not self.inq[ee.to_]:\n                        q.append(ee.to_)\n                        self.inq[ee.to_] = 1\n        if self.d[t] == INF:\n            return False\n        flow_add = self.flow_a[t]\n        cost_add = self.d[t] * flow_add\n        # We'll return flow and cost to accumulate in minCost\n        u = t\n        while u != s:\n            ei = self.p[u]\n            self.e[ei].flow += flow_add\n            self.e[ei^1].flow -= flow_add\n            u = self.e[ei].from_\n        return flow_add, cost_add\n\n    def minCost(self, s, t):\n        flow = 0\n        cost = 0\n        while True:\n            ret = self.bellman(s, t)\n            if ret is False:\n                break\n            f, c = ret\n            flow += f\n            cost += c\n        return cost\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    a = [0] * (k+1)\n    for i in range(1, k+1):\n        a[i] = next(it)\n    startPoint = 0\n    endPoint = n * 100 + 1\n    solve = MCMF()\n    solve.Init(endPoint)\n    \n    for i in range(1, k+1):\n        solve.add(startPoint, 1 + (a[i]-1)*100, 1, 0)\n    \n    for i in range(1, n+1):\n        for j in range(1, 100):\n            p = (i-1) * 100\n            solve.add(p + j, p + j + 1, INF, c)\n    \n    for i in range(1, 101):\n        solve.add(i, endPoint, INF, 0)\n    \n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for i in range(1, 100):\n            p = (x-1) * 100 + i\n            pp = (y-1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d * (j*j - (j-1)*(j-1)) + c\n                solve.add(p, pp, 1, cost)\n        for i in range(1, 100):\n            p = (y-1) * 100 + i\n            pp = (x-1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d * (j*j - (j-1)*(j-1)) + c\n                solve.add(p, pp, 1, cost)\n    \n    result = solve.minCost(startPoint, endPoint)\n    sys.stdout.write(str(result) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.01988795096986e-05, 0.0, 0.0, -0.0009369035833515227, -0.000947622349485755, -4.768370445162873e-07, -0.0002146728802472353, -0.00043478095903992653, -8.344646857949556e-07, -3.576278118089249e-07, -5.960446742392378e-06, -0.003219661070033908, -0.09831841289997101, -2.3603161025675945e-05, -0.0005564333405345678, -0.018226636573672295, -0.018153706565499306, -1.1920922133867862e-06, -5.006716251373291, -3.93382906622719e-05, -0.011014141142368317, -0.003465125570073724, -0.8263203501701355, -6.6756979322235566e-06, -2.50339189733495e-06, -0.07893866300582886, 0.0, -2.3841855067985307e-07, -1.6689286894688848e-06, -7.033323527139146e-06, -0.006405062973499298, -0.05661756545305252, -0.7823443412780762, -1.1920928244535389e-07, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, -8.344646857949556e-07, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.2993727978027891e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -2.3841830625315197e-06, -0.5639833211898804, -0.12975943088531494, -3.576278118089249e-07, -0.8259425163269043, -2.3841855067985307e-07, -0.160257115960121