               }\n                if (dist[t] == Integer.MAX_VALUE) return -1;\n                for (int v = 0; v < V; v++) h[v] += dist[v];\n                int d = f;\n                for (int v = t; v != s; v = prevv[v])\n                    d = Math.min(d, G[prevv[v]].get(preve[v]).cap);\n                f -= d;\n                res += d * h[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = G[prevv[v]].get(preve[v]);\n                    e.cap -= d;\n                    G[v].get(e.rev).cap += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    static final int T = 100;\n    static MinCostFlow mcf = new MinCostFlow();\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] a = new int[k];\n        for (int i = 0; i < k; i++) {\n            a[i] = sc.nextInt();\n        }\n        int[] cnt = new int[n];\n        for (int i = 0; i < k; i++) {\n            cnt[a[i] - 1]++;\n        }\n        List<Integer>[] e = new ArrayList[n];\n        for (int i = 0; i < n; i++) e[i] = new ArrayList<>();\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            x--; y--;\n            e[x].add(y);\n            e[y].add(x);\n        }\n        mcf.init(n * T + 2);\n        int S = n * T;\n        int TARGET = n * T + 1;\n        for (int i = 0; i < n; i++) {\n            mcf.addEdge(S, i, cnt[i], 0);\n        }\n        for (int t = 0; t < T; t++) {\n            mcf.addEdge(t * n, TARGET, k, c * t);\n        }\n        for (int i = 0; i < n; i++) {\n            for (int t = 0; t < T - 1; t++) {\n                mcf.addEdge(t * n + i, (t + 1) * n + i, k, 0);\n            }\n            for (int to : e[i]) {\n                for (int t = 0;