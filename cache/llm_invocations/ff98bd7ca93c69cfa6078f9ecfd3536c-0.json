st[h])\n                        v = u ^ self.uv[h]\n                        if self.pi[v] > p:\n                            self.pi[v] = p\n                            self.dd[v] = self.dd[u] + 1\n                            self.bb[v] = h_\n                            updated = True\n            if not updated:\n                break\n        return self.pi[t] != self.INF\n\n    def push1(self, s, t):\n        u = t\n        while u != s:\n            h_ = self.bb[u]\n            h = h_ // 2\n            self.cc[h_] -= 1\n            self.cc[h_ ^ 1] += 1\n            u = u ^ self.uv[h]\n\n    def edmonds_karp(self, s, t):\n        while self.bellman_ford(s, t):\n            self.push1(s, t)\n        total = 0\n        for h in range(self.m_cnt):\n            total += self.cost[h] * self.cc[2*h+1]\n        return total\n\n    def main(self):\n        data = list(map(int, sys.stdin.buffer.read().split()))\n        it = iter(data)\n        n = next(it)\n        m = next(it)\n        k = next(it)\n        c = next(it)\n        d = next(it)\n        ii = [next(it)-1 for _ in range(k)]\n        aa = [[] for _ in range(n)]\n        for _ in range(m):\n            i = next(it)-1\n            j = next(it)-1\n            aa[i].append(j)\n            aa[j].append(i)\n        t = n + k + 1\n        self.n_ = n * t + 1\n        self.m_ = k + (m * 2 * k + n) * (t - 1)\n        self.init()\n        # add edges\n        for i in range(n):\n            adj = aa[i]\n            for s in range(t-1):\n                u = i * t + s\n                for j in adj:\n                    v = j * t + s + 1\n                    for x in range(1, k+1):\n                        self.link(u, v, 1, c + (2*x-1)*d)\n        for i in range(n):\n            for s in range(t-1):\n                u = i * t + s\n                v = u + 1\n                cap = k\n                cos = 0 if i == 0 else c\n                self.link(u, v, cap, cos)\n        for h in range(k):\n            self.link(self.n_