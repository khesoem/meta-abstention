n    static class MinCostFlow {\n        static class Edge {\n            int to, rev, cap, cost;\n            Edge(int to, int rev, int cap, int cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n\n        List<Edge>[] graph;\n        int[] dist, h, prevv, preve;\n        int node_cnt;\n\n        MinCostFlow(int n) {\n            this.node_cnt = n;\n            graph = new ArrayList[n];\n            for (int i = 0; i < n; i++) {\n                graph[i] = new ArrayList<>();\n            }\n            dist = new int[n];\n            h = new int[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void add_edge(int from, int to, int cap, int cost) {\n            graph[from].add(new Edge(to, graph[to].size(), cap, cost));\n            graph[to].add(new Edge(from, graph[from].size() - 1, 0, -cost));\n        }\n\n        int min_cost_flow(int s, int t, int flow_needed) {\n            int res = 0;\n            Arrays.fill(h, 0);\n            while (flow_needed > 0) {\n                Arrays.fill(dist, INF);\n                dist[s] = 0;\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                pq.offer(new int[]{0, s});\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int d = cur[0], u = cur[1];\n                    if (d > dist[u]) continue;\n                    for (int i = 0; i < graph[u].size(); i++) {\n                        Edge e = graph[u].get(i);\n                        if (e.cap > 0) {\n                            int nd = dist[u] + e.cost + h[u] - h[e.to];\n                            if (dist[e.to] > nd) {\n                                dist[e.to] = nd;\n                                prevv[e.to] = u;\n                                preve[e.to] = i;\n                                pq.offer(new int[]{nd, e.to});\n                            }\n                        }\n                    }\n                }\n                if (dist[t] == INF) return -1;\n\n                for (int v = 0; v < node_cnt; v++) {\n                    h[v] += dist[v];\n                }\n\n                int d = flow_needed;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, graph[prevv[v]].get(preve[v]).cap);\n                }\n                flow_needed -= d;\n                res += d * h[t];\n\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = graph[prevv[v]].get(preve[v]);\n                    e.cap -= d;\n                    graph[v].get(e.rev).cap += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] start = new int[k];\n        for (int i = 0; i < k; i++) {\n            start[i] = sc.nextInt() - 1;\n        }\n\n        List<List<Integer>> base_adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            base_adj.add(new ArrayList<>());\n        }\n        for (int i = 0; i < m; i++) {\n            int a = sc.nextInt() - 1;\n            int b = sc.nextInt() - 1;\n            base_adj.get(a).add(b);\n            base_adj.get(b).add(a);\n        }\n\n        int t = n + k + 1;\n        int N_total = n * t + 1;\n        MinCostFlow mcf = new MinCostFlow(N_total);\n\n        // edges for moving between nodes\n        for (int i = 0; i < n; i++) {\n            for (int s = 0; s < t - 1; s++) {\n                int u = i * t + s;\n                for (int j : base_adj.get(i)) {\n                    int v = j * t + s + 1;\n                    for (int x = 1; x <= k; x++) {\n                        mcf.add_edge(u, v, 1, c + (2 * x - 1) * d);\n                    }\n                }\n            }\n        }\n\n        // edges for staying in place\n        for (int i = 0; i < n; i++) {\n            for (int s = 0; s < t - 1; s++) {\n                int u = i * t + s;\n                int v = u + 1;\n                mcf.add_edge(u, v, k, (i == 0 ? 0 : c));\n            }\n        }\n\n        int source = N_total - 1;\n        for (int h = 0; h < k; h++) {\n            mcf.add_edge(source, start[h] * t, 1, 0);\n        }\n\n        int sink = 0 * t + t - 1; // node 0 at time t-1\n        System.out.println(mcf.min_cost_flow(source, sink, k));\n    }\n}\n```", "token_logprobs": [-0.7006610035896301, -1.0609570381348021e-05, -0.00018273114983458072, -9.500529267825186e-05, -1.1920928244535389e-07, -0.00043084874050691724, -0.03123082034289837, -0.02986971102654934, -3.576278118089249e-07, -0.252818763256073, -0.04860879108309746, -0.0009183242218568921, -0.02297182008624077, -0.011053991504013538, -1.0728830375228426e-06, -0.47408419847488403, -1.966933996300213e-05, -0.00318971648812294, 0.0, -2.145764938177308e-06, -0.0007352509419433773, 0.0, -2.861018856492592e-06, 0.0, 0.0, -0.00012373158824630082, -0.31341397762298584, 0.0, 0.0, -1.311301275563892e-06, -5.483612312673358e-06, 0.0, -1.1920922133867862e-06, 0.0, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -5.8412379075889476e-06, -1.1920928244535389e-07, -9.691245941212401e-05, -2.1457441107486375e-05, -1.1920928244535389e-07, -0.0031780709978193045, -1.9073304429184645e-05, -3.576278118089249e-07, -6.318072337307967e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.764281842042692e-05, -0.00043299360550008714, 0.0, -0.00015948931104503572, -3.3378546504536644e-06, -3.576278118089249e-07, -0.0009120118920691311, -4.768370445162873e-07, -1.1920928244535389e-07, -2.3841855067985307