at[idx(x0, y0, x1, y1, ptr)]\n    if ret != -1:\n        return ret == 1\n    if x0 == x1 and y0 == y1:\n        return dist[x0][y0] >= ptr\n    if dist[x0][y0] <= ptr:\n        memFlat[idx(x0, y0, x1, y1, ptr)] = 0\n        return False\n    for k in range(4):\n        nx = x0 + dx[k]\n        ny = y0 + dy[k]\n        if good(nx, ny) and canReach(nx, ny, x1, y1, ptr + 1):\n            memFlat[idx(x0, y0, x1, y1, ptr)] = 1\n            return True\n    memFlat[idx(x0, y0, x1, y1, ptr)] = 0\n    return False\n\ndef fml(s, t_node):\n    global par\n    par = [-1] * (2 * m + 2)\n    par[s] = -2\n    qu = deque()\n    qu.append(s)\n    while qu:\n        v = qu.popleft()\n        for i in range(s, t_node + 1):\n            if par[i] == -1 and cap[v][i] > 0:\n                par[i] = v\n                qu.append(i)\n    return par[t_node] != -1\n\ndef main():\n    global n, t, rx, ry, lab, sci, memFlat, cap, par, dist, vis, m\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    sci = [next(it) for _ in range(n)]\n    lab = [next(it) for _ in range(n)]\n\n    pos = []\n    lc = []\n    sc = []\n    for i in range(n):\n        for j in range(n):\n            if sci[i][j] == 'Z':\n                rx = i\n                ry = j\n            elif '0' <= sci[i][j] <= '9':\n                pos.append((i, j))\n                lc.append(ord(lab[i][j]) - ord('0'))\n                sc.append(ord(sci[i][j]) - ord('0'))\n\n    m = len(pos)\n    # cap size: 2*m+2 nodes (0 to 2*m+1)\n    cap = [[0] * (2 * m + 2) for _ in range(2 * m + 2)]\n    for i in range(m):\n        cap[0][i + 1] = sc[i]\n        cap[m + 1 + i][2 * m + 1] = lc[i]\n\n    pre()\n\n    # memFlat size: 12*12*12*12*62 (original constant)\n    memFlat = [-1] * (12 * 12 * 12 * 12 * 62)\n\n    for i in range(m):\n        for j in range(m):\n            if canReach(pos[i][0], pos[i][1], pos[j][0], pos[j][1], 0):\n                cap[i + 1][m + 1 + j] = 1000\n\n    flow = 0\n    while fml(0, 2 * m + 1):\n        cur = 2 * m + 1\n        nflow = 1000000\n        while par[cur] >= 0:\n            nflow = min(nflow, cap[par[cur]][cur])\n            cur = par[cur]\n        cur = 2 * m + 1\n        while par[cur] >= 0:\n            cap[par[cur]][cur] -= nflow\n            cap[cur][par[cur]] += nflow\n            cur = par[cur]\n        flow += nflow\n\n    print(flow)\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(10000)\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, -9.65590606938349e-06, -0.003974278457462788, 0.0, 0.0, -3.576278118089249e-07, -0.005237074103206396, -0.9226434230804443, -0.5057739019393921, -0.0633450597524643, -0.5553263425827026, -1.2603182792663574, -0.015732455998659134, -0.2841475009918213, -0.4279959797859192, -0.04878977686166763, -0.008874380961060524, -0.014502003788948059, 0.0, -1.2516897186287679e-05, -1.6689286894688848e-06, -2.396077979938127e-05, -3.576278118089249e-07, -2.145764938177308e-06, -1.1920928244535389e-07, -5.006777428206988e-06, -7.486063259420916e-05, -0.019052477553486824, -2.3841855067985307e-07, -7.629365427419543e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.5497195136049413e-06, -7.510157047363464e-06, -1.3232143828645349e-05, -0.0024279658682644367, -5.960462772236497e-07, 0.0, -2.109982233378105e-05, -0.0015085280174389482, -0.009839368052780628, -0.0024807651061564684, -0.000163541772053577, -0.03142375871539116, -0.00013445904187392443, -8.344646857949556e-07, -0.01200050674378872, -0.0005703729693777859, -1.1920928244535389e-07, -0.0008945039589889348, -5.602820692729438e-06, -4.887569048150908e-06, -0.0024855216033756733, -1.8596476365928538e-05, -2.3841855067985307e-07, -0.07890109717845917, -0.32408687472343445, -4.0531076592742465e-06, -4.541770613286644e-05, -9.536738616588991e-07, 0.0, -0.0004312062228564173, -2.50339189733495e-06, -1.1920928244535389e-07, -1.0