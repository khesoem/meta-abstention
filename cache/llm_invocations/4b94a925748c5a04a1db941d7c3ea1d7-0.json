0] = (a[i][0] + cur[0]) % mod;\n                    a[i][1] = (a[i][1] + cur[1]) % mod;\n                }\n            }\n\n            // Initialize d array\n            for (int i = 0; i <= n + 1; i++) {\n                for (int j = 0; j <= m; j++) {\n                    d[i][j][0] = 0;\n                    d[i][j][1] = 0;\n                }\n            }\n            d[0][0][0] = 1;\n            d[0][0][1] = 0;\n\n            for (int i = 0; i <= n + 1; i++) {\n                for (int j = 0; j <= m; j++) {\n                    int maxK = Math.min(n - i, m - j);\n                    for (int k = 0; k <= maxK; k++) {\n                        long[] cur = new long[2];\n                        cur[0] = (a[k][0] * d[i][j][0]) % mod;\n                        cur[1] = ((a[k][1] * d[i][j][0]) % mod + (a[k][0] * d[i][j][1]) % mod) % mod;\n                        cur[0] = (cur[0] * c[j][k]) % mod;\n                        cur[1] = (cur[1] * c[j][k]) % mod;\n                        d[i + k + 1][j + k][0] = (d[i + k + 1][j + k][0] + cur[0]) % mod;\n                        d[i + k + 1][j + k][1] = (d[i + k + 1][j + k][1] + cur[1]) % mod;\n                    }\n                }\n            }\n            ans = d[n + 1][m][1];\n        }\n\n        void write() {\n            System.out.println(ans);\n        }\n\n        void clear() {\n            mod = 0;\n            n = 0;\n            m = 0;\n            ans = 0;\n            for (int i = 0; i <= N; i++) {\n                for (int j = 0; j <= N; j++) {\n                    c[i][j] = 0;\n                }\n            }\n            for (int i = 0; i <= N; i++) {\n                a[i][0] = 0;\n                a[i][1] = 0;\n            }\n            for (int i = 0; i <= N + 1; i++) {\n                for (int j = 0; j <= N; j++) {\n                    d[i][j][0] = 0;\n                    d[i][j][1] = 0;\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Solu