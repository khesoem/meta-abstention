r<int>(N, -1));\n    vector<vector<int>> d2(N, vector<int>(N, -1));\n    d1[r][c] = 0;\n    d2[sx][sy] = 0;\n\n    while (!q1r.empty()) {\n        int sz = q1r.size();\n        for (int i = 0; i < sz; ++i) {\n            int ur = q1r.front(); q1r.pop();\n            int uc = q1c.front(); q1c.pop();\n            if (d2[ur][uc] >= 0) continue;\n            for (int k = 0; k < 4; ++k) {\n                int nr = ur + dr[k], nc = uc + dc[k];\n                if (valid(nr, nc) && d1[nr][nc] == -1) {\n                    d1[nr][nc] = d1[ur][uc] + 1;\n                    if (d1[nr][nc] > T) break;\n                    if (d2[nr][nc] >= 0) continue;\n                    q1r.push(nr); q1c.push(nc);\n                    if (B[nr][nc] != '0') {\n                        add_edge(id[sr][sc], id[nr][nc] + node_cnt, 10);\n                    }\n                }\n            }\n        }\n\n        sz = q2r.size();\n        for (int i = 0; i < sz; ++i) {\n            int ur = q2r.front(); q2r.pop();\n            int uc = q2c.front(); q2c.pop();\n            for (int k = 0; k < 4; ++k) {\n                int nr = ur + dr[k], nc = uc + dc[k];\n                if (valid(nr, nc) && d2[nr][nc] == -1) {\n                    d2[nr][nc] = d2[ur][uc] + 1;\n                    q2r.push(nr); q2c.push(nc);\n                }\n            }\n        }\n    }\n}\n\nbool build_level() {\n    memset(level, -1, sizeof(level));\n    queue<int> q;\n    q.push(0);\n    level[0] = 0;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (const auto& e : g[u]) {\n            if (e.cap > 0 && level[e.to] == -1) {\n                level[e.to] = level[u] + 1;\n                q.push(e.to);\n            }\n        }\n    }\n    return level[2 * node_cnt + 1] != -1;\n}\n\nint dfs(int u, int flow) {\n    if (u == 2 * node_cnt + 1) return flow;\n    for (int& i = iter[u]; i < g[u].size(); ++i) {\n        Edge& e = g[u][i];\n        if (e.cap > 0 && level[e.to] == level[u] + 1) {\n       