el = [-1] * 500\n    iter_ = [0] * 500\n    \n    def add_edge(u, v, c):\n        g[u].append([v, c, len(g[v])])\n        g[v].append([u, 0, len(g[u]) - 1])\n    \n    dr = [0, 0, 1, -1]\n    dc = [1, -1, 0, 0]\n    \n    def bfs(r, c):\n        nonlocal node_cnt, sx, sy\n        if B[r][c] != '0':\n            add_edge(id[r][c] + node_cnt, 2 * node_cnt + 1, ord(B[r][c]) - ord('0'))\n        if A[r][c] == '0':\n            return\n        \n        add_edge(0, id[r][c], ord(A[r][c]) - ord('0'))\n        if B[r][c] != '0':\n            add_edge(id[r][c], id[r][c] + node_cnt, 10)\n        \n        sr, sc = r, c\n        q1r, q1c = deque(), deque()\n        q2r, q2c = deque(), deque()\n        q1r.append(r); q1c.append(c)\n        q2r.append(sx); q2c.append(sy)\n        \n        d1 = [[-1] * N for _ in range(N)]\n        d2 = [[-1] * N for _ in range(N)]\n        d1[r][c] = 0\n        d2[sx][sy] = 0\n        \n        while q1r:\n            sz = len(q1r)\n            for _ in range(sz):\n                ur, uc = q1r.popleft(), q1c.popleft()\n                if d2[ur][uc] >= 0:\n                    continue\n                for k in range(4):\n                    nr, nc = ur + dr[k], uc + dc[k]\n                    if valid(nr, nc) and d1[nr][nc] == -1:\n                        d1[nr][nc] = d1[ur][uc] + 1\n                        if d1[nr][nc] > T:\n                            break\n                        if d2[nr][nc] >= 0:\n                            continue\n                        q1r.append(nr); q1c.append(nc)\n                        if B[nr][nc] != '0':\n                            add_edge(id[sr][sc], id[nr][nc] + node_cnt, 10)\n            \n            sz = len(q2r)\n            for _ in range(sz):\n                ur, uc = q2r.popleft(), q2c.popleft()\n                for k in range(4):\n                    nr, nc = ur + dr[k], uc + dc[k]\n                    if valid(nr, nc) and d2[nr][nc] == -1:\n                        d2[nr][nc] = d2[ur][uc] + 1\n                        q2r.append(nr); q2c.append(nc)\n    \n    def build_level():\n        nonlocal level\n        level = [-1] * 500\n        q = deque()\n        q.append(0)\n        level[0] = 0\n        while q:\n            u = q.popleft()\n            for e in g[u]:\n                if e[1] > 0 and level[e[0]] == -1:\n                    level[e[0]] = level[u] + 1\n                    q.append(e[0])\n        return level[2 * node_cnt + 1] != -1\n    \n    def dfs(u, flow):\n        if u == 2 * node_cnt + 1:\n            return flow\n        for i in range(iter_[u], len(g[u])):\n            iter_[u] = i\n            e = g[u][i]\n            if e[1] > 0 and level[e[0]] == level[u] + 1:\n                pushed = dfs(e[0], min(flow, e[1]))\n                if pushed > 0:\n                    e[1] -= pushed\n                    g[e[0]][e[2]][1] += pushed\n                    return pushed\n        return 0\n    \n    def max_flow():\n        result = 0\n        while build_level():\n            iter_ = [0] * 500\n            pushed = dfs(0, INF)\n            while pushed > 0:\n                result += pushed\n                pushed = dfs(0, INF)\n        return result\n    \n    # Initialize id and node_cnt\n    for i in range(N):\n        for j in range(N):\n            if A[i][j] == 'Z':\n                sx, sy = i, j\n            elif valid(i, j):\n                id[i][j] = node_cnt\n                node_cnt += 1\n    \n    for i in range(N):\n        for j in range(N):\n            if valid(i, j):\n                bfs(i, j)\n    \n    print(max_flow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001102625101339072, -1.311301275563892e-06, -1.1920928244535389e-07, -0.030110225081443787, -0.0013161577517166734, -2.3841855067985307e-07, -4.7444173105759546e-05, -0.00021765247220173478, -8.344646857949556e-07, -0.00034600470098666847, -0.0059431265108287334, -0.25779983401298523, -0