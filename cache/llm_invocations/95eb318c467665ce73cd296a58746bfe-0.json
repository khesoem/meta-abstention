ic long[] reorder(long[] arr, int k) {\n        long[] res = new long[arr.length];\n        for (int i = 0; i < arr.length; i++) {\n            res[bitReverse(i, k)] = arr[i];\n        }\n        return res;\n    }\n\n    private static long[] transform(long[] coef, int k, boolean inverse) {\n        coef = reorder(coef, k);\n        long[] roots = calcRoots(k, inverse);\n        for (int s = 0; s < k; s++) {\n            int len = 1 << s;\n            for (int st = 0; st < coef.length; st += 2 * len) {\n                long curRoot = 1;\n                for (int j = st; j < st + len; j++) {\n                    long t = (curRoot * coef[j + len]) % MOD;\n                    long u = coef[j];\n                    coef[j] = (u + t) % MOD;\n                    coef[j + len] = ((u - t) % MOD + MOD) % MOD;\n                    curRoot = (roots[s] * curRoot) % MOD;\n                }\n            }\n        }\n        return coef;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt() / 2;\n        int m = sc.nextInt();\n        int[] nums = new int[m];\n        int max = 0;\n        for (int i = 0; i < m; i++) {\n            nums[i] = sc.nextInt();\n            if (nums[i] > max) max = nums[i];\n        }\n        int minSize = n * max + 1;\n        int k = 0, size = 1;\n        while (size < minSize) {\n            size <<= 1;\n            k++;\n        }\n        long[] a = new long[size];\n        for (int num : nums) a[num] = 1;\n        a = transform(a, k, false);\n        for (int i = 0; i < size; i++) a[i] = modPow(a[i], n);\n        a = transform(a, k, true);\n        long ans = 0;\n        for (int i = 0; i < size; i++) ans = (ans + a[i] * a[i]) % MOD;\n        long invSize = modInverse(size);\n        System.out.println((ans * invSize % MOD) * invSize % MOD);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {