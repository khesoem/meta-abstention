         return dis[t] != -1;\n        }\n\n        long dfs(int pos, long flow) {\n            if (pos == t) return flow;\n            vis[pos] = true;\n            long tmp = flow;\n            for (int i = cur[pos] != -1 ? cur[pos] : head[pos]; i != -1; i = nxt[i]) {\n                if (!vis[v[i]] && w[i] > 0 && dis[v[i]] == dis[pos] + c[i]) {\n                    cur[pos] = i;\n                    long fl = dfs(v[i], Math.min(flow, w[i]));\n                    cost += fl * c[i];\n                    w[i] -= fl;\n                    w[i ^ 1] += fl;\n                    flow -= fl;\n                    if (flow == 0) break;\n                }\n            }\n            return tmp - flow;\n        }\n\n        void add_edge(int uu, int vv, long ww, int cc) {\n            padd_edge(uu, vv, ww, cc);\n            padd_edge(vv, uu, 0, -cc);\n        }\n\n        long dinic(int s, int t) {\n            this.t = t;\n            cost = 0;\n            while (spfa(s, t)) {\n                Arrays.fill(cur, -1);\n                dfs(s, INF);\n            }\n            return cost;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int kk = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] a = new int[kk + 1];\n        for (int i = 1; i <= kk; i++) {\n            a[i] = sc.nextInt();\n        }\n        int s = 0;\n        int t = n * 100 + 1;\n        FlowGraph g = new FlowGraph();\n        for (int i = 1; i <= 100; i++) {\n            g.add_edge(i, t, INF, 0);\n        }\n        for (int i = 1; i <= kk; i++) {\n            g.add_edge(s, (a[i] - 1) * 100 + 1, 1, 0);\n        }\n        for (int i = 2; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                g.add_edge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, INF, c);\n            }\n        }\n        for (int _ = 0; _ < m; _++) {\n            int t1 = sc.nextInt();\n            int t2 = sc.nextInt();\n            for (int i = 1; i < 100; i++) {\n                int val = c + d * (i * i - (i - 1) * (i - 1));\n                g.add_edge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val);\n                g.add_edge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val);\n            }\n        }\n        System.out.println(g.dinic(s, t));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.34114232659339905, -9.794061770662665e-05, -1.6240566083070007e-06, -9.209963900502771e-05, -2.1008713702030946e-06, -3.128163257315464e-07, -0.003625008510425687, -0.4564530551433563, -0.16023173928260803, -4.320199877838604e-07, -0.3503783941268921, -9.729906196298543e-06, -0.029756393283605576, -0.049469076097011566, -0.005156908184289932, -0.1288282424211502, -0.20239703357219696, -0.0011705794604495168, -0.0028233008924871683, -1.4617256056226324e-05, -5.512236498361744e-07, -2.45848218582978e-06, -7.896309739408025e-07, -0.10246961563825607, -4.320199877838604e-07, -1.981667537620524e-06, -0.00018923594325315207, -0.0021857109386473894, -0.0002205828350270167, -3.4121114822482923e-06, -6.704273118884885e-07, -2.463036435074173e-05, -6.704273118884885e-07, -1.747814349073451e-05, -0.0005872295005246997, -2.935296834039036e-06, -2.546478935983032e-05, -0.0019388694781810045, -3.4121114822482923e-06, -0.28199589252471924, -8.180258191714529e-06, -1.4855663721391466e-05, -1.0802738870552275e-05, -4.60414821645827e-06, -0.005794051103293896, -1.1472419600977446e-06, -1.7432603272027336e-06, -0.12719205021858215, -7.465036105713807e-06, -0.006729934364557266, -3.650518920039758e-06, -0.20236413180828094, -0.0003020961594302207, -0.0002383441897109151, -7.896309739408025e-07, -0.020574938505887985, -0.0003993296413682401, -7.822646693966817e-06, -0.0026289233937859535, -1.0280383548888494e-06, -1.9361264946837764e-07, -3.8889261304575484e-06, -0.049646