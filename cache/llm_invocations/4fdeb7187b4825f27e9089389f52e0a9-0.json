f recursive_solve(num, v, level, expE, invE, k):\n    if num == 0:\n        return v\n    w = digit_sum_mod(num // k, k)\n    v = recursive_solve(num // k, v, level + 1, expE, invE, k)\n    for i in range(num % k):\n        v = multiply_matrix_vector(expE[level][(w + i) % k], v, k)\n    return v\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    \n    # Initialize baseM and invM\n    baseM = [[[0]*k for _ in range(k)] for _ in range(k)]\n    invM = [[[0]*k for _ in range(k)] for _ in range(k)]\n    \n    for i in range(k):\n        for j in range(k):\n            for l in range(k):\n                if j == l:\n                    baseM[i][j][l] = 1\n                    invM[i][j][l] = 1\n                elif j == i:\n                    baseM[i][j][l] = 1\n                    invM[i][j][l] = -1\n                else:\n                    baseM[i][j][l] = 0\n                    invM[i][j][l] = 0\n    \n    current = [1] * k\n    \n    expE, invE, depth = preprocess(baseM, invM, k, n)\n    current = recursive_solve(n, current, 0, expE, invE, k)\n    \n    total = 0\n    for i in range(k):\n        total = (total + current[i]) % MOD\n    total = ((total - 1) % MOD + MOD) % MOD\n    \n    while total % (k - 1) != 0:\n        total = (total + MOD) % (MOD * (k - 1))\n    \n    print(total // (k - 1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-9.202533692587167e-05, -9.536738616588991e-07, -2.3841855067985307e-07, -0.08785662055015564, -9.881961887003854e-05, -0.2811705470085144, -0.15523765981197357, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, 0.0, -0.00671901972964406, 0.0, -4.172316494077677e-06, 0.0, 0.0, 0.0, 0.0, -1.6689160474925302e-05, -3.58813522325363e-05, -0.34916922450065613, -0.020361684262752533, -1.2755313036905136e-05, -4.410734163684538e-06, -8.940656698541716e-06, -0.0004337085410952568