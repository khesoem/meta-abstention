1, n-1); }\nint main(){\n    cin>>m>>n>>mod;\n    init(m<<1);\n    f.resize(n+1);\n    g.resize(n+1);\n    f[0]=1;\n    for(int i=1; i<=n; i++){\n        int sum=0;\n        for(int j=0; j<i; j++){\n            add(sum, 1LL*f[j]*f[i-1-j]%mod*C(i-1,j)%mod);\n        }\n        f[i] = 1LL*sum*(i+1)%mod;\n    }\n    for(int i=1; i<=n; i++){\n        int sum=0;\n        for(int j=0; j<i; j++){\n            int term = (2LL*f[j]*g[i-1-j]%mod*C(i-1,j)%mod*(i+1)%mod + 1LL*C(i-1,j)*(S(j)+S(i-1-j))%mod*f[j]%mod*f[i-1-j]%mod)%mod;\n            add(sum, term);\n        }\n        g[i] = sum;\n    }\n    f[0]=0;\n    for(int i=0; i<=n; i++){ g[i]=1LL*g[i]*inv[i]%mod; f[i]=1LL*f[i]*inv[i]%mod; }\n    int ans=0;\n    int limit = m-n+1;\n    for(int i=1; i<=limit; i++){\n        add(ans, 1LL*g[n]*G(i+1, m-n-i+1)%mod*jc[n]%mod*i%mod);\n        g = g*f;\n        g.resize(n+1);\n    }\n    cout<<ans;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    m = int(data[0])\n    n = int(data[1])\n    mod = int(data[2])\n\n    # fast exponentiation\n    def ksm(x, k):\n        ans = 1\n        while k:\n            if k & 1:\n                ans = ans * x % mod\n            x = x * x % mod\n            k >>= 1\n        return ans\n\n    # precompute factorials and inverse factorials up to 2*m\n    limit_fact = m << 1\n    jc = [0] * (limit_fact + 1)\n    inv = [0] * (limit_fact + 1)\n    jc[0] = 1\n    for i in range(1, limit_fact + 1):\n        jc[i] = jc[i-1] * i % mod\n    inv[limit_fact] = ksm(jc[limit_fact], mod - 2)\n    for i in range(limit_fact - 1, -1, -1):\n        inv[i] = inv[i+1] * (i+1) % mod\n\n    def C(n, m):\n        if n < 0 or m < 0 or n < m:\n            return 0\n        return jc[n] * inv[n-m] % mod * inv[m] % mod\n\n    def S(n)