      fc[i][j] = vb[i]\n    for i in range(LOG):\n        transform(fc[i], n, p, 1)\n    res = [0] * n\n    for j in range(n):\n        pc = j.bit_count()\n        if pc < LOG:\n            res[j] = fc[pc][j]\n    return res\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    nn = n\n    f = [0] * (n + 1)\n    for i in range(n + 1):\n        if (n & i) == i:\n            t = 0\n            for j in range(20):\n                if (n >> j) & 1:\n                    t <<= 1\n                    t |= (i >> j) & 1\n            f[t] = i\n            nn = t\n    if n & 1:\n        print(fpow(k, n, p))\n        return\n    fac = [1] * MAXN\n    for i in range(1, MAXN):\n        fac[i] = mult(fac[i - 1], i, p)\n    ifac = [0] * MAXN\n    for i in range(MAXN):\n        ifac[i] = inv(fac[i], p)\n    a = [0] * (nn + 1)\n    for i in range(nn + 1):\n        a[i] = ifac[f[i]]\n    res = fpow(k, n, p)\n    a = subset_pow_convol(a, k, p)\n    res = submod(res, mult(a[nn], fac[n], p), p)\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-1.0728830375228426e-06, -2.3841855067985307e-07, 0.0, -0.000129691296024248, -0.0009215399040840566, -8.344646857949556e-07, -0.0011187491472810507, -0.16023121774196625, -0.008617713116109371, 0.0, 0.0, -0.07899241894483566, -0.7074751853942871, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -0.01166240032762289, -0.0015066235791891813, -5.340433563105762e-05, -7.152555099310121e-07, -1.1920922133867862e-06, -3.373566141817719e-05, -5.960462772236497e-07, -1.0013530300057027e-05, -0.00557570019736886, -0.026363147422671318, -0.26399239897727966, 0.0, -0.0007401349139399827, -0.0003361137059982866, 0.0, -1.1920928244535389e-07, -0.0015216212486848235, -8.22540732769994e-06, -1.1920928244535389e-07, -0.0018587708473205566, -4.768370445162873e-07, 0.0, 0.0