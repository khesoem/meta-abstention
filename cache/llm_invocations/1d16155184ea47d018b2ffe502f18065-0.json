   return level[sink] != -1;\n    }\n    \n    ll dfs(int u, ll f) {\n        if (u == sink) return f;\n        for (int &i = ptr[u]; i < (int)adj[u].size(); ++i) {\n            Edge &e = adj[u][i];\n            if (e.cap > 0 && level[e.to] == level[u] + 1) {\n                ll pushed = dfs(e.to, min(f, e.cap));\n                if (pushed > 0) {\n                    e.cap -= pushed;\n                    adj[e.to][e.rev].cap += pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n    \n    ll dinic() {\n        ll total = 0;\n        while (bfs()) {\n            fill(ptr.begin(), ptr.end(), 0);\n            ll pushed;\n            while ((pushed = dfs(source, 1LL << 60)) > 0) {\n                total += pushed;\n            }\n        }\n        return total;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, T;\n    cin >> n >> T;\n    \n    vector<string> grid(n);\n    int zy = -1, zx = -1;\n    for (int i = 0; i < n; ++i) {\n        cin >> grid[i];\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] == 'Z') {\n                zy = i; zx = j;\n            }\n        }\n    }\n    \n    string dummy;\n    getline(cin, dummy);\n    getline(cin, dummy);\n    \n    vector<string> exits(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> exits[i];\n    }\n    \n    vector<vector<int>> dist(n, vector<int>(n, -1));\n    queue<pair<int, int>> q;\n    q.push({zy, zx});\n    dist[zy][zx] = 0;\n    \n    const int dy[] = {1, -1, 0, 0};\n    const int dx[] = {0, 0, 1, -1};\n    \n    while (!q.empty()) {\n        auto [y, x] = q.front(); q.pop();\n        for (int d = 0; d < 4; ++d) {\n            int ny = y + dy[d], nx = x + dx[d];\n            if (ny < 0 || ny >= n || nx < 0 || nx >= n) continue;\n            if (dist[ny][nx] != -1 || grid[ny][nx] == 'Y') continue;\n            dist[ny][nx] = dist[y][x] + 1;\n            if (dist[ny][nx] < T) {\n                q.push({ny, nx});\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '0' && grid[i][j] <= '9') {\n                if (dist[i][j] == -1) dist[i][j] = T;\n                else dist[i][j] = min(dist[i][j], T);\n            }\n        }\n    }\n    \n    vector<vector<int>> nodeId(n, vector<int>(n, -1));\n    int nodeCount = 0;\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '0' && grid[i][j] <= '9') {\n                nodeId[i][j] = nodeCount++;\n            }\n            if (exits[i][j] >= '1' && exits[i][j] <= '9') {\n                nodeId[i][j] = nodeCount++;\n            }\n        }\n    }\n    \n    int src = 0, dst = nodeCount + 1;\n    FlowNetwork flow(nodeCount + 2, src, dst);\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '1' && grid[i][j] <= '9') {\n                flow.addEdge(src, nodeId[i][j], grid[i][j] - '0');\n            }\n            \n            if (exits[i][j] >= '1' && exits[i][j] <= '9') {\n                flow.addEdge(nodeId[i][j], dst, exits[i][j] - '0');\n            }\n            \n            for (int d = 0; d < 4; ++d) {\n                int ni = i + dy[d], nj = j + dx[d];\n                if (ni < 0 || ni >= n || nj < 0 || nj >= n) continue;\n                if (grid[ni][nj] == 'Y' || grid[ni][nj] == 'Z') continue;\n                \n                if (nodeId[i][j] != -1 && nodeId[ni][nj] != -1) {\n                    flow.addEdge(nodeId[i][j], nodeId[ni][nj], 1000000000);\n                }\n            }\n        }\n    }\n    \n    cout << flow.dinic() << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass FlowNetwork:\n    class Edge:\n        __slots__ = ('to', 'rev', 'cap')\n        \n        def __init__(self, to, rev, cap):\n            self.to = to\n            self.rev = rev\n            self.cap = cap\n    \n    def __init__(self, nodes, s, t):\n        self.V = nodes\n        self.adj = [[] for _ in range(nodes)]\n        self.level = [-1] * nodes\n        self.ptr = [0] * nodes\n        self.source = s\n        self.sink = t\n    \n    def addEdge(self, u, v, c):\n        self.adj[u].append(self.Edge(v, len(self.adj[v]), c))\n        self.adj[v].append(self.Edge(u, len(self.adj[u]) - 1, 0))\n    \n    def bfs(self):\n        self.level = [-1] * self.V\n        q = deque()\n        q.append(self.source)\n        self.level[self.source] = 0\n        while q:\n            u = q.popleft()\n            for e in self.adj[u]:\n                if e.cap > 0 and self.level[e.to] == -1:\n                    self.level[e.to] = self.level[u] + 1\n                    q.append(e.to)\n        return self.level[self.sink] != -1\n    \n    def dfs(self, u, f):\n        if u == self.sink:\n            return f\n        while self.ptr[u] < len(self.adj[u]):\n            e = self.adj[u][self.ptr[u]]\n            if e.cap > 0 and self.level[e.to] == self.level[u] + 1:\n                pushed = self.dfs(e.to, min(f, e.cap))\n                if pushed > 0:\n                    e.cap -= pushed\n                    self.adj[e.to][e.rev].cap += pushed\n                    return pushed\n            self.ptr[u] += 1\n        return 0\n    \n    def dinic(self):\n        total = 0\n        while self.bfs():\n            self.ptr = [0] * self.V\n            pushed = self.dfs(self.source, 1 << 60)\n            while pushed > 0:\n                total += pushed\n                pushed = self.dfs(self.source, 1 << 60)\n        return total\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    if not data:\n        return\n    \n    n, T = map(int, data[0].split())