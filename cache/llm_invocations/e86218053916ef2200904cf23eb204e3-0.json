rintln(fact[n]);\n            return;\n        }\n        if (n <= k) {\n            System.out.println(0);\n            return;\n        }\n        long base = C(n, (int)k);\n        int m = n - (int)k;\n        long total = 0;\n        for (int i = 0; i <= m; i++) {\n            long term = C(m, i) * pow(m - i, n) % MOD;\n            if ((i & 1) == 1) {\n                total = (total - term + MOD) % MOD;\n            } else {\n                total = (total + term) % MOD;\n            }\n        }\n        long ans = base * total % MOD;\n        ans = ans * 2 % MOD;\n        System.out.println(ans);\n    }\n\n    public static void main(String[] args) {\n        run();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\nusing namespace std;\n\nstatic const long long MOD = 998244353LL;\nstatic const int MAX = 400010;\nvector<long long> fact;\nvector<long long> invFact;\n\nlong long modPow(long long b, long long e) {\n    long long res = 1;\n    b %= MOD;\n    while (e > 0) {\n        if ((e & 1) == 1) res = (res * b) % MOD;\n        b = (b * b) % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nvoid setup() {\n    fact.resize(MAX);\n    invFact.resize(MAX);\n    fact[0] = 1;\n    invFact[0] = 1;\n    for (int i = 1; i < MAX; i++) {\n        fact[i] = fact[i-1] * i % MOD;\n        invFact[i] = modPow(fact[i], MOD - 2);\n    }\n}\n\nlong long C(int n, int r) {\n    if (r < 0 || r > n) return 0;\n    return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n}\n\nint main() {\n    setup();\n    int n;\n    long long k;\n    cin >> n >> k;\n    \n    if (k == 0) {\n        cout << fact[n] << endl;\n        return 0;\n    }\n    \n    if (n <= (int)k) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    long long base = C(n, (int)k);\n    int m = n - (int)k;\n    long long total = 0;\n    \n  