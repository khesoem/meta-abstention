u)\n                for (Edge &e : adj[u])\n                    if (e.cap > 0 && rcost(e) < 0)\n                        potential[e.dst] += rcost(e);\n    }\n\n    cost_type dijkstra(int s, int t)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> node;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        pq.push({dist[s] = 0, s});\n        while (!pq.empty())\n        {\n            node p = pq.top(); pq.pop();\n            if (dist[p.second] < p.first) continue;\n            if (p.second == t) break;\n            for (Edge &e : adj[p.second])\n                if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({dist[e.dst] = dist[e.src] + rcost(e), e.dst});\n                }\n        }\n        return dist[t];\n    }\n\n    pair<flow_type, cost_type> max_flow(int s, int t)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (Edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        back.assign(n, nullptr);\n        bellman_ford(s);\n        while (dijkstra(s, t) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n                if (dist[u] < dist[t])\n                    potential[u] += dist[u] - dist[t];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (Edge *e = back[t]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (Edge *e = back[t]; e; e = back[e->src])\n            {\n                e->flow += f;\n                adj[e->dst][e->rev].flow -= f;\n            }\n            flow += f;\n            cost += f * (potential[t] - potential[s]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n    int n, m, k, c, d, u, v;\n    cin >> n >> m >> k