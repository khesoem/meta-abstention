ct[0] = 1;\n        for (int i = 1; i <= l; i++) {\n            fact[i] = (int)((long)i * fact[i - 1] % mod);\n        }\n\n        long ans;\n        if (n <= 3) {\n            ans = 0;\n        } else {\n            int[] dp = new int[2000];\n            dp[0] = 1;\n            dp[1] = 2;\n            dp[2] = 2;\n            dp[3] = 1;\n\n            size = 1;\n            while (size < 2005) {\n                size <<= 1;\n            }\n            tree = new int[size * 2];\n\n            buildTree(dp, 4);\n\n            int m = 3;\n            ans = 0;\n\n            for (int i = 0; i < n - 3; i++) {\n                int[] dp0 = Arrays.copyOf(dp, dp.length);\n                long ans0 = 0;\n\n                for (int j = 0; j <= i + 3 - 1; j++) {\n                    for (int k = 1; k <= m + 1; k++) {\n                        long sumVal = getSum(j + k + 1, 2004);\n                        ans0 += sumVal * dp0[k - 1] % mod;\n                        ans0 %= mod;\n                        dp[j + k] = (dp[j + k] + dp0[k - 1]) % mod;\n                        update(j + k, dp[j + k]);\n                    }\n                }\n                m += i + 3;\n                long temp = f(i + 4, n);\n                ans += temp * ans0 % mod;\n                ans %= mod;\n            }\n        }\n        System.out.println(ans);\n    }\n\n    static int[] makeTree(int n) {\n        int size = 1;\n        while (size < n * 2) {\n            size <<= 1;\n        }\n        return new int[size];\n    }\n\n    static void buildTree(int[] array, int length) {\n        int n = tree.length;\n        for (int i = 0; i < length; i++) {\n            tree[n / 2 + i] = array[i];\n        }\n        for (int i = n / 2 - 1; i > 0; i--) {\n            tree[i] = (tree[i * 2] + tree[i * 2 + 1]) % mod;\n        }\n    }\n\n    static void update(int i, int x) {\n        int index = size / 2 + i;\n        tree[index] = x;\n        index /= 2;\n        while (index > 0) {\n            tree[index] = (tree[index * 2] + tree[index * 2 + 1]) % mod;\n            index /= 2;\n        }\n    }\n\n    static long getSum(int s, int t) {\n        int left = size / 2 + s;\n        int right = size / 2 + t;\n        long result = 0;\n        while (left <= right) {\n            if ((left & 1) == 1) {\n                result += tree[left];\n                left++;\n            }\n            if ((right & 1) == 0) {\n                result += tree[right];\n                right--;\n            }\n            left >>= 1;\n            right >>= 1;\n        }\n        return result % mod;\n    }\n\n    static List<Integer> primeFactorize(int n) {\n        List<Integer> ans = new ArrayList<>();\n        for (int i = 2; i * i <= n; i++) {\n            while (n % i == 0) {\n                ans.add(i);\n                n /= i;\n            }\n            if (n == 1) {\n                break;\n            }\n        }\n        if (n != 1) {\n            ans.add(n);\n        }\n        return ans;\n    }\n\n    static int eulerFunc(int n) {\n        Set<Integer> p = new HashSet<>(primeFactorize(n));\n        int x = n;\n        for (int i : p) {\n            x = x / i * (i - 1);\n        }\n        return x;\n    }\n\n    static long f(int a, int b) {\n        long ans = 1;\n        for (int i = a; i <= b; i++) {\n            ans = (ans * i) % mod;\n        }\n        return ans;\n    }\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.051630016416311264, -3.128163257315464e-07, -0.005247156601399183, -0.08035514503717422, -0.00017791526624932885, -9.372294698550832e-06, -0.011959478259086609, -0.005300992634147406, -5.776898251497187e-05, -6.704273118884885e-07, -0.0012157135643064976, -0.026420356705784798, -0.0026339227333664894, -0.3196757733821869, -0.03725024312734604, -0.05706329643726349, -0.00060307263629511, -0.04393386468291283, -1.843177233240567e-05, -7.896309739408025e-07, -0.004099177662283182, -1.717608094215393, -0.005320800933986