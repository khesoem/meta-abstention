;\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            b[i] = new Pair(x, y);\n        }\n\n        sz = 0;\n        cnt = 0;\n        head = new int[n * 105];\n        Arrays.fill(head, -1);\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < 105; j++) {\n                id[i][j] = sz++;\n            }\n        }\n\n        s = sz;\n        t = s + 1;\n\n        g = new ArrayList<>();\n        for (int i = 0; i < 2 * n * 105; i++) {\n            g.add(null);\n        }\n\n        // Helper functions\n        class Graph {\n            void addEdge(int a, int b, int c, int w) {\n                g.set(cnt, new Edge(b, c, w, head[a]));\n                head[a] = cnt++;\n                g.set(cnt, new Edge(a, 0, -w, head[b]));\n                head[b] = cnt++;\n            }\n\n            boolean bfs() {\n                Arrays.fill(d, inf);\n                Arrays.fill(vis, false);\n                Queue<Integer> q = new LinkedList<>();\n                q.offer(s);\n                d[s] = 0;\n                while (!q.isEmpty()) {\n                    int u = q.poll();\n                    vis[u] = false;\n                    for (int i = head[u]; i != -1; i = g.get(i).next) {\n                        Edge e = g.get(i);\n                        int j = e.v;\n                        if (e.c > 0 && d[j] > d[u] + e.w) {\n                            d[j] = d[u] + e.w;\n                            p[j] = i;\n                            if (!vis[j]) {\n                                vis[j] = true;\n                                q.offer(j);\n                            }\n                        }\n                    }\n                }\n                return d[t] < inf;\n            }\n\n            int maxFlow() {\n                int ans = 0, res = 0;\n                while (bfs()) {\n                    int x = t;\n                    int f = inf;\n                    while (x != s) {\n                        f = Math.min(f, g.get(p[x]).c);\n                        x = g.get(p[x] ^ 1).v;\n                    }\n                    ans += f * d[t];\n                    res += f;\n                    x = t;\n                    while (x != s) {\n                        g.get(p[x]).c -= f;\n                        g.get(p[x] ^ 1).c += f;\n                        x = g.get(p[x] ^ 1).v;\n                    }\n                }\n                // System.err.println(\"res = \" + res);\n                return ans;\n            }\n        }\n\n        // Initialize graph\n        Graph graph = new Graph();\n\n        // Add edges\n        for (int i = 0; i < K; i++) {\n            graph.addEdge(s, id[a[i]][0], 1, 0);\n        }\n        for (int i = 0; i < 105; i++) {\n            graph.addEdge(id[0][i], t, K, C * i);\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < 104; j++) {\n                graph.addEdge(id[i][j], id[i][j + 1], K, 0);\n            }\n        }\n        for (int i = 0; i < m; i++) {\n            int x = b[i].x;\n            int y = b[i].y;\n            for (int j = 0; j < 104; j++) {\n                for (int k = 0; k < K; k++) {\n                    graph.addEdge(id[x][j], id[y][j + 1], 1, D * (2 * k + 1));\n                    graph.addEdge(id[y][j], id[x][j + 1], 1, D * (2 * k + 1));\n                }\n            }\n        }\n\n        int ans = graph.maxFlow();\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.002599557163193822, -8.590104698669165e-05, -1.9361264946837764e-07, -0.00010711929644457996, -1.3856492842023727e-06, -5.512236498361744e-07, -0.003178306156769395, -0.14414352178573608, -0.049261439591646194, -0.0001805377542041242, -0.0012341608526185155, -0.00045617512660101056, -5.2166411478538066e-05, 