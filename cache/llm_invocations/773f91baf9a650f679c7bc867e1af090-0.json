er> q = new LinkedList<>();\n        q.offer(s);\n        d[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            int i = head[u];\n            while (i != -1) {\n                Edge e = edges.get(i);\n                int j = e.v;\n                if (e.c > 0 && d[j] > d[u] + e.w) {\n                    d[j] = d[u] + e.w;\n                    p[j] = i;\n                    if (!vis[j]) {\n                        vis[j] = true;\n                        q.offer(j);\n                    }\n                }\n                i = e.next;\n            }\n        }\n        return d[t] < inf;\n    }\n\n    static int maxFlow(int s, int t) {\n        int ans = 0;\n        int res = 0;\n        while (bfs(s, t)) {\n            int x = t;\n            int f = inf;\n            while (x != s) {\n                int i = p[x];\n                Edge e = edges.get(i);\n                f = Math.min(f, e.c);\n                x = edges.get(e.rev).v;\n            }\n            ans += f * d[t];\n            res += f;\n            x = t;\n            while (x != s) {\n                int i = p[x];\n                Edge e = edges.get(i);\n                e.c -= f;\n                edges.get(e.rev).c += f;\n                x = edges.get(e.rev).v;\n            }\n        }\n        // Optional debug print for res\n        // System.err.println(\"res=\" + res);\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int K = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        for (int i = 0; i < K; i++) {\n            a[i] = sc.nextInt() - 1;\n        }\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            b[i] = new Pair(x, y);\n        }\n\n        int sz = 0;\n        edgeIndex = 0;\n 