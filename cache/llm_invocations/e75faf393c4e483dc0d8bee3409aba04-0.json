lo[e] < cap[e] and dist[v] > dist[u] + pot[u] - pot[v] + cost[e]:\n                    dist[v] = dist[u] + pot[u] - pot[v] + cost[e]\n                    par[v] = e\n                    if inq[v] < 0:\n                        q.append(v)\n                        inq[v] = 1\n                e = nxt[e]\n        \n        if dist[t] >= INF:\n            return 0, price\n        \n        df = INF\n        i = t\n        while i != s:\n            e = par[i]\n            df = min(df, cap[e] - flo[e])\n            i = ep[e]\n        \n        i = t\n        while i != s:\n            e = par[i]\n            flo[e] += df\n            flo[e^1] -= df\n            price += df * cost[e]\n            i = ep[e]\n        \n        for i in range(n):\n            pot[i] = min(INF, dist[i] + pot[i])\n        \n        return df, price\n    \n    # Initialize flow network\n    init()\n    \n    source = 0\n    sink = n * T + 1\n    \n    # Add edges from source to k nodes\n    for _ in range(k):\n        a = int(data[idx]); idx += 1\n        add_edge(source, a, 1, 0)\n    \n    # Add edges for time steps\n    for t in range(T):\n        add_edge(1 + t * n, sink, float('inf'), 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                add_edge(i + (t - 1) * n, i + t * n, float('inf'), c)\n    \n    # Add edges for m edges\n    for _ in range(m):\n        a = int(data[idx]); idx += 1\n        b = int(data[idx]); idx += 1\n        for j in range(C):\n            cost_val = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                add_edge(a + (t - 1) * n, b + t * n, 1, cost_val * d + c)\n                add_edge(b + (t - 1) * n, a + t * n, 1, cost_val * d + c)\n    \n    # Run min cost max flow\n    pot = mcf_pot_init(N)\n    price = 0\n    flow = 0\n    \n    while True:\n        df, price = mcf_update(source, sink, price, N, pot)\n        if df == 0:\n            break\n        flow += df\n    \n    assert flow == k\n    print(price)\n\nif __na