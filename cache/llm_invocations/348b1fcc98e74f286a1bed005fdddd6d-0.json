 MD;\n            v = (val < MD) ? val : val - MD;\n        }\n\n        public ModInt() {\n            v = 0;\n        }\n\n        public ModInt setV(long val) {\n            val = val % MD + MD;\n            v = (val < MD) ? val : val - MD;\n            return this;\n        }\n\n        public ModInt setV(long val, long md) {\n            val = val % md + md;\n            v = (val < md) ? val : val - md;\n            return this;\n        }\n\n        public boolean equals(ModInt other) {\n            return v == other.v;\n        }\n\n        public ModInt neg() {\n            return new ModInt().setV(-v);\n        }\n\n        public ModInt add(ModInt r) {\n            return new ModInt().setV(v + r.v);\n        }\n\n        public ModInt sub(ModInt r) {\n            return new ModInt().setV(v + MD - r.v);\n        }\n\n        public ModInt mul(ModInt r) {\n            return new ModInt().setV((v * r.v) % MD);\n        }\n\n        public ModInt div(ModInt r) {\n            return mul(r.inv());\n        }\n\n        public ModInt pow(long n) {\n            ModInt x = new ModInt();\n            x.v = this.v;\n            ModInt r = new ModInt(1);\n            while (n > 0) {\n                if ((n & 1) == 1) {\n                    r = r.mul(x);\n                }\n                x = x.mul(x);\n                n >>= 1;\n            }\n            return r;\n        }\n\n        public ModInt inv() {\n            return pow(MD - 2);\n        }\n\n        @Override\n        public String toString() {\n            return String.valueOf(v);\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n\n        int n = Integer.parseInt(br.readLine());\n        ModInt[][] mat = new ModInt[n][n];\n\n        for (int i = 0; i < n; i++) {\n            String[] line = br.readLine().split(\" \");\n            for (int j = 0; j < n; j++) {\n                int x = Integer.parseInt(line[j]);\n                mat[i][j] = new ModInt(x).div(new ModInt(100));\n            }\n        }\n\n        class State {\n            List<Integer> maskList;\n            ModInt prob;\n\n            State(List<Integer> maskList, ModInt prob) {\n                this.maskList = maskList;\n                this.prob = prob;\n            }\n        }\n\n        List<State> sts = new ArrayList<>();\n        List<Integer> initMask = new ArrayList<>();\n        initMask.add(0);\n        sts.add(new State(initMask, new ModInt(1)));\n\n        for (int ph = 0; ph < n; ph++) {\n            List<State> nsts = new ArrayList<>();\n\n            for (int f = 1; f < (1 << n); f++) {\n                ModInt freq = new ModInt(1);\n                for (int i = 0; i < n; i++) {\n                    if (((f >> i) & 1) == 1) {\n                        freq = freq.mul(mat[ph][i]);\n                    } else {\n                        freq = freq.mul(new ModInt(1).sub(mat[ph][i]));\n                    }\n                }\n\n                for (State st : sts) {\n                    List<Integer> nst = new ArrayList<>();\n                    for (int d : st.maskList) {\n                        for (int i = 0; i < n; i++) {\n                            if (((d >> i) & 1) == 1) continue;\n                            if (((f >> i) & 1) == 0) continue;\n                            nst.add(d ^ (1 << i));\n                        }\n                    }\n\n                    if (nst.isEmpty()) continue;\n\n                    Collections.sort(nst);\n                    List<Integer> uniqueNst = new ArrayList<>();\n                    Integer prev = null;\n                    for (int val : nst) {\n                        if (prev == null || prev != val) {\n                            uniqueNst.add(val);\n                            prev = val;\n                        }\n                    }\n\n                    nsts.add(new State(uniqueNst, st.prob.mul(freq)));\n                }\n            }\n\n            Collections.sort(nsts, (a, b) -> {\n                for (int i = 0; i < Math.min(a.maskList.size(), b.maskList.size()); i++) {\n                    if (a.maskList.get(i) != b.maskList.get(i)) {\n                        return a.maskList.get(i) - b.maskList.get(i);\n                    }\n                }\n                return a.maskList.size() - b.maskList.size();\n            });\n\n            sts.clear();\n            for (State st : nsts) {\n                if (!sts.isEmpty() && sts.get(sts.size() - 1).maskList.equals(st.maskList)) {\n                    sts.get(sts.size() - 1).prob = sts.get(sts.size() - 1).prob.add(st.prob);\n                } else {\n                    sts.add(st);\n                }\n            }\n        }\n\n        ModInt ans = new ModInt(0);\n        if (!sts.isEmpty()) {\n            ans = sts.get(0).prob;\n        }\n\n        pw.println(ans);\n        pw.close();\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0002308817347511649, -4.410734163684538e-06, -3.576278118089249e-07, -0.003905527526512742, -3.862306402879767e-05, -0.16110973060131073, -0.02631194144487381, -0.0002525725867599249, -3.8265450712060556e-05, -0.11309418082237244, -0.05513447895646095, -0.016101330518722534, -9.536738616588991e-07, -4.2199197196168825e-05, -0.043007563799619675, -6.83045873302035e-05, -0.006397363729774952, -0.38728418946266174, -0.1614776998758316, -1.490105023549404e-05, -2.50339189733495e-06, -7.152555099310121e-07, -0.5094258785247803, -0.011124374344944954, -8.391981828026474e-05, -0.0553894080221653, -0.5231978893280029, -5.125986263010418e-06, -0.0006516240537166595, -2.3841855067985307e-07, -0.004078523721545935, -7.152555099310121e-07, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, 0.0, 0.0, -5.960462772236497e-07, -4.529942543740617e-06, -0.14743755757808685, -0.34844541549682617, -4.78