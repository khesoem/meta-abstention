{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst int MAXN = 1000002;\nconst int INF = 1000000000;\n\nint freq[MAXN];\nint src, dst;\nvector<int> adj_graph[MAXN];\n\nstruct Edge {\n    int from, to, flow, capacity, cost;\n};\n\nvector<Edge> edges;\nvector<int> node_adj[MAXN];\n\nvoid connect(int u, int v, int cap, int cost) {\n    edges.push_back({u, v, 0, cap, cost});\n    node_adj[u].push_back(edges.size() - 1);\n    edges.push_back({v, u, 0, 0, -cost});\n    node_adj[v].push_back(edges.size() - 1);\n}\n\nint dist[MAXN], inq[MAXN], min_cap[MAXN], prev_edge_idx[MAXN];\n\npii spfa(int n) {\n    fill(dist, dist + n + 2, INF);\n    queue<int> q;\n    q.push(src);\n    dist[src] = 0;\n    inq[src] = 1;\n    min_cap[src] = INF;\n\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = 0;\n        for (int idx : node_adj[u]) {\n            int v = edges[idx].to;\n            if (edges[idx].capacity > edges[idx].flow && dist[v] > dist[u] + edges[idx].cost) {\n                dist[v] = dist[u] + edges[idx].cost;\n                prev_edge_idx[v] = idx;\n                min_cap[v] = min(min_cap[u], edges[idx].capacity - edges[idx].flow);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (dist[dst] == INF) return {0, 0};\n\n    int augment = min_cap[dst];\n    int cur = dst;\n    while (cur != src) {\n        int eid = prev_edge_idx[cur];\n        edges[eid].flow += augment;\n        edges[eid ^ 1].flow -= augment;\n        cur = edges[eid].from;\n    }\n\n    return {augment, augment * dist[dst]};\n}\n\npii min_cost_flow(int n) {\n    int total_flow = 0, total_cost = 0;\n    while (true) {\n        pii result = spfa(n);\n        if (result.first == 0) break;\n        total_flow += result.first;\n        total_cost += result.second;\n    }\n    return {total_flow, total_cost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        adj_graph[u].push_back(v);\n        adj_graph[v].push_back(u);\n    }\n\n    src = 0;\n    dst = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            connect(t * n + i, (t + 1) * n + i, k, 0);\n            for (int nb : adj_graph[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    connect(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        if (freq[i]) {\n            connect(src, i, freq[i], 0);\n        }\n    }\n\n    for (int t = 0; t <= 100; ++t) {\n        connect(t * n + 1, dst, k, c * t);\n    }\n\n    cout << min_cost_flow(dst).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    freq = [0] * (n + 1)\n    for _ in range(k):\n        x = int(data[idx]); idx += 1\n        freq[x] += 1\n    \n    adj_graph = [[] for _ in range(n + 1)]\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        adj_graph[u].append(v)\n        adj_graph[v].append(u)\n    \n    src = 0\n    dst = 100 * n + n + 1\n    \n    class Edge:\n        __slots__ = ('from_node', 'to_node', 'flow', 'capacity', 'cost')\n        def __init__(self, from_node, to_node, flow, capacity, cost):\n            self.from_node = from_node\n            self.to_node = to_node\n            self.flow = flow\n            self.capacity = capacity\n            self.cost = cost\n    \n    edges = []\n    node_adj = [[] for _ in range(dst + 2)]\n    \n    def connect(u, v, cap, cost):\n        edges.append(Edge(u, v, 0, cap, cost))\n        node_adj[u].append(len(edges) - 1)\n        edges.append(Edge(v, u, 0, 0, -cost))\n        node_adj[v].append(len(edges) - 1)\n    \n    for t in range(100):\n        for i in range(1, n + 1):\n            connect(t * n + i, (t + 1) * n + i, k, 0)\n            for nb in adj_graph[i]:\n                for cp in range(1, k + 1):\n                    connect(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1))\n    \n    for i in range(1, n + 1):\n        if freq[i]:\n            connect(src, i, freq[i], 0)\n    \n    for t in range(101):\n        connect(t * n + 1, dst, k, c * t)\n    \n    INF = 10**9\n    \n    def spfa(n):\n        dist = [INF] * (n + 2)\n        q = deque()\n        q.append(src)\n        dist[src] = 0\n        inq = [0] * (n + 2)\n        inq[src] = 1\n        min_cap = [0] * (n + 2)\n        min_cap[src] = INF\n        prev_edge_idx = [-1] * (n + 2)\n        \n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for edge_idx in node_adj[u]:\n                edge = edges[edge_idx]\n                v = edge.to_node\n                if edge.capacity > edge.flow and dist[v] > dist[u] + edge.cost:\n                    dist[v] = dist[u] + edge.cost\n                    prev_edge_idx[v] = edge_idx\n                    min_cap[v] = min(min_cap[u], edge.capacity - edge.flow)\n                    if not inq[v]:\n                        q.append(v)\n                        inq[v] = 1\n        \n        if dist[dst] == INF:\n            return (0, 0)\n        \n        augment = min_cap[dst]\n        cur = dst\n        while cur != src:\n            eid = prev_edge_idx[cur]\n            edges[eid].flow += augment\n            edges[eid ^ 1].flow -= augment\n            cur = edges[eid].from_node\n        \n        return (augment, augment * dist[dst])\n    \n    def min_cost_flow(n):\n        total_flow = 0\n        total_cost = 0\n        while True:\n            result = spfa(n)\n            if result[0] == 0:\n                break\n            total_flow += result[0]\n            total_cost += result[1]\n        return (total_flow, total_cost)\n    \n    print(min_cost_flow(dst)[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001070442158379592, -5.960462772236497e-07, -1.1920928244535389e-07, -0.030214672908186913, -0.00270715169608593, -2.3841855067985307e-07, -0.00014184899919200689, -0.00037377048283815384, -7.152555099310121e-07, -0.0013305629836395383, -0.020054785534739494, -0.11488986015319824, -0.028037410229444504, -4.100715523236431e-05, -4.76