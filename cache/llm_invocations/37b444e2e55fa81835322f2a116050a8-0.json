t n = a.length;\n        for (int len = 1; len < n; len <<= 1) {\n            for (int i = 0; i < n; i += len << 1) {\n                for (int j = 0; j < len; ++j) {\n                    int x = a[i + j];\n                    int y = (int)((long)sign * a[i + j + len] % MOD);\n                    a[i + j] = normalize(x + y);\n                    a[i + j + len] = normalize(x - y);\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        K = sc.nextInt();\n        MOD = sc.nextInt();\n        precompute_factorials(N);\n        \n        if ((N & 1) == 1) {\n            System.out.println(mod_pow(K, N));\n            return;\n        }\n        \n        int M = 1, L = 0;\n        while (M <= N) {\n            M <<= 1;\n            ++L;\n        }\n        \n        popcount = new int[M];\n        for (int i = 0; i < M; ++i) {\n            popcount[i] = Integer.bitCount(i);\n        }\n        \n        precompute_factorials(M);\n        \n        F = new int[L + 1][M];\n        for (int i = 0; i < M; ++i) {\n            F[popcount[i]][i] = inv_factorial[i];\n        }\n        \n        for (int i = 0; i <= L; ++i) {\n            walsh_hadamard_transform(F[i], 1);\n        }\n        \n        G = new long[L + 1];\n        for (int s = 0; s < M; ++s) {\n            for (int i = 0; i <= L; ++i) {\n                G[i] = F[i][s];\n            }\n            \n            long[] result = new long[L + 1];\n            result[0] = 1;\n            long[] base = new long[L + 1];\n            for (int i = 0; i <= L; ++i) {\n                base[i] = G[i];\n            }\n            int exponent = K;\n            \n            while (exponent > 0) {\n                if ((exponent & 1) == 1) {\n                    long[] temp = new long[L + 1];\n                    for (int i = 0; i <= L; ++i) {\n                        for (int j = 0; j <= L - i; ++j) {\n                            temp[i + j] = (temp[i + j] + result[i] * base[j]) % MOD;\n                        }\n                    }\n                    result = temp;\n                }\n                long[] squared = new long[L + 1];\n                for (int i = 0; i <= L; ++i) {\n                    for (int j = 0; j <= L - i; ++j) {\n                        squared[i + j] = (squared[i + j] + base[i] * base[j]) % MOD;\n                    }\n                }\n                base = squared;\n                exponent >>= 1;\n            }\n            \n            for (int i = 0; i <= L; ++i) {\n                F[i][s] = (int)result[i];\n            }\n        }\n        \n        // Apply inverse Walsh-Hadamard transform\n        walsh_hadamard_transform(F[popcount[N]], -1);\n        \n        long answer = mod_pow(K, N) - (long)F[popcount[N]][N] * factorial[N] % MOD;\n        answer = normalize((int)answer);\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0003897384158335626, -3.933898824470816e-06, -1.5497195136049413e-06, -0.0004011779965367168, -1.597391747054644e-05, -0.1430511474609375, -0.6932165622711182, -0.0011044599814340472, -4.541770613286644e-05, -0.001574111171066761, -0.0005217621219344437, -0.00014709345123264939, -8.344646857949556e-07, -5.054346183896996e-05, -0.0789007619023323, -0.0001255195093108341, -0.09015239030122757, -0.0023497133515775204, -0.0007058274932205677, -1.1920928244535389e-07, -7.152555099310121e-07, -9.536738616588991e-07, -1.7881377516459906e-06, -1.0728830375228426e-06, -2.312633478140924e-05, -2.3841830625315197e-06, -0.20390060544013977, -0.00029523781267926097, -5.2689116273541003e-05, -3.302042750874534e-05, -1.7165990357170813e-05, -0.00043847484630532563, -0.0003073934931308031, -5.6622808187967166e-05, -1.7881377516459906e-06, -6.6756979322235566e-06, -9.65590606938349e-06, -4.768360213347478e-06, -4.410734163