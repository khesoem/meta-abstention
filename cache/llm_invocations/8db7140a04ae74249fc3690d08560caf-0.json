{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <algorithm>\n#include <string>\n#include <cstring>\n#include <vector>\n#include <queue>\n#include <limits>\n#include <utility>\n#include <iomanip>\n#include <cassert>\n#include <cmath>\n#include <map>\n#include <stack>\n#include <numeric>\n#include <set>\n\n#define endl '\\n'\nusing namespace std;\n\ntypedef long long ll;\n\nstruct Fraction {\n    ll a, b;\n};\n\npair<ll, ll> geta(int x, int y, int b) {\n    ll lower = (ll)b * x / y;\n    ll upper = ((ll)b * x + (y-1)) / y;\n    return {lower, upper};\n}\n\nll gcd(ll a, ll b) {\n    if (b == 0) return a;\n    return gcd(b, a % b);\n}\n\nvoid solve(int x, int y, int n) {\n    vector<Fraction> cands;\n    for (int b = 1; b <= n; b++) {\n        auto ap = geta(x, y, b);\n        cands.push_back({ap.first, b});\n        cands.push_back({ap.second, b});\n    }\n\n    auto comp = [&](Fraction fa, Fraction fb)-> bool {\n        ll a1 = fa.a;\n        ll b1 = fa.b;\n        ll a2 = fb.a;\n        ll b2 = fb.b;\n\n        ll left = abs(x * b1 * b2 - a1 * b2 * y);\n        ll right = abs(x * b1 * b2 - a2 * b1 * y);\n\n        if (left != right) return left < right;\n\n        if (b1 != b2) return b1 < b2;\n\n        return a1 < a2;\n    };\n\n    sort(cands.begin(), cands.end(), comp);\n\n    cout << cands.front().a << \"/\" << cands.front().b << endl;\n}\n\nint main(){\n    std::ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    int x, y, n;\n    cin >> x >> y >> n;\n\n    solve(x, y, n);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class Fraction {\n        long a, b;\n        Fraction(long a, long b) {\n            this.a = a;\n            this.b = b;\n        }\n    }\n\n    static class FractionComparator implements Comparator<Fraction> {\n        public int compare(Fraction fa, Fraction fb) {\n            long a1 = fa.a;\n            long b1 = fa.b;\n            long a2 = fb.a;\n            long b2 = fb.b;\n\n            long left = Math.abs(x * b1 * b2 - a1 * b2 * y);\n            long right = Math.abs(x * b1 * b2 - a2 * b1 * y);\n\n            if (left != right) {\n                return Long.compare(left, right);\n            }\n\n            if (b1 != b2) {\n                return Long.compare(b1, b2);\n            }\n\n            return Long.compare(a1, a2);\n        }\n    }\n\n    static int x, y;\n\n    static long[] geta(int b) {\n        long lower = (long) b * x / y;\n        long upper = ((long) b * x + (y - 1)) / y;\n        return new long[]{lower, upper};\n    }\n\n    static void solve(int n) {\n        List<Fraction> cands = new ArrayList<>();\n        for (int b = 1; b <= n; b++) {\n            long[] ap = geta(b);\n            cands.add(new Fraction(ap[0], b));\n            cands.add(new Fraction(ap[1], b));\n        }\n\n        Collections.sort(cands, new FractionComparator());\n\n        System.out.println(cands.get(0).a + \"/\" + cands.get(0).b);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        x = Integer.parseInt(st.nextToken());\n        y = Integer.parseInt(st.nextToken());\n        int n = Integer.parseInt(st.nextToken());\n\n        solve(n);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001573438785271719, -4.172316494077677e-06, -2.3841855067985307e-07, -9.059495641849935e-05, -1.4781842764932662e-05, -0.010050404816865921, -0.6326556205749512, -0.00013124081306159496, -1.9311717551317997e-05, -0.003288221312686801, -0.0012416280806064606, -4.23184028477408e-05, -4.768370445162873e-07, -4.8040190449682996e-05, -0.018151482567191124, -0.009758741594851017, -2.90866428258596e-05, -4.708655978902243e-05, -7.724463648628443e-05, -0.000125281119835563, -1.4305104514278355e-06, -3.3378546504536644e-06, -4.768370445162873e-07, -0.06998491287231445, -3.576278118089249e-07, -0.0024760086089372635, -0.0007139279623515904, -0.0005995621904730797, -4.768360213347478e-06, -1.8715683836489916e-05, -2.264974000354414e-06, -6.294052582234144e-05, 0.0, -1.1920928244535389e-07, -0.0036001885309815407, -2.264974000354414e-06, -1.0728830375228426e-06, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -1.5497195136049413e-06, -9.536738616588991e-07, -3.3378546504536644e-06, -9.536738616588991e-07, 0.0, -4.887569048150908e-06, -8.344646857949556e-07, -3.2186455882765586e-06, -7.152555099310121e-07, -4.768370445162873e-07, -0.0010339635191485286, -1.1920928244535389e-07, -0.0005855038180015981, -0.6128538846969604, -0.015584350563585758, -0.0026150099001824856, -5.006777428206988e-06, -0.0005752577562816441, -9.65590606938349e-06, -1.3112935448589269e-05, -1.311301275563892e-06, 0.0, -4.529942543740617e-06, -0.21539965271949768, -5.364403477869928e-06, -5.829164365422912e-05, -1.07288303752284