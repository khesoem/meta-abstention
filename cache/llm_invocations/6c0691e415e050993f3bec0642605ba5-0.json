tf cap[MAXN],mxflow;\nbool in_queue[MAXN];\nvoid flow(int s, int t){\n\tmemset(in_queue,0,sizeof(in_queue));\n\tmxflow=mncost=0;\n\twhile(1){\n\t\tfill(dist,dist+nodes,INFCOSTO);dist[s]=0;\n\t\tmemset(pre,-1,sizeof(pre));pre[s]=0;\n\t\tmemset(cap,0,sizeof(cap));cap[s]=INFFLUJO;\n\t\tqueue<int> q;q.push(s);in_queue[s]=1;\n\t\twhile(SZ(q)){\n\t\t\tint u=q.front();q.pop();in_queue[u]=0;\n\t\t\tfore(_,0,SZ(g[u])){\n\t\t\t\tint i=g[u][_];\n\t\t\t\tedge &E=e[i];\n\t\t\t\tif(E.rem()&&dist[E.v]>dist[u]+E.cost+1e-9){\n\t\t\t\t\tdist[E.v]=dist[u]+E.cost;\n\t\t\t\t\tpre[E.v]=i;\n\t\t\t\t\tcap[E.v]=min(cap[u],E.rem());\n\t\t\t\t\tif(!in_queue[E.v])q.push(E.v),in_queue[E.v]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(pre[t]<0)break;\n\t\tmxflow+=cap[t];mncost+=cap[t]*dist[t];\n\t\tfor(int v=t;v!=s;v=e[pre[v]].u){\n\t\t\te[pre[v]].flow+=cap[t];e[pre[v]^1].flow-=cap[t];\n\t\t}\n\t}\n}\nint main() {\n  ios::sync_with_stdio(false);\n\tll n,m,k,c,d;\n  cin>>n>>m>>k>>c>>d;\n\tint MAXT=n+k;\n\tif(DEBUG)cout<<\"MAXT: \"<<MAXT<<endl;\n\tvector<int>a(k);\n\tfore(i,0,k){\n\t\tcin>>a[i];a[i]--;\n\t\tadd_edge(SRC,a[i]*MAXT,1,0);\n\t}\n\tfore(j,0,MAXT)add_edge(j,SNC,k,0);\n\tfore(i,0,m) {\n\t\tint x,y;cin>>x>>y;x--,y--;\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(x*MAXT+j,y*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(y*MAXT+j,x*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t}\n\tfore(i,0,n) {\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(i*MAXT+j,i*MAXT+j+1,1,c);\n\t\t}\n\t}\n\tflow(SRC,SNC);\n\tif(DEBUG)cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n\tcout<<mncost<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "import java.util.*;\n\npublic class Main {\n    static final int MAXN = 50 * 100 + 15;\n    static final long INFFLUJO = (long) 1e14;\n    static final long INFCOSTO = (long) 1e14;\n    static final boolean DEBUG = false;\n\n    static int SRC = MAXN - 1;\n    static int SNC = MAXN - 2;\n    static int nodes = MAXN;\n\n    static List<Integer>[] g = new ArrayList[MAXN];\n    static List<Edge> e = new ArrayList<>();\n    static long[] dist = new long[MAXN];\n    static long mncost;\n    static int[] pre = new int[MAXN];\n    static long[] cap = new long[MAXN];\n    static long mxflow;\n    static boolean[] in_queue = new boolean[MAXN];\n\n    static class Edge {\n        int u, v;\n        long cap, flow;\n        long cost;\n\n        Edge(int u, int v, long cap, long flow, long cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n\n        long rem() {\n            return cap - flow;\n        }\n    }\n\n    static class Pair {\n        int first, second;\n\n        Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    static void addEdge(int u, int v, long cap, long cost) {\n        if (DEBUG) {\n            String dem = Integer.toString(u);\n            String pen = Integer.toString(v);\n            if (u == SRC) dem = \"SRC\";\n            if (u == SNC) dem = \"SINC\";\n            if (v == SRC) pen = \"SRC\";\n            if (v == SNC) pen = \"SINC\";\n            System.out.println(\"add edge: \" + dem + \" \" + pen + \" \" + cap + \" \" + cost);\n        }\n        g[u].add(e.size());\n        e.add(new Edge(u, v, cap, 0, cost));\n        g[v].add(e.size());\n        e.add(new Edge(v, u, 0, 0, -cost));\n    }\n\n    static void flow(int s, int t) {\n        Arrays.fill(in_queue, false);\n        mxflow = 0;\n        mncost = 0;\n        while (true) {\n            Arrays.fill(dist, INFCOSTO);\n            dist[s] = 0;\n            Arrays.fill(pre, -1);\n            pre[s] = 0;\n            Arrays.fill(cap, 0);\n            cap[s] = INFFLUJO;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            in_queue[s] = true;\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                in_queue[u] = false;\n                for (int i : g[u]) {\n                    Edge E = e.get(i);\n                    if (E.rem() > 1e-9 && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                        dist[E.v] = dist[u] + E.cost;\n                        pre[E.v] = i;\n                        cap[E.v] = Math.min(cap[u], E.rem());\n                        if (!in_queue[E.v]) {\n                            q.offer(E.v);\n                            in_queue[E.v] = true;\n                        }\n                    }\n                }\n            }\n            if (pre[t] < 0) break;\n            mxflow += cap[t];\n            mncost += cap[t] * dist[t];\n            for (int v = t; v != s; v = e.get(pre[v]).u) {\n                e.get(pre[v]).flow += cap[t];\n                e.get(pre[v] ^ 1).flow -= cap[t];\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        for (int i = 0; i < MAXN; i++) {\n            g[i] = new ArrayList<>();\n        }\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        long c = sc.nextLong();\n        long d = sc.nextLong();\n\n        int MAXT = n + k;\n        if (DEBUG) System.out.println(\"MAXT: \" + MAXT);\n\n        int[] a = new int[k];\n        for (int i = 0; i < k; i++) {\n            a[i] = sc.nextInt() - 1;\n            addEdge(SRC, a[i] * MAXT, 1, 0);\n        }\n\n        for (int j = 0; j < MAXT; j++) {\n            addEdge(j, SNC, k, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(i * MAXT + j, i * MAXT + j + 1, 1, c);\n                }\n            }\n        }\n\n        flow(SRC, SNC);\n        if (DEBUG) System.out.println(\"mncost: \" + mncost + \" mxflow: \" + mxflow);\n        System.out.println(mncost);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.39655378460884094, -5.512236498361744e-07, -0.0021860685665160418, -0.5778180956840515, -0.0009201543871313334, -9.088346359931165e-07, -0.34067732095718384, -0.05498519167304039, -0.010846192948520184, -0.015776721760630608, -0.09757107496261597, -0.6932015419006348, -0.08900609612464905, -0.00024120506714098155, -0.0005008471780456603, -2.1008713702030946e-06, -0.0004450892156455666, -0.0040801819413900375, -1.3856492842023727e-06, -4.320199877838604e-07, -5.512236498361744e-07, -2.4987974029500037e-05, -1.6240566083070007e-06, -0.0023274829145520926, -2.522638169466518e-05, -1.4378848391061183e-05, -0.4741884469985962, -0.16149869561195374, -0.00023095356300473213, -0.00010080150241265073, -0.0002072357019642368, -0.000561969296541065, -5.347765181795694e-05, -0.4287523329257965, -1.8624639324116288e-06, -8.995397365652025e-05, -0.25193139910697937, 0.0, -0.0002964935847558081, -4.320199877838604e-07, -0.00032592954812571406, -5.5577775128767826e-06, -1.981667537620524e-06, -3.054500666621607e-06, -7.896309739408025e-07, -1.3856492842023727e-06, -4.320199877838604e-07, -5.512236498361744e-07, -2.951771421066951e-05, -2.534558552724775e-05, -1.9361264946837764e-07, -6.704273118884885e-07, -9.088346359931165e-07, -0.0017