t mod) {\n    int res = 1;\n    base %= mod;\n    while (exp > 0) {\n      if ((exp & 1) == 1) res = modMul(res, base, mod);\n      base = modMul(base, base, mod);\n      exp >>= 1;\n    }\n    return res;\n  }\n\n  static int modDiv(int a, int b, int mod) {\n    return modMul(a, modPow(b, mod - 2, mod), mod);\n  }\n\n  static int gcd(int a, int b) {\n    while (b != 0) { int t = b; b = a % b; a = t; }\n    return a;\n  }\n\n  static int lowerBound(int[] arr, int val) {\n    int lo = 0, hi = arr.length - 1, ans = -1;\n    while (lo <= hi) {\n      int mid = lo + (hi - lo) / 2;\n      if (arr[mid] < val) { ans = mid; lo = mid + 1; }\n      else hi = mid - 1;\n    }\n    return ans;\n  }\n\n  static long[] logSeries(long limit, long target) {\n    long i = 1, sum = 0;\n    int cnt = 0;\n    long[] res = new long[2];\n    while (i < limit) {\n      sum += i;\n      cnt++;\n      if (sum == target) { res[0] = cnt; res[1] = sum; return res; }\n      i *= 2;\n    }\n    res[0] = cnt; res[1] = sum;\n    return res;\n  }\n\n  static void addCount(Map<Integer, Integer> map, int key) {\n    map.merge(key, 1, Integer::sum);\n  }\n\n  static long listSum(List<Long> list) {\n    long total = 0;\n    for (Long x : list) total += x;\n    return total;\n  }\n\n  static int charIndex(char c) { return c - 'a'; }\n\n  static int optimizedSearch(int[] prefix, int start, int target, int n) {\n    int lo = start + 1, hi = n - 1, ans = start;\n    while (lo <= hi) {\n      int mid = lo + (hi - lo) / 2;\n      int diff = prefix[mid] - prefix[start];\n      if (diff == target) return mid;\n      if (diff < target) { ans = mid; lo = mid + 1; }\n      else hi = mid - 1;\n    }\n    return ans;\n  }\n\n  static Pair<Long, Integer> computeStats(List<Integer> list) {\n    long total = 0;\n    int minVal = Integer.MAX_VALUE;\n    for (int x : list) {\n      total += x;\n      minVal = Math.min(minVal, x);\n    }\n    return new Pair<>(total - minVal, minVal);\n  }\n\n  static int maxDivisor(Map<Integer, Integer> map, int num, int req) {\n    int maxK = 0;\n    for (int i = 1; i * i <= num; i++) {\n      if (num % i == 0) {\n        int d1 = i, d2 = num / i;\n        addCount(map, d1);\n        if (d1 != d2) addCount(map, d2);\n        if (map.get(d1) == req) maxK = Math.max(maxK, d1);\n        if (map.get(d2) == req) maxK = Math.max(maxK, d2);\n      }\n    }\n    return maxK;\n  }\n\n  static List<Integer> extractKeys(Map<Integer, Integer> map) {\n    return new ArrayList<>(map.keySet());\n  }\n\n  static List<Integer> extractValues(Map<Integer, Integer> map) {\n    return new ArrayList<>(map.values());\n  }\n\n  static int arrayMax(List<Integer> list) {\n    return list.stream().mapToInt(Integer::intValue).max().orElse(0);\n  }\n\n  static int arrayMin(List<Integer> list) {\n    return list.stream().mapToInt(Integer::intValue).min().orElse(0);\n  }\n\n  static final int[][] MOVES = {{-1,0},{0,1},{1,0},{0,-1}};\n\n  public static void main(String[] args) throws IOException {\n    String s = br.readLine();\n    int n = s.length();\n    int ways = 0;\n\n    if (n == 1) {\n      char c = s.charAt(0);\n      ways = (c == '0' || c == '_' || c == 'X') ? 1 : 0;\n    } else if (s.charAt(0) == '0') {\n      ways = 0;\n    } else {\n      String[] validEnds = {\"25\", \"50\", \"75\", \"00\"};\n      String[] wildEnds = {\"__\", \"_X\", \"X_\", \"XX\"};\n      String tail = s.substring(n - 2);\n      char c0 = tail.charAt(0), c1 = tail.charAt(1);\n\n      if (c0 == 'X' && c1 == 'X' && s.charAt(0) == 'X') {\n        ways = 0;\n      } else {\n        for (String end : validEnds) {\n          if (tail.equals(end)) { ways = 1; break; }\n        }\n\n        if (ways == 0) {\n          if (c0 == '_' || c0 == 'X') {\n            ways = 2;\n            if (c1 == '0' && s.charAt(0) == 'X') ways = 1;\n          } else if (c1 == '_' || c1 == 'X') {\n            ways = 1;\n          }\n\n          for (int i = 0; i < 4; i++) {\n            if (tail.equals(wildEnds[i])) {\n    