    for (int i = 1; i <= n; i++) {\n            int sumG = 0;\n            for (int j = 0; j <= i - 1; j++) {\n                int part1 = multiply(2, multiply(f.get(j), g.get(i - 1 - j), mod), mod);\n                part1 = multiply(part1, C(i - 1, j, mod), mod);\n                part1 = multiply(part1, i + 1, mod);\n                int part2 = multiply(C(i -1, j, mod), add(S(j), S(i - 1 - j), mod), mod);\n                part2 = multiply(part2, multiply(f.get(j), f.get(i - 1 - j), mod), mod);\n                sumG = add(sumG, add(part1, part2, mod), mod);\n            }\n            g.set(i, sumG);\n        }\n\n        for (int i = 0; i <= n; i++) {\n            g.set(i, multiply(g.get(i), inv[i], mod));\n            f.set(i, multiply(f.get(i), inv[i], mod));\n        }\n\n        int ans = 0;\n        for (int i = 1; i <= m - n + 1; i++) {\n            int term = multiply(multiply(g.get(n), G(i + 1, m - n - i + 1, mod), mod), multiply(jc[n], i, mod), mod);\n            ans = add(ans, term, mod);\n            g = multLists(g, f, n + 1, mod);\n        }\n        System.out.println(ans);\n    }\n\n    static void init(int n) {\n        jc[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            jc[i] = multiply(jc[i - 1], i, mod);\n        }\n        inv[n] = ksm(jc[n], mod - 2);\n        for (int i = n - 1; i >= 0; i--) {\n            inv[i] = multiply(inv[i + 1], i + 1, mod);\n        }\n    }\n\n    static int C(int n, int m, int mod) {\n        if (n < 0 || m < 0 || n < m)\n            return 0;\n        return multiply(multiply(jc[n], inv[n - m], mod), inv[m], mod);\n    }\n\n    static int S(int n) {\n        return n * (n + 1) / 2 % mod;\n    }\n\n    static int multiply(int a, int b, int mod) {\n        long res = ((long) a * b) % mod;\n        return (int) res;\n    }\n\n    static int add(int a, int b, int mod) {\n        int res = a + b;\n        if (res >= mod) res -= mod;\n        return res;\n    }\n\n    static int ksm(int base, int exp) {\n     