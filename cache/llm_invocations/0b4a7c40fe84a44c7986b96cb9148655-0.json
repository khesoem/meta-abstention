trix(n, n)\n        for i in range(K):\n            for j in range(K):\n                r.v[i][j] = self.v[(i + K - 1) % K][(j + K - 1) % K]\n            r.v[i][K] = self.v[(i + K - 1) % K][K]\n            r.v[K][i] = self.v[K][(i + K - 1) % K]\n        r.v[K][K] = self.v[K][K]\n        self.v = r.v\n\ndef fastpow(a, b):\n    res = 1\n    while b:\n        if b & 1:\n            res = res * a\n        a = a * a\n        b >>= 1\n    return res\n\ndef main():\n    global K\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n\n    level = 0\n    x = N\n    while x >= K:\n        level += 1\n        x //= K\n\n    # table[level][offset] for level up to 70, offset up to 35\n    table = [[None for _ in range(35)] for _ in range(70)]\n\n    table[0][0] = Matrix.eye(K + 1)\n    for i in range(1, K + 1):\n        table[0][0].v[0][i] = 1\n    for i in range(1, K):\n        table[0][i] = Matrix(K + 1, K + 1)\n        # copy from previous\n        for r in range(K + 1):\n            for c in range(K + 1):\n                table[0][i].v[r][c] = table[0][i - 1].v[r][c]\n        table[0][i].rotate()\n\n    for l in range(1, level + 1):\n        table[l][0] = Matrix(K + 1, K + 1)\n        for r in range(K + 1):\n            for c in range(K + 1):\n                table[l][0].v[r][c] = table[l - 1][0].v[r][c]\n        for i in range(1, K):\n            table[l][0] = table[l - 1][i].mul(table[l][0])\n        for i in range(1, K):\n            table[l][i] = Matrix(K + 1, K + 1)\n            for r in range(K + 1):\n                for c in range(K + 1):\n                    table[l][i].v[r][c] = table[l][i - 1].v[r][c]\n            table[l][i].rotate()\n\n    result = Matrix(K + 1, 1)\n    result.v[K][0] = 1\n    offset = 0\n    while level >= 0:\n        while True:\n            p = fastpow(K, level)\n            if p <= N:\n                N -= p\n                result = table[level][offset].mul(result)\n              