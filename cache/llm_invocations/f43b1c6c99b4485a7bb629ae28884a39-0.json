);\n#endif\n    if (scanf(\"%d%d%d\", &n, &k, &p) != 3) return 0;\n\n    for (int i = 1; i <= n; ++i) pc[i] = pc[i >> 1] + (i & 1);\n\n    powv = mod_pow(k, n);\n    if (n & 1) {\n        printf(\"%d\\n\", powv);\n        return 0;\n    }\n\n    lim = min(k, pc[n]);\n\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i % p;\n\n    invfact[n] = mod_pow(fact[n], p - 2);\n    for (int i = n; i >= 1; --i) invfact[i - 1] = invfact[i] * i % p;\n\n    total = 0;\n    for (int i = lim; i >= 1; --i) total += comb(k, i) * solve_dp(i, n);\n\n    ull ans = (powv - total % p * fact[n] % p + p) % p;\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 250010;\n    static int n, k, p, lim;\n    static int[] pc = new int[MAXN];\n    static long[][] dp = new long[26][MAXN];\n    static boolean[][] computed = new boolean[26][MAXN];\n    static long[] fact = new long[MAXN];\n    static long[] invfact = new long[MAXN];\n    static long powv, total;\n\n    static long modPow(long base, int expo) {\n        long res = 1;\n        while (expo > 0) {\n            if ((expo & 1) == 1) res = res * base % p;\n            base = base * base % p;\n            expo >>= 1;\n        }\n        return res;\n    }\n\n    static long solveDp(int K, int N) {\n        if (pc[N] < K) return 0;\n        if (K == 1) {\n            dp[K][N] = invfact[N];\n            computed[K][N] = true;\n            return dp[K][N];\n        }\n        if (computed[K][N]) return dp[K][N];\n\n        long cur = 0;\n        int cnt = 0;\n        for (int sub = N & (N - 1); sub != 0; sub = N & (sub - 1)) {\n            if (pc[sub] >= K - 1) {\n                cur += solveDp(K - 1, sub) * invfact[N ^ sub];\n                cnt++;\n                if (cnt == 18) {\n                    cnt = 0;\n                    cur %= p;\n                }\n            }\n        }\n        dp[K][N] = cur % p;\n        computed[K][N] = true;\n        return dp[K][N];\n    }\n\n    static long comb(int N, int M) {\n        return fact[N] * invfact[M] % p * invfact[N - M] % p;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        p = Integer.parseInt(st.nextToken());\n\n        for (int i = 1; i <= n; ++i) {\n            pc[i] = pc[i >> 1] + (i & 1);\n        }\n\n        powv = modPow(k, n);\n        if ((n & 1) == 1) {\n            System.out.println(powv);\n            return;\n        }\n\n        lim = Math.min(k, pc[n]);\n\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = fact[i - 1] * i % p;\n        }\n\n        invfact[n] = modPow(fact[n], p - 2);\n        for (int i = n; i >= 1; --i) {\n            invfact[i - 1] = invfact[i] * i % p;\n        }\n\n        total = 0;\n        for (int i = lim; i >= 1; --i) {\n            total = (total + comb(k, i) * solveDp(i, n)) % p;\n        }\n\n        long ans = (powv - total % p * fact[n] % p + p) % p;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, -3.373566141817719e-05, -0.00014804698002990335, 0.0, -0.0031777145341038704, -0.2519453465938568, 0.0, 0.0, -1.6689160474925302e-05, -0.006802969612181187, -7.784063927829266e-05, -1.1920928244535389e-07, -1.168244216387393e-05, -0.0005646541831083596, -1.811964830267243e-05, -0.018213290721178055, -7.557583012385294e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.0728830375228426e-06, 0.0, -5.960462772236497e-07, -2.145764938177308e-06,