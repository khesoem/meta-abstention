l > 0) {\n        adjustment = adjustment * 10 + (isNegative ? -1 : 1);\n        val /= 10;\n    }\n    adjustment = adjustment * 10 + 1;\n    return isNegative ? original + adjustment : original - adjustment;\n}\n\ni64 getFirstDigit(i64 val) {\n    if (val < 0) val = -val;\n    while (val >= 10) {\n        val /= 10;\n    }\n    return val;\n}\n\ni64 removeLastDigit(i64 val) {\n    if (val < 0) val = -val;\n    vector<int> digits;\n    while (val >= 10) {\n        digits.push_back(val % 10);\n        val /= 10;\n    }\n    i64 res = 0;\n    for (int i = digits.size() - 1; i >= 0; --i) {\n        res = res * 10 + digits[i];\n    }\n    return res;\n}\n\nunordered_map<i64, i64> memo;\n\ni64 process(i64 val) {\n    if (val <= 11) return min(13 - val, val);\n    if (memo.find(val) != memo.end()) return memo[val];\n    i64 n = 0, limit = 1;\n    while (limit < val) {\n        limit *= 10;\n        limit += 1;\n        ++n;\n    }\n    if (val * 2 >= limit) {\n        i64 option1 = process(limit - val) + n + 1;\n        i64 base = limit / 10;\n        i64 option2 = (val / base) * n + process(val % base);\n        return memo[val] = min(option1, option2);\n    }\n    i64 base = limit / 10;\n    return memo[val] = (val / base) * n + process(val % base);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    i64 input;\n    cin >> input;\n    cout << process(input) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    private static Map<Long, Long> memo = new HashMap<>();\n\n    private static long digitCount(long val) {\n        if (val == 0) return 1;\n        if (val < 0) val = -val;\n        long cnt = 0;\n        while (val > 0) {\n            ++cnt;\n            val /= 10;\n        }\n        return cnt;\n    }\n\n    private static long incrementEachDigit(long val) {\n        List<Integer> digits = new ArrayList<>();\n        boolean isNegative = val < 0;\n        if (isNegative) val = -val;\n        while (val > 0) {\n            int d = (int)(val % 10);\n            digits.add(d - (isNegative ? -1 : 1));\n            val /= 10;\n        }\n        long res = 0;\n        for (int i = digits.size() - 1; i >= 0; --i) {\n            res = res * 10 + digits.get(i);\n        }\n        return isNegative ? -res : res;\n    }\n\n    private static long decrementEachDigit(long val) {\n        boolean isNegative = val < 0;\n        if (isNegative) val = -val;\n        long adjustment = 0;\n        long original = val;\n        while (val > 0) {\n            adjustment = adjustment * 10 + (isNegative ? -1 : 1);\n            val /= 10;\n        }\n        adjustment = adjustment * 10 + 1;\n        return isNegative ? original + adjustment : original - adjustment;\n    }\n\n    private static long getFirstDigit(long val) {\n        if (val < 0) val = -val;\n        while (val >= 10) {\n            val /= 10;\n        }\n        return val;\n    }\n\n    private static long removeLastDigit(long val) {\n        if (val < 0) val = -val;\n        List<Integer> digits = new ArrayList<>();\n        while (val >= 10) {\n            digits.add((int)(val % 10));\n            val /= 10;\n        }\n        long res = 0;\n        for (int i = digits.size() - 1; i >= 0; --i) {\n            res = res * 10 + digits.get(i);\n        }\n        return res;\n    }\n\n    private static long process(long val) {\n        if (val <= 11) return Math.min(13 - val, val);\n        if (memo.containsKey(val)) return memo.get(val);\n        \n        long n = 0, limit = 1;\n        while (limit < val) {\n            limit *= 10;\n            limit += 1;\n            ++n;\n        }\n        \n        long result;\n        if (val * 2 >= limit) {\n            long option1 = process(limit - val) + n + 1;\n            long base = limit / 10;\n            long option2 = (val / base) * n + process(val % base);\n            result = Math.min(option1, option2);\n        } else {\n            long base = limit / 10;\n            result = (val / base) * n + process(val % base);\n        }\n        \n        memo.put(val, result);\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long input = scanner.nextLong();\n        System.out.println(process(input));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00024136967840604484, -2.145764938177308e-06, -1.6689286894688848e-06, -8.451581379631534e-05, -2.5510462364763953e-05, -0.0041644759476184845, -0.08992350101470947, -2.3483953555114567e-05, -5.960462772236497e-07, -3.6000557884108275e-05, -0.023246610537171364, -0.0006269635050557554, -0.4783477187156677, -1.1444026313256472e-05, -0.5803831815719604, -2.90866428258596e-05, 0.0, -4.327203714638017e-05, -2.3841855067985307e-07, -3.814689989667386e-06, -0.014229735359549522, -3.933898824470816e-06, -3.3378044463461265e-05, -0.006719848606735468, -2.3841855067985307e-07, -0.4287869930267334, -1.0728830375228426e-06, -0.0012504386249929667, -1.7881377516459906e-06, -1.9073468138230965e-06, -0.000188332938705571, -2.7418097943154862e-06, -7.152555099310121e-07, 0.0, -9.775113539944869e-06, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -3.576272320060525e-06, 0.0, 0.0, -2.50339189733495e-06, -2.0265558760002023e-06, -1.4066597032069694e-05, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -3.2186455882765586e-06, 0.0, -1.8954096958623268e-05, -1.6689286894688848e-06, -2.0265558760002023e-06, -2.1457441107486375e-05, -4.887569048150908e-06, -3.933898824470816e-06, 0.0, 0.0, -3.576278118089249e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -5.960462772236497e-07, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.192092