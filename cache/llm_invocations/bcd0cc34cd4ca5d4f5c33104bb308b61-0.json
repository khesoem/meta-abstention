   System.out.println(bruteForce(n, m));\n        } else {\n            if ((res & 1) != 0) res--;\n            System.out.println(res);\n        }\n    }\n\n    int bruteForce(int n, int m) {\n        int es = n * m / 2 + (n * m % 2);\n        int os = n * m / 2;\n        int[] ex = new int[es], ey = new int[es];\n        int[] ox = new int[os], oy = new int[os];\n        int ei = 0, oi = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < m; j++) {\n                if (((i + j) & 1) == 0) {\n                    ex[ei] = i; ey[ei] = j; ei++;\n                } else {\n                    ox[oi] = i; oy[oi] = j; oi++;\n                }\n            }\n        }\n\n        ArrayList<Integer>[] adj = new ArrayList[es];\n        for (int i = 0; i < es; i++) adj[i] = new ArrayList<>();\n        for (int i = 0; i < es; i++) {\n            for (int j = 0; j < os; j++) {\n                if (Math.abs(ex[i] - ox[j]) + Math.abs(ey[i] - oy[j]) == 3) {\n                    adj[i].add(j);\n                }\n            }\n        }\n\n        return 2 * maxMatching(adj, os);\n    }\n\n    int maxMatching(ArrayList<Integer>[] adj, int n2) {\n        int[] matchR = new int[n2];\n        Arrays.fill(matchR, -1);\n        int result = 0;\n        for (int u = 0; u < adj.length; u++) {\n            boolean[] seen = new boolean[adj.length];\n            if (dfs(adj, u, seen, matchR)) result++;\n        }\n        return result;\n    }\n\n    boolean dfs(ArrayList<Integer>[] adj, int u, boolean[] seen, int[] matchR) {\n        for (int v : adj[u]) {\n            if (!seen[v]) {\n                seen[v] = true;\n                if (matchR[v] == -1 || dfs(adj, matchR[v], seen, matchR)) {\n                    matchR[v] = u;\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n\n    public static void main(String[] args) throws IOException {\n        new CFA2().solve();\n    }\n\n    String nextToken() throw