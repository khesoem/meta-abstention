ase) % MOD;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    public static void solve() {\n        precompute();\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        long k = sc.nextLong();\n        if (k == 0) {\n            System.out.println(factorial[n]);\n            return;\n        }\n        if (n <= k) {\n            System.out.println(0);\n            return;\n        }\n        long comb = nCr(n, (int)k);\n        int cols = n - (int)k;\n        long sum = 0;\n        for (int i = 0; i <= cols; i++) {\n            long term = nCr(cols, i);\n            term = (term * modPow(cols - i, n)) % MOD;\n            if ((i & 1) == 1) {\n                sum = (sum - term + MOD) % MOD;\n            } else {\n                sum = (sum + term) % MOD;\n            }\n        }\n        long ans = (comb * sum) % MOD;\n        ans = (2 * ans) % MOD;\n        System.out.println(ans);\n    }\n\n    public static long extendedGCD(long a, long b, long[] xy) {\n        if (a == 0) {\n            xy[0] = 0;\n            xy[1] = 1;\n            return b;\n        }\n        long[] nextXY = new long[2];\n        long gcd = extendedGCD(b % a, a, nextXY);\n        xy[0] = nextXY[1] - (b / a) * nextXY[0];\n        xy[1] = nextXY[0];\n        return gcd;\n    }\n\n    public static long modInverse(long a, long m) {\n        long[] xy = new long[2];\n        long gcd = extendedGCD(a, m, xy);\n        if (gcd != 1) return -1;\n        long inv = (xy[0] % m + m) % m;\n        return inv;\n    }\n\n    public static void main(String[] args) {\n        solve();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\nusing namespace std;\n\nconst long long MOD = 998244353;\nconst int MAX = (int)4e5 + 10;\nvector<long long> factorial;\nvector<long long> invFactorial;\n\nlong lon