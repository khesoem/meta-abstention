dge(x, y, INF, c);\n            }\n        }\n\n        for (int i = 0; i < 102; i++) {\n            int tmp = i * 50 + 1;\n            addedge(tmp, T, INF, 0);\n        }\n\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            for (int j = 1; j <= 102; j++) {\n                int x = point(j, u), x1 = point(j + 1, u);\n                int y1 = point(j + 1, v), y = point(j, v);\n                for (int kk = 0; kk < 50; kk++) {\n                    int val = d * (kk * 2 + 1) + c;\n                    addedge(x, y1, 1, val);\n                    addedge(y, x1, 1, val);\n                }\n            }\n        }\n\n        int[] cost = new int[1];\n        minCostMaxflow(S, T, cost);\n        System.out.println(cost[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841830625315197e-06, -1.1920928244535389e-07, 0.0, -8.654219709569588e-05, -0.008749127388000488, -1.1920928244535389e-07, -0.005233872216194868, -0.07899407297372818, -3.576278118089249e-07, -3.576278118089249e-07, -3.576278118089249e-07, -0.005361463874578476, -8.523101132595912e-05, 0.0, -3.516612196108326e-05, -0.0020234365947544575, -9.643566590966657e-05, -0.07943029701709747, -0.014258410781621933, -2.9802276912960224e-06, -1.0728830375228426e-06, 0.0, -0.007424263749271631, -0.07248181849718094, 0.0, 0.0, -6.318072337307967e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -0.1602512151002884, -9.536738616588991e-07, -1.680836794548668e-05, -2.6225699912174605e-05, 0.0, -0.04859209805727005, -0.2023267298936844, 0.0, -1.1920928244535389e-07, -0.00012492353562265635, -8.34461570775602e-06, -1.1920928244535389e-07, -0.00014053787162993103, 0.0, -3.6954811548639555e-06, -6.198863957251888e-06, 0.0, 0.0, -5.006777428206988e-06, -1.1920928244535389e-07, -6.318072337307967e-