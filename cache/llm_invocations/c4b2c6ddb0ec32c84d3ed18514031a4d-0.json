N = self.Nodes = n\n        self.cost = [INF] * n\n        self.flow = [0] * n\n        self.p = [0] * n\n\n    def add_edge(self, from_node, to, cost, flow):\n        self.edges.append(Node(from_node, to, cost, flow))\n        self.edges.append(Node(to, from_node, -cost, 0))\n\n    def get_path(self, src, sink):\n        self.clear(maxN)\n        self.flow[src] = INF\n        self.cost[src] = 0\n        f = 1\n        i = 0\n        while i < self.Nodes and f:\n            f = 0\n            for j in range(len(self.edges)):\n                if self.edges[j].flow > 0 and self.cost[self.edges[j].to] > self.cost[self.edges[j].from_node] + self.edges[j].cost:\n                    f = 1\n                    self.cost[self.edges[j].to] = self.cost[self.edges[j].from_node] + self.edges[j].cost\n                    self.flow[self.edges[j].to] = min(self.flow[self.edges[j].from_node], self.edges[j].flow)\n                    self.p[self.edges[j].to] = j\n            i += 1\n\n    def cost_flow(self, src, sink):\n        if src == sink:\n            self.tot_cost = 0\n            self.tot_flow = INF\n            return\n        self.tot_cost = 0\n        self.tot_flow = 0\n        while True:\n            self.get_path(src, sink)\n            if self.flow[sink] == 0:\n                break\n            cur = sink\n            while cur != src:\n                rI = self.p[cur] - 1 if self.p[cur] % 2 else self.p[cur] + 1\n                self.edges[self.p[cur]].flow -= self.flow[sink]\n                self.edges[rI].flow += self.flow[sink]\n                self.tot_cost += self.edges[self.p[cur]].cost * self.flow[sink]\n                cur = self.edges[self.p[cur]].from_node\n            self.tot_flow += self.flow[sink]\n\ndef IN(a):\n    return 2 * a\n\ndef OUT(a):\n    return 2 * a + 1\n\nmcf = MinCostMaxFlow()\n\ndef add_edge(i, j, x, y):\n    n1 = i * N + j\n    n2 = x * N + y + N * N\n    mcf.add_edge(OUT(n1), IN(n2), 0, 1000000)\n\ndef main():\n    global N, mat, mat2, v1, maxN\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    n = int(data[idx]); idx += 1\n    t = int(data[idx]); idx += 1\n    N = n\n    a = []\n    b = []\n    si = sj = 0\n    for i in range(n):\n        line = data[idx]; idx += 1\n        a.append(line)\n        for j in range(n):\n            if line[j] == 'Z':\n                si = i\n                sj = j\n    mat = a[:]\n    for i in range(n):\n        line = data[idx]; idx += 1\n        b.append(line)\n    mat2 = b[:]\n    v = [[-1] * N for _ in range(N)]\n    vv = []\n    v1 = [[1000000] * N for _ in range(N)]\n    ini(si, sj, v)\n    v1 = [row[:] for row in v]\n    get(a, vv)\n    mcf.clear(4 * N * N + 2)\n    src = 4 * N * N\n    for i in range(N * N):\n        mcf.add_edge(src, IN(i), 0, 1000000)\n        mcf.add_edge(OUT(N * N + i), src + 1, 0, 1000000)\n    for x in range(N):\n        for y in range(N):\n            if a[x][y].isdigit():\n                k = x * N + y\n                mcf.add_edge(IN(k), OUT(k), 0, int(a[x][y]))\n            if b[x][y].isdigit():\n                k = x * N + y + N * N\n                mcf.add_edge(IN(k), OUT(k), 0, int(b[x][y]))\n    for i in range(N):\n        for j in range(N):\n            if b[i][j].isdigit() and b[i][j] != '0':\n                for k in range(len(vv)):\n                    if vv[k] is not None:\n                        x = k // N\n                        y = k % N\n                        if vv[k][i][j] == -1 or vv[k][i][j] > t:\n                            continue\n                        add_edge(x, y, i, j)\n    mcf.cost_flow(src, src + 1)\n    print(mcf.get_flow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.344647e-07, 0.0, -2.3841855e-07, -0.0004407388, -0.16288187, -0.00027080684, -0.023418041, -0.0033984783, -0.004732835, -3.576278e-07, -0.00018523408, -0.062383108, -0.08324997, -7.748574e-06, -3.850386e-05, 0.0, -1.1920