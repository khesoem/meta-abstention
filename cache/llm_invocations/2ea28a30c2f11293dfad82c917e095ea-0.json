  }\n        pw.println(sum);\n        \n        pw.close();\n        br.close();\n    }\n    \n    private static long[] multiply(long[] x, long[] y, long mod) {\n        int len = x.length + y.length - 1;\n        long[] z = new long[len];\n        for (int i = 0; i < x.length; i++) {\n            for (int j = 0; j < y.length; j++) {\n                z[i + j] = (z[i + j] + x[i] * y[j]) % mod;\n            }\n        }\n        return z;\n    }\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n\nusing namespace std;\n\nvector<long long> multiply(const vector<long long>& x, const vector<long long>& y, long long mod) {\n    int len = x.size() + y.size() - 1;\n    vector<long long> z(len, 0);\n    for (int i = 0; i < x.size(); i++) {\n        for (int j = 0; j < y.size(); j++) {\n            z[i + j] = (z[i + j] + x[i] * y[j]) % mod;\n        }\n    }\n    return z;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    int N, k;\n    ss >> N >> k;\n    \n    vector<long long> digitFlags(11, 0);\n    for (int i = 0; i < k; i++) {\n        int d;\n        cin >> d;\n        digitFlags[10 - d] = 1;\n    }\n    \n    int half = N / 2;\n    vector<long long> poly = {1};\n    const long long MOD = 998244353LL;\n    \n    while (half > 0) {\n        if ((half & 1) == 1) {\n            poly = multiply(poly, digitFlags, MOD);\n        }\n        digitFlags = multiply(digitFlags, digitFlags, MOD);\n        half >>= 1;\n    }\n    \n    long long sum = 0;\n    for (long long c : poly) {\n        sum = (sum + c * c) % MOD;\n    }\n    cout << sum << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012587709352374077, -3.099436753473128e-06, -9.536738616588991e-0