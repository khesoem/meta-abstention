;\n    adl(S,P(0,p),1,0);\n  }for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&s[i*2].f,&s[i*2].t);\n    s[i*2-1]=(Data){s[i*2].t,s[i*2].f};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      adl(P(t-1,i),P(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      adl(P(t-1,s[i].f),P(t,s[i].t),1,D);\n      pl[t][i]=tl;st[t][i]=1;\n    }adl(P(t,1),T,INF,t*C);\n  }\n  int sav,cans=0;\n  while(sav=spfa()){\n    int u=T;\n    while(u!=S){\n      int las=pre[u];\n      g[lp[u]].c-=sav;\n      g[lp[u]^1].c+=sav;\n      u=las;\n    }cans+=dis[T]*sav;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (g[pl[t][i]].c){\n          st[t][i]++;\n          adl(P(t-1,s[i].f),P(t,s[i].t),1,D*(st[t][i]*2-1));\n          pl[t][i]=tl;\n        }\n  }printf(\"%d\\n\",cans);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int Maxn = 5500;\n    static final int Maxm = 35500;\n    static final int INF = 1000000000;\n    \n    static class Line {\n        int nxt, t, c, l;\n        Line(int nxt, int t, int c, int l) {\n            this.nxt = nxt;\n            this.t = t;\n            this.c = c;\n            this.l = l;\n        }\n    }\n    \n    static Line[] g = new Line[Maxm];\n    static int[] fir = new int[Maxn];\n    static int tl = 1;\n    \n    static void adl(int f, int t, int c, int cost) {\n        g[++tl] = new Line(fir[f], t, c, cost);\n        fir[f] = tl;\n        g[++tl] = new Line(fir[t], f, 0, -cost);\n        fir[t] = tl;\n    }\n    \n    static int S, T;\n    static int[] pre = new int[Maxn];\n    static int[] lp = new int[Maxn];\n    static int[] flow = new int[Maxn];\n    static int[] dis = new int[Maxn];\n    static boolean[] in = new boolean[Maxn];\n    static Queue<Integer> q = new LinkedList<>();\n    \n    static int spfa() {\n        for (int i = 1; i <= T; i++) {\n            dis[i] = INF;\n            flow[i] = 0;\n        }\n        flow[S] = INF;\n        dis[S] = 0;\n        q.add(S);\n        in[S] = true;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            in[u] = false;\n            for (int i = fir[u]; i != 0; i = g[i].nxt) {\n                if (g[i].c > 0 && dis[g[i].t] > dis[u] + g[i].l) {\n                    int v = g[i].t;\n                    dis[v] = dis[u] + g[i].l;\n                    flow[v] = Math.min(flow[u], g[i].c);\n                    lp[v] = i;\n                    pre[v] = u;\n                    if (!in[v]) {\n                        in[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return flow[T];\n    }\n    \n    static int n, m, k, C, D;\n    static int[][] pl = new int[105][105];\n    static int[][] st = new int[105][105];\n    static class Data {\n        int f, t;\n        Data(int f, int t) {\n            this.f = f;\n            this.t = t;\n        }\n    }\n    static Data[] s = new Data[105];\n    \n    static int P(int x, int y) {\n        return x * n + y;\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        k = scanner.nextInt();\n        C = scanner.nextInt();\n        D = scanner.nextInt();\n        \n        S = P(n + k, n) + 1;\n        T = S + 2;\n        adl(P(0, 1), T, INF, 0);\n        \n        for (int i = 1; i <= k; i++) {\n            int p = scanner.nextInt();\n            adl(S, P(0, p), 1, 0);\n        }\n        \n        for (int i = 1; i <= m; i++) {\n            int f = scanner.nextInt();\n            int t = scanner.nextInt();\n            s[i * 2] = new Data(f, t);\n            s[i * 2 - 1] = new Data(t, f);\n        }\n        m *= 2;\n        \n        for (int t = 1; t <= n + k; t++) {\n            for (int i = 1; i <= n; i++) {\n                adl(P(t - 1, i), P(t, i), INF, 0);\n            }\n            for (int i = 1; i <= m; i++) {\n                adl(P(t - 1, s[i].f), P(t, s[i].t), 1, D);\n                pl[t][i] = tl;\n                st[t][i] = 1;\n            }\n            adl(P(t, 1), T, INF, t * C);\n        }\n        \n        int sav, cans = 0;\n        while ((sav = spfa()) > 0) {\n            int u = T;\n            while (u != S) {\n                int las = pre[u];\n                g[lp[u]].c -= sav;\n                g[lp[u] ^ 1].c += sav;\n                u = las;\n            }\n            cans += dis[T] * sav;\n            \n            for (int t = 1; t <= n + n; t++) {\n                for (int i = 1; i <= m; i++) {\n                    if (g[pl[t][i]].c > 0) {\n                        st[t][i]++;\n                        adl(P(t - 1, s[i].f), P(t, s[i].t), 1, D * (st[t][i] * 2 - 1));\n                        pl[t][i] = tl;\n                    }\n                }\n            }\n        }\n        \n        System.out.println(cans);\n        scanner.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.560128091834486e-05, -3.4570634852570947e-06, -1.7881377516459906e-06, -0.000543446687515825, -3.290122185717337e-05, -0.01603798381984234, -0.03819391876459122, -2.0146166207268834e-05, -1.1920928244535389e-07, -5.6265202147187665e-05, -0.002805704018101096, -8.106198947643861e-06, -0.0012348415330052376, -0.3510318696498871, -2.145764938177308e-06, -0.006190530024468899, -7.152555099310121e-07, 0.0, 0.0, 0.0, 0.0, -0.00012373158824630082, -1.6689286894688848e-06, -5.960462772236497e-07, -1.1920928244535389e-07, -5.364403477869928e-06, -3.2186455882765586e-06, -5.960462772236497e-07, -1.7046782886609435e-05, -3.576278118089249e-07, 0.0, 0.0, -7.152555099310121e-07, -3.5523738915799186e-05, -5.960462772236497e-07, -1.9073468138230965e-06, -2.3841855067985307e-07, -5.960462772236497e-07, 