*;\n\npublic class Main {\n    static class MCF {\n        int n;\n        static class Edge {\n            int to, cap, cost, rev;\n            Edge(int to, int cap, int cost, int rev) {\n                this.to = to;\n                this.cap = cap;\n                this.cost = cost;\n                this.rev = rev;\n            }\n        }\n        ArrayList<ArrayList<Edge>> g;\n        int[] dist, curflow, prevedge, prevnode, pot;\n        MCF(int n) {\n            this.n = n;\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) g.add(new ArrayList<>());\n            dist = new int[n];\n            curflow = new int[n];\n            prevedge = new int[n];\n            prevnode = new int[n];\n            pot = new int[n];\n        }\n        void addEdge(int s, int t, int cap, int cost) {\n            int rev_f = g.get(t).size();\n            int rev_r = g.get(s).size();\n            g.get(s).add(new Edge(t, cap, cost, rev_f));\n            g.get(t).add(new Edge(s, 0, -cost, rev_r));\n        }\n        int[] minCostFlow(int s, int t) {\n            int flow = 0, cost = 0;\n            final int INF = 1000000000;\n            while (flow < INF) {\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                Arrays.fill(dist, Integer.MAX_VALUE);\n                dist[s] = 0;\n                curflow[s] = Integer.MAX_VALUE;\n                pq.add(new int[]{0, s});\n                while (!pq.isEmpty()) {\n                    int[] top = pq.poll();\n                    int d = top[0], u = top[1];\n                    if (d != dist[u]) continue;\n                    for (int i = 0; i < g.get(u).size(); i++) {\n                        Edge e = g.get(u).get(i);\n                        if (e.cap <= 0) continue;\n                        int v = e.to;\n                        int nd = d + e.cost + pot[u] - pot[v];\n                        if (dist[v] > nd) {\n                            dist[v] = nd;\n                            pq.add(new int[]{nd, v});\n                            prevnode[v] = u;\n                            prevedge[v] = i;\n                            curflow[v] = Math.min(curflow[u], e.cap);\n                        }\n                    }\n                }\n                if (dist[t] == Integer.MAX_VALUE) break;\n                for (int i = 0; i < n; i++) pot[i] += dist[i];\n                int df = Math.min(curflow[t], INF - flow);\n                flow += df;\n                for (int v = t; v != s; v = prevnode[v]) {\n                    Edge e = g.get(prevnode[v]).get(prevedge[v]);\n                    e.cap -= df;\n                    g.get(v).get(e.rev).cap += df;\n                    cost += df * e.cost;\n                }\n            }\n            return new int[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int N = 6 + 107 * n;\n        MCF mcf = new MCF(N);\n        java.util.function.BiFunction<Integer,Integer,Integer> id = (time, city) -> 1 + time * n + city;\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            mcf.addEdge(0, id.apply(0, x), 1, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int t = 0; t < 105; t++) {\n                for (int j = 0; j < 51; j++) {\n                    mcf.addEdge(id.apply(t, x), id.apply(t+1, y), 1, c + d * (2*j + 1));\n                    mcf.addEdge(id.apply(t, y), id.apply(t+1, x), 1, c + d * (2*j + 1));\n                }\n            }\n        }\n        for (int t = 0; t < 105; t++) {\n            for (int city = 0; city < n; city++) {\n                mcf.addEdge(id.apply(t, city), id.apply(