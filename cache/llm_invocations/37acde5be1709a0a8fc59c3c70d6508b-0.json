{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\ntypedef long long ll;\ntypedef pair<int,int> pii;\nconst int INF = 0x3f3f3f3f;\nconst int NN = 6555;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nstruct MinCostFlow {\n    int V;\n    vector<Edge> G[NN];\n    int h[NN], dist[NN], prev[NN], pree[NN];\n    void init(int n) {\n        V = n;\n        for(int i=0;i<=n;i++) G[i].clear();\n    }\n    void add_edge(int from,int to,int cap,int cost) {\n        G[from].emplace_back(to,cap,cost,G[to].size());\n        G[to].emplace_back(from,0,-cost,G[from].size()-1);\n    }\n    int minCost(int s,int t,int f) {\n        int flow = 0, cost = 0;\n        fill(h, h+V+1, 0);\n        while(f > 0) {\n            fill(dist, dist+V+1, INF);\n            priority_queue<pii,vector<pii>,greater<pii>> pq;\n            dist[s] = 0; pq.emplace(0,s);\n            while(!pq.empty()) {\n                auto [d,v] = pq.top(); pq.pop();\n                if(dist[v] < d) continue;\n                for(int i=0;i<G[v].size();i++) {\n                    Edge &e = G[v][i];\n                    if(e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                        prev[e.to] = v;\n                        pree[e.to] = i;\n                        pq.emplace(dist[e.to], e.to);\n                    }\n                }\n            }\n            if(dist[t] == INF) break;\n            for(int i=0;i<=V;i++) h[i] += dist[i];\n            int add = f;\n            for(int v=t; v!=s; v=prev[v]) add = min(add, G[prev[v]][pree[v]].cap);\n            f -= add; flow += add; cost += add * h[t];\n            for(int v=t; v!=s; v=prev[v]) {\n                Edge &e = G[prev[v]][pree[v]];\n                e.cap -= add;\n                G[v][e.rev].cap += add;\n            }\n        }\n        return cost;\n    }\n} flow;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n#ifndef ONLINE_JUDGE\n    freopen(\"in.in\",\"r\",stdin);\n    freopen(\"out.out\",\"w\",stdout);\n#endif\n    int n,m,k,c,d;\n    cin >> n >> m >> k >> c >> d;\n    flow.init(n*(n+55)+2);\n    for(int i=0;i<k;i++) {\n        int u; cin >> u;\n        flow.add_edge(0,u,1,0);\n    }\n    vector<pii> edges(m);\n    for(int i=0;i<m;i++) cin >> edges[i].first >> edges[i].second;\n    int target = n*(n+55)+1;\n    for(int t=0;t<n+54;t++) {\n        for(auto &e : edges) {\n            for(int j=1;j<=k;j++) {\n                flow.add_edge(e.first+t*n, e.second+(t+1)*n, 1, c+d*(2*j-1));\n                flow.add_edge(e.second+t*n, e.first+(t+1)*n, 1, c+d*(2*j-1));\n            }\n        }\n        for(int i=2;i<=n;i++) {\n            flow.add_edge(i+t*n, i+(t+1)*n, k, c);\n        }\n        flow.add_edge(1+t*n, target, k, 0);\n    }\n    cout << flow.minCost(0, target, k) << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nclass MinCostFlow:\n    def __init__(self, n):\n        self.V = n\n        self.G = [[] for _ in range(n+1)]\n        self.h = [0] * (n+1)\n        self.dist = [0] * (n+1)\n        self.prev = [0] * (n+1)\n        self.pree = [0] * (n+1)\n\n    def add_edge(self, fr, to, cap, cost):\n        self.G[fr].append(Edge(to, cap, cost, len(self.G[to])))\n        self.G[to].append(Edge(fr, 0, -cost, len(self.G[fr]) - 1))\n\n    def min_cost(self, s, t, f):\n        flow = 0\n        cost = 0\n        self.h = [0] * (self.V + 1)\n        while f > 0:\n            self.dist = [INF] * (self.V + 1)\n            pq = []\n            self.dist[s] = 0\n            heapq.heappush(pq, (0, s))\n            while pq:\n                d, v = heapq.heappop(pq)\n                if self.dist[v] < d:\n                    continue\n                for i, e in enumerate(self.G[v]):\n                    if e.cap > 0 and self.dist[e.to] > self.dist[v] + e.cost + self.h[v] - self.h[e.to]:\n                        self.dist[e.to] = self.dist[v] + e.cost + self.h[v] - self.h[e.to]\n                        self.prev[e.to] = v\n                        self.pree[e.to] = i\n                        heapq.heappush(pq, (self.dist[e.to], e.to))\n            if self.dist[t] == INF:\n                break\n            for i in range(self.V + 1):\n                self.h[i] += self.dist[i]\n            add = f\n            v = t\n            while v != s:\n                add = min(add, self.G[self.prev[v]][self.pree[v]].cap)\n                v = self.prev[v]\n            f -= add\n            flow += add\n            cost += add * self.h[t]\n            v = t\n            while v != s:\n                e = self.G[self.prev[v]][self.pree[v]]\n                e.cap -= add\n                self.G[v][e.rev].cap += add\n                v = self.prev[v]\n        return cost\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    # total nodes: source (0), nodes for each time step, sink\n    # time steps: 0..n+54 (inclusive) -> n+55 time layers, each layer has n nodes (1..n)\n    # source = 0, sink = n*(n+55)+1\n    total_nodes = n * (n + 55) + 2\n    flow = MinCostFlow(total_nodes)\n    # source edges\n    for _ in range(k):\n        u = next(it)\n        flow.add_edge(0, u, 1, 0)\n    edges = []\n    for _ in range(m):\n        a = next(it)\n        b = next(it)\n        edges.append((a, b))\n    target = n * (n + 55) + 1\n    for t in range(n + 54):\n        for a, b in edges:\n            for j in range(1, k+1):\n                flow.add_edge(a + t*n, b + (t+1)*n, 1, c + d * (2*j - 1))\n                flow.add_edge(b + t*n, a + (t+1)*n, 1, c + d * (2*j - 1))\n        for i in range(2, n+1):\n            flow.add_edge(i + t*n, i + (t+1)*n, k, c)\n        flow.add_edge(1 + t*n, target, k, 0)\n    result = flow.min_cost(0, target, k)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.013238508254289627, -2.264974000354414e-06, 0.0, -1.1920928244535389e-07, -0.000590865034610033, -0.008637804538011551, -7.486063259420916e-05, -0.001932421582750976, -1.6689160474925302e-05, -4.529942543740617e-06, -0.12697939574718475, -0.576317310333252, -4.768370445162873e-07, -0.000505677133332938, -0.0012286503333598375, -0.004078404977917671, -0.0035062285605818033, -0.023424096405506134, -1.811964830267243e-05, -0.5759474039077759, -4.768370445162873e-07, -2.9802276912960224e-06, -0.12694768607616425, 0.0, 0.0, -4.768370445162873e-07, -2.264974000354414e-06, -0.00309797