ctor<int> p(n, 0);\n    for (const Edge& e : edges) p[e.from]++;\n    vector<vector<Edge*>> g(n);\n    for (int i = 0; i < n; ++i) g[i].reserve(p[i]);\n    for (Edge& e : edges) g[e.from].push_back(&e);\n    return g;\n}\n\nlong long solveMinCostFlow(vector<vector<Edge*>>& g, int source, int sink, long long all) {\n    int n = g.size();\n    long long mincost = 0;\n    vector<int> potential(n, 0);\n    vector<int> d(n);\n    vector<Edge*> inedge(n, nullptr);\n    while (all > 0) {\n        fill(d.begin(), d.end(), INT_MAX / 2);\n        fill(inedge.begin(), inedge.end(), nullptr);\n        d[source] = 0;\n        priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;\n        pq.push({0, source});\n        while (!pq.empty()) {\n            auto [dist, cur] = pq.top(); pq.pop();\n            if (dist != d[cur]) continue;\n            for (Edge* ne : g[cur]) {\n                if (ne->capacity - ne->flow > 0) {\n                    int nd = d[cur] + ne->cost + potential[cur] - potential[ne->to];\n                    if (d[ne->to] > nd) {\n                        d[ne->to] = nd;\n                        inedge[ne->to] = ne;\n                        pq.push({nd, ne->to});\n                    }\n                }\n            }\n        }\n        if (inedge[sink] == nullptr) break;\n        long long minflow = all;\n        long long sumcost = 0;\n        for (Edge* e = inedge[sink]; e != nullptr; e = inedge[e->from]) {\n            if (e->capacity - e->flow < minflow) minflow = e->capacity - e->flow;\n            sumcost += e->cost;\n        }\n        mincost += minflow * sumcost;\n        for (Edge* e = inedge[sink]; e != nullptr; e = inedge[e->from]) {\n            e->flow += minflow;\n            e->complement->flow -= minflow;\n        }\n        all -= minflow;\n        for (int i = 0; i < n; ++i) {\n            potential[i] += d[i];\n        }\n    }\n    return mincost;\n}\n\nvoid solve() {\n    int n;\n    cin >> n;\n    string s;\n    cin >> s;\n    vector<int> a(n);\n    for (int i = 0; i < n; ++i) cin >> a[i];\n\n    vector<int> f(26, 0);\n    for (char c : s) f[c - 'a']++;\n    for (int i = 0; i < 26; ++i) {\n        if (f[i] > n / 2) {\n            cout << -1 << endl;\n            return;\n        }\n    }\n\n    for (int i = 0; i < n / 2; ++i) {\n        if (a[i] > a[n - 1 - i]) {\n            swap(a[i], a[n - 1 - i]);\n            swap(s[i], s[n - 1 - i]);\n        }\n    }\n\n    vector<Edge> edges;\n    int src = n, sink = n + 1;\n    for (int i = 0; i < n / 2; ++i) {\n        edges.emplace_back(src, i, 1, 0);\n        edges.emplace_back(n - 1 - i, sink, 1, 0);\n        for (int j = 0; j < n / 2; ++j) {\n            if (s[i] != s[n - 1 - j]) {\n                edges.emplace_back(i, n - 1 - j, 1, (i == j ? 0 : a[i]));\n            }\n        }\n    }\n\n    auto g = compileWD(sink + 1, edges);\n    long long ans = 0;\n    for (int x : a) ans += x;\n    cout << ans - solveMinCostFlow(g, src, sink, n) << endl;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    solve();\n    return 0;\n}\n```", "token_logprobs": [-0.0002613918040879071, -0.6039824485778809, -2.169585604860913e-05, -3.1470757676288486e-05, -3.3378546504536644e-06, -2.3841855067985307e-07, -0.002476722002029419, -8.940656698541716e-06, 0.0, 0.0, -0.00016175392374861985, -7.152555099310121e-07, 0.0, 0.0, -2.3841574147809297e-05, -1.5497195136049413e-06, 0.0, 0.0, -9.798523387871683e-05, -2.264974000354414e-06, 0.0, 0.0, -0.0005534547381103039, -1.1920922133867862e-06, 0.0, 0.0, -4.291525328881107e-06, 0.0, 0.0, -0.4741182327270508, -0.0012059090659022331, -7.867782187531702e-06, 0.0, -7.152555099310121e-07, -0.00017355366435367614, -3.576278118089249e-07, -2.7418097943154862e-06, -1.0728830375228426e-06, 0.0, -1.1920928244535389e-07, -7.986990567587782e-06, 0.0, -2.1457441107486375e-05, -2.825220326485578e-05, -7.152555099310121e-07, -6.198863957251888e-06, -8.940656698541716e-06, 0.0, -3.099436