hm>\n#include <climits>\n\nusing namespace std;\n\nint main() {\n    int n;\n    string s;\n    cin >> n >> s;\n    \n    vector<int> cnt(3, 0);\n    vector<vector<int>> pos(3);\n    for (int i = 0; i < n; ++i) {\n        char c = s[i];\n        int idx = (c == 'K') ? 0 : (c == 'V' ? 1 : 2);\n        pos[idx].push_back(i);\n        cnt[idx]++;\n    }\n    \n    int s0 = cnt[0] + 1;\n    int s1 = cnt[1] + 1;\n    int s2 = cnt[2] + 1;\n    int total = 2 * s0 * s1 * s2;\n    const int INF = INT_MAX / 2;\n    vector<int> dp(total, INF);\n    \n    auto idx = [&](int last, int i0, int i1, int i2) -> int {\n        return ((last * s0 + i0) * s1 + i1) * s2 + i2;\n    };\n    \n    dp[idx(0, 0, 0, 0)] = 0;\n    \n    for (int i0 = 0; i0 <= cnt[0]; ++i0) {\n        for (int i1 = 0; i1 <= cnt[1]; ++i1) {\n            for (int i2 = 0; i2 <= cnt[2]; ++i2) {\n                for (int last = 0; last < 2; ++last) {\n                    int cur = dp[idx(last, i0, i1, i2)];\n                    if (cur >= INF) continue;\n                    \n                    // Place K (group 0) only if last == 0\n                    if (i0 < cnt[0] && last == 0) {\n                        int swaps = 0;\n                        int p0 = pos[0][i0];\n                        for (int i = i1; i < cnt[1] && pos[1][i] < p0; ++i) swaps++;\n                        for (int i = i2; i < cnt[2] && pos[2][i] < p0; ++i) swaps++;\n                        int &target = dp[idx(0, i0 + 1, i1, i2)];\n                        target = min(target, cur + swaps);\n                    }\n                    \n                    // Place V (group 1)\n                    if (i1 < cnt[1]) {\n                        int swaps = 0;\n                        int p1 = pos[1][i1];\n                        for (int i = i0; i < cnt[0] && pos[0][i] < p1; ++i) swaps++;\n                        for (int i = i2; i < cnt[2] && pos[2][i] < p1; ++i) swaps++;\n                        int &target = dp[idx(1, i0, i1 + 1, i2)];\n                        target = min(target, cur + swaps);\n                    }\n                    \n                    // Place other (group 2)\n                    if (i2 < cnt[2]) {\n                        int swaps = 0;\n                        int p2 = pos[2][i2];\n                        for (int i = i0; i < cnt[0] && pos[0][i] < p2; ++i) swaps++;\n                        for (int i = i1; i < cnt[1] && pos[1][i] < p2; ++i) swaps++;\n                        int &target = dp[idx(0, i0, i1, i2 + 1)];\n                        target = min(target, cur + swaps);\n                    }\n                }\n            }\n        }\n    }\n    \n    int ans = min(dp[idx(0, cnt[0], cnt[1], cnt[2])], dp[idx(1, cnt[0], cnt[1], cnt[2])]);\n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.005206241272389889, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -0.0002094287920044735, -1.0490362910786644e-05, -2.3841855067985307e-07, -0.008633549325168133, -1.1444026313256472e-05, 0.0, 0.0, -0.0009233264136128128, -4.768370445162873e-07, 0.0, 0.0, -0.6965145468711853, -1.5497195136049413e-06, 0.0, 0.0, -0.018157336860895157, -2.7418097943154862e-06, 0.0, 0.0, -1.156323378381785e-05, 0.0, 0.0, -0.10023149102926254, -0.0032854885794222355, -1.1920928244535389e-07, 0.0, -1.0728830375228426e-06, -0.0031861516181379557, -2.3841830625315197e-06, -1.0728830375228426e-06, -2.3841855067985307e-07, -8.344646857949556e-07, -0.3133186399936676, -4.768370445162873e-07, -9.536697689327411e-06, 0.0, -9.619726915843785e-05, 0.0, -2.0503786799963564e-05, 0.0, -6.794906312279636e-06, 0.0, 0.0, -0.0005538121913559735, -0.00012337400403339416, -0.4794558584690094, -0.5759407877922058, 0.0, -0.010565299540758133, -0.002476840978488326, 0.0, -0.0002619877050165087, -0.00010501786891836673, 0.0, -1.680836794548668e-05, -3.540453326422721e-05, 0.0, -5.483612312673358e-06, -1.1920928244535389e-07, -6.318072337307967e-06, -