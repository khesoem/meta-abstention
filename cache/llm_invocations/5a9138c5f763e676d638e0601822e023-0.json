 "response": {"samples": [{"content": "<original_code>\n# include <bits/stdc++.h>\nusing namespace std;\nconst int B=1e6,M=998244353,mod=1e9+7;\ntypedef long long ll;\nll n,cnt1,cnt2;\nint sum[10],ans;\nvector<int> val[10];\nvoid dfs1(int d,ll v)\n{\n    if(d>6) return;\n    int w=((++cnt1)-v+M)%M;\n    val[d].add(w);\n    sum[d]=(sum[d]+w)%mod;\n    for(int i=0;i<=9;i++) dfs1(d+1,v*10+i);\n}\nvoid dfs2(ll v)\n{\n    if(v>n) return;\n    if(v<n/B && 10*v>n/B)\n    {\n        for(int i=0,pw=1;i<=6;pw*=10,i++)\n        {\n            int w=(cnt2+(ll)(M-pw)*v+M)%M,c=lowerBound(val[i].subList(0,val[i].size()),M-w);\n            ans=(ans+(ll)val[i].size()*w+sum[i]+(ll)(mod-M)*c)%mod;\n        }\n        cnt2+=cnt1;\n        return;\n    }\n    cnt2++;ans=(ans+(cnt2-v%M+M)%M)%mod;\n    for(int i=0;i<=9;i++) dfs2(v*10+i);\n}\nint main()\n{\n    Scanner scanner = new Scanner(System.in);\n    n = scanner.nextLong();\n    dfs1(0,0);\n    for(int i=0;i<=6;i++) Collections.sort(val[i]);\n    for(int i=1;i<=9;i++) dfs2(i);\n    System.out.println(ans);\n    return 0;\n}\n</original_code>\n\n<translated_code>\nimport java.util.*;\nimport java.util.function.IntPredicate;\nimport java.util.function.IntUnaryOperator;\nimport java.util.stream.IntStream;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long n = scanner.nextLong();\n        int M = 998244353;\n        int mod = 1_000_000_007;\n        int[][] sum = new int[10][];\n        List<Integer>[] val = new List[10];\n        for (int i = 0; i < 10; i++) {\n            val[i] = new ArrayList<>();\n            sum[i] = new int[1];\n        }\n        dfs1(0, 0, val, sum, M, mod);\n        for (int i = 0; i <= 6; i++) {\n            Collections.sort(val[i]);\n        }\n        int ans = 0;\n        dfs2(1, n, val, sum, M, mod, ans);\n        System.out.println(ans);\n    }\n\n    public static void dfs1(int d, long v, List<Integer>[] val, int[][] sum, int M, int mod) {\n        if (d > 6) return;\n        int w = ((++cnt1) - v + M) % M;\n        val[d].add(w);\n        sum[d][0] = (sum[d][0] + w) % mod;\n        for (int i = 0; i <= 9; i++) {\n            dfs1(d + 1, v * 10 + i, val, sum, M, mod);\n        }\n    }\n\n    public static void dfs2(int v, long n, List<Integer>[] val, int[][] sum, int M, int mod, int ans) {\n        if (v > n) return;\n        if (v < n / 1000000 && 10 * v > n / 1000000) {\n            for (int i = 0, pw = 1; i <= 6; pw *= 10, i++) {\n                int w = (cnt2 + (long) (M - pw) * v + M) % M;\n                int c = lowerBound(val[i], M - w);\n                ans = (ans + (long) val[i].size() * w + sum[i][0] + (long) (mod - M) * c) % mod;\n            }\n            cnt2 += cnt1;\n            return;\n        }\n        cnt2++;\n        ans = (ans + (cnt2 - v % M + M) % M) % mod;\n        for (int i = 0; i <= 9; i++) {\n            dfs2(v * 10 + i, n, val, sum, M, mod, ans);\n        }\n    }\n\n    public static int lowerBound(List<Integer> list, int value) {\n        IntPredicate predicate = x -> x < value;\n        return IntStream.range(0, list.size())\n                .filter(predicate)\n                .max()\n                .orElse(-1);\n    }\n\n    static int cnt1 = 0;\n    static int cnt2 = 0;\n}\n</translated_code>\n\n<confidence>\n0.8\n</confidence>", "token_logprobs": [-0.0899336040019989, -9.561041952110827e-05, -0.09191238135099411, -0.42750823497772217, -0.003808409906923771, -0.00637322710826993, -0.010804458521306515, -2.145769485650817e-06, -1.0848104466276709e-05, -2.3841860752327193e-07, -0.24109357595443726, -0.0044852797873318195, -5.483642325998517e-06, -0.0013073283480480313, -0.002251236466690898, -0.0005308010149747133, -0.007645253092050552, -0.0006294443155638874, -0.000848056748509407, -0.018221458420157433, -7.486623508157209e-05, -4.732720844913274e-05, -0.0011906556319445372, -4.0293551137438044e-05, -1.0728893357736524e-05, -8.344653679159819e-