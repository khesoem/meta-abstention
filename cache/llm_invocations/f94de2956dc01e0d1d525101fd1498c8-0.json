{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 0x3f3f3f3f;\nconst int MAXN = 410;\nconst int dx[4] = {-1, 0, 1, 0};\nconst int dy[4] = {0, 1, 0, -1};\n\nint n, t;\nvector<string> g, h;\nint tim[12][12], dis[12][12];\n\nstruct Edge {\n    int to, rev, cap;\n};\nvector<Edge> graph[MAXN];\n\nvoid addEdge(int u, int v, int c) {\n    graph[u].push_back({v, (int)graph[v].size(), c});\n    graph[v].push_back({u, (int)graph[u].size() - 1, 0});\n}\n\nbool bfsLevel(int s, int t, vector<int>& level) {\n    fill(level.begin(), level.end(), -1);\n    queue<int> q;\n    level[s] = 0;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        for (const Edge& e : graph[u]) {\n            if (e.cap > 0 && level[e.to] == -1) {\n                level[e.to] = level[u] + 1;\n                q.push(e.to);\n            }\n        }\n    }\n    return level[t] != -1;\n}\n\nint sendFlow(int u, int t, int pushed, vector<int>& level, vector<int>& ptr) {\n    if (u == t) return pushed;\n    for (int &cid = ptr[u]; cid < (int)graph[u].size(); ++cid) {\n        Edge &e = graph[u][cid];\n        if (level[e.to] == level[u] + 1 && e.cap > 0) {\n            int tr = sendFlow(e.to, t, min(pushed, e.cap), level, ptr);\n            if (tr > 0) {\n                e.cap -= tr;\n                graph[e.to][e.rev].cap += tr;\n                return tr;\n            }\n        }\n    }\n    return 0;\n}\n\nint maxFlow(int s, int t) {\n    int total = 0;\n    vector<int> level(MAXN);\n    while (bfsLevel(s, t, level)) {\n        vector<int> ptr(MAXN, 0);\n        while (true) {\n            int pushed = sendFlow(s, t, INF, level, ptr);\n            if (pushed == 0) break;\n            total += pushed;\n        }\n    }\n    return total;\n}\n\nbool inside(int x, int y) {\n    return x >= 0 && x < n && y >= 0 && y < n;\n}\n\nvoid bfs1(int sx, int sy) {\n    memset(tim, 0x3f, sizeof(tim));\n    queue<int> q;\n    q.push(sx * 10 + sy);\n    tim[sx][sy] = 0;\n    while (!q.empty()) {\n        int x = q.front() / 10, y = q.front() % 10;\n        q.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + dx[k], ny = y + dy[k];\n            if (inside(nx, ny) && g[nx][ny] >= '0' && g[nx][ny] <= '9' && tim[nx][ny] > tim[x][y] + 1) {\n                tim[nx][ny] = tim[x][y] + 1;\n                q.push(nx * 10 + ny);\n            }\n        }\n    }\n}\n\nvoid bfs2(int sx, int sy) {\n    memset(dis, 0x3f, sizeof(dis));\n    queue<int> q;\n    q.push(sx * 10 + sy);\n    dis[sx][sy] = 0;\n    while (!q.empty()) {\n        int x = q.front() / 10, y = q.front() % 10;\n        q.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + dx[k], ny = y + dy[k];\n            if (inside(nx, ny) && h[nx][ny] >= '0' && h[nx][ny] <= '9' && dis[nx][ny] > dis[x][y] + 1) {\n                if (tim[nx][ny] >= dis[x][y] + 1) {\n                    dis[nx][ny] = dis[x][y] + 1;\n                    if (tim[nx][ny] > dis[nx][ny])\n                        q.push(nx * 10 + ny);\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> t;\n    g.resize(n);\n    h.resize(n);\n    for (int i = 0; i < n; ++i) cin >> g[i];\n    for (int i = 0; i < n; ++i) cin >> h[i];\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (g[i][j] == 'Z')\n                bfs1(i, j);\n\n    int S = 0, T = n * n * 2 + 1;\n    for (int i = 0; i <= T; ++i) graph[i].clear();\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (g[i][j] > '0' && g[i][j] <= '9')\n                addEdge(S, i * n + j + 1, g[i][j] - '0');\n            if (h[i][j] > '0' && h[i][j] <= '9')\n                addEdge(n * n + i * n + j + 1, T, h[i][j] - '0');\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (g[i][j] > '0' && g[i][j] <= '9') {\n                bfs2(i, j);\n                for (int x = 0; x < n; ++x)\n                    for (int y = 0; y < n; ++y)\n                        if (h[x][y] > '0' && h[x][y] <= '9' && dis[x][y] <= t)\n                            addEdge(i * n + j + 1, n * n + x * n + y + 1, INF);\n            }\n\n    cout << maxFlow(S, T) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    g = [next(it).strip() for _ in range(n)]\n    h = [next(it).strip() for _ in range(n)]\n\n    # tim and dis arrays\n    tim = [[INF]*n for _ in range(n)]\n    dis = [[INF]*n for _ in range(n)]\n\n    # directions\n    dx = [-1, 0, 1, 0]\n    dy = [0, 1, 0, -1]\n\n    def inside(x, y):\n        return 0 <= x < n and 0 <= y < n\n\n    def bfs1(sx, sy):\n        # reset tim\n        for i in range(n):\n            for j in range(n):\n                tim[i][j] = INF\n        q = deque()\n        q.append(sx*10 + sy)\n        tim[sx][sy] = 0\n        while q:\n            code = q.popleft()\n            x = code // 10\n            y = code % 10\n            for k in range(4):\n                nx = x + dx[k]\n                ny = y + dy[k]\n                if inside(nx, ny) and '0' <= g[nx][ny] <= '9' and tim[nx][ny] > tim[x][y] + 1:\n                    tim[nx][ny] = tim[x][y] + 1\n                    q.append(nx*10 + ny)\n\n    def bfs2(sx, sy):\n        # reset dis\n        for i in range(n):\n            for j in range(n):\n                dis[i][j] = INF\n        q = deque()\n        q.append(sx*10 + sy)\n        dis[sx][sy] = 0\n        while q:\n            code = q.popleft()\n            x = code // 10\n            y = code % 10\n            for k in range(4):\n                nx = x + dx[k]\n                ny = y + dy[k]\n                if inside(nx, ny) and '0' <= h[nx][ny] <= '9' and dis[nx][ny] > dis[x][y] + 1:\n                    if tim[nx][ny] >= dis[x][y] + 1:\n                        dis[nx][ny] = dis[x][y] + 1\n                        if tim[nx][ny] > dis[nx][ny]:\n                            q.append(nx*10 + ny)\n\n    # run bfs1 for each 'Z' (only last one matters)\n    for i in range(n):\n        for j in range(n):\n            if g[i][j] == 'Z':\n                bfs1(i, j)\n\n    # build flow network\n    max_nodes = n*n*2 + 2\n    graph = [[] for _ in range(max_nodes)]\n\n    def add_edge(u, v, cap):\n        graph[u].append([v, len(graph[v]), cap])\n        graph[v].append([u, len(graph[u]) - 1, 0])\n\n    S = 0\n    T = n*n*2 + 1\n\n    # source edges from g digits\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                add_edge(S, i*n + j + 1, ord(g[i][j]) - ord('0'))\n    # sink edges to h digits\n    for i in range(n):\n        for j in range(n):\n            if '1' <= h[i][j] <= '9':\n                add_edge(n*n + i*n + j + 1, T, ord(h[i][j]) - ord('0'))\n\n    # edges from source cells to target cells if reachable within t\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                bfs2(i, j)\n                for x in range(n):\n                    for y in range(n):\n                        if '1' <= h[x][y] <= '9' and dis[x][y] <= t:\n                            add_edge(i*n + j + 1, n*n + x*n + y + 1, INF)\n\n    # Dinic max flow\n    def bfs_level(s, t, level):\n        for i in range(len(level)):\n            level[i] = -1\n        q = deque()\n        level[s] = 0\n        q.append(s)\n        while q:\n            u = q.popleft()\n            for e in graph[u]:\n                if e[2] > 0 and level[e[0]] == -1:\n                    level[e[0]] = level[u] + 1\n                    q.append(e[0])\n        return level[t] != -1\n\n    def send_flow(u, t, pushed, level, ptr):\n        if u == t:\n            return pushed\n        while ptr[u] < len(graph[u]):\n            e = graph[u][ptr[u]]\n            if level[e[0]] == level[u] + 1 and e[2] > 0:\n                tr = send_flow(e[0], t, min(pushed, e[2]), level, ptr)\n                if tr > 0:\n                    e[2] -= tr\n                    graph[e[0]][e[1]][2] += tr\n                    return tr\n            ptr[u] += 1\n        return 0\n\n    def max_flow(s, t):\n        total = 0\n        level = [0]*max_nodes\n        while bfs_level(s, t, level):\n            ptr = [0]*max_nodes\n            while True:\n                pushed = send_flow(s, t, INF, level, ptr)\n                if pushed == 0:\n                    break\n                total += pushed\n        return total\n\n    print(max_flow(S, T))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.007331253960728645, -2.9801878554280847e-05, 0.0, 0.0, -4.8636207793606445e-05, -0.0023987