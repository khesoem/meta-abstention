mset(dp,-1,sizeof(dp));\n\t\tans=(ans-dfs(0,n)+mod)%mod;\n\t}\n\tprintf(\"%d\",ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\nimport java.util.Arrays;\n\npublic class Main {\n    static int n, k, mod;\n    static int[] fac, inv;\n    static int[][] dp;\n\n    static int lowbit(int x) {\n        return x & -x;\n    }\n\n    static int fpow(int x, int y) {\n        long res = 1;\n        long base = x % mod;\n        while (y > 0) {\n            if ((y & 1) == 1) {\n                res = (res * base) % mod;\n            }\n            base = (base * base) % mod;\n            y >>= 1;\n        }\n        return (int) res;\n    }\n\n    static void init() {\n        fac = new int[n + 1];\n        inv = new int[n + 1];\n        fac[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            fac[i] = (int) ((long) fac[i - 1] * i % mod);\n        }\n        inv[n] = fpow(fac[n], mod - 2);\n        for (int i = n - 1; i >= 0; i--) {\n            inv[i] = (int) ((long) inv[i + 1] * (i + 1) % mod);\n        }\n    }\n\n    static int dfs(int x, int s) {\n        if (dp[x][s] != -1) return dp[x][s];\n        if (s == 0) {\n            long val = (long) fac[n] * fac[k] % mod;\n            val = val * inv[k - x] % mod;\n            dp[x][s] = (int) val;\n            return dp[x][s];\n        }\n        int now = s - lowbit(s);\n        long sum = 0;\n        // handle mask == 0 case\n        sum = (sum + (long) dfs(x + 1, 0) * inv[s]) % mod;\n        // iterate over non-zero subsets of now\n        int t = now;\n        while (t != 0) {\n            sum = (sum + (long) dfs(x + 1, t) * inv[s - t]) % mod;\n            t = (t - 1) & now;\n        }\n        dp[x][s] = (int) sum;\n        return dp[x][s];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n