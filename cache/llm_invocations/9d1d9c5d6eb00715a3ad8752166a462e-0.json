ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n = int(data[0])\n    k = int(data[1])\n    \n    base_matrix = [[None] * (MAX_K + 1) for _ in range(100)]\n    base_power = [0] * 120\n    \n    for i in range(k):\n        base_matrix[0][i] = Matrix(k + 1)\n        for j in range(k + 1):\n            base_matrix[0][i].val[i][j] = 1\n    \n    base_power[0] = 1\n    base_power[1] = k\n    lg = 2\n    while base_power[lg - 1] <= n // k:\n        base_power[lg] = base_power[lg - 1] * k\n        lg += 1\n    \n    for depth in range(1, lg):\n        base_matrix[depth][0] = Matrix(k + 1)\n        for col in range(1, k):\n            base_matrix[depth][col] = base_matrix[depth - 1][col - 1] * base_matrix[depth][col - 1]\n        right_prod = Matrix(k + 1)\n        for col in range(k - 1, -1, -1):\n            right_prod = right_prod * base_matrix[depth - 1][col]\n            base_matrix[depth][col] = base_matrix[depth][col] * right_prod\n    \n    ans = Matrix(k + 1)\n    counter = 0\n    for depth in range(lg - 1, -1, -1):\n        while base_power[depth] <= n:\n            n -= base_power[depth]\n            ans = base_matrix[depth][counter] * ans\n            counter = (counter + 1) % k\n    \n    sum_val = 0\n    for i in range(k + 1):\n        sum_val = (sum_val + ans.val[i][k]) % MOD\n    \n    print(sum_val)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002619877050165087, -5.960462772236497e-07, -5.960462772236497e-07, -0.054446183145046234, -0.00539252907037735, -0.5231612324714661, -0.004989671986550093, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -0.009766769595444202, -1.1920928244535389e-07, -3.3378546504536644e-06, 0.0, 0.0, 0.0, -8.344646857949556e-07, -3.576278118089249e-07, -0.002185458317399025, -7.033323527139146e-06, -7.152555099310121e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-0