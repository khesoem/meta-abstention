         Arrays.fill(dist, INF);\n            PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n            dist[s] = 0;\n            pq.offer(new long[]{0, s});\n            while (!pq.isEmpty()) {\n                long[] cur = pq.poll();\n                long d = cur[0];\n                int u = (int) cur[1];\n                if (d != dist[u]) continue;\n                if (u == t) break;\n                for (Edge e : G.get(u)) {\n                    if (e.flow < e.cap) {\n                        long nd = dist[u] + reduced_cost(e);\n                        if (nd < dist[e.dst]) {\n                            dist[e.dst] = nd;\n                            prev[e.dst] = e;\n                            pq.offer(new long[]{nd, e.dst});\n                        }\n                    }\n                }\n            }\n            return dist[t];\n        }\n\n        class Pair {\n            int flow;\n            long cost;\n            Pair(int f, long c) { flow = f; cost = c; }\n        }\n\n        Pair max_flow(int s, int t) {\n            int flow = 0;\n            long cost = 0;\n            for (int u = 0; u < N; u++) {\n                for (Edge e : G.get(u)) {\n                    e.flow = 0;\n                }\n            }\n            Arrays.fill(pot, 0);\n            Arrays.fill(dist, 0);\n            Arrays.fill(prev, null);\n            while (dijkstra(s, t) < INF) {\n                for (int u = 0; u < N; u++) {\n                    if (dist[u] < dist[t]) {\n                        pot[u] += dist[u] - dist[t];\n                    }\n                }\n                int f = Integer.MAX_VALUE;\n                for (Edge e = prev[t]; e != null; e = prev[e.src]) {\n                    f = Math.min(f, e.cap - e.flow);\n                }\n                for (Edge e = prev[t]; e != null; e = prev[e.src]) {\n                    e.flow += f;\n                    G.get(e.dst).get(e.rev).flow -= f;\n                }\n                flow += f;\n                cost += (long) f * (pot[t] - pot[s]);\n            }\n            return new Pair(flow, cost);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        MinCostFlow g = new MinCostFlow((n + 2) * 102);\n        for (int i = 0; i < 102; i++) {\n            g.add_edge((i * (n + 2)) + 1, i * (n + 2), 100, (long) i * c);\n        }\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < n + 1; j++) {\n                g.add_edge(j + (i * (n + 2)), j + ((i + 1) * (n + 2)), 100, 0);\n            }\n        }\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            g.add_edge(n + 1, u, 1, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    long cost = (long) ((2 * f) + 1) * d;\n                    g.add_edge(u + (j * (n + 2)), v + ((j + 1) * (n + 2)), 1, cost);\n                    g.add_edge(v + (j * (n + 2)), u + ((j + 1) * (n + 2)), 1, cost);\n                }\n            }\n        }\n        MinCostFlow.Pair result = g.max_flow(n + 1, 101 * (n + 2));\n        System.out.println(result.cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.2874520507466514e-05, 0.0, 0.0, -8.40390202938579e-05, -0.0008948612376116216, 0.0, -1.5497195136049413e-06, -0.0008958140970207751, -2.8490614567999728e-05, 0.0, -1.0132738680113107e-05, -0.0004366874636616558, -1.847726889536716e-05, -6.794906312279636e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -3.2186455882765586e-06, 0.0, -4.768370445162873e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -