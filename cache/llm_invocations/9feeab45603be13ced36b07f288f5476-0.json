r)) && __builtin_popcount(msk) >= k) {\n            ba += A[msk];\n            bb += B[msk];\n        }\n    }\n\n    return (double)(1.0L - (alp * ba + bb));\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &k);\n    for (int i = 0; i < n; ++i) scanf(\"%lf\", &p[i]);\n\n    for (int i = 0; i < n; ++i) {\n        if (i) putchar(' ');\n        printf(\"%.12f\", Solve(i));\n    }\n    putchar('\\n');\n\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = [0.0] * n\n    for i in range(n):\n        p[i] = float(data[2 + i])\n\n    def solve(vr):\n        EPS = 1e-9\n        if p[vr] < EPS:\n            return 0.0\n\n        total = 1 << n\n        A = [0.0] * total\n        B = [0.0] * total\n        A[0] = 1.0\n        B[0] = 0.0\n\n        # precompute popcount for all masks\n        popcnt = [0] * total\n        for m in range(1, total):\n            popcnt[m] = popcnt[m >> 1] + (m & 1)\n\n        for msk in range(1, total):\n            if msk & (1 << vr):\n                continue\n            a = 0.0\n            b = 0.0\n            same = 0.0\n            for i in range(n):\n                if i != vr and (msk & (1 << i)):\n                    same += p[i]\n                    a += A[msk ^ (1 << i)] * p[i]\n                    b += B[msk ^ (1 << i)] * p[i]\n            denom = 1.0 - same\n            # denom is guaranteed > 0 because p[vr] > EPS and no contradiction\n            A[msk] = a / denom\n            B[msk] = b / denom\n\n        ta = 1.0\n        tb = 0.0\n        for msk in range(1, total):\n            if not (msk & (1 << vr)):\n                ta += A[msk]\n                tb += B[msk]\n\n        alp = (1.0 - tb) / ta\n\n        ba = 0.0\n        bb = 0.0\n        for msk in range(total):\n            if not (msk & (1 << vr)) and popcnt[msk] >= k:\n                ba += A[msk]\n                bb += B[msk]\n\n        return 1.0 - (alp * ba + bb)\n\n    result = [solve(i) for i in range(n)]\n    print(' '.join(f\"{x:.12f}\" for x in result))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00014041867689229548, 0.0, -1.1920928244535389e-07, -0.00021586472576018423, -0.00010787858627736568, -4.768360213347478e-06, -0.04875980317592621, -0.0013078240444883704, -0.20340903103351593, -0.0019425348145887256, -1.9907753085135482e-05, -0.0006643710657954216, -3.2186455882765586e-06, -0.10032638907432556, 0.0, -7.819823804311454e-05, -3.576278118089249e-07, -0.8259471654891968, -2.1815061700181104e-05, -4.768370445162873e-07, -0.007713059429079294, -1.9073468138230965e-06, 0.0, -0.0011701886542141438, -7.152555099310121e-07, -9.536738616588991e-07, -4.291525328881107e-06, -8.344646857949556e-07, -0.582680344581604, -0.004134797025471926, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -0.008633904159069061, 0.0, -4.768370445162873e-07, -0.00013612773909699172, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -2.7418097943154862e-06, -3.4570634852570947e-06, -2.3841855067985307e-07, -9.214453893946484e-05, -6.318072337307967e-06, -2.3502113819122314, -4.018178462982178, -1.0728830375228426e-06, -7.152555099310121e-07, -0.04862093925476074, -0.00026425207033753395, -0.009068491868674755, -3.6954811548639555e-06, -1.1920928244535389e-07, -0.009053017012774944, -0.0003369478799868375, -3.540453326422721e-05, 0.0, -0.0007122601964510977, -3.4570634852570947e-06, -9.536738616588991e-07, -4.637133679352701e-05, -1.6689286894688848e-06, -7.152555099310121e-07, 0.0, -4.172316494077677e-06, -1.1920928244535389e-07, -0.0005529781919904053, -5.960462772236497e-07, -0.01815686747431755, -4.768370445162873e-07, -0.10026632249355316, -1.549719513604941