ng x, long y, int n) {\n        if (n >= y) return reduceFraction(x, y);\n        return searchBest(x, y, n);\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        // Commented out file input for online judge; reads from console\n        // try {\n        //     sc = new Scanner(new File(\"omg.txt\"));\n        // } catch (Exception e) { }\n        \n        long x = sc.nextLong();\n        long y = sc.nextLong();\n        int n = sc.nextInt();\n        \n        Fraction ans = solve(x, y, n);\n        \n        System.out.println(ans.numerator + \"/\" + ans.denominator);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841855e-07, 0.0, 0.0, -2.2172682e-05, -3.004029e-05, -1.4305013e-05, -0.38689855, -0.8393254, -7.5933436e-05, -2.7656173e-05, -0.074400656, -0.10032186, -0.0007228622, 0.0, -0.016911464, -0.014720517, -0.029762914, -0.040806737, -1.9226954, -0.31481633, -0.0011731654, -1.1920928e-07, -1.1920928e-07, -8.344647e-07, 0.0, -2.0265559e-06, -6.6158966e-05, -3.576278e-07, -0.00014316011, -3.576278e-07, -1.1920928e-07, -4.1723165e-06, 0.0, 0.0, -2.384183e-06, -1.1920922e-06, -2.0265559e-06, -3.576278e-07, -0.001055756, 0.0, -7.152555e-07, -1.1920928e-07, 0.0, -2.0265559e-06, -1.072883e-06, 0.0, 0.0, 0.0, -3.3378547e-06, -1.1920928e-07, 0.0, 0.0, -1.1920928e-07, -9.5367386e-07, -5.960463e-07, -1.072883e-06, 0.0, 0.0, -0.00071047334, -4.2915253e-06, -5.960463e-07, -2.1269352, -3.635817e-05, -1.4305105e-06, -3.6715788e-05, -0.21646301, -0.030907938, -0.00072047976, -2.3841855e-07, -3.194758e-05, -2.5639558, -0.038071826, 0.0, 0.0, -3.6954812e-06, -5.5192377e-05, -0.69315016, 0.0, -0.000335637, -4.8278598e-05, -0.6701332, -2.3841855e-07, 0.0, -1.4305105e-06, -0.00033825875, -1.072883e-06, -2.7418098e-06, -0.20179473, -1.1920928e-07, -1.1920928e-07, 0.0, 0.0, -8.344647e-07, 0.0, -3.576278e-07, -7.2717403e-06, -1.1920928e-07, 0.0, 0.0, -1.19209