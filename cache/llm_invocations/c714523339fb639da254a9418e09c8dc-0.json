j - 1) * n, y + j * n, float('inf'), C + d, 1)\n            add_edge(y + (j - 1) * n, x + j * n, float('inf'), C + d, 1)\n    \n    INF = 10**18\n    \n    def flow():\n        nonlocal es\n        mi = [INF] * (EE + 1)\n        lt = [-1] * (EE + 1)\n        used = [0] * (EE + 1)\n        bfs = [0] * 10000000\n        \n        mi[0] = 0\n        rr = 1\n        bfs[0] = 0\n        \n        for i in range(rr):\n            x = bfs[i]\n            used[x] = 0\n            for j in range(len(e[x])):\n                r = e[x][j]\n                if es[r].c > 0 and mi[x] + es[r].v < mi[es[r].y]:\n                    mi[es[r].y] = mi[x] + es[r].v\n                    lt[es[r].y] = r\n                    if not used[es[r].y]:\n                        used[es[r].y] = 1\n                        bfs[rr] = es[r].y\n                        rr += 1\n        \n        if mi[EE] == INF:\n            return -1\n        \n        now = EE\n        while now:\n            r = lt[now]\n            if es[r].ty == 1:\n                if (r & 1) == 1:\n                    es[r].v += 2 * d\n                    es[r ^ 1].v -= 2 * d\n                else:\n                    es[r].v += 2 * d\n                    es[r ^ 1].v -= 2 * d\n            es[r].c -= 1\n            es[r ^ 1].c += 1\n            now = es[r ^ 1].y\n        \n        return mi[EE]\n    \n    total = 0\n    for _ in range(k):\n        res = flow()\n        if res != -1:\n            total += res\n    \n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00032443503732793033, -1.5497195136049413e-06, -3.576278118089249e-07, -0.007215393707156181, -0.00032491172896698117, -0.0036047021858394146, -0.011279742233455181, -0.0002554328821133822, -7.152555099310121e-07, -0.020554980263113976, -0.283559650182724, -0.20795230567455292, -7.152555099310121e-07, -0.0019301610300317407, 0.0, -7.033323527139146e-06, -0.016046782955527306, 0.0, -5