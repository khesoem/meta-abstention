{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXS = 100000 + 10;\nconst int MOD = 1000000007;\nusing ull = unsigned long long;\n\nint n, tot = 0;\nint go[MAXS][64];\nint p[10][10];\nint q[10][64];\nint f[10][MAXS];\nmap<ull,int> id;\n\nint qpow(int a,int b) {\n    int res = 1;\n    while(b) {\n        if(b & 1) res = 1LL * res * a % MOD;\n        a = 1LL * a * a % MOD;\n        b >>= 1;\n    }\n    return res;\n}\n\null transition(ull s,int mask) {\n    ull t = s;\n    int M = 1 << n;\n    for(int j = 0; j < M; ++j)\n        for(int k = 0; k < n; ++k)\n            if(((j >> k) & 1) && ((mask >> k) & 1) && ((s >> (j ^ (1 << k))) & 1))\n                t |= (1ull << j);\n    return t;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n;\n\n    stack<ull> st;\n    id[1] = ++tot;\n    st.push(1);\n\n    while(!st.empty()) {\n        ull s = st.top();\n        st.pop();\n        int cur = id[s];\n        int M = 1 << n;\n\n        for(int mask = 0; mask < M; ++mask) {\n            ull ns = transition(s, mask);\n            auto it = id.find(ns);\n            if(it == id.end()) {\n                id[ns] = ++tot;\n                st.push(ns);\n                it = id.find(ns);\n            }\n            go[cur][mask] = it->second;\n        }\n    }\n\n    for(int i = 0; i < n; ++i)\n        for(int j = 0; j < n; ++j) {\n            cin >> p[i][j];\n            p[i][j] = 1LL * p[i][j] * qpow(100, MOD - 2) % MOD;\n        }\n\n    for(int i = 0; i < n; ++i)\n        for(int mask = 0; mask < (1 << n); ++mask) {\n            q[i][mask] = 1;\n            for(int k = 0; k < n; ++k) {\n                if((mask >> k) & 1)\n                    q[i][mask] = 1LL * q[i][mask] * p[k][i] % MOD;\n                else\n                    q[i][mask] = 1LL * q[i][mask] * (MOD + 1 - p[k][i]) % MOD;\n            }\n        }\n\n    f[0][1] = 1;\n    for(int i = 0; i < n; ++i)\n        for(int j = 1; j <= tot; ++j)\n            for(int mask = 0; mask < (1 << n); ++mask)\n                f[i + 1][go[j][mask]] = (f[i + 1][go[j][mask]] + 1LL * f[i][j] * q[i][mask]) % MOD;\n\n    if(n < 6)\n        cout << f[n][id[(1ull << (1 << n)) - 1]] << '\\n';\n    else\n        cout << f[n][id[ULLONG_MAX]] << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef qpow(a, b):\n    return pow(a, b, MOD)\n\ndef transition(s, mask, n):\n    M = 1 << n\n    t = s\n    for j in range(M):\n        for k in range(n):\n            if ((j >> k) & 1) and ((mask >> k) & 1) and ((s >> (j ^ (1 << k))) & 1):\n                t |= (1 << j)\n    return t\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n\n    # Build automaton states\n    id_map = {1: 1}  # state -> index (1-indexed)\n    tot = 1\n    stack = [1]\n    go = [[]]  # dummy for index 0\n    while stack:\n        s = stack.pop()\n        cur = id_map[s]\n        M = 1 << n\n        # Ensure go list has enough rows\n        while len(go) <= cur:\n            go.append([])\n        for mask in range(M):\n            ns = transition(s, mask, n)\n            if ns not in id_map:\n                tot += 1\n                id_map[ns] = tot\n                stack.append(ns)\n            go[cur].append(id_map[ns])\n\n    # Read probabilities\n    p = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            val = int(next(it))\n            p[i][j] = val * qpow(100, MOD-2) % MOD\n\n    # Compute q[i][mask]\n    M = 1 << n\n    q = [[0]*M for _ in range(n)]\n    for i in range(n):\n        for mask in range(M):\n            prod = 1\n            for k in range(n):\n                if (mask >> k) & 1:\n                    prod = prod * p[k][i] % MOD\n                else:\n                    prod = prod * (MOD + 1 - p[k][i]) % MOD\n            q[i][mask] = prod\n\n    # DP\n    f = [[0]*(tot+1) for _ in range(n+1)]\n    f[0][1] = 1\n    for i in range(n):\n        for j in range(1, tot+1):\n            for mask in range(M):\n                nxt = go[j][mask]\n                f[i+1][nxt] = (f[i+1][nxt] + f[i][j] * q[i][mask]) % MOD\n\n    # Final state\n    if n < 6:\n        final_state = (1 << (1 << n)) - 1\n    else:\n        final_state = (1 << 64) - 1  # ULLONG_MAX\n    ans = f[n][id_map[final_state]]\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -0.0005650115781463683, -0.16456733644008636, -3.814689989667386e-06, -0.2519431412220001, -0.017348328605294228, -1.1920928244535389e-07, -2.0265558760002023e-06, -0.0004102342063561082, -8.344646857949556e-07, 0.0, -1.4305104514278355e-06, -0.16022704541683197, -8.701899787411094e-05, -0.003306400263682008, 0.0, 0.0, -0.005279408767819405, 0.0, -2.002696055569686e-05, -1.1920928244535389e-07, -0.00047279146