 dp[i][j] += mod\n\n        # sums[i][j] = prefix sum of dp[i][0..j] modulo mod\n        sums = [[0] * max_j for _ in range(n)]\n        for i in range(n):\n            s = 0\n            for j in range(max_j):\n                s += dp[i][j]\n                s %= mod\n                if s == 0:\n                    s += mod\n                sums[i][j] = s\n\n        # factorials up to 501*501\n        fact_len = 501 * 501\n        fact = [1] * fact_len\n        for i in range(2, fact_len):\n            fact[i] = (fact[i - 1] * i) % mod\n            if fact[i] == 0:\n                fact[i] += mod\n\n        # nCr up to 500\n        ncr = [[0] * 501 for _ in range(501)]\n        ncr[0][0] = 1\n        for i in range(1, 501):\n            ncr[i][0] = 1\n            for j in range(1, 501):\n                ncr[i][j] = (ncr[i - 1][j] + ncr[i - 1][j - 1]) % mod\n                if ncr[i][j] == 0:\n                    ncr[i][j] += mod\n\n        res = 0\n        for i in range(n - 2, -1, -1):\n            cnt = n - i\n            pre = n - cnt\n            com = (ncr[n][pre] * fact[pre]) % mod\n            if com == 0:\n                com += mod\n            total = 0\n            for dif in range(1, cnt):\n                for inv in range(dif, max_j):\n                    val = dp[cnt - 2][inv]\n                    if val == 0:\n                        break\n                    if inv - dif - 1 < 0:\n                        continue\n                    y = sums[cnt - 2][inv - dif - 1]\n                    x = val * y\n                    x %= mod\n                    if x == 0:\n                        x += mod\n                    total += x * (cnt - dif)\n                    total %= mod\n            res += total * com\n            res %= mod\n            if res == 0:\n                res += mod\n        out = res % mod\n        sys.stdout.write(str(out) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "to