{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <string>\nusing namespace std;\n\nint n, t;\nstring a[30], b[30];\nint d1[30][30], d2[30][30];\nint dx[] = {0,0,-1,1};\nint dy[] = {1,-1,0,0};\n\nstruct Edge {\n    int a, b, cap, flow;\n};\nvector<Edge> e;\nvector<int> g[1000];\nint source, sink;\nint di[1000], ptr[1000], q[1000];\n\nvoid add_edge(int a, int b, int cap) {\n    e.push_back({a,b,cap,0});\n    e.push_back({b,a,0,0});\n    g[a].push_back(e.size()-2);\n    g[b].push_back(e.size()-1);\n}\n\nbool ok(int x, int y) { return x>=0 && x<n && y>=0 && y<n; }\n\nvoid bfs1(int sx, int sy) {\n    for (int i=0;i<30;i++) for (int j=0;j<30;j++) d1[i][j]=1e9;\n    queue<pair<int,int>> qq;\n    qq.push({sx,sy});\n    d1[sx][sy]=0;\n    while (!qq.empty()) {\n        int x=qq.front().first, y=qq.front().second; qq.pop();\n        for (int i=0;i<4;i++) {\n            int nx=x+dx[i], ny=y+dy[i];\n            if (ok(nx,ny) && d1[nx][ny]>=1e9 && b[nx][ny]!='Y') {\n                d1[nx][ny]=d1[x][y]+1;\n                qq.push({nx,ny});\n            }\n        }\n    }\n}\n\nbool bfs() {\n    memset(di,-1,sizeof(di));\n    int qh=0, qt=0;\n    q[qt++]=source;\n    di[source]=0;\n    while (qh<qt && di[sink]==-1) {\n        int v=q[qh++];\n        for (int id : g[v]) {\n            int to=e[id].b;\n            if (di[to]==-1 && e[id].flow<e[id].cap) {\n                q[qt++]=to;\n                di[to]=di[v]+1;\n            }\n        }\n    }\n    return di[sink]!=-1;\n}\n\nint dfs(int v, int flow) {\n    if (!flow) return 0;\n    if (v==sink) return flow;\n    for (;ptr[v]<(int)g[v].size();ptr[v]++) {\n        int id=g[v][ptr[v]], to=e[id].b;\n        if (di[to]!=di[v]+1) continue;\n        int pushed=dfs(to,min(flow,e[id].cap-e[id].flow));\n        if (pushed) {\n            e[id].flow+=pushed;\n            e[id^1].flow-=pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nint max_flow() {\n    int flow=0;\n    while (bfs()) {\n        memset(ptr,0,sizeof(ptr));\n        while (int pushed=dfs(source,1e9)) flow+=pushed;\n    }\n    return flow;\n}\n\nvoid bfs2(int sx, int sy) {\n    for (int i=0;i<30;i++) for (int j=0;j<30;j++) d2[i][j]=1e9;\n    queue<pair<int,int>> qq;\n    qq.push({sx,sy});\n    d2[sx][sy]=0;\n    while (!qq.empty()) {\n        int x=qq.front().first, y=qq.front().second; qq.pop();\n        if (d2[x][y]>=d1[x][y]) continue;\n        for (int i=0;i<4;i++) {\n            int nx=x+dx[i], ny=y+dy[i];\n            if (ok(nx,ny) && d2[nx][ny]>=1e9 && a[nx][ny]!='Y' && d2[x][y]+1<=d1[nx][ny]) {\n                d2[nx][ny]=d2[x][y]+1;\n                qq.push({nx,ny});\n            }\n        }\n    }\n}\n\nint main() {\n    cin>>n>>t;\n    for (int i=0;i<n;i++) cin>>a[i];\n    int wx=0, wy=0;\n    for (int i=0;i<n;i++) {\n        cin>>b[i];\n        for (int j=0;j<n;j++) {\n            if (b[i][j]=='Z') {\n                b[i][j]=a[i][j]='Y';\n                wx=i; wy=j;\n            }\n        }\n    }\n    bfs1(wx,wy);\n    source=0; sink=2*n*n+1;\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<n;j++) {\n            if (a[i][j]=='Y') continue;\n            int what=i*n+j+1;\n            int what2=n*n+i*n+j+1;\n            add_edge(source,what,a[i][j]-'0');\n            add_edge(what2,sink,b[i][j]-'0');\n            bfs2(i,j);\n            for (int x=0;x<n;x++) {\n                for (int y=0;y<n;y++) {\n                    if (b[x][y]=='Y' || d2[x][y]>t) continue;\n                    add_edge(what,n*n+x*n+y+1,a[i][j]-'0');\n                }\n            }\n        }\n    }\n    n=2*n*n+5;\n    cout<<max_flow()<<endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n\n    wx = wy = -1\n    for i in range(n):\n        for j in range(n):\n            if b[i][j] == 'Z':\n                b[i][j] = 'Y'\n                a[i][j] = 'Y'\n                wx, wy = i, j\n\n    # BFS1 from (wx, wy) to compute d1\n    d1 = [[INF]*n for _ in range(n)]\n    q = deque()\n    q.append((wx, wy))\n    d1[wx][wy] = 0\n    dx = [0,0,-1,1]\n    dy = [1,-1,0,0]\n    def ok(x, y):\n        return 0 <= x < n and 0 <= y < n\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx, ny = x+dx[k], y+dy[k]\n            if ok(nx, ny) and d1[nx][ny] >= INF and b[nx][ny] != 'Y':\n                d1[nx][ny] = d1[x][y] + 1\n                q.append((nx, ny))\n\n    # Dinic max flow\n    N = 2*n*n + 2\n    source = 0\n    sink = 2*n*n + 1\n    graph = [[] for _ in range(N)]\n\n    def add_edge(fr, to, cap):\n        graph[fr].append([to, cap, len(graph[to])])\n        graph[to].append([fr, 0, len(graph[fr])-1])\n\n    level = [0]*N\n    it_ptr = [0]*N\n\n    def bfs_level():\n        for i in range(N):\n            level[i] = -1\n        q = deque()\n        level[source] = 0\n        q.append(source)\n        while q:\n            v = q.popleft()\n            for to, cap, rev in graph[v]:\n                if cap > 0 and level[to] < 0:\n                    level[to] = level[v] + 1\n                    q.append(to)\n        return level[sink] >= 0\n\n    def dfs_flow(v, f):\n        if v == sink:\n            return f\n        for i in range(it_ptr[v], len(graph[v])):\n            it_ptr[v] = i\n            to, cap, rev = graph[v][i]\n            if cap > 0 and level[v] + 1 == level[to]:\n                ret = dfs_flow(to, min(f, cap))\n                if ret > 0:\n                    graph[v][i][1] -= ret\n                    graph[to][rev][1] += ret\n                    return ret\n        return 0\n\n    def max_flow():\n        flow = 0\n        while bfs_level():\n            for i in range(N):\n                it_ptr[i] = 0\n            while True:\n                pushed = dfs_flow(source, INF)\n                if pushed == 0:\n                    break\n                flow += pushed\n        return flow\n\n    # Build graph\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Y':\n                continue\n            node1 = i*n + j + 1\n            node2 = n*n + i*n + j + 1\n            cap_a = int(a[i][j])\n            cap_b = int(b[i][j])\n            add_edge(source, node1, cap_a)\n            add_edge(node2, sink, cap_b)\n\n            # BFS2 from (i,j) to compute d2\n            d2 = [[INF]*n for _ in range(n)]\n            q = deque()\n            q.append((i, j))\n            d2[i][j] = 0\n            while q:\n                x, y = q.popleft()\n                if d2[x][y] >= d1[x][y]:\n                    continue\n                for k in range(4):\n                    nx, ny = x+dx[k], y+dy[k]\n                    if ok(nx, ny) and d2[nx][ny] >= INF and a[nx][ny] != 'Y' and d2[x][y] + 1 <= d1[nx][ny]:\n                        d2[nx][ny] = d2[x][y] + 1\n                        q.append((nx, ny))\n\n            # Add edges from node1 to sink-side nodes\n            for x in range(n):\n                for y in range(n):\n                    if b[x][y] == 'Y' or d2[x][y] > t:\n                        continue\n                    add_edge(node1, n*n + x*n + y + 1, cap_a)\n\n    print(max_flow())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.00016139635408762842, -1.1920928244535389e-07, 0.0, -0.00013684290752280504, -0.03018263541162014, -2.777537883957848e-05, -2.145764938177308e-06, -1.7404405298293568e-05, 0.0, 0.0, -1.9073468138230965e-06, -0.0019459851318970323, -0.2563926577568054, -2.50339189733495e-06, -4.172316494077677e-06, -7.748573807475623e-06, -0.10020788013935089, -5.960462772236497e-07, -0.011106573045253754, -0.02754848450422287, -0.6730639934539795, -0.3869325518608093, -5.960462772236497e-07, -0.3221730589866638, -1.7881377516459906e-06, -1.1324817933200393e-05, -1.1920928244535389e-07, -2.3245540432981215e-05, -1.1920928244535389e-07, -0.693149209022522, -0.008626221679151058, -4.768370445162873e-07, -0.03818313032388687, -1.0728830375228426e-06, 0.0, -0.0019286142196506262, -3.576278118089249e-07, 0.0, -1.6689286894688848e-06, -2.3841855067985307e-07, -0.0074616544879972935, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -1.4305104514278355e-06, -2.3841855067985307e-07, -1.5497195136049413e-06, -5.125986263010418e-06, 0.0, -1.1920928244535389e-07, 0.0, -3.838465272565372e-05, 0.0, -0.0009234455064870417, -4.565611743601039e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -0.004078998696058989, -0.011048096232116222, -0.0002076410164590925, -2.264974000354414e-06, -0.10175282508134842, -0.0032806170638650656, -1.0728830375228426e-06, 0.0, -0.16023039817810059, -7.9869