n[0] > n || tmin[1] > n) continue;\n            if ((tmin[0] <= n && tmax[0] >= n) || (tmin[1] <= n && tmax[1] >= n)) {\n                int val;\n                if ((tmax[0] < n && side == 1) || (tmax[1] < n && side == 0)) {\n                    val = numRotates + 1;\n                } else {\n                    val = numRotates;\n                }\n                if (minRotates == 0) minRotates = val;\n                else minRotates = Math.min(minRotates, val);\n                continue;\n            }\n            if (koffset == k) continue;\n\n            if (isInterval) {\n                if (kbeg[koffset] == kend[koffset]) {\n                    // no rotate\n                    stack.push(new State(side, tmin, tmax, noffset, koffset + 1, false, numRotates));\n                    // rotate\n                    stack.push(new State(1 - side, tmin, tmax, noffset, koffset + 1, false, numRotates + 1));\n                } else {\n                    int diff = kend[koffset] - kbeg[koffset];\n                    // no rotate\n                    int[] tmin1 = tmin.clone();\n                    int[] tmax1 = tmax.clone();\n                    tmin1[side] += diff;\n                    tmax1[side] += diff;\n                    stack.push(new State(side, tmin1, tmax1, kend[koffset], koffset + 1, false, numRotates));\n\n                    // rotate once\n                    int[] tmin2 = tmin.clone();\n                    int[] tmax2 = tmax.clone();\n                    tmax2[side] += diff;\n                    tmax2[1 - side] += diff;\n                    stack.push(new State(1 - side, tmin2, tmax2, kend[koffset], koffset + 1, false, numRotates + 1));\n\n                    // rotate twice\n                    int[] tmin3 = tmin.clone();\n                    int[] tmax3 = tmax.clone();\n                    tmax3[side] += diff;\n                    tmin3[1 - side] += 1;\n                    tmax3[1 - side] += diff - 1;\n                    stack.push(new State(side,