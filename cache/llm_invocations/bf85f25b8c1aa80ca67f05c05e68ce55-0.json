et(p[1]);\n            _Edge re = g.get(e.to).get(e.rev);\n            return new Edge(p[0], e.to, e.cap + re.cap, re.cap, e.cost);\n        }\n\n        List<Edge> edges() {\n            List<Edge> res = new ArrayList<>();\n            for (int i = 0; i < pos.size(); i++) {\n                int[] p = pos.get(i);\n                _Edge e = g.get(p[0]).get(p[1]);\n                _Edge re = g.get(e.to).get(e.rev);\n                res.add(new Edge(p[0], e.to, e.cap + re.cap, re.cap, e.cost));\n            }\n            return res;\n        }\n\n        // Bellman-Ford to find shortest path from s to t\n        boolean bellmanFord(int s, int t) {\n            long INF_DIST = Long.MAX_VALUE / 2;\n            long[] dist = new long[n];\n            int[] pv = new int[n];\n            int[] pe = new int[n];\n            Arrays.fill(dist, INF_DIST);\n            Arrays.fill(pv, -1);\n            Arrays.fill(pe, -1);\n            dist[s] = 0;\n            for (int iter = 0; iter < n - 1; iter++) {\n                boolean updated = false;\n                for (int v = 0; v < n; v++) {\n                    if (dist[v] == INF_DIST) continue;\n                    List<_Edge> edges = g.get(v);\n                    for (int i = 0; i < edges.size(); i++) {\n                        _Edge e = edges.get(i);\n                        if (e.cap == 0) continue;\n                        long nd = dist[v] + e.cost;\n                        if (dist[e.to] > nd) {\n                            dist[e.to] = nd;\n                            pv[e.to] = v;\n                            pe[e.to] = i;\n                            updated = true;\n                        }\n                    }\n                }\n                if (!updated) break;\n            }\n            if (dist[t] == INF_DIST) return false;\n            // store for later use\n            this.pv = pv;\n            this.pe = pe;\n            this.dist = dist;\n            return true;\n        }\n\n        int[] pv;\n        int[] pe;\n        long[] dist;\n\n        List<long[]> slope(int s, int t, long flowLimit) {\n            long flow = 0;\n            long cost = 0;\n            long prevCost = -1;\n            List<long[]> result = new ArrayList<>();\n            result.add(new long[]{flow, cost});\n            while (flow < flowLimit) {\n                if (!bellmanFord(s, t)) break;\n                long c = flowLimit - flow;\n                int v = t;\n                while (v != s) {\n                    c = Math.min(c, g.get(pv[v]).get(pe[v]).cap);\n                    v = pv[v];\n                }\n                v = t;\n                while (v != s) {\n                    _Edge e = g.get(pv[v]).get(pe[v]);\n                    e.cap -= c;\n                    g.get(v).get(e.rev).cap += c;\n                    v = pv[v];\n                }\n                long d = dist[t];\n                flow += c;\n                cost += c * d;\n                if (prevCost == d) {\n                    result.remove(result.size() - 1);\n                }\n                result.add(new long[]{flow, cost});\n                prevCost = d;\n            }\n            return result;\n        }\n\n        long[] flow(int s, int t, long flowLimit) {\n            List<long[]> sl = slope(s, t, flowLimit);\n            return sl.get(sl.size() - 1);\n        }\n\n        long[] flow(int s, int t) {\n            return flow(s, t, Long.MAX_VALUE);\n        }\n\n        static class _Edge {\n            int to, rev;\n            long cap, cost;\n            _Edge(int to, int rev, long cap, long cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt(); // not used\n        long a1 = sc.nextLong();\n        long a2 = sc.nextLong();\n        long a3 = sc.nextLong();\n        long b1 = sc.nextLong();\n        long b2 = sc.nextLong();\n        long b3 = sc.nextLong();\n\n        MCF g = new MCF(8);\n        g.addEdge(0, 1, a1, 0);\n        g.addEdge(0, 2, a2, 0);\n        g.addEdge(0, 3, a3, 0);\n        g.addEdge(4, 7, b1, 0);\n        g.addEdge(5, 7, b2, 0);\n        g.addEdge(6, 7, b3, 0);\n        for (int i = 1; i <= 3; i++) {\n            for (int j = 4; j <= 6; j++) {\n                long cost = ((j - i) % 3 == 1) ? 1 : 0;\n                g.addEdge(i, j, INF, cost);\n            }\n        }\n\n        long[] res = g.flow(0, 7);\n        long ans1 = res[1]; // cost\n        long ans2 = Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n        System.out.println(ans1 + \" \" + ans2);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.00011181206355104223, -4.446407547220588e-05, 0.0, -9.60780744208023e-05, -0.06775305420160294, -0.029782701283693314, -1.1920928244535389e-07, -0.13473401963710785, -0.014168502762913704, -0.0024791003670543432, -0.018217036500573158, -0.2069098949432373, -2.169585604860913e-05, -1.0728830375228426e-06, -0.10165838897228241, -0.6951921582221985, -0.5797432661056519, -3.099436753473128e-06, -7.152555099310121e-07, -0.030684148892760277, -0.033532459288835526, -0.8718969821929932, -0.006773724220693111, -0.004771038889884949, -0.061968062072992325, -0.004079591948539019, 0.0, -0.17159143090248108, -2.3841855067985307e-07, -0.07906192541122437, -5.125986263010418e-06, -0.06144635006785393, -2.3841855067985307e-07, -8.106198947643861e-06, -1.1920928244535389e-07, -0.029505185782909393, -1.6689160474925302e-05, -2.622600959512056e-06, -1.1920928244535389e-07, -0.13343296945095062, -0.1253497153520584, -4.768370445162873e-07, -4.529942543740617e-06, -0.4201827347278595, -0.0005183068569749594, -0.7532031536102295, -0.007931877858936787, -0.7768462300300598, -0.000159846880