{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int N = 10000010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, s = 0, t, ans = 0;\nint cnt = 1, hed[N], to[N], nxt[N], val[N], w[N];\nint dis[N], incf[N], pre[N]; bool inq[N];\n\nvoid add(int x, int y, int z, int v) {\n    to[++cnt] = y, nxt[cnt] = hed[x], hed[x] = cnt, val[cnt] = z, w[cnt] = v;\n    to[++cnt] = x, nxt[cnt] = hed[y], hed[y] = cnt, val[cnt] = 0, w[cnt] = -v;\n}\n\nbool spfa() {\n    memset(incf, 0, sizeof(incf)), memset(dis, INF, sizeof(dis));\n    memset(inq, 0, sizeof(inq)); queue<int> q;\n    q.push(s), incf[s] = INF, inq[s] = 1, dis[s] = 0;\n    for(; !q.empty();) {\n        int u = q.front(); q.pop(); inq[u] = 0;\n        for(int i = hed[u]; i; i = nxt[i]) {\n            if(!val[i] || dis[to[i]] <= dis[u] + w[i]) continue;\n            dis[to[i]] = dis[u] + w[i];\n            incf[to[i]] = min(incf[u], val[i]);\n            pre[to[i]] = i; if(!inq[to[i]]) inq[to[i]] = 1, q.push(to[i]);\n        }\n    }\n    return dis[t] != INF;\n}\n\nvoid update() {\n    int tmp = t;\n    for(; tmp != s;) {\n        int i = pre[tmp];\n        val[i] -= incf[t], val[i ^ 1] += incf[t], tmp = to[i ^ 1];\n    }\n    ans += incf[t] * dis[t];\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d), t = (n + k - 1) * n + 1;\n    for(int i = 1, x; i <= k; i++) scanf(\"%d\", &x), add(s, x, 1, 0);\n    for(int i = 1, x, y; i <= m; i++) {\n        scanf(\"%d%d\", &x, &y);\n        for(int j = 1; j <= n + k; j++)\n            for(int h = 1; h <= k; h++) {\n                add(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n                add(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c);\n            }\n    }\n    for(int i = 1; i < n + k; i++) {\n        for(int j = 2; j <= n; j++)\n            add(j + (i - 1) * n, j + i * n, INF, c);\n        add(1 + (i - 1) * n, 1 + i * n, INF, 0);\n    }\n    for(; spfa();) update();\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    s = 0\n    t = (n + k - 1) * n + 1\n    max_nodes = t + 2  # include 0 and t\n    # adjacency list\n    hed = [0] * (max_nodes + 1)  # 1-indexed nodes, but we use 0..t, so size t+2\n    # edge arrays, 1-indexed\n    to = [0]\n    nxt = [0]\n    val = [0]\n    w = [0]\n    cnt = 1\n\n    def add_edge(x, y, z, v):\n        nonlocal cnt\n        # forward edge\n        to.append(y)\n        nxt.append(hed[x])\n        hed[x] = cnt\n        val.append(z)\n        w.append(v)\n        cnt += 1\n        # backward edge\n        to.append(x)\n        nxt.append(hed[y])\n        hed[y] = cnt\n        val.append(0)\n        w.append(-v)\n        cnt += 1\n\n    INF = 10**18\n    # read starting positions\n    for _ in range(k):\n        x = next(it)\n        add_edge(s, x, 1, 0)\n\n    # read roads\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for j in range(1, n + k + 1):\n            for h in range(1, k + 1):\n                cost = d * (2 * h - 1) + c\n                add_edge(x + (j - 1) * n, y + j * n, 1, cost)\n                add_edge(y + (j - 1) * n, x + j * n, 1, cost)\n\n    # staying edges\n    for i in range(1, n + k):\n        for j in range(2, n + 1):\n            add_edge(j + (i - 1) * n, j + i * n, INF, c)\n        add_edge(1 + (i - 1) * n, 1 + i * n, INF, 0)\n\n    dis = [INF] * (max_nodes + 1)\n    incf = [0] * (max_nodes + 1)\n    pre = [0] * (max_nodes + 1)\n    inq = [False] * (max_nodes + 1)\n\n    def spfa():\n        nonlocal dis, incf, pre, inq\n        dis = [INF] * (max_nodes + 1)\n        incf = [0] * (max_nodes + 1)\n        pre = [0] * (max_nodes + 1)\n        inq = [False] * (max_nodes + 1)\n        q = deque()\n        q.append(s)\n        incf[s] = INF\n        inq[s] = True\n        dis[s] = 0\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            i = hed[u]\n            while i:\n                if val[i] and dis[to[i]] > dis[u] + w[i]:\n                    dis[to[i]] = dis[u] + w[i]\n                    incf[to[i]] = min(incf[u], val[i])\n                    pre[to[i]] = i\n                    if not inq[to[i]]:\n                        inq[to[i]] = True\n                        q.append(to[i])\n                i = nxt[i]\n        return dis[t] != INF\n\n    ans = 0\n    while spfa():\n        tmp = t\n        while tmp != s:\n            i = pre[tmp]\n            val[i] -= incf[t]\n            val[i ^ 1] += incf[t]\n            tmp = to[i ^ 1]\n        ans += incf[t] * dis[t]\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0003067976504098624, -1.1920928244535389e-07, 0.0, -0.0001337438