ill(flow, 0);\n        Arrays.fill(prev_node, -1);\n        Arrays.fill(prev_edge, -1);\n        Arrays.fill(in_queue, false);\n        \n        Queue<Integer> q = new LinkedList<>();\n        dist[source] = 0;\n        flow[source] = INF;\n        q.offer(source);\n        in_queue[source] = true;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            in_queue[u] = false;\n            \n            for (int i = head[u]; ~i != 0; i = edges.get(i).next) {\n                int v = edges.get(i).to;\n                int cap = edges.get(i).cap;\n                int cost = edges.get(i).cost;\n                \n                if (cap > 0 && dist[v] > dist[u] + cost) {\n                    dist[v] = dist[u] + cost;\n                    flow[v] = Math.min(flow[u], cap);\n                    prev_node[v] = u;\n                    prev_edge[v] = i;\n                    if (!in_queue[v]) {\n                        q.offer(v);\n                        in_queue[v] = true;\n                    }\n                }\n            }\n        }\n        \n        return prev_node[sink] != -1;\n    }\n    \n    static int max_flow, min_cost;\n    \n    static void mcmf() {\n        while (spfa()) {\n            int flow_here = flow[sink];\n            max_flow += flow_here;\n            min_cost += flow_here * dist[sink];\n            \n            int cur = sink;\n            while (cur != source) {\n                Edge e = edges.get(prev_edge[cur]);\n                e.cap -= flow_here;\n                edges.get(prev_edge[cur] ^ 1).cap += flow_here;\n                cur = prev_node[cur];\n            }\n        }\n    }\n    \n    static class FastScanner {\n        BufferedReader br;\n        StringTokenizer st;\n        \n        public FastScanner(InputStream s) {\n            br = new BufferedReader(new InputStreamReader(s));\n        }\n        \n        String next() throws IOException {\n            while (st == null || !st.hasMoreTokens()) {\n