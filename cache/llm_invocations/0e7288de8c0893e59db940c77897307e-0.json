e;\n    getline(cin, line);\n    auto split = [](const string& s, char delim) {\n        vector<string> tokens;\n        string token;\n        for (char c : s) {\n            if (c == delim) {\n                if (!token.empty()) {\n                    tokens.push_back(token);\n                    token.clear();\n                }\n            } else {\n                token += c;\n            }\n        }\n        if (!token.empty()) {\n            tokens.push_back(token);\n        }\n        return tokens;\n    };\n    \n    vector<string> tokens = split(line, ' ');\n    long long n = stoll(tokens[0]);\n    long long mod = stoll(tokens[1]);\n    \n    if (n == 0) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    vector<long long> mem(n + 1, 0);\n    mem[1] = 1;\n    \n    for (long long i = 2; i <= n; i++) {\n        long long cur = 1;  // represents mem[1] contribution\n        long long limit = (long long)sqrt(i) + 1;\n        \n        for (long long f = 2; f < min(limit, i + 1); f++) {\n            if (i / f >= 1) {\n                cur = (cur + mem[i / f]) % mod;\n            }\n        }\n        \n        long long be = i;\n        long long j = 1;\n        while (j <= i / limit) {\n            long long next_val = i / (j + 1);\n            cur = (cur + (be - next_val) * mem[j]) % mod;\n            be = next_val;\n            j++;\n        }\n        \n        mem[i] = cur;\n    }\n    \n    cout << mem[n] % mod << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.319182623177767e-05, -2.145764938177308e-06, -1.1920928244535389e-07, -3.707340147229843e-05, -2.3841855067985307e-07, -0.0001911934232339263, -1.4305104514278355e-06, -9.536738616588991e-07, -1.1920928244535389e-07, -0.6487606763839722, -7.152555099310121e-07, -2.264974000354414e-06, -1.1920928244535389e-07, -2.062299427052494e-05, -0.008615112863481045, -0.12693928182125092, -1.6689286894688848e-06, -0.04313293471932411