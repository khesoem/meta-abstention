{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing int64 = long long;\n\nconstexpr int64 MOD = 1000000007LL;\n\nint64 pow_mod(int64 base, int64 exp) {\n    int64 result = 1;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return result;\n}\n\nstruct UnionFind {\n    vector<int> parent;\n    vector<int> height;\n    int numComponents;\n    \n    explicit UnionFind(int size) : parent(size), height(size, 0), numComponents(size) {\n        for (int i = 0; i < size; ++i) parent[i] = i;\n    }\n    \n    int find(int node) {\n        if (parent[node] != node) {\n            parent[node] = find(parent[node]);\n        }\n        return parent[node];\n    }\n    \n    void connect(int a, int b) {\n        a = find(a);\n        b = find(b);\n        if (a == b) return;\n        if (height[a] > height[b]) {\n            swap(a, b);\n        }\n        parent[a] = b;\n        if (height[a] == height[b]) ++height[b];\n        --numComponents;\n    }\n    \n    int getComponentCount() const { return numComponents; }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int64 p, k;\n    cin >> p >> k;\n    \n    vector<char> visited(p, 0);\n    UnionFind uf(p);\n    \n    for (int64 start = 0; start < p; ++start) {\n        for (int64 pos = start; !visited[pos]; pos = (pos * k) % p) {\n            visited[pos] = 1;\n            uf.connect(start, pos);\n        }\n    }\n    \n    int componentCount = uf.getComponentCount();\n    if (k != 1) componentCount--;\n    \n    cout << pow_mod(p, componentCount) << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n\n    static long pow_mod(long base, long exp) {\n        long result = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    static class UnionFind {\n        int[] parent;\n        int[] height;\n        int numComponents;\n\n        UnionFind(int size) {\n            parent = new int[size];\n            height = new int[size];\n            numComponents = size;\n            for (int i = 0; i < size; ++i) {\n                parent[i] = i;\n            }\n        }\n\n        int find(int node) {\n            if (parent[node] != node) {\n                parent[node] = find(parent[node]);\n            }\n            return parent[node];\n        }\n\n        void connect(int a, int b) {\n            a = find(a);\n            b = find(b);\n            if (a == b) return;\n            if (height[a] > height[b]) {\n                int temp = a;\n                a = b;\n                b = temp;\n            }\n            parent[a] = b;\n            if (height[a] == height[b]) {\n                ++height[b];\n            }\n            --numComponents;\n        }\n\n        int getComponentCount() {\n            return numComponents;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long p = scanner.nextLong();\n        long k = scanner.nextLong();\n\n        boolean[] visited = new boolean[(int) p];\n        UnionFind uf = new UnionFind((int) p);\n\n        for (long start = 0; start < p; ++start) {\n            for (long pos = start; !visited[(int) pos]; pos = (pos * k) % p) {\n                visited[(int) pos] = true;\n                uf.connect((int) start, (int) pos);\n            }\n        }\n\n        int componentCount = uf.getComponentCount();\n        if (k != 1) {\n            componentCount--;\n        }\n\n        System.out.println(pow_mod(p, componentCount));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021884430316276848, -3.814689989667386e-06, -2.3841855067985307e-07, -0.0007194076315499842, -2.884823152271565e-05, -0.1602524369955063, -0.09022537618875504, -8.761498611420393e-05, -1.1920922133867862e-06, -6.186770770000294e-05, -0.002476603025570512, -5.829164365422912e-05, -0.08438656479120255, -0.00010024998482549563, -0.0015172171406447887, -2.9802276912960224e-06, 0.0, -1.1920928244535389e-07, 0.0, -5.829164365422912e-05, 0.0, 0.0, -4.768360213347478e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.00029940891545265913, -0.10020712018013, -4.768370445162873e-07, -0.0009149893885478377, -0.0017479868838563561, -4.4225667807040736e-05, -0.4743317663669586, -3.8742269680369645e-05, -8.344646857949556e-07, 0.0, -2.2053474822314456e-05, -1.6689286894688848e-06, -1.9073468138230965e-06, 0.0, -0.0001565095444675535, -3.6954811548639555e-06, -4.768370445162873e-07, 0.0, 0.0, 0.0, -1.6331539882230572e-05, 0.0, -1.6689286894688848e-06, 0.0, -5.960462772236497e-07, -4.768370445162