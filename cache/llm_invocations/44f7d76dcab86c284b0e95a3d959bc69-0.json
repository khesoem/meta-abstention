{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <cstring>\n#include <climits>\n\nusing namespace std;\n\ninline int bitcount(int x) {\n    int c = 0;\n    for (; x; x >>= 1)\n        c += x & 1;\n    return c;\n}\n\ninline int highestBit(int x) {\n    if (!x) return 0;\n    int res = 1;\n    while (res <= x / 2) res <<= 1;\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, K, mod;\n    cin >> n >> K >> mod;\n\n    if (n & 1) {\n        long long res = 1, base = K % mod;\n        for (int e = n; e; e >>= 1) {\n            if (e & 1) res = (res * base) % mod;\n            base = (base * base) % mod;\n        }\n        cout << res << '\\n';\n        return 0;\n    }\n\n    static long long fact[300010], invFact[300010];\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i % mod;\n\n    auto modPow = [](long long base, int exp, int modulus) -> long long {\n        long long res = 1;\n        while (exp) {\n            if (exp & 1) res = (res * base) % modulus;\n            base = (base * base) % modulus;\n            exp >>= 1;\n        }\n        return res;\n    };\n\n    invFact[n] = modPow(fact[n], mod - 2, mod);\n    for (int i = n; i > 0; --i) invFact[i - 1] = invFact[i] * i % mod;\n\n    auto binom = [&](int nn, int kk) -> long long {\n        if (kk < 0 || kk > nn) return 0;\n        return fact[nn] * invFact[kk] % mod * invFact[nn - kk] % mod;\n    };\n\n    static int cntArr[300010], msbArr[300010];\n    for (int i = 1; i <= n; ++i) {\n        cntArr[i] = bitcount(i);\n        msbArr[i] = highestBit(i);\n    }\n\n    static long long dp[300010][20];\n    memset(dp, 0, sizeof(dp));\n    dp[0][0] = 1;\n\n    for (int i = 1; i <= n; ++i) {\n        if ((i & n) != i) continue;\n        int pivot = msbArr[i];\n        int rem = i ^ pivot;\n        for (int k = rem; ; k = (k - 1) & rem) {\n            int part1 = k + pivot;\n            int part2 = i ^ part1;\n            int limit = min(K - 1, cntArr[part2]);\n            long long comb = binom(i, part1);\n            for (int j = 0; j <= limit; ++j) {\n                dp[i][j + 1] = (dp[i][j + 1] + dp[part2][j] * comb) % mod;\n            }\n            if (!k) break;\n        }\n    }\n\n    long long answer = 0;\n    int upper = min(cntArr[n], K);\n    for (int j = 1; j <= upper; ++j) {\n        answer = (answer + dp[n][j] * binom(K, j) % mod * fact[j]) % mod;\n    }\n    answer = (modPow(K, n, mod) - answer + mod) % mod;\n    cout << answer << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static int bitcount(int x) {\n        int c = 0;\n        for (; x > 0; x >>= 1)\n            c += x & 1;\n        return c;\n    }\n\n    static int highestBit(int x) {\n        if (x == 0) return 0;\n        int res = 1;\n        while (res <= x / 2) res <<= 1;\n        return res;\n    }\n\n    static long modPow(long base, int exp, int modulus) {\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % modulus;\n            base = (base * base) % modulus;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int K = Integer.parseInt(st.nextToken());\n        int mod = Integer.parseInt(st.nextToken());\n\n        if ((n & 1) == 1) {\n            long res = 1;\n            long base = K % mod;\n            for (int e = n; e > 0; e >>= 1) {\n                if ((e & 1) == 1) res = (res * base) % mod;\n                base = (base * base) % mod;\n            }\n            System.out.println(res);\n            return;\n        }\n\n        long[] fact = new long[300010];\n        long[] invFact = new long[300010];\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = fact[i - 1] * i % mod;\n        }\n\n        invFact[n] = modPow(fact[n], mod - 2, mod);\n        for (int i = n; i > 0; --i) {\n            invFact[i - 1] = invFact[i] * i % mod;\n        }\n\n        class Binom {\n            long binom(int nn, int kk) {\n                if (kk < 0 || kk > nn) return 0;\n                return fact[nn] * invFact[kk] % mod * invFact[nn - kk] % mod;\n            }\n        }\n        Binom binom = new Binom();\n\n        int[] cntArr = new int[300010];\n        int[] msbArr = new int[300010];\n        for (int i = 1; i <= n; ++i) {\n            cntArr[i] = bitcount(i);\n            msbArr[i] = highestBit(i);\n        }\n\n        long[][] dp = new long[300010][20];\n        for (int i = 0; i <= n; ++i) {\n            Arrays.fill(dp[i], 0);\n        }\n        dp[0][0] = 1;\n\n        for (int i = 1; i <= n; ++i) {\n            if ((i & n) != i) continue;\n 