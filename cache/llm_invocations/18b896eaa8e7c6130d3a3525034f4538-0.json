{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\ntypedef long double ld;\ntypedef unsigned long long ull;\n\nconst int dx[] = {1, -1, 0, 0};\nconst int dy[] = {0, 0, 1, -1};\n\nint n, t, rx, ry;\nstring lab[20], sci[20];\nint mem[12][12][12][12][62];\nint cap[250][250], par[250];\nint dist[20][20], vis[20][20];\n\ninline bool good(int x, int y) {\n    return 0 <= x && x < n && 0 <= y && y < n && lab[x][y] != 'Y' && lab[x][y] != 'Z';\n}\n\nvoid pre() {\n    memset(dist, 0x3f, sizeof(dist));\n    memset(vis, 0, sizeof(vis));\n    dist[rx][ry] = 0;\n    vis[rx][ry] = 1;\n    queue<int> qx, qy;\n    qx.push(rx);\n    qy.push(ry);\n    while (!qx.empty()) {\n        int x = qx.front(); qx.pop();\n        int y = qy.front(); qy.pop();\n        for (int k = 0; k < 4; k++) {\n            int nx = x + dx[k];\n            int ny = y + dy[k];\n            if (good(nx, ny) && !vis[nx][ny]) {\n                dist[nx][ny] = dist[x][y] + 1;\n                vis[nx][ny] = 1;\n                qx.push(nx);\n                qy.push(ny);\n            }\n        }\n    }\n}\n\nvoid precomputeReach() {\n    for (int ptr = t; ptr >= 0; --ptr) {\n        for (int x0 = 0; x0 < n; ++x0) {\n            for (int y0 = 0; y0 < n; ++y0) {\n                for (int x1 = 0; x1 < n; ++x1) {\n                    for (int y1 = 0; y1 < n; ++y1) {\n                        int val = 0;\n                        if (x0 == x1 && y0 == y1) {\n                            val = (dist[x0][y0] >= ptr);\n                        } else if (dist[x0][y0] > ptr) {\n                            if (ptr < t) {\n                                for (int k = 0; k < 4; ++k) {\n                                    int nx = x0 + dx[k];\n                                    int ny = y0 + dy[k];\n                                    if (good(nx, ny) && mem[nx][ny][x1][y1][ptr + 1]) {\n                                        val = 1;\n                                        break;\n                                    }\n                                }\n                            }\n                        }\n                        mem[x0][y0][x1][y1][ptr] = val;\n                    }\n                }\n            }\n        }\n    }\n}\n\nbool fml(int s, int t) {\n    memset(par, -1, sizeof(par));\n    par[s] = -2;\n    queue<int> qu;\n    qu.push(s);\n    while (!qu.empty()) {\n        int v = qu.front(); qu.pop();\n        for (int i = s; i <= t; i++) {\n            if (par[i] == -1 && cap[v][i] > 0) {\n                par[i] = v;\n                qu.push(i);\n            }\n        }\n    }\n    return par[t] != -1;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(NULL);\n    cout << setprecision(32);\n\n    cin >> n >> t;\n    for (int i = 0; i < n; i++) cin >> sci[i];\n    for (int i = 0; i < n; i++) cin >> lab[i];\n\n    vector<pair<int, int>> pos;\n    vector<int> lc, sc;\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < n; j++) {\n            if (sci[i][j] == 'Z') {\n                rx = i;\n                ry = j;\n            } else if (sci[i][j] >= '0' && sci[i][j] <= '9') {\n                pos.push_back({i, j});\n                lc.push_back(lab[i][j] - '0');\n                sc.push_back(sci[i][j] - '0');\n            }\n        }\n    }\n\n    int m = (int)pos.size();\n    memset(cap, 0, sizeof(cap));\n\n    for (int i = 0; i < m; i++) {\n        cap[0][i + 1] = sc[i];\n        cap[m + 1 + i][2 * m + 1] = lc[i];\n    }\n\n    pre();\n    precomputeReach();\n\n    for (int i = 0; i < m; i++) {\n        for (int j = 0; j < m; j++) {\n            if (mem[pos[i].first][pos[i].second][pos[j].first][pos[j].second][0]) {\n                cap[i + 1][m + 1 + j] = 1000;\n            }\n        }\n    }\n\n    int flow = 0;\n    while (fml(0, 2 * m + 1)) {\n        int cur = 2 * m + 1;\n        int nflow = 1000000;\n        while (par[cur] >= 0) {\n            nflow = min(nflow, cap[par[cur]][cur]);\n            cur = par[cur];\n        }\n        cur = 2 * m + 1;\n        while (par[cur] >= 0) {\n            cap[par[cur]][cur] -= nflow;\n            cap[cur][par[cur]] += nflow;\n            cur = par[cur];\n        }\n        flow += nflow;\n    }\n\n    cout << flow;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    sci = [list(next(it).strip()) for _ in range(n)]\n    lab = [list(next(it).strip()) for _ in range(n)]\n\n    # directions\n    dx = [1, -1, 0, 0]\n    dy = [0, 0, 1, -1]\n\n    # find start (Z) and collect scientist/lab positions\n    pos = []          # list of (x,y) for digits\n    lc = []           # lab capacities\n    sc = []           # scientist counts\n    rx = ry = -1\n    for i in range(n):\n        for j in range(n):\n            if sci[i][j] == 'Z':\n                rx, ry = i, j\n            elif '0' <= sci[i][j] <= '9':\n                pos.append((i, j))\n                lc.append(ord(lab[i][j]) - ord('0'))\n                sc.append(ord(sci[i][j]) - ord('0'))\n\n    m = len(pos)\n\n    # helper: good cell (not 'Y' or 'Z' in lab)\n    def good(x: int, y: int) -> bool:\n        return 0 <= x < n and 0 <= y < n and lab[x][y] != 'Y' and lab[x][y] != 'Z'\n\n    # BFS to compute distances from (rx,ry)\n    INF = 10**9\n    dist = [[INF]*n for _ in range(n)]\n    vis = [[0]*n for _ in range(n)]\n    dist[rx][ry] = 0\n    vis[rx][ry] = 1\n    qx = deque([rx])\n    qy = deque([ry])\n    while qx:\n        x = qx.popleft()\n        y = qy.popleft()\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if good(nx, ny) and not vis[nx][ny]:\n                dist[nx][ny] = dist[x][y] + 1\n                vis[nx][ny] = 1\n                qx.append(nx)\n                qy.append(ny)\n\n    # 5D mem array: mem[x0][y0][x1][y1][ptr]\n    # dimensions: n x n x n x n x (t+1)\n    mem = [[[[[0]*(t+1) for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(n)]\n\n    # precompute reachability backwards in time\n    for ptr in range(t, -1, -1):\n        for x0 in range(n):\n            for y0 in range(n):\n                for x1 in range(n):\n                    for y1 in range(n):\n                        val = 0\n                        if x0 == x1 and y0 == y1:\n                            val = 1 if dist[x0][y0] >= ptr else 0\n                        elif dist[x0][y0] > ptr:\n                            if ptr < t:\n                                for k in range(4):\n                                    nx = x0 + dx[k]\n                                    ny = y0 + dy[k]\n                                    if good(nx, ny) and mem[nx][ny][x1][y1][ptr+1]:\n                                        val = 1\n                                        break\n                        mem[x0][y0][x1][y1][ptr] = val\n\n    # build flow network\n    # nodes: 0 = source, 1..m = scientists, m+1..2m = labs, 2m+1 = sink\n    N = 2*m + 2\n    cap = [[0]*N for _ in range(N)]\n\n    for i in range(m):\n        cap[0][i+1] = sc[i]\n        cap[m+1+i][2*m+1] = lc[i]\n\n    for i in range(m):\n        for j in range(m):\n            x0, y0 = pos[i]\n            x1, y1 = pos[j]\n            if mem[x0][y0][x1][y1][0]:\n                cap[i+1][m+1+j] = 1000\n\n    # max flow (Edmonds-Karp)\n    def bfs(s: int, t: int) -> bool:\n        par = [-1]*N\n        par[s] = -2\n        q = deque([s])\n        while q:\n            v = q.popleft()\n            for u in range(N):\n                if par[u] == -1 and cap[v][u] > 0:\n                    par[u] = v\n                    q.append(u)\n        return par[t] != -1\n\n    flow = 0\n    while bfs(0, 2*m+1):\n        # find augmenting flow\n        cur = 2*m+1\n        nflow = 10**9\n        while par[cur] >= 0:\n            nflow = min(nflow, cap[par[cur]][cur])\n            cur = par[cur]\n        cur = 2*m+1\n        while par[cur] >= 0:\n            cap[par[cur]][cur] -= nflow\n            cap[cur][par[cur]] += nflow\n            cur = par[cur]\n        flow += nflow\n\n    print(flow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000924993772059679, -0.004355468321591616, -8.344646857949556e-07, -6.198863957251888e-06, -4.0531076592742465e-06, -1.311301275563892e-06, 0.0, -1.1920922133867862e-06, -0.0015245969407260418, -0.13812004029750824, -0.4156346321105957, -0.20142307877540588, -2.7418097943154862e-06, -0.00015841660206206143, -9.536738616588991e-07, -3.576278118089249e-07, -0.0013881819322705269, -2.50339189733495e-06, -0.004088615067303181, 0.0, -4.827859811484814e-05, 0.0, -0.018150195479393005, -2.622600959512056e-06, -4.768370445162873e-07, -0.4753667712211609, -2.3841855067985307e-07, -2.264974000354414e-06, 0.0, -1.9430925021879375e-05, -2.14574