{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <numeric>\n#include <random>\n#include <chrono>\n\nusing namespace std;\nusing lint = long long;\nconst lint MOD = 1000000007LL;\n\nclass DisjointSet {\npublic:\n    vector<lint> parent;\n    mt19937_64 rng;\n    \n    DisjointSet(lint n) : parent(n), rng(chrono::steady_clock::now().time_since_epoch().count()) {\n        iota(parent.begin(), parent.end(), 0LL);\n    }\n    \n    lint find(lint x) {\n        if (parent[x] != x) parent[x] = find(parent[x]);\n        return parent[x];\n    }\n    \n    void join(lint x, lint y) {\n        x = find(x); y = find(y);\n        if (x == y) return;\n        if (rng() & 1) swap(x, y);\n        parent[y] = x;\n    }\n};\n\nlint count_cycles(lint p, lint k) {\n    DisjointSet dsu(p);\n    for (lint i = 1; i < p; ++i) {\n        lint target = (k * i) % p;\n        dsu.join(i, target);\n    }\n    vector<bool> visited(p, false);\n    lint cnt = 0;\n    for (lint i = 1; i < p; ++i) {\n        lint r = dsu.find(i);\n        if (!visited[r]) {\n            visited[r] = true;\n            ++cnt;\n        }\n    }\n    return cnt;\n}\n\nlint compute(lint p, lint k) {\n    lint num_cycles;\n    if (k == 0) num_cycles = p - 1;\n    else if (k == 1) num_cycles = p;\n    else num_cycles = count_cycles(p, k);\n    \n    lint result = 1;\n    for (lint i = 0; i < num_cycles; ++i) {\n        result = (result * p) % MOD;\n    }\n    return result;\n}\n\nint main() {\n    lint p, k;\n    cin >> p >> k;\n    cout << compute(p, k) << '\\n';\n    int dummy;\n    cin >> dummy;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport random\nimport time\n\nMOD = 1000000007\n\nclass DisjointSet:\n    def __init__(self, n):\n        self.parent = list(range(n))\n        # Use time-based seed for randomness\n        self.rng = random.Random(int(time.time() * 1000000) % (2**64))\n    \n    def find(self, x):\n        if self.parent[x] != x:\n            self.parent[x] = self.find(self.parent[x])\n        return self.parent[x]\n    \n    def join(self, x, y):\n        x = self.find(x)\n        y = self.find(y)\n        if x == y:\n            return\n        if self.rng.randint(0, 1) == 1:\n            x, y = y, x\n        self.parent[y] = x\n\ndef count_cycles(p, k):\n    dsu = DisjointSet(p)\n    for i in range(1, p):\n        target = (k * i) % p\n        dsu.join(i, target)\n    \n    visited = [False] * p\n    cnt = 0\n    for i in range(1, p):\n        r = dsu.find(i)\n        if not visited[r]:\n            visited[r] = True\n            cnt += 1\n    return cnt\n\ndef compute(p, k):\n    if k == 0:\n        num_cycles = p - 1\n    elif k == 1:\n        num_cycles = p\n    else:\n        num_cycles = count_cycles(p, k)\n    \n    result = 1\n    for _ in range(num_cycles):\n        result = (result * p) % MOD\n    return result\n\ndef main():\n    data = sys.stdin.read().split()\n    p = int(data[0])\n    k = int(data[1])\n    print(compute(p