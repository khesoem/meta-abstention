)) % MOD;\n        binom = (binom * modPow(fact[d - i], MOD - 2, MOD)) % MOD;\n\n        long long term = (binom * modPow(d - i, n, MOD)) % MOD;\n        if (i % 2 == 0) {\n            sum = (sum + term) % MOD;\n        } else {\n            sum = (sum - term + MOD) % MOD;\n        }\n    }\n\n    if (k > 0) {\n        sum = (sum * 2) % MOD;\n    }\n\n    sum = (sum * fact[(int)n]) % MOD;\n    sum = (sum * modPow(fact[(int)k], MOD - 2, MOD)) % MOD;\n    sum = (sum * modPow(fact[d], MOD - 2, MOD)) % MOD;\n\n    cout << sum << endl;\n    \n    return 0;\n}\n\nvoid trim(string& str) {\n    size_t first = str.find_first_not_of(' ');\n    if (first != string::npos) {\n        size_t last = str.find_last_not_of(' ');\n        str = str.substr(first, (last - first + 1));\n    } else {\n        str = \"\";\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012015574611723423, -2.0265558760002023e-06, -5.960462772236497e-07, -0.0004233417857903987, -3.576278118089249e-07, -5.8412379075889476e-06, -7.986990567587782e-06, -2.3841830625315197e-06, -2.3841855067985307e-07, -0.5538179874420166, -5.936446541454643e-05, -1.156323378381785e-05, -4.887569048150908e-06, -0.16197814047336578, -0.0006273209000937641, -0.00038044367101974785, -1.1920922133867862e-06, -0.14226321876049042, -0.00760682625696063, -0.16023963689804077, -1.1920922133867862e-06, -0.013389430940151215, -0.6931495666503906, -0.17980152368545532, -4.768360213347478e-06, -3.2186455882765586e-06, -5.960462772236497e-07, -0.000814582861494273, -0.38689011335372925, -4.327203714638017e-05, -3.814689989667386e-06, 0.0, 0.0, 0.0, 0.0, -7.152555099310121e-07, 0.0, -4.768370445162873e-07, -2.3841830625315197e-06, -2.9802276912960224e-06, -1.0728830375228426e-06, -8.344646857949556e-07, -6.913899414939806e-05, -3.3854863431770355e-05, -1.1920922133867862e-06, -5.722029527532868e-06, -1.7165990357170813e-05, -1.6093124941107817e-05, -7.152555099310121e-07, -5.960462772236497e-07, 0.0