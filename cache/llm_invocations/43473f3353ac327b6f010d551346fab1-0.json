)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef main():\n    input = sys.stdin.readline\n    n, t = map(int, input().split())\n    c = [list(input().strip()) for _ in range(n)]\n    S = [list(input().strip()) for _ in range(n)]\n    \n    # find starting position 'Z'\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if c[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n    \n    # assign id to each cell\n    tot = 0\n    id = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            tot += 1\n            id[i][j] = tot\n    \n    st = 2 * tot + 1\n    ed = st + 1\n    mf = MaxFlow(ed + 1)\n    \n    # BFS from start to find shortest distances from Z to all cells\n    dis = [[INF]*n for _ in range(n)]\n    vis = [[False]*n for _ in range(n)]\n    q = deque()\n    dis[sx][sy] = 0\n    vis[sx][sy] = True\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx, ny = x + dx[k], y + dy[k]\n            if 0 <= nx < n and 0 <= ny < n and not vis[nx][ny] and c[nx][ny].isdigit():\n                dis[nx][ny] = dis[x][y] + 1\n                vis[nx][ny] = True\n                q.append((nx, ny))\n    \n    # For each creature cell, add edge from source and find reachable food cells\n    for i in range(n):\n        for j in range(n):\n            if c[i][j].isdigit() and c[i][j] != '0':\n                mf.add_edge(st, id[i][j], int(c[i][j]))\n                # BFS from this creature cell to find food cells within distance t\n                dist_to_creature = [[INF]*n for _ in range(n)]\n                vis2 = [[False]*n for _ in range(n)]\n                q2 = deque()\n                dist_to_creature[i][j] = 0\n                vis2[i][j] = True\n                q2.append((i, j))\n                while q2:\n                    x, y = q2.popleft()\n                    for k in range(4):\n                        nx, ny = x + dx[k], y + dy[k]\n                        if 0 <= nx < n and 0 <= ny < n and not vis2[nx][ny] and c[nx][ny].isdigit():\n                            dist_to_creature[nx][ny] = dist_to_creature[x][y] + 1\n                            vis2[nx][ny] = True\n                            if dist_to_creature[nx][ny] < dis[nx][ny]:\n                                q2.append((nx, ny))\n                for a in range(n):\n                    for b in range(n):\n                        if S[a][b].isdigit() and S[a][b] != '0' and dist_to_creature[a][b] <= t and dist_to_creature[a][b] <= dis[a][b]:\n                            mf.add_edge(id[i][j], id[a][b] + tot, INF)\n    \n    # Add edges from food cells to sink\n    for i in range(n):\n        for j in range(n):\n            if S[i][j].isdigit() and S[i][j] != '0':\n                mf.add_edge(id[i][j] + tot, ed, int(S[i][j]))\n    \n    print(mf.max_flow(st, ed))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.76836e-06, 0.0, -3.576278e-07, -0.0015404274, -0.21134315, -0.00029047084, -0.029830141, -0.0033905182, -4.4225668e-05, -7.152555e-07, -9.7031654e-05, -0.0014446072, -0.87221086, -0.00061302463, -2.6464111e-05, -0.00021562635, -0.00021002471, -0.0032146703, -1.7881378e-06, -1.7881378e-06, -0.00048828122, -8.082063e-05, -0.008646313, -0.0027611249, -1.1920922e-06, -0.16026016, -1.1920928e-07, -1.41858045e-05, -1.1920928e-07, -1.1920922e-06, -0.1269712, -0.052092772, -1.180165e-05, -0.00016187312, -0.00023076255, -1.1920928e-07, -0.0006364942, -1.8954097e-05, -2.3841855e-07, -6.603976e-05, -4.7683704e-07, -4.7683704e-07, -1.4305105e-06, -1.1920928e-07, -8.4992615e-05, 0.0, -1.1920928e-07, -7.986991e-06, -1.072883e-06, -1.1920928e-07, -1.1920928e-07, 0.0, -2.3841855e-07, -7.152555e-07, -1.1920928e-07, -1.7881378e-06, -2.9802277e-06, -7.152555e-07, -0.0032217999,