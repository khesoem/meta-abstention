\");\n        }\n    }\n\n    static void expand(int mask) {\n        int boat = mask / 1000000;\n        int left50 = (mask % 1000000) / 100;\n        int left100 = mask % 100;\n        int curDist = dist[mask];\n\n        if (boat > 0) {\n            for (int i = left50; i >= 0 && 50 * (left50 - i) <= k; i--) {\n                for (int j = left100; j >= 0 && 50 * (left50 - i) + 100 * (left100 - j) <= k; j--) {\n                    if (i != left50 || j != left100) {\n                        long edge = comb[left50][i] * comb[left100][j] % MOD;\n                        int nm = i * 100 + j;\n                        add(nm, mask, curDist + 1, edge);\n                    }\n                }\n            }\n        } else {\n            for (int i = left50; i <= cnt50 && 50 * (i - left50) <= k; i++) {\n                for (int j = left100; j <= cnt100 && 50 * (i - left50) + 100 * (j - left100) <= k; j++) {\n                    if (i != left50 || j != left100) {\n                        long edge = comb[cnt50 - left50][i - left50] * comb[cnt100 - left100][j - left100] % MOD;\n                        int nm = 1000000 + i * 100 + j;\n                        add(nm, mask, curDist + 1, edge);\n                    }\n                }\n            }\n        }\n    }\n\n    static void add(int nm, int mask, int nd, long edge) {\n        if (dist[nm] == -1) {\n            dist[nm] = nd;\n            ways[nm] = ways[mask] * edge % MOD;\n            q.add(nm);\n        } else if (dist[nm] == nd) {\n            ways[nm] = (ways[nm] + ways[mask] * edge) % MOD;\n        }\n    }\n\n    static void precomputeCombinations() {\n        for (int i = 0; i < 100; i++) {\n            comb[i][0] = 1;\n        }\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= i; j++) {\n                comb[i][j] = (comb[i - 1][j - 1] + comb[i - 1][j]) % MOD;\n            }\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "dee