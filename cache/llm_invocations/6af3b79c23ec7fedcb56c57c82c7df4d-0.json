n    static int source, sink;\n    static List<Integer>[] graph = new ArrayList[MAXN + 2];\n    static final int INF = (int)1e9;\n\n    static class Arc {\n        int from, to, flow, cap, cost;\n        Arc(int from, int to, int flow, int cap, int cost) {\n            this.from = from;\n            this.to = to;\n            this.flow = flow;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n    static List<Arc> arcs = new ArrayList<>();\n    static List<Integer>[] adjList = new ArrayList[MAXN + 2];\n\n    static void addArc(int a, int b, int c, int d) {\n        arcs.add(new Arc(a, b, 0, c, d));\n        adjList[a].add(arcs.size() - 1);\n        arcs.add(new Arc(b, a, 0, 0, -d));\n        adjList[b].add(arcs.size() - 1);\n    }\n\n    static int[] dist = new int[MAXN + 2];\n    static int[] inQueue = new int[MAXN + 2];\n    static int[] minCap = new int[MAXN + 2];\n    static int[] parentArc = new int[MAXN + 2];\n\n    static int[] spfa(int n) {\n        Arrays.fill(dist, 0, n + 1, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.add(source);\n        dist[source] = 0;\n        inQueue[source] = 1;\n        minCap[source] = INF;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = 0;\n            for (int id : adjList[u]) {\n                int v = arcs.get(id).to;\n                if (arcs.get(id).cap > arcs.get(id).flow && dist[v] > dist[u] + arcs.get(id).cost) {\n                    dist[v] = dist[u] + arcs.get(id).cost;\n                    parentArc[v] = id;\n                    minCap[v] = Math.min(minCap[u], arcs.get(id).cap - arcs.get(id).flow);\n                    if (inQueue[v] == 0) {\n                        q.add(v);\n                        inQueue[v] = 1;\n                    }\n                }\n            }\n        }\n        if (dist[sink] == INF) return new int[]{0, 0};\n        int v = sink;\n        while (v != source) {\n            int id = parentArc[v];\n  