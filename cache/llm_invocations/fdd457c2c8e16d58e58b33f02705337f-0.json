ng x = y * a / b;\n        TRY_UPDATE(x, y);\n        ++x;\n        TRY_UPDATE(x, y);\n    }\n    printf(\"%lld/%lld\\n\", xx, yy);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long a = sc.nextLong();\n        long b = sc.nextLong();\n        long n = sc.nextLong();\n        sc.close();\n\n        long xx = -1, yy = 0;\n        for (long y = 1; y <= n; ++y) {\n            long x = y * a / b;\n            // Try (x, y)\n            if (xx == -1) {\n                xx = x;\n                yy = y;\n            } else {\n                long diff1 = Math.abs(a * y - b * x);\n                long diff2 = Math.abs(a * yy - b * xx);\n                if (diff1 * yy < diff2 * y) {\n                    xx = x;\n                    yy = y;\n                }\n            }\n            // Try (x+1, y)\n            x++;\n            if (xx == -1) {\n                xx = x;\n                yy = y;\n            } else {\n                long diff1 = Math.abs(a * y - b * x);\n                long diff2 = Math.abs(a * yy - b * xx);\n                if (diff1 * yy < diff2 * y) {\n                    xx = x;\n                    yy = y;\n                }\n            }\n        }\n        System.out.println(xx + \"/\" + yy);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.0371154530730564e-05, -0.008622794412076473, -0.0019328974885866046, -1.5497195136049413e-06, 0.0, -0.001585894264280796, -3.635817120084539e-05, -8.940656698541716e-06, -0.0002470903273206204, 0.0, -2.0265558760002023e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.5497195136049413e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -8.4638240878121e-06, 0.0, -2.920585029642