ring replace_first_at(const std::string& text) {\n    size_t pos = text.find(\"at\");\n    if (pos == std::string::npos) return text;\n    return text.substr(0, pos) + \"@\" + text.substr(pos + 2);\n}\n\nstd::string replace_all_dot(const std::string& text) {\n    std::string result = text;\n    size_t pos = 0;\n    while ((pos = result.find(\"dot\", pos)) != std::string::npos) {\n        result.replace(pos, 3, \".\");\n        pos += 1;\n    }\n    return result;\n}\n\nstd::string handle_first(const std::string& text) {\n    if (!text.empty() && text[0] == '.') {\n        return \"dot\" + text.substr(1);\n    }\n    return text;\n}\n\nstd::string handle_first_at_and_prepend(const std::string& text) {\n    if (!text.empty() && text[0] == '@') {\n        std::string t = replace_first_at(text);\n        return \"at\" + t.substr(1);\n    }\n    return text;\n}\n\nstd::string handle_last(const std::string& text) {\n    if (!text.empty() && text.back() == '.') {\n        return text.substr(0, text.length() - 1) + \"dot\";\n    }\n    return text;\n}\n\nint main() {\n    std::string s;\n    std::getline(std::cin, s);\n    s = handle_last(\n            handle_first_at_and_prepend(\n                handle_first(\n                    replace_all_dot(\n                        replace_first_at(s)\n                    )\n                )\n            )\n        );\n    std::cout << s << std::endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.00011896379146492109, -2.3841855067985307e-07, -7.152555099310121e-07, -0.0003947432560380548, -5.364274329622276e-05, 0.0, -5.960462772236497e-07, -4.291525328881107e-06, 0.0, 0.0, 0.0, -0.0052352952770888805, -0.07940464466810226, 0.0, 0.0, -4.768370445162873e-07, -2.169585604860913e-05, 0.0, -1.0728830375228426e-06, 0.0, 0.0, 0.0, -0.0005530973430722952, -1.0251946150674485e-05, -0.0002097863471135497, -4.768370445162873e-07, -9.536738616588991e-07, -0.03804256021976471, 0.0, -6.1988639