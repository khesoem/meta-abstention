= 0) and flag\n        total = (total + solve(N - 1, k - delta, new_flag) * weight) % mod\n    \n    return total\n\n# Use functools.lru_cache with explicit wrapper\n@lru_cache(maxsize=None)\ndef solve_with_cache(N, k, flag):\n    return solve(N, k, flag)\n\nans = solve_with_cache(n, 0, 1) % mod\nprint(ans)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int mod = sc.nextInt();\n        \n        long ans = solveWithCache(n, 0, true, mod) % mod;\n        System.out.println(ans);\n    }\n    \n    private static Map<String, Long> memo = new HashMap<>();\n    \n    private static long solveWithCache(int N, int k, boolean flag, int mod) {\n        String key = N + \",\" + k + \",\" + flag;\n        if (memo.containsKey(key)) {\n            return memo.get(key);\n        }\n        \n        long result = solve(N, k, flag, mod);\n        memo.put(key, result);\n        return result;\n    }\n    \n    private static long solve(int N, int k, boolean flag, int mod) {\n        int invnum_INF = (N * (N - 1)) / 2;\n        \n        // Boundary checks\n        if (k < -invnum_INF - 1) {\n            return solve(N, -invnum_INF - 1, flag, mod);\n        }\n        if (k >= invnum_INF) {\n            return 0;\n        }\n        \n        // Base case\n        if (N == 1) {\n            return flag ? 0 : (k < 0 ? 1 : 0);\n        }\n        \n        // Accumulate results\n        long total = 0;\n        for (int delta = -N + 1; delta < N; delta++) {\n            if (flag && delta > 0) {\n                continue;\n            }\n            int weight = Math.min(N - delta, delta + N);\n            boolean new_flag = (delta == 0) && flag;\n            total = (total + solve(N - 1, k - delta