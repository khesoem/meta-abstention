    return self.invFact[n]\n\n    def ncr(self, n, r):\n        if r < 0 or r > n:\n            return 0\n        return self.mult(self.fact(n), self.mult(self.invFact(r), self.invFact(n - r)))\n\n    def smallInv(self, n):\n        return self.mult(self.invFact(n), self.fact(n - 1))\n\n    def normalize(self, x):\n        x %= self.MOD\n        return x + self.MOD if x < 0 else x\n\n    def add(self, a, b):\n        res = a + b\n        return res - self.MOD if res >= self.MOD else res\n\n    def subtract(self, a, b):\n        res = a - b\n        return res + self.MOD if res < 0 else res\n\n    def mult(self, *args):\n        res = 1\n        for x in args:\n            res = self.mult_two(res, x)\n        return res\n\n    def mult_two(self, a, b):\n        return (a * b) % self.MOD\n\n    def inv(self, a):\n        b = self.MOD\n        u, v = 1, 0\n        while b > 0:\n            t = a // b\n            a -= t * b\n            a, b = b, a\n            u -= t * v\n            u, v = v, u\n        return self.normalize(u)\n\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    m = int(data[1])\n    \n    mod = Mod998()\n    mod.precomputeFactorials(n + m)\n    \n    phaseSize = 1\n    p = 1\n    i = 0\n    while p != 0:\n        p = mod.mult(p, mod.mult(n - i, mod.smallInv(n + m - i)))\n        phaseSize = mod.add(phaseSize, p)\n        i += 1\n    \n    answer = 0\n    for k in range(1, n + 1):\n        term = mod.mult(mod.ncr(n, k), m + k, mod.smallInv(k), phaseSize)\n        if k % 2 == 1:\n            answer = mod.add(answer, term)\n        else:\n            answer = mod.subtract(answer, term)\n    \n    print(answer)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.4225667807040736e-05, -9.536738616588991e-07, -4.768370445162873e-07, -0.010876419954001904, -0.0004456242313608527, -0.6932392120361328, -0.4318878948688507, -0.1352330