t t = n + k + 1;\n        n_ = n * t + 1;\n        m_ = k + (m * 2 * k + n) * (t - 1);\n        init();\n        for (int i = 0; i < n; i++) {\n            for (int s = 0; s < t - 1; s++) {\n                int u = i * t + s;\n                for (int j : aa[i]) {\n                    int v = j * t + s + 1;\n                    for (int x = 1; x <= k; x++)\n                        link(u, v, 1, c + (x * 2 - 1) * d);\n                }\n            }\n        }\n        for (int i = 0; i < n; i++)\n            for (int s = 0; s < t - 1; s++) {\n                int u = i * t + s, v = u + 1;\n                link(u, v, k, i == 0 ? 0 : c);\n            }\n        for (int h = 0; h < k; h++)\n            link(n_ - 1, ii[h] * t + 0, 1, 0);\n        println(edmonds_karp(n_ - 1, 0 * t + t - 1));\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef solve():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    ii = [next(it) - 1 for _ in range(k)]\n    aa = [[] for _ in range(n)]\n    for _ in range(m):\n        i = next(it) - 1\n        j = next(it) - 1\n        aa[i].append(j)\n        aa[j].append(i)\n    t = n + k + 1\n    n_ = n * t + 1\n    graph = [[] for _ in range(n_)]\n\n    def link(u, v, cap, cost):\n        graph[u].append(Edge(v, len(graph[v]), cap, cost))\n        graph[v].append(Edge(u, len(graph[u]) - 1, 0, -cost))\n\n    # Build edges\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            for j in aa[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    link(u, v, 1, c + (x * 2 - 1) * d)\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            link(u, v, k, 0 if i == 0 else c)\n    for h in range(k):\n        link(n_ - 1, ii[h] * t + 0, 1, 0)\n\n    # Min-cost max-flow (Edmonds-Karp with potentials)\n    pi = [INF] * n_\n    dd = [0] * n_\n    bb = [0] * n_\n    iq = [False] * n_\n    q = deque()\n\n    def enqueue(v):\n        if iq[v]:\n            return\n        iq[v] = True\n        q.append(v)\n\n    def dequeue():\n        u = q.popleft()\n        iq[u] = False\n        return u\n\n    def spfa(s, t):\n        for i in range(n_):\n            pi[i] = INF\n            dd[i] = 0\n        pi[s] = 0\n        q.clear()\n        enqueue(s)\n        while q:\n            u = dequeue()\n            d = dd[u] + 1\n            for e in graph[u]:\n                if e.cap > 0:\n                    p = pi[u] + e.cost\n                    v = e.to\n                    if pi[v] > p or (pi[v] == p and dd[v] > d):\n                        pi[v] = p\n                        dd[v] = d\n                        bb[v] = e.rev  # store index of reverse edge in graph[v]\n                        enqueue(v)\n        return pi[t] != INF\n\n    def push1(s, t):\n        u = t\n        while u != s:\n            e = graph[u][bb[u]]\n            e.cap += 1\n            graph[e.to][e.rev].cap -= 1\n            u = e.to\n\n    def edmonds_karp(s, t):\n        while spfa(s, t):\n            push1(s, t)\n        total = 0\n        for u in range(n_):\n            for e in graph[u]:\n                if e.cost > 0:\n                    total += e.cost * e.cap\n        return total\n\n    result = edmonds_karp(n_ - 1, 0 * t + t - 1)\n    sys.stdout.write(str(result))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.06216