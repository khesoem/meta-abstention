] * (max_n + 1)\n    inv_fact = [0] * (max_n + 1)\n    bit_count = [0] * (max_n + 1)\n    two_power_count = [0] * (max_n + 1)\n    \n    fact[0] = 1\n    bit_count[0] = -1\n    \n    for i in range(1, max_n + 1):\n        fact[i] = (fact[i-1] * i) % mod_val\n        bit_count[i] = bit_count[i >> 1] + 1\n        two_power_count[i] = two_power_count[i-1] + count_trailing_zeros(i)\n    \n    inv_fact[max_n] = mod_pow(fact[max_n], mod_val - 2, mod_val)\n    for i in range(max_n - 1, 0, -1):\n        inv_fact[i] = (inv_fact[i + 1] * (i + 1)) % mod_val\n    \n    inv_fact[0] = inv_fact[1]\n    \n    def binomial(nn, mm):\n        if mm < 0 or mm > nn:\n            return 0\n        return (fact[nn] * inv_fact[mm] % mod_val) * inv_fact[nn - mm] % mod_val\n    \n    dp = [[-1] * 31 for _ in range(max_n + 1)]\n    visited = [[False] * 31 for _ in range(max_n + 1)]\n    \n    def iterative_solve(start_n, start_k):\n        q = deque()\n        q.append((start_n, start_k))\n        order_list = []\n        \n        while q:\n            cur_n, cur_k = q.popleft()\n            order_list.append((cur_n, cur_k))\n            \n            if cur_n == 0 or cur_k == 0:\n                continue\n            \n            step = 1 << bit_count[cur_n]\n            for i in range(cur_n, step - 1, -2):\n                if (two_power_count[i] + two_power_count[cur_n - i] == two_power_count[cur_n] and \n                    not visited[cur_n - i][cur_k - 1]):\n                    visited[cur_n - i][cur_k - 1] = True\n                    q.append((cur_n - i, cur_k - 1))\n        \n        for idx in range(len(order_list) - 1, -1, -1):\n            cur_n, cur_k = order_list[idx]\n            if cur_n == 0:\n                dp[cur_n][cur_k] = 1\n                continue\n            if cur_k == 0:\n                dp[cur_n][cur_k] = 0\n                continue\n            \n            step = 1 << bit_count[cur_n]\n            res = 0\n            for i in range(cur_n, step - 1, -2):\n                if two_power_count[i] + two_power_count[cur_n - i] == two_power_count[cur_n]:\n                    res = (res + binomial(cur_n, i) * dp[cur_n - i][cur_k - 1] % mod_val * cur_k) % mod_val\n            dp[cur_n][cur_k] = res\n        \n        return dp[start_n][start_k]\n    \n    if n & 1:\n        print(mod_pow(k, n, mod_val))\n    else:\n        ans = mod_pow(k, n, mod_val)\n        result = iterative_solve(n, k)\n        final_result = (ans - result) % mod_val\n        if final_result < 0:\n            final_result += mod_val\n        print(final_result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002450642641633749, -9.536738616588991e-07, -2.3841855067985307e-07, -0.002866447437554598, -0.0009162995265796781, -0.001703955582343042, -0.00028308198670856655, -0.0003152588615193963, -5.960462772236497e-07, -3.886147169396281e-05, -0.00010227633902104571, -0.0007175016799010336, -0.00029583368450403214, -0.048907049000263214, -0.016867276281118393, -2.50339189733495e-06, -0.45146918296813965, -6.6756979322235566e-06, -0.0006064721383154392, -1.5497195136049413e-06, -0.026862401515245438, -0.08894501626491547, -0.0030687404796481133, -0.0028084381483495235, -1.1920928244535389e-07, -0.4582592844963074, -0.029815562069416046, -2.0265558760002023e-06, -3.6954811548639555e-06, -3.576278118089249e-07, -0.0013412775006145239, -0.05515376850962639, -1.680836794548668e-05, -7.152301259338856e-05, -9.77468371274881e-05, -0.38501861691474915, -0.0002553137019276619, -2.7418097943154862e-06, -0.0009327351581305265, -0.03509717434644699, -0.44583380222320557, -0.4034216105937958, -0.20822231471538544, 0.0, -0.0028249616734683514, -1.4305104514278355e-06, -4.172316494077677e-06, -3.099436753473128e-06, -0.0001419681793777272, -1.7881377516459906e-06, -2.9802276912960224e-06, -7.152531907195225e-06, -2.3841855067985307e-07, -4.0649541915627196e-05, -1.6689286894688848e-06, -9.536738616588