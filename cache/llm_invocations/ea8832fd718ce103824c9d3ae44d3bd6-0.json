gZeros(int x) {\n    int cnt = 0;\n    while (x && (x & 1) == 0) {\n        ++cnt;\n        x >>= 1;\n    }\n    return cnt;\n}\n\nint twoPowerCount[262155];\n\ninline int binomial(int n, int m) {\n    return (long long)fact[n] * invFact[m] % modVal * invFact[n - m] % modVal;\n}\n\ninline int recursiveSolve(int n, int k) {\n    if (n == 0) return 1;\n    if (k == 0) return 0;\n    if (dp[n][k] != -1) return dp[n][k];\n    \n    int step = 1 << bitCount[n];\n    int res = 0;\n    for (int i = n; i >= step; i -= 2) {\n        res = ((long long)res + (long long)binomial(n, i) * recursiveSolve(n - i, k - 1) % modVal * k) % modVal;\n    }\n    return dp[n][k] = res;\n}\n\nvector<pair<int, int>> orderList;\n\ninline int iterativeSolve(int startN, int startK) {\n    queue<pair<int, int>> q;\n    q.push({startN, startK});\n    \n    while (!q.empty()) {\n        auto cur = q.front(); q.pop();\n        int curN = cur.first, curK = cur.second;\n        orderList.push_back({curN, curK});\n        \n        if (curN == 0 || curK == 0) continue;\n        \n        int step = 1 << bitCount[curN];\n        for (int i = curN; i >= step; i -= 2) {\n            if (twoPowerCount[i] + twoPowerCount[curN - i] == twoPowerCount[curN] && !visited[curN - i][curK - 1]) {\n                visited[curN - i][curK - 1] = true;\n                q.push({curN - i, curK - 1});\n            }\n        }\n    }\n    \n    for (int idx = orderList.size() - 1; idx >= 0; --idx) {\n        int curN = orderList[idx].first, curK = orderList[idx].second;\n        if (curN == 0) {\n            dp[curN][curK] = 1;\n            continue;\n        }\n        if (curK == 0) {\n            dp[curN][curK] = 0;\n            continue;\n        }\n        \n        int step = 1 << bitCount[curN];\n        for (int i = curN; i >= step; i -= 2) {\n            if (twoPowerCount[i] + twoPowerCount[curN - i] == twoPowerCount[curN]) {\n                dp[curN][curK] = ((long long)dp[curN][curK] + (long long)binomial(curN, 