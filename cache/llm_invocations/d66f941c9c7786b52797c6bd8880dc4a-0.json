\n'), ord('\\r'), -1]\n    \n    def next_int(self):\n        return int(self.next())\n    \n    def next_long(self):\n        return int(self.next())\n    \n    def next_double(self):\n        return float(self.next())\n    \n    def next(self):\n        c = self.read()\n        while c != -1 and self.is_space_char(c):\n            c = self.read()\n        res = []\n        while c != -1 and not self.is_space_char(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n    \n    def next_line(self):\n        c = self.read()\n        while c != -1 and self.is_endline(c):\n            c = self.read()\n        res = []\n        while c != -1 and not self.is_endline(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\ndef main():\n    data = sys.stdin.buffer.read()\n    scanner = FastScanner(sys.stdin.buffer)\n    \n    n = scanner.next_int()\n    k = scanner.next_int()\n    segs = []\n    for _ in range(k):\n        segs.append([scanner.next_int(), scanner.next_int()])\n    \n    segs.sort(key=lambda x: x[0])\n    \n    finSeg = []\n    i = 0\n    while i < k:\n        lo = segs[i][0]\n        hi = segs[i][0]\n        while i < k and segs[i][0] <= hi:\n            hi = max(hi, segs[i][1])\n            i += 1\n        finSeg.append([lo, hi])\n        i -= 1\n        i += 1\n    \n    k = len(finSeg)\n    segs = finSeg[:]\n    l = [segs[i][1] - segs[i][0] for i in range(k)]\n    delt = []\n    for i in range(k):\n        if i < k - 1:\n            delt.append(segs[i+1][0] - segs[i][1])\n        else:\n            delt.append(2 * n - segs[i][1])\n    \n    dp = [[[0] * (2 * n + 1) for _ in range(k + 1)] for _ in range(2)]\n    \n    for i in range(2 * n + 1):\n        dp[0][k][i] = n\n        dp[1][k][i] = n\n    \n    dp[0][k][n] = 0\n    dp[1][k][n] = 0\n    \n    rmq = [None, None]\n    rmq[0] = RMQ(dp[0][k])\n    rmq[1] = RMQ(dp[1][k])\n    \n    for i in range(k - 1, -1, -1):\n        for j in range(2 * n + 1):\n            next0 = j + l[i] + delt[i]\n            dp[0][i][j] = dp[0][i+1][next0] if next0 <= 2 * n else n\n            dp[1][i][j] = dp[1][i+1][j]\n            \n            upper1 = min(j + l[i], 2 * n)\n            dp[0][i][j] = min(dp[0][i][j], 1 + rmq[1].min_range(j, upper1))\n            \n            if j + delt[i] <= 2 * n:\n                upper2 = min(j + l[i] + delt[i], 2 * n)\n                dp[1][i][j] = min(dp[1][i][j], 1 + rmq[0].min_range(j + delt[i], upper2))\n                dp[0][i][j] = min(dp[0][i][j], 2 + rmq[0].min_range(j + delt[i], upper2))\n            \n            upper1 = min(j + l[i], 2 * n)\n            dp[1][i][j] = min(dp[1][i][j], 2 + rmq[1].min_range(j, upper1))\n        \n        rmq[0] = RMQ(dp[0][i])\n        rmq[1] = RMQ(dp[1][i])\n    \n    ans = dp[1][0][0]\n    if ans == n:\n        print(\"Hungry\")\n    else:\n        print(\"Full\")\n        print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-6.639736966462806e-05, -1.4305104514278355e-06, -1.4305104514278355e-06, -0.01314262580126524, -0.005586487706750631, -0.0004922132357023656, -0.10021381080150604, -0.0007532381569035351, -0.3484528064727783, -0.026655230671167374, -0.029941676184535027, 0.0, -2.0265558760002023e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.5258672647178173e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -4.291525328881107e-06, 0.0, -0.004633641801774502, -3.814689989667386e-06, -5.245195097813848e-06, -0.0019287331961095333, -1.1920928244535389e-07, -1.4305104514278355e-06, -6.794698856538162e-05, 0.0, -7.152555099310121e-07, -8.344646857949556e-07, -0.01604408398270607, -2.145764938177308e-06, 0.0, -0.012737818993628025, 0.0, 0.0, -1.1920928244535389e-07, -9.298280929215252e-06, -0.0028071305714547634, -0.003191023599356413, -1.4305104514278355e-06, 0.0, -0.00013982271775603294, 0.0, -0.0024796947836875916, -7.1525319071