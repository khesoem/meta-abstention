1]*i%MO;\n\tinv[n]=pw(fac[n],MO-2);\n\tFORD(i,n-1,0) inv[i]=inv[i+1]*(i+1)%MO;\n\tint t=n;\n\tFOR(i,0,20){\n\t\tif (t&1) a[s++]=1<<i;\n\t\tt>>=1;\n\t}\n\tN=1<<s;\n\tFOR(i,0,N-1)\n\t\tFOR(j,0,s-1)\n\t\t\tif ((i>>j)&1) S[i]+=a[j];\n\tFOR(i,0,N-1){\n\t\tint t=-1;\n\t\tFOR(j,0,20)\n\t\t\tif ((i>>j)&1) t=j;\n\t\tp[i]=(1<<(t+1))+i;\n\t}\n\tf[0][0]=1;\n\tFOR(i,0,k-1)\n\t\tFOR(j,0,N-1)\n\t\t\tif (f[i][j]){\n\t\t\t\tfor (int k_val=p[j];k_val<N;k_val=(k_val+1)|j)\n\t\t\t\t\t(f[i+1][k_val]+=f[i][j]*inv[S[k_val^j]])%=MO;\n\t\t\t}\n\tFOR(i,0,k) (ans+=f[i][N-1]*P(k,i))%=MO;\n\tans=ans*fac[n]%MO;\n\tans=(pw(k,n)-ans+MO)%MO;\n\tcout<<ans<<endl;\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef getint():\n    line = sys.stdin.readline().strip()\n    if not line:\n        return getint()\n    v = 0\n    fu = False\n    for ch in line:\n        if ch == '-':\n            fu = True\n        elif ch.isdigit():\n            v = v * 10 + int(ch)\n    if fu:\n        v = -v\n    return v\n\ndef getints():\n    line = sys.stdin.readline().strip()\n    if not line:\n        return getints()\n    return list(map(int, line.split()))\n\ndef pw(x, y, MO):\n    t = 1\n    while y:\n        if y & 1:\n            t = t * x % MO\n        x = x * x % MO\n        y >>= 1\n    return t\n\ndef P(x, y, fac, inv, MO):\n    return fac[x] * inv[x - y] % MO\n\ndef main():\n    data = getints()\n    n, k, MO = data[0], data[1], data[2]\n    \n    if n & 1:\n        print(pw(k, n, MO))\n        return\n    \n    fac = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = fac[i - 1] * i % MO\n    \n    inv = [1] * (n + 1)\n    inv[n] = pw(fac[n], MO - 2, MO)\n    for i in range(n - 1, -1, -1):\n        inv[i] = inv[i + 1] * (i + 1) % MO\n    \n    t = n\n    a = []\n    s = 0\n    for i in range(21):\n        if t & 1:\n            a.append(1 << i)\n            s += 1\n        t >>= 1\n    \n    N = 1 << s\n    S = [0] * N\n    for i in range(N):\n        for j in range(s):\n            if (i >> j) & 1:\n                S[i] += a[j]\n    \n    p = [0] * N\n    for i in range(N):\n        t_val = -1\n        for j in range(21):\n            if (i >> j) & 1:\n                t_val = j\n        p[i] = (1 << (t_val + 1)) + i\n    \n    # Initialize f as a 2D list\n    f = [[0] * N for _ in range(k + 1)]\n    f[0][0] = 1\n    \n    for i in range(k):\n        for j in range(N):\n            if f[i][j]:\n                k_val = p[j]\n                while k_val < N:\n                    f[i + 1][k_val] = (f[i + 1][k_val] + f[i][j] * inv[S[k_val ^ j]]) % MO\n                    k_val = (k_val + 1) | j\n    \n    ans = 0\n    for i in range(k + 1):\n        ans = (ans + f[i][N - 1] * P(k, i, fac, inv, MO)) % MO\n    \n    ans = ans * fac[n] % MO\n    ans = (pw(k, n, MO) - ans + MO) % MO\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00021336186910048127, -1.0728830375228426e-06, -5.960462772236497e-07, -0.030245207250118256, -0.0026587634347379208, -0.029791610315442085, -0.005251660011708736, -1.0395053625106812, -0.0212219450622797, -0.002460549585521221, -1.7881377516459906e-06, -0.07875070720911026, -2.50339189733495e-06, -0.000969297660049051, -8.344646857949556e-07, -0.0014267513761296868, -0.00672162463888526, -0.005244900938123465, -0.012521225959062576, -8.344646857949556e-07, -0.2518634498119354, -0.020606597885489464, -9.536738616588991e-07, -3.2186455882765586e-06, -4.768370445162873e-07, -0.0011355387978255749, -0.6430359482765198, -3.576278118089249e-07, -4.637133679352701e-05, -0.0003846143954433501, -0.609434962272644, -0.000559292733669281, -0.002144895726814866, -1.1920928244535389e-07, 0.0, -2.264974000354414e-06, -0.006912247743457556, -2.3841855067985307e-07, -0.4740871489048004, -6.627816765103489e-05, -2.50339189