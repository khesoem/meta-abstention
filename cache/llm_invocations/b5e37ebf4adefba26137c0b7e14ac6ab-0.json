Integer> Q = new LinkedList<>();\n            Q.add(s);\n            while (!Q.isEmpty()) {\n                int u = Q.poll();\n                inq[u] = 0;\n                for (int idx : g[u]) {\n                    Edge ee = e.get(idx);\n                    if (ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost) {\n                        d[ee.to] = d[u] + ee.cost;\n                        p[ee.to] = idx;\n                        aug[ee.to] = Math.min(aug[u], ee.cap - ee.flow);\n                        if (inq[ee.to] == 0) {\n                            Q.add(ee.to);\n                            inq[ee.to] = 1;\n                        }\n                    }\n                }\n            }\n            if (d[t] == INF) return false;\n            flow[0] += aug[t];\n            cost[0] += d[t] * aug[t];\n            int u = t;\n            while (u != s) {\n                e.get(p[u]).flow += aug[t];\n                e.get(p[u] ^ 1).flow -= aug[t];\n                u = e.get(p[u]).from;\n            }\n            return true;\n        }\n\n        int minCost(int s, int t) {\n            int[] flow = new int[1];\n            int[] cost = new int[1];\n            while (bellman(s, t, flow, cost));\n            return cost[0];\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] a = new int[k + 1]; // 1-indexed\n        for (int i = 1; i <= k; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        int startPoint = 0;\n        int endPoint = n * 100 + 1;\n\n        MCMF solve = new MCMF();\n        solve.Init(endPoint);\n\n        for (int i = 1; i <= k; i++) {\n            solve.add(startPoint, 1 + (a[i] - 1) * 100, 1, 0);\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                int p = (i - 1) * 100;\n                solve.add(p + j, p + j + 1, INF, c);\n            }\n        }\n\n        for (int i = 1; i <= 100; i++) {\n            solve.add(i, endPoint, INF, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                int p = (x - 1) * 100 + j;\n                int pp = (y - 1) * 100 + j + 1;\n                for (int t = 1; t <= 50; t++) {\n                    solve.add(p, pp, 1, d * (t * t - (t - 1) * (t - 1)) + c);\n                }\n            }\n            for (int j = 1; j < 100; j++) {\n                int p = (y - 1) * 100 + j;\n                int pp = (x - 1) * 100 + j + 1;\n                for (int t = 1; t <= 50; t++) {\n                    solve.add(p, pp, 1, d * (t * t - (t - 1) * (t - 1)) + c);\n                }\n            }\n        }\n\n        System.out.println(solve.minCost(startPoint, endPoint));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, -4.9470632802695036e-05, -1.4066597032069694e-05, 0.0, -9.619726915843785e-05, -0.015321064740419388, -0.001545426552183926, 0.0, -0.005387667566537857, -0.029764071106910706, -0.0009133219718933105, -0.000860201776959002, -0.31424131989479065, -0.018150195479393005, -0.0005895545473322272, -0.0015444743912667036, -0.5797227025032043, -0.004133135080337524, -2.3841855067985307e-07, -7.152555099310121e-07, -0.00012385078298393637, -0.6099178791046143, -0.01453161146491766, -0.8137515783309937, -5.602820692729438e-06, -0.30696240067481995, -2.7894584491150454e-05, -0.03131631761789322, -0.6020702123641968, -1.1920928244535389e-07, -0.0016017238376662135, -9.262132516596466e-05, -2.2291887944447808e-05, -1.4305104514278355e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, -2.264974000354414e-06, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244