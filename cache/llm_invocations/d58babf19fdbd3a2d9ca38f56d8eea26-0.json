e (exp) {\n        if (exp & 1) res = mod_mul(res, base);\n        base = mod_mul(base, base);\n        exp >>= 1;\n    }\n    return res;\n}\n\ninline int comb(int n, int k) {\n    return mod_mul((ll)fac[n], (ll)inv[k] * inv[n - k] % MOD);\n}\n\nint main() {\n    Fread(N); Fread(M); Fread(MOD);\n    \n    fac[0] = 1;\n    for (int i = 1; i <= N; ++i)\n        fac[i] = mod_mul(fac[i - 1], i);\n    \n    inv[N] = mod_pow(fac[N], MOD - 2);\n    for (int i = N; i >= 1; --i)\n        inv[i - 1] = mod_mul(inv[i], i);\n    \n    F[0] = 0; G[0] = 1;\n    for (int i = 1; i <= N; ++i) {\n        for (int j = 1; j <= i; ++j) {\n            int cur = mod_mul(comb(i - 1, j - 1), i + 1);\n            G[i] = mod_add(G[i], mod_mul((ll)G[j - 1] * G[i - j] % MOD, cur));\n            F[i] = mod_add(F[i], mod_mul((ll)F[j - 1] * G[i - j] % MOD, cur));\n            F[i] = mod_add(F[i], mod_mul((ll)G[j - 1] * F[i - j] % MOD, cur));\n            int pt = (j - 1) * j / 2 + (i - j) * (i - j + 1) / 2;\n            F[i] = mod_add(F[i], mod_mul((ll)comb(i - 1, j - 1) * (ll)G[j - 1] % MOD * G[i - j] % MOD, pt));\n        }\n    }\n    \n    d1[0][0][1] = 0;\n    d2[0][0][1] = 1;\n    for (int i = 1; i <= N; ++i) {\n        for (int j = 0; j <= i; ++j) {\n            d1[i][j][1] = mod_add(d1[i - 1][j][0], d1[i - 1][j][1]);\n            d2[i][j][1] = mod_add(d2[i - 1][j][0], d2[i - 1][j][1]);\n            for (int k = 1; k <= j; ++k) {\n                int c = comb(j, k);\n                d1[i][j][0] = mod_add(d1[i][j][0], mod_mul((ll)c * d2[i - k][j - k][1] % MOD, F[k]));\n                d1[i][j][0] = mod_add(d1[i][j][0], mod_mul((ll)c * d1[i - k][j - k][1] % MOD, G[k]));\n                d2[i][j][0] = mod_add(d2[i][j][0], mod_mul((ll)c * d2[i - k][j - k][1] % MOD, G[k]));\n            }\n        }\n    }\n    \n    Fout(mod_add(d1[N][M][0], d1[N][M][1]));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"sa