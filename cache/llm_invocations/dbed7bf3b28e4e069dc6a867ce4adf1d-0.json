   preve = new int[n];\n            inq = new boolean[n];\n        }\n\n        static void add_edge(int from, int to, long cap, long cost) {\n            g[from].add(new Edge(to, g[to].size(), cap, cost));\n            g[to].add(new Edge(from, g[from].size() - 1, 0, -cost));\n        }\n\n        static long min_cost_flow(int s, int t, long[] price, int n, boolean sparse) {\n            final long INF = (long) 1e18;\n            Arrays.fill(pot, 0, n, 0);\n            long flow = 0;\n            price[0] = 0;\n            while (true) {\n                Arrays.fill(dist, 0, n, INF);\n                Arrays.fill(inq, 0, n, false);\n                dist[s] = 0;\n                Queue<Integer> q = new LinkedList<>();\n                q.add(s);\n                inq[s] = true;\n                while (!q.isEmpty()) {\n                    int v = q.poll();\n                    inq[v] = false;\n                    for (int i = 0; i < g[v].size(); i++) {\n                        Edge e = g[v].get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to];\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            if (!inq[e.to]) {\n                                q.add(e.to);\n                                inq[e.to] = true;\n                            }\n                        }\n                    }\n                }\n                if (dist[t] >= INF) break;\n                for (int v = 0; v < n; v++) pot[v] += dist[v];\n                long d = INF;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, g[prevv[v]].get(preve[v]).cap);\n                }\n                flow += d;\n                price[0] += d * pot[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g[prevv[v]].get(preve[v]);\n           