   BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] firstLine = br.readLine().split(\" \");\n        int n = Integer.parseInt(firstLine[0]);\n        int m = Integer.parseInt(firstLine[1]);\n        \n        String[] secondLine = br.readLine().split(\" \");\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = Long.parseLong(secondLine[i]);\n        }\n        \n        List<Long> a1 = new ArrayList<>();\n        List<Long> a2 = new ArrayList<>();\n        int n1 = n / 2;\n        \n        generateSumsLeft(a, a1, 0, 0, n1, m);\n        generateSumsRight(a, a2, n1, 0, n, m);\n        \n        long ans = 0;\n        Set<Long> set = new HashSet<>(a1);\n        List<Long> sortedA1 = new ArrayList<>(set);\n        Collections.sort(sortedA1);\n        \n        for (long val : a2) {\n            long target = m - val;\n            int pos = binarySearchLeft(sortedA1, target);\n            if (pos > 0) {\n                long candidate = sortedA1.get(pos - 1) + val;\n                if (candidate > ans) {\n                    ans = candidate;\n                }\n            }\n        }\n        \n        System.out.println(ans);\n    }\n    \n    private static void generateSumsLeft(long[] a, List<Long> result, int idx, long total, int n1, int m) {\n        if (idx == n1) {\n            result.add(total % m);\n        } else {\n            generateSumsLeft(a, result, idx + 1, (total + a[idx]) % m, n1, m);\n            generateSumsLeft(a, result, idx + 1, total, n1, m);\n        }\n    }\n    \n    private static void generateSumsRight(long[] a, List<Long> result, int idx, long total, int n, int m) {\n        if (idx == n) {\n            result.add(total % m);\n        } else {\n            generateSumsRight(a, result, idx + 1, (total + a[idx]) % m, n, m);\n            generateSumsRight(a, result, idx + 1, total, n, m);\n        }\n    }\n    \n    private static int binarySearchLeft(List<Long> list, long target) {\n        int left = 0;\n        int right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) < target) {\n                left = mid + 1;\n            } else {\n                right = mid;\n            }\n        }\n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011467275908216834, -1.9073468138230965e-06, -2.3841855067985307e-07, -3.71926071238704e-05, -1.2516897186287679e-05, -0.029751921072602272, -0.5768389105796814, -0.0006418551784008741, -2.706014311115723e-05, -0.00016378014697693288, -0.00035720644518733025, -1.168244216387393e-05, -5.483612312673358e-06, -8.320462075062096e-05, -0.0024776733480393887, -2.4914430468925275e-05, -0.4293757975101471, -1.7881377516459906e-06, -0.00022933237778488547, -1.7881377516459906e-06, -5.960462772236497e-07, -3.2186455882765586e-06, -1.2993727978027891e-05, -2.3841855067985307e-07, -0.014196122996509075, -0.014189423061907291, -2.145764938177308e-06, -4.887569048150908e-06, -0.00016449528629891574, -0.0001629458274692297, -5.960462772236497e-07, -8.344646857949556e-07, -6.6756979322235566e-06, -5.364403477869928e-06, -2.062299427052494e-05, -1.7404405298293568e-05, -9.059865078597795e-06, -2.4318398573086597e-05, -7.629365427419543e-06, -0.010862387716770172, -1.7881377516459906e-06, -0.8023802042007446, -3.6954195820726454e-05, 0.0, -3.933898824470816e-06, -1.0967194612021558e-05, -3.576278118089249e-07, -6.353653589030728e-05, -0.00038223114097490907, -0.00013171759201213717, -1.764281842042692e-05, -1.311301275563892e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.7881233361549675e-05, -1.1920928244535389e-07, -2.396077979938127e-05, -1.5497195136049413e-06, 0.0, 0.0, -3.576272320060525e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -4.172316494077677e-06, 0.0, -7.510157047363464e-06, -1.2040065485052764e-05, -1.