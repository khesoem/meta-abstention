n        edges.append([u, len(graph[u]), 0, 0])\n        graph[v].append(len(edges) - 1)\n\n    di = [-1] * N\n    ptr = [0] * N\n\n    def bfs():\n        for i in range(N):\n            di[i] = -1\n        q = deque()\n        q.append(source)\n        di[source] = 0\n        while q:\n            v = q.popleft()\n            for id in graph[v]:\n                to, rev, cap, flow = edges[id]\n                if di[to] == -1 and flow < cap:\n                    di[to] = di[v] + 1\n                    q.append(to)\n        return di[sink] != -1\n\n    def dfs(v, flow):\n        if flow == 0:\n            return 0\n        if v == sink:\n            return flow\n        while ptr[v] < len(graph[v]):\n            id = graph[v][ptr[v]]\n            to, rev, cap, flow_e = edges[id]\n            if di[to] == di[v] + 1:\n                pushed = dfs(to, min(flow, cap - flow_e))\n                if pushed:\n                    edges[id][3] += pushed\n                    edges[rev][3] -= pushed\n                    return pushed\n            ptr[v] += 1\n        return 0\n\n    def max_flow():\n        flow = 0\n        while bfs():\n            for i in range(N):\n                ptr[i] = 0\n            while True:\n                pushed = dfs(source, 10**9)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\n    # Build graph\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Y':\n                continue\n            node1 = i * n + j + 1\n            node2 = n * n + i * n + j + 1\n            cap_a = ord(a[i][j]) - ord('0')\n            cap_b = ord(b[i][j]) - ord('0')\n            add_edge(source, node1, cap_a)\n            add_edge(node2, sink, cap_b)\n\n            # BFS2 from (i,j) in grid a\n            dist2 = [[10**9] * n for _ in range(n)]\n            q = deque()\n            q.append((i, j))\n            dist2[i][j] = 0\n            while q:\n                x, y = q.p