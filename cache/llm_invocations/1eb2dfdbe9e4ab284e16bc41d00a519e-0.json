im[nx][ny] > tim[x][y] + 1:\n                tim[nx][ny] = tim[x][y] + 1\n                q.append(nx * 10 + ny)\n    return tim\n\ndef bfs2(sx, sy, g, h, tim, n, limitTime):\n    dist = [[INF]*n for _ in range(n)]\n    q = deque()\n    q.append(sx * 10 + sy)\n    dist[sx][sy] = 0\n    while q:\n        code = q.popleft()\n        x = code // 10\n        y = code % 10\n        for dx, dy in dirs:\n            nx, ny = x + dx, y + dy\n            if inside(nx, ny, n) and '0' <= h[nx][ny] <= '9' and dist[nx][ny] > dist[x][y] + 1:\n                if tim[nx][ny] >= dist[x][y] + 1:\n                    dist[nx][ny] = dist[x][y] + 1\n                    if tim[nx][ny] > dist[nx][ny]:\n                        q.append(nx * 10 + ny)\n    return dist\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    limitTime = int(next(it))\n    g = [list(next(it).strip()) for _ in range(n)]\n    h = [list(next(it).strip()) for _ in range(n)]\n\n    # Find Z and run bfs1\n    tim = None\n    for i in range(n):\n        for j in range(n):\n            if g[i][j] == 'Z':\n                tim = bfs1(i, j, g, n)\n                break\n        if tim is not None:\n            break\n\n    S = 0\n    T = n * n * 2 + 1\n    # Initialize graph (clear previous)\n    global graph, edges\n    graph = [[] for _ in range(MAXN)]\n    edges = []\n\n    # Add edges from source to g cells and from h cells to sink\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                add_edge(S, i * n + j + 1, ord(g[i][j]) - ord('0'))\n            if '1' <= h[i][j] <= '9':\n                add_edge(n * n + i * n + j + 1, T, ord(h[i][j]) - ord('0'))\n\n    # For each g cell with digit, run bfs2 and add edges to h cells within limitTime\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                dist = bfs2(i, j, g, h, tim, n, limitTime)\n  