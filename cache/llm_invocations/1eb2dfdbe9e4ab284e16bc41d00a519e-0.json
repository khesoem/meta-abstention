    SimpleQueue q;\n    q.clear();\n    height[sourceNode] = 0;\n    q.push(sourceNode);\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        for (int e = firstEdge[u]; e != -1; e = nextEdge[e]) {\n            int v = vertex[e];\n            if (height[v] == -1 && capacity[e] > usedFlow[e]) {\n                height[v] = height[u] + 1;\n                q.push(v);\n            }\n        }\n    }\n    return height[sinkNode] != -1;\n}\n\nint augment(int u, int pushed) {\n    if (u == sinkNode || pushed == 0) return pushed;\n    int sent = 0;\n    for (int &e = current[u]; e != -1; e = nextEdge[e]) {\n        int v = vertex[e];\n        if (height[v] == height[u] + 1 && capacity[e] > usedFlow[e]) {\n            int tmp = augment(v, min(pushed, capacity[e] - usedFlow[e]));\n            if (tmp > 0) {\n                usedFlow[e] += tmp;\n                usedFlow[e ^ 1] -= tmp;\n                pushed -= tmp;\n                sent += tmp;\n                if (pushed == 0) break;\n            }\n        }\n    }\n    return sent;\n}\n\nint maxflow(int s, int t) {\n    sourceNode = s;\n    sinkNode = t;\n    int ans = 0;\n    while (buildLevels()) {\n        memcpy(current, firstEdge, sizeof(firstEdge));\n        ans += augment(sourceNode, INF);\n    }\n    return ans;\n}\n\nint tim[12][12], dist[12][12];\nchar g[MAXN][MAXN], h[MAXN][MAXN];\nint n, limitTime;\n\nbool inside(int x, int y) {\n    return x >= 0 && x < n && y >= 0 && y < n;\n}\n\nvoid bfs1(int sx, int sy) {\n    memset(tim, 0x3f, sizeof(tim));\n    SimpleQueue q;\n    q.clear();\n    q.push(sx * 10 + sy);\n    tim[sx][sy] = 0;\n    while (!q.empty()) {\n        int x = q.front() / 10, y = q.front() % 10;\n        q.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + dir[k][0], ny = y + dir[k][1];\n            if (inside(nx, ny) && g[nx][ny] >= '0' && g[nx][ny] <= '9' && tim[nx][ny] > tim[x][y] + 1) {\n                tim[nx][ny] = tim[x][y] + 1;\n               