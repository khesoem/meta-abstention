igit);\n}\n\nbool qualifies(llong prefix) {\n    const llong cutoff = 1000000LL;\n    return prefix * cutoff + 999999LL <= max_n && prefix * cutoff * 10LL > max_n;\n}\n\nllong counter_b;\nllong ten_powers[7] = {1LL, 10LL, 100LL, 1000LL, 10000LL, 100000LL, 1000000LL};\n\nvoid traverse(llong depth, llong current) {\n    if (current > max_n) return;\n    if (qualifies(current)) {\n        for (int i = 0; i < 7; ++i) {\n            llong diff = ((counter_b + 1LL) - current * ten_powers[i]) % MOD1;\n            if (diff < 0LL) diff += MOD1;\n            auto iter = lower_bound(pattern[i].begin(), pattern[i].end(), MOD1 - diff);\n            llong suffix_len = pattern[i].end() - iter;\n            final_ans = (final_ans + running_sum[i] + diff * (llong)pattern[i].size() - MOD1 * suffix_len) % MOD2;\n        }\n        counter_b += counter_a;\n    } else {\n        ++counter_b;\n        llong diff = (counter_b - current) % MOD1;\n        if (diff < 0LL) diff += MOD1;\n        final_ans = (final_ans + diff) % MOD2;\n        llong start_digit = (depth == 0 ? 1 : 0);\n        for (int digit = start_digit; digit <= 9; ++digit) traverse(depth + 1, current * 10 + digit);\n    }\n}\n\nint main() {\n    IO::Read(max_n);\n    build_table(0, 0);\n    for (int i = 0; i < 7; ++i) sort(pattern[i].begin(), pattern[i].end());\n    counter_b = -1LL;\n    traverse(0, 0);\n    IO::Write(final_ans);\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef read_int():\n    line = sys.stdin.readline().strip()\n    if not line:\n        return None\n    return int(line)\n\ndef write_int(x):\n    if x < 0:\n        sys.stdout.write('-')\n        x = -x\n    if x > 9:\n        write_int(x // 10)\n    sys.stdout.write(str(x % 10))\n\nMOD1 = 998244353\nMOD2 = 1000000007\n\nfinal_ans = 0\nmax_n = 0\ncounter_a = 0\nrunning_sum = [0] * 7\npattern = [[] for _ in range(7)]\n\ndef build_table(depth, num):\n    global counter_a\n    if depth == 7:\n        return\n    val = (counter_a - num + MOD1) % MOD1\n    pattern[depth].append(val)\n    running_sum[depth] = (running_sum[depth] + val) % MOD2\n    counter_a += 1\n    for digit in range(10):\n        build_table(depth + 1, num * 10 + digit)\n\ndef qualifies(prefix):\n    cutoff = 1000000\n    return prefix * cutoff + 999999 <= max_n and prefix * cutoff * 10 > max_n\n\ncounter_b = 0\nten_powers = [1, 10, 100, 1000, 10000, 100000, 1000000]\n\ndef traverse(depth, current):\n    global final_ans, counter_b\n    if current > max_n:\n        return\n    if qualifies(current):\n        for i in range(7):\n            diff = ((counter_b + 1) - current * ten_powers[i]) % MOD1\n            if diff < 0:\n                diff += MOD1\n            # Binary search for lower_bound\n            arr = pattern[i]\n            lo, hi = 0, len(arr)\n            while lo < hi:\n                mid = (lo + hi) // 2\n                if arr[mid] < MOD1 - diff:\n                    lo = mid + 1\n                else:\n                    hi = mid\n            suffix_len = len(arr) - lo\n            final_ans = (final_ans + running_sum[i] + diff * len(arr) - MOD1 * suffix_len) % MOD2\n        counter_b += counter_a\n    else:\n        counter_b += 1\n        diff = (counter_b - current) % MOD1\n        if diff < 0:\n            diff += MOD1\n        final_ans = (final_ans + diff) % MOD2\n        start_digit = 1 if depth == 0 else 0\n        for digit in range(start_digit, 10):\n            traverse(depth + 1, current * 10 + digit)\n\ndef main():\n    global max_n, final_ans, counter_a, counter_b, running_sum, pattern\n    max_n = read_int()\n    build_table(0, 0)\n    for i in range(7):\n        pattern[i].sort()\n    counter_b = -1\n    traverse(0, 0)\n    write_int(final_ans % MOD2)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000321813