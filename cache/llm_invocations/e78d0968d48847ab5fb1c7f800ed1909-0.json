   inq[s] = 1;\n            p[s] = 0;\n            avail[s] = Integer.MAX_VALUE;\n            Queue<Integer> Q = new LinkedList<>();\n            Q.add(s);\n            while (!Q.isEmpty()) {\n                int u = Q.poll();\n                inq[u] = 0;\n                for (int idx : g.get(u)) {\n                    Edge ee = e.get(idx);\n                    if (ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost) {\n                        d[ee.to] = d[u] + ee.cost;\n                        p[ee.to] = idx;\n                        avail[ee.to] = Math.min(avail[u], ee.cap - ee.flow);\n                        if (inq[ee.to] == 0) {\n                            Q.add(ee.to);\n                            inq[ee.to] = 1;\n                        }\n                    }\n                }\n            }\n            if (d[t] == INF) return false;\n            flow[0] += avail[t];\n            cost[0] += d[t] * avail[t];\n            int u = t;\n            while (u != s) {\n                e.get(p[u]).flow += avail[t];\n                e.get(p[u] ^ 1).flow -= avail[t];\n                u = e.get(p[u]).from;\n            }\n            return true;\n        }\n\n        int minCost(int s, int t) {\n            int[] flow = new int[1];\n            int[] cost = new int[1];\n            while (bellman(s, t, flow, cost);\n            return cost[0];\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        int[] a = new int[k + 1];\n        for (int i = 1; i <= k; i++) {\n            a[i] = Integer.parseInt(st.nextToken());\n        }\n        int startPoint = 0;\n        int endPoint = n * 100 + 1;\n        MCMF solve = new MCMF();\n        solve.init(endPoint + 1);\n        for (int i = 1; i <= k; i++) {\n            solve.add(startPoint, 1 + (a[i] - 1) * 100, 1, 0);\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                int p = (i - 1) * 100 + j;\n                solve.add(p, p + 1, Integer.MAX_VALUE, c);\n            }\n        }\n        for (int i = 1; i <= 100; i++) {\n            solve.add(i, endPoint, Integer.MAX_VALUE, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            for (int j = 1; j < 100; j++) {\n                int p = (x - 1) * 100 + j;\n                int pp = (y - 1) * 100 + j + 1;\n                for (int t = 1; t <= 50; t++) {\n                    solve.add(p, pp, 1, d * (2 * t - 1) + c);\n                }\n            }\n            for (int j = 1; j < 100; j++) {\n                int p = (y - 1) * 100 + j;\n                int pp = (x - 1) * 100 + j + 1;\n                for (int t = 1; t <= 50; t++) {\n                    solve.add(p, pp, 1, d * (2 * t - 1) + c);\n                }\n            }\n        }\n        System.out.println(solve.minCost(startPoint, endPoint));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, -0.004451841115951538, -2.9802276912960224e-06, 0.0, -1.1920928244535389e-07, -9.274052717955783e-05, -2.7417760065873154e-05, 0.0, -0.006715348921716213, -0.10022307932376862, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -4.136476854910143e-05, -0.07923087477684021, -1.1920928244535389e-07, -0.0036545887123793364, -0.01420646533370018, -0.0009135602158494294, -0.0034332876093685627, -0.0646653026342392, -1.4066597032069694e-05, -7.152555099310121e-07, 0.0, -1.