n    }\n    printf(\"%d/%d\\n\",ans1,ans2);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final double INF = 1e9;\n\n    static double Tabs(double n) {\n        return n >= 0 ? n : -n;\n    }\n\n    static int solve_it(int x, int y, int b) {\n        double target = (double) x / y;\n        int lb = 0, ub = 1000000;\n        for (int i = 0; i < 25; i++) {\n            int a = lb + ((ub - lb) >> 1);\n            if ((double) a / b < target) {\n                lb = a;\n            } else {\n                ub = a;\n            }\n        }\n        int res = 0;\n        double diff = Double.MAX_VALUE;\n        for (int a = lb - 10; a <= ub + 10; a++) {\n            double d = Tabs((double) a / b - target);\n            if (d < diff) {\n                diff = d;\n                res = a;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int x = scanner.nextInt();\n        int y = scanner.nextInt();\n        int n = scanner.nextInt();\n        int ans1 = 0, ans2 = 1;\n        double best_diff = Double.MAX_VALUE;\n        for (int b = 1; b <= n; b++) {\n            int a = solve_it(x, y, b);\n            double d = Tabs((double) a / b - (double) x / y);\n            if (d < best_diff) {\n                best_diff = d;\n                ans1 = a;\n                ans2 = b;\n            }\n        }\n        System.out.println(ans1 + \"/\" + ans2);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010966652916977182, -1.311301275563892e-06, -2.3841855067985307e-07, -0.0010087168775498867, -7.510157047363464e-06, -0.023272700607776642, -0.04064764827489853, -5.7338023907504976e-05, -5.960462772236497e-07, -5.3881147323409095e-05, -0.01416