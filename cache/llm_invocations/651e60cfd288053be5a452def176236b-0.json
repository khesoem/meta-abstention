       \n        System.out.println(result);\n    }\n\n    static class InputProcessor {\n        private final BufferedReader reader;\n        private StringTokenizer tokenizer;\n\n        public InputProcessor(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream));\n        }\n\n        public String nextToken() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(nextToken());\n        }\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998_244_353L;\n        private long[] fact;\n        private long[] invFact;\n\n        public void prepareFactorials(int maxN) {\n            fact = new long[maxN + 1];\n            invFact = new long[maxN + 1];\n            fact[0] = 1;\n            for (int i = 1; i <= maxN; i++) {\n                fact[i] = multiply(fact[i - 1], i);\n            }\n            invFact[maxN] = modPow(fact[maxN], MOD - 2);\n            for (int i = maxN - 1; i >= 0; i--) {\n                invFact[i] = multiply(invFact[i + 1], i + 1);\n            }\n        }\n\n        public long binomial(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return multiply(fact[n], multiply(invFact[r], invFact[n - r]));\n        }\n\n        public long modularInverse(int x) {\n            return multiply(invFact[x], fact[x - 1]);\n        }\n\n        public long sum(long a, long b) {\n            long res = a + b;\n            return res >= MOD ? res - MOD : res;\n        }\n\n        public long difference(long a, long b) {\n            long res = a - b;\n            return res < 0 ? res + MOD : res;\n        