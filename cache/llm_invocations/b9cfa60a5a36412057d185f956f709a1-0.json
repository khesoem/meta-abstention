{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <algorithm>\n#include <iostream>\n#include <cstdio>\n#include <vector>\n#include <deque>\n#include <cstring>\nusing namespace std;\n\nvector<int> e[2020];\nint ir[20][20], sc[20][20], pc[20][20];\nchar s[20][20], p[20][20];\nint dd[20][20];\nint dx[5] = {0,1,-1,0};\nint dy[5] = {1,0,0,-1};\nvector<int> ns[20][20], np[20][20];\nint sp, pp;\nint ds[2020], pa[2020];\n\nvoid ade(int a, int b) {\n    e[a].push_back(b);\n    e[b].push_back(a);\n}\n\nbool bfs() {\n    deque<int> q;\n    for (int i = 1; i <= sp; ++i) {\n        if (pa[i] == 0) {\n            ds[i] = 0;\n            q.push_back(i);\n        } else {\n            ds[i] = 3010;\n        }\n    }\n    ds[0] = 3010;\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop_front();\n        if (ds[u] < ds[0]) {\n            for (int v : e[u]) {\n                int w = pa[v];\n                if (ds[w] > ds[u] + 1) {\n                    ds[w] = ds[u] + 1;\n                    q.push_back(w);\n                }\n            }\n        }\n    }\n    return ds[0] != 3010;\n}\n\nbool dfs(int x) {\n    if (x == 0) return 1;\n    for (int v : e[x]) {\n        int u = pa[v];\n        if (ds[u] == ds[x] + 1) {\n            if (dfs(u)) {\n                pa[x] = v;\n                pa[v] = x;\n                return 1;\n            }\n        }\n    }\n    return 0;\n}\n\nint hkp() {\n    int an = 0;\n    while (bfs()) {\n        for (int i = 1; i <= sp; ++i) {\n            if (pa[i] == 0)\n                an += dfs(i);\n        }\n    }\n    return an;\n}\n\nint n, t;\n\nvoid wk(int a, int b) {\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            dd[i][j] = 100000;\n    deque<pair<int,int>> q;\n    dd[a][b] = 0;\n    q.push_back(make_pair(a,b));\n    while (!q.empty()) {\n        int x = q.front().first, y = q.front().second;\n        q.pop_front();\n        for (int i = 0; i < np[x][y].size(); ++i)\n            for (int j = 0; j < ns[a][b].size(); ++j)\n                ade(ns[a][b][j], np[x][y][i]);\n        if (dd[x][y] == ir[x][y]) continue;\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (sc[nx][ny] != -1 && dd[nx][ny] > dd[x][y] + 1 && dd[x][y] + 1 <= ir[nx][ny]) {\n                dd[nx][ny] = dd[x][y] + 1;\n                q.push_back(make_pair(nx,ny));\n            }\n        }\n    }\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            ir[i][j] = t;\n    for (int i = 1; i <= n; ++i)\n        scanf(\"%s\", s[i] + 1);\n    for (int i = 1; i <= n; ++i)\n        scanf(\"%s\", p[i] + 1);\n    int rx, ry;\n    sp = 1; pp = 1000;\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (s[i][j] == 'Z' || s[i][j] == 'Y')\n                sc[i][j] = -1, ir[i][j] = 0;\n            if (s[i][j] == 'Z')\n                rx = i, ry = j, ir[i][j] = 0;\n            if ('0' <= s[i][j] && s[i][j] <= '9')\n                sc[i][j] = s[i][j] - '0';\n            for (int k = 0; k < sc[i][j]; ++k)\n                ns[i][j].push_back(sp++);\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if ('0' <= p[i][j] && p[i][j] <= '9')\n                pc[i][j] = p[i][j] - '0';\n            for (int k = 0; k < pc[i][j]; ++k)\n                np[i][j].push_back(pp++);\n        }\n    }\n    deque<pair<int,int>> q;\n    q.push_back(make_pair(rx, ry));\n    while (!q.empty()) {\n        rx = q.front().first; ry = q.front().second;\n        q.pop_front();\n        int nx, ny;\n        for (int d = 0; d < 4; ++d) {\n            nx = rx + dx[d];\n            ny = ry + dy[d];\n            if (ir[nx][ny] > ir[rx][ry] + 1 && sc[nx][ny] != -1) {\n                ir[nx][ny] = ir[rx][ry] + 1;\n                q.push_back(make_pair(nx, ny));\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (sc[i][j] > 0)\n                wk(i, j);\n    printf(\"%d\", hkp());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    # Initialize grids (0-indexed)\n    ir = [[t] * (n+2) for _ in range(n+2)]  # extra border for safety\n    sc = [[0] * (n+2) for _ in range(n+2)]\n    pc = [[0] * (n+2) for _ in range(n+2)]\n    s = [[''] * (n+2) for _ in range(n+2)]\n    p = [[''] * (n+2) for _ in range(n+2)]\n    # Read s grid\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            s[i][j] = line[j-1]\n    # Read p grid\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            p[i][j] = line[j-1]\n\n    # Directions\n    dx = [0, 1, -1, 0]\n    dy = [1, 0, 0, -1]\n\n    # Node counters\n    sp = 1\n    pp = 1000\n    # ns and np: list of node indices for each cell\n    ns = [[[] for _ in range(n+2)] for _ in range(n+2)]\n    np = [[[] for _ in range(n+2)] for _ in range(n+2)]\n\n    rx = ry = 0\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if s[i][j] == 'Z' or s[i][j] == 'Y':\n                sc[i][j] = -1\n                ir[i][j] = 0\n            if s[i][j] == 'Z':\n                rx, ry = i, j\n                ir[i][j] = 0\n            if '0' <= s[i][j] <= '9':\n                sc[i][j] = int(s[i][j])\n            for _ in range(sc[i][j]):\n                ns[i][j].append(sp)\n                sp += 1\n\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '0' <= p[i][j] <= '9':\n                pc[i][j] = int(p[i][j])\n            for _ in range(pc[i][j]):\n                np[i][j].append(pp)\n                pp += 1\n\n    # BFS from Z to compute ir (time to reach)\n    q = deque()\n    q.append((rx, ry))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 1 <= nx <= n and 1 <= ny <= n:\n                if ir[nx][ny] > ir[x][y] + 1 and sc[nx][ny] != -1:\n                    ir[nx][ny] = ir[x][y] + 1\n                    q.append((nx, ny))\n\n    # Hopcroft-Karp structures\n    max_nodes = 2020  # as in original code\n    e = [[] for _ in range(max_nodes)]\n    ds = [0] * max_nodes\n    pa = [0] * max_nodes\n\n    def ade(a, b):\n        e[a].append(b)\n        e[b].append(a)\n\n    def bfs():\n        q = deque()\n        for i in range(1, sp):\n            if pa[i] == 0:\n                ds[i] = 0\n                q.append(i)\n            else:\n                ds[i] = 3010\n        ds[0] = 3010\n        while q:\n            u = q.popleft()\n            if ds[u] < ds[0]:\n                for v in e[u]:\n                    w = pa[v]\n                    if ds[w] > ds[u] + 1:\n                        ds[w] = ds[u] + 1\n                        q.append(w)\n        return ds[0] != 3010\n\n    def dfs(x):\n        if x == 0:\n            return True\n        for v in e[x]:\n            u = pa[v]\n            if ds[u] == ds[x] + 1:\n                if dfs(u):\n                    pa[x] = v\n                    pa[v] = x\n                    return True\n        return False\n\n    def hkp():\n        ans = 0\n        while bfs():\n            for i in range(1, sp):\n                if pa[i] == 0:\n                    if dfs(i):\n                        ans += 1\n        return ans\n\n    # wk function: BFS from (a,b) and add edges\n    def wk(a, b):\n        dd = [[100000] * (n+2) for _ in range(n+2)]\n        q = deque()\n        dd[a][b] = 0\n        q.append((a, b))\n        while q:\n            x, y = q.popleft()\n            # Add edges between source nodes at (a,b) and target nodes at (x,y)\n            for i in np[x][y]:\n                for j in ns[a][b]:\n                    ade(j, i)\n            if dd[x][y] == ir[x][y]:\n                continue\n            for d in range(4):\n                nx = x + dx[d]\n                ny = y + dy[d]\n                if 1 <= nx <= n and 1 <= ny <= n:\n                    if sc[nx][ny] != -1 and dd[nx][ny] > dd[x][y] + 1 and dd[x][y] + 1 <= ir[nx][ny]:\n                        dd[nx][ny] = dd[x][y] + 1\n                        q.append((nx, ny))\n\n    # Call wk for each cell with sc>0\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if sc[i][j] > 0:\n                wk(i, j)\n\n    print(hkp())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-3.6954195820726454e-05, 0.0, 0.0, -0.0003510097449179739, -0.014255590736865997, -1.1920928244535389e-07, -4.291525328881107e-06, -7.56950321374461e-05, -4.768370445162873e-07, 0.0, -5.960462772236497e-07, -6.651657167822123e-05, -0.23958808183670044, -0.041941