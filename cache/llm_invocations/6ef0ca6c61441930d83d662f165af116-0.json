eappop(heap)\n        if cur_dist != shortest_path_dist[node]:\n            continue\n        for edge_index in adjacency_list[node]:\n            e = all_edges[edge_index]\n            if e.max_capacity == e.current_flow:\n                continue\n            next_node = e.to_node\n            adjusted_weight = e.unit_cost + potential[node] - potential[next_node]\n            new_dist = shortest_path_dist[node] + adjusted_weight\n            if new_dist < shortest_path_dist[next_node]:\n                shortest_path_dist[next_node] = new_dist\n                predecessor_edge[next_node] = edge_index\n                heapq.heappush(heap, (new_dist, next_node))\n\ndef min_cost_max_flow_computation(source, sink):\n    initialize_potentials(source, 50)\n    compute_shortest_paths(source)\n    total_flow = 0\n    total_expense = 0\n    while shortest_path_dist[sink] != LARGE_INF:\n        augment = float('inf')\n        sum_cost = 0\n        cursor = sink\n        while cursor != source:\n            idx = predecessor_edge[cursor]\n            augment = min(augment, all_edges[idx].max_capacity - all_edges[idx].current_flow)\n            sum_cost += all_edges[idx].unit_cost\n            cursor = all_edges[idx].from_node\n        total_flow += augment\n        total_expense += augment * sum_cost\n        cursor = sink\n        while cursor != source:\n            idx = predecessor_edge[cursor]\n            all_edges[idx].current_flow += augment\n            all_edges[idx ^ 1].current_flow -= augment\n            cursor = all_edges[idx].from_node\n        compute_shortest_paths(source)\n        for i in range(MAX_N):\n            potential[i] = shortest_path_dist[i]\n    return (total_expense, total_flow)\n\ndef run_test_case():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c_param = int(next(it))\n    d_param = int(next(it))\n    \n    vertex_demands = [0] * n\n    for _ in range(k):\n        vertex = int(next(it)) - 1\n        vertex_demands[vertex] += 1\n    \n    for i in range(n):\n        insert_bidirectional_edge(5000, i, vertex_demands[i], 0)\n    \n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for layer in range(99):\n            edge_cost = d_param\n            for _ in range(50):\n                insert_bidirectional_edge(u + layer * 50, v + (layer + 1) * 50, 1, edge_cost)\n                insert_bidirectional_edge(v + layer * 50, u + (layer + 1) * 50, 1, edge_cost)\n                edge_cost += 2 * d_param\n    \n    for layer in range(100):\n        insert_bidirectional_edge(0 + layer * 50, 5001, float('inf'), c_param * layer)\n    \n    for i in range(n):\n        for layer in range(99):\n            insert_bidirectional_edge(i + layer * 50, i + (layer + 1) * 50, float('inf'), 0)\n    \n    result = min_cost_max_flow_computation(5000, 5001)\n    assert result[1] == k\n    print(result[0])\n\ndef main():\n    sys.setrecursionlimit(1000000)\n    run_test_case()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014780859055463225, -8.344646857949556e-07, -2.3841855067985307e-07, -0.0002212279650848359, -0.014409767463803291, -1.0728830375228426e-06, -0.043005164712667465, -0.006120272912085056, -0.018181802704930305, -0.04302571713924408, -0.007266994100064039, -3.576278118089249e-07, -3.707340147229843e-05, -0.28610220551490784, -0.4177730083465576, -7.152555099310121e-07, 0.0, 0.0, -5.960462772236497e-07, -3.576278118089249e-07, -1.7762025890988298e-05, -1.0728830375228426e-06, -2.264974000354414e-06, -7.939023635117337e-05, -1.1920922133867862e-06, -1.4781842764932662e-05, -1.1920928244535389e-07, -0.0002728328399825841, 0.0, -9.536738616588991e-07, -0.054989952594041824, 0.0, -5.483612312673358e-06, 0.0, 0.0, -4.768360213347478e-06, 0.0, -1.6927575416048057e-05,