otential + MAX_N, LARGE_INF);\n    potential[source] = 0;\n    for (int iter = 0; iter < num_nodes; ++iter) {\n        for (size_t idx = 0; idx < all_edges.size(); ++idx) {\n            auto& e = all_edges[idx];\n            if (e.max_capacity == e.current_flow) continue;\n            if (potential[e.from_node] == LARGE_INF) continue;\n            potential[e.to_node] = min(potential[e.to_node], potential[e.from_node] + e.unit_cost);\n        }\n    }\n}\n\nvoid compute_shortest_paths(int source) {\n    fill(shortest_path_dist, shortest_path_dist + MAX_N, LARGE_INF);\n    shortest_path_dist[source] = 0;\n    set<pair<i64, int>> ordered_set;\n    ordered_set.insert({0, source});\n    while (!ordered_set.empty()) {\n        auto [cur_dist, node] = *ordered_set.begin();\n        ordered_set.erase(ordered_set.begin());\n        for (int edge_index : adjacency_list[node]) {\n            auto& e = all_edges[edge_index];\n            if (e.max_capacity == e.current_flow) continue;\n            int next_node = e.to_node;\n            i64 adjusted_weight = e.unit_cost + potential[node] - potential[next_node];\n            if (shortest_path_dist[node] + adjusted_weight < shortest_path_dist[next_node]) {\n                ordered_set.erase({shortest_path_dist[next_node], next_node});\n                shortest_path_dist[next_node] = shortest_path_dist[node] + adjusted_weight;\n                predecessor_edge[next_node] = edge_index;\n                ordered_set.insert({shortest_path_dist[next_node], next_node});\n            }\n        }\n    }\n}\n\npair<i64, i64> min_cost_max_flow_computation(int source, int sink) {\n    initialize_potentials(source, 50);\n    compute_shortest_paths(source);\n    i64 total_flow = 0, total_expense = 0;\n    while (shortest_path_dist[sink] != LARGE_INF) {\n        i64 augment = numeric_limits<i64>::max();\n        i64 sum_cost = 0;\n        int cursor = sink;\n        while (cursor != source) {\n            int idx = predecessor_edge[cursor];\n