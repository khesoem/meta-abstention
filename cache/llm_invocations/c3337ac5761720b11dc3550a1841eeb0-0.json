d <= n && to_string(end).find(to_string(start)) == 0) {\n            end++;\n        }\n        cnt += min(end, n + 1) - start;\n        start *= 10;\n    }\n    return cnt;\n}\n\n// Get the lexicographic rank of number x among numbers 1 to n\nll get_lex_rank(ll x) {\n    ll rank = 1;\n    for (ll i = 1; i < x; i++) {\n        if (to_string(i) < to_string(x)) {\n            rank++;\n        }\n    }\n    return rank;\n}\n\n// Calculate sum of (i - a_i) mod 998244353 for i from 1 to n\n// where a_i is the i-th element in lexicographically sorted array of [1..n]\nll solve() {\n    vector<ll> a;\n    for (ll i = 1; i <= n; i++) {\n        a.push_back(i);\n    }\n    \n    // Sort lexicographically\n    sort(a.begin(), a.end(), [](ll x, ll y) {\n        return to_string(x) < to_string(y);\n    });\n    \n    ll sum = 0;\n    for (ll i = 1; i <= n; i++) {\n        ll diff = (i - a[i-1]) % MOD2;\n        if (diff < 0) diff += MOD2;\n        sum = (sum + diff) % MOD;\n    }\n    \n    return sum;\n}\n\nint main() {\n    scanf(\"%lld\", &n);\n    \n    // For small n, use direct simulation\n    if (n <= 10000) {\n        printf(\"%lld\\n\", solve());\n        return 0;\n    }\n    \n    // For larger n, use optimized approach\n    vector<ll> a;\n    for (ll i = 1; i <= min(n, 10000LL); i++) {\n        a.push_back(i);\n    }\n    \n    sort(a.begin(), a.end(), [](ll x, ll y) {\n        return to_string(x) < to_string(y);\n    });\n    \n    ll sum = 0;\n    for (ll i = 1; i <= min(n, 10000LL); i++) {\n        ll diff = (i - a[i-1]) % MOD2;\n        if (diff < 0) diff += MOD2;\n        sum = (sum + diff) % MOD;\n    }\n    \n    // For larger n, we need to handle the rest efficiently\n    // But since n can be up to 10^10, we need a smarter approach\n    // The key insight is to generate numbers in lexicographic order\n    \n    // Let's use a different approach: generate numbers in lexicographic order\n    vector<ll> lex_order;\n    function<void(ll)> generate = [&](ll cur) 