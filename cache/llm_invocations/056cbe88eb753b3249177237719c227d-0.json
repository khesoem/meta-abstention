din.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    \n    ns = \"\"\n    if n == 0:\n        ns = \"0\"\n    else:\n        t = n\n        while t:\n            ns += chr(ord('0') + (t % 10))\n            t //= 10\n        ns = ns[::-1]\n    \n    total = [0]  # Using list to allow modification in nested functions\n    \n    for length in range(1, len(ns) + 1):\n        for diff in range(min(length, len(ns))):\n            cur = \"\"\n            val = 0\n            \n            for i in range(diff):\n                cur += ns[i]\n                val = val * 10 + (ord(ns[i]) - ord('0'))\n            \n            for d in range(10):\n                if diff == 0 and d == 0:\n                    continue\n                if diff < len(ns) and d == ord(ns[diff]) - ord('0'):\n                    continue\n                if length == len(ns) and d > ord(ns[diff]) - ord('0'):\n                    continue\n                \n                new_cur = cur + chr(ord('0') + d)\n                new_val = val * 10 + d\n                \n                base = 0\n                tmp = \"\"\n                \n                for i in range(len(new_cur)):\n                    start = '1' if i == 0 else '0'\n                    for c in range(ord(start), ord(new_cur[i])):\n                        base += count_with(tmp + chr(c), n, ns)\n                    tmp += new_cur[i]\n                base += len(new_cur) - 1\n                \n                vars_list = []\n                tmp = new_cur\n                for i in range(len(new_cur), length):\n                    cnt = count_with(tmp + '0', n, ns) % MOD\n                    vars_list.append(cnt)\n                    tmp += '0'\n                \n                base += 1\n                base -= new_val * p10[length - len(new_cur)]\n                \n                for i in range(len(vars_list)):\n                    vars_list[len(vars_list) - 1 - i] -= p10[i] % MOD\n                \n        