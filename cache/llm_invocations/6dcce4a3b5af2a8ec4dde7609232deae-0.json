act[i - 1] * i % mod;\n        }\n\n        invfact[n] = mod_pow(fact[n], mod - 2, mod);\n        for (int i = n; i >= 1; i--) {\n            invfact[i - 1] = invfact[i] * i % mod;\n        }\n\n        class Combinatorics {\n            long C(int nn, int kk) {\n                if (kk < 0 || kk > nn) return 0;\n                return fact[nn] * invfact[kk] % mod * invfact[nn - kk] % mod;\n            }\n        }\n        Combinatorics combinatorics = new Combinatorics();\n\n        int[] bitcnt = new int[n + 1];\n        int[] msb = new int[n + 1];\n        for (int i = 1; i <= n; i++) {\n            int tmp = i;\n            int cnt = 0;\n            while (tmp != 0) {\n                cnt++;\n                tmp &= tmp - 1;\n            }\n            bitcnt[i] = cnt;\n            if (i > 0) {\n                msb[i] = 1 << (int)(Math.log(i) / Math.log(2));\n            }\n        }\n\n        long[][] dp = new long[n + 1][20];\n        dp[0][0] = 1;\n\n        for (int i = 1; i <= n; i++) {\n            if ((i & n) != i) continue;\n            int pb = msb[i];\n            int rem = i ^ pb;\n            for (int k = rem; ; k = (k - 1) & rem) {\n                int a = k + pb;\n                int b = i ^ a;\n                int lim = Math.min(K - 1, bitcnt[b]);\n                long comb = combinatorics.C(i, a);\n                for (int j = 0; j <= lim; j++) {\n                    dp[i][j + 1] = (dp[i][j + 1] + dp[b][j] * comb) % mod;\n                }\n                if (k == 0) break;\n            }\n        }\n\n        long ans = 0;\n        int top = Math.min(bitcnt[n], K);\n        for (int j = 1; j <= top; j++) {\n            ans = (ans + dp[n][j] * combinatorics.C(K, j) % mod * fact[j]) % mod;\n        }\n        ans = (mod_pow(K, n, mod) - ans + mod) % mod;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012706902634818107, -1.0728830375228426e-06, -4.768370445162873e-07, -