r[i][j] += mod\n\n        res = 0\n        for i in range(n - 2, -1, -1):\n            cnt = n - i\n            pre = n - cnt\n            com = (ncr[n][pre] * fact[pre]) % mod\n            if com == 0:\n                com += mod\n            sum = 0\n\n            for dif in range(1, cnt):\n                for inv in range(dif, n * n + 5):\n                    if dp[cnt - 1][inv] == 0:\n                        break\n                    if inv - dif - 1 < 0:\n                        continue\n                    x = dp[cnt - 2][inv]\n                    y = sums[cnt - 2][inv - dif - 1]\n                    x *= y\n                    x %= mod\n                    if x == 0:\n                        x += mod\n                    sum += x * (cnt - dif)\n                    sum %= mod\n            res += sum * com\n            res %= mod\n            if res == 0:\n                res += mod\n\n        self.out.write(str(res % mod) + \"\\n\")\n\ndef main():\n    out = sys.stdout\n    fs = FastScanner()\n    T = 1\n    for t in range(T):\n        sol1 = Solution(out, fs)\n        sol1.solution(T, t)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011383838864276186, -0.33124059438705444, -0.4107978045940399, -0.18741938471794128, -0.4556369483470917, -0.30443882942199707, -0.5998736619949341, -0.2862456440925598, -0.06332089006900787, -0.058906421065330505, -0.011592879891395569, -0.010244524106383324, -0.0025452144909650087, -0.0006191005813889205, -0.07912690937519073, -0.004279621876776218, -3.814689989667386e-06, -5.304672595229931e-05, -0.0003289635351393372, -0.0001517419150331989, -0.002435576869174838, -0.23068776726722717, -5.2689116273541003e-05, -0.008468195796012878, -2.074220174108632e-05, -0.5315254926681519, -6.23445157543756e-05, -7.510157047363464e-06, -0.00482110446318984, -0.004999042488634586, -0.00018451895448379219, -2.2411095415009186e-05, -0.2731989324092865, -0.0708014