{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 11 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 11 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\nclass InputHandler {\n    private final BufferedReader reader;\n    private String[] tokens;\n    private int tokenIndex;\n\n    public InputHandler() {\n        reader = new BufferedReader(new InputStreamReader(System.in));\n        tokens = new String[0];\n        tokenIndex = 0;\n    }\n\n    private void loadTokens() throws IOException {\n        while (tokenIndex >= tokens.length) {\n            String line = reader.readLine();\n            if (line == null) break;\n            tokens = line.split(\"\\\\s+\");\n            tokenIndex = 0;\n        }\n    }\n\n    public int nextInt() throws IOException {\n        loadTokens();\n        return Integer.parseInt(tokens[tokenIndex++]);\n    }\n\n    public long nextLong() throws IOException {\n        loadTokens();\n        return Long.parseLong(tokens[tokenIndex++]);\n    }\n\n    public double nextDouble() throws IOException {\n        loadTokens();\n        return Double.parseDouble(tokens[tokenIndex++]);\n    }\n\n    public String next() throws IOException {\n        loadTokens();\n        return tokens[tokenIndex++];\n    }\n}\n\npublic class FinalSolution {\n    public static void main(String[] args) throws Exception {\n        InputHandler handler = new InputHandler();\n        int n = handler.nextInt();\n        int budget = handler.nextInt();\n        int[] numbers = new int[n];\n        for (int i = 0; i < n; i++) {\n            numbers[i] = handler.nextInt();\n        }\n\n        int even = 0, odd = 0;\n        List<Integer> qualifyingDifferences = new ArrayList<>();\n\n        for (int i = 0; i < n; i++) {\n            if (i > 0 && even == odd) {\n                qualifyingDifferences.add(Math.abs(numbers[i] - numbers[i - 1]));\n            }\n            if ((numbers[i] % 2) == 0) {\n                even++;\n            } else {\n                odd++;\n            }\n        }\n\n        Collections.sort(qualifyingDifferences);\n        int maxCount = 0;\n        for (int diff : qualifyingDifferences) {\n            if (budget >= diff) {\n                maxCount++;\n                budget -= diff;\n            } else {\n                break;\n            }\n        }\n\n        System.out.println(maxCount);\n    }\n\n    static int gcd(int x, int y) {\n        if (y == 0) return x;\n        return gcd(y, x % y);\n    }\n\n    static int lcm(int x, int y) {\n        return x * (y / gcd(x, y));\n    }\n\n    static int powerMod(int base, int exp, int mod) {\n        if (base == 0) return 0;\n        if (exp == 0) return 1;\n        long res;\n        if ((exp & 1) == 0) {\n            res = powerMod(base, exp >> 1, mod);\n            res = (res * res) % mod;\n        } else {\n            res = base % mod;\n            res = (res * powerMod(base, exp - 1, mod)) % mod;\n        }\n        return (int) ((res + mod) % mod);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n#include <climits>\n#include <cctype>\n#include <string>\n\nclass InputHandler {\nprivate:\n    std::string line;\n    std::vector<std::string> tokens;\n    size_t tokenIndex;\n\npublic:\n    InputHandler() : tokenIndex(0) {}\n\n    void loadTokens() {\n        while (tokenIndex >= tokens.size()) {\n            if (!std::getline(std::cin, line)) {\n                return;\n            }\n            tokens.clear();\n            std::string token;\n            for (char c : line) {\n                if (std::isspace(static_cast<unsigned char>(c))) {\n                    if (!token.empty()) {\n                        tokens.push_back(token);\n                        token.clear();\n                    }\n                } else {\n                    token += c;\n                }\n            }\n            if (!token.empty()) {\n                tokens.push_back(token);\n            }\n            tokenIndex = 0;\n        }\n    }\n\n    int nextInt() {\n        loadTokens();\n        return std::stoi(tokens[tokenIndex++]);\n    }\n\n    long long nextLong() {\n        loadTokens();\n        return std::stoll(tokens[tokenIndex++]);\n    }\n\n    double nextDouble() {\n        loadTokens();\n        return std::stod(tokens[tokenIndex++]);\n    }\n\n    std::string next() {\n        loadTokens();\n        return tokens[tokenIndex++];\n    }\n};\n\nint gcd(int x, int y) {\n    if (y == 0) return x;\n    return gcd(y, x % y);\n}\n\nint lcm(int x, int y) {\n    return x * (y / gcd(x, y));\n}\n\nint powerMod(int base, int exp, int mod) {\n    if (base == 0) return 0;\n    if (exp == 0) return 1;\n    long long res;\n    if ((exp & 1) == 0) {\n        res = powerMod(base, exp >> 1, mod);\n        res = (res * res) % mod;\n    } else {\n        res = base % mod;\n        res = (res * powerMod(base, exp - 1, mod)) % mod;\n    }\n    return static_cast<int>((res + mod) % mod);\n}\n\nint main() {\n    InputHandler handler;\n    int n = handler.nextInt();\n    int budget = handler.nextInt();\n    std::vector<int> numbers(n);\n    for (int i = 0; i < n; i++) {\n        numbers[i] = handler.nextInt();\n    }\n\n    int even = 0, odd = 0;\n    std::vector<int> qualifyingDifferences;\n\n    for (int i = 0; i < n; i++) {\n        if (i > 0 && even == odd) {\n            qualifyingDifferences.push_back(std::abs(numbers[i] - numbers[i - 1]));\n        }\n        if ((numbers[i] % 2) == 0) {\n            even++;\n        } else {\n            odd++;\n        }\n    }\n\n    std::sort(qualifyingDifferences.begin(), qualifyingDifferences.end());\n    int maxCount = 0;\n    for (int diff : qualifyingDifferences) {\n        if (budget >= diff) {\n            maxCount++;\n            budget -= diff;\n        } else {\n            break;\n        }\n    }\n\n    std::cout << maxCount << std::endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00024279984063468874, -7.033323527139146e-06, -1.1920928244535389e-07, -0.0003289635351393372, -3.576278118089249e-07, -1.0013530300057027e-05, -9.536738616588991e-07, -6.198863957251888e-06, -1.311301275563892e-06, -0.0009345216676592827, -4.768370445162873e-07, -3.099436753473128e-06, -4.768370445162873e-07, -0.003360935254022479, -3.576278118089249e-07, -5.8412379075889476e-06, -5.483612312673358e-06, -0.026231007650494576, -0.0005530973430722952, -0.0031791406217962503, -2.145764938177308e-06, -1.1121039390563965, -4.887569048150908e-06, -0.06197366490960121, -0.01815323904156685, -1.311301275563892e-06, -0.3761807680130005, -9.083335316972807e-05, -4.577531944960356e-05, -0.0004885195521637797, -1.9073468138230965e-06, -0.6527504324913025, -0.632623553276062, -0.06211281567811966, -7.033323527139146e-06, -1.0728830375228426e-06, -4.529942543740617e-06, -0.0033908747136592865, -2.3841855067985307e-07, -3.099436753473128e-06, -6.532455881824717e-05, -4.768370445162873e-07, -0.06311073154211044, -0.1661578118801117, -0.00123150786384940