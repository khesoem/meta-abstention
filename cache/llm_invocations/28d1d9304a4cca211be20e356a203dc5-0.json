{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <iomanip>\n#include <cassert>\n#include <climits>\n#include <cstring>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst int T = 99;\nconst int C = 12;\nconst ll INF = 0x3f3f3f3f3f3f3f3fLL;\n\nstruct Edge {\n    int to, rev;\n    ll flow, cap, cost;\n};\n\nstruct MCF {\n    int N;\n    vector<vector<Edge>> g;\n    vector<ll> dist, h;\n    vector<int> prevv, preve;\n\n    MCF(int n) : N(n), g(n), dist(n), h(n), prevv(n), preve(n) {}\n\n    void addEdge(int u, int v, ll c, ll p) {\n        g[u].push_back({v, (int)g[v].size(), 0, c, p});\n        g[v].push_back({u, (int)g[u].size()-1, 0, 0, -p});\n    }\n\n    ll minCostFlow(int s, int t, ll& totalCost) {\n        totalCost = 0;\n        ll flow = 0;\n\n        for (ll lim = 1LL << 30; lim > 0; lim >>= 1) {\n            while (true) {\n                fill(dist.begin(), dist.end(), INF);\n                fill(prevv.begin(), prevv.end(), -1);\n                dist[s] = 0;\n\n                priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n                pq.push({0, s});\n\n                while (!pq.empty()) {\n                    auto [d, u] = pq.top(); pq.pop();\n                    if (d > dist[u]) continue;\n                    for (int i = 0; i < g[u].size(); ++i) {\n                        auto& e = g[u][i];\n                        if (e.cap - e.flow >= lim && dist[e.to] > dist[u] + h[u] - h[e.to] + e.cost) {\n                            dist[e.to] = dist[u] + h[u] - h[e.to] + e.cost;\n                            prevv[e.to] = u;\n                            preve[e.to] = i;\n                            pq.push({dist[e.to], e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] >= INF) break;\n\n                for (int i = 0; i < N; ++i) {\n                    if (dist[i] < INF) h[i] += dist[i];\n                }\n\n                ll df = INF;\n                for (int v = t; v != s; v = prevv[v]) {\n                    df = min(df, g[prevv[v]][preve[v]].cap - g[prevv[v]][preve[v]].flow);\n                }\n\n                for (int v = t; v != s; v = prevv[v]) {\n                    auto& e = g[prevv[v]][preve[v]];\n                    e.flow += df;\n                    g[v][e.rev].flow -= df;\n                    totalCost += df * g[v][e.rev].cost;\n                }\n                flow += df;\n            }\n        }\n        return flow;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int src = 0;\n    int dst = n * T + 1;\n    MCF network(dst + 1);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        network.addEdge(src, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        network.addEdge(1 + t * n, dst, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                network.addEdge(i + (t - 1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            int cost = (j + 1) * (j + 1) - j * j;\n            for (int t = 1; t < T; ++t) {\n                network.addEdge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                network.addEdge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price;\n    ll flow = network.minCostFlow(src, dst, price);\n    assert(flow == k);\n    cout << price << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\nfrom collections import defaultdict\n\nINF = 0x3f3f3f3f3f3f3f3f\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'flow', 'cap', 'cost')\n    def __init__(self, to, rev, flow, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.flow = flow\n        self.cap = cap\n        self.cost = cost\n\nclass MCF:\n    def __init__(self, n):\n        self.N = n\n        self.g = [[] for _ in range(n)]\n        self.dist = [INF] * n\n        self.h = [0] * n\n        self.prevv = [-1] * n\n        self.preve = [-1] * n\n\n    def addEdge(self, u, v, c, p):\n        self.g[u].append(Edge(v, len(self.g[v]), 0, c, p))\n        self.g[v].append(Edge(u, len(self.g[u]) - 1, 0, 0, -p))\n\n    def minCostFlow(self, s, t):\n        totalCost = 0\n        flow = 0\n\n        for lim in (1 << i for i in range(30, -1, -1)):\n            while True:\n                self.dist = [INF] * self.N\n                self.prevv = [-1] * self.N\n                self.preve = [-1] * self.N\n                self.dist[s] = 0\n\n                pq = [(0, s)]\n                while pq:\n                    d, u = heapq.heappop(pq)\n                    if d > self.dist[u]:\n                        continue\n                    for i in range(len(self.g[u])):\n                        e = self.g[u][i]\n                        if e.cap - e.flow >= lim and self.dist[e.to] > self.dist[u] + self.h[u] - self.h[e.to] + e.cost:\n                            self.dist[e.to] = self.dist[u] + self.h[u] - self.h[e.to] + e.cost\n                            self.prevv[e.to] = u\n                            self.preve[e.to] = i\n                            heapq.heappush(pq, (self.dist[e.to], e.to))\n\n                if self.dist[t] >= INF:\n                    break\n\n                for i in range(self.N):\n                    if self.dist[i] < INF:\n                        self.h[i] += self.dist[i]\n\n                df = INF\n                v = t\n                while v != s:\n                    df = min(df, self.g[self.prevv[v]][self.preve[v]].cap - self.g[self.prevv[v]][self.preve[v]].flow)\n                    v = self.prevv[v]\n\n                v = t\n                while v != s:\n                    e = self.g[self.prevv[v]][self.preve[v]]\n                    e.flow += df\n                    self.g[v][e.rev].flow -= df\n                    totalCost += df * self.g[v][e.rev].cost\n                    v = self.prevv[v]\n                flow += df\n\n        return flow, totalCost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n\n    src = 0\n    dst = n * 99 + 1\n    network = MCF(dst + 1)\n\n    for _ in range(k):\n        a = int(data[idx]); idx += 1\n        network.addEdge(src, a, 1, 0)\n\n    for t in range(99):\n        network.addEdge(1 + t * n, dst, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                network.addEdge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(data[idx]); idx += 1\n        b = int(data[idx]); idx += 1\n        for j in range(12):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, 99):\n                network.addEdge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                network.addEdge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    flow, price = network.minCostFlow(src, dst)\n    assert flow == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016509123088326305, -1.0728830375228426e-06, -1.1920928244535389e-07, -4.2199197196168825e-05, -0.42919793725013733, -0.0003864018653985113, -0.014166505075991154, -0.00048137042904272676, -0.12713193893432617, -0.01281985267996788, -0.16482365131378174, -3.576278118089249e-07, -0.004625929053872824, -0.008314518257975578, -0.7345543503761292, -5.757642793469131e-05, -0.023257791996002197, -0.00523553229868412, -8.344646857949556e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841830625315197e-06, -8.344646857949556e-07, -0.0008516260422766209, -0.0036574392579495907, -0.00011336160969221964, -4.768370445162873e-07, -1.1920928244535389e-07, -0.14267560839653015, -4.1483970562694594e-05, -4.6491513785440475e-06, -1.2159273865108844e-05, -0.0010380124440416694, 0.0, -2.3841855067985307e-07, 0.0, -1.1920922133867862e-06, -8.344646857949556e-07, 0.0, -3.814689989667386e-06, -2.264974000354414e-06, 0.0, -2.622600959512056e-06, -1.1920928244535389e-07, 0.0, -9.536738616588991e-07, -6.9141146923357155e-06, -0.00015841660206206143, -3.576278118089249e-07, -1.0728830375228426e-06, -7.152555099310121e-07, -1.1920928244535389e-07, -2.3841830625315197e-06, 0.0, -9.536738616588991e-07, -1.1920922133867862e-06, -7.021180499577895e-05, -1.1920928244535389e-07, -1.2278481335670222e-05, -1.19209282