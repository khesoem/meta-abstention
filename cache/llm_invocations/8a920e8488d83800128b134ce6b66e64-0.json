,y) ((x)*n+(y))\nint main()\n{\n  scanf(\"%d%d%d%d%d\",&n,&m,&k,&C,&D);\n  S=encode(n+k,n)+1;T=S+2;\n  add(encode(0,1),T,INF,0);\n  for (int i=1;i<=k;i++){\n    int p;\n    scanf(\"%d\",&p);\n    add(S,encode(0,p),1,0);\n  }\n  for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&nodes[i*2].from,&nodes[i*2].to);\n    nodes[i*2-1]=(Node){nodes[i*2].to,nodes[i*2].from};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      add(encode(t-1,i),encode(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      add(encode(t-1,nodes[i].from),encode(t,nodes[i].to),1,D);\n      pos[t][i]=ptr;state[t][i]=1;\n    }add(encode(t,1),T,INF,t*C);\n  }\n  int added_flow,total=0;\n  while((added_flow=spfa())!=0){\n    int u=T;\n    while(u!=S){\n      int v=prev[u];\n      ed[edge_idx[u]].cap-=added_flow;\n      ed[edge_idx[u]^1].cap+=added_flow;\n      u=v;\n    }total+=dist_val[T]*added_flow;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (ed[pos[t][i]].cap>0){\n          state[t][i]++;\n          add(encode(t-1,nodes[i].from),encode(t,nodes[i].to),1,D*(state[t][i]*2-1));\n          pos[t][i]=ptr;\n        }\n  }printf(\"%d\\n\",total);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```java\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int nxt, to, cost, cap, rev;\n        Edge(int nxt, int to, int cost, int cap, int rev) {\n            this.nxt = nxt;\n            this.to = to;\n            this.cost = cost;\n            this.cap = cap;\n            this.rev = rev;\n        }\n    }\n\n    static final int INF = 1000000000;\n    static int n, m, k, C, D;\n    static int S, T;\n    static int[] head, prev, edge_idx, flow_val, dist_val;\n    static boolean[] mark;\n    static ArrayList<Edge> edges;\n    static int[][] pos, state;\n    static Node[] nodes;\n    static Queue<Integer> qq;\n\n    static class Node {\n        int from, to;\n        Node(int f, int t) { from = f; to = t; }\n    }\n\n    static int encode(int x, int y) {\n        return x * n + y;\n    }\n\n    static void add(int from, int to, int cap, int cost) {\n        int idx = edges.size();\n        edges.add(new Edge(head[from], to, cost, cap, idx + 1));\n        edges.add(new Edge(head[to], from, -cost, 0, idx));\n        head[from] = idx;\n        head[to] = idx + 1;\n    }\n\n    static int spfa() {\n        Arrays.fill(dist_val, INF);\n        Arrays.fill(flow_val, 0);\n        Arrays.fill(mark, false);\n        flow_val[S] = INF;\n        dist_val[S] = 0;\n        qq.clear();\n        qq.add(S);\n        mark[S] = true;\n        while (!qq.isEmpty()) {\n            int u = qq.poll();\n            mark[u] = false;\n            for (int i = head[u]; i != -1; i = edges.get(i).nxt) {\n                Edge e = edges.get(i);\n                if (e.cap > 0 && dist_val[e.to] > dist_val[u] + e.cost) {\n                    dist_val[e.to] = dist_val[u] + e.cost;\n                    flow_val[e.to] = Math.min(flow_val[u], e.cap);\n                    edge_idx[e.to] = i;\n                    prev[e.to] = u;\n                    if (!mark[e.to]) {\n                        mark[e.to] = true;\n                        qq.add(e.to);\n                    }\n                }\n            }\n        }\n        return flow_val[T];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n\n        int maxTime = Math.max(n + k, 2 * n);\n        T = encode(n + k, n) + 3;\n        S = T - 2;\n\n        head = new int[T + 1];\n        Arrays.fill(head, -1);\n        prev = new int[T + 1];\n        edge_idx = new int[T + 1];\n        flow_val = new int[T + 1];\n        dist_val = new int[T + 1];\n        mark = new boolean[T + 1];\n        edges = new ArrayList<>();\n        edges.add(new Edge(-1, 0, 0, 0, -1)); // dummy at index 0\n\n        pos = new int[maxTime + 1][m + 1];\n        state = new int[maxTime + 1][m + 1];\n\n        nodes = new Node[2 * m + 5];\n        for (int i = 1; i <= m; i++) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            nodes[i * 2] = new Node(a, b);\n            nodes[i * 2 - 1] = new Node(b, a);\n        }\n        m *= 2;\n\n        add(encode(0, 1), T, INF, 0);\n        for (int i = 1; i <= k; i++) {\n            int p = sc.nextInt();\n            add(S, encode(0, p), 1, 0);\n        }\n\n        for (int t = 1; t <= n + k; t++) {\n            for (int i = 1; i <= n; i++) {\n                add(encode(t - 1, i), encode(t, i), INF, 0);\n            }\n            for (int i = 1; i <= m; i++) {\n                int idx = edges.size();\n                add(encode(t - 1, nodes[i].from), encode(t, nodes[i].to), 1, D);\n                pos[t][i] = idx;\n            }\n            add(encode(t, 1), T, INF, t * C);\n        }\n\n        int added_flow, total = 0;\n        while ((added_flow = spfa()) != 0) {\n            int u = T;\n            while (u != S) {\n                int v = prev[u];\n                Edge e = edges.get(edge_idx[u]);\n                e.cap -= added_flow;\n                edges.get(e.rev).cap += added_flow;\n                u = v;\n            }\n            total += dist_val[T] * added_flow;\n            for (int t = 1; t <= n + n; t++) {\n                for (int i = 1; i <= m; i++) {\n                    if (edges.get(pos[t][i]).cap > 0) {\n                        state[t][i]++;\n                        int idx = edges.size();\n                        add(encode(t - 1, nodes[i].from), encode(t, nodes[i].to), 1, D * (state[t][i] * 2 - 1));\n                        pos[t][i] = idx;\n                    }\n                }\n            }\n        }\n        System.out.println(total);\n        sc.close();\n    }\n}\n```", "tok