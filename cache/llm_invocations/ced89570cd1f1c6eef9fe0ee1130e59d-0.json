 dist[v = edges[i].target] > dist[u] + edges[i].cost) {\n                dist[v] = dist[u] + edges[i].cost;\n                flowToNode[v] = min(flowToNode[u], edges[i].cap);\n                lastEdge[v] = i;\n                predecessor[v] = u;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    queueObj.push(v);\n                }\n            }\n        }\n    }\n    return flowToNode[sink];\n}\n\nint n, m, k, C, D, locationPlan[105][105], state[105][105];\nstruct Route {\n    int from, to;\n} routes[105];\n\n#define NODE(x,y) ((x)*n+(y))\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &C, &D);\n    source = NODE(n+k, n) + 1;\n    sink = source + 2;\n\n    addEdge(NODE(0, 1), sink, INF, 0);\n\n    for (int i = 1, port; i <= k; ++i) {\n        scanf(\"%d\", &port);\n        addEdge(source, NODE(0, port), 1, 0);\n    }\n\n    for (int i = 1; i <= m; ++i) {\n        scanf(\"%d%d\", &routes[i*2].from, &routes[i*2].to);\n        routes[i*2-1] = {routes[i*2].to, routes[i*2].from};\n    }\n    m <<= 1;\n\n    for (int day = 1; day <= n+k; ++day) {\n        for (int i = 1; i <= n; ++i)\n            addEdge(NODE(day-1, i), NODE(day, i), INF, 0);\n        for (int i = 1; i <= m; ++i) {\n            addEdge(NODE(day-1, routes[i].from), NODE(day, routes[i].to), 1, D);\n            locationPlan[day][i] = edgeCount;\n            state[day][i] = 1;\n        }\n        addEdge(NODE(day, 1), sink, INF, day * C);\n    }\n\n    int augment, totalCost = 0;\n    while (augment = spfa()) {\n        int node = sink;\n        while (node != source) {\n            int prevNode = predecessor[node];\n            edges[lastEdge[node]].cap -= augment;\n            edges[lastEdge[node] ^ 1].cap += augment;\n            node = prevNode;\n        }\n        totalCost += dist[sink] * augment;\n\n        for (int day = 1; day <= n + n; ++day)\n            for (int i = 1; i <= m; ++i)\n                if (edges[locationPlan[day][i]].cap) {\n     