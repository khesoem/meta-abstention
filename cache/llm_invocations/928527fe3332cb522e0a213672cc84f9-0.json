nvoid Solve()\n{\n    long long x; scanf(\"%lld\", &x);\n    ans = -1;\n    dfs(dfs, get_len(x), x, 0);\n    cout << ans << '\\n';\n}\nint main()\n{\n    pre();\n    Solve();\n    getchar(); getchar();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```java\nimport java.util.Scanner;\n\npublic class Main {\n    static long[] num11 = new long[20];\n    static long[] pow10 = new long[20];\n    static int ans = 0;\n\n    static void pre() {\n        pow10[0] = 1;\n        for (int i = 1; i <= 17; i++) {\n            pow10[i] = pow10[i - 1] * 10;\n        }\n        for (int i = 1; i <= 17; i++) {\n            num11[i] = num11[i - 1] * 10 + 1;\n        }\n    }\n\n    static int get_len(long x) {\n        int res = 0;\n        while (x > 0) {\n            res++;\n            x /= 10;\n        }\n        return res;\n    }\n\n    static void dfs(int pos, long x, int cnt) {\n        if (ans != -1 && cnt >= ans) return;\n        if (x == 0 || pos == 0) {\n            if (ans != -1) ans = Math.min(ans, cnt);\n            else ans = cnt;\n            return;\n        }\n        if (x < 0) x = -x;\n        long t_x = x;\n        int t_cnt = 0;\n        while (t_x >= pow10[pos - 1]) {\n            t_x -= num11[pos];\n            t_cnt += pos;\n        }\n        dfs(pos - 1, t_x, cnt + t_cnt);\n        t_x = num11[pos + 1] - x;\n        t_cnt = 0;\n        while (t_x >= pow10[pos - 1]) {\n            t_x -= num11[pos];\n            t_cnt += pos;\n        }\n        dfs(pos - 1, t_x, cnt + pos + 1 + t_cnt);\n    }\n\n    static void Solve() {\n        Scanner sc = new Scanner(System.in);\n        long x = sc.nextLong();\n        ans = -1;\n        dfs(get_len(x), x, 0);\n        System.out.println(ans);\n        sc.close();\n    }\n\n    public static void main(String[] args) {\n        pre();\n        Solve();\n    }\n}\n```", "token_logprobs": [-1.60931249411