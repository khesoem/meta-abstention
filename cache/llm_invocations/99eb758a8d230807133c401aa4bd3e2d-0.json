;\n            int i = cur[u];\n            while (i != -1) {\n                v = E[i].v;\n                if (d[v] == d[u] + 1 && E[i].cap > 0) {\n                    f = dfs(v, Math.min(in - flow, E[i].cap));\n                    if (f > 0) {\n                        flow += f;\n                        E[i].cap -= f;\n                        E[i ^ 1].cap += f;\n                        if (flow == in) {\n                            cur[u] = i;\n                            break;\n                        }\n                    }\n                }\n                int next = E[i].x;\n                cur[u] = next;\n                i = next;\n            }\n            if (flow < in) d[u] = -1;\n            return flow;\n        }\n\n        int dinic(int _src, int _sink) {\n            src = _src;\n            sink = _sink;\n            int flow = 0;\n            while (bfs()) {\n                flow += dfs(src, INF);\n            }\n            return flow;\n        }\n    }\n\n    static int n, t;\n    static final int N = 15;\n    static char[][] field = new char[N][N];\n    static char[][] capsule = new char[N][N];\n    static int[][] Z = new int[N][N];\n    static int[][] S = new int[N][N];\n    static int[] dx = {-1, 1, 0, 0};\n    static int[] dy = {0, 0, -1, 1};\n    static MaxFlow F = new MaxFlow();\n\n    static boolean isdigit(char ch) {\n        return ch >= '1' && ch <= '9';\n    }\n\n    static boolean In(int i, int j) {\n        return i >= 0 && i < n && j >= 0 && j < n;\n    }\n\n    static void bfs(int x, int y, int[][] d, boolean f) {\n        int sx = x, sy = y;\n        for (int i = 0; i < N; i++) Arrays.fill(d[i], INF);\n        d[x][y] = 0;\n        Queue<Integer> Q = new LinkedList<>();\n        Q.add(x);\n        Q.add(y);\n        if (f && isdigit(capsule[x][y])) {\n            F.add(sx * n + sy, sx * n + sy + n * n, INF);\n        }\n        while (!Q.isEmpty()) {\n            x = Q.poll();\n            y = Q.poll();\n            if (d[x][y] == t) break;\n            for (int o = 0; o < 4; o++) {\n                int xx = x + dx[o];\n                int yy = y + dy[o];\n                if (In(xx, yy) && d[xx][yy] == INF && capsule[xx][yy] != 'Y') {\n                    if (Z[xx][yy] > d[x][y] + 1 || (Z[xx][yy] == d[x][y] + 1 && isdigit(capsule[xx][yy]))) {\n                        d[xx][yy] = d[x][y] + 1;\n                        if (f && isdigit(capsule[xx][yy])) {\n                            F.add(sx * n + sy, xx * n + yy + n * n, INF);\n                        }\n                        if (Z[xx][yy] > d[x][y] + 1 || !f) {\n                            Q.add(xx);\n                            Q.add(yy);\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        t = sc.nextInt();\n        int src = n * n * 2;\n        int sink = src + 1;\n        F.init();\n        int x = 0, y = 0;\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            for (int j = 0; j < n; j++) {\n                field[i][j] = s.charAt(j);\n                if (field[i][j] == 'Z') {\n                    x = i;\n                    y = j;\n                }\n            }\n        }\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            for (int j = 0; j < n; j++) {\n                capsule[i][j] = s.charAt(j);\n                if (isdigit(capsule[i][j])) {\n                    F.add(i * n + j + n * n, sink, capsule[i][j] - '0');\n                }\n            }\n        }\n        bfs(x, y, Z, false);\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (isdigit(field[i][j])) {\n                    F.add(src, i * n + j, field[i][j] - '0');\n                    bfs(i, j, S, true);\n                }\n            }\n        }\n        System.out.print