le)(p[i] * ans));\n\t}\n\n\tprintf(\"\\n\");\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef main():\n    n, k = map(int, input().split())\n    p = [0.0] * 20\n    \n    for i in range(n):\n        x = float(input())\n        p[i] = x\n    \n    # Initialize combination table\n    c = [[0.0] * 21 for _ in range(21)]\n    c[0][0] = 1.0\n    for i in range(1, n + 1):\n        c[i][0] = 1.0\n        for j in range(1, i + 1):\n            c[i][j] = c[i - 1][j - 1] + c[i - 1][j]\n    \n    # Precompute sz and sum for all masks\n    max_mask = 1 << n\n    sz = [0] * max_mask\n    sum_arr = [0.0] * max_mask\n    \n    for i in range(max_mask):\n        sz[i] = 0\n        sum_arr[i] = 0.0\n        for j in range(n):\n            if (i >> j) & 1:\n                sz[i] += 1\n                sum_arr[i] += p[j]\n    \n    # Compute coefficients\n    coef = [0.0] * 21\n    for i in range(k - 1, -1, -1):\n        coef[i] = 1.0 - coef[i]\n        j = 1\n        while i - j >= 0:\n            coef[i - j] += c[n - 1 - i + j][j] * coef[i]\n            j += 1\n    \n    # Calculate and print answers\n    for i in range(n):\n        ans = 0.0\n        if p[i] > 0.005:\n            for msk in range(max_mask):\n                if ((msk >> i) & 1) == 1:\n                    continue\n                if sz[msk] >= k:\n                    continue\n                ans += coef[sz[msk]] / (1.0 - sum_arr[msk])\n        \n        print(\"{:.12f}\".format(p[i] * ans), end=\" \")\n    \n    print()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001212284987559542, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.000164018536452204, -0.31357690691947937, -0.16022562980651855, -0.5234676599502563, -0.001430560601875186, -5.9960475482512265e-05, -1.311301275563892e-06