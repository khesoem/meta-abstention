    for (int i = 0; i < n; i++) {\n            alice[i] = Integer.parseInt(aliceStr[i]);\n        }\n\n        String bobLine = sc.nextLine();\n        String[] bobStr = bobLine.split(\" \");\n        int[] bob = new int[n];\n        for (int i = 0; i < n; i++) {\n            bob[i] = Integer.parseInt(bobStr[i]);\n        }\n\n        // rotate bob left by one: bob[1:] + [bob[0]]\n        int[] bobRotated = new int[n];\n        for (int i = 0; i < n - 1; i++) {\n            bobRotated[i] = bob[i + 1];\n        }\n        bobRotated[n - 1] = bob[0];\n\n        // maxWin = sum of min(alice[i], bobRotated[i])\n        int maxWin = 0;\n        for (int i = 0; i < n; i++) {\n            maxWin += Math.min(alice[i], bobRotated[i]);\n        }\n\n        // find max values\n        int maxBob = 0;\n        for (int b : bobRotated) {\n            if (b > maxBob) maxBob = b;\n        }\n        int maxAlice = 0;\n        for (int a : alice) {\n            if (a > maxAlice) maxAlice = a;\n        }\n\n        // compute minWin: max sum where either element is max\n        int minWin = 0;\n        boolean found = false;\n        for (int i = 0; i < n; i++) {\n            if (bobRotated[i] == maxBob || alice[i] == maxAlice) {\n                int sum = bobRotated[i] + alice[i];\n                if (!found || sum > minWin) {\n                    minWin = sum;\n                    found = true;\n                }\n            }\n        }\n        if (!found) {\n            minWin = 0;\n        }\n\n        // adjust minWin\n        if (minWin > turnNum) {\n            minWin -= turnNum;\n        } else {\n            minWin = 0;\n        }\n\n        System.out.println(minWin + \" \" + maxWin);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-9.536697689327411e-06, 0.0, -1.1920928244535389e-07, -1.6569954823353328e-05, -5.125986263010418e-06, 0.0, -4.768370445162873e-07, -0.0020165364257991314, -0.023253483697772026, -1.0