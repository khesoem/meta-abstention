{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define rep(i,n) for (int i = 0; i < n; i++)\nusing namespace std;\ntypedef long long ll;\ntypedef unsigned long long ull;\ntypedef pair<int, int> pi;\ntypedef pair<pi, pi> pp;\ntypedef pair<ll, ll> pl;\nconst double EPS = 1e-9;\nconst ll MOD = 1000000007;\nconst int inf = 1 << 30;\nconst ll linf = 1LL << 60;\n\nstruct edge{int to, cap, cost, rev; };\n\nstruct MIN_COST_FLOW {\n    int V;\n    vector<edge> G[5010];\n    int h[5010], dist[5010], prevv[5010], preve[5010];\n\n    void init(int n) {\n        V = n;\n    }\n\n    void add_edge(int from, int to, int cap, int cost){\n        G[from].push_back({to, cap, cost, (int)G[to].size()});\n        G[to].push_back({from, 0, -cost, (int)G[from].size()-1});\n    }\n\n    int min_cost_flow(int s, int t, int f){\n        int res = 0;\n        fill(h, h+V, 0);\n        while(f > 0){\n            priority_queue<pi, vector<pi>, greater<pi>> que;\n            fill(dist, dist+V, inf);\n            dist[s] = 0;\n            que.push({0,s});\n            while(!que.empty()){\n                pi p = que.top(); que.pop();\n                int v = p.second;\n                if(dist[v] < p.first) continue;\n                for(int i = 0; i < (int)G[v].size(); i++){\n                    edge &e = G[v][i];\n                    if(e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]){\n                        dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        que.push({dist[e.to], e.to});\n                    }\n                }\n            }\n            if(dist[t] == inf) return -1;\n            for(int v = 0; v < V; v++) h[v] += dist[v];\n            int d = f;\n            for(int v = t; v != s; v = prevv[v])\n                d = min(d, G[prevv[v]][preve[v]].cap);\n            f -= d;\n            res += d * h[t];\n            for(int v = t; v != s; v = prevv[v]){\n                edge &e = G[prevv[v]][preve[v]];\n                e.cap -= d;\n                G[v][e.rev].cap += d;\n            }\n        }\n        return res;\n    }\n};\n\nMIN_COST_FLOW mcf;\n\nint n, m, k, c, d;\nint a[50];\nint cnt[50];\nvector<int> e[50];\n\nconst int T = 100;\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    rep(i,k) scanf(\"%d\", a+i);\n    rep(i,k) cnt[a[i]-1]++;\n    rep(i,m) {\n        int x, y; scanf(\"%d%d\", &x, &y);\n        x--; y--;\n        e[x].push_back(y);\n        e[y].push_back(x);\n    }\n    mcf.init(n*T+2);\n    rep(i,n) mcf.add_edge(n*T, i, cnt[i], 0);\n    rep(i,T) mcf.add_edge(i*n, n*T+1, k, c*i);\n    rep(i,n) {\n        rep(j,T-1) mcf.add_edge(j*n+i, (j+1)*n+i, k, 0);\n        for (int to: e[i]) {\n            rep(j,T-1) {\n                rep(u,k) {\n                    int cost = (u+1)*(u+1)*d-u*u*d;\n                    mcf.add_edge(j*n+i, (j+1)*n+to, 1, cost);\n                }\n            }\n        }\n    }\n    printf(\"%d\\n\", mcf.min_cost_flow(n*T, n*T+1, k));\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass Edge:\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nclass MinCostFlow:\n    def __init__(self):\n        self.V = 0\n        self.G = []\n        self.h = []\n        self.dist = []\n        self.prevv = []\n        self.preve = []\n\n    def init(self, n):\n        self.V = n\n        self.G = [[] for _ in range(n)]\n        self.h = [0] * n\n        self.dist = [0] * n\n        self.prevv = [0] * n\n        self.preve = [0] * n\n\n    def add_edge(self, fro, to, cap, cost):\n        self.G[fro].append(Edge(to, cap, cost, len(self.G[to])))\n        self.G[to].append(Edge(fro, 0, -cost, len(self.G[fro]) - 1))\n\n    def min_cost_flow(self, s, t, f):\n        INF = 1 << 30\n        res = 0\n        self.h = [0] * self.V\n        while f > 0:\n            self.dist = [INF] * self.V\n            self.dist[s] = 0\n            pq = [(0, s)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if self.dist[v] < d:\n                    continue\n                for i, e in enumerate(self.G[v]):\n                    if e.cap > 0 and self.dist[e.to] > self.dist[v] + e.cost + self.h[v] - self.h[e.to]:\n                        self.dist[e.to] = self.dist[v] + e.cost + self.h[v] - self.h[e.to]\n                        self.prevv[e.to] = v\n                        self.preve[e.to] = i\n                        heapq.heappush(pq, (self.dist[e.to], e.to))\n            if self.dist[t] == INF:\n                return -1\n            for v in range(self.V):\n                self.h[v] += self.dist[v]\n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[self.prevv[v]][self.preve[v]].cap)\n                v = self.prevv[v]\n            f -= d\n            res += d * self.h[t]\n            v = t\n            while v != s:\n                e = self.G[self.prevv[v]][self.preve[v]]\n                e.cap -= d\n                self.G[v][e.rev].cap += d\n                v = self.prevv[v]\n        return res\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    a = [next(it) for _ in range(k)]\n    cnt = [0] * 50\n    for i in range(k):\n        cnt[a[i] - 1] += 1\n    e = [[] for _ in range(50)]\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        e[x].append(y)\n        e[y].append(x)\n    T = 100\n    mcf = MinCostFlow()\n    mcf.init(n * T + 2)\n    for i in range(n):\n        mcf.add_edge(n * T, i, cnt[i], 0)\n    for i in range(T):\n        mcf.add_edge(i * n, n * T + 1, k, c * i)\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(j * n + i, (j + 1) * n + i, k, 0)\n        for to in e[i]:\n            for j in range(T - 1):\n                for u in range(k):\n                    cost = (u + 1) * (u + 1) * d - u * u * d\n                    mcf.add_edge(j * n + i, (j + 1) * n + to, 1, cost)\n    ans = mcf.min_cost_flow(n * T, n * T + 1, k)\n    print(ans)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019572250312194228, -1.1920928244535389e-07, -1.4305104514278355e-06, -0.0011917401570826769, -0.008641467429697514, -0.00026127262390218675, -0.01107603870332241, -7.557583012385294e-05, -2.95634672511369e-05, -0.029911132529377937, -0.044063955545425415, -1.3707979917526245, -2.5033637939486653e-05, -1.764281842042692e-05, -0.2536795437335968, -7.510157047363464e-06, -3.576278118089249e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -2.777537883957848e-05, -2.0861407392658293e-05, -0.0007568117580376565, -6.318072337307967e-06, -1.1920928244535389e-07, -2.384185506