     if (src == dst)\n            adj[src].back().rev++;\n        adj[dst].push_back({dst, src, adj[src].size() - 1, 0, 0, -cost});\n    }\n    vector<cost_type> potential;\n    inline cost_type rcost(const edge &e)\n    {\n        return e.cost + potential[e.src] - potential[e.dst];\n    }\n\n//    void bellman_ford(int source)\n//    {\n//        for (int k = 0; k < n; ++k)\n//            for (int u = 0; u < n; ++u)\n//                for (edge &e : adj[u])\n//                    if (e.cap > 0 && rcost(e) < 0)\n//                        potential[e.dst] += rcost(e);\n//    }\n    const cost_type oo = numeric_limits<cost_type>::max();\n    vector<cost_type> dist;\n    vector<edge * > back;\n    cost_type dijkstra(int source, int sink)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> node;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        for (pq.push({dist[source] = 0, source}); !pq.empty();)\n        {\n            node p = pq.top();\n            pq.pop();\n            if (dist[p.second] < p.first)\n                continue;\n            if (p.second == sink)\n                break;\n            for (edge &e : adj[p.second])\n                if (e.flow < e.cap &&\n                        dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({\n                        dist[e.dst] = dist[e.src] + rcost(e),\n                        e.dst\n                    });\n                }\n        }\n        return dist[sink];\n    }\n    pair<flow_type, cost_type> max_flow(int source, int sink)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        back.assign(n, nullptr);\n//        bellman_ford(source); // remove negative costs\n        while (dijkstra(source, sink) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n            if (dist[u] < dist[sink])\n                potential[u] += dist[u] - dist[sink];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (edge * e = back[sink]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (edge * e = back[sink]; e; e = back[e->src])\n                e->flow += f, adj[e->dst][e->rev].flow -= f;\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n\n    int n,m,k,c,d,u,v;\n    cin >> n >> m >> k >> c >> d;\n    min_cost_max_flow<int,int> g((n+2)*102);\n    for(int i=0;i<102;i++)\n        g.add_edge((i*(n+2))+1,i*(n+2),100,(i*c));\n    for(int i=0;i<101;i++)\n        for(int j=0;j<n+1;j++)\n            g.add_edge(j+(i*(n+2)),j+((i+1)*(n+2)),100,0);\n    for(int i=0;i<k;i++)\n    {\n        cin >> u;\n        g.add_edge(n+1,u,1,0);\n    }\n\n    for(int i=0;i<m;i++)\n    {\n        cin >> u >> v;\n        for(int j=0;j<101;j++)\n            for(int f=0;f<k;f++)\n            {\n                g.add_edge(u+(j*(n+2)),v+((j+1)*(n+2)),1,((2*f)+1)*d);\n                g.add_edge(v+(j*(n+2)),u+((j+1)*(n+2)),1,((2*f)+1)*d);\n            }\n    }\n\n    db(g.max_flow(n+1,(101*(n+2))).second)\n\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class Edge {\n        int src, dst, rev;\n        long flow, cap;\n        long cost;\n        Edge(int src, int dst, int rev, long flow, long cap, long cost) {\n            this.src = src;\n            this.dst = dst;\n            this.rev = rev;\n            this.flow = flow;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int n;\n        List<List<Edge>> adj;\n        long[] potential;\n        long[] dist;\n        Edge[] back;\n        final long oo = Long.MAX_VALUE;\n\n        MinCostMaxFlow(int n) {\n            this.n = n;\n            adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                adj.add(new ArrayList<>());\n            }\n            potential = new long[n];\n            dist = new long[n];\n            back = new Edge[n];\n        }\n\n        void addEdge(int src, int dst, long cap, long cost) {\n            adj.get(src).add(new Edge(src, dst, adj.get(dst).size(), 0, cap, cost));\n            if (src == dst) {\n                adj.get(src).get(adj.get(src).size() - 1).rev++;\n            }\n            adj.get(dst).add(new Edge(dst, src, adj.get(src).size() - 1, 0, 0, -cost));\n        }\n\n        long rcost(Edge e) {\n            return e.cost + potential[e.src] - potential[e.dst];\n        }\n\n        long dijkstra(int source, int sink) {\n            Arrays.fill(dist, oo);\n            PriorityQueue<Node> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a.cost));\n            dist[source] = 0;\n            pq.offer(new Node(0, source));\n\n            while (!pq.isEmpty()) {\n                Node node = pq.poll();\n                if (dist[node.vertex] < node.cost) continue;\n                if (node.vertex == sink) break;\n                for (Edge e : adj.get(node.vertex)) {\n                    if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e)) {\n                        back[e.dst] = e;\n                        dist[e.dst] = dist[e.src] + rcost(e);\n                        pq.offer(new Node(dist[e.dst], e.dst));\n                    }\n                }\n            }\n            return dist[sink];\n        }\n\n        long[] maxFlow(int source, int sink) {\n            long flow = 0;\n            long cost = 0;\n\n            for (List<Edge> edges : adj) {\n                for (Edge e : edges) {\n                    e.flow = 0;\n                }\n            }\n\n            Arrays.fill(potential, 0);\n            Arrays.fill(dist, 0);\n            Arrays.fill(back, null);\n\n            while (dijkstra(source, sink) < oo) {\n                for (int u = 0; u < n; u++) {\n                    if (dist[u] < dist[sink]) {\n                        potential[u] += dist[u] - dist[sink];\n                    }\n                }\n\n                long f = Long.MAX_VALUE;\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    f = Math.min(f, e.cap - e.flow);\n                }\n\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    e.flow += f;\n                    adj.get(e.dst).get(e.rev).flow -= f;\n                }\n\n                flow += f;\n                cost += f * (potential[sink] - potential[source]);\n            }\n\n            return new long[]{flow, cost};\n        }\n\n        static class Node {\n            long cost;\n            int vertex;\n            Node(long cost, int vertex) {\n                this.cost = cost;\n                this.vertex = vertex;\n            }\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        MinCostMaxFlow g = new MinCostMaxFlow((n + 2) * 102);\n\n        for (int i = 0; i < 102; i++) {\n            g.addEdge(i * (n + 2) + 1, i * (n + 2), 100, (long) i * c);\n        }\n\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < n + 1; j++) {\n                g.addEdge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0);\n            }\n        }\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int u = Integer.parseInt(st.nextToken());\n            g.addEdge(n + 1, u, 1, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                    g.addEdge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                }\n            }\n        }\n\n        long[] result = g.maxFlow(n + 1, 101 * (n + 2));\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018285033002030104, -1.2636104656849056e-05, -8.344646857949556e-07, -0.0006146925734356046, -5.364274329622276e-05, -0.6326416730880737, -0.5759811997413635, -0.00016616393986623734, -5.507317473529838e-05, -0.00016091958968900144, -0.0005335576133802533, -0.008848622441291809, -2.622600959512056e-06, -0.0007906410028226674, -0.25193989276885986, -0.02055334486067295, -0.020873282104730606, -0.0075787873938679695, -0.07200006395578384, -4.541770613286644e-05, -1.7881377516459906e-06, -0.0006537684239447117, -6.556489552167477e-06, -3.933898824470816e-06, -4.172316494077677e-06, -3.576272320060525e-06, -6.9141146923357155e-06, -3.099436753473128e-06, -0.0006779517862014472, -0.10021132975816727, -9.298280929215252e-06, -1.0013530300057027e-05, -1.2993727978027891e-05, -1.3351351299206726e-05, -0.0006706849089823663, -3.3378546504536644e-06, -1.6689286894688848e-06, -0.20141343772411346, -0.3132708966732025, -0.000274262973107397