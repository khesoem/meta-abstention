{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following PyPy 3 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original PyPy 3 code you have to translate:\n<original_code>\nimport sys\ninput = sys.stdin.readline\n\ndef make_seg_tree(n):\n    size = 1\n    while size < n:\n        size <<= 1\n    return [0] * (size << 1)\n\ndef seg_set(tree, idx, val):\n    pos = idx + len(tree) // 2\n    tree[pos] = val\n    pos >>= 1\n    while pos:\n        tree[pos] = tree[pos << 1] + tree[(pos << 1) + 1]\n        pos >>= 1\n\ndef seg_get(tree, l, r):\n    l += len(tree) // 2\n    r += len(tree) // 2\n    res = 0\n    while l <= r:\n        if l & 1:\n            res += tree[l]\n            l += 1\n        if not (r & 1):\n            res += tree[r]\n            r -= 1\n        l >>= 1\n        r >>= 1\n    return res\n\ndef factorization(n):\n    res = []\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            res.append(d)\n            n //= d\n        d += 1\n    if n > 1:\n        res.append(n)\n    return res\n\ndef phi_func(n):\n    primes = set(factorization(n))\n    val = n\n    for p in primes:\n        val = val // p * (p - 1)\n    return val\n\ndef range_mult(a, b, m):\n    prod = 1\n    for i in range(a + 1, b + 1):\n        prod = (prod * i) % m\n    return prod\n\nn, mod = map(int, input().split())\nphi_mod = phi_func(mod)\narr_len = n + 5\nfacts = [1] * (arr_len + 1)\nfor i in range(1, arr_len + 1):\n    facts[i] = (i * facts[i - 1]) % mod\n\nif n <= 3:\n    print(0)\nelse:\n    dp = [0] * 2000\n    dp[0], dp[1], dp[2], dp[3] = 1, 2, 2, 1\n    seg = make_seg_tree(2005)\n    for i in range(4):\n        seg_set(seg, i, dp[i])\n    max_idx = 3\n    total = 0\n    for step in range(n - 3):\n        old_dp = dp[:]\n        sub_sum = 0\n        for j in range(step + 3):\n            for k in range(1, max_idx + 2):\n                s = seg_get(seg, j + k + 1, 2004)\n                sub_sum = (sub_sum + s * old_dp[k - 1]) % mod\n                dp[j + k] = (dp[j + k] + old_dp[k - 1]) % mod\n                seg_set(seg, j + k, dp[j + k])\n        max_idx += step + 3\n        mult = range_mult(step + 3, n, mod)\n        total = (total + mult * sub_sum) % mod\n    print(total)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <set>\n#include <cmath>\nusing namespace std;\n\nvector<long long> make_seg_tree(int n) {\n    int size = 1;\n    while (size < n) {\n        size <<= 1;\n    }\n    return vector<long long>(size << 1, 0);\n}\n\nvoid seg_set(vector<long long>& tree, int idx, long long val) {\n    int pos = idx + tree.size() / 2;\n    tree[pos] = val;\n    pos >>= 1;\n    while (pos) {\n        tree[pos] = tree[pos << 1] + tree[(pos << 1) + 1];\n        pos >>= 1;\n    }\n}\n\nlong long seg_get(vector<long long>& tree, int l, int r) {\n    l += tree.size() / 2;\n    r += tree.size() / 2;\n    long long res = 0;\n    while (l <= r) {\n        if (l & 1) {\n            res += tree[l];\n            l += 1;\n        }\n        if (!(r & 1)) {\n            res += tree[r];\n            r -= 1;\n        }\n        l >>= 1;\n        r >>= 1;\n    }\n    return res;\n}\n\nvector<int> factorization(int n) {\n    vector<int> res;\n    int d = 2;\n    while (d * d <= n) {\n        while (n % d == 0) {\n            res.push_back(d);\n            n /= d;\n        }\n        d += 1;\n    }\n    if (n > 1) {\n        res.push_back(n);\n    }\n    return res;\n}\n\nlong long phi_func(long long n) {\n    set<int> primes;\n    vector<int> factors = factorization(n);\n    for (int p : factors) {\n        primes.insert(p);\n    }\n    long long val = n;\n    for (int p : primes) {\n        val = val / p * (p - 1);\n    }\n    return val;\n}\n\nlong long range_mult(int a, int b, long long m) {\n    long long prod = 1;\n    for (int i = a + 1; i <= b; i++) {\n        prod = (prod * i) % m;\n    }\n    return prod;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    long long n, mod;\n    cin >> n >> mod;\n    \n    long long phi_mod = phi_func(mod);\n    long long arr_len = n + 5;\n    vector<long long> facts(arr_len + 1, 1);\n    for (long long i = 1; i <= arr_len; i++) {\n        facts[i] = (i * facts[i - 1]) % mod;\n    }\n    \n    if (n <= 3) {\n        cout << 0 << endl;\n    } else {\n        vector<long long> dp(2000, 0);\n        dp[0] = 1;\n        dp[1] = 2;\n        dp[2] = 2;\n        dp[3] = 1;\n        \n        vector<long long> seg = make_seg_tree(2005);\n        for (int i = 0; i < 4; i++) {\n            seg_set(seg, i, dp[i]);\n        }\n        \n        int max_idx = 3;\n        long long total = 0;\n        \n        for (long long step = 0; step < n - 3; step++) {\n            vector<long long> old_dp = dp;\n            long long sub_sum = 0;\n            \n            for (int j = 0; j < step + 3; j++) {\n                for (int k = 1; k <= max_idx + 2; k++) {\n                    long long s = seg_get(seg, j + k + 1, 2004);\n                    sub_sum = (sub_sum + s * old_dp[k - 1]) % mod;\n                    dp[j + k] = (dp[j + k] + old_dp[k - 1]) % mod;\n                    seg_set(seg, j + k, dp[j + k]);\n                }\n            }\n            \n            max_idx += step + 3;\n            long long mult = range_mult(step + 3, n, mod);\n            total = (total + mult * sub_sum) % mod;\n        }\n        \n        cout << total << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-9.405170567333698e-05, -2.50339189733495e-06, -4.768370445162873e-07, -7.354942499659956e-05, -2.3841855067985307e-07, -0.00017629499780014157, -1.9073468138230965e-06, -2.9802276912960224e-06, -8.344646857949556e-07, -1.9192511899746023e-05, -1.1920928244535389e-07, -7.545663538621739e-05, -1.7881377516459906e-06, -0.3830517828464508, -2.9802276912960224e-06, -0.007617000490427017, -2.0265558760002023e-06, -0.20839083194732666, -0.04859766364097595, -0.4287657141685486, -2.8609820219571702e-05, -3.099436753473128e-06, -1.0728830375228426e-06, -0.035090841352939606, -0.1797615885734558, -5.602820692729438e-06, -1.6927575416048057e-05, -0.0006187431863509119, -2.2291887944447808e-05, -1.156323378381785e-05, -0.0036783432587981224, -1.1920928244535389e-07, -4.0531076592742465e-06, 0.0, -1.311301275563892e-06, -8.999896090244874e-05, -5.960462772236497e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.311301275563892e-06, -3.576272320060525e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.6954811548639555e-06, -7.390948667307384e-06, -0.08895155787467957, -1.311301275563892e-06, -5.960462772236497e-07, -0.00014244495832826942, 0.0, 0.0, -9.536738616588991e-07, -2.3841855067985307e-07, -3.099436753473128e-06, -2.7418097943154862e-06, -0.0001408954558428377, -9.179073458653875e-06, -3.576278118089249e-07, -2.861018856492592e-06, -0.038068611174821854, -5.245195097813848e-06, -0.11282319575548172, 0.0, -4.768370445162873e-07, -5.483612312673358e-06, 0.0, -1.1920928244535389e-07, -3.3378546504536644e-06, -6.794906312279636e-06, -2.098061486321967e-05