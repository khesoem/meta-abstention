s[i] != \"at\") {\n                before_at += tokens[i];\n            }\n        }\n        \n        string after_at = \"\";\n        for (int i = at_pos + 1; i < n; i++) {\n            if (tokens[i] == \"dot\") {\n                if (!after_at.empty() && after_at.back() != '.') {\n                    after_at += '.';\n                }\n            } else if (tokens[i] != \"at\") {\n                after_at += tokens[i];\n            }\n        }\n        \n        if (before_at.empty() || before_at.back() == '.' || before_at.front() == '.') continue;\n        if (after_at.empty() || after_at.back() == '.' || after_at.front() == '.') continue;\n        \n        string result = before_at + \"@\" + after_at;\n        \n        bool valid = true;\n        for (char c : result) {\n            if (c != '.' && c != '@' && (c < 'a' || c > 'z')) {\n                valid = false;\n                break;\n            }\n        }\n        if (!valid) continue;\n        \n        int dot_count = 0, at_count = 0;\n        for (char c : result) {\n            if (c == '.') dot_count++;\n            if (c == '@') at_count++;\n        }\n        if (at_count != 1) continue;\n        if (result.front() == '.' || result.back() == '.' || \n            result.front() == '@' || result.back() == '@') continue;\n        \n        if (result.length() < min_len || \n            (result.length() == min_len && result < best)) {\n            min_len = result.length();\n            best = result;\n        }\n    }\n    \n    cout << best << endl;\n    return 0;\n}\n</repaired_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -0.11802184581756592, -3.576278118089249e-07, -1.4305104514278355e-06, -3.3378546504536644e-06, 0.0, 0.0, -2.3841855067985307e-07, -2.658331868587993e-05, 0.0, -4.6491513785440475e-06, -7.152555099310121e-07, -0.018155932426452637, -2.264974000354414e-06, -0.023237178102135658, -3.3378546504536644e-06, -0.10022059828042984, -1.0728