ze(); ++i) {\n                    const Edge &e = g[v][i];\n                    if (e.cap == 0) continue;\n\n                    ll nd = d + e.cost + pot[v] - pot[e.to];\n                    if (dist[e.to] > nd) {\n                        dist[e.to] = nd;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        pq.push({nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int i = 0; i < n; ++i) {\n                if (dist[i] < INF) pot[i] += dist[i];\n            }\n\n            ll add = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                add = min(add, g[prevv[v]][preve[v]].cap);\n            }\n\n            flow += add;\n\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= add;\n                g[v][e.rev].cap += add;\n                total_cost += add * e.cost;\n            }\n        }\n\n        return {flow, total_cost};\n    }\n};\n\nconst int T = 500;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MCMF mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    auto res = mcf.solve(N, N + 1);\n    assert(res.first == k);\n    cout << res.second << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final long INF = 1000000000L;\n    static final int T = 500;\n\n    static class Edge {\n        int to, rev;\n        long cap, cost;\n        Edge(int to, int rev, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MCMF {\n        int n;\n        ArrayList<ArrayList<Edge>> g;\n        long[] pot, dist;\n        int[] prevv, preve;\n\n        MCMF(int n) {\n            this.n = n;\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) g.add(new ArrayList<>());\n            pot = new long[n];\n            dist = new long[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void addEdge(int v, int u, long cap, long cost) {\n            g.get(v).add(new Edge(u, g.get(u).size(), cap, cost));\n            g.get(u).add(new Edge(v, g.get(v).size() - 1, 0, -cost));\n        }\n\n        long[] solve(int s, int t) {\n            long flow = 0, totalCost = 0;\n\n            while (true) {\n                Arrays.fill(dist, INF);\n                Arrays.fill(prevv, -1);\n                Arrays.fill(preve, -1);\n\n                PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n                dist[s] = 0;\n                pq.offer(new long[]{0, s});\n\n                while (!pq.isEmpty()) {\n                    long[] cur = pq.poll();\n                    long d = cur[0];\n                    int v = (int) cur[1];\n                    if (d != dist[v]) continue;\n\n                    for (int i = 0; i < g.get(v).size(); i++) {\n                        Edge e = g.get(v).get(i);\n                        if (e.cap == 0) continue;\n\n                        long nd = d + e.cost + pot[v] - pot[e.to];\n                        if (dist[e.to] > nd) {\n                            dist[e.to] = nd;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.offer(new long[]{nd, e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] == INF) break;\n\n                for (int i = 0; i < n; i++) {\n                    if (dist[i] < INF) pot[i] += dist[i];\n                }\n\n                long add = INF;\n                for (int v = t; v != s; v = prevv[v]) {\n                    add = Math.min(add, g.get(prevv[v]).get(preve[v]).cap);\n                }\n\n                flow += add;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.cap -= add;\n                    g.get(v).get(e.rev).cap += add;\n                    totalCost += add * e.cost;\n                }\n            }\n\n            return new long[]{flow, totalCost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int N = n * T;\n        MCMF mcf = new MCMF(N + 2);\n\n        // waiting edges\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        // sink edges from building 0 at each time\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i, N + 1, INF, 0);\n        }\n\n        // source to initial positions\n        for (int i = 0; i < k; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            mcf.addEdge(N, x * T, 1, 0);\n        }\n\n        // road edges\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j < T - 1; j++) {\n                int cur = 1;\n                for (int z = 0; z < k; z++) {\n                    mcf.addEdge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                    mcf.addEdge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        long[] res = mcf.solve(N, N + 1);\n        if (res[0] != k) {\n            System.err.println(\"Flow mismatch: expected \" + k + \" but got \" + res[0]);\n            System.exit(1);\n        }\n        System.out.println(res[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.974783511599526e-05, -7.152555099310121e-07, -2.3841855067985307e-07, -0.0001591317413840443, -0.0007470439304597676, -1.1920928244535389e-07, -0.25192922353744507, -0.1269398033618927, 0.0, 0.0, -3.576278118089249e-07, -5.578839045483619e-05, -0.0004950728034600616, 0.0, -0.00011181206355104223, -0.011085941456258297, -0.00043096792069263756, -0.000993592431768775, -0.0015034097013995051, -0.014163801446557045, 0.0, -0.00023850933939684182, -4.768258077092469e-05, -0.038046691566705704, -1.4305104514278355e-06, -3.576278118089249e-07, -1.0967194612021558e-05, 0.0, -0.00050317501882091