    node he;\n                he.r = i;\n                he.c = j;\n                he.dis = 0;\n                q.push(he);\n            }\n            else if (s[j] != 'Y')\n            {\n                ok[i][j] = true;\n                d0[i][j] = lim;\n                int k = s[j] - '0';\n                if (k > 0)\n                {\n                    a[i][j] = ++n;\n                    capacity[0][n] = k;\n                    n1 += k;\n                }\n            }\n        }\n    }\n    memcpy(okb, ok, sizeof(ok));\n\n    for (int i = 1; i <= m; ++i)\n    {\n        scanf(\"%s\", s + 1);\n        for (int j = 1; j <= m; ++j)\n        {\n            if (s[j] == 'Z' || s[j] == 'Y')\n                continue;\n            int k = s[j] - '0';\n            if (k > 0)\n            {\n                b[i][j] = ++n;\n                capacity[n][m * m + 1] = k;\n            }\n        }\n    }\n\n    if (n != m * m)\n    {\n        for (int i = 1; i <= m; ++i)\n            for (int j = 1; j <= m; ++j)\n                if (b[i][j] > 0)\n                {\n                    int k = b[i][j];\n                    capacity[k][n + 1] = capacity[k][m * m + 1];\n                    capacity[k][m * m + 1] = 0;\n                }\n    }\n\n    int sink = n + 1;\n\n    while (!q.empty())\n    {\n        node he = q.front();\n        q.pop();\n        int i = he.r, j = he.c;\n        d0[i][j] = he.dis;\n        for (int k = 0; k < 4; ++k)\n        {\n            if (ok[i + dx[k]][j + dy[k]])\n            {\n                node e;\n                e.r = i + dx[k];\n                e.c = j + dy[k];\n                e.dis = he.dis + 1;\n                q.push(e);\n                ok[i + dx[k]][j + dy[k]] = false;\n            }\n        }\n    }\n\n    for (int i = 1; i <= m; ++i)\n    {\n        for (int j = 1; j <= m; ++j)\n        {\n            if (a[i][j] == 0)\n                continue;\n            memcpy(ok, okb, sizeof(okb));\n            ok[i][j] = false;\n            node he;\n            he.r = i;\n            he.c = j;\n            he.dis = 0;\n            q.push(he);\n            while (!q.empty())\n            {\n                node he = q.front();\n                q.pop();\n                int x = he.r, y = he.c;\n                if (b[x][y] > 0 && he.dis <= d0[x][y])\n                    capacity[a[i][j]][b[x][y]] = n1;\n                if (he.dis + 1 > lim || he.dis >= d0[x][y])\n                    continue;\n                for (int k = 0; k < 4; ++k)\n                {\n                    if (ok[x + dx[k]][y + dy[k]])\n                    {\n                        node e;\n                        e.r = x + dx[k];\n                        e.c = y + dy[k];\n                        e.dis = he.dis + 1;\n                        q.push(e);\n                        ok[x + dx[k]][y + dy[k]] = false;\n                    }\n                }\n            }\n        }\n    }\n\n    graph.assign(n + 2, vector<Edge>());\n    for (int u = 0; u <= n + 1; ++u)\n        for (int v = 0; v <= n + 1; ++v)\n            if (capacity[u][v] > 0)\n                addEdge(u, v, capacity[u][v]);\n\n    int maxflow = 0;\n    while (true)\n    {\n        vector<int> parent(n + 2, -1), pedge(n + 2, -1);\n        queue<int> qq;\n        parent[0] = 0;\n        qq.push(0);\n        while (!qq.empty())\n        {\n            int u = qq.front();\n            qq.pop();\n            if (u == sink)\n                break;\n            for (int i = 0; i < (int)graph[u].size(); ++i)\n            {\n                Edge &e = graph[u][i];\n                if (e.cap > 0 && parent[e.to] == -1)\n                {\n                    parent[e.to] = u;\n                    pedge[e.to] = i;\n                    qq.push(e.to);\n                }\n            }\n        }\n        if (parent[sink] == -1)\n            break;\n        int add = 1000000000;\n        for (int v = sink; v != 0; v = parent[v])\n            add = min(add, graph[parent[v]][pedge[v