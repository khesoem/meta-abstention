    if ch == 'Z' or ch == 'Y':\n                continue\n            if ch.isdigit():\n                k = int(ch)\n                if k > 0:\n                    n += 1\n                    b[i][j] = n\n                    capacity[n][m*m + 1] = k\n    \n    # adjust sink if n != m*m\n    if n != m*m:\n        for i in range(1, m+1):\n            for j in range(1, m+1):\n                if b[i][j] > 0:\n                    k = b[i][j]\n                    capacity[k][n+1] = capacity[k][m*m + 1]\n                    capacity[k][m*m + 1] = 0\n    sink = n + 1\n    \n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    \n    # BFS from all Z cells to compute d0\n    while q:\n        r, c, dis = q.popleft()\n        d0[r][c] = dis\n        for k in range(4):\n            nr = r + dx[k]\n            nc = c + dy[k]\n            if 1 <= nr <= m and 1 <= nc <= m and ok[nr][nc]:\n                q.append((nr, nc, dis+1))\n                ok[nr][nc] = False\n    \n    # For each source cell, BFS to set capacities\n    for i in range(1, m+1):\n        for j in range(1, m+1):\n            if a[i][j] == 0:\n                continue\n            # reset ok to okb\n            for x in range(1, m+1):\n                for y in range(1, m+1):\n                    ok[x][y] = okb[x][y]\n            ok[i][j] = False\n            qq = deque()\n            qq.append((i, j, 0))\n            while qq:\n                r, c, dis = qq.popleft()\n                if b[r][c] > 0 and dis <= d0[r][c]:\n                    capacity[a[i][j]][b[r][c]] = n1\n                if dis + 1 > lim or dis >= d0[r][c]:\n                    continue\n                for k in range(4):\n                    nr = r + dx[k]\n                    nc = c + dy[k]\n                    if 1 <= nr <= m and 1 <= nc <= m and ok[nr][nc]:\n                        qq.append((nr, nc, dis+1))\n                        ok[nr][nc] = False\n    \n    # Build graph for max flow\n    graph = [[] for _ in range(n+2)]  # nodes 0..n+1\n    def add_edge(u, v, cap):\n        graph[u].append([v, len(graph[v]), cap])\n        graph[v].append([u, len(graph[u])-1, 0])\n    \n    for u in range(n+2):\n        for v in range(n+2):\n            if capacity[u][v] > 0:\n                add_edge(u, v, capacity[u][v])\n    \n    # Edmonds-Karp max flow\n    maxflow = 0\n    INF = 10**9\n    while True:\n        parent = [-1] * (n+2)\n        pedge = [-1] * (n+2)\n        parent[0] = 0\n        qqq = deque()\n        qqq.append(0)\n        while qqq:\n            u = qqq.popleft()\n            if u == sink:\n                break\n            for i, e in enumerate(graph[u]):\n                if e[2] > 0 and parent[e[0]] == -1:\n                    parent[e[0]] = u\n                    pedge[e[0]] = i\n                    qqq.append(e[0])\n        if parent[sink] == -1:\n            break\n        add = INF\n        v = sink\n        while v != 0:\n            u = parent[v]\n            e = graph[u][pedge[v]]\n            add = min(add, e[2])\n            v = u\n        v = sink\n        while v != 0:\n            u = parent[v]\n            e = graph[u][pedge[v]]\n            e[2] -= add\n            rev = graph[v][e[1]]\n            rev[2] += add\n            v = u\n        maxflow += add\n    \n    print(maxflow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.198863957251888e-06, -1.1920928244535389e-07, -5.125986263010418e-06, -0.0007173825288191438, -0.000947503256611526, 0.0, -5.006777428206988e-06, -1.6927575416048057e-05, 0.0, -1.1920928244535389e-07, -2.861018856492592e-06, -0.00034374051028862596, -0.4556731581687927, -0.5688731670379639, -0.47408396005630493, -2.0265558760002023e-06, -0.27511101961135864, -1.0132738680113107e-05, -0.0003013156820088625, 0.0, -0.018773021176457405, -7.152531907195225e-06, -0.04859164357185364, -0.576586902141571, -0.00015937011630740017, -1.0371154530730564e-05, -0.29271990060806274, -9.53673