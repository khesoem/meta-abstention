    }\n\n    static void floodFill(int r, int c) {\n        Queue<Integer> qr = new LinkedList<>();\n        Queue<Integer> qc = new LinkedList<>();\n        for (int i = 0; i < 12; ++i) Arrays.fill(F[i], -1);\n        qr.add(r);\n        qc.add(c);\n        F[r][c] = 0;\n        while (!qr.isEmpty()) {\n            int rr = qr.poll();\n            int cc = qc.poll();\n            for (int k = 0; k < 4; ++k) {\n                int nr = rr + dr[k];\n                int nc = cc + dc[k];\n                if (A[nr][nc] >= 0 && F[nr][nc] < 0) {\n                    F[nr][nc] = F[rr][cc] + 1;\n                    qr.add(nr);\n                    qc.add(nc);\n                }\n            }\n        }\n    }\n\n    static void linkMonsters(int r, int c, int cnt) {\n        int[][] vis = new int[12][12];\n        Queue<Integer> qr = new LinkedList<>();\n        Queue<Integer> qc = new LinkedList<>();\n        for (int i = 0; i < 12; ++i) Arrays.fill(vis[i], -1);\n        qr.add(r);\n        qc.add(c);\n        vis[r][c] = 0;\n        while (!qr.isEmpty()) {\n            int rr = qr.poll();\n            int cc = qc.poll();\n            int lim = Math.min(T, F[rr][cc]);\n            if (vis[rr][cc] > lim) continue;\n            for (int treasureIdx : treasureAt[rr][cc]) {\n                for (int k = 0; k < cnt; ++k) {\n                    edges[leftCnt + k].add(treasureIdx);\n                }\n            }\n            if (vis[rr][cc] == lim) continue;\n            for (int k = 0; k < 4; ++k) {\n                int nr = rr + dr[k];\n                int nc = cc + dc[k];\n                if (A[nr][nc] >= 0 && vis[nr][nc] < 0) {\n                    vis[nr][nc] = vis[rr][cc] + 1;\n                    qr.add(nr);\n                    qc.add(nc);\n                }\n            }\n        }\n        leftCnt += cnt;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n     