]==-1) return flow;\n\t\tint y=x;x=prex[y];int i=prei[y],j=rev[x][i];\n\t\tint f=dfs(x,min(flow,cap[x][i]));\n\t\tcap[x][i]-=f,cap[y][j]+=f;\n\t\treturn f;\n\t}\n\t\n\tpii solve(int s,int t)\n\t{\n\t\tint ans=0;tot=0;\n\t\twhile(1)\n\t\t{\n\t\t\tspfa(s);\n\t\t\tif(dist[t]>1e9) break;\n\t\t\tint f=dfs(t,inf);\n\t\t\ttot+=f*dist[t];\n\t\t\tans+=f;\n\t\t}\n\t\treturn mp(ans,tot);\n\t}\n\t\n};\n\n\nint n,m,s=nn-1,t=nn-2;\nint k,c,d;\nint get(int x,int tim){\n\treturn tim*52-52+x;\n}\nint main() \n{\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);int kk=k;\n\twhile(k--){\n\t\tint x;scanf(\"%d\",&x);\n\t\tmcmf::add_edge(s,get(x,1),1,0);\n\t}k=kk;\n\twhile(m--){\n\t\tint x,y;scanf(\"%d%d\",&x,&y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t\t\n\t\tswap(x,y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t}\n\tfor(int i=1;i<100;i++){\n\t\tfor(int j=1;j<=n;j++) mcmf::add_edge(get(j,i),get(j,i+1),inf,0);\n\t\tmcmf::add_edge(get(1,i),t,inf,c*(i-1));\n\t}\n\t\n\tprintf(\"%d\",mcmf::solve(s,t).second);\n\t\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 100000000;\n    static final int NN = 6000;\n    \n    static class MCMF {\n        List<List<Integer>> v = new ArrayList<>();\n        List<List<Integer>> rev = new ArrayList<>();\n        List<List<Integer>> cost = new ArrayList<>();\n        List<List<Integer>> cap = new ArrayList<>();\n        \n        MCMF() {\n            for (int i = 0; i < NN; i++) {\n                v.add(new ArrayList<>());\n                rev.add(new ArrayList<>());\n                cost.add(new ArrayList<>());\n                cap.add(new ArrayList<>());\n            }\n        }\n        \n        void addEdge(int x, int y, int c, int w) {\n            rev.get(x).add(v.get(y).size());\n            rev.get(y).add(v.get(x).size());\n            v.get(x).add(y);\n            v.get(y).add(x);\n            cost.get(x).add(w);\n            cost.get(y).add(-w);\n            cap.get(x).add(c);\n            cap.get(y).add(0);\n        }\n        \n        int[] dist = new int[NN];\n        int[] vis = new int[NN];\n        int[] prex = new int[NN];\n        int[] prei = new int[NN];\n        \n        void spfa(int s) {\n            Arrays.fill(dist, 0x3f3f3f3f);\n            Arrays.fill(vis, 0);\n            prex[s] = -1;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            dist[s] = 0;\n            vis[s] = 1;\n            \n            while (!q.isEmpty()) {\n                int x = q.poll();\n                vis[x] = 0;\n                for (int i = 0; i < v.get(x).size(); i++) {\n                    int y = v.get(x).get(i);\n                    int cc = dist[x] + cost.get(x).get(i);\n                    if (dist[y] > cc && cap.get(x).get(i) > 0) {\n                        dist[y] = cc;\n                        prex[y] = x;\n                        prei[y] = i;\n                        if (vis[y] == 0) {\n                            vis[y] = 1;\n                            q.offer(y);\n                        }\n                    }\n                }\n            }\n        }\n        \n        int tot = 0;\n        \n        int dfs(int x, int flow) {\n            if (prex[x] == -1) return flow;\n            int y = x;\n            x = prex[y];\n            int i = prei[y];\n            int j = rev.get(x).get(i);\n            int f = dfs(x, Math.min(flow, cap.get(x).get(i)));\n            cap.get(x).set(i, cap.get(x).get(i) - f);\n            cap.get(y).set(j, cap.get(y).get(j) + f);\n            return f;\n        }\n        \n        int[] solve(int s, int t) {\n            int ans = 0;\n            tot = 0;\n            while (true) {\n                spfa(s);\n                if (dist[t] > 1e9) break;\n                int f = dfs(t, INF);\n                tot += f * dist[t];\n                ans += f;\n            }\n            return new int[]{ans, tot};\n        }\n    }\n    \n    static int n, m, s, t;\n    static int k, c, d;\n    \n    static int get(int x, int tim) {\n        return tim * 52 - 52 + x;\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        k = scanner.nextInt();\n        c = scanner.nextInt();\n        d = scanner.nextInt();\n        int kk = k;\n        \n        MCMF mcmf = new MCMF();\n        s = NN - 1;\n        t = NN - 2;\n        \n        while (k-- > 0) {\n            int x = scanner.nextInt();\n            mcmf.addEdge(s, get(x, 1), 1, 0);\n        }\n        k = kk;\n        \n        while (m-- > 0) {\n            int x = scanner.nextInt();\n            int y = scanner.nextInt();\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    mcmf.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n            \n            int temp = x;\n            x = y;\n            y = temp;\n            \n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    mcmf.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n        }\n        \n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= n; j++) {\n                mcmf.addEdge(get(j, i), get(j, i + 1), INF, 0);\n            }\n            mcmf.addEdge(get(1, i), t, INF, c * (i - 1));\n        }\n        \n        int[] result = mcmf.solve(s, t);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001760566228767857, -3.3378546504536644