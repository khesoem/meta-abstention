atch(int a, int b) {\n        if (a == b) return 0;\n        if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n        return -1;\n    }\n\n    public static long give(List<int[]> l1, List<int[]> l2) {\n        long ans = 0;\n        int curr1Val = 0, curr1Type = 0;\n        int curr2Val = 0, curr2Type = 0;\n        \n        int p1 = l1.size() - 1;\n        int p2 = l2.size() - 1;\n\n        while (p1 >= 0 || p2 >= 0) {\n            if (curr1Val == 0 && p1 >= 0) {\n                int[] item = l1.get(p1--);\n                curr1Val = item[0];\n                curr1Type = item[1];\n            }\n            if (curr2Val == 0 && p2 >= 0) {\n                int[] item = l2.get(p2--);\n                curr2Val = item[0];\n                curr2Type = item[1];\n            }\n\n            if (curr1Val == 0 || curr2Val == 0) break;\n\n            int common = Math.min(curr1Val, curr2Val);\n            ans += (long) Math.max(0, common * match(curr1Type, curr2Type));\n\n            curr1Val -= common;\n            curr2Val -= common;\n\n            if (curr1Val == 0) curr1Type = 0;\n            if (curr2Val == 0) curr2Type = 0;\n        }\n        return ans;\n    }\n\n    public static long minimum(int n, int r1, int s1, int p1, int r2, int s2, int p2) {\n        int[][] base1 = {{r1, 1}, {s1, 2}, {p1, 3}};\n        int[][] base2 = {{r2, 1}, {s2, 2}, {p2, 3}};\n        \n        List<int[]> perms1 = new ArrayList<>();\n        List<int[]> perms2 = new ArrayList<>();\n        \n        generatePermutations(base1, 0, perms1);\n        generatePermutations(base2, 0, perms2);\n\n        long minAns = Long.MAX_VALUE;\n        \n        // The original code uses permutations of the lists of [value, type] pairs\n        // and then pops from the end of those lists.\n        // Since the original code does `l1 = [list(i) for i in list(permutations(l))]`,\n        // it creates 6 possible orderings of the 3 types.\n        \n        List<List<int[]>>