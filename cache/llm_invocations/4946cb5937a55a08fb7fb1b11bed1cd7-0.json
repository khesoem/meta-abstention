[i] = new Pair(0, 0);\n            }\n            for (int i = 0; i <= N + 1; i++) {\n                for (int j = 0; j <= N; j++) {\n                    d[i][j] = new Pair(0, 0);\n                }\n            }\n        }\n\n        long pw(long x, long y) {\n            long res = 1;\n            while (y > 0) {\n                if ((y & 1) == 1) {\n                    res = (res * x) % mod;\n                }\n                x = (x * x) % mod;\n                y >>= 1;\n            }\n            return res;\n        }\n\n        long inv(long x) {\n            return pw(x, mod - 2);\n        }\n\n        long ss(int x) {\n            return (long) x * (x + 1) / 2;\n        }\n\n        void solve() {\n            for (int i = 0; i <= n; i++) {\n                for (int j = 0; j <= n; j++) {\n                    if (i == 0 || j == 0) {\n                        c[i][j] = 1;\n                        continue;\n                    }\n                    c[i][j] = (c[i - 1][j] + c[i][j - 1]) % mod;\n                }\n            }\n\n            for (int i = 0; i <= N; i++) {\n                a[i] = new Pair(0, 0);\n            }\n            a[0] = new Pair(1, 0);\n            for (int i = 1; i <= m; i++) {\n                for (int j = 0; j < i; j++) {\n                    Pair cur = new Pair(0, 0);\n                    cur.first = (a[j].first * a[i - 1 - j].first) % mod;\n                    cur.second = (a[j].second * a[i - 1 - j].first + a[j].first * a[i - 1 - j].second) % mod;\n                    cur.second = (cur.second * (i + 1) + (ss(j) + ss(i - 1 - j)) * cur.first) % mod;\n                    cur.first = (cur.first * (i + 1)) % mod;\n                    cur.first = (cur.first * c[j][i - 1 - j]) % mod;\n                    cur.second = (cur.second * c[j][i - 1 - j]) % mod;\n                    a[i].first = (a[i].first + cur.first) % mod;\n                    a[i].second = (a[i].second + cur.second) % mod;\n                }\n            }\n\n           