++;\n}\nbool find_path(int s, int t)\n{\n    queue<int> q;\n    for(int i = 0; i < node_num; i++)\n    {\n        dist[i] = INF;\n        in_queue[i] = false;\n        prev[i] = -1;\n    }\n    dist[s] = 0;\n    in_queue[s] = true;\n    q.push(s);\n    while(!q.empty())\n    {\n        int u = q.front();\n        q.pop();\n        in_queue[u] = false;\n        for(int i = head[u]; i != -1; i = edge[i].next)\n        {\n            int v = edge[i].to;\n            if(edge[i].cap > edge[i].flow && dist[v] > dist[u] + edge[i].cost)\n            {\n                dist[v] = dist[u] + edge[i].cost;\n                prev[v] = i;\n                if(!in_queue[v])\n                {\n                    in_queue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return prev[t] != -1;\n}\nint min_cost_max_flow(int s, int t, int &cost)\n{\n    int flow = 0;\n    cost = 0;\n    while(find_path(s,t))\n    {\n        int Min = INF;\n        for(int i = prev[t]; i != -1; i = prev[edge[i^1].to])\n        {\n            if(Min > edge[i].cap - edge[i].flow)\n                Min = edge[i].cap - edge[i].flow;\n        }\n        for(int i = prev[t]; i != -1; i = prev[edge[i^1].to])\n        {\n            edge[i].flow += Min;\n            edge[i^1].flow -= Min;\n            cost += edge[i].cost * Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\nint get_id(int x, int y){\n    return (x-1)*50 + y;\n}\nint main(){\n    int src = 101*55, snk = src + 1;\n    N = fast_read(), M = fast_read(), K = fast_read(), C = fast_read(), D = fast_read();\n    int tmp;\n    init_graph(snk+1);\n    for(int i = 1; i <= K; i++){\n        tmp = fast_read();\n        add_edge(src, tmp, 1, 0);\n    }\n    for(int i = 1; i <= 50; i++){\n        for(int j = 1; j <= 103; j++){\n            int x = get_id(j, i);\n            int y = get_id(j+1, i);\n            add_edge(x, y, INF, C);\n        }\n    }\n    for(int i = 0; i < 102; i++){\n        int tmp = i*50 + 1;\n        add_edge(tmp, snk, INF, 0);\n    }\n    for(int i = 1; i <= M; i++){\n        int u, v;\n        u = fast_read(), v = fast_read();\n        for(int j = 1; j <= 102; j++){\n            int x = get_id(j, u), x1 = get_id(j+1, u);\n            int y1 = get_id(j+1, v), y = get_id(j, v);\n            for(int k = 0; k < 50; k++){\n                int val = D*(k*2+1) + C;\n                add_edge(x, y1, 1, val);\n                add_edge(y, x1, 1, val);\n            }\n        }\n    }\n    int cost = 0;\n    min_cost_max_flow(src, snk, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_edge(graph, fr, to, cap, cost):\n    graph[fr].append(Edge(to, len(graph[to]), cap, cost))\n    graph[to].append(Edge(fr, len(graph[fr]) - 1, 0, -cost))\n\ndef min_cost_max_flow(graph, s, t):\n    n = len(graph)\n    flow = 0\n    cost = 0\n    prevv = [0] * n\n    preve = [0] * n\n    dist = [0] * n\n    inq = [False] * n\n    while True:\n        for i in range(n):\n            dist[i] = INF\n            inq[i] = False\n        dist[s] = 0\n        q = deque([s])\n        inq[s] = True\n        while q:\n            v = q.popleft()\n            inq[v] = False\n            for i, e in enumerate(graph[v]):\n                if e.cap > 0 and dist[e.to] > dist[v] + e.cost:\n                    dist[e.to] = dist[v] + e.cost\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n        if dist[t] =