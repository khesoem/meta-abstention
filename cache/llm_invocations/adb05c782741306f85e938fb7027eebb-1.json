    return Vec.eq(self.x, other.x) and Vec.eq(self.y, other.y)\n    \n    def __hash__(self):\n        # Use rounded values for hashing to handle floating point precision\n        return hash((round(self.x / Vec.EPS), round(self.y / Vec.EPS)))\n\nclass Circle:\n    def __init__(self, c, r):\n        self.c = c\n        self.r = r\n    \n    def contains(self, v):\n        return self.c.sub(v).mag2() - Vec.EPS * Vec.EPS <= self.r * self.r\n    \n    def intersect(self, o):\n        if self.c == o.c:\n            return None\n        \n        dir_vec = o.c.sub(self.c)\n        d2 = dir_vec.mag2()\n        d = math.sqrt(d2)\n        \n        if self.r + o.r < d or self.r + d < o.r or o.r + d < self.r:\n            return None\n        \n        if Vec.eq(self.r + o.r, d) or Vec.eq(o.r + d, self.r):\n            return [self.c.add(dir_vec.scale(self.r / d))]\n        \n        if Vec.eq(self.r + d, o.r):\n            return [self.c.sub(dir_vec.scale(self.r / d))]\n        \n        d1 = (self.r * self.r + d2 - o.r * o.r) / (2 * d)\n        h = math.sqrt(max(0, self.r * self.r - d1 * d1))\n        unit_dir = dir_vec.unit()\n        \n        rInt = self.c.add(unit_dir.scale(d1).add(unit_dir.rot270().scale(h)))\n        lInt = self.c.add(unit_dir.scale(d1).add(unit_dir.rot90().scale(h)))\n        \n        return [rInt, lInt]\n\nclass UnionFind:\n    def __init__(self, n):\n        self.parent = list(range(n))\n    \n    def find(self, a):\n        if self.parent[a] != a:\n            self.parent[a] = self.find(self.parent[a])\n        return self.parent[a]\n    \n    def union(self, a, b):\n        root_a = self.find(a)\n        root_b = self.find(b)\n        if root_a != root_b:\n            self.parent[root_a] = root_b\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n = int(input_data[0])\n    circles = []\n    index = 1\n    for i in range(n):\n        x = int(input_data[index])\n        y = int(input_data[index + 1])\n        r = int(input_data[index + 2])\n        index += 3\n        circles.append(Circle(Vec(x, y), r))\n    \n    points = []\n    uf = UnionFind(n)\n    res = 1\n    \n    for i in range(n):\n        points2 = []\n        for j in range(n):\n            if i == j:\n                continue\n            arr = circles[i].intersect(circles[j])\n            if arr is None:\n                continue\n            \n            # Union find operations\n            root_i = uf.find(i)\n            root_j = uf.find(j)\n            uf.parent[root_i] = root_j\n            \n            # Add intersection points\n            for e in arr:\n                found = False\n                for e2 in points2:\n                    if e == e2:\n                        found = True\n                        break\n                if not found:\n                    points2.append(e)\n        \n        res += len(points2)\n        \n        # Add to global points list\n        for e in points2:\n            found = False\n            for e2 in points:\n                if e == e2:\n                    found = True\n                    break\n            if not found:\n                points.append(e)\n    \n    res -= len(points)\n    \n    # Count connected components\n    components = 0\n    for i in range(n):\n        if uf.find(i) == i:\n            components += 1\n    \n    res += components\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010442188795423135, -1.1920922133867862e-06, -3.576272320060525e-06, -0.00010108436981681734, -0.007825076580047607, -3.3378546504536644e-06, -0.012511219829320908, -0.0003493413969408721, -0.0619942806661129, -0.523135781288147, -0.27982157468795776, -2.0265558760002023e-06, -0.11994035542011261, -0.026500260457396507, -0.03845251351594925, -0.0003053675754927099, -3.099436753473128e-06, -3.4570634852570947e-06, -9.179073458653875e-06, -7.1