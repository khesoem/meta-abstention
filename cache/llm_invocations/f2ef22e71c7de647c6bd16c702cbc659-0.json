rt '@' instead of 'at'\n        // Since we didn't replace any 'at', we need to find a valid split\n        \n        // Find the first occurrence of 'at' in the original string that we can use\n        int pos = 0;\n        string result;\n        bool placedAt = false;\n        \n        for (int i = 0; i < s.length(); i++) {\n            if (!placedAt && i + 1 < s.length() && s[i] == 'a' && s[i+1] == 't') {\n                result += '@';\n                placedAt = true;\n                i++; // skip 't'\n            } else if (i + 2 < s.length() && s[i] == 'd' && s[i+1] == 'o' && s[i+2] == 't') {\n                result += '.';\n                i += 2;\n            } else {\n                result += s[i];\n            }\n        }\n        \n        // Check if this result is valid\n        if (!result.empty() && result[0] != '.' && result[0] != '@' && \n            result[result.length()-1] != '.' && result[result.length()-1] != '@' &&\n            count(result.begin(), result.end(), '@') == 1) {\n            t = result;\n        }\n    }\n    \n    // If still invalid, try other approaches - but the main issue is that we need to handle\n    // cases where 'at' appears multiple times and we should only replace the first one\n    \n    // Check validity\n    bool valid = true;\n    if (t.empty() || t[0] == '.' || t[0] == '@' || \n        t[t.length()-1] == '.' || t[t.length()-1] == '@') {\n        valid = false;\n    }\n    \n    int atCountFinal = 0;\n    for (char c : t) {\n        if (c == '@') atCountFinal++;\n    }\n    if (atCountFinal != 1) valid = false;\n    \n    if (!valid) {\n        // Try to construct a valid email by finding the right positions\n        // We need exactly one '@' and any number of '.' (but not at start/end)\n        \n        // Find first 'at' to replace with '@'\n        int atPos = -1;\n        for (int i = 0; i < s.length() - 1; i++) {\n            if (s[i] == 'a' && s[i+1] == 't') {\n                atPos = i;\n            