 freopen(\"out.out\", \"w\", stdout);\n#endif // ONLINE_JUDGE\n\n\tscanf(\"%d\",&n);\n    int r100 = power(100, mod-2, mod);\n    for(int i=0; i<n; i++) {\n        for(int j=0; j<n; j++) {\n            scanf(\"%d\", p[i]+j);\n            p[i][j] = (INT)p[i][j] * r100 % mod;\n        }\n    }\n    for(int i=0; i<n; i++) {\n        for(int j=0; j<1<<n; j++) {\n            pro[i][j] = 1;\n            for(int k=0; k<n; k++) if((j>>k)&1) {\n                pro[i][j] = (INT)pro[i][j] * p[i][k] % mod;\n            } else pro[i][j] = (INT)pro[i][j] * (mod+1-p[i][k]) % mod;\n        }\n    }\n\n    for(int i=0; i<1<<n; i++) bpt[i] = __builtin_popcount(i);\n    for(int i=0; i<1<<n; i++) vec[bpt[i]].pb(i), id[i] = vec[bpt[i]].size() - 1;\n\tfor(int i=0; i<1<<n; i++) {\n        for(int j=0; j<n; j++) if(not ((i>>j)&1)) q[i][1<<j] = 1LL<<id[i|(1<<j)];\n        for(int j=0; j<1<<n; j++) q[i][j] = q[i][j&-j] | q[i][j ^ (j&-j)];\n\t}\n\tcout << calc(0, 1) << endl;\n}\n\n                      \n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nfrom collections import defaultdict\n\ndef power(a, n, mod, ans=1):\n    while n:\n        if n & 1:\n            ans = ans * a % mod\n        a = a * a % mod\n        n >>= 1\n    return ans\n\ndef add(u, v):\n    u += v\n    if u >= mod:\n        u -= mod\n    return u\n\nsys.setrecursionlimit(10**7)\n\n# Read input\nn = int(sys.stdin.readline())\n\nmod = int(1e9 + 7)\nr100 = power(100, mod - 2, mod)\n\np = []\nfor _ in range(n):\n    row = list(map(int, sys.stdin.readline().split()))\n    row = [val * r100 % mod for val in row]\n    p.append(row)\n\n# Precompute pro\npro = [[1 for _ in range(1 << n)] for _ in range(n)]\nfor i in range(n):\n    for j in range(1 << n):\n        prod = 1\n        for k in range(n):\n            if (j & (1 << k)):\n                prod = (prod * p[i][k]) % mod\n            else:\n                prod = (prod * ((mod + 1 - p[i][k]) % mod)) % mod\n        pro[i][j] = prod\n\n# Prepare for subset enumeration\nbpt = [bin(i).count('1') for i in range(1 << n)]\nvec = [[] for _ in range(n + 1)]\nid_map = [0] * (1 << n)\n\nfor i in range(1 << n):\n    count_bits = bpt[i]\n    vec[count_bits].append(i)\n\nfor i in range(1 << n):\n    count_bits = bpt[i]\n    id_map[i] = len(vec[count_bits]) - 1\n\n# Initialize q\nq = [[0 for _ in range(1 << n)] for _ in range(1 << n)]\nfor i in range(1 << n):\n    for j in range(n):\n        if not ((i >> j) & 1):\n            q[i][1 << j] = 1 << id_map[i | (1 << j)]\n    for j in range(1 << n):\n        q[i][j] = q[i][j & -j] | q[i][j ^ (j & -j)]\n\n# Memoization dictionary\nmp = {}\n\ndef calc(now, st):\n    if st == 0:\n        return 0\n    if now == n:\n        return 1\n    key = (now, st)\n    if key in mp:\n        return mp[key]\n    ans = 0\n    j = 1\n    while j < (1 << n):\n        nst = 0\n        for k in range(n):\n            if (st & (1 << k)):\n                cur = vec[now][k]\n                nxt = j - (j & cur)\n                nst |= q[cur][nxt]\n        ans = add(ans, pro[now][j] * calc(now + 1, nst) % mod)\n        j <<= 1\n    mp[key] = ans\n    return ans\n\nprint(calc(0, 1))\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0002003218833124265, -0.0005087109748274088, 0.0, -1.3663626305060461e-05, -0.2975379526615143, -0.0006339243846014142, -0.01251282636076212, -0.24226537346839905, -0.0016692342469468713, -0.12693166732788086, -0.07724575698375702, -0.05227048322558403, 0.0, -0.00035250463406555355, -0.003317449940368533, -0.044262588024139404, -0.01873158849775791, -1.0445127372804563e-05, -0.014177266508340836, -9.088346359931165e-07, -1.6240566083070007e-06, -0.005498649552464485, -0.0027436506934463978, -1.8624639324116288e-06, -4.4849443838757e-06, -5.512236498361744e-07, -2.0100624169572257e-05, -3.128163257315464e-07, -0.0048349881544709206, 0.0, -0