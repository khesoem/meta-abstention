n    return result;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    vector<string> data;\n    string current = \"\";\n    for (char c : line) {\n        if (c == ' ') {\n            if (!current.empty()) {\n                data.push_back(current);\n                current = \"\";\n            }\n        } else {\n            current += c;\n        }\n    }\n    if (!current.empty()) {\n        data.push_back(current);\n    }\n    \n    long long p = stoll(data[0]);\n    long long k = stoll(data[1]);\n    long long MOD = 1000000007LL;\n    \n    if (k == 0) {\n        cout << modPow(p, p - 1, MOD) << endl;\n    } else if (k == 1) {\n        cout << modPow(p, p, MOD) << endl;\n    } else {\n        long long x = 1;\n        long long i = 0;\n        for (long long idx = 1; idx <= p; idx++) {\n            x = (x * k) % p;\n            if (x == 1) {\n                i = idx;\n                break;\n            }\n        }\n        long long exponent = (p - 1) / i;\n        cout << modPow(p, exponent, MOD) << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016973962192423642, -1.8000440832111053e-05, -2.3841855067985307e-07, -8.129743218887597e-05, -3.576278118089249e-07, -1.4066597032069694e-05, -1.1920922133867862e-06, -1.9073468138230965e-06, -5.960462772236497e-07, -0.022208791226148605, -2.825220326485578e-05, -0.0008045773720368743, -1.6689286894688848e-06, -0.12130066752433777, -0.011048685759305954, -0.1128414124250412, -5.8412379075889476e-06, -0.5426508188247681, -0.31326383352279663, -0.04308772087097168, -1.2278481335670222e-05, -4.172316494077677e-06, -8.344646857949556e-07, -0.00031025364296510816, -7.152555099310121e-07, -0.02880515716969967, -0.07817307859659195, -2.5510462364763953e-05, -2.3841855067985307e-07, -8.344646857949556e-07, 0.0, -4.768370445162873e-07, -4.768370445162873e-07, -0.06198957562446594, 0.0, -1.7881377516459906e-06, -2.3841855067985307e-07, -0