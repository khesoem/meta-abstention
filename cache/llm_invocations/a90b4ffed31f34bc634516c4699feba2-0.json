oef[i + j];\n        }\n        coef[i] = val;\n    }\n\n    for (int idx = 0; idx < n; ++idx) {\n        long double total = 0.0L;\n        if (p[idx] > 0.005) {\n            for (int mask = 0; mask < M; ++mask) {\n                if (mask & (1 << idx)) continue;\n                if (bits[mask] >= k) continue;\n                total += coef[bits[mask]] / (1.0L - sums[mask]);\n            }\n        }\n        printf(\"%.12lf \", (double)(p[idx] * total));\n    }\n    printf(\"\\n\");\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k = int(data[1])\n    index = 2\n    \n    p = [float(data[i]) for i in range(index, index + n)]\n    index += n\n\n    # Build binomial coefficients C[i][j]\n    C = [[0] * (n + 1) for _ in range(n + 1)]\n    for i in range(n + 1):\n        C[i][0] = 1\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            C[i][j] = C[i - 1][j - 1] + C[i - 1][j]\n\n    M = 1 << n\n    bits = [0] * M\n    sums = [0.0] * M\n\n    for mask in range(M):\n        for j in range(n):\n            if (mask >> j) & 1:\n                bits[mask] += 1\n                sums[mask] += p[j]\n\n    coef = [0.0] * k\n    coef[k - 1] = 1.0\n    for i in range(k - 2, -1, -1):\n        val = 1.0\n        for j in range(1, k - i):\n            val -= C[n - 1 - i][j] * coef[i + j]\n        coef[i] = val\n\n    results = []\n    for idx in range(n):\n        total = 0.0\n        if p[idx] > 0.005:\n            for mask in range(M):\n                if mask & (1 << idx):\n                    continue\n                if bits[mask] >= k:\n                    continue\n                denom = 1.0 - sums[mask]\n                if denom > 0:\n                    total += coef[bits[mask]] / denom\n  