        return br.readLine().trim().toCharArray();\n    }\n\n    static int[] li3() throws IOException {\n        String s = br.readLine().trim();\n        int[] res = new int[s.length()];\n        for (int i = 0; i < s.length(); i++) {\n            res[i] = s.charAt(i) - '0';\n        }\n        return res;\n    }\n\n    static int match(int a, int b) {\n        if (a == b) return 0;\n        if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n        return -1;\n    }\n\n    static int give(ArrayList<int[]> l1, ArrayList<int[]> l2) {\n        int ans = 0;\n        int[] curr1 = null;\n        int[] curr2 = null;\n        while (!l1.isEmpty() || !l2.isEmpty()) {\n            try {\n                if (curr1 == null) curr1 = l1.remove(l1.size() - 1);\n                if (curr2 == null) curr2 = l2.remove(l2.size() - 1);\n            } catch (Exception e) {\n                return ans;\n            }\n            int minCount = Math.min(curr1[0], curr2[0]);\n            ans += Math.max(0, minCount * match(curr1[1], curr2[1]));\n            if (curr1[0] < curr2[0]) {\n                curr2[0] -= curr1[0];\n                curr1 = null;\n            } else if (curr1[0] > curr2[0]) {\n                curr1[0] -= curr2[0];\n                curr2 = null;\n            } else {\n                curr1 = null;\n                curr2 = null;\n            }\n        }\n        return ans;\n    }\n\n    static int maximum(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        return Math.min(rock1, sci2) + Math.min(sci1, paper2) + Math.min(paper1, rock2);\n    }\n\n    static int minimum(int rock1, int sci1, int paper1, int rock2, int sci2, int paper2) {\n        int n = rock1 + sci1 + paper1;\n        int[][] base1 = {{rock1, 1}, {sci1, 2}, {paper1, 3}};\n        int[][] base2 = {{rock2, 1}, {sci2, 2}, {paper2, 3}};\n\n        // Generate all permutations of 3 elements (6 permutations)\n        int[][][] perms1 = new int[6][3][2];\n        int[][][] perms2 = new int[6][3][2];\n        int idx = 0;\n        for (int i = 0; i < 3; i++) {\n            for (int j = 0; j < 3; j++) {\n                if (j == i) continue;\n                for (int k = 0; k < 3; k++) {\n                    if (k == i || k == j) continue;\n                    perms1[idx][0] = base1[i];\n                    perms1[idx][1] = base1[j];\n                    perms1[idx][2] = base1[k];\n                    perms2[idx][0] = base2[i];\n                    perms2[idx][1] = base2[j];\n                    perms2[idx][2] = base2[k];\n                    idx++;\n                }\n            }\n        }\n\n        int ans = Integer.MAX_VALUE;\n        for (int p = 0; p < 6; p++) {\n            for (int q = 0; q < 6; q++) {\n                ArrayList<int[]> mylist1 = new ArrayList<>();\n                ArrayList<int[]> mylist2 = new ArrayList<>();\n                for (int[] arr : perms1[p]) mylist1.add(new int[]{arr[0], arr[1]});\n                for (int[] arr : perms2[q]) mylist2.add(new int[]{arr[0], arr[1]});\n                ans = Math.min(ans, give(mylist1, mylist2));\n            }\n        }\n        return ans;\n    }\n\n    public static void main(String[] args) throws IOException {\n        int n = val();\n        int[] arr1 = li();\n        int rock1 = arr1[0], sci1 = arr1[1], paper1 = arr1[2];\n        int[] arr2 = li();\n        int rock2 = arr2[0], sci2 = arr2[1], paper2 = arr2[2];\n\n        int maxWins = maximum(rock1, sci1, paper1, rock2, sci2, paper2);\n        int minWins = minimum(rock1, sci1, paper1, rock2, sci2, paper2);\n        System.out.println(minWins + \" \" + maxWins);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, 0.0, 0.0, -4.470248313737102e-05, -4.446407547220588e-05, -2.3841855067985307e-07, -0.4740772843360901, -0.02976071462035179, 0.0, 0.0, -5.829164365422912e-05, -0.20142698287963867, -1.3828182090946939e-05, 0.0, -0.001838661