{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <unordered_map>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\nusing i64 = long long;\n\ni64 numof(i64 x) {\n    if (x == 0) return 1;\n    i64 cnt = 0;\n    if (x < 0) x = -x;\n    while (x > 0) {\n        cnt++;\n        x /= 10;\n    }\n    return cnt;\n}\n\ni64 nxt(i64 x) {\n    vector<int> digits;\n    bool neg = x < 0;\n    if (neg) x = -x;\n    while (x > 0) {\n        int d = x % 10;\n        digits.push_back(d - (neg ? -1 : 1));\n        x /= 10;\n    }\n    i64 res = 0;\n    for (int i = digits.size() - 1; i >= 0; --i) {\n        res = res * 10 + digits[i];\n    }\n    return neg ? -res : res;\n}\n\ni64 prv(i64 x) {\n    bool neg = x < 0;\n    if (neg) x = -x;\n    i64 c = 0;\n    i64 cx = x;\n    while (x > 0) {\n        c = c * 10 + (neg ? -1 : 1);\n        x /= 10;\n    }\n    c = c * 10 + 1;\n    return neg ? cx + c : cx - c;\n}\n\ni64 lst(i64 x) {\n    if (x < 0) x = -x;\n    while (x >= 10) {\n        x /= 10;\n    }\n    return x;\n}\n\ni64 del(i64 x) {\n    if (x < 0) x = -x;\n    vector<int> digits;\n    while (x >= 10) {\n        digits.push_back(x % 10);\n        x /= 10;\n    }\n    i64 res = 0;\n    for (int i = digits.size() - 1; i >= 0; --i) {\n        res = res * 10 + digits[i];\n    }\n    return res;\n}\n\nunordered_map<i64, i64> memo;\n\ni64 f(i64 x) {\n    if (x <= 11) return min(13 - x, x);\n    if (memo.count(x)) return memo[x];\n    i64 n = 0, t = 1;\n    while (t < x) {\n        t *= 10;\n        t++;\n        n++;\n    }\n    if (x * 2 >= t) {\n        return memo[x] = min(f(t - x) + n + 1, (x / (t / 10)) * n + f(x % (t / 10)));\n    }\n    return memo[x] = (x / (t / 10)) * n + f(x % (t / 10));\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    i64 a;\n    cin >> a;\n    cout << f(a) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom functools import lru_cache\n\nsys.setrecursionlimit(10000)\n\ndef numof(x):\n    if x == 0:\n        return 1\n    cnt = 0\n    if x < 0:\n        x = -x\n    while x > 0:\n        cnt += 1\n        x //= 10\n    return cnt\n\ndef nxt(x):\n    digits = []\n    neg = x < 0\n    if neg:\n        x = -x\n    while x > 0:\n        d = x % 10\n        digits.append(d - (-1 if neg else 1))\n        x //= 10\n    res = 0\n    for i in range(len(digits) - 1, -1, -1):\n        res = res * 10 + digits[i]\n    return -res if neg else res\n\ndef prv(x):\n    neg = x < 0\n    if neg:\n        x = -x\n    c = 0\n    cx = x\n    while x > 0:\n        c = c * 10 + (-1 if neg else 1)\n        x //= 10\n    c = c * 10 + 1\n    return cx + c if neg else cx - c\n\ndef lst(x):\n    if x < 0:\n        x = -x\n    while x >= 10:\n        x //= 10\n    return x\n\ndef del_func(x):\n    if x < 0:\n        x = -x\n    digits = []\n    while x >= 10:\n        digits.append(x % 10)\n        x //= 10\n    res = 0\n    for i in range(len(digits) - 1, -1, -1):\n        res = res * 10 + digits[i]\n    return res\n\nmemo = {}\n\ndef f(x):\n    if x <= 11:\n        return min(13 - x, x)\n    if x in memo:\n        return memo[x]\n    n = 0\n    t = 1\n    while t < x:\n        t = t * 10 + 1\n        n += 1\n    if x * 2 >= t:\n        result = min(f(t - x) + n + 1, (x // (t // 10)) * n + f(x % (t // 10)))\n    else:\n        result = (x // (t // 10)) * n + f(x % (t // 10))\n    memo[x] = result\n    return result\n\ndef main():\n    a = int(sys.stdin.readline().strip())\n    print(f(a))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001935771433636546, -5.960462772236497e-07, -3.576278118089249e-07, -0.18185091018676758, -0.00020954797219019383, -0.014165329746901989, -0.3139740228652954, -0.02509712055325508, -2.8609820219571702e-05, -7.223821739898995e-05, -1.2516897186287679e-05, -4.303362584323622e-05, -0.00020895205670967698, -0.42939403653144836, -9.536738616588991e-07, -7.366862701019272e-05, -1.2397689715726301e-05, -2.3245540432981215e-05, -4.768370445162873e-07, -0.0003400462737772614, -4.660974445869215e-05, -1.3470558769768104e-05, 0.0, -4.768370445162873e-07, -0.4287817180156708, -0.005810987204313278, -6.603976362384856e-05, -0.002481597475707531, -6.6756979322235566e-06, -0.001335563138127327, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.00020430385484360158, -8.344646857949556e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -4.768370445162873e-07, -8.439661905867979e-05, 0.0, 0.0, -4.768370445162873e-07, -5.960462772236497e-07, -1.6689286894688848e-06, -0.005234583746641874, -4.768370445162873e-07, 0.0, -4.768370445162873e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -0.0003359945258125663, -1.0728830375228426e-06, -1.1920922133867862e-06, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -3.576278