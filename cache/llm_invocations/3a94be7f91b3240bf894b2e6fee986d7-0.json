{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, ec, total, a[6010], u[6010], v[6010];\nint head[MAXN], prev_idx[MAXN], dist[MAXN], inq[MAXN];\nqueue<int> q;\nstruct Edge { int to, cap, cost, next; } e[2000010];\n\nint node_id(int t, int v) { return t * n + v; }\n\nvoid add_edge(int s, int d, int cap, int cost) {\n    e[ec] = {d, cap, cost, head[s]};\n    head[s] = ec++;\n    e[ec] = {s, 0, -cost, head[d]};\n    head[d] = ec++;\n}\n\nbool spfa(int src, int dst) {\n    fill(dist, dist + MAXN, INF);\n    q.push(src);\n    dist[src] = 0;\n    while (!q.empty()) {\n        int cur = q.front(); q.pop();\n        inq[cur] = 0;\n        for (int i = head[cur]; ~i; i = e[i].next) {\n            int to = e[i].to;\n            if (e[i].cap && dist[to] > dist[cur] + e[i].cost) {\n                dist[to] = dist[cur] + e[i].cost;\n                prev_idx[to] = i;\n                if (!inq[to]) {\n                    q.push(to);\n                    inq[to] = 1;\n                }\n            }\n        }\n    }\n    return dist[dst] < 1e9;\n}\n\nvoid update(int src, int dst) {\n    for (int cur = dst; cur != src; cur = e[prev_idx[cur] ^ 1].to) {\n        e[prev_idx[cur]].cap--;\n        e[prev_idx[cur] ^ 1].cap++;\n    }\n    total += dist[dst];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        cin >> a[i];\n        add_edge(S, node_id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        cin >> u[i] >> v[i];\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add_edge(node_id(t, i), node_id(t + 1, i), k, c);\n        }\n        add_edge(node_id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            int limit = min(k, 25);\n            for (int j = 1; j <= limit; j++) {\n                int cost = c + (2 * j - 1) * d;\n                add_edge(node_id(t, u[i]), node_id(t + 1, v[i]), 1, cost);\n                add_edge(node_id(t, v[i]), node_id(t + 1, u[i]), 1, cost);\n            }\n        }\n    }\n    while (spfa(S, T)) update(S, T);\n    cout << total << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    MAXN = 6010\n    INF = 0x3f3f3f3f\n    \n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    a = [0] * (k + 1)\n    u = [0] * (m + 1)\n    v = [0] * (m + 1)\n    \n    for i in range(1, k + 1):\n        a[i] = int(data[idx]); idx += 1\n    \n    for i in range(1, m + 1):\n        u[i] = int(data[idx]); idx += 1\n        v[i] = int(data[idx]); idx += 1\n    \n    def node_id(t, v):\n        return t * n + v\n    \n    # Initialize graph structures\n    head = [-1] * MAXN\n    prev_idx = [0] * MAXN\n    dist = [INF] * MAXN\n    inq = [0] * MAXN\n    \n    # Edge list: each edge is [to, cap, cost, next]\n    e = []\n    ec = 0\n    \n    def add_edge(s, d, cap, cost):\n        nonlocal ec\n        # Forward edge\n        e.append([d, cap, cost, head[s]])\n        head[s] = ec\n        ec += 1\n        # Backward edge\n        e.append([s, 0, -cost, head[d]])\n        head[d] = ec\n        ec += 1\n    \n    # Add edges for starting positions\n    S = 0\n    T = 6000\n    for i in range(1, k + 1):\n        add_edge(S, node_id(0, a[i]), 1, 0)\n    \n    # Add edges for time transitions\n    for t in range(0, 101):\n        # Move from node i at time t to node i at time t+1 (waiting)\n        for i in range(2, n + 1):\n            add_edge(node_id(t, i), node_id(t + 1, i), k, c)\n        \n        # Connect node 1 to sink\n        add_edge(node_id(t, 1), T, k, 0)\n        \n        # Add edges for the m roads\n        for i in range(1, m + 1):\n            limit = min(k, 25)\n            for j in range(1, limit + 1):\n                cost = c + (2 * j - 1) * d\n                add_edge(node_id(t, u[i]), node_id(t + 1, v[i]), 1, cost)\n                add_edge(node_id(t, v[i]), node_id(t + 1, u[i]), 1, cost)\n    \n    total = 0\n    \n    def spfa(src, dst):\n        nonlocal dist, inq, prev_idx\n        dist = [INF] * MAXN\n        inq = [0] * MAXN\n        q = deque()\n        q.append(src)\n        dist[src] = 0\n        \n        while q:\n            cur = q.popleft()\n            inq[cur] = 0\n            i = head[cur]\n            while i != -1:\n                to, cap, cost, nxt = e[i]\n                if cap > 0 and dist[to] > dist[cur] + cost:\n                    dist[to] = dist[cur] + cost\n                    prev_idx[to] = i\n                    if inq[to] == 0:\n                        q.append(to)\n                        inq[to] = 1\n                i = nxt\n        return dist[dst] < 1e9\n    \n    def update(src, dst):\n        nonlocal total\n        cur = dst\n        while cur != src:\n            # Get the edge index\n            edge_idx = prev_idx[cur]\n            # Decrease capacity of forward edge\n            e[edge_idx][1] -= 1\n            # Increase capacity of backward edge\n            e[edge_idx ^ 1][1] += 1\n            # Move to previous node\n            cur = e[edge_idx ^ 1][0]\n        total += dist[dst]\n    \n    while spfa(S, T):\n        update(S, T)\n    \n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.368142152903602e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.08957488089799881, -0.04225464537739754, -2.3841855067985307e-07, -1.597391747054644e-05, -0.000277123210253194, -1.0251946150674485e-05, -0.0001820160250645131, -2.777537883957848e-05, -0.32173702120780945, -0.07362273335456848, -5.2927523938706145e-05, -8.344646857949556e-07, -0.07529130578041077, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -1.1920922133867862e-06, -1.6689286894688848e-06, -4.5298504119273275e-05, -4.410734163684538e-06, -0.0010401559993624687, -4.291525328881107e-06, -1.311301275563892e-06, -7.152555099310121e-07, -8.583032467868179e-06, 0.0, -1.6689286894688848e-06, -2.50339189733495e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -2.0265558760002023e-06, -0.2813814580440521, -2.3841830625315197e-06, -0.6312464475631714, -0.02479318529367447, -1.0251946150674485e-05, -2.145764938177308e-06, -0.3734007775783539, -0.000740968796890229, -8.344646857949556e-07, -0.000251142424531281, 0.0, -0.026399720460176468, -9.536738616588991e-07, -0.0005573864909820259, -3.9457496313843876e-05, -0.1426825374364853, -2.50339189733495e-06, -0.2544310986995697, -2.861018856492592e-06, -2.3841855067985307e-07, -7.867782187531