l) {\n            System.out.println(target.dist + \"\\n\" + target.count);\n        } else {\n            System.out.println(\"-1\\n0\");\n        }\n    }\n\n    static void process(int mask) {\n        int side = mask / 1000000;\n        int left50 = (mask % 1000000) / 100;\n        int left100 = mask % 100;\n        int currentDist = best.get(mask).dist;\n\n        if (side == 1) {\n            for (int i = left50; i >= 0 && 50 * (left50 - i) <= k; i--) {\n                for (int j = left100; j >= 0 && 50 * (left50 - i) + 100 * (left100 - j) <= k; j--) {\n                    if (i != left50 || j != left100) {\n                        long edgeWays = comb[left50][i] * comb[left100][j] % MOD;\n                        int nxt = i * 100 + j;\n                        addState(nxt, mask, edgeWays, currentDist + 1);\n                    }\n                }\n            }\n        } else {\n            for (int i = left50; i <= cnt50 && 50 * (i - left50) <= k; i++) {\n                for (int j = left100; j <= cnt100 && 50 * (i - left50) + 100 * (j - left100) <= k; j++) {\n                    if (i != left50 || j != left100) {\n                        long edgeWays = comb[cnt50 - left50][i - left50] * comb[cnt100 - left100][j - left100] % MOD;\n                        int nxt = 1000000 + i * 100 + j;\n                        addState(nxt, mask, edgeWays, currentDist + 1);\n                    }\n                }\n            }\n        }\n    }\n\n    static void addState(int nxt, int mask, long edgeWays, int newDist) {\n        if (!best.containsKey(nxt)) {\n            best.put(nxt, new Node(newDist, 0));\n            q.add(nxt);\n        }\n        Node current = best.get(mask);\n        Node next = best.get(nxt);\n        if (next.dist == newDist) {\n            next.count = (next.count + current.count * edgeWays) % MOD;\n        }\n    }\n\n    static void precomputeCombinations() {\n        for (int i = 0; i < 100; i++) {\n            comb[i][0] = 1;\n        }