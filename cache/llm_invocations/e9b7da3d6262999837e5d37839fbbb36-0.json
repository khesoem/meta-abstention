\n    } else {\n        for (int i = left50; i <= cnt50 && 50 * (i - left50) <= k; i++) {\n            for (int j = left100; j <= cnt100 && 50 * (i - left50) + 100 * (j - left100) <= k; j++) {\n                if (i != left50 || j != left100) {\n                    long long edgeWays = comb[cnt50 - left50][i - left50] * comb[cnt100 - left100][j - left100] % MOD;\n                    int nxt = 1000000 + i * 100 + j;\n                    addState(nxt, mask, edgeWays, currentDist + 1);\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    cin >> n >> k;\n    for (int i = 0; i < n; i++) {\n        int w;\n        cin >> w;\n        if (w == 50) cnt50++;\n        else cnt100++;\n    }\n\n    precomputeCombinations();\n\n    int first = 1000000 + 100 * cnt50 + cnt100;\n    best[first] = make_pair(0, 1LL);\n    q.push(first);\n\n    while (!q.empty()) {\n        int cur = q.front();\n        q.pop();\n        process(cur);\n    }\n\n    if (best.find(0) != best.end()) {\n        cout << best[0].first << \"\\n\" << best[0].second << endl;\n    } else {\n        cout << \"-1\\n0\" << endl;\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-6.198864e-06, 0.0, 0.0, -0.0032124126, -0.00023064337, -0.00021252758, -0.69507533, -4.0411134e-05, -2.3841855e-07, -3.576278e-07, -0.034533266, -6.7949063e-06, 0.0, -1.1920928e-07, -0.044492085, 0.0, -0.014176495, -0.048832353, -3.576278e-07, -0.427972, -0.20146792, -0.57688695, -5.245195e-06, 0.0, -0.0040875464, -0.96789384, -5.2927524e-05, -1.9907753e-05, -9.5367386e-07, -0.0067200856, -1.7881378e-06, -1.5497195e-06, -0.00014041868, -2.3841855e-07, -1.1920922e-06, -1.1920928e-07, 0.0, 0.0, -2.3841855e-07, -1.1920928e-07, -2.3841855e-07, -2.741776e-05, -0.0008088654, -0.00013076403, -0.0297525, -1.9073468e-06, -2.3841855e-07, -2.3841855e-07, -4.553691e-05, -1.1920928e-07, -1.1920928e-07, -1.3113013e-06, -0.0076438556, -2.3722367e-05, -0.0015238827, -1.1920922e-06, 