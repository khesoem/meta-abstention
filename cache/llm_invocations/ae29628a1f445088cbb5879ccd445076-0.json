ueue[u] = 0;\n        for (int id : adj[u]) {\n            if (residual(id) == 0) continue;\n            int v = edges[id].to;\n            if (dist[v] > dist[u] + edges[id].cost) {\n                dist[v] = dist[u] + edges[id].cost;\n                prv[v] = u;\n                usedEdge[v] = id;\n                if (!inQueue[v]) {\n                    inQueue[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n}\n\nvoid pushOneUnit() {\n    shortestPaths();\n    int cur = T;\n    while (cur != S) {\n        edges[usedEdge[cur]].flow++;\n        edges[usedEdge[cur] ^ 1].flow--;\n        cur = prv[cur];\n    }\n    totalCost += dist[T];\n}\n\nint n, m, k, c, d;\n\nvoid readAndBuild() {\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        --x;\n        addEdge(S, x, 1, 0);\n    }\n    for (int t = 0; t < L; ++t) {\n        addEdge(t * n, T, k, t * c);\n    }\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        scanf(\"%d %d\", &x, &y);\n        --x; --y;\n        for (int t = 0; t < L - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n        for (int t = 0; t < L - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n}\n\nvoid solve() {\n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < L - 1; ++t) {\n            addEdge(i + t * n, i + t * n + n, k, 0);\n        }\n    }\n    for (int i = 0; i < k; ++i) {\n        pushOneUnit();\n    }\n    printf(\"%lld\\n\", totalCost);\n}\n\nint main() {\n    readAndBuild();\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, flow, cost;\n        Edge() {}\n        Edge(int to, int cap, int flow, int cost) {\n            this.to = to;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final long INF = (long)1e18;\n    static final int MAXN = 1000007;\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[MAXN];\n    static long[] dist = new long[MAXN];\n    static int[] prv = new int[MAXN];\n    static int[] usedEdge = new int[MAXN];\n    static int[] inQueue = new int[MAXN];\n    static int S = MAXN - 2;\n    static int T = MAXN - 1;\n    static int L = 101;\n    static long totalCost = 0;\n\n    static int residual(int id) {\n        return edges.get(id).cap - edges.get(id).flow;\n    }\n\n    static void addEdge(int u, int v, int capacity, int cost) {\n        if (adj[u] == null) adj[u] = new ArrayList<>();\n        if (adj[v] == null) adj[v] = new ArrayList<>();\n        adj[u].add(edges.size());\n        edges.add(new Edge(v, capacity, 0, cost));\n        adj[v].add(edges.size());\n        edges.add(new Edge(u, 0, 0, cost));\n    }\n\n    static void shortestPaths() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(prv, -1);\n        Arrays.fill(usedEdge, -1);\n        Arrays.fill(inQueue, 0);\n        Queue<Integer> q = new LinkedList<>();\n        dist[S] = 0;\n        q.add(S);\n        inQueue[S] = 1;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = 0;\n            if (adj[u] == null) continue;\n            for (int id : adj[u]) {\n                if (residual(id) == 0) continue;\n                int v = edges.get(id).to;\n                if (dist[v] > dist[u] + edges.get(id).cost) {\n                    dist[v] = dist[u] + edges.get(id).cost;\n                    prv[v] = u;\n                    usedEdge[v] = id;\n            