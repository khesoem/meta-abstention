n    assert(g == 1);\n    if (x < 0) x += MOD;\n    return x;\n}\n\nstruct NumberTheory {\n    static ll paritySign(ll k) {\n        return (k & 1) == 0 ? 1 : MOD - 1;\n    }\n\n    static ll fact(int n, vector<ll>& fact_arr) {\n        while ((int)fact_arr.size() <= n) {\n            fact_arr.push_back(fact_arr.back() * (int)fact_arr.size() % MOD);\n        }\n        return fact_arr[n];\n    }\n\n    static ll invFact(int n, vector<ll>& fact_arr, vector<ll>& inv_fact) {\n        int last = (int)inv_fact.size() - 1;\n        if (last < n) {\n            int need = n - last;\n            vector<ll> tmp(need);\n            tmp[0] = modinv(fact(n, fact_arr));\n            for (int i = 1; i < need; ++i) {\n                tmp[i] = tmp[i-1] * (n - i + 1) % MOD;\n            }\n            for (int i = need-1; i >= 0; --i) {\n                inv_fact.push_back(tmp[i]);\n            }\n        }\n        return inv_fact[n];\n    }\n\n    static ll ncr(int n, int r, vector<ll>& fact_arr, vector<ll>& inv_fact) {\n        if (r < 0 || r > n) return 0;\n        return fact(n, fact_arr) * invFact(r, fact_arr, inv_fact) % MOD * invFact(n-r, fact_arr, inv_fact) % MOD;\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n    int n;\n    ll k;\n    cin >> n >> k;\n\n    vector<ll> fact_arr = {1};\n    vector<ll> inv_fact = {1};\n\n    if (k == 0) {\n        cout << NumberTheory::fact(n, fact_arr) << '\\n';\n        return 0;\n    }\n    if (k > n - 1) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    int c = (int)(n - k);\n    ll answer = 0;\n    for (int i = 1; i <= c; ++i) {\n        ll term = NumberTheory::paritySign(c - i) \n                  * NumberTheory::ncr(c, i, fact_arr, inv_fact) % MOD \n                  * modpow(i, n) % MOD;\n        answer = (answer + term) % MOD;\n    }\n    answer = answer * 2 % MOD;\n    answer = answer * NumberTheory::ncr(n, c, fact_arr, inv_fact) % MOD;\n    cout << answer << '\\n';\n\n    return 