[v].add(edges.size());\n        edges.add(new Edge(v, u, 0, -cost));\n    }\n\n    static void ford_bellman(int s, int n) {\n        Arrays.fill(phi, INF);\n        phi[s] = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < edges.size(); j++) {\n                Edge e = edges.get(j);\n                if (e.cap == e.flow) continue;\n                int from = e.from;\n                int to = e.to;\n                long len = e.cost;\n                if (phi[from] == INF) continue;\n                if (phi[from] + len < phi[to]) {\n                    phi[to] = phi[from] + len;\n                }\n            }\n        }\n    }\n\n    static void dijkstra(int s) {\n        Arrays.fill(d, INF);\n        d[s] = 0;\n        PriorityQueue<Pair> pq = new PriorityQueue<>();\n        pq.add(new Pair(0, s));\n        while (!pq.isEmpty()) {\n            Pair cur = pq.poll();\n            int v = cur.node;\n            if (cur.cost != d[v]) continue;\n            for (int i = 0; i < g[v].size(); i++) {\n                int eid = g[v].get(i);\n                Edge e = edges.get(eid);\n                if (e.cap == e.flow) continue;\n                int to = e.to;\n                long len = e.cost + phi[v] - phi[to];\n                if (d[v] + len < d[to]) {\n                    d[to] = d[v] + len;\n                    par[to] = eid;\n                    pq.add(new Pair(d[to], to));\n                }\n            }\n        }\n    }\n\n    static class Pair implements Comparable<Pair> {\n        long cost;\n        int node;\n        Pair(long cost, int node) {\n            this.cost = cost;\n            this.node = node;\n        }\n        public int compareTo(Pair other) {\n            if (this.cost < other.cost) return -1;\n            if (this.cost > other.cost) return 1;\n            return Integer.compare(this.node, other.node);\n        }\n    }\n\n    static long[] mincost_maxflow(int s, int t) {\n        ford_bellman(s, 50);\n        dijkstra(s);\n        long flow = 0, cost = 0;\n        while (true) {\n            if (d[t] == INF) break;\n            long pushed = INF;\n            long sum = 0;\n            for (int tmp = t; tmp != s; ) {\n                int eid = par[tmp];\n                Edge e = edges.get(eid);\n                pushed = Math.min(pushed, e.cap - e.flow);\n                sum += e.cost;\n                tmp = e.from;\n            }\n            flow += pushed;\n            cost += pushed * sum;\n            for (int tmp = t; tmp != s; ) {\n                int eid = par[tmp];\n                Edge e = edges.get(eid);\n                e.flow += pushed;\n                edges.get(eid ^ 1).flow -= pushed;\n                tmp = e.from;\n            }\n            dijkstra(s);\n            for (int i = 0; i < maxn; i++) {\n                phi[i] = d[i];\n            }\n        }\n        return new long[]{cost, flow};\n    }\n\n    static void solve() {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] cnts = new int[n];\n        for (int i = 0; i < k; i++) {\n            int ai = sc.nextInt();\n            ai--;\n            cnts[ai]++;\n        }\n        for (int i = 0; i < n; i++) {\n            add_edge(5000, i, cnts[i], 0);\n        }\n        for (int it = 0; it < m; it++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            u--; v--;\n            for (int i = 0; i < 99; i++) {\n                long cost = d;\n                for (int j = 0; j < 50; j++) {\n                    add_edge(u + i * 50, v + (i + 1) * 50, 1, cost);\n                    add_edge(v + i * 50, u + (i + 1) * 50, 1, cost);\n                    cost += 2 * d;\n                }\n            }\n        }\n        for (int i = 0; i <= 99; i++) {\n            add_edge(0 + i * 50, 5001, INF, (long) c * i);\n        }