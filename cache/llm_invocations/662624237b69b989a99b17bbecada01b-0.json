ist[t];\n}\n\nint main() {\n    for (int i = 0; i < maxn; i++) head[i] = -1;\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &a[i]), add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &x[i], &y[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            int lim = (k < 25) ? k : 25;\n            for (int j = 1; j <= lim; j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    maxn = 6010\n    INF = 10**9\n\n    # graph: adjacency list of edge indices\n    graph = [[] for _ in range(maxn)]\n    edges = []  # each edge: [to, cap, cost, rev]\n\n    def add_edge(fr, to, cap, cost):\n        # forward edge\n        edges.append([to, cap, cost, len(edges) + 1])\n        graph[fr].append(len(edges) - 1)\n        # reverse edge\n        edges.append([fr, 0, -cost, len(edges) - 1])\n        graph[to].append(len(edges) - 1)\n\n    S = 0\n    T = 6000\n\n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = next(it)\n        add_edge(S, 0 * n + a[i], 1, 0)  # id(0, a[i])\n\n    x = [0] * (m + 1)\n    y = [0] * (m + 1)\n    for i in range(1, m + 1):\n        x[i] = next(it)\n        y[i] = next(it)\n\n    # time layers\n    for t in range(0, 101):  # t = 0..100 inclusive\n        # edges from t to t+1 for vertices 2..n\n        for i in range(2, n + 1):\n            add_edge(t * n + i, (t + 1) * n + i, k, c)\n        # edge from vertex 1 to sink\n        add_edge(t * n + 1, T, k, 0)\n        # edges for each road\n        for i in range(1, m + 1):\n            lim = min(k, 25)\n            for j in range(1, lim + 1):\n                cost = c + (2 * j - 1) * d\n                add_edge(t * n + x[i], (t + 1) * n + y[i], 1, cost)\n                add_edge(t * n + y[i], (t + 1) * n + x[i], 1, cost)\n\n    # SPFA and update\n    dist = [INF] * maxn\n    pre = [-1] * maxn\n    inq = [0] * maxn\n    ans = 0\n\n    def spfa(s, t):\n        for i in range(maxn):\n            dist[i] = INF\n            pre[i] = -1\n            inq[i] = 0\n        q = deque()\n        q.append(s)\n        dist[s] = 0\n        inq[s] = 1\n        while q:\n            v = q.popleft()\n            inq[v] = 0\n            for ei in graph[v]:\n                e = edges[ei]\n                if e[1] > 0 and dist[e[0]] > dist[v] + e[2]:\n                    dist[e[0]] = dist[v] + e[2]\n                    pre[e[0]] = ei\n                    if not inq[e[0]]:\n                        q.append(e[0])\n                        inq[e[0]] = 1\n        return dist[t] < 1e9\n\n    def upd(s, t):\n        nonlocal ans\n        i = t\n        while i != s:\n            ei = pre[i]\n            edges[ei][1] -= 1\n            rev = edges[ei][3]\n            edges[rev][1] += 1\n            i = edges[rev][0]\n        ans += dist[t]\n\n    while spfa(S, T):\n        upd(S, T)\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.291525328881107e-06, 0.0, 0.0, -0.00018618757894728333, -0.011118951253592968, -1.1920928244535389e-07, -0.000174