   }\n}\n\nvoid bfs2(int sx, int sy) {\n    for (int i = 0; i < 30; ++i)\n        for (int j = 0; j < 30; ++j) D2[i][j] = INT_MAX;\n    queue<pair<int, int>> q;\n    q.push({sx, sy});\n    D2[sx][sy] = 0;\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        if (D2[x][y] >= D1[x][y]) continue;\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + DX[k], ny = y + DY[k];\n            if (inRange(nx, ny) && D2[nx][ny] == INT_MAX && G1[nx][ny] != 'Y' && D2[x][y] + 1 <= D1[nx][ny]) {\n                D2[nx][ny] = D2[x][y] + 1;\n                q.push({nx, ny});\n            }\n        }\n    }\n}\n\nbool bfs() {\n    memset(lvl, -1, sizeof(lvl));\n    queue<int> q;\n    q.push(0);\n    lvl[0] = 0;\n    while (!q.empty() && lvl[N*N*2+1] == -1) {\n        int u = q.front(); q.pop();\n        for (int id : adj[u]) {\n            auto &e = E[id];\n            if (lvl[e.dst] == -1 && e.flow < e.cap) {\n                lvl[e.dst] = lvl[u] + 1;\n                q.push(e.dst);\n            }\n        }\n    }\n    return lvl[N*N*2+1] != -1;\n}\n\nint dfs(int u, int f) {\n    if (!f || u == N*N*2+1) return f;\n    for (int &i = pr[u]; i < (int)adj[u].size(); ++i) {\n        int id = adj[u][i];\n        auto &e = E[id];\n        if (lvl[e.dst] != lvl[u] + 1) continue;\n        int sent = dfs(e.dst, min(f, e.cap - e.flow));\n        if (sent) {\n            e.flow += sent;\n            E[id^1].flow -= sent;\n            return sent;\n        }\n    }\n    return 0;\n}\n\nint flow() {\n    int result = 0;\n    while (bfs()) {\n        memset(pr, 0, sizeof(pr));\n        while (int sent = dfs(0, INT_MAX)) result += sent;\n    }\n    return result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> LIMIT;\n    G1.resize(N); G2.resize(N);\n    for (int i = 0; i < N; ++i) cin >> G1[i];\n    for (int i = 0; i < N; ++i) cin >> G2[i];\n    \n    int zx = -1, zy = -1;\n    for (int i = 0; i < N; ++i) {\n     