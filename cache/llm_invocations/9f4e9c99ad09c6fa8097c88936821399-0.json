e(30)]\n    D2 = [[float('inf')] * 30 for _ in range(30)]\n    \n    # Find Z position\n    zx, zy = -1, -1\n    for i in range(N):\n        for j in range(N):\n            if G2[i][j] == 'Z':\n                G1[i][j] = 'Y'\n                G2[i][j] = 'Y'\n                zx, zy = i, j\n    \n    # BFS1\n    def bfs1(sx, sy):\n        for i in range(30):\n            for j in range(30):\n                D1[i][j] = float('inf')\n        q = deque()\n        q.append((sx, sy))\n        D1[sx][sy] = 0\n        dx = [0, 0, -1, 1]\n        dy = [1, -1, 0, 0]\n        while q:\n            x, y = q.popleft()\n            for k in range(4):\n                nx, ny = x + dx[k], y + dy[k]\n                if 0 <= nx < N and 0 <= ny < N and D1[nx][ny] == float('inf') and G2[nx][ny] != 'Y':\n                    D1[nx][ny] = D1[x][y] + 1\n                    q.append((nx, ny))\n    \n    # BFS2\n    def bfs2(sx, sy):\n        for i in range(30):\n            for j in range(30):\n                D2[i][j] = float('inf')\n        q = deque()\n        q.append((sx, sy))\n        D2[sx][sy] = 0\n        dx = [0, 0, -1, 1]\n        dy = [1, -1, 0, 0]\n        while q:\n            x, y = q.popleft()\n            if D2[x][y] >= D1[x][y]:\n                continue\n            for k in range(4):\n                nx, ny = x + dx[k], y + dy[k]\n                if 0 <= nx < N and 0 <= ny < N and D2[nx][ny] == float('inf') and G1[nx][ny] != 'Y' and D2[x][y] + 1 <= D1[nx][ny]:\n                    D2[nx][ny] = D2[x][y] + 1\n                    q.append((nx, ny))\n    \n    bfs1(zx, zy)\n    \n    # Build graph for max flow\n    V = 2 * N * N + 2\n    adj = [[] for _ in range(V)]\n    E = []\n    \n    def add_edge(src, dst, cap):\n        E.append({'src': src, 'dst': dst, 'cap': cap, 'flow': 0})\n        adj[src].append(len(E) - 1)\n        E.append({'src': dst, 'dst': src, 'cap': 0, 'flow': 0})\n        adj[dst].append(len(E) - 1)\n    \n    for i in range(N):\n        for j in range(N):\n            if G1[i][j] == 'Y':\n                continue\n            u = i * N + j + 1\n            v = N * N + u\n            c1 = int(G1[i][j])\n            c2 = int(G2[i][j])\n            \n            add_edge(0, u, c1)\n            add_edge(v, V-1, c2)\n            \n            bfs2(i, j)\n            for x in range(N):\n                for y in range(N):\n                    if G2[x][y] == 'Y' or D2[x][y] > LIMIT:\n                        continue\n                    w = N * N + x * N + y + 1\n                    add_edge(u, w, c1)\n    \n    # Dinic's algorithm\n    def bfs_level():\n        lvl = [-1] * V\n        q = deque()\n        q.append(0)\n        lvl[0] = 0\n        while q and lvl[V-1] == -1:\n            u = q.popleft()\n            for id in adj[u]:\n                e = E[id]\n                if lvl[e['dst']] == -1 and e['flow'] < e['cap']:\n                    lvl[e['dst']] = lvl[u] + 1\n                    q.append(e['dst'])\n        return lvl[V-1] != -1\n    \n    def dfs(u, f, lvl, ptr):\n        if not f or u == V-1:\n            return f\n        while ptr[u] < len(adj[u]):\n            id = adj[u][ptr[u]]\n            e = E[id]\n            if lvl[e['dst']] == lvl[u] + 1 and e['flow'] < e['cap']:\n                sent = dfs(e['dst'], min(f, e['cap'] - e['flow']), lvl, ptr)\n                if sent:\n                    E[id]['flow'] += sent\n                    E[id ^ 1]['flow'] -= sent\n                    return sent\n            ptr[u] += 1\n        return 0\n    \n    result = 0\n    while bfs_level():\n        ptr = [0] * V\n        while True:\n            sent = dfs(0, float('inf'), lvl, ptr)\n            if not sent:\n                break\n            result += sent\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013815402053296566, -1.4305104514278355e-06, -1.1920928244535389e-07, -0.015028821304440498, -0.00253843679092824