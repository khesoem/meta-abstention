x0 == x1 and y0 == y1:\n            return 1 if dist[x0][y0] >= ptr else 0\n        if dist[x0][y0] <= ptr:\n            return 0\n        for k in range(4):\n            nx = x0 + dx[k]\n            ny = y0 + dy[k]\n            if good(nx, ny) and dfs(nx, ny, x1, y1, ptr + 1):\n                return 1\n        return 0\n\n    # Build flow network\n    total_nodes = 2 * m + 2   # source=0, sink=2m+1, scientists 1..m, labs m+1..2m\n    cap = [[0] * total_nodes for _ in range(total_nodes)]\n\n    # source -> scientists\n    for i in range(m):\n        cap[0][i + 1] = sc[i]\n    # labs -> sink\n    for i in range(m):\n        cap[m + 1 + i][2 * m + 1] = lc[i]\n\n    # scientists -> labs if path exists\n    for i in range(m):\n        for j in range(m):\n            if dfs(pos[i][0], pos[i][1], pos[j][0], pos[j][1], 0):\n                cap[i + 1][m + 1 + j] = 1000\n\n    # Max flow using Ford-Fulkerson (Edmonds-Karp)\n    flow = 0\n    source = 0\n    sink = 2 * m + 1\n\n    while True:\n        par = [-1] * total_nodes\n        par[source] = -2\n        q = deque([source])\n        while q:\n            v = q.popleft()\n            for i in range(total_nodes):\n                if par[i] == -1 and cap[v][i] > 0:\n                    par[i] = v\n                    q.append(i)\n        if par[sink] == -1:\n            break\n\n        # compute augmenting flow\n        aug = 10**9\n        u = sink\n        while par[u] >= 0:\n            v = par[u]\n            aug = min(aug, cap[v][u])\n            u = v\n\n        # update residual network\n        u = sink\n        while par[u] >= 0:\n            v = par[u]\n            cap[v][u] -= aug\n            cap[u][v] += aug\n            u = v\n        flow += aug\n\n    print(flow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00045134371612221, -2.0265558760002023e-06, -1.1920928244535389e-07, 0.0, -0.00200297380797565, -0.0305449478328228, 0.0, 