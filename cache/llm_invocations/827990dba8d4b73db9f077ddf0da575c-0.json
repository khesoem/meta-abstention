     q = deque()\n        q.append(s)\n        self.level[s] = 0\n        while q:\n            u = q.popleft()\n            for v in self.adj[u]:\n                if self.level[v] == -1 and self.capacity[u][v] > 0:\n                    self.level[v] = self.level[u] + 1\n                    q.append(v)\n        return self.level[t] != -1\n\n    def dfs(self, u, t, flow):\n        if u == t:\n            return flow\n        while self.ptr[u] < len(self.adj[u]):\n            v = self.adj[u][self.ptr[u]]\n            if self.level[v] == self.level[u] + 1 and self.capacity[u][v] > 0:\n                pushed = self.dfs(v, t, min(flow, self.capacity[u][v]))\n                if pushed > 0:\n                    self.capacity[u][v] -= pushed\n                    self.capacity[v][u] += pushed\n                    return pushed\n            self.ptr[u] += 1\n        return 0\n\n    def maxFlow(self, s, t):\n        total = 0\n        while self.bfs(s, t):\n            self.ptr = [0] * self.N\n            pushed = self.dfs(s, t, INF)\n            while pushed > 0:\n                total += pushed\n                pushed = self.dfs(s, t, INF)\n        return total\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    if not data:\n        return\n    \n    n, t = map(int, data[0].split())\n    field = []\n    capsule = []\n    \n    for i in range(1, n + 1):\n        field.append(data[i])\n    \n    for i in range(n + 1, 2 * n + 1):\n        capsule.append(data[i])\n    \n    src = 2 * n * n\n    dst = src + 1\n    flow = FlowNetwork(2 * n * n + 2)\n    \n    zx, zy = -1, -1\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                zx, zy = i, j\n    \n    for i in range(n):\n        for j in range(n):\n            if capsule[i][j].isdigit():\n                flow.addEdge(i * n + j + n * n, dst, int(capsule[i][j]))\n    \n    distZ = [[INF] * n for _ in range(n)]\n    q = deque()\n    distZ[zx][zy] = 0\n    q.append((zx, zy))\n    dx = [-1, 1, 0, 0]\n    dy = [0, 0, -1, 1]\n    \n    while q:\n        x, y = q.popleft()\n        if distZ[x][y] == t:\n            continue\n        for d in range(4):\n            nx, ny = x + dx[d], y + dy[d]\n            if 0 <= nx < n and 0 <= ny < n and capsule[nx][ny] != 'Y' and distZ[nx][ny] == INF:\n                distZ[nx][ny] = distZ[x][y] + 1\n                if capsule[nx][ny].isdigit():\n                    flow.addEdge(zx * n + zy, nx * n + ny + n * n, INF)\n                q.append((nx, ny))\n    \n    for i in range(n):\n        for j in range(n):\n            if field[i][j].isdigit():\n                flow.addEdge(src, i * n + j, int(field[i][j]))\n                distS = [[INF] * n for _ in range(n)]\n                q2 = deque()\n                distS[i][j] = 0\n                q2.append((i, j))\n                while q2:\n                    x, y = q2.popleft()\n                    if distS[x][y] == t:\n                        continue\n                    for d in range(4):\n                        nx, ny = x + dx[d], y + dy[d]\n                        if 0 <= nx < n and 0 <= ny < n and capsule[nx][ny] != 'Y' and distS[nx][ny] == INF:\n                            distS[nx][ny] = distS[x][y] + 1\n                            if capsule[nx][ny].isdigit():\n                                flow.addEdge(i * n + j, nx * n + ny + n * n, INF)\n                            q2.append((nx, ny))\n    \n    print(flow.maxFlow(src, dst))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017271934484597296, -1.9073468138230965e-06, -1.1920928244535389e-07, -0.5047227144241333, -0.00017331528943032026, -7.152555099310121e-07, -4.8874615458771586e-05, -0.00134080124553293, -2.825220326485578e-05, -0.00025388356880284846, -4.9232225137529895e-05, -0.32680845260620117, -4.768370445162873e-07, -0.010392124764621258, -3.576278118089249e-07, -1.8596476365928538e-05