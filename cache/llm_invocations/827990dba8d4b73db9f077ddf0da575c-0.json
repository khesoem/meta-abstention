[i];\n            if (level[v] == level[u] + 1 && capacity[u][v] > 0) {\n                int pushed = dfs(v, t, min(flow, capacity[u][v]));\n                if (pushed > 0) {\n                    capacity[u][v] -= pushed;\n                    capacity[v][u] += pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n\n    int maxFlow(int s, int t) {\n        int total = 0;\n        while (bfs(s, t)) {\n            fill(ptr.begin(), ptr.end(), 0);\n            int pushed;\n            while ((pushed = dfs(s, t, INF)) > 0) {\n                total += pushed;\n            }\n        }\n        return total;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(nullptr);\n    int n, t;\n    cin >> n >> t;\n    vector<string> field(n), capsule(n);\n    int src = 2 * n * n, dst = src + 1;\n    FlowNetwork flow(2 * n * n + 2);\n    \n    int zx = -1, zy = -1;\n    for (int i = 0; i < n; ++i) {\n        cin >> field[i];\n        for (int j = 0; j < n; ++j) {\n            if (field[i][j] == 'Z') {\n                zx = i; zy = j;\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        cin >> capsule[i];\n        for (int j = 0; j < n; ++j) {\n            if (isdigit(capsule[i][j])) {\n                flow.addEdge(i * n + j + n * n, dst, capsule[i][j] - '0');\n            }\n        }\n    }\n    \n    vector<vector<int>> distZ(n, vector<int>(n, INF));\n    queue<pii> q;\n    distZ[zx][zy] = 0;\n    q.push({zx, zy});\n    int dx[] = {-1, 1, 0, 0}, dy[] = {0, 0, -1, 1};\n    \n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        if (distZ[x][y] == t) continue;\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (nx >= 0 && nx < n && ny >= 0 && ny < n && capsule[nx][ny] != 'Y' && distZ[nx][ny] == INF) {\n                distZ[nx][ny] = distZ[x][y] + 1;\n                if (isdigit(capsule[nx][ny])) {\n  