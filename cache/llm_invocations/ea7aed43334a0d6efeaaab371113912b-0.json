    self.cap = cap\n            self.cost = cost\n\n    def __init__(self, n):\n        self.n = n\n        self.graph = [[] for _ in range(n)]\n\n    def add_edge(self, fr, to, cap, cost):\n        forward = self.Edge(to, len(self.graph[to]), cap, cost)\n        backward = self.Edge(fr, len(self.graph[fr]), 0, -cost)\n        self.graph[fr].append(forward)\n        self.graph[to].append(backward)\n\n    def run(self, s, t, maxf):\n        n = self.n\n        INF = 10**18\n        res = 0\n        potential = [0] * n\n        prevv = [0] * n\n        preve = [0] * n\n        flow = maxf\n        while flow > 0:\n            dist = [INF] * n\n            dist[s] = 0\n            pq = [(0, s)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if dist[v] < d:\n                    continue\n                for i, e in enumerate(self.graph[v]):\n                    if e.cap > 0 and dist[e.to] > dist[v] + e.cost + potential[v] - potential[e.to]:\n                        dist[e.to] = dist[v] + e.cost + potential[v] - potential[e.to]\n                        prevv[e.to] = v\n                        preve[e.to] = i\n                        heapq.heappush(pq, (dist[e.to], e.to))\n            if dist[t] == INF:\n                return -1\n            for v in range(n):\n                if dist[v] < INF:\n                    potential[v] += dist[v]\n            d = flow\n            v = t\n            while v != s:\n                d = min(d, self.graph[prevv[v]][preve[v]].cap)\n                v = prevv[v]\n            flow -= d\n            res += d * potential[t]\n            v = t\n            while v != s:\n                e = self.graph[prevv[v]][preve[v]]\n                e.cap -= d\n                self.graph[v][e.rev].cap += d\n                v = prevv[v]\n        return res\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(ne