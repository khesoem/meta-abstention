{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define db(x) cout << (x) << '\\n';\nusing namespace std;\ntypedef long long ll;\ntypedef pair<ll,ll> pii;\ntypedef pair<ll,pii> pip;\ntypedef pair<pii,pii> ppp;\ntypedef long double ld;\n#include <ext/pb_ds/assoc_container.hpp>\n#include <ext/pb_ds/tree_policy.hpp>\nusing namespace __gnu_pbds;\n\ntypedef tree<ll, null_type, less<ll>,rb_tree_tag, tree_order_statistics_node_update> ordered_set;\n\n/*\n    Minimum Cost Flow (Tomizawa, Edmonds-Karp)\n    Complexity:\n    O(F m log n), where F is the amount of maximum flow\n    Tested:\n    Codeforces [http://codeforces.com/problemset/problem/717/G]\n*/\ntemplate<typename flow_type, typename cost_type>\nstruct min_cost_max_flow\n{\n    struct edge\n    {\n        size_t src, dst, rev;\n        flow_type flow, cap;\n        cost_type cost;\n    };\n    int n;\n    vector<vector<edge>> adj;\n    min_cost_max_flow(int n) : n(n), adj(n), potential(n), dist(n), back(n) {}\n    void add_edge(size_t src, size_t dst, flow_type cap, cost_type cost)\n    {\n        adj[src].push_back({src, dst, adj[dst].size(), 0, cap, cost});\n        if (src == dst)\n            adj[src].back().rev++;\n        adj[dst].push_back({dst, src, adj[src].size() - 1, 0, 0, -cost});\n    }\n    vector<cost_type> potential;\n    inline cost_type rcost(const edge &e)\n    {\n        return e.cost + potential[e.src] - potential[e.dst];\n    }\n\n//    void bellman_ford(int source)\n//    {\n//        for (int k = 0; k < n; ++k)\n//            for (int u = 0; u < n; ++u)\n//                for (edge &e : adj[u])\n//                    if (e.cap > 0 && rcost(e) < 0)\n//                        potential[e.dst] += rcost(e);\n//    }\n    const cost_type oo = numeric_limits<cost_type>::max();\n    vector<cost_type> dist;\n    vector<edge * > back;\n    cost_type dijkstra(int source, int sink)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> node;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        for (pq.push({dist[source] = 0, source}); !pq.empty();)\n        {\n            node p = pq.top();\n            pq.pop();\n            if (dist[p.second] < p.first)\n                continue;\n            if (p.second == sink)\n                break;\n            for (edge &e : adj[p.second])\n                if (e.flow < e.cap &&\n                        dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({\n                        dist[e.dst] = dist[e.src] + rcost(e),\n                        e.dst\n                    });\n                }\n        }\n        return dist[sink];\n    }\n    pair<flow_type, cost_type> max_flow(int source, int sink)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        back.assign(n, nullptr);\n//        bellman_ford(source); // remove negative costs\n        while (dijkstra(source, sink) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n            if (dist[u] < dist[sink])\n                potential[u] += dist[u] - dist[sink];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (edge * e = back[sink]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (edge * e = back[sink]; e; e = back[e->src])\n                e->flow += f, adj[e->dst][e->rev].flow -= f;\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n\n    int n,m,k,c,d,u,v;\n    cin >> n >> m >> k >> c >> d;\n    min_cost_max_flow<int,int> g((n+2)*102);\n    for(int i=0;i<102;i++)\n        g.add_edge((i*(n+2))+1,i*(n+2),100,(i*c));\n    for(int i=0;i<101;i++)\n        for(int j=0;j<n+1;j++)\n            g.add_edge(j+(i*(n+2)),j+((i+1)*(n+2)),100,0);\n    for(int i=0;i<k;i++)\n    {\n        cin >> u;\n        g.add_edge(n+1,u,1,0);\n    }\n\n    for(int i=0;i<m;i++)\n    {\n        cin >> u >> v;\n        for(int j=0;j<101;j++)\n            for(int f=0;f<k;f++)\n            {\n                g.add_edge(u+(j*(n+2)),v+((j+1)*(n+2)),1,((2*f)+1)*d);\n                g.add_edge(v+(j*(n+2)),u+((j+1)*(n+2)),1,((2*f)+1)*d);\n            }\n    }\n\n    db(g.max_flow(n+1,(101*(n+2))).second)\n\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass min_cost_max_flow:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.potential = [0] * n\n        self.dist = [float('inf')] * n\n        self.back = [None] * n\n\n    def add_edge(self, src, dst, cap, cost):\n        self.adj[src].append({'dst': dst, 'rev': len(self.adj[dst]), 'flow': 0, 'cap': cap, 'cost': cost})\n        if src == dst:\n            self.adj[src][-1]['rev'] += 1\n        self.adj[dst].append({'dst': src, 'rev': len(self.adj[src]) - 1, 'flow': 0, 'cap': 0, 'cost': -cost})\n\n    def rcost(self, e):\n        return e['cost'] + self.potential[e['dst']] - self.potential[e['src']]\n\n    def dijkstra(self, source, sink):\n        self.dist = [float('inf')] * self.n\n        self.dist[source] = 0\n        pq = []\n        heapq.heappush(pq, (0, source))\n        while pq:\n            d, u = heapq.heappop(pq)\n            if self.dist[u] < d:\n                continue\n            if u == sink:\n                break\n            for e in self.adj[u]:\n                if e['flow'] < e['cap'] and self.dist[e['dst']] > self.dist[e['src']] + self.rcost(e):\n                    self.back[e['dst']] = e\n                    heapq.heappush(pq, (self.dist[e['dst']] = self.dist[e['src']] + self.rcost(e), e['dst']))\n        return self.dist[sink]\n\n    def max_flow(self, source, sink):\n        flow = 0\n        cost = 0\n        for u in range(self.n):\n            for e in self.adj[u]:\n                e['flow'] = 0\n        self.potential = [0] * self.n\n        self.dist = [float('inf')] * self.n\n        self.back = [None] * self.n\n        while self.dijkstra(source, sink) < float('inf'):\n            for u in range(self.n):\n                if self.dist[u] < self.dist[sink]:\n                    self.potential[u] += self.dist[u] - self.dist[sink]\n            f = float('inf')\n            for e in self.back[sink]:\n                f = min(f, e['cap'] - e['flow'])\n            for e in self.back[sink]:\n                e['flow'] += f\n                self.adj[e['dst']][e['rev']]['flow'] -= f\n            flow += f\n            cost += f * (self.potential[sink] - self.potential[source])\n        return flow, cost\n\ndef main():\n    n, m, k, c, d = map(int, input().split())\n    g = min_cost_max_flow((n+2)*102)\n    for i in range(102):\n        g.add_edge((i*(n+2))+1, i*(n+2), 100, i*c)\n    for i in range(101):\n        for j in range(n+1):\n            g.add_edge(j+(i*(n+2)), j+((i+1)*(n+2)), 100, 0)\n    for i in range(k):\n        u = int(input())\n        g.add_edge(n+1, u, 1, 0)\n    for i in range(m):\n        u, v = map(int, input().split())\n        for j in range(101):\n            for f in range(k):\n                g.add_edge(u+(j*(n+2)), v+((j+1)*(n+2)), 1, (2*f+1)*d)\n                g.add_edge(v+(j*(n+2)), u+((j+1)*(n+2)), 1, (2*f+1)*d)\n    print(g.max_flow(n+1, (101*(n+2)))[1])\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018821375851985067, -0.28198128938674927, -0.2780221104621887, -0.13592921197414398, -0.17432793974876404, -0.7278597354888916, -0.14037571847438812, -0.527222752571106, -0.20192702114582062, -1.1996212005615234, -0.0003935516288038343, -0.00022313489171210676, -8.546940807718784e-05, -0.0120483273640275, -0.00025996167096309364, -0.11330367624759674, -7.033100700937212e-05, -1.0728830375228426e-06, -1.4305104514278355e-06, -8.618460560683161e-05, -0.06278062611818314, -0.007507207803428173, -0.0033496483229100704, -1.5020257706055418e-05, -0.0003426679759286344, -0.007366281468421221, -7.807903602952138e-05, -0.0005546461907215416, -0.018912935629487038, -8.344646857949556e-07, -8.964136941358447e-05, -0.03788842633366585, -0.0002580548170953989, -0.004092651419341564, -0.00011669908417388797, -0.001931350794620812, -2.264974000354414e-06, -1.4305104514278355e-06, -0.006933794356882572, -0.08156310021877289, -0.0006653240998275578, -3.731181277544238e-05, -0.027339830994606018, -0.00017832119192462415, -0.0001528146385680884, -1.1444026313256472e-05, -0.0005726366653107107, -9.822363062994555e-05, -0.09749875962734222, -2.3841830625315197e-06, -0.007348176091909409, -0.001726209418848157, -3.814689989667386e-06, -6.079655122448457e-06, -0.006393454968929291, -4.088794958079234e-05, -0.0002755738