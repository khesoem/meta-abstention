urn 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom array import array\n\ndef lowbit(x):\n    return x & -x\n\ndef fpow(x, y):\n    res = 1\n    while y:\n        if y & 1:\n            res = (res * x) % mod\n        x = (x * x) % mod\n        y >>= 1\n    return res\n\ndef init():\n    fac[0] = 1\n    for i in range(1, n + 1):\n        fac[i] = (fac[i-1] * i) % mod\n    inv[n] = fpow(fac[n], mod - 2)\n    for i in range(n - 1, -1, -1):\n        inv[i] = (inv[i+1] * (i+1)) % mod\n\ndef dfs(x, s):\n    if dp[x][s] != -1:\n        return dp[x][s]\n    if s == 0:\n        res = (fac[n] * fac[k] % mod * inv[k - x]) % mod\n        dp[x][s] = res\n        return res\n    now = s - lowbit(s)\n    total = 0\n    t = now\n    while t:\n        total = (total + dfs(x + 1, t) * inv[s - t]) % mod\n        t = (t - 1) & now\n    total = (total + dfs(x + 1, 0) * inv[s]) % mod\n    dp[x][s] = total\n    return total\n\ndef main():\n    global n, k, mod, fac, inv, dp\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, mod = map(int, data[:3])\n    fac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    init()\n    dp = [array('i', [-1] * (n + 1)) for _ in range(27)]\n    ans = pow(k, n, mod)\n    if n % 2 == 0:\n        ans = (ans - dfs(0, n)) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-8.34461570775602e-06, -2.3841855067985307e-07, 0.0, -0.0005945583689026535, -0.0009327351581305265, 0.0, -3.516612196108326e-05, -0.00023934361524879932, -2.9802276912960224e-06, 0.0, 0.0, -8.010543388081715e-05, -0.0341528095304966, -0.0006717570940963924, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.04946541041135788, -5.722029527532868e-06, -2.5033637939486653e-05, -1.1920928244535389e-07, 0.0, -0.023245446383953094, 