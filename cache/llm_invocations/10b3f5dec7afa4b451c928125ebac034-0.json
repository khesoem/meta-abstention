\n            if n & 1:\n                r *= x\n            x *= x\n            n >>= 1\n        return r\n\n    def inv(self):\n        return self.pow(MOD - 2)\n\n    def __repr__(self):\n        return str(self.v)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    mat = [[Mint(0) for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            x = int(next(it))\n            mat[i][j] = Mint(x) / Mint(100)\n\n    sts_map = {(0,): Mint(1)}\n\n    for ph in range(n):\n        nsts_map = {}\n        for f in range(1, 1 << n):\n            freq = Mint(1)\n            for i in range(n):\n                if (f >> i) & 1:\n                    freq *= mat[ph][i]\n                else:\n                    freq *= Mint(1) - mat[ph][i]\n            for state, val in sts_map.items():\n                nst = []\n                for d in state:\n                    for i in range(n):\n                        if (d >> i) & 1:\n                            continue\n                        if not ((f >> i) & 1):\n                            continue\n                        nst.append(d ^ (1 << i))\n                if not nst:\n                    continue\n                nst.sort()\n                # deduplicate\n                uniq = []\n                for x in nst:\n                    if not uniq or uniq[-1] != x:\n                        uniq.append(x)\n                key = tuple(uniq)\n                nsts_map[key] = nsts_map.get(key, Mint(0)) + val * freq\n        sts_map = nsts_map\n\n    ans = Mint(0)\n    if sts_map:\n        min_key = min(sts_map.keys())\n        ans = sts_map[min_key]\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.002696055569686e-05, -3.576278118089249e-07, 0.0, -0.00045217780279926956, -0.0034420788288116455, 0.0, -0.04860799387097359,