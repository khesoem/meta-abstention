 count = 0;\n                    for (int i = 0; i < m; i++) {\n                        if (stateB[i] == 1) {\n                            stateB[i] = 2;\n                            count++;\n                        }\n                    }\n                    applyRules(stateB, stateA, m);\n                    int nextS = encode(stateB, m);\n                    nextDp[nextS] = Math.max(nextDp[nextS], dp[s] + m - count);\n                }\n            }\n            int[] temp = dp; dp = nextDp; nextDp = temp;\n        }\n        \n        int result = 0;\n        for (int s = 0; s < totalStates; s++) {\n            if (dp[s] <= result) continue;\n            decode(stateA, m, s, 3);\n            if (!hasZero(stateA, m)) result = dp[s];\n        }\n        System.out.println(result);\n    }\n\n    int encode(int[] arr, int len) {\n        int val = 0;\n        for (int i = 0; i < len; i++) val = val * 3 + arr[i];\n        return val;\n    }\n\n    void decode(int[] arr, int len, int val, int base) {\n        for (int i = len - 1; i >= 0; i--) {\n            arr[i] = val % base;\n            val /= base;\n        }\n    }\n\n    boolean hasZeroZero(int[] a, int[] b, int len) {\n        for (int i = 0; i < len; i++) if (a[i] == 0 && b[i] == 0) return true;\n        return false;\n    }\n\n    void applyRules(int[] b, int[] a, int len) {\n        for (int i = 0; i < len; i++) {\n            if (b[i] == 0 && (a[i] == 2 || (i > 0 && b[i-1] == 2) || (i+1 < len && b[i+1] == 2))) {\n                b[i] = 1;\n            }\n        }\n    }\n\n    boolean hasZero(int[] arr, int len) {\n        for (int i = 0; i < len; i++) if (arr[i] == 0) return true;\n        return false;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom typing import List\n\ndef main():\n    solution = CF111C_v3()\n    solution.solve()\n\nclass CF111C_v3:\n    def solve(self):\n        input = sys.stdin.read\n        data = input().split()\n        n = int(data[0])\n        m = int(data[1])\n        \n        if n < m:\n            n, m = m, n\n        \n        totalStates = 3 ** m\n        dp = [-1] * totalStates\n        nextDp = [-1] * totalStates\n        stateA = [1] * m\n        stateB = [0] * m\n        \n        dp[self.encode(stateA, m)] = 0\n        \n        for _ in range(n):\n            nextDp = [-1] * totalStates\n            for s in range(totalStates):\n                if dp[s] < 0:\n                    continue\n                self.decode(stateA, m, s, 3)\n                for mask in range(1 << m):\n                    self.decode(stateB, m, mask, 2)\n                    if self.hasZeroZero(stateA, stateB, m):\n                        continue\n                    \n                    count = 0\n                    for i in range(m):\n                        if stateB[i] == 1:\n                            stateB[i] = 2\n                            count += 1\n                    \n                    self.applyRules(stateB, stateA, m)\n                    nextS = self.encode(stateB, m)\n                    nextDp[nextS] = max(nextDp[nextS], dp[s] + m - count)\n            \n            dp, nextDp = nextDp, dp\n        \n        result = 0\n        for s in range(totalStates):\n            if dp[s] <= result:\n                continue\n            self.decode(stateA, m, s, 3)\n            if not self.hasZero(stateA, m):\n                result = dp[s]\n        \n        print(result)\n    \n    def encode(self, arr: List[int], length: int) -> int:\n        val = 0\n        for i in range(length):\n            val = val * 3 + arr[i]\n        return val\n    \n    def decode(self, arr: List[int], length: int, value: int, base: int) -> None:\n        for i in range(length - 1, -1, -1):\n            arr[i] = value % base\n            value //= base\n    \n    def hasZeroZero(self, a: List[int], b: List[int],