se": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    start_nodes = []\n    for _ in range(k):\n        start_nodes.append(int(data[idx]) - 1)\n        idx += 1\n    \n    adjacency = [[] for _ in range(n)]\n    for _ in range(m):\n        i = int(data[idx]) - 1; idx += 1\n        j = int(data[idx]) - 1; idx += 1\n        adjacency[i].append(j)\n        adjacency[j].append(i)\n    \n    t = n + k + 1\n    node_count = n * t + 1\n    \n    # Graph representation: for each node, list of (neighbor, capacity, cost, reverse_edge_index)\n    graph = [[] for _ in range(node_count)]\n    edge_list = []  # Store all edges for cost calculation\n    \n    def add_edge(u, v, capacity, cost):\n        # Forward edge\n        forward_idx = len(graph[u])\n        reverse_idx = len(graph[v])\n        graph[u].append([v, capacity, cost, reverse_idx])\n        # Backward edge\n        graph[v].append([u, 0, -cost, forward_idx])\n        edge_list.append((u, v, cost))\n    \n    # Build the time-expanded graph\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            for j in adjacency[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    add_edge(u, v, 1, c + (x * 2 - 1) * d)\n    \n    # Add edges for staying in place\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            cost = 0 if i == 0 else c\n            add_edge(u, v, k, cost)\n    \n    # Connect sink to start nodes\n    for h in range(k):\n        add_edge(node_count - 1, start_nodes[h] * t + 0, 1, 0)\n    \n    # Min cost max flow implementation\n    INF = 10**18\n    \n    def dijkstra(source, sink):\n        dist = [INF] * node_count\n        parent = [-1] * node_count\n        parent_edge_idx = [-1] * node_count\n        dist[source] = 0\n        heap = [(0, source)]\n        \n        while heap:\n            d, u = heapq.heappop(heap)\n            if d != dist[u]:\n                continue\n            if u == sink:\n                break\n            for idx, (v, capacity, cost, rev_idx) in enumerate(graph[u]):\n                if capacity > 0 and dist[v] > dist[u] + cost:\n                    dist[v] = dist[u] + cost\n                    parent[v] = u\n                    parent_edge_idx[v] = idx\n                    heapq.heappush(heap, (dist[v], v))\n        \n        return dist, parent, parent_edge_idx\n    \n    def min_cost_maxflow(source, sink):\n        total_flow = 0\n        total_cost = 0\n        \n        while True:\n            dist, parent, parent_edge_idx = dijkstra(source, sink)\n            if dist[sink] == INF:\n                break\n            \n            # Find the minimum capacity along the path\n            path_flow = INF\n            curr = sink\n            while curr != source:\n                prev = parent[curr]\n                edge_idx = parent_edge_idx[curr]\n                capacity = graph[prev][edge_idx][1]\n                path_flow = min(path_flow, capacity)\n                curr = prev\n            \n            # Update the flow\n            curr = sink\n            while curr != source:\n                prev = parent[curr]\n                edge_idx = parent_edge_idx[curr]\n                rev_idx = graph[prev][edge_idx][3]\n                \n                graph[prev][edge_idx][1] -= path_flow\n                graph[curr][rev_idx][1] += path_flow\n                \n                curr = prev\n            \n            total_flow += path_flow\n            total_cost += path_flow * dist[sink]\n        \n        return total_cost\n    \n    result = min_cost_maxflow(node_count - 1, 0 * t + t - 1)\n 