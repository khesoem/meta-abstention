routines\n  struct Edge { int v, r; ll f, c, p; };\n  vector<Edge> adj[N]; int sz[N]; ll mc;\n  void init(int n=N) { mc=0; fill(sz,sz+n,0); fill(adj,adj+n,vector<Edge>()); }\n  void add_edge(int a, int b, ll c=1, ll p=0) { mc = max(mc,c);\n    adj[a].push_back({b, sz[b]++, 0, c, p});\n    adj[b].push_back({a, sz[a]++, 0, 0, -p}); }  // change 0 to c for undirected\n\n  // Minimum cost maximum flow, assuming there are no negative cost cycles\n  // USAGE: 1) add edges 2) min_cost_flow(S, T, price, V, sparse?);\n  // use O(V^2) Dijkstra for dense graphs, and O(E*log(V)) otherwise\n  bool vis[N]; int par[N]; ll pot[N], dist[N];\n  void pot_init(int n) { fill(pot, pot+n, 0);\n    // if all edge costs >= 0, we don't need to run the Bellman-Ford here\n    for(int i=1; i<n; i++) for(int u=0; u<n; u++) for(const Edge& e:adj[u])\n      if(e.c) pot[e.v] = min(pot[e.v], pot[u] + e.p); }\n  ll mcf(int s, int t, ll& price, int n, bool sparse) {\n    fill(vis, vis+n, 0); fill(dist, dist+n, INF); dist[s] = 0;\n    // only need one of the branches below\n    if(sparse) { // replace priority_queue with queue for SPFA\n      priority_queue<pair<ll,int>> dk; dk.push({0,s}); while(!dk.empty()) {\n        int u = dk.top().second; dk.pop(); if(vis[u]) continue;\n        for(const Edge& e:adj[u]) {\n          if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r;\n            dk.push({-dist[e.v], e.v}); } } }\n    } else { // dense\n      for(int u = s; u != -1; ) { vis[u] = true; for(const Edge& e: adj[u]) {\n        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n          dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r; } }\n      u = -1; ll best = INF;\n      for(int i=0; i<n; i++) if(!vis[i] && dist[i]<best) best = dist[u=i]; }\n    } // end branches\n    if (dist[t] >= INF) { return 0; } ll df = INF;\n    for(int u = t; u != s; ) { const Edge& r = adj[u][par[u]];\n      df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f); u = r.v; }\n    for(int u = t; u != s; ) { Edge& r=adj[u][par[u]], &e=adj[r.v][r.r];\n      e.f += df; r.f -= df; price += df*e.p; u = r.v; }\n    for(int i=0; i<n; i++) { pot[i] = min(INF, dist[i]+pot[i]); } return df; }\n  ll min_cost_flow(int s, int t, ll& price, int n=N, bool sparse=false) {\n    //pot_init(n);\n\t\tll flow = price = 0;\n\t\twhile(ll df=mcf(s, t, price, n, sparse)) { flow += df; } return flow; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tll price, flow = Flow::min_cost_flow(source, sink, price, sink+1, true);\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass Flow:\n    # Constants\n    T = 99\n    C = 12\n    N = 50 * T + 2  # max nodes\n\n    def __init__(self):\n        self.adj = [[] for _ in range(self.N)]\n        self.sz = [0] * self.N\n        self.mc = 0\n        self.price = 0\n        # potentials and distances reused across calls\n        self.pot = [0] * self.N\n        self.dist = [0] * self.N\n        self.vis = [False] * self.N\n        self.par = [-1] * self.N\n\n    def add_edge(self, a, b, cap=1, cost=0):\n        # a, b are 0-indexed nodes\n        self.mc = max(self.mc, cap)\n        # forward edge: [to, rev, flow, cap, cost]\n        self.adj[a].append([b, len(self.adj[b]), 0, cap, cost])\n        # reverse edge: [to, rev, flow, cap, cost]\n        self.adj[b].append([a, len(self.adj[a]) - 1, 0, 0, -cost])\n\n    def mcf(self, s, t, n):\n        INF = 10**18\n        self.vis = [False] * n\n        self.dist = [INF] * n\n        self.dist[s] = 0\n        self.par = [-1] * n\n        pq = [(0, s)]\n        while pq:\n            d, u = heapq.heappop(pq)\n            if self.vis[u]:\n                continue\n            self.vis[u] = True\n            for e in self.adj[u]:\n                v = e[0]\n                if e[2] < e[3]:  # flow < cap\n                    nd = d + self.pot[u] - self.pot[v] + e[4]\n                    if nd < self.dist[v]:\n                        self.dist[v] = nd\n                        self.par[v] = e[1]  # index of reverse edge in adj[v]\n                        heapq.heappush(pq, (nd, v))\n        if self.dist[t] >= INF:\n            return 0\n        # find min residual capacity along path\n        df = INF\n        v = t\n        while v != s:\n            e_rev = self.adj[v][self.par[v]]  # reverse edge from v to parent\n            u = e_rev[0]\n            e_fwd = self.adj[u][e_rev[1]]   # forward edge from u to v\n            df = min(df, e_fwd[3] - e_fwd[2])\n            v = u\n        # update flows and cost\n        v = t\n        while v != s:\n            e_rev = self.adj[v][self.par[v]]\n            u = e_rev[0]\n            e_fwd = self.adj[u][e_rev[1]]\n            e_fwd[2] += df\n            e_rev[2] -= df\n            self.price += df * e_fwd[4]\n            v = u\n        # update potentials\n        for i in range(n):\n            if self.dist[i] < INF:\n                self.pot[i] = self.dist[i] + self.pot[i]\n            else:\n                self.pot[i] = INF\n        return df\n\n    def min_cost_flow(self, s, t, n, sparse=True):\n        # pot_init not needed because all costs >= 0\n        self.pot = [0] * n\n        flow = self.price = 0\n        while True:\n            df = self.mcf(s, t, n)\n            if df == 0:\n                break\n            flow += df\n        return flow\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    flow = Flow()\n    source = 0\n    sink = n * Flow.T + 1\n\n    # source to initial employees\n    for _ in range(k):\n        a = next(it)\n        flow.add_edge(source, a, 1, 0)\n\n    # sink connections and waiting edges\n    for t in range(Flow.T):\n        # node for building 1 at time t\n        flow.add_edge(1 + t * n, sink, 10**18, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow.add_edge(i + (t - 1) * n, i + t * n, 10**18, c)\n\n    # movement edges\n    for _ in range(m):\n        a = next(it)\n        b = next(it)\n        for j in range(Flow.C):\n            cost = (2 * j + 1) * d + c  # (j+1)^2 - j^2 = 2j+1, then * d + c\n            for t in range(1, Flow.T):  # t from 1 to T-1\n                flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost)\n                flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost)\n\n    total_flow = flow.min_cost_flow(source, sink, sink + 1, sparse=True)\n    # assert total_flow == k\n    print(flow.price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-9.775113539944869e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.0016465928638353944, -0.003211580915376544, -2.753696753643453e-05, -0.04859607294201851, -7.867782187531702e-06, -6.663577369181439e-05, -0.02330612577497959, -0.08406855911016464, -2.7894584491150454e-05, -2.81329957942