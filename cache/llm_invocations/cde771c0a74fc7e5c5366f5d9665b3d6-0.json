{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = 1e18;\n\nstruct Edge {\n    int u, v, cap, flow, cost;\n    Edge() {}\n    Edge(int u_, int v_, int cap_, int flow_, int cost_) \n        : u(u_), v(v_), cap(cap_), flow(flow_), cost(cost_) {}\n};\n\nvector<Edge> E;\nvector<int> G[1000007];\nll dis[1000007];\nint pre[1000007], preEdge[1000007];\nbool vis[1000007];\n\nint src = 1000005, dst = 1000006;\nll costSum = 0;\n\nint resCap(int idx) {\n    return E[idx].cap - E[idx].flow;\n}\n\nvoid shortestPath() {\n    fill(dis, dis + 1000007, INF);\n    fill(pre, pre + 1000007, -1);\n    fill(preEdge, preEdge + 1000007, -1);\n    fill(vis, vis + 1000007, false);\n    \n    dis[src] = 0;\n    queue<int> q;\n    q.push(src);\n    vis[src] = true;\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        vis[u] = false;\n        \n        for (int idx : G[u]) {\n            if (!resCap(idx)) continue;\n            int v = E[idx].u;\n            int w = E[idx].cost;\n            if (dis[v] > dis[u] + w) {\n                dis[v] = dis[u] + w;\n                pre[v] = u;\n                preEdge[v] = idx;\n                if (!vis[v]) {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n}\n\nvoid updateFlow() {\n    shortestPath();\n    if (dis[dst] >= INF) return;\n    \n    int cur = dst;\n    while (cur != src) {\n        int idx = preEdge[cur];\n        E[idx].flow++;\n        E[idx ^ 1].flow--;\n        cur = pre[cur];\n    }\n    costSum += dis[dst];\n}\n\nvoid connect(int u, int v, int cap, int cost) {\n    G[u].push_back(E.size());\n    E.emplace_back(u, v, cap, 0, cost);\n    G[v].push_back(E.size());\n    E.emplace_back(v, u, 0, 0, -cost);\n}\n\nint n, m, k, c, d;\nconst int T_LAYERS = 101;\n\nvoid setup() {\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    \n    for (int i = 0; i < k; ++i) {\n        int x; scanf(\"%d\", &x); --x;\n        connect(src, x, 1, 0);\n    }\n    \n    for (int t = 0; t < T_LAYERS; ++t) {\n        connect(t * n, dst, k, t * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int u, v; scanf(\"%d %d\", &u, &v); --u, --v;\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                connect(u + t * n, v + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                connect(v + t * n, u + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n    }\n}\n\nvoid compute() {\n    for (int t = 0; t < T_LAYERS - 1; ++t) {\n        for (int i = 0; i < n; ++i) {\n            connect(i + t * n, i + (t + 1) * n, k, 0);\n        }\n    }\n    \n    for (int i = 0; i < k; ++i) {\n        updateFlow();\n    }\n    \n    printf(\"%lld\\n\", costSum);\n}\n\nint main() {\n    setup();\n    compute();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\nclass Edge:\n    def __init__(self, u, v, cap, flow, cost):\n        self.u = u\n        self.v = v\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nE = []\nG = [[] for _ in range(1000007)]\ndis = [INF] * 1000007\npre = [-1] * 1000007\npreEdge = [-1] * 1000007\nvis = [False] * 1000007\n\nsrc = 1000005\ndst = 1000006\ncostSum = 0\n\ndef resCap(idx):\n    return E[idx].cap - E[idx].flow\n\ndef shortestPath():\n    global dis, pre, preEdge, vis\n    dis = [INF] * 1000007\n    pre = [-1] * 1000007\n    preEdge = [-1] * 1000007\n    vis = [False] * 1000007\n    \n    dis[src] = 0\n    q = deque()\n    q.append(src)\n    vis[src] = True\n    \n    while q:\n        u = q.popleft()\n        vis[u] = False\n        \n        for idx in G[u]:\n            if not resCap(idx):\n                continue\n            v = E[idx].u\n            w = E[idx].cost\n            if dis[v] > dis[u] + w:\n                dis[v] = dis[u] + w\n                pre[v] = u\n                preEdge[v] = idx\n                if not vis[v]:\n                    vis[v] = True\n                    q.append(v)\n\ndef updateFlow():\n    global costSum\n    shortestPath()\n    if dis[dst] >= INF:\n        return\n    \n    cur = dst\n    while cur != src:\n        idx = preEdge[cur]\n        E[idx].flow += 1\n        E[idx ^ 1].flow -= 1\n        cur = pre[cur]\n    costSum += dis[dst]\n\ndef connect(u, v, cap, cost):\n    G[u].append(len(E))\n    E.append(Edge(u, v, cap, 0, cost))\n    G[v].append(len(E))\n    E.append(Edge(v, u, 0, 0, -cost))\n\ndef main():\n    global n, m, k, c, d\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    T_LAYERS = 101\n    \n    for i in range(k):\n        x = int(input_data[idx]); idx += 1\n        x -= 1\n        connect(src, x, 1, 0)\n    \n    for t in range(T_LAYERS):\n        connect(t * n, dst, k, t * c)\n    \n    for i in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        u -= 1\n        v -= 1\n        for t in range(T_LAYERS - 1):\n            for j in range(k):\n                connect(u + t * n, v + (t + 1) * n, 1, d * (2 * j + 1))\n        for t in range(T_LAYERS - 1):\n            for j in range(k):\n                connect(v + t * n, u + (t + 1) * n, 1, d * (2 * j + 1))\n    \n    for t in range(T_LAYERS - 1):\n        for i in range(n):\n            connect(i + t * n, i + (t + 1) * n, k, 0)\n    \n    for i in range(k):\n        updateFlow()\n    \n    print(costSum)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021669900161214173, -7.152555099310121e-07, -2.3841855067985307e-07, -0.014616905711591244, -0.0038231154903769493, -7.152555099310121e-07, -0.00010108436981681734, -0.0003673355677165091, -1.9073468138230965e-06, -0.00033909291960299015, -0.00032360086333937943, -0.2933252453804016, -5.960462772236497e-07, -0.012562546879053116, -3.576278118089249e-07, -6.0794889577664435e-05, -4.0411134250462055e-05, 0.0, 0.0, -0.006718901451677084, -0.003787488443776965, -1.1324817933200393e-05, -1.1920928244535389e-07, -3.576278118089249e-07, -0.023245912045240402, 0.0, -4.887569048150908e-06, -1.1920928244535389e-07, -2.622600959512056e-06, -4.768370445162873e-07, -5.960462772236497e-07, -0.00017105070583056659, -1.1920928244535389e-07, 0.0, -5.364403477869928e-06, -1.1920928244535389e-07, -4.291525328881107e-06, -1.9073468138230965e-06, -1.0728830375228426e-06, -2.7418097943154862e-06, -5.245195097813848e-06, -1.1920928244535389e-07, -1.311301275563892e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -9.536738616588991e-07, 0.0, -3.576278118