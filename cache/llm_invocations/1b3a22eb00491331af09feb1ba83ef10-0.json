{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nconst int N = 1000000;\nint cnt[N+2], src, snk;\nvector<int> g[N+2];\nconst int INF = 1e9;\n\nvector<int> a, b, f, c, d;\nvector<vector<int>> adj;\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    int id = a.size();\n    a.push_back(u); b.push_back(v); f.push_back(0); c.push_back(cap); d.push_back(cost);\n    adj[u].push_back(id);\n    a.push_back(v); b.push_back(u); f.push_back(0); c.push_back(0); d.push_back(-cost);\n    adj[v].push_back(id+1);\n}\n\nint dist[N+2], inq[N+2], mnf[N+2], pth[N+2];\npair<int,int> spfa(int n) {\n    for (int i=0;i<=n;++i) dist[i]=INF;\n    queue<int> q; q.push(src);\n    dist[src]=0; inq[src]=1; mnf[src]=INF;\n    while (!q.empty()) {\n        int u=q.front(); q.pop(); inq[u]=0;\n        for (int id : adj[u]) {\n            int v = b[id];\n            if (c[id] > f[id] && dist[v] > dist[u] + d[id]) {\n                dist[v] = dist[u] + d[id];\n                pth[v] = id;\n                mnf[v] = min(mnf[u], c[id] - f[id]);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v]=1;\n                }\n            }\n        }\n    }\n    if (dist[snk]==INF) return {0,0};\n    int v = snk;\n    while (v != src) {\n        int id = pth[v];\n        f[id] += mnf[snk];\n        f[id^1] -= mnf[snk];\n        v = a[id];\n    }\n    return {mnf[snk], dist[snk]*mnf[snk]};\n}\npair<int,int> mcmf(int n) {\n    int flow=0, cost=0;\n    while (true) {\n        auto p = spfa(n);\n        if (!p.first) return {flow,cost};\n        flow += p.first;\n        cost += p.second;\n    }\n}\n\nint main() {\n    ios_base::sync_with_stdio(0); cin.tie(0);\n    int n, m, k, cst, dst; cin >> n >> m >> k >> cst >> dst;\n    for (int i=1;i<=k;++i) {\n        int x; cin >> x; cnt[x]++;\n    }\n    for (int i=1;i<=m;++i) {\n        int u,v; cin >> u >> v;\n        g[u].push_back(v);\n        g[v].push_back(u);\n    }\n    src = 0; snk = 100*n + n + 1;\n    adj.resize(snk+1);\n    for (int tm=0; tm<=99; ++tm) {\n        for (int i=1;i<=n;++i) {\n            addEdge(n*tm+i, n*(tm+1)+i, k, 0);\n            for (int x : g[i]) {\n                for (int cp=1; cp<=k; ++cp) {\n                    addEdge(n*tm+i, n*(tm+1)+x, 1, dst*(2*cp-1));\n                }\n            }\n        }\n    }\n    for (int i=1;i<=n;++i)\n        if (cnt[i]) addEdge(src, i, cnt[i], 0);\n    for (int tm=0; tm<=100; ++tm)\n        addEdge(n*tm+1, snk, k, cst*tm);\n    cout << mcmf(snk).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static BufferedReader br;\n    static StringTokenizer st;\n\n    static int nextInt() throws IOException {\n        while (st == null || !st.hasMoreTokens()) {\n            st = new StringTokenizer(br.readLine());\n        }\n        return Integer.parseInt(st.nextToken());\n    }\n\n    static ArrayList<Integer> a, b, f, c, d;\n    static ArrayList<ArrayList<Integer>> adj;\n    static int[] dist, inq, mnf, pth;\n    static int src, snk;\n    static final int INF = 1000000000;\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        int id = a.size();\n        a.add(u);\n        b.add(v);\n        f.add(0);\n        c.add(cap);\n        d.add(cost);\n        adj.get(u).add(id);\n        a.add(v);\n        b.add(u);\n        f.add(0);\n        c.add(0);\n        d.add(-cost);\n        adj.get(v).add(id + 1);\n    }\n\n    static int[] spfa(int n) {\n        Arrays.fill(dist, 0, n + 1, INF);\n        Arrays.fill(inq, 0, n + 1, 0);\n        Arrays.fill(mnf, 0, n + 1, 0);\n        Arrays.fill(pth, 0, n + 1, 0);\n        Deque<Integer> q = new ArrayDeque<>();\n        q.addLast(src);\n        dist[src] = 0;\n        inq[src] = 1;\n        mnf[src] = INF;\n        while (!q.isEmpty()) {\n            int u = q.pollFirst();\n            inq[u] = 0;\n            for (int id : adj.get(u)) {\n                int v = b.get(id);\n                if (c.get(id) > f.get(id) && dist[v] > dist[u] + d.get(id)) {\n                    dist[v] = dist[u] + d.get(id);\n                    pth[v] = id;\n                    mnf[v] = Math.min(mnf[u], c.get(id) - f.get(id));\n                    if (inq[v] == 0) {\n                        q.addLast(v);\n                        inq[v] = 1;\n                    }\n                }\n            }\n        }\n        if (dist[snk] == INF) return new int[]{0, 0};\n        int v = snk;\n        while (v != src) {\n            int id = pth[v];\n            f.set(id, f.get(id) + mnf[snk]);\n            f.set(id ^ 1, f.get(id ^ 1) - mnf[snk]);\n            v = a.get(id);\n        }\n        return new int[]{mnf[snk], dist[snk] * mnf[snk]};\n    }\n\n    static int[] mcmf(int n) {\n        int flow = 0, cost = 0;\n        while (true) {\n            int[] p = spfa(n);\n            if (p[0] == 0) return new int[]{flow, cost};\n            flow += p[0];\n            cost += p[1];\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n\n        int n = nextInt();\n        int m = nextInt();\n        int k = nextInt();\n        int cst = nextInt();\n        int dst = nextInt();\n\n        int[] cnt = new int[n + 2];\n        for (int i = 1; i <= k; i++) {\n            int x = nextInt();\n            cnt[x]++;\n        }\n\n        ArrayList<ArrayList<Integer>> g = new ArrayList<>(n + 1);\n        for (int i = 0; i <= n; i++) g.add(new ArrayList<>());\n        for (int i = 1; i <= m; i++) {\n            int u = nextInt();\n            int v = nextInt();\n            g.get(u).add(v);\n            g.get(v).add(u);\n        }\n\n        src = 0;\n        snk = 100 * n + n + 1;\n\n        a = new ArrayList<>();\n        b = new ArrayList<>();\n        f = new ArrayList<>();\n        c = new ArrayList<>();\n        d = new ArrayList<>();\n        adj = new ArrayList<>(snk + 1);\n        for (int i = 0; i <= snk; i++) adj.add(new ArrayList<>());\n\n        dist = new int[snk + 1];\n        inq = new int[snk + 1];\n        mnf = new int[snk + 1];\n        pth = new int[snk + 1];\n\n        for (int tm = 0; tm <= 99; tm++) {\n            for (int i = 1; i <= n; i++) {\n                addEdge(n * tm + i, n * (tm + 1) + i, k, 0);\n                for (int x : g.get(i)) {\n                    for (int cp = 1; cp <= k; cp++) {\n                        addEdge(n * tm + i, n * (tm + 1) + x, 1, dst * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            if (cnt[i] > 0) addEdge(src, i, cnt[i], 0);\n        }\n        for (int tm = 0; tm <= 100; tm++) {\n            addEdge(n * tm + 1, snk, k, cst * tm);\n        }\n\n        int[] res = mcmf(snk);\n        pw.println(res[1]);\n        pw.close();\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.0007241725688800216, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -9.119095193454996e-05, -0.011808495037257671, -1.1920928244535389e-07, -3.540453326422721e-05, -1.823885577323381e-05, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.0503786799963564e-05, -8.344646857949556e-07, 0.0, -1.0728830375228426e-06, -3.71926071238704e-05, -2.47952248173533e-05, -4.6491513785440475e-06, -3.576278118089249e-07, 0.0, -4.172316494077677e-06, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, -1.1920922133867862e-06, -0.0007110689766705036, -1.1920928244535389e-07, -1.2159273865108844e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, 0.0, -1.5497195136049413e-06, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.152555099310121e-07, 0.0, -7.152555099310121e-07, -2.264974000354414e-06, -0.0011705459328368306, -1.3232143828645349e-05, -3.576278118089249e-07, -0.00020430385484360158, 0.0, 0.0, 0.0, -4.768370445162873e-07, 0.0, -2.0265558760002023e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -2.0265558760002023e-06, 0.0, -7.152555099310121e-07, -1.490105023549404e-05, -4.0531076592742465e-06, -2.3841855067985307e-07, 0.0, -4.053033626405522e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.9802276912960224e-06, -1.1920928244535389e-07, -4.529942543740617e-06, -3.576278118089249e-07, -5.960462772236497e-07, -5.722029527532868e-06, 0.0, 0.0, -7.152555099310121e-07, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -4.768370445162873e-07, -2.0265558760002023e-06, -5.960462772236497e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -4.768370445162873e-07, -1.1920928244