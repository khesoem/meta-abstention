{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        new Main().run();\n    }\n\n    void run() {\n        try (BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n             PrintWriter pw = new PrintWriter(System.out)) {\n            int n = Integer.parseInt(br.readLine().trim());\n            Circle[] circles = new Circle[n];\n            for (int i = 0; i < n; i++) {\n                String[] parts = br.readLine().split(\"\\\\s+\");\n                int x = Integer.parseInt(parts[0]);\n                int y = Integer.parseInt(parts[1]);\n                int r = Integer.parseInt(parts[2]);\n                circles[i] = new Circle(x, y, r);\n            }\n\n            Set<Point> all = new TreeSet<>();\n            for (int i = 0; i < n; i++) {\n                for (int j = i + 1; j < n; j++) {\n                    List<Point> inter = intersect(circles[i], circles[j]);\n                    if (inter != null) all.addAll(inter);\n                }\n            }\n\n            Map<Point, Integer> pointId = new HashMap<>();\n            List<Set<Integer>> adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                List<Double> angles = new ArrayList<>();\n                final int K = 100;\n                for (int j = 0; j < K; j++) {\n                    angles.add(Math.PI * 2 * j / K);\n                }\n                for (Point p : all) {\n                    if (circles[i].contains(p)) {\n                        double dx = p.x - circles[i].x;\n                        double dy = p.y - circles[i].y;\n                        double alpha = Math.atan2(dy, dx);\n                        if (alpha < 0) alpha += 2 * Math.PI;\n                        angles.add(alpha);\n                    }\n                }\n                Collections.sort(angles);\n                Point dir = new Point(circles[i].r, 0);\n                Double[] as = new TreeSet<>(angles).toArray(new Double[0]);\n                for (int j = 0; j < as.length; j++) {\n                    Point p = circles[i].center().add(dir.rotate(as[j]));\n                    getId(p, pointId, adj);\n                }\n                for (int j = 0; j < as.length; j++) {\n                    Point p = circles[i].center().add(dir.rotate(as[j]));\n                    Point q = circles[i].center().add(dir.rotate(as[(j + 1) % as.length]));\n                    int u = pointId.get(p);\n                    int v = pointId.get(q);\n                    if (u != v) {\n                        adj.get(u).add(v);\n                        adj.get(v).add(u);\n                    }\n                }\n            }\n\n            int v = adj.size();\n            int e = 0;\n            for (Set<Integer> s : adj) e += s.size();\n            e /= 2;\n\n            int comps = 0;\n            boolean[] was = new boolean[v];\n            for (int i = 0; i < v; i++) {\n                if (!was[i]) {\n                    ++comps;\n                    dfs(i, was, adj);\n                }\n            }\n\n            pw.println(1 + comps + e - v);\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n\n    private void dfs(int i, boolean[] was, List<Set<Integer>> adj) {\n        was[i] = true;\n        for (int j : adj.get(i)) {\n            if (!was[j]) dfs(j, was, adj);\n        }\n    }\n\n    private void getId(Point p, Map<Point, Integer> pointId, List<Set<Integer>> adj) {\n        if (!pointId.containsKey(p)) {\n            int sz = pointId.size();\n            pointId.put(p, sz);\n            adj.add(new TreeSet<>());\n        }\n    }\n\n    private List<Point> intersect(Circle c1, Circle c2) {\n        double dx = c1.x - c2.x;\n        double dy = c1.y - c2.y;\n        double d = Math.sqrt(dx * dx + dy * dy);\n        double cos = (c1.r * c1.r + d * d - c2.r * c2.r) / (2 * c1.r * d);\n        if (cos < -1 - 1e-8 || cos > 1 + 1e-8) return null;\n        if (cos < -1) cos = -1;\n        if (cos > 1) cos = 1;\n        List<Point> res = new ArrayList<>();\n        double alpha = Math.acos(cos);\n        Point dir = new Point(c2.x - c1.x, c2.y - c1.y).norm();\n        res.add(c1.center().add(dir.scale(c1.r).rotate(alpha)));\n        res.add(c1.center().add(dir.scale(c1.r).rotate(-alpha)));\n        return res;\n    }\n\n    static class Point implements Comparable<Point> {\n        double x, y;\n        static final double eps = 1e-8;\n\n        Point(double x, double y) {\n            this.x = x;\n            this.y = y;\n        }\n\n        Point add(Point o) {\n            return new Point(x + o.x, y + o.y);\n        }\n\n        Point sub(Point o) {\n            return new Point(x - o.x, y - o.y);\n        }\n\n        Point rotate(double alpha) {\n            double c = Math.cos(alpha), s = Math.sin(alpha);\n            return new Point(x * c - y * s, x * s + y * c);\n        }\n\n        Point norm() {\n            double len = length();\n            return scale(1.0 / len);\n        }\n\n        Point scale(double f) {\n            return new Point(f * x, f * y);\n        }\n\n        double length() {\n            return Math.sqrt(x * x + y * y);\n        }\n\n        public String toString() {\n            return String.format(\"%.6f %.6f\", x, y);\n        }\n\n        public boolean equals(Object obj) {\n            Point o = (Point) obj;\n            return Math.abs(x - o.x) < eps && Math.abs(y - o.y) < eps;\n        }\n\n        public int compareTo(Point o) {\n            if (Math.abs(x - o.x) > eps) return x < o.x ? -1 : 1;\n            if (Math.abs(y - o.y) > eps) return y < o.y ? -1 : 1;\n            return 0;\n        }\n\n        public int hashCode() {\n            return (int) ((Long.rotateLeft((long) (x / eps), 32) ^ (long) (y / eps)) & 0xFFFFFFFFL);\n        }\n    }\n\n    static class Circle {\n        int x, y, r;\n\n        Circle(int x, int y, int r) {\n            this.x = x;\n            this.y = y;\n            this.r = r;\n        }\n\n        Point center() {\n            return new Point(x, y);\n        }\n\n        boolean contains(Point p) {\n            double dist = p.sub(center()).length();\n            return Math.abs(dist - r) < 1e-8;\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nfrom collections import defaultdict\n\nclass Point:\n    eps = 1e-8\n\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n\n    def add(self, o):\n        return Point(self.x + o.x, self.y + o.y)\n\n    def sub(self, o):\n        return Point(self.x - o.x, self.y - o.y)\n\n    def rotate(self, alpha):\n        c = math.cos(alpha)\n        s = math.sin(alpha)\n        return Point(self.x * c - self.y * s, self.x * s + self.y * c)\n\n    def norm(self):\n        length = self.length()\n        return self.scale(1.0 / length)\n\n    def scale(self, f):\n        return Point(f * self.x, f * self.y)\n\n    def length(self):\n        return math.sqrt(self.x * self.x + self.y * self.y)\n\n    def __str__(self):\n        return f\"{self.x:.6f} {self.y:.6f}\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Point):\n            return False\n        return abs(self.x - other.x) < self.eps and abs(self.y - other.y) < self.eps\n\n    def __lt__(self, other):\n        if abs(self.x - other.x) > self.eps:\n            return self.x < other.x\n        if abs(self.y - other.y) > self.eps:\n            return self.y < other.y\n        return False\n\n    def __hash__(self):\n        return hash((round(self.x / self.eps), round(self.y / self.eps)))\n\nclass Circle:\n    def __init__(self, x, y, r):\n        self.x = x\n        self.y = y\n        self.r = r\n\n    def center(self):\n        return Point(self.x, self.y)\n\n    def contains(self, p):\n        dist = p.sub(self.center()).length()\n        return abs(dist - self.r) < 1e-8\n\ndef intersect(c1, c2):\n    dx = c1.x - c2.x\n    dy = c1.y - c2.y\n    d = math.sqrt(dx * dx + dy * dy)\n    if d == 0:\n        return None\n    cos = (c1.r * c1.r + d * d - c2.r * c2.r) / (2 * c1.r * d)\n    if cos < -1 - 1e-8 or cos > 1 + 1e-8:\n        return None\n    if cos < -1:\n        cos = -1\n    if cos > 1:\n        cos = 1\n    res = []\n    alpha = math.acos(cos)\n    dir_vec = Point(c2.x - c1.x, c2.y - c1.y).norm()\n    res.append(c1.center().add(dir_vec.scale(c1.r).rotate(alpha)))\n    res.append(c1.center().add(dir_vec.scale(c1.r).rotate(-alpha)))\n    return res\n\ndef dfs(i, was, adj):\n    was[i] = True\n    for j in adj[i]:\n        if not was[j]:\n            dfs(j, was, adj)\n\ndef main():\n    input_data = sys.stdin.read().splitlines()\n    if not input_data:\n        return\n    \n    n = int(input_data[0].strip())\n    circles = []\n    for i in range(1, n + 1):\n        parts = input_data[i].split()\n        x = int(parts[0])\n        y = int(parts[1])\n        r = int(parts[2])\n        circles.append(Circle(x, y, r))\n\n    all_points = set()\n    for i in range(n):\n        for j in range(i + 1, n):\n            inter = intersect(circles[i], circles[j])\n            if inter:\n                for p in inter:\n                    all_points.add(p)\n\n    point_id = {}\n    adj = []\n\n    def get_id(p):\n        if p not in point_id:\n            sz = len(point_id)\n            point_id[p] = sz\n            adj.append(set())\n        return point_id[p]\n\n    for i in range(n):\n        angles = []\n        K = 100\n        for j in range(K):\n            angles.append(math.pi * 2 * j / K)\n        \n        for p in all_points:\n            if circles[i].contains(p):\n                dx = p.x - circles[i].x\n                dy = p.y - circles[i].y\n                alpha = math.atan2(dy, dx)\n                if alpha < 0:\n                    alpha += 2 * math.pi\n                angles.append(alpha)\n        \n        angles = sorted(set(angles))\n        dir_vec = Point(circles[i].r, 0)\n        \n        for j in range(len(angles)):\n            p = circles[i].center().add(dir_vec.rotate(angles[j]))\n            get_id(p)\n        \n        for j in range(len(angles)):\n            p = circles[i].center().add(dir_vec.rotate(angles[j]))\n            q = circles[i].center().add(dir_vec.rotate(angles[(j + 1) % len(angles)]))\n            u = point_id[p]\n            v = point_id[q]\n            if u != v:\n                adj[u].add(v)\n                adj[v].add(u)\n\n    v = len(adj)\n    e = sum(len(s) for s in adj) // 2\n\n    comps = 0\n    was = [False] * v\n    for i in range(v):\n        if not was[i]:\n            comps += 1\n            dfs(i, was, adj)\n\n    result = 1 + comps + e - v\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.758938252460212e-05, -8.344646857949556e-07, -3.576278118089249e-07, -0.00038818930624984205, -0.2569844424724579, -1.192