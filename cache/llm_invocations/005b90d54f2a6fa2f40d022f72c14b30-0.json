nt dfsPath(int x0, int y0, int x1, int y1, int step){\n\tif(step > T)return 0;\n\tint &res = memo[x0][y0][x1][y1][step];\n\tif(res != -1)return res;\n\tif(x0 == x1 && y0 == y1)return distance[x0][y0] >= step;\n\tif(distance[x0][y0] <= step)return res = 0;\n\tfor(int k = 0; k < 4; k++){\n\t\tint nx = x0 + dX[k];\n\t\tint ny = y0 + dY[k];\n\t\tif(isValid(nx, ny) && dfsPath(nx, ny, x1, y1, step + 1))return res = 1;\n\t}\n\treturn res = 0;\n}\n\nbool bfs(int source, int sink){\n\tmemset(parent, -1, sizeof(parent));\n\tparent[source] = -2;\n\tqueue<int> q;\n\tq.push(source);\n\twhile(!q.empty()){\n\t\tint v = q.front(); q.pop();\n\t\tfor(int i = source; i <= sink; i++){\n\t\t\tif(parent[i] == -1 && capacity[v][i] > 0){\n\t\t\t\tparent[i] = v;\n\t\t\t\tq.push(i);\n\t\t\t}\n\t\t}\n\t}\n\treturn parent[sink] != -1;\n}\n\nint main(){\n\tios::sync_with_stdio(false);\n\tcin.tie(nullptr);\n\tcout<<fixed<<setprecision(32);\n\n\tcin>>N>>T;\n\tfor(int i = 0; i < N; i++){\n\t\tcin>>gridSci[i];\n\t}\n\tfor(int i = 0; i < N; i++){\n\t\tcin>>gridLab[i];\n\t}\n\tvector<pair<int, int>> positions;\n\tvector<int> labCap, sciCap;\n\tfor(int i = 0; i < N; i++){\n\t\tfor(int j = 0; j < N; j++){\n\t\t\tif(gridSci[i][j] == 'Z'){\n\t\t\t\tsrcX = i;\n\t\t\t\tsrcY = j;\n\t\t\t}else if('0' <= gridSci[i][j] && gridSci[i][j] <= '9'){\n\t\t\t\tpositions.emplace_back(i, j);\n\t\t\t\tlabCap.push_back(gridLab[i][j] - '0');\n\t\t\t\tsciCap.push_back(gridSci[i][j] - '0');\n\t\t\t}\n\t\t}\n\t}\n\tint M = positions.size();\n\tmemset(capacity, 0, sizeof(capacity));\n\tfor(int i = 0; i < M; i++){\n\t\tcapacity[0][i + 1] = sciCap[i];\n\t\tcapacity[M + 1 + i][2*M + 1] = labCap[i];\n\t}\n\tbfsPrecompute();\n\tmemset(memo, -1, sizeof(memo));\n\tfor(int i = 0; i < M; i++){\n\t\tfor(int j = 0; j < M; j++){\n\t\t\tif(dfsPath(positions[i].first, positions[i].second, positions[j].first, positions[j].second, 0)){\n\t\t\t\tcapacity[i + 1][M + 1 + j] = 1000;\n\t\t\t}\n\t\t}\n\t}\n\tint maxFlow = 0;\n\twhile(bfs(0, 2*M + 