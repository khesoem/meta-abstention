          distance[nx][ny] = distance[x][y] + 1\n                    visited[nx][ny] = 1\n                    qx.append(nx)\n                    qy.append(ny)\n    \n    # Collect positions and capacities\n    positions = []\n    labCap = []\n    sciCap = []\n    \n    for i in range(N):\n        for j in range(N):\n            if '0' <= gridSci[i][j] <= '9':\n                positions.append((i, j))\n                labCap.append(int(gridLab[i][j]))\n                sciCap.append(int(gridSci[i][j]))\n    \n    M = len(positions)\n    \n    # Initialize capacity matrix\n    capacity = [[0] * (2 * M + 2) for _ in range(2 * M + 2)]\n    \n    for i in range(M):\n        capacity[0][i + 1] = sciCap[i]\n        capacity[M + 1 + i][2 * M + 1] = labCap[i]\n    \n    # Memoization for dfsPath\n    memo = [[[[[-1] * (T + 1) for _ in range(M)] for _ in range(M)] for _ in range(M)] for _ in range(M)]\n    \n    def dfsPath(x0, y0, x1, y1, step):\n        if step > T:\n            return 0\n        if memo[x0][y0][x1][y1][step] != -1:\n            return memo[x0][y0][x1][y1][step]\n        \n        if x0 == x1 and y0 == y1:\n            result = 1 if distance[x0][y0] >= step else 0\n            memo[x0][y0][x1][y1][step] = result\n            return result\n        \n        if distance[x0][y0] <= step:\n            memo[x0][y0][x1][y1][step] = 0\n            return 0\n        \n        for k in range(4):\n            nx, ny = x0 + dX[k], y0 + dY[k]\n            if isValid(nx, ny) and dfsPath(nx, ny, x1, y1, step + 1):\n                memo[x0][y0][x1][y1][step] = 1\n                return 1\n        \n        memo[x0][y0][x1][y1][step] = 0\n        return 0\n    \n    # Fill capacity for paths\n    for i in range(M):\n        for j in range(M):\n            if dfsPath(positions[i][0], positions[i][1], positions[j][0], positions[j][1], 0):\n                capacity[i + 1][M + 1 + j] = 1000\n    \n    # Ford-Fulkerson BFS for max flow\n    def bfs(source, sink):\n        parent = [-1] * (2 * M + 2)\n        parent[source] = -2\n        q = deque()\n        q.append(source)\n        \n        while q:\n            v = q.popleft()\n            for i in range(2 * M + 2):\n                if parent[i] == -1 and capacity[v][i] > 0:\n                    parent[i] = v\n                    q.append(i)\n        \n        return parent[sink] != -1\n    \n    maxFlow = 0\n    while bfs(0, 2 * M + 1):\n        sink = 2 * M + 1\n        bottleneck = 10**6\n        path = []\n        while sink != 0:\n            path.append((parent[sink], sink))\n            bottleneck = min(bottleneck, capacity[parent[sink]][sink])\n            sink = parent[sink]\n        \n        sink = 2 * M + 1\n        while sink != 0:\n            capacity[parent[sink]][sink] -= bottleneck\n            capacity[sink][parent[sink]] += bottleneck\n            sink = parent[sink]\n        \n        maxFlow += bottleneck\n    \n    print(maxFlow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00025507534155622125, -9.536738616588991e-07, -2.3841855067985307e-07, -0.03406570851802826, -0.0032486540731042624, -4.768370445162873e-07, -0.0006288696313276887, -0.00034981805947609246, -1.7881377516459906e-06, -5.721882189391181e-05, -0.11296726763248444, -0.010797174647450447, -0.000816012208815664, -3.576278118089249e-07, -9.536738616588991e-07, -0.008174415677785873, -0.018479913473129272, -9.298280929215252e-06, -7.188061863416806e-05, -0.007542820647358894, -0.001858056872151792, -2.7418097943154862e-06, -0.00017188502533826977, -1.1920928244535389e-07, -2.3364747903542593e-05, -3.2186455882765586e-06, -0.00043883229955099523, -0.13316024839878082, -3.099436753473128e-06, -0.08894228935241699, -4.768370445162873e-07, -0.2923102378845215, -1.2993727978027891e-05, -1.1920922133867862e-06, -5.090107151772827e-05, -2.3841855067985307e-07, -0.03805415332317352, -4.386805812828243e-05, -1.1920922133867862e-06, -0