   if (dist != d[u]) continue;\n\n                for (int i = 0; i < (int)g[u].size(); ++i) {\n                    Edge &e = g[u][i];\n                    int v = e.to;\n\n                    if (e.cap <= e.f) continue;\n\n                    tc nd = d[u] + e.cost + phi[u] - phi[v];\n                    if (d[v] > nd) {\n                        d[v] = nd;\n                        pq.emplace(nd, v);\n                        pv[v] = u;\n                        pe[v] = i;\n                        f[v] = min(f[u], e.cap - e.f);\n                    }\n                }\n            }\n\n            if (d[t] == INF) break;\n\n            for (int i = 0; i < nodeCount; ++i)\n                phi[i] += d[i];\n\n            tf df = min(f[t], INF - totalFlow);\n            totalFlow += df;\n\n            for (int v = t; v != s; v = pv[v]) {\n                Edge &e = g[pv[v]][pe[v]];\n                e.f += df;\n                g[v][e.rev].f -= df;\n                totalCost += df * e.cost;\n            }\n        }\n\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int T = 150;\n    int N = n * T;\n    FlowNetwork network(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            network.addEdge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        network.addEdge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        network.addEdge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n\n        for (int j = 0; j < T - 1; ++j) {\n            int mult = 1;\n            for (int _ = 0; _ < k; ++_) {\n                network.addEdge(x * T + j, y * T + j + 1, 1, mult * d + c);\n                network.addEdge(y 