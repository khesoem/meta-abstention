ontinue;\n        for (int k = 0; k < 4; ++k) {\n            int nr = u.r + dr[k], nc = u.c + dc[k];\n            if (B[nr][nc] != '.') continue;\n            int ni = ID(nr, nc);\n            if (D2[ni] != -1) continue;\n            if (D1[ni] >= 0 && D1[ni] < D2[ui] + 1) continue;\n            D2[ni] = D2[ui] + 1;\n            q.push(Pos(nr, nc));\n        }\n    }\n}\n\nstruct Edge {\n    int to, rev, cap;\n};\n\nvector<vector<Edge> > G;\n\nvoid add_edge(int u, int v, int c) {\n    Edge a = {v, (int)G[v].size(), c};\n    Edge b = {u, (int)G[u].size(), 0};\n    G[u].push_back(a);\n    G[v].push_back(b);\n}\n\nint dinic(int s, int t) {\n    const int INF = 1000000000;\n    int ans = 0;\n    while (true) {\n        vector<int> level(G.size(), -1);\n        queue<int> q;\n        level[s] = 0;\n        q.push(s);\n        while (!q.empty()) {\n            int v = q.front();\n            q.pop();\n            for (const Edge& e : G[v]) {\n                if (e.cap > 0 && level[e.to] == -1) {\n                    level[e.to] = level[v] + 1;\n                    q.push(e.to);\n                }\n            }\n        }\n        if (level[t] == -1) break;\n\n        vector<int> it(G.size(), 0);\n        function<int(int,int)> dfs;\n        dfs = [&](int v, int f) -> int {\n            if (v == t) return f;\n            for (int &i = it[v]; i < (int)G[v].size(); ++i) {\n                Edge &e = G[v][i];\n                if (e.cap > 0 && level[e.to] == level[v] + 1) {\n                    int pushed = dfs(e.to, min(f, e.cap));\n                    if (pushed > 0) {\n                        e.cap -= pushed;\n                        G[e.to][e.rev].cap += pushed;\n                        return pushed;\n                    }\n                }\n            }\n            return 0;\n        };\n        int pushed;\n        while ((pushed = dfs(s, INF)) > 0) ans += pushed;\n    }\n    return ans;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);