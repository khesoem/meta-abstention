\nfrom collections import deque\n\nclass Pos:\n    def __init__(self, r=0, c=0):\n        self.r = r\n        self.c = c\n\ndef bfs_z(src, B, W, D1):\n    D1[:] = [-1] * (W * W)\n    q = deque()\n    D1[src.r * W + src.c] = 0\n    q.append(src)\n    dr = [-1, 0, 0, 1]\n    dc = [0, -1, 1, 0]\n    while q:\n        u = q.popleft()\n        ui = u.r * W + u.c\n        for k in range(4):\n            nr = u.r + dr[k]\n            nc = u.c + dc[k]\n            if B[nr][nc] != '.':\n                continue\n            ni = nr * W + nc\n            if D1[ni] != -1:\n                continue\n            D1[ni] = D1[ui] + 1\n            q.append(Pos(nr, nc))\n\ndef bfs_one(src, B, W, D1, D2):\n    D2[:] = [-1] * (W * W)\n    q = deque()\n    D2[src.r * W + src.c] = 0\n    q.append(src)\n    dr = [-1, 0, 0, 1]\n    dc = [0, -1, 1, 0]\n    while q:\n        u = q.popleft()\n        ui = u.r * W + u.c\n        if D1[ui] >= 0 and D2[ui] >= D1[ui]:\n            continue\n        for k in range(4):\n            nr = u.r + dr[k]\n            nc = u.c + dc[k]\n            if B[nr][nc] != '.':\n                continue\n            ni = nr * W + nc\n            if D2[ni] != -1:\n                continue\n            if D1[ni] >= 0 and D1[ni] < D2[ui] + 1:\n                continue\n            D2[ni] = D2[ui] + 1\n            q.append(Pos(nr, nc))\n\nclass Edge:\n    def __init__(self, to, rev, cap):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n\ndef add_edge(G, u, v, c):\n    G[u].append(Edge(v, len(G[v]), c))\n    G[v].append(Edge(u, len(G[u]) - 1, 0))\n\ndef dinic(G, s, t):\n    INF = 10**9\n    ans = 0\n    n = len(G)\n    while True:\n        level = [-1] * n\n        q = deque()\n        level[s] = 0\n        q.append(s)\n        while q:\n            v = q.popleft()\n            for e in G[v]:\n                if e.cap > 0 and level[e.to] == -1:\n                    level[e.to] = level[v] + 1\n                    q.append(e.to)\n        if level[t] == -1:\n            break\n        it = [0] * n\n        def dfs(v, f):\n            if v == t:\n                return f\n            for i in range(it[v], len(G[v])):\n                e = G[v][i]\n                if e.cap > 0 and level[e.to] == level[v] + 1:\n                    pushed = dfs(e.to, min(f, e.cap))\n                    if pushed > 0:\n                        e.cap -= pushed\n                        G[e.to][e.rev].cap += pushed\n                        return pushed\n                it[v] += 1\n            return 0\n        while True:\n            pushed = dfs(s, INF)\n            if pushed == 0:\n                break\n            ans += pushed\n    return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    T = int(next(it))\n    W = N + 2\n\n    B = ['#' * W for _ in range(W)]\n    for r in range(1, N+1):\n        row = next(it)\n        for c in range(1, N+1):\n            B[r] = B[r][:c] + row[c-1] + B[r][c+1:]\n    B1 = B[:]\n\n    B2 = ['#' * W for _ in range(W)]\n    for r in range(1, N+1):\n        row = next(it)\n        for c in range(1, N+1):\n            B2[r] = B2[r][:c] + row[c-1] + B2[r][c+1:]\n\n    sci = []\n    caps = []\n    z = None\n    for r in range(1, N+1):\n        for c in range(1, N+1):\n            ch = B[r][c]\n            if '0' <= ch <= '9':\n                if ch > '0':\n                    sci.append(Pos(r, c))\n                B[r] = B[r][:c] + '.' + B[r][c+1:]\n            elif ch == 'Z':\n                z = Pos(r, c)\n                B[r] = B[r][:c] + '.' + B[r][c+1:]\n            ch2 = B2[r][c]\n            if '0' <= ch2 <= '9' and ch2 > '0':\n                caps.append(Pos(r, c))\n\n    D1 = [-1] * (W * W)\n    bfs_z(z, B, W, D1)\n\n    nS = len(sci)\n    nC = len(caps)\n    SRC = 0\n    SINK = nS + nC + 1\n    V = SINK + 1\n    G = [[] for _ in range(V)]\n\n    INF = 98765432\n\n    for i, s in enumerate(sci):\n        cap = int(B1[s.r][s.c])\n        add_edge(G, SRC, i+1, cap)\n    for j, c in enumerate(caps):\n        cap = int(B2[c.r][c.c])\n        add_edge(G, nS + j + 1, SINK, cap)\n\n    D2 = [-1] * (W * W)\n    for i, s in enumerate(sci):\n        bfs_one(s, B, W, D1, D2)\n        for j, c in enumerate(caps):\n            ci = c.r * W + c.c\n            if D2[ci] >= 0 and D2[ci] <= T:\n                add_edge(G, i+1, nS + j + 1, INF)\n\n    print(dinic(G, SRC, SINK))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.7404405298293568e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, -8.391981828026474e-05, -0.02395915426313877, -6.198863957251888e-06, -4.172316494077677e-06, -0.00018165845540352166, -1.0728830375228426e-06, 0.0, -2.264974000354414e-06, -0.023388810455799103, -0.5926779508590698, -0.000730247818864882, -3.099436753473128e-06, -1.311301275563892e-06, -0.3132743835449219, -5.960462772236497e-07, 0.0, 0.0, 0.0, 0.0, -0.005234583746641874, -0.0005678709712810814, 0.0, 0.0, 0.0, -4.887569048150908e-06, -1.1920928244535389e-07, -5.245195097813848e-06, -8.344646857949556e-07, 0.0, 0.0, -6.318072337307967e-06, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -1.4066597032069694e-05, -0.15487024188041687, -0.8082378506660461, -6.318072337307967e-06, -0.004181689582765102, -0.20151790976524353, -0.01803640089929104, -0.0009211826254613698, -0.3892313539981842, -0.31329458951950073, -0.10118886828422546, -0.006814691238105297, -0.008746291510760784, -2.50339189733495e-06, -0.724530041217804, -0.0002806984703056514, -0.02348208613693714, -1.4305104514278355e-06, 0.0, -2.8490614567999728e-05, -1.1920928244535389e-07, -0.00029690624796785414, -0.0001586549769854173, -9.536738616588991e-07, -3.2186455882765586e-06, -0.0024757706560194492, -1.7881377516459906e-06, -0.006718901451677084, 0.0, -0.0001770101225702092, 0.0, -2.3841855067985