) {\n                int ni = i;\n                if (ni < K) ni = (ni + K - 1) % K;\n                int nj = j;\n                if (nj < K) nj = (nj + K - 1) % K;\n                result.get(i).set(j, mat.get(ni).get(nj));\n            }\n        }\n        return result;\n    }\n\n    static void buildTables() {\n        long digits = 0;\n        long temp = N;\n        while (temp > 0) {\n            temp /= K;\n            digits++;\n        }\n\n        precomputed.clear();\n        for (int i = 0; i <= 100; i++) {\n            precomputed.add(new ArrayList<>());\n        }\n\n        precomputed.set(0, new ArrayList<>());\n        for (int i = 0; i <= K; i++) {\n            List<Integer> row = new ArrayList<>();\n            for (int j = 0; j <= K; j++) {\n                row.add(0);\n            }\n            precomputed.get(0).add(row);\n        }\n\n        for (int i = 1; i < K; i++) {\n            precomputed.get(0).get(i).set(i, 1);\n        }\n        precomputed.get(0).get(0).set(K, 1);\n        precomputed.get(0).get(K).set(0, MOD - 1);\n        precomputed.get(0).get(K).set(K, 2);\n\n        for (int step = 0; step < digits; step++) {\n            precomputed.set(step + 1, new ArrayList<>());\n            for (List<Integer> row : precomputed.get(step)) {\n                List<Integer> newRow = new ArrayList<>(row);\n                precomputed.get(step + 1).add(newRow);\n            }\n\n            List<List<Integer>> current = new ArrayList<>();\n            for (List<Integer> row : precomputed.get(step)) {\n                current.add(new ArrayList<>(row));\n            }\n\n            for (int i = 1; i <= K - 1; i++) {\n                current = cyclicShift(current);\n                precomputed.set(step + 1, multiplyMatrices(precomputed.get(step + 1), current));\n            }\n        }\n    }\n\n    static List<List<Integer>> recursiveSolve(long n) {\n        if (n == 0) {\n            List<List<Integer>> result = new ArrayList<>();\n            for (int i = 0; i <= K; i++) {\n                List<Integer> row = new ArrayList<>();\n                for (int j = 0; j <= K; j++) {\n                    if (i == j) row.add(1);\n                    else row.add(0);\n                }\n                result.add(row);\n            }\n            return result;\n        }\n\n        long digit = 0;\n        long power = 1;\n        while (power <= n / K) {\n            power *= K;\n            digit++;\n        }\n\n        if (n == power) {\n            return precomputed.get((int) digit);\n        }\n\n        long steps = n / power;\n        long remainder = n - steps * power;\n\n        List<List<Integer>> baseMatrix = recursiveSolve(0);\n        List<List<Integer>> coefficient = precomputed.get((int) digit);\n\n        for (int i = 0; i < steps; i++) {\n            baseMatrix = multiplyMatrices(baseMatrix, coefficient);\n            coefficient = cyclicShift(coefficient);\n        }\n\n        List<List<Integer>> other = recursiveSolve(remainder);\n        for (int i = 0; i < steps; i++) {\n            other = cyclicShift(other);\n        }\n\n        return multiplyMatrices(baseMatrix, other);\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        N = scanner.nextLong();\n        K = scanner.nextInt();\n        buildTables();\n        List<List<Integer>> result = recursiveSolve(N);\n        System.out.println(result.get(K).get(K));\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001282609737245366, -2.861018856492592e-06, -8.344646857949556e-07, -0.00010346830822527409, -2.658331868587993e-05, -0.008793440647423267, -0.10045857727527618, -8.106198947643861e-06, -1.1920922133867862e-06, -6.389413465512916e-05, -0.008616294711828232, -1.4305104514278355e-06, -0.31535860896110535, -4.2437604861333966e-05, -0.0004887578543275595, -1.9073468138230965e-06, 0.0, 0.0, 0.0, -0.00012337400403339416, 0.0, 0.0, -3