 0; j < size; ++j) {\n            int ni = i;\n            if (ni < K) ni = (ni + K - 1) % K;\n            int nj = j;\n            if (nj < K) nj = (nj + K - 1) % K;\n            result[i][j] = mat[ni][nj];\n        }\n    }\n    return result;\n}\n\nvoid build_tables() {\n    ll digits = 0;\n    ll temp = N;\n    while (temp > 0) {\n        temp /= K;\n        digits++;\n    }\n    precomputed[0].resize(K + 1, vector<int>(K + 1, 0));\n    for (int i = 1; i < K; ++i) {\n        precomputed[0][i][i] = 1;\n    }\n    precomputed[0][0][K] = 1;\n    precomputed[0][K][0] = MOD - 1;\n    precomputed[0][K][K] = 2;\n    \n    for (int step = 0; step < digits; ++step) {\n        precomputed[step + 1] = precomputed[step];\n        auto current = precomputed[step];\n        for (int i = 1; i <= K - 1; ++i) {\n            current = cyclic_shift(current);\n            precomputed[step + 1] = multiply_matrices(precomputed[step + 1], current);\n        }\n    }\n}\n\nvector<vector<int>> recursive_solve(ll n) {\n    if (n == 0) {\n        vector<vector<int>> result(K + 1, vector<int>(K + 1, 0));\n        for (int i = 0; i <= K; ++i) {\n            result[i][i] = 1;\n        }\n        return result;\n    }\n    ll digit = 0;\n    ll power = 1;\n    while (power <= n / K) {\n        power *= K;\n        digit++;\n    }\n    if (n == power) return precomputed[digit];\n    ll steps = n / power;\n    ll remainder = n - steps * power;\n    auto base_matrix = recursive_solve(0);\n    auto coefficient = precomputed[digit];\n    for (int i = 0; i < steps; ++i) {\n        base_matrix = multiply_matrices(base_matrix, coefficient);\n        coefficient = cyclic_shift(coefficient);\n    }\n    auto other = recursive_solve(remainder);\n    for (int i = 0; i < steps; ++i) {\n        other = cyclic_shift(other);\n    }\n    return multiply_matrices(base_matrix, other);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N >> K;\n    build_tables();\n    auto r