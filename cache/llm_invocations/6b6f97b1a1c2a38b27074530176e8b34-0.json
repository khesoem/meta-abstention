   v = (v % MOD_A + MOD_A) % MOD_A;\n        RES = (RES + POW10[i] - (lower_bound(TABLE[k][i] + 1, TABLE[k][i] + POW10[i] + 1, MOD_A - v) - TABLE[k][i]) + 1) % MOD_B;\n    }\n    for (int i = 0; i <= k; ++i) P += POW10[i];\n}\nint main() {\n    scanf(\"%lld\", &N);\n    POW10[0] = 1;\n    for (int i = 1; i <= 6; ++i) POW10[i] = POW10[i-1] * 10;\n    for (int k = 0; k <= 6; ++k) {\n        P = 0;\n        generate(0, 0, k);\n        for (int i = 0; i <= k; ++i) sort(TABLE[k][i] + 1, TABLE[k][i] + POW10[i] + 1);\n    }\n    P = 0;\n    if (N < 1000000) {\n        for (int d = 1; d <= 9; ++d) brute_force(d, 1);\n    } else {\n        NN = N;\n        while (NN >= 1000000) NN /= 10;\n        for (int d = 1; d <= 9; ++d) compute(d, 1);\n    }\n    printf(\"%d\\n\", (int)((ll)(MOD_B - RES) * MOD_A % MOD_B));\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD_A = 998244353\nMOD_B = 1000000007\n\ndef cpp_div(a, b):\n    # C++ integer division truncating toward zero\n    if a >= 0:\n        return a // b\n    else:\n        return -((-a) // b)\n\nP = 0\nRES = 0\nN = 0\nNN = 0\nPOW10 = [1] * 7\nTABLE = [[[] for _ in range(7)] for _ in range(7)]\n\ndef generate(x, l, k):\n    global P\n    P += 1\n    TABLE[k][l].append(P - x)\n    if l == k:\n        return\n    for d in range(10):\n        generate(x * 10 + d, l + 1, k)\n\ndef brute_force(x, l):\n    global P, RES, N\n    if x > N:\n        return\n    P += 1\n    RES = (RES + cpp_div(P - x, MOD_A) - (1 if P < x else 0)) % MOD_B\n    for d in range(10):\n        brute_force(x * 10 + d, l + 1)\n\ndef compute(x, l):\n    global P, RES, N, NN\n    if l != 6:\n        P += 1\n        RES = (RES + cpp_div(P - x, MOD_A) - (1 if P < x else 0)) % MOD_B\n        for d in range(10):\n            compute(x * 10 + d, l + 1)\n        return\n    if x == NN:\n        brute_force(x, 0)\n        return\n    k = 0\n    v = x\n    while k <= 6 and v <= N:\n        v *= 10\n        k += 1\n    k -= 1\n    for i in range(k + 1):\n        v = P - x * POW10[i]\n        term = (cpp_div(v, MOD_A) - (1 if v < 0 else 0)) * POW10[i]\n        RES = (RES + term) % MOD_B\n        v_mod = v % MOD_A\n        pos = bisect.bisect_left(TABLE[k][i], MOD_A - v_mod)\n        RES = (RES + POW10[i] - pos) % MOD_B\n    for i in range(k + 1):\n        P += POW10[i]\n\ndef main():\n    global N, NN, P, RES, POW10, TABLE\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    N = int(data[0])\n    POW10[0] = 1\n    for i in range(1, 7):\n        POW10[i] = POW10[i-1] * 10\n    for k in range(7):\n        P = 0\n        generate(0, 0, k)\n        for i in range(k + 1):\n            TABLE[k][i].sort()\n    P = 0\n    RES = 0\n    if N < 1000000:\n        for d in range(1, 10):\n            brute_force(d, 1)\n    else:\n        NN = N\n        while NN >= 1000000:\n            NN //= 10\n        for d in range(1, 10):\n            compute(d, 1)\n    ans = ((MOD_B - RES) * MOD_A) % MOD_B\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-5.054346183896996e-05, 0.0, -1.1920928244535389e-07, -0.0005812147865071893, -0.0015328098088502884, -4.541770613286644e-05, -0.00027581225731410086, -0.03875874727964401, -7.867782187531702e-06, 0.0, -0.0009243983076885343, -0.003435782389715314, 0.0, -9.536738616588991e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -8.344646857949556e-07, -3.182837463100441e-05, 0.0, -4.768370445162873e-07, -1.311301275563892e-06, -1.3132731914520264, -0.4246974587440491, -0.018825901672244072, 0.0, -0.00023278864682652056, -0.00012206286191940308, -0.0007140470552258193, -2.622600959512056e-06, -9.881961887003854e-05, 