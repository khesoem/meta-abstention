n            for(int k = h[c]; ~k; k = ne[k]) if (cap[k] > 0) {\n                int v = to[k];\n                if(dis[c] + cost[k] < dis[v]){\n                    dis[v] = dis[c] + cost[k];\n                    pre[v] = k;\n                    if(!ing[v]) Q.push(v) , ing[v] = 1;\n                }\n            }\n        }\n        return dis[t] != inf;\n    }\n    U flow; V mincost;\n    pair<U, V> run(int _s,int _t){\n        s = _s , t = _t;\n        flow = mincost = 0;\n        while(spfa()){\n            U pl = inf; int p, k;\n            for(p = t;p != s;p = to[k^1]) pl = min(pl, cap[k = pre[p]]);\n            for(p = t;p != s;p = to[k^1]) cap[k = pre[p]] -= pl, cap[k^1] += pl;\n\t\t\tmincost += pl * dis[t];\n            flow += pl;\n        }\n        return make_pair(flow, mincost);\n    }\n};\nMCMF<int,int> flow;\nint n , m , k ,c , d ,a[N] , id[55][2500];\nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\trep(i , 1 , k + 1)\n\t\tscanf(\"%d\",&a[i]);\n\tflow.ini(50*50*4 + 10);\n\tint s = flow.n - 2,t = flow.n - 3;\n\tint cnt = 0 ,mx = 100;\n\trep(i , 1 , n + 1)\n\t\trep(j , 0 , mx + 1)\n\t\t\tid[i][j] = ++cnt;\n\tint u , v;\n\trep(i , 1 , m + 1){\n\t\tscanf(\"%d%d\",&u,&v);\n\t\trep(j , 0 , mx){\n\t\t\trep(h , 1 , k + 1){\n\t\t\t\tint tmp = h*h*d - (h-1)*(h-1)*d;\n\t\t\t\tflow.link(id[u][j] , id[v][j + 1] , 1 , c + tmp);\n\t\t\t\tflow.link(id[v][j] , id[u][j + 1] , 1 , c + tmp);\n\t\t\t}\n\t\t}\n\t}\n\trep(i , 1 , n + 1)\n\t\trep(j , 0 , mx)\n\t\t\tflow.link(id[i][j] , id[i][j + 1] , inf , c);\n\trep(i , 1 , k + 1)\n\t\tflow.link(s , id[a[i]][0] , 1 , 0);\n\trep(j , 1 , mx + 1)flow.link(id[1][j] , t , inf , 0);\n\tint ans = flow.run(s , t).se;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass MCMF:\n    def __init__(self, N=30000, M=7010010):\n        self.N = N\n        self.M = M\n        self.h = [-1] * self.N\n        self.ing = [0] * self.N\n        self.pre = [0] * self.N\n        self.to = [0] * self.M\n        self.ne = [0] * self.M\n        self.cap = [0] * self.M\n        self.dis = [float('inf')] * self.N\n        self.cost = [0] * self.M\n        self.e = 0\n        self.s = 0\n        self.t = 0\n        self.n = 0\n\n    def ini(self, _n):\n        self.h = [-1] * _n\n        self.n = _n\n        self.e = 0\n\n    def liu(self, u, v, c, w):\n        self.to[self.e] = v\n        self.ne[self.e] = self.h[u]\n        self.cap[self.e] = c\n        self.cost[self.e] = w\n        self.h[u] = self.e\n        self.e += 1\n\n    def link(self, u, v, c, w):\n        self.liu(u, v, c, w)\n        self.liu(v, u, 0, -w)\n\n    def spfa(self):\n        for i in range(self.n):\n            self.dis[i] = float('inf')\n            self.ing[i] = 0\n        Q = deque()\n        Q.append(self.s)\n        self.dis[self.s] = 0\n        self.ing[self.s] = 1\n        while Q:\n            c = Q.popleft()\n            self.ing[c] = 0\n            k = self.h[c]\n            while k != -1:\n                v = self.to[k]\n                if self.cap[k] > 0 and self.dis[c] + self.cost[k] < self.dis[v]:\n                    self.dis[v] = self.dis[c] + self.cost[k]\n                    self.pre[v] = k\n                    if not self.ing[v]:\n                        Q.append(v)\n                        self.ing[v] = 1\n                k = self.ne[k]\n        return self.dis[self.t] != float('inf')\n\n    def run(self, _s, _t):\n        self.s = _s\n        self.t = _t\n        flow = 0\n        mincost = 0\n        while self.spfa():\n            pl = float('inf')\n            p = self.t\n            while p != self.s:\n                k = self.pre[p]\n                pl = min(pl, self.cap[k])\n                p = self.to[k ^ 1]\n            p = self.t\n            while p != self.s:\n                k = self.pre[p]\n                self.cap[k] -= pl\n                self.cap[k ^ 1] += pl\n                p = self.to[k ^ 1]\n            mincost += pl * self.dis[self.t]\n            flow += pl\n        return flow, mincost\n\ndef main():\n    sys.setrecursionlimit(10**7)\n    input = sys.stdin.read\n    data = list(map(int, sys.stdin.read().split()))\n    n, m, k, c, d = data[0], data[1], data[2], data[3], data[4]\n    a = [0] + data[5:5+k]\n    flow = MCMF()\n    flow.ini(50*50*4 + 10)\n    s = flow.n - 2\n    t = flow.n - 3\n    cnt = 0\n    mx = 100\n    id_map = [[0]*(mx+1) for _ in range(n+1)]\n    for i in range(1, n+1):\n        for j in range(mx+1):\n            cnt += 1\n            id_map[i][j] = cnt\n    # index offset for undirected edges\n    def get_id(i, j):\n        return id_map[i][j]\n    index = 5 + k\n    for i in range(m):\n        u, v = data[index + 2*i], data[index + 2*i + 1]\n        for j in range(mx):\n            for h in range(1, k+1):\n                tmp = h*h*d - (h-1)*(h-1)*d\n                flow.link(get_id(u, j), get_id(v, j + 1), 1, c + tmp)\n                flow.link(get_id(v, j), get_id(u, j + 1), 1, c + tmp)\n    for i in range(1, n+1):\n        for j in range(mx):\n            flow.link(get_id(i, j), get_id(i, j + 1), float('inf'), c)\n    for i in range(1, k+1):\n        flow.link(s, get_id(a[i], 0), 1, 0)\n    for j in range(1, mx + 1):\n        flow.link(get_id(1, j), t, float('inf'), 0)\n    ans = flow.run(s, t)[1]\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0003144896763842553, -0.00019936825265176594, 0.0, -2.165027217415627e-05, -0.030178658664226532, -6.158350151963532e-05, -4.4894986785948277e-05, -0.5248880386352539, -0.008870773948729038, 0.0, -1.306760805164231e-05, -0.01638530008494854, -0.7122699022293091, -0.0010917582549154758, -2.7610454708337784e-05, -1.9361264946837764e-07, -4.246537173457909e-06, -1.8670179997570813e-05, -0.2840847