e <cmath>\n\nusing namespace std;\n\nvoid generate_sums(int start, int end, const vector<int>& a, int m, vector<int>& storage) {\n    function<void(int, int)> helper;\n    helper = [&](int idx, int current_sum) {\n        if (idx == end) {\n            storage.push_back(current_sum % m);\n        } else {\n            helper(idx + 1, (current_sum + a[idx]) % m);\n            helper(idx + 1, current_sum);\n        }\n    };\n    helper(start, 0);\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    \n    vector<int> a(n);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n    }\n    \n    int n1 = n / 2;\n    vector<int> a1;\n    vector<int> a2;\n    \n    generate_sums(0, n1, a, m, a1);\n    generate_sums(n1, n, a, m, a2);\n    \n    // Remove duplicates and sort a1\n    set<int> a1_set(a1.begin(), a1.end());\n    a1.assign(a1_set.begin(), a1_set.end());\n    sort(a1.begin(), a1.end());\n    \n    int ans = 0;\n    \n    for (int val : a2) {\n        int needed = m - val;\n        auto pos = lower_bound(a1.begin(), a1.end(), needed);\n        \n        if (pos != a1.begin()) {\n            int prev_idx = pos - a1.begin() - 1;\n            int total = (a1[prev_idx] + val) % m;\n            if (total > ans) {\n                ans = total;\n            }\n        }\n        \n        if (pos != a1.end()) {\n            int total = (*pos + val) % m;\n            if (total > ans) {\n                ans = total;\n            }\n        }\n    }\n    \n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002563863235991448, -3.4570634852570947e-06, -9.536738616588991e-07, -0.000485183292767033, -2.3841855067985307e-07, -9.369411418447271e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, -5.960462772236497e-07, -1.7523612768854946e-05, -9.536738616588991e-07, -1.0728830375228426e-06, -3.576278118089249e-07, -0.07000547647476196, -1.4781842764932662e-05, -0.0013263961300253868, -1.8