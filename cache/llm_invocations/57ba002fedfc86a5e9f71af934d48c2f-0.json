nt v, int w, int c) {\n            this.v = v;\n            this.w = w;\n            this.c = c;\n        }\n    }\n\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] top;\n    static long[] dist;\n    static int[] flow, pre, las;\n    static long[] pot;\n    static int s, t;\n    static int maflow;\n    static long micost;\n    static final long INF = Long.MAX_VALUE / 2;\n    static final int INF_CAP = 1000000000;\n\n    static void add(int u, int v, int w, int c) {\n        int idx = edges.size();\n        edges.add(new Edge(v, w, c));\n        edges.add(new Edge(u, 0, -c));\n        top[u].add(idx);\n        top[v].add(idx + 1);\n    }\n\n    static boolean dijkstra() {\n        for (int i = 1; i <= t; i++) {\n            dist[i] = INF;\n            flow[i] = 0;\n            pre[i] = 0;\n            las[i] = 0;\n        }\n        dist[s] = 0;\n        flow[s] = INF_CAP;\n        PriorityQueue<long[]> pq = new PriorityQueue<>((a, b) -> Long.compare(a[0], b[0]));\n        pq.offer(new long[]{0, s});\n        while (!pq.isEmpty()) {\n            long[] cur = pq.poll();\n            long d = cur[0];\n            int u = (int) cur[1];\n            if (d != dist[u]) continue;\n            for (int eid : top[u]) {\n                Edge e = edges.get(eid);\n                int v = e.v, w = e.w, c = e.c;\n                long nd = d + c + pot[u] - pot[v];\n                if (w > 0 && dist[v] > nd) {\n                    dist[v] = nd;\n                    flow[v] = Math.min(flow[u], w);\n                    pre[v] = u;\n                    las[v] = eid;\n                    pq.offer(new long[]{nd, v});\n                }\n            }\n        }\n        if (dist[t] == INF) return false;\n        for (int i = 1; i <= t; i++) {\n            if (dist[i] < INF) pot[i] += dist[i];\n        }\n        return true;\n    }\n\n    static void mcmf() {\n        while (dijkstra()) {\n            int u = t;\n            int fl = flow[t];\n    