\n        unordered_set<long long> new_sums;\n        for (long long s : cur) {\n            new_sums.insert((s + x) % m);\n        }\n        // Merge new sums into res\n        for (long long ns : new_sums) {\n            res.insert(ns);\n        }\n    }\n    vector<long long> result(res.begin(), res.end());\n    sort(result.begin(), result.end());\n    return result;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n;\n    long long m;\n    cin >> n >> m;\n    \n    vector<long long> a(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> a[i];\n    }\n    \n    int n1 = n / 2;\n    vector<long long> first_half(a.begin(), a.begin() + n1);\n    vector<long long> second_half(a.begin() + n1, a.end());\n    \n    vector<long long> a1 = subset_sums(first_half, m); // sorted\n    vector<long long> a2 = subset_sums(second_half, m); // unsorted, but we don't sort it\n    \n    long long ans = 0;\n    for (long long i : a2) {\n        // Find first element in a1 >= m - i\n        auto it = lower_bound(a1.begin(), a1.end(), m - i);\n        int idx = it - a1.begin();\n        long long sum1;\n        if (idx > 0) {\n            sum1 = a1[idx - 1];\n        } else {\n            sum1 = a1.back(); // all elements >= m-i, take the largest\n        }\n        ans = max(ans, sum1 + i);\n    }\n    cout << ans << \"\\n\";\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.50339189733495e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0015350712928920984, -0.00026806574896909297, -1.4305104514278355e-06, -0.006773842498660088, -2.7656173188006505e-05, 0.0, 0.0, -5.054346183896996e-05, -6.437280717364047e-06, 0.0, 0.0, -0.00032062159152701497, -2.622600959512056e-06, -1.1920928244535389e-07, 0.0, -2.098061486321967e-05, -5.960462772236497e-07, -0.4741140902042389, -0.16046009957790375, -3.576278118089249e-07, -0.012579028494656086, -0.014399779960513115, -0.00117042683996