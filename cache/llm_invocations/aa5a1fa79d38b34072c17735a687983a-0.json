if (!fl) return 0;\n    if (v==TNode) return fl;\n    for (int &i=cur[v]; i<(int)adj[v].size(); ++i) {\n        int id=adj[v][i];\n        int to=edges[id].v;\n        if (dst[to]!=dst[v]+1) continue;\n        int pushed=dfs(to, min(fl, edges[id].cap-edges[id].flow));\n        if (pushed) {\n            edges[id].flow += pushed;\n            edges[id^1].flow -= pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nint dinic() {\n    int flow=0;\n    while (bfs()) {\n        memset(cur,0,nodeCnt*sizeof(cur[0]));\n        while (int pushed=dfs(S,INF)) flow += pushed;\n    }\n    return flow;\n}\n\nint main() {\n    scanf(\"%d%d\",&N,&T);\n    for(int i=0;i<N;i++) scanf(\"%s\",gridA[i]);\n    getchar();\n    for(int i=0;i<N;i++) scanf(\"%s\",gridB[i]);\n\n    for(int i=0;i<N;i++)\n        for(int j=0;j<N;j++)\n            cost[i][j]=INF;\n\n    queue<pair<int,int>> q;\n    for(int x=0;x<N;x++)\n        for(int y=0;y<N;y++)\n            if (gridA[x][y]=='Z') {\n                for(int d=0;d<4;d++)\n                    if (x+dx[d]>=0 && x+dx[d]<N && y+dy[d]>=0 && y+dy[d]<N && gridA[x+dx[d]][y+dy[d]]!='Y') {\n                        cost[x+dx[d]][y+dy[d]]=1;\n                        q.push({x+dx[d], y+dy[d]});\n                    }\n            }\n\n    while(!q.empty()) {\n        int x=q.front().first, y=q.front().second;\n        q.pop();\n        for(int d=0;d<4;d++) {\n            int nx=x+dx[d], ny=y+dy[d];\n            if (nx>=0 && nx<N && ny>=0 && ny<N && gridA[nx][ny]!='Y' && gridA[nx][ny]!='Z' && cost[nx][ny]==INF) {\n                cost[nx][ny]=cost[x][y]+1;\n                q.push({nx,ny});\n            }\n        }\n    }\n\n    for(int sx=0; sx<N; ++sx) {\n        for(int sy=0; sy<N; ++sy) {\n            if (gridA[sx][sy]=='Y' || gridA[sx][sy]=='Z') {\n                for(int tx=0; tx<N; ++tx)\n                    for(int ty=0; ty<N; ++ty)\n                        route[sx][sy][tx][ty]=0;\n                continue;\n            }\n            int dist[MAXN][MAXN];\n            for(int i=0;i<N;i++)\n                for(int j=0;j<N;j++)\n                    dist[i][j]=INF;\n            queue<pair<int,int>> q2;\n            dist[sx][sy]=0;\n            q2.push({sx,sy});\n            while(!q2.empty()) {\n                int x=q2.front().first, y=q2.front().second;\n                q2.pop();\n                route[sx][sy][x][y]=1;\n                if (dist[x][y] >= T || dist[x][y] >= cost[x][y])\n                    continue;\n                for(int d=0; d<4; ++d) {\n                    int nx=x+dx[d], ny=y+dy[d];\n                    if (nx>=0 && nx<N && ny>=0 && ny<N &&\n                        gridA[nx][ny]!='Y' && gridA[nx][ny]!='Z' &&\n                        dist[nx][ny]==INF &&\n                        dist[x][y]+1 <= cost[nx][ny]) {\n                        dist[nx][ny]=dist[x][y]+1;\n                        q2.push({nx,ny});\n                    }\n                }\n            }\n        }\n    }\n\n    S=0; TNode=2*N*N+1; nodeCnt=2*N*N+2;\n\n    for(int i=0;i<N;i++)\n        for(int j=0;j<N;j++) {\n            if (gridA[i][j]>'0' && gridA[i][j]<='9')\n                add_edge(S,1+i*N+j,gridA[i][j]-'0');\n            if (gridB[i][j]>'0' && gridB[i][j]<='9')\n                add_edge(N*N+1+i*N+j,TNode,gridB[i][j]-'0');\n        }\n\n    for(int x1=0;x1<N;x1++)\n        for(int y1=0;y1<N;y1++)\n            for(int x2=0;x2<N;x2++)\n                for(int y2=0;y2<N;y2++)\n                    if (route[x1][y1][x2][y2])\n                        add_edge(1+x1*N+y1, N*N+1+x2*N+y2, INF);\n\n    printf(\"%d\\n\",dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    T = int(next(it))\n    gridA = [list(next(it)) for _ in range(N)]\n    gridB = [list(next(it)) for _ in range(N)]\n\n    INF = 10**9\n    cost = [[INF]*N for _ in range(N)]\n    dx = [-1, 1, 0, 0]\n    dy = [0, 0, -1, 1]\n\n    # BFS from Z cells to compute cost (time when zombie reaches cell)\n    q = deque()\n    for x in range(N):\n        for y in range(N):\n            if gridA[x][y] == 'Z':\n                for d in range(4):\n                    nx = x + dx[d]\n                    ny = y + dy[d]\n                    if 0 <= nx < N and 0 <= ny < N and gridA[nx][ny] != 'Y':\n                        cost[nx][ny] = 1\n                        q.append((nx, ny))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 0 <= nx < N and 0 <= ny < N and gridA[nx][ny] != 'Y' and gridA[nx][ny] != 'Z' and cost[nx][ny] == INF:\n                cost[nx][ny] = cost[x][y] + 1\n                q.append((nx, ny))\n\n    # route[sx][sy][tx][ty] = 1 if reachable within T and not caught\n    route = [[[[0]*N for _ in range(N)] for _ in range(N)] for _ in range(N)]\n    for sx in range(N):\n        for sy in range(N):\n            if gridA[sx][sy] == 'Y' or gridA[sx][sy] == 'Z':\n                # no routes from these cells\n                continue\n            dist = [[INF]*N for _ in range(N)]\n            dist[sx][sy] = 0\n            q2 = deque()\n            q2.append((sx, sy))\n            while q2:\n                x, y = q2.popleft()\n                route[sx][sy][x][y] = 1\n                if dist[x][y] >= T or dist[x][y] >= cost[x][y]:\n                    continue\n                for d in range(4):\n                    nx = x + dx[d]\n                    ny = y + dy[d]\n                    if 0 <= nx < N and 0 <= ny < N and gridA[nx][ny] != 'Y' and gridA[nx][ny] != 'Z' and dist[nx][ny] == INF and dist[x][y] + 1 <= cost[nx][ny]:\n                        dist[nx][ny] = dist[x][y] + 1\n                        q2.append((nx, ny))\n\n    # Build flow network\n    nodeCnt = 2 * N * N + 2\n    S = 0\n    TNode = 2 * N * N + 1\n    edges = []  # list of [u, v, cap, flow]\n    adj = [[] for _ in range(nodeCnt)]\n\n    def add_edge(u, v, cap):\n        edges.append([u, v, cap, 0])\n        adj[u].append(len(edges) - 1)\n        edges.append([v, u, 0, 0])\n        adj[v].append(len(edges) - 1)\n\n    # Source to left nodes (gridA digits)\n    for i in range(N):\n        for j in range(N):\n            ch = gridA[i][j]\n            if '1' <= ch <= '9':\n                add_edge(S, 1 + i * N + j, ord(ch) - ord('0'))\n    # Right nodes to sink (gridB digits)\n    for i in range(N):\n        for j in range(N):\n            ch = gridB[i][j]\n            if '1' <= ch <= '9':\n                add_edge(N * N + 1 + i * N + j, TNode, ord(ch) - ord('0'))\n\n    # Edges from left to right if route exists\n    for x1 in range(N):\n        for y1 in range(N):\n            for x2 in range(N):\n                for y2 in range(N):\n                    if route[x1][y1][x2][y2]:\n                        add_edge(1 + x1 * N + y1, N * N + 1 + x2 * N + y2, INF)\n\n    # Dinic\n    dst = [-1] * nodeCnt\n    cur = [0] * nodeCnt\n    que = [0] * nodeCnt\n\n    def bfs():\n        for i in range(nodeCnt):\n            dst[i] = -1\n        h = 0\n        t = 0\n        que[t] = S\n        t += 1\n        dst[S] = 0\n        while h < t and dst[TNode] == -1:\n            v = que[h]\n            h += 1\n            for eid in adj[v]:\n                to = edges[eid][1]\n                if dst[to] == -1 and edges[eid][2] > edges[eid][3]:\n                    que[t] = to\n                    t += 1\n                    dst[to] = dst[v] + 1\n        return dst[TNode] != -1\n\n    def dfs(v, fl):\n        if fl == 0:\n            return 0\n        if v == TNode:\n            return fl\n        i = cur[v]\n        while i < len(adj[v]):\n            eid = adj[v][i]\n            to = edges[eid][1]\n            if dst[to] == dst[v] + 1:\n                pushed = dfs(to, min(fl, edges[eid][2] - edges[eid][3]))\n                if pushed:\n                    edges[eid][3] += pushed\n                    edges[eid ^ 1][3] -= pushed\n                    return pushed\n            i += 1\n            cur[v] = i\n        return 0\n\n    flow = 0\n    while bfs():\n        for i in range(nodeCnt):\n            cur[i] = 0\n        while True:\n            pushed = dfs(S, INF)\n            if not pushed:\n                break\n            flow += pushed\n\n    print(flow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010322991875000298, -0.006985882297158241, -3.814689989667386e-06, -8.821448318485636e-06, -2.8967437174287625e-05, 0.0, 0.0, -7.152555099310121e-07, -0.0015206689713522792, -0.5102931261062622, -0.05275656655430794, -0.474113792181015, -1.1920922133867862e-06, -0.0811975970864296, -4.529942543740617e-06, -2.884823152271565e-05, -1.1920928244535389e-07, -1.3947389561508317e-05, -1.1920928244535389e-07, -0.1002080887556076, -0.07897060364484787, -1.9073468138230965e-06, -0.10428924858570099, -2.264974000354414e-06, 0.0, -0.0015023384476080537, -2.3841855067985307e-07, -4.768370445162873e-07, -1.9073468138230965e-06, -4.768370445162873e-07, -0.029505303129553795, 0.0, -1.1920928244535389e-07, 0.0, -1.7881377516459906e-06, -1.1920928244535389e-07, -2.0265558760002023e-06, -1.4305104514278355e-06, 0.0, 0.0, 0.0, -0.00020823694649152458, 0.0, -1.1920922133867862e-06, -0.00010835537250386551, 0.0, -3.576278118089249e-07, 0.0, -0.008615112863481045, -0.10020712018013, -0.008738373406231403, -6.6756979322235566e-06, -1.1920928244535389e-07, -0.6936928033828735, -0.009348664432764053, -2.622600959512056e-06, -2.3841855067985307e-07, -0.4741128981113434, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -0.0009130837861448526, -1.9073468138230