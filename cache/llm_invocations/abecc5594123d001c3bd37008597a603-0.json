      Arrays.fill(inQueue, false);\n            for (int i = 0; i < n; i++) inQueue[i] = false;\n            dist[S] = 0;\n            inQueue[S] = true;\n            prev[S] = -1;\n            possible[S] = Integer.MAX_VALUE;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(S);\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                for (int id : adj.get(u)) {\n                    Arc e = edges.get(id);\n                    if (e.cap > e.flow && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prev[e.to] = id;\n                        possible[e.to] = Math.min(possible[u], e.cap - e.flow);\n                        if (!inQueue[e.to]) {\n                            q.add(e.to);\n                            inQueue[e.to] = true;\n                        }\n                    }\n                }\n                inQueue[u] = false;\n            }\n            if (dist[T] == 1000000007) return false;\n            augFlow[0] = possible[T];\n            pathCost[0] = dist[T];\n            for (int v = T; v != S; v = edges.get(prev[v]).from) {\n                edges.get(prev[v]).flow += possible[T];\n                edges.get(prev[v] ^ 1).flow -= possible[T];\n            }\n            return true;\n        }\n\n        int[] minCost(int s, int t) {\n            S = s;\n            T = t;\n            int totalCost = 0;\n            int totalFlow = 0;\n            int f = 0, c = 0;\n            while (shortestPath(new int[]{f}, new int[]{c})) {\n                totalFlow += f;\n                totalCost += f * c;\n            }\n            return new int[]{totalFlow, totalCost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextTo