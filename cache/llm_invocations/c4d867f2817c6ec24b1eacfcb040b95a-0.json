e;\n                int v = E.get(idx).to;\n                int c = E.get(idx).cost;\n                if (d[v] > d[u] + c) {\n                    d[v] = d[u] + c;\n                    par[v] = u;\n                    pe[v] = idx;\n                    if (!inq[v]) {\n                        inq[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n\n        int cur = T;\n        while (cur != S) {\n            E.get(pe[cur]).flow++;\n            E.get(pe[cur] ^ 1).flow--;\n            cur = par[cur];\n        }\n    }\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        G[u].add(E.size());\n        E.add(new Edge(v, cap, 0, cost));\n        G[v].add(E.size());\n        E.add(new Edge(u, 0, 0, -cost));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d_val = sc.nextInt();\n\n        for (int i = 0; i < MAXN; i++) {\n            G[i] = new ArrayList<>();\n        }\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            --x;\n            addEdge(S, x, 1, 0);\n        }\n\n        final int T_LAYERS = 101;\n        for (int t = 0; t < T_LAYERS; ++t) {\n            addEdge(t * n, T, k, t * c);\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x; --y;\n            for (int t = 0; t < T_LAYERS - 1; ++t) {\n                for (int j = 0; j < k; ++j) {\n                    addEdge(x + t * n, y + t * n + n, 1, d_val * (2 * j + 1));\n                }\n            }\n            for (int t = 0; t < T_LAYERS - 1; ++t) {\n                for (int j = 0; j < k; ++j) {\n                    addEdge(y + t * n, x + t * n + n, 1, d_val * (2 * j + 1));\n                }\n            }\n        }\n\n        for (int i = 0; i < n; ++i) {\n            for (int t = 0; t < T_LAYERS - 1; ++t) {\n                addEdge(i + t * n, i + t * n + n, k, 0);\n            }\n        }\n\n        long ans = 0;\n        for (int i = 0; i < k; ++i) {\n            spfa();\n            ans += d[T];\n        }\n\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022468426323030144, -2.50339189733495e-06, -1.4305104514278355e-06, -0.005613634362816811, -2.6225699912174605e-05, -0.05489550903439522, -0.22556638717651367, -1.156323378381785e-05, -3.576278118089249e-07, -5.173549288883805e-05, -0.029751459136605263, -0.00017998983094003052, -0.006285778246819973, -0.04343979433178902, -0.0024922997690737247, -2.682172998902388e-05, 0.0, -0.25193554162979126, -1.0132738680113107e-05, -1.4781842764932662e-05, -0.4740975499153137, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -3.576278118089249e-07, -8.22540732769994e-06, -7.271740287251305e-06, -9.536738616588991e-07, -2.1219027985353023e-05, -4.0411134250462055e-05, -4.0531076592742465e-06, -2.3841855067985307e-07, 0.0, 0.0, -2.861018856492592e-06, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -3.3378546504536644e-06, -7.152555099310121e-07, -3.576278118089249e-07, -1.311301275563892e-06, -0.14267581701278687, -3.576278118089249e-07, -0.00016008525562938303, -0.22588008642196655, -0.0006003961316309869, -4.0649541915627196e-05, 0.0, -1.311301275563892e-06, 0.0, -1.9311717551317997e-05, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920858014491387e-05, -2.264974000354414e-06, -2.3841855067985307e-07, -1.728519782773219e-05, -9.536697689327411e-06, -1.5497195136049413e-06, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -1.3351351299206726e-05, 0.0, 0.0, -4.887569048150908e-06, -2.264974000354414e-06, -1.311301275563892e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -7.509902934543788e-05, -4.0411134250462055e-05, -3.6954811548639555e-06, 0.0, -1.19209282