c int n, s, t;\n    static ArrayList<Edge>[] adj;\n    static long[] dist;\n    static int[] prevv, preve;\n    static boolean[] inq;\n    \n    static void resetGraph(int nodes, int src, int sink) {\n        adj = new ArrayList[nodes + 1];\n        for (int i = 0; i <= nodes; i++) {\n            adj[i] = new ArrayList<>();\n        }\n        n = nodes;\n        s = src;\n        t = sink;\n    }\n    \n    static void connect(int u, int v, int capacity, int weight) {\n        adj[u].add(new Edge(v, capacity, weight, adj[v].size()));\n        adj[v].add(new Edge(u, 0, -weight, adj[u].size() - 1));\n    }\n    \n    static long minCostMaxFlow(int requiredFlow) {\n        long totalCost = 0;\n        while (requiredFlow > 0) {\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            Arrays.fill(inq, false);\n            inq[s] = true;\n            \n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n                for (int idx = 0; idx < adj[u].size(); idx++) {\n                    Edge e = adj[u].get(idx);\n                    if (e.cap > 0 && dist[u] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = idx;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n            \n            if (dist[t] == INF) return -1;\n            \n            int flowToPush = requiredFlow;\n            for (int cur = t; cur != s; cur = prevv[cur]) {\n                flowToPush = Math.min(flowToPush, adj[prevv[cur]].get(preve[cur]).cap);\n            }\n            \n            requiredFlow -= flowToPush;\n            totalCost += (long)flowToPush * dist[t];\n      