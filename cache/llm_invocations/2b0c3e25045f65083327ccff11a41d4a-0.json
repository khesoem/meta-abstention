 bfs(sr, sc):\n    qr = deque()\n    qc = deque()\n    for i in range(12):\n        for j in range(12):\n            dist[i][j] = -1\n    qr.append(sr)\n    qc.append(sc)\n    dist[sr][sc] = 0\n    while qr:\n        sr = qr.popleft()\n        sc = qc.popleft()\n        for i in range(4):\n            nr = sr + dr[i]\n            nc = sc + dc[i]\n            if 0 <= nr < 12 and 0 <= nc < 12 and gridA[nr][nc] >= 0 and dist[nr][nc] < 0:\n                dist[nr][nc] = dist[sr][sc] + 1\n                qr.append(nr)\n                qc.append(nc)\n\ndef propagate(sr, sc, count):\n    global rows\n    visited = [[-1] * 12 for _ in range(12)]\n    qr = deque()\n    qc = deque()\n    qr.append(sr)\n    qc.append(sc)\n    visited[sr][sc] = 0\n    while qr:\n        sr = qr.popleft()\n        sc = qc.popleft()\n        if visited[sr][sc] > min(timeLimit, dist[sr][sc]):\n            continue\n        for j in range(len(exits[sr][sc])):\n            for i in range(count):\n                adj[rows + i].append(exits[sr][sc][j])\n        if visited[sr][sc] == min(timeLimit, dist[sr][sc]):\n            continue\n        for i in range(4):\n            nr = sr + dr[i]\n            nc = sc + dc[i]\n            if 0 <= nr < 12 and 0 <= nc < 12 and gridA[nr][nc] >= 0 and visited[nr][nc] < 0:\n                visited[nr][nc] = visited[sr][sc] + 1\n                qr.append(nr)\n                qc.append(nc)\n    rows += count\n\nsolver = Hungary()\n\ndef main():\n    global rows, timeLimit\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    n, timeLimit = map(int, data[0].split())\n    idx = 0\n    rows = 0\n    for i in range(12):\n        for j in range(12):\n            gridA[i][j] = -1\n            gridB[i][j] = -1\n    \n    line_idx = 1\n    for i in range(1, n + 1):\n        if line_idx >= len(data):\n            break\n        line = data[line_idx]\n        line_idx += 1\n        for j in range(1, n + 1):\n            if j - 1 < len(line):\n                ch = line[j - 1]\n            else:\n                ch = ' '\n            if ch.isdigit():\n                gridA[i][j] = int(ch)\n            if ch == 'Z':\n                startR = i\n                startC = j\n    \n    bfs(startR, startC)\n    \n    line_idx += 1  # skip empty line\n    for i in range(1, n + 1):\n        if line_idx >= len(data):\n            break\n        line = data[line_idx]\n        line_idx += 1\n        for j in range(1, n + 1):\n            if j - 1 < len(line):\n                ch = line[j - 1]\n            else:\n                ch = ' '\n            if ch.isdigit():\n                gridB[i][j] = int(ch)\n            for k in range(gridB[i][j]):\n                exits[i][j].append(idx)\n                idx += 1\n    \n    for i in range(12):\n        for j in range(12):\n            if dist[i][j] < 0:\n                dist[i][j] = INF\n    \n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if gridA[i][j] > 0:\n                propagate(i, j, gridA[i][j])\n    \n    print(solver.gao(rows, adj))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001597276859683916, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.02871805429458618, -0.003052102169021964, -2.50339189733495e-06, -0.0002047805901383981, -0.00032693761750124395, -2.9802276912960224e-06, -0.0003013156820088625, -0.0009658439084887505, -0.14696817100048065, -0.0011876918142661452, -1.3947389561508317e-05, -2.264974000354414e-06, -0.00977869238704443, -3.576278118089249e-07, 0.0, -1.1920922133867862e-06, -3.814689989667386e-06, -1.0251946150674485e-05, -6.079655122448457e-06, -0.1466986984014511, -1.1920922133867862e-06, -0.004953612107783556, -0.005931513383984566, -1.4305104514278355e-06, -5.960462772236497e-07, -4.768370445162873e-07, -1.5497195136049413e-06, -2.074220174108632e-05, -0.0006289887824095786, -0.005233042407780886, -1.9073468138230965e-06, -1.1