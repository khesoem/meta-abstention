vector<int> adj[2000];\nvector<int> exits[12][12];\n\nvoid bfs(int sr, int sc) {\n    queue<int> qr, qc;\n    fill(&dist[0][0], &dist[0][0] + 12 * 12, -1);\n    qr.push(sr); qc.push(sc);\n    dist[sr][sc] = 0;\n    while (!qr.empty()) {\n        sr = qr.front(); qr.pop();\n        sc = qc.front(); qc.pop();\n        for (int i = 0; i < 4; i++) {\n            int nr = sr + dr[i], nc = sc + dc[i];\n            if (gridA[nr][nc] >= 0 && dist[nr][nc] < 0) {\n                dist[nr][nc] = dist[sr][sc] + 1;\n                qr.push(nr); qc.push(nc);\n            }\n        }\n    }\n}\n\nvoid propagate(int sr, int sc, int count) {\n    int visited[12][12];\n    queue<int> qr, qc;\n    fill(&visited[0][0], &visited[0][0] + 12 * 12, -1);\n    qr.push(sr); qc.push(sc);\n    visited[sr][sc] = 0;\n    while (!qr.empty()) {\n        sr = qr.front(); qr.pop();\n        sc = qc.front(); qc.pop();\n        if (visited[sr][sc] > min(timeLimit, dist[sr][sc])) continue;\n        for (int j = 0; j < (int)exits[sr][sc].size(); j++)\n            for (int i = 0; i < count; i++)\n                adj[rows + i].push_back(exits[sr][sc][j]);\n        if (visited[sr][sc] == min(timeLimit, dist[sr][sc])) continue;\n        for (int i = 0; i < 4; i++) {\n            int nr = sr + dr[i], nc = sc + dc[i];\n            if (gridA[nr][nc] >= 0 && visited[nr][nc] < 0) {\n                visited[nr][nc] = visited[sr][sc] + 1;\n                qr.push(nr); qc.push(nc);\n            }\n        }\n    }\n    rows += count;\n}\n\nHungary solver;\n\nint main() {\n    int n, startR, startC, idx = rows = 0;\n    scanf(\"%d%d\", &n, &timeLimit);\n    fill(&gridA[0][0], &gridA[0][0] + 12 * 12, -1);\n    fill(&gridB[0][0], &gridB[0][0] + 12 * 12, -1);\n    for (int i = 1; i <= n; i++) {\n        while (getchar() != '\\n');\n        for (int j = 1; j <= n; j++) {\n            char ch = getchar();\n            if (ch >= '0' && ch <= '9') gridA[i][j] = ch - '0';\n            if (ch == 'Z') { startR = i; startC = j