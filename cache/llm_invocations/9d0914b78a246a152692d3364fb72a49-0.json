od;\n    for (int i = 0; i <= 9; i++) dfs2(x * 10 + i);\n}\n\nint main() {\n    scanf(\"%lld\", &n);\n    ord = 0;\n    dfs1(0, 0);\n    for (int i = 0; i <= 6; i++) sort(v[i].begin(), v[i].end());\n    ord = 0;\n    for (int i = 1; i <= 9; i++) dfs2(i);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final long MOD = 998244353L;\n    static final long mod = 1000000007L;\n    static final int maxk = 7;\n    static final int base = 1000000;\n    \n    static long n, ord;\n    static int ans;\n    static long[] sum = new long[maxk];\n    static List<Long>[] v = new List[maxk];\n    \n    @SuppressWarnings(\"unchecked\")\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        n = Long.parseLong(br.readLine().trim());\n        \n        for (int i = 0; i < maxk; i++) {\n            v[i] = new ArrayList<>();\n        }\n        \n        ord = 0;\n        dfs1(0, 0);\n        \n        for (int i = 0; i < maxk; i++) {\n            Collections.sort(v[i]);\n        }\n        \n        ord = 0;\n        for (int i = 1; i <= 9; i++) {\n            dfs2(i);\n        }\n        \n        System.out.println(ans);\n    }\n    \n    static void dfs1(long x, int len) {\n        ord++;\n        long val = ((ord - x) % MOD + MOD) % MOD;\n        v[len].add(val);\n        sum[len] = (sum[len] + val) % mod;\n        \n        if (len == 6) return;\n        \n        for (int i = 0; i <= 9; i++) {\n            dfs1(x * 10 + i, len + 1);\n        }\n    }\n    \n    static void dfs2(long x) {\n        if (x > n) return;\n        \n        if (x * base + base - 1 <= n && x * base * 10 > n) {\n            long now = ord;\n            for (int i = 0, mul = 1