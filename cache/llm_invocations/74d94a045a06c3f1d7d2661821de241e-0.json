nge(n):\n        line = next(it)\n        for j, ch in enumerate(line):\n            if ch == 'Y':\n                block[i][j] = True\n            elif ch == 'Z':\n                red[i][j] = True\n            else:\n                a[i][j] = int(ch)\n    \n    # Read second grid\n    b = [[0]*n for _ in range(n)]\n    for i in range(n):\n        line = next(it)\n        for j, ch in enumerate(line):\n            if ch != 'Y' and ch != 'Z':\n                b[i][j] = int(ch)\n    \n    m = n * n\n    INF = 10**9\n    # distance matrix\n    dis = [[INF]*m for _ in range(m)]\n    for i in range(m):\n        dis[i][i] = 0\n    \n    dx = [0, -1, 0, 1]\n    dy = [1, 0, -1, 0]\n    for x in range(n):\n        for y in range(n):\n            if block[x][y] or red[x][y]:\n                continue\n            for d in range(4):\n                i = x + dx[d]\n                j = y + dy[d]\n                if 0 <= i < n and 0 <= j < n and not block[i][j] and not red[i][j]:\n                    dis[x*n+y][i*n+j] = 1\n    \n    # Floyd-Warshall\n    for k in range(m):\n        dk = dis[k]\n        for i in range(m):\n            di = dis[i]\n            dik = di[k]\n            if dik == INF:\n                continue\n            for j in range(m):\n                nd = dik + dk[j]\n                if nd < di[j]:\n                    di[j] = nd\n    \n    # BFS from red cells\n    dred = [INF]*m\n    q = deque()\n    for i in range(n):\n        for j in range(n):\n            if red[i][j]:\n                idx = i*n + j\n                dred[idx] = 0\n                q.append((i, j))\n    while q:\n        x, y = q.popleft()\n        idx = x*n + y\n        for d in range(4):\n            i = x + dx[d]\n            j = y + dy[d]\n            if 0 <= i < n and 0 <= j < n and not block[i][j] and not red[i][j]:\n                nid = i*n + j\n                if dred[nid] > INF//2:\n                    dred[nid] = dred[idx] + 1\n                    q.append((i, j))\n    \n    # Build flow network\n    total_nodes = max(2*m, 205) + 5  # ensure source/sink indices are covered\n    graph = [[] for _ in range(total_nodes)]\n    \n    class Edge:\n        __slots__ = ('to', 'rev', 'cap')\n        def __init__(self, to, rev, cap):\n            self.to = to\n            self.rev = rev\n            self.cap = cap\n    \n    def add_edge(u, v, cap):\n        graph[u].append(Edge(v, len(graph[v]), cap))\n        graph[v].append(Edge(u, len(graph[u])-1, 0))\n    \n    seen = [False]*m\n    for cur in range(m):\n        sx = cur // n\n        sy = cur % n\n        if block[sx][sy] or red[sx][sy]:\n            continue\n        # reset seen\n        for i in range(m):\n            seen[i] = False\n        q2 = deque()\n        q2.append((sx, sy))\n        seen[cur] = True\n        while q2:\n            x, y = q2.popleft()\n            id = x*n + y\n            if dis[cur][id] <= dt:\n                add_edge(cur<<1, (id<<1)|1, 1000)\n            if dis[cur][id] == dred[id]:\n                continue\n            for d in range(4):\n                i = x + dx[d]\n                j = y + dy[d]\n                nid = i*n + j\n                if 0 <= i < n and 0 <= j < n and not block[i][j] and not red[i][j]:\n                    if dis[cur][nid] <= dred[nid] and dis[cur][nid] <= dt and dis[cur][nid] > dis[cur][id] and not seen[nid]:\n                        seen[nid] = True\n                        q2.append((i, j))\n    \n    source = 203  # N-2\n    sink = 204    # N-1\n    for i in range(n):\n        for j in range(n):\n            idx = i*n + j\n            add_edge(source, idx<<1, a[i][j])\n            add_edge((idx<<1)|1, sink, b[i][j])\n    \n    # Max flow\n    def max_flow(s, t):\n        flow = 0\n        while True:\n            mark = [0]*total_nodes\n            def dfs(v, f):\n                if v == t:\n                    return f\n                mark[v] = 1\n                for e in graph[v]:\n                    if e.cap > 0 and mark[e.to] == 0:\n                        d = dfs(e.to, min(f, e.cap))\n                        if d:\n                            e.cap -= d\n                            graph[e.to][e.rev].cap += d\n                            return d\n                return 0\n            add = dfs(s, INF)\n            if add == 0:\n                break\n            flow += add\n        return flow\n    \n    print(max_flow(source, sink))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.960462772236497e-07, 0.0, 0.0, -6.210611172718927e-05, -0.0019405120983719826, 0.0, -3.0636318115284666e-05, -0.2840726673603058, -3.576278118089249e-07, 0.0, -5.960462772236497e-07, -0.011074976995587349, -0.7663310170173645, -0.16938695311546326, -0.16022704541683197, -5.960462772236497e-07, -0.6366390585899353, -9.536738616588991e-07, -0.00012599628826137632, 0.0, -0.0027608871459960938, -4.768360213347478e-06, -0.10020755231380463, -0.5762519240379333, -5.125986263010418e-06, -0.606401801109314, -2.3841855067985307e-07, 0.0, -0.0007098776986822486, -1.1920928244535389e-07, -7.152555099310121e-07, -6.198863957251888e-06, -3.576278118089249e-07, -0.06387059390544891, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.2516897186287679e-05, -3.6954811548639555e-06, -6.937739817658439e-05, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.0011850723531097174, 0.0, -0.00010132275929208845, -2.3245540432981215e-05, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.06196851283311844, -0.47408097982406616, -5.960462772236497e-07, -0.20518210530281067, -0.7917612791061401, -0.01571168377995491, -0.0019396792631596327, -0.33532723784446716, 0.0, -0.015895791351795197, -0.0005639393348246813, -0.00013422065239865333, -1.4305104514278355e-06, -0.0002674698771443218, -2.861018856492592e-06, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, -4.029192859889008e-05, 0.0, -0.07905244827270508, -1.07288