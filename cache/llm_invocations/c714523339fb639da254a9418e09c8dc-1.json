].v\n                    lt[es[r].y] = r\n                    if not used[es[r].y]:\n                        used[es[r].y] = 1\n                        bfs[rr] = es[r].y\n                        rr += 1\n        \n        if mi[EE] == float('inf'):\n            return -1\n        \n        now = EE\n        while now:\n            r = lt[now]\n            if es[r].ty == 1:\n                if (r & 1) == 1:\n                    es[r].v += 2 * d\n                    es[r ^ 1].v -= 2 * d\n                else:\n                    es[r].v += 2 * d\n                    es[r ^ 1].v -= 2 * d\n            es[r].c -= 1\n            es[r ^ 1].c += 1\n            now = es[r ^ 1].y\n        \n        return mi[EE]\n    \n    def solve(nn):\n        v = 0\n        for i in range(nn):\n            v += flow()\n        return v\n    \n    flow_clear(n * 100 + 1)\n    \n    for i in range(1, k + 1):\n        x = read_ints()[0]\n        add_edge(0, x, 1, 0, 0)\n    \n    for i in range(1, 99):\n        add_edge(1 + i * n, 100 * n + 1, float('inf'), 0, 0)\n    \n    for i in range(1, n + 1):\n        for j in range(1, 99):\n            add_edge(i + (j - 1) * n, i + j * n, float('inf'), C, 0)\n    \n    for i in range(1, m + 1):\n        x, y = read_ints()\n        for j in range(1, 99):\n            add_edge(x + (j - 1) * n, y + j * n, float('inf'), C + d, 1)\n            add_edge(y + (j - 1) * n, x + j * n, float('inf'), C + d, 1)\n    \n    print(solve(k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0001931004080688581, -1.6689286894688848e-06, -4.768370445162873e-07, -0.005098436959087849, -0.0003675738989841193, -0.0010349161457270384, -0.018547551706433296, -0.0002901133266277611, -8.344646857949556e-07, -0.02325849048793316, -0.28229478001594543, -0.2611859440803528, -5.960462772236497e-07, -0.0015037668636068702, 0.0, -8.702239938429557e-06, -0.01816108264029026, 0.0, -9.60780744208023e-05, 0.0, -2