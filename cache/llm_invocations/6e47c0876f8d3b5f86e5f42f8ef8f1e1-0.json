blic StringTokenizer tokenizer;\n\n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream), 32768);\n            tokenizer = null;\n        }\n\n        public String next() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n    }\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nint MAX = 1e9;\n\nclass SegmentTree {\npublic:\n    vector<int> tree;\n    vector<int> arr;\n    int size;\n\n    SegmentTree(int N) {\n        size = N;\n        arr.resize(N, MAX);\n        tree.resize(4 * N, MAX);\n    }\n\n    int query(int l, int r) {\n        if (r < 0) return MAX;\n        return queryUtil(1, 0, size - 1, max(0, l), r);\n    }\n\n    int queryUtil(int n, int tl, int tr, int l, int r) {\n        if (l > r) return MAX;\n        if (tl == l && tr == r) return tree[n];\n        int tm = (tl + tr) / 2;\n        return min(queryUtil(2 * n, tl, tm, l, min(r, tm)),\n                   queryUtil(2 * n + 1, tm + 1, tr, max(tm + 1, l), r));\n    }\n\n    void assign(int n, int val) {\n        arr[n] = val;\n        int tl = 0;\n        int tr = size - 1;\n        int a = 1;\n        while (tl < tr) {\n            int tm = (tl + tr) >> 1;\n            if (n <= tm) {\n                tr = tm;\n                a = 2 * a;\n            } else {\n                tl = tm + 1;\n                a = 2 * a + 1;\n      