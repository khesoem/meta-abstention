answer, contribution) : mod.subtract(answer, contribution);\n            }\n\n            System.out.println(answer);\n        } catch (IOException e) {\n            throw new UncheckedIOException(e);\n        }\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998244353L;\n        private long[] factorial, invFactorial;\n\n        public void setup(int max) {\n            factorial = new long[max + 1];\n            invFactorial = new long[max + 1];\n            factorial[0] = 1;\n            for (int i = 1; i <= max; i++) factorial[i] = (factorial[i - 1] * i) % MOD;\n            invFactorial[max] = modPow(factorial[max], MOD - 2);\n            for (int i = max; i > 0; i--) invFactorial[i - 1] = (invFactorial[i] * i) % MOD;\n        }\n\n        public long binomial(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return (factorial[n] * invFactorial[r] % MOD) * invFactorial[n - r] % MOD;\n        }\n\n        public long modInverse(int x) {\n            return modPow(x, MOD - 2);\n        }\n\n        public long add(long a, long b) {\n            a %= MOD; b %= MOD;\n            long s = a + b;\n            return s >= MOD ? s - MOD : s;\n        }\n\n        public long subtract(long a, long b) {\n            a %= MOD; b %= MOD;\n            long d = a - b;\n            return d < 0 ? d + MOD : d;\n        }\n\n        public long multiply(long a, long b) {\n            return (a * b) % MOD;\n        }\n\n        private long modPow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = (res * base) % MOD;\n                base = (base * base) % MOD;\n                exp >>= 1;\n            }\n            return res;\n        }\n    }\n}\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <stdexcept>\n\nusing namespace std;\n\nclass Mod998 {\nprivate:\n    static const long long MOD = 998244353LL;\n    vector<long long> factorial;\n    vector<long long> invFactorial;\n\npublic:\n    void setup(int max) {\n        factorial.resize(max + 1);\n        invFactorial.resize(max + 1);\n        factorial[0] = 1;\n        for (int i = 1; i <= max; i++) {\n            factorial[i] = (factorial[i - 1] * i) % MOD;\n        }\n        invFactorial[max] = modPow(factorial[max], MOD - 2);\n        for (int i = max; i > 0; i--) {\n            invFactorial[i - 1] = (invFactorial[i] * i) % MOD;\n        }\n    }\n\n    long long binomial(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return ((factorial[n] * invFactorial[r]) % MOD) * invFactorial[n - r] % MOD;\n    }\n\n    long long modInverse(int x) {\n        return modPow(x, MOD - 2);\n    }\n\n    long long add(long long a, long long b) {\n        a %= MOD; b %= MOD;\n        long long s = a + b;\n        return s >= MOD ? s - MOD : s;\n    }\n\n    long long subtract(long long a, long long b) {\n        a %= MOD; b %= MOD;\n        long long d = a - b;\n        return d < 0 ? d + MOD : d;\n    }\n\n    long long multiply(long long a, long long b) {\n        return (a * b) % MOD;\n    }\n\nprivate:\n    long long modPow(long long base, long long exp) {\n        long long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n};\n\nint main() {\n    try {\n        string line;\n        getline(cin, line);\n        istringstream iss(line);\n        vector<string> tokens;\n        string token;\n        while (iss >> token) {\n            tokens.push_back(token);\n        }\n        \n        int n = stoi(tokens[0]);\n        int m = stoi(tokens[1]