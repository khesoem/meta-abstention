{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 0x3f3f3f3f;\nconst int Z = 100;\nconst int MAXN = Z * Z + 5;\nconst int MAXM = Z * Z * Z + 5;\n\nint head[MAXN], to[MAXM], cap[MAXM], cost[MAXM], nxt[MAXM];\nint dist[MAXN], inQueue[MAXN], pre[MAXN], preEdge[MAXN];\nint tot;\n\nvoid addEdge(int u, int v, int flow, int c) {\n    to[tot] = v; cost[tot] = c; cap[tot] = flow; nxt[tot] = head[u]; head[u] = tot++;\n    to[tot] = u; cost[tot] = -c; cap[tot] = 0; nxt[tot] = head[v]; head[v] = tot++;\n}\n\nbool spfa(int s, int t) {\n    deque<int> q;\n    memset(dist, 0x3f, sizeof(dist));\n    memset(inQueue, 0, sizeof(inQueue));\n    memset(pre, -1, sizeof(pre));\n    dist[s] = 0;\n    q.push_back(s);\n    inQueue[s] = 1;\n    while (!q.empty()) {\n        int u = q.front(); q.pop_front();\n        inQueue[u] = 0;\n        for (int i = head[u]; ~i; i = nxt[i]) {\n            int v = to[i];\n            if (cap[i] > 0 && dist[v] > dist[u] + cost[i]) {\n                dist[v] = dist[u] + cost[i];\n                pre[v] = u;\n                preEdge[v] = i;\n                if (!inQueue[v]) {\n                    inQueue[v] = 1;\n                    if (!q.empty() && dist[v] < dist[q.front()]) {\n                        q.push_front(v);\n                    } else {\n                        q.push_back(v);\n                    }\n                }\n            }\n        }\n    }\n    return dist[t] < INF;\n}\n\nint minCostMaxFlow(int s, int t) {\n    int totalCost = 0;\n    while (spfa(s, t)) {\n        int flow = INF;\n        for (int v = t; v != s; v = pre[v]) {\n            flow = min(flow, cap[preEdge[v]]);\n        }\n        for (int v = t; v != s; v = pre[v]) {\n            int e = preEdge[v];\n            cap[e] -= flow;\n            cap[e ^ 1] += flow;\n        }\n        totalCost += dist[t] * flow;\n    }\n    return totalCost;\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int s = 0, t = n * 100 + 1;\n\n    for (int i = 1; i <= 100; ++i) addEdge(i, t, 100, 0);\n    for (int i = 1; i <= k; ++i) {\n        int v; scanf(\"%d\", &v);\n        addEdge(s, (v - 1) * 100 + 1, 1, 0);\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n        }\n    }\n    for (int i = 1; i <= m; ++i) {\n        int u, v; scanf(\"%d%d\", &u, &v);\n        for (int j = 1; j < 100; ++j) {\n            int idx = (u - 1) * 100 + j;\n            int idy = (v - 1) * 100 + j + 1;\n            for (int p = 1; p <= 20; ++p) {\n                addEdge(idx, idy, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n            }\n            int idx2 = (v - 1) * 100 + j;\n            int idy2 = (u - 1) * 100 + j + 1;\n            for (int p = 1; p <= 20; ++p) {\n                addEdge(idx2, idy2, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n            }\n        }\n    }\n\n    printf(\"%d\\n\", minCostMaxFlow(s, t));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 0x3f3f3f3f\nZ = 100\nMAXN = Z * Z + 5\nMAXM = Z * Z * Z + 5\n\nhead = [-1] * MAXN\nto = [0] * MAXM\ncap = [0] * MAXM\ncost = [0] * MAXM\nnxt = [0] * MAXM\ndist = [0] * MAXN\ninQueue = [0] * MAXN\npre = [0] * MAXN\npreEdge = [0] * MAXN\ntot = 0\n\ndef addEdge(u, v, flow, c):\n    global tot\n    to[tot] = v\n    cost[tot] = c\n    cap[tot] = flow\n    nxt[tot] = head[u]\n    head[u] = tot\n    tot += 1\n    to[tot] = u\n    cost[tot] = -c\n    cap[tot] = 0\n    nxt[tot] = head[v]\n    head[v] = tot\n    tot += 1\n\ndef spfa(s, t):\n    global dist, inQueue, pre, preEdge\n    q = deque()\n    dist = [INF] * MAXN\n    inQueue = [0] * MAXN\n    pre = [-1] * MAXN\n    preEdge = [-1] * MAXN\n    dist[s] = 0\n    q.append(s)\n    inQueue[s] = 1\n    while q:\n        u = q.popleft()\n        inQueue[u] = 0\n        i = head[u]\n        while i != -1:\n            v = to[i]\n            if cap[i] > 0 and dist[v] > dist[u] + cost[i]:\n                dist[v] = dist[u] + cost[i]\n                pre[v] = u\n                preEdge[v] = i\n                if not inQueue[v]:\n                    inQueue[v] = 1\n                    if q and dist[v] < dist[q[0]]:\n                        q.appendleft(v)\n                    else:\n                        q.append(v)\n            i = nxt[i]\n    return dist[t] < INF\n\ndef minCostMaxFlow(s, t):\n    totalCost = 0\n    while spfa(s, t):\n        flow = INF\n        v = t\n        while v != s:\n            flow = min(flow, cap[preEdge[v]])\n            v = pre[v]\n        v = t\n        while v != s:\n            e = preEdge[v]\n            cap[e] -= flow\n            cap[e ^ 1] += flow\n            v = pre[v]\n        totalCost += dist[t] * flow\n    return totalCost\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    s = 0\n    t = n * 100 + 1\n\n    # edges from time layers to sink\n    for i in range(1, 101):\n        addEdge(i, t, 100, 0)\n\n    # source to starting positions\n    for _ in range(k):\n        v = next(it)\n        addEdge(s, (v - 1) * 100 + 1, 1, 0)\n\n    # waiting edges (stay in same node)\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c)\n\n    # movement edges\n    for _ in range(m):\n        u = next(it)\n        v = next(it)\n        for j in range(1, 100):\n            idx = (u - 1) * 100 + j\n            idy = (v - 1) * 100 + j + 1\n            for p in range(1, 21):\n                addEdge(idx, idy, 1, c + (p * p - (p - 1) * (p - 1)) * d)\n            idx2 = (v - 1) * 100 + j\n            idy2 = (u - 1) * 100 + j + 1\n            for p in range(1, 21):\n                addEdge(idx2, idy2, 1, c + (p * p - (p - 1) * (p - 1)) * d)\n\n    result = minCostMaxFlow(s, t)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.2291887944447808e-05, 0.0, 0.0, -0.0003522014303598553, -0.0046852570958435535, -1.1920928244535389e-07, -6.437280717364047e-06, -2.1934269170742482e-05, -3.576278118089249e-07, 0.0, -1.0728830375228426e-06, -0.0002108589978888631, -0.006769106257706881, -3.576278118089249e-07, -6.556489552167477e-06, -0.0015048381173983216, 0.0, -2.3841855067985307e-07, -0.0005529781919904053, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -0.013447300530970097, -0.0019464610377326608, -3.6954811548639555e-06, 0.0, -2.3841855067985307e-07, -2.169585604860913e-05, -1.4305104514278355e-06, -8.34461570775602e-06, -2.3841855067985307e-07, -3.2186455882765586e-06, -1.6689160474925302e-05, -1.1920928