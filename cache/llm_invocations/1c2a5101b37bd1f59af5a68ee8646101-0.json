}\n\t\t\n\t\tfor (int i = 0; i < 26 ; i++) {\n\t\t\tif (m < count[i]) {\n\t\t\t\tm = count[i];\n\t\t\t\tx = i;\n\t\t\t}\n\t\t}\n\n\t\tif (2 * m <= t) {\n\t\t\tSystem.out.println(ans);\n\t\t\treturn;\n\t\t}\n\t\tArrayList<Integer> list = new ArrayList<Integer>();\n\n\t\tfor (int i = 0; i < n/2; i++) {\n\t\t\tif ((int)(s[i] - 'a') != x && (int)(s[n-i-1] - 'a') != x && s[i] != s[n-i-1]) {\n\t\t\t\tlist.add(Math.min(beauty[i], beauty[n-i-1]));\n\t\t\t}\n\t\t}\n\n\t\tCollections.sort(list);\n\t\tfor (int i = 0; i < 2 * m - t; i++) {\n\t\t\tans -= list.get(i);\n\t\t}\n\t\tSystem.out.print(ans);\n\t}\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<original_code>\nimport sys\n\nMOD = 1000000007\nEPS = 1e-6\nDEBUG = True\n\ndef main():\n    br = sys.stdin\n    n = int(br.readline().strip())\n    s = list(br.readline().strip())\n    tokens = br.readline().strip().split()\n    beauty = [int(token) for token in tokens]\n    \n    ans = sum(beauty)\n    m = 0\n    x = 0\n    t = 0\n    b = [0] * 101\n    count = [0] * 26\n\n    for i in range(n):\n        ans -= beauty[i]\n        count[ord(s[i]) - ord('a')] += 1\n\n    for i in range(n // 2):\n        if s[i] == s[n - i - 1]:\n            t += 1\n            ans += min(beauty[i], beauty[n - i - 1])\n\n    for i in range(26):\n        if m < count[i]:\n            m = count[i]\n            x = i\n\n    if 2 * m <= t:\n        print(ans)\n        return\n\n    list_ = []\n\n    for i in range(n // 2):\n        if (ord(s[i]) - ord('a')) != x and (ord(s[n - i - 1]) - ord('a')) != x and s[i] != s[n - i - 1]:\n            list_.append(min(beauty[i], beauty[n - i - 1]))\n\n    list_.sort()\n    for i in range(2 * m - t):\n        ans += list_[i]\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</original_code>\n<translated_code>\nimport sys\n\nMOD = 1000000007\nEPS = 1e-6\nDEBUG = True\n\ndef main():\n    br =