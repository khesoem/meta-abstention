ons import deque\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    LAYERS = 101\n    total_nodes = n * LAYERS + 2\n    SOURCE = total_nodes - 2\n    TARGET = total_nodes - 1\n    INF = 10**18\n\n    edges = []  # list of [to, cap, flow, cost]\n    adj = [[] for _ in range(total_nodes)]\n\n    def residual(eid):\n        return edges[eid][1] - edges[eid][2]\n\n    def add_edge(u, v, capacity, cost_value):\n        adj[u].append(len(edges))\n        edges.append([v, capacity, 0, cost_value])\n        adj[v].append(len(edges))\n        edges.append([u, 0, 0, -cost_value])\n\n    # read starting positions\n    for _ in range(k):\n        x = next(it) - 1\n        add_edge(SOURCE, x, 1, 0)\n\n    # edges from time layers to target\n    for t in range(LAYERS):\n        add_edge(t * n, TARGET, k, t * c)\n\n    # road edges\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        for t in range(LAYERS - 1):\n            for j in range(k):\n                add_edge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1))\n        for t in range(LAYERS - 1):\n            for j in range(k):\n                add_edge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1))\n\n    # stay edges\n    for v in range(n):\n        for t in range(LAYERS - 1):\n            add_edge(v + t * n, v + t * n + n, k, 0)\n\n    answer = 0\n\n    def push_flow_slf():\n        nonlocal answer\n        dist = [INF] * total_nodes\n        pred = [-1] * total_nodes\n        pe = [-1] * total_nodes\n        inq = [False] * total_nodes\n\n        dq = deque()\n        dist[SOURCE] = 0\n        dq.append(SOURCE)\n        inq[SOURCE] = True\n\n        while dq:\n            u = dq.popleft()\n            inq[u] = False\n            for eid in adj[u]:\n                if residual(eid) == 0:\n                    continue\n                v = edges[eid][0]\n                nd = dist[u] + edges[eid][3]\n                if dist[v] > nd:\n                    dist[v] = nd\n                    pred[v] = u\n                    pe[v] = eid\n                    if not inq[v]:\n                        inq[v] = True\n                        if dq and dist[v] < dist[dq[0]]:\n                            dq.appendleft(v)\n                        else:\n                            dq.append(v)\n\n        # augment flow along the path\n        cur = TARGET\n        while cur != SOURCE:\n            eid = pe[cur]\n            edges[eid][2] += 1\n            edges[eid ^ 1][2] -= 1\n            cur = pred[cur]\n\n        answer += dist[TARGET]\n\n    for _ in range(k):\n        push_flow_slf()\n\n    print(answer)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010358751023886725, 0.0, 0.0, -0.0002967870968859643, -0.006756555289030075, -1.1920928244535389e-07, -0.018172554671764374, -0.0026100161485373974, -1.6689286894688848e-06, -2.3841855067985307e-07, -9.536738616588991e-07, -0.0011759040644392371, -0.3893500566482544, -0.5333284139633179, -0.38689327239990234, -1.0728830375228426e-06, -0.00019822540343739092, -2.3841855067985307e-07, -0.1602734625339508, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.008617358282208443, 0.0, -0.0031777145341038704, -1.9073468138230965e-06, -1.0132738680113107e-05, -0.47466063499450684, -1.1920928244535389e-07, -0.0009114163694903255, 0.0, -0.00027164106722921133, -0.0007101159426383674, -0.0002232540718978271, -0.00043096792069263756, -2.9802276912960224e-06, 0.0, -0.31332579255104065, 0.0, -2.3841855067985307e-07, -7.056941103655845e-05, 0.0, 0.0, -9.298280929215252e-06, 0.0, -6.675497570540756e-05, -0.0003426679759286344, 0.0, -4.768370445162873e-07, -7.152531907195225e-06, 0.0, -2.610649426060263e-05, -0.0010767144849523902, 0.0, 0.0, -1.0132738680113107e-05, -1.1920928244535389e-07, -2.50339189733495e-06