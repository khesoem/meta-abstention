.println(maxCuts);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\nint main() {\n    int n, b;\n    cin >> n >> b;\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n    }\n    \n    vector<int> prefixOdd(n+1, 0);\n    vector<int> prefixEven(n+1, 0);\n    \n    for (int i = 0; i < n; i++) {\n        prefixOdd[i+1] = prefixOdd[i] + (a[i] % 2);\n        prefixEven[i+1] = prefixEven[i] + (1 - a[i] % 2);\n    }\n    \n    vector<int> costs;\n    for (int i = 1; i < n; i++) {\n        if (prefixEven[i] == prefixOdd[i]) {\n            costs.push_back(abs(a[i-1] - a[i]));\n        }\n    }\n    \n    sort(costs.begin(), costs.end());\n    int used = 0, maxCuts = 0;\n    for (int cost : costs) {\n        if (used + cost <= b) {\n            used += cost;\n            maxCuts++;\n        } else {\n            break;\n        }\n    }\n    cout << maxCuts << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0001294529065489769, -4.291525328881107e-06, -1.1920928244535389e-07, -4.410646579344757e-05, -1.6689286894688848e-06, -1.168244216387393e-05, -1.0728830375228426e-06, -7.748573807475623e-06, -1.2993727978027891e-05, -2.1219027985353023e-05, -2.3841855067985307e-07, -4.291525328881107e-06, -1.0728830375228426e-06, -8.892617915989831e-05, -5.960462772236497e-07, -5.8530047681415454e-05, -5.364403477869928e-06, -0.020599473267793655, -0.4740810692310333, -0.03380747511982918, -2.2411095415009186e-05, -3.099436753473128e-06, -7.152555099310121e-07, -1.5497195136049413e-06, -1.5497195136049413e-06, -9.536738616588991e-07, -6.198863957251888e-06, -7.152555099310121e-07, -0.003037246409803629, 0.0, -1.4066597032069694e-05, -2.3841855067985307e-07, -2.145764938177308e-