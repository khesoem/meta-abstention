n\n            if temp < min:\n                mina = int(math.floor(a))\n                minb = b\n                min = temp\n            elif temp == min:\n                if math.floor(a) < mina:\n                    mina = int(math.floor(a))\n                    minb = b                   \n            diff(x, y, math.ceil(a), b)\n            temp = tempa / tempb\n\n            if temp < min:\n                mina = int(math.ceil(a))\n                minb = b\n                min = temp\n            elif temp == min:\n                if math.ceil(a) < mina:\n                    mina = int(math.ceil(a))\n                    minb = b                   \n    gc = gcd (mina, minb)\n    if gc != 1:       \n        mina = mina / gc\n        minb = minb / gc\n    print(f\"{mina}/{minb}\")\n    return\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.01689915731549263, -0.001141849672421813, -0.00036507140612229705, -1.3351351299206726e-05, -2.002696055569686e-05, -1.2397689715726301e-05, -7.390948667307384e-06, -3.45700973412022e-05, -0.023294245824217796, -6.41325386823155e-05, -8.344646857949556e-07, -0.00012909532233607024, -5.2689116273541003e-05, -0.0002337421028641984, -1.0251946150674485e-05, -0.00043275527423247695, -2.1219027985353023e-05, -1.0132738680113107e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -9.536738616588991e-07, -1.5258672647178173e-05, -1.1920858014491387e-05, -0.0001255195093108341, -3.981510963058099e-05, -1.1324817933200393e-05, -2.288792165927589e-05, -1.311301275563892e-06, -8.344646857949556e-07, -1.1920928244535389e-07, -1.7881377516459906e-06, -1.6689160474925302e-05, -5.960462772236497e-07, -5.364403477869928e-06, -1.5139465176616795e-05, -7.867782187531702e-06, -2.3841855067985307e-07, -9.775113539944869e-06, -5.960462772236497e-07, -1.4305104514278355e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -5.006777428206988e-06, -1.1920928244535389e-07, -2.38418550679853