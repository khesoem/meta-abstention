i64>> fracs;\n    \n    for (i64 i = 1; i <= n; ++i) {\n        i64 mini = (x * i) / y;\n        i64 maxi = ceil_div(x * i, y);\n        \n        if ((mini + maxi) * y > 2 * x * i) {\n            i64 g = gcd(i, mini);\n            fracs.emplace(i / g, mini / g);\n        } else {\n            i64 g = gcd(i, maxi);\n            fracs.emplace(i / g, maxi / g);\n        }\n    }\n    \n    auto best = *fracs.begin();\n    \n    for (const auto& [q, p] : fracs) {\n        i64 curr = p * y;\n        i64 target = x * q;\n        \n        if (curr == target) {\n            best = {q, p};\n        } else if (curr > target) {\n            if (best.second * y > x * best.first) {\n                if (p * best.first < best.second * q) {\n                    best = {q, p};\n                }\n            } else {\n                if (2 * x * best.first * q > y * (best.second * q + best.first * p)) {\n                    best = {q, p};\n                }\n            }\n        } else {\n            if (best.second * y > x * best.first) {\n                if (2 * x * best.first * q < y * (best.second * q + best.first * p)) {\n                    best = {q, p};\n                }\n            } else {\n                if (p * best.first > best.second * q) {\n                    best = {q, p};\n                }\n            }\n        }\n    }\n    \n    i64 g = gcd(best.first, best.second);\n    std::cout << best.second / g << '/' << best.first / g << '\\n';\n}\n\nint main() {\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    \n    int t = 1;\n    while (t--) solve();\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <iostream>\n#include <vector>\n#include <cmath>\n#include <algorithm>\n#include <climits>\n#include <utility>\n\nusing i64 = long long;\n\ni64 gcd(i64 a, i64 b) {\n    while (b) {\n        i64 t =