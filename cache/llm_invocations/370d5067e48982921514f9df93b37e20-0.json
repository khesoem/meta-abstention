{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n#define maxn 15000\nstruct Edge{\n    int to,cap,flow,cost;\n};\nvector<Edge> e;\nvector<int> head[maxn];\nlong long ans,dis[maxn];\nint n,m,k,c,d,p[maxn],pe[maxn],inq[maxn],s=9998,t=9999,cur,i,j;\nvoid add_edge(int x, int y, int c, int cost) {\n\thead[x].push_back(e.size()),e.push_back(Edge{y, c, 0, cost});\n\thead[y].push_back(e.size()),e.push_back(Edge{x, 0, 0, -cost});\n}\nvoid push_rebel() {\n    fill(dis,dis+10000,(long long)1e18),fill(p,p+10000,-1),fill(pe,pe+10000,-1),fill(inq,inq+10000,0);\n    dis[s] = 0;\n    queue<int> q;\n    q.push(s),inq[s] = 1,cur = t;\n    while(!q.empty()){\n        int k = q.front();q.pop();\n        inq[k] = 0;\n        for(auto x: head[k]) {\n            if(!(e[x].cap - e[x].flow)) continue;\n            int c = e[x].cost,y = e[x].to;\n            if(dis[y]>dis[k]+c) {\n                dis[y] = dis[k] + c,p[y] = k,pe[y] = x;\n                if(!inq[y]) inq[y] = 1,q.push(y);\n            }\n        }\n    }\n\twhile(cur != s) {\n\t\te[pe[cur]].flow++;\n\t\te[pe[cur] ^ 1].flow--;\n\t\tcur = p[cur];\n    }\n\tans += dis[t];\n}\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    int x,y;\n    for(int i = 1; i<=k;i++) { cin >> x;x--;add_edge(s,x,1,0);}\n    for(int i = 1; i<=101;i++) add_edge((i-1)*n,t,k,(i-1)*c);\n    for(int i = 1; i<=m; i++){\n\t\tcin >> x >> y;x--,y--;\n\t\tfor(int i = 1; i<=100; i++) for(int j = 1; j<=k; j++)\n\t\t\tadd_edge(x+(i-1)*n,y+(i-1)*n+n,1,d*((j-1)*2+1)),add_edge(y+(i-1)*n,x+(i-1)*n+n,1,d*((j-1)*2+1));\n \t}\n \tfor(int i = 1; i<=n; i++) for(int j = 1; j<=100; j++) add_edge(i-1+(j-1)*n,i-1+(j-1)*n+n,k,0);\n    for(int i = 1;i<=k;i++) push_rebel();\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef add_edge(x, y, cap, cost):\n    head[x].append(len(e))\n    e.append([y, cap, 0, cost])\n    head[y].append(len(e))\n    e.append([x, 0, 0, -cost])\n\ndef push_rebel():\n    global ans\n    INF = 10**18\n    dis = [INF] * max_node\n    p = [-1] * max_node\n    pe = [-1] * max_node\n    inq = [0] * max_node\n    dis[s] = 0\n    q = deque()\n    q.append(s)\n    inq[s] = 1\n    cur = t\n    while q:\n        k = q.popleft()\n        inq[k] = 0\n        for idx in head[k]:\n            edge = e[idx]\n            if edge[1] - edge[2] == 0:\n                continue\n            c = edge[3]\n            y = edge[0]\n            if dis[y] > dis[k] + c:\n                dis[y] = dis[k] + c\n                p[y] = k\n                pe[y] = idx\n                if not inq[y]:\n                    inq[y] = 1\n                    q.append(y)\n    while cur != s:\n        e[pe[cur]][2] += 1\n        e[pe[cur] ^ 1][2] -= 1\n        cur = p[cur]\n    ans += dis[t]\n\ndef main():\n    global e, head, s, t, ans, max_node\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    s = 9998\n    t = 9999\n    # Estimate max node index: source, sink, and time layers up to 101*n\n    max_node = max(s, t, 101 * n + 1)  # +1 for safety\n    e = []\n    head = [[] for _ in range(max_node)]\n    ans = 0\n    # source to start nodes\n    for _ in range(k):\n        x = int(next(it)) - 1\n        add_edge(s, x, 1, 0)\n    # sink edges from first node of each time layer\n    for i in range(1, 102):  # i from 1 to 101 inclusive\n        add_edge((i-1)*n, t, k, (i-1)*c)\n    # road edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for time in range(1, 101):  # i from 1 to 100\n            for j in range(1, k+1):  # j from 1 to k\n                cost = d * ((j-1)*2 + 1)\n                add_edge(x + (time-1)*n, y + (time-1)*n + n, 1, cost)\n                add_edge(y + (time-1)*n, x + (time-1)*n + n, 1, cost)\n    # stay edges\n    for node in range(n):\n        for time in range(1, 101):\n            add_edge(node + (time-1)*n, node + (time-1)*n + n, k, 0)\n    # run min-cost max-flow for k units\n    for _ in range(k):\n        push_rebel()\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.794698856538162e-05, -1.1920928244535389e-07, 0.0, -6.341733387671411e-05, -0.2015535682439804, -9.643566590966657e-05, -1.7762025890988298e-05, -6.05564855504781e-05, -3.576278118089249e-07, 0.0, -1.0728830375228426e-06, -0.0003781795676331967, -0.18271362781524658, -0.5663262605667114, -8.344646857949556e-07, -0.0795014277100563, -0.0007101159426383674, 0.0, -1.1920928244535389e-07, -0.31358692049980164, -1.9788545614574105e-05, 0.0, -0.008619248867034912, -1.1324817933200393e-05, -0.25498634576797485, -1.0728830375228426e-06, 0.0, 0.0, -6.198863957251888e-06, -0.02325371652841568, -6.19869097135961e-05, 0.0, 0.0, 0.0, -9.42901024245657e-05, -