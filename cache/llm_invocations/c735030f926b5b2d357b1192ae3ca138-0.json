ix\n    id_mat = Matrix(size)\n    for i in range(size):\n        id_mat[i][i] = 1\n\n    # f[0] = identity with first column set to 1\n    f = [None] * ndigits\n    f[0] = Matrix(size)\n    for i in range(size):\n        for j in range(size):\n            f[0][i][j] = id_mat[i][j]\n    for i in range(size):\n        f[0][i][0] = 1\n\n    # compute f[1..ndigits-1]\n    for d in range(1, ndigits):\n        f[d] = Matrix(size)\n        for i in range(size):\n            f[d][i][i] = 1  # identity\n        for off in range(k):\n            # calc_matrix(d-1, off)\n            cm = Matrix(size)\n            for i in range(size):\n                for j in range(size):\n                    ni = i if i == k else (i + off) % k\n                    nj = j if j == k else (j + off) % k\n                    cm[ni][nj] = f[d-1][i][j]\n            f[d] = f[d] * cm\n\n    # main loop\n    ndigits -= 1\n    pw = 1\n    for _ in range(ndigits):\n        pw *= k\n\n    ans = Matrix(size)\n    for i in range(size):\n        ans[i][i] = 1  # identity\n\n    cur = 0\n    while cur < n:\n        while cur + pw <= n:\n            # calc_matrix(ndigits, sum_digits(cur))\n            off = sum_digits(cur, k)\n            cm = Matrix(size)\n            for i in range(size):\n                for j in range(size):\n                    ni = i if i == k else (i + off) % k\n                    nj = j if j == k else (j + off) % k\n                    cm[ni][nj] = f[ndigits][i][j]\n            ans = ans * cm\n            cur += pw\n        pw //= k\n        ndigits -= 1\n\n    total = 0\n    for i in range(size):\n        total = (total + ans[k][i]) % MOD\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.9802276912960224e-06, 0.0, 0.0, -0.0005575056420639157, -1.294417381286621, -5.960462772236497e-07, -0.0002040654799202457, -0.008649622090160847, -0.006716296076774597, 0.0, -0.004078404977917671, -9.5367386