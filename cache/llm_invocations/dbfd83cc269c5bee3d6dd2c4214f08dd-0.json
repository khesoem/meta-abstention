t.println(\"YES\");\n            return;\n        }\n        \n        List<Long> combination = new ArrayList<>();\n        combination.add(0L);\n        \n        long currentPower = 1;\n        for (int i = 0; i <= 100; i++) {\n            if (i > 0) {\n                try {\n                    currentPower = Math.multiplyExact(currentPower, w);\n                } catch (ArithmeticException e) {\n                    break;\n                }\n            }\n            \n            if (currentPower > (long) 2 * Integer.MAX_VALUE) {\n                break;\n            }\n            \n            int size = combination.size();\n            for (int j = 0; j < size; j++) {\n                long sum = combination.get(j) + currentPower;\n                if (sum <= (long) 2 * Integer.MAX_VALUE) {\n                    combination.add(sum);\n                }\n            }\n        }\n        \n        Collections.sort(combination);\n        \n        if (Collections.binarySearch(combination, m) >= 0) {\n            System.out.println(\"YES\");\n            return;\n        }\n        \n        for (Long element : combination) {\n            if (element + m <= (long) 2 * Integer.MAX_VALUE && \n                Collections.binarySearch(combination, element + m) >= 0) {\n                System.out.println(\"YES\");\n                return;\n            }\n        }\n        \n        System.out.println(\"NO\");\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class CodeForce308C {\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader in = new BufferedReader(new InputStreamReader(System.in));\n        String[] tokens = in.readLine().trim().split(\"\\\\s+\");\n        long w = Long.parseLong(tokens[0]);\n        long m = Long.parseLong(tokens[1]);\n        \n     