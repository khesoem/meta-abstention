rial;\n    static long[] invFactorial;\n\n    static void init() {\n        factorial = new long[MAX_N];\n        invFactorial = new long[MAX_N];\n        factorial[0] = 1;\n        invFactorial[0] = modPow(1, MOD - 2);\n        for (int i = 1; i < MAX_N; i++) {\n            factorial[i] = (factorial[i - 1] * i) % MOD;\n            invFactorial[i] = (invFactorial[i - 1] * modPow(i, MOD - 2)) % MOD;\n        }\n    }\n\n    static long nCr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return (factorial[n] * invFactorial[r] % MOD) * invFactorial[n - r] % MOD;\n    }\n\n    static long modPow(long base, long exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static long modInverse(long a) {\n        return modPow(a, MOD - 2);\n    }\n\n    static void compute() {\n        init();\n        Scanner in = new Scanner(System.in);\n        int n = in.nextInt();\n        int k = in.nextInt();\n        if (k == 0) {\n            System.out.println(factorial[n]);\n            return;\n        }\n        if (n <= k) {\n            System.out.println(0);\n            return;\n        }\n        long waysToChoose = nCr(n, k);\n        int remaining = n - k;\n        long inclusionExclusion = 0;\n        for (int i = 0; i <= remaining; i++) {\n            long term = nCr(remaining, i) * modPow(remaining - i, n) % MOD;\n            if ((i & 1) == 1) {\n                inclusionExclusion = (inclusionExclusion - term + MOD) % MOD;\n            } else {\n                inclusionExclusion = (inclusionExclusion + term) % MOD;\n            }\n        }\n        long answer = (2 * ((waysToChoose * inclusionExclusion) % MOD)) % MOD;\n        System.out.println(answer);\n    }\n\n    public static void main(String[] args) {\n        compute();\n    }\n}\n</original_code>\n"}], "