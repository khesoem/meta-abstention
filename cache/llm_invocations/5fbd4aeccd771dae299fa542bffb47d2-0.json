 >> n >> m;\n    \n    vector<long long> a(n);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n    }\n    \n    vector<long long> a1, a2;\n    int n1 = n / 2;\n    \n    // Generate all subset sums for first half\n    function<void(int, long long)> sums1;\n    sums1 = [&](int i, long long current_sum) {\n        if (i == n1) {\n            a1.push_back(current_sum % m);\n        } else {\n            sums1(i + 1, (current_sum + a[i]) % m);\n            sums1(i + 1, current_sum);\n        }\n    };\n    \n    // Generate all subset sums for second half\n    function<void(int, long long)> sums2;\n    sums2 = [&](int i, long long current_sum) {\n        if (i == n) {\n            a2.push_back(current_sum % m);\n        } else {\n            sums2(i + 1, (current_sum + a[i]) % m);\n            sums2(i + 1, current_sum);\n        }\n    };\n    \n    sums1(0, 0);\n    sums2(n1, 0);\n    \n    long long ans = 0;\n    set<long long> a1_set(a1.begin(), a1.end());\n    vector<long long> a1_sorted(a1_set.begin(), a1_set.end());\n    sort(a1_sorted.begin(), a1_sorted.end());\n    \n    for (long long val : a2) {\n        long long target = m - val;\n        auto it = lower_bound(a1_sorted.begin(), a1_sorted.end(), target);\n        \n        if (it != a1_sorted.begin()) {\n            it--;\n            long long candidate = (*it + val) % m;\n            if (candidate > ans) {\n                ans = candidate;\n            }\n        }\n    }\n    \n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001426833332516253, -3.2186455882765586e-06, -3.576278118089249e-07, -1.8596476365928538e-05, -2.3841855067985307e-07, -0.0003597089380491525, -1.1920928244535389e-07, -3.576272320060525e-06, -2.3841855067985307e-07, -0.002092316746711731, -3.576278118089249e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -0.020067404955625534, -2.622600959512056e-06, -0.00014053787162993103, -7.1525550993