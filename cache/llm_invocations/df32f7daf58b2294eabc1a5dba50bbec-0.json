[i][i] = 1;\n                for (int j = 1; j < i; j++) {\n                    nCr[i][j] = (nCr[i-1][j] + nCr[i-1][j-1]) % MOD;\n                }\n            }\n\n            long[][][] dist = new long[200][200][2];\n            long[][][] count = new long[200][200][2];\n            for (int i = 0; i < 200; i++) {\n                for (int j = 0; j < 200; j++) {\n                    Arrays.fill(dist[i][j], INF);\n                }\n            }\n\n            dist[0][0][0] = 0;\n            count[0][0][0] = 1;\n\n            Queue<Node> q = new ArrayDeque<>();\n            q.add(new Node(0, 0, 0, 0));\n\n            while (!q.isEmpty()) {\n                Node node = q.poll();\n                int x = node.x;\n                int y = node.y;\n                int side = node.side;\n                long d = dist[x][y][side];\n\n                if (side == 0) {\n                    int rem50 = cnt50 - x;\n                    int rem100 = cnt100 - y;\n                    for (int take50 = 0; take50 <= rem50; take50++) {\n                        for (int take100 = 0; take100 <= rem100; take100++) {\n                            if (take50 + take100 == 0) continue;\n                            if (take50 * 50 + take100 * 100 > K) break;\n\n                            int nx = x + take50;\n                            int ny = y + take100;\n                            int nside = side ^ 1;\n                            long nd = d + 1;\n\n                            if (dist[nx][ny][nside] >= nd) {\n                                if (dist[nx][ny][nside] > nd) {\n                                    dist[nx][ny][nside] = nd;\n                                    q.add(new Node(nx, ny, nside, nd));\n                                }\n                                count[nx][ny][nside] = (count[nx][ny][nside] + compute(count[x][y][side], rem50, take50, rem100, take100)) % MOD;\n                            }\n                        }\n                    }\n                }