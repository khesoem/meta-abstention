]=true);\n    }\n    return dep[t]<iinf;\n}\npair<int,int> mcmf(){\n    pair<int,int> res(0,0);\n    while(spfa()){\n        int f=iinf;\n        for(int u=t;u!=s;u=to[pre[u]^1]) f=min(f,fw[pre[u]]);\n        for(int u=t;u!=s;u=to[pre[u]^1]) fw[pre[u]]-=f,fw[pre[u]^1]+=f;\n        res.x+=f,res.y+=dep[t]*f;\n    }\n    return res;\n}\n\n//Main\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0),cout.tie(0);\n    cin>>n>>m>>k>>c>>d,mxt=N*3+1;\n    fn=(t=(s=n*mxt)+1)+1;\n    R(i,0,k){int u;cin>>u,--u,adde(s,u,1,0);}\n    while(m--){\n        int u,v; cin>>u>>v,--u,--v;\n        R(i,0,mxt-1)R(p,1,k+1)\n            adde(i*n+u,(i+1)*n+v,1,2*d*p-d),\n            adde(i*n+v,(i+1)*n+u,1,2*d*p-d);\n    }\n    R(u,0,n)R(i,0,mxt-1) adde(i*n+u,(i+1)*n+u,k,0);\n    R(i,0,mxt) adde(i*n,t,k,i*c);\n    pair<int,int> ans=mcmf();\n    assert(ans.x==k);\n    cout<<ans.y<<'\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int iinf = 0x3f3f3f3f;\n    static final long linf = 0x3f3f3f3f3f3f3f3fL;\n    \n    static final int N = 50;\n    static int n, m, k, c, d, mxt;\n    \n    static final int fN = (N * 3 + 1) * N + 2;\n    static int s, t, fn;\n    static List<Integer>[] e;\n    static List<Integer> to, fw, co;\n    \n    static void adde(int u, int v, int w, int cost) {\n        e[u].add(to.size());\n        to.add(v);\n        fw.add(w);\n        co.add(cost);\n        \n        e[v].add(to.size());\n        to.add(u);\n        fw.add(0);\n        co.add(-cost);\n    }\n    \n    static int[] dep = new int[fN];\n    static int[] pre = new int[fN];\n    static boolean[] vis = new boolean[fN];\n    \n    static boolean spfa() {\n        Arrays.fill(dep, iinf);\n        Arrays.fill(pre, -1);\n        Arrays.fill(vis, false);\n        \n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        vis[s] = true;\n        dep[s] = 0;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            \n            for (int idx : e[u]) {\n                if (fw.get(idx) > 0 && dep[to.get(idx)] > dep[u] + co.get(idx)) {\n                    dep[to.get(idx)] = dep[u] + co.get(idx);\n                    pre[to.get(idx)] = idx;\n                    if (!vis[to.get(idx)]) {\n                        vis[to.get(idx)] = true;\n                        q.offer(to.get(idx));\n                    }\n                }\n            }\n        }\n        \n        return dep[t] < iinf;\n    }\n    \n    static class Pair {\n        int x, y;\n        Pair(int x, int y) {\n            this.x = x;\n            this.y = y;\n        }\n    }\n    \n    static Pair mcmf() {\n        Pair res = new Pair(0, 0);\n        \n        while (spfa()) {\n            int f = iinf;\n            for (int u = t; u != s; u = to.get(pre[u] ^ 1)) {\n                f = Math.min(f, fw.get(pre[u]));\n            }\n            \n            for (int u = t; u != s; u = to.get(pre[u] ^ 1)) {\n                fw.set(pre[u], fw.get(pre[u]) - f);\n                fw.set(pre[u] ^ 1, fw.get(pre[u] ^ 1) + f);\n            }\n            \n            res.x += f;\n            res.y += dep[t] * f;\n        }\n        \n        return res;\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n        mxt = N * 3 + 1;\n        \n        fn = (t = (s = n * mxt) + 1) + 1;\n        \n        e = new List[fn];\n        for (int i = 0; i < fn; i++) {\n            e[i] = new ArrayList<>();\n        }\n        to = new ArrayList<>();\n        fw = new ArrayList<>();\n        co = new ArrayList<>();\n        \n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int u = Integer.parseInt(st.nextToken()) - 1;\n            adde(s, u, 1, 0);\n        }\n        \n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken()) - 1;\n            int v = Integer.parseInt(st.nextToken()) - 1;\n            \n            for (int j = 0; j < mxt - 1; j++) {\n                for (int p = 1; p <= k; p++) {\n                    adde(j * n + u, (j + 1) * n + v, 1, 2 * d * p - d);\n                    adde(j * n + v, (j + 1) * n + u, 1, 2 * d * p - d);\n                }\n            }\n        }\n        \n        for (int u = 0; u < n; u++) {\n            for (int i = 0; i < mxt - 1; i++) {\n                adde(i * n + u, (i + 1) * n + u, k, 0);\n            }\n        }\n        \n        for (int i = 0; i < mxt; i++) {\n            adde(i * n, t, k, i * c);\n        }\n        \n        Pair ans = mcmf();\n        assert ans.x == k;\n        System.out.println(ans.y);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010895135346800089, -2.264974000354414e-06, -1.1920922133867862e-06, -0.0008521024719811976, -5.352353764465079e-05, -0.17975062131881714, -0.575984001159668, -0.007669763173907995, -0.0001958416833076626, -1.1205610462639015e-05, -0.0003251500893384218, -1.6569954823353328e-05, -7.152555099310121e-07, -4.279521817807108e-05, -0.0031818735878914595, -6.913899414939806e-05, -0.2591070830821991, -1.039212703704834, -0.004749920219182968, -0.07285938411951065, -7.986990567587782e-06, -1.1920928244535389e-07, -1.1920922133867862e-06, 0.0, -7.867782187531702e-06, -9.536738616588991e-07, -2.7656173188006505e-05, 0.0, -4.768