{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <climits>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\ntypedef pair<int, int> pii;\n#define fi first\n#define se second\n\nconst int N = 5005;\nconst int INF = 1e9;\n\nstruct Edge {\n    int to, next, val, w;\n};\n\nstruct FlowResult {\n    int c, f;\n};\n\nint n, m, k, c_val, d_val, s, t, tot;\nint head[N], pre[N], edge_id = 1;\nEdge e[8 * N * (int)sqrt(N) + 10];\nvector<pii> edges;\n\nvoid add_edge(int u, int v, int val, int w) {\n    edge_id++;\n    e[edge_id].next = head[u];\n    e[edge_id].to = v;\n    e[edge_id].val = val;\n    e[edge_id].w = w;\n    head[u] = edge_id;\n}\n\nvoid add(int u, int v, int val, int w) {\n    add_edge(u, v, val, w);\n    add_edge(v, u, 0, -w);\n}\n\nint dis[N];\nbool vis[N];\n\nbool SPFA() {\n    fill(dis + 1, dis + tot + 1, INF);\n    queue<int> q;\n    q.push(s);\n    dis[s] = 0;\n    memset(vis, 0, sizeof(vis));\n    vis[s] = true;\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        vis[u] = false;\n        for (int i = head[u]; i; i = e[i].next) {\n            int v = e[i].to;\n            if (e[i].val && dis[v] > dis[u] + e[i].w) {\n                dis[v] = dis[u] + e[i].w;\n                pre[v] = i;\n                if (!vis[v]) {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return dis[t] < INF;\n}\n\nFlowResult mcmf() {\n    FlowResult res = {0, 0};\n    while (SPFA()) {\n        int flow = INF;\n        for (int x = t; x != s; x = e[pre[x] ^ 1].to)\n            flow = min(flow, e[pre[x]].val);\n        for (int x = t; x != s; x = e[pre[x] ^ 1].to) {\n            e[pre[x]].val -= flow;\n            e[pre[x] ^ 1].val += flow;\n        }\n        res.f += flow;\n        res.c += dis[t] * flow;\n    }\n    return res;\n}\n\n#define P(i, j) ((i) * n + (j))\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> k >> c_val >> d_val;\n    int cs = 2 * k;\n    tot = cs * n;\n    s = ++tot;\n    t = ++tot;\n\n    for (int i = 1; i <= k; i++) {\n        int tp;\n        cin >> tp;\n        add(s, P(0, tp), 1, 0);\n    }\n\n    edges.resize(m);\n    for (int i = 0; i < m; i++) {\n        cin >> edges[i].fi >> edges[i].se;\n    }\n\n    for (int i = 1; i <= cs - 1; i++) {\n        add(P(i, 1), t, k, c_val * i);\n        for (int j = 1; j <= n; j++) {\n            add(P(i - 1, j), P(i, j), k, 0);\n        }\n        for (int j = 0; j < m; j++) {\n            int u = edges[j].fi, v = edges[j].se;\n            for (int t_val = 1; t_val <= k; t_val++) {\n                add(P(i - 1, u), P(i, v), 1, (2 * t_val - 1) * d_val);\n                add(P(i - 1, v), P(i, u), 1, (2 * t_val - 1) * d_val);\n            }\n        }\n    }\n\n    cout << mcmf().c << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Edge:\n    def __init__(self, to, next_edge, val, w):\n        self.to = to\n        self.next = next_edge\n        self.val = val\n        self.w = w\n\nclass FlowResult:\n    def __init__(self, c, f):\n        self.c = c\n        self.f = f\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c_val = int(data[idx]); idx += 1\n    d_val = int(data[idx]); idx += 1\n    \n    cs = 2 * k\n    tot = cs * n\n    s = tot + 1\n    t = tot + 2\n    tot = t\n    \n    head = [-1] * (tot + 10)\n    e = []\n    edge_id = [0]  # Using list to allow modification in nested function\n    \n    def add_edge(u, v, val, w):\n        edge_id[0] += 1\n        e.append(Edge(v, head[u], val, w))\n        head[u] = edge_id[0] - 1\n    \n    def add(u, v, val, w):\n        add_edge(u, v, val, w)\n        add_edge(v, u, 0, -w)\n    \n    def P(i, j):\n        return i * n + j\n    \n    # Add edges from source to initial positions\n    for i in range(1, k + 1):\n        tp = int(data[idx]); idx += 1\n        add(s, P(0, tp), 1, 0)\n    \n    edges = []\n    for i in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        edges.append((u, v))\n    \n    # Build the graph\n    for i in range(1, cs):\n        add(P(i, 1), t, k, c_val * i)\n        for j in range(1, n + 1):\n            add(P(i - 1, j), P(i, j), k, 0)\n        for u, v in edges:\n            for t_val in range(1, k + 1):\n                add(P(i - 1, u), P(i, v), 1, (2 * t_val - 1) * d_val)\n                add(P(i - 1, v), P(i, u), 1, (2 * t_val - 1) * d_val)\n    \n    # SPFA and MCMF\n    def SPFA():\n        dis = [INF] * (tot + 10)\n        q = deque()\n        q.append(s)\n        dis[s] = 0\n        vis = [False] * (tot + 10)\n        vis[s] = True\n        pre = [-1] * (tot + 10)\n        \n        while q:\n            u = q.popleft()\n            vis[u] = False\n            i = head[u]\n            while i != -1:\n                edge = e[i]\n                v = edge.to\n                if edge.val > 0 and dis[v] > dis[u] + edge.w:\n                    dis[v] = dis[u] + edge.w\n                    pre[v] = i\n                    if not vis[v]:\n                        vis[v] = True\n                        q.append(v)\n                i = edge.next\n        \n        return dis[t] < INF\n    \n    def mcmf():\n        res = FlowResult(0, 0)\n        while SPFA():\n            flow = INF\n            x = t\n            while x != s:\n                edge_idx = pre[x]\n                flow = min(flow, e[edge_idx].val)\n                x = e[edge_idx ^ 1].to\n            \n            x = t\n            while x != s:\n                edge_idx = pre[x]\n                e[edge_idx].val -= flow\n                e[edge_idx ^ 1].val += flow\n                x = e[edge_idx ^ 1].to\n            \n            res.f += flow\n            res.c += dis[t] * flow\n        \n        return res\n    \n    result = mcmf()\n    print(result.c)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010918975021922961, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.0006002769805490971, -0.0007048744591884315, -2.3841855067985307e-07, -0.009756852872669697, -0.0005341533687897027, -1.1920922133867862e-06, -0.0004954302567057312, -0.2062913030385971, -0.8450859785079956, -7.748573807475623e-06, -0.010523306205868721, -2.3841855067985307e-07, -1.0609570381348021e-05, -8.976056415122002e-05, -6.318072337307967e-06, -0.0001823735801735893, -0.029927561059594154, -0.002241719514131546, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.38687166571617126, -2.3841855067985307e-07, -9.536697689327411e-06, 0.0, -4.768370445162873e-07, -0.0004320403386373073, -2.50339189733495e-06, -0.0010624246206134558, -0.003