     self.x = x\n    \n    def Value(self):\n        return self.x\n    \n    def __add__(self, other):\n        return FiniteField((self.x + other.x) % P)\n    \n    def __sub__(self, other):\n        return FiniteField((self.x + P - other.x) % P)\n    \n    def __mul__(self, other):\n        return FiniteField((self.x * other.x) % P)\n    \n    def __truediv__(self, other):\n        return self * other.inverse()\n    \n    def __iadd__(self, other):\n        self.x = (self.x + other.x) % P\n        return self\n    \n    def __isub__(self, other):\n        self.x = (self.x + P - other.x) % P\n        return self\n    \n    def __imul__(self, other):\n        self.x = (self.x * other.x) % P\n        return self\n    \n    def __itruediv__(self, other):\n        p = P - 2\n        base = other\n        while p:\n            if p % 2:\n                self *= base\n            base *= base\n            p //= 2\n        return self\n    \n    def inverse(self):\n        p = P - 2\n        result = FiniteField(1)\n        base = self\n        while p:\n            if p % 2:\n                result *= base\n            base *= base\n            p //= 2\n        return result\n\ndef matrix_mult(a1, a2):\n    n = len(a1)\n    m = len(a1[0])\n    if len(a2) != m:\n        print(\"Matrix dimensions don't match for multiplication!\", file=sys.stderr)\n        sys.exit(1)\n    l = len(a2[0])\n    result = [[FiniteField(0) for _ in range(l)] for _ in range(n)]\n    for i in range(n):\n        for j in range(l):\n            for k in range(m):\n                result[i][j] += a1[i][k] * a2[k][j]\n    return result\n\ndef matrix_vector_mult(matrix, v):\n    n = len(matrix)\n    m = len(matrix[0])\n    if len(v) != m:\n        print(\"Matrix and vector dimensions don't match for multiplication!\", file=sys.stderr)\n        sys.exit(1)\n    result = [FiniteField(0) for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            result[i] += matrix[i][j] * v[j]\