ctorial.resize(maxN + 1);\n    invFactorial.resize(maxN + 1);\n    factorial[0] = 1;\n    invFactorial[0] = 1;\n    for (int i = 1; i <= maxN; i++) {\n        factorial[i] = (factorial[i - 1] * i) % MOD;\n        invFactorial[i] = fastPow(factorial[i], MOD - 2);\n    }\n}\n\nlong long combination(int r, int n) {\n    return (factorial[n] * invFactorial[r] % MOD) * invFactorial[n - r] % MOD;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    int N;\n    long long K;\n    ss >> N >> K;\n    \n    if (K >= N) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    int C = N - (int)K;\n    initFactorials(200000);\n    \n    long long result = fastPow(C, N);\n    for (int idx = 1; idx < C; idx++) {\n        long long term = fastPow(C - idx, N);\n        term = term * combination(idx, C) % MOD;\n        if (idx % 2 == 1) {\n            result = (result - term + MOD) % MOD;\n        } else {\n            result = (result + term) % MOD;\n        }\n    }\n    result = result * combination(C, N) % MOD;\n    if (K > 0) {\n        result = result * 2 % MOD;\n    }\n    cout << result << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016342257731594145, -2.264974000354414e-06, -7.152555099310121e-07, -0.0008779485360719264, -2.3841855067985307e-07, -6.258291978156194e-05, -1.4305012882687151e-05, -1.311301275563892e-06, -3.576278118089249e-07, -0.10767392069101334, -1.9073468138230965e-06, -0.00018034738604910672, -3.6954811548639555e-06, -0.00931642297655344, -4.768360213347478e-06, -0.00462165754288435, -2.2172682292875834e-05, -0.0025195302441716194, -0.03804508596658707, -0.5759876370429993, -2.3841855067985307e-07, -0.1442355215549469, -0.4740806818008423, -0.048640016466379166, -2.4914430468925275e-05, -4.0531076592742465e-06, -2.0265558760002023e-06, -0.002011063741520047, -7.033323527139146e-06, -1.2874520507466514e-05, -4.887569048150908e-06, 0.0, 0.0,