        if (x < 0) x += MOD;\n        return x;\n    }\n\n    ll add(ll a, ll b) {\n        ll v = a + b;\n        return v < MOD ? v : v - MOD;\n    }\n\n    ll subtract(ll a, ll b) {\n        ll v = a - b;\n        return v < 0 ? v + MOD : v;\n    }\n\n    ll mult(ll a, ll b) {\n        return (a * b) % MOD;\n    }\n\n    ll mult(ll a, ll b, ll c) {\n        return mult(mult(a, b), c);\n    }\n};\n\nint main() {\n    int n, m;\n    scanf(\"%d %d\", &n, &m);\n\n    ModArith mod;\n    mod.fInv(n + m);\n\n    ll phaseSize = 1;\n    ll p = mod.mult(n, mod.smallInv(n + m));\n    phaseSize = mod.add(phaseSize, p);\n    for (int i = 1; p != 0; i++) {\n        p = mod.mult(p, n - i, mod.smallInv(n + m - i));\n        phaseSize = mod.add(phaseSize, p);\n    }\n\n    ll answer = 0;\n    for (int k = n; k >= 1; k--) {\n        ll numPhases = mod.mult(m + k, mod.smallInv(k));\n        ll e = mod.mult(numPhases, phaseSize);\n        ll term = mod.mult(mod.ncr(n, k), e);\n\n        if (k & 1) {\n            answer = mod.add(answer, term);\n        } else {\n            answer = mod.subtract(answer, term);\n        }\n    }\n\n    printf(\"%lld\\n\", answer);\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.8729025871143676e-05, 0.0, 0.0, -4.589452510117553e-05, -0.00016139635408762842, -4.768360213347478e-06, -0.6043038368225098, -1.6689160474925302e-05, 0.0, 0.0, -0.038078367710113525, -1.645074735279195e-05, -2.753696753643453e-05, 0.0, -0.1603400707244873, -0.16460475325584412, -0.0067427014000713825, -0.011050808243453503, 0.0, -0.12702442705631256, -0.2137625515460968, -0.3132912814617157, -0.38702061772346497, -0.00012575789878610522, 0.0, -0.1602335423231125, -0.164738729596138, -4.768370445162873e-07, 0.0, -5.447716102935374e-05, -0.201422780752182, -0.0020179639104753733, -0.00056429672986269, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.0837336853146553, -1.7881377516459906e-06, -0.08424455672502518, -2.861018856