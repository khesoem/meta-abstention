od o) {\n            return new Mod((long)x + o.x);\n        }\n        Mod multiply(Mod o) {\n            return new Mod((long)x * o.x);\n        }\n        void addAssign(Mod o) {\n            x = (x + o.x) % MOD;\n        }\n        void multiplyAssign(Mod o) {\n            x = (int)((long)x * o.x % MOD);\n        }\n        Mod divide(int d) {\n            return this.multiply(new Mod(powMod(d, MOD-2)));\n        }\n        static long powMod(long a, long e) {\n            long r = 1;\n            while (e > 0) {\n                if ((e & 1) == 1) r = r * a % MOD;\n                a = a * a % MOD;\n                e >>= 1;\n            }\n            return r;\n        }\n        static Mod valueOf(int v) {\n            return new Mod(v);\n        }\n    }\n\n    public void solve(Scanner cin, PrintWriter cout) {\n        int N = cin.nextInt();\n        int[][] P = new int[N][N];\n        for (int i = 0; i < N; i++) {\n            for (int j = 0; j < N; j++) {\n                P[i][j] = cin.nextInt();\n            }\n        }\n\n        HashMap<BitSet, Mod> G = new HashMap<>();\n        BitSet start = new BitSet();\n        start.set(0);\n        G.put(start, Mod.valueOf(1));\n\n        for (int i = 0; i < N; i++) {\n            HashMap<List<Integer>, Mod> H = new HashMap<>();\n            for (Map.Entry<BitSet, Mod> entry : G.entrySet()) {\n                BitSet bs = entry.getKey();\n                List<Integer> list = new ArrayList<>();\n                for (int m = 0; m < (1 << N); m++) {\n                    if (bs.get(m)) list.add(m);\n                }\n                H.put(list, entry.getValue());\n            }\n            G.clear();\n\n            for (int j = 0; j < (1 << N); j++) {\n                Mod pst = Mod.valueOf(1);\n                for (int k = 0; k < N; k++) {\n                    if ((j & (1 << k)) != 0) {\n                        pst = pst.multiply(Mod.valueOf(P[i][k]));\n                    } else {\n                        pst = pst.multiply(Mod.valueOf(100 - P[i][k]));\n                    }\n                }\n\n                for (Map.Entry<List<Integer>, Mod> entry : H.entrySet()) {\n                    List<Integer> masks = entry.getKey();\n                    Mod val = entry.getValue();\n                    BitSet ans = new BitSet();\n                    for (int l = 0; l < N; l++) {\n                        if ((j & (1 << l)) == 0) continue;\n                        for (int m : masks) {\n                            if ((m & (1 << l)) == 0) {\n                                ans.set(m | (1 << l));\n                            }\n                        }\n                    }\n                    if (!ans.isEmpty()) {\n                        Mod newVal = val.multiply(pst);\n                        Mod old = G.get(ans);\n                        if (old == null) {\n                            G.put(ans, newVal);\n                        } else {\n                            old.addAssign(newVal);\n                        }\n                    }\n                }\n            }\n        }\n\n        Mod ans = Mod.valueOf(0);\n        for (Mod val : G.values()) {\n            ans = ans.add(val);\n        }\n        Mod inv100 = Mod.valueOf(1).divide(100);\n        Mod factor = Mod.valueOf(1);\n        for (int i = 0; i < N * N; i++) {\n            factor = factor.multiply(inv100);\n        }\n        ans = ans.multiply(factor);\n        cout.println(ans.x);\n    }\n\n    public static void main(String[] args) {\n        Scanner cin = new Scanner(System.in);\n        PrintWriter cout = new PrintWriter(System.out);\n        E2MarekAndMatchingHardVersion solver = new E2MarekAndMatchingHardVersion();\n        solver.solve(cin, cout);\n        cout.flush();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.47579169273376465, -5.722029527532868e-06, 0.0, 0.0, -3.516612196108326e-05, -1.3232143828645349e-05, 0.0, -0.006872823927551508, -0.387039333581924