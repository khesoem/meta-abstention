n;j++){\n            scanf(\"%d\",&a[i][j]);\n            a[i][j]=mult(a[i][j],power(100,MOD-2));\n        }\n    }\n    for(int i=0;i<n;i++){\n        for(int j=0;j<(1<<n);j++){\n            q[i][j]=1;\n            for(int k=0;k<n;k++){\n                if((j>>k)&1)q[i][j]=mult(q[i][j],a[i][k]);\n                else q[i][j]=mult(q[i][j],dec(1,a[i][k]));\n            }\n        }\n    }\n    dp[0][1]=1;\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=idcnt;j++){\n            for(int k=0;k<(1<<n);k++){\n                dp[i][ch[j][k]]=add(dp[i][ch[j][k]],mult(dp[i-1][j],q[i-1][k]));\n            }\n        }\n    }\n    bitset<128> bt;\n    for(int i=0;i<(1<<n);i++)bt[i]=1;\n    printf(\"%d\\n\",dp[n][id[bt]]);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMOD = 1000000007\n\ndef add(a, b):\n    a += b\n    if a >= MOD:\n        a -= MOD\n    return a\n\ndef mult(a, b):\n    return (a * b) % MOD\n\ndef dec(a, b):\n    a -= b\n    if a < 0:\n        a += MOD\n    return a\n\ndef power(a, b):\n    out = 1\n    while b:\n        if b & 1:\n            out = mult(out, a)\n        a = mult(a, a)\n        b >>= 1\n    return out\n\ndef lowbit(x):\n    return x & -x\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    # Build state graph\n    full_mask = 1 << n\n    id_map = {}  # state -> id\n    ch = []      # ch[id] is list of length full_mask\n    q = deque()\n    initial_state = 1  # bitset with only bit 0 set\n    id_map[initial_state] = 0\n    ch.append([0] * full_mask)\n    q.append(initial_state)\n    while q:\n        s = q.popleft()\n        sid = id_map[s]\n        for i in range(full_mask):\n            tmp = s\n            for j in range(full_mask):\n                if not (tmp >> j) & 1:\n                    x = i 