, y, v1, v2 - 1);\n        }\n    }\n\n    long solve(long x0, long y0, int v10, int v20) {\n        Deque<Frame> stack = new ArrayDeque<>();\n        stack.push(new Frame(x0, y0, v10, v20));\n        while (!stack.isEmpty()) {\n            Frame f = stack.peek();\n            long k = f.x * 10000 + f.v1 * 100 + f.v2;\n\n            if (f.stage == 0) {\n                Long cached = cache.get(k);\n                if (cached != null) {\n                    stack.pop();\n                    if (stack.isEmpty()) return cached;\n                    stack.peek().acc += cached;\n                    continue;\n                }\n\n                long d = Math.abs(f.x - f.y);\n                if (d - C[f.v1][r] * C[f.v2][r] > best) {\n                    cache.put(k, 0L);\n                    stack.pop();\n                    if (stack.isEmpty()) return 0L;\n                    stack.peek().acc += 0L;\n                    continue;\n                }\n\n                if (f.v1 < r || f.v2 < r) {\n                    int sum = f.v1 + f.v2;\n                    long val;\n                    if (f.v1 >= cntA[sum] && f.v2 >= cntB[sum]) {\n                        int nv1 = f.v1 - cntA[sum];\n                        int nv2 = f.v2 - cntB[sum];\n                        val = C[nv1 + nv2][nv1];\n                    } else {\n                        val = 0L;\n                    }\n                    cache.put(k, val);\n                    stack.pop();\n                    if (stack.isEmpty()) return val;\n                    stack.peek().acc += val;\n                    continue;\n                }\n\n                f.ch = cs[f.v1 + f.v2 - 1];\n                f.stage = 1;\n                if (f.ch != 'B') {\n                    long c1 = C[f.v1][r] - C[f.v1 - 1][r];\n                    long s2 = C[f.v2][r];\n                    stack.push(new Frame(f.x, f.y + c1 * s2, f.v1 - 1, f.v2));\n                }\n                continue;\n            } else if (f.stage == 1) {\n                if (f.ch != 'A') {\n                    long s1 = C[f.v1][r];\n                    long c2 = C[f.v2][r] - C[f.v2 - 1][r];\n                    f.stage = 2;\n                    stack.push(new Frame(f.x + s1 * c2, f.y, f.v1, f.v2 - 1));\n                } else {\n                    stack.pop();\n                    long val = f.acc;\n                    cache.put(k, val);\n                    if (stack.isEmpty()) return val;\n                    stack.peek().acc += val;\n                }\n                continue;\n            } else {\n                stack.pop();\n                long val = f.acc;\n                cache.put(k, val);\n                if (stack.isEmpty()) return val;\n                stack.peek().acc += val;\n            }\n        }\n        return 0L;\n    }\n\n    void start() {\n        r = sca.nextInt(); c = sca.nextInt(); sca.nextLine();\n        cs = sca.nextLine().toCharArray();\n        int n = 2 * (r + c);\n        for (int i = 0; i <= n; i++)\n            for (int j = 0; j <= n; j++) {\n                if (j == 0) C[i][j] = 1;\n                else if (i == 0) C[i][j] = 0;\n                else C[i][j] = C[i - 1][j - 1] + C[i - 1][j];\n            }\n        int v1 = r + c, v2 = r + c;\n        long x = 0, y = 0;\n        while (v1 >= r && v2 >= r) {\n            if (x > y) {\n                long c1 = C[v1][r] - C[v1 - 1][r], s2 = C[v2][r];\n                y += c1 * s2;\n                v1--;\n            } else {\n                long s1 = C[v1][r], c2 = C[v2][r] - C[v2 - 1][r];\n                x += s1 * c2;\n                v2--;\n            }\n        }\n        best = Math.abs(x - y);\n        dfs(0, 0, r + c, r + c);\n        for (int i = 0; i < n; i++) {\n            cntA[i + 1] = cntA[i] + (cs[i] == 'A' ? 1 : 0);\n            cntB[i + 1] = cntB[i] + (cs[i] == 'B' ? 1 : 0);\n        }\n        long ans = solve(0, 0, r + c, r + c);\n        System.out.println(ans);\n    }\n\n    public static void main(String[] arg