 not ((con[x] >> vi[x]) & 1):\n                            valid = False\n                            break\n                    if valid:\n                        ok = 1\n                        break\n                if ok:\n                    id_val |= (1 << nxt)\n                nxt += 1\n            cnt[id_val] = (cnt[id_val] + prob) % mod\n            return\n        \n        for j in range(1 << n):\n            con.append(j)\n            nw = prob\n            for k in range(n):\n                if ((j >> k) & 1):\n                    nw = nw * a[cur][k] % mod\n                else:\n                    nw = nw * (mod + 1 - a[cur][k]) % mod\n            dfs(cur + 1, con, nw)\n            con.pop()\n    \n    def dfs2(cur, con, prob):\n        if cur == n:\n            nxt = 0\n            id_val = 0\n            for j in range(1 << n):\n                if bin(j).count('1') != n - m:\n                    continue\n                vi = [i for i in range(n) if (j >> i) & 1]\n                ok = 0\n                for perm in permutations(vi):\n                    valid = True\n                    for x in range(n - m):\n                        if not ((con[x] >> vi[x]) & 1):\n                            valid = False\n                            break\n                    if valid:\n                        ok = 1\n                        break\n                if ok:\n                    id_val |= (1 << nxt)\n                nxt += 1\n            cnt2[id_val] = (cnt2[id_val] + prob) % mod\n            return\n        \n        for j in range(1 << n):\n            con.append(j)\n            nw = prob\n            for k in range(n):\n                if ((j >> k) & 1):\n                    nw = nw * a[cur][k] % mod\n                else:\n                    nw = nw * (mod + 1 - a[cur][k]) % mod\n            dfs2(cur + 1, con, nw)\n            con.pop()\n    \n    dfs(0, [], 1)\n    for i in range(max_size):\n        cnt[i] %= mod\n    \n    # Sum over subsets\n