 sums.add(cur);\n            return;\n        }\n        rec(sums, arr, idx + 1, (cur + arr[idx]) % mod, mod);\n        rec(sums, arr, idx + 1, cur, mod);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt() % m;\n        }\n        int half = n / 2;\n        int[] leftArr = Arrays.copyOfRange(a, 0, half);\n        int[] rightArr = Arrays.copyOfRange(a, half, n);\n        Set<Integer> leftSet = new HashSet<>();\n        Set<Integer> rightSet = new HashSet<>();\n        rec(leftSet, leftArr, 0, 0, m);\n        rec(rightSet, rightArr, 0, 0, m);\n        List<Integer> rightList = new ArrayList<>(rightSet);\n        Collections.sort(rightList);\n        int best = 0;\n        for (int l : leftSet) {\n            int target = m - l;\n            int idx = Collections.binarySearch(rightList, target);\n            int pos;\n            if (idx >= 0) {\n                pos = idx - 1;\n            } else {\n                int insertionPoint = -idx - 1;\n                pos = insertionPoint - 1;\n            }\n            if (pos < 0) {\n                pos = rightList.size() - 1;\n            }\n            int candidate = l + rightList.get(pos);\n            if (candidate > best) {\n                best = candidate;\n            }\n        }\n        System.out.println(best);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.1219027985353023e-05, 0.0, -1.1920928244535389e-07, -2.098061486321967e-05, -4.160317621426657e-05, 0.0, -2.753696753643453e-05, -0.0022706221789121628, -6.079655122448457e-06, 0.0, -0.0037187249399721622, -0.006716533098369837, -0.0019306369358673692, -0.4830780625343323, -1.4543427823809907e-05, -3.4570634852570947e-06, -0.001930398982949555, 0.0, -1.1920928244535389e-07, 0.0, -6.67