er) const{\n        Poly res(L);\n        for(int i=0;i<=L;i++)\n            for(int j=0;j<=L-i;j++)\n                res.coeff[i+j] += coeff[i]*other.coeff[j];\n        for(int i=0;i<=L;i++) res.coeff[i]%=MOD;\n        return res;\n    }\n};\nPoly poly_power(Poly base,int exp){\n    Poly res(L); res.coeff[0]=1;\n    while(exp){\n        if(exp&1) res=res*base;\n        base=base*base;\n        exp>>=1;\n    }\n    return res;\n}\nint main(){\n    cin>>n>>kmod>>MOD;\n    initialize(n);\n    if(n&1){ cout<<power_mod(kmod,n)<<\"\\n\"; return 0; }\n    m=1; L=0; while(m<=n){ m<<=1; L++; }\n    for(int i=0;i<m;i++) cnt[i]=cnt[i>>1]+(i&1);\n    initialize(m);\n    for(int i=0;i<m;i++) f[cnt[i]][i]=invfact[i];\n    for(int i=0;i<=L;i++) walsh(f[i],m,1);\n    vector<long long> tmp(L+1);\n    for(int s=0;s<m;s++){\n        for(int i=0;i<=L;i++) tmp[i]=f[i][s];\n        Poly P(tmp);\n        P=poly_power(P,kmod);\n        for(int i=0;i<=L;i++) f[i][s]=P.coeff[i];\n    }\n    walsh(f[cnt[n]],m,-1);\n    int ans=power_mod(kmod,n) - 1LL*f[cnt[n]][n]*fact[n]%MOD;\n    ans=add_mod(ans);\n    cout<<ans<<\"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 0\nL = 0\n\ndef add_mod(x):\n    return x % MOD\n\ndef add_to(x, y):\n    return (x + y) % MOD\n\ndef power_mod(a, e):\n    return pow(a, e, MOD)\n\ndef initialize(lim):\n    global fact, invfact\n    fact = [1] * (lim + 1)\n    for i in range(1, lim + 1):\n        fact[i] = (fact[i-1] * i) % MOD\n    invfact = [1] * (lim + 1)\n    invfact[lim] = power_mod(fact[lim], MOD - 2)\n    for i in range(lim - 1, -1, -1):\n        invfact[i] = (invfact[i+1] * (i+1)) % MOD\n\ndef walsh(a, length, sgn):\n    p = 1\n    while p < length:\n        start = 0\n        while start < length:\n            for i in range(start, start + p):\n                u = a[i]\n                v = a[i