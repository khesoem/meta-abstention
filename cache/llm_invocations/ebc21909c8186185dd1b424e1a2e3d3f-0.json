mask & (1 << row))\n                    prob = mul(prob, a[row][col]);\n                else\n                    prob = mul(prob, sub(1, a[row][col]));\n            }\n            for (auto &st : states) {\n                vector<int> newVec;\n                for (int m2 : st.first) {\n                    int possible = (~m2) & mask;\n                    while (possible) {\n                        int bit = possible & -possible;\n                        newVec.push_back(m2 | bit);\n                        possible ^= bit;\n                    }\n                }\n                if (newVec.empty()) continue;\n                sort(newVec.begin(), newVec.end());\n                newVec.erase(unique(newVec.begin(), newVec.end()), newVec.end());\n                newStates.push_back({newVec, mul(st.second, prob)});\n            }\n        }\n        sort(newStates.begin(), newStates.end());\n        states.clear();\n        int i = 0;\n        while (i < (int)newStates.size()) {\n            int j = i;\n            int sumVal = 0;\n            while (j < (int)newStates.size() && newStates[j].first == newStates[i].first) {\n                sumVal = add(sumVal, newStates[j].second);\n                ++j;\n            }\n            states.push_back({newStates[i].first, sumVal});\n            i = j;\n        }\n    }\n\n    int ans = 0;\n    for (auto &st : states)\n        ans = add(ans, st.second);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1_000_000_007;\n    static final int MAX_N = 10;\n    static int[][] a = new int[MAX_N][MAX_N];\n\n    static int add(int x, int y) {\n        x += y;\n        return x >= MOD ? x - MOD : x;\n    }\n\n    static int sub(int x, int y) {\n        x -= y;\n        return x < 0 ? x + MOD : x;\n    }\n\n    static int mul(int x, int y) {\n        return (int)((x * 1L * y) % MOD);\n    }\n\n    static int power(int x, int n) {\n        if (n == 0) return 1;\n        int y = power(x, n / 2);\n        y = mul(y, y);\n        return (n & 1) == 1 ? mul(y, x) : y;\n    }\n\n    static int rev(int x) {\n        return power(x, MOD - 2);\n    }\n\n    static int divv(int x, int y) {\n        return mul(x, rev(y));\n    }\n\n    static class State {\n        List<Integer> masks;\n        int prob;\n\n        State(List<Integer> masks, int prob) {\n            this.masks = masks;\n            this.prob = prob;\n        }\n\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            State state = (State) o;\n            return masks.equals(state.masks);\n        }\n\n        @Override\n        public int hashCode() {\n            return masks.hashCode();\n        }\n    }\n\n    static int compareLists(List<Integer> a, List<Integer> b) {\n        int len = Math.min(a.size(), b.size());\n        for (int i = 0; i < len; i++) {\n            int cmp = Integer.compare(a.get(i), b.get(i));\n            if (cmp != 0) return cmp;\n        }\n        return Integer.compare(a.size(), b.size());\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                a[i][j] = sc.nextInt();\n                a[i][j] = divv(a[i][j], 100);\n            }\n        }\n\n        List<State> states = new ArrayList<>();\n        List<State> newStates = new ArrayList<>();\n        states.add(new State(new ArrayList<>(Collections.singletonList(0)), 1));\n\n        for (int col = 0; col < n; col++) {\n            newStates.clear();\n            for (int mask = 0; mask < (1 << n); mask++) {\n                int prob = 1;\n                for (int row = 0; row < n; row++) {\n                    if ((mask & (1 << row)) != 0)\n                        prob = mul(prob, a[row][col]);\n                    else\n                        prob = mul(prob, sub(1, a[row][col]));\n                }\n                for (State st : states) {\n                    Set<Integer> newSet = new TreeSet<>();\n                    for (int m2 : st.masks) {\n                        int possible = (~m2) & mask;\n                        // Only consider bits within n bits\n                        possible &= (1 << n) - 1;\n                        while (possible != 0) {\n                            int bit = possible & -possible;\n                            newSet.add(m2 | bit);\n                            possible ^= bit;\n                        }\n                    }\n                    if (newSet.isEmpty()) continue;\n                    List<Integer> newVec = new ArrayList<>(newSet);\n                    newStates.add(new State(newVec, mul(st.prob, prob)));\n                }\n            }\n            // Sort newStates by masks list\n            newStates.sort((s1, s2) -> compareLists(s1.masks, s2.masks));\n            states.clear();\n            int i = 0;\n            while (i < newStates.size()) {\n                int j = i;\n                int sumVal = 0;\n                while (j < newStates.size() && newStates.get(j).masks.equals(newStates.get(i).masks)) {\n                    sumVal = add(sumVal, newStates.get(j).prob);\n                    j++;\n                }\n                states.add(new State(newStates.get(i).masks, sumVal));\n                i = j;\n            }\n        }\n\n        int ans = 0;\n        for (State st : states) {\n            ans = add(ans, st.prob);\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.291525328881107e-06, 0.0, 0.0, -3.85038583772257e-05, -0.00011383838864