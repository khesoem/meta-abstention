{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nusing ll = long long;\nusing PII = pair<int, int>;\n\nconst int INF = 0x3f3f3f3f;\nconst int MAXN = 6555;\n\nstruct Edge {\n    int target;\n    int capacity;\n    int cost;\n    int reverseIndex;\n    Edge(int t, int cap, int cst, int rev) : target(t), capacity(cap), cost(cst), reverseIndex(rev) {}\n};\n\nstruct MinCostMaxFlowSolver {\n    int numVertices;\n    int potential[MAXN + 5];\n    int dist[MAXN + 5];\n    int prevVertex[MAXN + 5];\n    int prevEdge[MAXN + 5];\n    vector<Edge> adjList[MAXN + 5];\n\n    void initialize(int n) {\n        numVertices = n;\n        for (int i = 0; i <= n; ++i) adjList[i].clear();\n    }\n\n    void insertEdge(int from, int to, int cap, int cst) {\n        adjList[from].emplace_back(to, cap, cst, (int)adjList[to].size());\n        adjList[to].emplace_back(from, 0, -cst, (int)adjList[from].size() - 1);\n    }\n\n    int calculate(int source, int sink, int flowNeeded) {\n        int totalFlow = 0, totalCost = 0;\n        memset(potential, 0, sizeof(potential));\n        while (flowNeeded > 0) {\n            priority_queue<PII, vector<PII>, greater<PII>> pq;\n            fill(dist, dist + numVertices + 1, INF);\n            dist[source] = 0;\n            pq.emplace(0, source);\n            while (!pq.empty()) {\n                auto [d, u] = pq.top(); pq.pop();\n                if (d != dist[u]) continue;\n                for (int i = 0; i < adjList[u].size(); ++i) {\n                    auto& e = adjList[u][i];\n                    if (e.capacity > 0 && dist[e.target] > dist[u] + e.cost + potential[u] - potential[e.target]) {\n                        dist[e.target] = dist[u] + e.cost + potential[u] - potential[e.target];\n                        prevVertex[e.target] = u;\n                        prevEdge[e.target] = i;\n                        pq.emplace(dist[e.target], e.target);\n                    }\n                }\n            }\n            if (dist[sink] == INF) break;\n            for (int i = 0; i <= numVertices; ++i) potential[i] += dist[i];\n            int flow = flowNeeded;\n            for (int v = sink; v != source; v = prevVertex[v])\n                flow = min(flow, adjList[prevVertex[v]][prevEdge[v]].capacity);\n            flowNeeded -= flow;\n            totalFlow += flow;\n            totalCost += flow * potential[sink];\n            for (int v = sink; v != source; v = prevVertex[v]) {\n                auto& e = adjList[prevVertex[v]][prevEdge[v]];\n                e.capacity -= flow;\n                adjList[v][e.reverseIndex].capacity += flow;\n            }\n        }\n        return totalCost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    MinCostMaxFlowSolver solver;\n    solver.initialize(n * (n + 55) + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int u; cin >> u;\n        solver.insertEdge(0, u, 1, 0);\n    }\n\n    vector<PII> edges(m