     }\n        }\n\n        void insertEdge(int from, int to, int cap, int cst) {\n            adjList[from].add(new Edge(to, cap, cst, adjList[to].size()));\n            adjList[to].add(new Edge(from, 0, -cst, adjList[from].size() - 1));\n        }\n\n        int calculate(int source, int sink, int flowNeeded) {\n            int totalFlow = 0, totalCost = 0;\n            Arrays.fill(potential, 0);\n            while (flowNeeded > 0) {\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                Arrays.fill(dist, 0, numVertices + 1, INF);\n                dist[source] = 0;\n                pq.offer(new int[]{0, source});\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int d = cur[0], u = cur[1];\n                    if (d != dist[u]) continue;\n                    for (int i = 0; i < adjList[u].size(); i++) {\n                        Edge e = adjList[u].get(i);\n                        if (e.capacity > 0 && dist[e.target] > dist[u] + e.cost + potential[u] - potential[e.target]) {\n                            dist[e.target] = dist[u] + e.cost + potential[u] - potential[e.target];\n                            prevVertex[e.target] = u;\n                            prevEdge[e.target] = i;\n                            pq.offer(new int[]{dist[e.target], e.target});\n                        }\n                    }\n                }\n                if (dist[sink] == INF) break;\n                for (int i = 0; i <= numVertices; i++) {\n                    potential[i] += dist[i];\n                }\n                int flow = flowNeeded;\n                for (int v = sink; v != source; v = prevVertex[v]) {\n                    flow = Math.min(flow, adjList[prevVertex[v]][prevEdge[v]].capacity);\n                }\n                flowNeeded -= flow;\n                totalFlow += flow;\n                totalCost += flow * potential[sink];\n                for (int v = sink; v != source; v = prevVertex[v]) {\n                    Edge e = adjList[prevVertex[v]][prevEdge[v]];\n                    e.capacity -= flow;\n                    adjList[v].get(e.reverseIndex).capacity += flow;\n                }\n            }\n            return totalCost;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MinCostMaxFlowSolver solver = new MinCostMaxFlowSolver();\n        solver.initialize(n * (n + 55) + 2);\n\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            solver.insertEdge(0, u, 1, 0);\n        }\n\n        int[][] edges = new int[m][2];\n        for (int i = 0; i < m; i++) {\n            edges[i][0] = sc.nextInt();\n            edges[i][1] = sc.nextInt();\n        }\n\n        int sinkNode = n * (n + 55) + 1;\n        for (int t = 0; t < n + 54; t++) {\n            for (int[] e : edges) {\n                for (int j = 1; j <= k; j++) {\n                    int cost = c + d * (2 * j - 1);\n                    solver.insertEdge(e[0] + t * n, e[1] + (t + 1) * n, 1, cost);\n                    solver.insertEdge(e[1] + t * n, e[0] + (t + 1) * n, 1, cost);\n                }\n            }\n            for (int i = 2; i <= n; i++) {\n                solver.insertEdge(i + t * n, i + (t + 1) * n, k, c);\n            }\n            solver.insertEdge(1 + t * n, sinkNode, k, 0);\n        }\n\n        System.out.println(solver.calculate(0, sinkNode, k));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011216964776394889, -2.264974000354414e-06, -7.152555099310121e-07, -0.0013363964390009642, -4.5298504119273275e-05, -0.14267942309379578, -0.06205444782972336, -1.585470999998506e-05, -1.1920928244535389e-07, -0.00013386306818574667, -0.0