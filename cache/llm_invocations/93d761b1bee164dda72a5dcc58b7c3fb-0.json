t[e.to] = dist[u] + e.cost;\n                parent_node[e.to] = u;\n                parent_edge[e.to] = i;\n                if (!inQueue[e.to]) {\n                    inQueue[e.to] = true;\n                    q.push(e.to);\n                }\n            }\n        }\n    }\n    return dist[t] < INF;\n}\n\nint minCostMaxFlow(int s, int t) {\n    int totalCost = 0;\n    while (findPath(s, t)) {\n        int flow = INF;\n        for (int v = t; v != s; v = parent_node[v]) {\n            flow = min(flow, adj[parent_node[v]][parent_edge[v]].capacity);\n        }\n        totalCost += dist[t] * flow;\n        for (int v = t; v != s; v = parent_node[v]) {\n            Edge& e = adj[parent_node[v]][parent_edge[v]];\n            e.capacity -= flow;\n            adj[v][e.index].capacity += flow;\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int source = 0;\n    int sink = n * MAX_T + 1;\n    adj.resize(sink + 1);\n    dist.resize(sink + 1);\n    parent_node.resize(sink + 1);\n    parent_edge.resize(sink + 1);\n    \n    // Connect all nodes' last time layer to sink\n    for (int i = 1; i <= n; ++i) {\n        addEdge((i - 1) * MAX_T + MAX_T, sink, 100, 0);\n    }\n    \n    // Connect source to initial positions\n    for (int i = 0; i < k; ++i) {\n        int v;\n        cin >> v;\n        addEdge(source, (v - 1) * MAX_T + 1, 1, 0);\n    }\n    \n    // Time progression edges\n    for (int i = 1; i <= n; ++i) {\n        for (int t = 1; t < MAX_T; ++t) {\n            addEdge((i - 1) * MAX_T + t, (i - 1) * MAX_T + t + 1, 100, c);\n        }\n    }\n    \n    // Bidirectional edges with capacity splitting\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        for (int t = 1; t < MAX_T; ++t) {\n            for (int j = 1; j <= 20; ++j) {\n                int cost = c + (j * j - (j - 1) * (j - 1)) * d;\n    