         long sum2 = comb[v2][R];\n            res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (c != 'A') {\n            long sum1 = comb[v1][R];\n            long cur2 = comb[v2][R] - comb[v2 - 1][R];\n            res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n        memo.put(state, res);\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        R = sc.nextInt();\n        C = sc.nextInt();\n        int maxN = 2 * (R + C);\n        comb = new long[maxN + 1][maxN + 1];\n        for (int i = 0; i <= maxN; i++) {\n            for (int j = 0; j <= maxN; j++) {\n                if (j == 0) comb[i][j] = 1;\n                else if (i == 0) comb[i][j] = 0;\n                else comb[i][j] = comb[i - 1][j] + comb[i - 1][j - 1];\n            }\n        }\n        total = comb[R + C][R] * comb[R + C][R];\n        {\n            long x = 0, y = 0;\n            int v1 = R + C, v2 = R + C;\n            while (v1 >= R && v2 >= R) {\n                if (x > y) {\n                    long cur1 = comb[v1][R] - comb[v1 - 1][R];\n                    long sum2 = comb[v2][R];\n                    y += cur1 * sum2;\n                    v1--;\n                } else {\n                    long sum1 = comb[v1][R];\n                    long cur2 = comb[v2][R] - comb[v2 - 1][R];\n                    x += sum1 * cur2;\n                    v2--;\n                }\n            }\n            best_val = Math.abs(x - y);\n        }\n        dfs(0, 0, R + C, R + C);\n        s = sc.next();\n        int len = 2 * (R + C);\n        cntA = new int[len + 1];\n        cntB = new int[len + 1];\n        for (int i = 0; i < len; i++) {\n            cntA[i + 1] = cntA[i] + (s.charAt(i) == 'A' ? 1 : 0);\n            cntB[i + 1] = cntB[i] + (s.charAt(i) == 'B' ? 1 : 0);\n        }\n        memo = new HashMap<>();\n        long ans = solve(0, 0, R + C, R + C);\n        System.out.println(ans);\n        s