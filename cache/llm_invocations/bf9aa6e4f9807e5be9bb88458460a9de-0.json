  \n    static class MCMF {\n        int[] h, ing, pre, to, ne;\n        int[] cap;\n        int[] cost;\n        int e, s, t, n;\n        int[] dis;\n        \n        MCMF() {\n            h = new int[N];\n            ing = new int[N];\n            pre = new int[N];\n            to = new int[M];\n            ne = new int[M];\n            cap = new int[M];\n            cost = new int[M];\n            dis = new int[N];\n        }\n        \n        void ini(int _n) {\n            Arrays.fill(h, 0, _n, -1);\n            e = 0;\n            n = _n;\n        }\n        \n        void liu(int u, int v, int c, int w) {\n            to[e] = v;\n            ne[e] = h[u];\n            cap[e] = c;\n            cost[e] = w;\n            h[u] = e++;\n        }\n        \n        void link(int u, int v, int c, int w) {\n            liu(u, v, c, w);\n            liu(v, u, 0, -w);\n        }\n        \n        boolean spfa() {\n            Queue<Integer> Q = new LinkedList<>();\n            Arrays.fill(dis, 0, n, Integer.MAX_VALUE);\n            Q.add(s);\n            ing[s] = 1;\n            dis[s] = 0;\n            \n            while (!Q.isEmpty()) {\n                int c = Q.poll();\n                ing[c] = 0;\n                for (int k = h[c]; ~k != 0; k = ne[k]) {\n                    if (cap[k] > 0) {\n                        int v = to[k];\n                        if (dis[c] + cost[k] < dis[v]) {\n                            dis[v] = dis[c] + cost[k];\n                            pre[v] = k;\n                            if (ing[v] == 0) {\n                                Q.add(v);\n                                ing[v] = 1;\n                            }\n                        }\n                    }\n                }\n            }\n            return dis[t] != Integer.MAX_VALUE;\n        }\n        \n        int flow;\n        int mincost;\n        \n        int[] run(int _s, int _t) {\n            s = _s;\n            t = _t;\n            flow = 0;\n            mincost = 0;\n            \n            while (spfa()) {\n                int pl = Integer.MAX_VALUE;\n                int p, k;\n                for (p = t; p != s; p = to[k ^ 1]) {\n                    k = pre[p];\n                    pl = Math.min(pl, cap[k]);\n                }\n                for (p = t; p != s; p = to[k ^ 1]) {\n                    k = pre[p];\n                    cap[k] -= pl;\n                    cap[k ^ 1] += pl;\n                }\n                mincost += pl * dis[t];\n                flow += pl;\n            }\n            \n            return new int[]{flow, mincost};\n        }\n    }\n    \n    static MCMF flow = new MCMF();\n    static int n, m, k, c, d;\n    static int[] a = new int[55];\n    static int[][] id = new int[55][2500];\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        for (int i = 1; i <= k; i++) {\n            a[i] = sc.nextInt();\n        }\n        \n        flow.ini(50 * 50 * 4 + 10);\n        int s = flow.n - 2;\n        int t = flow.n - 3;\n        int cnt = 0;\n        int mx = 100;\n        \n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= mx; j++) {\n                id[i][j] = ++cnt;\n            }\n        }\n        \n        int u, v;\n        for (int i = 1; i <= m; i++) {\n            u = sc.nextInt();\n            v = sc.nextInt();\n            for (int j = 0; j < mx; j++) {\n                for (int h = 1; h <= k; h++) {\n                    int tmp = h * h * d - (h - 1) * (h - 1) * d;\n                    flow.link(id[u][j], id[v][j + 1], 1, c + tmp);\n                    flow.link(id[v][j], id[u][j + 1], 1, c + tmp);\n                }\n            }\n        }\n        \n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                flow.link(id[i][j], id[i][j + 1], Integer.MAX_VALUE, c);\n            }\n        }\n        \n        for (int i = 1; i <= k; i++) {\n            flow.link(s, id[a[i]][0], 1, 0);\n        }\n        \n        for (int j = 1; j <= mx; j++) {\n            flow.link(id[1][j], t, Integer.MAX_VALUE, 0);\n        }\n        \n        int[] result = flow.run(s, t);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00017724849749356508, -3.6954811548639555e-06, -7.152555099310121e-07, -0.008801357820630074, -2.1934269170742482e-05, -0.31328168511390686, -0.4287453889846802, -0.0003036991402041167, -4.768370445162873e-07, -5.8053239627042785e-05, -0.016035638749599457, -0.0004911408759653568, -0.011677835136651993, -0.4761486053466797, -2.539125671319198e-05, -0.1275205910205841, -0.09392131865024567, -1.1920928244535389e-07, -0.08945803344249725, -1.6689286894688848e-06, -3.2782016205601394e-05, -0.0001829695247579366, -4.875540980719961e-05, -0.000506511190906167, -8.940656698541716e-06, -5.960462772236497e-07, -6.16293036728166e-05, -0.00038521020906046033, -5.721882189391181e-05, -8.4638240878121e-06, 0.0, -4.887569048150908e-06, -1.311301275563892e-06, -4.0411134250462055e-05, -7.986990567587782e-06, -0.00017987063620239496, -2.3841830625315197e-06, -4.768370445162873e-07, -0.3484460115432739, -0.5231415629386902, -7.152555099310121e-07, -0.00017617580306250602, -0.0011928117601200938, -0.0005311747081577778, -3.099436753473128e-06, -7.152555099310121e-07, -0.0013488966505974531, -9.536738616588991e-07, -0.0005062728887423873, -0.00023541064001619816, -1.1920922133867862e-06, -0.523554801940918, -0.0006486457423307002, 0.0, -1.1801649634435307e-05, -2.3841855067985307e-07, -1.1920922133867862e-06, -2.3841855067985307e-07, -5.364403477869928e-06, -6.401333666872233e-05, -7.748573807475623e-06, -0.42878079414367676, -0.0624660961329937, -0.00015817821258679032, -0.0067985886707901955, -2.861018856492