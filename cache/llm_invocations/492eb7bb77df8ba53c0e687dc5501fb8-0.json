ange(k):\n        M[0][i] = Matrix(k + 1)\n        for j in range(k):\n            M[0][i].m[i][j] = 1\n\n    kp = [0] * 100\n    kp[0] = 1\n    kp[1] = k\n    lg = 2\n    while kp[lg - 1] <= n // k:\n        kp[lg] = kp[lg - 1] * k\n        lg += 1\n\n    for i in range(1, lg):\n        M[i][0] = Matrix(k + 1)\n        for j in range(1, k):\n            M[i][j] = M[i - 1][j - 1] * M[i][j - 1]\n        cpro = Matrix(k + 1)\n        for j in range(k - 1, -1, -1):\n            cpro = cpro * M[i - 1][j]\n            M[i][j] = M[i][j] * cpro\n\n    ans = Matrix(k + 1)\n    cc = 0\n    for i in range(lg - 1, -1, -1):\n        while kp[i] <= n:\n            n -= kp[i]\n            ans = M[i][cc] * ans\n            cc += 1\n            cc %= k\n\n    ret = 0\n    for i in range(k + 1):\n        ret += ans.m[i][k]\n        ret %= MOD\n    print(ret)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0010548417922109365, -0.00018422940047457814, -5.512236498361744e-07, -1.3663626305060461e-05, -1.9486030340194702, -3.128163257315464e-07, -3.292907877039397e-06, -4.320199877838604e-07, -4.596781946020201e-05, -9.088346359931165e-07, 0.0, 0.0, 0.0, -3.128163257315464e-07, -0.008650737814605236, -4.4418171455617994e-05, 0.0, -0.00013333676906768233, -9.253090865968261e-06, -1.6240566083070007e-06, 0.0, -1.981667537620524e-06, 0.0, -0.00014454191841650754, -9.729906196298543e-06, -6.153795766294934e-06, -4.320199877838604e-07, -7.896309739408025e-07, -0.13204409182071686, -9.088346359931165e-07, -3.643152740551159e-05, 0.0, 0.0, -1.3856492842023727e-06, -1.9361264946837764e-07, 0.0, -7.703443770878948e-06, -3.128163257315464e-07, -2.5941604690160602e-05, 0.0, -5.512236498361744e-07, 0.0, -1.9361264946837764e-07, -4.127333340875339e-06, -1.1472419600977446e-06, 0.0, 0.0, 0.0, 0.0, -1.7432603272027336e-06, -3.128163257315464e-07, -9.088346359931165e-07, -1.9361264946837764e-07, -5.512236498361744e-07, -0.050