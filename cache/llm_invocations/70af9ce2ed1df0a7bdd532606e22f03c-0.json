 }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        \n        Mint[][] p = new Mint[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                double x = sc.nextDouble();\n                p[i][j] = new Mint((int)(x / 100.0 * MOD + 0.5));\n            }\n        }\n        \n        long[] no = new long[n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < (1 << n); j++) {\n                if ((j & (1 << i)) == 0) {\n                    no[i] |= (1L << j);\n                }\n            }\n        }\n        \n        Map<Long, Mint> dp = new HashMap<>();\n        dp.put(1L, new Mint(1));\n        \n        for (int i = 0; i < n; i++) {\n            Map<Long, Mint> ndp = new HashMap<>();\n            for (Map.Entry<Long, Mint> entry : dp.entrySet()) {\n                long mask = entry.getKey();\n                Mint prob = entry.getValue();\n                \n                for (int j = 0; j < (1 << n); j++) {\n                    long res = 0;\n                    Mint cur = new Mint(1);\n                    for (int k = 0; k < n; k++) {\n                        if ((j & (1 << k)) != 0) {\n                            cur.mul(p[i][k]);\n                            res |= (mask & no[k]) << (1L << k);\n                        } else {\n                            Mint one = new Mint(1);\n                            Mint pVal = p[i][k];\n                            Mint diff = new Mint(one.x - pVal.x);\n                            cur.mul(diff);\n                        }\n                    }\n                    ndp.put(res, ndp.getOrDefault(res, new Mint(0)).add(prob.mul(cur)));\n                }\n            }\n            dp = ndp;\n        }\n        \n        System.out.println(dp.get(1L << ((1 << n) - 1)).x);\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0