== 0:\n                        cur[u] = e\n                        return s\n            e = nxt[e]\n            cur[u] = e   # advance cur\n        return s\n\n    ans = 0\n    while bfs():\n        for i in range(max_node + 1):\n            cur[i] = fi[i]\n        flag = [0]*(max_node+1)\n        ans += dfs(SRC, INF) * dis[SNK]\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.4662635294371285e-05, 0.0, -1.1920928244535389e-07, -0.0009266611887142062, -0.006807231809943914, -1.1920928244535389e-07, -4.8874615458771586e-05, -0.09567708522081375, -2.0265558760002023e-06, -2.3841855067985307e-07, -3.4570634852570947e-06, -0.011070851236581802, -0.0894329622387886, -0.12077922374010086, -0.47418278455734253, -4.410734163684538e-06, -0.0026771915145218372, -6.318072337307967e-06, -1.9103243350982666, 0.0, -0.6932955980300903, -1.0132738680113107e-05, -1.5019428730010986, -1.0132738680113107e-05, -7.152555099310121e-07, -2.50339189733495e-06, -7.152555099310121e-07, -0.004081254359334707, -1.1920928244535389e-07, 0.0, -0.0011701886542141438, -8.344646857949556e-07, -8.344646857949556e-07, -5.602820692729438e-06, -2.50339189733495e-06, -0.0002308817347511649, -2.3841855067985307e-07, -6.437280717364047e-06, -0.011093840934336185, -1.2993727978027891e-05, -6.198863957251888e-06, -4.0531076592742465e-06, -0.00020418466010596603, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -0.06208055093884468, 0.0, -1.1920928244535389e-07, -0.0001392267586197704, 0.0, -1.1920928244535389e-07, 0.0, -6.9141146923357155e-06, 0.0, -3.2305197237292305e-05, -0.0012834176886826754, 0.0, -2.3841855067985307e-07, 0.0, -1.6689160474925302e-05, 0.0, -8.4638240878121e-06, -0.0005858612130396068, 0.0, -8.344646857949556e-07, 0.0, -1.4781842764932662e-05, 0.0, -7.152555099310121e-07, -0.0007135705673135817, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, -0.2519318163394928, -2.861018856492592e-06,