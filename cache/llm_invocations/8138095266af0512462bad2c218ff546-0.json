   }\n      }\n    }\n    return d[T] != N + 1;\n  }\n\n  LL DFS(int u, int T, LL flow = -1) {\n    if (u == T || flow == 0) return flow;\n    for (int &i = pt[u]; i < g[u].size(); ++i) {\n      Edge &e = E[g[u][i]];\n      Edge &oe = E[g[u][i]^1];\n      if (d[e.v] == d[e.u] + 1) {\n        LL amt = e.cap - e.flow;\n        if (flow != -1 && amt > flow) amt = flow;\n        if (LL pushed = DFS(e.v, T, amt)) {\n          e.flow += pushed;\n          oe.flow -= pushed;\n          return pushed;\n        }\n      }\n    }\n    return 0;\n  }\n\n  LL MaxFlow(int S, int T) {\n    LL total = 0;\n    while (BFS(S, T)) {\n      fill(pt.begin(), pt.end(), 0);\n      while (LL flow = DFS(S, T))\n        total += flow;\n    }\n    return total;\n  }\n};\n\nint main(){\n\tmemset(dp, -1, sizeof(dp));\n\tint n, t;\n\tscanf(\"%d%d\", &n, &t);\n\tfor(int i=1;i<=n;i++){\n\t\tscanf(\"%s\", s1[i]+1);\n\t}\n\tfor(int i=0;i<=t+1;i++){\n\t\tfor(int j=1;j<=n;j++){\n\t\t\tfor(int k=1;k<=n;k++){\n\t\t\t\tidx[i][j][k] = id++;\n\t\t\t}\n\t\t}\n\t}\n\tid++;\n\tfor(int i=1;i<=n;i++){\n\t\tscanf(\"%s\", s2[i]+1);\n\t}\n\tqueue<pii> q;\n\tfor(int i=1;i<=n;i++){\n\t\tfor(int j=1;j<=n;j++){\n\t\t\tif(s1[i][j] == 'Z'){\n\t\t\t\tq.push(pii(i, j));\n\t\t\t\tdp[i][j] = 0;\n\t\t\t}\n\t\t}\n\t}\n\twhile(!q.empty()){\n\t\tint uy = q.front().first, ux = q.front().second;\n\t\tq.pop();\n\t\tfor(int i=0;i<4;i++){\n\t\t\tint vy = uy+dir[i][0], vx = ux+dir[i][1];\n\t\t\tif(vy >= 1 && vy <= n && vx >= 1 && vx <= n && s1[vy][vx] != 'Y' && dp[vy][vx] == -1){\n\t\t\t\tdp[vy][vx] = dp[uy][ux] + 1;\n\t\t\t\tq.push(pii(vy, vx));\n\t\t\t}\t\t\t\t\n\t\t}\n\t}\n\tfor(int i=1;i<=n;i++){\n\t\tfor(int j=1;j<=n;j++){\n\t\t\tif(dp[i][j] == -1) dp[i][j] = 1e9;\n\t\t\tif(dp[i][j] > t) dp[i][j] = 1e9;\n\t\t}\n\t}\n\tint source = 0, sink = id-1;\n\tDinic dinic(id);\n\tfor(int i=1;i<=n;i++){\n\t\tfor(int j=1;j<=n;j++){\n\t\t\tif(s1[i][j] >= '1' && s1[i][j] <= '9'){\n\t\t\t\tdinic.AddEdge(source, idx[0][i][j], s1[i][j]-'0');\n\t\t\t}\n\t\t}\n\t}\n\tfor(int i=1;i<=n;i++){\n\t\tfor(int j=1;j<=n;j++){\n\t\t\tif(s1[i][j] == 'Y' || s1[i][j] == 'Z') continue;\n\t\t\tfor(int k=0;k<4;k++){\n\t\t\t\tint vy = i+dir[k][0], vx = j+dir[k][1];\n\t\t\t\tif(vy >= 1 && vy <= n && vx >= 1 && vx <= n && s1[vy][vx] != 'Y' && s1[vy][vx] != 'Z'){\n\t\t\t\t\tfor(int x=0;x<t;x++){\n\t\t\t\t\t\tif(dp[vy][vx] >= x+1 && dp[i][j] > x){\n\t\t\t\t\t\t\tdinic.AddEdge(idx[x][i][j], idx[x+1][vy][vx], 1000);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tfor(int i=1;i<=n;i++){\n\t\tfor(int j=1;j<=n;j++){\n\t\t\tif(s1[i][j] == 'Y' || s1[i][j] == 'Z') continue;\n\t\t\tfor(int x=0;x<=t;x++){\n\t\t\t\tif(s2[i][j] >= '1' && s2[i][j] <= '9'){\n\t\t\t\t\tdinic.AddEdge(idx[x][i][j], idx[t+1][i][j], s2[i][j]-'0');\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tfor(int i=1;i<=n;i++){\n\t\tfor(int j=1;j<=n;j++){\n\t\t\tif(s1[i][j] == 'Y' || s1[i][j] == 'Z') continue;\n\t\t\tif(s2[i][j] >= '1' && s2[i][j] <= '9'){\n\t\t\t\tdinic.AddEdge(idx[t+1][i][j], sink, s2[i][j]-'0');\n\t\t\t}\n\t\t}\n\t}\n\tprintf(\"%d\\n\", dinic.MaxFlow(source, sink));\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    \n    # read s1\n    s1 = []\n    for _ in range(n):\n        s1.append(next(it).strip())\n    \n    # read s2\n    s2 = []\n    for _ in range(n):\n        s2.append(next(it).strip())\n    \n    # dp: distance to nearest 'Z' (before time limit)\n    dp = [[-1] * n for _ in range(n)]\n    q = deque()\n    for i in range(n):\n        for j in range(n):\n            if s1[i][j] == 'Z':\n                dp[i][j] = 0\n                q.append((i, j))\n    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    while q:\n        uy, ux = q.popleft()\n        for dy, dx in dirs:\n            vy, vx = uy + dy, ux + dx\n            if 0 <= vy < n and 0 <= vx < n and s1[vy][vx] != 'Y' and dp[vy][vx] == -1:\n                dp[vy][vx] = dp[uy][ux] + 1\n                q.append((vy, vx))\n    # set unreachable or >t to INF\n    for i in range(n):\n        for j in range(n):\n            if dp[i][j] == -1 or dp[i][j] > t:\n                dp[i][j] = INF\n\n    # compute node ids: time layer 0 .. t+1, each n*n nodes, total nodes = (t+2)*n*n + 2\n    num_layers = t + 2\n    max_id = num_layers * n * n\n    source = 0\n    sink = max_id + 1\n    total_nodes = max_id + 2\n    \n    # idx[time][i][j] = node id (1-indexed)\n    idx = [[[0]*n for _ in range(n)] for __ in range(num_layers)]\n    cur_id = 1\n    for time in range(num_layers):\n        for i in range(n):\n            for j in range(n):\n                idx[time][i][j] = cur_id\n                cur_id += 1\n    # cur_id after loops = max_id+1\n    \n    # Dinic implementation\n    # graph: list of list of edges, each edge is [to, rev, cap]\n    graph = [[] for _ in range(total_nodes)]\n    \n    def add_edge(u, v, cap):\n        graph[u].append([v, len(graph[v]), cap])\n        graph[v].append([u, len(graph[u]) - 1, 0])\n    \n    # source to time 0 nodes (s1 digits)\n    for i in range(n):\n        for j in range(n):\n            ch = s1[i][j]\n            if '1' <= ch <= '9':\n                add_edge(source, idx[0][i][j], ord(ch) - ord('0'))\n    \n    # edges between layers for moves\n    for i in range(n):\n        for j in range(n):\n            if s1[i][j] in ('Y', 'Z'):\n                continue\n            # for each direction\n            for dy, dx in dirs:\n                vy = i + dy\n                vx = j + dx\n                if 0 <= vy < n and 0 <= vx < n and s1[vy][vx] not in ('Y', 'Z'):\n                    # for each time step from 0 to t-1\n                    for x in range(t):\n                        if dp[vy][vx] >= x + 1 and dp[i][j] > x:\n                            add_edge(idx[x][i][j], idx[x+1][vy][vx], 1000)\n    \n    # edges from each time layer to the t+1 layer (sink connections via s2)\n    for i in range(n):\n        for j in range(n):\n            if s1[i][j] in ('Y', 'Z'):\n                continue\n            ch = s2[i][j]\n            if '1' <= ch <= '9':\n                cap = ord(ch) - ord('0')\n                # for each time x from 0 to t\n                for x in range(t + 1):\n                    add_edge(idx[x][i][j], idx[t+1][i][j], cap)\n                # also from t+1 to sink\n                add_edge(idx[t+1][i][j], sink, cap)\n    \n    # Dinic max flow\n    N = total_nodes\n    level = [0] * N\n    it_ptr = [0] * N\n    \n    def bfs():\n        for i in range(N):\n            level[i] = -1\n        q = deque([source])\n        level[source] = 0\n        while q:\n            u = q.popleft()\n            for v, rev, cap in graph[u]:\n                if cap > 0 and level[v] < 0:\n                    level[v] = level[u] + 1\n                    q.append(v)\n        return level[sink] >= 0\n    \n    def dfs(u, flow):\n        if u == sink:\n            return flow\n        for i in range(it_ptr[u], len(graph[u])):\n            it_ptr[u] = i\n            v, rev, cap = graph[u][i]\n            if cap > 0 and level[v] == level[u] + 1:\n                ret = dfs(v, min(flow, cap))\n                if ret > 0:\n                    # update residual capacities\n                    graph[u][i][2] -= ret\n                    graph[v][rev][2] += ret\n                    return ret\n        return 0\n    \n    max_flow = 0\n    while bfs():\n        for i in range(N):\n            it_ptr[i] = 0\n        while True:\n            pushed = dfs(source, INF)\n            if not pushed:\n                break\n            max_flow += pushed\n    \n    sys.stdout.write(str(max_flow))\n\nif __name__ == '__main__':\n    solve()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "toke