self.cache = {}\n        self.cs = \"\"\n\n    def dfs(self, x, y, v1, v2):\n        d = abs(x - y)\n        if self.best <= 1 or d - self.C[v1][self.r] * self.C[v2][self.r] >= self.best:\n            return\n        if v1 == self.r - 1 and v2 == self.r - 1:\n            if d < self.best:\n                self.best = d\n            return\n        if v1 >= self.r:\n            c1 = self.C[v1][self.r] - self.C[v1 - 1][self.r]\n            s2 = self.C[v2][self.r]\n            self.dfs(x, y + c1 * s2, v1 - 1, v2)\n        if v2 >= self.r:\n            s1 = self.C[v1][self.r]\n            c2 = self.C[v2][self.r] - self.C[v2 - 1][self.r]\n            self.dfs(x + s1 * c2, y, v1, v2 - 1)\n\n    def solve(self, x, y, v1, v2):\n        k = x * 10000 + v1 * 100 + v2\n        got = self.cache.get(k)\n        if got is not None:\n            return got\n        val = 0\n        d = abs(x - y)\n        if d - self.C[v1][self.r] * self.C[v2][self.r] > self.best:\n            self.cache[k] = val\n            return val\n        if v1 == 0 and v2 == 0:\n            return 1\n        ch = self.cs[v1 + v2 - 1]\n        if v1 > 0 and ch != 'B':\n            c1 = self.C[v1][self.r] - self.C[v1 - 1][self.r]\n            s2 = self.C[v2][self.r]\n            val += self.solve(x, y + c1 * s2, v1 - 1, v2)\n        if v2 > 0 and ch != 'A':\n            s1 = self.C[v1][self.r]\n            c2 = self.C[v2][self.r] - self.C[v2 - 1][self.r]\n            val += self.solve(x + s1 * c2, y, v1, v2 - 1)\n        self.cache[k] = val\n        return val\n\n    def start(self):\n        # Read input\n        line = sys.stdin.readline().strip()\n        if not line:\n            return\n        parts = line.split()\n        self.r = int(parts[0])\n        self.c = int(parts[1])\n        self.cs = sys.stdin.readline().strip()\n        n = 2 * (self.r + self.c)\n        # Initialize binomial coefficients up to n\n        self.C = [[0] * (n + 1) for _ in range(n + 1)]\n        for i in range(n + 1):\n     