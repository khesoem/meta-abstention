        last_known = self.invFactorial.size() - 1\n            if last_known < n:\n                f_inv = []\n                f_inv.append(self.inv(self.fact(n)))\n                for i in range(1, n - last_known):\n                    f_inv.append(self.mult(f_inv[i - 1], n - i + 1))\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(f_inv[i])\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for arg in args:\n                r = self.mult_two(r, arg)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_reader, out_writer):\n        self.n = in_reader.nextInt()\n        self.m = in_reader.nextInt()\n\n        self.mod.fInv(self.n + self.m)\n\n        phase_size = 1\n        p = 1\n        for i in range(self.n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, self.n - i, self.mod.smallInv(self.n + self.m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, self.n + 1):\n            num_phases = self.mod.mult(self.m + k, self.mod.smallInv(k))\n            term = self.mod.mult(self.mod.ncr(self.n, k), num_phases, phase_size)\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out_writer.println(answer)\n\n\ndef main():\n    input_stream = sys.stdin\n    output_stream = sys.stdout\n\n    in_reader = InputReader(input_stream)\n    out_writer = lambda x: output_stream.write(str(x) + '\\n')\n\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out_writer)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.033100700937212e-05, -8.344646857949556e-07, -4.768370445162873e-07, -0.0010307481279596686, -0.023521210998296738, -0.004309296607971191, -0.160276398062706, -0.38897809386253357, -0.011341151781380177, -0.043984103947877884, -0.7813110947608948, -1.5497195136049413e-06, -5.364403477869928e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.00017653337272349745, -1.1920922133867862e-06, -3.576278118089249e-07, -2.0265558760002023e-06, -2.3841855067985307e-07, -3.0517112463712692e-05, -1.0251946150674485e-05, -2.145764938177308e-06, -1.168244216387393e-05, -0.00014304091746453196, -1.1920928244535389e-07, -0.00873069278895855, -0.0004702892620116472, -1.311301275563892e-06, -1.4305012882687151e-05, -0.0004911408759653568, -1.1801649634435307e-05, -4.768