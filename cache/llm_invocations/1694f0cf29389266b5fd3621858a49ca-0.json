):\n    while y:\n        x, y = y, x % y\n    return x\n\ndef FPW(x, y, mod):\n    res = 1\n    while y:\n        if y & 1:\n            res = res * x % mod\n        x = x * x % mod\n        y >>= 1\n    return res\n\nmod1 = 998244353\nmod2 = int(1e9 + 7)\n\nN = read()\ncnt = 0\nfirsum = [0] * 7\nfirds = [[] for _ in range(7)]\n\ndef dfs1(dep, now):\n    global cnt\n    if dep > 6:\n        return\n    fird_value = (cnt - now + mod1) % mod1\n    firds[dep].append(fird_value)\n    firsum[dep] += fird_value\n    cnt += 1\n    for i in range(10):\n        dfs1(dep + 1, now * 10 + i)\n\ncnt2 = -1\nans = 0\n\ndef lower_bound(arr, target):\n    left, right = 0, len(arr)\n    while left < right:\n        mid = (left + right) // 2\n        if arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n    return left\n\ndef dfs2(dep, now):\n    global cnt2, ans\n    if now > N:\n        return\n    if now * 1000000 + 999999 <= N and now * 10000000 > N:\n        for i in range(7):\n            st = (cnt2 + 1 - now * FPW(10, i, mod1) % mod1 + mod1) % mod1\n            pos = lower_bound(firds[i], mod1 - st)\n            ans += (firsum[i] + st * len(firds[i]) - mod1 * (len(firds[i]) - pos))\n            ans %= mod2\n        cnt2 += cnt\n        return\n    cnt2 += 1\n    ans += ((cnt2 - now) % mod1 + mod1) % mod1\n    ans %= mod2\n    for i in range(10):\n        if dep == 0 and i == 0:\n            continue\n        dfs2(dep + 1, now * 10 + i)\n\n# Main execution\ndfs1(0, 0)\nfor i in range(7):\n    firds[i].sort()\ndfs2(0, 0)\nprint(ans)\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0009714908665046096, -0.0005728095420636237, -7.896309739408025e-07, -0.0002112886286340654, -0.33081844449043274, -0.140337735414505, -1.3856492842023727e-06, -0.00029399030609056354, -2.8802491215174086e-05, -0.0010722271399572492, -6.704273118884885e-07, -0.0019286326132714748, -1.5048530030981055e-06, 0.0, -8.53050296427682e-05, -6.7