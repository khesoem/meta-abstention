{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXS = 100000 + 10;\nconst int MOD = 1000000007;\nusing ull = unsigned long long;\n\nint n, cnt = 0;\nint nxtState[MAXS][64];\nint prob[10][10];\nint transProb[10][64];\nint dp[10][MAXS];\nmap<ull,int> mp;\n\nint modPow(int a,int b) {\n    int res = 1;\n    while(b) {\n        if(b & 1) res = 1LL * res * a % MOD;\n        a = 1LL * a * a % MOD;\n        b >>= 1;\n    }\n    return res;\n}\n\nint construct(ull s) {\n    auto it = mp.find(s);\n    if(it != mp.end()) return it->second;\n    int cur = ++cnt;\n    mp[s] = cur;\n    int M = 1 << n;\n    for(int mask = 0; mask < M; ++mask) {\n        ull ns = s;\n        for(int j = 0; j < M; ++j) {\n            for(int k = 0; k < n; ++k) {\n                if( ((j >> k) & 1) && ((mask >> k) & 1) && ((s >> (j ^ (1 << k))) & 1) ) {\n                    ns |= (1ull << j);\n                }\n            }\n        }\n        nxtState[cur][mask] = construct(ns);\n    }\n    return cur;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n;\n    construct(1);\n\n    for(int i = 0; i < n; ++i) {\n        for(int j = 0; j < n; ++j) {\n            cin >> prob[i][j];\n            prob[i][j] = 1LL * prob[i][j] * modPow(100, MOD - 2) % MOD;\n        }\n    }\n\n    for(int i = 0; i < n; ++i) {\n        for(int mask = 0; mask < (1 << n); ++mask) {\n            transProb[i][mask] = 1;\n            for(int k = 0; k < n; ++k) {\n                if((mask >> k) & 1)\n                    transProb[i][mask] = 1LL * transProb[i][mask] * prob[k][i] % MOD;\n                else\n                    transProb[i][mask] = 1LL * transProb[i][mask] * (MOD + 1 - prob[k][i]) % MOD;\n            }\n        }\n    }\n\n    dp[0][1] = 1;\n    for(int i = 0; i < n; ++i) {\n        for(int j = 1; j <= cnt; ++j) {\n            for(int mask = 0; mask < (1 << n); ++mask) {\n                int to = nxtState[j][mask];\n                dp[i + 1][to] = (dp[i + 1][to] + 1LL * dp[i][j] * transProb[i][mask]) % MOD;\n            }\n        }\n    }\n\n    if(n < 6)\n        cout << dp[n][mp[(1ull << (1 << n)) - 1]] << '\\n';\n    else\n        cout << dp[n][mp[ULLONG_MAX]] << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMOD = 1000000007\n\ndef modpow(a, b):\n    res = 1\n    while b:\n        if b & 1:\n            res = (res * a) % MOD\n        a = (a * a) % MOD\n        b >>= 1\n    return res\n\ndef compute_next(s, mask, n, M):\n    ns = s\n    for j in range(M):\n        for k in range(n):\n            if (j >> k) & 1 and (mask >> k) & 1 and ((s >> (j ^ (1 << k))) & 1):\n                ns |= (1 << j)\n    return ns\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    n = data[0]\n    idx = 1\n    prob = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            prob[i][j] = data[idx]\n            idx += 1\n\n    inv100 = pow(100, MOD-2, MOD)\n    for i in range(n):\n        for j in range(n):\n            prob[i][j] = (prob[i][j] * inv100) % MOD\n\n    M = 1 << n\n\n    # transProb[i][mask] for i in range(n), mask in range(M)\n    transProb = [[0]*M for _ in range(n)]\n    for i in range(n):\n        for mask in range(M):\n            prod = 1\n            for k in range(n):\n                if (mask >> k) & 1:\n                    prod = (prod * prob[k][i]) % MOD\n                else:\n                    prod = (prod * (MOD + 1 - prob[k][i])) % MOD\n            transProb[i][mask] = prod\n\n    # Build states using BFS\n    mp = {}                # state -> id\n    state_bit = [None]     # index 0 unused\n    nxt_state = [None]     # index 0 unused\n\n    start_state = 1\n    cnt = 1\n    mp[start_state] = cnt\n    state_bit.append(start_state)\n    nxt_state.append([0]*M)\n\n    q = deque()\n    q.append(cnt)\n\n    while q:\n        cur_id = q.popleft()\n        s = state_bit[cur_id]\n        for mask in range(M):\n            ns = compute_next(s, mask, n, M)\n            if ns not in mp:\n                cnt += 1\n                new_id = cnt\n                mp[ns] = new_id\n                state_bit.append(ns)\n                nxt_state.append([0]*M)\n                q.append(new_id)\n            nxt_state[cur_id][mask] = mp[ns]\n\n    total_states = cnt\n\n    # DP\n    dp = [[0]*(total_states+1) for _ in range(n+1)]\n    dp[0][1] = 1\n    for i in range(n):\n        for j in range(1, total_states+1):\n            if dp[i][j] == 0:\n                continue\n            cur_val = dp[i][j]\n            trans_row = transProb[i]\n            nxt_row = nxt_state[j]\n            for mask in range(M):\n                to = nxt_row[mask]\n                dp[i+1][to] = (dp[i+1][to] + cur_val * trans_row[mask]) % MOD\n\n    if n < 6:\n        target = (1 << (1 << n)) - 1\n    else:\n        target = (1 << 64) - 1\n\n    print(dp[n][