007;\nconst int MAX_K = 111;\n\nint n, K;\nll dp[MAX_K];\n\nint digit_sum_mod(int x) {\n    int s = 0;\n    while (x > 0) {\n        s += x % K;\n        x /= K;\n    }\n    return s % K;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> K;\n    \n    for (int i = 0; i < n; ++i) {\n        int r = digit_sum_mod(i);\n        ll temp = dp[r];\n        for (int j = 0; j < K; ++j) {\n            if (j != r) {\n                dp[r] = (dp[r] + dp[j]) % MOD;\n            }\n        }\n        dp[r] = (dp[r] + 1) % MOD;\n    }\n    \n    ll result = 1;\n    for (int i = 0; i < K; ++i) {\n        result = (result + dp[i]) % MOD;\n    }\n    \n    cout << result << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst ll MOD = 1000000007;\nconst int MAX_K = 111;\n\nint n, K;\nll dp[MAX_K];\n\nint digit_sum_mod(int x) {\n    int s = 0;\n    while (x > 0) {\n        s += x % K;\n        x /= K;\n    }\n    return s % K;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> K;\n    \n    // dp[i] represents the number of subsequences ending with digit sum % K = i\n    // Initialize dp[0] = 1 for the empty subsequence\n    dp[0] = 1;\n    \n    for (int i = 0; i < n; ++i) {\n        int r = digit_sum_mod(i);\n        // Save the current count of subsequences ending with remainder r\n        ll temp = dp[r];\n        // For each possible remainder j, we can extend subsequences ending with j by adding current element\n        // But we need to compute new values based on old values\n        ll new_dp_r = dp[r]; // start with current count\n        \n        // Add all existing subsequences that can be extended by current element\n        for (int j = 