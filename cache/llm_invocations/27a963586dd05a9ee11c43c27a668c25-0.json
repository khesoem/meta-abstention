  long ans=(small%mod*small%mod)%mod;\n        if(power%2!=0){\n            ans=(ans%mod+a%mod)%mod;\n        }\n        return ans;\n    }\n}\n\n</original_code>\n\n<translated_code>\n#include <iostream>\n#include <fstream>\n#include <sstream>\n#include <string>\n#include <cstdint>\n\nusing namespace std;\n\nlong modexp(long a, long power, int mod) {\n    if (power == 0) {\n        return 1;\n    }\n    if (power == 1) {\n        return a;\n    }\n    long small = modexp(a, power / 2, mod);\n    long ans = (small % mod * small % mod) % mod;\n    if (power % 2 != 0) {\n        ans = (ans % mod + a) % mod;\n    }\n    return ans;\n}\n\nint main() {\n    int n, m, l, r;\n    long total;\n    int mod = 998244353;\n\n    cin >> n >> m >> l >> r;\n    total = 1l * n * m;\n\n    if (total % 2 != 0) {\n        long ans = modexp(r - l + 1, total, mod);\n        cout << ans << endl;\n    } else {\n        int k = r - l + 1;\n        int e = r / 2 - l / 2;\n        if (l % 2 == 0) {\n            e++;\n        }\n        int o = k - e;\n\n        long ans = modexp(e + o, total, mod);\n        ans = (ans + modexp(e - o, total, mod)) % mod;\n        ans = (ans * modexp(2, mod - 2, mod)) % mod;\n        cout << ans << endl;\n    }\n\n    return 0;\n}\n\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.6953211426734924, -8.261545008281246e-05, -0.6375704407691956, -0.6406861543655396, -0.04564303159713745, -6.19907514192164e-05, -7.152560215217818e-07, -0.035061150789260864, -0.34332096576690674, -0.02167210914194584, -0.004796905443072319, -0.000970834749750793, -0.0004581070097628981, -0.00030653405701741576, -4.2797051719389856e-05, -0.00024399156973231584, -0.0008186471532098949, -3.826691317954101e-05, -6.878612475702539e-05, -3.445207767072134e-05, -0.0001972512254724279, -8.964940207079053e-05, -0.00038106547435745597, -0.0008465057471767068, -9.525275527266786e-05, -0.0021971145179122686, -0.00014151143841445446, -1.1920935776288388e-06, -0.0