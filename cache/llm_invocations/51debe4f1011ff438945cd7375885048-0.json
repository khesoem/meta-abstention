 <= '9') { x = x * 10 + (c - '0'); c = getchar(); }\n    return x * f;\n}\n\nll readLL() {\n    ll x = 0, f = 1;\n    char c = getchar();\n    while (c < '0' || c > '9') { if (c == '-') f = -1; c = getchar(); }\n    while (c >= '0' && c <= '9') { x = x * 10 + (c - '0'); c = getchar(); }\n    return x * f;\n}\n\nvoid add(int& x, int y) {\n    x += y;\n    if (x >= MOD) x -= MOD;\n}\n\nint main() {\n#ifndef ONLINE_JUDGE\n    freopen(\"matrix.in\", \"r\", stdin);\n    freopen(\"matrix.out\", \"w\", stdout);\n#endif\n    ll m = readLL();\n    n = readInt();\n    E.clear();\n    for (int i = 1; i <= n + 1; ++i) E.a[i][i] = 1;\n    ans = E;\n    \n    for (int i = 1; i <= n; ++i) {\n        A[i] = E;\n        for (int j = 1; j <= n + 1; ++j) A[i].a[j][i] = 1;\n    }\n    \n    pre[0] = suf[n + 1] = E;\n    for (; m; m /= n) {\n        ll u = m % n;\n        if (u) {\n            ll s = 0;\n            for (ll v = m / n; v; v /= n) s = (s + v % n) % n;\n            u = (s + u - 1) % n + 1;\n            for (; u != s; --u) {\n                if (u <= 0) u += n;\n                ans = A[u] * ans;\n            }\n        }\n        for (int i = 1; i <= n; ++i) pre[i] = pre[i - 1] * A[i];\n        for (int i = n; i >= 1; --i) suf[i] = A[i] * suf[i + 1];\n        for (int i = 1; i <= n; ++i) A[i] = suf[i] * pre[i - 1];\n    }\n    \n    int num = 1;\n    for (int i = 1; i <= n; ++i) add(num, ans.a[n + 1][i]);\n    printf(\"%d\\n\", num);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static final int MAXN = 32;\n    static int n;\n    \n    static class Matrix {\n        int[][] a = new int[MAXN][MAXN];\n        \n        void clear() {\n            for (int i = 0; i < MAXN; i++) {\n                for (int j = 0; j < MAXN; j++) {\n                    a[i][j] = 0;\n                }\n            }\n        }\n        \n        Matrix multiply(Matrix rhs) {\n            Matrix res = new Matrix();\n            res.clear();\n            for (int i = 1; i <= n + 1; i++) {\n                for (int j = 1; j <= n + 1; j++) {\n                    for (int k = 1; k <= n + 1; k++) {\n                        res.a[i][j] = (int)((res.a[i][j] + 1L * a[i][k] * rhs.a[k][j]) % MOD);\n                    }\n                }\n            }\n            return res;\n        }\n    }\n    \n    static Matrix ans = new Matrix();\n    static Matrix E = new Matrix();\n    static Matrix[] A = new Matrix[MAXN];\n    static Matrix[] pre = new Matrix[MAXN];\n    static Matrix[] suf = new Matrix[MAXN];\n    \n    static int readInt() {\n        int x = 0, f = 1;\n        char c = (char)System.in.read();\n        while (c < '0' || c > '9') { \n            if (c == '-') f = -1; \n            c = (char)System.in.read(); \n        }\n        while (c >= '0' && c <= '9') { \n            x = x * 10 + (c - '0'); \n            c = (char)System.in.read(); \n        }\n        return x * f;\n    }\n    \n    static long readLL() {\n        long x = 0, f = 1;\n        char c = (char)System.in.read();\n        while (c < '0' || c > '9') { \n            if (c == '-') f = -1; \n            c = (char)System.in.read(); \n        }\n        while (c >= '0' && c <= '9') { \n            x = x * 10 + (c - '0'); \n            c = (char)System.in.read(); \n        }\n        return x * f;\n    }\n    \n    static void add(int[] x, int idx, int y) {\n        x[idx] += y;\n        if (x[idx] >= MOD) x[idx] -= MOD;\n    }\n    \n    public static void main(String[] args) throws Exception {\n        long m = readLL();\n        n = readInt();\n        \n        // Initialize arrays\n        for (int i = 0; i < MAXN; i++) {\n            A[i] = new Matrix();\n            pre[i] = new Matrix();\n            suf[i] = new Matrix();\n        }\n        \n     