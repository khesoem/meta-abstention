\t\t\tll cur=q.top();\n\t\t\t\tint d=cur>>32, u=cur;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u])\n\t\t\t\t\tcontinue;\n\t\t\t\tfor(int i=0; i<SZ(adj[u]); ++i) {\n\t\t\t\t\tEdge &e=adj[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif (e.cap<=e.f)\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\tint nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif (prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push(((ll)nprio<<32)+v);\n\t\t\t\t\t\tprevnode[v]=u;\n\t\t\t\t\t\tprevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INT_MAX)\n\t\t\t\tbreak;\n\t\t\tfor(int i=0; i<n; ++i)\n\t\t\t\tpot[i]+=prio[i];\n\t\t\tint df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tEdge &e=adj[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df;\n\t\t\t\tadj[v][e.rev].f-=df;\n\t\t\t\tflowCost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn make_pair(flow, flowCost);\n\t}\n};\n\nint n,m,k,c,d;\n \nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tMCF nt(6+107*n);\n\tfore(_,0,k){\n\t\tint x;\n\t\tscanf(\"%d\",&x);x--;\n\t\tnt.addEdge(0,1+x,1,0);\n\t}\n\tfore(_,0,m){\n\t\tint x,y;\n\t\tscanf(\"%d%d\",&x,&y);x--;y--;\n\t\tfore(i,0,105){\n\t\t\tfore(j,0,51){\n\t\t\t\tnt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n\t\t\t\tnt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n\t\t\t}\n\t\t}\n\t}\n\tfore(i,0,105)fore(j,0,n)nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n\tfore(i,0,105)nt.addEdge(1+i*n,1+105*n,51,0);\n\tauto ans=nt.minCostFlow(0,1+105*n);\n\tprintf(\"%d\\n\",ans.snd);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class MCF {\n        int n;\n        int INF = 1000000000;\n        int[] prio, curflow, prevedge, prevnode, pot;\n        ArrayList<ArrayList<Edge>> adj;\n        PriorityQueue<Long> q;\n\n        static class Edge {\n            int to, f, cap, cost, rev;\n            Edge(int to, int f, int cap, int cost, int rev) {\n                this.to = to;\n                this.f = f;\n                this.cap = cap;\n                this.cost = cost;\n                this.rev = rev;\n            }\n        }\n\n        MCF(int n) {\n            this.n = n;\n            prio = new int[n];\n            curflow = new int[n];\n            prevedge = new int[n];\n            prevnode = new int[n];\n            pot = new int[n];\n            adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                adj.add(new ArrayList<>());\n            }\n            q = new PriorityQueue<>();\n        }\n\n        void addEdge(int s, int t, int cap, int cost) {\n            Edge a = new Edge(t, 0, cap, cost, adj.get(t).size());\n            Edge b = new Edge(s, 0, 0, -cost, adj.get(s).size());\n            adj.get(s).add(a);\n            adj.get(t).add(b);\n        }\n\n        int[] minCostFlow(int s, int t) {\n            int flow = 0, flowCost = 0;\n            while (flow < INF) {\n                q.add((long) s);\n                Arrays.fill(prio, Integer.MAX_VALUE);\n                prio[s] = 0;\n                curflow[s] = Integer.MAX_VALUE;\n                while (!q.isEmpty()) {\n                    long cur = q.poll();\n                    int d = (int) (cur >> 32);\n                    int u = (int) cur;\n                    if (d != prio[u]) continue;\n                    for (int i = 0; i < adj.get(u).size(); i++) {\n                        Edge e = adj.get(u).get(i);\n                        int v = e.to;\n                        if (e.cap <= e.f) continue;\n                        int nprio = prio[u] + e.cost + pot[u] - pot[v];\n                        if (prio[v] > nprio) {\n                            prio[v] = nprio;\n                            q.add(((long) nprio << 32) | v);\n                            prevnode[v] = u;\n                            prevedge[v] = i;\n                            curflow[v] = Math.min(curflow[u], e.cap - e.f);\n                        }\n                    }\n                }\n                if (prio[t] == Integer.MAX_VALUE) break;\n                for (int i = 0; i < n; i++) {\n                    pot[i] += prio[i];\n                }\n                int df = Math.min(curflow[t], INF - flow);\n                flow += df;\n                for (int v = t; v != s; v = prevnode[v]) {\n                    Edge e = adj.get(prevnode[v]).get(prevedge[v]);\n                    e.f += df;\n                    adj.get(v).get(e.rev).f -= df;\n                    flowCost += df * e.cost;\n                }\n            }\n            return new int[]{flow, flowCost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        MCF nt = new MCF(6 + 107 * n);\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            nt.addEdge(0, 1 + x, 1, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int t = 0; t < 105; t++) {\n                for (int j = 0; j < 51; j++) {\n                    nt.addEdge(1 + t * n + x, 1 + (t + 1) * n + y, 1, c + d * (2 * j + 1));\n                    nt.addEdge(1 + t * n + y, 1 + (t + 1) * n + x, 1, c + d * (2 * j + 1));\n                }\n            }\n        }\n        for (int t = 0; t < 105; t++) {\n            for (int j = 0; j < n; j++) {\n                nt.addEdge(1 + t * n + j, 1 + (t + 1) * n + j, 51, c);\n            }\n        }\n        for (int t = 0; t < 105; t++) {\n            nt.addEdge(1 + t * n, 1 + 105 * n, 51, 0);\n        }\n        int[] ans = nt.minCostFlow(0, 1 + 105 * n);\n        System.out.