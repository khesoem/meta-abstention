    this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static class MCF {\n        int n;\n        int[] u, v, prio, curflow, prevedge, prevnode, pot;\n        ArrayList<ArrayList<Edge>> adj;\n        static final int INF = 1000000000;\n\n        MCF(int n) {\n            this.n = n;\n            u = new int[n];\n            v = new int[n];\n            prio = new int[n];\n            curflow = new int[n];\n            prevedge = new int[n];\n            prevnode = new int[n];\n            pot = new int[n];\n            adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        }\n\n        void addEdge(int s, int t, int cap, int cost) {\n            Edge a = new Edge(t, 0, cap, cost, adj.get(t).size());\n            adj.get(s).add(a);\n            Edge b = new Edge(s, 0, 0, -cost, adj.get(s).size());\n            adj.get(t).add(b);\n        }\n\n        int[] minCostFlow(int s, int t) {\n            int flow = 0, flowCost = 0;\n            while (flow < INF) {\n                PriorityQueue<Long> q = new PriorityQueue<>();\n                Arrays.fill(prio, Integer.MAX_VALUE);\n                prio[s] = 0;\n                curflow[s] = Integer.MAX_VALUE;\n                q.add(((long)0 << 32) + s);\n                while (!q.isEmpty()) {\n                    long cur = q.poll();\n                    int d = (int)(cur >> 32);\n                    int u = (int)(cur & 0xFFFFFFFFL);\n                    if (d != prio[u]) continue;\n                    ArrayList<Edge> edges = adj.get(u);\n                    for (int i = 0; i < edges.size(); i++) {\n                        Edge e = edges.get(i);\n                        int v = e.to;\n                        if (e.cap <= e.f) continue;\n                        int nprio = prio[u] + e.cost + pot[u] - pot[v];\n                        if (prio[v] > nprio) {\n                            prio[v] = nprio;\n                            q.add(((long)nprio << 32) +