fsL(int ind, int a, int b, int mask, ll p) {\n    if (ind == C+1) { dpL[a].push_back({p, mask}); return; }\n    dfsL(ind+1, a+1, b, mask ^ (1<<ind), p + (comb[a+1][R] - comb[a][R]) * (comb[R+C][R] - comb[b][R]));\n    dfsL(ind+1, a, b+1, mask, p - (comb[b+1][R] - comb[b][R]) * (comb[R+C][R] - comb[a][R]));\n}\n\nvoid dfsR(int ind, int a, int b, int mask, ll p) {\n    if (ind == C+1) { dpR[a].push_back({p, mask}); return; }\n    dfsR(ind+1, a-1, b, mask ^ (1<<ind), p + (comb[a][R] - comb[a-1][R]) * (comb[R+C][R] - comb[b][R]));\n    dfsR(ind+1, a, b-1, mask, p - (comb[b][R] - comb[b-1][R]) * (comb[R+C][R] - comb[a][R]));\n}\n\nll ans = 0;\n\nint rev(int x, int y) {\n    int z = 0;\n    for (int i = 0; i < y; ++i)\n        if (x & (1 << i)) z |= (1 << (y - 1 - i));\n    return z;\n}\n\nvoid check(ll x, int t) {\n    int a = 0, b = 0;\n    for (int i = 0; i <= 2*C+1; ++i) {\n        if (x & (1LL << i)) a++; else b++;\n        if (a && b) {\n            for (int j = i; j <= 2*C+1; ++j) {\n                if (x & (1LL << j)) { if (S[S.size() - (2*C+2) + j] == 'B') return; }\n                else { if (S[S.size() - (2*C+2) + j] == 'A') return; }\n            }\n            int aa = 0, bb = 0;\n            for (int j = 0; j < (int)S.size() - (2*C+2) + i; ++j) {\n                if (S[j] == 'A') aa++;\n                if (S[j] == 'B') bb++;\n            }\n            ll tmp;\n            if (x & (1LL << i)) tmp = comb[R-1-aa + b+R-1-bb][R-1-aa];\n            else tmp = comb[a+R-1-aa + R-1-bb][a+R-1-aa];\n            ans += t * tmp;\n            return;\n        }\n    }\n}\n\nbool ok(ll x) {\n    for (int i = 0; i <= C; ++i) {\n        if (x & (1 << i)) { if (S[S.size() - C - 1 + i] == 'B') return false; }\n        else { if (S[S.size() - C - 1 + i] == 'A') return false; }\n    }\n    return true;\n}\n\nint main() {\n    init();\n    dfsL(0, R-1, R-1, 0, 0);\n    dfsR(0, R+C, R+C, 0, 0);\n    ll dif = INF;\n    for (int i = 0; i <= R+C; ++i) {\n        sort(dpL[i].begin(),