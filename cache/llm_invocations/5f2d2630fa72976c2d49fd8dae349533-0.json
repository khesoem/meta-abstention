_bidirectional(int u, int v, int cap, int cost) {\n        add_edge(u, v, cap, cost);\n        add_edge(v, u, 0, -cost);\n    }\n\n    static boolean spfa() {\n        Arrays.fill(dist, 1, node_count + 1, INF);\n        Arrays.fill(in_queue, 1, node_count + 1, false);\n        dist[src] = 0;\n        q.add(src);\n        in_queue[src] = true;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            in_queue[u] = false;\n            for (int e = head[u]; e != 0; e = edges[e].next) {\n                if (edges[e].cap <= 0) continue;\n                int v = edges[e].to;\n                if (dist[v] > dist[u] + edges[e].cost) {\n                    dist[v] = dist[u] + edges[e].cost;\n                    if (!in_queue[v]) {\n                        q.add(v);\n                        in_queue[v] = true;\n                    }\n                }\n            }\n        }\n        return dist[sink] < INF;\n    }\n\n    static int dfs(int u, int flow, boolean[] vis) {\n        if (u == sink) return flow;\n        vis[u] = true;\n        int pushed = flow;\n        for (int e = head[u]; e != 0; e = edges[e].next) {\n            int v = edges[e].to;\n            if (vis[v] || edges[e ^ 1].cap <= 0 || dist[u] != dist[v] + edges[e ^ 1].cost) continue;\n            int f = dfs(v, Math.min(pushed, edges[e ^ 1].cap), vis);\n            if (f > 0) {\n                pushed -= f;\n                edges[e ^ 1].cap += f;\n                edges[e].cap -= f;\n                if (pushed == 0) break;\n            }\n        }\n        return flow - pushed;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        N = Integer.parseInt(st.nextToken());\n        M = Integer.parseInt(st.nextToken());\n        K = Integer.parseInt(st.nextToken());\n        C = Integer.parseInt(st.nextToken());\n        D = Integer.parseInt(st.nextToken());\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < K; i++) {\n            cnt[Integer.parseInt(st.nextToken())]++;\n        }\n\n        for (int i = 1; i <= N; i++) {\n            for (int j = 1; j <= K + M + 2; j++) {\n                node_id[i][j] = ++node_count;\n                if (i == 1) {\n                    add_bidirectional(node_id[i][j], sink, INF, C * (j - 1));\n                }\n                if (j > 1) {\n                    add_bidirectional(node_id[i][j - 1], node_id[i][j], INF, 0);\n                }\n            }\n            if (cnt[i] > 0) {\n                add_bidirectional(src, node_id[i][1], cnt[i], 0);\n            }\n        }\n\n        for (int i = 0; i < M; i++) {\n            st = new StringTokenizer(br.readLine());\n            int a = Integer.parseInt(st.nextToken());\n            int b = Integer.parseInt(st.nextToken());\n            for (int j = 1; j <= K + M + 1; j++) {\n                for (int k = 1; k <= 2 * K - 1; k += 2) {\n                    add_bidirectional(node_id[a][j], node_id[b][j + 1], 1, k * D);\n                    add_bidirectional(node_id[b][j], node_id[a][j + 1], 1, k * D);\n                }\n            }\n        }\n\n        while (spfa()) {\n            boolean[] vis = new boolean[MAXP];\n            int flow;\n            while ((flow = dfs(src, INF, vis)) > 0) {\n                total_flow += flow;\n                min_cost += dist[sink] * flow;\n                Arrays.fill(vis, 1, node_count + 1, false);\n            }\n        }\n\n        System.out.println(min_cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001674750237725675, -4.172316494077677e-06, -1.0728830375228426e-06, -0.0021730875596404076, -4.279521817807108e-05, -0.47408461570739746, -0.002479338087141514, -5.9602869441732764e-05, -5.006777428206988e-06, -1.7046782886609435e-05, -0.0003250309091527015, -2.8013790142722428