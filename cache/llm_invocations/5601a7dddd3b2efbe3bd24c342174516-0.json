e = base * base % p;\n        expo >>= 1;\n    }\n    return res;\n}\n\null comb(int N, int M) {\n    return fact[N] * invfact[M] % p * invfact[N - M] % p;\n}\n\nint main() {\n#ifndef ONLINE_JUDGE\n    freopen(\"255x.in\", \"r\", stdin);\n    freopen(\"255x.out\", \"w\", stdout);\n#endif\n\n    fast_input::read(n);\n    fast_input::read(k);\n    fast_input::read(p);\n\n    for (int i = 1; i <= n; ++i) pc[i] = pc[i >> 1] + (i & 1);\n\n    ull powv = mod_pow(k, n);\n    if (n & 1) {\n        printf(\"%d\\n\", powv);\n        return 0;\n    }\n\n    lim = min(k, pc[n]);\n\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i % p;\n\n    invfact[n] = mod_pow(fact[n], p - 2);\n    for (int i = n; i >= 1; --i) invfact[i - 1] = invfact[i] * i % p;\n\n    vector<int> masks;\n    for (int s = n;; s = (s - 1) & n) {\n        masks.push_back(s);\n        if (s == 0) break;\n    }\n\n    for (int s : masks) dp[1][s] = (pc[s] >= 1) ? invfact[s] : 0;\n\n    for (int K = 2; K <= lim; ++K) {\n        for (int s : masks) {\n            if (pc[s] < K) {\n                dp[K][s] = 0;\n                continue;\n            }\n\n            ull cur = 0;\n            int cnt = 0;\n            for (int sub = (s - 1) & s; sub; sub = (sub - 1) & s) {\n                if (pc[sub] >= K - 1) {\n                    cur += dp[K - 1][sub] * invfact[s ^ sub];\n                    if (++cnt == 18) {\n                        cnt = 0;\n                        cur %= p;\n                    }\n                }\n            }\n            dp[K][s] = cur % p;\n        }\n    }\n\n    ull total = 0;\n    for (int i = lim; i >= 1; --i) total += comb(k, i) * dp[i][n];\n\n    ull ans = (powv - total % p * fact[n] % p + p) % p;\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class FastReader {\n        private static final int BUFFER_SIZE = 1 << 20;\n        private byte[] buffer = new byte[BUFFER_SIZE];\n        private int pos = 0, size = 0;\n        private InputStream in = System.in;\n\n        private int getByte() {\n            if (pos == size) {\n                try {\n                    size = in.read(buffer, 0, BUFFER_SIZE);\n                } catch (IOException e) {\n                    return -1;\n                }\n                pos = 0;\n                if (size == -1) return -1;\n            }\n            return buffer[pos++] & 0xFF;\n        }\n\n        public int nextInt() {\n            int c = getByte();\n            while (c != -1 && (c < '0' || c > '9') && c != '-') c = getByte();\n            int sign = 1;\n            if (c == '-') {\n                sign = -1;\n                c = getByte();\n            }\n            int x = 0;\n            while (c >= '0' && c <= '9') {\n                x = x * 10 + (c - '0');\n                c = getByte();\n            }\n            return x * sign;\n        }\n    }\n\n    static long modPow(long base, int exp, int mod) {\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = res * base % mod;\n            base = base * base % mod;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static long comb(int n, int m, long[] fact, long[] invfact, int mod) {\n        return fact[n] * invfact[m] % mod * invfact[n - m] % mod;\n    }\n\n    public static void main(String[] args) {\n        FastReader fr = new FastReader();\n        int n = fr.nextInt();\n        int k = fr.nextInt();\n        int p = fr.nextInt();\n\n        int[] pc = new int[n + 1];\n        for (int i = 1; i <= n; ++i) {\n            pc[i] = pc[i >> 1] + (i & 1);\n        }\n\n        long powv = modPow(k, n, p);\n        if ((n & 1) == 1) {\n            System.out.println(powv);\n            return;\n        }\n\n        int lim = Math.min(k, pc[n]);\n\n        long[] fact = new long[n + 1];\n        long[] invfact = new long[n + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i % p;\n\n        invfact[n] = modPow(fact[n], p - 2, p);\n        for (int i = n; i >= 1; --i) invfact[i - 1] = invfact[i] * i % p;\n\n        ArrayList<Integer> masks = new ArrayList<>();\n        for (int s = n;; s = (s - 1) & n) {\n            masks.add(s);\n            if (s == 0) break;\n        }\n\n        long[][] dp = new long[lim + 1][n + 1];\n        for (int s : masks) {\n            dp[1][s] = (pc[s] >= 1) ? invfact[s] : 0;\n        }\n\n        for (int K = 2; K <= lim; ++K) {\n            for (int s : masks) {\n                if (pc[s] < K) {\n                    dp[K][s] = 0;\n                    continue;\n                }\n                long cur = 0;\n                int cnt = 0;\n                for (int sub = (s - 1) & s; sub != 0; sub = (sub - 1) & s) {\n                    if (pc[sub] >= K - 1) {\n                        cur += dp[K - 1][sub] * invfact[s ^ sub];\n                        if (++cnt == 18) {\n                            cnt = 0;\n                            cur %= p;\n                        }\n                    }\n                }\n                dp[K][s] = cur % p;\n            }\n        }\n\n        long total = 0;\n        for (int i = lim; i >= 1; --i) {\n            total = (total + comb(k, i, fact, invfact, p) * dp[i][n]) % p;\n        }\n\n        long ans = (powv - total % p * fact[n] % p + p) % p;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.728519782773219e-05, 0.0, 0.0, -7.354942499659956e-05, -7.331102824537084e-05, -2.3841855067985307e-07, -0.00026127262390218675, -0.10080213099718094, -3.576278118089249e-07, -1.1920928244535389e-07, -5.8530047681415454e-05, -0.0012041230220347643, -8.95221673999913e-05, 0.0, -4.100715523236431e-05, -0.