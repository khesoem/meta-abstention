.size(); ++idx) {\n        int i = subs[idx];\n        if (i == 0) continue;\n        for (int j = i; j; j = (j - 1) & i) {\n            int lim = min(k, pcnt[i - j] + 1);\n            for (int s = 1; s <= lim; ++s) {\n                if (dp[s - 1][i - j]) {\n                    dp[s][i] = (int)((dp[s][i] + 1LL * dp[s - 1][i - j] * invFact[j]) % mod);\n                }\n            }\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= min(k, pcnt[n]); ++i) {\n        if (dp[i][n]) {\n            int tmp = (int)(1LL * dp[i][n] * fact[k] % mod);\n            tmp = (int)(1LL * tmp * invFact[k - i] % mod);\n            tmp = (int)(1LL * tmp * invFact[i] % mod);\n            tmp = (int)(1LL * tmp * fact[n] % mod);\n            ans = (ans + tmp) % mod;\n        }\n    }\n    printf(\"%d\\n\", (power(k, n) - ans + mod) % mod);\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef power(a, e, mod):\n    if e == 0:\n        return 1\n    r = power(a, e // 2, mod)\n    r = (r * r) % mod\n    if e & 1:\n        r = (r * a) % mod\n    return r\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n    \n    if n & 1:\n        print(power(k, n, mod))\n        return\n    \n    # factorials\n    fact = [0] * (n + 1)\n    invFact = [0] * (n + 1)\n    fact[0] = 1\n    for i in range(1, n + 1):\n        fact[i] = (fact[i-1] * i) % mod\n    \n    invFact[n] = power(fact[n], mod - 2, mod)\n    for i in range(n - 1, -1, -1):\n        invFact[i] = (invFact[i+1] * (i + 1)) % mod\n    \n    # dp[18][MAXN]\n    dp = [[0] * (n + 1) for _ in range(18)]\n    dp[0][0] = 1\n    \n    # popcount\n    pcnt = [0] * (n + 1)\n    for i in range(n + 1):\n        pcnt[i] = bin(i).count('1')\n    \n    # submasks of n\n    subs = []\n    t = n\n    while True:\n        subs.append(t)\n        if t == 0:\n            break\n        t = (t - 1) & n\n    subs.sort()\n    \n    for idx, i in enumerate(subs):\n        if i == 0:\n            continue\n        j = i\n        while j:\n            i_minus_j = i ^ j   # i - j in bits (since j is submask)\n            lim = min(k, pcnt[i_minus_j] + 1)\n            for s in range(1, lim + 1):\n                if dp[s-1][i_minus_j]:\n                    dp[s][i] = (dp[s][i] + dp[s-1][i_minus_j] * invFact[j]) % mod\n            j = (j - 1) & i\n    \n    ans = 0\n    lim_i = min(k, pcnt[n])\n    for i in range(lim_i + 1):\n        if dp[i][n]:\n            tmp = (dp[i][n] * fact[k]) % mod\n            tmp = (tmp * invFact[k - i]) % mod\n            tmp = (tmp * invFact[i]) % mod\n            tmp = (tmp * fact[n]) % mod\n            ans = (ans + tmp) % mod\n    \n    total = power(k, n, mod)\n    print((total - ans + mod) % mod)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>0.95</confidence>", "token_logprobs": [-3.802703940891661e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0012837749673053622, -0.08063600957393646, -1.7762025890988298e-05, -0.018236937001347542, -0.03213488683104515, -0.3999887704849243, -0.003234514268115163, -0.0024791003670543432, -7.152555099310121e-07, -0.0024819541722536087, -0.00012861855793744326, -0.00026901919045485556, -1.9073468138230965e-06, -0.0345490425825119, -3.4570634852570947e-06, -2.9802276912960224e-06, -1.1920928244535389e-07, -1.8954096958623268e-05, -5.149708886165172e-05, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, 0.0, -0.029752152040600777, -1.1920928244535389e-07, -0.00193813256919384, -3.576278118089249e-07, -7.772143726469949e-05, -1.7046782886609435e-05, -1.0728830375228426e-06, -3.576278118089249e-07, -0.0012644876260310411, -1.1920928244535389e-07, -1.1920928244535389e-07, -9.667406266089529e-05, -1.1920928244535389e-07, -0.0002308817347511649, 0.0, -1.5