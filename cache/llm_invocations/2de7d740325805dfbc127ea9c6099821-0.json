 (!used[y]) { que.push(y); used[y] = 1; }\n            }\n        }\n    }\n    return dis[SRC] < 1e18;\n}\n\ninline int dfs(int x, int lim, ll &total) {\n    int flow = 0;\n    used[x] = 1;\n    if (x == SNK) return lim;\n    for (int i = first[x]; i; i = nxt[i]) {\n        int y = to[i];\n        if (!cap_e[i] || used[y]) continue;\n        if (dis[x] != dis[y] + cost_e[i]) continue;\n        int t = dfs(y, min(cap_e[i], lim - flow), total);\n        cap_e[i] -= t;\n        cap_e[i ^ 1] += t;\n        flow += t;\n        total += t * cost_e[i];\n        if (flow == lim) return lim;\n    }\n    return flow;\n}\n\ninline ll min_cost_flow() {\n    int all_flow = 0;\n    ll total = 0;\n    while (spfa()) {\n        do {\n            memset(used, 0, sizeof(used));\n            all_flow += dfs(SRC, INF, total);\n        } while (used[SNK]);\n    }\n    return total;\n}\n\nint main() {\n    int n, m, k, c, d, lim = 101;\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 0; i < k; i++) {\n        int x; cin >> x; --x;\n        add_edge(SRC, x, 1, 0);\n    }\n    for (int i = 0; i < lim; i++)\n        add_edge(i * n, SNK, k, c * i);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < lim - 1; j++)\n            add_edge(i + j * n, i + (j + 1) * n, k, 0);\n    while (m--) {\n        int x, y; cin >> x >> y; --x; --y;\n        for (int i = 0; i < lim - 1; i++)\n            for (int j = k - 1; j >= 0; j--) {\n                add_edge(x + i * n, y + (i + 1) * n, 1, d * (j * 2 + 1));\n                add_edge(y + i * n, x + (i + 1) * n, 1, d * (j * 2 + 1));\n            }\n    }\n    cout << min_cost_flow();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXV = 10005;\n    static final int SRC = MAXV - 2;\n    static final int SNK = MAXV - 1;\n    static final int MAXE = 2000000 + 10;\n    static final int INF = 2000000000;\n\n    static int[] first = new int[MAXV];\n    static int[] to = new int[MAXE + 5];\n    static int[] nxt = new int[MAXE + 5];\n    static int[] cap_e = new int[MAXE + 5];\n    static int[] cost_e = new int[MAXE + 5];\n    static boolean[] used = new boolean[MAXV];\n    static long[] dis = new long[MAXV];\n    static int edge_cnt = 1;\n\n    static void add_edge(int u, int v, int flow, int cost) {\n        edge_cnt++;\n        to[edge_cnt] = v;\n        nxt[edge_cnt] = first[u];\n        first[u] = edge_cnt;\n        cap_e[edge_cnt] = flow;\n        cost_e[edge_cnt] = cost;\n        edge_cnt++;\n        to[edge_cnt] = u;\n        nxt[edge_cnt] = first[v];\n        first[v] = edge_cnt;\n        cap_e[edge_cnt] = 0;\n        cost_e[edge_cnt] = -cost;\n    }\n\n    static boolean spfa() {\n        Arrays.fill(used, false);\n        Arrays.fill(dis, Long.MAX_VALUE / 2);\n        ArrayDeque<Integer> que = new ArrayDeque<>();\n        que.addLast(SNK);\n        dis[SNK] = 0;\n        used[SNK] = true;\n        while (!que.isEmpty()) {\n            int x = que.pollFirst();\n            used[x] = false;\n            for (int i = first[x]; i != 0; i = nxt[i]) {\n                int y = to[i];\n                if (cap_e[i ^ 1] > 0 && dis[y] > dis[x] + cost_e[i ^ 1]) {\n                    dis[y] = dis[x] + cost_e[i ^ 1];\n                    if (!used[y]) {\n                        que.addLast(y);\n                        used[y] = true;\n                    }\n                }\n            }\n        }\n        return dis[SRC] < Long.MAX_VALUE / 2;\n    }\n\n    static int dfs(int x, int limit, long[] total) {\n        int flow = 0;\n        used[x] = true;\n        if (x == SNK) return limit;\n        for (int i = first[x]; i != 0; i = nxt[i]) {\n            int y = to[i];\n            if (cap_e[i] == 0 || used[y]) continue;\n            if (dis[x] != dis[y] + cost_e[i]) continue;\n            int t = dfs(y, Math.