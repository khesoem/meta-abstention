         e.printStackTrace();\n            }\n            return str;\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        FastReader scn = new FastReader();\n        long n = scn.nextLong();\n        long a1 = scn.nextLong();\n        long a2 = scn.nextLong();\n        long a3 = scn.nextLong();\n        long b1 = scn.nextLong();\n        long b2 = scn.nextLong();\n        long b3 = scn.nextLong();\n\n        long min = computeMin(a1, a2, a3, b1, b2, b3);\n        long max = computeMax(a1, a2, a3, b1, b2, b3);\n\n        out.println(min + \" \" + max);\n        out.flush();\n    }\n\n    static long computeMin(long a1, long a2, long a3, long b1, long b2, long b3) {\n        if (b1 >= a1 + a2) {\n            return a3 - b2 - b3;\n        } else if (b2 >= a2 + a3) {\n            return a1 - b1 - b3;\n        } else if (b3 >= a1 + a3) {\n            return a2 - b1 - b2;\n        }\n        return 0L;\n    }\n\n    static long computeMax(long a1, long a2, long a3, long b1, long b2, long b3) {\n        return Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nclass FastReader:\n    def __init__(self):\n        self.br = sys.stdin\n        self.out = sys.stdout\n        self.buffer = []\n        self.index = 0\n\n    def next(self):\n        while self.index >= len(self.buffer):\n            line = self.br.readline()\n            if not line:\n                return None\n            self.buffer = line.strip().split()\n            self.index = 0\n        token = self.buffer[self.index]\n        self.index += 1\n        return token\n\n    def nextInt(self):\n        return int(self.next())\n\n    def nextLong(self):\n        return int(self.next())\n\n    def nextDouble(self):\n        return float(self.next())\n\n    def nextLine(self):\n      