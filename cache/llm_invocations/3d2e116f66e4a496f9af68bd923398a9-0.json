 &i=edge_tried[now]; i<adj[now].size(); i++){\n            int nxt = adj[now][i].v;\n            if(lev[nxt]==lev[now]+1 && adj[now][i].w!=0){\n                int nxtflow = dfs(nxt, min(fl, adj[now][i].w));\n                if(nxtflow){\n                    adj[now][i].w-=nxtflow;\n                    adj[nxt][adj[now][i].rev].w+=nxtflow;\n                    return nxtflow;\n                }\n            }\n        }\n        return 0;\n    }\n    ll dinic(){\n        ll ret=0;\n        while(assign_level()){\n            fill(edge_tried.begin(), edge_tried.end(), 0);\n            while(1){\n                int amt = dfs(st, 2e9);\n                if(amt==0)break;\n                ret+=amt;\n            }\n        }\n        return ret;\n    }\n};\n\nint n, ti, ck[15][15];\nstring str[15], es[15];\nint yy, xx;\nint dy[]={1, -1, 0, 0};\nint dx[]={0, 0, 1, -1};\nvoid go()\n{\n    queue<pair<int, int> >que;que.push({yy, xx});\n    ck[yy][xx]=1;\n    int lev=1;\n    while(!que.empty()){\n        int sz = (int)que.size();\n        for(int ite=0; ite<sz; ite++){\n        pair<int, int> now = que.front();que.pop();\n        for(int i=0; i<4; i++){\n            int ny = now.first + dy[i];\n            int nx = now.second + dx[i];\n            if(!(ny>=0 && ny<n &&nx>=0 && nx<n))continue;\n            if(ck[ny][nx] || str[ny][nx]=='Y')continue;\n            ck[ny][nx] = lev;\n            que.push({ny, nx});\n        }\n        }\n        ++lev;\n        lev=min(lev, ti);\n    }\n}\nint table[15][15][65];\nint main()\n{\n    cin>>n>>ti;\n    for(int i=0; i<n; i++){\n        cin>>str[i];\n        for(int j=0 ;j<n; j++){\n            if(str[i][j] =='Z'){\n                    yy=i, xx=j;\n            }\n        }\n    }\n    getline(cin, str[n]);\n    getline(cin, str[n]);\n\n    for(int i=0; i<n; i++){\n        cin>>es[i];\n    }\n    go();\n    int nodecnt=0;\n\n    for(int i=0; i<n; i++){\n        for(int j=0 ;j<n; j++){\n            if('0'<=str[i][j] &&str[i][j]<='9'){\n                if(ck[i][j]==0)ck[i][j] = ti;\n                for(int t =0; t<ck[i][j]; t++){\n                    table[i][j][t]=++nodecnt;\n                }\n            }\n            if('1'<=es[i][j] && es[i][j] <='9'){\n                table[i][j][ck[i][j]]=++nodecnt;\n            }\n        }\n    }\n\n\n    int INF = (int)1e9;\n    int st= 0, ed = nodecnt+3;\n    networkflow net(nodecnt+5, st, ed);\n    for(int i=0; i<n; i++){\n        for(int j=0 ;j<n; j++){\n             if('1'<=str[i][j] &&str[i][j]<='9'){\n                    net.setEdge(st, table[i][j][0], str[i][j]-'0');\n             }\n\n             for(int ite=0; ite<4; ite++){\n                int ny = i + dy[ite];\n                int nx = j + dx[ite];\n                if(!(ny>=0 && ny<n &&nx>=0 &&nx<n))continue;\n                if(str[ny][nx]=='Y' || str[ny][nx]=='Z')continue;\n                for(int t=0; ; t++){\n                    if(table[i][j][t]==0)break;\n                    if(t==ck[i][j] && es[i][j]>='1' && es[i][j]<='9')break;///\ub9c8\uc9c0\ub9c9\uace8\uc778 \uac00\ub2a5\ud558\uc9c0\ub9cc \ubfcc\ub824\uc120 \uc548\ub428\n                    if(table[ny][nx][t+1]){\n                        net.setEdge(table[i][j][t], table[ny][nx][t+1], INF);\n                    }\n                }\n             }\n\n            if('1'<=es[i][j] &&es[i][j]<='9'){\n                for(int t = 0; t<ck[i][j]; t++){\n                    net.setEdge(table[i][j][t], table[i][j][t+1], INF);\n                }\n                net.setEdge(table[i][j][ck[i][j]], ed, es[i][j]-'0');\n            }\n        }\n    }\n    int ans = net.dinic();\n    cout<<ans<<endl;\n\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass NetworkFlow:\n    def __init__(self, V, s, t):\n        self.adj = [[] for _ in range(V)]\n        self.lev = [0] * V\n        self.edge_tried = [0] * V\n        self.st = s\n        self.ed = t\n\n    def set_edge(self, u, v, fl):\n        sz1 = len(self.adj[v])\n        sz2 = len(self.adj[u])\n        self.adj[u].append([v, fl, sz1])\n        self.adj[v].append([u, 0, sz2])\n\n    def assign_level(self):\n        self.lev = [-1] * len(self.adj)\n        self.lev[self.st] = 0\n        q = deque([self.st])\n        while q:\n            now = q.popleft()\n            for nxt, w, rev in self.adj[now]:\n                if self.lev[nxt] == -1 and w != 0:\n                    self.lev[nxt] = self.lev[now] + 1\n                    q.append(nxt)\n        return self.lev[self.ed] != -1\n\n    def dfs(self, now, fl):\n        if now == self.ed:\n            return fl\n        i = self.edge_tried[now]\n        while i < len(self.adj[now]):\n            nxt, w, rev = self.adj[now][i]\n            if self.lev[nxt] == self.lev[now] + 1 and w != 0:\n                nxtflow = self.dfs(nxt, min(fl, w))\n                if nxtflow:\n                    self.adj[now][i][1] -= nxtflow\n                    self.adj[nxt][rev][1] += nxtflow\n                    return nxtflow\n            i += 1\n            self.edge_tried[now] = i\n        return 0\n\n    def dinic(self):\n        ret = 0\n        while self.assign_level():\n            self.edge_tried = [0] * len(self.adj)\n            while True:\n                amt = self.dfs(self.st, 10**9)\n                if amt == 0:\n                    break\n                ret += amt\n        return ret\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    n = int(first[0])\n    ti = int(first[1])\n    str_grid = []\n    idx = 1\n    for i in range(n):\n        str_grid.append(data[idx].strip())\n        idx += 1\n    # skip two lines (blank lines)\n    idx += 2  # because there are two getline calls in C++ (they read empty lines)\n    es_grid = []\n    for i in range(n):\n        es_grid.append(data[idx].strip())\n        idx += 1\n\n    # find start 'Z'\n    yy = xx = -1\n    for i in range(n):\n        for j in range(n):\n            if str_grid[i][j] == 'Z':\n                yy, xx = i, j\n                break\n        if yy != -1:\n            break\n\n    # BFS to compute ck (distance from start, capped at ti)\n    ck = [[0]*n for _ in range(n)]\n    dy = [1, -1, 0, 0]\n    dx = [0, 0, 1, -1]\n    q = deque()\n    q.append((yy, xx))\n    ck[yy][xx] = 1\n    lev = 1\n    while q:\n        sz = len(q)\n        for _ in range(sz):\n            y, x = q.popleft()\n            for d in range(4):\n                ny = y + dy[d]\n                nx = x + dx[d]\n                if 0 <= ny < n and 0 <= nx < n:\n                    if ck[ny][nx] == 0 and str_grid[ny][nx] != 'Y':\n                        ck[ny][nx] = lev\n                        q.append((ny, nx))\n        lev += 1\n        if lev > ti:\n            break\n\n    # assign node numbers\n    table = [[[0]*65 for _ in range(n)] for _ in range(n)]\n    nodecnt = 0\n    for i in range(n):\n        for j in range(n):\n            if '0' <= str_grid[i][j] <= '9':\n                if ck[i][j] == 0:\n                    ck[i][j] = ti\n                for t in range(ck[i][j]):\n                    nodecnt += 1\n                    table[i][j][t] = nodecnt\n            if '1' <= es_grid[i][j] <= '9':\n                nodecnt += 1\n                table[i][j][ck[i][j]] = nodecnt\n\n    INF = 10**9\n    st = 0\n    ed = nodecnt + 3\n    net = NetworkFlow(nodecnt + 5, st, ed)\n\n    for i in range(n):\n        for j in range(n):\n            if '1' <= str_grid[i][j] <= '9':\n                net.set_edge(st, table[i][j][0], ord(str_grid[i][j]) - ord('0'))\n\n            for d in range(4):\n                ny = i + dy[d]\n                nx = j + dx[d]\n                if 0 <= ny < n and 0 <= nx < n:\n                    if str_grid[ny][nx] in ('Y', 'Z'):\n                        continue\n                    t = 0\n                    while True:\n                        if table[i][j][t] == 0:\n                            break\n                        if t == ck[i][j] and '1' <= es_grid[i][j] <= '9':\n                            break  # last goal possible but not spread\n                        if table[ny][nx][t+1]:\n                            net.set_edge(table[i][j][t], table[ny][nx][t+1], INF)\n                        t += 1\n\n            if '1' <= es_grid[i][j] <= '9':\n                for t in range(ck[i][j]):\n                    net.set_edge(table[i][j][t], table[i][j][t+1], INF)\n                net.set_edge(table[i][j][ck[i][j]], ed, ord(es_grid[i][j]) - ord('0'))\n\n    ans = net.dinic()\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.2053474822314456e-05, 0.0, 0.0, -0.0009259465732611716, -0.004692613612860441, -8.344646857949556e-07, -5.245195097813848e-06, -6.198863957251888e-06, -1.5497195136049413e-06, 0.0, -8.344646857949556e-07, -0.014315642416477203, -0.0017007424030452967, -0.0003948624071199447, -1.7881377516459906e-06, -5.960462772236497e-07, -2.3841855067985307e-07, -0.16028951108455658, -4.172316494077677e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.00016008525562938303, -5.8887653722194955e-05, -0.00016592556494288146, -4.768370445162873e-07, 0.0, -2.622600959512056e-06, 0.0, -8.344646857949556e-07, -0.06285082548856735, 0.0, 0.0, -1.0728830375228426e-06, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -0.003196846228092909, 0.0, 0.0, -0.005817861296236515, -3.3378546504536644e-06, 0.0, -0.4740903377532959, -3.6954811548639555e-06, -0.07889030128717422, -1.1920928244535389e-07, -2.622600959512056e-06, -1.0371154530730564e-05, 0.0, 0.0, -7.83174327807501e-05, -2.276871418871451e-05, -1.4305104514278355e-06, -2.3841855067985307e-07, 0.0, -1.311301275563892e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, 