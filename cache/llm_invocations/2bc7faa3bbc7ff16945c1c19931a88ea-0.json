g[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] tokens = br.readLine().split(\" \");\n        int N = Integer.parseInt(tokens[0]);\n        long pk = Long.parseLong(tokens[1]);\n\n        if (pk > N - 1) {\n            System.out.println(0);\n            return;\n        }\n\n        int k = (int) pk;\n        int c = N - k;\n        fact = new long[Math.max(N + 5, c + 1)];\n        fact[0] = 1;\n\n        for (int i = 1; i < fact.length; i++) {\n            fact[i] = (i * fact[i - 1]) % MOD;\n        }\n\n        long total = 0;\n        int alternating = 1;\n\n        for (int i = c; i >= 0; i--) {\n            long comb = combination(c, i);\n            long power = exponentiate(i, N);\n            long contribution = (comb * power) % MOD;\n            total = (total + alternating * contribution + MOD) % MOD;\n            alternating = -alternating;\n        }\n\n        total = (total * combination(N, c)) % MOD;\n        if (k > 0) {\n            total = (2 * total) % MOD;\n        }\n\n        System.out.println(total);\n    }\n\n    private static long combination(int n, int r) {\n        long denominator = (fact[r] * fact[n - r]) % MOD;\n        return (fact[n] * modInverse(denominator)) % MOD;\n    }\n\n    private static long modInverse(long a) {\n        return exponentiate(a, MOD - 2);\n    }\n\n    private static long exponentiate(long base, int exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class e_e86_v4 {\n    private static final int MOD = 998244353;\n    private static long[] fact;\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] tokens = br.readLine().split(\" \");\n        int N = Integer.parseInt(tokens[0]);\n        long pk = Long.parseLong(tokens[1]);\n\n        if (pk > N - 1) {\n            System.out.println(0);\n            return;\n        }\n\n        int k = (int) pk;\n        int c = N - k;\n        fact = new long[Math.max(N + 5, c + 1)];\n        fact[0] = 1;\n\n        for (int i = 1; i < fact.length; i++) {\n            fact[i] = (i * fact[i - 1]) % MOD;\n        }\n\n        long total = 0;\n        int alternating = 1;\n\n        for (int i = c; i >= 0; i--) {\n            long comb = combination(c, i);\n            long power = exponentiate(i, N);\n            long contribution = (comb * power) % MOD;\n            total = (total + alternating * contribution + MOD) % MOD;\n            alternating = -alternating;\n        }\n\n        total = (total * combination(N, c)) % MOD;\n        if (k > 0) {\n            total = (2 * total) % MOD;\n        }\n\n        System.out.println(total);\n    }\n\n    private static long combination(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        long denominator = (fact[r] * fact[n - r]) % MOD;\n        return (fact[n] * modInverse(denominator)) % MOD;\n    }\n\n    private static long modInverse(long a) {\n        return exponentiate(a, MOD - 2);\n    }\n\n    private static long exponentiate(long base, int exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</repaired_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [0.0, -5.209310256759636e-05, -3.6954811548639555e-06, -1.19209