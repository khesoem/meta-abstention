ect o) {\n            if (this == o) return true;\n            if (!(o instanceof Key)) return false;\n            Key key = (Key) o;\n            return N == key.N && k == key.k && flag == key.flag;\n        }\n        @Override\n        public int hashCode() {\n            return Objects.hash(N, k, flag);\n        }\n    }\n\n    static long solve(int N, int k, boolean flag) {\n        Key key = new Key(N, k, flag);\n        if (memo.containsKey(key)) return memo.get(key);\n\n        if (N == 1) {\n            long res;\n            if (flag) {\n                res = (mod - 1) % mod; // equivalent to -1 mod mod\n            } else {\n                res = (k < 0) ? 1 : 0;\n            }\n            memo.put(key, res);\n            return res;\n        }\n\n        long inv = (long) N * (N - 1) / 2;\n\n        if (k < -inv - 1) {\n            long res = solve(N, (int)(-inv - 1), flag);\n            memo.put(key, res);\n            return res;\n        }\n        if (k >= inv) {\n            memo.put(key, 0L);\n            return 0;\n        }\n\n        long res = 0;\n        for (int d = -N + 1; d < N; d++) {\n            if (flag && d > 0) continue;\n            long term = solve(N - 1, k - d, (d == 0) && flag);\n            long mult = Math.min(N - d, d + N);\n            res = (res + term * mult) % mod;\n        }\n        // ensure non-negative\n        if (res < 0) res += mod;\n        memo.put(key, res);\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        mod = sc.nextInt();\n        long ans = solve(n, 0, true) % mod;\n        if (ans < 0) ans += mod;\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0033749546855688095, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, -5.590759246842936e-05, -5.245195097813848e-06, 0.0, -5.125986263010418e-06, -0.009