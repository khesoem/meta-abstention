elf.cur[pos] != -1 else self.head[pos]\n        while i != -1:\n            if not self.vis[self.v[i]] and self.w[i] and self.dis[self.v[i]] == self.dis[pos] + self.c[i]:\n                self.cur[pos] = i\n                fl = self.dfs(self.v[i], min(flow, self.w[i]), t)\n                self.cost += fl * self.c[i]\n                self.w[i] -= fl\n                self.w[i ^ 1] += fl\n                flow -= fl\n                if flow == 0:\n                    break\n            i = self.nxt[i]\n        return tmp - flow\n\n    def dinic(self, s, t):\n        self.cost = 0\n        self.t = t\n        while self.spfa(s, t):\n            self.cur = [-1] * N\n            self.vis = [False] * N\n            self.dfs(s, inf, t)\n        return self.cost\n\ng = FlowGraph()\n\ndef main():\n    input = sys.stdin.read().strip().split()\n    n, m, kk, c, d = map(int, input[0:5])\n    a = list(map(int, input[5:5+kk]))\n    s = 0\n    t = n * 100 + 1\n\n    for i in range(1, 101):\n        g.add_edge(i, t, inf, 0)\n\n    for i in range(kk):\n        g.add_edge(s, (a[i] - 1) * 100 + 1, 1, 0)\n\n    for i in range(2, n + 1):\n        for j in range(1, 100):\n            g.add_edge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, inf, c)\n\n    index = 5 + kk\n    for _ in range(m):\n        t1, t2 = map(int, input[index:index+2])\n        index += 2\n        for i in range(1, 100):\n            val = c + d * (i * i - (i - 1) * (i - 1))\n            g.add_edge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val)\n            g.add_edge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val)\n\n    print(g.dinic(s, t))\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00023417205375153571, -0.0008504862780682743, -5.512236498361744e-07, -1.6047699318733066e-05, -0.021139424294233322, -6.146429223008454e-05, -6.194110756041482e-05, -0.2527645528316498, -0.002876676619052887, 0.0, -1.981667537620524e-06, -0.11325936019