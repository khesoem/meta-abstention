": "google/gemma-4-31b-it"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (!sc.hasNextInt()) return;\n        int turnNum = sc.nextInt();\n        \n        int[] aliceChoices = new int[turnNum];\n        for (int i = 0; i < turnNum; i++) {\n            aliceChoices[i] = sc.nextInt();\n        }\n        \n        int[] bobChoicesOrig = new int[turnNum];\n        for (int i = 0; i < turnNum; i++) {\n            bobChoicesOrig[i] = sc.nextInt();\n        }\n        \n        // bobChoices.append(bobChoices.pop(0)) effectively rotates the list left by 1\n        int[] bobChoices = new int[turnNum];\n        for (int i = 0; i < turnNum; i++) {\n            bobChoices[i] = bobChoicesOrig[(i + 1) % turnNum];\n        }\n        \n        long minWin = 0;\n        long maxWin = 0;\n        \n        // calculate the maximum number of rounds Alice can win\n        for (int i = 0; i < turnNum; i++) {\n            maxWin += Math.min(aliceChoices[i], bobChoices[i]);\n        }\n        \n        // calculate the minimum number of rounds Alice can win\n        int bobMax = bobChoices[0];\n        for (int val : bobChoices) {\n            if (val > bobMax) bobMax = val;\n        }\n        \n        for (int i = 0; i < turnNum; i++) {\n            if (bobChoices[i] == bobMax) {\n                long sum = (long) bobChoices[i] + aliceChoices[i];\n                if (sum > minWin) {\n                    minWin = sum;\n                }\n            }\n        }\n        \n        int aliceMax = aliceChoices[0];\n        for (int val : aliceChoices) {\n            if (val > aliceMax) aliceMax = val;\n        }\n        \n        for (int i = 0; i < turnNum; i++) {\n            if (aliceChoices[i] == aliceMax) {\n                long sum = (long) aliceChoices[i] + bobChoices[i];\n                if (sum > minWin) {\n         