ightLeft - l, movesLeft - 1, !boatLeftSide)) % MOD;\n                    }\n                }\n            }\n        } else {\n            int hMoved = heavyCount - heavyLeft;\n            int lMoved = lightCount - lightLeft;\n            for (int h = 0; h <= hMoved; h++) {\n                for (int l = 0; l <= lMoved; l++) {\n                    if (h + l > 0 && 2 * h + l <= boatSize) {\n                        long ways = (combTable[hMoved][h] * combTable[lMoved][l]) % MOD;\n                        result = (result + ways * calculate(heavyLeft + h, lightLeft + l, movesLeft - 1, !boatLeftSide)) % MOD;\n                    }\n                }\n            }\n        }\n        return dpMem[heavyLeft][lightLeft][movesLeft][sideIndex] = result;\n    }\n\n    static long powerMod(long base, long exponent, long modulus) {\n        long result = 1;\n        base %= modulus;\n        while (exponent > 0) {\n            if ((exponent & 1) == 1) {\n                result = (result * base) % modulus;\n            }\n            base = (base * base) % modulus;\n            exponent >>= 1;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        int n = Integer.parseInt(br.readLine().trim());\n        boatSize = Integer.parseInt(br.readLine().trim()) / 50;\n        heavyCount = 0;\n        lightCount = 0;\n        for (int i = 0; i < n; i++) {\n            int weight = Integer.parseInt(br.readLine().trim());\n            if (weight == 100) heavyCount++;\n            else lightCount++;\n        }\n\n        dpMem = new long[heavyCount + 1][lightCount + 1][201][2];\n        for (int i = 0; i <= heavyCount; i++) {\n            for (int j = 0; j <= lightCount; j++) {\n                for (int k = 0; k <= 200; k++) {\n                    dpMem[i][j][k][0] = -1;\n                    dpMem[i][j][k][1] = -1;\n                }\n            }\n