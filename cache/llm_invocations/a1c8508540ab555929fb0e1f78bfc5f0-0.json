\n    } else {\n        int hMoved = heavyCount - heavyLeft;\n        int lMoved = lightCount - lightLeft;\n        for (int h = 0; h <= hMoved; h++) {\n            for (int l = 0; l <= lMoved; l++) {\n                if (h + l > 0 && 2 * h + l <= boatSize) {\n                    long long ways = (combTable[hMoved][h] * combTable[lMoved][l]) % MOD;\n                    result = (result + ways * calculate(heavyLeft + h, lightLeft + l, movesLeft - 1, !boatLeftSide)) % MOD;\n                }\n            }\n        }\n    }\n    return dpMem[heavyLeft][lightLeft][movesLeft][sideIndex] = result;\n}\n\nlong long powerMod(long long base, long long exponent, long long modulus) {\n    long long result = 1;\n    base %= modulus;\n    while (exponent > 0) {\n        if ((exponent & 1) == 1) {\n            result = (result * base) % modulus;\n        }\n        base = (base * base) % modulus;\n        exponent >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    cin >> boatSize;\n    boatSize /= 50;\n    heavyCount = 0;\n    lightCount = 0;\n\n    for (int i = 0; i < n; i++) {\n        int weight;\n        cin >> weight;\n        if (weight == 100) heavyCount++;\n        else lightCount++;\n    }\n\n    memset(dpMem, -1, sizeof(dpMem));\n\n    for (int i = 0; i <= 50; i++) {\n        combTable[i][0] = 1;\n        for (int j = 1; j <= i; j++) {\n            combTable[i][j] = (combTable[i-1][j-1] + combTable[i-1][j]) % MOD;\n        }\n    }\n\n    for (int step = 1; step <= 200; step++) {\n        long long count = calculate(heavyCount, lightCount, step, true);\n        if (count != 0) {\n            cout << step << endl;\n            cout << count << endl;\n            return 0;\n        }\n    }\n    cout << -1 << endl;\n    cout << 0 << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.770858453819528e-05, -1.7881377516459906