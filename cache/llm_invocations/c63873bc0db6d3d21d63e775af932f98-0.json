               long phases = multiply(m + k, modInverse(k));\n                long expectation = multiply(phases, phaseCount);\n                long contribution = multiply(binomial(n, k), expectation);\n\n                if ((k & 1) == 1)\n                    result = add(result, contribution);\n                else\n                    result = subtract(result, contribution);\n            }\n\n            out.println(result);\n        }\n\n        private void precompute(int limit) {\n            fact = new long[limit];\n            invFact = new long[limit];\n            fact[0] = 1;\n            for (int i = 1; i < limit; i++) fact[i] = (fact[i - 1] * i) % MOD;\n            invFact[limit - 1] = modPow(fact[limit - 1], MOD - 2);\n            for (int i = limit - 2; i >= 0; i--) invFact[i] = (invFact[i + 1] * (i + 1)) % MOD;\n        }\n\n        private long binomial(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n        }\n\n        private long modInverse(int x) {\n            return modPow(x, MOD - 2);\n        }\n\n        private long modPow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = (res * base) % MOD;\n                base = (base * base) % MOD;\n                exp >>= 1;\n            }\n            return res;\n        }\n\n        private long add(long a, long b) {\n            a += b;\n            return a >= MOD ? a - MOD : a;\n        }\n\n        private long subtract(long a, long b) {\n            a -= b;\n            return a < 0 ? a + MOD : a;\n        }\n\n        private long multiply(long a, long b) {\n            return (a * b) % MOD;\n        }\n\n        private long[] fact, invFact;\n    }\n\n    static class InputScanner {\n        BufferedReader br;\n        StringTokenizer st;\n\n        InputScanner(InputStream is) {\n            br = new BufferedR