OD.add(BigInteger.ONE));\n            BigInteger result = numerator.divide(BigInteger.valueOf(2)).mod(MOD);\n            System.out.println(result);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <cmath>\nusing namespace std;\n\nlong long modPow(long long base, long long exp, long long mod) {\n    long long result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) {\n            result = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    long long n, m, L, R;\n    cin >> n >> m >> L >> R;\n    \n    long long MOD = 998244353;\n    long long k = R - L + 1;\n    \n    if ((n * m) & 1) {\n        long long base = k % MOD;\n        long long exp = n * m;\n        cout << modPow(base, exp, MOD) << endl;\n    } else {\n        long long evens = (R >> 1) - ((L - 1) >> 1);\n        long long odds = k - evens;\n        \n        long long E = evens % MOD;\n        long long O = odds % MOD;\n        \n        long long sum = (E + O) % MOD;\n        long long diff = ((E - O) % MOD + MOD) % MOD;\n        \n        long long term1 = modPow(sum, n * m, MOD);\n        long long term2 = modPow(diff, n * m, MOD);\n        \n        long long numerator = ((term1 + term2) % MOD * (MOD + 1)) % MOD;\n        long long result = (numerator * modPow(2, MOD - 2, MOD)) % MOD;\n        \n        cout << result << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019202772818971425, -2.7418097943154862e-06, -4.768370445162873e-07, -4.136476854910143e-05, -2.3841855067985307e-07, -1.3112935448589269e-05, -8.344646857949556e-07, -0.005236006807535887, -2.3841855067985307e-07, -0.05879739671945572, -0.008615112863481045, -0.3869592547416687, -2.837140891642775