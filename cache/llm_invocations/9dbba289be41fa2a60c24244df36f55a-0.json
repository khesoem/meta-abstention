{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef bitset<128> u99;\n\nconstexpr const int mod = 1000000007;\nconstexpr const int inv = 570000004;\nconstexpr int add(int a, int b) { return a + b < mod ? a + b : a + b - mod; }\nconstexpr int sub(int a, int b) { return a < b ? a - b + mod : a - b; }\nconstexpr int mul(int a, int b) { return 1LL * a * b % mod; }\n\nunordered_map<u99, int> name;\nint n, dfn, son[65536][128];\nint dfs(u99 s) {\n    auto ite = name.find(s);\n    if (ite != name.end()) return ite->second;\n    int ret = dfn++;\n    name[s] = ret;\n    for (int i = 0; i != (1 << n); ++i) {\n        u99 t = s;\n        for (int j = 0; j != (1 << n); ++j) if (!t[j])\n            for (int k = i & j; k; k ^= k & -k) if (s[j ^ k & -k]) {\n                t[j] = 1;\n                break;\n            }\n        son[ret][i] = dfs(t);\n    }\n    return ret;\n}\n\nint p[7][7], q[7][1<<7], dp[8][1<<14]; // use max sizes\n\nint main() {\n    cin >> n;\n    dfs(1);\n    int m = 1 << n;\n    for (int i = 0; i != n; ++i) for (int j = 0; j != n; ++j) cin >> p[i][j], p[i][j] = mul(p[i][j], inv);\n    for (int i = 0; i != n; ++i) for (int j = 0; j != m; ++j) {\n        q[i][j] = 1;\n        for (int k = 0; k != n; ++k) q[i][j] = mul(q[i][j], j >> k & 1 ? p[k][i] : sub(1, p[k][i]));\n    }\n    memset(dp, 0, sizeof(dp));\n    dp[0][0] = 1;\n    for (int i = 0; i != n; ++i) {\n        for (int j = 0; j != dfn; ++j) {\n            int cur = dp[i][j];\n            if (!cur) continue;\n            for (int k = 0; k != m; ++k) {\n                int nxt = son[j][k];\n                dp[i+1][nxt] = add(dp[i+1][nxt], mul(cur, q[i][k]));\n            }\n        }\n    }\n    u99 res;\n    for (int i = 0; i != m; ++i) res[i] = 1;\n    cout << dp[n][name[res]] << endl;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\nINV = 570000004\n\ndef add(a, b):\n    return (a + b) % MOD\n\ndef sub(a, b):\n    return (a - b) % MOD\n\ndef mul(a, b):\n    return (a * b) % MOD\n\n# Global variables\nname = {}  # maps bitset (int) to index\ndfn = 0\nson = []  # list of lists, each inner list of length m\nn = 0\n\ndef dfs(s):\n    global dfn, son\n    if s in name:\n        return name[s]\n    ret = dfn\n    dfn += 1\n    name[s] = ret\n    m = 1 << n\n    # Initialize son[ret] as list of length m, filled with -1 initially\n    son.append([-1] * m)\n    for i in range(m):\n        t = s\n        for j in range(m):\n            if not (t >> j) & 1:  # if bit j not set in t\n                # iterate over bits of (i & j)\n                k = i & j\n                while k:\n                    lsb = k & -k\n                    if (s >> (j ^ lsb)) & 1:\n                        t |= (1 << j)\n                        break\n                    k ^= lsb\n        son[ret][i] = dfs(t)\n    return ret\n\ndef main():\n    global n, dfn, son, name\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = 1 << n\n    # Initialize global structures\n    name.clear()\n    dfn = 0\n    son.clear()\n    # Start dfs with s = 1 (bit 0 set)\n    dfs(1)\n    # Read p matrix\n    p = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            p[i][j] = mul(int(next(it)), INV)\n    # Compute q\n    q = [[0]*m for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            prod = 1\n            for k in range(n):\n                if (j >> k) & 1:\n                    prod = mul(prod, p[k][i])\n                else:\n                    prod = mul(prod, sub(1, p[k][i]))\n            q[i][j] = prod\n    # DP\n    dp = [[0]*dfn for _ in range(n+1)]\n    dp[0][0] = 1\n    for i in range(n):\n        for j in range(dfn):\n            cur = dp[i][j]\n            if cur == 0:\n                continue\n            for k in range(m):\n                nxt = son[j][k]\n                dp[i+1][nxt] = add(dp[i+1][nxt], mul(cur, q[i][k]))\n    # Final state: all bits set\n    res = (1 << m) - 1  # bits 0..m-1 set\n    print(dp[n][name[res]])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.924526340095326e-05, 0.0, 0.0, -0.0002619877050165087, -0.06667791306972504, -1.311301275563892e-06, -0.47409212589263916, -0.48046648502349854, -5.960462772236497e-07, -1.1920928244535389e-07, -1.7523612768854946e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.986990567587782e-06, 0.0, -9.417489309271332e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.004431072156876326, -0.0019162403186783195, -0.0004694551753345877, -7.974783511599526e-05, -0.0001714082609396428, 0.0, -0.03804221749305725, -1.311301275563892e-06, -0.3013315200805664, -0.3132692277431488, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.006715822499245405, -1.1920928244535389e-07, -0.006292175501585007, -6.55648955216747