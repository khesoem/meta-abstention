k/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int T = 1;\n        for (int t = 0; t < T; t++) {\n            solve(sc);\n        }\n        sc.close();\n    }\n\n    static void solve(Scanner sc) {\n        if (!sc.hasNext()) return;\n        int P = sc.nextInt();\n        int K = sc.nextInt();\n\n        if (K == 0) {\n            System.out.println(powMod(P, P - 1, MOD));\n            return;\n        }\n\n        int[] mapping = new int[P];\n        for (int x = 0; x < P; x++) {\n            mapping[x] = (int)(((long)K * x) % P);\n        }\n\n        int[] visited = new int[P];\n        int[] cycleCount = new int[P]; // index = cycle length, value = count\n\n        for (int start = 0; start < P; start++) {\n            if (visited[start] != 0) continue;\n            int length = 1;\n            int cur = start;\n            visited[cur] = 1;\n            while (visited[mapping[cur]] == 0) {\n                cur = mapping[cur];\n                visited[cur] = 1;\n                length++;\n            }\n            cycleCount[length]++;\n        }\n\n        long answer = 1L;\n        for (int size = 1; size < P; size++) {\n            int cnt = cycleCount[size];\n            if (cnt == 0) continue;\n            long multiplier = (long)size * cnt;\n            if (size > 1) {\n                multiplier += cycleCount[1];\n            }\n            answer = (answer * powMod(multiplier, cnt, MOD)) % MOD;\n        }\n\n        System.out.println(answer);\n    }\n\n    static long powMod(long base, long exp, long mod) {\n        long result = 1L;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n       