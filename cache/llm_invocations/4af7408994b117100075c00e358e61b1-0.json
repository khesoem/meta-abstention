:\n        # Round to avoid floating point precision issues in hashing\n        return hash((round(self.x / self.eps), round(self.y / self.eps)))\n\n    def __lt__(self, other):\n        if abs(self.x - other.x) > self.eps:\n            return self.x < other.x\n        if abs(self.y - other.y) > self.eps:\n            return self.y < other.y\n        return False\n\n\nclass Circle:\n    eps = 1e-8\n\n    def __init__(self, x, y, r):\n        self.o = Point(x, y)\n        self.r = r\n\n    def contains(self, p):\n        dist = p.sub(self.o).length()\n        return abs(dist - self.r) < self.eps\n\n    def intersect(self, other):\n        dx = self.o.x - other.o.x\n        dy = self.o.y - other.o.y\n        d = math.sqrt(dx * dx + dy * dy)\n        if d < self.eps:\n            return None\n        cos = (self.r * self.r + d * d - other.r * other.r) / (2 * self.r * d)\n        if cos < -1 - self.eps:\n            return None\n        if cos < -1:\n            cos = -1\n        if cos > 1 + self.eps:\n            return None\n        if cos > 1:\n            cos = 1\n        res = []\n        alpha = math.acos(cos)\n        dir_vec = other.o.sub(self.o).norm()\n        res.append(self.o.add(dir_vec.scale(self.r).rotate(alpha)))\n        res.append(self.o.add(dir_vec.scale(self.r).rotate(-alpha)))\n        return res\n\n\ndef dfs(i, was, adj):\n    was[i] = True\n    for j in adj[i]:\n        if not was[j]:\n            dfs(j, was, adj)\n\n\ndef get_id(p, point_id, adj):\n    if p not in point_id:\n        sz = len(point_id)\n        point_id[p] = sz\n        adj.append([])\n\n\ndef main():\n    input_data = sys.stdin.read().strip().split('\\n')\n    if not input_data:\n        return\n    \n    n = int(input_data[0].strip())\n    circles = []\n    for i in range(n):\n        parts = input_data[1 + i].split()\n        circles.append(Circle(int(parts[0]), int(parts[1]), int(parts[2])))\n\n    all_points = set()\n    for i in range(n):\n        for j in range(i + 1, n):\n            inter = circles[i].intersect(circles[j])\n            if inter is not None:\n                for p in inter:\n                    all_points.add(p)\n\n    point_id = {}\n    adj = []\n    for i in range(n):\n        angles = []\n        for k in range(3):\n            angles.append(math.pi * 2 * k / 3.0)\n        for p in all_points:\n            if circles[i].contains(p):\n                dx = p.x - circles[i].o.x\n                dy = p.y - circles[i].o.y\n                alpha = math.atan2(dy, dx)\n                if alpha < 0:\n                    alpha += 2 * math.pi\n                angles.append(alpha)\n        \n        # Sort and remove duplicates using set\n        unique_angles = sorted(set(angles))\n        \n        dir_vec = Point(circles[i].r, 0)\n        for j in range(len(unique_angles)):\n            p = circles[i].o.add(dir_vec.rotate(unique_angles[j]))\n            get_id(p, point_id, adj)\n        \n        for j in range(len(unique_angles)):\n            p = circles[i].o.add(dir_vec.rotate(unique_angles[j]))\n            q = circles[i].o.add(dir_vec.rotate(unique_angles[(j + 1) % len(unique_angles)]))\n            u = point_id[p]\n            v = point_id[q]\n            if u != v:\n                adj[u].append(v)\n                adj[v].append(u)\n\n    v = len(adj)\n    e = sum(len(lst) for lst in adj) // 2\n\n    comps = 0\n    was = [False] * v\n    for i in range(v):\n        if not was[i]:\n            comps += 1\n            dfs(i, was, adj)\n\n    result = 1 + comps + e - v\n    print(result)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.2689116273541003e-05, -1.1920922133867862e-06, -3.576278118089249e-07, -0.00014673586701974273, -0.36476245522499084, -1.6689286894688848e-06, -0.0297533106058836, -0.0007350126979872584, -0.0002975021197926253, -0.31326478719711304, -0.004574548453092575, -3.576278118089249e-07, -0.0007987407734617591, -0.27394