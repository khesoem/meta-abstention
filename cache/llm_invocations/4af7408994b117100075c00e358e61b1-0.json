w TreeMap<>();\n            List<List<Integer>> adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                List<Double> angles = new ArrayList<>();\n                for (int k = 0; k < 3; k++) angles.add(Math.PI * 2 * k / 3.0);\n                for (Point p : all) {\n                    if (circles[i].contains(p)) {\n                        double dx = p.x - circles[i].o.x;\n                        double dy = p.y - circles[i].o.y;\n                        double alpha = Math.atan2(dy, dx);\n                        if (alpha < 0) alpha += 2 * Math.PI;\n                        angles.add(alpha);\n                    }\n                }\n                Collections.sort(angles);\n                Point dir = new Point(circles[i].r, 0);\n                Double[] as = new TreeSet<>(angles).toArray(new Double[0]);\n                for (int j = 0; j < as.length; j++) {\n                    Point p = circles[i].o.add(dir.rotate(as[j]));\n                    getId(p, pointId, adj);\n                }\n                for (int j = 0; j < as.length; j++) {\n                    Point p = circles[i].o.add(dir.rotate(as[j]));\n                    Point q = circles[i].o.add(dir.rotate(as[(j + 1) % as.length]));\n                    int u = pointId.get(p);\n                    int v = pointId.get(q);\n                    if (u != v) {\n                        adj.get(u).add(v);\n                        adj.get(v).add(u);\n                    }\n                }\n            }\n\n            int v = adj.size();\n            int e = 0;\n            for (List<Integer> list : adj) e += list.size();\n            e /= 2;\n\n            int comps = 0;\n            boolean[] was = new boolean[v];\n            for (int i = 0; i < v; i++) {\n                if (!was[i]) {\n                    ++comps;\n                    dfs(i, was, adj);\n                }\n            }\n\n            pw.println(1 + comps + e - v);\n        } catch (Exception e) {\n            