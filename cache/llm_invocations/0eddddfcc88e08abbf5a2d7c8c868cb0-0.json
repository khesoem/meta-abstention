n        self.edge_tried = [0] * V\n        self.st = s\n        self.ed = t\n\n    def setEdge(self, u, v, fl):\n        self.adj[u].append((v, fl, len(self.adj[v])))\n        self.adj[v].append((u, 0, len(self.adj[u]) - 1))\n\n    def assign_level(self):\n        self.lev = [-1] * len(self.adj)\n        self.lev[self.st] = 0\n        que = deque([self.st])\n        while que:\n            now = que.popleft()\n            for i in range(len(self.adj[now])):\n                nxt = self.adj[now][i][0]\n                if self.lev[nxt] == -1 and self.adj[now][i][1] != 0:\n                    self.lev[nxt] = self.lev[now] + 1\n                    que.append(nxt)\n        return self.lev[self.ed] != -1\n\n    def dfs(self, now, fl):\n        if now == self.ed:\n            return fl\n        for i in range(self.edge_tried[now], len(self.adj[now])):\n            nxt = self.adj[now][i][0]\n            if self.lev[nxt] == self.lev[now] + 1 and self.adj[now][i][1] != 0:\n                nxtflow = self.dfs(nxt, min(fl, self.adj[now][i][1]))\n                if nxtflow:\n                    self.adj[now][i][1] -= nxtflow\n                    self.adj[nxt][self.adj[now][i][2]][1] += nxtflow\n                    return nxtflow\n        return 0\n\n    def dinic(self):\n        ret = 0\n        while self.assign_level():\n            self.edge_tried = [0] * len(self.adj)\n            while 1:\n                amt = self.dfs(self.st, 2e9)\n                if amt == 0:\n                    break\n                ret += amt\n        return ret\n\ndef go(n, ti, str, es):\n    ck = [[0] * n for _ in range(n)]\n    que = deque([(yy, xx)])\n    ck[yy][xx] = 1\n    lev = 1\n    while que:\n        sz = len(que)\n        for _ in range(sz):\n            now = que.popleft()\n            for i in range(4):\n                ny = now[0] + dy[i]\n                nx = now[1] + dx[i]\n                if (0 <= ny < n and 0 <= nx < n) and ck[ny][nx] == 0 and str[ny][nx] != 'Y':\n                    ck[ny][nx] = lev\n                    que.append((ny, nx))\n        lev = min(lev, ti)\n        lev += 1\n    return ck\n\ndef main():\n    n, ti = map(int, input().split())\n    str = [input() for _ in range(n)]\n    es = [input() for _ in range(n)]\n    str.append(input())\n    str.append(input())\n    dy = [1, -1, 0, 0]\n    dx = [0, 0, 1, -1]\n    for i in range(n):\n        for j in range(n):\n            if str[i][j] == 'Z':\n                yy, xx = i, j\n    ck = go(n, ti, str, es)\n    table = [[[0] * 65 for _ in range(n)] for _ in range(n)]\n    nodecnt = 0\n    for i in range(n):\n        for j in range(n):\n            if '0' <= str[i][j] <= '9':\n                if ck[i][j] == 0:\n                    ck[i][j] = ti\n                for t in range(ck[i][j]):\n                    table[i][j][t] = nodecnt + 1\n                    nodecnt += 1\n            if '1' <= es[i][j] <= '9':\n                table[i][j][ck[i][j]] = nodecnt + 1\n                nodecnt += 1\n    INF = 1e9\n    st = 0\n    ed = nodecnt + 3\n    net = networkflow(nodecnt + 5, st, ed)\n    for i in range(n):\n        for j in range(n):\n            if '1' <= str[i][j] <= '9':\n                net.setEdge(st, table[i][j][0], ord(str[i][j]) - ord('0'))\n            for ite in range(4):\n                ny, nx = i + dy[ite], j + dx[ite]\n                if (0 <= ny < n and 0 <= nx < n) and str[ny][nx] != 'Y' and str[ny][nx] != 'Z':\n                    for t in range(65):\n                        if table[i][j][t] != 0:\n                            if t == ck[i][j] and '1' <= es[i][j] <= '9':\n                                break\n                            if table[ny][nx][t + 1]:\n                                net.setEdge(table[i][j][t], table[ny][nx][t + 1], INF)\n            if '1' <= es[i][j] <= '9':\n                for t in range(ck[i][j]):\n                    net.setEdge(table[i][j][t], table[i][j][t + 1], INF)\n                net.setEdge(table[i][j][ck[i][j]], ed, ord(es[i