xp(base2, total);\n\n            long sum = (term1 + term2) % MOD;\n            long inv2 = modExp(2, MOD - 2);\n            long ans = (sum * inv2) % MOD;\n\n            out.println(ans);\n            out.flush();\n\n        } catch (Exception e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    private long modExp(long base, long exp) {\n        long res = 1;\n        base %= MOD;\n        if (base < 0) base += MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <sstream>\n#include <cmath>\n#include <algorithm>\n#include <climits>\n#include <iomanip>\n#include <map>\n#include <set>\n#include <queue>\n#include <stack>\nusing namespace std;\n\nconst long long MOD = 998244353LL;\n\nlong long modExp(long long base, long long exp) {\n    long long res = 1;\n    base %= MOD;\n    if (base < 0) base += MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) {\n            res = (res * base) % MOD;\n        }\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    vector<string> tokens;\n    string token;\n    while (ss >> token) {\n        tokens.push_back(token);\n    }\n    \n    long long n = stoll(tokens[0]);\n    long long m = stoll(tokens[1]);\n    long long l = stoll(tokens[2]);\n    long long r = stoll(tokens[3]);\n    \n    long long total = n * m;\n    \n    if ((total & 1) == 1LL) {\n        cout << modExp(r - l + 1, total) << endl;\n        return 0;\n    }\n    \n    long long evens = r / 2 - (l - 1) / 2;\n    long 