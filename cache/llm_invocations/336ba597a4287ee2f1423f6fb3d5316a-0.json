imit, but we use iterative DFS\n        \n        int[] adj = new int[n + 1];\n        boolean[] visited = new boolean[n + 1];\n        \n        for (int i = 0; i < n; i++) {\n            adj[i] = (i * k) % n;\n        }\n        \n        int pairs = 0;\n        \n        for (int i = 1; i < n; i++) {\n            if (!visited[i]) {\n                // Iterative DFS\n                Stack<Integer> stack = new Stack<>();\n                stack.push(i);\n                while (!stack.isEmpty()) {\n                    int cur = stack.pop();\n                    if (!visited[cur]) {\n                        visited[cur] = true;\n                        if (!visited[adj[cur]]) {\n                            stack.push(adj[cur]);\n                        }\n                    }\n                }\n                pairs++;\n            }\n        }\n        \n        long mod = 1000000007L;\n        \n        if (k == 1) {\n            System.out.println(power(n, n, mod));\n        } else {\n            System.out.println(power(n, pairs, mod));\n        }\n    }\n    \n    // Fast exponentiation with modulus\n    private static long power(long base, long exp, long mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010573305189609528, -2.50339189733495e-06, -1.1920928244535389e-07, -3.099393507000059e-05, -2.8132995794294402e-05, -0.07889603078365326, -0.03953893855214119, -4.291525328881107e-06, -1.4305104514278355e-06, -2.1576648578047752e-05, -0.003178665181621909, -6.556489552167477e-06, -0.2918623387813568, -2.3841855067985307e-07, -0.002095290692523122, -9.179073458653875e-06, -4.768370445162873e-07, -9.536738616588991e-07, -1.2516897186287679e-05, -