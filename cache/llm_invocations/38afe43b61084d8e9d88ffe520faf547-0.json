 {\n                    int lb = get_bit(ov);\n                    if (S[i ^ lb]) { ns[i] = 1; found = true; break; }\n                    ov -= lb;\n                }\n                if (!found) ns[i] = 0;\n            }\n        }\n        trans[u][mask] = build_state(ns);\n    }\n    return u;\n}\n\nint main() {\n    scanf(\"%d\", &n);\n    build_state(1);\n    \n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &A[i][j]);\n            A[i][j] = mul_mod(A[i][j], pow_mod(100, MOD - 2));\n        }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int msk = 0; msk < (1 << n); ++msk) {\n            prob[i][msk] = 1;\n            for (int k = 0; k < n; ++k) {\n                if ((msk >> k) & 1)\n                    prob[i][msk] = mul_mod(prob[i][msk], A[i][k]);\n                else\n                    prob[i][msk] = mul_mod(prob[i][msk], sub_mod(1, A[i][k]));\n            }\n        }\n    }\n    \n    DP[0][1] = 1;\n    for (int step = 1; step <= n; ++step) {\n        for (int u = 1; u <= node_count; ++u) {\n            for (int choice = 0; choice < (1 << n); ++choice) {\n                int v = trans[u][choice];\n                DP[step][v] = add_mod(DP[step][v], mul_mod(DP[step-1][u], prob[step-1][choice]));\n            }\n        }\n    }\n    \n    bitset<128> full;\n    full.flip();\n    printf(\"%d\\n\", DP[n][state_ids[full]]);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\n\ndef add_mod(x, y):\n    x += y\n    return x - MOD if x >= MOD else x\n\ndef mul_mod(x, y):\n    return (x * y) % MOD\n\ndef sub_mod(x, y):\n    x -= y\n    return x + MOD if x < 0 else x\n\ndef pow_mod(b, e):\n    res = 1\n    while e:\n        if e & 1:\n            res = mul_mod(res, b)\n        b = mul_mod(b, b)\n        e >>= 1\n    return res\n\ndef get_bit(x):\n    return x & -x\n\ndef build_state(S, n, state_ids, trans, node_count):\n    if S in state_ids:\n        return state_ids[S]\n    u = node_count + 1\n    state_ids[S] = u\n    node_count = u\n    \n    for mask in range(1 << n):\n        ns = S\n        for i in range(1 << n):\n            if not (ns & (1 << i)):\n                ov = mask & i\n                found = False\n                while ov:\n                    lb = get_bit(ov)\n                    if ns & (1 << (i ^ lb)):\n                        ns |= (1 << i)\n                        found = True\n                        break\n                    ov -= lb\n                if not found:\n                    ns &= ~(1 << i)\n        trans[u][mask] = build_state(ns, n, state_ids, trans, node_count)\n    \n    return u\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    index = 1\n    \n    A = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            A[i][j] = int(data[index])\n            index += 1\n            A[i][j] = mul_mod(A[i][j], pow_mod(100, MOD - 2))\n    \n    # Initialize data structures\n    state_ids = {}\n    trans = defaultdict(lambda: defaultdict(int))\n    node_count = 0\n    \n    # Build the state transition graph\n    initial_state = 1\n    build_state(initial_state, n, state_ids, trans, node_count)\n    \n    # Calculate probabilities\n    prob = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        for msk in range(1 << n):\n            prob[i][msk] = 1\n            for k in range(n):\n                if (msk >> k) & 1:\n                    prob[i][msk] = mul_mod(prob[i][msk], A[i][k])\n                else:\n                    prob[i][msk] = mul_mod(prob[i][msk], sub_mod(1, A[i][k]))\n    \n    # DP initialization\n    DP = [[0] * (node_count + 2) for _ in range(n + 1)]\n    DP[0][1] = 1\n    \n    # DP transitions\n    for step in range(1,