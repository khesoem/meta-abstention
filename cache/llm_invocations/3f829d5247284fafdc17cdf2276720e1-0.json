{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <utility>\nusing namespace std;\ntypedef long long ll;\n\nconst int MAXN = 250250;\nll fact[MAXN], rfact[MAXN];\nll g[MAXN][17];\nint n, k, p;\nint cnt = 0;\n\nll pw(ll a, int b, int mod) {\n    ll r = 1;\n    while (b) {\n        if (b & 1) r = r * a % mod;\n        a = a * a % mod;\n        b /= 2;\n    }\n    return r;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cout.tie(0);\n    cin >> n >> k >> p;\n    if (n & 1) {\n        cout << pw(k, n, p) << \"\\n\";\n        return 0;\n    }\n    fact[0] = 1;\n    rfact[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        fact[i] = fact[i - 1] * i % p;\n        rfact[i] = pw(fact[i], p - 2, p);\n    }\n    g[0][0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        if ((i & n) != i) continue;\n        vector<int> bit;\n        for (int j = 0; j < 18; ++j) {\n            if ((1 << j) & i) bit.push_back(j);\n        }\n        vector<pair<int, int>> st;\n        st.push_back(make_pair(1, 1 << bit[0]));\n        while (!st.empty()) {\n            pair<int, int> state = st.back();\n            st.pop_back();\n            int pos = state.first;\n            int mask = state.second;\n            if (pos == (int)bit.size()) {\n                ++cnt;\n                for (int idx = 1; idx < 17; ++idx) {\n                    g[i][idx] += rfact[mask] * g[i ^ mask][idx - 1];\n                    if (cnt >= 8) g[i][idx] %= p;\n                }\n                if (cnt >= 8) cnt = 0;\n            } else {\n                st.push_back(make_pair(pos + 1, mask ^ (1 << bit[pos])));\n                st.push_back(make_pair(pos + 1, mask));\n            }\n        }\n        for (int j = 0; j < 17; ++j) g[i][j] %= p;\n    }\n    ll ans = 0;\n    for (int i = 1; i <= min(16, k); ++i) {\n        g[n][i] %= p;\n        ll cur = fact[n] * g[n][i] % p;\n        cur = cur * fact[k] % p;\n        cur = cur * rfact[k - i] % p;\n        ans = (ans + cur) % p;\n    }\n    ans = pw(k, n, p) - ans;\n    if (ans < 0) ans += p;\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n\n    if n & 1:\n        print(pow(k, n, p))\n        return\n\n    # precompute factorials and inverse factorials\n    fact = [1] * (n + 1)\n    rfact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i - 1] * i % p\n    # Fermat's little theorem for modular inverse (p must be prime)\n    rfact[n] = pow(fact[n], p - 2, p)\n    for i in range(n, 0, -1):\n        rfact[i - 1] = rfact[i] * i % p\n\n    # g[i][j] for i from 0 to n, j from 0 to 16\n    g = [[0] * 17 for _ in range(n + 1)]\n    g[0][0] = 1\n\n    for i in range(1, n + 1):\n        if (i & n) != i:\n            continue\n        # collect bit positions where i has 1 (0..17)\n        bits = [j for j in range(18) if (i >> j) & 1]\n        if not bits:\n            continue\n        first_bit = 1 << bits[0]\n        rest_bits = bits[1:]\n        rest_len = len(rest_bits)\n        # iterate over all subsets of the rest bits\n        for sub in range(1 << rest_len):\n            mask = first_bit\n            # add bits from sub\n            for b in range(rest_len):\n                if (sub >> b) & 1:\n                    mask |= 1 << rest_bits[b]\n            # update g[i][idx] for idx = 1..16\n            for idx in range(1, 17):\n                g[i][idx] = (g[i][idx] + rfact[mask] * g[i ^ mask][idx - 1]) % p\n\n    ans = 0\n    limit = min(16, k)\n    for i in range(1, limit + 1):\n        cur = fact[n] * g[n][i] % p\n        cur = cur * fact[k] % p\n        cur = cur * rfact[k - i] % p\n        ans = (ans + cur) % p\n    ans = (pow(k, n, p) - ans) % p\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016175392374861985, -0.01124603021889925, -1.6689286894688848e-06, -1.1920928244535389e-07, 0.0, -4.911301948595792e-05, -0.0003228858404327184, 0.0, -0.0004337085410952568, -0.0003592322755139321, -0.4762333631515503, -0.1602267473936081, -7.152555099310121e-07, -0.0004003438516519964, -1.1920928244535389e-07, -0.00020394629973452538, 0.0, -0.00026174934464506805, -3.576278118089249e-07, -0.1269286721944809, -2.861018856492592e-06, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -1.3232143828645349e-05, -1.0132738680113107e-05, 0.0, -9.60780744208023e-05, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -0.01105186901986599, -0.3868792653083801, 0.0, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, -0.06199786812067032, 0.0, -1.1920928244535389e-07, -6.0437283536884934e-05, 0.0, -3.576278118089249e-07, 0.0, -2.3364747903542593e-05, -9.059865078597795e-06, 0.0, -1.5497195136049413e-06,