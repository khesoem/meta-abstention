et<Integer> bad = new HashSet<>();\n        \n        for (int i = 1; i <= n; i++) {\n            outer:\n            for (int j = 1; j <= n; j++) {\n                if (j == i) continue;\n                for (int k = 1; k <= n; k++) {\n                    if (k == i || k == j) continue;\n                    \n                    long[] v1 = new long[5];\n                    long[] v2 = new long[5];\n                    for (int d = 0; d < 5; d++) {\n                        v1[d] = data[d][j] - data[d][i];\n                        v2[d] = data[d][k] - data[d][i];\n                    }\n                    \n                    long dot = 0, m1 = 0, m2 = 0;\n                    for (int d = 0; d < 5; d++) {\n                        dot += v1[d] * v2[d];\n                        m1 += v1[d] * v1[d];\n                        m2 += v2[d] * v2[d];\n                    }\n                    \n                    if (m1 == 0 || m2 == 0) continue;\n                    \n                    double cosTheta = (double) dot / Math.sqrt(m1 * m2);\n                    double angle = Math.toDegrees(Math.acos(Math.min(1.0, Math.max(-1.0, cosTheta))));\n                    \n                    if (angle < 90.0 - 1e-9) {\n                        bad.add(i);\n                        break outer;\n                    }\n                }\n            }\n        }\n        \n        out.println(n - bad.size());\n        for (int i = 1; i <= n; i++) {\n            if (!bad.contains(i)) out.println(i);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class TaskC {\n    public void solve(int testNumber, InputReader in, PrintWriter out) {\n        int n = in.nextInt();\n        \n        int[][] data = new int[5][n + 1];\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < 5; j++) {\n     