ize() > 1) {\n        size_t last = temp.size() - 1;\n        if (temp[last] == '.') res += \"dot\";\n        else if (temp[last] == '@') res += \"at\";\n        else res += temp[last];\n    } else if (!temp.empty() && temp.size() == 1) {\n        if (temp[0] == '.') res += \"dot\";\n        else if (temp[0] == '@') res += \"at\";\n        else res += temp[0];\n    }\n    \n    cout << res << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        String s = scanner.nextLine();\n        \n        List<Character> temp = new ArrayList<>();\n        for (int i = 0; i < s.length(); i++) {\n            if (s.charAt(i) == 'd' && i + 2 < s.length() && s.charAt(i+1) == 'o' && s.charAt(i+2) == 't') {\n                temp.add('.');\n                i += 2;\n            } else if (s.charAt(i) == 'a' && i + 1 < s.length() && s.charAt(i+1) == 't') {\n                temp.add('@');\n                i += 1;\n            } else {\n                temp.add(s.charAt(i));\n            }\n        }\n        \n        StringBuilder res = new StringBuilder();\n        if (!temp.isEmpty()) {\n            if (temp.get(0) == '.') res.append(\"dot\");\n            else if (temp.get(0) == '@') res.append(\"at\");\n            else res.append(temp.get(0));\n        }\n        \n        boolean firstAt = true;\n        for (int i = 1; i < temp.size() - 1; i++) {\n            if (temp.get(i) == '@') {\n                if (firstAt) {\n                    res.append(temp.get(i));\n                    firstAt = false;\n                } else {\n                    res.append(\"at\");\n                }\n            } else {\n                res.append(temp.get(i));\n            }\n        }\n        \n        if (!temp.