e = edges[ei]\n            e.flow += min_cap\n            edges[e.rev].flow -= min_cap\n            cost += e.cost * min_cap\n            v = edges[e.rev].to\n        flow += min_cap\n    return flow, cost\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    init(MAXN)\n\n    for _ in range(k):\n        x = next(it)\n        add_edge(0, x, 1, 0)\n\n    for i in range(100):\n        for _ in range(k):\n            add_edge(1 + i * n, 9999, 1, i * c)\n\n    for _ in range(m):\n        u = next(it)\n        v = next(it)\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                cost = (2 * gg - 1) * d\n                add_edge(u + (j - 1) * n, v + j * n, 1, cost)\n                add_edge(v + (j - 1) * n, u + j * n, 1, cost)\n\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            add_edge(i + (j - 1) * n, i + j * n, k, 0)\n\n    _, cost = min_cost_maxflow(0, 9999)\n    print(cost)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.768370445162873e-07, 0.0, 0.0, -0.0010470629204064608, -0.009129328653216362, -5.960462772236497e-07, -9.262132516596466e-05, -0.00016652150952722877, -1.5497195136049413e-06, 0.0, -1.9311717551317997e-05, -0.0019895299337804317, -0.32693397998809814, -0.00048101297579705715, -4.887569048150908e-06, -3.576278118089249e-07, -0.00016532962035853416, -0.1489637792110443, -0.011766906827688217, -0.03814951330423355, -1.6689286894688848e-06, -8.368142152903602e-05, -0.00042524831951595843, -1.501931071281433, 0.0, -0.008639813400804996, -0.12765899300575256, -1.9409397840499878, -1.8358061424805783e-05, -0.387370765209198, -0.008642767556011677, -5.245195097813848e-06, -0.00022492263815365732, -1.1920928244535389e-07, -3.576278118089249e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -6.79