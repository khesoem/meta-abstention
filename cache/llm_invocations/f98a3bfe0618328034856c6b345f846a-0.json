):\n        flow = 0\n        cost = 0\n        while self.spfa(s, t):\n            Min = INF\n            i = self.pre[t]\n            while i != -1:\n                e = self.edge[i]\n                if Min > e.cap - e.flow:\n                    Min = e.cap - e.flow\n                i = self.pre[self.edge[i ^ 1].to]\n            i = self.pre[t]\n            while i != -1:\n                self.edge[i].flow += Min\n                self.edge[i ^ 1].flow -= Min\n                cost += self.edge[i].cost * Min\n                i = self.pre[self.edge[i ^ 1].to]\n            flow += Min\n        return flow, cost\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    mcmf = MinCostMaxFlow(MAXN)\n    for i in range(k):\n        x = int(next(it))\n        mcmf.add_edge(0, x, 1, 0)\n    for i in range(100):\n        for j in range(k):\n            mcmf.add_edge(1 + i * n, 9999, 1, i * c)\n    for i in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                cost_val = (2 * gg - 1) * d\n                mcmf.add_edge(u + (j - 1) * n, v + j * n, 1, cost_val)\n                mcmf.add_edge(v + (j - 1) * n, u + j * n, 1, cost_val)\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            mcmf.add_edge(i + (j - 1) * n, i + j * n, k, 0)\n    flow, cost = mcmf.min_cost_max_flow(0, 9999)\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.76836e-06, 0.0, -2.3841855e-07, -0.004288762, -0.8026259, -0.0055831685, -0.0016138636, -0.0002647288, -0.00074835424, -3.576278e-07, -9.691246e-05, -0.0026522244, -0.078732304, -0.0013703251, -1.0967195e-05, -2.145765e-06, -0.0033609353, -0.0005361788,