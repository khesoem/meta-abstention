ix][iy]=2;\n    for (int it=0; it<100; ++it) {\n        expand(1);\n        if (reach[tx][ty]==1) return true;\n        expand(2);\n        if (reach[tx][ty]==2) return false;\n    }\n    return false;\n}\n\nint dfs(int u,int sink,int f) {\n    if (u == sink) return f;\n    if (visited[u]) return 0;\n    visited[u] = true;\n    for (int v=0; v<=sink; ++v) {\n        if (cap[u][v] > 0) {\n            int got = dfs(v, sink, min(f, cap[u][v]));\n            if (got) {\n                cap[u][v] -= got;\n                cap[v][u] += got;\n                return got;\n            }\n        }\n    }\n    return 0;\n}\n\nint try_augment(int src,int sink,int f) {\n    memset(visited,0,sizeof(visited));\n    return dfs(src,sink,f);\n}\n\nint main() {\n    fill(shortest, shortest + SZ, INF);\n    cin >> n >> t;\n    int infx=0, infy=0;\n    for (int i=1; i<=n; ++i) {\n        scanf(\" %s\", sci[i]+1);\n        for (int j=1; j<=n; ++j) {\n            shortest[sidx(i,j,i,j)] = 0;\n            if (sci[i][j] == 'Z') { infx=i; infy=j; }\n        }\n    }\n    for (int i=1; i<=n; ++i) scanf(\" %s\", rec[i]+1);\n    for (int i=1; i<=n; ++i)\n        for (int j=1; j<=n; ++j)\n            for (int k=0; k<4; ++k) {\n                int ni=i+dx[k], nj=j+dy[k];\n                if (ni>0 && ni<=n && nj>0 && nj<=n && sci[i][j]!='Y' && sci[ni][nj]!='Y')\n                    shortest[sidx(i,j,ni,nj)] = 1;\n            }\n    for (int kx=1; kx<=n; ++kx)\n        for (int ky=1; ky<=n; ++ky)\n            for (int sx=1; sx<=n; ++sx)\n                for (int sy=1; sy<=n; ++sy)\n                    for (int tx=1; tx<=n; ++tx)\n                        for (int ty=1; ty<=n; ++ty) {\n                            int &d = shortest[sidx(sx,sy,tx,ty)];\n                            int via = shortest[sidx(sx,sy,kx,ky)] + shortest[sidx(kx,ky,tx,ty)];\n                            if (via < d) d = via;\n                        }\n    int src = 2*n*n+1, sink = 2*n*n+2;\n    for (int i=1; i<=n; ++i)\n       