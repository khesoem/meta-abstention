\tinline void read(Ty &x, Args &...args) {\n\t\tread(x);\n\t\tread(args...);\n\t}\n\n\ttemplate<typename Ty>\n\tinline void print(const Ty &x) {\n\t\tif (x < 0) {\n\t\t\tputchar('-');\n\t\t\tprint(-x);\n\t\t\treturn;\n\t\t}\n\t\tif (x > 9) print(x / 10);\n\t\tputchar(x % 10 | 48);\n\t}\n\n\ttemplate<>\n\tinline void print(const char &c) {\n\t\tputchar(c);\n\t}\n\n\ttemplate<>\n\tinline void print(const string &s) {\n\t\tfor (char c : s) putchar(c);\n\t}\n\n\ttemplate<typename Ty, typename...Args>\n\tinline void print(const Ty &x, const Args &...args) {\n\t\tprint(x);\n\t\tprint(args...);\n\t}\n}\nusing namespace FastIO;\n\nconst int P1 = 998244353, P2 = 1000000007, half = 1000000;\ninline int mod(LL x, int P) { return (x %= P) < 0 ? x + P : x; }\n\nconst int pow10[] = {1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000};\n\nint ans, tot1;\nLL n, tot2;\nint s[10];\nvector<int> vec[10];\n\nvoid init(int x, int v) {\n\tif (x > 6) return;\n\tvec[x].emplace_back(mod(tot1 - v, P1));\n\ts[x] += mod(tot1++ - v, P1);\n\tfor (int i = 0; i < 10; ++i) init(x + 1, v * 10 + i);\n}\n\nbool check(LL x) { return x * half + half - 1 <= n && x * half * 10 > n; }\nvoid solve(int x, LL v) {\n\tif (v > n) return;\n\tif (check(v)) {\n\t\tfor (int i = 0; i <= 6; ++i) {\n\t\t\tint t = mod(tot2 + 1 - v * pow10[i], P1);\n\t\t\tint loc = lower_bound(vec[i].begin(), vec[i].end(), P1 - t) - vec[i].begin();\n\t\t\tans = mod(ans + s[i] + 1LL * t * (int)vec[i].size() - 1LL * P1 * (vec[i].size() - loc), P2);\n\t\t}\n\t\ttot2 += tot1;\n\t} else {\n\t\tans = mod(ans + mod(++tot2 - v, P1), P2);\n\t\tfor (int i = (!x); i < 10; ++i) solve(x + 1, v * 10 + i);\n\t}\n}\n\nint main() {\n\tread(n);\n\tinit(0, 0);\n\tfor (int i = 0; i <= 6; ++i) sort(vec[i].begin(), vec[i].end());\n\ttot2 = -1; solve(0, 0);\n\tprint(ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom bisect import bisect_left\n\ndef read_int():\n    x = 0\n    f = 0\n    c = sys.stdin.read(1)\n    while c and not c.isdigit():\n        if c == '-':\n            f = 1\n        c = sys.stdin.read(1)\n    while c and c.isdigit():\n        x = (x << 1) + (x << 3) + (ord(c) & 15)\n        c = sys.stdin.read(1)\n    if f:\n        x = -x\n    return x\n\ndef read_double():\n    x = 0\n    f = 0\n    c = sys.stdin.read(1)\n    while c and not c.isdigit():\n        if c == '-':\n            f = 1\n        c = sys.stdin.read(1)\n    while c and c.isdigit():\n        x = x * 10 + (ord(c) & 15)\n        c = sys.stdin.read(1)\n    if c == '.':\n        e = 1.0\n        c = sys.stdin.read(1)\n        while c and c.isdigit():\n            e *= 0.1\n            x += (ord(c) & 15) * e\n            c = sys.stdin.read(1)\n    if f:\n        x = -x\n    return x\n\ndef read_char():\n    c = sys.stdin.read(1)\n    while c and not c.isprintable():\n        c = sys.stdin.read(1)\n    return c\n\ndef read_string():\n    s = []\n    c = sys.stdin.read(1)\n    while c and not c.isprintable():\n        c = sys.stdin.read(1)\n    while c and c.isprintable():\n        s.append(c)\n        c = sys.stdin.read(1)\n    return ''.join(s)\n\ndef read():\n    return read_int()\n\ndef print_int(x):\n    if x < 0:\n        sys.stdout.write('-')\n        print_int(-x)\n        return\n    if x > 9:\n        print_int(x // 10)\n    sys.stdout.write(chr(x % 10 + 48))\n\ndef print_char(c):\n    sys.stdout.write(c)\n\ndef print_string(s):\n    for c in s:\n        sys.stdout.write(c)\n\ndef print(*args):\n    for i, arg in enumerate(args):\n        if isinstance(arg, int):\n            print_int(arg)\n        elif isinstance(arg, str):\n            print_string(arg)\n        elif isinstance(arg, float):\n            sys.stdout.write(str(arg))\n        else:\n            sys.stdout.write(str(arg))\n        if i < len(args) - 1:\n            sys.stdout.write(' ')\n\nP1 = 998244353\nP2 = 1000000007\nhalf = 1000000\n\ndef mod(x, P):\n    x %= P\n    return x if x >= 0 else x + P\n\npow10 = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000]\n\nans = 0\ntot1 = 0\nn = 0\ntot2 = 0\ns = [0] * 10\nvec = [[] for _ in range(10)]\n\ndef init(x, v):\n    global tot1\n    if x > 6:\n        return\n    vec[x].append(mod(tot1 - v, P1))\n    s[x] += mod(tot1 - v, P1)\n    tot1 += 1\n    for i in range(10):\n        init(x + 1, v * 10 + i)\n\ndef check(x):\n    return x * half + half - 1 <= n and x * half * 10 > n\n\ndef solve(x, v):\n    global ans, tot2\n    if v > n:\n        return\n    if check(v):\n        for i in range(7):\n            t = mod(tot2 + 1 - v * pow10[i], P1)\n            loc = bisect_left(vec[i], P1 - t)\n            vec_len = len(vec[i])\n            ans = mod(ans + s[i] + t * vec_len - P1 * (vec_len - loc), P2)\n        tot2 += tot1\n    else:\n        ans = mod(ans + mod(tot2 + 1 - v, P1), P2)\n        tot2 += 1\n        start_i = 0 if x else 1\n        for i in range(start_i, 10):\n            solve(x + 1, v * 10 + i)\n\ndef main():\n    global n, ans, tot1, tot2\n    n = read_int()\n    init(0, 0)\n    for i in range(7):\n        vec[i].sort()\n    tot2 = -1\n    solve(0, 0)\n    print_int(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0002658013836480677, -7.152555099310121e-07, -1.1920928244535389e-07, -0.007673430256545544, -0.0061183772049844265, -0.6931573152542114, -0.42898356914520264, -0.00403613829985261, -9.536738616588991e-07, -1.8596476365928538e-05, -5.483612312673358e-06, -5.960462772236497e-07, -4.529942543740617e-06, -0.0003455280384514481, -0.20524851977825165, -0.05095035210251808, -0.01954861357808113, -0.00048375347978435457, -4.0531076592742465e-06, -0.2027330845594406, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -0.00037019551382400095, -4.768370445162873e-07, -0.00132