iff2 < bestDiff) {\n                bestDiff = diff2;\n                bestNum = candidate2;\n                bestDen = i;\n            }\n        }\n        \n        std::cout << bestNum << \"/\" << bestDen;\n    }\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int x = scanner.nextInt();\n        int y = scanner.nextInt();\n        int n = scanner.nextInt();\n        \n        // GCD using Euclidean algorithm with swap\n        int A = x, B = y;\n        while (B != 0) {\n            int temp = A % B;\n            A = B;\n            B = temp;\n        }\n        x /= A;\n        y /= A;\n        \n        if (n >= y) {\n            System.out.println(x + \"/\" + y);\n        } else {\n            double target = (double) x / y;\n            double bestDiff = Double.MAX_VALUE;\n            int bestNum = 0, bestDen = 1;\n            \n            for (int i = 1; i <= n; ++i) {\n                double scaled = target * i;\n                int candidate1 = (int) Math.floor(scaled);\n                int candidate2 = candidate1 + 1;\n                \n                double diff1 = Math.abs((double) candidate1 / i - target);\n                double diff2 = Math.abs((double) candidate2 / i - target);\n                \n                if (diff1 < bestDiff) {\n                    bestDiff = diff1;\n                    bestNum = candidate1;\n                    bestDen = i;\n                }\n                if (diff2 < bestDiff) {\n                    bestDiff = diff2;\n                    bestNum = candidate2;\n                    bestDen = i;\n                }\n            }\n            \n            System.out.println(bestNum + \"/\" + bestDen);\n        }\n    }\n}\n</translated_c