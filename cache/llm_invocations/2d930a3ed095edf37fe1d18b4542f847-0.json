  global dis, vis, pre\n    flow = 0\n    cost = 0\n    while spfa(s, t):\n        Min = INF\n        i = pre[t]\n        while i != -1:\n            if Min > edge[i].cap - edge[i].flow:\n                Min = edge[i].cap - edge[i].flow\n            i = pre[edge[i ^ 1].to]\n        \n        i = pre[t]\n        while i != -1:\n            edge[i].flow += Min\n            edge[i ^ 1].flow -= Min\n            cost += edge[i].cost * Min\n            i = pre[edge[i ^ 1].to]\n        \n        flow += Min\n    return flow\n\ndef main():\n    global n, m, k, c, d\n    data = sys.stdin.read().split()\n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    init(MAXN)\n    \n    for i in range(k):\n        x = int(data[idx]); idx += 1\n        addedge(0, x, 1, 0)\n    \n    for i in range(100):\n        for j in range(k):\n            addedge(1 + i * n, 9999, 1, i * c)\n    \n    for i in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d)\n                addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d)\n    \n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            addedge(i + (j - 1) * n, i + j * n, k, 0)\n    \n    cost = 0\n    minCostMaxflow(0, 9999)\n    # Calculate total cost by summing up all costs\n    total_cost = 0\n    for i in range(tol):\n        if edge[i].flow > 0:\n            total_cost += edge[i].flow * edge[i].cost\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00014137222024146467, -1.4305104514278355e-06, -7.152555099310121e-07, -0.04212687537074089, -0.0028729853220283985, -5.960462772236497e-07, -5.209310256759636