ntWriter output;\n    private static final long MOD = 1000000007;\n\n    public static void main(String[] args) {\n        try {\n            input = new BufferedReader(new InputStreamReader(System.in));\n            output = new PrintWriter(System.out);\n            execute();\n        } finally {\n            try {\n                input.close();\n            } catch (IOException e) {\n                // ignore\n            }\n            output.close();\n        }\n    }\n\n    private static long modularExponentiation(long base, long power) {\n        long result = 1;\n        while (power > 0) {\n            if ((power & 1) == 1) {\n                result = (result * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            power >>= 1;\n        }\n        return result;\n    }\n\n    private static long factorialMod(int n) {\n        long result = 1;\n        for (int i = 1; i <= n; i++) {\n            result = (result * i) % MOD;\n        }\n        return result;\n    }\n\n    private static int extractSingleNumber() throws IOException {\n        return Integer.parseInt(input.readLine().trim());\n    }\n\n    private static List<Integer> extractNumbers() throws IOException {\n        String[] parts = input.readLine().trim().split(\"\\\\s+\");\n        List<Integer> numbers = new ArrayList<>();\n        for (String part : parts) {\n            numbers.add(Integer.parseInt(part));\n        }\n        return numbers;\n    }\n\n    private static void execute() {\n        try {\n            int n = extractSingleNumber();\n            List<Integer> aList = extractNumbers();\n            List<Integer> bList = extractNumbers();\n            \n            int a1 = aList.get(0);\n            int a2 = aList.get(1);\n            int a3 = aList.get(2);\n            int b1 = bList.get(0);\n            int b2 = bList.get(1);\n            int b3 = bList.get(2);\n            \n            int upperBound = Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n            \n            int best = 0;\n            int[] perm = {1, 2, 3, 4, 5, 6};\n            \n            // Generate all permutations of [1,2,3,4,5,6]\n            List<int[]> permutations = generatePermutations(perm);\n            \n            for (int[] order : permutations) {\n                int ca1 = a1, ca2 = a2, ca3 = a3;\n                int cb1 = b1, cb2 = b2, cb3 = b3;\n                int current = 0;\n                \n                for (int step : order) {\n                    if (step == 1) {\n                        int match = Math.min(ca1, cb1);\n                        ca1 -= match;\n                        cb1 -= match;\n                        current += match;\n                    } else if (step == 2) {\n                        int match = Math.min(ca1, cb3);\n                        ca1 -= match;\n                        cb3 -= match;\n                        current += match;\n                    } else if (step == 3) {\n                        int match = Math.min(ca2, cb2);\n                        ca2 -= match;\n                        cb2 -= match;\n                        current += match;\n                    } else if (step == 4) {\n                        int match = Math.min(ca2, cb1);\n                        ca2 -= match;\n                        cb1 -= match;\n                        current += match;\n                    } else if (step == 5) {\n                        int match = Math.min(ca3, cb3);\n                        ca3 -= match;\n                        cb3 -= match;\n                        current += match;\n                    } else if (step == 6) {\n                        int match = Math.min(ca3, cb2);\n                        ca3 -= match;\n                        cb2 -= match;\n                        current += match;\n                    }\n                }\n                \n                best = Math.max(best, current);\n            }\n            \n            output.println((n - best) + \" \" + upperBound);\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n    }\n\n    private static List<int[]> generatePermutations(int[] array) {\n        List<int[]> result = new ArrayList<>();\n        permute(array, 0, result);\n        return result;\n    }\n\n    private static void permute(int[] array, int start, List<int[]> result) {\n        if (start == array.length) {\n            result.add(array.clone());\n            return;\n        }\n        for (int i = start; i < array.length; i++) {\n            swap(array, start, i);\n            permute(array, start + 1, result);\n            swap(array, start, i);\n        }\n    }\n\n    private static void swap(int[] array, int i, int j) {\n        int temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011872540198964998, -1.5497195136049413e-06, -1.0728830375228426e-06, -0.0004644507134798914, -1.3589766240329482e-05, -0.061973217874765396, -0.0036960402503609657, -4.291525328881107e-06, -8.106198947643861e-06, -0.0003692421887535602, -0.006846895441412926, -0.00011860620725201443, -2.3841855067985307e-07, -0.00010871296399272978, -0.38696953654289246, -0.0019300420535728335, -0.08438656479120255, -0.004584872163832188, -0.2298056185245514, -0.4496461749076843, -0.37710174918174744, -1.6689286894688848e-06, -2.0265558760002023e-06, -9.536697689327411e-06, -0.019301803782582283, -9.011816291604191e-05, -0.014163918793201447, -0.004083747509866953, -3.1709168979432434e-05, -2.455681169521995e-05, -0.7297921180725098, -0.38701295852661133, -2.50339189733495e-06, -1.1920928244535389e-07, -0.0007102350937202573, -1.1920928244535389e-07, -0.005233872216194868, -2.3841855067985307e-07, 0.0, -4.768360213347478e-06, 0.0, 0.0, 0.0, -5.960462772236497e-07, -9.65590606938349e-06, -0.5975117087364197, -5.960462772236497e-07, -0.2811603546142578, -1.1920922133867862e-06, -