ist[v]) continue;\n\n                for (int e = head[v]; e != -1; e = nxt[e]) {\n                    if (cap[e] <= 0) continue;\n                    int nd = d + cost[e] + pot[v] - pot[to[e]];\n                    if (nd < dist[to[e]]) {\n                        if (dist[to[e]] != INF)\n                            pq.erase({dist[to[e]], to[e]});\n                        dist[to[e]] = nd;\n                        prevv[to[e]] = v;\n                        preve[to[e]] = e;\n                        pq.insert({nd, to[e]});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            int pathCost = dist[t] + pot[t] - pot[s];\n\n            for (int v = 0; v < n; ++v)\n                if (dist[v] < INF) pot[v] += dist[v];\n\n            int add = need - flow;\n            for (int v = t; v != s; v = prevv[v])\n                add = min(add, cap[preve[v]]);\n\n            flow += add;\n            totalCost += add * pathCost;\n\n            for (int v = t; v != s; v = prevv[v]) {\n                int e = preve[v];\n                cap[e] -= add;\n                cap[e ^ 1] += add;\n            }\n        }\n\n        return {flow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin.exceptions(ios::failbit);\n\n    int N, M, K, C, D;\n    cin >> N >> M >> K >> C >> D;\n    vector<int> starts(N, 0);\n    for (int i = 0; i < K; ++i) {\n        int a;\n        cin >> a;\n        --a;\n        ++starts[a];\n    }\n\n    int maxT = K + N + 1;\n    int V = (maxT + 1) * N + 2;\n    int src = V - 2;\n    int sink = V - 1;\n\n    EdgeList graph(V);\n\n    for (int i = 0; i < N; ++i)\n        if (starts[i])\n            graph.addEdge(src, i, starts[i], 0);\n\n    for (int t = 0; t <= maxT; ++t)\n        graph.addEdge(t * N, sink, K, 0);\n\n    for (int i = 0; i < N; ++i)\n        for (int t = 0; t < maxT; ++t)\n            graph.addEdge(t * N + i, (t + 1) * N + i, K, C);\n\n  