}\n\nlong long modPow(long long base, int exp) {\n    long long result = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if (exp & 1) {\n            result = (result * base) % MOD;\n        }\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    vector<string> parts;\n    string part;\n    while (ss >> part) {\n        parts.push_back(part);\n    }\n    \n    int n = stoi(parts[0]);\n    int k = stoi(parts[1]);\n    int L = stoi(parts[2]);\n    \n    precompute(n);\n    \n    vector<long long> p(2 * n + 1, 0);\n    vector<long long> q(2 * n + 1, 0);\n    \n    p[n] = modPow(2, n);\n    \n    for (int t = 0; t < n; t++) {\n        for (int i = 2 * n; i > 0; i--) {\n            p[i] = (p[i] - p[i - 1]) % MOD;\n        }\n    }\n    \n    vector<long long> ans = p;\n    long long inv2 = (MOD + 1) / 2;\n    \n    for (int iter = 1; iter <= n - k; iter++) {\n        // Division by 2x\n        for (int i = 0; i < 2 * n; i++) {\n            q[i] = p[i + 1] * inv2 % MOD;\n        }\n        q[2 * n] = 0;\n        \n        // Division by (1 - x)\n        for (int i = 1; i <= 2 * n; i++) {\n            q[i] = (q[i] + q[i - 1]) % MOD;\n        }\n        \n        // Update p = q - p\n        for (int i = 0; i <= 2 * n; i++) {\n            p[i] = (q[i] - p[i]) % MOD;\n        }\n        \n        long long c = C[n][iter];\n        for (int i = 0; i <= 2 * n; i++) {\n            ans[i] = (ans[i] + c * p[i]) % MOD;\n        }\n    }\n    \n    long long sum = 0;\n    for (int i = 0; i <= 2 * n; i++) {\n        sum = (sum + ans[i] * modPow(i + 1, MOD - 2)) % MOD;\n    }\n    sum = (sum * L % MOD + MOD) % MOD;\n    cout << sum << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.319182623177767e-05, -2.622600959512056e-06, -3.576278118089249e-07, -0.0004127365828026086, -5.960462772236497e-07, 