{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nconst int INF = 0x7f7f7f7f;\nint N, M, S, T, P, C, D, A[505], B[505];\nint MXF, MNC;\nint E = 1, H[5000005], NX[5000005<<1], TO[5000005<<1], CAP[5000005<<1], COST[5000005<<1];\nint DIS[5000005], PRE[5000005], LA[5000005], FLOW[5000005];\nbool VIS[5000005];\n\nvoid ADD(int X, int Y, int Z, int C) {\n    NX[++E] = H[X];\n    TO[E] = Y;\n    CAP[E] = Z;\n    COST[E] = C;\n    H[X] = E;\n}\n\nbool SPFA() {\n    fill(DIS, DIS + 5000005, INF);\n    fill(VIS, VIS + 5000005, false);\n    queue<int> Q;\n    Q.push(S);\n    VIS[S] = true;\n    DIS[S] = 0;\n    FLOW[S] = INF;\n    PRE[T] = -1;\n    while (!Q.empty()) {\n        int X = Q.front(); Q.pop();\n        VIS[X] = false;\n        for (int I = H[X]; I; I = NX[I]) {\n            if (CAP[I] && DIS[TO[I]] > DIS[X] + COST[I]) {\n                DIS[TO[I]] = DIS[X] + COST[I];\n                PRE[TO[I]] = X;\n                LA[TO[I]] = I;\n                FLOW[TO[I]] = min(FLOW[X], CAP[I]);\n                if (!VIS[TO[I]]) {\n                    VIS[TO[I]] = true;\n                    Q.push(TO[I]);\n                }\n            }\n        }\n    }\n    return PRE[T] != -1;\n}\n\nvoid MCMF() {\n    MXF = MNC = 0;\n    while (SPFA()) {\n        int NOW = T;\n        MXF += FLOW[T];\n        MNC += FLOW[T] * DIS[T];\n        while (NOW != S) {\n            CAP[LA[NOW]] -= FLOW[T];\n            CAP[LA[NOW] ^ 1] += FLOW[T];\n            NOW = PRE[NOW];\n        }\n    }\n}\n\nint EN(int T, int X) {\n    return T * N + X;\n}\n\nint main() {\n    cin >> N >> M >> P >> C >> D;\n    S = 0;\n    T = N * 99 + 1;\n    for (int I = 1, X; I <= P && cin >> X; I++) {\n        ADD(S, EN(0, X), 1, 0);\n        ADD(EN(0, X), S, 0, 0);\n    }\n    for (int I = 1; I <= M; I++) cin >> A[I] >> B[I];\n    for (int I = 0; I <= 99; I++) {\n        ADD(EN(I, 1), EN(I + 1, 1), INF, 0);\n        ADD(EN(I + 1, 1), EN(I, 1), 0, 0);\n        for (int J = 2; J <= N; J++) {\n            ADD(EN(I, J), EN(I + 1, J), INF, C);\n            ADD(EN(I + 1, J), EN(I, J), 0, -C);\n        }\n        for (int J = 1; J <= M; J++) {\n            for (int K = 1; K <= P; K++) {\n                int CST = D * K * K - D * (K - 1) * (K - 1) + C;\n                ADD(EN(I, A[J]), EN(I + 1, B[J]), 1, CST);\n                ADD(EN(I + 1, B[J]), EN(I, A[J]), 0, -CST);\n                ADD(EN(I, B[J]), EN(I + 1, A[J]), 1, CST);\n                ADD(EN(I + 1, A[J]), EN(I, B[J]), 0, -CST);\n            }\n        }\n    }\n    MCMF();\n    cout << MNC << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    N = next(it)\n    M = next(it)\n    P = next(it)\n    C = next(it)\n    D = next(it)\n\n    S = 0\n    T = N * 99 + 1\n\n    # maximum node index: time 100 (I=100) and city N => 100*N + N = 101*N\n    max_node = max(T, 101 * N)\n    # adjacency list: graph[node] = list of edge indices\n    graph = [[] for _ in range(max_node + 1)]\n    edges = []  # list of [to, cap, cost, rev]\n\n    def add_edge(u: int, v: int, cap: int, cost: int) -> None:\n        # forward edge\n        graph[u].append(len(edges))\n        edges.append([v, cap, cost, len(edges) + 1])\n        # reverse edge\n        graph[v].append(len(edges))\n        edges.append([u, 0, -cost, len(edges) - 1])\n\n    INF = 10**18\n\n    # read starting positions\n    for _ in range(P):\n        X = next(it)\n        add_edge(S, 0 * N + X, 1, 0)\n\n    # read roads\n    A = [0] * (M + 1)\n    B = [0] * (M + 1)\n    for i in range(1, M + 1):\n        A[i] = next(it)\n        B[i] = next(it)\n\n    # build time-expanded graph\n    for I in range(0, 100):  # I from 0 to 99 inclusive\n        # edges for staying in city 1 (cost 0)\n        add_edge(I * N + 1, (I + 1) * N + 1, INF, 0)\n        # edges for staying in other cities (cost C)\n        for J in range(2, N + 1):\n            add_edge(I * N + J, (I + 1) * N + J, INF, C)\n        # edges for roads\n        for J in range(1, M + 1):\n            for K in range(1, P + 1):\n                CST = D * K * K - D * (K - 1) * (K - 1) + C\n                # A[J] -> B[J]\n                add_edge(I * N + A[J], (I + 1) * N + B[J], 1, CST)\n                # B[J] -> A[J]\n                add_edge(I * N + B[J], (I + 1) * N + A[J], 1, CST)\n\n    # MCMF\n    dis = [0] * (max_node + 1)\n    prev_node = [0] * (max_node + 1)\n    prev_edge = [0] * (max_node + 1)\n    flow = [0] * (max_node + 1)\n    in_queue = [False] * (max_node + 1)\n\n    def spfa() -> bool:\n        for i in range(max_node + 1):\n            dis[i] = INF\n            in_queue[i] = False\n        q = deque()\n        q.append(S)\n        in_queue[S] = True\n        dis[S] = 0\n        flow[S] = INF\n        prev_node[T] = -1\n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            for ei in graph[u]:\n                v, cap, cost, rev = edges[ei]\n                if cap > 0 and dis[v] > dis[u] + cost:\n                    dis[v] = dis[u] + cost\n                    prev_node[v] = u\n                    prev_edge[v] = ei\n                    flow[v] = min(flow[u], cap)\n                    if not in_queue[v]:\n                        in_queue[v] = True\n                        q.append(v)\n        return prev_node[T] != -1\n\n    max_flow = 0\n    min_cost = 0\n    while spfa():\n        add = flow[T]\n        max_flow += add\n        min_cost += add * dis[T]\n        v = T\n        while v != S:\n            ei = prev_edge[v]\n            edges[ei][1] -= add\n            edges[edges[ei][3]][1] += add\n            v = prev_node[v]\n\n    print(min_cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.6238969187252223e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0005814530304633081, -0.014235729351639748, 0.0, -0.0009149893885478377, -0.0009945451747626066, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.0728830375228426e-06, -0.0011859057703986764, -0.47630399465560913, -0.2215528041124344, -0.38690897822380066, -2.9802276912960224e-06, -2.169585604860913e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.00018094333063345402, -2.3841855067985307e-07, -0.12703965604305267, -8.344646857949556e-07, 0.0, 0.0, 0.0, 0.0, -4.5536911784438416e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -8.344646857949556e-07, -3.814689989667386e-06, -0.5763119459152222, -3.6954811548639555e-06, 0.0, -7.486063259420916e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -3.45700973412022e-05, -5.960462772236497e-07, -0.003985201939940453, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -2.8729025871143676e-05, -2.1457441107486375e-05, -5.090107151772827e-05, -4.6371336793527