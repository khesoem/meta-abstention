n\n    # Save ok before Z BFS\n    okb = [row[:] for row in ok]\n\n    # Read second grid\n    for i in range(1, m+1):\n        s = next(it)\n        for j in range(1, m+1):\n            ch = s[j-1]\n            if ch == 'Z' or ch == 'Y':\n                continue\n            k = ord(ch) - ord('0')\n            if k > 0:\n                n += 1\n                b[i][j] = n\n                capacity[n][m*m+1] = k\n\n    # Adjust sink if n != m*m\n    if n != m*m:\n        for i in range(1, m+1):\n            for j in range(1, m+1):\n                if b[i][j] > 0:\n                    k = b[i][j]\n                    capacity[k][n+1] = capacity[k][m*m+1]\n                    capacity[k][m*m+1] = 0\n\n    sink = n + 1\n    V = n + 2\n\n    # BFS from Z cells to compute d0\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    while q:\n        r, c, dis = q.popleft()\n        d0[r][c] = dis\n        for k in range(4):\n            nr, nc = r + dx[k], c + dy[k]\n            if 1 <= nr <= m and 1 <= nc <= m and ok[nr][nc]:\n                q.append((nr, nc, dis+1))\n                ok[nr][nc] = False\n\n    # For each a cell, BFS to set capacities\n    for i in range(1, m+1):\n        for j in range(1, m+1):\n            if a[i][j] == 0:\n                continue\n            # Restore ok from okb\n            ok = [row[:] for row in okb]\n            ok[i][j] = False\n            q2 = deque()\n            q2.append((i, j, 0))\n            while q2:\n                x, y, dis = q2.popleft()\n                if b[x][y] > 0 and dis <= d0[x][y]:\n                    capacity[a[i][j]][b[x][y]] = n1\n                if dis + 1 > lim or dis >= d0[x][y]:\n                    continue\n                for k in range(4):\n                    nx, ny = x + dx[k], y + dy[k]\n                    if 1 <= nx <= m and 1 <= ny <= m and ok[nx][ny]:\n                        q2.append((nx, ny, dis+1))\n                        ok[nx][ny] = False\n\n    # Push-relabel max flow\n    pushCap = [row[:] for row in capacity]\n    pushHeight = [0]*V\n    pushExcess = [0]*V\n    pushActive = [False]*V\n\n    pushHeight[0] = V\n    act = deque()\n\n    for v in range(V):\n        if pushCap[0][v] > 0:\n            pushExcess[v] = pushCap[0][v]\n            pushCap[0][v] = 0\n            pushCap[v][0] += pushExcess[v]\n            pushExcess[0] -= pushExcess[v]\n            if v != 0 and v != sink and not pushActive[v]:\n                pushActive[v] = True\n                act.append(v)\n\n    while act:\n        u = act.popleft()\n        pushActive[u] = False\n        while pushExcess[u] > 0:\n            pushed = False\n            for v in range(V):\n                if pushCap[u][v] > 0 and pushHeight[u] == pushHeight[v] + 1:\n                    d = min(pushExcess[u], pushCap[u][v])\n                    pushCap[u][v] -= d\n                    pushCap[v][u] += d\n                    pushExcess[u] -= d\n                    pushExcess[v] += d\n                    if v != 0 and v != sink and not pushActive[v]:\n                        pushActive[v] = True\n                        act.append(v)\n                    pushed = True\n                    if pushExcess[u] == 0:\n                        break\n            if not pushed:\n                minh = 10**9\n                for v in range(V):\n                    if pushCap[u][v] > 0:\n                        minh = min(minh, pushHeight[v])\n                if minh == 10**9:\n                    minh = V\n                pushHeight[u] = minh + 1\n\n    print(pushExcess[sink])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.002314509591087699, -4.0649541915627196e-05, 0.0, 0.0, -6.389413465512916e-05, -0.0007413261337205768, 0.0, -0.00016068121476564556, -0.023246029391884804, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -0.03004845418035984, -0.00043406602344475687, -3.576278118089249e-07, -8.22540732769994e-06, -0.0128199700