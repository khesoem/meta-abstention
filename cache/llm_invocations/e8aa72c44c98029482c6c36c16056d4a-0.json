      self.snumChars = -1\n            else:\n                self.buf[:len(data)] = data\n                self.snumChars = len(data)\n                self.curChar = 0\n        except:\n            self.snumChars = -1\n\n    def read(self):\n        if self.snumChars == -1:\n            raise ValueError(\"InputMismatchException\")\n        if self.curChar >= self.snumChars:\n            self._fill_buffer()\n            if self.snumChars == -1:\n                return -1\n        self.curChar += 1\n        return self.buf[self.curChar - 1]\n\n    def _is_space_char(self, c):\n        return c in (ord(' '), ord('\\n'), ord('\\r'), ord('\\t'), -1)\n\n    def _is_end_of_line(self, c):\n        return c in (ord('\\n'), ord('\\r'), -1)\n\n    def next_int(self):\n        c = self.read()\n        while self._is_space_char(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self._is_space_char(c):\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        return res * sgn\n\n    def next_long(self):\n        c = self.read()\n        while self._is_space_char(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self._is_space_char(c):\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        return res * sgn\n\n    def next_int_array(self, n):\n        a = [0] * n\n        for i in range(n):\n            a[i] = self.next_int()\n        return a\n\n    def read_string(self):\n        c = self.read()\n        while self._is_space_char(c):\n            c = self.read()\n        res = []\n        while not self._is_space_char(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def next_line(self):\n        c = self.read()\n        while self._is_space_char(c):\n            c = self.read()\n        res = []\n        while not self._is_end_of_line(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\ndef main():\n    inp = InputReader(sys.stdin.buffer)\n    n = inp.next_int()\n    b = inp.next_int()\n    a = inp.next_int_array(n)\n\n    odd = [0] * (n + 1)\n    even = [0] * (n + 1)\n    odd[0] = 0\n    even[0] = 0\n\n    for i in range(1, n + 1):\n        if a[i - 1] % 2 == 1:\n            odd[i] = odd[i - 1] + 1\n            even[i] = even[i - 1]\n        else:\n            odd[i] = odd[i - 1]\n            even[i] = even[i - 1] + 1\n\n    prev = 0\n    cost = []\n    for i in range(1, n):\n        oc = odd[i] - odd[prev]\n        ec = even[i] - even[prev]\n        if oc == ec:\n            cost.append(abs(a[i] - a[i - 1]))\n            prev = i\n\n    cost.sort()\n    sum_val = 0\n    count = 0\n    while cost and sum_val <= b:\n        sum_val += cost[0]\n        cost.pop(0)\n        count += 1\n\n    if count == 0:\n        print(\"0\")\n    else:\n        if not cost and sum_val <= b:\n            print(count)\n        else:\n            print(count - 1)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.1457441e-05, 0.0, -2.3841855e-07, -0.00017367286, -0.0019433676, -0.0024556739, -0.31439787, -0.07924002, -0.0074357414, -2.503392e-06, -7.986991e-06, -3.3378547e-06, -1.8715684e-05, -1.9073468e-06, -2.3841855e-07, -1.1920928e-07, 0.0, -0.00055309734, -0.0019526478, -0.062293842, -2.3841855e-07, -3.576278e-07, -0.00012396998, 0.0, -2.622601e-06, -0.0009245174, -1.1920928e-07, -3.6954812e-06, -5.912606e-05, -0.0040792357, -5.245195e-06, -0.27789608, 0.0, -0.03810074, -4.148397e-05, -4.0531077e-06, -5.864925e-05, 0.0, -3.576278e-07, -0.0005491656, -1.9073468e-06, -0.57623595, -1.1920928e-07, -2.9802277e-06, -7.152555e-07, -4.7683704e-07, -1.0490363e-05, 0.0, -0.00408814, -2.0265559e-06, -1.1444026e-05, 0.0, -0.000