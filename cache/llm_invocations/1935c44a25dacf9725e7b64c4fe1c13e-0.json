rks subsets of n\n    v = [0] * (n + 1)\n    v[n] = 1\n    for i in range(n, 0, -1):\n        if v[i]:\n            j = i\n            while j:\n                v[j] = 1\n                j = (j - 1) & i\n\n    # helper functions\n    def add(a, b, fg):\n        # a and b are lists of length lg\n        if fg:\n            for i in range(lg):\n                a[i] += b[i]\n                if a[i] >= rhl:\n                    a[i] -= rhl\n        else:\n            for i in range(lg):\n                a[i] += rhl - b[i]\n                if a[i] >= rhl:\n                    a[i] -= rhl\n\n    def mul(a, b):\n        # a = a * b (truncated to degree < lg)\n        c = [0] * lg\n        for i in range(lg):\n            if a[i]:\n                ai = a[i]\n                for j in range(lg - i):\n                    c[i + j] = (c[i + j] + ai * b[j]) % rhl\n        a[:] = c\n\n    def fpm(a, b):\n        # a = a^b (polynomial exponentiation)\n        ans = [0] * lg\n        ans[0] = 1\n        while b:\n            if b & 1:\n                mul(ans, a)\n            b >>= 1\n            if b:\n                mul(a, a)\n        a[:] = ans\n\n    # forward transform (zeta over supersets)\n    i = 1\n    while i < m:\n        for j in range(n + 1):\n            if j & i:\n                add(f[j], f[j ^ i], 1)\n        i <<= 1\n\n    # exponentiate only for subsets of n\n    for i in range(n + 1):\n        if v[i]:\n            fpm(f[i], k)\n\n    # inverse transform (M\u00f6bius)\n    i = 1\n    while i < m:\n        for j in range(n + 1):\n            if j & i:\n                add(f[j], f[j ^ i], 0)\n        i <<= 1\n\n    # compute final answer\n    # qpow(k, n)\n    pow_kn = 1\n    a, b = k, n\n    while b:\n        if b & 1:\n            pow_kn = (pow_kn * a) % rhl\n        b >>= 1\n        if b:\n            a = (a * a) % rhl\n\n    term = (f[n][cnt[n]] * fac[n]) % rhl\n    ans = (pow_kn - term + rhl) % rhl\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\