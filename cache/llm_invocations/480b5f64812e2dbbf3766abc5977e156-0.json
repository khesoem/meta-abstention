 val = (counter1 - num % MOD1 + MOD1) % MOD1;\n    data[depth].push_back(val);\n    counter1++;\n    for (i64 digit = 0; digit <= 9; ++digit)\n        build_table(depth + 1, num * 10 + digit);\n}\n\nvoid traverse(i64 depth, i64 num) {\n    if (num > n) return;\n    if (is_boundary(num)) {\n        for (i64 d = 0; d <= 6; ++d) {\n            i64 need = ((counter2 + 1 - num * p10[d]) % MOD1 + MOD1) % MOD1;\n            auto it = lower_bound(data[d].begin(), data[d].end(), need);\n            i64 idx = it - data[d].begin();\n            i64 sz = data[d].size();\n            i64 sum_suffix = 0;\n            for (i64 j = idx; j < sz; ++j) sum_suffix = (sum_suffix + data[d][j]) % MOD2;\n            total_ans = (total_ans + sum_suffix + need * (sz - idx) % MOD2) % MOD2;\n        }\n        counter2 += counter1;\n    } else {\n        counter2++;\n        total_ans = (total_ans + ((counter2 - num) % MOD1 + MOD1) % MOD2) % MOD2;\n        for (i64 digit = (depth == 0); digit <= 9; ++digit)\n            traverse(depth + 1, num * 10 + digit);\n    }\n}\n\nint main() {\n    n = scan();\n    build_table(0, 0);\n    for (int i = 0; i <= 6; ++i) sort(data[i].begin(), data[i].end());\n    counter2 = -1;\n    traverse(0, 0);\n    println((total_ans % MOD2 + MOD2) % MOD2);\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nsys.setrecursionlimit(1000000)\n\nMOD1 = 998244353\nMOD2 = 1000000007\n\nn = 0\ntotal_ans = 0\ncounter1 = 0\ncounter2 = 0\np10 = [1, 10, 100, 1000, 10000, 100000, 1000000]\ndata = [[] for _ in range(7)]\n\ndef fetch():\n    if not hasattr(fetch, 'buf'):\n        fetch.buf = sys.stdin.buffer.read()\n        fetch.pos = 0\n    if fetch.pos >= len(fetch.buf):\n        return -1\n    c = fetch.buf[fetch.pos]\n    fetch.pos += 1\n    return c\n\ndef scan():\n    x = 0\n    c = fetch()\n    while c < ord('0') or c > ord('9'):\n        if c == ord('-'):\n            x = -1\n        c = fetch()\n        if c == -1:\n            return 0\n    if x == -1:\n        x = 0\n    else:\n        while c >= ord('0') and c <= ord('9'):\n            x = x * 10 + (c - ord('0'))\n            c = fetch()\n            if c == -1:\n                break\n    return x\n\ndef print_int(x):\n    if x < 0:\n        sys.stdout.write('-')\n        print_int(-x)\n        return\n    if x > 9:\n        print_int(x // 10)\n    sys.stdout.write(chr(x % 10 + ord('0')))\n\ndef println(x):\n    print_int(x)\n    sys.stdout.write('\\n')\n\ndef is_boundary(x):\n    return x * 1000000 + 999999 <= n and x * 10000000 > n\n\ndef build_table(depth, num):\n    global counter1\n    if depth == 7:\n        return\n    val = (counter1 - num % MOD1 + MOD1) % MOD1\n    data[depth].append(val)\n    counter1 += 1\n    for digit in range(10):\n        build_table(depth + 1, num * 10 + digit)\n\ndef traverse(depth, num):\n    global counter2, total_ans\n    if num > n:\n        return\n    if is_boundary(num):\n        for d in range(7):\n            need = ((counter2 + 1 - num * p10[d]) % MOD1 + MOD1) % MOD1\n            idx = bisect.bisect_left(data[d], need)\n            sz = len(data[d])\n            sum_suffix = 0\n            for j in range(idx, sz):\n                sum_suffix = (sum_suffix + data[d][j]) % MOD2\n            total_ans = (total_ans + sum_suffix + need * (sz - idx) % MOD2) % MOD2\n        counter2 += counter1\n    else:\n        counter2 += 1\n        val = ((counter2 - num) % MOD1 + MOD1) % MOD2\n        total_ans = (total_ans + val) % MOD2\n        start_digit = 0 if depth == 0 else 0\n        for digit in range(start_digit, 10):\n            traverse(depth + 1, num * 10 + digit)\n\ndef main():\n    global n, total_ans, counter1, counter2\n    n = scan()\n    build_table(0, 0)\n    for i in range(7):\n        data[i].sort()\n    counter2 = -1\n    traverse(0, 0)\n    println((total_ans % MOD2 + MOD2) % MOD2)\n\nif _