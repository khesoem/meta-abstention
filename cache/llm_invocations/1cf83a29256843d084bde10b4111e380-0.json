        ans = mul(ans, shift[k-1])\n        ans = mul(ans, a[i])\n    ans = mul(ans, shift[k-1])\n    ans = mul(ans, tmp)\n    ans = mul(ans, shift[x-1])\n    return ans\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    maxb = 60\n    val = [0]*maxb\n    val[0] = 1\n    last = maxb\n    for i in range(1, maxb):\n        if val[i-1] >= INF // k:\n            val[i] = INF\n            last = i\n            break\n        val[i] = val[i-1] * k\n    shift = [None]*maxb\n    shift[0] = Mat(k+1, 1)\n    shift[1] = Mat(k+1, 0)\n    for i in range(k):\n        shift[1][i][(i-1+k) % k] = 1\n    shift[1][k][k] = 1\n    for i in range(2, k):\n        shift[i] = mul(shift[i-1], shift[1])\n    a = [None]*maxb\n    for i in range(maxb):\n        a[i] = Mat(k+1, 1)\n    for i in range(k+1):\n        a[0][i][0] = 1\n    for i in range(1, last):\n        tmp = a[i-1]\n        a[i] = a[i-1]\n        for j in range(1, k):\n            a[i] = mul(a[i], shift[k-1])\n            a[i] = mul(a[i], tmp)\n        a[i] = mul(a[i], shift[k-1])\n    ans = Mat(k+1, 0)\n    ans[0][k] = 1\n    ans = mul(ans, get(n, last-1, k, a, shift, val))\n    res = 0\n    for i in range(k+1):\n        res = (res + ans[0][i]) % MOD\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.34461570775602e-06, 0.0, 0.0, -0.0003002431185450405, -0.4021037220954895, -5.722029527532868e-06, -0.06198453530669212, -0.062054336071014404, -2.3841855067985307e-07, -0.00043108707177452743, -0.16035978496074677, -0.023247892037034035, 0.0, -0.00026127262390218675, -2.3841855067985307e-07, 0.0, -0.07889525592327118, -0.018895739689469337, -5.638440416078083e-05, -9.023735765367746e-05, -0.10022858530282974, -0.009717540815472603, -3.5523738915799186e-05, -1.1920928244535389e-07, -4.768360213347478e-06, -4.410734163684538e-06, -0.20707786083221436, -0.00