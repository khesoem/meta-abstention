t - 1];\n    for (int digit = 1; digit <= 9; digit++) {\n        long long transformed = sumOfPowers * digit;\n        if (digit == firstDigitValue || digit == firstDigitValue - 1) {\n            minSteps = std::min(minSteps, digit * digitCount + computeMinSteps(std::abs(transformed - n)));\n        }\n    }\n    return minSteps;\n}\n\nint main() {\n    initializePowers();\n    std::string line;\n    std::getline(std::cin, line);\n    line.erase(0, line.find_first_not_of(\" \\t\\n\\r\"));\n    line.erase(line.find_last_not_of(\" \\t\\n\\r\") + 1);\n    long long value = std::stoll(line);\n    std::cout << computeMinSteps(value) << std::endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019643761334009469, -2.50339189733495e-06, -2.3841855067985307e-07, -0.0005824061809107661, -3.576278118089249e-07, -6.437280717364047e-06, -7.152555099310121e-07, -1.311301275563892e-06, -2.3841855067985307e-07, -0.0029475123155862093, -1.9073468138230965e-06, -2.50339189733495e-06, -5.006777428206988e-06, -0.4737361967563629, -9.536738616588991e-07, -3.814689989667386e-06, -1.5497195136049413e-06, -0.33375686407089233, -5.924526340095326e-05, -5.8412379075889476e-06, -1.490105023549404e-05, -1.9073468138230965e-06, -0.07387520372867584, -0.0031784274615347385, -0.004079235717654228, -5.960462772236497e-07, -0.00023362292267847806, -0.01604185625910759, -0.6191295385360718, -0.3005226254463196, 0.0, -3.886147169396281e-05, -4.6491513785440475e-06, -0.0005017452058382332, -3.576278118089249e-07, -0.0019227842567488551, -0.08163122087717056, 0.0, -4.768370445162873e-07, -0.11283928155899048, -0.27916380763053894, -0.01007943693548441, -0.47432243824005127, -0.004098112694919109, -1.1920928244535389e-07, -5.960462772236497e-07, -4.768370445162873e-07, -2.7418097943154862e-06, -0.008774887770414352, -2.0265558760002023e-06, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.0073022604919970036, -1.1920922133867862e-06, -2.384185506798530