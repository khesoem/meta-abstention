] + 1\n                    q.append(w)\n    return ds[0] != 3010\n\ndef dfs(x):\n    if x == 0:\n        return True\n    for v in e[x]:\n        u = pa[v]\n        if ds[u] == ds[x] + 1 and dfs(u):\n            pa[x] = v\n            pa[v] = x\n            return True\n    return False\n\ndef hkp():\n    an = 0\n    while bfs():\n        for i in range(1, sp):\n            if pa[i] == 0:\n                an += dfs(i)\n    return an\n\ndef wk(a, b):\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            dd[i][j] = 100000\n    q = deque()\n    dd[a][b] = 0\n    q.append((a, b))\n    while q:\n        x, y = q.popleft()\n        # Add edges from all source nodes at (a,b) to all sink nodes at (x,y)\n        for sink in np[x][y]:\n            for src in ns[a][b]:\n                ade(src, sink)\n        if dd[x][y] == ir[x][y]:\n            continue\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if sc[nx][ny] != -1 and dd[nx][ny] > dd[x][y] + 1 and dd[x][y] + 1 <= ir[nx][ny]:\n                dd[nx][ny] = dd[x][y] + 1\n                q.append((nx, ny))\n\ndef main():\n    global sp, pp, n, t\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    n = int(first[0])\n    t = int(first[1])\n    # Initialize ir with t\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            ir[i][j] = t\n    # Read s lines\n    for i in range(1, n+1):\n        s[i] = data[i].strip()\n    # Read p lines\n    for i in range(1, n+1):\n        p[i] = data[n + i].strip()\n    rx = ry = 0\n    # Process s grid\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            ch = s[i][j-1]\n            if ch == 'Z' or ch == 'Y':\n                sc[i][j] = -1\n                ir[i][j] = 0\n                if ch == 'Z':\n                    rx, ry = i, j\n            elif '0' <= ch <= '9':\n                sc[i][j] = int(ch)\n            else:\n                sc[i][j] = 0\n    # Process p grid\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            ch = p[i][j-1]\n            if '0' <= ch <= '9':\n                pc[i][j] = int(ch)\n            else:\n                pc[i][j] = 0\n    # Build source nodes (ns)\n    sp = 1\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            ns[i][j] = []\n            for _ in range(sc[i][j]):\n                ns[i][j].append(sp)\n                sp += 1\n    # Build sink nodes (np)\n    pp = 1000\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            np[i][j] = []\n            for _ in range(pc[i][j]):\n                np[i][j].append(pp)\n                pp += 1\n    # BFS from start to compute ir (time limits)\n    q = deque()\n    q.append((rx, ry))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if ir[nx][ny] > ir[x][y] + 1 and sc[nx][ny] != -1:\n                ir[nx][ny] = ir[x][y] + 1\n                q.append((nx, ny))\n    # For each cell with source nodes, run wk to add edges\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if sc[i][j] > 0:\n                wk(i, j)\n    # Compute and output maximum matching\n    print(hkp())\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-0.6711778044700623, -4.768370445162873e-07, -0.00011431517486926168, -4.577531944960356e-05, 0.0, -7.152555099310121e-07, -0.002905197674408555, 0.0, 0.0, -1.1920928244535389e-07, -0.008618894964456558, -0.4166937470436096, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -8.701899787411094e-05, -0.023247426375746727, -0.0016217187512665987, -0.14843107759952545, -0.3278731405735016, -0.7494544982910156, -0.7886284589767456, -0.8253054022789001, -0.12697109580039978, -0.4876726567745209, -0.00043466180795803666, -0.2118055671453476, -1.4305104514278355e-06, -1.6927575416048057e-05, -0.600297749042511, -