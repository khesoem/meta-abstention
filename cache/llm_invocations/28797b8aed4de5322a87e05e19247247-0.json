 for c in range(1, N + 1):\n            B[r][c] = line[c - 1]\n    B1 = [row[:] for row in B]\n    B2 = [['#'] * (N + 2) for _ in range(N + 2)]\n    for r in range(1, N + 1):\n        line = next(it)\n        for c in range(1, N + 1):\n            B2[r][c] = line[c - 1]\n    scientists = []\n    capsules = []\n    z = None\n    for r in range(1, N + 1):\n        for c in range(1, N + 1):\n            ch = B[r][c]\n            if '0' <= ch <= '9':\n                if ch > '0':\n                    scientists.append((r, c))\n                B[r][c] = '.'\n            elif ch == 'Z':\n                z = (r, c)\n                B[r][c] = '.'\n            ch2 = B2[r][c]\n            if '0' <= ch2 <= '9' and ch2 > '0':\n                capsules.append((r, c))\n    D1 = bfs_z(z, B, N)\n    nS = len(scientists)\n    nC = len(capsules)\n    SRC = 0\n    SINK = nS + nC + 1\n    cap = [[0] * (SINK + 1) for _ in range(SINK + 1)]\n    INF = 98765432\n    for i, (r, c) in enumerate(scientists):\n        cap[SRC][i + 1] += int(B1[r][c])\n    for j, (r, c) in enumerate(capsules):\n        cap[nS + j + 1][SINK] += int(B2[r][c])\n    for i, s in enumerate(scientists):\n        D2 = bfs_source(s, B, D1, N)\n        for j, c in enumerate(capsules):\n            if D2[c[0]][c[1]] >= 0 and D2[c[0]][c[1]] <= T:\n                cap[i + 1][nS + j + 1] = INF\n    print(scaling_maxflow(SRC, SINK, cap))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.8540122509002686, -0.002133119385689497, -1.4066597032069694e-05, 0.0, -2.3841855067985307e-07, -0.0004374024283606559, -0.004161389544606209, -1.9073468138230965e-06, -4.410734163684538e-06, -3.576214658096433e-05, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, -0.019783908501267433, -0.05395035073161125, -0.06769134104251862, -6.556489552167477e-06, -0.09246322512626648, -0.041073236614465714, -0.10874760150909424, -0.0015075758565217257, -0.3879202604293823, -0.