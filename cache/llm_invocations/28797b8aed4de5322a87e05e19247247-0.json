         int nr = u.r + dr[k], nc = u.c + dc[k];\n            if (B[nr][nc] != '.') continue;\n            if (D2[nr][nc] >= 0) continue;\n            if (D1[nr][nc] >= 0 && D1[nr][nc] < D2[u.r][u.c] + 1) continue;\n            D2[nr][nc] = D2[u.r][u.c] + 1;\n            q.push_back(Pos(nr, nc));\n        }\n    }\n}\n\nint scaling_maxflow(int s, int t, vector<vector<int> > cap) {\n    int n = (int)cap.size();\n    int flow = 0;\n\n    for (int scale = 1 << 30; scale > 0; scale >>= 1) {\n        while (true) {\n            vector<int> par(n, -1);\n            queue<int> q;\n            par[s] = s;\n            q.push(s);\n            while (!q.empty() && par[t] == -1) {\n                int u = q.front();\n                q.pop();\n                for (int v = 0; v < n; ++v) {\n                    if (par[v] == -1 && cap[u][v] >= scale) {\n                        par[v] = u;\n                        q.push(v);\n                        if (v == t) break;\n                    }\n                }\n            }\n            if (par[t] == -1) break;\n\n            int add = INT_MAX;\n            for (int v = t; v != s; v = par[v])\n                add = min(add, cap[par[v]][v]);\n            for (int v = t; v != s; v = par[v]) {\n                cap[par[v]][v] -= add;\n                cap[v][par[v]] += add;\n            }\n            flow += add;\n        }\n    }\n    return flow;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> N >> T;\n    B.assign(N + 2, string(N + 2, '#'));\n\n    string line;\n    for (int r = 1; r <= N; ++r) {\n        cin >> line;\n        for (int c = 1; c <= N; ++c) B[r][c] = line[c - 1];\n    }\n    vector<string> B1 = B;\n\n    vector<string> B2(N + 2, string(N + 2, '#'));\n    for (int r = 1; r <= N; ++r) {\n        cin >> line;\n        for (int c = 1; c <= N; ++c) B2[r][c] = line[c - 1];\n    }\n\n    vector<Pos> scientists, capsules;\n    Pos z;\n    for (int r = 1; r <= N; ++r) {\n        