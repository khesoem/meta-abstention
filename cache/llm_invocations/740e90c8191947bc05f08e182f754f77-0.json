 0, 0]\n        self.dy = [0, 0, -1, 1]\n        self.graph = [[] for _ in range(self.SNK + 1)]\n        self.edges = []  # each edge: [to, rev, cap]\n\n    def add_edge(self, u, v, cap):\n        # forward edge\n        forward_idx = len(self.edges)\n        self.graph[u].append(forward_idx)\n        self.edges.append([v, -1, cap])  # rev placeholder\n        # reverse edge\n        reverse_idx = len(self.edges)\n        self.graph[v].append(reverse_idx)\n        self.edges.append([u, len(self.graph[u]) - 1, 0])\n        # set forward's rev\n        self.edges[forward_idx][1] = len(self.graph[v]) - 1\n\n    def bfs_level(self):\n        self.vis = [0] * (self.SNK + 1)\n        self.dep = [0] * (self.SNK + 1)\n        q = deque()\n        q.append(self.SRC)\n        self.vis[self.SRC] = 1\n        self.dep[self.SRC] = 1\n        while q:\n            x = q.popleft()\n            for i in self.graph[x]:\n                y, rev, cap = self.edges[i]\n                if not self.vis[y] and cap > 0:\n                    self.vis[y] = 1\n                    self.dep[y] = self.dep[x] + 1\n                    q.append(y)\n                    if y == self.SNK:\n                        return True\n        return False\n\n    def dfs(self, x, flow):\n        if x == self.SNK or flow == 0:\n            return flow\n        total = 0\n        for i in range(len(self.graph[x])):\n            idx = self.graph[x][i]\n            y, rev, cap = self.edges[idx]\n            if cap > 0 and self.dep[y] == self.dep[x] + 1:\n                pushed = self.dfs(y, min(flow, cap))\n                if pushed:\n                    self.edges[idx][2] -= pushed\n                    self.edges[rev][2] += pushed\n                    flow -= pushed\n                    total += pushed\n                    if flow == 0:\n                        break\n        if total == 0:\n            self.dep[x] = 0\n        return total\n\n    def run(self):\n        data = sys.stdin.read().split()\n        it =