 }\n    \n    cache[level][bits] = (cache[level][bits] + inv_factorial[bits] * compute(level + 1, 0)) % P;\n    return cache[level][bits];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> P;\n    ll total = mod_exp(k, n);\n    \n    if (n & 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    factorial[0] = 1;\n    for (int i = 1; i <= n; ++i) factorial[i] = factorial[i-1] * i % P;\n    \n    inv_factorial[n] = mod_exp(factorial[n], P - 2);\n    for (int i = n; i > 0; --i) inv_factorial[i-1] = inv_factorial[i] * i % P;\n    \n    memset(cache, -1, sizeof(cache));\n    ll invalid = compute(0, n);\n    ll result = (total - invalid + P) % P;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAX_N = 250005;\n    static int n, k, P;\n    static long[] factorial = new long[MAX_N];\n    static long[] inv_factorial = new long[MAX_N];\n    static long[][] cache = new long[26][MAX_N];\n\n    static long mod_exp(long base, long exp) {\n        long res = 1;\n        base %= P;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % P;\n            base = (base * base) % P;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static int get_lowest_set_bit(int x) { \n        return x & -x; \n    }\n\n    static long compute(int level, int bits) {\n        if (cache[level][bits] != -1) return cache[level][bits];\n        \n        if (bits == 0) {\n            cache[level][bits] = factorial[n];\n            for (int i = 0; i < level; ++i) {\n                cache[level][bits] = (cache[level][bits] * (k - i)) % P;\n            }\n            return cache[level][bits];\n        }\n        \n        cache[level][bits] = 0;\n        int remaining = bits ^ get_lowest_set_bit(bits);\n        \n        for (int subset = remaining; subset != 0; subset = (subset - 1) & remaining) {\n            cache[level][bits] = (cache[level][bits] + inv_factorial[bits ^ subset] * compute(level + 1, subset)) % P;\n        }\n        \n        cache[level][bits] = (cache[level][bits] + inv_factorial[bits] * compute(level + 1, 0)) % P;\n        return cache[level][bits];\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        P = Integer.parseInt(st.nextToken());\n        \n        long total = mod_exp(k, n);\n        \n        if ((n & 1) == 1) {\n            System.out.println(total);\n            return;\n        }\n        \n        factorial[0] = 1;\n        for (int i = 1; i <= n; ++i) factorial[i] = factorial[i-1] * i % P;\n        \n        inv_factorial[n] = mod_exp(factorial[n], P - 2);\n        for (int i = n; i > 0; --i) inv_factorial[i-1] = inv_factorial[i] * i % P;\n        \n        for (int i = 0; i < 26; ++i) {\n            Arrays.fill(cache[i], -1);\n        }\n        \n        long invalid = compute(0, n);\n        long result = (total - invalid + P) % P;\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001003691868390888, -1.6689286894688848e-06, -3.576278118089249e-07, -0.0006562701892107725, -1.597391747054644e-05, -0.0892491489648819, -0.2527233958244324, -0.00067473528906703, -1.3112935448589269e-05, -0.00037472377880476415, -0.00047910655848681927, -2.1815061700181104e-05, -2.50339189733495e-06, -3.755022044060752e-05, -0.004083866253495216, -0.00020454221521504223, -0.02936732769012451, -0.2025289535522461, -