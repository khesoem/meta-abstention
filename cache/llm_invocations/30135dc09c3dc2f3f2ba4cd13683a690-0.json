  fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> pii;\n        priority_queue<pii, vector<pii>, greater<pii>> pq;\n        pq.push({dist[s] = 0, s});\n        while (!pq.empty())\n        {\n            pii p = pq.top(); pq.pop();\n            if (dist[p.second] < p.first) continue;\n            if (p.second == t) break;\n            for (Edge &e : adj[p.second])\n                if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({dist[e.dst] = dist[e.src] + rcost(e), e.dst});\n                }\n        }\n        return dist[t];\n    }\n\n    pair<flow_type, cost_type> max_flow(int s, int t)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < N; ++u)\n            for (Edge &e : adj[u])\n                e.flow = 0;\n        pot.assign(N, 0);\n        dist.assign(N, 0);\n        back.assign(N, nullptr);\n        while (dijkstra(s, t) < oo)\n        {\n            for (int u = 0; u < N; ++u)\n                if (dist[u] < dist[t])\n                    pot[u] += dist[u] - dist[t];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (Edge *e = back[t]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (Edge *e = back[t]; e; e = back[e->src])\n            {\n                e->flow += f;\n                adj[e->dst][e->rev].flow -= f;\n            }\n            flow += f;\n            cost += f * (pot[t] - pot[s]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n    int n, m, k, c, d, u, v;\n    cin >> n >> m >> k >> c >> d;\n    int total_nodes = (n + 2) * 102;\n    MinCostFlow<int, ll> g(total_nodes);\n    for (int i = 0; i < 102; ++i)\n        g.add_edge(node_id(i, 1, n), node_id(i, 0, n), 100, (ll)i * c);\n    for (int i = 0; i < 101; ++i)\n        for (int j = 0; j <= n