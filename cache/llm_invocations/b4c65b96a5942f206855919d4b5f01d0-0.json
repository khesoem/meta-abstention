{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int INF = 0x7f7f7f7f;\nint n, m, s, t, p, c, d, x[505], y[505];\nint max_flow, min_cost;\nint edge_cnt = 1;\nint head[5000005], nxt[5000005<<1], dest[5000005<<1], cap[5000005<<1], wgt[5000005<<1];\nint dist[5000005], prev_node[5000005], last_edge[5000005], aug[5000005];\nbool in_queue[5000005];\n\nvoid add_edge(int u, int v, int f, int w) {\n    nxt[++edge_cnt] = head[u];\n    dest[edge_cnt] = v;\n    cap[edge_cnt] = f;\n    wgt[edge_cnt] = w;\n    head[u] = edge_cnt;\n}\n\nbool bfs_spfa() {\n    memset(dist, INF, sizeof(dist));\n    memset(in_queue, false, sizeof(in_queue));\n    queue<int> q;\n    q.push(s);\n    in_queue[s] = true;\n    dist[s] = 0;\n    aug[s] = INF;\n    prev_node[t] = -1;\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        in_queue[u] = false;\n        for (int i = head[u]; i; i = nxt[i]) {\n            if (cap[i] && dist[dest[i]] > dist[u] + wgt[i]) {\n                dist[dest[i]] = dist[u] + wgt[i];\n                prev_node[dest[i]] = u;\n                last_edge[dest[i]] = i;\n                aug[dest[i]] = min(aug[u], cap[i]);\n                if (!in_queue[dest[i]]) {\n                    in_queue[dest[i]] = true;\n                    q.push(dest[i]);\n                }\n            }\n        }\n    }\n    return prev_node[t] != -1;\n}\n\nvoid min_cost_max_flow() {\n    max_flow = min_cost = 0;\n    while (bfs_spfa()) {\n        int cur = t;\n        max_flow += aug[t];\n        min_cost += aug[t] * dist[t];\n        while (cur != s) {\n            cap[last_edge[cur]] -= aug[t];\n            cap[last_edge[cur] ^ 1] += aug[t];\n            cur = prev_node[cur];\n        }\n    }\n}\n\nint idx(int time, int city) {\n    return time * n + city;\n}\n\nint main() {\n    cin >> n >> m >> p >> c >> d;\n    s = 0;\n    t = n * 99 + 1;\n    for (int i = 1, start; i <= p && cin >> start; i++) {\n        add_edge(s, idx(0, start), 1, 0);\n        add_edge(idx(0, start), s, 0, 0);\n    }\n    for (int i = 1; i <= m; cin >> x[i] >> y[i], i++);\n    for (int time = 0; time <= 99; time++) {\n        add_edge(idx(time, 1), idx(time + 1, 1), INF, 0);\n        add_edge(idx(time + 1, 1), idx(time, 1), 0, 0);\n        for (int city = 2; city <= n; city++) {\n            add_edge(idx(time, city), idx(time + 1, city), INF, c);\n            add_edge(idx(time + 1, city), idx(time, city), 0, -c);\n        }\n        for (int edge = 1; edge <= m; edge++) {\n            for (int k = 1; k <= p; k++) {\n                int cost_val = d * k * k - d * (k - 1) * (k - 1) + c;\n                add_edge(idx(time, x[edge]), idx(time + 1, y[edge]), 1, cost_val);\n                add_edge(idx(time + 1, y[edge]), idx(time, x[edge]), 0, -cost_val);\n                add_edge(idx(time, y[edge]), idx(time + 1, x[edge]), 1, cost_val);\n                add_edge(idx(time + 1, x[edge]), idx(time, y[edge]), 0, -cost_val);\n            }\n        }\n    }\n    min_cost_max_flow();\n    cout << min_cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    p = next(it)\n    c = next(it)\n    d = next(it)\n    \n    starts = [next(it) for _ in range(p)]\n    x = [0] * (m + 1)\n    y = [0] * (m + 1)\n    for i in range(1, m + 1):\n        x[i] = next(it)\n        y[i] = next(it)\n    \n    s = 0\n    t = n * 99 + 1\n    max_node = n * 100 + 5  # enough for all time layers + source + sink\n    \n    head = [-1] * max_node\n    nxt = []\n    dest = []\n    cap = []\n    wgt = []\n    \n    def add_edge(u, v, f, w):\n        # forward edge\n        nxt.append(head[u])\n        dest.append(v)\n        cap.append(f)\n        wgt.append(w)\n        head[u] = len(nxt) - 1\n        # reverse edge\n        nxt.append(head[v])\n        dest.append(u)\n        cap.append(0)\n        wgt.append(-w)\n        head[v] = len(nxt) - 1\n    \n    def idx(time, city):\n        return time * n + city\n    \n    # source to starting cities at time 0\n    for start in starts:\n        add_edge(s, idx(0, start), 1, 0)\n    \n    # build time-expanded graph\n    for time in range(0, 100):  # time from 0 to 99 inclusive\n        # stay in city 1 (free)\n        add_edge(idx(time, 1), idx(time + 1, 1), INF, 0)\n        # stay in other cities (cost c)\n        for city in range(2, n + 1):\n            add_edge(idx(time, city), idx(time + 1, city), INF, c)\n        # edges for each road\n        for edge in range(1, m + 1):\n            u = x[edge]\n            v = y[edge]\n            for k in range(1, p + 1):\n                cost_val = d * k * k - d * (k - 1) * (k - 1) + c\n                add_edge(idx(time, u), idx(time + 1, v), 1, cost_val)\n                add_edge(idx(time, v), idx(time + 1, u), 1, cost_val)\n    \n    # min-cost max-flow (SPFA)\n    dist = [INF] * max_node\n    in_queue = [False] * max_node\n    prev_node = [-1] * max_node\n    last_edge = [-1] * max_node\n    aug = [0] * max_node\n    \n    def bfs_spfa():\n        nonlocal dist, in_queue, prev_node, last_edge, aug\n        dist = [INF] * max_node\n        in_queue = [False] * max_node\n        q = deque()\n        q.append(s)\n        in_queue[s] = True\n        dist[s] = 0\n        aug[s] = INF\n        prev_node[t] = -1\n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            i = head[u]\n            while i != -1:\n                if cap[i] and dist[dest[i]] > dist[u] + wgt[i]:\n                    dist[dest[i]] = dist[u] + wgt[i]\n                    prev_node[dest[i]] = u\n                    last_edge[dest[i]] = i\n                    aug[dest[i]] = min(aug[u], cap[i])\n                    if not in_queue[dest[i]]:\n                        in_queue[dest[i]] = True\n                        q.append(dest[i])\n                i = nxt[i]\n        return prev_node[t] != -1\n    \n    max_flow = 0\n    min_cost = 0\n    while bfs_spfa():\n        cur = t\n        max_flow += aug[t]\n        min_cost += aug[t] * dist[t]\n        while cur != s:\n            e = last_edge[cur]\n            cap[e] -= aug[t]\n            cap[e ^ 1] += aug[t]\n            cur = prev_node[cur]\n    \n    print(min_cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.209310256759636e-05, -4.768370445162873e-07, -4.768370445162873e-07, -0.0001995364436879754, -0.005294349975883961, -1.1920928244535389e-07, -2.2172682292875834e-05, -0.0004349001101218164, 0.0, 0.0, -4.768370445162873e-07, -0.001511027687229216, -0.6932533979415894, -0.01920030266046524, -3.58813522325363e-05, -0.0019383705221116543, -0.03804164379835129, -0.05772596597671509, -0.1859607845544815, -0.01799202710390091, -0.5255381464958191, -0.061994057