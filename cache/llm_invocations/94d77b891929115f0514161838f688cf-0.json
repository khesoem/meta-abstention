r (int &i = itArr[v]; i < (int)adj[v].size(); ++i) {\n        int e = adj[v][i];\n        if (cap[e] > 0 && levelArr[v] + 1 == levelArr[to[e]]) {\n            int pushed = dfs(to[e], t, min(f, cap[e]));\n            if (pushed) {\n                cap[e] -= pushed;\n                cap[rev[e]] += pushed;\n                return pushed;\n            }\n        }\n    }\n    return 0;\n}\n\nint maxflow(int s, int t) {\n    int flow = 0;\n    while (bfs(s, t)) {\n        memset(itArr, 0, sizeof(itArr));\n        while (true) {\n            int pushed = dfs(s, t, 1 << 30);\n            if (!pushed) break;\n            flow += pushed;\n        }\n    }\n    return flow;\n}\n\nint n, t;\nint S, T;\nint rp, cp;\nint in;\nint srcId[21][21], sinkId[21][21];\nint mark[21][21], dist[21][21];\nchar grid[21][21], grid2[21][21];\nint dr[4] = {-1, 0, 1, 0};\nint dc[4] = {0, 1, 0, -1};\n\nbool valid(int r, int c) {\n    return r >= 0 && r < n && c >= 0 && c < n;\n}\n\nvoid searchEdges(int a, int b) {\n    queue<pii> q;\n    memset(mark, 0, sizeof(mark));\n    memset(dist, -1, sizeof(dist));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (grid[i][j] == 'Y') mark[i][j] = 1;\n\n    q.push(make_pair(rp, cp));\n    q.push(make_pair(a, b));\n    dist[a][b] = dist[rp][cp] = 0;\n    mark[a][b] = 1;\n    mark[rp][cp] = 2;\n\n    while (!q.empty()) {\n        pii now = q.front(); q.pop();\n        int r = now.first, c = now.second;\n        if (mark[r][c] == 1 && grid2[r][c] > '0' && grid2[r][c] <= '9')\n            add_edge(srcId[a][b], sinkId[r][c], 9);\n\n        if (mark[r][c] == 1 && dist[r][c] == t) continue;\n\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k], nc = c + dc[k];\n            if (valid(nr, nc) && mark[nr][nc] == 0) {\n                mark[nr][nc] = mark[r][c];\n                dist[nr][nc] = dist[r][c] + 1;\n                q.push(make_pair(nr, nc));\n            } else if (mark[r][c] == 1 && valid(nr, nc) && mark