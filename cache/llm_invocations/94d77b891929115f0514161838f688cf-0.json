mark[r][c] == 1 and dist[r][c] == t:\n            continue\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if valid(nr, nc) and mark[nr][nc] == 0:\n                mark[nr][nc] = mark[r][c]\n                dist[nr][nc] = dist[r][c] + 1\n                q.append((nr, nc))\n            elif (mark[r][c] == 1 and valid(nr, nc) and mark[nr][nc] == 2 \n                  and dist[nr][nc] == dist[r][c] + 1 \n                  and '0' < grid2[nr][nc] <= '9'):\n                add_edge(srcId[a][b], sinkId[nr][nc], 9)\n\ndef main():\n    global n, t, in_node, rp, cp, grid, grid2, srcId, sinkId\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    S = 202\n    T = 203\n    in_node = 0\n    srcId = [[-1]*21 for _ in range(21)]\n    sinkId = [[-1]*21 for _ in range(21)]\n    grid = [['']*21 for _ in range(21)]\n    grid2 = [['']*21 for _ in range(21)]\n    for i in range(n):\n        line = next(it)\n        for j, ch in enumerate(line):\n            grid[i][j] = ch\n            if '0' < ch <= '9':\n                add_edge(S, in_node, ord(ch) - ord('0'))\n                srcId[i][j] = in_node\n                in_node += 1\n            if ch == 'Z':\n                rp = i\n                cp = j\n    for i in range(n):\n        line = next(it)\n        for j, ch in enumerate(line):\n            grid2[i][j] = ch\n            if '0' < ch <= '9':\n                add_edge(in_node, T, ord(ch) - ord('0'))\n                sinkId[i][j] = in_node\n                in_node += 1\n    for i in range(n):\n        for j in range(n):\n            if '0' < grid[i][j] <= '9' and '0' < grid2[i][j] <= '9':\n                add_edge(srcId[i][j], sinkId[i][j], 9)\n            if '0' < grid[i][j] <= '9':\n                searchEdges(i, j)\n    print(maxflow(S, T))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>",