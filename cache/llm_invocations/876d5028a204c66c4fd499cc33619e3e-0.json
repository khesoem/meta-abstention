) rez = rez * (n - i) / (i + 1);\n        return rez;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int r = sc.nextInt();\n        int c = sc.nextInt();\n        sc.nextLine();\n        String s = sc.nextLine();\n        int n = 2 * (r + c);\n        long msum = 0, nsum = 0, bsum, rasp = 0;\n        long[] arrL = new long[62];\n        long[] arrR = new long[62];\n        long[] arrR2 = new long[62];\n        int cna = 0, cnb = 0, ok;\n        int ast, bst;\n\n        arrL[2 * r - 1] = 1;\n        for (int i = 2 * r; i < n; i++)\n            arrL[i] = arrL[i - 1] * i / (i - 2 * r + 1);\n\n        for (int i = 0; i <= n; i++) {\n            arrR[i] = comb(i, r);\n            arrR2[i] = comb(i, r - 1);\n        }\n\n        nsum = arrR[n / 2] * arrR[n / 2];\n\n        for (int i = n - 1; i >= 0; i--) {\n            if (msum > 0) ok = 1;\n            else ok = 0;\n            if (cnb == n / 2) ok = 1;\n            if (cna == n / 2) ok = 0;\n            if (ok == 1) {\n                cna++;\n                msum = msum - arrR2[n / 2 - cna] * arrR[n / 2 - cnb];\n            } else {\n                cnb++;\n                msum = msum + arrR2[n / 2 - cnb] * arrR[n / 2 - cna];\n            }\n        }\n\n        msum = Math.max(msum, -msum);\n\n        Map<Map.Entry<Long, Integer>, Long> mm = new HashMap<>();\n        Map<Map.Entry<Long, Integer>, Long> nm = new HashMap<>();\n        mm.put(new AbstractMap.SimpleEntry<>(0L, 0), 1L);\n\n        for (int i = n - 1; i >= 2 * r - 1; i--) {\n            nm.clear();\n            for (Map.Entry<Map.Entry<Long, Integer>, Long> it : mm.entrySet()) {\n                long sum = it.getKey().getKey();\n                int cnt = it.getKey().getValue();\n                long ncnt = it.getValue();\n                ast = n / 2 - cnt;\n                bst = i + 1 - ast;\n                long asum = sum + arrR2[ast - 1] * arrR[bst];\n                long bsum2 = sum - arrR2[bst - 1] * arrR[ast];\n                if (s.charAt(i) == 'A') {\n                    nm.merge(new AbstractMap.SimpleEntry<>(asum, cnt + 1), ncnt, Long::sum);\n                    nm.merge(new AbstractMap.SimpleEntry<>(bsum2, cnt), 0L, Long::sum);\n                } else if (s.charAt(i) == 'B') {\n                    nm.merge(new AbstractMap.SimpleEntry<>(asum, cnt + 1), 0L, Long::sum);\n                    nm.merge(new AbstractMap.SimpleEntry<>(bsum2, cnt), ncnt, Long::sum);\n                } else {\n                    nm.merge(new AbstractMap.SimpleEntry<>(asum, cnt + 1), ncnt, Long::sum);\n                    nm.merge(new AbstractMap.SimpleEntry<>(bsum2, cnt), ncnt, Long::sum);\n                }\n            }\n            nsum = nsum - arrL[i];\n            mm.clear();\n            for (Map.Entry<Map.Entry<Long, Integer>, Long> it : nm.entrySet()) {\n                long sum = it.getKey().getKey();\n                int cnt = it.getKey().getValue();\n                long ncnt = it.getValue();\n                ast = n / 2 - cnt;\n                bst = i - ast;\n                if (cnt > n / 2 || n - i - cnt > n / 2) continue;\n                if (sum < -msum - arrR[ast] * arrR[bst] || sum > msum + arrR[ast] * arrR[bst]) continue;\n                mm.merge(new AbstractMap.SimpleEntry<>(sum, cnt), ncnt, Long::sum);\n            }\n        }\n\n        bsum = Long.MAX_VALUE;\n        for (Map.Entry<Map.Entry<Long, Integer>, Long> it : mm.entrySet()) {\n            long sum = it.getKey().getKey();\n            bsum = Math.min(bsum, Math.max(sum, -sum));\n        }\n\n        for (Map.Entry<Map.Entry<Long, Integer>, Long> it : mm.entrySet()) {\n            long sum = it.getKey().getKey();\n            long ncnt = it.getValue();\n            int cnt = it.getKey().getValue();\n            if (sum == bsum || sum == -bsum) {\n                int sem = 0;\n                for (int i = 0; i < 2 * r - 1; i++) {\n                    if (s.charAt(i) == '?') sem++;\n         