atic void main(String[] args) throws IOException {\n        Scanner sc = new Scanner();\n        int w = sc.nextInt();\n        int m = sc.nextInt();\n        \n        boolean result = solve(w, m) || solve(w, m - 1) || solve(w, m + 1);\n        System.out.println(result ? \"YES\" : \"NO\");\n    }\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <sstream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n\nusing namespace std;\n\nclass Scanner {\nprivate:\n    string line;\n    int pos;\n    vector<string> tokens;\n    \npublic:\n    Scanner() : pos(0) {}\n    \n    string next() {\n        while (tokens.empty() || pos >= tokens.size()) {\n            if (!getline(cin, line)) {\n                return \"\";\n            }\n            tokens.clear();\n            pos = 0;\n            istringstream iss(line);\n            string token;\n            while (iss >> token) {\n                tokens.push_back(token);\n            }\n        }\n        return tokens[pos++];\n    }\n    \n    int nextInt() {\n        return stoi(next());\n    }\n};\n\nbool solve(int w, int m) {\n    if (m == 0) return true;\n    if (m == 1) return true;\n    if (w == 1) return m >= 0;\n    if (w == 0) return m == 0;\n    \n    int remainder = ((m % w) + w) % w; // floorMod equivalent\n    if (remainder == 0) {\n        return solve(w, m / w);\n    } else if (remainder == 1) {\n        return solve(w, (m - 1) / w);\n    } else if (remainder == w - 1) {\n        return solve(w, (m + 1) / w);\n    }\n    return false;\n}\n\nint main() {\n    Scanner sc;\n    int w = sc.nextInt();\n    int m = sc.nextInt();\n    \n    bool result = solve(w, m) || solve(w, m - 1) || solve(w, m + 1);\n    cout << (result ? \"YES\" : \"NO\") << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\