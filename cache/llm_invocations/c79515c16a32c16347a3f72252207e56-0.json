ines\n  struct Edge { int v, r; ll f, c, p; };\n  vector<Edge> adj[N]; int sz[N]; ll mc;\n  void init(int n=N) { mc=0; fill(sz,sz+n,0); fill(adj,adj+n,vector<Edge>()); }\n  void add_edge(int a, int b, ll c=1, ll p=0) { mc = max(mc,c);\n    adj[a].push_back({b, sz[b]++, 0, c, p});\n    adj[b].push_back({a, sz[a]++, 0, 0, -p}); }  // change 0 to c for undirected\n\n  // Minimum cost maximum flow, assuming there are no negative cost cycles\n  // USAGE: 1) add edges 2) min_cost_flow(S, T, price, V, sparse?);\n  // use O(V^2) Dijkstra for dense graphs, and O(E*log(V)) otherwise\n  bool vis[N]; int par[N]; ll pot[N], dist[N];\n  void pot_init(int n) { fill(pot, pot+n, 0);\n    // if all edge costs >= 0, we don't need to run the Bellman-Ford here\n    for(int i=1; i<n; i++) for(int u=0; u<n; u++) for(const Edge& e:adj[u])\n      if(e.c) pot[e.v] = min(pot[e.v], pot[u] + e.p); }\n  ll mcf(int s, int t, ll& price, int n, bool sparse) {\n    fill(vis, vis+n, 0); fill(dist, dist+n, INF); dist[s] = 0;\n    // only need one of the branches below\n    if(sparse) { // replace priority_queue with queue for SPFA\n      queue<int> dk; dk.push(s); while(!dk.empty()) {\n        int u = dk.front(); dk.pop(); if(vis[u]) continue;\n        for(const Edge& e:adj[u]) {\n          if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r;\n            dk.push(e.v); } } }\n    } else { // dense\n      for(int u = s; u != -1; ) { vis[u] = true; for(const Edge& e: adj[u]) {\n        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n          dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r; } }\n        u = -1; ll best = INF;\n        for(int i=0; i<n; i++) if(!vis[i] && dist[i]<best) best = dist[u=i]; }\n    } // end branches\n    if (dist[t] >= INF) { return 0; } ll df = INF;\n    for(int u = t; u != s; ) { const Edge& r = adj[u][par[u]];\n      df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f); u = r.v; }\n    for(int u = t; u != s; ) { Edge& r=adj[u][par[u]], &e=adj[r.v][r.r];\n      e.f += df; r.f -= df; price += df*e.p; u = r.v; }\n    for(int i=0; i<n; i++) { pot[i] = min(INF, dist[i]+pot[i]); } return df; }\n  ll min_cost_flow(int s, int t, ll& price, int n=N, bool sparse=false) {\n    pot_init(n); ll flow = price = 0;\n    while(ll df=mcf(s, t, price, n, sparse)) { flow += df; } return flow; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tll price, flow = Flow::min_cost_flow(source, sink, price, sink+1, true);\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    private static final int T = 99;\n    private static final int C = 12;\n\n    private static class Flow {\n        private static final int N = 50 * T + 2;\n        private static List<Edge>[] adj;\n        private static int[] sz;\n        private static long mc;\n        private static boolean[] vis;\n        private static int[] par;\n        private static long[] pot;\n        private static long[] dist;\n\n        private static class Edge {\n            int v, r;\n            long f, c, p;\n\n            Edge(int v_, int r_, long f_, long c_, long p_) {\n                v = v_;\n                r = r_;\n                f = f_;\n                c = c_;\n                p = p_;\n            }\n        }\n\n        static void init() {\n            mc = 0;\n            adj = new ArrayList[N];\n            sz = new int[N];\n            for (int i = 0; i < N; i++) {\n                adj[i] = new ArrayList<>();\n            }\n            vis = new boolean[N];\n            par = new int[N];\n            pot = new long[N];\n            dist = new long[N];\n        }\n\n        static void addEdge(int a, int b, long c, long p) {\n            mc = Math.max(mc, c);\n            adj[a].add(new Edge(b, sz[b]++, 0, c, p));\n            adj[b].add(new Edge(a, sz[a]++, 0, 0, -p));\n        }\n\n        private static void potInit(int n) {\n            Arrays.fill(pot, 0);\n            for (int i = 1; i < n; i++) {\n                for (int u = 0; u < n; u++) {\n                    for (Edge e : adj[u]) {\n                        if (e.c > 0) {\n                            pot[e.v] = Math.min(pot[e.v], pot[u] + e.p);\n                        }\n                    }\n                }\n            }\n        }\n\n        private static long mcf(int s, int t, long[] price, int n, boolean sparse) {\n            Arrays.fill(vis, false);\n            Arrays.fill(dist, Long.MAX_VALUE / 2);\n            dist[s] = 0;\n\n            if (sparse) {\n                Queue<Integer> dk = new LinkedList<>();\n                dk.add(s);\n                while (!dk.isEmpty()) {\n                    int u = dk.poll();\n                    if (vis[u]) continue;\n                    for (Edge e : adj[u]) {\n                        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                            par[e.v] = e.r;\n                            dk.add(e.v);\n                        }\n                    }\n                }\n            } else {\n                for (int u = s; u != -1; ) {\n                    vis[u] = true;\n                    for (Edge e : adj[u]) {\n                        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                            par[e.v] = e.r;\n                        }\n                    }\n                    u = -1;\n                    long best = Long.MAX_VALUE / 2;\n                    for (int i = 0; i < n; i++) {\n                        if (!vis[i] && dist[i] < best) {\n                            best = dist[i];\n                            u = i;\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] >= Long.MAX_VALUE / 2) return 0;\n\n            long df = Long.MAX_VALUE / 2;\n            for (int u = t; u != s; ) {\n                Edge r = adj[u].get(par[u]);\n                df = Math.min(df, adj[r.v].get(r.r).c - adj[r.v].get(r.r).f);\n                u = r.v;\n            }\n\n            for (int u = t; u != s; ) {\n                Edge r = adj[u].get(par[u]);\n                Edge e = adj[r.v].get(r.r);\n                e.f += df;\n                r.f -= df;\n                price[0] += df * e.p;\n                u = r.v;\n            }\n\n            for (int i = 0; i < n; i++) {\n                pot[i] = Math.min(Long.MAX_VALUE / 2, dist[i] + pot[i]);\n            }\n\n            return df;\n        }\n\n        static long minCostFlow(int s, int t, long[] price, int n, boolean sparse) {\n            potInit(n);\n            long flow = 0;\n            price[0] = 0;\n            long df;\n            while ((df = mcf(s, t, price, n, sparse)) > 0) {\n                flow += df;\n            }\n            return flow;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int source = 0;\n        int sink = n * T + 1;\n\n        Flow.init();\n\n        for (int i = 0; i < k; i++) {\n            int a = sc.nextInt();\n            Flow.addEdge(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; t++) {\n            Flow.addEdge(1 + t * n, sink, Long.MAX_VALUE / 2, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; i++) {\n                    Flow.addEdge(i + (t - 1) * n, i + t * n, Long.MAX_VALUE / 2, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; j++) {\n                int cost = (j + 1) * (j + 1) - j * j;\n                for (int t = 1; t < T; t++) {\n                    Flow.addEdge(a + (t - 1) * n, b + t * n, 1, (long) cost * d + c);\n                    Flow.addEdge(b + (t - 1) * n, a + t * n, 1, (long) cost * d + c);\n                }\n            }\n        }\n\n        long[] price = new long[1];\n        long flow = Flow.minCostFlow(source, sink, price, sink + 1, true);\n        System.out.println(price[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.3180723e-06, 0.0, -1.1920928e-07, -0.0001666407, -0.00046826364, -3.81469e-06, -0.10021888, -1.5021197, -0.0029744927, -1.1920922e-06, -0.0013117527, -0.014202234, -0.004159965, -1.5288012, -7.605264e-05, -0.011127793, -0.12800623, -0.020143934, -8.463824e-06, -1.1920928e-07, -2.467602e-05, -6.651657e-05, -1.1920928e-07, -3.2186456e-06, -1.1920928e-07, -2.3841855e-07, -3.6954812e-06, -4.1722382e-05, -5.7220295e-06, -2.3841855e-07, -4.887569e-06, -3.52977, -2.622601e-06, -2.097315, -5.0067774e-06, -0.0069204164, -0.5829091, -0.0032