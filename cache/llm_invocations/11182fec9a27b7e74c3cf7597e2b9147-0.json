nge(n):\n        val = 0\n        for j in range(len(cur)):\n            val = (val + seq[i - j - 1] * cur[j]) % MOD\n        val = (val - seq[i]) % MOD\n        if val == 0:\n            continue\n        if not cur:\n            cur = [0] * (i + 1)\n            lf = i\n            ld = val\n            continue\n        k = (-val * mod_pow(ld, MOD - 2, MOD)) % MOD\n        c = [0] * (i - lf - 1)\n        c.append(k)\n        for j in range(len(ls)):\n            c.append((-ls[j] * k) % MOD)\n        if len(c) < len(cur):\n            c = c + [0] * (len(cur) - len(c))\n        for j in range(len(cur)):\n            c[j] = (c[j] + cur[j]) % MOD\n        if len(cur) < i - lf + len(ls):\n            ls = cur[:]\n            lf = i\n            ld = val\n        cur = c[:]\n    for i in range(len(cur)):\n        cur[i] = (cur[i] % MOD + MOD) % MOD\n    return cur\n\ndef multiply(p, q, m, h):\n    tmp = [0] * (m * 2)\n    for i in range(m):\n        if p[i]:\n            for j in range(m):\n                tmp[i + j] = (tmp[i + j] + p[i] * q[j]) % MOD\n    for i in range(m * 2 - 1, m - 1, -1):\n        if tmp[i]:\n            for j in range(m - 1, -1, -1):\n                tmp[i - j - 1] = (tmp[i - j - 1] + tmp[i] * h[j]) % MOD\n    for i in range(m):\n        p[i] = tmp[i]\n\ndef evaluate(k, h, a, m):\n    s = [0] * m\n    t = [0] * m\n    s[0] = 1\n    if m != 1:\n        t[1] = 1\n    else:\n        t[0] = h[0]\n    while k:\n        if k & 1:\n            multiply(s, t, m, h)\n        multiply(t, t, m, h)\n        k >>= 1\n    res = 0\n    for i in range(m):\n        res = (res + s[i] * a[i]) % MOD\n    return (res % MOD + MOD) % MOD\n\ndef solve(seq, n):\n    if n < len(seq):\n        return seq[n]\n    h = berlekamp_massey(seq)\n    m = len(h)\n    if m == 0:\n        return 0\n    a = seq[:m]\n    return evaluate(n, h, a, m)\n\ndef count_numbers(x, upper):\n    cnt = 0\n    s = str(x)\n    length = len(s)\n    if x > 0:\n        cnt += 1\n    for i in range(1, T)