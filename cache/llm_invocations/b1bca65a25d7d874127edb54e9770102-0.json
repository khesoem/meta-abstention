ead() {\n        if (snumChars == -1)\n            throw std::runtime_error(\"InputMismatchException\");\n        if (curChar >= snumChars) {\n            curChar = 0;\n            stream.read(buf, sizeof(buf));\n            snumChars = stream.gcount();\n            if (snumChars <= 0)\n                return -1;\n        }\n        return static_cast<unsigned char>(buf[curChar++]);\n    }\n\n    int nextInt() {\n        int c = read();\n        while (isSpaceChar(c)) {\n            c = read();\n        }\n        int sgn = 1;\n        if (c == '-') {\n            sgn = -1;\n            c = read();\n        }\n        int res = 0;\n        do {\n            res *= 10;\n            res += c - '0';\n            c = read();\n        } while (!isSpaceChar(c));\n        return res * sgn;\n    }\n\n    long long nextLong() {\n        int c = read();\n        while (isSpaceChar(c)) {\n            c = read();\n        }\n        int sgn = 1;\n        if (c == '-') {\n            sgn = -1;\n            c = read();\n        }\n        long long res = 0;\n        do {\n            res *= 10;\n            res += c - '0';\n            c = read();\n        } while (!isSpaceChar(c));\n        return res * sgn;\n    }\n\n    std::vector<int> nextIntArray(int n) {\n        std::vector<int> a(n);\n        for (int i = 0; i < n; i++) {\n            a[i] = nextInt();\n        }\n        return a;\n    }\n\n    std::string readString() {\n        int c = read();\n        while (isSpaceChar(c)) {\n            c = read();\n        }\n        std::string res;\n        do {\n            res += static_cast<char>(c);\n            c = read();\n        } while (!isSpaceChar(c));\n        return res;\n    }\n\n    std::string nextLine() {\n        int c = read();\n        while (isSpaceChar(c))\n            c = read();\n        std::string res;\n        do {\n            res += static_cast<char>(c);\n            c = read();\n        } while (!isEndOfLine(c));\n        return res;\n    }\n\n    bool isSpaceChar(int c) {\n        return c == ' ' || c == '\\n' || c == '\\r' || c == '\\t' || c == -1;\n    }\n\nprivate:\n    bool isEndOfLine(int c) {\n        return c == '\\n' || c == '\\r' || c == -1;\n    }\n};\n\nint main() {\n    InputReader in(std::cin);\n    int n = in.nextInt();\n    int b = in.nextInt();\n    std::vector<int> a(n);\n    a = in.nextIntArray(n);\n    \n    std::vector<int> odd(n + 1, 0);\n    std::vector<int> even(n + 1, 0);\n    odd[0] = 0;\n    even[0] = 0;\n    \n    for (int i = 1; i <= n; i++) {\n        if (a[i - 1] % 2 == 1) {\n            odd[i] = odd[i - 1] + 1;\n            even[i] = even[i - 1];\n        } else {\n            odd[i] = odd[i - 1];\n            even[i] = even[i - 1] + 1;\n        }\n    }\n    \n    int prev = 0;\n    std::priority_queue<int, std::vector<int>, std::greater<int>> cost;\n    \n    for (int i = 1; i <= n - 1; i++) {\n        int oc = odd[i] - odd[prev];\n        int ec = even[i] - even[prev];\n        if (oc == ec) {\n            cost.push(static_cast<int>(std::abs(a[i] - a[i - 1])));\n            prev = i;\n        }\n    }\n    \n    int sum = 0;\n    int count = 0;\n    while (!cost.empty() && sum <= b) {\n        sum += cost.top();\n        cost.pop();\n        count++;\n    }\n    \n    if (count == 0) {\n        std::cout << \"0\" << std::endl;\n    } else {\n        if (cost.empty() && sum <= b) {\n            std::cout << count << std::endl;\n        } else {\n            std::cout << count - 1 << std::endl;\n        }\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010144196130568162, -4.887569048150908e-06, -5.960462772236497e-07, -0.0023010701406747103, -2.861018856492592e-06, -4.386805812828243e-05, -2.3841855067985307e-07, -9.65590606938349e-06, -2.50339189733495e-06, -0.007529451511800289, -2.0265558760002023e-06, -3.683499380713329e-05, -1.4305104514278355e-06, -0.00014625910262111574, -2.3841830625315197e-06, -1.37089746