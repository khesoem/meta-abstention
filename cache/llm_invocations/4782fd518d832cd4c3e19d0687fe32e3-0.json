) { inq[q[qs] = v] = qs; qs++; }\n\t\t\t\t\tfor( int i = inq[v], j = ( i - 1 )/2, t;\n\t\t\t\t\t\t\tdist[q[i]] < dist[q[j]]; i = j, j = ( i - 1 )/2 )\n\t\t\t\t\t\tBUBL;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif (dist[t] >= INF) return 0; ll df = INF;\n\t\tfor (int e, i = t; i != s; i = ep[e])\n\t\t\te = par[i], df = min(df, cap[e] - flo[e]);\n\t\tfor (int e, i = t; i != s; i = ep[e])\n\t\t\te = par[i], flo[e] += df, flo[e^1] -= df, price += df*cost[e];\n\t\tfor (int i = 0; i < n; ++i) pot[i] = min(INF, dist[i] + pot[i]);\n\t\treturn df; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\tFlow::init();\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tFlow::mcf_pot_init(Flow::N);\n\tll price = 0;\n\tll flow = 0;\n\twhile (ll df = Flow::mcf_update(source, sink, price, Flow::N)) flow += df;\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass Flow:\n    def __init__(self):\n        self.N = 50*99 + 2\n        self.M = 2*self.N*15 + self.N + 7\n        self.par = [0]*self.N\n        self.first = [-1]*self.N\n        self.nxt = [0]*(2*self.M)\n        self.ep = [0]*(2*self.M)\n        self.flo = [0]*(2*self.M)\n        self.cap = [0]*(2*self.M)\n        self.cost = [0]*(2*self.M)\n        self.m = 0\n\n    def init(self):\n        self.m = 0\n        self.first = [-1]*self.N\n        self.flo = [0]*self.M\n\n    def add_edge(self, a, b, c=1, p=0):\n        self.nxt[self.m] = self.first[self.ep[self.m] = a]\n        self.first[self.ep[self.m]] = self.m\n        self.cap[self.m] = c\n        self.cost[self.m] = p\n        self.m += 1\n        self.nxt[self.m] = self.first[self.ep[self.m] = b]\n        self.first[self.ep[self.m]] = self.m\n        self.cap[self.m] = 0\n        self.cost[self.m] = -p\n        self.m += 1\n\n    def mcf_pot_init(self, n):\n        self.dist = [float('inf')]*n\n        self.pot = [0]*n\n        for i in range(1, n):\n            for e in range(self.m):\n                if self.cap[e]:\n                    self.pot[self.ep[e^1]] = min(self.pot[self.ep[e^1]], self.pot[self.ep[e]] + self.cost[e])\n\n    def mcf_update(self, s, t, price, n):\n        self.vis = [0]*n\n        self.dist = [float('inf')]*n\n        self.dist[s] = 0\n        self.inq = [-1]*n\n        self.q = [s]\n        self.inq[s] = 0\n        while self.q:\n            u = self.q[0]\n            self.inq[u] = -1\n            self.q[0] = self.q[-1]\n            del self.q[0]\n            if self.q:\n                self.inq[self.q[0]] = 0\n            for i in range(self.first[u], -1, -1):\n                v = self.ep[self.nxt[i]^1]\n                if self.flo[self.nxt[i]] < self.cap[self.nxt[i]] and self.dist[v] > self.dist[u] + self.pot[u] - self.pot[v] + self.cost[self.nxt[i]]:\n                    self.dist[v] = self.dist[u] + self.pot[u] - self.pot[v] + self.cost[self.nxt[i]]\n                    self.par[v] = self.nxt[i]\n                    if self.inq[v] < 0:\n                        self.q.append(v)\n                        self.inq[v] = len(self.q) - 1\n        if self.dist[t] >= float('inf'):\n            return 0\n        df = float('inf')\n        for i in range(t, s, self.ep[self.par[i]^1]):\n            df = min(df, self.cap[self.par[i]] - self.flo[self.par[i]])\n        for i in range(t, s, self.ep[self.par[i]^1]):\n            self.flo[self.par[i]] += df\n            self.flo[self.par[i]^1] -= df\n            price += df * self.cost[self.par[i]]\n        for i in range(n):\n            self.pot[i] = min(float('inf'), self.dist[i] + self.pot[i])\n        return df\n\ndef main():\n    n, m, k, c, d = map(int, input().split())\n    flow = Flow()\n    flow.init()\n    source = 0\n    sink = n*99+1\n    for i in range(k):\n        a = int(input())\n        flow.add_edge(source, a, 1, 0)\n    for t in range(99):\n        flow.add_edge(1+t*n, sink, float('inf'), 0)\n        if t > 0:\n            for i in range(1, n+1):\n                flow.add_edge(i+(t-1)*n, i+t*n, float('inf'), c)\n    for i in range(m):\n        a, b = map(int, input().split())\n        for j in range(15):\n            cost = (j+1)*(j+1) - j*j\n            for t in range(1, 99):\n                flow.add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c)\n                flow.add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c)\n    flow.mcf_pot_init(flow.N)\n    price = 0\n    flow = 0\n    while (df := flow.mcf_update(source, sink, price, flow.N)) > 0:\n        flow += df\n    assert(flow==k)\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002227773511549458, -0.04358405992388725, -0.19206582009792328, -0.04620641469955444, -0.2900550961494446, -0.4687653183937073, -0.5920184254646301, -0.3237873315811157, -0.5988864302635193, -0.774041473865509, -0.04054577276110649, -0.2359647899866104, -0.1670437455177307, -0.0030074152164161205, -1.5497195136049413e-06, -1.764281842042692e-05, -0.0004928089329041541, -0.314228355884552, -0.00040570611599832773, -0.0033886174205690622, -0.43685734272003174, -0.000942858459893614, -0.011047271080315113, -0.126571729779243