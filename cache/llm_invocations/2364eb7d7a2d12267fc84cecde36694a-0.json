{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing int64 = long long;\nconst int MAXN = 1000000;\nint freq[MAXN + 2], source, sink;\nvector<int> graph[MAXN + 2];\nconst int INF = 1e9;\n\nstruct Arc {\n    int from, to, flow, cap, cost;\n};\nvector<Arc> arcs;\nvector<int> adjList[MAXN + 2];\n\nvoid addArc(int a, int b, int c, int d) {\n    arcs.push_back({a, b, 0, c, d});\n    adjList[a].push_back(arcs.size() - 1);\n    arcs.push_back({b, a, 0, 0, -d});\n    adjList[b].push_back(arcs.size() - 1);\n}\n\nint dist[MAXN + 2], inQueue[MAXN + 2], minCap[MAXN + 2], parentArc[MAXN + 2];\npair<int, int> spfa(int n) {\n    for (int i = 0; i <= n; ++i) dist[i] = INF;\n    queue<int> q; q.push(source);\n    dist[source] = 0; inQueue[source] = 1; minCap[source] = INF;\n    while (!q.empty()) {\n        int u = q.front(); q.pop(); inQueue[u] = 0;\n        for (int id : adjList[u]) {\n            int v = arcs[id].to;\n            if (arcs[id].cap > arcs[id].flow && dist[v] > dist[u] + arcs[id].cost) {\n                dist[v] = dist[u] + arcs[id].cost;\n                parentArc[v] = id;\n                minCap[v] = min(minCap[u], arcs[id].cap - arcs[id].flow);\n                if (!inQueue[v]) {\n                    q.push(v);\n                    inQueue[v] = 1;\n                }\n            }\n        }\n    }\n    if (dist[sink] == INF) return {0, 0};\n    int v = sink;\n    while (v != source) {\n        int id = parentArc[v];\n        arcs[id].flow += minCap[sink];\n        arcs[id ^ 1].flow -= minCap[sink];\n        v = arcs[id].from;\n    }\n    return {minCap[sink], dist[sink] * minCap[sink]};\n}\n\npair<int, int> mcmf(int n) {\n    int flow = 0, cost = 0;\n    while (true) {\n        auto p = spfa(n);\n        if (p.first == 0) return {flow, cost};\n        flow += p.first;\n        cost += p.second;\n    }\n}\n\nint main() {\n    ios_base::sync_with_stdio(0); cin.tie(0);\n    int n, m, k, c, d; cin >> n >> m >> k >> c >> d;\n    for (int i = 1; i <= k; ++i) {\n        int x; cin >> x; freq[x]++;\n    }\n    for (int i = 1; i <= m; ++i) {\n        int u, v; cin >> u >> v;\n        graph[u].push_back(v);\n        graph[v].push_back(u);\n    }\n    source = 0; sink = 100 * n + n + 1;\n    for (int t = 0; t <= 99; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            addArc(n * t + i, n * (t + 1) + i, k, 0);\n            for (auto x : graph[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    addArc(n * t + i, n * (t + 1) + x, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        if (freq[i]) addArc(source, i, freq[i], 0);\n    for (int t = 0; t <= 100; ++t)\n        addArc(n * t + 1, sink, k, c * t);\n    cout << mcmf(sink).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\nimport sys\n\nMAXN = 1000000\nfreq = [0] * (MAXN + 2)\ngraph = [[] for _ in range(MAXN + 2)]\nINF = 10**9\n\narcs = []\nadjList = [[] for _ in range(MAXN + 2)]\n\ndef add_arc(a, b, c, d):\n    arcs.append([a, b, 0, c, d])\n    adjList[a].append(len(arcs) - 1)\n    arcs.append([b, a, 0, 0, -d])\n    adjList[b].append(len(arcs) - 1)\n\ndist = [0] * (MAXN + 2)\ninQueue = [0] * (MAXN + 2)\nminCap = [0] * (MAXN + 2)\nparentArc = [0] * (MAXN + 2)\n\ndef spfa(n):\n    for i in range(n + 1):\n        dist[i] = INF\n    q = deque()\n    q.append(source)\n    dist[source] = 0\n    inQueue[source] = 1\n    minCap[source] = INF\n    while q:\n        u = q.popleft()\n        inQueue[u] = 0\n        for id in adjList[u]:\n            v = arcs[id][1]\n            if arcs[id][3] > arcs[id][2] and dist[v] > dist[u] + arcs[id][4]:\n                dist[v] = dist[u] + arcs[id][4]\n                parentArc[v] = id\n                minCap[v] = min(minCap[u], arcs[id][3] - arcs[id][2])\n                if not inQueue[v]:\n                    q.append(v)\n                    inQueue[v] = 1\n    if dist[sink] == INF:\n        return (0, 0)\n    v = sink\n    while v != source:\n        id = parentArc[v]\n        arcs[id][2] += minCap[sink]\n        arcs[id ^ 1][2] -= minCap[sink]\n        v = arcs[id][0]\n    return (minCap[sink], dist[sink] * minCap[sink])\n\ndef mcmf(n):\n    flow = 0\n    cost = 0\n    while True:\n        p = spfa(n)\n        if p[0] == 0:\n            return (flow, cost)\n        flow += p[0]\n        cost += p[1]\n\ndef main():\n    data = list(map(int, sys.stdin.read().strip().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    for _ in range(k):\n        x = next(it)\n        freq[x] += 1\n    for _ in range(m):\n        u = next(it); v = next(it)\n        graph[u].append(v)\n        graph[v].append(u)\n    global source, sink\n    source = 0\n    sink = 100 * n + n + 1\n    for t in range(100):\n        for i in range(1, n + 1):\n            add_arc(n * t + i, n * (t + 1) + i, k, 0)\n            for x in graph[i