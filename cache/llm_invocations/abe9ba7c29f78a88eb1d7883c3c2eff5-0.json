        int n = sc.nextInt();\n        long k = sc.nextLong();\n        if (k == 0) {\n            out.println(fact[n]);\n            return;\n        }\n        if (n <= k) {\n            out.println(0);\n            return;\n        }\n        long comb = nCr(n, (int)k);\n        int cols = n - (int)k;\n        long sum = 0L;\n        for (int i = 0; i <= cols; i++) {\n            long term = nCr(cols, i);\n            term = term * powMod(cols - i, n) % mod;\n            if ((i & 1) == 1) {\n                sum -= term;\n                if (sum < 0) sum += mod;\n            } else {\n                sum += term;\n                if (sum >= mod) sum -= mod;\n            }\n        }\n        out.println((2L * ((comb * sum) % mod)) % mod);\n    }\n\n    public static void main(String[] args) {\n        out = new PrintWriter(new BufferedOutputStream(System.out));\n        sc = new FastReader();\n        solve();\n        out.close();\n    }\n\n    static class Triplet {\n        long gcd;\n        long x;\n        long y;\n\n        Triplet(long gcd, long x, long y) {\n            this.gcd = gcd;\n            this.x = x;\n            this.y = y;\n        }\n    }\n\n    static Triplet extendedGcd(long a, long b) {\n        if (a == 0) return new Triplet(b, 0, 1);\n        Triplet t = extendedGcd(b % a, a);\n        long x = t.y - (b / a) * t.x;\n        long y = t.x;\n        return new Triplet(t.gcd, x, y);\n    }\n\n    static long modInv(long a, long m) {\n        Triplet t = extendedGcd(a, m);\n        if (t.gcd != 1) return -1;\n        return (t.x % m + m) % m;\n    }\n\n    static FastReader sc;\n    static PrintWriter out;\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                try {\n                    st = ne