ng other = n - half;\n            if (parity == 0) {\n                long a = recurse(half, 0);\n                long b = recurse(other, 0);\n                long c = recurse(half, 1);\n                long d = recurse(other, 1);\n                answer = (a * b + c * d) % MOD;\n            } else {\n                long a = recurse(half, 0);\n                long b = recurse(other, 1);\n                long c = recurse(half, 1);\n                long d = recurse(other, 0);\n                answer = (a * b + c * d) % MOD;\n            }\n        }\n\n        cache.put(n, answer);\n        return answer;\n    }\n\n    static void solve(Scanner input) {\n        long n = input.nextInt();\n        long m = input.nextInt();\n        long l = input.nextInt();\n        long r = input.nextInt();\n        long sz = n * m;\n\n        if (sz % 2 == 0) {\n            long len = r - l + 1;\n            even = len / 2;\n            if ((len & 1) == 1 && (l & 1) == 0) {\n                even++;\n            }\n            odd = len - even;\n            System.out.println(recurse(sz, 0));\n        } else {\n            System.out.println(binpow(r - l + 1, sz));\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner in = new Scanner(System.in);\n        int tests = 1;\n        while (tests-- > 0) {\n            solve(in);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef binpow(base, exp):\n    result = 1\n    while exp:\n        if exp & 1:\n            result = (result * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return result\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, m, l, r = map(int, data[:4])\n    sz = n * m\n\n    if sz % 2 == 0:\n        length = r - l + 1\n        even = length // 2\