\n    def __iadd__(self, b):\n        self.v = self.normS(self.v + b.v)\n        return self\n    \n    def __isub__(self, b):\n        self.v = self.normS(self.v + MOD - b.v)\n        return self\n    \n    def __imul__(self, b):\n        self.v = (self.v * b.v) % MOD\n        return self\n    \n    def __itruediv__(self, b):\n        self.v = (self * b).v\n        return self\n    \n    def __iadd1__(self):\n        self.v = self.normS(self.v + 1)\n        return self\n    \n    def __isub1__(self):\n        self.v = self.normS(self.v - 1)\n        return self\n    \n    def extgcd(self, a, b):\n        p = [a, 1, 0]\n        q = [b, 0, 1]\n        while q[0]:\n            t = p[0] // q[0]\n            for i in range(3):\n                p[i], q[i] = q[i], p[i] - t * q[i]\n        if p[0] < 0:\n            for i in range(3):\n                p[i] = -p[i]\n        return p[1], p[2], p[0]\n    \n    def inv(self):\n        x, y, _ = self.extgcd(self.v, MOD)\n        return ModInt.make(self.normS(x + MOD))\n    \n    def pow(self, p):\n        if p < 0:\n            return self.inv().pow(-p)\n        a = ModInt(1)\n        x = self\n        while p:\n            if p & 1:\n                a *= x\n            x *= x\n            p >>= 1\n        return a\n    \n    def __eq__(self, b):\n        return self.v == b.v\n    \n    def __ne__(self, b):\n        return self.v != b.v\n    \n    def __hash__(self):\n        return hash(self.v)\n    \n    def __repr__(self):\n        return str(self.v)\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx])\n    idx += 1\n    \n    p = [[ModInt(0) for _ in range(N)] for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            val = int(data[idx])\n            idx += 1\n            p[i][j] = ModInt(val) / ModInt(100)\n    \n    # Using dictionary to simulate unordered_map<bitset<128>, mint>\n    # bitset is represented as integer (bitmask)\n    cur = {}\n    cur[1] = ModInt(1)  # bit 0 set\n    \n    for i in range(N):\n        nxt = {}\n        for b, prob in cur.items():\n            # Extract positions where bit is set\n            ones = []\n            for pos in range(N):\n                if b & (1 << pos):\n                    ones.append(pos)\n            \n            # Iterate over all possible outcomes (2^N)\n            for e in range(1 << N):\n                pr = ModInt(1)\n                for j in range(N):\n                    if (e >> j) & 1:\n                        pr *= p[i][j]\n                    else:\n                        pr *= (ModInt(1) - p[i][j])\n                \n                # Compute new bitmask\n                nb = 0\n                for x in ones:\n                    for r in range(N):\n                        if ((e >> r) & 1) and not ((x >> r) & 1):\n                            nb |= (1 << r)\n                \n                # Update next state\n                if nb in nxt:\n                    nxt[nb] += prob * pr\n                else:\n                    nxt[nb] = prob * pr\n        \n        cur = nxt\n    \n    ans = ModInt(0)\n    full_mask = (1 << N) - 1\n    for b, prob in cur.items():\n        if b & full_mask:\n            ans += prob\n    \n    print(ans.v)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-0.0005604841862805188, -4.291525328881107e-06, -7.271740287251305e-06, -0.1194123849272728, -0.00026913834153674543, -4.291525328881107e-06, -0.009857782162725925, -0.04090046137571335, -1.1920928244535389e-07, -0.00015937011630740017, -0.225492924451828, -0.03972569853067398, -2.3841855067985307e-07, -1.7881377516459906e-06, 0.0, -2.0265558760002023e-06, -0.005929854232817888, 0.0, -1.680836794548668e-05, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -7.152555099310121e-07, -1.2636104656849056e-05, -0.005934949964284897, -0.00033539868309162557, -2.145764938177308e-06, -1.31130127556389