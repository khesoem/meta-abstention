= 10) {\n            ll sz = bucket[i].size();\n            ll diff = normal_mod(now - x * mul);\n            ll pos = std::lower_bound(bucket[i].begin(), bucket[i].end(), MOD1 - diff) - bucket[i].begin();\n            answer = (answer + diff * sz + suffixSum[i]) % MOD2;\n            answer = (answer - ((MOD1 * (sz - pos)) % MOD2) + MOD2) % MOD2;\n            visited += sz;\n        }\n        return;\n    }\n\n    ++visited;\n    answer = (answer + normal_mod(visited - x)) % MOD2;\n    for (int digit = 0; digit <= 9; ++digit)\n        solve(x * 10 + digit);\n}\n\nint main() {\n    std::cin >> n;\n    fill_buckets();\n\n    for (int i = 0; i <= 7; ++i)\n        std::sort(bucket[i].begin(), bucket[i].end());\n\n    visited = 0;\n    for (int x = 1; x <= 9; ++x)\n        solve(x);\n\n    std::cout << answer << std::endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long MOD1 = 998244353L;\n    static final long MOD2 = 1000000007L;\n    static final long BASE = 1000000L;\n\n    static long n;\n    static long visited;\n    static long[] suffixSum = new long[15];\n    static long answer;\n    static ArrayList<Long>[] bucket = new ArrayList[15];\n\n    static long normalMod(long v) {\n        v %= MOD1;\n        if (v < 0) v += MOD1;\n        return v;\n    }\n\n    static void fillBuckets() {\n        class State {\n            int depth;\n            long value;\n            State(int d, long v) { depth = d; value = v; }\n        }\n\n        ArrayList<State> stack = new ArrayList<>();\n        stack.add(new State(0, 0));\n\n        while (!stack.isEmpty()) {\n            State cur = stack.remove(stack.size() - 1);\n            visited++;\n            long val = normalMod(visited - cur.value);\n            bucket[cur.depth].add(val);\n            suffixSum[cur.depth] = (suffixSum[cur.depth] + val) % MOD2;\n\n            if (cur.depth < 6) {\n                for (int digit = 9; digit >= 0; --digit) {\n                    stack.add(new State(cur.depth + 1, cur.value * 10 + digit));\n                }\n            }\n        }\n    }\n\n    static int lowerBound(ArrayList<Long> list, long target) {\n        int idx = Collections.binarySearch(list, target);\n        if (idx < 0) {\n            return -idx - 1;\n        }\n        return idx;\n    }\n\n    static void solve(long x) {\n        if (x > n) return;\n\n        if (x * BASE + BASE - 1 <= n && x * BASE * 10 > n) {\n            long now = visited;\n            for (int i = 0, mul = 1; i <= 6; ++i, mul *= 10) {\n                long sz = bucket[i].size();\n                long diff = normalMod(now - x * mul);\n                int pos = lowerBound(bucket[i], MOD1 - diff);\n                answer = (answer + diff * sz + suffixSum[i]) % MOD2;\n                answer = (answer - ((MOD1 * (sz - pos)) % MOD2) + MOD2) % MOD2;\n                visited += sz;\n            }\n            return;\n        }\n\n        visited++;\n        answer = (answer + normalMod(visited - x)) % MOD2;\n        for (int digit = 0; digit <= 9; ++digit) {\n            solve(x * 10 + digit);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextLong();\n\n        for (int i = 0; i < 15; i++) {\n            bucket[i] = new ArrayList<>();\n        }\n\n        fillBuckets();\n\n        for (int i = 0; i <= 7; i++) {\n            Collections.sort(bucket[i]);\n        }\n\n        visited = 0;\n        for (int x = 1; x <= 9; x++) {\n            solve(x);\n        }\n\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.16225416958332062, -0.0002687808300834149, 0.0, 0.0, -2.9444261599564925e-05, -3.0397906812140718e-05, 0.0, -1.9192511899746023e-05, -0.132638260