pq.empty()) {\n                auto [d, u] = pq.top(); pq.pop();\n                if (dist[u] < d) continue;\n                for (int i = 0; i < adj[u].size(); ++i) {\n                    auto& e = adj[u][i];\n                    if (e.cap > 0 && dist[e.to] > dist[u] + e.cost + pot[u] - pot[e.to]) {\n                        dist[e.to] = dist[u] + e.cost + pot[u] - pot[e.to];\n                        parv[e.to] = u;\n                        pare[e.to] = i;\n                        pq.emplace(dist[e.to], e.to);\n                    }\n                }\n            }\n            if (dist[sink] == INF) return -1;\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n            int f = flow;\n            for (int v = sink; v != src; v = parv[v])\n                f = min(f, adj[parv[v]][pare[v]].cap);\n            flow -= f;\n            total += f * pot[sink];\n            for (int v = sink; v != src; v = parv[v]) {\n                auto& e = adj[parv[v]][pare[v]];\n                e.cap -= f;\n                adj[v][e.rev].cap += f;\n            }\n        }\n        return total;\n    }\n};\n\nMinCostFlow mcf;\nint n, m, k, c, d;\nint arr[50], freq[50];\nvector<int> graph[50];\nconst int T = 100;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 0; i < k; ++i) {\n        cin >> arr[i];\n        ++freq[arr[i] - 1];\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        graph[u].push_back(v);\n        graph[v].push_back(u);\n    }\n    mcf.setup(n * T + 2);\n    for (int i = 0; i < n; ++i)\n        mcf.link(n * T, i, freq[i], 0);\n    for (int t = 0; t < T; ++t)\n        mcf.link(t * n, n * T + 1, k, c * t);\n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < T - 1; ++t)\n            mcf.link(t * n + i, (t + 1) * n + i, k, 0);\n        for (int neighbor : graph[i]) {\n            for (int t = 0; t < T - 1; ++t) {\n  