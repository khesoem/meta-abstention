                dist[src] = 0;\n                pq.offer(new int[]{0, src});\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int d = cur[0], u = cur[1];\n                    if (dist[u] < d) continue;\n                    for (int i = 0; i < adj[u].size(); ++i) {\n                        Edge e = adj[u].get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[u] + e.cost + pot[u] - pot[e.to]) {\n                            dist[e.to] = dist[u] + e.cost + pot[u] - pot[e.to];\n                            parv[e.to] = u;\n                            pare[e.to] = i;\n                            pq.offer(new int[]{dist[e.to], e.to});\n                        }\n                    }\n                }\n                if (dist[sink] == INF) return -1;\n                for (int i = 0; i < n; ++i) {\n                    pot[i] += dist[i];\n                }\n                int f = flow;\n                for (int v = sink; v != src; v = parv[v]) {\n                    f = Math.min(f, adj[parv[v]][pare[v]].cap);\n                }\n                flow -= f;\n                total += f * pot[sink];\n                for (int v = sink; v != src; v = parv[v]) {\n                    Edge e = adj[parv[v]][pare[v]];\n                    e.cap -= f;\n                    adj[v].get(e.rev).cap += f;\n                }\n            }\n            return total;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int[] arr = new int[50];\n        int[] freq = new int[50];\n        List<Integer>[] graph = new List[50];\n        for (int i = 0; i < 50; i++) {\n            graph[i] = new ArrayList<>();\n        }\n        \n        for (int i = 0; i < k; ++i) {\n            arr[i] = sc.nextInt();\n            ++freq[arr[i] - 1];\n        }\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            --u; --v;\n            graph[u].add(v);\n            graph[v].add(u);\n        }\n        \n        MinCostFlow mcf = new MinCostFlow(5010);\n        int T = 100;\n        mcf.setup(n * T + 2);\n        for (int i = 0; i < n; ++i) {\n            mcf.link(n * T, i, freq[i], 0);\n        }\n        for (int t = 0; t < T; ++t) {\n            mcf.link(t * n, n * T + 1, k, c * t);\n        }\n        for (int i = 0; i < n; ++i) {\n            for (int t = 0; t < T - 1; ++t) {\n                mcf.link(t * n + i, (t + 1) * n + i, k, 0);\n            }\n            for (int neighbor : graph[i]) {\n                for (int t = 0; t < T - 1; ++t) {\n                    for (int u = 0; u < k; ++u) {\n                        int cost = (u + 1) * (u + 1) * d - u * u * d;\n                        mcf.link(t * n + i, (t + 1) * n + neighbor, 1, cost);\n                    }\n                }\n            }\n        }\n        System.out.println(mcf.min_cost_flow(n * T, n * T + 1, k));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022384998737834394, -1.6689286894688848e-06, -3.576278118089249e-07, -0.0023352038115262985, -4.60137271147687e-05, -0.2811603546142578, -0.3869740068912506, -0.00043418517452664673, -7.152555099310121e-07, -0.00020215852418914437, -0.009757207706570625, -1.3589766240329482e-05, -0.004160202573984861, -0.348863810300827, -0.15140601992607117, -1.1444026313256472e-05, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.7881377516459906e-06, 0.0, -1.1920922133867862e-06, -2.3841855067985307e-07, -8.344646857949556e-07, -1.811964830267243e-05, -0.02055930159986019, -3.099436753473128e-06, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -6.9141146923357155e-06, 0.0, 0.0, -1.1920922133867862e-06, 0.0, 0.0, -7.867782187531702e-06,