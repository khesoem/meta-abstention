\n\npublic class Main {\n\n    static final int MAXN = 505;\n    static int n, m, mod;\n    static int[][] c = new int[MAXN][MAXN];\n\n    static class T {\n        int cnt, sum;\n\n        T() {\n            this.cnt = 0;\n            this.sum = 0;\n        }\n\n        T(int x) {\n            this.cnt = x;\n            this.sum = 0;\n        }\n\n        T(int c, int s) {\n            this.cnt = c;\n            this.sum = s;\n        }\n\n        T mul(T t) {\n            int s = mul(this.cnt, t.sum);\n            s = add(s, mul(this.sum, t.cnt));\n            return new T(mul(this.cnt, t.cnt), s);\n        }\n\n        T add(T t) {\n            int c = this.cnt;\n            c = add(c, t.cnt);\n            int s = this.sum;\n            s = add(s, t.sum);\n            return new T(c, s);\n        }\n    }\n\n    static T[] dp = new T[MAXN];\n    static T[][] pdp = new T[MAXN][MAXN];\n\n    static int mul(int a, int b) {\n        return (int) ((long) a * b % mod);\n    }\n\n    static int add(int a, int b) {\n        a += b;\n        if (a >= mod) a -= mod;\n        return a;\n    }\n\n    static boolean read() {\n        Scanner sc = new Scanner(System.in);\n        if (!sc.hasNextInt()) {\n            return false;\n        }\n        n = sc.nextInt();\n        if (!sc.hasNextInt()) {\n            return false;\n        }\n        m = sc.nextInt();\n        if (!sc.hasNextInt()) {\n            return false;\n        }\n        mod = sc.nextInt();\n        return true;\n    }\n\n    static void solve() {\n        // Precompute binomial coefficients\n        for (int i = 0; i <= m; ++i) {\n            c[i][0] = 1;\n            for (int j = 1; j <= i; ++j) {\n                c[i][j] = c[i - 1][j - 1];\n                c[i][j] = add(c[i][j], c[i - 1][j]);\n            }\n        }\n\n        // Initialize dp array\n        for (int i = 0; i <= m; ++i) {\n            dp[i] = new T(0);\n        }\n        dp[0] = new T(1);\n\n        // Compute dp[k]\n        for (int k = 1; k <= m; ++k) {\n            T cur = new T(0);\n            for (int i = 0; i < k; ++i) {\n                T x = dp[i].mul(dp[k - i - 1]);\n                x = x.mul(new T(c[k - 1][i]));\n                for (int j = 0; j < k; ++j) {\n                    T y = x.mul(new T(1 + (j == i ? 1 : 0), Math.abs(i - j)));\n                    cur = cur.add(y);\n                }\n            }\n            dp[k] = cur;\n        }\n\n        // Initialize pdp array\n        for (int i = 0; i <= n; ++i) {\n            for (int j = 0; j <= m; ++j) {\n                pdp[i][j] = new T(0);\n            }\n        }\n        pdp[0][0] = new T(1);\n\n        // Dynamic programming for answer calculation\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j <= m; ++j) {\n                T cur = pdp[i][j];\n                if (cur.cnt == 0 && cur.sum == 0) continue;\n                // Proceed without additional steps\n                pdp[i + 1][j] = pdp[i + 1][j].add(cur);\n                for (int k = 1; j + k <= m && i + k <= n; ++k) {\n                    T toAdd = cur.mul(dp[k]).mul(new T(c[m - j][k]));\n                    int ni = Math.min(n, i + k + 1);\n                    int nj = j + k;\n                    pdp[ni][nj] = pdp[ni][nj].add(toAdd);\n                }\n            }\n        }\n\n        System.out.println(pdp[n][m].sum);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        while (true) {\n            if (!read()) break;\n            solve();\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.01445893757045269, -0.0002880337997339666, -2.1008713702030946e-06, -0.00016277639952022582, -6.749814019713085e-06, 0.0, -0.014271745458245277, -0.26577267050743103, -0.00020830852736253291, -4.584861744660884e-05, -0.007108897902071476, -0.004668049514293671, -0.00014168102643452585, -3.128163257315464e-07, -0.008669291622936726, -2.1269783973693