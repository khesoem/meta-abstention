{\n                    inq[e.to] = true;\n                    q.push(e.to);\n                }\n            }\n        }\n    }\n    return d[t] < INF;\n}\n\nint minCost(int src, int dst) {\n    int cost = 0;\n    while (bfsShortest(src, dst)) {\n        int f = INF;\n        for (int v = dst; v != src; v = p[v]) {\n            f = min(f, g[p[v]][pe[v]].cap);\n        }\n        cost += d[dst] * f;\n        for (int v = dst; v != src; v = p[v]) {\n            auto& e = g[p[v]][pe[v]];\n            e.cap -= f;\n            g[v][e.rev].cap += f;\n        }\n    }\n    return cost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int source = 0;\n    int target = n * MAX_T + 1;\n    g.resize(target + 1);\n    d.resize(target + 1);\n    p.resize(target + 1);\n    pe.resize(target + 1);\n    \n    // Connect all nodes' last time layer to sink\n    for (int i = 1; i <= n; ++i) {\n        link((i - 1) * MAX_T + MAX_T, target, 100, 0);\n    }\n    \n    // Connect source to initial positions\n    for (int i = 0; i < k; ++i) {\n        int v;\n        cin >> v;\n        link(source, (v - 1) * MAX_T + 1, 1, 0);\n    }\n    \n    // Time progression edges\n    for (int i = 1; i <= n; ++i) {\n        for (int t = 1; t < MAX_T; ++t) {\n            link((i - 1) * MAX_T + t, (i - 1) * MAX_T + t + 1, 100, c);\n        }\n    }\n    \n    // Bidirectional edges with capacity splitting\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        for (int t = 1; t < MAX_T; ++t) {\n            for (int j = 1; j <= 20; ++j) {\n                int cost = c + (j * j - (j - 1) * (j - 1)) * d;\n                link((u - 1) * MAX_T + t, (v - 1) * MAX_T + t + 1, 1, cost);\n                link((v - 1) * MAX_T + t, (u - 1) * MAX_T + t + 1, 1, cost);\n            }\n        }\n    }\n    \n    cout << minCost(source, target) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 0x3f3f3f3f\nMOD = 1000000007\nMAX_T = 100\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d_val = int(data[idx]); idx += 1\n    \n    source = 0\n    target = n * MAX_T + 1\n    \n    g = [[] for _ in range(target + 1)]\n    d = [INF] * (target + 1)\n    p = [0] * (target + 1)\n    pe = [0] * (target + 1)\n    \n    def link(u, v, cap, cost):\n        g[u].append(Edge(v, cap, cost, len(g[v])))\n        g[v].append(Edge(u, 0, -cost, len(g[u]) - 1))\n    \n    # Connect all nodes' last time layer to sink\n    for i in range(1, n + 1):\n        link((i - 1) * MAX_T + MAX_T, target, 100, 0)\n    \n    # Connect source to initial positions\n    for _ in range(k):\n        v = int(data[idx]); idx += 1\n        link(source, (v - 1) * MAX_T + 1, 1, 0)\n    \n    # Time progression edges\n    for i in range(1, n + 1):\n        for t in range(1, MAX_T):\n            link((i - 1) * MAX_T + t, (i - 1) * MAX_T + t + 1, 100, c)\n    \n    # Bidirectional edges with capacity splitting\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for t in range(1, MAX_T):\n            for j in range(1, 21):\n                cost = c + (j * j - (j - 1) * (j - 1)) * d_val\n                link((u - 1) * MAX_T + t, (v - 1) * MAX_T + t + 1, 1, cost)\n                link((v - 1) * MAX_T + t, (u - 1) * MAX_T + t + 1, 1, cost)\n    \n    def bfs_shortest(s, t):\n        for i in range(len(d)):\n            d[i] = INF\n        q = deque()\n        inq = [False] * len(g)\n        d[s] = 0\n        q.append(s)\n        inq[s] = True\n        \n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for i in range(len(g[u])):\n                e = g[u][i]\n                if e.cap > 0 and d[e.to] > d[u] + e.cost:\n                    d[e.to] = d[u] + e.cost\n                    p[e.to] = u\n                    pe[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n        return d[t] < INF\n    \n    def min_cost(src, dst):\n        cost = 0\n        while bfs_shortest(src, dst):\n            f = INF\n            v = dst\n            while v != src:\n                f = min(f, g[p[v]][pe[v]].cap)\n                v = p[v]\n            cost += d[dst] * f\n            v = dst\n            while v != src:\n                e = g[p[v]][pe[v]]\n                e.cap -= f\n                g[v][e.rev].cap += f\n                v = p[v]\n        return cost\n    \n    print(min_cost(source, target))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021586472576018423, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.00619503203779459, -0.0015938685974106193, -8.344646857949556e-07, -0.0009152276325039566, -0.0003401654539629817, -9.536738616588991e-07, -0.00014757021563127637, -0.0027435303200036287, -0.03457288071513176, -9.536738616588991e-07, -0.0007163104019127786, -2.7894584491150454e-05, -1.0728830375228426e-06, 0.0, -8.106198947643861e-06, 0.0, -1.823885577323381e-05, -8.344646857949556e-07, -3.576278118089249e-07, 0.0, 0.0, -3.099436753473128e-06, -0.004635659046471119, 0.0, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -8.344646857949556e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, 0.0, -4.76837044516