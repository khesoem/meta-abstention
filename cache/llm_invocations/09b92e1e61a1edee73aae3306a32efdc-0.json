(mask & (1 << row))\n                    prob = mul(prob, a[row][col]);\n                else\n                    prob = mul(prob, sub(1, a[row][col]));\n            }\n            for (auto &p : cur) {\n                vector<int> tmp;\n                for (int m : p.first) {\n                    int diff = (~m) & mask;\n                    // iterate over all masks that are m plus exactly one bit from diff\n                    for (int bit = 1; bit < (1 << n); bit <<= 1) {\n                        if (diff & bit) {\n                            tmp.push_back(m | bit);\n                        }\n                    }\n                }\n                if (tmp.empty()) continue;\n                sort(tmp.begin(), tmp.end());\n                tmp.erase(unique(tmp.begin(), tmp.end()), tmp.end());\n                nxt.push_back({tmp, mul(p.second, prob)});\n            }\n        }\n        sort(nxt.begin(), nxt.end());\n        cur.clear();\n        int i = 0;\n        while (i < (int)nxt.size()) {\n            int j = i;\n            int sum = 0;\n            while (j < (int)nxt.size() && nxt[j].first == nxt[i].first) {\n                sum = add(sum, nxt[j].second);\n                ++j;\n            }\n            cur.push_back({nxt[i].first, sum});\n            i = j;\n        }\n    }\n\n    int ans = 0;\n    for (auto &p : cur)\n        ans = add(ans, p.second);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 10**9 + 7\n\ndef add(x, y):\n    x += y\n    return x - MOD if x >= MOD else x\n\ndef sub(x, y):\n    x -= y\n    return x + MOD if x < 0 else x\n\ndef mul(x, y):\n    return (x * y) % MOD\n\ndef power(x, n):\n    if n == 0:\n        return 1\n    y = power(x, n // 2)\n    y = mul(y, y)\n    return mul(y, x) if n & 1 else y\n\ndef rev(x):\n    return power(x, MOD - 2)\n\ndef divv(x, y):\n    return mul(x, rev(y))\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    n = data[0]\n    idx = 1\n    a = [[0]*n for _ in range(n)]\n    inv100 = rev(100)\n    for i in range(n):\n        for j in range(n):\n            a[i][j] = mul(data[idx], inv100)\n            idx += 1\n\n    cur = [([0], 1)]  # list of (list of masks, probability)\n\n    for col in range(n):\n        nxt = []\n        for mask in range(1 << n):\n            prob = 1\n            for row in range(n):\n                if mask & (1 << row):\n                    prob = mul(prob, a[row][col])\n                else:\n                    prob = mul(prob, sub(1, a[row][col]))\n            for p in cur:\n                tmp = []\n                for m in p[0]:\n                    diff = mask & (~m)\n                    bit = 1\n                    while bit < (1 << n):\n                        if diff & bit:\n                            tmp.append(m | bit)\n                        bit <<= 1\n                if not tmp:\n                    continue\n                tmp = sorted(set(tmp))\n                nxt.append((tmp, mul(p[1], prob)))\n\n        nxt.sort(key=lambda x: x[0])\n        cur = []\n        i = 0\n        while i < len(nxt):\n            j = i\n            s = 0\n            while j < len(nxt) and nxt[j][0] == nxt[i][0]:\n                s = add(s, nxt[j][1])\n                j += 1\n            cur.append((nxt[i][0], s))\n            i = j\n\n    ans = 0\n    for p in cur:\n        ans = add(ans, p[1])\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0007746794726699591, -1.5616295058862306e-05, 0.0, -1.1920928244535389e-07, -0.0004532501916401088, -0.010807906277477741, 0.0, -0.001931350794620812, -5.960462772236497e-07, -1.1920928244535389e-07, -1.168244216387393e-05, -0.029870174825191498, -0.038043707609176636, 0.0, -