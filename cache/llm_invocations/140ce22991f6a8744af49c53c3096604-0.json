{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdio>\n#include <utility>\n\nusing ll = long long;\nusing pii = std::pair<int, int>;\nusing vi = std::vector<int>;\nusing vvc = std::vector<std::vector<char>>;\n\nconst int MOD = 1000000007;\n\nint add(int x, int y) {\n    x += y;\n    if (x >= MOD) x -= MOD;\n    return x;\n}\n\nint subtract(int x, int y) {\n    x -= y;\n    if (x < 0) x += MOD;\n    return x;\n}\n\nint multiply(int x, int y) {\n    return static_cast<int>(1LL * x * y % MOD);\n}\n\nint mod_exp(int base, int exp) {\n    int result = 1;\n    while (exp) {\n        if (exp & 1) result = multiply(result, base);\n        base = multiply(base, base);\n        exp >>= 1;\n    }\n    return result;\n}\n\nint mod_inverse(int a) {\n    return mod_exp(a, MOD - 2);\n}\n\nint divide_mod(int a, int b) {\n    return multiply(a, mod_inverse(b));\n}\n\nint main() {\n#ifdef LOCAL\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    scanf(\"%d\", &n);\n\n    std::vector<std::vector<int>> grid(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &grid[i][j]);\n            grid[i][j] = divide_mod(grid[i][j], 100);\n        }\n\n    std::vector<std::pair<std::vector<char>, int>> states;\n    states.reserve(1024);\n    states.emplace_back(std::vector<char>{0}, 1);\n\n    for (int col = 0; col < n; ++col) {\n        std::vector<std::pair<std::vector<char>, int>> next_states;\n        next_states.reserve(4096);\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prob = 1;\n            for (int j = 0; j < n; ++j) {\n                if (mask & (1 << j))\n                    prob = multiply(prob, grid[j][col]);\n                else\n                    prob = multiply(prob, subtract(1, grid[j][col]));\n            }\n\n            for (const auto& [old_masks, coeff] : states) {\n                std::vector<char> new_masks;\n                new_masks.reserve(old_masks.size() * __builtin_popcount(mask));\n\n                for (char b : old_masks) {\n                    int remaining = mask ^ (b & mask);\n                    while (remaining) {\n                        int bit = remaining & -remaining;\n                        new_masks.push_back(b | bit);\n                        remaining ^= bit;\n                    }\n                }\n\n                if (new_masks.empty()) continue;\n\n                std::sort(new_masks.begin(), new_masks.end());\n                new_masks.erase(std::unique(new_masks.begin(), new_masks.end()), new_masks.end());\n                next_states.emplace_back(std::move(new_masks), multiply(coeff, prob));\n            }\n        }\n\n        std::sort(next_states.begin(), next_states.end(),\n            [](const auto& a, const auto& b) {\n                return a.first < b.first;\n            });\n\n        states.clear();\n        int idx = 0;\n        while (idx < (int)next_states.size()) {\n            int j = idx;\n            int sum_coeff = 0;\n            auto& base = next_states[idx].first;\n            while (j < (int)next_states.size() && next_states[j].first == base)\n                sum_coeff = add(sum_coeff, next_states[j++].second);\n            states.emplace_back(base, sum_coeff);\n            idx = j;\n        }\n    }\n\n    int result = 0;\n    for (const auto& [_, coeff] : states)\n        result = add(result, coeff);\n    printf(\"%d\\n\", result);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n\n    static int add(int x, int y) {\n        x += y;\n        if (x >= MOD) x -= MOD;\n        return x;\n    }\n\n    static int subtract(int x, int y) {\n        x -= y;\n        if (x < 0) x += MOD;\n        return x;\n    }\n\n    static int multiply(int x, int y) {\n        return (int) ((1L * x * y) % MOD);\n    }\n\n    static int modExp(int base, int exp) {\n        int result = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = multiply(result, base);\n            }\n            base = multiply(base, base);\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    static int modInverse(int a) {\n        return modExp(a, MOD - 2);\n    }\n\n    static int divideMod(int a, int b) {\n        return multiply(a, modInverse(b));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(new OutputStreamWriter(System.out));\n\n        int n = Integer.parseInt(br.readLine());\n        int[][] grid = new int[n][n];\n        \n        for (int i = 0; i < n; i++) {\n            String[] line = br.readLine().split(\"\\\\s+\");\n            for (int j = 0; j < n; j++) {\n                grid[i][j] = Integer.parseInt(line[j]);\n                grid[i][j] = divideMod(grid[i][j], 100);\n            }\n        }\n\n        List<State> states = new ArrayList<>();\n        states.add(new State(new byte[]{0}, 1));\n\n        for (int col = 0; col < n; col++) {\n            List<State> nextStates = new ArrayList<>();\n\n            for (int mask = 0; mask < (1 << n); mask++) {\n                int prob = 1;\n                for (int j = 0; j < n; j++) {\n                    if ((mask & (1 << j)) != 0) {\n                        prob = multiply(prob, grid[j][col]);\n                    } else {\n                        prob = multiply(prob, subtract(1, grid[j][col]));\n                    }\n                }\n\n                for (State state : states) {\n                    byte[] oldMasks = state.masks;\n                    List<Byte> newMasksList = new ArrayList<>();\n\n                    for (byte b : oldMasks) {\n                        int remaining = mask ^ (b & mask);\n                        while (remaining != 0) {\n                            int bit = remaining & -remaining;\n                            newMasksList.add((byte) (b | bit));\n                            remaining ^= bit;\n                        }\n                    }\n\n                    if (newMasksList.isEmpty()) continue;\n\n                    byte[] newMasks = new byte[newMasksList.size()];\n                    for (int i = 0; i < newMasksList.size(); i++) {\n                        newMasks[i] = newMasksList.get(i);\n                    }\n\n                    Arrays.sort(newMasks);\n                    int uniqueCount = 0;\n                    for (int i = 0; i < newMasks.length; i++) {\n                        if (i == 0 || newMasks[i] != newMasks[i - 1]) {\n                            newMasks[uniqueCount++] = newMasks[i];\n                        }\n                    }\n                    \n                    byte[] uniqueMasks = new byte[uniqueCount];\n                    System.arraycopy(newMasks, 0, uniqueMasks, 0, uniqueCount);\n\n                    int coeff = multiply(state.coeff, prob);\n                    nextStates.add(new State(uniqueMasks, coeff));\n                }\n            }\n\n            nextStates.sort((a, b) -> {\n                if (a.masks.length != b.masks.length) {\n                    return Integer.compare(a.masks.length, b.masks.length);\n                }\n                for (int i = 0; i < a.masks.length; i++) {\n                    if (a.masks[i] != b.masks[i]) {\n                        return Integer.compare(a.masks[i] & 0xFF, b.masks[i] & 0xFF);\n                    }\n                }\n                return 0;\n            });\n\n            states.clear();\n            int idx = 0;\n            while (idx < nextStates.size()) {\n                int j = idx;\n                int sumCoeff = 0;\n                byte[] base = nextStates.get(idx).masks;\n                while (j < nextStates.size() && \n                       Arrays.equals(nextStates.get(j).masks, base)) {\n                    sumCoeff = add(sumCoeff, nextStates.get(j).coeff);\n                    j++;\n                }\n                states.add(new State(base, sumCoeff));\n                idx = j;\n            }\n        }\n\n        int result = 0;\n        for (State state : states) {\n            result = add(result, state.coeff);\n        }\n        pw.println(result);\n        pw.close();\n    }\n\n    static class State {\n        byte[] masks;\n        int coeff;\n\n        State(byte[] masks, int coeff) {\n            this.masks = masks;\n            this.coeff = coeff;\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010489867418073118, -1.7881377516459906e-06, -3.576278118089249e-07, -0.0004528927383944392, -2.288792165927589e-05, -0.029844604432582855, -0.1427086740732193, -0.00016819016309455037, -3.9934315282152966e-05, -0.00011097769311163574, -