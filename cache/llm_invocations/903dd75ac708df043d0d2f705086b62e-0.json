ar >= self.numChars:\n            self.curChar = 0\n            try:\n                self.numChars = self.stream.readinto(self.buf)\n            except Exception:\n                return -1\n            if self.numChars <= 0:\n                return -1\n        return self.buf[self.curChar]\n\n    def skip(self, x):\n        while x > 0:\n            self.read()\n            x -= 1\n\n    def nextInt(self):\n        return int(self.next())\n\n    def nextLong(self):\n        return int(self.next())\n\n    def nextString(self):\n        return self.next()\n\n    def next(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        res = []\n        while not self.isSpaceChar(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def nextLine(self):\n        buf = []\n        c = self.read()\n        while c != ord('\\n') and c != -1:\n            if c != ord('\\r'):\n                buf.append(chr(c))\n            c = self.read()\n        return ''.join(buf)\n\n    def nextDouble(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0.0\n        while not self.isSpaceChar(c) and c != ord('.'):\n            if c == ord('e') or c == ord('E'):\n                return res * (10 ** self.nextInt())\n            if c < ord('0') or c > ord('9'):\n                raise Exception(\"Input mismatch\")\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        if c == ord('.'):\n            c = self.read()\n            m = 1.0\n            while not self.isSpaceChar(c):\n                if c == ord('e') or c == ord('E'):\n                    return res * (10 ** self.nextInt())\n                if c < ord('0') or c > ord('9'):\n                    raise Exception(\"Input mismatch\")\n                m /= 10\n        