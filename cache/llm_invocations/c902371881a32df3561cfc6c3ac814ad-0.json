er or all cards collected)\n            // E[phases] = sum_{k=0}^{n} (product_{i=0}^{k-1} (n-i)/(n+m-i))\n            long totalPhases = 0;\n            long currentProduct = 1;\n            for (int i = 0; i <= n; i++) {\n                totalPhases = arithmetic.add(totalPhases, currentProduct);\n                if (i < n) {\n                    long ratio = arithmetic.mult(n - i, arithmetic.inv(n + m - i));\n                    currentProduct = arithmetic.mult(currentProduct, ratio);\n                }\n            }\n            \n            long result = 0;\n            for (int k = 1; k <= n; k++) {\n                long coefficient = arithmetic.paritySign(k + 1);\n                \n                // Probability that a joker is drawn before collecting all k specific cards\n                // = m / (m + k)\n                long probability = arithmetic.div(m, m + k);\n                \n                long denominator = arithmetic.subtract(1, probability);\n                long phasesPerTrial = arithmetic.inv(denominator);\n                long expected = arithmetic.mult(phasesPerTrial, totalPhases);\n                \n                long combination = arithmetic.ncr(n, k);\n                long contribution = arithmetic.mult(combination, expected);\n                \n                result = arithmetic.add(result, arithmetic.mult(coefficient, contribution));\n            }\n            \n            writer.println(result);\n        } catch (IOException exception) {\n            throw new RuntimeException(exception);\n        }\n    }\n\n    static class Mod998 extends Modulus<Mod998> {\n        @Override\n        public long modulus() {\n            return 998_244_353L;\n        }\n    }\n\n    static abstract class Modulus<M extends Modulus<M>> {\n        private final List<Long> factorialTable = new ArrayList<>();\n        private final List<Long> inverseFactorialTable = new ArrayList<>();\n\n        public abstract long modulus();\n\n        public Modulu