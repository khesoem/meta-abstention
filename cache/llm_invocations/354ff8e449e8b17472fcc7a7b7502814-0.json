, u] = pq.top(); pq.pop();\n            if (d > dist[u]) continue;\n            for (int i = 0; i < adj[u].size(); ++i) {\n                auto &e = adj[u][i];\n                if (e.capacity > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    pq.push({dist[e.to], e.to});\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n    \n    int getMinCost(int s, int t) {\n        int totalFlow = 0, totalCost = 0;\n        while (dijkstra(s, t)) {\n            int flow = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                flow = min(flow, adj[prevv[v]][preve[v]].capacity);\n            }\n            totalFlow += flow;\n            totalCost += dist[t] * flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                auto &e = adj[prevv[v]][preve[v]];\n                e.capacity -= flow;\n                adj[v][e.index].capacity += flow;\n            }\n        }\n        return totalCost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int s = 0, t = n*100 + 1;\n    MinCostFlow mcf(t + 1);\n    \n    // Level 100 to sink\n    for (int i = 1; i <= 100; ++i) {\n        mcf.addEdge(i, t, 100, 0);\n    }\n    \n    // Source to starting positions\n    for (int i = 0; i < k; ++i) {\n        int v;\n        cin >> v;\n        mcf.addEdge(s, (v-1)*100+1, 1, 0);\n    }\n    \n    // Intra-node edges (level j to j+1)\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            mcf.addEdge((i-1)*100+j, (i-1)*100+j+1, 100, c);\n        }\n    }\n    \n    // Inter-node edges\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        \n        for (int j = 1; j < 100; ++j) {\n            int from = (u-1)*100+j;\n            int to = (v-1)*100+j+1;\n            for (int step = 1; step <= 50; ++step) {\n                int cost = c + (step*step - (step-1)*(step-1)) * d;\n                mcf.addEdge(from, to, 1, cost);\n            }\n        }\n        \n        for (int j = 1; j < 100; ++j) {\n            int from = (v-1)*100+j;\n            int to = (u-1)*100+j+1;\n            for (int step = 1; step <= 50; ++step) {\n                int cost = c + (step*step - (step-1)*(step-1)) * d;\n                mcf.addEdge(from, to, 1, cost);\n            }\n        }\n    }\n    \n    cout << mcf.getMinCost(s, t) << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nINF = 0x3f3f3f3f\nMOD = 1000000007\n\nclass Edge:\n    def __init__(self, to, capacity, cost, index):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.index = index\n\nclass MinCostFlow:\n    def __init__(self, n):\n        self.nodes = n\n        self.adj = [[] for _ in range(n)]\n        self.dist = [INF] * n\n        self.prevv = [0] * n\n        self.preve = [0] * n\n    \n    def addEdge(self, u, v, cap, c):\n        self.adj[u].append(Edge(v, cap, c, len(self.adj[v])))\n        self.adj[v].append(Edge(u, 0, -c, len(self.adj[u]) - 1))\n    \n    def dijkstra(self, s, t):\n        self.dist = [INF] * self.nodes\n        pq = []\n        self.dist[s] = 0\n        heapq.heappush(pq, (0, s))\n        \n        while pq:\n            d, u = heapq.heappop(pq)\n            if d > self.dist[u]:\n                continue\n            for i in range(len(self.adj[u])):\n                e = self.adj[u][i]\n                if e.capacity > 0 and self.dist[e.to] > self.dist[u] + e.cost:\n                    self.dist[e.to] = self.dist[u] + e.cost\n                    self.prevv[e.to] = u\n                    self.preve[e.to] = i\n                    heapq.heappush(pq, (self.dist[e.to], e.to))\n        \n        return self.dist[t] < INF\n    \n    def getMinCost(self, s, t):\n        totalFlow = 0\n        totalCost = 0\n        while self.dijkstra(s, t):\n            flow = INF\n            v = t\n            while v != s:\n                flow = min(flow, self.adj[self.prevv[v]][self.preve[v]].capacity)\n                v = self.prevv[v]\n            \n            totalFlow += flow\n            totalCost += self.dist[t] * flow\n            \n            v = t\n            while v != s:\n                e = self.adj[self.prevv[v]][self.preve[v]]\n                e.capacity -= flow\n                self.adj[v][e.index].capacity += flow\n                v = self.prevv[v]\n        \n        return totalCost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    s = 0\n    t = n * 100 + 1\n    mcf = MinCostFlow(t + 1)\n    \n    # Level 100 to sink\n    for i in range(1, 101):\n        mcf.addEdge(i, t, 100, 0)\n    \n    # Source to starting positions\n    for _ in range(k):\n        v = int(data[idx]); idx += 1\n        mcf.addEdge(s, (v-1)*100 + 1, 1, 0)\n    \n    # Intra-node edges (level j to j+1)\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            mcf.addEdge((i-1)*100 + j, (i-1)*100 + j + 1, 100, c)\n    \n    # Inter-node edges\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        \n        for j in range(1, 100):\n            from_node = (u-1)*100 + j\n            to_node = (v-1)*100 + j + 1\n            for step in range(1, 51):\n                cost = c + (step*step - (step-1)*(step-1)) * d\n                mcf.addEdge(from_node, to_node, 1, cost)\n        \n        for j in range(1, 100):\n            from_node = (v-1)*100 + j\n            to_node = (u-1)*100 + j + 1\n            for step in range(1, 51):\n                cost = c + (step*step - (step-1)*(step-1)) * d\n                mcf.addEdge(from_node, to_node, 1, cost)\n    \n    print(mcf.getMinCost(s, t))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020919041708111763, -1.4305104514278355e-06, -1.1920928244535389e-07, -0.00011252723925281316, -0.22562402486801147, -0.04304296150803566, -0.12693393230438232, -0.00018714107864070684, -0.5761284828186035, -0.6228094100952148, -7.152555099310121e-07, -0.00762906763702631, -0.00048792376765049994, -4.172316494077677e-06, 0.0, -1.5020257706055418e-05, 0.0, -1.4305104514278355e-06, -1.0728830375228426e-06, -2.50339189733495e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -0.07053130120038986, -2.2172682292875834e-05, 0.0, -2.3841855067985307e-07, 0.0, -8.344646857949556e-07, -0.00014006110723130405, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -8.141662692651153e-05, -0.0005575056420639157, -4.5536911784438416e-05, -4.768370445162873e-07, -2.3841855067985307e-07, -0.16022491455078125, -1.7881377516459906e-06, -2.50339189733495e-06, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, -1.549708758830093e-05, -0.000990377040579915, -1.7881377516459906e-06, 0.0, -7.152555099310121e-07, -1.1920928244535389e-07, -9.738924563862383e-05, -2.9444261599564925e-05, -7.152531907195225e-06, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -5.960462772236497e-07, -7.152555099310121e-07, 0.0, -7.152555099310121e-07, -6.9141146923357155e-06, 0.0, -5.125986263010418e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -5.960462772236497e-07, -7.271740287251305e-06, 0.0, -1.0728830375228426e-06, -9.536738616588991e-07, -4.768370445162873e-07, -1.9073468138230965e-06, -9.536738616588991e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -