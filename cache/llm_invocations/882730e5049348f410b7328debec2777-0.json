in + \" \" + maxWin);\n\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.14721894264221191, -0.0007163656409829855, -1.2664456789934775e-06, -2.7491250875755213e-05, -4.008129963040119e-06, -1.9361264946837764e-07, -4.842555426876061e-06, -0.8904775381088257, -2.696889623621246e-06, 0.0, -3.128163257315464e-07, 0.0, -0.6358049511909485, -0.14268268644809723, -1.1472419600977446e-06, -3.128163257315464e-07, -0.00010199354437645525, -0.0036022020503878593, -7.588793960167095e-05, -4.320199877838604e-07, 0.0, -7.896309739408025e-07, 0.0, -4.127333340875339e-06, -3.128163257315464e-07, -1.9361264946837764e-07, -0.00014096579980105162, -1.8789383830153383e-05, -1.9361264946837764e-07, -1.1472419600977446e-06, -1.4063091278076172, -1.664371848164592e-05, -1.9361264946837764e-07, 0.0, 0.0, 0.0, -2.929988145828247, -4.320199877838604e-07, -0.0007102862582542002, -3.128163257315464e-07, -7.896309739408025e-07, -3.128163257315464e-07, -0.12693797051906586, -1.0921942703134846e-05, -1.2664456789934775e-06, -1.8097288608551025, -3.128163257315464e-07, -0.009833300486207008, -1.9361264946837764e-07, -3.7697225252486533e-06, -5.512236498361744e-07, -4.246537173457909e-06, -4.36574100604048e-06, -1.9361264946837764e-07, -4.60414821645827e-06, -0.0007110013975761831, -5.512236498361744e-07, -5.0020742492051795e-05, -6.704273118884885e-07, -1.1368842124938965, -0.02324652671813965, -1.9361264946837764e-07, -4.320199877838604e-07, -0.0002613358374219388, -3.128163257315464e-07, 0.0, -1.9361264946837764e-07, -1.9361264946837764e-07, -2.935296834039036e-06, -3.7697225252486533e-06, 0.0, -1.8624639324116288e-06, -9.014684110297821e-06, -1.843177233240567e-05, -2.1008713702030946e-06, -3.128163257315464e-07, -2.935296834039036e-06, 0.0, 0.0, -6.704273118884885e-07, -1.9361264946837764e-07, -1.5048530030981055e-06, -6.511406809295295e-06, 0.0, -1.1279553291387856e-05, -1.9361264946837764e-07, -0.009771435521543026, -4.3201998778