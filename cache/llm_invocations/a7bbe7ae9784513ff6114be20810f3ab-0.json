\n        if (wrongChars.size() == 1) {\n            Char wc = wrongChars.get(0);\n            for (Char c : chars1) {\n                if (c.chr != wc.chr && chars[n - c.idx - 1] != wc.chr) {\n                    return wc.val + c.val;\n                }\n            }\n            return 0;\n        } else if (wrongChars.size() > 1) {\n            Map<Character, Integer> freq = new TreeMap<>();\n            for (Char c : wrongChars) freq.merge(c.chr, 1, Integer::sum);\n            Map.Entry<Character, Integer> max = freq.entrySet().stream().max(Map.Entry.comparingByValue()).get();\n            List<Char> append = new ArrayList<>();\n            while (max.getValue() * 2 > wrongChars.size() + append.size()) {\n                for (Char c : chars1) {\n                    if (c.chr != max.getKey() && chars[n - c.idx - 1] != max.getKey()\n                            && !wrongChars.contains(c) && !append.contains(c)) {\n                        append.add(c);\n                        break;\n                    }\n                }\n            }\n            return wrongChars.stream().mapToInt(c -> c.val).sum() + append.stream().mapToInt(c -> c.val).sum();\n        }\n        return 0;\n    }\n\n    private static void swap(int i) {\n        char t = chars[i]; chars[i] = chars[n - i - 1]; chars[n - i - 1] = t;\n        int v = vals[i]; vals[i] = vals[n - i - 1]; vals[n - i - 1] = v;\n    }\n\n    private static void swap(int i, int j) {\n        char t = chars[i]; chars[i] = chars[j]; chars[j] = t;\n        int v = vals[i]; vals[i] = vals[n - i - 1]; vals[n - i - 1] = v;\n    }\n\n    private static boolean isAntiPalindrome(char[] a) {\n        for (int i = 0; i < a.length / 2; i++) if (a[i] == a[a.length - i - 1]) return false;\n        return true;\n    }\n\n    static class Char {\n        char chr; int val; int idx;\n        Char(char chr, int val, int idx) { this.chr = chr; this.val = val; this.idx = idx; }\n        @Override public String toString() { return \"Char{chr=\" + chr + \", val=\" + val + \", idx=\" + idx + '}'; }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nclass Char:\n    def __init__(self, chr, val, idx):\n        self.chr = chr\n        self.val = val\n        self.idx = idx\n    def __repr__(self):\n        return f\"Char{{chr={self.chr}, val={self.val}, idx={self.idx}}}\"\n\ndef is_anti_palindrome(a):\n    for i in range(len(a)//2):\n        if a[i] == a[-i-1]:\n            return False\n    return True\n\ndef compute_diff(wrong_chars, chars1, chars, n):\n    if is_anti_palindrome(chars):\n        return 0\n    if len(wrong_chars) == 1:\n        wc = wrong_chars[0]\n        for c in chars1:\n            if c.chr != wc.chr and chars[n - c.idx - 1] != wc.chr:\n                return wc.val + c.val\n        return 0\n    elif len(wrong_chars) > 1:\n        freq = {}\n        for c in wrong_chars:\n            freq[c.chr] = freq.get(c.chr, 0) + 1\n        max_key = max(freq, key=freq.get)\n        max_val = freq[max_key]\n        append = []\n        while max_val * 2 > len(wrong_chars) + len(append):\n            for c in chars1:\n                if (c.chr != max_key and chars[n - c.idx - 1] != max_key\n                        and c not in wrong_chars and c not in append):\n                    append.append(c)\n                    break\n        return sum(c.val for c in wrong_chars) + sum(c.val for c in append)\n    return 0\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    chars = list(data[1])\n    vals = list(map(int, data[2:2+n]))\n    # swap pairs where left value > right value\n    for i in range(n // 2):\n        if vals[i] > vals[n - i - 1]:\n            # swap chars and vals\n            chars[i], chars[n - i - 1] = chars[n - i - 1], chars[i]\n            vals[i], vals[n - i - 1] = vals[n - i - 1], vals[i]\n    wrong_chars = []