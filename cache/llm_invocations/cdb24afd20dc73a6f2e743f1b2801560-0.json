cd, ansB = b/curGcd, dif = curDif1;\n    }\n    \n    System.out.println(ansA + \"/\" + ansB);\n    \n    return 0;\n}\n</original_code>\n\n<translated_code>\nimport java.util.Scanner;\nimport java.lang.Math;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        scanner.close();\n\n        long ansA = 0;\n        long ansB = 0;\n        double dif = 1e12;\n        for(long b = 1; b <= n; b++) {\n            long l = 0;\n            long r = 100000;\n            long a = 0;\n            while (l <= r) {\n                long mid = (l + r) / 2;\n                if (mid * y <= x * b)\n                    a = mid;\n                else\n                    l = mid + 1;\n            }\n            l = 0;\n            r = 100000;\n            long aa = 0;\n            long bb = b;\n            while (l <= r) {\n                long mid = (l + r) / 2;\n                if (mid * y < x * b)\n                    l = mid + 1;\n                else\n                    aa = mid;\n            }\n            double curDif2 = Math.abs((double) aa / (double) bb - (double) x / (double) y);\n            double curDif1 = Math.abs((double) a / (double) b - (double) x / (double) y);\n            if (curDif2 + 1e-8 < curDif1)\n                a = aa;\n            long curGcd = gcd(a, b);\n            if (curDif1 < dif) {\n                ansA = a / curGcd;\n                ansB = b / curGcd;\n                dif = curDif1;\n            }\n        }\n        System.out.println(ansA + \"/\" + ansB);\n    }\n\n    public static long gcd(long a, long b) {\n        while (b != 0) {\n            a %= b;\n            long temp = a;\n            a = b;\n            b = temp;\n        }\n        return a;\n    }\n}\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.3158863484859466