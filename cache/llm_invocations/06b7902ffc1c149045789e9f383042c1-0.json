\n\t\t\t\tll cur=q.top();\n\t\t\t\tint d=cur>>32, u=cur;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u])\n\t\t\t\t\tcontinue;\n\t\t\t\tfor(int i=0; i<SZ(adj[u]); ++i) {\n\t\t\t\t\tEdge &e=adj[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif (e.cap<=e.f)\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\tint nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif (prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push(((ll)nprio<<32)+v);\n\t\t\t\t\t\tprevnode[v]=u;\n\t\t\t\t\t\tprevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INT_MAX)\n\t\t\t\tbreak;\n\t\t\tfor(int i=0; i<n; ++i)\n\t\t\t\tpot[i]+=prio[i];\n\t\t\tint df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tEdge &e=adj[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df;\n\t\t\t\tadj[v][e.rev].f-=df;\n\t\t\t\tflowCost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn make_pair(flow, flowCost);\n\t}\n};\n\nint n,m,k,c,d;\n \nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tMCF nt(6+107*n);\n\tfore(_,0,k){\n\t\tint x;\n\t\tscanf(\"%d\",&x);x--;\n\t\tnt.addEdge(0,1+x,1,0);\n\t}\n\tfore(_,0,m){\n\t\tint x,y;\n\t\tscanf(\"%d%d\",&x,&y);x--;y--;\n\t\tfore(i,0,105){\n\t\t\tfore(j,0,51){\n\t\t\t\tnt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n\t\t\t\tnt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n\t\t\t}\n\t\t}\n\t}\n\tfore(i,0,105)fore(j,0,n)nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n\tfore(i,0,105)nt.addEdge(1+i*n,1+105*n,51,0);\n\tauto ans=nt.minCostFlow(0,1+105*n);\n\tprintf(\"%d\\n\",ans.snd);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.u = [0] * n\n        self.v = [0] * n\n        self.prio = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n        self.adj = [[] for _ in range(n)]\n        \n    class Edge:\n        def __init__(self, to, f, cap, cost, rev):\n            self.to = to\n            self.f = f\n            self.cap = cap\n            self.cost = cost\n            self.rev = rev\n\n    def addEdge(self, s, t, cap, cost):\n        a = self.Edge(t, 0, cap, cost, len(self.adj[t]))\n        b = self.Edge(s, 0, 0, -cost, len(self.adj[s]))\n        self.adj[s].append(a)\n        self.adj[t].append(b)\n\n    def minCostFlow(self, s, t):\n        flow = 0\n        flowCost = 0\n        INF = 10**9\n        while True:\n            self.prio = [float('inf')] * self.n\n            self.prio[s] = 0\n            self.curflow = [float('inf')] * self.n\n            q = []\n            heapq.heappush(q, (0, s))\n            while q:\n                d, u = heapq.heappop(q)\n                if d != self.prio[u]:\n                    continue\n                for i, e in enumerate(self.adj[u]):\n                    v = e.to\n                    if e.cap <= e.f:\n                        continue\n                    nprio = self.prio[u] + e.cost + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nprio:\n                        self.prio[v] = nprio\n                        heapq.heappush(q, (nprio, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e.cap - e.f)\n            if self.prio[t] == float('inf'):\n                break\n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            v = t\n            while v != s:\n                u = self.prevnode[v]\n                e = self.adj[u][self.prevedge[v]]\n                e.f += df\n                self.adj[v][e.rev].f -= df\n                flowCost += df * e.cost\n                v = u\n        return flow, flowCost\n\ndef main():\n    input = sys.stdin.read().strip().split()\n    n, m, k, c, d = map(int, input[0:5])\n    data = input[5:]\n    nt = MCF(6 + 107 * n)\n    idx = 0\n    for _ in range(k):\n        x = int(data[idx]) - 1\n        idx += 1\n        nt.addEdge(0, 1 + x, 1, 0)\n    for _ in range(m):\n        x = int(data[idx]) - 1\n        y = int(data[idx + 1]) - 1\n        idx += 2\n        for i in range(105):\n            for j in range(51):\n                nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1))\n                nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1))\n    for i in range(105):\n        for j in range(n):\n            nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c)\n    for i in range(105):\n        nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0)\n    ans = nt.minCostFlow(0, 1 + 105 * n)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.03402381390333176, -0.0004207826859783381, -6.704273118884885e-07, -1.27099974633893e-05, -0.16885320842266083, -0.06994210183620453, -5.204720582696609e-05, -0.0002922022540587932, -0.0015692608430981636, -1.9361264946837764e-07, -0.0018633106956258416, -0.3678343892097473, -0.0006065295310690999, -1.2664456789934775e-06, -4.246537173457909e-06, -1.4259644558478612e-05, -0.010105940513312817, -9.088346359931165e-07, 0.0, 0.0, 0.0, -7.028536492725834e-05, -1.981667537620524e-06, -1.4498052223643754e-05, 0.0, -9.491498531133402e-06, -3.531315314830863e-06, -8.494741632603109e-05, -1.8624639324116288e-06, -1.4259644558478612e-05, 0.0, -1.981667537620524e-06, -0.003769327886402607, -0.00020902375399600714, -3.128163257315464e-07, -1.2664456789934775e-06, -0.1809723973274231, -1.9361264946837764e-07, -2.45848218582978e-06, -6.511406809295295e-06, 0.0, 0.0, -3.128163257315464e-07, -4.4849443838757e-06, -1.9361264946837764e-07, 0.0, -1.8624639324116288e-06, -1.7