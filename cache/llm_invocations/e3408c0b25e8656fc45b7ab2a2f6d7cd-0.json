sk] + inverse_factorial[bitmask ^ submask] * evaluate(level + 1, submask)) % P;\n    }\n    \n    dp_table[level][bitmask] = (dp_table[level][bitmask] + inverse_factorial[bitmask] * evaluate(level + 1, 0)) % P;\n    return dp_table[level][bitmask];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> P;\n    ll total = mod_pow(k, n);\n    \n    if (n & 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    factorial[0] = 1;\n    for (int i = 1; i <= n; ++i) factorial[i] = factorial[i-1] * i % P;\n    \n    inverse_factorial[n] = mod_pow(factorial[n], P - 2);\n    for (int i = n; i > 0; --i) inverse_factorial[i-1] = inverse_factorial[i] * i % P;\n    \n    memset(dp_table, -1, sizeof(dp_table));\n    ll invalid = evaluate(0, n);\n    ll result = (total - invalid + P) % P;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_pow(base, exp, mod):\n    res = 1\n    base %= mod\n    while exp:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef get_lowest_one(x):\n    return x & -x\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    P = int(data[2])\n    \n    total = mod_pow(k, n, P)\n    \n    if n & 1:\n        print(total)\n        return\n    \n    # Precompute factorials and inverse factorials\n    factorial = [1] * (n + 1)\n    for i in range(1, n + 1):\n        factorial[i] = factorial[i-1] * i % P\n    \n    inverse_factorial = [1] * (n + 1)\n    inverse_factorial[n] = mod_pow(factorial[n], P - 2, P)\n    for i in range(n, 0, -1):\n        inverse_factorial[i-1] = inverse_factorial[i] * i % P\n    \n    # Initialize dp_