00000];\n        private int ptr = 0;\n        private int len = 0;\n\n        public FastReader(InputStream stream) {\n            this.stream = stream;\n        }\n\n        private int read() throws IOException {\n            if (ptr >= len) {\n                len = stream.read(buffer);\n                ptr = 0;\n                if (len <= 0) return -1;\n            }\n            return buffer[ptr++];\n        }\n\n        public long readLong() throws IOException {\n            int c = read();\n            while (c <= 32 && c != -1) c = read();\n            if (c == -1) return -1;\n            long x = 0;\n            boolean minus = false;\n            if (c == '-') {\n                minus = true;\n                c = read();\n            }\n            while (c >= '0' && c <= '9') {\n                x = x * 10 + (c - '0');\n                c = read();\n            }\n            return minus ? -x : x;\n        }\n    }\n\n    private static void print(long x) {\n        if (x < 0) {\n            System.out.print('-');\n            print(-x);\n        } else {\n            if (x > 9) print(x / 10);\n            System.out.print((char)('0' + (x % 10)));\n        }\n    }\n\n    private static void println(long x) {\n        print(x);\n        System.out.println();\n    }\n\n    private static boolean is_boundary(long x) {\n        return x * 1000000 + 999999 <= n && x * 10000000 > n;\n    }\n\n    private static void build_table(int depth, long num) {\n        if (depth == 7) return;\n        long val = (counter1 - num % MOD1 + MOD1) % MOD1;\n        data[depth].add(val);\n        counter1++;\n        for (int digit = 0; digit <= 9; ++digit) {\n            build_table(depth + 1, num * 10 + digit);\n        }\n    }\n\n    private static void traverse(int depth, long num) {\n        if (num > n) return;\n        if (is_boundary(num)) {\n            for (int d = 0; d <= 6; ++d) {\n                long need = ((counter2 + 1 - num * p10[d]) % MOD1 + MOD1) % MOD1;\