 cnt, vis, dp\n    n, t = map(int, sys.stdin.readline().split())\n    sci = [[0] * (n + 1) for _ in range(n + 1)]\n    cap = [[0] * (n + 1) for _ in range(n + 1)]\n    maze = [[[0] * (n + 1) for _ in range(n + 1)] for _ in range(t + 1)]\n    st = N - 1\n    ed = st - 1\n\n    for i in range(1, n + 1):\n        line = sys.stdin.readline().strip()\n        for j in range(1, n + 1):\n            ch = line[j - 1]\n            if ch.isdigit():\n                sci[i][j] = int(ch)\n            elif ch == 'Y':\n                maze[0][i][j] = 1\n            elif ch == 'Z':\n                maze[0][i][j] = 2\n\n    for i in range(1, n + 1):\n        line = sys.stdin.readline().strip()\n        for j in range(1, n + 1):\n            ch = line[j - 1]\n            if ch.isdigit():\n                cap[i][j] = int(ch)\n\n    head = [-1] * N\n    cnt = 0\n    edge = []\n\n    def add_edge(u, v, w):\n        nonlocal cnt\n        edge.append([v, w, head[u]])\n        head[u] = cnt\n        cnt += 1\n        edge.append([u, 0, head[v]])\n        head[v] = cnt\n        cnt += 1\n\n    now = [0] * N\n    d = [0] * N\n\n    def bfs(s, t):\n        nonlocal d, now\n        d = [0] * N\n        q = deque()\n        q.append(s)\n        now[s] = head[s]\n        d[s] = 1\n        while q:\n            u = q.popleft()\n            i = head[u]\n            while i != -1:\n                v = edge[i][0]\n                w = edge[i][1]\n                if d[v] == 0 and w:\n                    d[v] = d[u] + 1\n                    now[v] = head[v]\n                    q.append(v)\n                    if v == t:\n                        return True\n                i = edge[i][2]\n        return False\n\n    def dinic(x, t, flow):\n        if x == t:\n            return flow\n        rest = flow\n        i = now[x]\n        while i != -1 and rest:\n            v = edge[i][0]\n            w = edge[i][1]\n            if w and d[v] == d[x] + 1:\n                k = dinic(v, t, min(rest, w))\n                if k == 0:\n                    d[v] = 0\n                edge[i][1] -= k\n                edge[i ^ 1][1] += k\n                rest -= k\n            i = edge[i][2]\n        now[x] = i\n        return flow - rest\n\n    def flow(s, t):\n        ans = 0\n        while bfs(s, t):\n            while True:\n                push = dinic(s, t, INF)\n                if push == 0:\n                    break\n                ans += push\n        return ans\n\n    def get_id(x, y, k):\n        return (x - 1) * n + y + k * n * n\n\n    vis = [[False] * (n + 1) for _ in range(n + 1)]\n    dp = [[[[[False] * (n + 1) for _ in range(n + 1)] for _ in range(n + 1)] for _ in range(n + 1)] for _ in range(t + 1)]\n\n    def dfs(x, y, xx, yy, step):\n        vis[xx][yy] = True\n        dp[step][x][y][xx][yy] = True\n        if step >= t or maze[step][xx][yy]:\n            return\n        for k in range(4):\n            nx = xx + b[k][0]\n            ny = yy + b[k][1]\n            if nx <= 0 or ny <= 0 or nx > n or ny > n:\n                continue\n            if vis[nx][ny]:\n                continue\n            if maze[step][nx][ny]:\n                continue\n            dfs(x, y, nx, ny, step + 1)\n\n    def init():\n        for time in range(1, t + 1):\n            for x in range(1, n + 1):\n                for y in range(1, n + 1):\n                    if maze[time - 1][x][y]:\n                        maze[time][x][y] = maze[time - 1][x][y]\n                    else:\n                        for k in range(4):\n                            xx = x + b[k][0]\n                            yy = y + b[k][1]\n                            if xx <= 0 or yy <= 0 or xx > n or yy > n:\n                                continue\n                            if maze[time - 1][xx][yy] == 2:\n                                maze[time][x][y] = 2\n        for i in range(1, n + 1):\n            for j in range(1, n + 1):\n                if sci[i][j]:\n                    for xi in range(1, n + 1):\n                        for xj in range(1, n + 1):\n                            vis[xi][xj] = False\n                    dfs(i, j, i, j, 0)\n        for i in range(1, t + 1):\n            for x in range(1, n + 1):\n                for y in range(1, n + 1):\n                    for xx in range(1, n + 1):\n                        for yy in range(1, n + 1):\n                            dp[i][x][y][xx][yy] = dp[i][x][y][xx][yy] or dp[i - 1][x][y][xx][yy]\n\n    init()\n\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if sci[i][j]:\n                add_edge(st, get_id(i, j, 0), sci[i][j])\n            if cap[i][j]:\n                add_edge(get_id(i, j, 1), ed, cap[i][j])\n\n    for x in range(1, n + 1):\n        for y in range(1, n + 1):\n            for xx in range(1, n + 1):\n                for yy in range(1, n + 1):\n                    if sci[x][y] and cap[xx][yy] and dp[t][x][y][xx][yy]:\n                        add_edge(get_id(x, y, 0), get_id(xx, yy, 1), INF)\n\n    print(flow(st, ed))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.1695856e-05, 0.0, -7.152555e-07, -0.00065102836, -0.038758747, -0.00016950125, -0.06237426, -0.059940998, -0.00029142425, -3.576278e-07, -7.915183e-05, -0.02401944, -0.8919202, -2.3126335e-05, -0.0026956196, -0.2015833, -1.1920922e-06, -1.1920922e-06, -0.0005535739, -4.7683704e-07, -2.3841855e-07, -1.1920928e-07, 0.0, -8.821448e-06, 0.0, -0.048996955, -0.0018623404, -7.033101e-05, -1.7881378e-06, -0.0003456472, -0.4761143, -1.0205045, -3.2066786e-05, -0.08185719, -4.5417706e-05, -3.576278e-07, -0.38688236, -1.9073468e-06, -3.4570635e-06, -1.1920928e-07, -2.264974e-06, -2.9802277e-06, -3.81469e-06, -4.7683704e-07, -1.1920928e-07, -5.4836123e-06, -2.3841855e-07, 0.0, -2.8610189e-06, -4.7683704e-07, 0.0, -4.7683704e-07, -1.1920928e-07, -4.7683704e-07, -2.7418098e-06, -3.576278e-07, -0.006258295, -0.32885656, -0.3867992, -