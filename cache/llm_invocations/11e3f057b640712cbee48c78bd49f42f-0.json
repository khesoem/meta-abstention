{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<queue>\n#define N 100010\nusing namespace std;\ntypedef int typ;\n#define M 1000010\n#define inf 1000000000\n#define winf 1000000000\nstruct road{\n    int nxt,to,f;\n    typ w;\n}r[M<<1];\nint head[N],cnt=1,all;\nvoid add(int u,int v,int f,typ w)\n{\n    r[++cnt]=(road){head[u],v,f,w};head[u]=cnt;\n    r[++cnt]=(road){head[v],u,0,-w};head[v]=cnt;\n}\nnamespace min_cost_flow{\n    int cur[N];\n    bool vis[N];\n    struct node{\n        int u;typ v;\n        node(int U=0,typ V=0):u(U),v(V){}\n        bool operator <(const node a)const{return v>a.v;}\n    };\n    priority_queue<node>q;\n    typ dis[N],tag[N];\n    bool dij(int s,int t)\n    {\n        for(int i=1;i<=all;i++) dis[i]=winf,cur[i]=head[i];\n        dis[t]=0;q.push(node(t,0));\n        while(!q.empty())\n        {\n            int u=q.top().u;q.pop();\n            if(vis[u]) continue;\n            vis[u]=true;\n            for(int i=head[u];i;i=r[i].nxt)\n            {\n                int v=r[i].to,w=tag[u]+r[i^1].w-tag[v];\n                if(r[i^1].f && dis[u]+w<dis[v]) dis[v]=dis[u]+w,q.push(node(v,dis[v]));\n            }\n        }\n        for(int i=1;i<=all;i++) tag[i]=min(tag[i]+dis[i],winf);\n        if(!vis[s]) return false;\n        for(int i=1;i<=all;i++) vis[i]=false;\n        return true;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && tag[v]+r[i].w==tag[u] && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(dij(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*tag[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\nsys.setrecursionlimit(10**6)\n\nclass MinCostFlow:\n    def __init__(self):\n        self.inf = int(1e10)\n        self.nxt = 0\n        self.to = 0\n        self.f = 0\n        self.w = 0\n        self.r = []\n        self.head = [0 for _ in range(10000010)]\n        self.cnt = 1\n        self.all = 0\n\n    def add(self, u, v, f, w):\n        self.r.append({'nxt': self.head[u], 'to': v, 'f': f, 'w': w})\n        self.head[u] = self.cnt\n        self.r.append({'nxt': self.head[v], 'to': u, 'f': 0, '-w': -w})\n        self.head[v] = self.cnt\n        self.cnt += 2\n\n    def dij(self, s, t):\n        for i in range(1, self.all + 1):\n            self.dis[i] = self.inf\n            self.cur[i] = self.head[i]\n        self.dis[t] = 0\n        self.q = []\n        heapq.heappush(self.q, (t, 0))\n        while self.q:\n            u = self.q[0][0]\n            self.q.pop(0)\n            if self.vis[u]:\n                continue\n            self.vis[u] = True\n            for i in self.head[u]:\n                v = self.r[i]['to']\n                w = self.tag[u] + self.r[i ^ 1]['w'] - self.tag[v]\n                if self.r[i ^ 1]['f'] and self.dis[u] + w < self.dis[v]:\n                    self.dis[v] = self.dis[u] + w\n                    heapq.heappush(self.q, (v, self.dis[v]))\n        for i in range(1, self.all + 1):\n            self.tag[i] = min(self.tag[i] + self.dis[i], self.inf)\n        if not self.vis[s]:\n            return False\n        for i in range(1, self.all + 1):\n            self.vis[i] = False\n        return True\n\n    def dfs(self, u, t, fl):\n        if u == t or not fl:\n            return fl\n        self.vis[u] = True\n        res = 0\n        for i in self.cur[u]:\n            v = self.r[i]['to']\n            if self.r[i]['f'] and not self.vis[v] and self.tag[v] + self.r[i]['w'] == self.tag[u]:\n                f = self.dfs(v, t, min(fl, self.r[i]['f']))\n                if f:\n                    self.r[i]['f'] -= f\n                    self.r[i ^ 1]['f'] += f\n                    res += f\n                    fl -= f\n                    if not fl:\n                        break\n        self.vis[u] = False\n        return res\n\n    def work(self, s, t):\n        while self.dij(s, t):\n            w = self.dfs(s, t, self.inf)\n            self.maxf += w\n            self.minw += w * self.tag[s]\n\ndef read_int():\n    return int(input())\n\ndef read_ints():\n    return list(map(int, input().strip('\\n').split()))\n\ndef read_string():\n    return input()\n\ndef work(k, n, c, d, m, ss, tt):\n    mf = MinCostFlow()\n    mf.add(ss, mf.id(0, ss), 1, 0)\n    for _ in range(n):\n        for _ in range(k):\n            mf.add(mf.id(1, _+1), mf.id(2, _+1), 1, d*(2 *_+1))\n        mf.add(mf.id(1, n + 1), mf.id(2, n + 1), mf.inf, 0)\n    mf.add(mf.id(1, n + 2), tt, mf.inf, c * (k + 1))\n    for _ in range(1, n + 1):\n        mf.add(mf.id(k + 2, _), mf.id(1, 0), 1, 0)\n    mf.all += n + 1\n    for _ in range(1, n + 1):\n        for _2 in range(k):\n            mf.add(mf.id(k + 2, _), mf.id(1, _2+1), 1, d*(2 *_+1))\n        for _2 in range(1, k + 1):\n            mf.add(mf.id(k + 2, _), mf.id(1, _2+1), 1, 0)\n    for _ in range(1, k + 1):\n        mf.add(mf.id(k + 2, 0), mf.id(1, _), 1, 0)\n    mf.all += n + 1\n    return mf\n\nn, m, k, c, d = read_ints()\nmf = MinCostFlow()\nmf.dis = [0 for _ in range(mf.cnt + 10)]\nmf.tag = [0 for _ in range(mf.cnt + 10)]\nmf.vis = [False for _ in range(mf.cnt + 10)]\nmf.cur = [0 for _ in range(mf.cnt + 10)]\nmf.cg = [[] for _ in range(mf.cnt + 5)]\nfor _ in range(1, k + 1):\n    x = read_int()\n    mf.add(mf.id(0, x), mf.id(1, 0), 1, 0)\nfor _ in range(1, m + 1):\n    u, v = read_ints()\n    mf.cg[u].append(v)\n    mf.cg[v].append(u)\nmf.add(mf.id(0, 0), mf.id(1, 0), mf.inf, 0)\nfor i in range(0, n + k + 2):\n    mf.work(i)\nprint(mf.minw)\n</translated_code>\n<confidence>\n0.92\n</confidence>", "token_logprobs": [-0.22767922282218933, -0.00018592417472973466, -0.017249325290322304, -0.2181200385093689, -0.903560996055603, -0.02539004571735859,