);\n\tFORD(i,n-1,0) inv[i]=inv[i+1]*(i+1)%MO;\n\tint t=n;\n\tFOR(i,0,20){\n\t\tif (t&1) a[s++]=1<<i;\n\t\tt>>=1;\n\t}\n\tN=1<<s;\n\tFOR(i,0,N-1)\n\t\tFOR(j,0,s-1)\n\t\t\tif ((i>>j)&1) S[i]+=a[j];\n\tFOR(i,0,N-1){\n\t\tint t=-1;\n\t\tFOR(j,0,20)\n\t\t\tif ((i>>j)&1) t=j;\n\t\tp[i]=(1<<(t+1))+i;\n\t}\n\tf[0][0]=1;\n\tFOR(i,0,k-1)\n\t\tFOR(j,0,N-1)\n\t\t\tif (f[i][j]){\n\t\t\t\tfor (int k=p[j];k<N;k=(k+1)|j)\n\t\t\t\t\t(f[i+1][k]+=f[i][j]*inv[S[k^j]])%=MO;\n\t\t\t}\n\tFOR(i,0,k) (ans+=f[i][N-1]*P(k,i))%=MO;\n\tans=ans*fac[n]%MO;\n\tans=(pw(k,n)-ans+MO)%MO;\n\tcout<<ans<<endl;\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```python\nimport sys\nfrom collections import defaultdict\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    MO = int(data[2])\n\n    if n & 1:\n        print(pow(k, n, MO))\n        return\n\n    # factorials and inverse factorials up to n\n    fac = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = fac[i-1] * i % MO\n    inv = [1] * (n + 1)\n    inv[n] = pow(fac[n], MO - 2, MO)\n    for i in range(n, 0, -1):\n        inv[i-1] = inv[i] * i % MO\n\n    # decompose n into powers of two\n    a = []\n    t = n\n    for i in range(21):  # 2^20 > 1e6, enough\n        if t & 1:\n            a.append(1 << i)\n        t >>= 1\n    s = len(a)\n    N = 1 << s\n\n    # S[mask] = sum of a[j] for bits set in mask\n    S = [0] * N\n    for mask in range(N):\n        total = 0\n        for j in range(s):\n            if (mask >> j) & 1:\n                total += a[j]\n        S[mask] = total\n\n    # p[mask] = (1 << (highest_bit+1)) + mask\n    p = [0] * N\n    for mask in range(N):\n        if mask == 0:\n            highest = -1\n        else:\n            highest = mask.bit_length() - 1\n        p[mask] = (1 << (highest + 1)) + mask\n\n    # DP: f[i][mask] stored as dict for each i\n    f = [defaultdict(int) for _ in range(k + 1)]\n    f[0][0] = 1\n\n    for i in range(k):\n        for j, val in f[i].items():\n            if val == 0:\n                continue\n            kk = p[j]\n            while kk < N:\n                diff = kk ^ j\n                f[i+1][kk] = (f[i+1][kk] + val * inv[S[diff]]) % MO\n                kk = (kk + 1) | j\n\n    ans = 0\n    full_mask = N - 1\n    for i in range(k + 1):\n        if full_mask in f[i]:\n            # P(k, i) = fac[k] * inv[k-i] % MO\n            comb = fac[k] * inv[k - i] % MO\n            ans = (ans + f[i][full_mask] * comb) % MO\n\n    ans = ans * fac[n] % MO\n    ans = (pow(k, n, MO) - ans + MO) % MO\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n```", "token_logprobs": [-8.344646857949556e-07, -0.00016866691294126213, -4.887569048150908e-06, 0.0, -0.10020776838064194, -0.0007602662080898881, -0.0009247555863112211, -1.1920928244535389e-07, -2.3841855067985307e-07, -5.519237674889155e-05, -0.0009198724874295294, -0.39359280467033386, -0.20141509175300598, -1.1920922133867862e-06, -6.198863957251888e-06, -3.576278118089249e-07, -1.1920928244535389e-07, -5.125986263010418e-06, 0.0, -0.023250337690114975, 0.0, -0.0007553822943009436, -1.1920928244535389e-07, -0.5759396553039551, -1.2993727978027891e-05, 0.0, -0.0002615109842736274, -0.00033539868309162557, 0.0, -5.829164365422912e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -0.00012540031457319856, -0.06197982653975487, 0.0, 0.0, 0.0, -1.1920922133867862e-06, -0.0011788808042183518, 0.0, -2.0265558760002023e-06, -0.0004220310365781188, 0.0, -1.1920928244535389e-07, 0.0, -1.764281842042692e-05, -1.6927575416048057e-05, 0.0, -0.01815756969153881, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, 0.0, -5.483612312673358e-06, -0.008618067018687725, -1.1920928244535389e-07, -0.25268661975860596, -3.2186455882765586e-06, -0.01416