nf_time = [[0] * MAXN for _ in range(MAXN)]\ntempo = [[0] * MAXN for _ in range(MAXN)]\n\nadj = [[] for _ in range(MAXV)]\ncap = [[0] * MAXV for _ in range(MAXV)]\n\ndef insert_edge(u, v, c):\n    adj[u].append(v)\n    adj[v].append(u)\n    cap[u][v] = c\n    cap[v][u] = 0\n\ndef bfs(x, y):\n    global inf_time\n    for a in range(n):\n        for b in range(n):\n            inf_time[a][b] = INF\n    inf_time[x][y] = 0\n    q = deque()\n    q.append((x, y))\n    while q:\n        cx, cy = q.popleft()\n        for a in range(4):\n            nx = cx + dx[a]\n            ny = cy + dy[a]\n            if nx < 0 or nx >= n or ny < 0 or ny >= n:\n                continue\n            if '0' <= m1[nx][ny] <= '9' and inf_time[nx][ny] == INF:\n                inf_time[nx][ny] = inf_time[cx][cy] + 1\n                q.append((nx, ny))\n\ndinic_foi = [0] * MAXV\ndist = [0] * MAXV\n\ndef dinic_bfs(s, t):\n    global dist\n    for i in range(MAXV):\n        dist[i] = -1\n    dist[s] = 0\n    q = deque()\n    q.append(s)\n    while q and dist[t] == -1:\n        v = q.popleft()\n        for nxt in adj[v]:\n            if cap[v][nxt] and dist[nxt] == -1:\n                dist[nxt] = dist[v] + 1\n                q.append(nxt)\n    return dist[t] != -1\n\ndef dinic_dfs(v, t, flow):\n    if v == t:\n        return flow\n    dinic_foi[v] = 1\n    for nxt in adj[v]:\n        if cap[v][nxt] and not dinic_foi[nxt] and dist[nxt] == dist[v] + 1:\n            got = dinic_dfs(nxt, t, min(flow, cap[v][nxt]))\n            if got:\n                cap[v][nxt] -= got\n                cap[nxt][v] += got\n                return got\n    return 0\n\ndef dinic(s, t):\n    ret = 0\n    while dinic_bfs(s, t):\n        for i in range(MAXV):\n            dinic_foi[i] = 0\n        while True:\n            got = dinic_dfs(s, t, INF)\n            if not got:\n                break\n            ret += got\n    return ret\n\ndef bfs2(px, py):\n    global tempo\n    for a in range(n):\n        for b in range(n