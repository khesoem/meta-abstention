{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Python 2 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Python 2 code you have to translate:\n<original_code>\n<your_rewritten_code_4>\nimport sys\nsys.setrecursionlimit(10000)\n\nall_cache = {}\nlimit_cache = {}\nn, m = 0, 0\n\ndef searchall(lo, hi):\n    if lo == hi:\n        return 1\n    key = (lo, hi)\n    if key in all_cache:\n        return all_cache[key]\n    total = 0\n    total += searchall(lo + 1, hi)\n    total += searchall(lo, hi - 1)\n    for i in range(lo + 1, hi):\n        total += searchall(lo, i - 1) * searchall(i + 1, hi)\n    all_cache[key] = total\n    return total\n\ndef searchlimit(lo, hi, depth):\n    global m\n    if lo == hi:\n        return 1 if depth < m else 0\n    key = (lo, hi, depth)\n    if key in limit_cache:\n        return limit_cache[key]\n    total = 0\n    total += searchlimit(lo + 1, hi, depth + 1)\n    total += searchlimit(lo, hi - 1, depth + 1)\n    for i in range(lo + 1, hi):\n        total += searchlimit(lo, i - 1, depth + 1) * searchlimit(i + 1, hi, depth + 1)\n    limit_cache[key] = total\n    return total\n\ndef compute_result():\n    global n, m\n    line = input().strip()\n    parts = line.split()\n    n = int(parts[0])\n    m = int(parts[1])\n    return searchall(1, n) - searchlimit(1, n, 1)\n\ndef main():\n    result = compute_result()\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <map>\n#include <string>\n#include <sstream>\n#include <cstring>\n\nusing namespace std;\n\nmap<pair<int, int>, long long> all_cache;\nmap<tuple<int, int, int>, long long> limit_cache;\nint n, m;\n\nlong long searchall(int lo, int hi) {\n    if (lo == hi) {\n        return 1;\n    }\n    pair<int, int> key = make_pair(lo, hi);\n    if (all_cache.find(key) != all_cache.end()) {\n        return all_cache[key];\n    }\n    long long total = 0;\n    total += searchall(lo + 1, hi);\n    total += searchall(lo, hi - 1);\n    for (int i = lo + 1; i < hi; i++) {\n        total += searchall(lo, i - 1) * searchall(i + 1, hi);\n    }\n    all_cache[key] = total;\n    return total;\n}\n\nlong long searchlimit(int lo, int hi, int depth) {\n    if (lo == hi) {\n        return (depth < m) ? 1 : 0;\n    }\n    tuple<int, int, int> key = make_tuple(lo, hi, depth);\n    if (limit_cache.find(key) != limit_cache.end()) {\n        return limit_cache[key];\n    }\n    long long total = 0;\n    total += searchlimit(lo + 1, hi, depth + 1);\n    total += searchlimit(lo, hi - 1, depth + 1);\n    for (int i = lo + 1; i < hi; i++) {\n        total += searchlimit(lo, i - 1, depth + 1) * searchlimit(i + 1, hi, depth + 1);\n    }\n    limit_cache[key] = total;\n    return total;\n}\n\nlong long compute_result() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    ss >> n >> m;\n    return searchall(1, n) - searchlimit(1, n, 1);\n}\n\nint main() {\n    long long result = compute_result();\n    cout << result << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs