dges.add(new Edge(v, head[u], val, w, 0));\n        head[u] = edges.size() - 1;\n        return head[u];\n    }\n\n    static void add(int u, int v, int val, int w) {\n        int idx = add_edge(u, v, val, w);\n        int rev = add_edge(v, u, 0, -w);\n        edges.get(idx).rev = rev;\n        edges.get(rev).rev = idx;\n    }\n\n    static int P(int i, int j) {\n        return i * n + j;\n    }\n\n    static boolean SPFA() {\n        for (int i = 1; i <= tot; i++) dis[i] = INF;\n        Queue<Integer> q = new LinkedList<>();\n        q.add(s);\n        dis[s] = 0;\n        vis[s] = true;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != 0; i = edges.get(i).next) {\n                Edge e = edges.get(i);\n                int v = e.to;\n                if (e.val > 0 && dis[v] > dis[u] + e.w) {\n                    dis[v] = dis[u] + e.w;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return dis[t] < INF;\n    }\n\n    static Cf mcmf() {\n        Cf res = new Cf();\n        while (SPFA()) {\n            int flow = INF;\n            for (int x = t; x != s; x = edges.get(pre[x]).to) {\n                Edge e = edges.get(pre[x]);\n                flow = Math.min(flow, e.val);\n                if (x == t) break; // safety\n            }\n            for (int x = t; x != s; x = edges.get(pre[x]).to) {\n                Edge e = edges.get(pre[x]);\n                e.val -= flow;\n                edges.get(e.rev).val += flow;\n            }\n            res.f += flow;\n            res.c += dis[t] * flow;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        int cs = 2 * k;\n        tot = cs * n;\n        s = ++tot;\n        t = ++tot;\n        head = new int[tot + 1];\n        edges = new ArrayList<>();\n        edges.add(new Edge(0, 0, 0, 0, 0)); // dummy at index 0\n        dis = new int[tot + 1];\n        vis = new boolean[tot + 1];\n        pre = new int[tot + 1];\n\n        int[][] E = new int[m + 1][2];\n        for (int i = 1; i <= k; i++) {\n            int tp = sc.nextInt();\n            add(s, P(0, tp), 1, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            E[i][0] = sc.nextInt();\n            E[i][1] = sc.nextInt();\n        }\n        for (int i = 1; i <= cs - 1; i++) {\n            add(P(i, 1), t, k, c * i);\n            for (int j = 1; j <= n; j++) {\n                add(P(i - 1, j), P(i, j), k, 0);\n            }\n            for (int j = 1; j <= m; j++) {\n                for (int tloop = 1; tloop <= k; tloop++) {\n                    int cost = (2 * tloop - 1) * d;\n                    add(P(i - 1, E[j][0]), P(i, E[j][1]), 1, cost);\n                    add(P(i - 1, E[j][1]), P(i, E[j][0]), 1, cost);\n                }\n            }\n        }\n        Cf res = mcmf();\n        System.out.println(res.c);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.768370445162873e-07, 0.0, 0.0, -0.0005981324939057231, -0.008927077054977417, -2.3841855067985307e-07, -0.0001234931987710297, -3.776498317718506, -6.198863957251888e-06, -1.1920928244535389e-07, 0.0, 0.0, -0.07932987809181213, 0.0, 0.0, -9.536738616588991e-07, 0.0, 0.0, 0.0, -0.0006026597693562508, -2.3841855067985307e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.4662635294371285e-05, -0.000336590368533507, -0.0017043125117197633, -1.311301275563892e-06, -0.029540371149778366, -0.01420082338154316, -0.0008958140970207751, -0.0024970562662929296, -0.05000406876206398, -0.000313709635520