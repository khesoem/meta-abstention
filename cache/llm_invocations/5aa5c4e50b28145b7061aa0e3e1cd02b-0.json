{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <unordered_map>\n#include <vector>\n#include <cmath>\n#include <climits>\nusing namespace std;\n\nusing i64 = int64_t;\n\ni64 countDigits(i64 x) {\n    if (x == 0) return 1;\n    if (x < 0) x = -x;\n    i64 cnt = 0;\n    while (x > 0) {\n        ++cnt;\n        x /= 10;\n    }\n    return cnt;\n}\n\ni64 nextNumber(i64 x) {\n    vector<int> digits;\n    bool negative = x < 0;\n    if (negative) x = -x;\n    while (x > 0) {\n        int d = x % 10;\n        digits.push_back(d - (negative ? -1 : 1));\n        x /= 10;\n    }\n    i64 result = 0;\n    for (int i = digits.size() - 1; i >= 0; --i) {\n        result = result * 10 + digits[i];\n    }\n    return negative ? -result : result;\n}\n\ni64 prevNumber(i64 x) {\n    bool negative = x < 0;\n    if (negative) x = -x;\n    i64 adjustment = 0;\n    i64 original = x;\n    while (x > 0) {\n        adjustment = adjustment * 10 + (negative ? -1 : 1);\n        x /= 10;\n    }\n    adjustment = adjustment * 10 + 1;\n    return negative ? original + adjustment : original - adjustment;\n}\n\ni64 lastDigit(i64 x) {\n    if (x < 0) x = -x;\n    while (x >= 10) {\n        x /= 10;\n    }\n    return x;\n}\n\ni64 deleteLastDigit(i64 x) {\n    if (x < 0) x = -x;\n    vector<int> digits;\n    while (x >= 10) {\n        digits.push_back(x % 10);\n        x /= 10;\n    }\n    i64 result = 0;\n    for (int i = digits.size() - 1; i >= 0; --i) {\n        result = result * 10 + digits[i];\n    }\n    return result;\n}\n\nunordered_map<i64, i64> dp;\n\ni64 solve(i64 x) {\n    if (x <= 11) return min(13 - x, x);\n    if (dp.find(x) != dp.end()) return dp[x];\n    i64 n = 0, power = 1;\n    while (power < x) {\n        power *= 10;\n        power += 1;\n        ++n;\n    }\n    if (x * 2 >= power) {\n        i64 option1 = solve(power - x) + n + 1;\n        i64 base = power / 10;\n        i64 option2 = (x / base) * n + solve(x % base);\n        return dp[x] = min(option1, option2);\n    }\n    i64 base = power / 10;\n    return dp[x] = (x / base) * n + solve(x % base);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    i64 a;\n    cin >> a;\n    cout << solve(a) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom functools import lru_cache\n\nsys.setrecursionlimit(10000)\n\ndef count_digits(x):\n    if x == 0:\n        return 1\n    if x < 0:\n        x = -x\n    cnt = 0\n    while x > 0:\n        cnt += 1\n        x //= 10\n    return cnt\n\ndef next_number(x):\n    digits = []\n    negative = x < 0\n    if negative:\n        x = -x\n    while x > 0:\n        d = x % 10\n        digits.append(d - (-1 if negative else 1))\n        x //= 10\n    result = 0\n    for i in range(len(digits) - 1, -1, -1):\n        result = result * 10 + digits[i]\n    return -result if negative else result\n\ndef prev_number(x):\n    negative = x < 0\n    if negative:\n        x = -x\n    adjustment = 0\n    while x > 0:\n        adjustment = adjustment * 10 + (-1 if negative else 1)\n        x //= 10\n    adjustment = adjustment * 10 + 1\n    return x + adjustment if negative else x - adjustment\n\ndef last_digit(x):\n    if x < 0:\n        x = -x\n    while x >= 10:\n        x //= 10\n    return x\n\ndef delete_last_digit(x):\n    if x < 0:\n        x = -x\n    digits = []\n    while x >= 10:\n        digits.append(x % 10)\n        x //= 10\n    result = 0\n    for i in range(len(digits) - 1, -1, -1):\n        result = result * 10 + digits[i]\n    return result\n\ndp = {}\n\ndef solve(x):\n    if x <= 11:\n        return min(13 - x, x)\n    if x in dp:\n        return dp[x]\n    n = 0\n    power = 1\n    while power < x:\n        power *= 10\n        power += 1\n        n += 1\n    if x * 2 >= power:\n        option1 = solve(power - x) + n + 1\n        base = power // 10\n        option2 = (x // base) * n + solve(x % base)\n        dp[x] = min(option1, option2)\n        return dp[x]\n    base = power // 10\n    dp[x] = (x // base) * n + solve(x % base)\n    return dp[x]\n\ndef main():\n    input_data = sys.stdin.read().split()\n    a = int(input_data[0])\n    print(solve(a))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00025078488397412, -1.0728830375228426e-06, -4.768370445162873e-07, -0.06849804520606995, -0.0002619877050165087, -0.0031797345727682114, -0.07926204055547714, -0.22997574508190155, -3.290122185717337e-05, -9.42901024245657e-05, -2.0861407392658293e-05, -6.031808152329177e-05, -0.0005550036439672112, -0.17997249960899353, -2.861018856492592e-06, -0.00013565097469836473, -1.0371154530730564e-05, -2.2291887944447808e-05, -2.3841855067985307e-07, -7.557583012385294e-05, -9.417489309271332e-06, -1.728519782773219e-05, 0.0, -3.576278118089249e-07, -0.3870457112789154, -0.0024619766045361757, -4.160317621426657e-05, -0.2519683241844177, -5.960462772236497e-07, -0.0003471963864285499, -3.2186455882765586e-06, -