urn ans\n\ndef sum_digits(n):\n    ans = 0\n    while n > 0:\n        ans += n % k\n        n //= k\n    return ans % k\n\ndef main():\n    global k, f\n    \n    data = input().split()\n    n = int(data[0])\n    k = int(data[1])\n    \n    ndigits = 0\n    tmp = n\n    while tmp > 0:\n        tmp //= k\n        ndigits += 1\n    \n    id_matrix = Matrix()\n    for i in range(k + 1):\n        id_matrix[i][i] = 1\n    \n    f[0] = id_matrix\n    for i in range(k + 1):\n        f[0][i][0] = 1\n    \n    for i in range(1, ndigits):\n        f[i] = Matrix()\n        for x in range(M):\n            for y in range(M):\n                f[i][x][y] = id_matrix[x][y]\n        for j in range(k):\n            f[i] = f[i] * calc_matrix(i - 1, j)\n    \n    cur = 0\n    pw = 1\n    \n    ndigits -= 1\n    for i in range(ndigits):\n        pw *= k\n    \n    ans = Matrix()\n    for x in range(M):\n        for y in range(M):\n            ans[x][y] = id_matrix[x][y]\n    \n    while cur < n:\n        assert ndigits >= 0)\n        while cur + pw <= n:\n            ans = ans * calc_matrix(ndigits, sum_digits(cur))\n            cur += pw\n        pw //= k\n        ndigits -= 1\n    \n    total_sum = 0\n    for i in range(k + 1):\n        total_sum = add(total_sum, ans[k][i])\n    print(total_sum)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00010048838157672435, -8.344646857949556e-07, -1.1920928244535389e-07, -0.20161691308021545, -0.00036006642039865255, -3.194758028257638e-05, -0.32683485746383667, -0.3618427813053131, -0.007621141150593758, -8.940656698541716e-06, -1.9073468138230965e-06, -1.2397689715726301e-05, -2.264974000354414e-06, -1.645074735279195e-05, -0.008620903827250004, -0.0019293281948193908, -0.0032726561184972525, -0.3226616680622101, -1.1920928244535389e-07, -4.768360213347478e-06, 0.0, -1.9073468138230965e-06, -0.011058353818953037, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -2.55104623647639