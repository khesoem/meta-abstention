er sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        long m = sc.nextLong();\n        long P = sc.nextLong();\n        \n        long[] fac = new long[(int)n + 2];\n        long[] inv = new long[(int)n + 2];\n        fac[0] = 1;\n        inv[0] = 1;\n        \n        for (long i = 1; i <= n + 1; ++i) {\n            fac[(int)i] = (fac[(int)(i-1)] * i) % P;\n        }\n        \n        for (long i = 1; i <= n + 1; ++i) {\n            inv[(int)i] = modExp(fac[(int)i], P - 2, P);\n        }\n        \n        java.util.function.BiFunction<Long, Long, Long> nCr = (x, y) -> {\n            if (x < y) return 0L;\n            return (fac[(int)x] * inv[(int)y] % P) * inv[(int)(x - y)] % P;\n        };\n        \n        java.util.function.Function<Long, Long> triangular = (x) -> x * (x + 1) / 2;\n        \n        long[] f = new long[(int)m + 1];\n        long[] g = new long[(int)m + 1];\n        f[0] = 1;\n        \n        for (long i = 1; i <= m; ++i) {\n            for (long j = 0; j < i; ++j) {\n                long term = f[(int)j] * f[(int)(i - 1 - j)] % P * nCr.apply(i - 1, j) % P;\n                f[(int)i] = (f[(int)i] + term) % P;\n                \n                long part1 = (g[(int)j] * f[(int)(i - 1 - j)] % P + f[(int)j] * g[(int)(i - 1 - j)] % P) * (i + 1) % P;\n                long part2 = f[(int)j] * f[(int)(i - 1 - j)] % P * (triangular.apply(j) + triangular.apply(i - 1 - j)) % P;\n                long inner = (part1 + part2) % P * nCr.apply(i - 1, j) % P;\n                g[(int)i] = (g[(int)i] + inner) % P;\n            }\n            f[(int)i] = f[(int)i] * (i + 1) % P;\n        }\n        \n        long[][] F = new long[(int)m + 1][(int)n + 1];\n        long[][] G = new long[(int)m + 1][(int)n + 1];\n        \n        F[0][0] = 1;\n        for (int j = 0; j <= n; ++j) F[0][j] = 1;\n        \n        for (long i = 1; i <= m; ++i) {\n            F[(int)i][(int)i] = f[(int)i];\n            G[(int)i][(int)i] = g[(int)i];\n           