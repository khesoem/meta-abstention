98 extends Modulo<Mod998> {\n        @Override\n        public long modulus() {\n            return 998_244_353L;\n        }\n        \n        public void expand(int required) {\n            while (factorials.size() <= required) {\n                int size = factorials.size();\n                long next = product(factorials.get(size - 1), size);\n                factorials.push((int) next);\n            }\n            while (invFactorials.size() <= required) {\n                int size = invFactorials.size();\n                long inv = inverse(factorials.get(size));\n                invFactorials.push((int) inv);\n            }\n        }\n        \n        public long reciprocal(int x) {\n            return product(invFactorials.get(x), factorials.get(x - 1));\n        }\n        \n        public long choose(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return product(factorials.get(n), product(invFactorials.get(r), invFactorials.get(n - r)));\n        }\n    }\n\n    static abstract class Modulo<M extends Modulo<M>> {\n        protected final IntList factorials = new IntList();\n        protected final IntList invFactorials = new IntList();\n\n        public abstract long modulus();\n\n        public Modulo() {\n            factorials.add(1);\n            invFactorials.add(1);\n        }\n\n        public long plus(long a, long b) {\n            long sum = a + b;\n            return sum < modulus() ? sum : sum - modulus();\n        }\n\n        public long minus(long a, long b) {\n            long diff = a - b;\n            return diff < 0 ? diff + modulus() : diff;\n        }\n\n        public long product(long a, long b) {\n            return (a * b) % modulus();\n        }\n\n        public long inverse(long value) {\n            long g = modulus(), x = 0, y = 1;\n            for (long r = value; r != 0; ) {\n                long q = g / r;\n                g %= r;\n                long temp = g;\n                g = r;\n            