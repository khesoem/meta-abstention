: "<translated_code>\nimport sys\nfrom collections import deque\n\nclass IntList:\n    def __init__(self, capacity=8):\n        self.elements = [0] * capacity\n        self.count = 0\n\n    def add(self, value):\n        if self.count >= len(self.elements):\n            bigger = [0] * (len(self.elements) * 2)\n            for i in range(len(self.elements)):\n                bigger[i] = self.elements[i]\n            self.elements = bigger\n        self.elements[self.count] = value\n        self.count += 1\n\n    def size(self):\n        return self.count\n\n    def get(self, index):\n        return self.elements[index]\n\nclass Modulo:\n    def __init__(self):\n        self.factorials = IntList()\n        self.invFactorials = IntList()\n        self.factorials.add(1)\n        self.invFactorials.add(1)\n\n    def modulus(self):\n        raise NotImplementedError()\n\n    def plus(self, a, b):\n        sum_val = a + b\n        return sum_val if sum_val < self.modulus() else sum_val - self.modulus()\n\n    def minus(self, a, b):\n        diff = a - b\n        return diff if diff >= 0 else diff + self.modulus()\n\n    def product(self, a, b):\n        return (a * b) % self.modulus()\n\n    def inverse(self, value):\n        g, x, y = self.modulus(), 0, 1\n        r = value\n        while r != 0:\n            q = g // r\n            g %= r\n            temp = g\n            g = r\n            r = temp\n            x -= q * y\n            temp = x\n            x = y\n            y = temp\n        result = x % self.modulus()\n        return result if result >= 0 else result + self.modulus()\n\nclass Mod998(Modulo):\n    def __init__(self):\n        super().__init__()\n\n    def modulus(self):\n        return 998244353\n\n    def expand(self, required):\n        while self.factorials.size() <= required:\n            size = self.factorials.size()\n            next_val = self.product(self.factorials.get(size - 1), size)\n            self.factorials.add(int(next_val))\n        while self.invFactorials.size() <= required:\n            size = self.invFactorials.size()\n            inv = self.inverse(self.factorials.get(size))\n            self.invFactorials.add(int(inv))\n\n    def reciprocal(self, x):\n        return self.product(self.invFactorials.get(x), self.factorials.get(x - 1))\n\n    def choose(self, n, r):\n        if r < 0 or r > n:\n            return 0\n        return self.product(self.factorials.get(n), self.product(self.invFactorials.get(r), self.invFactorials.get(n - r)))\n\nclass FastScanner:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def ensure_tokens(self):\n        while self.tokenizer is None or not self.tokenizer:\n            line = self.reader.readline()\n            if not line:\n                raise RuntimeError(\"No more input\")\n            self.tokenizer = line.strip().split()\n\n    def next(self):\n        self.ensure_tokens()\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\ndef main():\n    scanner = FastScanner(sys.stdin)\n    n = scanner.nextInt()\n    m = scanner.nextInt()\n    \n    mod = Mod998()\n    mod.expand(n + m)\n    \n    phases = 1\n    term = 1\n    i = 0\n    while term != 0:\n        term = mod.product(term, n - i)\n        term = mod.product(term, mod.reciprocal(n + m - i))\n        phases = mod.plus(phases, term)\n        i += 1\n    \n    answer = 0\n    for k in range(1, n + 1):\n        numPhases = mod.product(m + k, mod.reciprocal(k))\n        contribution = mod.product(mod.choose(n, k), mod.product(numPhases, phases))\n        if k % 2 == 1:\n            answer = mod.plus(answer, contribution)\n        else:\n            answer = mod.minus(answer, contribution)\n    \n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.255681051290594e-05, -8.344646857949556e-07, -1.4305104514278355e-06, -0