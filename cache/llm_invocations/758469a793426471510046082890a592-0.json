{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 300005;\nint MOD = 1e9 + 7;\n\ninline void mod_add(int &x, int y) { x = (x + y) % MOD; }\ninline int mod_mul(int x, int y) { return (long long)x * y % MOD; }\n\nint power_mod(int x, int y) {\n    int res = 1;\n    while (y) {\n        if (y & 1) res = mod_mul(res, x);\n        x = mod_mul(x, x);\n        y >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    int n, k, mod_val;\n    scanf(\"%d%d%d\", &n, &k, &mod_val);\n    MOD = mod_val;\n\n    vector<int> fac(n + 1), ifac(n + 1);\n    fac[0] = 1;\n    for (int i = 1; i <= n; ++i) fac[i] = mod_mul(fac[i - 1], i);\n    ifac[n] = power_mod(fac[n], MOD - 2);\n    for (int i = n - 1; i >= 0; --i) ifac[i] = mod_mul(ifac[i + 1], i + 1);\n\n    auto comb = [&](int x, int y) -> int {\n        if (y < 0 || y > x) return 0;\n        return mod_mul(fac[x], mod_mul(ifac[x - y], ifac[y]));\n    };\n\n    if (n & 1) {\n        printf(\"%d\\n\", power_mod(k, n));\n        return 0;\n    }\n\n    int dp0[MAXN], dp1[MAXN];\n    memset(dp0, 0, sizeof(dp0));\n    memset(dp1, 0, sizeof(dp1));\n    dp0[n] = 1;\n    int ans = 0;\n\n    for (int i = 1; i <= k; ++i) {\n        int *prev = (i & 1) ? dp1 : dp0;\n        int *cur = (i & 1) ? dp0 : dp1;\n        memset(cur, 0, sizeof(int) * (n + 1));\n        int res = 0;\n        for (int j = n; j >= 1; --j) {\n            int tmp = prev[j];\n            if (!tmp) continue;\n            int u = j ^ (j & -j);\n            for (int sub = u; sub; sub = (sub - 1) & u)\n                mod_add(cur[sub], mod_mul(tmp, comb(j, sub)));\n            mod_add(res, tmp);\n        }\n        mod_add(ans, mod_mul(res, ifac[k - i]));\n    }\n\n    ans = mod_mul(ans, fac[k]);\n    ans = (power_mod(k, n) - ans + MOD) % MOD;\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    MOD = int(next(it))\n\n    # Precompute factorials and inverse factorials up to n\n    fac = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = (fac[i-1] * i) % MOD\n\n    # Fast modular exponentiation\n    def power_mod(x: int, y: int) -> int:\n        res = 1\n        while y:\n            if y & 1:\n                res = (res * x) % MOD\n            x = (x * x) % MOD\n            y >>= 1\n        return res\n\n    ifac = [1] * (n + 1)\n    ifac[n] = power_mod(fac[n], MOD - 2)\n    for i in range(n - 1, -1, -1):\n        ifac[i] = (ifac[i+1] * (i+1)) % MOD\n\n    def comb(x: int, y: int) -> int:\n        if y < 0 or y > x:\n            return 0\n        return (fac[x] * ifac[x-y] % MOD) * ifac[y] % MOD\n\n    if n & 1:\n        print(power_mod(k, n))\n        return\n\n    # DP arrays: dp0 and dp1, size n+1\n    dp0 = [0] * (n + 1)\n    dp1 = [0] * (n + 1)\n    dp0[n] = 1\n    ans = 0\n\n    for i in range(1, k + 1):\n        if i & 1:\n            prev = dp1\n            cur = dp0\n        else:\n            prev = dp0\n            cur = dp1\n        # reset cur\n        for j in range(n + 1):\n            cur[j] = 0\n        res = 0\n        for j in range(n, 0, -1):\n            tmp = prev[j]\n            if tmp == 0:\n                continue\n            u = j ^ (j & -j)   # remove lowest set bit\n            sub = u\n            while sub:\n                cur[sub] = (cur[sub] + tmp * comb(j, sub)) % MOD\n                sub = (sub - 1) & u\n            res = (res + tmp) % MOD\n        ans = (ans + res * ifac[k - i]) % MOD\n\n    ans = ans * fac[k] % MOD\n    ans = (power_mod(k, n) - ans) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.659658250398934e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0002687808300834149, -0.0007191693875938654, 0.0, -0.000436091679148376, -0.39935919642448425, -0.8179387450218201, -0.1002158597111702, -1.7881377516459906e-06, -2.1576648578047752e-05, -1.0728830375228426e-06, -1.6689286894688848e-06, -0.0015266203554347157, -4.768370445162873e-07, -0.5759718418121338, 0.0, -0.6932264566421509, -6.437280717364047e-06, -1.0728830375228426e-06, -3.5523738915799186e-05, -2.539125671319198e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -0.011074387468397617, -6.198863957251888e-06, 0.0, -0.00033539868309162557, -1.1920928244535389e-07, 0.0, -2.145764938177308e-06, -5.960462772236497e-07, -0.20164194703102112, 0.0, -8.344646857949556e-07, -0.00026258357684127986, -1.311301275563892e-06, -3.576278118089249e-07, -1.0132738680113107e-05, -4.8993817472364753e-05, 0.0, 0.0, 0.0, -6.305972783593461e-05, 0.0, -2.7418097943154862e-06, -0.001191501971334219, 0.0, -4.768370445162873e-07, 0.0, -2.3841830625315197e-06, -1.1920928244535389e-07, -0.029984133318066597, -0.0007827793597243726, -2.145764938177308e-06, -2.38418550679853