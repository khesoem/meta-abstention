ng a, long e, long mod) {\n        long res = 1;\n        a %= mod;\n        while (e > 0) {\n            if ((e & 1) == 1) res = (res * a) % mod;\n            a = (a * a) % mod;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    // Main logic\n    static int decide(int a, int b) {\n        if (a == b) return 0;\n        if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n        return -1;\n    }\n\n    static long evaluate(List<int[]> p1_list, List<int[]> p2_list) {\n        long score = 0;\n        int[] cur1 = null;\n        int[] cur2 = null;\n        while (!p1_list.isEmpty() || !p2_list.isEmpty()) {\n            if (cur1 == null) {\n                cur1 = p1_list.remove(p1_list.size() - 1);\n            }\n            if (cur2 == null) {\n                cur2 = p2_list.remove(p2_list.size() - 1);\n            }\n            int how_many = Math.min(cur1[0], cur2[0]);\n            int res = decide(cur1[1], cur2[1]);\n            if (res == 1) {\n                score += how_many;\n            }\n            if (cur1[0] < cur2[0]) {\n                cur2[0] -= cur1[0];\n                cur1 = null;\n            } else if (cur1[0] > cur2[0]) {\n                cur1[0] -= cur2[0];\n                cur2 = null;\n            } else {\n                cur1 = null;\n                cur2 = null;\n            }\n        }\n        return score;\n    }\n\n    static long calc_max(int r1, int s1, int p1, int r2, int s2, int p2) {\n        return Math.min(r1, s2) + Math.min(s1, p2) + Math.min(p1, r2);\n    }\n\n    static long calc_min(int r1, int s1, int p1, int r2, int s2, int p2) {\n        long best = r1 + s1 + p1; // n\n        // Generate all permutations of the three moves for each player\n        int[][] base1 = {{r1, 1}, {s1, 2}, {p1, 3}};\n        int[][] base2 = {{r2, 1}, {s2, 2}, {p2, 3}};\n        List<int[][]> perms1 = new ArrayList<>();\n        List<int[][]> perms2 = new ArrayList<>();\n        // Generate permutations of indices 0,1,2\n        int[][] indicesPerms = {\n            {0,1,2}, {0,2,1}, {1,0,2}, {1,2,0}, {2,0,1}, {2,1,0}\n        };\n        for (int[] perm : indicesPerms) {\n            int[][] p1 = new int[3][2];\n            int[][] p2 = new int[3][2];\n            for (int i = 0; i < 3; i++) {\n                p1[i] = new int[]{base1[perm[i]][0], base1[perm[i]][1]};\n                p2[i] = new int[]{base2[perm[i]][0], base2[perm[i]][1]};\n            }\n            perms1.add(p1);\n            perms2.add(p2);\n        }\n        for (int[][] t1 : perms1) {\n            for (int[][] t2 : perms2) {\n                // Create mutable copies\n                List<int[]> c1 = new ArrayList<>();\n                List<int[]> c2 = new ArrayList<>();\n                for (int[] arr : t1) c1.add(new int[]{arr[0], arr[1]});\n                for (int[] arr : t2) c2.add(new int[]{arr[0], arr[1]});\n                long v = evaluate(c1, c2);\n                if (v < best) best = v;\n            }\n        }\n        return best;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt(); // not used except for initial best\n        int r1 = sc.nextInt();\n        int s1 = sc.nextInt();\n        int p1 = sc.nextInt();\n        int r2 = sc.nextInt();\n        int s2 = sc.nextInt();\n        int p2 = sc.nextInt();\n        long minWins = calc_min(r1, s1, p1, r2, s2, p2);\n        long maxWins = calc_max(r1, s1, p1, r2, s2, p2);\n        System.out.println(minWins + \" \" + maxWins);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.576278118089249e-07, 0.0, 0.0, -2.7894584491150454e-05, -1.4424220353248529e-05, 0.0, -2.777537883957848e-05, -0.008737191557884216, -5.1616290875244886e-05, 0.0, -1.4185804502631072e-05, -0.006716651376336813, -9.715084888739511e-05, -0.2614879310131073, -0.0005566716426983476, -0.1269281506538391, -2.384185506798530