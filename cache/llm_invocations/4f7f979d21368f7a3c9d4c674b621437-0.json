ge(3)] for _ in range(self.cs + 1)] for _ in range(self.ck + 1)] for _ in range(self.cv + 1)]\n        ans = self.dfs(0, 0, 0, 2)\n        out.println(ans)\n\n    def dfs(self, tv, tk, ts, last):\n        if tv == self.cv and tk == self.ck and ts == self.cs:\n            return 0\n        if self.dp[tv][tk][ts][last] != -1:\n            return self.dp[tv][tk][ts][last]\n        INF = 1 << 29\n        ret = INF\n        if tv < self.cv:\n            p = self.pos[0][tv]\n            move = max(self.freq[p][0] - tv, 0) + max(self.freq[p][1] - tk, 0) + max(self.freq[p][2] - ts, 0) - 1\n            ret = min(ret, self.dfs(tv + 1, tk, ts, 0) + move)\n        if tk < self.ck and last != 0:\n            p = self.pos[1][tk]\n            move = max(self.freq[p][0] - tv, 0) + max(self.freq[p][1] - tk, 0) + max(self.freq[p][2] - ts, 0) - 1\n            ret = min(ret, self.dfs(tv, tk + 1, ts, 1) + move)\n        if ts < self.cs:\n            p = self.pos[2][ts]\n            move = max(self.freq[p][0] - tv, 0) + max(self.freq[p][1] - tk, 0) + max(self.freq[p][2] - ts, 0) - 1\n            ret = min(ret, self.dfs(tv, tk, ts + 1, 2) + move)\n        self.dp[tv][tk][ts][last] = ret\n        return ret\n\ndef main():\n    input_stream = sys.stdin.buffer\n    output_stream = sys.stdout\n    inp = InputReader(input_stream)\n    out = OutputWriter(output_stream)\n    solver = TaskC()\n    solver.solve(1, inp, out)\n    out.close()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.9073468138230965e-06, -1.1920928244535389e-07, 0.0, -0.0005258131423033774, -1.2636104656849056e-05, -4.172316494077677e-06, -0.693248987197876, -0.00017248096992261708, -0.055583830922842026, -1.4305104514278355e-06, -2.50339189733495e-06, -7.152555099310121e-07, -1.6689286894688848e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -7.486063259420916e-05, -0.00019786784832831472, -0.00031394799589179456, 0.0, -3.576278118089249e-07, -0.00012349