-1);\n            depth[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                for (Edge e : links.get(v)) {\n                    if (e.cap > 0 && depth[e.to] < 0) {\n                        depth[e.to] = depth[v] + 1;\n                        q.add(e.to);\n                    }\n                }\n            }\n        }\n\n        long dfs(int v, int t, long flow) {\n            if (v == t) return flow;\n            List<Edge> linksV = links.get(v);\n            for (int i = progress[v]; i < linksV.size(); i++) {\n                progress[v] = i;\n                Edge e = linksV.get(i);\n                if (e.cap == 0 || depth[v] >= depth[e.to]) continue;\n                long d = dfs(e.to, t, Math.min(flow, e.cap));\n                if (d == 0) continue;\n                e.cap -= d;\n                links.get(e.to).get(e.rev).cap += d;\n                return d;\n            }\n            return 0;\n        }\n\n        long flow(int s, int t) {\n            long flow = 0;\n            while (true) {\n                bfs(s);\n                if (depth[t] < 0) return flow;\n                progress = new int[n];\n                long currentFlow = dfs(s, t, INF);\n                while (currentFlow > 0) {\n                    flow += currentFlow;\n                    currentFlow = dfs(s, t, INF);\n                }\n            }\n        }\n\n        int[] getEdge(int i) {\n            int[] p = pos.get(i);\n            Edge e = links.get(p[0]).get(p[1]);\n            Edge re = links.get(e.to).get(e.rev);\n            // from, to, cap, flow\n            return new int[]{p[0], e.to, (int)(e.cap + re.cap), (int)re.cap};\n        }\n\n        List<int[]> getEdges() {\n            List<int[]> res = new ArrayList<>();\n            for (int i = 0; i < pos.size(); i++) {\n                res.add(getEdge(i));\n            }\n            return res;\n        }\n\n        static class Edge {\n            long cap;\n            int to;\n            int rev;\n            Edge(long cap, int to, int rev) {\n                this.cap = cap;\n                this.to = to;\n                this.rev = rev;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = 3;\n        long[] A = new long[M];\n        long[] B = new long[M];\n        for (int i = 0; i < M; i++) A[i] = sc.nextLong();\n        for (int i = 0; i < M; i++) B[i] = sc.nextLong();\n\n        long ans1 = 0;\n        for (int i = 0; i < M; i++) {\n            ans1 += Math.min(A[i], B[(i+1)%M]);\n        }\n\n        long ans2 = 0;\n        Dinic dinic = new Dinic(2*M+2);\n        int s = 2*M;\n        int t = 2*M + 1;\n        for (int i = 0; i < M; i++) {\n            // s to Alice\n            dinic.addEdge(s, i, N);\n            // Bob to t\n            dinic.addEdge(M+i, t, B[i]);\n            // draw\n            dinic.addEdge(i, M+i, A[i]);\n            // Alice lose\n            dinic.addEdge(i, M + (i-1+M)%M, A[i]);\n        }\n        ans2 = N - dinic.flow(s, t);\n\n        System.out.println(ans2 + \" \" + ans1);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-4.768370445162873e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -9.48860906646587e-05, -4.172238186583854e-05, 0.0, -0.38687101006507874, -0.5763510465621948, -0.0009633429581299424, -1.1920928244535389e-07, -0.0034598985221236944, -0.04859686642885208, -0.003181279404088855, -0.09010674804449081, -0.6648872494697571, -0.0011747133685275912, -0.0005760917556472123, -0.0015495923580601811, -0.1277318149805069, -2.3841855067985307e-07, -4.768370445162873e-07, -0.10040812194347382, 0.0, -0.5760510563850403, -0.0007468056865036488, -1.2993727978027891e-05, -1.9430925021879375e-05, -6.890059739816934e-05, -0.12692877650260925, 0.0, -5.9604627