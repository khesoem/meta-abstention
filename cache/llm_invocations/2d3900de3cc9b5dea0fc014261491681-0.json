flow = Math.min(flow, graph.get(prevv[v]).get(preve[v]).cap);\n        }\n\n        for (int v = t; v != s; v = prevv[v]) {\n            Edge e = graph.get(prevv[v]).get(preve[v]);\n            e.cap -= flow;\n            graph.get(v).get(e.rev).cap += flow;\n        }\n\n        return new Result(dist[t] * flow, true);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        r = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        for (int i = 1; i <= r; i++) {\n            int x = sc.nextInt();\n            occ[x]++;\n        }\n\n        for (int i = 1; i <= m; i++) {\n            pts[i][0] = sc.nextInt();\n            pts[i][1] = sc.nextInt();\n        }\n\n        int nodes = (r + n + 1) * n + 3;\n        graph = new ArrayList<>();\n        for (int i = 0; i < nodes; i++) {\n            graph.add(new ArrayList<>());\n        }\n        dist = new int[nodes];\n        prevv = new int[nodes];\n        preve = new int[nodes];\n\n        int S = (r + n + 1) * n + 1;\n        int T = (r + n + 1) * n + 2;\n\n        for (int i = 0; i < r + n; i++) {\n            for (int j = 1; j <= m; j++) {\n                for (int k = 1; k <= r; k++) {\n                    add_edge(i * n + pts[j][0], (i + 1) * n + pts[j][1], 1, (2 * k - 1) * d);\n                    add_edge(i * n + pts[j][1], (i + 1) * n + pts[j][0], 1, (2 * k - 1) * d);\n                }\n            }\n        }\n\n        for (int i = 1; i <= r + n; i++) {\n            add_edge(i * n + 1, T, 0x3f3f3f3f, i * c);\n            for (int j = 2; j <= n; j++) {\n                add_edge((i - 1) * n + j, i * n + j, 0x3f3f3f3f, 0);\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            add_edge(S, i, occ[i], 0);\n        }\n\n        int totalCost = 0;\n        Result res = spfa(S, T, nodes);\n        while (res.found) {\n            totalCost += res.cost;\n   