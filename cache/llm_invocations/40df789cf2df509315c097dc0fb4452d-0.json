 pattern: parentheses with word characters or underscores inside\n    vector<string> parts;\n    size_t pos = 0;\n    size_t prev = 0;\n    while ((pos = input.find('(', prev)) != string::npos) {\n        size_t endPos = input.find(')', pos);\n        if (endPos != string::npos) {\n            parts.push_back(input.substr(prev, pos - prev));\n            prev = endPos + 1;\n        } else {\n            break;\n        }\n    }\n    if (prev < input.length()) {\n        parts.push_back(input.substr(prev));\n    }\n    \n    int maxLen = 0;\n    for (const string& part : parts) {\n        maxLen = max(maxLen, maxWordLength(part));\n    }\n    \n    long long underscoreCount = 0;\n    size_t i = 0;\n    while (i < input.length()) {\n        if (input[i] == '(') {\n            size_t j = i + 1;\n            while (j < input.length() && input[j] != ')') j++;\n            if (j < input.length()) {\n                string content = input.substr(i + 1, j - i - 1);\n                underscoreCount += countUnderscoreSegments(content);\n                i = j + 1;\n                continue;\n            }\n        }\n        i++;\n    }\n    \n    cout << maxLen << \" \" << underscoreCount << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0003203832311555743, -5.722029527532868e-06, -3.576278118089249e-07, -1.597391747054644e-05, -1.311301275563892e-06, -1.7881377516459906e-06, -2.3841830625315197e-06, -7.629365427419543e-06, -5.960446742392378e-06, -0.0083414725959301, -3.4570634852570947e-06, -4.136476854910143e-05, -2.3841830625315197e-06, -0.8745141625404358, -6.556489552167477e-06, -7.152531907195225e-06, -1.311301275563892e-06, -0.39366596937179565, -0.0017022894462570548, -0.0011706650257110596, -4.0531076592742465e-06, -0.3298393487930298, -0.6326057314872742, -0.007611322216689587, -1.7404405298293568e-05, -0.038686156272888184, -1.9073468138230965e-06, -0.061975009739398956, -0.014721808955073357, -1.39473