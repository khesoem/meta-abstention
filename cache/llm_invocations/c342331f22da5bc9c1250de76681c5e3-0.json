": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Pair {\n        long first;\n        long second;\n        \n        Pair(long first, long second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n    \n    static long n, x, y;\n    static double best_error = Double.MAX_VALUE;\n    static Pair best_frac;\n    \n    static void evaluate(long denominator, long numerator) {\n        if (denominator <= 0) return;\n        double current = (double) numerator / denominator;\n        double desired = (double) x / y;\n        double error = Math.abs(current - desired);\n        \n        if (error + 1e-15 < best_error) {\n            best_error = error;\n            best_frac = new Pair(denominator, numerator);\n        }\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        x = scanner.nextLong();\n        y = scanner.nextLong();\n        n = scanner.nextLong();\n        \n        for (long b = 1; b <= n; ++b) {\n            long a = (x * b) / y;\n            evaluate(b, a);\n            evaluate(b, a + 1);\n        }\n        \n        System.out.println(best_frac.second + \"/\" + best_frac.first);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001308832288486883, -4.529942543740617e-06, -3.576278118089249e-07, -0.00016318420239258558, -1.0967194612021558e-05, -0.12773747742176056, -0.19043003022670746, -1.6212332411669195e-05, -2.3841855067985307e-07, -3.361645576660521e-05, -0.0019290901254862547, -8.523101132595912e-05, -0.04869406670331955, -0.583380937576294, -0.008236252702772617, -5.495397272170521e-05, -3.814689989667386e-06, -2.8729025871143676e-05, -0.005838246084749699, -0.0010334871476516128, -2.3841830625315197e-06, -1.9073468138230965e-06, -2.658331868587993e-05, -0.002185458317399025, -0.179