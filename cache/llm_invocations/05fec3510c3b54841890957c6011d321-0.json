 55; i++) {\n            vr[i] = new ArrayList<>();\n        }\n\n        for (long i = 1; i <= K.k; i++) {\n            lr[(int)i] = sc.nextLong();\n            addRib(g, 0, lr[(int)i], 1, 0);\n        }\n\n        for (int j = 0; j < tim - 1; j++) {\n            for (long i = 2; i <= K.n; i++) {\n                addRib(g, j * 50 + i, (j + 1) * 50 + i, 50, K.c);\n            }\n        }\n\n        for (int j = 1; j < tim; j++) {\n            addRib(g, j * 50 + 1, 1, 50, 0);\n        }\n\n        for (long i = 0; i < K.m; i++) {\n            long x = sc.nextLong();\n            long y = sc.nextLong();\n            vr[(int)x].add(y);\n            vr[(int)y].add(x);\n\n            for (int j = 0; j < tim - 1; j++) {\n                for (int l = 0; l < 50; l++) {\n                    addRib(g, j * 50 + x, (j + 1) * 50 + y, 1, K.c + K.d * ((l + 1) * (l + 1) - (l * l)));\n                    addRib(g, j * 50 + y, (j + 1) * 50 + x, 1, K.c + K.d * ((l + 1) * (l + 1) - (l * l)));\n                }\n            }\n        }\n\n        long s = 0, t = 1;\n        long flow = 0, cost = 0;\n        long INF = 1000L * 1000 * 1000;\n\n        while (flow < K.k) {\n            long[] id = new long[(int)n];\n            long[] d = new long[(int)n];\n            Arrays.fill(d, INF);\n            long[] q = new long[(int)n];\n            int[] p = new int[(int)n];\n            int[] pRib = new int[(int)n];\n            int qh = 0, qt = 0;\n            q[qt++] = s;\n            d[(int)s] = 0;\n\n            while (qh != qt) {\n                long v = q[qh++];\n                if (qh == n) qh = 0;\n                id[(int)v] = 2;\n\n                List<Rib> ribs = g.get((int)v);\n                for (int i = 0; i < ribs.size(); i++) {\n                    Rib r = ribs.get(i);\n                    if (r.f < r.u && d[(int)v] + r.c < d[(int)r.b]) {\n                        d[(int)r.b] = d[(int)v] + r.c;\n                        if (id[(int)r.b] == 0) {\n                            q[qt++] = r.b;\n                            if (qt == n) qt = 0;\n                        } else if (id[(int)r.b] == 2) {\n                            if (--qh == -1) qh = (int)n - 1;\n                            q[qh] = r.b;\n                        }\n                        id[(int)r.b] = 1;\n                        p[(int)r.b] = (int)v;\n                        pRib[(int)r.b] = i;\n                    }\n                }\n            }\n\n            if (d[(int)t] == INF) break;\n\n            long addflow = K.k - flow;\n            for (long v = t; v != s; v = p[(int)v]) {\n                int pv = p[(int)v];\n                int pr = pRib[(int)v];\n                addflow = Math.min(addflow, g.get(pv).get(pr).u - g.get(pv).get(pr).f);\n            }\n\n            for (long v = t; v != s; v = p[(int)v]) {\n                int pv = p[(int)v];\n                int pr = pRib[(int)v];\n                int r = g.get(pv).get(pr).back;\n                g.get(pv).get(pr).f += addflow;\n                g.get((int)v).get(r).f -= addflow;\n                cost += g.get(pv).get(pr).c * addflow;\n            }\n            flow += addflow;\n        }\n\n        System.out.println(cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.622601e-06, 0.0, -1.1920928e-07, -3.7907834e-05, -0.0007453762, -1.072883e-06, -0.078900106, -0.47421715, -2.2291888e-05, -2.9802277e-06, -0.110082746, -0.018181685, -0.06289448, -2.3841855e-07, -0.0021642852, -0.0042602737, -0.004086003, -0.00298412, -0.13294506, -0.10159571, -2.3603161e-05, -5.960463e-07, -0.3132667, -2.4556812e-05, -0.00018606838, -1.1920928e-07, -1.1920928e-07, -0.000113242415, -2.2649509e-05, -3.576278e-07, -9.655906e-06, -3.576278e-07, -0.0015312624, -1.072883e-06, -0.102757044, -0.100711375, -0.008631895, -0.00058514636, -1.3589766e-05, -1.4305013e-05, -2.3841855e-07, 0.0, 0.0, -1.1920928e-07, 0.0, -0.0005529782, -0.00015865498, -4.7683704e-07, -1.8954097e-05, -4.7683704e-07, 0.0,