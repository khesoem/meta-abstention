na = floor(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(floor(a) < mina){\n                    mina = floor(a);\n                    minb = b;                   \n                }\n            }\n            \n            diff(x,y,ceil(a),b,tempa,tempb);        \n            temp = tempa/tempb;\n\n            if(temp < min){\n                mina = ceil(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(ceil(a) < mina){\n                    mina = ceil(a);\n                    minb = b;                   \n                }\n            }\n        }\n    }\n\n    int gc = gcd (mina, minb);\n    if (gc != 1){       \n        mina = mina/gc;\n        minb = minb/gc;\n    }\n\n    cout<<mina<<\"/\"<<minb<<endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static int gcd(int x, int y) {\n        int gcd;\n        if (x > y)\n            gcd = x;\n        else\n            gcd = y;\n        while (true) {\n            if (x % gcd == 0 && y % gcd == 0)\n                break;\n            gcd--;\n        }\n        return gcd;\n    }\n\n    public static double diff(double x, double y, double a, double b) {\n        double num = Math.abs(x * b - y * a);\n        double den = y * b;\n        return num / den;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        double x = sc.nextDouble();\n        double y = sc.nextDouble();\n        double n = sc.nextDouble();\n        double min = 1000000.0;\n        int mina = 0, minb = 0;\n\n        if (n > y) {\n            int ix = (int) x;\n            int iy = (int) y;\n            int gc = gcd(ix, iy);\n            if (gc != 1) {\n                x = x / gc;\n                y = y / gc;\n            }\n            System.out.println((int) x + \"/\" + (int) y);\n            sc.close();\n            return;\n        }\n\n        for (int b = (int) n; b >= 1; b--) {\n            double a = (x * b) / y;\n            if (Math.floor(a) == a) {\n                mina = (int) a;\n                minb = b;\n                break;\n            } else {\n                double temp;\n                // floor\n                temp = diff(x, y, Math.floor(a), b);\n                if (temp < min) {\n                    mina = (int) Math.floor(a);\n                    minb = b;\n                    min = temp;\n                } else if (temp == min) {\n                    if (Math.floor(a) < mina) {\n                        mina = (int) Math.floor(a);\n                        minb = b;\n                    }\n                }\n                // ceil\n                temp = diff(x, y, Math.ceil(a), b);\n                if (temp < min) {\n                    mina = (int) Math.ceil(a);\n                    minb = b;\n                    min = temp;\n                } else if (temp == min) {\n                    if (Math.ceil(a) < mina) {\n                        mina = (int) Math.ceil(a);\n                        minb = b;\n                    }\n                }\n            }\n        }\n\n        int gc = gcd(mina, minb);\n        if (gc != 1) {\n            mina = mina / gc;\n            minb = minb / gc;\n        }\n        System.out.println(mina + \"/\" + minb);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.622600959512056e-06, 0.0, 0.0, -8.260862523457035e-05, -0.0001879753835964948, 0.0, -3.576278118089249e-07, -3.7431014789035544e-05, -0.3869028389453888, -2.1815061700181104e-05, -1.1920928244535389e-07, -0.000362807244528085, -0.003181992331519723, -0.004081966355443001, -0.7341086268424988, 0.0, -0.2519326508045