uilder sb = new StringBuilder();\n        for (int i = 0; i < a; i++) sb.append((char) ('a' + i));\n        for (int i = 0; i < b; i++) sb.append(p);\n        \n        outer:\n        for (int i = 0; i < a; i++) {\n            boolean[] seen = new boolean[26];\n            for (int j = b; j < b + a + i; j++) {\n                if (j < sb.length()) {\n                    seen[sb.charAt(j) - 'a'] = true;\n                }\n            }\n            for (int j = 0; j < 26; j++) {\n                if (!seen[j]) {\n                    sb.append((char) ('a' + j));\n                    continue outer;\n                }\n            }\n        }\n        \n        for (int i = 0; i < b; i++) sb.append(q);\n        return sb.toString();\n    }\n\n    private int countUniqueInRange(String pattern, int l, int r) {\n        boolean[] seen = new boolean[26];\n        int len = pattern.length();\n        if (r - l + 1 >= 100_000) {\n            for (int i = 0; i < len; i++) {\n                seen[pattern.charAt(i) - 'a'] = true;\n            }\n        } else {\n            for (int i = l; i <= r; i++) {\n                seen[pattern.charAt(i % len) - 'a'] = true;\n            }\n        }\n        int count = 0;\n        for (boolean b : seen) if (b) count++;\n        return count;\n    }\n}\n</your_rewritten_code_1>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport io\n\ndef build_pattern(a, b, p, q):\n    sb = []\n    for i in range(a):\n        sb.append(chr(ord('a') + i))\n    for i in range(b):\n        sb.append(p)\n    \n    for i in range(a):\n        seen = [False] * 26\n        for j in range(b, b + a + i):\n            if j < len(sb):\n                seen[ord(sb[j]) - ord('a')] = True\n        for j in range(26):\n            if not seen[j]:\n                sb.append(chr(ord('a') + j))\n                break\n    \n    for i in ran