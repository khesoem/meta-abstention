{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n<your_rewritten_code_4>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 10005;\nconst long long INF = 1LL << 50;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nvector<Edge> adj[MAX_NODES];\nint dist[MAX_NODES], prevv[MAX_NODES], preve[MAX_NODES];\nbool inq[MAX_NODES];\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    adj[u].emplace_back(v, cap, cost, (int)adj[v].size());\n    adj[v].emplace_back(u, 0, -cost, (int)adj[u].size() - 1);\n}\n\nlong long minCostFlow(int src, int dst) {\n    long long totalCost = 0;\n    while (true) {\n        fill(dist, dist + MAX_NODES, INF);\n        fill(inq, inq + MAX_NODES, false);\n        queue<int> q;\n        dist[src] = 0;\n        q.push(src);\n        inq[src] = true;\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            for (int i = 0; i < adj[u].size(); ++i) {\n                auto& e = adj[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[dst] == INF) break;\n\n        long long flow = INF;\n        for (int v = dst; v != src; v = prevv[v]) {\n            flow = min(flow, (long long)adj[prevv[v]][preve[v]].cap);\n        }\n\n        for (int v = dst; v != src; v = prevv[v]) {\n            auto& e = adj[prevv[v]][preve[v]];\n            e.cap -= flow;\n            adj[v][e.rev].cap += flow;\n            totalCost += flow * e.cost;\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> positions(k + 1);\n    for (int i = 1; i <= k; ++i) cin >> positions[i];\n\n    int source = 0;\n    int sink = n * 100 + 1;\n\n    for (int floor = 1; floor <= 100; ++floor) {\n        addEdge(floor, sink, INT_MAX, 0);\n    }\n\n    for (int i = 1; i <= k; ++i) {\n        addEdge(source, (positions[i] - 1) * 100 + 1, 1, 0);\n    }\n\n    for (int floor = 2; floor <= n; ++floor) {\n        for (int level = 1; level < 100; ++level) {\n            addEdge((floor - 1) * 100 + level, (floor - 1) * 100 + level + 1, INT_MAX, c);\n        }\n    }\n\n    int u, v;\n    for (int _ = 0; _ < m; ++_) {\n        cin >> u >> v;\n        for (int level = 1; level < 100; ++level) {\n            for (int group = 1; group <= k; ++group) {\n                int edgeCost = c + d * (group * group - (group - 1) * (group - 1));\n                addEdge((u - 1) * 100 + level, (v - 1) * 100 + level + 1, 1, edgeCost);\n                addEdge((v - 1) * 100 + level, (u - 1) * 100 + level + 1, 1, edgeCost);\n            }\n        }\n    }\n\n    cout << minCostFlow(source, sink) << '\\n';\n    return 0;\n}\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_NODES = 10005;\n    static final long INF = 1L << 50;\n\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int t, int c, int co, int r) {\n            to = t;\n            cap = c;\n            cost = co;\n            rev = r;\n        }\n    }\n\n    static List<Edge>[] adj = new List[MAX_NODES];\n    static int[] dist = new int[MAX_NODES];\n    static int[] prevv = new int[MAX_NODES];\n    static int[] preve = new int[MAX_NODES];\n    static boolean[] inq = new boolean[MAX_NODES];\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        adj[u].add(new Edge(v, cap, cost, adj[v].size()));\n        adj[v].add(new Edge(u, 0, -cost, adj[u].size() - 1));\n    }\n\n    static long minCostFlow(int src, int dst) {\n        long totalCost = 0;\n        while (true) {\n            Arrays.fill(dist, (int) INF);\n            Arrays.fill(inq, false);\n            Queue<Integer> q = new LinkedList<>();\n            dist[src] = 0;\n            q.offer(src);\n            inq[src] = true;\n\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n                for (int i = 0; i < adj[u].size(); ++i) {\n                    Edge e = adj[u].get(i);\n                    if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n\n            if (dist[dst] == INF) break;\n\n            long flow = INF;\n            for (int v = dst; v != src; v = prevv[v]) {\n                flow = Math.min(flow, (long) adj[prevv[v]].get(preve[v]).cap);\n            }\n\n            for (int v = dst; v != src; v = prevv[v]) {\n                Edge e = adj[prevv[v]].get(preve[v]);\n                e.cap -= (int) flow;\n                adj[v].get(e.rev).cap += (int) flow;\n                totalCost += flow * e.cost;\n            }\n        }\n        return totalCost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int[] positions = new int[k + 1];\n        for (int i = 1; i <= k; ++i) {\n            positions[i] = sc.nextInt();\n        }\n\n        int source = 0;\n        int sink = n * 100 + 1;\n\n        for (int i = 0; i < MAX_NODES; ++i) {\n            adj[i] = new ArrayList<>();\n        }\n\n        for (int floor = 1; floor <= 100; ++floor) {\n            addEdge(floor, sink, Integer.MAX_VALUE, 0);\n        }\n\n        for (int i = 1; i <= k; ++i) {\n            addEdge(source, (positions[i] - 1) * 100 + 1, 1, 0);\n        }\n\n        for (int floor = 2; floor <= n; ++floor) {\n            for (int level = 1; level < 100; ++level) {\n                addEdge((floor - 1) * 100 + level, (floor - 1) * 100 + level + 1, Integer.MAX_VALUE, c);\n            }\n        }\n\n        int u, v;\n        for (int _ = 0; _ < m; ++_) {\n            u = sc.nextInt();\n            v = sc.nextInt();\n            for (int level = 1; level < 100; ++level) {\n                for (int group = 1; group <= k; ++group) {\n                    int edgeCost = c + d * (group * group - (group - 1) * (group - 1));\n                    addEdge((u - 1) * 100 + level, (v - 1) * 100 + level + 1, 1, edgeCost);\n                    addEdge((v - 1) * 100 + level, (u - 1) * 100 + level + 1, 1, edgeCost)