{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nstruct Ratio {\n    ll num;\n    ll den;\n};\n\nRatio subtract(Ratio a, Ratio b) {\n    ll common = lcm(a.den, b.den);\n    ll na = a.num * (common / a.den);\n    ll nb = b.num * (common / b.den);\n    ll d = na - nb;\n    ll g = gcd(abs(d), common);\n    return {d / g, common / g};\n}\n\nRatio abs_ratio(Ratio a) {\n    if (a.num < 0) a.num = -a.num;\n    return a;\n}\n\nint compare(Ratio a, Ratio b) {\n    ll common = lcm(a.den, b.den);\n    ll na = a.num * (common / a.den);\n    ll nb = b.num * (common / b.den);\n    if (na == nb) return 0;\n    return na < nb ? -1 : 1;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout.tie(nullptr);\n\n    ll x, y, n;\n    cin >> x >> y >> n;\n\n    ll g = gcd(x, y);\n    x /= g;\n    y /= g;\n\n    Ratio target{x, y};\n    Ratio bestDiff{1000000000000LL, 1};\n    Ratio best{0, 0};\n\n    for (ll b = 1; b <= n; ++b) {\n        ll lo = 0;\n        double upper = (double)x / y;\n        upper += (double)bestDiff.num / bestDiff.den;\n        ll hi = (ll)((upper + 2.0) * (double)b);\n\n        while (lo <= hi) {\n            ll mid = lo + (hi - lo) / 2;\n            Ratio cand{mid, b};\n            Ratio diff = abs_ratio(subtract(target, cand));\n            int c = compare(diff, bestDiff);\n\n            if (c == 0) {\n                if (cand.den < best.den ||\n                    (cand.den == best.den && cand.num < best.num)) {\n                    best = cand;\n                }\n            } else if (c < 0) {\n                bestDiff = diff;\n                best = cand;\n            }\n\n            if (compare(cand, target) < 0)\n                lo = mid + 1;\n            else\n                hi = mid - 1;\n        }\n    }\n\n    cout << best.num << \"/\" << best.den;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef subtract(a, b):\n    \"\"\"Return a - b as a tuple (num, den) reduced.\"\"\"\n    common = a[1] * b[1] // math.gcd(a[1], b[1])  # lcm\n    na = a[0] * (common // a[1])\n    nb = b[0] * (common // b[1])\n    d = na - nb\n    g = math.gcd(abs(d), common)\n    return (d // g, common // g)\n\ndef abs_ratio(a):\n    \"\"\"Return absolute value of ratio a.\"\"\"\n    if a[0] < 0:\n        return (-a[0], a[1])\n    return a\n\ndef compare(a, b):\n    \"\"\"Compare two ratios. Return -1 if a < b, 0 if equal, 1 if a > b.\"\"\"\n    common = a[1] * b[1] // math.gcd(a[1], b[1])  # lcm\n    na = a[0] * (common // a[1])\n    nb = b[0] * (common // b[1])\n    if na == nb:\n        return 0\n    return -1 if na < nb else 1\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, n = map(int, data[:3])\n    g = math.gcd(x, y)\n    x //= g\n    y //= g\n\n    target = (x, y)\n    best_diff = (1000000000000, 1)\n    best = (0, 0)\n\n    for b in range(1, n + 1):\n        lo = 0\n        # Compute hi as in C++: (upper + 2.0) * b, where upper = x/y + best_diff.num/best_diff.den\n        upper = x / y + best_diff[0] / best_diff[1]\n        hi = int((upper + 2.0) * b)\n\n        while lo <= hi:\n            mid = lo + (hi - lo) // 2\n            cand = (mid, b)\n            diff = abs_ratio(subtract(target, cand))\n            c = compare(diff, best_diff)\n\n            if c == 0:\n                # same difference, choose smaller denominator or numerator\n                if cand[1] < best[1] or (cand[1] == best[1] and cand[0] < best[0]):\n                    best = cand\n            elif c < 0:\n                best_diff = diff\n                best = cand\n\n            if compare(cand, target) < 0:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n\n    print(f\"{best[0]}/{best[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.02405226044356823, -0.00011836781777674332, 0.0, 0.0, -0.00043299360550008714, -0.0004782725009135902, -0.25192904472351074, -0.0015070997178554535, -0.0007099968497641385, 0.0, -0.008626103401184082, -0.04031004384160042, -0.5248594284057617, -0.002224948490038514, -0.1275974065065384, 0.0, -5.566918844124302e-05, -2.264974000354414e-06, -0.9344176650047302, -0.47175827622413635, -0.04136426001787186, -0.0009600082994438708, 0.0, -0.0028263882268220186, -0.10824011266231537, -0.3196845054626465, -3.6000557884108275e-05, -0.0002057340752799064, -4.768370445162873e-07, -1.4305104514278355e-06, -0.00727149099111557, -0.35490474104881287, -0.009204572066664696, -1.1920928244535389e-07, -0.40512919425964355, -3.6238969187252223e-05, -0.38851243257522583, -0.0007111880695447326, -2.2172682292875834e-05, -3.576278118089249e-07, -0.038042448461055756, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -4.0531076592742465e-06, -1.1920928244535389e-07, 0.0, 0.0, -1.7881377516459906e-06, 0.0, -2.384185