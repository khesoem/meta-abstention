{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\n\nconst int MOD = 1e9 + 7;\n#define BS bitset<128>\nunordered_map<BS, int> id;\nint N, cnt, P[7][7], dp[2][70003], trans[70003][128], prob[128], inv100;\n\nint modpow(long long a, int b) {\n    int res = 1;\n    while (b) {\n        if (b & 1) res = 1LL * res * a % MOD;\n        a = 1LL * a * a % MOD;\n        b >>= 1;\n    }\n    return res;\n}\n\nint dfs(BS &x) {\n    if (id.count(x)) return id[x];\n    int cur = id[x] = ++cnt;\n    BS tmp[7], tp;\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < (1 << N); ++j)\n            if (x[j]) tmp[i][j | (1 << i)] = 1;\n    for (int mask = 0; mask < (1 << N); ++mask) {\n        tp = x;\n        for (int j = 0; j < N; ++j)\n            if (mask >> j & 1) tp |= tmp[j];\n        trans[cur][mask] = dfs(tp);\n    }\n    return cur;\n}\n\nint main() {\n    cin >> N;\n    BS start; start.set(0);\n    dfs(start);\n    inv100 = modpow(100, MOD - 2);\n    cerr << id.size() << endl;\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            cin >> P[i][j];\n    dp[0][1] = 1;\n    int cur = 0;\n    for (int i = 0; i < N; ++i) {\n        for (int mask = 0; mask < (1 << N); ++mask) {\n            long long prod = 1;\n            for (int k = 0; k < N; ++k) {\n                int val = (mask >> k & 1) ? P[i][k] : (100 - P[i][k]);\n                prod = prod * val % MOD;\n            }\n            prob[mask] = prod * modpow(inv100, N) % MOD;\n        }\n        memset(dp[cur ^= 1], 0, sizeof(dp[cur]));\n        for (int j = 1; j <= cnt; ++j) {\n            if (dp[cur ^ 1][j]) {\n                int base = dp[cur ^ 1][j];\n                for (int mask = 0; mask < (1 << N); ++mask) {\n                    int nxt = trans[j][mask];\n                    dp[cur][nxt] = (dp[cur][nxt] + 1LL * base * prob[mask]) % MOD;\n                }\n            }\n        }\n    }\n    BS full;\n    for (int i = 0; i < (1 << N); ++i) full.set(i);\n    cout << dp[cur][id[full]] << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static int N, cnt;\n    static int[][] P;\n    static int[][] dp = new int[2][70003];\n    static int[][] trans = new int[70003][128];\n    static int[] prob = new int[128];\n    static int inv100;\n    static HashMap<BitSet, Integer> id = new HashMap<>();\n\n    static int modpow(long a, int b) {\n        int res = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) res = (int)((long)res * a % MOD);\n            a = (a * a) % MOD;\n            b >>= 1;\n        }\n        return res;\n    }\n\n    static int dfs(BitSet x) {\n        if (id.containsKey(x)) return id.get(x);\n        int cur = ++cnt;\n        id.put((BitSet) x.clone(), cur);\n        BitSet[] tmp = new BitSet[7];\n        for (int i = 0; i < N; ++i) {\n            tmp[i] = new BitSet();\n            for (int j = 0; j < (1 << N); ++j) {\n                if (x.get(j)) {\n                    tmp[i].set(j | (1 << i));\n                }\n            }\n        }\n        for (int mask = 0; mask < (1 << N); ++mask) {\n            BitSet tp = (BitSet) x.clone();\n            for (int j = 0; j < N; ++j) {\n                if ((mask >> j & 1) == 1) {\n                    tp.or(tmp[j]);\n                }\n            }\n            trans[cur][mask] = dfs(tp);\n        }\n        return cur;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        BitSet start = new BitSet();\n        start.set(0);\n        dfs(start);\n        inv100 = modpow(100, MOD - 2);\n        P = new int[N][N];\n        for (int i = 0; i < N; ++i) {\n            for (int j = 0; j < N; ++j) {\n                P[i][j] = sc.nextInt();\n            }\n        }\n        dp[0][1] = 1;\n        int cur = 0;\n        for (int i = 0; i < N; ++i) {\n            for (int mask = 0; mask < (1 << N); ++mask) {\n                long prod = 1;\n                for (int k = 0; k < N; ++k) {\n                    int val = ((mask >> k) & 1) == 1 ? P[i][k] : (100 - P[i][k]);\n                    prod = prod * val % MOD;\n                }\n                prob[mask] = (int)(prod * modpow(inv100, N) % MOD);\n            }\n            cur ^= 1;\n            Arrays.fill(dp[cur], 0);\n            for (int j = 1; j <= cnt; ++j) {\n                if (dp[cur ^ 1][j] != 0) {\n                    int base = dp[cur ^ 1][j];\n                    for (int mask = 0; mask < (1 << N); ++mask) {\n                        int nxt = trans[j][mask];\n                        dp[cur][nxt] = (int)((dp[cur][nxt] + (long)base * prob[mask]) % MOD);\n                    }\n                }\n            }\n        }\n        BitSet full = new BitSet();\n        for (int i = 0; i < (1 << N); ++i) full.set(i);\n        System.out.println(dp[cur][id.get(full)]);\n    }\n}\n</translated_code>\n<confidenc