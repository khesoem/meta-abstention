riginal_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static long digitCount(long x) {\n        int cnt = 0;\n        while (x > 0) {\n            x /= 10;\n            ++cnt;\n        }\n        return cnt;\n    }\n\n    public static long largestRepunit(long x) {\n        int d = (int) digitCount(x);\n        long res = 0;\n        for (int i = 0; i < d; ++i) {\n            res = res * 10 + 1;\n        }\n        if (res <= x) return res;\n        return res / 10;\n    }\n\n    public static long solve(long x) {\n        if (x <= 6) return x;\n        if (x <= 11) return 13 - x;\n\n        long rep = largestRepunit(x);\n        long nextRep = rep * 10 + 1;\n\n        if (x % rep == 0) {\n            if (x <= nextRep / 2 + rep) {\n                return digitCount(rep) * x / rep;\n            }\n            return digitCount(nextRep) + solve(nextRep - x);\n        } else {\n            long base = (x / rep) * rep;\n            long option1 = solve(base) + solve(x - base);\n            long option2 = digitCount(nextRep) + solve(nextRep - x);\n            if (x > nextRep / 2) {\n                return Math.min(option1, option2);\n            }\n            return option1;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long n = scanner.nextLong();\n        System.out.println(solve(n));\n        scanner.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.629103492945433e-05, -3.4570634852570947e-06, -2.3841855067985307e-07, -2.074220174108632e-05, -1.585470999998506e-05, -7.545663538621739e-05, -0.33271706104278564, -3.2186455882765586e-06, -6.747018051100895e-05, -8.344646857949556e-07, -0.00010108436981681734, -0.6931480169296265, -0.12694337964057922, -0.050577908754348755, -4.172