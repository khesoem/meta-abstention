 Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        int m = scanner.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = scanner.nextInt() % m;\n        }\n\n        Set<Integer> left = collectSums(Arrays.copyOfRange(a, 0, n / 2), m);\n        Set<Integer> right = collectSums(Arrays.copyOfRange(a, n / 2, n), m);\n\n        List<Integer> rightSorted = new ArrayList<>(right);\n        Collections.sort(rightSorted);\n        int maxTotal = 0;\n\n        for (int s : left) {\n            int complement = m - s;\n            int idx = Collections.binarySearch(rightSorted, complement);\n            if (idx < 0) {\n                idx = -idx - 1;\n            }\n            \n            int[] indicesToCheck = {idx - 1, idx};\n            for (int j : indicesToCheck) {\n                if (j >= 0 && j < rightSorted.size()) {\n                    int candidate = s + rightSorted.get(j);\n                    if (candidate > maxTotal) {\n                        maxTotal = candidate;\n                    }\n                }\n            }\n        }\n\n        System.out.println(maxTotal);\n    }\n\n    private static Set<Integer> collectSums(int[] arr, int mod) {\n        Set<Integer> result = new HashSet<>();\n        result.add(0);\n        \n        for (int val : arr) {\n            Set<Integer> newResults = new HashSet<>();\n            for (int r : result) {\n                newResults.add((r + val) % mod);\n                newResults.add(r);\n            }\n            result.addAll(newResults);\n        }\n        \n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.343022298300639e-05, -4.768370445162873e-07, -1.1920928244535389e-07, -6.48477507638745e-05, -1.6093124941107817e-05, -0.005929617211222649, -0.5760983228683472, -2.7418097943154862e-06, -5.960462772236497e-07, -0.00016616393986623734, -4.362964682513848e-05, -8.3