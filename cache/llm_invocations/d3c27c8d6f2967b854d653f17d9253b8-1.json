o = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    int n;\n    List<int[]> pos = new ArrayList<>();\n    List<InternalEdge>[] g;\n    long[] dual;\n    long[] dist;\n    int[] pv;\n    int[] pe;\n    boolean[] vis;\n\n    public mcf_graph_int_cost(int n) {\n        this.n = n;\n        this.g = new ArrayList[n];\n        for (int i = 0; i < n; i++) g[i] = new ArrayList<>();\n    }\n\n    public int add_edge(int from, int to, int cap, int cost) {\n        int m = pos.size();\n        pos.add(new int[]{from, g[from].size()});\n        g[from].add(new InternalEdge(to, g[to].size(), cap, cost));\n        g[to].add(new InternalEdge(from, g[from].size() - 1, 0, -cost));\n        return m;\n    }\n\n    private boolean _dual_ref(int s, int t) {\n        dist = new long[n];\n        Arrays.fill(dist, 4294967295L);\n        pv = new int[n];\n        Arrays.fill(pv, -1);\n        pe = new int[n];\n        Arrays.fill(pe, -1);\n        vis = new boolean[n];\n\n        PriorityQueue<Node> pq = new PriorityQueue<>();\n        dist[s] = 0;\n        pq.add(new Node(0, s));\n\n        while (!pq.isEmpty()) {\n            Node current = pq.poll();\n            int v = current.v;\n            if (vis[v]) continue;\n            vis[v] = true;\n            if (v == t) break;\n\n            for (int i = 0; i < g[v].size(); i++) {\n                InternalEdge e = g[v].get(i);\n                if (vis[e.to] || e.cap == 0) continue;\n                long cost = e.cost - dual[e.to] + dual[v];\n                if (dist[e.to] > dist[v] + cost) {\n                    dist[e.to] = dist[v] + cost;\n                    pv[e.to] = v;\n                    pe[e.to] = i;\n                    pq.add(new Node(dist[e.to], e.to));\n                }\n            }\n        }\n\n        if (!vis[t]) return false;\n\n        for (int v = 0; v < n; v++) {\n            if (!vis[v]) continue;\n            dual[v] -= (dist[t] - dist[v]);\n        }\n        return true;\n    }\n\n    public List<long[]> slope(int s, int t, long flowLimit) {\n        dual = new long[n];\n        long flow = 0;\n        long cost = 0;\n        long prevCost = -1;\n        List<long[]> result = new ArrayList<>();\n        result.add(new long[]{flow, cost});\n\n        while (flow < flowLimit) {\n            if (!_dual_ref(s, t)) break;\n            long c = flowLimit - flow;\n            int v = t;\n            while (v != s) {\n                c = Math.min(c, g[pv[v]].get(pe[v]).cap);\n                v = pv[v];\n            }\n            v = t;\n            while (v != s) {\n                InternalEdge e = g[pv[v]].get(pe[v]);\n                e.cap -= c;\n                g[v].get(e.rev).cap += c;\n                v = pv[v];\n            }\n            long d = -dual[s];\n            flow += c;\n            cost += c * d;\n            if (prevCost == d) {\n                result.remove(result.size() - 1);\n            }\n            result.add(new long[]{flow, cost});\n            prevCost = d;\n        }\n        return result;\n    }\n\n    public long[] flow(int s, int t) {\n        List<long[]> res = slope(s, t, 4294967295L);\n        return res.get(res.size() - 1);\n    }\n\n    static class Node implements Comparable<Node> {\n        long d;\n        int v;\n        Node(long d, int v) { this.d = d; this.v = v; }\n        public int compareTo(Node other) {\n            if (this.d != other.d) return Long.compare(this.d, other.d);\n            return Integer.compare(this.v, other.v);\n        }\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (!sc.hasNextInt()) return;\n        int n = sc.nextInt();\n        int a1 = sc.nextInt();\n        int a2 = sc.nextInt();\n        int a3 = sc.nextInt();\n        int b1 = sc.nextInt();\n        int b2 = sc.nextInt();\n        int b3 = sc.nextInt();\n\n        mcf_graph_int_cost g = new 