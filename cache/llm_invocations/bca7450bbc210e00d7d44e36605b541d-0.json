ithmetic\")\n            return Modular((self.val * inv) % MOD)\n        inv = mod_inv(other)\n        if inv == -1:\n            raise ValueError(\"Cannot divide by zero in modular arithmetic\")\n        return Modular((self.val * inv) % MOD)\n    \n    def __eq__(self, other):\n        if isinstance(other, Modular):\n            return self.val == other.val\n        return self.val == other\n    \n    def __repr__(self):\n        return str(self.val)\n\ndef main():\n    # Fast I/O\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    \n    n = int(data[idx])\n    idx += 1\n    \n    # Read probability matrix\n    p = [[Modular(0) for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            val = int(data[idx])\n            idx += 1\n            p[i][j] = Modular(val) / 100\n    \n    # Precompute 'no' array\n    no = [0] * 7\n    for i in range(n):\n        for j in range(1 << n):\n            if not ((j >> i) & 1):\n                no[i] |= (1 << j)\n    \n    # Initialize map\n    m = defaultdict(lambda: Modular(0))\n    m[1] = Modular(1)\n    \n    # Process each round\n    for i in range(n):\n        M = defaultdict(lambda: Modular(0))\n        for t_val, t_prob in m.items():\n            for j in range(1 << n):\n                res = 0\n                prob = Modular(1)\n                for k in range(n):\n                    if j & (1 << k):\n                        prob *= p[i][k]\n                        res |= (t_val & no[k]) << (1 << k)\n                    else:\n                        prob *= (Modular(1) - p[i][k])\n                M[res] += t_prob * prob\n        m = M\n    \n    # Output result\n    result_key = (1 << ((1 << n) - 1))\n    print(m[result_key].val)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00018571082910057157, -2.50339189733495e-06, -8.344646857949556e-07, -0.0012484145117923617, -0.0005036516