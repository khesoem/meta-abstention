e] = 0;\n            heap.emplace(0, source);\n\n            while (!heap.empty()) {\n                auto [d, u] = heap.top(); heap.pop();\n                if (d != dist[u]) continue;\n                for (int idx = 0; idx < adj[u].size(); ++idx) {\n                    auto& e = adj[u][idx];\n                    if (e.capacity > 0 && dist[e.dest] > dist[u] + e.weight + potential[u] - potential[e.dest]) {\n                        dist[e.dest] = dist[u] + e.weight + potential[u] - potential[e.dest];\n                        parent_node[e.dest] = u;\n                        parent_edge[e.dest] = idx;\n                        heap.emplace(dist[e.dest], e.dest);\n                    }\n                }\n            }\n\n            if (dist[sink] == LLONG_MAX) return -1;\n            for (int i = 0; i < num_nodes; ++i) potential[i] += dist[i];\n\n            llong flow = required_flow;\n            for (int node = sink; node != source; node = parent_node[node]) {\n                flow = min(flow, adj[parent_node[node]][parent_edge[node]].capacity);\n            }\n\n            required_flow -= flow;\n            total += flow * potential[sink];\n\n            for (int node = sink; node != source; node = parent_node[node]) {\n                auto& e = adj[parent_node[node]][parent_edge[node]];\n                e.capacity -= flow;\n                adj[node][e.reverse_index].capacity += flow;\n            }\n        }\n        return total;\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    llong N, M, K, C, D;\n    cin >> N >> M >> K >> C >> D;\n\n    vector<int> starts(K);\n    for (int i = 0; i < K; ++i) {\n        cin >> starts[i];\n        --starts[i];\n    }\n\n    vector<int> from_nodes(M), to_nodes(M);\n    for (int i = 0; i < M; ++i) {\n        cin >> from_nodes[i] >> to_nodes[i];\n        --from_nodes[i];\n        --to_nodes[i];\n    }\n\n    MinCostFlow network(N * 101 + 2);\n    int source = N * 101;\n    int sink 