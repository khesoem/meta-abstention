ner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        \n        int[] l = new int[n];\n        for (int i = 0; i < n; i++) {\n            l[i] = sc.nextInt();\n        }\n        \n        int n1 = n / 2;\n        int n2 = n / 2 + n % 2;\n        \n        int[] first = new int[n1];\n        int[] sec = new int[n2];\n        \n        for (int i = 0; i < n1; i++) {\n            first[i] = l[i];\n        }\n        for (int i = 0; i < n2; i++) {\n            sec[i] = l[n1 + i];\n        }\n        \n        int t1 = 1 << n1;\n        int t2 = 1 << n2;\n        \n        List<Integer> s1 = new ArrayList<>();\n        for (int i = 0; i < t1; i++) {\n            int now = 0;\n            for (int j = 0; j < n1; j++) {\n                if ((i & (1 << j)) != 0) {\n                    now += first[j];\n                }\n            }\n            s1.add(now % m);\n        }\n        \n        List<Integer> s2 = new ArrayList<>();\n        for (int i = 0; i < t2; i++) {\n            int now = 0;\n            for (int j = 0; j < n2; j++) {\n                if ((i & (1 << j)) != 0) {\n                    now += sec[j];\n                }\n            }\n            s2.add(now % m);\n        }\n        \n        Collections.sort(s1);\n        Collections.sort(s2);\n        \n        int maxi = 0;\n        \n        for (int i : s1) {\n            int req = m - i;\n            int pair = check(s2, req);\n            maxi = Math.max(maxi, (i + pair) % m);\n        }\n        \n        System.out.println(maxi);\n    }\n    \n    // largest number less than x in l (l is ascending)\n    private static int check(List<Integer> l, int x) {\n        int lo = 0;\n        int hi = l.size() - 1;\n        int ans = 0;\n        \n        while (lo <= hi) {\n            int mi = (lo + hi) >> 1;\n            if (l.get(mi) < x) {\n                ans = l.get(mi);\n                lo = mi + 1;\n            } else {\n                hi = mi - 1;\n            }\n        }\n        \n        return ans;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.095255518332124e-05, -1.4305104514278355e-06, -7.152555099310121e-07, -0.00010549465514486656, -3.731181277544238e-05, -0.001929447171278298, -0.06930065155029297, -8.583032467868179e-06, -8.344646857949556e-07, -0.00010966652916977182, -8.570780482841656e-05, -4.172238186583854e-05, -3.242440288886428e-05, -3.2186455882765586e-06, -9.643566590966657e-05, -4.291525328881107e-06, -7.152555099310121e-07, -3.576272320060525e-06, -5.435795901576057e-05, -2.3841830625315197e-06, -7.152555099310121e-07, -1.7881377516459906e-06, -5.936446541454643e-05, -0.021456029266119003, -6.198863957251888e-06, -3.576278118089249e-07, -1.549708758830093e-05, -2.9802276912960224e-06, -1.5497195136049413e-06, -2.145764938177308e-06, -0.0011706650257110596, -7.4741430580616e-05, -3.576278118089249e-07, 0.0, -2.264974000354414e-06, -3.576272320060525e-06, -9.536738616588991e-07, -5.960462772236497e-07, 0.0, -3.576278118089249e-07, -4.887569048150908e-06, -4.768370445162873e-07, -7.152555099310121e-07, -2.3841855067985307e-07, -0.6326020359992981, -7.152555099310121e-07, -0.0015789910685271025, -8.344646857949556e-07, -1.9073468138230965e-06, -3.576278118089249e-07, -1.9073468138230965e-06, -3.576278118089249e-07, -2.861018856492592e-06, -1.764281842042692e-05, -3.576278118089249e-07, -8.344646857949556e-07, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -2.264974000354414e-06, -4.0531076592742465e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.152555099310121e-07, 0.0, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -4.768370445162873e-07, -6.198863957251888e-06, -4.0531076592742465e-06, -2.3841855067985307e-07, -2.5510462364763953e-05, -3.576278118089249e-07, -1.5139465176616795e-05, -1.4305104514278355e-