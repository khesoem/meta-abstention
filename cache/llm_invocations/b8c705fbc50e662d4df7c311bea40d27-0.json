{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int MAXN = 15000;\nstruct Edge {\n    int to, cap, flow, cost;\n};\nvector<Edge> e;\nvector<int> adj[MAXN];\nlong long ans, dist[MAXN];\nint n, m, k, c, d, parent[MAXN], parent_edge[MAXN], in_queue[MAXN], src = 9998, sink = 9999;\n\nvoid add_edge(int x, int y, int cap, int cost) {\n    adj[x].push_back(e.size());\n    e.push_back({y, cap, 0, cost});\n    adj[y].push_back(e.size());\n    e.push_back({x, 0, 0, -cost});\n}\n\nvoid push_rebel() {\n    fill(dist, dist + 10000, (long long)1e18);\n    fill(parent, parent + 10000, -1);\n    fill(parent_edge, parent_edge + 10000, -1);\n    fill(in_queue, in_queue + 10000, 0);\n    dist[src] = 0;\n    queue<int> q;\n    q.push(src);\n    in_queue[src] = 1;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        in_queue[u] = 0;\n        for (int idx : adj[u]) {\n            if (!(e[idx].cap - e[idx].flow)) continue;\n            int cost = e[idx].cost, v = e[idx].to;\n            if (dist[v] > dist[u] + cost) {\n                dist[v] = dist[u] + cost;\n                parent[v] = u;\n                parent_edge[v] = idx;\n                if (!in_queue[v]) {\n                    in_queue[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    int cur = sink;\n    while (cur != src) {\n        e[parent_edge[cur]].flow++;\n        e[parent_edge[cur] ^ 1].flow--;\n        cur = parent[cur];\n    }\n    ans += dist[sink];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> n >> m >> k >> c >> d;\n    int x, y;\n    for (int i = 1; i <= k; i++) {\n        cin >> x;\n        x--;\n        add_edge(src, x, 1, 0);\n    }\n    for (int i = 1; i <= 101; i++)\n        add_edge((i - 1) * n, sink, k, (i - 1) * c);\n    for (int i = 1; i <= m; i++) {\n        cin >> x >> y;\n        x--; y--;\n        for (int i = 1; i <= 100; i++)\n            for (int j = 1; j <= k; j++) {\n                add_edge(x + (i - 1) * n, y + (i - 1) * n + n, 1, d * ((j - 1) * 2 + 1));\n                add_edge(y + (i - 1) * n, x + (i - 1) * n + n, 1, d * ((j - 1) * 2 + 1));\n            }\n    }\n    for (int i = 1; i <= n; i++)\n        for (int j = 1; j <= 100; j++)\n            add_edge(i - 1 + (j - 1) * n, i - 1 + (j - 1) * n + n, k, 0);\n    for (int i = 1; i <= k; i++) push_rebel();\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, flow, cost;\n        Edge(int to, int cap, int flow, int cost) {\n            this.to = to;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final int MAXN = 15000;\n    static ArrayList<Edge> e = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[MAXN];\n    static long ans;\n    static long[] dist = new long[10000];\n    static int[