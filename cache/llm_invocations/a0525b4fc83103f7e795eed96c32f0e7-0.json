n() {\n    fill(head, head + maxn, -1);\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &a[i]), add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &x[i], &y[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            int lim = min(k, 25);\n            for (int j = 1; j <= lim; j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int maxn = 6010;\n    static int n, m, k, c, d, cnt = 0, ans = 0;\n    static int[] a = new int[maxn];\n    static int[] x = new int[maxn];\n    static int[] y = new int[maxn];\n    static int[] head = new int[maxn];\n    static int[] pre = new int[maxn];\n    static int[] dist = new int[maxn];\n    static int[] inq = new int[maxn];\n    static Edge[] e = new Edge[2000010];\n    static Queue<Integer> q = new LinkedList<>();\n\n    static class Edge {\n        int to, cap, cost, nxt;\n        Edge(int to, int cap, int cost, int nxt) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.nxt = nxt;\n        }\n    }\n\n    static int id(int t, int v) {\n        return t * n + v;\n    }\n\n    static void add(int from, int to, int cap, int cost) {\n        e[cnt] = new Edge(to, cap, cost, head[from]);\n        head[from] = cnt++;\n        e[cnt] =