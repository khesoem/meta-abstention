2r * b2r - a2i * b2i\n        cr2[i] = a1r * b2r - a1i * b2i + a2r * b1r - a2i * b1i\n        ci2[i] = a1r * b2i + a1i * b2r + a2r * b1i + a2i * b1r\n    \n    fft(cr1, ci1, True)\n    fft(cr2, ci2, True)\n    \n    res = [0] * need\n    for i in range(need):\n        aa = round(cr1[i])\n        bb = round(cr2[i])\n        cc = round(ci1[i])\n        res[i] = int((aa + ((bb % mod) << 15) + ((cc % mod) << 30)) % mod)\n    \n    return res\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n = int(input_data[0])\n    k = int(input_data[1])\n    \n    v = [0] * 10\n    idx = 2\n    for _ in range(k):\n        pos = int(input_data[idx])\n        idx += 1\n        v[pos] = 1\n    \n    ans = [1]\n    p = n // 2\n    \n    while True:\n        if p & 1:\n            ans = multiply(ans, v, 998244353)\n        p >>= 1\n        if p == 0:\n            break\n        v = multiply(v, v, 998244353)\n    \n    res = 0\n    for x in ans:\n        res = (res + x * x) % 998244353\n    \n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.794698856538162e-05, -4.768370445162873e-07, -3.576278118089249e-07, -0.00040820849244482815, -0.05649702623486519, -1.5258672647178173e-05, -0.0006304183625616133, -0.0055478415451943874, -0.1798630654811859, -0.009809738956391811, -0.8922290205955505, -0.005128798540681601, -7.986990567587782e-06, -6.318072337307967e-06, -1.1920928244535389e-07, -0.0005734706646762788, -0.00023946279543451965, -7.152555099310121e-07, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0007229813490994275, -5.960462772236497e-07, -2.3841855067985307e-07, -1.4543427823809907e-05, -0.636150062084198, -8.344646857949556e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.024524519219994545, -9.262132516596466e-05, -0.014027572236955166, -0.00033384948619641364, -2.2649740