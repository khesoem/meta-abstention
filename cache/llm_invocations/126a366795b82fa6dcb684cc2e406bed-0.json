answer = mod.mult(answer, 2, mod.ncr(n, c));\n            out.println(answer);\n        }\n    }\n\n    static class Mod998 extends Modulus<Mod998> {\n        public long modulus() {\n            return 998_244_353L;\n        }\n    }\n\n    abstract static class Modulus<M extends Modulus<M>> {\n        private final List<Long> factorial = new ArrayList<>();\n        private final List<Long> invFactorial = new ArrayList<>();\n\n        public abstract long modulus();\n\n        public Modulus() {\n            factorial.add(1L);\n            invFactorial.add(1L);\n        }\n\n        public long fact(int n) {\n            while (factorial.size() <= n) {\n                factorial.add(mult(factorial.get(factorial.size() - 1), factorial.size()));\n            }\n            return factorial.get(n);\n        }\n\n        public long fInv(int n) {\n            int last = invFactorial.size() - 1;\n            if (last < n) {\n                long[] temp = new long[n - last];\n                temp[0] = inv(fact(n));\n                for (int i = 1; i < temp.length; i++) {\n                    temp[i] = mult(temp[i - 1], n - i + 1);\n                }\n                for (int i = temp.length - 1; i >= 0; i--) {\n                    invFactorial.add(temp[i]);\n                }\n            }\n            return invFactorial.get(n);\n        }\n\n        public long paritySign(long k) {\n            return (k & 1) == 0 ? 1 : modulus() - 1;\n        }\n\n        public long ncr(int n, int r) {\n            if (r < 0 || n < r) return 0;\n            return mult(fact(n), mult(fInv(r), fInv(n - r)));\n        }\n\n        public long normalize(long x) {\n            x %= modulus();\n            if (x < 0) x += modulus();\n            return x;\n        }\n\n        public long add(long a, long b) {\n            long v = a + b;\n            return v < modulus() ? v : v - modulus();\n        }\n\n        public long mult(long... args) {\n            long r = 1;\n            for 