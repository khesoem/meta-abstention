_init__(self):\n        self.modulus_val = 998244353\n        self.factorial = [1]\n        self.invFactorial = [1]\n    \n    def fact(self, n):\n        while len(self.factorial) <= n:\n            self.factorial.append((self.factorial[-1] * len(self.factorial)) % self.modulus_val)\n        return self.factorial[n]\n    \n    def fInv(self, n):\n        last = len(self.invFactorial) - 1\n        if last < n:\n            temp = [0] * (n - last)\n            temp[0] = pow(self.fact(n), self.modulus_val - 2, self.modulus_val)\n            for i in range(1, len(temp)):\n                temp[i] = (temp[i - 1] * (n - i + 1)) % self.modulus_val\n            for i in range(len(temp) - 1, -1, -1):\n                self.invFactorial.append(temp[i])\n        return self.invFactorial[n]\n    \n    def paritySign(self, k):\n        return 1 if (k & 1) == 0 else self.modulus_val - 1\n    \n    def ncr(self, n, r):\n        if r < 0 or n < r:\n            return 0\n        return (self.fact(n) * self.fInv(r) % self.modulus_val) * self.fInv(n - r) % self.modulus_val\n    \n    def normalize(self, x):\n        x %= self.modulus_val\n        if x < 0:\n            x += self.modulus_val\n        return x\n    \n    def add(self, a, b):\n        v = a + b\n        return v if v < self.modulus_val else v - self.modulus_val\n    \n    def mult(self, *args):\n        r = 1\n        for x in args:\n            r = (r * x) % self.modulus_val\n        return r\n    \n    def pow(self, base, exp):\n        if exp < 0:\n            base = self.inv(base)\n            exp = -exp\n        res = 1\n        while exp > 0:\n            if (exp & 1) == 1:\n                res = (res * base) % self.modulus_val\n            base = (base * base) % self.modulus_val\n            exp >>= 1\n        return res\n    \n    def inv(self, val):\n        g, x, y = self.modulus_val, 0, 1\n        r = val\n        while r != 0:\n            q = g // r\n            t = g % r\n            g, r = r, t\n            t = x\n            x = y\n            y = t - q * y\n        return self.normalize(x)\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n    \n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    raise EOFError()\n                self.tokenizer = line.strip().split()\n            except EOFError:\n                sys.exit(1)\n        return self.tokenizer.pop(0)\n    \n    def nextInt(self):\n        return int(self.next())\n    \n    def nextLong(self):\n        return int(self.next())\n\ndef main():\n    in_reader = InputReader(sys.stdin)\n    out = sys.stdout\n    solver = EPlacingRooks()\n    solver.solve(1, in_reader, out)\n    out.close()\n\nclass EPlacingRooks:\n    def __init__(self):\n        self.mod = Mod998()\n    \n    def solve(self, testNumber, in_reader, out):\n        n = in_reader.nextInt()\n        k = in_reader.nextLong()\n        if k == 0:\n            out.write(str(self.mod.fact(n)) + \"\\n\")\n            return\n        \n        if k > n - 1:\n            out.write(\"0\\n\")\n            return\n        \n        c = n - int(k)\n        \n        answer = 0\n        for i in range(1, c + 1):\n            term = self.mod.mult(self.mod.paritySign(c - i), self.mod.ncr(c, i), self.mod.pow(i, n))\n            answer = self.mod.add(answer, term)\n        \n        answer = self.mod.mult(answer, 2, self.mod.ncr(n, c))\n        out.write(str(answer) + \"\\n\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.007967749610543e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.00032431588624604046, -0.004206143785268068, -0.002188313053920865, -0.127015620470047, -0.017031364142894745, -0.03367308899760246, -0.010796467773616314, -0.004307278897613287, -0.2015711069