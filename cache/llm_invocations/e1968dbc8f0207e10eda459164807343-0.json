ss Main {\n    static final long MOD = 1000000007L;\n    static final long INF = 1L << 28;\n    \n    static int K;\n    static long N;\n    static long[][][] R = new long[40][101][101];\n    static long[][][][] D = new long[100][40][101][101];\n    \n    static void resize_mat(long[][] A, int r, int c) {\n        for (int i = 0; i < r; i++) {\n            Arrays.fill(A[i], 0L);\n        }\n    }\n    \n    static long[][] matrix_product(long[][] A, long[][] B) {\n        int n = A.length, m = B.length, p = B[0].length;\n        long[][] C = new long[n][p];\n        for (int i = 0; i < n; ++i) {\n            for (int k = 0; k < m; ++k) {\n                if (A[i][k] == 0) continue;\n                for (int j = 0; j < p; ++j) {\n                    C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD;\n                }\n            }\n        }\n        return C;\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        N = Long.parseLong(st.nextToken());\n        K = Integer.parseInt(st.nextToken());\n        \n        List<Integer> digits = new ArrayList<>();\n        long base_val = 1;\n        while (base_val <= N / K) base_val *= K;\n        \n        while (base_val > 0) {\n            digits.add((int)(N / base_val));\n            N %= base_val;\n            if (base_val == 1) break;\n            base_val /= K;\n        }\n        \n        int n_digits = digits.size();\n        \n        for (int j = 0; j <= K; ++j) {\n            R[j] = new long[K + 1][K + 1];\n            resize_mat(R[j], K + 1, K + 1);\n        }\n        for (int i = 0; i <= n_digits; ++i) {\n            for (int j = 0; j < K; ++j) {\n                D[i][j] = new long[K + 1][K + 1];\n                resize_mat(D[i][j], K + 1, K + 1);\n            }\n        }\n        \n        R[0][K][K] = R[1][K][K] = 1;\n        for