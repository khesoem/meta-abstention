blic class Main {\n    static final int MOD = 1000000007;\n\n    static int add(int a, int b) {\n        return (a += b) >= MOD ? a - MOD : a;\n    }\n\n    static long mul(long a, long b) {\n        return (a * b) % MOD;\n    }\n\n    static class Matrix {\n        int[][] data;\n        int N, M;\n\n        Matrix(int n, int m) {\n            N = n;\n            M = m;\n            data = new int[N][M];\n        }\n\n        void reset() {\n            for (int i = 0; i < N; i++) {\n                Arrays.fill(data[i], 0);\n            }\n        }\n\n        void setIdentity() {\n            reset();\n            for (int i = 0; i < Math.min(N, M); ++i) {\n                data[i][i] = 1;\n            }\n        }\n\n        static Matrix multiply(Matrix a, Matrix b) {\n            Matrix res = new Matrix(a.N, b.M);\n            res.reset();\n            for (int i = 0; i < a.N; ++i) {\n                for (int j = 0; j < a.M; ++j) {\n                    if (a.data[i][j] != 0) {\n                        for (int k = 0; k < b.M; ++k) {\n                            res.data[i][k] = add(res.data[i][k], (int) mul(a.data[i][j], b.data[j][k]));\n                        }\n                    }\n                }\n            }\n            return res;\n        }\n\n        Matrix add(Matrix other) {\n            Matrix res = new Matrix(N, M);\n            for (int i = 0; i < N; ++i) {\n                for (int j = 0; j < M; ++j) {\n                    res.data[i][j] = add(data[i][j], other.data[i][j]);\n                }\n            }\n            return res;\n        }\n\n        Matrix multiply(int scalar) {\n            Matrix res = new Matrix(N, M);\n            for (int i = 0; i < N; ++i) {\n                for (int j = 0; j < M; ++j) {\n                    res.data[i][j] = (int) mul(data[i][j], scalar);\n                }\n            }\n            return res;\n        }\n\n        int[] getRow(int idx) {\n            return data[idx];\n        }\n    }\n\n    p