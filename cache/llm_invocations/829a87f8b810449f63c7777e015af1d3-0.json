ont();\n        q.pop();\n        vis[u] = false;\n        for (int i = head[u]; i != -1; i = edge[i].next)\n        {\n            int v = edge[i].to;\n\n            if (edge[i].cap > edge[i].flow &&\n                dis[v] > dis[u] + edge[i].cost)\n            {\n                dis[v] = dis[u] + edge[i].cost;\n                pre[v] = i;\n                if (!vis[v])\n                {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    if (pre[t] == -1)\n        return false;\n    else\n        return true;\n}\n//\u8fd4\u56de\u7684\u662f\u6700\u5927\u6d41,cost\u5b58\u7684\u662f\u6700\u5c0f\u8d39\u7528\nint minCostMaxflow(int s, int t, int &cost)\n{\n    int flow = 0;\n    cost = 0;\n    while (spfa(s, t))\n    {\n        int Min = INF;\n        for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to])\n        {\n            if (Min > edge[i].cap - edge[i].flow)\n                Min = edge[i].cap - edge[i].flow;\n        }\n        for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to])\n        {\n            edge[i].flow += Min;\n            edge[i ^ 1].flow -= Min;\n            cost += edge[i].cost * Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\n\nint main()\n{\n    cin >> n >> m >> k >> c >> d;\n    init(MAXN);\n    for(int i = 0; i < k; i++)\n    {\n        int x;\n        cin >> x;\n        addedge(0, x, 1, 0);\n    }\n    for(int i = 0; i < 100; i++)\n    {\n        for(int j = 0; j < k; j++)\n            addedge(1+i*n, 9999, 1, i*c);\n    }\n    for(int i = 0; i < m; i++)\n    {\n        int u, v;\n        cin >> u >> v;\n        for(int j = 1; j < 100; j++)\n        {\n            for(int gg = 1; gg <= k; gg++)\n            {\n                addedge(u+(j-1)*n, v+j*n, 1, (2*gg-1)*d);\n                addedge(v+(j-1)*n, u+j*n, 1, (2*gg-1)*d);\n            }\n        }\n    }\n    for(int i = 1; i <= n; i++)\n    {\n        for(int j = 1; j < 100; j++)\n        {\n            addedge(i+(j-1)*n, i+j*n, k, 0);\n        }\n    }\n    \n    int cost;\n    minCostMaxflow(0, 9999, cost);\n    cout << cost << endl;\n}\n\n/*\n3 2 4 2 3\n3 3 3 3\n1 2\n2 3\n */\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 10000;\n    static final int MAXM = 2000000;\n    static final int INF = 0x3f3f3f3f;\n\n    static int n, m, k, c, d;\n\n    static class Edge {\n        int to, next, cap, flow, cost;\n        Edge(int to, int next, int cap, int flow, int cost) {\n            this.to = to;\n            this.next = next;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static Edge[] edge = new Edge[MAXM];\n    static int[] head = new int[MAXN];\n    static int tol;\n    static int[] pre = new int[MAXN];\n    static int[] dis = new int[MAXN];\n    static boolean[] vis = new boolean[MAXN];\n    static int N; //\u8282\u70b9\u603b\u4e2a\u6570,\u8282\u70b9\u7f16\u53f7\u4ece0~N-1\n\n    static void init(int n) {\n        N = n;\n        tol = 0;\n        Arrays.fill(head, -1);\n    }\n\n    static void addedge(int u, int v, int cap, int cost) {\n        edge[tol] = new Edge(v, head[u], cap, 0, cost);\n        head[u] = tol++;\n        edge[tol] = new Edge(u, head[v], 0, 0, -cost);\n        head[v] = tol++;\n    }\n\n    static boolean spfa(int s, int t) {\n        Queue<Integer> q = new LinkedList<>();\n        Arrays.fill(dis, INF);\n        Arrays.fill(vis, false);\n        Arrays.fill(pre, -1);\n        dis[s] = 0;\n        vis[s] = true;\n        q.offer(s);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != -1; i = edge[i].next) {\n                int v = edge[i].to;\n                if (edge[i].cap > edge[i].flow && dis[v] > dis[u] + edge[i].cost) {\n                    dis[v] = dis[u] + edge[i].cost;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return pre[t] != -1;\n    }\n\n    static int minCostMaxflow(int s, int t, int[] cost) {\n        int flow = 0;\n        cost[0] = 0;\n        while (spfa(s, t)) {\n            int Min = INF;\n            for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n                if (Min > edge[i].cap - edge[i].flow) {\n                    Min = edge[i].cap - edge[i].flow;\n                }\n            }\n            for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n                edge[i].flow += Min;\n                edge[i ^ 1].flow -= Min;\n                cost[0] += edge[i].cost * Min;\n            }\n            flow += Min;\n        }\n        return flow;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        k = scanner.nextInt();\n        c = scanner.nextInt();\n        d = scanner.nextInt();\n        init(MAXN);\n        for (int i = 0; i < k; i++) {\n            int x = scanner.nextInt();\n            addedge(0, x, 1, 0);\n        }\n        for (int i = 0; i < 100; i++) {\n            for (int j = 0; j < k; j++) {\n                addedge(1 + i * n, 9999, 1, i * c);\n            }\n        }\n        for (int i = 0; i < m; i++) {\n            int u = scanner.nextInt();\n            int v = scanner.nextInt();\n            for (int j = 1; j < 100; j++) {\n                for (int gg = 1; gg <= k; gg++) {\n                    addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                    addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n                }\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                addedge(i + (j - 1) * n, i + j * n, k, 0);\n            }\n        }\n        int[] cost = new int[1];\n        minCostMaxflow(0, 9999, cost);\n        System.out.println(cost[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014423283573705703, -1.9073468138230965e-06, -8.344646857949556e-07, -0.0017561980057507753, -4.279521817807108e-05, -0.020544586703181267, -0.07899858802556992, -7.60526381782256e-05, -2.3841855067985307e-07, -0.0004640932602342218, -0.07889118045568466, -0.0006269635050557554, -0.0021577426232397556, -0.07092403620481491, -9.536738616588991e-07, -1.9788545614574105e-05, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -1.311301275563892e-06, -4.768370445162873e-07, -1.5497195136049413e-06, -1.1920922133867862e-06, -2.264974000354414e-06, -9.536738616588991e-07, -0.002482667798176408, 0.0, -2.3841855067985307e-07, 0.0, -1.0728830375228426e-06, -3.576278118089249e-07, 0.0, 0.0, -4.768370445162873e-07, -5.960462772236497e-07, -1.1205610462639015e-05, -1.4305104514278355e-06, -8.702239938429557e-06, -1.0728830375228426e-06, -9.894321920000948e-06, -7.152555099310121e-07, -7.390948667307384e-06, -2.3841855067985307e-07, -1.5020257706055418e-05, -3.576278118089249e-07, -2.4318398573086597e-05, -8.344646857949556e-07, -3.099436753473128e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -2.0265558760002023e-06, -1.4305104514278355e-06, -0.06196828559041023, -1.1920928244535389e-07, -0.00010835537250386551, -0.2818993031978607, -0.0028190179727971554, -4.768370445162873e-07, -7.152555099310121e-07, -8.344646857949556e-07, -3.242440288886428e-05, -4.792098479811102e-05, -4.0531076592742465e-06, -7.629365427419543e-06, -2.0265558760002023e-06, -0.07889051735401154, -3.576278118089249e-07, -3.933898824470816e-06, -4.6967357775429264e-05, -2.01461662072688