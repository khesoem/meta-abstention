t i = n; i > 0; i--) {\n            invFact[i - 1] = invFact[i] * i % MOD;\n        }\n\n        long diff = 0;\n        for (int i = 0; i <= m; i++) {\n            long c = fact[(int) m] * invFact[i] % MOD * invFact[(int) (m - i)] % MOD;\n            long p = modPow(m - i, n);\n            long term = c * p % MOD;\n            if ((i & 1) == 0) diff = (diff + term) % MOD;\n            else diff = (diff - term + MOD) % MOD;\n        }\n\n        long comb = fact[(int) n] * invFact[(int) m] % MOD * invFact[(int) (n - m)] % MOD;\n        long ans = diff * comb % MOD;\n\n        if (m != n) {\n            ans = ans * 2 % MOD;\n        }\n\n        System.out.println(ans);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <sstream>\n\nusing namespace std;\n\nconst long long MOD = 998244353;\n\nlong long modPow(long long base, long long exp) {\n    base %= MOD;\n    long long res = 1;\n    while (exp > 0) {\n        if ((exp & 1) == 1) res = (res * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    \n    long long n, k;\n    ss >> n >> k;\n    \n    long long m = n - k;\n    if (k >= n) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    vector<long long> fact(n + 1);\n    vector<long long> invFact(n + 1);\n    \n    fact[0] = 1;\n    for (int i = 1; i <= n; i++) {\n        fact[i] = fact[i - 1] * i % MOD;\n    }\n    \n    invFact[n] = modPow(fact[n], MOD - 2);\n    for (int i = n; i > 0; i--) {\n        invFact[i - 1] = invFact[i] * i % MOD;\n    }\n    \n    long long diff = 0;\n    for (int i = 0; i <= m; i++) {\n        long long c = fact[m] * invFact[i] % MOD * invFact[m - i] % MOD;\n        long long p = modPow(m - i, n);\n   