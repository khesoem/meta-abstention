     this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static final long INF = (long) 1e18;\n    static final int MAXN = 6000;\n    static ArrayList<Edge>[] g;\n    static long[] dis;\n    static int[] pv, pe;\n    static boolean[] ins;\n    static int ncnt, src, snk;\n\n    static void init_graph(int n, int s, int t) {\n        g = new ArrayList[n + 1];\n        for (int i = 0; i <= n; i++) g[i] = new ArrayList<>();\n        ncnt = n;\n        src = s;\n        snk = t;\n        dis = new long[n + 1];\n        pv = new int[n + 1];\n        pe = new int[n + 1];\n        ins = new boolean[n + 1];\n    }\n\n    static void add_arc(int u, int v, long cap, long cost) {\n        g[u].add(new Edge(v, g[v].size(), cap, cost));\n        g[v].add(new Edge(u, g[u].size() - 1, 0, -cost));\n    }\n\n    static long min_cost_max_flow(long need) {\n        long ans = 0;\n        while (need > 0) {\n            Arrays.fill(dis, INF);\n            dis[src] = 0;\n            Deque<Integer> q = new ArrayDeque<>();\n            q.addLast(src);\n            ins[src] = true;\n            while (!q.isEmpty()) {\n                int u = q.pollFirst();\n                ins[u] = false;\n                for (int i = 0; i < g[u].size(); i++) {\n                    Edge e = g[u].get(i);\n                    if (e.cap > 0 && dis[u] + e.cost < dis[e.to]) {\n                        dis[e.to] = dis[u] + e.cost;\n                        pv[e.to] = u;\n                        pe[e.to] = i;\n                        if (!ins[e.to]) {\n                            ins[e.to] = true;\n                            q.addLast(e.to);\n                        }\n                    }\n                }\n            }\n            if (dis[snk] == INF) return -1;\n            long add = need;\n            for (int v = snk; v != src; v = pv[v])\n                add = Math.min(add, g[pv[v]].get(pe[v]).cap);\n            need -= add;\n    