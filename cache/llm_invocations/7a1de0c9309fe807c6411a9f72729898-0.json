   \n                        int num1_max = s1[i].charAt(j) - '0';\n                        int num2_max = s2[x].charAt(y) - '0';\n                        for (int num1 = 1; num1 <= num1_max; num1++) {\n                            for (int num2 = 1; num2 <= num2_max; num2++) {\n                                int from = 10 * (j + i * 10) + num1;\n                                int to = 10 * (y + 10 * x) + num2;\n                                if (gr[from] == null) gr[from] = new ArrayList<>();\n                                gr[from].add(to);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    \n    static boolean kuhn(int v) {\n        if (used[v]) return false;\n        used[v] = true;\n        if (gr[v] != null) {\n            for (int to : gr[v]) {\n                if (pa[to] == 0 || kuhn(pa[to])) {\n                    pa[to] = v;\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n    \n    static void solve() throws IOException {\n        scan();\n        \n        int n = MAX_N * 10;\n        \n        for (int i = 0; i < n; i++) {\n            kuhn(i);\n            for (int j = 0; j < n; j++) {\n                used[j] = false;\n            }\n        }\n        \n        int res = 0;\n        for (int i = 0; i < n; i++) {\n            if (pa[i] != 0) res++;\n        }\n        \n        System.out.println(res);\n    }\n    \n    public static void main(String[] args) throws IOException {\n        solve();\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00020489977032411844, -2.861018856492592e-06, -4.768370445162873e-07, -0.0023393663577735424, -4.672895011026412e-05, -0.17975302040576935, -0.1426849067211151, -0.0010559941874817014, -1.490105023549404e-05, -0.00014375607133843005, -0.0013822296168655157, -3.504691630951129e-05, -2.145764938177308e-06, -4.4225667807040736