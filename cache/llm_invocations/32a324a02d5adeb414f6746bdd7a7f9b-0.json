Pow + diffPow) % MOD * INV2 % MOD;\n        }\n        System.out.println(ans);\n    }\n\n    static long modPow(long base, long e) {\n        long res = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) res = res * base % MOD;\n            base = base * base % MOD;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static class FastScanner {\n        private final BufferedInputStream in = new BufferedInputStream(System.in);\n\n        private int read() throws IOException {\n            return in.read();\n        }\n\n        public long nextLong() throws IOException {\n            int x = read();\n            while (x != -1 && !(x >= '0' && x <= '9') && x != '-') {\n                x = read();\n            }\n            if (x == -1) return 0;\n            boolean neg = false;\n            if (x == '-') {\n                neg = true;\n                x = read();\n            }\n            long res = 0;\n            while (x >= '0' && x <= '9') {\n                res = res * 10 + (x - '0');\n                x = read();\n            }\n            return neg ? -res : res;\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <cstdint>\n\nusing namespace std;\n\nconst long long MOD = 998244353;\nconst long long INV2 = (MOD + 1) / 2;\n\nlong long modPow(long long base, long long e) {\n    long long res = 1;\n    while (e > 0) {\n        if (e & 1) res = res * base % MOD;\n        base = base * base % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    long long n, m, L, R;\n    cin >> n >> m >> L >> R;\n\n    long long h = R - L;\n    long long even, odd;\n    if (h % 2 == 1) {\n        long long d = (h + 1) / 2;\n        even = d;\n        odd = d;\n    } else {\n        long long d = h / 2;\n        even = d;\n        odd = d;\n        if (L % 2 == 1) odd++;\