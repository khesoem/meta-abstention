ative) {\n            if (current == target) return true;\n            if (level < 0) return false;\n            \n            long possibleRange = cumulative[level + 1];\n            long nextPower = powers[level];\n            \n            if (current - possibleRange > target || current + possibleRange < target) {\n                return false;\n            }\n            \n            if (current + cumulative[level] < target) {\n                return tryCombinations(current + nextPower, target, level - 1, powers, cumulative);\n            } else if (current - cumulative[level] > target) {\n                return tryCombinations(current - nextPower, target, level - 1, powers, cumulative);\n            } else {\n                return tryCombinations(current, target, level - 1, powers, cumulative);\n            }\n        }\n    }\n    \n    static class InputHandler {\n        private BufferedReader reader;\n        private StringTokenizer tokenizer;\n        \n        public InputHandler() {\n            reader = new BufferedReader(new InputStreamReader(System.in));\n            tokenizer = new StringTokenizer(\"\");\n        }\n        \n        public String read() {\n            while (!tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n        \n        public long readLong() {\n            return Long.parseLong(read());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nclass InputHandler:\n    def __init__(self):\n        self.reader = sys.stdin\n        self.tokenizer = []\n    \n    def read(self):\n        while not self.tokenizer:\n            line = self.reader.readline()\n            if not line:\n                raise RuntimeError(\"No more input\")\n            self.tokenizer = line.strip().split()\n        return self.tokenizer.pop(0)\n    \n    def readLong(self):\n        return int(self.read())\n\nclass Solver:\n    def check(self, w, m):\n        powers = [0] * 105\n        cumulative = [0] * 105\n        p = 1\n        maxLevel = 0\n        \n        for i in range(100):\n            powers[i] = p\n            cumulative[i + 1] = p + cumulative[i]\n            p *= w\n            if p > (1 << 40):\n                maxLevel = i\n                break\n        else:\n            maxLevel = 99\n        \n        return self.tryCombinations(0, m, maxLevel, powers, cumulative)\n    \n    def tryCombinations(self, current, target, level, powers, cumulative):\n        if current == target:\n            return True\n        if level < 0:\n            return False\n        \n        possibleRange = cumulative[level + 1]\n        nextPower = powers[level]\n        \n        if current - possibleRange > target or current + possibleRange < target:\n            return False\n        \n        if current + cumulative[level] < target:\n            return self.tryCombinations(current + nextPower, target, level - 1, powers, cumulative)\n        elif current - cumulative[level] > target:\n            return self.tryCombinations(current - nextPower, target, level - 1, powers, cumulative)\n        else:\n            return self.tryCombinations(current, target, level - 1, powers, cumulative)\n\ndef main():\n    handler = InputHandler()\n    w = handler.readLong()\n    m = handler.readLong()\n    \n    solver = Solver()\n    print(\"YES\" if solver.check(w, m) else \"NO\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.85038583772257e-05, -8.344646857949556e-07, 0.0, -0.00034600470098666847, -4.9470632802695036e-05, -0.14268077909946442, -