data)\n    n = int(next(it))\n    a = [[0] * n for _ in range(n)]\n    prob_1 = [0] * (n * n)\n    for i in range(n):\n        for j in range(n):\n            val = int(next(it))\n            a[i][j] = (val * inv(100)) % MOD\n            prob_1[i * n + j] = a[i][j]\n\n    # v[cnt] = list of masks with popcount == cnt\n    v = [[] for _ in range(n + 1)]\n    for mask in range(1 << n):\n        cnt = pc(mask)\n        v[cnt].append(mask)\n\n    tot = [0] * (n + 1)\n    mp = [-1] * (1 << n)   # map mask -> index in its popcount group\n    for cnt in range(n + 1):\n        for idx, mask in enumerate(v[cnt]):\n            mp[mask] = idx\n        tot[cnt] = len(v[cnt])\n\n    m = n // 2\n    M = n - m\n\n    size = 1 << tot[m]\n    f = [0] * size\n    g = [0] * size\n\n    # First half (rows 0 .. m-1)\n    bound1 = 1 << (m * n)\n    for i in range(bound1):\n        p = 1\n        S = [0] * m\n        for j in range(m * n):\n            if (i >> j) & 1:\n                p = (p * prob_1[j]) % MOD\n            else:\n                p = (p * (MOD + 1 - prob_1[j])) % MOD\n        for j in range(m):\n            S[j] = (i >> (j * n)) & ((1 << n) - 1)\n\n        st = 0\n        for mask in v[m]:\n            bits = []\n            k = mask\n            while k:\n                low = k & -k\n                bits.append((low.bit_length() - 1))\n                k ^= low\n            bits.sort()\n            for perm in itertools.permutations(bits):\n                ok = True\n                for jj in range(m):\n                    if (S[jj] >> perm[jj]) & 1 == 0:\n                        ok = False\n                        break\n                if ok:\n                    st |= 1 << mp[mask]\n                    break\n        f[st] = (f[st] + p) % MOD\n\n    # Second half (rows m .. n-1)\n    bound2 = 1 << (M * n)\n    for i in range(bound2):\n        p = 1\n        S = [0] * M\n        # probabilities for the second half start at index n*m\n        offset = n * m\n        for j in range(M * n):\n            if (i >> j) & 1:\n                p = (p * prob_1[offset + j]) % MOD\n            else:\n                p = (p * (MOD + 1 - prob_1[offset + j])) % MOD\n        for j in range(M):\n            S[j] = (i >> (j * n)) & ((1 << n) - 1)\n\n        st = 0\n        for mask in v[M]:\n            bits = []\n            k = mask\n            while k:\n                low = k & -k\n                bits.append((low.bit_length() - 1))\n                k ^= low\n            bits.sort()\n            for perm in itertools.permutations(bits):\n                ok = True\n                for jj in range(M):\n                    if (S[jj] >> perm[jj]) & 1 == 0:\n                        ok = False\n                        break\n                if ok:\n                    comp = (~mask) & ((1 << n) - 1)\n                    st |= 1 << mp[comp]\n                    break\n        g[st] = (g[st] + p) % MOD\n\n    # Fast Walsh-Hadamard Transform (sum-over-subsets convolution)\n    fwt(f, 0, 1 << tot[m])\n    fwt(g, 0, 1 << tot[m])\n    for i in range(1 << tot[m]):\n        f[i] = (f[i] * g[i]) % MOD\n    fwt2(f, 0, 1 << tot[m])\n\n    ans = 0\n    for i in range(1, 1 << tot[m]):\n        ans = (ans + f[i]) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-1.6689286894688848e-06, -2.3841855067985307e-07, 0.0, -0.00034898388548754156, -0.0111017394810915, -7.545663538621739e-05, -0.0007245299639180303, -1.7523612768854946e-05, -9.667406266089529e-05, -0.008651395328342915, -1.3470558769768104e-05, -3.576278118089249e-07, -6.782778655178845e-05, -0.1282537281513214, -0.10021553188562393, 0.0, -2.4318398573086597e-05, -5.960462772236497e-07, 0.0, -0.0003033416287507862, -2.634490556374658e-05, -0.005089897196739912, -0.00033682872890494764, -1.3947389561508317e-05, -0.0005847889697179198, -2.3841855067985307e-07, -1.549708758830093e-05, -4.172316494077677e-06, -0.00542