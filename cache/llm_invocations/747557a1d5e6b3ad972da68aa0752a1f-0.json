{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nint n, m, r, c, d;\nint occ[101];\npair<int, int> pts[101];\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int cp, int cs, int rv) : to(t), cap(cp), cost(cs), rev(rv) {}\n};\n\nvector<vector<Edge>> graph;\nvector<int> dist, prevv, preve;\n\nvoid add_edge(int from, int to, int cap, int cost) {\n    graph[from].emplace_back(to, cap, cost, graph[to].size());\n    graph[to].emplace_back(from, 0, -cost, graph[from].size() - 1);\n}\n\npair<int, bool> spfa(int s, int t, int n) {\n    fill(dist.begin(), dist.end(), 0x3f3f3f3f);\n    dist[s] = 0;\n    vector<bool> inq(n, false);\n    queue<int> q;\n    q.push(s);\n    inq[s] = true;\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = false;\n        \n        for (int i = 0; i < graph[u].size(); ++i) {\n            auto& e = graph[u][i];\n            if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                dist[e.to] = dist[u] + e.cost;\n                prevv[e.to] = u;\n                preve[e.to] = i;\n                if (!inq[e.to]) {\n                    inq[e.to] = true;\n                    q.push(e.to);\n                }\n            }\n        }\n    }\n    \n    if (dist[t] >= 0x3f3f3f3f) return {0, false};\n    \n    int flow = 0x3f3f3f3f;\n    for (int v = t; v != s; v = prevv[v]) {\n        flow = min(flow, graph[prevv[v]][preve[v]].cap);\n    }\n    \n    for (int v = t; v != s; v = prevv[v]) {\n        auto& e = graph[prevv[v]][preve[v]];\n        e.cap -= flow;\n        graph[v][e.rev].cap += flow;\n    }\n    \n    return {dist[t] * flow, true};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> r >> c >> d;\n    \n    for (int i = 1; i <= r; i++) {\n        int x;\n        cin >> x;\n        occ[x]++;\n    }\n    \n    for (int i = 1; i <= m; i++) {\n        cin >> pts[i].first >> pts[i].second;\n    }\n    \n    int nodes = (r + n + 1) * n + 3;\n    graph.resize(nodes);\n    dist.resize(nodes);\n    prevv.resize(nodes);\n    preve.resize(nodes);\n    \n    int S = (r + n + 1) * n + 1;\n    int T = (r + n + 1) * n + 2;\n    \n    for (int i = 0; i < r + n; i++) {\n        for (int j = 1; j <= m; j++) {\n            for (int k = 1; k <= r; k++) {\n                add_edge(i * n + pts[j].first, (i + 1) * n + pts[j].second, 1, (2 * k - 1) * d);\n                add_edge(i * n + pts[j].second, (i + 1) * n + pts[j].first, 1, (2 * k - 1) * d);\n            }\n        }\n    }\n    \n    for (int i = 1; i <= r + n; i++) {\n        add_edge(i * n + 1, T, 0x3f3f3f3f, i * c);\n        for (int j = 2; j <= n; j++) {\n            add_edge((i - 1) * n + j, i * n + j, 0x3f3f3f3f, 0);\n        }\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        add_edge(S, i, occ[i], 0);\n    }\n    \n    int totalCost = 0;\n    auto [cost, found] = spfa(S, T, nodes);\n    while (found) {\n        totalCost += cost;\n        tie(cost, found) = spfa(S, T, nodes);\n    }\n    \n    cout << totalCost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp