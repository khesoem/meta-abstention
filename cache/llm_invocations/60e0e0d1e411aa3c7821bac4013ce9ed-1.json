      \n        length *= 2\n    \n    if inverse:\n        for i in range(n):\n            a_real[i] /= n\n            a_imaginary[i] /= n\n\ndef multiply_mod(a, b, mod):\n    need = len(a) + len(b) - 1\n    n = max(2, 1 << (need - 1).bit_length())\n    \n    a_real = [0.0] * n\n    a_imaginary = [0.0] * n\n    for i in range(len(a)):\n        x = a[i] % mod\n        a_real[i] = x & ((1 << 15) - 1)\n        a_imaginary[i] = x >> 15\n    \n    fft(a_real, a_imaginary, False)\n    \n    b_real = [0.0] * n\n    b_imaginary = [0.0] * n\n    for i in range(len(b)):\n        x = b[i] % mod\n        b_real[i] = x & ((1 << 15) - 1)\n        b_imaginary[i] = x >> 15\n    \n    fft(b_real, b_imaginary, False)\n    \n    fa_real = [0.0] * n\n    fa_imaginary = [0.0] * n\n    fb_real = [0.0] * n\n    fb_imaginary = [0.0] * n\n    \n    for i in range(n):\n        j = (n - i) & (n - 1)\n        \n        a1r = (a_real[i] + a_real[j]) / 2\n        a1i = (a_imaginary[i] - a_imaginary[j]) / 2\n        a2r = (a_imaginary[i] + a_imaginary[j]) / 2\n        a2i = (a_real[j] - a_real[i]) / 2\n        \n        b1r = (b_real[i] + b_real[j]) / 2\n        b1i = (b_imaginary[i] - b_imaginary[j]) / 2\n        b2r = (b_imaginary[i] + b_imaginary[j]) / 2\n        b2i = (b_real[j] - b_real[i]) / 2\n        \n        fa_real[i] = a1r * b1r - a1i * b1i - a2r * b2i - a2i * b2r\n        fa_imaginary[i] = a1r * b1i + a1i * b1r + a2r * b2r - a2i * b2i\n        \n        fb_real[i] = a1r * b2r - a1i * b2i + a2r * b1r - a2i * b1i\n        fb_imaginary[i] = a1r * b2i + a1i * b2r + a2r * b1i + a2i * b1r\n    \n    fft(fa_real, fa_imaginary, True)\n    fft(fb_real, fb_imaginary, True)\n    \n    res = [0] * need\n    for i in range(need):\n        aa = int(fa_real[i] + 0.5)\n        bb = int(fb_real[i] + 0.5)\n        cc = int(fa_imaginary[i] + 0.5)\n        res[i] = int((aa + ((bb % mod) << 15) + ((cc % mod) << 30)) % mod)\n    \n    return res\n\ndef solve():\n    mod = 998244353\n    n, k = map(int, sys.stdin.readline().split())\n    v = [0] * 10\n    for _ in range(k):\n        x = int(sys.stdin.readline())\n        v[x] = 1\n    \n    ans = [1]\n    p = n // 2\n    while True:\n        if p % 2 != 0:\n            ans = multiply_mod(ans, v, mod)\n        p //= 2\n        if p == 0:\n            break\n        v = multiply_mod(v, v, mod)\n    \n    res = 0\n    for x in ans:\n        res = (res + x * x) % mod\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.844937838148326e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -0.0013667537132278085, -0.005171256605535746, -0.011475390754640102, -0.012567020952701569, -0.0007624103454872966, -0.0034023988991975784, -0.20155416429042816, -0.6618838310241699, -0.0022879871539771557, -0.22602160274982452, -1.1920928244535389e-07, -3.158996332786046e-05, -0.00014959646796341985, -0.023265479132533073, -2.3841855067985307e-07, -7.998623186722398e-05, -0.0015069806249812245, -8.344646857949556e-07, -9.536738616588991e-07, -1.0728830375228426e-06, -9.894321920000948e-06, 0.0, -5.364403477869928e-06, -8.344646857949556e-07, -6.318072337307967e-06, -0.0321645550429821, -0.0002325502864550799, -0.12294011563062668, 0.0, -0.16022451221942902, -8.344646857949556e-07, -1.4305104514278355e-06, -8.344646857949556e-07, -0.1451590210199356, -3.576278118089249e-07, -0.03901180997490883, -0.3062137961387634, -0.6337953805923462, -0.1068480834364891, -0.00033706706017255783, -1.0728830375228426e-06, -0.750056266784668, -4.768370445162873e-07, -0.3788674771785736, -5.960462772236497e-07, -0.005494848359376192, 0.0, -4.768370445162873e-07, -1.5497195136049413e-06, -0.00037126801908016205, -0.00013314791431184858, -1.728519782773219e-05, -3.576278118089249e-07, -0.10039269924163818, 0.0, -2.3841855067985307e-07, -8.344646857949556e-07, -0.6325993537902832, -1.0728830375228426e-06, -8.344646857949556e-07, -0.009901928715407848, 0.0, -0.00149817240