D;\n        }\n\n        ModInt add(ModInt r) {\n            return new ModInt((v + r.v) % MOD);\n        }\n\n        ModInt subtract(ModInt r) {\n            return new ModInt((v + MOD - r.v) % MOD);\n        }\n\n        ModInt multiply(ModInt r) {\n            return new ModInt((v * r.v) % MOD);\n        }\n\n        ModInt divide(ModInt r) {\n            return multiply(r.inverse());\n        }\n\n        ModInt inverse() {\n            return pow(MOD - 2);\n        }\n\n        ModInt pow(long n) {\n            ModInt x = this, r = new ModInt(1);\n            while (n > 0) {\n                if ((n & 1) == 1) r = r.multiply(x);\n                x = x.multiply(x);\n                n >>= 1;\n            }\n            return r;\n        }\n\n        @Override\n        public String toString() {\n            return Long.toString(v);\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        int n = Integer.parseInt(br.readLine());\n\n        ModInt[][] mat = new ModInt[n][n];\n        for (int i = 0; i < n; i++) {\n            StringTokenizer st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; j++) {\n                int x = Integer.parseInt(st.nextToken());\n                mat[i][j] = new ModInt(x) / new ModInt(100);\n            }\n        }\n\n        List<Pair<List<Integer>, ModInt>> sts = new ArrayList<>();\n        sts.add(new Pair<>(new ArrayList<>(), new ModInt(1)));\n\n        for (int ph = 0; ph < n; ph++) {\n            List<Pair<List<Integer>, ModInt>> nsts = new ArrayList<>();\n            for (int f = 1; f < (1 << n); f++) {\n                ModInt freq = new ModInt(1);\n                for (int i = 0; i < n; i++) {\n                    if (((f >> i) & 1) == 1) {\n                        freq = freq.multiply(mat[ph][i]);\n                    } else {\n                        freq = freq.multiply(new ModInt(1).subtract(mat[ph][i]));\n                    }\n                }\n                for (Pair<List<Integer>, ModInt> st : sts) {\n                    List<Integer> nst = new ArrayList<>();\n                    for (int d : st.getKey()) {\n                        for (int i = 0; i < n; i++) {\n                            if (((d >> i) & 1) == 1) continue;\n                            if (((f >> i) & 1) == 1) continue;\n                            nst.add(d ^ (1 << i));\n                        }\n                    }\n                    if (nst.isEmpty()) continue;\n                    Collections.sort(nst);\n                    nst = removeDuplicates(nst);\n                    nsts.add(new Pair<>(nst, st.getValue().multiply(freq)));\n                }\n            }\n            Collections.sort(nsts, (l, r) -> l.getKey().compareTo(r.getKey()));\n            sts.clear();\n            for (Pair<List<Integer>, ModInt> st : nsts) {\n                if (!sts.isEmpty() && sts.get(sts.size() - 1).getKey().equals(st.getKey())) {\n                    sts.get(sts.size() - 1).setValue(sts.get(sts.size() - 1).getValue().add(st.getValue()));\n                } else {\n                    sts.add(st);\n                }\n            }\n            //System.out.println(ph + \" \" + nsts.size());\n        }\n\n        ModInt ans = sts.isEmpty() ? new ModInt(0) : sts.get(0).getValue();\n\n        pw.println(ans);\n        pw.close();\n    }\n\n    public static List<Integer> removeDuplicates(List<Integer> list) {\n        List<Integer> result = new ArrayList<>();\n        for (Integer i : list) {\n            if (!result.contains(i)) {\n                result.add(i);\n            }\n        }\n        return result;\n    }\n\n    static class Pair<F, S> {\n        F key;\n        S value;\n\n        public Pair(F key, S value) {\n            this.key = key;\n            this.value = value;\n        }\n\n        public F getKey() {\n            return key;\n        }\n\n        public S getValue() {\n            return value;\n        }\n\n        public void setValue(S value) {\n            this.value = value;\n        }\n\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            Pair<?, ?> pair = (Pair<?, ?>) o;\n            return key.equals(pair.key) && value.equals(pair.value);\n        }\n\n        @Override\n        public int hashCode() {\n            return Objects.hash(key, value);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.16351613402366638, -0.007959066890180111, -0.14513519406318665, -0.033241234719753265, -0.00027248996775597334, -0.252756804227829, -0.5423355102539062, -0.00044731367961503565, -1.9669725588755682e-05, -0.020989231765270233, -0.20449966192245483, -0.018208712339401245, -8.499983232468367e-05, -0.045627184212207794, -0.2031293511390686, -0.006114121992141008, -0.458621621131897, -0.33910849690437317, -0.5127531886100769, -0.005446816794574261, -0.014722487889230251, -0.00014842658129055053, -0.2754629850387573, -0.15375271439552307, -0.9605772495269775, -0.28001734614372253, -0.16091254353523254, -0.595535397529602, -0.05414886772632599, -0.04549692943692207, -0.8769878149032593, -0.0002251520927529782, -5.2930325182387605e-05, -0.0002344525564694777, -0.0001465189561713487, -0.00039829793968237936, -0.0010015614097937942, -0.0002597311686258763, -6.568647222593427e-05, -4.4585267460206524e-05, -0.0011344427475705743, -0.04411986097693443, -3.910141094820574e-05, -0.29947733879089355, -0.45229679346084595, -0.3493526577949524, -4.410753263073275e-06, -0.5249274969100952, -2.396135460003279e-05, -0.05358783155679703, -0.48504072427749634, -2.8252999982214533e-05, -0.00032692530658096075, -0.10059374570846558, -4.005512528237887e-05, -0.32357555627822876, -0.000117070376290939