leneck\n\n        return total_flow, total_cost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = int(data[idx]); idx += 1\n\n    solver = MCMF(50 * 50 * 4 + 10)\n    source = solver.node_count - 2\n    sink = solver.node_count - 3\n\n    counter = 0\n    max_level = 100\n\n    node_id = [[0] * (max_level + 1) for _ in range(n + 1)]\n    \n    for i in range(1, n + 1):\n        for j in range(max_level + 1):\n            counter += 1\n            node_id[i][j] = counter\n\n    for _ in range(1, m + 1):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for level in range(max_level):\n            for step in range(1, k + 1):\n                delta = step * step * d - (step - 1) * (step - 1) * d\n                solver.add_bidirectional(node_id[u][level], node_id[v][level + 1], 1, c + delta)\n\n    for i in range(1, n + 1):\n        for level in range(max_level):\n            solver.add_bidirectional(node_id[i][level], node_id[i][level + 1], INF, c)\n\n    for i in range(1, k + 1):\n        solver.add_bidirectional(source, node_id[a[i]][0], 1, 0)\n\n    for level in range(1, max_level + 1):\n        solver.add_bidirectional(node_id[1][level], sink, INF, 0)\n\n    result = solver.run(source, sink)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001264730526600033, -9.536738616588991e-07, -4.768370445162873e-07, -0.0034976755268871784, -0.0014129426563158631, -2.3841855067985307e-07, -0.0015044810716062784, -0.0004009396652691066, -1.4305104514278355e-06, -0.002481478499248624, -0.5762240290641785, -0.41906672716140747, -0.0001225396408699453, -0.0128216175362