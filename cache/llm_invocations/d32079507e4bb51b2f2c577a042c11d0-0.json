oid add_edge(int u, int v, int cap, long long w) {\n        edges[idx] = {v, head[u], cap, w};\n        head[u] = idx++;\n    }\n\n    void add_bidirectional(int u, int v, int cap, long long w) {\n        add_edge(u, v, cap, w);\n        add_edge(v, u, 0, -w);\n    }\n\n    bool spfa() {\n        fill(dist, dist + node_count, INF);\n        queue<int> q;\n        q.push(src);\n        dist[src] = 0;\n        inq[src] = 1;\n\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n            inq[u] = 0;\n\n            for (int e = head[u]; ~e; e = edges[e].next) {\n                if (edges[e].capacity > 0) {\n                    int v = edges[e].to;\n                    long long nd = dist[u] + edges[e].cost;\n                    if (nd < dist[v]) {\n                        dist[v] = nd;\n                        prevv[v] = e;\n                        if (!inq[v]) {\n                            q.push(v);\n                            inq[v] = 1;\n                        }\n                    }\n                }\n            }\n        }\n        return dist[dst] != INF;\n    }\n\n    pair<int, long long> run(int s, int t) {\n        src = s;\n        dst = t;\n        int total_flow = 0;\n        long long total_cost = 0;\n\n        while (spfa()) {\n            int bottleneck = INF;\n            int e;\n            for (int v = dst; v != src; v = edges[e ^ 1].to) {\n                e = prevv[v];\n                bottleneck = min(bottleneck, edges[e].capacity);\n            }\n            for (int v = dst; v != src; v = edges[e ^ 1].to) {\n                e = prevv[v];\n                edges[e].capacity -= bottleneck;\n                edges[e ^ 1].capacity += bottleneck;\n            }\n            total_cost += (long long)bottleneck * dist[dst];\n            total_flow += bottleneck;\n        }\n        return MP(total_flow, total_cost);\n    }\n};\n\nMCMF solver;\nint n, m, k, c, d, a[1005], node_id[55][2505];\n\nint main() {\n    ios