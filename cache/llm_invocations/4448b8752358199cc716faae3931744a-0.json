 + 1, 1, delta)\n    \n    start = total - 2\n    end = total - 1\n    totalFlow = 0\n    totalCost = 0\n    \n    while totalFlow < k:\n        distance = [INF] * total\n        predecessor = [-1] * total\n        arcIndex = [0] * total\n        inQueue = [False] * total\n        q = deque()\n        \n        distance[start] = 0\n        q.append(start)\n        inQueue[start] = True\n        \n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            \n            for i in range(len(network[u])):\n                arc = network[u][i]\n                if arc.current < arc.limit and distance[u] + arc.price < distance[arc.target]:\n                    distance[arc.target] = distance[u] + arc.price\n                    predecessor[arc.target] = u\n                    arcIndex[arc.target] = i\n                    if not inQueue[arc.target]:\n                        q.append(arc.target)\n                        inQueue[arc.target] = True\n        \n        if distance[end] == INF:\n            break\n        \n        augment = k - totalFlow\n        v = end\n        while v != start:\n            u = predecessor[v]\n            idx = arcIndex[v]\n            augment = min(augment, network[u][idx].limit - network[u][idx].current)\n            v = u\n        \n        v = end\n        while v != start:\n            u = predecessor[v]\n            idx = arcIndex[v]\n            rev = network[u][idx].back\n            network[u][idx].current += augment\n            network[v][rev].current -= augment\n            totalCost += network[u][idx].price * augment\n            v = u\n        \n        totalFlow += augment\n    \n    print(totalCost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.843663479434326e-05, -7.152555099310121e-07, 0.0, -0.0006164796068333089, -0.004963220097124577, -1.0728830375228426e-06, -0.0003022690652869642, -0.00038246947224251926, -8.3446468