lf.cost[i]:\n                t = self.dfs(y, min(self.cap[i], lim - flow), totalCost)\n                self.cap[i] -= t\n                self.cap[i ^ 1] += t\n                flow += t\n                totalCost[0] += t * self.cost[i]\n                if flow == lim:\n                    return lim\n            i = self.nxt[i]\n        return flow\n\n    def run(self):\n        totalFlow = 0\n        totalCost = [0]\n        while self.spfa():\n            while True:\n                self.inq = [False] * MAXV\n                totalFlow += self.dfs(self.src, INF, totalCost)\n                if not self.inq[self.sink]:\n                    break\n        return totalCost[0]\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    lim = 101\n    mcmf = MinCostFlow(MAXV - 2, MAXV - 1)\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcmf.addEdge(MAXV - 2, x, 1, 0)\n\n    for i in range(lim):\n        mcmf.addEdge(i * n, MAXV - 1, k, c * i)\n\n    for i in range(n):\n        for j in range(lim - 1):\n            mcmf.addEdge(i + j * n, i + (j + 1) * n, k, 0)\n\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for i in range(lim - 1):\n            for j in range(k - 1, -1, -1):\n                mcmf.addEdge(x + i * n, y + (i + 1) * n, 1, d * (j * 2 + 1))\n                mcmf.addEdge(y + i * n, x + (i + 1) * n, 1, d * (j * 2 + 1))\n\n    print(mcmf.run())\n\nif __name__ == \"__main__\":\n    MAXV = 10005\n    INF = 2000000000\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.649054244509898e-05, -3.576278118089249e-07, 0.0, -9.643566590966657e-05, -0.0007164295529946685, 0.0, -0.0003475538978818804, -0.31436049938201904, 0.0, 0.0, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -0.13229085505008698, -1.4543427823809907e-05, -0.014