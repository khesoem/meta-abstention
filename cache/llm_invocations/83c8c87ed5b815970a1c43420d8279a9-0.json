\n        // Build adjacency list\n        int[] adj = new int[n + 1];\n        for (int i = 0; i < n; i++) {\n            adj[i] = (int) ((long) i * k % n);\n        }\n\n        // Iterative DFS using explicit stack\n        boolean[] visited = new boolean[n + 1];\n        int components = 0;\n\n        for (int start = 1; start < n; start++) {\n            if (visited[start]) {\n                continue;\n            }\n            Stack<Integer> stack = new Stack<>();\n            stack.push(start);\n            while (!stack.isEmpty()) {\n                int node = stack.pop();\n                if (!visited[node]) {\n                    visited[node] = true;\n                    int nextNode = adj[node];\n                    if (!visited[nextNode]) {\n                        stack.push(nextNode);\n                    }\n                }\n            }\n            components++;\n        }\n\n        // Compute result\n        if (k == 1) {\n            System.out.println(powerMod(n, n, mod));\n        } else {\n            System.out.println(powerMod(n, components, mod));\n        }\n    }\n\n    // Modular exponentiation: base^exp % mod\n    static long powerMod(long base, long exp, int mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.798523387871683e-05, -2.264974000354414e-06, -1.1920928244535389e-07, -2.6225699912174605e-05, -1.728519782773219e-05, -0.14267849922180176, -0.08121035248041153, -2.622600959512056e-06, -9.536738616588991e-07, -3.480850500636734e-05, -7.533743337262422e-05, -1.0728830375228426e-06, -7.30726242181845e-05, -5.960462772236497e-07, -9.536738616588991e-07, -5.960462772236497e-07, -1.9073468138230965e-06, -1.4305104514