 = q.top(); q.pop();\n\t\t\t\tint v = now.second;\n\t\t\t\tif (dis[v] < now.first)continue;\n\t\t\t\tfor (int i = 0; i < G[v].size(); ++i) {\n   \t\t\t\t\tedge& e = G[v][i];\n\t\t\t\t\tif (e.capacity > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n   \t\t\t\t\t\tdis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n   \t\t\t\t\t\tPreV[e.to] = v;\n   \t\t\t\t\t\tPreE[e.to] = i;\n   \t\t\t\t\t\tq.push(pii(dis[e.to], e.to));\n\t   \t\t\t\t}\n\t   \t\t\t}\n\t   \t\t}\n\t\t\tif (dis[t] == inf)   break;\n\t\t\tfor (int i = 0; i <= V; ++i)H[i] += dis[i];\n\t\t\tint d = f;\n\t\t\tfor (int v = t; v != s; v = PreV[v])d = min(d, G[PreV[v]][PreE[v]].capacity);\n   \t\t\tf -= d; flow += d; res += d*H[t];\n\t\t\tfor (int v = t; v != s; v = PreV[v]) {\n   \t\t\t\tedge& e = G[PreV[v]][PreE[v]];\n   \t\t\t\te.capacity -= d;\n   \t\t\t\tG[v][e.rev].capacity += d;\n\t\t\t}\n   \t\t}\n\t\treturn res;\n   \t}\n} mcmf;\n\nint main (){\n#ifndef ONLINE_JUDGE\n\tfreopen (\"in.in\", \"r\", stdin);\n\tfreopen (\"out.out\", \"w\", stdout);\n#endif\n\t\n\tint n, m, k, c, d;\n\t\n\tcin >> n >> m >> k >> c >> d;\n\t\n\tmcmf.Init(n*(n+55)+2);\n\tfor(int i=0; i<k; i++){\n\t\tint u; cin >> u;\n\t\tmcmf.add_edge(0, u, 1, 0);\n\t}\n\t\n\tvector <pii> edge=vector <pii> (m);\n\tfor(int i=0; i<m; i++) cin >> edge[i].x >> edge[i].y;\n\t\n\tint tar=n*(n+55)+1;\n\tfor(int t=0; t<n+54; t++){\n\t\tfor(pii e : edge){\n\t\t\tfor(int j=1; j<=k; j++){\n\t\t\t\tmcmf.add_edge(e.x+t*n, e.y+(t+1)*n, 1, c+d*(j*2-1));\n\t\t\t\tmcmf.add_edge(e.y+t*n, e.x+(t+1)*n, 1, c+d*(j*2-1));\n\t\t\t}\n\t\t}\n\t\tfor(int i=2; i<=n; i++){\n\t\t\tmcmf.add_edge(i+t*n, i+(t+1)*n, k, c);\n\t\t}\n\t\tmcmf.add_edge(1+t*n, tar, k, 0);\n\t}\n\t\n\tcout << mcmf.minCost(0, tar, k) << endl;\n\t\n\treturn 0;\n}\n\n                  \n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nclass Edge:\n    def __init__(self, to, capacity, cost, rev):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.rev = rev\n\nclass MinCostMaxFlow:\n    def __init__(self):\n        self.V = 0\n        self.H = []\n        self.dis = []\n        self.PreV = []\n        self.PreE = []\n        self.G = []\n    \n    def Init(self, n):\n        self.V = n\n        self.H = [0] * (n + 5)\n        self.dis = [0] * (n + 5)\n        self.PreV = [0] * (n + 5)\n        self.PreE = [0] * (n + 5)\n        self.G = [[] for _ in range(n + 5)]\n    \n    def add_edge(self, from_node, to_node, cap, cost):\n        self.G[from_node].append(Edge(to_node, cap, cost, len(self.G[to_node])))\n        self.G[to_node].append(Edge(from_node, 0, -cost, len(self.G[from_node]) - 1))\n    \n    def minCost(self, s, t, f):\n        flow = 0\n        res = 0\n        self.H = [0] * (self.V + 1)\n        \n        while f > 0:\n            # Dijkstra with priority queue\n            self.dis = [float('inf')] * (self.V + 1)\n            self.dis[s] = 0\n            heap = [(0, s)]\n            \n            while heap:\n                now_cost, v = heapq.heappop(heap)\n                if self.dis[v] < now_cost:\n                    continue\n                for i in range(len(self.G[v])):\n                    e = self.G[v][i]\n                    if e.capacity > 0 and self.dis[e.to] > self.dis[v] + e.cost + self.H[v] - self.H[e.to]:\n                        self.dis[e.to] = self.dis[v] + e.cost + self.H[v] - self.H[e.to]\n                        self.PreV[e.to] = v\n                        self.PreE[e.to] = i\n                        heapq.heappush(heap, (self.dis[e.to], e.to))\n            \n            if self.dis[t] == float('inf'):\n                break\n            \n            for i in range(self.V + 1):\n                self.H[i] += self.dis[i]\n            \n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[self.PreV[v]][self.PreE[v]].capacity)\n                v = self.PreV[v]\n            \n            f -= d\n            flow += d\n            res += d * self.H[t]\n            \n            v = t\n            while v != s:\n                e = self.G[self.PreV[v]][self.PreE[v]]\n                e.capacity -= d\n                self.G[v][e.rev].capacity += d\n                v = self.PreV[v]\n        \n        return res\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    mcmf = MinCostMaxFlow()\n    mcmf.Init(n * (n + 55) + 2)\n    \n    for i in range(k):\n        u = int(input_data[idx]); idx += 1\n        mcmf.add_edge(0, u, 1, 0)\n    \n    edges = []\n    for i in range(m):\n        x = int(input_data[idx]); idx += 1\n        y = int(input_data[idx]); idx += 1\n        edges.append((x, y))\n    \n    tar = n * (n + 55) + 1\n    \n    for t in range(n + 54):\n        for e in edges:\n            for j in range(1, k + 1):\n                cost = c + d * (j * 2 - 1)\n                mcmf.add_edge(e[0] + t * n, e[1] + (t + 1) * n, 1, cost)\n                mcmf.add_edge(e[1] + t * n, e[0] + (t + 1) * n, 1, cost)\n        \n        for i in range(2, n + 1):\n            mcmf.add_edge(i + t * n, i + (t + 1) * n, k, c)\n        \n        mcmf.add_edge(1 + t * n, tar, k, 0)\n    \n    print(mcmf.minCost(0, tar, k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018439977429807186, -1.1920922133867862e-06, -3.576278118089249e-07, -7.271502545336261e-05, -0.07914254814386368, -0.14293406903743744, -0.11284013092517853, -0.00010847456724150106, -0.20165598392486572, -0.3750794231891632, -0.001073499326594174, -7.152555099310121e-07, 