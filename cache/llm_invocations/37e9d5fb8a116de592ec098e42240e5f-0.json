{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.util.*;\n\npublic class Test {\n    int r, c;\n    long[][] C = new long[64][64];\n    long best = Long.MAX_VALUE;\n    Scanner sca = new Scanner(System.in);\n    char[] cs;\n    Map<Long, Long> cache = new TreeMap<>();\n\n    void buildComb() {\n        int n = 2 * (r + c);\n        for (int i = 0; i <= n; i++) {\n            for (int j = 0; j <= n; j++) {\n                if (j == 0) C[i][j] = 1;\n                else if (i == 0) C[i][j] = 0;\n                else C[i][j] = C[i - 1][j - 1] + C[i - 1][j];\n            }\n        }\n    }\n\n    void dfs(long x, long y, int v1, int v2) {\n        Deque<long[]> stack = new ArrayDeque<>();\n        stack.push(new long[]{x, y, v1, v2});\n        while (!stack.isEmpty()) {\n            long[] cur = stack.pop();\n            long cx = cur[0];\n            long cy = cur[1];\n            int a = (int) cur[2];\n            int b = (int) cur[3];\n            long d = Math.abs(cx - cy);\n            if (best <= 1 || d - C[a][r] * C[b][r] >= best) continue;\n            if (a == 0 && b == 0) {\n                if (d < best) best = d;\n                continue;\n            }\n            if (b > 0) {\n                long dx = C[a][r] * (C[b][r] - C[b - 1][r]);\n                stack.push(new long[]{cx + dx, cy, a, b - 1});\n            }\n            if (a > 0) {\n                long dy = (C[a][r] - C[a - 1][r]) * C[b][r];\n                stack.push(new long[]{cx, cy + dy, a - 1, b});\n            }\n        }\n    }\n\n    long solve(long x, long y, int v1, int v2) {\n        long key = x * 10000 + v1 * 100 + v2;\n        Long cached = cache.get(key);\n        if (cached != null) return cached;\n        long ans = 0L;\n        long d = Math.abs(x - y);\n        if (d - C[v1][r] * C[v2][r] > best) {\n            cache.put(key, ans);\n            return ans;\n        }\n        if (v1 == 0 && v2 == 0) return 1L;\n        char ch = cs[v1 + v2 - 1];\n        if (v1 > 0 && ch != 'B') {\n            long dy = (C[v1][r] - C[v1 - 1][r]) * C[v2][r];\n            ans += solve(x, y + dy, v1 - 1, v2);\n        }\n        if (v2 > 0 && ch != 'A') {\n            long dx = C[v1][r] * (C[v2][r] - C[v2 - 1][r]);\n            ans += solve(x + dx, y, v1, v2 - 1);\n        }\n        cache.put(key, ans);\n        return ans;\n    }\n\n    void run() {\n        r = sca.nextInt();\n        c = sca.nextInt();\n        sca.nextLine();\n        cs = sca.nextLine().toCharArray();\n        buildComb();\n        int v1 = r + c, v2 = r + c;\n        long x = 0, y = 0;\n        while (v1 > 0 && v2 > 0) {\n            if (x > y) {\n                long dy = (C[v1][r] - C[v1 - 1][r]) * C[v2][r];\n                y += dy;\n                v1--;\n            } else {\n                long dx = C[v1][r] * (C[v2][r] - C[v2 - 1][r]);\n                x += dx;\n                v2--;\n            }\n        }\n        best = Math.abs(x - y);\n        dfs(0, 0, r + c, r + c);\n        System.out.println(solve(0, 0, r + c, r + c));\n    }\n\n    public static void main(String[] args) {\n        new Test().run();\n    }\n}\n</original_code>\