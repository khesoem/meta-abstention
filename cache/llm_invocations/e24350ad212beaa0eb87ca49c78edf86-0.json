 a1, long long a2, long long a3, long long b1, long long b2, long long b3) {\n    if (b1 >= a1 + a2) {\n        return a3 - b2 - b3;\n    } else if (b2 >= a3 + a2) {\n        return a1 - b1 - b3;\n    } else if (b3 >= a1 + a3) {\n        return a2 - b2 - b1;\n    }\n    return 0;\n}\n\nlong long computeMax(long long a1, long long a2, long long a3, long long b1, long long b2, long long b3) {\n    return min(a1, b2) + min(a2, b3) + min(a3, b1);\n}\n\nint main() {\n    FastReader scn;\n    long long n = scn.nextLong();\n    long long a1 = scn.nextLong();\n    long long a2 = scn.nextLong();\n    long long a3 = scn.nextLong();\n    long long b1 = scn.nextLong();\n    long long b2 = scn.nextLong();\n    long long b3 = scn.nextLong();\n\n    long long min_val = computeMin(a1, a2, a3, b1, b2, b3);\n    long long max_val = computeMax(a1, a2, a3, b1, b2, b3);\n\n    cout << min_val << \" \" << max_val << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010430268594063818, -4.887569048150908e-06, -1.1920928244535389e-07, -0.00014518637908622622, -1.311301275563892e-06, -2.264974000354414e-06, -1.6689286894688848e-06, -2.1815061700181104e-05, -2.3841855067985307e-07, -0.5291672945022583, -5.006777428206988e-06, -0.0005532164941541851, -2.3841830625315197e-06, -0.04387298598885536, -0.0036423548590391874, -0.0015028145862743258, -1.1801649634435307e-05, -0.2138940393924713, -0.0699400082230568, -0.02054551988840103, -4.172316494077677e-06, -0.03460800275206566, -0.5759491920471191, -0.0026707714423537254, -9.65590606938349e-06, -1.0728830375228426e-06, -2.50339189733495e-06, -0.04069159924983978, -0.00010466027742950246, -4.6491513785440475e-06, -1.0013530300057027e-05, -0.142954021692276, -7.152555099310121e-07, -3.576272320060525e-06, -1.0306000709533691, -0.08954567462205887, -3.099393507000059e-05, -1.5497195136049413e-06, -0.2283829301595688, -0.02698691561818123, -0.0024839758407324553, -0.47410547733306885, -0.665106