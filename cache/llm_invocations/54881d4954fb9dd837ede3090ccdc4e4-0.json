{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <cassert>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long ll;\nconst int iinf = 0x3f3f3f3f;\nconst ll linf = 0x3f3f3f3f3f3f3f3f;\n\nconst int N = 50;\nint n, m, k, c, d, mxt;\n\nconst int fN = (N * 3 + 1) * N + 2;\nint s, t, fn;\nvector<int> e[fN];\nvector<int> to, fw, co;\n\nvoid adde(int u, int v, int w, int c) {\n    e[u].push_back((int)to.size());\n    to.push_back(v);\n    fw.push_back(w);\n    co.push_back(+c);\n    e[v].push_back((int)to.size());\n    to.push_back(u);\n    fw.push_back(0);\n    co.push_back(-c);\n}\n\nint dist[fN], prevv[fN], preve[fN];\nint h[fN];\n\nbool dijkstra() {\n    fill(dist, dist + fn, iinf);\n    dist[s] = 0;\n    priority_queue<pair<int, int>> pq;\n    pq.push({0, s});\n    while (!pq.empty()) {\n        int d = -pq.top().first;\n        int u = pq.top().second;\n        pq.pop();\n        if (dist[u] < d) continue;\n        for (int i = 0; i < (int)e[u].size(); i++) {\n            int v = e[u][i];\n            if (fw[v] && dist[to[v]] > dist[u] + co[v] + h[u] - h[to[v]]) {\n                dist[to[v]] = dist[u] + co[v] + h[u] - h[to[v]];\n                prevv[to[v]] = u;\n                preve[to[v]] = v;\n                pq.push({-dist[to[v]], to[v]});\n            }\n        }\n    }\n    return dist[t] < iinf;\n}\n\npair<int, int> mcmf() {\n    fill(h, h + fn, 0);\n    pair<int, int> res(0, 0);\n    while (dijkstra()) {\n        int f = iinf;\n        for (int u = t; u != s; u = prevv[u]) {\n            f = min(f, fw[preve[u]]);\n        }\n        for (int u = t; u != s; u = prevv[u]) {\n            fw[preve[u]] -= f;\n            fw[preve[u] ^ 1] += f;\n        }\n        res.first += f;\n        res.second += (dist[t] + h[t]) * f;\n        for (int u = 0; u < fn; u++) {\n            if (dist[u] < iinf) h[u] += dist[u];\n        }\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    mxt = N * 3 + 1;\n    fn = (t = (s = n * mxt) + 1) + 1;\n    for (int i = 0; i < k; i++) {\n        int u;\n        cin >> u;\n        --u;\n        adde(s, u, 1, 0);\n    }\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        for (int i2 = 0; i2 < mxt - 1; i2++) {\n            for (int p = 1; p <= k; p++) {\n                adde(i2 * n + u, (i2 + 1) * n + v, 1, 2 * d * p - d);\n                adde(i2 * n + v, (i2 + 1) * n + u, 1, 2 * d * p - d);\n            }\n        }\n    }\n    for (int u = 0; u < n; u++) {\n        for (int i = 0; i < mxt - 1; i++) {\n            adde(i * n + u, (i + 1) * n + u, k, 0);\n        }\n    }\n    for (int i = 0; i < mxt; i++) {\n        adde(i * n, t, k, i * c);\n    }\n    pair<int, int> ans = mcmf();\n    assert(ans.first == k);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    iinf = 0x3f3f3f3f\n    # mxt = N * 3 + 1, N = 50\n    mxt = 50 * 3 + 1  # 151\n    # total nodes: n * mxt + 2\n    fn = n * mxt + 2\n    s = n * mxt\n    t = s + 1\n\n    # adjacency list: each element is a list of edge indices (or we store edges in a global list)\n    g = [[] for _ in range(fn)]\n    # edge lists: to, rev, cap, cost\n    to = []\n    rev = []\n    cap = []\n    cost = []\n\n    def add_edge(u: int, v: int, w: int, c: int) -> None:\n        # forward edge\n        g[u].append(len(to))\n        to.append(v)\n        rev.append(-1)  # will be set later\n        cap.append(w)\n        cost.append(c)\n        # backward edge\n        g[v].append(len(to))\n        to.append(u)\n        rev.append(len(to) - 2)  # pointer to forward edge\n        cap.append(0)\n        cost.append(-c)\n        # set rev of forward edge to backward edge index\n        rev[g[u][-1]] = len(to) - 1\n\n    # read starting positions\n    for _ in range(k):\n        u = int(next(it)) - 1\n        add_edge(s, u, 1, 0)\n\n    # read edges\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        # for each time layer\n        for i2 in range(mxt - 1):\n            for p in range(1, k + 1):\n                # adde(i2*n+u, (i2+1)*n+v, 1, 2*d*p - d)\n                add_edge(i2 * n + u, (i2 + 1) * n + v, 1, 2 * d * p - d)\n                add_edge(i2 * n + v, (i2 + 1) * n + u, 1, 2 * d * p - d)\n\n    # stay edges\n    for u in range(n):\n        for i in range(mxt - 1):\n            add_edge(i * n + u, (i + 1) * n + u, k, 0)\n\n    # sink edges\n    for i in range(mxt):\n        add_edge(i * n, t, k, i * c)\n\n    # Min Cost Max Flow with potentials\n    dist = [0] * fn\n    prevv = [0] * fn\n    preve = [0] * fn\n    h = [0] * fn  # potentials\n\n    def dijkstra() -> bool:\n        nonlocal dist, prevv, preve, h\n        for i in range(fn):\n            dist[i] = iinf\n        dist[s] = 0\n        pq = [(0, s)]\n        while pq:\n            d, u = heapq.heappop(pq)\n            if dist[u] < d:\n                continue\n            for ei in g[u]:\n                if cap[ei] > 0:\n                    v = to[ei]\n                    nd = dist[u] + cost[ei] + h[u] - h[v]\n                    if dist[v] > nd:\n                        dist[v] = nd\n                        prevv[v] = u\n                        preve[v] = ei\n                        heapq.heappush(pq, (nd, v))\n        return dist[t] < iinf\n\n    flow = 0\n    cost_ans = 0\n    # initialize h\n    for i in range(fn):\n        h[i] = 0\n\n    while dijkstra():\n        # augment\n        f = iinf\n        u = t\n        while u != s:\n            f = min(f, cap[preve[u]])\n            u = prevv[u]\n        u = t\n        while u != s:\n            cap[preve[u]] -= f\n            # reverse edge\n            rev_ei = rev[preve[u]]\n            cap[rev_ei] += f\n            u = prevv[u]\n        flow += f\n        cost_ans += (dist[t] + h[t]) * f\n        # update potentials\n        for i in range(fn):\n            if dist[i] < iinf:\n                h[i] += dist[i]\n\n    # assert flow == k\n    print(cost_ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -0.0007458527106791735, -0.00411330908536911, -1.0490362910786644e-05, -0.0036512629594653845, -0.004090277012437582, -0.0007520469953306019, -0.03813379257917404, -1.0553338527679443, -0.07913649082183838, -0.3135075569152832, -2.074220174108632e-05, -2.169585604860913e-05, -1.6689286894688848e-06, -1.4305104514278355e-06, -0.01830669865012169, -2.622600959512056e-06, -0.9743542671203613, 0.0, -0.12693341076374054, -1.0609570381348021e-05, -1.1