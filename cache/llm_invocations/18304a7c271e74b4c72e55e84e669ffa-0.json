]; i < g.get(u).size(); i++) {\n                Edge e = g.get(u).get(i);\n                if (level[e.to] != level[u] + 1 || e.cap == 0) continue;\n                long pushed = dfs(e.to, Math.min(f, e.cap));\n                if (pushed > 0) {\n                    e.cap -= pushed;\n                    g.get(e.to).get(e.rev).cap += pushed;\n                    return pushed;\n                }\n                ptr[u]++;\n            }\n            return 0;\n        }\n\n        long maxflow() {\n            long ans = 0;\n            while (bfs()) {\n                Arrays.fill(ptr, 0);\n                long pushed;\n                while ((pushed = dfs(s, INF)) > 0) ans += pushed;\n            }\n            return ans;\n        }\n    }\n\n    static int n, m;\n    static int deadline;\n    static String[] sci, rea;\n    static int[][] danger;\n\n    static boolean valid(int r, int c) { return r >= 0 && c >= 0 && r < n && c < m; }\n    static int cellId(int x, int y) { return 1 + m * x + y; }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        deadline = sc.nextInt() + 1;\n        m = n;\n\n        sci = new String[n];\n        rea = new String[n];\n        for (int i = 0; i < n; i++) sci[i] = sc.next();\n\n        danger = new int[n][m];\n        Queue<int[]> q0 = new LinkedList<>();\n        for (int i = 0; i < n; i++) {\n            rea[i] = sc.next();\n            for (int j = 0; j < m; j++) {\n                danger[i][j] = Integer.MAX_VALUE;\n                if (rea[i].charAt(j) == 'Z') {\n                    q0.add(new int[]{i, j});\n                    danger[i][j] = 1;\n                }\n            }\n        }\n\n        while (!q0.isEmpty()) {\n            int[] cur = q0.poll();\n            int x = cur[0], y = cur[1];\n            for (int da = -1; da <= 1; da++) {\n                for (int db = -1; db <= 1; db++) {\n                    if (Math.abs(da) + Math.abs(db) != 1