f == 0) return 0;\n        if (u == t) return f;\n        for (int &i = ptr[u]; i < (int)g[u].size(); ++i) {\n            Edge &e = g[u][i];\n            if (level[e.to] != level[u] + 1 || e.cap == 0) continue;\n            ll pushed = dfs(e.to, min(f, e.cap));\n            if (pushed) {\n                e.cap -= pushed;\n                g[e.to][e.rev].cap += pushed;\n                return pushed;\n            }\n        }\n        return 0;\n    }\n\n    ll maxflow() {\n        ll ans = 0;\n        while (bfs()) {\n            fill(ptr.begin(), ptr.end(), 0);\n            while (ll pushed = dfs(s, INF)) ans += pushed;\n        }\n        return ans;\n    }\n};\n\nint n, m, deadline;\nvector<string> sci, rea;\nvector<vector<int>> danger;\n\nbool valid(int r, int c) { return r >= 0 && c >= 0 && r < n && c < m; }\nint cellId(int x, int y) { return 1 + m * x + y; }\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin >> n >> deadline;\n    ++deadline;\n    m = n;\n\n    sci.resize(n);\n    rea.resize(n);\n    for (int i = 0; i < n; ++i) cin >> sci[i];\n\n    danger.assign(n, vector<int>(m, INF));\n    queue<pii> q0;\n    for (int i = 0; i < n; ++i) {\n        cin >> rea[i];\n        for (int j = 0; j < m; ++j) {\n            danger[i][j] = INF;\n            if (rea[i][j] == 'Z') {\n                q0.push(pii(i, j));\n                danger[i][j] = 1;\n            }\n        }\n    }\n\n    while (!q0.empty()) {\n        int x = q0.front().first;\n        int y = q0.front().second;\n        q0.pop();\n        for (int da = -1; da <= 1; ++da)\n            for (int db = -1; db <= 1; ++db) {\n                if (abs(da) + abs(db) != 1) continue;\n                int nx = x + da, ny = y + db;\n                if (valid(nx, ny) && danger[nx][ny] == INF && sci[nx][ny] != 'Y') {\n                    danger[nx][ny] = danger[x][y] + 1;\n                    q0.push(pii(nx, ny));\n                }\n            }\n    }\n\n    int src = 0;\n    int sink = n * n + n * n + 1