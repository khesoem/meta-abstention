  if (u % z)\n            add(b, u, z, t, (u + z - 1) / z);\n    }\n\n    cout << pq.top().num << '/' << pq.top().den;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static long gcd(long a, long b) {\n        return b == 0 ? a : gcd(b, a % b);\n    }\n\n    static class Candidate {\n        double dist;\n        long den;\n        long num;\n        \n        Candidate(double dist, long den, long num) {\n            this.dist = dist;\n            this.den = den;\n            this.num = num;\n        }\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        scanner.close();\n        \n        long g = gcd(x, y);\n        x /= g;\n        y /= g;\n        long q = x / y;\n        long rem = x % y;\n        \n        PriorityQueue<Candidate> pq = new PriorityQueue<>((a, b) -> {\n            if (a.dist != b.dist) return Double.compare(a.dist, b.dist);\n            if (a.den != b.den) return Long.compare(a.den, b.den);\n            return Long.compare(a.num, b.num);\n        });\n        \n        for (long b = 1; b <= n; ++b) {\n            long gb = gcd(y, b);\n            long c = b / gb;\n            long z = y / gb;\n            long t = b * z;\n            long u = q * t + rem * c;\n            \n            long gg = gcd(u / z, b);\n            double dist = Math.abs((double)(u - (u / z) * z) / t);\n            pq.add(new Candidate(dist, b / gg, (u / z) / gg));\n            \n            if (u % z != 0) {\n                long altNum = (u + z - 1) / z;\n                gg = gcd(altNum, b);\n                dist = Math.abs((double)(u - altNum * z) / t);\n                pq.add(new Candidate(dist, b / gg, altNum / gg));\n  