, ny)) {\n                distZ[nx][ny] = distZ[cur.x][cur.y] + 1;\n                seen[nx][ny] = 1;\n                q.push(Point{nx, ny});\n            }\n        }\n    }\n}\n\nvoid findLinks(int tx, int ty, int node) {\n    memset(seen, 0, sizeof(seen));\n    memset(distCell, 60, sizeof(distCell));\n    queue<Point> q;\n    seen[tx][ty] = 1;\n    distCell[tx][ty] = 0;\n    q.push(Point{tx, ty});\n    while (!q.empty()) {\n        Point cur = q.front(); q.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nx = cur.x + dx[k], ny = cur.y + dy[k];\n            if (valid(nx, ny)) {\n                distCell[nx][ny] = distCell[cur.x][cur.y] + 1;\n                seen[nx][ny] = 1;\n                if (distCell[nx][ny] < distZ[nx][ny]) q.push(Point{nx, ny});\n            }\n        }\n    }\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (distCell[i][j] <= timeLim && H[i][j] > '0' && H[i][j] <= '9' && distCell[i][j] <= distZ[i][j])\n                addEdge(node, id[i][j] + tot, INF);\n}\n\nvoid enqueue(int u) {\n    if (u != S && u != T && excess[u] > 0 && !active[u]) {\n        active[u] = true;\n        activeQ.push(u);\n    }\n}\n\nvoid pushFlow(int u, int v) {\n    int d = min(excess[u], cap[u][v]);\n    cap[u][v] -= d;\n    cap[v][u] += d;\n    excess[u] -= d;\n    excess[v] += d;\n    enqueue(v);\n}\n\nvoid relabel(int u) {\n    int mn = INF;\n    for (int v = 0; v < MAXV; ++v)\n        if (cap[u][v] > 0) mn = min(mn, height[v]);\n    height[u] = mn + 1;\n}\n\nvoid discharge(int u) {\n    while (excess[u] > 0) {\n        bool pushed = false;\n        for (int v = 0; v < MAXV; ++v) {\n            if (cap[u][v] > 0 && height[u] == height[v] + 1) {\n                pushFlow(u, v);\n                pushed = true;\n                if (excess[u] == 0) break;\n            }\n        }\n        if (!pushed) relabel(u);\n    }\n}\n\nint maxflow() {\n    memset(height, 0, sizeof(height));\n    memset(excess, 0, sizeof(excess));\n    memset(active, 0, sizeof(active));\n    while (!activeQ.empty()) activeQ.pop();\n\n    height[S] = MAXV;\n    for (int v = 0; v < MAXV; ++v) {\n        if (cap[S][v] > 0) {\n            int d = cap[S][v];\n            cap[S][v] = 0;\n            cap[v][S] += d;\n            excess[v] += d;\n            excess[S] -= d;\n            enqueue(v);\n        }\n    }\n\n    while (!activeQ.empty()) {\n        int u = activeQ.front();\n        activeQ.pop();\n        active[u] = false;\n        discharge(u);\n    }\n\n    return excess[T];\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &timeLim);\n    for (int i = 0; i < n; ++i) scanf(\"%s\", G[i]);\n    for (int i = 0; i < n; ++i) scanf(\"%s\", H[i]);\n\n    for (sx = 0; sx < n; ++sx) {\n        for (sy = 0; sy < n; ++sy)\n            if (G[sx][sy] == 'Z') break;\n        if (sy != n) break;\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) id[i][j] = ++tot;\n\n    S = 2 * tot + 1;\n    T = S + 1;\n\n    bfsZ();\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (G[i][j] > '0' && G[i][j] <= '9') {\n                addEdge(S, id[i][j], G[i][j] - '0');\n                findLinks(i, j, id[i][j]);\n            }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (H[i][j] > '0' && H[i][j] <= '9')\n                addEdge(id[i][j] + tot, T, H[i][j] - '0');\n\n    printf(\"%d\\n\", maxflow());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    n, timeLim = map(int, data[0].split())\n    G = [list(data[i+1].strip()) for i in range(n)]\n    H = [list(data[i+1+n].strip()) for i in range(n)]\n\n    # find zombie start\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if G[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n\n    # assign ids\n    id = [[0]*n for _ in range(n)]\n    tot = 0\n    for i in range(n):\n        for j in range(n):\n            tot += 1\n            id[i][j] = tot\n\n    S = 2 * tot + 1\n    T = S + 1\n    MAXV = T + 1\n    INF = 10**9\n\n    cap = [[0]*MAXV for _ in range(MAXV)]\n\n    # directions\n    dx = [0, 0, -1, 1]\n    dy = [1, -1, 0, 0]\n\n    # BFS from zombie\n    distZ = [[INF]*n for _ in range(n)]\n    seen = [[False]*n for _ in range(n)]\n    q = deque()\n    distZ[sx][sy] = 0\n    seen[sx][sy] = True\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx, ny = x + dx[k], y + dy[k]\n            if 0 <= nx < n and 0 <= ny < n and not seen[nx][ny] and '0' <= G[nx][ny] <= '9':\n                distZ[nx][ny] = distZ[x][y] + 1\n                seen[nx][ny] = True\n                q.append((nx, ny))\n\n    def addEdge(u, v, c):\n        cap[u][v] += c\n\n    def findLinks(tx, ty, node):\n        seen2 = [[False]*n for _ in range(n)]\n        distCell = [[INF]*n for _ in range(n)]\n        q = deque()\n        seen2[tx][ty] = True\n        distCell[tx][ty] = 0\n        q.append((tx, ty))\n        while q:\n            x, y = q.popleft()\n            for k in range(4):\n                nx, ny = x + dx[k], y + dy[k]\n                if 0 <= nx < n and 0 <= ny < n and not seen2[nx][ny] and '0' <= G[nx][ny] <= '9':\n                    distCell[nx][ny] = distCell[x][y] + 1\n                    seen2[nx][ny] = True\n                    if distCell[nx][ny] < distZ[nx][ny]:\n                        q.append((nx, ny))\n        for i in range(n):\n            for j in range(n):\n                if distCell[i][j] <= timeLim and '0' < H[i][j] <= '9' and distCell[i][j] <= distZ[i][j]:\n                    addEdge(node, id[i][j] + tot, INF)\n\n    # add edges from source to G cells\n    for i in range(n):\n        for j in range(n):\n            if '0' < G[i][j] <= '9':\n                addEdge(S, id[i][j], int(G[i][j]))\n                findLinks(i, j, id[i][j])\n\n    # add edges from H cells to sink\n    for i in range(n):\n        for j in range(n):\n            if '0' < H[i][j] <= '9':\n                addEdge(id[i][j] + tot, T, int(H[i][j]))\n\n    # push-relabel max flow\n    height = [0]*MAXV\n    excess = [0]*MAXV\n    active = [False]*MAXV\n    activeQ = deque()\n\n    def enqueue(u):\n        if u != S and u != T and excess[u] > 0 and not active[u]:\n            active[u] = True\n            activeQ.append(u)\n\n    def pushFlow(u, v):\n        d = min(excess[u], cap[u][v])\n        cap[u][v] -= d\n        cap[v][u] += d\n        excess[u] -= d\n        excess[v] += d\n        enqueue(v)\n\n    def relabel(u):\n        mn = INF\n        for v in range(MAXV):\n            if cap[u][v] > 0:\n                mn = min(mn, height[v])\n        height[u] = mn + 1\n\n    def discharge(u):\n        while excess[u] > 0:\n            pushed = False\n            for v in range(MAXV):\n                if cap[u][v] > 0 and height[u] == height[v] + 1:\n                    pushFlow(u, v)\n                    pushed = True\n                    if excess[u] == 0:\n                        break\n            if not pushed:\n                relabel(u)\n\n    # initialize\n    height[S] = MAXV\n    for v in range(MAXV):\n        if cap[S][v] > 0:\n            d = cap[S][v]\n            cap[S][v] = 0\n            cap[v][S] += d\n            excess[v] += d\n            excess[S] -= d\n            enqueue(v)\n\n    while activeQ:\n        u = activeQ.popleft()\n        active[u] = False\n        discharge(u)\n\n    print(excess[T])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-6.067568756407127e-05, -3.576278118089249e-07, -7.152555099310121e-07, -0.0005644