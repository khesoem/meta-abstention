        if (!in_queue[to[i]]) {\n                in_queue[to[i]] = true;\n                q.push(to[i]);\n            }\n        }\n    }\n    return dist[sink] != BIG;\n}\n\nvoid augment() {\n    int cur = sink;\n    while (cur != src) {\n        int e = prev_edge[cur];\n        cap[e] -= flow[sink];\n        cap[e ^ 1] += flow[sink];\n        cur = to[e ^ 1];\n    }\n    total += flow[sink] * dist[sink];\n}\n\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    sink = (n + k - 1) * n + 1;\n    for (int i = 1, x; i <= k; i++) {\n        cin >> x;\n        add_edge(src, x, 1, 0);\n    }\n    for (int i = 1, x, y; i <= m; i++) {\n        cin >> x >> y;\n        for (int j = 1; j <= n + k; j++)\n            for (int h = 1; h <= k; h++) {\n                add_edge(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n                add_edge(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c);\n            }\n    }\n    for (int i = 1; i < n + k; i++) {\n        for (int j = 2; j <= n; j++)\n            add_edge(j + (i - 1) * n, j + i * n, BIG, c);\n        add_edge(1 + (i - 1) * n, 1 + i * n, BIG, 0);\n    }\n    while (spfa()) augment();\n    cout << total << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 10000010;\n    static final int BIG = 0x3f3f3f3f;\n    static int n, m, k, c, d, src = 0, sink, total = 0;\n    static int edge_cnt = 1;\n    static int[] head = new int[MAXN];\n    static int[] to = new int[MAXN];\n    static int[] nxt = new int[MAXN];\n    static int[] cap = new int[MAXN];\n    static int[] cost = new int[MAXN];\n    static int[] dist = new int[MAXN];\n    static int[] flow = new int[MAXN];\n    static int[] prev_edge = new int[MAXN];\n    static boolean[] in_queue = new boolean[MAXN];\n\n    static void add_edge(int x, int y, int z, int