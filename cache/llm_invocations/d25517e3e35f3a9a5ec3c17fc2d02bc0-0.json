 }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid update_flow(int s, int t) {\n    int cur = t;\n    while (cur != s) {\n        e[pre[cur]].cap--;\n        e[pre[cur] ^ 1].cap++;\n        cur = e[pre[cur] ^ 1].to;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    cin >> n >> m >> k >> c >> d;\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; ++i) {\n        cin >> a[i];\n        link(S, idx(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; ++i) {\n        cin >> x[i] >> y[i];\n    }\n    for (int t = 0; t <= 100; ++t) {\n        for (int i = 2; i <= n; ++i) {\n            link(idx(t, i), idx(t + 1, i), k, c);\n        }\n        link(idx(t, 1), T, k, 0);\n        for (int i = 1; i <= m; ++i) {\n            int limit = min(k, 25);\n            for (int j = 1; j <= limit; ++j) {\n                int cost = c + (2 * j - 1) * d;\n                link(idx(t, x[i]), idx(t + 1, y[i]), 1, cost);\n                link(idx(t, y[i]), idx(t + 1, x[i]), 1, cost);\n            }\n        }\n    }\n    while (bfs_spfa(S, T)) update_flow(S, T);\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 6010;\n    static final int INF = 0x3f3f3f3f;\n\n    static int n, m, k, c, d, ecnt, ans;\n    static int[] a = new int[6010];\n    static int[] x = new int[6010];\n    static int[] y = new int[6010];\n    static int[] head = new int[MAXN];\n    static int[] pre = new int[MAXN];\n    static int[] dist = new int[MAXN];\n    static int[] inq = new int[MAXN];\n    static Queue<Integer> q = new LinkedList<>();\n\n    static class Edge {\n        int to, cap, cost, nxt;\n\n        Edge(int to, int cap, int cost, int nxt) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.nxt = nxt;\n        }\n    }\n\n    static Edge[] e = new Edge[2000010];\n\n    static int idx(int t, int v) {\n        return t * n + v;\n    }\n\n    static void link(int u, int v, int cap, int cost) {\n        e[ecnt] = new Edge(v, cap, cost, head[u]);\n        head[u] = ecnt++;\n        e[ecnt] = new Edge(u, 0, -cost, head[v]);\n        head[v] = ecnt++;\n    }\n\n    static boolean bfs_spfa(int s, int t) {\n        Arrays.fill(dist, INF);\n        q.offer(s);\n        dist[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = 0;\n            for (int i = head[u]; ~i != 0; i = e[i].nxt) {\n                int v = e[i].to;\n                if (e[i].cap > 0 && dist[v] > dist[u] + e[i].cost) {\n                    dist[v] = dist[u] + e[i].cost;\n                    pre[v] = i;\n                    if (inq[v] == 0) {\n                        q.offer(v);\n                        inq[v] = 1;\n                    }\n                }\n            }\n        }\n        return dist[t] < 1e9;\n    }\n\n    static void update_flow(int s, int t) {\n        int cur = t;\n        while (cur != s) {\n            e[pre[cur]].cap--;\n            e[pre[cur] ^ 1].cap++;\n            cur = e[pre[cur] ^ 1].to;\n        }\n        ans += dist[t];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        Arrays.fill(head, -1);\n        ecnt = 0;\n        ans = 0;\n\n        int S = 0;\n        int T = 6000;\n\n        for (int i = 1; i <= k; ++i) {\n            a[i] = sc.nextInt();\n            link(S, idx(0, a[i]), 1, 0);\n        }\n\n        for (int i = 1; i <= m; ++i) {\n            x[i] = sc.nextInt();\n            y[i] = sc.nextInt();\n        }\n\n        for (int t = 0; t <= 100; ++t) {\n            for (int i = 2; i <= n; ++i) {\n           