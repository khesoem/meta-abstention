n        q.append(s)\n        id[s] = 1\n        while q:\n            v = q.popleft()\n            id[v] = 2\n            for i, e in enumerate(g[v]):\n                if e[1] > 0 and d[v] + e[2] < d[e[0]]:\n                    d[e[0]] = d[v] + e[2]\n                    if id[e[0]] == 0:\n                        q.append(e[0])\n                    elif id[e[0]] == 2:\n                        q.appendleft(e[0])\n                    id[e[0]] = 1\n                    p[e[0]] = v\n                    p_edge[e[0]] = i\n        if d[t] == INF:\n            break\n        addflow = maxf - flow\n        v = t\n        while v != s:\n            pv = p[v]\n            e = g[pv][p_edge[v]]\n            addflow = min(addflow, e[1])\n            v = pv\n        v = t\n        while v != s:\n            pv = p[v]\n            e = g[pv][p_edge[v]]\n            e[1] -= addflow\n            rev = g[v][e[3]]\n            rev[1] += addflow\n            cost += e[2] * addflow\n            v = pv\n        flow += addflow\n    # assert flow == maxf\n    return cost\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    n = N * 101 + 2\n    g = [[] for _ in range(n)]\n    s = n - 2\n    t = n - 1\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        add_edge(g, s, x * 101, 1, 0)\n\n    for i in range(101):\n        add_edge(g, i, t, INF, i * c)\n\n    for i in range(1, N):\n        for j in range(100):\n            add_edge(g, i * 101 + j, i * 101 + j + 1, INF, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(100):\n            for K in range(1, k + 1):\n                cost_val = d * K * K - d * (K - 1) * (K - 1)\n                add_edge(g, u * 101 + j, v * 101 + j + 1, 1, cost_val)\n                add_edge(g, v * 101 + j, u * 101 + j + 1, 1, cost_val)\n\n    result = min_cost_flow(g, s, t, k)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-7.86750388215296e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.0006124289939180017, -0.01833537593483925, -2.8490614567999728e-05, -0.000277123210253194, -0.0016333822859451175, -1.4305104514278355e-06, -2.3841855067985307e-07, -4.410734163684538e-06, -0.0015135272406041622, -0.014243250712752342, -3.6954811548639555e-06, -2.0265558760002023e-06, -0.005244189407676458, -1.9102267026901245, -1.1920928244535389e-07, -4.076874756719917e-05, -0.038397107273340225, -0.05382677912712097, -0.0028364923782646656, -0.014170265756547451, -1.5019521713256836, -0.00012361239350866526, -0.1636551320552826, -2.0265558760002023e-06, 0.0, -1.1920928244535389e-07, -0.00013469743134919554, -5.960462772236497e-07, -1.0728830375228426e-06, -4.291525328881107e-06, -1.156323378381785e-05, -0.8031835556030273, -3.576272320060525e-06, 0.0, -4.768370445162873e-07, -5.960462772236497e-07, -4.124556289752945e-05, -2.3841855067985307e-07, 0.0, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.4305104514278355e-06, 0.0, -1.0728830375228426e-06, -3.576278118089249e-07, 0.0, -3.576278118089249e-07, -1.4305104514278355e-06, -0.018151365220546722, 0.0, -5.006777428206988e-06, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, -2.145764938177308e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.7881377516459906e-06, -9.536738616588991e-07, 0.0, 0.0, -5.960462772236497e-07, -1.1920922133867862e-06, 0.0, 0.0, -0.00010930894495686516, -7.152555099310121e-07, -1.4305104514278355e-06, -0.01420799270272255, -7.73638384998776e-05, -1.9119632244110107, -0.0002706876548472792, -0.0015069806249812245, -2.3841855067985307e-07, -0.005597275216132402, -4.768370445162873e-07, -0.004400451667606831, 0.0, 0.0, -2.26497400035441