one\n        self.head = 0\n        self.cnt = 0\n\n    def init(self):\n        self.aa_ = [[] for _ in range(self.n_)]\n        self.pi = [0] * self.n_\n        self.dd = [0] * self.n_\n        self.bb = [0] * self.n_\n        self.qq = deque()\n        self.iq = [False] * self.n_\n        self.uu = []\n        self.vv = []\n        self.uv = []\n        self.cost = []\n        self.cc = []\n        self.m_ = 0\n\n    def link(self, u, v, cap, cos):\n        h = self.m_\n        self.m_ += 1\n        self.uu.append(u)\n        self.vv.append(v)\n        self.uv.append(u ^ v)\n        self.cost.append(cos)\n        # forward edge (even index)\n        self.cc.append(cap)\n        self.aa_[u].append(2 * h)\n        # backward edge (odd index)\n        self.cc.append(0)\n        self.aa_[v].append(2 * h + 1)\n\n    def enqueue(self, v):\n        if not self.iq[v]:\n            self.qq.append(v)\n            self.iq[v] = True\n\n    def dequeue(self):\n        u = self.qq.popleft()\n        self.iq[u] = False\n        return u\n\n    def spfa(self, s, t):\n        INF = self.INF\n        self.pi = [INF] * self.n_\n        self.dd = [0] * self.n_\n        self.pi[s] = 0\n        self.qq.clear()\n        self.iq = [False] * self.n_\n        self.enqueue(s)\n        while self.qq:\n            u = self.dequeue()\n            d = self.dd[u] + 1\n            for h_ in self.aa_[u]:\n                if self.cc[h_] > 0:\n                    h = h_ >> 1\n                    p = self.pi[u] + (self.cost[h] if (h_ & 1) == 0 else -self.cost[h])\n                    v = u ^ self.uv[h]\n                    if self.pi[v] > p or (self.pi[v] == p and self.dd[v] > d):\n                        self.pi[v] = p\n                        self.dd[v] = d\n                        self.bb[v] = h_\n                        self.enqueue(v)\n        return self.pi[t] != INF\n\n    def push1(self, s, t):\n        u = t\n        while u != s:\n            h_ = self.bb[u]\n            h = h_ >> 1\n     