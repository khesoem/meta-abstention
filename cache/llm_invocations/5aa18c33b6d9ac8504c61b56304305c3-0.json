 Aux = [[0] * (K + 1) for _ in range(K + 1)]\n        mul_matrix(A[0][x], S[0][x + 1], Aux, K + 1, K + 1, K + 1)\n        copy_matrix(S[0][x], Aux, K + 1)\n    \n    cnt = 1\n    m = K\n    while m <= N:\n        for x in range(K):\n            if x > 0:\n                copy_matrix(A[cnt][x], S[cnt - 1][x], K + 1)\n                Aux = [[0] * (K + 1) for _ in range(K + 1)]\n                mul_matrix(A[cnt][x], P[cnt - 1][x - 1], Aux, K + 1, K + 1, K + 1)\n                copy_matrix(A[cnt][x], Aux, K + 1)\n            else:\n                copy_matrix(A[cnt][x], S[cnt - 1][x], K + 1)\n        \n        copy_matrix(P[cnt][0], A[cnt][0], K + 1)\n        copy_matrix(S[cnt][K - 1], A[cnt][K - 1], K + 1)\n        \n        for x in range(1, K):\n            Aux = [[0] * (K + 1) for _ in range(K + 1)]\n            mul_matrix(P[cnt][x - 1], A[cnt][x], Aux, K + 1, K + 1, K + 1)\n            copy_matrix(P[cnt][x], Aux, K + 1)\n        \n        for x in range(K - 2, -1, -1):\n            Aux = [[0] * (K + 1) for _ in range(K + 1)]\n            mul_matrix(A[cnt][x], S[cnt][x + 1], Aux, K + 1, K + 1, K + 1)\n            copy_matrix(S[cnt][x], Aux, K + 1)\n        \n        if m > N // K:\n            break\n        m *= K\n        cnt += 1\n        if cnt >= max_cnt:\n            break\n    \n    # Main computation\n    init = N\n    ind2 = 0\n    for i in range(ind, -1, -1):\n        while Power[i] <= init:\n            Aux = [[0] * (K + 1) for _ in range(K + 1)]\n            mul_matrix(Res, A[i][ind2], Aux, K + 1, K + 1, K + 1)\n            copy_matrix(Res, Aux, K + 1)\n            ind2 += 1\n            if ind2 == K:\n                ind2 = 0\n            init -= Power[i]\n    \n    ans = 0\n    for i in range(K + 1):\n        ans = add_mod(ans, Res[0][i])\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001003691868390888, -5.960462772236497e-07, -5.960462772236497e-07, -0.