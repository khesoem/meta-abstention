{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\n<your_rewritten_code_1>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        new Main().run();\n    }\n\n    private void run() {\n        try (BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n             PrintWriter pw = new PrintWriter(System.out)) {\n            \n            String[] line = br.readLine().split(\"\\\\s+\");\n            int n = Integer.parseInt(line[0]);\n            int m = Integer.parseInt(line[1]);\n\n            Mod998 mod = new Mod998();\n            mod.precomputeFactorials(n + m);\n\n            long phaseSize = 1;\n            long p = 1;\n            for (int i = 0; p != 0; i++) {\n                p = mod.multiply(p, mod.multiply(n - i, mod.modInverse(n + m - i)));\n                phaseSize = mod.add(phaseSize, p);\n            }\n\n            long answer = 0;\n            for (int k = 1; k <= n; k++) {\n                long numPhases = mod.multiply(m + k, mod.modInverse(k));\n                long term = mod.multiply(mod.nCr(n, k), mod.multiply(numPhases, phaseSize));\n                if (k % 2 == 1)\n                    answer = mod.add(answer, term);\n                else\n                    answer = mod.subtract(answer, term);\n            }\n\n            pw.println(answer);\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998_244_353L;\n        private long[] fact;\n        private long[] invFact;\n\n        public void precomputeFactorials(int maxN) {\n            fact = new long[maxN + 1];\n            invFact = new long[maxN + 1];\n            fact[0] = 1;\n            for (int i = 1; i <= maxN; i++) {\n                fact[i] = multiply(fact[i - 1], i);\n            }\n            invFact[maxN] = modInverse(fact[maxN]);\n            for (int i = maxN - 1; i >= 0; i--) {\n                invFact[i] = multiply(invFact[i + 1], i + 1);\n            }\n        }\n\n        public long nCr(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return multiply(fact[n], multiply(invFact[r], invFact[n - r]));\n        }\n\n        public long modInverse(int x) {\n            return modInverse((long) x);\n        }\n\n        public long modInverse(long x) {\n            return power(x, MOD - 2);\n        }\n\n        public long power(long base, long exp) {\n            long result = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) result = multiply(result, base);\n                base = multiply(base, base);\n                exp >>= 1;\n            }\n            return result;\n        }\n\n        public long add(long a, long b) {\n            a %= MOD; b %= MOD;\n            long res = a + b;\n            return res >= MOD ? res - MOD : res;\n        }\n\n        public long subtract(long a, long b) {\n            a %= MOD; b %= MOD;\n            long res = a - b;\n            return res < 0 ? res + MOD : res;\n        }\n\n        public long multiply(long a, long b) {\n            return (a * b) % MOD;\n        }\n    }\n}\n</your_rewritten_code_1>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\n\nusing namespace std;\n\nclass Mod998 {\nprivate:\n    static const long long MOD = 998244353LL;\n    vector<long long> fact;\n    vector<long long> invFact;\n\npublic:\n    void precomputeFactorials(int maxN) {\n        fact.resize(maxN + 1);\n        invFact.resize(maxN + 1);\n        fact[0] = 1;\n        for (int i = 1; i <= maxN; i++) {\n            fact[i] = multiply(fact[i - 1], i);\n        }\n        invFact[maxN] = modInverse(fact[maxN]);\n        for (int i = maxN - 1; i >= 0; i--) {\n            invFact[i] = multiply(invFact[i + 1], i + 1);\n        }\n    }\n\n    long long nCr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return multiply(fact[n], multiply(invFact[r], invFact[n - r]));\n    }\n\n    long long modInverse(int x) {\n        return modInverse((long long)x);\n    }\n\n    long long modInverse(long long x) {\n        return power(x, MOD - 2);\n    }\n\n    long long power(long long base, long long exp) {\n        long long result = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) \n                result = multiply(result, base);\n            base = multiply(base, base);\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    long long add(long long a, long long b) {\n        a %= MOD; b %= MOD;\n        long long res = a + b;\n        return res >= MOD ? res - MOD : res;\n    }\n\n    long long subtract(long long a, long long b) {\n        a %= MOD; b %= MOD;\n        long long res = a - b;\n        return res < 0 ? res + MOD : res;\n    }\n\n    long long multiply(long long a, long long b) {\n        return (a * b) % MOD;\n    }\n};\n\nint main() {\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    \n    int n, m;\n    iss >> n >> m;\n\n    Mod998 mod;\n    mod.precomputeFactorials(n + m);\n\n    long long phaseSize = 1;\n    long long p = 1;\n    for (int i = 0; p != 0; i++) {\n        long long term1 = mod.multiply(n - i, mod.modInverse(n + m - i));\n        p = mod.multiply(p, term1);\n        phaseSize = mod.add(phaseSize, p);\n    }\n\n    long long answer = 0;\n    for (int k = 1; k <= n; k++) {\n        long long numPhases = mod.multiply(m + k, mod.modInverse(k));\n        long long term = mod.multiply(mod.nCr(n, k), mod.multiply(numPhases, phaseSize));\n        if (k % 2 == 1)\n            answer = mod.add(answer, term);\n        else\n            answer = mod.subtract(answer, term);\n    }\n\n    cout << answer << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012587709352374077, -1.9073468138230965e-06, -7.152555099310121e-07, -0.0007046362152323127, -5.960462772236497e-07, -5.245195097813848e-06, -2.0265558760002023e-06, -1.2755313036905136e-05, -4.768370445162873e-07, -0.19114458560943604, -7.510157047363464e-06, -5.3165931603871286e-05, -1.0728830375228426e-06, -0.01669858768582344, -2.9802276912960224e-06, -0.00038068200228735805, -3.182837463100441e-05, -0.0015607806853950024, -0.04858914390206337, -0.1602337509393692, -4.410734163684538e-06, -0.4659990668296814, -0.4740806818008423, -0.048889681696891785, -1.5139465176616795e-05, -2.861018856492592e-06, -5.960462772236497e-07, -0.13962912559509277, -0.0010271755745634437, -1.7881377516459906e-06, -1.4305104514278355e-06, -4.768370445162873e-07, -6.198863957251888e-06, -0.07903273403644562, -1.1920928244535389e-07, -2.861018856492592e-06, -6.318072337307967e-06, -0.00249182409606874, -4.291525328881107e-06, -0.00010966652916977182, -4.768360213347478e-06, 0.0, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.811964830267243e-05,