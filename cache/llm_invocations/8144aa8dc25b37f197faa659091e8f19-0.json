ff + M1) - store[i].begin();\n            LL term = (1LL * diff * store[i].size() % M2 + pref[i]) % M2;\n            LL sub = 1LL * (store[i].size() - idx) * M1 % M2;\n            ans = (ans + term - sub + M2) % M2;\n            cnt += store[i].size();\n        }\n        return;\n    }\n    int add = (++cnt) - x;\n    if (add < 0) add += M1;\n    ans = (ans + add) % M2;\n    for (int d = 0; d <= 9; ++d)\n        walk2(x * 10 + d);\n}\n\nint main() {\n#ifdef YuukiYumesaki\n    freopen(\"testdata.in\", \"r\", stdin);\n    freopen(\"test1.out\", \"w\", stdout);\n#endif\n    read(n);\n    walk1(0, 0);\n    for (int i = 0; i <= 6; ++i) sort(store[i].begin(), store[i].end());\n    cnt = 0;\n    for (int i = 1; i <= 9; ++i) walk2(i);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```java\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int M1 = 998244353;\n    static final int M2 = 1000000007;\n    static final int BASE = 1000000;\n\n    static long n;\n    static ArrayList<Integer>[] store = new ArrayList[10];\n    static long cnt;\n    static int[] pref = new int[10];\n    static int ans;\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n    }\n\n    static int lowerBound(ArrayList<Integer> list, int key) {\n        int lo = 0, hi = list.size();\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            if (list.get(mid) < key) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        return lo;\n    }\n\n    static void walk1(int u, int x) {\n        cnt++;\n        int p = (int)((cnt - x) % M1);\n        if (p < 0) p += M1;\n        store[u].add(p);\n        pref[u] = (pref[u] + p) % M2;\n        if (u == 6) return;\n        for (int d = 0; d <= 9; d++) {\n            walk1(u + 1, 10 * x + d);\n        }\n    }\n\n    static void walk2(long x) {\n        if (x > n) return;\n        if (x * BASE + BASE - 1 <= n && x * BASE * 10 > n) {\n            long cur = cnt;\n            for (int i = 0, mul = 1; i <= 6; i++, mul *= 10) {\n                long diff = (cur - x * mul) % M1;\n                if (diff < 0) diff += M1;\n                int key = (int)(-diff + M1);\n                int idx = lowerBound(store[i], key);\n                long term = (diff * store[i].size() % M2 + pref[i]) % M2;\n                long sub = (long)(store[i].size() - idx) * M1 % M2;\n                ans = (int)((ans + term - sub + M2) % M2);\n                cnt += store[i].size();\n            }\n            return;\n        }\n        cnt++;\n        int add = (int)((cnt - x) % M1);\n        if (add < 0) add += M1;\n        ans = (ans + add) % M2;\n        for (int d = 0; d <= 9; d++) {\n            walk2(x * 10 + d);\n        }\n    }\n\n    public static void main(String[] args) {\n        FastReader fr = new FastReader();\n        n = fr.nextLong();\n        for (int i = 0; i < 10; i++) {\n            store[i] = new ArrayList<>();\n        }\n        walk1(0, 0);\n        for (int i = 0; i <= 6; i++) {\n            Collections.sort(store[i]);\n        }\n        cnt = 0;\n        for (int i = 1; i <= 9; i++) {\n            walk2(i);\n        }\n        System.out.println(ans);\n    }\n}\n```", "token_logprobs": [-0.16025832295417786, 0.0,