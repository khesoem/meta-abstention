ll(d, Integer.MAX_VALUE);\n        Arrays.fill(vis, 0);\n        Arrays.fill(pre, -1);\n        d[s] = 0;\n        q.add(s);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = 0;\n            for (int i = head[u]; i != -1; i = edges[i].next) {\n                if (edges[i].flow > 0 && d[edges[i].to] > d[u] + edges[i].cost) {\n                    d[edges[i].to] = d[u] + edges[i].cost;\n                    pre[edges[i].to] = u;\n                    id[edges[i].to] = i;\n                    if (!vis[edges[i].to]) {\n                        vis[edges[i].to] = 1;\n                        q.add(edges[i].to);\n                    }\n                }\n            }\n        }\n        return d[t] < Integer.MAX_VALUE;\n    }\n\n    static int MinCostFlow(int s, int t) {\n        int Mi = Integer.MAX_VALUE;\n        int sum = 0;\n        int tt = 0;\n        while (spfa(s, t)) {\n            Mi = Integer.MAX_VALUE;\n            for (int i = t; i != s; i = pre[i]) {\n                Mi = Math.min(Mi, edges[id[i]].flow);\n            }\n            for (int i = t; i != s; i = pre[i]) {\n                edges[id[i]].flow -= Mi;\n                edges[id[i] ^ 1].flow += Mi;\n            }\n            tt += Mi;\n            sum += d[t] * Mi;\n        }\n        return sum;\n    }\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.12987753748893738, -0.007863963022828102, -0.3149294853210449, -0.03736367076635361, -0.0001976089261006564, -0.6936835646629333, -0.47336524724960327, -0.01457532960921526, -0.00012911199883092195, -0.021039754152297974, -0.3545348048210144, -0.010200613178312778, -2.2649790025752736e-06, -0.12816552817821503, -0.14920467138290405, -0.023716099560260773, -0.07020653784275055, -0.5091596245765686, -0.25446614623069763, -0.016772430390119553, -0.0004570336313918233, -0.004946584813296795, -0.35484540462493896, -0.06299076229333878, -1.1893233060836792, -0.001615517190657556, -0.034382954239845