n\ndef init():\n    global n, p, bin\n    bin = [1]\n    for i in range(1, 21):\n        bin.append(bin[-1] * 2)\n    n = int(input())\n    inv = ksm(100, MOD - 2)\n    p = [[0] * (n + 1) for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        line = list(map(int, input().split()))\n        for j in range(1, n + 1):\n            p[i][j] = (line[j-1] * inv) % MOD\n    while n < 6:\n        n += 1\n        p[n][n] = 1\n\ndef match(idx, a, b, ma, vis):\n    if idx > 3:\n        return True\n    for i in range(1, 4):\n        if not vis[i] and ma[a[idx]][b[i]]:\n            vis[i] = True\n            ok = match(idx + 1, a, b, ma, vis)\n            vis[i] = False\n            if ok:\n                return True\n    return False\n\ndef dfs2(x, y, prob, a, ma, pts, f):\n    if x > 3:\n        s = 0\n        for i in range(1, tot + 1):\n            b = pts[i][1:4]\n            vis = [False] * 4\n            if match(1, a, b, ma, vis):\n                s += bin[i - 1]\n        f[s] = (f[s] + prob) % MOD\n        return\n    ma[a[x]][y] = 0\n    if y == n:\n        dfs2(x + 1, 1, (prob * (1 - p[a[x]][y] + MOD)) % MOD, a, ma, pts, f)\n    else:\n        dfs2(x, y + 1, (prob * (1 - p[a[x]][y] + MOD)) % MOD, a, ma, pts, f)\n    ma[a[x]][y] = 1\n    if y == n:\n        dfs2(x + 1, 1, (prob * p[a[x]][y]) % MOD, a, ma, pts, f)\n    else:\n        dfs2(x, y + 1, (prob * p[a[x]][y]) % MOD, a, ma, pts, f)\n\ndef dfs1(x, y, mask, a, id, sta, pts):\n    global tot\n    if y == 3:\n        tot += 1\n        id[mask] = tot\n        sta[tot] = mask\n        for i in range(1, 4):\n            pts[tot][i] = a[i]\n        return\n    if x > n:\n        return\n    dfs1(x + 1, y, mask, a, id, sta, pts)\n    a[y + 1] = x\n    dfs1(x + 1, y + 1, mask + bin[x - 1], a, id, sta, pts)\n\ndef pre(g):\n    for i in range(tot):\n        for j in range(bin[tot]):\n            if j & bin[i]:\n                g[j] = (g[j] + g[j ^ bin[i]]) % MOD\n\ndef main():\n    global n, p, bin, tot\n    init()