= j * t + s + 1\n                for x in range(1, k + 1):\n                    add_edge(u, v, 1, c + (x * 2 - 1) * d)\n    \n    # Add self-loop edges with waiting capability\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            add_edge(u, v, k, 0 if i == 0 else c)\n    \n    # Connect source to starting positions\n    for h in range(k):\n        add_edge(n_ - 1, ii[h] * t + 0, 1, 0)\n    \n    # Run min-cost max-flow using Bellman-Ford (since there might be negative costs)\n    INF = 10**18\n    \n    def bellman_ford(s, t):\n        dist = [INF] * n_\n        prevv = [-1] * n_\n        preve = [-1] * n_\n        dist[s] = 0\n        \n        for _ in range(n_):\n            updated = False\n            for u in range(n_):\n                if dist[u] == INF:\n                    continue\n                for idx, (v, cap, cost, _) in enumerate(graph[u]):\n                    if cap > 0 and dist[v] > dist[u] + cost:\n                        dist[v] = dist[u] + cost\n                        prevv[v] = u\n                        preve[v] = idx\n                        updated = True\n            if not updated:\n                break\n        \n        if dist[t] == INF:\n            return None, None, None\n        \n        # Find minimum capacity along the path\n        flow = INF\n        v = t\n        while v != s:\n            u = prevv[v]\n            idx = preve[v]\n            cap = graph[u][idx][1]\n            flow = min(flow, cap)\n            v = u\n        \n        # Update residual capacities\n        v = t\n        while v != s:\n            u = prevv[v]\n            idx = preve[v]\n            graph[u][idx] = (graph[u][idx][0], graph[u][idx][1] - flow, graph[u][idx][2], graph[u][idx][3])\n            rev_idx = graph[u][idx][3]\n            graph[v][rev_idx] = (graph[v][rev_idx][0], graph[v][rev_idx][1] + flow, graph[v][rev_idx][2], graph[v][rev_idx][3])\n            v = u\n        \