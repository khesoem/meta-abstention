of people on the boat.Help Greg with this problem. \n</problem_description>\n\nHere is the Java 6 code you have to repair:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class C {\n\tstatic int n, k, f, h;\n\tstatic int r1;\n\tstatic long[][][] dp2;\n\tstatic int[][] dp1;\n\tstatic long[][] c;\n\tstatic final int MOD = 1000000007;\n\n\tpublic static void main(String[] args) throws IOException {\n\t\tBufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n\t\tString[] tokens = br.readLine().split(\" \");\n\t\tn = Integer.parseInt(tokens[0]);\n\t\tk = Integer.parseInt(tokens[1]);\n\t\tfor (int i = 0; i < n; i++) {\n\t\t\tint w = Integer.parseInt(br.readLine());\n\t\t\tif (w == 100) h++; else f++;\n\t\t}\n\t\tnCr(55, 55);\n\t\tdp1 = new int[55][55];\n\t\tfor (int i = 0; i < 55; i++) Arrays.fill(dp1[i], -1);\n\t\tdp2 = new long[55][55][102];\n\t\tfor (int i = 0; i < 55; i++) for (int j = 0; j < 55; j++) Arrays.fill(dp2[i][j], -1);\n\t\tr1 = getMin(f, h);\n\t\tif (r1 >= 1 << 25) {\n\t\t\tSystem.out.println(-1);\n\t\t\tSystem.out.println(0);\n\t\t} else {\n\t\t\tlong r2 = go(f, h, 0);\n\t\t\tSystem.out.println(r1);\n\t\t\tSystem.out.println(r2);\n\t\t}\n\t}\n\n\tpublic static long go(int x, int y, int t) {\n\t\tif (x == f && y == h && t == r1) return 1;\n\t\tif (t >= r1) return 0;\n\t\tif (dp2[x][y][t] != -1) return dp2[x][y][t];\n\t\tlong ret = 0;\n\t\tfor (int i = 0; i <= x && i * 50 <= k; i++) {\n\t\t\tfor (int j = 0; j <= y && i * 50 + j * 100 <= k; j++) {\n\t\t\t\tif (i + j == 0 || (i == x && j == y && t % 2 == 1)) continue;\n\t\t\t\tlong term = (go(f - x + i, h - y + j, t + 1) * c[x][i]) % MOD;\n\t\t\t\tterm = (term * c[y][j]) % MOD;\n\t\t\t\tret = (ret + term) % MOD;\n\t\t\t}\n\t\t}\n\t\treturn dp2[x][y][t] = ret;\n\t}\n\n\tpublic static int getMin(int x, int y) {\n\t\tif (x == 0 && y == 0) return 0;\n\t\tif (dp1[x][y] != -1) return dp1[x][y];\n\t\tint ret = Integer.MAX_VALUE;\n\t\tfor (int i = 0; i <= x && i * 50 <= k; i++) {\n\t\t\tfor (int j = 0; j <= y && i * 50 + j * 100 <= k; j++) {\n\t\t\t\tif (i + j == 0) continue;\n\t\t\t\tif (i == x && j == y) {\n\t\t\t\t\tret = 1;\n\t\t\t\t} else {\n\t\t\t\t\tif (i != 0 && j != 0) {\n\t\t\t\t\t\tint a = getMin(x - i + 1, y - j);\n\t\t\t\t\t\tint b = getMin(x - i, y - j + 1);\n\t\t\t\t\t\tret = Math.min(ret, 2 + Math.min(a, b));\n\t\t\t\t\t} else if (i > 1 && j == 0) {\n\t\t\t\t\t\tret = Math.min(ret, 2 + getMin(x - i + 1, y));\n\t\t\t\t\t} else if (i == 0) {\n\t\t\t\t\t\tif (j > 1) ret = Math.min(2 + getMin(x, y - j + 1), ret);\n\t\t\t\t\t\tif (f - x >= 1) ret = Math.min(2 + getMin(x + 1, y - j), ret);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn dp1[x][y] = ret;\n\t}\n\n\tpublic static void nCr(int n, int r) {\n\t\tc = new long[n + 1][r + 1];\n\t\tfor (int i = 0; i <= n; i++) c[i][0] = 1;\n\t\tfor (int j = 1; j <= r; j++) for (int i = j; i <= n; i++) c[i][j] = (c[i - 1][j - 1] + c[i - 1][j]) % MOD;\n\t}\n\n\tstatic class InputReader {\n\t\tBufferedReader in;\n\t\tStringTokenizer st;\n\n\t\tpublic InputReader() throws IOException {\n\t\t\tin = new BufferedReader(new InputStreamReader(System.in));\n\t\t\tst = new StringTokenizer(in.readLine());\n\t\t}\n\n\t\tpublic String next() throws IOException {\n\t\t\twhile (!st.hasMoreElements()) st = new StringTokenizer(in.readLine());\n\t\t\treturn st.nextToken();\n\t\t}\n\n\t\tpublic int nextInt() throws NumberFormatException, IOException {\n\t\t\treturn Integer.parseInt(next());\n\t\t}\n\n\t\tpublic long nextLong() throws NumberFormatException, IOException {\n\t\t\treturn Long.parseLong(next());\n\t\t}\n\t}\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class C {\n    static int n, k, f, h;\n    static int r1;\n    static long[][][] dp2;\n    static int[][] dp1;\n    static long[][] c;\n    static final int MOD = 1000000007;\n\n   