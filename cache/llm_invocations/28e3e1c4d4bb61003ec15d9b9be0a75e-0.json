 100 > k) continue;\n                if (i == x && j == y) {\n                    ret = 1;\n                } else {\n                    int a = getMin(x - i + (i > 0 ? 1 : 0), y - j + (j > 0 ? 1 : 0));\n                    int b = getMin(x - i + (j > 0 ? 1 : 0), y - j + (i > 0 ? 1 : 0));\n                    ret = Math.min(ret, 1 + Math.min(a, b));\n                }\n            }\n        }\n        return dp1[x][y] = ret;\n    }\n\n    public static void nCr(int n, int r) {\n        c = new long[n + 1][r + 1];\n        for (int i = 0; i <= n; i++) {\n            c[i][0] = 1;\n            for (int j = 1; j <= Math.min(i, r); j++) {\n                c[i][j] = (c[i - 1][j - 1] + c[i - 1][j]) % MOD;\n            }\n        }\n    }\n}\n</repaired_code>\n<confidence>\n0.7\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -0.00018094333063345402, -1.1920922133867862e-06, -2.3841855067985307e-07, -0.00012265883560758084, -7.86750388215296e-05, -3.135155202471651e-05, -2.5152843591058627e-05, -0.00010466027742950246, -7.510157047363464e-06, -3.576278118089249e-07, -3.969590397900902e-05, -5.602820692729438e-06, -3.576278118089249e-07, -0.0010215784423053265, -9.42901024245657e-05, -0.5764397978782654, -2.4914430468925275e-05, -6.6756979322235566e-06, -5.960446742392378e-06, -8.344646857949556e-07, -9.536738616588991e-07, -0.01251439843326807, -0.0027140469755977392, -5.245071224635467e-05, -1.6927575416048057e-05, -0.00015937011630740017, -1.0728830375228426e-06, -8.344646857949556e-07, -0.07893756031990051, -0.1410340666770935, -9.536738616588991e-07, -7.390948667307384e-06, -9.536738616588991e-07, -8.344646857949556e-07, -0.001705264556221664, -4.8397800128441304e-05, -0.00017712931730784476, -8.583032467868179e-06, -0.0004985281848348677, -7.033323527139146e-06, -5.960462772236497e-07, -3.576278118089249e-07, -0.0023302086628973484, -7.629365427419543e-06, -1.1444026313256472e-05, 0.0, -5.722029527532868e-06, -7.152555099310121e-07, -7.152555099310121e-07