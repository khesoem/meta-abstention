ex] = 0;\n    queue<int> q;\n    q.push(sourceVertex);\n    inQueue[sourceVertex] = true;\n    \n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inQueue[u] = false;\n        \n        for (int idx : adjacency[u]) {\n            if (getResidual(idx) == 0) continue;\n            int v = linkList[idx].endpoint;\n            int w = linkList[idx].cost;\n            if (distance[v] > distance[u] + w) {\n                distance[v] = distance[u] + w;\n                parentVertex[v] = u;\n                parentLink[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n}\n\nvoid updateFlowAlongPath() {\n    int cur = targetVertex;\n    while (cur != sourceVertex) {\n        int idx = parentLink[cur];\n        linkList[idx].flow++;\n        linkList[idx ^ 1].flow--;\n        cur = parentVertex[cur];\n    }\n    if (distance[targetVertex] != INFINITY_VAL) {\n        totalCost += distance[targetVertex];\n    }\n}\n\nvoid addConnection(int u, int v, int cap, int cst) {\n    adjacency[u].push_back(linkList.size());\n    linkList.emplace_back(v, cap, 0, cst);\n    adjacency[v].push_back(linkList.size());\n    linkList.emplace_back(u, 0, 0, -cst);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        addConnection(sourceVertex, x, 1, 0);\n    }\n    \n    const int MAX_T = 101;\n    for (int t = 0; t < MAX_T; ++t) {\n        addConnection(1 + t * n, targetVertex, k, t * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        for (int t = 0; t < MAX_T - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                int cost = d * (2 * j + 1);\n                addConnection(x + t * n, y + t * n + n, 1, cost);\n  