 0;\n}\n</original_code>\n\n<translated_code>\nimport sys\n\ndef read():\n    ch = sys.stdin.read(1)\n    x = 0\n    f = 1\n    while ch < '0' or ch > '9':\n        if ch == '-':\n            f = -1\n        ch = sys.stdin.read(1)\n    x = ord(ch) - ord('0')\n    while 1:\n        ch = sys.stdin.read(1)\n        if ch < '0' or ch > '9':\n            break\n        x = x * 10 + ord(ch) - ord('0')\n    return x * f\n\nmod = 10**9 + 7\np, k, ret = 0, 0, 0\n\ndef qmul(a, b, Mod):\n    ans = 0\n    while b:\n        if b & 1:\n            ans = (ans + a) % Mod\n        b >>= 1\n        a = (a + a) % Mod\n    return ans\n\ndef qpow(a, b, Mod):\n    ans = 1\n    while b:\n        if b & 1:\n            ans = qmul(ans, a, Mod)\n        b >>= 1\n        a = qmul(a, a, Mod)\n    return ans\n\ndef main():\n    global p, k, ret\n    p = read()\n    k = read()\n    if k == 0:\n        ret = qpow(p, p - 1, mod)\n    if k == 1:\n        ret = qpow(p, p, mod)\n    if k > 1:\n        l = 1\n        cur = k\n        while cur != 1:\n            cur = (cur * k) % p\n            l += 1\n        ret = qpow(p, (p - 1) // l, mod)\n    print(ret)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.3161449134349823, -0.009090110659599304, -0.027329392731189728, -0.00024279984063468874, -0.000366263062460348, -0.0015324526466429234, -0.002496223896741867, -0.00014351768186315894, -0.015174425207078457, -0.00014804698002990335, -0.0029943413101136684, -1.2755313036905136e-05, -0.00043704494601115584, -5.769562994828448e-05, -0.0002348147245356813, -1.0132738680113107e-05, -7.283422019099817e-05, -1.3112935448589269e-05, -5.8412379075889476e-06, -8.856858039507642e-05, -1.0490362910786644e-05, -2.145764938177308e-06, -1.5497195136049413e-06, -5.6622808187967166e-05, -1.6212332411669195e-05, -4.100715523236431e-05, -2.0265558760002023e-06, -9.738924563862383e-05, -1.0728830375228426e-06, -2.861018856492592e-06, -1.43051045