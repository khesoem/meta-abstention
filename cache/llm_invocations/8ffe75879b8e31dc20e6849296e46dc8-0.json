   A[i][j] = S[i-1][j];\n      if (j) A[i][j] = A[i][j] * P[i-1][j-1];\n    }\n  }\n  int x = 0;\n  for (int i = 0; i <= K; ++i) res.m[i][i] = 1;\n  for (int i = (int)base_k.size() - 1; i >= 0; --i) {\n    for (int j = 0; j < base_k[i]; ++j) {\n      res = res * A[i][x];\n      x = (x + 1) % K;\n    }\n  }\n  int ans = 0;\n  for (int i = 0; i <= K; ++i) ans = (ans + res.m[i][K]) % MOD;\n  cout << ans << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 10**9 + 7\n\ndef main():\n    data = sys.stdin.read().split()\n    N = int(data[0])\n    K = int(data[1])\n    \n    # Convert N to base K\n    base_k = []\n    tmp = N\n    while tmp:\n        base_k.append(tmp % K)\n        tmp //= K\n    \n    # Initialize matrices A, P, S\n    # A[i][j] is a (K+1)x(K+1) matrix\n    class Matrix:\n        def __init__(self, zeros=True):\n            self.m = [[0]*(K+1) for _ in range(K+1)]\n            if not zeros:\n                for i in range(K+1):\n                    self.m[i][i] = 1\n        \n        def __mul__(self, other):\n            ret = Matrix()\n            for i in range(K+1):\n                for j in range(K+1):\n                    ret.m[i][j] = 0\n                    for k in range(K+1):\n                        ret.m[i][j] = (ret.m[i][j] + self.m[i][k] * other.m[k][j]) % MOD\n            return ret\n    \n    # Initialize A[0][i] matrices\n    A = [[Matrix() for _ in range(K)] for _ in range(len(base_k))]\n    for i in range(K):\n        for j in range(K+1):\n            A[0][i].m[j][j] = 1\n        for j in range(K+1):\n            A[0][i].m[i][j] = 1\n    \n    # Build higher level A matrices\n    for i in range(1, len(base_k)):\n        # P[i-1][j] = product of A[i-1][0] * A[i-1][1] * ... * A[i-1][j]\n        P = [Matrix() for _ in range(K)]\n        P[0] = A[i-1][0]\n        for j in range(1, K):\n            P[j] = P[j-1] * A[i-1][j]\n        \n        # S[i-1][j] = product of A[i-1][j] * A[i-1][j+1] * ... * A[i-1][K-1]\n        S = [Matrix() for _ in range(K)]\n        S[K-1] = A[i-1][K-1]\n        for j in range(K-2, -1, -1):\n            S[j] = A[i-1][j] * S[j+1]\n        \n        # Build A[i][j]\n        for j in range(K):\n            A[i][j] = S[j]\n            if j > 0:\n                A[i][j] = A[i][j] * P[j-1]\n    \n    # Initialize result matrix as identity\n    res = Matrix(zeros=False)\n    x = 0\n    # Process base_k digits from most significant to least\n    for i in range(len(base_k)-1, -1, -1):\n        for j in range(base_k[i]):\n            res = res * A[i][x]\n            x = (x + 1) % K\n    \n    # Sum up the last column\n    ans = 0\n    for i in range(K+1):\n        ans = (ans + res.m[i][K]) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000248401309363544, -8.344646857949556e-07, -1.1920928244535389e-07, -0.18243245780467987, -0.00011646069469861686, -1.0013530300057027e-05, -0.16045410931110382, -1.1920928244535389e-07, -1.4781842764932662e-05, 0.0, -1.4305104514278355e-06, -0.005250592716038227, 0.0, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -0.00023112009512260556, -0.01864011026918888, -0.06929075717926025, -5.328513361746445e-05, -1.4305104514278355e-06, -0.020970994606614113, -7.152555099310121e-07, -0.0009425011812709272, -4.410734163684538e-06, -0.10060261189937592, -1.7881377516459906e-06, -0.05504681542515755, -8.22540732769994e-06, -2.3841855067985307e-07, -0.34845778346061707, -1.2397689715726301e-05, -5.602820692729438e-06, -1.311301275563892e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.622600959512056e-06, -3.576278118089249e-07, -7.152555099310121e-07, -0.002189621329307556, -2.3841855067985307e-07, -9.536738616588991e-07, -4.768370445162873e-07, 0.0, -4.60137271147687e-05, -6.6756979322235566e-06, -1.9073468138