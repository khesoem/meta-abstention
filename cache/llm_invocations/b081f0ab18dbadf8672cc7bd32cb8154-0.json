ls[i] + vals[n - i - 1];\n                } else {\n                    sum += std::max(vals[i], vals[n - i - 1]);\n                }\n            }\n            std::cout << sum << std::endl;\n        } else {\n            int others = badones[val] - (m - badones[val]);\n            std::vector<int> appr;\n            \n            for (int i = 0; i < n / 2; i++) {\n                if (wordStr[i] != wordStr[n - i - 1] && \n                    wordStr[i] != 'a' + val && \n                    wordStr[n - i - 1] != 'a' + val) {\n                    appr.push_back(std::min(vals[i], vals[n - i - 1]));\n                }\n            }\n            \n            std::sort(appr.begin(), appr.end());\n            \n            long long ans = 0;\n            for (int i = 0; i < n / 2; i++) {\n                if (wordStr[i] == wordStr[n - i - 1]) {\n                    ans += std::max(vals[i], vals[n - i - 1]);\n                } else {\n                    ans += vals[i] + vals[n - i - 1];\n                }\n            }\n            \n            for (int i = 0; i < others && i < (int)appr.size(); i++) {\n                ans -= appr[i];\n            }\n            \n            std::cout << ans << std::endl;\n        }\n    } catch (...) {\n        // Handle any exceptions silently\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.332382276421413e-05, -2.0265558760002023e-06, -7.152555099310121e-07, -0.0007621721015311778, -7.152555099310121e-07, -6.079655122448457e-06, -1.4305104514278355e-06, -2.622600959512056e-06, -1.311301275563892e-06, -0.07492538541555405, -3.576278118089249e-07, -1.156323378381785e-05, -4.768370445162873e-07, -0.4049634337425232, -9.536697689327411e-06, -0.00015901254664640874, -8.344646857949556e-07, -0.15368500351905823, -4.410734163684538e-06, -9.298280929215252e-06, 0.0, -0.00019572250312194228, -3.576278118089249e-07, -1.6927575416048057e-05, -1.1920928244535389e-07, -0.53639006614