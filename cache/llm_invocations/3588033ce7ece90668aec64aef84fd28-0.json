{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <cstdio>\n#include <queue>\n#include <vector>\nusing namespace std;\n\ntypedef long long ll;\nconst int MOD = 1000000007;\n\nll powMod(ll a, ll b) {\n    ll res = 1;\n    while (b) {\n        if (b & 1) res = res * a % MOD;\n        a = a * a % MOD;\n        b >>= 1;\n    }\n    return res;\n}\n\nll isOnePow(ll a, ll b, ll p) {\n    ll res = 1;\n    while (b) {\n        if (b & 1) res = res * a % p;\n        a = a * a % p;\n        b >>= 1;\n    }\n    return (res == 1) ? p : 1;\n}\n\nint main() {\n    int p, k;\n    scanf(\"%d%d\", &p, &k);\n\n    if (k == 0) {\n        printf(\"%lld\", powMod(p, p - 1));\n        return 0;\n    }\n\n    vector<int> nxt(p);\n    vector<int> indeg(p, 0);\n\n    for (int i = 0; i < p; ++i) {\n        nxt[i] = (int)((k * 1LL * i) % p);\n        indeg[nxt[i]]++;\n    }\n\n    vector<ll> sz(p, 1);\n    queue<int> q;\n\n    for (int i = 0; i < p; ++i) {\n        if (indeg[i] == 0) q.push(i);\n    }\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        int v = nxt[u];\n        sz[v] += sz[u];\n        if (--indeg[v] == 0) q.push(v);\n    }\n\n    vector<char> used(p, 0);\n    ll ans = 1;\n\n    for (int i = 0; i < p; ++i) {\n        if (indeg[i] > 0 && !used[i]) {\n            ll comp = 0;\n            int cur = i;\n            while (!used[cur]) {\n                used[cur] = 1;\n                comp += sz[cur];\n                cur = nxt[cur];\n            }\n            ans = ans * isOnePow(k, comp, p) % MOD;\n        }\n    }\n\n    printf(\"%lld\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n\n    static long powMod(long a, long b) {\n        long res = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) res = res * a % MOD;\n            a = a * a % MOD;\n            b >>= 1;\n        }\n        return res;\n    }\n\n    static long isOnePow(long a, long b, long p) {\n        long res = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) res = res * a % p;\n            a = a * a % p;\n            b >>= 1;\n        }\n        return (res == 1) ? p : 1;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n\n        if (k == 0) {\n            System.out.println(powMod(p, p - 1));\n            return;\n        }\n\n        int[] nxt = new int[p];\n        int[] indeg = new int[p];\n\n        for (int i = 0; i < p; ++i) {\n            nxt[i] = (int)((k * 1L * i) % p);\n            indeg[nxt[i]]++;\n        }\n\n        long[] sz = new long[p];\n        Arrays.fill(sz, 1);\n        Queue<Integer> q = new LinkedList<>();\n\n        for (int i = 0; i < p; ++i) {\n            if (indeg[i] == 0) q.add(i);\n        }\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            int v = nxt[u];\n            sz[v] += sz[u];\n          