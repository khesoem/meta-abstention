 network\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            for j in adj[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    add_edge(u, v, 1, c + (x * 2 - 1) * d)\n                    add_edge_to_adj(M - 1, 0)\n    \n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            add_edge(u, v, k, 0 if i == 0 else c)\n            add_edge_to_adj(M - 1, 0)\n    \n    for h in range(k):\n        add_edge(N - 1, ii[h] * t + 0, 1, 0)\n        add_edge_to_adj(M - 1, 0)\n    \n    # Min-cost max-flow (successive shortest augmenting path)\n    INF = 10**9\n    # We'll use a simplified version with potentials\n    pot = [0] * N\n    dist = [INF] * N\n    prev_edge = [-1] * N\n    prev_dir = [-1] * N\n    \n    total_cost = 0\n    flow = 0\n    \n    while True:\n        dist = [INF] * N\n        dist[N-1] = 0\n        pq = [(0, N-1)]\n        while pq:\n            d, u = heapq.heappop(pq)\n            if dist[u] != d:\n                continue\n            for dir, h in adj_[u]:\n                if cap[h * 2 + dir] > 0:\n                    v = vv[h] if dir == 0 else uu[h]\n                    w = cost[h] if dir == 0 else -cost[h]\n                    nd = d + w + pot[u] - pot[v]\n                    if nd < dist[v]:\n                        dist[v] = nd\n                        prev_edge[v] = h\n                        prev_dir[v] = dir\n                        heapq.heappush(pq, (nd, v))\n        \n        if dist[0] == INF:\n            break\n        \n        # Update potentials\n        for v in range(N):\n            if dist[v] < INF:\n                pot[v] += dist[v]\n            else:\n                pot[v] += dist[0]  # just to keep consistency\n        \n        # Augment one unit\n        v = 0\n        while v != N - 1:\n            h = prev_edge[v]\n            dir = prev_dir[v]\n            # direction: 0 means forward edge from uu[h] to vv[h], 1 means reverse\n            if dir == 0:\n                cap[h * 2] -= 1\n                cap[h * 2 + 1] += 1\n                v = uu[h]\n            else:\n                cap[h * 2 + 1] -= 1\n                cap[h * 2] += 1\n                v = vv[h]\n        \n        flow += 1\n    \n    total_cost = 0\n    for h in range(M):\n        total_cost += cost[h] * cap[h * 2 + 1]  # flow on reverse edges\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-2.1576649e-05, 0.0, -2.3841855e-07, -0.0032540013, -0.022016281, -0.000985137, -0.9745564, -0.8594872, -0.43647063, -0.12766193, -1.1252968, -0.12388117, -0.049615502, -1.3232144e-05, -0.8779899, -2.8120015, -0.00027545472, -4.7683704e-07, -0.012606574, -0.02592428, -1.1920922e-06, -0.18146501, -0.0006235086, -4.5299425e-06, -0.0011893588, -0.003266834, -0.00202534, -0.0069648107, -0.009994463, -0.00017426879, -0.000616837, -1.2755313e-05, -1.1563234e-05, -1.20400655e-05, -5.6028207e-06, -1.1920928e-07, -0.00012694983, -0.0015240018, -0.0297687, -0.056520686, -0.00012075172, -0.0793693, -0.0053009903, -0.050771568, -0.126929, -0.00043227864, -5.0067774e-06, -8.344647e-07, -3.576278e-07, -1.12056105e-05, -2.3841855e-07, -1.2278481e-05, -1.1920928e-07, -1.4305105e-06, -1.3132643, -2.1384754, -0.31649905, -0.0015514968, -0.023281902, -1.4305105e-06, -1.3351351e-05, -8.940657e-06, -0.12757443, -0.12703566, -1.6689287e-06, -0.993739, -0.0001596085, -0.00031823816, -2.3841855e-07, -1.1920928e-07, -2.3841855e-07, -1.1920928e-07, -9.4647694e-05, -0.00058538467, -3.552374e-05, -0.000115149545, -4.887569e-06, -1.3113013e-06, 0.0, -2.3841855e-07, -3.0994368e-06, -5.960463e-07, -0.00840129, -9.059865e-06, 0.0, -9.5367386e-07, -0.0005931287, -0.00070999685, -1.1920928e-07, -2.145765e-06, 0.0, -7.0333235e-06, -1.2516897e-05, -1.1920928e-07, -0.01816155, -0.0010420614, -2.145765e-06, -4.7683704e-07, -0