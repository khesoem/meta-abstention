   if (s <= 0 || t <= 0 || s > n || t > m) return;\n            int left = id[i][j];\n            int right = id[s][t];\n            dinic.addEdge(left, L + right, 1);\n        }\n    }\n\n    static class Dinic {\n        int n;\n        ArrayList<Edge>[] g;\n        int[] level;\n        int[] iter;\n\n        Dinic(int n) {\n            this.n = n;\n            g = new ArrayList[n];\n            for (int i = 0; i < n; i++) g[i] = new ArrayList<>();\n            level = new int[n];\n            iter = new int[n];\n        }\n\n        void addEdge(int from, int to, int cap) {\n            Edge fwd = new Edge(to, g[to].size(), cap);\n            Edge rev = new Edge(from, g[from].size(), 0);\n            g[from].add(fwd);\n            g[to].add(rev);\n        }\n\n        int maxFlow(int s, int t) {\n            int flow = 0;\n            while (bfs(s, t)) {\n                Arrays.fill(iter, 0);\n                int pushed;\n                while ((pushed = dfs(s, t, Integer.MAX_VALUE)) > 0) {\n                    flow += pushed;\n                }\n            }\n            return flow;\n        }\n\n        boolean bfs(int s, int t) {\n            Arrays.fill(level, -1);\n            ArrayDeque<Integer> q = new ArrayDeque<>();\n            level[s] = 0;\n            q.add(s);\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                for (Edge e : g[v]) {\n                    if (e.cap > 0 && level[e.to] < 0) {\n                        level[e.to] = level[v] + 1;\n                        q.add(e.to);\n                    }\n                }\n            }\n            return level[t] >= 0;\n        }\n\n        int dfs(int v, int t, int f) {\n            if (v == t) return f;\n            for (; iter[v] < g[v].size(); iter[v]++) {\n                Edge e = g[v].get(iter[v]);\n                if (e.cap > 0 && level[v] < level[e.to]) {\n                    int d = dfs(e.to, t, Math.min(f, e.cap));\n                    if (d > 0) {\n  