 * data[i].size() - 1LL * P1 * (data[i].size() - loc), P2);\n        }\n        total2 += total1;\n    } else {\n        ans = mod(ans + mod(++total2 - val, P1), P2);\n        for (int d = (depth == 0 ? 1 : 0); d < 10; ++d) traverse(depth + 1, val * 10 + d);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n;\n    build(0, 0);\n    for (int i = 0; i <= 6; ++i) sort(data[i].begin(), data[i].end());\n    total2 = -1;\n    traverse(0, 0);\n    cout << ans;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nP1 = 998244353\nP2 = 1000000007\nhalf = 1000000\n\npow10 = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000]\n\ndef mod(x, P):\n    return x % P\n\nans = 0\ntotal1 = 0\ntotal2 = 0\nn = 0\nsum_arr = [0] * 10\ndata = [[] for _ in range(10)]\n\ndef build(depth, val):\n    global total1\n    if depth > 6:\n        return\n    cur = total1\n    data[depth].append(mod(cur - val, P1))\n    sum_arr[depth] += mod(cur - val, P1)\n    total1 = cur + 1\n    for d in range(10):\n        build(depth + 1, val * 10 + d)\n\ndef condition(x):\n    return x * half + half - 1 <= n and x * half * 10 > n\n\ndef traverse(depth, val):\n    global ans, total2\n    if val > n:\n        return\n    if condition(val):\n        for i in range(6, -1, -1):\n            t = mod(total2 + 1 - val * pow10[i], P1)\n            loc = bisect.bisect_right(data[i], P1 - t - 1)\n            ans = mod(ans + sum_arr[i] + t * len(data[i]) - P1 * (len(data[i]) - loc), P2)\n        total2 += total1\n    else:\n        total2 += 1\n        ans = mod(ans + mod(total2 - val, P1), P2)\n        start = 1 if depth == 0 else 0\n        for d in range(start, 10):\n            traverse(depth + 1, val * 10 + d)\n\ndef main():\n    global n, total2\n    n = int(sys.stdin.readline().strip())\n    build(0