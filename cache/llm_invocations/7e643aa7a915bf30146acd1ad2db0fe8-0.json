ul(f[i-1], 2 * (i + 1));\n        g[i] = mul(g[i-1], 2 * (i + 1));\n        g[i] = add(g[i], mul(f[i-1], i * (i - 1)));\n        for (int j = 1; j < i; ++j) {\n            int k = i - j - 1;\n            int c = mul(binom(j + k, j), j + k + 2);\n            f[i] = add(f[i], mul(c, mul(f[j], f[k])));\n            g[i] = add(g[i], mul(c, mul(f[j], g[k])));\n            g[i] = add(g[i], mul(c, mul(g[j], f[k])));\n            int w = j * (j + 1) / 2 + k * (k + 1) / 2;\n            g[i] = add(g[i], mul(mul(binom(j + k, j), w), mul(f[j], f[k])));\n        }\n    }\n    static int dp[MAXN][MAXN][2];\n    memset(dp, 0, sizeof(dp));\n    dp[0][0][0] = 1;\n    for (int i = 0; i <= m; ++i)\n        for (int j = 0; j <= m; ++j)\n            for (int o = 0; o < 2; ++o) {\n                int cur = dp[i][j][o];\n                if (!cur) continue;\n                if (o == 0) {\n                    for (int k = 1; k + j <= m; ++k) {\n                        int coeff = mul(cur, binom(j + k, k));\n                        dp[i+1][j+k][0] = add(dp[i+1][j+k][0], mul(coeff, f[k]));\n                        dp[i+1][j+k][1] = add(dp[i+1][j+k][1], mul(coeff, g[k]));\n                    }\n                } else {\n                    for (int k = 1; k + j <= m; ++k) {\n                        int coeff = mul(cur, binom(j + k, k));\n                        dp[i+1][j+k][1] = add(dp[i+1][j+k][1], mul(coeff, f[k]));\n                    }\n                }\n            }\n    int ans = 0;\n    for (int i = 1; i <= m; ++i)\n        ans = add(ans, mul(dp[i][m][1], binom(n - m + 1, i)));\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 0\n\ndef add(a, b):\n    s = a + b\n    return s - MOD if s >= MOD else s\n\ndef sub(a, b):\n    d = a - b\n    return d + MOD if d < 0 else d\n\ndef mul(a, b):\n    return (a * b