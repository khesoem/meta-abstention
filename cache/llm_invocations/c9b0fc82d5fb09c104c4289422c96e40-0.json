):\n        self.forward = forward\n        self.frm = frm\n        self.to = to\n        self.capacity = capacity\n        self.flow = 0\n        self.dual = None\n        self.cost = cost\n\n    def remaining(self):\n        return self.capacity - self.flow\n\n    def addFlow(self, amount):\n        self.flow += amount\n        self.dual.flow -= amount\n\nclass MaxFlowSolver:\n    def __init__(self, n=0):\n        self.nodes = []\n        for _ in range(n):\n            self.addNode()\n\n    def addNode(self):\n        n = Node()\n        n.index = len(self.nodes)\n        self.nodes.append(n)\n        return n\n\n    def link(self, n1, n2, capacity, cost=1):\n        e12 = Edge(n1, n2, capacity, cost, True)\n        e21 = Edge(n2, n1, 0, -cost, False)\n        e12.dual = e21\n        e21.dual = e12\n        n1.edges.append(e12)\n        n2.edges.append(e21)\n\n    def link_by_index(self, n1, n2, capacity):\n        self.link(self.nodes[n1], self.nodes[n2], capacity)\n\n    def getMaxFlow(self, src, snk):\n        raise NotImplementedError\n\nclass MinCostMaxFlowSolver(MaxFlowSolver):\n    def __init__(self, n=0):\n        super().__init__(n)\n\n    def getMinCostMaxFlow(self, src, snk):\n        raise NotImplementedError\n\nclass EdmondsKarp(MinCostMaxFlowSolver):\n    INF = 10**18\n\n    def __init__(self, n=0):\n        super().__init__(n)\n        self.minCost = 0\n\n    def getMinCostMaxFlow(self, src, snk):\n        maxflow = self.getMaxFlow(src, snk)\n        return [maxflow, self.minCost]\n\n    def getMaxFlow(self, src, snk):\n        n = len(self.nodes)\n        source = src.index\n        sink = snk.index\n        flow = 0\n        cost = 0\n        potential = [0] * n\n\n        while True:\n            parent = [None] * n\n            dist = [self.INF] * n\n            dist[source] = 0\n            pq = [(0, source)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if d != dist[v]:\n                    continue\n                for e in self.nodes[v].edges:\n                    temp = dist[v] + e.cost + potential[v] - potential[e.to.index]\n                    if e.capacity > e.flow and dist[e.to.index] > temp:\n                        dist[e.to.index] = temp\n                        parent[e.to.index] = e\n                        heapq.heappush(pq, (temp, e.to.index))\n            if parent[sink] is None:\n                break\n            for i in range(n):\n                if parent[i] is not None:\n                    potential[i] += dist[i]\n            augFlow = self.INF\n            i = sink\n            while i != source:\n                e = parent[i]\n                augFlow = min(augFlow, e.capacity - e.flow)\n                i = e.frm.index\n            i = sink\n            while i != source:\n                e = parent[i]\n                e.addFlow(augFlow)\n                cost += augFlow * e.cost\n                i = e.frm.index\n            flow += augFlow\n\n        self.minCost = cost\n        return flow\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    people = [int(next(it)) - 1 for _ in range(K)]\n\n    solver = EdmondsKarp()\n    src = solver.addNode()\n    snk = solver.addNode()\n    amt = 150\n    timeNodes = [[None] * amt for _ in range(N)]\n    for i in range(N):\n        for j in range(1, amt):\n            timeNodes[i][j] = solver.addNode()\n            if j > 1:\n                solver.link(timeNodes[i][j-1], timeNodes[i][j], 10**18, 0)\n\n    for i in range(K):\n        solver.link(src, timeNodes[people[i]][1], 1, 0)\n\n    for i in range(1, amt):\n        for j in range(K):\n            solver.link(timeNodes[0][i], snk, 1, C * i - C)\n\n    for _ in range(M):\n        a = int(next(it)) - 1\n        b = int(next(it)) - 1\n        for j in range(1, amt - 1):\n            prev = 0\n            for k in range(1, K + 1):\n                cost = D * k * k - prev\n                solver.link(timeNodes[a][j], timeNodes[b][j+1], 1, cost)\n                solver.link(timeNodes[b][j], timeNodes[a][j+1], 1, cost)\n                prev = D * k * k\n\n    ret = solver.getMinCostMaxFlow(src, snk)\n    print(ret[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-4.291525328881107e-06, -1.1920928244535389e-07, 0.0, -0.00016437610611319542, -3.9457496313843876e-05, -0.0002618685248307884, -0.0024827865418046713, -0.0011706650257110596, -0.0005777596961706877, -0.1603161096572876, -0.08500035852193832, -0.04050375893712044, -3.814689989667386e-06, -1.9073468138230965e-06, -0.007239064201712608, -1.7881377516459906e-06, -2.3841855067985307e-07, -4.768370445162873e-07, 0.0, -0.38688042759895325, 0.0, 0.0, -9.703165414975956e-05, -1.1920928244535389e-07, -7.867782187531702e-06, -0.019628221169114113, -8.344646857949556e-07, -2.861018856492592e-06, -0.00010179955279454589, -1.1920928244535389e-07, -0.3490146994590759, -1.1920928244535389e-07, -0.0826459676027298, -0.0005532164941541851, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.0004499138449318707, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -0.9794632792472839, -0.0006113567505963147, -4.672895011026412e-05, -2.9802276912960224e-06, -4.529942543740617e-06, -0.011092189699411392, -1.5497195136049413e-06, -0.5765831470489502, -0.002295717829838395, -0.0002361257211305201, -0.005284389015287161, 0.0, -3.576278118089249e-07, -0.6965540051460266, -0.00028463127091526985, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.0006220789509825408, 0.0, 0.0, -0.023463338613510132, -4.768370445162873e-07, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -0.00029571453342214227, 0.0, 0.0, -3.576278118089249e-07, -1.4662635294371285e-05, 0.0, -3.576278118089249e-07, 0.0, 0.0, -0.4740769863128662, -1.0251946150674485e-05, 0.0, -3.576278118089249e-07