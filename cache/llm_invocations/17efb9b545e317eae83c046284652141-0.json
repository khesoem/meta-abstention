samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        \n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt() % m;\n        }\n        \n        int half = n / 2;\n        Set<Integer> leftSums = generateSubseqSums(Arrays.copyOf(a, half), m);\n        Set<Integer> rightSums = generateSubseqSums(Arrays.copyOfRange(a, half, n), m);\n        \n        List<Integer> rightSorted = new ArrayList<>(rightSums);\n        Collections.sort(rightSorted);\n        \n        int maxVal = 0;\n        for (int s : leftSums) {\n            int target = m - s;\n            int idx = binarySearchLeftmost(rightSorted, target);\n            \n            if (idx > 0) {\n                int candidate = s + rightSorted.get(idx - 1);\n                if (candidate > maxVal) {\n                    maxVal = candidate;\n                }\n            }\n            if (idx < rightSorted.size()) {\n                int candidate = s + rightSorted.get(idx);\n                if (candidate > maxVal) {\n                    maxVal = candidate;\n                }\n            }\n        }\n        \n        System.out.println(maxVal);\n    }\n    \n    private static Set<Integer> generateSubseqSums(int[] arr, int mod) {\n        Set<Integer> res = new HashSet<>();\n        dfs(arr, 0, 0, mod, res);\n        return res;\n    }\n    \n    private static void dfs(int[] arr, int idx, int currentSum, int mod, Set<Integer> res) {\n        if (idx == arr.length) {\n            res.add(currentSum % mod);\n        } else {\n            dfs(arr, idx + 1, (currentSum + arr[idx]) % mod, mod, res);\n            dfs(arr, idx + 1, currentSum, mod, res);\n        }\n    }\n    \n    private static int binarySearchLeftmost(List<Integer> list, int target) {\n        int left = 0, right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) >= target) {\n                right = mid;\n            } else {\n                left = mid + 1;\n            }\n        }\n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.333651541965082e-05, -1.1920922133867862e-06, -1.1920928244535389e-07, -7.879423355916515e-05, -1.4543427823809907e-05, -0.0059294989332556725, -0.38705551624298096, -2.7418097943154862e-06, -7.152555099310121e-07, -0.00010859376925509423, -7.390948667307384e-06, -1.311301275563892e-06, -9.226373367710039e-05, -1.311301275563892e-06, -2.5987286790041253e-05, -1.811964830267243e-05, -1.0728830375228426e-06, -1.1920928244535389e-07, -5.3165931603871286e-05, -7.152555099310121e-07, -2.3841855067985307e-07, -2.0265558760002023e-06, -2.7656173188006505e-05, -0.38947251439094543, -3.933898824470816e-06, -3.576278118089249e-07, -1.2159273865108844e-05, -3.814689989667386e-06, -2.264974000354414e-06, -2.622600959512056e-06, -0.042999912053346634, -3.099436753473128e-06, 0.0, 0.0, -2.264974000354414e-06, -1.5497195136049413e-06, -1.311301275563892e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -7.152555099310121e-07, -7.152555099310121e-07, -2.50339189733495e-06, -2.3841855067985307e-07, -0.5759422183036804, -1.0728830375228426e-06, -0.0015855372184887528, -1.1920928244535389e-07, -0.00023147765023168176, -1.1920928244535389e-07, -1.6689286894688848e-06, -3.576278118089249e-07, -1.1920928244535389e-07, -4.887569048150908e-06, -7.510157047363464e-06, -4.887569048150908e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.4305104514278355e-06, -5.602820692729438e-06, -3.576278118089249e-07, -4.768370445162873e-07, 0.0, 0.0, -9.536738616588991e-07, -1.1920928244535389e-07, -3.933898824470816e-06, -0.0007109498255886137, -4.768370445162873e-07, -1.1920928244535389e-0