D\n            start = 1 if val == 0 else 0\n            for i in range(9, start - 1, -1):\n                child = val * 10 + i\n                if child <= n:\n                    st.append(child)\n\ndef main():\n    global cnt2, n, ans, pw, pos\n    dfs(0, 0)\n    for i in range(7):\n        pos[i].sort()\n    pw[0] = 1\n    for i in range(1, 13):\n        pw[i] = pw[i - 1] * 10\n    n = int(sys.stdin.readline())\n    cnt2 = -1\n    process_all()\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.5792896151542664, -0.0001532914029667154, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00020704510097857565, -0.0002227773511549458, -0.03804187476634979, -2.0503786799963564e-05, -0.001958120847120881, -3.576278118089249e-07, 0.0, -2.9205850296420977e-05, -6.437094270950183e-05, -5.8412379075889476e-06, -4.768370445162873e-07, -4.172316494077677e-06, 0.0, -2.3841855067985307e-07, -1.5497195136049413e-06, -1.0847986231965479e-05, 0.0, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.0024770786985754967, -0.011137224733829498, 0.0, -0.023285161703824997, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.20141927897930145, -0.31326261162757874, -4.649054244509898e-05, -6.198863957251888e-06, -3.576278118089249e-07, -9.536738616588991e-07, -5.411955135059543e-05, -0.0008291144040413201, -5.960462772236497e-07, 0.0, -3.540453326422721e-05, -0.004078523721545935, 0.0, 0.0, -0.0009480987209826708, -2.622600959512056e-06, -5.960462772236497e-07, -7.390948667307384e-06, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.8715683836489916e-05, -4.768360213347478e-06, -0.00020930961181875318, -1.1920928244535389e-07, -2.50339189733495e-06, -0.002499910071492195, -3.576278118089249e-07, -1.0967194612021558e-05, -1.3470558769768104e-05, -5.960462772236497e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -7.152555099310121e