  int wordCount = 0;\n        StringBuilder outsideSegments = new StringBuilder();\n        \n        while (pairCounter < bracketPositions.size() - 1) {\n            int openPos = bracketPositions.get(pairCounter);\n            int closePos = bracketPositions.get(pairCounter + 1);\n            \n            String inside = document.substring(openPos + 1, closePos);\n            wordCount += getWordCount(inside);\n            \n            String before = document.substring(bracketPositions.get(pairCounter - 1) + 1, openPos);\n            outsideSegments.append('_').append(before);\n            \n            pairCounter += 2;\n        }\n        \n        String finalSegment = document.substring(bracketPositions.get(bracketPositions.size() - 1) + 1);\n        outsideSegments.append('_').append(finalSegment);\n        \n        String normalized = outsideSegments.toString()\n                .replace(\"_\", \" \")\n                .trim()\n                .replaceAll(\"\\\\s+\", \" \");\n        \n        String[] words = normalized.split(\" \");\n        for (String word : words) {\n            if (word.length() > maxWordLengthOutsideBraces) {\n                maxWordLengthOutsideBraces = word.length();\n            }\n        }\n        \n        System.out.print(maxWordLengthOutsideBraces + \" \" + wordCount);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ntotal_words_inside_braces = 0\nmax_word_length_outside_braces = 0\n\ndef get_word_count(text):\n    text = text.replace(\"_\", \" \")\n    text = text.strip().replace(\"\\s+\", \" \")\n    words = text.split(\" \")\n    return 0 if (len(words) == 1 and words[0] == \"\") else len(words)\n\ndef main():\n    global total_words_inside_braces, max_word_length_outside_braces\n    \n    input_lines = sys.stdin.read().splitlines()\n    dummy = int(input_lines[0])\n    document = inpu