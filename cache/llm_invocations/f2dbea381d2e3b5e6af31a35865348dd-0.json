nt k = 0; k < base; k++) {\n                    Matrix tmp = new Matrix(base + 1);\n                    Matrix.multiply(mat[i][j], mat[i - 1][(j + k) % base], tmp);\n                    mat[i][j].copyFrom(tmp);\n                }\n            }\n        }\n\n        // Main computation\n        Matrix have = new Matrix(base + 1);\n        have.identity();\n\n        int ci = maxExp;\n        step = 1;\n        for (int i = 0; i < ci; i++) {\n            step *= base;\n        }\n\n        int cj = 0;\n        while (ci >= 0) {\n            int times = (int) ((n / step) % base);\n            for (int x = 0; x < times; x++) {\n                Matrix tmp = new Matrix(base + 1);\n                Matrix.multiply(have, mat[ci][cj], tmp);\n                have.copyFrom(tmp);\n                cj++;\n                if (cj >= base) cj -= base;\n            }\n            ci--;\n            step /= base;\n        }\n\n        int ret = 0;\n        for (int k = 0; k <= base; k++) {\n            ret += have.data[k][base];\n            if (ret >= MOD) ret -= MOD;\n        }\n        System.out.println(ret);\n    }\n\n    public static void main(String[] args) {\n        run();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012003655137959868, -1.7881377516459906e-06, -5.960462772236497e-07, -0.0003103728231508285, -1.5735502529423684e-05, -0.06272587925195694, -0.6331110596656799, -3.302042750874534e-05, -5.960462772236497e-07, -7.521823135903105e-05, -0.6326023936271667, -2.0265558760002023e-06, -0.05240798369050026, -0.003536044852808118, -0.00023100091493688524, -3.576272320060525e-06, 0.0, 0.0, 0.0, -7.486063259420916e-05, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, -3.576278118089249e-07, 0.0, -1.1920922133867862e-06, -1.4305104514278355e-06, -1.490105023549404e-05, -3.6954811548639555e-06, -0.0052891322411596775, -0.0002681849291548133, -4.7205765440594405e-05, -2.50339189733495e-06, -2.50339189733495e-06, -9.524368942948058e-05,