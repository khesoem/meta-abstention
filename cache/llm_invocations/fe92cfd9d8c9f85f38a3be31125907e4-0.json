ace(0, source);\n            while (!pq.empty()) {\n                auto [d, u] = pq.top(); pq.pop();\n                if (distance[u] < d) continue;\n                for (int i = 0; i < edges[u].size(); ++i) {\n                    auto& e = edges[u][i];\n                    if (e.capacity > 0 && distance[e.to] > distance[u] + e.cost + potential[u] - potential[e.to]) {\n                        distance[e.to] = distance[u] + e.cost + potential[u] - potential[e.to];\n                        parentVertex[e.to] = u;\n                        parentEdge[e.to] = i;\n                        pq.emplace(distance[e.to], e.to);\n                    }\n                }\n            }\n            if (distance[sink] == INF) return -1;\n            for (int i = 0; i < nodeCount; ++i) potential[i] += distance[i];\n            int flow = requiredFlow;\n            for (int v = sink; v != source; v = parentVertex[v])\n                flow = min(flow, edges[parentVertex[v]][parentEdge[v]].capacity);\n            requiredFlow -= flow;\n            result += flow * potential[sink];\n            for (int v = sink; v != source; v = parentVertex[v]) {\n                auto& e = edges[parentVertex[v]][parentEdge[v]];\n                e.capacity -= flow;\n                edges[v][e.reverse].capacity += flow;\n            }\n        }\n        return result;\n    }\n};\n\nNetworkFlow network;\nint n, m, k, c, d;\nint values[50], counts[50];\nvector<int> connections[50];\nconst int TIME_LIMIT = 100;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 0; i < k; ++i) {\n        cin >> values[i];\n        ++counts[values[i] - 1];\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        connections[u].push_back(v);\n        connections[v].push_back(u);\n    }\n    network.configure(n * TIME_LIMIT + 2);\n    for (int i = 0; i < n; ++i)\n        network.connect(n * TIME_