.v1 - 1][r]) * C[s.v2][r];\n            dfs(new State(s.x, s.y + dy, s.v1 - 1, s.v2));\n        }\n        if (s.v2 > 0) {\n            long dx = C[s.v1][r] * (C[s.v2][r] - C[s.v2 - 1][r]);\n            dfs(new State(s.x + dx, s.y, s.v1, s.v2 - 1));\n        }\n    }\n\n    long solve(State s) {\n        long key = (s.x * 100 + s.v1) * 100 + s.v2;\n        Long cached = cache.get(key);\n        if (cached != null) return cached;\n        long ans = 0L;\n        long d = Math.abs(s.x - s.y);\n        if (d - C[s.v1][r] * C[s.v2][r] > best) {\n            cache.put(key, ans);\n            return ans;\n        }\n        if (s.v1 == 0 && s.v2 == 0) return 1L;\n        char ch = cs[s.v1 + s.v2 - 1];\n        if (s.v1 > 0 && ch != 'B') {\n            long dy = (C[s.v1][r] - C[s.v1 - 1][r]) * C[s.v2][r];\n            ans += solve(new State(s.x, s.y + dy, s.v1 - 1, s.v2));\n        }\n        if (s.v2 > 0 && ch != 'A') {\n            long dx = C[s.v1][r] * (C[s.v2][r] - C[s.v2 - 1][r]);\n            ans += solve(new State(s.x + dx, s.y, s.v1, s.v2 - 1));\n        }\n        cache.put(key, ans);\n        return ans;\n    }\n\n    void run() {\n        r = sca.nextInt();\n        c = sca.nextInt();\n        sca.nextLine();\n        cs = sca.nextLine().toCharArray();\n        buildComb();\n        int n = r + c;\n        int v1 = n, v2 = n;\n        long x = 0, y = 0;\n        while (v1 > 0 && v2 > 0) {\n            if (x > y) {\n                long dy = (C[v1][r] - C[v1 - 1][r]) * C[v2][r];\n                y += dy;\n                v1--;\n            } else {\n                long dx = C[v1][r] * (C[v2][r] - C[v2 - 1][r]);\n                x += dx;\n                v2--;\n            }\n        }\n        best = Math.abs(x - y);\n        dfs(new State(0, 0, n, n));\n        System.out.println(solve(new State(0, 0, n, n)));\n    }\n\n    public static void main(String[] args) {\n        new Test().run();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logpro