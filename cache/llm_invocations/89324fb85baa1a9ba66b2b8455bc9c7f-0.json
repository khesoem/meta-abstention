{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nusing llong = long long;\nconst llong MOD_A = 998244353LL;\nconst llong MOD_B = 1000000007LL;\nconst llong BLOCK = 1000000LL;\n\nllong adjust(llong x) {\n    x %= MOD_A;\n    if (x < 0) x += MOD_A;\n    return x;\n}\n\nllong n, global_counter;\nllong prefix[7];\nint final_answer;\nvector<int> store[7];\n\nvoid build_table(int level, llong cur_val) {\n    global_counter++;\n    store[level].push_back((int)adjust(global_counter - cur_val));\n    if (level < 6) {\n        for (int d = 0; d <= 9; ++d) {\n            build_table(level + 1, cur_val * 10 + d);\n        }\n    }\n}\n\nint evaluate(int idx, int offset) {\n    int idx_pos = lower_bound(store[idx].begin(), store[idx].end(), (int)(MOD_A - offset)) - store[idx].begin();\n    llong term1 = (llong)offset * (llong)store[idx].size();\n    llong term2 = prefix[idx];\n    llong term3 = (llong)MOD_A * (llong)(store[idx].size() - idx_pos);\n    llong res = (term1 + term2 - term3) % MOD_B;\n    if (res < 0) res += MOD_B;\n    return (int)res;\n}\n\nvoid traverse(int level, llong cur_val) {\n    if (cur_val > n) return;\n    if (level >= 1) {\n        if (cur_val * BLOCK > n / 10 && cur_val * BLOCK + BLOCK - 1 <= n) {\n            int factor = 1;\n            for (int i = 0; i <= 6; ++i) {\n                final_answer = (final_answer + evaluate(i, (int)adjust(global_counter - cur_val * factor))) % (int)MOD_B;\n                factor *= 10;\n            }\n            for (int i = 0; i <= 6; ++i) {\n                global_counter += store[i].size();\n            }\n            return;\n        }\n        final_answer = (final_answer + (int)adjust(++global_counter - cur_val)) % (int)MOD_B;\n    }\n    int start_digit = (level == 0) ? 1 : 0;\n    for (int d = start_digit; d <= 9; ++d) {\n        traverse(level + 1, cur_val * 10 + d);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n;\n    build_table(0, 0);\n    for (int i = 0; i <= 6; ++i) {\n        sort(store[i].begin(), store[i].end());\n        for (size_t j = 0; j < store[i].size(); ++j) {\n            prefix[i] += store[i][j];\n        }\n    }\n    global_counter = 0;\n    traverse(0, 0);\n    cout << final_answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD_A = 998244353\nMOD_B = 1000000007\nBLOCK = 1000000\n\ndef adjust(x):\n    x %= MOD_A\n    if x < 0:\n        x += MOD_A\n    return x\n\ndef main():\n    input_data = sys.stdin.read().split()\n    n = int(input_data[0])\n    \n    global_counter = 0\n    store = [[] for _ in range(7)]\n    prefix = [0] * 7\n    final_answer = 0\n    \n    def build_table(level, cur_val):\n        nonlocal global_counter\n        global_counter += 1\n        store[level].append(int(adjust(global_counter - cur_val)))\n        if level < 6:\n            for d in range(10):\n                build_table(level + 1, cur_val * 10 + d)\n    \n    def evaluate(idx, offset):\n        idx_pos = bisect.bisect_left(store[idx], int(MOD_A - offset))\n        term1 = offset * len(store[idx])\n        term2 = prefix[idx]\n        term3 = MOD_A * (len(store[idx]) - idx_pos)\n        res = (term1 + term2 - term3) % MOD_B\n        if res < 0:\n            res += MOD_B\n        return int(res)\n    \n    def traverse(level, cur_val):\n        nonlocal final_answer, global_counter\n        if cur_val > n:\n            return\n        if level >= 1:\n            if cur_val * BLOCK > n // 10 and cur_val * BLOCK + BLOCK - 1 <= n:\n                factor = 1\n                for i in range(7):\n                    final_answer = (final_answer + evaluate(i, int(adjust(global_counter - cur_val * factor)))) % MOD_B\n                    factor *= 10\n                for i in range(7):\n                    global_counter += len(store[i])\n                return\n            final_answer = (final_answer + int(adjust(global_counter + 1 - cur_val))) % MOD_B\n            global_counter += 1\n        start_digit = 1 if level == 0 else 0\n        for d in range(start_digit, 10):\n            traverse(level + 1, cur_val * 10 + d)\n    \n    build_table(0, 0)\n    for i in range(7):\n        store[i].sort()\n        for j in range(len(store[i])):\n            prefix[i] += store[i][j]\n    \n    global_counter = 0\n    traverse(0, 0)\n    print(final_answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001842805795604363, -7.152555099310121e-07, -1.1920928244535389e-07, -0.016183089464902878, -0.6940284371376038, -1.07287787614041e-05, -0.016146961599588394, -0.0010642108973115683, -4.6491513785440475e-06, -0.007610966917127371, -0.211959108710289, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -2.3841830625315197e-06, -1.0967194612021558e-05, -2.7418097943154862e-06, -1.680836794548668e-05, -1.0728830375228426e-06, -2.145744110748637