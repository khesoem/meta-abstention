tln(result);\n            pw.flush();\n        } catch (Exception e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    private long calculate(long n, long[] a, Map<Long, Long> cache) {\n        if (n == 0) return 0;\n        if (cache.containsKey(n)) return cache.get(n);\n        \n        for (int i = 0; i < 17; i++) {\n            if (a[i] >= n) {\n                if (a[i] == n) {\n                    cache.put(n, (long)(i + 1));\n                    return i + 1;\n                }\n                \n                long k = n / a[i - 1];\n                long c1 = i * k + calculate(n - a[i - 1] * k, a, cache);\n                \n                long diff = a[i] - n;\n                k = diff / a[i - 1];\n                long c2 = i + 1 + i * k + calculate(a[i] - a[i - 1] * k - n, a, cache);\n                \n                long min = Math.min(c1, c2);\n                cache.put(n, min);\n                return min;\n            }\n        }\n        throw new RuntimeException(\"Unexpected case for n=\" + n);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        new Main().run();\n    }\n\n    private void run() {\n        try (InputStreamReader isr = new InputStreamReader(System.in);\n             BufferedReader br = new BufferedReader(isr);\n             PrintWriter pw = new PrintWriter(System.out)) {\n            \n            int n = Integer.parseInt(br.readLine().trim());\n            \n            long[] a = new long[17];\n            a[0] = 1;\n            for (int i = 1; i < 17; i++) {\n                a[i] = a[i-1] * 10 + 1;\n            }\n            \n            Map<Long, Long> cache = new HashMap<>();\n            long result = calculate(n, a, cache);\n            pw.println(result);\n            pw.flush();\n        } catch (Exception e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    private long calculate(long n, long[] a, Map<Long, Long> cache) {\n        if (n == 0) return 0;\n        if (n < 0) {\n            return calculate(-n, a, cache);\n        }\n        if (cache.containsKey(n)) return cache.get(n);\n        \n        long min = Long.MAX_VALUE;\n        \n        for (int i = 0; i < 17; i++) {\n            if (a[i] > n) {\n                break;\n            }\n            \n            if (a[i] == n) {\n                long result = i + 1;\n                cache.put(n, result);\n                return result;\n            }\n            \n            long k = n / a[i];\n            long remainder = n % a[i];\n            \n            long c1 = (i + 1) * k + calculate(remainder, a, cache);\n            min = Math.min(min, c1);\n            \n            if (i + 1 < 17) {\n                long diff = a[i + 1] - n;\n                long k2 = diff / a[i];\n                if (k2 > 0) {\n                    long c2 = (i + 2) + (i + 1) * k2 + calculate(a[i + 1] - a[i] * k2 - n, a, cache);\n                    min = Math.min(min, c2);\n                }\n            }\n        }\n        \n        cache.put(n, min);\n        return min;\n    }\n}\n</repaired_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -0.00010561384988250211, -1.7881377516459906e-06, 0.0, -9.059865078597795e-06, -1.823885577323381e-05, -1.7881377516459906e-06, -3.099436753473128e-06, -1.0490362910786644e-05, -3.576272320060525e-06, -1.1920928244535389e-07, -3.421248038648628e-05, -4.172316494077677e-06, 0.0, -1.7881377516459906e-06, -2.264974000354414e-06, 0.0, -1.764281842042692e-05, -9.536738616588991e-07, -1.0728830375228426e-06, -2.145764938177308e-06, -7.152555099310121e-07, -1.7404405298293568e-05, -4.172316494077677e-06, -9.536738616588991e-07, -1.5497195136049413e-06, -1.5497195136049413e-06, -1.788137751645990