entity_matrix();\n    while (exponent > 0) {\n        if (exponent & 1) result = mat_mul(result, base);\n        base = mat_mul(base, base);\n        exponent >>= 1;\n    }\n    return result;\n}\n\nll n_input;\nint k_input;\nint base_digits[128];\nint num_digits;\n\nMatrix cyclic_shift(const Matrix& M, int shift_amount) {\n    Matrix shifted;\n    for (int i = 0; i <= k_input; ++i)\n        for (int j = 0; j <= k_input; ++j) {\n            int ni = (i == k_input) ? k_input : (i + shift_amount) % k_input;\n            int nj = (j == k_input) ? k_input : (j + shift_amount) % k_input;\n            shifted.data[ni][nj] = M.data[i][j];\n        }\n    return shifted;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    cin >> n_input >> k_input;\n    dim = k_input + 1;\n    \n    ll temp = n_input;\n    while (temp > 0) {\n        base_digits[num_digits++] = temp % k_input;\n        temp /= k_input;\n    }\n    \n    vector<Matrix> A(num_digits);\n    for (int j = 0; j <= k_input; ++j) {\n        A[0].data[0][j] = 1;\n        A[0].data[j][j] = 1;\n    }\n    \n    for (int i = 1; i < num_digits; ++i) {\n        Matrix cur = identity_matrix();\n        for (int j = 0; j < k_input; ++j)\n            cur = mat_mul(cur, cyclic_shift(A[i-1], j));\n        A[i] = cur;\n    }\n    \n    int carry = 0;\n    Matrix final = identity_matrix();\n    for (int i = num_digits - 1; i >= 0; --i) {\n        for (int j = 0; j < base_digits[i]; ++j) {\n            final = mat_mul(final, cyclic_shift(A[i], (j + carry) % k_input));\n        }\n        carry = (carry + base_digits[i]) % k_input;\n    }\n    \n    ll ans = 0;\n    for (int i = 0; i <= k_input; ++i)\n        ans = (ans + final.data[i][k_input]) % MOD;\n    cout << ans << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\nMAX_DIM = 33\n\ndim = 0\n\nclass Matrix:\n    def __init__(self):\n        self.data = [[0] * MAX_DIM for _ in range(MAX_DIM)]\n    \n    def mod_reduce(self):\n        for i in range(dim):\n            for j in range(dim):\n                self.data[i][j] = ((self.data[i][j] % MOD) + MOD) % MOD\n\ndef identity_matrix():\n    res = Matrix()\n    for i in range(dim):\n        res.data[i][i] = 1\n    return res\n\ndef mat_mul(A, B):\n    C = Matrix()\n    INF = 8 * 10**18\n    for k in range(dim):\n        for i in range(dim):\n            for j in range(dim):\n                C.data[i][j] += A.data[i][k] * B.data[k][j]\n                if C.data[i][j] >= INF:\n                    C.data[i][j] %= MOD\n    return C\n\ndef mat_pow(base, exponent):\n    base.mod_reduce()\n    result = identity_matrix()\n    while exponent > 0:\n        if exponent & 1:\n            result = mat_mul(result, base)\n        base = mat_mul(base, base)\n        exponent >>= 1\n    return result\n\ndef cyclic_shift(M, shift_amount):\n    shifted = Matrix()\n    for i in range(k_input + 1):\n        for j in range(k_input + 1):\n            if i == k_input:\n                ni = k_input\n            else:\n                ni = (i + shift_amount) % k_input\n            if j == k_input:\n                nj = k_input\n            else:\n                nj = (j + shift_amount) % k_input\n            shifted.data[ni][nj] = M.data[i][j]\n    return shifted\n\ndef main():\n    global dim, k_input, num_digits\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n_input = int(input_data[0])\n    k_input = int(input_data[1])\n    dim = k_input + 1\n    \n    base_digits = []\n    temp = n_input\n    while temp > 0:\n        base_digits.append(temp % k_input)\n        temp //= k_input\n    num_digits = len(base_digits)\n    \n    A = [Matrix() for _ in range(num_digits)]\n    for j in range(k_input + 1):\n        A[0].data[0][j] = 1\n        A[0].data[j][j] = 1\n    \n   