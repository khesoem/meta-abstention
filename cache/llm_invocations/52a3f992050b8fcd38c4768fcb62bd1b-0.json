0, sum - 1);\n        double sum2 = Math.max(0, sum - 2);\n        double numerator = 0.25 * b * b1 * g + (g * g1 * g2 / 6.0 + b * 0.5 * g * g1);\n        double denominator = sum * sum1 * sum2 / 6.0;\n        return numerator / denominator >= proba;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef check(good, bad, proba):\n    g = float(good)\n    b = float(bad)\n    g1 = max(0.0, g - 1)\n    g2 = max(0.0, g - 2)\n    b1 = max(0.0, b - 1)\n    sum_val = g + b\n    sum1 = max(0.0, sum_val - 1)\n    sum2 = max(0.0, sum_val - 2)\n    numerator = 0.25 * b * b1 * g + (g * g1 * g2 / 6.0 + b * 0.5 * g * g1)\n    denominator = sum_val * sum1 * sum2 / 6.0\n    return numerator / denominator >= proba\n\ndef main():\n    data = sys.stdin.readline().strip().split()\n    if not data:\n        return\n    x = int(data[0])\n    prob = float(data[1])\n    pos = x\n    a = x\n    while a > 0:\n        while pos - a >= 0 and check(pos - a, x - (pos - a), prob):\n            pos -= a\n        a = a >> 1  # integer division by 2\n    print(pos)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-5.006777428206988e-06, 0.0, 0.0, -3.7431014789035544e-05, -7.033323527139146e-06, -2.1576648578047752e-05, -0.029831182211637497, -1.5497195136049413e-06, -0.0012423424050211906, -2.3841855067985307e-07, -5.125986263010418e-06, -0.3868715763092041, 0.0, 0.0, 0.0, -2.1457441107486375e-05, -1.2993727978027891e-05, -1.1920928244535389e-07, -9.894321920000948e-06, -1.6689160474925302e-05, -0.018152771517634392, -3.576278118089249e-07, 0.0, -5.960446742392378e-06, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -1.6689286894688848e-06, -3.576278118089249e-07, -6.6756979322235566e-06, -4.768370445162873e-07, 0.0, -0.00012373158824630082, -1.1920928