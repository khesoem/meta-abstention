{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following PyPy 3 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original PyPy 3 code you have to translate:\n<original_code>\nimport heapq\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.pos = []\n        self.g = [[] for _ in range(n)]\n\n    def add_edge(self, fr, to, cap, cost):\n        m = len(self.pos)\n        self.pos.append((fr, len(self.g[fr])))\n        self.g[fr].append(self._Edge(to, len(self.g[to]), cap, cost))\n        self.g[to].append(self._Edge(fr, len(self.g[fr]) - 1, 0, -cost))\n        return m\n\n    class Edge:\n        def __init__(self, fr, to, cap, flow, cost):\n            self.fr = fr\n            self.to = to\n            self.cap = cap\n            self.flow = flow\n            self.cost = cost\n\n    def get_edge(self, i):\n        e = self.g[self.pos[i][0]][self.pos[i][1]]\n        re = self.g[e.to][e.rev]\n        return self.Edge(self.pos[i][0], e.to, e.cap + re.cap, re.cap, e.cost)\n\n    def edges(self):\n        res = []\n        for i in range(len(self.pos)):\n            e = self.g[self.pos[i][0]][self.pos[i][1]]\n            re = self.g[e.to][e.rev]\n            res.append(self.Edge(self.pos[i][0], e.to, e.cap + re.cap, re.cap, e.cost))\n        return res\n\n    def _dual_ref(self, s, t):\n        INF = 10**18\n        dist = [INF] * self.n\n        pv = [-1] * self.n\n        pe = [-1] * self.n\n        vis = [False] * self.n\n        dist[s] = 0\n        pq = [(0, s)]\n        while pq:\n            d, v = heapq.heappop(pq)\n            if vis[v]:\n                continue\n            vis[v] = True\n            if v == t:\n                break\n            for i, e in enumerate(self.g[v]):\n                if vis[e.to] or e.cap == 0:\n                    continue\n                cost = e.cost - self.dual[e.to] + self.dual[v]\n                nd = d + cost\n                if dist[e.to] > nd:\n                    dist[e.to] = nd\n                    pv[e.to] = v\n                    pe[e.to] = i\n                    heapq.heappush(pq, (nd, e.to))\n        if not vis[t]:\n            return False\n        for v in range(self.n):\n            if vis[v]:\n                self.dual[v] -= dist[t] - dist[v]\n        self.pv = pv\n        self.pe = pe\n        return True\n\n    def slope(self, s, t, flow_limit=10**18):\n        self.dual = [0] * self.n\n        flow = 0\n        cost = 0\n        while flow < flow_limit:\n            if not self._dual_ref(s, t):\n                break\n            c = flow_limit - flow\n            v = t\n            while v != s:\n                c = min(c, self.g[self.pv[v]][self.pe[v]].cap)\n                v = self.pv[v]\n            v = t\n            while v != s:\n                e = self.g[self.pv[v]][self.pe[v]]\n                e.cap -= c\n                self.g[v][e.rev].cap += c\n                v = self.pv[v]\n            d = -self.dual[s]\n            flow += c\n            cost += c * d\n        return [(flow, cost)]\n\n    def flow(self, s, t, flow_limit=10**18):\n        return self.slope(s, t, flow_limit)[-1]\n\n    class _Edge:\n        def __init__(self, to, rev, cap, cost):\n            self.to = to\n            self.rev = rev\n            self.cap = cap\n            self.cost = cost\n\nINF = 10**9\n\nn = int(input())\na1, a2, a3 = map(int, input().split())\nb1, b2, b3 = map(int, input().split())\n\ng = MCF(8)\ng.add_edge(0, 1, a1, 0)\ng.add_edge(0, 2, a2, 0)\ng.add_edge(0, 3, a3, 0)\ng.add_edge(4, 7, b1, 0)\ng.add_edge(5, 7, b2, 0)\ng.add_edge(6, 7, b3, 0)\nfor i in range(1, 4):\n    for j in range(4, 7):\n        cost = 1 if (j - i) % 3 == 1 else 0\n        g.add_edge(i, j, INF, cost)\n\nf, ans1 = g.flow(0, 7)\n\nans2 = min(a1, b2) + min(a2, b3) + min(a3, b1)\nprint(ans1, ans2)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <climits>\n#include <cstdint>\n\nusing namespace std;\ntypedef long long ll;\n\nconst ll INF = 1e18;\n\nstruct MCF {\n    struct Edge {\n        int to, rev;\n        ll cap, cost;\n        Edge(int to, int rev, ll cap, ll cost) : to(to), rev(rev), cap(cap), cost(cost) {}\n    };\n\n    int n;\n    vector<vector<Edge>> g;\n    vector<ll> dual;\n    vector<int> pv, pe;\n\n    MCF(int n) : n(n), g(n), dual(n, 0), pv(n), pe(n) {}\n\n    void add_edge(int fr, int to, ll cap, ll cost) {\n        g[fr].emplace_back(to, (int)g[to].size(), cap, cost);\n        g[to].emplace_back(fr, (int)g[fr].size() - 1, 0, -cost);\n    }\n\n    bool _dual_ref(int s, int t) {\n        vector<ll> dist(n, INF);\n        vector<bool> vis(n, false);\n        dist[s] = 0;\n        priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n        pq.emplace(0, s);\n        while (!pq.empty()) {\n            auto [d, v] = pq.top(); pq.pop();\n            if (vis[v]) continue;\n            vis[v] = true;\n            if (v == t) break;\n            for (int i = 0; i < (int)g[v].size(); ++i) {\n                Edge &e = g[v][i];\n                if (vis[e.to] || e.cap == 0) continue;\n                ll cost = e.cost - dual[e.to] + dual[v];\n                ll nd = d + cost;\n                if (dist[e.to] > nd) {\n                    dist[e.to] = nd;\n                    pv[e.to] = v;\n                    pe[e.to] = i;\n                    pq.emplace(nd, e.to);\n                }\n            }\n        }\n        if (!vis[t]) return false;\n        for (int v = 0; v < n; ++v) {\n            if (vis[v]) dual[v] -= dist[t] - dist[v];\n        }\n        return true;\n    }\n\n    vector<pair<ll, ll>> slope(int s, int t, ll flow_limit = INF) {\n        ll flow = 0, cost = 0;\n        while (flow < flow_limit) {\n            if (!_dual_ref(s, t)) break;\n            ll c = flow_limit - flow;\n            for (int v = t; v != s; v = pv[v]) {\n                c = min(c, g[pv[v]][pe[v]].cap);\n            }\n            for (int v = t; v != s; v = pv[v]) {\n                Edge &e = g[pv[v]][pe[v]];\n                e.cap -= c;\n                g[v][e.rev].cap += c;\n            }\n            ll d = -dual[s];\n            flow += c;\n            cost += c * d;\n        }\n        return {{flow, cost}};\n    }\n\n    pair<ll, ll> flow(int s, int t, ll flow_limit = INF) {\n        auto res = slope(s, t, flow_limit);\n        return res.back();\n    }\n};\n\nint main() {\n    int n;\n    cin >> n;\n    ll a1, a2, a3, b1, b2, b3;\n    cin >> a1 >> a2 >> a3;\n    cin >> b1 >> b2 >> b3;\n\n    MCF g(8);\n    g.add_edge(0, 1, a1, 0);\n    g.add_edge(0, 2, a2, 0);\n    g.add_edge(0, 3, a3, 0);\n    g.add_edge(4, 7, b1, 0);\n    g.add_edge(5, 7, b2, 0);\n    g.add_edge(6, 7, b3, 0);\n    for (int i = 1; i <= 3; ++i) {\n        for (int j = 4; j <= 6; ++j) {\n            ll cost = ((j - i) % 3 == 1) ? 1 : 0;\n            g.add_edge(i, j, INF, cost);\n        }\n    }\n\n    auto [f, ans1] = g.flow(0, 7);\n    ll ans2 = min(a1, b2) + min(a2, b3) + min(a3, b1);\n    cout << ans1 << \" \" << ans2 << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confide