, pot[MAXN];\nint pre[MAXN];\ntf cap[MAXN], mxflow;\nbool in_queue[MAXN];\n\nvoid flow(int s, int t) {\n    mxflow = mncost = 0;\n    fill(pot, pot+nodes, 0);\n    while(1) {\n        fill(dist, dist+nodes, INFCOSTO); dist[s] = 0;\n        mset(pre, -1); pre[s] = 0;\n        mset(cap, 0); cap[s] = INFFLUJO;\n        priority_queue<pair<tc,int>, vector<pair<tc,int>>, greater<pair<tc,int>>> pq;\n        pq.push({0, s});\n        while(!pq.empty()) {\n            auto [d, u] = pq.top(); pq.pop();\n            if(d != dist[u]) continue;\n            for(int idx : g[u]) {\n                edge &E = e[idx];\n                if(E.rem() == 0) continue;\n                tc nd = dist[u] + E.cost + pot[u] - pot[E.v];\n                if(nd < dist[E.v] - 1e-9) {\n                    dist[E.v] = nd;\n                    pre[E.v] = idx;\n                    cap[E.v] = min(cap[u], E.rem());\n                    pq.push({nd, E.v});\n                }\n            }\n        }\n        if(pre[t] < 0) break;\n        for(int v = t; v != s; v = e[pre[v]].u) {\n            e[pre[v]].flow += cap[t];\n            e[pre[v]^1].flow -= cap[t];\n        }\n        mxflow += cap[t];\n        mncost += cap[t] * (dist[t] + pot[t] - pot[s]);\n        fore(i,0,nodes) if(dist[i] < INFCOSTO) pot[i] += dist[i];\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    ll n,m,k,c,d;\n    cin>>n>>m>>k>>c>>d;\n    int MAXT = n + k;\n    if(DEBUG) cout<<\"MAXT: \"<<MAXT<<endl;\n    vector<int> a(k);\n    fore(i,0,k) {\n        cin>>a[i]; a[i]--;\n        add_edge(SRC, a[i]*MAXT, 1, 0);\n    }\n    fore(j,0,MAXT) add_edge(j, SNC, k, 0);\n    fore(i,0,m) {\n        int x,y; cin>>x>>y; x--,y--;\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(x*MAXT+j, y*MAXT+j+1, 1, c + d*(2*K-1));\n        }\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(y*MAXT+j, x*MAXT+j+1, 1, c + d*(2*K-1));\n        }\n    }\n    fore(i,0,n) {\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(i*MAXT+j, i*MAXT+j+1, 1, c);\n        }\n    }\n    flow(SRC, SNC);\n    if(DEBUG) cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n    cout<<mncost<<endl;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 50 * 100 + 15;\n    static final int SRC = MAXN - 1;\n    static final int SNC = MAXN - 2;\n    static final long INFFLUJO = (long) 1e14;\n    static final long INFCOSTO = (long) 1e14;\n    static int nodes = MAXN;\n    static ArrayList<ArrayList<Integer>> g;\n    static ArrayList<Edge> e;\n    static long[] dist, pot, cap;\n    static int[] pre;\n\n    static class Edge {\n        int u, v;\n        long cap, flow, cost;\n        Edge(int u, int v, long cap, long flow, long cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n        long rem() {\n            return cap - flow;\n        }\n    }\n\n    static void addEdge(int u, int v, long cap, long cost) {\n        g.get(u).add(e.size());\n        e.add(new Edge(u, v, cap, 0, cost));\n        g.get(v).add(e.size());\n        e.add(new Edge(v, u, 0, 0, -cost));\n    }\n\n    static void flow(int s, int t) {\n        long mxflow = 0, mncost = 0;\n        Arrays.fill(pot, 0);\n        while (true) {\n            Arrays.fill(dist, INFCOSTO);\n            dist[s] = 0;\n            Arrays.fill(pre, -1);\n            pre[s] = 0;\n            Arrays.fill(cap, 0);\n            cap[s] = INFFLUJO;\n            PriorityQueue<long[]> pq = new PriorityQueue<>((a, b) -> Long.compare(a[0], b[0]));\n            pq.offer(new long[]{0, s});\n            while (!pq.isEmpty()) {\n                long[] cur = pq.poll();\n                long d = cur[0];\n                int u = (int) cur[1];\n                if (d != dist[u]) continue;\n                for (int idx : g.get(u)) {\n                    Edge E = e.get(idx);\n                    if (E.rem() == 0) continue;\n                    long nd = dist[u] + E.cost + pot[u] - pot[E.v];\n                    if (nd < dist[E.v]) {\n                        dist[E.v] = nd;\n                        pre[E.v] = idx;\n                        cap[E.v] = Math.min(cap[u], E.rem());\n                        pq.offer(new long[]{nd, E.v});\n                    }\n                }\n            }\n            if (pre[t] < 0) break;\n            for (int v = t; v != s; v = e.get(pre[v]).u) {\n                e.get(pre[v]).flow += cap[t];\n                e.get(pre[v] ^ 1).flow -= cap[t];\n            }\n            mxflow += cap[t];\n            mncost += cap[t] * (dist[t] + pot[t] - pot[s]);\n            for (int i = 0; i < nodes; i++) {\n                if (dist[i] < INFCOSTO) pot[i] += dist[i];\n            }\n        }\n        System.out.println(mncost);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        long c = Long.parseLong(st.nextToken());\n        long d = Long.parseLong(st.nextToken());\n        int MAXT = n + k;\n        g = new ArrayList<>(nodes);\n        for (int i = 0; i < nodes; i++) g.add(new ArrayList<>());\n        e = new ArrayList<>();\n        dist = new long[nodes];\n        pot = new long[nodes];\n        cap = new long[nodes];\n        pre = new int[nodes];\n\n        st = new StringTokenizer(br.readLine());\n        int[] a = new int[k];\n        for (int i = 0; i < k; i++) {\n            a[i] = Integer.parseInt(st.nextToken()) - 1;\n            addEdge(SRC, a[i] * MAXT, 1, 0);\n        }\n        for (int j = 0; j < MAXT; j++) {\n            addEdge(j, SNC, k, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(i * MAXT + j, i * MAXT + j + 1, 1, c);\n                }\n            }\n        }\n        flow(SRC, SNC);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.4751797914505005, -0.00018094333063345402, 0.0, -1.1920928244535389e-07, -0.000176652567461133, -0.00016306500765495002, -3.576278118089249e-07, -0.20141343772411346, -0.07891023904085159, 0.0, 0.0, -9.536738616588991e-07, -8.260862523457035e-05, -0.00030858523678034544, 0.0, -0.10292161256074905, -0.01815815642476082, -7.843663479434326e-05, -0.012316714972257614, -0.022054528817534447, -0.004786224570125341, -0.001177928177639842, -0.0001006075763143599, -9.298280929215252e-06, -3.158996332786046e-05, -0.007643027231097221, -0.061983413994312286, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.4689302992774174e-05, -0.0007129749283194542, 0.0, -1.1920928244535389e-07, -0.018149960786104202, -8.344646857949556e-07, -8.344646857949556e-07, 0.0, -4.768370445162873e-07, 0.0, 0.0, -7.152555099310121e-07, -1.1920928244535389e-0