nge(2, n + 1):\r\n    sq, cur = int(sqrt(i)) + 1, su\r\n\r\n    for f in range(2, sq):\r\n        cur = (cur + mem[i // f]) % mod\r\n\r\n    be = i\r\n    for j in range(1, i // sq + 1):\r\n        nxt = i // (j + 1)\r\n        cur = (cur + (be - nxt) * mem[j]) % mod\r\n        be = nxt\r\n\r\n    su = (su + cur) % mod\r\n    mem[i] = cur\r\nprint(mem[-1])\r\n</original_code>\n\n<translated_code>\n#include <iostream>\n#include <cmath>\n#include <vector>\n\nusing namespace std;\n\ntypedef long long int ll;\n\nll inp(ll dtype) {\n    string s;\n    getline(cin, s);\n    ll a[s.size()];\n    for (int i = 0; i < s.size(); i++) {\n        a[i] = dtype(stoi(s.substr(i, 1)));\n    }\n    return a[0];\n}\n\nll ceil1(ll a, ll b) {\n    return (a + b - 1) / b;\n}\n\nll add(ll a, ll b) {\n    return (a + b) % mod;\n}\n\nll mult(ll a, ll b) {\n    return (a * b) % mod;\n}\n\nconst ll mod = 1000000007;\n\nint main() {\n    ll n = inp<ll>();\n    ll mod = inp<ll>();\n    vector<ll> mem(n + 1, 0);\n    ll su = 1;\n    mem[1] = 1;\n\n    for (ll i = 2; i <= n; i++) {\n        ll sq = ceil1(sqrt(i), 1) + 1;\n        ll cur = su;\n\n        for (ll f = 2; f < sq; f++) {\n            cur = add(cur, mem[i / f]);\n        }\n\n        ll be = i;\n        for (ll j = 1; j <= i / sq; j++) {\n            ll nxt = i / (j + 1);\n            cur = add(cur, (be - nxt) * mem[j]);\n            be = nxt;\n        }\n\n        su = add(su, cur);\n        mem[i] = cur;\n    }\n\n    cout << mem[n] << endl;\n\n    return 0;\n}\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.2536441385746002, -5.793739182990976e-05, -0.5367771983146667, -0.009142940863966942, -1.1563368389033712e-05, -7.152560215217818e-07, -1.8477610865375027e-05, -0.5767723321914673, -0.00035888433922082186, -1.8358399756834842e-05, -1.609338323760312e-05, -0.00018854725931305438, -1.9073504518019035e-06, -6.198902156029362e-06, -2.5868750526569784e-05, -3.576279254957626e-07, -3.576279254957626e-07