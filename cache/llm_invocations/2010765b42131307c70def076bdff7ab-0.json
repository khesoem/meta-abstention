t r, c;\n    static long total;\n    static long best = (long) 1e18;\n    static long best_z = -1;\n    static char[] s;\n    static int[] cntA = new int[12345];\n    static int[] cntB = new int[12345];\n    static Map<Long, Long> mp = new HashMap<>();\n\n    static void dfs(long x, long y, int v1, int v2) {\n        long diff = Math.abs(x - y);\n        if (best <= 1 || diff - C[v1][r] * C[v2][r] >= best) {\n            return;\n        }\n        if (v1 == r - 1 && v2 == r - 1) {\n            long diff2 = Math.abs(x - y);\n            if (diff2 < best) {\n                best = diff2;\n                best_z = x;\n            }\n            return;\n        }\n        if (v1 >= r) {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            dfs(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (v2 >= r) {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v2 - 1][r];\n            dfs(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n    }\n\n    static long solve(long x, long y, int v1, int v2) {\n        long state = x * 10000 + v1 * 100 + v2;\n        if (mp.containsKey(state)) {\n            return mp.get(state);\n        }\n        long[] res = new long[1];\n        long diff = Math.abs(x - y);\n        if (diff - C[v1][r] * C[v2][r] > best) {\n            res[0] = 0;\n            mp.put(state, res[0]);\n            return res[0];\n        }\n        if (v1 < r || v2 < r) {\n            if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n                int sum = v1 + v2;\n                v1 -= cntA[sum];\n                v2 -= cntB[sum];\n                res[0] = C[v1 + v2][v1];\n                mp.put(state, res[0]);\n                return res[0];\n            }\n            res[0] = 0;\n            mp.put(state, res[0]);\n            return res[0];\n        }\n        res[0] = 0;\n        char ch = s[v1 + v2 - 1];\n        if (ch != 'B') {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n      