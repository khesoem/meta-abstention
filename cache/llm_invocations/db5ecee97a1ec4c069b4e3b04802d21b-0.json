elf.v = v\n            self.r = r\n            self.f = f\n            self.c = c\n            self.p = p\n\n    @staticmethod\n    def init(n: int = 50*T + 2):\n        Flow.N = n\n        Flow.mc = 0\n        Flow.sz = [0] * n\n        Flow.adj = [[] for _ in range(n)]\n\n    @staticmethod\n    def add_edge(a: int, b: int, c: int = 1, p: int = 0):\n        Flow.mc = max(Flow.mc, c)\n        Flow.adj[a].append(Flow.Edge(b, Flow.sz[b], 0, c, p))\n        Flow.adj[b].append(Flow.Edge(a, Flow.sz[a], 0, 0, -p))\n\n    @staticmethod\n    def pot_init(n: int):\n        Flow.pot = [0] * n\n        # no negative costs, no need for Bellman-Ford\n\n    @staticmethod\n    def mcf(s: int, t: int, price: List[int], n: int, sparse: bool, lb: int = 1) -> int:\n        vis = [False] * n\n        dist = [INF] * n\n        dist[s] = 0\n        par = [0] * n\n        # use list of pairs for density, but we implement sparse version with heap\n        if sparse:\n            pq = [(0, s)]\n            while pq:\n                d, u = heappop(pq)\n                if vis[u]:\n                    continue\n                for e in Flow.adj[u]:\n                    if e.f <= e.c - lb and dist[e.v] > dist[u] + Flow.pot[u] - Flow.pot[e.v] + e.p:\n                        dist[e.v] = dist[u] + Flow.pot[u] - Flow.pot[e.v] + e.p\n                        par[e.v] = e.r\n                        heappush(pq, (-dist[e.v], e.v))\n        else:\n            # dense version\n            u = s\n            while u != -1:\n                vis[u] = True\n                for e in Flow.adj[u]:\n                    if e.f <= e.c - lb and dist[e.v] > dist[u] + Flow.pot[u] - Flow.pot[e.v] + e.p:\n                        dist[e.v] = dist[u] + Flow.pot[u] - Flow.pot[e.v] + e.p\n                        par[e.v] = e.r\n                u = -1\n                best = INF\n                for i in range(n):\n                    if not vis[i] and dist[i] < best:\n                        best = dist[i]\n                        u = i\n        if dist[t] >= INF:\n            return 0\n        df = INF\n        u = t\n        while u != s:\n            r = Flow.adj[u][par[u]]\n            df = min(df, Flow.adj[r.v][r.r].c - Flow.adj[r.v][r.r].f)\n            u = r.v\n        u = t\n        while u != s:\n            r = Flow.adj[u][par[u]]\n            e = Flow.adj[r.v][r.r]\n            e.f += df\n            r.f -= df\n            price[0] += df * e.p\n            u = r.v\n        for i in range(n):\n            Flow.pot[i] = min(INF, dist[i] + Flow.pot[i])\n        return df\n\n    @staticmethod\n    def min_cost_flow(s: int, t: int, price: List[int], n: int = None, sparse: bool = False) -> int:\n        if n is None:\n            n = Flow.N\n        Flow.pot_init(n)\n        flow = 0\n        price[0] = 0\n        lb = 1 << 30\n        while lb > 0:\n            while True:\n                df = Flow.mcf(s, t, price, n, sparse, lb)\n                if df == 0:\n                    break\n                flow += df\n            lb //= 2\n        return flow\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    source = 0\n    sink = n * T + 1\n\n    Flow.init(n * T + 2)\n\n    for _ in range(k):\n        a = int(next(it))\n        Flow.add_edge(source, a, 1, 0)\n\n    for t in range(T):\n        Flow.add_edge(1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                Flow.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                Flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                Flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    price = [0]\n    flow = Flow.min_cost_flow(source, sink, price, sink + 1, True)\n    assert flow == k\n    print(price[0])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.9245263e-05, 0.0, -4.76836e-06, -0.000438594, -0.041483894, -0.012201314, -0.0050030756, -0.079165235, -0.06908874, -0.008657895, -0.6933851, -0.5908269, -0.014434796, -0.20157316, -2.7168927, 0.0, -0.0008792587, -0.0009846606, -0.006904671, -0.7764934, -0.015399013, -0.14682068, -1.1920928e-07, -0.832318, -0.37880236, -0.5762208, -0.087415315, 0.0, -0.0012007892, 0.0, -0.01815043, -2.3841855e-07, -8.344647e-07, 0.0, -1.1920928e-07, -0.0340664, -0.46320376, -0.0021485833, -0.038184967, -0.023386832, -7.521823e-05, -0.024609663, -0.07978533, -0.28535122, -7.152555e-07, -0.0001236124, -0.0016283836, -5.960463e-07, -1.6689287e-06, -0.03804256, -7.152555e-07, -1.7881378e-06, -0.005237074, -0.062166367, -9.5367386e-07, -1.1920928e-07, -2.6464111e-05, -3.2186456e-06, -3.576278e-07, -0.0025800534, -0.20142698, -0.056078292, -3.3020428e-05, -2.3841855e-07, -7.510157e-06, -0.00044312194, -2.7894584e-05, -0.0009962125, -7.152555e-07, -2.9802277e-06, -0.0067290845, -0.049018975, -0.33013606, -0.01401229, -3.4570635e-06, -1.2295768, -4.410734e-06, -1.9073468e-06, -2.3841855e-07, -0.25193647, 0.0, -4.7683704e-07, -1.4305105e-06, -1.072883e-06, -0.08005375, -0.0002619877, -0.0004307296, -1.1920928e-07, -0.00012385078, -8.344647e-07, -1.1920922e-06, -2.4795225e-05, -4.7683704e-07, -6.3180723e-06, -2.7418098e-06, -8.344647e-07, -1.1920928e-07, -3.576278e-07, -1.4662635e-05, -2.145765e-06, 0.0, -2.3841855e-07, 0.0, -2.3841855e-07, 0.0, -3.2186456e-06, -6.9141147e-06, -0.062029015, -9.5367386e-07, -8.344647e-07, -2.9802277e-06, -4.7683704e-07, 0.0, 0.0, -0.008643359, -1.7881378e-06, -0.0026384327, -0.00014613991, -8.344647e-07, -1.1920928e-07, -1.4066597e-05, -2.622601e-06, -1.1920928e-07, -5.960463e-07, -0.00026186852, -0.00035887476, -2.1457