routines\n  struct Edge { int v, r; ll f, c, p; };\n  vector<Edge> adj[N]; int sz[N]; ll mc;\n  void init(int n=N) { mc=0; fill(sz,sz+n,0); fill(adj,adj+n,vector<Edge>()); }\n  void add_edge(int a, int b, ll c=1, ll p=0) { mc = max(mc,c);\n    adj[a].push_back({b, sz[b]++, 0, c, p});\n    adj[b].push_back({a, sz[a]++, 0, 0, -p}); }  // change 0 to c for undirected\n\n  // Minimum cost maximum flow, assuming there are no negative cost cycles\n  // USAGE: 1) add edges 2) min_cost_flow(S, T, price, V, sparse?);\n  // use O(V^2) Dijkstra for dense graphs, and O(E*log(V)) otherwise\n  bool vis[N]; int par[N]; ll pot[N], dist[N];\n  void pot_init(int n) { fill(pot, pot+n, 0);\n    // if all edge costs >= 0, we don't need to run the Bellman-Ford here\n    for(int i=1; i<n; i++) for(int u=0; u<n; u++) for(const Edge& e:adj[u])\n      if(e.c) pot[e.v] = min(pot[e.v], pot[u] + e.p); }\n  ll mcf(int s, int t, ll& price, int n, bool sparse, ll lb=1) {\n    fill(vis, vis+n, 0); fill(dist, dist+n, INF); dist[s] = 0;\n    // only need one of the branches below\n    if(sparse) { // replace priority_queue with queue for SPFA\n      priority_queue<pair<ll,int>> dk; dk.push({0,s}); while(!dk.empty()) {\n        int u = dk.top().second; dk.pop(); if(vis[u]) continue;\n        for(const Edge& e:adj[u]) {\n          if (e.f <= e.c-lb && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r;\n            dk.push({-dist[e.v], e.v}); } } }\n    } else { // dense\n      for(int u = s; u != -1; ) { vis[u] = true; for(const Edge& e: adj[u]) {\n        if (e.f <= e.c-lb && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n          dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r; } }\n      u = -1; ll best = INF;\n      for(int i=0; i<n; i++) if(!vis[i] && dist[i]<best) best = dist[u=i]; }\n    } // end branches\n    if (dist[t] >= INF) { return 0; } ll df = INF;\n    for(int u = t; u != s; ) { const Edge& r = adj[u][par[u]];\n      df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f); u = r.v; }\n    for(int u = t; u != s; ) { Edge& r=adj[u][par[u]], &e=adj[r.v][r.r];\n      e.f += df; r.f -= df; price += df*e.p; u = r.v; }\n    for(int i=0; i<n; i++) { pot[i] = min(INF, dist[i]+pot[i]); } return df; }\n  ll min_cost_flow(int s, int t, ll& price, int n=N, bool sparse=false) {\n    pot_init(n); ll flow = price = 0;\n\t\tfor(ll lb=1<<30;lb>0;lb/=2) {\n\t\t\twhile(ll df=mcf(s, t, price, n, sparse, lb)) { flow += df; }\n\t\t} return flow; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tll price, flow = Flow::min_cost_flow(source, sink, price, sink+1, true);\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'flow', 'cost')\n    def __init__(self, to, rev, cap, flow, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nclass Flow:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.pot = [0] * n\n        self.dist = [0] * n\n        self.prevv = [0] * n\n        self.preve = [0] * n\n\n    def add_edge(self, fr, to, cap, cost):\n        self.adj[fr].append(Edge(to, len(self.adj[to]), cap, 0, cost))\n        self.adj[to].append(Edge(fr, len(self.adj[fr]) - 1, 0, 0, -cost))\n\n    def min_cost_flow(self, s, t, maxf):\n        n = self.n\n        pot = self.pot\n        dist = self.dist\n        prevv = self.prevv\n        preve = self.preve\n        flow = 0\n        cost = 0\n        # initialize potentials (all costs >= 0, so no need for Bellman-Ford)\n        # scaling\n        lb = 1 << 30\n        while lb > 0:\n            while True:\n                # Dijkstra\n                dist = [INF] * n\n                dist[s] = 0\n                pq = [(0, s)]\n                while pq:\n                    d, v = heapq.heappop(pq)\n                    if dist[v] < d:\n                        continue\n                    for i, e in enumerate(self.adj[v]):\n                        if e.cap - e.flow >= lb and dist[e.to] > dist[v] + pot[v] - pot[e.to] + e.cost:\n                            dist[e.to] = dist[v] + pot[v] - pot[e.to] + e.cost\n                            prevv[e.to] = v\n                            preve[e.to] = i\n                            heapq.heappush(pq, (dist[e.to], e.to))\n                if dist[t] == INF:\n                    break\n                # update potentials\n                for v in range(n):\n                    if dist[v] < INF:\n                        pot[v] += dist[v]\n                    else:\n                        pot[v] = INF\n                # find augmentable flow\n                d = maxf - flow\n                v = t\n                while v != s:\n                    e = self.adj[prevv[v]][preve[v]]\n                    d = min(d, e.cap - e.flow)\n                    v = prevv[v]\n                # augment\n                v = t\n                while v != s:\n                    e = self.adj[prevv[v]][preve[v]]\n                    e.flow += d\n                    self.adj[v][e.rev].flow -= d\n                    cost += d * e.cost\n                    v = prevv[v]\n                flow += d\n                if flow == maxf:\n                    return flow, cost\n            lb //= 2\n        return flow, cost\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    T = 99\n    C = 12\n    N = n * T + 2\n    source = 0\n    sink = n * T + 1\n\n    flow = Flow(N)\n\n    # source to initial positions\n    for _ in range(k):\n        a = int(next(it))\n        flow.add_edge(source, a, 1, 0)\n\n    # sink edges and waiting edges\n    for t in range(T):\n        flow.add_edge(1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    # movement edges\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j  # = 2*j+1\n            for t in range(1, T):\n                flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    total_flow, price = flow.min_cost_flow(source, sink, k)\n    # assert total_flow == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.128461584215984e-05, 0.0, -9.536738616588991e-07, -0.0015630420530214906, -0.0025053799618035555, -3.6954811548639555e-06, -0.007154558785259724, -0.038553111255168915, -0.004095738288015127, -0.1269911527633667, -0.2838491201400757, -1.1444026313256472e-05, -2.0265558760002023e-06, -1.2516897186287679e-05, -0.008614521473646164, -3.0874729418428615e-05, -0.3133596777915