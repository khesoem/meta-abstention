q[0]]:\n                            dq.appendleft(e.v)\n                        else:\n                            dq.append(e.v)\n        return self.dist[t] != INF\n\n    def minCost(self, s, t):\n        flow = 0\n        cost = 0\n        while self.spfa(s, t):\n            f = self.aug[t]\n            flow += f\n            cost += f * self.dist[t]\n            v = t\n            while v != s:\n                eid = self.parent[v]\n                self.edges[eid].flow += f\n                self.edges[eid ^ 1].flow -= f\n                v = self.edges[eid].u\n        return (flow, cost)\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    solver = MinCostFlow(n * K + 2)\n    src = n * K\n    snk = src + 1\n\n    for t in range(K):\n        solver.addEdge(t, snk, k, C * t)\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        solver.addEdge(src, x * K, 1, 0)\n\n    for i in range(n):\n        for j in range(1, K):\n            solver.addEdge(i * K + j - 1, i * K + j, k, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(1, K):\n            a = u * K + j - 1\n            b = v * K + j\n            c = v * K + j - 1\n            d = u * K + j\n            cc = D\n            for i in range(1, k + 1):\n                solver.addEdge(a, b, 1, cc)\n                solver.addEdge(c, d, 1, cc)\n                cc += 2 * D\n\n    ans = solver.minCost(src, snk)\n    sys.stdout.write(str(ans[1]) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0132738680113107e-05, 0.0, -1.1920928244535389e-07, -0.0005390383303165436, -0.007299420423805714, -5.960462772236497e-07, -1.490105023549404e-05, -0.003181041684001684, -3.576278118089249e-07, 0.0, -2.9802276912960224e-06, -0.0019