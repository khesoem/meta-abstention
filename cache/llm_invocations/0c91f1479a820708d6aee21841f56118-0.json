{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\n<your_rewritten_code_4>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        new Main().process();\n    }\n\n    void process() {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        sc.nextLine();\n\n        Mod998 mod = new Mod998();\n        mod.setup(n + m);\n\n        long phaseSize = 1;\n        long term = 1;\n        for (int i = 0; term != 0; i++) {\n            term = mod.multiply(term, mod.multiply(n - i, mod.reciprocal(n + m - i)));\n            phaseSize = mod.add(phaseSize, term);\n        }\n\n        long result = 0;\n        for (int k = 1; k <= n; k++) {\n            long phases = mod.multiply(m + k, mod.reciprocal(k));\n            long e = mod.multiply(phases, phaseSize);\n            long contribution = mod.multiply(mod.combination(n, k), e);\n\n            if (k % 2 == 1)\n                result = mod.add(result, contribution);\n            else\n                result = mod.subtract(result, contribution);\n        }\n\n        System.out.println(result);\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998_244_353L;\n        private long[] factorial;\n        private long[] invFactorial;\n\n        void setup(int maxN) {\n            factorial = new long[maxN + 1];\n            invFactorial = new long[maxN + 1];\n            factorial[0] = 1;\n            for (int i = 1; i <= maxN; i++) factorial[i] = (factorial[i - 1] * i) % MOD;\n            invFactorial[maxN] = modPow(factorial[maxN], MOD - 2);\n            for (int i = maxN - 1; i >= 0; i--) invFactorial[i] = (invFactorial[i + 1] * (i + 1)) % MOD;\n        }\n\n        long combination(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return (factorial[n] * invFactorial[r] % MOD) * invFactorial[n - r] % MOD;\n        }\n\n        long reciprocal(long x) {\n            return modPow(x, MOD - 2);\n        }\n\n        long modPow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = (res * base) % MOD;\n                base = (base * base) % MOD;\n                exp >>= 1;\n            }\n            return res;\n        }\n\n        long add(long a, long b) {\n            a %= MOD; b %= MOD;\n            long sum = a + b;\n            return sum >= MOD ? sum - MOD : sum;\n        }\n\n        long subtract(long a, long b) {\n            a %= MOD; b %= MOD;\n            long diff = a - b;\n            return diff < 0 ? diff + MOD : diff;\n        }\n\n        long multiply(long a, long b) {\n            return ((a % MOD) * (b % MOD)) % MOD;\n        }\n    }\n}\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\nusing namespace std;\n\nclass Mod998 {\nprivate:\n    static const long long MOD = 998244353LL;\n    vector<long long> factorial;\n    vector<long long> invFactorial;\n\npublic:\n    void setup(int maxN) {\n        factorial.resize(maxN + 1);\n        invFactorial.resize(maxN + 1);\n        factorial[0] = 1;\n        for (int i = 1; i <= maxN; i++) {\n            factorial[i] = (factorial[i - 1] * i) % MOD;\n        }\n        invFactorial[maxN] = modPow(factorial[maxN], MOD - 2);\n        for (int i = maxN - 1; i >= 0; i--) {\n            invFactorial[i] = (invFactorial[i + 1] * (i + 1)) % MOD;\n        }\n    }\n\n    long long combination(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return (factorial[n] * invFactorial[r] % MOD) * invFactorial[n - r] % MOD;\n    }\n\n    long long reciprocal(long long x) {\n        return modPow(x, MOD - 2);\n    }\n\n    long long modPow(long long base, long long exp) {\n        long long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    long long add(long long a, long long b) {\n        a %= MOD; b %= MOD;\n        long long sum = a + b;\n        return sum >= MOD ? sum - MOD : sum;\n    }\n\n    long long subtract(long long a, long long b) {\n        a %= MOD; b %= MOD;\n        long long diff = a - b;\n        return diff < 0 ? diff + MOD : diff;\n    }\n\n    long long multiply(long long a, long long b) {\n        return ((a % MOD) * (b % MOD)) % MOD;\n    }\n};\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n\n    Mod998 mod;\n    mod.setup(n + m);\n\n    long long phaseSize = 1;\n    long long term = 1;\n    for (int i = 0; term != 0; i++) {\n        long long numerator = mod.multiply(n - i, mod.reciprocal(n + m - i));\n        term = mod.multiply(term, numerator);\n        phaseSize = mod.add(phaseSize, term);\n    }\n\n    long long result = 0;\n    for (int k = 1; k <= n; k++) {\n        long long phases = mod.multiply(m + k, mod.reciprocal(k));