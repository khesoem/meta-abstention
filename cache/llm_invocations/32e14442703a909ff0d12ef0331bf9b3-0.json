{x, k};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    i64 target;\n    cin >> target;\n\n    priority_queue<Node> heap;\n    heap.push({target, 0});\n\n    while (!heap.empty()) {\n        Node cur = heap.top();\n        heap.pop();\n\n        if (cur.val == 0) {\n            cout << cur.steps << '\\n';\n            return 0;\n        }\n\n        if (visited(cur.val)) continue;\n        history.insert(cur.val);\n\n        vector<Node> options;\n        options.push_back(gen_lower(cur.val));\n        options.push_back(gen_upper(cur.val));\n        options.push_back(gen_uupper(cur.val));\n\n        for (auto& opt : options) {\n            opt.steps += cur.steps;\n            opt.val = std::abs(cur.val - opt.val);\n            heap.push(opt);\n        }\n    }\n\n    cout << 0 << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nfrom collections import deque\n\ndef visited(x, history_set):\n    return x in history_set\n\ndef gen_uupper(n):\n    x = 0\n    k = 0\n    while x < n:\n        x = x * 10 + 1\n        k += 1\n    return (x, k)\n\ndef gen_upper(n):\n    x = 0\n    k = 0\n    while x * 10 + 1 <= n:\n        x = x * 10 + 1\n        k += 1\n    base = x\n    base_k = k\n    while x < n:\n        x += base\n        k += base_k\n    return (x, k)\n\ndef gen_lower(n):\n    x = 0\n    k = 0\n    while x * 10 + 1 <= n:\n        x = x * 10 + 1\n        k += 1\n    base = x\n    base_k = k\n    while x + base <= n:\n        x += base\n        k += base_k\n    return (x, k)\n\ndef main():\n    target = int(input().strip())\n    \n    # Using a min-heap (priority queue) where steps are the priority\n    # We store tuples: (steps, val)\n    heap = []\n    heapq.heappush(heap, (0, target))\n    \n    history = set()\n    \n    while heap:\n        steps, val = heapq.heappop(heap)\n      