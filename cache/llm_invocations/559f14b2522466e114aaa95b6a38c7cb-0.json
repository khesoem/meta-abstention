n cnt;\n}\n\nint jc2[262155];\n\ninline int C(int n, int m) {\n    return (long long)jc[n] * inv[m] % mod * inv[n - m] % mod;\n}\n\ninline int dfs(int n, int k) {\n    if(n == 0) return 1;\n    if(k == 0) return 0;\n    if(dp[n][k] != -1) return dp[n][k];\n    int di = (1 << Log[n]), ret = 0;\n    for(int i = n; i >= di; i -= 2) {\n        ret = (ret + (long long)C(n, i) * dfs(n - i, k - 1) % mod * k) % mod;\n    }\n    return dp[n][k] = ret;\n}\n\nint main() {\n    R(n), R(k), R(mod);\n    jc[0] = 1;\n    memset(dp, -1, sizeof(dp));\n    Log[0] = -1;\n    for(int i = 1; i <= 262150; ++i) {\n        jc[i] = (long long)jc[i - 1] * i % mod;\n        Log[i] = Log[i >> 1] + 1;\n        jc2[i] = jc2[i - 1] + getcnt(i);\n    }\n    inv[262150] = ksm(jc[262150], mod - 2);\n    for(int i = 262149; i; --i) inv[i] = (long long)inv[i + 1] * (i + 1) % mod;\n    inv[0] = inv[1];\n    if(n & 1) {\n        cout << ksm(k, n) << '\\n';\n    } else {\n        int ans = ksm(k, n);\n        ans = ((ans - dfs(n, k)) % mod + mod) % mod;\n        cout << ans << '\\n';\n    }\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom array import array\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    mod = int(next(it))\n    \n    max_n = n  # factorials and logs up to n\n    # Precompute factorials and inverses\n    jc = [1] * (max_n + 1)\n    for i in range(1, max_n + 1):\n        jc[i] = (jc[i-1] * i) % mod\n    \n    inv = [1] * (max_n + 1)\n    if mod > 1:\n        inv[max_n] = pow(jc[max_n], mod - 2, mod)\n        for i in range(max_n, 0, -1):\n            inv[i-1] = (inv[i] * i) % mod\n    else:\n        # mod == 1, all modulo operations yield 0\n        inv = [0] * (max_n + 1)\n    \n    # Precompute Log and jc2 (unused but kept for exactness)\n    Log = [0] * (max_n + 1)\n    Log[0] = -1\n    jc2 = [0] * (max_n + 1)\n    def getcnt(x):\n        cnt = 0\n        while x and x % 2 == 0:\n            cnt += 1\n            x //= 2\n        return cnt\n    for i in range(1, max_n + 1):\n        Log[i] = Log[i >> 1] + 1\n        jc2[i] = jc2[i-1] + getcnt(i)\n    \n    # DP array: flat ( (max_n+1)*31 ) initialized to -1\n    dp = array('i', [-1]) * ((max_n + 1) * 31)\n    \n    def C(nn, m):\n        if m < 0 or m > nn:\n            return 0\n        return (jc[nn] * inv[m] % mod) * inv[nn - m] % mod\n    \n    def dfs(nn, kk):\n        if nn == 0:\n            return 1\n        if kk == 0:\n            return 0\n        idx = nn * 31 + kk\n        if dp[idx] != -1:\n            return dp[idx]\n        di = 1 << Log[nn]  # largest power of two <= nn\n        ret = 0\n        i = nn\n        while i >= di:\n            term = C(nn, i)\n            term = term * dfs(nn - i, kk - 1) % mod\n            term = term * kk % mod\n            ret = (ret + term) % mod\n            i -= 2\n        dp[idx] = ret\n        return ret\n    \n    if n & 1:\n        ans = pow(k, n, mod)\n        print(ans)\n    else:\n        total = pow(k, n, mod)\n        sub = dfs(n, k)\n        ans = (total - sub) % mod\n        print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -2.3841830625315197e-06, -0.0012315078638494015, -0.002007613657042384, -2.3841855067985307e-07, -0.0007434703293256462, -0.0010482537327334285, -6.41325386823155e-05, 0.0, 0.0, -0.00020621081057470292, -0.03183700889348984, -2.311258316040039, -0.005248695611953735, -5.602820692729438e-06, -0.0006704466650262475, -1.9073468138230965e-06, -0.20166319608688354, 0.0, -1.1368985176086426, -5.722029527532868e-06, -0.10022114217281342, -2.1934269170742482e-05, -9.536738616588991e-07, -0.025149086490273476, -3.576214658096433e-05, -1.1920928244535389e-07, -0.0015024575404822