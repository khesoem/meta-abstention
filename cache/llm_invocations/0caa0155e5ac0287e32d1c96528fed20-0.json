                divisors.push_back(n / i);\n            }\n        }\n    }\n    sort(divisors.begin(), divisors.end());\n    return divisors;\n}\n\nlong long mod_pow(long long base, long long exp, long long mod) {\n    long long result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) {\n            result = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    long long p, k;\n    cin >> p >> k;\n    \n    const long long MOD = 1000000007LL;\n    \n    if (k == 0) {\n        long long result = mod_pow(p, p - 1, MOD);\n        cout << result << endl;\n    } else if (k == 1) {\n        long long result = mod_pow(p, p, MOD);\n        cout << result << endl;\n    } else {\n        vector<long long> divisors = get_divisors(p - 1);\n        for (long long z : divisors) {\n            if ((p - 1) % z == 0 && mod_pow(k, z, p) == 1) {\n                long long result = mod_pow(p, (p - 1) / z, MOD);\n                cout << result << endl;\n                break;\n            }\n        }\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012361239350866526, -3.3378546504536644e-06, -2.3841855067985307e-07, -2.1457441107486375e-05, -2.3841855067985307e-07, -0.0003122795606032014, -1.1920928244535389e-07, -3.576272320060525e-06, 0.0, -1.549708758830093e-05, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -0.043071962893009186, -1.0728830375228426e-06, -0.009757207706570625, -9.179073458653875e-06, -1.8358061424805783e-05, -0.5759514570236206, -0.6944693922996521, -4.732496745418757e-05, -8.940656698541716e-06, -8.344646857949556e-07, -0.020762717351317406, -0.03804508596658707, -1.0490362910786644e-05, -1.311301275563892e-06, -2.622600959512056e-06, -0.0006392342620529234, -2.7418097943154862e-06, -3.576272320060525e-06, -2.264974000354414e-06, -1.1920928244535389e-07, -1.0728830375228426e-06, -1.1920928