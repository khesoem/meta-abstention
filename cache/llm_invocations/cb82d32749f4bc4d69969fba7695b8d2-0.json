| depth[v] >= depth[to]) continue;\n            ll d = dfs(to, t, min(flow, cap));\n            if (d == 0) continue;\n            edge[0] -= d;\n            links[to][edge[2]][0] += d;\n            return d;\n        }\n        return 0;\n    }\n\n    ll flow(int s, int t) {\n        ll flow = 0;\n        while (true) {\n            bfs(s);\n            if (depth[t] < 0) return flow;\n            fill(progress.begin(), progress.end(), 0);\n            ll current_flow = dfs(s, t, INF);\n            while (current_flow > 0) {\n                flow += current_flow;\n                current_flow = dfs(s, t, INF);\n            }\n        }\n    }\n\n    pair<int, pair<ll, ll>> get_edge(int i) {\n        auto& p = pos[i];\n        auto& e = links[p.first][p.second];\n        auto& re = links[e[1]][e[2]];\n        return make_pair(p.first, make_pair(e[0] + re[0], re[0]));\n    }\n\n    vector<pair<int, pair<ll, ll>>> get_edges() {\n        vector<pair<int, pair<ll, ll>>> res;\n        for (int i = 0; i < (int)pos.size(); i++) {\n            res.push_back(get_edge(i));\n        }\n        return res;\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N, M = 3;\n    cin >> N;\n    vector<ll> A(M), B(M);\n    for (int i = 0; i < M; i++) cin >> A[i];\n    for (int i = 0; i < M; i++) cin >> B[i];\n\n    ll ans1 = 0;\n    for (int i = 0; i < M; i++) {\n        ans1 += min(A[i], B[(i + 1) % M]);\n    }\n\n    ll ans2 = 0;\n    Dinic dinic(2 * M + 2);\n    int s = 2 * M;\n    int t = 2 * M + 1;\n    for (int i = 0; i < M; i++) {\n        dinic.add_edge(s, i, N);\n        dinic.add_edge(M + i, t, B[i]);\n        dinic.add_edge(i, M + i, A[i]);\n        dinic.add_edge(i, M + (i - 1 + M) % M, A[i]);\n    }\n    ans2 = N - dinic.flow(s, t);\n\n    cout << ans2 << \" \" << ans1 << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001419681793777272, -2.7418097943154862e-06, -3.5762