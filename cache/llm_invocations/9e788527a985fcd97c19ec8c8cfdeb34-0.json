 e->complement->flow -= minflow;\n        }\n        all -= minflow;\n        for (int i = 0; i < n; i++) {\n            potential[i] += d[i];\n        }\n    }\n    return mincost;\n}\n\nint main() {\n    int n;\n    cin >> n;\n    string s;\n    cin >> s;\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) cin >> a[i];\n\n    int f[26] = {0};\n    for (char c : s) f[c - 'a']++;\n    for (int i = 0; i < 26; i++) {\n        if (f[i] > n / 2) {\n            cout << -1 << endl;\n            return 0;\n        }\n    }\n\n    for (int i = 0; i < n / 2; i++) {\n        if (a[i] > a[n - 1 - i]) {\n            swap(a[i], a[n - 1 - i]);\n            swap(s[i], s[n - 1 - i]);\n        }\n    }\n\n    int src = n, sink = n + 1;\n    vector<Edge*> edges;\n    for (int i = 0; i < n / 2; i++) {\n        edges.push_back(new Edge(src, i, 1, 0));\n        edges.push_back(new Edge(n - 1 - i, sink, 1, 0));\n        for (int j = 0; j < n / 2; j++) {\n            if (s[i] != s[n - 1 - j]) {\n                edges.push_back(new Edge(i, n - 1 - j, 1, (i == j ? 0 : a[i])));\n            }\n        }\n    }\n\n    vector<vector<Edge*>> g = compileWD(sink + 1, edges);\n    long long total = 0;\n    for (int x : a) total += x;\n    long long mincost = solveMinCostFlow(g, src, sink, n);\n    cout << total - mincost << endl;\n\n    // Free memory (optional, but good practice)\n    for (Edge* e : edges) delete e;\n    return 0;\n}\n```", "token_logprobs": [-0.4985930323600769, -2.0265558760002023e-06, -1.9073468138230965e-06, -1.6689286894688848e-06, -2.3841855067985307e-07, -0.0004312062228564173, -8.940656698541716e-06, 0.0, 0.0, -0.0007114263135008514, -8.344646857949556e-07, 0.0, 0.0, -1.0132738680113107e-05, -1.0728830375228426e-06, 0.0, 0.0, -0.0004481264913920313, -2.3841830625315197e-06, 0.0, 0.0, -4.577531944960356e-05, 0.0, 0.0, -0.47410905361175537, -0.20141664147377014, 0.0, -0.018331395462155342, -0.0026480630040168762, -0.20237025618553162, -2.169585604860913e-05, -4.76837044