ayList<>();\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                char c = sci[i].charAt(j);\n                if (c == 'Z') {\n                    rx = i;\n                    ry = j;\n                } else if (c >= '0' && c <= '9') {\n                    pos.add(new int[]{i, j});\n                    lc.add(lab[i].charAt(j) - '0');\n                    scList.add(c - '0');\n                }\n            }\n        }\n\n        int m = pos.size();\n        int totalNodes = 2 * m + 2;\n        cap = new int[totalNodes][totalNodes];\n        par = new int[totalNodes];\n        dist = new int[20][20];\n        vis = new int[20][20];\n        memFlat = new int[12 * 12 * 12 * 12 * 62];\n        Arrays.fill(memFlat, -1);\n\n        for (int i = 0; i < m; i++) {\n            cap[0][i + 1] = scList.get(i);\n            cap[m + 1 + i][2 * m + 1] = lc.get(i);\n        }\n\n        pre();\n\n        for (int i = 0; i < m; i++) {\n            for (int j = 0; j < m; j++) {\n                int[] p1 = pos.get(i);\n                int[] p2 = pos.get(j);\n                if (canReach(p1[0], p1[1], p2[0], p2[1], 0)) {\n                    cap[i + 1][m + 1 + j] = 1000;\n                }\n            }\n        }\n\n        int flow = 0;\n        while (fml(0, 2 * m + 1)) {\n            int cur = 2 * m + 1;\n            int nflow = 1000000;\n            while (par[cur] >= 0) {\n                nflow = Math.min(nflow, cap[par[cur]][cur]);\n                cur = par[cur];\n            }\n            cur = 2 * m + 1;\n            while (par[cur] >= 0) {\n                cap[par[cur]][cur] -= nflow;\n                cap[cur][par[cur]] += nflow;\n                cur = par[cur];\n            }\n            flow += nflow;\n        }\n\n        System.out.println(flow);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-3.242440288886428e-05, -1.1920928244535389e-07, -2.3841855067985307e-0