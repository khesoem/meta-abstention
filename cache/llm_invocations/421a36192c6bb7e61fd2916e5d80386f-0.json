effs = new long[r + 1];\n        coeffs[0] = 1;\n        long numerator = 1;\n        long denominator = 1;\n        \n        for (int i = 1; i <= r; i++) {\n            numerator = numerator * (r - i + 1) % MOD;\n            denominator = denominator * i % MOD;\n            coeffs[i] = numerator * modInverse(denominator) % MOD;\n        }\n        \n        return coeffs;\n    }\n    \n    private static long binomial(long n, long k) {\n        if (k < 0 || k > n) return 0;\n        if (k == 0 || k == n) return 1;\n        \n        long num = 1;\n        for (long i = n - k + 1; i <= n; i++) {\n            num = num * i % MOD;\n        }\n        \n        long denom = 1;\n        for (long i = 1; i <= k; i++) {\n            denom = denom * i % MOD;\n        }\n        \n        return num * modInverse(denom) % MOD;\n    }\n    \n    private static long modInverse(long a) {\n        return power(a, MOD - 2);\n    }\n    \n    private static long power(long base, long exp) {\n        long result = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = result * base % MOD;\n            }\n            base = base * base % MOD;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef mod_inverse(a):\n    return power(a, MOD - 2)\n\ndef power(base, exp):\n    result = 1\n    base %= MOD\n    while exp > 0:\n        if (exp & 1) == 1:\n            result = (result * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return result\n\ndef precompute_binomial_coefficients(r):\n    coeffs = [0] * (r + 1)\n    coeffs[0] = 1\n    numerator = 1\n    denominator = 1\n    \n    for i in range(1, r + 1):\n        numerator = (numerator * (r - i + 1)) % MOD\n        denominator = (denominator *