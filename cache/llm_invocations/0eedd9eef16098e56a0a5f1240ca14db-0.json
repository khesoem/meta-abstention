 < 0) {\n                g = trim(multiplyPolynomials(g, f));\n            }\n        }\n        System.out.println(n * 10 < g.length ? g[n * 10] % MOD : 0);\n    }\n\n    long[] trim(long[] arr) {\n        int idx = arr.length - 1;\n        while (idx >= 0 && arr[idx] == 0) idx--;\n        return idx < 0 ? new long[0] : Arrays.copyOf(arr, idx + 1);\n    }\n\n    long[] multiplyPolynomials(long[] a, long[] b) {\n        int lenA = a.length, lenB = b.length;\n        long[] result = new long[lenA + lenB - 1];\n        for (int i = 0; i < lenA; i++) {\n            for (int j = 0; j < lenB; j++) {\n                result[i + j] = (result[i + j] + a[i] * b[j]) % MOD;\n            }\n        }\n        return result;\n    }\n\n    void flush() { System.out.flush(); }\n\n    boolean isOnline() { return System.getProperty(\"ONLINE_JUDGE\") != null; }\n\n    // Fast I/O\n    private final BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n    private StringTokenizer st;\n    private String nextToken() {\n        while (st == null || !st.hasMoreTokens()) {\n            try { st = new StringTokenizer(br.readLine()); } catch (IOException e) { throw new RuntimeException(e); }\n        }\n        return st.nextToken();\n    }\n    int nextInt() { return Integer.parseInt(nextToken()); }\n    int[] readIntArray(int n) {\n        int[] arr = new int[n];\n        for (int i = 0; i < n; i++) arr[i] = nextInt();\n        return arr;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nMOD = 998244353\nPRIMES = [1053818881, 1051721729, 1045430273, 1012924417, 1007681537, 1004535809, 998244353, 985661441, 976224257, 975175681]\nROOTS = [7, 6, 3, 5, 3, 3, 3, 3, 3, 17]\n\ndef trim(arr):\n    idx = len(arr) - 1\n    while idx >= 0 and arr[idx] == 0:\n        idx -= 1\n    return arr[:idx+1] if idx >= 0 else []\n\ndef mult