lude <stdexcept>\n#include <algorithm>\n\nclass FastScanner {\nprivate:\n    std::vector<char> buffer;\n    size_t ptr;\n    size_t buflen;\n    \npublic:\n    FastScanner() : buffer(1024), ptr(0), buflen(0) {}\n    \nprivate:\n    bool hasNextByte() {\n        if (ptr < buflen) {\n            return true;\n        } else {\n            ptr = 0;\n            buflen = std::cin.readsome(&buffer[0], buffer.size());\n            if (buflen <= 0) {\n                return false;\n            }\n        }\n        return true;\n    }\n    \n    int readByte() {\n        if (hasNextByte()) {\n            return static_cast<unsigned char>(buffer[ptr++]);\n        } else {\n            return -1;\n        }\n    }\n    \n    static bool isPrintableChar(int c) {\n        return 33 <= c && c <= 126;\n    }\n    \n    void skipUnprintable() {\n        while (hasNextByte() && !isPrintableChar(buffer[ptr])) {\n            ptr++;\n        }\n    }\n    \npublic:\n    bool hasNext() {\n        skipUnprintable();\n        return hasNextByte();\n    }\n    \n    std::string next() {\n        if (!hasNext()) {\n            throw std::runtime_error(\"No more elements\");\n        }\n        std::string sb;\n        int b = readByte();\n        while (isPrintableChar(b)) {\n            sb += static_cast<char>(b);\n            b = readByte();\n        }\n        return sb;\n    }\n    \n    long long nextLong() {\n        return std::stoll(next());\n    }\n    \n    int nextInt() {\n        return std::stoi(next());\n    }\n    \n    double nextDouble() {\n        return std::stod(next());\n    }\n};\n\nint main() {\n    FastScanner sc;\n    \n    int n = sc.nextInt();\n    if (n >= 12) {\n        std::cout << \"0\" << std::endl;\n        return 0;\n    }\n    \n    std::vector<std::vector<int>> a(n, std::vector<int>(5));\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 5; j++) {\n            a[i][j] = sc.nextInt();\n        }\n    }\n    \n    std::vector<int> ans;\n    f