}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\nusing namespace std;\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    \n    vector<int> a(20);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n    }\n    \n    vector<int> left_sums;\n    int left_size = n / 2 + n % 2;\n    \n    for (int mask = 0; mask < (1 << left_size); mask++) {\n        int total = 0;\n        int temp = mask;\n        for (int idx = 0; idx < 20; idx++) {\n            if (temp & 1) {\n                total += a[idx];\n            }\n            temp >>= 1;\n        }\n        left_sums.push_back(total % m);\n    }\n    \n    sort(left_sums.begin(), left_sums.end());\n    \n    int result = 0;\n    int right_size = n / 2;\n    \n    for (int mask = 0; mask < (1 << right_size); mask++) {\n        int total = 0;\n        int temp = mask;\n        for (int idx = 0; idx < 20; idx++) {\n            if (temp & 1) {\n                total += a[left_size + idx];\n            }\n            temp >>= 1;\n        }\n        total %= m;\n        \n        int complement = m - total - 1;\n        int pos = lower_bound(left_sums.begin(), left_sums.end(), complement) - left_sums.begin();\n        \n        int candidate = left_sums.empty() ? 0 : left_sums.back();\n        if (pos < (int)left_sums.size()) {\n            if (left_sums[pos] > complement) {\n                if (pos > 0) {\n                    candidate = left_sums[pos - 1];\n                }\n            } else {\n                candidate = left_sums[pos];\n            }\n        }\n        \n        int val1 = (total + candidate) % m;\n        int val2 = (total + left_sums.back()) % m;\n        result = max(result, max(val1, val2));\n    }\n    \n    cout << result % m << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016449528629891574, -1.3112935448589269e-05, -1.430510451427