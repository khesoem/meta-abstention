lf) -> int:\n        return self.size\n\n\nclass Modulus:\n    def __init__(self):\n        self.factorial = IntStack()\n        self.invFactorial = IntStack()\n        self.factorial.push(1)\n        self.invFactorial.push(1)\n\n    def modulus(self) -> int:\n        raise NotImplementedError\n\n    def fact(self, n: int) -> int:\n        while self.factorial.size <= n:\n            next_val = self.mult(self.factorial.get(self.factorial.size - 1), self.factorial.size)\n            self.factorial.push(next_val)\n        return self.factorial.get(n)\n\n    def fInv(self, n: int) -> int:\n        last_known = self.invFactorial.size - 1\n        if last_known < n:\n            f_inv = [0] * (n - last_known)\n            f_inv[0] = self.inv(self.fact(n))\n            for i in range(1, len(f_inv)):\n                f_inv[i] = self.mult(f_inv[i - 1], n - i + 1)\n            for i in range(len(f_inv) - 1, -1, -1):\n                self.invFactorial.push(int(f_inv[i]))\n        return self.invFactorial.get(n)\n\n    def paritySign(self, k: int) -> int:\n        return 1 if (k & 1) == 0 else self.modulus() - 1\n\n    def ncr(self, n: int, r: int) -> int:\n        if r < 0 or n < r:\n            return 0\n        return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n    def smallInv(self, n: int) -> int:\n        return self.mult(self.fInv(n), self.fact(n - 1))\n\n    def normalize(self, x: int) -> int:\n        x %= self.modulus()\n        return x if x >= 0 else x + self.modulus()\n\n    def add(self, a: int, b: int) -> int:\n        v = a + b\n        return v if v < self.modulus() else v - self.modulus()\n\n    def mult(self, *args) -> int:\n        r = 1\n        for x in args:\n            r = self.mult_two(r, x)\n        return r\n\n    def mult_two(self, a: int, b: int) -> int:\n        return (a * b) % self.modulus()\n\n    def inv(self, value: int) -> int:\n        g, x, y = self.modulus(), 0, 1\n        r = value\n        while r != 0:\n     