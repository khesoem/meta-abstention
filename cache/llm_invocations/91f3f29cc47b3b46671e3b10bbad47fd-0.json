\n    \n    static int dfs(BitSet s) {\n        if (idMap.containsKey(s)) {\n            return idMap.get(s);\n        }\n        int id = idMap.size() + 1; // 1-indexed\n        idMap.put((BitSet) s.clone(), id);\n        // ensure chList has enough rows\n        while (chList.size() <= id) {\n            chList.add(new int[1 << n]);\n        }\n        int[] chRow = chList.get(id);\n        for (int i = 0; i < (1 << n); i++) {\n            BitSet tmp = (BitSet) s.clone();\n            for (int j = 0; j < (1 << n); j++) {\n                if (!tmp.get(j)) {\n                    int x = i & j;\n                    while (x != 0) {\n                        int t = lowbit(x);\n                        if (s.get(j ^ t)) {\n                            tmp.set(j);\n                            break;\n                        }\n                        x -= t;\n                    }\n                }\n            }\n            chRow[i] = dfs(tmp);\n        }\n        return id;\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        // initialize a\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                a[i][j] = sc.nextInt();\n                a[i][j] = mult(a[i][j], power(100, MOD - 2));\n            }\n        }\n        // precompute q\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < (1 << n); j++) {\n                q[i][j] = 1;\n                for (int k = 0; k < n; k++) {\n                    if (((j >> k) & 1) == 1) {\n                        q[i][j] = mult(q[i][j], a[i][k]);\n                    } else {\n                        q[i][j] = mult(q[i][j], dec(1, a[i][k]));\n                    }\n                }\n            }\n        }\n        // initial bitset: only bit 0 set\n        BitSet init = new BitSet(128);\n        init.set(0);\n        dfs(init);\n        int idcnt = idMap.size();\n        dp = new int