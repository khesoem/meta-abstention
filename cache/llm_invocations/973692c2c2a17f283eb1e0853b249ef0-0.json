e": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        int m = scanner.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = scanner.nextInt();\n        }\n        \n        List<Integer> a1 = new ArrayList<>();\n        List<Integer> a2 = new ArrayList<>();\n        int n1 = n / 2;\n        \n        subsetSumsLeft(a, a1, 0, 0, n1, m);\n        subsetSumsRight(a, a2, n1, 0, n, m);\n        \n        // Remove duplicates and sort a1\n        Set<Integer> set = new HashSet<>(a1);\n        a1 = new ArrayList<>(set);\n        Collections.sort(a1);\n        \n        int result = 0;\n        for (int val : a2) {\n            int complement = (m - val) % m;\n            int pos = binarySearchFirstGreaterOrEqual(a1, complement);\n            if (pos > 0) {\n                int candidate = a1.get(pos - 1) + val;\n                if (candidate > result) {\n                    result = candidate;\n                }\n            }\n        }\n        System.out.println(result);\n    }\n    \n    private static void subsetSumsLeft(int[] a, List<Integer> result, int idx, int current, int n1, int m) {\n        if (idx == n1) {\n            result.add(current);\n        } else {\n            subsetSumsLeft(a, result, idx + 1, (current + a[idx]) % m, n1, m);\n            subsetSumsLeft(a, result, idx + 1, current, n1, m);\n        }\n    }\n    \n    private static void subsetSumsRight(int[] a, List<Integer> result, int idx, int current, int n, int m) {\n        if (idx == n) {\n            result.add(current);\n        } else {\n            subsetSumsRight(a, result, idx + 1, (current + a[idx]) % m, n, m);\n            subsetSumsRight(a, result, idx + 1, current, n, m);\n        }\n    }\n    \n    private static int binarySearchFirstGreaterOrEqual(List<Integer> list, int target) {\n        int left = 0;\n        int right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) < target) {\n                left = mid + 1;\n            } else {\n                right = mid;\n            }\n        }\n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.259582343976945e-05, -1.0728830375228426e-06, -2.3841855067985307e-07, -4.708655978902243e-05, -2.038458114839159e-05, -0.004079116974025965, -0.20253926515579224, -2.145764938177308e-06, -8.344646857949556e-07, -0.00013481661153491586, -0.01104797888547182, -0.0036011389456689358, -0.2028064727783203, -2.145764938177308e-06, -0.0014911495381966233, -0.04300173744559288, -3.099436753473128e-06, -5.960462772236497e-07, -9.97731985989958e-05, -4.768370445162873e-07, -4.768370445162873e-07, -3.576272320060525e-06, -0.0007443041540682316, -0.6353375911712646, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.002696055569686e-05, -3.099436753473128e-06, -8.344646857949556e-07, -3.9219088648678735e-05, -0.6326048374176025, -0.00019667598826345056, -2.9802276912960224e-06, -2.3841855067985307e-07, -1.2278481335670222e-05, -1.311301275563892e-06, -1.0728830375228426e-06, 0.0, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, -1.3828182090946939e-05, -4.768370445162873e-07, -2.50339189733495e-06, -0.016034699976444244, -0.0003933132975362241, 0.0, -3.933898824470816e-06, 0.0, -3.099436753473128e-06, -3.576278118089249e-07, -3.576278118089249e-07, -9.536697689327411e-06, -0.033646464347839355, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.6954811548639555e-06, -2.7418097943154862e-06, -3.576278118089249e-07, -1.4185804502631072e-05, -2.3841855067985307e-07, -4.768370445162873e-07, -3.576272320060525e-06, -2.3841855067985307e-07, -4.410734163684538e-06, -3.695481154