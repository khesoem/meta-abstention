op++;\n                high = 1 << b;\n            }\n        }\n        cnt[i] = pop;\n        mx[i] = high;\n    }\n    dp[0][0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        if ((n & i) != i) continue;\n        int now = i ^ mx[i];\n        // iterate submasks using for loop with decrement\n        for (int k = now; ; k = (k - 1) & now) {\n            int cur1 = k + mx[i];\n            int cur2 = i ^ cur1;\n            int up = min(K - 1, cnt[cur2]);\n            int tmp = C(i, cur1);\n            for (int j = 0; j <= up; ++j) {\n                dp[i][j + 1] = (dp[i][j + 1] + (long long)dp[cur2][j] * tmp) % mod;\n            }\n            if (k == 0) break;\n        }\n    }\n    int ans = 0;\n    int lim = min(cnt[n], K);\n    for (int j = 1; j <= lim; ++j) {\n        ans = (ans + (long long)dp[n][j] * C(K, j) % mod * fact[j]) % mod;\n    }\n    ans = (power(K, n) - ans + mod) % mod;\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static int[] fact, invFact, cnt, mx;\n    static int[][] dp;\n    static int mod;\n\n    static int power(int x, int y) {\n        long res = 1;\n        long base = x % mod;\n        while (y > 0) {\n            if ((y & 1) == 1) res = (res * base) % mod;\n            base = (base * base) % mod;\n            y >>= 1;\n        }\n        return (int) res;\n    }\n\n    static int C(int i, int j) {\n        long res = (long) fact[i] * invFact[j] % mod;\n        res = res * invFact[i - j] % mod;\n        return (int) res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int K = sc.nextInt();\n        mod = sc.nextInt();\n\n        if ((n & 1) == 1) {\n            System.out.println(power(K, n));\n            return;\n        }\n\n        fact = new int[n + 1];\n        invFact = new int[n + 1];\n        cnt = new int[n + 1];\n        mx = new int[n + 1];\n        dp = new int[n + 1][20];\n\n        fact[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            fact[i] = (int) ((long) fact[i - 1] * i % mod);\n        }\n        invFact[n] = power(fact[n], mod - 2);\n        invFact[0] = 1;\n        for (int i = n - 1; i >= 1; i--) {\n            invFact[i] = (int) ((long) invFact[i + 1] * (i + 1) % mod);\n        }\n\n        // Compute cnt and mx\n        for (int i = 1; i <= n; i++) {\n            int x = i;\n            int pop = 0;\n            int high = 0;\n            for (int b = 0; b < 20; b++) {\n                if ((x & (1 << b)) != 0) {\n                    pop++;\n                    high = 1 << b;\n                }\n            }\n            cnt[i] = pop;\n            mx[i] = high;\n        }\n\n        dp[0][0] = 1;\n        for (int i = 1; i <= n; i++) {\n            if ((n & i) != i) continue;\n            int now = i ^ mx[i];\n            // iterate submasks of now\n            for (int k = now; ; k = (k - 1) & now) {\n                int cur1 = k + mx[i];\n                int cur2 = i ^ cur1;\n                int up = Math.min(K - 1, cnt[cur2]);\n                int tmp = C(i, cur1);\n                for (int j = 0; j <= up; j++) {\n                    dp[i][j + 1] = (int) ((dp[i][j + 1] + (long) dp[cur2][j] * tmp) % mod);\n                }\n                if (k == 0) break;\n            }\n        }\n\n        int ans = 0;\n        int lim = Math.min(cnt[n], K);\n        for (int j = 1; j <= lim; j++) {\n            long term = (long) dp[n][j] * C(K, j) % mod;\n            term = term * fact[j] % mod;\n            ans = (int) ((ans + term) % mod);\n        }\n        ans = (power(K, n) - ans + mod) % mod;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -1.0609570381348021e-05