{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include <iostream>\n#include <queue>\n#include <map>\nusing namespace std;\ntypedef map<int,int> mi;\n\nmi edge[7000];\nchar buf[20][20];\nint n,m,vn,from[7000],flow[7000],tox[10][10];\n\ninline int aug(int s,int t,int cap){\n  int result=0;\n  for (int aug=1; aug--;){\n    for (int i=vn; i--;) from[i]=-1;\n    from[s]=s;\n    flow[s]=cap;\n    queue<int> bfs;\n    for (bfs.push(s); not bfs.empty(); bfs.pop()){\n      int x=bfs.front();\n      if (x==t){\n        for (aug=1; x!=s; x=from[x])\n          edge[from[x]][x]-=flow[t],\n          edge[x][from[x]]+=flow[t];\n        result+=flow[t];\n        break;\n      }\n      for (mi::iterator e=edge[x].begin(); e!=edge[x].end(); e++)\n        if (e->second>=cap and !~from[e->first])\n          from[e->first]=x, flow[e->first]=min(e->second,flow[x]), bfs.push(e->first);\n    }\n  }\n  return result;\n}\n\ninline int enc(int x,int y,int t){\n  return x+y*n+t*n*n+2;\n}\n\nint main(){\n  ios::sync_with_stdio(0);\n  cin>>n>>m;\n\n  int res=0;\n  for (int i=0; i<n; i++)\n    for (int j=!(cin>>buf[i]); j<n; j++)\n      if (buf[i][j]>'0' and buf[i][j]<='9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        if (t<m) for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  for (int u=8; u; u>>=1) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    n, m = map(int, data[0].split())\n    buf = []\n    idx = 1\n    for i in range(n):\n        if idx < len(data):\n            buf.append(data[idx])\n            idx += 1\n        else:\n            buf.append(\"\")\n    \n    # Initialize edge as list of dictionaries\n    edge = [dict() for _ in range(7000)]\n    \n    # enc function\n    def enc(x, y, t):\n        return x + y * n + t * n * n + 2\n    \n    # aug function (Edmonds-Karp style augmenting path)\n    def aug(s, t, cap):\n        result = 0\n        for _ in range(1):\n            from_arr = [-1] * 7000\n            flow = [0] * 7000\n            from_arr[s] = s\n            flow[s] = cap\n            bfs = deque()\n            bfs.append(s)\n            \n            while bfs:\n                x = bfs.popleft()\n                if x == t:\n                    aug_flow = flow[t]\n                    cur = t\n                    while cur != s:\n                        prev = from_arr[cur]\n                        edge[prev][cur] = edge[prev].get(cur, 0) - aug_flow\n                        edge[cur][prev] = edge[cur].get(prev, 0) + aug_flow\n                        cur = prev\n                    result += aug_flow\n                    break\n                \n                for e_node, e_cap in edge[x].items():\n                    if e_cap >= cap and from_arr[e_node] == -1:\n                        from_arr[e_node] = x\n                        flow[e_node] = min(e_cap, flow[x])\n                        bfs.append(e_node)\n        \n        return result\n    \n    # Process first grid\n    for i in range(n):\n        if i < len(buf):\n            line = buf[i]\n            for j in range(n):\n                if j < len(line) and '0' < line[j] <= '9':\n                    edge[0][enc(i, j, 0)] = int(line[j])\n    \n    # Read second grid\n    buf2 = []\n    for i in range(n):\n        if idx < len(data):\n            buf2.append(data[idx])\n            idx += 1\n        else:\n            buf2.append(\"\")\n    \n    # Direction vectors\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    \n    # tox array\n    tox = [[m + 1] * n for _ in range(n)]\n    bfs = deque()\n    \n    for i in range(n):\n        for j in range(n):\n            if i < len(buf2) and j < len(buf2[i]) and buf2[i][j] == 'Z':\n                tox[i][j] = 0\n                bfs.append((i, j))\n    \n    while bfs:\n        x, y = bfs.popleft()\n        for i in range(4):\n            nx = x + dx[i]\n            ny = y + dy[i]\n            if 0 <= nx < n and 0 <= ny < n and buf2[nx][ny] != 'Y' and tox[x][y] + 1 < tox[nx][ny]:\n                tox[nx][ny] = tox[x][y] + 1\n                bfs.append((nx, ny))\n    \n    vn = enc(n-1, n-1, m) + 1\n    \n    # Build the graph\n    for i in range(n):\n        for j in range(n):\n            for t in range(m):\n                for q in range(4):\n                    x = i + dx[q]\n                    y = j + dy[q]\n                    if 0 <= x < n and 0 <= y < n and buf2[x][y] != 'Y':\n                        # Check conditions\n                        cell_val = 0\n                        if i < len(buf) and j < len(buf[i]) and '0' < buf[i][j] <= '9':\n                            cell_val = int(buf[i][j])\n                        if t + 1 < tox[x][y] + (1 if (x < len(buf) and y < len(buf[x]) and '0' < buf[x][y] <= '9') else 0) and t < tox[i][j]:\n                            edge[enc(i, j, t)][enc(x, y, t + 1)] = 1000\n                \n                if i < len(buf) and j < len(buf[i]) and '0' < buf[i][j] <= '9':\n                    edge[enc(i, j, t)][enc(i, j, m)] = int(buf[i][j])\n            \n            if i < len(buf) and j < len(buf[i]) and '0' < buf[i][j] <= '9':\n                edge[enc(i, j, m)][1] = int(buf[i][j])\n    \n    # Max flow calculation\n    res = 0\n    u = 8\n    while u:\n        res += aug(0, 1, u)\n        u >>= 1\n    \n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.45\n</confidence>", "token_logprobs": [-0.00010895135346800089, -1.0728830375228426e-06, -3.576278118089249e-07, -0.04349903389811516, -0.005420392379164696, -2.3841855067985307e-07, -3.576214658096433e-05, -0.00013016807497479022, -7.152555099310121e-07, -0.009760748594999313, -0.014637463726103306, -0.01966562494