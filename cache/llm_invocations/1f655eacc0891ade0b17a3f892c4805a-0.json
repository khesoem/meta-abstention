t;\n    ans = (ans + norm(tot - x)) % MOD2;\n    for (int d = 0; d <= 9; ++d)\n        solve(x * 10 + d);\n}\n\nint main() {\n    std::cin >> n;\n    build(0, 0);\n    for (int i = 0; i <= 7; ++i)\n        std::sort(vec[i].begin(), vec[i].end());\n    tot = 0;\n    for (int x = 1; x <= 9; ++x)\n        solve(x);\n    std::cout << ans << std::endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD1 = 998244353\nMOD2 = 1000000007\nBASE = 1000000\n\nn = 0\ntot = 0\nsum_vals = [0] * 15\nans = 0\nvec = [[] for _ in range(15)]\n\ndef norm(v):\n    return v % MOD1\n\ndef build(k, num):\n    global tot\n    if k == 7:\n        return\n    tot += 1\n    back = norm(tot - num)\n    vec[k].append(back)\n    sum_vals[k] = (sum_vals[k] + back) % MOD2\n    for d in range(10):\n        build(k + 1, num * 10 + d)\n\ndef solve(x):\n    global tot, ans\n    if x > n:\n        return\n    if x * BASE + BASE - 1 <= n and x * BASE * 10 > n:\n        now = tot\n        for i in range(7):\n            mul = 10 ** i\n            sz = len(vec[i])\n            diff = norm(now - x * mul)\n            pos = bisect.bisect_left(vec[i], MOD1 - diff)\n            ans = (ans + diff * sz + sum_vals[i]) % MOD2\n            ans = (ans - ((MOD1 * (sz - pos)) % MOD2) + MOD2) % MOD2\n            tot += sz\n        return\n    tot += 1\n    ans = (ans + norm(tot - x)) % MOD2\n    for d in range(10):\n        solve(x * 10 + d)\n\ndef main():\n    global n, tot, ans\n    n = int(sys.stdin.readline().strip())\n    build(0, 0)\n    for i in range(8):\n        vec[i].sort()\n    tot = 0\n    ans = 0\n    for x in range(1, 10):\n        solve(x)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00020776021119672805, 0.0, -3.576278118089249e-07, -0.00016568719