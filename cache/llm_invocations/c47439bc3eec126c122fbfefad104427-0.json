].cost;\n                    if (!used[y]) {\n                        used[y] = true;\n                        q.addLast(y);\n                    }\n                }\n            }\n        }\n        return dist[sink] < INF;\n    }\n\n    static int augment(int x, int flow) {\n        if (x == src) return flow;\n        used[x] = true;\n        int rem = flow;\n        for (int e = head[x]; e != 0; e = edges[e].nxt) {\n            int y = edges[e].to;\n            if (used[y] || edges[e ^ 1].cap == 0 || dist[x] < dist[y] + edges[e ^ 1].cost) continue;\n            int got = augment(y, Math.min(rem, edges[e ^ 1].cap));\n            if (got > 0) {\n                rem -= got;\n                edges[e ^ 1].cap -= got;\n                edges[e].cap += got;\n                if (rem == 0) break;\n            }\n        }\n        return flow - rem;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        for (int i = 1; i <= k; ++i) {\n            int x = sc.nextInt();\n            ++people[x];\n        }\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j <= k + m + 2; ++j) {\n                id[i][j] = ++nodeCnt;\n                if (i == 1) addEdge(id[i][j], sink, c * (j - 1), INF);\n                if (j > 1) addEdge(id[i][j - 1], id[i][j], 0, INF);\n            }\n            if (people[i] > 0) addEdge(src, id[i][1], 0, people[i]);\n        }\n        for (int i = 1; i <= m; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 1; j <= k + m + 1; ++j) {\n                for (int cost = 1; cost <= 2 * k - 1; cost += 2) {\n                    addEdge(id[a][j], id[b][j + 1], cost * d, 1);\n                    addEdge(id[b][j], id[a][j + 1], cost * d, 1);\n                }\n            }\n        }\n        int sent = 0;\n        while (spfa()) {\n            int add = -1;\n            while (add != 0) {\n                Arrays.fill(used, false);\n                add = augment(sink, INF);\n                sent += add;\n                answer += dist[sink] * add;\n            }\n        }\n        // assert(sent == k); // optional check\n        System.out.println(answer);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.519237674889155e-05, 0.0, -1.1920928244535389e-07, -0.00010489867418073118, -0.0001618731184862554, -1.1920928244535389e-07, -0.0002613918040879071, -0.006024653557687998, -0.0025895654689520597, -3.576278118089249e-07, -0.00776463421061635, -0.011052694171667099, -0.0007110689766705036, -0.030285224318504333, -0.20151488482952118, -1.1920928244535389e-07, -4.541770613286644e-05, -6.9141146923357155e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.966933996300213e-05, -3.302042750874534e-05, 0.0, -1.0728830375228426e-06, -2.264974000354414e-06, 0.0, -2.861018856492592e-06, -2.0265558760002023e-06, 0.0, -5.006777428206988e-06, -2.3841855067985307e-07, -4.768360213347478e-06, 0.0, 0.0, -0.00043132537393830717, 0.0, -1.311301275563892e-06, -2.9802276912960224e-06, -1.1920928244535389e-07, -1.1920922133867862e-06, -2.0265558760002023e-06, 0.0, -4.768370445162873e-07, -1.0728830375228426e-06, 0.0, -5.960462772236497e-07, 0.0, -0.00017212340026162565, 0.0, -1.2993727978027891e-05, -2.622600959512056e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -2.264974000354414e-06, -2.0861407392658293e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -1.6927575416048057e-05, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -4.529942543740617e-06, -3.576278118089249e-07, -1.1920928244535389e-07, -0.0003965306677855551, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, 0.0, -1.2040065485052764e-