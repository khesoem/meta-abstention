emp //= K\n    bit = len(digits)\n    # If n == 0, digits is empty, bit = 0\n    # Reverse to most significant first\n    digits.reverse()\n\n    # Precompute two matrices\n    two = [None] * (bit + 1)  # index from 1 to bit\n    if bit >= 1:\n        two[1] = mat_identity(r)\n        for i in range(1, K + 1):\n            two[1] = mat_mul(one[i], two[1])\n\n    for i in range(2, bit + 1):\n        two[i] = mat_identity(r)\n        for j in range(K):\n            temp = mat_mul(rotr[j], two[i - 1])\n            temp = mat_mul(temp, rotc[j])\n            two[i] = mat_mul(temp, two[i])\n\n    # Main computation\n    ret = mat_identity(r)\n    ps = 0\n    for i in range(bit):\n        d = digits[i]\n        if i == bit - 1:\n            for _ in range(d):\n                ret = mat_mul(one[ps % K + 1], ret)\n                ps += 1\n        else:\n            for _ in range(d):\n                temp = mat_mul(rotr[ps % K], two[bit - i - 1])\n                temp = mat_mul(temp, rotc[ps % K])\n                ret = mat_mul(temp, ret)\n                ps += 1\n\n    res = 1\n    for i in range(1, K + 1):\n        res = (res + ret[i][0]) % MOD\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.4638240878121e-06, 0.0, 0.0, -0.0009168949909508228, -0.2973159849643707, -2.8729025871143676e-05, -0.00862350407987833, -0.19694837927818298, -1.1920928244535389e-07, -3.576278118089249e-07, -1.0847986231965479e-05, 0.0, -2.3841855067985307e-07, 0.0, -0.1003250926733017, -0.0004096384218428284, -0.09316310286521912, -0.4831629991531372, 0.0, -0.0015028145862743258, -2.9802276912960224e-06, -1.1920928244535389e-07, -0.5760555267333984, -5.960462772236497e-07, -0.8473479151725769, -0.28682824969291687, -0.000490068516228348, -0.6045658588409424, -1.1920922133867862e-06, -0.4372001588344574, -0.0001294529065489769, -0.0006079017766751349, -0.13095860183238983, 0.0, -0.20754264295101166, -2.98022769