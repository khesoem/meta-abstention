rce] = true;\n\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inQueue[u] = false;\n\n        for (int i = adjList[u]; i; i = graph[i].nextEdge) {\n            int v = graph[i].dest, w = graph[i].weight;\n            if (graph[i].capacity > 0 && dist[v] > dist[u] + w) {\n                dist[v] = dist[u] + w;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return dist[sink] != INF;\n}\n\nint augment(int u, int flow, bool visited[]) {\n    if (u == sink) return flow;\n    visited[u] = true;\n    int pushed = 0, remaining = flow;\n\n    for (int i = adjList[u]; i; i = graph[i].nextEdge) {\n        int v = graph[i].dest, cap = graph[i].capacity;\n        if (visited[v] || cap == 0 || dist[v] != dist[u] + graph[i].weight) continue;\n        int f = augment(v, min(remaining, cap), visited);\n        if (f > 0) {\n            remaining -= f;\n            graph[i].capacity -= f;\n            graph[i ^ 1].capacity += f;\n            pushed += f;\n            if (remaining == 0) break;\n        }\n    }\n    return pushed;\n}\n\nint computeMinCost() {\n    int totalCost = 0;\n    while (findShortestPath()) {\n        bool visited[MAXN] = {false};\n        int flow = augment(source, INF, visited);\n        if (flow > 0) totalCost += flow * dist[sink];\n    }\n    return totalCost;\n}\n\nint main() {\n    readInt(n); readInt(m); readInt(k); readInt(v1); readInt(v2);\n    sink = getIdx(n, 110, n) + 1;\n\n    for (int i = 2; i <= 110; ++i)\n        insertEdge(getIdx(1, i, n), sink, INF, 0);\n\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 110; ++j)\n            insertEdge(getIdx(i, j, n), getIdx(i, j + 1, n), INF, v1);\n\n    for (int i = 1, x; i <= k; ++i) {\n        readInt(x);\n        insertEdge(source, getIdx(x, 1, n), 1, 0);\n    }\n\n    for (int i = 1; i <= m; ++i) {\n        int x, y;\n        readInt(x); readInt(y)