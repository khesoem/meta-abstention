from collections import deque\n\ndef inside(x, y, n):\n    return 0 <= x < n and 0 <= y < n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    nau = [['']*n for _ in range(n)]\n    pom = [['']*n for _ in range(n)]\n    for i in range(n):\n        row = next(it)\n        for j, ch in enumerate(row):\n            nau[i][j] = ch\n    for i in range(n):\n        row = next(it)\n        for j, ch in enumerate(row):\n            pom[i][j] = ch\n\n    # BFS distances from start 'Z'\n    odl = [[1000]*n for _ in range(n)]\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if nau[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n\n    dx = [-1, 0, 1, 0, 0]\n    dy = [0, 1, 0, -1, 0]\n\n    q = deque()\n    odl[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx, ny = x + dx[d], y + dy[d]\n            if inside(nx, ny, n) and nau[nx][ny].isdigit() and odl[nx][ny] == 1000:\n                odl[nx][ny] = odl[x][y] + 1\n                q.append((nx, ny))\n\n    # moge: 5D boolean array (time, from_x, from_y, to_x, to_y)\n    # allocate full 10 for each dimension as original code uses fixed size\n    moge = [[[[[False]*10 for _ in range(10)] for _ in range(10)] for _ in range(10)] for _ in range(60)]\n\n    # initialize moge[0] with adjacent moves (including staying)\n    for i in range(n):\n        for j in range(n):\n            if not nau[i][j].isdigit():\n                continue\n            for d in range(5):\n                ni, nj = i + dx[d], j + dy[d]\n                if inside(ni, nj, n) and nau[ni][nj].isdigit():\n                    moge[0][i][j][ni][nj] = True\n\n    # propagate moge for k = 0 .. t-2\n    for k in range(t-1):  # k from 0 to t-2 inclusive\n        for i in range(n):\n            for j in range(n):\n                if not nau[i][j].isdigit():\n                    continue\n                for l in range(n):\n                    for m in range(n):\n                        if not moge[k][i][j][l][m]:\n                            continue\n                        for d in range(5):\n                            nl, nm = l + dx[d], m + dy[d]\n                            if inside(nl, nm, n) and nau[nl][nm].isdigit() and odl[l][m] >= k+2 and odl[nl][nm] >= k+2:\n                                moge[k+1][i][j][nl][nm] = True\n\n    # collect digit positions\n    a = []\n    for i in range(n):\n        for j in range(n):\n            if nau[i][j].isdigit():\n                a.append((i, j))\n\n    V = 2 * len(a) + 2\n    G = [[] for _ in range(V)]\n\n    def add_edge(u, v, cap):\n        G[u].append([v, cap, len(G[v])])\n        G[v].append([u, 0, len(G[u]) - 1])\n\n    # source (0) to left nodes (1..len(a))\n    for idx, (x, y) in enumerate(a):\n        cap1 = int(nau[x][y])\n        add_edge(0, idx + 1, cap1)\n        cap2 = int(pom[x][y])\n        add_edge(len(a) + 1 + idx, V - 1, cap2)\n\n    # middle edges: left to right if reachable within t steps\n    for i, (xi, yi) in enumerate(a):\n        for j, (xj, yj) in enumerate(a):\n            reach = False\n            for k in range(t):  # k from 0 to t-1\n                if moge[k][xi][yi][xj][yj]:\n                    reach = True\n                    break\n            if reach:\n                add_edge(i + 1, len(a) + 1 + j, 1000)\n\n    # max flow (Edmonds-Karp)\n    flow = 0\n    while True:\n        vis = [False] * V\n        par = [-1] * V\n        par_edge = [-1] * V\n        q = deque()\n        vis[0] = True\n        q.append(0)\n        while q:\n            u = q.popleft()\n            for idx, e in enumerate(G[u]):\n                v, cap, _ = e\n                if not vis[v] and cap > 0:\n                    vis[v] = True\n                    par[v] = u\n                    par_edge[v] =