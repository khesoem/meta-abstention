amples": [{"content": "```cpp\n#include <iostream>\n#include <vector>\n#include <cmath>\n#include <iomanip>\n#include <string>\n#include <sstream>\n#include <algorithm>\n\nusing namespace std;\n\nconst double EPS = 1e-9;\n\nbool eq(double a, double b) { return fabs(a - b) < EPS; }\nbool leq(double a, double b) { return a - EPS < b; }\nbool geq(double a, double b) { return a + EPS > b; }\n\nstruct Vec {\n    double x, y;\n    Vec(double x = 0, double y = 0) : x(x), y(y) {}\n    Vec add(const Vec& o) const { return Vec(x + o.x, y + o.y); }\n    Vec sub(const Vec& o) const { return Vec(x - o.x, y - o.y); }\n    Vec scale(double s) const { return Vec(x * s, y * s); }\n    double dot(const Vec& o) const { return x * o.x + y * o.y; }\n    double cross(const Vec& o) const { return x * o.y - y * o.x; }\n    double mag2() const { return dot(*this); }\n    double mag() const { return sqrt(mag2()); }\n    Vec unit() const { return scale(1.0 / mag()); }\n    Vec rot90() const { return Vec(-y, x); }\n    Vec rot270() const { return Vec(y, -x); }\n    Vec rotate(double theta) const {\n        double PI = acos(-1.0);\n        double newX = x * cos(theta) + y * cos(PI / 2 + theta);\n        double newY = x * sin(theta) + y * sin(PI / 2 + theta);\n        return Vec(newX, newY);\n    }\n    double angle() const {\n        double a = atan2(y, x);\n        if (a < 0) a += 2 * acos(-1.0);\n        return a;\n    }\n    bool operator==(const Vec& o) const {\n        return eq(x, o.x) && eq(y, o.y);\n    }\n};\n\nstruct Circle {\n    Vec c;\n    double r;\n    Circle(const Vec& c, double r) : c(c), r(r) {}\n    bool contains(const Vec& v) const {\n        return c.sub(v).mag2() - EPS * EPS <= r * r;\n    }\n    vector<Vec> intersect(const Circle& o) const {\n        if (c == o.c) return {};\n        Vec dir = o.c.sub(c);\n        double d2 = dir.mag2();\n        double d = sqrt(d2);\n        if (r + o.r < d || r + d < o.r || o.r + d < r)\n            return {};\n        if (eq(r + o.r, d) || eq(o.r + d, r))\n            return {c.add(dir.scale(r / d))};\n        if (eq(r + d, o.r))\n            return {c.sub(dir.scale(r / d))};\n        double d1 = (r * r + d2 - o.r * o.r) / (2.0 * d);\n        double h = sqrt(r * r - d1 * d1);\n        Vec unitDir = dir.unit();\n        Vec rInt = c.add(unitDir.scale(d1).add(unitDir.rot270().scale(h)));\n        Vec lInt = c.add(unitDir.scale(d1).add(unitDir.rot90().scale(h)));\n        return {rInt, lInt};\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    vector<Circle> circ;\n    for (int i = 0; i < n; ++i) {\n        int x, y, r;\n        cin >> x >> y >> r;\n        circ.emplace_back(Vec(x, y), r);\n    }\n\n    vector<Vec> points;\n    vector<int> par(n);\n    for (int i = 0; i < n; ++i) par[i] = i;\n    int res = 1;\n\n    for (int i = 0; i < n; ++i) {\n        vector<Vec> points2;\n        for (int j = 0; j < n; ++j) {\n            if (i == j) continue;\n            vector<Vec> arr = circ[i].intersect(circ[j]);\n            if (arr.empty()) continue;\n            int a = par[i];\n            a = par[i] = par[a];\n            int b = par[j];\n            b = par[j] = par[b];\n            par[a] = b;\n            for (const Vec& e : arr) {\n                bool found = false;\n                for (const Vec& e2 : points2) {\n                    if (e == e2) { found = true; break; }\n                }\n                if (!found) points2.push_back(e);\n            }\n        }\n        res += points2.size();\n        for (const Vec& e : points2) {\n            bool found = false;\n            for (const Vec& e2 : points) {\n                if (e == e2) { found = true; break; }\n            }\n            if (!found) points.push_back(e);\n        }\n    }\n\n    res -= points.size();\n    int cnt = 0;\n    for (int i = 0; i < n; ++i) if (par[i] == i) ++cnt;\n    res += cnt;\n    cout << res << endl;\n\n    return 0;\n}\n```", "token_logpro