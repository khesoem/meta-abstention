r - now) % MOD1) % MOD2\n    counter += 1\n    for i in range(10):\n        precompute(dep + 1, now * 10 + i)\n\ndef solve(dep, now):\n    global counter2, result\n    if now > n:\n        return\n    if now * 1000000 + 999999 <= n and now * 10000000 > n:\n        for i in range(7):\n            st = (counter2 + 1 - now * fastPow(10, i, MOD1)) % MOD1\n            pos = bisect.bisect_left(prefixData[i], (MOD1 - st) % MOD1)\n            result = (result + prefixSum[i] + st * prefixSize[i] - MOD1 * (prefixSize[i] - pos)) % MOD2\n        counter2 += counter\n        return\n    counter2 += 1\n    result = (result + ((counter2 - now) % MOD1 + MOD1) % MOD1) % MOD2\n    for i in range(10):\n        if dep == 0 and i == 0:\n            continue\n        solve(dep + 1, now * 10 + i)\n\ndef main():\n    global n, counter2, result\n    n = int(sys.stdin.readline().strip())\n    precompute(0, 0)\n    for i in range(7):\n        prefixData[i].sort()\n        prefixSize[i] = len(prefixData[i])\n    solve(0, 0)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-0.31433144211769104, -1.1920928244535389e-07, -5.411955135059543e-05, -4.6491513785440475e-06, -7.664863369427621e-05, -0.0003387354372534901, -0.002476840978488326, -0.47407758235931396, -1.4305104514278355e-06, -0.011047860607504845, -4.768370445162873e-07, 0.0, -0.0005566716426983476, -0.09307089447975159, -5.960462772236497e-07, -5.006777428206988e-06, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.099436753473128e-06, 0.0, 0.0, -1.311301275563892e-06, -0.0015041239093989134, -0.6701769232749939, -7.390948667307384e-06, -0.0019328974885866046, -5.960462772236497e-07, -2.145764938177308e-06, -8.4638240878121e-06, -1.9073468138230965e-06, -6.318072337307967e-06, -5.1973900554003194e-05, -3.731181277544238e-05, -0.000556314189452678, -0.00020930961181875318, 0.0, -3.814689989667386e-06