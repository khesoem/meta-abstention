;\n        exp >>= 1;\n    }\n    return result;\n}\n\nvoid init_matrix(int size) {\n    dim = size;\n    for (int i = 0; i < dim; ++i)\n        identity.mat[i][i] = 1;\n}\n\nvoid read_ll(ll& x) {\n    int sign = 1;\n    char c;\n    while (((c = getchar()) < '0' || c > '9') && c != '-');\n    if (c == '-') sign = -1, x = 0;\n    else x = c - '0';\n    while ((c = getchar()) >= '0' && c <= '9') x = x * 10 + c - '0';\n    x *= sign;\n}\n\nvoid read_int(int& x) {\n    ll t; read_ll(t); x = t;\n}\n\nint digits[128];\nint digit_count;\n\nMatrix transform(const Matrix& M, int shift) {\n    Matrix res;\n    for (int i = 0; i < dim; ++i)\n        for (int j = 0; j < dim; ++j) {\n            int ni = (i == dim - 1) ? (dim - 1) : ((i + shift) % (dim - 1));\n            int nj = (j == dim - 1) ? (dim - 1) : ((j + shift) % (dim - 1));\n            res.mat[ni][nj] = M.mat[i][j];\n        }\n    return res;\n}\n\nint main() {\n    ll n;\n    int k;\n    read_ll(n); read_int(k);\n    init_matrix(k + 1);\n    \n    digit_count = 0;\n    while (n) {\n        digits[digit_count++] = n % k;\n        n /= k;\n    }\n    \n    vector<Matrix> A(digit_count);\n    \n    for (int j = 0; j <= k; ++j) {\n        A[0].mat[0][j] = 1;\n        A[0].mat[j][j] = 1;\n    }\n    \n    for (int i = 1; i < digit_count; ++i) {\n        Matrix cur = identity;\n        for (int j = 0; j < k; ++j)\n            cur = multiply(cur, transform(A[i-1], j));\n        A[i] = cur;\n    }\n    \n    int shift = 0;\n    Matrix result = identity;\n    for (int i = digit_count - 1; i >= 0; --i) {\n        for (int j = 0; j < digits[i]; ++j)\n            result = multiply(result, transform(A[i], (j + shift) % k));\n        shift = (shift + digits[i]) % k;\n    }\n    \n    int answer = 0;\n    for (int i = 0; i <= k; ++i)\n        answer = (answer + (int)(result.mat[i][k] % MOD)) % MOD;\n    printf(\"%d\\n\", answer);\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "mod