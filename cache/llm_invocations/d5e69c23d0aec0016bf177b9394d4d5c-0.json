='9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        if (t<m) for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static int n, m, vn;\n    static int[] from, flow;\n    static ArrayList<HashMap<Integer, Integer>> edge;\n    static int[][] tox;\n    static char[][] buf;\n    static final int[] dx = {-1, 0, 1, 0};\n    static final int[] dy = {0, -1, 0, 1};\n\n    static int enc(int x, int y, int t) {\n        return x + y * n + t * n * n + 2;\n    }\n\n    static int aug(int s, int t, int cap) {\n        int result = 0;\n        while (true) {\n            Arrays.fill(from, -1);\n            from[s] = s;\n            flow[s] = cap;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            boolean found = false;\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                if (x == t) {\n                    int f = flow[t];\n                    for (int v = t; v != s; v = from[v]) {\n                        int u = from[v];\n                        int oldCap = edge.get(u).get(v);\n                        edge.get(u).put(v, oldCap - f);\n                        int revCap = edge.get(v).getOrDefault(u, 0);\n                        edge.get(v).put(u, revCap + f);\n                    }\n                    result += f;\n                    found = true;\n                    break;\n                }\n                for (Map.Entry<Integer, Integer> e : edge.get(x).entrySet()) {\n                    int v = e.getKey();\n                    int c = e.getValue();\n                    if (c >= cap && from[v] == -1) {\n                        from[v] = x;\n                        flow[v] = Math.min(c, flow[x]);\n                        q.add(v);\n                    }\n                }\n            }\n            if (!found) break;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        vn = enc(n - 1, n - 1, m) + 1;\n        from = new int[vn];\n        flow = new int[vn];\n        edge = new ArrayList<>(vn);\n        for (int i = 0; i < vn; i++) {\n            edge.add(new HashMap<>());\n        }\n\n        // Read first grid and add source edges\n        char[][] firstGrid = new char[n][n];\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            firstGrid[i] = s.toCharArray();\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                char c = firstGrid[i][j];\n                if (c > '0' && c <= '9') {\n                    int u = 0;\n                    int v = enc(i, j, 0);\n                    int cap = c - '0';\n                    edge.get(u).put(v, cap);\n                    edge.get(v).put(u, 0);\n                }\n            }\n        }\n\n        // Read second grid\n        buf = new char[n][n];\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            buf[i] = s.toCharArray();\n        }\n\n        // Compute tox distances\n        tox = new int[n][n];\n        Queue<int[]> bfs = new LinkedList<>();\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (buf[i][j] == 'Z') {\n                    tox[i][j] = 0;\n                    bfs.add(new int[]{i, j});\n                } else {\n                    tox[i][j] = m + 1;\n                }\n            }\n        }\n        while (!bfs.isEmpty()) {\n            int[] cur = bfs.poll();\n            int t = tox[cur[0]][cur[1]];\n            for (int d = 0; d < 4; d++) {\n                int x = cur[0] + dx[d];\n                int y = cur[1] + dy[d];\n                if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y' && t + 1 < tox[x][y]) {\n                    tox[x][y] = t + 1;\n                    bfs.add(new int[]{x, y});\n                }\n            }\n        }\n\n        // Add edges for time steps\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                for (int t = 0; t < m; t++) {\n                    // Move edges\n                    for (int d = 0; d < 4; d++) {\n                        int x = i + dx[d];\n                        int y = j + dy[d];\n                        if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y') {\n                            int extra = (buf[x][y] > '0' && buf[x][y] <= '9') ? 1 : 0;\n                            if (t + 1 < tox[x][y] + extra && t < tox[i][j]) {\n                                int u = enc(i, j, t);\n                                int v = enc(x, y, t + 1);\n                                edge.get(u).put(v, 1000);\n                                edge.get(v).put(u, 0);\n                            }\n                        }\n                    }\n                    // Digit edges to final time\n                    if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                        int u = enc(i, j, t);\n                        int v = enc(i, j, m);\n                        int cap = buf[i][j] - '0';\n                        edge.get(u).put(v, cap);\n                        edge.get(v).put(u, 0);\n                    }\n                }\n                // Final time to sink\n                if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                    int u = enc(i, j, m);\n                    int v = 1;\n                    int cap = buf[i][j] - '0';\n                    edge.get(u).put(v, cap);\n                    edge.get(v).put(u, 0);\n                }\n            }\n        }\n\n        int res = 0;\n        for (int u = 8; u > 0; u /= 2) {\n            res += aug(0, 1, u);\n        }\n        System.out.println(res);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.622600959512056e-06, 0.0, 0.0, -4.935142715112306e-05, -0.00011097769311163574, 0.0, -1.2993727978027891e-05, -0.0012493670219555497, -7.795983401592821e-05, 0.0, -3.075552376685664e-05, -0.0015034097013995051, -1.168244216387393e-05, -0.000266278104390949, -3.397406908334233e-05, -1.4305104514278355e-06, -0.00011789103882620111, 0.0, -0.0031802100129425526, -1.9073468138230965e-06, 0.0, -6.556489552167477e-06, 0.0, -1.1920928244535389e-07, -0.10033425688743591, -1.0490362910786644e-05, -1.4305104514278355e-06, -0.029810240492224693, -3.576278118089249e-07, -7.986990567587782e-06, 0.0, -1.0728830375228426e-06, -0.006905