k = Main.Task()\n        task.solve(sc, pw)\n        \n        Main.TIME_END = time.time()\n        usedMemoryAfter = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n        \n        pw.flush()\n        \n        print(f\"Memory increased: {(usedMemoryAfter - usedMemoryBefore) / 1000000}\", file=sys.stderr)\n        print(f\"Time used: {int((Main.TIME_END - Main.TIME_START) * 1000)} ms.\", file=sys.stderr)\n\nclass Scanner:\n    def __init__(self, input_stream):\n        self.input_stream = input_stream\n        self.tokenizer = None\n    \n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            line = self.input_stream.readline()\n            if not line:\n                raise EOFError(\"No more input\")\n            self.tokenizer = line.strip().split()\n        return self.tokenizer.pop(0)\n    \n    def nextInt(self):\n        return int(self.next())\n    \n    def nextLong(self):\n        return int(self.next())  # Python int handles arbitrary precision\n    \n    def nextDouble(self):\n        return float(self.next())\n    \n    def nextLine(self):\n        return self.input_stream.readline().strip()\n\nif __name__ == \"__main__\":\n    Main.main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.178694017464295e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -0.041432999074459076, -0.03377993032336235, -1.0728830375228426e-06, -0.01105104386806488, -0.04159344732761383, -0.22544240951538086, -0.02325255051255226, -0.9357783198356628, -3.576278118089249e-07, -0.01036345586180687, -0.031008025631308556, -0.6824201345443726, -0.6345294117927551, -3.6477376852417365e-05, -8.570780482841656e-05, -0.31349867582321167, -9.63164638960734e-05, -1.0728830375228426e-06, -9.179073458653875e-06, -0.1637391299009323, -1.1920928244535389e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576272320060525e-06, -3.576278118089249e-07, -1.6212332411669195e-05, -4.8040