{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following PyPy 3 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original PyPy 3 code you have to translate:\n<original_code>\nimport sys\ninput = sys.stdin.readline\n\ndef init_seg(n):\n    sz = 1\n    while sz < n:\n        sz *= 2\n    return [0] * (2 * sz)\n\ndef seg_upd(tree, i, v):\n    p = i + len(tree) // 2\n    tree[p] = v\n    p //= 2\n    while p:\n        tree[p] = tree[2 * p] + tree[2 * p + 1]\n        p //= 2\n\ndef seg_qry(tree, a, b):\n    a += len(tree) // 2\n    b += len(tree) // 2\n    s = 0\n    while a <= b:\n        if a % 2 == 1:\n            s += tree[a]\n            a += 1\n        if b % 2 == 0:\n            s += tree[b]\n            b -= 1\n        a //= 2\n        b //= 2\n    return s\n\ndef factor(n):\n    res = []\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            res.append(d)\n            n //= d\n        d += 1\n    if n > 1:\n        res.append(n)\n    return res\n\ndef phi(n):\n    ps = set(factor(n))\n    x = n\n    for p in ps:\n        x = x // p * (p - 1)\n    return x\n\ndef prod_mod(a, b, m):\n    r = 1\n    for i in range(a + 1, b + 1):\n        r = (r * i) % m\n    return r\n\nn, mod = map(int, input().split())\nphi_n = phi(mod)\nL = n + 5\nfacts = [1] * (L + 1)\nfor i in range(1, L + 1):\n    facts[i] = (i * facts[i - 1]) % mod\n\nif n <= 3:\n    print(0)\nelse:\n    dp = [0] * 2000\n    dp[0], dp[1], dp[2], dp[3] = 1, 2, 2, 1\n    seg = init_seg(2005)\n    for i in range(4):\n        seg_upd(seg, i, dp[i])\n    mx = 3\n    ans = 0\n    for it in range(n - 3):\n        prev = dp[:]\n        tmp = 0\n        for j in range(it + 3):\n            for k in range(1, mx + 2):\n                cnt = seg_qry(seg, j + k + 1, 2004)\n                tmp = (tmp + cnt * prev[k - 1]) % mod\n                dp[j + k] = (dp[j + k] + prev[k - 1]) % mod\n                seg_upd(seg, j + k, dp[j + k])\n        mx += it + 3\n        p = prod_mod(it + 3, n, mod)\n        ans = (ans + p * tmp) % mod\n    print(ans)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <set>\n#include <cmath>\nusing namespace std;\n\nvector<int> factor(int n) {\n    vector<int> res;\n    int d = 2;\n    while (d * d <= n) {\n        while (n % d == 0) {\n            res.push_back(d);\n            n /= d;\n        }\n        d++;\n    }\n    if (n > 1) {\n        res.push_back(n);\n    }\n    return res;\n}\n\nint phi(int n) {\n    vector<int> ps_vec = factor(n);\n    set<int> ps(ps_vec.begin(), ps_vec.end());\n    int x = n;\n    for (int p : ps) {\n        x = x / p * (p - 1);\n    }\n    return x;\n}\n\nlong long prod_mod(int a, int b, int m) {\n    long long r = 1;\n    for (int i = a + 1; i <= b; i++) {\n        r = (r * i) % m;\n    }\n    return r;\n}\n\nvector<int> init_seg(int n) {\n    int sz = 1;\n    while (sz < n) {\n        sz *= 2;\n    }\n    return vector<int>(2 * sz, 0);\n}\n\nvoid seg_upd(vector<int>& tree, int i, int v) {\n    int p = i + tree.size() / 2;\n    tree[p] = v;\n    p /= 2;\n    while (p) {\n        tree[p] = tree[2 * p] + tree[2 * p + 1];\n        p /= 2;\n    }\n}\n\nint seg_qry(vector<int>& tree, int a, int b) {\n    a += tree.size() / 2;\n    b += tree.size() / 2;\n    long long s = 0;\n    while (a <= b) {\n        if (a % 2 == 1) {\n            s += tree[a];\n            a += 1;\n        }\n        if (b % 2 == 0) {\n            s += tree[b];\n            b -= 1;\n        }\n        a /= 2;\n        b /= 2;\n    }\n    return (int)s;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, mod;\n    cin >> n >> mod;\n\n    int phi_n = phi(mod);\n    int L = n + 5;\n    vector<long long> facts(L + 1, 1);\n    for (int i = 1; i <= L; i++) {\n        facts[i] = (i * facts[i - 1]) % mod;\n    }\n\n    if (n <= 3) {\n        cout << 0 << endl;\n    } else {\n        vector<int> dp(2000, 0);\n        dp[0] = 1;\n        dp[1] = 2;\n        dp[2] = 2;\n        dp[3] = 1;\n        vector<int> seg = init_seg(2005);\n        for (int i = 0; i < 4; i++) {\n            seg_upd(seg, i, dp[i]);\n        }\n        int mx = 3;\n        long long ans = 0;\n        for (int it = 0; it < n - 3; it++) {\n            vector<int> prev = dp;\n            long long tmp = 0;\n            for (int j = 0; j < it + 3; j++) {\n                for (int k = 1; k < mx + 2; k++) {\n                    int cnt = seg_qry(seg, j + k + 1, 2004);\n                    tmp = (tmp + (long long)cnt * prev[k - 1]) % mod;\n                    dp[j + k] = (dp[j + k] + prev[k - 1]) % mod;\n                    seg_upd(seg, j + k, dp[j + k]);\n                }\n            }\n            mx += it + 3;\n            long long p = prod_mod(it + 3, n, mod);\n            ans = (ans + p * tmp) % mod;\n        }\n        cout << ans << endl;\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.199982064776123e-05, -2.50339189733495e-06, -4.768370445162873e-07, -0.0002790300059132278, 0.0, -0.0003924791526515037, -2.622600959512056e-06, -2.3841830625315197e-06, -2.3841855067985307e