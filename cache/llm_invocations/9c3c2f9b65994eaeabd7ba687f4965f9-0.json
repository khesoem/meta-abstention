n            else{\n                double temp, tempa, tempb;\n                diff(x,y,Math.floor(a),b,tempa,tempb);\n                temp = tempa/tempb;\n\n                if(temp < min){\n                    mina = (int)Math.floor(a);\n                    minb = b;\n                    min = temp;\n                }\n                else if (temp == min){\n                    if(Math.floor(a) < mina){\n                        mina = (int)Math.floor(a);\n                        minb = b;                   \n                    }\n                }\n                \n                diff(x,y,Math.ceil(a),b,tempa,tempb);        \n                temp = tempa/tempb;\n\n                if(temp < min){\n                    mina = (int)Math.ceil(a);\n                    minb = b;\n                    min = temp;\n                }\n                else if (temp == min){\n                    if(Math.ceil(a) < mina){\n                        mina = (int)Math.ceil(a);\n                        minb = b;                   \n                    }\n                }\n            }\n        }\n\n        int gc = gcd(mina, minb);\n        if (gc != 1){       \n            mina = mina/gc;\n            minb = minb/gc;\n        }\n\n        System.out.println(mina + \"/\" + minb);\n    }\n\n    public static int gcd(int x, int y){\n        int gcd;\n        if (x > y)\n            gcd = x;\n        else\n            gcd = y;\n\n        while (true){\n            if (x%gcd == 0 && y%gcd == 0)\n                break;\n            gcd--;\n        }\n        return gcd;\n    }\n\n    public static void diff(double x, double y, double a, double b, double &num, double &den){\n        num = x*b - y*a;\n        num = Math.abs(num);\n        den = y*b;  \n    }\n}\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.20250216126441956, -0.00018306261335965246, -0.04468121752142906, -0.062459830194711685, -0.0016351590165868402, -9.692185267340392e-05, -6.79516015