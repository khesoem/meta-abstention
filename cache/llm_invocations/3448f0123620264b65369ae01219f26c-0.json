t m = sc.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n        int half = n / 2 + n % 2; // ceil(n/2)\n        int otv = 0;\n\n        // Generate all subset sums modulo m for the first half\n        List<Integer> b = getSums(a, 0, half, m);\n        Collections.sort(b);\n\n        int secondHalfSize = n / 2;\n        for (int mask = 0; mask < (1 << secondHalfSize); mask++) {\n            int t = 0;\n            for (int bit = 0; bit < 20; bit++) {\n                if ((mask & (1 << bit)) != 0) {\n                    t = (t + a[half + bit]) % m;\n                }\n            }\n            t %= m;\n\n            int target = m - t - 1;\n            // Find rightmost index where b[idx] <= target\n            int idx = Collections.binarySearch(b, target);\n            if (idx < 0) {\n                idx = -idx - 2; // insertion point - 1\n            }\n            // idx is now the index of the largest element <= target, or -1 if none\n            int t2;\n            if (idx >= 0) {\n                t2 = b.get(idx);\n            } else {\n                t2 = b.get(0);\n            }\n            otv = Math.max(otv, (t + t2) % m);\n            otv = Math.max(otv, (t + b.get(b.size() - 1)) % m);\n        }\n\n        System.out.println(otv % m);\n        sc.close();\n    }\n\n    private static List<Integer> getSums(int[] a, int start, int cnt, int m) {\n        List<Integer> res = new ArrayList<>();\n        for (int mask = 0; mask < (1 << cnt); mask++) {\n            int total = 0;\n            for (int bit = 0; bit < 20; bit++) {\n                if ((mask & (1 << bit)) != 0) {\n                    total = (total + a[start + bit]) % m;\n                }\n            }\n            res.add(total % m);\n        }\n        return res;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.08806120604276657, -0.01859927363693714, -1.1920928244535389e-0