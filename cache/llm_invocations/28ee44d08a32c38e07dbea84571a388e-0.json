d)\n\t\t\t\tlist.add(i+1);\n\t\t}\n\t\tSystem.out.println(list.size());\n\t\tfor (int i : list)\n\t\t\tSystem.out.println(i);\n\t}\n\tstatic class Vector\n\t{\n\t\tint[] arr = new int[5];\n\t\tVector(int[] a, int[] b)\n\t\t{\n\t\t\tfor (int i = 0; i < 5; i++)\n\t\t\t{\n\t\t\t\tarr[i] = b[i]-a[i];\n\t\t\t}\n\t\t}\n\t\tdouble mag()\n\t\t{\n\t\t\tdouble sum = 0;\n\t\t\tfor (int i = 0; i < arr.length; i++)\n\t\t\t{\n\t\t\t\tsum += arr[i]*arr[i];\n\t\t\t}\n\t\t\treturn Math.sqrt(sum);\n\t\t}\n\t\tint prod(Vector v)\n\t\t{\n\t\t\tint sum = 0;\n\t\t\tfor (int i = 0; i < arr.length; i++)\n\t\t\t{\n\t\t\t\tsum += arr[i]*v.arr[i];\n\t\t\t}\n\t\t\treturn sum;\n\t\t}\n\t}\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "n = int(input())\nif n > 11:\n    print(0)\n    exit()\n\narr = [list(map(int, input().split())) for _ in range(n)]\n\nimport math\n\neps = 1e-9\n\nclass Vector:\n    def __init__(self, a, b):\n        self.arr = [b[i] - a[i] for i in range(5)]\n    \n    def mag(self):\n        return math.sqrt(sum(x * x for x in self.arr))\n    \n    def prod(self, v):\n        return sum(self.arr[i] * v.arr[i] for i in range(5))\n\nresult_list = []\n\nfor i in range(n):\n    good = True\n    for j in range(n):\n        if j == i:\n            continue\n        for k in range(j + 1, n):\n            if k == i:\n                continue\n            v1 = Vector(arr[i], arr[j])\n            v2 = Vector(arr[i], arr[k])\n            angle = math.acos(v1.prod(v2) / (v1.mag() * v2.mag()))\n            if angle < math.pi / 2 - eps:\n                good = False\n                break\n        if not good:\n            break\n    if good:\n        result_list.append(i + 1)\n\nprint(len(result_list))\nfor index in result_list:\n    print(index)\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.15828177332878113, -2.570319702499546e-05, -1.9361264946837764e-07