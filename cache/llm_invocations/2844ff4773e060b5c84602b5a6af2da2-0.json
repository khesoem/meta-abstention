t__(self, to, capacity, cost, rev):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.rev = rev\n\nclass MinCostMaxFlow:\n    def __init__(self):\n        self.V = 0\n        self.G = []\n\n    def init(self, n):\n        self.V = n\n        self.G = [[] for _ in range(n)]\n\n    def add_edge(self, from_, to, cap, cost):\n        self.G[from_].append(Edge(to, cap, cost, len(self.G[to])))\n        self.G[to].append(Edge(from_, 0, -cost, len(self.G[from_]) - 1))\n\n    def min_cost(self, s, t, f):\n        flow = 0\n        res = 0\n        H = [0] * self.V\n        dis = [0] * self.V\n        PreV = [0] * self.V\n        PreE = [0] * self.V\n\n        while f > 0:\n            q = []\n            for i in range(self.V):\n                dis[i] = float('inf')\n            dis[s] = 0\n            heapq.heappush(q, (0, s))\n            while q:\n                now_dist, v = heapq.heappop(q)\n                if dis[v] < now_dist:\n                    continue\n                for i, e in enumerate(self.G[v]):\n                    if e.capacity > 0 and dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]:\n                        dis[e.to] = dis[v] + e.cost + H[v] - H[e.to]\n                        PreV[e.to] = v\n                        PreE[e.to] = i\n                        heapq.heappush(q, (dis[e.to], e.to))\n            if dis[t] == float('inf'):\n                break\n            for i in range(self.V):\n                H[i] += dis[i]\n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[PreV[v]][PreE[v]].capacity)\n                v = PreV[v]\n            f -= d\n            flow += d\n            res += d * H[t]\n            v = t\n            while v != s:\n                e = self.G[PreV[v]][PreE[v]]\n                e.capacity -= d\n                self.G[v][e.rev].capacity += d\n                v = PreV[v]\n        return res\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n, m, k, c, d = map(int, data[:5])\n    idx = 5\n    mcmf = MinCostMaxFlow()\n    mcmf.init(n * (n + 55) + 2)\n    edges = []\n    for _ in range(k):\n        u = int(data[idx])\n        idx += 1\n        mcmf.add_edge(0, u, 1, 0)\n    for _ in range(m):\n        u = int(data[idx])\n        v = int(data[idx + 1])\n        idx += 2\n        edges.append((u, v))\n    tar = n * (n + 55) + 1\n    for t in range(n + 54):\n        for e in edges:\n            for j in range(1, k + 1):\n                mcmf.add_edge(e[0] + t * n, e[1] + (t + 1) * n, 1, c + d * (j * 2 - 1))\n                mcmf.add_edge(e[1] + t * n, e[0] + (t + 1) * n, 1, c + d * (j * 2 - 1))\n        for i in range(2, n + 1):\n            mcmf.add_edge(i + t * n, i + (t + 1) * n, k, c)\n        mcmf.add_edge(1 + t * n, tar, k, 0)\n    print(mcmf.min_cost(0, tar, k))\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00029601677670143545, -0.0009991057449951768, -2.696889623621246e-06, -1.9862216504407115e-05, -0.14708508551120758, -0.1128251776099205, -2.0219828002154827e-05, -0.0002222516923211515, -0.0003430912329349667, 0.0, -0.00044795009307563305, -0.027782578021287918, -0.03806088864803314, -1.7432603272027336e-06, -2.8325677703833207e-05, -1.1279553291387856e-05, -1.3856492842023727e-06, 0.0, 0.0, 0.0, -3.8889261304575484e-06, -3.054500666621607e-06, -0.003188524628058076, -0.002478273818269372, -1.2233183042553719e-05, -4.127333340875339e-06, -2.1008713702030946e-06, -1.6166903151315637e-05, -1.259079363080673e-05, -5.512236498361744e-07, -2.339278580620885e-06, 0.0, -7.941850526549388e-06, -1.3856492842023727e-06, -8.180258191714529e-06, -1.9361264946837764e-07, 0.0, -1.318681188422488e-05, -4.008129963040119e-06, -1.1472419600977446e-06, -1.9361264946837764e-07, -1.9361264946837764e-07, 0.0, -5.512236498361744e-07, -1.735893965815194e-05, -6.704273118884885e-07, 0.0, -4.320199877838604e-07, -1.93