nse": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class MinCostMaxFlow {\n    private static final int MX = 5500;\n    private static final long INF = 1000000007L;\n\n    private static class Edge {\n        int to, cost, rev, cap;\n        Edge(int to, int cost, int rev, int cap) {\n            this.to = to;\n            this.cost = cost;\n            this.rev = rev;\n            this.cap = cap;\n        }\n    }\n\n    private static class Pair {\n        long first;\n        int second;\n        Pair(long first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    private int n, m, k, c, d;\n    private int u, v, mx;\n    private int s, t, mf;\n    private int[] tr = new int[MX];\n    private long ans;\n    private long[] dis = new long[MX];\n    private ArrayList<Edge>[] adj = new ArrayList[MX];\n    private PriorityQueue<Pair> pq = new PriorityQueue<>(Comparator.comparingLong(p -> p.first));\n\n    private int at(int node, int time) {\n        return node + time * n;\n    }\n\n    private void addEdge(int u, int v, int cost, int cap) {\n        int szu = adj[u].size();\n        int szv = adj[v].size();\n        adj[u].add(new Edge(v, cost, szv, cap));\n        adj[v].add(new Edge(u, -cost, szu, 0));\n    }\n\n    private void dijkstra() {\n        Arrays.fill(dis, INF);\n        pq.clear();\n        pq.add(new Pair(0, s));\n        dis[s] = 0;\n        while (!pq.isEmpty()) {\n            Pair p = pq.poll();\n            long du = p.first;\n            int x = p.second;\n            if (du > dis[x]) continue;\n            for (Edge e : adj[x]) {\n                if (e.cap > 0 && dis[e.to] > du + e.cost) {\n                    tr[e.to] = e.rev;\n                    dis[e.to] = du + e.cost;\n                    pq.add(new Pair(dis[e.to], e.to));\n                }\n            }\n        }\n    }\n\n    private void trace() {\n        int aug = k;\n        int cur = t;\n        while (cur != s) {\n            Edge rev = adj[cur].get(tr[cur]);\n            int pre = rev.to;\n            int fwd = rev.rev;\n            aug = Math.min(aug, adj[pre].get(fwd).cap);\n            cur = pre;\n        }\n        mf += aug;\n        ans += aug * dis[t];\n        cur = t;\n        while (cur != s) {\n            Edge rev = adj[cur].get(tr[cur]);\n            int pre = rev.to;\n            int fwd = rev.rev;\n            rev.cap += aug;\n            adj[pre].get(fwd).cap -= aug;\n            cur = pre;\n        }\n    }\n\n    public void run() {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        s = MX - 2;\n        t = MX - 1;\n        mf = 0;\n        ans = 0;\n        mx = n + k;\n        for (int i = 0; i < MX; i++) {\n            adj[i] = new ArrayList<>();\n        }\n        for (int i = 0; i < k; i++) {\n            u = sc.nextInt();\n            addEdge(s, at(u, 0), 0, 1);\n        }\n        for (int i = 0; i <= mx; i++) {\n            addEdge(at(1, i), t, c * i, k);\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                addEdge(at(i, j), at(i, j + 1), 0, k);\n            }\n        }\n        while (m-- > 0) {\n            u = sc.nextInt();\n            v = sc.nextInt();\n            for (int i = 1; i <= k; i++) {\n                for (int j = 0; j < mx; j++) {\n                    addEdge(at(u, j), at(v, j + 1), d * (2 * i - 1), 1);\n                    addEdge(at(v, j), at(u, j + 1), d * (2 * i - 1), 1);\n                }\n            }\n        }\n        while (mf < k) {\n            dijkstra();\n            trace();\n        }\n        System.out.println(ans);\n        sc.close();\n    }\n\n    public static void main(String[] args) {\n        MinCostMaxFlow solver = new MinCostMaxFlow();\n        solver.run();\n    }\n}\n</translated_code>\n