      self.output.write(str(arg) + '\\n')\n            else:\n                self.output.write(str(arg) + '\\n')\n        else:\n            self.printArray(args)\n    \n    def printArray(self, arr):\n        for i, val in enumerate(arr):\n            if i > 0:\n                self.output.write(' ')\n            self.output.write(str(val))\n        self.output.write('\\n')\n    \n    def flush(self):\n        self.output.flush()\n\nclass Modulo:\n    def __init__(self, mod):\n        self.mod = mod\n    \n    def plus(self, a, b):\n        c = a + b\n        if c >= self.mod:\n            c -= self.mod\n        return c\n    \n    def minus(self, a, b):\n        c = a - b\n        if c < 0:\n            c += self.mod\n        return c\n    \n    def times(self, a, b):\n        return (a * b) % self.mod\n    \n    def div(self, a, b):\n        return self.times(a, self.pow(b, self.mod - 2))\n    \n    def pow(self, a, b):\n        c = 1\n        a = a % self.mod\n        while b > 0:\n            if b & 1:\n                c = (c * a) % self.mod\n            a = (a * a) % self.mod\n            b >>= 1\n        return c\n    \n    def combination(self, n, k):\n        return self.div(self.factorial(n), self.times(self.factorial(k), self.factorial(n - k)))\n    \n    def combination_with_factorials(self, n, k, factorials):\n        return self.div(factorials[n], self.times(factorials[k], factorials[n - k]))\n    \n    def factorial(self, n):\n        f = 1\n        for i in range(1, n + 1):\n            f = (f * i) % self.mod\n        return f\n    \n    def factorials(self, n):\n        f = [1] * (n + 1)\n        for i in range(1, n + 1):\n            f[i] = (f[i - 1] * i) % self.mod\n        return f\n\ndef main():\n    in_reader = FastReader()\n    out_writer = FastWriter()\n    \n    t = 1\n    for _ in range(t):\n        n = in_reader.nextInt()\n        kt = in_reader.nextLong()\n        \n        if kt >= n:\n            out_writer.println(0)\n            continue\n        \n        k = int(kt)\n        mod = Modulo(998244353)\n        facts = mod.factorials(n)\n        \n        ans = 0\n        c = n - k\n        for i in range(c + 1):\n            comb = mod.combination_with_factorials(c, i, facts)\n            power = mod.pow(c - i, n)\n            term = mod.times(comb, power)\n            if i % 2 == 0:\n                ans = mod.plus(ans, term)\n            else:\n                ans = mod.minus(ans, term)\n        \n        ans = mod.times(ans, mod.combination_with_factorials(n, n - k, facts))\n        \n        if k > 0:\n            ans = mod.times(ans, 2)\n        \n        out_writer.println(ans)\n    \n    out_writer.flush()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.953480184776708e-05, -1.311301275563892e-06, -3.576278118089249e-07, -0.0017335877055302262, -0.03393055126070976, -4.851700214203447e-05, -0.07899021357297897, -0.007590618450194597, -0.048594143241643906, -0.10021704435348511, -0.5243078470230103, -1.1920928244535389e-07, -0.00011753345461329445, -0.10668287426233292, -0.9322767853736877, -0.09162777662277222, -0.0002791491860989481, -0.6954845190048218, -0.00672754505649209, -0.18410615622997284, -1.1920928244535389e-07, -0.004806037526577711, -0.47661852836608887, -0.38689473271369934, -1.0382416248321533, -8.344646857949556e-07, -0.2756526470184326, -0.638484537601471, -0.03370270878076553, -0.12784059345722198, -2.658331868587993e-05, -5.125986263010418e-06, -4.768370445162873e-07, -3.576272320060525e-06, -5.6265202147187665e-05, -2.0265558760002023e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -0.008616176433861256, -2.8371408916427754e-05, -3.516612196108326e-05, -1.1114225387573242, -3.576272320060525e-06, -0.18414334952831268, -0.00195312371943146, -2.2053474822314456e-05, -0.06346499919891357, 0.0, -3.576278118089249e-07, 0.0, -0.8118966817855835, -1.0728830375228426e-06, -6.079655122448457e-06, -0