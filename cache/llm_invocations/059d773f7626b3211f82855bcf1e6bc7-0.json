{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = 1000000000LL;\n\nstruct MinCostMaxFlow {\n    struct Edge {\n        int to;\n        ll cap, flow, cost;\n    };\n\n    int n;\n    vector<vector<int>> adj;\n    vector<Edge> edges;\n    vector<ll> pot, dist;\n    vector<int> pv, pe;\n\n    MinCostMaxFlow(int n) : n(n), adj(n), pot(n, 0) {}\n\n    void add_edge(int v, int u, ll cap, ll cost) {\n        int id = (int)edges.size();\n        adj[v].push_back(id);\n        edges.push_back({u, cap, 0, cost});\n\n        adj[u].push_back(id ^ 1);\n        edges.push_back({v, 0, 0, -cost});\n    }\n\n    pair<ll, ll> min_cost_flow(int s, int t) {\n        ll flow = 0, total_cost = 0;\n\n        while (true) {\n            dist.assign(n, INF);\n            pv.assign(n, -1);\n            pe.assign(n, -1);\n\n            priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n            dist[s] = 0;\n            pq.push({0, s});\n\n            while (!pq.empty()) {\n                auto [d, v] = pq.top();\n                pq.pop();\n                if (d != dist[v]) continue;\n\n                for (int id : adj[v]) {\n                    const Edge &e = edges[id];\n                    if (e.flow >= e.cap) continue;\n\n                    ll nd = d + e.cost + pot[v] - pot[e.to];\n                    if (dist[e.to] > nd) {\n                        dist[e.to] = nd;\n                        pv[e.to] = v;\n                        pe[e.to] = id;\n                        pq.push({nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n            ll add = INF;\n            for (int v = t; v != s; v = pv[v]) {\n                int id = pe[v];\n                add = min(add, edges[id].cap - edges[id].flow);\n            }\n\n            flow += add;\n\n            for (int v = t; v != s; v = pv[v]) {\n                int id = pe[v];\n                edges[id].flow += add;\n                edges[id ^ 1].flow -= add;\n                total_cost += add * edges[id].cost;\n            }\n        }\n\n        return {flow, total_cost};\n    }\n};\n\nconst int T = 500;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MinCostMaxFlow mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1