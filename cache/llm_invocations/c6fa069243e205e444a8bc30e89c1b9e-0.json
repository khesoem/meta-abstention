w\n            i = pre[edge[i ^ 1].to]\n        i = pre[t]\n        while i != -1:\n            edge[i].flow += Min\n            edge[i ^ 1].flow -= Min\n            cost += edge[i].cost * Min\n            i = pre[edge[i ^ 1].to]\n        flow += Min\n    return flow, cost\n\ndef point(x, y):\n    return (x - 1) * 50 + y\n\ndef main():\n    global N, head, edge, tol, dis, pre, vis\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    S = 101 * 55\n    T = S + 1\n    init(T + 1)\n\n    for _ in range(k):\n        tmp = int(next(it))\n        addedge(S, tmp, 1, 0)\n\n    for i in range(1, 51):\n        for j in range(1, 104):\n            x = point(j, i)\n            y = point(j + 1, i)\n            addedge(x, y, INF, c)\n\n    for i in range(0, 102):\n        tmp = i * 50 + 1\n        addedge(tmp, T, INF, 0)\n\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(1, 103):\n            x = point(j, u)\n            x1 = point(j + 1, u)\n            y = point(j, v)\n            y1 = point(j + 1, v)\n            for k in range(50):\n                val = d * (k * 2 + 1) + c\n                addedge(x, y1, 1, val)\n                addedge(y, x1, 1, val)\n\n    flow, cost = minCostMaxflow(S, T)\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.552374e-05, 0.0, -1.7881378e-06, -0.0024857596, -0.08178853, -0.0017070497, -0.0068082977, -0.0032886965, -0.000817918, -2.3841855e-07, -0.0002630603, -0.011316282, -0.0048943, -3.6954812e-06, -0.005794987, -0.47423926, -2.3841855e-07, -2.0265559e-06, -0.0001236124, -2.3841855e-07, 0.0, -1.1920928e-07, 0.0, -1.7881378e-06, -1.1920928e-07, -0.062640004, -0.0302747, -0.02543769, -8.344616e-06, -4.7683704e-07, -1.2636105e-05, -2.62257e-05, -2.14