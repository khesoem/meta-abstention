inal int SRC = MAXV - 2;\n    static final int SNK = MAXV - 1;\n    static final int MAXE = 2000000 + 10;\n    static final int INF = 2000000000;\n\n    static int[] head = new int[MAXV];\n    static int[] to = new int[MAXE + 1];\n    static int[] nxt = new int[MAXE + 1];\n    static int[] cap = new int[MAXE + 1];\n    static int[] cst = new int[MAXE + 1];\n    static int edgeCnt = 1;\n\n    static long[] dist = new long[MAXV];\n    static boolean[] inQueue = new boolean[MAXV];\n    static Queue<Integer> q = new LinkedList<>();\n\n    static void addEdge(int u, int v, int f, int c) {\n        to[++edgeCnt] = v;\n        nxt[edgeCnt] = head[u];\n        head[u] = edgeCnt;\n        cap[edgeCnt] = f;\n        cst[edgeCnt] = c;\n\n        to[++edgeCnt] = u;\n        nxt[edgeCnt] = head[v];\n        head[v] = edgeCnt;\n        cap[edgeCnt] = 0;\n        cst[edgeCnt] = -c;\n    }\n\n    static boolean spfa() {\n        Arrays.fill(inQueue, false);\n        Arrays.fill(dist, Long.MAX_VALUE / 2);\n        q.clear();\n        q.add(SNK);\n        dist[SNK] = 0;\n        inQueue[SNK] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            inQueue[x] = false;\n            for (int i = head[x]; i != 0; i = nxt[i]) {\n                int y = to[i];\n                if (cap[i ^ 1] > 0 && dist[y] > dist[x] + cst[i ^ 1]) {\n                    dist[y] = dist[x] + cst[i ^ 1];\n                    if (!inQueue[y]) {\n                        q.add(y);\n                        inQueue[y] = true;\n                    }\n                }\n            }\n        }\n        return dist[SRC] < 1e18;\n    }\n\n    static int dfs(int x, int lim, long[] totalCost) {\n        int flow = 0;\n        inQueue[x] = true;\n        if (x == SNK) return lim;\n        for (int i = head[x]; i != 0; i = nxt[i]) {\n            int y = to[i];\n            if (cap[i] == 0 || inQueue[y]) continue;\n            if (dist[x] != dist[y] + cst[i]) continue;\n            int t = dfs(y,