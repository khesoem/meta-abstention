nteger> b) {\n        int len = Math.min(a.size(), b.size());\n        for (int i = 0; i < len; i++) {\n            int cmp = Integer.compare(a.get(i), b.get(i));\n            if (cmp != 0) return cmp;\n        }\n        return Integer.compare(a.size(), b.size());\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n\n        List<List<ModInt>> mat = new ArrayList<>(n);\n        for (int i = 0; i < n; i++) {\n            List<ModInt> row = new ArrayList<>(n);\n            for (int j = 0; j < n; j++) {\n                int x = sc.nextInt();\n                row.add(new ModInt(x).divide(new ModInt(100)));\n            }\n            mat.add(row);\n        }\n\n        List<State> sts = new ArrayList<>();\n        List<Integer> initMasks = new ArrayList<>();\n        initMasks.add(0);\n        sts.add(new State(initMasks, new ModInt(1)));\n\n        for (int ph = 0; ph < n; ph++) {\n            List<State> nsts = new ArrayList<>();\n            for (State st : sts) {\n                for (int f = 1; f < (1 << n); f++) {\n                    ModInt freq = new ModInt(1);\n                    for (int i = 0; i < n; i++) {\n                        if (((f >> i) & 1) == 1) {\n                            freq = freq.multiply(mat.get(ph).get(i));\n                        } else {\n                            freq = freq.multiply(new ModInt(1).subtract(mat.get(ph).get(i)));\n                        }\n                    }\n                    List<Integer> nst = new ArrayList<>();\n                    for (int d : st.masks) {\n                        for (int i = 0; i < n; i++) {\n                            if (((d >> i) & 1) == 1) continue;\n                            if (((f >> i) & 1) == 0) continue;\n                            nst.add(d ^ (1 << i));\n                        }\n                    }\n                    if (nst.isEmpty()) continue;\n                    Collections.sort(nst);\n                    // unique\n                    List<Integer> uniq = new ArrayList<>();\n                    for (int val : nst) {\n                        if (uniq.isEmpty() || uniq.get(uniq.size()-1) != val) {\n                            uniq.add(val);\n                        }\n                    }\n                    nsts.add(new State(uniq, st.prob.multiply(freq)));\n                }\n            }\n            // sort nsts by masks list\n            Collections.sort(nsts, (a, b) -> compareLists(a.masks, b.masks));\n            sts.clear();\n            for (State st : nsts) {\n                if (!sts.isEmpty() && compareLists(sts.get(sts.size()-1).masks, st.masks) == 0) {\n                    sts.get(sts.size()-1).prob = sts.get(sts.size()-1).prob.add(st.prob);\n                } else {\n                    sts.add(st);\n                }\n            }\n        }\n\n        ModInt ans = sts.isEmpty() ? new ModInt(0) : sts.get(0).prob;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -1.1920928244535389e-07, -0.00011157367407577112, -0.00014375607133843005, -1.1920928244535389e-07, -0.00047600860125385225, -0.03050054796040058, -0.0003438596613705158, 0.0, -4.887569048150908e-06, -0.008616412989795208, -0.00012432756193447858, -0.011235067620873451, -0.0011738798348233104, -0.000336590368533507, 0.0, -1.1920928244535389e-07, -0.00033623288618400693, -0.01815043017268181, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, -0.18018576502799988, -1.1920928244535389e-07, -0.0011151769431307912, -8.344646857949556e-07, -0.008614521473646164, -4.768370445162873e-07, -2.7656173188006505e-05, -1.1920928244535389e-07, -0.0010409895330667496, -4.768370445162873e-07, -0.429114431142807, 0.0, -5.864924969500862e-05, 0.0, -0.20143146812915802, -0.41033676266670227, 0.0, 0.0, -9.60780744208023e-05, -1.1920922133867862e-06, -0.7652498483657837, -0.0009660820942372084, -