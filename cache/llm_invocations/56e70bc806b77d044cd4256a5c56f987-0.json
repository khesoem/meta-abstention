urn (int)(ab % mod);\n}\n\nint powMod(int a, int e, int mod) {\n    long long res = 1;\n    long long base = a % mod;\n    while (e > 0) {\n        if (e & 1) {\n            res = (res * base) % mod;\n        }\n        base = (base * base) % mod;\n        e >>= 1;\n    }\n    return (int)res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, real_k, l;\n    cin >> n >> real_k >> l;\n\n    int maxN = 2 * n + 1;\n    vector<int> fact(maxN + 2);\n    fact[0] = 1;\n    for (int i = 1; i <= maxN + 1; ++i) {\n        fact[i] = multiply(fact[i-1], i, MOD);\n    }\n\n    vector<int> doublefact(n + 1);\n    doublefact[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        doublefact[i] = multiply(doublefact[i-1], (2*i - 1), MOD);\n    }\n\n    vector<int> invFact(maxN + 2);\n    for (int i = 0; i <= maxN + 1; ++i) {\n        invFact[i] = powMod(fact[i], MOD - 2, MOD);\n    }\n    int invDoublefactN = powMod(doublefact[n], MOD - 2, MOD);\n\n    int ans = 0;\n    for (int r = 1; r <= maxN; ++r) {\n        for (int k = 1; k <= n; ++k) {\n            if ((r % 2) != (k % 2)) continue;\n            if (r - 1 < k) continue;\n            if (maxN - r < k) continue;\n\n            int num = multiply(fact[r-1], fact[maxN - r], MOD);\n            num = multiply(num, doublefact[(r - k - 1) / 2], MOD);\n            num = multiply(num, doublefact[(maxN - r - k) / 2], MOD);\n\n            int invDenom = multiply(invFact[r - k - 1], invFact[maxN - r - k], MOD);\n            invDenom = multiply(invDenom, invFact[k], MOD);\n            int invTotal = multiply(invDenom, invDoublefactN, MOD);\n\n            int val = multiply(num, invTotal, MOD);\n            if (k >= real_k) {\n                ans = (ans + val) % MOD;\n            }\n        }\n    }\n\n    ans = multiply(ans, l, MOD);\n    ans = multiply(ans, powMod(2 * n + 1, MOD - 2, MOD), MOD);\n\n    cout << ans << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "to