tate |= tmp[j]\n        trans[cur][mask] = dfs(new_state, id_map, trans, N)\n    return cur\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    P = [[0]*N for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            P[i][j] = int(next(it))\n    \n    start = 1  # bit 0 set\n    id_map = {}\n    trans = [[]]  # 1-indexed, index 0 unused\n    dfs(start, id_map, trans, N)\n    cnt = len(id_map)\n    # print(cnt, file=sys.stderr)\n    \n    inv100 = modpow(100, MOD - 2)\n    inv100_pow_N = modpow(inv100, N)\n    \n    dp_cur = [0] * (cnt + 1)\n    dp_cur[1] = 1  # state id 1 corresponds to start\n    cur = 0  # not used as index, just for toggling\n    \n    for i in range(N):\n        # compute prob for each mask\n        prob = [0] * (1 << N)\n        for mask in range(1 << N):\n            prod = 1\n            for k in range(N):\n                if (mask >> k) & 1:\n                    val = P[i][k]\n                else:\n                    val = 100 - P[i][k]\n                prod = prod * val % MOD\n            prob[mask] = prod * inv100_pow_N % MOD\n        \n        dp_nxt = [0] * (cnt + 1)\n        for j in range(1, cnt + 1):\n            base = dp_cur[j]\n            if base == 0:\n                continue\n            for mask in range(1 << N):\n                nxt_state = trans[j][mask]\n                dp_nxt[nxt_state] = (dp_nxt[nxt_state] + base * prob[mask]) % MOD\n        dp_cur = dp_nxt\n    \n    # full state: all masks from 0 to (1<<N)-1 set\n    full = (1 << (1 << N)) - 1  # bits 0..(2^N-1) set\n    # but careful: if N=0? N>=1? assume N>=1\n    full_id = id_map.get(full)\n    if full_id is None:\n        # should not happen\n        print(0)\n    else:\n        print(dp_cur[full_id])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.56950321374461e-05, 0.0, -4.768