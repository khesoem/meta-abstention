static final long linf = 0x3f3f3f3f3f3f3f3fL;\n    static final int N = 50;\n    static final int fN = (N * 3 + 1) * N + 2;\n    \n    static int n, m, k, c, d, mxt;\n    static int s, t, fn;\n    \n    static List<List<Integer>> e = new ArrayList<>();\n    static List<Integer> to = new ArrayList<>();\n    static List<Integer> fw = new ArrayList<>();\n    static List<Integer> co = new ArrayList<>();\n    \n    static int[] dep = new int[fN];\n    static int[] pre = new int[fN];\n    static boolean[] vis = new boolean[fN];\n    \n    static void adde(int u, int v, int w, int cost) {\n        e.get(u).add(to.size());\n        to.add(v);\n        fw.add(w);\n        co.add(cost);\n        e.get(v).add(to.size());\n        to.add(u);\n        fw.add(0);\n        co.add(-cost);\n    }\n    \n    static boolean spfa() {\n        Arrays.fill(dep, iinf);\n        Arrays.fill(pre, -1);\n        Arrays.fill(vis, false);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        vis[s] = true;\n        dep[s] = 0;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int idx : e.get(u)) {\n                if (fw.get(idx) > 0 && dep[to.get(idx)] > dep[u] + co.get(idx)) {\n                    dep[to.get(idx)] = dep[u] + co.get(idx);\n                    pre[to.get(idx)] = idx;\n                    if (!vis[to.get(idx)]) {\n                        vis[to.get(idx)] = true;\n                        q.offer(to.get(idx));\n                    }\n                }\n            }\n        }\n        return dep[t] < iinf;\n    }\n    \n    static class Pair {\n        int first;\n        int second;\n        Pair(int f, int s) {\n            first = f;\n            second = s;\n        }\n    }\n    \n    static Pair mcmf() {\n        Pair res = new Pair(0, 0);\n        while (spfa()) {\n            int f = iinf;\n            for (int u = t; u != s; u = to.get(pre[u] ^ 1)) {\n                f = Math.min(f, fw.get(pre[u]));\n            }\n            for (int u = t; u != s; u = to.get(pre[u] ^ 1)) {\n                fw.set(pre[u], fw.get(pre[u]) - f);\n                fw.set(pre[u] ^ 1, fw.get(pre[u] ^ 1) + f);\n            }\n            res.first += f;\n            res.second += dep[t] * f;\n        }\n        return res;\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        mxt = N * 3 + 1;\n        fn = (t = (s = n * mxt) + 1) + 1;\n        \n        // Initialize adjacency lists\n        for (int i = 0; i < fN; i++) {\n            e.add(new ArrayList<>());\n        }\n        \n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt() - 1;\n            adde(s, u, 1, 0);\n        }\n        \n        while (m-- > 0) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int i = 0; i < mxt - 1; i++) {\n                for (int p = 1; p <= k; p++) {\n                    adde(i * n + u, (i + 1) * n + v, 1, 2 * d * p - d);\n                    adde(i * n + v, (i + 1) * n + u, 1, 2 * d * p - d);\n                }\n            }\n        }\n        \n        for (int u = 0; u < n; u++) {\n            for (int i = 0; i < mxt - 1; i++) {\n                adde(i * n + u, (i + 1) * n + u, k, 0);\n            }\n        }\n        \n        for (int i = 0; i < mxt; i++) {\n            adde(i * n, t, k, i * c);\n        }\n        \n        Pair ans = mcmf();\n        System.out.println(ans.second);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022420754248742014, -4.529942543740617e-06, -7.152555099310121e-07, -0.0036833316553384066, -6.472854875028133e-05, -0.14268077909946442, -0.4742041826248169, -4.768360213347478e-06, -2.3841855067985307e-07, -9.989239333663136e-