d) {\n    if (idx == (int)arr.size()) {\n        sums.insert(cur);\n        return;\n    }\n    rec(sums, arr, idx + 1, (cur + arr[idx]) % mod, mod);\n    rec(sums, arr, idx + 1, cur, mod);\n}\n\nint main() {\n    int n, m;\n    std::cin >> n >> m;\n    std::vector<int> a(n);\n    for (int i = 0; i < n; ++i) {\n        std::cin >> a[i];\n        a[i] %= m;\n    }\n    int half = n / 2;\n    std::set<int> left_set, right_set;\n    rec(left_set, std::vector<int>(a.begin(), a.begin() + half), 0, 0, m);\n    rec(right_set, std::vector<int>(a.begin() + half, a.end()), 0, 0, m);\n    std::vector<int> right_sorted(right_set.begin(), right_set.end());\n    int best = 0;\n    for (int l : left_set) {\n        int target = m - l;\n        auto it = std::lower_bound(right_sorted.begin(), right_sorted.end(), target);\n        int pos = it - right_sorted.begin() - 1;\n        int r;\n        if (pos >= 0) {\n            r = right_sorted[pos];\n        } else {\n            r = right_sorted.back();\n        }\n        int candidate = l + r;\n        if (candidate > best) {\n            best = candidate;\n        }\n    }\n    std::cout << best << std::endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.362964682513848e-05, -1.1920928244535389e-07, -3.576278118089249e-07, -0.0005884823040105402, -0.00011884459672728553, -8.344646857949556e-07, -0.004079473204910755, -1.2993727978027891e-05, 0.0, 0.0, -3.564294092939235e-05, -1.5497195136049413e-06, 0.0, 0.0, -1.1920922133867862e-06, -2.9802276912960224e-06, 0.0, 0.0, 0.0, -0.07890968769788742, -0.47420430183410645, -5.245195097813848e-06, -1.9073468138230965e-06, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -0.0011701886542141438, -2.50339189733495e-06, -4.172316494077677e-06, -2.777537883957848e-05, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -5.483612312673358e-06, -0.00012742661056108773, 0.0, -7.152555099310121e-07, -2.3841855067985307e-07, 0.