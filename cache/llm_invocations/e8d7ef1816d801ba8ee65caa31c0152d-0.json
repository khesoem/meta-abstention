tart\n    sort(segs.begin(), segs.end());\n\n    // merge overlapping intervals\n    vector<pair<int,int>> finSeg;\n    int i = 0;\n    while (i < k) {\n        int lo = segs[i].first;\n        int hi = segs[i].first;\n        while (i < k && segs[i].first <= hi) {\n            hi = max(hi, segs[i].second);\n            i++;\n        }\n        finSeg.push_back({lo, hi});\n    }\n\n    k = finSeg.size();\n    segs = finSeg;\n    l.resize(k);\n    delt.resize(k);\n    for (int i = 0; i < k; i++) {\n        l[i] = segs[i].second - segs[i].first;\n        delt[i] = (i < k - 1) ? segs[i+1].first - segs[i].second : 2 * n - segs[i].second;\n    }\n\n    // dp0 and dp1: dimensions (k+1) x (2*n+1)\n    dp0.assign(k+1, vector<int>(2*n+1, n));\n    dp1.assign(k+1, vector<int>(2*n+1, n));\n    dp0[k][n] = 0;\n    dp1[k][n] = 0;\n\n    RMQ rmq0(dp0[k]);\n    RMQ rmq1(dp1[k]);\n\n    for (int i = k-1; i >= 0; i--) {\n        for (int j = 0; j <= 2*n; j++) {\n            // first assignment for dp0\n            if (j + l[i] + delt[i] <= 2*n)\n                dp0[i][j] = dp0[i+1][j + l[i] + delt[i]];\n            else\n                dp0[i][j] = n;\n\n            // dp1 initial\n            dp1[i][j] = dp1[i+1][j];\n\n            // updates\n            int r1 = rmq1.query(j, min(j + l[i], 2*n));\n            dp0[i][j] = min(dp0[i][j], 1 + r1);\n\n            if (j + delt[i] <= 2*n) {\n                int r2 = rmq0.query(j + delt[i], min(j + l[i] + delt[i], 2*n));\n                dp1[i][j] = min(dp1[i][j], 1 + r2);\n                dp0[i][j] = min(dp0[i][j], 2 + r2);\n            }\n\n            int r3 = rmq1.query(j, min(j + l[i], 2*n));\n            dp1[i][j] = min(dp1[i][j], 2 + r3);\n        }\n        // rebuild RMQ for next iteration\n        rmq0 = RMQ(dp0[i]);\n        rmq1 = RMQ(dp1[i]);\n    }\n\n    int ans = dp1[0][0];\n    if (ans == n) {\n        cout << \"Hungry\" << endl;\n    } else {\n        cout << \"Full\" << endl;\n        cout << ans << endl;\n    }\n\n  