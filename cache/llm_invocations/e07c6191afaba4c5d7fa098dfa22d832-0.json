{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n<your_rewritten_code_2>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 10005;\nconst int MAX_EDGES = 1000000;\nconst long long INF = 1LL << 50;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nvector<Edge> adj[MAX_NODES];\nint dist[MAX_NODES], prevv[MAX_NODES], preve[MAX_NODES];\nbool inq[MAX_NODES];\n\nvoid add_edge(int u, int v, int cap, int cost) {\n    adj[u].emplace_back(v, cap, cost, adj[v].size());\n    adj[v].emplace_back(u, 0, -cost, adj[u].size() - 1);\n}\n\nlong long min_cost_flow(int s, int t) {\n    long long total_cost = 0;\n    while (true) {\n        fill(dist, dist + MAX_NODES, INF);\n        fill(inq, inq + MAX_NODES, false);\n        queue<int> q;\n        dist[s] = 0;\n        q.push(s);\n        inq[s] = true;\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            for (int i = 0; i < adj[u].size(); ++i) {\n                auto& e = adj[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[t] == INF) break;\n\n        long long flow = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            flow = min(flow, (long long)adj[prevv[v]][preve[v]].cap);\n        }\n\n        for (int v = t; v != s; v = prevv[v]) {\n            auto& e = adj[prevv[v]][preve[v]];\n            e.cap -= flow;\n            adj[v][e.rev].cap += flow;\n            total_cost += flow * e.cost;\n        }\n    }\n    return total_cost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> a(k + 1);\n    for (int i = 1; i <= k; ++i) cin >> a[i];\n\n    int source = 0;\n    int sink = n * 100 + 1;\n\n    for (int f = 1; f <= 100; ++f) {\n        add_edge(f, sink, INT_MAX, 0);\n    }\n\n    for (int i = 1; i <= k; ++i) {\n        add_edge(source, (a[i] - 1) * 100 + 1, 1, 0);\n    }\n\n    for (int floor = 2; floor <= n; ++floor) {\n        for (int lvl = 1; lvl < 100; ++lvl) {\n            add_edge((floor - 1) * 100 + lvl, (floor - 1) * 100 + lvl + 1, INT_MAX, c);\n        }\n    }\n\n    int u, v;\n    for (int _ = 0; _ < m; ++_) {\n        cin >> u >> v;\n        for (int lvl = 1; lvl < 100; ++lvl) {\n            for (int grp = 1; grp <= k; ++grp) {\n                int cost_val = c + d * (grp * grp - (grp - 1) * (grp - 1));\n                add_edge((u - 1) * 100 + lvl, (v - 1) * 100 + lvl + 1, 1, cost_val);\n                add_edge((v - 1) * 100 + lvl, (u - 1) * 100 + lvl + 1, 1, cost_val);\n            }\n        }\n    }\n\n    cout << min_cost_flow(source, sink) << '\\n';\n    return 0;\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAX_NODES = 10005\nMAX_EDGES = 1000000\nINF = 1 << 50\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nadj = [[] for _ in range(MAX_NODES)]\ndist = [0] * MAX_NODES\nprevv = [0] * MAX_NODES\npreve = [0] * MAX_NODES\ninq = [False] * MAX_NODES\n\ndef add_edge(u, v, cap, cost):\n    adj[u].append(Edge(v, cap, cost, len(adj[v])))\n    adj[v].append(Edge(u, 0, -cost, len(adj[u]) - 1))\n\ndef min_cost_flow(s, t):\n    total_cost = 0\n    while True:\n        dist[:] = [INF] * MAX_NODES\n        inq[:] = [False] * MAX_NODES\n        q = deque()\n        dist[s] = 0\n        q.append(s)\n        inq[s] = True\n\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for i in range(len(adj[u])):\n                e = adj[u][i]\n                if e.cap > 0 and dist[e.to] > dist[u] + e.cost:\n                    dist[e.to] = dist[u] + e.cost\n                    prevv[e.to] = u\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n\n        if dist[t] == INF:\n            break\n\n        flow = INF\n        v = t\n        while v != s:\n            flow = min(flow, adj[prevv[v]][preve[v]].cap)\n            v = prevv[v]\n\n        v = t\n        while v != s:\n            e = adj[prevv[v]][preve[v]]\n            e.cap -= flow\n            adj[v][e.rev].cap += flow\n            total_cost += flow * e.cost\n            v = prevv[v]\n\n    return total_cost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = int(data[idx]); idx += 1\n\n    source = 0\n    sink = n * 100 + 1\n\n    for f in range(1, 101):\n        add_edge(f, sink, 10**9, 0)\n\n    for i in range(1, k + 1):\n        add_edge(source, (a[i] - 1) * 100 + 1, 1, 0)\n\n    for floor in range(2, n + 1):\n        for lvl in range(1, 100):\n            add_edge((floor - 1) * 100 + lvl, (floor - 1) * 100 + lvl + 1, 10**9, c)\n\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for lvl in range(1, 100):\n            for grp in range(1, k + 1):\n                cost_val = c + d * (grp * grp - (grp - 1) * (grp - 1))\n                add_edge((u - 1) * 100 + lvl, (v - 1) * 100 + lvl + 1, 1, cost_val)\n                add_edge((v - 1) * 100 + lvl, (u - 1) * 100 + lvl + 1, 1, cost_val)\n\n    print(min_cost_flow(source, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019453064305707812, -2.3841830625315197e-06, -1.1920922133867862e-06, -0.029110655188560486, -0.0009146321099251509, -8.344646857949556e-07, -0.0002637753786984831, -0.0002755738969426602, -1.1920922133867862e-06, -0.0011739989276975393, -0.023302283138036728, -0.23566731810569763, -9.65590606938349e-06, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -1.7881377516459906e-06, -8.344646857949556e-07, -0.00020919041708111763, -7.152555099310121e-07, -0.0011803095694631338, -0.14364556968212128, -0.00021598390594590455, -5.245195097813848e-06, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920922133867862e-06, -5.960462772236497e-07, -2.825220326485578e-05, -1.311301275563892e-06, -0.0013331820955500007, -3.576278118089249e-07, -0.007612031884491444, 0.0