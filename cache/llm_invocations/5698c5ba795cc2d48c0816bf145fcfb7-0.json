ing[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        long[] sl = new long[51];\n        sl[0] = 1;\n        for (int i = 1; i < 51; i++) {\n            sl[i] = sl[i - 1] + (1L << i);\n        }\n        \n        if (!sc.hasNextInt()) return;\n        int h = sc.nextInt();\n        long n = sc.nextLong();\n        \n        List<Long> nl = new ArrayList<>();\n        n += sl[h - 1];\n        long tn = n;\n        nl.add(tn);\n        while (tn != 1) {\n            tn = tn / 2;\n            nl.add(tn);\n        }\n        \n        long ans = 0;\n        long cn = 1;\n        boolean cp = false;\n        \n        while (cn != n) {\n            List<Long> tnl = new ArrayList<>();\n            for (int i = 0; i < h; i++) {\n                tnl.add(cn);\n                if (!cp) {\n                    cn *= 2;\n                } else {\n                    cn = cn * 2 + 1;\n                }\n                cp = !cp;\n            }\n            \n            if (cn == n) {\n                ans += h;\n                break;\n            }\n            \n            tnl.add(cn);\n            Collections.reverse(tnl);\n            \n            boolean found = false;\n            for (int i = 1; i <= h; i++) {\n                // nl is 0-indexed, nl[i] corresponds to the i-th element\n                // tnl is reversed, so tnl[i] is the i-th element from the end\n                if (nl.get(i).equals(tnl.get(i))) {\n                    ans += sl[i - 1] + h - i + 1;\n                    h = i - 1;\n                    cn = tnl.get(i - 1);\n                    if (cn == tnl.get(i) * 2) {\n                        cn = tnl.get(i) * 2 + 1;\n                        cp = false;\n                    } else {\n                        cn = tnl.get(i) * 2;\n                        cp = true;\n                    }\n                    found = true;\n                    break;\n                }\n            }\n            if (!found) break; // Safety break 