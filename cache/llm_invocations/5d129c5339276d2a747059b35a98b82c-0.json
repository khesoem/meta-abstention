;i<g[v].size();i++) {\n                    Edge &e = g[v][i];\n                    if(e.cap > 0 && d[e.to] > d[v] + e.cost + h[v] - h[e.to]) {\n                        d[e.to] = d[v] + e.cost + h[v] - h[e.to];\n                        pv[e.to] = v;\n                        pe[e.to] = i;\n                        pq.push({d[e.to], e.to});\n                    }\n                }\n            }\n            if(d[t] == INF) break;\n            for(int i=0;i<=n;i++) h[i] += d[i];\n            int add = f;\n            for(int v=t; v!=s; v=pv[v]) add = min(add, g[pv[v]][pe[v]].cap);\n            f -= add; flow += add; ans += add * h[t];\n            for(int v=t; v!=s; v=pv[v]) {\n                Edge &e = g[pv[v]][pe[v]];\n                e.cap -= add;\n                g[v][e.rev].cap += add;\n            }\n        }\n        return ans;\n    }\n} flow;\n\nint main() {\n#ifndef ONLINE_JUDGE\n    freopen(\"in.in\", \"r\", stdin);\n    freopen(\"out.out\", \"w\", stdout);\n#endif\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    flow.init(n*(n+55)+2);\n    for(int i=0;i<k;i++) {\n        int u; cin >> u;\n        flow.add_edge(0, u, 1, 0);\n    }\n    vector<pii> eds(m);\n    for(int i=0;i<m;i++) cin >> eds[i].ff >> eds[i].ss;\n    int target = n*(n+55)+1;\n    for(int t=0;t<n+54;t++) {\n        for(pii e : eds) {\n            for(int j=1;j<=k;j++) {\n                flow.add_edge(e.ff+t*n, e.ss+(t+1)*n, 1, c+d*(2*j-1));\n                flow.add_edge(e.ss+t*n, e.ff+(t+1)*n, 1, c+d*(2*j-1));\n            }\n        }\n        for(int i=2;i<=n;i++)\n            flow.add_edge(i+t*n, i+(t+1)*n, k, c);\n        flow.add_edge(1+t*n, target, k, 0);\n    }\n    cout << flow.min_cost(0, target, k) << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class MinCostFlow {\n        int n;\n        ArrayList<Edge>[] g;\n        int[] h, d, pv, pe;\n\n        static class Edge {\n            int to, cap, cost, rev;\n            Edge(int t, int c, int co, int r) {\n                to = t;\n                cap = c;\n                cost = co;\n                rev = r;\n            }\n        }\n\n        void init(int m) {\n            n = m;\n            g = new ArrayList[n + 1];\n            for (int i = 0; i <= n; i++) g[i] = new ArrayList<>();\n            h = new int[n + 1];\n            d = new int[n + 1];\n            pv = new int[n + 1];\n            pe = new int[n + 1];\n        }\n\n        void add_edge(int from, int to, int cap, int cost) {\n            g[from].add(new Edge(to, cap, cost, g[to].size()));\n            g[to].add(new Edge(from, 0, -cost, g[from].size() - 1));\n        }\n\n        int min_cost(int s, int t, int f) {\n            int flow = 0, ans = 0;\n            Arrays.fill(h, 0, n + 1, 0);\n            while (f > 0) {\n                Arrays.fill(d, 0, n + 1, Integer.MAX_VALUE / 2);\n                PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> Integer.compare(a[0], b[0]));\n                d[s] = 0;\n                pq.offer(new int[]{0, s});\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int dist = cur[0];\n                    int v = cur[1];\n                    if (d[v] < dist) continue;\n                    for (int i = 0; i < g[v].size(); i++) {\n                        Edge e = g[v].get(i);\n                        if (e.cap > 0 && d[e.to] > d[v] + e.cost + h[v] - h[e.to]) {\n                            d[e.to] = d[v] + e.cost + h[v] - h[e.to];\n                            pv[e.to] = v;\n                            pe[e.to] = i;\n                            pq.offer(new int[]{d[e.to], e.to});\n                        }\n                    }\n                }\n                if (d[t] == Integer.MAX_VALUE / 2) break;\n                for (int i = 0; i <= n; i++) h[i] += d[i];\n                int add = f;\n                for (int v = t; v != s; v = pv[v]) add = Math.min(add, g[pv[v]].get(pe[v]).cap);\n                f -= add;\n                flow += add;\n                ans += add * h[t];\n                for (int v = t; v != s; v = pv[v]) {\n                    Edge e = g[pv[v]].get(pe[v]);\n                    e.cap -= add;\n                    g[v].get(e.rev).cap += add;\n                }\n            }\n            return ans;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        MinCostFlow flow = new MinCostFlow();\n        flow.init(n * (n + 55) + 2);\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            flow.add_edge(0, u, 1, 0);\n        }\n        int[] a = new int[m];\n        int[] b = new int[m];\n        for (int i = 0; i < m; i++) {\n            a[i] = sc.nextInt();\n            b[i] = sc.nextInt();\n        }\n        int target = n * (n + 55) + 1;\n        for (int t = 0; t < n + 54; t++) {\n            for (int i = 0; i < m; i++) {\n                for (int j = 1; j <= k; j++) {\n                    flow.add_edge(a[i] + t * n, b[i] + (t + 1) * n, 1, c + d * (2 * j - 1));\n                    flow.add_edge(b[i] + t * n, a[i] + (t + 1) * n, 1, c + d * (2 * j - 1));\n                }\n            }\n            for (int i = 2; i <= n; i++) {\n                flow.add_edge(i + t * n, i + (t + 1) * n, k, c);\n            }\n            flow.add_edge(1 + t * n, target, k, 0);\n        }\n        System.out.println(flow.min_cost(0, target, k));\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.7223141193389893, -5.817244164063595e-05, 0.0, -8.344646857949556e-07, -0.00032240914879366755, -0.