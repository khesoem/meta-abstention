 { tmp /= K; digs++; }\n    pref[0] = Mat(K + 1, vector<Mod>(K + 1, 0));\n    for (int i = 1; i < K; ++i) pref[0][i][i] = 1;\n    pref[0][0][K] = 1;\n    pref[0][K][0] = M - 1;\n    pref[0][K][K] = 2;\n    for (int step = 0; step < digs; ++step) {\n        pref[step + 1] = pref[step];\n        auto cur = pref[step];\n        for (int i = 1; i <= K - 1; ++i) {\n            cur = shift(cur);\n            pref[step + 1] = pref[step + 1] * cur;\n        }\n    }\n}\nMat solve(ll n) {\n    if (n == 0) {\n        Mat I(K + 1, vector<Mod>(K + 1, 0));\n        for (int i = 0; i <= K; ++i) I[i][i] = 1;\n        return I;\n    }\n    ll dig = 0, pw = 1;\n    while (pw <= n / K) { pw *= K; dig++; }\n    if (n == pw) return pref[dig];\n    ll steps = n / pw;\n    ll left = n - steps * pw;\n    auto res = solve(0);\n    auto coeff = pref[dig];\n    for (ll i = 0; i < steps; ++i) {\n        res = res * coeff;\n        coeff = shift(coeff);\n    }\n    auto other = solve(left);\n    for (ll i = 0; i < steps; ++i) other = shift(other);\n    return res * other;\n}\nint main() {\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n    srand(239);\n    cin >> N >> K;\n    init();\n    auto mat = solve(N);\n    cout << mat[K][K].x << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int M = 1000000007;\n    static long N;\n    static int K;\n    static ArrayList<int[][]> pref = new ArrayList<>();\n\n    static int[][] matMul(int[][] A, int[][] B) {\n        int n = K + 1;\n        int[][] C = new int[n][n];\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                long sum = 0;\n                for (int t = 0; t < n; ++t) {\n                    sum = (sum + (long)A[i][t] * B[t][j]) % M;\n                }\n                C[i][j] = (int)sum;\n            }\n        }\n        return C;\n    }\n\n    static int[][] matShift(int[][] M) {\n        int n = K + 1;\n        int[][] R = new int[n][n];\n        for (int i = 0; i < n; ++i) {\n            int ni = (i < K) ? (i + K - 1) % K : i;\n            for (int j = 0; j < n; ++j) {\n                int nj = (j < K) ? (j + K - 1) % K : j;\n                R[i][j] = M[ni][nj];\n            }\n        }\n        return R;\n    }\n\n    static void init() {\n        long tmp = N;\n        int digs = 0;\n        while (tmp > 0) {\n            tmp /= K;\n            digs++;\n        }\n        int[][] base = new int[K + 1][K + 1];\n        for (int i = 1; i < K; ++i) base[i][i] = 1;\n        base[0][K] = 1;\n        base[K][0] = M - 1;\n        base[K][K] = 2;\n        pref.add(base);\n        for (int step = 0; step < digs; ++step) {\n            int[][] cur = pref.get(step);\n            int[][] res = pref.get(step);\n            for (int i = 1; i <= K - 1; ++i) {\n                cur = matShift(cur);\n                res = matMul(res, cur);\n            }\n            pref.add(res);\n        }\n    }\n\n    static int[][] solve(long n) {\n        if (n == 0) {\n            int[][] I = new int[K + 1][K + 1];\n            for (int i = 0; i <= K; ++i) I[i][i] = 1;\n            return I;\n        }\n        long pw = 1;\n        int dig = 0;\n        while (pw <= n / K) {\n            pw *= K;\n            dig++;\n        }\n        if (n == pw) return pref.get(dig);\n        long steps = n / pw;\n        long left = n - steps * pw;\n        int[][] res = solve(0);\n        int[][] coeff = pref.get(dig);\n        for (long i = 0; i < steps; ++i) {\n            res = matMul(res, coeff);\n            coeff = matShift(coeff);\n        }\n        int[][] other = solve(left);\n        for (long i = 0; i < steps; ++i) other = matShift(other);\n        return matMul(res, other);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.i