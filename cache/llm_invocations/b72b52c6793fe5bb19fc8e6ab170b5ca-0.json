{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nconst int MAX = 1000000;\nint freq[MAX+2], src, sink;\nvector<int> edges[MAX+2];\nconst int INF = 1000000000;\n\nstruct Arc { int from, to, cap, cost; };\nvector<Arc> arcs;\nvector<int> adj[MAX+2];\nvoid addArc(int a, int b, int cap, int cost) {\n    arcs.push_back({a, b, cap, cost});\n    adj[a].push_back(arcs.size() - 1);\n    arcs.push_back({b, a, 0, -cost});\n    adj[b].push_back(arcs.size() - 1);\n}\n\nint dist[MAX+2], inq[MAX+2], minc[MAX+2], parent[MAX+2];\npair<int,int> spfa(int n) {\n    for (int i = 0; i <= n; ++i) dist[i] = INF;\n    queue<int> q; q.push(src);\n    dist[src] = 0; inq[src] = 1; minc[src] = INF;\n    while (!q.empty()) {\n        int u = q.front(); q.pop(); inq[u] = 0;\n        for (int id : adj[u]) {\n            auto &e = arcs[id];\n            if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                dist[e.to] = dist[u] + e.cost;\n                parent[e.to] = id;\n                minc[e.to] = min(minc[u], e.cap);\n                if (!inq[e.to]) { q.push(e.to); inq[e.to] = 1; }\n            }\n        }\n    }\n    if (dist[sink] == INF) return {0, 0};\n    int v = sink;\n    while (v != src) {\n        int id = parent[v];\n        arcs[id].cap -= minc[sink];\n        arcs[id ^ 1].cap += minc[sink];\n        v = arcs[id].from;\n    }\n    return {minc[sink], dist[sink] * minc[sink]};\n}\npair<int,int> mcmf(int n) {\n    int flow = 0, cost = 0;\n    while (true) {\n        auto p = spfa(n);\n        if (!p.first) return {flow, cost};\n        flow += p.first;\n        cost += p.second;\n    }\n}\n\nint main() {\n    ios_base::sync_with_stdio(false); cin.tie(nullptr);\n    int n, m, k, c, d; cin >> n >> m >> k >> c >> d;\n    for (int i = 1; i <= k; ++i) { int x; cin >> x; freq[x]++; }\n    for (int i = 1; i <= m; ++i) { int u, v; cin >> u >> v; edges[u].push_back(v); edges[v].push_back(u); }\n    src = 0; sink = 100 * n + n + 1;\n    for (int tm = 0; tm < 100; ++tm) {\n        for (int i = 1; i <= n; ++i) {\n            addArc(n * tm + i, n * (tm + 1) + i, k, 0);\n            for (int x : edges[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    addArc(n * tm + i, n * (tm + 1) + x, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        if (freq[i]) addArc(src, i, freq[i], 0);\n    for (int tm = 0; tm <= 100; ++tm)\n        addArc(n * tm + 1, sink, k, c * tm);\n    auto ans = mcmf(sink);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Arc {\n        int from, to, cap, cost;\n        Arc(int from, int to, int cap, int cost) {\n            this.from = from;\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static int src, sink;\n    static ArrayList<Arc> arcs;\n    static 