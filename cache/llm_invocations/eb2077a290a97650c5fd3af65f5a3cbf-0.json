ptr];\n\tif(ret != -1)return ret;\n\tif(x0 == x1 && y0 == y1)return dist[x0][y0] >= ptr;\n\tif(dist[x0][y0] <= ptr)return ret = 0;\n\tfor(int k = 0; k < 4; k++){\n\t\tint nx = x0 + dx[k];\n\t\tint ny = y0 + dy[k];\n\t\tif(good(nx, ny) && dfs(nx, ny, x1, y1, ptr + 1))return ret = 1;\n\t}\n\treturn ret = 0;\n}\n\nbool fml(int s, int t){\n\tmemset(par, -1, sizeof(par));\n\tpar[s] = -2;\n\tqueue<int> qu;\n\tqu.push(s);\n\twhile(!qu.empty()){\n\t\tint v = qu.front(); qu.pop();\n\t\tfor(int i = s; i <= t; i++){\n\t\t\tif(par[i] == -1 && cap[v][i] > 0){\n\t\t\t\tpar[i] = v;\n\t\t\t\tqu.push(i);\n\t\t\t}\n\t\t}\n\t}\n\treturn par[t] != -1;\n}\n\nint main(){\n\tios::sync_with_stdio(false);\n\tcin.tie(NULL);\n\tcout<<setprecision(32);\n\n\tcin>>n>>t;\n\tfor(int i = 0; i < n; i++){\n\t\tcin>>sci[i];\n\t}\n\tfor(int i = 0; i < n; i++){\n\t\tcin>>lab[i];\n\t}\n\tvector<pair<int, int> > pos;\n\tvector<int> lc, sc;\n\tfor(int i = 0; i < n; i++){\n\t\tfor(int j = 0; j < n; j++){\n\t\t\tif(sci[i][j] == 'Z'){\n\t\t\t\trx = i;\n\t\t\t\try = j;\n\t\t\t}else if('0' <= sci[i][j] && sci[i][j] <= '9'){\n\t\t\t\tpos.push_back({i, j});\n\t\t\t\tlc.push_back(lab[i][j] - '0');\n\t\t\t\tsc.push_back(sci[i][j] - '0');\n\t\t\t}\n\t\t}\n\t}\n\tint m = pos.size();\n\tmemset(cap, 0, sizeof(cap));\n\tfor(int i = 0; i < m; i++){\n\t\tcap[0][i + 1] = sc[i];\n\t\tcap[m + 1 + i][2*m + 1] = lc[i];\n\t}\n\tpre();\n\tmemset(mem, -1, sizeof(mem));\n\tfor(int i = 0; i < m; i++){\n\t\tfor(int j = 0; j < m; j++){\n\t\t\tif(dfs(pos[i].first, pos[i].second, pos[j].first, pos[j].second, 0)){\n\t\t\t\t// cout<<pos[i].first<<\" \"<<pos[i].second<<\" \"<<pos[j].first<<\" \"<<pos[j].second<<endl;\n\t\t\t\tcap[i + 1][m + 1 + j] = 1000;\n\t\t\t}\n\t\t}\n\t}\n\tint flow = 0;\n\twhile(fml(0, 2*m + 1)){\n\t\tint t = 2*m + 1;\n\t\tint nflow = 1e6;\n\t\twhile(par[t] >= 0){\n\t\t\tnflow = min(nflow, cap[par[t]][t]);\n\t\t\tt = par[t];\n\t\t}\n\t\tt = 2*m + 1;\n\t\twhile(par[t] >= 0){\n\t\t\tcap[par[t]][t] -= nflow;\n\t\t\tcap[t][par[t]] += nflow;\n\t\t\tt = par[t];\n\t\t}\n\t\tflow += nflow;\n\t}\n\tcout<<flow;\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    n, t = map(int, data[0].split())\n    sci = []\n    lab = []\n    for i in range(1, n + 1):\n        sci.append(data[i])\n    for i in range(n + 1, 2 * n + 1):\n        lab.append(data[i])\n    \n    dx = [1, -1, 0, 0]\n    dy = [0, 0, 1, -1]\n    \n    def good(x, y):\n        return 0 <= x < n and 0 <= y < n and lab[x][y] != 'Y' and lab[x][y] != 'Z'\n    \n    rx, ry = -1, -1\n    pos = []\n    lc = []\n    sc = []\n    \n    for i in range(n):\n        for j in range(n):\n            if sci[i][j] == 'Z':\n                rx, ry = i, j\n            elif '0' <= sci[i][j] <= '9':\n                pos.append((i, j))\n                lc.append(ord(lab[i][j]) - ord('0'))\n                sc.append(ord(sci[i][j]) - ord('0'))\n    \n    m = len(pos)\n    \n    # Initialize dist and vis\n    INF = 10**9\n    dist = [[INF] * n for _ in range(n)]\n    vis = [[0] * n for _ in range(n)]\n    \n    if rx != -1 and ry != -1:\n        dist[rx][ry] = 0\n        vis[rx][ry] = 1\n        qx = deque()\n        qy = deque()\n        qx.append(rx)\n        qy.append(ry)\n        \n        while qx:\n            x = qx.popleft()\n            y = qy.popleft()\n            for k in range(4):\n                nx, ny = x + dx[k], y + dy[k]\n                if good(nx, ny) and not vis[nx][ny]:\n                    dist[nx][ny] = dist[x][y] + 1\n                    vis[nx][ny] = 1\n                    qx.append(nx)\n                    qy.append(ny)\n    \n    # Memoization for dfs\n    # mem[x0][y0][x1][y1][ptr]\n    # Since dimensions are small (up to 12), we can use a dictionary or nested lists\n    # But for simplicity, we'll use a dictionary\n    mem = {}\n    \n    def dfs(x0, y0, x1, y1, ptr):\n        if ptr > t:\n            return 0\n        key = (x0, y0, x1, y1, ptr)\n        if key in mem:\n            return mem[key]\n        \n        if x0 == x1 and y0 == y1:\n            result = 1 if dist[x0][y0] >= ptr else 0\n            mem[key] = result\n            return result\n        \n        if dist[x0][y0] <= ptr:\n            mem[key] = 0\n            return 0\n        \n        for k in range(4):\n            nx, ny = x0 + dx[k], y0 + dy[k]\n            if good(nx, ny) and dfs(nx, ny, x1, y1, ptr + 1):\n                mem[key] = 1\n                return 1\n        \n        mem[key] = 0\n        return 0\n    \n    # Build capacity graph\n    # Nodes: 0 (source), 1..m (input nodes), m+1..2m (output nodes), 2m+1 (sink)\n    cap = [[0] * (2 * m + 2) for _ in range(2 * m + 2)]\n    \n    for i in range(m):\n        cap[0][i + 1] = sc[i]\n        cap[m + 1 + i][2 * m + 1] = lc[i]\n    \n    # Fill edges between input and output nodes\n    for i in range(m):\n        for j in range(m):\n            if dfs(pos[i][0], pos[i][1], pos[j][0], pos[j][1], 0):\n                cap[i + 1][m + 1 + j] = 1000\n    \n    # Ford-Fulkerson / BFS for max flow\n    def fml(s, t):\n        par = [-1] * (2 * m + 2)\n        par[s] = -2\n        qu = deque()\n        qu.append(s)\n        while qu:\n            v = qu.popleft()\n            for i in range(s, t + 1):\n                if par[i] == -1 and cap[v][i] > 0:\n                    par[i] = v\n                    qu.append(i)\n        return par[t] != -1\n    \n    flow = 0\n    while fml(0, 2 * m + 1):\n        t_node = 2 * m + 1\n        nflow = 10**6\n        path = []\n        while par[t_node] >= 0:\n            path.append((par[t_node], t_node))\n            nflow = min(nflow, cap[par[t_node]][t_node])\n            t_node = par[t_node]\n        \n        # Update residual capacities\n        for u, v in path:\n            cap[u][v] -= nflow\n            cap[v][u] += nflow\n        \n        flow += nflow\n    \n    print(flow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001720042055239901, -1.5497195136049413e-06, -2.3841855067985307e-07, -0.22618696093559265, -0.0019183820113539696, -3.576278118089249e-07, -0.0015086471103131771, -0.00027414379292167723, -1.5497195136049413e-06, -3.802703940891661e-05, -0.3869152367115021, -0.15947237610816956, -0.07276728004217148, -8.344646857949556e-07, -1.311301275563892e-06, -0.07352615147829056, -0.014535488560795784, -1.2993727978027891e-05, -3.123234637314454e-05, -0.021194517612457275, -0.00012516192509792745, -2.264974000354414e-06, -0.0014913876075297594, 0.0, -2.3483953555114567e-05, -1.6689286894688848e-06, -0.0004950728034600616, -0.05142129212617874, -3.933898824470816e-06, -0.14267747104167938, -1.1920922133867862e-06, -0.5941906571388245, -2.777537883957848e-05, -8.344646857949556e-07, -0.014398839324712753, -0.0012053137179464102, -4.529942543740617e-06, -9.536738616588991e-07, -4.768370445162873e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -4.672895011026412e-05, -4.887569048150908e-06, -7.271740287251305e-06, -0.10020895302295685, -0.009998476132750511, -1.1920858014491387e-05, -0.39149922132492065, -1.4305104514278355e-06, -0.0013502062065526843, -1.4305104514278355e-06, -1.4066597032069694e-05, -0.3484492003917694, -0.11978702992200851, -1.1920928244535389e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -1.4781842764932662e-05, 0.0, 0.0, -0.474077433347702, -0.0004880429187323898, 0.0, 0.0, -5.960462772236497e-07, -3.576278118089249e-07, -6.472854875028133e-05, -3.576278118089249e-07, -2.50339189733495e-06, -8.344646857949556e-07, -0.0004906642716377974, -1.9073468138230965e-06, -5.960462772236497e-07, 0.0, -8.344646857949556e-07, -7.152555099310121e-07, -0.0002315968304174021, -2.264974000354414e-06, 0.0, -2.3841855067