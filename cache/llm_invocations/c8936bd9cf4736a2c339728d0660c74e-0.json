           s[i * 2 - 1].t = s[i * 2].f;\n        }\n        m *= 2;\n        for (int t = 1; t <= n + k; t++) {\n            for (int i = 1; i <= n; i++) {\n                addEdge(P(t - 1, i), P(t, i), INF, 0);\n            }\n            for (int i = 1; i <= m; i++) {\n                addEdge(P(t - 1, s[i].f), P(t, s[i].t), 1, D);\n                pl[t][i] = edges.size() - 2;\n                st[t][i] = 1;\n            }\n            addEdge(P(t, 1), T, INF, t * C);\n        }\n\n        int sav, cans = 0;\n        while ((sav = spfa()) != 0) {\n            int u = T;\n            while (u != S) {\n                int las = pre[u];\n                Edge e = edges.get(lp[u]);\n                e.cap -= sav;\n                edges.get(e.rev).cap += sav;\n                u = las;\n            }\n            cans += dis[T] * sav;\n            for (int t = 1; t <= n + n; t++) {\n                for (int i = 1; i <= m; i++) {\n                    if (edges.get(pl[t][i]).cap > 0) {\n                        st[t][i]++;\n                        addEdge(P(t - 1, s[i].f), P(t, s[i].t), 1, D * (st[t][i] * 2 - 1));\n                        pl[t][i] = edges.size() - 2;\n                    }\n                }\n            }\n        }\n        System.out.println(cans);\n        sc.close();\n    }\n}\n```", "token_logprobs": [-0.0028363734018057585, -0.5841492414474487, -2.0265558760002023e-06, -5.578839045483619e-05, -4.327203714638017e-05, 0.0, -1.680836794548668e-05, -0.0020623384043574333, -0.005276443902403116, -1.1920928244535389e-07, -8.976056415122002e-05, -0.0009199915803037584, -1.4305012882687151e-05, -0.0013896104646846652, -0.018185431137681007, -1.1920928244535389e-07, -0.28409644961357117, -4.8397800128441304e-05, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.000571326119825244, -1.4305012882687151e-05, -0.0010667116148397326, 0.0, -4.768360213347478e-06, -7.867782187531702e-06, -3.099436753473128e-06, -0.47707903385162354, 0.0, -2.3841855067985307e-07, -1.