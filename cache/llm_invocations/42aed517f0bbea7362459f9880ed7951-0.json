ing[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int h = sc.nextInt();\n        dp = new BigInteger[n + 1][n + 1];\n\n        for (int i = 0; i <= n; i++) {\n            for (int j = 0; j <= n; j++) {\n                calc(i, j);\n            }\n        }\n\n        BigInteger sum = BigInteger.ZERO;\n        for (int i = h; i <= n; i++) {\n            sum = sum.add(dp[n][i]);\n        }\n        System.out.println(sum);\n    }\n\n    static BigInteger calc(int a, int b) {\n        if (dp[a][b] != null) {\n            return dp[a][b];\n        }\n        BigInteger res;\n        if (a == 0 && b == 0) {\n            res = BigInteger.ONE;\n        } else if (a == 0 || b == 0) {\n            res = BigInteger.ZERO;\n        } else {\n            res = BigInteger.ZERO;\n            for (int m = 1; m <= a; m++) {\n                // left = calc(m-1, b-1) * sum_{i=0}^{b-1} calc(a-m, i)\n                BigInteger left = calc(m - 1, b - 1);\n                BigInteger sumLeft = BigInteger.ZERO;\n                for (int i = 0; i < b; i++) {\n                    sumLeft = sumLeft.add(calc(a - m, i));\n                }\n                left = left.multiply(sumLeft);\n\n                // right = calc(a-m, b-1) * sum_{i=0}^{b-2} calc(m-1, i)\n                BigInteger right = calc(a - m, b - 1);\n                BigInteger sumRight = BigInteger.ZERO;\n                for (int i = 0; i < b - 1; i++) {\n                    sumRight = sumRight.add(calc(m - 1, i));\n                }\n                right = right.multiply(sumRight);\n\n                res = res.add(left).add(right);\n            }\n        }\n        dp[a][b] = res;\n        return res;\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.5497195136049413e-06, 0.0, -1.1920928244535389e-07, -3.4927710657939315e-05, -2.706014311115723e-05, 0.0, -0.31326207518577576, -1.4305104514278355e-06, 0.0, -1.1920928244535389e-07, -5.48361