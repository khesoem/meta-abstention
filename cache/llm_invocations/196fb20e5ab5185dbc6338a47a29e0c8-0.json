                                   else:\n                                        c = l\n                            used[i] = used[j] = used[k] = True\n                            if c != -1:\n                                state |= tripleMask[a][b][c]\n            dp[state] = add(dp[state], current)\n            return\n        \n        match[row][col] = 1\n        nextVal = mul(current, prob[row][col])\n        if col == 6:\n            forwardSearch(nextVal, row + 1, 1)\n        else:\n            forwardSearch(nextVal, row, col + 1)\n        \n        match[row][col] = 0\n        nextVal = mul(current, sub(1, prob[row][col]))\n        if col == 6:\n            forwardSearch(nextVal, row + 1, 1)\n        else:\n            forwardSearch(nextVal, row, col + 1)\n    \n    def backwardSearch(current, row, col):\n        if not current:\n            return\n        if row == 7:\n            state = 0\n            for i in range(1, 7):\n                for j in range(i + 1, 7):\n                    for k in range(j + 1, 7):\n                        if isValid(i, j, k):\n                            state |= tripleMask[i][j][k]\n            finalAnswer = add(0, mul(current, dp[fullMask ^ state]))\n            return finalAnswer\n        \n        match[row - 3][col] = 1\n        nextVal = mul(current, prob[row][col])\n        result = 0\n        if col == 6:\n            result = add(result, backwardSearch(nextVal, row + 1, 1))\n        else:\n            result = add(result, backwardSearch(nextVal, row, col + 1))\n        \n        match[row - 3][col] = 0\n        nextVal = mul(current, sub(1, prob[row][col]))\n        if col == 6:\n            result = add(result, backwardSearch(nextVal, row + 1, 1))\n        else:\n            result = add(result, backwardSearch(nextVal, row, col + 1))\n        \n        return result\n    \n    forwardSearch(1, 1, 1)\n    \n    totalMasks = 1 << count\n    for bit in range(count):\n        for mask in range(totalMasks):\n        