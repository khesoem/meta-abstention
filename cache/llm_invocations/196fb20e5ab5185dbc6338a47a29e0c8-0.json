ch(int current, int row, int col) {\n    if (!current) return;\n    if (row == 4) {\n        bool used[7] = {false, true, true, true, true, true, true};\n        int state = 0;\n        for (int i = 1; i <= 6; ++i) {\n            for (int j = i + 1; j <= 6; ++j) {\n                for (int k = j + 1; k <= 6; ++k) {\n                    if (isValid(i, j, k)) {\n                        used[i] = used[j] = used[k] = false;\n                        int a = -1, b = -1, c = -1;\n                        for (int l = 1; l <= 6; ++l) {\n                            if (!used[l]) {\n                                if (a == -1) a = l;\n                                else if (b == -1) b = l;\n                                else c = l;\n                            }\n                        }\n                        used[i] = used[j] = used[k] = true;\n                        if (c != -1) state |= tripleMask[a][b][c];\n                    }\n                }\n            }\n        }\n        dp[state] = add(dp[state], current);\n        return;\n    }\n    match[row][col] = 1;\n    int nextVal = mul(current, prob[row][col]);\n    if (col == 6) forwardSearch(nextVal, row + 1, 1);\n    else forwardSearch(nextVal, row, col + 1);\n    match[row][col] = 0;\n    nextVal = mul(current, sub(1, prob[row][col]));\n    if (col == 6) forwardSearch(nextVal, row + 1, 1);\n    else forwardSearch(nextVal, row, col + 1);\n}\n\nvoid backwardSearch(int current, int row, int col) {\n    if (!current) return;\n    if (row == 7) {\n        int state = 0;\n        for (int i = 1; i <= 6; ++i) {\n            for (int j = i + 1; j <= 6; ++j) {\n                for (int k = j + 1; k <= 6; ++k) {\n                    if (isValid(i, j, k)) state |= tripleMask[i][j][k];\n                }\n            }\n        }\n        finalAnswer = add(finalAnswer, mul(current, dp[fullMask ^ state]));\n        return;\n    }\n    match[row - 3][col] = 1;\n    int nextVal = mul(current, prob[row][col]);\n    if (col