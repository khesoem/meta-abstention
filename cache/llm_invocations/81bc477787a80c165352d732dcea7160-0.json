ue[u] = false;\n\n            for (int idx = 0; idx < (int)adj[u].size(); ++idx) {\n                Edge& e = adj[u][idx];\n                if (e.cap > 0 && d[u] + e.cost < d[e.to]) {\n                    d[e.to] = d[u] + e.cost;\n                    par_node[e.to] = u;\n                    par_edge[e.to] = idx;\n                    if (!in_queue[e.to]) {\n                        in_queue[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (d[target] == INF) return -1;\n\n        int augment = required;\n        for (int v = target; v != source; v = par_node[v]) {\n            augment = min(augment, adj[par_node[v]][par_edge[v]].cap);\n        }\n\n        required -= augment;\n        total_cost += (ll)augment * d[target];\n\n        for (int v = target; v != source; v = par_node[v]) {\n            Edge& e = adj[par_node[v]][par_edge[v]];\n            e.cap -= augment;\n            adj[v][e.rev].cap += augment;\n        }\n    }\n    return total_cost;\n}\n\nint N, M, K, C, D;\nint A[58];\nvector<int> neighbors[58];\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout.tie(nullptr);\n\n    cin >> N >> M >> K >> C >> D;\n\n    for (int i = 0; i < K; ++i) {\n        int x; cin >> x; A[x]++;\n    }\n\n    for (int i = 0; i < M; ++i) {\n        int u, v;\n        cin >> u >> v;\n        neighbors[u].push_back(v);\n        neighbors[v].push_back(u);\n    }\n\n    reset_graph(5103, 0, 5101);\n\n    for (int i = 2; i <= N; ++i) {\n        add_edge(0, i, A[i], 0);\n    }\n\n    for (int level = 0; level <= 100; ++level) {\n        for (int node = 1; node <= N; ++node) {\n            add_edge(50 * level + node, 50 * (level + 1) + node, K, 0);\n            for (int nb : neighbors[node]) {\n                for (int k = 1; k <= K; ++k) {\n                    add_edge(50 * level + node, 50 * (level + 1) + nb, 1, D * (2 * k - 1));\n                }\n            }