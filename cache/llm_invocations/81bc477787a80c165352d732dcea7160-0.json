        total_cost += augment * d[target]\n\n        v = target\n        while v != source:\n            u = par_node[v]\n            idx = par_edge[v]\n            e = adj[u][idx]\n            e.cap -= augment\n            adj[v][e.rev].cap += augment\n            v = u\n\n    return total_cost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    K = int(data[idx]); idx += 1\n    C = int(data[idx]); idx += 1\n    D = int(data[idx]); idx += 1\n    \n    A = [0] * (N + 1)\n    for _ in range(K):\n        x = int(data[idx]); idx += 1\n        A[x] += 1\n    \n    neighbors = [[] for _ in range(N + 1)]\n    for _ in range(M):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        neighbors[u].append(v)\n        neighbors[v].append(u)\n    \n    reset_graph(5103, 0, 5101)\n    \n    for i in range(2, N + 1):\n        add_edge(0, i, A[i], 0)\n    \n    for level in range(101):\n        for node in range(1, N + 1):\n            add_edge(50 * level + node, 50 * (level + 1) + node, K, 0)\n            for nb in neighbors[node]:\n                for k in range(1, K + 1):\n                    add_edge(50 * level + node, 50 * (level + 1) + nb, 1, D * (2 * k - 1))\n    \n    for level in range(1, 102):\n        add_edge(50 * level + 1, 5101, K, C * level)\n    \n    print(min_cost_flow(K))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015817821258679032, -4.410734163684538e-06, -5.960462772236497e-07, -0.024457283318042755, -0.003979977685958147, -2.3841855067985307e-07, -0.0007114263135008514, -0.0003669780562631786, -5.960462772236497e-07, -0.0017122859135270119, -0.19317913055419922, -0.02248961851000786, -2.3841830625315197e-06, -0.018153121694922447, -2.3841855067985307e-07, -0.003650312777608633, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.2014