 t = N;\n    while (t) { ++LOG; t /= K; }\n    for (int j = 1; j <= LOG; ++j) {\n        E[j][0] = E[j-1][0];\n        EI[j][0] = EI[j-1][0];\n        for (int l = 1; l < K; ++l) {\n            E[j][0] = mul(E[j-1][l], E[j][0]);\n            EI[j][0] = mul(EI[j][0], EI[j-1][l]);\n        }\n        for (int i = 1; i < K; ++i) {\n            E[j][i] = mul(E[j-1][i-1], mul(E[j][i-1], EI[j-1][i-1]));\n            EI[j][i] = mul(E[j-1][i-1], mul(EI[j][i-1], EI[j-1][i-1]));\n        }\n    }\n}\n\nvector_ solve(ll n, vector_ v, int depth) {\n    if (n == 0) return v;\n    int w = val(n / K);\n    v = solve(n / K, v, depth + 1);\n    for (int i = 0; i < n % K; ++i)\n        v = mul(E[depth][(w + i) % K], v);\n    return v;\n}\n\nint main() {\n    scanf(\"%lld %lld\", &N, &K);\n    for (int i = 0; i < K; ++i) {\n        cur.d[i] = 1;\n        for (int j = 0; j < K; ++j) {\n            for (int l = 0; l < K; ++l) {\n                if (j == l) {\n                    M[i].d[j][l] = 1;\n                    MI[i].d[j][l] = 1;\n                } else if (j == i) {\n                    M[i].d[j][l] = 1;\n                    MI[i].d[j][l] = -1;\n                } else {\n                    M[i].d[j][l] = 0;\n                    MI[i].d[j][l] = 0;\n                }\n            }\n        }\n    }\n    precompute();\n    cur = solve(N, cur, 0);\n    ll tot = 0;\n    for (int i = 0; i < K; ++i) tot += cur.d[i];\n    --tot;\n    tot %= MOD;\n    if (tot < 0) tot += MOD;\n    while (tot % (K - 1) != 0) tot += MOD;\n    printf(\"%lld\\n\", tot / (K - 1));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n    static int K;\n    static long N;\n    static Matrix[] M, MI;\n    static Matrix[][] E, EI;\n\n    static class Matrix {\n        long[][] d;\n        Matrix() {\n            d = new long[K][K];\n        }\n        Matrix copy() {\n            Matrix c = new Matrix();\n            for (int i = 0; i < K; i++)\n                for (int j = 0; j < K; j++)\n                    c.d[i][j] = this.d[i][j];\n            return c;\n        }\n    }\n\n    static class Vector {\n        long[] d;\n        Vector() {\n            d = new long[K];\n        }\n    }\n\n    static long val(long x) {\n        if (x < K) return x;\n        return (x + val(x / K)) % K;\n    }\n\n    static Matrix mul(Matrix a, Matrix b) {\n        Matrix c = new Matrix();\n        for (int i = 0; i < K; i++) {\n            for (int j = 0; j < K; j++) {\n                long s = 0;\n                for (int l = 0; l < K; l++)\n                    s = (s + a.d[i][l] * b.d[l][j]) % MOD;\n                c.d[i][j] = s;\n            }\n        }\n        return c;\n    }\n\n    static Vector mul(Matrix a, Vector b) {\n        Vector c = new Vector();\n        for (int i = 0; i < K; i++) {\n            long s = 0;\n            for (int j = 0; j < K; j++)\n                s = (s + b.d[j] * a.d[i][j]) % MOD;\n            c.d[i] = s;\n        }\n        return c;\n    }\n\n    static void precompute() {\n        for (int i = 0; i < K; i++) {\n            E[0][i] = M[i].copy();\n            EI[0][i] = MI[i].copy();\n        }\n        int LOG = E.length - 1;\n        for (int j = 1; j <= LOG; j++) {\n            E[j][0] = E[j-1][0].copy();\n            EI[j][0] = EI[j-1][0].copy();\n            for (int l = 1; l < K; l++) {\n                E[j][0] = mul(E[j-1][l], E[j][0]);\n                EI[j][0] = mul(EI[j][0], EI[j-1][l]);\n            }\n            for (int i = 1; i < K; i++) {\n                E[j][i] = mul(E[j-1][i-1], mul(E[j][i-1], EI[j-1][i-1]));\n                EI[j][i] = mul(E[j-1][i-1], mul(EI[j][i-1], EI[j-1][i-1]));\n            }\n        }\n    }\n\n    static Vector solve(long n, Vector v, int depth) {\n        if (n == 0) return v;\n    