ply(numPhases, phaseSize);\n                long term = mod.multiply(mod.combination(n, k), e);\n                \n                if (k % 2 == 1) {\n                    total = mod.add(total, term);\n                } else {\n                    total = mod.subtract(total, term);\n                }\n            }\n            \n            bw.write(total + \"\\n\");\n            bw.flush();\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998244353L;\n        private long[] fact, invFact;\n        \n        public void build(int size) {\n            fact = new long[size];\n            invFact = new long[size];\n            \n            fact[0] = 1;\n            for (int i = 1; i < size; i++) {\n                fact[i] = (fact[i - 1] * i) % MOD;\n            }\n            \n            invFact[size - 1] = modPow(fact[size - 1], MOD - 2);\n            for (int i = size - 2; i >= 0; i--) {\n                invFact[i] = (invFact[i + 1] * (i + 1)) % MOD;\n            }\n        }\n        \n        public long combination(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n        }\n        \n        public long modInverse(int x) {\n            return modPow(x, MOD - 2);\n        }\n        \n        public long modPow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) {\n                    res = (res * base) % MOD;\n                }\n                base = (base * base) % MOD;\n                exp >>= 1;\n            }\n            return res;\n        }\n        \n        public long add(long a, long b) {\n            a += b;\n            return a >= MOD ? a - MOD : a;\n        }\n        \n        public long subtract(long a, long b) {\n            a -= b;\n            return a