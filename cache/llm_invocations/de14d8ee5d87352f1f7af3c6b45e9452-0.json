{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 11 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 11 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\nimport static java.lang.System.out;\n\n\npublic class Solution{\n    private static class Scan{\n        StringTokenizer str;\n        BufferedReader br;\n        Scan() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n            str = null;\n        }\n        Scan(InputStream x)\n        {\n            br=new BufferedReader(new InputStreamReader(x));\n            str=null;\n        }\n        String next()\n        {\n            while(str==null||!str.hasMoreElements()){\n                try{\n                    str=new StringTokenizer(br.readLine());\n                }catch (Exception e){\n                    out.println(e);\n                }\n            }\n            return str.nextToken();\n        }\n        int nextInt()\n        {\n            return Integer.parseInt(next());\n        }\n        long nextLong()\n        {\n            return  Long.parseLong(next());\n        }\n        double nextDouble()\n        {\n            return Double.parseDouble(next());\n        }\n        String nextLine()\n        {\n            try {\n                if (str == null || !str.hasMoreElements())str=new StringTokenizer(br.readLine());\n            }catch (IOException e){\n                out.println(e);\n            }\n            return str.nextToken(\"\\n\");\n        }\n    }\n    static long MOD=998244353L;\n    static int asz=200005;\n    static long BigMod(long a,long b,long m){\n        if(b==0)return 1L;\n        if(b%2==1)return a*BigMod(a,b-1,m)%m;\n        return BigMod(a*a%m,b/2,m)%m;\n    }\n    static long f[]=new long[asz];\n    static long C(int n,int k){\n        if(k>n)return 0L;\n        return f[n]*BigMod(f[k],MOD-2,MOD)%MOD*BigMod(f[n-k],MOD-2,MOD)%MOD;\n    }\n    static long solve(int n,int k){\n        long ans=0;\n        for(int i=0;i<=n-k;i++){\n            if(i%2==0)ans=(ans+C(n-k,i)*BigMod(n-k-i,n,MOD)%MOD)%MOD;\n            else ans=(ans-C(n-k,i)*BigMod(n-k-i,n,MOD)%MOD+MOD)%MOD;\n        }\n        return ans;\n    }\n    public static void main(String[] args){\n        Scan in=new Scan();\n        int t=1;\n        //t=in.nextInt();\n        for(int qq=1;qq<=t;qq++){\n            long n,k;\n            n=in.nextLong();\n            k=in.nextLong();\n            f[0]=1;\n            for(long i=1;i<=n;i++)f[(int)i]=f[(int)(i-1)]*i%MOD;\n            if(k>=n)out.println(0);\n            else if(k==0)out.println(f[(int)n]);\n            else{\n                out.println(2*C((int)n,(int)(n-k))*solve((int)n,(int)k)%MOD);\n            }\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Scan {\n    std::stringstream ss;\n    std::string line;\n    std::istream& in;\n    Scan(std::istream& input = std::cin) : in(input) {}\n    std::string next() {\n        while (!(ss >> std::ws), !(ss >> std::ws).peek() || ss.eof()) {\n            if (!std::getline(in, line)) return \"\";\n            ss.clear();\n            ss.str(line);\n        }\n        std::string token;\n        ss >> token;\n        return token;\n    }\n    int nextInt() { return std::stoi(next()); }\n    long long nextLong() { return std::stoll(next()); }\n    double nextDouble() { return std::stod(next()); }\n    std::string nextLine() {\n        if (ss.rdbuf()->in_avail() > 0) {\n            std::string rest;\n            std::getline(ss, rest);\n            return rest;\n        }\n        std::getline(in, line);\n        return line;\n    }\n};\n\nconst long long MOD = 998244353LL;\nconst int asz = 200005;\nlong long f[asz];\n\nlong long BigMod(long long a, long long b, long long m) {\n    long long res = 1LL;\n    a %= m;\n    while (b > 0) {\n        if (b & 1) res = (res * a) % m;\n        a = (a * a) % m;\n        b >>= 1;\n    }\n    return res;\n}\n\nlong long C(int n, int k) {\n    if (k > n) return 0LL;\n    return f[n] * BigMod(f[k], MOD - 2, MOD) % MOD * BigMod(f[n - k], MOD - 2, MOD) % MOD;\n}\n\nlong long solve(int n, int k) {\n    long long ans = 0;\n    for (int i = 0; i <= n - k; i++) {\n        long long term = C(n - k, i) * BigMod(n - k - i, n, MOD) % MOD;\n        if (i % 2 == 0)\n            ans = (ans + term) % MOD;\n        else\n            ans = (ans - term + MOD) % MOD;\n    }\n    return ans;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    Scan in;\n    int t = 1;\n    // t = in.nextInt();\n    for (int qq = 1; qq <= t; qq++) {\n        long long n, k;\n        n = in.nextLong();\n        k = in.nextLong();\n        f[0] = 1;\n        for (long long i = 1; i <= n; i++) {\n            f[i] = (f[i - 1] * i) % MOD;\n        }\n        if (k >= n) {\n            cout << 0 << \"\\n\";\n        } else if (k == 0) {\n            cout << f[n] % MOD << \"\\n\";\n        } else {\n            long long result = (2LL * C((int)n, (int)(n - k)) % MOD) * solve((int)n, (int)k) % MOD;\n            cout << result << \"\\n\";\n        }\n    }\n    return 0;\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.021900830790400505, -1.9623810658231378e-05, -0.22587096691131592, -2.2200749754119897e-06, -7.3458322731312364e-06, -5.512236498361744e-07, -0.0036847591400146484, -3.650518920039758e-06, -1.9361264946837764e-07, -1.9361264946837764e-07, -0.0011372390436008573, -0.6570977568626404, -0.12731578946113586, -0.023271916434168816, -1.3782830137643032e-05, -0.00319993169978261, -2.935296834039036e-06, -0.603021502494812, -0.1686794012784958, -0.00022964231902733445, -4.251091377227567e-05, -0.0005149058997631073, -1.5048530030981055e-06, -0.1565985083580017, -0.7189952731132507, -0.004953612573444843, -0.006537623703479767, -0.5157341957092285, -1.0280383548888494e-06, -0.5689654350280762, -0.11761170625686646, -0.07205028086900711, -0.389504998922348, -0.0649217814207077, -0.003269453067332506, -0.1905452460050583, -3.292907877039397e-06, -1.2352385965641588e-05, -0.000726252153981477, -0.7383670210838318, -0.266060471534729, -0.00017040544480551034, -4.320199877838604e-07, -3.531315314830863e-06, -0.10023178905248642, -2.45848218582978e-06, -5.908022285439074e-05, -4.008129963040119e-06, -0.03179539367556572, -0.30486586689949036, -0.08018781989812851, -0.0001431114797014743, -1.8624639324116288e-06, -2.2200749754119897e-06, -6.869017852295656e-06, -1.0921942703134846e-05, -3.225939872208983e-05, -4.320199877838604e-07, -0.014449776150286198, -0.4558499753475189, -0.00010545044642640278, -0.0011118779657408595, -0.03012683428823948, -2.5776860184123507e-06, -5.073596548754722e-05, -0.619926929473877, -0.12304989248514175, -0.00016718693950679153, -0.0034619139041751623, -0.3929697275161743, -1.1875571544806007e-05, -0.43790528178215027, -1.2250200510025024, -0.6521303653717041, -0.30279868841171265, -0.16922245919704437, -0.11887065321207047, -0.48405471444129944, -4.127333340875339e-06, -0.0020150020718574524, -0.00031532408320344985, -2.1008713702030946e-06, -0.011596024967