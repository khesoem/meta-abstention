n\t\tans=(ans+((cnt2-val)%mod1+mod1)%mod1)%mod2;\n\t\tfor(R int i=(!len);i<=9;i=-~i) dfs2(len+1,val*10+i);\n\t}\n}\nint main(){\n\tn=read();\n\tdfs1(0,0);\n\tfor(R int i=0;i<=6;i=-~i) sort(v[i].begin(),v[i].end());\n\tdfs2(0,0);\n\tprintf(\"%lld\\n\",ans);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn = int(input())\n\nmod1 = 998244353\nmod2 = 10**9 + 7\n\ndef check(x):\n    return x * 1000000 + 999999 <= n and x * 10000000 > n\n\n# Precompute powers of 10\npw = [1, 10, 100, 1000, 10000, 100000, 1000000]\n\n# Initialize global variables\ncnt1 = 0\nsum_list = [0] * 10\nv = [[] for _ in range(10)]\n\ndef dfs1(length, val):\n    global cnt1\n    if length > 6:\n        return\n    v[length].append((cnt1 - val + mod1) % mod1)\n    sum_list[length] += (cnt1 - val + mod1) % mod1\n    cnt1 += 1\n    for i in range(10):\n        dfs1(length + 1, val * 10 + i)\n\ncnt2 = 0\nans = 0\n\ndef dfs2(length, val):\n    global cnt2, ans\n    if val > n:\n        return\n    if check(val):\n        for i in range(7):\n            v1 = ((cnt2 + 1 - val * pw[i]) % mod1 + mod1) % mod1\n            from bisect import bisect_left\n            num = bisect_left(v[i], (mod1 - v1))\n            ans = (ans + (sum_list[i] + len(v[i]) * v1 - mod1 * (len(v[i]) - num))) % mod2\n        cnt2 += cnt1\n    else:\n        if length > 0:\n            cnt2 += 1\n        ans = (ans + ((cnt2 - val) % mod1 + mod1) % mod1) % mod2\n        for i in range(0 if length == 0 else 1, 10):\n            dfs2(length + 1, val * 10 + i)\n\n# Run the initial DFS\ndfs1(0, 0)\n\n# Sort the vectors\nfor i in range(7):\n    v[i].sort()\n\n# Run the second DFS\ndfs2(0, 0)\n\nprint(ans)\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.003481278195977211, -0.001153674442321062, -4.320199877838604e-07, -1.1517960956552997e-05, -0.3582298159599304, -0.014168919064104