) {\n                for (int i = 0; i < 128; i++) {\n                    if ((val & (1 << i)) != 0) {\n                        bits.set(i);\n                    }\n                }\n            }\n        }\n\n        public boolean get(int index) {\n            return bits.get(index);\n        }\n\n        public void set(int index) {\n            bits.set(index);\n        }\n\n        public void setAll() {\n            bits.set(0, 128);\n        }\n\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            State state = (State) o;\n            return bits.equals(state.bits);\n        }\n\n        @Override\n        public int hashCode() {\n            return bits.hashCode();\n        }\n    }\n\n    static Map<State, Integer> state_to_idx = new HashMap<>();\n    static int n, state_cnt;\n    static int[][][] edge = new int[65536][128][];\n\n    static int traverse(State s) {\n        Integer idx = state_to_idx.get(s);\n        if (idx != null) return idx;\n        int id = state_cnt++;\n        state_to_idx.put(s, id);\n        edge[id] = new int[1 << n];\n        for (int m = 0; m < (1 << n); ++m) {\n            State ns = new State();\n            for (int j = 0; j < (1 << n); ++j) {\n                if (!ns.get(j)) {\n                    ns.set(j, s.get(j));\n                }\n            }\n            for (int j = 0; j < (1 << n); ++j) {\n                if (!ns.get(j)) {\n                    for (int k = m & j; k != 0; k ^= k & -k) {\n                        int lowbit = k & -k;\n                        if (s.get(j ^ lowbit)) {\n                            ns.set(j);\n                            break;\n                        }\n                    }\n                }\n            }\n            edge[id][m] = traverse(ns);\n        }\n        return id;\n    }\n\n    static int[][] prob = new int[7][7];\n    static int[][] q = new int[7][128];\n    static long[][] f = new long[8][65536];\n\n    public static void main(String[] args) {\n        Scanner cin = new Scanner(System.in);\n        n = cin.nextInt();\n        traverse(new State(1));\n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                prob[i][j] = cin.nextInt();\n                prob[i][j] = (int) mul(prob[i][j], INV);\n            }\n        }\n\n        for (int i = 0; i < n; ++i) {\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                q[i][mask] = 1;\n                for (int k = 0; k < n; ++k) {\n                    int b = (mask >> k) & 1;\n                    int t = b == 1 ? prob[k][i] : sub(1, prob[k][i]);\n                    q[i][mask] = (int) mul(q[i][mask], t);\n                }\n            }\n        }\n\n        f[0][0] = 1;\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < state_cnt; ++j) {\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    f[i + 1][edge[j][mask]] = add((int) f[i + 1][edge[j][mask]], \n                            (int) mul(f[i][j], q[i][mask]));\n                }\n            }\n        }\n\n        State finalState = new State();\n        finalState.setAll();\n        System.out.println(f[n][state_to_idx.get(finalState)]);\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00018439977429807186, -2.145764938177308e-06, -8.344646857949556e-07, -0.0011479223612695932, -3.3854863431770355e-05, -0.020615939050912857, -0.47421932220458984, -8.22540732769994e-06, -2.622600959512056e-06, -8.511180931236595e-05, -0.012510395608842373, -0.00023064337437972426, -0.08826521039009094, -0.0015320956008508801, -6.639736966462806e-05, -2.7418097943154862e-06, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.00026127262390218675, -1.1920928244535389e-07, -8.344646857949556e-07, -1.5497195136049413e-06, 0.0, -1.1920928244535389e-07, -2.50339