{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <cstdlib>\n#include <string>\n#include <cstring>\n#include <cstdio>\n#include <algorithm>\n#include <climits>\n#include <cmath>\n#include <cctype>\n#include <stack>\n#include <queue>\n#include <list>\n#include <vector>\n#include <set>\n#include <map>\n#include <sstream>\nusing namespace std;\n\ntypedef long long LL;\nconst int INF = 0x3f3f3f3f;\nconst int MAXN = 210;\nconst int MAXE = MAXN * MAXN;\n\nstruct Edge {\n    int to, w, next;\n} edge[MAXE];\n\nconst int dir[4][2] = {{0,1},{0,-1},{1,0},{-1,0}};\n\nint n, T, src = MAXN - 1, sink = src - 1;\nint sci[15][15], cap[15][15], maze[65][15][15];\nint head[MAXN], cnt;\nbool reach[15][15][65][15][15]; // [sx][sy][time][tx][ty]\n\nvoid addEdge(int u, int v, int w) {\n    edge[cnt].to = v;\n    edge[cnt].w = w;\n    edge[cnt].next = head[u];\n    head[u] = cnt++;\n    edge[cnt].to = u;\n    edge[cnt].w = 0;\n    edge[cnt].next = head[v];\n    head[v] = cnt++;\n}\n\nint level[MAXN], cur[MAXN];\n\nbool bfs(int s, int t) {\n    memset(level, 0, sizeof(level));\n    queue<int> q;\n    q.push(s);\n    cur[s] = head[s];\n    level[s] = 1;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (int i = head[u]; i != -1; i = edge[i].next) {\n            int v = edge[i].to;\n            int w = edge[i].w;\n            if (level[v] || !w) continue;\n            level[v] = level[u] + 1;\n            cur[v] = head[v];\n            q.push(v);\n            if (v == t) return true;\n        }\n    }\n    return false;\n}\n\nint dfs(int x, int t, int flow) {\n    if (x == t) return flow;\n    int rest = flow;\n    for (int &i = cur[x]; i != -1 && rest; i = edge[i].next) {\n        int v = edge[i].to;\n        int w = edge[i].w;\n        if (w && level[v] == level[x] + 1) {\n            int k = dfs(v, t, min(rest, w));\n            if (!k) level[v] = 0;\n            edge[i].w -= k;\n            edge[i ^ 1].w += k;\n            rest -= k;\n        }\n    }\n    return flow - rest;\n}\n\nint dinic(int s, int t) {\n    int ans = 0, flow;\n    while (bfs(s, t))\n        while (flow = dfs(s, t, INF))\n            ans += flow;\n    return ans;\n}\n\nint getId(int x, int y, int k) {\n    return (x - 1) * n + y + k * n * n;\n}\n\nvoid init() {\n    memset(cur, 0, sizeof(cur));\n    memset(head, -1, sizeof(head));\n    cnt = 0;\n    // propagate Z\n    for (int time = 1; time <= T; ++time) {\n        for (int x = 1; x <= n; ++x) {\n            for (int y = 1; y <= n; ++y) {\n                if (maze[time - 1][x][y])\n                    maze[time][x][y] = maze[time - 1][x][y];\n                else {\n                    for (int d = 0; d < 4; ++d) {\n                        int xx = x + dir[d][0];\n                        int yy = y + dir[d][1];\n                        if (xx < 1 || yy < 1 || xx > n || yy > n) continue;\n                        if (maze[time - 1][xx][yy] == 2)\n                            maze[time][x][y] = 2;\n                    }\n                }\n            }\n        }\n    }\n    // BFS from each scientist to compute reachable cells within T steps\n    for (int sx = 1; sx <= n; ++sx) {\n        for (int sy = 1; sy <= n; ++sy) {\n            if (!sci[sx][sy]) continue;\n            bool visited[15][15][65] = {false};\n            queue<pair<pair<int,int>,int>> q;\n            q.push({{sx, sy}, 0});\n            visited[sx][sy][0] = true;\n            reach[sx][sy][0][sx][sy] = true;\n            while (!q.empty()) {\n                auto cur = q.front(); q.pop();\n                int cx = cur.first.first;\n                int cy = cur.first.second;\n                int step = cur.second;\n                if (step >= T) continue;\n                for (int d = 0; d < 4; ++d) {\n                    int nx = cx + dir[d][0];\n                    int ny = cy + dir[d][1];\n                    if (nx < 1 || ny < 1 || nx > n || ny > n) continue;\n                    if (maze[step + 1][nx][ny]) continue;\n                    if (visited[nx][ny][step + 1]) continue;\n                    visited[nx][ny][step + 1] = true;\n                    reach[sx][sy][step + 1][nx][ny] = true;\n                    q.push({{nx, ny}, step + 1});\n                }\n            }\n        }\n    }\n    // propagate reachability across time\n    for (int sx = 1; sx <= n; ++sx)\n        for (int sy = 1; sy <= n; ++sy)\n            for (int time = 1; time <= T; ++time)\n                for (int tx = 1; tx <= n; ++tx)\n                    for (int ty = 1; ty <= n; ++ty)\n                        reach[sx][sy][time][tx][ty] |= reach[sx][sy][time - 1][tx][ty];\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &T);\n    for (int i = 1; i <= n; ++i) {\n        char s[15];\n        scanf(\"%s\", s + 1);\n        for (int j = 1; j <= n; ++j) {\n            if (isdigit(s[j]))\n                sci[i][j] = s[j] - '0';\n            else if (s[j] == 'Y')\n                maze[0][i][j] = 1;\n            else if (s[j] == 'Z')\n                maze[0][i][j] = 2;\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        char s[15];\n        scanf(\"%s\", s + 1);