 x in range(n):\n            for y in range(n):\n                if maze[t-1][x][y] != 0:\n                    maze[t][x][y] = maze[t-1][x][y]\n                else:\n                    for dx, dy in dirs:\n                        nx, ny = x+dx, y+dy\n                        if 0 <= nx < n and 0 <= ny < n and maze[t-1][nx][ny] == 2:\n                            maze[t][x][y] = 2\n                            break\n    \n    # Build flow network\n    N = 2 * n * n + 2\n    src = 0\n    sink = 1\n    graph = [[] for _ in range(N)]\n    \n    def add_edge(u, v, cap):\n        graph[u].append([v, len(graph[v]), cap])\n        graph[v].append([u, len(graph[u])-1, 0])\n    \n    INF = 10**9\n    \n    # For each scientist, BFS to find reachable cells within T steps (including waiting)\n    for sx in range(n):\n        for sy in range(n):\n            if sci[sx][sy] == 0:\n                continue\n            # BFS with staying\n            visited = [[[False]*n for _ in range(n)] for _ in range(T+1)]\n            reachable = [[False]*n for _ in range(n)]\n            q = deque()\n            q.append((sx, sy, 0))\n            visited[0][sx][sy] = True\n            reachable[sx][sy] = True\n            while q:\n                x, y, step = q.popleft()\n                if step == T:\n                    continue\n                # staying\n                if maze[step+1][x][y] == 0 and not visited[step+1][x][y]:\n                    visited[step+1][x][y] = True\n                    reachable[x][y] = True\n                    q.append((x, y, step+1))\n                # moving\n                for dx, dy in dirs:\n                    nx, ny = x+dx, y+dy\n                    if 0 <= nx < n and 0 <= ny < n and maze[step+1][nx][ny] == 0 and not visited[step+1][nx][ny]:\n                        visited[step+1][nx][ny] = True\n                        reachable[nx][ny] = True\n                        q.append((nx, ny, step+1))\n            # Add edges from source to scientist node\n            scientist_id = 2 + sx * n + sy\n            add_edge(src, scientist_id, sci[sx][sy])\n            # Add edges from scientist to capacity nodes if reachable\n            for tx in range(n):\n                for ty in range(n):\n                    if cap[tx][ty] > 0 and reachable[tx][ty]:\n                        capacity_id = 2 + n * n + tx * n + ty\n                        add_edge(scientist_id, capacity_id, INF)\n    \n    # Add edges from capacity nodes to sink\n    for tx in range(n):\n        for ty in range(n):\n            if cap[tx][ty] > 0:\n                capacity_id = 2 + n * n + tx * n + ty\n                add_edge(capacity_id, sink, cap[tx][ty])\n    \n    # Dinic max flow\n    level = [0]*N\n    it_ptr = [0]*N\n    \n    def bfs():\n        for i in range(N):\n            level[i] = -1\n        q = deque()\n        level[src] = 0\n        q.append(src)\n        while q:\n            u = q.popleft()\n            for v, rev, w in graph[u]:\n                if w > 0 and level[v] < 0:\n                    level[v] = level[u] + 1\n                    q.append(v)\n        return level[sink] >= 0\n    \n    def dfs(u, f):\n        if u == sink:\n            return f\n        for i in range(it_ptr[u], len(graph[u])):\n            it_ptr[u] = i\n            v, rev, w = graph[u][i]\n            if w > 0 and level[u] < level[v]:\n                ret = dfs(v, min(f, w))\n                if ret > 0:\n                    graph[u][i][2] -= ret\n                    graph[v][rev][2] += ret\n                    return ret\n        return 0\n    \n    flow = 0\n    while bfs():\n        it_ptr = [0]*N\n        while True:\n            pushed = dfs(src, INF)\n            if pushed == 0:\n                break\n            flow += pushed\n    \n    print(flow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -4.410734163684538e-06, -0.0029054353944957256, -1.1920928244535389e-07,