g long mod) {\n    long long res = 1;\n    a %= mod;\n    while (b > 0) {\n        if (b & 1) res = (res * a) % mod;\n        a = (a * a) % mod;\n        b >>= 1;\n    }\n    return res;\n}\n\nvoid solve() {\n    long long P, K;\n    cin >> P >> K;\n    vector<long long> k(P);\n    for (long long x = 0; x < P; ++x) {\n        k[x] = (K * x) % P;\n    }\n\n    if (K == 0) {\n        cout << pow_mod(P, P - 1, MOD) << endl;\n        return;\n    }\n\n    vector<int> visited(P, 0);\n    vector<long long> count(P, 0);\n    long long ans = 1;\n\n    for (long long start = 0; start < P; ++start) {\n        if (visited[start]) continue;\n        long long length = 1;\n        long long u = start;\n        visited[u] = 1;\n        while (!visited[k[u]]) {\n            u = k[u];\n            visited[u] = 1;\n            length++;\n        }\n        count[length]++;\n    }\n\n    for (long long i = 1; i < P; ++i) {\n        if (count[i] > 0) {\n            long long val = i * count[i] + (i > 1 ? 1 : 0);\n            ans = (ans * pow_mod(val, count[i], MOD)) % MOD;\n        }\n    }\n\n    cout << ans << endl;\n}\n\nint main() {\n    solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-7.188061863416806e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0007468056865036488, -8.284702198579907e-05, -1.2636104656849056e-05, -0.2018761783838272, -1.3112935448589269e-05, -2.861018856492592e-06, 0.0, -2.932505594799295e-05, -0.005239208694547415, -0.05501296743750572, -9.536738616588991e-07, -0.07957936823368073, -0.12705130875110626, -0.05116976797580719, -1.311301275563892e-06, 0.0, -0.4740864932537079, -0.3882395923137665, -0.006717243697494268, -4.768360213347478e-06, -1.1920928244535389e-07, 0.0, 0.0, -1.6689160474925302e-05, 0.0, 0.0, -9.536738616588991e-07, -0.25203901529312134, -0.01105104386806488, 0.0, -0.12711776793003082, -0.00043847484630532563, -3.576278118089249e-07, 0.0, -0.2520911991596222, 0.0, -1.1920928244