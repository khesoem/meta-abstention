nt sub(int x, int y) {\n        x -= y;\n        return x < 0 ? x + MOD : x;\n    }\n\n    static int mul(int x, int y) {\n        return (int)((1L * x * y) % MOD);\n    }\n\n    static int power(int x, int e) {\n        int res = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) res = mul(res, x);\n            x = mul(x, x);\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static int inv(int x) {\n        return power(x, MOD - 2);\n    }\n\n    static int divv(int x, int y) {\n        return mul(x, inv(y));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int[][] a = new int[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                a[i][j] = sc.nextInt();\n                a[i][j] = divv(a[i][j], 100);\n            }\n        }\n\n        Map<List<Integer>, Integer> dp = new HashMap<>();\n        List<Integer> initKey = new ArrayList<>();\n        initKey.add(0);\n        dp.put(initKey, 1);\n\n        for (int col = 0; col < n; col++) {\n            Map<List<Integer>, Integer> ndp = new HashMap<>();\n            for (int mask = 0; mask < (1 << n); mask++) {\n                int prob = 1;\n                for (int row = 0; row < n; row++) {\n                    if ((mask & (1 << row)) != 0)\n                        prob = mul(prob, a[row][col]);\n                    else\n                        prob = mul(prob, sub(1, a[row][col]));\n                }\n                for (Map.Entry<List<Integer>, Integer> entry : dp.entrySet()) {\n                    Set<Integer> newSet = new TreeSet<>();\n                    for (int m : entry.getKey()) {\n                        int diff = (~m) & mask;\n                        while (diff != 0) {\n                            int bit = diff & -diff;\n                            newSet.add(m | bit);\n                            diff ^= bit;\n                        