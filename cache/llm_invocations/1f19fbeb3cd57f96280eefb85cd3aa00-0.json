routines\n  struct Edge { int v, r; ll f, c, p; };\n  vector<Edge> adj[N]; int sz[N]; ll mc;\n  void init(int n=N) { mc=0; fill(sz,sz+n,0); fill(adj,adj+n,vector<Edge>()); }\n  void add_edge(int a, int b, ll c=1, ll p=0) { mc = max(mc,c);\n    adj[a].push_back({b, sz[b]++, 0, c, p});\n    adj[b].push_back({a, sz[a]++, 0, 0, -p}); }  // change 0 to c for undirected\n\n  // Minimum cost maximum flow, assuming there are no negative cost cycles\n  // USAGE: 1) add edges 2) min_cost_flow(S, T, price, V, sparse?);\n  // use O(V^2) Dijkstra for dense graphs, and O(E*log(V)) otherwise\n  bool vis[N]; int par[N]; ll pot[N], dist[N];\n  void pot_init(int n) { fill(pot, pot+n, 0);\n    // if all edge costs >= 0, we don't need to run the Bellman-Ford here\n    for(int i=1; i<n; i++) for(int u=0; u<n; u++) for(const Edge& e:adj[u])\n      if(e.c) pot[e.v] = min(pot[e.v], pot[u] + e.p); }\n  ll mcf(int s, int t, ll& price, int n, bool sparse, ll lb=1) {\n    fill(vis, vis+n, 0); fill(dist, dist+n, INF); dist[s] = 0;\n    // only need one of the branches below\n    if(sparse) { // replace priority_queue with queue for SPFA\n      priority_queue<pair<ll,int>> dk; dk.push({0,s}); while(!dk.empty()) {\n        int u = dk.top().second; dk.pop(); if(vis[u]) continue;\n        for(const Edge& e:adj[u]) {\n          if (e.f <= e.c-lb && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r;\n            dk.push({-dist[e.v], e.v}); } } }\n    } else { // dense\n      for(int u = s; u != -1; ) { vis[u] = true; for(const Edge& e: adj[u]) {\n        if (e.f <= e.c-lb && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n          dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r; } }\n      u = -1; ll best = INF;\n      for(int i=0; i<n; i++) if(!vis[i] && dist[i]<best) best = dist[u=i]; }\n    } // end branches\n    if (dist[t] >= INF) { return 0; } ll df = INF;\n    for(int u = t; u != s; ) { const Edge& r = adj[u][par[u]];\n      df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f); u = r.v; }\n    for(int u = t; u != s; ) { Edge& r=adj[u][par[u]], &e=adj[r.v][r.r];\n      e.f += df; r.f -= df; price += df*e.p; u = r.v; }\n    for(int i=0; i<n; i++) { pot[i] = min(INF, dist[i]+pot[i]); } return df; }\n  ll min_cost_flow(int s, int t, ll& price, int n=N, bool sparse=false) {\n    pot_init(n); ll flow = price = 0;\n\t\tfor(ll lb=1<<30;lb>0;lb/=2) {\n\t\t\twhile(ll df=mcf(s, t, price, n, sparse, lb)) { flow += df; }\n\t\t} return flow; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tll price, flow = Flow::min_cost_flow(source, sink, price, sink+1, true);\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass Edge:\n    def __init__(self, v, r, f, c, p):\n        self.v = v\n        self.r = r\n        self.f = f\n        self.c = c\n        self.p = p\n\nclass Flow:\n    def __init__(self):\n        self.adj = [[] for _ in range(50*99 + 2)]\n        self.sz = [0] * (50*99 + 2)\n        self.mc = 0\n\n    def init(self, n=50*99 + 2):\n        self.mc = 0\n        self.sz = [0] * n\n        self.adj = [[] for _ in range(n)]\n\n    def add_edge(self, a, b, c=1, p=0):\n        self.mc = max(self.mc, c)\n        self.adj[a].append(Edge(b, self.sz[b], 0, c, p))\n        self.adj[b].append(Edge(a, self.sz[a], 0, 0, -p))\n        self.sz[a] += 1\n        self.sz[b] += 1\n\n    def pot_init(self, n):\n        self.pot = [0] * n\n        for i in range(1, n):\n            for u in range(n):\n                for e in self.adj[u]:\n                    if e.c:\n                        self.pot[e.v] = min(self.pot[e.v], self.pot[u] + e.p)\n\n    def mcf(self, s, t, price, n, sparse, lb=1):\n        self.vis = [False] * n\n        self.par = [0] * n\n        self.dist = [float('inf')] * n\n        self.dist[s] = 0\n        if sparse:\n            self.dk = []\n            heapq.heappush(self.dk, (0, s))\n            while self.dk:\n                u = heapq.heappop(self.dk)[1]\n                if self.vis[u]:\n                    continue\n                self.vis[u] = True\n                for e in self.adj[u]:\n                    if e.f <= e.c - lb and self.dist[e.v] > self.dist[u] + self.pot[u] - self.pot[e.v] + e.p:\n                        self.dist[e.v] = self.dist[u] + self.pot[u] - self.pot[e.v] + e.p\n                        self.par[e.v] = e.r\n                        heapq.heappush(self.dk, (-self.dist[e.v], e.v))\n        else:\n            for u in range(s, -1, -1):\n                self.vis[u] = True\n                for e in self.adj[u]:\n                    if e.f <= e.c - lb and self.dist[e.v] > self.dist[u] + self.pot[u] - self.pot[e.v] + e.p:\n                        self.dist[e.v] = self.dist[u] + self.pot[u] - self.pot[e.v] + e.p\n                        self.par[e.v] = e.r\n            best = float('inf')\n            for i in range(n):\n                if not self.vis[i] and self.dist[i] < best:\n                    best = self.dist[i]\n                    u = i\n            if best == float('inf'):\n                return 0\n            df = float('inf')\n            for u in range(t, s, -1):\n                e = self.adj[u][self.par[u]]\n                df = min(df, self.adj[e.v][e.r].c - self.adj[e.v][e.r].f)\n            for u in range(t, s, -1):\n                e = self.adj[u][self.par[u]]\n                e.f += df\n                self.adj[e.v][e.r].f -= df\n                price += df * e.p\n        for i in range(n):\n            self.pot[i] = min(float('inf'), self.dist[i] + self.pot[i])\n        return df\n\n    def min_cost_flow(self, s, t, price, n=50*99 + 2, sparse=False):\n        self.pot_init(n)\n        flow = price = 0\n        lb = 1 << 30\n        while lb > 0:\n            while True:\n                df = self.mcf(s, t, price, n, sparse, lb)\n                if df == 0:\n                    break\n                flow += df\n            lb //= 2\n        return flow\n\ndef main():\n    flow = Flow()\n    flow.init()\n    n, m, k, c, d = map(int, input().split())\n    source = 0\n    sink = n * 99 + 1\n    for i in range(k):\n        a = int(input())\n        flow.add_edge(source, a, 1, 0)\n    for t in range(99):\n        flow.add_edge(1 + t * n, sink, float('inf'), 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow.add_edge(i + (t - 1) * n, i + t * n, float('inf'), c)\n    for i in range(m):\n        a, b = map(int, input().split())\n        for j in range(12):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, 99):\n                flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n    price, flow = flow.min_cost_flow(source, sink, price, sink + 1, True)\n    assert flow == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.10283470898866653, -0.00018771264876704663, -0.10124167799949646,