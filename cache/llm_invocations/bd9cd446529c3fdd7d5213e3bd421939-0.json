imag, True)\n    fft(fb_real, fb_imag, True)\n    \n    res = [0] * need\n    for i in range(need):\n        aa = int(fa_real[i] + 0.5)\n        bb = int(fb_real[i] + 0.5)\n        cc = int(fa_imag[i] + 0.5)\n        res[i] = (aa + ((bb % mod) << 15) + ((cc % mod) << 30)) % mod\n    return res\n\ndef fft(a, b, inverse):\n    n = len(a)\n    # bit-reversal permutation\n    bits = n.bit_length() - 1  # since n is power of two\n    for i in range(1, n):\n        # reverse bits of i (bits bits)\n        j = int(bin(i)[2:].zfill(bits)[::-1], 2)\n        if i < j:\n            a[i], a[j] = a[j], a[i]\n            b[i], b[j] = b[j], b[i]\n    \n    length = 2\n    while length <= n:\n        half = length // 2\n        # precompute cos and sin for this length\n        cs = [0.0] * half\n        sn = [0.0] * half\n        for i in range(half):\n            angle = 2.0 * math.pi * i / length\n            if inverse:\n                angle = -angle\n            cs[i] = math.cos(angle)\n            sn[i] = math.sin(angle)\n        for i in range(0, n, length):\n            for j in range(half):\n                wA = cs[j]\n                wB = sn[j]\n                uA = a[i + j]\n                uB = b[i + j]\n                vA = a[i + j + half] * wA - b[i + j + half] * wB\n                vB = a[i + j + half] * wB + b[i + j + half] * wA\n                a[i + j] = uA + vA\n                b[i + j] = uB + vB\n                a[i + j + half] = uA - vA\n                b[i + j + half] = uB - vB\n        length <<= 1\n    \n    if inverse:\n        for i in range(n):\n            a[i] /= n\n            b[i] /= n\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    v = [0] * 10\n    for _ in range(k):\n        x = int(next(it))\n        v[x] = 1\n    ans = [1]\n    p = n // 2\n    while p > 0:\n        if p & 1:\n            ans = multiply_mod(ans, v, MOD)\n        p //= 2\n        if p > 0:\n        