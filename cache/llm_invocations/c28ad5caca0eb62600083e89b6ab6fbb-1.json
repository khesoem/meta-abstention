self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g %= r\n                g, r = r, g\n                x -= q * y\n                x, y = y, x\n            if g != 1:\n                raise AssertionError()\n            if y != self.modulus() and y != -self.modulus():\n                raise AssertionError()\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    raise RuntimeError()\n                self.tokenizer = line.strip().split()\n            except Exception as e:\n                raise RuntimeError(e)\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    input_index = 0\n\n    def next_input():\n        nonlocal input_index\n        val = input_data[input_index]\n        input_index += 1\n        return val\n\n    n = int(next_input())\n    m = int(next_input())\n\n    mod = NumberTheory.Mod998()\n    mod.fInv(n + m)\n\n    phase_size = 1\n    p = 1\n    for i in range(n + 1):\n        if p == 0:\n            break\n        p = mod.mult(p, n - i, mod.smallInv(n + m - i))\n        phase_size = mod.add(phase_size, p)\n\n    answer = 0\n    for k in range(1, n + 1):\n        term = mod.mult(mod.parity_sign(k + 1), mod.ncr(n, k), m + k, mod.smallInv(k), phase_size)\n        answer = mod.add(answer, term)\n\n    print(answer)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-9.583967766957358e-05, -9.536738616588991e-07, -7.152555099310121e-07, -0.004079116974025965, -0.023551832884550095, -0.0029066239949315786, -0.14269845187664032, -0.26331809163093567, -0.018271584063768387, -0.049199093133211136, -0.9502516984939575, -2.145764938177308e-06, -1.1920922133867862e-06, -2.3841855067985307e-07, -1.311301275563892e-06, -0.00025376438861712813, -9.536738616588991e-07, -1.1920928244535389e-07, -1.6689286894688848e-06, -0.005234109237790108, -6.318072337307967e-06, -1.7881377516459906e-06, -1.1920928244535389e-07, -3.6954811548639555e-06, -4.172316494077677e-06, -2.0265558760002023e-06, -6.9141146923357155e-06, -5.960462772236497e-07, -0.0019365858752280474, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, -3.4570634852570947e-06, -5.960462772236497e-07, -3.576278118089249e-07, 0.0, -1.1920922133867862e-06, -5.578839045483619e-05, 0.0, 0.0, -0.07902425527572632, -2.3841855067985307e-07, -5.960462772236497e-07, -1.811964830267243e-05, 0.0, 0.0, -2.3841855067985307e-07, -4.410734163684538e-06, -5.125986263010418e-06, -8.344646857949556e-07, -8.344646857949556e-07, -4.768370445162873e-07, -1.5497195136049413e-06, -6.318072337307967e-06, -8.344646857949556e-07, -0.00020919041708111763, -1.5497195136049413e-06, -3.2186455882765586e-06, -0.018166817724704742, -0.06350471824407578, -0.002141922013834119, -1.2159273865108844e-05, -0.0010055014863610268, -8.511180931236595e-05, -0.00