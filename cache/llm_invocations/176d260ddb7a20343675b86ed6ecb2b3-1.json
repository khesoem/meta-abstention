 import defaultdict\n\nONLINE_JUDGE = os.environ.get(\"ONLINE_JUDGE\") is not None\n\nclass J:\n    def __init__(self):\n        self.in_stream = sys.stdin\n        self.out_stream = sys.stdout\n        self.tok = []\n        self.time_begin = 0\n        self.time_end = 0\n\n    def init(self):\n        if ONLINE_JUDGE:\n            self.in_stream = sys.stdin\n            self.out_stream = sys.stdout\n        else:\n            try:\n                self.in_stream = open(\"input.txt\", \"r\")\n                self.out_stream = open(\"output.txt\", \"w\")\n            except FileNotFoundError:\n                self.in_stream = sys.stdin\n                self.out_stream = sys.stdout\n\n    def read_string(self):\n        while not self.tok:\n            line = self.in_stream.readline()\n            if not line:\n                raise EOFError()\n            self.tok = line.strip().split()\n        return self.tok.pop(0)\n\n    def read_int(self):\n        return int(self.read_string())\n\n    def read_long(self):\n        return int(self.read_string())\n\n    def read_double(self):\n        return float(self.read_string())\n\n    def read_int_array(self, size):\n        return [self.read_int() for _ in range(size)]\n\n    def count(self, s, target, v, k, x):\n        answer = 0\n        for c in s:\n            if c == 'V':\n                v -= 1\n                if v == 0 and target == 'V':\n                    return answer\n                if v < 0:\n                    answer += 1\n            if c == 'K':\n                k -= 1\n                if k == 0 and target == 'K':\n                    return answer\n                if k < 0:\n                    answer += 1\n            if c == 'X':\n                x -= 1\n                if x == 0 and target == 'X':\n                    return answer\n                if x < 0:\n                    answer += 1\n        raise RuntimeError(\"Unexpected end in count function\")\n\n    def solve(self):\n        n = self.read_int()\n        s = list(self.read_string())\n        vcnt = 0\n        kcnt = 0\n        xcnt = 0\n        for i in range(len(s)):\n            if s[i] == 'V':\n                vcnt += 1\n                continue\n            if s[i] == 'K':\n                kcnt += 1\n                continue\n            xcnt += 1\n            s[i] = 'X'\n        \n        INF = 10000000\n        dp = [[[ [INF] * 3 for _ in range(xcnt + 1)] for _ in range(kcnt + 1)] for _ in range(vcnt + 1)]\n        \n        dp[0][0][0][0] = 0\n        dp[0][0][0][1] = 0\n        dp[0][0][0][2] = 0\n        \n        for v in range(vcnt + 1):\n            for k in range(kcnt + 1):\n                for x in range(xcnt + 1):\n                    rv = self.count(s, 'V', v + 1, k, x) if v + 1 <= vcnt else 0\n                    rk = self.count(s, 'K', v, k + 1, x) if k + 1 <= kcnt else 0\n                    rx = self.count(s, 'X', v, k, x + 1) if x + 1 <= xcnt else 0\n                    \n                    for now in range(3):\n                        if v + 1 <= vcnt:\n                            dp[v + 1][k][x][0] = min(dp[v + 1][k][x][0], dp[v][k][x][now] + rv)\n                        if now != 0 and k + 1 <= kcnt:\n                            dp[v][k + 1][x][1] = min(dp[v][k + 1][x][1], dp[v][k][x][now] + rk)\n                        if x + 1 <= xcnt:\n                            dp[v][k][x + 1][2] = min(dp[v][k][x + 1][2], dp[v][k][x][now] + rx)\n        \n        res = INF\n        for i in range(3):\n            res = min(res, dp[vcnt][kcnt][xcnt][i])\n        self.out_stream.write(str(res) + \"\\n\")\n\n    def time_func(self):\n        self.time_end = self.time_begin\n        sys.stderr.write(\"Time = \" + str(self.time_end - self.time_begin) + \"\\n\")\n\n    def run(self):\n        try:\n            self.time_begin = 0\n            self.init()\n            self.solve()\n            if not ONLINE_JUDGE:\n                self.out_stream.close()\n            self.time_func()\n      