); out.flush(); debugCount++; }\n    }\n    public static void main(String args[]) throws IOException {\n        scan = new MyScanner(new BufferedReader(new InputStreamReader(System.in)));\n        out = new PrintWriter(new BufferedWriter(new OutputStreamWriter(System.out)));\n        new Main().execute();\n        out.close();\n    }\n    int N, M, pow;\n    int[] counts;\n    int[][][] dp;\n    void execute() {\n        N = scan.nextInt();\n        M = scan.nextInt();\n        if (N < M) { int t = N; N = M; M = t; }\n        pow = 1 << M;\n        counts = new int[pow];\n        dp = new int[N][pow][pow];\n        for (int[][] a : dp) for (int[] b : a) Arrays.fill(b, -1);\n        for (int i = 0; i < pow; i++) { counts[i] = Integer.bitCount(i); dp[0][i][0] = counts[i]; }\n        int spiders = Integer.MAX_VALUE;\n        for (int y = 0; y < N - 1; y++) {\n            for (int i = 0; i < pow; i++) {\n                for (int j = 0; j < pow; j++) {\n                    if (dp[y][i][j] == -1) continue;\n                    for (int k = 0; k < pow; k++) {\n                        if (((i | (i << 1) | (i >> 1) | j | k) & (pow - 1)) == (pow - 1)) {\n                            int v = dp[y][i][j] + counts[k];\n                            if (dp[y + 1][k][i] == -1 || dp[y + 1][k][i] > v) dp[y + 1][k][i] = v;\n                        }\n                    }\n                }\n            }\n        }\n        for (int i = 0; i < pow; i++) {\n            for (int j = 0; j < pow; j++) {\n                if (dp[N - 1][i][j] != -1 && ((i | (i << 1) | (i >> 1) | j) & (pow - 1)) == (pow - 1))\n                    spiders = Math.min(spiders, dp[N - 1][i][j]);\n            }\n        }\n        out.println((N * M) - spiders);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\n_DEBUG = False\n\nclass MyScanner:\n    def __init__(self, reader):\n        self.reader = reader\n        self.st = None\n\n    def next(self):\n        while self.st is None or not self.st.hasMoreElements():\n            try:\n                line = self.reader.readline()\n                if not line:\n                    return \"\"\n                self.st = iter(line.split())\n            except Exception as e:\n                print(e, file=sys.stderr)\n                return \"\"\n        return next(self.st)\n\n    def nextInt(self):\n        return int(self.next())\n\n    def nextLong(self):\n        return long(self.next())  # Python 3 doesn't have long, but int is arbitrary precision\n\n    def nextDouble(self):\n        return float(self.next())\n\n    def nextLine(self):\n        try:\n            return self.reader.readline().rstrip('\\n')\n        except Exception as e:\n            print(e, file=sys.stderr)\n            return \"\"\n\ndef debug(msg):\n    global debugCount\n    if _DEBUG and debugCount < 200:\n        print(msg, file=sys.stderr)\n        debugCount += 1\n\ndef execute():\n    global N, M, pow, counts, dp\n    N = scan.nextInt()\n    M = scan.nextInt()\n    if N < M:\n        N, M = M, N\n    pow = 1 << M\n    counts = [0] * pow\n    for i in range(pow):\n        counts[i] = i.bit_count()\n    # dp: list of N x pow x pow, initialized to -1\n    dp = [[[-1] * pow for _ in range(pow)] for __ in range(N)]\n    for i in range(pow):\n        dp[0][i][0] = counts[i]\n    for y in range(N - 1):\n        for i in range(pow):\n            for j in range(pow):\n                if dp[y][i][j] == -1:\n                    continue\n                for k in range(pow):\n                    if ((i | (i << 1) | (i >> 1) | j | k) & (pow - 1)) == (pow - 1):\n                        v = dp[y][i][j] + counts[k]\n                        if dp[y + 1][k][i] == -1 or dp[y + 1][k][i] > v:\n                            dp[y + 1][k][i] = v\n    spiders = float('inf')\n    for i in range(pow):\n        for j in range(pow):\n 