      state >>= 1;\n            }\n            return count;\n        }\n\n        private void sanityCheck() {\n            if (!isBitSet(5, 0)) throw new AssertionError();\n            if (isBitSet(5, 1)) throw new AssertionError();\n            if (isBitSet(5, -1)) throw new AssertionError();\n            if (!isBitSet(5, 2)) throw new AssertionError();\n            if (!isBitSet(5, 3)) throw new AssertionError();\n            if (setBit(0, 2) != 4) throw new AssertionError();\n            if (setBit(4, 0) != 5) throw new AssertionError();\n            if (setBit(5, 0) != 5) throw new AssertionError();\n            if (popCount(5) != 2) throw new AssertionError();\n        }\n\n        private int computeDP(int level, int needed, int prevPattern) {\n            if (level == rows) {\n                return (needed == 0) ? 0 : BAD;\n            }\n            IntIntPair pair = new IntIntPair(needed, prevPattern);\n            if (dpMemo[level].containsKey(pair)) {\n                return dpMemo[level].get(pair);\n            }\n            int best = BAD;\n            int maxConfigs = 1 << cols;\n            for (int cfg = 0; cfg < maxConfigs; cfg++) {\n                int current = 0;\n                for (int j = 0; j < cols; j++) {\n                    if (((cfg >> j) & 1) == 1) {\n                        current |= (1 << j);\n                    }\n                }\n                boolean ok = true;\n                for (int k = 0; k < cols; k++) {\n                    if (((needed >> k) & 1) == 1 && (((current >> k) & 1) == 0)) {\n                        ok = false;\n                        break;\n                    }\n                }\n                if (ok) {\n                    int future = 0;\n                    for (int j = 0; j < cols; j++) {\n                        if (!isBitSet(current, j - 1) && !isBitSet(current, j) &&\n                            !isBitSet(current, j + 1) && !isBitSet(prevPattern, j)) {\n                            future |