) - 1));\n        }\n\n        int compute(int source, int target, int requiredFlow) {\n            int totalFlow = 0, totalExpense = 0;\n            Arrays.fill(potential, 0, nodeCount + 1, 0);\n            while (requiredFlow > 0) {\n                PriorityQueue<int[]> heap = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                Arrays.fill(distance, 0, nodeCount + 1, INF);\n                distance[source] = 0;\n                heap.offer(new int[]{0, source});\n                while (!heap.isEmpty()) {\n                    int[] top = heap.poll();\n                    int d = top[0], u = top[1];\n                    if (d > distance[u]) continue;\n                    for (int idx = 0; idx < graph[u].size(); ++idx) {\n                        Edge e = graph[u].get(idx);\n                        if (e.cap > 0 && distance[e.dest] > distance[u] + e.cost + potential[u] - potential[e.dest]) {\n                            distance[e.dest] = distance[u] + e.cost + potential[u] - potential[e.dest];\n                            parentV[e.dest] = u;\n                            parentE[e.dest] = idx;\n                            heap.offer(new int[]{distance[e.dest], e.dest});\n                        }\n                    }\n                }\n                if (distance[target] == INF) break;\n                for (int i = 0; i <= nodeCount; ++i) {\n                    potential[i] += distance[i];\n                }\n                int augment = requiredFlow;\n                for (int v = target; v != source; v = parentV[v]) {\n                    Edge e = graph[parentV[v]].get(parentE[v]);\n                    augment = Math.min(augment, e.cap);\n                }\n                requiredFlow -= augment;\n                totalFlow += augment;\n                totalExpense += augment * potential[target];\n                for (int v = target; v != source; v = parentV[v]) {\n                    Edge e = graph[parentV[v]].get(parentE[v]);\n                    e.cap -= augment;\n                    graph[v].get(e.reverse).cap += augment;\n                }\n            }\n            return totalExpense;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MinCostFlow solver = new MinCostFlow();\n        solver.setup(n * (n + 55) + 2);\n\n        for (int i = 0; i < k; ++i) {\n            int u = sc.nextInt();\n            solver.connect(0, u, 1, 0);\n        }\n\n        int[][] edgeList = new int[m][2];\n        for (int i = 0; i < m; ++i) {\n            edgeList[i][0] = sc.nextInt();\n            edgeList[i][1] = sc.nextInt();\n        }\n\n        int sink = n * (n + 55) + 1;\n        for (int t = 0; t < n + 54; ++t) {\n            for (int[] e : edgeList) {\n                for (int j = 1; j <= k; ++j) {\n                    int cost = c + d * (2 * j - 1);\n                    solver.connect(e[0] + t * n, e[1] + (t + 1) * n, 1, cost);\n                    solver.connect(e[1] + t * n, e[0] + (t + 1) * n, 1, cost);\n                }\n            }\n            for (int i = 2; i <= n; ++i) {\n                solver.connect(i + t * n, i + (t + 1) * n, k, c);\n            }\n            solver.connect(1 + t * n, sink, k, 0);\n        }\n\n        System.out.println(solver.compute(0, sink, k));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014256415306590497, -3.2186455882765586e-06, -3.576278118089249e-07, -0.005397390574216843, -5.674201020156033e-05, -0.22541776299476624, -0.03372795134782791, -2.13382354559144e-05, -1.1920928244535389e-07, -0.00011276562872808427, -0.020542368292808533, -3.564294092939235e-05, -0.0033956270199269056, -0.2851330637931824, -5.328513361746445e-05, -3.290122185717337e-05, 0.0, -1.91925118997460