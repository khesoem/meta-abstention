, vector<PII>, greater<PII>> heap;\n            fill(distance, distance + nodeCount + 1, INF);\n            distance[source] = 0;\n            heap.emplace(0, source);\n            while (!heap.empty()) {\n                auto [d, u] = heap.top(); heap.pop();\n                if (d > distance[u]) continue;\n                for (int idx = 0; idx < graph[u].size(); ++idx) {\n                    auto& e = graph[u][idx];\n                    if (e.cap > 0 && distance[e.dest] > distance[u] + e.cost + potential[u] - potential[e.dest]) {\n                        distance[e.dest] = distance[u] + e.cost + potential[u] - potential[e.dest];\n                        parentV[e.dest] = u;\n                        parentE[e.dest] = idx;\n                        heap.emplace(distance[e.dest], e.dest);\n                    }\n                }\n            }\n            if (distance[target] == INF) break;\n            for (int i = 0; i <= nodeCount; ++i) potential[i] += distance[i];\n            int augment = requiredFlow;\n            for (int v = target; v != source; v = parentV[v])\n                augment = min(augment, graph[parentV[v]][parentE[v]].cap);\n            requiredFlow -= augment;\n            totalFlow += augment;\n            totalExpense += augment * potential[target];\n            for (int v = target; v != source; v = parentV[v]) {\n                auto& e = graph[parentV[v]][parentE[v]];\n                e.cap -= augment;\n                graph[v][e.reverse].cap += augment;\n            }\n        }\n        return totalExpense;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    MinCostFlow solver;\n    solver.setup(n * (n + 55) + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int u; cin >> u;\n        solver.connect(0, u, 1, 0);\n    }\n\n    vector<PII> edgeList(m);\n    for (int i = 0; i < m; ++i) {\n        cin >> edgeList[i].first >> edgeList[i].second;\