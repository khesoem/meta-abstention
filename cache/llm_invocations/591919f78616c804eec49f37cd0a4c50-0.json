f i != curA or j != curB:\n                    ways = (comb[groupA - curA][i - curA] * comb[groupB - curB][j - curB]) % MOD\n                    next_state = encode(1, i, j)\n                    apply(next_state, state, ways)\n\ndef main():\n    global n, k, groupA, groupB\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k = int(data[1])\n    groupA = 0\n    groupB = 0\n    index = 2\n    for i in range(n):\n        w = int(data[index])\n        index += 1\n        if w == 50:\n            groupA += 1\n        else:\n            groupB += 1\n\n    precompute()\n    start = encode(1, groupA, groupB)\n    queue.append(start)\n    info[start] = Info(0, 1)\n\n    while queue:\n        cur = queue.popleft()\n        process(cur)\n\n    res = info.get(0)\n    if res is not None:\n        print(f\"{res.level}\\n{res.count}\")\n    else:\n        print(\"-1\\n0\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.23184028477408e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -0.5761010050773621, -0.1136619970202446, -4.0531076592742465e-06, -1.823885577323381e-05, -0.00010561384988250211, -2.3841855067985307e-07, -0.003624063218012452, -0.20148058235645294, -9.154854342341423e-05, -2.002696055569686e-05, -0.17239752411842346, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -7.521823135903105e-05, 0.0, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.47407978773117065, -0.007886935956776142, -4.291525328881107e-06, -0.00019095504831057042, -3.576278118089249e-07, -0.0022259000688791275, -3.576278118089249e-07, 0.0, 0.0, -7.152555099310121e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -6.437280717364047e-06, -6.9141146923357155e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -5.960462772236497e-07, -0.3869320750236511, -0.06664