n        while (e) {\n            if (e & 1) res *= a;\n            a *= a;\n            e >>= 1;\n        }\n        return res;\n    }\n    \n    friend Mod operator+(Mod a, const Mod& b) { return a += b; }\n    friend Mod operator-(Mod a, const Mod& b) { return a -= b; }\n    friend Mod operator*(Mod a, const Mod& b) { return a *= b; }\n    friend Mod operator/(Mod a, const Mod& b) { return a /= b; }\n};\n\nusing mi = Mod;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n;\n    cin >> n;\n    \n    vector<vector<mi>> p(n, vector<mi>(n));\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            double x;\n            cin >> x;\n            p[i][j] = (int)(x / 100.0 * MOD + 0.5);\n        }\n    }\n    \n    vector<unsigned long long> no(n);\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < (1 << n); ++j) {\n            if (!(j & (1 << i))) {\n                no[i] |= (1ULL << j);\n            }\n        }\n    }\n    \n    unordered_map<unsigned long long, mi> dp;\n    dp[1] = mi(1);\n    \n    for (int round = 0; round < n; ++round) {\n        unordered_map<unsigned long long, mi> ndp;\n        for (const auto& [mask, prob] : dp) {\n            for (int outcome = 0; outcome < (1 << n); ++outcome) {\n                unsigned long long next_mask = 0;\n                mi cur_prob = mi(1);\n                for (int k = 0; k < n; ++k) {\n                    if (outcome & (1 << k)) {\n                        cur_prob *= p[round][k];\n                        next_mask |= (mask & no[k]) << (1ULL << k);\n                    } else {\n                        cur_prob *= (mi(1) - p[round][k]);\n                    }\n                }\n                ndp[next_mask] += prob * cur_prob;\n            }\n        }\n        dp = move(ndp);\n    }\n    \n    cout << dp[1ULL << ((1 << n) - 1)].v << \"\\n\";\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": tr