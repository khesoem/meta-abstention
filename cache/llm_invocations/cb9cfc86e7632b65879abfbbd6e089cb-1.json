owers of w and w_inv\n        self.warr[0] = 1\n        self.winvarr[0] = 1\n        for i in range(1, self.sz):\n            self.warr[i] = (self.warr[i-1] * self.w) % self.mod\n            self.winvarr[i] = (self.winvarr[i-1] * self.winv) % self.mod\n\n    class FastScanner:\n        def __init__(self, stream):\n            self.lines = []\n            self.pos = 0\n            self.stream = stream\n            \n        def read_input(self):\n            for line in self.stream:\n                self.lines.extend(line.strip().split())\n                \n        def next(self):\n            if self.pos >= len(self.lines):\n                self.read_input()\n            if self.pos >= len(self.lines):\n                return None\n            token = self.lines[self.pos]\n            self.pos += 1\n            return token\n            \n        def nextInt(self):\n            return int(self.next())\n            \n        def nextLong(self):\n            return int(self.next())\n\n    class Vector:\n        def __init__(self, a, fft_instance):\n            self.sz = fft_instance.sz\n            self.v = [0] * self.sz\n            for i in range(len(a)):\n                self.v[i] = a[i] % fft_instance.mod\n            self.fft = fft_instance\n            \n        def FFT(self):\n            return self.DFT(0, 1, True)\n            \n        def FFT1(self):\n            x = self.DFT(0, 1, False)\n            for i in range(len(x)):\n                x[i] = (x[i] * self.fft.szinv) % self.fft.mod\n            return x\n            \n        def DFT(self, first, pow_val, straight):\n            if pow_val == self.sz:\n                return [self.v[first]]\n                \n            zero = self.DFT(first, 2 * pow_val, straight)\n            one = self.DFT(first + pow_val, 2 * pow_val, straight)\n            n = len(zero)\n            ans = [0] * (2 * n)\n            \n            for i in range(n):\n                w_factor = self.fft.warr[i * pow_val] if straight else self.fft.winvarr[i * pow_val]\n                ans[i] = (zero[i] + w_factor * one[i]) % self.fft.mod\n                \n            for i in range(n):\n                w_factor = self.fft.warr[i * pow_val] if straight else self.fft.winvarr[i * pow_val]\n                ans[n + i] = ((zero[i] - w_factor * one[i]) % self.fft.mod + self.fft.mod) % self.fft.mod\n                \n            return ans\n\n    def fft(self, a):\n        ans = [0] * self.sz\n        wth = 1\n        for i in range(self.sz):\n            x = 1\n            for j in range(len(a)):\n                ans[i] = (ans[i] + a[j] * x) % self.mod\n                x = (x * wth) % self.mod\n            wth = (wth * self.w) % self.mod\n        return ans\n\n    def pow_arr(self, ans, p):\n        for i in range(len(ans)):\n            ans[i] = self.pow(ans[i], p)\n        return ans\n\n    def pow(self, x, p):\n        if p == 0:\n            return 1\n        if p % 2 == 1:\n            return (self.pow(x, p - 1) * x) % self.mod\n        y = self.pow(x, p // 2)\n        return (y * y) % self.mod\n\n    def solve(self):\n        scanner = self.FastScanner(self.in_stream)\n        scanner.read_input()\n        \n        n = scanner.nextInt()\n        k = scanner.nextInt()\n        arr = [0] * 10\n        for _ in range(k):\n            idx = scanner.nextInt()\n            if idx < len(arr):\n                arr[idx] = 1\n                \n        x = self.fft(arr)\n        x = self.pow_arr(x, n // 2)\n        v = self.Vector(x, self)\n        x = v.FFT1()\n        ans = 0\n        for i in range(len(x)):\n            ans = (ans + x[i] * x[i]) % self.mod\n        self.out.write(str(ans) + \"\\n\")\n\n    def run(self):\n        try:\n            self.solve()\n            self.out.close()\n        except Exception as e:\n            print(e)\n\nif __name__ == \"__main__\":\n    fft_instance = FFT()\n    fft_instance.run()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-6.