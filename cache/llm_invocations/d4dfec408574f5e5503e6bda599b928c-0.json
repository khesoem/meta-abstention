i] = fact[i-1] * i % m;\n    }\n    for (int i = 2; i <= limit; ++i) {\n        inv_table[i] = inv_table[i-1] * inv_table[i] % m;\n    }\n}\n\ni64 dp[20][250005];\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int k;\n    cin >> global_n >> k >> global_mod;\n    init_combinatorics(global_n + 5, global_mod);\n    \n    if (global_n % 2 == 1) {\n        cout << mod_pow(k, global_n, global_mod) << '\\n';\n        return 0;\n    }\n    \n    subset_list.clear();\n    for (int i = 2; i <= global_n; i += 2) {\n        if ((i & global_n) == i) {\n            subset_list.push_back(i);\n        }\n    }\n    \n    memset(dp, 0, sizeof(dp));\n    dp[0][global_n] = 1;\n    i64 total = 0;\n    int max_layer = min(17, k);\n    \n    for (int layer = 1; layer <= max_layer; ++layer) {\n        i64 layer_sum = 0;\n        for (int idx = 0; idx < (int)subset_list.size(); ++idx) {\n            int val = subset_list[idx];\n            if (dp[layer-1][val] == 0) continue;\n            \n            int sub = val & (val - 1);\n            int delta = sub ^ val;\n            \n            for (int cur = delta; cur <= sub; cur += delta) {\n                if ((cur & sub) == cur) {\n                    dp[layer][cur] = (dp[layer][cur] + \n                        dp[layer-1][val] * fact[val] % global_mod * \n                        inv_table[cur] % global_mod * inv_table[val - cur] % global_mod) % global_mod;\n                }\n            }\n            layer_sum = (layer_sum + dp[layer-1][val]) % global_mod;\n        }\n        total = (total + layer_sum * inv_table[k - layer] % global_mod) % global_mod;\n    }\n    \n    total = total * fact[k] % global_mod;\n    i64 result = (mod_pow(k, global_n, global_mod) - total % global_mod + global_mod) % global_mod;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"cont