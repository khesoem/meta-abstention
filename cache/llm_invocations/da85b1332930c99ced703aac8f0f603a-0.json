heoretical_max = min(a1, b2) + min(a2, b3) + min(a3, b1)\n    \n    optimal = 0\n    for ordering in itertools.permutations([1, 2, 3, 4, 5, 6]):\n        ra1, ra2, ra3 = a1, a2, a3\n        rb1, rb2, rb3 = b1, b2, b3\n        matched = 0\n        \n        for choice in ordering:\n            if choice == 1:\n                match = min(ra1, rb1)\n                ra1 -= match\n                rb1 -= match\n                matched += match\n            elif choice == 2:\n                match = min(ra1, rb3)\n                ra1 -= match\n                rb3 -= match\n                matched += match\n            elif choice == 3:\n                match = min(ra2, rb2)\n                ra2 -= match\n                rb2 -= match\n                matched += match\n            elif choice == 4:\n                match = min(ra2, rb1)\n                ra2 -= match\n                rb1 -= match\n                matched += match\n            elif choice == 5:\n                match = min(ra3, rb3)\n                ra3 -= match\n                rb3 -= match\n                matched += match\n            elif choice == 6:\n                match = min(ra3, rb2)\n                ra3 -= match\n                rb2 -= match\n                matched += match\n        \n        optimal = max(optimal, matched)\n    \n    print(f\"{n - optimal} {theoretical_max}\")\n\ndef run_program():\n    try:\n        test_cases = 1\n        for _ in range(test_cases):\n            process_case()\n    finally:\n        input_file.close()\n        output_file.close()\n        sys.stdout = original_stdout\n\nif __name__ == \"__main__\":\n    run_program()\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    private static BufferedReader reader;\n    private static PrintWriter writer;\n    private static final long MOD = 1000000007;\n\n    public static void main(String[] args) throws IOException {\n        reader = new BufferedReader(new InputStreamReader(System.in));\n        writer = new PrintWriter(System.out);\n        \n        try {\n            int testCases = 1;\n            for (int i = 0; i < testCases; i++) {\n                processCase();\n            }\n        } finally {\n            reader.close();\n            writer.close();\n        }\n    }\n\n    private static void processCase() throws IOException {\n        int n = Integer.parseInt(reader.readLine().trim());\n        String[] aLine = reader.readLine().trim().split(\" \");\n        String[] bLine = reader.readLine().trim().split(\" \");\n        \n        int a1 = Integer.parseInt(aLine[0]);\n        int a2 = Integer.parseInt(aLine[1]);\n        int a3 = Integer.parseInt(aLine[2]);\n        int b1 = Integer.parseInt(bLine[0]);\n        int b2 = Integer.parseInt(bLine[1]);\n        int b3 = Integer.parseInt(bLine[2]);\n        \n        int theoreticalMax = Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n        \n        int optimal = 0;\n        int[] perm = {1, 2, 3, 4, 5, 6};\n        \n        // Generate all permutations of [1,2,3,4,5,6]\n        List<int[]> permutations = generatePermutations(perm);\n        \n        for (int[] ordering : permutations) {\n            int ra1 = a1, ra2 = a2, ra3 = a3;\n            int rb1 = b1, rb2 = b2, rb3 = b3;\n            int matched = 0;\n            \n            for (int choice : ordering) {\n                if (choice == 1) {\n                    int match = Math.min(ra1, rb1);\n                    ra1 -= match;\n                    rb1 -= match;\n                    matched += match;\n                } else if (choice == 2) {\n                    int match = Math.min(ra1, rb3);\n                    ra1 -= match;\n                    rb3 -= match;\n                    matched += match;\n                } else if (choice == 3) {\n                    int match = Math.min(ra2, rb2);\n                    ra2 -= match;\n                    rb2 -= match;\n                    matched += match;\n                } else if (choice == 4) {\n                    int match = Math.min(ra2, rb1);\n                    ra2 -= match;\n                    rb1 -= match;\n                    matched += match;\n                } else if (choice == 5) {\n                    int match = Math.min(ra3, rb3);\n                    ra3 -= match;\n                    rb3 -= match;\n                    matched += match;\n                } else if (choice == 6) {\n                    int match = Math.min(ra3, rb2);\n                    ra3 -= match;\n                    rb2 -= match;\n                    matched += match;\n                }\n            }\n            \n            optimal = Math.max(optimal, matched);\n        }\n        \n        writer.println((n - optimal) + \" \" + theoreticalMax);\n    }\n    \n    private static List<int[]> generatePermutations(int[] array) {\n        List<int[]> result = new ArrayList<>();\n        permute(array, 0, result);\n        return result;\n    }\n    \n    private static void permute(int[] array, int start, List<int[]> result) {\n        if (start == array.length) {\n            result.add(array.clone());\n            return;\n        }\n        for (int i = start; i < array.length; i++) {\n            swap(array, start, i);\n            permute(array, start + 1, result);\n            swap(array, start, i);\n        }\n    }\n    \n    private static void swap(int[] array, int i, int j) {\n        int temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001234931987710297, -2.3841830625315197e-06, -8.344646857949556e-07, -0.0003530356043484062, -1.549708758830093e-05, -0.11284055560827255, -0.0032785970252007246, -0.00010632903286023065, -7.390948667307384e-06, -0.0