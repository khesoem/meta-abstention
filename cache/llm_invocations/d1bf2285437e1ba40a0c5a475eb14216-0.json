{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <climits>\nusing namespace std;\n\nstruct Edge {\n    int dest, cap, flow, cost;\n};\n\nconst int MAXN = 15000;\nconst int INF = 1e18;\n\nvector<Edge> edgeList;\nvector<int> adj[MAXN];\nlong long dist[MAXN];\nint prevNode[MAXN], prevEdgeIdx[MAXN];\nbool inQueue[MAXN];\n\nvoid addEdge(int src, int dst, int capacity, int cost) {\n    adj[src].push_back(edgeList.size());\n    edgeList.push_back({dst, capacity, 0, cost});\n    adj[dst].push_back(edgeList.size());\n    edgeList.push_back({src, 0, 0, -cost});\n}\n\nbool spfa(int source, int sink, int n) {\n    fill(dist, dist + n, INF);\n    fill(prevNode, prevNode + n, -1);\n    fill(prevEdgeIdx, prevEdgeIdx + n, -1);\n    fill(inQueue, inQueue + n, false);\n    \n    queue<int> q;\n    q.push(source);\n    dist[source] = 0;\n    inQueue[source] = true;\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inQueue[u] = false;\n        \n        for (int idx : adj[u]) {\n            Edge& e = edgeList[idx];\n            if (e.cap <= e.flow) continue;\n            int v = e.dest;\n            long long newDist = dist[u] + e.cost;\n            if (newDist < dist[v]) {\n                dist[v] = newDist;\n                prevNode[v] = u;\n                prevEdgeIdx[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    if (dist[sink] == INF) return false;\n    \n    int cur = sink;\n    while (cur != source) {\n        edgeList[prevEdgeIdx[cur]].flow++;\n        edgeList[prevEdgeIdx[cur] ^ 1].flow--;\n        cur = prevNode[cur];\n    }\n    \n    return true;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    const int SOURCE = 9998;\n    const int SINK = 9999;\n    \n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        x--;\n        addEdge(SOURCE, x, 1, 0);\n    }\n    \n    for (int i = 1; i <= 101; i++) {\n        addEdge((i-1)*n, SINK, k, (i-1)*c);\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int x, y;\n        cin >> x >> y;\n        x--; y--;\n        for (int layer = 1; layer <= 100; layer++) {\n            for (int j = 1; j <= k; j++) {\n                int cost = d * ((j-1)*2 + 1);\n                addEdge(x + (layer-1)*n, y + (layer-1)*n + n, 1, cost);\n                addEdge(y + (layer-1)*n, x + (layer-1)*n + n, 1, cost);\n            }\n        }\n    }\n    \n    for (int node = 0; node < n; node++) {\n        for (int layer = 1; layer <= 100; layer++) {\n            addEdge(node + (layer-1)*n, node + (layer-1)*n + n, k, 0);\n        }\n    }\n    \n    long long ans = 0;\n    for (int i = 0; i < k; i++) {\n        if (spfa(SOURCE, SINK, 10000)) {\n            ans += dist[SINK];\n        }\n    }\n    \n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen