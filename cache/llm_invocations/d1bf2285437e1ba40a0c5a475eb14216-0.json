des\n        inQueue = [False] * n_nodes\n        \n        q = deque()\n        q.append(source)\n        dist[source] = 0\n        inQueue[source] = True\n        \n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            \n            for edge_idx in adj[u]:\n                e = edgeList[edge_idx]\n                if e['cap'] <= e['flow']:\n                    continue\n                v = e['dest']\n                newDist = dist[u] + e['cost']\n                if newDist < dist[v]:\n                    dist[v] = newDist\n                    prevNode[v] = u\n                    prevEdgeIdx[v] = edge_idx\n                    if not inQueue[v]:\n                        inQueue[v] = True\n                        q.append(v)\n        \n        if dist[sink] == INF:\n            return False\n        \n        cur = sink\n        while cur != source:\n            edgeList[prevEdgeIdx[cur]]['flow'] += 1\n            edgeList[prevEdgeIdx[cur] ^ 1]['flow'] -= 1\n            cur = prevNode[cur]\n        \n        return True\n    \n    ans = 0\n    for _ in range(k):\n        if spfa(SOURCE, SINK, 10000):\n            ans += dist[SINK]\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014518637908622622, -9.536738616588991e-07, -1.1920928244535389e-07, -0.003217997495085001, -0.0035217900294810534, -2.3841855067985307e-07, -0.000263894529780373, -0.0002797450579237193, -1.4305104514278355e-06, -0.0008169650682248175, -6.925819616299123e-05, -0.47889405488967896, -0.0030490122735500336, -4.649054244509898e-05, -4.768370445162873e-07, -0.003511098911985755, -0.0017566739115864038, -5.245195097813848e-06, -4.768360213347478e-06, -0.11581313610076904, -0.0001817776501411572, -4.0531076592742465e-06, -0.00011967896716669202, 0.0, -0.026330403983592987, -1.1920922133867862e-06, -0.00027176024741493165, -7.378782902378589e-05, -0.006716533098369837,