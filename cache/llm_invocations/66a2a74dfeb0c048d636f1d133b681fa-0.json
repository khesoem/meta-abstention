nge(1, n + 1):\n                            d = shortest[sidx(sx, sy, tx, ty)]\n                            via = shortest[sidx(sx, sy, kx, ky)] + shortest[sidx(kx, ky, tx, ty)]\n                            if via < d:\n                                shortest[sidx(sx, sy, tx, ty)] = via\n\n    total_nodes = 2 * n * n + 3\n    src = 2 * n * n + 1\n    sink = 2 * n * n + 2\n    cap = [[0] * total_nodes for _ in range(total_nodes)]\n    visited = [False] * total_nodes\n\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if sci[i][j].isdigit():\n                cap[src][node_of(i, j, n)] = int(sci[i][j])\n            if rec[i][j].isdigit():\n                cap[n * n + node_of(i, j, n)][sink] = int(rec[i][j])\n            if sci[i][j].isdigit():\n                for a in range(1, n + 1):\n                    for b in range(1, n + 1):\n                        if sci[i][j] > '0' and rec[a][b] > '0' and rec[a][b].isdigit() and \\\n                           shortest[sidx(i, j, a, b)] <= t and canreach(i, j, a, b, infx, infy, n, sci):\n                            cap[node_of(i, j, n)][n * n + node_of(a, b, n)] = 1000\n\n    ans = 0\n    while True:\n        add = try_augment(src, sink, 1000, cap, visited)\n        if add == 0:\n            break\n        ans += add\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.510157047363464e-06, 0.0, 0.0, -0.000557267339900136, -0.004085409455001354, 0.0, -0.03806310519576073, -0.000436925794929266, 0.0, 0.0, -7.271740287251305e-06, -1.1920928244535389e-07, 0.0, -8.570780482841656e-05, -0.06196783855557442, -0.00027450130437500775, -0.4081355631351471, -0.7422819137573242, 0.0, -2.7418097943154862e-06, -0.014176495373249054, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -0.008947516791522503, -1.0728830375228426e-06, -0.3882138133049011, -2.2053474822314456e-05, -1.7881377516459