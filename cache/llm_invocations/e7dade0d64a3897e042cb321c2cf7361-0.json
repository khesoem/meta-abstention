{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<queue>\n#define N 100010\nusing namespace std;\ntypedef int typ;\n#define M 1000010\n#define inf 1000000000\n#define winf 1000000000\nstruct road{\n    int nxt,to,f;\n    typ w;\n}r[M<<1];\nint head[N],cnt=1,all;\nvoid add(int u,int v,int f,typ w)\n{\n    r[++cnt]=(road){head[u],v,f,w};head[u]=cnt;\n    r[++cnt]=(road){head[v],u,0,-w};head[v]=cnt;\n}\nnamespace min_cost_flow{\n    int cur[N];\n    bool vis[N];\n    typ dis[N];\n    bool spfa(int s,int t)\n    {\n        for(int i=1;i<=all;i++) dis[i]=winf,cur[i]=head[i],vis[i]=false;\n        dis[t]=0;\n        queue<int>q;\n        q.push(t);\n        vis[t]=true;\n        while(!q.empty())\n        {\n            int u=q.front();q.pop();\n            vis[u]=false;\n            for(int i=head[u];i;i=r[i].nxt)\n            {\n                int v=r[i].to;\n                if(r[i^1].f && dis[u]+r[i^1].w<dis[v])\n                {\n                    dis[v]=dis[u]+r[i^1].w;\n                    if(!vis[v]) q.push(v),vis[v]=true;\n                }\n            }\n        }\n        return dis[s]!=winf;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && dis[u]==dis[v]+r[i].w && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(spfa(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*dis[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nN = 100010\nM = 1000010\ninf = 1000000000\nwinf = 1000000000\n\nclass Edge:\n    __slots__ = ('nxt', 'to', 'f', 'w')\n    def __init__(self, nxt, to, f, w):\n        self.nxt = nxt\n        self.to = to\n        self.f = f\n        self.w = w\n\nhead = [0] * N\nr = [None] * (2 * M + 5)\ncnt = 1\nall_nodes = 0\n\ndef add_edge(u, v, f, w):\n    global cnt\n    cnt += 1\n    r[cnt] = Edge(head[u], v, f, w)\n    head[u] = cnt\n    cnt += 1\n    r[cnt] = Edge(head[v], u, 0, -w)\n    head[v] = cnt\n\n# min_cost_flow namespace\ncur = [0] * N\nvis = [False] * N\ndis = [0] * N\n\ndef spfa(s, t):\n    for i in range(1, all_nodes + 1):\n        dis[i] = winf\n        cur[i] = head[i]\n        vis[i] = False\n    dis[t] = 0\n    q = deque()\n    q.append(t)\n    vis[t] = True\n    while q:\n        u = q.popleft()\n        vis[u] = False\n        i = head[u]\n        while i:\n            v = r[i].to\n            if r[i ^ 1].f and dis[u] + r[i ^ 1].w < dis[v]:\n                dis[v] = dis[u] + r[i ^ 1].w\n                if not vis[v]:\n                    q.append(v)\n                    vis[v] = True\n            i = r[i].nxt\n    return dis[s] != winf\n\ndef dfs(u, t, fl):\n    if u == t or fl == 0:\n        return fl\n    res = 0\n    vis[u] = True\n    i = cur[u]\n    while i:\n        v = r[i].to\n        if r[i].f:\n            if not vis[v] and dis[u] == dis[v] + r[i].w:\n                f = dfs(v, t, min(fl, r[i].f))\n                if f:\n                    r[i].f -= f\n                    r[i ^ 1].f += f\n                    res += f\n                    fl -= f\n                    if fl == 0:\n                        break\n        i = r[i].nxt\n        cur[u] = i\n    vis[u] = False\n    return res\n\nmaxf = 0\nminw = 0\n\ndef work_flow(s, t):\n    global maxf, minw\n    while spfa(s, t):\n        w = dfs(s, t, inf)\n        maxf += w\n        minw += w * dis[s]\n\n# main\ndef main():\n    global all_nodes, maxf, minw, cnt, head, r\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    all_nodes = n + 2\n    ss = 1\n    tt = 2\n    g = [[] for _ in range(n + 1)]\n    for _ in range(k):\n        a = int(next(it))\n        add_edge(ss, id(0, a, n), 1, 0)\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        g[u].append(v)\n        g[v].append(u)\n    add_edge(id(0, 1, n), tt, inf, 0)\n    for t in range(0, n + k + 1):\n        work(t, n, k, c, d, g, ss, tt)\n    work_flow(ss, tt)\n    print(minw)\n\ndef id(t, x, n):\n    return t * n + x + 2\n\ndef work(t, n, k, c, d, g, ss, tt):\n    global all_nodes\n    all_nodes += n\n    for u in range(1, n + 1):\n        for v in g[u]:\n            for p in range(1, k + 1):\n                add_edge(id(t, u, n), id(t + 1, v, n), 1, d * (2 * p - 1))\n    for u in range(1, n + 1):\n        add_edge(id(t, u, n), id(t + 1, u, n), inf, 0)\n    add_edge(id(t + 1, 1, n), tt, inf, c * (t + 1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00026770823751576245, -2.3841855067985307e-07, -9.536738616588991e-07, -0.0009188005933538079, -0.003204451175406575, 0.0, -0.04863683879375458, -0.38898390531539917, -2.109982233378105e-05, 0.0, -0.00012373158824630082, -0.005324231460690498, -0.351335346698761, -8.880697714630514e-05, -1.311301275563892e-06, -0.0009808497270569205, -2.2053474822314456e-05, -0.0032340388279408216, -0.00024256148026324809, -3.218599158572033e-05, -4.529942543740617e-06, -0.0001311216183239594, -1.9073468138230965e-06, -5.960462772236497e-07, -0.001279131742194295, -0.16027894616127014, -0.0003121604095213115, -0.00020656836568377912, -0.06203988194465637, -4.768370445162873e-07, -3.2186455882765586e-06, -4.291525328881107e-06, -6.580135959666222e-05, -1.7881377516459906e-06, -3.576278118089249e-07, -1.4305104514278355e-06, -7.748573807475623e-06, -2.264974000354414e-06, -1.1920928244535389e-07, -4.768370445162873e-07, -3.576272320060525e-06, -0.0002127659390680492, -0.18123631179332733, -0.06217700615525246, -7.152555099310121e-07, -1.9073468138230965e-06, -0.008625276386737823, 0.0, 