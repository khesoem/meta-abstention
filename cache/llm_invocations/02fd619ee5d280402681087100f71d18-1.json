ry = [0.0] * n\n    for i in range(len(a)):\n        x = a[i] % mod\n        a_real[i] = x & ((1 << 15) - 1)\n        a_imaginary[i] = x >> 15\n    \n    fft(a_real, a_imaginary, False)\n    \n    b_real = [0.0] * n\n    b_imaginary = [0.0] * n\n    for i in range(len(b)):\n        x = b[i] % mod\n        b_real[i] = x & ((1 << 15) - 1)\n        b_imaginary[i] = x >> 15\n    \n    fft(b_real, b_imaginary, False)\n    \n    fa_real = [0.0] * n\n    fa_imaginary = [0.0] * n\n    fb_real = [0.0] * n\n    fb_imaginary = [0.0] * n\n    \n    cf = 0.25 / n\n    for i in range(n):\n        j = (n - i) & (n - 1)\n        \n        a1r = (a_real[i] + a_real[j]) / 2\n        a1i = (a_imaginary[i] - a_imaginary[j]) / 2\n        a2r = (a_imaginary[i] + a_imaginary[j]) / 2\n        a2i = (a_real[j] - a_real[i]) / 2\n        \n        b1r = (b_real[i] + b_real[j]) / 2\n        b1i = (b_imaginary[i] - b_imaginary[j]) / 2\n        b2r = (b_imaginary[i] + b_imaginary[j]) / 2\n        b2i = (b_real[j] - b_real[i]) / 2\n        \n        fa_real[i] = a1r * b1r - a1i * b1i - a2r * b2i - a2i * b2r\n        fa_imaginary[i] = a1r * b1i + a1i * b1r + a2r * b2r - a2i * b2i\n        \n        fb_real[i] = a1r * b2r - a1i * b2i + a2r * b1r - a2i * b1i\n        fb_imaginary[i] = a1r * b2i + a1i * b2r + a2r * b1i + a2i * b1r\n    \n    fft(fa_real, fa_imaginary, True)\n    fft(fb_real, fb_imaginary, True)\n    \n    res = [0] * need\n    for i in range(need):\n        aa = int(fa_real[i] + 0.5)\n        bb = int(fb_real[i] + 0.5)\n        cc = int(fa_imaginary[i] + 0.5)\n        res[i] = int((aa + ((bb % mod) << 15) + ((cc % mod) << 30)) % mod)\n    \n    return res\n\ndef solve():\n    mod = 998244353\n    n, k = map(int, sys.stdin.readline().split())\n    v = [0] * 10\n    for _ in range(k):\n        x = int(sys.stdin.readline())\n        v[x] = 1\n    \n    ans = [1]\n    p = n // 2\n    while True:\n        if p % 2 != 0:\n            ans = multiply_mod(ans, v, mod)\n        p //= 2\n      