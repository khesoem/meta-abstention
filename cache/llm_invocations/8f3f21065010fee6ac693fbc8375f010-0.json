n        fill(inq, inq + t + 1, false);\n        d[s] = 0;\n        inq[s] = true;\n        a[s] = INT_MAX;\n        queue<int> q;\n        q.push(s);\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n\n            for (int idx : adj[u]) {\n                edge& e = EL[idx];\n                if (e.cap > e.flw && d[e.dst] > d[u] + e.cst) {\n                    d[e.dst] = d[u] + e.cst;\n                    p[e.dst] = idx;\n                    a[e.dst] = min(a[u], e.cap - e.flw);\n                    if (!inq[e.dst]) {\n                        inq[e.dst] = true;\n                        q.push(e.dst);\n                    }\n                }\n            }\n        }\n\n        if (d[t] == INT_MAX) return false;\n        flow += a[t];\n        cost += d[t] * a[t];\n        int cur = t;\n        while (cur != s) {\n            EL[p[cur]].flw += a[t];\n            EL[p[cur] ^ 1].flw -= a[t];\n            cur = EL[p[cur]].src;\n        }\n        return true;\n    }\n\n    int min_cost_flow(int s, int t) {\n        int total_flow = 0, total_cost = 0;\n        while (spfa(s, t, total_flow, total_cost));\n        return total_cost;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> N_NODES >> N_EDGES >> K_PLANETS >> COST_C >> COST_D;\n\n    for (int i = 1; i <= K_PLANETS; ++i) {\n        scanf(\"%d\", &planet_arr[i]);\n    }\n\n    SOURCE = 0;\n    SINK = N_NODES * 100 + 1;\n\n    for (int i = 1; i <= K_PLANETS; ++i) {\n        MCMF::add_edge(SOURCE, 1 + (planet_arr[i] - 1) * 100, 1, 0);\n    }\n\n    for (int i = 1; i <= N_NODES; ++i) {\n        int base = (i - 1) * 100LL;\n        for (int j = 1; j < 100; ++j) {\n            MCMF::add_edge(base + j, base + j + 1, INT_MAX, COST_C);\n        }\n    }\n\n    for (int i = 1; i <= 100; ++i) {\n        MCMF::add_edge(i, SINK, INT_MAX, 0);\n    }\n\n    while (N_EDGES--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n    