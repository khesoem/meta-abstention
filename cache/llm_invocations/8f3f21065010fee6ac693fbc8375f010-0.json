100):\n            u = (x - 1) * 100 + i\n            v = (y - 1) * 100 + i + 1\n            for j in range(1, 51):\n                w = COST_D * (j * j - (j - 1) * (j - 1)) + COST_C\n                mcmf.add_edge(u, v, 1, w)\n\n        for i in range(1, 100):\n            u = (y - 1) * 100 + i\n            v = (x - 1) * 100 + i + 1\n            for j in range(1, 51):\n                w = COST_D * (j * j - (j - 1) * (j - 1)) + COST_C\n                mcmf.add_edge(u, v, 1, w)\n\n    print(mcmf.min_cost_flow(SOURCE, SINK))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020704510097857565, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.00013267113536130637, -0.0007331067463383079, -4.768370445162873e-07, -0.3868744969367981, -0.0012740122620016336, -7.152555099310121e-07, -0.004624505061656237, -0.08895581215620041, -0.000556314189452678, -0.10643201321363449, -2.825220326485578e-05, -0.11750494688749313, -0.0008503158460371196, -1.1920928244535389e-07, -1.5497195136049413e-06, 0.0, 0.0, -0.00033706706017255783, -8.344646857949556e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0024787436705082655, -1.1920928244535389e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -0.16025792062282562, -0.022142214700579643, -0.000144709600135684, -7.152555099310121e-07, -2.3841855067985307e-07, -0.03804164379835129, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, -6.794906312279636e-06, -5.960462772236497e-07, -0.0010509926360100508, -3.576278118089249e-07, -1.3351351299206726e-05, 0.0, -2.407998726994265e-05, -1.1920928244535389e-07, -0.002552943304181099, 0.0, -1.1920928244535389e-07, -5.566918844124302e-05, -1.3828182090946939e-05, -1.764281842042692e-05, 0.0, -7.152555099310121e-07, 0.0, -7.152555099310121e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.7881377516459906e-06, -3.1470757676288486e-05, -1.1920928244535389e-07, -4.291525328881107e-06, -3.57627811808924