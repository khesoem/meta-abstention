tStreamReader(System.in));\n        String[] line1 = br.readLine().split(\" \");\n        int n = Integer.parseInt(line1[0]);\n        int m = Integer.parseInt(line1[1]);\n        \n        String[] line2 = br.readLine().split(\" \");\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = Long.parseLong(line2[i]);\n        }\n        \n        List<Long> a1 = new ArrayList<>();\n        List<Long> a2 = new ArrayList<>();\n        int n1 = n / 2;\n        \n        sums1(a, a1, 0, 0, n1, m);\n        sums2(a, a2, n1, 0, n, m);\n        \n        long ans = 0;\n        Set<Long> a1Set = new HashSet<>(a1);\n        List<Long> a1Sorted = new ArrayList<>(a1Set);\n        Collections.sort(a1Sorted);\n        \n        for (long val : a2) {\n            long target = m - val;\n            int idx = binarySearch(a1Sorted, target);\n            if (idx > 0 && ans < a1Sorted.get(idx - 1) + val) {\n                ans = a1Sorted.get(idx - 1) + val;\n            }\n        }\n        \n        System.out.println(ans);\n    }\n    \n    private static void sums1(long[] a, List<Long> result, int i, long currentSum, int n1, int m) {\n        if (i == n1) {\n            result.add(currentSum % m);\n        } else {\n            sums1(a, result, i + 1, (currentSum + a[i]) % m, n1, m);\n            sums1(a, result, i + 1, currentSum, n1, m);\n        }\n    }\n    \n    private static void sums2(long[] a, List<Long> result, int i, long currentSum, int n, int m) {\n        if (i == n) {\n            result.add(currentSum % m);\n        } else {\n            sums2(a, result, i + 1, (currentSum + a[i]) % m, n, m);\n            sums2(a, result, i + 1, currentSum, n, m);\n        }\n    }\n    \n    private static int binarySearch(List<Long> sortedList, long target) {\n        int left = 0;\n        int right = sortedList.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (sortedList.get(mid) >= target) {