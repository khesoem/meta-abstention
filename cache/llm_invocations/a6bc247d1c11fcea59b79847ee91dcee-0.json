le (x > 0) {\n            x /= 10;\n            d++;\n        }\n        return d;\n    }\n\n    static long rep(long x) {\n        int d = dig(x);\n        long r = 0, p = 1;\n        for (int i = 0; i < d; ++i) {\n            r += p;\n            p *= 10;\n        }\n        return (r <= x) ? r : (r - 1) / 10;\n    }\n\n    static long f(long n) {\n        if (n <= 6) return n;\n        if (n <= 11) return 13 - n;\n        long lo = rep(n);\n        long hi = lo * 10 + 1;\n        if (n % lo == 0) {\n            return (n <= hi / 2 + lo) ? dig(lo) * n / lo : dig(hi) + f(hi - n);\n        } else {\n            long m = (n / lo) * lo;\n            long ans = f(m) + f(n - m);\n            if (n > hi / 2) ans = Math.min(ans, dig(hi) + f(hi - n));\n            return ans;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        System.out.println(f(n));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.0184406042099, -0.001967876683920622, -1.3947389561508317e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, -6.317892984952778e-05, -2.0503786799963564e-05, 0.0, -4.0531076592742465e-06, -0.001515550771728158, -0.0005586970364674926, -9.691245941212401e-05, 0.0, -0.016896579414606094, -0.0031822300516068935, -0.0019375376868993044, -0.14747068285942078, -0.005235651042312384, -0.0002324311062693596, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.0265558760002023e-06, -1.1920928244535389e-07, -8.22540732769994e-06, 0.0, 0.0, 0.0, -1.1920922133867862e-06, -2.3841855067985307e-07, 0.0, -1.5020257706055418e-05, -1.1920928244535389e-07, 0.0, -0.5759398937225342, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -0.04858732968568802, 0.0, -5.960462772236497e-07, -7.152555099310121e-07, 0.0, 0.0, -7.986990567587782e-06, 0.0, -2.753696753643453e-05, -1.5497195136049413e-06, -2.384185506