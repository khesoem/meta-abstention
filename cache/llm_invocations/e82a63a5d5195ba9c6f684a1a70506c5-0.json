{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int maxn = 5007;\nconst ll INF = 1e9;\nconst ll mod = 1e9 + 7;\n\nstruct Edge {\n    int from, to;\n    ll cap, cost, flow;\n    Edge(int from, int to, ll cap, ll cost) : from(from), to(to), cap(cap), cost(cost), flow(0) {}\n};\n\nvector<Edge> edges;\nvector<int> g[maxn];\nll d[maxn], phi[maxn];\nint par[maxn];\n\nvoid add_edge(int u, int v, ll cap, ll cost) {\n    g[u].push_back(edges.size());\n    edges.push_back({u, v, cap, cost});\n    g[v].push_back(edges.size());\n    edges.push_back({v, u, 0, -cost});\n}\n\nvoid ford_bellman(int s, int n) {\n    fill(phi, phi + maxn, INF);\n    phi[s] = 0;\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < (int)edges.size(); j++) {\n            Edge &e = edges[j];\n            if (e.cap == e.flow) continue;\n            if (phi[e.from] == INF) continue;\n            phi[e.to] = min(phi[e.to], phi[e.from] + e.cost);\n        }\n    }\n}\n\nvoid dijkstra(int s) {\n    fill(d, d + maxn, INF);\n    d[s] = 0;\n    set<pair<ll, int>> q;\n    q.insert({0, s});\n    while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i = 0; i < (int)g[v].size(); i++) {\n            int eid = g[v][i];\n            Edge &e = edges[eid];\n            if (e.cap == e.flow) continue;\n            int to = e.to;\n            ll len = e.cost + phi[v] - phi[to];\n            if (d[v] + len < d[to]) {\n                q.erase({d[to], to});\n                d[to] = d[v] + len;\n                par[to] = eid;\n                q.insert({d[to], to});\n            }\n        }\n    }\n}\n\npair<ll, ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (true) {\n        if (d[t] == INF) break;\n        ll pushed = INF, sum = 0;\n        for (int tmp = t; tmp != s; tmp = edges[par[tmp]].from) {\n            int eid = par[tmp];\n            pushed = min(pushed, edges[eid].cap - edges[eid].flow);\n            sum += edges[eid].cost;\n        }\n        flow += pushed;\n        cost += pushed * sum;\n        for (int tmp = t; tmp != s; tmp = edges[par[tmp]].from) {\n            int eid = par[tmp];\n            edges[eid].flow += pushed;\n            edges[eid ^ 1].flow -= pushed;\n        }\n        dijkstra(s);\n        for (int i = 0; i < maxn; i++) phi[i] = d[i];\n    }\n    return {cost, flow};\n}\n\nvoid solve() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnts(n, 0);\n    for (int i = 0; i < k; i++) {\n        int ai;\n        cin >> ai;\n        ai--;\n        cnts[ai]++;\n    }\n    for (int i = 0; i < n; i++) {\n        add_edge(5000, i, cnts[i], 0);\n    }\n    for (int it = 0; it < m; it++) {\n        int u, v;\n        cin >> u >> v;\n        u--;\n        v--;\n        for (int i = 0; i < 99; i++) {\n            ll cost = d;\n            for (int j = 0; j < 50; j++) {\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cost);\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost);\n                cost += 2 * d;\n            }\n        }\n    }\n    for (int i = 0; i <= 99; i++) {\n        add_edge(0 + i * 50, 5001, INF, c * i);\n    }\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 99; j++) {\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0);\n        }\n    }\n    auto p = mincost_maxflow(5000, 5001);\n    assert(p.second == k);\n    cout << p.first;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cout.tie(0);\n    cout << setprecision(20) << fixed;\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\n\nedges = []  # list of [from, to, cap, cost, flow]\ng = [[] for _ in range(5007)]  # adjacency list of edge indices\n\ndef add_edge(u, v, cap, cost):\n    g[u].append(len(edges))\n    edges.append([u, v, cap, cost, 0])\n    g[v].append(len(edges))\n    edges.append([v, u, 0, -cost, 0])\n\ndef ford_bellman(s, n):\n    phi = [INF] * 5007\n    phi[s] = 0\n    for _ in range(n):\n        for e in edges:\n            if e[2] == e[4]:  # cap == flow\n                continue\n            if phi[e[0]] == INF:\n                continue\n            if phi[e[0]] + e[3] < phi[e[1]]:\n                phi[e[1]] = phi[e[0]] + e[3]\n    return phi\n\ndef dijkstra(s, phi):\n    d = [INF] * 5007\n    d[s] = 0\n    par = [-1] * 5007\n    pq = [(0, s)]\n    while pq:\n        dist, v = heapq.heappop(pq)\n        if dist != d[v]:\n            continue\n        for eid in g[v]:\n            e = edges[eid]\n            if e[2] == e[4]:  # cap == flow\n                continue\n            to = e[1]\n            len_ = e[3] + phi[v] - phi[to]\n            if d[v] + len_ < d[to]:\n                d[to] = d[v] + len_\n                par[to] = eid\n                heapq.heappush(pq, (d[to], to))\n    return d, par\n\ndef mincost_maxflow(s, t):\n    phi = ford_bellman(s, 50)  # note: n=50 as in original\n    d, par = dijkstra(s, phi)\n    flow = 0\n    cost = 0\n    while True:\n        if d[t] == INF:\n            break\n        pushed = INF\n        sum_cost = 0\n        tmp = t\n        while tmp != s:\n            eid = par[tmp]\n            e = edges[eid]\n            pushed = min(pushed, e[2] - e[4])\n            sum_cost += e[3]\n            tmp = e[0]\n        flow += pushed\n        cost += pushed * sum_cost\n        tmp = t\n        while tmp != s:\n            eid = par[tmp]\n            e = edges[eid]\n            e[4] += pushed\n            edges[eid ^ 1][4] -= pushed\n            tmp = e[0]\n        d, par = dijkstra(s, phi)\n        for i in range(5007):\n            phi[i] = d[i]\n    return cost, flow\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    cnts = [0] * n\n    for _ in range(k):\n        ai = int(next(it)) - 1\n        cnts[ai] += 1\n    for i in range(n):\n        add_edge(5000, i, cnts[i], 0)\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for i in range(99):  # i from 0 to 98\n            cost = d\n            for j in range(50):\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cost)\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost)\n                cost += 2 * d\n    for i in range(100):  # i from 0 to 99 inclusive\n        add_edge(0 + i * 50, 5001, INF, c * i)\n    for i in range(n):\n        for j in range(99):  # j from 0 to 98\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n    cost, flow = mincost_maxflow(5000, 5001)\n    # assert flow == k\n    print(cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.006451