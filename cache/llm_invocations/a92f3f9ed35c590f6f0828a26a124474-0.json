{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <map>\n#include <cstring>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\nusing i64 = long long;\n\ni64 lsc[62], rsc[62], rsc2[62];\nchar s[62];\nmap<pair<i64,int>,i64> nm, mm;\n\ni64 binom(int n, int k) {\n    if (k < 0 || k > n) return 0;\n    i64 res = 1;\n    for (int j = 0; j < k; ++j) {\n        res = res * (n - j) / (j + 1);\n    }\n    return res;\n}\n\nint main() {\n    int r, c, n, i, cnta = 0, cntb = 0, ok, ast, bst;\n    i64 msum = 0, nsum = 0, bsum, rasp = 0;\n    scanf(\"%d %d\\n\", &r, &c);\n    n = 2 * (r + c);\n    scanf(\"%s\", s);\n    \n    lsc[2*r-1] = 1;\n    for (i = 2*r; i < n; ++i)\n        lsc[i] = lsc[i-1] * i / (i - 2*r + 1);\n    \n    for (i = 0; i <= n; ++i) {\n        rsc[i] = binom(i, r);\n        rsc2[i] = binom(i, r-1);\n    }\n    \n    nsum = rsc[n/2] * rsc[n/2];\n    \n    for (i = n-1; i >= 0; --i) {\n        ok = (msum > 0 || cntb == n/2) && (cnta != n/2);\n        if (ok) {\n            cnta++;\n            msum -= rsc2[n/2 - cnta] * rsc[n/2 - cntb];\n        } else {\n            cntb++;\n            msum += rsc2[n/2 - cntb] * rsc[n/2 - cnta];\n        }\n    }\n    msum = msum < 0 ? -msum : msum;\n    \n    mm[{0, 0}] = 1;\n    \n    for (i = n-1; i >= 2*r-1; --i) {\n        nm.clear();\n        for (auto& kv : mm) {\n            i64 sum = kv.first.first;\n            i64 cnt_val = kv.second;\n            int cnt = kv.first.second;\n            ast = n/2 - cnt;\n            bst = i + 1 - ast;\n            i64 asum = sum + rsc2[ast-1] * rsc[bst];\n            i64 bsum = sum - rsc2[bst-1] * rsc[ast];\n            \n            if (s[i] == 'A') {\n                nm[{asum, cnt+1}] += cnt_val;\n            } else if (s[i] == 'B') {\n                nm[{bsum, cnt}] += cnt_val;\n            } else {\n                nm[{asum, cnt+1}] += cnt_val;\n                nm[{bsum, cnt}] += cnt_val;\n            }\n        }\n        nsum -= lsc[i];\n        mm.clear();\n        for (auto& kv : nm) {\n            i64 sum = kv.first.first;\n            i64 cnt_val = kv.second;\n            int cnt = kv.first.second;\n            ast = n/2 - cnt;\n            bst = i - ast;\n            if (cnt > n/2 || (i - cnt) > n/2) continue;\n            if (sum < -msum - rsc[ast]*rsc[bst] || sum > msum + rsc[ast]*rsc[bst]) continue;\n            mm[{sum, cnt}] += cnt_val;\n        }\n    }\n    \n    bsum = 1e18;\n    for (auto& kv : mm) {\n        i64 val = kv.first.first;\n        bsum = min(bsum, val < 0 ? -val : val);\n    }\n    \n    for (auto& kv : mm) {\n        i64 sum = kv.first.first;\n        i64 cnt_val = kv.second;\n        int cnt = kv.first.second;\n        if (sum == bsum || sum == -bsum) {\n            int sem = 0;\n            for (i = 0; i < 2*r-1; ++i) {\n                if (s[i] == '?') sem++;\n                else if (s[i] == 'A') cnt++;\n            }\n            cnt_val *= binom(sem, n/2 - cnt);\n            rasp += cnt_val;\n        }\n    }\n    \n    printf(\"%lld\\n\", rasp);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\nfrom math import comb\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    \n    r, c = map(int, data[0].split())\n    s = data[1].strip()\n    \n    n = 2 * (r + c)\n    \n    lsc = [0] * 62\n    rsc = [0] * 62\n    rsc2 = [0] * 62\n    \n    lsc[2*r-1] = 1\n    for i in range(2*r, n):\n        lsc[i] = lsc[i-1] * i // (i - 2*r + 1)\n    \n    for i in range(n + 1):\n        rsc[i] = comb(i, r) if 0 <= r <= i else 0\n        rsc2[i] = comb(i, r-1) if 0 <= r-1 <= i else 0\n    \n    nsum = rsc[n//2] * rsc[n//2]\n    \n    msum = 0\n    cnta = 0\n    cntb = 0\n    \n    for i in range(n-1, -1, -1):\n        ok = (msum > 0 or cntb == n//2) and (cnta != n//2)\n        if ok:\n            cnta += 1\n            msum -= rsc2[n//2 - cnta] * rsc[n//2 - cntb]\n        else:\n            cntb += 1\n            msum += rsc2[n//2 - cntb] * rsc[n//2 - cnta]\n    \n    msum = abs(msum)\n    \n    mm = defaultdict(int)\n    mm[(0, 0)] = 1\n    \n    for i in range(n-1, 2*r-2, -1):\n        nm = defaultdict(int)\n        for (sum_val, cnt), cnt_val in mm.items():\n            ast = n//2 - cnt\n            bst = i + 1 - ast\n            asum = sum_val + rsc2[ast-1] * rsc[bst] if ast >= 1 else sum_val\n            bsum = sum_val - rsc2[bst-1] * rsc[ast] if bst >= 1 else sum_val\n            \n            if s[i] == 'A':\n                nm[(asum, cnt+1)] += cnt_val\n            elif s[i] == 'B':\n                nm[(bsum, cnt)] += cnt_val\n            else:  # s[i] == '?'\n                nm[(asum, cnt+1)] += cnt_val\n                nm[(bsum, cnt)] += cnt_val\n        \n        nsum -= lsc[i]\n        mm.clear()\n        for (sum_val, cnt), cnt_val in nm.items():\n            ast = n//2 - cnt\n            bst = i - ast\n            if cnt > n//2 or (i - cnt) > n//2:\n                continue\n            if sum_val < -msum - rsc[ast]*rsc[bst] or sum_val > msum + rsc[ast]*rsc[bst]:\n                continue\n            mm[(sum_val, cnt)] += cnt_val\n    \n    bsum = float('inf')\n    for (sum_val, cnt), cnt_val in mm.items():\n        bsum = min(bsum, abs(sum_val))\n    \n    rasp = 0\n    for (sum_val, cnt), cnt_val in mm.items():\n        if sum_val == bsum or sum_val == -bsum:\n            sem = 0\n            for i in range(2*r-1):\n                if s[i] == '?':\n                    sem += 1\n                elif s[i] == 'A':\n                    cnt += 1\n            rasp += cnt_val * comb(sem, n//2 - cnt)\n    \n    print(rasp)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00017331528943032026, -1.6689286894688848e-06, -4.768370445162873e-07, -0.006955221761018038, -0.00036459474358707666, -0.0009118927991949022, -0.00018380382971372455, -0.008434980176389217, -1.1920928244535389e-07, -1.7523612768854946e-05, -0.38743114471435547, -0.25194868445396423, -0.01804494857788086, -2.622600959512056e-06, -0.00043299360550008714, -0.00022980909852776676, -0.000325388420606032, -0.3116101324558258, -6.711257447022945e-05, -4.768370445162873e-07, -0.21335642039775848, -5.245195097813848e-06, -0.020617341622710228, -2.253030106658116e-05, -0.03385184332728386, -4.076874756719917e-05, -0.0004987664869986475, -0.058419205248355865, -1.5497195136049413e-06, -4.768370445162873e-07, -0.030672702938318253, -0.0028152139857411385, -1.0728830375228426e-06, -0.5759402513504028, 0.0, -0.000395815703086555, -0.20145192742347717, -9.536738616588991e-07, -0.19040195643901825, -0.00013934595335740596, -3.576278118089249e-07, -1.0728830375228426e-06, -3.4689302992774174e-05, -4.0411134250462055e-05, -2.622600959512056e-06, -7.629365427419543e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.152555099310121e-07, -0.0009142747730948031, -6.318072337307967e-06, -9.536738616588991