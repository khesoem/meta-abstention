 0, -cost};\n}\n\nbool vis[5000];\nint par[5000];\nll pot[5000], dist[5000];\n\nvoid init_pot(int n) {\n    fill(pot, pot + n, 0);\n    for (int iter = 1; iter < n; ++iter) {\n        for (int u = 0; u < n; ++u) {\n            for (int i = 0; i < deg[u]; ++i) {\n                FlowEdge& e = adj[u][i];\n                if (e.cap) {\n                    pot[e.to] = min(pot[e.to], pot[u] + e.cost);\n                }\n            }\n        }\n    }\n}\n\nll mcf(int s, int t, ll& price, int n, bool sparse) {\n    fill(vis, vis + n, false);\n    fill(dist, dist + n, INF);\n    dist[s] = 0;\n\n    if (sparse) {\n        queue<int> q;\n        q.push(s);\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            if (vis[u]) continue;\n            vis[u] = true;\n            for (int i = 0; i < deg[u]; ++i) {\n                FlowEdge& e = adj[u][i];\n                if (e.flow < e.cap && dist[e.to] > dist[u] + pot[u] - pot[e.to] + e.cost) {\n                    dist[e.to] = dist[u] + pot[u] - pot[e.to] + e.cost;\n                    par[e.to] = i;\n                    q.push(e.to);\n                }\n            }\n        }\n    } else {\n        for (int u = s; u != -1; ) {\n            vis[u] = true;\n            for (int i = 0; i < deg[u]; ++i) {\n                FlowEdge& e = adj[u][i];\n                if (e.flow < e.cap && dist[e.to] > dist[u] + pot[u] - pot[e.to] + e.cost) {\n                    dist[e.to] = dist[u] + pot[u] - pot[e.to] + e.cost;\n                    par[e.to] = i;\n                }\n            }\n            u = -1;\n            ll best = INF;\n            for (int i = 0; i < n; ++i) {\n                if (!vis[i] && dist[i] < best) {\n                    best = dist[u = i];\n                }\n            }\n        }\n    }\n\n    if (dist[t] >= INF) return 0;\n\n    ll df = INF;\n    for (int u = t; u != s; ) {\n        int idx = par[u];\n        FlowEdge& rev = adj[u][idx];\n        df = min(df, adj[rev.to][rev.rev].cap - adj[rev.to][rev.rev].flow);\n        u = rev.to;\n    }\n\n    for (int u = t; u != s; ) {\n        int idx = par[u];\n        FlowEdge& rev = adj[u][idx];\n        FlowEdge& e = adj[rev.to][rev.rev];\n        e.flow += df;\n        rev.flow -= df;\n        price += df * e.cost;\n        u = rev.to;\n    }\n\n    for (int i = 0; i < n; ++i) {\n        pot[i] = min(INF, dist[i] + pot[i]);\n    }\n    return df;\n}\n\nll min_cost_flow(int s, int t, ll& price, int n, bool sparse = false) {\n    init_pot(n);\n    ll flow = price = 0;\n    while (ll df = mcf(s, t, price, n, sparse)) {\n        flow += df;\n    }\n    return flow;\n}\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0); cout.tie(0);\n    cout << fixed << setprecision(10);\n\n    int n,m,k,c,d;\n    cin>>n>>m>>k>>c>>d;\n\n    const int source = 0;\n    const int sink = n*T+1;\n\n    init(sink+1);\n\n    for(int i=0;i<k;i++) {\n        int a;\n        cin>>a;\n        addEdge(source, a, 1, 0);\n    }\n    for(int t=0;t<T;t++) {\n        addEdge(1+t*n, sink, INF, 0);\n        if(t>0) {\n            for(int i=1;i<=n;i++) {\n                addEdge(i+(t-1)*n, i+t*n, INF, c);\n            }\n        }\n    }\n\n    for(int i=0;i<m;i++) {\n        int a, b;\n        cin >> a >> b;\n        for(int j=0;j<C;j++) {\n            int cost = (j+1)*(j+1) - j*j;\n            for(int t=1;t<T;t++) {\n                addEdge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n                addEdge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n            }\n        }\n    }\n\n    ll price, flow = min_cost_flow(source, sink, price, sink+1, true);\n    assert(flow==k);\n    cout << price << nl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport queue\nimport math\nimport time\nfrom collections import defaultdict\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n\n    T = 99\n    C = 12\n\n    source = 0\n    sink = n * T + 1\n    size = sink + 1\n\n    # Initialize adjacency list and degree\n    adj = [[] for _ in range(size)]\n    deg = [0] * size\n\n    def add_edge(u, v, cap=1, cost=0):\n        # Forward edge\n        adj[u].append({'to': v, 'rev': len(adj[v]), 'flow': 0, 'cap': cap, 'cost': cost})\n        deg[u] += 1\n        # Backward edge\n        adj[v].append({'to': u, 'rev': len(adj[u]) - 1, 'flow': 0, 'cap': 0, 'cost': -cost})\n        deg[v] += 1\n\n    # Read k starting positions\n    for _ in range(k):\n        a = int(data[idx]); idx += 1\n        add_edge(source, a, 1, 0)\n\n    # Add edges for time layers\n    for t in range(T):\n        add_edge(1 + t * n, sink, float('inf'), 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                add_edge(i + (t - 1) * n, i + t * n, float('inf'), c)\n\n    # Read m edges\n    for _ in range(m):\n        a = int(data[idx]); idx += 1\n        b = int(data[idx]); idx += 1\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    # Min cost max flow implementation\n    INF = float('inf')\n    INFLL = INF\n    EPS = 1e-10\n\n    def init_pot(n):\n        pot = [0] * n\n        for _ in range(1, n):\n            updated = False\n            for u in range(n):\n                for e in adj[u]:\n                    if e['cap'] > 0 and pot[e['to']] > pot[u] + e['cost']:\n                        pot[e['to']] = pot[u] + e['cost']\n                        updated = True\n            if not updated:\n                break\n        return pot\n\n    def mcf(s, t, n, sparse=True):\n        dist = [INF] * n\n        par = [-1] * n\n        vis = [False] * n\n        dist[s] = 0\n\n        if sparse:\n            q = queue.Queue()\n            q.put(s)\n            while not q.empty():\n                u = q.get()\n                if vis[u]:\n                    continue\n                vis[u] = True\n                for i, e in enumerate(adj[u]):\n                    if e['flow'] < e['cap'] and dist[e['to']] > dist[u] + e['cost']:\n                        dist[e['to']] = dist[u] + e['cost']\n                        par[e['to']] = i\n                        q.put(e['to'])\n        else:\n            for _ in range(n):\n                u = -1\n                best = INF\n                for i in range(n):\n                    if not vis[i] and dist[i] < best:\n                        best = dist[i]\n                        u = i\n                if u == -1:\n                    break\n                vis[u] = True\n                for i, e in enumerate(adj[u]):\n                    if e['flow'] < e['cap'] and dist[e['to']] > dist[u] + e['cost']:\n                        dist[e['to']] = dist[u] + e['cost']\n                        par[e['to']] = i\n\n        if dist[t] >= INF:\n            return 0, 0\n\n        df = INF\n        cur = t\n        while cur != s:\n            idx = par[cur]\n            e = adj[cur][idx]\n            rev_e = adj[e['to']][e['rev']]\n            df = min(df, rev_e['cap'] - rev_e['flow'])\n            cur = e['to']\n\n        cur = t\n        price = 0\n        while cur != s:\n            idx = par[cur]\n            e = adj[cur][idx]\n            rev_e = adj[e['to']][e['rev']]\n            rev_e['flow'] += df\n            e['flow'] -= df\n            price += df * rev_e['cost']\n            cur = e['to']\n\n        return df, price\n\n    # Run min cost max flow\n    pot = init_pot(size)\n    \n    # Adjust edge costs with potentials\n    for u in range(size):\n        for e in adj[u]:\n            e['cost'] += po