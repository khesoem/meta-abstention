p == 0:\n                continue\n            ans += adjust(rev, rev.cap)\n    return ans\n\ndef main():\n    sys.setrecursionlimit(1000000)\n    data = sys.stdin.read().split()\n    it = iter(data)\n    out_lines = []\n    while True:\n        try:\n            n = int(next(it))\n            k = int(next(it))\n        except StopIteration:\n            break\n        M = []\n        for _ in range(n):\n            M.append(next(it))\n        sz = (k + 1) * n * n + 2\n        G = [Node() for _ in range(sz)]\n        srcI = k * n * n + (n - 1) * n + (n - 1) + 1\n        snkI = k * n * n + (n - 1) * n + (n - 1) + 2\n        S = G[srcI]\n        T = G[snkI]\n        Z = []\n        # Convert M to list of lists for mutability\n        M = [list(row) for row in M]\n        for i in range(n):\n            for j in range(n):\n                ch = M[i][j]\n                if ch == 'Y':\n                    continue\n                if ch == 'Z':\n                    Z.append((i, j))\n                    continue\n                # ch is a digit\n                link(S, G[i * n + j], ord(ch) - ord('0'))\n                M[i][j] = '0'\n        # Read second set of strings\n        s_rows = []\n        for _ in range(n):\n            s_rows.append(next(it))\n        for i in range(n):\n            row = s_rows[i]\n            for j in range(n):\n                ch = row[j]\n                if ch == 'Y' or ch == 'Z':\n                    continue\n                link(G[k * n * n + i * n + j], T, ord(ch) - ord('0'))\n        dr = [1, 0, -1, 0]\n        dc = [0, 1, 0, -1]\n        for t in range(k):\n            for i in range(n):\n                for j in range(n):\n                    # stay edge\n                    link(G[t * n * n + i * n + j], G[(t + 1) * n * n + i * n + j], B)\n                    if M[i][j] != '0':\n                        continue\n                    for d in range(4):\n                        ni = i + dr[d]\n                        nj = j + dc[d]\n  