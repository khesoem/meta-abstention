ld\\n\",x,sta);\n\treturn mp[pll(x,sta)]=ans;\n}\nint main(){\n\tscanf(\"%d\",&n);\n\tint I100=power(100,mo-2);\n\tFor(i,0,n-1){\n\t\tf[i][0]=1;\n\t\tFor(j,0,n-1){\n\t\t\tint P;\n\t\t\tscanf(\"%d\",&P);\n\t\t\tint p1=1ll*P*I100%mo;\n\t\t\tint p0=(1+mo-p1)%mo;\n\t\t\tFor(k,0,(1<<j)-1){\n\t\t\t\tf[i][k|(1<<j)]=1ll*f[i][k]*p1%mo;\n\t\t\t\tf[i][k]=1ll*f[i][k]*p0%mo;\n\t\t\t}\n\t\t}\n\t\t//For(j,0,(1<<n)-1) printf(\"%d \",f[i][j]); puts(\"\");\n\t}\n\tFor(i,0,(1<<n)-1)\n\t\tcnt[i]=cnt[i/2]+(i&1);\n\tFor(i,0,(1<<n)-1){\n\t\tvec[cnt[i]].PB(i);\n\t\tid[i]=vec[cnt[i]].size()-1;\n\t}\n\tprintf(\"%d\\n\",DP(0,1));\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(10000)\n\nmo = 1000000007\n\ndef power(x, y):\n    s = 1\n    while y:\n        if y & 1:\n            s = (s * x) % mo\n        x = (x * x) % mo\n        y //= 2\n    return s\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    I100 = power(100, mo - 2)\n    f = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        f[i][0] = 1\n        for j in range(n):\n            P = next(it)\n            p1 = (P * I100) % mo\n            p0 = (1 + mo - p1) % mo\n            for k in range(1 << j):\n                f[i][k | (1 << j)] = (f[i][k] * p1) % mo\n                f[i][k] = (f[i][k] * p0) % mo\n    cnt = [0] * (1 << n)\n    for i in range(1 << n):\n        cnt[i] = i.bit_count()\n    vec = [[] for _ in range(n + 1)]\n    id = [0] * (1 << n)\n    for i in range(1 << n):\n        c = cnt[i]\n        vec[c].append(i)\n        id[i] = len(vec[c]) - 1\n    memo = {}\n    def DP(x, sta):\n        if sta == 0:\n            return 0\n        if x == n:\n            return 1\n        key = (x, sta)\n        if key in memo:\n            return memo[key]\n        ans = 0\n        for j in range(1, 1 << n):\n