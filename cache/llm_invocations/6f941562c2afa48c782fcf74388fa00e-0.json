     if (src == dst)\n            adj[src].back().rev++;\n        adj[dst].push_back({dst, src, adj[src].size() - 1, 0, 0, -cost});\n    }\n    vector<cost_type> potential;\n    inline cost_type rcost(const edge &e)\n    {\n        return e.cost + potential[e.src] - potential[e.dst];\n    }\n\n//    void bellman_ford(int source)\n//    {\n//        for (int k = 0; k < n; ++k)\n//            for (int u = 0; u < n; ++u)\n//                for (edge &e : adj[u])\n//                    if (e.cap > 0 && rcost(e) < 0)\n//                        potential[e.dst] += rcost(e);\n//    }\n    const cost_type oo = numeric_limits<cost_type>::max();\n    vector<cost_type> dist;\n    vector<edge * > back;\n    cost_type dijkstra(int source, int sink)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> node;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        for (pq.push({dist[source] = 0, source}); !pq.empty();)\n        {\n            node p = pq.top();\n            pq.pop();\n            if (dist[p.second] < p.first)\n                continue;\n            if (p.second == sink)\n                break;\n            for (edge &e : adj[p.second])\n                if (e.flow < e.cap &&\n                        dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({\n                        dist[e.dst] = dist[e.src] + rcost(e),\n                        e.dst\n                    });\n                }\n        }\n        return dist[sink];\n    }\n    pair<flow_type, cost_type> max_flow(int source, int sink)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        back.assign(n, nullptr);\n//        bellman_ford(source); // remove negative costs\n        while (dijkstra(source, sink) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n            if (dist[u] < dist[sink])\n                potential[u] += dist[u] - dist[sink];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (edge * e = back[sink]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (edge * e = back[sink]; e; e = back[e->src])\n                e->flow += f, adj[e->dst][e->rev].flow -= f;\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n\n    int n,m,k,c,d,u,v;\n    cin >> n >> m >> k >> c >> d;\n    min_cost_max_flow<int,int> g((n+2)*102);\n    for(int i=0;i<102;i++)\n        g.add_edge((i*(n+2))+1,i*(n+2),100,(i*c));\n    for(int i=0;i<101;i++)\n        for(int j=0;j<n+1;j++)\n            g.add_edge(j+(i*(n+2)),j+((i+1)*(n+2)),100,0);\n    for(int i=0;i<k;i++)\n    {\n        cin >> u;\n        g.add_edge(n+1,u,1,0);\n    }\n\n    for(int i=0;i<m;i++)\n    {\n        cin >> u >> v;\n        for(int j=0;j<101;j++)\n            for(int f=0;f<k;f++)\n            {\n                g.add_edge(u+(j*(n+2)),v+((j+1)*(n+2)),1,((2*f)+1)*d);\n                g.add_edge(v+(j*(n+2)),u+((j+1)*(n+2)),1,((2*f)+1)*d);\n            }\n    }\n\n    db(g.max_flow(n+1,(101*(n+2))).second)\n\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int src, dst, rev;\n        int flow, cap, cost;\n        Edge(int src, int dst, int rev, int flow, int cap, int cost) {\n            this.src = src;\n            this.dst = dst;\n            this.rev = rev;\n            this.flow = flow;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int n;\n        List<List<Edge>> adj;\n        int[] potential;\n        int[] dist;\n        Edge[] back;\n        final int INF = Integer.MAX_VALUE;\n\n        MinCostMaxFlow(int n) {\n            this.n = n;\n            adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n            potential = new int[n];\n            dist = new int[n];\n            back = new Edge[n];\n        }\n\n        void addEdge(int src, int dst, int cap, int cost) {\n            adj.get(src).add(new Edge(src, dst, adj.get(dst).size(), 0, cap, cost));\n            if (src == dst) adj.get(src).get(adj.get(src).size() - 1).rev++;\n            adj.get(dst).add(new Edge(dst, src, adj.get(src).size() - 1, 0, 0, -cost));\n        }\n\n        int rcost(Edge e) {\n            return e.cost + potential[e.src] - potential[e.dst];\n        }\n\n        int dijkstra(int source, int sink) {\n            Arrays.fill(dist, INF);\n            PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> a[0] - b[0]);\n            dist[source] = 0;\n            pq.offer(new int[]{0, source});\n            while (!pq.isEmpty()) {\n                int[] cur = pq.poll();\n                int d = cur[0];\n                int u = cur[1];\n                if (d > dist[u]) continue;\n                if (u == sink) break;\n                for (Edge e : adj.get(u)) {\n                    if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e)) {\n                        dist[e.dst] = dist[e.src] + rcost(e);\n                        back[e.dst] = e;\n                        pq.offer(new int[]{dist[e.dst], e.dst});\n                    }\n                }\n            }\n            return dist[sink];\n        }\n\n        int[] maxFlow(int source, int sink) {\n            int flow = 0;\n            int cost = 0;\n            for (List<Edge> list : adj)\n                for (Edge e : list)\n                    e.flow = 0;\n            Arrays.fill(potential, 0);\n            while (dijkstra(source, sink) < INF) {\n                for (int u = 0; u < n; u++)\n                    if (dist[u] < dist[sink])\n                        potential[u] += dist[u] - dist[sink];\n                int f = INF;\n                for (Edge e = back[sink]; e != null; e = back[e.src])\n                    f = Math.min(f, e.cap - e.flow);\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    e.flow += f;\n                    adj.get(e.dst).get(e.rev).flow -= f;\n                }\n                flow += f;\n                cost += f * (potential[sink] - potential[source]);\n            }\n            return new int[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int N = (n + 2) * 102;\n        MinCostMaxFlow g = new MinCostMaxFlow(N);\n        \n        for (int i = 0; i < 102; i++)\n            g.addEdge(i * (n + 2) + 1, i * (n + 2), 100, i * c);\n        \n        for (int i = 0; i < 101; i++)\n            for (int j = 0; j < n + 1; j++)\n                g.addEdge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0);\n        \n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            g.addEdge(n + 1, u, 1, 0);\n        }\n        \n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < 101; j++)\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, ((2 * f) + 1) * d);\n                    g.addEdge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, ((2 * f) + 1) * d);\n                }\n        }\n        \n        int[] result = g.maxFlow(n + 1, 101 * (n + 2