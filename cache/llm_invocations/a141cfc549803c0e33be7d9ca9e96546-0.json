k) {\n                DP[level][mask] += DP[level-1][mask ^ sub] * INV_FACT[sub];\n                if (DP[level][mask] > LIMIT) DP[level][mask] %= MOD;\n            }\n            DP[level][mask] %= MOD;\n        }\n        res = (res + DP[level][N] * binomial(K, level)) % MOD;\n    }\n    \n    res = (res * FACT[N]) % MOD;\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> K >> MOD;\n    ULL ans = fast_pow(K, N);\n    \n    if (N & 1) {\n        cout << ans << '\\n';\n        return 0;\n    }\n    \n    ans = (ans - solve_dp() + MOD) % MOD;\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\ndef fast_pow(base, exp, mod):\n    res = 1\n    while exp:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef binomial(n, r, fact, inv_fact, mod):\n    return (((fact[n] * inv_fact[r]) % mod) * inv_fact[n - r]) % mod\n\ndef solve_dp(N, K, MOD):\n    LIMIT = 17446744073709551616\n    \n    fact = [0] * (N + 1)\n    inv_fact = [0] * (N + 1)\n    \n    fact[0] = 1\n    for i in range(1, N + 1):\n        fact[i] = (fact[i-1] * i) % MOD\n    \n    inv_fact[N] = fast_pow(fact[N], MOD - 2, MOD)\n    for i in range(N - 1, -1, -1):\n        inv_fact[i] = (inv_fact[i+1] * (i+1)) % MOD\n    \n    # DP[level][mask] - using list of dictionaries for sparse representation\n    # Since N <= 17 in practice (from limit = min(17, K)), we can use list of arrays\n    DP = [[0] * (N + 1) for _ in range(18)]\n    \n    for i in range(1, N + 1):\n        DP[1][i] = inv_fact[i]\n    \n    res = (DP[1][N] * binomial(K, 1, fact, inv_fact, MOD)) % MOD\n    limit = min(17, K)\n    \n    for level in range(2, limit + 1):\n        # Iterate over all masks that are subsets of N\n        mask = N\n        while mask:\n            sub = mask\n            while sub:\n                DP[level][mask] += DP[level-1][mask ^ sub] * inv_fact[sub]\n                if DP[level][mask] > LIMIT:\n                    DP[level][mask] %= MOD\n                sub = (sub - 1) & mask\n            DP[level][mask] %= MOD\n            mask = (mask - 1) & N\n        \n        res = (res + DP[level][N] * binomial(K, level, fact, inv_fact, MOD)) % MOD\n    \n    res = (res * fact[N]) % MOD\n    return res\n\ndef main():\n    import sys\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    N = int(data[0])\n    K = int(data[1])\n    MOD = int(data[2])\n    \n    ans = fast_pow(K, N, MOD)\n    \n    if N & 1:\n        print(ans)\n        return\n    \n    ans = (ans - solve_dp(N, K, MOD) + MOD) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0002516191452741623, -8.344646857949556e-07, -8.344646857949556e-07, -0.6332777738571167, -0.1019504964351654, -8.05822346592322e-05, -3.4570634852570947e-06, -6.758938252460212e-05, -4.3748852476710454e-05, -0.005245968233793974, -0.005345456302165985, -3.182837463100441e-05, -2.264974000354414e-06, -1.4305104514278355e-06, 0.0, 0.0, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -0.0013269914779812098, -7.867782187531702e-06, -4.827859811484814e-05, -2.3841855067985307e-07, 0.0, -5.2927523938706145e-05, -8.344646857949556e-07, 0.0, 0.0, -3.576278118089249e-07, -4.768370445162873e-07, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, 0.0, 0.0, -4.768370445162873e-07, 0.0, 0.0, -1.1920922133867862e-06, -5.960462772236497e-07, -6.6756979322235566e-06, -2.3841855067985307e-07, 0.0, 0.0, -1.0728830375228426e-06, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, 0.0, -1.5497195136049413e-06, -2.3841855067985307e-07, -6.318072337307967e-06, -5.245195097813848e-06, -9.536738616588991e-07, 0.0, -3.576278118089249e-07, -8.34464685