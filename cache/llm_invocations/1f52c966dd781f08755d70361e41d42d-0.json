ain(String[] args) {\n    execute(new InputReader(System.in), new PrintWriter(System.out));\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            line = self.reader.readline()\n            if not line:\n                raise RuntimeError(\"No more input\")\n            self.tokenizer = line.strip().split()\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\ndef execute(in_reader, out):\n    input_str = in_reader.next()\n    count = 1\n    answer = 0\n    for i in range(len(input_str)):\n        if i + 1 < len(input_str) and input_str[i] == input_str[i + 1]:\n            count += 1\n        else:\n            if count % 2 == 0:\n                answer += 1\n            count = 1\n    out.println(answer)\n    out.close()\n\nif __name__ == \"__main__\":\n    class PrintWriter:\n        def __init__(self, stream):\n            self.stream = stream\n        \n        def println(self, value):\n            self.stream.write(str(value) + '\\n')\n            self.stream.flush()\n        \n        def close(self):\n            self.stream.close()\n    \n    execute(InputReader(sys.stdin), PrintWriter(sys.stdout))\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.929640509653836e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.00017927470616996288, -8.535020606359467e-05, -0.3132643401622772, -0.0232488252222538, -3.2543604902457446e-05, -1.0728830375228426e-06, -3.4570634852570947e-06, -6.627816765103489e-05, -5.960462772236497e-07, -3.909988299710676e-05, -2.9802276912960224e-06, -3.576278118089249e-07, -2.7418097943154862e-06, -2.3841855067985307e-07, -0.