.dr[k]\n                            nj = j + self.dc[k]\n                            if self.valid(ni, nj) and self.plant[ni][nj][tm-1] == 0:\n                                self.plant[ni][nj][tm] = 2\n\n    def addReachabilityEdges(self):\n        for i in range(self.n):\n            for j in range(self.n):\n                if self.srcCap[i][j] == 0:\n                    continue\n                q = deque()\n                q.append((0, i, j))\n                vis = [[False]*self.n for _ in range(self.n)]\n                vis[i][j] = True\n                src = self.srcId[i][j]\n                while q:\n                    tm, r, c = q.popleft()\n                    if self.snkCap[r][c] != 0:\n                        self.F[src][self.snkId[r][c]] = 10000\n                    if tm == self.T:\n                        continue\n                    if self.plant[r][c][tm] != 0:\n                        continue\n                    for k in range(4):\n                        nr = r + self.dr[k]\n                        nc = c + self.dc[k]\n                        if self.valid(nr, nc) and self.plant[nr][nc][tm] == 0 and not vis[nr][nc]:\n                            vis[nr][nc] = True\n                            q.append((tm+1, nr, nc))\n\n    def addBoundaryEdges(self):\n        for i in range(self.n):\n            for j in range(self.n):\n                if self.srcCap[i][j] != 0:\n                    self.F[0][self.srcId[i][j]] = self.srcCap[i][j]\n                if self.snkCap[i][j] != 0:\n                    self.F[self.snkId[i][j]][self.sinkNode] = self.snkCap[i][j]\n\n    def run(self):\n        data = sys.stdin.read().split()\n        it = iter(data)\n        self.n = int(next(it))\n        self.T = int(next(it))\n        \n        s = [list(next(it)) for _ in range(self.n)]\n        for i in range(self.n):\n            for j in range(self.n):\n                if s[i][j] in ('Y', 'Z'):\n                    self.plant[i][j][0] = ord(s[i][j]) - ord('X')\n   