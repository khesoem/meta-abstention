{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\nconst int MOD=1000000007;\ninline int addmod(int a,int b){ if((a+=b)>=MOD) a-=MOD; return a; }\ninline int mulmod(int a,int b){ long long t=1LL*a*b; if(t>=MOD) t%=MOD; return (int)t; }\n\nclass Matr {\npublic:\n    int a[35*35];\n    void init(){ memset(a,0,sizeof(a)); }\n    void iden(){ init(); for(int i=0;i<35;i++) a[i*35+i]=1; }\n    int& at(int i,int j){ return a[i*35+j]; }\n    const int& at(int i,int j) const { return a[i*35+j]; }\n};\n\nMatr addMat(const Matr& x, const Matr& y){\n    Matr r; r.init();\n    for(int i=0;i<35;i++) for(int j=0;j<35;j++) r.at(i,j)=addmod(x.at(i,j),y.at(i,j));\n    return r;\n}\nMatr mulMat(const Matr& x, const Matr& y){\n    Matr r; r.init();\n    for(int i=0;i<35;i++){\n        for(int k=0;k<35;k++){\n            int xik=x.at(i,k);\n            if(xik){\n                for(int j=0;j<35;j++) r.at(i,j)=addmod(r.at(i,j),mulmod(xik,y.at(k,j)));\n            }\n        }\n    }\n    return r;\n}\n\ntypedef long long ll;\nll n; int K;\nvector<int> digit;\nMatr A[65][35], S[65][35], P[65][35], ans;\n\nint main(){\n    scanf(\"%lld%d\",&n,&K);\n    for(int i=0;i<K;i++){\n        A[0][i].iden();\n        for(int j=0;j<=K;j++) A[0][i].at(i,j)=1;\n    }\n    ll len=K;\n    for(int i=1;len<=n;i++,len*=K){\n        S[i-1][K-1]=A[i-1][K-1];\n        for(int j=K-2;j>=0;j--) S[i-1][j]=mulMat(A[i-1][j],S[i-1][j+1]);\n        P[i-1][0]=A[i-1][0];\n        for(int j=1;j<K;j++) P[i-1][j]=mulMat(P[i-1][j-1],A[i-1][j]);\n        A[i][0]=S[i-1][0];\n        for(int j=1;j<K;j++) A[i][j]=mulMat(S[i-1][j],P[i-1][j-1]);\n    }\n    while(n){\n        digit.push_back(n%K);\n        n/=K;\n    }\n    int s=0;\n    ans.iden();\n    for(int i=digit.size()-1;i>=0;i--){\n        for(int j=0;j<digit[i];j++)\n            ans=mulMat(ans,A[i][(j+s)%K]);\n        s=(s+digit[i])%K;\n    }\n    int res=1;\n    for(int i=0;i<K;i++) res=addmod(res,ans.at(i,K));\n    printf(\"%d\\n\",res);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef addmod(a, b):\n    a += b\n    if a >= MOD:\n        a -= MOD\n    return a\n\ndef mulmod(a, b):\n    return (a * b) % MOD\n\nclass Matr:\n    def __init__(self):\n        self.a = [0] * (35 * 35)\n\n    def iden(self):\n        for i in range(35):\n            self.a[i * 35 + i] = 1\n\n    def get(self, i, j):\n        return self.a[i * 35 + j]\n\n    def set(self, i, j, val):\n        self.a[i * 35 + j] = val\n\n    def copy(self):\n        m = Matr()\n        m.a = self.a[:]\n        return m\n\ndef addMat(x, y):\n    r = Matr()\n    for i in range(35):\n        for j in range(35):\n            r.set(i, j, addmod(x.get(i, j), y.get(i, j)))\n    return r\n\ndef mulMat(x, y):\n    r = Matr()\n    for i in range(35):\n        for k in range(35):\n            xik = x.get(i, k)\n            if xik:\n                for j in range(35):\n                    r.set(i, j, addmod(r.get(i, j), mulmod(xik, y.get(k, j))))\n    return r\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    K = int(data[1])\n\n    # Build A[0]\n    A = []\n    A0 = []\n    for i in range(K):\n        m = Matr()\n        m.iden()\n        for j in range(K + 1):\n            m.set(i, j, 1)\n        A0.append(m)\n    A.append(A0)\n\n    length = K\n    i = 1\n    while length <= n:\n        prev = A[i - 1]\n        # Compute S for previous level\n        S = [None] * K\n        S[K - 1] = prev[K - 1].copy()\n        for j in range(K - 2, -1, -1):\n            S[j] = mulMat(prev[j], S[j + 1])\n        # Compute P for previous level\n        P = [None] * K\n        P[0] = prev[0].copy()\n        for j in range(1, K):\n            P[j] = mulMat(P[j - 1], prev[j])\n        # Compute A[i]\n        Ai = [None] * K\n        Ai[0] = S[0].copy()\n        for j in range(1, K):\n            Ai[j] = mulMat(S[j], P[j - 1])\n        A.append(Ai)\n        i += 1\n        length *= K\n\n    # Convert n to base K digits (least significant first)\n    digit = []\n    temp_n = n\n    while temp_n:\n        digit.append(temp_n % K)\n        temp_n //= K\n\n    ans = Matr()\n    ans.iden()\n    s = 0\n    for idx in range(len(digit) - 1, -1, -1):\n        d = digit[idx]\n        for j in range(d):\n            ans = mulMat(ans, A[idx][(j + s) % K])\n        s = (s + d) % K\n\n    res = 1\n    for i in range(K):\n        res = addmod(res, ans.get(i, K))\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.417489309271332e-06, 0.0, -1.1920928244535389e-07, -0.0005613181856460869, -0.001886494574137032, 0.0, -0.004081373102962971, 0.0, -3.814689989667386e-06, 0.0, -6.6756979322235566e-06, -1.1920928244535389e-07, 0.0, 0.0, -0.011171882972121239, -2.169585604860913e-05, 0.0, -4.768360213347478e-06, 0.0, -0.0020261728204786777, 0.0, -1.1920922133867862e-06, 0.0, -5.72202952753286