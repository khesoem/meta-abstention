     return min(r1, r2);\n        }\n    } else if (last > 6) {\n        return cal(x[l + 1] - n) + l + 1;\n    } else {\n        int r1, r2;\n        if (n > x[l] * last) {\n            r1 = cal(n - x[l] * last) + last * l;\n        } else {\n            r1 = cal(x[l] * last - n) + last * l;\n        }\n        r2 = cal(n - x[l] * (last - 1)) + (last - 1) * l;\n        r1 = min(r1, r2);\n        r2 = cal(x[l + 1] - n) + l + 1;\n        return min(r1, r2);\n    }\n}\n\nint main() {\n    long long n;\n    cin >> n;\n    \n    x[1] = 1;\n    for (int i = 2; i <= 15; i++) {\n        x[i] = x[i-1] * 10 + 1;\n    }\n    \n    for (int i = 0; i < 7; i++) {\n        a[i] = i;\n    }\n    \n    for (int i = 7; i < 1111110; i++) {\n        a[i] = cal(i);\n        now = i;\n    }\n    \n    if (n < 1111110) {\n        cout << a[n] << '\\n';\n    } else {\n        cout << cal(n) << '\\n';\n    }\n    \n    return 0;\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <climits>\n#include <unordered_map>\nusing namespace std;\n\nunordered_map<long long, int> memo;\n\nint cal(long long n) {\n    if (n < 0) n = -n;\n    if (n == 0) return 0;\n    if (n == 1) return 1;\n    \n    if (memo.find(n) != memo.end()) {\n        return memo[n];\n    }\n    \n    // Count number of digits\n    long long t = n;\n    int digits = 0;\n    while (t > 0) {\n        digits++;\n        t /= 10;\n    }\n    \n    // Generate number with 'digits' 1s (e.g., 111...1)\n    long long repunit = 0;\n    for (int i = 0; i < digits; i++) {\n        repunit = repunit * 10 + 1;\n    }\n    \n    // If repunit has more digits than n, use repunit with (digits-1) digits\n    if (repunit > n) {\n        digits--;\n        repunit = 0;\n        for (int i = 0; i < digits; i++) {\n            repunit = repuni