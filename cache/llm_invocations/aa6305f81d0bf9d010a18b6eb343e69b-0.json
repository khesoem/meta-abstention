       e.cap -= d;\n                g[e.to][e.rev].cap += d;\n                return d;\n            }\n        }\n    }\n    return 0;\n}\n\nint max_flow(int s, int t) {\n    int flow = 0;\n    while (bfs(s, t)) {\n        fill(it, it+2*N, 0);\n        while (int f = dfs(s, t, 1e9)) flow += f;\n    }\n    return flow;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false); cin.tie(0); cout.tie(0);\n    int n = read(), dt = read();\n    vector<vector<int>> a(n, vector<int>(n));\n    vector<vector<int>> b(n, vector<int>(n));\n    vector<vector<bool>> red(n, vector<bool>(n, false));\n    vector<vector<bool>> block(n, vector<bool>(n, false));\n    for (int x=0; x<n; ++x) {\n        for (int y=0; y<n; ++y) {\n            char c; cin >> c;\n            if (c == 'Y') block[x][y] = true;\n            else if (c == 'Z') red[x][y] = true;\n            else a[x][y] = c - '0';\n        }\n    }\n    for (int x=0; x<n; ++x) {\n        for (int y=0; y<n; ++y) {\n            char c; cin >> c;\n            if (c != 'Y' && c != 'Z') b[x][y] = c - '0';\n        }\n    }\n    int m = n*n;\n    vector<vector<int>> dis(m, vector<int>(m, 1e9));\n    for (int i=0; i<m; ++i) dis[i][i] = 0;\n    int dx[4] = {0,-1,0,1};\n    int dy[4] = {1,0,-1,0};\n    for (int x=0; x<n; ++x) {\n        for (int y=0; y<n; ++y) {\n            if (block[x][y] || red[x][y]) continue;\n            for (int d=0; d<4; ++d) {\n                int i = x+dx[d], j = y+dy[d];\n                if (i>=0 && i<n && j>=0 && j<n && !block[i][j] && !red[i][j]) {\n                    dis[x*n+y][i*n+j] = 1;\n                }\n            }\n        }\n    }\n    for (int k=0; k<m; ++k)\n        for (int i=0; i<m; ++i)\n            for (int j=0; j<m; ++j)\n                if (dis[i][k] + dis[k][j] < dis[i][j])\n                    dis[i][j] = dis[i][k] + dis[k][j];\n    vector<int> dred(m, 1e9);\n    queue<pii> q;\n    for (int i=0; i<n; ++i)\n        for (int j=0; j<n; ++j)\n            if (red[i][j]) {\n                dr