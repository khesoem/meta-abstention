 = new int[MAXN];\n        int[] dp = new int[18 * MAXN];\n        boolean[] seen = new boolean[MAXN];\n\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = (int)((1L * fact[i - 1] * i) % mod);\n        }\n\n        inv[n] = mod_pow(fact[n], mod - 2, mod);\n        for (int i = n - 1; i >= 0; --i) {\n            inv[i] = (int)((1L * inv[i + 1] * (i + 1)) % mod);\n        }\n\n        dp[0 * MAXN + 0] = 1; // IDX(0,0)\n\n        for (int i = 0; i <= n; ++i) {\n            int cnt = 0;\n            for (int x = i; x != 0; x &= x - 1) cnt++;\n            pc[i] = cnt;\n        }\n\n        for (int i = n; ; i = (i - 1) & n) {\n            seen[i] = true;\n            if (i == 0) break;\n        }\n\n        for (int i = 1; i <= n; ++i) {\n            if (!seen[i]) continue;\n            for (int j = i; j != 0; j = (j - 1) & i) {\n                int lim = Math.min(k, pc[i - j] + 1);\n                for (int s = 1; s <= lim; ++s) {\n                    int prev = dp[(s - 1) * MAXN + (i - j)];\n                    if (prev != 0) {\n                        int cur = dp[s * MAXN + i];\n                        dp[s * MAXN + i] = (int)((cur + 1L * prev * inv[j]) % mod);\n                    }\n                }\n            }\n        }\n\n        int ans = 0;\n        int limit = Math.min(k, pc[n]);\n        for (int i = 0; i <= limit; ++i) {\n            int val = dp[i * MAXN + n];\n            if (val != 0) {\n                long tmp = val;\n                tmp = tmp * fact[k] % mod;\n                tmp = tmp * inv[k - i] % mod;\n                tmp = tmp * inv[i] % mod;\n                tmp = tmp * fact[n] % mod;\n                ans = (ans + (int)tmp) % mod;\n            }\n        }\n\n        int res = (mod_pow(k, n, mod) - ans + mod) % mod;\n        System.out.println(res);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.048671357333660126, -2.825220326485578e-05, 0.0, -2.3841855067985307e-07