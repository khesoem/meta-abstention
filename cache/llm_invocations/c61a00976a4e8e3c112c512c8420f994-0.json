{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following PyPy 3 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original PyPy 3 code you have to translate:\n<original_code>\nimport sys\n\ndef main():\n    n, h = map(int, sys.stdin.buffer.readline().split())\n    s = [1] * (n + 1)\n    for m in range(1, n + 1):\n        s[m] = sum(s[m - 1 - k] * s[k] for k in range(m))\n    t = s\n    for _ in range(h):\n        nt = [0] * (n + 1)\n        for m in range(1, n + 1):\n            cs = 0\n            ct = 0\n            for k in range(m):\n                cs += s[k] * t[m - 1 - k]\n                ct += t[k] * t[m - 1 - k]\n            nt[m] = 2 * cs - ct\n        t = nt\n    print(t[n])\n\nif __name__ == \"__main__\":\n    main()\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdint>\n#include <string>\n\nusing namespace std;\n\ntypedef unsigned long long ull;\n\nconst ull BASE = 1000000000ULL; // 10^9\n\nstruct BigInt {\n    vector<ull> digits; // little-endian, each digit < BASE\n\n    BigInt() : digits(1, 0) {}\n    BigInt(ull x) {\n        if (x == 0) digits.push_back(0);\n        else {\n            while (x) {\n                digits.push_back(x % BASE);\n                x /= BASE;\n            }\n        }\n    }\n    BigInt(const BigInt& other) : digits(other.digits) {}\n\n    BigInt& operator=(const BigInt& other) {\n        digits = other.digits;\n        return *this;\n    }\n\n    bool is_zero() const {\n        return digits.size() == 1 && digits[0] == 0;\n    }\n\n    // compare absolute values (assume both positive)\n    bool operator<(const BigInt& other) const {\n        if (digits.size() != other.digits.size())\n            return digits.size() < other.digits.size();\n        for (int i = (int)digits.size() - 1; i >= 0; --i) {\n            if (digits[i] != other.digits[i])\n                return digits[i] < other.digits[i];\n        }\n        return false;\n    }\n\n    BigInt operator+(const BigInt& other) const {\n        BigInt res;\n        res.digits.clear();\n        ull carry = 0;\n        size_t max_len = max(digits.size(), other.digits.size());\n        for (size_t i = 0; i < max_len || carry; ++i) {\n            ull sum = carry;\n            if (i < digits.size()) sum += digits[i];\n            if (i < other.digits.size()) sum += other.digits[i];\n            res.digits.push_back(sum % BASE);\n            carry = sum / BASE;\n        }\n        return res;\n    }\n\n    // assume *this >= other (both positive)\n    BigInt operator-(const BigInt& other) const {\n        BigInt res;\n        res.digits.clear();\n        ull borrow = 0;\n        size_t max_len = digits.size();\n        for (size_t i = 0; i < max_len; ++i) {\n            ull diff = digits[i] - borrow;\n            if (i < other.digits.size()) diff -= other.digits[i];\n            else diff -= 0;\n            if (diff > digits[i]) { // underflow\n                diff += BASE;\n                borrow = 1;\n            } else {\n                borrow = 0;\n            }\n            res.digits.push_back(diff);\n        }\n        // remove leading zeros\n        while (res.digits.size() > 1 && res.digits.back() == 0)\n            res.digits.pop_back();\n        return res;\n    }\n\n    BigInt operator*(const BigInt& other) const {\n        BigInt res;\n        res.digits.assign(digits.size() + other.digits.size(), 0);\n        for (size_t i = 0; i < digits.size(); ++i) {\n            ull carry = 0;\n            for (size_t j = 0; j < other.digits.size() || carry; ++j) {\n                ull prod = res.digits[i + j] + carry;\n                if (j < other.digits.size())\n                    prod += digits[i] * other.digits[j];\n                res.digits[i + j] = prod % BASE;\n                carry = prod / BASE;\n            }\n        }\n        while (res.digits.size() > 1 && res.digits.back() == 0)\n            res.digits.pop_back();\n        return res;\n    }\n\n    // multiply by small integer (0 <= x < BASE)\n    BigInt operator*(ull x) const {\n        if (x == 0) return BigInt(0);\n        BigInt res;\n        res.digits.clear();\n        ull carry = 0;\n        for (size_t i = 0; i < digits.size() || carry; ++i) {\n            ull prod = carry;\n            if (i < digits.size()) prod += digits[i] * x;\n            res.digits.push_back(prod % BASE);\n            carry = prod / BASE;\n        }\n        return res;\n    }\n\n    void print() const {\n        if (digits.empty()) { cout << 0; return; }\n        cout << digits.back();\n        for (int i = (int)digits.size() - 2; i >= 0; --i) {\n            string s = to_string(digits[i]);\n            while (s.length() < 9) s = \"0\" + s;\n            cout << s;\n        }\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, h;\n    cin >> n >> h;\n\n    vector<BigInt> s(n + 1);\n    s[0] = BigInt(1);\n    for (int m = 1; m <= n; ++m) {\n        BigInt sum(0);\n        for (int k = 0; k < m; ++k) {\n            sum = sum + s[k] * s[m - 1 - k];\n        }\n        s[m] = sum;\n    }\n\n    vector<BigInt> t = s;\n\n    for (int iter = 0; iter < h; ++iter) {\n        vector<BigInt> nt(n + 1);\n        for (int m = 1; m <= n; ++m) {\n            BigInt cs(0), ct(0);\n            for (int k = 0; k < m; ++k) {\n                cs = cs + s[k] * t[m - 1 - k];\n                ct = ct + t[k] * t[m - 1 - k];\n            }\n            nt[m] = cs * 2 - ct; // 2*cs - ct\n        }\n        t = nt;\n    }\n\n    t[n].print();\n    cout << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00015948931104503572, 0.0, -2.3841855067985307e-07, -0.00032908268622122705, -0.0016669438919052482, -2.0265558760002023e-06, -0.004152129869908094, -1.2993727978027891e-05, 0.0, 0.0, -2.1219027985353023e-05, -1.0728830375228426e-06, 0.0, -1.1920928244535389e-07, -0.5929319858551025, -0.0003060825983993709, -2.753696753643453e-05, -1.1920928244535389e-07, -0.4747479259967804, -0.0026058547664433718, -1.6689160474925302e-05, -0.25196054577827454, -0.06197276711463928, -1.1920928244535389e-07, -0.02111620269715786, -0.47411394119262695, -0.0427619069814682, -0.0008212531101889908, 0.0, -0.0007138088112697005, -0.47753870487213135, -0.10029598325490952, -2.145764938177308e-06, 0.0, -0.0004731489170808345, -0.06200895830988884, -0.08879220485687256, -0.00017557987303007394, -3.3378546504536644e-06, 0.0, -2.3841855067985307e-07, -4.565611743601039e-05, -1.1920928244535389e-07, 0.0, -1.2516897186287679e-05, -0.007621141150593758, -0.08372765779495239, -0.014196592383086681, -0.0009284476400353014, -0.007621259428560734, 0.0, -8.344646857949556e-07, -0.014362412504851818, -0.0009712031460367143, -9.667406266089529e-05, -2.9802276912960224e-06, -1.311301275563892e-06, -1.4305104514278355e-06, -7.664863369427621e-05, -9.536738616588991e-07, -1.1920928244535389e-07, 0.0, -0.0015569719253107905, -0.048679303377866745, -0.0007120219524949789, -0.0623931884765625, -0.006723992992192507, -4.768370445162873e-07, -0.2043587863445282, -0.04523249715566635,