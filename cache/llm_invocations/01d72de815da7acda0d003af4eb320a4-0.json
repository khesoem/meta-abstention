{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing int64 = long long;\nconstexpr int MOD = 1000000007;\n\ninline int add_(int x, int y) { x += y; if (x >= MOD) x -= MOD; return x; }\ninline int sub_(int x, int y) { x -= y; if (x < 0) x += MOD; return x; }\ninline int mul_(int64 x, int64 y) { return (x * y) % MOD; }\n\nint binpow_(int b, int e) {\n    int r = 1;\n    while (e) {\n        if (e & 1) r = mul_(r, b);\n        b = mul_(b, b);\n        e >>= 1;\n    }\n    return r;\n}\n\nint inv_(int a) { return binpow_(a, MOD - 2); }\nint div_(int a, int b) { return mul_(a, inv_(b)); }\n\nint main() {\n#ifdef LOCAL\n    freopen(\"A.in\", \"r\", stdin);\n    freopen(\"A.out\", \"w\", stdout);\n#endif\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n\n    vector<vector<int>> val(n, vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> val[i][j];\n            val[i][j] = div_(val[i][j], 100);\n        }\n\n    using State = pair<vector<char>, int>;\n    vector<State> cur;\n    cur.reserve(100);\n    cur.emplace_back(vector<char>{0}, 1);\n\n    for (int g = 0; g < n; ++g) {\n        vector<State> nxt;\n        nxt.reserve(1024);\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prob = 1;\n            for (int j = 0; j < n; ++j) {\n                if (mask >> j & 1)\n                    prob = mul_(prob, val[j][g]);\n                else\n                    prob = mul_(prob, sub_(1, val[j][g]));\n            }\n\n            for (const auto& [prev_masks, coef] : cur) {\n                vector<char> cur_masks;\n                for (char base : prev_masks) {\n                    int rem = mask & ~base;\n                    while (rem) {\n                        int bit = rem & -rem;\n                        cur_masks.push_back(base | bit);\n                        rem ^= bit;\n                    }\n                }\n                if (cur_masks.empty()) continue;\n\n                sort(cur_masks.begin(), cur_masks.end());\n                cur_masks.erase(unique(cur_masks.begin(), cur_masks.end()), cur_masks.end());\n\n                nxt.emplace_back(cur_masks, mul_(coef, prob));\n            }\n        }\n\n        sort(nxt.begin(), nxt.end(),\n            [](const State& a, const State& b) {\n                return a.first < b.first;\n            });\n\n        cur.clear();\n        for (int i = 0; i < (int)nxt.size(); ) {\n            int j = i;\n            int cum = 0;\n            const auto& key = nxt[i].first;\n            while (j < (int)nxt.size() && nxt[j].first == key)\n                cum = add_(cum, nxt[j++].second);\n            cur.emplace_back(key, cum);\n            i = j;\n        }\n    }\n\n    int ans = 0;\n    for (const auto& [_, coef] : cur)\n        ans = add_(ans, coef);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n\n    static int add(int x, int y) {\n        x += y;\n        if (x >= MOD) x -= MOD;\n        return x;\n    }\n\n    static int sub(int x, int y) {\n        x -= y;\n        if (x < 0) x += MOD;\n        return x;\n    }\n\n    static int mul(long x, long y) {\n        return (int) ((x * y) % MOD);\n    }\n\n    static int binpow(int b, int e) {\n        int r = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) r = mul(r, b);\n            b = mul(b, b);\n            e >>= 1;\n        }\n        return r;\n    }\n\n    static int inv(int a) {\n        return binpow(a, MOD - 2);\n    }\n\n    static int div(int a, int b) {\n        return mul(a, inv(b));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n\n        int[][] val = new int[n][n];\n        for (int i = 0; i < n; ++i) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; ++j) {\n                val[i][j] = div(Integer.parseInt(st.nextToken()), 100);\n            }\n        }\n\n        // Using List instead of vector for State\n        List<State> cur = new ArrayList<>();\n        cur.add(new State(new byte[]{0}, 1));\n\n        for (int g = 0; g < n; ++g) {\n            List<State> nxt = new ArrayList<>();\n\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                int prob = 1;\n                for (int j = 0; j < n; ++j) {\n                    if ((mask >> j & 1) == 1)\n                        prob = mul(prob, val[j][g]);\n                    else\n                        prob = mul(prob, sub(1, val[j][g]));\n                }\n\n                for (State state : cur) {\n                    byte[] prevMasks = state.masks;\n                    int coef = state.coef;\n\n                    List<Byte> curMasks = new ArrayList<>();\n                    for (byte base : prevMasks) {\n                        int rem = mask & ~((int) base & 0xFF);\n                        while (rem != 0) {\n                            int bit = rem & -rem;\n                            curMasks.add((byte) ((base & 0xFF) | bit));\n                            rem ^= bit;\n                        }\n                    }\n\n                    if (curMasks.isEmpty()) continue;\n\n                    Collections.sort(curMasks);\n                    List<Byte> uniqueMasks = new ArrayList<>();\n                    Byte last = null;\n                    for (Byte b : curMasks) {\n                        if (last == null || last != b) {\n                            uniqueMasks.add(b);\n                            last = b;\n                        }\n                    }\n\n                    byte[] uniqueArray = new byte[uniqueMasks.size()];\n                    for (int i = 0; i < uniqueMasks.size(); i++) {\n                        uniqueArray[i] = uniqueMasks.get(i);\n                    }\n\n                    nxt.add(new State(uniqueArray, mul(coef, prob)));\n                }\n            }\n\n            Collections.sort(nxt, (a, b) -> {\n                if (a.masks.length != b.masks.length) {\n                    return Integer.compare(a.masks.length, b.masks.length);\n                }\n                for (int i = 0; i < Math.min(a.masks.length, b.masks.length); i++) {\n                    int cmp = Byte.compare(a.masks[i] & 0xFF, b.masks[i] & 0xFF);\n                    if (cmp != 0) return cmp;\n                }\n                return 0;\n            });\n\n            cur.clear();\n            for (int i = 0; i < nxt.size(); ) {\n                int j = i;\n                int cum = 0;\n                byte[] key = nxt.get(i). masks;\n                while (j < nxt.size() && Arrays.equals(nxt.get(j).masks, key)) {\n                    cum = add(cum, nxt.get(j).coef);\n                    j++;\n                }\n                cur.add(new State(key, cum));\n                i = j;\n            }\n        }\n\n        int ans = 0;\n        for (State state : cur) {\n            ans = add(ans, state.coef);\n        }\n        System.out.println(ans);\n    }\n\n    static class State {\n        byte[] masks;\n        int coef;\n\n        State(byte[] masks, int coef) {\n            this.masks = masks;\n            this.coef = coef;\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-0.00019536493346095085, -2.622600959512056e-06, -7.152555099310121e-07, -0.0007278653793036938, -5.543078441405669e-05, -0.033685650676488876, -0.20144735276699066, -0.0028676362708210945, -3.40932747349143e-05, -0.0006216024048626423, -0.0003364712174516171, -0.0002954761730507016, -1.5497195136049413e-06, -5.352353764465079e-05, -0.0076119136065244675, -2.145764938177308e-06, -0.5652648210525513, -0.0009324969723820686, -0.0004897110629826784, -4.529942543740617e-06, 0.0, -1.1920928244535389e-07, 0.0, -1.6689160474925302e-05, 0.0, 0.0, -8.940656698541716e-06, 0.0, 0.0, -3.4570634852570947e-06, 0.0, -4.768370445162873e-07, -0.20141352713108063, -7.152555099310121e-07, -0.009938164614140987, -0.0001554368354845792, -3.2305197237292305e-05, -0.5759578943252563, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, -0.004620233550667763, -1.5616295058862306e-05, -1.0728830375228426e-06, -0.0019319456769153476, 0.0, -1.311301275563892e-06, -1.0728830375228426e-06, -7.152555099310121e-07, -3.576278118089249e-07, 0.0, 0.0, -1.7762025890988298e-05, -7.152555099310121e-07, -4.291525328881107e-06, -2.3841855067985307e-07, -5.960446742392378e-06, -9.536738616588991e-07, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, -1.311301275563892e-06, -1.0728830375228426e-06, -1.4305104514278355e-06, 0.0, -2.0265558760002023e-06, -1.5497195136049413e-