k) {\n            int prob = 1;\n            for (int row = 0; row < n; ++row) {\n                if (mask & (1 << row))\n                    prob = mul(prob, mat[row][col]);\n                else\n                    prob = mul(prob, sub(1, mat[row][col]));\n            }\n            for (auto &p : cur) {\n                vector<int> tmp;\n                for (int m : p.first) {\n                    int diff = (~m) & mask;\n                    while (diff) {\n                        int low = diff & -diff;\n                        tmp.push_back(m | low);\n                        diff ^= low;\n                    }\n                }\n                if (tmp.empty()) continue;\n                sort(tmp.begin(), tmp.end());\n                tmp.erase(unique(tmp.begin(), tmp.end()), tmp.end());\n                nxt.push_back({tmp, mul(p.second, prob)});\n            }\n        }\n        sort(nxt.begin(), nxt.end());\n        cur.clear();\n        int i = 0;\n        while (i < (int)nxt.size()) {\n            int j = i;\n            int sum = 0;\n            while (j < (int)nxt.size() && nxt[j].first == nxt[i].first) {\n                sum = add(sum, nxt[j].second);\n                ++j;\n            }\n            cur.push_back({nxt[i].first, sum});\n            i = j;\n        }\n    }\n\n    int ans = 0;\n    for (auto &p : cur)\n        ans = add(ans, p.second);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\nINV100 = pow(100, MOD - 2, MOD)\n\ndef add(a, b):\n    return (a + b) % MOD\n\ndef sub(a, b):\n    return (a - b) % MOD\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef powmod(a, e):\n    return pow(a, e, MOD)\n\ndef inv(x):\n    return pow(x, MOD - 2, MOD)\n\ndef divide(a, b):\n    return mul(a, inv(b))\n\ndef main():\n    data = list(map(int, sys.stdin.read()