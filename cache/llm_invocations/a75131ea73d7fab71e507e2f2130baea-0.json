             res[i + j] = (res[i + j] + r[i] * r[j]) % p\n        return res\n\ndef subset_pow_convol(a, k, p):\n    logn = 19\n    fa = [[0] * (1 << logn) for _ in range(logn)]\n    fc = [[0] * (1 << logn) for _ in range(logn)]\n    n = len(a)\n    while n != (n & -n):\n        n += n & -n\n    res = [0] * n\n    for i in range(logn):\n        for j in range(n):\n            if bitcount(j) == i:\n                fa[i][j] = a[j] if j < len(a) else 0\n            else:\n                fa[i][j] = 0\n        transform(fa[i], n, p, 0)\n    for i in range(n):\n        va = [fa[j][i] for j in range(logn)]\n        va = pow_convol(va, k, p)\n        for j in range(logn):\n            fc[j][i] = va[j]\n    for i in range(logn):\n        transform(fc[i], n, p, 1)\n        for j in range(n):\n            if bitcount(j) == i:\n                res[j] = fc[i][j]\n    return res\n\ndef solve():\n    input_line = input().strip().split()\n    n = int(input_line[0])\n    k = int(input_line[1])\n    p = int(input_line[2])\n    \n    nn = n\n    f = {}\n    for i in range(n + 1):\n        if (n & i) == i:\n            t = 0\n            for j in range(20):\n                if bit(n, j):\n                    t <<= 1\n                    t |= bit(i, j)\n            f[t] = i\n            nn = t\n    \n    if n & 1:\n        print(fpow(k, n, p))\n        return\n    \n    maxn = 10**6 + 5\n    fac = [1] * maxn\n    for i in range(1, maxn):\n        fac[i] = (fac[i-1] * i) % p\n    \n    ifac = [0] * maxn\n    for i in range(maxn):\n        ifac[i] = inv(fac[i], p)\n    \n    a = [0] * (nn + 1)\n    for i in range(nn + 1):\n        a[i] = ifac[f[i]]\n    \n    res = fpow(k, n, p)\n    a = subset_pow_convol(a, k, p)\n    res = (res - (a[nn] * fac[n]) % p) % p\n    print(res)\n\ndef main():\n    try:\n        with open(\"in.txt\", \"r\") as f:\n            sys.stdin = f\n    except FileNotFoundError:\n        pass\n    \n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_