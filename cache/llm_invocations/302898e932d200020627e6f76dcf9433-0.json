(j=0;j<maxm;j++){\n\t\t\t\tArrays.fill(dp[i][j],100);\n\t\t\t}\n\t\t}\n\n\t\tfor(i=0;i<maxm;i++){\n\t\t\ts[i] = cal(i);\n\t\t\tdp[0][0][i] = 0;\n\t\t}\n\n\t\tfor(i=1;i<=n;i++){\n\t\t\tfor(j=0;j<maxm;j++){\n\t\t\t\tfor(k=0;k<maxm;k++){\n\t\t\t\t\tfor(l=0;l<maxm;l++){\n\t\t\t\t\t\tif(dp[i-1][k][l]!=100 && check(k,l,j)){\n\t\t\t\t\t\t\tdp[i][l][j] = Math.min(dp[i-1][k][l]+s[l],dp[i][l][j]);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tint ans = 100;\n\t\tfor(i=0;i<maxm;i++)\n\t\t\tans = Math.min(dp[n][i][0],ans);\n\n\t\tSystem.out.println(n*m-ans);\n\t\treturn;\n\t}\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef cal(cur):\n    res = 0\n    while cur > 0:\n        res += 1\n        cur = cur & (cur - 1)\n    return res\n\ndef check(a, b, c, maxm):\n    res = (maxm - 1) & (b | (b << 1) | (b >> 1) | a | c)\n    if res == maxm - 1:\n        return True\n    else:\n        return False\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    m = int(data[1])\n    \n    if n < m:\n        n, m = m, n\n    \n    maxm = 1 << m\n    \n    # Initialize dp with large values (100 as in original code)\n    dp = [[[100] * maxm for _ in range(maxm)] for _ in range(n + 1)]\n    \n    # Precompute s array\n    s = [cal(i) for i in range(maxm)]\n    \n    # Initialize dp[0][0][i] = 0\n    for i in range(maxm):\n        dp[0][0][i] = 0\n    \n    # Fill dp table\n    for i in range(1, n + 1):\n        for j in range(maxm):\n            for k in range(maxm):\n                for l in range(maxm):\n                    if dp[i-1][k][l] != 100 and check(k, l, j, maxm):\n                        dp[i][l][j] = min(dp[i-1][k][l] + s[l], dp[i][l][j])\n    \n    # Find answer\n    ans = 100\n    for i in range(maxm):\n        ans = min(dp[n][i][0], ans)\n    \n    print(n * m - ans)\