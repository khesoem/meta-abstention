              if (e.cap - e.flow <= 0) continue;\n\n                int nd = d + e.cost + pot[u] - pot[e.to];\n                if (nd < dist[e.to]) {\n                    dist[e.to] = nd;\n                    pv[e.to] = u;\n                    pe[e.to] = i;\n                    pq.push({nd, e.to});\n                }\n            }\n        }\n\n        if (dist[t] == INF) break;\n\n        for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n        // Every augmenting path must begin with an unused capacity-1 source edge,\n        // so the bottleneck is always exactly one unit.\n        int add = 1;\n\n        flow += add;\n        for (int v = t; v != s; v = pv[v]) {\n            Edge &e = g[pv[v]][pe[v]];\n            e.flow += add;\n            g[v][e.rev].flow -= add;\n            flow_cost += add * e.cost;\n        }\n    }\n\n    return {flow, flow_cost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    g.assign(N + 2, {});\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    pair<int, int> ans = min_cost_flow(N, N + 1);\n    assert(ans.first == k);\n    cout << ans.second << endl;\n    return 0;\n}\n</original_code>\n"}], "t