hile (!q.empty()) {\n            int x = q.front(); q.pop();\n            vis[x] = 0;\n            for (int i = 0; i < adj[x].size(); ++i) {\n                int y = adj[x][i];\n                int cc = dist[x] + cost[x][i];\n                if (dist[y] > cc && cap[x][i]) {\n                    dist[y] = cc;\n                    prex[y] = x;\n                    prei[y] = i;\n                    if (!vis[y]) {\n                        vis[y] = 1;\n                        q.push(y);\n                    }\n                }\n            }\n        }\n    }\n    \n    int tot = 0;\n    \n    int dfs(int x, int flow) {\n        if (prex[x] == -1) return flow;\n        int y = x;\n        x = prex[y];\n        int i = prei[y];\n        int j = rev[x][i];\n        int f = dfs(x, min(flow, cap[x][i]));\n        cap[x][i] -= f;\n        cap[y][j] += f;\n        return f;\n    }\n    \n    pii solve(int s, int t) {\n        int ans = 0;\n        tot = 0;\n        while (true) {\n            spfa(s);\n            if (dist[t] > 1e9) break;\n            int f = dfs(t, INF);\n            tot += f * dist[t];\n            ans += f;\n        }\n        return {ans, tot};\n    }\n};\n\nint n, m, s, t;\nint k, c, d;\n\nint get(int x, int tim) {\n    return tim * 52 - 52 + x;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> k >> c >> d;\n    int kk = k;\n    \n    s = MAX_NODES - 1;\n    t = MAX_NODES - 2;\n    \n    MCMF g(MAX_NODES);\n    \n    while (k--) {\n        int x;\n        cin >> x;\n        g.addEdge(s, get(x, 1), 1, 0);\n    }\n    k = kk;\n    \n    while (m--) {\n        int x, y;\n        cin >> x >> y;\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= k; ++j) {\n                g.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n            }\n        }\n        swap(x, y);\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= k; ++j) {\n                g.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n            }\n        }\n    }\n    \n    for (int i = 1; i < 100; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            g.addEdge(get(j, i), get(j, i + 1), INF, 0);\n        }\n        g.addEdge(get(1, i), t, INF, c * (i - 1));\n    }\n    \n    cout << g.solve(s, t).second;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 100000000\nMAX_NODES = 6000\n\nclass MCMF:\n    def __init__(self, nodes):\n        self.n = nodes\n        self.adj = [[] for _ in range(n)]\n        self.rev = [[] for _ in range(n)]\n        self.cost = [[] for _ in range(n)]\n        self.cap = [[] for _ in range(n)]\n    \n    def addEdge(self, x, y, c, w):\n        self.rev[x].append(len(self.adj[y]))\n        self.rev[y].append(len(self.adj[x]))\n        self.adj[x].append(y)\n        self.adj[y].append(x)\n        self.cost[x].append(w)\n        self.cost[y].append(-w)\n        self.cap[x].append(c)\n        self.cap[y].append(0)\n    \n    def spfa(self, s):\n        dist = [0x3f3f3f3f] * self.n\n        vis = [0] * self.n\n        prex = [-1] * self.n\n        prei = [-1] * self.n\n        prex[s] = -1\n        q = deque()\n        q.append(s)\n        dist[s] = 0\n        vis[s] = 1\n        \n        while q:\n            x = q.popleft()\n            vis[x] = 0\n            for i in range(len(self.adj[x])):\n                y = self.adj[x][i]\n                cc = dist[x] + self.cost[x][i]\n                if dist[y] > cc and self.cap[x][i]:\n                    dist[y] = cc\n                    prex[y] = x\n                    prei[y] = i\n                    if not vis[y]:\n                        vis[y] = 1\n                        q.append(y)\n        \n        return dist, prex, prei\n    \n    def dfs(self, x, flow, prex, prei):\n        if prex[x] == -1:\n            return flow\n        y = x\n        x = prex[y]\n        i = prei[y]\n        j = self.rev[x][i]\n        f = self.dfs(x, min(flow, self.cap[x][i]), prex, prei)\n        self.cap[x][i] -= f\n        self.cap[y][j] += f\n        return f\n    \n    def solve(self, s, t):\n        ans = 0\n        tot = 0\n        while True:\n            dist, prex, prei = self.spfa(s)\n            if dist[t] > 1e9:\n                break\n            f = self.dfs(t, INF, prex, prei)\n            tot += f * dist[t]\n            ans += f\n        return (ans, tot)\n\ndef get(x, tim):\n    return tim * 52 - 52 + x\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    kk = k\n    \n    s = MAX_NODES - 1\n    t = MAX_NODES - 2\n    \n    g = MCMF(MAX_NODES)\n    \n    while k:\n        x = int(data[idx]); idx += 1\n        g.addEdge(s, get(x, 1), 1, 0)\n        k -= 1\n    \n    k = kk\n    \n    while m:\n        x = int(data[idx]); idx += 1\n        y = int(data[idx]); idx += 1\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                g.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        x, y = y, x\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                g.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        m -= 1\n    \n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            g.addEdge(get(j, i), get(j, i + 1), INF, 0)\n        g.addEdge(get(1, i), t, INF, c * (i - 1))\n    \n    result = g.solve(s, t)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0001525762490928173, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.001401157584041357,