es[i][j] = static_cast<int>(sum);\n        }\n    }\n    return res;\n}\n\nint main() {\n    ll n;\n    int k;\n    cin >> n >> k;\n    int max_depth = 0;\n    {\n        ll tmp_val = n;\n        while (tmp_val != 0) {\n            ++max_depth;\n            tmp_val /= k;\n        }\n    }\n    dp.resize(max_depth);\n    {\n        dp[0].assign(k + 1, vector<int>(k + 1, 0));\n        for (int i = 0; i <= k; ++i) {\n            for (int j = 0; j <= k; ++j) {\n                dp[0][i][j] = (i == j || j == 0) ? 1 : 0;\n            }\n        }\n        Matrix e(k + 1, vector<int>(k + 1, 0));\n        for (int i = 0; i <= k; ++i) {\n            e[i][i] = 1;\n        }\n        for (int depth = 1; depth < max_depth; ++depth) {\n            dp[depth] = e;\n            Matrix bs = dp[depth - 1];\n            int curx = k;\n            for (int i = 0; (1 << i) <= curx; ++i) {\n                if (curx & (1 << i)) {\n                    dp[depth] = multiply(bs, shift(dp[depth], 1 << i));\n                    curx ^= (1 << i);\n                }\n                bs = multiply(bs, shift(bs, 1 << i));\n            }\n        }\n    }\n    base.assign(1, vector<int>(k + 1, 0));\n    base[0][k] = 1;\n    int sl = 0;\n    ll x = n;\n    vector<int> vec;\n    while (x != 0) {\n        vec.push_back(x % k);\n        x /= k;\n    }\n    int len = static_cast<int>(vec.size());\n    for (int cur_depth = len - 1; cur_depth >= 0; --cur_depth) {\n        int rest = vec[cur_depth];\n        for (int it = 0; it < rest; ++it, sl = (sl + 1) % k) {\n            base = multiply(base, shift(dp[cur_depth], sl));\n        }\n    }\n    {\n        int res = 0;\n        for (int i = 0; i <= k; ++i) {\n            res = (res + base[0][i]) % MOD;\n        }\n        cout << res << '\\n';\n    }\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007