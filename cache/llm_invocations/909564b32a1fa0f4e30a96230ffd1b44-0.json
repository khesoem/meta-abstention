r[i >> 1] + (i & 1);\n    }\n    \n    if (n & 1) {\n        cout << result << '\\n';\n        return 0;\n    }\n    \n    dp[0][0] = 1;\n    int maxBit = min<int>(popcountArr[n], m);\n    \n    for (int i = 0; i < maxBit; i++) {\n        for (int j = 0; j <= n; j++) {\n            if (!dp[i][j]) continue;\n            int complement = n ^ j;\n            for (int k = complement; k > j; k = (k - 1) & complement) {\n                int combined = k | j;\n                accumulateMod(dp[i + 1][combined], dp[i][j] * inverse[k] % modulus);\n            }\n        }\n    }\n    \n    for (int i = 1; i <= m; i++) {\n        long long term = dp[i][n] * factorial[m] % modulus;\n        term = term * inverse[m - i] % modulus;\n        term = term * factorial[n] % modulus;\n        result = (result - term % modulus + modulus) % modulus;\n    }\n    \n    cout << result << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAX_N = 250010;\n    static long[] factorial = new long[MAX_N];\n    static long[] inverse = new long[MAX_N];\n    static long[][] dp = new long[30][MAX_N];\n    static int[] popcountArr = new int[MAX_N];\n    static long n, m, modulus;\n\n    static long binomial(int nn, int mm) {\n        return factorial[nn] * inverse[nn - mm] % modulus * inverse[mm] % modulus;\n    }\n\n    static void accumulateMod(long[] arr, int idx, long y) {\n        arr[idx] = (arr[idx] + y) % modulus;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Long.parseLong(st.nextToken());\n        m = Long.parseLong(st.nextToken());\n        modulus = Long.parseLong(st.nextToken());\n\n 