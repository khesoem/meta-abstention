{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cstring>\n#include <cmath>\nusing namespace std;\n\nusing ll = long long;\n\nconst int MAX_LOG = 18;\nconst int MAX_SIZE = (1 << MAX_LOG) + 10;\nconst int MOD_DEFAULT = 1000000007;\n\nint MOD;\nint N, origN;\nint dp[MAX_SIZE][MAX_LOG + 3];\nint temp1[MAX_LOG + 3];\nint temp2[MAX_LOG + 3];\nint fact[MAX_SIZE];\nint invFact[MAX_SIZE];\n\nint modPow(int base, int exp) {\n    int res = 1;\n    while (exp > 0) {\n        if (exp & 1) res = (ll)res * base % MOD;\n        base = (ll)base * base % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nvoid addPoly(int *dest, const int *src) {\n    for (int i = 0; i <= N; ++i) {\n        dest[i] = (dest[i] + src[i]) % MOD;\n        if (dest[i] < 0) dest[i] += MOD;\n    }\n}\n\nvoid subPoly(int *dest, const int *src) {\n    for (int i = 0; i <= N; ++i) {\n        dest[i] = (dest[i] - src[i]) % MOD;\n        if (dest[i] < 0) dest[i] += MOD;\n    }\n}\n\nvoid mulPoly(int *res, const int *a, const int *b) {\n    memset(temp1, 0, sizeof(temp1));\n    for (int i = 0; i <= N; ++i) {\n        for (int j = 0; j <= i; ++j) {\n            temp1[i] = (temp1[i] + (ll)a[j] * b[i - j]) % MOD;\n        }\n    }\n    memcpy(res, temp1, sizeof(temp1));\n}\n\nvoid zeta(int table[][MAX_LOG + 3]) {\n    for (int b = 0; b < N; ++b) {\n        for (int m = origN; m >= 0; --m) {\n            if (m & (1 << b)) {\n                addPoly(table[m], table[m ^ (1 << b)]);\n            }\n        }\n    }\n}\n\nvoid mobius(int table[][MAX_LOG + 3]) {\n    for (int b = 0; b < N; ++b) {\n        for (int m = origN; m >= 0; --m) {\n            if (m & (1 << b)) {\n                subPoly(table[m], table[m ^ (1 << b)]);\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int K;\n    cin >> origN >> K >> MOD;\n\n    int total = modPow(K, origN);\n    if (origN & 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n\n    N = __builtin_popcount(origN);\n    vector<int> bitList;\n    for (int i = 0; i < MAX_LOG; ++i) {\n        if (origN & (1 << i)) bitList.push_back(i);\n    }\n\n    int nMask = (1 << N) - 1;\n\n    fact[0] = 1;\n    for (int i = 1; i < MAX_SIZE; ++i) fact[i] = (ll)i * fact[i - 1] % MOD;\n\n    invFact[MAX_SIZE - 1] = modPow(fact[MAX_SIZE - 1], MOD - 2);\n    for (int i = MAX_SIZE - 2; i >= 0; --i)\n        invFact[i] = (ll)(i + 1) * invFact[i + 1] % MOD;\n\n    for (int mask = 0; mask <= nMask; ++mask) {\n        int realVal = 0;\n        for (int j = 0; j < N; ++j) {\n            if (mask & (1 << j)) realVal += 1 << bitList[j];\n        }\n        dp[mask][__builtin_popcount(mask)] = invFact[realVal];\n    }\n\n    zeta(dp);\n\n    for (int mask = 0; mask <= nMask; ++mask) {\n        int k = K;\n        memset(temp2, 0, sizeof(temp2));\n        temp2[0] = 1;\n\n        while (k) {\n            if (k & 1) mulPoly(temp2, temp2, dp[mask]);\n            mulPoly(dp[mask], dp[mask], dp[mask]);\n            k >>= 1;\n        }\n        memcpy(dp[mask], temp2, sizeof(temp2));\n    }\n\n    mobius(dp);\n\n    ll contrib = (ll)dp[nMask][N] * fact[origN] % MOD;\n    int ans = (total - contrib) % MOD;\n    if (ans < 0) ans += MOD;\n\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef mod_pow(base, exp, mod):\n    res = 1\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef add_poly(dest, src, mod, n):\n    for i in range(n + 1):\n        dest[i] = (dest[i] + src[i]) % mod\n        if dest[i] < 0:\n            dest[i] += mod\n\ndef sub_poly(dest, src, mod, n):\n    for i in range(n + 1):\n        dest[i] = (dest[i] - src[i]) % mod\n        if dest[i] < 0:\n            dest[i] += mod\n\ndef mul_poly(res, a, b, mod, n):\n    temp1 = [0] * (n + 1)\n    for i in range(n + 1):\n        for j in range(i + 1):\n            temp1[i] = (temp1[i] + a[j] * b[i - j]) % mod\n    for i in range(n + 1):\n        res[i] = temp1[i]\n\ndef zeta(table, n, orig_n):\n    for b in range(n):\n        for m in range(orig_n, -1, -1):\n            if m & (1 << b):\n                add_poly(table[m], table[m ^ (1 << b)], MOD, n)\n\ndef mobius(table, n, orig_n):\n    for b in range(n):\n        for m in range(orig_n, -1, -1):\n            if m & (1 << b):\n                sub_poly(table[m], table[m ^ (1 << b)], MOD, n)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    origN = int(data[0])\n    K = int(data[1])\n    MOD = int(data[2])\n    \n    total = mod_pow(K, origN, MOD)\n    if origN & 1:\n        print(total)\n        return\n    \n    N = bin(origN).count('1')\n    bitList = []\n    for i in range(18):  # MAX_LOG = 18\n        if origN & (1 << i):\n            bitList.append(i)\n    \n    nMask = (1 << N) - 1\n    \n    MAX_SIZE = (1 << 18) + 10\n    MOD_DEFAULT = 1000000007\n    \n    fact = [0] * MAX_SIZE\n    invFact = [0] * MAX_SIZE\n    \n    fact[0] = 1\n    for i in range(1, MAX_SIZE):\n        fact[i] = (i * fact[i - 1]) % MOD\n    \n    invFact[MAX_SIZE - 1] = mod_pow(fact[MAX_SIZE - 1], MOD - 2, MOD)\n    for i in range(MAX_SIZE - 2, -1, -1):\n        invFact[i] = ((i + 1) * invFact[i + 1]) % MOD\n    \n    # Initialize dp table\n    dp = [[0] * (N + 3) for _ in range(nMask + 1)]\n    \n    for mask in range(nMask + 1):\n        realVal = 0\n        for j in range(N):\n            if mask & (1 << j):\n                realVal += 1 << bitList[j]\n        popcount = bin(mask).count('1')\n        dp[mask][popcount] = invFact[realVal]\n    \n    zeta(dp, N, origN)\n    \n    # Prepare temp arrays for polynomial exponentiation\n    temp2 = [0] * (N + 3)\n    \n    for mask in range(nMask + 1):\n        k = K\n        temp2 = [0] * (N + 3)\n        temp2[0] = 1\n        \n        while k:\n            if k & 1:\n                mul_poly(temp2, temp2, dp[mask], MOD, N)\n            mul_poly(dp[mask], dp[mask], dp[mask], MOD, N)\n            k >>= 1\n        \n        for i in range(N + 3):\n            dp[mask][i] = temp2[i]\n    \n    mobius(dp, N, origN)\n    \n    contrib = (dp[nMask][N] * fact[origN]) % MOD\n    ans = (total - contrib) % MOD\n    if ans < 0:\n        ans += MOD\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00015031162183731794, -8.344646857949556e-07, -4.768370445162873e-07, -0.03986763581633568, -0.00030250742565840483, -0.17988109588623047, -0.10559260100126266, -0.2814273536205292, -0.0003066784702241421, -0.12845714390277863, -0.3990241289138794, -0.3157905638217926, -2.0265558760002023e-06, -5.960462772236497e-07, -2.682172998902388e-05, -1.6689286894688848e-06, -0.0003680505615193397, -8.594620157964528e-05, -8.344646857949556e-07, -0.00011062010162277147, 0.0, 0.0, -2.3841855067985307e-07, -7.9869905