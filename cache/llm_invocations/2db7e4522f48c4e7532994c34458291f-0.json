 return a;\n    }\n    return gcd(b, a % b);\n}\n\nint bsearch(vector<long> list, long val, int ind) {\n    int l = ind, r = list.size() - 1;\n    int res = list.size();\n\n    while (l <= r) {\n        int mid = (l + r) / 2;\n        if (list[mid] > val) {\n            if (mid == 0) {\n                return mid;\n            }\n            if (list[mid - 1] <= val) {\n                return mid;\n            }\n            r = mid - 1;\n        } else {\n            l = mid + 1;\n        }\n    }\n    return res;\n}\n\nlong calc(vector<Node> list, long* b, int i) {\n    if (i == 3) {\n        return 0;\n    }\n\n    Node first = list[i];\n    int bInd = (first.ind - 1);\n    if (bInd == -1) {\n        bInd = 2;\n    }\n\n    long min1 = min(first.val, b[bInd]);\n    first.val -= min1;\n    b[bInd] -= min1;\n\n    long min2 = min(first.val, b[first.ind]);\n    first.val -= min2;\n    b[first.ind] -= min2;\n    long sum = first.val;\n    sum += calc(list, b, i + 1);\n    first.val += min1 + min2;\n    b[bInd] += min1;\n    b[first.ind] += min2;\n\n    first = list[i];\n    bInd = (first.ind - 1);\n    if (bInd == -1) {\n        bInd = 2;\n    }\n\n    min1 = min(first.val, b[first.ind]);\n    first.val -= min1;\n    b[first.ind] -= min1;\n\n    min2 = min(first.val, b[bInd]);\n    first.val -= min2;\n    b[bInd] -= min2;\n    long sum2 = first.val;\n    sum2 += calc(list, b, i + 1);\n    first.val += min1 + min2;\n    b[bInd] += min2;\n    b[first.ind] += min1;\n\n    return min(sum, sum2);\n}\n\nint main() {\n    vector<string> ans;\n    int t = 1;\n    while (t-- > 0) {\n        int n = s.nextInt();\n        long a[3], b[3];\n        for (int i = 0; i < 3; i++) {\n            a[i] = s.nextLong();\n        }\n        for (int i = 0; i < 3; i++) {\n            b[i] = s.nextLong();\n        }\n\n        long max = min(a[0], b[1]) + min(a[1], b[2]) + min(a[2], b[0]);\n        long min = max(0, a[0] + b[1] - n) + max(0, a[1] + b[2] - n) + max(0, a[2] + b[0] - n);\n    