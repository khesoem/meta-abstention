j] = 0\n\n    def shift(self, x):\n        for i in range(d+1):\n            for j in range(d+1):\n                self.cnt[i][j] = 0\n        for i in range(d):\n            for j in range(d):\n                self.cnt[(i + x) % d][(j + x) % d] = self.dp[i][j]\n            self.cnt[(i + x) % d][d] = self.dp[i][d]\n        for i in range(d):\n            self.cnt[d][(i + x) % d] = self.dp[d][i]\n        self.cnt[d][d] = self.dp[d][d]\n        for i in range(d+1):\n            for j in range(d+1):\n                self.dp[i][j] = self.cnt[i][j]\n        for i in range(d):\n            self.tark[i] = self.mark[(i + x) % d]\n        for i in range(d):\n            self.mark[i] = self.tark[i]\n\n# Global variables\nmd = [Node() for _ in range(lg+5)]\nhp = [Node() for _ in range(lg+5)]\nht = Node()\n\ndef get(x):\n    h = x\n    pw = 1\n    t = -1\n    while h >= d:\n        h //= d\n        pw *= d\n        t += 1\n    x %= pw\n    if t == -1:\n        return hp[h]\n    ans = md[t]\n    ht = md[t]\n    for _ in range(1, h):\n        ht.shift(1)\n        ans.mrg(ht)\n    ht = get(x)\n    ht.shift(h)\n    ans.mrg(ht)\n    return ans\n\ndef main():\n    global d, n, v\n    data = input().split()\n    n = int(data[0])\n    d = int(data[1])\n    n -= 1\n    v = []\n    temp_n = n\n    while temp_n:\n        v.append(temp_n % d)\n        temp_n //= d\n    # Initialize hp[0]\n    hp[0].dp[d][d] = 2\n    hp[0].dp[d][0] = -1\n    hp[0].dp[0][d] = 1\n    hp[0].mark[0] = True\n    md[0] = hp[0]\n    for i in range(1, d):\n        hp[i].dp[d][d] = 2\n        hp[i].dp[d][i] = -1\n        hp[i].dp[i][d] = 1\n        hp[i].mark[i] = True\n        md[0].mrg(hp[i])\n        hp[i] = md[0]\n    for i in range(1, len(v)+1):\n        md[i] = md[i-1]\n        ht = md[i-1]\n        for _ in range(1, d):\n            ht.shift(1)\n            md[i].mrg(ht)\n    ans = get(n)\n    # Output the result\n    output_str = str(ans.dp[d][d]) + '\\n'\n    print(output_str)\n\nif __name__ == \"__main__\"