 from, int to, int cap, int cost, int rev) : from(from), to(to), cap(cap), cost(cost), rev(rev) {}\n};\n\nclass Graph {\nprivate:\n    int vNum, src, sink;\n    vector<Edge> edges;\n    vector<int> p, d;\n\npublic:\n    Graph(int vNum, int src, int sink) : vNum(vNum), src(src), sink(sink) {\n        p.resize(vNum);\n        d.resize(vNum);\n    }\n\n    void addEdge(int from, int to, int capacity, int cost) {\n        int idx = edges.size();\n        edges.push_back(Edge(from, to, capacity, cost, idx + 1));\n        edges.push_back(Edge(to, from, 0, -cost, idx));\n    }\n\n    bool findCheapestPath() {\n        fill(d.begin(), d.end(), INF);\n        fill(p.begin(), p.end(), -1);\n        d[src] = 0;\n        bool changed;\n        for (int i = 0; i < vNum - 1; i++) {\n            changed = false;\n            for (const Edge& e : edges) {\n                if (e.cap > 0 && d[e.from] != INF && d[e.from] + e.cost < d[e.to]) {\n                    d[e.to] = d[e.from] + e.cost;\n                    p[e.to] = e.from;\n                    changed = true;\n                }\n            }\n            if (!changed) break;\n        }\n        return p[sink] != -1;\n    }\n\n    pair<int, int> augmentPath(int from, int to, int flow) {\n        int pathCost = 0;\n        // find min flow along path\n        for (int cur = to; cur != from; cur = p[cur]) {\n            int prev = p[cur];\n            for (Edge& e : edges) {\n                if (e.from == prev && e.to == cur && e.cap > 0) {\n                    flow = min(flow, e.cap);\n                    break;\n                }\n            }\n        }\n        // update edges\n        for (int cur = to; cur != from; cur = p[cur]) {\n            int prev = p[cur];\n            for (Edge& e : edges) {\n                if (e.from == prev && e.to == cur && e.cap > 0) {\n                    e.cap -= flow;\n                    edges[e.rev].cap += flow;\n                    pathCost += e.cost * flow;\n                    break;\n                }\n            }\n        }\n        return make_pair(flow, pathCost);\n    }\n\n    pair<int, int> getMinCostMaxFlow() {\n        int flow = 0;\n        int totalCost = 0;\n        while (findCheapestPath()) {\n            pair<int, int> result = augmentPath(src, sink, INF);\n            flow += result.first;\n            totalCost += result.second;\n        }\n        return make_pair(flow, totalCost);\n    }\n};\n\nint main() {\n    int letters = 'z' - 'a' + 1;\n    int n;\n    cin >> n;\n    string s;\n    cin >> s;\n    vector<char> string(s.begin(), s.end());\n    vector<int> letCount(letters, 0);\n    for (int i = 0; i < n; ++i) {\n        letCount[string[i] - 'a']++;\n    }\n    vector<int> b(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> b[i];\n    }\n\n    int source = 0;\n    int charOffSet = 1;\n    int pairOffSet = charOffSet + letters;\n    int sinkOffSet = pairOffSet + n / 2;\n    int sink = sinkOffSet;\n    int vNum = sinkOffSet + 1;\n\n    Graph g(vNum, source, sink);\n    for (int i = 0; i < letters; ++i) {\n        g.addEdge(source, charOffSet + i, letCount[i], 0);\n        for (int j = 0; j < n / 2; ++j) {\n            char c1 = string[j];\n            char c2 = string[n - j - 1];\n            if (c1 == 'a' + i) {\n                if (c1 == c2) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -max(b[j], b[n - j - 1]));\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[j]);\n                }\n            } else {\n                if (c2 == 'a' + i) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[n - j - 1]);\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, 0);\n                }\n            }\n        }\n    }\n    for (int i = 0; i < n / 2; ++i) {\n        g.addEdge(pairOffSet + i, sink, 2, 0);\n    }\n\n    pair<int, int> ans = g.getMinCostMaxFlow();\n    cout << -ans.second << endl;\n\n    r