        } else {\n                    int rem50 = x;\n                    int rem100 = y;\n                    for (int take50 = 0; take50 <= rem50; take50++) {\n                        for (int take100 = 0; take100 <= rem100; take100++) {\n                            if (take50 + take100 == 0) continue;\n                            if (take50 * 50 + take100 * 100 > K) break;\n\n                            int nx = x - take50;\n                            int ny = y - take100;\n                            int ns = side ^ 1;\n                            long nd = d + 1;\n\n                            if (dist[nx][ny][ns] >= nd) {\n                                if (dist[nx][ny][ns] > nd) {\n                                    dist[nx][ny][ns] = nd;\n                                    dq.addLast(new Node(nx, ny, ns, nd));\n                                }\n                                paths[nx][ny][ns] = (paths[nx][ny][ns] + product(paths[x][y][side], rem50, take50, rem100, take100)) % MOD;\n                            }\n                        }\n                    }\n                }\n            }\n\n            if (dist[cnt50][cnt100][1] == INF) {\n                out.println(-1);\n            } else {\n                out.println(dist[cnt50][cnt100][1]);\n            }\n            out.println(paths[cnt50][cnt100][1]);\n        }\n\n        static class Node {\n            int x, y, side;\n            long d;\n            Node(int x, int y, int side, long d) {\n                this.x = x;\n                this.y = y;\n                this.side = side;\n                this.d = d;\n            }\n        }\n    }\n\n    static class InputReader {\n        private final InputStream in;\n        private final byte[] buf = new byte[1024];\n        private int ptr = 0, len = 0;\n\n        InputReader(InputStream in) { this.in = in; }\n\n        private int read() {\n            if (len == -1) throw new RuntimeException();\n            if (ptr >= len) {\n     