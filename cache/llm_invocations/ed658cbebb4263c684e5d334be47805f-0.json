otal; ++msk) {\n            if ((msk & (1 << vr)) == 0) {\n                totFirst += dp[msk].first;\n                totSecond += dp[msk].second;\n            }\n        }\n\n        double alp = (1.0 - totSecond) / totFirst;\n\n        double badFirst = 0.0, badSecond = 0.0;\n        for (int msk = 0; msk < total; ++msk) {\n            if ((msk & (1 << vr)) == 0 && Integer.bitCount(msk) >= k) {\n                badFirst += dp[msk].first;\n                badSecond += dp[msk].second;\n            }\n        }\n\n        return 1.0 - (alp * badFirst + badSecond);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        k = sc.nextInt();\n        p = new double[n];\n        for (int i = 0; i < n; ++i) {\n            p[i] = sc.nextDouble();\n        }\n\n        for (int i = 0; i < n; ++i) {\n            if (i > 0) System.out.print(' ');\n            System.out.printf(\"%.12f\", Solve(i));\n        }\n        System.out.println();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.867782187531702e-06, -2.372236667724792e-05, -1.0728830375228426e-06, -1.1920922133867862e-06, -0.25269728899002075, -0.011056113988161087, -7.60526381782256e-05, -1.1920928244535389e-07, -7.211902266135439e-05, -0.001503290724940598, -1.3351351299206726e-05, -0.062031254172325134, -0.13291572034358978, -2.3841855067985307e-07, -8.344646857949556e-07, -1.7881377516459906e-06, 0.0, 0.0, -0.061971087008714676, 0.0, -1.4305104514278355e-06, -0.00014649749209638685, -2.753696753643453e-05, -1.1920928244535389e-07, -0.0005479741375893354, 0.0, -0.001503052655607462, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.0003592322755139321, -3.576278118089249e-07, -4.541770613286644e-05, -0.00011240804451517761, 0.0, 0.0, -0.006062688771635294, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -2.1576648578047752e-05, 0.0, 0.0, 