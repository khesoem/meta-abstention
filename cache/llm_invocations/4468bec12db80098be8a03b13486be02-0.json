) {\n            int N = 200001;\n            fact = new long[N];\n            invFact = new long[N];\n            fact[0] = invFact[0] = 1L;\n            for (int i = 1; i < N; i++) {\n                fact[i] = fact[i - 1] * i % MOD;\n                invFact[i] = invFact[i - 1] * modExp(i, MOD - 2) % MOD;\n            }\n\n            int n = in.nextInt();\n            long k = in.nextLong();\n\n            if (k >= n) {\n                out.println(0);\n                return;\n            }\n            if (k == 0) {\n                out.println(fact[n]);\n                return;\n            }\n\n            int m = n - (int)k;\n            long sum = 0L;\n            for (int i = 0; i <= m; i++) {\n                long term = nCr(m, i) * modExp(m - i, n) % MOD;\n                sum = (i % 2 == 0) ? (sum + term) % MOD : (sum - term + MOD) % MOD;\n            }\n\n            long res = 2L * fact[n] % MOD;\n            res = res * invFact[n - m] % MOD;\n            res = res * sum % MOD;\n            res = res * invFact[m] % MOD;\n            out.println(res);\n        }\n\n        private long nCr(int n, int r) {\n            return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n        }\n    }\n\n    static class InputTokenizer {\n        private BufferedReader reader;\n        private String[] tokens;\n        private int index;\n\n        public InputTokenizer(BufferedReader br) {\n            reader = br;\n            tokens = new String[0];\n            index = 0;\n        }\n\n        private void refill() throws IOException {\n            String line = reader.readLine();\n            if (line == null) throw new EOFException();\n            tokens = line.split(\"\\\\s+\");\n            index = 0;\n        }\n\n        public String next() throws IOException {\n            if (index >= tokens.length) refill();\n            return tokens[index++];\n        }\n\n        public int nextInt() throws IOException {\n            return Integer.parseInt(next(