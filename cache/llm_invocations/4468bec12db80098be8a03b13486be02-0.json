     term = self.nCr(m, i) * mod_exp(m - i, n) % MOD\n            if i % 2 == 0:\n                total_sum = (total_sum + term) % MOD\n            else:\n                total_sum = (total_sum - term + MOD) % MOD\n        \n        res = 2 * self.fact[n] % MOD\n        res = res * self.inv_fact[n - m] % MOD\n        res = res * total_sum % MOD\n        res = res * self.inv_fact[m] % MOD\n        out.println(res)\n    \n    def nCr(self, n, r):\n        return self.fact[n] * self.inv_fact[r] % MOD * self.inv_fact[n - r] % MOD\n\nclass PrintWriter:\n    def __init__(self, out):\n        self.out = out\n    \n    def println(self, value):\n        self.out.write(str(value) + '\\n')\n        self.out.flush()\n\ndef main():\n    instance = Task()\n    tokenizer = InputTokenizer(sys.stdin)\n    writer = PrintWriter(sys.stdout)\n    instance.process(1, tokenizer, writer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.450303382938728e-05, -1.311301275563892e-06, -1.1920928244535389e-07, -0.00012432756193447858, -0.00024971229140646756, -0.016039274632930756, -0.003370677586644888, -0.20806258916854858, -0.00014578233822248876, -0.07727472484111786, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -7.152555099310121e-07, -5.960462772236497e-07, -9.536738616588991e-07, -6.198863957251888e-06, -5.483612312673358e-06, -1.3708974620385561e-05, -1.5497195136049413e-06, -1.2874520507466514e-05, -0.5231706500053406, -3.6954195820726454e-05, -0.004701037425547838, -4.6491513785440475e-06, -1.1920928244535389e-07, -4.327203714638017e-05, -0.01817021332681179, -1.311301275563892e-06, -1.9907753085135482e-05, 0.0, 0.0, 0.0, -5.125986263010418e-06, 0.0, -8.344646857949556e-07, -3.2305197237292305e-05, -2.8967437174287625e-05, -7.152555099310121e-07, 0.0, -1.1920922133867862e-06, -1.549708758830093e-05, -3.576278118089249e-07, 0.0, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -2.3841855067985307e-07, -0.52317738