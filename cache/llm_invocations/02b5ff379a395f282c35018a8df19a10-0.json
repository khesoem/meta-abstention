ptr);\n    \n    cin >> N;\n    BS tmp;\n    tmp.set(0);\n    dfs(tmp, 0);\n    \n    iv100 = poww(100, MOD - 2);\n    \n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            cin >> P[i][j];\n        }\n    }\n    \n    dp[0][1] = 1;\n    int x = 0;\n    \n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < (1 << N); ++j) {\n            prob[j] = 1;\n            for (int k = 0; k < N; ++k) {\n                prob[j] = (1LL * prob[j] * iv100 % MOD) * ((j >> k & 1) ? P[i][k] : (100 - P[i][k])) % MOD;\n            }\n        }\n        \n        fill(dp[x ^= 1].begin(), dp[x ^= 1].end(), 0);\n        for (int j = 1; j <= cnt; ++j) {\n            if (dp[x ^ 1][j]) {\n                for (int k = 0; k < (1 << N); ++k) {\n                    dp[x][trans[j][k]] = (dp[x][trans[j][k]] + 1LL * dp[x ^ 1][j] * prob[k]) % MOD;\n                }\n            }\n        }\n    }\n    \n    for (int i = 0; i < (1 << N); ++i) tmp.set(i);\n    cout << dp[x][id_vec[0][tmp]] << endl;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static int N, cnt;\n    static int[][] P = new int[7][7];\n    static List<Map<BitSet, Integer>> id_vec = new ArrayList<>();\n    static List<int[]> dp = new ArrayList<>();\n    static int[][] trans;\n    static int[] prob;\n    static int iv100;\n\n    static class BitSet {\n        long[] bits;\n        int size;\n\n        public BitSet(int n) {\n            size = n;\n            bits = new long[(n + 63) / 64];\n        }\n\n        public BitSet(BitSet other) {\n            size = other.size;\n            bits = Arrays.copyOf(other.bits, other.bits.length);\n        }\n\n        public void set(int index) {\n            bits[index / 64] |= (1L << (index % 64));\n       