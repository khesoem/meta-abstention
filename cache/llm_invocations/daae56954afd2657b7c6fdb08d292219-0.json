):\n            a[i][j] = (int(input_data[idx]) * inv100) % MOD\n            idx += 1\n    \n    f = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        for mask in range(1 << n):\n            f[i][mask] = 1\n            for k in range(n):\n                if mask & (1 << k):\n                    f[i][mask] = (f[i][mask] * a[k][i]) % MOD\n                else:\n                    f[i][mask] = (f[i][mask] * ((MOD + 1 - a[k][i]) % MOD)) % MOD\n    \n    memo = [dict() for _ in range(8)]\n    \n    def dfs(depth, state):\n        if depth == n:\n            return 1 if state == full_mask else 0\n        if state in memo[depth]:\n            return memo[depth][state]\n        \n        result = 0\n        next_states = [Bitset128() for _ in range(n)]\n        \n        for mask in range(1 << n):\n            if state[mask]:\n                for j in range(n):\n                    if not (mask & (1 << j)):\n                        next_states[j].set(mask | (1 << j))\n        \n        for choice in range(1 << n):\n            new_state = Bitset128()\n            new_state.lo = state.lo\n            new_state.hi = state.hi\n            for j in range(n):\n                if choice & (1 << j):\n                    new_state |= next_states[j]\n            result = (result + f[depth][choice] * dfs(depth + 1, new_state)) % MOD\n        \n        memo[depth][state] = result\n        return result\n    \n    print(dfs(0, initial))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019476900342851877, -9.536738616588991e-07, -2.3841855067985307e-07, -0.1927066445350647, -0.00014768941036891192, -0.005238734185695648, -0.007229477632790804, -0.3228769600391388, -1.728519782773219e-05, -0.00013565097469836473, -4.2914423829643056e-05, -4.541770613286644e-05, -0.00012134769349358976, -0.01976684480905533, -1.1920928244535389e-07, -4.768360213347478e-06, 0.0, -1.2993727978027891e-05, -0.000432