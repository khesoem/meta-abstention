ptr);\n    \n    cin >> n >> k >> MOD;\n    \n    if (n % 2 == 1) {\n        cout << mod_pow(k, n) << '\\n';\n        return 0;\n    }\n    \n    fact.resize(n + 1);\n    inv_fact.resize(n + 1);\n    inv_arr.resize(n + 1);\n    \n    fact[0] = inv_fact[0] = fact[1] = inv_fact[1] = inv_arr[1] = 1;\n    \n    for (int i = 2; i <= n; ++i) {\n        fact[i] = 1LL * fact[i-1] * i % MOD;\n        inv_arr[i] = 1LL * (MOD - MOD / i) * inv_arr[MOD % i] % MOD;\n        inv_fact[i] = 1LL * inv_fact[i-1] * inv_arr[i] % MOD;\n    }\n    \n    memo.assign(19, vector<int>(n + 1, -1));\n    int total = mod_pow(k, n);\n    int bad = dp(0, n);\n    int ans = (total - bad + MOD) % MOD;\n    cout << ans << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static int MOD;\n    static int n, k;\n    static int[][] memo;\n    static int[] fact;\n    static int[] inv_fact;\n    static int[] inv_arr;\n\n    static int mod_pow(int b, int e) {\n        long r = 1, base = b;\n        while (e > 0) {\n            if ((e & 1) == 1) {\n                r = (r * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            e >>= 1;\n        }\n        return (int) r;\n    }\n\n    static int dp(int used, int mask) {\n        if (memo[used][mask] != -1) {\n            return memo[used][mask];\n        }\n        \n        if (mask == 0) {\n            long res = fact[n];\n            for (int i = 1; i <= used; ++i) {\n                res = (res * (k - i + 1)) % MOD;\n            }\n            memo[used][mask] = (int) res;\n            return (int) res;\n        }\n        \n        if (used > k) {\n            return 0;\n        }\n        \n        int lb = mask & -mask;\n        int upper = mask - lb;\n        int res = 0;\n        \n        for (int s = upper; ; s = (s - 1) & upper) {\n            int comp = mask - s;\n            res = (int) ((res + (long) inv_fact[comp] * dp(used + 1, s)) % MOD);\n            if (s == 0) break;\n        }\n        \n        memo[used][mask] = res;\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        k = sc.nextInt();\n        MOD = sc.nextInt();\n        \n        if (n % 2 == 1) {\n            System.out.println(mod_pow(k, n));\n            return;\n        }\n        \n        fact = new int[n + 1];\n        inv_fact = new int[n + 1];\n        inv_arr = new int[n + 1];\n        \n        fact[0] = inv_fact[0] = fact[1] = inv_fact[1] = inv_arr[1] = 1;\n        \n        for (int i = 2; i <= n; ++i) {\n            fact[i] = (int) ((long) fact[i-1] * i % MOD);\n            inv_arr[i] = (int) ((long) (MOD - MOD / i) * inv_arr[MOD % i] % MOD);\n            inv_fact[i] = (int) ((long) inv_fact[i-1] * inv_arr[i] % MOD);\n        }\n        \n        memo = new int[19][n + 1];\n        for (int i = 0; i < 19; ++i) {\n            for (int j = 0; j <= n; ++j) {\n                memo[i][j] = -1;\n            }\n        }\n        \n        int total = mod_pow(k, n);\n        int bad = dp(0, n);\n        int ans = (total - bad + MOD) % MOD;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021109737281221896, -1.7881377516459906e-06, -3.576278118089249e-07, -0.0013625870924443007, -3.266281055402942e-05, -0.020577402785420418, -0.3874180316925049, -4.5536911784438416e-05, -8.344646857949556e-07, -3.85038583772257e-05, -0.006716651376336813, -7.497983460780233e-05, -0.029808619990944862, -5.435795901576057e-05, -2.7418097943154862e-06, -0.002188075101003051, -0.002477435627952218, -1.1920922133867862e-06, -0.00034374051028862596, -0.00014399446081370115, -8.582700684200972e-05, -1.0728830375228426e-06, -0.00012468514614738524, -2.253030106658116e