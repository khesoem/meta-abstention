        xx = x + dx[o]\n            yy = y + dy[o]\n            if In(xx, yy) and d[xx][yy] == 10**9 and capsule[xx][yy] != 'Y':\n                if Z[xx][yy] > d[x][y] + 1 or (Z[xx][yy] == d[x][y] + 1 and isdigit(capsule[xx][yy])):\n                    d[xx][yy] = d[x][y] + 1\n                    if f and isdigit(capsule[xx][yy]):\n                        F.add(sx * n + sy, xx * n + yy + n * n, 10**9)\n                    if Z[xx][yy] > d[x][y] + 1 or not f:\n                        q.append(xx)\n                        q.append(yy)\n\ndef main():\n    global n, t, field, capsule, Z, S, F\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    src = n * n * 2\n    sink = src + 1\n    F = Flow(210)\n    F.init()\n    field = [list(next(it)) for _ in range(n)]\n    x = y = 0\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                x, y = i, j\n    capsule = [list(next(it)) for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            if isdigit(capsule[i][j]):\n                F.add(i * n + j + n * n, sink, ord(capsule[i][j]) - ord('0'))\n    Z = [[0]*n for _ in range(n)]\n    S = [[0]*n for _ in range(n)]\n    bfs(x, y, Z, False)\n    for i in range(n):\n        for j in range(n):\n            if isdigit(field[i][j]):\n                F.add(src, i * n + j, ord(field[i][j]) - ord('0'))\n                bfs(i, j, S, True)\n    print(F.dinic(src, sink))\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-1.1920928244535389e-07, -0.00011181206355104223, -0.00014768941036891192, -2.3841855067985307e-07, -2.0265558760002023e-06, -0.0014192519010975957, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.02980850450694561, -0.33854857087135315, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.0011654258705675602, -0.1269301474094391, -0.030559515580534935,