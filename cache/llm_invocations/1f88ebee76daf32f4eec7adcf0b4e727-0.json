n(), base2.end());\n    \n    do {\n        perms1.push_back(base1);\n    } while (next_permutation(base1.begin(), base1.end()));\n    \n    do {\n        perms2.push_back(base2);\n    } while (next_permutation(base2.begin(), base2.end()));\n    \n    int min_score = INT_MAX;\n    for (auto& p1 : perms1) {\n        for (auto& p2 : perms2) {\n            vector<vector<int>> arr1 = p1;\n            vector<vector<int>> arr2 = p2;\n            min_score = min(min_score, battle(arr1, arr2));\n        }\n    }\n    return min_score;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n = inp_int();\n    vector<int> list1 = inp_list();\n    vector<int> list2 = inp_list();\n    \n    int r1 = list1[0], s1 = list1[1], p1 = list1[2];\n    int r2 = list2[0], s2 = list2[1], p2 = list2[2];\n    \n    cout << worst_case(r1, s1, p1, r2, s2, p2) << \" \" << best_case(r1, s1, p1, r2, s2, p2) << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001931004080688581, -2.145764938177308e-06, -5.960462772236497e-07, -5.364403477869928e-06, -2.3841855067985307e-07, -0.12726640701293945, -9.536738616588991e-07, -1.0728830375228426e-06, -7.152555099310121e-07, -0.00028832571115344763, -3.576278118089249e-07, -1.7165990357170813e-05, -7.152555099310121e-07, -0.01866140589118004, -2.3841855067985307e-07, -4.291525328881107e-06, -1.1920928244535389e-07, -0.512835681438446, -0.00011407678539399058, -0.020542601123452187, -0.0011712603736668825, -1.311301275563892e-06, -0.036369118839502335, -0.14267602562904358, -0.12695157527923584, -1.0728830375228426e-06, -0.49997979402542114, -0.0007751559023745358, -0.01815124973654747, -0.014165329746901989, -2.145764938177308e-06, -0.45337072014808655, -0.1604224294424057, -0.0380464643239975, -5.245195097813848e-06, -0.44006508588790894, -0.6326128244400024, -0.38696038722991943, -1.3708974620385561e-05, -0.11619847267866135, -0.0017076447838917375, -0