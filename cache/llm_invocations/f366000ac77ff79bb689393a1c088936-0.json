ush_back(num / d);\n            }\n        }\n        d++;\n    }\n    sort(divs.begin(), divs.end());\n    return divs;\n}\n\nlong long mod_pow(long long base, long long exp, long long mod) {\n    long long result = 1;\n    base = base % mod;\n    while (exp > 0) {\n        if (exp & 1) {\n            result = (result * base) % mod;\n        }\n        exp = exp >> 1;\n        base = (base * base) % mod;\n    }\n    return result;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    int space_pos = line.find(' ');\n    long long p = stoll(line.substr(0, space_pos));\n    long long k = stoll(line.substr(space_pos + 1));\n    \n    long long MOD = 1000000007;\n    \n    if (k == 0) {\n        cout << mod_pow(p, p - 1, MOD) << endl;\n    } else if (k == 1) {\n        cout << mod_pow(p, p, MOD) << endl;\n    } else {\n        vector<long long> divisors = find_divisors(p - 1);\n        for (long long z : divisors) {\n            if ((p - 1) % z == 0 && mod_pow(k, z, p) == 1) {\n                cout << mod_pow(p, (p - 1) / z, MOD) << endl;\n                break;\n            }\n        }\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021217002358753234, -1.311301275563892e-06, -1.1920928244535389e-07, -1.07287787614041e-05, -3.576278118089249e-07, -8.511180931236595e-05, -7.152555099310121e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -2.4437606043647975e-05, -2.3841855067985307e-07, -5.960462772236497e-07, -2.3841855067985307e-07, -0.04311889037489891, -2.753696753643453e-05, -0.007607536390423775, -9.417489309271332e-06, -0.0001908358681248501, -0.6326084733009338, -0.1798030138015747, -1.7404405298293568e-05, -7.271740287251305e-06, -1.311301275563892e-06, -0.28673267364501953, -0.04859402775764465, -1.0490362910786644e-05, -4.768370445162873e-07, -3.2186455882765586e-06, -5.757642793469131e-05, -2.622600959512056e-06, -6.9141146923357155e-06, -9.536738616588991e-07, -1.31130127556