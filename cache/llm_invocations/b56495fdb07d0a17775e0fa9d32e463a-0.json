{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\n\nclass Solver {\npublic:\n    int n, kk, P;\n    vector<ll> fact, invFact;\n    vector<vector<ll>> memo;\n\n    ll modPow(ll a, ll b) {\n        ll ret = 1;\n        while (b) {\n            if (b & 1) ret = ret * a % P;\n            a = a * a % P;\n            b >>= 1;\n        }\n        return ret;\n    }\n\n    int lowbit(int x) const {\n        return x & -x;\n    }\n\n    ll dfs(int cur, int mask) {\n        ll &res = memo[cur][mask];\n        if (res != -1) return res;\n\n        if (mask == 0) {\n            res = fact[n];\n            for (int i = 1; i <= cur; ++i)\n                res = res * (kk - i + 1) % P;\n            return res;\n        }\n\n        int rest = mask - lowbit(mask);\n        res = 0;\n        for (int sub = rest; sub > 0; sub = (sub - 1) & rest)\n            res = (res + invFact[mask - sub] * dfs(cur + 1, sub)) % P;\n        res = (res + invFact[mask] * dfs(cur + 1, 0)) % P;\n        return res;\n    }\n\n    void solve() {\n        ios::sync_with_stdio(false);\n        cin.tie(nullptr);\n\n        cin >> n >> kk >> P;\n        ll ans = modPow(kk, n);\n\n        if (n & 1) {\n            cout << ans << '\\n';\n            return;\n        }\n\n        fact.assign(n + 1, 1);\n        for (int i = 1; i <= n; ++i)\n            fact[i] = fact[i - 1] * i % P;\n\n        invFact.assign(n + 1, 1);\n        invFact[n] = modPow(fact[n], P - 2);\n        for (int i = n; i > 0; --i)\n            invFact[i - 1] = invFact[i] * i % P;\n\n        memo.assign(26, vector<ll>(n + 1, -1));\n\n        ans = (ans - dfs(0, n) + P) % P;\n        cout << ans << '\\n';\n    }\n};\n\nint main() {\n    Solver solver;\n    solver.solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nclass Solver:\n    def __init__(self):\n        self.n = 0\n        self.kk = 0\n        self.P = 0\n        self.fact = []\n        self.invFact = []\n        self.memo = []\n\n    def modPow(self, a, b):\n        return pow(a, b, self.P)\n\n    def lowbit(self, x):\n        return x & -x\n\n    def dfs(self, cur, mask):\n        res = self.memo[cur][mask]\n        if res != -1:\n            return res\n\n        if mask == 0:\n            res = self.fact[self.n]\n            for i in range(1, cur + 1):\n                res = res * (self.kk - i + 1) % self.P\n            self.memo[cur][mask] = res\n            return res\n\n        rest = mask - self.lowbit(mask)\n        res = 0\n        sub = rest\n        while sub > 0:\n            res = (res + self.invFact[mask - sub] * self.dfs(cur + 1, sub)) % self.P\n            sub = (sub - 1) & rest\n        res = (res + self.invFact[mask] * self.dfs(cur + 1, 0)) % self.P\n        self.memo[cur][mask] = res\n        return res\n\n    def solve(self):\n        data = sys.stdin.read().strip().split()\n        if not data:\n            return\n        self.n = int(data[0])\n        self.kk = int(data[1])