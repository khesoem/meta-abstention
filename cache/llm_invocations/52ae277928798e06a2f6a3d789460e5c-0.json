{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<queue>\n#define N 100010\nusing namespace std;\ntypedef int typ;\n#define M 1000010\n#define inf 1000000000\n#define winf 1000000000\nstruct road{\n    int nxt,to,f;\n    typ w;\n}r[M<<1];\nint head[N],cnt=1,all;\nvoid add(int u,int v,int f,typ w)\n{\n    r[++cnt]=(road){head[u],v,f,w};head[u]=cnt;\n    r[++cnt]=(road){head[v],u,0,-w};head[v]=cnt;\n}\nnamespace min_cost_flow{\n    int cur[N];\n    bool vis[N];\n    struct node{\n        int u;typ v;\n        node(int U=0,typ V=0):u(U),v(V){}\n        bool operator <(const node a)const{return v>a.v;}\n    };\n    priority_queue<node>q;\n    typ dis[N],tag[N];\n    bool dij(int s,int t)\n    {\n        for(int i=1;i<=all;i++) dis[i]=winf,cur[i]=head[i];\n        dis[t]=0;q.push(node(t,0));\n        while(!q.empty())\n        {\n            int u=q.top().u;q.pop();\n            if(vis[u]) continue;\n            vis[u]=true;\n            for(int i=head[u];i;i=r[i].nxt)\n            {\n                int v=r[i].to,w=tag[u]+r[i^1].w-tag[v];\n                if(r[i^1].f && dis[u]+w<dis[v]) dis[v]=dis[u]+w,q.push(node(v,dis[v]));\n            }\n        }\n        for(int i=1;i<=all;i++) tag[i]=min(tag[i]+dis[i],winf);\n        if(!vis[s]) return false;\n        for(int i=1;i<=all;i++) vis[i]=false;\n        return true;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && tag[v]+r[i].w==tag[u] && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(dij(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*tag[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\n# Constants (will be adjusted based on input)\nN = 100010  # maximum nodes, but we'll compute dynamically\nM = 1000010\nINF = 1000000000\nWINF = 1000000000\n\nclass Edge:\n    __slots__ = ('nxt', 'to', 'f', 'w')\n    def __init__(self, nxt, to, f, w):\n        self.nxt = nxt\n        self.to = to\n        self.f = f\n        self.w = w\n\n# Global graph structures\nhead = [0]  # 1-indexed, head[0] unused\nr = [None]  # 1-indexed, r[0] unused\ncnt = 1\nall_nodes = 0\n\ndef add(u, v, f, w):\n    global cnt, head, r\n    # forward edge\n    r.append(Edge(head[u], v, f, w))\n    head[u] = cnt\n    cnt += 1\n    # reverse edge\n    r.append(Edge(head[v], u, 0, -w))\n    head[v] = cnt\n    cnt += 1\n\n# Min-cost flow functions\ndef dij(s, t, cur, vis, dis, tag):\n    # Dijkstra with potentials\n    for i in range(1, all_nodes+1):\n        dis[i] = WINF\n        cur[i] = head[i]\n        vis[i] = False\n    dis[t] = 0\n    pq = [(0, t)]\n    while pq:\n        d, u = heapq.heappop(pq)\n        if vis[u]:\n            continue\n        vis[u] = True\n        i = head[u]\n        while i:\n            e = r[i]\n            v = e.to\n            w = tag[u] + r[i^1].w - tag[v]  # note: i^1 is reverse edge\n            if r[i^1].f and dis[u] + w < dis[v]:\n                dis[v] = dis[u] + w\n                heapq.heappush(pq, (dis[v], v))\n            i = e.nxt\n    for i in range(1, all_nodes+1):\n        tag[i] = min(tag[i] + dis[i], WINF)\n    if not vis[s]:\n        return False\n    for i in range(1, all_nodes+1):\n        vis[i] = False\n    return True\n\ndef dfs(u, t, fl, cur, vis, tag):\n    if u == t or fl == 0:\n        return fl\n    res = 0\n    vis[u] = True\n    i = cur[u]\n    while i:\n        e = r[i]\n        v = e.to\n        if e.f and not vis[v] and tag[v] + e.w == tag[u]:\n            f = dfs(v, t, min(fl, e.f), cur, vis, tag)\n            if f:\n                e.f -= f\n                r[i^1].f += f\n                res += f\n                fl -= f\n                if fl == 0:\n                    break\n        i = e.nxt\n        cur[u] = i\n    vis[u] = False\n    return res\n\ndef min_cost_flow(s, t):\n    global all_nodes\n    maxf = 0\n    minw = 0\n    # allocate arrays for current node count\n    cur = [0] * (all_nodes + 1)\n    vis = [False] * (all_nodes + 1)\n    dis = [0] * (all_nodes + 1)\n    tag = [0] * (all_nodes + 1)\n    while dij(s, t, cur, vis, dis, tag):\n        w = dfs(s, t, INF, cur, vis, tag)\n        maxf += w\n        minw += w * tag[s]\n    return minw\n\ndef id_func(t, x):\n    return t * n + x + 2\n\ndef work(t, n, k, c, d, g):\n    global all_nodes, head, r, cnt\n    all_nodes += n\n    # ensure head array is large enough\n    while len(head) <= all_nodes:\n        head.append(0)\n    for u in range(1, n+1):\n        for v in g[u]:\n            for p in range(1, k+1):\n                add(id_func(t, u), id_func(t+1, v), 1, d * (2*p - 1))\n    for u in range(1, n+1):\n        add(id_func(t, u), id_func(t+1, u), INF, 0)\n    add(id_func(t+1, 1), 2, INF, c * (t+1))\n\ndef main():\n    global all_nodes, head, r, cnt, n, m, k, c, d\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    # compute maximum nodes needed\n    max_nodes = n + 2 + (n + k + 1) * n  # source, sink, plus time layers\n    # initialize head and r with enough capacity\n    global head, r, cnt, all_nodes\n    head = [0] * (max_nodes + 1)\n    r = [None] * (2 * (max_nodes + 1) + 5)  # rough estimate, will extend as needed\n    cnt = 1\n    all_nodes = n + 2  # source=1, sink=2, time0 nodes: 3..n+2\n    \n    # adjacency list for original graph\n    g = [[] for _ in range(n+1)]\n    \n    # source edges\n    for _ in range(k):\n        a = int(next(it))\n        add(1, id_func(0, a), 1, 0)\n    \n    # read edges\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        g[u].append(v)\n        g[v].append(u)\n    \n    # edge from time0 node1 to sink\n    add(id_func(0, 1), 2, INF, 0)\n    \n    # build time-expanded graph\n    for t in range(0, n + k + 1):\n        work(t, n, k, c, d, g)\n    \n    # run min-cost flow\n    result = min_cost_flow(1, 2)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.556489552167477e-06, 0.0, 0.0, -0.00016556799528189003, -0.0011980506824329495, -6.198863957251888e-06, -0.002476959954947233, -0.0001102625101339072, -2.932505594799295e-05, -0.07889283448457718, -0.08949367702007294, -0.18908526003360748, -0.5373519659042358, -0.5500317215919495, -0.0017698828596621752, -0.6958370804786682, -0.16261228919029236, -3.576278118089249e-07, -8.475421054754406e-05, -0.0022691949270665646, -0.13922451436519623, -0.0030891813803464174, -3.635817120084539e-05, -0.0067752632312476635, -3.6954811548639555e-06, -0.3155434727668762, 0.0, -1.253097414970398, -0.580117404460907, -0.26044294238090515, -1.1566990613937378, -0.00429172907024622, -0.6180331707000732, -0.10379550606012344, -0.9597976207733154, -0.06297966837882996, -0.13650210201740265, -2.0265373677830212e-05, -4.768370445162873e-07, -0.0009309487068094313, -1.2397689715726301e-05, -5.960462772236497e-07, -0.6010587811470032, -0.4741065204143524, -1.4662635294371285e-05, -7.033323527139146e-06, -0.006750516593456268, -5.960462772236497e-07, -2.3841830625315197e-06, -7.152555099310121e-07, -4.8397800128441304e-05, -0.20179297029972076, -0.10244687646627426, -1.1920928244535389e-07, -1.9073304429184645e-05, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.00024148885859176517, -0.162088543176651, -3.397406908334233e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, 0.0, -1.9073468138230965e-06, -1.1920922133867862e-06, -1.5258672647178173e-05, -2.3603161025675945e-05, 0.0, -0.018149960786104202, 0.0, 0.0, -3.576278118089249e-07, -9.53673