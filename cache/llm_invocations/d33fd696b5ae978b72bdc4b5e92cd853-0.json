)\n                        inq[e.to] = 1\n\n        if d[t] == INF:\n            return False, flow, cost\n\n        flow += a[t]\n        cost += d[t] * a[t]\n        u = t\n        while u != s:\n            e_idx = p[u]\n            self.edges[e_idx].flow += a[t]\n            self.edges[e_idx ^ 1].flow -= a[t]\n            u = self.edges[e_idx].fr\n\n        return True, flow, cost\n\n    def min_cost(self, s, t):\n        flow = 0\n        cost = 0\n        while True:\n            ok, flow, cost = self.bellman(s, t, flow, cost)\n            if not ok:\n                break\n        return cost\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n\n    a = [0] * (k+1)\n    for i in range(1, k+1):\n        a[i] = next(it)\n\n    start_point = 0\n    end_point = n * 100 + 1\n\n    solver = MCMF(end_point)\n\n    # add edges from start to initial positions\n    for i in range(1, k+1):\n        solver.add_edge(start_point, 1 + (a[i]-1)*100, 1, 0)\n\n    # waiting edges (time flow)\n    for i in range(1, n+1):\n        for j in range(1, 100):\n            p = (i-1)*100\n            solver.add_edge(p + j, p + j + 1, INF, c)\n\n    # edges from each time 100 to sink\n    for i in range(1, 101):\n        solver.add_edge(i, end_point, INF, 0)\n\n    # movement edges\n    for _ in range(m):\n        x = next(it); y = next(it)\n        # x -> y\n        for i in range(1, 100):\n            p = (x-1)*100 + i\n            pp = (y-1)*100 + i + 1\n            for j in range(1, 51):\n                cost_val = d * (j*j - (j-1)*(j-1)) + c\n                solver.add_edge(p, pp, 1, cost_val)\n        # y -> x\n        for i in range(1, 100):\n            p = (y-1)*100 + i\n            pp = (x-1)*100 + i + 1\n            for j in range(1, 51):\n                cost_val = d * (j*j - (j-1)*(j-1)) + c\n                solver.add_edge(p, pp, 1, cost_val)\n\n    result = solver.min_cost(start_point, end_point)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.2397689715726301e-05, -2.3841855067985307e-07, 0.0, -0.00017772526189219207, -0.0009348789462819695, -4.768370445162873e-07, -0.008667231537401676, -0.007530279457569122, -1.6093124941107817e-05, -4.768370445162873e-07, -0.00020585325546562672, -0.00718687055632472, -0.08185729384422302, -0.014356536790728569, -2.4318398573086597e-05, -3.0278701160568744e-05, -0.038041986525058746, -0.007271017879247665, -0.10686168819665909, -0.10214275121688843, -0.4742109775543213, -1.7881377516459906e-06, -1.1920922133867862e-06, -0.5759598016738892, -2.145764938177308e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -1.5497195136049413e-06, -0.8443266153335571, -9.643566590966657e-05, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -0.06206610053777695, -0.0002037079248111695, -1.1920928244535389e-07, -3.6954811548639555e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.005496389232575893, -2.3841830625315197e-06, 0.0, -6.97350042173639e-05, 0.0, 0.0, 0.0, -3.576278118089249e-07, 0.0, -5.960462772236497e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.537788011773955e-05, 0.0, 0.0, -5.483612312673358e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.483612312673358e-06, -9.536738616588991e-07, 0.0, 0.0, -1.311301275563892e-06, -2.1457441107486375e-05, 0.0, -1.1920928244535389e-07, -0.00031287543242797256, -3.6238969187252223e-05, -2.8132995794294402e-05, -1.7881377516459906e-06, -1.4305104514278355e-06, -1.6689286894688848e-06, 0.0, -2.3841855067985307e-07, -0.000565249880310148, 0.0, -3.576278118089249e-07, 0.0, -0.25193366408348083, -0.0002696150622796267, -7.712543447269127e-05, 0.0, -1.1920928244535389e-07, -0.00020346954988781363, -9.536738616588991e-07, -2.3841855067985307e-07, -0.000126353