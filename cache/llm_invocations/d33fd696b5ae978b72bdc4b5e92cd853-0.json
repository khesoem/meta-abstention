h_back(m-2);\n        g[to].push_back(m-1);\n    }\n    bool bellman(int s,int t,int& flow,int& cost)\n    {\n        for(int i = 0;i <= t; i++)\n            d[i] = inf,inq[i] = 0;\n        d[s] = 0;inq[s] = 1;p[s] = 0;a[s] = inf;\n        queue<int>Q;\n        Q.push(s);\n        while(!Q.empty())\n        {\n            int u = Q.front();\n\n            Q.pop();\n            inq[u] = 0;\n\n            for(int i = 0;i < g[u].size(); i++)\n            {\n                edge& ee = e[g[u][i]];\n\n                if(ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost)\n                {\n                    d[ee.to] = d[u] + ee.cost;\n                    p[ee.to] = g[u][i];\n                    a[ee.to] = min(a[u],ee.cap - ee.flow);\n                    if(!inq[ee.to])\n                    {\n                        Q.push(ee.to);\n                        inq[ee.to] = 1;\n                    }\n                }\n            }\n        }\n\n        if(d[t] == inf)\n            return false;\n        flow += a[t];\n        cost += d[t] * a[t];\n        int u = t;\n        while(u != s){\n            e[p[u]].flow += a[t];\n            e[p[u]^1].flow -= a[t];\n            u = e[p[u]].from;\n        }\n\n        return true;\n    }\n    int minCost(int s,int t)\n    {\n        int flow = 0,cost = 0;\n        while(bellman(s,t,flow,cost));\n        return cost;\n    }\n}solve;\n\nint main(){\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cout.tie(0);\n    int k,c,d;\n    cin>>n>>m>>k>>c>>d;\n\n    for(int i=1;i<=k;i++){\n        cin>>a[i];\n    }\n\n    startPoint=0,endPoint=n*100+1;\n\n    for(int i=1;i<=k;i++){\n        solve.add(startPoint,1+(a[i]-1)*100,1,0);\n    }\n\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<100;j++){\n            int p=(i-1)*100LL;\n            solve.add(p+j,p+j+1,inf,c);\n        }\n    }\n\n    for(int i=1;i<=100;i++)solve.add(i,endPoint,inf,0);\n\n    while(m--){\n        int x,y;\n        cin>>x>>y;\n        for(int i=1;i<100;i++