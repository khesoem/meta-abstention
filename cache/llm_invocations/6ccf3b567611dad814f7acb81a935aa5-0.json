ormalize1(counter - current * pow10);\n                i64 pos = lower_bound(bucket[i].begin(), bucket[i].end(), MOD1 - target) - bucket[i].begin();\n                result = (result + target * (i64)bucket[i].size() + bucket_sum[i] - MOD1 * (i64)(bucket[i].size() - pos)) % MOD2;\n            }\n            counter += temp_counter;\n            return;\n        }\n        ++counter;\n        result = (result + normalize1(counter - current)) % MOD2;\n    }\n    \n    for (i64 d = (level == 0 ? 1 : 0); d < 10; ++d) {\n        traverse_second(level + 1, current * 10 + d);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N;\n    \n    traverse_first(0, 0);\n    temp_counter = counter;\n    counter = 0;\n    \n    for (int i = 0; i <= 6; ++i) {\n        sort(bucket[i].begin(), bucket[i].end());\n    }\n    \n    traverse_second(0, 0);\n    result %= MOD2;\n    if (result < 0) result += MOD2;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long MOD1 = 998244353L;\n    static long MOD2 = 1000000007L;\n    static long THRESHOLD = 1000000L;\n    \n    static long N;\n    static long counter = 0;\n    static long temp_counter = 0;\n    static long result = 0;\n    static List<Long>[] bucket = new List[7];\n    static long[] bucket_sum = new long[7];\n    \n    static long normalize1(long x) {\n        x %= MOD1;\n        if (x < 0) x += MOD1;\n        return x;\n    }\n    \n    static void traverse_first(int level, long current) {\n        if (current > N) return;\n        if (level > 6) return;\n        \n        ++counter;\n        long adjusted = normalize1(counter - current);\n        bucket[level].add(adjusted);\n        bucket_sum[level] = (bucket_sum[level] + adjusted) % MOD1;\n 