.println(ans);\n        pw.close();\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998244353L;\n        private long[] fact, invFact;\n        \n        public void setup(int maxN) {\n            fact = new long[maxN];\n            invFact = new long[maxN];\n            \n            fact[0] = 1;\n            for (int i = 1; i < maxN; i++) {\n                fact[i] = fact[i - 1] * i % MOD;\n            }\n            \n            invFact[maxN - 1] = pow(fact[maxN - 1], MOD - 2);\n            for (int i = maxN - 2; i >= 0; i--) {\n                invFact[i] = invFact[i + 1] * (i + 1) % MOD;\n            }\n        }\n        \n        public long C(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n        }\n        \n        public long inv(int x) {\n            return pow(x, MOD - 2);\n        }\n        \n        public long pow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = res * base % MOD;\n                base = base * base % MOD;\n                exp >>= 1;\n            }\n            return res;\n        }\n        \n        public long add(long a, long b) {\n            return (a += b) >= MOD ? a - MOD : a;\n        }\n        \n        public long sub(long a, long b) {\n            return (a -= b) < 0 ? a + MOD : a;\n        }\n        \n        public long mul(long a, long b) {\n            return a * b % MOD;\n        }\n    }\n\n    static class FastScanner {\n        private final BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        private StringTokenizer st;\n\n        public String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nMOD = 998244353\n\ndef mod_pow(base, exp, mod):\n    result = 1\n    base %= mod\n    while exp > 0:\n        if (exp & 1) == 1:\n            result = (result * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return result\n\ndef mod_inv(x, mod):\n    return mod_pow(x, mod - 2, mod)\n\nclass Mod998:\n    def __init__(self):\n        self.fact = None\n        self.invFact = None\n    \n    def setup(self, maxN):\n        self.fact = [1] * maxN\n        self.invFact = [1] * maxN\n        \n        for i in range(1, maxN):\n            self.fact[i] = (self.fact[i-1] * i) % MOD\n        \n        self.invFact[maxN-1] = mod_pow(self.fact[maxN-1], MOD-2, MOD)\n        for i in range(maxN-2, -1, -1):\n            self.invFact[i] = (self.invFact[i+1] * (i+1)) % MOD\n    \n    def C(self, n, r):\n        if r < 0 or r > n:\n            return 0\n        return (self.fact[n] * self.invFact[r] % MOD) * self.invFact[n-r] % MOD\n    \n    def inv(self, x):\n        return mod_inv(x, MOD)\n    \n    def add(self, a, b):\n        a += b\n        return a - MOD if a >= MOD else a\n    \n    def sub(self, a, b):\n        a -= b\n        return a + MOD if a < 0 else a\n    \n    def mul(self, a, b):\n        return (a * b) % MOD\n\ndef main():\n    input_data = sys.stdin.read().split()\n    sc_index = 0\n    \n    def next_int():\n        nonlocal sc_index\n        val = int(input_data[sc_index])\n        sc_index += 1\n        return val\n    \n    n = next_int()\n    m = next_int()\n    \n    mod = Mod998()\n    mod.setup(n + m + 10)\n    \n    phaseSize = 1\n    p = 1\n    i = 0\n    while p != 0:\n        p = mod.mul(p, mod.mul(n - i, mod.inv(n + m - i)))\n        phaseSize = mod.add(phaseSize, p)\n        i += 1\n    \n    ans = 0\n    for k in range(1, n + 1):\n        numPhases = mod.mul(m + k, mod.inv(k))\n        e = mod.mul(numPhases, phaseSize)\n        term = mod.mul(mod.C(n, k), e)\n        \n        if k % 2 == 1:\n            ans = mod.add(ans, term)\n        else:\n            ans = mod.sub(ans, term)\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.1020273531321436e-05, -1.1920922133867862e-06, -5.960462772236497e-07, -0.007857367396354675, -0.0006790239713154733, -0.14276573061943054, -0.08132058382034302, -0.013892264105379581, -0.001506028464064002, -0.538810670375824, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -1.311301275563892e-06, -0.0028708456084132195, -1.0609570381348021e-05, -5.960462772236497e-07, -1.5735502529423684e-05, -0.22553308308124542, -0.07195901870727539, -0.17926228046417236, -5.8412379075889476e-06, 0.0, -2.396077979938127e-05, -0.04859822988510132, -9.524368942948058e-05, -0.0012523435289040208, -2.0265558760002023e-06, -0.2970886528491974, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -5.960462772236497e-07, -8.344646857949556e-07, -0.018168339505791664, -1.1920922133867862e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.311301275563892e-06, -1.2755313036905136e-05, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -0.22544345259666443, -1.0728830375228426e-06, -3.576278118089249e-07, 0.0, 0.0, -5.960462772236497e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.4305104514278355e-06, -3.576278118089249e-07, 0.0, -0.0002308817347511649, -4.768370445162873e-07, 