{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ull = unsigned long long;\nconst ull INF = 1ULL << 63;\n\null mod, n, k;\null dp[19][300005];\null fac[300005], inv[300005];\n\ninline ull qpow(ull a, ull b) {\n    ull res = 1, tp = a;\n    while (b) {\n        if (b & 1) {\n            res = (res * tp) % mod;\n        }\n        tp = (tp * tp) % mod;\n        b >>= 1;\n    }\n    return res;\n}\n\ninline ull comb(int a, int b) {\n    return (((fac[a] * inv[b]) % mod) * inv[a - b]) % mod;\n}\n\ninline ull calc() {\n    int i, j, l;\n    fac[0] = 1;\n    ull ti = max(n, k);\n    for (i = 1; i <= ti; ++i) {\n        fac[i] = (fac[i - 1] * static_cast<ull>(i)) % mod;\n    }\n    inv[ti] = qpow(fac[ti], mod - 2);\n    for (i = ti - 1; i >= 0; --i) {\n        inv[i] = (inv[i + 1] * static_cast<ull>(i + 1)) % mod;\n    }\n    for (i = 1; i <= n; ++i) {\n        dp[1][i] = inv[i];\n    }\n    ull ans = (dp[1][n] * comb(k, 1)) % mod;\n    int t = min(18, static_cast<int>(k));\n    for (i = 2; i <= t; ++i) {\n        for (j = n; j; j = (j - 1) & n) {\n            if (!dp[i - 1][j]) continue;\n            ull r = n ^ j;\n            for (l = r; l > j; l = (l - 1) & r) {\n                dp[i][j ^ l] += dp[i - 1][j] * inv[l];\n                if (dp[i][j ^ l] > INF) dp[i][j ^ l] %= mod;\n            }\n        }\n        for (j = n; j; j = (j - 1) & n) {\n            if (dp[i][j] >= mod) dp[i][j] %= mod;\n        }\n        ull res = dp[i][n] * comb(k, i);\n        res %= mod;\n        res = (res * fac[i]) % mod;\n        ans += res;\n        if (ans >= mod) ans -= mod;\n    }\n    ans = (ans * fac[n]) % mod;\n    return ans;\n}\n\nint main() {\n    cin >> n >> k >> mod;\n    ull ans = qpow(k, n);\n    if (n % 2 == 0) {\n        ans = (ans - calc() + mod) % mod;\n    }\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef qpow(a, b, mod):\n    res = 1\n    tp = a % mod\n    while b:\n        if b & 1:\n            res = (res * tp) % mod\n        tp = (tp * tp) % mod\n        b >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n    \n    INF = 1 << 63\n    \n    # Precompute factorials and inverse factorials\n    fac = [1] * (max(n, k) + 1)\n    for i in range(1, len(fac)):\n        fac[i] = (fac[i-1] * i) % mod\n    \n    inv = [1] * (len(fac))\n    inv[-1] = qpow(fac[-1], mod - 2, mod)\n    for i in range(len(fac) - 2, -1, -1):\n        inv[i] = (inv[i+1] * (i+1)) % mod\n    \n    # dp[i][j] for i in 1..min(18, k) and j up to n\n    max_dp_rows = min(18, k) + 1\n    dp = [[0] * (n + 1) for _ in range(max_dp_rows + 1)]\n    \n    # Initialize dp[1][i]\n    for i in range(1, n + 1):\n        dp[1][i] = inv[i]\n    \n    # comb function: C(a, b)\n    def comb(a, b):\n        if b < 0 or b > a:\n            return 0\n        return (fac[a] * inv[b] % mod) * inv[a - b] % mod\n    \n    ans = qpow(k, n, mod)\n    \n    # Calculate calc() part\n    t = min(18, k)\n    if t >= 1:\n        res_val = (dp[1][n] * comb(k, 1)) % mod\n        ans = (ans - res_val + mod) % mod\n    \n    for i in range(2, t + 1):\n        # Iterate over all submasks of n\n        j = n\n        while j > 0:\n            if dp[i-1][j] == 0:\n                j = (j - 1) & n\n                continue\n            r = n ^ j\n            l = r\n            while l > j:\n                new_state = j ^ l\n                dp[i][new_state] += dp[i-1][j] * inv[l]\n                if dp[i][new_state] > INF:\n                    dp[i][new_state] %= mod\n                l = (l - 1) & r\n            j = (j - 1) & n\n        \n        # Normalize dp[i][j] modulo mod\n        for j in range(n + 1):\n            if dp[i][j] >= mod:\n                dp[i][j] %= mod\n        \n        res_val = dp[i][n] * comb(k, i) % mod\n        res_val = res_val * fac[i] % mod\n        ans = (ans + res_val) % mod\n    \n    ans = ans * fac[n] % mod\n    \n    # If n is even, subtract calc() result from k^n\n    if n % 2 == 0:\n        # We already subtracted in the loop above, so no additional action needed\n        pass\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-0.0002240883477497846, -3.576278118089249e-07, -4.768370445162873e-07, -0.1804119348526001, -7.70062324590981e-05, -0.0015712546883150935, -0.004654525779187679, -0.39166951179504395, -2.455681169521995e-05, -8.344646857949556e-07, -2.4318398573086597e-05, -1.1920928244535389e-07, -0.005938860587775707, -2.5987286790041253e-05, -0.00011336160969221964, -7.152555099310121e-07, -2.7418097943154862e-06, -1.1920928244535389e-07, 0.0, 0.0, -4.768360213347478e-06, -1.1920928244535389e-07, -2.3841830625315197e-06, -4.768370445162873e-07, -4.768370445162873e-07, -0.011050218716263771, -7.271740287251305e-06, -0.012510159984230995, -1.51394