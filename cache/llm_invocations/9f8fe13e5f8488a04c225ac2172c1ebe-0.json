x, zy))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if valid(nx, ny, seen, A, n):\n                dFromZ[nx][ny] = dFromZ[x][y] + 1\n                seen[nx][ny] = True\n                q.append((nx, ny))\n\ndef build_links(sx, sy, node, A, B, n, Tlim, dFromZ, id, tot, graph):\n    seen = [[False]*n for _ in range(n)]\n    dFromCell = [[INF]*n for _ in range(n)]\n    q = deque()\n    seen[sx][sy] = True\n    dFromCell[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if valid(nx, ny, seen, A, n):\n                dFromCell[nx][ny] = dFromCell[x][y] + 1\n                seen[nx][ny] = True\n                if dFromCell[nx][ny] < dFromZ[nx][ny]:\n                    q.append((nx, ny))\n    for i in range(n):\n        for j in range(n):\n            if dFromCell[i][j] <= Tlim and B[i][j] > '0' and B[i][j] <= '9' and dFromCell[i][j] <= dFromZ[i][j]:\n                add_edge(graph, node, id[i][j] + tot, INF)\n\ndef add_edge(graph, u, v, cap):\n    graph[u].append([v, cap, len(graph[v])])\n    graph[v].append([u, 0, len(graph[u]) - 1])\n\ndef bfs_level(graph, S, T, level):\n    for i in range(len(level)):\n        level[i] = -1\n    q = deque()\n    level[S] = 0\n    q.append(S)\n    while q:\n        u = q.popleft()\n        for v, cap, rev in graph[u]:\n            if cap > 0 and level[v] == -1:\n                level[v] = level[u] + 1\n                q.append(v)\n    return level[T] != -1\n\ndef dfs_flow(graph, u, T, flow, level, it):\n    if u == T:\n        return flow\n    for i in range(it[u], len(graph[u])):\n        it[u] = i\n        v, cap, rev = graph[u][i]\n        if cap > 0 and level[v] == level[u] + 1:\n            ret = dfs_flow(graph, v, T, min(flow, cap), level, it)\n            if ret:\n                graph[u][i][1] -= ret\n                graph[v][rev][1] += ret\n                return ret\n    return 0\n\ndef max_flow(graph, S, T):\n    flow = 0\n    level = [-1] * len(graph)\n    it = [0] * len(graph)\n    while bfs_level(graph, S, T, level):\n        it = [0] * len(graph)\n        while True:\n            f = dfs_flow(graph, S, T, INF, level, it)\n            if not f:\n                break\n            flow += f\n        level = [-1] * len(graph)\n    return flow\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    Tlim = int(next(it))\n    A = []\n    for _ in range(n):\n        A.append(next(it))\n    B = []\n    for _ in range(n):\n        B.append(next(it))\n\n    zx = zy = -1\n    for i in range(n):\n        for j in range(n):\n            if A[i][j] == 'Z':\n                zx, zy = i, j\n                break\n        if zx != -1:\n            break\n\n    # assign ids: cell nodes 0..n*n-1, B cell nodes n*n..2*n*n-1, source=2*n*n, sink=2*n*n+1\n    tot = n * n\n    id = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            id[i][j] = i * n + j\n\n    S = 2 * tot\n    T = S + 1\n    graph = [[] for _ in range(2 * tot + 2)]\n\n    dFromZ = [[INF]*n for _ in range(n)]\n    seen = [[False]*n for _ in range(n)]\n    bfs_from_z(zx, zy, A, n, dFromZ, seen)\n\n    for i in range(n):\n        for j in range(n):\n            if A[i][j] > '0' and A[i][j] <= '9':\n                add_edge(graph, S, id[i][j], ord(A[i][j]) - ord('0'))\n                build_links(i, j, id[i][j], A, B, n, Tlim, dFromZ, id, tot, graph)\n\n    for i in range(n):\n        for j in range(n):\n            if B[i][j] > '0' and B[i][j] <= '9':\n                add_edge(graph, id[i][j] + tot, T, ord(B[i][j]) - ord('0'))\n\n    print(max_flow(graph, S, T))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.2305197237292305e-05, 0.0, 