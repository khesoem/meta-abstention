     g[from].push_back({to, (int)g[to].size(), cap, cost});\n        g[to].push_back({from, (int)g[from].size()-1, 0, -cost});\n    }\n\n    ll min_cost_flow(int s, int t, ll &price, int n, bool sparse) {\n        const ll INF = 1e18;\n        fill(pot, pot+n, 0);\n        // Bellman-Ford for initial potentials (if negative costs exist)\n        // but here all costs >=0, so we can skip\n        ll flow = 0;\n        price = 0;\n        while (true) {\n            fill(dist, dist+n, INF);\n            fill(inq, inq+n, false);\n            dist[s] = 0;\n            queue<int> q;\n            q.push(s);\n            inq[s] = true;\n            while (!q.empty()) {\n                int v = q.front(); q.pop();\n                inq[v] = false;\n                for (int i=0; i<(int)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.push(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n            if (dist[t] >= INF) break;\n            for (int v=0; v<n; ++v) pot[v] += dist[v];\n            ll d = INF;\n            for (int v=t; v!=s; v=prevv[v]) {\n                d = min(d, g[prevv[v]][preve[v]].cap);\n            }\n            flow += d;\n            price += d * pot[t];\n            for (int v=t; v!=s; v=prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= d;\n                g[v][e.rev].cap += d;\n            }\n        }\n        return flow;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k 