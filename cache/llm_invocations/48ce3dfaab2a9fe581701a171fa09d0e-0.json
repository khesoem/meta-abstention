[e.to]) {\n                        q.offer(e.to);\n                        in_queue[e.to] = true;\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n\n    static int min_cost_flow(int s, int t) {\n        int flow = 0, cost = 0;\n        while (spfa(s, t)) {\n            int f = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                f = Math.min(f, graph.get(prevv[v]).get(preve[v]).capacity);\n            }\n            flow += f;\n            cost += f * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = graph.get(prevv[v]).get(preve[v]);\n                e.capacity -= f;\n                graph.get(v).get(e.rev).capacity += f;\n            }\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n        \n        cnt = new int[N + 1];\n        for (int i = 0; i < K; ++i) {\n            int x = sc.nextInt();\n            cnt[x]++;\n        }\n\n        node_id = new int[N + 1][K + M + 3];\n        node_count = 2;\n        src = 0;\n        sink = 1;\n        graph = new ArrayList<>();\n        for (int i = 0; i < 2 + N * (K + M + 2); ++i) {\n            graph.add(new ArrayList<>());\n        }\n\n        for (int i = 1; i <= N; ++i) {\n            for (int j = 1; j <= K + M + 2; ++j) {\n                node_id[i][j] = ++node_count;\n                if (i == 1) {\n                    add_edge(node_id[i][j], sink, INF, C * (j - 1));\n                }\n                if (j > 1) {\n                    add_edge(node_id[i][j - 1], node_id[i][j], INF, 0);\n                }\n            }\n            if (cnt[i] > 0) {\n                add_edge(src, node_id[i][1], cnt[i], 0);\n            }\n        }\n\n        for (int i = 0; i < M; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 1; j <= K + M + 1; ++j) {\n                for (int k = 1; k <= 2 * K - 1; k += 2) {\n                    add_edge(node_id[a][j], node_id[b][j + 1], 1, k * D);\n                    add_edge(node_id[b][j], node_id[a][j + 1], 1, k * D);\n                }\n            }\n        }\n\n        int ans = min_cost_flow(src, sink);\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001811817055568099, -1.6689286894688848e-06, -9.536738616588991e-07, -0.0016687290044501424, -9.190614218823612e-05, -0.0699402317404747, -0.14276759326457977, -3.135155202471651e-05, -7.152555099310121e-07, -7.533743337262422e-05, -0.016034817323088646, -0.00010978573118336499, -0.001280560391023755, -0.14179636538028717, -3.218599158572033e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, -1.1920922133867862e-06, -4.768370445162873e-07, -0.0002321927313460037, -2.861018856492592e-06, 0.0, -1.0728830375228426e-06, 0.0, -3.933898824470816e-06, -0.04858925938606262, -5.149708886165172e-05, -2.396077979938127e-05, -8.344646857949556e-07, -0.0008048156159929931, 0.0, -1.1920928244535389e-07, -6.437280717364047e-06, 0.0, -1.1920928244535389e-07, -2.52720492426306e-05, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -3.2186455882765586e-06, -2.50339189733495e-06, -0.0006272017490118742, -1.9073468138230965e-06, 0.0, -3.5523738915799186e-05, -1.7523612768854946e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -2.7418097943154862e-06, -1.0728830375228426e-06, -1.7881377516459906e-06, -2.145764938177308e-06, -1.1920928244535389e-07, -4.005352093372494e-05, -3.576278118089249e-07, -3.576278118089249e-07, -2.622600959512056e-06, 0.0, -4.768370445162873e-07, -1.0728830375228426e-06, -5.364403477869928e-06, -9.536738616588991e-07, -6.6756979322235566e-06, -9.179073458653875e-06, -2.3841855067985307e-07, -0.0003864018653985113, -0.678956