 0; i < graph[u].size(); ++i) {\n            auto& e = graph[u][i];\n            if (e.capacity > 0 && dist[e.to] > dist[u] + e.cost) {\n                dist[e.to] = dist[u] + e.cost;\n                prevv[e.to] = u;\n                preve[e.to] = i;\n                if (!in_queue[e.to]) {\n                    q.push(e.to);\n                    in_queue[e.to] = true;\n                }\n            }\n        }\n    }\n    return dist[t] < INF;\n}\n\nint min_cost_flow(int s, int t) {\n    int flow = 0, cost = 0;\n    while (spfa(s, t)) {\n        int f = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            f = min(f, graph[prevv[v]][preve[v]].capacity);\n        }\n        flow += f;\n        cost += f * dist[t];\n        for (int v = t; v != s; v = prevv[v]) {\n            auto& e = graph[prevv[v]][preve[v]];\n            e.capacity -= f;\n            graph[v][e.rev].capacity += f;\n        }\n    }\n    return cost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> N >> M >> K >> C >> D;\n    cnt.assign(N + 1, 0);\n    for (int i = 0; i < K; ++i) {\n        int x; cin >> x;\n        cnt[x]++;\n    }\n\n    node_id.assign(N + 1, vector<int>(K + M + 3, 0));\n    node_count = 2;\n    src = 0; sink = 1;\n    graph.resize(2 + N * (K + M + 2));\n\n    for (int i = 1; i <= N; ++i) {\n        for (int j = 1; j <= K + M + 2; ++j) {\n            node_id[i][j] = ++node_count;\n            if (i == 1) {\n                add_edge(node_id[i][j], sink, INF, C * (j - 1));\n            }\n            if (j > 1) {\n                add_edge(node_id[i][j - 1], node_id[i][j], INF, 0);\n            }\n        }\n        if (cnt[i]) {\n            add_edge(src, node_id[i][1], cnt[i], 0);\n        }\n    }\n\n    for (int i = 0; i < M; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 1; j <= K + M + 1; ++j) {\n            for (int k = 1; k <= 2 * K - 1; k += 2) {\n                add_edge(node_id[a][j], node_id