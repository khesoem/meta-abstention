{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int MAX_N = 300005;\nint MOD = 1000000007;\n\ninline void add_mod(int &x, int y) { x = (x + y) % MOD; }\ninline int mul_mod(int x, int y) { return (long long)x * y % MOD; }\n\nint fast_pow(int x, int y) {\n    int res = 1;\n    while (y) {\n        if (y & 1) res = mul_mod(res, x);\n        x = mul_mod(x, x);\n        y >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    int n, K, mod_val;\n    scanf(\"%d%d%d\", &n, &K, &mod_val);\n    MOD = mod_val;\n\n    int fac[MAX_N], ifac[MAX_N];\n    fac[0] = 1;\n    for (int i = 1; i <= n; ++i) fac[i] = mul_mod(fac[i - 1], i);\n    ifac[n] = fast_pow(fac[n], MOD - 2);\n    for (int i = n - 1; i >= 0; --i) ifac[i] = mul_mod(ifac[i + 1], i + 1);\n\n    auto comb = [&](int x, int y) -> int {\n        if (y < 0 || y > x) return 0;\n        return mul_mod(fac[x], mul_mod(ifac[x - y], ifac[y]));\n    };\n\n    if (n & 1) {\n        printf(\"%d\\n\", fast_pow(K, n));\n        return 0;\n    }\n\n    int dp[2][MAX_N];\n    memset(dp, 0, sizeof(dp));\n    dp[0][n] = 1;\n    int ans = 0;\n\n    for (int i = 1; i <= K; ++i) {\n        int cur = i & 1, prev = (i - 1) & 1;\n        memset(dp[cur], 0, sizeof(dp[cur]));\n        int res = 0;\n        for (int j = 1; j <= n; ++j) {\n            int tmp = dp[prev][j];\n            if (!tmp) continue;\n            int u = j ^ (j & -j);\n            for (int sub = u; sub; sub = (sub - 1) & u)\n                add_mod(dp[cur][sub], mul_mod(tmp, comb(j, sub)));\n            add_mod(res, tmp);\n        }\n        add_mod(ans, mul_mod(res, ifac[K - i]));\n    }\n\n    ans = mul_mod(ans, fac[K]);\n    ans = (fast_pow(K, n) - ans + MOD) % MOD;\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAX_N = 300005;\n    static int MOD = 1000000007;\n\n    static void add_mod(int[] x, int y, int index) {\n        x[index] = (x[index] + y) % MOD;\n    }\n\n    static int mul_mod(int x, int y) {\n        return (int)((long)x * y % MOD);\n    }\n\n    static int fast_pow(int x, int y) {\n        int res = 1;\n        while (y > 0) {\n            if ((y & 1) == 1) res = mul_mod(res, x);\n            x = mul_mod(x, x);\n            y >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int K = sc.nextInt();\n        int mod_val = sc.nextInt();\n        MOD = mod_val;\n\n        int[] fac = new int[MAX_N];\n        int[] ifac = new int[MAX_N];\n        fac[0] = 1;\n        for (int i = 1; i <= n; ++i) fac[i] = mul_mod(fac[i - 1], i);\n        ifac[n] = fast_pow(fac[n], MOD - 2);\n        for (int i = n - 1; i >= 0; --i) ifac[i] = mul_mod(ifac[i + 1], i + 1);\n\n        if ((n & 1) == 1) {\n            System.out.println(fast_pow(K, n));\n            return;\n        }\n\n        int[][] dp = new int[2][MAX_N];\n        dp[0][n] = 1;\n        int ans = 0;\n\n        for (int i = 1; i <= K; ++i) {\n            int cur = i & 1;\n            int prev = (i - 1) & 1;\n            Arrays.fill(dp[cur], 0);\n            int res = 0;\n            for (int j = 1; j <= n; ++j) {\n                int tmp = dp[prev][j];\n                if (tmp == 0) continue;\n                int u = j ^ (j & -j);\n                for (int sub = u; sub > 0; sub = (sub - 1) & u) {\n                    int comb = mul_mod(fac[j], mul_mod(ifac[j - sub], ifac[sub]));\n                    add_mod(dp[cur], mul_mod(tmp, comb), sub);\n                }\n                res = (res + tmp) % MOD;\n            }\n            ans = (ans + mul_mod(res, ifac[K - i])) % MOD;\n        }\n\n        ans = mul_mod(ans, fac[K]);\n        ans = (fast_pow(K, n) - ans + MOD) % MOD;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.152555e-07, 0.0, 0.0, -0.00012468515, -7.724464e-05, -1.072883e-06, -0.04890705, -2.0388083, -0.00027533554, -2.622601e-06, -0.13285738, -0.0009689404, -2.3126335e-05, 0.0, -0.005540491, -0.0015230495, -0.00034159547, -0.050550934, -0.079347715, -3.5762723e-06, -5.6028207e-06, -0.00015996608, -1.1920928e-07, -1.6689287e-06, -2.0622994e-05, -1.585471e-05, -4.8636208e-05, -5.1259863e-06, -1.633154e-05, -0.008773707, -0.00027176025, -0.0072576446, -5.4836123e-06, -0.0015073378, -4.76836e-06, -2.264974e-06, -2.0265559e-06, -0.47423577, -1.4305105e-06, -0.0032239389, -0.06392103, -3.933899e-06, -0.16054651, -0.008164128, -7.879423e-05, -0.050768852, -0.00037448545, -9.5367386e-07, -0.3106976, -0.57594603, -1.668916e-05, -1.6156123, -7.748303e-05, -0.023245797, -3.5762723e-06, -0.0003771071, -7.0333235e-06, -2.622601e-06, -2.3841855e-07, -8.70224e-06, -0.0031785464, -8.344647e-07, 0.0, -4.7683704e-07, -1.4305105e-06, -5.1259863e-06, 0.0, -9.5367386e-07, -3.81469e