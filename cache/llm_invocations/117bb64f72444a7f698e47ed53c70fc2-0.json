if self.cur_char >= self.snum_chars:\n            self.cur_char = 0\n            try:\n                self.snum_chars = self.stream.readinto(self.buf)\n            except:\n                raise ValueError(\"InputMismatchException\")\n            if self.snum_chars <= 0:\n                return -1\n        ch = self.buf[self.cur_char]\n        self.cur_char += 1\n        return ch\n\n    def is_space_char(self, c):\n        return c == ord(' ') or c == ord('\\n') or c == ord('\\r') or c == ord('\\t') or c == -1\n\n    def is_end_of_line(self, c):\n        return c == ord('\\n') or c == ord('\\r') or c == -1\n\n    def next_int(self):\n        c = self.read()\n        while self.is_space_char(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.is_space_char(c):\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        return res * sgn\n\n    def next_long(self):\n        c = self.read()\n        while self.is_space_char(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.is_space_char(c):\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        return res * sgn\n\n    def next_int_array(self, n):\n        a = [0] * n\n        for i in range(n):\n            a[i] = self.next_int()\n        return a\n\n    def read_string(self):\n        c = self.read()\n        while self.is_space_char(c):\n            c = self.read()\n        res = []\n        while not self.is_space_char(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def next_line(self):\n        c = self.read()\n        while self.is_space_char(c):\n            c = self.read()\n        res = []\n        while not self.is_end_of_line(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\ndef main():\n    inp = InputReader(sys.stdin.buffer)\n    n = inp.next_int()\n    b = inp.next_int()\n    a = inp.next_int_array(n)\n    odd = [0] * (n + 1)\n    even = [0] * (n + 1)\n    for i in range(1, n + 1):\n        if a[i - 1] % 2 == 1:\n            odd[i] = odd[i - 1] + 1\n            even[i] = even[i - 1]\n        else:\n            odd[i] = odd[i - 1]\n            even[i] = even[i - 1] + 1\n    prev = 0\n    cost = []\n    import heapq\n    for i in range(1, n):\n        oc = odd[i] - odd[prev]\n        ec = even[i] - even[prev]\n        if oc == ec:\n            heapq.heappush(cost, abs(a[i] - a[i - 1]))\n            prev = i\n    total = 0\n    count = 0\n    while cost and total <= b:\n        total += heapq.heappop(cost)\n        count += 1\n    if count == 0:\n        print(\"0\")\n    else:\n        if not cost and total <= b:\n            print(count)\n        else:\n            print(count - 1)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0001236124, 0.0, -2.3841855e-07, -0.00010442189, -0.001980131, -0.005069023, -0.25262442, -0.12738144, -0.007989354, -2.264974e-06, -8.940657e-06, -3.2186456e-06, -1.6569955e-05, -1.5497195e-06, -2.3841855e-07, -1.1920928e-07, 0.0, -0.0004307296, -0.001362111, -0.038279857, -2.3841855e-07, -3.576278e-07, -0.00015925094, 0.0, -1.072883e-06, -0.0005635819, 0.0, -4.1723165e-06, -7.509903e-05, -0.005234821, -3.6954812e-06, -0.16981746, 0.0, -0.0110813435, -2.491443e-05, -2.145765e-06, -3.564294e-05, 0.0, -2.3841855e-07, -0.000458493, -1.4305105e-06, -0.57639474, -2.3841855e-07, -1.5497195e-06, -3.576278e-07, -3.576278e-07, -0.00033599453, -3.576278e-07, -0.16023679, -2.503392e-06, -1.7881378e-06, 0.0, -1.1920928e-07, -0.00026174934, -9.5367386e-07, -0.023566155, -8.344647e-07, -2.503392e-06, -0.12694001, -0.0011813812, -5.125868e-05, -1.1920928e-07, -1.8358061e-05, -3.576278e-07, -7.509903e-05,