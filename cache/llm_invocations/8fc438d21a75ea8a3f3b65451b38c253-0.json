         e[y].add(x);\n        }\n        \n        final int T = 100;\n        MinCostFlow mcf = new MinCostFlow();\n        mcf.init(n * T + 2);\n        \n        for (int i = 0; i < n; i++) {\n            mcf.addEdge(n * T, i, cnt[i], 0);\n        }\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i * n, n * T + 1, k, c * i);\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(j * n + i, (j + 1) * n + i, k, 0);\n            }\n            for (int to : e[i]) {\n                for (int j = 0; j < T - 1; j++) {\n                    for (int u = 0; u < k; u++) {\n                        int cost = (u + 1) * (u + 1) * d - u * u * d;\n                        mcf.addEdge(j * n + i, (j + 1) * n + to, 1, cost);\n                    }\n                }\n            }\n        }\n        System.out.println(mcf.minCostFlow(n * T, n * T + 1, k));\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.1920922e-06, 0.0, -1.1920928e-07, -0.00030298412, -0.00093511713, -2.7418098e-06, -0.02324603, -0.030272271, -0.1271268, -5.960463e-07, -0.0067835515, -0.011077689, -0.0052394457, -0.003050676, -0.048652735, -0.00026687398, -0.00072059885, -5.960463e-07, -4.0531077e-06, -1.1920928e-07, -2.7656173e-05, -0.005236007, 0.0, -3.81469e-06, -2.3841855e-07, 0.0, -0.0036125418, -0.00043204034, -0.003178071, -3.9099883e-05, -0.100211546, -2.9802277e-06, 0.0, -1.1920928e-07, 0.0, 0.0, -1.1920928e-07, -1.1920928e-07, 0.0, 0.0, -2.264974e-06, -5.4836123e-06, -3.576278e-07, 0.0, 0.0, -2.3841855e-07, 0.0, -0.00091153546, -1.1920928e-07, 0.0, -1.1920928e-07, -5.960463e-07, 0.0, 0.0, -2.0265559e-06, -9.5367386e-07, 0.0, -0.00020561488, -1.1920928e-07, 0.0, -1.9430925e-05, -3.576278e-07, -3.576278e-07, 0.0, -3.576278e-07, 0.0, -1.1920928e-07, -1.1920928e-07, -1.1920928e-07, -8.344647e-07, -5.960463e-07, -5.245195e-06, -0.029750995, -2.3841855e-07, -6.079655e-06, -0.00046540