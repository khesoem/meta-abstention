D\n    for i in range(m + m - 1, m - 1, -1):\n        if t_[i]:\n            for j in range(m - 1, -1, -1):\n                t_[i - j - 1] = (t_[i - j - 1] + t_[i] * h[j]) % MOD\n    for i in range(m):\n        p[i] = t_[i]\n\ndef calc(K: int) -> int:\n    global m, s, t, a, h\n    for i in range(m, -1, -1):\n        s[i] = 0\n        t[i] = 0\n    s[0] = 1\n    if m != 1:\n        t[1] = 1\n    else:\n        t[0] = h[0]\n    while K:\n        if K & 1:\n            mull(s, t)\n        mull(t, t)\n        K >>= 1\n    su = 0\n    for i in range(m):\n        su = (su + s[i] * a[i]) % MOD\n    return (su % MOD + MOD) % MOD\n\ndef work(x: List[int], n: int) -> int:\n    global m, a, h\n    if n < len(x):\n        return x[n]\n    v = BM(x)\n    m = len(v)\n    if not m:\n        return 0\n    for i in range(m):\n        h[i] = v[i]\n        a[i] = x[i]\n    return calc(n)\n\ndef check(n: int, up: int) -> int:\n    ans = 0\n    st = str(n)\n    length = len(st)\n    if n > 0:\n        ans += 1\n    for i in range(1, T):\n        cur = 1\n        num = n\n        for j in range(i - 1):\n            cur *= 10\n        for j in range(length, i):\n            num *= 10\n        if i < length:\n            prefix = st[:i]\n            num = int(prefix) + 1\n        if num > up:\n            num = up\n        if num > cur:\n            ans += num - cur\n    return ans\n\ndef main():\n    global up\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0]) + 1\n    up = n\n    part = (n % MOD) * (n // MOD1 + 2) % MOD\n    part = (MOD - part) % MOD\n    ans = 0\n    for i in range(n // MOD1 + 2):\n        cur = 0\n        for j in range(T):\n            L = 0\n            R = 1\n            if j >= 1:\n                L = 1\n                for k in range(j - 1):\n                    L *= 10\n                R = L * 10\n            if R > n:\n                R = n\n            last_r = R\n            if L < R:\n                L -= 1\n