n * 2 + 1) return flow;\n    for (; ptr[v] < (int)g[v].size(); ++ptr[v]) {\n        int id = g[v][ptr[v]], to = e[id].b;\n        if (d[to] != d[v] + 1) continue;\n        int pushed = dfs(to, min(flow, e[id].cap - e[id].flow));\n        if (pushed) {\n            e[id].flow += pushed;\n            e[id ^ 1].flow -= pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nint max_flow() {\n    int flow = 0;\n    while (bfs()) {\n        memset(ptr, 0, (n * n * 2 + 2) * sizeof(ptr[0]));\n        while (int pushed = dfs(0, INF))\n            flow += pushed;\n    }\n    return flow;\n}\n\nint way(int x1, int y1, int x2, int y2) {\n    queue<pair<int, pair<int, int> > > q;\n    q.push(make_pair(0, make_pair(x1, y1)));\n    int h[11][11];\n    for (int i = 0; i < 11; ++i)\n        for (int j = 0; j < 11; ++j)\n            h[i][j] = INF;\n\n    int dx[4] = {-1, 0, 1, 0};\n    int dy[4] = {0, -1, 0, 1};\n\n    while (!q.empty()) {\n        int v = q.front().first;\n        int x = q.front().second.first;\n        int y = q.front().second.second;\n        q.pop();\n        h[x][y] = v;\n\n        for (int dir = 0; dir < 4; ++dir) {\n            int nx = x + dx[dir], ny = y + dy[dir];\n            if (nx < 0 || nx >= n || ny < 0 || ny >= n) continue;\n            if (!m[nx][ny]) continue;\n            if (h[nx][ny] <= v + 1) continue;\n            bool target = (nx == x2 && ny == y2);\n            int lim = temp[nx][ny];\n            if ((target && lim >= v + 1) || (!target && lim > v + 1))\n                q.push(make_pair(v + 1, make_pair(nx, ny)));\n        }\n    }\n    return h[x2][y2];\n}\n\nint main() {\n    cin >> n >> t;\n    queue<pair<int, pair<int, int> > > q;\n    char ch;\n    int k = 1;\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            cin >> ch;\n            temp[i][j] = t;\n            if (ch == 'Z') {\n                sx = i;\n                sy = j;\n                m[i][j] = false;\n            } else if (ch == 'Y') {\n                m[i][j] = false;\n            } else {\n                m[i][j] = true;\n            }\n            add_edge(0, k++, (ch == 'Z' || ch == 'Y') ? 0 : ch - '0');\n        }\n    }\n\n    k = n * n + 1;\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            cin >> ch;\n            add_edge(k++, n * n * 2 + 1, (ch == 'Z' || ch == 'Y') ? 0 : ch - '0');\n        }\n    }\n\n    q.push(make_pair(0, make_pair(sx, sy)));\n    int dx[4] = {-1, 0, 1, 0};\n    int dy[4] = {0, -1, 0, 1};\n    while (!q.empty()) {\n        int v = q.front().first;\n        int x = q.front().second.first;\n        int y = q.front().second.second;\n        q.pop();\n        temp[x][y] = v;\n        for (int dir = 0; dir < 4; ++dir) {\n            int nx = x + dx[dir], ny = y + dy[dir];\n            if (nx < 0 || nx >= n || ny < 0 || ny >= n) continue;\n            if (v + 1 < temp[nx][ny] && m[nx][ny])\n                q.push(make_pair(v + 1, make_pair(nx, ny)));\n        }\n    }\n\n    k = 0;\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            int k1 = n * n;\n            ++k;\n            for (int z = 0; z < n; ++z) {\n                for (int w = 0; w < n; ++w) {\n                    ++k1;\n                    if (m[i][j] && m[z][w] && way(i, j, z, w) <= t)\n                        add_edge(k, k1, INF);\n                }\n            }\n        }\n    }\n\n    cout << max_flow();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1 << 29\nMAXN = 500\n\n# Global variables\nn = 0\nt = 0\nsx = 0\nsy = 0\ntemp = [[0]*11 for _ in range(11)]\nm = [[False]*11 for _ in range(11)]\ng = [[] for _ in range(MAXN*MAXN*2+2)]\ne = []  # list of [a, b, cap, flow]\nd = [0]*(MAXN*MAXN*2+2)\nptr = [0]*(MAXN*MAXN*2+2)\n\ndef add_edge(a, b, cap):\n    e.append([a, b, cap, 0])\n    g[a].append(len(e)-1)\n    e.append([b, a, 0, 0])\n    g[b].append(len(e)-1)\n\ndef bfs():\n    q = deque()\n    q.append(0)\n    for i in range(n*n*2+2):\n        d[i] = -1\n    d[0] = 0\n    while q and d[n*n*2+1] == -1:\n        v = q.popleft()\n        for idx in g[v]:\n            to = e[idx][1]\n            if d[to] == -1 and e[idx][3] < e[idx][2]:\n                q.append(to)\n                d[to] = d[v] + 1\n    return d[n*n*2+1] != -1\n\ndef dfs(v, flow):\n    if not flow:\n        return 0\n    if v == n*n*2+1:\n        return flow\n    while ptr[v] < len(g[v]):\n        idx = g[v][ptr[v]]\n        to = e[idx][1]\n        if d[to] == d[v] + 1:\n            pushed = dfs(to, min(flow, e[idx][2] - e[idx][3]))\n            if pushed:\n                e[idx][3] += pushed\n                e[idx^1][3] -= pushed\n                return pushed\n        ptr[v] += 1\n    return 0\n\ndef max_flow():\n    flow = 0\n    while bfs():\n        for i in range(n*n*2+2):\n            ptr[i] = 0\n        while True:\n            pushed = dfs(0, INF)\n            if not pushed:\n                break\n            flow += pushed\n    return flow\n\ndef way(x1, y1, x2, y2):\n    q = deque()\n    q.append((0, x1, y1))\n    h = [[INF]*11 for _ in range(11)]\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    while q:\n        v, x, y = q.popleft()\n        h[x][y] = v\n        for dir in range(4):\n            nx = x + dx[dir]\n            ny = y + dy[dir]\n            if nx < 0 or nx >= n or ny < 0 or ny >= n:\n                continue\n            if not m[nx][ny]:\n                continue\n            if h[nx][ny] <= v + 1:\n                continue\n            target = (nx == x2 and ny == y2)\n            lim = temp[nx][ny]\n            if (target and lim >= v+1) or (not target and lim > v+1):\n                q.append((v+1, nx, ny))\n    return h[x2][y2]\n\ndef main():\n    global n, t, sx, sy, temp, m, g, e, d, ptr\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    t = int(next(it))\n    # first grid\n    k = 1\n    for i in range(n):\n        line = next(it)\n        for j, ch in enumerate(line):\n            temp[i][j] = t\n            if ch == 'Z':\n                sx = i\n                sy = j\n                m[i][j] = False\n            elif ch == 'Y':\n                m[i][j] = False\n            else:\n                m[i][j] = True\n            cap = 0 if (ch == 'Z' or ch == 'Y') else ord(ch) - ord('0')\n            add_edge(0, k, cap)\n            k += 1\n    # second grid\n    k = n*n + 1\n    for i in range(n):\n        line = next(it)\n        for j, ch in enumerate(line):\n            cap = 0 if (ch == 'Z' or ch == 'Y') else ord(ch) - ord('0')\n            add_edge(k, n*n*2+1, cap)\n            k += 1\n    # BFS from start to set temp as time map\n    q = deque()\n    q.append((0, sx, sy))\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    while q:\n        v, x, y = q.popleft()\n        temp[x][y] = v\n        for dir in range(4):\n            nx = x + dx[dir]\n            ny = y + dy[dir]\n            if nx < 0 or nx >= n or ny < 0 or ny >= n:\n                continue\n            if v + 1 < temp[nx][ny] and m[nx][ny]:\n                q.append((v+1, nx, ny))\n    # add edges between cells\n    k = 0\n    for i in range(n):\n        for j in range(n):\n            k1 = n*n\n            k += 1\n            for z in range(n):\n                for w in range(n):\n                    k1 += 1\n                if m[i][j] and m[z][w] and way(i, j, j, w) <= t:\n                    add_edge(k, k1, INF)\n    print(max_flow())\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(1000000)\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0728830375228426e-06, -7.152555099310121e-07, 0.0, -3.0397906812140718e-05, -0.0005287918029353023, -4.768370445162873e-07, -3.6954811548639555e-0