{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <queue>\n#include <cstring>\n#include <cstdio>\n#include <algorithm>\nusing namespace std;\nconst int INF = 0x3f3f3f3f;\nconst int maxm = 2000015;\nconst int maxn = 105*55;\nint n, m, k, c, d;\ninline int read()\n{\n    int x=0,f=1;char ch=getchar();\n    while (ch<'0'||ch>'9'){if (ch=='-') f=-1;ch=getchar();}\n    while (ch>='0'&&ch<='9'){x=x*10+ch-'0';ch=getchar();}\n    return x*f;\n}\nstruct Edge\n{\n    int to, next, cap, flow, cost;\n}edge[maxm];\nint head[maxn], tol;\nint pre[maxn], dis[maxn];\nbool vis[maxn];\nint N ;\nvoid init(int n)\n{\n    N = n;\n    tol = 0;\n    memset(head, -1, sizeof(head));\n}\nvoid addedge(int u, int v, int cap, int cost)\n{\n    edge[tol].to = v;\n    edge[tol].cap = cap;\n    edge[tol].cost = cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[u];\n    head[u] = tol++;\n    edge[tol].to = u;\n    edge[tol].cap = 0;\n    edge[tol].cost = -cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[v];\n    head[v] = tol++;\n}\nbool bellman_ford(int s, int t)\n{\n    for(int i = 0; i < N; i++)\n    {\n        dis[i] = INF;\n        pre[i] = -1;\n    }\n    dis[s] = 0;\n    for(int i = 0; i < N-1; i++)\n    {\n        bool updated = false;\n        for(int u = 0; u < N; u++)\n        {\n            if(dis[u] == INF) continue;\n            for(int e = head[u]; e != -1; e = edge[e].next)\n            {\n                int v = edge[e].to;\n                if(edge[e].cap > edge[e].flow && dis[v] > dis[u] + edge[e].cost)\n                {\n                    dis[v] = dis[u] + edge[e].cost;\n                    pre[v] = e;\n                    updated = true;\n                }\n            }\n        }\n        if(!updated) break;\n    }\n    return pre[t] != -1;\n}\nint minCostMaxflow(int s, int t, int &cost)\n{\n    int flow = 0;\n    cost = 0;\n    while(bellman_ford(s,t))\n    {\n        int Min = INF;\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            if(Min > edge[i].cap - edge[i].flow)\n                Min = edge[i].cap - edge[i].flow;\n        }\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            edge[i].flow += Min;\n            edge[i^1].flow -= Min;\n            cost +=  edge[i].cost*Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\nint point(int x, int y){\n    return (x-1)*50+y;\n}\nint main(){\n    int S = 101*55, T = S + 1;\n    n = read(), m = read(), k = read(), c = read(), d = read();\n    int tmp;\n    init(T+1);\n    for(int i = 1; i <= k; i++){\n        tmp = read();\n        addedge(S, tmp, 1, 0);\n    }\n    for(int i = 1; i <= 50; i++){\n        for(int j = 1; j <= 103; j++){\n            int x = point(j, i);\n            int y = point(j+1, i);\n            addedge(x, y, INF, c);\n        }\n    }\n    for(int i = 0; i < 102; i++){\n        int tmp = i*50+1;\n        addedge(tmp, T, INF, 0);\n    }\n    for(int i = 1; i <= m; i++){\n        int u, v;\n        u = read(), v = read();\n        for(int j = 1; j <= 102; j++){\n            int x = point(j, u), x1 = point(j+1, u);\n            int y1 = point(j+1, v), y = point(j, v);\n            for(int k = 0; k < 50; k++){\n                int val = d*(k*2+1)+c;\n                addedge(x, y1, 1, val);\n                addedge(y, x1, 1, val);\n            }\n        }\n    }\n    int cost = 0;\n    minCostMaxflow(S, T, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nINF = 10**9\n\ndef read_ints():\n    for line in sys.stdin:\n        for num in line.split():\n            yield int(num)\n\ndef point(x, y):\n    return (x - 1) * 50 + y\n\ndef init(n):\n    global head, to, nxt, cap, flow, cost, N\n    N = n\n    head = [-1] * N\n    to = []\n    nxt = []\n    cap = []\n    flow = []\n    cost = []\n\ndef addedge(u, v, cap_val, cost_val):\n    global tol\n    # forward edge\n    to.append(v)\n    nxt.append(head[u])\n    cap.append(cap_val)\n    flow.append(0)\n    cost.append(cost_val)\n    head[u] = len(to) - 1\n    # reverse edge\n    to.append(u)\n    nxt.append(head[v])\n    cap.append(0)\n    flow.append(0)\n    cost.append(-cost_val)\n    head[v] = len(to) - 1\n\ndef bellman_ford(s, t):\n    dis = [INF] * N\n    pre = [-1] * N\n    dis[s] = 0\n    for _ in range(N - 1):\n        updated = False\n        for u in range(N):\n            if dis[u] == INF:\n                continue\n            e = head[u]\n            while e != -1:\n                v = to[e]\n                if cap[e] > flow[e] and dis[v] > dis[u] + cost[e]:\n                    dis[v] = dis[u] + cost[e]\n                    pre[v] = e\n                    updated = True\n                e = nxt[e]\n        if not updated:\n            break\n    return pre[t] != -1, pre, dis\n\ndef min_cost_max_flow(s, t):\n    total_cost = 0\n    total_flow = 0\n    while True:\n        found, pre, dis = bellman_ford(s, t)\n        if not found:\n            break\n        min_res = INF\n        e = pre[t]\n        while e != -1:\n            min_res = min(min_res, cap[e] - flow[e])\n            e = pre[to[e ^ 1]]\n        e = pre[t]\n        while e != -1:\n            flow[e] += min_res\n            flow[e ^ 1] -= min_res\n            total_cost += cost[e] * min_res\n            e = pre[to[e ^ 1]]\n        total_flow += min_res\n    return total_flow, total_cost\n\ndef main():\n    it = read_ints()\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    S = 101 * 55\n    T = S + 1\n    init(T + 1)\n    for _ in range(k):\n        tmp = next(it)\n        addedge(S, tmp, 1, 0)\n    for i in range(1, 51):\n        for j in range(1, 104):\n            x = point(j, i)\n            y = point(j + 1, i)\n            addedge(x, y, INF, c)\n    for i in range(0, 102):\n        tmp = i * 50 + 1\n        addedge(tmp, T, INF, 0)\n    for _ in range(m):\n        u = next(it)\n        v = next(it)\n        for j in range(1, 103):\n            x = point(j, u)\n            x1 = point(j + 1, u)\n            y = point(j, v)\n            y1 = point(j + 1, v)\n            for kk in range(0, 50):\n                val = d * (2 * kk + 1) + c\n                addedge(x, y1, 1, val)\n                addedge(y, x1, 1, val)\n    flow_result, cost_result = min_cost_max_flow(S, T)\n    print(cost_result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.858122211880982e-05, 0.0, 0.0, -0.00028081765049137175, -4.851700214203447e-05, -1.1920928244535389e-07, -0.1002679392695427, -0.014433855190873146, -4.291525328881107e-06, -3.683499380713329e-05, -7.855583680793643e-05, -0.16022755205631256, -0.0007550249574705958, -0.10531485825777054, -0.07196523249149323, -0.04225727543234825, -0.029196452349424362, -1.1920928244535389e-07, -4.8040190449682996e-05, -4.172316494077677e-06, -0.4205418825149536, -0.33237966895103455, -5.8412379075889