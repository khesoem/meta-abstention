sx][sy] = 0;\n    d2[zx][zy] = 0;\n\n    while (!qa.empty()) {\n        int layer = (int)qa.size();\n        while (layer--) {\n            int x = qa.front().first;\n            int y = qa.front().second;\n            qa.pop_front();\n\n            if (d2[x][y] >= 0) continue;\n\n            for (int i = 0; i < 4; ++i) {\n                int nx = x + dx[i];\n                int ny = y + dy[i];\n                if (ok(nx, ny) && d1[nx][ny] < 0) {\n                    d1[nx][ny] = d1[x][y] + 1;\n                    if (d1[nx][ny] > limitT) break;\n                    if (d2[nx][ny] >= 0) continue;\n                    qa.push_back({nx, ny});\n                    if (g2[nx][ny] != '0') {\n                        addEdge(id[sx][sy], id[nx][ny] + cnt, 10);\n                    }\n                }\n            }\n        }\n\n        layer = (int)qb.size();\n        while (layer--) {\n            int x = qb.front().first;\n            int y = qb.front().second;\n            qb.pop_front();\n\n            for (int i = 0; i < 4; ++i) {\n                int nx = x + dx[i];\n                int ny = y + dy[i];\n                if (ok(nx, ny) && d2[nx][ny] < 0) {\n                    d2[nx][ny] = d2[x][y] + 1;\n                    qb.push_back({nx, ny});\n                }\n            }\n        }\n    }\n}\n\nint pre[MAXN], vis[MAXN];\n\nbool findPath() {\n    memset(vis, 0, sizeof(vis));\n    queue<int> q;\n    vis[S] = 1;\n    q.push(S);\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        for (int e = head[u]; e != -1; e = edges[e].nxt) {\n            int v = edges[e].to;\n            if (edges[e].cap > 0 && !vis[v]) {\n                pre[v] = e;\n                if (v == T) return true;\n                vis[v] = 1;\n                q.push(v);\n            }\n        }\n    }\n    return false;\n}\n\nint maxFlow() {\n    int ans = 0;\n    while (findPath()) {\n        int add = 10000000;\n        for (int v = T; v != S; ) {\n            int e = pre[v];\n            add = min(add, edges[e].cap);\n            v = edges[e ^ 1].to;\n        }\n        for (int v = T; v != S; ) {\n            int e = pre[v];\n            edges[e].cap -= add;\n            edges[e ^ 1].cap += add;\n            v = edges[e ^ 1].to;\n        }\n        ans += add;\n    }\n    return ans;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> limitT;\n    for (int i = 0; i < n; ++i) cin >> g1[i];\n    for (int i = 0; i < n; ++i) cin >> g2[i];\n\n    memset(head, -1, sizeof(head));\n    tot = 0;\n    memset(id, -1, sizeof(id));\n    cnt = 0;\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (g1[i][j] == 'Z') {\n                zx = i;\n                zy = j;\n            } else if (ok(i, j)) {\n                id[i][j] = ++cnt;\n            }\n        }\n    }\n\n    S = 0;\n    T = 2 * cnt + 1;\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (ok(i, j)) buildNetwork(i, j);\n        }\n    }\n\n    cout << maxFlow() << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXE = 1000007\nMAXN = 1000\n\nedges = []  # list of [to, nxt, cap]\nhead = [-1] * (MAXN + 5)  # will be resized later\ntot = 0\n\ng1 = [[''] * 15 for _ in range(15)]\ng2 = [[''] * 15 for _ in range(15)]\nid = [[-1] * 15 for _ in range(15)]\ncnt = 0\nS = 0\nT = 0\nlimitT = 0\nn = 0\nzx = 0\nzy = 0\ndx = [0, 0, 1, -1]\ndy = [1, -1, 0, 0]\n\ndef ok(x, y):\n    return 0 <= x < n and 0 <= y < n and '0' <= g1[x][y] <= '9'\n\ndef addEdge(u, v, c):\n    global tot\n    edges.append([v, head[u], c])\n    head[u] = tot\n    tot += 1\n    edges.append([u, head[v], 0])\n    head[v] = tot\n    tot += 1\n\ndef buildNetwork(sx, sy):\n    if g2[sx][sy] != '0':\n        addEdge(id[sx][sy] + cnt, T, ord(g2[sx][sy]) - ord('0'))\n    if g1[sx][sy] == '0':\n        return\n    addEdge(S, id[sx][sy], ord(g1[sx][sy]) - ord('0'))\n    if g2[sx][sy] != '0':\n        addEdge(id[sx][sy], id[sx][sy] + cnt, 10)\n\n    d1 = [[-1] * 15 for _ in range(15)]\n    d2 = [[-1] * 15 for _ in range(15)]\n\n    qa = deque()\n    qb = deque()\n    qa.append((sx, sy))\n    qb.append((zx, zy))\n    d1[sx][sy] = 0\n    d2[zx][zy] = 0\n\n    while qa:\n        layer = len(qa)\n        for _ in range(layer):\n            x, y = qa.popleft()\n            if d2[x][y] >= 0:\n                continue\n            for i in range(4):\n                nx = x + dx[i]\n                ny = y + dy[i]\n                if ok(nx, ny) and d1[nx][ny] < 0:\n                    d1[nx][ny] = d1[x][y] + 1\n                    if d1[nx][ny] > limitT:\n                        break\n                    if d2[nx][ny] >= 0:\n                        continue\n                    qa.append((nx, ny))\n                    if g2[nx][ny] != '0':\n                        addEdge(id[sx][sy], id[nx][ny] + cnt, 10)\n\n        layer = len(qb)\n        for _ in range(layer):\n            x, y = qb.popleft()\n            for i in range(4):\n                nx = x + dx[i]\n                ny = y + dy[i]\n                if ok(nx, ny) and d2[nx][ny] < 0:\n                    d2[nx][ny] = d2[x][y] + 1\n                    qb.append((nx, ny))\n\npre = [0] * (MAXN + 5)\nvis = [0] * (MAXN + 5)\n\ndef findPath():\n    global vis\n    vis = [0] * (T + 2)\n    q = deque()\n    vis[S] = 1\n    q.append(S)\n    while q:\n        u = q.popleft()\n        e = head[u]\n        while e != -1:\n            v = edges[e][0]\n            if edges[e][2] > 0 and not vis[v]:\n                pre[v] = e\n                if v == T:\n                    return True\n                vis[v] = 1\n                q.append(v)\n            e = edges[e][1]\n    return False\n\ndef maxFlow():\n    ans = 0\n    while findPath():\n        add = 10**7\n        v = T\n        while v != S:\n            e = pre[v]\n            add = min(add, edges[e][2])\n            v = edges[e ^ 1][0]\n        v = T\n        while v != S:\n            e = pre[v]\n            edges[e][2] -= add\n            edges[e ^ 1][2] += add\n            v = edges[e ^ 1][0]\n        ans += add\n    return ans\n\ndef main():\n    global n, limitT, zx, zy, cnt, S, T, head, tot, edges, id, g1, g2\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    limitT = int(next(it))\n    for i in range(n):\n        g1[i] = list(next(it))\n    for i in range(n):\n        g2[i] = list(next(it))\n\n    # Reset global structures\n    head = [-1] * (2 * n * n + 5)  # enough\n    tot = 0\n    edges = []\n    id = [[-1] * 15 for _ in range(15)]\n    cnt = 0\n\n    for i in range(n):\n        for j in range(n):\n            if g1[i][j] == 'Z':\n                zx = i\n                zy = j\n            elif ok(i, j):\n                cnt += 1\n                id[i][j] = cnt\n\n    S = 0\n    T = 2 * cnt + 1\n\n    # Resize head to T+1\n    head = [-1] * (T + 2)\n\n    for i in range(n):\n        for j in range(n):\n            if ok(i, j):\n                buildNetwork(i, j)\n\n    print(maxFlow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -2.3841855067985307e-07, -0.0004413345886860043, -0.010149652138352394, -9.63164638960734e-05, -4.529942543740617e-06, -3.6477376852417365e-05, -2.3841855067985307e-07, 0.0, -3.814689989667386e-06, -0.0008990298374556005, -0.4848593473434448, -0.023427588865160942, -1.4185804502631072e-05, -2.3841855067985307e-07, -3.564294092939235e-05, -0.0001714082609396428, -6.258291978156194e-05, -0.009472071193158627, -0.018292419612407684, -1.1920922133867862e-06, -5.960462772236497e-07, -2.0265558760002023e-06, -0.00014876213390380144, -3.6238969187252223e-05, -0.007346046157181263, -0.4517667591571808,