tring>\n#include <sstream>\nusing namespace std;\n\nint ncr(int n, int r) {\n    if (r > n) return 0;\n    int ans = 1;\n    for (int i = n; i > n - r; i--) ans *= i;\n    for (int i = 2; i <= r; i++) ans /= i;\n    return ans;\n}\n\ndouble probab(int n, int x) {\n    int a = ncr(x, 3) * ncr(n - x, 0);\n    int b = ncr(x, 2) * ncr(n - x, 1);\n    int c = ncr(x, 1) * ncr(n - x, 2);\n    return 1.0 * ((3.0 / 6.0) * c + a + b) / ncr(n, 3);\n}\n\nint main() {\n    int n;\n    double p;\n    cin >> n >> p;\n    int i = 0;\n    while (i <= n) {\n        if (probab(n, i) >= p) break;\n        i++;\n    }\n    cout << i << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020990552729927003, 0.0, -1.1920928244535389e-07, -0.000562271336093545, -2.253030106658116e-05, -1.7881377516459906e-06, -7.807903602952138e-05, -0.023276077583432198, -0.4741404354572296, 0.0, -0.34001749753952026, -0.008665576577186584, -0.006717480253428221, -3.576278118089249e-07, -0.0003026265767402947, -1.1920928244535389e-07, -0.3869662284851074, -0.011053873226046562, -1.7881377516459906e-06, 0.0, -1.311301275563892e-06, -0.002954405965283513, -1.1920928244535389e-07, -9.179073458653875e-06, -5.960462772236497e-07, -1.1920928244535389e-07, -0.018150195479393005, 0.0, 0.0, -0.0007154765771701932, -1.6689286894688848e-06, -1.6689286894688848e-06, 0.0, -0.005233753472566605, 0.0, -1.1920928244535389e-07, 0.0, -1.9073468138230965e-06, 0.0, 0.0, -1.1920928244535389e-07, -2.622600959512056e-06, 0.0, -3.540453326422721e-05, 0.0, -3.576278118089249e-07, 0.0, 0.0, -0.0002618685248307884, 0.0, -0.0024758896324783564, -1.6689160474925302e-05, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, 0.0, -8.344646857949556e-07, 0.0, -4.005352093372494e-05, 0.0, 0.0, -0.07889040559530258, -0.00020346954988781363, -1.1920858014491387e-05, -7.152555099310121e-07, 0.0, -2.264974000354414e-06, 0.0, 0.0, 0.0, 0.0, -6.198863957251888e-06, -1.192092824453