u;\n                pe[v] = id;\n\n                if (!used[v]) {\n                    used[v] = true;\n                    if (!q.empty() && d[v] < d[q.front()])\n                        q.push_front(v);\n                    else\n                        q.push_back(v);\n                }\n            }\n        }\n    }\n\n    int cur = T;\n    while (cur != S) {\n        int id = pe[cur];\n        e[id].f++;\n        e[id ^ 1].f--;\n        cur = p[cur];\n    }\n\n    ans += d[T];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        add_edge(S, x, 1, 0);\n    }\n\n    int tt = 101;\n    for (int i = 0; i < tt; i++)\n        add_edge(1 + i * n, T, k, i * c);\n\n    for (int i = 0; i < m; i++) {\n        int x, y;\n        cin >> x >> y;\n        for (int step = 0; step < tt - 1; step++) {\n            for (int j = 0; j < k; j++) {\n                add_edge(x + step * n, y + step * n + n, 1, d * (j * 2 + 1));\n                add_edge(y + step * n, x + step * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n\n    for (int city = 0; city < n; city++)\n        for (int step = 0; step < tt - 1; step++)\n            add_edge(city + step * n, city + step * n + n, k, 0);\n\n    for (int i = 0; i < k; i++)\n        augment();\n\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    N = 14043\n    INF = 10**18\n\n    e = []  # list of [y, c, f, cost]\n    adj = [[] for _ in range(N)]\n\n    S = N - 2\n 