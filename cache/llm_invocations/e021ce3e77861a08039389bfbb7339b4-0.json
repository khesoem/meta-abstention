{\n            this.n = other.n;\n            a = new int[n][n];\n            for (int i = 0; i < n; i++) {\n                System.arraycopy(other.a[i], 0, a[i], 0, n);\n            }\n        }\n        void plus() {\n            for (int i = 0; i < n; i++) {\n                for (int j = 0; j < n; j++) {\n                    a[i][j] = (a[i][j] % MO + MO) % MO;\n                }\n            }\n        }\n    }\n\n    static void mm_init(int sz) {\n        mm_n = sz;\n        one = new Mat(sz);\n        for (int i = 0; i < sz; i++) {\n            one.a[i][i] = 1;\n        }\n    }\n\n    static Mat mul(Mat a, Mat b) {\n        int n = a.n;\n        long[][] tmp = new long[n][n];\n        for (int k = 0; k < n; k++) {\n            for (int i = 0; i < n; i++) {\n                long aik = a.a[i][k];\n                if (aik == 0) continue;\n                for (int j = 0; j < n; j++) {\n                    long prod = aik * b.a[k][j];\n                    tmp[i][j] += prod;\n                    if (tmp[i][j] >= INF) {\n                        tmp[i][j] %= MO;\n                    }\n                }\n            }\n        }\n        Mat c = new Mat(n);\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                c.a[i][j] = (int)(tmp[i][j] % MO);\n            }\n        }\n        return c;\n    }\n\n    static Mat jia(Mat x, int d, int k) {\n        int n = x.n; // n = k+1\n        Mat ret = new Mat(n);\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int ni = (i == n-1) ? n-1 : (i + d) % (n-1);\n                int nj = (j == n-1) ? n-1 : (j + d) % (n-1);\n                ret.a[ni][nj] = x.a[i][j];\n            }\n        }\n        return ret;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        int k = sc.nextInt();\n        sc.close();\n\n        mm_init(k + 1);\n\n        // compute