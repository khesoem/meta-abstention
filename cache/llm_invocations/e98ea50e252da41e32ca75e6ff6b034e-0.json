       if(MM > tp)MM = tp;\n        }\n        return;\n    }\n    Calc1(x-1, y, g+(!ck?A[x][y]:0), ck);\n    Calc1(x, y-1, g+(ck?B[x][y]:0), ck);\n}\n\nll Res;\n\nvoid Calc2(int x, int y, ll g, int ck){\n    if(x+y == R+n){\n        int t = std::lower_bound(Q[x][ck].begin(),Q[x][ck].end(), pll((TT+1)/2-g,0)) - Q[x][ck].begin();\n        if(t != (int)Q[x][ck].size() && Q[x][ck][t].second > 0){\n            ll tp = (Q[x][ck][t].first + g) * 2 - TT;\n            if(tp<0)tp=-tp;\n            if(MM == tp){\n                Res += Q[x][ck][t].second;\n            }\n        }\n        if(t && Q[x][ck][t-1].second > 0){\n            ll tp = (Q[x][ck][t-1].first + g) * 2 - TT;\n            if(tp<0)tp=-tp;\n            if(MM == tp){\n                Res += Q[x][ck][t-1].second;\n            }\n        }\n        return;\n    }\n    if(p[x+y-1] != 'B')Calc2(x-1, y, g+(!ck?A[x][y]:0), ck);\n    if(p[x+y-1] != 'A')Calc2(x, y-1, g+(ck?B[x][y]:0), ck);\n}\n\nvoid Make(std::vector<pll> &P){\n    if(P.empty())return;\n    std::sort(P.begin(),P.end());\n    int i, cnt = 0;\n    ll s = 0;\n    for(i=0;i<(int)P.size();i++){\n        s += P[i].second;\n        if(i==(int)P.size()-1 || P[i].first != P[i+1].first){\n            P[cnt++] = {P[i].first, s};\n            s = 0;\n        }\n    }\n    P.resize(cnt);\n}\n\nint main(){\n    int i, j;\n    scanf(\"%d%d\",&R,&C);\n    scanf(\"%s\",p);\n    i=0;\n    while(i<=60){\n        Comb[i][0]=1;\n        j=1;\n        while(j<=i){\n            Comb[i][j]=Comb[i-1][j-1]+Comb[i-1][j];\n            j++;\n        }\n        i++;\n    }\n    n = (R+C);\n    TT = Comb[n*2][R*2];\n    for(i=0;i<=n;i++){\n        for(j=0;j<=n;j++){\n            if(i){\n                A[i][j] = Comb[i-1][R-1] * (Comb[n*2-i][R] - Comb[j][R]);\n            }\n            if(j){\n                B[i][j] = Comb[j-1][R-1] * (Comb[n*2-j][R] - Comb[i][R]);\n            }\n        }\n    }\n    CC[0][0]=1;\n    for(i=0;i<=n;i++){\n        for(j=0;j<=n;j++){\n            if(i!=n&&p[i+j] != 'B') CC[i+1][j] += CC[i][j];\n            if(j!=n&&p[i+j] != 'A') CC[i][j+1] += CC[i][j];\n        }\n    }\n    for(i=R;i<=n;i++){\n        if(p[i+R-1]!='B')Put(R,i,A[R][i],Comb[i+R-1][R-1], CC[R-1][i],0);\n        if(p[i+R-1]!='A')Put(i,R,B[i][R],Comb[i+R-1][R-1], CC[i][R-1],1);\n    }\n    for(i=R;i<=n;i++){\n        for(j=0;j<2;j++){\n            Make(P[i][j]);\n            Make(Q[i][j]);\n        }\n    }\n    MM = TT+1;\n    Calc1(n, n, 0, 0);\n    Calc1(n, n, 0, 1);\n    Calc2(n, n, 0, 0);\n    Calc2(n, n, 0, 1);\n    printf(\"%lld\\n\",Res);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    R = int(data[0])\n    C = int(data[1])\n    p = data[2].strip()\n    n = R + C\n\n    # Comb up to 60\n    Comb = [[0]*62 for _ in range(62)]\n    for i in range(61):\n        Comb[i][0] = 1\n        for j in range(1, i+1):\n            Comb[i][j] = Comb[i-1][j-1] + Comb[i-1][j]\n\n    TT = Comb[2*n][2*R]\n\n    A = [[0]*32 for _ in range(32)]\n    B = [[0]*32 for _ in range(32)]\n    for i in range(n+1):\n        for j in range(n+1):\n            if i:\n                A[i][j] = Comb[i-1][R-1] * (Comb[2*n - i][R] - Comb[j][R])\n            if j:\n                B[i][j] = Comb[j-1][R-1] * (Comb[2*n - j][R] - Comb[i][R])\n\n    CC = [[0]*32 for _ in range(32)]\n    CC[0][0] = 1\n    for i in range(n+1):\n        for j in range(n+1):\n            if i != n and p[i+j] != 'B':\n                CC[i+1][j] += CC[i][j]\n            if j != n and p[i+j] != 'A':\n                CC[i][j+1] += CC[i][j]\n\n    P = [[[] for _ in range(2)] for _ in range(32)]\n    Q = [[[] for _ in range(2)] for _ in range(32)]\n\n    def Put(x, y, g, c1, c2, ck):\n        if x + y == R + n:\n            P[x][ck].append((g, c1))\n            if c2:\n                Q[x][ck].append((g, c2))\n            return\n        # move down (x+1)\n        Put(x+1, y, g + (A[x+1][y] if not ck else 0), c1,\n            c2 if p[x+y] != 'B' else 0, ck)\n        # move right (y+1)\n        Put(x, y+1, g + (B[x][y+1] if ck else 0), c1,\n            c2 if p[x+y] != 'A' else 0, ck)\n\n    for i in range(R, n+1):\n        if p[i+R-1] != 'B':\n            Put(R, i, A[R][i], Comb[i+R-1][R-1], CC[R-1][i], 0)\n        if p[i+R-1] != 'A':\n            Put(i, R, B[i][R], Comb[i+R-1][R-1], CC[i][R-1], 1)\n\n    def Make(lst):\n        if not lst:\n            return\n        lst.sort()\n        cnt = 0\n        s = 0\n        i = 0\n        while i < len(lst):\n            s += lst[i][1]\n            if i == len(lst)-1 or lst[i][0] != lst[i+1][0]:\n                lst[cnt] = (lst[i][0], s)\n                cnt += 1\n                s = 0\n            i += 1\n        del lst[cnt:]\n\n    for i in range(R, n+1):\n        for j in range(2):\n            Make(P[i][j])\n            Make(Q[i][j])\n\n    MM = TT + 1\n    Res = 0\n\n    def Calc1(x, y, g, ck):\n        nonlocal MM\n        if x + y == R + n:\n            if not P[x][ck]:\n                return\n            target = (TT + 1) // 2 - g\n            t = bisect.bisect_left(P[x][ck], (target, 0))\n            if t < len(P[x][ck]) and P[x][ck][t][1] > 0:\n                tp = (P[x][ck][t][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM > tp:\n                    MM = tp\n            if t > 0 and P[x][ck][t-1][1] > 0:\n                tp = (P[x][ck][t-1][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM > tp:\n                    MM = tp\n            return\n        Calc1(x-1, y, g + (A[x][y] if not ck else 0), ck)\n        Calc1(x, y-1, g + (B[x][y] if ck else 0), ck)\n\n    def Calc2(x, y, g, ck):\n        nonlocal Res, MM\n        if x + y == R + n:\n            if not Q[x][ck]:\n                return\n            target = (TT + 1) // 2 - g\n            t = bisect.bisect_left(Q[x][ck], (target, 0))\n            if t < len(Q[x][ck]) and Q[x][ck][t][1] > 0:\n                tp = (Q[x][ck][t][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM == tp:\n                    Res += Q[x][ck][t][1]\n            if t > 0 and Q[x][ck][t-1][1] > 0:\n                tp = (Q[x][ck][t-1][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM == tp:\n                    Res += Q[x][ck][t-1][1]\n            return\n        if p[x+y-1] != 'B':\n            Calc2(x-1, y, g + (A[x][y] if not ck else 0), ck)\n        if p[x+y-1] != 'A':\n            Calc2(x, y-1, g + (B[x][y] if ck else 0), ck)\n\n    Calc1(n, n, 0, 0)\n    Calc1(n, n, 0, 1)\n    Calc2(n, n, 0, 0)\n    Calc2(n, n, 0, 1)\n\n    print(Res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.960462772236497e-07, -4.768370445162873e-07, 0.0, -0.00010096516780322418, -0.0015405465383082628, -2.1457441107486375e-05, -0.0002774807217065245, -0.048606179654598236, -4.136476854910143e-05, -2.3841855067985307e-07, -0.001931469771079719, -0.009542802348732948, -0.28585097193717957, -0.005238378420472145, -2.0265558760002023e-06, -0.0012363893911242485, -4.768370445162873e-07, -3.4570634852570947e-06, 0.0, -0.00012492353562265635, -3.576278118089249e-07, -0.0619717612862587, -9.560128091834486e-05, -2.3841855067985307e-07, -0.03847866877913475, -0.0003355178632773459, 0.0, -0.0009114163694903255, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.014477094635367393, -0.00020692592079285532, 0.0, 0.0, 0.0, -1.0728830375228426e-06, -0.04860879108309746, 0.0, -1.1920928244535389e-07, -4.0531076592742465e-06, 0.0, 0.0, 0.0, -4.768360213347478e-06, -4.768370445162873e-07, 0.0, -0.000116699