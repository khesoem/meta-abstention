  ll lo = 0;\n        double lim = (double)x / y;\n        lim += (double)bestDiff.num / bestDiff.den;\n        ll hi = (ll)((lim + 2.0) * b);\n\n        while (lo <= hi) {\n            ll mid = lo + (hi - lo) / 2;\n            Rational cand(mid, b);\n            Rational diff = (target - cand).abs_value();\n\n            int c = diff.compare(bestDiff);\n            if (c == 0) {\n                if (cand.den < best.den ||\n                    (cand.den == best.den && cand.num < best.num)) {\n                    best = cand;\n                }\n            } else if (c < 0) {\n                bestDiff = diff;\n                best = cand;\n            }\n\n            if (cand.compare(target) < 0)\n                lo = mid + 1;\n            else\n                hi = mid - 1;\n        }\n    }\n\n    cout << best.num << \"/\" << best.den;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nclass Rational:\n    def __init__(self, num=0, den=1):\n        self.num = num\n        self.den = den\n\n    def __sub__(self, other):\n        l = self.den * other.den // math.gcd(self.den, other.den)\n        n1 = self.num * (l // self.den)\n        n2 = other.num * (l // other.den)\n        d = n1 - n2\n        g = math.gcd(abs(d), l)\n        return Rational(d // g, l // g)\n\n    def abs_value(self):\n        if self.num < 0:\n            return Rational(-self.num, self.den)\n        return Rational(self.num, self.den)\n\n    def compare(self, other):\n        l = self.den * other.den // math.gcd(self.den, other.den)\n        n1 = self.num * (l // self.den)\n        n2 = other.num * (l // other.den)\n        if n1 == n2:\n            return 0\n        return -1 if n1 < n2 else 1\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, n = map(int, data[:3])\n    g = math.gcd(x, y)\n    x //= g\n    y //= g\n\n    target = Rational(x, y)\n    bestDiff = Rational(1000000000000, 1)\n    best = Rational(0, 0)\n\n    for b in range(1, n + 1):\n        lo = 0\n        lim = x / y\n        lim += bestDiff.num / bestDiff.den\n        hi = int((lim + 2.0) * b)\n\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            cand = Rational(mid, b)\n            diff = (target - cand).abs_value()\n\n            c = diff.compare(bestDiff)\n            if c == 0:\n                if cand.den < best.den or (cand.den == best.den and cand.num < best.num):\n                    best = cand\n            elif c < 0:\n                bestDiff = diff\n                best = cand\n\n            if cand.compare(target) < 0:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n\n    sys.stdout.write(f\"{best.num}/{best.den}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.000164018536452204, -0.002541052643209696, -0.07888974994421005, -0.004083628766238689, -0.002476127352565527, 0.0, -0.01816951110959053, -0.002654245588928461, -1.1920928244535389e-07, -7.152555099310121e-07, -7.152555099310121e-07, -0.04859323427081108, -3.576278118089249e-07, 0.0, 0.0, 0.0, 0.0, -0.2014201581478119, -0.005340594798326492, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.9802276912960224e-06, -4.768370445162873e-07, -3.814689989667386e-06, -3.576278118089249e-07, -0.007720984984189272, -4.768370445162873e-07, -2.3841855067985307e-07, -0.0019287331961095333, -0.0006896263221278787, 0.0, -2.3841830625315197e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.004104998894035816, -1.1920922133867862e-06, -5.9126061387360096e-05, -5.769562994828448e-05, -6.079655122448457e-06, -3.576278118089249e-07, 0.0, 0.0, 0.0, -4.970903682988137e-05, -1.311301275563892e-06, -0.002048181602731347, -0.00034350217