nimport sys\n\nINF = 1000\n\ndef main():\n    input_data = sys.stdin.read().splitlines()\n    if not input_data:\n        return\n    \n    dim, time_to_die = map(int, input_data[0].split())\n    \n    # Initialize graph structures\n    gr = [[] for _ in range(2 * dim * dim + 2)]\n    cap = [[0] * (2 * dim * dim + 2) for _ in range(2 * dim * dim + 2)]\n    \n    # Read labsci and labcap\n    labsci = []\n    labcap = []\n    for i in range(1, dim + 1):\n        labsci.append(input_data[i])\n    for i in range(dim + 1, 2 * dim + 1):\n        labcap.append(input_data[i])\n    \n    vert = [[[0] * 2 for _ in range(dim)] for _ in range(dim)]\n    malfunc = 0\n    \n    N = 2\n    for i in range(dim):\n        for j in range(dim):\n            if '1' <= labsci[i][j] <= '9':\n                cap[0][N] = int(labsci[i][j])\n                gr[0].append(N)\n                gr[N].append(0)\n                vert[i][j][0] = N\n                N += 1\n            elif labsci[i][j] == 'Z':\n                malfunc = 100 * i + j\n                labsci[i] = labsci[i][:j] + 'Y' + labsci[i][j+1:]\n    \n    M = N\n    for i in range(dim):\n        for j in range(dim):\n            if '1' <= labcap[i][j] <= '9':\n                cap[M][1] = int(labcap[i][j])\n                gr[M].append(1)\n                vert[i][j][1] = M\n                M += 1\n    \n    die = [[time_to_die + 1] * dim for _ in range(dim)]\n    die[malfunc // 100][malfunc % 100] = 0\n    \n    q = deque()\n    q.append(malfunc)\n    ds = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n    \n    while q:\n        x = q.popleft()\n        y = x % 100\n        x //= 100\n        \n        for dx, dy in ds:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < dim and 0 <= ny < dim and labsci[nx][ny] != 'Y' and die[nx][ny] > die[x][y] + 1:\n                die[nx][ny] = die[x][y] + 1\n                q.append(100 * nx + ny)\n    \n    reach = [[time_to_die + 1] * dim for _ in range(dim)]\n    \n    def augment(u):\n        if u == 1:\n            return INF\n        vis[u] = True\n        for v in gr[u]:\n            if not vis[v] and cap[u][v]:\n                r = augment(v)\n                if r:\n                    parent[v] = u\n                    return min(r, cap[u][v])\n        return 0\n    \n    def maxflow():\n        ans = 0\n        flow = 0\n        parent = [-1] * (2 * dim * dim + 2)\n        \n        while True:\n            vis = [False] * (2 * dim * dim + 2)\n            flow = augment(0)\n            if not flow:\n                break\n            ans += flow\n            v = 1\n            while v != 0:\n                u = parent[v]\n                cap[u][v] -= flow\n                cap[v][u] += flow\n                v = u\n        return ans\n    \n    for i in range(dim):\n        for j in range(dim):\n            if '1' <= labsci[i][j] <= '9':\n                reach = [[time_to_die + 1] * dim for _ in range(dim)]\n                reach[i][j] = 0\n                \n                if '1' <= labcap[i][j] <= '9':\n                    cap[vert[i][j][0]][vert[i][j][1]] = INF\n                    gr[vert[i][j][0]].append(vert[i][j][1])\n                    gr[vert[i][j][1]].append(vert[i][j][0])\n                \n                q = deque()\n                q.append(100 * i + j)\n                \n                while q:\n                    x = q.popleft()\n                    y = x % 100\n                    x //= 100\n                    \n                    for dx, dy in ds:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < dim and 0 <= ny < dim and labsci[nx][ny] != 'Y' and reach[nx][ny] > reach[x][y] + 1:\n                            if '1' <= labcap[nx][ny] <= '9':\n                                if reach[x][y] + 1 <= die[nx][ny]:\n                                    cap[vert[i][j][0]][vert[nx][ny][1]] = INF\n                                    gr[vert[i][j][0]].append(vert[nx][ny][1])\n                        