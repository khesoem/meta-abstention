   int from = 10 * (j + i * 10) + num1;\n                                int to = 10 * (y + 10 * x) + num2;\n                                gr[from].add(to);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    static boolean kuhn(int v) {\n        if (used[v]) return false;\n        used[v] = true;\n        for (int to : gr[v]) {\n            if (pa[to] == 0 || kuhn(pa[to])) {\n                pa[to] = v;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    static void solve(Scanner sc) {\n        // Clear previous graph data\n        for (int i = 0; i < max_n; i++) {\n            gr[i].clear();\n        }\n        Arrays.fill(pa, 0);\n        Arrays.fill(used, false);\n        scan(sc);\n        int n = max_n;\n        for (int i = 0; i < n; i++) {\n            Arrays.fill(used, false);\n            kuhn(i);\n            Arrays.fill(used, false);\n        }\n        int res = 0;\n        for (int i = 0; i < n; i++) {\n            if (pa[i] != 0) res++;\n        }\n        System.out.println(res);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        solve(sc);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0006130746915005147, -0.00020354038861114532, -7.896309739408025e-07, -9.543733904138207e-05, -1.5048530030981055e-06, -1.9361264946837764e-07, -0.012511178851127625, -0.038136161863803864, -0.01886005327105522, -4.127333340875339e-06, -0.0005719788023270667, -0.0012499965960159898, -0.0001605115394340828, -1.9361264946837764e-07, -0.001213210285641253, -0.22551776468753815, -0.013265522196888924, -0.004112950060516596, -0.06893684715032578, -0.5822446942329407, -0.4303467571735382, -1.0564331205387134e-05, -0.22553402185440063, -0.0007747277268208563, -0.00023202638840302825, -1.9361264946837764e-07, -4.320199877838604e