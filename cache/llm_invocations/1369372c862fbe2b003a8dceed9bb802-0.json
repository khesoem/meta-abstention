 = j + 1; k < kraw.size(); k++) {\n                        if (kraw.get(i)[0] != kraw.get(k)[0] && kraw.get(j)[0] != kraw.get(k)[0] && kraw.get(i)[1] != kraw.get(k)[1] && kraw.get(j)[1] != kraw.get(k)[1]) {\n                            mask |= maska[(f ? 126 : 0) ^ ((1 << kraw.get(i)[1]) + (1 << kraw.get(j)[1]) + (1 << kraw.get(k)[1]))];\n                        }\n                    }\n                }\n            }\n        }\n        return mask;\n    }\n\n    static long pot(long a, long w) {\n        if (w == 0) return 1;\n        long b = pot(a, w / 2);\n        b = (b * b) % mod;\n        if (w % 2 == 1) {\n            b = (b * a) % mod;\n        }\n        return b;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        int n = Integer.parseInt(br.readLine());\n        for (int i = 1; i <= n; i++) {\n            StringTokenizer st = new StringTokenizer(br.readLine());\n            for (int j = 1; j <= n; j++) {\n                tab[i][j] = Integer.parseInt(st.nextToken());\n            }\n        }\n        int xd = 0;\n        for (int i = 1; i <= 6; i++) {\n            for (int j = i + 1; j <= 6; j++) {\n                for (int k = j + 1; k <= 6; k++) {\n                    maska[(1 << i) ^ (1 << j) ^ (1 << k)] = (1 << xd++);\n                }\n            }\n        }\n        for (int i = n + 1; i <= 6; i++) {\n            tab[i][i] = 100;\n        }\n        List<int[]> kraw = new ArrayList<>();\n        n = 6;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                kraw.add(new int[]{i, j});\n            }\n        }\n        long odw = pot(100, mod - 2);\n        for (int k = 0; k < 2; k++) {\n            for (int i = 0; i < (1 << 18); i++) {\n                long p = 1;\n                List<int[]> xd = new ArrayList<>();\n               