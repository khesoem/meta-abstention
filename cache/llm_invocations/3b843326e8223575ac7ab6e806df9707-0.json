air:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing i64 = long long;\nusing f128 = long double;\n\nconstexpr f128 EPSILON = 1e-6;\nconstexpr int INF_INT = 1000000000;\nconstexpr int MAX_SIZE = 21;\nconstexpr int MAX_BITMASK = 1 << MAX_SIZE;\n\nbool is_zero_diff(f128 a, f128 b) { return fabsl(a - b) < EPSILON; }\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k_val;\n    cin >> n >> k_val;\n    int N_original = n;\n\n    vector<f128> probabilities(n);\n    for (int i = 0; i < n; ++i) cin >> probabilities[i];\n\n    vector<f128> final_results(n, 0.0);\n\n    for (int i = 0; i < n; ++i) {\n        if (is_zero_diff(probabilities[i], 1.0L)) {\n            for (int j = 0; j < n; ++j)\n                final_results[j] = is_zero_diff(probabilities[j], 1.0L) ? 1.0L : 0.0L;\n            cout.precision(20);\n            for (int j = 0; j < n; ++j) {\n                cout << final_results[j];\n                cout << (j == n - 1 ? '\\n' : ' ');\n            }\n            return 0;\n        }\n    }\n\n    vector<int> perm(n);\n    iota(perm.begin(), perm.end(), 0);\n\n    for (int i = 0; i < n; ++i) {\n        if (is_zero_diff(probabilities[i], 0.0L)) {\n            for (int j = i; j < n - 1; ++j) {\n                probabilities[j] = probabilities[j + 1];\n                perm[j] = perm[j + 1];\n            }\n            --n;\n            --i;\n        }\n    }\n\n    if (n <= k_val) {\n        for (int i = 0; i < n; ++i) final_results[perm[i]] = 1.0L;\n        cout.precision(20);\n        for (int i = 0; i < N_original; ++i) {\n            cout << final_results[i];\n            cout << (i == N_original - 1 ? '\\n' : ' ');\n        }\n        return 0;\n    }\n\n    vector<vector<i64>> comb(MAX_SIZE, vector<i64>(MAX_SIZE, 0));\n    comb[0][0] = 1;\n    for (int i = 1; i < MAX_SIZE; ++i) {\n        comb[i][0] = 1;\n        for (int j = 1; j < MAX_SIZE; ++j)\n            comb[i][j] = comb[i - 1][j - 1] + comb[i - 1][j];\n    }\n\n    vector<f128> comb_coeffs(k_val, 0.0L);\n    for (int j = k_val - 1; j >= 1; --j) {\n        comb_coeffs[j] = 1.0L;\n        for (int i = 1; i <= k_val - 1 - j; ++i)\n            comb_coeffs[j] -= comb[n - j - 1][i];\n    }\n\n    int full_mask = 1 << n;\n    vector<f128> sum_subset(full_mask, 0.0L);\n    vector<int> bit_count(full_mask, 0);\n\n    for (int mask = 0; mask < full_mask; ++mask) {\n        for (int pos = 0; pos < n; ++pos) {\n            if (mask & (1 << pos)) {\n                sum_subset[mask] += probabilities[pos];\n                bit_count[mask]++;\n            }\n        }\n    }\n\n    for (int idx = 0; idx < n; ++idx) {\n        f128 temp = 0.0L;\n        for (int mask = 0; mask < full_mask; ++mask) {\n            int ones = bit_count[mask];\n            if (ones >= 1 && ones <= k_val - 1 && !(mask & (1 << idx))) {\n                assert(!is_zero_diff(sum_subset[mask], 1.0L));\n                temp += comb_coeffs[ones] * (sum_subset[mask] / (1.0L - sum_subset[mask]));\n            }\n        }\n        temp += 1.0L;\n        temp *= probabilities[idx];\n        final_results[perm[idx]] = temp;\n    }\n\n    cout.precision(20);\n    for (int i = 0; i < N_original; ++i) {\n        cout << final_results[i];\n        cout << (i == N_original - 1 ? '\\n' : ' ');\n    }\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing f128 = long double;\n\nconstexpr f128 EPSILON = 1e-12;\nconstexpr int MAX_SIZE = 21;\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k_val;\n    cin >> n >> k_val;\n\n    vector<f128> probabilities(n);\n    for (int i = 0; i < n; ++i) cin >> probabilities[i];\n\n    vector<f128> final_results(n, 0.0L);\n\n    // Handle edge case: if k >= n, all videos will always be in cache\n 