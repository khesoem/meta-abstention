+) {\n                ans += f(p + 1, x, (lastTwoDigit % 10) * 10 + i, len, str, true);\n            }\n        } else {\n            int digit = str.charAt(p) - '0';\n            ans += f(p + 1, x, (lastTwoDigit % 10) * 10 + digit, len, str, true);\n        }\n        \n        return dp[p][x][lastTwoDigit] = ans;\n    }\n\n    public static void solve(InputReader in, PrintWriter out) {\n        String str = in.next();\n        int len = str.length();\n        \n        // Check for leading zero issues\n        if (str.charAt(0) == '0') {\n            out.println(0);\n            return;\n        }\n        \n        // Special case: single character\n        if (len == 1) {\n            if (str.charAt(0) == '0') {\n                out.println(1);\n            } else if (str.charAt(0) == '_' || str.charAt(0) == 'X') {\n                out.println(1); // Only 0 is valid for single digit divisible by 25\n            } else {\n                int digit = str.charAt(0) - '0';\n                out.println(digit == 0 ? 1 : 0);\n            }\n            return;\n        }\n        \n        dp = new Long[len][11][100];\n        \n        long result = 0;\n        \n        // Handle first character specially to avoid leading zeros\n        char firstChar = str.charAt(0);\n        if (firstChar == 'X') {\n            for (int i = 1; i < 10; i++) {\n                result += f(1, i, i, len, str, true);\n            }\n        } else if (firstChar == '_') {\n            for (int i = 1; i < 10; i++) {\n                result += f(1, 10, i, len, str, true);\n            }\n        } else {\n            int digit = firstChar - '0';\n            if (digit != 0) {\n                result = f(1, 10, digit, len, str, true);\n            }\n        }\n        \n        out.println(result);\n    }\n\n    public static void main(String[] args) {\n        InputStream inputStream = System.in;\n        OutputStream outputStream = System.out;\n        InputReader in = new InputReader(in