32 && c != EOF) c = getChar();\n        while (c != '\\n' && c != EOF) {\n            res += c;\n            c = getChar();\n        }\n        return res;\n    }\n\n    bool hasNext() {\n        if (c > 32) return true;\n        while (true) {\n            c = getChar();\n            if (c == NC) return false;\n            else if (c > 32) return true;\n        }\n    }\n};\n\nint main() {\n    FastScanner sc;\n    \n    long long N = sc.nextLong();\n    long long M = sc.nextLong();\n    long long L = sc.nextLong();\n    long long R = sc.nextLong();\n\n    long long E = (R - L + 1) / 2 + (R % 2 == 0 && L % 2 == 0 ? 1 : 0);\n    long long O = (R - L + 1) - E;\n\n    long long ans;\n    if ((N * M) % 2 == 1) {\n        ans = fastExpo(E + O, N * M);\n    } else {\n        ans = (fastExpo(E + O, N * M) + fastExpo(E - O, N * M)) % mod;\n        ans = (ans * modInv(2)) % mod;\n    }\n    \n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.83174327807501e-05, -1.0728830375228426e-06, -1.311301275563892e-06, -0.00014625910262111574, -9.536738616588991e-07, -0.00010072677832795307, -8.344646857949556e-07, -0.00014780859055463225, -2.3841855067985307e-07, -0.4004574716091156, -6.556489552167477e-06, -0.00021109737281221896, -5.960462772236497e-07, -0.544694721698761, -1.2874520507466514e-05, -0.00026174934464506805, -9.536738616588991e-07, -0.46102964878082275, -0.00026174934464506805, -0.004080541897565126, -5.960462772236497e-07, -0.019640611484646797, -0.00043084874050691724, -0.004081848077476025, -2.145764938177308e-06, -0.8372986912727356, -4.529942543740617e-06, -0.0017025275155901909, -0.005236955359578133, -1.7881377516459906e-06, -0.8396852612495422, -0.00015925093612167984, -0.06197388842701912, -2.622600959512056e-06, -0.20156292617321014, -3.3378546504536644e-06, -4.887569048150908e-06, -2.7418097943154862e-06, -0.0009778724052011967, -5.435795901576057e-05, -0.0002337421028641984, -1.