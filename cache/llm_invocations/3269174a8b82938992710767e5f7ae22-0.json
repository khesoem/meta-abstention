;\n        p[i] = x;\n    }\n\n    static ld c[21][21], coef[21], sum[1 << 20];\n    static int sz[1 << 20];\n\n    build_binom(c, n);\n    build_masks(n, p, sum, sz);\n    build_coef(coef, c, n, k);\n\n    int lim = 1 << n;\n    for (int i = 0; i < n; ++i) {\n        ld ans = 0.0L;\n        if (p[i] > 0.005) {\n            int bit = 1 << i;\n            for (int mask = 0; mask < lim; ++mask) {\n                if ((mask & bit) != 0) continue;\n                if (sz[mask] >= k) continue;\n                ans += coef[sz[mask]] / (1.0L - sum[mask]);\n            }\n        }\n        printf(\"%.12lf \", (double)(p[i] * ans));\n    }\n\n    puts(\"\");\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.BufferedReader;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.util.StringTokenizer;\n\npublic class Main {\n    static void buildBinom(double[][] c, int n) {\n        c[0][0] = 1.0;\n        for (int i = 1; i <= n; ++i) {\n            c[i][0] = 1.0;\n            for (int j = 1; j <= i; ++j)\n                c[i][j] = c[i - 1][j - 1] + c[i - 1][j];\n        }\n    }\n\n    static void buildMasks(int n, double[] p, double[] sum, int[] sz) {\n        int lim = 1 << n;\n        for (int mask = 0; mask < lim; ++mask) {\n            int cnt = 0;\n            double s = 0.0;\n            for (int j = 0; j < n; ++j) {\n                if ((mask & (1 << j)) != 0) {\n                    ++cnt;\n                    s += p[j];\n                }\n            }\n            sz[mask] = cnt;\n            sum[mask] = s;\n        }\n    }\n\n    static void buildCoef(double[] coef, double[][] c, int n, int k) {\n        for (int i = k - 1; i >= 0; --i) {\n            coef[i] = 1.0 - coef[i];\n            for (int j = 1; i - j >= 0; ++j)\n                coef[i - j] += c[n - 1 - i + j][j] * coef[i];\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n\n        double[] p = new double[n];\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < n; ++i) {\n            p[i] = Double.parseDouble(st.nextToken());\n        }\n\n        double[][] c = new double[21][21];\n        double[] coef = new double[21];\n        int lim = 1 << n;\n        double[] sum = new double[lim];\n        int[] sz = new int[lim];\n\n        buildBinom(c, n);\n        buildMasks(n, p, sum, sz);\n        buildCoef(coef, c, n, k);\n\n        for (int i = 0; i < n; ++i) {\n            double ans = 0.0;\n            if (p[i] > 0.005) {\n                int bit = 1 << i;\n                for (int mask = 0; mask < lim; ++mask) {\n                    if ((mask & bit) != 0) continue;\n                    if (sz[mask] >= k) continue;\n                    ans += coef[sz[mask]] / (1.0 - sum[mask]);\n                }\n            }\n            System.out.printf(\"%.12f \", p[i] * ans);\n        }\n        System.out.println();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.0265373677830212e-05, 0.0, 0.0, -3.85038583772257e-05, -1.5735502529423684e-05, -1.1920928244535389e-07, -0.12692804634571075, -0.3135908544063568, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.03804221749305725, -3.576278118089249e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -3.6954811548639555e-06, -0.00523612555116415, -2.3841855067985307e-07, 0.0, -0.0003361137059982866, -8.95221673999913e-05, 0.0, -0.00014077626110520214, -9.059865078597795e-06, -1.1920928244535389e-07, -0.026418063789606094, -0.0380442813038826, -0.014186603017151356, -0.11136523634195328, -0.016456233337521553, -2.38418550679