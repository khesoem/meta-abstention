 int to, rev, cap, cost;\n            Edge(int to, int rev, int cap, int cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n\n        int n;\n        ArrayList<ArrayList<Edge>> graph;\n        int[] dist, prevv, preve;\n        boolean[] inq;\n        static final int INF = Integer.MAX_VALUE / 2;\n\n        MCMF(int n) {\n            this.n = n;\n            graph = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) graph.add(new ArrayList<>());\n            dist = new int[n];\n            prevv = new int[n];\n            preve = new int[n];\n            inq = new boolean[n];\n        }\n\n        void addEdge(int from, int to, int cap, int cost) {\n            graph.get(from).add(new Edge(to, graph.get(to).size(), cap, cost));\n            graph.get(to).add(new Edge(from, graph.get(from).size() - 1, 0, -cost));\n        }\n\n        boolean spfa(int s, int t) {\n            Arrays.fill(dist, INF);\n            Arrays.fill(inq, false);\n            Queue<Integer> q = new LinkedList<>();\n            dist[s] = 0;\n            inq[s] = true;\n            q.offer(s);\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                inq[v] = false;\n                for (int i = 0; i < graph.get(v).size(); i++) {\n                    Edge e = graph.get(v).get(i);\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.offer(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n            return dist[t] != INF;\n        }\n\n        int[] run(int s, int t) {\n            int flow = 0, cost = 0;\n            while (spfa(s, t)) {\n                int d = INF;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, graph.get(prevv[v]).get(preve[v]).cap);\n                }\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = graph.get(prevv[v]).get(preve[v]);\n                    e.cap -= d;\n                    graph.get(v).get(e.rev).cap += d;\n                }\n                flow += d;\n                cost += d * dist[t];\n            }\n            return new int[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] a = new int[k + 1];\n        for (int i = 1; i <= k; i++) {\n            a[i] = sc.nextInt();\n        }\n        int mx = 100;\n        int[][] id = new int[n + 1][mx + 1];\n        int cnt = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= mx; j++) {\n                id[i][j] = ++cnt;\n            }\n        }\n        int s = cnt + 1;\n        int t = cnt + 2;\n        MCMF mcmf = new MCMF(cnt + 3);\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < mx; j++) {\n                for (int h = 1; h <= k; h++) {\n                    int tmp = h * h * d - (h - 1) * (h - 1) * d;\n                    mcmf.addEdge(id[u][j], id[v][j + 1], 1, c + tmp);\n                    mcmf.addEdge(id[v][j], id[u][j + 1], 1, c + tmp);\n                }\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                mcmf.addEdge(id[i][j], id[i][j + 1], Integer.MAX_VALUE / 2, c);\n            }\n        }\n        for (int i = 1; i <= k; i++) {\n            mcmf.addEdge(s, id[a[i]][0], 1, 0);\n  