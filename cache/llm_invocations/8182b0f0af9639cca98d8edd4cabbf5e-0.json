o.IOException;\nimport java.io.InputStreamReader;\nimport java.io.PrintWriter;\nimport java.util.ArrayList;\nimport java.util.PriorityQueue;\nimport java.util.StringTokenizer;\n\npublic class Main {\n\n    static class Edge {\n        int to, capacity, cost, rev;\n        Edge() {}\n        Edge(int to, int _capacity, int _cost, int _rev) {\n            this.to = to;\n            this.capacity = _capacity;\n            this.cost = _cost;\n            this.rev = _rev;\n        }\n    }\n\n    static class Min_Cost_Max_Flow {\n        int V, H[], dis[], PreV[], PreE[];\n        ArrayList<Edge> G[];\n\n        public Min_Cost_Max_Flow(int n) {\n            V = n;\n            H = new int[n + 5];\n            dis = new int[n + 5];\n            PreV = new int[n + 5];\n            PreE = new int[n + 5];\n            G = new ArrayList[n + 5];\n            for (int i = 0; i <= n; ++i) G[i] = new ArrayList<>();\n        }\n\n        public void add_edge(int from, int to, int cap, int cost) {\n            G[from].add(new Edge(to, cap, cost, G[to].size()));\n            G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n        }\n\n        public int minCost(int s, int t, int f) {\n            int flow = 0;\n            int res = 0;\n            for (int i = 0; i <= V; ++i) H[i] = 0;\n            while (f > 0) {\n                PriorityQueue<pii> q = new PriorityQueue<>((a, b) -> a.first - b.first);\n                for (int i = 0; i <= V; ++i) dis[i] = Integer.MAX_VALUE;\n                dis[s] = 0; q.add(new pii(0, s));\n                while (!q.isEmpty()) {\n                    pii now = q.poll();\n                    int v = now.second;\n                    if (dis[v] < now.first) continue;\n                    for (int i = 0; i < G[v].size(); ++i) {\n                        Edge e = G[v].get(i);\n                        if (e.capacity > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n                            dis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n                            PreV[e.to] = v;\n                            PreE[e.to] = i;\n                            q.add(new pii(dis[e.to], e.to));\n                        }\n                    }\n                }\n                if (dis[t] == Integer.MAX_VALUE) break;\n                for (int i = 0; i <= V; ++i) H[i] += dis[i];\n                int d = f;\n                for (int v = t; v != s; v = PreV[v]) d = Math.min(d, G[PreV[v]].get(PreE[v]).capacity);\n                f -= d; flow += d; res += d * H[t];\n                for (int v = t; v != s; v = PreV[v]) {\n                    Edge e = G[PreV[v]].get(PreE[v]);\n                    e.capacity -= d;\n                    G[v].get(e.rev).capacity += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    static class pii implements Comparable<pii> {\n        int first, second;\n        public pii(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n        public int compareTo(pii other) {\n            return this.first - other.first;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        Min_Cost_Max_Flow mcmf = new Min_Cost_Max_Flow(n * (n + 55) + 2);\n        for (int i = 0; i < k; i++) {\n            int u = Integer.parseInt(br.readLine());\n            mcmf.add_edge(0, u, 1, 0);\n        }\n        ArrayList<pii> edge = new ArrayList<>();\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine