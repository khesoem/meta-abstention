{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ull = unsigned long long;\nconst ull INF = 17446744073709551616ull;\n\null n, k, mod;\null dp[19][300005];\null fact[300005], invfact[300005];\n\null modpow(ull a, ull b) {\n    ull ret = 1;\n    while (b) {\n        if (b & 1ULL) ret = (ret * a) % mod;\n        a = (a * a) % mod;\n        b >>= 1ULL;\n    }\n    return ret;\n}\n\null binom(int a, int b) {\n    return (fact[a] * invfact[b] % mod) * invfact[a - b] % mod;\n}\n\nvoid build_factorials() {\n    int limit = (int)max(n, k);\n    fact[0] = 1ULL;\n    for (int i = 1; i <= limit; ++i) fact[i] = fact[i - 1] * (ull)i % mod;\n    invfact[limit] = modpow(fact[limit], mod - 2ULL);\n    for (int i = limit - 1; i >= 0; --i)\n        invfact[i] = invfact[i + 1] * (ull)(i + 1) % mod;\n}\n\nvoid build_base_dp() {\n    for (int i = 1; i <= (int)n; ++i) dp[1][i] = invfact[i];\n}\n\nvoid process_layer(int layer) {\n    int prev = layer - 1;\n    for (int j = (int)n; j > 0; j = (j - 1) & (int)n) {\n        if (dp[prev][j] == 0) continue;\n        int rest = (int)n ^ j;\n        for (int l = rest; l > j; l = (l - 1) & rest) {\n            dp[layer][j ^ l] += dp[prev][j] * invfact[l];\n            if (dp[layer][j ^ l] > INF) dp[layer][j ^ l] %= mod;\n        }\n    }\n    for (int j = (int)n; j > 0; j = (j - 1) & (int)n) {\n        if (dp[layer][j] >= mod) dp[layer][j] %= mod;\n    }\n}\n\null calc_even() {\n    build_factorials();\n    build_base_dp();\n\n    ull ans = dp[1][(int)n] * binom((int)k, 1) % mod;\n    int maxLayer = min(18, (int)k);\n\n    for (int layer = 2; layer <= maxLayer; ++layer) {\n        process_layer(layer);\n        ull add = dp[layer][(int)n] * binom((int)k, layer) % mod;\n        add = add * fact[layer] % mod;\n        ans = (ans + add >= mod) ? ans + add - mod : ans + add;\n    }\n\n    ans = ans * fact[(int)n] % mod;\n    return ans;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> k >> mod;\n    ull ans = modpow(k, n);\n    if (n % 2ULL == 0ULL) ans = (ans - calc_even() + mod) % mod;\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n\n    INF = 17446744073709551616\n\n    # allocate arrays\n    max_nk = max(n, k)\n    fact = [0] * (max_nk + 1)\n    invfact = [0] * (max_nk + 1)\n\n    # dp: 19 layers, each of size n+1 (indices 0..n)\n    dp = [[0] * (n + 1) for _ in range(19)]\n\n    def modpow(a: int, b: int) -> int:\n        ret = 1\n        while b:\n            if b & 1:\n                ret = (ret * a) % mod\n            a = (a * a) % mod\n            b >>= 1\n        return ret\n\n    def binom(a: int, b: int) -> int:\n        return (fact[a] * invfact[b] % mod) * invfact[a - b] % mod\n\n    def build_factorials() -> None:\n        limit = max_nk\n        fact[0] = 1\n        for i in range(1, limit + 1):\n            fact[i] = fact[i - 1] * i % mod\n        invfact[limit] = modpow(fact[limit], mod - 2)\n        for i in range(limit - 1, -1, -1):\n            invfact[i] = invfact[i + 1] * (i + 1) % mod\n\n    def build_base_dp() -> None:\n        for i in range(1, n + 1):\n            dp[1][i] = invfact[i]\n\n    def process_layer(layer: int) -> None:\n        prev = layer - 1\n        j = n\n        while j > 0:\n            if dp[prev][j] != 0:\n                rest = n ^ j\n                l = rest\n                while l > j:   # note: condition l > j as in original\n                    dp[layer][j ^ l] += dp[prev][j] * invfact[l]\n                    if dp[layer][j ^ l] > INF:\n                        dp[layer][j ^ l] %= mod\n                    l = (l - 1) & rest\n            j = (j - 1) & n\n        # modulo all entries of this layer that are subsets of n\n        j = n\n        while j > 0:\n            if dp[layer][j] >= mod:\n                dp[layer][j] %= mod\n            j = (j - 1) & n\n\n    def calc_even() -> int:\n        build_factorials()\n        build_base_dp()\n        ans = dp[1][n] * binom(k, 1) % mod\n        max_layer = min(18, k)\n        for layer in range(2, max_layer + 1):\n            process_layer(layer)\n            add = dp[layer][n] * binom(k, layer) % mod\n            add = add * fact[layer] % mod\n            ans = (ans + add) % mod\n        ans = ans * fact[n] % mod\n        return ans\n\n    ans = modpow(k, n)\n    if n % 2 == 0:\n        ans = (ans - calc_even() + mod) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.576278118089249e-07, 0.0, 0.0, -0.0004478881892282516, -0.10009194165468216, -4.768370445162873e-07, -0.0052610281854867935, -0.5770370960235596, -0.3110671043395996, -0.07890384644269943, -2.3841830625315197e-06, -2.50339189733495e-06, -2.503391897334