 <= n; i++) {\n            if (contributionArr[i] == 0) continue;\n\n            long part1 = modExp(2, i, MOD);\n            long part2 = factorials[i];\n            long part3 = invFactorials[i];\n            long part4 = invFactorials[2 * i + 1];\n\n            long t = part1 * part3 % MOD;\n            t = t * part3 % MOD;\n            t = t * part4 % MOD;\n            t = t * contributionArr[i] % MOD;\n\n            ans = (ans + t) % MOD;\n        }\n\n        ans = ans * L % MOD;\n        if (ans < 0) ans += MOD;\n        System.out.println(ans);\n    }\n\n    private int[][] computeFactorialArrays(int max) {\n        int[] fact = new int[max + 1];\n        int[] invFact = new int[max + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= max; i++) {\n            fact[i] = (int) ((long) fact[i - 1] * i % MOD);\n        }\n        invFact[max] = modExp(fact[max], MOD - 2, MOD);\n        for (int i = max - 1; i >= 0; i--) {\n            invFact[i] = (int) ((long) invFact[i + 1] * (i + 1) % MOD);\n        }\n        return new int[][] { fact, invFact };\n    }\n\n    private long binomial(int n, int k, int[] fact, int[] invFact) {\n        if (k < 0 || k > n) return 0;\n        return (long) fact[n] * invFact[k] % MOD * invFact[n - k] % MOD;\n    }\n\n    private int modExp(long base, long exp, int mod) {\n        long res = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = res * base % mod;\n            base = base * base % mod;\n            exp >>= 1;\n        }\n        return (int) res;\n    }\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() throws Exception {\n            while (st == null || !st.hasMoreElements()) {\n                st = new StringTokenizer(br.readLine());\n            }\n            return st.nextToken();\n        }\n