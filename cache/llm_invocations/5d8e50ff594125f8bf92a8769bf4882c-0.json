r;\n                        }\n                    }\n                }\n                validIndices.add(i + 1);\n            }\n            System.out.println(validIndices.size());\n            for (int idx : validIndices) {\n                System.out.println(idx);\n            }\n        }\n    }\n\n    static double computeAngle(int[] origin, int[] a, int[] b) {\n        double dot = 0.0, lenA = 0.0, lenB = 0.0;\n        for (int i = 0; i < origin.length; i++) {\n            int da = a[i] - origin[i];\n            int db = b[i] - origin[i];\n            dot += da * db;\n            lenA += da * da;\n            lenB += db * db;\n        }\n        return Math.toDegrees(Math.acos(dot / Math.sqrt(lenA * lenB)));\n    }\n\n    static class FastReader {\n        private final int BUFFER_SIZE = 1 << 16;\n        private DataInputStream dis;\n        private byte[] buffer;\n        private int bufferPtr, bytesRead;\n\n        public FastReader() {\n            dis = new DataInputStream(System.in);\n            buffer = new byte[BUFFER_SIZE];\n            bufferPtr = bytesRead = 0;\n        }\n\n        private void fillBuffer() throws IOException {\n            bytesRead = dis.read(buffer, bufferPtr = 0, BUFFER_SIZE);\n            if (bytesRead == -1) buffer[0] = -1;\n        }\n\n        private byte read() throws IOException {\n            if (bufferPtr == bytesRead) fillBuffer();\n            return buffer[bufferPtr++];\n        }\n\n        public int nextInt() throws IOException {\n            int c, num = 0;\n            while ((c = read()) <= ' ');\n            boolean neg = c == '-';\n            if (neg) c = read();\n            do { num = num * 10 + c - '0'; } while ((c = read()) >= '0' && c <= '9');\n            return neg ? -num : num;\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef compute_