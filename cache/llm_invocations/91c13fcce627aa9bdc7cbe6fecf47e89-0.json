}\n    }\n    return dist[0] != 3010;\n}\n\nbool dfsHK(int x) {\n    if (x == 0) return true;\n    for (int v : adj[x]) {\n        int u = match[v];\n        if (dist[u] == dist[x] + 1) {\n            if (dfsHK(u)) {\n                match[x] = v;\n                match[v] = x;\n                return true;\n            }\n        }\n    }\n    return false;\n}\n\nint hopcroftKarp() {\n    int res = 0;\n    while (bfsHK()) {\n        for (int i = 1; i <= leftCnt; ++i) {\n            if (match[i] == 0) {\n                res += dfsHK(i);\n            }\n        }\n    }\n    return res;\n}\n\nint n, t;\n\nvoid processCell(int a, int b) {\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            dd[i][j] = 100000;\n    deque<pair<int,int>> q;\n    dd[a][b] = 0;\n    q.push_back({a, b});\n    while (!q.empty()) {\n        int x = q.front().first, y = q.front().second;\n        q.pop_front();\n        for (int v : tgtNodes[x][y])\n            for (int u : srcNodes[a][b])\n                addEdge(u, v);\n        if (dd[x][y] == ir[x][y]) continue;\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (sc[nx][ny] != -1 && dd[nx][ny] > dd[x][y] + 1 && dd[x][y] + 1 <= ir[nx][ny]) {\n                dd[nx][ny] = dd[x][y] + 1;\n                q.push_back({nx, ny});\n            }\n        }\n    }\n}\n\nint main() {\n    cin >> n >> t;\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            ir[i][j] = t;\n    for (int i = 1; i <= n; ++i)\n        cin >> (s[i] + 1);\n    for (int i = 1; i <= n; ++i)\n        cin >> (p[i] + 1);\n    int rx, ry;\n    leftCnt = 1;\n    rightStart = 1000;\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (s[i][j] == 'Z' || s[i][j] == 'Y') {\n                sc[i][j] = -1;\n                ir[i][j] = 0;\n            }\n            if (s[i][j] == 'Z') {\n                rx = i; ry = j;\n                ir[i][j] = 0;\n            }\n            if (s[i][j] >= '0' && s[i][j] <= '9')\n                sc[i][j] = s[i][j] - '0';\n            for (int k = 0; k < sc[i][j]; ++k)\n                srcNodes[i][j].push_back(leftCnt++);\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (p[i][j] >= '0' && p[i][j] <= '9')\n                pc[i][j] = p[i][j] - '0';\n            for (int k = 0; k < pc[i][j]; ++k)\n                tgtNodes[i][j].push_back(rightStart++);\n        }\n    }\n    deque<pair<int,int>> q;\n    q.push_back({rx, ry});\n    while (!q.empty()) {\n        rx = q.front().first; ry = q.front().second;\n        q.pop_front();\n        for (int d = 0; d < 4; ++d) {\n            int nx = rx + dx[d], ny = ry + dy[d];\n            if (ir[nx][ny] > ir[rx][ry] + 1 && sc[nx][ny] != -1) {\n                ir[nx][ny] = ir[rx][ry] + 1;\n                q.push_back({nx, ny});\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (sc[i][j] > 0)\n                processCell(i, j);\n    cout << hopcroftKarp() << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nsys.setrecursionlimit(10000)\n\n# Global variables\nadj = [[] for _ in range(2020)]\nir = [[0]*22 for _ in range(22)]\nsc = [[0]*22 for _ in range(22)]\npc = [[0]*22 for _ in range(22)]\ns = [['']*22 for _ in range(22)]\np = [['']*22 for _ in range(22)]\ndd = [[0]*22 for _ in range(22)]\ndx = [0, 1, -1, 0]\ndy = [1, 0, 0, -1]\nsrcNodes = [[[] for _ in range(22)] for _ in range(22)]\ntgtNodes = [[[] for _ in range(22)] for _ in range(22)]\n\ndef addEdge(a, b):\n    adj[a].append(b)\n    adj[b].append(a)\n\ndist = [0]*2020\nmatch = [0]*2020\nleftCnt = 0\nrightStart = 1000\n\ndef bfsHK():\n    q = deque()\n    for 