      for j in range(1, n+1):\n            p[i][j] = line[j-1]\n    rx = ry = 0\n    leftCnt = 1\n    rightStart = 1000\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if s[i][j] == 'Z' or s[i][j] == 'Y':\n                sc[i][j] = -1\n                ir[i][j] = 0\n            if s[i][j] == 'Z':\n                rx = i\n                ry = j\n                ir[i][j] = 0\n            if '0' <= s[i][j] <= '9':\n                sc[i][j] = ord(s[i][j]) - ord('0')\n            for _ in range(sc[i][j]):\n                srcNodes[i][j].append(leftCnt)\n                leftCnt += 1\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '0' <= p[i][j] <= '9':\n                pc[i][j] = ord(p[i][j]) - ord('0')\n            for _ in range(pc[i][j]):\n                tgtNodes[i][j].append(rightStart)\n                rightStart += 1\n    q = deque()\n    q.append((rx, ry))\n    while q:\n        rx, ry = q.popleft()\n        for d in range(4):\n            nx = rx + dx[d]\n            ny = ry + dy[d]\n            if ir[nx][ny] > ir[rx][ry] + 1 and sc[nx][ny] != -1:\n                ir[nx][ny] = ir[rx][ry] + 1\n                q.append((nx, ny))\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if sc[i][j] > 0:\n                processCell(i, j)\n    print(hopcroftKarp())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.909988299710676e-05, 0.0, -4.768370445162873e-07, -0.00014077626110520214, -0.003891515778377652, -3.6954811548639555e-06, -5.364403477869928e-06, -0.008394906297326088, 0.0, 0.0, -4.768370445162873e-07, -0.006723045837134123, -0.5241444706916809, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, 0.0, 0.0, -6.3774932641536e-05, -0.061968397349119186, -0.00026258357684127986, -1.0284442901611328, -0.34493693709373474, -0.3829345703125, -0.6464554667472839, -0.2787461280822754, -5.245195097813848e-06, -5.280832