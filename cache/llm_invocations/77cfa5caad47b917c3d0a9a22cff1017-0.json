\nimport heapq\nimport collections\ninput = stdin.readline\ndef inputnum():\n    return(int(input()))\ndef inputnums():\n    return(map(int,input().split()))\ndef inputlist():\n    return(list(map(int,input().split())))\ndef inputstring():\n    return([x for x in input()])\ndef inputstrings():\n    return([x for x in input().split()])\ndef inputstringnum():\n    return([ord(x)-ord('a') for x in input()])\ndef inputmatrixchar(rows):\n    arr2d = [[j for j in input().strip()] for i in range(rows)] \n    return arr2d\ndef inputmatrixint(rows):\n    arr2d = []\n    for _ in range(rows):\n        arr2d.append([int(i) for i in input().split()])\n    return arr2d\n\nn = inputnum()    \na1, a2, a3 = inputnums()\nb1, b2, b3 = inputnums()\nmn = min(a1, b1+b3) + min(a2, b2+b1) + min(a3, b3+b2)\nmx = min(a1, b2) + min(a2, b3) + min(a3, b1)\nprint(n-mn, mx)\n</original_code>\n\n<translated_code>\nimport java.util.Scanner;\nimport java.util.Arrays;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = readInt(scanner);\n        int[] a = readIntArray(scanner);\n        int[] b = readIntArray(scanner);\n        int mn = calculateMn(a, b);\n        int mx = calculateMx(a, b);\n        System.out.println(n - mn + \" \" + mx);\n    }\n\n    public static int readInt(Scanner scanner) {\n        return scanner.nextInt();\n    }\n\n    public static int[] readIntArray(Scanner scanner) {\n        int n = scanner.nextInt();\n        int[] array = new int[n];\n        for (int i = 0; i < n; i++) {\n            array[i] = scanner.nextInt();\n        }\n        return array;\n    }\n\n    public static int calculateMn(int[] a, int[] b) {\n        return Math.min(a[0], b[0] + b[2]) + Math.min(a[1], b[1] + a[0]) + Math.min(a[2], b[2] + b[1]);\n    }\n\n    public static int calculateMx(int[] a, int[] b) {\n        return Math.min(a[0], b[1]) + Math.min(a[1], b[2]) + Math.min(a[2], b[0]);\n    }\n}\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.022112015634775162, -0.005976306740194559, -2.4318398573086597e-05, -2.3841855067985307e-07, -0.0002455409849062562, -2.0265558760002023e-06, -6.949660019017756e-05, -7.152531907195225e-06, -1.549708758830093e-05, -0.00019226610311307013, -1.7881377516459906e-06, -2.9802276912960224e-06, -3.349725011503324e-05, -1.1920922133867862e-06, -1.5497195136049413e-06, -3.933898824470816e-06, -1.7523612768854946e-05, -0.0008169650682248175, -1.0013530300057027e-05, -8.535020606359467e-05, -3.7788631743751466e-05, -0.0009180859779007733, -0.0005389191792346537, -5.722029527532868e-06, -9.775113539944869e-06, -5.483612312673358e-06, -0.00034588552080094814, -1.311301275563892e-06, -3.0278701160568744e-05, -4.410734163684538e-06, -0.00011276562872808427, -1.549708758830093e-05, -3.576278118089249e-07, -6.556489552167477e-06, -2.3841830625315197e-06, -3.576272320060525e-06, -9.536738616588991e-07, -2.8371408916427754e-05, -5.960446742392378e-06, -3.957670196541585e-05, -1.7881377516459906e-06, -3.576272320060525e-06, -0.00017951308109331876, -9.536738616588991e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -8.344646857949556e-07, -3.6954811548639555e-06, -2.3841855067985307e-07, -6.997340824455023e-05, -8.106198947643861e-06, -3.6954811548639555e-06, -2.2053474822314456e-05, -2.3841855067985307e-07, -4.768370445162873e-07, -5.0424259825376794e-05, -4.768370445162873e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -9.536738616588991e-07, -2.0265558760002023e-06, -2.264974000354414e-06, -1.1324817933200393e-05, -9.536738616588991e-07, -2.3841855067985307e-07, 0.0, 0.0, -1.311301275563892e-06, -0.00015615197480656207, -2.3841855067985307e-07, -2.9802276912960224e-06, -1.6689286894688848e-06, -8.344646857949556e-07, -1.311301275563892e-06, -2.3841855067985307e-07, -2.8132995794294402e-05, 0.0, -1.4543427823809907e-05, -3.4570634852570947e-06, 0.0, -1.1920922133867862e-06, -8.344646857949556e-07, -1.85964