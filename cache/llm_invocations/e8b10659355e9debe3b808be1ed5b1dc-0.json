seek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    private static double absolute(double a) {\n        return a < 0 ? -a : a;\n    }\n\n    private static int[] bestFraction(int a, int b, int n) {\n        int bestNum = 0, bestDen = 0;\n        double bestDiff = 1e100;\n        for (int i = 1; i <= n; ++i) {\n            int x = i;\n            int y1 = (int)((double) a / b * i);\n            int y0 = y1 + 1;\n            double diff1 = absolute((double) a / b - (double) y1 / x);\n            if (bestDiff > diff1) {\n                bestNum = y1;\n                bestDen = x;\n                bestDiff = diff1;\n            }\n            double diff0 = absolute((double) a / b - (double) y0 / x);\n            if (bestDiff > diff0) {\n                bestNum = y0;\n                bestDen = x;\n                bestDiff = diff0;\n            }\n        }\n        return new int[]{bestNum, bestDen};\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int a = scanner.nextInt();\n        int b = scanner.nextInt();\n        int n = scanner.nextInt();\n        scanner.close();\n        int[] res = bestFraction(a, b, n);\n        System.out.println(res[0] + \"/\" + res[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021860594279132783, 0.0, -1.1920928244535389e-07, -5.61460001335945e-05, -3.3378546504536644e-06, 0.0, -6.198863957251888e-06, -0.0019334923708811402, -0.00033790123416110873, -5.8530047681415454e-05, 0.0, -0.03318391367793083, -0.011049275286495686, -0.048589371144771576, -0.4192003011703491, 0.0, -5.6503606174374e-05, -0.002476603025570512, -3.576214658096433e-05, -3.4570634852570947e-06, -1.1920928244535389e-07, -2.50339189733495e-06, 0.0, -8.344646857949556e-07, -6.437280717364047e-06, 0.0, 0.0, 0.0, -3.540453326422721e-05, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -5.9604