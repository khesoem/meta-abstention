ge &e = g[v][i];\n                    if (e.cap - e.flow <= 0) continue;\n\n                    int nd = d + e.cost + pot[v] - pot[e.to];\n                    if (nd < dist[e.to]) {\n                        if (dist[e.to] != INF) {\n                            pq.erase({dist[e.to], e.to});\n                        }\n                        dist[e.to] = nd;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        pq.insert({nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n            int add = INF - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                add = min(add, e.cap - e.flow);\n            }\n\n            flow += add;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.flow += add;\n                g[v][e.rev].flow -= add;\n                flow_cost += add * e.cost;\n            }\n        }\n\n        return {flow, flow_cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MCMF mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    pair<int, int> ans = mcf.run(N, N + 1);\n    assert(ans.first == k);\n    cout << ans.second << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1_000_000_000;\n    static final int T = 150;\n\n    static class Edge {\n        int to, rev, cap, flow, cost;\n        Edge(int to, int rev, int cap, int flow, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static class MCMF {\n        int n;\n        ArrayList<ArrayList<Edge>> g;\n        int[] dist, pot, prevv, preve;\n\n        MCMF(int n_) {\n            n = n_;\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) g.add(new ArrayList<>());\n            dist = new int[n];\n            pot = new int[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void addEdge(int from, int to, int cap, int cost) {\n            g.get(from).add(new Edge(to, g.get(to).size(), cap, 0, cost));\n            g.get(to).add(new Edge(from, g.get(from).size() - 1, 0, 0, -cost));\n        }\n\n        int[] run(int s, int t) {\n            int flow = 0, flowCost = 0;\n            while (true) {\n                Arrays.fill(dist, INF);\n                dist[s] = 0;\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                pq.offer(new int[]{0, s});\n\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int d = cur[0];\n                    int v = cur[1];\n                    if (d != dist[v]) continue;\n\n                    for (int i = 0; i < g.get(v).size(); i++) {\n                        Edge e = g.get(v).get(i);\n                        if (e.cap - e.flow <= 0) continue;\n                        int nd = d + e.cost + pot[v] - pot[e.to];\n                        if (nd < dist[e.to]) {\n                            dist[e.to] = nd;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.offer(new int[]{nd, e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] == INF) break;\n\n                for (int i = 0; i < n; i++) pot[i] += dist[i];\n\n                int add = INF - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    add = Math.min(add, e.cap - e.flow);\n                }\n\n                flow += add;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.flow += add;\n                    g.get(v).get(e.rev).flow -= add;\n                    flowCost += add * e.cost;\n                }\n            }\n            return new int[]{flow, flowCost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int N = n * T;\n        MCMF mcf = new MCMF(N + 2);\n\n        // stay edges\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        // sink edges\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i, N + 1, INF, 0);\n        }\n\n        // source to initial positions\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            mcf.addEdge(N, x * T, 1, 0);\n        }\n\n        // movement edges\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j < T - 1; j++) {\n                int cur = 1;\n                for (int z = 0; z < k; z++) {\n                    mcf.addEdge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                    mcf.addEdge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        int[] ans = mcf.run(N, N + 1);\n        // assert ans[0] == k;\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.6093124941107817e-05, 0.0, -1.1920928244535389e-07, -6.508615479106084e-05, -0.00017689094238448888, 0.0, -0.4740769863128662, -0.04866499826312065, 0.0, 0.0, 0.0, -3.4450891689630225e-05, -0.014298485592007637, -1.1920928244535389e-07, -0.004345736000686884, -0.029770204797387123, -0.0009128456003963947, -0.03066137246787548, -0.004105948377400637, -4.541770613286644e-05, 0.0, 0.0, -0.13468368351459503, -0.04861026629805565, -3.540453326422721e-05, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, -2.8013790142722428e-05, -1.07287787614041e-05, -0.0015266203554347157, -8.344646857949556e-07, -1.1920922133867862e-06, -4.768370445162873e-07, 0.0, -2.253030106658116e-05, -4.172316494077677e-06, 0.0, -1.1920928244535389e-07, -0.004744106903672218,