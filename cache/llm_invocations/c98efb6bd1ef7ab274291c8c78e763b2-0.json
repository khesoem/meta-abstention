min(cost, ugliness[i]);\n                    }\n                    if (c == s[n - 1 - i]) {\n                        cost = Math.min(cost, ugliness[n - 1 - i]);\n                    }\n                    mcf.addEdge(1 + (c - 'a'), 1 + 26 + i, 1, cost);\n                }\n            }\n\n            int[] occurs = new int[128];\n            for (int i = 0; i < n; ++i) occurs[s[i]]++;\n            for (char c = 'a'; c <= 'z'; ++c) {\n                mcf.addEdge(0, 1 + (c - 'a'), occurs[c], 0);\n            }\n\n            for (int i = 0; i < n / 2; ++i) {\n                mcf.addEdge(1 + 26 + i, 1 + 26 + n / 2, 2, 0);\n            }\n\n            long[] result = mcf.minCostMaxFlow(0, 1 + 26 + n / 2, n);\n            out.println(-result[0]);\n        }\n    }\n\n    static class MinCostFlow {\n        static class Edge {\n            int to, rev;\n            long cap, cost;\n            Edge(int to, int rev, long cap, long cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n\n        List<Edge>[] g;\n        long[] h, dist;\n        int[] prevv, preve;\n\n        @SuppressWarnings(\"unchecked\")\n        MinCostFlow(int n) {\n            g = new List[n];\n            for (int i = 0; i < n; i++) g[i] = new ArrayList<>();\n            h = new long[n];\n            dist = new long[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void addEdge(int from, int to, long cap, long cost) {\n            g[from].add(new Edge(to, g[to].size(), cap, cost));\n            g[to].add(new Edge(from, g[from].size() - 1, 0, -cost));\n        }\n\n        long[] minCostMaxFlow(int s, int t, long maxf) {\n            long flow = 0, cost = 0;\n            Arrays.fill(h, 0);\n            while (flow < maxf) {\n                Arrays.fill(dist, Long.MAX_VALUE);\n                dist[s] = 0;\n                PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[1]));\n                pq.offer(new long[]{s, 0});\n                while (!pq.isEmpty()) {\n                    long[] cur = pq.poll();\n                    int v = (int) cur[0];\n                    if (dist[v] < cur[1]) continue;\n                    for (int i = 0; i < g[v].size(); i++) {\n                        Edge e = g[v].get(i);\n                        if (e.cap > 0) {\n                            long nd = dist[v] + e.cost + h[v] - h[e.to];\n                            if (dist[e.to] > nd) {\n                                dist[e.to] = nd;\n                                prevv[e.to] = v;\n                                preve[e.to] = i;\n                                pq.offer(new long[]{e.to, nd});\n                            }\n                        }\n                    }\n                }\n                if (dist[t] == Long.MAX_VALUE) break;\n                for (int v = 0; v < g.length; v++) {\n                    if (dist[v] < Long.MAX_VALUE) h[v] += dist[v];\n                }\n                long d = maxf - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, g[prevv[v]].get(preve[v]).cap);\n                }\n                flow += d;\n                cost += d * h[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g[prevv[v]].get(preve[v]);\n                    e.cap -= d;\n                    g[v].get(e.rev).cap += d;\n                }\n            }\n            return new long[]{cost, flow};\n        }\n    }\n\n    static class InputReader {\n        private InputStream stream;\n        private byte[] buf = new byte[1024];\n        private int curChar;\n        private int numChars;\n        private SpaceCharFilter filter;\n\n        public InputReader(InputStream stream) {\n            this.stream = stream;\n        }\n\n        public int read() {\n            if (numChars == -1) throw new