ce std;\n\ntypedef long long ll;\n\nstruct Edge {\n    int to, rev;\n    ll cap, cost;\n    Edge(int to, int rev, ll cap, ll cost) : to(to), rev(rev), cap(cap), cost(cost) {}\n};\n\nclass MinCostFlow {\npublic:\n    vector<vector<Edge>> g;\n    vector<ll> h, dist;\n    vector<int> prevv, preve;\n\n    MinCostFlow(int n) {\n        g.resize(n);\n        h.assign(n, 0);\n        dist.assign(n, 0);\n        prevv.assign(n, 0);\n        preve.assign(n, 0);\n    }\n\n    void addEdge(int from, int to, ll cap, ll cost) {\n        g[from].push_back(Edge(to, (int)g[to].size(), cap, cost));\n        g[to].push_back(Edge(from, (int)g[from].size() - 1, 0, -cost));\n    }\n\n    pair<ll, ll> minCostMaxFlow(int s, int t, ll maxf) {\n        ll flow = 0, cost = 0;\n        fill(h.begin(), h.end(), 0);\n        while (flow < maxf) {\n            fill(dist.begin(), dist.end(), LLONG_MAX);\n            dist[s] = 0;\n            priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n            pq.push({0, s});\n            while (!pq.empty()) {\n                auto cur = pq.top(); pq.pop();\n                int v = cur.second;\n                if (dist[v] < cur.first) continue;\n                for (int i = 0; i < (int)g[v].size(); i++) {\n                    Edge &e = g[v][i];\n                    if (e.cap > 0) {\n                        ll nd = dist[v] + e.cost + h[v] - h[e.to];\n                        if (dist[e.to] > nd) {\n                            dist[e.to] = nd;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.push({nd, e.to});\n                        }\n                    }\n                }\n            }\n            if (dist[t] == LLONG_MAX) break;\n            for (int v = 0; v < (int)g.size(); v++) {\n                if (dist[v] < LLONG_MAX) h[v] += dist[v];\n            }\n            ll d = maxf - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = min(d, g[prevv[v]][preve[v]].cap);\n            }\n            flow += d;\n            cost += d * h[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= d;\n                g[v][e.rev].cap += d;\n            }\n        }\n        return {cost, flow};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    string s;\n    cin >> s;\n    vector<int> ugliness(n);\n    for (int i = 0; i < n; ++i) {\n        int x;\n        cin >> x;\n        ugliness[i] = -x;\n    }\n\n    int V = 1 + 26 + n / 2 + 1;\n    MinCostFlow mcf(V);\n    for (char c = 'a'; c <= 'z'; ++c) {\n        for (int i = 0; i < n / 2; ++i) {\n            ll cost = 0;\n            if (c == s[i]) {\n                cost = min(cost, (ll)ugliness[i]);\n            }\n            if (c == s[n - 1 - i]) {\n                cost = min(cost, (ll)ugliness[n - 1 - i]);\n            }\n            mcf.addEdge(1 + (c - 'a'), 1 + 26 + i, 1, cost);\n        }\n    }\n\n    int occurs[128] = {0};\n    for (int i = 0; i < n; ++i) occurs[s[i]]++;\n    for (char c = 'a'; c <= 'z'; ++c) {\n        mcf.addEdge(0, 1 + (c - 'a'), occurs[c], 0);\n    }\n\n    for (int i = 0; i < n / 2; ++i) {\n        mcf.addEdge(1 + 26 + i, 1 + 26 + n / 2, 2, 0);\n    }\n\n    auto result = mcf.minCostMaxFlow(0, 1 + 26 + n / 2, n);\n    cout << -result.first << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.3351351299206726e-05, 0.0, 0.0, -0.00096703483723104, -0.002085417043417692, -2.9802276912960224e-06, -0.313272088766098, -1.1444026313256472e-05, 0.0, 0.0, -0.006762002129107714, -4.768370445162873e-07, 0.0, 0.0, -0.015082603320479393, -4.768370445162873e-07, 0.0, 0.0, -0.04965055361390114, -7.152555099310121e-07, 0.0, 0.0, -0.14882120490074158, 0.0, 0.0, -0.0052426476031541824, -0.0015025765169411898, 0.0, -0.387974768877029