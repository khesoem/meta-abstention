            bi, bj = i, j\n                break\n    \n    INF = 0x3f3f3f3f\n    mat = [[INF] * (n * n) for _ in range(n * n)]\n    \n    dir_moves = [[0, 1], [0, -1], [1, 0], [-1, 0]]\n    \n    def solve(start_i, start_j, dist_array, check):\n        vis = [INF] * (n * n)\n        vis[start_i * n + start_j] = 0\n        que = deque()\n        que.append((start_i, start_j))\n        \n        while que:\n            now_i, now_j = que.popleft()\n            p = now_i * n + now_j\n            dis = vis[p]\n            \n            if check:\n                z = bi * n + bj\n                if mat[z][p] <= dis or t <= dis:\n                    if mat[z][p] < dis or t < dis:\n                        vis[p] = INF + 1\n                    continue\n            \n            for d in range(4):\n                i = now_i + dir_moves[d][0]\n                j = now_j + dir_moves[d][1]\n                if i < 0 or j < 0 or i == n or j == n:\n                    continue\n                if not ('0' <= b[i][j] <= '9'):\n                    continue\n                q = i * n + j\n                if vis[q] != INF:\n                    continue\n                vis[q] = dis + 1\n                que.append((i, j))\n        \n        for i in range(n * n):\n            dist_array[i] = vis[i]\n    \n    solve(bi, bj, mat[bi * n + bj], False)\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= a[i][j] <= '9':\n                solve(i, j, mat[i * n + j], True)\n    \n    ca = []\n    cb = []\n    \n    cap = [[0] * (2 + n * n + n * n) for _ in range(2 + n * n + n * n)]\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= b[i][j] <= '9':\n                ca.append(i)\n                cb.append(j)\n                p = i * n + j\n                cap[p + 2 + n * n][1] = ord(b[i][j]) - ord('0')\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= a[i][j] <= '9':\n                p = i * n + j\n                cap[0][p + 2] = ord(a[i][j]) - ord('0')\n                for k in range(len(ca)):\n                    ii = ca[k]\n                    jj = cb[k]\n                    q = ii * n + jj\n                    if mat[p][q] < INF:\n                        cap[p + 2][q + 2 + n * n] = INF\n    \n    flow = [[0] * (2 + n * n + n * n) for _ in range(2 + n * n + n * n)]\n    \n    result = edmonds_karp(2 + n * n + n * n, 0, 1, cap, flow)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.202533692587167e-05, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.008968192152678967, -0.001888517290353775, -8.344646857949556e-07, -0.0002637753786984831, -0.00030417583184316754, -1.4305104514278355e-06, -0.00016175392374861985, -0.0004389514506328851, -0.16720038652420044, -0.10441082715988159, -3.790783375734463e-05, -0.20145729184150696, -8.344646857949556e-07, -0.004919685889035463, -0.00010799778101500124, -4.386805812828243e-05, 0.0, -3.576272320060525e-06, -0.31326520442962646, -0.10250228643417358, -0.03472096100449562, -4.2676016164477915e-05, -0.0004191712068859488, -4.0531076592742465e-06, -0.2251291275024414, -6.6756979322235566e-06, -0.0003861635341309011, -4.410734163684538e-06, -2.50339189733495e-06, 0.0, -1.2993727978027891e-05, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -0.012565136887133121, -1.1920922133867862e-06, -0.342208594083786, -2.3841830625315197e-06, -0.00045694399159401655, -3.576278118089249e-07, -4.410734163684538e-06, -1.1920928244535389e-07, -1.9311717551317997e-05, -3.099436753473128e-06, -1.9073468138230965e-06, -0.3534722626209259, -1.2516897186287679e-05, -1.9073304429184645e-05, -0.0021871235221624374, -5.960462772236497e-07, -1.9073468138230965e-06, -1.1920922133867862e-06, -0.22591851651668549, -1.4305104514278355e-06, -0.012795372866094112, -1.0847986231965479e-05