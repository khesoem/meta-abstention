     while (!q.isEmpty()) {\n                int v = q.poll();\n                for (long[] edge : links.get(v)) {\n                    long cap = edge[0];\n                    int to = (int) edge[1];\n                    if (cap > 0 && depth[to] < 0) {\n                        depth[to] = depth[v] + 1;\n                        q.offer(to);\n                    }\n                }\n            }\n        }\n\n        public long dfs(int v, int t, long flow) {\n            if (v == t) {\n                return flow;\n            }\n            for (int i = progress[v]; i < links.get(v).size(); i++) {\n                progress[v] = i;\n                long[] edge = links.get(v).get(i);\n                long cap = edge[0];\n                int to = (int) edge[1];\n                int rev = (int) edge[2];\n                if (cap == 0 || depth[v] >= depth[to]) {\n                    continue;\n                }\n                long d = dfs(to, t, Math.min(flow, cap));\n                if (d == 0) {\n                    continue;\n                }\n                links.get(v).get(i)[0] -= d;\n                links.get(to).get(rev)[0] += d;\n                return d;\n            }\n            return 0;\n        }\n\n        public long flow(int s, int t) {\n            long flow = 0;\n            while (true) {\n                bfs(s);\n                if (depth[t] < 0) {\n                    return flow;\n                }\n                progress = new int[n];\n                long current_flow = dfs(s, t, INF);\n                while (current_flow > 0) {\n                    flow += current_flow;\n                    current_flow = dfs(s, t, INF);\n                }\n            }\n        }\n\n        public long[] getEdge(int i) {\n            int[] p = pos.get(i);\n            long[] e = links.get(p[0]).get(p[1]);\n            long[] re = links.get((int) e[1]).get((int) e[2]);\n            return new long[]{p[0], e[1], e[0] + re[0], re[0]};\n        }\n\n        public List<long[]> getEdges() {\n            int M = pos.size();\n            List<long[]> res = new ArrayList<>();\n            for (int i = 0; i < M; i++) {\n                res.add(getEdge(i));\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] line1 = br.readLine().trim().split(\"\\\\s+\");\n        int N = Integer.parseInt(line1[0]);\n        int M = 3;\n        String[] line2 = br.readLine().trim().split(\"\\\\s+\");\n        int[] A = new int[M];\n        for (int i = 0; i < M; i++) {\n            A[i] = Integer.parseInt(line2[i]);\n        }\n        String[] line3 = br.readLine().trim().split(\"\\\\s+\");\n        int[] B = new int[M];\n        for (int i = 0; i < M; i++) {\n            B[i] = Integer.parseInt(line3[i]);\n        }\n\n        int ans1 = 0;\n        for (int i = 0; i < M; i++) {\n            ans1 += Math.min(A[i], B[(i + 1) % M]);\n        }\n\n        Dinic dinic = new Dinic(2 * M + 2);\n        int s = 2 * M;\n        int t = 2 * M + 1;\n        for (int i = 0; i < M; i++) {\n            dinic.add_edge(s, i, N);\n            dinic.add_edge(M + i, t, B[i]);\n            dinic.add_edge(i, M + i, A[i]);\n            dinic.add_edge(i, M + (i - 1 + M) % M, A[i]);\n        }\n        int ans2 = N - (int) dinic.flow(s, t);\n\n        System.out.println(ans2 + \" \" + ans1);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015901254664640874, -1.9073468138230965e-06, -2.145764938177308e-06, -0.0005893162451684475, -4.649054244509898e-05, -0.6931507587432861, -0.6326348185539246, -0.00021479207498487085, -4.029192859889008e-05, -1.537788011773955e-05, -0.0048146978951990604, -8.022463589441031e-05, -1.1920922133867862e-06, -3.480850500636734e-05, -0.2254379391670227, -5.483612312673358e-06, -0.007113013882189989, -0.07296013087034