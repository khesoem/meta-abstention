{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\n#define rep(i, n) for (int i = 0; i < (n); i++)\n#define repr(i, n) for (int i = (n) - 1; i >= 0; i--)\n\nusing namespace std;\nusing ll = long long;\n\nstruct mincostflow {\n  struct edge {\n    int v;\n    long long c;\n    long long w;\n    int r;\n  };\n\n  vector<vector<edge>> G;\n\n  mincostflow(int n) : G(n) {}\n\n  void add(int u, int v, long long c, long long w) {\n    int i = G[u].size();\n    int j = G[v].size();\n    G[u].push_back({v, c, w, j});\n    G[v].push_back({u, 0, -w, i});\n  }\n\n  long long run(int s, int t, long long f) {\n    const int N = G.size();\n    long long res = 0;\n    vector<long long> H(N);\n    vector<long long> D(N);\n    const long long INF = 1e18;\n    vector<int> PE(N), PV(N);\n    while (f > 0) {\n      priority_queue<pair<long long, int>> q;\n      fill(D.begin(), D.end(), INF);\n      D[s] = 0;\n      q.emplace(0, s);\n      while (!q.empty()) {\n        long long d = -q.top().first;\n        int u = q.top().second;\n        q.pop();\n        if (D[u] < d) continue;\n        for (int i = 0; i < G[u].size(); i++) {\n          edge e = G[u][i];\n          if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n            q.emplace(-D[e.v], e.v);\n            PV[e.v] = u;\n            PE[e.v] = i;\n          }\n        }\n      }\n      if (D[t] == INF) return -1;\n      for (int i = 0; i < N; i++) H[i] += D[i];\n      long long d = f;\n      for (int i = t; i != s; i = PV[i]) {\n        d = min(d, G[PV[i]][PE[i]].c);\n      }\n      f -= d;\n      res += d * H[t];\n      for (int i = t; i != s; i = PV[i]) {\n        edge &e = G[PV[i]][PE[i]];\n        e.c -= d;\n        G[i][e.r].c += d;\n      }\n    }\n    return res;\n  }\n};\n\nint main() {\n  cin.tie(nullptr);\n  ios::sync_with_stdio(false);\n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  rep(i, K) cin >> A[i], A[i]--;\n  vector<int> us(M), vs(M);\n  rep(i, M) {\n    cin >> us[i] >> vs[i];\n    us[i]--;\n    vs[i]--;\n  }\n  mincostflow mcf(N*101+2);\n  int s = N*101;\n  int t = s + 1;\n  for (int i = 0; i < K; i++) {\n    mcf.add(s, A[i], 1, 0);\n  }\n  for (int i = 0; i <= 100; i++) {\n    mcf.add(N * i, t, K, C*i);\n  }\n  for (int i = 0; i < 100; i++) {\n    for (int j = 0; j < N; j++) {\n      mcf.add(i*N+j, (i+1)*N+j, K, 0);\n    }\n    for (int j = 0; j < M; j++) {\n      for (int k = 1; k <= K; k++) {\n        mcf.add(N*i + us[j], N*(i+1) + vs[j], 1, (2*k-1)*D);\n        mcf.add(N*i + vs[j], N*(i+1) + us[j], 1, (2*k-1)*D);\n      }\n    }\n  }\n  cout << mcf.run(s, t, K) << '\\n';\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MinCostFlow:\n    class Edge:\n        __slots__ = ('v', 'c', 'w', 'r')\n        def __init__(self, v, c, w, r):\n            self.v = v\n            self.c = c  # capacity\n            self.w = w  # cost per unit flow\n            self.r = r  # reverse edge index\n\n    def __init__(self, n):\n        self.N = n\n        self.G = [[] for _ in range(n)]\n\n    def add(self, u, v, c, w):\n        i = len(self.G[u])\n        j = len(self.G[v])\n        self.G[u].append(self.Edge(v, c, w, j))\n        self.G[v].append(self.Edge(u, 0, -w, i))\n\n    def run(self, s, t, f):\n        N = self.N\n        res = 0\n        H = [0] * N\n        INF = 10**18\n        while f > 0:\n            D = [INF] * N\n            D[s] = 0\n            PV = [-1] * N\n            PE = [-1] * N\n            pq = [(0, s)]\n            while pq:\n                d, u = heapq.heappop(pq)\n                if D[u] < d:\n                    continue\n                for i, e in enumerate(self.G[u]):\n                    if e.c > 0 and D[e.v] > D[u] + e.w + H[u] - H[e.v]:\n                        D[e.v] = D[u] + e.w + H[u] - H[e.v]\n                        heapq.heappush(pq, (D[e.v], e.v))\n                        PV[e.v] = u\n                        PE[e.v] = i\n            if D[t] == INF:\n                return -1\n            for i in range(N):\n                if D[i] < INF:\n                    H[i] += D[i]\n            d = f\n            v = t\n            while v != s:\n                u = PV[v]\n                e = self.G[u][PE[v]]\n                d = min(d, e.c)\n                v = u\n            f -= d\n            res += d * H[t]\n            v = t\n            while v != s:\n                u = PV[v]\n                e = self.G[u][PE[v]]\n                e.c -= d\n                rev = self.G[v][e.r]\n                rev.c += d\n                v = u\n        return res\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    A = [int(next(it)) - 1 for _ in range(K)]\n    us = [0] * M\n    vs = [0] * M\n    for i in range(M):\n        us[i] = int(next(it)) - 1\n        vs[i] = int(next(it)) - 1\n\n    mcf = MinCostFlow(N * 101 + 2)\n    s = N * 101\n    t = s + 1\n\n    for a in A:\n        mcf.add(s, a, 1, 0)\n\n    for i in range(101):\n        mcf.add(N * i, t, K, C * i)\n\n    for i in range(100):\n        for j in range(N):\n            mcf.add(i * N + j, (i + 1) * N + j, K, 0)\n        for j in range(M):\n            for k in range(1, K + 1):\n                cost = (2 * k - 1) * D\n                mcf.add(i * N + us[j], (i + 1) * N + vs[j], 1, cost)\n                mcf.add(i * N + vs[j], (i + 1) * N + us[j], 1, cost)\n\n    ans = mcf.run(s, t, K)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.5762147e-05, 0.0, -9.5367386e-07, -0.002490397, -0.005706567, -0.31342643, -0.0036490064, -0.011056939, -0.004244486, -0.1604732, -0.0156098185, -0.010037659, -2.7656173e-05, -2.264974e-06, -1.2159274e-05, -3.0994368e-06, -0.97667897, -0.0001333863, -1.9073468e-06, -8.344647e-07, -0.38688558, 0.0, -4.7683704e-07, -7.152555e-07, -3.3378547e-06, -0.015164797, -0.014166622, -3.5404533e-05, -1.1920928e-07, -0.00012480434, -7.152555e-07, -1.1920928e-07, 0.0, -1.1920928e-07, -2.3841855e-07, -4.577532e-05, -6.5086155e-05, -1.966934e-05, 0.0, -1.1920928e-07, 0.0, -1.1920928e-07, -1.1920928e-07, -1.1920928e-07, -1.6808368e-05, -0.0067242295, -1.03711545e-05, -1.1920928e-07, 0.0, -2.3841855e-07, -1.0490363e-05, -1.9073468e-06, -1.7881378e-06, -9.5367386e-07, 0.0, -1.9073468e-06, -6.198864e-06, -0.100203454, -2.622601e-06, 0.0, 0.0, 0.0, -1.6689287e-06, -3.2887216, 0.0, -0.0011399445, -0.0017445359, -1.1920928e-07, 0.0, -1.1920928e-07, 0.0, 0.0, -0.00011276563, -7.867782e-06, -0.014184487, -0.47570074, -0.0009117737, -0.8300306, -0.00045170117, 0.0, 0.0, 0.0, 0.0, -3.576278e-07, -0.00020370792, 0.0, -0.6978226, -0.00012420837, -0.00012921452, -0.007496559, -1.7404405e-05, -6.0437284e-05, -7.152555e-07, 0.0, -1.1920928e-07, -1.1920928e-07, 0.0, -1.2993728e-05