 0) {\n            ll tp = (P[x][ck][t - 1].first + g) * 2 - TT;\n            if (tp < 0) tp = -tp;\n            if (MM > tp) MM = tp;\n        }\n        return;\n    }\n    calc1(x - 1, y, g + (!ck ? A[x][y] : 0), ck);\n    calc1(x, y - 1, g + (ck ? B[x][y] : 0), ck);\n}\n\nll Res;\n\nvoid calc2(int x, int y, ll g, int ck) {\n    if (x + y == R + n) {\n        int t = lower_bound(Q[x][ck].begin(), Q[x][ck].end(), pll((TT + 1) / 2 - g, 0)) - Q[x][ck].begin();\n        if (t != (int)Q[x][ck].size() && Q[x][ck][t].second > 0) {\n            ll tp = (Q[x][ck][t].first + g) * 2 - TT;\n            if (tp < 0) tp = -tp;\n            if (MM == tp) Res += Q[x][ck][t].second;\n        }\n        if (t && Q[x][ck][t - 1].second > 0) {\n            ll tp = (Q[x][ck][t - 1].first + g) * 2 - TT;\n            if (tp < 0) tp = -tp;\n            if (MM == tp) Res += Q[x][ck][t - 1].second;\n        }\n        return;\n    }\n    if (p[x + y - 1] != 'B') calc2(x - 1, y, g + (!ck ? A[x][y] : 0), ck);\n    if (p[x + y - 1] != 'A') calc2(x, y - 1, g + (ck ? B[x][y] : 0), ck);\n}\n\nvoid make(vector<pll>& vec) {\n    if (vec.empty()) return;\n    sort(vec.begin(), vec.end());\n    int cnt = 0;\n    ll s = 0;\n    for (size_t i = 0; i < vec.size(); ++i) {\n        s += vec[i].second;\n        if (i + 1 == vec.size() || vec[i].first != vec[i + 1].first) {\n            vec[cnt++] = {vec[i].first, s};\n            s = 0;\n        }\n    }\n    vec.resize(cnt);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> R >> C;\n    cin >> p;\n    for (int i = 0; i <= 60; ++i) {\n        comb[i][0] = 1;\n        for (int j = 1; j <= i; ++j)\n            comb[i][j] = comb[i - 1][j - 1] + comb[i - 1][j];\n    }\n    n = R + C;\n    TT = comb[n * 2][R * 2];\n    for (int i = 0; i <= n; ++i) {\n        for (int j = 0; j <= n; ++j) {\n            if (i) A[i][j] = comb[i - 1][R - 1] * (comb[n * 2 - i][R] - comb[j][R]);\n            if (j) B[i][j] = comb[j - 1][R - 1] * (comb[n * 2 - j][R] - comb[i][R]);\n        }\n    }\n    CC[0][0] = 1;\n    for (int i = 0; i <= n; ++i) {\n        for (int j = 0; j <= n; ++j) {\n            if (i != n && p[i + j] != 'B') CC[i + 1][j] += CC[i][j];\n            if (j != n && p[i + j] != 'A') CC[i][j + 1] += CC[i][j];\n        }\n    }\n    for (int i = R; i <= n; ++i) {\n        if (p[i + R - 1] != 'B') put(R, i, A[R][i], comb[i + R - 1][R - 1], CC[R - 1][i], 0);\n        if (p[i + R - 1] != 'A') put(i, R, B[i][R], comb[i + R - 1][R - 1], CC[i][R - 1], 1);\n    }\n    for (int i = R; i <= n; ++i) {\n        for (int j = 0; j < 2; ++j) {\n            make(P[i][j]);\n            make(Q[i][j]);\n        }\n    }\n    MM = TT + 1;\n    calc1(n, n, 0, 0);\n    calc1(n, n, 0, 1);\n    calc2(n, n, 0, 0);\n    calc2(n, n, 0, 1);\n    cout << Res << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom bisect import bisect_left\n\nsys.setrecursionlimit(1000000)\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    R = int(data[0])\n    C = int(data[1])\n    p = data[2].strip()\n    n = R + C\n\n    # comb up to 60\n    comb = [[0] * 62 for _ in range(62)]\n    for i in range(61):\n        comb[i][0] = 1\n        for j in range(1, i + 1):\n            comb[i][j] = comb[i - 1][j - 1] + comb[i - 1][j]\n\n    TT = comb[2 * n][2 * R]\n\n    # A and B matrices\n    A = [[0] * (n + 1) for _ in range(n + 1)]\n    B = [[0] * (n + 1) for _ in range(n + 1)]\n    for i in range(n + 1):\n        for j in range(n + 1):\n            if i > 0:\n                A[i][j] = comb[i - 1][R - 1] * (comb[2 * n - i][R] - comb[j][R])\n            if j > 0:\n                B[i][j] = comb[j - 1][R - 1] * (comb[2 * n - j][R] - comb[i][R])\n\n    # CC DP\n    CC = [[0] * (n + 1) for _ in range(n + 1)]\n    CC[0][0] = 1\n    for i in range(n + 1):\n        for j in range(n + 1):\n            if i != n and p[i + j] != 'B':\n                CC[i + 1][j] += CC[i][j]\n            if j != n and p[i + j] != 'A':\n                CC[i][j + 1] += CC[i][j]\n\n    # P and Q arrays\n    P = [[[] for _ in range(2)] for _ in range(32)]\n    Q = [[[] for _ in range(2)] for _ in range(32)]\n\n    def put(x: int, y: int, g: int, c1: int, c2: int, ck: int) -> None:\n        if x + y == R + n:\n            P[x][ck].append((g, c1))\n            if c2:\n                Q[x][ck].append((g, c2))\n            return\n        # first branch: move in x direction\n        put(x + 1, y, g + (0 if ck else A[x + 1][y]), c1,\n            (0 if p[x + y] == 'B' else c2), ck)\n        # second branch: move in y direction\n        put(x, y + 1, g + (B[x][y + 1] if ck else 0), c1,\n            (0 if p[x + y] == 'A' else c2), ck)\n\n    # initial calls to put\n    for i in range(R, n + 1):\n        if p[i + R - 1] != 'B':\n            put(R, i, A[R][i], comb[i + R - 1][R - 1], CC[R - 1][i], 0)\n        if p[i + R - 1] != 'A':\n            put(i, R, B[i][R], comb[i + R - 1][R - 1], CC[i][R - 1], 1)\n\n    def make(vec):\n        if not vec:\n            return\n        vec.sort()\n        new_vec = []\n        i = 0\n        while i < len(vec):\n            cur = vec[i][0]\n            s = 0\n            while i < len(vec) and vec[i][0] == cur:\n                s += vec[i][1]\n                i += 1\n            new_vec.append((cur, s))\n        vec[:] = new_vec\n\n    for i in range(R, n + 1):\n        for j in range(2):\n            make(P[i][j])\n            make(Q[i][j])\n\n    MM = TT + 1\n    Res = 0\n\n    def calc1(x: int, y: int, g: int, ck: int) -> None:\n        nonlocal MM\n        if x + y == R + n:\n            if not P[x][ck]:\n                return\n            t = bisect_left(P[x][ck], ((TT + 1) // 2 - g, 0))\n            if t < len(P[x][ck]) and P[x][ck][t][1] > 0:\n                tp = (P[x][ck][t][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM > tp:\n                    MM = tp\n            if t > 0 and P[x][ck][t - 1][1] > 0:\n                tp = (P[x][ck][t - 1][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM > tp:\n                    MM = tp\n            return\n        calc1(x - 1, y, g + (0 if ck else A[x][y]), ck)\n        calc1(x, y - 1, g + (B[x][y] if ck else 0), ck)\n\n    def calc2(x: int, y: int, g: int, ck: int) -> None:\n        nonlocal Res, MM\n        if x + y == R + n:\n            t = bisect_left(Q[x][ck], ((TT + 1) // 2 - g, 0))\n            if t < len(Q[x][ck]) and Q[x][ck][t][1] > 0:\n                tp = (Q[x][ck][t][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM == tp:\n                    Res += Q[x][ck][t][1]\n            if t > 0 and Q[x][ck][t - 1][1] > 0:\n                tp = (Q[x][ck][t - 1][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM == tp:\n                    Res += Q[x][ck][t - 1][1]\n            return\n        if p[x + y - 1] != 'B':\n            calc2(x - 1, y, g + (0 if ck else A[x][y]), ck)\n        if p[x + y - 1] != 'A':\n            calc2(x, y - 1, g + (B[x][y] if ck else 0), ck)\n\n    calc1(n, n, 0, 0)\n    calc1(n, n, 0, 1)\n    calc2(n, n, 0, 0)\n    calc2(n, n, 0, 1)\n\n    print(Res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, -0.0012019798159599304, -0.00326825981028378, -1.1920928244535389e-07, -0.00012516192509792745, -0.3213506042957306, 0.0, -4.6491513785440475e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.01815745420753956, -0.002497175009921193, 0.0, -1.1920928244535389e-07, -2.0265558760002023e-06, 0.0, 0.0, -7.521823135903105e-05, -0.02324579656124115, -0.00013207517622504383, -0.00019214690837543458, -0.002514