; i <= K; ++i)\n        for (int j = 0; j <= K; ++j) {\n            int ni = (i == K) ? i : (i + shift) % K;\n            int nj = (j == K) ? j : (j + shift) % K;\n            result[ni][nj] = precomputed[depth][i][j];\n        }\n    return result;\n}\n\nint digit_sum_mod(i64 num, int base) {\n    int s = 0;\n    while (num > 0) {\n        s += num % base;\n        num /= base;\n    }\n    return s % base;\n}\n\nint main() {\n    i64 N;\n    int k;\n    scanf(\"%lld %d\", &N, &k);\n    K = k;\n\n    int num_digits = 0;\n    i64 temp = N;\n    while (temp > 0) {\n        temp /= k;\n        ++num_digits;\n    }\n\n    Matrix I = identity_matrix(k);\n    precomputed[0] = I;\n    for (int i = 0; i <= k; ++i)\n        precomputed[0][i][0] = 1;\n\n    for (int d = 1; d < num_digits; ++d) {\n        precomputed[d] = I;\n        for (int s = 0; s < k; ++s)\n            precomputed[d] = matrix_multiply(precomputed[d], build_shifted(d-1, s), k);\n    }\n\n    i64 current = 0;\n    i64 pwr = 1;\n    --num_digits;\n    for (int i = 0; i < num_digits; ++i)\n        pwr *= k;\n\n    Matrix final = I;\n    while (current < N) {\n        assert(num_digits >= 0);\n        while (current + pwr <= N) {\n            final = matrix_multiply(final, build_shifted(num_digits, digit_sum_mod(current, k)), k);\n            current += pwr;\n        }\n        pwr /= k;\n        --num_digits;\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= k; ++i)\n        ans = add_mod(ans, final[k][i]);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add_mod(x, y):\n    x += y\n    return x - MOD if x >= MOD else x\n\ndef mul_mod(x, y):\n    return int((x * y) % MOD)\n\nMAX_SIZE = 32\nMAX_DEPTH = 64\nMAX_K = 32\n\nclass Matrix:\n    def __init__(self, dim=0):\n        self.m = [[0] * (dim + 1) for _ in range(dim + 1)]\n    \n    def __getitem__(self, idx):\n        return self.m[idx]\n\ndef identity_matrix(dim):\n    res = Matrix(dim)\n    for i in range(dim + 1):\n        res.m[i][i] = 1\n    return res\n\ndef matrix_multiply(A, B, dim):\n    C = Matrix(dim)\n    for i in range(dim + 1):\n        for j in range(dim + 1):\n            for k in range(dim + 1):\n                C.m[i][j] = add_mod(C.m[i][j], mul_mod(A.m[i][k], B.m[k][j]))\n    return C\n\ndef build_shifted(precomputed, depth, shift, K):\n    result = Matrix(K)\n    for i in range(K + 1):\n        for j in range(K + 1):\n            ni = i if i == K else (i + shift) % K\n            nj = j if j == K else (j + shift) % K\n            result.m[ni][nj] = precomputed[depth].m[i][j]\n    return result\n\ndef digit_sum_mod(num, base):\n    s = 0\n    while num > 0:\n        s += num % base\n        num //= base\n    return s % base\n\ndef main():\n    data = sys.stdin.readline().split()\n    N = int(data[0])\n    k = int(data[1])\n    \n    num_digits = 0\n    temp = N\n    while temp > 0:\n        temp //= k\n        num_digits += 1\n    \n    I = identity_matrix(k)\n    precomputed = [None] * MAX_DEPTH\n    precomputed[0] = I\n    for i in range(k + 1):\n        precomputed[0].m[i][0] = 1\n    \n    for d in range(1, num_digits):\n        precomputed[d] = I\n        for s in range(k):\n            precomputed[d] = matrix_multiply(precomputed[d], build_shifted(precomputed, d-1, s, k), k)\n    \n    current = 0\n    pwr = 1\n    num_digits -= 1\n    for i in range(num_digits):\n        pwr *= k\n    \n    final = I\n    while current < N:\n        assert num_digits >= 0)\n        while current + pwr <= N:\n            final = matrix_multiply(final, build_shifted(precomputed, num_digits, digit_sum_mod(current, k), k), k)\n            current += pwr\n        pwr //= k\n        num_digits -= 1\n    \n    ans = 0\n    for i in range(k + 1):\n        ans = add_mod(ans, final.m[k][i])\n    print(ans)\n\nif __name__