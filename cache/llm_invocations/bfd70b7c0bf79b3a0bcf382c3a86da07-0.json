[idx ^ 1][2] -= pushed\n                    return pushed\n            i += 1\n            self.ptr[u] = i\n        return 0\n\n    def maxflow(self):\n        flow = 0\n        INF_FLOW = 10**18\n        while self.bfs():\n            self.ptr = [0] * self.n\n            while True:\n                pushed = self.dfs(self.s, INF_FLOW)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\n\ndef valid(r, c, n, m):\n    return 0 <= r < n and 0 <= c < m\n\n\ndef idOf(x, y, m):\n    return 1 + m * x + y\n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    deadline = int(next(it))\n    deadline += 1\n    m = n\n\n    sci = [list(next(it).strip()) for _ in range(n)]\n    rea = [list(next(it).strip()) for _ in range(n)]\n\n    danger = [[INF] * m for _ in range(n)]\n    q0 = deque()\n    for i in range(n):\n        for j in range(m):\n            if rea[i][j] == 'Z':\n                q0.append((i, j))\n                danger[i][j] = 1\n\n    while q0:\n        x, y = q0.popleft()\n        for dx in (-1, 0, 1):\n            for dy in (-1, 0, 1):\n                if abs(dx) + abs(dy) != 1:\n                    continue\n                nx, ny = x + dx, y + dy\n                if valid(nx, ny, n, m) and danger[nx][ny] == INF and sci[nx][ny] != 'Y':\n                    danger[nx][ny] = danger[x][y] + 1\n                    q0.append((nx, ny))\n\n    src = 0\n    snk = n * n + n * n + 1\n    flow = Dinic(n * n * 2 + 2, src, snk)\n\n    for x in range(n):\n        for y in range(m):\n            if '1' <= sci[x][y] <= '9':\n                flow.addEdge(src, idOf(x, y, m), ord(sci[x][y]) - ord('0'))\n            if '1' <= rea[x][y] <= '9':\n                flow.addEdge(n * n + idOf(x, y, m), snk, ord(rea[x][y]) - ord('0'))\n\n    for x in range(n):\n        for y in range(m):\n            if sci[x][y] == 'Y' or sci[x][y] == 'Z':\n                continue\n            for X in range(n):\n                for Y in range(m):\n                    if rea[X][Y] == 'Y' or rea[X][Y] == 'Z':\n                        continue\n                    seen = [[False] * m for _ in range(n)]\n                    q1 = deque()\n                    q1.append(((x, y), 1))\n                    seen[x][y] = True\n                    reachable = False\n                    while q1:\n                        (cx, cy), tim = q1.popleft()\n                        if cx == X and cy == Y:\n                            reachable = True\n                            break\n                        if tim >= danger[cx][cy] or tim >= deadline:\n                            continue\n                        for dx in (-1, 0, 1):\n                            for dy in (-1, 0, 1):\n                                if abs(dx) + abs(dy) != 1:\n                                    continue\n                                nx, ny = cx + dx, cy + dy\n                                if valid(nx, ny, n, m) and not seen[nx][ny] and \\\n                                   sci[nx][ny] != 'Y' and sci[nx][ny] != 'Z' and \\\n                                   tim + 1 <= danger[nx][ny]:\n                                    seen[nx][ny] = True\n                                    q1.append(((nx, ny), tim + 1))\n                    if reachable:\n                        flow.addEdge(idOf(x, y, m), n * n + idOf(X, Y, m), INF)\n\n    print(flow.maxflow())\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.8412379075889476e-06, 0.0, 0.0, -0.00010430268594063818, -0.00010871296399272978, 0.0, -3.099436753473128e-06, -2.50339189733495e-06, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -0.0005901502445340157, -0.01942305453121662, -0.0014812698354944587, -1.4185804502631072e-05, -0.20143623650074005, -0.06197310611605644, -0.10282395035028458, -0.018157921731472015, -0.0111511349678