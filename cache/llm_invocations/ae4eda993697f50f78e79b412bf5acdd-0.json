{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\n#define DEBUG 0\ntypedef long long ll;\ntypedef pair<int,int> pii;\ntypedef pair<ll,ll> pll;\n#define fore(i,ii,iii) for(int i=ii;i<iii;i++)\n#define pb push_back\n#define SZ(a) ((int)(a).size())\n#define mset(a,b) memset(a,b,sizeof(a));\n#define ALL(a) a.begin(),a.end()\n#define fst first\n#define snd second\n\nconst int MAXN=50*100+15;\nint SRC = MAXN-1;\nint SNC = MAXN-2;\n\ntypedef ll tf; const tf INFFLUJO=1e14;\ntypedef ll tc; const tc INFCOSTO=1e14;\nstruct edge {\n    int u,v; tf cap,flow; tc cost;\n    tf rem(){return cap-flow;}\n};\nint nodes=MAXN;\nvector<int> g[MAXN];\nvector<edge> e;\nvoid add_edge(int u, int v, tf cap, tc cost) {\n    if(DEBUG) {\n        string dem=to_string(u),pen=to_string(v);\n        if(u==SRC)dem=\"SRC\";\n        if(u==SNC)dem=\"SINC\";\n        if(v==SRC)pen=\"SRC\";\n        if(v==SNC)pen=\"SINC\";\n        cout<<\"add edge: \"<<dem<<\" \"<<pen<<\" \"<<cap<<\" \"<<cost<<endl;\n    }\n    g[u].pb(SZ(e)); e.pb((edge){u,v,cap,0,cost});\n    g[v].pb(SZ(e)); e.pb((edge){v,u,0,0,-cost});\n}\n\ntc dist[MAXN], mncost, pot[MAXN];\nint pre[MAXN];\ntf cap[MAXN], mxflow;\nbool in_queue[MAXN];\n\nvoid flow(int s, int t) {\n    mxflow = mncost = 0;\n    fill(pot, pot+nodes, 0);\n    while(1) {\n        fill(dist, dist+nodes, INFCOSTO); dist[s] = 0;\n        mset(pre, -1); pre[s] = 0;\n        mset(cap, 0); cap[s] = INFFLUJO;\n        priority_queue<pair<tc,int>, vector<pair<tc,int>>, greater<pair<tc,int>>> pq;\n        pq.push({0, s});\n        while(!pq.empty()) {\n            auto [d, u] = pq.top(); pq.pop();\n            if(d != dist[u]) continue;\n            for(int idx : g[u]) {\n                edge &E = e[idx];\n                if(E.rem() == 0) continue;\n                tc nd = dist[u] + E.cost + pot[u] - pot[E.v];\n                if(nd < dist[E.v] - 1e-9) {\n                    dist[E.v] = nd;\n                    pre[E.v] = idx;\n                    cap[E.v] = min(cap[u], E.rem());\n                    pq.push({nd, E.v});\n                }\n            }\n        }\n        if(pre[t] < 0) break;\n        for(int v = t; v != s; v = e[pre[v]].u) {\n            e[pre[v]].flow += cap[t];\n            e[pre[v]^1].flow -= cap[t];\n        }\n        mxflow += cap[t];\n        mncost += cap[t] * (dist[t] + pot[t] - pot[s]);\n        fore(i,0,nodes) if(dist[i] < INFCOSTO) pot[i] += dist[i];\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    ll n,m,k,c,d;\n    cin>>n>>m>>k>>c>>d;\n    int MAXT = n + k;\n    if(DEBUG) cout<<\"MAXT: \"<<MAXT<<endl;\n    vector<int> a(k);\n    fore(i,0,k) {\n        cin>>a[i]; a[i]--;\n        add_edge(SRC, a[i]*MAXT, 1, 0);\n    }\n    fore(j,0,MAXT) add_edge(j, SNC, k, 0);\n    fore(i,0,m) {\n        int x,y; cin>>x>>y; x--,y--;\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(x*MAXT+j, y*MAXT+j+1, 1, c + d*(2*K-1));\n        }\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(y*MAXT+j, x*MAXT+j+1, 1, c + d*(2*K-1));\n        }\n    }\n    fore(i,0,n) {\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(i*MAXT+j, i*MAXT+j+1, 1, c);\n        }\n    }\n    flow(SRC, SNC);\n    if(DEBUG) cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n    cout<<mncost<<endl;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nDEBUG = 0\n\n# Constants (will be adjusted based on input)\nMAXN = 50 * 100 + 15  # original constant, but we will compute actual nodes\nSRC = MAXN - 1\nSNC = MAXN - 2\n\nINFFLOW = 10**14\nINFCOST = 10**14\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    MAXT = n + k\n    if DEBUG:\n        print(\"MAXT:\", MAXT)\n\n    # Compute maximum node index needed\n    max_node = max(n * MAXT - 1, SRC, SNC)\n    nodes = max_node + 1\n\n    # Initialize graph and edges\n    g = [[] for _ in range(nodes)]\n    e = []  # list of edges: [u, v, cap, flow, cost]\n\n    def add_edge(u, v, cap, cost):\n        if DEBUG:\n            dem = str(u)\n            pen = str(v)\n            if u == SRC:\n                dem = \"SRC\"\n            if u == SNC:\n                dem = \"SINC\"\n            if v == SRC:\n                pen = \"SRC\"\n            if v == SNC:\n                pen = \"SINC\"\n            print(\"add edge:\", dem, pen, cap, cost)\n        g[u].append(len(e))\n        e.append([u, v, cap, 0, cost])\n        g[v].append(len(e))\n        e.append([v, u, 0, 0, -cost])\n\n    # Read starting positions\n    a = [int(next(it)) - 1 for _ in range(k)]\n\n    # Source to starting positions\n    for i in range(k):\n        add_edge(SRC, a[i] * MAXT, 1, 0)\n\n    # Each time step to sink\n    for j in range(MAXT):\n        add_edge(j, SNC, k, 0)\n\n    # Read edges and add time-expanded edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1))\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1))\n\n    # Stay edges (waiting)\n    for i in range(n):\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c)\n\n    # Min-cost max-flow\n    dist = [INFCOST] * nodes\n    pot = [0] * nodes\n    pre = [-1] * nodes\n    cap = [0] * nodes\n    in_queue = [False] * nodes  # not used\n\n    mxflow = 0\n    mncost = 0\n\n    while True:\n        # Reset for this iteration\n        for i in range(nodes):\n            dist[i] = INFCOST\n            pre[i] = -1\n            cap[i] = 0\n        dist[SRC] = 0\n        pre[SRC] = 0\n        cap[SRC] = INFFLOW\n\n        pq = [(0, SRC)]\n        while pq:\n            d, u = heapq.heappop(pq)\n            if d != dist[u]:\n                continue\n            for idx in g[u]:\n                edge = e[idx]\n                if edge[2] - edge[3] == 0:  # rem() == 0\n                    continue\n                nd = dist[u] + edge[4] + pot[u] - pot[edge[1]]\n                if nd < dist[edge[1]] - 1e-9:\n                    dist[edge[1]] = nd\n                    pre[edge[1]] = idx\n                    cap[edge[1]] = min(cap[u], edge[2] - edge[3])\n                    heapq.heappush(pq, (nd, edge[1]))\n\n        if pre[SNC] < 0:\n            break\n\n        # Augment flow\n        v = SNC\n        while v != SRC:\n            idx = pre[v]\n            e[idx][3] += cap[SNC]  # flow\n            e[idx ^ 1][3] -= cap[SNC]\n            v = e[idx][0]  # u\n\n        mxflow += cap[SNC]\n        mncost += cap[SNC] * (dist[SNC] + pot[SNC] - pot[SRC])\n\n        for i in range(nodes):\n            if dist[i] < INFCOST:\n                pot[i] += dist[i]\n\n    if DEBUG:\n        print(\"mncost:\", mncost, \"mxflow:\", mxflow)\n    print(mncost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012766500003635883, 0.0, 0.0, -0.00024959311122074723, -0.002581717912107706, -0.004095263313502073, -0.014199061319231987, -0.002476840978488326, -0.011060829274356365, -0.12697844207286835, -0.7037502527236938, -1.311301275563892e-06, -0.25197869539260864, -1.3589766240329482e-05, -0.3067644536495209, -0.44849199056625366, -0.0792037844657898, -0.6783456206321716, -0.5902522802352905, -0.003368539037182927, -0.10648366808891296, -0.33753883838653564, -1.1920928244535389e-07, -0.002344123786315322, -0.0010440857149660587, -0.055730752646923065, -0.0057265982031822205, -0.25598180294036865, -1.764281842042692e-05, -0.019185451790690422, -0.004079116974025965, 0.0, -1.0728830375228426e-06, -2.3841855067985307e-07, 0.0, -2.9802276912960224e-06, -0.5777631402015686, -1.1920928244535389e-07, -0.5860102772712708, -0.35700544714927673, -0.025994088500738144, -0.04090617969632149, -0.009007060900330544, -0.4858150780200958, -0.4940159320831299, -0.021371200680732727, -0.9214567542076111, -0.894788920879364, -0.007071703672409058, -3.576278118089249e-07, -0.002086011925712228, -0.002512038918212056, 0.0, -1.311301275563892e-06, -3.576278118089249e-07, -1.6689286894688848e-06, -0.0006675875629298389, -3.576278118089249e-07, -4.172316494077677e-06, -2.3841855067985307e-07, -6.9141146923357155e-06, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -2.0265558760002023e-06, -0.10022329539060593, -0.581660807132721, -4.2199197196168825e-05, -0.4746119976043701, -0.00033361115492880344, -1.1920928244535389e-07, -4.589452510117553e-05, -5.864924969500862e-05, -0.06196828559041023, -0.003013951936736703, -0.00021550717065110803, -0.00026174934464506805, -5.006777428206988e-06, 0.0, -8.3446468579495