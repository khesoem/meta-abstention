]==-1) return flow;\n\t\tint y=x;x=prex[y];int i=prei[y],j=rev[x][i];\n\t\tint f=dfs(x,min(flow,cap[x][i]));\n\t\tcap[x][i]-=f,cap[y][j]+=f;\n\t\treturn f;\n\t}\n\t\n\tpii solve(int s,int t)\n\t{\n\t\tint ans=0;tot=0;\n\t\twhile(1)\n\t\t{\n\t\t\tspfa(s);\n\t\t\tif(dist[t]>1e9) break;\n\t\t\tint f=dfs(t,inf);\n\t\t\ttot+=f*dist[t];\n\t\t\tans+=f;\n\t\t}\n\t\treturn mp(ans,tot);\n\t}\n\t\n};\n\n\nint n,m,s=nn-1,t=nn-2;\nint k,c,d;\nint get(int x,int tim){\n\treturn tim*52-52+x;\n}\nint main() \n{\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);int kk=k;\n\twhile(k--){\n\t\tint x;scanf(\"%d\",&x);\n\t\tmcmf::add_edge(s,get(x,1),1,0);\n\t}k=kk;\n\twhile(m--){\n\t\tint x,y;scanf(\"%d%d\",&x,&y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t\t\n\t\tswap(x,y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t}\n\tfor(int i=1;i<100;i++){\n\t\tfor(int j=1;j<=n;j++) mcmf::add_edge(get(j,i),get(j,i+1),inf,0);\n\t\tmcmf::add_edge(get(1,i),t,inf,c*(i-1));\n\t}\n\t\n\tprintf(\"%d\",mcmf::solve(s,t).second);\n\t\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int NN = 6000;\n    static final int INF = 100000000;\n    static class MCMF {\n        List<Integer>[] v = new ArrayList[NN];\n        List<Integer>[] rev = new ArrayList[NN];\n        List<Integer>[] cost = new ArrayList[NN];\n        List<Integer>[] cap = new ArrayList[NN];\n\n        public MCMF() {\n            for (int i = 0; i < NN; i++) {\n                v[i] = new ArrayList<>();\n                rev[i] = new ArrayList<>();\n                cost[i] = new ArrayList<>();\n                cap[i] = new ArrayList<>();\n            }\n        }\n\n        void addEdge(int x, int y, int c, int w) {\n            rev[x].add(v[y].size());\n            rev[y].add(v[x].size());\n            v[x].add(y);\n            v[y].add(x);\n            cost[x].add(w);\n            cost[y].add(-w);\n            cap[x].add(c);\n            cap[y].add(0);\n        }\n\n        int[] dist = new int[NN];\n        int[] vis = new int[NN];\n        int[] prex = new int[NN];\n        int[] prei = new int[NN];\n\n        void spfa(int s) {\n            Arrays.fill(dist, 0x3f3f3f3f);\n            Arrays.fill(vis, 0);\n            prex[s] = -1;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            dist[s] = 0;\n            vis[s] = 1;\n\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                vis[x] = 0;\n                for (int i = 0; i < v[x].size(); i++) {\n                    int y = v[x].get(i);\n                    int cc = dist[x] + cost[x].get(i);\n                    if (dist[y] > cc && cap[x].get(i) > 0) {\n                        dist[y] = cc;\n                        prex[y] = x;\n                        prei[y] = i;\n                        if (vis[y] == 0) {\n                            vis[y] = 1;\n                            q.offer(y);\n                        }\n                    }\n                }\n            }\n        }\n\n        int tot = 0;\n\n        int dfs(int x, int flow) {\n            if (prex[x] == -1) return flow;\n            int y = x;\n            x = prex[y];\n            int i = prei[y];\n            int j = rev[x].get(i);\n            int f = dfs(x, Math.min(flow, cap[x].get(i)));\n            cap[x].set(i, cap[x].get(i) - f);\n            cap[y].set(j, cap[y].get(j) + f);\n            return f;\n        }\n\n        Pair<Integer, Integer> solve(int s, int t) {\n            int ans = 0;\n            tot = 0;\n            while (true) {\n                spfa(s);\n                if (dist[t] > 1000000000) break;\n                int f = dfs(t, INF);\n                tot += f * dist[t];\n                ans += f;\n            }\n            return new Pair<>(ans, tot);\n        }\n    }\n\n    static class Pair<A, B> {\n        public A first;\n        public B second;\n\n        public Pair(A a, B b) {\n            this.first = a;\n            this.second = b;\n        }\n    }\n\n    static int n, m, s = NN - 1, t = NN - 2;\n    static int k, c, d;\n\n    static int get(int x, int time) {\n        return time * 52 - 52 + x;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        MCMF graph = new MCMF();\n\n        int kk = k;\n        for (int i = 0; i < kk; i++) {\n            int x = sc.nextInt();\n            graph.addEdge(s, get(x, 1), 1, 0);\n        }\n        k = kk;\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                for (int l = 1; l <= k; l++) {\n                    graph.addEdge(get(x, j), get(y, j + 1), 1, d * (l + l - 1));\n                }\n            }\n            // swap x and y\n            int temp = x;\n            x = y;\n            y = temp;\n            for (int j = 1; j < 100; j++) {\n                for (int l = 1; l <= k; l++) {\n                    graph.addEdge(get(x, j), get(y, j + 1), 1, d * (l + l - 1));\n                }\n            }\n        }\n\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= n; j++) {\n                graph.addEdge(get(j, i), get(j, i + 1), INF, 0);\n            }\n            graph.addEdge(get(1, i), t, INF, c * (i - 1));\n        }\n\n        System.out.println(graph.solve(s, t).second);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.02403915673494339, -0.0006027150084264576, -1.7432603272027336e-06, -0.0002215