*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        int half = n / 2;\n        List<Integer> leftSums = new ArrayList<>();\n        List<Integer> rightSums = new ArrayList<>();\n\n        collectLeft(a, half, 0, 0, leftSums);\n        collectRight(a, n, half, 0, rightSums);\n\n        // Remove duplicates and sort leftSums\n        Set<Integer> leftSet = new HashSet<>(leftSums);\n        List<Integer> leftList = new ArrayList<>(leftSet);\n        Collections.sort(leftList);\n\n        int maxSum = 0;\n        int leftLen = leftList.size();\n\n        for (int r : rightSums) {\n            int needed = m - r;\n            int pos = Collections.binarySearch(leftList, needed);\n            if (pos < 0) {\n                pos = -pos - 1;\n            }\n            if (pos > 0) {\n                int candidate = leftList.get(pos - 1) + r;\n                if (candidate > maxSum) {\n                    maxSum = candidate;\n                }\n            }\n        }\n\n        System.out.println(maxSum);\n    }\n\n    private static void collectLeft(int[] a, int half, int idx, int total, List<Integer> leftSums) {\n        if (idx == half) {\n            leftSums.add(total);\n        } else {\n            collectLeft(a, half, idx + 1, (total + a[idx]) % a.length, leftSums);\n            collectLeft(a, half, idx + 1, total, leftSums);\n        }\n    }\n\n    private static void collectRight(int[] a, int n, int idx, int total, List<Integer> rightSums) {\n        if (idx == n) {\n            rightSums.add(total);\n        } else {\n            collectRight(a, n, idx + 1, (total + a[idx]) % a.length, rightSums);\n            collectRight(a, n, idx + 1, total, rightSums);\n        }\n    }\n}\n</translated_code>\n<confidence>\