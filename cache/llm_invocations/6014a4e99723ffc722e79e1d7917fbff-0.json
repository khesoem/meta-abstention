sponse": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[20];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n        \n        List<Integer> leftSums = new ArrayList<>();\n        int leftSize = n / 2 + n % 2;\n        for (int mask = 0; mask < (1 << leftSize); mask++) {\n            int total = 0;\n            int temp = mask;\n            for (int idx = 0; idx < 20; idx++) {\n                if ((temp & 1) == 1) {\n                    total += a[idx];\n                }\n                temp >>= 1;\n            }\n            leftSums.add(total % m);\n        }\n        Collections.sort(leftSums);\n        \n        int result = 0;\n        int rightSize = n / 2;\n        for (int mask = 0; mask < (1 << rightSize); mask++) {\n            int total = 0;\n            int temp = mask;\n            for (int idx = 0; idx < 20; idx++) {\n                if ((temp & 1) == 1) {\n                    total += a[leftSize + idx];\n                }\n                temp >>= 1;\n            }\n            total %= m;\n            \n            int complement = m - total - 1;\n            int pos = binarySearchLeftmost(leftSums, complement);\n            int candidate = leftSums.get(leftSums.size() - 1);\n            \n            if (pos < leftSums.size()) {\n                if (leftSums.get(pos) > complement) {\n                    if (pos > 0) {\n                        candidate = leftSums.get(pos - 1);\n                    }\n                } else {\n                    candidate = leftSums.get(pos);\n                }\n            }\n            \n            int val1 = (total + candidate) % m;\n            int val2 = (total + leftSums.get(leftSums.size() - 1)) % m;\n            result = Math.max(result, Math.max(val1, val2));\n        }\n        \n        System.out.println(result % m);\n    }\n    \n    private static int binarySearchLeftmost(List<Integer> list, int target) {\n        int left = 0;\n        int right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) >= target) {\n                right = mid;\n            } else {\n                left = mid + 1;\n            }\n        }\n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001934579631779343, -2.264974000354414e-06, -1.5497195136049413e-06, -0.000673424918204546, -2.634490556374658e-05, -0.002476246329024434, -0.0951424241065979, -4.768360213347478e-06, -1.311301275563892e-06, -0.0001174142598756589, -4.6491513785440475e-06, -8.344646857949556e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -3.933898824470816e-06, -1.5497195136049413e-06, -1.311301275563892e-06, -1.1920928244535389e-07, -7.974783511599526e-05, -1.1920922133867862e-06, -3.576278118089249e-07, -1.7881377516459906e-06, -4.684815212385729e-05, -0.35036978125572205, -1.5497195136049413e-06, -3.576278118089249e-07, -1.3828182090946939e-05, -5.125986263010418e-06, -1.4305104514278355e-06, -1.3947389561508317e-05, -0.0009137984015978873, -0.00010966652916977182, 0.0, -1.1920928244535389e-07, -1.6689286894688848e-06, -2.622600959512056e-06, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.629365427419543e-06, -1.1920922133867862e-06, -2.861018856492592e-06, -2.264974000354414e-06, -0.016034699976444244, -2.0146166207268834e-05, -1.0728830375228426e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.5497195136049413e-06, 0.0, -0.1902305781841278, -1.5139465176616795e-05, -3.659658250398934e-05, -0.0015051951631903648, -7.450303382938728e-05, -4.768370445162873e-07, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, 0.0, 0.0, 0.0, -3.814689989667386e-06, -2