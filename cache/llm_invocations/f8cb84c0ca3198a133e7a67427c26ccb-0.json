reater<pair<ll, int>>> pq;\n            distance[source] = 0;\n            pq.emplace(0, source);\n\n            while (!pq.empty()) {\n                auto [d, u] = pq.top();\n                pq.pop();\n                if (d != distance[u]) continue;\n                for (int idx = 0; idx < graph[u].size(); ++idx) {\n                    auto& e = graph[u][idx];\n                    if (e.cap > 0 && distance[e.to] > distance[u] + e.cost + potential[u] - potential[e.to]) {\n                        distance[e.to] = distance[u] + e.cost + potential[u] - potential[e.to];\n                        previous_node[e.to] = u;\n                        previous_edge_index[e.to] = idx;\n                        pq.emplace(distance[e.to], e.to);\n                    }\n                }\n            }\n\n            if (distance[sink] == numeric_limits<ll>::max()) return -1;\n            for (int i = 0; i < node_count; ++i) {\n                potential[i] += distance[i];\n            }\n\n            ll flow = required_flow;\n            for (int v = sink; v != source; v = previous_node[v]) {\n                flow = min(flow, graph[previous_node[v]][previous_edge_index[v]].cap);\n            }\n\n            required_flow -= flow;\n            total_cost += flow * potential[sink];\n\n            for (int v = sink; v != source; v = previous_node[v]) {\n                auto& e = graph[previous_node[v]][previous_edge_index[v]];\n                e.cap -= flow;\n                graph[v][e.rev].cap += flow;\n            }\n        }\n        return total_cost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    ll N, M, K, C, D;\n    cin >> N >> M >> K >> C >> D;\n\n    vector<int> A(K);\n    for (int i = 0; i < K; ++i) {\n        cin >> A[i];\n        --A[i];\n    }\n\n    vector<int> U(M), V(M);\n    for (int i = 0; i < M; ++i) {\n        cin >> U[i] >> V[i];\n        --U[i];\n        --V[i];\n    }\n\n    MinCostFlowSolver mcf(N * 101 + 2);\n   