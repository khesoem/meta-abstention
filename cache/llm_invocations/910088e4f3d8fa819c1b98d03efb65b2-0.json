nt(m);\n            if (((m | (m << 1) | (m >> 1)) & (maskLimit - 1)) == (maskLimit - 1)) {\n                memo[0][m][0] = popCount[m];\n            }\n        }\n        int best = Integer.MAX_VALUE;\n        for (int r = 0; r < rows - 1; r++) {\n            for (int m1 = 0; m1 < maskLimit; m1++) {\n                for (int m2 = 0; m2 < maskLimit; m2++) {\n                    if (memo[r][m1][m2] == -1) continue;\n                    for (int m3 = 0; m3 < maskLimit; m3++) {\n                        if (((m1 | (m1 << 1) | (m1 >> 1) | m2 | m3) & (maskLimit - 1)) == (maskLimit - 1)) {\n                            int candidate = memo[r][m1][m2] + popCount[m3];\n                            if (memo[r + 1][m3][m1] == -1 || memo[r + 1][m3][m1] > candidate) {\n                                memo[r + 1][m3][m1] = candidate;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n        for (int m1 = 0; m1 < maskLimit; m1++) {\n            for (int m2 = 0; m2 < maskLimit; m2++) {\n                if (memo[rows - 1][m1][m2] != -1 &&\n                    (((m1 | (m1 << 1) | (m1 >> 1) | m2) & (maskLimit - 1)) == (maskLimit - 1))) {\n                    best = Math.min(best, memo[rows - 1][m1][m2]);\n                }\n            }\n        }\n        pw.println((rows * cols) - best);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    private static final boolean DEBUG = false;\n    private static BufferedReader br;\n    private static StringTokenizer tokenizer;\n    private static PrintWriter pw;\n\n    private static String nextToken() {\n        while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n            try {\n                tokenizer = new StringTokenizer(br.readLine());\n            } catch (IOException e) {\n                e.printStackTrace();\n                return \"\";\n            }\n        }\n        return tokenizer.nextToken();\n    }\n\n    private static int nextInt() {\n        return Integer.parseInt(nextToken());\n    }\n\n    private static long nextLong() {\n        return Long.parseLong(nextToken());\n    }\n\n    private static double nextDouble() {\n        return Double.parseDouble(nextToken());\n    }\n\n    private static String nextLine() {\n        try {\n            return br.readLine();\n        } catch (IOException e) {\n            e.printStackTrace();\n            return \"\";\n        }\n    }\n\n    private static int debugCounter = 0;\n\n    private static void log(String s) {\n        if (DEBUG && debugCounter < 200) {\n            pw.println(s);\n            pw.flush();\n            debugCounter++;\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        br = new BufferedReader(new InputStreamReader(System.in));\n        pw = new PrintWriter(new BufferedWriter(new OutputStreamWriter(System.out)));\n        new Main().solve();\n        pw.close();\n    }\n\n    int rows, cols;\n    int maskLimit;\n    int[] popCount;\n    int[][][] memo;\n\n    void solve() {\n        rows = nextInt();\n        cols = nextInt();\n        \n        // For 1x1 grid, answer is 0\n        if (rows == 1 && cols == 1) {\n            pw.println(0);\n            return;\n        }\n        \n        // Make sure rows >= cols for optimization\n        if (rows < cols) {\n            int tmp = rows;\n            rows = cols;\n            cols = tmp;\n        }\n        \n        maskLimit = 1 << cols;\n        popCount = new int[maskLimit];\n        memo = new int[rows][maskLimit][maskLimit];\n        \n        // Initialize memo with -1\n        for (int[][] layer : memo) {\n            for (int[] row : layer) {\n                Arrays.fill(row, -1);\n            }\n        }\n        \n        // Precompute popcount\n        for (int m = 0; m < maskLimit; m++) {\n            popCount[m] = Integer.bitCount(m);\n        }\n        \n        // Initialize first row\n        for (int m = 0; m < maskLimit; m++) {\n            // Check if mask m covers all columns in row 0\n            if (covers(m, 0, cols)) {\n                memo[0][m][0] = popCount[m];\n            }\n        }\n        \n        // Fill DP table\n        for (int r = 0; r < rows - 1; r++) {\n            for (int m1 = 0; m1 < maskLimit; m1++) {\n                for (int m2 = 0; m2 < maskLimit; m2++) {\n                    if (memo[r][m1][m2] == -1) continue;\n                    \n                    for (int m3 = 0; m3 < maskLimit; m3++) {\n                        // Check if m1, m2, m3 together cover all columns at row r+1\n                        if (covers(m1, m2, m3, cols)) {\n                            int candidate = memo[r][m1][m2] + popCount[m3];\n                            if (memo[r+1][m3][m1] == -1 || memo[r+1][m3][m1] > candidate) {\n                                memo[r+1][m3][m1] = candidate;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n        \n        // Find minimum among valid final states\n        int best = Integer.MAX_VALUE;\n        for (int m1 = 0; m1 < maskLimit; m1++) {\n            for (int m2 = 0; m2 < maskLimit; m2++) {\n                if (memo[rows-1][m1][m2] != -1 && covers(m1, m2, cols)) {\n                    best = Math.min(best, memo[rows-1][m1][m2]);\n                }\n            }\n        }\n        \n        pw.println((long)rows * cols - best);\n    }\n    \n    // Check if a single mask covers all columns\n    private boolean covers(int mask, int row, int cols) {\n        return ((mask | (mask << 1) | (mask >> 1)) & ((1 << cols) - 1)) == ((1 << cols) - 1);\n    }\n    \n    // Check if three masks (m1, m2, m3) cover all columns at current row\n    private boolean covers(int m1, int m2, int m3, int cols) {\n        int covered = (m1 | (m1 << 1) | (m1 >> 1) | m2 | m3) & ((1 << cols) - 1);\n        return covered == ((1 << cols) - 1);\n    }\n    \n    // Check if two masks cover all columns (for final row)\n    private boolean covers(int m1, int m2, int cols) {\n        int covered = (m1 | (m1 << 1) | (m1 >> 1) | m2) & ((1 << cols) - 1);\n        return covered == ((1 << cols) - 1);\n    }\n}\n</repaired_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -3.981510963058099e-05, -2.264974000354414e-06, 0.0, -1.3112935448589269e-05, -4.0649541915627196e-05, -1.1920922133867862e-06, -5.960446742392378e-06, -4.5298504119273275e-05, -9.179073458653875e-06, -1.1920928244535389e-07, -4.577531944960356e-05, -1.9073468138230965e-06, -3.933898824470816e-06, -5.602820692729438e-06, -1.2993727978027891e-05, -3.576278118089249e-07, -0.0008230397943407297, -1.3470558769768104e-05, -0.00013493580627255142, -0.00012706902634818107, -1.1920922133867862e-06, -2.3841855067985307e-07, -2.0265558760002023e-06, -2.47952248173533e-05, -9.894321920000948e-06, -1.311301275563892e-06, -1.4185804502631072e-05, -5.722029527532868e-06, -1.6689286894688848e-06, -2.861018856492592e-06, -2.3841855067985307e-07, -4.172316494077677e-06, -1.311301275563892e-06, -8.34461570775602e-06, -9.536738616588991e-07, -3.576272320060525e-06, -1.4066597032069694e-05, -5.722029527532868e-06, -1.4305104514278355e-06, -0.00016258825780823827, -2.13382354559144e-05, -1.311301275563892e-06, 0.0, -3.576278118089249e-07, -1.168244216387393e-05, -2.7418097943154862e-06, -1.311301275563892e-06, -2.264974000354414e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -2.9802276912960224e-06, -1.1920928244535389e-07, -2.753696753643453e-05, -7.152555099310121e-07, -2.3841855067985307e-07, -1.7046782886609435e-05, -5.960462772236497e-07, -6.318072337307967e-06, -4.4225667807040736e-05, -3.266281055402942e-05, -4.172316494077677e-06, 0.0, -4.76837044