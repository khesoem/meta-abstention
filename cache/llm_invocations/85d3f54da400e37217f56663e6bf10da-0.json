ng mod) {\n        long ans = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) ans = (ans * a) % mod;\n            a = (a * a) % mod;\n            b >>= 1;\n        }\n        return ans;\n    }\n\n    static long modpowN(long a, long b) {\n        return modpow(a, b, N);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long p = sc.nextLong();\n        long k = sc.nextLong();\n        if (k % p == 1) {\n            System.out.println(modpowN(p, p));\n            return;\n        }\n        if (k % p == 0) {\n            System.out.println(modpowN(p, p - 1));\n            return;\n        }\n        long a = 1;\n        while (true) {\n            if ((p - 1) % a != 0) {\n                a++;\n                continue;\n            }\n            if (modpow(k, a, p) == 1) break;\n            a++;\n        }\n        System.out.println(modpowN(p, (p - 1) / a));\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-2.455681169521995e-05, -0.00018416139937471598, -4.768370445162873e-07, 0.0, 0.0, -4.255681051290594e-05, -3.814689989667386e-06, -1.1920928244535389e-07, -8.272782724816352e-05, -0.00033825874561443925, -0.00043406602344475687, -2.1934269170742482e-05, 0.0, -0.011009189300239086, -0.00020895205670967698, -4.410734163684538e-06, -0.06204850971698761, -8.344646857949556e-07, -1.1920928244535389e-07, -0.008618067018687725, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.1457441107486375e-05, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -0.0067257690243422985, -0.0007213136414065957, 0.0, -0.011214792728424072, 0.0, 0.0, -0.023245446383953094, -1.1920928244535389e-07, -6.198863957251888e-06, 0.0, 0.0, 0.0, -1.0728830375228426e-06, 0.0, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, 0.0, -3.576278118089249e-07, -4.0531076592742465e-06, 0.0, 0.0, 0.0, -0.018156634643673897, 0.0, -0.008650213479995728, -1.1920928244535389e-07, 0.0, -1.192092