Ways(long long A, long long B, int p, int q) {\n    long long signature = A * 10000 + p * 100 + q;\n    if (cache.find(signature) != cache.end())\n        return cache[signature];\n        \n    long long &ans = cache[signature];\n    long long diff = abs(A - B);\n    if (diff - binomial[p][R] * binomial[q][R] > smallestDiff) {\n        return ans = 0;\n    }\n    \n    if (p < R || q < R) {\n        if (p >= countA[p + q] && q >= countB[p + q]) {\n            int total = p + q;\n            p -= countA[total];\n            q -= countB[total];\n            return ans = binomial[total][p];\n        }\n        return ans = 0;\n    }\n    \n    ans = 0;\n    char ch = buffer[p + q - 1];\n    if (ch != 'B') {\n        long long addA = binomial[p][R] - binomial[p - 1][R];\n        long long sumB = binomial[q][R];\n        ans += countWays(A, B + addA * sumB, p - 1, q);\n    }\n    if (ch != 'A') {\n        long long sumA = binomial[p][R];\n        long long addB = binomial[q][R] - binomial[q - 1][R];\n        ans += countWays(A + sumA * addB, B, p, q - 1);\n    }\n    return ans;\n}\n\nint main() {\n    scanf(\"%d %d\", &R, &C);\n    for (int i = 0; i <= 2 * (R + C); i++) {\n        for (int j = 0; j <= 2 * (R + C); j++) {\n            if (j == 0) binomial[i][j] = 1;\n            else if (i == 0) binomial[i][j] = 0;\n            else binomial[i][j] = binomial[i - 1][j] + binomial[i - 1][j - 1];\n        }\n    }\n    \n    totalPaths = binomial[R + C][R] * binomial[R + C][R];\n    \n    {\n        long long a = 0, b = 0;\n        int i = R + C, j = R + C;\n        while (i >= R && j >= R) {\n            if (a > b) {\n                long long addA = binomial[i][R] - binomial[i - 1][R];\n                long long sumB = binomial[j][R];\n                b += addA * sumB;\n                i--;\n            } else {\n                long long sumA = binomial[i][R];\n                long long addB = binomial[j][R] - binomial[j - 1][R];\n                a += sumA * addB;\n    