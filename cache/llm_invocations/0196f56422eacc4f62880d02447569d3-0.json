t j = 0; j < C; ++j)\n                res.entries[i][j] = add(entries[i][j], other.entries[i][j]);\n        return res;\n    }\n\n    Matrix<R, C> operator*(int scalar) const {\n        Matrix<R, C> res = *this;\n        for (int i = 0; i < R; ++i)\n            for (int j = 0; j < C; ++j)\n                res.entries[i][j] = (int)multiply(res.entries[i][j], scalar);\n        return res;\n    }\n\n    int* operator[](int idx) { return entries[idx]; }\n    const int* operator[](int idx) const { return entries[idx]; }\n};\n\nusing ll = long long;\n\nll n;\nint K;\nvector<int> digits;\nMatrix<35, 35> A[65][35], S[65][35], P[65][35], result;\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> K;\n\n    for (int i = 0; i < K; ++i) {\n        A[0][i].set_identity();\n        for (int j = 0; j <= K; ++j) A[0][i][i][j] = 1;\n    }\n\n    ll block_len = K;\n    for (int level = 1; block_len <= n; ++level, block_len *= K) {\n        S[level - 1][K - 1] = A[level - 1][K - 1];\n        for (int j = K - 2; j >= 0; --j)\n            S[level - 1][j] = Matrix<35, 35>::product(A[level - 1][j], S[level - 1][j + 1]);\n\n        P[level - 1][0] = A[level - 1][0];\n        for (int j = 1; j < K; ++j)\n            P[level - 1][j] = Matrix<35, 35>::product(P[level - 1][j - 1], A[level - 1][j]);\n\n        A[level][0] = S[level - 1][0];\n        for (int j = 1; j < K; ++j)\n            A[level][j] = Matrix<35, 35>::product(S[level - 1][j], P[level - 1][j - 1]);\n    }\n\n    while (n) {\n        digits.push_back(n % K);\n        n /= K;\n    }\n\n    int carry = 0;\n    result.set_identity();\n    for (int i = (int)digits.size() - 1; i >= 0; --i) {\n        for (int j = 0; j < digits[i]; ++j)\n            result = Matrix<35, 35>::product(result, A[i][(j + carry) % K]);\n        carry = (carry + digits[i]) % K;\n    }\n\n    int answer = 1;\n    for (int i = 0; i < K; ++i)\n        answer = add(answer, result[i][K]);\n    cout << answer << '\\n';\