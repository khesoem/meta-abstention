mPhases, phaseSize);\n                long term = mod.multiply(mod.nCr(n, k), e);\n                \n                if (k % 2 == 1)\n                    answer = mod.add(answer, term);\n                else\n                    answer = mod.subtract(answer, term);\n            }\n            \n            pw.println(answer);\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998_244_353L;\n        private long[] fact;\n        private long[] invFact;\n\n        public void precomputeFactorials(int maxN) {\n            fact = new long[maxN + 1];\n            invFact = new long[maxN + 1];\n            fact[0] = 1;\n            for (int i = 1; i <= maxN; i++) {\n                fact[i] = multiply(fact[i - 1], i);\n            }\n            invFact[maxN] = modInverse(fact[maxN]);\n            for (int i = maxN - 1; i >= 0; i--) {\n                invFact[i] = multiply(invFact[i + 1], i + 1);\n            }\n        }\n\n        public long nCr(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return multiply(fact[n], multiply(invFact[r], invFact[n - r]));\n        }\n\n        public long modInverse(int n) {\n            return modInverse((long) n);\n        }\n\n        public long modInverse(long a) {\n            return power(a, MOD - 2);\n        }\n\n        public long power(long base, long exp) {\n            long result = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) result = multiply(result, base);\n                base = multiply(base, base);\n                exp >>= 1;\n            }\n            return result;\n        }\n\n        public long add(long a, long b) {\n            a %= MOD; b %= MOD;\n            long res = a + b;\n            return res >= MOD ? res - MOD : res;\n        }\n\n        public long subtract(long a, long b) {\n            a %= MOD; b %= MOD;\n