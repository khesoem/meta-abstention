;\n\nlli count_valid(lli A_val, lli B_val, int iA, int iB) {\n    lli key = (A_val << 20) ^ (iA << 10) ^ iB;\n    auto it = dp_cache.find(key);\n    if (it != dp_cache.end()) return it->second;\n\n    lli &res = dp_cache[key];\n    lli diff = llabs(A_val - B_val);\n    if (diff - binom[iA][N] * binom[iB][N] > smallestDifference) {\n        res = 0;\n        return res;\n    }\n\n    if (iA < N || iB < N) {\n        int pos = iA + iB;\n        if (iA >= cnt_a[pos] && iB >= cnt_b[pos]) {\n            int a_idx = iA - cnt_a[pos];\n            int b_idx = iB - cnt_b[pos];\n            return res = binom[a_idx + b_idx][a_idx];\n        }\n        res = 0;\n        return res;\n    }\n\n    res = 0;\n    char ch = str[iA + iB - 1];\n    if (ch != 'B') {\n        lli deltaA = binom[iA][N] - binom[iA-1][N];\n        lli sumB = binom[iB][N];\n        res += count_valid(A_val, B_val + deltaA * sumB, iA-1, iB);\n    }\n    if (ch != 'A') {\n        lli sumA = binom[iA][N];\n        lli deltaB = binom[iB][N] - binom[iB-1][N];\n        res += count_valid(A_val + sumA * deltaB, B_val, iA, iB-1);\n    }\n    return res;\n}\n\nint main() {\n    scanf(\"%d %d\", &N, &M);\n    for (int i = 0; i <= 2*(N+M); ++i) {\n        for (int j = 0; j <= 2*(N+M); ++j) {\n            if (j == 0) binom[i][j] = 1;\n            else if (i == 0) binom[i][j] = 0;\n            else binom[i][j] = binom[i-1][j] + binom[i-1][j-1];\n        }\n    }\n\n    globalTotal = binom[N+M][N] * binom[N+M][N];\n\n    {\n        lli leftSum = 0, rightSum = 0;\n        int L = N+M, R = N+M;\n        while (L >= N && R >= N) {\n            if (leftSum > rightSum) {\n                lli incL = binom[L][N] - binom[L-1][N];\n                lli sumR = binom[R][N];\n                rightSum += incL * sumR;\n                --L;\n            } else {\n                lli sumL = binom[L][N];\n                lli incR = binom[R][N] - binom[R-1][N];\n                leftSum += sumL * incR;\n                --R;\n            }\