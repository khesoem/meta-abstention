val = ceil_mult * (current_lcm / i);\n        double diff2 = fabs(target - ceil_val) / (double)current_lcm;\n        \n        if (diff2 < best_diff) {\n            best_diff = diff2;\n            num = ceil_mult;\n            den = i;\n        }\n    }\n    \n    ll g = __gcd(num, den);\n    num /= g;\n    den /= g;\n    \n    cout << num << \"/\" << den << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef lcm(a, b):\n    return a // math.gcd(a, b) * b\n\ndef main():\n    x, y, n = map(int, input().split())\n    \n    best_diff = 1e9\n    num = 0\n    den = 0\n    \n    if y <= n:\n        g = math.gcd(x, y)\n        while g > 1:\n            x //= g\n            y //= g\n            g = math.gcd(x, y)\n        print(f\"{x}/{y}\")\n        return\n    \n    for i in range(1, n + 1):\n        current_lcm = lcm(i, y)\n        target = x * (current_lcm // y)\n        \n        floor_mult = target // (current_lcm // i)\n        floor_val = floor_mult * (current_lcm // i)\n        diff1 = abs(target - floor_val) / current_lcm\n        \n        if diff1 < best_diff:\n            best_diff = diff1\n            num = floor_mult\n            den = i\n        \n        ceil_mult = (target + (current_lcm // i) - 1) // (current_lcm // i)\n        ceil_val = ceil_mult * (current_lcm // i)\n        diff2 = abs(target - ceil_val) / current_lcm\n        \n        if diff2 < best_diff:\n            best_diff = diff2\n            num = ceil_mult\n            den = i\n    \n    g = math.gcd(num, den)\n    num //= g\n    den //= g\n    \n    print(f\"{num}/{den}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001641377166379243, -9.536738616588991e-07, -1.1920928244535389e-07, -9.905801562126726e-05, -0.0003833036171272397, -0.3132922351360321, -0.0030