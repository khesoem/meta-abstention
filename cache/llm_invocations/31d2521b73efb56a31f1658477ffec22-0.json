bset_sum(N);\n    for (int mask = 0; mask < N; ++mask) {\n        for (int j = 0; j < size_mask; ++j)\n            if (mask >> j & 1) subset_sum[mask] += powers[j];\n    }\n    \n    vector<int> next_mask(N);\n    for (int mask = 0; mask < N; ++mask) {\n        int bit = -1;\n        for (int j = 0; j <= 20; ++j)\n            if (mask >> j & 1) bit = j;\n        next_mask[mask] = (1 << (bit + 1)) + mask;\n    }\n    \n    vector<vector<i64>> dp(k + 1, vector<i64>(N));\n    dp[0][0] = 1;\n    \n    for (int step = 0; step < k; ++step) {\n        for (int mask = 0; mask < N; ++mask) {\n            if (!dp[step][mask]) continue;\n            for (int next = next_mask[mask]; next < N; next = (next + 1) | mask)\n                dp[step + 1][next] = (dp[step + 1][next] + dp[step][mask] * inv_fact[subset_sum[next ^ mask]]) % MOD;\n        }\n    }\n    \n    i64 result = 0;\n    for (int i = 0; i <= k; ++i) {\n        result = (result + dp[i][N - 1] * fact[k] % MOD * inv_fact[k - i] % MOD) % MOD;\n    }\n    result = result * fact[n] % MOD;\n    result = (modexp(k, n, MOD) - result + MOD) % MOD;\n    \n    cout << result << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef input():\n    line = sys.stdin.readline().strip()\n    return int(line)\n\ndef modexp(b, e, m):\n    r = 1\n    while e:\n        if e & 1:\n            r = (r * b) % m\n        b = (b * b) % m\n        e >>= 1\n    return r\n\ndef main():\n    data = input()\n    n = data\n    k = input()\n    MOD = input()\n    \n    if n & 1:\n        print(modexp(k, n, MOD))\n        return\n    \n    fact = [1] * (n + 1)\n    inv_fact = [1] * (n + 1)\n    fact[0] = 1\n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % MOD\n    inv_fact[n] = modexp(fact[n], MOD - 2, MOD)\n    for i in range(n, 0, -1):\n        inv_fact[i-1] = inv_fact[i] * i % MOD\n 