de>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 0x3f3f3f3f;\n    static int[] head;\n    static ArrayList<Integer> to, cap, cost, nxt;\n    static int[] dist, pre, preEdge, inq;\n\n    static void addEdge(int u, int v, int flow, int c) {\n        to.add(v);\n        cap.add(flow);\n        cost.add(c);\n        nxt.add(head[u]);\n        head[u] = to.size() - 1;\n\n        to.add(u);\n        cap.add(0);\n        cost.add(-c);\n        nxt.add(head[v]);\n        head[v] = to.size() - 1;\n    }\n\n    static boolean spfa(int s, int t) {\n        Arrays.fill(dist, INF);\n        Arrays.fill(pre, -1);\n        Arrays.fill(inq, 0);\n        Queue<Integer> q = new LinkedList<>();\n        dist[s] = 0;\n        q.add(s);\n        inq[s] = 1;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = 0;\n            for (int i = head[u]; i != -1; i = nxt.get(i)) {\n                int v = to.get(i);\n                if (cap.get(i) > 0 && dist[v] > dist[u] + cost.get(i)) {\n                    dist[v] = dist[u] + cost.get(i);\n                    pre[v] = u;\n                    preEdge[v] = i;\n                    if (inq[v] == 0) {\n                        inq[v] = 1;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n\n    static int minCostMaxFlow(int s, int t) {\n        int result = 0;\n        while (spfa(s, t)) {\n            int add = INF;\n            for (int v = t; v != s; v = pre[v]) {\n                add = Math.min(add, cap.get(preEdge[v]));\n            }\n            for (int v = t; v != s; v = pre[v]) {\n                int e = preEdge[v];\n                cap.set(e, cap.get(e) - add);\n                cap.set(e ^ 1, cap.get(e ^ 1) + add);\n            }\n            result += dist[t] * add;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(