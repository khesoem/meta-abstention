{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int MAX_NODES = 10000;\nconst int SOURCE = 9998;\nconst int SINK = 9999;\n\nstruct Edge {\n    int to, capacity, flow, cost;\n};\n\nvector<Edge> edges;\nvector<int> adj[MAX_NODES];\nlong long totalCost, dist[MAX_NODES];\nint numNodes, numEdges, numCommodities, unitCost, delayCost;\nint prevNode[MAX_NODES], prevEdge[MAX_NODES];\nbool inQueue[MAX_NODES];\n\nvoid addDirectedEdge(int u, int v, int cap, int cst) {\n    adj[u].push_back(edges.size());\n    edges.push_back({v, cap, 0, cst});\n    adj[v].push_back(edges.size());\n    edges.push_back({u, 0, 0, -cst});\n}\n\nbool findShortestPath() {\n    fill(dist, dist + MAX_NODES, 1e18);\n    fill(prevNode, prevNode + MAX_NODES, -1);\n    fill(prevEdge, prevEdge + MAX_NODES, -1);\n    fill(inQueue, inQueue + MAX_NODES, false);\n    \n    dist[SOURCE] = 0;\n    queue<int> q;\n    q.push(SOURCE);\n    inQueue[SOURCE] = true;\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inQueue[u] = false;\n        \n        for (int idx : adj[u]) {\n            Edge& e = edges[idx];\n            if (e.capacity - e.flow <= 0) continue;\n            int v = e.to;\n            long long newDist = dist[u] + e.cost;\n            if (newDist < dist[v]) {\n                dist[v] = newDist;\n                prevNode[v] = u;\n                prevEdge[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    if (dist[SINK] == 1e18) return false;\n    \n    int cur = SINK;\n    while (cur != SOURCE) {\n        edges[prevEdge[cur]].flow++;\n        edges[prevEdge[cur] ^ 1].flow--;\n        cur = prevNode[cur];\n    }\n    \n    totalCost += dist[SINK];\n    return true;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> numNodes >> numEdges >> numCommodities >> unitCost >> delayCost;\n    \n    int u, v;\n    for (int i = 0; i < numCommodities; i++) {\n        cin >> u;\n        u--;\n        addDirectedEdge(SOURCE, u, 1, 0);\n    }\n    \n    for (int i = 1; i <= 101; i++) {\n        addDirectedEdge((i-1)*numNodes, SINK, numCommodities, (i-1)*unitCost);\n    }\n    \n    for (int i = 0; i < numEdges; i++) {\n        cin >> u >> v;\n        u--; v--;\n        for (int layer = 1; layer <= 100; layer++) {\n            for (int commodity = 1; commodity <= numCommodities; commodity++) {\n                int cost = delayCost * ((commodity-1)*2 + 1);\n                addDirectedEdge(u + (layer-1)*numNodes, v + (layer-1)*numNodes + numNodes, 1, cost);\n                addDirectedEdge(v + (layer-1)*numNodes, u + (layer-1)*numNodes + numNodes, 1, cost);\n            }\n        }\n    }\n    \n    for (int node = 0; node < numNodes; node++) {\n        for (int layer = 1; layer <= 100; layer++) {\n            addDirectedEdge(node + (layer-1)*numNodes, node + (layer-1)*numNodes + numNodes, numCommodities, 0);\n        }\n    }\n    \n    for (int i = 0; i < numCommodities; i++) {\n        findShortestPath();\n    }\n    \n    cout << totalCost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_NODES = 10000;\n    static final int SOURCE = 9998;\n    static final int SINK = 9999;\n\n    static class Edge {\n        int to, capacity, flow, cost;\n        Edge(int to, int capacity, int flow, int cost) {\n            this.to = to;\n            this.capacity = capacity;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static List<Edge> edges = new ArrayList<>();\n    static List<Integer>[] adj = new List[MAX_NODES];\n    static long totalCost = 0;\n    static long[] dist = new long[MAX_NODES];\n    static int numNodes, numEdges, numCommodities, unitCost, delayCost;\n    static int[] prevNode = new int[MAX_NODES];\n    static int[] prevEdge = new int[MAX_NODES];\n    static boolean[] inQueue = new boolean[MAX_NODES];\n\n    static void addDirectedEdge(int u, int v, int cap, int cst) {\n        adj[u].add(edges.size());\n        edges.add(new Edge(v, cap, 0, cst));\n        adj[v].add(edges.size());\n        edges.add(new Edge(u, 0, 0, -cst));\n    }\n\n    static boolean findShortestPath() {\n        Arrays.fill(dist, Long.MAX_VALUE);\n        Arrays.fill(prevNode, -1);\n        Arrays.fill(prevEdge, -1);\n        Arrays.fill(inQueue, false);\n\n        dist[SOURCE] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(SOURCE);\n        inQueue[SOURCE] = true;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = false;\n\n            for (int idx : adj[u]) {\n                Edge e = edges.get(idx);\n                if (e.capacity - e.flow <= 0) continue;\n                int v = e.to;\n                long newDist = dist[u] + e.cost;\n                if (newDist < dist[v]) {\n                    dist[v] = newDist;\n                    prevNode[v] = u;\n                    prevEdge[v] = idx;\n                    if (!inQueue[v]) {\n                        inQueue[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n\n        if (dist[SINK] == Long.MAX_VALUE) return false;\n\n        int cur = SINK;\n        while (cur != SOURCE) {\n            edges.get(prevEdge[cur]).flow++;\n            edges.get(prevEdge[cur] ^ 1).flow--;\n            cur = prevNode[cur];\n        }\n\n        totalCost += dist[SINK];\n        return true;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        numNodes = sc.nextInt();\n        numEdges = sc.nextInt();\n        numCommodities = sc.nextInt();\n        unitCost = sc.nextInt();\n        delayCost = sc.nextInt();\n\n        for (int i = 0; i < MAX_NODES; i++) {\n            adj[i] = new ArrayList<>();\n        }\n\n        for (int i = 0; i < numCommodities; i++) {\n            int u = sc.nextInt();\n            u--;\n            addDirectedEdge(SOURCE, u, 1, 0);\n        }\n\n        for (int i = 1; i <= 101; i++) {\n            addDirectedEdge((i-1)*numNodes, SINK, numCommodities, (i-1)*unitCost);\n        }\n\n        for (int i = 0; i < numEdges; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            u--;\n            v--;\n            for (int layer = 1; layer <= 100; layer++) {\n                for (int commodity = 1; commodity <= numCommodities; commodity++) {\n                    int cost = delayCost * ((commodity-1)*2 + 1);\n                    addDirectedEdge(u + (layer-1)*numNodes, v + (layer-1)*numNodes + numNodes, 1, cost);\n                    addDirectedEdge(v + (layer-1)*numNodes, u + (layer-1)*numNodes + numNodes, 1, cost);\n                }\n            }\n        }\n\n        for (int node = 0; node < numNodes; node++) {\n            for (int layer = 1; layer <= 100; layer++) {\n                addDirectedEdge(node + (layer-1)*numNodes, node + (layer-1)*numNodes + numNodes, numCommodities, 0);\n            }\n        }\n\n        for (int i = 0; i < numCommodities; i++) {\n            findShortestPath();\n        }\n\n        System.out.println(totalCost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010239553375868127, -2.145764938177308e-06, -5.960462772236497e-07, -0.00026472879108041525, -3.504691630951129e-05, -0.03364888206124306, -0.02341047115623951, -1.0251946150674485e-05, -3.576278118089249e-07, -0.0001481661747675389, -0.0005534547381103039, -1.490105023549404e-05, -0.019016453996300697, -0.004892046097666025, -1.311301275563892e-06, -2.0265558760002023e-06, -4.410734163684538e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -7.867782187531702e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -5.125986263010418e-06, -1.5497195136049413e-06, -4.410734163684538e-06, 0.0, 0.0, -1.311301275563892e-06, 0.0, -9.536738616588991e-07, -4.768370445162873e-07, -2.145764938177308e-06, -2.264974000354414e-06, -8.344646857949556e-07, -8.344646857949556e-07, 0.0, -1.1920928244535389e-07, -1.7881377516459906e-06, -4.529942543740617e-06, -2.9802276912960224e-06, -7.152555099310121e-07, -4.768370445162873e-07, -1.1920922133867862e-06, -2.622600959512056e-06, -0.06196828559041023, -1.1920928244535389e-07, -4.0531076592742465e-06, -7.867782187531702e-06, -1.3112935448589269e-05, -1.1920928244535389e-07, -1.8596476365928538e-05, -4.768370445162873e-07, -3.576278118089249e-07, -0.0007129749283194542, -1.0728830375228426e-06, 0.0, -2.3841830625315197e-06, 0.0, -2.0265558760002023e-06, -0.018149960786104202, -0.5233806371688843, -2.95634672511369e-05, -2.861018856492592e-06, -0.0009170140838250518, -1.1920928244535389e-07, 0.0, -0.0002671123365871608, 0.0, -1.1920928244535389e-07, -1.6689286894688848