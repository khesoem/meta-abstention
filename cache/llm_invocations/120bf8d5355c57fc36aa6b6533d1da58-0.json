mponents = p - (k > 1);\n    \n    for (long long i = 1; i < p; i++) {\n        union_sets(static_cast<int>(i), static_cast<int>((i * k) % p));\n    }\n    \n    unordered_set<int> unique_roots;\n    for (int i = 1; i < p; i++) {\n        unique_roots.insert(find_set(i));\n    }\n    \n    cout << mod_exp(p, static_cast<long long>(unique_roots.size())) << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\ndef mod_exp(base, exp, MOD=1000000007):\n    res = 1\n    base %= MOD\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return res\n\ndef main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    p = int(data[0])\n    k = int(data[1])\n    \n    if k == 0:\n        print(mod_exp(p, p - 1))\n        return\n    \n    parent = list(range(p))\n    \n    def find_set(x):\n        if parent[x] != x:\n            parent[x] = find_set(parent[x])\n        return parent[x]\n    \n    def union_sets(a, b):\n        a = find_set(a)\n        b = find_set(b)\n        if a != b:\n            parent[b] = a\n    \n    num_components = p - (1 if k > 1 else 0)\n    \n    for i in range(1, p):\n        union_sets(i, int((i * k) % p))\n    \n    unique_roots = set()\n    for i in range(1, p):\n        unique_roots.add(find_set(i))\n    \n    print(mod_exp(p, len(unique_roots)))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001161031104857102, -1.0728830375228426e-06, 0.0, -0.6461797952651978, -0.012530173175036907, -2.9802276912960224e-06, -3.933898824470816e-06, -0.00010930894495686516, -1.0371154530730564e-05, -0.02975550852715969, -0.34886297583580017, -1.9550132492440753e-05, 0.0, 0.0, -0.03364796191453934, 0.0, -2.3841855067985307e-07, 0.0, 0.