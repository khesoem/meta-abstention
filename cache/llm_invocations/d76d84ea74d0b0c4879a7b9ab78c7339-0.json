ic long readLong() {\n    long ans = 0;\n    boolean neg = false;\n    try {\n      boolean start = false;\n      for (int c = 0; (c = System.in.read()) != -1; ) {\n        if (c == '-') {\n          start = true;\n          neg = true;\n          continue;\n        } else if (c >= '0' && c <= '9') {\n          start = true;\n          ans = ans * 10 + c - '0';\n        } else if (start) break;\n      }\n    } catch (IOException e) {\n    }\n    return neg ? -ans : ans;\n  }\n\n  static String readString() {\n    StringBuilder b = new StringBuilder();\n    try {\n      boolean start = false;\n      for (int c = 0; (c = System.in.read()) != -1; ) {\n        if (!Character.isWhitespace(c)) {\n          start = true;\n          b.append((char) c);\n        } else if (start) break;\n      }\n    } catch (IOException e) {\n    }\n    return b.toString();\n  }\n\n  static int readChars(char[] a, int off) {\n    int cnt = 0;\n    try {\n      boolean start = false;\n      for (int c = 0; (c = System.in.read()) != -1; ) {\n        if (Character.isLetterOrDigit(c)) {\n          start = true;\n          a[off + cnt++] = (char) c;\n        } else if (start) break;\n      }\n    } catch (IOException e) {\n    }\n    return cnt;\n  }\n\n  void dfs(long x, long y, int v1, int v2) {\n    long diff = Math.abs(x - y);\n    if (best <= 1 || diff - ch[v1][R] * ch[v2][R] >= best) return;\n    if (v1 == R - 1 && v2 == R - 1) {\n      if (diff < best) best = diff;\n      return;\n    }\n    if (v1 >= R) {\n      long cur = ch[v1][R] - ch[v1 - 1][R];\n      long other = ch[v2][R];\n      dfs(x, y + cur * other, v1 - 1, v2);\n    }\n    if (v2 >= R) {\n      long cur = ch[v2][R] - ch[v2 - 1][R];\n      long other = ch[v1][R];\n      dfs(x + cur * other, y, v1, v2-1);\n    }\n  }\n\n  long solve(long x, long y, int v1, int v2) {\n    long diff = Math.abs(x - y);\n    if (diff - ch[v1][R] * ch[v2][R] > best) return 0;\n    long key = x*10000 + v1*100 + v2;\n    Long v = cache.get(key);\n    