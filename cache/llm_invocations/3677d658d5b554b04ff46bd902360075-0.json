ndef identity_matrix(dim):\n    res = Matrix(dim)\n    for i in range(dim):\n        res.data[i][i] = 1\n    return res\n\ndef multiply(A, B, dim):\n    C = Matrix(dim)\n    for i in range(dim):\n        for j in range(dim):\n            for k in range(dim):\n                C.data[i][j] = add(C.data[i][j], mul(A.data[i][k], B.data[k][j]))\n    return C\n\ndef build_shifted(depth, shift, lookup, K):\n    result = Matrix(K + 1)\n    for i in range(K + 1):\n        for j in range(K + 1):\n            ni = i if i == K else (i + shift) % K\n            nj = j if j == K else (j + shift) % K\n            result.data[ni][nj] = lookup[depth].data[i][j]\n    return result\n\ndef digit_sum(num, base):\n    s = 0\n    while num > 0:\n        s += num % base\n        num //= base\n    return s % base\n\ndef main():\n    data = input().split()\n    N = int(data[0])\n    k = int(data[1])\n    \n    num_digits = 0\n    temp = N\n    while temp > 0:\n        temp //= k\n        num_digits += 1\n    \n    I = identity_matrix(k + 1)\n    lookup = [None] * MAX_D\n    lookup[0] = I\n    for i in range(k + 1):\n        lookup[0].data[i][0] = 1\n    \n    for d in range(1, num_digits):\n        lookup[d] = identity_matrix(k + 1)\n        for s in range(k):\n            lookup[d] = multiply(lookup[d], build_shifted(d-1, s, lookup, k), k + 1)\n    \n    current = 0\n    power = 1\n    num_digits -= 1\n    for i in range(num_digits):\n        power *= k\n    \n    result = identity_matrix(k + 1)\n    while current < N:\n        assert num_digits >= 0\n        while current + power <= N:\n            result = multiply(result, build_shifted(num_digits, digit_sum(current, k), lookup, k), k + 1)\n            current += power\n        power //= k\n        num_digits -= 1\n    \n    total = 0\n    for i in range(k + 1):\n        total = add(total, result.data[k][i])\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logpro