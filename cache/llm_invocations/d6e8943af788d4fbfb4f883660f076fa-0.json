' ? 1 : 0);\n                sno[i + 1] = sno[i] + (c == 'O' ? 1 : 0);\n            }\n            \n            final int INF = (int)1e9;\n            int[][][][] dp = new int[2][nk + 1][nv + 1][no + 1];\n            \n            for (int[][][] a : dp) {\n                for (int[][] b : a) {\n                    for (int[] c : b) {\n                        Arrays.fill(c, INF);\n                    }\n                }\n            }\n            \n            dp[0][0][0][0] = 0;\n            \n            for (int k = 0; k <= nk; k++) {\n                for (int v = 0; v <= nv; v++) {\n                    for (int o = 0; o <= no; o++) {\n                        for (int hv = 0; hv < 2; hv++) {\n                            int cur = dp[hv][k][v][o];\n                            if (cur == INF) continue;\n                            \n                            if (k < nk && hv == 0) {\n                                int cost = Math.max(snv[kpos[k]] - v, 0) + Math.max(sno[kpos[k]] - o, 0);\n                                dp[0][k + 1][v][o] = Math.min(dp[0][k + 1][v][o], cur + cost);\n                            }\n                            if (v < nv) {\n                                int cost = Math.max(snk[vpos[v]] - k, 0) + Math.max(sno[vpos[v]] - o, 0);\n                                dp[1][k][v + 1][o] = Math.min(dp[1][k][v + 1][o], cur + cost);\n                            }\n                            if (o < no) {\n                                int cost = Math.max(snv[opos[o]] - v, 0) + Math.max(snk[opos[o]] - k, 0);\n                                dp[0][k][v][o + 1] = Math.min(dp[0][k][v][o + 1], cur + cost);\n                            }\n                        }\n                    }\n                }\n            }\n            \n            int ans = Math.min(dp[0][nk][nv][no], dp[1][nk][nv][no]);\n            System.out.println(ans);\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <climits>\n#include <string>\n#include <cstring>\n\nusing namespace std;\n\nint main() {\n    int n;\n    string s;\n    \n    cin >> n;\n    cin >> s;\n    \n    int nk = 0, nv = 0, no = 0;\n    vector<int> kpos(n);\n    vector<int> vpos(n);\n    vector<int> opos(n);\n    \n    for (int i = 0; i < n; i++) {\n        char c = s[i];\n        if (c == 'K') kpos[nk++] = i;\n        else if (c == 'V') vpos[nv++] = i;\n        else opos[no++] = i;\n    }\n    \n    vector<int> snk(n + 1, 0);\n    vector<int> snv(n + 1, 0);\n    vector<int> sno(n + 1, 0);\n    \n    for (int i = 0; i < n; i++) {\n        char c = s[i];\n        snk[i + 1] = snk[i] + (c == 'K' ? 1 : 0);\n        snv[i + 1] = snv[i] + (c == 'V' ? 1 : 0);\n        sno[i + 1] = sno[i] + (c == 'O' ? 1 : 0);\n    }\n    \n    const int INF = (int)1e9;\n    vector<vector<vector<vector<int>>>> dp(2, vector<vector<vector<int>>>(nk + 1, vector<vector<int>>(nv + 1, vector<int>(no + 1, INF))));\n    \n    dp[0][0][0][0] = 0;\n    \n    for (int k = 0; k <= nk; k++) {\n        for (int v = 0; v <= nv; v++) {\n            for (int o = 0; o <= no; o++) {\n                for (int hv = 0; hv < 2; hv++) {\n                    int cur = dp[hv][k][v][o];\n                    if (cur == INF) continue;\n                    \n                    if (k < nk && hv == 0) {\n                        int cost = max(snv[kpos[k]] - v, 0) + max(sno[kpos[k]] - o, 0);\n                        dp[0][k + 1][v][o] = min(dp[0][k + 1][v][o], cur + cost);\n                    }\n                    if (v < nv) {\n                        int cost = max(snk[vpos[v]] - k, 0) + max(sno[vpos[v]] - o, 0);\n                        dp[1][k][v + 1][o] = min(dp[1][k][v + 1][o], cur + cost);\n                    }\n             