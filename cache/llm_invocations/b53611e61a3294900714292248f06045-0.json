unt('1')\n\ndef main():\n    global P, fac, ifac, inv\n    n = gi()\n    k = gi()\n    P = gi()\n    \n    ans = fpow(k, n)\n    \n    if n & 1 == 0:\n        m = int(math.log2(n)) + 1\n        size = 1 << m\n        fac = [0] * (size + 1)\n        ifac = [0] * (size + 1)\n        inv = [0] * (size + 1)\n        init(size)\n        \n        f = [[0] * size for _ in range(20)]\n        for i in range(size):\n            f[popcount(i)][i] = ifac[i]\n        \n        for i in range(m + 1):\n            FMT(f[i], size)\n        \n        F_arr = [0] * 20\n        for i in range(n + 1):\n            for j in range(m + 1):\n                F_arr[j] = f[j][i]\n            fpow_arr(F_arr, m + 1, k)\n            for j in range(m + 1):\n                f[j][i] = F_arr[j]\n        \n        IFMT(f[popcount(n)], size)\n        ans = (P + ans - f[popcount(n)][n] * fac[n] % P) % P\n    \n    pi(ans)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00012396997772157192, -9.536738616588991e-07, -8.344646857949556e-07, -0.006372726056724787, -0.004185013473033905, -0.0699470117688179, -0.032377973198890686, -0.00038354191929101944, -0.04308087006211281, -0.018941009417176247, -0.0608515702188015, -0.0009043894242495298, -8.106198947643861e-06, -4.172316494077677e-06, -1.5258672647178173e-05, -3.814689989667386e-06, -0.011184615083038807, -0.00012575789878610522, -0.0008081507403403521, -0.3137120306491852, -0.0003636414185166359, -0.4412621557712555, -8.106198947643861e-06, -3.099436753473128e-06, -0.19850169122219086, -6.16293036728166e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -0.0009617946925573051, -6.9141146923357155e-06, -0.00027176024741493165, -1.5497195136049413e-06, -3.6954811548639555e-06, -1.1920928244535389e-07, 0.0, -1.8715683836489916e-05, -2.3841855067985307e-07, -0.004023909103125334, -8.344646857949556e-07, -0.6326038837432861, -3.4570634852570947e-06,