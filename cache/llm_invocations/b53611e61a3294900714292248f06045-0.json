fac[n]=fpow(fac[n],P-2);\n\tfor(int i=n-1;i>=0;--i)ifac[i]=1ll*ifac[i+1]*(i+1)%P;\n\tinv[1]=1;\n\tfor(int i=2;i<=n;++i)inv[i]=1ll*(P-P/i)*inv[P%i]%P;\n}\ninline void add(int &x,int y){x+=y;if(x>=P)x-=P;}\ninline void sub(int &x,int y){x-=y;x-=(x>>31)*P;}\ninline int sub(int x){return x-(x>>31)*P;}\nint t[20],g[20];\ninline void fpow(int *f,int n,int k){\n\tmemcpy(t,f,4*n+4);\n\tf[0]=1-f[0],g[0]=0;\n\tfor(int i=1;i<n;++i)\n\t{\n\t\tf[i]=g[i]=0;\n\t\tfor(int j=1;j<i;++j)\n\t\t\tf[i]=(f[i]+1ll*f[i-j]*g[j])%P,\n\t\t\tg[i]=(g[i]+1ll*t[i-j]*g[j])%P;\n\t\tsub(f[i],g[i]);\n\t\tf[i]=(t[i]+1ll*f[i]*inv[i])%P*k%P,\n\t\tg[i]=(t[i]-1ll*g[i]*inv[i])%P*i%P;\n\t}\n}\ninline void FMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(int j=0;j<l;++j)\n\t\t\t\tadd(f[i+j+l],f[i+j]);\n}\ninline void IFMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(int j=0;j<l;++j)\n\t\t\t\tsub(f[i+j+l],f[i+j]);\n}\nint n,k;\n#define pop(x) __builtin_popcount(x)\nint main(void)\n{\n\tn=gi,k=gi;P=gi;\n\tint ans=fpow(k,n);\n\tif(~n&1){\n\t\tint m=(int)log2(n)+1;\n\t\tinit(1<<m);\n\t\tfor(int i=0;i<(1<<m);++i)f[pop(i)][i]=ifac[i];\n\t\tfor(int i=0;i<=m;++i)FMT(f[i],1<<m);\n\t\tstatic int F[20];\n\t\tfor(int i=0;i<=n;++i){\n\t\t\tfor(int j=0;j<=m;++j)F[j]=f[j][i];\n\t\t\tfpow(F,m+1,k);\n\t\t\tfor(int j=0;j<=m;++j)f[j][i]=F[j];\n\t\t}\n\t\tIFMT(f[pop(n)],1<<m);\n\t\tans=(P+ans-1ll*f[pop(n)][n]*fac[n]%P)%P;\n\t}\n\tpi(ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef input():\n    return sys.stdin.readline().rstrip()\n\ndef gi():\n    xi = 0\n    ch = sys.stdin.read(1)\n    f = False\n    while not ch.isdigit():\n        if ch == '-':\n            f = True\n        ch = sys.stdin.read(1)\n    while ch.isdigit():\n        xi = xi * 10 + ord(ch) - 48\n        ch = sys.stdin.re