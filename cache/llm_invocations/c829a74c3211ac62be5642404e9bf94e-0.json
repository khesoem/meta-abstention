);\n    for (int i = 0; i < n; ++i) {\n        f[i][0] = 1;\n        for (int j = 0; j < n; ++j) {\n            int P;\n            scanf(\"%d\", &P);\n            int p1 = 1LL * P * inv100 % MOD;\n            int p0 = (MOD + 1 - p1) % MOD;\n            for (int k = 0; k < (1 << j); ++k) {\n                f[i][k | (1 << j)] = 1LL * f[i][k] * p1 % MOD;\n                f[i][k] = 1LL * f[i][k] * p0 % MOD;\n            }\n        }\n    }\n    for (int i = 0; i < (1 << n); ++i)\n        cnt[i] = cnt[i >> 1] + (i & 1);\n    for (int i = 0; i < (1 << n); ++i) {\n        vec[cnt[i]].push_back(i);\n        id[i] = (int)vec[cnt[i]].size() - 1;\n    }\n    printf(\"%d\\n\", DP(0, 1));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static int n;\n    static int[] cnt;\n    static int[] id;\n    static int[][] f;\n    static ArrayList<Integer>[] vec;\n    static HashMap<Long, Integer> memo;\n\n    static int qpow(int x, int y) {\n        int r = 1;\n        while (y > 0) {\n            if ((y & 1) == 1) r = (int)((long)r * x % MOD);\n            x = (int)((long)x * x % MOD);\n            y >>= 1;\n        }\n        return r;\n    }\n\n    static int DP(int x, long sta) {\n        if (sta == 0) return 0;\n        if (x == n) return 1;\n        long h = sta * 11 + x;\n        Integer cached = memo.get(h);\n        if (cached != null) return cached;\n        int ans = 0;\n        int totalMasks = 1 << n;\n        for (int j = 1; j < totalMasks; ++j) {\n            long nxt = 0;\n            int idx = 0;\n            for (int v : vec[x]) {\n                if ((sta & (1L << idx)) != 0) {\n                    for (int l = 0; l < n; ++l) {\n                        if ((j & (1 << l)) != 0 && (v & (1 << l)) == 0) {\n                            nxt |= (1L << id[v | (1 << l)]);\n                        }\n                    }\n                }\n                ++idx;\n            }\n            ans = (int)((ans + (long)f[x][j] * DP(x + 1, nxt)) % MOD);\n        }\n        memo.put(h, ans);\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        int inv100 = qpow(100, MOD - 2);\n        int totalMasks = 1 << n;\n        f = new int[n][totalMasks];\n        for (int i = 0; i < n; ++i) {\n            f[i][0] = 1;\n            for (int j = 0; j < n; ++j) {\n                int P = sc.nextInt();\n                int p1 = (int)((long)P * inv100 % MOD);\n                int p0 = (MOD + 1 - p1) % MOD;\n                for (int k = 0; k < (1 << j); ++k) {\n                    f[i][k | (1 << j)] = (int)((long)f[i][k] * p1 % MOD);\n                    f[i][k] = (int)((long)f[i][k] * p0 % MOD);\n                }\n            }\n        }\n        cnt = new int[totalMasks];\n        for (int i = 0; i < totalMasks; ++i) {\n            cnt[i] = cnt[i >> 1] + (i & 1);\n        }\n        vec = new ArrayList[n + 1];\n        for (int i = 0; i <= n; ++i) vec[i] = new ArrayList<>();\n        id = new int[totalMasks];\n        for (int i = 0; i < totalMasks; ++i) {\n            vec[cnt[i]].add(i);\n            id[i] = vec[cnt[i]].size() - 1;\n        }\n        memo = new HashMap<>();\n        System.out.println(DP(0, 1L));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.417489309271332e-06, 0.0, 0.0, -3.2543604902457446e-05, -4.291525328881107e-06, 0.0, -6.198863957251888e-06, -0.010313784703612328, -4.708655978902243e-05, -1.1920928244535389e-07, -0.0002949994814116508, -7.70062324590981e-05, -1.5497195136049413e-06, -0.0016051754355430603, -4.768360213347478e-06, -8.344646857949556e-07, 0.0, 0.0, -3.576278118089249e-07, -0.0009117737063206732, -3.576278118089249e-07, -1.19209