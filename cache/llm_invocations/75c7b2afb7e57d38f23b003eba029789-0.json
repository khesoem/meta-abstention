      nonlocal m_\n        # Forward edge\n        graph[u].append([v, cap, cost_val, len(graph[v])])\n        # Backward edge\n        graph[v].append([u, 0, -cost_val, len(graph[u]) - 1])\n        m_ += 1\n    \n    # Build layered graph\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            for j in aa[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    add_edge(u, v, 1, c + (x * 2 - 1) * d)\n    \n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            add_edge(u, v, k, 0 if i == 0 else c)\n    \n    # Connect source to starting nodes\n    for h in range(k):\n        add_edge(n_ - 1, ii[h] * t + 0, 1, 0)\n    \n    # Min cost max flow using Bellman-Ford (since there might be negative costs)\n    INF = float('inf')\n    \n    def bellman_ford(source, sink):\n        dist = [INF] * n_\n        prev_node = [-1] * n_ \n        prev_edge = [-1] * n_\n        dist[source] = 0\n        \n        for _ in range(n_ - 1):\n            updated = False\n            for u in range(n_):\n                if dist[u] == INF:\n                    continue\n                for idx, (v, cap, cost, _) in enumerate(graph[u]):\n                    if cap > 0 and dist[u] + cost < dist[v]:\n                        dist[v] = dist[u] + cost\n                        prev_node[v] = u\n                        prev_edge[v] = idx\n                        updated = True\n            if not updated:\n                break\n        \n        if dist[sink] == INF:\n            return None, None, None\n        \n        # Find minimum capacity along the path\n        path_flow = INF\n        v = sink\n        while v != source:\n            u = prev_node[v]\n            edge_idx = prev_edge[v]\n            path_flow = min(path_flow, graph[u][edge_idx][1])\n            v = u\n        \n        # Update residual capacities\n        v = sink\n        while v != source:\n            u = prev_node[v]\n            edge_idx = prev_edge[v]\n            # Reduce capacity of forward edge\n            graph[u][edge_idx][1] -= path_flow\n            # Increase capacity of backward edge\n            rev_idx = graph[u][edge_idx][3]\n            graph[v][rev_idx][1] += path_flow\n            v = u\n        \n        return dist[sink], path_flow, True\n    \n    total_cost = 0\n    total_flow = 0\n    \n    while True:\n        cost, flow, found = bellman_ford(n_ - 1, 0 * t + t - 1)\n        if not found:\n            break\n        total_cost += cost * flow\n        total_flow += flow\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-0.00021741411183029413, -1.5497195136049413e-06, -5.960462772236497e-07, -0.0022902467753738165, -0.001900891656987369, -0.07894978672266006, -0.6332620978355408, -0.18612457811832428, -7.152555099310121e-07, -0.06202599033713341, -0.6692629456520081, -0.0009136793087236583, -0.028238963335752487, -0.0032031440641731024, -0.0828297808766365, -0.13166236877441406, -6.210611172718927e-05, -5.602820692729438e-06, -0.6468884348869324, -0.18737223744392395, -3.6954811548639555e-06, -0.0001774868869688362, -4.529942543740617e-06, -2.407998726994265e-05, -0.001715261023491621, -0.38688066601753235, -5.030505417380482e-05, -2.0265558760002023e-06, -0.26651617884635925, -1.1920928244535389e-07, -2.288792165927589e-05, -7.152555099310121e-07, -0.007616409100592136, 0.0, -1.0728830375228426e-06, -0.0019290901254862547, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, -3.576278118089249e-07, -0.0008891443139873445, -9.83428253675811e-05, -0.0001234931987710297, -1.1920928244535389e-07, 0.0, -1.311301275563892e-06, 0.0, 0.0, -0.0002324311062693596, -3.2186455882765586e-06, -3.814689989667386e-06, -7.152555099310121e-07, -7.152555099310121e-07, -0.0003469580551609397, -4.291525328881107e-06, -3.6954811548