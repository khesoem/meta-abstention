 = g[v][i].c - g[v][i].f;\n      if (d[to] == INF && cf > 0)\n      {\n        d[to] = d[v] + 1;\n        q.push(to);\n      }\n    }\n  }\n  return d[t] != INF;\n}\n\nint dfs(int v, int curFlow)\n{\n  if (v == t) return curFlow;\n  for (int& i = ptr[v]; i < g[v].size(); ++i)\n  {\n    int to = g[v][i].to;\n    int cf = g[v][i].c - g[v][i].f, addFlow;\n    if (d[to] == d[v] + 1 && cf > 0 && (addFlow = dfs(to, min(curFlow, cf))))\n    {\n      g[v][i].f += addFlow;\n      g[to][g[v][i].rev].f -= addFlow;\n      return addFlow;\n    }\n  }\n  return 0;\n}\n\nint dinica()\n{\n  int flow = 0;\n  while (buildLevNet())\n  {\n    memset(ptr, 0, sizeof(ptr));\n    int add;\n    while ((add = dfs(s, INF)))\n      flow += add;\n  }\n  return flow;\n}\n\n\n\nqueue <pii> go;\nconst int X[] = {-1, 1, 0, 0};\nconst int Y[] = {0, 0, -1, 1};\nint dst[N][N][N][N], tbad;\nchar a[N][N], b[N][N];\npii bad;\nbool check(pii v)\n{\n  return v.f >= 0 && v.f < n && v.s >= 0 && v.s < n && a[v.f][v.s] != 'Y' && a[v.f][v.s] != 'Z';\n}\nvoid bfs(int xs, int ys)\n{\n  for (int i = 0; i < n; ++i)\n    for (int j = 0; j < n; ++j)\n      dst[xs][ys][i][j] = INF;\n  dst[xs][ys][xs][ys] = 0;\n  go.push(mp(xs, ys));\n  while (!go.empty())\n  {\n    pii v = go.front();\n    go.pop();\n    if (dst[xs][ys][v.f][v.s] == dst[bad.f][bad.s][v.f][v.s] && (bad.f != xs || bad.s != ys)) continue;\n    for (int i = 0; i < 4; ++i)\n    {\n      pii nv = mp(v.f + X[i], v.s + Y[i]);\n      if (check(nv) && dst[xs][ys][nv.f][nv.s] == INF && dst[xs][ys][v.f][v.s] + 1 <= dst[bad.f][bad.s][nv.f][nv.s])\n      {\n        dst[xs][ys][nv.f][nv.s] = dst[xs][ys][v.f][v.s] + 1;\n        go.push(nv);\n      }\n    }\n  }\n}\n\nint main()\n{\n  cin >> n >> tbad;\n  int px, py;\n  for (int i = 0; i < n; ++i)\n    for (int j  = 0; j < n; ++j)\n    {\n      cin >> a[i][j];\n      if (a[i][j] == 'Z') px = i, py = j;\n    }\n  for (int i = 0; i < n; ++i)\n    for (int j  = 0; j < n; ++j)\n      cin >> b[i][j];\n  bad = mp(px, py);\n  bfs(px, py);\n  for (int i = 0; i < n; ++i)\n    for (int j = 0; j < n; ++j)\n      dst[bad.f][bad.s][i][j] = min(dst[bad.f][bad.s][i][j], tbad);\n  for (int i = 0; i < n; ++i)\n    for (int j = 0; j < n; ++j)\n      if (check(mp(i, j))) bfs(i, j);\n  s = 0;\n  t = 2 * n * n + 1;\n  for (int i = 0; i < n; ++i)\n    for (int j = 0; j < n; ++j)\n    {\n      if (a[i][j] != '0') addEdge(s, i * n + j + 1, a[i][j] - '0');\n      if (b[i][j] != '0') addEdge(i * n + j + 1 + n * n, t, b[i][j] - '0');\n    }\n  for (int i = 0; i < n; ++i)\n    for (int j = 0; j < n; ++j)\n      for (int i1 = 0; i1 < n; ++i1)\n        for (int j1 = 0; j1 < n; ++j1)\n          if (check(mp(i, j)) && check(mp(i1, j1)) && dst[i][j][i1][j1] <= dst[px][py][i1][j1])\n            addEdge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF);\n  cout << dinica();\n\n/*\n2 60\n00\nZ1\n\n00\nZ1\n*/\n  return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    n, tbad = map(int, data[0].split())\n    a = []\n    b = []\n    \n    px, py = 0, 0\n    for i in range(1, n + 1):\n        row = data[i]\n        a.append(list(row))\n        for j in range(n):\n            if a[i-1][j] == 'Z':\n                px, py = i-1, j\n    \n    for i in range(n + 1, 2 * n + 1):\n        row = data[i]\n        b.append(list(row))\n    \n    bad = (px, py)\n    \n    INF = 10**9\n    SIZE = 2 * n * n + 2\n    s = 0\n    t = 2 * n * n + 1\n    \n    # Graph representation: adjacency list with edges\n    # Each edge: [to, capacity, flow, rev_index]\n    g = [[] for _ in range(SIZE)]\n    \n    def add_edge(v, u, cap):\n        g[v].append([u, cap, 0, len(g[u])])\n        g[u].append([v, 0, 0, len(g[v]) - 1])\n    \n    # Distance array for BFS levels\n    d = [INF] * SIZE\n    ptr = [0] * SIZE\n    \n    def bfs():\n        for i in range(SIZE):\n            d[i] = INF\n        d[s] = 0\n        q = deque()\n        q.append(s)\n        while q:\n            v = q.popleft()\n            for edge in g[v]:\n                to, cap, flow, rev = edge\n                cf = cap - flow\n                if d[to] == INF and cf > 0:\n                    d[to] = d[v] + 1\n                    q.append(to)\n        return d[t] != INF\n    \n    def dfs(v, cur_flow):\n        if v == t:\n            return cur_flow\n        for i in range(ptr[v], len(g[v])):\n            ptr[v] = i\n            to, cap, flow, rev = g[v][i]\n            cf = cap - flow\n            if d[to] == d[v] + 1 and cf > 0:\n                add_flow = dfs(to, min(cur_flow, cf))\n                if add_flow > 0:\n                    g[v][i][2] += add_flow\n                    g[to][rev][2] -= add_flow\n                    return add_flow\n        return 0\n    \n    def dinic():\n        flow = 0\n        while bfs():\n            ptr = [0] * SIZE\n            add_flow = dfs(s, INF)\n            while add_flow:\n                flow += add_flow\n                add_flow = dfs(s, INF)\n        return flow\n    \n    # Distance array for BFS from each cell\n    dst = [[[ [INF] * n for _ in range(n)] for _ in range(n)] for _ in range(n)]\n    \n    def check(v):\n        i, j = v\n        return 0 <= i < n and 0 <= j < n and a[i][j] != 'Y' and a[i][j] != 'Z'\n    \n    def bfs_dist(xs, ys):\n        for i in range(n):\n            for j in range(n):\n                dst[xs][ys][i][j] = INF\n        dst[xs][ys][xs][ys] = 0\n        q = deque()\n        q.append((xs, ys))\n        while q:\n            v = q.popleft()\n            if dst[xs][ys][v[0]][v[1]] == dst[bad[0]][bad[1]][v[0]][v[1]] and (bad != (xs, ys)):\n                continue\n            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                nv = (v[0] + dx, v[1] + dy)\n                if check(nv) and dst[xs][ys][nv[0]][nv[1]] == INF and dst[xs][ys][v[0]][v[1]] + 1 <= dst[bad[0]][bad[1]][nv[0]][nv[1]]:\n                    dst[xs][ys][nv[0]][nv[1]] = dst[xs][ys][v[0]][v[1]] + 1\n                    q.append(nv)\n    \n    # Run BFS from the bad cell\n    bfs_dist(px, py)\n    \n    # Update distances with tbad constraint\n    for i in range(n):\n        for j in range(n):\n            dst[bad[0]][bad[1]][i][j] = min(dst[bad[0]][bad[1]][i][j], tbad)\n    \n    # Run BFS from all valid cells\n    for i in range(n):\n        for j in range(n):\n            if check((i, j)):\n                bfs_dist(i, j)\n    \n    # Build flow network\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] != '0':\n                add_edge(s, i * n + j + 1, int(a[i][j]))\n            if b[i][j] != '0':\n                add_edge(i * n + j + 1 + n * n, t, int(b[i][j]))\n    \n    # Add edges between cells based on distance constraints\n    for i in range(n):\n        for j in range(n):\n            for i1 in range(n):\n                for j1 in range(n):\n                    if check((i, j)) and check((i1, j1)) and dst[i][j][i1][j1] <= dst[px][py][i1][j1]:\n                        add_edge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF)\n    \n    result = dinic()\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-8.77341881277971e-05, -1.0728830375228426e-06, -3.576278118089249e-07, -0.1433660089969635, -0.0015786340227350593, -2.3841855067985307e-07, -4.7205765440594405e-05, -0.00024339574156329036, -1.9073468138230965e-06, -0.0001113352773245424, -0.0019477697787806392, -0.31558963656425476, -0.14203126728534698, -5.400034933700226e-05, -3.099436753473128e-06, -0.06517137587070465, -0.332328200340271, -1.2636104656849056e-05, -7.390948667307384e-06, -0.016170891001820564, -0.0037073232233524323, -1.0728830375228426e-06, -6.4490144723095e-05, -1.1920928244535389e-07, -2.2649508537142538e-05,