 -= P;\n        return a;\n    }\n\n    static long mul_mod(long a, long b) {\n        return a * b % P;\n    }\n\n    static void add_to(long[] a, int idx, long b) {\n        a[idx] = add_mod(a[idx], b);\n    }\n\n    static void mul_self(long[] a, int idx, long b) {\n        a[idx] = mul_mod(a[idx], b);\n    }\n\n    // Overloaded for long[][] and long[][]\n    static void add_to(long[][] a, int i, int j, long b) {\n        a[i][j] = add_mod(a[i][j], b);\n    }\n\n    static void mul_self(long[][] a, int i, int j, long b) {\n        a[i][j] = mul_mod(a[i][j], b);\n    }\n\n    // For long[][] using long index\n    static void mul_self(long[][] dp2, int i, int j, long b) {\n        dp2[i][j] = mul_mod(dp2[i][j], b);\n    }\n\n    static void add_to(long[][] dp3, int i, int j, long b) {\n        dp3[i][j] = add_mod(dp3[i][j], b);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        P = Long.parseLong(st.nextToken());\n\n        int M = Math.max(n, m);\n        long[][] C = new long[M + 1][M + 1];\n        for (int i = 0; i <= M; i++) {\n            C[i][0] = 1;\n            for (int j = 1; j <= i; j++) {\n                C[i][j] = add_mod(C[i - 1][j], C[i - 1][j - 1]);\n            }\n        }\n\n        long[] dp1 = new long[m + 1];\n        long[] ile = new long[m + 1];\n        ile[0] = 1;\n\n        for (int i = 1; i <= m; i++) {\n            for (int j = 0; j < i; j++) {\n                long val = 0;\n                val = add_mod(val, mul_mod(dp1[j], ile[i - j - 1]));\n                val = add_mod(val, mul_mod(dp1[i - j - 1], ile[j]));\n                val = mul_mod(val, j + 1);\n                val = add_mod(val, mul_mod(mul_mod(ile[i - j - 1], ile[j]), (long) j * (j + 1) / 2));\n                val = mul_mod(val, C[i - 1][j]);\n                add_to(dp1, i, val);\n\n                val = C[i - 1][j];\n                val = mul_mod(val, ile[j]);\n                val = mul_mod(val, ile[i - j - 1]);\n                val = mul_mod(val, j + 1);\n                add_to(ile, i, val);\n            }\n            ile[i] = add_mod(ile[i], ile[i]);\n            dp1[i] = add_mod(dp1[i], dp1[i]);\n        }\n\n        long[][] dp2 = new long[n + 2][m + 1];\n        long[][] dp3 = new long[n + 2][m + 1];\n        dp2[0][0] = 1;\n        for (int i = 0; i <= n; i++) {\n            for (int j = 0; j <= m; j++) {\n                for (int k = 0; j + k <= m && i + k + 1 <= n + 1; k++) {\n                    long val = dp2[i][j];\n                    val = mul_mod(val, C[m - j][k]);\n                    val = mul_mod(val, ile[k]);\n                    add_to(dp2, i + k + 1, j + k, val);\n\n                    long val3 = dp3[i][j];\n                    val3 = mul_mod(val3, ile[k]);\n                    val3 = add_mod(val3, mul_mod(dp1[k], dp2[i][j]));\n                    val3 = mul_mod(val3, C[m - j][k]);\n                    add_to(dp3, i + k + 1, j + k, val3);\n                }\n            }\n        }\n\n        System.out.println(dp3[n + 1][m]);\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, 0.0, -1.811964830267243e-05, -1.2993727978027891e-05, -5.960462772236497e-07, -0.008615821599960327, -0.2014542669057846, 0.0, 0.0, -5.829164365422912e-05, -0.004237245302647352, -7.795983401592821e-05, 0.0, -1.5735502529423684e-05, -0.02988324873149395, -0.000720956246368587, -0.048867203295230865, -0.008269711397588253, -0.005167223978787661, -0.3228536546230316, 0.0, -0.006747792940586805, -0.0002703301142901182, -1.311301275563892e-06, -0.03804956376552582, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -1.1920922133867862e-06, 0.0, -0.00015853578224778175