p_p1 = p1 - min(p1, r2)\n        tmp_r2 = r2 - min(p1, r2)\n\n        # For minimum wins, first eliminate same-type matches (draws)\n        same_rock = min(r1, r2)\n        r1 -= same_rock\n        r2 -= same_rock\n        \n        same_scissors = min(s1, s2)\n        s1 -= same_scissors\n        s2 -= same_scissors\n        \n        same_paper = min(p1, p2)\n        p1 -= same_paper\n        p2 -= same_paper\n\n        # Now count remaining wins possible in worst case\n        min_wins = 0\n        \n        # Try to use leftovers to create wins\n        if r1 > 0 and s2 > 0:\n            use = min(r1, s2)\n            min_wins += use\n            r1 -= use\n            s2 -= use\n            \n        if s1 > 0 and p2 > 0:\n            use = min(s1, p2)\n            min_wins += use\n            s1 -= use\n            p2 -= use\n            \n        if p1 > 0 and r2 > 0:\n            use = min(p1, r2)\n            min_wins += use\n            p1 -= use\n            r2 -= use\n\n        return min_wins, max_wins\n\n    min_val, max_val = solve_game()\n    print(f\"{min_val} {max_val}\")\n\nif __name__ == \"__main__\":\n    main()\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <algorithm>\n\nint main() {\n    std::string line;\n    std::vector<std::string> data;\n    \n    while (std::getline(std::cin, line)) {\n        data.push_back(line);\n    }\n    \n    int rounds = std::stoi(data[0]);\n    std::vector<int> first_line;\n    std::vector<int> second_line;\n    \n    std::istringstream iss1(data[1]);\n    int num;\n    while (iss1 >> num) {\n        first_line.push_back(num);\n    }\n    \n    std::istringstream iss2(data[2]);\n    while (iss2 >> num) {\n        second_line.push_back(num);\n    }\n    \n    int r1 = first_line[0], s1 = first_line[1], p1 = firs