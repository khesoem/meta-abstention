][j] * qpow(100, MOD - 2) % MOD;\n        }\n\n    for(int i = 0; i < n; ++i)\n        for(int mask = 0; mask < (1 << n); ++mask) {\n            q[i][mask] = 1;\n            for(int k = 0; k < n; ++k) {\n                if((mask >> k) & 1)\n                    q[i][mask] = 1LL * q[i][mask] * p[k][i] % MOD;\n                else\n                    q[i][mask] = 1LL * q[i][mask] * (MOD + 1 - p[k][i]) % MOD;\n            }\n        }\n\n    map<ull,int> cur, nxt;\n    cur[1] = 1;\n    int M = 1 << n;\n\n    for(int i = 0; i < n; ++i) {\n        nxt.clear();\n        for(const auto &pr : cur) {\n            ull s = pr.first;\n            int val = pr.second;\n            for(int mask = 0; mask < M; ++mask) {\n                int delta = 1LL * val * q[i][mask] % MOD;\n                if(delta) addTo(nxt, transition(s, mask), delta);\n            }\n        }\n        cur.swap(nxt);\n    }\n\n    ull target;\n    if(n < 6) target = (1ull << (1 << n)) - 1;\n    else target = numeric_limits<ull>::max();\n\n    auto it = cur.find(target);\n    cout << (it == cur.end() ? 0 : it->second) << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n\n    static int qpow(long a, long b) {\n        long res = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) {\n                res = (res * a) % MOD;\n            }\n            a = (a * a) % MOD;\n            b >>= 1;\n        }\n        return (int) res;\n    }\n\n    static long transition(long s, int mask, int n) {\n        long t = s;\n        int M = 1 << n;\n        for (int j = 0; j < M; ++j) {\n            for (int k = 0; k < n; ++k) {\n                if (((j >> k) & 1) != 0 && ((mask >> k) & 1) != 0 && ((s >> (j ^ (1 << k))) & 1) != 0) {\n                    t |= (1L << j);\n                }\n            }\n        }\n        return t;\n    }\n\n    static void addTo(Map<Long, Integer> mp, long state, int val) {\n        if (val == 0) return;\n        mp.merge(state, val, (a, b) -> {\n            int sum = a + b;\n            if (sum >= MOD) sum -= MOD;\n            return sum;\n        });\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n\n        int[][] p = new int[n][n];\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                int prob = sc.nextInt();\n                p[i][j] = (int) ((1L * prob * qpow(100, MOD - 2)) % MOD);\n            }\n        }\n\n        int M = 1 << n;\n        int[][] q = new int[n][M];\n        for (int i = 0; i < n; ++i) {\n            for (int mask = 0; mask < M; ++mask) {\n                q[i][mask] = 1;\n                for (int k = 0; k < n; ++k) {\n                    if (((mask >> k) & 1) == 1) {\n                        q[i][mask] = (int) ((1L * q[i][mask] * p[k][i]) % MOD);\n                    } else {\n                        q[i][mask] = (int) ((1L * q[i][mask] * (MOD + 1 - p[k][i])) % MOD);\n                    }\n                }\n            }\n        }\n\n        Map<Long, Integer> cur = new HashMap<>();\n        Map<Long, Integer> nxt = new HashMap<>();\n        cur.put(1L, 1);\n\n        for (int i = 0; i < n; ++i) {\n            nxt.clear();\n            for (Map.Entry<Long, Integer> pr : cur.entrySet()) {\n                long s = pr.getKey();\n                int val = pr.getValue();\n                for (int mask = 0; mask < M; ++mask) {\n                    int delta = (int) ((1L * val * q[i][mask]) % MOD);\n                    if (delta != 0) {\n                        addTo(nxt, transition(s, mask, n), delta);\n                    }\n                }\n            }\n            Map<Long, Integer> temp = cur;\n            cur = nxt;\n            nxt = temp;\n        }\n\n