\n            for i in range(self.n):\n                if self.dist[i] < INF:\n                    self.pot[i] += self.dist[i]\n\n            add = INF\n            v = t\n            while v != s:\n                add = min(add, self.g[self.prevv[v]][self.preve[v]].cap)\n                v = self.prevv[v]\n\n            flow += add\n            v = t\n            while v != s:\n                e = self.g[self.prevv[v]][self.preve[v]]\n                e.cap -= add\n                self.g[v][e.rev].cap += add\n                total_cost += add * e.cost\n                v = self.prevv[v]\n\n        return flow, total_cost\n\n\ndef solve() -> None:\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    T = 500\n    N = n * T\n    mcf = FlowNetwork(N + 2)\n\n    # waiting edges\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c)\n\n    # sink edges\n    for i in range(T):\n        mcf.add_edge(i, N + 1, INF, 0)\n\n    # source to starting positions\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcf.add_edge(N, x * T, 1, 0)\n\n    # movement edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for j in range(T - 1):\n            cur = 1\n            for _ in range(k):\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c)\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c)\n                cur += 2\n\n    res_flow, res_cost = mcf.run(N, N + 1)\n    # assert res_flow == k\n    print(res_cost)\n\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0003373054, 0.0, -1.1920922e-06, -0.0015115038, -0.06339922, -0.018502733, -0.015077788, -0.9761668, -0.08925613, -0.69378763, -0.013823604, -0.990186, 0.0, -0.002