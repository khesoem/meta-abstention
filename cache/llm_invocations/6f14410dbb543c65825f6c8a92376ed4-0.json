{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <vector>\n#include <map>\nusing namespace std;\n\nconst int MOD = 1000000007;\nconst int MAXN = 33;\nint SZ;\n\nstruct Mat {\n    int a[MAXN][MAXN];\n    Mat() { memset(a, 0, sizeof(a)); }\n};\n\nMat identity() {\n    Mat r;\n    for(int i=0;i<SZ;i++) r.a[i][i] = 1;\n    return r;\n}\n\nMat mul(const Mat& A, const Mat& B) {\n    static long long tmp[MAXN][MAXN];\n    memset(tmp, 0, sizeof(tmp));\n    const long long LIM = 8000000000000000000LL;\n    for(int k=0;k<SZ;k++)\n        for(int i=0;i<SZ;i++) {\n            if(A.a[i][k] == 0) continue;\n            for(int j=0;j<SZ;j++) {\n                tmp[i][j] += 1LL * A.a[i][k] * B.a[k][j];\n                if(tmp[i][j] >= LIM) tmp[i][j] %= MOD;\n            }\n        }\n    Mat C;\n    for(int i=0;i<SZ;i++)\n        for(int j=0;j<SZ;j++)\n            C.a[i][j] = (int)(tmp[i][j] % MOD);\n    return C;\n}\n\nMat rot(const Mat& A, int d) {\n    Mat B;\n    int K = SZ - 1;\n    for(int i=0;i<SZ;i++)\n        for(int j=0;j<SZ;j++) {\n            int ni = (i == K) ? K : (i + d) % K;\n            int nj = (j == K) ? K : (j + d) % K;\n            B.a[ni][nj] = A.a[i][j];\n        }\n    return B;\n}\n\nmap<int, Mat> memo;\n\nMat get_power(int idx) {\n    auto it = memo.find(idx);\n    if(it != memo.end()) return it->second;\n    Mat now = identity();\n    for(int j=0;j<SZ-1;j++)\n        now = mul(now, rot(get_power(idx - 1), j));\n    memo[idx] = now;\n    return now;\n}\n\nint main() {\n    long long n;\n    int k;\n    scanf(\"%lld%d\", &n, &k);\n    SZ = k + 1;\n    vector<int> digits;\n    while(n) {\n        digits.push_back((int)(n % k));\n        n /= k;\n    }\n    Mat a0;\n    for(int j=0;j<=k;j++) {\n        a0.a[0][j] = 1;\n        a0.a[j][j] = 1;\n    }\n    memo.clear();\n    memo[0] = a0;\n    Mat ans = identity();\n    int add = 0;\n    for(int i=(int)digits.size()-1;i>=0;i--) {\n        Mat cur = get_power(i);\n        for(int j=0;j<digits[i];j++)\n            ans = mul(ans, rot(cur, (j + add) % k));\n        add = (add + digits[i]) % k;\n    }\n    int ret = 0;\n    for(int i=0;i<=k;i++) {\n        ret += ans.a[i][k];\n        if(ret >= MOD) ret -= MOD;\n    }\n    printf(\"%d\\n\", ret);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nMOD = 1000000007\nMAXN = 33\nSZ = 0\n\nclass Mat:\n    def __init__(self):\n        self.a = [[0]*MAXN for _ in range(MAXN)]\n\ndef identity():\n    r = Mat()\n    for i in range(SZ):\n        r.a[i][i] = 1\n    return r\n\ndef mul(A, B):\n    LIM = 8000000000000000000\n    tmp = [[0]*MAXN for _ in range(MAXN)]\n    for k in range(SZ):\n        for i in range(SZ):\n            if A.a[i][k] == 0:\n                continue\n            for j in range(SZ):\n                tmp[i][j] += A.a[i][k] * B.a[k][j]\n                if tmp[i][j] >= LIM:\n                    tmp[i][j] %= MOD\n    C = Mat()\n    for i in range(SZ):\n        for j in range(SZ):\n            C.a[i][j] = tmp[i][j] % MOD\n    return C\n\ndef rot(A, d):\n    B = Mat()\n    K = SZ - 1\n    for i in range(SZ):\n        for j in range(SZ):\n            ni = K if i == K else (i + d) % K\n            nj = K if j == K else (j + d) % K\n            B.a[ni][nj] = A.a[i][j]\n    return B\n\nmemo = {}\n\ndef get_power(idx):\n    if idx in memo:\n        return memo[idx]\n    now = identity()\n    for j in range(SZ-1):\n        now = mul(now, rot(get_power(idx - 1), j))\n    memo[idx] = now\n    return now\n\ndef main():\n    global SZ, memo\n    n, k = map(int, input().split())\n    SZ = k + 1\n    digits = []\n    while n:\n        digits.append(n % k)\n        n //= k\n    a0 = Mat()\n    for j in range(k+1):\n        a0.a[0][j] = 1\n        a0.a[j][j] = 1\n    memo.clear()\n    memo[0] = a0\n    ans = identity()\n    add = 0\n    for i in range(len(digits)-1, -1, -1):\n        cur = get_power(i)\n        for j in range(digits[i]):\n            ans = mul(ans, rot(cur, (j + add) % k))\n        add = (add + digits[i]) % k\n    ret = 0\n    for i in range(k+1):\n        ret += ans.a[i][k]\n        if ret >= MOD:\n            ret -= MOD\n    print(ret)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.7881378e-06, 0.0, -3.576278e-07, -0.0025060934, -0.0835349, -7.152555e-07, -2.384183e-06, -0.000120394136, 0.0, -3.576278e-07, -3.576278e-07, -0.023797363, -0.0008044583, -7.1284616e-05, -1.1920922e-06, -4.7683704e-07, -0.000100249985, -0.693581, -0.0005448764, -2.9802277e-06, -0.03808158, -0.00082220597, -0.0096423365, -0.023325808, -6.5564896e-06, -2.384183e-06, -4.7683704e-07, -0.0005421361, -2.0265559e-06, 0.0, -4.7683704e-07, 0.0, -0.061979268, -1.1920928e-07, -0.0003467197, -5.960463e-07, 0.0, -3.6477377e-05, -1.1920928e-07, -0.2544008, -0.00015376817, 0.0, 0.0, 0.0, -3.576278e-07, 0.0, -9.5367386e-07, -1.28745205e-05, 0.0, -0.030092064, -0.006748267, -1.1920858e-05, -1.12056105e-05, 0.0, -0.0025007424, -2.384