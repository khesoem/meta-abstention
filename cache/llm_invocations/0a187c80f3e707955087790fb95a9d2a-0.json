\t\twhile(x!=S)edge[id[x]].val-=mn,edge[id[x]^1].val+=mn,x=fr[x];\n\t\treturn true;\n\t}\n}\nusing namespace MCMF;\nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&r,&c,&d),memset(head,-1,sizeof(head)),S=(r+n+1)*n+1,T=(r+n+1)*n+2;\n\tfor(int i=1,x;i<=r;i++)scanf(\"%d\",&x),occ[x]++;\n\tfor(int i=1;i<=m;i++)scanf(\"%d%d\",&p[i].first,&p[i].second);\n\tfor(int i=0;i<r+n;i++)for(int j=1;j<=m;j++)for(int k=1;k<=r;k++)ae(i*n+p[j].first,(i+1)*n+p[j].second,1,(2*k-1)*d),ae(i*n+p[j].second,(i+1)*n+p[j].first,1,(2*k-1)*d);\n\tfor(int i=1;i<=r+n;i++){\n\t\tae(i*n+1,T,0x3f3f3f3f,i*c);\n\t\tfor(int j=2;j<=n;j++)ae((i-1)*n+j,i*n+j,0x3f3f3f3f,0);\n\t}\t\n\tfor(int i=1;i<=n;i++)ae(S,i,occ[i],0);\n\twhile(SPFA());\n\tprintf(\"%d\\n\",cost);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static int n, m, r, c, d;\n    static int[] occ = new int[100];\n    static Pair[] p = new Pair[100];\n\n    static class Pair {\n        int first, second;\n        Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    static class MCMF {\n        static final int N = 10000;\n        static final int M = 20000000;\n        int[] head = new int[N];\n        int cnt;\n        int[] dis = new int[N];\n        int[] fr = new int[N];\n        int[] id = new int[N];\n        int S, T;\n        long cost;\n\n        class Edge {\n            int to, next, val, cost;\n        }\n\n        Edge[] edge = new Edge[M];\n\n        public MCMF() {\n            for (int i = 0; i < N; i++) {\n                head[i] = -1;\n            }\n            edge = new Edge[M];\n            for (int i = 0; i < M; i++) {\n                edge[i] = new Edge();\n            }\n        }\n\n        void ae(int u, int v, int w, int cst) {\n            edge[cnt].to = v;\n            edge[cnt].next = head[u];\n            edge[cnt].val = w;\n            edge[cnt].cost = cst;\n            head[u] = cnt++;\n            edge[cnt].to = u;\n            edge[cnt].next = head[v];\n            edge[cnt].val = 0;\n            edge[cnt].cost = -cst;\n            head[v] = cnt++;\n        }\n\n        boolean SPFA() {\n            Arrays.fill(dis, Integer.MAX_VALUE / 2);\n            boolean[] in = new boolean[N];\n            dis[S] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(S);\n            in[S] = true;\n\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                in[x] = false;\n                for (int i = head[x]; i != -1; i = edge[i].next) {\n                    if (edge[i].val == 0) continue;\n                    if (dis[edge[i].to] > dis[x] + edge[i].cost) {\n                        dis[edge[i].to] = dis[x] + edge[i].cost;\n                        fr[edge[i].to] = x;\n                        id[edge[i].to] = i;\n                        if (!in[edge[i].to]) {\n                            in[edge[i].to] = true;\n                            q.offer(edge[i].to);\n                        }\n                    }\n                }\n            }\n            if (dis[T] == Integer.MAX_VALUE / 2) return false;\n            int x = T, mn = Integer.MAX_VALUE / 2;\n            while (x != S) {\n                mn = Math.min(mn, edge[id[x]].val);\n                x = fr[x];\n            }\n            cost += (long) dis[T] * mn;\n            x = T;\n            while (x != S) {\n                edge[id[x]].val -= mn;\n                edge[id[x] ^ 1].val += mn;\n                x = fr[x];\n            }\n            return true;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        r = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        for (int i = 0; i < 100; i++) {\n            occ[i] = 0;\n        }\n\n        for (int i = 0; i < 100; i++) {\n            p[i] = new Pair(0, 0);\n        }\n\n        for (int i = 0; i < r; i++) {\n            int x = sc.nextInt();\n            occ[x]++;\n        }\n\n        for (int i = 1; i <= m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            p[i] = new Pair(x, y);\n        }\n\n        int size = (r + n) * n + 3;\n        int S = (r + n + 1) * n + 1;\n        int T = (r + n + 1) * n + 2;\n\n        MCMF mf = new MCMF();\n        mf.S = S;\n        mf.T = T;\n\n        for (int i = 0; i < size; i++) {\n            mf.head[i] = -1;\n        }\n\n        for (int i = 0; i <= r + n; i++) {\n            for (int j = 1; j <= m; j++) {\n                for (int k = 1; k <= r; k++) {\n                    mf.ae(i * n + p[j].first, (i + 1) * n + p[j].second,1,(2 * k - 1) * d);\n                    mf.ae(i * n + p[j].second, (i + 1) * n + p[j].first,1,(2 * k - 1) * d);\n                }\n            }\n        }\n        for (int i = 1; i <= r + n; i++) {\n            mf.ae(i * n + 1, T, Integer.MAX_VALUE / 2, i * c);\n            for (int j = 2; j <= n; j++) {\n                mf.ae((i - 1) * n + j, i * n + j, Integer.MAX_VALUE / 2, 0);\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            mf.ae(S, i, occ[i], 0);\n        }\n\n        while (mf.SPFA());\n\n        System.out.println(mf.cost);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0002692032721824944, -0.00024335073248948902, -1.0280383548888494e-06, -6.968934758333489e-05, -3.054500666621607e-06, -3.128163257315464e-07, -0.0009117019944824278, -0.8498421907424927, -0.0004895264864899218, -4.320199877838604e-07, -0.042049139738082886, -0.04307467117905617, -0.0031135452445596457, -0.00046725376159884036, -0.03897210955619812, -6.32523515378125e-05, -0.009765179827809334, 0.0, -4.320199877838604e-07, -9.