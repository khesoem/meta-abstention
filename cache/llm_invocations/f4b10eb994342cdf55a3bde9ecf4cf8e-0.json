n    int c50, c100, b, n;\n    long long am;\n    vector<Node*> s;\n    \n    Node(int x, int y, int z) : c50(x), c100(y), b(z), n(0), am(0) {}\n};\n\nlong long modPow(long long base, long long exp, long long mod) {\n    long long result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) {\n            result = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nlong long modInverse(long long a, long long mod) {\n    return modPow(a, mod - 2, mod);\n}\n\nint main() {\n    // Precompute factorials and combinations\n    vector<long long> f(51);\n    f[0] = 1;\n    for (int i = 1; i < 51; i++) {\n        f[i] = (f[i-1] * i) % MOD;\n    }\n    \n    vector<vector<long long>> c(51, vector<long long>(51, 0));\n    for (int i = 0; i < 51; i++) {\n        c[i][0] = 1;\n    }\n    for (int i = 1; i < 51; i++) {\n        for (int j = 1; j <= i; j++) {\n            long long denom = (f[j] * f[i-j]) % MOD;\n            long long invDenom = modInverse(denom, MOD);\n            c[i][j] = (f[i] * invDenom) % MOD;\n        }\n    }\n    \n    int n, k;\n    cin >> n >> k;\n    \n    int c50 = 0, c100 = 0;\n    for (int i = 0; i < n; i++) {\n        int val;\n        cin >> val;\n        if (val == 100) {\n            c100++;\n        } else {\n            c50++;\n        }\n    }\n    \n    // Create nodes\n    vector<vector<vector<Node*>>> ns(c50 + 1, \n        vector<vector<Node*>>(c100 + 1, \n            vector<Node*>(2, nullptr)));\n    \n    for (int i = 0; i <= c50; i++) {\n        for (int j = 0; j <= c100; j++) {\n            ns[i][j][0] = new Node(i, j, 0);\n            ns[i][j][1] = new Node(i, j, 1);\n        }\n    }\n    \n    // Build graph\n    for (int i = 0; i <= c50; i++) {\n        for (int j = 0; j <= c100; j++) {\n            int p50c = min(k / 50, i);\n            int p100c = min(k / 100, j);\n            for (int x = p100c; x >= 0; x--) {\n                for (int y = min(p50c, (k - 100 * x) / 50); y >= 0; y--) {\n                    if (y == 0 && x == 0) continue;\n                    ns[i][j][0]->s.push_back(ns[i-y][j-x][1]);\n                    ns[i-y][j-x][1]->s.push_back(ns[i][j][0]);\n                }\n            }\n        }\n    }\n    \n    // BFS with dynamic programming\n    queue<Node*> q;\n    ns[c50][c100][0]->n = 1;\n    ns[c50][c100][0]->am = 1;\n    q.push(ns[c50][c100][0]);\n    \n    while (!q.empty()) {\n        Node* cur = q.front();\n        q.pop();\n        \n        for (Node* ch : cur->s) {\n            if (ch->n == 0 || ch->n == cur->n + 1) {\n                int i_idx = (cur->b == 0) ? cur->c50 : (c50 - cur->c50);\n                int j_idx = abs(cur->c50 - ch->c50);\n                long long p1 = c[i_idx][j_idx];\n                \n                i_idx = (cur->b == 0) ? cur->c100 : (c100 - cur->c100);\n                j_idx = abs(cur->c100 - ch->c100);\n                long long p2 = c[i_idx][j_idx];\n                \n                ch->am = (ch->am + (cur->am * ((p1 * p2) % MOD)) % MOD) % MOD;\n                \n                if (ch->n == 0) {\n                    ch->n = cur->n + 1;\n                    q.push(ch);\n                }\n            }\n        }\n    }\n    \n    cout << ns[0][0][1]->n - 1 << \"\\n\" << ns[0][0][1]->am << endl;\n    \n    // Clean up memory\n    for (int i = 0; i <= c50; i++) {\n        for (int j = 0; j <= c100; j++) {\n            delete ns[i][j][0];\n            delete ns[i][j][1];\n        }\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013684290752280504, -9.775113539944869e-06, -3.933898824470816e-06, -0.0003831844369415194, -8.344646857949556e-07, -0.0002356490003876388, -4.410734163684538e-06, -3.2186455882765586e-06, -5.960462772236497e-07, -0.028407221660017967, -4.768370445162873e-07, -6.508615479106084e-05, -2.3841855067985307e-07, -0.019933028146624565, -2.9802276912960224e-06, -7.5814