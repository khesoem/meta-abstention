}\n\tans += incf[t] * dis[t];\n}\nint main() {\n\tscanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d), t = (n + k - 1) * n + 1;\n\tfor(int i = 1, x; i <= k; i++) scanf(\"%d\", &x), add(s, x, 1, 0);\n\tfor(int i = 1, x, y; i <= m; i++) {\n\t\tscanf(\"%d%d\", &x, &y);\n\t\tfor(int j = 1; j <= n + k; j++)\n\t\t\tfor(int h = 1; h <= k; h++) {\n\t\t\t\tadd(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n\t\t\t\tadd(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c);\n\t\t\t}\n\t}\n\tfor(int i = 1; i < n + k; i++) {\n\t\tfor(int j = 2; j <= n; j++)\n\t\t\tadd(j + (i - 1) * n, j + i * n, INF, c);\n\t\tadd(1 + (i - 1) * n, 1 + i * n, INF, 0);\n\t}\n\tfor(; spfa();) update();\n\tprintf(\"%d\\n\", ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    \n    idx = 0\n    n = data[idx]; idx += 1\n    m = data[idx]; idx += 1\n    k = data[idx]; idx += 1\n    c = data[idx]; idx += 1\n    d = data[idx]; idx += 1\n    \n    t = (n + k - 1) * n + 1\n    s = 0\n    \n    # Initialize graph structures\n    N = 10000010\n    INF = 0x3f3f3f3f\n    \n    hed = [-1] * N\n    to = [0] * N\n    nxt = [0] * N\n    val = [0] * N\n    w = [0] * N\n    cnt = [1]  # Using list to allow modification in nested function\n    \n    def add(x, y, z, v):\n        cnt[0] += 1\n        i = cnt[0]\n        to[i] = y\n        nxt[i] = hed[x]\n        hed[x] = i\n        val[i] = z\n        w[i] = v\n        \n        cnt[0] += 1\n        i = cnt[0]\n        to[i] = x\n        nxt[i] = hed[y]\n        hed[y] = i\n        val[i] = 0\n        w[i] = -v\n    \n    # Read k values\n    for i in range(1, k + 1):\n        x = data[idx]; idx += 1\n        add(s, x, 1, 0)\n    \n    # Read m edges\n    for _ in range(m):\n        x = data[idx]; idx += 1\n        y = data[idx]; idx += 1\n        for j in range(1, n + k + 1):\n            for h in range(1, k + 1):\n                cost = d * h * 2 - d + c\n                add(x + (j - 1) * n, y + j * n, 1, cost)\n                add(y + (j - 1) * n, x + j * n, 1, cost)\n    \n    # Add internal edges\n    for i in range(1, n + k):\n        for j in range(2, n + 1):\n            add(j + (i - 1) * n, j + i * n, INF, c)\n        add(1 + (i - 1) * n, 1 + i * n, INF, 0)\n    \n    # SPFA and min cost max flow\n    dis = [INF] * N\n    incf = [0] * N\n    pre = [0] * N\n    inq = [False] * N\n    \n    def spfa():\n        for i in range(N):\n            incf[i] = 0\n            dis[i] = INF\n            inq[i] = False\n        \n        q = deque()\n        q.append(s)\n        incf[s] = INF\n        inq[s] = True\n        dis[s] = 0\n        \n        while q:\n            u = q.popleft()\n            inq[u] = False\n            i = hed[u]\n            while i != -1:\n                if val[i] == 0 or dis[to[i]] <= dis[u] + w[i]:\n                    i = nxt[i]\n                    continue\n                dis[to[i]] = dis[u] + w[i]\n                incf[to[i]] = min(incf[u], val[i])\n                pre[to[i]] = i\n                if not inq[to[i]]:\n                    inq[to[i]] = True\n                    q.append(to[i])\n                i = nxt[i]\n        \n        return dis[t] != INF\n    \n    ans = 0\n    \n    def update():\n        nonlocal ans\n        tmp = t\n        while tmp != s:\n            i = pre[tmp]\n            val[i] -= incf[t]\n            val[i ^ 1] += incf[t]\n            tmp = to[i ^ 1]\n        ans += incf[t] * dis[t]\n    \n    while spfa():\n        update()\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014757021563127637, -8.344646857949556e-07, -1.1920928244535389e-07, -0.0005822870298288763, -0.000934045237954706, -5.960462772236497e-07, -0.00