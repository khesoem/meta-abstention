ion {\n            if (st == null || !st.hasMoreTokens()) {\n                String line = br.readLine();\n                st = new StringTokenizer(line);\n            }\n            return st.nextToken();\n        }\n\n        public int nextInt() throws IOException {\n            String next = next();\n            return Integer.parseInt(next);\n        }\n\n        public long nextLong() throws IOException {\n            String next = next();\n            return Long.parseLong(next);\n        }\n    }\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport io\n\nclass InputScanner:\n    def __init__(self):\n        self.br = io.TextIOWrapper(sys.stdin.buffer, encoding='utf-8')\n        self.st = None\n    \n    def next(self):\n        while self.st is None or not self.st:\n            line = self.br.readline()\n            if not line:\n                return None\n            self.st = line.strip().split()\n        return self.st.pop(0)\n    \n    def nextInt(self):\n        return int(self.next())\n    \n    def nextLong(self):\n        return int(self.next())\n\ndef main():\n    is_scanner = InputScanner()\n    try:\n        s = is_scanner.next()\n        if s is None:\n            return\n        tab = list(s)\n        c = tab[0]\n        counter = 1\n        result = 0\n        for i in range(1, len(tab)):\n            if tab[i] == c:\n                counter += 1\n            else:\n                if counter % 2 == 0:\n                    result += 1\n                counter = 1\n                c = tab[i]\n        if counter % 2 == 0:\n            result += 1\n        print(result)\n    except Exception as e:\n        print(e)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.83045873302035e-05, -5.960462772236497e-07, 0.0, -0.0004418112221173942, -6.818