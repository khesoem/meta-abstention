    int v=e.to;\n                    if(dist[v] > dist[u] + e.cost) {\n                        dist[v] = dist[u] + e.cost;\n                        prevnode[v]=u;\n                        prevedge[v]=i;\n                        curflow[v]=min(curflow[u], e.cap-e.f);\n                        if(!inq[v]) {\n                            q.push(v);\n                            inq[v]=1;\n                        }\n                    }\n                }\n            }\n            if(dist[t]==INT_MAX) break;\n            int df=min(curflow[t], INF-flow);\n            flow+=df;\n            for(int v=t; v!=s; v=prevnode[v]) {\n                Edge &e=adj[prevnode[v]][prevedge[v]];\n                e.f+=df;\n                adj[v][e.rev].f-=df;\n                flowCost+=df*e.cost;\n            }\n        }\n        return {flow, flowCost};\n    }\n};\n\nint main(){\n    int n,m,k,c,d;\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    MCF nt(6+107*n);\n    for(int _=0;_<k;++_) {\n        int x; scanf(\"%d\",&x); --x;\n        nt.addEdge(0,1+x,1,0);\n    }\n    for(int _=0;_<m;++_) {\n        int x,y; scanf(\"%d%d\",&x,&y); --x; --y;\n        for(int i=0;i<105;++i)\n            for(int j=0;j<51;++j) {\n                nt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n                nt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n            }\n    }\n    for(int i=0;i<105;++i)\n        for(int j=0;j<n;++j)\n            nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n    for(int i=0;i<105;++i)\n        nt.addEdge(1+i*n,1+105*n,51,0);\n    auto ans=nt.minCostFlow(0,1+105*n);\n    printf(\"%d\\n\",ans.second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class MCF {\n        int n;\n        static class Edge {\n            int to, f, cap, cost, rev;\n            Edge(int to, int f, int cap, int cost, int rev) {\n                this.to = to;\n                this.f = f;\n                this.cap = cap;\n                this.cost = cost;\n                this.rev = rev;\n            }\n        }\n        ArrayList<ArrayList<Edge>> adj;\n        MCF(int n) {\n            this.n = n;\n            adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        }\n        void addEdge(int s, int t, int cap, int cost) {\n            Edge a = new Edge(t, 0, cap, cost, adj.get(t).size());\n            Edge b = new Edge(s, 0, 0, -cost, adj.get(s).size());\n            adj.get(s).add(a);\n            adj.get(t).add(b);\n        }\n        int[] minCostFlow(int s, int t) {\n            int flow = 0, flowCost = 0;\n            int INF = 1_000_000_000;\n            int[] dist = new int[n];\n            int[] prevedge = new int[n];\n            int[] prevnode = new int[n];\n            int[] curflow = new int[n];\n            while (flow < INF) {\n                Arrays.fill(dist, Integer.MAX_VALUE);\n                boolean[] inq = new boolean[n];\n                Queue<Integer> q = new LinkedList<>();\n                dist[s] = 0;\n                curflow[s] = Integer.MAX_VALUE;\n                q.offer(s);\n                inq[s] = true;\n                while (!q.isEmpty()) {\n                    int u = q.poll();\n                    inq[u] = false;\n                    for (int i = 0; i < adj.get(u).size(); i++) {\n                        Edge e = adj.get(u).get(i);\n                        if (e.cap <= e.f) continue;\n                        int v = e.to;\n                        if (dist[v] > dist[u] + e.cost) {\n                            dist[v] = dist[u] + e.cost;\n                            prevnode[v] = u;\n                            prevedge[v] = i;\n                            curflow[v] = Math.min(curflow[u], e.cap - e.f);\n                            if (!inq[v]) {\n                          