 (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                char c = sci[i].charAt(j);\n                if (c == 'Z') {\n                    rx = i;\n                    ry = j;\n                } else if (c >= '0' && c <= '9') {\n                    pos.add(new int[]{i, j});\n                    lc.add(lab[i].charAt(j) - '0');\n                    scList.add(c - '0');\n                }\n            }\n        }\n\n        int m = pos.size();\n        for (int i = 0; i < 250; i++) Arrays.fill(cap[i], 0);\n\n        for (int i = 0; i < m; i++) {\n            cap[0][i + 1] = scList.get(i);\n            cap[m + 1 + i][2 * m + 1] = lc.get(i);\n        }\n\n        pre();\n        for (int a = 0; a < 12; a++)\n            for (int b = 0; b < 12; b++)\n                for (int c = 0; c < 12; c++)\n                    for (int d = 0; d < 12; d++)\n                        Arrays.fill(mem[a][b][c][d], -1);\n\n        for (int i = 0; i < m; i++) {\n            for (int j = 0; j < m; j++) {\n                if (canReach(pos.get(i)[0], pos.get(i)[1], pos.get(j)[0], pos.get(j)[1], 0)) {\n                    cap[i + 1][m + 1 + j] = 1000;\n                }\n            }\n        }\n\n        int flow = 0;\n        while (findPath(0, 2 * m + 1)) {\n            int cur = 2 * m + 1;\n            int nflow = 1000000;\n            while (par[cur] >= 0) {\n                nflow = Math.min(nflow, cap[par[cur]][cur]);\n                cur = par[cur];\n            }\n            cur = 2 * m + 1;\n            while (par[cur] >= 0) {\n                cap[par[cur]][cur] -= nflow;\n                cap[cur][par[cur]] += nflow;\n                cur = par[cur];\n            }\n            flow += nflow;\n        }\n\n        System.out.println(flow);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.5549337863922119, -0.12740746140480042, -0.0007313199457712471, -1.0728830375228426e-06, -1.1920928244535389e-