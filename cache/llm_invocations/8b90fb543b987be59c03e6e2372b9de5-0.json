epth > 1) {\n        if (10LL * current * MAX_BOUND > N_val &&\n            1LL * (current + 1) * MAX_BOUND - 1 <= N_val) {\n            for (int k = 0; k < 7; ++k) {\n                lli value = (C_val - current * ten_pow[k]) % MOD_A;\n                if (value < 0) value += MOD_A;\n                int num = static_cast<int>(value);\n                auto iter = lower_bound(container[k].begin(), container[k].end(),\n                                        MOD_A - num);\n                int pos = distance(container[k].begin(), iter);\n                int part1 = static_cast<int>(1LL * num * container[k].size() % MOD_B);\n                int part2 = arr_sum[k];\n                total_ans = union_mod(total_ans, union_mod(part1, part2, MOD_B), MOD_B);\n                int part3 = static_cast<int>(1LL * MOD_A * (container[k].size() - pos) % MOD_B);\n                total_ans = difference_mod(total_ans, part3, MOD_B);\n            }\n            C_val += node_count;\n            return;\n        }\n        ++C_val;\n        int diff = static_cast<int>((C_val - current) % MOD_A + MOD_A) % MOD_A;\n        total_ans = union_mod(total_ans, diff, MOD_B);\n    }\n    for (int digit = (depth == 1 ? 1 : 0); digit <= 9; ++digit) {\n        explore(depth + 1, current * 10 + digit);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N_val;\n    ten_pow[0] = 1;\n    for (int i = 1; i < 9; ++i) ten_pow[i] = 10 * ten_pow[i - 1];\n    traverse(1, 0);\n    for (int i = 0; i < 7; ++i) {\n        sort(container[i].begin(), container[i].end());\n    }\n    explore(1, 0);\n    cout << total_ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD_A = 998244353\nMOD_B = 1000000007\nMAX_D = 2000000\nMAX_BOUND = 1000000\n\nN_val = 0\nC_val = 0\nnode_count = 0\ntotal_ans = 0\nupper_li