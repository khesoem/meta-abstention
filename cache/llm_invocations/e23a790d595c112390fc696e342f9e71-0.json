st[v] < d) continue;\n            for (int e = head[v]; e != -1; e = nxt[e]) {\n                Edge &edge = edges[e];\n                if (edge.cap > 0 && dist[edge.to] > dist[v] + edge.cost + potential[v] - potential[edge.to]) {\n                    dist[edge.to] = dist[v] + edge.cost + potential[v] - potential[edge.to];\n                    prevv[edge.to] = v;\n                    preve[edge.to] = e;\n                    pq.push({dist[edge.to], edge.to});\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        for (int v = 0; v < n; ++v) potential[v] += dist[v];\n        ll d = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            d = min(d, edges[preve[v]].cap);\n        }\n        flow += d;\n        price += d * potential[t];\n        for (int v = t; v != s; v = prevv[v]) {\n            Edge &e = edges[preve[v]];\n            e.cap -= d;\n            edges[e.rev].cap += d;\n        }\n    }\n    return flow;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n    head.assign(sink + 1, -1);\n    nxt.clear();\n    edges.clear();\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                add_edge(i + (t-1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            ll cost = (j+1)*(j+1) - j*j;\n            for (int t = 1; t < T; ++t) {\n                add_edge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                add_edge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n            }\n