get(e)) {\n                    Edge edge = edges.get(e);\n                    if (edge.cap > 0 && dist[edge.to] > dist[v] + edge.cost + potential[v] - potential[edge.to]) {\n                        dist[edge.to] = dist[v] + edge.cost + potential[v] - potential[edge.to];\n                        prevv[edge.to] = v;\n                        preve[edge.to] = e;\n                        pq.add(new Pair(dist[edge.to], edge.to));\n                    }\n                }\n            }\n            if (dist[t] == INF) break;\n            for (int v = 0; v < n; ++v) potential[v] += dist[v];\n            long d = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = Math.min(d, edges.get(preve[v]).cap);\n            }\n            flow += d;\n            price[0] += d * potential[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = edges.get(preve[v]);\n                e.cap -= d;\n                edges.get(e.rev).cap += d;\n            }\n        }\n        return flow;\n    }\n\n    static class Pair implements Comparable<Pair> {\n        long dist;\n        int node;\n        Pair(long d, int n) {\n            dist = d;\n            node = n;\n        }\n        public int compareTo(Pair o) {\n            return Long.compare(this.dist, o.dist);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        final int source = 0;\n        final int sink = n * T + 1;\n        head = new int[sink + 1];\n        Arrays.fill(head, -1);\n        nxt = new ArrayList<>();\n        edges = new ArrayList<>();\n\n        for (int i = 0; i < k; ++i) {\n            int a = sc.nextInt();\n            add_edge(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; ++t) {\n            add_edge(1 + t * n, sink, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; ++i) {\n                    add_edge(i + (t - 1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; ++j) {\n                long cost = 2L * j + 1; // (j+1)^2 - j^2\n                for (int t = 1; t < T; ++t) {\n                    add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                    add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n\n        long[] price = new long[1];\n        long flow = min_cost_flow(source, sink, price, sink + 1);\n        // assert flow == k; // optional\n        System.out.println(price[0]);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.634490556374658e-05, 0.0, -1.1920928244535389e-07, -0.00015627116954419762, -0.002434982219710946, 0.0, -0.0002037079248111695, -0.06247281655669212, -6.580135959666222e-05, 0.0, -1.5258672647178173e-05, -0.011052930727601051, -0.00012730741582345217, -0.008784105069935322, -0.038364410400390625, -7.545663538621739e-05, 0.0, -1.1920928244535389e-07, -0.008615939877927303, -0.005234939511865377, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -1.7881377516459906e-06, 0.0, -0.0009135602158494294, 0.0, 0.0, -3.576278118089249e-07, 0.0, -1.07287787614041e-05, -1.156323378381785e-05, 0.0, -1.1920928244535389e-07, -6.4490144723095e-05, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -3.3378546504536644e-06, 0.0, 0.0, -0.05488930270075798, 0.0, -4.291525328881107e-06, -4.362964682513848e-05, -6.198863957251888e-06, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.0011709030950441957, 0.0, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, 0.0, -0.078897