fill(dist, Long.MAX_VALUE);\n                dist[s] = 0;\n                boolean changed = true;\n                while (changed) {\n                    changed = false;\n                    for (int v = 0; v < n; v++) {\n                        if (dist[v] == Long.MAX_VALUE) continue;\n                        for (int i = 0; i < adj.get(v).size(); i++) {\n                            Edge e = adj.get(v).get(i);\n                            if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                                dist[e.to] = dist[v] + e.cost;\n                                prevv[e.to] = v;\n                                preve[e.to] = i;\n                                changed = true;\n                            }\n                        }\n                    }\n                }\n\n                if (dist[t] == Long.MAX_VALUE) break;\n\n                int f = Integer.MAX_VALUE;\n                for (int v = t; v != s; v = prevv[v]) {\n                    f = Math.min(f, adj.get(prevv[v]).get(preve[v]).cap);\n                }\n\n                total_flow += f;\n                total_cost += (long) f * dist[t];\n\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = adj.get(prevv[v]).get(preve[v]);\n                    e.cap -= f;\n                    adj.get(v).get(e.rev).cap += f;\n                }\n            }\n\n            return new long[]{total_flow, total_cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int[] a = new int[1005];\n        for (int i = 1; i <= k; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        MinCostFlow solver = new MinCostFlow(50 * 50 * 4 + 10);\n        int source = solver.n - 2;\n        int sink = solver.n - 3;\n\n        int[][] node_id = new int[55][2505];\n        int counter = 0;\n        int max_level = 100;\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= max_level; j++) {\n                node_id[i][j] = ++counter;\n            }\n        }\n\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int level = 0; level < max_level; level++) {\n                for (int step = 1; step <= k; step++) {\n                    int delta = step * step * d - (step - 1) * (step - 1) * d;\n                    solver.add_edge(node_id[u][level], node_id[v][level + 1], 1, c + delta);\n                    solver.add_edge(node_id[v][level], node_id[u][level + 1], 1, c + delta);\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int level = 0; level < max_level; level++) {\n                solver.add_edge(node_id[i][level], node_id[i][level + 1], Integer.MAX_VALUE, c);\n            }\n        }\n\n        for (int i = 1; i <= k; i++) {\n            solver.add_edge(source, node_id[a[i]][0], 1, 0);\n        }\n\n        for (int level = 1; level <= max_level; level++) {\n            solver.add_edge(node_id[1][level], sink, Integer.MAX_VALUE, 0);\n        }\n\n        long[] result = solver.solve(source, sink);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015877417172305286, -3.099436753473128e-06, -3.576278118089249e-07, -0.003785825800150633, -2.4318398573086597e-05, -0.31328946352005005, -0.05511168763041496, -0.0001629458274692297, -4.768370445162873e-07, -0.0003178806509822607, -0.12692877650260925, -0.0015038858400657773, -0.0024706574622541666, -0.10587820410728455, -6.97350042173639e-05, -3.576278118089249e-07, -8.344646857949556e-07, -3.933898824470816e-06, -3.576278118089249e-07, -0.00038187362952157855, -5.245195097813848e-06, -0.06196907162666321, 