n {\n    \n    static class Edge {\n        int to, capacity, cost, rev;\n        public Edge() {}\n        public Edge(int to, int capacity, int cost, int rev) {\n            this.to = to;\n            this.capacity = capacity;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int V;\n        int[] H;\n        int[] dis;\n        int[] PreV;\n        int[] PreE;\n        List<Edge>[] G;\n\n        @SuppressWarnings(\"unchecked\")\n        void init(int n) {\n            V = n;\n            G = new ArrayList[V + 1];\n            for (int i = 0; i <= V; ++i) G[i] = new ArrayList<>();\n            H = new int[NN + 5];\n            dis = new int[NN + 5];\n            PreV = new int[NN + 5];\n            PreE = new int[NN + 5];\n        }\n\n        void addEdge(int from, int to, int cap, int cost) {\n            G[from].add(new Edge(to, cap, cost, G[to].size()));\n            G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n        }\n\n        int minCost(int s, int t, int f) {\n            int flow = 0;\n            int res = 0;\n            Arrays.fill(H, 0);\n            while (f > 0) {\n                PriorityQueue<int[]> q = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                Arrays.fill(dis, Integer.MAX_VALUE / 2);\n                dis[s] = 0;\n                q.offer(new int[]{0, s});\n                while (!q.isEmpty()) {\n                    int[] now = q.poll();\n                    int v = now[1];\n                    if (dis[v] < now[0]) continue;\n                    for (int i = 0; i < G[v].size(); ++i) {\n                        Edge e = G[v].get(i);\n                        if (e.capacity > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n                            dis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n                            PreV[e.to] = v;\n                            PreE[e.to] = i;\n                            q.offer(new int[]{dis[e.to], e.to});\n                        }\n                    }\n                }\n                if (dis[t] == Integer.MAX_VALUE / 2) break;\n                for (int i = 0; i <= V; ++i) H[i] += dis[i];\n                int d = f;\n                for (int v = t; v != s; v = PreV[v]) d = Math.min(d, G[PreV[v]].get(PreE[v]).capacity);\n                f -= d;\n                flow += d;\n                res += d * H[t];\n                for (int v = t; v != s; v = PreV[v]) {\n                    Edge e = G[PreV[v]].get(PreE[v]);\n                    e.capacity -= d;\n                    G[v].get(e.rev).capacity += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    static final int NN = 6555;\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        // Uncomment lines below if you want to simulate input from files\n        // System.setIn(new FileInputStream(\"in.in\"));\n        // System.setOut(new PrintStream(new FileOutputStream(\"out.out\")));\n\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        MinCostMaxFlow mcmf = new MinCostMaxFlow();\n        mcmf.init(n * (n + 55) + 2);\n\n        for (int i = 0; i < k; i++) {\n            int u = Integer.parseInt(br.readLine());\n            mcmf.addEdge(0, u, 1, 0);\n        }\n\n        List<int[]> edgeList = new ArrayList<>();\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            edgeList.add(new int[]{u, v});\n        }\n\n        int tar