{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.BufferedReader;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.math.BigInteger;\nimport java.util.StringTokenizer;\n\npublic class Main {\n    static final BigInteger MOD = BigInteger.valueOf(998244353L);\n    static BigInteger[] fact;\n    static BigInteger[] invFact;\n\n    public static void main(String[] args) {\n        FastScanner fs = new FastScanner();\n        int n = fs.nextInt();\n        int m = fs.nextInt();\n        int lim = n + m;\n\n        fact = new BigInteger[lim + 1];\n        invFact = new BigInteger[lim + 1];\n        fact[0] = BigInteger.ONE;\n        for (int i = 1; i <= lim; i++) {\n            fact[i] = fact[i - 1].multiply(BigInteger.valueOf(i)).mod(MOD);\n        }\n        invFact[lim] = fact[lim].modInverse(MOD);\n        for (int i = lim; i >= 1; i--) {\n            invFact[i - 1] = invFact[i].multiply(BigInteger.valueOf(i)).mod(MOD);\n        }\n\n        BigInteger phaseSize = BigInteger.ONE;\n        BigInteger p = BigInteger.ONE;\n        for (int i = 1; i <= n; i++) {\n            p = p.multiply(BigInteger.valueOf(n - i + 1)).mod(MOD);\n            p = p.multiply(inv(lim - i + 1)).mod(MOD);\n            phaseSize = phaseSize.add(p).mod(MOD);\n        }\n\n        BigInteger answer = BigInteger.ZERO;\n        for (int k = 1; k <= n; k++) {\n            BigInteger numPhases = BigInteger.valueOf((long) m + k).multiply(inv(k)).mod(MOD);\n            BigInteger e = numPhases.multiply(phaseSize).mod(MOD);\n            BigInteger term = ncr(n, k).multiply(e).mod(MOD);\n            if ((k & 1) == 1) {\n                answer = answer.add(term).mod(MOD);\n            } else {\n                answer = answer.subtract(term).mod(MOD);\n            }\n        }\n\n        System.out.println(answer);\n    }\n\n    static BigInteger inv(int x) {\n        return fact[x - 1].multiply(invFact[x]).mod(MOD);\n    }\n\n    static BigInteger ncr(int n, int r) {\n        if (r < 0 || r > n) return BigInteger.ZERO;\n        return fact[n].multiply(invFact[r]).mod(MOD).multiply(invFact[n - r]).mod(MOD);\n    }\n\n    static class FastScanner {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st;\n\n        String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cstdint>\n\nconst int64_t MOD = 998244353LL;\n\nstd::vector<int64_t> fact;\nstd::vector<int64_t> invFact;\n\nint64_t modInv(int64_t a, int64_t m) {\n    int64_t res = 1, exp = m - 2;\n    while (exp > 0) {\n        if (exp & 1) res = (res * a) % m;\n        a = (a * a) % m;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint64_t inv(int x) {\n    return (fact[x - 1] * invFact[x]) % MOD;\n}\n\nint64_t ncr(int n, int r) {\n    if (r < 0 || r > n) return 0;\n    return ((fact[n] * invFact[r]) % MOD * invFact[n - r]) % MOD;\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    std::cin >> n >> m;\n    int lim = n + m;\n\n    fact.resize(lim + 1);\n    invFact.resize(lim + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= lim; i++) {\n        fact[i] = (fact[i - 1] * i) % MOD;\n    }\n    invFact[lim] = modInv(fact[lim], MOD);\n    for (int i = lim; i >= 1; i--) {\n        invFact[i - 1] = (invFact[i] * i) % MOD;\n    }\n\n    int64_t phaseSize = 1;\n    int64_t p = 1;\n    for (int i = 1; i <= n; i++) {\n        p = (p * (n - i + 1)) % MOD;\n        p = (p * inv(lim - i + 1)) % MOD;\n        phaseSize = (phaseSize + p) % MOD;\n    }\n\n    int64_t answer = 0;\n    for (int k = 1; k <= n; k++) {\n        int64_t numPhases = ((int64_t)(m + k) * inv(k)) % MOD;\n        int64_t e = (numPhases * phaseSize) % MOD;\n        int64_t term = (ncr(n, k) * e) % MOD;\n        if (k & 1) {\n            answer = (answer + term) % MOD;\n        } else {\n            answer = (answer - term + MOD) % MOD;\n        }\n    }\n\n    std::cout << answer << \"\\n\";\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.5762147e-05, 0.0, -4.7683704e-07, -0.0032241764, -0.0002541219, -0.00016354177, -0.97830874, -3.1470758e-05, -5.960463e-07, -3.576278e-07, -0.39551264, -2.8490615e-05, -2.7775379e-05, -5.9604467e-06, -0.120097995, -0.00674282, -0.0007203606, -4.1723165e-06, -0.06002632, -1.1920922e-06, -0.20145573, -0.07898735, -2.1099822e-05, -0.104630955, -0.3328133, -3.552374e-05, -0.31333286, -2.5961154, -0.13507129, -0.0033396683, 0.0, -1.1324818e-05, -0.