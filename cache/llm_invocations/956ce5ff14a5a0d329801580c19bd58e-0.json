pushDown() {\n        if (dirty) {\n            left->setValue(batchSetValue);\n            right->setValue(batchSetValue);\n            dirty = false;\n        }\n    }\n};\n\nvoid solve() {\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    int n, k;\n    iss >> n >> k;\n\n    vector<vector<int>> intervals(k + 2, vector<int>(2));\n    for (int i = 1; i <= k; ++i) {\n        getline(cin, line);\n        istringstream iss2(line);\n        iss2 >> intervals[i][0] >> intervals[i][1];\n    }\n    intervals[k + 1][0] = 2 * n;\n    intervals[k + 1][1] = 2 * n;\n    k++;\n\n    Node* loop[2];\n    loop[0] = Node::build(0, n);\n    loop[1] = Node::build(0, n);\n\n    vector<int> data(n + 1);\n\n    for (int i = 1; i <= k; ++i) {\n        Node* curDp = loop[i & 1];\n        Node* lastDp = loop[(i - 1) & 1];\n\n        int intervalLength = intervals[i][1] - intervals[i][0];\n        int middleLength = intervals[i][0] - intervals[i - 1][1];\n\n        Node::toArray(0, n, data.data(), lastDp);\n\n        int destPos = min((int)data.size(), intervalLength + middleLength);\n        int length = max(0, n + 1 - (intervalLength + middleLength));\n\n        if (length > 0) {\n            if (destPos < length) {\n                // overlapping, copy from end\n                for (int j = length - 1; j >= 0; --j) {\n                    data[destPos + j] = data[j];\n                }\n            } else {\n                for (int j = 0; j < length; ++j) {\n                    data[destPos + j] = data[j];\n                }\n            }\n        }\n\n        fill(data.begin(), data.begin() + destPos, INF);\n\n        int minX = intervals[i][1] - middleLength - intervalLength;\n        int maxX = intervals[i][1] - middleLength;\n        for (int j = 0; j <= n; ++j) {\n            int minNeedTime = Node::query(minX - j, maxX - j, 0, n, lastDp);\n            data[j] = min(data[j], minNeedTime + 1);\n        }\n\n        for (int j = 0; j <= n; ++j) {\n        