 = [0] * n\n        self.dd = [0] * n\n        self.bb = [0] * n\n        self.inq = [False] * n\n        self.uu = []\n        self.vv = []\n        self.uv = []\n        self.cost = []\n        self.cap = []\n        self.m = 0\n        self.nq = 1\n        self.qq = [0] * self.nq\n        self.head = 0\n        self.cnt = 0\n\n    def link(self, u, v, c, w):\n        h = self.m\n        self.m += 1\n        self.uu.append(u)\n        self.vv.append(v)\n        self.uv.append(u ^ v)\n        self.cost.append(w)\n        self.cap.append(c)\n        self.cap.append(0)\n        self.adj[u].append(h << 1)\n        self.adj[v].append(h << 1 | 1)\n\n    def enqueue(self, v):\n        if self.inq[v]:\n            return\n        if self.head + self.cnt == self.nq:\n            if self.cnt * 2 <= self.nq:\n                self.qq[:self.cnt] = self.qq[self.head:self.head + self.cnt]\n            else:\n                self.nq *= 2\n                new_qq = [0] * self.nq\n                new_qq[:self.cnt] = self.qq[self.head:self.head + self.cnt]\n                self.qq = new_qq\n            self.head = 0\n        self.qq[self.head + self.cnt] = v\n        self.cnt += 1\n        self.inq[v] = True\n\n    def dequeue(self):\n        u = self.qq[self.head]\n        self.head += 1\n        self.cnt -= 1\n        self.inq[u] = False\n        return u\n\n    def spfa(self, s, t):\n        self.pi = [INF] * self.n\n        self.pi[s] = 0\n        # dd is not reset; it retains values from previous runs\n        self.head = 0\n        self.cnt = 0\n        self.enqueue(s)\n        while self.cnt > 0:\n            u = self.dequeue()\n            d = self.dd[u] + 1\n            for h_ in self.adj[u]:\n                if self.cap[h_] > 0:\n                    h = h_ >> 1\n                    p = self.pi[u] + (self.cost[h] if (h_ & 1) == 0 else -self.cost[h])\n                    v = u ^ self.uv[h]\n                    if self.pi[v] > p or (self.pi[v] == p and self.dd[v] > d):\n                        self.pi[v] = p\n                        self.dd[v] = d\n                        self.bb[v] = h_\n                        self.enqueue(v)\n        return self.pi[t] != INF\n\n    def push1(self, s, t):\n        u = t\n        while u != s:\n            h_ = self.bb[u]\n            h = h_ >> 1\n            self.cap[h_] -= 1\n            self.cap[h_ ^ 1] += 1\n            u = u ^ self.uv[h]\n\n    def edmonds_karp(self, s, t):\n        while self.spfa(s, t):\n            self.push1(s, t)\n        flow = 0\n        for h in range(self.m):\n            flow += self.cost[h] * self.cap[(h << 1) | 1]\n        return flow\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    start = [int(next(it)) - 1 for _ in range(K)]\n    graph = [[] for _ in range(N)]\n    for _ in range(M):\n        a = int(next(it)) - 1\n        b = int(next(it)) - 1\n        graph[a].append(b)\n        graph[b].append(a)\n    T = N + K + 1\n    n = N * T + 1\n    mcf = MinCostFlow(n)\n    for i in range(N):\n        for s in range(T - 1):\n            u = i * T + s\n            for j in graph[i]:\n                v = j * T + s + 1\n                for x in range(1, K + 1):\n                    mcf.link(u, v, 1, C + (x * 2 - 1) * D)\n    for i in range(N):\n        for s in range(T - 1):\n            u = i * T + s\n            v = u + 1\n            cap = K\n            cost = 0 if i == 0 else C\n            mcf.link(u, v, cap, cost)\n    for h in range(K):\n        mcf.link(n - 1, start[h] * T, 1, 0)\n    result = mcf.edmonds_karp(n - 1, T - 1)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-3.2543604902457446e-05, 0.0, 0.0, -0.00023493390472140163, -3.71926071238704e-05, -1.0728830375228426e-06, -0.008774887770414352, -0.04000989720225334, -1.04903629107866