\n    \n    def set_v(self, _v):\n        self.v = _v if _v < MOD else _v - MOD\n        return self\n    \n    def __bool__(self):\n        return self.v != 0\n    \n    def __neg__(self):\n        return ModInt(0) - self\n    \n    def __add__(self, r):\n        return ModInt().set_v(self.v + r.v)\n    \n    def __sub__(self, r):\n        return ModInt().set_v(self.v + MOD - r.v)\n    \n    def __mul__(self, r):\n        return ModInt().set_v((self.v * r.v) % MOD)\n    \n    def __truediv__(self, r):\n        return self * r.inv()\n    \n    def __iadd__(self, r):\n        self = self + r\n        return self\n    \n    def __isub__(self, r):\n        self = self - r\n        return self\n    \n    def __imul__(self, r):\n        self = self * r\n        return self\n    \n    def __itruediv__(self, r):\n        self = self / r\n        return self\n    \n    def __eq__(self, r):\n        return self.v == r.v\n    \n    def pow(self, n):\n        x = ModInt(self.v)\n        r = ModInt(1)\n        while n:\n            if n & 1:\n                r *= x\n            x *= x\n            n >>= 1\n        return r\n    \n    def inv(self):\n        return self.pow(MOD - 2)\n    \n    def __repr__(self):\n        return str(self.v)\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    \n    n = int(data[idx])\n    idx += 1\n    \n    mat = [[ModInt(0) for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            x = int(data[idx])\n            idx += 1\n            mat[i][j] = ModInt(x) / ModInt(100)\n    \n    # sts is a list of (list_of_states, probability)\n    sts = [([0], ModInt(1))]\n    \n    for ph in range(n):\n        nsts = []\n        for f in range(1, 1 << n):\n            freq = ModInt(1)\n            for i in range(n):\n                if (f >> i) & 1:\n                    freq *= mat[ph][i]\n                else:\n                    freq -= mat[ph][i]  # freq *= (1 - mat[ph][i])\n            \n            for st_states, st_prob in sts:\n                nst = []\n                for d in st_states:\n                    for i in range(n):\n                        if (d >> i) & 1:\n                            continue\n                        if not ((f >> i) & 1):\n                            continue\n                        nst.append(d ^ (1 << i))\n                \n                if not nst:\n                    continue\n                \n                nst.sort()\n                # Remove duplicates\n                unique_nst = []\n                for x in nst:\n                    if not unique_nst or unique_nst[-1] != x:\n                        unique_nst.append(x)\n                nst = unique_nst\n                \n                nsts.append((nst, st_prob * freq))\n        \n        # Sort by state list\n        nsts.sort(key=lambda x: x[0])\n        \n        # Merge same states\n        sts = []\n        for st in nsts:\n            if sts and sts[-1][0] == st[0]:\n                new_prob = sts[-1][1] + st[1]\n                sts[-1] = (sts[-1][0], new_prob)\n            else:\n                sts.append(st)\n    \n    ans = ModInt(0)\n    if sts:\n        ans = sts[0][1]\n    \n    print(ans.v)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0002774807217065245, -2.3841830625315197e-06, -4.768370445162873e-07, -0.0014463926199823618, -0.00018761781393550336, -3.313963316031732e-05, -0.04023481532931328, -0.4669612646102905, -2.3841855067985307e-07, -0.000539634027518332, -0.3136686384677887, -0.4144793450832367, -0.00937074888497591, -0.10206912457942963, -0.15083977580070496, -2.861018856492592e-06, -7.152555099310121e-07, -0.0017070496687665582, -1.1920928244535389e-07, -0.012511808425188065, -2.3841855067985307e-07, -3.933898824470816e-06, 0.0, 0.0, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.622600959512056e-06, -1.406659703206