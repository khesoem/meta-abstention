MAX_VALUE;\n\n                while (!q.isEmpty()) {\n                    long[] cur = q.poll();\n                    int d = (int) (cur[0] >> 32);\n                    int u = (int) (cur[0] & ((1L << 32) - 1));\n                    if (d != prio[u]) continue;\n                    for (int i = 0; i < adj.get(u).size(); ++i) {\n                        Edge e = adj.get(u).get(i);\n                        int v = e.to;\n                        if (e.cap <= e.f) continue;\n                        int nprio = prio[u] + e.cost + pot[u] - pot[v];\n                        if (prio[v] > nprio) {\n                            prio[v] = nprio;\n                            q.offer(new long[]{((long)nprio << 32) + v});\n                            prevnode[v] = u;\n                            prevedge[v] = i;\n                            curflow[v] = Math.min(curflow[u], e.cap - e.f);\n                        }\n                    }\n                }\n\n                if (prio[t] == Integer.MAX_VALUE) break;\n\n                for (int i = 0; i < n; ++i)\n                    pot[i] += prio[i];\n\n                int df = Math.min(curflow[t], INF - flow);\n                flow += df;\n\n                for (int v = t; v != s; v = prevnode[v]) {\n                    Edge e = adj.get(prevnode[v]).get(prevedge[v]);\n                    e.f += df;\n                    adj.get(v).get(e.rev).f -= df;\n                    flowCost += df * e.cost;\n                }\n            }\n            return new int[]{flow, flowCost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MCF nt = new MCF(6 + 107 * n);\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            --x;\n            nt.addEdge(0, 1 + x, 1, 0);\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x; --y;\n            for (int layer = 0; layer < 105; ++layer) {\n                for (int step = 0; step < 51; ++step) {\n                    nt.addEdge(1 + layer * n + x, 1 + (layer + 1) * n + y, 1, c + d * (2 * step + 1));\n                    nt.addEdge(1 + layer * n + y, 1 + (layer + 1) * n + x, 1, c + d * (2 * step + 1));\n                }\n            }\n        }\n\n        for (int layer = 0; layer < 105; ++layer) {\n            for (int node = 0; node < n; ++node) {\n                nt.addEdge(1 + layer * n + node, 1 + (layer + 1) * n + node, 51, c);\n            }\n        }\n\n        for (int layer = 0; layer < 105; ++layer) {\n            nt.addEdge(1 + layer * n, 1 + 105 * n, 51, 0);\n        }\n\n        int[] result = nt.minCostFlow(0, 1 + 105 * n);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016425691137555987, -2.861018856492592e-06, -3.576278118089249e-07, -0.004145006649196148, -3.838465272565372e-05, -0.2519370913505554, -0.16031600534915924, -0.00027021096320822835, -4.768370445162873e-07, -0.00016640232934150845, -0.061968397349119186, -8.546940807718784e-05, -0.0036971091758459806, -0.20703986287117004, -0.0006276782951317728, -1.549708758830093e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -7.486063259420916e-05, 0.0, 0.0, -2.50339189733495e-06, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -0.16022451221942902, -2.264974000354414e-06, -7.033323527139146e-06, -6.556489552167477e-06, -0.1800982654094696, -1.6689286894688848e-06, -4.768370445162873e-07, -1.6689286894688848e-06, -5.960462772236497e-07, -0.0004328744253143668, -2.2053474822314456e-05, -4.768370445162873e-07, -1.6689286894688848e-06, 0.0, -2.622600959512056e-06, 0.0, -3.3378546504536644e-06, -0.06199080869555473, -0.033647384494543076, -6.12716976320371e-05, -1.7881377