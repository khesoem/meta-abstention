 Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] arr = new int[n];\n        for (int i = 0; i < n; i++) {\n            arr[i] = sc.nextInt();\n        }\n        int n1 = n / 2;\n        int n2 = n - n1; // equivalent to n/2 + n%2\n        int[] first = Arrays.copyOfRange(arr, 0, n1);\n        int[] sec = Arrays.copyOfRange(arr, n1, n);\n        \n        long t1 = 1L << n1;\n        long t2 = 1L << n2;\n        \n        ArrayList<Integer> s1 = new ArrayList<>();\n        for (long mask = 0; mask < t1; mask++) {\n            long sum = 0;\n            for (int j = 0; j < n1; j++) {\n                if ((mask & (1L << j)) != 0) {\n                    sum += first[j];\n                }\n            }\n            s1.add((int)(sum % m));\n        }\n        \n        ArrayList<Integer> s2 = new ArrayList<>();\n        for (long mask = 0; mask < t2; mask++) {\n            long sum = 0;\n            for (int j = 0; j < n2; j++) {\n                if ((mask & (1L << j)) != 0) {\n                    sum += sec[j];\n                }\n            }\n            s2.add((int)(sum % m));\n        }\n        \n        Collections.sort(s1);\n        Collections.sort(s2);\n        \n        int maxi = 0;\n        for (int i : s1) {\n            int req = m - i;\n            // binary search for largest element in s2 less than req\n            int idx = Collections.binarySearch(s2, req);\n            if (idx >= 0) {\n                idx--; // move to previous element (strictly less)\n            } else {\n                idx = -idx - 2; // insertion point - 1\n            }\n            int pair = (idx >= 0) ? s2.get(idx) : 0;\n            maxi = Math.max(maxi, (i + pair) % m);\n        }\n        System.out.println(maxi);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, 0.0, 0.0, -3.421248038648628e-05, -3.564294092939235e-05, 0.0, -4.768360213347478e-06, -0.01989563368