{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing llong = long long;\n\nllong lsc[62], rsc[62], rsc2[62];\nchar s[62];\nmap<pair<llong,int>,llong> nm, mm;\n\nllong binomial(int n, int k) {\n    if (k < 0 || k > n) return 0;\n    llong res = 1;\n    for (int j = 0; j < k; ++j)\n        res = res * (n - j) / (j + 1);\n    return res;\n}\n\nint main() {\n    int r, c, n, i, cnta = 0, cntb = 0, ok, ast, bst;\n    llong msum = 0, nsum = 0, bsum, rasp = 0;\n    scanf(\"%d%d\\n\", &r, &c);\n    n = 2 * (r + c);\n    scanf(\"%s\", s);\n    \n    lsc[2*r-1] = 1;\n    for (i = 2*r; i < n; ++i)\n        lsc[i] = lsc[i-1] * i / (i - 2*r + 1);\n    \n    for (i = 0; i <= n; ++i) {\n        rsc[i] = binomial(i, r);\n        rsc2[i] = binomial(i, r-1);\n    }\n    \n    nsum = rsc[n/2] * rsc[n/2];\n    \n    for (i = n-1; i >= 0; --i) {\n        ok = (msum > 0 || cntb == n/2) && !(cnta == n/2);\n        if (ok) {\n            cnta++;\n            msum -= rsc2[n/2 - cnta] * rsc[n/2 - cntb];\n        } else {\n            cntb++;\n            msum += rsc2[n/2 - cntb] * rsc[n/2 - cnta];\n        }\n    }\n    msum = msum < 0 ? -msum : msum;\n    \n    mm[{0, 0}] = 1;\n    \n    for (i = n-1; i >= 2*r-1; --i) {\n        nm.clear();\n        for (auto& entry : mm) {\n            llong sum = entry.first.first;\n            llong cnt_val = entry.second;\n            int cnt = entry.first.second;\n            ast = n/2 - cnt;\n            bst = i + 1 - ast;\n            llong asum = sum + rsc2[ast-1] * rsc[bst];\n            llong bsum = sum - rsc2[bst-1] * rsc[ast];\n            \n            if (s[i] == 'A') {\n                nm[{asum, cnt+1}] += cnt_val;\n            } else if (s[i] == 'B') {\n                nm[{bsum, cnt}] += cnt_val;\n            } else {\n                nm[{asum, cnt+1}] += cnt_val;\n                nm[{bsum, cnt}] += cnt_val;\n            }\n        }\n        nsum -= lsc[i];\n        mm.clear();\n        for (auto& entry : nm) {\n            llong sum = entry.first.first;\n            llong cnt_val = entry.second;\n            int cnt = entry.first.second;\n            ast = n/2 - cnt;\n            bst = i - ast;\n            if (cnt > n/2 || (i - cnt) > n/2) continue;\n            if (sum < -msum - rsc[ast]*rsc[bst] || sum > msum + rsc[ast]*rsc[bst]) continue;\n            mm[{sum, cnt}] += cnt_val;\n        }\n    }\n    \n    bsum = 1e18;\n    for (auto& entry : mm) {\n        llong val = entry.first.first;\n        bsum = min(bsum, val < 0 ? -val : val);\n    }\n    \n    for (auto& entry : mm) {\n        llong sum = entry.first.first;\n        llong cnt_val = entry.second;\n        int cnt = entry.first.second;\n        if (sum == bsum || sum == -bsum) {\n            int sem = 0;\n            for (i = 0; i < 2*r-1; ++i) {\n                if (s[i] == '?') sem++;\n                else if (s[i] == 'A') cnt++;\n            }\n            cnt_val *= binomial(sem, n/2 - cnt);\n            rasp += cnt_val;\n        }\n    }\n    \n    printf(\"%lld\\n\", rasp);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\nfrom math import comb\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    \n    r, c = map(int, data[0].split())\n    s = data[1].strip()\n    \n    n = 2 * (r + c)\n    \n    lsc = [0] * 62\n    rsc = [0] * 62\n    rsc2 = [0] * 62\n    \n    lsc[2*r-1] = 1\n    for i in range(2*r, n):\n        lsc[i] = lsc[i-1] * i // (i - 2*r + 1)\n    \n    for i in range(n + 1):\n        rsc[i] = comb(i, r) if 0 <= r <= i else 0\n        rsc2[i] = comb(i, r-1) if 0 <= r-1 <= i else 0\n    \n    nsum = rsc[n//2] * rsc[n//2]\n    \n    msum = 0\n    cnta = 0\n    cntb = 0\n    \n    for i in range(n-1, -1, -1):\n        ok = (msum > 0 or cntb == n//2) and not (cnta == n//2)\n        if ok:\n            cnta += 1\n            msum -= rsc2[n//2 - cnta] * rsc[n//2 - cntb]\n        else:\n            cntb += 1\n            msum += rsc2[n//2 - cntb] * rsc[n//2 - cnta]\n    \n    msum = abs(msum)\n    \n    mm = defaultdict(int)\n    mm[(0, 0)] = 1\n    \n    for i in range(n-1, 2*r-2, -1):\n        nm = defaultdict(int)\n        for (sum_val, cnt), cnt_val in mm.items():\n            ast = n//2 - cnt\n            bst = i + 1 - ast\n            asum = sum_val + rsc2[ast-1] * rsc[bst] if ast > 0 else sum_val\n            bsum = sum_val - rsc2[bst-1] * rsc[ast] if bst > 0 else sum_val\n            \n            if s[i] == 'A':\n                nm[(asum, cnt+1)] += cnt_val\n            elif s[i] == 'B':\n                nm[(bsum, cnt)] += cnt_val\n            else:  # s[i] == '?'\n                nm[(asum, cnt+1)] += cnt_val\n                nm[(bsum, cnt)] += cnt_val\n        \n        nsum -= lsc[i]\n        mm.clear()\n        for (sum_val, cnt), cnt_val in nm.items():\n            ast = n//2 - cnt\n            bst = i - ast\n            if cnt > n//2 or (i - cnt) > n//2:\n                continue\n            if sum_val < -msum - rsc[ast]*rsc[bst] or sum_val > msum + rsc[ast]*rsc[bst]:\n                continue\n            mm[(sum_val, cnt)] += cnt_val\n    \n    bsum = float('inf')\n    for (sum_val, cnt), cnt_val in mm.items():\n        bsum = min(bsum, abs(sum_val))\n    \n    rasp = 0\n    for (sum_val, cnt), cnt_val in mm.items():\n        if sum_val == bsum or sum_val == -bsum:\n            sem = 0\n            for i in range(2*r-1):\n                if s[i] == '?':\n                    sem += 1\n                elif s[i] == 'A':\n                    cnt += 1\n            rasp += cnt_val * comb(sem, n//2 - cnt)\n    \n    print(rasp)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0002029928145930171, -1.311301275563892e-06, -1.1920922133867862e-06, -0.014094807207584381, -0.0005678709712810814, -0.002805347554385662, -0.00030155404238030314, -0.016970770433545113, -1.1920928244535389e-07, -6.496695277746767e-05, -0.3504345118999481, -0.20142532885074615, -0.03289315104484558, -2.0265558760002023e-06, -0.00036125810584053397, -0.00011932138295378536, -0.0003511289251036942, -0.4666096568107605, -6.69933797325939e-05, -4.768370445162873e-07, -0.32716184854507446, -5.722029527532868e-06, -0.005415293853729963, -3.611976353568025e-05, -0.023585248738527298, -9.417090768693015e-05, -0.00043847484630532563, -0.08133541792631149, -1.1920922133867862e-06, -7.152555099310121e-07, -0.039152130484580994, -0.002191048813983798, -8.344646857949556e-07, -0.5759409666061401, 0.0, -0.00021371940965764225, -0.17978708446025848, -9.536738616588991e-07, -0.1632813811302185, -0.00011717586312443018, -2.3841855067985307e-07, -1.311301275563892e-06, -3.3854863431770355e-05, -7.331102824537084e-05, -9.536738616588991e-07, -3.3378546504536644e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -4.768370445162873e-07, -0.0017055026255548, -1.6689160474925302e-05, -1.4305104514278355e-06, -0.00523814