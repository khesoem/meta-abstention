     swap(arr, i, k);\n            permute(arr, k + 1, result);\n            swap(arr, k, i);\n        }\n        if (k == arr.length - 1) {\n            List<Integer> list = new ArrayList<>();\n            for (int val : arr) {\n                list.add(val);\n            }\n            result.add(list);\n        }\n    }\n    \n    private static void swap(int[] arr, int i, int j) {\n        int temp = arr[i];\n        arr[i] = arr[j];\n        arr[j] = temp;\n    }\n    \n    private static void HeyYashwant() {\n        try {\n            int t = 1;\n            // t = giveInt();\n            for (int i = 0; i < t; i++) {\n                solve();\n            }\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.782778655178845e-05, -3.099436753473128e-06, -3.576278118089249e-07, -2.062299427052494e-05, -1.549708758830093e-05, -0.08895276486873627, -0.0025211949832737446, -2.3841830625315197e-06, -7.390948667307384e-06, -0.0006378046819008887, -0.020576702430844307, -9.357491217087954e-05, -5.960462772236497e-07, -8.689979586051777e-05, -0.20145563781261444, -0.00025519452174194157, -0.12404502928256989, -0.0008368566050194204, -0.6562227606773376, -0.4124588370323181, -0.0004378790326882154, -1.680836794548668e-05, -2.861018856492592e-06, -7.271740287251305e-06, -0.38045552372932434, -0.007558201439678669, -6.55629628454335e-05, -0.00012563870404846966, -5.9602869441732764e-05, -1.5735502529423684e-05, -0.6280295252799988, -3.182837463100441e-05, -9.321732068201527e-05, -0.21657505631446838, -0.00012420836719684303, -0.583927571773529, -0.007610138971358538, -3.45700973412022e-05, -1.1444026313256472e-05, -0.7738134264945984, -0.0008280424517579377, -0.0003268184664193541, -0.00010048838157672435, -7.509902934543788e-05, -6.9141146923357155e-06, -1.7404405298293568e-05, -0.22541576623916626, -5.960462772236497e-07, -0.6334080100059509, -1.728519782