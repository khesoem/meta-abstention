 while (!q.empty()) {\n        int u = q.front(); q.pop();\n        in_queue[u] = false;\n        \n        for (int i = adjacency[u]; i != -1; i = edges[i].next) {\n            int v = edges[i].dest;\n            if (edges[i].capacity > edges[i].flow && distance[v] > distance[u] + edges[i].weight) {\n                distance[v] = distance[u] + edges[i].weight;\n                parent_edge[v] = i;\n                if (!in_queue[v]) {\n                    in_queue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    return parent_edge[sink] != -1;\n}\n\nint compute_min_cost_flow(int source, int sink) {\n    int total_flow = 0, total_cost = 0;\n    \n    while (bellman_ford(source, sink)) {\n        int bottleneck = INF;\n        for (int i = parent_edge[sink]; i != -1; i = parent_edge[edges[i ^ 1].dest]) {\n            bottleneck = min(bottleneck, edges[i].capacity - edges[i].flow);\n        }\n        \n        for (int i = parent_edge[sink]; i != -1; i = parent_edge[edges[i ^ 1].dest]) {\n            edges[i].flow += bottleneck;\n            edges[i ^ 1].flow -= bottleneck;\n            total_cost += edges[i].weight * bottleneck;\n        }\n        \n        total_flow += bottleneck;\n    }\n    \n    return total_cost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> k >> c >> d;\n    reset_graph(MAX_NODES);\n    \n    for (int i = 0; i < k; i++) {\n        int x; cin >> x;\n        insert_edge(0, x, 1, 0);\n    }\n    \n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j < k; j++) {\n            insert_edge(1 + i * n, 9999, 1, i * c);\n        }\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v; cin >> u >> v;\n        for (int j = 1; j < 100; j++) {\n            for (int gg = 1; gg <= k; gg++) {\n                insert_edge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                insert_edge(v + (j - 1) * n, u + j * n,