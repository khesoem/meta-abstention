content": "<translated_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = numeric_limits<int>::max();\n\nstruct Edge {\n    int to, rev, cap, cost;\n    Edge(int to, int rev, int cap, int cost) : to(to), rev(rev), cap(cap), cost(cost) {}\n};\n\nclass Graph {\nprivate:\n    int vNum, src, sink;\n    vector<vector<Edge>> adj;\n    vector<int> p, d;\n\npublic:\n    Graph(int vNum, int src, int sink) : vNum(vNum), src(src), sink(sink) {\n        adj.resize(vNum);\n        p.resize(vNum);\n        d.resize(vNum);\n    }\n\n    void addEdge(int from, int to, int capacity, int cost) {\n        adj[from].emplace_back(to, (int)adj[to].size(), capacity, cost);\n        adj[to].emplace_back(from, (int)adj[from].size() - 1, 0, -cost);\n    }\n\n    bool findCheapestPath() {\n        fill(d.begin(), d.end(), INF);\n        fill(p.begin(), p.end(), -1);\n        d[src] = 0;\n        vector<bool> inQueue(vNum, false);\n        queue<int> q;\n        q.push(src);\n        inQueue[src] = true;\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inQueue[u] = false;\n            for (const Edge& e : adj[u]) {\n                if (e.cap > 0 && d[u] + e.cost < d[e.to]) {\n                    d[e.to] = d[u] + e.cost;\n                    p[e.to] = u;\n                    if (!inQueue[e.to]) {\n                        q.push(e.to);\n                        inQueue[e.to] = true;\n                    }\n                }\n            }\n        }\n        return p[sink] != -1;\n    }\n\n    pair<int, int> augmentPath(int from, int to, int flow) {\n        int pathCost = 0;\n        // find bottleneck\n        for (int cur = to; cur != from; cur = p[cur]) {\n            int prev = p[cur];\n            for (Edge& e : adj[prev]) {\n                if (e.to == cur && e.cap > 0) {\n                    flow = min(flow, e.cap);\n                    break;\n                }\n            }\n        }\n        // update edges\n        for (int cur = to; cur != from; cur = p[cur]) {\n            int prev = p[cur];\n            for (Edge& e : adj[prev]) {\n                if (e.to == cur && e.cap > 0) {\n                    e.cap -= flow;\n                    adj[cur][e.rev].cap += flow;\n                    pathCost += e.cost * flow;\n                    break;\n                }\n            }\n        }\n        return {flow, pathCost};\n    }\n\n    pair<int, int> getMinCostMaxFlow() {\n        int flow = 0, totalCost = 0;\n        while (findCheapestPath()) {\n            auto res = augmentPath(src, sink, INF);\n            flow += res.first;\n            totalCost += res.second;\n        }\n        return {flow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    const int letters = 'z' - 'a' + 1;\n    int n;\n    string s;\n    cin >> n >> s;\n    vector<int> b(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> b[i];\n    }\n\n    vector<int> letCount(letters, 0);\n    for (int i = 0; i < n; ++i) {\n        letCount[s[i] - 'a']++;\n    }\n\n    int source = 0;\n    int charOffSet = 1;\n    int pairOffSet = charOffSet + letters;\n    int sinkOffSet = pairOffSet + n / 2;\n    int sink = sinkOffSet;\n    int vNum = sinkOffSet + 1;\n\n    Graph g(vNum, source, sink);\n    for (int i = 0; i < letters; ++i) {\n        g.addEdge(source, charOffSet + i, letCount[i], 0);\n        for (int j = 0; j < n / 2; ++j) {\n            char c1 = s[j];\n            char c2 = s[n - j - 1];\n            if (c1 == 'a' + i) {\n                if (c1 == c2) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -max(b[j], b[n - j - 1]));\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[j]);\n                }\n            } else {\n                if (c2 == 'a' + i) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[n - j - 1]);\n                } else {\n                    g.addEdge(charOffSet