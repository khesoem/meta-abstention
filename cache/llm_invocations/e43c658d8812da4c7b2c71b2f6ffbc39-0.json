{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nusing i64 = long long;\n\ni64 read() {\n    i64 x = 0;\n    char c = getchar();\n    while (c < '0' || c > '9') c = getchar();\n    while (c >= '0' && c <= '9') {\n        x = x * 10 + (c - '0');\n        c = getchar();\n    }\n    return x;\n}\n\nconst i64 MOD1 = 1000000007, MOD2 = 998244353, B = 1000000;\ni64 n, idx, ans;\nvector<i64> bucket[7];\ni64 bucketSum[7];\n\ni64 mod2(i64 x) {\n    x %= MOD2;\n    if (x < 0) x += MOD2;\n    return x;\n}\n\nvoid buildTrie(i64 cur, i64 depth) {\n    ++idx;\n    i64 val = mod2(idx - cur);\n    bucket[depth].push_back(val);\n    bucketSum[depth] = (bucketSum[depth] + val) % MOD1;\n    if (depth == 6) return;\n    for (i64 d = 0; d < 10; ++d)\n        buildTrie(cur * 10 + d, depth + 1);\n}\n\nvoid queryRange(i64 cur) {\n    if (cur > n) return;\n    \n    if (cur * B + (B - 1) <= n && cur * B * 10 > n) {\n        i64 base = idx;\n        for (i64 d = 0, mul = 1; d <= 6; ++d, mul *= 10) {\n            i64 cnt = bucket[d].size();\n            i64 offset = mod2(base - cur * mul);\n            i64 needed = (MOD2 - offset) % MOD2;\n            i64 pos = lower_bound(bucket[d].begin(), bucket[d].end(), needed) - bucket[d].begin();\n            ans = (ans + offset * cnt % MOD1 + bucketSum[d] - (cnt - pos) * MOD1) % MOD1;\n            idx += cnt;\n        }\n        return;\n    }\n    \n    ++idx;\n    ans = (ans + mod2(idx - cur)) % MOD1;\n    for (i64 d = 0; d < 10; ++d)\n        queryRange(cur * 10 + d);\n}\n\nint main() {\n    n = read();\n    buildTrie(0, 0);\n    for (i64 i = 0; i <= 6; ++i)\n        sort(bucket[i].begin(), bucket[i].end());\n    idx = 0;\n    for (i64 i = 1; i <= 9; ++i)\n        queryRange(i);\n    ans = (ans % MOD1 + MOD1) % MOD1;\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD1 = 1000000007\nMOD2 = 998244353\nB = 1000000\n\ndef read():\n    x = 0\n    c = sys.stdin.read(1)\n    while c and (c < '0' or c > '9'):\n        c = sys.stdin.read(1)\n    while c and '0' <= c <= '9':\n        x = x * 10 + (ord(c) - ord('0'))\n        c = sys.stdin.read(1)\n    return x\n\ndef mod2(x):\n    x %= MOD2\n    if x < 0:\n        x += MOD2\n    return x\n\nbucket = [[] for _ in range(7)]\nbucketSum = [0] * 7\nn = 0\nidx = 0\nans = 0\n\ndef buildTrie(cur, depth):\n    global idx\n    idx += 1\n    val = mod2(idx - cur)\n    bucket[depth].append(val)\n    bucketSum[depth] = (bucketSum[depth] + val) % MOD1\n    if depth == 6:\n        return\n    for d in range(10):\n        buildTrie(cur * 10 + d, depth + 1)\n\ndef queryRange(cur):\n    global idx, ans\n    if cur > n:\n        return\n    \n    if cur * B + (B - 1) <= n and cur * B * 10 > n:\n        base = idx\n        mul = 1\n        for d in range(7):\n            cnt = len(bucket[d])\n            offset = mod2(base - cur * mul)\n            needed = (MOD2 - offset) % MOD2\n            pos = bisect.bisect_left(bucket[d], needed)\n            term = (offset * cnt % MOD1 + bucketSum[d] - (cnt - pos) * MOD1) % MOD1\n            ans = (ans + term) % MOD1\n            idx += cnt\n            mul *= 10\n        return\n    \n    idx += 1\n    ans = (ans + mod2(idx - cur)) % MOD1\n    for d in range(10):\n        queryRange(cur * 10 + d)\n\ndef main():\n    global n, idx, ans\n    n = read()\n    buildTrie(0, 0)\n    for i in range(7):\n        bucket[i].sort()\n    idx = 0\n    for i in range(1, 10):\n        queryRange(i)\n    ans = (ans % MOD1 + MOD1) % MOD1\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002454218047205359, -4.768370445162873e-07, -2.3841855067985307e-07, -0.0036206187214702368, -0.004190593026578426, -0.42871060967445374, -0.04666149988770485, -0.0009945451747626066, -2.145764938177308e-06, -0.0017119289841502905, -0.6344611048698425, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -8.487341256113723e-05, -1.1920928244535389e-07, -5.364403477869928e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -1.2516897186287679e-05, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -2.622600959512056e-06, -3.6954811548639555e-06, -7.986990567587782e-06, -1.3232143828645349e-05, -7.867782187531702e-06, -4.6967357775429264e-05, -4.0531076592742465e-06, -8.11782301752828e-05, -2.3841855067985307e-07, -2.622600959512056e-06, -2.0265558760002023e-06, 0.0, 0.0, -2.50339189733495e-06, -5.960462772236497e-07, 0.0, 0.0, 0.0, -1.4305104514278355e-06, -0.0053193699568510056, -0.009898505173623562, -0.00019691436318680644, -0.00115863885730505, -8.344646857949556e-07, -0.008026606403291225, 0.0, 0.0, -1.1920928244535389e-07, -1.4305104514278355e-06, -1.0728830375228426e-06, -0.014926415868103504, -2.0265373677830212e-05, -6.01988795096986e-05, -1.2993727978027891e-05, -0