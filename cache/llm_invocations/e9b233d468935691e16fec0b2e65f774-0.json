{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <cstring>\n#include <queue>\n#include <algorithm>\nusing namespace std;\n\n#define MAXN 6010\n#define INF 0x3f3f3f3f\n\nint n, m, k, c, d, ecnt, ans;\nint a[6010], x[6010], y[6010];\nint head[MAXN], pre[MAXN], dist[MAXN], inq[MAXN];\nqueue<int> q;\n\nstruct Edge {\n    int to, cap, cost, nxt;\n} e[2000010];\n\ninline int idx(int t, int v) { return t * n + v; }\n\ninline void link(int u, int v, int cap, int cost) {\n    e[ecnt] = {v, cap, cost, head[u]};\n    head[u] = ecnt++;\n    e[ecnt] = {u, 0, -cost, head[v]};\n    head[v] = ecnt++;\n}\n\nbool bfs_spfa(int s, int t) {\n    fill(dist, dist + MAXN, INF);\n    q.push(s);\n    dist[s] = 0;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = 0;\n        for (int i = head[u]; ~i; i = e[i].nxt) {\n            int v = e[i].to;\n            if (e[i].cap && dist[v] > dist[u] + e[i].cost) {\n                dist[v] = dist[u] + e[i].cost;\n                pre[v] = i;\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid update_flow(int s, int t) {\n    int cur = t;\n    while (cur != s) {\n        e[pre[cur]].cap--;\n        e[pre[cur] ^ 1].cap++;\n        cur = e[pre[cur] ^ 1].to;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    cin >> n >> m >> k >> c >> d;\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; ++i) {\n        cin >> a[i];\n        link(S, idx(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; ++i) {\n        cin >> x[i] >> y[i];\n    }\n    for (int t = 0; t <= 100; ++t) {\n        for (int i = 2; i <= n; ++i) {\n            link(idx(t, i), idx(t + 1, i), k, c);\n        }\n        link(idx(t, 1), T, k, 0);\n        for (int i = 1; i <= m; ++i) {\n            int limit = min(k, 25);\n            for (int j = 1; j <= limit; ++j) {\n                int cost = c + (2 * j - 1) * d;\n                link(idx(t, x[i]), idx(t + 1, y[i]), 1, cost);\n                link(idx(t, y[i]), idx(t + 1, x[i]), 1, cost);\n            }\n        }\n    }\n    while (bfs_spfa(S, T)) update_flow(S, T);\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    MAXN = 6010\n    INF = 0x3f3f3f3f\n    \n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    ecnt = 0\n    ans = 0\n    \n    a = [0] * (k + 1)\n    x = [0] * (m + 1)\n    y = [0] * (m + 1)\n    \n    head = [-1] * MAXN\n    pre = [0] * MAXN\n    dist = [INF] * MAXN\n    inq = [0] * MAXN\n    \n    # Edge structure: list of dictionaries\n    e = []\n    \n    def idx(t, v):\n        return t * n + v\n    \n    def link(u, v, cap, cost):\n        nonlocal ecnt\n        # Forward edge\n        e.append({'to': v, 'cap': cap, 'cost': cost, 'nxt': head[u]})\n        head[u] = ecnt\n        ecnt += 1\n        # Backward edge\n        e.append({'to': u, 'cap': 0, 'cost': -cost, 'nxt': head[v]})\n        head[v] = ecnt\n        ecnt += 1\n    \n    def bfs_spfa(s, t):\n        nonlocal dist, pre, inq, e, head\n        dist = [INF] * MAXN\n        q = deque()\n        q.append(s)\n        dist[s] = 0\n        inq = [0] * MAXN\n        inq[s] = 1\n        \n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            i = head[u]\n            while i != -1:\n                edge = e[i]\n                v = edge['to']\n                if edge['cap'] > 0 and dist[v] > dist[u] + edge['cost']:\n                    dist[v] = dist[u] + edge['cost']\n                    pre[v] = i\n                    if not inq[v]:\n                        q.append(v)\n                        inq[v] = 1\n                i = edge['nxt']\n        return dist[t] < 1e9\n    \n    def update_flow(s, t):\n        nonlocal ans, e\n        cur = t\n        while cur != s:\n            edge_idx = pre[cur]\n            e[edge_idx]['cap'] -= 1\n            e[edge_idx ^ 1]['cap'] += 1\n            cur = e[edge_idx ^ 1]['to']\n        ans += dist[t]\n    \n    # Initialize\n    S = 0\n    T = 6000\n    \n    # Read a[i]\n    for i in range(1, k + 1):\n        a[i] = int(next(it))\n        link(S, idx(0, a[i]), 1, 0)\n    \n    # Read x[i], y[i]\n    for i in range(1, m + 1):\n        x[i] = int(next(it))\n        y[i] = int(next(it))\n    \n    # Build graph\n    for t in range(0, 101):\n        # Connect same node across time steps\n        for i in range(2, n + 1):\n            link(idx(t, i), idx(t + 1, i), k, c)\n        \n        # Connect node 1 to T\n        link(idx(t, 1), T, k, 0)\n        \n        # Add edges for m roads\n        for i in range(1, m + 1):\n            limit = min(k, 25)\n            for j in range(1, limit + 1):\n                cost = c + (2 * j - 1) * d\n                link(idx(t, x[i]), idx(t + 1, y[i]), 1, cost)\n                link(idx(t, y[i]), idx(t + 1, x[i]), 1, cost)\n    \n    # Run min cost max flow\n    while bfs_spfa(S, T):\n        update_flow(S, T)\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014125302550382912, -8.344646857949556e-07, -1.1920928244535389e-07, -0.006110438611358404, -0.008946925401687622, -2.3841855067985307e-07, -8.606540359323844e-05, -0.0003219324571546167, -1.9073468138230965e-06, -0.00016032364510465413, -0.00020728347590193152, -0.37370261549949646, -0.18689027428627014, -6.031808152329177e-05, -8.344646857949556e-07, -0.23686955869197845, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, 0.0, -2.145764938177308e-06, -9.536738616588991e-07, -7.867782187531702e-06, -1.7881377516459906e-06, -0.001729184528812766, -3.814689989667386e-06, -0.006753121502697468, -0.0001234931987710297, -2.861018856492592e-06, -5.960462772236497e-07, -2.3841830625315197e-06, -1.1920928244535389e-07, -8.344646857949556e-07, -7.152555099310121e-07, -1.0728830375228426e-06, -1.4305104514278355e-06, -7.510157047363464e-06, -0.12784479558467865, -3.814689989667386e-06, -0.9531093835830688, -3.4570634852570947e-06, -0.057586316019296646, -2.658331868587993e-05, -0.0032198987901210785, -3.814689989667386e-06, -0.0067248218692839146, -1.7881233361549675e-05, -3.576272320060525e-06, -0.3864056169986725, -9.417489309271332e-06, -2.3841855067985307e-07, -9.417489309271332e-06, -2.3841855067985307e-07, -0.0001436368766007945, -0.0005315321614034474, -1.4305104514278355e-06, -0.11069346219301224, -2.9802276912960224e-06, -0.00016234986833296716, -0.01606742851436138, -1.6689286894688848e-06, -2.777537883957848e-05, -4.768370445162873e-07, -4.768370445162873e-07, -4.172316494077677e-06, -2.2411095415009186e-05, -1.6689160474925302e-05, 