> ans(a.size());\n    for (size_t i = 0; i < a.size(); i++) {\n        ans[bitReverse(i, k)] = a[i];\n    }\n    return ans;\n}\n\nvector<int64_t> numberTheoreticTransform(vector<int64_t> coef, int k, bool inverse) {\n    coef = reorderArray(coef, k);\n    vector<int64_t> roots = calcRoots(k, inverse);\n    for (int s = 0; s < k; s++) {\n        int len = 1 << s;\n        for (int st = 0; st < (int)coef.size(); st += 2 * len) {\n            int64_t curRoot = 1;\n            for (int j = st; j < st + len; j++) {\n                int64_t t = (curRoot * coef[j + len]) % MOD;\n                int64_t u = coef[j];\n                coef[j] = (u + t) % MOD;\n                coef[j + len] = (u - t + MOD) % MOD;\n                curRoot = (roots[s] * curRoot) % MOD;\n            }\n        }\n    }\n    return coef;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n_input, m;\n    cin >> n_input >> m;\n    int n = n_input / 2;\n    vector<int> nums(m);\n    int maxVal = 0;\n    for (int i = 0; i < m; i++) {\n        cin >> nums[i];\n        maxVal = max(maxVal, nums[i]);\n    }\n    int min_size = n * maxVal + 1;\n    int size = 1;\n    int k = 0;\n    while (size < min_size) {\n        size <<= 1;\n        k++;\n    }\n    vector<int64_t> a(size, 0);\n    for (int num : nums) {\n        a[num] = 1;\n    }\n    a = numberTheoreticTransform(a, k, false);\n    for (size_t i = 0; i < a.size(); i++) {\n        a[i] = modPow(a[i], n);\n    }\n    a = numberTheoreticTransform(a, k, true);\n    int64_t ans = 0;\n    for (size_t i = 0; i < a.size(); i++) {\n        ans = (ans + a[i] * a[i]) % MOD;\n    }\n    int64_t multiplier = modInv(size);\n    int64_t result = ((ans * multiplier) % MOD * multiplier) % MOD;\n    cout << result << \"\\n\";\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0005967585020698607, -0.0001182052365038544, -6.704273118884885e-07, -0.00022880789765622467, -1.93612649468377