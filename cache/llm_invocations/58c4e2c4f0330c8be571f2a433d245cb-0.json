d * self.dis[t]\n            flow += add\n        return mincost\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    a = [0] + [int(next(it)) for _ in range(k)]\n\n    mx = 100\n    cnt = 0\n    id = [[0] * (mx + 1) for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        for j in range(mx + 1):\n            cnt += 1\n            id[i][j] = cnt\n\n    mcmf = MCMF(cnt + 5)\n    s = mcmf.n - 2\n    t = mcmf.n - 3\n\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(mx):\n            for h in range(1, k + 1):\n                tmp = h * h * d - (h - 1) * (h - 1) * d\n                mcmf.link(id[u][j], id[v][j + 1], 1, c + tmp)\n                mcmf.link(id[v][j], id[u][j + 1], 1, c + tmp)\n\n    for i in range(1, n + 1):\n        for j in range(mx):\n            mcmf.link(id[i][j], id[i][j + 1], INF, c)\n\n    for i in range(1, k + 1):\n        mcmf.link(s, id[a[i]][0], 1, 0)\n\n    for j in range(1, mx + 1):\n        mcmf.link(id[1][j], t, INF, 0)\n\n    ans = mcmf.run(s, t)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-5.483612312673358e-06, 0.0, 0.0, -0.0015788720920681953, -0.05792432650923729, -0.00015984688070602715, -3.957670196541585e-05, -1.883488948806189e-05, 0.0, 0.0, 0.0, -0.00020859450160060078, -0.2014685869216919, -0.005012920126318932, -1.7881377516459906e-06, -0.00020382710499688983, -0.03804141283035278, -1.9311717551317997e-05, -0.003423308255150914, -3.576278118089249e-07, -1.1920928244535389e-07, -2.264974000354414e-06, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -4.6967357775429264e-05, -0.00013207517622504383, 0.0, 0.0, 0.0