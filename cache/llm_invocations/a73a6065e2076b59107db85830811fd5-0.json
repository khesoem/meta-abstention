ctor<long>(501, 0));\n        ncr[0][0] = 1;\n        for (int i = 1; i < ncr.size(); i++) {\n            ncr[i][0] = 1;\n            for (int j = 1; j < ncr[0].size(); j++) {\n                ncr[i][j] = (ncr[i - 1][j] + ncr[i - 1][j - 1]) % mod;\n                if(ncr[i][j] == 0) ncr[i][j] += mod;\n            }\n        }\n\n        long res = 0;\n        for(int i = n - 2; i >= 0; i--) {\n            int cnt = n - i;\n            int pre = n - cnt;\n            long com = ((ncr[n][pre] * fact[pre]) % mod);\n            if(com == 0) com += mod;\n            long sum = 0;\n\n            for(int dif = 1; dif < cnt; dif++){\n                for(int inv = dif; inv < dp.size(); inv++){\n                    if(dp[cnt - 1] == 0){\n                        break;\n                    }\n                    if(inv - dif - 1 < 0) continue;\n                    long x = dp[cnt - 2];\n                    long y = sums[cnt - 2][inv - dif - 1];\n                    long mult = (x * y) % mod;\n                    if(mult == 0) mult += mod;\n                    sum += mult * (cnt - dif);\n                    sum %= mod;\n                }\n            }\n            res += sum * com;\n            res %= mod;\n            if(res == 0) res += mod;\n        }\n\n        cout << (res % mod) << '\\n';\n    }\n};\n\nint main() {\n    FastScanner fs;\n    int T = 1;\n    for(int t = 0; t < T; t++){\n        Solution sol1(fs);\n        sol1.solution(T, t);\n    }\n    return 0;\n}\n</translated_code>\n<confidence>\n<0.95>\n</confidence>", "token_logprobs": [-0.1015879362821579, -0.00034994049929082394, -0.2371709942817688, -0.0359811894595623, -0.05256972461938858, -1.2279229164123535, -0.000104313570773229, -5.960482212685747e-06, -0.0009800228290259838, -0.2818329930305481, -0.4530176520347595, -0.0002980080316774547, -1.3351529560168274e-05, -1.2241345643997192, -2.1008613109588623, -0.06610797345638275, -0.01329887192696333, -0.09868141263723373, -0.2355947345495224, -2.016337871551