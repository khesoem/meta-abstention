        S = sc.next();\n        for (int i = 0; i <= 60; i++) {\n            comb[i][0] = comb[i][i] = 1;\n            for (int j = 1; j < i; j++)\n                comb[i][j] = comb[i-1][j-1] + comb[i-1][j];\n        }\n        for (int i = 0; i < 31; i++) {\n            dpL[i] = new ArrayList<>();\n            dpR[i] = new ArrayList<>();\n        }\n    }\n\n    static void dfs(int kind, int ind, int a, int b, int mask, long p, int C, ArrayList<Pair>[] dp) {\n        if (ind == C+1) {\n            dp[a].add(new Pair(p, mask));\n            return;\n        }\n        if (kind == 0) {\n            dfs(0, ind+1, a+1, b, mask ^ (1<<ind), p + (comb[a+1][R] - comb[a][R]) * (comb[R+C][R] - comb[b][R]), C, dp);\n            dfs(0, ind+1, a, b+1, mask, p - (comb[b+1][R] - comb[b][R]) * (comb[R+C][R] - comb[a][R]), C, dp);\n        } else {\n            dfs(1, ind+1, a-1, b, mask ^ (1<<ind), p + (comb[a][R] - comb[a-1][R]) * (comb[R+C][R] - comb[b][R]), C, dp);\n            dfs(1, ind+1, a, b-1, mask, p - (comb[b][R] - comb[b-1][R]) * (comb[R+C][R] - comb[a][R]), C, dp);\n        }\n    }\n\n    static int rev(int x, int y) {\n        int z = 0;\n        for (int i = 0; i < y; i++) if ((x & (1<<i)) != 0) z ^= (1<<(y-1-i));\n        return z;\n    }\n\n    static boolean ok(long x) {\n        for (int i = 0; i <= C; i++) {\n            if ((x & (1L<<i)) != 0) { if (S.charAt(S.length() - C - 1 + i) == 'B') return false; }\n            else { if (S.charAt(S.length() - C - 1 + i) == 'A') return false; }\n        }\n        return true;\n    }\n\n    static void check(long x, int t) {\n        int a = 0, b = 0;\n        for (int i = 0; i <= 2*C+1; i++) {\n            if ((x & (1L<<i)) != 0) a++; else b++;\n            if (a != 0 && b != 0) {\n                for (int j = i; j <= 2*C+1; j++) {\n                    if ((x & (1L<<j)) != 0) { if (S.charAt(S.length() - (2*C+2) + j) == 'B') return; }\n                    else { if (S.charAt(S.length() - (2*C+2) + j) == 'A') return; }\n                }\n                int aa = 0, bb = 0;\n                for (int j = 0; j < S.length() - (2*C+2) + i; j++) {\n                    if (S.charAt(j) == 'A') aa++;\n                    if (S.charAt(j) == 'B') bb++;\n                }\n                long tmp;\n                if ((x & (1L<<i)) != 0) tmp = comb[R-1-aa + b+R-1-bb][R-1-aa];\n                else tmp = comb[a+R-1-aa + R-1-bb][a+R-1-aa];\n                ans += t * tmp;\n                return;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        init();\n        dfs(0, 0, R-1, R-1, 0, 0, C, dpL);\n        dfs(1, 0, R+C, R+C, 0, 0, C, dpR);\n        long dif = INF;\n        for (int i = 0; i <= R+C; i++) {\n            Collections.sort(dpL[i]);\n            Collections.sort(dpR[i], (p1, p2) -> Long.compare(p2.first, p1.first));\n            int idx = 0;\n            for (Pair p : dpL[i]) {\n                while (idx + 1 < dpR[i].size() && p.first + dpR[i].get(idx+1).first >= 0) idx++;\n                dif = Math.min(dif, Math.abs(p.first + dpR[i].get(idx).first));\n                if (idx + 1 < dpR[i].size()) dif = Math.min(dif, Math.abs(p.first + dpR[i].get(idx+1).first));\n            }\n        }\n        for (int i = 0; i <= R+C; i++) {\n            ArrayList<Pair> z = new ArrayList<>();\n            for (Pair p : dpR[i]) {\n                if (ok(rev(p.second, C+1))) z.add(p);\n            }\n            int l = 0, r = -1;\n            for (Pair p : dpL[i]) {\n                while (l < z.size() && p.first + z.get(l).first > dif) l++;\n                while (r + 1 < z.size() && p.first + z.get(r+1).first >= -dif) r++;\n                if (l <= r) check(p.second | ((long)rev(z.get(l).second, C+1) << (C+1)), r - l + 1);\n            }\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.004360928200185299, -1.7881233361549675e-05, 0.0, 0.0, -0.00018654513405635953, -0.00