\n        a = Edge(v, len(self.g[v]), cap, cost)\n        b = Edge(u, len(self.g[u]), 0, -cost)\n        self.g[u].append(a)\n        self.g[v].append(b)\n\n    def bfs(self, s, t):\n        self.level = [-1] * self.n\n        q = deque()\n        self.level[s] = 0\n        q.append(s)\n        while q:\n            v = q.popleft()\n            for e in self.g[v]:\n                if e.cap > 0 and self.level[e.to] < 0 and e.cost + self.pot[v] - self.pot[e.to] == 0:\n                    self.level[e.to] = self.level[v] + 1\n                    q.append(e.to)\n        return self.level[t] != -1\n\n    def dfs(self, v, t, f):\n        if v == t:\n            return f\n        for i in range(self.iter[v], len(self.g[v])):\n            self.iter[v] = i\n            e = self.g[v][i]\n            if e.cap > 0 and self.level[e.to] == self.level[v] + 1 and e.cost + self.pot[v] - self.pot[e.to] == 0:\n                ret = self.dfs(e.to, t, min(f, e.cap))\n                if ret:\n                    e.cap -= ret\n                    self.g[e.to][e.rev].cap += ret\n                    return ret\n        return 0\n\n    def send_blocking(self, s, t, limit):\n        flow = 0\n        while flow < limit and self.bfs(s, t):\n            self.iter = [0] * self.n\n            while flow < limit:\n                f = self.dfs(s, t, limit - flow)\n                if not f:\n                    break\n                flow += f\n        return flow\n\n    def min_cost_flow(self, s, t, need):\n        INF = 10**18\n        flow = 0\n        cost = 0\n        dist = [0] * self.n\n\n        while flow < need:\n            dist = [INF] * self.n\n            dist[s] = 0\n            pq = [(0, s)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if d != dist[v]:\n                    continue\n                for e in self.g[v]:\n                    if e.cap <= 0:\n                        continue\n                    nd = d + e.cost + self.pot[v] - self.pot[e.to]\n                    if nd < dist[e.to]:\n                        dist[e.to] = nd\n                        heapq.heappush(pq, (nd, e.to))\n\n            if dist[t] == INF:\n                break\n\n            for v in range(self.n):\n                if dist[v] < INF:\n                    self.pot[v] += dist[v]\n\n            pushed = self.send_blocking(s, t, need - flow)\n            if pushed == 0:\n                break\n            flow += pushed\n            cost += pushed * self.pot[t]\n\n        return flow, cost\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    starts = [0] * N\n    for _ in range(K):\n        a = int(next(it)) - 1\n        starts[a] += 1\n\n    maxT = K + N + 1\n    V = (maxT + 1) * N + 2\n    src = V - 2\n    sink = V - 1\n\n    mcf = MinCostFlow(V)\n\n    for i in range(N):\n        if starts[i]:\n            mcf.add_edge(src, i, starts[i], 0)\n\n    for t in range(maxT + 1):\n        mcf.add_edge(t * N, sink, K, 0)\n\n    for i in range(N):\n        for t in range(maxT):\n            mcf.add_edge(t * N + i, (t + 1) * N + i, K, C)\n\n    for _ in range(M):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for t in range(maxT):\n            for j in range(K):\n                c = C + (2 * j + 1) * D\n                mcf.add_edge(t * N + u, (t + 1) * N + v, 1, c)\n                mcf.add_edge(t * N + v, (t + 1) * N + u, 1, c)\n\n    flow, cost = mcf.min_cost_flow(src, sink, K)\n    assert flow == K\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00015889335, 0.0, -3.576278e-07, -0.005248577, -0.015758859, -1.5022643, -0.03176114, -1.136943, -0.04041057, -9.5367386e-07, -0.00016795179, -1.141229, -0.1272661, -0.014293314, -0.014255825, -0.008120733, -0.3869167, -3.4570635e-06, -2.26