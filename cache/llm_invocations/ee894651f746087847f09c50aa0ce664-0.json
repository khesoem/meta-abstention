return 0;\n    }\n    fac[0] = ifac[0] = f[0][0] = 1;\n    m = 1; lg = 0;\n    while (m <= n) { m <<= 1; ++lg; }\n    for (int i = 1; i <= n; ++i) {\n        inv[i] = (i == 1) ? 1 : 1LL * (mod - mod / i) * inv[mod % i] % mod;\n        fac[i] = 1LL * fac[i - 1] * i % mod;\n        ifac[i] = 1LL * ifac[i - 1] * inv[i] % mod;\n        cnt[i] = __builtin_popcount(i);\n        f[i][cnt[i]] = ifac[i];\n    }\n    v[n] = 1;\n    for (int i = n; i; --i) {\n        if (!v[i]) continue;\n        for (int j = i; j; j = (j - 1) & i)\n            v[j] = 1;\n    }\n    for (int i = 1; i < m; i <<= 1)\n        for (int j = 0; j <= n; ++j)\n            if (j & i) add(f[j], f[j ^ i], 1);\n    for (int i = 0; i <= n; ++i)\n        if (v[i]) fpm(f[i], k);\n    for (int i = 1; i < m; i <<= 1)\n        for (int j = 0; j <= n; ++j)\n            if (j & i) add(f[j], f[j ^ i], 0);\n    int ans = (qpow(k, n) - 1LL * f[n][cnt[n]] * fac[n] % mod + mod) % mod;\n    cout << ans;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n\n    if n & 1:\n        print(pow(k, n, mod))\n        return\n\n    # compute m and lg\n    m = 1\n    lg = 0\n    while m <= n:\n        m <<= 1\n        lg += 1\n\n    # precompute factorials, inverse factorials, and popcounts\n    fac = [0] * (n + 1)\n    ifac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    cnt = [0] * (n + 1)\n    fac[0] = ifac[0] = 1\n    for i in range(1, n + 1):\n        inv[i] = 1 if i == 1 else (mod - mod // i) * inv[mod % i] % mod\n        fac[i] = fac[i - 1] * i % mod\n        ifac[i] = ifac[i - 1] * inv[i] % mod\n        cnt[i] = i.bit_count()\n\n    # f[i] is a polynomial of length lg\n    f = [[0] * lg for _ in range(n + 1)]\n 