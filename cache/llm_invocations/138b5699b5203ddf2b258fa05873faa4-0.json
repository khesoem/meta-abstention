\n        buf[i], buf[j] = buf[j], buf[i]\n        return ''.join(buf)\n\n    def fast(self, s):\n        s = self.prepare(s)\n        n = len(s)\n        a = [self.STR.index(c) for c in s]\n\n        sz = [0, 0, 0]\n        pos = [[0]*n for _ in range(3)]\n        cntHere = [[[0]*3 for _ in range(n)] for _ in range(3)]\n        pref = [[0,0,0] for _ in range(n+1)]\n        for i in range(n):\n            c = a[i]\n            cntHere[c][sz[c]] = pref[i][:]\n            pos[c][sz[c]] = i\n            sz[c] += 1\n            pref[i+1] = pref[i][:]\n            pref[i+1][c] += 1\n\n        dp = [[[[self.INF for _ in range(sz[2]+1)] for _ in range(sz[1]+1)] for _ in range(sz[0]+1)] for _ in range(2)]\n        ans = self.INF\n        dp[0][0][0][0] = 0\n\n        for j0 in range(sz[0] + 1):\n            for j1 in range(sz[1] + 1):\n                for j2 in range(sz[2] + 1):\n                    for last in [0,1]:\n                        idx = j0 + j1 + j2\n                        curVal = dp[last][j0][j1][j2]\n                        if curVal == self.INF:\n                            continue\n                        if idx == n:\n                            ans = min(ans, curVal)\n                            continue\n                        if j0 < sz[0]:\n                            cost = max(j1 - cntHere[0][j0][1], 0) + max(j2 - cntHere[0][j0][2], 0)\n                            if dp[1][j0+1][j1][j2] > curVal + cost:\n                                dp[1][j0+1][j1][j2] = curVal + cost\n                        if j1 < sz[1] and last == 0:\n                            cost = max(j0 - cntHere[1][j1][0], 0) + max(j2 - cntHere[1][j1][2], 0)\n                            if dp[0][j0][j1+1][j2] > curVal + cost:\n                                dp[0][j0][j1+1][j2] = curVal + cost\n                        if j2 < sz[2]:\n                            cost = max(j0 - cntHere[2][j2][0], 0) + max(j1 - cntHere[2][j2][1], 0)\n                            if dp[0][j0][j1][j2+1] > curVal + cost:\n                                dp[0][j0][j1][j2+1] = curVal + cost\n        return ans\n\n    def genStr(self):\n        n = random.randint(1, 15)\n        buf = [random.choice(self.STR) for _ in range(n)]\n        return ''.join(buf)\n\n    def stress(self):\n        tst = 0\n        while True:\n            s = self.genStr()\n            fast_res = self.fast(s)\n            slow_res = self.slow(s)\n            if fast_res != slow_res:\n                print(f\"Discrepancy for string: {s}\")\n                print(f\"Fast: {fast_res}\")\n                print(f\"Slow: {slow_res}\")\n                raise AssertionError(\"Results do not match\")\n            print(f\"Test {tst}\")\n            tst += 1\n\n    def nextToken(self):\n        while self.st is None or not self.st:\n            line = self.br.readline()\n            if not line:\n                self.eof = True\n                return None\n            self.st = line.strip().split()\n        return self.st.pop(0)\n\n    def nextString(self):\n        try:\n            return self.br.readline().rstrip('\\n')\n        except:\n            self.eof = True\n            return None\n\n    def nextInt(self):\n        return int(self.nextToken())\n\n    def nextLong(self):\n        return int(self.nextToken())\n\n    def nextDouble(self):\n        return float(self.nextToken())\n\nC()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020950057660229504, -0.0011676029535010457, -1.6240566083070007e-06, -6.384836888173595e-05, -0.00045438710367307067, -1.1994775377388578e-05, -9.269565634895116e-05, -1.1369190216064453, -0.07420610636472702, -0.007637389935553074, -8.637786231702194e-05, -1.5279592275619507, -0.38742977380752563, -0.00012856863031629473, -0.2162778526544571, -0.0005593468667939305, -0.8288043141365051, -1.6286106983898208e-05, -0.06995488703250885, -0.0011678413720801473, -0.1492980271577835, -0.00023643692838959396, 0.0, 0.0, 0.0, -1.16371647891355