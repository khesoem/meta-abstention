int maxN) {\n        fact = new long[maxN + 1];\n        invFact = new long[maxN + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= maxN; i++) {\n            fact[i] = fact[i - 1] * i % MOD;\n        }\n        invFact[maxN] = modPow(fact[maxN], MOD - 2);\n        for (int i = maxN - 1; i >= 0; i--) {\n            invFact[i] = invFact[i + 1] * (i + 1) % MOD;\n        }\n    }\n\n    long nCr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n    }\n\n    long modPow(long base, long exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = res * base % MOD;\n            base = base * base % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    // Fast I/O\n    private final BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n    private StringTokenizer st;\n\n    private String next() throws IOException {\n        while (st == null || !st.hasMoreTokens()) {\n            st = new StringTokenizer(br.readLine());\n        }\n        return st.nextToken();\n    }\n\n    private int nextInt() throws IOException {\n        return Integer.parseInt(next());\n    }\n\n    private long nextLong() throws IOException {\n        return Long.parseLong(next());\n    }\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\nusing namespace std;\n\nconst long long MOD = 998244353LL;\n\nvector<long long> fact;\nvector<long long> invFact;\n\nlong long modPow(long long base, long long exp) {\n    long long res = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) res = (res * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nvoid initFactorials(int maxN) {\n    fact.resize(maxN + 1);\n    invFact.resize(maxN + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= maxN; i++) {\n        fact[i] = (fact[i - 1] * i) % MOD;\n    }\n    invFact[maxN] = modPow(fact[maxN], MOD - 2);\n    for (int i = maxN - 1; i >= 0; i--) {\n        invFact[i] = (invFact[i + 1] * (i + 1)) % MOD;\n    }\n}\n\nlong long nCr(int n, int r) {\n    if (r < 0 || r > n) return 0;\n    return (fact[n] * invFact[r] % MOD) * invFact[n - r] % MOD;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    long long tmp;\n    cin >> n >> tmp;\n\n    if (n <= tmp) {\n        cout << 0 << endl;\n        return 0;\n    }\n\n    int k = static_cast<int>(tmp);\n    initFactorials(400000);\n\n    long long result = 0;\n    int alternatingSign = 1;\n    long long multiplier = nCr(n, n - k);\n\n    for (int i = n - k; i >= 1; i--) {\n        long long term = (long long)alternatingSign * nCr(n - k, i) % MOD;\n        term = (term * modPow(i, n)) % MOD;\n        result = (result + term) % MOD;\n        alternatingSign *= -1;\n    }\n\n    result = (result * multiplier) % MOD;\n    if (k != 0) result = (result * 2) % MOD;\n    if (result < 0) result += MOD;\n\n    cout << result << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012587709352374077, -2.622600959512056e-06, -8.344646857949556e-07, -0.0013256819220259786, -5.960462772236497e-07, -3.755022044060752e-05, -5.602820692729438e-06, -3.2543604902457446e-05, -3.2186455882765586e-06, -0.017089959233999252, -1.156323378381785e-05, -7.784063927829266e-05, -1.1920928244535389e-07, -0.0069510783068835735, -0.00011145447206217796, -0.00023135847004596144, -9.536738616588991e-07, -0.05986857786774635, -0.0008049347088672221, -0.012515575625002384, -3.576278118089249e-07, -0.5833997130393982, -0.03364657983183861, -0.523165225982666, -2.5748875486897305e-05, -4.649151378544047