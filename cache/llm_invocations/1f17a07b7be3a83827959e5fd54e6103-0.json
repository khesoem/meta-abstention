{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nconst int MAX_N = 1000000;\nint freq[MAX_N + 2], source, sink;\nvector<int> graph[MAX_N + 2];\n\nconst int INF = 1000000000;\n\nstruct Edge {\n    int from, to, flow, cap, cost;\n};\n\nvector<Edge> edges;\nvector<int> adj[MAX_N + 2];\n\nvoid addEdge(int u, int v, int capacity, int cost) {\n    edges.push_back({u, v, 0, capacity, cost});\n    adj[u].push_back(edges.size() - 1);\n    edges.push_back({v, u, 0, 0, -cost});\n    adj[v].push_back(edges.size() - 1);\n}\n\nint dist[MAX_N + 2], inq[MAX_N + 2], minFlow[MAX_N + 2], parentEdge[MAX_N + 2];\n\npair<int, int> spfa(int n) {\n    fill(dist, dist + n + 2, INF);\n    queue<int> q;\n    q.push(source);\n    dist[source] = 0;\n    inq[source] = 1;\n    minFlow[source] = INF;\n\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = 0;\n        for (int id : adj[u]) {\n            int v = edges[id].to;\n            if (edges[id].cap > edges[id].flow && dist[v] > dist[u] + edges[id].cost) {\n                dist[v] = dist[u] + edges[id].cost;\n                parentEdge[v] = id;\n                minFlow[v] = min(minFlow[u], edges[id].cap - edges[id].flow);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (dist[sink] == INF) return {0, 0};\n\n    int augment = minFlow[sink];\n    int cur = sink;\n    while (cur != source) {\n        int eid = parentEdge[cur];\n        edges[eid].flow += augment;\n        edges[eid ^ 1].flow -= augment;\n        cur = edges[eid].from;\n    }\n\n    return {augment, augment * dist[sink]};\n}\n\npair<int, int> mcmf(int n) {\n    int totalFlow = 0, totalCost = 0;\n    while (true) {\n        auto [flow, cost] = spfa(n);\n        if (flow == 0) break;\n        totalFlow += flow;\n        totalCost += cost;\n    }\n    return {totalFlow, totalCost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; i++) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        graph[u].push_back(v);\n        graph[v].push_back(u);\n    }\n\n    source = 0;\n    sink = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; t++) {\n        for (int i = 1; i <= n; i++) {\n            addEdge(n * t + i, n * (t + 1) + i, k, 0);\n            for (int neighbor : graph[i]) {\n                for (int cp = 1; cp <= k; cp++) {\n                    addEdge(n * t + i, n * (t + 1) + neighbor, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; i++) {\n        if (freq[i]) {\n            addEdge(source, i, freq[i], 0);\n        }\n    }\n\n    for (int t = 0; t <= 100; t++) {\n        addEdge(n * t + 1, sink, k, c * t);\n    }\n\n    cout << mcmf(sink).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    freq = [0] * (n + 2)\n    for _ in range(k):\n        x = int(next(it))\n        freq[x] += 1\n    \n    graph = [[] for _ in range(n + 2)]\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        graph[u].append(v)\n        graph[v].append(u)\n    \n    source = 0\n    sink = 100 * n + n + 1\n    \n    # Edge structure: (from, to, flow, cap, cost)\n    edges = []\n    adj = [[] for _ in range(sink + 2)]\n    \n    def add_edge(u, v, capacity, cost):\n        edges.append([u, v, 0, capacity, cost])\n        adj[u].append(len(edges) - 1)\n        edges.append([v, u, 0, 0, -cost])\n        adj[v].append(len(edges) - 1)\n    \n    # Build the time-expanded graph\n    for t in range(100):\n        for i in range(1, n + 1):\n            add_edge(n * t + i, n * (t + 1) + i, k, 0)\n            for neighbor in graph[i]:\n                for cp in range(1, k + 1):\n                    add_edge(n * t + i, n * (t + 1) + neighbor, 1, d * (2 * cp - 1))\n    \n    # Connect source to initial positions\n    for i in range(1, n + 1):\n        if freq[i]:\n            add_edge(source, i, freq[i], 0)\n    \n    # Connect to sink\n    for t in range(101):\n        add_edge(n * t + 1, sink, k, c * t)\n    \n    INF = 1000000000\n    \n    def spfa():\n        dist = [INF] * (sink + 2)\n        inq = [0] * (sink + 2)\n        min_flow = [0] * (sink + 2)\n        parent_edge = [-1] * (sink + 2)\n        \n        q = deque()\n        dist[source] = 0\n        inq[source] = 1\n        min_flow[source] = INF\n        q.append(source)\n        \n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for id in adj[u]:\n                v = edges[id][1]\n                if edges[id][3] > edges[id][2] and dist[v] > dist[u] + edges[id][4]:\n                    dist[v] = dist[u] + edges[id][4]\n                    parent_edge[v] = id\n                    min_flow[v] = min(min_flow[u], edges[id][3] - edges[id][2])\n                    if not inq[v]:\n                        q.append(v)\n                        inq[v] = 1\n        \n        if dist[sink] == INF:\n            return (0, 0)\n        \n        augment = min_flow[sink]\n        cur = sink\n        while cur != source:\n            eid = parent_edge[cur]\n            edges[eid][2] += augment\n            edges[eid ^ 1][2] -= augment\n            cur = edges[eid][0]\n        \n        return (augment, augment * dist[sink])\n    \n    total_flow = 0\n    total_cost = 0\n    while True:\n        flow, cost = spfa()\n        if flow == 0:\n            break\n        total_flow += flow\n        total_cost += cost\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001411338453181088, -5.960462772236497e-07, -2.3841855067985307e-07, -0.07118441164493561, -0.007579142227768898, -2.3841855067985307e-07, -4.672895011026412e-05, -0.0001896439935080707, -7.152555099310121e-07, -0.002481002826243639, -0.055570751428604126, -0.02255488932132721, -0.04507673159241676, -2.47952248173533e-05, -7.152555099310121e-07, -0.002613345393911004, -0.0026721982285380363, -4.6491513785440475e-06, -1.0132738680113107e-05, -0.05679812654852867, -0.0007975496700964868, -3.3378546504536644e-06, -0.00012599628826137632, 0.0, -0.004112834110856056, -1.6689286894688848e-06, -0.0001674750237725675, -0.0002244459028588608, -0.014165094122290611, -1.0728830375228426e-06, -0.6935507655143738, -2.145764938177308e-06, -5.006777428206988e-06, -0.00011240804451517761, -2.264974000354414e-06, -1.7881377516459906e-06, 0.0, -1.513946517661