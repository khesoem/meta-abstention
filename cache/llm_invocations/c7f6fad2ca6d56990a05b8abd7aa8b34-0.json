        for (int i = 0; i < parts.length; i++) {\n            res[i] = Integer.parseInt(parts[i]);\n        }\n        return res;\n    }\n\n    static List<Integer> factorList(int n) {\n        List<Integer> res = new ArrayList<>();\n        int i = 1;\n        while (i * i <= n) {\n            if (n % i == 0) {\n                res.add(i);\n                res.add(n / i);\n            }\n            i++;\n        }\n        Collections.sort(res);\n        // remove duplicates\n        Set<Integer> set = new LinkedHashSet<>(res);\n        return new ArrayList<>(set);\n    }\n\n    static int modInv(int n) {\n        return BigInteger.valueOf(n).modPow(BigInteger.valueOf(MOD - 2), BigInteger.valueOf(MOD)).intValue();\n    }\n\n    static int maxWins() {\n        return Math.min(r1, s2) + Math.min(s1, p2) + Math.min(p1, r2);\n    }\n\n    static int winVal(int x, int y) {\n        if (x == y) return 0;\n        return (Math.floorMod(x - y, 3) == 1) ? 1 : -1;\n    }\n\n    static int computeMin(List<int[]> pairs1, List<int[]> pairs2) {\n        int total = 0;\n        Deque<int[]> q1 = new ArrayDeque<>(pairs1);\n        Deque<int[]> q2 = new ArrayDeque<>(pairs2);\n        int[] curA = null, curB = null;\n        while (!q1.isEmpty() || !q2.isEmpty()) {\n            if (curA == null && !q1.isEmpty()) curA = q1.pollFirst();\n            if (curB == null && !q2.isEmpty()) curB = q2.pollFirst();\n            if (curA == null || curB == null) break;\n            int take = Math.min(curA[0], curB[0]);\n            int w = winVal(curA[1], curB[1]);\n            if (w > 0) total += take * w;\n            if (curA[0] <= curB[0]) {\n                if (curA[0] < curB[0]) {\n                    curB[0] -= curA[0];\n                    curA = null;\n                } else {\n                    curA = null;\n                    curB = null;\n                }\n            } else {\n                curA[0] -= curB[0];\n                curB = null;\n            }\n        }\n      