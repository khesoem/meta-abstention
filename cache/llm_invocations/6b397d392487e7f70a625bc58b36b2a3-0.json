':\n                    d1[nx][ny] = d1[x][y] + 1\n                    q.append((nx, ny))\n\n    BFS1(wx, wy)\n\n    # Dinic max flow\n    e = []  # list of edges: [a, b, cap, flow]\n    g = [[] for _ in range(1000)]  # adjacency list of edge indices\n    source = 0\n    sink = 2 * n * n + 1\n\n    def add_edge(a, b, cap):\n        e.append([a, b, cap, 0])\n        e.append([b, a, 0, 0])\n        g[a].append(len(e) - 2)\n        g[b].append(len(e) - 1)\n\n    dist = [-1] * 1000\n    ptr = [0] * 1000\n    q = [0] * 1000\n\n    def bfs():\n        for i in range(len(dist)):\n            dist[i] = -1\n        qh = 0\n        qt = 0\n        q[qt] = source\n        qt += 1\n        dist[source] = 0\n        while qh < qt and dist[sink] == -1:\n            v = q[qh]\n            qh += 1\n            for idx in g[v]:\n                to = e[idx][1]\n                if dist[to] == -1 and e[idx][3] < e[idx][2]:\n                    q[qt] = to\n                    qt += 1\n                    dist[to] = dist[v] + 1\n        return dist[sink] != -1\n\n    def dfs(v, flow):\n        if flow == 0:\n            return 0\n        if v == sink:\n            return flow\n        while ptr[v] < len(g[v]):\n            idx = g[v][ptr[v]]\n            to = e[idx][1]\n            if dist[to] == dist[v] + 1:\n                pushed = dfs(to, min(flow, e[idx][2] - e[idx][3]))\n                if pushed:\n                    e[idx][3] += pushed\n                    e[idx ^ 1][3] -= pushed\n                    return pushed\n            ptr[v] += 1\n        return 0\n\n    def max_flow():\n        flow = 0\n        while bfs():\n            for i in range(len(ptr)):\n                ptr[i] = 0\n            while True:\n                pushed = dfs(source, 10**9)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\n    # d2: distance from each person start\n    d2 = [[10**9]*30 for _ in range(30)]\n    def BFS2(sx, sy):\n        for i in range(30):\n            for j in range(30):\n                d2[i][j] = 10**9\n        q = deque()\n        q.append((sx, sy))\n        d2[sx][sy] = 0\n        while q:\n            x, y = q.popleft()\n            if d2[x][y] >= d1[x][y]:\n                continue\n            for i in range(4):\n                nx = x + dx[i]\n                ny = y + dy[i]\n                if 0 <= nx < n and 0 <= ny < n and d2[nx][ny] >= 10**9 and a[nx][ny] != 'Y' and d2[x][y] + 1 <= d1[nx][ny]:\n                    d2[nx][ny] = d2[x][y] + 1\n                    q.append((nx, ny))\n\n    # Build graph\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Y':\n                continue\n            what = i * n + j + 1\n            what2 = n * n + i * n + j + 1\n            add_edge(source, what, ord(a[i][j]) - ord('0'))\n            add_edge(what2, sink, ord(b[i][j]) - ord('0'))\n            BFS2(i, j)\n            for x in range(n):\n                for y in range(n):\n                    if b[x][y] == 'Y' or d2[x][y] > t:\n                        continue\n                    add_edge(what, n * n + x * n + y + 1, ord(a[i][j]) - ord('0'))\n\n    # Note: original code sets n = 2*n*n+5 after building graph, but we don't need to change n for output\n    print(max_flow())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0728830375228426e-06, -1.1920928244535389e-07, 0.0, -0.00043299360550008714, -0.0017281135078519583, -4.768370445162873e-07, -5.8412379075889476e-06, -0.0008610355434939265, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, -0.001190073206089437, -0.4512951374053955, -0.6599410772323608, -0.1002248078584671, -8.344646857949556e-07, -0.12339288741350174, -7.152555099310121e-07, -3.2066785934148356e-05, 0.0, -0.00021681819634977728, -8.344646857949556e-07, -0.1269301474094391, -0.004092295654118061, -4.768370445162873e-07, -0.1721157431602478, -1.907346813823