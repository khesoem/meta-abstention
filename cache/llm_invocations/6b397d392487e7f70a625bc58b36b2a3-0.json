{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <vector>\n#include <queue>\n#include <string>\n#include <algorithm>\nusing namespace std;\n\nint n, t;\nchar a[30][31], b[30][31];\nint d1[30][30], d2[30][30];\nint dx[] = {0,0,-1,1};\nint dy[] = {1,-1,0,0};\n\nstruct Edge {\n    int a, b, cap, flow;\n};\nvector<Edge> e;\nvector<int> g[1000];\nint source, sink;\nint dist[1000], ptr[1000], q[1000];\n\nvoid add(int a, int b, int cap) {\n    e.push_back({a,b,cap,0});\n    e.push_back({b,a,0,0});\n    g[a].push_back(e.size()-2);\n    g[b].push_back(e.size()-1);\n}\n\nbool ok(int x, int y) { return x>=0 && x<n && y>=0 && y<n; }\n\nvoid BFS1(int sx, int sy) {\n    for (int i=0;i<30;i++) for (int j=0;j<30;j++) d1[i][j]=1e9;\n    queue<pair<int,int>> qq;\n    qq.push({sx,sy});\n    d1[sx][sy]=0;\n    while (!qq.empty()) {\n        int x=qq.front().first, y=qq.front().second; qq.pop();\n        for (int i=0;i<4;i++) {\n            int nx=x+dx[i], ny=y+dy[i];\n            if (ok(nx,ny) && d1[nx][ny]>=1e9 && b[nx][ny]!='Y') {\n                d1[nx][ny]=d1[x][y]+1;\n                qq.push({nx,ny});\n            }\n        }\n    }\n}\n\nbool bfs() {\n    memset(dist,-1,sizeof(dist));\n    int qh=0, qt=0;\n    q[qt++]=source;\n    dist[source]=0;\n    while (qh<qt && dist[sink]==-1) {\n        int v=q[qh++];\n        for (int id : g[v]) {\n            int to=e[id].b;\n            if (dist[to]==-1 && e[id].flow<e[id].cap) {\n                q[qt++]=to;\n                dist[to]=dist[v]+1;\n            }\n        }\n    }\n    return dist[sink]!=-1;\n}\n\nint dfs(int v, int flow) {\n    if (!flow) return 0;\n    if (v==sink) return flow;\n    for (;ptr[v]<(int)g[v].size();ptr[v]++) {\n        int id=g[v][ptr[v]], to=e[id].b;\n        if (dist[to]!=dist[v]+1) continue;\n        int pushed=dfs(to,min(flow,e[id].cap-e[id].flow));\n        if (pushed) {\n            e[id].flow+=pushed;\n            e[id^1].flow-=pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nint max_flow() {\n    int flow=0;\n    while (bfs()) {\n        memset(ptr,0,sizeof(ptr));\n        while (int pushed=dfs(source,1e9)) flow+=pushed;\n    }\n    return flow;\n}\n\nvoid BFS2(int sx, int sy) {\n    for (int i=0;i<30;i++) for (int j=0;j<30;j++) d2[i][j]=1e9;\n    queue<pair<int,int>> qq;\n    qq.push({sx,sy});\n    d2[sx][sy]=0;\n    while (!qq.empty()) {\n        int x=qq.front().first, y=qq.front().second; qq.pop();\n        if (d2[x][y]>=d1[x][y]) continue;\n        for (int i=0;i<4;i++) {\n            int nx=x+dx[i], ny=y+dy[i];\n            if (ok(nx,ny) && d2[nx][ny]>=1e9 && a[nx][ny]!='Y' && d2[x][y]+1<=d1[nx][ny]) {\n                d2[nx][ny]=d2[x][y]+1;\n                qq.push({nx,ny});\n            }\n        }\n    }\n}\n\nint main() {\n    scanf(\"%d%d\",&n,&t);\n    for (int i=0;i<n;i++) scanf(\"%s\",a[i]);\n    int wx, wy;\n    for (int i=0;i<n;i++) {\n        scanf(\"%s\",b[i]);\n        for (int j=0;j<n;j++) {\n            if (b[i][j]=='Z') {\n                b[i][j]=a[i][j]='Y';\n                wx=i; wy=j;\n            }\n        }\n    }\n    BFS1(wx,wy)