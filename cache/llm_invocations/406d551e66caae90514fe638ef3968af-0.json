)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        pq.push({dist[e.to], e.to});\n                    }\n                }\n            }\n            if (dist[t] >= INF) break;\n            for (int v = 0; v < n; ++v) pot[v] += dist[v];\n            ll add = maxf - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                add = min(add, g[prevv[v]][preve[v]].cap);\n            }\n            flow += add;\n            res += add * pot[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= add;\n                g[v][e.rev].cap += add;\n            }\n        }\n        return res;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0); cout.tie(0);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n    MinCostFlow mcf(n * T + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        mcf.add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        mcf.add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                mcf.add_edge(i + (t-1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            int cost = (j+1)*(j+1) - j*j;\n            for (int t = 1; t < T; ++t) {\n                mcf.add_edge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                mcf.add_edge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price = mcf.min_cost_flow(source, sink, k);\n    cout << price << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\n\nclass MinCostFlow:\n    def __init__(self, n):\n        self.n = n\n        self.g = [[] for _ in range(n)]\n        self.pot = [0] * n\n        self.dist = [0] * n\n        self.prevv = [0] * n\n        self.preve = [0] * n\n\n    def add_edge(self, fr, to, cap, cost):\n        # forward edge: [to, rev, cap, cost]\n        self.g[fr].append([to, len(self.g[to]), cap, cost])\n        # backward edge: [from, rev, cap, cost]\n        self.g[to].append([fr, len(self.g[fr]) - 1, 0, -cost])\n\n    def min_cost_flow(self, s, t, maxf):\n        res = 0\n        flow = 0\n        while flow < maxf:\n            self.dist = [INF] * self.n\n            self.dist[s] = 0\n            pq = [(0, s)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if self.dist[v] < d:\n                    continue\n                for i, e in enumerate(self.g[v]):\n                    if e[2] > 0 and self.dist[e[0]] > self.dist[v] + e[3] + self.pot[v] - self.pot[e[0]]:\n                        self.dist[e[0]] = self.dist[v] + e[3] + self.pot[v] - self.pot[e[0]]\n                        self.prevv[e[0]] = v\n                        self.preve[e[0]] = i\n                        heapq.heappush(pq, (self.dist[e[0]], e[0]))\n            if self.dist[t] >= INF:\n                break\n            for v in range(self.n):\n                if self.dist[v] < INF:\n                    self.pot[v] += self.dist[v]\n            add = maxf - flow\n            v = t\n            while v != s:\n                add = min(add, self.g[self.prevv[v]][self.preve[v]][2])\n                v = self.prevv[v]\n            flow += add\n            res += add * self.pot[t]\n  