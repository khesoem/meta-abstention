[float('inf')] * n\n\n    def addEdge(self, s, t, cap, cost):\n        a = {'to': t, 'f': 0, 'cap': cap, 'cost': cost, 'rev': len(self.adj[t])}\n        b = {'to': s, 'f': 0, 'cap': 0, 'cost': -cost, 'rev': len(self.adj[s])}\n        self.adj[s].append(a)\n        self.adj[t].append(b)\n\n    def minCostFlow(self, s, t):\n        flow = 0\n        flowCost = 0\n        q = []\n        heapq.heappush(q, (0, s))\n        while q:\n            d, u = heapq.heappop(q)\n            if d != self.pot[u]:\n                continue\n            for e in self.adj[u]:\n                v = e['to']\n                if e['cap'] <= e['f']:\n                    continue\n                nprio = self.pot[u] + e['cost'] + self.pot[u] - self.pot[v]\n                if self.pot[v] > nprio:\n                    self.pot[v] = nprio\n                    heapq.heappush(q, (nprio, v))\n                    self.prevnode[v] = u\n                    self.prevedge[v] = self.adj[v].index(e)\n                    self.curflow[v] = min(self.curflow[u], e['cap'] - e['f'])\n        if self.pot[t] == float('inf'):\n            return flow, flowCost\n        for i in range(self.n):\n            self.pot[i] += self.pot[i]\n        df = min(self.curflow[t], float('inf') - flow)\n        flow += df\n        flowCost += df * self.pot[t]\n        for v in range(t, s, -1):\n            e = self.adj[self.prevnode[v]][self.prevedge[v]]\n            e['f'] += df\n            self.adj[v][e['rev']]['f'] -= df\n        return flow, flowCost\n\ndef main():\n    n, m, k, c, d = map(int, input().split())\n    nt = MCF(6 + 107 * n)\n    for _ in range(k):\n        x = int(input()) - 1\n        nt.addEdge(0, 1 + x, 1, 0)\n    for _ in range(m):\n        x, y = map(int, input().split())\n        x -= 1\n        y -= 1\n        for i in range(105):\n            for j in range(51):\n                nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1))\n                nt.addEdge(1 + i * n + y, 1 + (i + 1)