           }\n        }\n    }\n}\n\nbool bfs() {\n    memset(dist,-1,sizeof(dist));\n    int qh=0, qt=0;\n    q[qt++]=source;\n    dist[source]=0;\n    while (qh<qt && dist[sink]==-1) {\n        int v=q[qh++];\n        for (int id : g[v]) {\n            int to=e[id].b;\n            if (dist[to]==-1 && e[id].flow<e[id].cap) {\n                q[qt++]=to;\n                dist[to]=dist[v]+1;\n            }\n        }\n    }\n    return dist[sink]!=-1;\n}\n\nint dfs(int v, int flow) {\n    if (!flow) return 0;\n    if (v==sink) return flow;\n    for (;ptr[v]<(int)g[v].size();ptr[v]++) {\n        int id=g[v][ptr[v]], to=e[id].b;\n        if (dist[to]!=dist[v]+1) continue;\n        int pushed=dfs(to,min(flow,e[id].cap-e[id].flow));\n        if (pushed) {\n            e[id].flow+=pushed;\n            e[id^1].flow-=pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nint max_flow() {\n    int flow=0;\n    while (bfs()) {\n        memset(ptr,0,sizeof(ptr));\n        while (int pushed=dfs(source,1e9)) flow+=pushed;\n    }\n    return flow;\n}\n\nvoid BFS2(int sx, int sy) {\n    for (int i=0;i<30;i++) for (int j=0;j<30;j++) d2[i][j]=1e9;\n    queue<pair<int,int>> qq;\n    qq.push({sx,sy});\n    d2[sx][sy]=0;\n    while (!qq.empty()) {\n        int x=qq.front().first, y=qq.front().second; qq.pop();\n        if (d2[x][y]>=d1[x][y]) continue;\n        for (int i=0;i<4;i++) {\n            int nx=x+dx[i], ny=y+dy[i];\n            if (ok(nx,ny) && d2[nx][ny]>=1e9 && a[nx][ny]!='Y' && d2[x][y]+1<=d1[nx][ny]) {\n                d2[nx][ny]=d2[x][y]+1;\n                qq.push({nx,ny});\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin>>n>>t;\n    for (int i=0;i<n;i++) cin>>a[i];\n    int wx, wy;\n    for (int i=0;i<n;i++) {\n        cin>>b[i];\n        for (int j=0;j<n;j++) {\n            if (b[i][j]=='Z') {\n                b[i][j]=a[i][j]='Y';\n                wx=i; wy=j;\n            }\n        }\n    }\n    BFS1(wx,wy);\n    source=0; sink=2*n*n+1;\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<n;j++) {\n            if (a[i][j]=='Y') continue;\n            int what=i*n+j+1;\n            int what2=n*n+i*n+j+1;\n            add_edge(source,what,a[i][j]-'0');\n            add_edge(what2,sink,b[i][j]-'0');\n            BFS2(i,j);\n            for (int x=0;x<n;x++) {\n                for (int y=0;y<n;y++) {\n                    if (b[x][y]=='Y' || d2[x][y]>t) continue;\n                    add_edge(what,n*n+x*n+y+1,a[i][j]-'0');\n                }\n            }\n        }\n    }\n    n=2*n*n+5;\n    cout<<max_flow()<<endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n\n    # find Z and mark it as Y in both grids\n    wx = wy = -1\n    for i in range(n):\n        for j in range(n):\n            if b[i][j] == 'Z':\n                wx, wy = i, j\n                b[i][j] = 'Y'\n                a[i][j] = 'Y'\n                break\n        if wx != -1:\n            break\n\n    # BFS1: distances from Z in grid b (ignoring Y cells)\n    INF = 10**9\n    d1 = [[INF]*30 for _ in range(30)]\n    dx = [0, 0, -1, 1]\n    dy = [1, -1, 0, 0]\n\n    def ok(x, y):\n        return 0 <= x < n and 0 <= y < n\n\n    q = deque()\n    q.append((wx, wy))\n    d1[wx][wy] = 0\n    while q:\n        x, y = q.popleft()\n        for i in range(4):\n            nx, ny = x + dx[i], y + dy[i]\n            if ok(nx, ny) and d1[nx][ny] >= INF and b[nx][ny] != 'Y':\n                d1[nx][ny] = d1[x][y] + 1\n                q.append((nx, ny))\n\n    # Dinic max flow\n    N = 2 * n * n + 2\n    source = 0\n    sink = 2 * n * n + 1\n    graph = [[] for _ in range(N)]\n\n    class Edge:\n        __slots__ = ('to', 'rev', 'cap')\n        def __init__(self, to, rev, cap):\n            self.to = to\n            self.rev = rev\n            self.cap = cap\n\n    def add_edge(u, v, cap):\n        graph[u].append(Edge(v, len(graph[v]), cap))\n        graph[v].append(Edge(u, len(graph[u]) - 1, 0))\n\n    level = [0] * N\n    it_ptr = [0] * N\n\n    def bfs() -> bool:\n        for i in range(N):\n            level[i] = -1\n        q = deque()\n        level[source] = 0\n        q.append(source)\n        while q:\n            v = q.popleft()\n            for e in graph[v]:\n                if level[e.to] == -1 and e.cap > 0:\n                    level[e.to] = level[v] + 1\n                    q.append(e.to)\n        return level[sink] != -1\n\n    def dfs(v, f) -> int:\n        if v == sink:\n            return f\n        for i in range(it_ptr[v], len(graph[v])):\n            e = graph[v][i]\n            if level[e.to] == level[v] + 1 and e.cap > 0:\n                ret = dfs(e.to, min(f, e.cap))\n                if ret:\n                    e.cap -= ret\n                    graph[e.to][e.rev].cap += ret\n                    return ret\n            it_ptr[v] += 1\n        return 0\n\n    def max_flow() -> int:\n        flow = 0\n        while bfs():\n            for i in range(N):\n                it_ptr[i] = 0\n            while True:\n                pushed = dfs(source, INF)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\n    # BFS2 and edge addition\n    d2 = [[INF]*30 for _ in range(30)]\n\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Y':\n                continue\n            what = i * n + j + 1\n            what2 = n * n + i * n + j + 1\n            add_edge(source, what, ord(a[i][j]) - ord('0'))\n            add_edge(what2, sink, ord(b[i][j]) - ord('0'))\n\n            # BFS2 from (i,j)\n            for x in range(30):\n                for y in range(30):\n                    d2[x][y] = INF\n            q = deque()\n            q.append((i, j))\n            d2[i][j] = 0\n            while q:\n                x, y = q.popleft()\n                if d2[x][y] >= d1[x][y]:\n                    continue\n                for k in range(4):\n                    nx, ny = x + dx[k], y + dy[k]\n                    if ok(nx, ny) and d2[nx][ny] >= INF and a[nx][ny] != 'Y' and d2[x][y] + 1 <= d1[nx][ny]:\n                        d2[nx][ny] = d2[x][y] + 1\n                        q.append((nx, ny))\n\n            for x in range(n):\n                for y in range(n):\n                    if b[x][y] == 'Y' or d2[x][y] > t:\n                        continue\n                    add_edge(what, n * n + x * n + y + 1, ord(a[i][j]) - ord('0'))\n\n    print(max_flow())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010215714428341016, 0.0, 0.0, -0.00034898388548754156, -0.0008102948195300996, -1.1920928244535389e-07, -4.291525328881107e-06, -0.00013147920253686607, 0.0, 0.0, -1.4305104514278355e-06, -0.0025107308756560087, -0.025035737082362175, -0.11802057921886444, -0.3869154751300812, -7.390948667307384e-06, -4.5536911784438416e-05, -7.152555099310121e-07, -3.576278118089249e-07, -0.0026223815511912107, -4.768370445162873e-07, -0.0001629458274692297, 0.0, -0.0007214327342808247, -1.1920928244535389e-07, -0.04858914390206337, -3.814689989667386e-06, -2.3841855067985307e-07, -0.16052021086215973, 0.0, 0.0, -0.00033539868309162557, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.3470558769768104e-05, -1.1920928244535389e-07, -0.006043375004082918, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.099436753473128e-06, -1.0728830375228426e-06, -3.814689989667386e-06, -8.940656698541716e-