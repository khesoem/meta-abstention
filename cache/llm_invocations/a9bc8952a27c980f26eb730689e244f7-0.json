eue[v]) {\n                    inQueue[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return dist[t] < INF;\n}\n\nint minCostMaxFlow(int s, int t) {\n    int res = 0;\n    while (spfa(s, t)) {\n        int add = INF;\n        for (int v = t; v != s; v = pre[v]) {\n            add = min(add, cap[preEdge[v]]);\n        }\n        for (int v = t; v != s; v = pre[v]) {\n            int e = preEdge[v];\n            cap[e] -= add;\n            cap[e ^ 1] += add;\n        }\n        res += dist[t] * add;\n    }\n    return res;\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int s = 0, t = n * 100 + 1;\n\n    for (int i = 1; i <= 100; ++i) addEdge(i, t, 100, 0);\n    for (int i = 1; i <= k; ++i) {\n        int v; scanf(\"%d\", &v);\n        addEdge(s, (v - 1) * 100 + 1, 1, 0);\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n        }\n    }\n    for (int i = 1; i <= m; ++i) {\n        int u, v; scanf(\"%d%d\", &u, &v);\n        for (int j = 1; j < 100; ++j) {\n            int idx = (u - 1) * 100 + j;\n            int idy = (v - 1) * 100 + j + 1;\n            for (int p = 1; p <= 20; ++p) {\n                addEdge(idx, idy, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n            }\n            int idx2 = (v - 1) * 100 + j;\n            int idy2 = (u - 1) * 100 + j + 1;\n            for (int p = 1; p <= 20; ++p) {\n                addEdge(idx2, idy2, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n            }\n        }\n    }\n\n    printf(\"%d\\n\", minCostMaxFlow(s, t));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int Z = 100;\n    static final int MAXN = Z * Z + 5;\n    static final int MAXM = Z * Z * Z + 5;\n    static final int INF = 0x3f3f3f3f;\n\n    static int[] head = new int[MAXN];\n    static int[] to = new int[MAXM];\n    static int[] cap = new int[MAXM];\n    static int[] cost = new int[MAXM];\n    static int[] nxt = new int[MAXM];\n    static int[] dist = new int[MAXN];\n    static int[] inQueue = new int[MAXN];\n    static int[] pre = new int[MAXN];\n    static int[] preEdge = new int[MAXN];\n    static int tot;\n\n    static void addEdge(int u, int v, int flow, int c) {\n        to[tot] = v; cost[tot] = c; cap[tot] = flow; nxt[tot] = head[u]; head[u] = tot++;\n        to[tot] = u; cost[tot] = -c; cap[tot] = 0; nxt[tot] = head[v]; head[v] = tot++;\n    }\n\n    static boolean spfa(int s, int t) {\n        Queue<Integer> q = new LinkedList<>();\n        Arrays.fill(dist, INF);\n        Arrays.fill(inQueue, 0);\n        Arrays.fill(pre, -1);\n        dist[s] = 0;\n        q.add(s);\n        inQueue[s] = 1;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = 0;\n            for (int i = head[u]; i != -1; i = nxt[i]) {\n                int v = to[i];\n                if (cap[i] > 0 && dist[v] > dist[u] + cost[i]) {\n                    dist[v] = dist[u] + cost[i];\n                    pre[v] = u;\n                    preEdge[v] = i;\n                    if (inQueue[v] == 0) {\n                        inQueue[v] = 1;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n\n    static int minCostMaxFlow(int s, int t) {\n        int res = 0;\n        while (spfa(s, t)) {\n            int add = INF;\n            for (int v = t; v != s; v = pre[v]) {\n                add = Math.min(add, cap[preEdge[v]]);\n            }\n            for (int v = t; v != s; v = pre[v]) {\n                int e = preEdge[v];\n                cap[e] -= add;\n                cap[e ^ 1] += add;\n            }\n            res += dist[t] * add;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        Arrays.fill(head, -1);\n        tot = 0;\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int s = 0;\n        int t = n * 100 + 1;\n\n        for (int i = 1; i <= 100; ++i) addEdge(i, t, 100, 0);\n        for (int i = 1; i <= k; ++i) {\n            int v = sc.nextInt();\n            addEdge(s, (v - 1) * 100 + 1, 1, 0);\n        }\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j < 100; ++j) {\n                addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n            }\n        }\n        for (int i = 1; i <= m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 1; j < 100; ++j) {\n                int idx = (u - 1) * 100 + j;\n                int idy = (v - 1) * 100 + j + 1;\n                for (int p = 1; p <= 20; ++p) {\n                    addEdge(idx, idy, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n                }\n                int idx2 = (v - 1) * 100 + j;\n                int idy2 = (u - 1) * 100 + j + 1;\n                for (int p = 1; p <= 20; ++p) {\n                    addEdge(idx2, idy2, 1, c + (p * p - (p - 1) * (p - 1)) * d);\n                }\n            }\n        }\n\n        System.out.println(minCostMaxFlow(s, t));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-1.2636104656849056e-05, 0.0, 0.0, -4.1126360883936286e-05, -0.00011705666838679463, 0.0, -1.2993727978027891e-05, -0.06419206410646439, -6.031808152329177e-05, 0.0, -3.45700973412022e-05, -0.001505433232523501, -3.099436753473128e-06, -0.0053219785913825035, -2.3841855067985307e-07, 0.0, -2.622600959512056e-06, 0.0, 0.0, -2.384185506798530