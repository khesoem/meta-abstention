        }\n        return res;\n    }\n\n    static int inv(int x) {\n        return power(x, M - 2);\n    }\n\n    static void prefac(int n) {\n        fac[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fac[i] = mul(fac[i - 1], i);\n        }\n        ifac[n] = inv(fac[n]);\n        for (int i = n - 1; i >= 0; --i) {\n            ifac[i] = mul(ifac[i + 1], i + 1);\n        }\n    }\n\n    static int dp(int s, int c) {\n        if (s == 0) return 1;\n        if (c == k) return 0;\n        int[] resArr = f[s];\n        int res = resArr[c];\n        if (res != -1) return res;\n        res = 0;\n        int hb = 1;\n        while (hb <= s) hb <<= 1;\n        hb >>= 1;\n        for (int t = s; t != -1; --t) {\n            t &= s;\n            if ((t & hb) == 0) {\n                resArr[c] = res;\n                return res;\n            }\n            res = add(res, mul(ifac[t], k - c, dp(s ^ t, c + 1)));\n        }\n        resArr[c] = res;\n        return res;\n    }\n\n    public static void main(String[] args) throws IOException {\n        br = new BufferedReader(new InputStreamReader(System.in));\n        pw = new PrintWriter(new OutputStreamWriter(System.out));\n        \n        for (int i = 0; i < N; i++) {\n            Arrays.fill(f[i], -1);\n        }\n        \n        try {\n            readInts();\n        } catch (Exception e) {\n            return;\n        }\n        \n        prefac(n);\n        \n        if ((n & 1) == 1) {\n            pw.println(power(k, n));\n            pw.flush();\n            return;\n        }\n        \n        int result = sub(power(k, n), mul(fac[n], dp(n, 0)));\n        pw.println(result);\n        pw.flush();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002015625941567123, -4.410734163684538e-06, -2.3841855067985307e-07, -0.0007459718617610633, -2.8490614567999728e-05, -0.023257210850715637, -0.0009421439026482403, -6.556489552167477e-06, -1.5616295058862306e-05, -