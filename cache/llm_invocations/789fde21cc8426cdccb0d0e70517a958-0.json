n\tans += dis[t];\n}\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    int x,y;\n    for(int i = 1; i<=k;i++) { cin >> x;x--;add_edge(s,x,1,0);}\n    for(int i = 1; i<=101;i++) add_edge((i-1)*n,t,k,(i-1)*c);\n    for(int i = 1; i<=m; i++){\n\t\tcin >> x >> y;x--,y--;\n\t\tfor(int i = 1; i<=100; i++) for(int j = 1; j<=k; j++)\n\t\t\tadd_edge(x+(i-1)*n,y+(i-1)*n+n,1,d*((j-1)*2+1)),add_edge(y+(i-1)*n,x+(i-1)*n+n,1,d*((j-1)*2+1));\n \t}\n \tfor(int i = 1; i<=n; i++) for(int j = 1; j<=100; j++) add_edge(i-1+(j-1)*n,i-1+(j-1)*n+n,k,0);\n    for(int i = 1;i<=k;i++) push_rebel();\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    def __init__(self, to, cap, flow, cost):\n        self.to = to\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\ne = []\nhead = [[] for _ in range(15000)]\n\nans = 0\ndis = [float('inf')] * 15000\np = [-1] * 15000\npe = [-1] * 15000\ninq = [0] * 15000\ns = 9998\nt = 9999\ncur = t\n\ndef add_edge(x, y, c, cost):\n    head[x].append(len(e))\n    e.append(Edge(y, c, 0, cost))\n    head[y].append(len(e))\n    e.append(Edge(x, 0, 0, -cost))\n\ndef push_rebel():\n    global ans\n    global cur\n    global dis\n    global p\n    global pe\n    global inq\n    dis = [float('inf')] * 15000\n    p = [-1] * 15000\n    pe = [-1] * 15000\n    inq = [0] * 15000\n    dis[s] = 0\n    q = deque()\n    q.append(s)\n    inq[s] = 1\n    while q:\n        k = q.popleft()\n        inq[k] = 0\n        for x in head[k]:\n            if not e[x].cap - e[x].flow:\n                continue\n            c = e[x].cost\n            y = e[x].to\n            if dis[y] > dis[k] + c:\n                dis[y] = dis[k] + c\n                p[y] = k\n                pe[y] = x\n                if not inq[y]:\n                    