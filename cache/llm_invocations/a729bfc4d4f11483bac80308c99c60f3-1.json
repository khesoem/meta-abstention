(int s, int t){\n    queue<int> q;\n    memset(d, inf, sizeof(d));\n    memset(vis, 0, sizeof(vis));\n    memset(pre, -1, sizeof(pre));\n    d[s] = 0;\n    q.push(s);\n    while(!q.empty()){\n        int u = q.front(); q.pop();\n        vis[u] = 0;\n//        cout << u << \" \" << d[u] << endl;\n        for(int i = head[u]; ~i; i = nt[i]){\n            if(w[i] > 0 && d[to[i]] > d[u] + ct[i]){\n                d[to[i]] = d[u] + ct[i];\n                pre[to[i]] = u;\n                id[to[i]] = i;\n//                if(to[i] == 201) cout << \"Updata \" << u << \" \" << to[i] <<\" \" << d[to[i]] <<endl;\n                if(!vis[to[i]]){\n                    vis[to[i]] = 1;\n                    q.push(to[i]);\n                }\n            }\n        }\n \n    }\n//    cout << d[t] << \"? \"<< endl;\n    return d[t] < inf;\n}\nint MaxFlow(int s, int t){\n    int Mi = inf;\n    int sum = 0;\n    int tt = 0;\n//    cout << s << \" ss \" << t  << endl;\n    while(spfa(s, t)){\n        Mi = inf;\n        for(int i = t; i != s; i = pre[i])\n            Mi = min(Mi, w[id[i]]);\n        for(int i = t; i != s; i = pre[i]){\n            w[id[i]] -= Mi;\n            w[id[i]^1] += Mi;\n        }\n        tt += Mi;\n        sum += d[t] * Mi;\n//        cout << d[t] << endl;\n//        cout << \"asd\" << endl;\n    }\n    return sum;\n}\nint main(){\n    init();\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int s = 0, t = n * 100 + 1;\n    for(int i = 1; i <= 100; ++i)\n        add(i, t, 100, 0);\n    for(int i = 1, v; i <= k; ++i){\n        scanf(\"%d\" , &v);\n        add(s, (v-1)*100+1, 1, 0);\n    }\n    for(int i = 1; i <= n; ++i){\n        for(int j = 1; j < 100; ++j){\n            add((i-1)*100 + j, (i-1)*100 + j + 1, 100, c);\n        }\n    }\n    for(int i = 1, u, v; i <= m; ++i){\n        scanf(\"%d%d\", &u, &v);\n        for(int j = 1; j < 100; ++j){\n            int idx = (u-1) * 100 + j;\n            int idy = (v-1) * 100 + j + 1;\n            for(int k = 1; k <= 50; ++k){\n                add(idx, idy, 1, c + (k * k - (k-1) * (k-1))* d) ;\n            }\n        }\n        for(int j = 1; j < 100; ++j){\n            int idx = (v-1) * 100 + j;\n            int idy = (u-1) * 100 + j + 1;\n            for(int k = 1; k <= 50; ++k){\n                add(idx, idy, 1, c + (k * k - (k-1) * (k-1))* d) ;\n            }\n        }\n    }\n    printf(\"%d\\n\", MaxFlow(s, t));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    sys.setrecursionlimit(1000000)\n    \n    # Constants\n    inf = 0x3f3f3f3f\n    Z = 100\n    N = Z * Z\n    M = Z * Z * Z * 3\n    \n    # Initialize graph structures\n    head = [-1] * N\n    to = [0] * M\n    ct = [0] * M\n    w = [0] * M\n    nt = [0] * M\n    d = [0] * N\n    vis = [0] * N\n    pre = [-1] * N\n    id_map = [0] * N\n    \n    tot = 0\n    \n    def add(u, v, flow, cost):\n        nonlocal tot\n        to[tot] = v\n        ct[tot] = cost\n        w[tot] = flow\n        nt[tot] = head[u]\n        head[u] = tot\n        tot += 1\n        \n        to[tot] = u\n        ct[tot] = -cost\n        w[tot] = 0\n        nt[tot] = head[v]\n        head[v] = tot\n        tot += 1\n    \n    def spfa(s, t):\n        for i in range(N):\n            d[i] = inf\n            vis[i] = 0\n            pre[i] = -1\n        \n        d[s] = 0\n        q = deque()\n        q.append(s)\n        \n        while q:\n            u = q.popleft()\n            vis[u] = 0\n            \n            i = head[u]\n            while i != -1:\n                if w[i] > 0 and d[to[i]] > d[u] + ct[i]:\n                    d[to[i]] = d[u] + ct[i]\n                    pre[to[i]] = u\n                    id_map[to[i]] = i\n                    if not vis[to[i]]:\n                        vis[to[i]] = 1\n                        q.append(to[i])\n                i = nt[i]\n        \n        return d[t] < inf\n    \n    def max_flow(s, t):\n        total_flow = 0\n        total_cost = 0\n        \n        while spfa(s, t):\n            mi = inf\n            i = t\n            while i != s:\n                mi = min(mi, w[id_map[i]])\n                i = pre[i]\n            \n            i = t\n            while i != s:\n                w[id_map[i]] -= mi\n                w[id_map[i] ^ 1] += mi\n                i = pre[i]\n            \n            total_flow += mi\n            total_cost += d[t] * mi\n        \n        return total_cost\n    \n    # Read input\n    data = list(map(int, sys.stdin.readline().split()))\n    n, m, k, c, d_val = data\n    \n    s = 0\n    t = n * 100 + 1\n    \n    # Add edges from nodes 1-100 to sink\n    for i in range(1, 101):\n        add(i, t, 100, 0)\n    \n    # Add edges from source to initial positions\n    for _ in range(k):\n        v = int(sys.stdin.readline())\n        add(s, (v-1)*100+1, 1, 0)\n    \n    # Add edges for same node transitions\n    for i in range(1, n+1):\n        for j in range(1, 100):\n            add((i-1)*100 + j, (i-1)*100 + j + 1, 100, c)\n    \n    # Add edges for m bidirectional roads\n    for _ in range(m):\n        u, v = map(int, sys.stdin.readline().split())\n        for j in range(1, 100):\n            idx = (u-1) * 100 + j\n            idy = (v-1) * 100 + j + 1\n            for k_val in range(1, 51):\n                cost = c + (k_val * k_val - (k_val-1) * (k_val-1)) * d_val\n                add(idx, idy, 1, cost)\n        \n        for j in range(1, 100):\n            idx = (v-1) * 100 + j\n            idy = (u-1) * 100 + j + 1\n            for k_val in range(1, 51):\n                cost = c + (k_val * k_val - (k_val-1) * (k_val-1)) * d_val\n                add(idx, idy, 1, cost)\n    \n    print(max_flow(s, t))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>",