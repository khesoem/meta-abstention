\n\t}\n\tfor(int i=0;i<=18;++i)\n\t\tfor(int j=0;j<=n;++j)\n\t\t\tf[i][j]=-1;\n\tprintf(\"%d\\n\",(ksm(k,n)-solve(0,n)+Mod)%Mod);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef ksm(a, x, Mod):\n    ans = 1\n    w = a % Mod\n    while x:\n        if x & 1:\n            ans = (ans * w) % Mod\n        w = (w * w) % Mod\n        x >>= 1\n    return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    Mod = int(data[2])\n    \n    if n & 1:\n        print(ksm(k, n, Mod))\n        return\n    \n    # Initialize arrays\n    fac = [0] * (n + 1)\n    dfac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    \n    fac[0] = dfac[0] = fac[1] = dfac[1] = inv[1] = 1\n    for i in range(2, n + 1):\n        fac[i] = (fac[i-1] * i) % Mod\n        inv[i] = ((Mod - Mod // i) * inv[Mod % i]) % Mod\n        dfac[i] = (dfac[i-1] * inv[i]) % Mod\n    \n    # Initialize memoization table f[use][S]\n    # We use a dictionary for memoization instead of a 2D array\n    memo = {}\n    \n    def solve(use, S):\n        if (use, S) in memo:\n            return memo[(use, S)]\n        \n        ret = 0\n        if S == 0:\n            ret = fac[n]\n            for i in range(1, use + 1):\n                ret = (ret * (k - i + 1)) % Mod\n            memo[(use, S)] = ret\n            return ret\n        \n        if use > k:\n            memo[(use, S)] = 0\n            return 0\n        \n        lbit = S & (-S)\n        U = S - lbit\n        \n        T = U\n        while True:\n            # S - T = lbit + (U - T)\n            # We need dfac[S - T] * solve(use + 1, T)\n            ret = (dfac[S - T] * solve(use + 1, T) + ret) % Mod\n            if T == 0:\n                break\n            T = (T - 1) & U\n        \n        memo[(use, S)] = ret\n        return ret\n   