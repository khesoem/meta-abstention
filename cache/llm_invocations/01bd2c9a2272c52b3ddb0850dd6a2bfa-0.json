    }\n\n    long long getMass(long long mass) {\n        int logBase = logBaseWeight(mass);\n        // Compute sumTotal = (weight^(logBase+1) - 1) / (weight - 1) using unsigned long long\n        unsigned long long power = powULL(weight, logBase + 1);\n        unsigned long long sumTotal = (power - 1) / (weight - 1);\n        long long result;\n        if (mass > (long long)sumTotal && !arr[logBase + 1]) {\n            result = doubleToInt(pow(weight, logBase + 1));\n            arr[logBase + 1] = true;\n        } else if (mass <= (long long)sumTotal && !arr[logBase]) {\n            result = doubleToInt(pow(weight, logBase));\n            arr[logBase] = true;\n        } else {\n            result = 0;\n        }\n        return result;\n    }\n\n    bool isBalanced() {\n        long long left = itemMass;\n        long long right = 0;\n        while (true) {\n            if (left > right) {\n                long long piece = getMass(left - right);\n                if (piece == 0) return false;\n                right += piece;\n            } else if (left < right) {\n                long long piece = getMass(right - left);\n                if (piece == 0) return false;\n                left += piece;\n            } else {\n                return true;\n            }\n        }\n    }\n};\n\nint Main::weight = 0;\nint Main::itemMass = 0;\nbool Main::arr[100] = {false};\n\nint main() {\n    cin >> Main::weight >> Main::itemMass;\n    Main wb;\n    cout << (wb.isBalanced() ? \"YES\" : \"NO\") << endl;\n    return 0;\n}\n```", "token_logprobs": [-0.010019956156611443, -0.5153078436851501, -0.0001591317413840443, -0.00017998983094003052, -9.417489309271332e-06, -4.768370445162873e-07, -2.7418097943154862e-06, -5.149708886165172e-05, 0.0, 0.0, -0.0001045410826918669, -5.173549288883805e-05, 0.0, 0.0, -0.008669713512063026, 0.0, 0.0, -0.014198355376720428, -0.00020346954988781363, 0.0, -0.0009253510506823659, -0.0007870675181038678, -2.3841830625315197e-06, -0.100293606519