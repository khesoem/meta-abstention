{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <cmath>\n\nusing namespace std;\n\nint find_gcd(int x, int y)\n{\n    int gcd = (x > y) ? x : y;\n    while (true)\n    {\n        if (x % gcd == 0 && y % gcd == 0)\n            break;\n        gcd--;\n    }\n    return gcd;\n}\n\nvoid diff(double x, double y, double a, double b, double &num, double &den)\n{\n    num = fabs(x * b - y * a);\n    den = y * b;\n}\n\nvoid reduce_fraction(int &num, int &den)\n{\n    int g = find_gcd(num, den);\n    if (g != 1)\n    {\n        num = num / g;\n        den = den / g;\n    }\n}\n\nint main()\n{\n    double x, y, n, a, b;\n    double best = 1000000.0;\n    int best_num = 0;\n    int best_den = 0;\n\n    cin >> x >> y >> n;\n\n    if (n > y)\n    {\n        int g = find_gcd((int)x, (int)y);\n        if (g != 1)\n        {\n            x = x / g;\n            y = y / g;\n        }\n        cout << x << \"/\" << y << endl;\n        return 0;\n    }\n\n    for (b = n; b >= 1.0; b -= 1.0)\n    {\n        a = (x * b) / y;\n\n        if (floor(a) == a)\n        {\n            best_num = (int)a;\n            best_den = (int)b;\n            break;\n        }\n        else\n        {\n            double temp_num, temp_den, temp;\n\n            diff(x, y, floor(a), b, temp_num, temp_den);\n            temp = temp_num / temp_den;\n\n            if (temp < best)\n            {\n                best_num = (int)floor(a);\n                best_den = (int)b;\n                best = temp;\n            }\n            else if (temp == best)\n            {\n                if (floor(a) < best_num)\n                {\n                    best_num = (int)floor(a);\n                    best_den = (int)b;\n                }\n            }\n\n            diff(x, y, ceil(a), b, temp_num, temp_den);\n            temp = temp_num / temp_den;\n\n            if (temp < best)\n            {\n                best_num = (int)ceil(a);\n                best_den = (int)b;\n                best = temp;\n            }\n            else if (temp == best)\n            {\n                if (ceil(a) < best_num)\n                {\n                    best_num = (int)ceil(a);\n                    best_den = (int)b;\n                }\n            }\n        }\n    }\n\n    reduce_fraction(best_num, best_den);\n    cout << best_num << \"/\" << best_den << endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef find_gcd(x, y):\n    # Using math.gcd for efficiency; functionally equivalent to the original loop\n    return math.gcd(x, y)\n\ndef diff(x, y, a, b):\n    num = abs(x * b - y * a)\n    den = y * b\n    return num, den\n\ndef reduce_fraction(num, den):\n    g = find_gcd(num, den)\n    if g != 1:\n        num //= g\n        den //= g\n    return num, den\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x = float(data[0])\n    y = float(data[1])\n    n = float(data[2])\n\n    best = 1000000.0\n    best_num = 0\n    best_den = 0\n\n    if n > y:\n        g = find_gcd(int(x), int(y))\n        if g != 1:\n            x = x / g\n            y = y / g\n        print(f\"{int(x)}/{int(y)}\")\n        return\n\n    for b in range(int(n), 0, -1):\n        a = (x * b) / y\n        if math.floor(a) == a:\n            best_num = int(a)\n            best_den = b\n            break\n        else:\n            # floor candidate\n            floor_a = math.floor(a)\n            temp_num, temp_den = diff(x, y, floor_a, b)\n            temp = temp_num / temp_den\n            if temp < best:\n                best_num = floor_a\n                best_den = b\n                best = temp\n            elif temp == best:\n                if floor_a < best_num:\n                    best_num = floor_a\n                    best_den = b\n\n            # ceil candidate\n            ceil_a = math.ceil(a)\n            temp_num, temp_den = diff(x, y, ceil_a, b)\n            temp = temp_num / temp_den\n            if temp < best:\n                best_num = ceil_a\n                best_den = b\n                best = temp\n            elif temp == best:\n                if ceil_a < best_num:\n                    best_num = ceil_a\n                    best_den = b\n\n    best_num, best_den = reduce_fraction(best_num, best_den)\n    print(f\"{best_num}/{best_den}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.576278118089249e-07, 0.0, 0.0, -0.00020716428116429597, -1.4305012882687151e-05, -0.2014133334159851, -0.0005646541831083596, -6.198863957251888e-06, 0.0, -4.589452510117553e-05, -5.876845170860179e-05, -0.031023165211081505, -1.1920928244535389e-07, 0.0, -3.290122185717337e-05, -0.02975955791771412, 0.0, -5.566918844124302e-05, -9.536738616588991e-07, -0.05605011433362961, -0.8216624855995178, -0.3290797770023346, -2.3841855067985307e-07, 0.0, -0.04314675182104111, -0.2549346387386322, -0.4986216425895691, -0.597060263156