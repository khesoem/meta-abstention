\n    def _dinic_bfs(self, s, t):\n        self.vis = [0] * self.n\n        q = deque([s])\n        self.vis[s] = 1\n        while q:\n            u = q.popleft()\n            for e in self.g[u]:\n                v, rev, cap, w = e\n                if self.vis[v] or cap == 0:\n                    continue\n                if self.dis[v] != self.dis[u] + w - self.pot[v] + self.pot[u]:\n                    continue\n                self.vis[v] = self.vis[u] + 1\n                q.append(v)\n        return self.vis[t] != 0\n\n    def _dinic_dfs(self, u, t, f):\n        if u == t:\n            return f\n        sf = 0\n        i = self.cur[u]\n        while i < len(self.g[u]):\n            e = self.g[u][i]\n            v, rev, cap, w = e\n            if cap and self.vis[v] == self.vis[u] + 1:\n                if self.dis[v] == self.dis[u] + w - self.pot[v] + self.pot[u]:\n                    df = self._dinic_dfs(v, t, min(cap, f))\n                    if df:\n                        sf += df\n                        f -= df\n                        e[2] -= df\n                        self.g[v][rev][2] += df\n                        if f == 0:\n                            break\n            i += 1\n            self.cur[u] = i\n        return sf\n\n    def mincostflow(self, s, t, maxf):\n        flow = 0\n        cost = 0\n        self.pot = [0] * self.n\n        while self._dijkstra(s, t):\n            f = 0\n            while self._dinic_bfs(s, t):\n                self.cur = [0] * self.n\n                df = self._dinic_dfs(s, t, maxf)\n                maxf -= df\n                f += df\n                if maxf == 0:\n                    break\n            flow += f\n            cost += (self.dis[t] + self.pot[t]) * f\n            for i in range(self.n):\n                self.pot[i] += self.dis[i]\n            if maxf == 0:\n                break\n        return flow, cost\n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    l = max(n, k) * 2\n\n    mcmf = MCMF()\n    mcmf.addv(l * n)\n    s = mcmf.addv(1)\n    t = mcmf.addv(1)\n\n    for _ in range(k):\n        a = int(next(it)) - 1\n        mcmf.adde(s, a, 1, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for i in range(l - 1):\n            u1 = u + i * n\n            v1 = v + (i + 1) * n\n            u2 = u + (i + 1) * n\n            v2 = v + i * n\n            for j in range(k):\n                cost_edge = c + d * (2 * j + 1)\n                mcmf.adde(u1, v1, 1, cost_edge)\n                mcmf.adde(v2, u2, 1, cost_edge)\n\n    for i in range(l - 1):\n        for j in range(n):\n            u = j + i * n\n            v = j + (i + 1) * n\n            mcmf.adde(u, v, INF, c)\n\n    for i in range(l):\n        mcmf.adde(i * n, t, INF, 0)\n\n    flow, cost = mcmf.mincostflow(s, t, INF)\n    print(cost)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00023338454775512218, 0.0, -1.9073468138230965e-06, -0.00013648532330989838, -0.0015195977175608277, -2.1576648578047752e-05, -0.00021050144277978688, -0.07895749807357788, -0.0005590544897131622, -0.0007207180024124682, -0.0025095418095588684, -2.3841830625315197e-06, -4.768370445162873e-07, -5.960462772236497e-07, -0.0015112657565623522, -0.00024351492174901068, -9.179073458653875e-06, -2.264974000354414e-06, -2.622600959512056e-06, -0.07888996601104736, -0.0001778444420779124, -0.01188542228192091, -1.8596476365928538e-05, -0.00017510310863144696, -4.732496745418757e-05, -1.1920928244535389e-07, -1.0728830375228426e-06, -4.768370445162873e-07, -3.814624506048858e-05, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.06197063997387886, 0.0, -2.264974000354414e-06, -0.25600671768188477, -1.1920928244535389e-07, 0.0, -