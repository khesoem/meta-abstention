t i = 0; i < p; i++) {\n            if (f.get((k * i) % p) != (k * f.get(i)) % p) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    static long gen(ArrayList<Integer> f, int p, int k, int i) {\n        if (i == p) {\n            return isGood(f, p, k) ? 1 : 0;\n        } else {\n            long ans = 0;\n            for (int j = 0; j < p; j++) {\n                f.add(j);\n                ans += gen(f, p, k, i + 1);\n                f.remove(f.size() - 1);\n            }\n            return ans;\n        }\n    }\n\n    static long modPow(long base, long exp, long mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    static long solve(int p, int k) {\n        int num = 0;\n        Set<Integer> used = new HashSet<>();\n        for (int j = 0; j < p; j++) {\n            if (!used.contains(j)) {\n                num++;\n            }\n            int i = j;\n            while (!used.contains(i)) {\n                used.add(i);\n                i = (i * k) % p;\n            }\n        }\n        long exponent = num - (k != 1 ? 1 : 0);\n        return modPow(p, exponent, MOD);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n        // System.out.println(gen(new ArrayList<>(), p, k, 0));\n        System.out.println(solve(p, k));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, 0.0, 0.0, -1.7762025890988298e-05, -6.794906312279636e-06, 0.0, -5.876845170860179e-05, -0.007002928759902716, -3.6000557884108275e-05, 0.0, -7.271740287251305e-06, -0.008616766892373562, -0.0005544078885577619, -0.1932161