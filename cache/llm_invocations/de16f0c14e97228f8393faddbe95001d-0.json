='9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        if (t<m) for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static Map<Integer, Integer>[] edge = new HashMap[7000];\n    static char[][] buf = new char[20][20];\n    static int n, m, vn, from[], flow[], tox[][];\n\n    static {\n        for (int i = 0; i < 7000; i++) {\n            edge[i] = new HashMap<>();\n        }\n    }\n\n    static int aug(int s, int t, int cap) {\n        int result = 0;\n        for (int aug = 1; aug != 0; ) {\n            from = new int[vn];\n            Arrays.fill(from, -1);\n            from[s] = s;\n            flow = new int[vn];\n            flow[s] = cap;\n            Queue<Integer> bfs = new LinkedList<>();\n            bfs.offer(s);\n            while (!bfs.isEmpty()) {\n                int x = bfs.poll();\n                if (x == t) {\n                    for (int x2 = x; x2 != s; x2 = from[x2]) {\n                        int f = flow[t];\n                        edge[from[x2]].put(x2, edge[from[x2]].get(x2) - f);\n                        edge[x2].put(from[x2], edge[x2].getOrDefault(from[x2], 0) + f);\n                        result += f;\n                    }\n                    break;\n                }\n                for (Map.Entry<Integer, Integer> e : edge[x].entrySet()) {\n                    int y = e.getKey();\n                    int capEdge = e.getValue();\n                    if (capEdge >= cap && from[y] == -1) {\n                        from[y] = x;\n                        flow[y] = Math.min(capEdge, flow[x]);\n                        bfs.offer(y);\n                    }\n                }\n            }\n            aug--;\n        }\n        return result;\n    }\n\n    static int enc(int x, int y, int t) {\n        return x + y * n + t * n * n + 2;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n\n        int res = 0;\n        for (int i = 0; i < n; i++) {\n            String line = br.readLine();\n            buf[i] = line.toCharArray();\n        }\n\n        for (int i = 0; i < n; i++) {\n            String line = br.readLine();\n            buf[i] = line.toCharArray();\n        }\n\n        for (int i = 0; i < 7000; i++) {\n            edge[i] = new HashMap<>();\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                    edge[0].put(enc(i, j, 0), buf[i][j] - '0');\n                }\n            }\n        }\n\n        int[] dx = {-1, 0, 1, 0};\n        int[] dy = {0, -1, 0, 1};\n\n        Queue<int[]> bfsQueue = new LinkedList<>();\n        tox = new int[n][n];\n        for (int[] row : tox) {\n            Arrays.fill(row, m + 1);\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (buf[i][j] == 'Z') {\n                    tox[i][j] = 0;\n                    bfsQueue.offer(new int[]{i, j});\n                }\n            }\n        }\n\n        while (!bfsQueue.isEmpty()) {\n            int[] cell = bfsQueue.poll();\n            int x = cell[0], y = cell[1];\n            int t = tox[x][y];\n            for (int dir = 0; dir < 4; dir++) {\n                int nx = x + dx[dir];\n                int ny = y + dy[dir];\n                if (nx >= 0 && ny >= 0 && nx < n && ny < n && buf[nx][ny] != 'Y' && t + 1 < tox[nx][ny]) {\n                    tox[nx][ny] = t + 1;\n                    bfsQueue.offer(new int[]{nx, ny});\n                }\n            }\n        }\n\n        vn = enc(n - 1, n - 1, m) + 1;\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                for (int t = 0; t < m; t++) {\n                    for (int q = 0; q < 4; q++) {\n                        int x = i + dx[q];\n                        int y = j + dy[q];\n                        if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y') {\n                            int t2 = t + 1;\n                            int tLimit = tox[x][y] + (buf[x][y] > '0' && buf[x][y] <= '9' ? 1 : 0);\n                            if (t2 < tLimit && t < tox[i][j]) {\n                                edge[enc(i, j, t)].put(enc(x, y, t2), 1000);\n                            }\n                        }\n                    }\n                    if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                        edge[enc(i, j, t)].put(enc(i, j, m), buf[i][j] - '0');\n                    }\n                }\n                if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                    edge[enc(i, j, m)].put(1, buf[i][j] - '0');\n                }\n            }\n        }\n\n        for (int u = 8; u > 0; u /= 2) {\n            res += aug(0, 1, u);\n        }\n\n        System.out.println(res);\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.3535878658294678, -0.0008638188010081649, -3.173704271830502e-06, -6.873571692267433e-05, -5.512236498361744e-07, -1.9361264946837764e-07, -0.012510471045970917, -0.6328750848770142, -0.47613397240638733, -6.718606891809031e-05, -0.000920869642868638, -0.00025680975522845984, -0.0001415618316968903, -3.128163257315464e-07, -0.4353976547718048, -0.05493205040693283, -0.0063804448582232, -0.0004350797680672258, -0.606072723865509, -1.0280383548888494e-06, -0.014169150963425636, -0.0008335703751072288, -0.00091217877343297, -0.001189510803669691, -0.03815830498933792, -7.779520092299208e-05, -0.002491706982254982, -1.9361264946837764e-07, -6.704273118884885e-07, 0.0, -0.00014096579980105162, -0.00028624574770219624, -1.981667537620524e-06, -3.531315314830863e-06, -0.026036787778139114, -4.008129963040119e-06, -6.704273118884885e-07, -0.0008172504603862762, -1.5048530030981055e-06, -2.5822400857578032e-05, -7.896309739408025e-07, -3.128163257315464e-07, 0.0, -1.5048530030981055e-06, -0.0002319071936653927, -1.2113979209971149e-05, -7.896309739408025e-07, -1.9385402993066236e-05, -0.002362325321882963, -0.002201644005253911, 0.0, -0.0005547016044147313, -4.036524842376821e-05, -0.25197774171829224, -0.007609704975038767, -0.52899169921875, -1.723973582556937e-05, -0.014256240800023079, -0.0001414426224073395, -0.2521662712097168, -0.4885982573032379, 