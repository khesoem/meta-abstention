).add(new Edge(u, g.get(u).size() - 1, 0, 0, -cost_val));\n        }\n\n        Pair<Long, Long> min_cost_flow(int s, int t) {\n            long total_flow = 0;\n            long total_cost = 0;\n\n            while (true) {\n                heap.add(new Pair(0, s));\n                Arrays.fill(d, INF_FLOW);\n                d[s] = 0;\n                cap[s] = INF_FLOW;\n\n                while (!heap.isEmpty()) {\n                    Pair top = heap.poll();\n                    long dist = top.cost;\n                    int u = top.node;\n\n                    if (dist != d[u]) continue;\n\n                    for (int i = 0; i < g.get(u).size(); ++i) {\n                        Edge e = g.get(u).get(i);\n                        int v = e.to;\n\n                        if (e.c <= e.f) continue;\n\n                        long nd = d[u] + e.w + pi[u] - pi[v];\n                        if (d[v] > nd) {\n                            d[v] = nd;\n                            heap.add(new Pair(nd, v));\n                            pv[v] = u;\n                            pe[v] = i;\n                            cap[v] = Math.min(cap[u], e.c - e.f);\n                        }\n                    }\n                }\n\n                if (d[t] == INF_FLOW) break;\n\n                for (int i = 0; i < num_nodes; ++i)\n                    pi[i] += d[i];\n\n                long df = Math.min(cap[t], INF_FLOW - total_flow);\n                total_flow += df;\n\n                for (int v = t; v != s; v = pv[v]) {\n                    Edge e = g.get(pv[v]).get(pe[v]);\n                    e.f += df;\n                    g.get(v).get(e.rev).f -= df;\n                    total_cost += df * e.w;\n                }\n            }\n\n            return new Pair<>(total_flow, total_cost);\n        }\n    }\n\n    static class Pair<T1, T2> {\n        T1 first;\n        T2 second;\n\n        Pair(T1 first, T2 second) {\n            this.first = first;\n            this.second = second;\n        }\n\n        Pair(long cost, int node) {\n            this.cost = cost;\n            this.node = node;\n        }\n\n        long cost;\n        int node;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        final int T = 500;\n        int N = n * T;\n        MinCostFlowSolver solver = new MinCostFlowSolver(N + 2);\n\n        for (int i = 0; i < n; ++i)\n            for (int j = 0; j < T - 1; ++j)\n                solver.add_edge(i * T + j, i * T + j + 1, INF_FLOW, c);\n\n        for (int j = 0; j < T; ++j)\n            solver.add_edge(j, N + 1, INF_FLOW, 0);\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            --x;\n            solver.add_edge(N, x * T, 1, 0);\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x; --y;\n\n            for (int j = 0; j < T - 1; ++j) {\n                long mult = 1;\n                for (int p = 0; p < k; ++p) {\n                    solver.add_edge(x * T + j, y * T + j + 1, 1, mult * d + c);\n                    solver.add_edge(y * T + j, x * T + j + 1, 1, mult * d + c);\n                    mult += 2;\n                }\n            }\n        }\n\n        Pair<Long, Long> result = solver.min_cost_flow(N, N + 1);\n        assert result.first == k;\n        System.out.println(result.second);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002818902430590242, -2.861018856492592e-06, -1.1920922133867862e-06, -0.01654253527522087, -3.981510963058099e-05, -0.5231368541717529, -0.17986923456192017, -0.0004343043256085366, -5.960462772236497e-07, -0.0017585780005902052, -0.005929143168032169, -0.00016032364510465413, -0.0014386551920324564, -0.3915989