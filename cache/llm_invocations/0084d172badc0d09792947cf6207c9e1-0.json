ab is 6x6, 0-indexed\n    tab = [[0]*6 for _ in range(6)]\n    for i in range(n):\n        for j in range(n):\n            tab[i][j] = int(next(it))\n    for i in range(n, 6):\n        tab[i][i] = 100\n\n    # precompute triple to bit mapping (20 bits)\n    triple_to_bit = [-1] * (1<<6)\n    bit_idx = 0\n    for i in range(6):\n        for j in range(i+1, 6):\n            for k in range(j+1, 6):\n                mask = (1<<i) | (1<<j) | (1<<k)\n                triple_to_bit[mask] = bit_idx\n                bit_idx += 1\n\n    # all 36 directed edges (from, to) 0-indexed\n    kraw = [(i, j) for i in range(6) for j in range(6)]\n\n    # permutations of [0,1,2] (since original used 1,2,3)\n    perms = [[0,1,2], [0,2,1], [1,0,2], [1,2,0], [2,0,1], [2,1,0]]\n\n    odw = mod_pow(100, MOD-2)\n\n    # dp[0] and dp[1] as lists of length (1<<20)\n    size = 1<<20\n    dp0 = [0]*size\n    dp1 = [0]*size\n\n    # elo matrix 6x6, will be reused\n    elo = [[0]*6 for _ in range(6)]\n\n    # process k=0 and k=1\n    for k in range(2):\n        dp_cur = dp0 if k == 0 else dp1\n        offset = k * 18\n        for mask in range(1<<18):\n            p = 1\n            # set edges for this half\n            for j in range(18):\n                edge_idx = offset + j\n                fr, to = kraw[edge_idx]\n                if (mask >> j) & 1:\n                    p = p * tab[fr][to] % MOD * odw % MOD\n                    elo[to][fr] = 1\n                else:\n                    p = p * (100 - tab[fr][to]) % MOD * odw % MOD\n                    elo[to][fr] = 0\n            # compute cur mask using daj\n            cur_mask = 0\n            for perm in perms:\n                t0 = perm[0] + k*3\n                t1 = perm[1] + k*3\n                t2 = perm[2] + k*3\n                for i in range(6):\n                    for j in range(i+1, 6):\n                        for kk in range(j+1, 6):\n                            if elo[t0][i] and elo[t1][j] and elo[t2][kk]:\n                 