fsDeath(x, y):\n    global dist\n    for i in range(n):\n        for j in range(n):\n            dist[i][j] = INF\n    qx = deque()\n    qy = deque()\n    dist[x][y] = 0\n    qx.append(x)\n    qy.append(y)\n    while qx:\n        curx = qx.popleft()\n        cury = qy.popleft()\n        for k in range(4):\n            tx = curx + dx[k]\n            ty = cury + dy[k]\n            if ok(tx, ty) and dist[tx][ty] == INF:\n                dist[tx][ty] = dist[curx][cury] + 1\n                qx.append(tx)\n                qy.append(ty)\n\ndef runBFS(x, y):\n    global used\n    for i in range(n):\n        for j in range(n):\n            used[i][j] = False\n    qx = deque()\n    qy = deque()\n    qlev = deque()\n    used[x][y] = True\n    qx.append(x)\n    qy.append(y)\n    qlev.append(0)\n    while qx:\n        curx = qx.popleft()\n        cury = qy.popleft()\n        curlev = qlev.popleft()\n        if b[curx][cury].isdigit() and b[curx][cury] != '0':\n            maxFlow.addEdge(x * n + y, sqr(n) + 1 + curx * n + cury, INF)\n        if curlev >= t:\n            continue\n        for k in range(4):\n            tx = curx + dx[k]\n            ty = cury + dy[k]\n            if ok(tx, ty) and not used[tx][ty]:\n                if dist[tx][ty] > curlev + 1:\n                    qx.append(tx)\n                    qy.append(ty)\n                    qlev.append(curlev + 1)\n                elif dist[tx][ty] > curlev and b[tx][ty].isdigit() and b[tx][ty] != '0':\n                    maxFlow.addEdge(x * n + y, sqr(n) + 1 + tx * n + ty, INF)\n                used[tx][ty] = True\n\ndef build():\n    posi = -1\n    posj = -1\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                posi = i\n                posj = j\n                break\n        if posi != -1:\n            break\n    bfsDeath(posi, posj)\n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit() and a[i][j] != '0':\n                maxFlow.addEdge(S, i * n + j, ord(a[i][j]) - ord('0'))\n    for i in range(n):\n        for j in range(n):\n            if b[i][j].isdigit() and b[i][j] != '0':\n                maxFlow.addEdge(i * n + j + sqr(n) + 1, T, ord(b[i][j]) - ord('0'))\n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit() and a[i][j] != '0':\n                runBFS(i, j)\n\ndef main():\n    global n, t, a, b\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].strip()\n    while first == '':\n        data.pop(0)\n        first = data[0].strip()\n    n, t = map(int, first.split())\n    idx = 1\n    # skip empty lines\n    while idx < len(data) and data[idx].strip() == '':\n        idx += 1\n    for i in range(n):\n        a[i] = list(data[idx].strip())\n        idx += 1\n    while idx < len(data) and data[idx].strip() == '':\n        idx += 1\n    for i in range(n):\n        b[i] = list(data[idx].strip())\n        idx += 1\n    build()\n    print(maxFlow.getMaxFlow(S, T))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -3.576278118089249e-07, -0.00020680672605521977, -0.16112707555294037, -0.00012516192509792745, -2.1576648578047752e-05, -3.576214658096433e-05, -2.145764938177308e-06, 0.0, -3.576278118089249e-07, -0.00319446949288249, -0.6321160197257996, -0.005174814257770777, -0.002392645925283432, -0.017616938799619675, -3.576278118089249e-07, 0.0, -2.0265558760002023e-06, -8.344646857949556e-07, -2.145764938177308e-06, -1.4305104514278355e-06, -8.344646857949556e-07, -6.925819616299123e-05, -1.1920928244535389e-07, -8.189342770492658e-05, -2.455681169521995e-05, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -2.1815061700181104e-05, -0.10252036899328232, -2.7656173188006505e-05, -1.1920928244535389e-07, -3.4570634852570947e-06, -7.30726242181845e-05, -0.07889007776975632, -1.1920928244535389e-07, -0.0004318020073