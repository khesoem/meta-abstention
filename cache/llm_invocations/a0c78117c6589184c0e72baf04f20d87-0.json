{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cstring>\n#include <ctime>\n#include <cassert>\n#include <cmath>\n\nusing namespace std;\n\nusing i64 = long long;\nusing u64 = unsigned long long;\nusing f64 = long double;\nusing vi = vector<int>;\nusing vvi = vector<vi>;\n\n#define loop(i, a, b) for (int i = (a); i < (b); ++i)\n#define rloop(i, a, b) for (int i = (b) - 1; i >= (a); --i)\n#define len(c) ((int)(c).size())\n#define mkp make_pair\n#define eb emplace_back\n\nvoid solve(int n) {\n    int k;\n    cin >> k;\n\n    using T = double;\n    vector<T> p(n);\n    for (int i = 0; i < n; ++i)\n        cin >> p[i];\n\n    T dp[2][1 << n];\n    memset(dp, 0, sizeof(dp));\n\n    vector<char> ok(n, 0);\n    vi goods;\n    loop(i, 0, n) {\n        if (p[i] != 0) {\n            ok[i] = 1;\n            goods.eb(i);\n        }\n    }\n\n    dp[0][0] = 1.0;\n    int cur = 1;\n\n    vector<T> s(1 << n, 0.0);\n    s[0] = 1.0;\n    loop(mask, 1, 1 << n) {\n        int bit = __builtin_ctz(mask);\n        s[mask] = s[mask ^ (1 << bit)] - p[bit];\n    }\n\n    int m = min(len(goods), k);\n    loop(step, 0, m) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int idx : goods) {\n                if (mask & (1 << idx)) continue;\n                dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / s[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    loop(i, 0, n) {\n        if (!ok[i]) {\n            printf(\"%.12f\\n\", 0.0);\n        } else {\n            T res = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    res += dp[cur][mask];\n            }\n            printf(\"%.12f\\n\", (double)res);\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport time\n\ndef solve(n):\n    k = int(sys.stdin.readline().strip())\n    \n    p = list(map(float, sys.stdin.readline().strip().split()))\n    \n    dp = [[0.0] * (1 << n) for _ in range(2)]\n    \n    ok = [0] * n\n    goods = []\n    for i in range(n):\n        if p[i] != 0:\n            ok[i] = 1\n            goods.append(i)\n    \n    dp[0][0] = 1.0\n    cur = 1\n    \n    s = [0.0] * (1 << n)\n    s[0] = 1.0\n    for mask in range(1, 1 << n):\n        bit = (mask & -mask).bit_length() - 1\n        s[mask] = s[mask ^ (1 << bit)] - p[bit]\n    \n    m = min(len(goods), k)\n    for step in range(m):\n        dp[cur] = [0.0] * (1 << n)\n        \n  