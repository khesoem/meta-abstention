, b1)\n    \n    max_achieved = 0\n    for perm in itertools.permutations([1, 2, 3, 4, 5, 6]):\n        ra1, ra2, ra3 = a1, a2, a3\n        rb1, rb2, rb3 = b1, b2, b3\n        matched = 0\n        \n        for p in perm:\n            if p == 1:\n                t = min(ra1, rb1)\n                ra1 -= t\n                rb1 -= t\n                matched += t\n            elif p == 2:\n                t = min(ra1, rb3)\n                ra1 -= t\n                rb3 -= t\n                matched += t\n            elif p == 3:\n                t = min(ra2, rb2)\n                ra2 -= t\n                rb2 -= t\n                matched += t\n            elif p == 4:\n                t = min(ra2, rb1)\n                ra2 -= t\n                rb1 -= t\n                matched += t\n            elif p == 5:\n                t = min(ra3, rb3)\n                ra3 -= t\n                rb3 -= t\n                matched += t\n            elif p == 6:\n                t = min(ra3, rb2)\n                ra3 -= t\n                rb2 -= t\n                matched += t\n        \n        max_achieved = max(max_achieved, matched)\n    \n    print(f\"{n - max_achieved} {theoretical_limit}\")\n\ndef driver():\n    try:\n        t = 1\n        for _ in range(t):\n            main_logic()\n    finally:\n        input_handle.close()\n        output_handle.close()\n        sys.stdout = orig_stdout\n\nif __name__ == \"__main__\":\n    driver()\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    private static BufferedReader input;\n    private static PrintWriter output;\n    private static final long MOD = 1000000007;\n\n    private static String inputLine() throws IOException {\n        return input.readLine().trim();\n    }\n\n    private static int[] inputInts() throws IOException {\n        String[] parts = inputLine().split(\"\\\\s+\");\n        int[] arr = new int[parts.length];\n        for (int i = 0; i < parts.length; i++) {\n            arr[i] = Integer.parseInt(parts[i]);\n        }\n        return arr;\n    }\n\n    private static int inputInt() throws IOException {\n        return Integer.parseInt(inputLine());\n    }\n\n    private static long powerMod(long base, long exp) {\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    private static long factorialModulo(int n) {\n        long res = 1;\n        for (int i = 1; i <= n; i++) {\n            res = (res * i) % MOD;\n        }\n        return res;\n    }\n\n    private static void mainLogic() throws IOException {\n        int n = inputInt();\n        int[] a = inputInts();\n        int[] b = inputInts();\n        int a1 = a[0], a2 = a[1], a3 = a[2];\n        int b1 = b[0], b2 = b[1], b3 = b[2];\n\n        int theoreticalLimit = Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n\n        int maxAchieved = 0;\n        int[] perm = {1, 2, 3, 4, 5, 6};\n\n        // Generate all permutations of [1,2,3,4,5,6]\n        do {\n            int ra1 = a1, ra2 = a2, ra3 = a3;\n            int rb1 = b1, rb2 = b2, rb3 = b3;\n            int matched = 0;\n\n            for (int p : perm) {\n                if (p == 1) {\n                    int t = Math.min(ra1, rb1);\n                    ra1 -= t;\n                    rb1 -= t;\n                    matched += t;\n                } else if (p == 2) {\n                    int t = Math.min(ra1, rb3);\n                    ra1 -= t;\n                    rb3 -= t;\n                    matched += t;\n                } else if (p == 3) {\n                    int t = Math.min(ra2, rb2);\n                    ra2 -= t;\n                    rb2 -= 