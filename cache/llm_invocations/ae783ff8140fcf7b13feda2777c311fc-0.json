tf cap[MAXN],mxflow;\nbool in_queue[MAXN];\nvoid flow(int s, int t){\n\tmemset(in_queue,0,sizeof(in_queue));\n\tmxflow=mncost=0;\n\twhile(1){\n\t\tfill(dist,dist+nodes,INFCOSTO);dist[s]=0;\n\t\tmemset(pre,-1,sizeof(pre));pre[s]=0;\n\t\tmemset(cap,0,sizeof(cap));cap[s]=INFFLUJO;\n\t\tqueue<int> q;q.push(s);in_queue[s]=1;\n\t\twhile(SZ(q)){\n\t\t\tint u=q.front();q.pop();in_queue[u]=0;\n\t\t\tfore(_,0,SZ(g[u])){\n\t\t\t\tint i=g[u][_];\n\t\t\t\tedge &E=e[i];\n\t\t\t\tif(E.rem()&&dist[E.v]>dist[u]+E.cost+1e-9){\n\t\t\t\t\tdist[E.v]=dist[u]+E.cost;\n\t\t\t\t\tpre[E.v]=i;\n\t\t\t\t\tcap[E.v]=min(cap[u],E.rem());\n\t\t\t\t\tif(!in_queue[E.v])q.push(E.v),in_queue[E.v]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(pre[t]<0)break;\n\t\tmxflow+=cap[t];mncost+=cap[t]*dist[t];\n\t\tfor(int v=t;v!=s;v=e[pre[v]].u){\n\t\t\te[pre[v]].flow+=cap[t];e[pre[v]^1].flow-=cap[t];\n\t\t}\n\t}\n}\nint main() {\n  ios::sync_with_stdio(false);\n\tll n,m,k,c,d;\n  cin>>n>>m>>k>>c>>d;\n\tint MAXT=n+k;\n\tif(DEBUG)cout<<\"MAXT: \"<<MAXT<<endl;\n\tvector<int>a(k);\n\tfore(i,0,k){\n\t\tcin>>a[i];a[i]--;\n\t\tadd_edge(SRC,a[i]*MAXT,1,0);\n\t}\n\tfore(j,0,MAXT)add_edge(j,SNC,k,0);\n\tfore(i,0,m) {\n\t\tint x,y;cin>>x>>y;x--,y--;\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(x*MAXT+j,y*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(y*MAXT+j,x*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t}\n\tfore(i,0,n) {\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(i*MAXT+j,i*MAXT+j+1,1,c);\n\t\t}\n\t}\n\tflow(SRC,SNC);\n\tif(DEBUG)cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n\tcout<<mncost<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 50 * 100 + 15;\n    static int SRC = MAXN - 1;\n    static int SNC = MAXN - 2;\n    static final long INFFLOW = (long) 1e14;\n    static final long INFCOST = (long) 1e14;\n    static int nodes = MAXN;\n    static List<Edge> e = new ArrayList<>();\n    static List<Integer>[] g = new ArrayList[MAXN];\n    static long[] dist = new long[MAXN];\n    static int[] pre = new int[MAXN];\n    static long[] cap = new long[MAXN];\n    static boolean[] inQueue = new boolean[MAXN];\n    static long mxflow, mncost;\n\n    static class Edge {\n        int u, v;\n        long cap, flow, cost;\n        Edge(int u, int v, long cap, long flow, long cost) {\n            this.u = u; this.v = v; this.cap = cap; this.flow = flow; this.cost = cost;\n        }\n        long rem() { return cap - flow; }\n    }\n\n    static void addEdge(int u, int v, long cap, long cost) {\n        g[u].add(e.size());\n        e.add(new Edge(u, v, cap, 0, cost));\n        g[v].add(e.size());\n        e.add(new Edge(v, u, 0, 0, -cost));\n    }\n\n    static void flow(int s, int t) {\n        Arrays.fill(inQueue, false);\n        mxflow = 0; mncost = 0;\n        while (true) {\n            Arrays.fill(dist, INFCOST);\n            dist[s] = 0;\n            Arrays.fill(pre, -1);\n            pre[s] = 0;\n            Arrays.fill(cap, 0);\n            cap[s] = INFFLOW;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            inQueue[s] = true;\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inQueue[u] = false;\n                for (int idx : g[u]) {\n                    Edge E = e.get(idx);\n                    if (E.rem() > 0 && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                        dist[E.v] = dist[u] + E.cost;\n                        pre[E.v] = idx;\n                        cap[E.v] = Math.min(cap[u], E.rem());\n                        if (!inQueue[E.v]) {\n                            q.add(E.v);\n                            inQueue[E.v] = true;\n                        }\n                    }\n                }\n            }\n            if (pre[t] < 0) break;\n            mxflow += cap[t];\n            mncost += cap[t] * dist[t];\n            for (int v = t; v != s; v = e.get(pre[v]).u) {\n                e.get(pre[v]).flow += cap[t];\n                e.get(pre[v] ^ 1).flow -= cap[t];\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        long m = sc.nextLong();\n        long k = sc.nextLong();\n        long c = sc.nextLong();\n        long d = sc.nextLong();\n        int MAXT = (int)(n + k);\n        for (int i = 0; i < MAXN; i++) g[i] = new ArrayList<>();\n        int[] a = new int[(int)k];\n        for (int i = 0; i < k; i++) {\n            a[i] = sc.nextInt() - 1;\n            addEdge(SRC, a[i] * MAXT, 1, 0);\n        }\n        for (int j = 0; j < MAXT; j++) addEdge(j, SNC, k, 0);\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2L * K - 1));\n                }\n            }\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2L * K - 1));\n                }\n            }\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(i * MAXT + j, i * MAXT + j + 1, 1, c);\n                }\n            }\n        }\n        flow(SRC, SNC);\n        System.out.println(mncost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.9802277e-06, 0.0, 0.0, -0.00010799778, -0.00013648532, -1.1920922e-06, -0.048591305, -0.25229952, -0.00042512917, -4.7683704e-07, -0.0045285053, -0.0052541504, -0.0009854942, -0