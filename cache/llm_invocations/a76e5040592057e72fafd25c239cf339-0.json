{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int MAX_N = 250005;\nint n, k, mod;\nusing ll = long long;\n\nll modPow(ll base, ll exp) {\n    ll result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\ninline int getLowbit(int x) { return x & -x; }\n\nll factorial[MAX_N], invFactorial[MAX_N];\nll memo[26][MAX_N];\n\nll solve(int position, int mask) {\n    if (memo[position][mask] != -1) return memo[position][mask];\n    \n    if (mask == 0) {\n        memo[position][mask] = factorial[n];\n        for (int i = 0; i < position; ++i) {\n            memo[position][mask] = (memo[position][mask] * (k - i)) % mod;\n        }\n        return memo[position][mask];\n    }\n    \n    memo[position][mask] = 0;\n    int submask = mask - getLowbit(mask);\n    \n    for (int subset = submask; subset > 0; subset = (subset - 1) & submask) {\n        memo[position][mask] = (memo[position][mask] + invFactorial[mask - subset] * solve(position + 1, subset)) % mod;\n    }\n    \n    memo[position][mask] = (memo[position][mask] + invFactorial[mask] * solve(position + 1, 0)) % mod;\n    return memo[position][mask];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> mod;\n    ll total = modPow(k, n);\n    \n    if (n % 2 == 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    factorial[0] = 1;\n    for (int i = 1; i <= n; ++i) factorial[i] = factorial[i-1] * i % mod;\n    \n    invFactorial[n] = modPow(factorial[n], mod - 2);\n    for (int i = n; i >= 1; --i) {\n        invFactorial[i-1] = invFactorial[i] * i % mod;\n    }\n    \n    memset(memo, -1, sizeof(memo));\n    ll subtract = solve(0, n);\n    ll result = (total - subtract + mod) % mod;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static int MAX_N = 250005;\n    static int n, k, mod;\n    static long[] factorial = new long[MAX_N];\n    static long[] invFactorial = new long[MAX_N];\n    static long[][] memo = new long[26][MAX_N];\n\n    static long modPow(long base, long exp) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) result = (result * base) % mod;\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    static int getLowbit(int x) { \n        return x & -x; \n    }\n\n    static long solve(int position, int mask) {\n        if (memo[position][mask] != -1) return memo[position][mask];\n        \n        if (mask == 0) {\n            memo[position][mask] = factorial[n];\n            for (int i = 0; i < position; ++i) {\n                memo[position][mask] = (memo[position][mask] * (k - i)) % mod;\n            }\n            return memo[position][mask];\n        }\n        \n        memo[position][mask] = 0;\n        int submask = mask - getLowbit(mask);\n        \n        for (int subset = submask; subset > 0; subset = (subset - 1) & submask) {\n            memo[position][mask] = (memo[position][mask] + invFactorial[mask - subset] * solve(position + 1, subset)) % mod;\n        }\n        \n        memo[position][mask] = (memo[position][mask] + invFactorial[mask] * solve(position + 1, 0)) % mod;\n        return memo[position][mask];\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        mod = Integer.parseInt(st.nextToken());\n        \n        long total = modPow(k, n);\n        \n        if (n % 2 == 1) {\n            System.out.println(total);\n            return;\n        }\n        \n        factorial[0] = 1;\n        for (int i = 1; i <= n; ++i) factorial[i] = factorial[i-1] * i % mod;\n        \n        invFactorial[n] = modPow(factorial[n], mod - 2);\n        for (int i = n; i >= 1; --i) {\n            invFactorial[i-1] = invFactorial[i] * i % mod;\n        }\n        \n        for (int i = 0; i < 26; i++) {\n            Arrays.fill(memo[i], -1);\n        }\n        \n        long subtract = solve(0, n);\n        long result = (total - subtract + mod) % mod;\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.77468371274881e-05, -1.311301275563892e-06, -2.3841855067985307e-07, -0.0005044856225140393, -1.764281842042692e-05, -0.06208536773920059, -0.31408801674842834, -0.001772143878042698, -1.3232143828645349e-05, -0.0004798214649781585, -0.0002431573811918497, -3.158996332786046e-05, -1.1920922133867862e-06, -3.7788631743751466e-05, -0.0013300867285579443, -1.0