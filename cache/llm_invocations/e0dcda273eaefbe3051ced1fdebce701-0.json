\n}\nint main()\n{\n    fn = 100000;    fd = 1;\n    long long int x,i,y,n;\n    cin >> x >> y >> n;\n    int j;\n    for ( int i = 0; i < 19; i++ ) {\n        j = i;\n    }\n    for (i = 1; i <= n; i++) {\n        function (x, y, i, (i*x)/y);\n        function (x, y, i, (i*x)/y + 1);\n        function (x, y, i, (i*x)/y - 1);\n    }\n    cout << ra << \"/\" << rb << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "import java.util.Scanner;\n\npublic class Main {\n    static long fn, fd;\n    static long ra, rb;\n\n    public static long gcd(long a, long b) {\n        if (b == 0)\n            return a;\n        else\n            return gcd(b, a % b);\n    }\n\n    public static void function(long x, long y, long b, long a) {\n        if (a < 0) {\n            return;\n        }\n        long kkk = gcd(a, b);\n        a = a / kkk;\n        b = b / kkk;\n        long n = Math.abs(b * x - a * y);\n        long d = b * y;\n        long g = gcd(n, d);\n        n = n / g;\n        d = d / g;\n        if (n * fd < fn * d) {\n            fn = n;\n            fd = d;\n            ra = a;\n            rb = b;\n            return;\n        }\n        if (n * fd == fn * d) {\n            if (b < rb) {\n                ra = a;\n                rb = b;\n                return;\n            }\n            if (b > rb) {\n                return;\n            }\n            if (a < ra) {\n                ra = a;\n                rb = b;\n                return;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        fn = 100000;\n        fd = 1;\n        long x = sc.nextLong();\n        long y = sc.nextLong();\n        long n = sc.nextLong();\n\n        for (int i = 0; i < 19; i++) {\n            int j = i; // This loop does nothing meaningful, kept for fidelity\n        }\n\n        for (long i = 1; i <= n; i++) {\n            function(x, y, i, (i * x) / y);\n            function(x, y, i, (i * x) / y + 1);\n            function(x, y, i, (i * x) / y - 1);\n        }\n\n        System.out.println(ra + \"/\" + rb);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.012250503525137901, -1.9361264946837764e-07, -0.00016420685278717428, -0.11048515886068344, -0.0004330532974563539, -1.4021237802808173e-05, -5.512236498361744e-07, -0.00036918214755132794, -0.10022769868373871, -0.014925745315849781, -0.010532704181969166, -0.0001302374730585143, -0.0009676800691522658, -0.1502554565668106, -1.723973582556937e-05, -0.022363508120179176, -5.512236498361744e-07, -9.088346359931165e-07, -1.9361264946837764e-07, -6.704273118884885e-07, -0.00020413640595506877, -7.703443770878948e-06, -0.0234137661755085, -1.5048530030981055e-06, -0.42456158995628357, 0.0, -0.14268651604652405, 0.0, -1.1279553291387856e-05, -1.9361264946837764e-07, -1.0921942703134846e-05, 0.0, 0.0, -0.0005644689663313329, -2.5776860184123507e-06, -3.128163257315464e-07, -0.017960984259843826, -1.9623810658231378e-05, -1.0280383548888494e-06, -6.2729995988775045e-06, -1.2664456789934775e-06, -1.9361264946837764e-07, -0.16027134656906128, -1.8624639324116288e-06, 0.0, -6.704273118884885e-07, -4.60414821645827e-06, -4.320199877838604e-07, -0.0013267839094623923, -2.3795937522663735e-05, -6.704273118884885e-07, -3.128163257315464e-07, 0.0, -7.896309739408025e-07, -5.438573680294212e-06, -1.9361264946837764e-07, -1.6240566083070007e-06, 0.0, -1.7432603272027336e-06, -2.696889623621246e-06, -0.005993263330310583, -1.5048530030981055e-06, -0.22912585735321045, -1.9361264946837764e-07, -1.981667537620524e-06, -0.003531774738803506, -0.0008176080300472677, 0.0, -1.3856492842023727e-06, 0.0, 0.0, -6.704273118884885e-07, 0.0, -5.1689596148207784e-05, -3.35706390615087e-05, -3.4121114822482923e-06, -1.9361264946837764e-07, -0.00010139751975657418, -5