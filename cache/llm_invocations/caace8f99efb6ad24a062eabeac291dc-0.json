dfs(s, t, cur_flow, used):\n                total_flow += cur_flow\n            else:\n                cur_flow >>= 1\n        return total_flow\n\ndef ok(x, y, n, a):\n    return 0 <= x < n and 0 <= y < n and a[x][y] != 'Y' and a[x][y] != 'Z'\n\ndef bfs_death(x, y, n, a):\n    dist = [[INF] * n for _ in range(n)]\n    qx = deque()\n    qy = deque()\n    dist[x][y] = 0\n    qx.append(x)\n    qy.append(y)\n    while qx:\n        cx = qx.popleft()\n        cy = qy.popleft()\n        for k in range(4):\n            tx = cx + dx[k]\n            ty = cy + dy[k]\n            if ok(tx, ty, n, a) and dist[tx][ty] == INF:\n                dist[tx][ty] = dist[cx][cy] + 1\n                qx.append(tx)\n                qy.append(ty)\n    return dist\n\ndef run_bfs(x, y, n, t, a, b, dist, max_flow):\n    used = [[False] * n for _ in range(n)]\n    qx = deque()\n    qy = deque()\n    qlev = deque()\n    used[x][y] = True\n    qx.append(x)\n    qy.append(y)\n    qlev.append(0)\n    while qx:\n        cx = qx.popleft()\n        cy = qy.popleft()\n        cur_lev = qlev.popleft()\n        if b[cx][cy].isdigit() and b[cx][cy] != '0':\n            max_flow.add_edge(x * n + y, n * n + 1 + cx * n + cy, INF)\n        if cur_lev >= t:\n            continue\n        for k in range(4):\n            tx = cx + dx[k]\n            ty = cy + dy[k]\n            if ok(tx, ty, n, a) and not used[tx][ty]:\n                if dist[tx][ty] > cur_lev + 1:\n                    qx.append(tx)\n                    qy.append(ty)\n                    qlev.append(cur_lev + 1)\n                elif dist[tx][ty] > cur_lev and b[tx][ty].isdigit() and b[tx][ty] != '0':\n                    max_flow.add_edge(x * n + y, n * n + 1 + tx * n + ty, INF)\n                used[tx][ty] = True\n\ndef build(n, t, a, b, max_flow):\n    # find Z\n    zi = zj = -1\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                zi, zj = i, j\n                break\n        if zi != -1:\n            break\n    dist = bfs_death(zi, zj, n, a)\n    S = n * n * 2  # source index\n    T = n * n * 2 + 1  # sink index\n    # add edges from source to a-digits\n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit() and a[i][j] != '0':\n                max_flow.add_edge(S, i * n + j, int(a[i][j]))\n    # add edges from b-digits to sink\n    for i in range(n):\n        for j in range(n):\n            if b[i][j].isdigit() and b[i][j] != '0':\n                max_flow.add_edge(i * n + j + n * n + 1, T, int(b[i][j]))\n    # add edges from a-cells to b-cells\n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit() and a[i][j] != '0':\n                run_bfs(i, j, n, t, a, b, dist, max_flow)\n    return S, T\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    n = int(first[0])\n    t = int(first[1])\n    a = []\n    b = []\n    # next n lines for a\n    idx = 1\n    for _ in range(n):\n        a.append(data[idx].strip())\n        idx += 1\n    # next n lines for b\n    for _ in range(n):\n        b.append(data[idx].strip())\n        idx += 1\n    # total nodes: source, sink, and 2*n*n intermediate nodes\n    total_nodes = 2 * n * n + 2\n    max_flow = MaxFlow(total_nodes)\n    S, T = build(n, t, a, b, max_flow)\n    result = max_flow.get_max_flow(S, T)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.386805812828243e-05, -1.1920928244535389e-07, 0.0, -0.0003461238811723888, -0.015200255438685417, -4.768370445162873e-07, -9.536697689327411e-06, -0.0003401654539629817, -1.1920928244535389e-07, 0.0, -2.0265558760002023e-06, -0.0007898071780800819, -0.24023836851119995, -0.00021395778458099812, -8.83301836438477e-05, -0.05024024099111557, -0.018149960786104202, -0.003655301406979561, -0.05539143830537796, -0.5451081991195679, -1.311301275563892e-06, 