{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cstring>\n#include <ctime>\n#include <cmath>\n#include <iomanip>\n\nusing namespace std;\n\nusing ll = long long;\nusing ld = long double;\nusing vi = vector<int>;\nusing vvi = vector<vi>;\n\n#define REP(i, a, b) for (int i = (a); i < (b); ++i)\n#define PER(i, a, b) for (int i = (b) - 1; i >= (a); --i)\n#define ALL(x) (x).begin(), (x).end()\n#define SZ(x) ((int)(x).size())\n#define MP make_pair\n#define PB push_back\n\nvoid solve(int n) {\n    int k;\n    cin >> k;\n\n    using T = double;\n    vector<T> p(n);\n    for (int i = 0; i < n; ++i)\n        cin >> p[i];\n\n    T dp[2][1 << n];\n    memset(dp, 0, sizeof(dp));\n\n    vector<int> good;\n    vector<char> isgood(n, 0);\n    for (int i = 0; i < n; ++i)\n        if (p[i] != 0.0) {\n            isgood[i] = 1;\n            good.PB(i);\n        }\n\n    dp[0][0] = 1.0;\n    int cur = 1;\n\n    vector<T> sum(1 << n, 0.0);\n    sum[0] = 1.0;\n    for (int mask = 1; mask < (1 << n); ++mask) {\n        int lsb = mask & -mask;\n        int bit = __builtin_ctz(lsb);\n        sum[mask] = sum[mask ^ (1 << bit)] - p[bit];\n    }\n\n    int steps = min(SZ(good), k);\n    for (int step = 0; step < steps; ++step) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int idx : good) {\n                if (mask & (1 << idx)) continue;\n                dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / sum[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    for (int i = 0; i < n; ++i) {\n        if (!isgood[i]) {\n            cout << fixed << setprecision(12) << 0.0 << \"\\n\";\n        } else {\n            T ans = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    ans += dp[cur][mask];\n            }\n            cout << fixed << setprecision(12) << (double)ans << \"\\n\";\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << fixed << setprecision(6) << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport time\n\ndef solve(n):\n    data = input().split()\n    k = int(data[0])\n    \n    p = list(map(float, input().split()))\n    \n    dp = [[0.0] * (1 << n) for _ in range(2)]\n    \n    good = []\n    isgood = [0] * n\n    for i in range(n):\n        if p[i] != 0.0:\n            isgood[i] = 1\n            good.append(i)\n    \n    dp[0][0] = 1.0\n    cur = 1\n    \n    sum_arr = [0.0] * (1 << n)\n    sum_arr[0] = 1.0\n    for mask in range(1, 1 << n):\n        lsb = mask & -mask\n        bit = (lsb.bit_length() - 1)\n        sum_arr[mask] = sum_arr[mask ^ (1 << bit)] - p[bit]\n    \n    steps = min(len(good), k)\n    for step in range(steps):\n        dp[cur] = [0.0] * (1 << n)\n        \n        for mask in range(1 << n):\n            if bin(mask).count('1') != step:\n                continue\n            \n            for idx in good:\n                if mask & (1 << idx):\n                    continue\n                new_mask = mask ^ (1 << idx)\n                dp[cur][new_mask] += dp[cur ^ 1][mask] * p[idx] / sum_arr[mask]\n        \n        cur ^= 1\n    \n    cur ^= 1\n    for i in range(n):\n        if not isgood[i]:\n            print(\"{:.12f}\".format(0.0))\n        else:\n            ans = 0.0\n            for mask in range(1 << n):\n                if mask & (1 << i):\n                    ans += dp[cur][mask]\n            print(\"{:.12f}\".format(ans))\n\ndef main():\n    input = sys.stdin.readline\n    try:\n        while True:\n            line = input().strip()\n            if not line:\n                break\n            n = int(line)\n            solve(n)\n    except EOFError:\n        pass\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011824862303910777, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.00028951745480298996, -0.0006957017467357218, -1.0728830375228426e-06, -0.0011876918142661452, -0.0011845960980281234, -9.63164638960734e-05, -0.02324765920639038, -0.024160366505384445, -0.048638880252838135, -0.0003289635351393372, -0.0005868143052794039, -0.027326492592692375, -0.0019850090611726046, -5.125986263010418e-06, -0.5003488063812256, -0.014281915500760078, -0.65015709400177, -0.00016878610767889768, -0.0067365444265306, -1.9073468138230965e-06, -8.344646857949556e-07, -0.025392131879925728, -2.3841855067985307e-07, -7.152555099310121e-07, -3.099436753473128e-06, -0.00033968876232393086, -1.19209