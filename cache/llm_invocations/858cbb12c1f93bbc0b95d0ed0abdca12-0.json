\t\twhile(x!=S)edge[id[x]].val-=mn,edge[id[x]^1].val+=mn,x=fr[x];\n\t\treturn true;\n\t}\n}\nusing namespace MCMF;\nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&r,&c,&d),memset(head,-1,sizeof(head)),S=(r+n+1)*n+1,T=(r+n+1)*n+2;\n\tfor(int i=1,x;i<=r;i++)scanf(\"%d\",&x),occ[x]++;\n\tfor(int i=1;i<=m;i++)scanf(\"%d%d\",&p[i].first,&p[i].second);\n\tfor(int i=0;i<r+n;i++)for(int j=1;j<=m;j++)for(int k=1;k<=r;k++)ae(i*n+p[j].first,(i+1)*n+p[j].second,1,(2*k-1)*d),ae(i*n+p[j].second,(i+1)*n+p[j].first,1,(2*k-1)*d);\n\tfor(int i=1;i<=r+n;i++){\n\t\tae(i*n+1,T,0x3f3f3f3f,i*c);\n\t\tfor(int j=2;j<=n;j++)ae((i-1)*n+j,i*n+j,0x3f3f3f3f,0);\n\t}\t\n\tfor(int i=1;i<=n;i++)ae(S,i,occ[i],0);\n\twhile(SPFA());\n\tprintf(\"%d\\n\",cost);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n \npublic class Main {\n    static int n, m, r, c, d;\n    static int[] occ = new int[100];\n    static Pair[] p = new Pair[100];\n    static class Pair {\n        int first, second;\n        Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n \n    static class MCMF {\n        static final int N = 10000;\n        static final int M = 20000000;\n        static int[] head = new int[N];\n        static int cnt = 0;\n        static int[] dis = new int[N];\n        static int[] fr = new int[N];\n        static int[] id = new int[N];\n        static int S, T, cost;\n        static List<Edge> edges = new ArrayList<>();\n        \n        static class Edge {\n            int to, next, val, cost;\n            public Edge(int to, int next, int val, int cost) {\n                this.to = to;\n                this.next = next;\n                this.val = val;\n                this.cost = cost;\n            }\n        }\n        \n        static void init() {\n            Arrays.fill(head, -1);\n            edges.clear();\n            cnt = 0;\n            cost = 0;\n        }\n        \n        static void ae(int u, int v, int w, int c) {\n            edges.add(new Edge(v, head[u], w, c));\n            head[u] = cnt++;\n            edges.add(new Edge(u, head[v], 0, -c));\n            head[v] = cnt++;\n        }\n\n        static boolean SPFA() {\n            Arrays.fill(dis, Integer.MAX_VALUE / 2);\n            dis[S] = 0;\n            boolean[] in = new boolean[N];\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(S);\n            in[S] = true;\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                in[x] = false;\n                for (int i = head[x]; i != -1; i = edges.get(i).next) {\n                    Edge e = edges.get(i);\n                    if (e.val == 0) continue;\n                    if (dis[e.to] > dis[x] + e.cost) {\n                        dis[e.to] = dis[x] + e.cost;\n                        fr[e.to] = x;\n                        id[e.to] = i;\n                        if (!in[e.to]) {\n                            in[e.to] = true;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n            if (dis[T] == Integer.MAX_VALUE / 2) return false;\n            int x = T, mn = Integer.MAX_VALUE / 2;\n            while (x != S) {\n                mn = Math.min(mn, edges.get(id[x]).val);\n                x = fr[x];\n            }\n            cost += dis[T] * mn;\n            x = T;\n            while (x != S) {\n                edges.get(id[x]).val -= mn;\n                edges.get(id[x] ^ 1).val += mn;\n                x = fr[x];\n            }\n            return true;\n        }\n\n        static int run() {\n            while (SPFA()){}\n            return cost;\n        }\n    }\n \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        Arrays.fill(MCMF.head, -1);\n \n      