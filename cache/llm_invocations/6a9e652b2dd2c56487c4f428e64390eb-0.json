 static class Pair {\n        int x, y;\n        Pair(int x, int y) {\n            this.x = x;\n            this.y = y;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int V;\n        ArrayList<Edge>[] G;\n        int[] H, dis, PreV, PreE;\n        final int INF = Integer.MAX_VALUE / 2;\n\n        static class Edge {\n            int to, cap, cost, rev;\n            Edge(int to, int cap, int cost, int rev) {\n                this.to = to;\n                this.cap = cap;\n                this.cost = cost;\n                this.rev = rev;\n            }\n        }\n\n        void Init(int n) {\n            V = n;\n            G = new ArrayList[V + 1];\n            for (int i = 0; i <= V; i++) {\n                G[i] = new ArrayList<>();\n            }\n            H = new int[V + 1];\n            dis = new int[V + 1];\n            PreV = new int[V + 1];\n            PreE = new int[V + 1];\n        }\n\n        void add_edge(int from, int to, int cap, int cost) {\n            Edge fwd = new Edge(to, cap, cost, G[to].size());\n            Edge rev = new Edge(from, 0, -cost, G[from].size());\n            G[from].add(fwd);\n            G[to].add(rev);\n        }\n\n        int minCost(int s, int t, int f) {\n            int flow = 0;\n            int res = 0;\n            Arrays.fill(H, 0);\n            while (f > 0) {\n                PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> a[0] - b[0]);\n                Arrays.fill(dis, INF);\n                dis[s] = 0;\n                pq.offer(new int[]{0, s});\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int v = cur[1];\n                    if (dis[v] < cur[0]) continue;\n                    for (int i = 0; i < G[v].size(); i++) {\n                        Edge e = G[v].get(i);\n                        if (e.cap > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n                            dis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n                            PreV[e.to] = v;\n                            PreE[e.to] = i;\n                            pq.offer(new int[]{dis[e.to], e.to});\n                        }\n                    }\n                }\n                if (dis[t] == INF) break;\n                for (int i = 0; i <= V; i++) H[i] += dis[i];\n                int d = f;\n                for (int v = t; v != s; v = PreV[v]) {\n                    d = Math.min(d, G[PreV[v]].get(PreE[v]).cap);\n                }\n                f -= d;\n                flow += d;\n                res += d * H[t];\n                for (int v = t; v != s; v = PreV[v]) {\n                    Edge e = G[PreV[v]].get(PreE[v]);\n                    e.cap -= d;\n                    G[v].get(e.rev).cap += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int V = n * (n + 55) + 2;\n        MinCostMaxFlow mcmf = new MinCostMaxFlow();\n        mcmf.Init(V);\n\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            mcmf.add_edge(0, u, 1, 0);\n        }\n\n        List<Pair> edges = new ArrayList<>();\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            edges.add(new Pair(x, y));\n        }\n\n        int tar = n * (n + 55) + 1;\n        for (int t = 0; t < n + 54; t++) {\n            for (Pair e : edges) {\n                for (int j = 1; j <= k; j++) {\n                    int cost = c + d * (j * 2 - 1);\n                    mcmf.add_edge(e.x + t * n, e.y + (t + 1) * n, 1, cost);\n                    mcmf.add_edge(e.y + t * n, e.x + (t + 1) * n, 1, cost);\n                }\n            }\n            for (int i = 2; i <= n; i++) {\n                mcmf.add_edge(i + t * n, i + (t + 1) * n, k, c);\n            }\n            mcmf.add_edge(1 + t * n, tar, k, 0);\n        }\n\n        int result = mcmf.minCost(0, tar, k);\n        System.out.println(result);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.008780678734183311, -1.8000440832111053e-05, 0.0, 0.0, -0.00038890427094884217, -0.000571326119825244, 0.0, -7.509902934543788e-05, -0.009426843374967575, -0.006799654569476843, 0.0, -0.0001110968878492713, -2.1271510124206543, -9.512448741588742e-05, -0.014350191690027714, -2.5510462364763953e-05, -1.335129976272583, -9.894321920000948e-06, -3.576278118089249e-07, -3.933898824470816e-06, -1.680836794548668e-05, -0.00015948931104503572, 0.0, -1.3470558769768104e-05, -1.1920928244535389e-07, -0.0002615109842736274, -1.4066597032069694e-05, -0.011693034321069717, -1.7881377516459906e-06, 0.0, 0.0, -1.4305012882687151e-05, -0.1602243036031723, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -4.768370445162873e-07, -0.000553335587028414, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -3.576278118089249e-07, -5.960462772236497e-07, -3.576278118089249e-07, -5.960462772236497e-07, -2.2172682292875834e-05, -3.576278118089249e-07, -9.60780744208023e-05, -0.00020895205670967698, -0.023252202197909355, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, -0.004079235717654228, -3.6954195820726454e-05, -0.1292211264371872, -8.344646857949556e-07, -2.0503786799963564e-05, -2.3841855067985307e-07, -0.017738157883286476, -3.3378546504536644e-06, -2.4199192921514623e-05, 0.0, -0.00012385078298393637, -9.536738616588991e-07, -7.867782187531702e-06, 0.0, -1.680836794548668e-05, -2.407998726994265e-05, -7.510157047363464e-06, -0.004093363881111145, -0.00012385078298393637, -1.3112935448589269e-05, -0.0032286918722093105, -4.768370445162873e-07, -4.768370445162873e-07, -2.3841855067985307e-07, 0.0, -0.0