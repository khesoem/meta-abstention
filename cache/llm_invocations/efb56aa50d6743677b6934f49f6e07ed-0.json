  pr = [[0] * 6 for _ in range(6)]\n    \n    # Read pr matrix\n    for i in range(n):\n        for j in range(n):\n            pr[i][j] = int(data[idx])\n            idx += 1\n            pr[i][j] = (pr[i][j] * modpow(100, MOD - 2)) % MOD\n    \n    # Fill remaining rows with identity\n    for i in range(n, 6):\n        pr[i][i] = 1\n    \n    n = 6\n    \n    # Generate m3: all 6-bit numbers with exactly 3 bits set\n    m3 = []\n    for i in range(1 << 6):\n        if bin(i).count('1') == 3:\n            m3.append(i)\n    \n    # Create map from mask to index\n    map_dict = {mask: i for i, mask in enumerate(m3)}\n    \n    # comp array\n    comp = [0] * 20\n    for i in range(20):\n        comp[i] = map_dict[m3[i] ^ 63]\n    \n    # Initialize sub and mas arrays\n    sub = [[0] * (1 << 18) for _ in range(2)]\n    mas = [0] * (1 << 18)\n    \n    # Process masks\n    for mask in range(1 << 18):\n        sub[0][mask] = 1\n        sub[1][mask] = 1\n        \n        for i in range(6):\n            for j in range(3):\n                bit_pos = (i * 3) + j\n                if mask & (1 << bit_pos):\n                    sub[0][mask] = (sub[0][mask] * pr[i][j]) % MOD\n                    sub[1][mask] = (sub[1][mask] * pr[i][3 + j]) % MOD\n                else:\n                    od = (1 - pr[i][j]) % MOD\n                    if od < 0:\n                        od += MOD\n                    sub[0][mask] = (sub[0][mask] * od) % MOD\n                    \n                    od = (1 - pr[i][3 + j]) % MOD\n                    if od < 0:\n                        od += MOD\n                    sub[1][mask] = (sub[1][mask] * od) % MOD\n        \n        ind = 0\n        for m in m3:\n            guys = []\n            for i in range(6):\n                if m & (1 << i):\n                    guys.append(i)\n            \n            bad = False\n            for xd in range(1 << 3):\n                ms = 0\n                for i in range(3):\n                    if xd & (1 << i):\n                        ms |= (mask >> (guys[i] * 3)) & 7\n                \n                if bin(xd).count('1') > bin(ms).count('1'):\n                    bad = True\n                    break\n            \n            if not bad:\n                mas[mask] += (1 << ind)\n            ind += 1\n    \n    # Initialize p arrays\n    p = [[0] * (1 << 20) for _ in range(2)]\n    \n    for i in range(1 << 18):\n        p[0][mas[i]] = (p[0][mas[i]] + sub[0][i]) % MOD\n    \n    for i in range(1 << 18):\n        p[1][cm(mas[i])] = (p[1][cm(mas[i])] + sub[1][i]) % MOD\n    \n    # Sum over subsets for p[1]\n    for i in range(20):\n        for mask in range(1 << 20):\n            if mask & (1 << i):\n                p[1][mask] = (p[1][mask] + p[1][mask ^ (1 << i)]) % MOD\n    \n    # Calculate answer\n    ans = 0\n    for i in range(1 << 20):\n        ans = (ans + p[0][i] * p[1][i ^ ((1 << 20) - 1)]) % MOD\n    \n    ans = (1 - ans) % MOD\n    if ans < 0:\n        ans += MOD\n    \n    print(ans)\n\ndef cm(a):\n    ret = 0\n    for i in range(20):\n        if a & (1 << i):\n            ret += (1 << comp[i])\n    return ret\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00017915551143232733, -7.152555099310121e-07, -3.576278118089249e-07, -0.06549331545829773, -0.0019243309507146478, -0.3868868947029114, -0.07036653906106949, -0.14273616671562195, -1.1920928244535389e-07, -0.00017414960893802345, -0.006752174347639084, -0.020602626726031303, 0.0, -3.576278118089249e-07, 0.0, -9.536738616588991e-07, -0.0009118927991949022, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.4305104514278355e-06, -1.728519782773219e-05, -3.2066785934148356e-05, -5.6265202147187665e-05, -0.005382687784731388, -2.8013790142722428e-05, -1.1920928244535389e-07, 0.0, -0.0008122005965560675, -1.1920928244535389e-07, -1.0013530300057027e-05, 0.0, 0.0, -1.1920928244535389e-07, -1.6689286894688848e