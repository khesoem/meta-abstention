+; }\n    pref[0] = Matrix(k + 1, Row(k + 1, 0));\n    for (int i = 1; i < k; ++i) pref[0][i][i] = 1;\n    pref[0][0][k] = 1;\n    pref[0][k][0] = MOD - 1;\n    pref[0][k][k] = 2;\n    for (int step = 0; step < digs; ++step) {\n        pref[step + 1] = pref[step];\n        auto cur = pref[step];\n        for (int i = 1; i <= k - 1; ++i) {\n            cur = shiftMat(cur);\n            pref[step + 1] = matMul(pref[step + 1], cur);\n        }\n    }\n}\nMatrix solve(ll n) {\n    if (n == 0) {\n        Matrix I(k + 1, Row(k + 1, 0));\n        for (int i = 0; i <= k; ++i) I[i][i] = 1;\n        return I;\n    }\n    ll pw = 1, dig = 0;\n    while (pw <= n / k) { pw *= k; ++dig; }\n    if (n == pw) return pref[dig];\n    ll steps = n / pw;\n    ll left = n - steps * pw;\n    auto cur = solve(0);\n    auto coeff = pref[dig];\n    for (ll i = 0; i < steps; ++i) {\n        cur = matMul(cur, coeff);\n        coeff = shiftMat(coeff);\n    }\n    auto other = solve(left);\n    for (ll i = 0; i < steps; ++i) other = shiftMat(other);\n    return matMul(cur, other);\n}\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    srand(239);\n    cin >> n >> k;\n    init();\n    Matrix res = solve(n);\n    cout << res[k][k] << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add(a, b):\n    r = a + b\n    return r - MOD if r >= MOD else r\n\ndef sub(a, b):\n    r = a - b\n    return r + MOD if r < 0 else r\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef mat_mul(A, B):\n    sz = len(A)\n    C = [[0] * sz for _ in range(sz)]\n    for i in range(sz):\n        for j in range(sz):\n            if A[i][j] == 0:\n                continue\n            aij = A[i][j]\n            rowB = B[j]\n            for t in range(sz):\n                C[i][t] = add(C[i][t], mul(aij, rowB[t]))\n    return C\n\ndef shift_mat(M):\n    sz = len(M)\n    R = [[0] * sz for _ in range(sz)]\n    k = sz - 1\n    for i in range(sz):\n        ni = (i + k - 1) % k if i < k else i\n        for j in range(sz):\n            nj = (j + k - 1) % k if j < k else j\n            R[i][j] = M[ni][nj]\n    return R\n\npref = [None] * 100\n\ndef init(n, k):\n    digs = 0\n    tmp = n\n    while tmp:\n        tmp //= k\n        digs += 1\n    # pref[0]\n    pref[0] = [[0] * (k + 1) for _ in range(k + 1)]\n    for i in range(1, k):\n        pref[0][i][i] = 1\n    pref[0][0][k] = 1\n    pref[0][k][0] = MOD - 1\n    pref[0][k][k] = 2\n    for step in range(digs):\n        pref[step + 1] = pref[step]\n        cur = pref[step]\n        for _ in range(1, k):\n            cur = shift_mat(cur)\n            pref[step + 1] = mat_mul(pref[step + 1], cur)\n\ndef solve(n, k):\n    if n == 0:\n        I = [[0] * (k + 1) for _ in range(k + 1)]\n        for i in range(k + 1):\n            I[i][i] = 1\n        return I\n    pw = 1\n    dig = 0\n    while pw <= n // k:\n        pw *= k\n        dig += 1\n    if n == pw:\n        return pref[dig]\n    steps = n // pw\n    left = n - steps * pw\n    cur = solve(0, k)\n    coeff = pref[dig]\n    for _ in range(steps):\n        cur = mat_mul(cur, coeff)\n        coeff = shift_mat(coeff)\n    other = solve(left, k)\n    for _ in range(steps):\n        other = shift_mat(other)\n    return mat_mul(cur, other)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    init(n, k)\n    res = solve(n, k)\n    print(res[k][k])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00033682872890494764, 0.0, 0.0, -0.00018189683032687753, -0.5823333859443665, -1.1920928244535389e-07, -0.1002129465341568, -4.8397800128441304e-05, -9.536738616588991e-07, -1.1920928244535389e-07, -5.483612312673358e-06, -1.1920928244535389e-07, 