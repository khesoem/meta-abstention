-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <set>\n#include <cmath>\n\nusing namespace std;\n\nint n, m;\nvector<int> a;\nvector<int> left_list;\nvector<int> right_list;\n\nvoid explore_left(int index, int current) {\n    if (index == n / 2) {\n        left_list.push_back(current);\n    } else {\n        explore_left(index + 1, (current + a[index]) % m);\n        explore_left(index + 1, current);\n    }\n}\n\nvoid explore_right(int index, int current) {\n    if (index == n) {\n        right_list.push_back(current);\n    } else {\n        explore_right(index + 1, (current + a[index]) % m);\n        explore_right(index + 1, current);\n    }\n}\n\nint main() {\n    cin >> n >> m;\n    a.resize(n);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n    }\n\n    explore_left(0, 0);\n    explore_right(n / 2, 0);\n\n    set<int> left_set(left_list.begin(), left_list.end());\n    left_list.assign(left_set.begin(), left_set.end());\n    sort(left_list.begin(), left_list.end());\n\n    int max_value = 0;\n    for (int right_item : right_list) {\n        int required = m - right_item;\n        auto it = lower_bound(left_list.begin(), left_list.end(), required);\n        if (it != left_list.begin()) {\n            --it;\n            int value = *it + right_item;\n            if (value > max_value) {\n                max_value = value;\n            }\n        }\n    }\n\n    cout << max_value << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001967951684491709, -6.318072337307967e-06, -5.960462772236497e-07, -0.0003432638186495751, -2.3841855067985307e-07, -2.95634672511369e-05, -1.1920928244535389e-07, -4.6491513785440475e-06, -9.536738616588991e-07, -1.847726889536716e-05, -3.576278118089249e-07, -7.152555099310121e-07, -7.152555099310121e-07, -0.05494922026991844, -4.768360213347478e-06, -0.0007103541865944862, -6