{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1000*1000*1000;\n\nstruct Rib {\n    int b, u, c, f;\n    size_t back;\n};\n\nvoid add_rib(vector<vector<Rib>>& g, int a, int b, int u, int c) {\n    Rib r1 = {b, u, c, 0, g[b].size()};\n    Rib r2 = {a, 0, -c, 0, g[a].size()};\n    g[a].push_back(r1);\n    g[b].push_back(r2);\n}\n\nint main() {\n    int N, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &N, &m, &k, &c, &d);\n    int n = N * 101 + 2;\n    vector<vector<Rib>> g(n);\n    for (int i = 0; i < k; i++) {\n        int x;\n        scanf(\"%d\", &x);\n        x--;\n        add_rib(g, n-2, x*101, 1, 0);\n    }\n    for (int i = 0; i < 101; i++) {\n        add_rib(g, i, n-1, INF, i*c);\n    }\n    for (int i = 1; i < N; i++) {\n        for (int j = 0; j+1 < 101; j++) {\n            add_rib(g, i*101 + j, i*101 + j + 1, INF, 0);\n        }\n    }\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        u--; v--;\n        for (int j = 0; j+1 < 101; j++) {\n            for (int K = 1; K <= k; K++) {\n                int cost = d * (2*K - 1);\n                add_rib(g, u*101 + j, v*101 + j + 1, 1, cost);\n                add_rib(g, v*101 + j, u*101 + j + 1, 1, cost);\n            }\n        }\n    }\n    int s = n-2, t = n-1;\n    int flow = 0, cost = 0;\n    while (flow < k) {\n        vector<int> dist(n, INF);\n        vector<int> prev(n, -1);\n        vector<size_t> preve(n);\n        deque<int> dq;\n        vector<int> inqueue(n, 0);\n        dist[s] = 0;\n        dq.push_back(s);\n        inqueue[s] = 1;\n        while (!dq.empty()) {\n            int v = dq.front(); dq.pop_front();\n            inqueue[v] = 0;\n            for (size_t i = 0; i < g[v].size(); i++) {\n                Rib& r = g[v][i];\n                if (r.f < r.u && dist[v] + r.c < dist[r.b]) {\n                    dist[r.b] = dist[v] + r.c;\n                    prev[r.b] = v;\n                    preve[r.b] = i;\n                    if (!inqueue[r.b]) {\n                        if (!dq.empty() && dist[r.b] < dist[dq.front()]) {\n                            dq.push_front(r.b);\n                        } else {\n                            dq.push_back(r.b);\n                        }\n                        inqueue[r.b] = 1;\n                    }\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        int addflow = k - flow;\n        for (int v = t; v != s; v = prev[v]) {\n            int pv = prev[v];\n            size_t pr = preve[v];\n            addflow = min(addflow, g[pv][pr].u - g[pv][pr].f);\n        }\n        for (int v = t; v != s; v = prev[v]) {\n            int pv = prev[v];\n            size_t pr = preve[v];\n            size_t r = g[pv][pr].back;\n            g[pv][pr].f += addflow;\n            g[v][r].f -= addflow;\n            cost += g[pv][pr].c * addflow;\n        }\n        flow += addflow;\n    }\n    assert(flow == k);\n    printf(\"%d\\n\", cost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost', 'flow')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n        self.flow = 0\n\ndef add_edge(g, fr, to, cap, cost):\n    forward = Edge(to, len(g[to]), cap, cost)\n    backward = Edge(fr, len(g[fr]), 0, -cost)\n    g[fr].append(forward)\n    g[to].append(backward)\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    n = N * 101 + 2\n    g = [[] for _ in range(n)]\n    s = n - 2\n    t = n - 1\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        add_edge(g, s, x * 101, 1, 0)\n\n    for i in range(101):\n        add_edge(g, i, t, INF, i * c)\n\n    for i in range(1, N):\n        for j in range(100):\n            add_edge(g, i * 101 + j, i * 101 + j + 1, INF, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(100):\n            for K in range(1, k + 1):\n                cost = d * (2 * K - 1)\n                add_edge(g, u * 101 + j, v * 101 + j + 1, 1, cost)\n                add_edge(g, v * 101 + j, u * 101 + j + 1, 1, cost)\n\n    flow = 0\n    cost = 0\n    while flow < k:\n        dist = [INF] * n\n        inqueue = [0] * n\n        prevv = [-1] * n\n        preve = [-1] * n\n        dq = deque()\n        dist[s] = 0\n        dq.append(s)\n        inqueue[s] = 1\n        while dq:\n            v = dq.popleft()\n            inqueue[v] = 0\n            for i, e in enumerate(g[v]):\n                if e.flow < e.cap and dist[v] + e.cost < dist[e.to]:\n                    dist[e.to] = dist[v] + e.cost\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    if not inqueue[e.to]:\n                        if dq and dist[e.to] < dist[dq[0]]:\n                            dq.appendleft(e.to)\n                        else:\n                            dq.append(e.to)\n                        inqueue[e.to] = 1\n        if dist[t] == INF:\n            break\n        addflow = k - flow\n        v = t\n        while v != s:\n            pv = prevv[v]\n            pe = preve[v]\n            addflow = min(addflow, g[pv][pe].cap - g[pv][pe].flow)\n            v = pv\n        v = t\n        while v != s:\n            pv = prevv[v]\n            pe = preve[v]\n            e = g[pv][pe]\n            e.flow += addflow\n            g[v][e.rev].flow -= addflow\n            cost += e.cost * addflow\n            v = pv\n        flow += addflow\n\n    # assert flow == k\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.0040289857424796e-05, 0.0, 0.0, -5.435795901576057e-05, -0.008241808973252773, -0.0005546461907215416, -0.0019378946162760258, -0.001602795091457665, -3.576278118089249e-07, -2.3841855067985307e-07, -1.7881377516459906e-06, -0.0007160721579566598, -0.007430535275489092, -2.3841855067985307e-07, -2.3841855067985307e-07, -0.02975643426179886, -0.018149960786104202, -4.565611743601039e-05, -0.00043847484630532563, -2.992108420585282e-05, -6.318072337307967e-06, -4.768370445162873e-07, -1.1920922133867862e-06, -0.38688161969184875, 0.0, 0.0, -8.344646857949556e-07, -1.4305104514278355e-06, -0.0071620154194533825, -5.602820692729438e-06, -1.0132738680113107e-05, -2.3841855067985307e-07, -0.04860084131360054, -3.576278118089249e-07, 0.0, -2.861018856492592e-06, -1.1920928244535389e-07, 0.0, -5.722029527532868e-06, -0.20144160091876984, -2.145764938177308e-06, -0.0015034097013995051, -0.0001546025014249608, -1.5497195136049413e-06, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -0.00043