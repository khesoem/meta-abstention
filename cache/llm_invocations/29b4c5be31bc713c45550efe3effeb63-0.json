{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n// Variant 4: Use struct Edge and vector<Edge> graph, iterative DFS\n#include<bits/stdc++.h>\nusing namespace std;\n#define pii pair<int,int>\n#define mp make_pair\n#define inf 100000000\n#define nn 6000\n\nnamespace mcmf {\n    struct Edge {\n        int to, rev, cap, cost;\n    };\n    vector<Edge> g[nn];\n    void add_edge(int x, int y, int c, int w) {\n        g[x].push_back({y, (int)g[y].size(), c, w});\n        g[y].push_back({x, (int)g[x].size() - 1, 0, -w});\n    }\n\n    int dist[nn], vis[nn];\n    int prex[nn], prei[nn];\n    void spfa(int s) {\n        memset(dist, 0x3f, sizeof dist);\n        memset(vis, 0, sizeof vis);\n        prex[s] = -1;\n        queue<int> q;\n        q.push(s);\n        dist[s] = 0;\n        vis[s] = 1;\n        while (!q.empty()) {\n            int x = q.front(); q.pop();\n            vis[x] = 0;\n            for (int i = 0; i < (int)g[x].size(); ++i) {\n                Edge &e = g[x][i];\n                if (e.cap == 0) continue;\n                int nd = dist[x] + e.cost;\n                if (dist[e.to] > nd) {\n                    dist[e.to] = nd;\n                    prex[e.to] = x;\n                    prei[e.to] = i;\n                    if (!vis[e.to]) {\n                        vis[e.to] = 1;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n    }\n\n    int tot = 0;\n    int augment(int s, int t) {\n        // Iterative DFS to find augmenting flow\n        int flow = inf;\n        int x = t;\n        while (prex[x] != -1) {\n            int p = prex[x];\n            int i = prei[x];\n            flow = min(flow, g[p][i].cap);\n            x = p;\n        }\n        x = t;\n        while (prex[x] != -1) {\n            int p = prex[x];\n            int i = prei[x];\n            Edge &e = g[p][i];\n            e.cap -= flow;\n            g[x][e.rev].cap += flow;\n            x = p;\n        }\n        return flow;\n    }\n\n    pii solve(int s, int t) {\n        int ans = 0;\n        tot = 0;\n        while (1) {\n            spfa(s);\n            if (dist[t] > 1e9) break;\n            int f = augment(s, t);\n            tot += f * dist[t];\n            ans += f;\n        }\n        return mp(ans, tot);\n    }\n};\n\nint n, m, s = nn - 1, t = nn - 2;\nint k, c, d;\nint get(int x, int tim) {\n    return tim * 52 - 52 + x;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int kk = k;\n    while (k--) {\n        int x;\n        scanf(\"%d\", &x);\n        mcmf::add_edge(s, get(x, 1), 1, 0);\n    }\n    k = kk;\n    while (m--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n        for (int i = 1; i < 100; i++)\n            for (int j = 1; j <= k; j++)\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n        swap(x, y);\n        for (int i = 1; i < 100; i++)\n            for (int j = 1; j <= k; j++)\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n    }\n    for (int i = 1; i < 100; i++) {\n        for (int j = 1; j <= n; j++)\n            mcmf::add_edge(get(j, i)