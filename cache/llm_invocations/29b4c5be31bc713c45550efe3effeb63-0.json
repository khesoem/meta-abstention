 flow\n\n    def solve(self, s, t):\n        ans = 0\n        self.tot = 0\n        while True:\n            self.spfa(s)\n            if self.dist[t] >= INF_DIST:\n                break\n            f = self.augment(s, t)\n            self.tot += f * self.dist[t]\n            ans += f\n        return (ans, self.tot)\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    mcmf = MCMF()\n    s = NN - 1\n    t = NN - 2\n    k_orig = k\n    for _ in range(k):\n        x = next(it)\n        mcmf.add_edge(s, get(x, 1), 1, 0)\n    k = k_orig\n    for _ in range(m):\n        x = next(it); y = next(it)\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        x, y = y, x\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            mcmf.add_edge(get(j, i), get(j, i + 1), INF_CAP, 0)\n        mcmf.add_edge(get(1, i), t, INF_CAP, c * (i - 1))\n    result = mcmf.solve(s, t)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.0002138386043952778, -2.3841855067985307e-07, -4.768370445162873e-07, -0.00030417583184316754, -0.0017654799157753587, 0.0, -1.1920922133867862e-06, -9.536738616588991e-07, 0.0, -1.1920928244535389e-07, 0.0, -3.611976353568025e-05, -0.007444024085998535, -0.4740883409976959, -1.1920928244535389e-07, -3.564294092939235e-05, -5.960462772236497e-07, -1.728519782773219e-05, -0.0009117737063206732, 0.0, -0.04147554188966751, -0.3923119902610779, -2.3007127310847864e-05, -6.007967749610543e-05, 0.0, -2.1576648578047752e-05, -0.0005566716426983476, -0.251932293176651, -4.410734163684538e-06, -5.9