lose();\n  }\n\n  public static void main(String[] args) {\n    solve(new InputReader(System.in), new PrintWriter(System.out));\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass InputReader:\n    def __init__(self, in_stream):\n        self.reader = in_stream\n        self.tokenizer = None\n    \n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            line = self.reader.readline()\n            if not line:\n                raise RuntimeError(\"No more input\")\n            self.tokenizer = deque(line.strip().split())\n        return self.tokenizer.popleft()\n    \n    def nextInt(self):\n        return int(self.next())\n\ndef solve(in_reader, out):\n    input_str = in_reader.next()\n    count = 1\n    result = 0\n    for i in range(1, len(input_str) + 1):\n        if i < len(input_str) and input_str[i] == input_str[i - 1]:\n            count += 1\n        else:\n            if count % 2 == 0:\n                result += 1\n            count = 1\n    out.println(result)\n    out.close()\n\nif __name__ == \"__main__\":\n    class PrintWriter:\n        def __init__(self, out_stream):\n            self.out = out_stream\n        \n        def println(self, value):\n            self.out.write(str(value) + \"\\n\")\n            self.out.flush()\n        \n        def close(self):\n            self.out.close()\n    \n    solve(InputReader(sys.stdin), PrintWriter(sys.stdout))\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.606540359323844e-05, -8.344646857949556e-07, 0.0, -0.00021145492792129517, -0.00016234986833296716, -0.6931523084640503, -0.2813419699668884, -0.0636962279677391, -8.344646857949556e-07, -0.03441464155912399, -0.011767731979489326, -0.004625929053872824, -3.564294092939235e-05, -7.152555099310121e-07, -2.145764938177308e