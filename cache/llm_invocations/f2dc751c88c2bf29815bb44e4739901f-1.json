* 100 + j + 1\n            for k_val in range(1, 21):\n                cost = c + (k_val * k_val - (k_val-1) * (k_val-1)) * d_val\n                add(idx1, idx2, 1, cost)\n        \n        # Backward direction\n        for j in range(1, 100):\n            idx1 = (v-1) * 100 + j\n            idx2 = (u-1) * 100 + j + 1\n            for k_val in range(1, 21):\n                cost = c + (k_val * k_val - (k_val-1) * (k_val-1)) * d_val\n                add(idx1, idx2, 1, cost)\n    \n    print(min_cost_flow(s, t))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021181246847845614, -9.536738616588991e-07, -2.3841855067985307e-07, -0.0020888668950647116, -0.0023272354155778885, -8.344646857949556e-07, -0.0017071687616407871, -0.00017629499780014157, -7.152555099310121e-07, -0.00038235029205679893, -0.008624921552836895, -0.17851197719573975, -0.31209054589271545, -4.1483970562694594e-05, -1.5497195136049413e-06, -1.3154377937316895, -1.1920922133867862e-06, -0.001935277134180069, -0.007606707978993654, -1.1920922133867862e-06, -2.3841855067985307e-07, -6.198863957251888e-06, 0.0, -1.6689286894688848e-06, -5.960462772236497e-07, -1.9073468138230965e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -0.12782108783721924, -2.3841855067985307e-07, -0.15106436610221863, 0.0, -4.768370445162873e-07, 0.0, 0.0, 0.0, -4.529942543740617e-06, -7.152531907195225e-06, -0.00011538793478393927, -1.0728830375228426e-06, -8.344646857949556e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -0.00025876989820972085, -3.576278118089249e-07, -7.581423415103927e-05, -8.4638240878121e-06, -2.2291887944447808e-05, -4.768370445162873e-07, -2.3245540432981215e-05, -3.576278118089249e-07, -7.152531907195225e-06, -0.13654442131519318, -3.576272320060525e-06, -0.7013753056526184, -0.07619376480579376, -0.5262843370437622, -0.20117296278476715, -1.0251946150674485e-05, -2.3841855067985307e-07, -0.000548331590835005, -