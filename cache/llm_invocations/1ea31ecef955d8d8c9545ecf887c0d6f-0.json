][K-1]\n        for j in range(K-2, -1, -1):\n            S[i-1][j] = A[i-1][j] * S[i-1][j+1]\n        \n        for j in range(K):\n            A[i][j] = S[i-1][j]\n            if j:\n                A[i][j] = A[i][j] * P[i-1][j-1]\n    \n    # Initialize result matrix as identity\n    res = Matrix()\n    for i in range(K + 1):\n        res.m[i][i] = 1\n    \n    x = 0\n    # Process base_k digits from most significant to least\n    for i in range(len(base_k) - 1, -1, -1):\n        for j in range(base_k[i]):\n            res = res * A[i][x]\n            x = (x + 1) % K\n    \n    # Sum up the last column\n    ans = 0\n    for i in range(K + 1):\n        ans = (ans + res.m[i][K]) % MOD\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021336186910048127, -9.536738616588991e-07, -1.1920928244535389e-07, -0.401128888130188, -0.00016735584358684719, -1.1086402082582936e-05, -0.07011373341083527, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.00010895135346800089, 0.0, -4.768360213347478e-06, 0.0, -7.152555099310121e-07, -7.748573807475623e-06, -2.0265558760002023e-06, -3.576278118089249e-07, -0.0009127265075221658, -0.07117486745119095, -0.0562560148537159, -5.304672595229931e-05, -1.0728830375228426e-06, -0.01663973368704319, -1.0728830375228426e-06, -0.005980454385280609, -8.106198947643861e-06, -0.31391817331314087, -2.0265558760002023e-06, -0.07893171906471252, -7.986990567587782e-06, -1.1920928244535389e-07, -0.1426834613084793, -1.4781842764932662e-05, -5.364403477869928e-06, -1.4305104514278355e-06, -2.3841855067985307e-07, 0.0, -1.9073468138230965e-06, 0.0, -1.1920922133867862e-06, -0.002188075101003051, -2.3841855067985307e-07, -7.152555099310121e-07, -2.3841855067985307e-07, 0.0, -2.753696753643453e-05, -7.533743337262422e-05, -1.1920922133867862e-06, -0.08911623060703278, -0.15314172208309174, -0.0002996472467202693, -0.0001237