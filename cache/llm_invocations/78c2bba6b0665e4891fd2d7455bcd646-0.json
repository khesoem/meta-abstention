= left_part.length) {\n            left_sums.add(acc % m);\n        } else {\n            computeLeft(left_part, idx + 1, (acc + left_part[idx]) % m, m, left_sums);\n            computeLeft(left_part, idx + 1, acc, m, left_sums);\n        }\n    }\n    \n    private static void computeRight(int[] right_part, int idx, int acc, int m, List<Integer> right_sums) {\n        if (idx == right_part.length) {\n            right_sums.add(acc % m);\n        } else {\n            computeRight(right_part, idx + 1, (acc + right_part[idx]) % m, m, right_sums);\n            computeRight(right_part, idx + 1, acc, m, right_sums);\n        }\n    }\n    \n    private static int binarySearchLeft(List<Integer> list, int target) {\n        int left = 0;\n        int right = list.size();\n        \n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) < target) {\n                left = mid + 1;\n            } else {\n                right = mid;\n            }\n        }\n        \n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011014331539627165, -1.311301275563892e-06, -4.768370445162873e-07, -0.000436925794929266, -1.847726889536716e-05, -0.0019298041006550193, -0.16601605713367462, -1.7881377516459906e-06, -9.536738616588991e-07, -0.0004528927383944392, -1.3589766240329482e-05, -9.536738616588991e-07, -0.0012630588607862592, -4.768370445162873e-07, -1.3112935448589269e-05, -1.311301275563892e-06, -1.1920922133867862e-06, -4.768370445162873e-07, -7.354942499659956e-05, -7.152555099310121e-07, -3.576278118089249e-07, -1.6689286894688848e-06, -4.327203714638017e-05, -0.6354472637176514, -1.1920928244535389e-07, -2.3841855067985307e-07, -8.4638240878121e-06, -4.410734163684538e-06, -1.7881377516459906e-06, -4.0531076592742465e-06, -0.523127555847168, -3.933898824470816e-06, -0.0017034795600920916, -2.3841855067985307e-07, -1.1920928244535389e-07, -8.702239938429557e-06, -7.