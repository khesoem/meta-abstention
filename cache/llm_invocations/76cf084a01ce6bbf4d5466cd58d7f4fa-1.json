\n\t\t\t\tll cur=q.top();\n\t\t\t\tint d=cur>>32, u=cur;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u])\n\t\t\t\t\tcontinue;\n\t\t\t\tfor(int i=0; i<SZ(adj[u]); ++i) {\n\t\t\t\t\tEdge &e=adj[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif (e.cap<=e.f)\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\tint nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif (prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push(((ll)nprio<<32)+v);\n\t\t\t\t\t\tprevnode[v]=u;\n\t\t\t\t\t\tprevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INT_MAX)\n\t\t\t\tbreak;\n\t\t\tfor(int i=0; i<n; ++i)\n\t\t\t\tpot[i]+=prio[i];\n\t\t\tint df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tEdge &e=adj[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df;\n\t\t\t\tadj[v][e.rev].f-=df;\n\t\t\t\tflowCost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn make_pair(flow, flowCost);\n\t}\n};\n\nint n,m,k,c,d;\n \nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tMCF nt(6+107*n);\n\tfore(_,0,k){\n\t\tint x;\n\t\tscanf(\"%d\",&x);x--;\n\t\tnt.addEdge(0,1+x,1,0);\n\t}\n\tfore(_,0,m){\n\t\tint x,y;\n\t\tscanf(\"%d%d\",&x,&y);x--;y--;\n\t\tfore(i,0,105){\n\t\t\tfore(j,0,51){\n\t\t\t\tnt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n\t\t\t\tnt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n\t\t\t}\n\t\t}\n\t}\n\tfore(i,0,105)fore(j,0,n)nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n\tfore(i,0,105)nt.addEdge(1+i*n,1+105*n,51,0);\n\tauto ans=nt.minCostFlow(0,1+105*n);\n\tprintf(\"%d\\n\",ans.snd);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.u = [0] * n\n        self.v = [0] * n\n        self.prio = [float('inf')] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n        self.adj = [[] for _ in range(n)]\n    \n    def addEdge(self, s, t, cap, cost):\n        a = {'to': t, 'f': 0, 'cap': cap, 'cost': cost, 'rev': len(self.adj[t])}\n        b = {'to': s, 'f': 0, 'cap': 0, 'cost': -cost, 'rev': len(self.adj[s])}\n        self.adj[s].append(a)\n        self.adj[t].append(b)\n    \n    def minCostFlow(self, s, t):\n        flow = 0\n        flowCost = 0\n        INF = float('inf')\n        \n        while flow < INF:\n            # Reset priority queue\n            pq = []\n            heapq.heappush(pq, (0, s))\n            \n            # Reset priorities\n            for i in range(self.n):\n                self.prio[i] = float('inf')\n            self.prio[s] = 0\n            self.curflow[s] = INF\n            \n            while pq:\n                d, u = heapq.heappop(pq)\n                if d != self.prio[u]:\n                    continue\n                \n                for i, e in enumerate(self.adj[u]):\n                    v = e['to']\n                    if e['cap'] <= e['f']:\n                        continue\n                    \n                    nprio = self.prio[u] + e['cost'] + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nprio:\n                        self.prio[v] = nprio\n                        heapq.heappush(pq, (nprio, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e['cap'] - e['f'])\n            \n            if self.prio[t] == float('inf'):\n                break\n            \n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            \n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            \n            v = t\n            while v != s:\n                e = self.adj[self.prevnode[v]][self.prevedge[v]]\n                e['f'] += df\n                rev_edge = self.adj[v][e['rev']]\n                rev_edge['f'] -= df\n                flowCost += df * e['cost']\n                v = self.prevnode[v]\n        \n        return (flow, flowCost)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    nt = MCF(6 + 107 * n)\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        nt.addEdge(0, 1 + x, 1, 0)\n    \n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for i in range(105):\n            for j in range(51):\n                nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1))\n                nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1))\n    \n    for i in range(105):\n        for j in range(n):\n            nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c)\n    \n    for i in range(105):\n        nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0)\n    \n    ans = nt.minCostFlow(0, 1 + 105 * n)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00025078488397412, -1.311301275563892e-06, -1.1920928244535389e-07, -5.23315102327615e-05, -0.3135400414466858, -0.016214288771152496, -0.004653339274227619, -0.030046602711081505, -0.4288191497325897, -0.940954864025116, -0.6332788467407227, -8.22540732769994e-06, -1.3589766240329482e-05, -1.1920928244535389e-07, -0.3646697998046875, -6.0794889577664435e-05, -1.3112935448589269e-05, -2.3841855067985307e-07, -6.556489552167477e-06, -2.3841855067985307e-07, 0.0, -1.2636104656849056e-05, -4.6491513785440475e-06, -4.291525328881107e-06, -7.152555099310121e-07, -3.576278118089249e-07, 0.0, -2.622600959512056e-06, -2.3841830625315197e-06, -1.9788545614574105e-05, -0.06664568185806274, -5.245195097813848e-06, -0.006783314980