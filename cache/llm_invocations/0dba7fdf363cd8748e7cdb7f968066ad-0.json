{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconstexpr int MAXN = 55;\nconstexpr int MAXT = 2 * MAXN;\nconstexpr int MAXP = MAXT * MAXN;\nconstexpr int MAXE = 5 * MAXT * MAXN * MAXN;\nconstexpr int INF = 1000000000;\n\nstruct Edge {\n    int to, cap, cost, nxt;\n};\n\narray<Edge, MAXE> edges;\narray<int, MAXP> head{};\narray<int, MAXP> dist{};\narray<bool, MAXP> used{};\n\nint ecnt = 1;\nint src = 1, sink = 2, nodeCnt = 2;\nint n, m, k, c, d;\nint people[MAXN];\nint id[MAXN][MAXT];\nint answer;\n\ninline void addEdge(int u, int v, int cost, int cap) {\n    ++ecnt;\n    edges[ecnt] = {v, cap, cost, head[u]};\n    head[u] = ecnt;\n    ++ecnt;\n    edges[ecnt] = {u, 0, -cost, head[v]};\n    head[v] = ecnt;\n}\n\nbool spfa() {\n    fill(dist.begin(), dist.end(), INF);\n    fill(used.begin(), used.end(), false);\n    deque<int> q;\n    dist[src] = 0;\n    q.push_back(src);\n    used[src] = true;\n    while (!q.empty()) {\n        int x = q.front();\n        q.pop_front();\n        used[x] = false;\n        for (int e = head[x]; e; e = edges[e].nxt) {\n            if (!edges[e].cap) continue;\n            int y = edges[e].to;\n            if (dist[y] > dist[x] + edges[e].cost) {\n                dist[y] = dist[x] + edges[e].cost;\n                if (!used[y]) {\n                    used[y] = true;\n                    q.push_back(y);\n                }\n            }\n        }\n    }\n    return dist[sink] < INF;\n}\n\nint augment(int x, int flow) {\n    if (x == src) return flow;\n    used[x] = true;\n    int rem = flow;\n    for (int e = head[x]; e; e = edges[e].nxt) {\n        int y = edges[e].to;\n        if (used[y] || edges[e ^ 1].cap == 0 || dist[x] < dist[y] + edges[e ^ 1].cost) continue;\n        int got = augment(y, min(rem, edges[e ^ 1].cap));\n        if (got) {\n            rem -= got;\n            edges[e ^ 1].cap -= got;\n            edges[e].cap += got;\n            if (rem == 0) break;\n        }\n    }\n    return flow - rem;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    for (int i = 1; i <= k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        ++people[x];\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= k + m + 2; ++j) {\n            id[i][j] = ++nodeCnt;\n            if (i == 1) addEdge(id[i][j], sink, c * (j - 1), INF);\n            if (j > 1) addEdge(id[i][j - 1], id[i][j], 0, INF);\n        }\n        if (people[i]) addEdge(src, id[i][1], 0, people[i]);\n    }\n    for (int i = 1; i <= m; ++i) {\n        int a, b;\n        scanf(\"%d%d\", &a, &b);\n        for (int j = 1; j <= k + m + 1; ++j) {\n            for (int cost = 1; cost <= 2 * k - 1; cost += 2) {\n                addEdge(id[a][j], id[b][j + 1], cost * d, 1);\n                addEdge(id[b][j], id[a][j + 1], cost * d, 1);\n            }\n        }\n    }\n    int sent = 0;\n    while (spfa()) {\n        int add = -1;\n        while (add) {\n            fill(used.begin(), used.end(), false);\n            add = augment(sink, INF);\n            sent += add;\n            answer += dist[sink] * add;\n        }\n  