t(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    people = [0] * (n + 1)\n    for _ in range(k):\n        x = next(it)\n        people[x] += 1\n\n    # Initialize head with size for maximum possible nodes (estimate)\n    max_nodes = 2 + n * (k + m + 2) + 5\n    head = [0] * (max_nodes + 1)\n    # We'll resize later if needed, but we know nodeCnt will increase.\n    # Actually we can just append to head as needed, but we need to set head[u] for new nodes.\n    # We'll use a list that we extend when nodeCnt increases.\n    # For simplicity, we'll pre-allocate a large list and then slice.\n    # But we can also use a list and append when needed. Since we know max nodes, we can allocate.\n    # Let's allocate head with size max_nodes+1 and then use it.\n    # However, nodeCnt starts at 2, and we will add nodes. We'll ensure head list is large enough.\n    # We'll use a list that we can extend dynamically.\n    # Actually, we can just use a list and append when we need to set head for a new node.\n    # But head[u] must exist for all u up to nodeCnt. So we'll maintain head as a list that we extend.\n    # We'll start with head = [0] * (nodeCnt+1) and then append as needed.\n    # Let's do that.\n    head = [0] * (nodeCnt + 1)  # indices 0,1,2\n\n    # id matrix: we'll store node numbers in a 2D list\n    id = [[0] * (k + m + 3) for _ in range(n + 1)]  # 1-indexed, j up to k+m+2\n    for i in range(1, n + 1):\n        for j in range(1, k + m + 3):  # inclusive of k+m+2\n            nodeCnt += 1\n            id[i][j] = nodeCnt\n            # extend head if needed\n            if nodeCnt >= len(head):\n                head.append(0)\n            if i == 1:\n                addEdge(id[i][j], sink, c * (j - 1), INF)\n            if j > 1:\n                addEdge(id[i][j - 1], id[i][j], 0, INF)\n        if people[i]:\n            addEdge(src, id[i][1], 0, people[i])\n\n    for _ in range(m):\n        a = next(it)\n        b = next(it)\n        for j in range(1, k + m + 2):  # j from 1 to k+m+1 inclusive\n            for cost in range(1, 2 * k, 2):  # 1,3,5,...,2k-1\n                addEdge(id[a][j], id[b][j + 1], cost * d, 1)\n                addEdge(id[b][j], id[a][j + 1], cost * d, 1)\n\n    sent = 0\n    answer = 0\n    while spfa():\n        add = -1\n        while add:\n            used = [False] * (nodeCnt + 1)\n            add = augment(sink, INF)\n            sent += add\n            answer += dist[sink] * add\n    assert sent == k\n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.1020273531321436e-05, 0.0, 0.0, -8.642300235806033e-05, -0.01820310764014721, 0.0, -1.2993727978027891e-05, -0.06495478749275208, -1.1920928244535389e-07, -1.1920928244535389e-07, -7.986990567587782e-06, -0.023264430463314056, -0.6917232275009155, 0.0, 0.0, -5.960462772236497e-07, 0.0, -3.576278118089249e-07, -0.7991774082183838, -0.029922932386398315, -0.034987132996320724, -0.12725192308425903, -1.050262451171875, -9.65590606938349e-06, -6.318072337307967e-06, -0.1272246241569519, -0.006718190852552652, -5.602820692729438e-06, -0.3873121738433838, -0.9228683710098267, -0.5750632882118225, -0.8140590786933899, -0.0027240333147346973, -0.4102947413921356, -4.410734163684538e-06, 0.0, -1.645074735279195e-05, -2.3841855067985307e-07, -3.6954811548639555e-06, -8.618460560683161e-05, -0.005576767027378082, 0.0, -0.03813895583152771, -0.008074498735368252, -2.8490614567999728e-05, -0.03152564540505409, -1.2040065485052764e-05, -0.004114615265280008, -0.000608854868914932, 0.0, -0.5903329849243164, -0.026005703955888748, -0.008614521473646164, -0.04128533601760864, -0.09635826200246811, -0.0009548871894367039, -2.276871418871451e-05, -0.9832279682159424, -0.2216564267873764, -1.0371154530730564e-05, -0.015685750171542168, -0.004058340098708868, -0.4301580488681793, 