{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MAXN = 5007;\nconst ll INF = 1e9;\nconst ll MOD = 1e9 + 7;\n\nstruct Edge {\n    int from, to;\n    ll cap, cost, flow;\n    Edge(int from, int to, ll cap, ll cost) : from(from), to(to), cap(cap), cost(cost), flow(0) {}\n};\n\nvector<Edge> e;\nvector<int> g[MAXN];\nll d[MAXN], phi[MAXN];\nint p[MAXN];\n\nvoid add_edge(int u, int v, ll cap, ll cost) {\n    g[u].push_back(e.size());\n    e.push_back({u, v, cap, cost});\n    g[v].push_back(e.size());\n    e.push_back({v, u, 0, -cost});\n}\n\nvoid fb(int s, int n) {\n    fill(phi, phi + MAXN, INF);\n    phi[s] = 0;\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < (int)e.size(); j++) {\n            Edge &ed = e[j];\n            if (ed.cap == ed.flow || phi[ed.from] == INF) continue;\n            phi[ed.to] = min(phi[ed.to], phi[ed.from] + ed.cost);\n        }\n    }\n}\n\nvoid dijk(int s) {\n    fill(d, d + MAXN, INF);\n    d[s] = 0;\n    set<pair<ll, int>> q;\n    q.insert({0, s});\n    while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i = 0; i < (int)g[v].size(); i++) {\n            int id = g[v][i];\n            Edge &ed = e[id];\n            if (ed.cap == ed.flow) continue;\n            int to = ed.to;\n            ll w = ed.cost + phi[v] - phi[to];\n            if (d[v] + w < d[to]) {\n                q.erase({d[to], to});\n                d[to] = d[v] + w;\n                p[to] = id;\n                q.insert({d[to], to});\n            }\n        }\n    }\n}\n\npair<ll, ll> mcmf(int s, int t) {\n    fb(s, 50);\n    dijk(s);\n    ll flow = 0, cost = 0;\n    while (true) {\n        if (d[t] == INF) break;\n        ll pushed = INF, sum = 0;\n        for (int cur = t; cur != s; cur = e[p[cur]].from) {\n            pushed = min(pushed, e[p[cur]].cap - e[p[cur]].flow);\n            sum += e[p[cur]].cost;\n        }\n        flow += pushed;\n        cost += pushed * sum;\n        for (int cur = t; cur != s; cur = e[p[cur]].from) {\n            e[p[cur]].flow += pushed;\n            e[p[cur] ^ 1].flow -= pushed;\n        }\n        dijk(s);\n        copy(d, d + MAXN, phi);\n    }\n    return {cost, flow};\n}\n\nvoid solve() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnt(n, 0);\n    for (int i = 0; i < k; i++) {\n        int a;\n        cin >> a;\n        cnt[--a]++;\n    }\n    for (int i = 0; i < n; i++) add_edge(5000, i, cnt[i], 0);\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        u--, v--;\n        for (int j = 0; j < 99; j++) {\n            ll cost = d;\n            for (int t = 0; t < 50; t++) {\n                add_edge(u + j * 50, v + (j + 1) * 50, 1, cost);\n                add_edge(v + j * 50, u + (j + 1) * 50, 1, cost);\n                cost += 2 * d;\n            }\n        }\n    }\n    for (int i = 0; i <= 99; i++) add_edge(0 + i * 50, 5001, INF, c * i);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < 99; j++)\n            add_edge(i + j * 50, i + (j + 1)