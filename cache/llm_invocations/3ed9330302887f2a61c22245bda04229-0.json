  sum_ = 0\n        cur = t\n        while cur != s:\n            id_ = p[cur]\n            pushed = min(pushed, e[id_].cap - e[id_].flow)\n            sum_ += e[id_].cost\n            cur = e[id_].from_\n        flow += pushed\n        cost += pushed * sum_\n        cur = t\n        while cur != s:\n            id_ = p[cur]\n            e[id_].flow += pushed\n            e[id_ ^ 1].flow -= pushed\n            cur = e[id_].from_\n        dijk(s)\n        phi = d[:]\n    return cost, flow\n\ndef solve():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    cnt = [0] * n\n    for _ in range(k):\n        a = next(it) - 1\n        cnt[a] += 1\n    for i in range(n):\n        add_edge(5000, i, cnt[i], 0)\n    for _ in range(m):\n        u = next(it) - 1\n        v = next(it) - 1\n        for j in range(99):\n            cost = d\n            for t in range(50):\n                add_edge(u + j * 50, v + (j + 1) * 50, 1, cost)\n                add_edge(v + j * 50, u + (j + 1) * 50, 1, cost)\n                cost += 2 * d\n    for i in range(100):\n        add_edge(0 + i * 50, 5001, INF, c * i)\n    for i in range(n):\n        for j in range(99):\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n    res = mcmf(5000, 5001)\n    assert res[1] == k\n    print(res[0])\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.437094270950183e-05, 0.0, -1.1920928244535389e-07, -0.0005783553933724761, -0.0015220972709357738, -1.0132738680113107e-05, -0.03044712543487549, -0.02372286096215248, -0.0011887634173035622, -0.001510670525021851, -0.01706804521381855, -2.622600959512056e-06, -1.7881377516459906e-06, -1.1920928244535389e-07, -3.814689989667386e-06, -5.483612312673358e-06, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -9.536738616588991e-07, -1.5497195136049413e-06, -0.