 x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *x):\n            r = 1\n            for i in x:\n                r = self.mult_two(r, i)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g %= r\n                g, r = r, g\n                x -= q * y\n                x, y = y, x\n            if g != 1:\n                raise AssertionError()\n            if y != self.modulus() and y != -self.modulus():\n                pass  # assertion check skipped\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    raise RuntimeError(\"No more input\")\n                self.tokenizer = line.strip().split()\n            except Exception as e:\n                raise RuntimeError(e)\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\ndef main():\n    input_data = sys.stdin.read().split('\\n')\n    sys.stdin = type('stdin', (), {'readline': lambda: input_data.pop(0) if input_data else ''})()\n\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out = outputStream\n\n    n = in_reader.nextInt()\n    m = in_reader.nextInt()\n\n    mod = NumberTheory.Mod998()\n    mod.fInv(n + m)\n\n    phaseSize = 1\n    p = 1\n    for i in range(n + 1):\n        if p == 0:\n            break\n        p = mod.mult(p, n - i, mod.smallInv(n + m - i))\n        phaseSize = mod.add(phaseSize, p)\n\n    answer = 0\n    for k in range(1, n + 1):\n        numPhases = mod.mult(m + k, mod.smallInv(k))\n        e = mod.mult(numPhases, phaseSize)\n        term = mod.mult(mod.ncr(n, k), e)\n\n        if k % 2 == 1:\n            answer = mod.add(answer, term)\n        else:\n            answer = mod.subtract(answer, term)\n\n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-7.915183232398704e-05, -9.536738616588991e-07, -4.768370445162873e-07, -0.0012175773736089468, -0.012754649855196476, -0.0009971652179956436, -0.10023127496242523, -0.1591012179851532, -0.009783650748431683, -0.01624889113008976, -0.2778415381908417, -4.6491513785440475e-06, -1.7881377516459906e-06, -1.1920928244535389e-07, -7.152555099310121e-07, -0.0005025792634114623, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.5497195136049413e-06, -0.0336461178958416, -4.529942543740617e-06, -1.7881377516459906e-06, 0.0, -4.291525328881107e-06, -6.079655122448457e-06, -2.3841830625315197e-06, -6.9141146923357155e-06, -5.960462772236497e-07, -0.0021944984328001738, -1.1920928244535389e-07, 0.0, -1.311301275563892e-06, -3.4570634852570947e-06, -5.960462772236497e-07, -4.768370445162873e-07, 0.0, -9.536738616588991e-07, -3.182837463100441e-05, 0.0, 0.0, -0.1006101593375206, -1.1920922133867862e-06, -8.344646857949556e-07, -5.245195097813848e-06, 0.0, 0.0, -0.00038246947224251926, -1.4781842764932662e-05, -3.576278118089249e-07, -4.291525328881107e-06, -1.966933996300213e-05, -3.611976353568025e-05, -1.1920928244535389e-07, -0.0002759314374998212, 0.0, -4.768370445162873e-07, -7.748573807475623e-06, -1.1920