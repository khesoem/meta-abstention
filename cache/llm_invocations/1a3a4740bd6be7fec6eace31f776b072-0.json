    if combined > answer:\n            answer = combined\n\nprint(answer)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        int n = scanner.nextInt();\n        int m = scanner.nextInt();\n        \n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = scanner.nextInt();\n        }\n        \n        int[] left_part = new int[n / 2];\n        System.arraycopy(a, 0, left_part, 0, n / 2);\n        \n        int[] right_part = new int[n - n / 2];\n        System.arraycopy(a, n / 2, right_part, 0, n - n / 2);\n        \n        List<Integer> a1_list = generateLeftSums(left_part, left_part.length, m);\n        List<Integer> a2_list = generateRightSums(right_part, 0, right_part.length, m);\n        \n        List<Integer> a1_sorted = new ArrayList<>(new HashSet<>(a1_list));\n        Collections.sort(a1_sorted);\n        \n        int answer = 0;\n        \n        for (int value : a2_list) {\n            int needed = m - value;\n            int index = Collections.binarySearch(a1_sorted, needed);\n            if (index < 0) {\n                index = -index - 1;\n            }\n            if (index > 0) {\n                int combined = a1_sorted.get(index - 1) + value;\n                if (combined > answer) {\n                    answer = combined;\n                }\n            }\n        }\n        \n        System.out.println(answer);\n    }\n    \n    public static List<Integer> generateLeftSums(int[] arr, int length, int mod) {\n        List<Integer> sums = new ArrayList<>();\n        backtrack(arr, 0, 0, length, mod, sums);\n        return sums;\n    }\n    \n    public static void backtrack(int[] arr, int idx, int current, int length, int mod, List<Integer> sums) {\n        if (idx == length) {\n            sums.add(current % mod);\n        } else {\n            backtrack(arr, idx + 1, current + arr[idx], length, mod, sums);\n            backtrack(arr, idx + 1, current, length, mod, sums);\n        }\n    }\n    \n    public static List<Integer> generateRightSums(int[] arr, int start, int length, int mod) {\n        List<Integer> sums = new ArrayList<>();\n        backtrack(arr, start, 0, start + length, mod, sums);\n        return sums;\n    }\n    \n    public static void backtrack(int[] arr, int idx, int current, int end, int mod, List<Integer> sums) {\n        if (idx == end) {\n            sums.add(current % mod);\n        } else {\n            backtrack(arr, idx + 1, current + arr[idx], end, mod, sums);\n            backtrack(arr, idx + 1, current, end, mod, sums);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.402622577501461e-05, -1.7881377516459906e-06, -1.1920928244535389e-07, -3.480850500636734e-05, -2.95634672511369e-05, -0.0017028844449669123, -0.06638245284557343, -3.099436753473128e-06, -1.0728830375228426e-06, -0.00015662873920518905, -0.00017975145601667464, -0.0001597276859683916, -0.029808619990944862, -2.50339189733495e-06, -0.048921920359134674, -0.005239327438175678, -1.0728830375228426e-06, -2.3841855067985307e-07, -1.2397689715726301e-05, -9.536738616588991e-07, -4.768370445162873e-07, -3.3378546504536644e-06, -5.280832192511298e-05, -0.22831964492797852, -1.6689286894688848e-06, -2.3841855067985307e-07, -2.8729025871143676e-05, -1.7881377516459906e-06, -5.960462772236497e-07, -8.583032467868179e-06, -0.6326057314872742, -2.9802276912960224e-06, -6.305972783593461e-05, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1205610462639015e-05, -7.152555099310121e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -2.264974000354414e-06, -2.0265558760002023e-06, -1.07287787614041e-05, -1.9311717551317997e-05, -3.576278118089249e-07, -6.43728071736