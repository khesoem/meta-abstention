w, cost):\n        self.u = u\n        self.v = v\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\n    def rem(self):\n        return self.cap - self.flow\n\nnodes = MAXN\ng = [[] for _ in range(MAXN)]\ne = []\n\ndef add_edge(u, v, cap, cost):\n    if DEBUG:\n        dem = \"SRC\" if u == SRC else str(u)\n        pen = \"SRC\" if v == SRC else str(v)\n        print(f\"add edge: {dem} {pen} {cap} {cost}\")\n    g[u].append(len(e))\n    e.append(Edge(u, v, cap, 0, cost))\n    g[v].append(len(e))\n    e.append(Edge(v, u, 0, 0, -cost))\n\ndist = [0] * MAXN\nmncost = 0\npre = [-1] * MAXN\ncap = [0] * MAXN\nmxflow = 0\nin_queue = [False] * MAXN\n\ndef flow(s, t):\n    global mxflow, mncost\n    for i in range(nodes):\n        in_queue[i] = False\n    mxflow = 0\n    mncost = 0\n    while True:\n        for i in range(nodes):\n            dist[i] = INFCOSTO\n        dist[s] = 0\n        for i in range(N):\n            pre[i] = -1\n        pre[s] = 0\n        for i in range(N):\n            cap[i] = 0\n        cap[s] = INFFLUJO\n        q = deque([s])\n        in_queue[s] = True\n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            for i in g[u]:\n                E = e[i]\n                if E.rem() > 1e-9 and dist[E.v] > dist[u] + E.cost + 1e-9:\n                    dist[E.v] = dist[u] + E.cost\n                    pre[E.v] = i\n                    cap[E.v] = min(cap[u], E.rem())\n                    if not in_queue[E.v]:\n                        q.append(E.v)\n                        in_queue[E.v] = True\n        if pre[t] < 0:\n            break\n        mxflow += cap[t]\n        mncost += cap[t] * dist[t]\n        v = t\n        while v != s:\n            i = pre[v]\n            e[i].flow += cap[t]\n            e[i ^ 1].flow -= cap[t]\n            v = e[i].u\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    n, m, k, c, d = map(int, input_data[0:5])\n    MAXT = n + k\n    if DEBUG:\n        print(\"MAXT:\", MAXT)\n    a = list(map(int, input_data[5:5 + k]))\n    idx = 5 + k\n    for i in range(k):\n        a[i] -= 1\n        add_edge(SRC, a[i] * MAXT, 1, 0)\n    for j in range(MAXT):\n        add_edge(j, SNC, k, 0)\n    for _ in range(m):\n        x = int(input_data[idx])\n        y = int(input_data[idx + 1])\n        idx += 2\n        x -= 1\n        y -= 1\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1))\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1))\n    for i in range(n):\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c)\n    flow(SRC, SNC)\n    if DEBUG:\n        print(\"mncost:\", mncost, \"mxflow:\", mxflow)\n    print(mncost)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.816591434879228e-05, -0.00030590701499022543, 0.0, -8.077528764260933e-05, -0.023745255544781685, -7.941850526549388e-06, -0.00030197695014066994, -0.0310375839471817, -0.0002075933152809739, 0.0, -1.676292231422849e-05, -0.004807230085134506, -0.09167677164077759, -0.002221745438873768, -0.20141518115997314, -1.1472419600977446e-06, -0.12704214453697205, -0.012083861045539379, -6.20603168499656e-05, -0.0017809720011427999, -1.1472419600977446e-06, -3.011373155459296e-05, -0.10020720958709717, -4.320199877838604e-07, -1.9743012671824545e-05, -1.9361264946837764e-07, -5.676981345459353e-06, -3.128163257315464e-07, -0.0007065945537760854, -0.00027444821898825467, -7.636475493200123e-05, -9.088346359931165e-07, 0.0, -6.611323624383658e-05, -4.0126840758603066e-05, -3.128163257315464e-07, -1.1756367712223437e-05, -1.9361264946837764e-07, -3.7697225252486533e-06, -4.723352049040841e-06, -3.12816325