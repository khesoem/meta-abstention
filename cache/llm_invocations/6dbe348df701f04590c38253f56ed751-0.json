d in range(4):\n                nx = x + dx[d]\n                ny = y + dy[d]\n                if sc[nx][ny] != -1 and dd[nx][ny] > dd[x][y] + 1 and dd[x][y] + 1 <= ir[nx][ny]:\n                    dd[nx][ny] = dd[x][y] + 1\n                    q.append((nx, ny))\n\n    # call wk for each cell with students\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if sc[i][j] > 0:\n                wk(i, j)\n\n    print(kuhn())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.12716976320371e-05, 0.0, 0.0, -0.0005673944251611829, -0.018358901143074036, 0.0, -4.6491513785440475e-06, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -2.2649508537142538e-05, -0.004401519428938627, -1.1920928244535389e-07, -1.0728830375228426e-06, -3.576278118089249e-07, 0.0, -0.0015028145862743258, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.490105023549404e-05, 0.0, 0.0, 0.0, -4.172316494077677e-06, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -1.311301275563892e-06, -3.576278118089249e-07, 0.0, -4.768370445162873e-07, -2.3841855067985307e-07, -0.000912250077817589, -3.576278118089249e-07, -0.00043561504571698606, -3.564294092939235e-05, -4.291525328881107e-06, -0.0025102554354816675, -1.1920928244535389e-07, -5.960446742392378e-06, 0.0, -5.960446742392378e-06, -1.1920928244535389e-07, -2.753696753643453e-05, -8.344646857949556e-07, 0.0, -0.000912250077817589, -1.1920928244535389e-07, 0.0, 0.0, -0.0001401803019689396, -7.867782187531702e-06, -2.264974000354414e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -3.933898824470816e-06, 0.0, -2.9802276912960224e-06, -0.00019667598826345056, 0.0, 0.0, 0.0, -0.04858812317252159, -7.152555099310121e-07, -0.023249290883541107, -0.7165564894676208, -7.760223525110632e-05, -0.2521021068096161, -2.0503786799963564e-05, -1.1101861000061035, -0.00018165845540352166, -0.04026035219430