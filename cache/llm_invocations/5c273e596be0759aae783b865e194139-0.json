t(pe[v]);\n                e.cap -= f;\n                g.get(v).get(e.rev).cap += f;\n            }\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int source = 0;\n        int target = n * MAX_T + 1;\n        g = new ArrayList<>(target + 1);\n        for (int i = 0; i <= target; ++i) {\n            g.add(new ArrayList<>());\n        }\n        d = new int[target + 1];\n        p = new int[target + 1];\n        pe = new int[target + 1];\n        \n        // Connect all nodes' last time layer to sink\n        for (int i = 1; i <= n; ++i) {\n            link((i - 1) * MAX_T + MAX_T, target, 100, 0);\n        }\n        \n        // Connect source to initial positions\n        for (int i = 0; i < k; ++i) {\n            int v = sc.nextInt();\n            link(source, (v - 1) * MAX_T + 1, 1, 0);\n        }\n        \n        // Time progression edges\n        for (int i = 1; i <= n; ++i) {\n            for (int t = 1; t < MAX_T; ++t) {\n                link((i - 1) * MAX_T + t, (i - 1) * MAX_T + t + 1, 100, c);\n            }\n        }\n        \n        // Bidirectional edges with capacity splitting\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int t = 1; t < MAX_T; ++t) {\n                for (int j = 1; j <= 20; ++j) {\n                    int cost = c + (j * j - (j - 1) * (j - 1)) * d;\n                    link((u - 1) * MAX_T + t, (v - 1) * MAX_T + t + 1, 1, cost);\n                    link((v - 1) * MAX_T + t, (u - 1) * MAX_T + t + 1, 1, cost);\n                }\n            }\n        }\n        \n        System.out.println(minCost(source, target));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", 