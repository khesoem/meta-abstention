{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define mp make_pair\n#define ft first\n#define sd second\n\nusing namespace std;\ntypedef long long ll;\ntypedef pair<int,int> pii;\nconst int INF = 0x3f3f3f3f;\nconst int MX = 6555;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge() {}\n    Edge(int t, int c, int co, int r): to(t), cap(c), cost(co), rev(r) {}\n};\n\nstruct MCMF {\n    int N, H[MX+5], D[MX+5], P[MX+5], E[MX+5];\n    vector<Edge> adj[MX+5];\n    void init(int n) {\n        N = n;\n        for(int i=0;i<=n;i++) adj[i].clear();\n    }\n    void add_edge(int from, int to, int cap, int cost) {\n        adj[from].push_back(Edge(to, cap, cost, adj[to].size()));\n        adj[to].push_back(Edge(from, 0, -cost, adj[from].size()-1));\n    }\n    int min_cost(int s, int t, int f) {\n        int flow = 0, ans = 0;\n        fill(H, H+N+1, 0);\n        while(f) {\n            fill(D, D+N+1, INF);\n            priority_queue<pii, vector<pii>, greater<pii>> pq;\n            D[s] = 0; pq.push(mp(0, s));\n            while(!pq.empty()) {\n                pii cur = pq.top(); pq.pop();\n                int v = cur.sd;\n                if(D[v] < cur.ft) continue;\n                for(int i=0;i<adj[v].size();i++) {\n                    Edge &e = adj[v][i];\n                    if(e.cap > 0 && D[e.to] > D[v] + e.cost + H[v] - H[e.to]) {\n                        D[e.to] = D[v] + e.cost + H[v] - H[e.to];\n                        P[e.to] = v;\n                        E[e.to] = i;\n                        pq.push(mp(D[e.to], e.to));\n                    }\n                }\n            }\n            if(D[t] == INF) break;\n            for(int i=0;i<=N;i++) H[i] += D[i];\n            int add = f;\n            for(int v=t; v!=s; v=P[v]) add = min(add, adj[P[v]][E[v]].cap);\n            f -= add; flow += add; ans += add * H[t];\n            for(int v=t; v!=s; v=P[v]) {\n                Edge &e = adj[P[v]][E[v]];\n                e.cap -= add;\n                adj[v][e.rev].cap += add;\n            }\n        }\n        return ans;\n    }\n} mcmf;\n\nint main() {\n#ifndef ONLINE_JUDGE\n    freopen(\"in.in\", \"r\", stdin);\n    freopen(\"out.out\", \"w\", stdout);\n#endif\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    mcmf.init(n*(n+55)+2);\n    for(int i=0;i<k;i++) {\n        int u; cin >> u;\n        mcmf.add_edge(0, u, 1, 0);\n    }\n    vector<pii> ed(m);\n    for(int i=0;i<m;i++) cin >> ed[i].ft >> ed[i].sd;\n    int target = n*(n+55)+1;\n    for(int t=0; t<n+54; t++) {\n        for(pii &e : ed) {\n            for(int j=1; j<=k; j++) {\n                mcmf.add_edge(e.ft+t*n, e.sd+(t+1)*n, 1, c+d*(2*j-1));\n                mcmf.add_edge(e.sd+t*n, e.ft+(t+1)*n, 1, c+d*(2*j-1));\n            }\n        }\n        for(int i=2; i<=n; i++)\n            mcmf.add_edge(i+t*n, i+(t+1)*n, k, c);\n        mcmf.add_edge(1+t*n, target, k, 0);\n    }\n    cout << mcmf.min_cost(0, target, k) << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**9\n\nclass Edge:\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nclass MCMF:\n    def __init__(self):\n        self.N = 0\n        self.adj = []\n        self.H = []\n        self.D = []\n        self.P = []\n        self.E = []\n\n    def init(self, n):\n        self.N = n\n        self.adj = [[] for _ in range(n+1)]\n        self.H = [0]*(n+1)\n        self.D = [0]*(n+1)\n        self.P = [0]*(n+1)\n        self.E = [0]*(n+1)\n\n    def add_edge(self, fr, to, cap, cost):\n        self.adj[fr].append(Edge(to, cap, cost, len(self.adj[to])))\n        self.adj[to].append(Edge(fr, 0, -cost, len(self.adj[fr])-1))\n\n    def min_cost(self, s, t, f):\n        flow = 0\n        ans = 0\n        self.H = [0]*(self.N+1)\n        while f > 0:\n            self.D = [INF]*(self.N+1)\n            pq = []\n            self.D[s] = 0\n            heapq.heappush(pq, (0, s))\n            while pq:\n                d, v = heapq.heappop(pq)\n                if self.D[v] < d:\n                    continue\n                for i, e in enumerate(self.adj[v]):\n                    if e.cap > 0 and self.D[e.to] > self.D[v] + e.cost + self.H[v] - self.H[e.to]:\n                        self.D[e.to] = self.D[v] + e.cost + self.H[v] - self.H[e.to]\n                        self.P[e.to] = v\n                        self.E[e.to] = i\n                        heapq.heappush(pq, (self.D[e.to], e.to))\n            if self.D[t] == INF:\n                break\n            for i in range(self.N+1):\n                self.H[i] += self.D[i]\n            add = f\n            v = t\n            while v != s:\n                add = min(add, self.adj[self.P[v]][self.E[v]].cap)\n                v = self.P[v]\n            f -= add\n            flow += add\n            ans += add * self.H[t]\n            v = t\n            while v != s:\n                e = self.adj[self.P[v]][self.E[v]]\n                e.cap -= add\n                self.adj[v][e.rev].cap += add\n                v = self.P[v]\n        return ans\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    mcmf = MCMF()\n    total_nodes = n*(n+55) + 2\n    mcmf.init(total_nodes)\n\n    for _ in range(k):\n        u = int(next(it))\n        mcmf.add_edge(0, u, 1, 0)\n\n    edges = []\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        edges.append((u, v))\n\n    target = n*(n+55) + 1\n    for t in range(n+54):\n        for u, v in edges:\n            for j in range(1, k+1):\n                cost = c + d*(2*j-1)\n                mcmf.add_edge(u + t*n, v + (t+1)*n, 1, cost)\n                mcmf.add_edge(v + t*n, u + (t+1)*n, 1, cost)\n        for i in range(2, n+1):\n            mcmf.add_edge(i + t*n, i + (t+1)*n, k, c)\n        mcmf.add_edge(1 + t*n, target, k, 0)\n\n    result = mcmf.min_cost(0, target, k)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.001177451922558248, -2.3841855067985307e-07, 0.0, -0.0005763299996033311, -0.0053370376117527485, -0.01416497677564621, -0.0024830244947224855, -0.0009132028790190816, -0.00035696811391972005, -0.1603822261095047, -0.014446428045630455, -4.768370445162873e-07, -0.0004664763400796801, -0.005330753047019243, -0.0024757706560194492, -0.6515316963195801, -0.03242921456694603, -2.586808113846928e-05, -0.0011714984430000186, -4.768370445162873e-07, -2.3841830625315197e-06, -0.06197893247008324, -2.0265558760002023e-06, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.00015984688070602715, -0.009098143316805363, -5.245195097813848e-06, -1.1920922133867862e-06, -1.1920928244535389e-07, 0.0, 0.0, -2.4676019165781327e-05, 0.0, -1.192