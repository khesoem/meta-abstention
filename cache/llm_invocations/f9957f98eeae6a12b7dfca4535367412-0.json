ow(10, un);\n        }\n    }\n    return 0;\n}\n\nlong long solve(const vector<char>& str, int n) {\n    if (n == 1 || str[0] == '0') return 0;\n    long long cnt = 0;\n    int un = 0;\n    for (int i = 1; i < n - 2; i++) {\n        if (str[i] == '_') ++un;\n    }\n\n    cnt += cal(str, \"25\", n, un);\n    cnt += cal(str, \"50\", n, un);\n    cnt += cal(str, \"75\", n, un);\n\n    if (n > 2 && str[0] == '_') cnt *= 9;\n\n    if (n >= 3) {\n        if ((str[n - 1] == '_' || str[n - 1] == '0') && (str[n - 2] == '_' || str[n - 2] == '0')) {\n            if (n > 3) {\n                long long temp = (long long)pow(10, un);\n                if (str[0] == '_') temp *= 9;\n                cnt += temp;\n            } else if (n == 3) {\n                if (str[0] == '_') {\n                    cnt += 9;\n                } else {\n                    cnt += 1;\n                }\n            }\n        }\n    }\n    return cnt;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int test = 1;\n    // For multiple test cases, uncomment the following line:\n    // test = takeInt(cin);\n    stringstream ans;\n    while (test--) {\n        string line;\n        getline(cin, line);\n        vector<char> str(line.begin(), line.end());\n        int n = (int)str.size();\n\n        if (n == 1) {\n            if (str[0] == '0' || str[0] == '_' || str[0] == 'X' || str[0] == '1') {\n                ans << 1 << \"\\n\"; continue;\n            }\n        }\n\n        long long cnt = 0;\n        bool Xp = false;\n        for (int i = 0; i < n; i++) if (str[i] == 'X') Xp = true;\n\n        if (Xp) {\n            for (char ch = '0'; ch <= '9'; ch++) {\n                vector<char> genStr = generateStrings(str, n, ch);\n                cnt += solve(genStr, n);\n            }\n        } else {\n            cnt += solve(str, n);\n        }\n        ans << cnt << \"\\n\";\n    }\n    cout << ans.str();\n    return 0;\n}\n\n<confidence>\n0.9\n</confidence>", "token