        pe[y] = id;\n                if (!inq[y]) {\n                    inq[y] = 1;\n                    q.push(y);\n                }\n            }\n        }\n    }\n\n    int cur = t;\n    while (cur != s) {\n        e[pe[cur]].f++;\n        e[pe[cur] ^ 1].f--;\n        cur = p[cur];\n    }\n    ans += d[t];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        add_edge(s, x, 1, 0);\n    }\n\n    int tt = 101;\n\n    for (int i = 0; i < tt; ++i)\n        add_edge(i * n, t, k, i * c);\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n\n        for (int tm = 0; tm < tt - 1; ++tm)\n            for (int p = 0; p < k; ++p)\n                add_edge(x + tm * n, y + tm * n + n, 1, d * (p * 2 + 1));\n\n        for (int tm = 0; tm < tt - 1; ++tm)\n            for (int p = 0; p < k; ++p)\n                add_edge(y + tm * n, x + tm * n + n, 1, d * (p * 2 + 1));\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int tm = 0; tm < tt - 1; ++tm)\n            add_edge(i + tm * n, i + tm * n + n, k, 0);\n\n    for (int i = 0; i < k; ++i)\n        push_flow();\n\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nN = 14043\ne = []  # list of edges: [y, c, f, w]\ng = [[] for _ in range(N)]\n\nans = 0\nINF = 10**18\n\ns = N - 2\nt = N - 1\n\ndef rem(x):\n    return e[x][1] - e[x][2]\n\ndef add_edge(x, y, c, w):\n    g[x].append(len(e))\n    e.append([y, c, 0, w])\n    g[y].append(len(e))\n    e.append([x, 0, 0, -w])\n\ndef push_flow():\n    global ans\n    d = [INF] * N\n    p = [-1] * N\n    pe = [-1] * N\n    inq = [0] * N\n    d[s] = 0\n    q = d