   \n    static int s = N - 2;\n    static int t = N - 1;\n    \n    static int rem(int x) {\n        return e.get(x).c - e.get(x).f;\n    }\n    \n    static void push_flow() {\n        for(int i = 0; i < N; i++) {\n            d[i] = INF64;\n            p[i] = -1;\n            pe[i] = -1;\n            inq[i] = 0;\n        }\n        d[s] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        inq[s] = 1;\n        \n        while(!q.isEmpty()) {\n            int k = q.poll();\n            inq[k] = 0;\n            for(int x : g[k]) {\n                if(rem(x) == 0) continue;\n                int c = e.get(x).cost;\n                int y = e.get(x).y;\n                if(d[y] > d[k] + c) {\n                    d[y] = d[k] + c;\n                    p[y] = k;\n                    pe[y] = x;\n                    if(inq[y] == 0) {\n                        inq[y] = 1;\n                        q.offer(y);\n                    }\n                }\n            }\n        }\n        \n        int cur = t;\n        while(cur != s) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = p[cur];\n        }\n        ans += d[t];\n    }\n    \n    static void add_edge(int x, int y, int c, int cost) {\n        g[x].add(e.size());\n        e.add(new Edge(y, c, 0, cost));\n        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        for(int i = 0; i < N; i++) {\n            g[i] = new ArrayList<>();\n        }\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d_val = sc.nextInt();\n        \n        for(int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            --x;\n            add_edge(s, x, 1, 0);\n        }\n        \n        int tt = 101;\n        for(int i = 0; i < tt; i++) {\n            add_edge(0 + i * n, t, k, i * c);\n        }\n        \n        for(int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x;\n            --y;\n            for(int i_layer = 0; i_layer < tt - 1; i_layer++) {\n                for(int j = 0; j < k; j++) {\n                    add_edge(x + i_layer * n, y + i_layer * n + n, 1, d_val * (j * 2 + 1));\n                }\n                for(int j = 0; j < k; j++) {\n                    add_edge(y + i_layer * n, x + i_layer * n + n, 1, d_val * (j * 2 + 1));\n                }\n            }\n        }\n        \n        for(int i = 0; i < n; i++) {\n            for(int j = 0; j < tt - 1; j++) {\n                add_edge(i + j * n, i + j * n + n, k, 0);\n            }\n        }\n        \n        for(int i = 0; i < k; i++) {\n            push_flow();\n        }\n        \n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020847532141488045, -3.6954811548639555e-06, -8.344646857949556e-07, -0.0019487215904518962, -2.586808113846928e-05, -0.0076107303611934185, -0.02349710650742054, -1.7762025890988298e-05, -2.3841855067985307e-07, -6.90197994117625e-05, -0.14267674088478088, -0.005240631755441427, -0.0006759266252629459, -0.012519460171461105, -8.904537389753386e-05, -3.576278118089249e-07, -1.1920922133867862e-06, -1.645074735279195e-05, -2.3841855067985307e-07, -0.0009157040040008724, -1.1920858014491387e-05, 0.0, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, -0.00017355366435367614, -2.753696753643453e-05, -2.932505594799295e-05, -0.0019320646533742547, -0.01652260310947895, -1.5497195136049413e-06, -1.3947389561508317e-05, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -2.622600959512056e-06, 0.0, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, -4.768370445162873e-07, -1.311301275563892e-06, -4.768370445162873e-07, -0.0004315637052059