s;\n    int base_cnt = cnt;\n    while (res + base <= n) {\n        res += base;\n        cnt += base_cnt;\n    }\n    return {res, cnt};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    i64 n;\n    cin >> n;\n\n    priority_queue<Node> pq;\n    pq.push({n, 0});\n\n    while (!pq.empty()) {\n        Node cur = pq.top();\n        pq.pop();\n\n        if (cur.value == 0) {\n            cout << cur.cost << '\\n';\n            return 0;\n        }\n\n        if (check_visited(cur.value)) continue;\n        visited.insert(cur.value);\n\n        vector<Node> candidates;\n        candidates.push_back(compute_lower(cur.value));\n        candidates.push_back(compute_upper(cur.value));\n        candidates.push_back(compute_uupper(cur.value));\n\n        for (auto& cand : candidates) {\n            cand.cost += cur.cost;\n            cand.value = std::abs(cur.value - cand.value);\n            pq.push(cand);\n        }\n    }\n\n    cout << 0 << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Node {\n        long value;\n        int cost;\n\n        Node(long value, int cost) {\n            this.value = value;\n            this.cost = cost;\n        }\n    }\n\n    static class NodeComparator implements Comparator<Node> {\n        public int compare(Node a, Node b) {\n            return Integer.compare(b.cost, a.cost);\n        }\n    }\n\n    static Set<Long> visited = new HashSet<>();\n\n    static boolean checkVisited(long x) {\n        return visited.contains(x);\n    }\n\n    static Node computeUupper(long n) {\n        long res = 0;\n        int cnt = 0;\n        while (res < n) {\n            res = res * 10 + 1;\n            ++cnt;\n        }\n        return new Node(res, cnt);\n    }\n\n    static Node computeUpper(long n) {\n        long 