ool operator==(const Matrix& o) const {\n        if (dim != o.dim) return false;\n        for (int i = 0; i < dim; ++i)\n            for (int j = 0; j < dim; ++j)\n                if (m[i][j] != o.m[i][j]) return false;\n        return true;\n    }\n};\n\nMatrix fastPow(Matrix base, ll exp) {\n    Matrix res(base.dim, 1);\n    while (exp) {\n        if (exp & 1) res = res * base;\n        base = base * base;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint K;\nMatrix A[60], S[60];\nll P[60];\n\nMatrix decompose(ll n, int idx) {\n    if (n == 0) return Matrix(K + 1, 1);\n    \n    for (int i = idx; i >= 0; --i) {\n        if (n >= P[i]) {\n            Matrix t = decompose(n % P[i], i - 1);\n            int x = n / P[i];\n            \n            Matrix ans = A[i];\n            for (int j = 1; j < x; ++j) {\n                ans = ans * S[K - 1];\n                ans = ans * A[i];\n            }\n            ans = ans * S[K - 1];\n            ans = ans * t;\n            ans = ans * S[x - 1];\n            return ans;\n        }\n    }\n    \n    throw exception();\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    ll N;\n    cin >> N >> K;\n    \n    P[0] = 1;\n    int last = 60;\n    for (int i = 1; i < 60; ++i) {\n        if (P[i-1] >= INF / K) {\n            P[i] = INF;\n            last = i;\n            break;\n        }\n        P[i] = P[i-1] * K;\n    }\n    \n    S[0] = Matrix(K + 1, 1);\n    S[1] = Matrix(K + 1);\n    \n    for (int i = 0; i < K; ++i)\n        S[1][i][(i - 1 + K) % K] = 1;\n    S[1][K][K] = 1;\n    \n    for (int i = 2; i < K; ++i)\n        S[i] = S[i-1] * S[1];\n    \n    for (int i = 0; i < 60; ++i)\n        A[i] = Matrix(K + 1, 1);\n    \n    for (int i = 0; i <= K; ++i)\n        A[0][i][0] = 1;\n    \n    for (int i = 1; i < last; ++i) {\n        Matrix tmp = A[i-1];\n        A[i] = A[i-1];\n        \n        for (int j = 1; j < K; ++j) {\n            A[i] = A[i] * S[K - 1];\n            A[i] = A[i]