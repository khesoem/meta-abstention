t[v] = ++ct;\n    }\n\n    bool is_ancestor(int u, int v) {\n        return tin[u] <= tin[v] && tout[u] >= tout[v];\n    }\n\n    int lca(int u, int v) {\n        if (is_ancestor(u, v)) {\n            return u;\n        }\n        if (is_ancestor(v, u)) {\n            return v;\n        }\n\n        for (int i = 31; i >= 0; i--) {\n            if (!is_ancestor(BL[u][i], v)) {\n                u = BL[u][i];\n            }\n        }\n\n        return BL[u][0];\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N, P;\n    cin >> N >> P;\n\n    BinaryLifting bl;\n    bl.adjList.resize(N + 1);\n    for (int i = 0; i <= N; i++) {\n        bl.adjList[i].resize(1);\n    }\n\n    for (int i = 0; i <= N; i++) {\n        double val = (double)i * (i - 1) * (i - 2) / 6 + (double)i * (i - 1) * (N - i) / 2 + (double)i * (N - i) * (N - i - 1) / 4;\n        val /= (double)N * (N - 1) * (N - 2) / 6;\n\n        if (val >= P) {\n            cout << i << endl;\n            break;\n        }\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.03580066189169884, -0.0005684918724000454, -0.11465570330619812, -0.016059454530477524, -0.013492360711097717, -0.20642152428627014, -0.0004450476844795048, -0.00031285409932024777, -4.7923284000717103e-05, -0.21109426021575928, -0.00034683995181694627, -0.00010574422776699066, -1.2874686035502236e-05, -0.40746307373046875, -0.011054355651140213, -0.003464195178821683, -7.128969446057454e-05, -1.079941749572754, -0.06201358512043953, -0.01898730918765068, -7.534310861956328e-05, -0.20372304320335388, -0.47411295771598816, -0.1612604856491089, -0.00022813299437984824, -1.0883350372314453, -0.4746788740158081, -0.2250383049249649, -0.0006340963882394135, -9.179157132166438e-06, -0.009787438437342644, -0.681154191493988, -0.8508656024932861, -0.5499759912490845, -0.25417205691337585, -0.00047599675599485636, -0.008095219731330872, -1.013727068901062,