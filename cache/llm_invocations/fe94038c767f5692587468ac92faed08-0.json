urn result\n\nfactorial = None\ninv_factorial = None\n\ndef nCr(n, r):\n    if r > n or r < 0:\n        return 0\n    return factorial[n] * inv_factorial[r] % MOD * inv_factorial[n - r] % MOD\n\ndef main():\n    global factorial, inv_factorial\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    k = int(data[1])\n    \n    if k >= n:\n        print(0)\n        return\n    \n    m = n - k\n    \n    factorial = [0] * (n + 1)\n    inv_factorial = [0] * (n + 1)\n    \n    factorial[0] = 1\n    for i in range(1, n + 1):\n        factorial[i] = (i * factorial[i - 1]) % MOD\n    \n    inv_factorial[0] = 1\n    for i in range(1, n + 1):\n        inv_factorial[i] = inv_factorial[i - 1] * mod_pow(i, MOD - 2) % MOD\n    \n    positive_sum = 0\n    negative_sum = 0\n    for i in range(0, m + 1):\n        term = mod_pow(m - i, n) * nCr(m, i) % MOD\n        if i % 2 == 0:\n            positive_sum = (positive_sum + term) % MOD\n        else:\n            negative_sum = (negative_sum + term) % MOD\n    \n    result = (positive_sum - negative_sum + 2 * MOD) % MOD\n    result = result * nCr(n, m) % MOD\n    if m != n:\n        result = result * 2 % MOD\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.0424259825376794e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.025785228237509727, -0.00289794709533453, -0.4740850031375885, -0.016007952392101288, -0.0013856819132342935, -1.07287787614041e-05, -0.0007949291029945016, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.5497195136049413e-06, -3.3378546504536644e-06, -2.3841830625315197e-06, -7.390948667307384e-06, -7.593343616463244e-05, -2.169585604860913e-05, -2.145764938177308e-06, -6.318072337307967e-06, -2.1457441107486375e-05, -4.124556289752945e-05, -0.02059655450284481, -8.344646857949556e-07, -1.1920928244535389e-07, -1.4424220353248529e-05, -4.8993817472364753e-05, -3.576278118089249e-07, -3.576