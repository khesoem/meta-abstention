 = 1;\n    }\n\n    static long fact(int n) {\n        if (n >= factArr.length) {\n            int oldLen = factArr.length;\n            long[] newFact = new long[n + 1];\n            long[] newInv = new long[n + 1];\n            System.arraycopy(factArr, 0, newFact, 0, oldLen);\n            System.arraycopy(invFactArr, 0, newInv, 0, oldLen);\n            for (int i = oldLen; i <= n; i++) {\n                newFact[i] = newFact[i - 1] * i % MOD;\n            }\n            newInv[n] = pow(newFact[n], (int)(MOD - 2));\n            for (int i = n - 1; i >= oldLen; i--) {\n                newInv[i] = newInv[i + 1] * (i + 1) % MOD;\n            }\n            factArr = newFact;\n            invFactArr = newInv;\n        }\n        return factArr[n];\n    }\n\n    static long invFact(int n) {\n        fact(n); // ensure computed\n        return invFactArr[n];\n    }\n\n    static long ncr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return mult(fact(n), invFact(r), invFact(n - r));\n    }\n\n    static long paritySign(long k) {\n        return (k & 1) == 0 ? 1 : MOD - 1;\n    }\n\n    static long add(long a, long b) {\n        long v = a + b;\n        return v >= MOD ? v - MOD : v;\n    }\n\n    static long mult(long... x) {\n        long r = 1;\n        for (long v : x) r = r * v % MOD;\n        return r;\n    }\n\n    static long pow(long x, int e) {\n        if (e < 0) {\n            x = inv(x);\n            e = -e;\n        }\n        long res = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) res = res * x % MOD;\n            x = x * x % MOD;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static long inv(long x) {\n        return pow(x, (int)(MOD - 2));\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <cstdint>\n\nusing namespace std;\n\ncons