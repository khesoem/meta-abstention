COSTO);\n        dist[s] = 0;\n        mset(pre, -1);\n        pre[s] = 0;\n        mset(cap, 0);\n        cap[s] = INFFLUJO;\n        queue<int> q;\n        q.push(s);\n        in_queue[s] = true;\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n            in_queue[u] = false;\n            for (int idx : g[u]) {\n                edge &E = edges[idx];\n                if (E.rem() && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                    dist[E.v] = dist[u] + E.cost;\n                    pre[E.v] = idx;\n                    cap[E.v] = min(cap[u], E.rem());\n                    if (!in_queue[E.v]) {\n                        q.push(E.v);\n                        in_queue[E.v] = true;\n                    }\n                }\n            }\n        }\n        if (pre[t] < 0) break;\n        mxflow += cap[t];\n        mncost += cap[t] * dist[t];\n        for (int v = t; v != s; v = edges[pre[v]].u) {\n            edges[pre[v]].flow += cap[t];\n            edges[pre[v] ^ 1].flow -= cap[t];\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    ll n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    int MAXT = n + k;\n    vector<int> a(k);\n    fore(i, 0, k) {\n        cin >> a[i];\n        --a[i];\n        add_edge(SRC, a[i] * MAXT, 1, 0);\n    }\n    fore(j, 0, MAXT) add_edge(j, SNC, k, 0);\n    fore(i, 0, m) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        fore(j, 0, MAXT - 1) fore(K, 1, k + 1) {\n            add_edge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1));\n        }\n        fore(j, 0, MAXT - 1) fore(K, 1, k + 1) {\n            add_edge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1));\n        }\n    }\n    fore(i, 0, n) {\n        fore(j, 0, MAXT - 1) fore(K, 1, k + 1) {\n            add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c);\n        }\n    }\n    flow(SRC, SNC);\n    cout << mncost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 50015;\n    static final int SRC = MAXN - 1;\n    static final int SNC = MAXN - 2;\n\n    static class Edge {\n        int u, v;\n        long cap, flow;\n        long cost;\n        \n        Edge(int u, int v, long cap, long flow, long cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n        \n        long rem() {\n            return cap - flow;\n        }\n    }\n\n    static int nodes = MAXN;\n    static List<Integer>[] g = new List[MAXN];\n    static List<Edge> edges = new ArrayList<>();\n\n    static void addEdge(int u, int v, long cap, long cost) {\n        g[u].add(edges.size());\n        edges.add(new Edge(u, v, cap, 0, cost));\n        g[v].add(edges.size());\n        edges.add(new Edge(v, u, 0, 0, -cost));\n    }\n\n    static long[] dist = new long[MAXN];\n    static long mncost;\n    static int[] pre = new int[MAXN];\n    static long[] cap = new long[MAXN];\n    static long mxflow;\n    static boolean[] in_queue = new boolean[MAXN];\n\n    static void flow(int s, int t) {\n        Arrays.fill(in_queue, false);\n        mxflow = mncost = 0;\n        \n        while (true) {\n            Arrays.fill(dist, Long.MAX_VALUE);\n            dist[s] = 0;\n            Arrays.fill(pre, -1);\n            pre[s] = 0;\n            Arrays.fill(cap, 0);\n            cap[s] = (long)1e14;\n            \n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            in_queue[s] = true;\n            \n            while (!q.isEmpty()) {\n                int u = q.poll();\n                in_queue[u] = false;\n                \n                for (int idx : g[u]) {\n                    Edge E = edges.get(idx);\n           