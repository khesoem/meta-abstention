/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    p = [float(next(it)) for _ in range(n)]\n    size = 1 << n\n    way = [0.0] * size\n    ans = [0.0] * n\n\n    # Initialize single-element masks\n    for i in range(n):\n        way[1 << i] = p[i]\n\n    # Process masks from 1 to (1<<n)-1\n    for mask in range(1, size):\n        chosen = []\n        left = []\n        left_sum = 0.0\n        for i in range(n):\n            if mask & (1 << i):\n                chosen.append(i)\n            else:\n                left.append(i)\n                left_sum += p[i]\n\n        c = len(chosen)\n        if c == m or (c < m and left_sum < 1e-5):\n            for x in chosen:\n                ans[x] += way[mask]\n        elif c < m:\n            for x in left:\n                way[mask | (1 << x)] += way[mask] * p[x] / left_sum\n\n    # Output\n    out = ' '.join(f\"{ans[i]:.15f}\" for i in range(n))\n    sys.stdout.write(out + '\\n')\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00030012393835932016, -1.1920928244535389e-07, 0.0, -0.00045408427831716835, -0.001531857531517744, -1.1920928244535389e-07, -0.0011840007500723004, -0.000205018965061754, -0.16092777252197266, -0.474356472492218, -2.3841830625315197e-06, -0.002035690238699317, -1.5497195136049413e-06, -7.86750388215296e-05, 0.0, -7.724463648628443e-05, 0.0, -0.10020798444747925, 0.0, -4.768370445162873e-07, -1.0728830375228426e-06, -2.3841855067985307e-07, -5.185469490243122e-05, 0.0, 0.0, -0.0005529781919904053, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -0.10048218816518784, 0.0, -1.1920928244535389e-07, -4.768360213347478e-06, -1.6689286894688848e-06, -1.1920928244535389e-07, -1.1920922133867862e-06,