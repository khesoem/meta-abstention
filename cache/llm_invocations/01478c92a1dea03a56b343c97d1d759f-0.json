][2 * N * N + 2];\nint parent[2 * N * N + 2];\nbool visited[2 * N * N + 2];\n\nbool findPath() {\n    memset(visited, false, sizeof(visited));\n    memset(parent, 0, sizeof(parent));\n    queue<int> q;\n    visited[0] = true;\n    q.push(0);\n    while (!q.empty()) {\n        int v = q.front(); q.pop();\n        if (v == 2 * n * n + 1) return true;\n        for (int u = 0; u <= 2 * n * n + 1; ++u) {\n            if (cap[v][u] > 0 && !visited[u]) {\n                visited[u] = true;\n                parent[u] = v;\n                q.push(u);\n            }\n        }\n    }\n    return false;\n}\n\nvoid solve() {\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 0; i < n; ++i) scanf(\" %s\", a[i]);\n    for (int i = 0; i < n; ++i) scanf(\" %s\", b[i]);\n    scanf(\"%d%d\", &sx, &sy);\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (a[i][j] == 'Z') { sx = i; sy = j; }\n    computeDist(sx, sy);\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (isdigit(a[i][j]))\n                dp[0][i][j][i][j] = true;\n\n    for (int time = 0; time < t; ++time) {\n        for (int s1 = 0; s1 < n; ++s1)\n            for (int s2 = 0; s2 < n; ++s2)\n                for (int x = 0; x < n; ++x)\n                    for (int y = 0; y < n; ++y) {\n                        if (!dp[time][s1][s2][x][y]) continue;\n                        if (dist[x][y] <= time) continue;\n                        for (int k = 0; k < 4; ++k) {\n                            int nx = x + dx[k], ny = y + dy[k];\n                            if (nx >= 0 && nx < n && ny >= 0 && ny < n && isdigit(a[nx][ny]) && dist[nx][ny] >= time + 1)\n                                dp[time + 1][s1][s2][nx][ny] = true;\n                        }\n                    }\n    }\n\n    for (int time = 0; time <= t; ++time)\n        for (int s1 = 0; s1 < n; ++s1)\n            for (int s2 = 0; s2 < n; ++s2)\n                for (int x = 0; x < n; ++x)\n                    for (int y = 0; y < n; ++y)\n                        if (dp[time][s1][s2][x][y])\n                            reachable[s1][s2][x][y] = true;\n\n    memset(cap, 0, sizeof(cap));\n    for (int x = 0; x < n; ++x)\n        for (int y = 0; y < n; ++y)\n            if (isdigit(a[x][y]))\n                cap[0][x * n + y + 1] = a[x][y] - '0';\n\n    for (int x = 0; x < n; ++x)\n        for (int y = 0; y < n; ++y)\n            if (isdigit(b[x][y]))\n                cap[n * n + x * n + y + 1][2 * n * n + 1] = b[x][y] - '0';\n\n    for (int x1 = 0; x1 < n; ++x1)\n        for (int y1 = 0; y1 < n; ++y1)\n            if (isdigit(a[x1][y1]))\n                for (int x2 = 0; x2 < n; ++x2)\n                    for (int y2 = 0; y2 < n; ++y2)\n                        if (isdigit(a[x2][y2]) && reachable[x1][y1][x2][y2])\n                            cap[x1 * n + y1 + 1][n * n + x2 * n + y2 + 1] = INF;\n\n    while (findPath()) {\n        int flow = INF;\n        for (int v = 2 * n * n + 1; v; v = parent[v])\n            flow = min(flow, cap[parent[v]][v]);\n        for (int v = 2 * n * n + 1; v; v = parent[v]) {\n            cap[parent[v]][v] -= flow;\n            cap[v][parent[v]] += flow;\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= 2 * n * n + 1; ++i)\n        ans += cap[i][0];\n    printf(\"%d\\n\", ans);\n}\n\nint main() {\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n    sx = int(next(it))\n    sy = int(next(it))\n    # find 'Z' and override\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        else:\n            continue\n        break\n\n    dx = [0, 1, 0, -1]\n    dy = [1, 0, -1, 0]\n    INF = 10**9\n\n    # compute distances from start (zombie)\n    dist = [[INF]*n for _ in range(n)]\n    seen = [[False]*n for _ in range(n)]\n    q = deque()\n    seen[sx][sy] = True\n    dist[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if 0 <= nx < n and 0 <= ny < n and not seen[nx][ny] and a[nx][ny].isdigit():\n                seen[nx][ny] = True\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n\n    # helper to create 4D boolean array\n    def make_4d():\n        return [[[[False]*n for _ in range(n)] for _ in range(n)] for _ in range(n)]\n\n    cur = make_4d()\n    reachable = make_4d()\n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit():\n                cur[i][j][i][j] = True\n                reachable[i][j][i][j] = True\n\n    for time in range(t):\n        nxt = make_4d()\n        for s1 in range(n):\n            for s2 in range(n):\n                for x in range(n):\n                    for y in range(n):\n                        if cur[s1][s2][x][y]:\n                            if dist[x][y] <= time:\n                                continue\n                            for k in range(4):\n                                nx = x + dx[k]\n                                ny = y + dy[k]\n                                if 0 <= nx < n and 0 <= ny < n and a[nx][ny].isdigit() and dist[nx][ny] >= time+1:\n                                    nxt[s1][s2][nx][ny] = True\n                                    reachable[s1][s2][nx][ny] = True\n        cur = nxt\n\n    total_nodes = 2 * n * n + 2\n    cap = [[0]*total_nodes for _ in range(total_nodes)]\n\n    # source to a-cells\n    for x in range(n):\n        for y in range(n):\n            if a[x][y].isdigit():\n                cap[0][x * n + y + 1] = int(a[x][y])\n\n    # b-cells to sink\n    for x in range(n):\n        for y in range(n):\n            if b[x][y].isdigit():\n                cap[n * n + x * n + y + 1][total_nodes - 1] = int(b[x][y])\n\n    # edges from a-cells to b-cells if reachable\n    for x1 in range(n):\n        for y1 in range(n):\n            if a[x1][y1].isdigit():\n                for x2 in range(n):\n                    for y2 in range(n):\n                        if a[x2][y2].isdigit() and reachable[x1][y1][x2][y2]:\n                            cap[x1 * n + y1 + 1][n * n + x2 * n + y2 + 1] = INF\n\n    # max flow (Edmonds-Karp)\n    def find_path():\n        visited = [False] * total_nodes\n        parent = [-1] * total_nodes\n        q = deque()\n        visited[0] = True\n        q.append(0)\n        while q:\n            v = q.popleft()\n            if v == total_nodes - 1:\n                return True\n            for u in range(total_nodes):\n                if cap[v][u] > 0 and not visited[u]:\n                    visited[u] = True\n                    parent[u] = v\n                    q.append(u)\n        return False\n\n    while find_path():\n        flow = INF\n        v = total_nodes - 1\n        while v != 0:\n            flow = min(flow, cap[parent[v]][v])\n            v = parent[v]\n        v = total_nodes - 1\n        while v != 0:\n            cap[parent[v]][v] -= flow\n            cap[v][parent[v]] += flow\n            v = parent[v]\n\n    ans = sum(cap[i][0] for i in range(total_nodes))\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.001178523525595665, 0.0, 0.0, -0.000732868502382189, -0.010200983844697475, -1.3232143828645349e-05, -8.821448318485636e-06, -3.2186455882765586e-06, 0.0, 0.0, -1.1920928244535389e-07, -4.625213477993384e-05, -0.16931580007076263, -0.0011754278093576431, -0.2014172375202179,