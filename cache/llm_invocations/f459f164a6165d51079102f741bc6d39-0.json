Idx += idx;\n        return;\n    }\n    ++Idx;\n    int add = (Idx - x) % M;\n    if (add < 0) add += M;\n    ans = (ans + add) % M2;\n    for (int i = (!x); i < 10; ++i)\n        if (x * 10 + i <= n) dfs2(x * 10 + i);\n}\n\nint main() {\n    dfs1(0, 0);\n    cin >> n;\n    dfs2(0);\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\np = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000]\nM = 998244353\nM2 = 1000000007\n\nidx = 0\nans = 0\nn = 0\ns = [0] * 7\nIdx = -1\nv = [[] for _ in range(7)]\nL = [0] * 7\n\ndef dfs1(x, d):\n    global idx, s, v, L\n    u = (idx - x) % M\n    v[d].append(u)\n    L[d] += 1\n    idx += 1\n    s[d] += u\n    if d == 6:\n        return\n    for i in range(10):\n        dfs1(x * 10 + i, d + 1)\n\ndef query(x, r):\n    global ans\n    for i in range(7):\n        t = (r - x * p[i]) % M\n        g = bisect.bisect_left(v[i], M - t)\n        ans = (ans + s[i] + t * L[i] - M * (L[i] - g)) % M2\n        if ans < 0:\n            ans += M2\n\ndef dfs2(x):\n    global ans, idx, Idx, n\n    if (x + 1) * p[6] <= n + 1 and x * p[7] > n:\n        query(x, Idx + 1)\n        Idx += idx\n        return\n    Idx += 1\n    add = (Idx - x) % M\n    ans = (ans + add) % M2\n    start = 0 if x != 0 else 1\n    for i in range(start, 10):\n        if x * 10 + i <= n:\n            dfs2(x * 10 + i)\n\ndef main():\n    global n, ans, Idx\n    dfs1(0, 0)\n    data = sys.stdin.read().strip()\n    if not data:\n        return\n    n = int(data)\n    dfs2(0)\n    sys.stdout.write(str(ans) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, 0.0, 0.0, -0.0003392120997887105, -0.00026008085114881396, -0.00026127262390218675, -2.109982233378105e-05, -0.0015998195158317685, -4.76837