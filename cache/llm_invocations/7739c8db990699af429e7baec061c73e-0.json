e formula with precomputed inverses\n            long res = power(C, N, MOD);\n            // use IntStream for the sum\n            res = IntStream.range(1, C)\n                .mapToLong(e -> {\n                    long temp = power(C - e, N, MOD);\n                    temp = (temp * nCr(e, C)) % MOD;\n                    return (e % 2 == 1) ? (MOD - temp) % MOD : temp;\n                })\n                .reduce(res, (a, b) -> (a + b) % MOD);\n            res = (res * nCr(C, N)) % MOD;\n            if (K > 0)\n                res = (2 * res) % MOD;\n            System.out.println(res);\n        }\n    }\n\n    public static long nCr(int a, int b) {\n        // compute C(b, a) = product_{i=1}^{a} (b - a + i) / i\n        long res = 1L;\n        for (int i = 1; i <= a; i++) {\n            res = (res * (b - a + i)) % MOD;\n            res = (res * inv[i]) % MOD;\n        }\n        return res;\n    }\n\n    public static long power(long x, long y, long p) {\n        long res = 1L;\n        x = x % p;\n        while (y > 0) {\n            if ((y & 1) == 1)\n                res = (res * x) % p;\n            y = y >> 1;\n            x = (x * x) % p;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <sstream>\n#include <algorithm>\n#include <cmath>\n\nusing namespace std;\n\nconst long long MOD = 998244353LL;\nlong long fac[200001];\nlong long inv[200001];\n\nlong long power(long long x, long long y, long long p) {\n    long long res = 1LL;\n    x = x % p;\n    while (y > 0) {\n        if (y & 1)\n            res = (res * x) % p;\n        y = y >> 1;\n        x = (x * x) % p;\n    }\n    return res;\n}\n\nlong long nCr(int a, int b) {\n    // compute C(b, a) = product_{i=1}^{a} (b - a + i) / i\n    long long res = 1LL;\n    for (int i = 1; i <= a; i++) {\n        