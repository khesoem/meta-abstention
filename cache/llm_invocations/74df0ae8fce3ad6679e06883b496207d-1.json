][j] = total\n\n        # init\n        fact = [0] * (501 * 501)\n        fact[0] = fact[1] = 1\n        for i in range(2, len(fact)):\n            fact[i] = fact[i - 1] * i\n            fact[i] %= self.mod\n\n        ncr = [[0] * 501 for _ in range(501)]\n        ncr[0][0] = 1\n        for i in range(1, 501):\n            ncr[i][0] = 1\n            for j in range(1, 501):\n                ncr[i][j] = (ncr[i - 1][j] + ncr[i - 1][j - 1]) % self.mod\n                if ncr[i][j] == 0:\n                    ncr[i][j] += self.mod\n\n        res = 0\n        for i in range(n - 2, -1, -1):\n            cnt = n - i\n            pre = n - cnt\n            com = (ncr[n][pre] * fact[pre]) % self.mod\n            if com == 0:\n                com += self.mod\n            sum_val = 0\n\n            for dif in range(1, cnt):\n                for inv in range(dif, len(dp[0])):\n                    if dp[cnt - 1][inv] == 0:\n                        break\n                    if inv - dif - 1 < 0:\n                        continue\n                    x = dp[cnt - 2][inv]\n                    y = sums[cnt - 2][inv - dif - 1]\n                    x = (x * y) % self.mod\n                    if x == 0:\n                        x += self.mod\n                    sum_val += x * (cnt - dif)\n                    sum_val %= self.mod\n\n            res += sum_val * com\n            res %= self.mod\n            if res == 0:\n                res += self.mod\n\n        self.out.write(str(res % self.mod) + '\\n')\n\ndef main():\n    out = sys.stdout\n    fs = FastScanner()\n    \n    T = 1\n    for t in range(T):\n        sol1 = Solution(out, fs)\n        sol1.solution(T, t)\n    \n    out.flush()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.368142152903602e-05, -9.536738616588991e-07, -1.0132738680113107e-05, -0.0015413797227665782, -0.005468884017318487, -0.0008749709231778979, -0.011187915690243244, -0.0524635240435