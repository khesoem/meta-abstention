{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n#define pb push_back\n#define ull unsigned long long\n#define mp make_pair\nconst int maxn=5e3+5;\nconst ll inf=1e9+7;\n\ninline int read() {\n    int X = 0,w = 0; char ch = 0;\n    while(!isdigit(ch)) {w |= ch == '-';ch = getchar();}\n    while(isdigit(ch)) X = (X << 3) + (X << 1) + (ch ^ 48),ch=getchar();\n    return w ? -X : X;\n}\nstruct edge\n{\n    int from,to,cap,flow,cost;\n    edge(int a,int b,int c,int d,int e)\n    {\n        from = a,to = b,cap = c,flow = d,cost = e;\n    }\n};\n\n\nll n,m;\nint a[maxn];\nint startPoint,endPoint;\n\nstruct MCMF\n{\n    int n, m;\n    vector<edge>e;\n    vector<int>g[maxn];\n    int inq[maxn];\n    int d[maxn];\n    int p[maxn];\n    int a[maxn];\n    void Init(int n)\n    {\n        this -> n = n;\n        for(int i = 0;i <= n; i++)\n            g[i].clear();\n        e.clear();\n    }\n    void add(int from,int to,int cap,int cost)\n    {\n        e.push_back(edge(from,to,cap,0,cost));\n        e.push_back(edge(to,from,0,0,-cost));\n        m = e.size();\n        g[from].push_back(m-2);\n        g[to].push_back(m-1);\n    }\n    bool bellman(int s,int t,int& flow,int& cost)\n    {\n        for(int i = 0;i <= t; i++)\n            d[i] = inf,inq[i] = 0;\n        d[s] = 0;inq[s] = 1;p[s] = 0;a[s] = inf;\n        queue<int>Q;\n        Q.push(s);\n        while(!Q.empty())\n        {\n            int u = Q.front();\n\n            Q.pop();\n            inq[u] = 0;\n\n            for(int i = 0;i < g[u].size(); i++)\n            {\n                edge& ee = e[g[u][i]];\n\n                //cout<<ee.cap<<\"  \"<<ee.flow<<\"  \"<<d[ee.to]<<\"  \"<<d[u]<<\"  \"<<ee.cost<<endl;\n                if(ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost)\n                {\n                    //cout<<\"zzzz\"<<endl;\n                    d[ee.to] = d[u] + ee.cost;\n                    p[ee.to] = g[u][i];\n                    a[ee.to] = min(a[u],ee.cap - ee.flow);\n                    if(!inq[ee.to])\n                    {\n                        Q.push(ee.to);\n                        //cout<<\"in=\"<<ee.to<<endl;\n                        inq[ee.to] = 1;\n                    }\n                }\n            }\n        }\n\n        //cout<<\"hahaha\"<<endl;\n        if(d[t] == inf)\n            return false;\n        flow += a[t];\n        cost += d[t] * a[t];\n        int u = t;\n        while(u != s){\n            e[p[u]].flow += a[t];\n            e[p[u]^1].flow -= a[t];\n            u = e[p[u]].from;\n        }\n\n        return true;\n    }\n    int minCost(int s,int t)\n    {\n        int flow = 0,cost = 0;\n        while(bellman(s,t,flow,cost));\n        return cost;\n    }\n}solve;\n\n\nint main(){\n    int k,c,d;\n    cin>>n>>m>>k>>c>>d;\n\n    for(int i=1;i<=k;i++){\n        scanf(\"%d\",&a[i]);\n    }\n\n    startPoint=0,endPoint=n*100+1;\n\n    for(int i=1;i<=k;i++){\n        solve.add(startPoint,1+(a[i]-1)*100,1,0);\n    }\n\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<100;j++){\n            int p=(i-1)*100LL;\n            solve.add(p+j,p+j+1,inf,c);\n        }\n    }\n\n    for(int i=1;i<=100;i++)solve.add(i,endPoint,inf,0);\n\n    while(m--){\n        int x,y;\n        scanf(\"%d%d\",&x,&y);\n        for(int i=1;i<100;i++){\n            int p=(x-1)*100+i;\n            int pp=(y-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n        for(int i=1;i<100;i++){\n            int p=(y-1)*100+i;\n            int pp=(x-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n    }\n\n    printf(\"%d\\n\",solve.minCost(startPoint,endPoint));\n    return 0;\n\n\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ninf = 10**9 + 7\n\nclass Edge:\n    def __init__(self, from_node, to_node, cap, flow, cost):\n        self.from_node = from_node\n        self.to_node = to_node\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nclass MCMF:\n    def __init__(self):\n        self.n = 0\n        self.m = 0\n        self.e = []\n        self.g = [[] for _ in range(50005)]\n        self.inq = [0] * 50005\n        self.d = [0] * 50005\n        self.p = [0] * 50005\n        self.a = [0] * 50005\n    \n    def Init(self, n):\n        self.n = n\n        for i in range(n + 1):\n            self.g[i] = []\n        self.e = []\n    \n    def add(self, from_node, to_node, cap, cost):\n        self.e.append(Edge(from_node, to_node, cap, 0, cost))\n        self.e.append(Edge(to_node, from_node, 0, 0, -cost))\n        self.m = len(self.e)\n        self.g[from_node].append(self.m - 2)\n        self.g[to_node].append(self.m - 1)\n    \n    def bellman(self, s, t):\n        for i in range(t + 1):\n            self.d[i] = inf\n            self.inq[i] = 0\n        self.d[s] = 0\n        self.inq[s] = 1\n        self.p[s] = 0\n        self.a[s] = inf\n        Q = deque()\n        Q.append(s)\n        \n        while Q:\n            u = Q.popleft()\n            self.inq[u] = 0\n            \n            for i in range(len(self.g[u])):\n                ee = self.e[self.g[u][i]]\n                \n                if ee.cap > ee.flow and self.d[ee.to_node] > self.d[u] + ee.cost:\n                    self.d[ee.to_node] = self.d[u] + ee.cost\n                    self.p[ee.to_node] = self.g[u][i]\n                    self.a[ee.to_node] = min(self.a[u], ee.cap - ee.flow)\n                    if not self.inq[ee.to_node]:\n                        Q.append(ee.to_node)\n                        self.inq[ee.to_node] = 1\n        \n        if self.d[t] == inf:\n            return False, 0, 0\n        \n        flow = self.a[t]\n        cost = self.d[t] * self.a[t]\n        u = t\n        while u != s:\n            self.e[self.p[u]].flow += self.a[t]\n            self.e[self.p[u] ^ 1].flow -= self.a[t]\n            u = self.e[self.p[u]].from_node\n        \n        return True, flow, cost\n    \n    def minCost(self, s, t):\n        total_flow = 0\n        total_cost = 0\n        while True:\n            success, flow, cost = self.bellman(s, t)\n            if not success:\n                break\n            total_flow += flow\n            total_cost += cost\n        return total_cost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d_val = int(next(it))\n    \n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = int(next(it))\n    \n    startPoint = 0\n    endPoint = n * 100 + 1\n    \n    solve = MCMF()\n    solve.Init(endPoint)\n    \n    for i in range(1, k + 1):\n        solve.add(startPoint, 1 + (a[i] - 1) * 100, 1, 0)\n    \n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            p = (i - 1) * 100\n            solve.add(p + j, p + j + 1, inf, c)\n    \n    for i in range(1, 101):\n        solve.add(i, endPoint, inf, 0)\n    \n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        \n        for i in range(1, 100):\n            p = (x - 1) * 100 + i\n            pp = (y - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d_val * (j * j - (j - 1) * (j - 1)) + c\n                solve.add(p, pp, 1, cost)\n        \n        for i in range(1, 100):\n            p = (y - 1) * 100 + i\n            pp = (x - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d_val * (j * j - (j - 1) * (j - 1)) + c\n                solve.add(p, pp, 1, cost)\n    \n    result = solve.minCost(startPoint, endPoint)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014077626110520214, -9.536738616588991e-07, -2.3841855067985307e-07, -0.0003868784988299012, -0.0009008163469843566, -5.960462772236497e-07, -0.0002047805901383981, -0.00027247529942542315, -1.7881377516459906e-06, -0.004082797560840845, -0.008641350083053112, -0.875178873538971, -4.291525328881107e-06, -0.017711572349071503, -1.1920928244535389e-07, -8.821098163025454e-05, -0.0002619877050165087, -2.9802276912960224e-06, 0.0, 0.0, 0.0, -0.0003829461056739092, -0.14279673993587494, -0.009981362149119377, -9.417489309271332e-06, -4.768370445162873e-07, -0.006715585943311453, -1.311301275563892e-06, -2.0265558760002023e-06, -1.1920928244535389e-07, -2.3841830625315197e-06, -5.960462772236497e-07, -0.15565155446529388, -0.001757030957378447, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.0002694958820939064, 0.0, -0.003214194905012846, -1.1920922133867862e-06, -4.172316494077677e-06, -0.00031096869497559965, -1.4305104514278355e-06, -1.2636104656849056e-05, -2.288792165927589e-05, -2.3841855067985307e-07, -1.1920922