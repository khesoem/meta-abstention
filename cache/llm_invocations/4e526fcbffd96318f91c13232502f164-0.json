": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static long gcd(long a, long b) {\n        while (b != 0) {\n            long t = b;\n            b = a % b;\n            a = t;\n        }\n        return a;\n    }\n\n    public static long getLcm(long p, long q) {\n        return p * q / gcd(p, q);\n    }\n\n    public static long adjustIp(long ip, long divisor) {\n        if (ip % divisor == 0) {\n            return ip / divisor;\n        }\n        double vok = (double) ip;\n        double pop = (double) divisor;\n        vok = vok / pop + 0.49;\n        return (long) vok;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        double x = sc.nextDouble();\n        double y = sc.nextDouble();\n        double n = sc.nextDouble();\n        sc.close();\n\n        double mn = 1e9;\n        long a = 0, b = 0;\n\n        for (int i = 1; i <= (int) n; ++i) {\n            long kol = getLcm((long) y, i);\n            long ip = (long) (x * (kol / y));\n            ip = adjustIp(ip, kol / i);\n\n            double ip2 = (double) ip;\n            double diff = Math.abs(x / y - ip2 / (double) i);\n            if (mn > diff) {\n                mn = diff;\n                a = (long) ip2;\n                b = i;\n            }\n        }\n\n        long d = gcd(a, b);\n        a /= d;\n        b /= d;\n        System.out.println(a + \"/\" + b);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.182837463100441e-05, 0.0, 0.0, -2.8371408916427754e-05, -1.728519782773219e-05, -1.1920922133867862e-06, -8.583032467868179e-06, -0.009044156409800053, -0.0620017871260643, -9.65590606938349e-06, 0.0, -0.002878928557038307, -0.0009141556802205741, -0.005236006807535887, -0.5089975595474243, 0.0, -0.38688090443611145, -0.0015345951542258263, -6.556489552167477e-06, -0.10022415965795517, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.192092213