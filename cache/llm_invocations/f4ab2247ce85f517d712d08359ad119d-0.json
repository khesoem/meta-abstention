eredWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));\n\n  static class Rec {\n    int a, b;\n    long c;\n    Rec(int a, int b, long c) { this.a = a; this.b = b; this.c = c; }\n  }\n\n  static class Pair<F, S> {\n    F a; S b;\n    Pair(F a, S b) { this.a = a; this.b = b; }\n  }\n\n  static class AscendingOrder implements Comparator<Pair<Integer, Integer>> {\n    public int compare(Pair<Integer, Integer> p1, Pair<Integer, Integer> p2) {\n      return Integer.compare(p1.a, p2.a);\n    }\n  }\n\n  static int modAdd(int a, int b, int mod) {\n    return ((a % mod) + (b % mod)) % mod;\n  }\n\n  static int modSub(int a, int b, int mod) {\n    return (int) (((a % mod) - (b % mod) + mod) % mod);\n  }\n\n  static int modMul(int a, int b, int mod) {\n    return (int) (((long)(a % mod) * (b % mod)) % mod);\n  }\n\n  static int modPow(int base, int exp, int mod) {\n    int res = 1;\n    base %= mod;\n    while (exp > 0) {\n      if ((exp & 1) == 1) res = modMul(res, base, mod);\n      base = modMul(base, base, mod);\n      exp >>= 1;\n    }\n    return res;\n  }\n\n  static int modDiv(int a, int b, int mod) {\n    return modMul(a, modPow(b, mod - 2, mod), mod);\n  }\n\n  static int gcd(int a, int b) {\n    while (b != 0) {\n      int temp = b;\n      b = a % b;\n      a = temp;\n    }\n    return a;\n  }\n\n  static int lowerBound(int[] arr, int target) {\n    int lo = 0, hi = arr.length - 1, ans = -1;\n    while (lo <= hi) {\n      int mid = lo + (hi - lo) / 2;\n      if (arr[mid] < target) {\n        ans = mid;\n        lo = mid + 1;\n      } else {\n        hi = mid - 1;\n      }\n    }\n    return ans;\n  }\n\n  static long[] logSeries(long base, long target) {\n    long sum = 0, p = 1;\n    int cnt = 0;\n    long[] res = new long[2];\n    while (p < base) {\n      sum += p;\n      cnt++;\n      if (sum == target) {\n        res[0] = cnt;\n        res[1] = sum;\n        return res;\n      }\n      p *= 2;\n    }\n    res[0] = cnt;\n    res[1] = sum;\n    return res;\n  }\n\n  static void add(Map<Integer, Integer> map, int key) {\n    map.merge(key, 1, Integer::sum);\n  }\n\n  static long sum(List<Long> list) {\n    return list.stream().mapToLong(Long::longValue).sum();\n  }\n\n  static int charIdx(char c) {\n    return c - 'a';\n  }\n\n  static int search(int[] prefix, int start, int target) {\n    int lo = start + 1, hi = prefix.length - 1, ans = 0;\n    while (lo <= hi) {\n      int mid = lo + (hi - lo) / 2;\n      int diff = prefix[mid] - prefix[start];\n      if (diff == target) return mid;\n      if (diff < target) {\n        ans = mid;\n        lo = mid + 1;\n      } else {\n        hi = mid - 1;\n      }\n    }\n    return ans;\n  }\n\n  static Pair<Long, Integer> analyze(List<Integer> nums) {\n    long total = nums.stream().mapToLong(Integer::longValue).sum();\n    int minVal = nums.stream().mapToInt(Integer::intValue).min().orElse(Integer.MAX_VALUE);\n    return new Pair<>(total - minVal, minVal);\n  }\n\n  static int maxDivisor(Map<Integer, Integer> map, int n, int req) {\n    int max = 0;\n    for (int i = 1; i * i <= n; i++) {\n      if (n % i == 0) {\n        if (i != n / i) {\n          if (map.getOrDefault(n / i, 0) == req) max = Math.max(max, n / i);\n        }\n        if (map.getOrDefault(i, 0) == req) max = Math.max(max, i);\n      }\n    }\n    return max;\n  }\n\n  static List<Integer> keys(Map<Integer, Integer> map) {\n    return new ArrayList<>(map.keySet());\n  }\n\n  static List<Integer> values(Map<Integer, Integer> map) {\n    return new ArrayList<>(map.values());\n  }\n\n  static int max(List<Integer> list) {\n    return list.stream().mapToInt(Integer::intValue).max().orElse(Integer.MIN_VALUE);\n  }\n\n  static int min(List<Integer> list) {\n    return list.stream().mapToInt(Integer::intValue).min().orElse(Integer.MAX_VALUE);\n  }\n\n  static final int[][] DIRS = {{-1,0},{0,1},{1,0},{0,-1}};\n\n  public static void main(String[] args) throws IOException {\n    String s = br.readLine();\n  