ed);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n\nint main() {\n    int n, budget;\n    std::cin >> n >> budget;\n    \n    std::vector<int> arr(n);\n    std::vector<int> val(n);\n    \n    for (int i = 0; i < n; i++) {\n        std::cin >> arr[i];\n        val[i] = (arr[i] % 2 == 0) ? -1 : 1;\n    }\n    \n    std::vector<int> costs;\n    int sum = 0;\n    \n    for (int i = 0; i < n - 1; i++) {\n        sum += val[i];\n        if (sum == 0) {\n            int diff = arr[i + 1] - arr[i];\n            costs.push_back(std::abs(diff));\n        }\n    }\n    \n    std::sort(costs.begin(), costs.end());\n    \n    int spent = 0;\n    int picked = 0;\n    \n    for (int c : costs) {\n        if (spent + c <= budget) {\n            spent += c;\n            picked++;\n        }\n    }\n    \n    std::cout << picked << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00023552982020191848, -2.861018856492592e-06, -2.3841855067985307e-07, -0.0001472126314183697, -1.6689286894688848e-06, -9.65590606938349e-06, -7.152555099310121e-07, -3.4570634852570947e-06, -1.6212332411669195e-05, -0.00012718822108581662, -1.6689286894688848e-06, -1.2278481335670222e-05, -3.576278118089249e-07, -0.0001908358681248501, -1.1920922133867862e-06, -2.777537883957848e-05, -1.3828182090946939e-05, -0.006771119311451912, -0.34844961762428284, -0.6326125264167786, -3.576272320060525e-06, -2.861018856492592e-06, -2.3841855067985307e-07, -1.9073468138230965e-06, -0.11303626745939255, -3.576278118089249e-07, -0.0012159105390310287, -1.4305104514278355e-06, -8.583032467868179e-06, -7.390948667307384e-06, -0.00012385078298393637, -5.960462772236497e-07, -0.00044109628652222455, -1.1920928244535389e-07, -7.152555099310121e-07, -0.00033