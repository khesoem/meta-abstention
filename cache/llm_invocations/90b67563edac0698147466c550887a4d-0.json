e(n)]\n    visited = [[0] * n for _ in range(n)]\n    \n    if startX != -1 and startY != -1:\n        dist[startX][startY] = 0\n        visited[startX][startY] = 1\n        qx, qy = deque(), deque()\n        qx.append(startX)\n        qy.append(startY)\n        \n        while qx:\n            x = qx.popleft()\n            y = qy.popleft()\n            for k in range(4):\n                nx, ny = x + dx[k], y + dy[k]\n                if inRange(nx, ny) and not visited[nx][ny]:\n                    dist[nx][ny] = dist[x][y] + 1\n                    visited[nx][ny] = 1\n                    qx.append(nx)\n                    qy.append(ny)\n    \n    def checkPath(x0, y0, x1, y1, step):\n        if step > maxTime:\n            return False\n        if memo[x0][y0][x1][y1][step] != -1:\n            return memo[x0][y0][x1][y1][step]\n        if x0 == x1 and y0 == y1:\n            memo[x0][y0][x1][y1][step] = (dist[x0][y0] >= step)\n            return memo[x0][y0][x1][y1][step]\n        if dist[x0][y0] <= step:\n            memo[x0][y0][x1][y1][step] = False\n            return False\n        for k in range(4):\n            nx, ny = x0 + dx[k], y0 + dy[k]\n            if inRange(nx, ny) and checkPath(nx, ny, x1, y1, step + 1):\n                memo[x0][y0][x1][y1][step] = True\n                return True\n        memo[x0][y0][x1][y1][step] = False\n        return False\n    \n    # Build capacity graph\n    cap = [[0] * (2 * m + 2) for _ in range(2 * m + 2)]\n    \n    for i in range(m):\n        cap[0][i + 1] = sciCap[i]\n        cap[m + 1 + i][2 * m + 1] = labCap[i]\n    \n    for i in range(m):\n        for j in range(m):\n            if checkPath(coords[i][0], coords[i][1], coords[j][0], coords[j][1], 0):\n                cap[i + 1][m + 1 + j] = 1000\n    \n    # Ford-Fulkerson / BFS for max flow\n    def bfs(src, dst):\n        parent = [-1] * (2 * m + 2)\n        parent[src] = -2\n        q = deque([src])\n        while q:\n            u = q.popleft()\n            