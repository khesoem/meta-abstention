ist, pred, pe, inq\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    timeLayers = 101\n    max_node = n * timeLayers + 2\n    source = n * timeLayers\n    target = n * timeLayers + 1\n    e = []\n    g = [[] for _ in range(max_node)]\n    ans = 0\n    # read starting positions\n    for _ in range(k):\n        x = next(it) - 1\n        addEdge(source, x, 1, 0)\n    # add edges from time layers to target\n    for i in range(timeLayers):\n        addEdge(i * n, target, k, i * c)\n    # read roads\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        for i in range(timeLayers - 1):\n            for j in range(k):\n                addEdge(x + i * n, y + i * n + n, 1, d * (j * 2 + 1))\n        for i in range(timeLayers - 1):\n            for j in range(k):\n                addEdge(y + i * n, x + i * n + n, 1, d * (j * 2 + 1))\n\nINF64 = 10**18\nn = m = k = c = d = 0\ntimeLayers = 101\nsource = target = 0\ne = []\ng = []\nans = 0\ndist = []\npred = []\npe = []\ninq = []\n\nif __name__ == \"__main__\":\n    inputAndBuildGraph()\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.145764938177308e-06, 0.0, 0.0, -0.0009348789462819695, -0.0032443765085190535, 0.0, -9.7508447652217e-05, -6.05564855504781e-05, 0.0, -1.1920928244535389e-07, -1.6689286894688848e-06, -6.210611172718927e-05, -0.07892324030399323, -0.6245123744010925, -0.025352848693728447, -2.861018856492592e-06, -0.2164597511291504, -0.5008435249328613, -4.565611743601039e-05, -8.344646857949556e-07, 0.0, 0.0, -1.1920928244535389e-07, -9.536738616588991e-07, 0.0, 0.0, -0.0019287331961095333, -0.01924731396138668, -0.0007101159426383674, 0.0, -0.01815043017268181, -0.6064770817756653, 0.0, 0.0, -0.023245912045240402, -0.0849279835820198, 0.0, 0.0, -0.00043108707177452743, -0.018164945766329765, -0.014623483642935753, -4.160317621