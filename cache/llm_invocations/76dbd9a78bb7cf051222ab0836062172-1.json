{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n// luogu-judger-enable-o2\n#include<bits/stdc++.h>\nusing namespace std;\n#define pii pair<int,int>\n#define mp make_pair\n#define inf 100000000\n#define nn 6000\nnamespace mcmf{\n\tvector<int> v[nn],rev[nn],cost[nn],cap[nn];\n\tvoid add_edge(int x,int y,int c,int w)\n\t{\n\t\trev[x].push_back(v[y].size());rev[y].push_back(v[x].size());\n\t\tv[x].push_back(y);v[y].push_back(x);\n\t\tcost[x].push_back(w);cost[y].push_back(-w);\n\t\tcap[x].push_back(c);cap[y].push_back(0);\n\t}\n\t\n\tint dist[nn];int vis[nn];\n\tint prex[nn],prei[nn];\n\tvoid spfa(int s)\n\t{\n\t\tmemset(dist,0x3f,sizeof dist);\n\t\tmemset(vis,0,sizeof vis);prex[s]=-1;\n\t\tqueue<int> q;q.push(s);dist[s]=0;vis[s]=1;\n\t\t\n\t\twhile(q.size())\n\t\t{\n\t\t\tint x=q.front();q.pop();vis[x]=0;\n\t\t\tfor(int i=0;i<v[x].size();i++)\n\t\t\t{\n\t\t\t\tint y=v[x][i];\n\t\t\t\tint cc=dist[x]+cost[x][i];\n\t\t\t\tif(dist[y]>cc and cap[x][i])\n\t\t\t\t{\n\t\t\t\t\tdist[y]=cc;prex[y]=x,prei[y]=i;\n\t\t\t\t\tif(!vis[y]) vis[y]=1,q.push(y);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t\n\t}\n\t\n\tint tot=0;\n\tint dfs(int x,int flow)\n\t{\n\t\tif(prex[x]==-1) return flow;\n\t\tint y=x;x=prex[y];int i=prei[y],j=rev[x][i];\n\t\tint f=dfs(x,min(flow,cap[x][i]));\n\t\tcap[x][i]-=f,cap[y][j]+=f;\n\t\treturn f;\n\t}\n\t\n\tpii solve(int s,int t)\n\t{\n\t\tint ans=0;tot=0;\n\t\twhile(1)\n\t\t{\n\t\t\tspfa(s);\n\t\t\tif(dist[t]>1e9) break;\n\t\t\tint f=dfs(t,inf);\n\t\t\ttot+=f*dist[t];\n\t\t\tans+=f;\n\t\t}\n\t\treturn mp(ans,tot);\n\t}\n\t\n};\n\n\nint n,m,s=nn-1,t=nn-2;\nint k,c,d;\nint get(int x,int tim){\n\treturn tim*52-52+x;\n}\nint main() \n{\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);int kk=k;\n\twhile(k--){\n\t\tint x;scanf(\"%d\",&x);\n\t\tmcmf::add_edge(s,get(x,1),1,0);\n\t}k=kk;\n\twhile(m--){\n\t\tint x,y;scanf(\"%d%d\",&x,&y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t\t\n\t\tswap(x,y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t}\n\tfor(int i=1;i<100;i++){\n\t\tfor(int j=1;j<=n;j++) mcmf::add_edge(get(j,i),get(j,i+1),inf,0);\n\t\tmcmf::add_edge(get(1,i),t,inf,c*(i-1));\n\t}\n\t\n\tprintf(\"%d\",mcmf::solve(s,t).second);\n\t\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nnn = 6000\n\nclass MCMF:\n    def __init__(self):\n        self.v = [[] for _ in range(nn)]\n        self.rev = [[] for _ in range(nn)]\n        self.cost = [[] for _ in range(nn)]\n        self.cap = [[] for _ in range(nn)]\n    \n    def add_edge(self, x, y, c, w):\n        self.rev[x].append(len(self.v[y]))\n        self.rev[y].append(len(self.v[x]))\n        self.v[x].append(y)\n        self.v[y].append(x)\n        self.cost[x].append(w)\n        self.cost[y].append(-w)\n        self.cap[x].append(c)\n        self.cap[y].append(0)\n    \n    def spfa(self, s, dist, vis, prex, prei):\n        INF = 10**9\n        dist[:] = [INF] * nn\n        vis[:] = [0] * nn\n        prex[:] = [-1] * nn\n        q = deque()\n        q.append(s)\n        dist[s] = 0\n        vis[s] = 1\n        \n        while q:\n            x = q.popleft()\n            vis[x] = 0\n            for i in range(len(self.v[x])):\n                y = self.v[x][i]\n                cc = dist[x] + self.cost[x][i]\n                if dist[y] > cc and self.cap[x][i] > 0:\n                    dist[y] = cc\n                    prex[y] = x\n                    prei[y] = i\n                    if vis[y] == 0:\n                        vis[y] = 1\n                        q.append(y)\n    \n    def dfs(self, x, flow, prex, prei):\n        if prex[x] == -1:\n            return flow\n        y = x\n        x = prex[y]\n        i = prei[y]\n        j = self.rev[x][i]\n        f = self.dfs(x, min(flow, self.cap[x][i]), prex, prei)\n        self.cap[x][i] -= f\n        self.cap[y][j] += f\n        return f\n    \n    def solve(self, s, t):\n        ans = 0\n        tot = 0\n        dist = [0] * nn\n        vis = [0] * nn\n        prex = [-1] * nn\n        prei = [0] * nn\n        \n        while True:\n            self.spfa(s, dist, vis, prex, prei)\n            if dist[t] > 1e9:\n                break\n            f = self.dfs(t, 10**9, prex, prei)\n            tot += f * dist[t]\n            ans += f\n        \n        return (ans, tot)\n\ndef get(x, tim):\n    return tim * 52 - 52 + x\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    original_k = k\n    \n    s = nn - 1\n    t = nn - 2\n    mcmf = MCMF()\n    \n    # Add edges from source to first day for each person\n    for _ in range(k):\n        x = int(next(it))\n        mcmf.add_edge(s, get(x, 1), 1, 0)\n    \n    k = original_k\n    \n    # Add edges for flights\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        \n        x, y = y, x\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n    \n    # Add edges for staying at the same location\n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            mcmf.add_edge(get(j, i), get(j, i + 1), 10**9, 0)\n        mcmf.add_edge(get(1, i), t, 10**9, c * (i - 1))\n    \n    result = mcmf.solve(s, t)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020311199477873743, -1.0728830375228426e-06, -3.576278118089249e-07, -0.001416751998476684, -0.002552824327722192, -8.344646857949556e-07, -0.00026341783814132214, -0.00015484087634831667, -1.6689286894688848e-06, -0.0011749514378607273, -0.016048777848482132, -0.5651020407676697, -3.933898824470816e-06, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -6.318072337307967e-06, -0.1798776090145111, -0.0037472285330295563, -0.00048685140791349113, -0.00010561384988250211, -1.0728830375228426e-06, -4.6491513785440475e-06, -1.1920928244535389e-07, -1.0728830375228426e-06, -2.8967437174287625e-05, -5.960462772236497e-07, -3.576278118089249e-07, -4.768370445162873e-07, -0.0430024228990078, -2.5629668016335927e-05, -2.264974000354414e-06, -0.0008593680104240775, -9.059865078597795e-06, -1.6927575416048057e-05, -2.50339189733495e-06, 0.0, -1.1920922133867862e-06, -4.768370445162873e-07, -1.5497195136049413e-06, -4.529942543740617e-06, -4.0531076592742465e-06, -4.768370445162873e-07, -1.4543427823809907e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -8.821448318485636e-06, -4.2437604861333966e-05, -4.291525328881107e-06, -4.172316494077677e-06, -8.51118093123659