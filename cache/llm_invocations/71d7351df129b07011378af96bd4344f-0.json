{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <iomanip>\n#include <cassert>\n#include <climits>\n#include <cstring>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst int T = 99;\nconst int C = 12;\nconst ll INF = 0x3f3f3f3f3f3f3f3fLL;\n\nstruct Edge {\n    int to, rev;\n    ll flow, cap, cost;\n};\n\nstruct MCF {\n    int N;\n    vector<vector<Edge>> g;\n    vector<ll> dist, h;\n    vector<int> prevv, preve;\n\n    MCF(int n) : N(n), g(n), dist(n), h(n), prevv(n), preve(n) {}\n\n    void addEdge(int u, int v, ll c, ll p) {\n        g[u].push_back({v, (int)g[v].size(), 0, c, p});\n        g[v].push_back({u, (int)g[u].size()-1, 0, 0, -p});\n    }\n\n    ll minCostFlow(int s, int t, ll& totalCost) {\n        totalCost = 0;\n        ll flow = 0;\n\n        for (ll lim = 1LL << 30; lim > 0; lim >>= 1) {\n            while (true) {\n                fill(dist.begin(), dist.end(), INF);\n                fill(prevv.begin(), prevv.end(), -1);\n                dist[s] = 0;\n\n                priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n                pq.push({0, s});\n\n                while (!pq.empty()) {\n                    auto [d, u] = pq.top(); pq.pop();\n                    if (d > dist[u]) continue;\n                    for (int i = 0; i < g[u].size(); ++i) {\n                        auto& e = g[u][i];\n                        if (e.cap - e.flow >= lim && dist[e.to] > dist[u] + h[u] - h[e.to] + e.cost) {\n                            dist[e.to] = dist[u] + h[u] - h[e.to] + e.cost;\n                            prevv[e.to] = u;\n                            preve[e.to] = i;\n                            pq.push({dist[e.to], e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] >= INF) break;\n\n                for (int i = 0; i < N; ++i) {\n                    if (dist[i] < INF) h[i] += dist[i];\n                }\n\n                ll df = INF;\n                for (int v = t; v != s; v = prevv[v]) {\n                    df = min(df, g[prevv[v]][preve[v]].cap - g[prevv[v]][preve[v]].flow);\n                }\n\n                for (int v = t; v != s; v = prevv[v]) {\n                    auto& e = g[prevv[v]][preve[v]];\n                    e.flow += df;\n                    g[v][e.rev].flow -= df;\n                    totalCost += df * g[v][e.rev].cost;\n                }\n                flow += df;\n            }\n        }\n        return flow;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int src = 0;\n    int dst = n * T + 1;\n    MCF network(dst + 1);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        network.addEdge(src, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        network.addEdge(1 + t * n, dst, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                network.addEdge(i + (t - 1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            int cost = (j + 1) * (j + 1) - j * j;\n            for (int t = 1; t < T; ++t) {\n                network.addEdge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                network.addEdge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price;\n    ll flow = network.minCostFlow(src, dst, price);\n    assert(flow == k);\n    cout << price << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int T = 99;\n    static final int C = 12;\n    static final long INF = 0x3f3f3f3f3f3f3f3fL;\n\n    static class Edge {\n        int to, rev;\n        long flow, cap, cost;\n\n        Edge(int to, int rev, long flow, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.flow = flow;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class MCF {\n        int N;\n        List<List<Edge>> g;\n        long[] dist, h;\n        int[] prevv, preve;\n\n        MCF(int n) {\n            N = n;\n            g = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                g.add(new ArrayList<>());\n            }\n            dist = new long[n];\n            h = new long[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void addEdge(int u, int v, long c, long p) {\n            g.get(u).add(new Edge(v, g.get(v).size(), 0, c, p));\n            g.get(v).add(new Edge(u, g.get(u).size() - 1, 0, 0, -p));\n        }\n\n        long minCostFlow(int s, int t, long[] totalCost) {\n            totalCost[0] = 0;\n            long flow = 0;\n\n            for (long lim = 1L << 30; lim > 0; lim >>= 1) {\n                while (true) {\n                    Arrays.fill(dist, INF);\n                    Arrays.fill(prevv, -1);\n                    dist[s] = 0;\n\n                    PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n                    pq.offer(new long[]{0, s});\n\n                    while (!pq.isEmpty()) {\n                        long[] cur = pq.poll();\n                        long d = cur[0];\n                        int u = (int) cur[1];\n                        if (d > dist[u]) continue;\n                        for (int i = 0; i < g.get(u).size(); ++i) {\n                            Edge e = g.get(u).get(i);\n                            if (e.cap - e.flow >= lim && dist[e.to] > dist[u] + h[u] - h[e.to] + e.cost) {\n                                dist[e.to] = dist[u] + h[u] - h[e.to] + e.cost;\n                                prevv[e.to] = u;\n                                preve[e.to] = i;\n                                pq.offer(new long[]{dist[e.to], e.to});\n                            }\n                        }\n                    }\n\n                    if (dist[t] >= INF) break;\n\n                    for (int i = 0; i < N; ++i) {\n                        if (dist[i] < INF) h[i] += dist[i];\n                    }\n\n                    long df = INF;\n                    for (int v = t; v != s; v = prevv[v]) {\n                        Edge e = g.get(prevv[v]).get(preve[v]);\n                        df = Math.min(df, e.cap - e.flow);\n                    }\n\n                    for (int v = t; v != s; v = prevv[v]) {\n                        Edge e = g.get(prevv[v]).get(preve[v]);\n                        e.flow += df;\n                        g.get(v).get(e.rev).flow -= df;\n                        totalCost[0] += df * g.get(v).get(e.rev).cost;\n                    }\n                    flow += df;\n                }\n            }\n            return flow;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int src = 0;\n        int dst = n * T + 1;\n        MCF network = new MCF(dst + 1);\n\n        for (int i = 0; i < k; ++i) {\n            int a = sc.nextInt();\n            network.addEdge(src, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; ++t) {\n            network.addEdge(1 + t * n, dst, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; ++i) {\n                    network.addEdge(i + (t - 1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; ++j) {\n                int cost = (j + 1) * (j + 1) - j * j;\n                for (int t = 1; t < T; ++t) {\n                    network.addEdge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                    network.addEdge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n\n        long[] price = new long[1];\n        long flow = network.minCostFlow(src, dst, price);\n        assert flow == k;\n        System.out.println(price[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001382732152706012, -2.7418097943154862e-06, -9.536738616588991e-07, -0.006869035307317972, -6.711257447022945e-05, -0.31328630447387695, -0.6326624751091003, -0.00021217002358753234, -9.536738616588991e-07, -7.855583680793643e-05, -0.016034699976444244, -4.6132929128361866e-05, -0.004387514665722847, -0.5306103229522705, -0.38688817620277405, -1.549708758830093e-05, -7.56950321374461e-05, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07,