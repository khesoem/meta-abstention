 int pr = 1;\n            for (int j = 0; j < n; ++j)\n                if (s >> j & 1)\n                    pr = LL(pr) * p[i - 1][j] % MOD;\n                else\n                    pr = LL(pr) * (1 + MOD - p[i - 1][j]) % MOD;\n            for (auto [f, _p] : families[i - 1]) {\n                LL mask = 0;\n                for (int t : subsets[i])\n                    for (int j = 0; j < n; ++j)\n                        if ((t >> j & 1) && (s >> j & 1) && (f >> id[i - 1][t ^ 1 << j] & 1)) {\n                            mask |= 1LL << id[i][t];\n                            break;\n                        }\n                families[i][mask] = (families[i][mask] + LL(_p) * pr) % MOD;\n            }\n        }\n    }\n    cout << families[n][1] << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    \n    static long power(long a, int b) {\n        long ans = 1;\n        while (b > 0) {\n            if ((b & 1) == 1)\n                ans = (ans * a) % MOD;\n            a = (a * a) % MOD;\n            b >>= 1;\n        }\n        return ans;\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        \n        int n = Integer.parseInt(br.readLine());\n        long[][] p = new long[n][n];\n        \n        long inv100 = power(100, MOD - 2);\n        \n        for (int i = 0; i < n; i++) {\n            String[] line = br.readLine().split(\" \");\n            for (int j = 0; j < n; j++) {\n                p[i][j] = (Long.parseLong(line[j]) * inv100) % MOD;\n            }\n        }\n        \n        List<List<Integer>> id = new ArrayList<>();\n        List<List<Integer>> subsets = new ArrayList<>();\n        \n        for (int sz = 0; sz <= n; sz++) {\n            id.add(new ArrayList<>(1 << n));\n            subsets.add(new ArrayList<>());\n            \n            for (int s = 0; s < (1 << n); s++) {\n                if (Integer.bitCount(s) == sz) {\n                    id.get(sz).add(subsets.get(sz).size());\n                    subsets.get(sz).add(s);\n                } else {\n                    id.get(sz).add(-1);\n                }\n            }\n        }\n        \n        Map<Long, Long>[] families = new Map[n + 1];\n        for (int i = 0; i <= n; i++) {\n            families[i] = new HashMap<>();\n        }\n        \n        families[0].put(1L, 1L);\n        \n        for (int i = 1; i <= n; i++) {\n            for (int s = 0; s < (1 << n); s++) {\n                long pr = 1;\n                for (int j = 0; j < n; j++) {\n                    if (((s >> j) & 1) == 1) {\n                        pr = (pr * p[i - 1][j]) % MOD;\n                    } else {\n                        pr = (pr * (1 + MOD - p[i - 1][j])) % MOD;\n                    }\n                }\n                \n                for (Map.Entry<Long, Long> entry : families[i - 1].entrySet()) {\n                    long f = entry.getKey();\n                    long _p = entry.getValue();\n                    \n                    long mask = 0;\n                    for (int t : subsets.get(i)) {\n                        boolean shouldSet = false;\n                        for (int j = 0; j < n; j++) {\n                            if (((t >> j) & 1) == 1 && ((s >> j) & 1) == 1) {\n                                int prevIndex = t ^ (1 << j);\n                                if (prevIndex >= 0 && prevIndex < id.get(i - 1).size()) {\n                                    int idx = id.get(i - 1).get(prevIndex);\n                                    if (idx != -1 && ((f >> idx) & 1) == 1) {\n                                        shouldSet = true;\n     