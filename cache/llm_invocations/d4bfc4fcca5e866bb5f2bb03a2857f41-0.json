{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class CF552C {\n    private static int limit;\n    private static int base;\n    private static Set<Long> combinations;\n\n    public static void main(String[] args) throws Exception {\n        InputReader in = new InputReader(System.in);\n        PrintWriter pw = new PrintWriter(new OutputStreamWriter(System.out));\n\n        base = in.nextInt();\n        long n = in.nextLong();\n\n        limit = 0;\n        for (int i = 0; base > 2 && i < 21; i++) {\n            limit = i;\n            if (Math.pow(base, i) > 1e9) break;\n        }\n\n        combinations = new HashSet<>();\n        if (base > 2) {\n            explore(0, 0L);\n        }\n\n        boolean ok = (base == 2);\n        if (!ok) {\n            for (long x : combinations) {\n                if (x >= n && combinations.contains(x - n)) {\n                    ok = true;\n                    break;\n                }\n            }\n        }\n\n        pw.println(ok ? \"YES\" : \"NO\");\n        pw.close();\n    }\n\n    private static void explore(int level, long total) {\n        if (level > limit) {\n            combinations.add(total);\n            return;\n        }\n        explore(level + 1, total + (long) Math.pow(base, level));\n        explore(level + 1, total);\n    }\n\n    static class InputReader {\n        private BufferedReader br;\n        private StringTokenizer st;\n\n        public InputReader(InputStream is) {\n            br = new BufferedReader(new InputStreamReader(is));\n            st = null;\n        }\n\n        private String nextToken() throws Exception {\n            while (st == null || !st.hasMoreTokens()) {\n                st = new StringTokenizer(br.readLine());\n            }\n            return st.nextToken();\n        }\n\n        public String next() throws Exception { return nextToken(); }\n        public String nextLine() throws Exception { st = null; return br.readLine(); }\n        public int nextInt() throws Exception { return Integer.parseInt(nextToken()); }\n        public double nextDouble() throws Exception { return Double.parseDouble(nextToken()); }\n        public long nextLong() throws Exception { return Long.parseLong(nextToken()); }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <set>\n#include <cmath>\n#include <string>\n#include <sstream>\n#include <algorithm>\n\nusing namespace std;\n\nint limit;\nint base;\nset<long long> combinations;\n\nvoid explore(int level, long long total) {\n    if (level > limit) {\n        combinations.insert(total);\n        return;\n    }\n    explore(level + 1, total + (long long)pow(base, level));\n    explore(level + 1, total);\n}\n\nclass InputReader {\nprivate:\n    istream& is;\n    string line;\n    vector<string> tokens;\n    int tokenIndex;\n\npublic:\n    InputReader(istream& input) : is(input), tokenIndex(0) {}\n\n    string nextToken() {\n        while (tokenIndex >= tokens.size()) {\n            if (!getline(is, line)) return \"\";\n            tokens.clear();\n            istringstream iss(line);\n            string token;\n            while (iss >> token) {\n                tokens.push_back(token);\n            }\n            tokenIndex = 0;\n        }\n        return tokens[tokenIndex++];\n    }\n\n    string next() { return nextToken(); }\n    string nextLine() { \n        tokenIndex = tokens.size(); \n        return nextToken(); \n    }\n    int nextInt() { return stoi(nextToken()); }\n    double nextDouble() { return stod(nextToken()); }\n    long long nextLong() { return stoll(nextToken()); }\n};\n\nint main() {\n    InputReader in(cin);\n    \n    base = in.nextInt();\n    long long n = in.nextLong();\n\n    limit = 0;\n    for (int i = 0; base > 2 && i < 21; i++) {\n        limit = i;\n        if (pow(base, i) > 1e9) break;\n    }\n\n    combinations.clear();\n    if (base > 2) {\n        explore(0, 0LL);\n    }\n\n    bool ok = (base == 2);\n    if (!ok) {\n        for (long long x : combinations) {\n            if (x >= n && combinations.find(x - n) != combinations.end()) {\n                ok = true;\n                break;\n            }\n        }\n    }\n\n    cout << (ok ? \"YES\" : \"NO\") << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011598391574807465, -2.9802276912960224e-06, -2.3841855067985307e-07, -7.748303323751315e-05, -4.768370445162873e-07, -1.2755313036905136e-05, -3.2186455882765586e-06, -7.748573807475623e-06, -3.576278118089249e-07, -0.13319581747055054, -1.311301275563892e-06, -5.483612312673358e-06, -4.768370445162873e-07, -0.1481485366821289, -1.311301275563892e-06, -1.6689286894688848e-06, -2.264974000354414e-06, -0.0035179888363927603, -5.960462772236497e-07, -1.0132738680113107e-05, -1.1920928244535389e-07, -0.19275540113449097, -3.4570634852570947e-06, -2.002696055569686e-05, -3.099436753473128e-06, -0.012969544157385826, -0.023247