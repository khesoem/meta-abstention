                 Edge &e=g[u][i];\n                    if(e.cap<=0) continue;\n                    int v=e.to;\n                    int nd=d+e.cost+pot[u]-pot[v];\n                    if(dist[v]>nd) {\n                        dist[v]=nd;\n                        pq.push({nd,v});\n                        prevnode[v]=u;\n                        prevedge[v]=i;\n                        curflow[v]=min(curflow[u], e.cap);\n                    }\n                }\n            }\n            if(dist[t]==INT_MAX) break;\n            for(int i=0;i<n;++i) pot[i]+=dist[i];\n            int df=min(curflow[t], INF-flow);\n            flow+=df;\n            for(int v=t; v!=s; v=prevnode[v]) {\n                Edge &e=g[prevnode[v]][prevedge[v]];\n                e.cap-=df;\n                g[v][e.rev].cap+=df;\n                cost+=df*e.cost;\n            }\n        }\n        return {flow, cost};\n    }\n};\n\nint main(){\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n,m,k,c,d;\n    cin>>n>>m>>k>>c>>d;\n    auto id=[&](int time, int city){ return 1 + time*n + city; };\n    MCF mcf(6+107*n);\n    for(int i=0;i<k;++i) {\n        int x; cin>>x; --x;\n        mcf.addEdge(0, id(0,x), 1, 0);\n    }\n    for(int i=0;i<m;++i) {\n        int x,y; cin>>x>>y; --x; --y;\n        for(int t=0;t<105;++t) {\n            for(int j=0;j<51;++j) {\n                mcf.addEdge(id(t,x), id(t+1,y), 1, c+d*(2*j+1));\n                mcf.addEdge(id(t,y), id(t+1,x), 1, c+d*(2*j+1));\n            }\n        }\n    }\n    for(int t=0;t<105;++t)\n        for(int city=0;city<n;++city)\n            mcf.addEdge(id(t,city), id(t+1,city), 51, c);\n    for(int t=0;t<105;++t)\n        mcf.addEdge(id(t,0), 1+105*n, 51, 0);\n    auto ans=mcf.minCostFlow(0, 1+105*n);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.g = [[] for _ in range(n)]\n        self.dist = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n\n    def addEdge(self, s, t, cap, cost):\n        forward = [t, cap, cost, len(self.g[t])]\n        backward = [s, 0, -cost, len(self.g[s])]\n        self.g[s].append(forward)\n        self.g[t].append(backward)\n\n    def minCostFlow(self, s, t):\n        INF = 10**18\n        flow = 0\n        cost = 0\n        while flow < INF:\n            pq = []\n            self.dist = [INF] * self.n\n            self.dist[s] = 0\n            self.curflow[s] = INF\n            heapq.heappush(pq, (0, s))\n            while pq:\n                d, u = heapq.heappop(pq)\n                if d != self.dist[u]:\n                    continue\n                for i, e in enumerate(self.g[u]):\n                    if e[1] <= 0:\n                        continue\n                    v = e[0]\n                    nd = d + e[2] + self.pot[u] - self.pot[v]\n                    if self.dist[v] > nd:\n                        self.dist[v] = nd\n                        heapq.heappush(pq, (nd, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e[1])\n            if self.dist[t] == INF:\n                break\n            for i in range(self.n):\n                self.pot[i] += self.dist[i]\n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            v = t\n            while v != s:\n                u = self.prevnode[v]\n                e = self.g[u][self.prevedge[v]]\n                e[1] -= df\n                rev = self.g[v][e[3]]\n                rev[1] += df\n                cost += df * e[2]\n                v = u\n        return (flow, cost)\n\ndef main():\n    data = sys.stdin.read().spl