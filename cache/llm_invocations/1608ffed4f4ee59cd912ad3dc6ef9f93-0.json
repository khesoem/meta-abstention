sb = new StringBuilder(\"_\");\n        for (int i = 0; i < n; i++) {\n            char ch = s.charAt(i);\n            if (ch == '(') {\n                i++;\n                while (i < n && s.charAt(i) != ')') {\n                    sb.append(s.charAt(i));\n                    i++;\n                }\n                sb.append('_');\n            } else {\n                i++;\n            }\n        }\n        sb.append('_');\n        return sb.toString();\n    }\n\n    private static int findLongestConsecutiveNonUnderscore(String s) {\n        int maxRun = 0, currentRun = 0;\n        for (char c : s.toCharArray()) {\n            if (c == '_') {\n                if (currentRun > maxRun) maxRun = currentRun;\n                currentRun = 0;\n            } else {\n                currentRun++;\n            }\n        }\n        if (currentRun > maxRun) maxRun = currentRun;\n        return maxRun;\n    }\n\n    private static int countNonEmptyGroups(String s) {\n        int count = 0;\n        int lastNonUnderscoreIndex = -1;\n        for (int i = 0; i < s.length(); i++) {\n            if (s.charAt(i) != '_') {\n                lastNonUnderscoreIndex = i;\n            } else if (lastNonUnderscoreIndex >= 0) {\n                count++;\n                lastNonUnderscoreIndex = -1;\n            }\n        }\n        return count;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nstring buildUnderscoreString(const string& s, int n) {\n    string result = \"_\";\n    for (int i = 0; i < n; i++) {\n        char ch = s[i];\n        if (ch == '(') {\n            result += '_';\n            i++;\n            while (i < n && s[i] != ')') {\n                i++;\n            }\n        } else {\n            result += ch;\n        }\n    }\n    result +