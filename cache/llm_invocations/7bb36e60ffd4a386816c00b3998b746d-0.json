st);\n        head[u] = edge_idx++;\n        graph[edge_idx] = new Edge(u, head[v], 0, 0, -cost);\n        head[v] = edge_idx++;\n    }\n\n    static boolean bfs_shortest_path(int source, int sink) {\n        Queue<Integer> q = new LinkedList<>();\n        Arrays.fill(distance, INF);\n        Arrays.fill(in_queue, false);\n        Arrays.fill(prev_edge, -1);\n        distance[source] = 0;\n        in_queue[source] = true;\n        q.offer(source);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            in_queue[u] = false;\n            for (int i = head[u]; ~i != 0; i = graph[i].next) {\n                int v = graph[i].target;\n                if (graph[i].capacity > graph[i].flow && distance[v] > distance[u] + graph[i].cost) {\n                    distance[v] = distance[u] + graph[i].cost;\n                    prev_edge[v] = i;\n                    if (!in_queue[v]) {\n                        in_queue[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return prev_edge[sink] != -1;\n    }\n\n    static int min_cost_max_flow(int src, int dst, int[] total_cost) {\n        int flow = 0;\n        total_cost[0] = 0;\n        while (bfs_shortest_path(src, dst)) {\n            int bottleneck = INF;\n            for (int i = prev_edge[dst]; ~i != 0; i = prev_edge[graph[i ^ 1].target])\n                bottleneck = Math.min(bottleneck, graph[i].capacity - graph[i].flow);\n            for (int i = prev_edge[dst]; ~i != 0; i = prev_edge[graph[i ^ 1].target]) {\n                graph[i].flow += bottleneck;\n                graph[i ^ 1].flow -= bottleneck;\n                total_cost[0] += graph[i].cost * bottleneck;\n            }\n            flow += bottleneck;\n        }\n        return flow;\n    }\n\n    static int encode(int x, int y) {\n        return (x - 1) * 50 + y;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n   