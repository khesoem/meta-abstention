 ++i)\n                for (int j = 0; j < M; ++j) res.data[i][j] = add(data[i][j], other.data[i][j]);\n            return res;\n        }\n\n        Matrix<N, M> operator*(int scalar) const {\n            Matrix<N, M> res = *this;\n            for (int i = 0; i < N; ++i)\n                for (int j = 0; j < M; ++j) res.data[i][j] = (int)mul(res.data[i][j], scalar);\n            return res;\n        }\n\n        template<int X>\n        friend Matrix<N, M> multiply(const Matrix<N, X>& a, const Matrix<X, M>& b) {\n            Matrix<N, M> res;\n            res.clear();\n            for (int i = 0; i < N; ++i) {\n                for (int j = 0; j < X; ++j) {\n                    if (a.data[i][j]) {\n                        for (int k = 0; k < M; ++k)\n                            res.data[i][k] = add(res.data[i][k], (int)mul(a.data[i][j], b.data[j][k]));\n                    }\n                }\n            }\n            return res;\n        }\n    };\n}\n\nusing namespace matrix;\nusing ll = long long;\n\nll n;\nint K;\nvector<int> digits;\nMatrix<35, 35> base[65][35], prefix[65][35], suffix[65][35], result;\n\nint main() {\n    scanf(\"%lld%d\", &n, &K);\n    for (int i = 0; i < K; ++i) {\n        base[0][i].identity();\n        for (int j = 0; j <= K; ++j) base[0][i].data[i][j] = 1;\n    }\n\n    ll block_size = K;\n    for (int level = 1; block_size <= n; ++level, block_size *= K) {\n        suffix[level - 1][K - 1] = base[level - 1][K - 1];\n        for (int j = K - 2; j >= 0; --j)\n            suffix[level - 1][j] = multiply(base[level - 1][j], suffix[level - 1][j + 1]);\n\n        prefix[level - 1][0] = base[level - 1][0];\n        for (int j = 1; j < K; ++j)\n            prefix[level - 1][j] = multiply(prefix[level - 1][j - 1], base[level - 1][j]);\n\n        base[level][0] = suffix[level - 1][0];\n        for (int j = 1; j < K; ++j)\n            base[level][j] = multiply(suffix[level - 1][j], prefix[level - 1][j - 1]);\n    }\n\n    while (n > 0) {\n        