.clear()\n    for i in range(a.N):\n        for j in range(a.M):\n            if a.data[i][j]:\n                for k in range(b.M):\n                    res.data[i][k] = add(res.data[i][k], int(mul(a.data[i][j], b.data[j][k])))\n    return res\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    K = int(data[1])\n    \n    digits = []\n    \n    base = {}\n    prefix = {}\n    suffix = {}\n    \n    # Initialize base[0][i]\n    for i in range(K):\n        base[(0, i)] = Matrix(35, 35)\n        base[(0, i)].identity()\n        for j in range(K + 1):\n            base[(0, i)].data[i][j] = 1\n    \n    block_size = K\n    level = 1\n    while block_size <= n:\n        # suffix[level-1][K-1] = base[level-1][K-1]\n        suffix[(level-1, K-1)] = Matrix(35, 35)\n        for i in range(35):\n            for j in range(35):\n                suffix[(level-1, K-1)].data[i][j] = base[(level-1, K-1)].data[i][j]\n        \n        # suffix[level-1][j] = base[level-1][j] * suffix[level-1][j+1]\n        for j in range(K-2, -1, -1):\n            suffix[(level-1, j)] = multiply(base[(level-1, j)], suffix[(level-1, j+1)])\n        \n        # prefix[level-1][0] = base[level-1][0]\n        prefix[(level-1, 0)] = Matrix(35, 35)\n        for i in range(35):\n            for j in range(35):\n                prefix[(level-1, 0)].data[i][j] = base[(level-1, 0)].data[i][j]\n        \n        # prefix[level-1][j] = prefix[level-1][j-1] * base[level-1][j]\n        for j in range(1, K):\n            prefix[(level-1, j)] = multiply(prefix[(level-1, j-1)], base[(level-1, j)])\n        \n        # base[level][0] = suffix[level-1][0]\n        base[(level, 0)] = Matrix(35, 35)\n        for i in range(35):\n            for j in range(35):\n                base[(level, 0)].data[i][j] = suffix[(level-1, 0)].data[i][j]\n        \n        # base[level][j] = suffix[level-1][j] * prefix[level-1][j-1]\n        for j in range(1, K):\n            base[(level, j)] = multiply(suffix[(level-1, j)], prefix[(level-1, j-1)])\n        \n        level += 1\n        block_size *= K\n    \n    # Extract digits\n    temp_n = n\n    while temp_n > 0:\n        digits.append(temp_n % K)\n        temp_n //= K\n    \n    carry = 0\n    result = Matrix(35, 35)\n    result.identity()\n    \n    for i in range(len(digits)-1, -1, -1):\n        for j in range(digits[i]):\n            result = multiply(result, base[(i, (j + carry) % K)])\n        carry = (carry + digits[i]) % K\n    \n    answer = 1\n    for i in range(K):\n        answer = add(answer, result.data[i][K])\n    \n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-9.536697689327411e-06, -0.00022289653134066612, -8.344646857949556e-07, -4.768370445162873e-07, -0.23733575642108917, -0.0006630606367252767, -0.009760040789842606, -0.0004742213059216738, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.012515575625002384, 0.0, -1.311301275563892e-06, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -0.00038187362952157855, -3.6954811548639555e-06, -0.0005540504935197532, -0.00010561384988250211, -1.6689160474925302e-05, -1.2993727978027891e-05, -1.1920922133867862e-06, -5.960446742392378e-06, -1.1920928244535389e-07, -1.9073468138230965e-06, -0.01251133717596531, 0.0, -3.576278118089249e-07, 0.0, -3.576278118089249e-07, -8.344646857949556e-07, 0.0, -2.3245540432981215e-05, -3.576278118089249e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -3.576272320060525e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.291525328881107e-06, -1.156323378381785e-05, -5.960462772236497e-07, -0.00041261743172071874, -6.198863957251888e-06, -1.1920928244535389e-07, -6.90197994117625e-05, -7.986990567587782e-06, -1.1920928244535389e-07, -0.01815124973654747, 0.0, -3.9934315282152966e-05, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, 0.0, -1.78