{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n#define MAXN 15000\nstruct Edge {\n    int to, cap, flow, cost;\n};\nvector<Edge> e;\nvector<int> head[MAXN];\nlong long ans, dis[MAXN];\nint n, m, k, c, d, p[MAXN], pe[MAXN], inq[MAXN], s = 9998, t = 9999;\n\nvoid add_edge(int x, int y, int cap, int cost) {\n    head[x].push_back(e.size());\n    e.push_back({y, cap, 0, cost});\n    head[y].push_back(e.size());\n    e.push_back({x, 0, 0, -cost});\n}\n\nvoid push_rebel() {\n    fill(dis, dis + 10000, (long long)1e18);\n    fill(p, p + 10000, -1);\n    fill(pe, pe + 10000, -1);\n    fill(inq, inq + 10000, 0);\n    dis[s] = 0;\n    queue<int> q;\n    q.push(s);\n    inq[s] = 1;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = 0;\n        for (int idx : head[u]) {\n            if (!(e[idx].cap - e[idx].flow)) continue;\n            int cost = e[idx].cost, v = e[idx].to;\n            if (dis[v] > dis[u] + cost) {\n                dis[v] = dis[u] + cost;\n                p[v] = u;\n                pe[v] = idx;\n                if (!inq[v]) {\n                    inq[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    int cur = t;\n    while (cur != s) {\n        e[pe[cur]].flow++;\n        e[pe[cur] ^ 1].flow--;\n        cur = p[cur];\n    }\n    ans += dis[t];\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int x, y;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &x);\n        x--;\n        add_edge(s, x, 1, 0);\n    }\n    for (int i = 1; i <= 101; i++)\n        add_edge((i - 1) * n, t, k, (i - 1) * c);\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d%d\", &x, &y);\n        x--; y--;\n        for (int i = 1; i <= 100; i++)\n            for (int j = 1; j <= k; j++) {\n                add_edge(x + (i - 1) * n, y + (i - 1) * n + n, 1, d * ((j - 1) * 2 + 1));\n                add_edge(y + (i - 1) * n, x + (i - 1) * n + n, 1, d * ((j - 1) * 2 + 1));\n            }\n    }\n    for (int i = 1; i <= n; i++)\n        for (int j = 1; j <= 100; j++)\n            add_edge(i - 1 + (j - 1) * n, i - 1 + (j - 1) * n + n, k, 0);\n    for (int i = 1; i <= k; i++) push_rebel();\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    MAXN = 10000\n    s = 9998\n    t = 9999\n\n    e = []  # each edge: [to, cap, flow, cost]\n    head = [[] for _ in range(MAXN)]\n\n    def add_edge(x, y, cap, cost):\n        head[x].append(len(e))\n        e.append([y, cap, 0, cost])\n        head[y].append(len(e))\n        e.append([x, 0, 0, -cost])\n\n    # source to starting positions\n    for _ in range(k):\n        x = next(it) - 1\n        add_edge(s, x, 1, 0)\n\n    # sink edges from city 0 at each time\n    for i in range(1, 102):  # i from 1 to 101 inclusive\n        add_edge((i - 1) * n, t, k, (i - 1) * c)\n\n    # read m edges and add movement edges\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        for i in range(1, 101):  # time layers 1..100\n            for j in range(1, k + 1):\n                cost = d * ((j - 1) * 2 + 1)\n                add_edge(x + (i - 1) * n, y + i * n, 1, cost)\n                add_edge(y + (i - 1) * n, x + i * n, 1, cost)\n\n    # stay edges (same city, next time)\n    for city in range(n):\n        for time in range(1, 101):\n            add_edge(city + (time - 1) * n, city + time * n, k, 0)\n\n    INF = 10**18\n    dis = [0] * MAXN\n    p = [0] * MAXN\n    pe = [0] * MAXN\n    inq = [0] * MAXN\n    ans = 0\n\n    def push_rebel():\n        nonlocal ans\n        for i in range(MAXN):\n            dis[i] = INF\n            p[i] = -1\n            pe[i] = -1\n            inq[i] = 0\n        dis[s] = 0\n        q = deque()\n        q.append(s)\n        inq[s] = 1\n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for idx in head[u]:\n                edge = e[idx]\n                if edge[1] - edge[2] == 0:\n                    continue\n                v = edge[0]\n                cost = edge[3]\n                if dis[v] > dis[u] + cost:\n                    dis[v] = dis[u] + cost\n                    p[v] = u\n                    pe[v] = idx\n                    if not inq[v]:\n                        inq[v] = 1\n                        q.append(v)\n        cur = t\n        while cur != s:\n            e[pe[cur]][2] += 1\n            e[pe[cur] ^ 1][2] -= 1\n            cur = p[cur]\n        ans += dis[t]\n\n    for _ in range(k):\n        push_rebel()\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.6954195820726454e-05, 0.0, 