{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1000000000;\n\nstruct Edge {\n    int to, cap, cost, flow;\n    size_t rev;\n};\n\nvoid insertEdge(vector<vector<Edge>>& graph, int from, int to, int capacity, int cost) {\n    Edge forward = {to, capacity, cost, 0, graph[to].size()};\n    Edge backward = {from, 0, -cost, 0, graph[from].size()};\n    graph[from].push_back(forward);\n    graph[to].push_back(backward);\n}\n\nint main() {\n    int N, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &N, &m, &k, &c, &d);\n    int totalNodes = N * 101 + 2;\n    vector<vector<Edge>> graph(totalNodes);\n    \n    for (int i = 0; i < k; i++) {\n        int x;\n        scanf(\"%d\", &x);\n        x--;\n        insertEdge(graph, totalNodes - 2, x * 101, 1, 0);\n    }\n    \n    for (int i = 0; i < 101; i++) {\n        insertEdge(graph, i, totalNodes - 1, INF, i * c);\n    }\n    \n    for (int i = 1; i < N; i++) {\n        for (int j = 0; j < 100; j++) {\n            insertEdge(graph, i * 101 + j, i * 101 + j + 1, INF, 0);\n        }\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        u--; v--;\n        for (int j = 0; j < 100; j++) {\n            for (int K = 1; K <= k; K++) {\n                int edgeCost = d * (K * K - (K - 1) * (K - 1));\n                insertEdge(graph, u * 101 + j, v * 101 + j + 1, 1, edgeCost);\n                insertEdge(graph, v * 101 + j, u * 101 + j + 1, 1, edgeCost);\n            }\n        }\n    }\n    \n    int source = totalNodes - 2;\n    int sink = totalNodes - 1;\n    int totalFlow = 0, totalCost = 0;\n    \n    while (totalFlow < k) {\n        vector<int> dist(totalNodes, INF);\n        vector<int> parent(totalNodes, -1);\n        vector<size_t> parentEdgeIndex(totalNodes);\n        vector<int> inQueue(totalNodes, 0);\n        queue<int> q;\n        \n        dist[source] = 0;\n        q.push(source);\n        inQueue[source] = 1;\n        \n        while (!q.empty()) {\n            int node = q.front();\n            q.pop();\n            inQueue[node] = 0;\n            \n            for (size_t idx = 0; idx < graph[node].size(); idx++) {\n                Edge& e = graph[node][idx];\n                if (e.flow < e.cap && dist[node] + e.cost < dist[e.to]) {\n                    dist[e.to] = dist[node] + e.cost;\n                    parent[e.to] = node;\n                    parentEdgeIndex[e.to] = idx;\n                    if (!inQueue[e.to]) {\n                        q.push(e.to);\n                        inQueue[e.to] = 1;\n                    }\n                }\n            }\n        }\n        \n        if (dist[sink] == INF) break;\n        \n        int augmentFlow = k - totalFlow;\n        for (int v = sink; v != source; v = parent[v]) {\n            int u = parent[v];\n            size_t idx = parentEdgeIndex[v];\n            augmentFlow = min(augmentFlow, graph[u][idx].cap - graph[u][idx].flow);\n        }\n        \n        for (int v = sink; v != source; v = parent[v]) {\n            int u = parent[v];\n            size_t idx = parentEdgeIndex[v];\n            size_t revIdx = graph[u][idx].rev;\n            graph[u][idx].flow += augmentFlow;\n            graph[v][revIdx].flow -= augmentFlow;\n            totalCost += graph[u][idx].cost * augmentFlow;\n        }\n        \n        totalFlow += augmentFlow;\n    }\n    \n    assert(totalFlow == k);\n    printf(\"%d\\n\", totalCost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1000000000;\n\n    static class Edge {\n        int to, cap, cost, flow;\n        int rev;\n\n        Edge(int to, int cap, int cost, int flow, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.flow = flow;\n            this.rev = rev;\n        }\n    }\n\n    static void insertEdge(List<List<Edge>> graph, int from, int to, int capacity, int cost) {\n        Edge forward = new Edge(to, capacity, cost, 0, graph.get(to).size());\n        Edge backward = new Edge(from, 0, -cost, 0, graph.get(from).size());\n        graph.get(from).add(forward);\n        graph.get(to).add(backward);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int totalNodes = N * 101 + 2;\n        List<List<Edge>> graph = new ArrayList<>();\n        for (int i = 0; i < totalNodes; i++) {\n            graph.add(new ArrayList<>());\n        }\n        \n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            x--;\n            insertEdge(graph, totalNodes - 2, x * 101, 1, 0);\n        }\n        \n        for (int i = 0; i < 101; i++) {\n            insertEdge(graph, i, totalNodes - 1, INF, i * c);\n        }\n        \n        for (int i = 1; i < N; i++) {\n            for (int j = 0; j < 100; j++) {\n                insertEdge(graph, i * 101 + j, i * 101 + j + 1, INF, 0);\n            }\n        }\n        \n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            u--; v--;\n            for (int j = 0; j < 100; j++) {\n                for (int K = 1; K <= k; K++) {\n                    int edgeCost = d * (K * K - (K - 1) * (K - 1));\n                    insertEdge(graph, u * 101 + j, v * 101 + j + 1, 1, edgeCost);\n                    insertEdge(graph, v * 101 + j, u * 101 + j + 1, 1, edgeCost);\n                }\n            }\n        }\n        \n        int source = totalNodes - 2;\n        int sink = totalNodes - 1;\n        int totalFlow = 0, totalCost = 0;\n        \n        while (totalFlow < k) {\n            int[] dist = new int[totalNodes];\n            int[] parent = new int[totalNodes];\n            int[] parentEdgeIndex = new int[totalNodes];\n            int[] inQueue = new int[totalNodes];\n            \n            Arrays.fill(dist, INF);\n            Arrays.fill(parent, -1);\n            \n            Queue<Integer> q = new LinkedList<>();\n            \n            dist[source] = 0;\n            q.offer(source);\n            inQueue[source] = 1;\n            \n            while (!q.isEmpty()) {\n                int node = q.poll();\n                inQueue[node] = 0;\n                \n                for (int idx = 0; idx < graph.get(node).size(); idx++) {\n                    Edge e = graph.get(node).get(idx);\n                    if (e.flow < e.cap && dist[node] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[node] + e.cost;\n                        parent[e.to] = node;\n                        parentEdgeIndex[e.to] = idx;\n                        if (inQueue[e.to] == 0) {\n                            q.offer(e.to);\n                            inQueue[e.to] = 1;\n                        }\n                    }\n                }\n            }\n            \n            if (dist[sink] == INF) break;\n            \n            int augmentFlow = k - totalFlow;\n            for (int v = sink; v != source; v = parent[v]) {\n                int u = parent[v];\n                int idx = parentEdgeIndex[v];\n                augmentFlow = Math.min(augmentFlow, graph.get(u).get(idx).cap - graph.get(u).get(idx).flow);\n            }\n            \n            for (int v = sink; v != source; v = parent[v]) {\n                int u = parent[v];\n                int idx = parentEdgeIndex[v];\n                int revIdx = graph.get(u).get(idx).rev;\n                graph.get(u).get(idx).flow += augmentFlow;\n                graph.get(v).get(revIdx).flow -= augmentFlow;\n                totalCost += graph.get(u).get(idx).cost * augmentFlow;\n            }\n            \n            totalFlow += augmentFlow;\n        }\n        \n        System.out.println(totalCost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001284993631998077, -1.9073468138230965e-06, -4.768370445162873e-07, -0.0018334260676056147, -2.6940935640595853e-05, -0.018154175952076912, -0.28133711218833923, -0.00012754580529872328, -1.1920928244535389e-07, -0.0002810560108628124, -0.04300082474946976, -0.00038092033355496824, -0.0004567056894302368, -0.04389728605747223, -5.960462772236497e-07, -5.245195097813848e-06, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -4.005352093372494e-05, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -0.014163684099912643, -5.960462772236497e-07, -3.4570634852570947e-06, -1.7881377516459906e-06, -1.0967194612021558e-05, -1.1920928244535389e-07, -1.8596476365928538e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.0006291079334914684, -1.0371154530730564e-05, 0.0, -4.6491513785440475e-06, -1.1920928244535389e-07, -2.145764938177308e-06, -5.9604467