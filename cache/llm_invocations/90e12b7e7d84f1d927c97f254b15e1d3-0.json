X_VERTEX):\n        potential[i] = BIG\n    potential[src] = 0\n    for _ in range(cnt):\n        for idx in range(len(all_edges)):\n            e = all_edges[idx]\n            if e.limit == e.used:\n                continue\n            if potential[e.begin] == BIG:\n                continue\n            if potential[e.finish] > potential[e.begin] + e.price:\n                potential[e.finish] = potential[e.begin] + e.price\n\ndef shortest_path(source):\n    for i in range(MAX_VERTEX):\n        distance[i] = BIG\n    distance[source] = 0\n    heap = [(0, source)]\n    while heap:\n        d_val, u = heapq.heappop(heap)\n        if d_val > distance[u]:\n            continue\n        for id in graph[u]:\n            e = all_edges[id]\n            if e.limit == e.used:\n                continue\n            v = e.finish\n            w = e.price + potential[u] - potential[v]\n            if distance[u] + w < distance[v]:\n                distance[v] = distance[u] + w\n                previous_edge_index[v] = id\n                heapq.heappush(heap, (distance[v], v))\n\ndef solve_flow(s, t):\n    relax(s, 50)\n    shortest_path(s)\n    flow = 0\n    cost = 0\n    while distance[t] != BIG:\n        augment = BIG\n        path_cost = 0\n        cur = t\n        while cur != s:\n            id = previous_edge_index[cur]\n            augment = min(augment, all_edges[id].limit - all_edges[id].used)\n            path_cost += all_edges[id].price\n            cur = all_edges[id].begin\n        flow += augment\n        cost += augment * path_cost\n        cur = t\n        while cur != s:\n            id = previous_edge_index[cur]\n            all_edges[id].used += augment\n            all_edges[id ^ 1].used -= augment\n            cur = all_edges[id].begin\n        shortest_path(s)\n        for i in range(MAX_VERTEX):\n            potential[i] = distance[i]\n    return (cost, flow)\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    n = int(