{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n<your_rewritten_code_3>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_N = 250005;\nint n, k, P;\nusing ll = long long;\n\nll mod_exp(ll base, ll exp) {\n    ll res = 1;\n    base %= P;\n    while (exp) {\n        if (exp & 1) res = (res * base) % P;\n        base = (base * base) % P;\n        exp >>= 1;\n    }\n    return res;\n}\n\ninline int get_lowest_set_bit(int x) { return x & -x; }\n\nll factorial[MAX_N], inv_factorial[MAX_N];\nll cache[26][MAX_N];\n\nll compute(int level, int bits) {\n    if (cache[level][bits] != -1) return cache[level][bits];\n    \n    if (bits == 0) {\n        cache[level][bits] = factorial[n];\n        for (int i = 0; i < level; ++i) {\n            cache[level][bits] = (cache[level][bits] * (k - i)) % P;\n        }\n        return cache[level][bits];\n    }\n    \n    cache[level][bits] = 0;\n    int remaining = bits ^ get_lowest_set_bit(bits);\n    \n    for (int subset = remaining; subset; subset = (subset - 1) & remaining) {\n        cache[level][bits] = (cache[level][bits] + inv_factorial[bits ^ subset] * compute(level + 1, subset)) % P;\n    }\n    \n    cache[level][bits] = (cache[level][bits] + inv_factorial[bits] * compute(level + 1, 0)) % P;\n    return cache[level][bits];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> P;\n    ll total = mod_exp(k, n);\n    \n    if (n & 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    factorial[0] = 1;\n    for (int i = 1; i <= n; ++i) factorial[i] = factorial[i-1] * i % P;\n    \n    inv_factorial[n] = mod_exp(factorial[n], P - 2);\n    for (int i = n; i > 0; --i) inv_factorial[i-1] = inv_factorial[i] * i % P;\n    \n    memset(cache, -1, sizeof(cache));\n    ll invalid = compute(0, n);\n    ll result = (total - invalid + P) % P;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef mod_exp(base, exp, mod):\n    res = 1\n    base %= mod\n    while exp:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef get_lowest_set_bit(x):\n    return x & -x\n\ndef compute(level, bits, n, k, P, factorial, inv_factorial, cache):\n    if cache[level][bits] != -1:\n        return cache[level][bits]\n    \n    if bits == 0:\n        result = factorial[n]\n        for i in range(level):\n            result = (result * (k - i)) % P\n        cache[level][bits] = result\n        return result\n    \n    cache[level][bits] = 0\n    remaining = bits ^ get_lowest_set_bit(bits)\n    \n    subset = remaining\n    while subset:\n        cache[level][bits] = (cache[level][bits] + inv_factorial[bits ^ subset] * compute(level + 1, subset, n, k, P, factorial, inv_factorial, cache)) % P\n        subset = (subset - 1) & remaining\n    \n    cache[level][bits] = (cache[level][bits] + inv_factorial[bits] * compute(level + 1, 0, n, k, P, factorial, inv_factorial, cache)) % P\n    return cache[level][bits]\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n = int(input_data[0])\n    k = int(input_data[1])\n    P = int(input_data[2])\n    \n    total = mod_exp(k, n, P)\n    \n    if n & 1:\n        print(total)\n        return\n    \n    factorial = [1] * (n + 1)\n    for i in range(1, n + 1):\n        factorial[i] = factorial[i-1] * i % P\n    \n    inv_factorial = [1] * (n + 1)\n    inv_factorial[n] = mod_exp(factorial[n], P - 2, P)\n    for i in range(n, 0, -1):\n        inv_factorial[i-1] = inv_factorial[i] * i % P\n    \n    # Initialize cache with -1\n    # We use a list of lists for cache\n    cache = [[-1] * (n + 1) for _ in range(26)]\n    \n    invalid = compute(0, n, n, k, P, factorial, inv_factorial, cache)\n    result = (total - invalid + P) % P\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016973962192423642, -1.311301275563892e-06, -3.576278118089249e-07, -0.03987462446093559, -8.999896090244874e-05, -0.6326191425323486, -0.37355273962020874, -0.8104461431503296, -0.00014172980445437133, -0.04069308564066887, -0.2266782969236374, -3.814689989667386e-06, -3.3378546504536644e-06, 0.0, -2.634490556374658e-05, -4.768360213347478e-06, -0.2841283977031708, -1.7046782886609435e-05, -5.960462772236497e-07, -7.760223525110632e-05, 0.0, 0.0, 0.0, -1.0251946150674485e-05, 0.0, -7.152555099310121e-07, -0.0076287128031253815, -5.960462772236497e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -8.344646857949556e-07, -9.417489309271332e-06, -0.0009182051289826632, 0.0, -1.1920928244535389e-07, -6.4490144723095e-05, -8.344646857949556e-07, 0.0, 0.0, -1.1920928244535389e-07, -4.768360213347478e-06, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, -7.152555099310121e-07, -