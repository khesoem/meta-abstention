   \n            if (k == 0) {\n                pw.println(fact[n]);\n            } else {\n                int r = n - (int)k;\n                long sum = 0;\n                int sign = 1;\n                for (int i = 0; i < r; i++) {\n                    long term = sign * nCr(r, i) % MOD * modPow(r - i, n) % MOD;\n                    sum = (sum + term) % MOD;\n                    sign = -sign;\n                }\n                long res = 2 * nCr(n, r) % MOD * ((sum % MOD + MOD) % MOD) % MOD;\n                pw.println((res % MOD + MOD) % MOD);\n            }\n        }\n        \n        pw.flush();\n    }\n    \n    int gcd(int a, int b) {\n        return b == 0 ? a : gcd(b, a % b);\n    }\n    \n    long modPow(long base, long exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = res * base % MOD;\n            }\n            base = base * base % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n    \n    String next() {\n        try {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                tokenizer = new StringTokenizer(br.readLine());\n            }\n            return tokenizer.nextToken();\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n    \n    StringTokenizer tokenizer;\n    \n    public static void main(String[] args) {\n        new utkarsh_v4().run();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\n\nconst long long MOD = 998244353LL;\nconst long long INF = 3000000000000000000LL;\n\nvector<long long> fact;\nvector<long long> invFact;\n\nlong long nCr(int n, int r) {\n    if (r < 0 || r > n) return 0;\n    return fact[n] * invFact[r] % MOD * invFact[n-r] % MOD;\n}\n\nlong long modPow(long long base, long long exp) {\n    long long res = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) {\n            res = res * base % MOD;\n        }\n        base = base * base % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint gcd(int a, int b) {\n    return b == 0 ? a : gcd(b, a % b);\n}\n\nstring nextToken(istream& in) {\n    string token;\n    in >> token;\n    return token;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    string input;\n    getline(cin, input);\n    istringstream iss(input);\n    \n    int n = stoi(nextToken(iss));\n    long long k = stoll(nextToken(iss));\n    \n    if (k >= n) {\n        cout << 0 << endl;\n    } else {\n        fact.resize(n+1);\n        invFact.resize(n+1);\n        fact[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            fact[i] = fact[i-1] * i % MOD;\n        }\n        invFact[n] = modPow(fact[n], MOD-2);\n        for (int i = n-1; i >= 0; i--) {\n            invFact[i] = invFact[i+1] * (i+1) % MOD;\n        }\n        \n        if (k == 0) {\n            cout << fact[n] << endl;\n        } else {\n            int r = n - (int)k;\n            long long sum = 0;\n            int sign = 1;\n            for (int i = 0; i < r; i++) {\n                long long term = sign * nCr(r, i) % MOD * modPow(r - i, n) % MOD;\n                sum = (sum + term) % MOD;\n                sign = -sign;\n            }\n            long long res = 2 * nCr(n, r) % MOD * ((sum % MOD + MOD) % MOD) % MOD;\n            cout << (res % MOD + MOD) % MOD << endl;\n        }\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012289722508285195, -2.3841830625315197e-06, -3.576278118089249e-07, -3.218599158572033e-05, -3.576278118089249e-07, -0.00010108436981681734, -1.7881377516459906e-06, -1.7881233361549675e-05, -4.7683704451