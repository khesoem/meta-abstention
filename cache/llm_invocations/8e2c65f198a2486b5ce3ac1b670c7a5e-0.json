  dis[s] = 0;\n    vis[s] = true;\n    q.push(s);\n    while(!q.empty())\n    {\n        int u = q.front();\n        q.pop();\n        vis[u] = false;\n        for(int i = head[u]; i != -1; i = edge[i].next)\n        {\n            int v = edge[i].to;\n            if(edge[i].cap > edge[i].flow && dis[v] > dis[u] + edge[i].cost)\n            {\n                dis[v] = dis[u] + edge[i].cost;\n                pre[v] = i;\n                if(!vis[v])\n                {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    if(pre[t] == -1) return false;\n    else return true;\n}\nint minCostMaxflow(int s, int t, int &cost)\n{\n    int flow = 0;\n    cost = 0;\n    while(spfa(s,t))\n    {\n        int Min = INF;\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            if(Min > edge[i].cap - edge[i].flow)\n                Min = edge[i].cap - edge[i].flow;\n        }\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            edge[i].flow += Min;\n            edge[i^1].flow -= Min;\n            cost +=  edge[i].cost*Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\nint point(int x, int y){\n    return (x-1)*50+y;\n}\nint main(){\n    int S = 101*55, T = S + 1;\n    n = read(), m = read(), k = read(), c = read(), d = read();\n    int tmp;\n    init(T+1);\n    for(int i = 1; i <= k; i++){\n        tmp = read();\n        addedge(S, tmp, 1, 0);\n    }\n    for(int i = 1; i <= 50; i++){\n        for(int j = 1; j <= 103; j++){\n            int x = point(j, i);\n            int y = point(j+1, i);\n            addedge(x, y, INF, c);\n        }\n    }\n    for(int i = 0; i < 102; i++){\n        int tmp = i*50+1;\n        addedge(tmp, T, INF, 0);\n    }\n    for(int i = 1; i <= m; i++){\n        int u, v;\n        u = read(), v = read();\n        for(int j = 1; j <= 102; j++){\n            int x = point(j, u), x1 = point(j+1, u);\n            int y1 = point(j+1, v), y = point(j, v);\n            for(int k = 0; k < 50; k++){\n                int val = d*(k*2+1)+c;\n                addedge(x, y1, 1, val);\n                addedge(y, x1, 1, val);\n            }\n        }\n    }\n    int cost = 0;\n    minCostMaxflow(S, T, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn = int(input())\nm = int(input())\nk = int(input())\nc = int(input())\nd = int(input())\n\nINF = 0x3f3f3f3f\nmaxm = 2000015\nmaxn = 105 * 55\n\nclass Edge:\n    def __init__(self, to, next, cap, flow, cost):\n        self.to = to\n        self.next = next\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\ndef point(x, y):\n    return (x - 1) * 50 + y\n\ndef init(n):\n    global N, head, tol\n    N = n\n    tol = 0\n    head = [-1] * N\n\ndef addedge(u, v, cap, cost):\n    global tol, edges, head\n    edges[tol] = Edge(v, head[u], cap, 0, cost)\n    head[u] = tol\n    tol += 1\n    edges[tol] = Edge(u, head[v], 0, 0, -cost)\n    head[v] = tol\n    tol += 1\n\ndef spfa(s, t):\n    global dis, vis, pre\n    from collections import deque\n    dis = [INF] * N\n    vis = [False] * N\n    pre = [-1] * N\n    dis[s] = 0\n    q = deque()\n    q.append(s)\n    vis[s] = True\n    while q:\n        u = q.popleft()\n        vis[u] = False\n        i = head[u]\n        while i != -1:\n            v = edges[i].to\n            if edges[i].cap > edges[i].flow and dis[v] > dis[u] + edges[i].cost:\n                dis[v] = dis[u] + edges[i].cost\n                pre[v] = i\n                if not vis[v]:\n                    vis[v] = True\n                    q.append(v)\n            i = edges[i].next\n    return pre[t] != -1\n\ndef minCostMaxflow(s, t):\n    global edges\n    flow = 0\n    cost = 0\n    while spfa(s, t):\n        Min = INF\n        i = pre[t]\n        while i != -1:\n            if Min > edges[i].cap - edges[i].flow:\n                Min = edges[i].cap - edges[i].flow\n            i = pre[edges[i ^ 1].to]\n        i = pre[t]\n        while i != -1:\n            edges[i].flow += Min\n            edges[i ^ 1].flow -= Min\n            cost += edges[i].cost * Min\n            i = pre[edges[i ^ 1].to]\n        flow += Min\n    return flow, cost\n\n# Initialize data structures\nedges = [None] * maxm\ninit(102 * 55 + 2)\nS = 101 * 55\nT = S + 1\n\n# Read input and build graph\nfor _ in range(k):\n    tmp = int(input())\n    addedge(S, tmp, 1, 0)\n\nfor i in range(1, 51):\n    for j in range(1, 104):\n        x = point(j, i)\n        y = point(j + 1, i)\n        addedge(x, y, INF, c)\n\nfor i in range(102):\n    tmp = i * 50 + 1\n    addedge(tmp, T, INF, 0)\n\nfor _ in range(m):\n    u = int(input())\n    v = int(input())\n    for j in range(1, 103):\n        x = point(j, u)\n        x1 = point(j + 1, u)\n        y1 = point(j + 1, v)\n        y = point(j, v)\n        for k in range(50):\n            val = d * (k * 2 + 1) + c\n            addedge(x, y1, 1, val)\n            addedge(y, x1, 1, val)\n\n_, total_cost = minCostMaxflow(S, T)\nprint(total_cost)\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0009462343878112733, -8.97155623533763e-05, -4.320199877838604e-07, -2.47495681833243e-05, -0.32293054461479187, -0.0834919884800911, -0.008759336546063423, -7.896309739408025e-07, -0.012735546566545963, -2.816093228830141e-06, -5.319370302458992e-06, -3.128163257315464e-07, -4.320199877838604e-07, -2.963691804325208e-05, -4.320199877838604e-07, -6.630610641877865e-06, 0.0, 0.0, -3.070975071750581e-05, -5.512236498361744e-07, -6.027225754223764e-05, 0.0, 0.0, -2.4868770196917467e-05, -1.3782830137643032e-05, -1.3856492842023727e-06, -1.9361264946837764e-07, -3.128163257315464e-07, -0.006814946420490742, -0.07465536892414093, -5.438573680294212e-06, -0.006801575422286987, -0.6335030198097229, -4.