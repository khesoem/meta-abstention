  \n    Val ri = zero;\n    dbl same = 0.0;\n\n    for(int i = 0; i < n; ++i){\n      if(i != vr && (msk & (1 << i))){\n        same += p[i];\n        ri = Add(ri, Mult(dp[msk ^ (1 << i)], p[i]));\n      }\n    }\n\n    dp[msk] = Div(ri, 1.0 - same);\n  }\n\n  Val tot = one;\n  for(int msk = 1; msk < (1 << n); ++msk){\n    if(!(msk & (1 << vr))) tot = Add(tot, dp[msk]);\n  }\n\n  dbl alp = (1.0 - tot.se) / tot.fi;\n\n  Val bad = zero;\n  for(int msk = 0; msk < (1 << n); ++msk){\n    if(msk & (1 << vr)) continue;\n    if(BITS(msk) >= k) bad = Add(bad, dp[msk]);\n  }\n\n  return 1.0 - (alp * bad.fi + bad.se);\n}\n\nint main(){\n  scanf(\"%d%d\", &n, &k);\n  for(int i = 0; i < n; ++i) scanf(\"%lf\", &p[i]);\n\n  for(int i = 0; i < n; ++i) \n    printf(\"%.12f%c\", Solve(i), (i + 1 == n ? '\\n' : ' '));\n\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class Val {\n        double fi;\n        double se;\n        \n        Val(double fi, double se) {\n            this.fi = fi;\n            this.se = se;\n        }\n    }\n    \n    static Val[] dp = new Val[1 << 20];\n    static int n, k;\n    static double[] p = new double[25];\n    \n    static Val Add(Val f, Val s) {\n        return new Val(f.fi + s.fi, f.se + s.se);\n    }\n    \n    static Val Sub(Val f, Val s) {\n        return new Val(f.fi - s.fi, f.se - s.se);\n    }\n    \n    static Val Mult(Val f, double w) {\n        return new Val(f.fi * w, f.se * w);\n    }\n    \n    static Val Div(Val f, double w) {\n        return new Val(f.fi / w, f.se / w);\n    }\n    \n    static int BITS(int a) {\n        return Integer.bitCount(a);\n    }\n    \n    static double Solve(int vr) {\n        if (p[vr] < 1e-9) return 0.0;\n        \n        Val one = new Val(1.0, 0.0);\n        Val zero = new Val(0.0, 0.0);\n        dp[0] = one;\n        \n        for (int msk = 1; msk < (1 << n); ++msk) {\n            if ((msk & (1 << vr)) != 0) continue;\n            \n            Val ri = new Val(0.0, 0.0);\n            double same = 0.0;\n            \n            for (int i = 0; i < n; ++i) {\n                if (i != vr && (msk & (1 << i)) != 0) {\n                    same += p[i];\n                    ri = Add(ri, Mult(dp[msk ^ (1 << i)], p[i]));\n                }\n            }\n            \n            dp[msk] = Div(ri, 1.0 - same);\n        }\n        \n        Val tot = new Val(1.0, 0.0);\n        for (int msk = 1; msk < (1 << n); ++msk) {\n            if ((msk & (1 << vr)) == 0) {\n                tot = Add(tot, dp[msk]);\n            }\n        }\n        \n        double alp = (1.0 - tot.se) / tot.fi;\n        \n        Val bad = new Val(0.0, 0.0);\n        for (int msk = 0; msk < (1 << n); ++msk) {\n            if ((msk & (1 << vr)) != 0) continue;\n            if (BITS(msk) >= k) {\n                bad = Add(bad, dp[msk]);\n            }\n        }\n        \n        return 1.0 - (alp * bad.fi + bad.se);\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        \n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < n; ++i) {\n            p[i] = Double.parseDouble(st.nextToken());\n        }\n        \n        for (int i = 0; i < n; ++i) {\n            System.out.printf(\"%.12f\", Solve(i));\n            if (i + 1 == n) {\n                System.out.println();\n            } else {\n                System.out.print(\" \");\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017832119192462415, -1.7881377516459906e-06, -9.536