rc; v = prevv[v]) {\n                flow = Math.min(flow, graph[prevv[v]].get(preve[v]).cap);\n            }\n\n            for (int v = dst; v != src; v = prevv[v]) {\n                Edge e = graph[prevv[v]].get(preve[v]);\n                e.cap -= (int) flow;\n                graph[v].get(e.rev).cap += (int) flow;\n                totalCost += flow * e.cost;\n            }\n        }\n        return totalCost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] pos = new int[k + 1];\n        for (int i = 1; i <= k; ++i) {\n            pos[i] = sc.nextInt();\n        }\n\n        for (int i = 0; i < MAX_NODES; ++i) {\n            graph[i] = new ArrayList<>();\n        }\n\n        int source = 0;\n        int sink = n * 100 + 1;\n\n        for (int flr = 1; flr <= 100; ++flr) {\n            addEdge(flr, sink, Integer.MAX_VALUE, 0);\n        }\n\n        for (int i = 1; i <= k; ++i) {\n            addEdge(source, (pos[i] - 1) * 100 + 1, 1, 0);\n        }\n\n        for (int flr = 2; flr <= n; ++flr) {\n            for (int lvl = 1; lvl < 100; ++lvl) {\n                addEdge((flr - 1) * 100 + lvl, (flr - 1) * 100 + lvl + 1, Integer.MAX_VALUE, c);\n            }\n        }\n\n        for (int _ = 0; _ < m; ++_) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int lvl = 1; lvl < 100; ++lvl) {\n                for (int grp = 1; grp <= k; ++grp) {\n                    int edgeCost = c + d * (grp * grp - (grp - 1) * (grp - 1));\n                    addEdge((u - 1) * 100 + lvl, (v - 1) * 100 + lvl + 1, 1, edgeCost);\n                    addEdge((v - 1) * 100 + lvl, (u - 1) * 100 + lvl + 1, 1, edgeCost);\n                }\n            }\n        }\n\n        System.out.println(minCostFlow(source, sink));\n      