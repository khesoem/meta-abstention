{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n<your_rewritten_code_3>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 10005;\nconst long long INF = 1LL << 50;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nvector<Edge> graph[MAX_NODES];\nint dist[MAX_NODES], prevv[MAX_NODES], preve[MAX_NODES];\nbool inq[MAX_NODES];\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    graph[u].emplace_back(v, cap, cost, (int)graph[v].size());\n    graph[v].emplace_back(u, 0, -cost, (int)graph[u].size() - 1);\n}\n\nlong long minCostFlow(int src, int dst) {\n    long long totalCost = 0;\n    while (true) {\n        fill(dist, dist + MAX_NODES, INF);\n        fill(inq, inq + MAX_NODES, false);\n        queue<int> q;\n        dist[src] = 0;\n        q.push(src);\n        inq[src] = true;\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            for (int i = 0; i < graph[u].size(); ++i) {\n                auto& e = graph[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[dst] == INF) break;\n\n        long long flow = INF;\n        for (int v = dst; v != src; v = prevv[v]) {\n            flow = min(flow, (long long)graph[prevv[v]][preve[v]].cap);\n        }\n\n        for (int v = dst; v != src; v = prevv[v]) {\n            auto& e = graph[prevv[v]][preve[v]];\n            e.cap -= flow;\n            graph[v][e.rev].cap += flow;\n            totalCost += flow * e.cost;\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> pos(k + 1);\n    for (int i = 1; i <= k; ++i) cin >> pos[i];\n\n    int source = 0;\n    int sink = n * 100 + 1;\n\n    for (int flr = 1; flr <= 100; ++flr) {\n        addEdge(flr, sink, INT_MAX, 0);\n    }\n\n    for (int i = 1; i <= k; ++i) {\n        addEdge(source, (pos[i] - 1) * 100 + 1, 1, 0);\n    }\n\n    for (int flr = 2; flr <= n; ++flr) {\n        for (int lvl = 1; lvl < 100; ++lvl) {\n            addEdge((flr - 1) * 100 + lvl, (flr - 1) * 100 + lvl + 1, INT_MAX, c);\n        }\n    }\n\n    int u, v;\n    for (int _ = 0; _ < m; ++_) {\n        cin >> u >> v;\n        for (int lvl = 1; lvl < 100; ++lvl) {\n            for (int grp = 1; grp <= k; ++grp) {\n                int edgeCost = c + d * (grp * grp - (grp - 1) * (grp - 1));\n                addEdge((u - 1) * 100 + lvl, (v - 1) * 100 + lvl + 1, 1, edgeCost);\n                addEdge((v - 1) * 100 + lvl, (u - 1) * 100 + lvl + 1, 1, edgeCost);\n            }\n        }\n    }\n\n    cout << minCostFlow(source, sink) << '\\n';\n    return 0;\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sampl