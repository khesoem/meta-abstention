     flow += f;\n                cost += f * (pot[t] - pot[s]);\n            }\n            return cost;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int totalNodes = (n + 2) * 102;\n        MinCostFlow g = new MinCostFlow(totalNodes);\n        for (int i = 0; i < 102; i++) {\n            g.addEdge(nodeId(i, 1, n), nodeId(i, 0, n), 100, (long) i * c);\n        }\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j <= n; j++) {\n                g.addEdge(nodeId(i, j, n), nodeId(i + 1, j, n), 100, 0);\n            }\n        }\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            g.addEdge(nodeId(0, n + 1, n), nodeId(0, u, n), 1, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(nodeId(j, u, n), nodeId(j + 1, v, n), 1, ((2L * f) + 1) * d);\n                    g.addEdge(nodeId(j, v, n), nodeId(j + 1, u, n), 1, ((2L * f) + 1) * d);\n                }\n            }\n        }\n        long result = g.maxFlow(nodeId(0, n + 1, n), nodeId(101, 0, n));\n        System.out.println(result);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.9801878554280847e-05, -0.0004354958946350962, 0.0, -2.0265558760002023e-06, -0.0007431129342876375, -0.001176856574602425, 0.0, -0.00015948931104503572, -0.038049906492233276, -0.0009160612826235592, -0.0809379518032074, -0.01703312061727047, -5.936446541454643e-05, -0.2019946277141571, 0.0, -2.753696753643453e-05, 0.0, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.0728830375228426e-06, -1.1920