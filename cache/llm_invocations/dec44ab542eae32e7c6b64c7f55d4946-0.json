     for j in range(len(a)):\n            result[i] = (result[i] + a[j] * x) % MOD\n            x = (x * wth) % MOD\n        wth = (wth * W) % MOD\n    return result\n\ndef power(arr, exp):\n    for i in range(len(arr)):\n        arr[i] = mod_pow(arr[i], exp, MOD)\n    return arr\n\nclass FastScanner:\n    def __init__(self, f):\n        if isinstance(f, str):\n            self.br = open(f, 'r')\n        else:\n            self.br = sys.stdin\n        self.st = []\n    \n    def next_line(self):\n        try:\n            return self.br.readline()\n        except:\n            return None\n    \n    def next(self):\n        while not self.st:\n            try:\n                line = self.br.readline()\n                if not line:\n                    return None\n                self.st = line.strip().split()\n            except:\n                sys.exit(1)\n        return self.st.pop(0)\n    \n    def next_int(self):\n        return int(self.next())\n    \n    def next_long(self):\n        return int(self.next())\n    \n    def next_double(self):\n        return float(self.next())\n\ndef solve():\n    scanner = FastScanner(sys.stdin)\n    n = scanner.next_int()\n    k = scanner.next_int()\n    arr = [0] * 10\n    for _ in range(k):\n        arr[scanner.next_int()] = 1\n    \n    x = fft(arr)\n    x = power(x, n // 2)\n    v = Vector(x)\n    x = v.ifft()\n    ans = 0\n    for i in range(len(x)):\n        ans = (ans + x[i] * x[i]) % MOD\n    print(ans)\n\ndef main():\n    init()\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-8.05822346592322e-05, -9.536738616588991e-07, -2.3841855067985307e-07, -0.00011073929636040702, -0.008751136250793934, -1.6689286894688848e-06, -0.0021453716326504946, -0.009838305413722992, -0.5759475231170654, -0.07002726197242737, -0.7832152843475342, -9.536738616588991e-07, -0.0030425945296883583, -0.0017571499338373542, -0.3774811923503876, -1.192092824