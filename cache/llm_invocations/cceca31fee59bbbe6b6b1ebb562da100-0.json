(s);\n        while(!Q.empty() ) {\n            int u = Q.front(); Q.pop();\n            inq[u] = 0;\n\n            for( int i = 0 ; i < G[u].size() ; i ++ ) {\n                Edge &e = E[G[u][i]];\n                if( e.cap > e.flow && d[e.v] > d[u] + e.cost ) {\n                    d[e.v] = d[u] + e.cost;\n                    p[e.v] = G[u][i];\n                    a[e.v] = min( a[u] , e.cap - e.flow );\n\n                    if( inq[e.v ] == 0 ) {\n                        Q.push(e.v);\n                        inq[e.v] = 1;\n                    }\n                }\n            }\n        }\n\n        if( d[t] == INF ) return false;     // No augmenting Path\n        flow = a[t];\n        cost = d[t] ;               // Unit cost\n        int u = t ;\n        while( u  != s ) {\n            E[p[u]].flow += a[t];\n            E[p[u]^1].flow -= a[t];\n            u = E[p[u]].u;\n        }\n        return true;\n    }\n\n    pair<T,T> Mincost (int s, int t) {\n        this->s=s,this->t=t;\n        T Mcost = 0;\n        T Flow = 0;\n        T f = 0 ;    // For Each CaT , The flow\n        T d = 0;      // Shortest Distance / Cost Per Flow\n\n        while(BelmanFord(f,d)) {\n            Flow += f;\n            Mcost += f *d ;\n        }\n        return make_pair(Flow, Mcost);\n    }\n};\n\nint main() {\n    int n, m, k, C, D;\n    cin>>n>>m>>k>>C>>D;\n\n    MCMF solver(n*K+2);\n    int source = n*K, sink = n*K+1;\n\n    for (int i=0; i<K; i++)\n        solver.addEdge(i, sink, k, C*i);\n\n\n    for (int i=0; i<k; i++) {\n        int x;\n        cin>>x;\n        x--;\n        solver.addEdge(source, x*K, 1, 0);\n    }\n\n    for (int i=0; i<n; i++)\n        for (int j=1; j<K; j++)\n            solver.addEdge(i*K+j-1, i*K+j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin>>u>>v;\n        u--; v--;\n\n        for (int j=1; j<K; j++) {\n            int a = u*K+j-1, b = v*K+j;\n            int c = v*K+j-1, d = u*K+j;\n\n            for (int i=1, cc = D; i<=k; i++, cc += 2*D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n    auto pr = solver.Mincost(source, sink);\n    cout<<pr.second<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "import java.util.*;\n\npublic class MinCostFlow {\n    static class Edge {\n        int u, v;\n        int cap, flow;\n        int cost;\n\n        public Edge(int u, int v, int cap, int flow, int cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static class MCMF {\n        int n, m, s, t;\n        List<List<Integer>> G;\n        List<Edge> E;\n        int[] p, inq;\n        long[] d, a;\n\n        public MCMF(int n) {\n            this.n = n;\n            G = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                G.add(new ArrayList<>());\n            }\n            E = new ArrayList<>();\n            p = new int[n];\n            inq = new int[n];\n            d = new long[n];\n            a = new long[n];\n        }\n\n        void addEdge(int u, int v, int cap, int cost) {\n            E.add(new Edge(u, v, cap, 0, cost));\n            E.add(new Edge(v, u, 0, 0, -cost));\n            m = E.size();\n            G.get(u).add(m - 2);\n            G.get(v).add(m - 1);\n        }\n\n        boolean BelmanFord(long[] flowOut, long[] costOut) {\n            Arrays.fill(d, Long.MAX_VALUE);\n            Arrays.fill(inq, 0);\n            d[s] = 0;\n            p[s] = -1;\n            a[s] = Long.MAX_VALUE;\n\n            Queue<Integer> Q = new LinkedList<>();\n            Q.offer(s);\n            inq[s] = 1;\n\n            while (!Q.isEmpty()) {\n                int u = Q.poll();\n                inq[u] = 0;\n                for (int idx : G.get(u)) {\n                    Edge e = E.get(idx);\n                    if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                        d[e.v] = d[u] + e.cost;\n                        p[e.v] = idx;\n                        a[e.v] = Math.min(a[u], e.cap - e.flow);\n                        if (inq[e.v] == 0) {\n                            Q.offer(e.v);\n                            inq[e.v] = 1;\n                        }\n                    }\n                }\n            }\n\n            if (d[t] == Long.MAX_VALUE)\n                return false; // no augmenting path\n\n            long flowVal = a[t];\n            long costVal = d[t];\n            int u = t;\n            while (u != s) {\n                int edgeIdx = p[u];\n                E.get(edgeIdx).flow += flowVal;\n                E.get(edgeIdx ^ 1).flow -= flowVal;\n                u = E.get(edgeIdx).u;\n            }\n            flowOut[0] += flowVal;\n            costOut[0] += flowVal * costVal;\n            return true;\n        }\n\n        long[] Mincost(int s, int t) {\n            this.s = s;\n            this.t = t;\n            long totalFlow = 0;\n            long totalCost = 0;\n            long[] flowArr = new long[1];\n            long[] costArr = new long[1];\n            while (BelmanFord(flowArr, costArr)) {\n                totalFlow += flowArr[0];\n                totalCost += costArr[0];\n            }\n            return new long[]{totalFlow, totalCost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt(); // number of nodes\n        int m = sc.nextInt(); // number of edges\n        int k = sc.nextInt(); // number of units per node\n        int C = sc.nextInt(); // cost comparison values\n        int D = sc.nextInt(); // delay factor\n\n        int totalNodes = n * k + 2;\n        MCMF solver = new MCMF(totalNodes);\n        int source = n * k;\n        int sink = n * k + 1;\n\n        for (int i = 0; i < k; i++)\n            solver.addEdge(i, sink, k, C * i);\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            x--;\n            solver.addEdge(source, x * k, 1, 0);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 1; j < k; j++) {\n                solver.addEdge(i * k + j - 1, i * k + j, k, 0);\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n\n            for (int j = 1; j < k; j++) {\n                int a = u * k + j - 1;\n                int b = v * k + j;\n                int c = v * k + j - 1;\n                int d = u * k + j;\n                for (int cnt = 1, cc = D; cnt <= k; cnt++, cc += 2 * D) {\n                    solver.addEdge(a, b, 1, cc);\n                    solver.addEdge(c, d, 1, cc);\n                }\n            }\n        }\n\n        long[] result = solver.Mincost(source, sink);\n        System.out.println(result[1]);\n        sc.close();\n    }\n}\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.04948939383029938, -7.896309739408025e-07, -0.00033558503491804004, -0.6964109539985657, -0.20142951607704163, -1.3856492842023727e-06, -1.5169951915740967, -2.3199920178740285e-05, -1.0540103912353516, -0.2899341583251953, -0.015051167458295822, -0.004013222176581621, -0.31559857726097107, -3.4121114822482923e-06, -3.91732100979425e-05, -1.2664456789934775e-06, -6.670925358776003e-05, -4.4849443838757e-06, -0.0008141548605635762, 0.0, -0.0006465525948442519, -4.320199877838604e-07, -0.033650193363428116, -0.0003408263437449932, -0.02990945801138878, -1.1472419600977446e-06, -0.1270705759525299, -1.9361264946837764e-07, -0.02631283737719059, -3.8889261304575484e-06, -0.12710124254226685, -5.512236498361744e-07, -0.47412392497062683, -2.5776860184123507e-06, -4.739826181321405e-05, -3.128163257315464e-07, -4.704065213445574e-05, -2.7729658540920354e-05, 0.0, -6.392202976712724e-06, 0.0, -1