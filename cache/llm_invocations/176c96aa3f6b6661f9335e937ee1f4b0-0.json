g s = to_string(x);\n    int len = s.length();\n    if (x > 0) cnt++;\n    for (int i = 1; i < T; i++) {\n        i64 base = 1, num = x;\n        for (int j = 0; j + 1 < i; j++) base *= 10;\n        for (int j = len; j < i; j++) num *= 10;\n        if (i < len) {\n            string prefix = s.substr(0, i);\n            num = stoll(prefix) + 1;\n        }\n        if (num > upper_bound) num = upper_bound;\n        if (num > base) cnt += num - base;\n    }\n    return cnt;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    i64 n;\n    cin >> n;\n    n++;\n    i64 limit = n;\n    \n    i64 adjustment = (n % MOD) * ((n / MOD1) + 2) % MOD;\n    adjustment = (MOD - adjustment) % MOD;\n    \n    i64 result = 0;\n    for (i64 offset = -n / MOD1 - 1; offset <= n / MOD1 + 1; offset++) {\n        i64 cnt = 0;\n        for (int d = 0; d < T; d++) {\n            i64 left = 0, right = 1;\n            if (d >= 1) {\n                left = 1;\n                for (int k = 0; k + 1 < d; k++) left *= 10;\n                right = left * 10;\n            }\n            if (right > n) right = n;\n            i64 last_right = right;\n            if (left < right) {\n                left--;\n                while (right - left > 1) {\n                    i64 mid = (left + right) >> 1;\n                    if (count_valid_numbers(mid, limit) > mid + MOD1 * offset - 1) right = mid;\n                    else left = mid;\n                }\n                cnt += last_right - right;\n            }\n        }\n        result += cnt;\n    }\n    \n    result %= MOD;\n    result = ((-result - adjustment) % MOD * MOD1) % MOD;\n    result = (result % MOD + MOD) % MOD;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\nMOD1 = 998244353\nT = 14\n\ndef mod_pow(b, e, m):\n    r = 1\n    b %= m\n    while e:\n        if e & 1:\n            r = (r * b) % m\n        b = (b * b) % m\n        e >>= 1\n    return r\n\ndef berlekamp_massey(s):\n    n = len(s)\n    cur = []\n    ls = []\n    lf = -1\n    ld = 0\n    for i in range(n):\n        val = 0\n        for j in range(len(cur)):\n            val = (val + s[i - j - 1] * cur[j]) % MOD\n        val = (val - s[i]) % MOD\n        if val == 0:\n            continue\n        if not cur:\n            cur = [0] * (i + 1)\n            lf = i\n            ld = val\n            continue\n        k = (-val * mod_pow(ld, MOD - 2, MOD)) % MOD\n        c = [0] * (i - lf - 1)\n        c.append(k)\n        for j in range(len(ls)):\n            c.append((-ls[j] * k) % MOD)\n        if len(c) < len(cur):\n            c = c + [0] * (len(cur) - len(c))\n        for j in range(len(cur)):\n            c[j] = (c[j] + cur[j]) % MOD\n        if len(cur) < i - lf + len(ls):\n            ls = cur[:]\n            lf = i\n            ld = val\n        cur = c[:]\n    for i in range(len(cur)):\n        cur[i] = (cur[i] % MOD + MOD) % MOD\n    return cur\n\ndef poly_mul(p, q, m, h):\n    tmp = [0] * (m * 2)\n    for i in range(m):\n        if p[i]:\n            for j in range(m):\n                tmp[i + j] = (tmp[i + j] + p[i] * q[j]) % MOD\n    for i in range(m * 2 - 1, m - 1, -1):\n        if tmp[i]:\n            for j in range(m - 1, -1, -1):\n                tmp[i - j - 1] = (tmp[i - j - 1] + tmp[i] * h[j]) % MOD\n    for i in range(m):\n        p[i] = tmp[i]\n\ndef eval_poly(k, h, a, m):\n    s = [0] * m\n    t = [0] * m\n    s[0] = 1\n    if m != 1:\n        t[1] = 1\n    else:\n        t[0] = h[0]\n    while k:\n        if k & 1:\n            poly_mul(s, t, m, h)\n        poly_mul(t, t, m, h)\n        k >>= 1\n    res = 0\n    for i in range(m):\n        res = (res + s[i] * a[i]) % MOD\n    return (res % MOD + MOD) % MOD\n\ndef solve_linear_recurrence(seq, n):\n    if n < len(seq):\n        return seq[n]\n    h = berlekamp_massey(seq)\n    m = len(h)\n    if m == 0:\n        return 0\n    a = seq[:m]\n    return eval_poly(n, h, a, m)\n\ndef count_valid_numbers(x, upper_bound):\n    cnt = 0\n    s = str(x)\n    length = len(s)\n    if x > 0:\n        cnt += 1\n    for i in range(1, T):\n        base = 1\n        num = x\n        for j in range(i - 1):\n            base *= 10\n        for j in range(length, i):\n            num *= 10\n        if i < length:\n            prefix = s[:i]\n            num = int(prefix) + 1\n        if num > upper_bound:\n            num = upper_bound\n        if num > base:\n            cnt += num - base\n    return cnt\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    n += 1\n    limit = n\n    \n    adjustment = (n % MOD) * ((n // MOD1) + 2) % MOD\n    adjustment = (MOD - adjustment) % MOD\n    \n    result = 0\n    for offset in range(-n // MOD1 - 1, n // MOD1 + 2):\n        cnt = 0\n        for d in range(T):\n            left = 0\n            right = 1\n            if d >= 1:\n                left = 1\n                for k in range(d - 1):\n                    left *= 10\n                right = left * 10\n            if right > n:\n                right = n\n            last_right = right\n            if left < right:\n                left -= 1\n                while right - left > 1:\n                    mid = (left + right) >> 1\n                    if count_valid_numbers(mid, limit) > mid + MOD1 * offset - 1:\n                        right = mid\n                    else:\n                        left = mid\n                cnt += last_right - right\n        result += cnt\n    \n    result %= MOD\n    result = ((-result - adjustment) % MOD * MOD1) % MOD\n    result = (result % MOD + MOD) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0001230164198204875, -1.430510451427