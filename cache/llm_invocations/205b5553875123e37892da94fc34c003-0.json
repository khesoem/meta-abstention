+d+1, res1, already_in);\n    already_in[d+1] -= sign;\n  }\n  return res1 < res2 ? res1 : res2;\n}\n\nint main(int argc, char* argv[]) {\n  int64_t n;\n  std::cin >> n;\n  std::vector<int> already_in(20, 0);\n  std::cout << aux(n, 1, 0, aux2(n), already_in) << std::endl;\n  return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static long nb_digits(long n) {\n        n = n < 0 ? -n : n;\n        long digits = 0;\n        while (n != 0) {\n            ++digits;\n            n /= 10;\n        }\n        return digits;\n    }\n\n    public static long ones(long n) {\n        long res = 0;\n        for (int i = 0; i < n; ++i)\n            res = 10 * res + 1;\n        return res;\n    }\n\n    public static long aux2(long n) {\n        if (n == 0) return 0;\n        n = n < 0 ? -n : n;\n        long d = nb_digits(n);\n        return d + aux2(n - ones(d));\n    }\n\n    public static long aux(long n, long sign, long acc, long max, int[] already_in) {\n        if (acc >= max) return max;\n        if (n == 0) return acc;\n        if (n < 0) { n = -n; sign = -sign; }\n        long d = nb_digits(n);\n        long ones_d = ones(d);\n        long res1 = max;\n        long res2 = max;\n\n        if (0 <= already_in[(int)d] * sign && -10 < already_in[(int)d] && already_in[(int)d] < 10) {\n            already_in[(int)d] += sign;\n            res1 = aux(n - ones_d, sign, acc + d, max, already_in);\n            already_in[(int)d] -= sign;\n        }\n        if (0 <= already_in[(int)(d + 1)] * sign && -10 < already_in[(int)(d + 1)] && already_in[(int)(d + 1)] < 10) {\n            already_in[(int)(d + 1)] += sign;\n            res2 = aux(n - 10 * ones_d - 1, sign, acc + d + 1, res1, already_in);\n            already_in[(int)(d + 1)] -= sign;\n        }\n        return res1 < res2 ? res1 : res2;\n    }\n\n  