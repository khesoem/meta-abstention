 spfa(int n) {\n        Arrays.fill(dis, inf);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(sr);\n        dis[sr] = 0;\n        inq[sr] = true;\n        mnf[sr] = Integer.MAX_VALUE;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            for (int id : adj.get(u)) {\n                Edge e = ed.get(id);\n                int v = e.b;\n                if (e.c > e.f && dis[v] > dis[u] + e.d) {\n                    dis[v] = dis[u] + e.d;\n                    pth[v] = id;\n                    mnf[v] = Math.min(mnf[u], e.c - e.f);\n                    if (!inq[v]) {\n                        q.offer(v);\n                        inq[v] = true;\n                    }\n                }\n            }\n        }\n        if (dis[sn] == inf) return new Pair(0, 0);\n        int v = sn;\n        while (v != sr) {\n            int id = pth[v];\n            ed.get(id).f += mnf[sn];\n            ed.get(id ^ 1).f -= mnf[sn];\n            v = ed.get(id).a;\n        }\n        return new Pair(mnf[sn], dis[sn] * mnf[sn]);\n    }\n\n    static Pair mcmf(int n) {\n        int flow = 0, cost = 0;\n        while (true) {\n            Pair p = spfa(n);\n            if (p.first == 0) return new Pair(flow, cost);\n            flow += p.first;\n            cost += p.second;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt(), m = sc.nextInt(), k = sc.nextInt(), c = sc.nextInt(), d = sc.nextInt();\n\n        for (int i = 0; i <= N; i++) {\n            fr[i] = 0;\n        }\n\n        for (int i = 0; i <= N + 1; i++) {\n            gr.add(new ArrayList<>());\n        }\n\n        dis = new int[N + 2];\n        inq = new boolean[N + 2];\n        mnf = new int[N + 2];\n        pth = new int[N + 2];\n\n        for (int i = 0; i <= 100 * n + n + 1; i++) {\n            adj.add(new ArrayList<>());\n        }\n\n        for (int i = 1; i <= k; i++) {\n            int x = sc.nextInt();\n            fr[x]++;\n        }\n\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt(), v = sc.nextInt();\n            gr.get(u).add(v);\n            gr.get(v).add(u);\n        }\n\n        sr = 0;\n        sn = 100 * n + n + 1;\n\n        for (int tm = 0; tm <= 99; tm++) {\n            int base1 = n * tm;\n            int base2 = n * (tm + 1);\n            for (int i = 1; i <= n; i++) {\n                addEdge(base1 + i, base2 + i, k, 0);\n                for (int x : gr.get(i)) {\n                    for (int cp = 1; cp <= k; cp++) {\n                        addEdge(base1 + i, base2 + x, 1, d * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            if (fr[i] > 0) {\n                addEdge(sr, i, fr[i], 0);\n            }\n        }\n        for (int tm = 0; tm <= 100; tm++) {\n            addEdge(n * tm + 1, sn, k, c * tm);\n        }\n        System.out.println(mcmf(sn).second);\n    }\n\n    static class Pair {\n        int first, second;\n        public Pair(int first, int second) {\n            this.first = first; this.second = second;\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0020656839478760958, -8.339776832144707e-05, -5.512236498361744e-07, -0.00013274075172375888, -2.2200749754119897e-06, -1.9361264946837764e-07, -0.0019288709154352546, -0.7585288882255554, -0.7759602069854736, -4.320199877838604e-07, -0.15067018568515778, -0.04306039214134216, -0.004134799353778362, -0.0003700165543705225, -0.07114697247743607, -2.45848218582978e-06, -0.0027694518212229013, -0.12693913280963898, -0.003601021133363247, -0.0024779161904007196, -2.2200749754119897e-06, -9.353008499601856e-05, -0.0025666221044957638, -4.274932143744081e-05, -1.282920129597187e-05, -0.0344182588160038, -3.5120287066092715e-05, -4.4849443838757e-06, -3.023293538717553e-05, -9.014684110297821e-06