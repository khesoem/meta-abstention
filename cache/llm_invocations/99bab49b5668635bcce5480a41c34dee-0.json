ue;\n        for (int i = 9; i >= 0; --i) {\n            st.push_back({val * 10 + i, d + 1});\n        }\n    }\n}\n\nvoid dfs2(ll val) {\n    if (val * 1000000LL + 999999LL <= n && val * 10000000LL > n) {\n        ans = (ans + query(val, cnt2 + 1)) % MOD;\n        cnt2 += cnt;\n    } else {\n        ++cnt2;\n        ans = (ans + ((cnt2 - val) % MOD2 + MOD2) % MOD2) % MOD;\n        for (int i = (val == 0 ? 1 : 0); i < 10; ++i) {\n            if (val * 10 + i <= n) dfs2(val * 10 + i);\n        }\n    }\n}\n\nint main() {\n    build_positions();\n    for (int i = 0; i < 7; ++i) sort(pos[i].begin(), pos[i].end());\n    pw[0] = 1;\n    for (int i = 1; i < 13; ++i) pw[i] = pw[i - 1] * 10;\n    scanf(\"%lld\", &n);\n    cnt2 = -1;\n    dfs2(0);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n    static final long MOD2 = 998244353L;\n    static ArrayList<Integer>[] pos = new ArrayList[10];\n    static int cnt = 0;\n    static long[] pw = new long[15];\n    static long[] s = new long[15];\n    static long cnt2;\n    static long n;\n    static int ans = 0;\n\n    static class Frame {\n        int val, d;\n        Frame(int v, int dd) { val = v; d = dd; }\n    }\n\n    static int lowerBound(ArrayList<Integer> list, long key) {\n        int lo = 0, hi = list.size();\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            if (list.get(mid) < key) lo = mid + 1;\n            else hi = mid;\n        }\n        return lo;\n    }\n\n    static int query(int fixpre, long val) {\n        long res = 0;\n        for (int d = 0; d < 7; ++d) {\n            long offset = (val - (long)fixpre * pw[d]) % MOD2;\n            if (offset < 0) offset += MOD2;\n            int p = lowerBound(pos[d], MOD2 - offset);\n            