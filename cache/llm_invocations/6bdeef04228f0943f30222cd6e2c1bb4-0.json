{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 5005;\nconst int INF = 1000000007;\nconst int K = 100;\n\nstruct Edge {\n    int to, rev, cap, cost;\n};\n\nstruct MinCostFlow {\n    int n;\n    vector<Edge> G[MAXN];\n    int dist[MAXN], pv[MAXN], pe[MAXN];\n    bool inq[MAXN];\n\n    MinCostFlow(int n) : n(n) {}\n\n    void addEdge(int u, int v, int cap, int cost) {\n        int usz = G[u].size();\n        int vsz = G[v].size();\n        G[u].push_back({v, vsz, cap, cost});\n        G[v].push_back({u, usz, 0, -cost});\n    }\n\n    pair<int,int> minCost(int s, int t) {\n        int flow = 0, cost = 0;\n        while (true) {\n            fill(dist, dist + n, INF);\n            fill(inq, inq + n, false);\n            dist[s] = 0;\n            queue<int> q;\n            q.push(s);\n            inq[s] = true;\n\n            while (!q.empty()) {\n                int u = q.front(); q.pop();\n                inq[u] = false;\n                for (int i = 0; i < (int)G[u].size(); ++i) {\n                    Edge &e = G[u][i];\n                    if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        pv[e.to] = u;\n                        pe[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.push(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            int add = INF;\n            for (int v = t; v != s; v = pv[v]) {\n                add = min(add, G[pv[v]][pe[v]].cap);\n            }\n            flow += add;\n            cost += add * dist[t];\n            for (int v = t; v != s; v = pv[v]) {\n                Edge &e = G[pv[v]][pe[v]];\n                e.cap -= add;\n                G[v][e.rev].cap += add;\n            }\n        }\n        return {flow, cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MinCostFlow mcf(n * K + 2);\n    int src = n * K;\n    int sink = src + 1;\n\n    for (int i = 0; i < K; ++i)\n        mcf.addEdge(i, sink, k, C * i);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.addEdge(src, x * K, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 1; j < K; ++j)\n            mcf.addEdge(i * K + j - 1, i * K + j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n\n        for (int j = 1; j < K; ++j) {\n            int a = u * K + j - 1, b = v * K + j;\n            int c = v * K + j - 1, d = u * K + j;\n\n            for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                mcf.addEdge(a, b, 1, cc);\n                mcf.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n\n    auto res = mcf.minCost(src, sink);\n    cout << res.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass MinCostFlow:\n    def __init__(self, n):\n        self.n = n\n        self.G = [[] for _ in range(n)]\n        self.dist = [0] * n\n        self.pv = [0] * n\n        self.pe = [0] * n\n        self.inq = [False] * n\n\n    def add_edge(self, u, v, cap, cost):\n        # forward edge\n        self.G[u].append([v, len(self.G[v]), cap, cost])\n        # backward edge\n        self.G[v].append([u, len(self.G[u]) - 1, 0, -cost])\n\n    def min_cost(self, s, t):\n        flow = 0\n        cost = 0\n        while True:\n            self.dist = [INF] * self.n\n            self.inq = [False] * self.n\n            self.dist[s] = 0\n            q = deque([s])\n            self.inq[s] = True\n\n            while q:\n                u = q.popleft()\n                self.inq[u] = False\n                for i, e in enumerate(self.G[u]):\n                    if e[2] > 0 and self.dist[e[0]] > self.dist[u] + e[3]:\n                        self.dist[e[0]] = self.dist[u] + e[3]\n                        self.pv[e[0]] = u\n                        self.pe[e[0]] = i\n                        if not self.inq[e[0]]:\n                            q.append(e[0])\n                            self.inq[e[0]] = True\n\n            if self.dist[t] == INF:\n                break\n\n            add = INF\n            v = t\n            while v != s:\n                add = min(add, self.G[self.pv[v]][self.pe[v]][2])\n                v = self.pv[v]\n\n            flow += add\n            cost += add * self.dist[t]\n            v = t\n            while v != s:\n                e = self.G[self.pv[v]][self.pe[v]]\n                e[2] -= add\n                self.G[v][e[1]][2] += add\n                v = self.pv[v]\n\n        return flow, cost\n\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    K = 100\n    total_nodes = n * K + 2\n    mcf = MinCostFlow(total_nodes)\n    src = n * K\n    sink = src + 1\n\n    # edges from time steps of city 0 to sink\n    for i in range(K):\n        mcf.add_edge(i, sink, k, C * i)\n\n    # starting positions\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcf.add_edge(src, x * K, 1, 0)\n\n    # waiting edges within each city\n    for i in range(n):\n        for j in range(1, K):\n            mcf.add_edge(i * K + j - 1, i * K + j, k, 0)\n\n    # road edges\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(1, K):\n            a = u * K + j - 1\n            b = v * K + j\n            c = v * K + j - 1\n            d = u * K + j\n            cc = D\n            for i in range(1, k + 1):\n                mcf.add_edge(a, b, 1, cc)\n                mcf.add_edge(c, d, 1, cc)\n                cc += 2 * D\n\n    res = mcf.min_cost(src, sink)\n    print(res[1])\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -0.0002083561266772449, -0.011793886311352253, 0.0, -0.00043156370520591736, -1.728519782773219e-05, 0.0, 0.0, -2.3841855067985307e-07, -0.0005590544897131622, -0.0837603285908699, -1.1920928244535389e-07, -1.1920922133867862e-06, -0.0011731653939932585, -0.06197747588157654, -1.9073468138230965e-06, -0.04232526570558548, -2.4318398573086597e-05, -0.06196918338537216, 0.0, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.3364747903542593e-05, -0.00033766290289349854, 0.0, 0.0, -1.4305104514278355e-06, 0.0, 0.0, -1.7881377516459906e-06, 0.0, -2.264974000354414e-06, -1.7404405298293568e-05, 0.0, -3.576278118089249e-