clude <string>\n#include <regex>\n#include <vector>\n#include <algorithm>\n#include <sstream>\n\nstd::vector<std::string> split(const std::string& s, char delim) {\n    std::vector<std::string> tokens;\n    std::stringstream ss(s);\n    std::string token;\n    while (std::getline(ss, token, delim)) {\n        tokens.push_back(token);\n    }\n    return tokens;\n}\n\nlong countWords(const std::string& s) {\n    auto parts = split(s, '_');\n    long count = 0;\n    for (const auto& p : parts) {\n        if (!p.empty()) ++count;\n    }\n    return count;\n}\n\nint main() {\n    int n;\n    std::cin >> n;\n    std::string input;\n    std::cin >> input;\n\n    std::regex pattern(R\"(\\([\\w_]*\\))\");\n    std::string outside = std::regex_replace(input, pattern, \"_\");\n\n    auto parts = split(outside, '_');\n    int longest = 0;\n    for (const auto& p : parts) {\n        longest = std::max(longest, (int)p.length());\n    }\n\n    long inside = 0;\n    std::sregex_iterator it(input.begin(), input.end(), pattern);\n    std::sregex_iterator end;\n    while (it != end) {\n        std::string match = it->str();\n        std::string inner = match.substr(1, match.length() - 2);\n        inside += countWords(inner);\n        ++it;\n    }\n\n    std::cout << longest << \" \" << inside << std::endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.3232143828645349e-05, 0.0, 0.0, -0.00021252757869660854, -3.218599158572033e-05, 0.0, -9.536738616588991e-07, -1.0132738680113107e-05, 0.0, 0.0, -3.635817120084539e-05, -1.7881377516459906e-06, 0.0, 0.0, -0.0003359945258125663, -4.768370445162873e-07, 0.0, 0.0, -2.455681169521995e-05, -5.960462772236497e-07, 0.0, 0.0, -0.006715704221278429, -0.004084578715264797, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00017009719158522785, 0.0, -0.018171267583966255, -0.12769865989685059, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, 0.0, -0.00019464982324279845, 0.0, 0.0, 0.0, -0.20141