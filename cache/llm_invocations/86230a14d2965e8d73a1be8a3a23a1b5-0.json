": {"samples": [{"content": "<translated_code>\nimport sys\nfrom typing import List\n\ndef normalize(x: int, MOD: int) -> int:\n    if x < 0:\n        return x + MOD\n    if x >= MOD:\n        return x - MOD\n    return x\n\ndef mod_pow(base: int, exp: int, MOD: int) -> int:\n    result = 1\n    base = base % MOD\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return result\n\ndef precompute_fact(limit: int, MOD: int) -> tuple:\n    fact = [1] * (limit + 1)\n    inv_fact = [1] * (limit + 1)\n    \n    for i in range(1, limit + 1):\n        fact[i] = (fact[i-1] * i) % MOD\n    \n    inv_fact[limit] = mod_pow(fact[limit], MOD - 2, MOD)\n    for i in range(limit - 1, -1, -1):\n        inv_fact[i] = (inv_fact[i+1] * (i + 1)) % MOD\n    \n    return fact, inv_fact\n\ndef FWT(arr: List[int], size: int, sign: int, MOD: int) -> None:\n    len_ = 1\n    while len_ < size:\n        for i in range(0, size, len_ << 1):\n            for j in range(len_):\n                u = arr[i + j]\n                v = (sign * arr[i + j + len_]) % MOD\n                arr[i + j] = normalize(u + v, MOD)\n                arr[i + j + len_] = normalize(u - v, MOD)\n        len_ <<= 1\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k = int(data[1])\n    MOD = int(data[2])\n    \n    # Precompute factorials up to n\n    fact, inv_fact = precompute_fact(n, MOD)\n    \n    if n & 1:\n        print(mod_pow(k, n, MOD))\n        return\n    \n    # Calculate m and l\n    m = 1\n    l = 0\n    while m <= n:\n        m <<= 1\n        l += 1\n    \n    # Count bits\n    cnt = [bin(i).count('1') for i in range(m)]\n    \n    # Precompute factorials up to m\n    fact_m, inv_fact_m = precompute_fact(m, MOD)\n    \n    # Initialize f[19][MAXN]\n    f = [[0] * m for _ in range(19)]\n    \n    for i in range(m):\n        f[cnt[i]][i] = inv_fact_m[i]\n    \n    # Apply FWT to each row\n    for i in range(l + 1):\n        FWT(f[i], m, 1, MOD)\n    \n    # Process each s\n    g = [0] * (l + 1)\n    for s in range(m):\n        for i in range(l + 1):\n            g[i] = f[i][s]\n        \n        res = [0] * (l + 1)\n        res[0] = 1\n        base = g[:]\n        exp = k\n        \n        while exp > 0:\n            if exp & 1:\n                tmp = [0] * (l + 1)\n                for i in range(l + 1):\n                    for j in range(l + 1 - i):\n                        tmp[i + j] = (tmp[i + j] + res[i] * base[j]) % MOD\n                res = tmp\n            \n            sq = [0] * (l + 1)\n            for i in range(l + 1):\n                for j in range(l + 1 - i):\n                    sq[i + j] = (sq[i + j] + base[i] * base[j]) % MOD\n            base = sq\n            exp >>= 1\n        \n        for i in range(l + 1):\n            f[i][s] = res[i]\n    \n    # Apply inverse FWT\n    FWT(f[cnt[n]], m, -1, MOD)\n    \n    ans = normalize(mod_pow(k, n, MOD) - (f[cnt[n]][n] * fact[n]) % MOD, MOD)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018380382971372455, -9.536738616588991e-07, -2.3841855067985307e-07, -0.0029309908859431744, -0.000675807474181056, -0.3484909236431122, -0.30105096101760864, -0.6711981296539307, -4.768370445162873e-07, -4.410734163684538e-06, -0.04342575743794441, -0.04473378136754036, -0.22238977253437042, -2.3841855067985307e-07, -0.01603810116648674, -1.1920928244535389e-07, -0.012519813142716885, -0.0002008474839385599, 0.0, 0.0, -1.0728830375228426e-06, -3.576278118089249e-07, -7.152555099310121e-07, -7.152555099310121e-07, -2.3841855067985307e-07, -0.07034553587436676, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, 0.0, -1.0132738680113107e-05, -3.576278118089249e-07, -0.00014053787162993103, -1.1920928244535389e-07, -2.861018856492592e-06, -5.602820692729438e-06, -1.1920