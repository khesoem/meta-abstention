{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.math.BigInteger;\nimport java.util.Scanner;\n\npublic class Main {\n    private static int weight;\n    private static int itemMass;\n    private static final boolean[] used = new boolean[100];\n\n    static {\n        java.util.Arrays.fill(used, false);\n    }\n\n    public boolean isBalanced() {\n        long left = itemMass;\n        long right = 0;\n\n        for (int iteration = 0; iteration < 200; iteration++) {\n            if (left == right) return true;\n            if (left > right) {\n                long diff = left - right;\n                long candidate = getWeightFor(diff);\n                if (candidate == 0) break;\n                right += candidate;\n            } else {\n                long diff = right - left;\n                long candidate = getWeightFor(diff);\n                if (candidate == 0) break;\n                left += candidate;\n            }\n        }\n        return false;\n    }\n\n    private long getWeightFor(long target) {\n        if (target <= 0) return 0;\n\n        int k = (int) (Math.log(target) / Math.log(weight));\n        BigInteger w = BigInteger.valueOf(weight);\n        BigInteger sum = w.pow(k + 1).subtract(BigInteger.ONE).divide(w.subtract(BigInteger.ONE));\n        long sumVal = sum.longValue();\n\n        if (target > sumVal && !used[k + 1]) {\n            used[k + 1] = true;\n            return (long) Math.pow(weight, k + 1);\n        } else if (target <= sumVal && !used[k]) {\n            used[k] = true;\n            return (long) Math.pow(weight, k);\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) {\n        Scanner in = new Scanner(System.in);\n        weight = in.nextInt();\n        itemMass = in.nextInt();\n        Main instance = new Main();\n        System.out.println(instance.isBalanced() ? \"YES\" : \"NO\");\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <cmath>\n#include <cstring>\n#include <vector>\n#include <algorithm>\n\nclass Main {\nprivate:\n    static int weight;\n    static int itemMass;\n    static bool used[100];\n\npublic:\n    bool isBalanced() {\n        long long left = itemMass;\n        long long right = 0;\n\n        for (int iteration = 0; iteration < 200; iteration++) {\n            if (left == right) return true;\n            if (left > right) {\n                long long diff = left - right;\n                long long candidate = getWeightFor(diff);\n                if (candidate == 0) break;\n                right += candidate;\n            } else {\n                long long diff = right - left;\n                long long candidate = getWeightFor(diff);\n                if (candidate == 0) break;\n                left += candidate;\n            }\n        }\n        return false;\n    }\n\nprivate:\n    long long getWeightFor(long long target) {\n        if (target <= 0) return 0;\n\n        int k = static_cast<int>(std::log(target) / std::log(weight));\n        