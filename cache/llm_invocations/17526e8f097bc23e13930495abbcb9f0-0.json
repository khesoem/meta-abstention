 mod) << 15) + ((cc % mod) << 30)) % mod\n    return res\n\ndef fft(a, b, inverse):\n    n = len(a)\n    # bit-reversal permutation\n    j = 0\n    for i in range(1, n):\n        bit = n >> 1\n        while j & bit:\n            j ^= bit\n            bit >>= 1\n        j ^= bit\n        if i < j:\n            a[i], a[j] = a[j], a[i]\n            b[i], b[j] = b[j], b[i]\n\n    length = 2\n    while length <= n:\n        half_len = length >> 1\n        angle = 2 * math.pi / length * (-1 if inverse else 1)\n        wlen_real = math.cos(angle)\n        wlen_imag = math.sin(angle)\n        for i in range(0, n, length):\n            w_real = 1.0\n            w_imag = 0.0\n            for j in range(half_len):\n                u_real = a[i + j]\n                u_imag = b[i + j]\n                v_real = a[i + j + half_len] * w_real - b[i + j + half_len] * w_imag\n                v_imag = a[i + j + half_len] * w_imag + b[i + j + half_len] * w_real\n                a[i + j] = u_real + v_real\n                b[i + j] = u_imag + v_imag\n                a[i + j + half_len] = u_real - v_real\n                b[i + j + half_len] = u_imag - v_imag\n                # rotate w\n                w_real, w_imag = w_real * wlen_real - w_imag * wlen_imag, w_real * wlen_imag + w_imag * wlen_real\n        length <<= 1\n\n    if inverse:\n        for i in range(n):\n            a[i] /= n\n            b[i] /= n\n\ndef solve():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    n = data[0]\n    k = data[1]\n    v = [0] * 10\n    for i in range(k):\n        x = data[2 + i]\n        v[x] = 1\n    ans = [1]\n    p = n // 2\n    while True:\n        if p % 2 != 0:\n            ans = multiply_mod(ans, v, MOD)\n        p //= 2\n        if p == 0:\n            break\n        v = multiply_mod(v, v, MOD)\n    res = 0\n    for x in ans:\n        res = (res + x * x) % MOD\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<