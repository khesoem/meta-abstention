:\n    for j in range(n):\n        if sci[i][j] == 'Z':\n            rx, ry = i, j\n        elif '0' <= sci[i][j] <= '9':\n            pos.append((i, j))\n            lc.append(int(lab[i][j]))\n            sc.append(int(sci[i][j]))\n\nm = len(pos)\n\ndist = [[0]*n for _ in range(n)]\nvis = [[0]*n for _ in range(n)]\npre()\n\n# Initialize capacity matrix\ncap = [[0]* (2*m + 2) for _ in range(2*m + 2)]\npar = [-1]*(2*m + 2)\n\nfor i in range(m):\n    cap[0][i + 1] = sc[i]\n    cap[m + 1 + i][2*m + 1] = lc[i]\n\n# Initialize mem for dfs\nmem = [[[ [ -1 for _ in range(t+2)] for _ in range(n)] for _ in range(n)] for _ in range(n)]\n\nfor i in range(m):\n    for j in range(m):\n        if dfs(pos[i][0], pos[i][1], pos[j][0], pos[j][1], 0):\n            cap[i + 1][m + 1 + j] = 1000\n\nflow = 0\nwhile fml(0, 2*m + 1):\n    t_node = 2*m + 1\n    nflow = float('inf')\n    while par[t_node] >= 0:\n        nflow = min(nflow, cap[par[t_node]][t_node])\n        t_node = par[t_node]\n    t_node = 2*m + 1\n    while par[t_node] >= 0:\n        cap[par[t_node]][t_node] -= nflow\n        cap[t_node][par[t_node]] += nflow\n        t_node = par[t_node]\n    flow += nflow\n\nprint(flow)\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0015742563409730792, -0.00021843716967850924, -5.512236498361744e-07, -1.843177233240567e-05, -0.38270291686058044, -3.7697225252486533e-06, -4.961759259458631e-06, -0.05575576797127724, -5.574251918005757e-05, 0.0, -1.6240566083070007e-06, -0.01625828631222248, -1.0300084352493286, -0.3875088095664978, -2.816093228830141e-06, -6.337155355140567e-05, 0.0, -0.34853360056877136, -0.0003452368837315589, -0.00171563564799726, -0.001487600733526051, -3.128163257315464e-07, -6.704273118884885e-07, 0.0, -9.13388703338569e-06, -5.512236498361744e-07, -3.4121114822482923e-06, -3.128163257315464e-07, -1.9361264946837764e-07, -3.128163257315464e-07, 0.0, -1.9361264946837764e-07, -4.320199877838604e-07, -1.9361264946837764e-07, -1.247158979