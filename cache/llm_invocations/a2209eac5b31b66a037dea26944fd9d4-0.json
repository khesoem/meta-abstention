\n        d = abs(x - y)\n        if d - self.C[v1][self.r]*self.C[v2][self.r] > self.best:\n            self.cache[k] = v\n            return v\n        if v1 == 0 and v2 == 0:\n            return 1\n        c = self.cs[v1 + v2 - 1]\n        if v1 > 0 and c != 'B':\n            c1 = self.C[v1][self.r] - self.C[v1-1][self.r]\n            s2 = self.C[v2][self.r]\n            v += self.solve(x, y + c1*s2, v1-1, v2)\n        if v2 > 0 and c != 'A':\n            s1 = self.C[v1][self.r]\n            c2 = self.C[v2][self.r] - self.C[v2-1][self.r]\n            v += self.solve(x + s1*c2, y, v1, v2-1)\n        self.cache[k] = v\n        return v\n\n    def start(self):\n        self.r, self.c = map(int, sys.stdin.readline().split())\n        self.cs = sys.stdin.readline().strip()\n        max_n = 2*(self.r + self.c)\n        for i in range(max_n + 1):\n            for j in range(max_n + 1):\n                if j == 0:\n                    self.C[i][j] = 1\n                elif i == 0:\n                    self.C[i][j] = 0\n                else:\n                    self.C[i][j] = self.C[i-1][j-1] + self.C[i-1][j]\n        v1 = self.r + self.c\n        v2 = self.r + self.c\n        x = 0\n        y = 0\n        while v1 > 0 and v2 > 0:\n            if x > y:\n                c1 = self.C[v1][self.r] - self.C[v1-1][self.r]\n                s2 = self.C[v2][self.r]\n                y += c1 * s2\n                v1 -= 1\n            else:\n                s1 = self.C[v1][self.r]\n                c2 = self.C[v2][self.r] - self.C[v2-1][self.r]\n                x += s1 * c2\n                v2 -= 1\n        self.best = abs(x - y)\n        self.dfs(0, 0, self.r + self.c, self.r + self.c)\n        for i in range(2*(self.r + self.c)):\n            self.cntA[i+1] = self.cntA[i] + (1 if self.cs[i] == 'A' else 0)\n            self.cntB[i+1] = self.cntB[i] + (1 if self.cs[i] == 'B' else 0)\n        ans = self.solve(0, 0, self.r + self.c, self.r + self.c)\n        print(ans)\n\nif __name__ =