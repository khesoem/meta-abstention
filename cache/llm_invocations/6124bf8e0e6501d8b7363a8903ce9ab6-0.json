ge % MOD);\n            pq.add(new Item(toMask, nd));\n        } else if (nd == old) {\n            ways.put(toMask, (ways.get(toMask) + ways.get(fromMask) * edge) % MOD);\n        }\n    }\n\n    static void precomputeCombinations() {\n        for (int i = 0; i < 100; i++) {\n            comb[i][0] = 1;\n        }\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= i; j++) {\n                comb[i][j] = (comb[i - 1][j - 1] + comb[i - 1][j]) % MOD;\n            }\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst long long MOD = 1000000007LL;\nint n, k, cnt50 = 0, cnt100 = 0;\nlong long comb[100][100];\n\nstruct Item {\n    int mask;\n    int d;\n    Item(int m, int d) : mask(m), d(d) {}\n    bool operator>(const Item& other) const {\n        return d > other.d;\n    }\n};\n\nlong long modMul(long long a, long long b) {\n    return (a * b) % MOD;\n}\n\nlong long modAdd(long long a, long long b) {\n    return (a + b) % MOD;\n}\n\nvoid precomputeCombinations() {\n    for (int i = 0; i < 100; i++) {\n        comb[i][0] = 1;\n    }\n    for (int i = 1; i < 100; i++) {\n        for (int j = 1; j <= i; j++) {\n            comb[i][j] = modAdd(comb[i - 1][j - 1], comb[i - 1][j]);\n        }\n    }\n}\n\nvoid relax(int fromMask, int toMask, long long edge, unordered_map<int, int>& dist, \n           unordered_map<int, long long>& ways, priority_queue<Item, vector<Item>, greater<Item>>& pq) {\n    int nd = dist[fromMask] + 1;\n    auto it = dist.find(toMask);\n    if (it == dist.end() || nd < it->second) {\n        dist[toMask] = nd;\n        ways[toMask] = modMul(ways[fromMask], edge);\n        pq.push(Item(toMask, nd));\n    } else if (nd == it->second) {\n        ways[toMask] = modAdd(ways[toMask], modMul(ways[fromMask], edge));\n    }\n}\n\nvoid expand(int mask, unordered_map<int, int>& dist, unordered_map<int, long long>& ways, \n            priority_queue<Item, vector<Item>, greater<Item>>& pq) {\n    int boat = mask / 1000000;\n    int left50 = (mask % 1000000) / 100;\n    int left100 = mask % 100;\n\n    if (boat > 0) {\n        for (int i = left50; i >= 0 && 50 * (left50 - i) <= k; i--) {\n            for (int j = left100; j >= 0 && 50 * (left50 - i) + 100 * (left100 - j) <= k; j--) {\n                if (i != left50 || j != left100) {\n                    long long edge = modMul(comb[left50][i], comb[left100][j]);\n                    relax(mask, i * 100 + j, edge, dist, ways, pq);\n                }\n            }\n        }\n    } else {\n        for (int i = left50; i <= cnt50 && 50 * (i - left50) <= k; i++) {\n            for (int j = left100; j <= cnt100 && 50 * (i - left50) + 100 * (j - left100) <= k; j++) {\n                if (i != left50 || j != left100) {\n                    long long edge = modMul(comb[cnt50 - left50][i - left50], comb[cnt100 - left100][j - left100]);\n                    relax(mask, 1000000 + i * 100 + j, edge, dist, ways, pq);\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n\n    cin >> n >> k;\n    for (int i = 0; i < n; i++) {\n        int w;\n        cin >> w;\n        if (w == 50) cnt50++;\n        else cnt100++;\n    }\n\n    precomputeCombinations();\n\n    int start = 1000000 + 100 * cnt50 + cnt100;\n    unordered_map<int, int> dist;\n    unordered_map<int, long long> ways;\n    priority_queue<Item, vector<Item>, greater<Item>> pq;\n\n    dist[start] = 0;\n    ways[start] = 1LL;\n    pq.push(Item(start, 0));\n\n    while (!pq.empty()) {\n        Item cur = pq.top();\n        pq.pop();\n        if (cur.d != dist[cur.mask]) continue;\n        expand(cur.mask, dist, ways, pq);\n    }\n\n    auto it = dist.find(0);\n    if (it != dist.end()) {\n        cout << it->second << \"\\n\" << ways[0] << \"\\n\";\n    } else {\n        cout << \"-1\\n0\\n\";\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.2915253e-06, 0.0, 0.0, -0.00094035745, -0.0007090438, -0.0002070451, -0.31643754, -8.344647e-07, -1.1920928e-07, 0.0, -0.00016735584, -5.6861216e-05, -3.576278e-07, 0.0, -0.06198554, -0.11452635, -0.0008071979, -0.0052343467, -1.1920922e-06, -2.3841855e-07, -1.1920928e-07, -7.486063e-05, 0.0, -1.1920928e-07, -2.3841855e-07, -0.03894726, -0.0067301504, -0.014384974, -3.9099883e-05, -4.2915253e-06, -1.7881378e-06, -0.00861594, -8.344647e-07, -1.1920922e-06, -0.0015200739, -1.1920928e-07, -4.7683704e-07, 0.0, 0.0, 0.0, -1.1920928e-07, 0.0, -4.7683704e-07, -1.883489e-05, -8.165503e-05, -4.7683704e-07, -2.503392e-06, -1.1920928e-07, -0.0014724614, 0.0, -1.1920928e-07, -0.0010569468, -0.09442278, -8.6423e-05, -2.384183e-06, -1.8238856e-05, -5.9006856e-05, -2.264974e-06, -0.07889459, 0.0, -1.4305105e-06, -5.9006856e-05, -2.8610189e-06, -0.00020978635, -0.004081492, -0.0009182051, -9.417091e-05, -0.0004334702, 0.0, -0.0017095489, -0.015849562, -6.5564896e-06, -3.576278e-07, -7.152555e-07, -2.3841855e-07, 0.0, -8.344647e-07, 0.0, -4.887569e-06, -0.0009865661, -2.9563467e-05, -1.1920928e-07, -2.5791712, -2.3841855e-07, 0.0, -0.0040789987, -4.264169, 0.0, -4.7683704e-07, -0.018151015, -1.7881378e-06, -2.0265559e-06, -0.005375811, -2.5033638e-05, -1.4305105e-06, -3.6954812e-06, -0.0003016732, -2.145765e-06, -4.887569e-06, -3.981511e-05, -7.502825, -0.00011526874, -0.78804386, -0.6998572, -4.8874615e-05, -1.7881378e-06, -0.00034540886, -9.5367386e-07, -4.7683704e-07, 0.0, -4.7683704e-07, -0.00041094917, -0.00020442304, -6.198864e-06, -0.00013219437, -0.0016017238, -1.239769e-05, -0.018158274, -1.5497195e-06, -5.960463e-07, -2.3841855e-07, -7.152555e-07, -2.384183e-06, -2.9086643e-05, -2.406683, -1.1920928e-07, -0.005536698, -6.520536e-05, -1.12056105e-05, -3.576278e-07, -0.00016068121, -4.76836e-06, -5.960463e-07, -1.07288