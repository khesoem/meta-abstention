                         for (int num2 = 1; num2 <= s2[x].charAt(y) - '0'; num2++) {\n                                gr[10 * (j + i * 10) + num1].add(10 * (y + 10 * x) + num2);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    static boolean kuhn(int v) {\n        if (used[v]) return false;\n        used[v] = true;\n        for (int to : gr[v]) {\n            if (pa[to] == 0 || kuhn(pa[to])) {\n                pa[to] = v;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    static void solve() throws IOException {\n        scan();\n\n        for (int i = 0; i < max_n; i++) {\n            kuhn(i);\n            Arrays.fill(used, false);\n        }\n\n        int res = 0;\n        for (int i = 0; i < max_n; i++) res += pa[i] != 0;\n\n        System.out.println(res);\n    }\n\n    public static void main(String[] args) throws IOException {\n        solve();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.6345561742782593, -0.004991570953279734, -0.045079950243234634, -0.0045858109369874, -0.00012589294055942446, -0.576732337474823, -0.6748484373092651, -0.00041403996874578297, -2.8610638764803298e-05, -0.021012786775827408, -0.09093010425567627, -0.00711006298661232, -2.741851312748622e-05, -0.04947357252240181, -0.28596392273902893, -0.022886060178279877, -0.536166787147522, -0.905550479888916, -0.14341291785240173, -0.6427101492881775, -0.026118457317352295, -0.0001914088352350518, -0.0002958616241812706, -0.0018634265288710594, -0.006396081764250994, -0.13142530620098114, -0.0004506530531216413, -0.012507910840213299, -0.9388035535812378, -0.3442930281162262, -1.2486951351165771, -0.00029729254310950637, -0.6115573644638062, -0.0017763050273060799, -0.01674327626824379, -0.28290557861328125, -0.0013263673754408956, -0.0005480956751853228, -0.00443259347230196, -0.20682211220264435, -5.7698962336871