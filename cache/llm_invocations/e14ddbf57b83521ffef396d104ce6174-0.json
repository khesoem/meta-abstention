 return f;\n        for (int &i = it[v]; i < (int)g[v].size(); ++i) {\n            Edge &e = g[v][i];\n            if (e.cap > 0 && level[v] < level[e.to]) {\n                ll d = dfs(e.to, min(f, e.cap));\n                if (d > 0) {\n                    e.cap -= d;\n                    g[e.to][e.rev].cap += d;\n                    return d;\n                }\n            }\n        }\n        return 0;\n    }\n    ll max_flow() {\n        ll flow = 0;\n        while (bfs()) {\n            fill(it.begin(), it.end(), 0);\n            ll f;\n            while ((f = dfs(s, 1e18)) > 0) flow += f;\n        }\n        return flow;\n    }\n};\n\nint n, t;\nstring sci[15], cap[15];\nint dis[15][15];\nint dp[65][12][12][12][12];\n\nbool valid(int x, int y) {\n    if (x < 0 || y < 0 || x >= n || y >= n) return false;\n    if (sci[x][y] == 'Y' || sci[x][y] == 'Z') return false;\n    return true;\n}\n\nvoid bfs_zombie(int sx, int sy) {\n    memset(dis, -1, sizeof dis);\n    queue<pii> q;\n    q.push({sx, sy});\n    dis[sx][sy] = 0;\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        for (int i = 0; i < 4; ++i) {\n            int nx = x + dx[i], ny = y + dy[i];\n            if (valid(nx, ny) && dis[nx][ny] == -1) {\n                dis[nx][ny] = dis[x][y] + 1;\n                q.push({nx, ny});\n            }\n        }\n    }\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (dis[i][j] == -1) dis[i][j] = 1000000000;\n}\n\nbool reachable(int tt, int x0, int y0, int x, int y) {\n    if (dis[x0][y0] < tt) return false;\n    if (x0 == x && y0 == y) return true;\n    if (tt >= t) return false;\n    if (dis[x0][y0] <= tt) return false;\n    int &res = dp[tt][x0][y0][x][y];\n    if (res != -1) return res;\n    for (int i = 0; i < 4; ++i) {\n        int nx = x0 + dx[i], ny = y0 + dy[i];\n        if (nx < 0 || nx >= n || ny < 0 || ny >= n) continue;\n        if (sci[nx][ny] == 'Y' || sci[nx][ny] == 'Z') continue;\n        if (reachable(tt + 1, nx, ny, x, y)) return res = 1;\n    }\n    return res = 0;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    memset(dp, -1, sizeof dp);\n    cin >> n >> t;\n    for (int i = 0; i < n; ++i) cin >> sci[i];\n    for (int i = 0; i < n; ++i) cin >> cap[i];\n    bool found = false;\n    for (int i = 0; i < n && !found; ++i)\n        for (int j = 0; j < n && !found; ++j)\n            if (sci[i][j] == 'Z') { bfs_zombie(i, j); found = true; }\n    vector<pii> sc, cp;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            char c = sci[i][j];\n            if (c != 'Z' && c != 'Y' && c != '0') sc.push_back({i, j});\n        }\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            char c = cap[i][j];\n            if (c != 'Z' && c != 'Y' && c != '0') cp.push_back({i, j});\n        }\n    Dinic flow(sc.size() + cp.size() + 2, 0, sc.size() + cp.size() + 1);\n    for (int i = 0; i < (int)sc.size(); ++i) {\n        ll c = sci[sc[i].first][sc[i].second] - '0';\n        flow.add_edge(0, i + 1, c);\n    }\n    for (int i = 0; i < (int)cp.size(); ++i) {\n        ll c = cap[cp[i].first][cp[i].second] - '0';\n        flow.add_edge(sc.size() + 1 + i, sc.size() + cp.size() + 1, c);\n    }\n    for (int i = 0; i < (int)sc.size(); ++i)\n        for (int j = 0; j < (int)cp.size(); ++j)\n            if (reachable(0, sc[i].first, sc[i].second, cp[j].first, cp[j].second))\n                flow.add_edge(i + 1, sc.size() + 1 + j, 10000000);\n    cout << flow.max_flow() << endl;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    sci = [list(next(it).strip()) for _ in range(n)]\n    cap = [list(next(it).strip()) for _ in range(n)]\n\n    dx = [1, -1, 0, 0]\n    dy = [0, 0, 1, -1]\n\n    # BFS from zombie\n    dis = [[-1] * n for _ in range(n)]\n    zombie_found = False\n    for i in range(n):\n        for j in range(n):\n            if sci[i][j] == 'Z':\n                q = deque()\n                q.append((i, j))\n                dis[i][j] = 0\n                while q:\n                    x, y = q.popleft()\n                    for d in range(4):\n                        nx, ny = x + dx[d], y + dy[d]\n                        if 0 <= nx < n and 0 <= ny < n:\n                            if sci[nx][ny] not in ('Y', 'Z') and dis[nx][ny] == -1:\n                                dis[nx][ny] = dis[x][y] + 1\n                                q.append((nx, ny))\n                zombie_found = True\n                break\n        if zombie_found:\n            break\n\n    INF_DIS = 1000000000\n    for i in range(n):\n        for j in range(n):\n            if dis[i][j] == -1:\n                dis[i][j] = INF_DIS\n\n    # memoization for reachable\n    # dp[tt][x0][y0][x][y] = -1 (unknown), 0 (false), 1 (true)\n    dp = [[[[[ -1 for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(t+1)]\n\n    def reachable(tt: int, x0: int, y0: int, x: int, y: int) -> bool:\n        if dis[x0][y0] < tt:\n            return False\n        if x0 == x and y0 == y:\n            return True\n        if tt >= t:\n            return False\n        if dis[x0][y0] <= tt:\n            return False\n        res = dp[tt][x0][y0][x][y]\n        if res != -1:\n            return res == 1\n        for d in range(4):\n            nx, ny = x0 + dx[d], y0 + dy[d]\n            if 0 <= nx < n and 0 <= ny < n:\n                if sci[nx][ny] not in ('Y', 'Z'):\n                    if reachable(tt + 1, nx, ny, x, y):\n                        dp[tt][x0][y0][x][y] = 1\n                        return True\n        dp[tt][x0][y0][x][y] = 0\n        return False\n\n    # collect scientists and capsules\n    scientists = []\n    capsules = []\n    for i in range(n):\n        for j in range(n):\n            c = sci[i][j]\n            if c not in ('Z', 'Y', '0'):\n                scientists.append((i, j))\n            c2 = cap[i][j]\n            if c2 not in ('Z', 'Y', '0'):\n                capsules.append((i, j))\n\n    # Dinic max flow\n    class Dinic:\n        def __init__(self, n: int, s: int, t: int):\n            self.n = n\n            self.s = s\n            self.t = t\n            self.g = [[] for _ in range(n)]\n            self.level = [0] * n\n            self.it = [0] * n\n\n        def add_edge(self, fr: int, to: int, cap: int):\n            # forward edge\n            self.g[fr].append([to, len(self.g[to]), cap])\n            # reverse edge\n            self.g[to].append([fr, len(self.g[fr]) - 1, 0])\n\n        def bfs(self) -> bool:\n            for i in range(self.n):\n                self.level[i] = -1\n            q = deque()\n            self.level[self.s] = 0\n            q.append(self.s)\n            while q:\n                v = q.popleft()\n                for e in self.g[v]:\n                    if e[2] > 0 and self.level[e[0]] < 0:\n                        self.level[e[0]] = self.level[v] + 1\n                        q.append(e[0])\n            return self.level[self.t] >= 0\n\n        def dfs(self, v: int, f: int) -> int:\n            if v == self.t:\n                return f\n            i = self.it[v]\n            while i < len(self.g[v]):\n                e = self.g[v][i]\n                if e[2] > 0 and self.level[v] < self.level[e[0]]:\n                    d = self.dfs(e[0], min(f, e[2]))\n                    if d > 0:\n                        e[2] -= d\n                        self.g[e[0]][e[1]][2] += d\n                        return d\n                i += 1\n                self.it[v] = i\n            return 0\n\n        def max_flow(self) -> int:\n            flow = 0\n            INF = 10**18\n            while self.bfs():\n                for i in range(self.n):\n                    self.it[i] = 0\n                while True:\n                    f = self.dfs(self.s, INF)\n                    if f == 0:\n                        break\n                    flow += f\n            return flow\n\n    S = len(scientists)\n    C = len(capsules)\n    total_nodes = S + C + 2\n    src = 0\n    sink = S + C + 1\n    dinic = Dinic(total_nodes, src, sink)\n\n    # source to scientists\n    for i, (x, y) in enumerate(scientists):\n        c = int(sci[x][y])\n        dinic.add_edge(src, i + 1, c)\n\n    # capsules to sink\n    for j, (x, y) in enumerate(capsules):\n        c = int(cap[x][y])\n        dinic.add_edge(S + 1 + j, sink, c)\n\n    # scientists to capsules if reachable\n    for i, (sx, sy) in enumerate(scientists):\n        for j, (cx, cy) in enumerate(capsules):\n            if reachable(0, sx, sy, cx, cy):\n                dinic.add_edge(i + 1, S + 1 + j, 10000000)\n\n    print(dinic.max_flow())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -0.0019487215904518962, -0.004154978785663843, 0.0, -8.106198947643861e-06, -0.00027426297310739756, -3.576278118089249e-07, 0.0, -4.768370445162873e-07, -0.014181548729538918, -0.12805794179439545, -0.0007584794075228274, -0.25193867087364197, -1.680836794548668e-05, -2.861018856492592e-06, -1.0728830375228426e-06, -7.152555099310121e-07, -0.0011741180205717683, -2.7418097943154862e-06, -2.288792165927589e-05, 0.0, -0.014169678092002869, -1.1920928244535389e-07, -0.0019290901254862547, -3.4570634852570947e-06, -7.152555099310121e-07, -0.38764488697052, -2.634490556374658e-05, -2.3841855067985307e-07, 0.0, -0.0009195152088068426, -9.619726915843785e-05, -7.843663479434326e-05, -4.0531076592742465e-06, -1.1920928244535389e-07, 0.0, 0.0, -9.238292841473594e-05, 0.0, -0.0054356870241463184, -0.0009305914281867445, -3.57627811