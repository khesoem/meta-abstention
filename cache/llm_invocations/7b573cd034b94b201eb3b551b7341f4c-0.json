{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\n#define MAXN 5000010\n#define INF 1000000000\nusing namespace std;\n\ninline int idx(int x, int k, int n) {\n    return x + (k - 1) * n;\n}\n\nint n, m, k, v1, v2, s, t;\nint dist[MAXN];\nbool inq[MAXN];\n\nstruct Edge {\n    int to, nxt, cap, cost;\n} edges[MAXN];\nint head[MAXN], ecnt = 1;\n\nvoid add_edge(int from, int to, int cap, int cost) {\n    edges[++ecnt] = {to, head[from], cap, cost};\n    head[from] = ecnt;\n    edges[++ecnt] = {from, head[to], 0, -cost};\n    head[to] = ecnt;\n}\n\nbool spfa() {\n    queue<int> q;\n    for (int i = s; i <= t; ++i) dist[i] = INF, inq[i] = false;\n    q.push(s); dist[s] = 0; inq[s] = true;\n    while (!q.empty()) {\n        int x = q.front(); q.pop(); inq[x] = false;\n        for (int i = head[x]; i; i = edges[i].nxt) {\n            int y = edges[i].to, c = edges[i].cost;\n            if (dist[y] <= dist[x] + c || !edges[i].cap) continue;\n            dist[y] = dist[x] + c;\n            if (!inq[y]) { inq[y] = true; q.push(y); }\n        }\n    }\n    return dist[t] != INF;\n}\n\nint dfs(int x, int lim) {\n    if (x == t) return lim;\n    inq[x] = true;\n    int flow, res = lim;\n    for (int i = head[x]; i; i = edges[i].nxt) {\n        int y = edges[i].to, cap = edges[i].cap;\n        if (dist[y] != dist[x] + edges[i].cost || !cap || inq[y]) continue;\n        flow = dfs(y, min(res, cap));\n        if (flow) {\n            res -= flow;\n            edges[i].cap -= flow;\n            edges[i ^ 1].cap += flow;\n            if (!res) break;\n        }\n    }\n    return lim - res;\n}\n\nint dinic() {\n    int flow, sum = 0;\n    while (spfa())\n        while (flow = dfs(s, INF))\n            sum += flow * dist[t];\n    return sum;\n}\n\nint main() {\n    auto read_int = [](int &x) {\n        x = 0; char c = getchar(); bool neg = false;\n        while (!isdigit(c)) { if (c == '-') neg = true; c = getchar(); }\n        while (isdigit(c)) { x = (x << 1) + (x << 3) + (c ^ 48); c = getchar(); }\n        if (neg) x = -x;\n    };\n    read_int(n); read_int(m); read_int(k); read_int(v1); read_int(v2);\n    t = idx(n, 110, n) + 1;\n    for (int i = 2; i <= 110; ++i) add_edge(idx(1, i, n), t, INF, 0);\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 110; ++j)\n            add_edge(idx(i, j, n), idx(i, j + 1, n), INF, v1);\n    for (int i = 1, x; i <= k; ++i) { read_int(x); add_edge(s, idx(x, 1, n), 1, 0); }\n    for (int i = 1; i <= m; ++i) {\n        int x, y; read_int(x); read_int(y);\n        for (int j = 1; j < 110; ++j)\n            for (int l = 1; l <= k; ++l) {\n                add_edge(idx(x, j, n), idx(y, j + 1, n), 1, v2 * (2 * l - 1) + v1);\n                add_edge(idx(y, j, n), idx(x, j + 1, n), 1, v2 * (2 * l - 1) + v1);\n            }\n    }\n    printf(\"%d\", dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(1000000)\n\ndef idx(x, k, n):\n    return x + (k - 1) * n\n\ndef add_edge(fr, to, cap, cost):\n    global head, tov, nxt, capv, costv, ecnt\n    # forward\n    tov.append(to)\n    nxt.append(head[fr])\n    capv.append(cap)\n    costv.append(cost)\n    head[fr] = ecnt\n    ecnt += 1\n    # reverse\n    tov.append(fr)\n    nxt.append(head[to])\n    capv.append(0)\n    costv.append(-cost)\n    head[to] = ecnt\n    ecnt += 1\n\ndef spfa():\n    global dist, inq, s, t\n    from collections import deque\n    q = deque()\n    for i in range(s, t+1):\n        dist[i] = INF\n        inq[i] = False\n    q.append(s)\n    dist[s] = 0\n    inq[s] = True\n    while q:\n        x = q.popleft()\n        inq[x] = False\n        i = head[x]\n        while i != -1:\n            y = tov[i]\n            c = costv[i]\n            if dist[y] > dist[x] + c and capv[i] > 0:\n                dist[y] = dist[x] + c\n                if not inq[y]:\n                    inq[y] = True\n                    q.append(y)\n            i = nxt[i]\n    return dist[t] != INF\n\ndef dfs(x, lim):\n    global inq, tov, nxt, capv, costv, dist, t\n    if x == t:\n        return lim\n    inq[x] = True\n    res = lim\n    i = head[x]\n    while i != -1:\n        y = tov[i]\n        cap = capv[i]\n        if dist[y] == dist[x] + costv[i] and cap > 0 and not inq[y]:\n            flow = dfs(y, min(res, cap))\n            if flow:\n                res -= flow\n                capv[i] -= flow\n                capv[i ^ 1] += flow\n                if res == 0:\n                    break\n        i = nxt[i]\n    return lim - res\n\ndef dinic():\n    flow = 0\n    total = 0\n    while spfa():\n        flow = dfs(s, INF)\n        while flow:\n            total += flow * dist[t]\n            flow = dfs(s, INF)\n    return total\n\n# main\ndef main():\n    global INF, n, m, k, v1, v2, s, t, head, tov, nxt, capv, costv, dist, inq, ecnt\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); v1 = next(it); v2 = next(it)\n    N = n * 110 + 2\n    s = 0\n    t = idx(n, 110, n) + 1\n    INF = 10**9\n\n    head = [-1] * N\n    tov = []\n    nxt = []\n    capv = []\n    costv = []\n    ecnt = 0\n    dist = [0] * N\n    inq = [False] * N\n\n    # edges from (1,j) to sink for j>=2\n    for j in range(2, 111):\n        add_edge(idx(1, j, n), t, INF, 0)\n    # self-loop edges for i=2..n and j=1..109\n    for i in range(2, n+1):\n        for j in range(1, 110):\n            add_edge(idx(i, j, n), idx(i, j+1, n), INF, v1)\n    # source edges\n    for _ in range(k):\n        x = next(it)\n        add_edge(s, idx(x, 1, n), 1, 0)\n    # road edges\n    for _ in range(m):\n        x = next(it); y = next(it)\n        for j in range(1, 110):\n            for l in range(1, k+1):\n                cost_ = v2 * (2 * l - 1) + v1\n                add_edge(idx(x, j, n), idx(y, j+1, n), 1, cost_)\n                add_edge(idx(y, j, n), idx(x, j+1, n), 1, cost_)\n\n    result = dinic()\n    sys.stdout.write(str(result))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0005637010326609015, 0.0, -2.3841855067985307e-07, -0.0012403184082359076, -0.0025398635771125555, 0.0, -0.04864955693483353, -0.10817292332649231, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -9.059865078597795e-06, -0.7147799730300903, -0.011053520254790783, -0.21048963069915771, -0.01195280160754919, -0.031174663454294205, -0.5842993259429932, -3.2305197237292305e-05, -0.018210599198937416, -0.00018368464952800423, -9.595887240720913e-05, -7.510157047363464e-06, -0.00028689560713246465, -5.8412379075889476e-06, -0.08032539486885071, -0.00011693747364915907, -6.69933797325939e-05, -2.622600959512056e-06, -2.622600959512056e-06, -0.0006270825979299843, 0.0, -2.3841855067985307e-07, -1.8954096958623268e-05, -8.344646857949556e-07, -4.768370445162873e-07, -0.005775786470621824, -0.0854024589061737, -1.93682861328125, -5.2689116273541003e-05, -0.967