int v = t; v != s; v = pre[v]) {\n                int u = pre[v];\n                f[u][v] += d[t];\n                f[v][u] -= d[t];\n            }\n        }\n        int ans = 0;\n        for (int i = 0; i < N; ++i) ans += f[s][i];\n        return ans;\n    }\n};\n\nint n, t, zi, zj;\nchar a[11][11], b[11][11];\nint dir[4][2] = {{0, 1}, {0, -1}, {1, 0}, {-1, 0}};\nvector<vector<int> > mat;\n\nvoid bfs(int sr, int sc, bool prune) {\n    int src = sr * n + sc;\n    vector<int>& vis = mat[src];\n    queue<pair<int, int> > q;\n    vis[src] = 0;\n    q.push(make_pair(sr, sc));\n    while (!q.empty()) {\n        pair<int, int> cur = q.front(); q.pop();\n        int p = cur.first * n + cur.second;\n        int dis = vis[p];\n        if (prune && (mat[zi * n + zj][p] <= dis || t <= dis)) {\n            if (mat[zi * n + zj][p] < dis || t < dis) vis[p] = INF + 1;\n            continue;\n        }\n        for (int d = 0; d < 4; ++d) {\n            int ni = cur.first + dir[d][0];\n            int nj = cur.second + dir[d][1];\n            if (ni < 0 || nj < 0 || ni == n || nj == n) continue;\n            if (b[ni][nj] < '0' || b[ni][nj] > '9') continue;\n            int nxt = ni * n + nj;\n            if (vis[nxt] != INF) continue;\n            vis[nxt] = dis + 1;\n            q.push(make_pair(ni, nj));\n        }\n    }\n}\n\nvoid build(EdmondsKarp& ek) {\n    vector<int> bcells;\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (b[i][j] <= '0' || b[i][j] > '9') continue;\n            int p = i * n + j;\n            bcells.push_back(p);\n            ek.setCap(p + 2 + n * n, 1, b[i][j] - '0');\n        }\n    }\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (a[i][j] <= '0' || a[i][j] > '9') continue;\n            int p = i * n + j;\n            ek.setCap(0, p + 2, a[i][j] - '0');\n            for (int k = 0; k < (int)bcells.size(); ++k) {\n                int q = bcells[k];\n                if