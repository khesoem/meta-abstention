{\n    LL n;\n    cin>>n;\n//    for(int i = 1; i <= n; i++) cout<<i<<\" \"<<process(i)<<endl;\n    cout<<process(n)<<endl;  \n//    system(\"PAUSE\");\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "import java.util.Scanner;\n\npublic class Main {\n    static long res = 0;\n\n    static int num(long n) {\n        int count = 0;\n        while (n != 0) {\n            n /= 10;\n            count++;\n        }\n        return count;\n    }\n\n    static long find(long n) {\n        int ex = num(n);\n        long cur = 0, ad = 1;\n        for (int i = 0; i <= ex - 1; i++) {\n            cur += ad;\n            ad *= 10;\n        }\n        if (cur <= n)\n            return cur;\n        return ((cur - 1) / 10);\n    }\n\n    static long process(long n) {\n        if (n <= 6) {\n            return n;\n        }\n        if (n <= 11)\n            return (13 - n);\n        long tmp = find(n);\n        long more = tmp * 10 + 1;\n        if (n % tmp == 0) {\n            long t = n / tmp;\n            if (n <= more / 2 + tmp)\n                return num(tmp) * t;\n            else {\n                long cur = process(more - n);\n                return num(more) + cur;\n            }\n        } else {\n            long _m = (n / tmp) * tmp;\n            long _M = (n / tmp + 1) * tmp;\n            long res = process(_m) + process(n - _m);\n            if (n > more / 2)\n                res = Math.min(process(_m) + process(n - _m), num(more) + process(more - n));\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long n = scanner.nextLong();\n        System.out.println(process(n));\n        scanner.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.09580042958259583, -1.9361264946837764e-07, -0.00014025058771949261, -0.0