 if (x == 0) return 1;\n    for (int v : e[x]) {\n        int u = pa[v];\n        if (ds[u] == ds[x] + 1) {\n            if (dfs(u)) {\n                pa[x] = v;\n                pa[v] = x;\n                return 1;\n            }\n        }\n    }\n    return 0;\n}\n\nint hkp() {\n    int an = 0;\n    while (bfs()) {\n        for (int i = 1; i <= sp; ++i) {\n            if (pa[i] == 0)\n                an += dfs(i);\n        }\n    }\n    return an;\n}\n\nint n, t;\n\nvoid wk(int a, int b) {\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            dd[i][j] = 100000;\n    queue<pair<int,int>> q;\n    dd[a][b] = 0;\n    q.push(make_pair(a,b));\n    while (!q.empty()) {\n        int x = q.front().first, y = q.front().second;\n        q.pop();\n        for (int i = 0; i < np[x][y].size(); ++i)\n            for (int j = 0; j < ns[a][b].size(); ++j)\n                ade(ns[a][b][j], np[x][y][i]);\n        if (dd[x][y] == ir[x][y]) continue;\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (sc[nx][ny] != -1 && dd[nx][ny] > dd[x][y] + 1 && dd[x][y] + 1 <= ir[nx][ny]) {\n                dd[nx][ny] = dd[x][y] + 1;\n                q.push(make_pair(nx,ny));\n            }\n        }\n    }\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            ir[i][j] = t;\n    for (int i = 1; i <= n; ++i)\n        scanf(\"%s\", s[i] + 1);\n    for (int i = 1; i <= n; ++i)\n        scanf(\"%s\", p[i] + 1);\n    int rx, ry;\n    sp = 1; pp = 1000;\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (s[i][j] == 'Z' || s[i][j] == 'Y')\n                sc[i][j] = -1, ir[i][j] = 0;\n            if (s[i][j] == 'Z')\n                rx = i, ry = j, ir[i][j] = 0;\n            if ('0' <= s[i][j] && s[i][j] <= '9')\n                sc[i][j] = s[i][j] - '0';\n            for (int k = 0; k < sc[i][j]; ++k)\n                ns[i][j].push_back(sp++);\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if ('0' <= p[i][j] && p[i][j] <= '9')\n                pc[i][j] = p[i][j] - '0';\n            for (int k = 0; k < pc[i][j]; ++k)\n                np[i][j].push_back(pp++);\n        }\n    }\n    queue<pair<int,int>> q;\n    q.push(make_pair(rx, ry));\n    while (!q.empty()) {\n        rx = q.front().first; ry = q.front().second;\n        q.pop();\n        int nx, ny;\n        for (int d = 0; d < 4; ++d) {\n            nx = rx + dx[d];\n            ny = ry + dy[d];\n            if (ir[nx][ny] > ir[rx][ry] + 1 && sc[nx][ny] != -1) {\n                ir[nx][ny] = ir[rx][ry] + 1;\n                q.push(make_pair(nx, ny));\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (sc[i][j] > 0)\n                wk(i, j);\n    printf(\"%d\", hkp());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nsys.setrecursionlimit(10000)\n\n# Global variables\ne = [[] for _ in range(2020)]\nds = [0] * 2020\npa = [0] * 2020\nsp = 1\npp = 1000\nn = 0\nt = 0\n\n# Grids (1-indexed, with extra border for safety)\nsc = [[-1] * 22 for _ in range(22)]\npc = [[0] * 22 for _ in range(22)]\nir = [[100000] * 22 for _ in range(22)]\ndd = [[0] * 22 for _ in range(22)]\nns = [[[] for _ in range(22)] for _ in range(22)]\nnp = [[[] for _ in range(22)] for _ in range(22)]\n\ndx = [0, 1, -1, 0]\ndy = [1, 0, 0, -1]\n\ndef ade(a, b):\n    e[a].append(b)\n    e[b].append(a)\n\ndef bfs():\n    q = deque()\n    for i in range(1, sp + 1):\n        if pa[i] == 0:\n            ds[i] = 0\n            q.append(i)\n        else:\n            ds[i] = 3010\n    ds[0] = 3010\n    while q:\n        u = q.popleft()\n        if ds[u] < ds[0]:\n            for v in e[u]:\n                w = pa[v]\n                if ds[w] > ds[u] + 1:\n                    ds[w] = ds[u] + 1\n                    q.append(w)\n    return ds[0] != 3010\n\ndef dfs(x):\n    if x == 0:\n        return True\n    for v in e[x]:\n        u = pa[v]\n        if ds[u] == ds[x] + 1:\n            if dfs(u):\n                pa[x] = v\n                pa[v] = x\n                return True\n    return False\n\ndef hkp():\n    ans = 0\n    while bfs():\n        for i in range(1, sp + 1):\n            if pa[i] == 0:\n                if dfs(i):\n                    ans += 1\n    return ans\n\ndef wk(a, b):\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            dd[i][j] = 100000\n    q = deque()\n    dd[a][b] = 0\n    q.append((a, b))\n    while q:\n        x, y = q.popleft()\n        # Connect soldier nodes at (a,b) to police nodes at (x,y)\n        for pi in np[x][y]:\n            for si in ns[a][b]:\n                ade(si, pi)\n        if dd[x][y] == ir[x][y]:\n            continue\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 1 <= nx <= n and 1 <= ny <= n:\n                if sc[nx][ny] != -1 and dd[nx][ny] > dd[x][y] + 1 and dd[x][y] + 1 <= ir[nx][ny]:\n                    dd[nx][ny] = dd[x][y] + 1\n                    q.append((nx, ny))\n\ndef main():\n    global sp, pp, n, t\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    # Initialize ir with t for all cells\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            ir[i][j] = t\n    # Read s grid\n    s = [[''] * (n + 1) for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        line = next(it)\n        for j in range(1, n + 1):\n            s[i][j] = line[j - 1]\n    # Read p grid\n    p = [[''] * (n + 1) for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        line = next(it)\n        for j in range(1, n + 1):\n            p[i][j] = line[j - 1]\n    rx, ry = 0, 0\n    sp = 1\n    pp = 1000\n    # Process s grid\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if s[i][j] == 'Z' or s[i][j] == 'Y':\n                sc[i][j] = -1\n                ir[i][j] = 0\n            if s[i][j] == 'Z':\n                rx, ry = i, j\n                ir[i][j] = 0\n            if '0' <= s[i][j] <= '9':\n                sc[i][j] = ord(s[i][j]) - ord('0')\n            else:\n                sc[i][j] = 0\n            for _ in range(sc[i][j]):\n                ns[i][j].append(sp)\n                sp += 1\n    # Process p grid\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if '0' <= p[i][j] <= '9':\n                pc[i][j] = ord(p[i][j]) - ord('0')\n            else:\n                pc[i][j] = 0\n            for _ in range(pc[i][j]):\n                np[i][j].append(pp)\n                pp += 1\n    # BFS from 'Z' to compute ir\n    q = deque()\n    q.append((rx, ry))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 1 <= nx <= n and 1 <= ny <= n:\n                if ir[nx][ny] > ir[x][y] + 1 and sc[nx][ny] != -1:\n                    ir[nx][ny] = ir[x][y] + 1\n                    q.append((nx, ny))\n    # For each cell with soldiers, run wk\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if sc[i][j] > 0:\n                wk(i, j)\n    print(hkp())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-5.8412379075889476e-06, 0.0, -2.3841855067985307e-07, -3.45700973412022e-05, -0.0067732506431639194, 0.0, -5.722029527532868e-06, -0.053573597222566605, 0.0, 0.0, -1.6689286894688848e-06, -0.0069485921412706375, -0.12815725803375244, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -4.86