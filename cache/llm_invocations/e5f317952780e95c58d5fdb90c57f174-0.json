     for i in range(n - 1, 0, -1):\n            for j in range(n):\n                if a[j] < m:\n                    delta = 1\n                else:\n                    delta = -1\n                a[j] = (a[j] + n + i * delta) % n\n        return self.maxDepth(a)\n\n    def maxDepth(self, p):\n        n = len(p)\n        used = [-1] * n\n        ret = 0\n        for i in range(n):\n            cur = 0\n            v = i\n            while used[v] != i:\n                used[v] = i\n                cur += 1\n                v = p[v]\n            ret = max(ret, cur)\n        return ret\n\n    def test(self):\n        for s in range(65536):\n            print(self.solve(65536, 1, s, 1_000_000_000_000), file=sys.stderr)\n\n    def stress(self):\n        tst = 0\n        while True:\n            if False:\n                raise AssertionError()\n            print(tst, file=sys.stderr)\n            tst += 1\n\n    def rand(self, l, r):\n        import random\n        return l + random.randint(0, r - l)\n\n    def readByte(self):\n        if self.bufSz == -1:\n            raise RuntimeError(\"Reading past EOF\")\n        if self.bufPtr >= self.bufSz:\n            self.bufPtr = 0\n            try:\n                self.bufSz = self.is_.readinto(self.buf)\n            except Exception as e:\n                raise RuntimeError(e)\n            if self.bufSz <= 0:\n                return -1\n        ret = self.buf[self.bufPtr]\n        self.bufPtr += 1\n        return ret\n\n    def isTrash(self, c):\n        return c < 33 or c > 126\n\n    def skip(self):\n        b = self.readByte()\n        while b != -1 and self.isTrash(b):\n            b = self.readByte()\n        return b\n\n    def nextToken(self):\n        b = self.skip()\n        sb = []\n        while not self.isTrash(b):\n            sb.append(chr(b))\n            b = self.readByte()\n        return ''.join(sb)\n\n    def nextString(self):\n        b = self.readByte()\n        sb = []\n        while not self.isTrash(b) or b == 32:\n            sb.append(chr(b))\n            b = self.readByte()\n        return ''.join(sb)\n\n    def nextDouble(self):\n        return float(self.nextToken())\n\n    def nextChar(self):\n        return chr(self.skip())\n\n    def nextInt(self):\n        ret = 0\n        b = self.skip()\n        if b != ord('-') and (b < ord('0') or b > ord('9')):\n            raise ValueError(\"Input mismatch\")\n        neg = False\n        if b == ord('-'):\n            neg = True\n            b = self.readByte()\n        while True:\n            if ord('0') <= b <= ord('9'):\n                ret = ret * 10 + (b - ord('0'))\n            else:\n                if b != -1 and not self.isTrash(b):\n                    raise ValueError(\"Input mismatch\")\n                return -ret if neg else ret\n            b = self.readByte()\n\n    def nextLong(self):\n        ret = 0\n        b = self.skip()\n        if b != ord('-') and (b < ord('0') or b > ord('9')):\n            raise ValueError(\"Input mismatch\")\n        neg = False\n        if b == ord('-'):\n            neg = True\n            b = self.readByte()\n        while True:\n            if ord('0') <= b <= ord('9'):\n                ret = ret * 10 + (b - ord('0'))\n            else:\n                if b != -1 and not self.isTrash(b):\n                    raise ValueError(\"Input mismatch\")\n                return -ret if neg else ret\n            b = self.readByte()\n\nif __name__ == \"__main__\":\n    G()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001070442158379592, -4.768370445162873e-07, -1.1920928244535389e-07, -0.0009868042543530464, -0.006075011566281319, -2.777537883957848e-05, -0.007610257249325514, -0.41111868619918823, -0.17978589236736298, -0.1602293848991394, -0.26138660311698914, -0.5759439468383789, -0.10717370361089706, -0.016380829736590385, -0.006729795131832361, -7.593343616463244e-05, -2.861018856492592e-06, -0.012559957802295685, -4.29152532888110