{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nconst int N = 14043;\nconst ll INF = (ll)1e18;\n\nstruct MinCostFlow {\n    struct Edge {\n        int to, cap, flow, cost;\n    };\n\n    int n;\n    vector<vector<int>> g;\n    vector<Edge> e;\n    vector<ll> dist;\n    vector<int> pv, pe, inq;\n    ll total;\n\n    MinCostFlow(int n) : n(n), g(n), dist(n), pv(n), pe(n), inq(n), total(0) {}\n\n    int residual(int id) const {\n        return e[id].cap - e[id].flow;\n    }\n\n    void addEdge(int u, int v, int cap, int cost) {\n        g[u].push_back((int)e.size());\n        e.push_back({v, cap, 0, cost});\n        g[v].push_back((int)e.size());\n        e.push_back({u, 0, 0, -cost});\n    }\n\n    void augment(int s, int t) {\n        fill(dist.begin(), dist.end(), INF);\n        fill(pv.begin(), pv.end(), -1);\n        fill(pe.begin(), pe.end(), -1);\n        fill(inq.begin(), inq.end(), 0);\n\n        queue<int> q;\n        dist[s] = 0;\n        q.push(s);\n        inq[s] = 1;\n\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n            inq[u] = 0;\n\n            for (int id : g[u]) {\n                if (residual(id) <= 0) continue;\n                int v = e[id].to;\n                if (dist[v] > dist[u] + e[id].cost) {\n                    dist[v] = dist[u] + e[id].cost;\n                    pv[v] = u;\n                    pe[v] = id;\n                    if (!inq[v]) {\n                        inq[v] = 1;\n                        q.push(v);\n                    }\n                }\n            }\n        }\n\n        int cur = t;\n        while (cur != s) {\n            int id = pe[cur];\n            e[id].flow++;\n            e[id ^ 1].flow--;\n            cur = pv[cur];\n        }\n\n        total += dist[t];\n    }\n\n    ll minCost(int s, int t, int flow) {\n        for (int i = 0; i < flow; i++) augment(s, t);\n        return total;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int S = N - 2;\n    const int T = N - 1;\n    MinCostFlow mf(N);\n\n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        mf.addEdge(S, x, 1, 0);\n    }\n\n    int tt = 101;\n    for (int i = 0; i < tt; i++)\n        mf.addEdge(1 + i * n, T, k, i * c);\n\n    for (int i = 0; i < m; i++) {\n        int x, y;\n        cin >> x >> y;\n        for (int step = 0; step < tt - 1; step++) {\n            for (int j = 0; j < k; j++) {\n                mf.addEdge(x + step * n, y + step * n + n, 1, d * (j * 2 + 1));\n                mf.addEdge(y + step * n, x + step * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n\n    for (int city = 0; city < n; city++)\n        for (int step = 0; step < tt - 1; step++)\n            mf.addEdge(city + step * n, city + step * n + n, k, 0);\n\n    cout << mf.minCost(S, T, k) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class MinCostFlow {\n        static class Edge {\n            int to, cap, flow, cost;\n            Edge(int to, int cap, int flow, int cost) {\n                this.to = to;\n                this.cap = cap;\n                this.flow = flow;\n                this.cost = cost;\n            }\n        }\n\n        int n;\n        ArrayList<ArrayList<Integer>> g;\n        ArrayList<Edge> e;\n        long[] dist;\n        int[] pv, pe, inq;\n        long total;\n\n        MinCostFlow(int n) {\n            this.n = n;\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) g.add(new ArrayList<>());\n            e = new ArrayList<>();\n            dist = new long[n];\n            pv = new int[n];\n            pe = new int[n];\n            inq = new int[n];\n            total = 0;\n        }\n\n        int residual(int id) {\n            return e.get(id).cap - e.get(id).flow;\n        }\n\n        void addEdge(int u, int v, int cap, int cost) {\n            g.get(u).add(e.size());\n            e.add(new Edge(v, cap, 0, cost));\n            g.get(v).add(e.size());\n            e.add(new Edge(u, 0, 0, -cost));\n        }\n\n        void augment(int s, int t) {\n            Arrays.fill(dist, Long.MAX_VALUE / 2);\n            Arrays.fill(pv, -1);\n            Arrays.fill(pe, -1);\n            Arrays.fill(inq, 0);\n\n            LinkedList<Integer> q = new LinkedList<>();\n            dist[s] = 0;\n            q.add(s);\n            inq[s] = 1;\n\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = 0;\n\n                for (int id : g.get(u)) {\n                    if (residual(id) <= 0) continue;\n                    int v = e.get(id).to;\n                    if (dist[v] > dist[u] + e.get(id).cost) {\n                        dist[v] = dist[u] + e.get(id).cost;\n                        pv[v] = u;\n                        pe[v] = id;\n                        if (inq[v] == 0) {\n                            inq[v] = 1;\n                            q.add(v);\n                        }\n                    }\n                }\n            }\n\n            int cur = t;\n            while (cur != s) {\n                int id = pe[cur];\n                e.get(id).flow++;\n                e.get(id ^ 1).flow--;\n                cur = pv[cur];\n            }\n\n            total += dist[t];\n        }\n\n        long minCost(int s, int t, int flow) {\n            for (int i = 0; i < flow; i++) augment(s, t);\n            return total;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        final int N = 14043;\n        final int S = N - 2;\n        final int T = N - 1;\n        MinCostFlow mf = new MinCostFlow(N);\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            mf.addEdge(S, x, 1, 0);\n        }\n\n        int tt = 101;\n        for (int i = 0; i < tt; i++) {\n            mf.addEdge(1 + i * n, T, k, i * c);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int step = 0; step < tt - 1; step++) {\n                for (int j = 0; j < k; j++) {\n                    mf.addEdge(x + step * n, y + step * n + n, 1, d * (j * 2 + 1));\n                    mf.addEdge(y + step * n, x + step * n + n, 1, d * (j * 2 + 1));\n                }\n            }\n        }\n\n        for (int city = 0; city < n; city++) {\n            for (int step = 0; step < tt - 1; step++) {\n                mf.addEdge(city + step * n, city + step * n + n, k, 0);\n            }\n        }\n\n        System.out.println(mf.minCost(S, T, k));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, -5.018585216021165e-05, -0.0007322729215957224, 0.0, -3.540453326422721e-05, -0.001348301419056952, -0.006719848606735468, -1.1920928244535389e-07, -0.31359440088272095, -0.038048069924116135, -0.0011728082317858934, -0.000800408364739269, -0.31331750750541687, -0.02975180558860302, -1.1920928244535389e-07, 0.0, -1.311301275563892e-06, -8.344646857949556e-07, -0.0007645544828847051, -0.000912250077817589, 0.0, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, 0.0, -3.540453326422721e-05, -2.3841855067985307e-07, 0.0, 0.0, -1.1444026313256472e-05, 0.0, -0.005252371542155743, -2.2053474822314456e-05, -5.960462772236497e-07, -8.4638240878121e-06, -0.12693414092063904, -1.2993727978027891e-05, 0.0, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -0.02324754372239113, 0.0, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -0.0001399419124936685, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, -2.264974000354414e-06, -1.1920928244535389e-07, 0.0, -1.9073468138230965e-06, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, -0.002476127352565527, 0.0, -0.0008000510279089212, 0.0, -3.576278118089249e-07, 0.0, -0.011053637601435184, -1.0132738680113107e-05, -4.887569048150908e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.2636104656849056e-05, 0.0, -6.198863957251888e-06, 0.0, 0.0, 0.0, -1.0728830375228426e-06, -3.933898824470816e-06, 0.0, -2.264974000354414e-06, -1.156323378381785e-05, 0.0, -2.4676019165781327e-05, 0.0, -1.7881377516459906e-06, 0.0, -2.3841855067985307e-07, 0.0, -0.005234109237790108, 0.0, -0.06197276711463928, -1.1920928244535389e-07, -5.960462772236497e-07, -