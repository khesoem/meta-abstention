w:\n                Min = edges[i].cap - edges[i].flow\n            i = pre[edges[i ^ 1].to]\n        i = pre[t]\n        while i != -1:\n            edges[i].flow += Min\n            edges[i ^ 1].flow -= Min\n            cost += edges[i].cost * Min\n            i = pre[edges[i ^ 1].to]\n        flow += Min\n    return flow, cost\n\ninit(MAXN)\nx = list(map(int, input().split()))\nn, m, k, c, d = x[0], x[1], x[2], x[3], x[4]\nfor _ in range(k):\n    x = int(input())\n    addedge(0, x, 1, 0)\nfor i in range(100):\n    for j in range(k):\n        addedge(1 + i * n, 9999, 1, i * c)\nfor _ in range(m):\n    u, v = map(int, input().split())\n    for j in range(1, 101):\n        for gg in range(1, k + 1):\n            addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d)\n            addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d)\nfor i in range(1, n + 1):\n    for j in range(1, 100):\n        addedge(i + (j - 1) * n, i + j * n, k, 0)\n\nflow, cost = minCostMaxflow(0, 9999)\nprint(cost)\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.002573875244706869, -0.0008093867218121886, -4.320199877838604e-07, -0.0001431114797014743, -0.21647986769676208, -0.03257456049323082, -0.011432451196014881, -1.0921942703134846e-05, -0.025708740577101707, -5.512236498361744e-07, -3.292907877039397e-06, 0.0, -1.0280383548888494e-06, -2.2127087504486553e-05, 0.0, -5.5577775128767826e-06, 0.0, 0.0, -0.00015276329941116273, -1.8624639324116288e-06, -0.00030805266578681767, 0.0, -6.704273118884885e-07, -1.0921942703134846e-05, -2.5776860184123507e-06, -4.961759259458631e-06, 0.0, 0.0, -0.15113693475723267, -0.011822475120425224, -0.0002737330214586109, -8.208653162000701e-05, -4.320199877838604e-07, -1.9361264946837764e-07, -6.704273118884885e-07, -0.00024870390188880265, -0.002608356298878789, -3.8889261304575484e-06, -6.704273118884885e-07, -1.9361264946837764e-07, -4.127333340875339e-06, -6.630610641877865e-06, -7.226628895296017e-06, -0.000171597479