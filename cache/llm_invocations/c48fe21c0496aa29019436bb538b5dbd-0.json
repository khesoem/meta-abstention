urn x * o.x + y * o.y; }\n    double cross(const Vec& o) const { return x * o.y - y * o.x; }\n    double mag2() const { return dot(*this); }\n    double mag() const { return sqrt(mag2()); }\n    Vec unit() const { return scale(1 / mag()); }\n    Vec rot90() const { return Vec(-y, x); }\n    Vec rot270() const { return Vec(y, -x); }\n    \n    Vec rotate(double theta) const {\n        double newX = x * cos(theta) + y * cos(M_PI / 2 + theta);\n        double newY = x * sin(theta) + y * sin(M_PI / 2 + theta);\n        return Vec(newX, newY);\n    }\n    \n    double angle() const {\n        return fmod(atan2(y, x) + 2 * M_PI, 2 * M_PI);\n    }\n    \n    static bool eq(double a, double b) { return fabs(a - b) < EPS; }\n    static bool leq(double a, double b) { return a - EPS < b; }\n    static bool geq(double a, double b) { return a + EPS > b; }\n    \n    bool operator<(const Vec& other) const {\n        if (eq(x, other.x)) return y < other.y - EPS;\n        return x < other.x - EPS;\n    }\n    \n    bool operator==(const Vec& other) const {\n        return eq(x, other.x) && eq(y, other.y);\n    }\n};\n\nstruct Circle {\n    Vec center;\n    double radius;\n    \n    Circle(const Vec& center, double radius) : center(center), radius(radius) {}\n    \n    bool contains(const Vec& v) const {\n        return center.sub(v).mag2() - EPS * EPS <= radius * radius;\n    }\n    \n    vector<Vec> intersect(const Circle& other) const {\n        if (Vec::eq(center.x, other.center.x) && Vec::eq(center.y, other.center.y)) {\n            return {};\n        }\n        Vec direction = other.center.sub(center);\n        double distSq = direction.mag2();\n        double dist = sqrt(distSq);\n        \n        if (radius + other.radius < dist - EPS || radius + dist < other.radius - EPS || other.radius + dist < radius - EPS) {\n            return {};\n        }\n        \n        if (Vec::eq(radius + other.radius, dist) || Vec::eq(other.radius + dist, radius)) {\n            return {center.add(direction.scale(radius / dist))};\n        }\n        if (Vec::eq(radius + dist, other.radius)) {\n            return {center.sub(direction.scale(radius / dist))};\n        }\n        \n        double d1 = (radius * radius + distSq - other.radius * other.radius) / (2 * dist);\n        double h = sqrt(max(0.0, radius * radius - d1 * d1));\n        Vec unitDir = direction.unit();\n        Vec rightInt = center.add(unitDir.scale(d1).add(unitDir.rot270().scale(h)));\n        Vec leftInt = center.add(unitDir.scale(d1).add(unitDir.rot90().scale(h)));\n        return {rightInt, leftInt};\n    }\n};\n\nint find(vector<int>& parent, int x) {\n    if (parent[x] != x) {\n        parent[x] = find(parent, parent[x]);\n    }\n    return parent[x];\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n;\n    cin >> n;\n    \n    vector<Circle> circles;\n    for (int i = 0; i < n; i++) {\n        int x, y, r;\n        cin >> x >> y >> r;\n        circles.emplace_back(Vec(x, y), r);\n    }\n    \n    vector<Vec> allPoints;\n    vector<int> parent(n);\n    for (int i = 0; i < n; i++) parent[i] = i;\n    int result = 1;\n    \n    for (int i = 0; i < n; i++) {\n        set<Vec> currentSet;\n        for (int j = 0; j < n; j++) {\n            if (i == j) continue;\n            vector<Vec> pts = circles[i].intersect(circles[j]);\n            if (pts.empty()) continue;\n            \n            int rootI = find(parent, i);\n            int rootJ = find(parent, j);\n            parent[rootI] = rootJ;\n            \n            for (const Vec& p : pts) {\n                currentSet.insert(p);\n            }\n        }\n        \n        result += currentSet.size();\n        \n        for (const Vec& p : currentSet) {\n            allPoints.push_back(p);\n        }\n    }\n    \n    sort(allPoints.begin(), allPoints.end());\n    allPoints.erase(unique(allPoints.begin(), allPoints.end()), allPoints.end());\n    \n    result -= allPoints.size(