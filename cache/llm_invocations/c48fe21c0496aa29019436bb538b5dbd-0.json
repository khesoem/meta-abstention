 p : pts) {\n                    boolean found = false;\n                    for (Vec q : currentSet) {\n                        if (p.equals(q)) {\n                            found = true;\n                            break;\n                        }\n                    }\n                    if (!found) currentSet.add(p);\n                }\n            }\n            \n            result += currentSet.size();\n            \n            for (Vec p : currentSet) {\n                boolean found = false;\n                for (Vec q : allPoints) {\n                    if (p.equals(q)) {\n                        found = true;\n                        break;\n                    }\n                }\n                if (!found) allPoints.add(p);\n            }\n        }\n        \n        result -= allPoints.size();\n        int components = (int) IntStream.range(0, n).filter(i -> parent[i] == i).count();\n        result += components;\n        \n        System.out.println(result);\n    }\n    \n    private static int find(int[] parent, int x) {\n        if (parent[x] != x) {\n            parent[x] = find(parent, parent[x]);\n        }\n        return parent[x];\n    }\n    \n    static class Circle {\n        Vec center;\n        double radius;\n        \n        public Circle(Vec center, double radius) {\n            this.center = center;\n            this.radius = radius;\n        }\n        \n        public boolean contains(Vec v) {\n            return center.sub(v).mag2() - Vec.EPS * Vec.EPS <= radius * radius;\n        }\n        \n        public Vec[] intersect(Circle other) {\n            if (center.equals(other.center)) return null;\n            Vec direction = other.center.sub(center);\n            double distSq = direction.mag2();\n            double dist = Math.sqrt(distSq);\n            \n            if (radius + other.radius < dist || radius + dist < other.radius || other.radius + dist < radius) {\n                return null;\n            }\n            \n            if (Vec.eq(radius + other.radius, dist) || Vec.eq(other.radius + dist, radius)) {\n                return new Vec[]{center.add(direction.scale(radius / dist))};\n            }\n            if (Vec.eq(radius + dist, other.radius)) {\n                return new Vec[]{center.sub(direction.scale(radius / dist))};\n            }\n            \n            double d1 = (radius * radius + distSq - other.radius * other.radius) / (2 * dist);\n            double h = Math.sqrt(radius * radius - d1 * d1);\n            Vec unitDir = direction.unit();\n            Vec rightInt = center.add(unitDir.scale(d1).add(unitDir.rot270().scale(h)));\n            Vec leftInt = center.add(unitDir.scale(d1).add(unitDir.rot90().scale(h)));\n            return new Vec[]{rightInt, leftInt};\n        }\n    }\n\n    static class Vec {\n        static final double EPS = 1e-9;\n        double x, y;\n        \n        public Vec(double x, double y) {\n            this.x = x;\n            this.y = y;\n        }\n        \n        public Vec add(Vec o) { return new Vec(x + o.x, y + o.y); }\n        public Vec sub(Vec o) { return new Vec(x - o.x, y - o.y); }\n        public Vec scale(double s) { return new Vec(x * s, y * s); }\n        public double dot(Vec o) { return x * o.x + y * o.y; }\n        public double cross(Vec o) { return x * o.y - y * o.x; }\n        public double mag2() { return dot(this); }\n        public double mag() { return Math.sqrt(mag2()); }\n        public Vec unit() { return scale(1 / mag()); }\n        public Vec rot90() { return new Vec(-y, x); }\n        public Vec rot270() { return new Vec(y, -x); }\n        \n        public Vec rotate(double theta) {\n            double newX = x * Math.cos(theta) + y * Math.cos(Math.PI / 2 + theta);\n            double newY = x * Math.sin(theta) + y * Math.sin(Math.PI / 2 + theta);\n            return new Vec(newX, newY);\n        }\n        \n        public double angle() {\n            return (Math.atan2(y, x) + 2 * Math.