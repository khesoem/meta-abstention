{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 10000;\nconst int MAXM = 2000000;\nconst int INF = 0x3f3f3f3f;\n\nint n, m, k, c, d;\n\nstruct Edge {\n    int to, next, cap, flow, cost;\n} edge[MAXM];\nint head[MAXN], tol;\nint pre[MAXN], dis[MAXN];\nbool vis[MAXN];\nint N;\n\nvoid init(int n) {\n    N = n;\n    tol = 0;\n    memset(head, -1, sizeof(head));\n}\n\nvoid addedge(int u, int v, int cap, int cost) {\n    edge[tol].to = v;\n    edge[tol].cap = cap;\n    edge[tol].cost = cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[u];\n    head[u] = tol++;\n    edge[tol].to = u;\n    edge[tol].cap = 0;\n    edge[tol].cost = -cost;\n    edge[tol].flow = 0;\n    edge[tol].next = head[v];\n    head[v] = tol++;\n}\n\nbool spfa(int s, int t) {\n    queue<int> q;\n    for (int i = 0; i < N; ++i) {\n        dis[i] = INF;\n        vis[i] = false;\n        pre[i] = -1;\n    }\n    dis[s] = 0;\n    vis[s] = true;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        vis[u] = false;\n        for (int i = head[u]; i != -1; i = edge[i].next) {\n            int v = edge[i].to;\n            if (edge[i].cap > edge[i].flow && dis[v] > dis[u] + edge[i].cost) {\n                dis[v] = dis[u] + edge[i].cost;\n                pre[v] = i;\n                if (!vis[v]) {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return pre[t] != -1;\n}\n\nint minCostMaxflow(int s, int t, int& cost) {\n    int flow = 0;\n    cost = 0;\n    while (spfa(s, t)) {\n        int Min = INF;\n        for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n            Min = min(Min, edge[i].cap - edge[i].flow);\n        }\n        for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n            edge[i].flow += Min;\n            edge[i ^ 1].flow -= Min;\n            cost += edge[i].cost * Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\n\nint main() {\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    init(MAXN);\n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        addedge(0, x, 1, 0);\n    }\n    for (int i = 0; i < 100; ++i) {\n        for (int j = 0; j < k; ++j) {\n            addedge(1 + i * n, 9999, 1, i * c);\n        }\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        for (int j = 1; j < 100; ++j) {\n            for (int gg = 1; gg <= k; ++gg) {\n                addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            addedge(i + (j - 1) * n, i + j * n, k, 0);\n        }\n    }\n    int cost;\n    minCostMaxflow(0, 9999, cost);\n    printf(\"%d\\n\", cost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 10000\nMAXM = 2000000\nINF = 10**9\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'flow', 'cost', 'next')\n    def __init__(self, to, cap, cost, next):\n        self.to = to\n        self.cap = cap\n        self.flow = 0\n        self.cost = cost\n        self.next = next\n\ndef init(n):\n    global N, head, tol, edge\n    N = n\n    head = [-1] * N\n    tol = 0\n    edge = []\n\ndef addedge(u, v, cap, cost):\n    global tol, edge, head\n    edge.append(Edge(v, cap, cost, head[u]))\n    head[u] = tol\n    tol += 1\n    edge.append(Edge(u, 0, -cost, head[v]))\n    head[v] = tol\n    tol += 1\n\ndef spfa(s, t):\n    global N, head, edge, dis, vis, pre\n    dis = [INF] * N\n    vis = [False] * N\n    pre = [-1] * N\n    dis[s] = 0\n    vis[s] = True\n    q = deque([s])\n    while q:\n        u = q.popleft()\n        vis[u] = False\n        i = head[u]\n        while i != -1:\n            e = edge[i]\n            if e.cap > e.flow and dis[e.to] > dis[u] + e.cost:\n                dis[e.to] = dis[u] + e.cost\n                pre[e.to] = i\n                if not vis[e.to]:\n                    vis[e.to] = True\n                    q.append(e.to)\n            i = e.next\n    return pre[t] != -1\n\ndef minCostMaxflow(s, t):\n    flow = 0\n    cost = 0\n    while spfa(s, t):\n        Min = INF\n        i = pre[t]\n        while i != -1:\n            e = edge[i]\n            Min = min(Min, e.cap - e.flow)\n            i = pre[edge[i ^ 1].to]\n        i = pre[t]\n        while i != -1:\n            e = edge[i]\n            e.flow += Min\n            edge[i ^ 1].flow -= Min\n            cost += e.cost * Min\n            i = pre[edge[i ^ 1].to]\n        flow += Min\n    return flow, cost\n\ndef main():\n    global N, head, tol, edge, dis, vis, pre\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    init(MAXN)\n    for _ in range(k):\n        x = int(next(it))\n        addedge(0, x, 1, 0)\n    for i in range(100):\n        for _ in range(k):\n            addedge(1 + i * n, 9999, 1, i * c)\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(1, 100):\n            for gg in range(1, k + 1):\n                addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d)\n                addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d)\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            addedge(i + (j - 1) * n, i + j * n, k, 0)\n    flow, cost = minCostMaxflow(0, 9999)\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0005762108485214412, -1.1920928244535389e-07, 0.0, -0.0005433275364339352, -0.009488249197602272, -5.9126061387360096e-05, -6.294052582234144e-05, -0.0019309938652440906, -1.1920922133867862e-06, 0.0, -2.264974000354414e-06, -0.0020147517789155245, -0.5994546413421631, -0.001312348060309887, -3.2186455882765586e-06, -1.1920928244535389e-07, -2.682172998902388e-05, -0.0004440752090886235, -0.0010924329981207848, -0.38695383071899414, -3.3378546504536644e-06, -1.1920922133867862e-06, -1.6689286894688848e-06, -3.838465272565372e-05, -5.960462772236497e-07, -4.362964682513848e-05, -0.00030870441696606576, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.002363271312788129, -0.5760750770568848, -0.0024757706560194492, -0.030578015372157097, -0.018664682283997536, -0.6027222275733948, -0.0003849719068966806, -3.933898824470816e-06, -9.536738616588991e-07, -0.10024001449346542, 0.0, 0.0, -8.344646857949556e-07, -1.5497195136049413e-06, -0.010534865781664848, -2.3841830625315197e-06, -0.0005529781919904053, -0.0002040654799202457, -0.5837845802307129, -4.768370445162873e-07, -4.768370445162873e-07, -0.029753541573882103, -3.576278118089249e-07, -1.192092