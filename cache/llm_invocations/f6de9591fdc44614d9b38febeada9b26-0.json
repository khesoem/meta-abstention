iginal_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <sstream>\n#include <cmath>\n#include <algorithm>\n\nusing namespace std;\n\nbool check(int good, int bad, double proba) {\n    double g = good + 0.0;\n    double b = bad + 0.0;\n    double max0_g = max(0.0, g);\n    double max0_b = max(0.0, b);\n    double max0_g_minus1 = max(0.0, g - 1.0);\n    double max0_g_minus2 = max(0.0, g - 2.0);\n    double max0_gb_minus1 = max(0.0, g + b - 1.0);\n    double max0_gb_minus2 = max(0.0, g + b - 2.0);\n    \n    double numerator = (0.25 * b * max0_b * (max0_b - 1.0) * g) + \n                       (g * (max0_g * max0_g_minus1 * max0_g_minus2 / 6.0) + \n                        b * 0.5 * g * max0_g_minus1);\n    double denominator = (g + b) * max0_gb_minus1 * max0_gb_minus2 / 6.0;\n    \n    double ans = numerator / denominator;\n    return ans >= proba;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    \n    int x;\n    double prob;\n    iss >> x >> prob;\n    \n    int pos = x;\n    for (int a = x; a > 0; a /= 2) {\n        while (pos - a >= 0 && check(pos - a, x - (pos - a), prob)) {\n            pos -= a;\n        }\n    }\n    \n    cout << pos << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00027843413408845663, -4.768360213347478e-06, -7.152555099310121e-07, -8.928377064876258e-05, -4.6491513785440475e-06, -4.172316494077677e-06, -1.3708974620385561e-05, -3.2186455882765586e-06, -7.152555099310121e-07, -0.3629905879497528, -9.846202738117427e-05, -6.198863957251888e-06, -5.960446742392378e-06, -0.07155802845954895, -8.344646857949556e-07, -4.529942543740617e-06, -7.152555099310121e-07, -0.23348748683929443, -0.3132646977901459, -0.01815604791045189, -4.768370445162873e-07, -0.22473882138729095, -0.0263050924986