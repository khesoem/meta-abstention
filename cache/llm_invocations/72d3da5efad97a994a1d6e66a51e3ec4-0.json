d()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self._isSpaceChar(c):\n            if c < ord('0') or c > ord('9'):\n                raise Exception(\"Input mismatch\")\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n        return res * sgn\n    \n    def nextInt(self):\n        return int(self.nextLong())\n    \n    def nextIntArray(self, n):\n        return [self.nextInt() for _ in range(n)]\n    \n    def nextLongArray(self, n):\n        return [self.nextLong() for _ in range(n)]\n    \n    def _isSpaceChar(self, c):\n        return c in (ord(' '), ord('\\n'), ord('\\r'), ord('\\t'), -1)\n    \n    def _isEndOfLine(self, c):\n        return c in (ord('\\n'), ord('\\r'), -1)\n\ndef main():\n    sc = FasterScanner()\n    \n    W = sc.nextInt()\n    M = sc.nextInt()\n    \n    B = [0] * 101\n    tmp = M\n    for i in range(100):\n        B[i] = tmp % W\n        tmp //= W\n    \n    for i in range(100):\n        if B[i] > 1:\n            B[i] -= W\n            B[i + 1] += 1\n    \n    for i in range(101):\n        if B[i] < -1 or B[i] > 1:\n            print(\"NO\")\n            return\n    \n    print(\"YES\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.325883881188929e-05, -9.536738616588991e-07, 0.0, -0.0011891205795109272, -0.00010275312524754554, -0.003606365295127034, -0.11284215748310089, -0.013358143158257008, -3.099436753473128e-06, -4.291525328881107e-06, -5.960462772236497e-07, -1.311301275563892e-06, -6.556489552167477e-06, -1.0728830375228426e-06, -5.960462772236497e-07, -5.960462772236497e-07, -7.819823804311454e-05, -1.5497195136049413e-06, -9.536738616588991e-07, -0.002232323167845607, -7.748303323751315e-05, -0.07771766185760498, -0.07889382541179657, -1.6689286894688848e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.7881377516459906e-06, -1.31