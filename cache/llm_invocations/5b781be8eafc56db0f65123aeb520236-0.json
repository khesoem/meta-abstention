r (int mask = 0; mask < N; ++mask) {\n        for (int j = 0; j < (int)bits.size(); ++j)\n            if (mask >> j & 1) S[mask] += bits[j];\n    }\n    \n    vector<int> p(N);\n    for (int mask = 0; mask < N; ++mask) {\n        int last = -1;\n        for (int j = 0; j <= 20; ++j)\n            if (mask >> j & 1) last = j;\n        p[mask] = (1 << (last + 1)) + mask;\n    }\n    \n    vector<vector<lint>> dp(k + 1, vector<lint>(N));\n    dp[0][0] = 1;\n    \n    for (int i = 0; i < k; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (dp[i][j]) {\n                for (int next = p[j]; next < N; next = (next + 1) | j) {\n                    dp[i+1][next] = (dp[i+1][next] + dp[i][j] * inv_fact[S[next ^ j]]) % MOD;\n                }\n            }\n        }\n    }\n    \n    lint ans = 0;\n    for (int i = 0; i <= k; ++i) {\n        ans = (ans + dp[i][N-1] * perm(k, i, fact, inv_fact, MOD)) % MOD;\n    }\n    ans = ans * fact[n] % MOD;\n    ans = (mod_pow(k, n, MOD) - ans + MOD) % MOD;\n    \n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long modPow(long b, int e, long m) {\n        long r = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) r = r * b % m;\n            b = b * b % m;\n            e >>= 1;\n        }\n        return r;\n    }\n\n    static long perm(int n, int r, long[] fact, long[] invFact, long mod) {\n        return fact[n] * invFact[n - r] % mod;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int MOD = Integer.pars