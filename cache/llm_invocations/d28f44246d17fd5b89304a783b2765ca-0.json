       flow_cap[s] = INF;\n            \n            while (!pq.empty()) {\n                auto [d, u] = pq.top();\n                pq.pop();\n                \n                if (d != dist[u]) continue;\n                \n                for (int i = 0; i < (int)adj[u].size(); ++i) {\n                    Edge &e = adj[u][i];\n                    int v = e.to;\n                    \n                    if (e.cap <= e.f) continue;\n                    \n                    Cost nd = dist[u] + e.cost + pot[u] - pot[v];\n                    if (dist[v] > nd) {\n                        dist[v] = nd;\n                        pq.emplace(nd, v);\n                        prev_v[v] = u;\n                        prev_e[v] = i;\n                        flow_cap[v] = min(flow_cap[u], e.cap - e.f);\n                    }\n                }\n            }\n            \n            if (dist[t] == INF) break;\n            \n            for (int i = 0; i < n; ++i)\n                pot[i] += dist[i];\n            \n            Flow df = min(flow_cap[t], INF - total_flow);\n            total_flow += df;\n            \n            for (int v = t; v != s; v = prev_v[v]) {\n                Edge &e = adj[prev_v[v]][prev_e[v]];\n                e.f += df;\n                adj[v][e.rev].f -= df;\n                total_cost += df * e.cost;\n            }\n        }\n        \n        return {total_flow, total_cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    const int T = 500;\n    int N = n * T;\n    MinCostFlow solver(N + 2);\n    \n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < T - 1; ++j)\n            solver.connect(i * T + j, i * T + j + 1, INF, c);\n    \n    for (int j = 0; j < T; ++j)\n        solver.connect(j, N + 1, INF, 0);\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        solver.connect(N, x * T, 1, 