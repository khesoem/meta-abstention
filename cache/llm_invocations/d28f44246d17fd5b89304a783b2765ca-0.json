.add(new Edge(v, adj.get(v).size(), 0, cap, cost));\n            adj.get(v).add(new Edge(u, adj.get(u).size() - 1, 0, 0, -cost));\n        }\n\n        long[] minCostMaxFlow(int s, int t) {\n            long totalFlow = 0;\n            long totalCost = 0;\n\n            while (true) {\n                Arrays.fill(dist, INF);\n                dist[s] = 0;\n                flowCap[s] = INF;\n                pq.add(new Pair(0, s));\n\n                while (!pq.isEmpty()) {\n                    Pair current = pq.poll();\n                    long d = current.cost;\n                    int u = current.node;\n\n                    if (d != dist[u]) continue;\n\n                    for (int i = 0; i < adj.get(u).size(); ++i) {\n                        Edge e = adj.get(u).get(i);\n                        int v = e.to;\n\n                        if (e.cap <= e.f) continue;\n\n                        long nd = dist[u] + e.cost + pot[u] - pot[v];\n                        if (nd < dist[v]) {\n                            dist[v] = nd;\n                            pq.add(new Pair(nd, v));\n                            prevV[v] = u;\n                            prevE[v] = i;\n                            flowCap[v] = Math.min(flowCap[u], e.cap - e.f);\n                        }\n                    }\n                }\n\n                if (dist[t] == INF) break;\n\n                for (int i = 0; i < n; ++i) {\n                    pot[i] += dist[i];\n                }\n\n                long df = Math.min(flowCap[t], INF - totalFlow);\n                totalFlow += df;\n\n                for (int v = t; v != s; v = prevV[v]) {\n                    Edge e = adj.get(prevV[v]).get(prevE[v]);\n                    e.f += df;\n                    adj.get(v).get(e.rev).f -= df;\n                    totalCost += df * e.cost;\n                }\n            }\n\n            return new long[]{totalFlow, totalCost};\n        }\n    }\n\n    static class Pair {\n        long cost;\n        int node;\n\n        Pair(long cost, int node) {\n            this.cost = cost;\n            this.node = node;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        final int T = 500;\n        int N = n * T;\n        MinCostFlow solver = new MinCostFlow(N + 2);\n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < T - 1; ++j) {\n                solver.connect(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        for (int j = 0; j < T; ++j) {\n            solver.connect(j, N + 1, INF, 0);\n        }\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            --x;\n            solver.connect(N, x * T, 1, 0);\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x; --y;\n\n            for (int j = 0; j < T - 1; ++j) {\n                long mult = 1;\n                for (int p = 0; p < k; ++p) {\n                    solver.connect(x * T + j, y * T + j + 1, 1, mult * d + c);\n                    solver.connect(y * T + j, x * T + j + 1, 1, mult * d + c);\n                    mult += 2;\n                }\n            }\n        }\n\n        long[] result = solver.minCostMaxFlow(N, N + 1);\n        assert result[0] == k : \"Flow is not equal to k\";\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019500737835187465, -3.933898824470816e-06, -8.344646857949556e-07, -0.006124419625848532, -5.781483559985645e-05, -0.6326125860214233, -0.14282287657260895, -0.00043406602344475687, -4.768370445162873e-07, -0.0015518538421019912, -0.011048214510083199, -0.0005560758872888982, -0.0028490927070379257, -0.5340144634246826, -0.