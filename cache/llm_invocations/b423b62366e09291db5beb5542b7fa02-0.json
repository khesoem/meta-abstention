ong solve(long n, int t) {\n        if (t == 0) {\n            if (n == 0) return 0;\n            return MOD;\n        }\n        long cnt = n / dp[t];\n        if (n % dp[t] == 0) {\n            return t * cnt;\n        }\n        long option1 = solve(Math.abs(n - dp[t] * (cnt + 1)), t - 1) + t;\n        long option2 = solve(n - dp[t] * cnt, t - 1);\n        return cnt * t + Math.min(option1, option2);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        dp[1] = 1;\n        for (int i = 2; i < 17; i++) {\n            dp[i] = dp[i - 1] * 10 + 1;\n        }\n        long n = sc.nextLong();\n        System.out.println(solve(n, 16));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.003435538848862052, -0.0005284877843223512, -1.981667537620524e-06, -0.00011915886716451496, -1.0802738870552275e-05, -1.9361264946837764e-07, -0.00013500562636181712, -0.027093058452010155, -2.8325677703833207e-05, -5.438573680294212e-06, -3.128163257315464e-07, -0.0010621058754622936, -0.1269473135471344, -0.008224471472203732, -0.02452515996992588, -0.029798975214362144, -0.4287011921405792, -0.18527421355247498, -0.6837102770805359, -7.636475493200123e-05, -1.1472419600977446e-06, -2.057743949990254e-05, -0.1103295162320137, -0.00023691373644396663, -3.4121114822482923e-06, -4.320199877838604e-07, -0.002479104558005929, -7.3458322731312364e-06, -0.0008104594890028238, -6.659005157416686e-05, -0.1426752507686615, -0.0005326599348336458, -3.4121114822482923e-06, -7.107425062713446e-06, -0.0001589618914294988, -0.006715370807796717, -1.9361264946837764e-07, -0.003178306156769395, -0.002300131833180785, -3.8889261304575484e-06, -1.5332478142227046e-05, -0.00220687803812325, -1.9361264946837764e-07, -8.65707261255011e-06, -5.080963092041202e-06, -1.8624639324116288e-06, -4.320199877838604e-07, -2.1008713702030946e-06, -0.012515541166067123, -0.010349252261221409, -9.0883463599