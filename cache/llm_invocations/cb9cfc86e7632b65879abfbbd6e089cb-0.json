n        def __init__(self, a):\n            self.sz = 1 << 20\n            self.v = [0] * self.sz\n            for i in range(len(a)):\n                self.v[i] = a[i] % self.sz\n        \n        def FFT(self):\n            return self.DFT(0, 1, True)\n        \n        def FFT1(self):\n            x = self.DFT(0, 1, False)\n            for i in range(len(x)):\n                x[i] = x[i] * self.szinv % self.sz\n            return x\n        \n        def DFT(self, first, pow_val, straight):\n            if pow_val == self.sz:\n                return [self.v[first]]\n            \n            zero = self.DFT(first, 2 * pow_val, straight)\n            one = self.DFT(first + pow_val, 2 * pow_val, straight)\n            n = len(zero)\n            ans = [0] * (2 * n)\n            \n            for i in range(n):\n                w_val = self.warr[i * pow_val] if straight else self.winvarr[i * pow_val]\n                ans[i] = (zero[i] + w_val * one[i]) % self.sz\n            \n            for i in range(n):\n                w_val = self.warr[i * pow_val] if straight else self.winvarr[i * pow_val]\n                ans[n + i] = ((zero[i] - w_val * one[i]) % self.sz + self.sz) % self.sz\n            \n            return ans\n    \n    def fft(self, a):\n        wth = 1\n        ans = [0] * self.sz\n        for i in range(self.sz):\n            x = 1\n            for j in range(len(a)):\n                ans[i] = (ans[i] + a[j] * x) % self.mod\n                x = (x * wth) % self.mod\n            wth = (wth * self.w) % self.mod\n        return ans\n    \n    def pow_arr(self, ans, p):\n        for i in range(len(ans)):\n            ans[i] = self.pow(ans[i], p)\n        return ans\n    \n    def pow(self, x, p):\n        if p == 0:\n            return 1\n        if p % 2 == 1:\n            return (self.pow(x, p - 1) * x) % self.mod\n        y = self.pow(x, p // 2)\n        return (y * y) % self.mod\n    \n    def solve(self):\n        n = self.in_stream.nextInt()\n        k = self.in_stream.nextInt()\n        arr = [0] * 10\n        for _ in range(k):\n            arr[self.in_stream.nextInt()] = 1\n        \n        self.warr[0] = 1\n        self.winvarr[0] = 1\n        for i in range(1, len(self.warr)):\n            self.warr[i] = (self.warr[i - 1] * self.w) % self.mod\n            self.winvarr[i] = (self.winvarr[i - 1] * self.w) % self.mod\n        \n        x = self.fft(arr)\n        x = self.pow_arr(x, n // 2)\n        v = self.Vector(x)\n        x = v.FFT1()\n        ans = 0\n        for i in range(len(x)):\n            ans = (ans + x[i] * x[i]) % self.mod\n        self.out.println(ans)\n    \n    def run(self):\n        try:\n            if self.systemIO:\n                self.in_stream = FastScanner(sys.stdin)\n                self.out = sys.stdout\n            else:\n                self.in_stream = FastScanner(open(\"input.txt\", \"r\"))\n                self.out = open(\"output.txt\", \"w\")\n            self.solve()\n            if not self.systemIO:\n                self.out.close()\n        except Exception as e:\n            print(e)\n    \n    class FastScanner:\n        def __init__(self, f):\n            if isinstance(f, str):\n                self.br = open(f, \"r\")\n            else:\n                self.br = f\n            self.st = []\n        \n        def nextLine(self):\n            try:\n                return self.br.readline()\n            except Exception as e:\n                return None\n        \n        def next(self):\n            while not self.st:\n                try:\n                    line = self.br.readline()\n                    if not line:\n                        return None\n                    self.st = line.strip().split()\n                except Exception as e:\n                    print(e)\n            return self.st.pop(0)\n        \n        def nextInt(self):\n            return int(self.next())\n        \n        def nextLong(self):\n            return int(self.next())\n      