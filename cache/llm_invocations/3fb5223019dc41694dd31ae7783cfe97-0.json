 = 1;\n        best_den = 1;\n    }\n    \n    int g = gcd(best_num, best_den);\n    printf(\"%d/%d\\n\", best_num / g, best_den / g);\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static int gcd(int a, int b) {\n        a = Math.abs(a);\n        b = Math.abs(b);\n        while (b != 0) {\n            int r = a % b;\n            a = b;\n            b = r;\n        }\n        return a;\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int x = scanner.nextInt();\n        int y = scanner.nextInt();\n        int L = scanner.nextInt();\n        \n        double target = (double)x / y;\n        int best_num = 0;\n        int best_den = 1;\n        double best_err = 1e10;\n        \n        for (int d = 1; d <= L; ++d) {\n            long num_val = (long)x * d;\n            int base = (int)(num_val / y);\n            \n            for (int offset = -1; offset <= 1; ++offset) {\n                int num = base + offset;\n                if (num < 0) continue;\n                \n                double val = (double)num / d;\n                double err = Math.abs(target - val);\n                \n                if (err < best_err || (Math.abs(err - best_err) < 1e-9 && num * best_den < best_num * d)) {\n                    best_err = err;\n                    best_num = num;\n                    best_den = d;\n                }\n            }\n        }\n        \n        if (Math.abs(1.0 - target) <= best_err + 1e-9) {\n            best_num = 1;\n            best_den = 1;\n        }\n        \n        int g = gcd(best_num, best_den);\n        System.out.printf(\"%d/%d\\n\", best_num / g, best_den / g);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011359999916749075, -2.0