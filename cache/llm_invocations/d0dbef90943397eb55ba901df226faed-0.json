h_back(m-2);\n        g[to].push_back(m-1);\n    }\n    bool bellman(int s,int t,int& flow,int& cost)\n    {\n        for(int i = 0;i <= t; i++)\n            d[i] = inf,inq[i] = 0;\n        d[s] = 0;inq[s] = 1;p[s] = 0;a[s] = inf;\n        queue<int>Q;\n        Q.push(s);\n        while(!Q.empty())\n        {\n            int u = Q.front();\n\n            Q.pop();\n            inq[u] = 0;\n\n            for(int i = 0;i < g[u].size(); i++)\n            {\n                edge& ee = e[g[u][i]];\n\n                //cout<<ee.cap<<\"  \"<<ee.flow<<\"  \"<<d[ee.to]<<\"  \"<<d[u]<<\"  \"<<ee.cost<<endl;\n                if(ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost)\n                {\n                    //cout<<\"zzzz\"<<endl;\n                    d[ee.to] = d[u] + ee.cost;\n                    p[ee.to] = g[u][i];\n                    a[ee.to] = min(a[u],ee.cap - ee.flow);\n                    if(!inq[ee.to])\n                    {\n                        Q.push(ee.to);\n                        //cout<<\"in=\"<<ee.to<<endl;\n                        inq[ee.to] = 1;\n                    }\n                }\n            }\n        }\n\n        //cout<<\"hahaha\"<<endl;\n        if(d[t] == inf)\n            return false;\n        flow += a[t];\n        cost += d[t] * a[t];\n        int u = t;\n        while(u != s){\n            e[p[u]].flow += a[t];\n            e[p[u]^1].flow -= a[t];\n            u = e[p[u]].from;\n        }\n\n        return true;\n    }\n    int minCost(int s,int t)\n    {\n        int flow = 0,cost = 0;\n        while(bellman(s,t,flow,cost));\n        return cost;\n    }\n}solve;\n\n\nint main(){\n    int k,c,d;\n    cin>>n>>m>>k>>c>>d;\n\n    for(int i=1;i<=k;i++){\n        scanf(\"%d\",&a[i]);\n    }\n\n    startPoint=0,endPoint=n*100+1;\n\n    for(int i=1;i<=k;i++){\n        solve.add(startPoint,1+(a[i]-1)*100,1,0);\n    }\n\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<100;j++){\n            int p=(i-1)*100LL;\n            solve.add(p+j,p+j+1,inf,c);\n        }\n    }\n\n    for(int i=1;i<=100;i++)solve.add(i,endPoint,inf,0);\n\n    while(m--){\n        int x,y;\n        scanf(\"%d%d\",&x,&y);\n        for(int i=1;i<100;i++){\n            int p=(x-1)*100+i;\n            int pp=(y-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n        for(int i=1;i<100;i++){\n            int p=(y-1)*100+i;\n            int pp=(x-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n    }\n\n    printf(\"%d\\n\",solve.minCost(startPoint,endPoint));\n    return 0;\n\n\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport collections\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.edges = []\n        self.graph = [[] for _ in range(n + 1)]\n\n    def add_edge(self, fr, to, cap, cost):\n        self.edges.append([fr, to, cap, 0, cost])\n        self.edges.append([to, fr, 0, 0, -cost])\n        m = len(self.edges)\n        self.graph[fr].append(m - 2)\n        self.graph[to].append(m - 1)\n\n    def bellman(self, s, t, flow, cost):\n        INF = 10**18\n        d = [INF] * (t + 1)\n        inq = [0] * (t + 1)\n        p = [-1] * (t + 1)\n        a_ = [0] * (t + 1)\n        d[s] = 0\n        inq[s] = 1\n        p[s] = 0\n        a_[s] = INF\n        q = collections.deque([s])\n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for ei in self.graph[u]:\n                ee = self.edges[ei]\n                if ee[2] > ee[3] and d[ee[1]] > d[u] + ee[4]:\n                    d[ee[1]] = d[u] + ee[4]\n                    p[ee[1]] = ei\n                    a_[ee[1]] = min(a_[u], ee[2] - ee[3])\n                    if not inq[ee[1]]:\n                        q.append(ee[1])\n                        inq[ee[1]] = 1\n        if d[t] == INF:\n            return False\n        flow[0] += a_[t]\n        cost[0] += d[t] * a_[t]\n        u = t\n        while u != s:\n            ei = p[u]\n            self.edges[ei][3] += a_[t]\n            self.edges[ei ^ 1][3] -= a_[t]\n            u = self.edges[ei][0]\n        return True\n\n    def min_cost(self, s, t):\n        flow = [0]\n        cost = [0]\n        while self.bellman(s, t, flow, cost):\n            pass\n        return cost[0]\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    a = [0] + [next(it) for _ in range(k)]  # 1-indexed\n    start = 0\n    end = n * 100 + 1\n    solve = MCMF(end)\n    INF = 10**18\n\n    # start to each person's initial station at time 1\n    for i in range(1, k + 1):\n        solve.add_edge(start, 1 + (a[i] - 1) * 100, 1, 0)\n\n    # waiting edges: stay at same station for one time unit\n    for i in range(1, n + 1):\n        base = (i - 1) * 100\n        for j in range(1, 100):\n            solve.add_edge(base + j, base + j + 1, INF, c)\n\n    # edges from station 1's time nodes to sink (as in original code)\n    for t in range(1, 101):\n        solve.add_edge(t, end, INF, 0)\n\n    # move edges between stations\n    for _ in range(m):\n        x = next(it); y = next(it)\n        # from x to y\n        for i in range(1, 100):\n            p_x = (x - 1) * 100 + i\n            pp_y = (y - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d * (j * j - (j - 1) * (j - 1)) + c\n                solve.add_edge(p_x, pp_y, 1, cost)\n        # from y to x\n        for i in range(1, 100):\n            p_y = (y - 1) * 100 + i\n            pp_x = (x - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d * (j * j - (j - 1) * (j - 1)) + c\n                solve.add_edge(p_y, pp_x, 1, cost)\n\n    result = solve.min_cost(start, end)\n    print(result)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0728830375228426e-06, 0.0, 0.0, -0.0004911408759653568, -0.0004769618099089712, -1.0132738680113107e-05, -9.881961887003854e-05, -0.06196772679686546, -3.4570634852570947e-06, -0.0018461579456925392, -0.02368898317217827, -0.0005553610390052199, -1.0728830375228426e-06, 0.0, -1.0013530300057027e-05, -4.172316494077677e-06, -0.00013445904187392443, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -0.00011538793478393927, -0.00012981049076188356, -1.1920928244535389e-07, -2.586808113846928e-05, -2.8490614567999728e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.0004266782198101282, 0.0, -1.5497195136049413e-06, -0.00435748603194952, -5.960462772236497e-07, -2.3841855067985307e-07, -0.2519315481185913, 0.0, -2.9802276912960224e-06, -0.0009203489171341062, 0.0, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, -8.34461570775602e-06, -0.2519369125366211, 0.0, -6.031808152329177e-05, -0.008035475388169289, -3.576278118089249e-07, -9.536738616588991e-07, 0.0, -5.960462772236497e-07, 0.0, 0.0, -0.006358867045491934, -4.434487345861271e-05, -1.0728830375228426e-06, -1.311301275563892e-06, -6.198863957251888e-06, -1.1920922133867862e-06, -3.576278118089249e-07, -2.145764938177308e-06, -1.1920928244535389e-07, -0.0006630606367252767, 0.0, 0.0, 0.0, -1.3112935448589269e-05, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -0.0002960720448754728, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841830625315197e-06, -1.1920928244535389e-07, -8.4754210547