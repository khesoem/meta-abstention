= dp[i - 1][j ^ l] * invfact[l];\n                if (cur > LIMIT) cur %= MOD;\n            }\n            dp[i][j] = cur % MOD;\n        }\n        ans = (ans + dp[i][N] * binom((int)K, i)) % MOD;\n    }\n\n    ans = ans * fact[N] % MOD;\n    return ans;\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    std::cin >> N >> K >> MOD;\n    ull ans = power(K, N);\n    if (N & 1ULL) {\n        std::cout << ans << '\\n';\n        return 0;\n    }\n    ans = (ans - solveInner() + MOD) % MOD;\n    std::cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 0\nN = 0\nK = 0\ndp = []\nfact = []\ninvfact = []\n\ndef power(base, exp, mod):\n    res = 1\n    while exp:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef binom(a, b):\n    return (fact[a] * invfact[b] % MOD) * invfact[a - b] % MOD\n\ndef solveInner():\n    global dp, fact, invfact, MOD, N, K\n    fact[0] = 1\n    for i in range(1, N + 1):\n        fact[i] = fact[i - 1] * i % MOD\n    invfact[N] = power(fact[N], MOD - 2, MOD)\n    for i in range(N - 1, -1, -1):\n        invfact[i] = invfact[i + 1] * (i + 1) % MOD\n    for i in range(1, N + 1):\n        dp[1][i] = invfact[i]\n    ans = dp[1][N] * binom(K, 1) % MOD\n    t = 17 if 17 < K else K\n    for i in range(2, t + 1):\n        j = N\n        while j:\n            cur = 0\n            l = j\n            while l:\n                cur = (cur + dp[i - 1][j ^ l] * invfact[l]) % MOD\n                l = (l - 1) & j\n            dp[i][j] = cur % MOD\n            j = (j - 1) & N\n        ans = (ans + dp[i][N] * binom(K, i)) % MOD\n    ans = ans * fact[N] % MOD\n    return ans\n\ndef main():\n    global dp, fact, invfact, MOD, N, K\n    data = sys.stdin.read().strip().split()\