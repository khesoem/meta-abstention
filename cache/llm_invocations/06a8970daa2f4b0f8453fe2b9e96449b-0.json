{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1e9;\nconst int T = 150;\n\nstruct Edge {\n    int to, rev, cap, flow, cost;\n};\n\nvector<vector<Edge>> g;\nvector<int> pot, dist, pv, pe;\n\nvoid add_edge(int u, int v, int cap, int cost) {\n    Edge a{v, (int)g[v].size(), cap, 0, cost};\n    Edge b{u, (int)g[u].size(), 0, 0, -cost};\n    g[u].push_back(a);\n    g[v].push_back(b);\n}\n\npair<int, int> min_cost_flow(int s, int t) {\n    int n = (int)g.size();\n    pot.assign(n, 0);\n    dist.resize(n);\n    pv.resize(n);\n    pe.resize(n);\n\n    int flow = 0, flow_cost = 0;\n\n    while (true) {\n        fill(dist.begin(), dist.end(), INF);\n        dist[s] = 0;\n\n        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;\n        pq.push({0, s});\n\n        while (!pq.empty()) {\n            auto cur = pq.top();\n            pq.pop();\n            int d = cur.first;\n            int u = cur.second;\n\n            if (d != dist[u]) continue;\n\n            for (int i = 0; i < (int)g[u].size(); ++i) {\n                Edge &e = g[u][i];\n                if (e.cap - e.flow <= 0) continue;\n\n                int nd = d + e.cost + pot[u] - pot[e.to];\n                if (nd < dist[e.to]) {\n                    dist[e.to] = nd;\n                    pv[e.to] = u;\n                    pe[e.to] = i;\n                    pq.push({nd, e.to});\n                }\n            }\n        }\n\n        if (dist[t] == INF) break;\n\n        for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n        // Every augmenting path must begin with an unused capacity-1 source edge,\n        // so the bottleneck is always exactly one unit.\n        int add = 1;\n\n        flow += add;\n        for (int v = t; v != s; v = pv[v]) {\n            Edge &e = g[pv[v]][pe[v]];\n            e.flow += add;\n            g[v][e.rev].flow -= add;\n            flow_cost += add * e.cost;\n        }\n    }\n\n    return {flow, flow_cost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    g.assign(N + 2, {});\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    pair<int, int> ans = min_cost_flow(N, N + 1);\n    assert(ans.first == k);\n    cout << ans.second << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = Integer.MAX_VALUE / 2;\n    static final int T = 150;\n\n    static class Edge {\n        int to, rev, cap, flow, cost;\n        Edge(int to, int rev, int cap, int flow, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static ArrayList<ArrayList<Edge>> g;\n    static int[] pot, dist, pv, pe;\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        Edge a = new Edge(v, g.get(v).size(), cap, 0, cost);\n        Edge b = new Edge(u, g.get(u).size(), 0, 0, -cost);\n        g.get(u).add(a);\n        g.get(v).add(b);\n    }\n\n    static int[] minCostFlow(int s, int t) {\n        int n = g.size();\n        pot = new int[n];\n        dist = new int[n];\n        pv = new int[n];\n        pe = new int[n];\n\n        int flow = 0, flowCost = 0;\n\n        while (true) {\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n\n            PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n            pq.offer(new int[]{0, s});\n\n            while (!pq.isEmpty()) {\n                int[] cur = pq.poll();\n                int d = cur[0];\n                int u = cur[1];\n\n                if (d != dist[u]) continue;\n\n                for (int i = 0; i < g.get(u).size(); ++i) {\n                    Edge e = g.get(u).get(i);\n                    if (e.cap - e.flow <= 0) continue;\n\n                    int nd = d + e.cost + pot[u] - pot[e.to];\n                    if (nd < dist[e.to]) {\n                        dist[e.to] = nd;\n                        pv[e.to] = u;\n                        pe[e.to] = i;\n                        pq.offer(new int[]{nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n            int add = 1;\n            flow += add;\n            for (int v = t; v != s; v = pv[v]) {\n                Edge e = g.get(pv[v]).get(pe[v]);\n                e.flow += add;\n                g.get(v).get(e.rev).flow -= add;\n                flowCost += add * e.cost;\n            }\n        }\n\n        return new int[]{flow, flowCost};\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int N = n * T;\n        g = new ArrayList<>(N + 2);\n        for (int i = 0; i < N + 2; ++i) g.add(new ArrayList<>());\n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < T - 1; ++j) {\n                addEdge(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        for (int i = 0; i < T; ++i) {\n            addEdge(i, N + 1, INF, 0);\n        }\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt() - 1;\n            addEdge(N, x * T, 1, 0);\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int j = 0; j < T - 1; ++j) {\n                int cur = 1;\n                for (int z = 0; z < k; ++z) {\n                    addEdge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                    addEdge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        int[] ans = minCostFlow(N, N + 1);\n        // assert ans[0] == k;\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.002696055569686e-05, -1.1920928244535389e-07, 0.0, -4.72057654405944