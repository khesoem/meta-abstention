 30000;\n        static final int M = 7010010;\n        int[] h = new int[N];\n        int[] ing = new int[N];\n        int[] pre = new int[N];\n        int[] to = new int[M];\n        int[] ne = new int[M];\n        long[] cap = new long[M];\n        long[] dis = new long[N];\n        long[] cost = new long[M];\n        int e, s, t, n;\n        long flow, mincost;\n        static final long INF = Long.MAX_VALUE;\n\n        void ini(int _n) {\n            Arrays.fill(h, -1);\n            n = _n;\n            e = 0;\n        }\n\n        void liu(int u, int v, long c, long w) {\n            to[e] = v;\n            ne[e] = h[u];\n            cap[e] = c;\n            cost[e] = w;\n            h[u] = e++;\n        }\n\n        void link(int u, int v, long c, long w) {\n            liu(u, v, c, w);\n            liu(v, u, 0, -w);\n        }\n\n        boolean spfa() {\n            Arrays.fill(dis, INF);\n            Arrays.fill(ing, 0);\n            Queue<Integer> Q = new LinkedList<>();\n            Q.offer(s);\n            ing[s] = 1;\n            dis[s] = 0;\n            while (!Q.isEmpty()) {\n                int c = Q.poll();\n                ing[c] = 0;\n                for (int k = h[c]; k != -1; k = ne[k]) {\n                    if (cap[k] > 0) {\n                        int v = to[k];\n                        if (dis[c] + cost[k] < dis[v]) {\n                            dis[v] = dis[c] + cost[k];\n                            pre[v] = k;\n                            if (ing[v] == 0) {\n                                Q.offer(v);\n                                ing[v] = 1;\n                            }\n                        }\n                    }\n                }\n            }\n            return dis[t] != INF;\n        }\n\n        Pair<Long, Long> run(int _s, int _t) {\n            s = _s;\n            t = _t;\n            flow = 0;\n            mincost = 0;\n            while (spfa()) {\n                long pl = INF;\n                for (int p = t; p != s; p = to[pre[p] ^ 1]) {\n                    pl = Math.min(pl, cap[pre[p]]);\n                }\n                for (int p = t; p != s; p = to[pre[p] ^ 1]) {\n                    cap[pre[p]] -= pl;\n                    cap[pre[p] ^ 1] += pl;\n                }\n                mincost += pl * dis[t];\n                flow += pl;\n            }\n            return new Pair<>(flow, mincost);\n        }\n    }\n\n    static class Pair<U, V> {\n        public final U first;\n        public final V second;\n\n        public Pair(U first, V second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    static final long INF = Long.MAX_VALUE;\n    static int[] a = new int[55];\n    static int[][] id = new int[55][2500];\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 1; i <= k; i++) {\n            a[i] = Integer.parseInt(st.nextToken());\n        }\n\n        MCMF flow = new MCMF();\n        int totalNodes = 50 * 50 * 4 + 10;\n        flow.ini(totalNodes);\n        int s = flow.n - 2;\n        int t = flow.n - 1;\n\n        int cnt = 0;\n        int mx = 100;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= mx; j++) {\n                id[i][j] = ++cnt;\n            }\n        }\n\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            for (int j = 0; j < mx; j++) {\n                for (int h = 1; h <= k; h++) {\n                    int tmp = h * h * d - (h - 1) * (h - 1) * d;\n                    flow.link(id[u][j], id[v][j + 1], 1, c + tmp);\n                    flow.link(id[v][j], id[u][j + 1], 1, c + tmp);\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                flow.link(id[i][j], id[i][j + 1], INF, c);\n            }\n        }\n\n        for (int i = 1; i <= k; i++) {\n            flow.link(s, id[a[i]][0], 1, 0);\n        }\n\n        for (int j = 1; j <= mx; j++) {\n            flow.link(id[1][j], t, INF, 0);\n        }\n\n        Pair<Long, Long> result = flow.run(s, t);\n        System.out.println(result.second);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.1448182612657547, -7.755678961984813e-05, -1.1472419600977446e-06, -0.0002249933750135824, -9.088346359931165e-07, -1.9361264946837764e-07, -0.0008046258008107543, -0.18538276851177216, -0.09032389521598816, -0.00036953974631614983, -0.12540413439273834, -0.00038467496051453054, -0.0263079684227705, -4.320199877838604e-07, -0.005671726074069738, -0.1003878191113472, -0.019287988543510437, -0.0009595814626663923, -0.5240685343742371, -0.007497901562601328, -9.05499910004437e-05, -1.9361264946837764e-07, -0.018931392580270767, -1.9361264946837764e-07, -0.02992531657218933, -0.030781347304582596, -0.00014120421838015318, -0.07540450245141983, -0.0009193199803121388, -4.320199877838604e-07, -3.0590548703912646e-05, -1.5928495486150496e-05, -0.08594712615013123, -1.7432603272027336e-06, -3.452426608419046e-05, -8.256334695033729e-05, -0.0021853535436093807, -2.3319124011322856e-05, -1.8193366486229934e-05, -5.512236498361744e-07, -0.0029128119349479675, -3.7697225252486533e-06, -2.45848218582978e-06, -0.01683339849114418, -0.0007281593861989677, -0.0004240011621732265, -8.180258191714529e-06, -2.3438327843905427e-05, -0.001279641