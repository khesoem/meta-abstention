{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n//typedef long double ld;\n\nconst int maxn=5007;\n\n//const ll INF = 1e18;\nconst ll INF =  1e9;\nconst ll mod = 1e9+7;\n\nstruct Edge {\n    int from,to;\n    ll cap, cost, flow;\n    Edge(int from, int to, ll cap, ll cost): from(from), to(to), cap(cap), cost(cost), flow(0) {};\n};\n\nvector<Edge> edges;\nll d[maxn], phi[maxn];\nvector<int> g[maxn];\nint par[maxn];\n\nvoid add_edge(int u, int v, ll cap, ll cost) {\n    g[u].push_back(edges.size());\n    edges.push_back({u,v,cap,cost});\n    g[v].push_back(edges.size());\n    edges.push_back({v,u,0,-cost});\n}\nvoid ford_bellman(int s, int n) {\n    for (int i=0;i<maxn;i++) {\n        phi[i] = INF;\n    }\n    phi[s] = 0;\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<edges.size();j++) {\n            if (edges[j].cap==edges[j].flow) continue;\n            int from = edges[j].from;\n            int to = edges[j].to;\n            ll len = edges[j].cost;\n            if (phi[from]==INF) continue;\n            phi[to] = min(phi[to], phi[from]+len);\n        }\n    }\n}\n\nvoid dijkstra(int s) {\n    for (int i=0;i<maxn;i++) {\n        d[i] = INF;\n    }\n    d[s] = 0;\n    set<pair<ll,int>> q;\n    q.insert({0,s});\n    while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i=0;i<g[v].size();i++) {\n            int eid = g[v][i];\n            if (edges[eid].cap==edges[eid].flow) continue;\n            int to = edges[eid].to;\n            ll len = edges[eid].cost + phi[v] - phi[to];\n            if (d[v]+len<d[to]) {\n                q.erase({d[to],to});\n                d[to] = d[v]+len;\n                par[to] = eid;\n                q.insert({d[to],to});\n            }\n        }\n    }\n}\n\npair<ll,ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (1) {\n        if (d[t]==INF) break;\n        ll pushed=  INF, sum = 0;\n        for (int tmp = t;tmp!=s;) {\n//            if (tmp==100) {\n//                cout << \"xyu\";\n//            }\n            int eid = par[tmp];\n            pushed = min(pushed, edges[eid].cap-edges[eid].flow);\n            sum+=edges[eid].cost;\n            tmp = edges[eid].from;\n        }\n        flow+=pushed;\n        cost+=pushed*sum;\n        //cout << \"flow: \" << flow << \", cost: \" << cost << endl <<  t << \" \";\n        for (int tmp=t;tmp!=s;) {\n            int eid = par[tmp];\n            edges[eid].flow+=pushed;\n            edges[eid^1].flow-=pushed;\n            tmp = edges[eid].from;\n          //  cout << tmp << \" \";\n        }\n        //cout << endl;\n\n        dijkstra(s);\n        for (int i=0;i<maxn;i++) {\n            phi[i] = d[i];\n        }\n    }\n    return {cost, flow};\n}\nvoid solve() {\n    int n,m,k,c,d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnts(n,0);\n    for (int i=0;i<k;i++) {\n        int ai;\n        cin >> ai;\n        ai--;\n        cnts[ai]++;\n    }\n    for (int i=0;i<n;i++) {\n        add_edge(5000, i, cnts[i],0);\n    }\n    for (int it=0;it<m;it++) {\n        int u,v;\n        cin >> u >> v;\n        u--; v--;\n        for (int i=0;i<99;i++) {\n            ll cost = d;\n            for (int j=0;j<50;j++) {\n                add_edge(u+i*50, v+(i+1)*50, 1, cost);\n                add_edge(v+i*50, u+(i+1)*50, 1, cost);\n                cost+=2*d;\n            }\n        }\n    }\n    for (int i=0;i<=99;i++) {\n        add_edge(0+i*50, 5001, INF, c*i);\n    }\n\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<99;j++) {\n            add_edge(i+j*50, i+(j+1)*50, INF, 0);\n        }\n    }\n    //add_edge(0+99*50, 5001, INF, 0);\n\n    auto p = mincost_maxflow(5000, 5001);\n    assert(p.second==k);\n    cout << p.first;\n}\nint main() {\n    cin.tie(0);\n    cout.tie(0);\n    ios_base::sync_with_stdio(false);\n    cout << setprecision(20) << fixed;\n   // freopen(\"input.txt\",\"r\", stdin);\n//    int t;\n//    cin >> t;\n//    for (int i=0;i<t;i++)\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\nfrom collections import defaultdict\n\nsys.setrecursionlimit(10000)\n\nmaxn = 5007\nINF = 10**9\nmod = 10**9 + 7\n\nclass Edge:\n    def __init__(self, from_node, to_node, cap, cost):\n        self.from_node = from_node\n        self.to_node = to_node\n        self.cap = cap\n        self.cost = cost\n        self.flow = 0\n\nedges = []\nd = [INF] * maxn\nphi = [INF] * maxn\npar = [-1] * maxn\ng = [[] for _ in range(maxn)]\n\ndef add_edge(u, v, cap, cost):\n    g[u].append(len(edges))\n    edges.append(Edge(u, v, cap, cost))\n    g[v].append(len(edges))\n    edges.append(Edge(v, u, 0, -cost))\n\ndef ford_bellman(s, n):\n    for i in range(maxn):\n        phi[i] = INF\n    phi[s] = 0\n    for _ in range(n):\n        for j in range(len(edges)):\n            if edges[j].cap == edges[j].flow:\n                continue\n            from_node = edges[j].from_node\n            to_node = edges[j].to_node\n            length = edges[j].cost\n            if phi[from_node] == INF:\n                continue\n            if phi[to_node] > phi[from_node] + length:\n                phi[to_node] = phi[from_node] + length\n\ndef dijkstra(s):\n    for i in range(maxn):\n        d[i] = INF\n    d[s] = 0\n    heap = [(0, s)]\n    while heap:\n        dist, v = heapq.heappop(heap)\n        if dist != d[v]:\n            continue\n        for i in range(len(g[v])):\n            eid = g[v][i]\n            if edges[eid].cap == edges[eid].flow:\n                continue\n            to_node = edges[eid].to_node\n            length = edges[eid].cost + phi[v] - phi[to_node]\n            if d[v] + length < d[to_node]:\n                d[to_node] = d[v] + length\n                par[to_node] = eid\n                heapq.heappush(heap, (d[to_node], to_node))\n\ndef mincost_maxflow(s, t):\n    ford_bellman(s, 50)\n    dijkstra(s)\n    flow = 0\n    cost = 0\n    while True:\n        if d[t] == INF:\n            break\n        pushed = INF\n        tmp = t\n        sum_cost = 0\n        while tmp != s:\n            eid = par[tmp]\n            pushed = min(pushed, edges[eid].cap - edges[eid].flow)\n            sum_cost += edges[eid].cost\n            tmp = edges[eid].from_node\n        flow += pushed\n        cost += pushed * sum_cost\n        tmp = t\n        while tmp != s:\n            eid = par[tmp]\n            edges[eid].flow += pushed\n            edges[eid ^ 1].flow -= pushed\n            tmp = edges[eid].from_node\n        dijkstra(s)\n        for i in range(maxn):\n            phi[i] = d[i]\n    return (cost, flow)\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d_val = int(input_data[idx]); idx += 1\n    \n    cnts = [0] * n\n    for _ in range(k):\n        ai = int(input_data[idx]); idx += 1\n        ai -= 1\n        cnts[ai] += 1\n    \n    # Reset global structures\n    global edges, d, phi, par, g\n    edges = []\n    d = [INF] * maxn\n    phi = [INF] * maxn\n    par = [-1] * maxn\n    g = [[] for _ in range(maxn)]\n    \n    for i in range(n):\n        add_edge(5000, i, cnts[i], 0)\n    \n    for _ in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        u -= 1\n        v -= 1\n        for i in range(99):\n            cost = d_val\n            for j in range(50):\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cost)\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost)\n                cost += 2 * d_val\n    \n    for i in range(100):\n        add_edge(0 + i * 50, 5001, INF, c * i)\n    \n    for i in range(n):\n        for j in range(99):\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n    \n    p = mincost_maxflow(5000, 5001)\n    assert p[1] == k\n    print(p[0])\n\ndef main():\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022492263815365732, -1.9073468138230965e-06, -3.576278118089249e-07, -0.00014077626110520214, -0.11307874321937561, -1.1920922133867862e-06, -0.00977538712322712, -0.018805544823408127, -0.252091646194458, -0.013164744712412357, -0.0010553987231105566, -7.152555099310121e-07, -0.0007114263135008514, -0.009713409468531609, -0.37308427691459656, -0.00018010901112575084, -0.0001461399078834802, -1.847726889536716e-05, -1.847726889536716e-05, -2.3841855067985307e-07, -0.00014256415306590497, -0.00014661667228210717, -0.0032680220901966095, 0.0, -7.152555099310121e-07, -0.2520520091056824, -0.3242996335029602, -1.1920922133867862e-06, -1.2755313036905136e-05, -2.0265558760002023e-06, -3.707340147229843e-05, -2.3841855067985307e-07, -0.004747547209262848, -3.6954811548639555e-