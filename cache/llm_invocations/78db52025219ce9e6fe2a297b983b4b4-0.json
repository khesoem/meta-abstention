{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_N = 5500;\nconst int MAX_M = 35500;\nconst int INF = 0x3B9ACA00;\n\nstruct Edge { int next, target, capacity, cost; };\nvector<Edge> edgeList(MAX_M+5);\nvector<int> adjacencyList(MAX_N+5);\nint edgeCounter = 1;\n\nvoid insertEdge(int source, int dest, int cap, int cost) {\n    edgeList[++edgeCounter] = {adjacencyList[source], dest, cap, cost};\n    adjacencyList[source] = edgeCounter;\n    edgeList[++edgeCounter] = {adjacencyList[dest], source, 0, -cost};\n    adjacencyList[dest] = edgeCounter;\n}\n\nint src, dst, prevNode[MAX_N], edgeUsed[MAX_N], minFlow[MAX_N], distNode[MAX_N];\nbool inBfs[MAX_N];\nqueue<int> bfsQueue;\n\nint spfa() {\n    fill(distNode+1, distNode+dst+1, INF);\n    fill(minFlow+1, minFlow+dst+1, 0);\n    minFlow[src] = INF;\n    distNode[src] = 0;\n    bfsQueue.push(src);\n    inBfs[src] = true;\n\n    while (!bfsQueue.empty()) {\n        int cur = bfsQueue.front();\n        inBfs[cur] = false;\n        bfsQueue.pop();\n\n        for (int idx = adjacencyList[cur]; idx; idx = edgeList[idx].next) {\n            if (edgeList[idx].capacity && distNode[edgeList[idx].target] > distNode[cur] + edgeList[idx].cost) {\n                distNode[edgeList[idx].target] = distNode[cur] + edgeList[idx].cost;\n                minFlow[edgeList[idx].target] = min(minFlow[cur], edgeList[idx].capacity);\n                edgeUsed[edgeList[idx].target] = idx;\n                prevNode[edgeList[idx].target] = cur;\n                if (!inBfs[edgeList[idx].target]) {\n                    inBfs[edgeList[idx].target] = true;\n                    bfsQueue.push(edgeList[idx].target);\n                }\n            }\n        }\n    }\n    return minFlow[dst];\n}\n\nint N, M, K, COST_BASE, COST_DIST, plan[105][105], state[105][105];\nstruct Path { int start, end; } paths[105];\n\n#define NODE_ID(r,c) ((r)*N+(c))\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N >> M >> K >> COST_BASE >> COST_DIST;\n\n    src = NODE_ID(N+K, N) + 1;\n    dst = src + 2;\n\n    insertEdge(NODE_ID(0,1), dst, INF, 0);\n\n    for (int i=1, tmp; i<=K; ++i) {\n        cin >> tmp;\n        insertEdge(src, NODE_ID(0,tmp), 1, 0);\n    }\n\n    for (int i=1; i<=M; ++i) {\n        cin >> paths[i*2].start >> paths[i*2].end;\n        paths[i*2-1] = {paths[i*2].end, paths[i*2].start};\n    }\n    M *= 2;\n\n    for (int day=1; day<=N+K; ++day) {\n        for (int j=1; j<=N; ++j)\n            insertEdge(NODE_ID(day-1,j), NODE_ID(day,j), INF, 0);\n        for (int j=1; j<=M; ++j) {\n            insertEdge(NODE_ID(day-1, paths[j].start), NODE_ID(day, paths[j].end), 1, COST_DIST);\n            plan[day][j] = edgeCounter;\n            state[day][j] = 1;\n        }\n        insertEdge(NODE_ID(day,1), dst, INF, day*COST_BASE);\n    }\n\n    int augmentVal, ans=0;\n    while (augmentVal = spfa()) {\n        int node = dst;\n        while (node != src) {\n            int prev = prevNode[node];\n            edgeList[edgeUsed[node]].capacity -= augmentVal;\n            edgeList[edgeUsed[node]^1].capacity += augmentVal;\n            node = prev;\n        }\n        ans += distNode[dst] * augmentVal;\n\n        for (int day=1; day<=N+N; ++day)\n            for (int j=1; j<=M; ++j)\n                if (edgeList[plan[day][j]].capacity) {\n                    state[day][j]++;\n                    insertEdge(NODE_ID(day-1, paths[j].start), NODE_ID(day, paths[j].end), 1, COST_DIST*(state[day][j]*2-1));\n                    plan[day][j] = edgeCounter;\n                }\n    }\n\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    K = int(data[idx]); idx += 1\n    COST_BASE = int(data[idx]); idx += 1\n    COST_DIST = int(data[idx]); idx += 1\n    \n    MAX_N = 5500\n    MAX_M = 35500\n    INF = 0x3B9ACA00\n    \n    class Edge:\n        __slots__ = ('next', 'target', 'capacity', 'cost')\n        def __init__(self, next, target, capacity, cost):\n            self.next = next\n            self.target = target\n            self.capacity = capacity\n            self.cost = cost\n    \n    edgeList = [None] * (MAX_M + 5)\n    adjacencyList = [0] * (MAX_N + 5)\n    edgeCounter = [1]  # Using list to allow modification in nested function\n    \n    def insertEdge(source, dest, cap, cost):\n        edgeCounter[0] += 1\n        edgeList[edgeCounter[0]] = Edge(adjacencyList[source], dest, cap, cost)\n        adjacencyList[source] = edgeCounter[0]\n        \n        edgeCounter[0] += 1\n        edgeList[edgeCounter[0]] = Edge(adjacencyList[dest], source, 0, -cost)\n        adjacencyList[dest] = edgeCounter[0]\n    \n    def NODE_ID(r, c):\n        return r * N + c\n    \n    src = NODE_ID(N + K, N) + 1\n    dst = src + 2\n    \n    insertEdge(NODE_ID(0, 1), dst, INF, 0)\n    \n    for i in range(1, K + 1):\n        tmp = int(data[idx]); idx += 1\n        insertEdge(src, NODE_ID(0, tmp), 1, 0)\n    \n    paths = [None] * (M * 2 + 1)\n    for i in range(1, M + 1):\n        start = int(data[idx]); idx += 1\n        end = int(data[idx]); idx += 1\n        paths[i * 2] = {'start': end, 'end': start}\n        paths[i * 2 - 1] = {'start': start, 'end': end}\n    M *= 2\n    \n    plan = [[0] * (M + 1) for _ in range(N + K + 1)]\n    state = [[0] * (M + 1) for _ in range(N + K + 1)]\n    \n    for day in range(1, N + K + 1):\n        for j in range(1, N + 1):\n            insertEdge(NODE_ID(day - 1, j), NODE_ID(day, j), INF, 0)\n        for j in range(1, M + 1):\n            insertEdge(NODE_ID(day - 1, paths[j]['start']), NODE_ID(day, paths[j]['end']), 1, COST_DIST)\n            plan[day][j] = edgeCounter[0]\n            state[day][j] = 1\n        insertEdge(NODE_ID(day, 1), dst, INF, day * COST_BASE)\n    \n    prevNode = [0] * (MAX_N + 5)\n    edgeUsed = [0] * (MAX_N + 5)\n    minFlow = [0] * (MAX_N + 5)\n    distNode = [0] * (MAX_N + 5)\n    inBfs = [False] * (MAX_N + 5)\n    \n    def spfa():\n        for i in range(1, dst + 1):\n            distNode[i] = INF\n            minFlow[i] = 0\n        minFlow[src] = INF\n        distNode[src] = 0\n        queue = deque()\n        queue.append(src)\n        inBfs[src] = True\n        \n        while queue:\n            cur = queue.popleft()\n            inBfs[cur] = False\n            \n            node_idx = adjacencyList[cur]\n            while node_idx:\n                e = edgeList[node_idx]\n                if e.capacity > 0 and distNode[e.target] > distNode[cur] + e.cost:\n                    distNode[e.target] = distNode[cur] + e.cost\n                    minFlow[e.target] = min(minFlow[cur], e.capacity)\n                    edgeUsed[e.target] = node_idx\n                    prevNode[e.target] = cur\n                    if not inBfs[e.target]:\n                        inBfs[e.target] = True\n                        queue.append(e.target)\n                node_idx = e.next\n        \n        return minFlow[dst]\n    \n    ans = 0\n    while True:\n        augmentVal = spfa()\n        if augmentVal == 0:\n            break\n        \n        node = dst\n        while node != src:\n            prev = prevNode[node]\n            used_edge = edgeUsed[node]\n            edgeList[used_edge].capacity -= augmentVal\n            edgeList[used_edge ^ 1].capacity += augmentVal\n            node = prev\n        \n        ans += distNode[dst] * augmentVal\n        \n        for day in range(1, N + N + 1):\n            for j in range(1, M + 1):\n                if edgeList[plan[day][j]].capacity > 0:\n                    state[day][j] += 1\n                    insertEdge(NODE_ID(day - 1, paths[j]['start']), NODE_ID(day, paths[j]['end']), 1, COST_DIST * (state[day][j] * 2 - 1))\n                    plan[day][j] = edgeCounter[0]\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00011836781777674332, -8.344646857949556e-07, -3.576278118089249e-07, -0.016421522945165634, -0.009052307344973087, -3.576278118089249e-07, -4.827859811484814e-05, -0.00024351492174901068, -3.2186455882765586e-06, -0.0013297295663505793, -0.0003859252028632909, -0.4453077018260956, -0.03523712232708931, -8.344646857949556e-07, -3.099436753473128e-06, -0.01673293672502041, -0.010536989197134972, -9.059865078597795e-06, -9.298280929215252e-06, -0.7230110168457031, -0.0028041587211191654, -2.264974000354414e-06, -0.0008772339206188917, 0.0, -0.02330181747674942, -3.576278118089249e-07, -0.000717025191988796, -0.0010826685465872288, -0.22541815042495728, -1.311301275563892e-06, -0.6620873212814331, -0.0003983181086368859, -1.1920928244535389e-07, -9.536738616588991e-07, -2.3483953555114567e-05, -5.245195097813848e-06, -1.0847986231965479e-05, -1.91925118997460