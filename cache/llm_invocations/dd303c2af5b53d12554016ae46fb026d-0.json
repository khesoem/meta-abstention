dc++.h>\nusing namespace std;\n\nvoid gen(int start, int end, int cur, int m, vector<int>& a, vector<int>& out) {\n    if (start == end) {\n        out.push_back(cur);\n        return;\n    }\n    gen(start + 1, end, (cur + a[start]) % m, m, a, out);\n    gen(start + 1, end, cur, m, a, out);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n    vector<int> a(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> a[i];\n    }\n\n    int mid = n / 2;\n    vector<int> left, right;\n    gen(0, mid, 0, m, a, left);\n    gen(mid, n, 0, m, a, right);\n\n    // Remove duplicates and sort left\n    sort(left.begin(), left.end());\n    left.erase(unique(left.begin(), left.end()), left.end());\n\n    int ans = 0;\n    for (int val : right) {\n        int target = m - val;\n        int lo = 0, hi = (int)left.size() - 1;\n        int best = -1;\n        while (lo <= hi) {\n            int mid_idx = (lo + hi) / 2;\n            if (left[mid_idx] < target) {\n                best = mid_idx;\n                lo = mid_idx + 1;\n            } else {\n                hi = mid_idx - 1;\n            }\n        }\n        if (best != -1) {\n            int cand = left[best] + val;\n            if (cand > ans) {\n                ans = cand;\n            }\n        }\n    }\n    cout << ans << \"\\n\";\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-6.079655122448457e-06, -1.1920928244535389e-07, 0.0, -0.00036352223833091557, -0.0009319015080109239, -1.3351351299206726e-05, -0.5762572884559631, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, -0.0003666205739136785, -1.3708974620385561e-05, -1.7881377516459906e-06, 0.0, -3.135155202471651e-05, -0.23744744062423706, -0.0002636561985127628, -0.00014244495832826942, -8.940656698541716e-06, 0.0, 0.0, -5.960462772236497e-07, -5.960462772236497e-07, -0.005374743603169918, -5.972207145532593e-05, -1.9073468138230965e-06, -0.21571032702