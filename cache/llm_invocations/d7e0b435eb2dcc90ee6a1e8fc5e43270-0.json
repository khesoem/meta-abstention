{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <climits>\n#include <cstdio>\n#include <algorithm>\nusing namespace std;\n\nconst int INF = 1000000000;\n\nstruct Link {\n    int dest;\n    int maxFlow;\n    int unitCost;\n    int usedFlow;\n    size_t reverseLink;\n};\n\nvoid connectNodes(vector<vector<Link>>& adjList, int u, int v, int cap, int cost) {\n    adjList[u].emplace_back(Link{v, cap, cost, 0, adjList[v].size()});\n    adjList[v].emplace_back(Link{u, 0, -cost, 0, adjList[u].size() - 1});\n}\n\nint main() {\n    int N, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &N, &m, &k, &c, &d);\n    int totalNodes = N * 101 + 2;\n    vector<vector<Link>> graph(totalNodes);\n    \n    for (int i = 0; i < k; i++) {\n        int x;\n        scanf(\"%d\", &x);\n        x--;\n        connectNodes(graph, totalNodes - 2, x * 101, 1, 0);\n    }\n    \n    for (int i = 0; i < 101; i++) {\n        connectNodes(graph, i, totalNodes - 1, INF, i * c);\n    }\n    \n    for (int i = 1; i < N; i++) {\n        for (int j = 0; j < 100; j++) {\n            connectNodes(graph, i * 101 + j, i * 101 + j + 1, INF, 0);\n        }\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        u--; v--;\n        for (int j = 0; j < 100; j++) {\n            for (int K = 1; K <= k; K++) {\n                int cost = d * (K * K - (K - 1) * (K - 1));\n                connectNodes(graph, u * 101 + j, v * 101 + j + 1, 1, cost);\n                connectNodes(graph, v * 101 + j, u * 101 + j + 1, 1, cost);\n            }\n        }\n    }\n    \n    int source = totalNodes - 2;\n    int sink = totalNodes - 1;\n    int flow = 0, cost = 0;\n    \n    while (flow < k) {\n        vector<int> dist(totalNodes, INF);\n        vector<int> prevNode(totalNodes, -1);\n        vector<size_t> prevEdge(totalNodes);\n        vector<bool> inQ(totalNodes, false);\n        queue<int> q;\n        \n        dist[source] = 0;\n        q.push(source);\n        inQ[source] = true;\n        \n        while (!q.empty()) {\n            int node = q.front();\n            q.pop();\n            inQ[node] = false;\n            \n            for (size_t i = 0; i < graph[node].size(); i++) {\n                Link& edge = graph[node][i];\n                if (edge.usedFlow < edge.maxFlow && dist[node] + edge.unitCost < dist[edge.dest]) {\n                    dist[edge.dest] = dist[node] + edge.unitCost;\n                    prevNode[edge.dest] = node;\n                    prevEdge[edge.dest] = i;\n                    if (!inQ[edge.dest]) {\n                        q.push(edge.dest);\n                        inQ[edge.dest] = true;\n                    }\n                }\n            }\n        }\n        \n        if (dist[sink] == INF) break;\n        \n        int delta = k - flow;\n        for (int v = sink; v != source; v = prevNode[v]) {\n            int u = prevNode[v];\n            size_t idx = prevEdge[v];\n            delta = min(delta, graph[u][idx].maxFlow - graph[u][idx].usedFlow);\n        }\n        \n        for (int v = sink; v != source; v = prevNode[v]) {\n            int u = prevNode[v];\n            size_t idx = prevEdge[v];\n            size_t rev = graph[u][idx].reverseLink;\n            graph[u][idx].usedFlow += delta;\n            graph[v][rev].usedFlow -= delta;\n            cost += graph[u][idx].unitCost * delta;\n        }\n        \n        flow += delta;\n    }\n    \n    printf(\"%d\\n\", cost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1000000000\n\nclass Link:\n    __slots__ = ('dest', 'maxFlow', 'unitCost', 'usedFlow', 'reverseLink')\n    def __init__(self, dest, maxFlow, unitCost, usedFlow, reverseLink):\n        self.dest = dest\n        self.maxFlow = maxFlow\n        self.unitCost = unitCost\n        self.usedFlow = usedFlow\n        self.reverseLink = reverseLink\n\ndef connectNodes(adjList, u, v, cap, cost):\n    adjList[u].append(Link(v, cap, cost, 0, len(adjList[v])))\n    adjList[v].append(Link(u, 0, -cost, 0, len(adjList[u]) - 1))\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    N = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    totalNodes = N * 101 + 2\n    graph = [[] for _ in range(totalNodes)]\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        connectNodes(graph, totalNodes - 2, x * 101, 1, 0)\n    \n    for i in range(101):\n        connectNodes(graph, i, totalNodes - 1, INF, i * c)\n    \n    for i in range(1, N):\n        for j in range(100):\n            connectNodes(graph, i * 101 + j, i * 101 + j + 1, INF, 0)\n    \n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(100):\n            for K in range(1, k + 1):\n                cost = d * (K * K - (K - 1) * (K - 1))\n                connectNodes(graph, u * 101 + j, v * 101 + j + 1, 1, cost)\n                connectNodes(graph, v * 101 + j, u * 101 + j + 1, 1, cost)\n    \n    source = totalNodes - 2\n    sink = totalNodes - 1\n    flow = 0\n    total_cost = 0\n    \n    while flow < k:\n        dist = [INF] * totalNodes\n        prevNode = [-1] * totalNodes\n        prevEdge = [0] * totalNodes\n        inQ = [False] * totalNodes\n        q = deque()\n        \n        dist[source] = 0\n        q.append(source)\n        inQ[source] = True\n        \n        while q:\n            node = q.popleft()\n            inQ[node] = False\n            \n            for i, edge in enumerate(graph[node]):\n                if edge.usedFlow < edge.maxFlow and dist[node] + edge.unitCost < dist[edge.dest]:\n                    dist[edge.dest] = dist[node] + edge.unitCost\n                    prevNode[edge.dest] = node\n                    prevEdge[edge.dest] = i\n                    if not inQ[edge.dest]:\n                        q.append(edge.dest)\n                        inQ[edge.dest] = True\n        \n        if dist[sink] == INF:\n            break\n        \n        delta = k - flow\n        v = sink\n        while v != source:\n            u = prevNode[v]\n            idx = prevEdge[v]\n            delta = min(delta, graph[u][idx].maxFlow - graph[u][idx].usedFlow)\n            v = u\n        \n        v = sink\n        while v != source:\n            u = prevNode[v]\n            idx = prevEdge[v]\n            rev = graph[u][idx].reverseLink\n            graph[u][idx].usedFlow += delta\n            graph[v][rev].usedFlow -= delta\n            total_cost += graph[u][idx].unitCost * delta\n            v = u\n        \n        flow += delta\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010013079008786008, -7.152555099310121e-07, 0.0, -0.0003079893649555743, -0.005621220916509628, -2.6