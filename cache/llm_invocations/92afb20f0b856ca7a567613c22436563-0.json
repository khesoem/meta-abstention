elf.rev = rev\n\n    def __init__(self, V, s, t):\n        self.adj = [[] for _ in range(V)]\n        self.lev = [-1] * V\n        self.edge_tried = [0] * V\n        self.st = s\n        self.ed = t\n\n    def setEdge(self, u, v, fl):\n        sz1 = len(self.adj[v])\n        sz2 = len(self.adj[u])\n        self.adj[u].append(self.Node(v, fl, sz1))\n        self.adj[v].append(self.Node(u, 0, sz2))\n\n    def assign_level(self):\n        for i in range(len(self.lev)):\n            self.lev[i] = -1\n        self.lev[self.st] = 0\n        queue = deque([self.st])\n        while queue:\n            now = queue.popleft()\n            for node in self.adj[now]:\n                nxt = node.v\n                if self.lev[nxt] == -1 and node.w != 0:\n                    self.lev[nxt] = self.lev[now] + 1\n                    queue.append(nxt)\n        return self.lev[self.ed] != -1\n\n    def dfs(self, now, fl):\n        if now == self.ed:\n            return fl\n        for i in range(self.edge_tried[now], len(self.adj[now])):\n            node = self.adj[now][i]\n            nxt = node.v\n            if self.lev[nxt] == self.lev[now] + 1 and node.w != 0:\n                nxtflow = self.dfs(nxt, min(fl, node.w))\n                if nxtflow:\n                    node.w -= nxtflow\n                    self.adj[nxt][node.rev].w += nxtflow\n                    return nxtflow\n            self.edge_tried[now] += 1\n        return 0\n\n    def dinic(self):\n        ret = 0\n        while self.assign_level():\n            for i in range(len(self.edge_tried)):\n                self.edge_tried[i] = 0\n            while True:\n                amt = self.dfs(self.st, 2_000_000_000)\n                if amt == 0:\n                    break\n                ret += amt\n        return ret\n\nn, ti = map(int, sys.stdin.readline().split())\nstr_list = [sys.stdin.readline().strip() for _ in range(n)]\nes = [sys.stdin.readline().strip() for _ in range(n)]\nck = [[0]*15 for _ in range(15)]\ntabl