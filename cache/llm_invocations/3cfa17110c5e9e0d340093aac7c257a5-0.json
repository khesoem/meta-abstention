>();\n        for (int i = 1; i <= Math.sqrt(n); i++) {\n            if (n % i == 0) {\n                factorsSet.add(i);\n                factorsSet.add(n / i);\n            }\n        }\n        List<Integer> list = new ArrayList<>(factorsSet);\n        Collections.sort(list);\n        return list.stream().mapToInt(i -> i).toArray();\n    }\n\n    static int invMod(int n) {\n        return pow(n, MOD - 2);\n    }\n\n    static int pow(int base, int exp) {\n        int result = 1;\n        int cur = base % MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (int) ((long) result * cur % MOD);\n            }\n            cur = (int) ((long) cur * cur % MOD);\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    static int maximum(int[] first, int[] second) {\n        return Math.min(first[0], second[1]) + Math.min(first[1], second[2]) + Math.min(first[2], second[0]);\n    }\n\n    static int match(int a, int b) {\n        if (a == b) return 0;\n        if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1))\n            return 1;\n        else\n            return -1;\n    }\n\n    static int give(List<int[]> l1, List<int[]> l2) {\n        int ans = 0;\n        Deque<int[]> stack1 = new ArrayDeque<>(l1);\n        Deque<int[]> stack2 = new ArrayDeque<>(l2);\n        int[] curr1 = null, curr2 = null;\n\n        while (!stack1.isEmpty() || !stack2.isEmpty()) {\n            try {\n                if (curr1 == null) {\n                    curr1 = stack1.pollLast();\n                }\n                if (curr2 == null) {\n                    curr2 = stack2.pollLast();\n                }\n            } catch (NoSuchElementException e) {\n                break;\n            }\n\n            int minVal = Math.min(curr1[0], curr2[0]);\n            int score = max(0, minVal * match(curr1[1], curr2[1]));\n            ans += score;\n\n            if (curr1[0] < curr2[0]) {\n                curr2[0] -= curr1[0];\n                curr1 = null;\n            } else if (curr1[0] > curr2[0]) {\n                curr1[0] -= curr2[0];\n                curr2 = null;\n            } else {\n                curr1 = null;\n                curr2 = null;\n            }\n        }\n        return ans;\n    }\n\n    static int minimum(int n, int[] first, int[] second) {\n        List<int[]> l1 = new ArrayList<>();\n        List<int[]> l2 = new ArrayList<>();\n        int[][] options1 = {\n            {first[0], 1},\n            {first[1], 2},\n            {first[2], 3}\n        };\n        int[][] options2 = {\n            {second[0], 1},\n            {second[1], 2},\n            {second[2], 3}\n        };\n\n        List<List<int[]>> permutations1 = permute(options1);\n        List<List<int[]>> permutations2 = permute(options2);\n\n        int ans = Integer.MAX_VALUE;\n        for (List<int[]> perm1 : permutations1) {\n            for (List<int[]> perm2 : permutations2) {\n                List<int[]> copyPerm1 = deepCopy(perm1);\n                List<int[]> copyPerm2 = deepCopy(perm2);\n                ans = Math.min(ans, give(copyPerm1, copyPerm2));\n            }\n        }\n        return ans;\n    }\n\n    static List<List<int[]>> permute(int[][] array) {\n        List<List<int[]>> results = new ArrayList<>();\n        permuteHelper(array, 0, results);\n        return results;\n    }\n\n    static void permuteHelper(int[][] array, int index, List<List<int[]>> results) {\n        if (index == array.length) {\n            List<int[]> list = new ArrayList<>();\n            for (int[] item : array) {\n                list.add(item.clone());\n            }\n            results.add(list);\n            return;\n        }\n        for (int i = index; i < array.length; i++) {\n            swap(array, i, index);\n            permuteHelper(array, index + 1, results);\n            swap(array, i, index);\n        }\n    }\n\n    static void swap(int[][] array, int i, int j) {\n        int[] temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n\n    static List<int[]> deepCopy(List<int[]> list) {\n        return list.stream().map(arr -> arr.clone()).collect(Collectors.toList());\n    }\n\n    static int max(int a, int b) {\n        return Math.max(a, b);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0040956162847578526, -2.7491250875755213e-05, -2.1008713702030946e-06, -4.0484450437361374e-05, -2.816093228830141e-06, -3.128163257315464e-07, -0.004620710853487253, -0.002103744773194194, -0.0005598236457444727, -0.00023178798437584192, -0.6347989439964294, -0.0029547621961683035, -0.6211697459220886, -0.3869979679584503, -1.5213274309644476e-05, -3.128163257315464e-07, -0.0015596162993460894, -0.07891589403152466, -0.00212861062027514, -0.0028003640472888947, -0.20221425592899323, -0.22541318833827972, -0.23964399099349976, -1.0445127372804563e-05, 0.0, 0.0, -1.9146995327901095e-05, -6.869017852295656e-06, -0.10034404695034027, -4.008129963040119e-06, -0.14748477935791016, -1.9361264946837764e-07, -0.00987980142235756, 0.0, -1.4617256056226324e-05, -2.339278580620885e-06, -6.704273118884885e-07, -0.00020497082732617855, -6.074907287256792e-05, -3.128163257315464e-07, -1.2664456789934775e-06, -0.12716169655323029, -2.3557529857498594e-05, -1.9361264946837764e-07, 0.0, 0.0, -1.9361264946837764e-07, -0.4288961589336395, -0.023384422063827515, -0.0010541265364736319, -3.7697225252486533e-06, -1.3856492842023727e-06, -0.00022713904036208987, -0.0002682496269699186, -5.512236498361744e-07, -0.2822715640068054, -0.000182921823579818, -0.004690591711550951, -0.016110381111502647, -0.36612483859062195, -0.5039034485816956, -0.021290097385644913, -3.128163257315464e-07, -0.013225173577666283, -1.9361264946837764e-07, -0.02570083737373352, -1.0280383548888494e-06, -0.6354052424430847, 0.0, -9.253090865968261e-06, -2.935296834039036e-06, -9.088346359931165e-07, 0.0, -2.816093228830141e-06, -1.9361264