, dst, adj.get(dst).size(), 0, cap, cost));\n            if (src == dst) {\n                adj.get(src).get(adj.get(src).size() - 1).rev++;\n            }\n            adj.get(dst).add(new Edge(dst, src, adj.get(src).size() - 1, 0, 0, -cost));\n        }\n\n        long rcost(Edge e) {\n            return e.cost + potential[e.src] - potential[e.dst];\n        }\n\n        long dijkstra(int source, int sink) {\n            Arrays.fill(dist, oo);\n            PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n            dist[source] = 0;\n            pq.offer(new long[]{0, source});\n\n            while (!pq.isEmpty()) {\n                long[] p = pq.poll();\n                if (dist[(int) p[1]] < p[0]) continue;\n                if ((int) p[1] == sink) break;\n                for (Edge e : adj.get((int) p[1])) {\n                    if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e)) {\n                        back[e.dst] = e;\n                        dist[e.dst] = dist[e.src] + rcost(e);\n                        pq.offer(new long[]{dist[e.dst], e.dst});\n                    }\n                }\n            }\n            return dist[sink];\n        }\n\n        long[] maxFlow(int source, int sink) {\n            long flow = 0;\n            long cost = 0;\n\n            for (int u = 0; u < n; u++) {\n                for (Edge e : adj.get(u)) {\n                    e.flow = 0;\n                }\n            }\n\n            Arrays.fill(potential, 0);\n            Arrays.fill(dist, oo);\n            Arrays.fill(back, null);\n\n            while (dijkstra(source, sink) < oo) {\n                for (int u = 0; u < n; u++) {\n                    if (dist[u] < dist[sink]) {\n                        potential[u] += dist[u] - dist[sink];\n                    }\n                }\n\n                long f = Long.MAX_VALUE;\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    f = Math.min(f, e.cap - e.flow);\n                }\n\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    e.flow += f;\n                    adj.get(e.dst).get(e.rev).flow -= f;\n                }\n\n                flow += f;\n                cost += f * (potential[sink] - potential[source]);\n            }\n\n            return new long[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MinCostMaxFlow g = new MinCostMaxFlow((n + 2) * 102);\n\n        for (int i = 0; i < 102; i++) {\n            g.addEdge(i * (n + 2) + 1, i * (n + 2), 100, (long) i * c);\n        }\n\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < n + 1; j++) {\n                g.addEdge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0);\n            }\n        }\n\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            g.addEdge(n + 1, u, 1, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                    g.addEdge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, (long) ((2 * f) + 1) * d);\n                }\n            }\n        }\n\n        long[] result = g.maxFlow(n + 1, 101 * (n + 2));\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018380382971372455, -4.172316494077677e-06, -1.0728830375228426e-06, -0.0029844765085726976, -6.23445157543756e-05, -0.34846702218055725, -0.386968731880188, -0.0015326907159760594, -7.152555099310