{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.util.*;\nimport java.io.*;\nimport java.math.BigInteger;\nimport java.util.stream.IntStream;\n\npublic class FFT {\n    FastScanner in;\n    PrintWriter out;\n    boolean systemIO = true;\n\n    public class Vector {\n        int sz = 1 << 20;\n        long[] v;\n\n        public Vector(long[] a) {\n            v = new long[sz];\n            IntStream.range(0, a.length).forEach(i -> v[i] = a[i]);\n        }\n\n        public long[] FFT() {\n            return DFT(0, 1, true);\n        }\n\n        public long[] FFT1() {\n            long[] x = DFT(0, 1, false);\n            IntStream.range(0, x.length).forEach(i -> x[i] = x[i] * szinv % mod);\n            return x;\n        }\n\n        public long[] DFT(int first, int pow, boolean straight) {\n            if (pow == sz) {\n                return new long[]{v[first]};\n            }\n            long[] zero = DFT(first, 2 * pow, straight);\n            long[] one = DFT(first + pow, 2 * pow, straight);\n            int n = zero.length;\n            long[] ans = new long[2 * n];\n            long[] roots = straight ? warr : winvarr;\n            IntStream.range(0, n).forEach(i -> {\n                long t = roots[i * pow] * one[i] % mod;\n                ans[i] = (zero[i] + t) % mod;\n                ans[n + i] = ((zero[i] - t) % mod + mod) % mod;\n            });\n            return ans;\n        }\n    }\n\n    public long[] fft(long[] a) {\n        long wth = 1;\n        int sz = 1 << 20;\n        long[] ans = new long[sz];\n        for (int i = 0; i < ans.length; i++) {\n            long x = 1;\n            for (int j = 0; j < a.length; j++) {\n                ans[i] += a[j] * x;\n                ans[i] %= mod;\n                x *= wth;\n                x %= mod;\n            }\n            wth *= w;\n            wth %= mod;\n        }\n        return ans;\n    }\n\n    public long[] pow(long[] ans, int p) {\n        IntStream.range(0, ans.length).forEach(i -> ans[i] = pow(ans[i], p));\n        return ans;\n    }\n\n    public long pow(long x, int p) {\n        if (p == 0) return 1;\n        if (p % 2 == 1) return pow(x, p - 1) * x % mod;\n        long y = pow(x, p / 2);\n        return y * y % mod;\n    }\n\n    long mod = 998244353;\n    long w = 646;\n    long winv = new BigInteger(w + \"\").modInverse(new BigInteger(mod + \"\")).longValueExact();\n    long[] warr = new long[1 << 20];\n    long[] winvarr = new long[1 << 20];\n    long szinv = new BigInteger((1 << 20) + \"\").modInverse(new BigInteger(mod + \"\")).longValueExact();\n\n    public void solve() {\n        int n = in.nextInt();\n        int k = in.nextInt();\n        long[] arr = new long[10];\n        for (int i = 0; i < k; i++) {\n            arr[in.nextInt()] = 1;\n        }\n        warr[0] = 1;\n        winvarr[0] = 1;\n        for (int i = 1; i < warr.length; i++) {\n            warr[i] = warr[i - 1] * w % mod;\n            winvarr[i] = winvarr[i - 1] * w % mod;\n        }\n        long[] x = fft(arr);\n        x = pow(x, n / 2);\n        Vector v = new Vector(x);\n        x = v.FFT1();\n        long ans = 0;\n        for (int i = 0; i < x.length; i++) {\n            ans += x[i] * x[i];\n            ans %= mod;\n        }\n        out.println(ans);\n    }\n\n    public void run() {\n        try {\n            if (systemIO) {\n                in = new FastScanner(System.in);\n                out = new PrintWriter(System.out);\n            } else {\n                in = new FastScanner(new File(\"input.txt\"));\n                out = new PrintWriter(new File(\"output.txt\"));\n            }\n            solve();\n            out.close();\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n    }\n\n    class FastScanner {\n        BufferedReader br;\n        StringTokenizer st;\n\n        FastScanner(File f) {\n            try {\n                br = new BufferedReader(new FileReader(f));\n            } catch (FileNotFoundException e) {\n                e.printStackTrace();\n            }\n        }\n\n        FastScanner(InputStream f) {\n            br = new BufferedReader(new InputStreamReader(f));\n        }\n\n        String nextLine() {\n            try {\n                return br.readLine();\n            } catch (IOException e) {\n                return null;\n            }\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n    }\n\n    public static void main(String[] arg) {\n        new FFT().run();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <cstdint>\nusing namespace std;\n\nconst long long mod = 998244353;\nconst long long w = 646;\nconst int sz = 1 << 20;\n\nlong long pow_mod(long long x, int p) {\n    if (p == 0) return 1;\n    if (p % 2 == 1) return pow_mod(x, p - 1) * x % mod;\n    long long y = pow_mod(x, p / 2);\n    return y * y % mod;\n}\n\nvector<long long> warr(sz), winvarr(sz);\nlong long szinv;\n\nvector<long long> DFT(const vector<long long>& v, int first, int pow, bool straight) {\n    if (pow == sz) {\n        return {v[first]};\n    }\n    vector<long long> zero = DFT(v, first, 2 * pow, straight);\n    vector<long long> one = DFT(v, first + pow, 2 * pow, straight);\n    int n = zero.size();\n    vector<long long> ans(2 * n);\n    for (int i = 0; i < n; ++i) {\n        long long t = (straight ? warr : winvarr)[i * pow] * one[i] % mod;\n        ans[i] = (zero[i] + t) % mod;\n        ans[n + i] = ((zero[i] - t) % mod + mod) % mod;\n    }\n    return ans;\n}\n\nvector<long long> FFT(const vector<long long>& v) {\n    return DFT(v, 0, 1, true);\n}\n\nvector<long long> FFT1(const vector<long long>& v) {\n    vector<long long> x = DFT(v, 0, 1, false);\n    for (int i = 0; i < sz; ++i) {\n        x[i] = x[i] * szinv % mod;\n    }\n    return x;\n}\n\nvector<long long> fft(const vector<long long>& a) {\n    vector<long long> ans(sz, 0);\n    long long wth = 1;\n    for (int i = 0; i < sz; ++i) {\n        long long x = 1;\n        for (int j = 0; j < (int)a.size(); ++j) {\n            ans[i] = (ans[i] + a[j] * x) % mod;\n            x = x * wth % mod;\n        }\n        wth = wth * w % mod;\n    }\n    return ans;\n}\n\nvoid pow_arr(vector<long long>& arr, int p) {\n    for (int i = 0; i < (int)arr.size(); ++i) {\n        arr[i] = pow_mod(arr[i], p);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k;\n    cin >> n >> k;\n    vector<long long> arr(10, 0);\n    for (int i = 0; i < k; ++i) {\n        int d;\n        cin >> d;\n        arr[d] = 1;\n    }\n\n    // precompute roots\n    warr[0] = 1;\n    winvarr[0] = 1;\n    for (int i = 1; i < sz; ++i) {\n        warr[i] = warr[i - 1] * w % mod;\n        winvarr[i] = winvarr[i - 1] * w % mod;\n    }\n    szinv = pow_mod(sz, mod - 2);\n\n    vector<long long> x = fft(arr);\n    pow_arr(x, n / 2);\n    vector<long long> y = FFT1(x);\n    long long ans = 0;\n    for (int i = 0; i < sz; ++i) {\n        ans = (ans + y[i] * y[i]) % mod;\n    }\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.629365427419543e-06, -1.1920928244535389e-07, 0.0, -0.000433112756581977, -0.001263773301616311, -1.0728830375228426e-06, -0.0005538121913559735, -1.8954096958623268e-05, 0.0, 0.0, -1.1920928244535389e-07, -0.07890351861715317, -0.2520116865634918, -3.576278118089249e-07, -0.48329150676727295, -0.03685237094759941, -1.6689160474925302e-05, -0.5762504935264587, -0.029819495975971222, -3.576278118089249e-07, 0.0, -0.07889999449253082, -0.3155823349952698, -0.006723874714225531, -1.4066597032069694e-05, -0.3132617473602295, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.004099181387573481, -8.344646857949556e-07, -0.03804141283035278, 0.0, -2.50339189733495e-06, -5.960462772236497e-07, 0.0, 0.0, -0.0007901645149104297, -4.4225667807040736e-05, -0.0015023384476080537, -0.001189596951007843, -5.960462772236497e-07, -8.344646857949556e-07, -9.536738616588991e-07, -4.5536911784438416e-05, 0.0, 0.0, -0.4748091697692871, -0.1623554229736328, -2.3841855067985307e-07, -0.10674373060464859, -9.870042413240299e-05, -4.768370445162873e-07, 0.0, -7.152555099310121e-07, 0.0, -0.00015853578224778175, -5.960462772236497e-07, -1.8954096958623268e-05, -4.768370445162873e-07, -1.4424220353248529e-05, -0.0024757706560194492, -4.7205765440594405e-05, 0.0, -2.3841855067985307e-07, 0.