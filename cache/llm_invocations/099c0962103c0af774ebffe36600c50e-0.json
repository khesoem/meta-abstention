{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Edge {\n    int dest, cap, flow, weight;\n    Edge() {}\n    Edge(int d, int c, int f, int w) : dest(d), cap(c), flow(f), weight(w) {}\n};\n\nvector<Edge> edges;\nconst int MAX_NODES = 14043;\nvector<int> adj[MAX_NODES];\nlong long totalCost = 0;\nlong long dist[MAX_NODES];\nint parent[MAX_NODES];\nint parentEdge[MAX_NODES];\nbool inQueue[MAX_NODES];\nconst long long INF = 1e18;\n\nint source = MAX_NODES - 2;\nint sink = MAX_NODES - 1;\n\nint remaining(int idx) {\n    return edges[idx].cap - edges[idx].flow;\n}\n\nvoid augmentPath() {\n    fill(dist, dist + MAX_NODES, INF);\n    fill(parent, parent + MAX_NODES, -1);\n    fill(parentEdge, parentEdge + MAX_NODES, -1);\n    fill(inQueue, inQueue + MAX_NODES, false);\n    dist[source] = 0;\n    queue<int> q;\n    q.push(source);\n    inQueue[source] = true;\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inQueue[u] = false;\n        for (int eIdx : adj[u]) {\n            if (remaining(eIdx) == 0) continue;\n            int v = edges[eIdx].dest;\n            int w = edges[eIdx].weight;\n            if (dist[v] > dist[u] + w) {\n                dist[v] = dist[u] + w;\n                parent[v] = u;\n                parentEdge[v] = eIdx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    int cur = sink;\n    while (cur != source) {\n        edges[parentEdge[cur]].flow++;\n        edges[parentEdge[cur] ^ 1].flow--;\n        cur = parent[cur];\n    }\n    totalCost += dist[sink];\n}\n\nvoid addBidirectionalEdge(int u, int v, int cap, int weight) {\n    adj[u].push_back(edges.size());\n    edges.emplace_back(v, cap, 0, weight);\n    adj[v].push_back(edges.size());\n    edges.emplace_back(u, 0, 0, -weight);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m, k, c, d_val;\n    cin >> n >> m >> k >> c >> d_val;\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        addBidirectionalEdge(source, x, 1, 0);\n    }\n    const int TIME_LIMIT = 101;\n    for (int t = 0; t < TIME_LIMIT; ++t) {\n        addBidirectionalEdge(t * n, sink, k, t * c);\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        for (int t = 0; t < TIME_LIMIT - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addBidirectionalEdge(u + t * n, v + (t + 1) * n, 1, d_val * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < TIME_LIMIT - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addBidirectionalEdge(v + t * n, u + (t + 1) * n, 1, d_val * (2 * j + 1));\n            }\n        }\n    }\n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < TIME_LIMIT - 1; ++t) {\n            addBidirectionalEdge(i + t * n, i + (t + 1) * n, k, 0);\n        }\n    }\n    for (int i = 0; i < k; ++i) {\n        augmentPath();\n    }\n    cout << totalCost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    def __init__(self, dest, cap, flow, weight):\n        self.dest = dest\n        self.cap = cap\n        self.flow = flow\n        self.weight = weight\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d_val = int(data[idx]); idx += 1\n    \n    edges = []\n    MAX_NODES = 14043\n    adj = [[] for _ in range(MAX_NODES)]\n    totalCost = 0\n    INF = 10**18\n    \n    source = MAX_NODES - 2\n    sink = MAX_NODES - 1\n    \n    def remaining(eIdx):\n        return edges[eIdx].cap - edges[eIdx].flow\n    \n    def addBidirectionalEdge(u, v, cap, weight):\n        adj[u].append(len(edges))\n        edges.append(Edge(v, cap, 0, weight))\n        adj[v].append(len(edges))\n        edges.append(Edge(u, 0, 0, -weight))\n    \n    for _ in range(k):\n        x = int(data[idx]); idx += 1\n        x -= 1\n        addBidirectionalEdge(source, x, 1, 0)\n    \n    TIME_LIMIT = 101\n    for t in range(TIME_LIMIT):\n        addBidirectionalEdge(t * n, sink, k, t * c)\n    \n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        u -= 1\n        v -= 1\n        for t in range(TIME_LIMIT - 1):\n            for j in range(k):\n                addBidirectionalEdge(u + t * n, v + (t + 1) * n, 1, d_val * (2 * j + 1))\n        for t in range(TIME_LIMIT - 1):\n            for j in range(k):\n                addBidirectionalEdge(v + t * n, u + (t + 1) * n, 1, d_val * (2 * j + 1))\n    \n    for i in range(n):\n        for t in range(TIME_LIMIT - 1):\n            addBidirectionalEdge(i + t * n, i + (t + 1) * n, k, 0)\n    \n    def augmentPath():\n        nonlocal totalCost\n        dist = [INF] * MAX_NODES\n        parent = [-1] * MAX_NODES\n        parentEdge = [-1] * MAX_NODES\n        inQueue = [False] * MAX_NODES\n        dist[source] = 0\n        q = deque()\n        q.append(source)\n        inQueue[source] = True\n        \n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            for eIdx in adj[u]:\n                if remaining(eIdx) == 0:\n                    continue\n                v = edges[eIdx].dest\n                w = edges[eIdx].weight\n                if dist[v] > dist[u] + w:\n                    dist[v] = dist[u] + w\n                    parent[v] = u\n                    parentEdge[v] = eIdx\n                    if not inQueue[v]:\n                        inQueue[v] = True\n                        q.append(v)\n        \n        cur = sink\n        while cur != source:\n            edges[parentEdge[cur]].flow += 1\n            edges[parentEdge[cur] ^ 1].flow -= 1\n            cur = parent[cur]\n        \n        totalCost += dist[sink]\n    \n    for _ in range(k):\n        augmentPath()\n    \n    print(totalCost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013064485392533243, -5.960462772236497e-07, -1.1920928244535389e-07, -0.4319882094860077, -0.021662063896656036, -2.3841855067985307e-07, -2.825220326485578e-05, -0.00024101213784888387, -9.536738616588991e-07, -0.00029940891545265913, -0.00015317220822907984, -0.5001028776168823, -1.3351351299206726e-05, -3.576278118089249e-07, -2.3841855067985307e-07, -0.17974485456943512, -7.152555099310121e-07, -2.9802276912960224e-06, -1.1920928244535389e-07, -1.0728830375228426e-06, -2.622600959512056e-06, -1.9311717551317997e-05, -0.00016544880054425448, -1.168244216387393e-05, -2.455681169521995e-05, -5.960446742392378e-06, -0.00010144196130568162, -1.311301275563892e-06, -5.245195097813848e-06, -4.52994254374061