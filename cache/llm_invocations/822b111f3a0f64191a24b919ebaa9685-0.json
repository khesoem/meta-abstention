       sums.append(cur)\n            return\n        mask = bit(L)\n        if not (req & mask):\n            recurse(L + 1, N, a, na, req, excl, cur, sums)\n        if na > 0 and not (excl & mask):\n            nxt = cur + choose(a, R - 1) * choose(L - a, R)\n            recurse(L + 1, N, a + 1, na - 1, req, excl, nxt, sums)\n\n    def solve(pattern):\n        N = len(pattern)\n        base = 0\n        for i in range(R + C):\n            base += choose(i, R - 1) * choose(N - i - 1, R)\n        unfair = None\n        trg = 2 * base - choose(N, 2 * R)\n\n        req = 0\n        excl = 0\n        for i, ch in enumerate(pattern):\n            if ch == 'A':\n                req |= bit(i)\n            elif ch == 'B':\n                excl |= bit(i)\n\n        # dp[j][k] = number of ways to have j A's and k B's in first j+k positions\n        dp = [[0] * (R + C + 1) for _ in range(R + C + 1)]\n        dp[0][0] = 1\n        for j in range(R + C + 1):\n            for k in range(R + C + 1):\n                if j >= R - 1 and k >= R:\n                    break\n                if j < R + C and pattern[j + k] != 'B':\n                    dp[j + 1][k] += dp[j][k]\n                if k < R + C and pattern[j + k] != 'A':\n                    dp[j][k + 1] += dp[j][k]\n\n        M = N - C\n        asums2 = [[] for _ in range(R + C + 1)]\n        for al in range(R - 1, R + C + 1):\n            recurse(M, N, al, R + C - al, req, excl, 0, asums2[al])\n            asums2[al].sort(reverse=True)\n\n        ans = 0\n        for a in range(R - 1, R + C + 1):\n            for b in range(R, R + C + 1):\n                if a > R - 1 and b > R:\n                    continue\n                if dp[a][b] == 0:\n                    continue\n                L = a + b\n                for l in range(0, M - L + 1):\n                    r = R + C - a - l\n                    if r > N - M or r < 0:\n                        continue\n                    sums1 = []\n                    recurse(L, M, a, l, req, excl, 0, sums1)\n                    sums1.sort()\n                    sums2 = asums2[a + l]\n                    p = 0\n                    q = 0\n                    p2 = 0\n                    q2 = 0\n                    while p < len(sums1) and q < len(sums2):\n                        while p2 < len(sums1) and sums1[p2] == sums1[p]:\n                            p2 += 1\n                        while q2 < len(sums2) and sums2[q2] == sums2[q]:\n                            q2 += 1\n                        total = 2 * (sums1[p] + sums2[q])\n                        diff = abs(total - trg)\n                        if unfair is None or diff < unfair:\n                            unfair = diff\n                            ans = 0\n                        if diff == unfair:\n                            ans += (p2 - p) * (q2 - q) * dp[a][b]\n                        if total > trg:\n                            q = q2\n                        else:\n                            p = p2\n        return (unfair, ans)\n\n    opt = solve('?' * N)\n    score = solve(pattern)\n    if score[0] == opt[0]:\n        print(score[1])\n    else:\n        print(0)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.3351351299206726e-05, 0.0, 0.0, -0.00044252615771256387, -0.0007739647408016026, 0.0, -0.16023670136928558, -0.0032051641028374434, -0.005398101639002562, -5.900685573578812e-05, -1.1920928244535389e-07, -0.0003430254873819649, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.0025144172832369804, -2.3841855067985307e-07, -3.2066785934148356e-05, -3.2305197237292305e-05, -2.861018856492592e-06, -1.4424220353248529e-05, 0.0, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, -0.00020346954988781363, -1.0728830375228426e-06, 0.0, -1.1920928244535389e-07, -6.198863957251888e-06, 0.0, -5.364403477869928e-06, 0.0, 0.0, -2.3841574147809297e-05, 0.0, -4.756337511935271e-05, -4.517