 inv(k));\n                long expVal = mul(phases, totalPhases);\n                long contrib = mul(nCr(n, k), expVal);\n\n                if ((k & 1) == 1)\n                    answer = add(answer, contrib);\n                else\n                    answer = sub(answer, contrib);\n            }\n\n            out.println(answer);\n        }\n\n        private void init(int limit) {\n            fact = new long[limit];\n            invFact = new long[limit];\n            fact[0] = 1;\n            for (int i = 1; i < limit; i++) fact[i] = (fact[i - 1] * i) % MOD;\n            invFact[limit - 1] = pow(fact[limit - 1], MOD - 2);\n            for (int i = limit - 2; i >= 0; i--) invFact[i] = (invFact[i + 1] * (i + 1)) % MOD;\n        }\n\n        private long nCr(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n        }\n\n        private long inv(int x) {\n            return pow(x, MOD - 2);\n        }\n\n        private long add(long a, long b) {\n            a += b;\n            return a >= MOD ? a - MOD : a;\n        }\n\n        private long sub(long a, long b) {\n            a -= b;\n            return a < 0 ? a + MOD : a;\n        }\n\n        private long mul(long a, long b) {\n            return (a * b) % MOD;\n        }\n\n        private long pow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = (res * base) % MOD;\n                base = (base * base) % MOD;\n                exp >>= 1;\n            }\n            return res;\n        }\n\n        private long[] fact, invFact;\n    }\n\n    static class InputParser {\n        BufferedReader br;\n        StringTokenizer st;\n\n        InputParser(InputStream is) {\n            br = new BufferedReader(new InputStreamReader(is), 32768);\n        }\n\n        String next() {\n            try {\n                while (st == null |