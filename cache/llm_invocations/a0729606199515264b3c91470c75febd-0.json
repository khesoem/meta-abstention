{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n/*\nAuthor: QAQ Automaton\nLang: C++\nProg: E.cpp\nMail: lk@qaq-am.com\nBlog: https://www.qaq-am.com/\n*/\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing i64 = long long;\nusing u64 = unsigned long long;\n\nconst int MOD = 1000000007;\n\nstruct Bitset128 {\n    u64 lo, hi;\n    \n    Bitset128() : lo(0), hi(0) {}\n    \n    void set(int pos) {\n        if (pos < 64) lo |= (1ULL << pos);\n        else hi |= (1ULL << (pos - 64));\n    }\n    \n    void clear() { lo = hi = 0; }\n    \n    bool operator==(const Bitset128& other) const {\n        return lo == other.lo && hi == other.hi;\n    }\n    \n    bool operator[](int pos) const {\n        return (pos < 64) ? ((lo >> pos) & 1) : ((hi >> (pos - 64)) & 1);\n    }\n    \n    Bitset128& operator|=(const Bitset128& rhs) {\n        lo |= rhs.lo;\n        hi |= rhs.hi;\n        return *this;\n    }\n};\n\nbool operator<(const Bitset128& a, const Bitset128& b) {\n    return a.hi < b.hi || (a.hi == b.hi && a.lo < b.lo);\n}\n\nint n;\nint a[11][11];\nint f[11][1 << 11];\nmap<Bitset128, int> memo[8];\nBitset128 full_mask;\n\nint mod_pow(int base, int exp) {\n    int res = 1;\n    while (exp > 0) {\n        if (exp & 1) res = (1LL * res * base) % MOD;\n        base = (1LL * base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nint dfs(int depth, Bitset128 state) {\n    if (depth == n) return state == full_mask;\n    auto& cached = memo[depth][state];\n    if (cached) return cached;\n    \n    int result = 0;\n    Bitset128 next_states[11];\n    \n    for (int mask = 0; mask < (1 << n); ++mask) {\n        if (state[mask]) {\n            for (int j = 0; j < n; ++j) {\n                if (!(mask & (1 << j))) {\n                    next_states[j].set(mask | (1 << j));\n                }\n            }\n        }\n    }\n    \n    for (int choice = 0; choice < (1 << n); ++choice) {\n        Bitset128 new_state = state;\n        for (int j = 0; j < n; ++j) {\n            if (choice & (1 << j)) new_state |= next_states[j];\n        }\n        result = (result + 1LL * f[depth][choice] * dfs(depth + 1, new_state)) % MOD;\n    }\n    \n    return cached = result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n#ifdef QAQAutoMaton\n    freopen(\"E.in\", \"r\", stdin);\n    freopen(\"E.out\", \"w\", stdout);\n#endif\n    \n    cin >> n;\n    \n    for (int i = 0; i < (1 << n); ++i) full_mask.set(i);\n    \n    Bitset128 initial;\n    initial.set(0);\n    \n    int inv100 = mod_pow(100, MOD - 2);\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            a[i][j] = (1LL * a[i][j] * inv100) % MOD;\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            f[i][mask] = 1;\n            for (int k = 0; k < n; ++k) {\n                if (mask & (1 << k)) {\n                    f[i][mask] = (1LL * f[i][mask] * a[k][i]) % MOD;\n                } else {\n                    f[i][mask] = (1LL * f[i][mask] * ((MOD + 1 - a[k][i]) % MOD)) % MOD;\n                }\n            }\n        }\n    }\n    \n    cout << dfs(0, initial) << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom functools import lru_cache\n\nMOD = 1000000007\n\nclass Bitset128:\n    def __init__(self):\n        self.lo = 0\n        self.hi = 0\n    \n    def set(self, pos):\n        if pos < 64:\n            self.lo |= (1 << pos)\n        else:\n            self.hi |= (1 << (pos - 64))\n    \n    def clear(self):\n        self.lo = 0\n        self.hi = 0\n    \n    def __eq__(self, other):\n        return self.lo == other.lo and self.hi == other.hi\n    \n    def __getitem__(self, pos):\n        if pos < 64:\n            return (self.lo >> pos) & 1\n        else:\n            return (self.hi >> (pos - 64)) & 1\n    \n    def __or__(self, rhs):\n        result = Bitset128()\n        result.lo = self.lo | rhs.lo\n        result.hi = self.hi | rhs.hi\n        return result\n    \n    def __ior__(self, rhs):\n        self.lo |= rhs.lo\n        self.hi |= rhs.hi\n        return self\n    \n    def __hash__(self):\n        return hash((self.lo, self.hi))\n    \n    def __lt__(self, other):\n        if self.hi != other.hi:\n            return self.hi < other.hi\n        return self.lo < other.lo\n\ndef mod_pow(base, exp):\n    res = 1\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return res\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    idx = 0\n    n = int(input_data[idx])\n    idx += 1\n    \n    full_mask = Bitset128()\n    for i in range(1 << n):\n        full_mask.set(i)\n    \n    initial = Bitset128()\n    initial.set(0)\n    \n    inv100 = mod_pow(100, MOD - 2)\n    \n    a = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            a[i][j] = (int(input_data[idx]) * inv100) % MOD\n            idx += 1\n    \n    f = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        for mask in range(1 << n):\n            f[i][mask] = 1\n            for k in range(n):\n                if mask & (1 << k):\n                    f[i][mask] = (f[i][mask] * a[k][i]) % MOD\n                else:\n                    f[i][mask] = (f[i][mask] * ((MOD + 1 - a[k][i]) % MOD)) % MOD\n    \n    # Memoization using dictionaries\n    memo = [{} for _ in range(n)]\n    \n    def dfs(depth, state_tuple):\n        if depth == n:\n            return 1 if state_tuple == (full_mask.lo, full_mask.hi) else 0\n        \n        if state_tuple in memo[depth]:\n            return memo[depth][state_tuple]\n        \n        # Convert tuple back to Bitset128 for operations\n        state = Bitset128()\n        state.lo, state.hi = state_tuple\n        \n        result = 0\n        next_states = [Bitset128() for _ in range(n)]\n        \n        for mask in range(1 << n):\n            if state[mask]:\n                for j in range(n):\n                    if not (mask & (1 << j)):\n                        next_states[j].set(mask | (1 << j))\n        \n        for choice in range(1 << n):\n            new_state = Bitset128()\n            new_state.lo = state.lo\n            new_state.hi = state.hi\n            for j in range(n):\n                if choice & (1 << j):\n                    new_state |= next_states[j]\n            \n            new_state_tuple = (new_state.lo, new_state.hi)\n            result = (result + f[depth][choice] * dfs(depth + 1, new_state_tuple)) % MOD\n        \n        memo[depth][state_tuple] = result\n        return result\n    \n    initial_tuple = (initial.lo, initial.hi)\n    print(dfs(0, initial_tuple))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002489972102921456, -1.66892