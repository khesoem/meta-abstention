ost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1000000000\n\nclass Edge:\n    def __init__(self, dest, capacity, cost, flow, rev):\n        self.dest = dest\n        self.capacity = capacity\n        self.cost = cost\n        self.flow = flow\n        self.rev = rev\n\ndef connect(g, a, b, cap, c):\n    g[a].append(Edge(b, cap, c, 0, len(g[b])))\n    g[b].append(Edge(a, 0, -c, 0, len(g[a]) - 1))\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    N = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    nodes = N * 101 + 2\n    graph = [[] for _ in range(nodes)]\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        connect(graph, nodes - 2, x * 101, 1, 0)\n    \n    for i in range(101):\n        connect(graph, i, nodes - 1, INF, i * c)\n    \n    for i in range(1, N):\n        for j in range(100):\n            connect(graph, i * 101 + j, i * 101 + j + 1, INF, 0)\n    \n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(100):\n            for K in range(1, k + 1):\n                edgeCost = d * (K * K - (K - 1) * (K - 1))\n                connect(graph, u * 101 + j, v * 101 + j + 1, 1, edgeCost)\n                connect(graph, v * 101 + j, u * 101 + j + 1, 1, edgeCost)\n    \n    src = nodes - 2\n    dst = nodes - 1\n    flow = 0\n    cost = 0\n    \n    while flow < k:\n        dist = [INF] * nodes\n        prev = [-1] * nodes\n        edgeIdx = [0] * nodes\n        inQ = [False] * nodes\n        q = deque()\n        \n        dist[src] = 0\n        q.append(src)\n        inQ[src] = True\n        \n        while q:\n            u = q.popleft()\n            inQ[u] = False\n      