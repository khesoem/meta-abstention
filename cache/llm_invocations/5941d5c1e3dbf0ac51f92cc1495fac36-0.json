{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class F_v2 {\n    public static void main(String[] args) throws Exception {\n        new F_v2().run();\n    }\n\n    void run() throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] parts = br.readLine().trim().split(\"\\\\s+\");\n        int n = Integer.parseInt(parts[0]);\n        int K = Integer.parseInt(parts[1]);\n        int L = Integer.parseInt(parts[2]);\n        \n        int MOD = 998244353;\n        int[][] fif = buildFactorialTables(10000, MOD);\n        \n        long[] contributions = new long[n + 1];\n        \n        for (int i = K; i <= n; i++) {\n            long baseComb = comb(n, i, MOD, fif);\n            for (int j = i; j <= n; j++) {\n                long inner = comb(n - i, n - j, MOD, fif);\n                long adjusted = (inner * baseComb) % MOD;\n                if ((j - i) % 2 == 1) adjusted = (MOD - adjusted) % MOD;\n                contributions[j] = (contributions[j] + adjusted) % MOD;\n            }\n        }\n        \n        long result = 0;\n        for (int i = K; i <= n; i++) {\n            long val = contributions[i];\n            if (val == 0) continue;\n            \n            long t1 = fastPow(2, i, MOD);\n            long t2 = fif[0][i];\n            long t3 = fif[1][i];\n            long t4 = fif[1][2 * i + 1];\n            \n            long term = t1 * t2 % MOD;\n            term = term * t3 % MOD;\n            term = term * t4 % MOD;\n            term = term * val % MOD;\n            \n            result = (result + term) % MOD;\n        }\n        \n        result = result * L % MOD;\n        if (result < 0) result += MOD;\n        System.out.println(result);\n    }\n\n    private static int[][] buildFactorialTables(int N, int MOD) {\n        int[] fact = new int[N + 1];\n        int[] invFact = new int[N + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= N; i++) {\n            fact[i] = (int) ((long) fact[i - 1] * i % MOD);\n        }\n        invFact[N] = modInverse(fact[N], MOD);\n        for (int i = N - 1; i >= 0; i--) {\n            invFact[i] = (int) ((long) invFact[i + 1] * (i + 1) % MOD);\n        }\n        return new int[][] { fact, invFact };\n    }\n\n    private static int modInverse(int a, int MOD) {\n        return fastPow(a, MOD - 2, MOD);\n    }\n\n    private static int fastPow(int base, int exp, int MOD) {\n        int res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (int) ((long) res * base % MOD);\n            base = (int) ((long) base * base % MOD);\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    private static long comb(int n, int k, int MOD, int[][] fif) {\n        if (k < 0 || k > n) return 0;\n        return (long) fif[0][n] * fif[1][k] % MOD * fif[1][n - k] % MOD;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\n\nusing namespace std;\n\nvector<vector<int>> buildFactorialTables(int N, int MOD) {\n    vector<int> fact(N + 1);\n    vector<int> invFact(N + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= N; i++) {\n        fact[i] = (int)(((long long)fact[i - 1] * i) % MOD);\n    }\n    // Modular inverse using Fermat's little theorem\n    invFact[N] = fastPow(fact[N], MOD - 2, MOD);\n    for (int i = N - 1; i >= 0; i--) {\n        invFact[i] = (int)(((long long)invFact[i + 1] * (i + 1)) % MOD);\n    }\n    return {fact, invFact};\n}\n\nint fastPow(int base, int exp, int MOD) {\n    int res = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) {\n            res = (int)(((long long)res * base) % MOD);\n        }\n        base = (int)(((long long)base * base) % MOD);\n        exp >>= 1;\n    }\n    return res;\n}\n\nlong long comb(int n, int k, int MOD, const vector<vector<int>>& fif) {\n    if (k < 0 || k > n) return 0;\n    return ((long long)fif[0][n] * fif[1][k] % MOD) * fif[1][n - k] % MOD;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    int n, K, L;\n    iss >> n >> K >> L;\n    \n    int MOD = 998244353;\n    vector<vector<int>> fif = buildFactorialTables(10000, MOD);\n    \n    vector<long long> contributions(n + 1, 0);\n    \n    for (int i = K; i <= n; i++) {\n        long long baseComb = comb(n, i, MOD, fif);\n        for (int j = i; j <= n; j++) {\n            long long inner = comb(n - i, n - j, MOD, fif);\n            long long adjusted = (inner * baseComb) % MOD;\n            if ((j - i) % 2 == 1) {\n                adjusted = (MOD - adjusted) % MOD;\n            }\n            contributions[j] = (contributions[j] + adjusted) % MOD;\n        }\n    }\n    \n    long long result = 0;\n    for (int i = K; i <= n; i++) {\n        long long val = contributions[i];\n        if (val == 0) continue;\n        \n        long long t1 = fastPow(2, i, MOD);\n        long long t2 = fif[0][i];\n        long long t3 = fif[1][i];\n        long long t4 = fif[1][2 * i + 1];\n        \n        long long term = t1 * t2 % MOD;\n        term = term * t3 % MOD;\n        term = term * t4 % MOD;\n        term = term * val % MOD;\n        \n        result = (result + term) % MOD;\n    }\n    \n    result = result * L % MOD;\n    if (result < 0) result += MOD;\n    cout << result << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001998939987970516, -1.1920922133867862e-06, -3.576278118089249e-07, -0.0005360596696846187, -3.576278118089249e-07, -7.986990567587782e-06, -2.9802276912960224e-06, -1.4662635294371285e-05, -4.768370445162873e-07, -0.015015081502497196, -2.622600959512056e-06, -6.687417771900073e-05, -1.1920922133867862e-06, -0.016435477882623672, -3.3378546504536644e-06, -0.0002961912250611931, -9.65590606938349e-06, -0.02728821337223053, -0.014165329746901989, -0.12693676352500916, -1.1920928244535389e-07, -0.43229493498802185, -0.5759422183036804, -0.00028975578607060015, -1.764281842042692e-05, -2.50339189733495e-06, -1.311301275563892e-06, -1.0284099578857422, -0.0005055579822510481, -0.00023064337437972426, -0.00019167017308063805, -2.7418097943154862e-06, -0.0002225389762315899, -4.768370445162873e-07, -2.276871418871451e-05, -3.755022044060752e-05, -1.4305104514278355e-06, 0.0, -0.00017093151109293103, -8.106198947643861e-06, -0.04337051138281822, -1.0728830375228426e-06, -4.768370445162873e-07, -3.4570634852570947e-06, -3.540453326422721e-05, -1.1920928244535389e-07, -3.576272320060525e-06, -8.344646857949556e-07, -1.0132738680113107e-05, 0.0, 0.0, -0.001505671301856637, -1.1920928244535389e-07, -1.9073468138230965e-06, -3.015949550899677e-05, -1.1920928244535389e-07, -5.364403477869928e-06, -0.0001387499796692282, -3.933898824470816e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -7.152555099310121e-07, -2.5510462364763953e-05