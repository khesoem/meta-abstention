n        while x > 0:\n            self.read()\n            x -= 1\n\n    def nextInt(self):\n        return int(self.next())\n\n    def nextLong(self):\n        return int(self.next())\n\n    def nextString(self):\n        return self.next()\n\n    def next(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        res = bytearray()\n        while not self.isSpaceChar(c):\n            res.append(c)\n            c = self.read()\n        return res.decode('ascii')\n\n    def nextLine(self):\n        buf = bytearray()\n        c = self.read()\n        while c != ord('\\n') and c != -1:\n            if c != ord('\\r'):\n                buf.append(c)\n            c = self.read()\n        return buf.decode('ascii')\n\n    def nextDouble(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0.0\n        while not self.isSpaceChar(c) and c != ord('.'):\n            if c == ord('e') or c == ord('E'):\n                return res * (10 ** self.nextInt())\n            if c < ord('0') or c > ord('9'):\n                raise Exception(\"InputMismatchException\")\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n        if c == ord('.'):\n            c = self.read()\n            m = 1.0\n            while not self.isSpaceChar(c):\n                if c == ord('e') or c == ord('E'):\n                    return res * (10 ** self.nextInt())\n                if c < ord('0') or c > ord('9'):\n                    raise Exception(\"InputMismatchException\")\n                m /= 10\n                res += (c - ord('0')) * m\n                c = self.read()\n        return res * sgn\n\n    def hasNext(self):\n        value = self.peek()\n        while self.isSpaceChar(value) and value != -1:\n            self.read()\n            value = self.peek()\n        return value != -1\n\n    def isSpaceChar(self, c):\n        return c in (ord(' '), ord('\\n'), ord('\\r'), ord('\\t'), -1)\n\n\ndef main():\n    in_reader = InputReader(sys.stdin.buffer)\n    n = in_reader.nextInt()\n    b = in_reader.nextInt()\n    arr1 = [0] * n\n    for i in range(n):\n        arr1[i] = in_reader.nextInt()\n    \n    odd = 0\n    even = 0\n    pf1 = [0] * n\n    pf2 = [0] * n\n    sum1 = 0\n    sum2 = 0\n    \n    for i in range(n):\n        if arr1[i] % 2 == 0:\n            sum1 += 1\n        else:\n            sum2 += 1\n        pf1[i] = sum1\n        pf2[i] = sum2\n    \n    prev = 0\n    arr = [0] * n\n    p = 0\n    \n    for i in range(1, n-2, 2):\n        x, y = 0, 0\n        if prev == 0:\n            x = pf1[i]\n            y = pf2[i]\n        else:\n            x = pf1[i] - pf1[prev]\n            y = pf2[i] - pf2[prev]\n        \n        if x == y:\n            arr[p] = abs(arr1[i+1] - arr1[i])\n            p += 1\n    \n    val = [1] * p\n    K = [[0] * (b + 1) for _ in range(p + 1)]\n    \n    for i in range(p + 1):\n        for w in range(b + 1):\n            if i == 0 or w == 0:\n                K[i][w] = 0\n            elif arr[i-1] <= w:\n                K[i][w] = max(val[i-1] + K[i-1][w - arr[i-1]], K[i-1][w])\n            else:\n                K[i][w] = K[i-1][w]\n    \n    print(K[p][b])\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.756337511935271e-05, -1.311301275563892e-06, -3.576278118089249e-07, -0.0023284247145056725, -0.00016151554882526398, -0.05490871146321297, -0.1804063618183136, -3.659658250398934e-05, -9.536738616588991e-07, -2.861018856492592e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -5.8412379075889476e-06, -2.0265558760002023e-06, -4.768370445162873e-07, -1.4305104514278355e-06, 0.0, -5.245195097813848e-06, -3.576272320060525e-06, -9.536738616588991e-07, -2.3841855067985307e-07, -4.887569048150908e-06, -1.19209282445353