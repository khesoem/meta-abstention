 i = 0; i < adj[x].size(); ++i) {\n                int y = adj[x][i];\n                int cc = dist[x] + cost[x][i];\n                if (dist[y] > cc && cap[x][i]) {\n                    dist[y] = cc;\n                    prex[y] = x;\n                    prei[y] = i;\n                    if (!vis[y]) {\n                        vis[y] = 1;\n                        q.push(y);\n                    }\n                }\n            }\n        }\n    }\n    \n    int tot = 0;\n    \n    int dfs(int x, int flow) {\n        if (prex[x] == -1) return flow;\n        int y = x;\n        x = prex[y];\n        int i = prei[y];\n        int j = rev[x][i];\n        int f = dfs(x, min(flow, cap[x][i]));\n        cap[x][i] -= f;\n        cap[y][j] += f;\n        return f;\n    }\n    \n    pii solve(int s, int t) {\n        int ans = 0;\n        tot = 0;\n        while (true) {\n            spfa(s);\n            if (dist[t] > 1e9) break;\n            int f = dfs(t, INF);\n            tot += f * dist[t];\n            ans += f;\n        }\n        return pii(ans, tot);\n    }\n};\n\nint n, m, s, t;\nint k, c, d;\n\nint get(int x, int tim) {\n    return tim * 52 - 52 + x;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> k >> c >> d;\n    int kk = k;\n    \n    s = MAXN - 1;\n    t = MAXN - 2;\n    \n    MCMF g(MAXN);\n    \n    while (k--) {\n        int x;\n        cin >> x;\n        g.add_edge(s, get(x, 1), 1, 0);\n    }\n    k = kk;\n    \n    while (m--) {\n        int x, y;\n        cin >> x >> y;\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= k; ++j) {\n                g.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n            }\n        }\n        swap(x, y);\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= k; ++j) {\n                g.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n            }\n        }\n    }\n    \n    for (int i = 1; i < 10