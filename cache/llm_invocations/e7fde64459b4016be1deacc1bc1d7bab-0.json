vis[x] = 0;\n                for (int i = 0; i < adj.get(x).size(); ++i) {\n                    int y = adj.get(x).get(i);\n                    int cc = dist[x] + cost.get(x).get(i);\n                    if (dist[y] > cc && cap.get(x).get(i) > 0) {\n                        dist[y] = cc;\n                        prex[y] = x;\n                        prei[y] = i;\n                        if (vis[y] == 0) {\n                            vis[y] = 1;\n                            q.offer(y);\n                        }\n                    }\n                }\n            }\n        }\n\n        int tot = 0;\n\n        int dfs(int x, int flow) {\n            if (prex[x] == -1) return flow;\n            int y = x;\n            x = prex[y];\n            int i = prei[y];\n            int j = rev.get(x).get(i);\n            int f = dfs(x, Math.min(flow, cap.get(x).get(i)));\n            cap.get(x).set(i, cap.get(x).get(i) - f);\n            cap.get(y).set(j, cap.get(y).get(j) + f);\n            return f;\n        }\n\n        int[] solve(int s, int t) {\n            int ans = 0;\n            tot = 0;\n            while (true) {\n                spfa(s);\n                if (dist[t] > 1e9) break;\n                int f = dfs(t, INF);\n                tot += f * dist[t];\n                ans += f;\n            }\n            return new int[]{ans, tot};\n        }\n    }\n\n    static int n, m, s, t;\n    static int k, c, d;\n\n    static int get(int x, int tim) {\n        return tim * 52 - 52 + x;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        int kk = k;\n\n        s = MAXN - 1;\n        t = MAXN - 2;\n\n        MCMF g = new MCMF(MAXN);\n\n        while (k-- > 0) {\n            int x = sc.nextInt();\n            g.add_edge(s, get(x, 1), 1, 0);\n        }\n        k = kk;\n\n        while (m-- > 0) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int i = 1; i < 100; ++i) {\n                for (int j = 1; j <= k; ++j) {\n                    g.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n            int temp = x;\n            x = y;\n            y = temp;\n            for (int i = 1; i < 100; ++i) {\n                for (int j = 1; j <= k; ++j) {\n                    g.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n        }\n\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= n; ++j) {\n                g.add_edge(get(j, i), get(j, i + 1), INF, 0);\n            }\n            g.add_edge(get(1, i), t, INF, c * (i - 1));\n        }\n\n        int[] result = g.solve(s, t);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011872540198964998, -2.50339189733495e-06, -5.960462772236497e-07, -0.0009893052047118545, -3.397406908334233e-05, -0.06197310611605644, -0.12700825929641724, -7.188061863416806e-05, -4.768370445162873e-07, -0.0003682888636831194, -0.014164389111101627, -0.0001399419124936685, -0.04538789391517639, -0.06756989657878876, -1.1801649634435307e-05, -2.276871418871451e-05, 0.0, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.264974000354414e-06, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -4.410734163684538e-06, -1.6689286894688848e-06, -3.576278118089249e-07, -3.099436753473128e-06, -2.3841855067985307e-07, -3.2186455882765586e-06, -2.0265558760002023e-06, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.5497195136049413e-06, -1.5139465176616795e-05, -0.08894185721874237, -9.536738616588991e-07, -2.062299427052494e-05, -8.22540732769994e-06, -0.014676348306238651, -6.318072337307967e-06, 0.0, -4.768370445162873e-07, -1.4305104514278355e-06, -0.000570968666