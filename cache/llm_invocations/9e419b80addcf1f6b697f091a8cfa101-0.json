rite(f\"{n - getLostMaxFast(inputA2, inputB2)} {getWonMaxFast(inputA, inputB)}\\n\")\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        int n = Integer.parseInt(scanner.nextLine().trim());\n        \n        String[] line1 = scanner.nextLine().trim().split(\"\\\\s+\");\n        String[] line2 = scanner.nextLine().trim().split(\"\\\\s+\");\n        \n        int[] inputA = new int[3];\n        int[] inputB = new int[3];\n        \n        for (int i = 0; i < 3; i++) {\n            inputA[i] = Integer.parseInt(line1[i]);\n            inputB[i] = Integer.parseInt(line2[i]);\n        }\n        \n        int[] inputA2 = Arrays.copyOf(inputA, 3);\n        int[] inputB2 = Arrays.copyOf(inputB, 3);\n        \n        int lostMax = getLostMaxFast(inputA2, inputB2);\n        int wonMax = getWonMaxFast(inputA, inputB);\n        \n        System.out.println((n - lostMax) + \" \" + wonMax);\n    }\n    \n    private static int getWonMaxFast(int[] a, int[] b) {\n        int[] wins = new int[3];\n        for (int i = 0; i < 3; i++) {\n            int j = (i + 1) % 3;\n            int match = Math.min(a[i], b[j]);\n            wins[i] = match;\n            a[i] -= match;\n            b[j] -= match;\n        }\n        return wins[0] + wins[1] + wins[2];\n    }\n    \n    private static int getLostMaxFast(int[] a, int[] b) {\n        int[][] patterns = {\n            {0, 2},\n            {1, 0},\n            {2, 1},\n            {0, 0},\n            {1, 1},\n            {2, 2}\n        };\n        \n        int maxLoss = 0;\n        \n        // Generate all permutations of patterns\n        int[][] allPermutations = generatePermutations(patterns);\n        \n        for (int[][] ordering : allPermutations) {\n            int[] loss = new int[3];\n            int[] tempA = Arrays.copyOf(a, 3);\n            int[] tempB = Arrays.copyOf(b, 3);\n            \n            for (int[] pair : ordering) {\n                int src = pair[0];\n                int dst = pair[1];\n                int transfer = Math.min(tempA[src], tempB[dst]);\n                tempA[src] -= transfer;\n                tempB[dst] -= transfer;\n                loss[src] += transfer;\n            }\n            \n            int total = loss[0] + loss[1] + loss[2];\n            if (total > maxLoss) {\n                maxLoss = total;\n            }\n        }\n        \n        return maxLoss;\n    }\n    \n    private static int[][][] generatePermutations(int[][] array) {\n        List<int[][]> result = new ArrayList<>();\n        permute(array, 0, result);\n        return result.toArray(new int[0][][]);\n    }\n    \n    private static void permute(int[][] array, int start, List<int[][]> result) {\n        if (start == array.length) {\n            int[][] copy = new int[array.length][2];\n            for (int i = 0; i < array.length; i++) {\n                copy[i][0] = array[i][0];\n                copy[i][1] = array[i][1];\n            }\n            result.add(copy);\n            return;\n        }\n        \n        for (int i = start; i < array.length; i++) {\n            swap(array, start, i);\n            permute(array, start + 1, result);\n            swap(array, start, i);\n        }\n    }\n    \n    private static void swap(int[][] array, int i, int j) {\n        int[] temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.594620157964528e-05, -1.5497195136049413e-06, -2.3841855067985307e-07, -3.421248038648628e-05, -3.671578815556131e-05, -0.693149209022522, -0.04943999648094177, -1.0132738680113107e-05, -1.5497195136049413e-06, -5.8410845667822286e-05, -0.02324707806110382, -0.000810771249