n        int states = (c50 + 1) * (c100 + 1) * 2;\n        ArrayList<Integer>[] adj = new ArrayList[states];\n        for (int i = 0; i < states; i++) adj[i] = new ArrayList<>();\n\n        for (int i = 0; i <= c50; i++) {\n            for (int j = 0; j <= c100; j++) {\n                int from = idx(i, j, 0);\n                int p50c = Math.min(k / 50, i);\n                int p100c = Math.min(k / 100, j);\n                for (int x = p100c; x >= 0; x--) {\n                    for (int y = Math.min(p50c, (k - 100 * x) / 50); y >= 0; y--) {\n                        if (x == 0 && y == 0) continue;\n                        int to = idx(i - y, j - x, 1);\n                        adj[from].add(to);\n                        adj[to].add(from);\n                    }\n                }\n            }\n        }\n\n        int[] dist = new int[states];\n        long[] ways = new long[states];\n        int start = idx(c50, c100, 0);\n        int target = idx(0, 0, 1);\n        dist[start] = 1;\n        ways[start] = 1;\n        ArrayDeque<Integer> q = new ArrayDeque<>();\n        q.add(start);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            int ub = u & 1;\n            int tmp = u >> 1;\n            int uj = tmp % (colMax + 1);\n            int ui = tmp / (colMax + 1);\n            for (int v : adj[u]) {\n                if (dist[v] == 0 || dist[v] == dist[u] + 1) {\n                    int vb = v & 1;\n                    int tmp2 = v >> 1;\n                    int vj = tmp2 % (colMax + 1);\n                    int vi = tmp2 / (colMax + 1);\n                    long p1 = c[ub == 0 ? ui : c50 - ui][Math.abs(ui - vi)];\n                    long p2 = c[ub == 0 ? uj : c100 - uj][Math.abs(uj - vj)];\n                    ways[v] = (ways[v] + (ways[u] * ((p1 * p2) % mod)) % mod) % mod;\n                    if (dist[v] == 0) {\n                        dist[v] = dist[u] + 1;\n                        q.add(v);\n                    }\n                }\n 