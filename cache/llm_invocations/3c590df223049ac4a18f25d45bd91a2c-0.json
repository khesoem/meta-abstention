        List<Fraction> cands = new ArrayList<>();\n        for (int b = 1; b <= n; b++) {\n            long[] ap = geta(b);\n            cands.add(new Fraction(ap[0], b));\n            cands.add(new Fraction(ap[1], b));\n        }\n\n        Collections.sort(cands, new FractionComparator());\n\n        System.out.println(cands.get(0).a + \"/\" + cands.get(0).b);\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] line = br.readLine().split(\" \");\n        int x = Integer.parseInt(line[0]);\n        int y = Integer.parseInt(line[1]);\n        int n = Integer.parseInt(line[2]);\n\n        solve(x, y, n);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016640232934150845, -3.6954811548639555e-06, -5.960462772236497e-07, -0.0001646144810365513, -1.8596476365928538e-05, -0.012768537737429142, -0.42876192927360535, -0.0002833203470800072, -2.2291887944447808e-05, -0.006997838616371155, -0.002631774405017495, -1.585470999998506e-05, -4.768370445162873e-07, -4.184158387943171e-05, -0.01815195195376873, -0.011050336994230747, -4.1960789531003684e-05, -4.6967357775429264e-05, -7.557583012385294e-05, -0.0002057340752799064, -1.311301275563892e-06, -2.7418097943154862e-06, -3.576278118089249e-07, -0.03366963192820549, -4.768370445162873e-07, -0.0021897403057664633, -0.0004938812926411629, -0.0007708676857873797, -6.198863957251888e-06, -8.34461570775602e-06, -2.3841855067985307e-07, -0.0004407388041727245, -2.3841855067985307e-07, -7.152555099310121e-07, -0.0007098776986822486, -3.2186455882765586e-06, -8.344646857949556e-07, -9.536738616588991e-07, 0.0, -4.768370445162873e-07, -4.887569048150908e-06, -5.960462772236497e-07, -5.364403477869928e-06, -4.172316494077677e-06, 0.0, -2.50339189733495e-06, -1.1920922133867862e-06, -6.794906312279636e-06, -7.152555099310121e-07, -5.960462772236497e-07, -0.002186290919780731