  int y = v.s + ydir[i];\n            if (!check(x, y, s) || res[x][y] != inf) continue;\n\n            res[x][y] = res[v.f][v.s] + 1;\n            b.emplace_back(x, y);\n        }\n    }\n\n    return res;\n}\n\n\nvoid scan() {\n    int n, t;\n    cin >> n >> t;\n    vector<string> s1(n), s2(n);\n    for(int i = 0;i < n;i++)\n        cin >> s1[i];\n\n    for(int i = 0;i < n;i++)\n        cin >> s2[i];\n\n    int x_reac, y_reac;\n    for(int i = 0;i < n;i++) {\n        for(int j = 0;j < n;j++) {\n            if (s1[i][j] == 'Z') {\n                x_reac = i;\n                y_reac = j;\n            }\n        }\n    }\n\n    vector<vector<int>> reac = bfs(x_reac, y_reac, s1);\n\n\n    for(int i = 0;i < n;i++) {\n        for(int j = 0;j < n;j++) {\n            if (!check(i, j, s1)) continue;\n            vector<vector<int>> a = bfs(i, j, s1);\n\n            for(int x = 0;x < n;x++) {\n                for(int y = 0;y < n;y++) {\n                    if (!check(x, y, s1) || a[x][y] > t || a[x][y] > reac[x][y]) continue;\n\n                    if (a[x][y] == reac[x][y]) {\n                        bool good = false;\n                        for(int id = 0;id < 4;id++) {\n                            int xto = x + xdir[id];\n                            int yto = y + ydir[id];\n                            if (!check(xto, yto, s1) ||  a[xto][yto] >= reac[xto][yto]) continue;\n                            good = true;\n                        }\n                        if (!good) continue;\n                    }\n\n\n                    for(int num1 = 1;num1 <= s1[i][j] - '0';num1++) {\n                        for(int num2 = 1;num2 <= s2[x][y] - '0';num2++) {\n                            gr[10 * (j + i * 10) + num1].emplace_back(10 * (y + 10 * x) + num2);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\nbool kuhn(int v) {\n    if (used[v]) return false;\n    used[v] = true;\n    for(int to : gr[v]) {\n        if (pa[to] == 0 || kuhn(pa[to])) {\n            pa[to] = v;\n            return true;\n        }\n    }\n    return false;\n}\n\n\nvoid solve() {\n    scan();\n\n\n    int n = max_n;\n\n    for(int i = 0;i < n;i++) {\n        kuhn(i);\n        for(int j = 0;j < n;j++)\n            used[j] = false;\n    }\n\n    int res = 0;\n    for(int i = 0;i < n;i++) res += pa[i] != 0;\n\n    cout << res;\n}\n\n\n\nsigned main() {\n    cin.tie(0);\n    cout.tie(0);\n    ios_base::sync_with_stdio(0);\n    cout.precision(10);\n\n    solve();\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ninf = 10**17 + 7\nmax_n = 1001\n\nxdir = [0, 0, -1, 1]\nydir = [-1, 1, 0, 0]\n\ngr = [[] for _ in range(max_n)]\nused = [False] * max_n\npa = [0] * max_n\n\ndef check(x, y, s):\n    return 0 <= x < len(s) and 0 <= y < len(s) and s[x][y] not in ('Y', 'Z')\n\ndef bfs(st_x, st_y, s):\n    n = len(s)\n    res = [[inf] * n for _ in range(n)]\n    res[st_x][st_y] = 0\n    b = deque()\n    b.append((st_x, st_y))\n    \n    while b:\n        v = b.popleft()\n        for i in range(4):\n            x = v[0] + xdir[i]\n            y = v[1] + ydir[i]\n            if not check(x, y, s) or res[x][y] != inf:\n                continue\n            res[x][y] = res[v[0]][v[1]] + 1\n            b.append((x, y))\n    \n    return res\n\ndef scan():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    s1 = []\n    s2 = []\n    for _ in range(n):\n        s1.append(next(it))\n    for _ in range(n):\n        s2.append(next(it))\n    \n    x_reac, y_reac = -1, -1\n    for i in range(n):\n        for j in range(n):\n            if s1[i][j] == 'Z':\n                x_reac, y_reac = i, j\n                break\n    \n    reac = bfs(x_reac, y_reac, s1)\n    \n    for i in range(n):\n        for j in range(n):\n            if not check(i, j, s1):\n                continue\n            a = bfs(i, j, s1)\n            \n            for x in range(n):\n                for y in range(n):\n                    if not check(x, y, s1) or a[x][y] > t or a[x][y] > reac[x][y]:\n                        continue\n                    \n                    if a[x][y] == reac[x][y]:\n                        good = False\n                        for id in range(4):\n                            xto = x + xdir[id]\n                            yto = y + ydir[id]\n                            if not check(xto, yto, s1) or a[xto][yto] >= reac[xto][yto]:\n                                continue\n                            good = True\n                        if not good:\n                            continue\n                    \n                    num1_max = int(s1[i][j]) - ord('0')\n                    num2_max = int(s2[x][y]) - ord('0')\n                    for num1 in range(1, num1_max + 1):\n                        for num2 in range(1, num2_max + 1):\n                            idx1 = 10 * (j + i * 10) + num1\n                            idx2 = 10 * (y + 10 * x) + num2\n                            gr[idx1].append(idx2)\n\ndef kuhn(v):\n    if used[v]:\n        return False\n    used[v] = True\n    for to in gr[v]:\n        if pa[to] == 0 or kuhn(pa[to]):\n            pa[to] = v\n            return True\n    return False\n\ndef solve():\n    scan()\n    \n    n = max_n\n    for i in range(n):\n        kuhn(i)\n        for j in range(n):\n            used[j] = False\n    \n    res = sum(1 for i in range(n) if pa[i] != 0)\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022384998737834394, -1.5497195136049413e-06, -2.3841855067985307e-07, -0.026813078671693802, -0.008814118802547455, -8.344646857949556e-07, -0.004098587669432163, -7.271502545336261e-05, -8.344646857949556