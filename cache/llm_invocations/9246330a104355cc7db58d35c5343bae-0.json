;\n\t\t\ttmp=C(i,cur1);\t\n\t\t\trep(j,0,up){\n\t\t\t\tdp[i][j+1]=(dp[i][j+1]+1ll*dp[cur2][j]*tmp)%mod;\t\t\t\t\t\t\n\t\t\t}\n\t\t\tif(k==0)\tbreak;\n\t\t}\n\t}\n\trep(j,1,min(cnt[n],K))\tans=(ans+1ll*dp[n][j]*C(K,j)%mod*cj[j])%mod;\n\tans=(power(K,n)-ans+mod)%mod;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn, K, mod = map(int, input().split())\n\ndef power(x, y):\n    ret = 1\n    while y:\n        if y & 1:\n            ret = (ret * x) % mod\n        x = (x * x) % mod\n        y >>= 1\n    return ret\n\ndef C(i, j):\n    return (cj[i] * inv[j] % mod) * inv[i - j] % mod\n\n# Initialization\nif n & 1:\n    print(power(K, n))\n    exit()\n\ncj = [1] * (n + 1)\nfor i in range(1, n + 1):\n    cj[i] = (cj[i - 1] * i) % mod\n\ninv = [1] * (n + 1)\ninv[n] = power(cj[n], mod - 2)\nfor i in range(n - 1, 0, -1):\n    inv[i] = (inv[i + 1] * (i + 1)) % mod\n# inv[0] remains 1\n\ncnt = [0] * (n + 1)\nmx = [0] * (n + 1)\nfor i in range(1, n + 1):\n    for j in range(19):\n        if (1 << j) & i:\n            cnt[i] += 1\n\nfor i in range(1, n + 1):\n    for j in reversed(range(20)):\n        if (1 << j) & i:\n            mx[i] = 1 << j\n            break\n\ndp = [[0] * (K + 2) for _ in range(n + 1)]\ndp[0][0] = 1\n\nans = 0\nfor i in range(1, n + 1):\n    if (n & i) != i:\n        continue\n    now = i ^ mx[i]\n    k = now\n    while True:\n        cur1 = k + mx[i]\n        cur2 = i ^ cur1\n        up = min(K - 1, cnt[cur2])\n        tmp = C(i, cur1)\n        for j in range(up + 1):\n            dp[i][j + 1] = (dp[i][j + 1] + dp[cur2][j] * tmp) % mod\n        if k == 0:\n            break\n        k = (k - 1) & now\n\nfor j in range(1, min(cnt[n], K) + 1):\n    ans = (ans + dp[n][j] * C(K, j) % mod * cj[j]) % mod\n\nans = (power(K, n) - ans) % mod\nprint(a