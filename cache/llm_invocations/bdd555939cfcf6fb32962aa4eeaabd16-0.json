rtices, 1, cost);\n                connectNodes(v + (layer - 1) * numVertices, u + (layer - 1) * numVertices + numVertices, 1, cost);\n            }\n        }\n    }\n    \n    for (int node = 0; node < numVertices; node++) {\n        for (int layer = 1; layer <= 100; layer++) {\n            connectNodes(node + (layer - 1) * numVertices, node + (layer - 1) * numVertices + numVertices, numCommodities, 0);\n        }\n    }\n    \n    long long totalCost = 0;\n    for (int i = 0; i < numCommodities; i++) {\n        if (computeShortestPath(source, sink)) {\n            totalCost += shortestDist[sink];\n        }\n    }\n    \n    cout << totalCost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass FlowEdge:\n    __slots__ = ('target', 'maxCap', 'currentFlow', 'unitCost')\n    def __init__(self, target, maxCap, currentFlow, unitCost):\n        self.target = target\n        self.maxCap = maxCap\n        self.currentFlow = currentFlow\n        self.unitCost = unitCost\n\nMAX_VERTEX = 10000\nINFINITY = 10**18\n\nflowEdges = []\nadjacencyList = [[] for _ in range(MAX_VERTEX)]\nshortestDist = [INFINITY] * MAX_VERTEX\npredecessorNode = [-1] * MAX_VERTEX\npredecessorEdge = [-1] * MAX_VERTEX\nvisitedQueue = [False] * MAX_VERTEX\n\ndef connectNodes(from_node, to_node, capacity, cost):\n    idx1 = len(flowEdges)\n    flowEdges.append(FlowEdge(to_node, capacity, 0, cost))\n    adjacencyList[from_node].append(idx1)\n    \n    idx2 = len(flowEdges)\n    flowEdges.append(FlowEdge(from_node, 0, 0, -cost))\n    adjacencyList[to_node].append(idx2)\n\ndef computeShortestPath(source, sink):\n    global shortestDist, predecessorNode, predecessorEdge, visitedQueue\n    \n    shortestDist = [INFINITY] * MAX_VERTEX\n    predecessorNode = [-1] * MAX_VERTEX\n    predecessorEdge = [-1] * MAX_VERTEX\n    vis