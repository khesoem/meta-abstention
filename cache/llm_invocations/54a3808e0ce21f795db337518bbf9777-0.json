           }\n            }\n        }\n    }\n    return DIST[dst] < 1000000000;\n}\n\nvoid push_flow(int src, int dst) {\n    for (int node = dst; node != src; node = EDGES[PREV_E[node] ^ 1].TO) {\n        EDGES[PREV_E[node]].CAP--;\n        EDGES[PREV_E[node] ^ 1].CAP++;\n    }\n    COST_SUM += DIST[dst];\n}\n\nint main() {\n    memset(HEAD, -1, sizeof(HEAD));\n    scanf(\"%d %d %d %d %d\", &N, &M, &K, &C, &D);\n    int SOURCE = 0, SINK = 6000;\n    for (int i = 1; i <= K; i++) {\n        scanf(\"%d\", &ARR[i]);\n        connect(SOURCE, encode(0, ARR[i]), 1, 0);\n    }\n    for (int i = 1; i <= M; i++) {\n        scanf(\"%d %d\", &U[i], &V_ARR[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= N; i++) {\n            connect(encode(t, i), encode(t + 1, i), K, C);\n        }\n        connect(encode(t, 1), SINK, K, 0);\n        for (int i = 1; i <= M; i++) {\n            int limit = min(K, 25);\n            for (int j = 1; j <= limit; j++) {\n                int cost = C + (2 * j - 1) * D;\n                connect(encode(t, U[i]), encode(t + 1, V_ARR[i]), 1, cost);\n                connect(encode(t, V_ARR[i]), encode(t + 1, U[i]), 1, cost);\n            }\n        }\n    }\n    while (find_path(SOURCE, SINK)) push_flow(SOURCE, SINK);\n    printf(\"%d\\n\", COST_SUM);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_V = 6010;\n    static final int INF = 0x3f3f3f3f;\n    static int N, M, K, C, D, EIDX, COST_SUM;\n    static int[] ARR = new int[6010];\n    static int[] U = new int[6010];\n    static int[] V_ARR = new int[6010];\n    static int[] HEAD = new int[MAX_V];\n    static int[] PREV_E = new int[MAX_V];\n    static int[] DIST = new int[MAX_V];\n    static int[] INQ = new int[MAX_V];\n    static Queue<Integer> Q = new LinkedList<>();\n    \n    static class Edge {\n        int TO, CAP, COST, NXT;\n        Edge(int to, int cap, int cost, int nxt) {\n            TO = to;\n            CAP = cap;\n            COST = cost;\n            NXT = nxt;\n        }\n    }\n    \n    static Edge[] EDGES = new Edge[2000010];\n    \n    static int encode(int t, int v) {\n        return t * N + v;\n    }\n    \n    static void connect(int from, int to, int cap, int cost) {\n        EDGES[EIDX] = new Edge(to, cap, cost, HEAD[from]);\n        HEAD[from] = EIDX++;\n        EDGES[EIDX] = new Edge(from, 0, -cost, HEAD[to]);\n        HEAD[to] = EIDX++;\n    }\n    \n    static boolean find_path(int src, int dst) {\n        Arrays.fill(DIST, INF);\n        Q.clear();\n        Q.add(src);\n        DIST[src] = 0;\n        while (!Q.isEmpty()) {\n            int cur = Q.poll();\n            INQ[cur] = 0;\n            for (int i = HEAD[cur]; i != -1; i = EDGES[i].NXT) {\n                int nxt = EDGES[i].TO;\n                if (EDGES[i].CAP > 0 && DIST[nxt] > DIST[cur] + EDGES[i].COST) {\n                    DIST[nxt] = DIST[cur] + EDGES[i].COST;\n                    PREV_E[nxt] = i;\n                    if (INQ[nxt] == 0) {\n                        Q.add(nxt);\n                        INQ[nxt] = 1;\n                    }\n                }\n            }\n        }\n        return DIST[dst] < 1000000000;\n    }\n    \n    static void push_flow(int src, int dst) {\n        for (int node = dst; node != src; node = EDGES[PREV_E[node] ^ 1].TO) {\n            EDGES[PREV_E[node]].CAP--;\n            EDGES[PREV_E[node] ^ 1].CAP++;\n        }\n        COST_SUM += DIST[dst];\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n        \n        Arrays.fill(HEAD, -1);\n        EIDX = 0;\n        COST_SUM = 0;\n        \n        int SOURCE = 0;\n        int SINK = 6000;\n        \n        for (int i = 1; i <= K; i++) {\n            ARR[i] = sc.nextInt();\n            connect(SOURCE, encode(0, ARR[i]), 1, 0);\n        }\n        \n        for (int i = 1; i <= M; i++) {\n            U[i] = sc.nextInt();\n            V_ARR[i] = sc.nextInt();\n        }\n        \n        for (int t = 0; t <= 100; t++) {\n            for (int i = 2; i <= N; i++) {\n                connect(encode(t, i), encode(t + 1, i), K, C);\n            }\n            connect(encode(t, 1), SINK, K, 0);\n            for (int i = 1; i <= M; i++) {\n                int limit = Math.min(K, 25);\n                for (int j = 1; j <= limit; j++) {\n                    int cost = C + (2 * j - 1) * D;\n                    connect(encode(t, U[i]), encode(t + 1, V_ARR[i]), 1, cost);\n                    connect(encode(t, V_ARR[i]), encode(t + 1, U[i]), 1, cost);\n                }\n            }\n        }\n        \n        while (find_path(SOURCE, SINK)) {\n            push_flow(SOURCE, SINK);\n        }\n        \n        System.out.println(COST_SUM);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011062010162277147, -1.9073468138230965e-06, -1.311301275563892e-06, -0.0010795724811032414, -3.349725011503324e-05, -0.01251133717596531, -0.023428287357091904, -3.3378546504536644e-06, -3.576278118089249e-07, -6.603976362384856e-05, -0.001033010776154697, -2.622600959512056e-06, -0.0071679335087537766, -0.0003299168893136084, -3.576278118089249e-07, -3.3378546504536644e-06, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.014172028750181198, -1.4305104514278355e-06, 0.0, -1.5258672647178173e-05, -5.960462772236497e-07, -8.940656698541716e-06, -4.768370445162873e-07, -1.5497195136049413e-06, -1.1920928244535389e-07, -3.5523738915799186e-05, -2.3841855067985307e-07, -8.106198947643861e-06, 0.0, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -2.145764938177308