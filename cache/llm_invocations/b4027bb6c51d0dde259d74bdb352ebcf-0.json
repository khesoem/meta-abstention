n\n    static boolean dijkstra(int s, int t, int[] pot, int[] dist, int[] prev, int[] preve) {\n        Arrays.fill(dist, INF);\n        dist[s] = 0;\n        PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n        pq.offer(new int[]{0, s});\n        while (!pq.isEmpty()) {\n            int[] cur = pq.poll();\n            int d = cur[0], v = cur[1];\n            if (dist[v] < d) continue;\n            for (int e = head[v]; e != -1; e = nxt[e]) {\n                if (cap[e] <= 0) continue;\n                int nd = d + cost[e] + pot[v] - pot[to[e]];\n                if (dist[to[e]] > nd) {\n                    dist[to[e]] = nd;\n                    prev[to[e]] = v;\n                    preve[to[e]] = e;\n                    pq.offer(new int[]{nd, to[e]});\n                }\n            }\n        }\n        return dist[t] != INF;\n    }\n\n    static int minCostFlow(int s, int t, int n) {\n        int[] pot = new int[n];\n        bellmanFord(s, pot);\n        int[] dist = new int[n], prev = new int[n], preve = new int[n];\n        int totalCost = 0;\n        while (true) {\n            if (!dijkstra(s, t, pot, dist, prev, preve)) break;\n            for (int i = 0; i < n; i++) {\n                if (dist[i] < INF) pot[i] += dist[i];\n            }\n            int add = INF;\n            for (int v = t; v != s; v = prev[v]) {\n                add = Math.min(add, cap[preve[v]]);\n            }\n            for (int v = t; v != s; v = prev[v]) {\n                int e = preve[v];\n                cap[e] -= add;\n                cap[e ^ 1] += add;\n            }\n            totalCost += add * (pot[t] - pot[s]);\n        }\n        return totalCost;\n    }\n\n    public static void main(String[] args) throws IOException {\n        byte[] all = System.in.readAllBytes();\n        String data = new String(all, StandardCharsets.UTF_8).trim();\n        String[] tokens = data.split(\"\\\\s+\");\n        int idx = 0;\n\n        int n = Inte