onent >>= 1;\n        }\n        return result;\n    }\n\n    private static void process() {\n        initialize();\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        long k = scanner.nextLong();\n        if (k == 0) {\n            System.out.println(factorial[n]);\n            return;\n        }\n        if (n <= k) {\n            System.out.println(0);\n            return;\n        }\n        long combinations = binomial(n, (int)k);\n        int columns = n - (int)k;\n        long sum = 0;\n        for (int i = 0; i <= columns; i++) {\n            long term = binomial(columns, i) * modPow(columns - i, n) % MOD;\n            if ((i & 1) == 1) {\n                sum = (sum - term + MOD) % MOD;\n            } else {\n                sum = (sum + term) % MOD;\n            }\n        }\n        long answer = (2 * ((combinations * sum) % MOD)) % MOD;\n        System.out.println(answer);\n    }\n\n    public static void main(String[] args) {\n        process();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\nMAX = 400010\n\nfactorial = None\ninverseFactorial = None\n\ndef mod_pow(base, exponent):\n    result = 1\n    base %= MOD\n    while exponent > 0:\n        if (exponent & 1) == 1:\n            result = (result * base) % MOD\n        base = (base * base) % MOD\n        exponent >>= 1\n    return result\n\ndef initialize():\n    global factorial, inverseFactorial\n    factorial = [0] * MAX\n    inverseFactorial = [0] * MAX\n    factorial[0] = 1\n    inverseFactorial[0] = 1\n    for i in range(1, MAX):\n        factorial[i] = (factorial[i-1] * i) % MOD\n        inverseFactorial[i] = mod_pow(factorial[i], MOD - 2)\n\ndef binomial(n, r):\n    if r < 0 or r > n:\n        return 0\n    return (factorial[n] * inverseFactorial[r] % MOD) * inverseFactorial[n - r] % MOD\n\ndef p