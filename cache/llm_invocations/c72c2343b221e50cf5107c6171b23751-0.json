\nINF = 10**18\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_edge(graph, fr, to, cap, cost):\n    graph[fr].append(Edge(to, len(graph[to]), cap, cost))\n    graph[to].append(Edge(fr, len(graph[fr])-1, 0, -cost))\n\ndef min_cost_flow(graph, s, t, maxf=INF):\n    n = len(graph)\n    flow = 0\n    cost = 0\n    while flow < maxf:\n        dist = [INF]*n\n        inqueue = [False]*n\n        prevv = [-1]*n\n        preve = [-1]*n\n        dist[s] = 0\n        q = deque([s])\n        inqueue[s] = True\n        while q:\n            v = q.popleft()\n            inqueue[v] = False\n            for i, e in enumerate(graph[v]):\n                if e.cap > 0 and dist[e.to] > dist[v] + e.cost:\n                    dist[e.to] = dist[v] + e.cost\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    if not inqueue[e.to]:\n                        q.append(e.to)\n                        inqueue[e.to] = True\n        if dist[t] == INF:\n            break\n        d = maxf - flow\n        v = t\n        while v != s:\n            d = min(d, graph[prevv[v]][preve[v]].cap)\n            v = prevv[v]\n        flow += d\n        cost += d * dist[t]\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            e.cap -= d\n            graph[v][e.rev].cap += d\n            v = prevv[v]\n    return flow, cost\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    B = max(n, k)\n    # total number of layers: 0 .. 2*B (inclusive)\n    # node numbering: layer o (0-indexed), node i (1-indexed) -> o*n + i\n    # source s, sink t\n    s = n * (B * 2 + 1) + 1\n    t = s + 1\n    V = t + 1  # nodes 1..t, index 0 unused\n    graph = [[] for _ in range(V)]\n    \n    # start positions\n    for _ in range(k):\n        x = int(next(it))\n        add_edge(graph, s, x, 1, 0)  # layer 0, node x\n    \n    # connect last layer node 1 to sink\n    add_edge(graph, n * (B * 2) + 1, t, INF, 0)\n    \n    # vertical edges (stay in place)\n    for o in range(B * 2):\n        # node 1 moves freely\n        add_edge(graph, o * n + 1, (o + 1) * n + 1, INF, 0)\n        # other nodes move at cost c\n        for i in range(2, n + 1):\n            add_edge(graph, o * n + i, (o + 1) * n + i, INF, c)\n    \n    # read edges and add movement edges\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        for o in range(B * 2):\n            for i in range(1, k + 1):\n                cost_edge = d * (2 * i - 1) + c\n                add_edge(graph, o * n + x, (o + 1) * n + y, 1, cost_edge)\n                add_edge(graph, o * n + y, (o + 1) * n + x, 1, cost_edge)\n    \n    # run min-cost max-flow\n    _, mincost = min_cost_flow(graph, s, t)\n    sys.stdout.write(str(mincost) + '\\n')\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0007176207727752626, 0.0, -4.768370445162873e-07, -0.0009240409708581865, -0.001639452064409852, -4.768370445162873e-07, -3.0278701160568744e-05, -8.535020606359467e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -1.6689286894688848e-06, -0.006760462652891874, -0.27466875314712524, -0.00011216964776394889, -7.867782187531702e-06, -0.0009146321099251509, -0.20141606032848358, -0.001927543431520462, -0.0011124381562694907, -0.10631154477596283, -0.06504058092832565, -2.264974000354414e-06, -4.291525328881107e-06, -0.048596981912851334, -1.1920928244535389e-07, -3.576278118089249e-07, -2.861018856492592e-06, -1.3470558769768104e-05, -0.006415012292563915, -4.887569048150908e-06, -0.0011703077470883727, -1.1920928244535389e-07, -1.0132738680113107e-05, -9.536738616588991e-07