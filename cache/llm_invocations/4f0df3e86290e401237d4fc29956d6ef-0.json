rn memo[K][N];\n\n        ull cur = 0;\n        int cnt = 0;\n        for (int sub = N & (N - 1); sub; sub = N & (sub - 1)) {\n            if (pc[sub] >= K - 1) {\n                cur += dfs(K - 1, sub) * invfact[N ^ sub];\n                if (++cnt == 18) {\n                    cnt = 0;\n                    cur %= p;\n                }\n            }\n        }\n        return memo[K][N] = cur % p;\n    }\n\n    void run() {\n#ifndef ONLINE_JUDGE\n        freopen(\"255x.in\", \"r\", stdin);\n        freopen(\"255x.out\", \"w\", stdout);\n#endif\n\n        n = fast_read();\n        k = fast_read();\n        p = fast_read();\n\n        for (int i = 1; i <= n; ++i) pc[i] = pc[i >> 1] + (i & 1);\n\n        ull powv = mod_pow(k, n);\n        if (n & 1) {\n            printf(\"%d\\n\", powv);\n            return;\n        }\n\n        lim = min(k, pc[n]);\n\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i % p;\n\n        invfact[n] = mod_pow(fact[n], p - 2);\n        for (int i = n; i >= 1; --i) invfact[i - 1] = invfact[i] * i % p;\n\n        ull total = 0;\n        for (int i = lim; i >= 1; --i) total += comb(k, i) * dfs(i, n);\n\n        ull ans = (powv - total % p * fact[n] % p + p) % p;\n        printf(\"%lld\\n\", ans);\n    }\n};\n\nint main() {\n    static Solver solver;\n    solver.run();\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 250010;\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br