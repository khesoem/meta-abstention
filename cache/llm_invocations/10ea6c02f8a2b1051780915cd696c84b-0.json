is;\n\t}\n\tModNum& operator /= (const ModNum& o) {\n\t\treturn *this *= (~o);\n\t}\n\n\tfriend ModNum operator + (const ModNum& a, const ModNum& b) { return ModNum(a) += b; }\n\tfriend ModNum operator - (const ModNum& a, const ModNum& b) { return ModNum(a) -= b; }\n\tfriend ModNum operator * (const ModNum& a, const ModNum& b) { return ModNum(a) *= b; }\n\tfriend ModNum operator / (const ModNum& a, const ModNum& b) { return ModNum(a) /= b; }\n};\n\nusing num = ModNum<int(1e9) + 7>;\n\nint main() {\n\tios_base::sync_with_stdio(false);\n\tcin.tie(nullptr);\n\tcout.tie(nullptr);\n\n\tconst int N = 6;\n\tvector<vector<num>> prob(N, vector<num>(N, 0));\n\tint read_n;\n\tcin >> read_n;\n\tfor (int i = 0; i < N; i++) prob[i][i] = 1;\n\tfor (int i = 0; i < read_n; i++) {\n\t\tfor (int j = 0; j < read_n; j++) {\n\t\t\tint a;\n\t\t\tcin >> a;\n\t\t\tprob[i][j] = num(a) / num(100);\n\t\t}\n\t}\n\n\tconst int F = 20;\n\tvector<vector<num>> dp(2, vector<num>(1 << F, 0));\n\tvector<vector<int>> msk(2);\n\tfor (int i = 0; i < N; i++) {\n\t\tfor (int j = 0; j < i; j++) {\n\t\t\tfor (int k = 0; k < j; k++) {\n\t\t\t\tmsk[0].push_back((1 << i) ^ (1 << j) ^ (1 << k));\n\t\t\t\tmsk[1].push_back(((1 << N) - 1) ^ msk[0].back());\n\t\t\t}\n\t\t}\n\t}\n\tassert(F == (int)msk[0].size());\n\n\tfor (int t = 0; t < 2; t++) {\n\t\tfor (int e = 0; e < (1 << (N / 2 * N)); e++) {\n\t\t\tnum pval = 1;\n\t\t\tint edges[N / 2];\n\t\t\tfor (int i = 0; i < N / 2; i++) edges[i] = 0;\n\t\t\tfor (int i = 0; i < N / 2 * N; i++) {\n\t\t\t\tbool bit = (e >> i) & 1;\n\t\t\t\tnum pp = prob[(i / N) * 2 + t][i % N];\n\t\t\t\tpval *= bit ? pp : (1 - pp);\n\t\t\t\tedges[i / N] |= int(bit) << (i % N);\n\t\t\t}\n\t\t\tint wmask = 0;\n\t\t\tfor (int a = 0; a < (int)msk[t].size(); a++) {\n\t\t\t\tint mask = msk[t][a];\n\t\t\t\tint r[N / 2];\n\t\t\t\tfor (int i = 0; i < N / 2; i++) r[i] = edges[i] & mask;\n\t\t\t\tif (r[0] && r[1] && r[2]) {\n\t\t\t\t\tif (__builtin_popcount(r[0] | r[1] | r[2]) == 3) {\n\t\t\t\t\t\tint