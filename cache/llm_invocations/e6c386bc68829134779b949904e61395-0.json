 = parent_edge[cur]\n            self.edges[eid][2] += 1  # flow++\n            rev_eid = self.edges[eid][4]\n            self.edges[rev_eid][2] -= 1  # flow--\n            cur = parent[cur]\n\n        self.total += dist[self.SINK]\n\n    def cost(self):\n        return self.total\n\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    solver = MinCostFlow()\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        solver.add_edge(MinCostFlow.SOURCE, x, 1, 0)\n\n    TT = 101\n\n    for i in range(TT):\n        solver.add_edge(i * n, MinCostFlow.SINK, k, i * c)\n\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for t in range(TT - 1):\n            for j in range(k):\n                solver.add_edge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1))\n        for t in range(TT - 1):\n            for j in range(k):\n                solver.add_edge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1))\n\n    for i in range(n):\n        for j in range(TT - 1):\n            solver.add_edge(i + j * n, i + j * n + n, k, 0)\n\n    for _ in range(k):\n        solver.augment()\n\n    print(solver.cost())\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.0002865380665753037, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.00052426423644647, -0.07996032387018204, -1.1920928244535389e-07, -8.34461570775602e-06, -8.344646857949556e-07, 0.0, -2.3841855067985307e-07, 0.0, -0.0005822870298288763, -3.3378546504536644e-06, 0.0, 0.0, 0.0, -6.794906312279636e-06, -2.3841855067985307e-07, -3.099436753473128e-06, -2.622600959512056e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -2.145764938177308e-06, -1.311301275563892e-06, -1.585470999998506e-05, 0.0, -4.887569048150908e-06, 0.0, 0.0, -2.1457441107486375e-05, 0.0, -8.344646