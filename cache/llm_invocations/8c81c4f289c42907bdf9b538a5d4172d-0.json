i value = (term1 + term2 - term3) % MOD_Q;\n    if (value < 0) value += MOD_Q;\n    return (int)value;\n}\n\nvoid traverse_and_compute(int depth, lli current_value) {\n    if (current_value > N) return;\n    if (depth >= 1) {\n        if (current_value * BLOCK_SIZE > N / 10 && current_value * BLOCK_SIZE + BLOCK_SIZE - 1 <= N) {\n            int multiplier = 1;\n            for (int i = 0; i <= 6; ++i) {\n                final_result = (final_result + compute_contribution(i, (int)mod_p(global_counter - current_value * multiplier))) % (int)MOD_Q;\n                multiplier *= 10;\n            }\n            for (int i = 0; i <= 6; ++i) {\n                global_counter += digit_buckets[i].size();\n            }\n            return;\n        }\n        final_result = (final_result + (int)mod_p(++global_counter - current_value)) % (int)MOD_Q;\n    }\n    int first_digit = (depth == 0) ? 1 : 0;\n    for (int digit = first_digit; digit <= 9; ++digit) {\n        traverse_and_compute(depth + 1, current_value * 10 + digit);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N;\n    build_digit_buckets(0, 0);\n    for (int i = 0; i <= 6; ++i) {\n        sort(digit_buckets[i].begin(), digit_buckets[i].end());\n        for (int val : digit_buckets[i]) {\n            prefix_sums[i] += val;\n        }\n    }\n    global_counter = 0;\n    traverse_and_compute(0, 0);\n    cout << final_result << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD_P = 998244353\nMOD_Q = 1000000007\nBLOCK_SIZE = 1000000\n\ndef mod_p(x):\n    x %= MOD_P\n    return x if x >= 0 else x + MOD_P\n\ndef main():\n    input_data = sys.stdin.read().split()\n    N = int(input_data[0])\n    \n    digit_buckets = [[] for _ in range(7)]\n    global_counter = [0]\n    final_result = [0]\n    prefix_sums 