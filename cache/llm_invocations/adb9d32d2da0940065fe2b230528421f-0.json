s[v]) dis[v]=dis[u]+w,q.push(node(v,dis[v]));\n            }\n        }\n        for(int i=1;i<=all;i++) tag[i]=min(tag[i]+dis[i],winf);\n        if(!vis[s]) return false;\n        for(int i=1;i<=all;i++) vis[i]=false;\n        return true;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && tag[v]+r[i].w==tag[u] && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(dij(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*tag[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int N = 100010;\n    static final int M = 1000010;\n    static final int inf = 1000000000;\n    static final int winf = 1000000000;\n\n    static class Road {\n        int nxt, to, f;\n        long w;\n        Road(int nxt, int to, int f, long w) {\n            this.nxt = nxt;\n            this.to = to;\n            this.f = f;\n            this.w = w;\n        }\n    }\n\n    static Road[] r = new Road[M << 1];\n    static int[] head = new int[N];\n    static int cnt = 1;\n    static int all;\n\n    static void add(int u, int v, int f, long w) {\n        r[++cnt] = new Road(head[u], v, f, w);\n        head[u] = cnt;\n        r[++cnt] = new Road(head[v], u, 0, -w);\n        head[v] = cnt;\n    }\n\n    static class MinCostFlow {\n        static int[] cur = new int[N];\n        static boolean[] vis = new boolean[N];\n        static long[] dis = new long[N];\n        static long[] tag = new long[N];\n        static int maxf;\n        static long minw;\n\n        static class Node implements Comparable<Node> {\n            int u;\n            long v;\n            Node(int U, long V) {\n                u = U;\n                v = V;\n            }\n            @Override\n            public int compareTo(Node a) {\n                return Long.compare(v, a.v);\n            }\n        }\n\n        static boolean dij(int s, int t, int n) {\n            for (int i = 1; i <= n; i++) {\n                dis[i] = winf;\n                cur[i] = head[i];\n            }\n            dis[t] = 0;\n            PriorityQueue<Node> q = new PriorityQueue<>();\n            q.add(new Node(t, 0));\n            while (!q.isEmpty()) {\n                int u = q.poll().u;\n                if (vis[u]) continue;\n                vis[u] = true;\n                for (int i = head[u]; i != 0; i = r[i].nxt) {\n                    int v = r[i].to;\n                    long w = tag[u] + r[i ^ 1].w - tag[v];\n                    if (r[i ^ 1].f > 0 && dis[u] + w < dis[v]) {\n                        dis[v] = dis[u] + w;\n                        q.add(new Node(v, dis[v]));\n                    }\n                }\n            }\n            for (int i = 1; i <= n; i++) {\n                tag[i] = Math.min(tag[i] + dis[i], winf);\n            }\n            if (!vis[s]) return false;\n            for (int i = 1; i <= n; i++) vis[i] = false;\n            return true;\n        }\n\n        static int dfs(int u, int t, int fl) {\n            if (u == t || fl == 0) return fl;\n            int res = 0;\n            vis[u] = true;\n            for (int i = cur[u]; i != 0; i = r[i].nxt) {\n                cur[u] = i;\n                if (r[i].f > 0) {\n                    int v = r[i].to;\n                    int f;\n                    if (!vis[v] && tag[v] + r[i].w == tag[u] && (f = dfs(v, t, Math.min(fl, r[i].f))) > 0) {\n                        r[i].f -= f;\n                        r[i ^ 1].f += f;\n                        res += f;\n                        fl -= f;\n                        if (fl == 0) break;\n                    }\n                }\n            }\n            vis[u] = false;\n            return res;\n        }\n\n        static void work(int s, int t, int n) {\n            while (dij(s, t, n)) {\n                int w = dfs(s, t, inf);\n                maxf += w;\n                minw += (long) w * tag[s];\n            }\n        }\n    }\n\n    static int ss = 1, tt = 2;\n    static int n, m, k, c, d;\n    static List<Integer>[] g = new ArrayList[N];\n\n    static int id(int t, int x) {\n        return t * n + x + 2;\n    }\n\n    static void work(int t) {\n        all += n;\n        for (int u = 1; u <= n; u++) {\n            for (int v : g[u]) {\n                for (int p = 1; p <= k; p++) {\n                    add(id(t, u), id(t + 1, v), 1, d * (2L * p - 1));\n                }\n            }\n        }\n        for (int u = 1; u <= n; u++) {\n            add(id(t, u), id(t + 1, u), inf, 0);\n        }\n        add(id(t + 1, 1), tt, inf, c * (t + 1));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        for (int i = 1; i < N; i++) {\n            g[i] = new ArrayList<>();\n        }\n\n        all = n + 2;\n\n        for (int i = 1; i <= k; i++) {\n            int a = sc.nextInt();\n            add(ss, id(0, a), 1, 0);\n        }\n\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            g[u].add(v);\n            g[v].add(u);\n        }\n\n        add(id(0, 1), tt, inf, 0);\n\n        for (int i = 0; i <= n + k; i++) {\n            work(i);\n        }\n\n        MinCostFlow.work(ss, tt, all);\n        System.out.println(MinCostFlow.minw);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013100242358632386, -1.9073468138230965e-06, -2.3841855067985307e-07, -0.006879453547298908, -4.303362584323622e-05, -0.3868773281574249, -0.20148330926895142, -2.2649508537142538e-05, -1.1920928244535389e-07, -3.981510963058099e-05, -0.004079354461282492, -6.437280717364047e-06, -0.000727627135347575, -0.11440344154834747, -1.1086402082582936e-05, -0.0013869914691895247, -5.960462772236497e-07, 0.0, 0.0, -4.768370445162873e-07, 0.0, -7.152555099310121e-07, -9.536738616588991e-07, 0.0, -1.311301275563892e-06, -2.264974000354414e-06, -7.152555099310121e-07, -1.5735502529423684e-05, -0.0002985746832564473, -2.1815061700181104e-05, -7.152555099310121e-07, 0.0, -3.5523738915799186e-05, 0.0, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -0.004621420055627823, -0.00018070495571009815, -2.7418097943154862e-06, -0.00018845213344320655, -0.006735715549439192, -0.01267778966575861, -3.576278118089249e-07, -8.106198947643861e-06, -3.576278118089249e-07, -2.753696753643453e-05, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -7.15255509