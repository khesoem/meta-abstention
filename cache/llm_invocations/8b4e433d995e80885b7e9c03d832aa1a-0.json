 Arrays.fill(d, INF);\n            Arrays.fill(inq, false);\n            d[s] = 0;\n            inq[s] = true;\n            p[s] = -1;\n            cap[s] = INF;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n                for (int idx : g[u]) {\n                    Edge ee = e.get(idx);\n                    if (ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost) {\n                        d[ee.to] = d[u] + ee.cost;\n                        p[ee.to] = idx;\n                        cap[ee.to] = Math.min(cap[u], ee.cap - ee.flow);\n                        if (!inq[ee.to]) {\n                            q.add(ee.to);\n                        }\n                    }\n                }\n            }\n            if (d[t] == INF) {\n                return false;\n            }\n            flowCost[0] += cap[t];\n            flowCost[1] += d[t] * cap[t];\n            int u = t;\n            while (u != s) {\n                Edge ee = e.get(p[u]);\n                ee.flow += cap[t];\n            }\n            return true;\n        }\n\n        int minCost(int s, int t) {\n            int[] flowCost = new int[2];\n            while (bellman(s, t, flowCost));\n            return flowCost[1];\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int[] a = new int[k + 1];\n        st = new StringTokenizer(br.readLine());\n        for (int i = 1; i <= k; i++) {\n            a[i] = Integer.parseInt(st.nextToken());\n        }\n\n        int startPoint = 0;\n        int endPoint = n * 100 + 1;\n        MCMF solve = new MCMF();\n        solve.init(endPoint + 1);\n\n        for (int i = 1; i <= k; i++) {\n            solve.addEdge(startPoint, 1 + (a[i] - 1) * 100, 1, 0);\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                int p = (i - 1) * 100 + j;\n                solve.addEdge(p, p + 1, INF, c);\n            }\n        }\n\n        for (int i = 1; i <= 100; i++) {\n            solve.addEdge(i, endPoint, INF, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            for (int j = 1; j < 100; j++) {\n                int p = (x - 1) * 100 + j;\n                int pp = (y - 1) * 100 + j + 1;\n                for (int j2 = 1; j2 <= 50; j2++) {\n                    solve.addEdge(p, pp, 1, d * (j2 * j2 - (j2 - 1) * (j2 - 1)) + c);\n                }\n            }\n            for (int j = 1; j < 100; j++) {\n                int p = (y - 1) * 100 + j;\n                int pp = (x - 1) * 100 + j + 1;\n                for (int j2 = 1; j2 <= 50; j2++) {\n                    solve.addEdge(p, pp, 1, d * (j2 * j2 - (j2 - 1) * (j2 - 1)) + c);\n                }\n            }\n        }\n\n        System.out.println(solve.minCost(startPoint, endPoint));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.622600959512056e-06, 0.0, -1.1920928244535389e-07, -0.00020013237372040749, -8.427741704508662e-05, -3.576278118089249e-07, -0.07888996601104736, -0.2014683037996292, 0.0, 0.0, -2.3841830625315197e-06, -9.727005090098828e-05, -0.009197012521326542, -1.1920928244535389e-07, -0.0032820426858961582, -0.014271690510213375, -0.000556314189452678, -0.015879951417446136, -0.38903626799583435, -0.0005544078885577619, -0.0592