\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        if (line == null || line.trim().isEmpty()) {\n            return;\n        }\n        String[] parts = line.trim().split(\"\\\\s+\");\n        int n = Integer.parseInt(parts[0]);\n        int mod = Integer.parseInt(parts[1]);\n\n        if (n == 0) {\n            System.out.println(0);\n            return;\n        }\n        if (n == 1) {\n            System.out.println(1);\n            return;\n        }\n\n        int[] mem = new int[n + 1];\n        mem[0] = 0;\n        mem[1] = 1;\n        long su = 1; // sum of mem[0..1] mod mod\n\n        for (int i = 2; i <= n; i++) {\n            int sq = (int) Math.sqrt(i) + 1; // floor(sqrt(i)) + 1\n            long cur = su;\n\n            // first loop: large divisors (f from 2 to sq-1)\n            for (int f = 2; f < sq; f++) {\n                cur = (cur + mem[i / f]) % mod;\n            }\n\n            // second loop: small divisors (j from 1 to i/sq)\n            int be = i;\n            int limit = i / sq;\n            for (int j = 1; j <= limit; j++) {\n                int nxt = i / (j + 1);\n                cur = (cur + (long)(be - nxt) * mem[j]) % mod;\n                be = nxt;\n            }\n\n            su = (su + cur) % mod;\n            mem[i] = (int) cur;\n        }\n\n        System.out.println(mem[n]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.6689286894688848e-06, 0.0, 0.0, -6.282132380874828e-05, -7.950943836476654e-05, -1.1920928244535389e-07, -0.0031780709978193045, -0.6944369077682495, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.31326279044151306, -4.768370445162873e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -0.20142288506031036, -4.410734163684538e-06, -1.1920928244535389e-07, -0.0235641747713089, -0.0005545270396396518, -2.3126334