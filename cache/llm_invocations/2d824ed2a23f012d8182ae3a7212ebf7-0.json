h (IOException e) {\n                e.printStackTrace();\n            }\n            if (line == null) return \"\";\n            String[] tokens = line.trim().split(\"\\\\s+\");\n            return tokens.length > 0 ? tokens[0] : \"\";\n        }\n    }\n\n    public void run() {\n        InputReader sc = new InputReader();\n        PrintWriter out = new PrintWriter(System.out);\n\n        int n = sc.nextInt();\n        int k = sc.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        // Count total odd and even numbers\n        int totalOdd = 0, totalEven = 0;\n        for (int x : a) {\n            if (x % 2 == 1) totalOdd++;\n            else totalEven++;\n        }\n\n        // Each segment must have equal odd and even numbers\n        // So totalOdd must equal totalEven (given in problem)\n        // Maximum possible cuts = totalOdd (since each segment needs at least 1 odd and 1 even)\n        // We need to find positions where we can cut\n\n        // For each position i (between a[i-1] and a[i]), check if prefix [0..i-1] has equal odd and even\n        List<Integer> cutPositions = new ArrayList<>();\n        List<Integer> cutCosts = new ArrayList<>();\n\n        int oddCount = 0, evenCount = 0;\n        for (int i = 0; i < n - 1; i++) {\n            if (a[i] % 2 == 1) oddCount++;\n            else evenCount++;\n\n            if (oddCount == evenCount && oddCount > 0) {\n                // Can cut between a[i] and a[i+1]\n                cutPositions.add(i + 1);\n                cutCosts.add(Math.abs(a[i] - a[i + 1]));\n            }\n        }\n\n        // Now we want to select maximum number of cuts with total cost <= k\n        // This is a classic knapsack-like problem: select maximum items with total cost <= k\n        // Since we want maximum count, we should prefer cheaper cuts\n        Collections.sort(cutCosts);\n\n        int maxCuts = 0;\n        int totalCost = 0;\