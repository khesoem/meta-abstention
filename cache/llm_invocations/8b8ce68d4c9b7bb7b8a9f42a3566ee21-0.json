= n * n + i * n + j + 1\n                cap = int(b[i][j])\n                R[u][N-1] = cap\n                neigh[u].append(N-1)\n                neigh[N-1].append(u)\n\n    # Max flow using Dijkstra-like augmenting path (max capacity)\n    def getFlow():\n        F = [0]*N\n        P = [-1]*N\n        F[0] = Inf\n        pq = [(-Inf, 0)]  # max-heap via negative\n        while pq:\n            f_neg, v = heapq.heappop(pq)\n            f = -f_neg\n            if F[v] != f:\n                continue\n            for u in neigh[v]:\n                if min(f, R[v][u]) > F[u]:\n                    F[u] = min(f, R[v][u])\n                    P[u] = v\n                    heapq.heappush(pq, (-F[u], u))\n        v = N - 1\n        if F[v] == 0:\n            return 0\n        res = F[v]\n        while v:\n            u = P[v]\n            R[u][v] -= res\n            R[v][u] += res\n            v = u\n        return res\n\n    total = 0\n    while True:\n        f = getFlow()\n        if f == 0:\n            break\n        total += f\n    print(total)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.637133679352701e-05, 0.0, -1.1920928244535389e-07, -0.00034588552080094814, -0.0019696613308042288, -2.264974000354414e-06, -8.582700684200972e-05, -0.1269327700138092, -9.7508447652217e-05, 0.0, -2.145764938177308e-06, -0.00012063252506777644, -0.001503052655607462, -9.119095193454996e-05, -0.0008070787298493087, -0.8938653469085693, -0.9223664999008179, -0.12697088718414307, -1.7881377516459906e-06, -0.0058120540343225, -5.960462772236497e-07, -0.0009598892065696418, 0.0, -9.536697689327411e-06, -1.1920928244535389e-07, -0.004079473204910755, -7.152555099310121e-07, -1.1920922133867862e-06, -0.4857262372970581, -1.1920928244535389e-07, -6.198863957251888e-06, 0.0, -5.483612312673358e-06, -3.6954811548639555e-06, -2.0146166207268834e-05, -2.264974000354414e-06, 0.0, 0.0, 0.0, -0.00026806574896909297, 0.