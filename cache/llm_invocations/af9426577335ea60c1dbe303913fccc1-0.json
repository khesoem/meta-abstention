   }\n    }\n    return dis[t]!=inf;\n}\nint dfs(int x,int lim)\n{\n    if(x==t) return lim;\n    vis[x]=true;\n    int flow,res=lim;\n    for(int i=head[x];i;i=e[i].nxt)\n    {\n        int y=e[i].to,v=e[i].v;\n        if(dis[y]!=dis[x]+e[i].c||!v||vis[y]) continue;\n        if(flow=dfs(y,min(res,v)))\n        {\n            res-=flow;\n            e[i].v-=flow;\n            e[i^1].v+=flow;\n            if(!res) break;\n        }\n    }\n    return lim-res;\n}\nint dinic()\n{\n    int flow,sum=0;\n    while(spfa())\n        while(flow=dfs(s,inf))\n            sum+=flow*dis[t];\n    return sum;\n}\nint main()\n{\n    read(n),read(m),read(k),read(v1),read(v2),t=p(n,110)+1;\n    for(int i=2;i<=110;++i) add(p(1,i),t,inf,0);\n    for(int i=2;i<=n;++i)\n        for(int j=1;j<110;++j)\n            add(p(i,j),p(i,j+1),inf,v1);\n    for(int i=1,x;i<=k;++i) read(x),add(s,p(x,1),1,0);\n    for(int i=1;i<=m;++i)\n    {\n        int x,y;\n        read(x),read(y);\n        for(int j=1;j<110;++j)\n            for(int l=1;l<=k;++l)\n                add(p(x,j),p(y,j+1),1,v2*(2*l-1)+v1),add(p(y,j),p(x,j+1),1,v2*(2*l-1)+v1);\n    }\n    printf(\"%d\",dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); v1 = next(it); v2 = next(it)\n\n    V = 110 * n + 2\n    s = 0\n    t = 110 * n + 1\n    graph = [[] for _ in range(V)]\n\n    INF = 10**18\n\n    def p(x, layer):\n        return x + (layer - 1) * n\n\n    def add_edge(fr, to, cap, cost):\n        graph[fr].append([to, len(graph[to]), cap, cost])\n        graph[to].append([fr, len(graph[fr]) - 1, 0, -cost])\n\n    # edges from p(1,i) to sink\n    for i in range(2, 111):\n        add_edge(p(1, i), t, INF, 0)\n\n    # vertical edges (same node, consecutive layers)\n    for i in range(2, n + 1):\n        for j in range(1, 110):\n            add_edge(p(i, j), p(i, j + 1), INF, v1)\n\n    # source to first layer of selected nodes\n    for _ in range(k):\n        x = next(it)\n        add_edge(s, p(x, 1), 1, 0)\n\n    # horizontal edges between different nodes\n    for _ in range(m):\n        x = next(it); y = next(it)\n        for j in range(1, 110):\n            for l in range(1, k + 1):\n                cost = v2 * (2 * l - 1) + v1\n                add_edge(p(x, j), p(y, j + 1), 1, cost)\n                add_edge(p(y, j), p(x, j + 1), 1, cost)\n\n    dis = [INF] * V\n    vis = [False] * V\n\n    def spfa():\n        nonlocal dis, vis\n        dis = [INF] * V\n        vis = [False] * V\n        q = deque()\n        q.append(s)\n        dis[s] = 0\n        vis[s] = True\n        while q:\n            x = q.popleft()\n            vis[x] = False\n            for e in graph[x]:\n                y, rev, cap, cost = e\n                if cap > 0 and dis[y] > dis[x] + cost:\n                    dis[y] = dis[x] + cost\n                    if not vis[y]:\n                        vis[y] = True\n                        q.append(y)\n        return dis[t] != INF\n\n    sys.setrecursionlimit(10**7)\n\n    def dfs(x, lim):\n        if x == t:\n            return lim\n        vis[x] = True\n        res = lim\n        for e in graph[x]:\n            y, rev, cap, cost = e\n            if cap > 0 and dis[y] == dis[x] + cost and not vis[y]:\n                d = dfs(y, min(res, cap))\n                if d:\n                    res -= d\n                    e[2] -= d\n                    graph[y][rev][2] += d\n                    if res == 0:\n                        break\n        return lim - res\n\n    total_cost = 0\n    while spfa():\n        while True:\n            flow = dfs(s, INF)\n            if flow == 0:\n                break\n            total_cost += flow * dis[t]\n\n    print(total_