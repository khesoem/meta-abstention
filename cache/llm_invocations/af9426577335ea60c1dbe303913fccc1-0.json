{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\n#define maxn 5000010\n#define inf 1000000000\n#define p(x,k) (x+(k-1)*n)\nusing namespace std;\ntemplate<typename T> inline void read(T &x)\n{\n    x=0;char c=getchar();bool flag=false;\n    while(!isdigit(c)){if(c=='-')flag=true;c=getchar();}\n    while(isdigit(c)){x=(x<<1)+(x<<3)+(c^48);c=getchar();}\n    if(flag)x=-x;\n}\nint n,m,k,v1,v2,s,t;\nint dis[maxn];\nbool vis[maxn];\nstruct edge\n{\n    int to,nxt,v,c;\n}e[maxn];\nint head[maxn],edge_cnt=1;\nvoid add(int from,int to,int val,int cost)\n{\n\te[++edge_cnt]=(edge){to,head[from],val,cost},head[from]=edge_cnt;\n    e[++edge_cnt]=(edge){from,head[to],0,-cost},head[to]=edge_cnt;\n}\nbool spfa()\n{\n    queue<int> q;\n    for(int i=s;i<=t;++i) dis[i]=inf,vis[i]=false;\n    q.push(s),dis[s]=0,vis[s]=true;\n    while(!q.empty())\n    {\n        int x=q.front();\n        q.pop(),vis[x]=false;\n        for(int i=head[x];i;i=e[i].nxt)\n        {\n            int y=e[i].to,c=e[i].c;\n            if(dis[y]<=dis[x]+c||!e[i].v) continue;\n            dis[y]=dis[x]+c;\n            if(!vis[y]) vis[y]=true,q.push(y);\n        }\n    }\n    return dis[t]!=inf;\n}\nint dfs(int x,int lim)\n{\n    if(x==t) return lim;\n    vis[x]=true;\n    int flow,res=lim;\n    for(int i=head[x];i;i=e[i].nxt)\n    {\n        int y=e[i].to,v=e[i].v;\n        if(dis[y]!=dis[x]+e[i].c||!v||vis[y]) continue;\n        if(flow=dfs(y,min(res,v)))\n        {\n            res-=flow;\n            e[i].v-=flow;\n            e[i^1].v+=flow;\n            if(!res) break;\n        }\n    }\n    return lim-res;\n}\nint dinic()\n{\n    int flow,sum=0;\n    while(spfa())\n        while(flow=dfs(s,inf))\n            sum+=flow*dis[t];\n    return sum;\n}\nint main()\n{\n    read(n),read(m),read(k),read(v1),read(v2),t=p(n,110)+1;\n    for(int i=2;i<=110;++i) add(p(1,i),t,inf,0);\n    for(int i=2;i<=n;++i)\n        for(int j=1;j<110;++j)\n            add(p(i,j),p(i,j+1),inf,v1);\n    for(int i=1,x;i<=k;++i) read(x),add(s,p(x,1),1,0);\n    for(int i=1;i<=m;++i)\n    {\n        int x,y;\n        read(x),read(y);\n        for(int j=1;j<110;++j)\n            for(int l=1;l<=k;++l)\n                add(p(x,j),p(y,j+1),1,v2*(2*l-1)+v1),add(p(y,j),p(x,j+1),1,v2*(2*l-1)+v1);\n    }\n    printf(\"%d\",dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(1 << 25)\n\ndef read_ints():\n    return map(int, sys.stdin.buffer.read().split())\n\nclass MinCostMaxFlow:\n    def __init__(self, n):\n        self.n = n\n        self.graph = [[] for _ in range(n)]\n        self.INF = 10**9\n\n    def add_edge(self, fr, to, cap, cost):\n        forward = [to, len(self.graph[to]), cap, cost]\n        backward = [fr, len(self.graph[fr]), 0, -cost]\n        self.graph[fr].append(forward)\n        self.graph[to].append(backward)\n\n    def spfa(self, s, t):\n        n = self.n\n        INF = self.INF\n        dis = [INF] * n\n        inqueue = [False] * n\n        q = [s]\n        dis[s] = 0\n        inqueue[s] = True\n        while q:\n            v = q.pop(0)\n            inqueue[v] = False\n            for to, rev, cap, cost in self.graph[v]:\n                if cap > 0 and dis[to] > dis[v] + cost:\n                    dis[to] = dis[v] + cost\n                    if not inqueue[to]:\n                        inqueue[to] = True\n                        q.append(to)\n        return dis[t] != INF, dis\n\n    def dfs(self, v, t, f, dis, vis):\n        if v == t:\n            return f\n        vis[v] = True\n        for i, (to, rev, cap, cost) in enumerate(self.graph[v]):\n            if cap > 0 and not vis[to] and dis[to] == dis[v] + cost:\n                d = self.dfs(to, t, min(f, cap), dis, vis)\n                if d > 0:\n                    self.graph[v][i][2] -= d\n                    self.graph[to][rev][2] += d\n                    return d\n        return 0\n\n    def min_cost_flow(self, s, t):\n        flow = 0\n        cost = 0\n        INF = self.INF\n        while True:\n            ok, dis = self.spfa(s, t)\n            if not ok:\n                break\n            vis = [False] * self.n\n            while True:\n                f = self.dfs(s, t, INF, dis, vis)\n                if f == 0:\n                    break\n                flow += f\n                cost += f * dis[t]\n                vis = [False] * self.n\n        return cost\n\ndef main():\n    data = list(read_ints())\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    v1 = next(it)\n    v2 = next(it)\n    # p(x, k) = x + (k-1)*n\n    # source = 0, sink = n*110 + 1\n    s = 0\n    t = n * 110 + 1\n    mcmf = MinCostMaxFlow(t + 1)\n\n    # add edges from sink to nodes in layer 110? Actually in C++: for i=2 to 110 add p(1,i) to t with inf,0\n    # p(1,i) = 1 + (i-1)*n\n    for i in range(2, 111):\n        node = 1 + (i-1)*n\n        mcmf.add_edge(node, t, 10**9, 0)\n\n    # for i=2 to n, for j=1 to 109, add p(i,j) to p(i,j+1) with inf, v1\n    for i in range(2, n+1):\n        for j in range(1, 110):\n            from_node = i + (j-1)*n\n            to_node = i + j*n\n            mcmf.add_edge(from_node, to_node, 10**9, v1)\n\n    # for each of k special nodes: read x, add edge s -> p(x,1) with cap 1, cost 0\n    for _ in range(k):\n        x = next(it)\n        node = x + 0*n  # p(x,1) = x + (1-1)*n = x\n        mcmf.add_edge(s, node, 1, 0)\n\n    # for each of m edges: read x,y\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        # for j=1 to 109, for l=1 to k\n        # add p(x,j) -> p(y,j+1) with cap 1, cost v2*(2*l-1)+v1\n        # and p(y,j) -> p(x,j+1) similarly\n        for j in range(1, 110):\n            for l in range(1, k+1):\n                cost = v2 * (2*l - 1) + v1\n                from_node = x + (j-1)*n\n                to_node = y + j*n\n                mcmf.add_edge(from_node, to_node, 1, cost)\n                from_node = y + (j-1)*n\n                to_node = x + j*n\n                mcmf.add_edge(from_node, to_node, 1, cost)\n\n    result = mcmf.min_cost_flow(s, t)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.905801562126726e-05, -3.576278118089249e-07, 0.0, -0.00037722624256275594, -0.001950506237335503, 0.0, -0.0005714452126994729, -0.10770367830991745, 0.0, 0.0, -1.4305104514278355e-06, 0.0, -3.933898824470816e-06, -0.6393522620201111, -0.05094707012176514, -1.1920928244535389e-07, -0.013407898135483265, -0.10026007145643234, -0.07386169582605362, -0.30619195103645325, -0.1408682018518448, 0.0, -7.1403817855753e-05, -2.622600959512056e-06, -0.00680995499715209, -0.3133399784564972, 0.0, -4.768370445162873e-07, -4.768370445162873e-07, 0.0, -2.622600959512056e-06, -2.3841855067985307e-07, -1.0728830375228426e-06, 0.0, -4.768370445162873e-07, -3.683499380713329e-05, -0.17329959571361542, -0.01382207591086626, 0.0, -0.16023223102092743, -1.1920928244535389e-07,