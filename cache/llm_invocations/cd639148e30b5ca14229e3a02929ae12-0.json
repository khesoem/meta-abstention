n            char str[]=br.readLine().trim().toCharArray();\n            int n=str.length;\n\n            if(n == 1){\n                if(str[0] == '0' || str[0] == '_' || str[0] == 'X' || str[0] == '1'){\n                    ans.append(1+\"\\n\");continue;\n                } \n            }\n           \n            long cnt=0;\n            boolean Xp =false;\n\n            for(int i=0;i<n;i++) if(str[i] == 'X') Xp=true;\n\n            if(Xp){\n                for(char ch='0';ch<='9';ch++){\n                    cnt+=solve(generateStrings(str, n, ch), n);\n                }\n            }\n            else{\n                cnt+=solve(str, n);\n            }\n            \n            ans.append(cnt+\"\\n\");\n        }\n        System.out.println(ans);\n    }\n    public static long cal(char str[], String suffix, int n, int un)\n    {\n        if(n<2) return 0;\n        char last =suffix.charAt(1);\n        char first=suffix.charAt(0);\n        if(str[n-1] == '_' || str[n-1] == last){\n            if(str[n-2] == '_' || str[n-2] == first ){\n                return (long)Math.pow(10, un);\n            }\n        }\n\n        return 0;\n    }\n    public static long solve(char str[], int n){\n        if(n == 1 || str[0] == '0') return 0;\n        int un=0;\n        for(int i=1;i<n-2;i++) if(str[i] == '_') ++un;\n        long cnt=0;\n\n        cnt+=cal(str, \"25\", n, un);\n        cnt+=cal(str, \"50\", n, un);\n        cnt+=cal(str, \"75\", n, un);\n\n        if(n>2)\n        if(str[0] == '_') cnt*=9l;\n\n        if(n>=3)\n        {\n            if((str[n-1] == '_' || str[n-1] == '0') && (str[n-2] == '_' || str[n-2] == '0')){\n                if(n>3)\n                {\n                    long temp=(long)Math.pow(10, un);\n                    if(str[0] == '_') temp*=9l;\n                    cnt+=temp;\n                }\n                else if(n == 3)\n                {\n                    if(str[0] == '_'){\n                        cnt+=9;\n                    }\n