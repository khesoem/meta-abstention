ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n\n    mod = ModArith()\n    # Precompute factorials up to n+m\n    mod.f_inv(n + m)  # This triggers computation of fact and inv_fact up to n+m\n\n    # Compute phaseSize = sum_{k=0}^{n} product_{j=0}^{k-1} (n-j)/(n+m-j)\n    phase_size = 1  # k=0 term\n    p = mod.mult(n, mod.small_inv(n + m))  # k=1 term\n    phase_size = mod.add(phase_size, p)\n    i = 1\n    while p != 0:\n        p = mod.mult3(p, n - i, mod.small_inv(n + m - i))\n        phase_size = mod.add(phase_size, p)\n        i += 1\n\n    answer = 0\n    for k in range(n, 0, -1):\n        num_phases = mod.mult(m + k, mod.small_inv(k))\n        e = mod.mult(num_phases, phase_size)\n        term = mod.mult(mod.ncr(n, k), e)\n        if k & 1:\n            answer = mod.add(answer, term)\n        else:\n            answer = mod.subtract(answer, term)\n\n    print(answer)\n\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-6.198863957251888e-06, 0.0, 0.0, -0.000169382052263245, -0.0002714027068577707, 0.0, -0.005251897498965263, -0.002089223824441433, -1.7881233361549675e-05, 0.0, 0.0, 0.0, 0.0, -0.00023827097902540118, -0.029781311750411987, -3.0636318115284666e-05, -2.3841855067985307e-07, 0.0, -2.622600959512056e-06, -5.960462772236497e-07, -1.6093124941107817e-05, -5.960462772236497e-07, 0.0, 0.0, 0.0, -0.16023710370063782, 0.0, -0.0011804286623373628, -0.001096481690183282, -9.775113539944869e-06, -0.00471527548506856, -2.4914430468925275e-05, -0.00016342257731594145, -0.42013299465179443, -0.03844895586371422, 0.0, -0.1739858090877533, -0.0028526587411761284, -4.768370445162873e-07, -0.10500945150852203, -0.00030071981018409133, -9.536738616588991e-07, -2.264974000354414e-06, -0.002037236699834466, 0.0, -5.960462772236497e-07, -0.0002960720448754728, 0.0, -0.3879038393497467, 0.0, -1.1920928244535