sponse": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[20];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n        \n        List<Integer> leftSums = new ArrayList<>();\n        int leftSize = n / 2 + n % 2;\n        for (int mask = 0; mask < (1 << leftSize); mask++) {\n            int total = 0;\n            int temp = mask;\n            for (int idx = 0; idx < 20; idx++) {\n                if ((temp & 1) == 1) {\n                    total += a[idx];\n                }\n                temp >>= 1;\n            }\n            leftSums.add(total % m);\n        }\n        Collections.sort(leftSums);\n        \n        int result = 0;\n        int rightSize = n / 2;\n        for (int mask = 0; mask < (1 << rightSize); mask++) {\n            int total = 0;\n            int temp = mask;\n            for (int idx = 0; idx < 20; idx++) {\n                if ((temp & 1) == 1) {\n                    total += a[leftSize + idx];\n                }\n                temp >>= 1;\n            }\n            total %= m;\n            if (total < 0) total += m;\n            \n            int complement = (m - total - 1) % m;\n            if (complement < 0) complement += m;\n            \n            int pos = binarySearchLeftmost(leftSums, complement);\n            int candidate = leftSums.get(leftSums.size() - 1);\n            \n            if (pos < leftSums.size()) {\n                if (leftSums.get(pos) > complement) {\n                    if (pos > 0) {\n                        candidate = leftSums.get(pos - 1);\n                    }\n                } else {\n                    candidate = leftSums.get(pos);\n                }\n            }\n            \n            int val1 = (total + candidate) % m;\n            int val2 = (total + leftSums.get(leftSums.size() - 1)) % m;\n            result = Math.max(result, Math.max(val1, val2));\n        }\n        \n        System.out.println(result % m);\n    }\n    \n    private static int binarySearchLeftmost(List<Integer> list, int target) {\n        int left = 0, right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) >= target) {\n                right = mid;\n            } else {\n                left = mid + 1;\n            }\n        }\n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014137222024146467, -1.7881377516459906e-06, -1.1920922133867862e-06, -0.0010508735431358218, -6.222531374078244e-05, -0.0019290901254862547, -0.1329091489315033, -5.125986263010418e-06, -1.6689286894688848e-06, -0.00011550712952157483, -3.2186455882765586e-06, -8.344646857949556e-07, -1.9073468138230965e-06, -2.3841855067985307e-07, -5.006777428206988e-06, -1.5497195136049413e-06, -1.4305104514278355e-06, 0.0, -6.23445157543756e-05, -1.311301275563892e-06, -2.3841855067985307e-07, -1.7881377516459906e-06, -4.053033626405522e-05, -0.25378796458244324, -2.7418097943154862e-06, -1.1920928244535389e-07, -9.536697689327411e-06, -4.410734163684538e-06, -7.152555099310121e-07, -1.5735502529423684e-05, -0.0015055523253977299, -5.924526340095326e-05, 0.0, -1.1920928244535389e-07, -1.7881377516459906e-06, -2.622600959512056e-06, -1.6689286894688848e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.3828182090946939e-05, -8.344646857949556e-07, -1.0728830375228426e-06, -2.3841830625315197e-06, -0.0548832081258297, -2.0146166207268834e-05, -5.960462772236497e-07, -3.576278118089249e-07, 0.0, -1.5497195136049413e-06, -1.1920928244535389e-07, -0.0978885143995285, -1.585470999998506e-05, -3.9457496313843876e-05, -0.0017057405784726143, -5.149708886165172e-05, -5.960462772236497e-07, -2.3841855067985