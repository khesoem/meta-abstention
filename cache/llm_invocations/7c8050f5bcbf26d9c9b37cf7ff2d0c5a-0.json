maxVal[side] += span\n                solve(side, minVal, maxVal, B[idx], idx + 1, False)\n                minVal[side] -= span\n                maxVal[side] -= span\n\n                # rotate once\n                maxVal[side] += span\n                maxVal[1 - side] += span\n                currentRotations += 1\n                solve(1 - side, minVal, maxVal, B[idx], idx + 1, False)\n                currentRotations -= 1\n                maxVal[side] -= span\n                maxVal[1 - side] -= span\n\n                # rotate twice\n                maxVal[side] += span\n                minVal[1 - side] += 1\n                maxVal[1 - side] += span - 1\n                currentRotations += 2\n                solve(side, minVal, maxVal, B[idx], idx + 1, False)\n                currentRotations -= 2\n                maxVal[side] -= span\n                minVal[1 - side] -= 1\n                maxVal[1 - side] -= span - 1\n        else:\n            shift = A[idx] - cur\n            minVal[side] += shift\n            maxVal[side] += shift\n            solve(side, minVal, maxVal, A[idx], idx, True)\n            minVal[side] -= shift\n            maxVal[side] -= shift\n\n    lo = [0, 0]\n    hi = [0, 0]\n    solve(0, lo, hi, 0, 0, False)\n\n    if bestAnswer > 0:\n        print(\"Full\")\n        print(bestAnswer)\n    else:\n        print(\"Hungry\")\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-8.225102646974847e-05, -4.768370445162873e-07, -7.152555099310121e-07, -0.00158565619494766, -0.00014935807848814875, -0.0141681507229805, -0.2553601562976837, -0.003695802530273795, -2.264974000354414e-06, -8.606540359323844e-05, -2.3841855067985307e-07, -9.440929716220126e-05, -2.145764938177308e-06, -3.576278118089249e-07, -3.576272320060525e-06, -4.768370445162873e-07, -0.11865124106407166, -0.002201278228312731, -3.6954811548639555e-06, -9.65590606938349e-06, -7.152531907195225e-06, -0.00876484