))%mod;\n            System.out.println(ans);\n        }\n    }\n    public static long modexp(long a,long power,int mod){\n        if(power==0){\n            return 1;\n        }\n        if(power==1){\n            return a;\n        }\n        long small=modexp(a,power/2,mod);\n        long ans=(small%mod*small%mod)%mod;\n        if(power%2!=0){\n            ans=(ans%mod*a%mod)%mod;\n        }\n        return ans;\n    }\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <sstream>\n\nusing namespace std;\n\nlong long modexp(long long a, long long power, int mod) {\n    if (power == 0) {\n        return 1;\n    }\n    if (power == 1) {\n        return a;\n    }\n    long long small = modexp(a, power / 2, mod);\n    long long ans = (small % mod * small % mod) % mod;\n    if (power % 2 != 0) {\n        ans = (ans % mod * a % mod) % mod;\n    }\n    return ans;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    \n    int n, m, l, r;\n    ss >> n >> m >> l >> r;\n    \n    long long total = 1LL * n * m;\n    int mod = 998244353;\n    \n    if (total % 2 != 0) {\n        long long ans = modexp(r - l + 1, total, mod);\n        cout << ans << endl;\n    } else {\n        int k = r - l + 1;\n        int e = r / 2 - l / 2;\n        if (l % 2 == 0) {\n            e++;\n        }\n        int o = k - e;\n        \n        long long ans = modexp(e + o, total, mod);\n        ans = (ans + modexp(e - o, total, mod)) % mod;\n        ans = (ans * modexp(2, mod - 2, mod)) % mod;\n        cout << ans << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014244495832826942, -2.622600959512056e-06, -7.152555099310121e-07, -0.0002455409849062562, -7.152555099310121e-07, -6.437280717364047e-06, -1.4305104514278355e-