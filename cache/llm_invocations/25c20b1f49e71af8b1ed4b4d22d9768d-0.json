\n    }\n    return dis[t]!=inf;\n}\nint dfs(int x,int lim)\n{\n    if(x==t) return lim;\n    vis[x]=true;\n    int flow,res=lim;\n    for(int i=head[x];i;i=e[i].nxt)\n    {\n        int y=e[i].to,v=e[i].v;\n        if(dis[y]!=dis[x]+e[i].c||!v||vis[y]) continue;\n        if(flow=dfs(y,min(res,v)))\n        {\n            res-=flow;\n            e[i].v-=flow;\n            e[i^1].v+=flow;\n            if(!res) break;\n        }\n    }\n    return lim-res;\n}\nint dinic()\n{\n    int flow,sum=0;\n    while(spfa())\n        while(flow=dfs(s,inf))\n            sum+=flow*dis[t];\n    return sum;\n}\nint main()\n{\n    read(n),read(m),read(k),read(v1),read(v2),t=p(n,110)+1;\n    for(int i=2;i<=110;++i) add(p(1,i),t,inf,0);\n    for(int i=2;i<=n;++i)\n        for(int j=1;j<110;++j)\n            add(p(i,j),p(i,j+1),inf,v1);\n    for(int i=1,x;i<=k;++i) read(x),add(s,p(x,1),1,0);\n    for(int i=1;i<=m;++i)\n    {\n        int x,y;\n        read(x),read(y);\n        for(int j=1;j<110;++j)\n            for(int l=1;l<=k;++l)\n                add(p(x,j),p(y,j+1),1,v2*(2*l-1)+v1),add(p(y,j),p(x,j+1),1,v2*(2*l-1)+v1);\n    }\n    printf(\"%d\",dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int maxn = 5000010;\n    static final int inf = 1000000000;\n    \n    static int n, m, k, v1, v2, s, t;\n    static int[] dis = new int[maxn];\n    static boolean[] vis = new boolean[maxn];\n    \n    static class Edge {\n        int to, nxt, v, c;\n        Edge(int to, int nxt, int v, int c) {\n            this.to = to;\n            this.nxt = nxt;\n            this.v = v;\n            this.c = c;\n        }\n    }\n    \n    static Edge[] e = new Edge[maxn];\n    static int[] head = new int[maxn];\n    static int edge_cnt = 1;\n    \n    static void add(int from, int to, int val, int cost) {