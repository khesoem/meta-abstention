 }\n        long long g = gcd(numerator, denominator);\n        numerator /= g;\n        denominator /= g;\n        cout << numerator << \"/\" << denominator << endl;\n    }\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static long gcd(long a, long b) {\n        while (b != 0) {\n            long t = b;\n            b = a % b;\n            a = t;\n        }\n        return a;\n    }\n\n    public static void main(String[] args) {\n        Scanner cin = new Scanner(System.in);\n        while (cin.hasNextLong()) {\n            long x = cin.nextLong();\n            long y = cin.nextLong();\n            long n = cin.nextLong();\n            \n            long numerator = 0, denominator = 1;\n            if (y <= n) {\n                numerator = x;\n                denominator = y;\n            } else {\n                double bestDiff = 1e30;\n                for (long i = 1; i <= n; ++i) {\n                    long k = (x * i) / y;\n                    double diff1 = Math.abs((double)x / y - (double)k / i);\n                    if (diff1 < bestDiff) {\n                        bestDiff = diff1;\n                        numerator = k;\n                        denominator = i;\n                    }\n                    long k2 = k + 1;\n                    double diff2 = Math.abs((double)x / y - (double)k2 / i);\n                    if (diff2 < bestDiff) {\n                        bestDiff = diff2;\n                        numerator = k2;\n                        denominator = i;\n                    }\n                }\n            }\n            long g = gcd(numerator, denominator);\n            numerator /= g;\n            denominator /= g;\n            System.out.println(numerator + \"/\" + denominator);\n        }\n        cin.close();\n    }\n}\n</translated_code>\n<confidence