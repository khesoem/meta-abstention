0\") || s.equals(\"_\") || s.equals(\"X\");\n    }\n\n    private static boolean twoCharMatch(String p, String c) {\n        char a = p.charAt(0), b = p.charAt(1);\n        char x = c.charAt(0), y = c.charAt(1);\n\n        if (Character.isDigit(a)) {\n            if (Character.isDigit(b)) return p.equals(c);\n            if (b == '_') return a == x;\n        } else if (a == '_') {\n            if (Character.isDigit(b)) return b == y;\n            if (b == '_') return true;\n        } else if (a == 'X') {\n            if (Character.isDigit(b)) return b == y;\n            if (b == '_') return true;\n        }\n        return false;\n    }\n\n    private static boolean patternMatches(String pattern, String candidate) {\n        Set<Character> seen = new HashSet<>();\n        for (int i = 0; i < pattern.length(); i++) {\n            char pc = pattern.charAt(i);\n            char cc = candidate.charAt(i);\n            if (pc == '_') continue;\n            if (pc == 'X') {\n                seen.add(cc);\n                if (seen.size() > 1) return false;\n            } else if (pc != cc) {\n                return false;\n            }\n        }\n        return seen.size() <= 1;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    s = sys.stdin.readline().strip()\n    length = len(s)\n\n    if length == 1:\n        print(1 if is_valid_single(s) else 0)\n        return\n\n    if length == 2:\n        result = 0\n        for val in range(25, 96, 25):\n            candidate = f\"{val:02d}\"\n            if two_char_match(s, candidate):\n                result += 1\n        print(result)\n        return\n\n    start = 10 ** (length - 1)\n    end = 10 ** length\n    count = 0\n\n    for num in range(start, end, 25):\n        num_str = str(num)\n        if pattern_matches(s, num_str):\n            count += 1\n\n    print(count)\n\ndef is_valid_single(s):\n    return s in (\"0\", \"_\", \"X\")\n\ndef two_char_match(p, c):\n    a, b = p[0], p[1]\n    x, y = c[0], c[1]\n\n    if a.isdigit():\n        if b.isdigit():\n            return p == c\n        if b == '_':\n            return a == x\n    elif a == '_':\n        if b.isdigit():\n            return b == y\n        if b == '_':\n            return True\n    elif a == 'X':\n        if b.isdigit():\n            return b == y\n        if b == '_':\n            return True\n    return False\n\ndef pattern_matches(pattern, candidate):\n    seen = set()\n    for i in range(len(pattern)):\n        pc = pattern[i]\n        cc = candidate[i]\n        if pc == '_':\n            continue\n        if pc == 'X':\n            seen.add(cc)\n            if len(seen) > 1:\n                return False\n        elif pc != cc:\n            return False\n    return len(seen) <= 1\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012158608296886086, -3.576278118089249e-07, -1.1920928244535389e-07, -0.007656513713300228, -0.0720067173242569, -0.026306716725230217, -4.100715523236431e-05, -0.16607189178466797, -1.5497195136049413e-06, -1.311301275563892e-06, -0.032498572021722794, -2.861018856492592e-06, -0.22542841732501984, -2.0265558760002023e-06, -2.0265373677830212e-05, -1.0728830375228426e-06, -0.05489494279026985, -1.2874520507466514e-05, -3.3378546504536644e-06, -0.009413262829184532, -5.722029527532868e-06, -3.2186455882765586e-06, 0.0, -0.10020873695611954, -3.933898824470816e-06, -0.0015034097013995051, -7.021180499577895e-05, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -4.0531076592742465e-06, -3.576278118089249e-07, -0.04142693802714348, -8.344646857949556e-07, 0.0, -6.318072337307967e-06, -0.11284715682268143, -1.2516897186287679e-05, -2.861018856492592e-06, -2.3841855067985307e-07, -7.152555099310121e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -3.57627