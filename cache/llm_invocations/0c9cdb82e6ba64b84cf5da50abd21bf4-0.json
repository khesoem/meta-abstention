1))%p;\n\t\t}\n\t}\n\tdp2[0][0]=0;tot[0][0]=1;\n\tfor(int i=1;i<=n;i++)\n\t{\n\t\tfor(int j=0;j<=min(m,i);j++)\n\t\t{\n\t\t\tdp2[i][j]=dp2[i-1][j];\n\t\t\ttot[i][j]=tot[i-1][j];\n\t\t\tfor(int k=1;k<=j;k++)\n\t\t\t{\n\t\t\t\tif(k<i)\n\t\t\t\t{\n\t\t\t\t\tzh=C(j,k);\n\t\t\t\t\tdp2[i][j]=(1ll*dp2[i][j]+1ll*dp[k]*zh%p*tot[i-k-1][j-k]%p+1ll*dp2[i-k-1][j-k]*zh%p*cnt[k]%p)%p;\n\t\t\t\t\ttot[i][j]=(1ll*tot[i][j]+1ll*cnt[k]*tot[i-k-1][j-k]%p*zh)%p;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tdp2[i][j]=(dp2[i][j]+dp[i])%p;\n\t\t\t\t\ttot[i][j]=(tot[i][j]+cnt[i])%p;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tprintf(\"%d\\n\",dp2[n][m]);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\ndef mypow(a, b, p):\n    ans = 1\n    while b:\n        if b & 1:\n            ans = (ans * a) % p\n        a = (a * a) % p\n        b >>= 1\n    return ans\n\ndef C(n, m, fac, invfac, p):\n    return (fac[n] * invfac[m] % p) * invfac[n - m] % p\n\ndef sum_func(x, p):\n    return (x * (x + 1) // 2) % p\n\ndef main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    n = int(data[0])\n    m = int(data[1])\n    p = int(data[2])\n    \n    # Initialize arrays\n    fac = [0] * 505\n    invfac = [0] * 505\n    cnt = [0] * 505\n    dp = [0] * 505\n    dp2 = [[0] * 505 for _ in range(505)]\n    tot = [[0] * 505 for _ in range(505)]\n    \n    fac[0] = 1\n    for i in range(1, 505):\n        fac[i] = (fac[i-1] * i) % p\n    \n    invfac[500] = mypow(fac[500], p-2, p)\n    for i in range(499, -1, -1):\n        invfac[i] = (invfac[i+1] * (i+1)) % p\n    \n    cnt[0] = 1\n    dp[0] = 0\n    cnt[1] = 2\n    dp[1] = 0\n    \n    for i in range(2, m+1):\n        for j in range(1, i+1):\n            zh = C(i-1, j-1, fac, invfac, p)\n            tmp = (cnt[j-1] * cnt[i-j] % p) * zh % p\n            \n            dp[i] = (dp[i] + tmp * sum_func(j-1, p)) % p\n    