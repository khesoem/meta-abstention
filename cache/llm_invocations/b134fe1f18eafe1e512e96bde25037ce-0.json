      par[v] = id;\n                flow[v] = min(flow[u], e[id].c - e[id].f);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (dist[dst] == INF) return {0, 0};\n\n    int aug = flow[dst];\n    int cur = dst;\n    while (cur != src) {\n        int id = par[cur];\n        e[id].f += aug;\n        e[id ^ 1].f -= aug;\n        cur = e[id].u;\n    }\n\n    return {aug, aug * dist[dst]};\n}\n\npii mcmf(int n) {\n    int flow_sum = 0, cost_sum = 0;\n    while (true) {\n        pii res = spfa(n);\n        if (res.first == 0) break;\n        flow_sum += res.first;\n        cost_sum += res.second;\n    }\n    return {flow_sum, cost_sum};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        g[u].push_back(v);\n        g[v].push_back(u);\n    }\n\n    src = 0;\n    dst = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            link(t * n + i, (t + 1) * n + i, k, 0);\n            for (int nb : g[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    link(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        if (freq[i]) link(src, i, freq[i], 0);\n    }\n\n    for (int t = 0; t <= 100; ++t) {\n        link(t * n + 1, dst, k, c * t);\n    }\n\n    cout << mcmf(dst).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int u, v, f, c, w;\n        Edge(int u, int v, int f, int c, int w) {\n            this.u = u;\n            this.v = v;\n            this.f = f;\n            this.c = c;\n            this.w = w;\n        }\n    }\n\n    static final int MAXN = 1000002;\n    static final int INF = 1000000000;\n\n    static int[] freq = new int[MAXN];\n    static int src, dst;\n    static List<List<Integer>> g = new ArrayList<>();\n\n    static List<Edge> e = new ArrayList<>();\n    static List<List<Integer>> adj = new ArrayList<>();\n\n    static void link(int u, int v, int cap, int cost) {\n        e.add(new Edge(u, v, 0, cap, cost));\n        adj.get(u).add(e.size() - 1);\n        e.add(new Edge(v, u, 0, 0, -cost));\n        adj.get(v).add(e.size() - 1);\n    }\n\n    static int[] dist = new int[MAXN];\n    static int[] inq = new int[MAXN];\n    static int[] flow = new int[MAXN];\n    static int[] par = new int[MAXN];\n\n    static class Pair {\n        int first, second;\n        Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    static Pair spfa(int n) {\n        Arrays.fill(dist, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(src);\n        dist[src] = 0;\n        inq[src] = 1;\n        flow[src] = INF;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = 0;\n            for (int id : adj.get(u)) {\n                Edge edge = e.get(id);\n                int v = edge.v;\n                if (edge.c > edge.f && dist[v] > dist[u] + edge.w) {\n                    dist[v] = dist[u] + edge.w;\n                    par[v] = id;\n                    flow[v] = Math.min(flow[u], edge.c - edge.f);\n                    if (inq[v] == 0) {\n                        q.offer(v);\n                        inq[v] = 1;\n                    }\n                }\n            }\n        }\n\n        if (dist[dst] == INF) return new Pair(0, 0);\n\n        int aug = flow[dst];\n        int cur = dst;\n        while (cur != src) {\n            int id = par[cur];\n            e.get(id).f += aug;\n            e.get(id ^ 1).f -= aug;\n            cur = e.get(id).u;\n        }\n\n        return new Pair(aug, aug * dist[dst]);\n    }\n\n    static Pair mcmf(int n) {\n        int flow_sum = 0, cost_sum = 0;\n        while (true) {\n            Pair res = spfa(n);\n            if (res.first == 0) break;\n            flow_sum += res.first;\n            cost_sum += res.second;\n        }\n        return new Pair(flow_sum, cost_sum);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            freq[x]++;\n        }\n\n        for (int i = 0; i <= 100 * n + n + 1; ++i) {\n            g.add(new ArrayList<>());\n            adj.add(new ArrayList<>());\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            g.get(u).add(v);\n            g.get(v).add(u);\n        }\n\n        src = 0;\n        dst = 100 * n + n + 1;\n\n        for (int t = 0; t < 100; ++t) {\n            for (int i = 1; i <= n; ++i) {\n                link(t * n + i, (t + 1) * n + i, k, 0);\n                for (int nb : g.get(i)) {\n                    for (int cp = 1; cp <= k; ++cp) {\n                        link(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; ++i) {\n            if (freq[i] > 0) {\n                link(src, i, freq[i], 0);\n            }\n        }\n\n        for (int t = 0; t <= 100; ++t) {\n            link(t * n + 1, dst, k, c * t);\n        }\n\n        System.out.println(mcmf(dst).second);\n    }\n}\n<