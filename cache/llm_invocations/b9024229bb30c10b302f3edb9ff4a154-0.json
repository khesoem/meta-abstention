   break\n            if found:\n                newmask |= (1 << idx[gr])\n        f[newmask] = (f[newmask] + rate) % MOD\n\ndef main():\n    global n, p\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    p = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            val = int(next(it))\n            p[i][j] = (val * fpow(100, MOD-2)) % MOD\n\n    if n == 1:\n        print(p[0][0])  # p[0][1] in original? Actually p[0][1] after scaling, but here p[0][0] corresponds to right vertex 1? Wait: original p[0][1] is p[0][1] after scaling, but we stored p[i][j] for right vertex j (original j+n). For n=1, right vertex is 1, so p[0][0] is correct.\n        return\n\n    m1 = n // 2\n    m2 = n - m1\n\n    cnt = 0\n    cnt2 = 0\n    sub1 = []\n    sub2 = []\n    idx0 = {}\n    idx1 = {}\n    for mask in range(1 << n):\n        if bin(mask).count('1') == m1:\n            idx0[mask] = cnt\n            cnt += 1\n            sub1.append(mask)\n        if bin(mask).count('1') == m2:\n            idx1[mask] = cnt2\n            cnt2 += 1\n            sub2.append(mask)\n\n    # rev array: size 1<<cnt2\n    rev = [0] * (1 << cnt2)\n    for i, mask in enumerate(sub2):\n        complement = ((1 << n) - 1) ^ mask\n        comp_idx = idx0[complement]\n        for bigmask in range(1 << cnt2):\n            if bigmask & (1 << i):\n                rev[bigmask] |= (1 << comp_idx)\n\n    l1 = list(range(m1))\n    l2 = list(range(m1, n))\n    r = list(range(n, 2*n))\n\n    f = [0] * (1 << cnt)\n    g = [0] * (1 << cnt2)\n\n    work(f, l1, r, sub1, idx0)\n    work(g, l2, r, sub2, idx1)\n\n    # SOS DP on f\n    for i in range(cnt):\n        for mask in range(1 << cnt):\n            if mask & (1 << i):\n                f[mask] = (f[mask] + f[mask ^ (1 << i)]) % MOD\n\n    ans = 0\n    for mask in range(1, 1 << cnt2):\n        w = (1 - f[(1 << cnt) - 1 - rev[mask]] + MOD) % MOD\n        ans =