{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.util.*;\n\npublic class GregAndFriends {\n    static int n, k, cnt50 = 0, cnt100 = 0;\n    static final long MOD = 1000000007L;\n    static long[][] comb = new long[100][100];\n    static ArrayList<Integer> q = new ArrayList<Integer>();\n    static int head = 0;\n    static HashMap<Integer, Node> best = new HashMap<Integer, Node>();\n\n    static class Node {\n        int dist;\n        long count;\n        Node(int d, long c) {\n            dist = d;\n            count = c;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        k = sc.nextInt();\n        for (int i = 0; i < n; i++) {\n            if (sc.nextInt() == 50) cnt50++;\n            else cnt100++;\n        }\n        sc.close();\n\n        precomputeCombinations();\n\n        int first = 1000000 + 100 * cnt50 + cnt100;\n        best.put(first, new Node(0, 1));\n        q.add(first);\n\n        while (head < q.size()) {\n            process(q.get(head++));\n        }\n\n        Node target = best.get(0);\n        if (target != null) {\n            System.out.println(target.dist + \"\\n\" + target.count);\n        } else {\n            System.out.println(\"-1\\n0\");\n        }\n    }\n\n    static void process(int mask) {\n        int side = mask / 1000000;\n        int left50 = (mask % 1000000) / 100;\n        int left100 = mask % 100;\n        int currentDist = best.get(mask).dist;\n\n        if (side == 1) {\n            for (int i = left50; i >= 0 && 50 * (left50 - i) <= k; i--) {\n                for (int j = left100; j >= 0 && 50 * (left50 - i) + 100 * (left100 - j) <= k; j--) {\n                    if (i != left50 || j != left100) {\n                        long edgeWays = comb[left50][i] * comb[left100][j] % MOD;\n                        int nxt = i * 100 + j;\n                        addState(nxt, mask, edgeWays, currentDist + 1);\n                    }\n                }\n            }\n        } else {\n            for (int i = left50; i <= cnt50 && 50 * (i - left50) <= k; i++) {\n                for (int j = left100; j <= cnt100 && 50 * (i - left50) + 100 * (j - left100) <= k; j++) {\n                    if (i != left50 || j != left100) {\n                        long edgeWays = comb[cnt50 - left50][i - left50] * comb[cnt100 - left100][j - left100] % MOD;\n                        int nxt = 1000000 + i * 100 + j;\n                        addState(nxt, mask, edgeWays, currentDist + 1);\n                    }\n                }\n            }\n        }\n    }\n\n    static void addState(int nxt, int mask, long edgeWays, int newDist) {\n        if (!best.containsKey(nxt)) {\n            best.put(nxt, new Node(newDist, 0));\n            q.add(nxt);\n        }\n        Node current = best.get(mask);\n        Node next = best.get(nxt);\n        if (next.dist == newDist) {\n            next.count = (next.count + current.count * edgeWays) % MOD;\n        }\n    }\n\n    static void precomputeCombinations() {\n        for (int i = 0; i < 100; i++) {\n            comb[i][0] = 1;\n        }\n