Arrays.fill(depth, -1);\n            depth[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                for (long[] edge : links.get(v)) {\n                    long cap = edge[0];\n                    int to = (int) edge[1];\n                    if (cap > 0 && depth[to] < 0) {\n                        depth[to] = depth[v] + 1;\n                        q.offer(to);\n                    }\n                }\n            }\n        }\n\n        public long dfs(int v, int t, long flow) {\n            if (v == t) {\n                return flow;\n            }\n            for (int i = progress[v]; i < links.get(v).size(); i++) {\n                progress[v] = i;\n                long[] edge = links.get(v).get(i);\n                long cap = edge[0];\n                int to = (int) edge[1];\n                int rev = (int) edge[2];\n                if (cap == 0 || depth[v] >= depth[to]) {\n                    continue;\n                }\n                long d = dfs(to, t, Math.min(flow, cap));\n                if (d == 0) {\n                    continue;\n                }\n                links.get(v).get(i)[0] -= d;\n                links.get(to).get(rev)[0] += d;\n                return d;\n            }\n            return 0;\n        }\n\n        public long flow(int s, int t) {\n            long flow = 0;\n            while (true) {\n                bfs(s);\n                if (depth[t] < 0) {\n                    return flow;\n                }\n                progress = new int[n];\n                long current_flow = dfs(s, t, INF);\n                while (current_flow > 0) {\n                    flow += current_flow;\n                    current_flow = dfs(s, t, INF);\n                }\n            }\n        }\n\n        public long[] getEdge(int i) {\n            int[] p = pos.get(i);\n            long[] e = links.get(p[0]).get(p[1]);\n            long[] re = links.get((int) e[1]).get((int) e[2]);\n            long[] res = new long[4];\n            res[0] = p[0];\n            res[1] = e[1];\n            res[2] = e[0] + re[0];\n            res[3] = re[0];\n            return res;\n        }\n\n        public List<long[]> getEdges() {\n            int M = pos.size();\n            List<long[]> res = new ArrayList<>();\n            for (int i = 0; i < M; i++) {\n                res.add(getEdge(i));\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = 3;\n        int[] A = new int[M];\n        int[] B = new int[M];\n        for (int i = 0; i < M; i++) {\n            A[i] = sc.nextInt();\n        }\n        for (int i = 0; i < M; i++) {\n            B[i] = sc.nextInt();\n        }\n\n        int ans1 = 0;\n        for (int i = 0; i < M; i++) {\n            ans1 += Math.min(A[i], B[(i + 1) % M]);\n        }\n\n        Dinic dinic = new Dinic(2 * M + 2);\n        int s = 2 * M;\n        int t = 2 * M + 1;\n        for (int i = 0; i < M; i++) {\n            dinic.add_edge(s, i, N);\n            dinic.add_edge(M + i, t, B[i]);\n            dinic.add_edge(i, M + i, A[i]);\n            dinic.add_edge(i, M + (i - 1 + M) % M, A[i]);\n        }\n        int ans2 = N - (int) dinic.flow(s, t);\n\n        System.out.println(ans2 + \" \" + ans1);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020644917094614357, -2.264974000354414e-06, -8.344646857949556e-07, -0.000695463502779603, -4.1960789531003684e-05, -0.42870283126831055, -0.0003766304289456457, -3.933898824470816e-06, -1.0847986231965479e-05, -2.3841830625315197e-06, -0.3132888376712799, -0.0004966217675246298, -4.768370445162873e-07, -3.516612196108326e-05, -0.02977101318538189, -7.152555099310121e-07, -0.03143946826457977, -0.3262340724468231, -0.0006461439770646393, -8.344646857