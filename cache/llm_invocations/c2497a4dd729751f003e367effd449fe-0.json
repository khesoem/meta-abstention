 r, c = map(int, input_data[0].split())\n    \n    max_n = 2 * (r + c) + 10\n    C = [[0] * max_n for _ in range(max_n)]\n    \n    for i in range(max_n):\n        for j in range(max_n):\n            if j == 0:\n                C[i][j] = 1\n            elif i == 0:\n                C[i][j] = 0\n            else:\n                C[i][j] = C[i-1][j] + C[i-1][j-1]\n    \n    total = C[r+c][r] * C[r+c][r]\n    \n    x = 0\n    y = 0\n    v1 = r + c\n    v2 = r + c\n    while v1 >= r and v2 >= r:\n        if x > y:\n            cur1 = C[v1][r] - C[v1-1][r]\n            sum2 = C[v2][r]\n            y += cur1 * sum2\n            v1 -= 1\n        else:\n            sum1 = C[v1][r]\n            cur2 = C[v2][r] - C[v2-1][r]\n            x += sum1 * cur2\n            v2 -= 1\n    best = abs(x - y)\n    \n    # DFS simulation\n    best = float('inf')\n    best_z = -1\n    \n    def dfs(x, y, v1, v2):\n        nonlocal best, best_z\n        diff = abs(x - y)\n        if best <= 1 or diff - C[v1][r] * C[v2][r] >= best:\n            return\n        if v1 == r - 1 and v2 == r - 1:\n            diff = abs(x - y)\n            if diff < best:\n                best = diff\n                best_z = x\n            return\n        if v1 >= r:\n            cur1 = C[v1][r] - C[v1-1][r]\n            sum2 = C[v2][r]\n            dfs(x, y + cur1 * sum2, v1 - 1, v2)\n        if v2 >= r:\n            sum1 = C[v1][r]\n            cur2 = C[v2][r] - C[v2-1][r]\n            dfs(x + sum1 * cur2, y, v1, v2 - 1)\n    \n    dfs(0, 0, r + c, r + c)\n    \n    s = input_data[1].strip()\n    cntA = [0] * (len(s) + 1)\n    cntB = [0] * (len(s) + 1)\n    \n    for i in range(len(s)):\n        cntA[i+1] = cntA[i] + (1 if s[i] == 'A' else 0)\n        cntB[i+1] = cntB[i] + (1 if s[i] == 'B' else 0)\n    \n    mp = {}\n    \n    def solve(x, y, v1, v2):\n        state = x * 10000 + v1 * 100 + v2\n        if state in mp:\n            return mp[state]\n        \n        res = mp[state] = 0\n        diff = abs(x -