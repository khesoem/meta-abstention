n R_shifts[i].data:\n                row[:] = [0] * global_dim\n            R_shifts[i].data[0][0] = 1\n            R_shifts[i].data[1][K] = 1\n            for j in range(2, K + 1):\n                R_shifts[i].data[j][j-1] = 1\n        elif i > 1:\n            R_shifts[i] = mat_mult(R_shifts[1], R_shifts[i-1], global_dim)\n    \n    # Build column shift matrices\n    for i in range(K + 1):\n        C_shifts[i].set_identity()\n        if i == 1:\n            for row in C_shifts[i].data:\n                row[:] = [0] * global_dim\n            C_shifts[i].data[0][0] = 1\n            C_shifts[i].data[K][1] = 1\n            for j in range(2, K + 1):\n                C_shifts[i].data[j-1][j] = 1\n        elif i > 1:\n            C_shifts[i] = mat_mult(C_shifts[i-1], C_shifts[1], global_dim)\n    \n    # Build base binary matrix\n    II_ops[1].set_identity()\n    for i in range(1, K + 1):\n        II_ops[1] = mat_mult(I_ops[i], II_ops[1], global_dim)\n    \n    # Digits in base K\n    nums = []\n    x = N\n    while x:\n        nums.append(x % K)\n        x //= K\n    nums.reverse()\n    \n    # Build layered binary matrices\n    for depth in range(2, len(nums) + 1):\n        II_ops[depth] = Mat(global_dim)\n        II_ops[depth].set_identity()\n        for j in range(K):\n            II_ops[depth] = mat_mult(R_shifts[j], mat_mult(II_ops[depth-1], mat_mult(C_shifts[j], II_ops[depth], global_dim), global_dim), global_dim)\n    \n    acc = Mat(global_dim)\n    acc.set_identity()\n    pos = 0\n    \n    for idx in range(len(nums)):\n        if idx == len(nums) - 1:\n            for t in range(nums[idx]):\n                acc = mat_mult(I_ops[pos % K + 1], acc, global_dim)\n                pos += 1\n        else:\n            for t in range(nums[idx]):\n                acc = mat_mult(R_shifts[pos % K], mat_mult(II_ops[len(nums) - idx - 1], mat_mult(C_shifts[pos % K], acc, global_dim), global_dim), global_dim)\n                pos += 1\n    \n    ans = 1\n    for i in range(1,