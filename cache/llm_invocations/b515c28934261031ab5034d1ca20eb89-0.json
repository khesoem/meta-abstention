{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner in = new Scanner(System.in);\n        PrintWriter out = new PrintWriter(System.out);\n        new Solver().solve(in, out);\n        out.close();\n    }\n\n    static class Solver {\n        final long MOD = 1000000007L;\n        final long INF = (long) 1e18 + 1;\n        long[][] C = new long[100][100];\n\n        long f(long p, int a, int b, int c, int d) {\n            p = p * C[a][b] % MOD;\n            p = p * C[c][d] % MOD;\n            return p;\n        }\n\n        void solve(Scanner in, PrintWriter out) {\n            int n = in.nextInt();\n            int K = in.nextInt();\n            for (int i = 0; i < 100; i++) {\n                for (int j = 0; j <= i; j++) {\n                    if (j == 0 || j == i) C[i][j] = 1;\n                    else C[i][j] = (C[i - 1][j] + C[i - 1][j - 1]) % MOD;\n                }\n            }\n            int cnt1 = 0, cnt2 = 0;\n            for (int i = 0; i < n; i++) {\n                if (in.nextInt() == 50) cnt1++;\n                else cnt2++;\n            }\n            int SIZE = 200 * 200 * 2;\n            long[] dist = new long[SIZE];\n            long[] dp = new long[SIZE];\n            Arrays.fill(dist, INF);\n            dist[0] = 0;\n            dp[0] = 1;\n            ArrayDeque<Integer> q = new ArrayDeque<>();\n            q.add(0);\n            while (!q.isEmpty()) {\n                int idx = q.poll();\n                int x = (idx / 2) / 200;\n                int y = (idx / 2) % 200;\n                int z = idx & 1;\n                long d = dist[idx];\n                int limX = (z == 0) ? cnt1 - x : x;\n                int limY = (z == 0) ? cnt2 - y : y;\n                for (int a = 0; a <= limX; a++) {\n                    for (int b = 0; b <= limY; b++) {\n                        if (a + b == 0) continue;\n                        if (a * 50 + b * 100 > K) break;\n                        int nx = (z == 0) ? x + a : x - a;\n                        int ny = (z == 0) ? y + b : y - b;\n                        int nz = z ^ 1;\n                        int nidx = (nx * 200 + ny) * 2 + nz;\n                        if (dist[nidx] >= d + 1) {\n                            long add = f(dp[idx], limX, a, limY, b);\n                            if (dist[nidx] > d + 1) {\n                                dist[nidx] = d + 1;\n                                q.add(nidx);\n                            }\n                            dp[nidx] = (dp[nidx] + add) % MOD;\n                        }\n                    }\n                }\n            }\n            int target = (cnt1 * 200 + cnt2) * 2 + 1;\n            if (dist[target] == INF) out.println(-1);\n            else out.println(dist[target]);\n            out.println(dp[target]);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <deque>\n#include <cstring>\n#include <algorithm>\n\nusing namespace std;\n\nconst long long MOD = 1000000007LL;\nconst long long INF = (long long) 1e18 + 1;\nlong long C[100][100];\n\nlong long f(long long p, int a, int b, int c, int d) {\n    p = p * C[a][b] % MOD;\n    p = p * C[c][d] % MOD;\n    return p;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, K;\n    cin >> n >> K;\n    \n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j <= i; j++) {\n            if (j == 0 || j == i) C[i][j] = 1;\n            else C[i][j] = (C[i - 1][j] + C[i - 1][j - 1]) % MOD;\n        }\n    }\n    \n    int cnt1 = 0, cnt2 = 0;\n    for (int i = 0; i < n; i++) {\n        int x;\n        cin >> x;\n        if (x == 50) cnt1++;\n        else cnt2++;\n    }\n    \n    int SIZE = 200 * 200 * 2;\n    vector<long long> dist(SIZE, INF);\n    vector<long long> dp(SIZE, 0);\n    dist[0] = 0;\n    dp[0] = 1;\n    \n    deque<int> q;\n    q.push_back(0);\n    \n    while (!q.empty()) {\n        int idx = q.front();\n        q.pop_front();\n        \n        int x = (idx / 2) / 200;\n        int y = (idx / 2) % 200;\n        int z = idx & 1;\n        \n        long long d = dist[idx];\n        int limX = (z == 0) ? cnt1 - x : x;\n        int limY = (z == 0) ? cnt2 - y : y;\n        \n        for (int a = 0; a <= limX; a++) {\n            for (int b = 0; b <= limY; b++) {\n                if (a + b == 0) continue;\n                if (a * 50 + b * 100 > K) break;\n                \n                int nx = (z == 0) ? x + a : x - a;\n                int ny = (z == 0) ? y + b : y - b;\n                int nz = z ^ 1;\n                int nidx = (nx * 200 + ny) * 2 + nz;\n                \n                if (dist[nidx] >= d + 1) {\n                    long long add = f(dp[idx], limX, a, limY, b);\n                    if (dist[nidx] > d + 1) {\n                        dist[nidx] = d + 1;\n                        q.push_back(nidx);\n                    }