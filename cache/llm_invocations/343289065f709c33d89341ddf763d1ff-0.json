rn false;\n    }\n};\n\nint N, T, sx, sy;\nint grid[12][12], goods[12][12], dist[12][12];\nvector<int> e[2000];\nvector<int> cells[12][12];\nint leftTotal = 0, rightTotal = 0;\nMatcher solver;\n\nvoid bfs1(int r0, int c0) {\n    queue<pii> q;\n    memset(dist, 255, sizeof(dist));\n    dist[r0][c0] = 0;\n    q.push(pii(r0, c0));\n    while (!q.empty()) {\n        pii cur = q.front(); q.pop();\n        int r = cur.first;\n        int c = cur.second;\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k];\n            int nc = c + dc[k];\n            if (grid[nr][nc] >= 0 && dist[nr][nc] < 0) {\n                dist[nr][nc] = dist[r][c] + 1;\n                q.push(pii(nr, nc));\n            }\n        }\n    }\n}\n\nvoid connect(int r0, int c0, int cnt) {\n    int seen[12][12];\n    queue<pii> q;\n    memset(seen, 255, sizeof(seen));\n    seen[r0][c0] = 0;\n    q.push(pii(r0, c0));\n    while (!q.empty()) {\n        pii cur = q.front(); q.pop();\n        int r = cur.first;\n        int c = cur.second;\n        int lim = min(T, dist[r][c]);\n        if (seen[r][c] > lim) continue;\n        for (int i = 0; i < (int)cells[r][c].size(); ++i)\n            for (int k = 0; k < cnt; ++k)\n                e[leftTotal + k].push_back(cells[r][c][i]);\n        if (seen[r][c] == lim) continue;\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k];\n            int nc = c + dc[k];\n            if (grid[nr][nc] >= 0 && seen[nr][nc] < 0) {\n                seen[nr][nc] = seen[r][c] + 1;\n                q.push(pii(nr, nc));\n            }\n        }\n    }\n    leftTotal += cnt;\n}\n\nint main() {\n    scanf(\"%d%d\", &N, &T);\n    memset(grid, 255, sizeof(grid));\n    memset(goods, 255, sizeof(goods));\n    for (int i = 1; i <= N; ++i) {\n        while (fgetc(stdin) != '\\n');\n        for (int j = 1; j <= N; ++j) {\n            int ch = fgetc(stdin);\n            if (ch >= '0' && ch <= '9') grid[i][j] = ch - '0';\n            if (ch == 'Z') {\n                sx = i;\n                sy = j;\n            }\n        }\n    }\n    bfs1(sx, sy);\n    while (fgetc(stdin) != '\\n');\n    for (int i = 1; i <= N; ++i) {\n        while (fgetc(stdin) != '\\n');\n        for (int j = 1; j <= N; ++j) {\n            int ch = fgetc(stdin);\n            if (ch >= '0' && ch <= '9') goods[i][j] = ch - '0';\n            for (int k = 0; k < goods[i][j]; ++k)\n                cells[i][j].push_back(rightTotal++);\n        }\n    }\n    for (int i = 1; i <= N; ++i)\n        for (int j = 1; j <= N; ++j)\n            if (dist[i][j] < 0) dist[i][j] = INF;\n    for (int i = 1; i <= N; ++i)\n        for (int j = 1; j <= N; ++j)\n            if (grid[i][j] > 0) connect(i, j, grid[i][j]);\n    printf(\"%d\\n\", solver.run(leftTotal, e));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1000000000\ndr = [0, -1, 0, 1]\ndc = [1, 0, -1, 0]\n\nclass Matcher:\n    def __init__(self):\n        self.MAXN = 2000\n        self.ans = 0\n        self.leftMatch = [-1] * self.MAXN\n        self.rightMatch = [-1] * self.MAXN\n        self.used = [0] * self.MAXN\n\n    def run(self, n, g):\n        self.ans = 0\n        self.leftMatch = [-1] * self.MAXN\n        self.rightMatch = [-1] * self.MAXN\n        for i in range(n):\n            self.used = [0] * self.MAXN\n            if self.augment(i, g):\n                self.ans += 1\n        return self.ans\n\n    def augment(self, x, g):\n        for y in g[x]:\n            if self.used[y]:\n                continue\n            self.used[y] = 1\n            if self.rightMatch[y] == -1 or self.augment(self.rightMatch[y], g):\n                self.leftMatch[x] = y\n                self.rightMatch[y] = x\n                return True\n        return False\n\ndef bfs1(r0, c0):\n    global dist\n    dist = [[-1] * 12 for _ in range(12)]\n    q = deque()\n    dist[r0][c0] = 0\n    q.append((r0, c0))\n    while q:\n        r, c = q.popleft()\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if grid[nr][nc] >= 0 and dist[nr][nc] < 0:\n                dist[nr][nc] = dist[r][c] + 1\n                q.append((nr, nc))\n\ndef connect(r0, c0, cnt):\n    global leftTotal\n    seen = [[-1] * 12 for _ in range(12)]\n    q = deque()\n    seen[r0][c0] = 0\n    q.append((r0, c0))\n    while q:\n        r, c = q.popleft()\n        lim = min(T, dist[r][c])\n        if seen[r][c] > lim:\n            continue\n        for i in range(len(cells[r][c])):\n            for k in range(cnt):\n                e[leftTotal + k].append(cells[r][c][i])\n        if seen[r][c] == lim:\n            continue\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if grid[nr][nc] >= 0 and seen[nr][nc] < 0:\n                seen[nr][nc] = seen[r][c] + 1\n                q.append((nr, nc))\n    leftTotal += cnt\n\ndef main():\n    global N, T, sx, sy, grid, goods, dist, cells, e, leftTotal, rightTotal, solver\n    input_data = sys.stdin.read().splitlines()\n    # First line: N T\n    first_line = input_data[0].strip().split()\n    N = int(first_line[0])\n    T = int(first_line[1])\n    # Initialize grids with -1 (like memset -1)\n    grid = [[-1] * 12 for _ in range(12)]\n    goods = [[-1] * 12 for _ in range(12)]\n    # Read N lines for grid (lines 1 to N)\n    for i in range(1, N+1):\n        line = input_data[i].strip()\n        # line length should be N\n        for j, ch in enumerate(line, start=1):\n            if '0' <= ch <= '9':\n                grid[i][j] = int(ch)\n            elif ch == 'Z':\n                sx = i\n                sy = j\n    # Read N lines for goods (lines N+1 to 2N)\n    for i in range(1, N+1):\n        line = input_data[N + i].strip()\n        for j, ch in enumerate(line, start=1):\n            if '0' <= ch <= '9':\n                goods[i][j] = int(ch)\n    # Initialize cells and rightTotal\n    cells = [[[] for _ in range(12)] for _ in range(12)]\n    rightTotal = 0\n    for i in range(1, N+1):\n        for j in range(1, N+1):\n            if goods[i][j] > 0:\n                for _ in range(goods[i][j]):\n                    cells[i][j].append(rightTotal)\n                    rightTotal += 1\n    # BFS from start\n    bfs1(sx, sy)\n    # Set unreachable distances to INF\n    for i in range(1, N+1):\n        for j in range(1, N+1):\n            if dist[i][j] < 0:\n                dist[i][j] = INF\n    # Build graph\n    e = [[] for _ in range(2000)]\n    leftTotal = 0\n    for i in range(1, N+1):\n        for j in range(1, N+1):\n            if grid[i][j] > 0:\n                connect(i, j, grid[i][j])\n    solver = Matcher()\n    result = solver.run(leftTotal, e)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.344646857949556e-07, 0.0, -2.3841855067985307e-07, -0.0002694958820939064, -0.0004391897819004953, 0.0, -0.0015055523253977299, -0.16150517761707306, -1.3232143828645349e-05, 0.0, -4.0531076592742465e-06, -0.01829979382455349, -0.1617981642484665, -1.0728830375228426e-06, -8.22540732769994e-06, -0.0012286503333598375, -1.9073468138230965e-06, -3.576278118089249e-07, -2.7418097943154862e-06, -0.023246029391884804, -0.0069288220256567, 0.0, -5.8530047681415454e-05, -3.3378546504536644e-06, -1.0728830375228426e-06, -2.753696753643453e-05, 0.0, 0.0, -1.4305104514278355e-06, -4.768370445162873e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -9.60780744208023e-05, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -3.099436753473128e-06, -1.1920928244535389e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -3.576278118089249e-07, -5.960462772236497e-07, -1.0728830375228426e-06, -