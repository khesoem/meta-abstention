);\n    coeffs[0] = 1;\n    long long numerator = 1;\n    long long denominator = 1;\n    \n    for (int i = 1; i <= r; i++) {\n        numerator = (numerator * (r - i + 1)) % MOD;\n        denominator = (denominator * i) % MOD;\n        coeffs[i] = (numerator * modInverse(denominator)) % MOD;\n    }\n    \n    return coeffs;\n}\n\nlong long binomial(long long n, long long k) {\n    if (k < 0 || k > n) return 0;\n    if (k == 0 || k == n) return 1;\n    \n    long long num = 1;\n    for (long long i = n - k + 1; i <= n; i++) {\n        num = (num * i) % MOD;\n    }\n    \n    long long denom = 1;\n    for (long long i = 1; i <= k; i++) {\n        denom = (denom * i) % MOD;\n    }\n    \n    return (num * modInverse(denom)) % MOD;\n}\n\nint main() {\n    long long n, kVal;\n    cin >> n >> kVal;\n    \n    if (kVal >= n) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    long long k = kVal;\n    long long r = n - k;\n    \n    vector<long long> rC = precomputeBinomialCoefficients(r);\n    long long result = 0;\n    long long sign = 1;\n    \n    for (int i = 0; i <= r; i++) {\n        long long term = power(r - i, n) * rC[i] % MOD;\n        term = term * sign % MOD;\n        result = (result + term) % MOD;\n        sign = -sign;\n    }\n    \n    result = result * binomial(n, k) % MOD;\n    if (k > 0) {\n        result = result * 2 % MOD;\n    }\n    \n    result = (result % MOD + MOD) % MOD;\n    cout << result << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011753345461329445, -2.3841830625315197e-06, -3.576278118089249e-07, -0.00018773700867313892, -1.1920928244535389e-07, -1.811964830267243e-05, -4.768370445162873e-07, -0.0002308817347511649, -9.536738616588991e-07, -8.046303264563903e-05, -0.02630242146551609, -0.009808676317334175, -8.22540732769994e-06, -3.3378546504536644e-06, -1.1920922133867862e-06, -0.0013435394503176212, -3.6954811548639555e-06, -4.362964682513848e-05, -5.00