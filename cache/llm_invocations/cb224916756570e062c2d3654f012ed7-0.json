, j) % MOD));\n        return res;\n    }\n};\n\nint main() {\n#ifndef ONLINE_JUDGE\n    freopen(\"matrix.in\", \"r\", stdin);\n    freopen(\"matrix.out\", \"w\", stdout);\n#endif\n    ll m = readNumber<ll>();\n    int n = readNumber<int>();\n\n    int D = n + 2;\n    vector<Mat> A(n + 2, Mat(D)), pre(n + 2, Mat(D)), suf(n + 2, Mat(D));\n\n    Mat E(D);\n    for (int i = 1; i <= n + 1; ++i)\n        E.at(i, i) = 1;\n\n    Mat ans = E;\n\n    for (int i = 1; i <= n; ++i) {\n        A[i] = E;\n        for (int j = 1; j <= n + 1; ++j)\n            A[i].at(j, i) = 1;\n    }\n\n    pre[0] = E;\n    suf[n + 1] = E;\n\n    while (m) {\n        ll u = m % n;\n        if (u) {\n            ll s = 0;\n            for (ll v = m / n; v; v /= n)\n                s = (s + v % n) % n;\n            u = (s + u - 1) % n + 1;\n            for (; u != s; --u) {\n                if (u <= 0)\n                    u += n;\n                ans = A[(int)u] * ans;\n            }\n        }\n\n        for (int i = 1; i <= n; ++i)\n            pre[i] = pre[i - 1] * A[i];\n\n        for (int i = n; i >= 1; --i)\n            suf[i] = A[i] * suf[i + 1];\n\n        for (int i = 1; i <= n; ++i)\n            A[i] = suf[i] * pre[i - 1];\n\n        m /= n;\n    }\n\n    int num = 1;\n    for (int i = 1; i <= n; ++i)\n        addMod(num, ans.at(n + 1, i));\n\n    printf(\"%d\\n\", num);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```python\nimport sys\n\nMOD = 1000000007\n\nclass Mat:\n    def __init__(self, size):\n        self.size = size\n        self.a = [0] * (size * size)\n\n    def get(self, r, c):\n        return self.a[r * self.size + c]\n\n    def set(self, r, c, val):\n        self.a[r * self.size + c] = val\n\n    def __mul__(self, other):\n        res = Mat(self.size)\n        for i in range(1, self.size):\n            for j in range(1, self.size):\n                total = 0\n                for k in range(1, self.size):\n                    total = (total + self.get(i, k) * other.get(k, j)) % MOD\n                res.set(i, j, total)\n        return res\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    m = data[0]\n    n = data[1]\n\n    D = n + 2\n    A = [Mat(D) for _ in range(n + 2)]\n    pre = [Mat(D) for _ in range(n + 2)]\n    suf = [Mat(D) for _ in range(n + 2)]\n\n    E = Mat(D)\n    for i in range(1, D):\n        E.set(i, i, 1)\n\n    # copy E for ans\n    ans = Mat(D)\n    ans.a = E.a[:]\n\n    # pre[0] and suf[n+1] are identity\n    pre[0] = Mat(D)\n    pre[0].a = E.a[:]\n    suf[n + 1] = Mat(D)\n    suf[n + 1].a = E.a[:]\n\n    # initialize A[i] for i=1..n\n    for i in range(1, n + 1):\n        A[i] = Mat(D)\n        A[i].a = E.a[:]\n        for j in range(1, D):\n            A[i].set(j, i, 1)\n\n    while m:\n        u = m % n\n        if u:\n            s = 0\n            v = m // n\n            while v:\n                s = (s + v % n) % n\n                v //= n\n            u = (s + u - 1) % n + 1\n            while u != s:\n                if u <= 0:\n                    u += n\n                ans = A[u] * ans\n                u -= 1\n\n        # compute prefix and suffix products\n        for i in range(1, n + 1):\n            pre[i] = pre[i - 1] * A[i]\n        for i in range(n, 0, -1):\n            suf[i] = A[i] * suf[i + 1]\n        for i in range(1, n + 1):\n            A[i] = suf[i] * pre[i - 1]\n\n        m //= n\n\n    num = 1\n    for i in range(1, n + 1):\n        num = (num + ans.get(n + 1, i)) % MOD\n    print(num)\n\nif __name__ == \"__main__\":\n    main()\n```<confidence>0.95</confidence>", "token_logprobs": [-1.1920928244535389e-07, -7.092700980138034e-05, -2.2411095415009186e-05, 0.0, -0.00016020445036701858, 0.0, -5.960462772236497e-07, 0.0, -4.577531944960356e-05, 0.0, -1.1920928244535389e-07, 0.0, -0.0019641886465251446, -0.6943910717964172, -7.867782187531702