m>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst ll MOD = 1000000007LL;\n\nll mod_pow(ll base, ll exp, ll mod) {\n    ll result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nvoid process() {\n    ll P, K;\n    cin >> P >> K;\n    if (K == 0) {\n        cout << mod_pow(P, P-1, MOD) << '\\n';\n        return;\n    }\n    vector<ll> k(P);\n    for (int i = 0; i < P; ++i) {\n        k[i] = (K * i) % P;\n    }\n    vector<bool> f(P, false);\n    vector<ll> c(P, 0);\n    ll ans = 1;\n    for (int i = 0; i < P; ++i) {\n        if (f[i]) continue;\n        ll cnt = 1;\n        ll u = i;\n        f[u] = true;\n        while (!f[k[u]]) {\n            u = k[u];\n            f[u] = true;\n            cnt++;\n        }\n        c[cnt]++;\n    }\n    for (int i = 1; i < P; ++i) {\n        if (c[i] != 0) {\n            ll cnt = i * c[i] + (i > 1 ? c[1] : 0);\n            ans = (ans * mod_pow(cnt, c[i], MOD)) % MOD;\n        }\n    }\n    cout << ans << '\\n';\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int T = 1;\n    while (T--) process();\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0001299296854995191, 0.0, -1.5497195136049413e-06, -0.0012963948538526893, -0.00012087091454304755, -1.1920922133867862e-06, -0.00033706706017255783, -1.6689160474925302e-05, 0.0, 0.0, -9.536738616588991e-07, -0.31327977776527405, -0.11307331174612045, -2.3841855067985307e-07, -0.43136879801750183, -0.38855448365211487, -0.01827099919319153, -2.3841830625315197e-06, 0.0, -0.014168855734169483, -0.826195240020752, -1.0728830375228426e-06, 0.0, -0.0004325169720686972, -0.575953483581543, -0.00015901254664640874, -0.003184131346642971, -0.0023588708136230707, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.541770613286