    d = adjust(e.from_node.back, min(d, e.flow))\n    e.flow -= d\n    e.opposite.flow += d\n    return d\n\ndef connect(a: Node, b: Node, w: int):\n    ea = Edge(a, b, w)\n    eb = Edge(b, a, 0)\n    ea.opposite = eb\n    eb.opposite = ea\n    a.adjusted.append(ea)\n    b.adjusted.append(eb)\n\ndef max_flow(g: List[Node], source: Node, sink: Node) -> int:\n    result = 0\n    while True:\n        for u in g:\n            u.age = 0\n        q = deque()\n        q.append(source)\n        source.age = 1\n        while q and sink.age == 0:\n            u = q.popleft()\n            for e in u.adjusted:\n                v = e.to_node\n                if v.age != 0 or e.flow == 0:\n                    continue\n                v.back = e\n                v.age = u.age + 1\n                q.append(v)\n        if sink.age == 0:\n            break\n        for e in sink.adjusted:\n            o = e.opposite\n            if o.from_node.age != sink.age - 1 or o.flow == 0:\n                continue\n            result += adjust(o, o.flow)\n    return result\n\ndef linear(t: int, r: int, c: int, n: int) -> int:\n    return t * n * n + r * n + c\n\ndef main():\n    input = sys.stdin.read().split()\n    index = 0\n    while index < len(input):\n        if index + 2 > len(input):\n            break\n        n = int(input[index])\n        T = int(input[index + 1])\n        index += 2\n        lab = []\n        g: List[Node] = []\n        total_nodes = (T + 1) * n * n + 2\n        g = [Node() for _ in range(total_nodes)]\n        source = g[linear(T, n - 1, n - 1, n) + 1]\n        sink = g[linear(T, n - 1, n - 1, n) + 2]\n        z: List[Tuple[int, int]] = []\n\n        for r in range(n):\n            row_str = input[index]\n            index += 1\n            lab.append(list(row_str))\n        for r in range(n):\n            for c in range(n):\n                if lab[r][c] == 'Y':\n                    continue\n                if lab[r][c] == 'Z':\n                    z.append((r, c))\n                    continue\n                connect(source, g[linear(0, r, c, n)], int(lab[r][c]))\n                lab[r][c] = '0'\n        for r in range(n):\n            row_str = input[index]\n            index += 1\n            row = list(row_str)\n            for c in range(n):\n                if row[c] == 'Y' or row[c] == 'Z':\n                    continue\n                connect(g[linear(T, r, c, n)], sink, int(row[c]))\n        dr = [1, 0, -1, 0]\n        dc = [0, 1, 0, -1]\n        for t in range(T):\n            # connect corridors\n            for r in range(n):\n                for c in range(n):\n                    connect(g[linear(t, r, c, n)], g[linear(t + 1, r, c, n)], INF)\n                    if lab[r][c] != '0':\n                        continue\n                    for d in range(4):\n                        r_ = r + dr[d]\n                        c_ = c + dc[d]\n                        if r_ < 0 or r_ >= n or c_ < 0 or c_ >= n or lab[r_][c_] != '0':\n                            continue\n                        connect(g[linear(t, r, c, n)], g[linear(t + 1, r_, c_, n)], INF)\n            # spread\n            z_ = []\n            for e in z:\n                r, c = e\n                for d in range(4):\n                    r_ = r + dr[d]\n                    c_ = c + dc[d]\n                    if r_ < 0 or r_ >= n or c_ < 0 or c_ >= n or lab[r_][c_] != '0':\n                        continue\n                    z_.append((r_, c_))\n                    lab[r_][c_] = 'Z'\n            z = z_\n        print(max_flow(g, source, sink))\n        if index >= len(input):\n            break\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.001248089363798499, -0.0003600144700612873, -1.2664456789934775e-06, -2.5107177862082608e-05, -0.03788723796606064, -5.5577775128767826e-06, -2.2603901015827432e-05, -0.08976154029369354, -0.0056168390437960625, 0.0, -5.9153885558771435