{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MAXN = 5007;\nconst ll INF = 1e9;\nconst ll MOD = 1e9 + 7;\n\nstruct Edge {\n    int from, to;\n    ll cap, cost, flow;\n    Edge(int a, int b, ll c, ll d) : from(a), to(b), cap(c), cost(d), flow(0) {}\n};\n\nvector<Edge> edges;\nvector<int> adj[MAXN];\nll dist[MAXN], potential[MAXN];\nint parent[MAXN];\n\nvoid add_edge(int u, int v, ll cap, ll cost) {\n    adj[u].push_back(edges.size());\n    edges.push_back({u, v, cap, cost});\n    adj[v].push_back(edges.size());\n    edges.push_back({v, u, 0, -cost});\n}\n\nvoid ford_bellman(int s, int n) {\n    for (int i = 0; i < MAXN; i++) potential[i] = INF;\n    potential[s] = 0;\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < (int)edges.size(); j++) {\n            Edge &e = edges[j];\n            if (e.cap == e.flow) continue;\n            if (potential[e.from] == INF) continue;\n            potential[e.to] = min(potential[e.to], potential[e.from] + e.cost);\n        }\n    }\n}\n\nvoid dijkstra(int s) {\n    for (int i = 0; i < MAXN; i++) dist[i] = INF;\n    dist[s] = 0;\n    set<pair<ll, int>> pq;\n    pq.insert({0, s});\n    while (!pq.empty()) {\n        int v = pq.begin()->second;\n        pq.erase(pq.begin());\n        for (int i = 0; i < (int)adj[v].size(); i++) {\n            int eid = adj[v][i];\n            Edge &e = edges[eid];\n            if (e.cap == e.flow) continue;\n            int to = e.to;\n            ll len = e.cost + potential[v] - potential[to];\n            if (dist[v] + len < dist[to]) {\n                pq.erase({dist[to], to});\n                dist[to] = dist[v] + len;\n                parent[to] = eid;\n                pq.insert({dist[to], to});\n            }\n        }\n    }\n}\n\npair<ll, ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (true) {\n        if (dist[t] == INF) break;\n        ll pushed = INF, sum = 0;\n        for (int v = t; v != s; v = edges[parent[v]].from) {\n            int eid = parent[v];\n            pushed = min(pushed, edges[eid].cap - edges[eid].flow);\n            sum += edges[eid].cost;\n        }\n        flow += pushed;\n        cost += pushed * sum;\n        for (int v = t; v != s; v = edges[parent[v]].from) {\n            int eid = parent[v];\n            edges[eid].flow += pushed;\n            edges[eid ^ 1].flow -= pushed;\n        }\n        dijkstra(s);\n        for (int i = 0; i < MAXN; i++) potential[i] = dist[i];\n    }\n    return {cost, flow};\n}\n\nvoid solve() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnt(n, 0);\n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        cnt[--x]++;\n    }\n    for (int i = 0; i < n; i++) {\n        add_edge(5000, i, cnt[i], 0);\n    }\n    for (int t = 0; t < m; t++) {\n        int u, v;\n        cin >> u >> v;\n        u--, v--;\n        for (int i = 0; i < 99; i++) {\n            ll cur = d;\n            for (int j = 0; j < 50; j++) {\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cur);\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cur);\n                cur += 2 * d;\n            }\n        }\n    }\n    for (int i = 0; i <= 99; i++) {\n        add_edge(0 + i * 50, 5001, INF, c * i);\n    }\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 99; j++) {\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0);\n        }\n    }\n    auto res = mincost_maxflow(5000, 5001);\n    assert(res.second == k);\n    cout << res.first;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cout.tie(0);\n    cout << fixed << setprecision(20);\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\nMAXN = 5007\n\nedges = []  # list of [from, to, cap, cost, flow]\nadj = [[] for _ in range(MAXN)]\ndist = [INF] * MAXN\npotential = [INF] * MAXN\nparent = [-1] * MAXN\n\ndef add_edge(u, v, cap, cost):\n    adj[u].append(len(edges))\n    edges.append([u, v, cap, cost, 0])\n    adj[v].append(len(edges))\n    edges.append([v, u, 0, -cost, 0])\n\ndef ford_bellman(s, n):\n    for i in range(MAXN):\n        potential[i] = INF\n    potential[s] = 0\n    for _ in range(n):\n        for e in edges:\n            if e[2] == e[4]:\n                continue\n            if potential[e[0]] == INF:\n                continue\n            if potential[e[0]] + e[3] < potential[e[1]]:\n                potential[e[1]] = potential[e[0]] + e[3]\n\ndef dijkstra(s):\n    for i in range(MAXN):\n        dist[i] = INF\n    dist[s] = 0\n    pq = [(0, s)]\n    while pq:\n        d, v = heapq.heappop(pq)\n        if d != dist[v]:\n            continue\n        for eid in adj[v]:\n            e = edges[eid]\n            if e[2] == e[4]:\n                continue\n            to = e[1]\n            len_ = e[3] + potential[v] - potential[t