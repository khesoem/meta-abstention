[v].append([u, 0, len(self.graph[u]) - 1])\n\n    def bfs(self, s, t):\n        level = [-1] * self.n\n        q = deque()\n        level[s] = 0\n        q.append(s)\n        while q:\n            u = q.popleft()\n            for v, cap, rev in self.graph[u]:\n                if cap > 0 and level[v] == -1:\n                    level[v] = level[u] + 1\n                    q.append(v)\n        self.level = level\n        return level[t] != -1\n\n    def dfs(self, u, t, f):\n        if u == t:\n            return f\n        for i in range(self.it[u], len(self.graph[u])):\n            self.it[u] = i\n            v, cap, rev = self.graph[u][i]\n            if cap > 0 and self.level[u] + 1 == self.level[v]:\n                ret = self.dfs(v, t, min(f, cap))\n                if ret:\n                    # update forward edge\n                    self.graph[u][i][1] -= ret\n                    # update reverse edge\n                    self.graph[v][rev][1] += ret\n                    return ret\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        while self.bfs(s, t):\n            self.it = [0] * self.n\n            while True:\n                pushed = self.dfs(s, t, INF)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\ndef inside(x, y, n):\n    return 0 <= x < n and 0 <= y < n\n\ndef bfs1(sx, sy, g, n):\n    tim = [[INF]*n for _ in range(n)]\n    q = deque()\n    q.append((sx, sy))\n    tim[sx][sy] = 0\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx = x + dirX[k]\n            ny = y + dirY[k]\n            if inside(nx, ny, n) and '0' <= g[nx][ny] <= '9' and tim[nx][ny] > tim[x][y] + 1:\n                tim[nx][ny] = tim[x][y] + 1\n                q.append((nx, ny))\n    return tim\n\ndef bfs2(sx, sy, tim, h, n):\n    dis = [[INF]*n for _ in range(n)]\n    q = deque()\n    q.append((sx, sy))\n    dis[sx][sy] = 0\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx = x + dirX[k]\n            ny = y + dirY[k]\n            if inside(nx, ny, n) and '0' <= h[nx][ny] <= '9' and dis[nx][ny] > dis[x][y] + 1:\n                if tim[nx][ny] >= dis[x][y] + 1:\n                    dis[nx][ny] = dis[x][y] + 1\n                    if tim[nx][ny] > dis[nx][ny]:\n                        q.append((nx, ny))\n    return dis\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    limitT = int(next(it))\n    g = [list(next(it).strip()) for _ in range(n)]\n    h = [list(next(it).strip()) for _ in range(n)]\n\n    # compute tim from each 'Z' cell (only one? but we do for all)\n    tim = None\n    for i in range(n):\n        for j in range(n):\n            if g[i][j] == 'Z':\n                tim = bfs1(i, j, g, n)\n                break\n        if tim is not None:\n            break\n\n    S = 0\n    T = n * n * 2 + 1\n    dinic = Dinic(T + 1)\n\n    # add edges from source to g nodes and from h nodes to sink\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                dinic.add_edge(S, i * n + j + 1, ord(g[i][j]) - ord('0'))\n            if '1' <= h[i][j] <= '9':\n                dinic.add_edge(n * n + i * n + j + 1, T, ord(h[i][j]) - ord('0'))\n\n    # add edges from g nodes to h nodes if reachable within limitT\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                dis = bfs2(i, j, tim, h, n)\n                for x in range(n):\n                    for y in range(n):\n                        if '1' <= h[x][y] <= '9' and dis[x][y] <= limitT:\n                            dinic.add_edge(i * n + j + 1, n * n + x * n + y + 1, INF)\n\n    print(dinic.max_flow(S, T))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1205610462639015e-05, 0.0, -1.192092