));\n        out.println(answer.mod(MOD));\n        out.close();\n    }\n\n    static BigInteger[] factArr = new BigInteger[1];\n    static BigInteger[] invFactArr = new BigInteger[1];\n    static {\n        factArr[0] = BigInteger.ONE;\n        invFactArr[0] = BigInteger.ONE;\n    }\n\n    static BigInteger fact(int n) {\n        if (n >= factArr.length) {\n            int old = factArr.length;\n            BigInteger[] newFact = new BigInteger[n + 1];\n            BigInteger[] newInv = new BigInteger[n + 1];\n            System.arraycopy(factArr, 0, newFact, 0, old);\n            System.arraycopy(invFactArr, 0, newInv, 0, old);\n            for (int i = old; i <= n; i++) {\n                newFact[i] = newFact[i - 1].multiply(BigInteger.valueOf(i)).mod(MOD);\n            }\n            newInv[n] = newFact[n].modInverse(MOD);\n            for (int i = n - 1; i >= old; i--) {\n                newInv[i] = newInv[i + 1].multiply(BigInteger.valueOf(i + 1)).mod(MOD);\n            }\n            factArr = newFact;\n            invFactArr = newInv;\n        }\n        return factArr[n];\n    }\n\n    static BigInteger invFact(int n) {\n        fact(n);\n        return invFactArr[n];\n    }\n\n    static BigInteger ncr(int n, int r) {\n        if (r < 0 || r > n) return BigInteger.ZERO;\n        return fact(n).multiply(invFact(r)).multiply(invFact(n - r)).mod(MOD);\n    }\n\n    static BigInteger parity(long k) {\n        return (k & 1) == 0 ? BigInteger.ONE : MOD.subtract(BigInteger.ONE);\n    }\n\n    static BigInteger add(BigInteger a, BigInteger b) {\n        return a.add(b).mod(MOD);\n    }\n\n    static BigInteger mult(BigInteger... x) {\n        BigInteger r = BigInteger.ONE;\n        for (BigInteger v : x) r = r.multiply(v).mod(MOD);\n        return r;\n    }\n\n    static BigInteger pow(BigInteger x, int e) {\n        if (e < 0) {\n            x = x.modInverse(MOD);\n            e = -e;\n        }\n        return x.modPow(BigInteger.valueOf(e), MOD);\n    }\n}\n</