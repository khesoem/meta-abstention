 2 * (r + c)\nC = [[0] * (max_size + 1) for _ in range(max_size + 1)]\nfor i in range(max_size + 1):\n    for j in range(max_size + 1):\n        if j == 0:\n            C[i][j] = 1\n        elif i == 0:\n            C[i][j] = 0\n        else:\n            C[i][j] = C[i - 1][j] + C[i - 1][j - 1]\n\ntotal = C[r + c][r] * C[r + c][r]\n\n# Initial balancing\nx, y = 0, 0\nv1, v2 = r + c, r + c\nwhile v1 >= r and v2 >= r:\n    if x > y:\n        cur1 = C[v1][r] - C[v1 - 1][r]\n        sum2 = C[v2][r]\n        y += cur1 * sum2\n        v1 -= 1\n    else:\n        sum1 = C[v1][r]\n        cur2 = C[v2][r] - C[v2 - 1][r]\n        x += sum1 * cur2\n        v2 -= 1\nbest = abs(x - y)\n\n# DFS function\ndef dfs(x, y, v1, v2):\n    diff = abs(x - y)\n    if best <= 1 or diff - C[v1][r] * C[v2][r] >= best:\n        return\n    if v1 == r - 1 and v2 == r - 1:\n        diff = abs(x - y)\n        if diff < best:\n            nonlocal best, best_z\n            best = diff\n            best_z = x\n        return\n    if v1 >= r:\n        cur1 = C[v1][r] - C[v1 - 1][r]\n        sum2 = C[v2][r]\n        dfs(x, y + cur1 * sum2, v1 - 1, v2)\n    if v2 >= r:\n        sum1 = C[v1][r]\n        cur2 = C[v2][r] - C[v2 - 1][r]\n        dfs(x + sum1 * cur2, y, v1, v2 - 1)\n\n# Read string s\ns = sys.stdin.readline().strip()\n\ncntA = [0] * (2 * (r + c) + 1)\ncntB = [0] * (2 * (r + c) + 1)\nfor i in range(2 * (r + c)):\n    cntA[i + 1] = cntA[i] + (s[i] == 'A')\n    cntB[i + 1] = cntB[i] + (s[i] == 'B')\n\n# Memoization dictionary\nmp = {}\n\ndef solve(x, y, v1, v2):\n    state = x * 10000 + v1 * 100 + v2\n    if state in mp:\n        return mp[state]\n    res = 0\n    diff = abs(x - y)\n    if diff - C[v1][r] * C[v2][r] > best:\n        mp[state] = res\n        return res\n    if v1 < r or v2 < r:\n        sum_v = v1 + v2\n        if v1 >= cntA[sum_v] and v2 >= cntB[sum_v]:\n            v1_new = v1 - cntA[sum_v]\n            v2_new = v2 - cntB[sum_v]\n            res = C[v1_new + v2_new][v1_new]\