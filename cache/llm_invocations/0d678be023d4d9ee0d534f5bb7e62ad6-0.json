).count('1')\n        if bc < logn:\n            fa[bc][i] = a[i] if i < len(a) else 0\n    # forward transform on each row\n    for i in range(logn):\n        transform(fa[i], n, p, 0)\n    # for each column, compute pow_convol\n    for i in range(n):\n        va = [fa[j][i] for j in range(logn)]\n        vb = pow_convol(va, k, p)\n        for j in range(logn):\n            fc[j][i] = vb[j]\n    # inverse transform on each row\n    for i in range(logn):\n        transform(fc[i], n, p, 1)\n    # extract result\n    res = [0] * n\n    for i in range(n):\n        bc = bin(i).count('1')\n        if bc < logn:\n            res[i] = fc[bc][i]\n    return res\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    nn = n\n    # compute f mapping\n    f = {}\n    # iterate over submasks of n\n    i = 0\n    while True:\n        if (n & i) == i:\n            t = 0\n            for j in range(20):\n                if (n >> j) & 1:\n                    t <<= 1\n                    t |= (i >> j) & 1\n            f[t] = i\n            nn = t\n        if i == n:\n            break\n        i = (i - n) & n  # next submask\n    # if n is odd\n    if n & 1:\n        print(pow(k, n, p))\n        return\n    # precompute factorials\n    maxn = 1000005\n    fac = [1] * (maxn)\n    for i in range(1, maxn):\n        fac[i] = fac[i-1] * i % p\n    ifac = [1] * (maxn)\n    ifac[maxn-1] = pow(fac[maxn-1], p-2, p)\n    for i in range(maxn-2, -1, -1):\n        ifac[i] = ifac[i+1] * (i+1) % p\n    # build vector a\n    a = [0] * (nn + 1)\n    for i in range(nn + 1):\n        a[i] = ifac[f[i]]\n    res = pow(k, n, p)\n    a_conv = subset_pow_convol(a, k, p)\n    sub = a_conv[nn] * fac[n] % p\n    res = (res - sub) % p\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.1934269170742482e-05, 0.0, -2.38418550