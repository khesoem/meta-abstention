}\nvoid _W(const char &x) { putchar(x); }\nvoid _W(const char *x) { printf(\"%s\", x); }\ntemplate<class T,class U> void _W(const pair<T,U> &x) {_W(x.first); putchar(' '); _W(x.second);}\ntemplate<class T> void _W(const vector<T> &x) { for (auto i = x.begin(); i != x.end(); _W(*i++)) if (i != x.cbegin()) putchar(' '); }\nvoid W() {}\ntemplate<class T, class... U> void W(const T &head, const U &... tail) { _W(head); putchar(sizeof...(tail) ? ' ' : '\\n'); W(tail...); }\n\nconst int INF = 1034567890;\nconst int MAX_EDGE_NUM = 1000000;\nconst int MAX_NODE_NUM = 100000;\n\nstruct Edge {\n    int y, c, v, ty, next;\n} edges[MAX_EDGE_NUM];\nint head[MAX_NODE_NUM];\nint edge_cnt;\nint C, d, sink;\nint dist[MAX_NODE_NUM], prev_edge[MAX_NODE_NUM], in_queue[MAX_NODE_NUM];\nint queue_buf[10000000];\n\nvoid init_flow(int _sink) {\n    sink = _sink;\n    for (int i = 0; i <= sink; ++i) head[i] = -1;\n    edge_cnt = 0;\n}\n\nvoid add_edge(int x, int y, int cap, int cost, int type) {\n    edges[edge_cnt] = {y, cap, cost, type, head[x]};\n    head[x] = edge_cnt++;\n    edges[edge_cnt] = {x, 0, (type == 1) ? -C + d : -cost, type, head[y]};\n    head[y] = edge_cnt++;\n}\n\nint augment() {\n    for (int i = 0; i <= sink; ++i) dist[i] = INF, in_queue[i] = 0;\n    dist[sink] = INF;\n    int qh = 0, qt = 0;\n    queue_buf[qt++] = 0;\n    dist[0] = 0;\n    in_queue[0] = 1;\n    while (qh < qt) {\n        int x = queue_buf[qh++];\n        in_queue[x] = 0;\n        for (int r = head[x]; r != -1; r = edges[r].next) {\n            if (edges[r].c > 0 && dist[x] + edges[r].v < dist[edges[r].y]) {\n                dist[edges[r].y] = dist[x] + edges[r].v;\n                prev_edge[edges[r].y] = r;\n                if (!in_queue[edges[r].y]) {\n                    in_queue[edges[r].y] = 1;\n                    queue_buf[qt++] = edges[r].y;\n                }\n            }\n        }\n    }\n    if (dist[sink] == INF) return -1;\n    int cur = sink;\n    while (cur) {\n        int r = prev_edge[cur];\n        if (edges[r].ty == 1) {\n            edges[r].v += 2 * d;\n            edges[r ^ 1].v -= 2 * d;\n        }\n        edges[r].c--;\n        edges[r ^ 1].c++;\n        cur = edges[r ^ 1].y;\n    }\n    return dist[sink];\n}\n\nint solve(int num_flow) {\n    int total = 0;\n    for (int i = 0; i < num_flow; ++i) total += augment();\n    return total;\n}\n\nint main() {\n    int n, m, k;\n    R(n, m, k, C, d);\n    init_flow(n * 100 + 1);\n    for (int i = 1; i <= k; ++i) {\n        int x;\n        R(x);\n        add_edge(0, x, 1, 0, 0);\n    }\n    for (int i = 1; i <= 99; ++i) {\n        add_edge(1 + i * n, 100 * n + 1, INF, 0, 0);\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= 99; ++j) {\n            add_edge(i + (j - 1) * n, i + j * n, INF, C, 0);\n        }\n    }\n    for (int i = 1; i <= m; ++i) {\n        int x, y;\n        R(x, y);\n        for (int j = 1; j <= 99; ++j) {\n            add_edge(x + (j - 1) * n, y + j * n, INF, C + d, 1);\n            add_edge(y + (j - 1) * n, x + j * n, INF, C + d, 1);\n        }\n    }\n    W(solve(k));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nINF = 1034567890\n\ndef solve_flow():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); C = next(it); d = next(it)\n    sink = n * 100 + 1\n    # initialize graph\n    head = [-1] * (sink + 1)\n    edges = []  # each edge: [y, c, v, ty, next]\n    edge_cnt = 0\n\n    def add_edge(x, y, cap, cost, ty):\n        nonlocal edge_cnt\n        edges.append([y, cap, cost, ty, head[x]])\n        head[x] = edge_cnt\n        edge_cnt += 1\n        # reverse edge\n        rev_cost = -C + d if ty == 1 else -cost\n        edges.append([x, 0, rev_cost, ty, head[y]])\n        head[y] = edge_cnt\n        edge_cnt += 1\n\n    # source