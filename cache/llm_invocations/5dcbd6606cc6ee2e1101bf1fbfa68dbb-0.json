       p = [0] * (self.n + 1)\n        a_flow = [0] * (self.n + 1)\n\n        d[s] = 0\n        inq[s] = 1\n        p[s] = 0\n        a_flow[s] = INF\n        q = deque([s])\n\n        while q:\n            u = q.popleft()\n            inq[u] = 0\n\n            for idx in self.g[u]:\n                ee = self.e[idx]\n                if ee.cap > ee.flow and d[ee.to] > d[u] + ee.cost:\n                    d[ee.to] = d[u] + ee.cost\n                    p[ee.to] = idx\n                    a_flow[ee.to] = min(a_flow[u], ee.cap - ee.flow)\n                    if not inq[ee.to]:\n                        q.append(ee.to)\n                        inq[ee.to] = 1\n\n        if d[t] == INF:\n            return False\n\n        flow[0] += a_flow[t]\n        cost[0] += d[t] * a_flow[t]\n        u = t\n        while u != s:\n            ee = self.e[p[u]]\n            ee.flow += a_flow[t]\n            self.e[p[u] ^ 1].flow -= a_flow[t]\n            u = ee.from_\n\n        return True\n\n    def min_cost(self, s, t):\n        flow = [0]\n        cost = [0]\n        while self.bellman(s, t, flow, cost):\n            pass\n        return cost[0]\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    start_positions = [0] * (k + 1)\n    for i in range(1, k + 1):\n        start_positions[i] = next(it)\n\n    start_point = 0\n    end_point = n * 100 + 1\n\n    solver = MCMF()\n    solver.init(end_point)  # Actually need up to end_point, but we allocate size\n\n    for i in range(1, k + 1):\n        solver.add(start_point, 1 + (start_positions[i] - 1) * 100, 1, 0)\n\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            p = (i - 1) * 100\n            solver.add(p + j, p + j + 1, INF, c)\n\n    for i in range(1, 101):\n        solver.add(i, end_point, INF, 0)\n\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n    