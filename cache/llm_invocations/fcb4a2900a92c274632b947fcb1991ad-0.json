w(long b, int e) {\n        long res = 1;\n        for (; e > 0; e >>= 1, b = b * b % MOD) {\n            if ((e & 1) == 1) {\n                res = res * b % MOD;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n        \n        if (k == 0) {\n            System.out.println(fastPow(p, p - 1));\n            return;\n        }\n        if (k == 1) {\n            System.out.println(fastPow(p, p));\n            return;\n        }\n        \n        boolean[] vis = new boolean[p];\n        int len = 1;\n        long cur = k % p;\n        vis[(int)cur] = true;\n        \n        for (;;) {\n            cur = (cur * k) % p;\n            if (vis[(int)cur]) {\n                break;\n            }\n            vis[(int)cur] = true;\n            len++;\n        }\n        \n        int cycles = (p - 1) / len;\n        System.out.println(fastPow(p, cycles));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012230125139467418, -1.7881377516459906e-06, -2.3841855067985307e-07, -0.0003849719068966806, -1.537788011773955e-05, -0.011061654426157475, -0.029912173748016357, -8.940656698541716e-06, -4.768370445162873e-07, -2.682172998902388e-05, -0.0028054662980139256, -8.487341256113723e-05, -0.13356105983257294, -3.4689302992774174e-05, -3.802703940891661e-05, -2.264974000354414e-06, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1444026313256472e-05, 0.0, -2.3841855067985307e-07, -2.9802276912960224e-06, 0.0, 0.0, -4.768370445162873e-07, 0.0, 0.0, -0.008204684592783451, -5.602820692729438e-06, -0.0017032414907589555, -2.264974000354414e-06, -4.529942543740617e-06, -2.062299427052494e-05, -8.40390202938579e-05, -0.00462047103792429, 0.0, -0.008396442979574203, -4.2676016164477915e-05, -1.5497195136049413e-06, 0.0, -5.924526340095326e-05, -6.9141146923357155e-06, -1.1920