{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nusing pii = pair<int, int>;\nusing pll = pair<ll, ll>;\n#define fore(i, a, b) for (int i = (a); i < (b); ++i)\n#define pb push_back\n#define SZ(a) ((int)(a).size())\n#define mset(a, b) memset(a, b, sizeof(a))\n#define ALL(a) (a).begin(), (a).end()\n#define fst first\n#define snd second\n\nconst int MAXN = 50015;\nconst int SRC = MAXN - 1;\nconst int SNC = MAXN - 2;\n\nusing tf = ll;\nconst tf INFFLUJO = 1e14;\nusing tc = ll;\nconst tc INFCOSTO = 1e14;\n\nstruct edge {\n    int u, v;\n    tf cap, flow;\n    tc cost;\n    tf rem() const { return cap - flow; }\n};\n\nint nodes = MAXN;\nvector<int> g[MAXN];\nvector<edge> edges;\n\nvoid add_edge(int u, int v, tf cap, tc cost) {\n    g[u].pb(SZ(edges));\n    edges.pb({u, v, cap, 0, cost});\n    g[v].pb(SZ(edges));\n    edges.pb({v, u, 0, 0, -cost});\n}\n\ntc dist[MAXN];\ntc mncost;\nint pre[MAXN];\ntf cap[MAXN];\ntf mxflow;\nbool in_queue[MAXN];\n\nvoid flow(int s, int t) {\n    mset(in_queue, 0);\n    mxflow = mncost = 0;\n    while (true) {\n        fill(dist, dist + nodes, INFCOSTO);\n        dist[s] = 0;\n        mset(pre, -1);\n        pre[s] = 0;\n        mset(cap, 0);\n        cap[s] = INFFLUJO;\n        queue<int> q;\n        q.push(s);\n        in_queue[s] = true;\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n            in_queue[u] = false;\n            for (int idx : g[u]) {\n                edge &E = edges[idx];\n                if (E.rem() && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                    dist[E.v] = dist[u] + E.cost;\n                    pre[E.v] = idx;\n                    cap[E.v] = min(cap[u], E.rem());\n                    if (!in_queue[E.v]) {\n                        q.push(E.v);\n                        in_queue[E.v] = true;\n                    }\n                }\n            }\n        }\n        if (pre[t] < 0) break;\n        mxflow += cap[t];\n        mncost += cap[t] * dist[t];\n        for (int v = t; v != s; v = edges[pre[v]].u) {\n            edges[pre[v]].flow += cap[t];\n            edges[pre[v] ^ 1].flow -= cap[t];\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    ll n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    int MAXT = n + k;\n    vector<int> a(k);\n    fore(i, 0, k) {\n        cin >> a[i];\n        --a[i];\n        add_edge(SRC, a[i] * MAXT, 1, 0);\n    }\n    fore(j, 0, MAXT) add_edge(j, SNC, k, 0);\n    fore(i, 0, m) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        fore(j, 0, MAXT - 1) fore(K, 1, k + 1) {\n            add_edge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1));\n        }\n        fore(j, 0, MAXT - 1) fore(K, 1, k + 1) {\n            add_edge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1));\n        }\n    }\n    fore(i, 0, n) {\n        fore(j, 0, MAXT - 1) fore(K, 1, k + 1) {\n            add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c);\n        }\n    }\n    flow(SRC, SNC);\n    cout << mncost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    MAXN = 50015\n    SRC = MAXN - 1\n    SNC = MAXN - 2\n    \n    INFFLUJO = 10**14\n    INFCOSTO = 10**14\n    \n    MAXT = n + k\n    \n    # Initialize graph structures\n    g = [[] for _ in range(MAXN)]\n    edges = []\n    \n    def add_edge(u, v, cap, cost):\n        idx1 = len(edges)\n        g[u].append(idx1)\n        edges.append({'u': u, 'v': v, 'cap': cap, 'flow': 0, 'cost': cost})\n        \n        idx2 = len(edges)\n        g[v].append(idx2)\n        edges.append({'u': v, 'v': u, 'cap': 0, 'flow': 0, 'cost': -cost})\n    \n    # Read a values\n    a = []\n    for _ in range(k):\n        val = int(next(it)) - 1\n        a.append(val)\n        add_edge(SRC, val * MAXT, 1, 0)\n    \n    # Add edges from time nodes to sink\n    for j in range(MAXT):\n        add_edge(j, SNC, k, 0)\n    \n    # Read edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                cost = c + d * (2 * K - 1)\n                add_edge(x * MAXT + j, y * MAXT + j + 1, 1, cost)\n                add_edge(y * MAXT + j, x * MAXT + j + 1, 1, cost)\n    \n    # Add self-loop edges\n    for i in range(n):\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c)\n    \n    # Flow algorithm\n    dist = [INFCOSTO] * MAXN\n    pre = [-1] * MAXN\n    cap = [0] * MAXN\n    in_queue = [False] * MAXN\n    \n    mxflow = 0\n    mncost = 0\n    \n    while True:\n        # Reset for BFS\n        dist = [INFCOSTO] * MAXN\n        pre = [-1] * MAXN\n        cap = [0] * MAXN\n        in_queue = [False] * MAXN\n        \n        dist[SRC] = 0\n        pre[SRC] = 0\n        cap[SRC] = INFFLUJO\n        q = deque()\n        q.append(SRC)\n        in_queue[SRC] = True\n        \n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            for idx in g[u]:\n                E = edges[idx]\n                if E['cap'] - E['flow'] > 0 and dist[E['v']] > dist[u] + E['cost'] + 1e-9:\n                    dist[E['v']] = dist[u] + E['cost']\n                    pre[E['v']] = idx\n                    cap[E['v']] = min(cap[u], E['cap'] - E['flow'])\n                    if not in_queue[E['v']]:\n                        q.append(E['v'])\n                        in_queue[E['v']] = True\n        \n        if pre[SNC] < 0:\n            break\n        \n        mxflow += cap[SNC]\n        mncost += cap[SNC] * dist[SNC]\n        \n        v = SNC\n        while v != SRC:\n            idx = pre[v]\n            edges[idx]['flow'] += cap[SNC]\n            edges[idx ^ 1]['flow'] -= cap[SNC]\n            v = edges[idx]['u']\n    \n    print(mncost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000129691296024248, -7.152555099310121e-07, -1.1920928244535389e-07, -0.010202989913523197, -0.0033553512766957283, -5.960462772236497e-07, -0.00014184899919200689, -0.00022206225548870862, -1.9073468138230965e-06, -0.0008081507403403521, -0.023324526846408844, -0.058475311845541, -0.04292294383049011, -4.6967357775429264e-05, -7.152555099310121e-07, -0.03190409764647484, -0.0030069397762417793, -8.34461570775602e-06, -2.0265558760002023e-06, -0.05778098851442337, -0.0009199915803037584, -1.311301275563892e-06, -0.00031728477915748954, 0.0, -0.0009457168052904308, -8.344646857949556e-07, -0.0003895000845659524, -0.00015031162183731794, -0.08894185721874237, -2.3841830625315197e-06, -0.58