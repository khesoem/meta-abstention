{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MOD = 1000000007;\nint p[10][10];\n\nint modPow(int a, int e) {\n    int res = 1;\n    while (e) {\n        if (e & 1) res = (long long)res * a % MOD;\n        a = (long long)a * a % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    int inv100 = modPow(100, MOD - 2);\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            int per;\n            cin >> per;\n            p[i][j] = (long long)per * inv100 % MOD;\n        }\n    for (int i = n; i < 6; ++i) p[i][i] = 1;\n\n    vector<int> com;\n    for (int x = 0; x < 64; ++x)\n        if (__builtin_popcount((unsigned)x) == 3) com.push_back(x);\n\n    vector<int> f(1 << 20, 0), g(1 << 20, 0);\n\n    auto build = [&](bool right) {\n        int base = right ? 3 : 0;\n        for (int code = 0; code < (1 << 18); ++code) {\n            bool b[6][6] = {};\n            int bit = 0, mask = 0, prob = 1;\n            for (int r = 0; r < 6; ++r)\n                for (int c = base; c < base + 3; ++c, ++bit) {\n                    if (code & (1 << bit)) {\n                        b[r][c] = true;\n                        prob = (long long)prob * p[r][c] % MOD;\n                    } else {\n                        prob = (long long)prob * (1 - p[r][c] + MOD) % MOD;\n                    }\n                }\n            for (int id = 0; id < 20; ++id) {\n                int rows[3], cnt = 0;\n                int rowMask = right ? (com[id] ^ 63) : com[id];\n                for (int r = 0; r < 6; ++r)\n                    if (rowMask & (1 << r)) rows[cnt++] = r;\n                bool ok = false;\n                for (int ca = 0; ca < 3 && !ok; ++ca) {\n                    if (!b[rows[0]][base + ca]) continue;\n                    for (int cb = 0; cb < 3 && !ok; ++cb) {\n                        if (cb == ca || !b[rows[1]][base + cb]) continue;\n                        for (int cc = 0; cc < 3 && !ok; ++cc) {\n                            if (cc == ca || cc == cb) continue;\n                            if (b[rows[2]][base + cc]) ok = true;\n                        }\n                    }\n                }\n                if (ok) mask |= (1 << id);\n            }\n            if (right) g[mask] = (g[mask] + prob) % MOD;\n            else f[mask] = (f[mask] + prob) % MOD;\n        }\n    };\n\n    build(false);\n    build(true);\n\n    for (int bit = 0; bit < 20; ++bit)\n        for (int mask = (1 << 20) - 1; mask >= 0; --mask)\n            if (mask & (1 << bit))\n                g[mask] = (g[mask] + g[mask ^ (1 << bit)]) % MOD;\n\n    int ans = 0, full = (1 << 20) - 1;\n    for (int mask = 0; mask <= full; ++mask)\n        ans = (ans + (long long)f[mask] * g[full ^ mask]) % MOD;\n\n    cout << (1 - ans + MOD) % MOD << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef mod_pow(a, e):\n    res = 1\n    while e:\n        if e & 1:\n            res = (res * a) % MOD\n        a = (a * a) % MOD\n        e >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    inv100 = mod_pow(100, MOD - 2)\n\n    # p is 6x6, but we only need up to 6 rows/cols\n    p = [[0]*6 for _ in range(6)]\n    for i in range(n):\n        for j in range(n):\n            per = int(next(it))\n            p[i][j] = (per * inv100) % MOD\n    for i in range(n, 6):\n        p[i][i] = 1\n\n    # list of numbers with exactly 3 bits set (0..63)\n    com = [x for x in range(64) if x.bit_count() == 3]\n\n    # precompute row indices for each combination (left and right)\n    left_rows = []\n    right_rows = []\n    for x in com:\n        left_rows.append([r for r in range(6) if (x >> r) & 1])\n        right_rows.append([r for r in range(6) if ((x ^ 63) >> r) & 1])\n\n    f = [0] * (1 << 20)\n    g = [0] * (1 << 20)\n\n    def build(right):\n        base = 3 if right else 0\n        rows_list = right_rows if right else left_rows\n        for code in range(1 << 18):\n            # build b matrix (6 rows, 3 columns)\n            b = [[False]*3 for _ in range(6)]\n            prob = 1\n            bit = 0\n            for r in range(6):\n                for c in range(3):\n                    col = base + c\n                    if (code >> bit) & 1:\n                        b[r][c] = True\n                        prob = (prob * p[r][col]) % MOD\n                    else:\n                        prob = (prob * (1 - p[r][col] + MOD)) % MOD\n                    bit += 1\n            mask = 0\n            for id_ in range(20):\n                rows = rows_list[id_]\n                ok = False\n                # brute force over all assignments of columns to rows\n                for ca in range(3):\n                    if not b[rows[0]][ca]:\n                  