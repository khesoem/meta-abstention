 0:\n        return 0\n    if memo2[t][f][h][r] != -1:\n        return memo2[t][f][h][r]\n    ans = 0\n    if t == 1:\n        for i in range(fifty - f + 1):\n            if i * 50 > K:\n                break\n            for j in range(hundred - h + 1):\n                if i == 0 and j == 0:\n                    continue\n                totalW = i * 50 + j * 100\n                if totalW > K:\n                    break\n                ways = (nCk(fifty - f, i, comb) * nCk(hundred - h, j, comb)) % MOD\n                res = solve2(0, f + i, h + j, r - 1, fifty, hundred, K, memo2, comb)\n                ans = (ans + (ways * res) % MOD) % MOD\n    else:\n        for i in range(f + 1):\n            if i * 50 > K:\n                break\n            for j in range(h + 1):\n                if i == 0 and j == 0:\n                    continue\n                totalW = i * 50 + j * 100\n                if totalW > K:\n                    break\n                ways = (nCk(f, i, comb) * nCk(h, j, comb)) % MOD\n                res = solve2(1, f - i, h - j, r - 1, fifty, hundred, K, memo2, comb)\n                ans = (ans + (ways * res) % MOD) % MOD\n    memo2[t][f][h][r] = ans\n    return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    N = int(data[idx]); idx += 1\n    K = int(data[idx]); idx += 1\n    fifty = 0\n    hundred = 0\n    for _ in range(N):\n        val = int(data[idx]); idx += 1\n        if val == 50:\n            fifty += 1\n        else:\n            hundred += 1\n    \n    memo = [[[-1 for _ in range(hundred + 1)] for _ in range(fifty + 1)] for _ in range(2)]\n    \n    min_val = solve(0, fifty, hundred, fifty, hundred, K, memo)\n    \n    if min_val >= 10**6:\n        print(-1)\n        print(0)\n    else:\n        memo2 = [[[[ -1 for _ in range(min_val + 1)] for _ in range(hundred + 1)] for _ in range(fifty + 1)] for _ in range(2)]\n        comb = [[-1 for _ in range(101)] for _ in range(101)]\n