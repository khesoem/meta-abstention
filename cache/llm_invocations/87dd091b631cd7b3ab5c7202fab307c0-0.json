nclass MinCostFlow {\npublic:\n    vector<vector<int>> adj;\n    int n, m, max_m;\n    vector<int> pi, dd, bb;\n    vector<int> uu, vv, uv, cost;\n    vector<int> cap;\n    vector<int> qq;\n    int nq, head, cnt;\n    vector<bool> inq;\n\n    MinCostFlow(int n, int max_m) : n(n), max_m(max_m), m(0) {\n        adj.resize(n);\n        pi.resize(n);\n        dd.resize(n, 0);\n        bb.resize(n);\n        uu.resize(max_m);\n        vv.resize(max_m);\n        uv.resize(max_m);\n        cost.resize(max_m);\n        cap.resize(2 * max_m, 0);\n        nq = 1;\n        qq.resize(nq);\n        head = cnt = 0;\n        inq.resize(n, false);\n    }\n\n    void link(int u, int v, int c, int w) {\n        int h = m++;\n        uu[h] = u;\n        vv[h] = v;\n        uv[h] = u ^ v;\n        cost[h] = w;\n        cap[h << 1] = c;\n        cap[(h << 1) | 1] = 0;\n        adj[u].push_back(h << 1);\n        adj[v].push_back((h << 1) | 1);\n    }\n\n    void enqueue(int v) {\n        if (inq[v]) return;\n        if (head + cnt == nq) {\n            if (cnt * 2 <= nq) {\n                for (int i = 0; i < cnt; i++) qq[i] = qq[head + i];\n                head = 0;\n            } else {\n                nq *= 2;\n                vector<int> tmp(nq);\n                for (int i = 0; i < cnt; i++) tmp[i] = qq[head + i];\n                qq.swap(tmp);\n                head = 0;\n            }\n        }\n        qq[head + cnt++] = v;\n        inq[v] = true;\n    }\n\n    int dequeue() {\n        int u = qq[head++];\n        cnt--;\n        inq[u] = false;\n        return u;\n    }\n\n    bool spfa(int s, int t) {\n        fill(pi.begin(), pi.end(), INF);\n        pi[s] = 0;\n        head = cnt = 0;\n        enqueue(s);\n        while (cnt > 0) {\n            int u = dequeue();\n            int d = dd[u] + 1;\n            for (int h_ : adj[u]) {\n                if (cap[h_] > 0) {\n                    int h = h_ >> 1;\n                    int p = pi[u] + ((h_ & 1) == 0 ? cost[h] : -cost[h]