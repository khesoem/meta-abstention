nt i = vn; i-- > 0; ) {\n                from[i] = -1;\n            }\n            from[s] = s;\n            flow[s] = cap;\n            Queue<Integer> bfs = new LinkedList<>();\n            bfs.offer(s);\n            while (!bfs.isEmpty()) {\n                int x = bfs.poll();\n                if (x == t) {\n                    for (aug = 1, result += flow[t]; x != s; x = from[x]) {\n                        int prev = from[x];\n                        edge[prev].put(x, edge[prev].getOrDefault(x, 0) - flow[t]);\n                        edge[x].put(prev, edge[x].getOrDefault(prev, 0) + flow[t]);\n                    }\n                    break;\n                }\n                for (Map.Entry<Integer, Integer> e : edge[x].entrySet()) {\n                    if (e.getValue() >= cap && from[e.getKey()] == -1) {\n                        from[e.getKey()] = x;\n                        flow[e.getKey()] = Math.min(e.getValue(), flow[x]);\n                        bfs.offer(e.getKey());\n                    }\n                }\n            }\n        }\n        return result;\n    }\n\n    static int enc(int x, int y, int t) {\n        return x + y * n + t * n * n + 2;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        scanner.nextLine();\n\n        int res = 0;\n        for (int i = 0; i < n; i++) {\n            String line = scanner.nextLine();\n            for (int j = 0; j < n; j++) {\n                buf[i][j] = line.charAt(j);\n                if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                    edge[0].put(enc(i, j, 0), buf[i][j] - '0');\n                }\n            }\n        }\n\n        for (int i = 0; i < n; i++) {\n            String line = scanner.nextLine();\n            for (int j = 0; j < n; j++) {\n                buf[i][j] = line.charAt(j);\n            }\n        }\n\n        int[] dx = {-1, 0, 1, 0};\n        int