n\t\tans=(ans-solve(0,n)+p)%p;\n\t}\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn, k, p = map(int, input().split())\n\ndef fpow(a, b):\n    ans = 1\n    t = a\n    while b:\n        if b & 1:\n            ans = (ans * t) % p\n        t = (t * t) % p\n        b >>= 1\n    return ans\n\ndef lowbit(x):\n    return x & (-x)\n\n# Initialize factorials and inverses\ndef init(n):\n    fac = [1] * (n + 1)\n    inv = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = (fac[i - 1] * i) % p\n    inv[n] = fpow(fac[n], p - 2)\n    for i in range(n, 0, -1):\n        inv[i - 1] = (inv[i] * i) % p\n    return fac, inv\n\n# Recursive DP with memoization\ndef solve(cur, S, f, fac, inv, n, k, p):\n    if f[cur][S] != -1:\n        return f[cur][S]\n    if S == 0:\n        res = fac[n]\n        for i in range(1, cur + 1):\n            res = (res * (k - i + 1)) % p\n        f[cur][S] = res\n        return res\n    res = 0\n    U = S - lowbit(S)\n    T = U\n    while T:\n        res = (res + inv[S - T] * solve(cur + 1, T, f, fac, inv, n, k, p)) % p\n        T = (T - 1) & U\n    res = (res + inv[S] * solve(cur + 1, 0, f, fac, inv, n, k, p)) % p\n    f[cur][S] = res\n    return res\n\nans = pow(k, n, p)\nif n % 2 == 0:\n    fac, inv = init(n)\n    # Initialize memoization table\n    size = 1 << n\n    f = [[-1] * size for _ in range(n + 2)]\n    ans = (ans - solve(0, size - 1, f, fac, inv, n, k, p) + p) % p\n\nprint(ans)\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.01162678562104702, -0.00040338258258998394, -2.45848218582978e-06, -1.3782830137643032e-05, -0.29769402742385864, -0.6370294094085693, -1.7432603272027336e-06, -7.896309739408025e-07, 0.0, -3.128163257315464e-07, -7.896309739408025e-07, -7.896309739408025e-07, -1.3856492842023727e-06, 0.0, 0.0, -2.696889623621246e-06, -0.000751259