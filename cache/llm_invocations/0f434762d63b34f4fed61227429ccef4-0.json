r = p[cur];\n\t}\n\tans += d[t];\n}\n\nvoid add_edge(int x, int y, int c, int cost)\n{\n\tg[x].push_back(e.size());\n\te.push_back(edge(y, c, 0, cost));\n\tg[y].push_back(e.size());\n\te.push_back(edge(x, 0, 0, -cost));\n}\n\nint main()\n{\n\tint n, m, k, c, d;\n\tcin >> n >> m >> k >> c >> d;\n\tfor(int i = 0; i < k; i++)\n\t{\n\t\tint x;\n\t\tcin >> x;\n\t\tadd_edge(s, x, 1, 0);\n\t}\n\tint tt = 101;\n\tfor(int i = 0; i < tt; i++)\n\t\tadd_edge(1 + i * n, t, k, i * c);\n\tfor(int i = 0; i < m; i++)\n\t{\n\t\tint x, y;\n\t\tcin >> x >> y;\n\t\tfor(int i = 0; i < tt - 1; i++)\n\t\t\tfor(int j = 0; j < k; j++)\n\t\t\t{\n\t\t\t\tadd_edge(x + i * n, y + i * n + n, 1, d * (j * 2 + 1));\n\t\t\t\tadd_edge(y + i * n, x + i * n + n, 1, d * (j * 2 + 1));\n\t\t\t}\n \n \t}\n \tfor(int i = 0; i < n; i++)\n \t\tfor(int j = 0; j < tt - 1; j++)\n \t\t\tadd_edge(i + j * n, i + j * n + n, k, 0);\n \tfor(int i = 0; i < k; i++)\n \t\tpush_flow();\n \tcout << ans << endl;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d_val = int(next(it))\n    \n    # Initialize data structures\n    e = []\n    g = [[] for _ in range(14043)]\n    \n    def add_edge(x, y, cap, cost):\n        g[x].append(len(e))\n        e.append({'y': y, 'c': cap, 'f': 0, 'cost': cost})\n        g[y].append(len(e))\n        e.append({'y': x, 'c': 0, 'f': 0, 'cost': -cost})\n    \n    def rem(x):\n        return e[x]['c'] - e[x]['f']\n    \n    def push_flow():\n        INF64 = 10**18\n        d = [INF64] * 14043\n        p = [-1] * 14043\n        pe = [-1] * 14043\n        inq = [0] * 14043\n        \n        s = 14041\n        t = 14042\n        d[s] = 0\n        q =