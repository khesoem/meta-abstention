ng nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n    }\n\n    public static void main(String[] args) {\n        FastScanner in = new FastScanner(System.in);\n        int n = in.nextInt();\n        int B = in.nextInt();\n\n        int[] arr = new int[n];\n        for (int i = 0; i < n; i++) {\n            arr[i] = in.nextInt();\n        }\n\n        int even = 0, odd = 0;\n        List<Integer> list = new ArrayList<>();\n        for (int i = 0; i < n - 1; i++) {\n            if (arr[i] % 2 == 0) even++;\n            else odd++;\n            if (even == odd) {\n                list.add(Math.abs(arr[i] - arr[i + 1]));\n            }\n        }\n\n        list.sort(Comparator.naturalOrder());\n        int total = 0;\n        for (int val : list) {\n            if (B < val) break;\n            B -= val;\n            total++;\n        }\n        System.out.println(total);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass FastScanner:\n    def __init__(self, f):\n        if isinstance(f, str):\n            try:\n                self.br = open(f, 'r')\n            except FileNotFoundError:\n                raise\n        else:\n            self.br = sys.stdin\n            \n        self.buffer = deque()\n    \n    def next_line(self):\n        try:\n            return self.br.readline().rstrip('\\n')\n        except Exception:\n            return None\n    \n    def next(self):\n        while not self.buffer:\n            line = self.next_line()\n            if line is None:\n                return None\n            self.buffer.extend(line.split())\n        return self.buffer.popleft()\n    \n    def next_int(self):\n        return int(self.next())\n    \n    def next_long(self):\n       