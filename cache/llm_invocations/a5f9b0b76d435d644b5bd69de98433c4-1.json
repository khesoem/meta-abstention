elf.curChar >= self.snumChars:\n            self.curChar = 0\n            try:\n                self.snumChars = self.stream.readinto(self.buf)\n            except:\n                raise EOFError(\"Input mismatch\")\n            if self.snumChars <= 0:\n                return -1\n        res = self.buf[self.curChar]\n        self.curChar += 1\n        return res\n\n    def nextInt(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.isSpaceChar(c):\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n        return res * sgn\n\n    def nextLong(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.isSpaceChar(c):\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n        return res * sgn\n\n    def nextIntArray(self, n):\n        a = [0] * n\n        for i in range(n):\n            a[i] = self.nextInt()\n        return a\n\n    def readString(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        res = []\n        while not self.isSpaceChar(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def nextLine(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        res = []\n        while not self.isEndOfLine(c):\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\n    def isSpaceChar(self, c):\n        return c == ord(' ') or c == ord('\\n') or c == ord('\\r') or c == ord('\\t') or c == -1\n\n    def isEndOfLine(self, c):\n        return c == ord('\\n') or c == ord('\\r') or c == -1\n\n\ndef main():\n    in_reader = InputReader(sys.stdin.buffer)\n    n = in_reader.nextInt()\n    b = in_reader.nextInt()\n    a = in_reader.nextIntArray(n)\n    \n    odd = [0] * (n + 1)\n    even = [0] * (n + 1)\n    odd[0] = 0\n    even[0] = 0\n    \n    for i in range(1, n + 1):\n        if a[i - 1] % 2 == 1:\n            odd[i] = odd[i - 1] + 1\n            even[i] = even[i - 1]\n        else:\n            odd[i] = odd[i - 1]\n            even[i] = even[i - 1] + 1\n    \n    prev = 0\n    cost = []\n    \n    for i in range(1, n):\n        oc = odd[i] - odd[prev]\n        ec = even[i] - even[prev]\n        if oc == ec:\n            heapq.heappush(cost, abs(a[i] - a[i - 1]))\n            prev = i\n    \n    total_sum = 0\n    count = 0\n    \n    while cost and total_sum <= b:\n        total_sum += heapq.heappop(cost)\n        count += 1\n    \n    if count == 0:\n        print(\"0\")\n    else:\n        if not cost and total_sum <= b:\n            print(count)\n        else:\n            print(count - 1)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.709961988031864e-05, -2.0265558760002023e-06, -3.576278118089249e-07, -0.00012838016846217215, -0.007963573560118675, -0.007609074469655752, -0.054897766560316086, -0.20641233026981354, -0.010006265714764595, -0.001328062848187983, -3.969590397900902e-05, -1.1920922133867862e-06, -7.152555099310121e-07, -4.768370445162873e-07, -7.152555099310121e-07, -5.8412379075889476e-06, -1.4305104514278355e-06, -3.576278118089249e-07, -1.4305104514278355e-06, -1.1920928244535389e-07, -3.0517112463712692e-05, -5.745722592109814e-05, -4.768370445162873e-07, -5.960462772236497e-07, -4.410734163684538e-06, 0.0, -6.508615479106084e-05, -0.001192930736579001, -7.152555099310121e-07, -1.9073468138230965e-06, -0.0008276851149275899, -1.4305104514278355e-06, -0.01499100774526596, -0.0019298041006550193, 0.0, -8.344646857949556e-07, -8.34464