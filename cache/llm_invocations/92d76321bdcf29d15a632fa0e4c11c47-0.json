[n - j - 1];\n                if (c1 == 'a' + i) {\n                    if (c1 == c2) {\n                        g.addEdge(charOffSet + i, pairOffSet + j, 1, -Integer.max(b[j], b[n - j - 1]));\n                    } else {\n                        g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[j]);\n                    }\n                } else {\n                    if (c2 == 'a' + i) {\n                        g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[n - j - 1]);\n                    } else {\n                        g.addEdge(charOffSet + i, pairOffSet + j, 1, 0);\n                    }\n                }\n            }\n        }\n        for (int i = 0; i < n / 2; ++i) {\n            g.addEdge(pairOffSet + i, sink, 2, 0);\n        }\n\n        int[] ans = g.getMinCostMaxFlow();\n        System.out.println(-ans[1]);\n    }\n\n    public static class OutputWriter {\n        private final PrintWriter writer;\n\n        public OutputWriter(OutputStream outputStream) {\n            writer = new PrintWriter(new BufferedWriter(new OutputStreamWriter(outputStream)));\n        }\n\n        public OutputWriter(Writer writer) {\n            this.writer = new PrintWriter(writer);\n        }\n\n        public void print(Object... objects) {\n            for (int i = 0; i < objects.length; i++) {\n                if (i != 0) writer.print(' ');\n                writer.print(objects[i]);\n            }\n        }\n\n        public void println(Object... objects) {\n            print(objects);\n            writer.println();\n        }\n\n        public void printf(String format, Object... objects) {\n            writer.printf(format, objects);\n        }\n\n        public void close() {\n            writer.close();\n        }\n\n        public void flush() {\n            writer.flush();\n        }\n    }\n\n    static class InputReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public InputReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        String nextLine() {\n            String str = \"\";\n            try {\n                str = br.readLine();\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n            return str;\n        }\n    }\n}\n\nclass Graph {\n    private int vNum;\n    private int src;\n    private int sink;\n    private List<Edge>[] adj;\n    private int[] p;\n    private int[] d;\n    private int[] pot; // potentials for Dijkstra\n\n    private static class Edge {\n        int to, rev, cap, cost;\n        Edge(int to, int rev, int cap, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    public Graph(int vNum, int src, int sink) {\n        this.vNum = vNum;\n        this.src = src;\n        this.sink = sink;\n        adj = new List[vNum];\n        for (int i = 0; i < vNum; i++) adj[i] = new ArrayList<>();\n        p = new int[vNum];\n        d = new int[vNum];\n        pot = new int[vNum];\n    }\n\n    public void addEdge(int from, int to, int capacity, int cost) {\n        adj[from].add(new Edge(to, adj[to].size(), capacity, cost));\n        adj[to].add(new Edge(from, adj[from].size() - 1, 0, -cost));\n    }\n\n    private boolean findCheapestPath() {\n        Arrays.fill(d, Integer.MAX_VALUE);\n        Arrays.fill(p, -1);\n        d[src] = 0;\n        boolean[] inQueue = new boolean[vNum];\n        Queue<Integer> q = new LinkedList<>();\n        q.add(src);\n        inQueue[src] = true;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = false;\n            for (Edge e : adj[u]) {\n                if (e.cap > 0 && d[u] + e.cost < d[e.to]) {\n                    d[e.to] = d[u] + e.cost;\n                    p[e.to] = u;\n                    if (!inQueue[e.to]) {\n                        q.add(e.to);\n                        inQueue[e.to] = true;\n                    }\n                }\n            }\n        }\n        return p[sink] != -1;\n    }\n\n    private int[] augmentPath(int from, int to, int flow) {\n        int pathCost = 0;\n        for (int cur = to; cur != from; cur = p[cur]) {\n            int prev = p[cur];\n            for (Edge e : adj[prev]) {\n                if (e.to == cur && e.cap > 0) {\n                    flow = Math.min(flow, e.cap);\n                    break;\n                }\n            }\n        }\n        for (int cur = to; cur != from; cur = p[cur]) {\n            int prev = p[cur];\n            for (Edge e : adj[prev]) {\n                if (e.to == cur && e.cap > 0) {\n                    e.cap -= flow;\n                    adj[cur].get(e.rev).cap += flow;\n                    pathCost += e.cost * flow;\n                    break;\n                }\n            }\n        }\n        return new int[]{flow, pathCost};\n    }\n\n    public int[] getMinCostMaxFlow() {\n        int flow = 0;\n        int totalCost = 0;\n        while (findCheapestPath()) {\n            int[] result = augmentPath(src, sink, Integer.MAX_VALUE);\n            flow += result[0];\n            totalCost += result[1];\n        }\n        return new int[]{flow, totalCost};\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Graph:\n    class Edge:\n        def __init__(self, to, rev, cap, cost):\n            self.to = to\n            self.rev = rev\n            self.cap = cap\n            self.cost = cost\n\n    def __init__(self, vNum, src, sink):\n        self.vNum = vNum\n        self.src = src\n        self.sink = sink\n        self.adj = [[] for _ in range(vNum)]\n        self.p = [-1] * vNum\n        self.d = [0] * vNum\n        self.pot = [0] * vNum\n\n    def addEdge(self, fr, to, capacity, cost):\n        self.adj[fr].append(self.Edge(to, len(self.adj[to]), capacity, cost))\n        self.adj[to].append(self.Edge(fr, len(self.adj[fr]) - 1, 0, -cost))\n\n    def findCheapestPath(self):\n        INF = 10**15\n        self.d = [INF] * self.vNum\n        self.p = [-1] * self.vNum\n        self.d[self.src] = 0\n        inQueue = [False] * self.vNum\n        q = deque()\n        q.append(self.src)\n        inQueue[self.src] = True\n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            for e in self.adj[u]:\n                if e.cap > 0 and self.d[u] + e.cost < self.d[e.to]:\n                    self.d[e.to] = self.d[u] + e.cost\n                    self.p[e.to] = u\n                    if not inQueue[e.to]:\n                        q.append(e.to)\n                        inQueue[e.to] = True\n        return self.p[self.sink] != -1\n\n    def augmentPath(self, fr, to, flow):\n        pathCost = 0\n        # find min residual capacity along path\n        cur = to\n        while cur != fr:\n            prev = self.p[cur]\n            for e in self.adj[prev]:\n                if e.to == cur and e.cap > 0:\n                    flow = min(flow, e.cap)\n                    break\n            cur = prev\n        # update edges\n        cur = to\n        while cur != fr:\n            prev = self.p[cur]\n            for e in self.adj[prev]:\n                if e.to == cur and e.cap > 0:\n                    e.cap -= flow\n                    self.adj[cur][e.rev].cap += flow\n                    pathCost += e.cost * flow\n                    break\n            cur = prev\n        return [flow, pathCost]\n\n    def getMinCostMaxFlow(self):\n        flow = 0\n        totalCost = 0\n        while self.findCheapestPath():\n            result = self.augmentPath(self.src, self.sink, 10**9)\n            flow += result[0]\n            totalCost += result[1]\n        return [flow, totalCost]\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    s = next(it)\n    string = list(s)\n    letters = 26\n    letCount = [0] * letters\n    for ch in string:\n        letCount[ord(ch) - ord('a')] += 1\n    b = [0] * n\n    for i in range(n):\n        b[i] = int(next(it))\n\n    source = 0\n    charOffSet = 1\n    pairOffSet = charOffSet + letters\n    sinkOffSet = pairOffSet + n // 2\n    sink = sinkOffSet\n    vNum = sinkOffSet + 1\n\n    g = Graph(vNum, source, sink)\n    for i in range(letters):\n        g.addEdge(source, charOffSet + i, letCount[i], 0)\n        for j in range(n // 2):\n            c1 = string[j]\n            c2 = string[n - j - 1]\n            if c1 == chr(ord('a') + i):\n                if c1 == c2:\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -max(b[j], b[n - j - 1]))\n                else:\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[j])\n            else:\n                if c2 == chr(ord('a') + i):\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[n - j - 1])\n                else:\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, 0)\n    for i in range(n // 2):\n        g.addEdge(pairOffSet + i, sink, 2, 0)\n\n    ans = g.getMinCostMaxFlow()\n    print(-ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.311301275563892e-06, -2.5033