), 0));\n        for (int i = 0; i < (int)dp.size(); ++i) {\n            ll sum = 0;\n            for (int j = 0; j < (int)dp[0].size(); ++j) {\n                sum = (sum + dp[i][j]) % mod;\n                if (sum == 0) sum += mod;\n                sums[i][j] = sum;\n            }\n        }\n\n        vector<ll> fact(501*501, 0);\n        fact[0] = fact[1] = 1;\n        for (int i = 2; i < (int)fact.size(); ++i) {\n            fact[i] = (fact[i-1] * i) % mod;\n        }\n\n        vector<vector<ll>> ncr(501, vector<ll>(501, 0));\n        ncr[0][0] = 1;\n        for (int i = 1; i < 501; ++i) {\n            ncr[i][0] = 1;\n            for (int j = 1; j < 501; ++j) {\n                ncr[i][j] = (ncr[i-1][j] + ncr[i-1][j-1]) % mod;\n                if (ncr[i][j] == 0) ncr[i][j] += mod;\n            }\n        }\n\n        ll res = 0;\n        for (int i = 0; i <= n-2; ++i) {\n            int cnt = n - i;\n            int pre = n - cnt;\n            ll com = (ncr[n][pre] * fact[pre]) % mod;\n            if (com == 0) com += mod;\n            ll sum = 0;\n\n            vector<ll>& last = dp[cnt-2];\n            ll ssum = 0;\n            ll total = 0;\n            for (int j = 2; j < (int)dp[0].size(); ++j) {\n                total = (total + sums[cnt-2][j-2] * (cnt-1)) % mod;\n                if (total == 0) total += mod;\n\n                sum = (sum + last[j] * total) % mod;\n                if (sum == 0) sum += mod;\n\n                ssum = (ssum + sums[cnt-2][j-2]) % mod;\n                if (j - cnt - 1 >= 0) {\n                    ssum = (ssum - sums[cnt-2][j-cnt-1] + mod) % mod;\n                }\n                if (ssum == 0) ssum += mod;\n\n                total = (total - ssum + mod) % mod;\n                if (total == 0) total += mod;\n            }\n            res = (res + sum * com) % mod;\n            if (res == 0) res += mod;\n        }\n        cout << (res % mod) << endl;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(n