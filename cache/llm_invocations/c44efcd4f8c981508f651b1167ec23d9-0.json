turn d[t] != INF;\n}\n\nint dfs(int v, int curFlow) {\n    if (v == t) return curFlow;\n\n    for (int &i = ptr[v]; i < (int)g[v].size(); ++i) {\n        int to = g[v][i].to;\n        int cf = g[v][i].c - g[v][i].f;\n\n        if (d[to] == d[v] + 1 && cf > 0) {\n            int add = dfs(to, min(curFlow, cf));\n            if (add) {\n                g[v][i].f += add;\n                g[to][g[v][i].rev].f -= add;\n                return add;\n            }\n        }\n    }\n    return 0;\n}\n\nint dinica() {\n    int flow = 0;\n    while (buildLevNet()) {\n        memset(ptr, 0, sizeof(ptr));\n        int add;\n        while ((add = dfs(s, INF)) != 0) flow += add;\n    }\n    return flow;\n}\n\nint dst[N][N][N][N], tbad;\nchar a[N][N], b[N][N];\npii bad;\nqueue<pii> go;\n\nconst int X[] = {-1, 1, 0, 0};\nconst int Y[] = {0, 0, -1, 1};\n\nbool check(pii v) {\n    return v.first >= 0 && v.first < n && v.second >= 0 && v.second < n &&\n           a[v.first][v.second] != 'Y' && a[v.first][v.second] != 'Z';\n}\n\nvoid bfs(int xs, int ys) {\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            dst[xs][ys][i][j] = INF;\n\n    dst[xs][ys][xs][ys] = 0;\n    go.push(make_pair(xs, ys));\n\n    while (!go.empty()) {\n        pii v = go.front(); go.pop();\n\n        if (dst[xs][ys][v.first][v.second] == dst[bad.first][bad.second][v.first][v.second] &&\n            (bad.first != xs || bad.second != ys))\n            continue;\n\n        for (int k = 0; k < 4; ++k) {\n            int nx = v.first + X[k];\n            int ny = v.second + Y[k];\n            pii nv = make_pair(nx, ny);\n\n            if (check(nv) && dst[xs][ys][nx][ny] == INF &&\n                dst[xs][ys][v.first][v.second] + 1 <= dst[bad.first][bad.second][nx][ny]) {\n                dst[xs][ys][nx][ny] = dst[xs][ys][v.first][v.second] + 1;\n                go.push(nv);\n            }\n        }\n    }\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &tbad);\n\n    int px = 0, py = 0;\n  