ogprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```python\nimport sys\nimport math\n\n# ---------- sieve ----------\ndef sieve_eratosthenes(n):\n    \"\"\"return list of primes up to n (inclusive)\"\"\"\n    if n < 2:\n        return []\n    limit = n\n    is_prime = bytearray(b'\\x01') * (limit + 1)\n    is_prime[0:2] = b'\\x00\\x00'\n    for i in range(2, int(limit ** 0.5) + 1):\n        if is_prime[i]:\n            step = i\n            start = i * i\n            is_prime[start:limit+1:step] = b'\\x00' * ((limit - start) // step + 1)\n    return [i for i, v in enumerate(is_prime) if v]\n\n# ---------- PrimeCounter ----------\nclass PrimeCounter:\n    def __init__(self, n):\n        # n is the upper bound for which pi(x) will be queried\n        self.primes = sieve_eratosthenes(int(math.sqrt(n)) * 100)\n        s = self.primes[-1] if self.primes else 0  # actual max prime in cache\n        # we need to cover numbers up to s\n        self.cachelimit = s\n        # bit array: each int holds 64 bits, bit i set if i is prime\n        self.isp = [0] * ((s >> 6) + 1)\n        for p in self.primes:\n            self.isp[p >> 6] |= 1 << p\n        # cumulative counts per 64-bit block\n        self.xcums = [0] * (len(self.isp) + 1)\n        for i in range(len(self.isp)):\n            self.xcums[i+1] = self.xcums[i] + self.isp[i].bit_count()\n        self.picache = {}\n\n    def pi(self, x):\n        if x <= self.cachelimit:\n            ix = int(x)\n            block = ix >> 6\n            offset = ix & 63\n            # count bits <= offset (inclusive)\n            mask = (1 << (offset + 1)) - 1\n            return self.xcums[block] + (self.isp[block] & mask).bit_count()\n        cached = self.picache.get(x)\n        if cached is not None:\n            return cached\n        A = self.pi(int(math.isqrt(math.isqrt(x))))\n        ret = A + self.phi(x, A) - self.P2(x, A) - self.P3(x, A) - 1\n        self.picache[x] = ret\n        return ret\n\n    def phi(self, x, A):\n        if A == 0:\n            return x\n        if x <= self.primes[A-1] * self.primes[A-1]:\n            return self.pi(x) - A + 1\n        ret = x\n        for i in range(A-1, -1, -1):\n            ret -= self.phi(x // self.primes[i], i)\n        return ret\n\n    def P2(self, x, A):\n        B = self.pi(int(math.isqrt(x)))\n        ret = 0\n        for i in range(A, B):\n            ret += self.pi(x // self.primes[i])\n        ret -= (B - A) * (B + A - 1) // 2\n        return ret\n\n    def P3(self, x, A):\n        C = self.pi(int(round(x ** (1/3))))  # integer cube root\n        ret = 0\n        for i in range(A, C):\n            xi = x // self.primes[i]\n            B = self.pi(int(math.isqrt(xi)))\n            for j in range(i, B):\n                ret += self.pi(xi // self.primes[j]) - j\n        return ret\n\n# ---------- main ----------\ndef solve():\n    n = int(sys.stdin.readline().strip())\n    ans = 0\n    primes = sieve_eratosthenes(400000)\n    ml = PrimeCounter(n // 2)\n    for i, p in enumerate(primes):\n        plus = ml.pi(n // p) - (i + 1)\n        if plus <= 0:\n            break\n        ans += plus\n    for p in primes:\n        if p * p * p <= n:\n            ans += 1\n        else:\n            break\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n```", "token_logprobs": [-0.4761745035648346, -1.1920928244535389e-07, -0.00020740265608765185, -8.702239938429557e-06, -0.00012337400403339416, -0.0005747812101617455, -0.00020358874462544918, -1.9073468138230965e-06, -0.06198957562446594, -0.47422271966934204, -0.47567176818847656, -6.09140915912576e-05, -0.39598706364631653, -0.588928759098053, -0.00042083943844772875, -1.7881377516459906e-06, -7.986990567587782e-06, -0.06953809410333633, -0.00016080040950328112, 0.0, 0.0, -0.061968397349119186, -0.038050249218940735, 0.0, -0.314095675945282, -0.3267287611961365, -1.3828182090946939e-05, -1.1920928244535389e-07, -0.000554288737475872, -0.47