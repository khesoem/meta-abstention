ong long cur = (ll)a[i] * i % MOD;\n        for (int j = 1; j < i; j++) {\n            cur -= (ll)b[j] * a[i - j] % MOD * j % MOD;\n            cur %= MOD;\n        }\n        if (cur < 0) cur += MOD;\n        b[i] = cur * pwr(i, MOD - 2) % MOD;\n    }\n}\n\nvoid poly_exp(int *a, int *b, int n) {\n    b[0] = 1;\n    for (int i = 1; i <= n; i++) {\n        long long cur = 0;\n        for (int j = 1; j <= i; j++) {\n            cur += (ll)a[j] * b[i - j] % MOD * j % MOD;\n            cur %= MOD;\n        }\n        b[i] = cur * pwr(i, MOD - 2) % MOD;\n    }\n}\n\nint main() {\n    scanf(\"%d%d%d\", &L, &K, &MOD);\n    int all = pwr(K, L);\n    if (L & 1) {\n        printf(\"%d\\n\", all);\n        return 0;\n    }\n\n    fac[0] = 1;\n    for (int i = 1; i <= L; i++) fac[i] = (ll)fac[i - 1] * i % MOD;\n    inv[L] = pwr(fac[L], MOD - 2);\n    for (int i = L - 1; i >= 0; i--) inv[i] = (ll)inv[i + 1] * (i + 1) % MOD;\n\n    for (int s = 1; s <= L; s++) cnt[s] = cnt[s ^ (s & -s)] + 1;\n\n    int n = 0;\n    for (int i = 0; i <= 18; i++)\n        if ((L >> i) & 1) bit[++n] = 1 << i;\n\n    len = 1 << n;\n\n    for (int i = 0; i < len; i++) {\n        int s = 0;\n        for (int j = 1; j <= n; j++)\n            if ((i >> (j - 1)) & 1) s += bit[j];\n        g[cnt[i]][i] = inv[s];\n    }\n\n    for (int i = 0; i <= n; i++) fwt(g[i], len);\n\n    for (int s = 0; s < len; s++) {\n        for (int i = 0; i <= n; i++) h[i] = g[i][s];\n        poly_ln(h, p, n);\n        for (int i = 0; i <= n; i++) p[i] = (ll)p[i] * K % MOD;\n        poly_exp(p, h, n);\n        for (int i = 0; i <= n; i++) f[i][s] = h[i];\n    }\n\n    ifwt(f[n], len);\n\n    int ans = (ll)f[n][len - 1] * fac[L] % MOD;\n    ans = (all - ans + MOD) % MOD;\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef pwr(x, y, mod):\n    res = 1\n 