{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following PyPy 3 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original PyPy 3 code you have to translate:\n<original_code>\nfrom functools import lru_cache\nimport itertools\n\ndef invnum(seq):\n    N = len(seq)\n    res = 0\n    for i in range(N):\n        for j in range(i+1, N):\n            if seq[i] > seq[j]:\n                res += 1\n    return res\n\ndef naive(N, k, flag):\n    res = 0\n    for p in itertools.permutations(range(N), N):\n        for q in itertools.permutations(range(N), N):\n            if ((p < q) or (not(flag))) and (invnum(p) - invnum(q) > k):\n                res += 1\n    return res\n\nn, mod = map(int, input().split())\n\n# Use dictionary-based memoization with explicit state tracking\nmemo = {}\n\ndef solve(N, k, flag):\n    key = (N, k, flag)\n    if key in memo:\n        return memo[key]\n    \n    if N == 1:\n        res = -1\n        if flag:\n            res = 0\n        else:\n            if k < 0:\n                res = 1\n            else:\n                res = 0\n        memo[key] = res\n        return res\n    \n    invnum_INF = (N * (N - 1)) // 2\n    \n    if k < -invnum_INF - 1:\n        res = solve(N, -invnum_INF - 1, flag)\n        memo[key] = res\n        return res\n    \n    if k >= invnum_INF:\n        memo[key] = 0\n        return 0\n    \n    res = 0\n    \n    for delta in range(-N + 1, N):\n        if flag and (delta > 0):\n            continue\n        wt = min(N - delta, delta + N)\n        res += solve(N - 1, k - delta, (delta == 0) & flag) * wt\n        res %= mod\n    \n    memo[key] = res % mod\n    return res % mod\n\nans = solve(n, 0, 1) % mod\nprint(ans)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <map>\n#include <algorithm>\nusing namespace std;\n\nint invnum(const vector<int>& seq) {\n    int N = seq.size();\n    int res = 0;\n    for (int i = 0; i < N; i++) {\n        for (int j = i + 1; j < N; j++) {\n            if (seq[i] > seq[j]) {\n                res++;\n            }\n        }\n    }\n    return res;\n}\n\nlong long solve(int N, long long k, bool flag, int mod, map<tuple<int, long long, bool>, long long>& memo) {\n    auto key = make_tuple(N, k, flag);\n    if (memo.find(key) != memo.end()) {\n        return memo[key];\n    }\n    \n    if (N == 1) {\n        long long res = -1;\n        if (flag) {\n            res = 0;\n        } else {\n            if (k < 0) {\n                res = 1;\n            } else {\n                res = 0;\n            }\n        }\n        memo[key] = res % mod;\n        return res % mod;\n    }\n    \n    int invnum_INF = (N * (N - 1)) / 2;\n    \n    if (k < -invnum_INF - 1) {\n        long long res = solve(N, -invnum_INF - 1, flag, mod, memo);\n        memo[key] = res % mod;\n        return res % mod;\n    }\n    \n    if (k >= invnum_INF) {\n        memo[key] = 0;\n        return 0;\n    }\n    \n    long long res = 0;\n    \n    for (int delta = -N + 1; delta < N; delta++) {\n        if (flag && (delta > 0)) {\n            continue;\n        }\n        int wt = min(N - delta, delta + N);\n        res = (res + solve(N - 1, k - delta, (delta == 0) && flag, mod, memo) * wt) % mod;\n    }\n    \n    memo[key] = res % mod;\n    return res % mod;\n}\n\nint main() {\n    int n, mod;\n    cin >> n >> mod;\n    \n    map<tuple<int, long long, bool>, long long> memo;\n    \n    long long ans = solve(n, 0, true, mod, memo) % mod;\n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00010132275929208845, -4.410734163684538e-06, -1.1920922133867862e-06, -3.0874729418428615e-05, -2.3841855067985307e-07, -0.0013054428854957223, -2.3841855067985307e-07, -6.079655122448457e-06, -5.960462772236497e-07, -0.12827029824256897, -1.1920928244535389e-07, -2.50339189733495e-06, -2.7418097943154862e-06, -0.003404418472200632, -2.3841855067985307e-07, -0.001929447171278298, -4.410734163684538e-06, -0.21220606565475464, -0.016035286709666252, -0.47412973642349243, -1.0609570381348021e-05, -1.6689286894688848e-06, -8.344646857949556e-07, -0.7291382551193237, -0.22742418944835663, -3.242440288886428e-05, -0.03702056407928467, -1.0490362910786644e-05, -7.152555099310121e-07, -1.9192511899746023e-05, -7.033323527139146e-06, -2.9802276912960224e-06, 0.0, -2.3841855067985307e-07, -3.576278118089249e-07, -4.5536911784438416e-05, 0.0, -9.65590606938349e-06, 0.0, -2.264974000354414e-06, 0.0, -0.0021856960374861956, -1.1920928244535389e-07, 0.0, 0.0, -4.768370445162873e-07, -1.5497195136049413e-06, 0.0, -2.3841855067985307e-07, -2.9802276912960224e-06, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, -2.3841855067985307e-07, -5.960462772236497e-07, -0.0297507643699646, -1.0728830375228426e-06, 0.0, -1.311301275563892e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -4.768370445162873e-07, -0.001032772590406239, 0.0, 0.0, 0.0, -3.3378546504536644e-06, 0.0, -3.576278118089249e-07, -2.3841855067985