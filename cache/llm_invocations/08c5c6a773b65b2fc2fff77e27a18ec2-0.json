d) / d;\n            if (mid_val < target) lo = mid;\n            else hi = mid;\n        }\n        \n        long long cand = (fraction_diff(lo, d, x, y) > fraction_diff(hi, d, x, y)) ? hi : lo;\n        if (fraction_diff(cand, d, x, y) < fraction_diff(best_num, best_den, x, y)) {\n            best_num = cand;\n            best_den = d;\n        }\n    }\n    \n    cout << best_num << \"/\" << best_den;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static long gcd(long a, long b) {\n        if (b == 0) return a;\n        return gcd(b, a % b);\n    }\n\n    public static long lcm(long a, long b) {\n        return a / gcd(a, b) * b;\n    }\n\n    public static double fraction_diff(long num1, long den1, long num2, long den2) {\n        long common_den = lcm(den1, den2);\n        long n1 = common_den / den1 * num1;\n        long n2 = common_den / den2 * num2;\n        return Math.abs(n1 - n2) / (double) common_den;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        \n        long best_num = 0;\n        long best_den = 1;\n        double target = (double) x / y;\n        \n        for (long d = 1; d <= n; ++d) {\n            long lo = 1, hi = 1000000;\n            while (hi - lo > 1) {\n                long mid = (lo + hi) >> 1;\n                double mid_val = (double) mid / d;\n                if (mid_val < target) lo = mid;\n                else hi = mid;\n            }\n            \n            long cand = (fraction_diff(lo, d, x, y) > fraction_diff(hi, d, x, y)) ? hi : lo;\n            if (fraction_diff(cand, d, x, y) < fraction_diff(best_num, best_den, x, y)) {\n                best_num = c