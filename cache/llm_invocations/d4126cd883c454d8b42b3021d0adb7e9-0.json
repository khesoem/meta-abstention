= modpow(100, MOD - 2)\n    for i in range(n):\n        for j in range(n):\n            p = int(next(it))\n            prob[i][j + n] = (p * inv100) % MOD\n\n    if n == 1:\n        print(prob[0][1])\n        return\n\n    m1 = n // 2\n    m2 = n - m1\n\n    # enumerate masks with popcount m1 and m2\n    sub1 = []\n    sub2 = []\n    idx_left = [-1] * (1 << n)\n    idx_right = [-1] * (1 << n)\n    cnt1 = 0\n    cnt2 = 0\n    for mask in range(1 << n):\n        if bin(mask).count('1') == m1:\n            idx_left[mask] = cnt1\n            cnt1 += 1\n            sub1.append(mask)\n        if bin(mask).count('1') == m2:\n            idx_right[mask] = cnt2\n            cnt2 += 1\n            sub2.append(mask)\n\n    # rev array: size 1<<cnt2\n    rev = [0] * (1 << cnt2)\n    for i, mask in enumerate(sub2):\n        complement = ((1 << n) - 1) ^ mask\n        left_idx = idx_left[complement]\n        for big in range(1 << cnt2):\n            if big & (1 << i):\n                rev[big] |= (1 << left_idx)\n\n    # left side vertices\n    l1 = list(range(m1))\n    l2 = list(range(m1, n))\n    r = list(range(n, 2 * n))\n\n    # f and g arrays\n    f = [0] * (1 << cnt1)\n    g = [0] * (1 << cnt2)\n\n    compute(f, l1, r, sub1, idx_left, prob, n)\n    compute(g, l2, r, sub2, idx_right, prob, n)\n\n    # SOS DP on f\n    for i in range(cnt1):\n        for mask in range(1 << cnt1):\n            if mask & (1 << i):\n                f[mask] = (f[mask] + f[mask ^ (1 << i)]) % MOD\n\n    ans = 0\n    for mask in range(1, 1 << cnt2):\n        w = (1 - f[((1 << cnt1) - 1) ^ rev[mask]]) % MOD\n        w = (w + MOD) % MOD\n        ans = (ans + w * g[mask]) % MOD\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017677174764685333, -0.02357511967420578, -2.9801878554280847e-05, 0.0, 0.0, -0.0007294139941222966, -0.003992682322859764, -0.10022340714931488, -0.0019376566633582115, -0.00044228785554