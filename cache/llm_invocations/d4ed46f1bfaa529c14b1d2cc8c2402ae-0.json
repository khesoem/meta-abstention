oder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    a = int(data[0])\n    b = int(data[1])\n    n = int(data[2])\n    \n    numerator = 0\n    denominator = 0\n    bestError = float('inf')\n    \n    for i in range(1, n + 1):\n        ratio = a / b\n        candidate1 = int(math.floor(ratio * i))\n        candidate2 = int(math.ceil(ratio * i))\n        \n        error1 = abs(ratio - candidate1 / i)\n        if error1 < bestError:\n            bestError = error1\n            numerator = candidate1\n            denominator = i\n        \n        error2 = abs(ratio - candidate2 / i)\n        if error2 < bestError:\n            bestError = error2\n            numerator = candidate2\n            denominator = i\n    \n    print(f\"{numerator}/{denominator}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-7.962863310240209e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -3.576214658096433e-05, -0.0028318562544882298, -0.575941264629364, -0.0002256377338198945, -0.00042417587246745825, -2.8013790142722428e-05, -2.586808113846928e-05, -5.602820692729438e-06, -1.5139465176616795e-05, -1.6689286894688848e-06, -0.36012592911720276, -1.1920922133867862e-06, -0.3510105311870575, -2.4318398573086597e-05, -0.2014772742986679, -4.172316494077677e-06, -2.6702524337451905e-05, -7.629365427419543e-06, -3.576278118089249e-07, -5.185469490243122e-05, -0.001033010776154697, -1.7881377516459906e-06, -5.960462772236497e-07, -2.3841855067985307e-07, 0.0, -1.4305104514278355e-06, -2.3841855067985307e-07, -2.50339189733495e-06, -8.344646857949556e-07, -2.145764938177308e-06, -1.7881377516459906e-06, -1.5497195136049413e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -9.536738616588991e-07, -1.1920928244535389e-07, -1.0728830375228426e-06, -2.0265558760002023e-06, -2.3841855067985307e-07