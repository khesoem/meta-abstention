lf.h = [-1] * n\n        self.ing = [0] * n\n        self.pre = [0] * n\n        self.to = [0] * 7010010\n        self.ne = [0] * 7010010\n        self.e = 0\n        self.s = n - 2\n        self.t = n - 3\n        self.cap = [0] * 7010010\n        self.dis = [float('inf')] * n\n        self.cost = [0] * 7010010\n\n    def liu(self, u, v, c, w):\n        self.to[self.e] = v\n        self.ne[self.e] = self.h[u]\n        self.cap[self.e] = c\n        self.cost[self.e] = w\n        self.h[u] = self.e\n        self.e += 1\n\n    def link(self, u, v, c, w):\n        self.liu(u, v, c, w)\n        self.liu(v, u, 0, -w)\n\n    def spfa(self):\n        queue = []\n        self.dis = [float('inf')] * self.n\n        self.ing = [0] * self.n\n        queue.append(self.s)\n        self.ing[self.s] = 1\n        self.dis[self.s] = 0\n        while queue:\n            c = queue.pop(0)\n            self.ing[c] = 0\n            for k in range(self.h[c], -1, -1):\n                v = self.to[k]\n                if self.cap[k] > 0:\n                    if self.dis[c] + self.cost[k] < self.dis[v]:\n                        self.dis[v] = self.dis[c] + self.cost[k]\n                        self.pre[v] = k\n                        if not self.ing[v]:\n                            queue.append(v)\n                            self.ing[v] = 1\n        return self.dis[self.t] != float('inf')\n\n    def run(self, s, t):\n        self.s = s\n        self.t = t\n        self.flow = 0\n        self.mincost = 0\n        while self.spfa():\n            pl = float('inf')\n            p, k = t, 0\n            while p != s:\n                pl = min(pl, self.cap[k ^ 1])\n                p = self.to[k ^ 1]\n                k = self.pre[p]\n            self.mincost += pl * self.dis[t]\n            self.flow += pl\n            p = t\n            while p != s:\n                k = self.pre[p]\n                self.cap[k] -= pl\n                self.cap[k ^ 1] += pl\n                p = self.to[k ^ 1]\n      