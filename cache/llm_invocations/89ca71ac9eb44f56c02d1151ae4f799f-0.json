{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define MAXN 260000\n#define IDX(s, m) ((s) * MAXN + (m))\n\nint mod_pow(int a, int e, int mod) {\n    if (e == 0) return 1;\n    int r = mod_pow(a, e / 2, mod);\n    r = (int)(1LL * r * r % mod);\n    if (e & 1) r = (int)(1LL * r * a % mod);\n    return r;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k, mod;\n    cin >> n >> k >> mod;\n    if (n & 1) {\n        cout << mod_pow(k, n, mod) << '\\n';\n        return 0;\n    }\n\n    vector<int> fact(MAXN, 0), inv(MAXN, 0), pc(MAXN, 0);\n    vector<int> dp(18 * MAXN, 0);\n    vector<char> seen(MAXN, 0);\n\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i)\n        fact[i] = (int)(1LL * fact[i - 1] * i % mod);\n\n    inv[n] = mod_pow(fact[n], mod - 2, mod);\n    for (int i = n - 1; i >= 0; --i)\n        inv[i] = (int)(1LL * inv[i + 1] * (i + 1) % mod);\n\n    dp[IDX(0, 0)] = 1;\n    for (int i = 0; i <= n; ++i) {\n        pc[i] = 0;\n        for (int x = i; x; x &= x - 1) ++pc[i];\n    }\n    for (int i = n;; i = (i - 1) & n) {\n        seen[i] = 1;\n        if (i == 0) break;\n    }\n    for (int i = 1; i <= n; ++i) {\n        if (!seen[i]) continue;\n        for (int j = i; j; j = (j - 1) & i) {\n            int lim = min(k, pc[i - j] + 1);\n            for (int s = 1; s <= lim; ++s) {\n                if (dp[IDX(s - 1, i - j)]) {\n                    dp[IDX(s, i)] = (int)((dp[IDX(s, i)] + 1LL * dp[IDX(s - 1, i - j)] * inv[j]) % mod);\n                }\n            }\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= min(k, pc[n]); ++i) {\n        if (dp[IDX(i, n)]) {\n            long long tmp = dp[IDX(i, n)];\n            tmp = tmp * fact[k] % mod;\n            tmp = tmp * inv[k - i] % mod;\n            tmp = tmp * inv[i] % mod;\n            tmp = tmp * fact[n] % mod;\n            ans = (ans + (int)tmp) % mod;\n        }\n    }\n    int res = (mod_pow(k, n, mod) - ans + mod) % mod;\n    cout << res << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n\n    if n & 1:\n        print(pow(k, n, mod))\n        return\n\n    size = n + 1\n    fact = [0] * size\n    inv = [0] * size\n    pc = [0] * size\n    seen = [False] * size\n\n    fact[0] = 1\n    for i in range(1, size):\n        fact[i] = (fact[i - 1] * i) % mod\n\n    inv[n] = pow(fact[n], mod - 2, mod)\n    for i in range(n - 1, -1, -1):\n        inv[i] = (inv[i + 1] * (i + 1)) % mod\n\n    for i in range(size):\n        pc[i] = i.bit_count()\n\n    # s_max = 18 (s from 0 to 17)\n    s_max = 18\n    dp = [[0] * size for _ in range(s_max)]\n    dp[0][0] = 1\n\n    # mark submasks of n\n    sub = n\n    while True:\n        seen[sub] = True\n        if sub == 0:\n            break\n        sub = (sub - 1) & n\n\n    # DP over submasks\n    for i in range(1, size):\n        if not seen[i]:\n            continue\n        j = i\n        while j:\n            lim = min(k, pc[i - j] + 1)\n            for s in range(1, lim + 1):\n                if dp[s - 1][i - j]:\n                    dp[s][i] = (dp[s][i] + dp[s - 1][i - j] * inv[j]) % mod\n            j = (j - 1) & i\n\n    # compute answer\n    ans = 0\n    max_i = min(k, pc[n])\n    for i_val in range(max_i + 1):\n        if dp[i_val][n]:\n            tmp = dp[i_val][n]\n            tmp = (tmp * fact[k]) % mod\n            tmp = (tmp * inv[k - i_val]) % mod\n            tmp = (tmp * inv[i_val]) % mod\n            tmp = (tmp * fact[n]) % mod\n            ans = (ans + tmp) % mod\n\n    res = (pow(k, n, mod) - ans) % mod\n    print(res)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010048838157672435, 0.0, 0.0, -0.002512633567675948, -0.0008104139124043286, 0.0, -0.0007215518853627145, -0.00015817821258679032, -0.00725717144086957, -0.029755277559161186, -6.198863957251888e-06, -7.974783511599526e-05, -2.3841855067985307e-07, -1.5497195136049413e-06, 0.0, -0.0015212640864774585, -2.3841855067985307e-07, -0.0024763653054833412, -8.344646857949556e-07, 0.0, -1.680836794548668e-05, -6.198863957251888e-06, -1.1920928244535389e-07, -0.0009114163694903255, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.861018856492592e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -0.0009121309849433601, 0.0, 0.0, 0.0, -3.576278118089249e-07, -0.029817182570695877, 0.0, -2.3841855067985307e-07, -2.0265373677830212e-05, 0.0, -2.3841855067985307e-07, 0.0, -5.006777428206988e-06, -3.707340147229843e-05, 0.0, -1.8715683836489916e-05, -0.000144709600135684, 0.0, -1.5497195136049413e-06, 0.0, -1.0728830375228426e-06, -0.2014378011226654, -2.3841855067985307e-07, -0.014167092740535736, -9.643566590966657e-05, -0.2519291341304779, -1.1920928244535389e-07, -4.768370445162873e-07, -0.0086314