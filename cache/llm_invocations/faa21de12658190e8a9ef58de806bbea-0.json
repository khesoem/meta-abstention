{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nnamespace IO {\n    template<typename T>\n    inline int Read(T &n) {\n        T k=0, f=1; char c=getchar();\n        while (c<'0' || c>'9') { if (c == '-') f=-1; c=getchar(); }\n        while (c>='0' && c<='9') { k=(k<<3)+(k<<1)+(c-'0'); c=getchar(); }\n        n = k*f; return 0;\n    }\n    template<typename T>\n    inline void Write(T x) {\n        if (x < 0) { putchar('-'); x=-x; }\n        if (x > 9) Write(x/10);\n        putchar(x%10+'0');\n    }\n    template<typename T, typename ...Y>\n    inline int Read(T &x, Y&... y) { return Read(x) | Read(y...); }\n}\n\nconst ll MOD1 = 998244353, MOD2 = 1000000007;\n\nll result, input_n, counter1, prefix_sum[7];\nvector<ll> digit_vals[7];\n\nvoid dfs1(int depth, ll num) {\n    if (depth == 7) return;\n    digit_vals[depth].emplace_back((counter1 - num + MOD1) % MOD1);\n    prefix_sum[depth] = (prefix_sum[depth] + (counter1 - num + MOD1) % MOD1) % MOD2;\n    ++counter1;\n    for (int d = 0; d <= 9; ++d) dfs1(depth + 1, num * 10 + d);\n}\n\nbool is_valid_segment(ll prefix_val) {\n    const ll BOUND = 1000000;\n    return prefix_val * BOUND + 999999 <= input_n && prefix_val * BOUND * 10 > input_n;\n}\n\nll counter2;\nll base_pow[7] = {1, 10, 100, 1000, 10000, 100000, 1000000};\n\nvoid dfs2(int depth, ll current_val) {\n    if (current_val > input_n) return;\n    if (is_valid_segment(current_val)) {\n        for (int i = 0; i <= 6; ++i) {\n            ll diff = (counter2 + 1 - current_val * base_pow[i]) % MOD1;\n            if (diff < 0) diff += MOD1;\n            auto it = lower_bound(digit_vals[i].begin(), digit_vals[i].end(), MOD1 - diff);\n            ll count = distance(it, digit_vals[i].end());\n            result = (result + prefix_sum[i] + diff * (ll)digit_vals[i].size() - MOD1 * count) % MOD2;\n        }\n        counter2 += counter1;\n    } else {\n        ++counter2;\n        ll diff = (counter2 - current_val) % MOD1;\n        if (diff < 0) diff += MOD1;\n        result = (result + diff) % MOD2;\n        for (int d = (depth == 0 ? 1 : 0); d <= 9; ++d) dfs2(depth + 1, current_val * 10 + d);\n    }\n}\n\nint main() {\n    IO::Read(input_n);\n    dfs1(0, 0);\n    for (int i = 0; i <= 6; ++i) sort(digit_vals[i].begin(), digit_vals[i].end());\n    counter2 = -1;\n    dfs2(0, 0);\n    IO::Write(result);\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nsys.setrecursionlimit(1000000)\n\nMOD1 = 998244353\nMOD2 = 1000000007\n\ndef read_int():\n    return int(sys.stdin.readline().strip())\n\ndef write_int(n):\n    if n < 0:\n        sys.stdout.write('-')\n        n = -n\n    if n > 9:\n        write_int(n // 10)\n    sys.stdout.write(str(n % 10))\n\ndef read_multiple():\n    line = sys.stdin.readline().strip().split()\n    return [int(x) for x in line]\n\nresult = 0\ninput_n = 0\ncounter1 = 0\nprefix_sum = [0] * 7\ndigit_vals = [[] for _ in range(7)]\n\ndef dfs1(depth, num):\n    global counter1\n    if depth == 7:\n        return\n    digit_vals[depth].append((counter1 - num + MOD1) % MOD1)\n    prefix_sum[depth] = (prefix_sum[depth] + (counter1 - num + MOD1) % MOD1) % MOD2\n    counter1 += 1\n    for d in range(10):\n        dfs1(depth + 1, num * 10 + d)\n\ndef is_valid_segment(prefix_val):\n    BOUND = 1000000\n    return prefix_val * BOUND + 999999 <= input_n and prefix_val * BOUND * 10 > input_n\n\ncounter2 = 0\nbase_pow = [1, 10, 100, 1000, 10000, 100000, 1000000]\n\ndef dfs2(depth, current_val):\n    global counter2, result\n    if current_val > input_n:\n        return\n    if is_valid_segment(current_val):\n        for i in range(7):\n            diff = (counter2 + 1 - current_val * base_pow[i]) % MOD1\n            if diff < 0:\n                diff += MOD1\n            it = bisect.bisect_left(digit_vals[i], MOD1 - diff)\n            count = len(digit_vals[i]) - it\n            result = (result + prefix_sum[i] + diff * len(digit_vals[i]) - MOD1 * count) % MOD2\n        counter2 += counter1\n    else:\n        counter2 += 1\n        diff = (counter2 - current_val) % MOD1\n        if diff < 0:\n            diff += MOD1\n        result = (result + diff) % MOD2\n        start_d = 1 if depth == 0 else 0\n        for d in range(start_d, 10):\n            dfs2(depth + 1, current_val * 10 + d)\n\ndef main():\n    global input_n, result, counter1, counter2\n    input_n = read_int()\n    dfs1(0, 0)\n    for i in range(7):\n        digit_vals[i].sort()\n    counter2 = -1\n    dfs2(0, 0)\n    write_int(result % MOD2)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012599628826137632, -8.344646857949556e-07, -1.1920928244535389e-07, -0.0005793085438199341, -0.0020950529724359512, -0.2811553180217743, -0.7512837648391724, -0.010374781675636768, -1.4305104514278355e-06, -0.004621776286512613, -0.5218878388404846, -7.152531907195225e-06, -5.709961988031864e-05, -2.288792165927589e-05