_mat(X, Y, n):\n    for i in range(n):\n        for j in range(n):\n            X[i][j] = Y[i][j]\n\ndef mul(X, Y, Z, n, m, p):\n    for i in range(n):\n        for j in range(p):\n            total = 0\n            for k in range(m):\n                total = (total + X[i][k] * Y[k][j]) % MOD\n            Z[i][j] = total\n\ndef precalcA(N, K):\n    n = K + 1\n    # A[0]\n    A0 = [ [ [0]*n for _ in range(n) ] for _ in range(K) ]\n    for x in range(K):\n        for i in range(n):\n            A0[x][i][i] = 1\n        for j in range(n):\n            A0[x][j][x] = 1\n    A = [A0]\n    # P[0] and S[0]\n    P0 = [ [ [0]*n for _ in range(n) ] for _ in range(K) ]\n    S0 = [ [ [0]*n for _ in range(n) ] for _ in range(K) ]\n    copy_mat(P0[0], A0[0], n)\n    copy_mat(S0[K-1], A0[K-1], n)\n    for x in range(1, K):\n        mul(P0[x-1], A0[x], P0[x], n, n, n)\n    for x in range(K-2, -1, -1):\n        mul(A0[x], S0[x+1], S0[x], n, n, n)\n    P = [P0]\n    S = [S0]\n    cnt = 1\n    m = K\n    while m <= N:\n        A_cnt = [ [ [0]*n for _ in range(n) ] for _ in range(K) ]\n        for x in range(K):\n            if x > 0:\n                copy_mat(A_cnt[x], S[cnt-1][x], n)\n                Aux = [ [0]*n for _ in range(n) ]\n                mul(A_cnt[x], P[cnt-1][x-1], Aux, n, n, n)\n                copy_mat(A_cnt[x], Aux, n)\n            else:\n                copy_mat(A_cnt[x], S[cnt-1][x], n)\n        A.append(A_cnt)\n        P_cnt = [ [ [0]*n for _ in range(n) ] for _ in range(K) ]\n        S_cnt = [ [ [0]*n for _ in range(n) ] for _ in range(K) ]\n        copy_mat(P_cnt[0], A_cnt[0], n)\n        copy_mat(S_cnt[K-1], A_cnt[K-1], n)\n        for x in range(1, K):\n            mul(P_cnt[x-1], A_cnt[x], P_cnt[x], n, n, n)\n        for x in range(K-2, -1, -1):\n            mul(A_cnt[x], S_cnt[x+1], S_cnt[x], n, n, n)\n        P.append(P_cnt)\n        S.append(S_cnt)\n        if m > N // K:\n            break\n        m *= K\n        cnt += 1\n    return A, P, S\n\ndef main()