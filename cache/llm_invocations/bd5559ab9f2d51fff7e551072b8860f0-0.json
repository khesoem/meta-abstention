e self._read_buffer() and not self._is_printable_char(self.buffer[self.ptr]):\n            self.ptr += 1\n        return self._read_buffer()\n    \n    def next(self):\n        if not self.has_next():\n            raise StopIteration()\n        sb = []\n        while self._is_printable_char(self.buffer[self.ptr]):\n            sb.append(chr(self.buffer[self.ptr]))\n            self.ptr += 1\n        return ''.join(sb)\n    \n    def next_long(self):\n        if not self.has_next():\n            raise StopIteration()\n        n = 0\n        sign = 1\n        b = self._read_byte()\n        if b == 45:  # '-'\n            sign = -1\n            b = self._read_byte()\n        while self._is_number(b):\n            n = n * 10 + (b - 48)\n            b = self._read_byte()\n        return n * sign\n    \n    def next_int(self):\n        return int(self.next_long())\n    \n    def next_double(self):\n        return float(self.next())\n\nclass IntMath:\n    @staticmethod\n    def gcd(a, b):\n        while a != 0:\n            if (b := b % a) != 0:\n                a, b = b, a % b\n            else:\n                return a\n        return b\n    \n    @staticmethod\n    def gcd_list(arr):\n        ret = arr[0]\n        for i in range(1, len(arr)):\n            ret = IntMath.gcd(ret, arr[i])\n        return ret\n    \n    @staticmethod\n    def pow(a, b):\n        ans = 1\n        mul = a\n        while b > 0:\n            if b & 1:\n                ans *= mul\n            mul *= mul\n            b >>= 1\n        return ans\n    \n    @staticmethod\n    def pow_mod(a, b, mod):\n        if b < 0:\n            b = b % (mod - 1) + mod - 1\n        ans = 1\n        mul = a % mod\n        while b > 0:\n            if b & 1:\n                ans = (ans * mul) % mod\n            mul = (mul * mul) % mod\n            b >>= 1\n        return ans\n\ndef solve():\n    fs = FastScanner()\n    out = sys.stdout\n    \n    n = fs.next_int()\n    k = fs.next_long()\n    MOD = 998244353\n    