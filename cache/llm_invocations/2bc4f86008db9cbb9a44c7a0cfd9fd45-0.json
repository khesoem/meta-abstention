 {\n            if ((exponent & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exponent >>= 1;\n        }\n        return result;\n    }\n\n    static long[][] dp_table = new long[26][250010];\n    static long[] factorial = new long[250010];\n    static long[] inv_factorial = new long[250010];\n    static int[] b = new int[250010];\n\n    static long solve_subproblem(int k, int n, int p) {\n        if (b[n] < k) return 0;\n        if (k == 1) {\n            dp_table[k][n] = inv_factorial[n];\n            return dp_table[k][n];\n        }\n        if (dp_table[k][n] != 0) return dp_table[k][n];\n        int iteration = 0;\n        for (int subset = n & (n - 1); subset != 0; subset = n & (subset - 1)) {\n            if (b[subset] >= k - 1) {\n                dp_table[k][n] = (dp_table[k][n] + solve_subproblem(k - 1, subset, p) * inv_factorial[n ^ subset]) % p;\n                if (++iteration == 18) {\n                    iteration = 0;\n                    dp_table[k][n] %= p;\n                }\n            }\n        }\n        dp_table[k][n] %= p;\n        return dp_table[k][n];\n    }\n\n    static long choose(int n, int m, int p) {\n        return factorial[n] * inv_factorial[m] % p * inv_factorial[n - m] % p;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int p = Integer.parseInt(st.nextToken());\n\n        for (int i = 1; i <= n; i++) {\n            b[i] = b[i >> 1] + (i & 1);\n        }\n\n        long total_sum = fast_pow(k, n, p);\n\n        if ((n & 1) == 1) {\n            System.out.println(total_sum);\n            return;\n        }\n\n        int l = Math.min(k, b[n]);\n\n        factorial[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            factorial[i] = factorial[i - 1] * i % p;\n        }\n\n        inv_factorial[n] = fast_pow(factorial[n], p - 2, p);\n        for (int i = n; i >= 1; i--) {\n            inv_factorial[i - 1] = inv_factorial[i] * i % p;\n        }\n\n        long partial_sum = 0;\n        for (int i = l; i >= 1; i--) {\n            partial_sum = (partial_sum + choose(k, i, p) * solve_subproblem(i, n, p)) % p;\n        }\n\n        total_sum = (total_sum - partial_sum * factorial[n] % p + p) % p;\n        System.out.println(total_sum);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.86750388215296e-05, -1.7881377516459906e-06, -3.576278118089249e-07, -0.0008573431987315416, -2.8132995794294402e-05, -0.34889376163482666, -0.0006441186997108161, -5.125986263010418e-06, -7.390948667307384e-06, -5.173549288883805e-05, -0.003215264528989792, -4.279521817807108e-05, -1.1920922133867862e-06, -5.1616290875244886e-05, -0.02976800501346588, -0.0025452144909650087, -0.10910007357597351, -0.25407305359840393, -0.00011848701251437888, -0.013094505295157433, -4.815939246327616e-05, -0.01815265417098999, 0.0, -2.1457441107486375e-05, 0.0, 0.0, -9.536738616588991e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -6.6756979322235566e-06, -4.887569048150908e-06, -1.0847986231965479e-05, -0.00026306029758416116, -0.004762021824717522, -9.536738616588991e-07, -8.368142152903602e-05, -0.00012337400403339416, -6.9141146923357155e-06, -4.768370445162873e-07, -2.109982233378105e-05, -1.6689286894688848e-06, -2.7417760065873154e-05, -3.3378546504536644e-06, -2.861018856492592e-06, -1.5020257706055418e-05, -3.802703940891661e-05, -0.008858074434101582, -0.00043132537393830717, -2.169585604860913e-05, -3.576278118089249e-07, -2.264974000354414e-06, -0.0003292018664069474, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, -0.005934712942689657, -0.0001411338453181088, -4.2915253288