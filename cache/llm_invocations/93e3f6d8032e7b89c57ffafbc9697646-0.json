    \n    # comb function\n    def comb(a, b):\n        if b < 0 or b > a:\n            return 0\n        return (fac[a] * inv[b] % mod) * inv[a - b] % mod\n    \n    # Calculate result\n    result = (dp.get((1, n), 0) * comb(k, 1)) % mod\n    maxIter = min(17, k)\n    \n    for iter_val in range(2, maxIter + 1):\n        # Initialize dp[iter_val] if not exists\n        # Iterate over masks\n        mask = n\n        while mask:\n            if dp.get((iter_val - 1, mask), 0) == 0:\n                mask = (mask - 1) & n\n                continue\n            complement = n ^ mask\n            sub = complement\n            while sub:\n                new_mask = mask + sub\n                val = dp.get((iter_val - 1, mask), 0) * inv.get(sub, 0)\n                dp[(iter_val, new_mask)] = (dp.get((iter_val, new_mask), 0) + val) % mod\n                sub = (sub - 1) & complement\n            mask = (mask - 1) & n\n        \n        # Modulo for all masks at this iteration\n        mask = n\n        while mask:\n            if (iter_val, mask) in dp:\n                dp[(iter_val, mask)] %= mod\n            mask = (mask - 1) & n\n        \n        result = (result + dp.get((iter_val, n), 0) * comb(k, iter_val)) % mod\n    \n    result = (result * fac[n]) % mod\n    \n    # Calculate total\n    total = qpow(k, n, mod)\n    if n % 2 == 0:\n        total = (total - result + mod) % mod\n    \n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-0.00015937011630740017, -7.152555099310121e-07, -4.768370445162873e-07, -0.35210612416267395, -8.701899787411094e-05, -0.00258635520003736, -0.010301985777914524, -0.5523706674575806, -8.809178689261898e-05, -1.0728830375228426e-06, -0.18453791737556458, -7.152555099310121e-07, -0.015873733907938004, -1.5020257706055418e-05, -0.012583971954882145, -4.172316494077677e-06, -0.10025607794523239, -1.5258672647178173e-05, -5.960462772236497e-07, -0.266535