{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconstexpr ll INF = 1000000000000000000LL;\nconstexpr int MOD = 1000000007;\n\ninline int norm(int x) {\n    x %= MOD;\n    return x < 0 ? x + MOD : x;\n}\n\ninline int mul(int a, int b) {\n    return (int)((ll)a * b % MOD);\n}\n\ninline int binpow(int a, int e) {\n    int r = 1;\n    while (e) {\n        if (e & 1) r = mul(r, a);\n        a = mul(a, a);\n        e >>= 1;\n    }\n    return r;\n}\n\ninline int modinv(int a) {\n    return binpow(a, MOD - 2);\n}\n\nstruct Edge {\n    int to, cap, flow, cost;\n    Edge() : to(0), cap(0), flow(0), cost(0) {}\n    Edge(int t, int c, int f, int co) : to(t), cap(c), flow(f), cost(co) {}\n};\n\nvector<Edge> E;\nconst int MAXN = 1000007;\nvector<int> G[MAXN];\n\nll dist[MAXN];\nint prevv[MAXN], preve[MAXN];\nbool inq[MAXN];\n\nint source = MAXN - 2, sink = MAXN - 1;\n\nint residual(int idx) {\n    return E[idx].cap - E[idx].flow;\n}\n\nvoid shortestPath() {\n    fill(dist, dist + MAXN, INF);\n    fill(prevv, prevv + MAXN, -1);\n    fill(preve, preve + MAXN, -1);\n    fill(inq, inq + MAXN, false);\n    \n    dist[source] = 0;\n    queue<int> q;\n    q.push(source);\n    inq[source] = true;\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = false;\n        \n        for (int idx : G[u]) {\n            if (!residual(idx)) continue;\n            int v = E[idx].to;\n            int cost = E[idx].cost;\n            if (dist[v] > dist[u] + cost) {\n                dist[v] = dist[u] + cost;\n                prevv[v] = u;\n                preve[v] = idx;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    int cur = sink;\n    while (cur != source) {\n        E[preve[cur]].flow++;\n        E[preve[cur] ^ 1].flow--;\n        cur = prevv[cur];\n    }\n}\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    G[u].push_back(E.size());\n    E.emplace_back(v, cap, 0, cost);\n    G[v].push_back(E.size());\n    E.emplace_back(u, 0, 0, -cost);\n}\n\nint n, m, k, c, d;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        --x;\n        addEdge(source, x, 1, 0);\n    }\n    \n    const int TIME_LAYERS = 101;\n    for (int t = 0; t < TIME_LAYERS; ++t) {\n        addEdge(t * n, sink, k, t * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        scanf(\"%d %d\", &x, &y);\n        --x, --y;\n        for (int t = 0; t < TIME_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(x + t * n, y + t * n + n, 1, d * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < TIME_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(y + t * n, x + t * n + n, 1, d * (2 * j + 1));\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < TIME_LAYERS - 1; ++t) {\n            addEdge(i + t * n, i + t * n + n, k, 0);\n        }\n    }\n    \n    ll total = 0;\n    for (int i = 0; i < k; ++i) {\n        shortestPath();\n        total += dist[sink];\n    }\n    \n    printf(\"%lld\\n\", total);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1000000000000000000\nMOD = 1000000007\n\ndef norm(x):\n    x %= MOD\n    return x if x >= 0 else x + MOD\n\ndef mul(a, b):\n    return int((a * b) % MOD)\n\ndef binpow(a, e):\n    r = 1\n    while e:\n        if e & 1:\n            r = mul(r, a)\n        a = mul(a, a)\n        e >>= 1\n    return r\n\ndef modinv(a):\n    return binpow(a, MOD - 2)\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'flow', 'cost')\n    def __init__(self, to=0, cap=0, flow=0, cost=0):\n        self.to = to\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nE = []\nMAXN = 1000007\nG = [[] for _ in range(MAXN)]\n\ndist = [INF] * MAXN\nprevv = [-1] * MAXN\npreve = [-1] * MAXN\ninq = [False] * MAXN\n\nsource = MAXN - 2\nsink = MAXN - 1\n\ndef residual(idx):\n    return E[idx].cap - E[idx].flow\n\ndef shortestPath():\n    global dist, prevv, preve, inq\n    dist = [INF] * MAXN\n    prevv = [-1] * MAXN\n    preve = [-1] * MAXN\n    inq = [False] * MAXN\n    \n    dist[source] = 0\n    q = deque()\n    q.append(source)\n    inq[source] = True\n    \n    while q:\n        u = q.popleft()\n        inq[u] = False\n        \n        for idx in G[u]:\n            if not residual(idx):\n                continue\n            v = E[idx].to\n            cost = E[idx].cost\n            if dist[v] > dist[u] + cost:\n                dist[v] = dist[u] + cost\n                prevv[v] = u\n                preve[v] = idx\n                if not inq[v]:\n                    inq[v] = True\n                    q.append(v)\n    \n    cur = sink\n    while cur != source:\n        E[preve[cur]].flow += 1\n        E[preve[cur] ^ 1].flow -= 1\n        cur = prevv[cur]\n\ndef addEdge(u, v, cap, cost):\n    G[u].append(len(E))\n    E.append(Edge(v, cap, 0, cost))\n    G[v].append(len(E))\n    E.append(Edge(u, 0, 0, -cost))\n\ndef main():\n    global n, m, k, c, d\n    \n    data = list(map(int, sys.stdin.readline().strip().split()))\n    n, m, k, c, d = data\n    \n    for i in range(k):\n        x = int(sys.stdin.readline().strip())\n        x -= 1\n        addEdge(source, x, 1, 0)\n    \n    TIME_LAYERS = 101\n    for t in range(TIME_LAYERS):\n        addEdge(t * n, sink, k, t * c)\n    \n    for i in range(m):\n        data = sys.stdin.readline().strip().split()\n        if not data:\n            continue\n        x, y = int(data[0]), int(data[1])\n        x -= 1\n        y -= 1\n        for t in range(TIME_LAYERS - 1):\n            for j in range(k):\n                addEdge(x + t * n, y + t * n + n, 1, d * (2 * j + 1))\n        for t in range(TIME_LAYERS - 1):\n            for j in range(k):\n                addEdge(y + t * n, x + t * n + n, 1, d * (2 * j + 1))\n    \n    for i in range(n):\n        for t in range(TIME_LAYERS - 1):\n            addEdge(i + t * n, i + t * n + n, k, 0)\n    \n    total = 0\n    for i in range(k):\n        shortestPath()\n        total += dist[sink]\n    \n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001991788885788992, -1.5497195136049413e-06, -4.768370445162873e-07, -0.004622962791472673, -0.004931073635816574, -7.152555099310121e-07, -0.0004328744253143668, -0.0005322470096871257, -7.152555099310121e-07, -0.00012575789878610522, -0.001348301419056952, -0.39084285497665405, -4.768370445162873e-07, -0.00026520551182329655, 0.0, -9.536738616588991e-07, -0.6326794624328613, -1.9192511899746023e-