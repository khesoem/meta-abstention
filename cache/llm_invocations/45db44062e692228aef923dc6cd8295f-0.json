nt cur = target;\n        while (cur != source) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = pred[cur];\n        }\n        ans += dist[target];\n    }\n\n    static void addEdge(int x, int y, int capacity, int cost) {\n        g[x].add(e.size());\n        e.add(new Edge(y, capacity, 0, cost));\n        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n\n    static void inputAndBuildGraph(Scanner sc) {\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        g = new ArrayList[N];\n        for (int i = 0; i < N; i++) g[i] = new ArrayList<>();\n        dist = new long[N];\n        pred = new int[N];\n        pe = new int[N];\n        inq = new int[N];\n\n        source = N - 2;\n        target = N - 1;\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            addEdge(source, x, 1, 0);\n        }\n\n        for (int i = 0; i < timeLayers; i++) {\n            addEdge(i * n, target, k, i * c);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int t = 0; t < timeLayers - 1; t++) {\n                addEdge(x + t * n, y + t * n + n, 1, d * (2 * 0 + 1));\n            }\n            for (int t = 0; t < timeLayers - 1; t++) {\n                addEdge(y + t * n, x + t * n + n, 1, d * (2 * 0 + 1));\n            }\n        }\n    }\n\n    static void solve() {\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < timeLayers - 1; j++) {\n                addEdge(i + j * n, i + j * n + n, k, 0);\n            }\n        }\n        for (int i = 0; i < k; i++) {\n            pushFlow();\n        }\n        System.out.println(ans);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        inputAndBuildGraph(sc);\n        solve();\n    