 int t, int flow) {\n        if (u == t) return flow;\n        for (int& i = ptr[u]; i < (int)adj[u].size(); ++i) {\n            auto& e = adj[u][i];\n            if (level[e.to] == level[u] + 1 && e.cap > 0) {\n                int pushed = dfs(e.to, t, min(flow, e.cap));\n                if (pushed > 0) {\n                    e.cap -= pushed;\n                    adj[e.to][e.rev].cap += pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n\n    int maxFlow(int s, int t) {\n        int total = 0;\n        while (bfs(s, t)) {\n            fill(ptr.begin(), ptr.end(), 0);\n            while (int pushed = dfs(s, t, INF)) {\n                total += pushed;\n            }\n        }\n        return total;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(nullptr);\n    int n, t;\n    cin >> n >> t;\n    vector<string> field(n), capsule(n);\n    int src = 2 * n * n, dst = src + 1;\n    FlowGraph g(2 * n * n + 2);\n    \n    int zx = -1, zy = -1;\n    for (int i = 0; i < n; ++i) {\n        cin >> field[i];\n        for (int j = 0; j < n; ++j) {\n            if (field[i][j] == 'Z') {\n                zx = i; zy = j;\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        cin >> capsule[i];\n        for (int j = 0; j < n; ++j) {\n            if (isdigit(capsule[i][j])) {\n                g.addEdge(i * n + j + n * n, dst, capsule[i][j] - '0');\n            }\n        }\n    }\n    \n    vector<vector<int>> distZ(n, vector<int>(n, INF));\n    queue<pii> q;\n    distZ[zx][zy] = 0;\n    q.push({zx, zy});\n    int dx[] = {-1, 1, 0, 0}, dy[] = {0, 0, -1, 1};\n    \n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        if (distZ[x][y] == t) continue;\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (nx >= 0 && nx < n && ny >= 0 && ny < n && capsule[nx][ny] != 'Y' && distZ[nx][ny] == INF) {\n      