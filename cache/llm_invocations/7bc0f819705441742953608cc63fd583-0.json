ef addEdge(self, u, v, cap):\n        self.adj[u].append(Edge(v, len(self.adj[v]), cap))\n        self.adj[v].append(Edge(u, len(self.adj[u]) - 1, 0))\n    \n    def bfs(self, s, t):\n        self.level = [-1] * self.N\n        q = deque()\n        q.append(s)\n        self.level[s] = 0\n        while q:\n            u = q.popleft()\n            for e in self.adj[u]:\n                if self.level[e.to] == -1 and e.cap > 0:\n                    self.level[e.to] = self.level[u] + 1\n                    q.append(e.to)\n        return self.level[t] != -1\n    \n    def dfs(self, u, t, flow):\n        if u == t:\n            return flow\n        for i in range(self.ptr[u], len(self.adj[u])):\n            self.ptr[u] = i\n            e = self.adj[u][i]\n            if self.level[e.to] == self.level[u] + 1 and e.cap > 0:\n                pushed = self.dfs(e.to, t, min(flow, e.cap))\n                if pushed > 0:\n                    e.cap -= pushed\n                    self.adj[e.to][e.rev].cap += pushed\n                    return pushed\n        return 0\n    \n    def maxFlow(self, s, t):\n        total = 0\n        while self.bfs(s, t):\n            self.ptr = [0] * self.N\n            while True:\n                pushed = self.dfs(s, t, INF)\n                if pushed == 0:\n                    break\n                total += pushed\n        return total\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    n = int(data[idx]); idx += 1\n    t = int(data[idx]); idx += 1\n    field = []\n    for i in range(n):\n        field.append(data[idx]); idx += 1\n    capsule = []\n    for i in range(n):\n        capsule.append(data[idx]); idx += 1\n    \n    src = 2 * n * n\n    dst = src + 1\n    g = FlowGraph(2 * n * n + 2)\n    \n    zx, zy = -1, -1\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                zx, zy = i, j\n    \n    for i in range(n):\n        for j in range(n):\n            if c