nt a=0;a<=m;++a) A[a]=B[a],B[a]=0;\n\t\t}\n\t}\n\tprintf(\"%d\\n\",A[m]);\n\treturn 0;\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n    mod = 1000000007\n\n    # compute digits in base m, s[0] is least significant\n    s = []\n    temp = n\n    while temp:\n        s.append(temp % m)\n        temp //= m\n    num = len(s)\n\n    # Dec function: if x < m, return (x - y) % m, else return m\n    def Dec(x: int, y: int) -> int:\n        if x < m:\n            return (x - y) % m\n        else:\n            return m\n\n    # f[i][a][b] for i = 1..num, a,b = 0..m\n    f = [None] * (num + 1)  # index 0 unused\n    # initialize f[1]\n    f1 = [[0] * (m + 1) for _ in range(m + 1)]\n    for i in range(1, m + 1):\n        f1[i][i] = 1\n    for i in range(0, m + 1):\n        f1[0][i] = 1\n    f[1] = f1\n\n    # build f[2..num]\n    for i in range(2, num + 1):\n        fi = [[0] * (m + 1) for _ in range(m + 1)]\n        for j in range(m + 1):\n            fi[j][j] = 1\n        g = [[0] * (m + 1) for _ in range(m + 1)]\n        for j in range(m):  # j from 0 to m-1\n            for a in range(m + 1):\n                for b in range(m + 1):\n                    da = Dec(a, j)\n                    db = Dec(b, j)\n                    val = f[i - 1][da][db]\n                    if val == 0:\n                        continue\n                    row = fi[b]\n                    for c in range(m + 1):\n                        if row[c]:\n                            g[a][c] = (g[a][c] + val * row[c]) % mod\n            # copy g to fi and reset g\n            for a in range(m + 1):\n                for b in range(m + 1):\n                    fi[a][b] = g[a][b]\n                    g[a][b] = 0\n        f[i]