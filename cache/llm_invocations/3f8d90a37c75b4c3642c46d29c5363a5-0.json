hars(0) {}\n\n    int read() {\n        if (snumChars == -1)\n            throw \"InputMismatchException\";\n        if (curChar >= snumChars) {\n            curChar = 0;\n            snumChars = fread(buf, 1, 8192, stream);\n            if (snumChars <= 0)\n                return -1;\n        }\n        return buf[curChar++];\n    }\n\n    int nextInt() {\n        int c = read();\n        while (isspace(c))\n            c = read();\n        int sgn = 1;\n        if (c == '-') {\n            sgn = -1;\n            c = read();\n        }\n        int res = 0;\n        do {\n            res *= 10;\n            res += c - '0';\n            c = read();\n        } while (!isspace(c) && c != -1);\n        return res * sgn;\n    }\n\n    long long nextLong() {\n        int c = read();\n        while (isspace(c))\n            c = read();\n        int sgn = 1;\n        if (c == '-') {\n            sgn = -1;\n            c = read();\n        }\n        long long res = 0;\n        do {\n            res *= 10;\n            res += c - '0';\n            c = read();\n        } while (!isspace(c) && c != -1);\n        return res * sgn;\n    }\n\n    vector<int> nextIntArray(int n) {\n        vector<int> a(n);\n        for (int i = 0; i < n; ++i)\n            a[i] = nextInt();\n        return a;\n    }\n\n    string readString() {\n        int c = read();\n        while (isspace(c))\n            c = read();\n        string res;\n        do {\n            res.push_back(static_cast<char>(c));\n            c = read();\n        } while (!isspace(c) && c != -1);\n        return res;\n    }\n\n    string nextLine() {\n        int c = read();\n        while (isspace(c))\n            c = read();\n        string res;\n        do {\n            res.push_back(static_cast<char>(c));\n            c = read();\n        } while (c != '\\n' && c != '\\r' && c != -1);\n        return res;\n    }\n\nprivate:\n    static bool isspace(int c) {\n        return c == ' ' || c == '\\n' || c == '\\r' || c == '\\t' || c == -1;\n    }\n};\n\nint main() {\n    InputReader in(stdin);\n    int n = in.nextInt();\n    int b = in.nextInt();\n    vector<int> a = in.nextIntArray(n);\n    \n    vector<int> odd(n+1, 0);\n    vector<int> even(n+1, 0);\n    for (int i = 1; i <= n; ++i) {\n        if (a[i-1] % 2 == 1) {\n            odd[i] = odd[i-1] + 1;\n            even[i] = even[i-1];\n        } else {\n            odd[i] = odd[i-1];\n            even[i] = even[i-1] + 1;\n        }\n    }\n    \n    int prev = 0;\n    priority_queue<int, vector<int>, greater<int>> cost;\n    for (int i = 1; i <= n-1; ++i) {\n        int oc = odd[i] - odd[prev];\n        int ec = even[i] - even[prev];\n        if (oc == ec) {\n            cost.push(abs(a[i] - a[i-1]));\n            prev = i;\n        }\n    }\n    \n    int sum = 0;\n    int count = 0;\n    while (!cost.empty() && sum <= b) {\n        sum += cost.top();\n        cost.pop();\n        count++;\n    }\n    \n    if (count == 0) {\n        printf(\"0\\n\");\n    } else {\n        if (cost.empty() && sum <= b) {\n            printf(\"%d\\n\", count);\n        } else {\n            printf(\"%d\\n\", count-1);\n        }\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.193427e-05, 0.0, -3.576278e-07, -0.0024870676, -0.00013743887, -4.9232225e-05, -0.69837254, -4.553691e-05, 0.0, -1.3113013e-06, -0.069456026, -7.986991e-06, 0.0, -1.1920928e-07, -0.009877141, -1.7881233e-05, -3.3378547e-06, -2.3841855e-07, -0.55190456, -0.007633563, -0.0040842225, -9.5367386e-07, -0.23177879, -3.3649118, -0.10031884, -0.038084794, -9.5367386e-07, -1.9559361, -0.5760879, -0.080413505, -5.149709e-05, -1.1920928e-07, -1.2636105e-05, -0.08155321, -0.0024443767, -6.198864e-06, -0.00050138775, -0.07551794, -9.5367386e-07, -6.675698e-06, -0.19257972, -0.048587557, -0.0011649496, -0.000120870915, -5.960463e-07, -0.0073162247, -0.0020916031, -1.7881378e-06, -1.060957e-05, -5.4836123e-06, -7.3909487e-06, -