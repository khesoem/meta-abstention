f[x][y] != 'Y' && t + 1 < tox[x][y]) {\n                    tox[x][y] = t + 1;\n                    bfsQueue.add(new int[]{x, y});\n                }\n            }\n        }\n\n        // Build graph\n        for (int i = n - 1; i >= 0; i--) {\n            for (int j = n - 1; j >= 0; j--) {\n                for (int t = 0; t < m; t++) {\n                    for (int d = 0; d < 4; d++) {\n                        int x = i + dx[d];\n                        int y = j + dy[d];\n                        if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y') {\n                            int add = (buf[x][y] > '0' && buf[x][y] <= '9') ? 1 : 0;\n                            if (t + 1 < tox[x][y] + add && t < tox[i][j]) {\n                                addEdge(enc(i, j, t, n), enc(x, y, t + 1, n), 1000);\n                            }\n                        }\n                    }\n                    if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                        addEdge(enc(i, j, t, n), enc(i, j, m, n), buf[i][j] - '0');\n                    }\n                }\n                if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                    addEdge(enc(i, j, m, n), 1, buf[i][j] - '0');\n                }\n            }\n        }\n\n        int res = maxFlow(0, 1);\n        System.out.println(res);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.50339189733495e-06, 0.0, 0.0, -6.747018051100895e-05, -0.003444335889071226, 0.0, -4.768360213347478e-06, -0.011788938194513321, -0.00026723151677288115, -1.1920928244535389e-07, -0.01493040844798088, -0.011050808243453503, -0.00071190285962075, -0.00032824851223267615, -0.00010644822759786621, -1.1920928244535389e-07, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.00015853578224778175, -4.768370445162873e-07, -0.20141762495040894, -1.1920928244535389e-07, -0.0021971152164041996, -1.6689286894688848e-06, -0.0001234931987710297, -1.31130127