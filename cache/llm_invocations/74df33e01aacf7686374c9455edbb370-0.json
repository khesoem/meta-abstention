          parent_idx[e.to] = e.rev;\n                pq.push({dist[e.to], e.to});\n            }\n        }\n    }\n}\n\nvoid augment_path() {\n    int f = k;\n    int cur = sink;\n    while (cur != source) {\n        int prev = g[cur][parent_idx[cur]].to;\n        int idx = g[cur][parent_idx[cur]].rev;\n        f = min(f, g[prev][idx].cap);\n        cur = prev;\n    }\n    \n    flow += f;\n    total += f * dist[sink];\n    \n    cur = sink;\n    while (cur != source) {\n        int prev = g[cur][parent_idx[cur]].to;\n        int idx = g[cur][parent_idx[cur]].rev;\n        g[cur][parent_idx[cur]].cap += f;\n        g[prev][idx].cap -= f;\n        cur = prev;\n    }\n}\n\nint get_id(int v, int t) {\n    return v + t * n;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> k >> c >> d;\n    source = MAXN - 2;\n    sink = MAXN - 1;\n    int max_t = n + k;\n    \n    for (int i = 0; i < k; ++i) {\n        cin >> u;\n        add_edge(source, get_id(u, 0), 0, 1);\n    }\n    \n    for (int t = 0; t <= max_t; ++t) {\n        add_edge(get_id(1, t), sink, c * t, k);\n    }\n    \n    for (int v = 1; v <= n; ++v) {\n        for (int t = 0; t < max_t; ++t) {\n            add_edge(get_id(v, t), get_id(v, t + 1), 0, k);\n        }\n    }\n    \n    while (m--) {\n        cin >> u >> v;\n        for (int i = 1; i <= k; ++i) {\n            for (int t = 0; t < max_t; ++t) {\n                int w = d * (2 * i - 1);\n                add_edge(get_id(u, t), get_id(v, t + 1), w, 1);\n                add_edge(get_id(v, t), get_id(u, t + 1), w, 1);\n            }\n        }\n    }\n    \n    while (flow < k) {\n        dijkstra();\n        augment_path();\n    }\n    \n    cout << total;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 5500;\n    static final long INF = 1000000007L;\n\n    static int n, m, k, c, d;\n    static int source, sink;\n    static int flow = 0;\n    static long total = 0;\n    static long[] dist = new long[MAXN];\n    static int[] parent_idx = new int[MAXN];\n\n    static class Edge {\n        int to;\n        int cost;\n        int rev;\n        int cap;\n\n        Edge(int to, int cost, int rev, int cap) {\n            this.to = to;\n            this.cost = cost;\n            this.rev = rev;\n            this.cap = cap;\n        }\n    }\n\n    static List<Edge>[] g = new List[MAXN];\n\n    static void add_edge(int u, int v, int cost, int cap) {\n        int sz1 = g[u].size();\n        int sz2 = g[v].size();\n        g[u].add(new Edge(v, cost, sz2, cap));\n        g[v].add(new Edge(u, -cost, sz1, 0));\n    }\n\n    static void dijkstra() {\n        Arrays.fill(dist, INF);\n        PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n        dist[source] = 0;\n        pq.offer(new long[]{0, source});\n\n        while (!pq.isEmpty()) {\n            long[] cur = pq.poll();\n            long d_val = cur[0];\n            int u = (int) cur[1];\n            if (d_val != dist[u]) continue;\n\n            for (Edge e : g[u]) {\n                if (e.cap > 0 && dist[e.to] > d_val + e.cost) {\n                    dist[e.to] = d_val + e.cost;\n                    parent_idx[e.to] = e.rev;\n                    pq.offer(new long[]{dist[e.to], e.to});\n                }\n            }\n        }\n    }\n\n    static void augment_path() {\n        int f = k;\n        int cur = sink;\n        while (cur != source) {\n            int prev = g[cur].get(parent_idx[cur]).to;\n            int idx = g[cur].get(parent_idx[cur]).rev;\n            f = Math.min(f, g[prev].get(idx).cap);\n            cur = prev;\n        }\n\n        flow += f;\n        total += (long) f * dist[sink];\n\n        cur = sink;\n        while (cur != source) {\n            int prev = 