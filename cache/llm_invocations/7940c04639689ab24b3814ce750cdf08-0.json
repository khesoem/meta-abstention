turn dist;\n}\n\nbool dfsKuhn(int v) {\n    if (seen[v] == timer) return false;\n    seen[v] = timer;\n\n    for (int to : g[v]) {\n        if (matchRight[to] == 0 || dfsKuhn(matchRight[to])) {\n            matchRight[to] = v;\n            return true;\n        }\n    }\n\n    return false;\n}\n\nsigned main() {\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cout.precision(10);\n\n    int n, t;\n    cin >> n >> t;\n    vector<string> s1(n), s2(n);\n    for (int i = 0; i < n; ++i) cin >> s1[i];\n    for (int i = 0; i < n; ++i) cin >> s2[i];\n\n    int zx = 0, zy = 0;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (s1[i][j] == 'Z') zx = i, zy = j;\n\n    vector<vector<int>> reactorDist = bfs(zx, zy, s1);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (!allowed(i, j, s1)) continue;\n\n            vector<vector<int>> curDist = bfs(i, j, s1);\n\n            for (int x = 0; x < n; ++x) {\n                for (int y = 0; y < n; ++y) {\n                    if (!allowed(x, y, s1) || curDist[x][y] > t || curDist[x][y] > reactorDist[x][y])\n                        continue;\n\n                    if (curDist[x][y] == reactorDist[x][y]) {\n                        bool good = false;\n                        for (int d = 0; d < 4; ++d) {\n                            int nx = x + xMove[d];\n                            int ny = y + yMove[d];\n                            if (!allowed(nx, ny, s1) || curDist[nx][ny] >= reactorDist[nx][ny])\n                                continue;\n                            good = true;\n                        }\n                        if (!good) continue;\n                    }\n\n                    int leftBase = 100 * i + 10 * j;\n                    int rightBase = 100 * x + 10 * y;\n\n                    for (int u = 1; u <= s1[i][j] - '0'; ++u) {\n                        for (int v = 1; v <= s2[x][y] - '0'; ++v) {\n              