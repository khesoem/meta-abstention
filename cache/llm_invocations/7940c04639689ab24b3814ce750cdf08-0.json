for i in range(n):\n        for j in range(n):\n            if not allowed(i, j, s1):\n                continue\n            cur_dist = bfs(i, j, s1)\n            for x in range(n):\n                for y in range(n):\n                    if not allowed(x, y, s1):\n                        continue\n                    if cur_dist[x][y] > t or cur_dist[x][y] > reactor_dist[x][y]:\n                        continue\n                    if cur_dist[x][y] == reactor_dist[x][y]:\n                        good = False\n                        for d in range(4):\n                            nx = x + xMove[d]\n                            ny = y + yMove[d]\n                            if not allowed(nx, ny, s1) or cur_dist[nx][ny] >= reactor_dist[nx][ny]:\n                                continue\n                            good = True\n                            break\n                        if not good:\n                            continue\n                    left_base = 100 * i + 10 * j\n                    right_base = 100 * x + 10 * y\n                    for u in range(1, int(s1[i][j]) + 1):\n                        for v in range(1, int(s2[x][y]) + 1):\n                            g[left_base + u].append(right_base + v)\n\n    seen = [0] * MAXN\n    match_right = [0] * MAXN\n    timer = 0\n    for i in range(MAXN):\n        timer += 1\n        dfs_kuhn(i, seen, timer, g, match_right)\n\n    answer = sum(1 for x in match_right if x != 0)\n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001284993631998077, -1.1920928244535389e-07, 0.0, -0.00013445904187392443, -0.00871024839580059, 0.0, -6.079655122448457e-06, -3.2186455882765586e-06, -8.344646857949556e-07, 0.0, -7.986990567587782e-06, -0.0034313867799937725, -0.04115423932671547, -1.5497195136049413e-06, -0.0004593271005433053, -0.00021169328829273582, -0.0015024575404822826, -0.0006424508756026626, -0.00011073929636040702