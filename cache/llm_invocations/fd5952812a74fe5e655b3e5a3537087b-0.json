n        if (c != 'A') {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v2 - 1][r];\n            res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n        mp.put(state, res);\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        r = sc.nextInt();\n        c = sc.nextInt();\n        int maxN = 2 * (r + c);\n        C = new long[maxN + 1][maxN + 1];\n        for (int j = 0; j <= maxN; ++j) {\n            for (int i = 0; i <= maxN; ++i) {\n                if (j == 0) C[i][j] = 1;\n                else if (i == 0) C[i][j] = 0;\n                else C[i][j] = C[i - 1][j] + C[i - 1][j - 1];\n            }\n        }\n        long total = C[r + c][r] * C[r + c][r];\n        {\n            long x = 0, y = 0;\n            int v1 = r + c, v2 = r + c;\n            while (v1 >= r && v2 >= r) {\n                if (x > y) {\n                    long cur1 = C[v1][r] - C[v1 - 1][r];\n                    long sum2 = C[v2][r];\n                    y += cur1 * sum2;\n                    --v1;\n                } else {\n                    long sum1 = C[v1][r];\n                    long cur2 = C[v2][r] - C[v2 - 1][r];\n                    x += sum1 * cur2;\n                    --v2;\n                }\n            }\n            best = Math.abs(x - y);\n        }\n        dfs(0, 0, r + c, r + c);\n        String sStr = sc.next();\n        s = sStr.toCharArray();\n        int len = 2 * (r + c);\n        cntA = new int[len + 1];\n        cntB = new int[len + 1];\n        cntA[0] = cntB[0] = 0;\n        for (int i = 0; i < len; ++i) {\n            cntA[i + 1] = cntA[i] + (s[i] == 'A' ? 1 : 0);\n            cntB[i + 1] = cntB[i] + (s[i] == 'B' ? 1 : 0);\n        }\n        long ans = solve(0, 0, r + c, r + c);\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.7165990357170813e-05, 0.0, -