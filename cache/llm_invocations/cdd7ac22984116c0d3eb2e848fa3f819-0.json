for (int i = 0; i < a; i++) {\n            sb.append((char)('a' + i));\n        }\n        \n        for (int i = 0; i < b; i++) {\n            sb.append(p);\n        }\n        \n        for (int i = 0; i < a; i++) {\n            boolean[] used = new boolean[26];\n            int startIdx = b;\n            int endIdx = b + a + i;\n            \n            for (int j = startIdx; j < endIdx && j < sb.length(); j++) {\n                used[sb.charAt(j) - 'a'] = true;\n            }\n            \n            for (int j = 0; j < 26; j++) {\n                if (!used[j]) {\n                    sb.append((char)('a' + j));\n                    break;\n                }\n            }\n        }\n        \n        for (int i = 0; i < b; i++) {\n            sb.append(q);\n        }\n        \n        return sb.toString();\n    }\n    \n    private static int calculateUnique(String pattern, int l, int r) {\n        boolean[] seen = new boolean[26];\n        int len = pattern.length();\n        int range = r - l + 1;\n        \n        if (range >= 100000) {\n            for (int i = 0; i < len; i++) {\n                seen[pattern.charAt(i) - 'a'] = true;\n            }\n        } else {\n            for (int i = l; i <= r; i++) {\n                seen[pattern.charAt(i % len) - 'a'] = true;\n            }\n        }\n        \n        int count = 0;\n        for (boolean b : seen) {\n            if (b) count++;\n        }\n        return count;\n    }\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nstring constructPattern(int a, int b, char p, char q) {\n    string sb = \"\";\n    \n    for (int i = 0; i < a; i++) {\n        sb += (char)('a' + i);\n    }\n    \n    for (int i = 0; i < b; i++) {\n        sb +