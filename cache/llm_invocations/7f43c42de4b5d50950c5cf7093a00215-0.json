\n                Arrays.fill(used, 0);\n                if (augment(i, g, left, right, used)) ++result;\n            }\n            return result;\n        }\n\n        boolean augment(int u, ArrayList<ArrayList<Integer>> g, int[] left,\n                        int[] right, int[] used) {\n            for (int v : g.get(u)) {\n                if (used[v] != 0) continue;\n                used[v] = 1;\n                if (right[v] == -1 || augment(right[v], g, left, right, used)) {\n                    left[u] = v;\n                    right[v] = u;\n                    return true;\n                }\n            }\n            return false;\n        }\n    }\n\n    static Hungarian matcher = new Hungarian();\n\n    static void bfsDist(int sr, int sc) {\n        Queue<int[]> q = new LinkedList<>();\n        for (int i = 0; i < 12; ++i) Arrays.fill(F[i], -1);\n        F[sr][sc] = 0;\n        q.add(new int[]{sr, sc});\n        while (!q.isEmpty()) {\n            int[] cur = q.poll();\n            int r = cur[0], c = cur[1];\n            for (int k = 0; k < 4; ++k) {\n                int nr = r + dr[k];\n                int nc = c + dc[k];\n                if (A[nr][nc] >= 0 && F[nr][nc] < 0) {\n                    F[nr][nc] = F[r][c] + 1;\n                    q.add(new int[]{nr, nc});\n                }\n            }\n        }\n    }\n\n    static void linkMonsters(int sr, int sc, int cnt) {\n        int[][] seen = new int[12][12];\n        for (int i = 0; i < 12; ++i) Arrays.fill(seen[i], -1);\n        Queue<int[]> q = new LinkedList<>();\n        seen[sr][sc] = 0;\n        q.add(new int[]{sr, sc});\n        while (!q.isEmpty()) {\n            int[] cur = q.poll();\n            int r = cur[0], c = cur[1];\n            int limit = Math.min(T, F[r][c]);\n            if (seen[r][c] > limit) continue;\n            for (int i = 0; i < objects[r][c].size(); ++i) {\n                for (int k = 0; k < cnt; ++k) {\n                    graph.get(monsters + k).add(objects[r][c].get(i));\n                }\n            }\n            if (seen[r][c] == limit) continue;\n            for (int k = 0; k < 4; ++k) {\n                int nr = r + dr[k];\n                int nc = c + dc[k];\n                if (A[nr][nc] >= 0 && seen[nr][nc] < 0) {\n                    seen[nr][nc] = seen[r][c] + 1;\n                    q.add(new int[]{nr, nc});\n                }\n            }\n        }\n        monsters += cnt;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n\n        String[] firstLine = br.readLine().split(\" \");\n        N = Integer.parseInt(firstLine[0]);\n        T = Integer.parseInt(firstLine[1]);\n\n        graph = new ArrayList<>(MAXN);\n        for (int i = 0; i < MAXN; ++i) graph.add(new ArrayList<>());\n\n        for (int i = 0; i < 12; ++i) {\n            Arrays.fill(A[i], -1);\n            Arrays.fill(B[i], -1);\n            for (int j = 0; j < 12; ++j) objects[i][j] = new ArrayList<>();\n        }\n\n        // Read grid A\n        for (int i = 1; i <= N; ++i) {\n            String line = br.readLine();\n            for (int j = 1; j <= N; ++j) {\n                char ch = line.charAt(j - 1);\n                if (ch >= '0' && ch <= '9') A[i][j] = ch - '0';\n                if (ch == 'Z') {\n                    ZR = i;\n                    ZC = j;\n                }\n            }\n        }\n\n        bfsDist(ZR, ZC);\n\n        // Skip blank line between grids\n        br.readLine();\n\n        // Read grid B\n        for (int i = 1; i <= N; ++i) {\n            String line = br.readLine();\n            for (int j = 1; j <= N; ++j) {\n                char ch = line.charAt(j - 1);\n                if (ch >= '0' && ch <= '9') B[i][j] = ch - '0';\n                for (int k = 0; k < B[i][j]; ++k)\n                    objects[i][j].add(treasures++);\n            }\n   