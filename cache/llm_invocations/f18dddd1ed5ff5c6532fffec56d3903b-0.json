rix result = identity(size);\n    Matrix current = base;\n    while (exp > 0) {\n        if (exp & 1)\n            result = multiply(result, current, size);\n        current = multiply(current, current, size);\n        exp >>= 1;\n    }\n    return result;\n}\n\nMatrix f[MAX_D];\nint global_k;\n\nMatrix build_shifted_matrix(int depth, int shift) {\n    Matrix res;\n    for (int i = 0; i <= global_k; ++i)\n        for (int j = 0; j <= global_k; ++j) {\n            int ni = (i == global_k) ? i : (i + shift) % global_k;\n            int nj = (j == global_k) ? j : (j + shift) % global_k;\n            res[ni][nj] = f[depth][i][j];\n        }\n    return res;\n}\n\nint digit_sum(llint num, int base) {\n    int s = 0;\n    while (num > 0) {\n        s += num % base;\n        num /= base;\n    }\n    return s % base;\n}\n\nint main() {\n    llint n;\n    int k;\n    scanf(\"%lld %d\", &n, &k);\n    global_k = k;\n\n    int digits = 0;\n    llint t = n;\n    while (t > 0) {\n        t /= k;\n        ++digits;\n    }\n\n    Matrix I = identity(k);\n    f[0] = I;\n    for (int i = 0; i <= k; ++i)\n        f[0][i][0] = 1;\n\n    for (int d = 1; d < digits; ++d) {\n        f[d] = I;\n        for (int shift = 0; shift < k; ++shift)\n            f[d] = multiply(f[d], build_shifted_matrix(d-1, shift), k);\n    }\n\n    llint current = 0;\n    llint power = 1;\n    --digits;\n    for (int i = 0; i < digits; ++i)\n        power *= k;\n\n    Matrix result = I;\n    while (current < n) {\n        assert(digits >= 0);\n        while (current + power <= n) {\n            result = multiply(result, build_shifted_matrix(digits, digit_sum(current, k)), k);\n            current += power;\n        }\n        power /= k;\n        --digits;\n    }\n\n    int total = 0;\n    for (int i = 0; i <= k; ++i)\n        total = add(total, result[k][i]);\n    printf(\"%d\\n\", total);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}