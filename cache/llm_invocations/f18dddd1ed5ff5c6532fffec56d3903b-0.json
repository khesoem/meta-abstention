ift) {\n        Matrix res = new Matrix(global_k);\n        for (int i = 0; i <= global_k; ++i)\n            for (int j = 0; j <= global_k; ++j) {\n                int ni = (i == global_k) ? i : (i + shift) % global_k;\n                int nj = (j == global_k) ? j : (j + shift) % global_k;\n                res.data[ni][nj] = f[depth].data[i][j];\n            }\n        return res;\n    }\n\n    static int digitSum(long num, int base) {\n        int s = 0;\n        while (num > 0) {\n            s += num % base;\n            num /= base;\n        }\n        return s % base;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long n = scanner.nextLong();\n        int k = scanner.nextInt();\n        global_k = k;\n\n        int digits = 0;\n        long t = n;\n        while (t > 0) {\n            t /= k;\n            ++digits;\n        }\n\n        Matrix I = identity(k);\n        f[0] = I;\n        for (int i = 0; i <= k; ++i)\n            f[0].data[i][0] = 1;\n\n        for (int d = 1; d < digits; ++d) {\n            f[d] = I;\n            for (int shift = 0; shift < k; ++shift)\n                f[d] = multiply(f[d], buildShiftedMatrix(d-1, shift), k);\n        }\n\n        long current = 0;\n        long power = 1;\n        --digits;\n        for (int i = 0; i < digits; ++i)\n            power *= k;\n\n        Matrix result = I;\n        while (current < n) {\n            assert digits >= 0;\n            while (current + power <= n) {\n                result = multiply(result, buildShiftedMatrix(digits, digitSum(current, k)), k);\n                current += power;\n            }\n            power /= k;\n            --digits;\n        }\n\n        int total = 0;\n        for (int i = 0; i <= k; ++i)\n            total = add(total, result.data[k][i]);\n        System.out.println(total);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001497156627010554, -2.145764