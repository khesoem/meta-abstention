[v] + e.cost + potential[v] - potential[e.to];\n                    prevv[e.to] = v;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        q.push(e.to);\n                        inq[e.to] = true;\n                    }\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        for (int v = 0; v < n; ++v) potential[v] += dist[v];\n        ll d = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            d = min(d, graph[prevv[v]][preve[v]].cap);\n        }\n        flow += d;\n        price += d * potential[t];\n        for (int v = t; v != s; v = prevv[v]) {\n            Edge &e = graph[prevv[v]][preve[v]];\n            e.cap -= d;\n            graph[v][e.rev].cap += d;\n        }\n    }\n    return flow;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n    graph.resize(sink + 1);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                add_edge(i + (t-1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            ll cost = (j+1)*(j+1) - j*j;\n            for (int t = 1; t < T; ++t) {\n                add_edge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                add_edge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price;\n    ll flow = min_cost_flow(source, sink, price, sink + 1);\n    assert(flow == k);\n    cout << price << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_siz