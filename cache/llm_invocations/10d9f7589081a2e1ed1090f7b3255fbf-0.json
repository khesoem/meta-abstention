 def __iadd1__(self):\n        self.v = (self.v + 1) % MOD\n        return self\n\n    def __isub1__(self):\n        self.v = (self.v - 1) % MOD\n        return self\n\n    def extgcd(self, a, b):\n        p = [a, 1, 0]\n        q = [b, 0, 1]\n        while q[0]:\n            t = p[0] // q[0]\n            for i in range(3):\n                p[i], q[i] = q[i], p[i] - t * q[i]\n        if p[0] < 0:\n            p = [-x for x in p]\n        return p[1], p[2], p[0]\n\n    def inv(self):\n        x, y, g = self.extgcd(self.v, MOD)\n        return ModInt(x % MOD)\n\n    def pow(self, p):\n        if p < 0:\n            return self.inv().pow(-p)\n        a = ModInt(1)\n        x = self\n        while p:\n            if p & 1:\n                a *= x\n            x *= x\n            p >>= 1\n        return a\n\n    def __eq__(self, other):\n        return self.v == other.v\n\n    def __ne__(self, other):\n        return self.v != other.v\n\n    def __repr__(self):\n        return str(self.v)\n\ndef B(x, i):\n    return (x >> i) & 1\n\ndef main():\n    input = sys.stdin.readline\n    N = int(input())\n    p = []\n    for _ in range(N):\n        row = list(map(int, input().split()))\n        p.append([ModInt(x) / 100 for x in row])\n\n    cur = defaultdict(lambda: ModInt(0))\n    cur[1] = ModInt(1)  # bit 0 set\n\n    for i in range(N):\n        nxt = defaultdict(lambda: ModInt(0)\n        for b_val, prob in cur.items():\n            ones = [j for j in range(N) if (b_val >> j) & 1]\n            for e in range(1 << N):\n                pr = ModInt(1)\n                for j in range(N):\n                    if B(e, j):\n                        pr *= p[i][j]\n                    else:\n                        pr *= ModInt(1) - p[i][j]\n                nb = 0\n                for x in ones:\n                    for r in range(N):\n                        if B(e, r) and not B(x, r):\n                            nb |= (1 << r)\n                nxt[nb] += prob * pr\n        cur = nx