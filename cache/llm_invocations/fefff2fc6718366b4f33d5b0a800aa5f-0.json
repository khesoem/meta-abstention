]\n    \n    for i in range(N):\n        row = next(it)\n        for j, ch in enumerate(row):\n            if ch == 'Y' or ch == 'Z':\n                gridPlant[i][j][0] = ord(ch) - ord('X')  # Y->1, Z->2\n                sourceCap[i][j] = 0\n            else:\n                gridPlant[i][j][0] = 0\n                sourceCap[i][j] = int(ch)\n    \n    # second grid: sink capacities\n    for i in range(N):\n        row = next(it)\n        for j, ch in enumerate(row):\n            if ch == 'Y' or ch == 'Z':\n                gridPlant[i][j][0] = ord(ch) - ord('X')\n                sinkCap[i][j] = 0\n            else:\n                gridPlant[i][j][0] = 0\n                sinkCap[i][j] = int(ch)\n    \n    # propagate plant states over time\n    dirR = [0, 0, -1, 1]\n    dirC = [-1, 1, 0, 0]\n    def inBounds(r, c):\n        return 0 <= r < N and 0 <= c < N\n    \n    for t in range(1, T+1):\n        for i in range(N):\n            for j in range(N):\n                gridPlant[i][j][t] = gridPlant[i][j][t-1]\n        for i in range(N):\n            for j in range(N):\n                if gridPlant[i][j][t-1] == 2:\n                    for d in range(4):\n                        ni = i + dirR[d]\n                        nj = j + dirC[d]\n                        if inBounds(ni, nj) and gridPlant[ni][nj][t-1] == 0:\n                            gridPlant[ni][nj][t] = 2\n    \n    # assign ids for source and sink cells\n    sourceId = [[-1]*10 for _ in range(10)]\n    sinkId = [[-1]*10 for _ in range(10)]\n    sinkNode = 1  # node 0 is source, sinkNode will be the final sink\n    for i in range(N):\n        for j in range(N):\n            if sourceCap[i][j] != 0:\n                sourceId[i][j] = sinkNode\n                sinkNode += 1\n    for i in range(N):\n        for j in range(N):\n            if sinkCap[i][j] != 0:\n                sinkId[i][j] = sinkNode\n                sinkNode += 1\n    \n    # residual graph: size sinkNode+1 (including source 0 and sink sinkNode)\n    size = sinkNode + 1\n    residual = [[0]*size for _ in range(size)]\n    \n    # BFS from each source cell to connect to sink cells\n    for i in range(N):\n        for j in range(N):\n            if sourceCap[i][j] == 0:\n                continue\n            seen = [[False]*N for _ in range(N)]\n            from collections import deque\n            q = deque()\n            q.append((0, i, j))\n            seen[i][j] = True\n            src = sourceId[i][j]\n            while q:\n                time, r, c = q.popleft()\n                if sinkCap[r][c] != 0:\n                    residual[src][sinkId[r][c]] = 10000\n                if time == T:\n                    continue\n                if gridPlant[r][c][time] != 0:\n                    continue\n                for d in range(4):\n                    nr = r + dirR[d]\n                    nc = c + dirC[d]\n                    if inBounds(nr, nc) and gridPlant[nr][nc][time] == 0 and not seen[nr][nc]:\n                        seen[nr][nc] = True\n                        q.append((time+1, nr, nc))\n    \n    # connect source and sink to the network\n    for i in range(N):\n        for j in range(N):\n            if sourceCap[i][j] != 0:\n                residual[0][sourceId[i][j]] = sourceCap[i][j]\n            if sinkCap[i][j] != 0:\n                residual[sinkId[i][j]][sinkNode] = sinkCap[i][j]\n    \n    # max flow (Ford-Fulkerson with DFS)\n    def dfsAugment(u, parent):\n        if u == sinkNode:\n            return True\n        for v in range(size):\n            if residual[u][v] > 0 and parent[v] == -1:\n                parent[v] = u\n                if dfsAugment(v, parent):\n                    return True\n        return False\n    \n    def getAugment():\n        parent = [-1]*size\n        parent[0] = 0\n        if not dfsAugment(0, parent):\n            return 0\n        add = 10000\n        v = sinkNode\n        while v != 0:\n            u = parent[v]\n            add = min(add, residu