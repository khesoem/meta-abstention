      for (int i = 0; i < n; i++) {\n            g.add(new ArrayList<>());\n        }\n\n        int tim = 99;\n        for (int i = 1; i <= K.k; i++) {\n            lr[i] = in.nextLong();\n            addEdge(g, 0, (int) lr[i], 1, 0);\n        }\n\n        for (int j = 0; j < tim - 1; j++) {\n            for (int i = 2; i <= K.n; i++) {\n                addEdge(g, j * 50 + i, (j + 1) * 50 + i, 50, K.c);\n            }\n        }\n\n        for (int j = 1; j < tim; j++) {\n            addEdge(g, j * 50 + 1, 1, 50, 0);\n        }\n\n        for (int i = 0; i < K.m; i++) {\n            long x = in.nextLong();\n            long y = in.nextLong();\n            if (vr[(int) x] == null) vr[(int) x] = new ArrayList<>();\n            if (vr[(int) y] == null) vr[(int) y] = new ArrayList<>();\n            vr[(int) x].add(y);\n            vr[(int) y].add(x);\n\n            for (int j = 0; j < tim - 1; j++) {\n                for (int l = 0; l < 50; l++) {\n                    long cost = K.c + K.d * ((l + 1) * (l + 1) - (l * l));\n                    addEdge(g, j * 50 + (int) x, (j + 1) * 50 + (int) y, 1, cost);\n                    addEdge(g, j * 50 + (int) y, (j + 1) * 50 + (int) x, 1, cost);\n                }\n            }\n        }\n\n        int s = 0, t = 1;\n        long flow = 0, cost = 0;\n\n        while (flow < k) {\n            int[] id = new int[n];\n            long[] d = new long[n];\n            Arrays.fill(d, INF);\n            int[] q = new int[n];\n            int[] p = new int[n];\n            int[] p_rib = new int[n];\n            int qh = 0, qt = 0;\n            q[qt++] = s;\n            d[s] = 0;\n            while (qh != qt) {\n                int v = q[qh++];\n                id[v] = 2;\n                if (qh == n) qh = 0;\n                for (int i = 0; i < g.get(v).size(); i++) {\n                    Edge r = g.get(v).get(i);\n                    if (r.f < r.u && d[v] + r.c < d[r.b]) {\n                        d[r.b] = d[v] + r.c;\n                        if (id[r.b] == 0) {\n                            q[qt++] = r.b;\n                            if (qt == n) qt = 0;\n                        } else if (id[r.b] == 2) {\n                            if (--qh == -1) qh = n - 1;\n                            q[qh] = r.b;\n                        }\n                        id[r.b] = 1;\n                        p[r.b] = v;\n                        p_rib[r.b] = i;\n                    }\n                }\n            }\n            if (d[t] == INF) break;\n            long addflow = k - flow;\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = p_rib[v];\n                addflow = Math.min(addflow, g.get(pv).get(pr).u - g.get(pv).get(pr).f);\n            }\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = p_rib[v];\n                int r = g.get(pv).get(pr).back;\n                g.get(pv).get(pr).f += addflow;\n                g.get(v).get(r).f -= addflow;\n                cost += g.get(pv).get(pr).c * addflow;\n            }\n            flow += addflow;\n        }\n        System.out.println(cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.4543427823809907e-05, 0.0, -8.344646857949556e-07, -6.568216485902667e-05, -5.018585216021165e-05, -1.1920928244535389e-07, -0.00020466140995267779, -0.012717338278889656, -0.00035208225017413497, 0.0, -3.564294092939235e-05, -0.004084459971636534, -0.00026174934464506805, -0.0019947646651417017, -0.0009864469757303596, -0.10039669275283813, -9.536738616588991e-07, -1.1920928244535389e-07, -2.861018856492592e-06, -0.006716533098369837, -0.06912000477313995, 0.0, -2.3841855067985307e-07, 0.0, -5.8410845667822286e-05, -3.576278118089249e-07, -3.099436753473128e-06, 0.0, -0.00043084874050691724, 0.0, 0.0, 0.0, -0.039380449801683426, -0.0005550036439672112, -1.0132738680113107e-05, -1.3112935448589269e-05, -8.22540732769994e