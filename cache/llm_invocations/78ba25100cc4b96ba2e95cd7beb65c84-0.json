> segs[i][0] >> segs[i][1];\n    }\n\n    sort(segs.begin(), segs.end(), [](const vector<int>& a, const vector<int>& b) {\n        return a[0] < b[0];\n    });\n\n    vector<vector<int>> finSeg;\n    for (int i = 0; i < k; ) {\n        int lo = segs[i][0];\n        int hi = segs[i][0];\n        while (i < k && segs[i][0] <= hi) {\n            hi = max(hi, segs[i][1]);\n            i++;\n        }\n        finSeg.push_back({lo, hi});\n        i--;\n    }\n\n    k = finSeg.size();\n    segs.resize(k, vector<int>(2));\n    vector<int> l(k), delt(k);\n\n    for (int i = 0; i < k; i++) {\n        segs[i][0] = finSeg[i][0];\n        segs[i][1] = finSeg[i][1];\n        l[i] = segs[i][1] - segs[i][0];\n        delt[i] = (i < k - 1) ? segs[i+1][0] - segs[i][1] : 2 * n - segs[i][1];\n    }\n\n    vector<vector<vector<int>>> dp(2, vector<vector<int>>(k + 1, vector<int>(2 * n + 1, 0)));\n\n    for (int i = 0; i < 2 * n + 1; i++) {\n        dp[0][k][i] = n;\n        dp[1][k][i] = n;\n    }\n    dp[0][k][n] = 0;\n    dp[1][k][n] = 0;\n\n    vector<RMQ> rmq(2);\n    rmq[0] = RMQ(dp[0][k]);\n    rmq[1] = RMQ(dp[1][k]);\n\n    for (int i = k - 1; i >= 0; i--) {\n        for (int j = 0; j <= 2 * n; j++) {\n            int next0 = j + l[i] + delt[i];\n            dp[0][i][j] = (next0 <= 2 * n) ? dp[0][i+1][next0] : n;\n            dp[1][i][j] = dp[1][i+1][j];\n\n            int upper1 = min(j + l[i], 2 * n);\n            dp[0][i][j] = min(dp[0][i][j], 1 + rmq[1].minRange(j, upper1));\n\n            if (j + delt[i] <= 2 * n) {\n                int upper2 = min(j + l[i] + delt[i], 2 * n);\n                dp[1][i][j] = min(dp[1][i][j], 1 + rmq[0].minRange(j + delt[i], upper2));\n                dp[0][i][j] = min(dp[0][i][j], 2 + rmq[0].minRange(j + delt[i], upper2));\n            }\n\n            upper1 = min(j + l[i], 2 * n);\n            dp[1][i][j] = min(dp[1][i][j], 2 + rmq[1].minRange(j, upper1));\n        }\n        rmq[0] = RMQ(dp[0][i]);\n        rmq[1] = RMQ(dp[1][i]);\n    }\n