t__(self, from_node, to_node, capacity, cost, forward):\n        self.from_node = from_node\n        self.to_node = to_node\n        self.capacity = capacity\n        self.cost = cost\n        self.forward = forward\n        self.flow = 0\n        self.dual = None\n\nclass MaxFlowSolver:\n    def __init__(self):\n        self.nodes = []\n\n    def add_node(self):\n        node = Node()\n        self.nodes.append(node)\n        return node\n\n    def link(self, from_node, to_node, capacity, cost):\n        edge = Edge(from_node, to_node, capacity, cost, True)\n        reverse_edge = Edge(to_node, from_node, 0, -cost, False)\n        edge.dual = reverse_edge\n        reverse_edge.dual = edge\n        from_node.edges.append(edge)\n        to_node.edges.append(reverse_edge)\n\n    def get_min_cost_max_flow(self, src, snk):\n        self.max_flow = 0\n        self.min_cost = 0\n        self.potential = [0] * len(self.nodes)\n        while self._bfs(src, snk):\n            self._dfs(src, snk)\n        return self.max_flow, self.min_cost\n\n    def _bfs(self, src, snk):\n        dist = [float('inf')] * len(self.nodes)\n        dist[src.index] = 0\n        queue = [(0, src.index)]\n        while queue:\n            dist_v, v = heappop(queue)\n            if dist[v] < dist_v:\n                continue\n            for edge in self.nodes[v].edges:\n                if edge.capacity > edge.flow and dist[edge.to.index] > dist_v + edge.cost + self.potential[v] - self.potential[edge.to.index]:\n                    dist[edge.to.index] = dist_v + edge.cost + self.potential[v] - self.potential[edge.to.index]\n                    heappush(queue, (dist[edge.to.index], edge.to.index))\n        return dist[snk.index] != float('inf')\n\n    def _dfs(self, src, snk):\n        stack = [(snk, 0)]\n        while stack:\n            v, aug_flow = stack.pop()\n            if v == src:\n                self.max_flow += aug_flow\n                self.min_cost += aug_flow * self.potential[v]\n                break\n            for edge in v.edges:\n                if edge.capacity > edge.flow and edge.to != src:\n                    edge.add_flow(min(aug_flow, edge.capacity - edge.flow))\n                    stack.append((edge.to, aug_flow - edge.flow))\n                    self.potential[edge.to.index] += dist[edge.to.index]\n        return\n\nclass EdmondsKarp(MaxFlowSolver):\n    def __init__(self):\n        super().__init__()\n\n    def get_min_cost_max_flow(self, src, snk):\n        return super().get_min_cost_max_flow(src, snk)\n\ndef main():\n    N, M, K, C, D = map(int, input().split())\n    solver = EdmondsKarp()\n    src = solver.add_node()\n    snk = solver.add_node()\n    amt = 150\n    time_nodes = [[solver.add_node() for _ in range(amt)] for _ in range(N)]\n    for i in range(N):\n        for j in range(1, amt):\n            if j > 1:\n                solver.link(time_nodes[i][j-1], time_nodes[i][j], float('inf'), 0)\n    for i in range(K):\n        solver.link(src, time_nodes[people[i]][1], 1, 0)\n    for i in range(1, amt):\n        for j in range(K):\n            solver.link(time_nodes[0][i], snk, 1, C*i-C)\n    for i in range(M):\n        a, b = map(int, input().split())\n        for j in range(1, amt-1):\n            prev = 0\n            for k in range(1, K+1):\n                solver.link(time_nodes[a][j], time_nodes[b][j + 1], 1, D*k*k- prev)\n                solver.link(time_nodes[b][j], time_nodes[a][j + 1], 1, D*k*k - prev)\n                prev = D * k * k\n    max_flow, min_cost = solver.get_min_cost_max_flow(src, snk)\n    print(min_cost)\n\npeople = list(map(int, input().split()))[3:]\nmain()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.13026617467403412, -0.00017638569988775998, -0.05013137683272362, -0.20389653742313385, -0.37702059745788574, -0.114139124751091, -0.5329128503799438, -0.8000575304031372, -2.861027041944908e-06, -0.44794103503227234, -2.5033982637978625e-06, -0.3132680356502533, -