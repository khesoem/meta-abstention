    sum %= mod;\n                if (sum == 0) sum += mod;\n                sums[i][j] = sum;\n            }\n        }\n\n        // init fact\n        int fact_size = 501 * 501;\n        vector<ll> fact(fact_size, 0);\n        fact[0] = fact[1] = 1;\n        for (int i = 2; i < fact_size; i++) {\n            fact[i] = fact[i - 1] * i;\n            fact[i] %= mod;\n        }\n\n        // init ncr\n        int ncr_size = 501;\n        vector<vector<ll>> ncr(ncr_size, vector<ll>(ncr_size, 0));\n        ncr[0][0] = 1;\n        for (int i = 1; i < ncr_size; i++) {\n            ncr[i][0] = 1;\n            for (int j = 1; j < ncr_size; j++) {\n                ncr[i][j] = (ncr[i - 1][j] + ncr[i - 1][j - 1]) % mod;\n                if (ncr[i][j] == 0) ncr[i][j] += mod;\n            }\n        }\n\n        ll res = 0;\n        for (int i = n - 2; i >= 0; i--) {\n            int cnt = n - i;\n            int pre = n - cnt;\n            ll com = (ncr[n][pre] * fact[pre]) % mod;\n            if (com == 0) com += mod;\n            ll sum = 0;\n\n            for (int dif = 1; dif < cnt; dif++) {\n                for (int inv = dif; inv < dp_cols; inv++) {\n                    if (dp[cnt - 2][inv] == 0) {\n                        break;\n                    }\n                    if (inv - dif - 1 < 0) continue;\n                    ll x = dp[cnt - 2][inv];\n                    ll y = sums[cnt - 2][inv - dif - 1];\n                    x *= y;\n                    x %= mod;\n                    if (x == 0) x += mod;\n                    sum += x * (cnt - dif);\n                    sum %= mod;\n                }\n            }\n            res += sum * com;\n            res %= mod;\n            if (res == 0) res += mod;\n        }\n\n        cout << (res % mod) << '\\n';\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.364403477869928e-06, 0.0, -1.1920928244535389e-07, -0.0009147512027993798, -0.0014518683310598135, -3.54045