>= 0; j--) {\n                addEdge(x + i * n, y + (i + 1) * n, 1, d * (2 * j + 1));\n                addEdge(y + i * n, x + (i + 1) * n, 1, d * (2 * j + 1));\n            }\n    }\n\n    auto spfa = [&]() -> bool {\n        memset(inQueue, 0, sizeof(inQueue));\n        memset(dist, 0x3f, sizeof(dist));\n        q.push(SNK); dist[SNK] = 0; inQueue[SNK] = 1;\n        while (!q.empty()) {\n            int x = q.front(); q.pop();\n            inQueue[x] = 0;\n            for (int i = head[x]; i; i = nxt[i]) {\n                int y = to[i];\n                if (cap[i ^ 1] && dist[y] > dist[x] + cst[i ^ 1]) {\n                    dist[y] = dist[x] + cst[i ^ 1];\n                    if (!inQueue[y]) { q.push(y); inQueue[y] = 1; }\n                }\n            }\n        }\n        return dist[SRC] < 1e18;\n    };\n\n    function<int(int,int,ll&)> dfs;\n    dfs = [&](int x, int lim, ll &totalCost) -> int {\n        int flow = 0;\n        inQueue[x] = 1;\n        if (x == SNK) return lim;\n        for (int i = head[x]; i; i = nxt[i]) {\n            int y = to[i];\n            if (!cap[i] || inQueue[y]) continue;\n            if (dist[x] != dist[y] + cst[i]) continue;\n            int t = dfs(y, min(cap[i], lim - flow), totalCost);\n            cap[i] -= t;\n            cap[i ^ 1] += t;\n            flow += t;\n            totalCost += t * cst[i];\n            if (flow == lim) return lim;\n        }\n        return flow;\n    };\n\n    long long totalCost = 0;\n    int totalFlow = 0;\n    while (spfa()) {\n        do {\n            memset(inQueue, 0, sizeof(inQueue));\n            totalFlow += dfs(SRC, INF, totalCost);\n        } while (inQueue[SNK]);\n    }\n    cout << totalCost;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXV = 10005\nSRC = MAXV - 2\nSNK = MAXV - 1\nINF = 2000000000\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    lim = 101\n\n    # adjacency list: list of edge indices\n    adj = [[] for _ in range(MAXV)]\n    edges = []  # each edge: [to, rev, cap, cost]\n\n    def add_edge(u, v, f, cost):\n        # forward edge\n        edges.append([v, 0, f, cost])\n        # reverse edge\n        edges.append([u, 0, 0, -cost])\n        # set rev indices\n        edges[-2][1] = len(edges) - 1\n        edges[-1][1] = len(edges) - 2\n        # add to adjacency lists\n        adj[u].append(len(edges) - 2)\n        adj[v].append(len(edges) - 1)\n\n    # read starting positions\n    for _ in range(k):\n        x = int(next(it)) - 1\n        add_edge(SRC, x, 1, 0)\n\n    # sink edges for each time layer\n    for i in range(lim):\n        add_edge(i * n, SNK, k, c * i)\n\n    # stay edges (waiting)\n    for i in range(n):\n        for j in range(lim - 1):\n            add_edge(i + j * n, i + (j + 1) * n, k, 0)\n\n    # movement edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for i in range(lim - 1):\n            for j in range(k - 1, -1, -1):\n                cost = d * (2 * j + 1)\n                add_edge(x + i * n, y + (i + 1) * n, 1, cost)\n                add_edge(y + i * n, x + (i + 1) * n, 1, cost)\n\n    dist = [0] * MAXV\n    in_queue = [False] * MAXV\n    q = deque()\n\n    def spfa():\n        nonlocal dist, in_queue\n        # reset\n        for i in range(MAXV):\n            in_queue[i] = False\n            dist[i] = 10**18\n        q.append(SNK)\n        dist[SNK] = 0\n        in_queue[SNK] = True\n        while q:\n            x = q.popleft()\n            in_queue[x] = False\n            for ei in adj[x]:\n                e = edges[ei]\n                y = e[0]\n                # use reverse edge capacity and cost\n                rev = edges[e[1]]\n                if rev[2] and dist[y] > dist[x] + rev[3]:\n                    dist[y] = dist[x] + rev[3]\n                    if not in_queue[y]:\n                        q.append(y)\n                        in_queue[y] = True\n        return dist[SRC] < 10**18\n\n    total_cost = 0\n    total_flow = 0\n\n    # DFS function (recursive)\n    def dfs(x, lim_flow):\n        nonlocal total_cost\n        flow = 0\n        in_queue[x] = True\n        if x == SNK:\n            return lim_flow\n        for ei in adj[x]:\n            e = edges[ei]\n            y = e[0]\n            if e[2] == 0 or in_queue[y]:\n                continue\n            if dist[x] != dist[y] + e[3]:\n                continue\n            t = dfs(y, min(e[2], lim_flow - flow))\n            if t:\n                e[2] -= t\n                edges[e[1]][2] += t\n                flow += t\n                total_cost += t * e[3]\n                if flow == lim_flow:\n                    return lim_flow\n        return flow\n\n    while spfa():\n        while True:\n            for i in range(MAXV):\n                in_queue[i] = False\n            total_flow += dfs(SRC, INF)\n            if not in_queue[SNK]:\n                break\n\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0007142852991819382, 0.0, 0.0, -0.0003631647559814155, -0.011275970377027988, -0.00014399446081370115, -0.029766269028186798, -0.024794697761535645, -0.00023326536756940186, 0.0, -5.960462772236497e-07, -0.0024942022282630205, -0.030938103795051575, -3.576278118089249e-07, -2.50339189733495e-06, 0.0, -1.9073468138230965e-06, -1.0728830375228426e-06, -3.933898824470816e-06, -3.576278118089249e-07, 0.0, -1.4305104514278355e-06, -4.768370445162873e-07, 0.0, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -2