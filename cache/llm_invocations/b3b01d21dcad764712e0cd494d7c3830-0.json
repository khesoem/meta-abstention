  public static void main(String[] args) throws Exception {\n    init(System.in);\n    long n = nextLong();\n    System.out.println(solve(n));\n  }\n\n  static long solve(long x) {\n    if (x <= 6) return x;\n    int d = String.valueOf(x).length();\n    long r = repunits[d];\n    if (x == r) return d;\n    long prev = repunits[d - 1];\n    long next = repunits[d + 1];\n    long costDown = (x / r) * d + solve(x % r);\n    long costUp = Long.MAX_VALUE;\n    if (next - x <= x) {\n      costUp = solve(next - x) + (d + 1);\n    }\n    return Math.min(costDown, costUp);\n  }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n  static BufferedReader br;\n  static StringTokenizer st;\n\n  static void init(InputStream in) {\n    br = new BufferedReader(new InputStreamReader(in));\n    st = new StringTokenizer(\"\");\n  }\n\n  static String next() throws IOException {\n    while (st.isEmpty()) {\n      st = new StringTokenizer(br.readLine());\n    }\n    return st.nextToken();\n  }\n\n  static long nextLong() throws IOException {\n    return Long.parseLong(next());\n  }\n\n  static final long[] repunits = new long[] {\n    0L, 1L, 11L, 111L, 1111L, 11111L, 111111L, 1111111L, 11111111L, 111111111L,\n    1111111111L, 11111111111L, 111111111111L, 1111111111111L, 11111111111111L, 111111111111111L,\n    1111111111111111L, 11111111111111111L, 111111111111111111L, 1111111111111111111L\n  };\n\n  static long[][] memo;\n\n  public static void main(String[] args) throws Exception {\n    init(System.in);\n    long n = nextLong();\n    memo = new long[(int)n + 1][];\n    if (n > 0) {\n      for (int i = 0; i <= n; i++) {\n        memo[i] = new long[2];\n        Arrays.fill(memo[i], -1);\n      }\n    }\n    System.out.println(solve(n));\n  }\n\n  static long solve(long x) {\n    if (x == 0) return 0;\n    if (x < 0) return solve(-x);\n    if (x <= 11) {\n      if (x == 1) return 1;\n      if (x == 2) return 2;\n      if (x == 3) return 3;\n      if (x == 4) return 4;\n      if (x == 5) return 5;\n      if (x == 6) return 6;\n      if (x == 7) return 7;\n      if (x == 8) return 8;\n      if (x == 9) return 9;\n      if (x == 10) return 2; // 11 - 1 = 10, uses 2 ones\n      if (x == 11) return 2; // 11 uses 2 ones\n    }\n    \n    int d = String.valueOf(x).length();\n    long r = repunits[d];\n    if (r == x) return d;\n    \n    long prev = repunits[d - 1];\n    long next = repunits[d + 1];\n    \n    // Option 1: use floor division with repunit of length d\n    long costDown = Long.MAX_VALUE;\n    if (r > 0) {\n      long count = x / r;\n      long remainder = x % r;\n      if (remainder == 0) {\n        costDown = count * d;\n      } else {\n        costDown = count * d + solve(remainder);\n      }\n    }\n    \n    // Option 2: use next repunit and subtract\n    long costUp = Long.MAX_VALUE;\n    if (next > 0 && next - x <= x) {\n      costUp = solve(next - x) + (d + 1);\n    }\n    \n    return Math.min(costDown, costUp);\n  }\n}\n</repaired_code>\n<confidence>\n0.7\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -5.173549288883805e-05, -5.960462772236497e-07, 0.0, -2.9802276912960224e-06, -7.271740287251305e-06, -1.4305104514278355e-06, -8.4638240878121e-06, -1.4185804502631072e-05, -3.6954811548639555e-06, -7.152555099310121e-07, -0.0024895647075027227, -2.50339189733495e-06, -1.1920928244535389e-07, -1.6689286894688848e-06, -1.6689286894688848e-06, -8.49926145747304e-05, -4.768370445162873e-07, -3.93382906622719e-05, -4.768370445162873e-07, -1.7046782886609435e-05, -2.3841855067985307e-07, -3.576278118089249e-07, -4.172316494077677e-06, -2.0265558760002023e-06, -6.437280717364047e-06, -8.344646857949556e-07, -1.5497195136049413e-06, -2.0265558760002023e-06, -3.2186455882765586e-06, -2.098061486321967e-05, -4.768370445162873e-07, -1.1920928244535389e-07, 0