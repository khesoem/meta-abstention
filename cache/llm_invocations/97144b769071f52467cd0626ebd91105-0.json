 choose(long n, long k) {\n      long num = 1, den = 1;\n      for(int i=(int)(n-k+1); i<=n; i++) num = (num * i) % mod;\n      for(int i=1; i<=k; i++) den = (den * i) % mod;\n      den = power(den, mod-2);\n      return (num * den) % mod;\n   }\n   public static long power(long x, long y) {\n      long res = 1;\n      x %= mod;\n      while (y > 0) {\n         if ((y & 1) == 1) { res = (res * x) % mod; }\n         y >>= 1;\n         x = (x * x) % mod;\n      }\n      return res;\n   }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst long long mod = 998244353LL;\n\nlong long power(long long x, long long y) {\n    long long res = 1;\n    x %= mod;\n    while (y > 0) {\n        if (y & 1) {\n            res = (res * x) % mod;\n        }\n        y >>= 1;\n        x = (x * x) % mod;\n    }\n    return res;\n}\n\nlong long choose(long long n, long long k) {\n    long long num = 1, den = 1;\n    for (int i = (int)(n - k + 1); i <= (int)n; i++) {\n        num = (num * i) % mod;\n    }\n    for (int i = 1; i <= (int)k; i++) {\n        den = (den * i) % mod;\n    }\n    den = power(den, mod - 2);\n    return (num * den) % mod;\n}\n\nint main() {\n    int n;\n    long long kk;\n    cin >> n >> kk;\n    if (kk >= n) {\n        cout << \"0\" << endl;\n    } else {\n        int k = (int)kk;\n        int r = n - k;\n        vector<long long> rChoose(r + 1);\n        rChoose[0] = 1LL;\n        long long num = 1, den = 1;\n        for (int i = 1; i <= r; i++) {\n            num = (num * (r + 1 - i)) % mod;\n            den = (den * i) % mod;\n            rChoose[i] = (num * power(den, mod - 2)) % mod;\n        }\n        long long ans = 0;\n        long long sign = 1;\n        for (int i = 0; i <= r; i++) {\n            long long term = power((long long)(r - i), (long long)n) * rChoose[i] %