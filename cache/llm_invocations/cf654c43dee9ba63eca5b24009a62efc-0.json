 res = 0\n        while not self.isSpaceChar(c):\n            if c < ord('0') or c > ord('9'):\n                raise IOError()\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n        return res * sgn\n\n    def nextInt(self):\n        return int(self.nextLong())\n\n    def isSpaceChar(self, c):\n        return c <= 32 or c == 127\n\n\ndef execute():\n    in_reader = InputReader(sys.stdin.buffer)\n    n = in_reader.nextLong()\n    first = []\n    second = []\n    \n    for i in range(3):\n        first.append(in_reader.nextLong())\n    for i in range(3):\n        second.append(in_reader.nextLong())\n    \n    wins = 0\n    lossesOrDraws = 0\n    \n    for i in range(3):\n        wins += min(first[i], second[(i + 1) % 3])\n        potentialLoss = min(second[i], first[(i + 1) % 3])\n        potentialDraw = min(second[i], first[i])\n        lossesOrDraws += min(second[i], potentialLoss + potentialDraw)\n    \n    print(f\"{n - lossesOrDraws} {wins}\")\n\n\nif __name__ == \"__main__\":\n    execute()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.703165414975956e-05, -4.768370445162873e-07, -2.3841855067985307e-07, -0.003112711710855365, -0.0006430465145967901, -0.004621183034032583, -0.1128254383802414, -0.03807205334305763, -1.0728830375228426e-06, -3.099436753473128e-06, -3.7431014789035544e-05, -4.768370445162873e-07, -1.1920922133867862e-06, -9.536738616588991e-07, -2.3841855067985307e-07, -4.887569048150908e-06, -1.1920928244535389e-07, -0.5231997966766357, -0.00015901254664640874, -9.536738616588991e-07, -4.768370445162873e-07, -5.364403477869928e-06, 0.0, -2.7656173188006505e-05, -1.1920922133867862e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -9.214453893946484e-05, -9.536738616588991e-07, -0.027236592024564743, -1.6689286894688848e-06, -1.0251946150674485e-05, -1.7881377516459906e-06, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -3.099436753473128e-06, -1.6689286894688848e