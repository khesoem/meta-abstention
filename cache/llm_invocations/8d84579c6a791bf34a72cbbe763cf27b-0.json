   eb = Edge()\n    ea.from_node = a\n    ea.to_node = b\n    ea.flow = w\n    ea.opposite = eb\n    eb.from_node = b\n    eb.to_node = a\n    eb.flow = 0\n    eb.opposite = ea\n    a.adjusted.append(ea)\n    b.adjusted.append(eb)\n\ndef max_flow(g: List[Node], source: Node, sink: Node) -> int:\n    result = 0\n    while True:\n        for u in g:\n            u.age = 0\n        q = deque()\n        q.append(source)\n        source.age = 1\n        while q and sink.age == 0:\n            u = q.popleft()\n            for e in u.adjusted:\n                v = e.to_node\n                if v.age != 0 or e.flow == 0:\n                    continue\n                v.back = e\n                v.age = u.age + 1\n                q.append(v)\n        if sink.age == 0:\n            break\n        for e in sink.adjusted:\n            o = e.opposite\n            if o.from_node.age != sink.age - 1 or o.flow == 0:\n                continue\n            result += adjust(o, o.flow)\n    return result\n\ndef linear(t: int, r: int, c: int, n: int) -> int:\n    return t * n * n + r * n + c\n\ndef main():\n    input_lines = sys.stdin.read().strip().split('\\n')\n    idx = 0\n    output_lines = []\n    while idx < len(input_lines):\n        line = input_lines[idx].strip()\n        if not line:\n            idx += 1\n            continue\n        n, T = map(int, line.split())\n        idx += 1\n        \n        g = [Node() for _ in range((T + 1) * n * n + 2)]\n        source = g[linear(T, n-1, n-1, n) + 1]\n        sink = g[linear(T, n-1, n-1, n) + 2]\n        \n        lab = []\n        for r in range(n):\n            lab.append(input_lines[idx].strip())\n            idx += 1\n        \n        z = []\n        for r in range(n):\n            for c in range(n):\n                if lab[r][c] == 'Y':\n                    continue\n                if lab[r][c] == 'Z':\n                    z.append((r, c))\n                    continue\n                connect(source, g[linear(0, r, c, n)],