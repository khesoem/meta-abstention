o[depth][mask] + invFact[mask] * calc(depth + 1, 0)) % mod;\n    return memo[depth][mask];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> mod;\n    ll total = power(k, n);\n    \n    if (n & 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = fact[i-1] * i % mod;\n    \n    invFact[n] = power(fact[n], mod - 2);\n    for (int i = n; i > 0; --i) invFact[i-1] = invFact[i] * i % mod;\n    \n    memset(memo, -1, sizeof(memo));\n    ll bad_cases = calc(0, n);\n    ll answer = (total - bad_cases + mod) % mod;\n    cout << answer << '\\n';\n    \n    return 0;\n}\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAX_N = 250005;\n    static int n, k, mod;\n    static long[] fact = new long[MAX_N];\n    static long[] invFact = new long[MAX_N];\n    static long[][] memo = new long[26][MAX_N];\n    \n    static long power(long base, long exponent) {\n        long result = 1;\n        base %= mod;\n        while (exponent > 0) {\n            if ((exponent & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exponent >>= 1;\n        }\n        return result;\n    }\n    \n    static int getLSB(int x) {\n        return x & -x;\n    }\n    \n    static long calc(int depth, int mask) {\n        if (memo[depth][mask] != -1) {\n            return memo[depth][mask];\n        }\n        \n        if (mask == 0) {\n            memo[depth][mask] = fact[n];\n            for (int i = 0; i < depth; ++i) {\n                memo[depth][mask] = (memo[depth][mask] * (k - i)) % mod;\n            }\n            return memo[depth][mask];\n        }\n        \n        memo[depth][mask] = 0;\n        int rest = mask ^ getLSB(mask);\n        \n        for (int sub = rest; sub != 0; sub = (sub - 1) & rest) {\n            memo[depth][mask] = (memo[depth][mask] + invFact[mask ^ sub] * calc(depth + 1, sub)) % mod;\n        }\n        \n        memo[depth][mask] = (memo[depth][mask] + invFact[mask] * calc(depth + 1, 0)) % mod;\n        return memo[depth][mask];\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        mod = Integer.parseInt(st.nextToken());\n        \n        long total = power(k, n);\n        \n        if ((n & 1) == 1) {\n            System.out.println(total);\n            return;\n        }\n        \n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = fact[i-1] * i % mod;\n        }\n        \n        invFact[n] = power(fact[n], mod - 2);\n        for (int i = n; i > 0; --i) {\n            invFact[i-1] = invFact[i] * i % mod;\n        }\n        \n        for (int i = 0; i < 26; ++i) {\n            Arrays.fill(memo[i], -1);\n        }\n        \n        long bad_cases = calc(0, n);\n        long answer = (total - bad_cases + mod) % mod;\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.500529267825186e-05, -1.6689286894688848e-06, -3.576278118089249e-07, -0.000856628583278507, -2.002696055569686e-05, -0.04332233592867851, -0.18105937540531158, -0.0002554328821133822, -1.3232143828645349e-05, -0.0002650863316375762, -0.00022289653134066612, -3.4450891689630225e-05, -1.4305104514278355e-06, -3.8980677345534787e-05, -0.0008062449633143842, -8.546940807718784e-05, -0.01489223912358284, -0.5780086517333984, -1.0728830375228426e-06, -2.26497400035441