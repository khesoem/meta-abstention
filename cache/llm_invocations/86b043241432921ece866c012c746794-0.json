(i);\n        mx[i] = 1 << (31 - __builtin_clz(i));\n    }\n    dp[0][0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        if ((n & i) != i) continue;\n        int now = i ^ mx[i];\n        int k = now;\n        while (true) {\n            int cur1 = k + mx[i];\n            int cur2 = i ^ cur1;\n            int up = min(K - 1, cnt[cur2]);\n            int tmp = C(i, cur1);\n            for (int j = 0; j <= up; ++j) {\n                dp[i][j + 1] = add(dp[i][j + 1], mul(dp[cur2][j], tmp));\n            }\n            if (k == 0) break;\n            k = (k - 1) & now;\n        }\n    }\n    int ans = 0;\n    int lim = min(cnt[n], K);\n    for (int j = 1; j <= lim; ++j) {\n        ans = add(ans, mul(mul(dp[n][j], C(K, j)), fact[j]));\n    }\n    ans = (power(K, n) - ans + mod) % mod;\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int N = 300010;\n    static int n, K, mod;\n    static int[][] dp;\n    static int[] cnt, mx;\n    static int[] fact, invFact;\n\n    static int add(int a, int b) {\n        int res = a + b;\n        if (res >= mod) res -= mod;\n        return res;\n    }\n\n    static int mul(int a, int b) {\n        return (int)((long)a * b % mod);\n    }\n\n    static int power(int x, int y) {\n        int res = 1;\n        while (y > 0) {\n            if ((y & 1) == 1) res = mul(res, x);\n            x = mul(x, x);\n            y >>= 1;\n        }\n        return res;\n    }\n\n    static int C(int i, int j) {\n        return mul(mul(fact[i], invFact[j]), invFact[i - j]);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        K = Integer.parseInt(st.nextToken());\n        mod = Integer.parseInt(st.nextToken());\n\n        if ((n & 1) == 1) {\n            System.out.println(power(K, n));\n            return;\n        }\n\n        dp = new int[N + 1][20];\n        cnt = new int[N + 1];\n        mx = new int[N + 1];\n        fact = new int[N + 1];\n        invFact = new int[N + 1];\n\n        fact[0] = 1;\n        for (int i = 1; i <= n; ++i) fact[i] = mul(fact[i - 1], i);\n        invFact[n] = power(fact[n], mod - 2);\n        invFact[0] = 1;\n        for (int i = n - 1; i >= 1; --i) invFact[i] = mul(invFact[i + 1], i + 1);\n\n        for (int i = 1; i <= n; ++i) {\n            cnt[i] = Integer.bitCount(i);\n            mx[i] = 1 << (31 - Integer.numberOfLeadingZeros(i));\n        }\n\n        dp[0][0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            if ((n & i) != i) continue;\n            int now = i ^ mx[i];\n            int k = now;\n            while (true) {\n                int cur1 = k + mx[i];\n                int cur2 = i ^ cur1;\n                int up = Math.min(K - 1, cnt[cur2]);\n                int tmp = C(i, cur1);\n                for (int j = 0; j <= up; ++j) {\n                    dp[i][j + 1] = add(dp[i][j + 1], mul(dp[cur2][j], tmp));\n                }\n                if (k == 0) break;\n                k = (k - 1) & now;\n            }\n        }\n\n        int ans = 0;\n        int lim = Math.min(cnt[n], K);\n        for (int j = 1; j <= lim; ++j) {\n            ans = add(ans, mul(mul(dp[n][j], C(K, j)), fact[j]));\n        }\n        ans = (power(K, n) - ans + mod) % mod;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -2.4437606043647975e-05, -2.145764938177308e-06, -1.1920928244535389e-07, -0.10020863264799118, -0.4741259813308716, 0.0, 0.0, -1.0132738680113107e-05, -0.0032506741117686033, -1.4305104514278355e-06, 0.0, -0.0117828119546