ic\n        if (a == 1) {\n            int r = b % 6;\n            int q = b / 6;\n            if (r == 4) {\n                System.out.println(q * 6 + 2);\n            } else if (r == 5) {\n                System.out.println(q * 6 + 4);\n            } else {\n                System.out.println(q * 6);\n            }\n        } else if (a == 2) {\n            if (b <= 2) {\n                System.out.println(0);\n            } else if (b == 3 || b == 7) {\n                System.out.println(a * b - 2);\n            } else {\n                System.out.println(b << 1);\n            }\n        } else {\n            int prod = a * b;\n            System.out.println(prod % 2 == 0 ? prod : prod - 1);\n        }\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-6.806619057897478e-05, -1.1920922133867862e-06, -2.3841855067985307e-07, -2.0265373677830212e-05, -2.0265373677830212e-05, -0.00012361239350866526, -0.0054307072423398495, -1.1920922133867862e-06, -3.4570634852570947e-06, -1.1920928244535389e-07, -8.272782724816352e-05, -0.0001591317413840443, -1.7881377516459906e-06, -1.1920928244535389e-07, -7.152555099310121e-07, -2.3841855067985307e-07, -2.622600959512056e-06, -1.6689286894688848e-06, -4.6491513785440475e-06, -1.6093124941107817e-05, -3.576278118089249e-07, -2.3841855067985307e-07, -1.9073468138230965e-06, -6.437280717364047e-06, -0.04873653128743172, -9.536738616588991e-07, -1.1920928244535389e-07, -0.00024172721896320581, -2.145764938177308e-06, -2.3841855067985307e-07, -1.597391747054644e-05, -0.20141996443271637, -7.855583680793643e-05, -1.1920928244535389e-07, -6.437280717364047e-06, -1.9550132492440753e-05, -3.099436753473128e-06, -3.099436753473128e-06, -3.576278118089249e-07, -3.576278118089249e-07, -1.4305104514278355e-06, -1.1920928244535389e-07, -2.038458114839159e-05, -1.6689286894688848e-06, -0.10024184733629227, -0.5231338739395142, -6.6756979322235566e-06, -4.768360213347478e-06, -0.020545169711112976, -1.3232