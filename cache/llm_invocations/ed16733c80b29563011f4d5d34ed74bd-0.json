for (int j = 0; j < chars.length; j++) {\n                            if (chars[j] == 'X') {\n                                chars[j] = (char) ('0' + digit);\n                            }\n                        }\n                        total += computeValue(new String(chars));\n                    }\n                    out.println(total);\n                }\n            }\n        }\n        out.close();\n    }\n\n    public static int computeValue(String s) {\n        int n = s.length();\n        int ways = 0;\n        if (s.charAt(0) != '0') {\n            ways = 1;\n        }\n        for (int i = 0; i < n - 2; i++) {\n            if (s.charAt(i) == '_') {\n                if (i == 0) {\n                    ways *= 9;\n                } else {\n                    ways *= 10;\n                }\n            }\n        }\n        int suffixWays = 0;\n        if (s.charAt(n - 1) == '_' && s.charAt(n - 2) == '_') {\n            suffixWays = 4;\n            if (n == 2) {\n                suffixWays = 3;\n            }\n        } else if (s.charAt(n - 1) == '_') {\n            char prev = s.charAt(n - 2);\n            if (prev == '0' || prev == '5' || prev == '2' || prev == '7') {\n                suffixWays = 1;\n            }\n        } else if (s.charAt(n - 2) == '_') {\n            char last = s.charAt(n - 1);\n            if (last == '0') {\n                suffixWays = 2;\n                if (n == 2) {\n                    suffixWays = 1;\n                }\n            } else if (last == '5') {\n                suffixWays = 2;\n            }\n        } else {\n            int lastTwo = Integer.parseInt(s.substring(n - 2));\n            if (lastTwo % 25 == 0) {\n                suffixWays = 1;\n            }\n        }\n        return ways * suffixWays;\n    }\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n  