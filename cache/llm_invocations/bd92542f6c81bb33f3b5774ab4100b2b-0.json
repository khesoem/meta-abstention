 }\n\n    static boolean spfa() {\n        Arrays.fill(dis, INF);\n        Arrays.fill(vis, false);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        vis[s] = true;\n        dis[s] = 0;\n        flow[s] = INF;\n        pre[t] = -1;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            vis[x] = false;\n            for (int i = h[x]; i != 0; i = nex[i]) {\n                if (val[i] > 0 && dis[to[i]] > dis[x] + cost[i]) {\n                    dis[to[i]] = dis[x] + cost[i];\n                    pre[to[i]] = x;\n                    last[to[i]] = i;\n                    flow[to[i]] = Math.min(flow[x], val[i]);\n                    if (!vis[to[i]]) {\n                        vis[to[i]] = true;\n                        q.offer(to[i]);\n                    }\n                }\n            }\n        }\n        return pre[t] != -1;\n    }\n\n    static void mcmf() {\n        mxf = mnc = 0;\n        while (spfa()) {\n            int now = t;\n            mxf += flow[t];\n            mnc += flow[t] * dis[t];\n            while (now != s) {\n                val[last[now]] -= flow[t];\n                val[last[now] ^ 1] += flow[t];\n                now = pre[now];\n            }\n        }\n    }\n\n    static int zh(int t, int x) {\n        return t * n + x;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        p = scanner.nextInt();\n        c = scanner.nextInt();\n        d = scanner.nextInt();\n        s = 0;\n        t = n * 99 + 1;\n        for (int i = 1; i <= p; i++) {\n            int x_val = scanner.nextInt();\n            addedge(s, zh(0, x_val), 1, 0);\n            addedge(zh(0, x_val), s, 0, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            x[i] = scanner.nextInt();\n            y[i] = scanner.nextInt();\n        }\n        for (int i = 0; i <= 99; i++) {\n            addedge