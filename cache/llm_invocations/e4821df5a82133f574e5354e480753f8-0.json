          }\n        }\n    }\n    while (!q.empty()) {\n        auto [uy, ux] = q.front(); q.pop();\n        for (int d = 0; d < 4; ++d) {\n            int vy = uy + dir[d][0], vx = ux + dir[d][1];\n            if (vy >= 1 && vy <= n && vx >= 1 && vx <= n && grid1[vy][vx] != 'Y' && dist[vy][vx] == -1) {\n                dist[vy][vx] = dist[uy][ux] + 1;\n                q.emplace(vy, vx);\n            }\n        }\n    }\n\n    // cap distances\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (dist[i][j] == -1 || dist[i][j] > t) dist[i][j] = INF;\n        }\n    }\n\n    Dinic dinic(id_counter);\n    // source edges\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (grid1[i][j] >= '1' && grid1[i][j] <= '9') {\n                dinic.add_edge(source, node_id[0][i][j], grid1[i][j] - '0');\n            }\n        }\n    }\n\n    // time edges\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (grid1[i][j] == 'Y' || grid1[i][j] == 'Z') continue;\n            for (int d = 0; d < 4; ++d) {\n                int vy = i + dir[d][0], vx = j + dir[d][1];\n                if (vy >= 1 && vy <= n && vx >= 1 && vx <= n && grid1[vy][vx] != 'Y' && grid1[vy][vx] != 'Z') {\n                    for (int x = 0; x < t; ++x) {\n                        if (dist[vy][vx] >= x+1 && dist[i][j] > x) {\n                            dinic.add_edge(node_id[x][i][j], node_id[x+1][vy][vx], 1000);\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    // sink edges (two steps combined)\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (grid1[i][j] == 'Y' || grid1[i][j] == 'Z') continue;\n            if (grid2[i][j] >= '1' && grid2[i][j] <= '9') {\n                int cap = grid2[i][j] - '0';\n                for (int x = 0; x <= t; ++x) {\n                    dinic.add_edge(node_id[x]