, T):\n        total = 0\n        while self.bfs(S, T):\n            self.pt = [0] * self.N\n            while True:\n                flow = self.dfs(S, T)\n                if not flow:\n                    break\n                total += flow\n        return total\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    # read grid1 lines\n    grid1 = []\n    for _ in range(n):\n        line = next(it)\n        grid1.append(line)\n    # grid2 lines after reading grid1\n    grid2 = []\n    for _ in range(n):\n        line = next(it)\n        grid2.append(line)\n\n    # assign node ids\n    # times from 0 to t+1 inclusive -> t+2 layers\n    node_id = [[[0] * n for _ in range(n)] for _ in range(t + 2)]\n    id_counter = 1\n    for time in range(t + 2):\n        for i in range(n):\n            for j in range(n):\n                node_id[time][i][j] = id_counter\n                id_counter += 1\n\n    source = 0\n    sink = id_counter\n    id_counter += 1\n\n    # BFS from all 'Z' cells\n    dist = [[-1] * n for _ in range(n)]\n    q = deque()\n    for i in range(n):\n        for j in range(n):\n            if grid1[i][j] == 'Z':\n                q.append((i, j))\n                dist[i][j] = 0\n\n    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    while q:\n        uy, ux = q.popleft()\n        for dy, dx in dirs:\n            vy = uy + dy\n            vx = ux + dx\n            if 0 <= vy < n and 0 <= vx < n:\n                if grid1[vy][vx] != 'Y' and dist[vy][vx] == -1:\n                    dist[vy][vx] = dist[uy][ux] + 1\n                    q.append((vy, vx))\n\n    # cap distances\n    for i in range(n):\n        for j in range(n):\n            if dist[i][j] == -1 or dist[i][j] > t:\n                dist[i][j] = INF\n\n    dinic = Dinic(id_counter)\n\n    # source edges\n    for i in range(n):\n        for j in range(n):\n            if '1' <= grid1[i][j] <= '9':\n                cap = int(grid1[i][j])\n                dinic.add_edge(source, node_id[0][i][j], cap)\n\n    # time edges\n    for i in range(n):\n        for j in range(n):\n            if grid1[i][j] in ('Y', 'Z'):\n                continue\n            for dy, dx in dirs:\n                vy = i + dy\n                vx = j + dx\n                if 0 <= vy < n and 0 <= vx < n:\n                    if grid1[vy][vx] in ('Y', 'Z'):\n                        continue\n                    for x in range(t):\n                        if dist[vy][vx] >= x + 1 and dist[i][j] > x:\n                            dinic.add_edge(node_id[x][i][j], node_id[x + 1][vy][vx], 1000)\n\n    # sink edges\n    for i in range(n):\n        for j in range(n):\n            if grid1[i][j] in ('Y', 'Z'):\n                continue\n            if '1' <= grid2[i][j] <= '9':\n                cap = int(grid2[i][j])\n                for x in range(t + 1):\n                    dinic.add_edge(node_id[x][i][j], node_id[t + 1][i][j], cap)\n                dinic.add_edge(node_id[t + 1][i][j], sink, cap)\n\n    print(dinic.max_flow(source, sink))\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -3.397406908334233e-05, -0.0031838936265558004, -5.960462772236497e-07, 0.0, -9.298280929215252e-06, -0.023423513397574425, -0.04609929770231247, -1.4781842764932662e-05, -0.0002037079248111695, -0.00017176583060063422, -0.16023699939250946, -5.006777428206988e-06, -0.4750846028327942, -0.019474845379590988, -0.014178022742271423, 0.0, -3.6954811548639555e-06, -1.1920922133867862e-06, -7.629365427419543e-06, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -0.02324567921459675, -0.00027056847466155887, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -8.821448318485636e-06, 0.0, -1.1920928244535389e-07, -0.01330497395247221, -4.768370445162873e-07, -0.3