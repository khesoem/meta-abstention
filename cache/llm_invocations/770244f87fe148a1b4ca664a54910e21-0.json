\n            return invFactorial[n];\n        }\n\n        long long paritySign(long long k) {\n            return (k & 1) == 0 ? 1 : modulus() - 1;\n        }\n\n        long long ncr(int n, int r) {\n            if (r < 0 || n < r) return 0;\n            return mult(fact(n), mult(fInv(r), fInv(n - r)));\n        }\n\n        long long smallInv(int n) {\n            return mult(fInv(n), fact(n - 1));\n        }\n\n        long long normalize(long long x) {\n            x %= modulus();\n            if (x < 0) x += modulus();\n            return x;\n        }\n\n        long long add(long long a, long long b) {\n            long long v = a + b;\n            return v < modulus() ? v : v - modulus();\n        }\n\n        long long mult(long long a, long long b) {\n            return (a * b) % modulus();\n        }\n\n        long long mult(long long a, long long b, long long c) {\n            return mult(mult(a, b), c);\n        }\n\n        long long mult(long long a, long long b, long long c, long long d) {\n            return mult(mult(mult(a, b), c), d);\n        }\n\n        long long inv(long long value) {\n            long long g = modulus(), x = 0, y = 1;\n            for (long long r = value; r != 0;) {\n                long long q = g / r;\n                g %= r;\n\n                long long temp = g;\n                g = r;\n                r = temp;\n\n                x -= q * y;\n\n                temp = x;\n                x = y;\n                y = temp;\n            }\n\n            if (g != 1) {\n                throw runtime_error(\"Modular inverse does not exist\");\n            }\n\n            return normalize(x);\n        }\n    };\n\n    class Mod998 : public Modulus {\n    public:\n        long long modulus() override {\n            return 998244353LL;\n        }\n    };\n};\n\nclass HZSShufflesCards {\npublic:\n    NumberTheory::Mod998 mod;\n    int n;\n    int m;\n\n    void solve(int testNumber, InputReader& in, ostream& out) {\n        n