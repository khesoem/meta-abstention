      return self.x * o.y - self.y * o.x\n    \n    def mag2(self):\n        return self.dot(self)\n    \n    def mag(self):\n        return math.sqrt(self.mag2())\n    \n    def unit(self):\n        m = self.mag()\n        if m == 0:\n            return Vec(0, 0)\n        return self.scale(1 / m)\n    \n    def rot90(self):\n        return Vec(-self.y, self.x)\n    \n    def rot270(self):\n        return Vec(self.y, -self.x)\n    \n    def rotate(self, theta):\n        newX = self.x * math.cos(theta) + self.y * math.cos(math.pi / 2 + theta)\n        newY = self.x * math.sin(theta) + self.y * math.sin(math.pi / 2 + theta)\n        return Vec(newX, newY)\n    \n    def angle(self):\n        return (math.atan2(self.y, self.x) + 2 * math.pi) % (2 * math.pi)\n    \n    def __str__(self):\n        return f\"({self.x:.2f}, {self.y:.2f})\"\n    \n    @staticmethod\n    def eq(a, b):\n        return abs(a - b) < Vec.EPS\n    \n    def __eq__(self, other):\n        if not isinstance(other, Vec):\n            return False\n        return Vec.eq(self.x, other.x) and Vec.eq(self.y, other.y)\n    \n    def __hash__(self):\n        return hash((round(self.x / Vec.EPS), round(self.y / Vec.EPS)))\n\nclass Circle:\n    def __init__(self, center, radius):\n        self.center = center\n        self.radius = radius\n    \n    def contains(self, v):\n        return self.center.sub(v).mag2() - Vec.EPS * Vec.EPS <= self.radius * self.radius\n    \n    def intersect(self, other):\n        if self.center == other.center:\n            return None\n        direction = other.center.sub(self.center)\n        dist_sq = direction.mag2()\n        dist = math.sqrt(dist_sq)\n        \n        if self.radius + other.radius < dist or self.radius + dist < other.radius or other.radius + dist < self.radius:\n            return None\n        \n        if Vec.eq(self.radius + other.radius, dist) or Vec.eq(other.radius + dist, self.radius):\n            return [self.center.add(direction.scale(self.radius /