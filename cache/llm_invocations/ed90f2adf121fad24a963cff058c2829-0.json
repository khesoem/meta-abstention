t n = a.size();\n    for (int len = 1; len < n; len <<= 1) {\n        for (int i = 0; i < n; i += len << 1) {\n            for (int j = 0; j < len; ++j) {\n                int x = a[i + j];\n                int y = (i64)sign * a[i + j + len] % MOD;\n                a[i + j] = normalize(x + y);\n                a[i + j + len] = normalize(x - y);\n            }\n        }\n    }\n}\n\nint main() {\n#ifdef pig\n    freopen(\"C.in\", \"r\", stdin);\n    freopen(\"C.out\", \"w\", stdout);\n#endif\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> K >> MOD;\n    init_factorials(N);\n    \n    if (N & 1) {\n        cout << fast_pow(K, N);\n        return 0;\n    }\n    \n    int M = 1, L = 0;\n    while (M <= N) {\n        M <<= 1;\n        ++L;\n    }\n    \n    BIT_CNT.resize(M);\n    for (int i = 0; i < M; ++i)\n        BIT_CNT[i] = __builtin_popcount(i);\n    \n    init_factorials(M);\n    \n    DP.assign(L + 1, vector<int>(M, 0));\n    for (int i = 0; i < M; ++i)\n        DP[BIT_CNT[i]][i] = INV_FACT[i];\n    \n    for (int i = 0; i <= L; ++i)\n        fwht(DP[i], 1);\n    \n    TMP.resize(L + 1);\n    for (int s = 0; s < M; ++s) {\n        for (int i = 0; i <= L; ++i)\n            TMP[i] = DP[i][s];\n        \n        vector<i64> RES(L + 1, 0);\n        RES[0] = 1;\n        vector<i64> BASE(TMP.begin(), TMP.end());\n        int EXP = K;\n        \n        while (EXP) {\n            if (EXP & 1) {\n                vector<i64> NEW_RES(L + 1, 0);\n                for (int i = 0; i <= L; ++i)\n                    for (int j = 0; j <= L - i; ++j)\n                        NEW_RES[i + j] = (NEW_RES[i + j] + RES[i] * BASE[j]) % MOD;\n                RES = move(NEW_RES);\n            }\n            vector<i64> SQ(L + 1, 0);\n            for (int i = 0; i <= L; ++i)\n                for (int j = 0; j <= L - i; ++j)\n                    SQ[i + j] = (SQ[i + j] + BASE[i] * BASE[j]) % MOD;\n            BASE = move(SQ);\n            EXP >>= 1;\n        }\n        \n        for (int i = 0; i <= L; ++i)\n            DP[i][s] = RES[i];\n    }\n    \n    fwht(DP[BIT_CNT[N]], M, -1);\n    \n    i64 ans = fast_pow(K, N) - (i64)DP[BIT_CNT[N]][N] * FACT[N] % MOD;\n    ans = normalize(ans);\n    cout << ans;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom typing import List\n\ndef normalize(x: int, MOD: int) -> int:\n    x %= MOD\n    if x < 0:\n        x += MOD\n    return x\n\ndef fast_pow(base: int, exp: int, MOD: int) -> int:\n    res = 1\n    base = normalize(base, MOD)\n    while exp:\n        if exp & 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return res\n\ndef init_factorials(limit: int, MOD: int) -> tuple:\n    FACT = [1] * (limit + 1)\n    INV_FACT = [1] * (limit + 1)\n    for i in range(1, limit + 1):\n        FACT[i] = (FACT[i-1] * i) % MOD\n    INV_FACT[limit] = fast_pow(FACT[limit], MOD - 2, MOD)\n    for i in range(limit - 1, -1, -1):\n        INV_FACT[i] = (INV_FACT[i+1] * (i+1)) % MOD\n    return FACT, INV_FACT\n\ndef fwht(a: List[int], sign: int, MOD: int) -> None:\n    n = len(a)\n    len_ = 1\n    while len_ < n:\n        for i in range(0, n, len_ << 1):\n            for j in range(len_):\n                x = a[i + j]\n                y = (sign * a[i + j + len_]) % MOD\n                a[i + j] = normalize(x + y, MOD)\n                a[i + j + len_] = normalize(x - y, MOD)\n        len_ <<= 1\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n    MOD = int(data[2])\n    \n    FACT, INV_FACT = init_factorials(N, MOD)\n    \n    if N & 1:\n        print(fast_pow(K, N, MOD))\n        return\n    \n    M = 1\n    L = 0\n    while M <= N:\n        M <<= 1\n        L += 1\n    \n    BIT_CNT = [bin(i).count('1') for i in range(M)]\n    \n    FACT, INV_FACT = init_factorials(M, MOD)\n    \n    DP = [[0] * M for _ in range(L + 1)]\n    for i in range(M):\n        DP[BIT_CNT[i]][i] = INV_FACT[i]\n    \n    for i in range(L + 1):\n        fwht(DP[i], 1, MOD)\n    \n    TMP = [0] * (L + 1)\n    for s in range(M):\n        for i in range(L + 1):\n            TMP[i] = DP[i][s]\n        \n        RES = [0] * (L + 1)\n        RES[0] = 1\n        BASE = TMP[:]\n        EXP = K\n        \n        while EXP:\n            if EXP & 1:\n                NEW_RES = [0] * (L + 1)\n                for i in range(L + 1):\n                    for j in range(L + 1 - i):\n                        NEW_RES[i + j] = (NEW_RES[i + j] + RES[i] * BASE[j]) % MOD\n                RES = NEW_RES\n            SQ = [0] * (L + 1)\n            for i in range(L + 1):\n                for j in range(L + 1 - i):\n                    SQ[i + j] = (SQ[i + j] + BASE[i] * BASE[j]) % MOD\n            BASE = SQ\n            EXP >>= 1\n        \n        for i in range(L + 1):\n            DP[i][s] = RES[i]\n    \n    fwht(DP[BIT_CNT[N]], -1, MOD)\n    \n    ans = (fast_pow(K, N, MOD) - (DP[BIT_CNT[N]][N] * FACT[N]) % MOD) % MOD\n    ans = normalize(ans, MOD)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00028713393840007484, -1.311301275563892e-06, -4.768370445162873e-07, -0.024275094270706177, -0.002293101279065013, -0.69319748878479, -0.4020819664001465, -0.22145287692546844, -7.152555099310121e-07, -4.410734163684538e-06, -0.026605898514389992, -0.07774964720010757, -0.10169047862291336, -8.344646857949556e-07, -0.014170501381158829, 0.0, -0.14269296824932098, -0.008733173832297325, 0.0, -1.1920928244535389e-07, -1.5497195136049413e-06, -4.768370445162873e-07, -4.768370445162873e-07, -1.4305104514278355e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -1.4662635294371285e-05, -9.775113539944869e-06, 0.0, 0.0, -7.152555099310121e-07,