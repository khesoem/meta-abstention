e) % MOD;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    public static void solve() {\n        precompute();\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        long k = sc.nextLong();\n        if (k == 0) {\n            System.out.println(factorial[n]);\n            return;\n        }\n        if (n <= k) {\n            System.out.println(0);\n            return;\n        }\n        long comb = nCr(n, (int)k);\n        int cols = n - (int)k;\n        long sum = 0;\n        for (int i = 0; i <= cols; i++) {\n            long term = nCr(cols, i);\n            term = (term * modPow(cols - i, n)) % MOD;\n            if ((i & 1) == 1) {\n                sum = (sum - term + MOD) % MOD;\n            } else {\n                sum = (sum + term) % MOD;\n            }\n        }\n        long ans = (comb * sum) % MOD;\n        ans = (2 * ans) % MOD;\n        System.out.println(ans);\n    }\n\n    public static long extendedGCD(long a, long b, long[] xy) {\n        if (a == 0) {\n            xy[0] = 0;\n            xy[1] = 1;\n            return b;\n        }\n        long[] nextXY = new long[2];\n        long gcd = extendedGCD(b % a, a, nextXY);\n        xy[0] = nextXY[1] - (b / a) * nextXY[0];\n        xy[1] = nextXY[0];\n        return gcd;\n    }\n\n    public static long modInverse(long a, long m) {\n        long[] xy = new long[2];\n        long gcd = extendedGCD(a, m, xy);\n        if (gcd != 1) return -1;\n        long inv = (xy[0] % m + m) % m;\n        return inv;\n    }\n\n    public static void main(String[] args) {\n        solve();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\nMAX = int(4e5) + 10\nfactorial = None\ninvFactorial = None\n\ndef precompute():\n    global factorial, invFactorial\n    factorial = [0] * MAX\n    invFactorial = [0] * MAX\n    factorial[0] = factorial[1] = invFactorial[0] = invFactorial[1] = 1\n    for i in range(2, MAX):\n        factorial[i] = (factorial[i - 1] * i) % MOD\n        invFactorial[i] = (invFactorial[i - 1] * modInverse(i, MOD)) % MOD\n\ndef nCr(n, r):\n    res = factorial[n]\n    res = (res * invFactorial[r]) % MOD\n    res = (res * invFactorial[n - r]) % MOD\n    return res\n\ndef modPow(base, exp):\n    result = 1\n    base %= MOD\n    while exp > 0:\n        if (exp & 1) == 1:\n            result = (result * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return result\n\ndef extendedGCD(a, b, xy):\n    if a == 0:\n        xy[0] = 0\n        xy[1] = 1\n        return b\n    nextXY = [0, 0]\n    gcd = extendedGCD(b % a, a, nextXY)\n    xy[0] = nextXY[1] - (b // a) * nextXY[0]\n    xy[1] = nextXY[0]\n    return gcd\n\ndef modInverse(a, m):\n    xy = [0, 0]\n    gcd = extendedGCD(a, m, xy)\n    if gcd != 1:\n        return -1\n    inv = (xy[0] % m + m) % m\n    return inv\n\ndef solve():\n    precompute()\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx])\n    idx += 1\n    k = int(input_data[idx])\n    if k == 0:\n        print(factorial[n])\n        return\n    if n <= k:\n        print(0)\n        return\n    comb = nCr(n, int(k))\n    cols = n - int(k)\n    total_sum = 0\n    for i in range(cols + 1):\n        term = nCr(cols, i)\n        term = (term * modPow(cols - i, n)) % MOD\n        if (i & 1) == 1:\n            total_sum = (total_sum - term + MOD) % MOD\n        else:\n            total_sum = (total_sum + term) % MOD\n    ans = (comb * total_sum) % MOD\n    ans = (2 * ans) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.83174327807501e-05, -7.152555099310121e-07, -3.576278118089249e-07, -0.06461780518293381, -0.008097557350993156, -0.06198330223560333, -0.005368578247725964, -1.1920928244535389e-07, -5.96