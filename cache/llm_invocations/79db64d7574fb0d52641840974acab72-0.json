idx2 = len(adj[v])\n        \n        adj[u].append(idx2)\n        adj[v].append(idx1)\n        \n        edge_idx1 = idx1 * 2\n        edge_idx2 = idx1 * 2 + 1\n        \n        capacity[edge_idx1] = cap\n        cost[edge_idx1] = c\n        to_node[edge_idx1] = v\n        \n        capacity[edge_idx2] = 0\n        cost[edge_idx2] = -c\n        to_node[edge_idx2] = u\n    \n    # Connect each node at level 100 to sink with capacity 100 and cost 0\n    for i in range(1, 101):\n        node = i\n        to_sink = sink\n        add_edge(node, to_sink, 100, 0)\n    \n    # Add edges from source to starting nodes\n    for _ in range(k):\n        v = int(data[idx]); idx += 1\n        add_edge(source, (v - 1) * 100 + 1, 1, 0)\n    \n    # Add internal edges within each node: level j to j+1\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            from_node = (i - 1) * 100 + j\n            to_node_edge = (i - 1) * 100 + j + 1\n            add_edge(from_node, to_node_edge, 100, c_val)\n    \n    # Add bidirectional edges between connected nodes\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        \n        for j in range(1, 100):\n            idx1 = (u - 1) * 100 + j\n            idx2 = (v - 1) * 100 + j + 1\n            \n            for step in range(1, 51):\n                edge_cost = c_val + (step * step - (step - 1) * (step - 1)) * d_val\n                add_edge(idx1, idx2, 1, edge_cost)\n        \n        for j in range(1, 100):\n            idx1 = (v - 1) * 100 + j\n            idx2 = (u - 1) * 100 + j + 1\n            \n            for step in range(1, 51):\n                edge_cost = c_val + (step * step - (step - 1) * (step - 1)) * d_val\n                add_edge(idx1, idx2, 1, edge_cost)\n    \n    # SPFA and min_cost_max_flow implementation\n    def spfa(s, t):\n        dist = [INF] * MAX_NODES\n        visited = [0] * MAX_NODES\n        parent = [-1] * MAX_NODES\n        edge_id = [-1] * MAX_NODES\n        \n        q = deque()\n        dist[s] = 0\n        q.append(s)\n        visited[s] = 1\n        \n        while q:\n            u = q.popleft()\n            visited[u] = 0\n            \n            for idx in adj[u]:\n                if capacity[idx] > 0 and dist[to_node[idx]] > dist[u] + cost[idx]:\n                    dist[to_node[idx]] = dist[u] + cost[idx]\n                    parent[to_node[idx]] = u\n                    edge_id[to_node[idx]] = idx\n                    if not visited[to_node[idx]]:\n                        visited[to_node[idx]] = 1\n                        q.append(to_node[idx])\n        \n        return dist[t] < INF\n    \n    def min_cost_max_flow(s, t):\n        total_flow = 0\n        total_cost = 0\n        \n        while spfa(s, t):\n            flow = INF\n            v = t\n            while v != s:\n                flow = min(flow, capacity[edge_id[v]])\n                v = parent[v]\n            \n            v = t\n            while v != s:\n                eid = edge_id[v]\n                capacity[eid] -= flow\n                capacity[eid ^ 1] += flow\n                v = parent[v]\n            \n            total_flow += flow\n            total_cost += dist[t] * flow\n        \n        return total_cost\n    \n    print(min_cost_max_flow(source, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001308832288486883, -1.311301275563892e-06, -1.1920928244535389e-07, -0.002561028813943267, -0.0035118116065859795, -2.3841855067985307e-07, -0.0004353767435532063, -0.00024589852546341717, -2.3841830625315197e-06, -0.0009158230968751013, -7.10462118149735e-05, -0.11682593822479248, -7.152555099310121e-07, -0.0076326169073581696, -0.0036007824819535017, -5.960462772236497e-07, 0.0, -2.622600959512056e-06, 0.0, -1.4781842764932662e-05, -4.887569048150908e-06, -1.1920928244535389e-07, -1.311301275563892e-06, -1.4305104514278355e-06, -