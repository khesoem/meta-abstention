push(s);\n        while(!Q.empty() ) {\n            int u = Q.front(); Q.pop();\n            inq[u] = 0;\n\n            for( int i = 0 ; i < G[u].size() ; i ++ ) {\n                Edge &e = E[G[u][i]];\n                if( e.cap > e.flow && d[e.v] > d[u] + e.cost ) {\n                    d[e.v] = d[u] + e.cost;\n                    p[e.v] = G[u][i];\n                    a[e.v] = min( a[u] , e.cap - e.flow );\n\n                    if( inq[e.v ] == 0 ) {\n                        Q.push(e.v);\n                        inq[e.v] = 1;\n                    }\n                }\n            }\n        }\n\n        if( d[t] == INF ) return false;     // No augmenting Path\n        flow = a[t];\n        cost = d[t] ;               // Unit cost\n        int u = t ;\n        while( u  != s ) {\n            E[p[u]].flow += a[t];\n            E[p[u]^1].flow -= a[t];\n            u = E[p[u]].u;\n        }\n        return true;\n    }\n\n    pair<T,T> Mincost (int s, int t) {\n        this->s=s,this->t=t;\n        T Mcost = 0;\n        T Flow = 0;\n        T f = 0 ;    // For Each CaT , The flow\n        T d = 0;      // Shortest Distance / Cost Per Flow\n\n        while(BelmanFord(f,d)) {\n            Flow += f;\n            Mcost += f *d ;\n        }\n        return make_pair(Flow, Mcost);\n    }\n};\n\nint main() {\n    int n, m, k, C, D;\n    cin>>n>>m>>k>>C>>D;\n\n    MCMF solver(n*K+2);\n    int source = n*K, sink = n*K+1;\n\n    for (int i=0; i<K; i++)\n        solver.addEdge(i, sink, k, C*i);\n\n\n    for (int i=0; i<k; i++) {\n        int x;\n        cin>>x;\n        x--;\n        solver.addEdge(source, x*K, 1, 0);\n    }\n\n    for (int i=0; i<n; i++)\n        for (int j=1; j<K; j++)\n            solver.addEdge(i*K+j-1, i*K+j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin>>u>>v;\n        u--; v--;\n\n        for (int j=1; j<K; j++) {\n            int a = u*K+j-1, b = v*K+j;\n            int c = v*K+j-1, d = u*K+j;\n\n            for (int i=1, cc = D; i<=k; i++, cc += 2*D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n    auto pr = solver.Mincost(source, sink);\n    cout<<pr.second<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1000000007\nK = 100\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.G = [[] for _ in range(n)]\n        self.E = []          # list of edges [u, v, cap, flow, cost]\n\n    def add_edge(self, u, v, cap, cost):\n        self.E.append([u, v, cap, 0, cost])\n        self.E.append([v, u, 0, 0, -cost])\n        m = len(self.E)\n        self.G[u].append(m - 2)\n        self.G[v].append(m - 1)\n\n    def _bellman_ford(self):\n        d = [INF] * self.n\n        inq = [0] * self.n\n        p = [0] * self.n\n        a = [0] * self.n\n        d[self.s] = 0\n        inq[self.s] = 1\n        p[self.s] = 0\n        a[self.s] = INF\n\n        Q = deque()\n        Q.append(self.s)\n        while Q:\n            u = Q.popleft()\n            inq[u] = 0\n            for idx in self.G[u]:\n                e = self.E[idx]\n                if e[2] > e[3] and d[e[1]] > d[u] + e[4]:\n                    d[e[1]] = d[u] + e[4]\n                    p[e[1]] = idx\n                    a[e[1]] = min(a[u], e[2] - e[3])\n                    if not inq[e[1]]:\n                        Q.append(e[1])\n                        inq[e[1]] = 1\n\n        if d[self.t] == INF:\n            return False, 0, 0\n        flow = a[self.t]\n        cost = d[self.t]\n        u = self.t\n        while u != self.s:\n            e_idx = p[u]\n            self.E[e_idx][3] += flow\n            self.E[e_idx ^ 1][3] -= flow\n            u = self.E[e_idx][0]\n        return True, flow, cost\n\n    def mincost(self, s, t):\n        self.s = s\n        self.t = t\n        total_flow = 0\n        total_cost = 0\n        while True:\n            ok, f, c = self._bellman_ford()\n            if not ok:\n                break\n            total_flow += f\n            total_cost += f * c\n        return total_flow, total_cost\n\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    solver = MCMF(n * K + 2)\n    source = n * K\n    sink = n * K + 1\n\n    for i in range(K):\n        solver.add_edge(i, sink, k, C * i)\n\n    for i in range(k):\n        x = int(next(it)) - 1\n        solver.add_edge(source, x * K, 1, 0)\n\n    for i in range(n):\n        for j in range(1, K):\n            solver.add_edge(i * K + j - 1, i * K + j, k, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(1, K):\n            a = u * K + j - 1\n            b = v * K + j\n            c = v * K + j - 1\n            d = u * K + j\n            cc = D\n            for i in range(1, k + 1):\n                solver.add_edge(a, b, 1, cc)\n                solver.add_edge(c, d, 1, cc)\n                cc += 2 * D\n\n    flow, cost = solver.mincost(source, sink)\n    print(cost)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-9.393251093570143e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.000507464399561286, -0.00040618274942971766, -3.576278118089249e-07, -0.0031911423429846764, -0.0003861635341309011, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.00019059749320149422, -0.0019106481922790408, -2.3841855067985307e-07, -3.635817120084539e-05, -0.03007679618895054, -3.576278118089249e-07, -4.768370445162873e-07, -2.50339189733495e-06, -0.03571758791804314, -1.5735502529423684e-05, -8.785339014139026e-05, -1.0728830375228426e-06, -8.344646857949556e-07, -0.00936224590986967