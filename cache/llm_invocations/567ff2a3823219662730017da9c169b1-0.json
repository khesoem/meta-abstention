push(s);\n        while(!Q.empty() ) {\n            int u = Q.front(); Q.pop();\n            inq[u] = 0;\n\n            for( int i = 0 ; i < G[u].size() ; i ++ ) {\n                Edge &e = E[G[u][i]];\n                if( e.cap > e.flow && d[e.v] > d[u] + e.cost ) {\n                    d[e.v] = d[u] + e.cost;\n                    p[e.v] = G[u][i];\n                    a[e.v] = min( a[u] , e.cap - e.flow );\n\n                    if( inq[e.v ] == 0 ) {\n                        Q.push(e.v);\n                        inq[e.v] = 1;\n                    }\n                }\n            }\n        }\n\n        if( d[t] == INF ) return false;     // No augmenting Path\n        flow = a[t];\n        cost = d[t] ;               // Unit cost\n        int u = t ;\n        while( u  != s ) {\n            E[p[u]].flow += a[t];\n            E[p[u]^1].flow -= a[t];\n            u = E[p[u]].u;\n        }\n        return true;\n    }\n\n    pair<T,T> Mincost (int s, int t) {\n        this->s=s,this->t=t;\n        T Mcost = 0;\n        T Flow = 0;\n        T f = 0 ;    // For Each CaT , The flow\n        T d = 0;      // Shortest Distance / Cost Per Flow\n\n        while(BelmanFord(f,d)) {\n            Flow += f;\n            Mcost += f *d ;\n        }\n        return make_pair(Flow, Mcost);\n    }\n};\n\nint main() {\n    int n, m, k, C, D;\n    cin>>n>>m>>k>>C>>D;\n\n    MCMF solver(n*K+2);\n    int source = n*K, sink = n*K+1;\n\n    for (int i=0; i<K; i++)\n        solver.addEdge(i, sink, k, C*i);\n\n\n    for (int i=0; i<k; i++) {\n        int x;\n        cin>>x;\n        x--;\n        solver.addEdge(source, x*K, 1, 0);\n    }\n\n    for (int i=0; i<n; i++)\n        for (int j=1; j<K; j++)\n            solver.addEdge(i*K+j-1, i*K+j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin>>u>>v;\n        u--; v--;\n\n        for (int j=1; j<K; j++) {\n            int a = u*K+j-1, b = v*K+j;\n            int c = v*K+j-1, d = u*K+j;\n\n            for (int i=1, cc = D; i<=k; i++, cc += 2*D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n    auto pr = solver.Mincost(source, sink);\n    cout<<pr.second<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\n\nmaxn = 5005\nINF = 10**9 + 7\nK = 100\n\nclass Edge:\n    def __init__(self, u, v, cap, flow, cost):\n        self.u = u\n        self.v = v\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.G = [[] for _ in range(maxn)]\n        self.E = []\n    \n    def addEdge(self, u, v, cap, cost):\n        self.E.append(Edge(u, v, cap, 0, cost))\n        self.E.append(Edge(v, u, 0, 0, -cost))\n        m = len(self.E)\n        self.G[u].append(m - 2)\n        self.G[v].append(m - 1)\n    \n    def BellmanFord(self):\n        d = [INF] * self.n\n        inq = [False] * self.n\n        p = [0] * self.n\n        a = [0] * self.n\n        \n        d[self.s] = 0\n        inq[self.s] = True\n        p[self.s] = 0\n        a[self.s] = INF\n        \n        q = deque()\n        q.append(self.s)\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for idx in self.G[u]:\n                e = self.E[idx]\n                if e.cap > e.flow and d[e.v] > d[u] + e.cost:\n                    d[e.v] = d[u] + e.cost\n                    p[e.v] = idx\n                    a[e.v] = min(a[u], e.cap - e.flow)\n                    if not inq[e.v]:\n                        q.append(e.v)\n                        inq[e.v] = True\n        \n        if d[self.t] == INF:\n            return False\n        self.flow = a[self.t]\n        self.cost = d[self.t]\n        u = self.t\n        while u != self.s:\n            e = self.E[p[u]]\n            e.flow += a[self.t]\n            self.E[p[u] ^ 1].flow -= a[self.t]\n            u = e.u\n        return True\n    \n    def Mincost(self, s, t):\n        self.s = s\n        self.t = t\n        total_cost = 0\n        total_flow = 0\n        while self.BellmanFord():\n            total_flow += self.flow\n            total_cost += self.flow * self.cost\n        return (total_flow, total_cost)\n\ndef main():\n    import sys\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    \n    solver = MCMF(n * K + 2)\n    source = n * K\n    sink = n * K + 1\n    \n    for i in range(K):\n        solver.addEdge(i, sink, k, C * i)\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        solver.addEdge(source, x * K, 1, 0)\n    \n    for i in range(n):\n        for j in range(1, K):\n            solver.addEdge(i * K + j - 1, i * K + j, k, 0)\n    \n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(1, K):\n            a = u * K + j - 1\n            b = v * K + j\n            c = v * K + j - 1\n            d = u * K + j\n            cc = D\n            for i in range(1, k + 1):\n                solver.addEdge(a, b, 1, cc)\n                solver.addEdge(c, d, 1, cc)\n                cc += 2 * D\n    \n    pr = solver.Mincost(source, sink)\n    print(pr[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.2291888e-05, 0.0, -4.7683704e-07, -0.0013503252, -1.3378468, -0.014896115, -5.960463e-07, -0.0015044811, -1.504992, -1.7987075, -0.00013100242, -4.1723165e-06, -6.5564896e-06, -0.00038973842, -4.9232225e-05, -0.00013684291, -0.0102798045, -2.396078e-05, -0.0053445078, -0.0046355403, -0.005268855, -6.7949063e-06, -0.029752268, -8.344647e-07, -2.9802277e-06, -0.000176