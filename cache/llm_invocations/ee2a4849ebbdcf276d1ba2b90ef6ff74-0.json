1000000000\n\n    # BFS1: compute bum (time bomb reaches each cell)\n    bum = [[t]*Maxn for _ in range(Maxn)]\n    bum[br][bc] = 0\n    q = deque()\n    q.append((br, bc))\n    while q:\n        vx, vy = q.popleft()\n        d = bum[vx][vy]\n        for k in range(Maxd):\n            ux = vx + dy[k]\n            uy = vy + dx[k]\n            if 0 <= ux < n and 0 <= uy < n and a[ux][uy] != 'Y' and d + 1 < bum[ux][uy]:\n                bum[ux][uy] = d + 1\n                q.append((ux, uy))\n\n    # BFS2: from a start cell, compute dist and pos\n    def BFS2(sr, sc):\n        dist = [[Inf]*Maxn for _ in range(Maxn)]\n        pos = [[False]*Maxn for _ in range(Maxn)]\n        dist[sr][sc] = 0\n        pos[sr][sc] = True\n        q = deque()\n        q.append((sr, sc))\n        while q:\n            vx, vy = q.popleft()\n            d = dist[vx][vy]\n            pos[vx][vy] = (d <= bum[vx][vy])\n            if d >= bum[vx][vy]:\n                continue\n            for k in range(Maxd):\n                ux = vx + dy[k]\n                uy = vy + dx[k]\n                if 0 <= ux < n and 0 <= uy < n and a[ux][uy] != 'Y' and d + 1 < dist[ux][uy]:\n                    dist[ux][uy] = d + 1\n                    q.append((ux, uy))\n        return pos\n\n    # Build flow network\n    N = 2 * n * n + 2\n    R = [[0]*N for _ in range(N)]\n    neigh = [[] for _ in range(N)]\n\n    # Source to a-digit nodes\n    for i in range(n):\n        for j in range(n):\n            if a[i][j].isdigit() and a[i][j] > '0':\n                v = i * n + j + 1\n                cap = int(a[i][j])\n                R[0][v] = cap\n                neigh[0].append(v)\n                neigh[v].append(0)\n                pos = BFS2(i, j)\n                for i2 in range(n):\n                    for j2 in range(n):\n                        if pos[i2][j2] and b[i2][j2].isdigit() and b[i2][j2] > '0':\n                            u = n * n + i2 * n + j2 + 1\n                            R[v][u] = Inf\n                            neigh[v].append(u)\n                            neigh[u].append(v)\n\n    # b-digit nodes to sink\n    for i in range(n):\n        for j in range(n):\n            if b[i][j].isdigit() and b[i][j] > '0':\n                u = n * n + i * n + j + 1\n                cap = int(b[i][j])\n                R[u][N-1] = cap\n                neigh[u].append(N-1)\n                neigh[N-1].append(u)\n\n    # Max flow using maximum capacity path (Dijkstra-like)\n    def getFlow():\n        F = [0]*N\n        P = [0]*N\n        F[0] = Inf\n        heap = [(-Inf, 0)]  # (negative flow, node)\n        while heap:\n            negf, v = heapq.heappop(heap)\n            f = -negf\n            if F[v] != f:\n                continue\n            for u in neigh[v]:\n                if min(f, R[v][u]) > F[u]:\n                    F[u] = min(f, R[v][u])\n                    P[u] = v\n                    heapq.heappush(heap, (-F[u], u))\n        v = N - 1\n        if F[v] == 0:\n            return 0\n        flow = F[v]\n        while v:\n            u = P[v]\n            R[u][v] -= flow\n            R[v][u] += flow\n            v = u\n        return flow\n\n    res = 0\n    while True:\n        f = getFlow()\n        if f == 0:\n            break\n        res += f\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.3112935448589269e-05, 0.0, 0.0, -0.00016890530241653323, -0.0005735897575505078, -6.198863957251888e-06, -0.0001250427303602919, -0.4740780293941498, -0.00020621081057470292, 0.0, -5.960462772236497e-07, -2.6464111215318553e-05, -0.00026174934464506805, -0.0004670721245929599, -0.0007134514744393528, -1.1467090845108032, -0.6389338374137878, -0.2519688904285431, -1.311301275563892e-06, -0.07876238971948624, -7.152555099310121e-07, -5.98412734689191e-05, -2.3841855067985307e-07, -8.22540732769994e-06, -9.536738616588991e-07, -0.029754582792520523, -5.447716102935374e-05