{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\n#define maxn 5000010\n#define inf 1000000000\nusing namespace std;\n\nint n, m, k, v1, v2, s, t;\nint dis[maxn];\nbool vis[maxn];\nstruct edge {\n    int to, nxt, v, c;\n} e[maxn];\nint head[maxn], edge_cnt = 1;\n\nvoid add(int from, int to, int val, int cost) {\n    e[++edge_cnt] = {to, head[from], val, cost};\n    head[from] = edge_cnt;\n    e[++edge_cnt] = {from, head[to], 0, -cost};\n    head[to] = edge_cnt;\n}\n\nbool spfa() {\n    queue<int> q;\n    for (int i = s; i <= t; ++i) dis[i] = inf, vis[i] = false;\n    q.push(s); dis[s] = 0; vis[s] = true;\n    while (!q.empty()) {\n        int x = q.front(); q.pop(); vis[x] = false;\n        for (int i = head[x]; i; i = e[i].nxt) {\n            int y = e[i].to, c = e[i].c;\n            if (dis[y] <= dis[x] + c || !e[i].v) continue;\n            dis[y] = dis[x] + c;\n            if (!vis[y]) { vis[y] = true; q.push(y); }\n        }\n    }\n    return dis[t] != inf;\n}\n\nint dfs(int x, int lim) {\n    if (x == t) return lim;\n    vis[x] = true;\n    int flow, res = lim;\n    for (int i = head[x]; i; i = e[i].nxt) {\n        int y = e[i].to, v = e[i].v;\n        if (dis[y] != dis[x] + e[i].c || !v || vis[y]) continue;\n        flow = dfs(y, min(res, v));\n        if (flow) {\n            res -= flow;\n            e[i].v -= flow;\n            e[i ^ 1].v += flow;\n            if (!res) break;\n        }\n    }\n    return lim - res;\n}\n\nint dinic() {\n    int flow, sum = 0;\n    while (spfa())\n        while (flow = dfs(s, inf))\n            sum += flow * dis[t];\n    return sum;\n}\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(0);\n    auto read = [](int &x) {\n        x = 0; char c = cin.get(); bool flag = false;\n        while (!isdigit(c)) { if (c == '-') flag = true; c = cin.get(); }\n        while (isdigit(c)) { x = (x << 1) + (x << 3) + (c ^ 48); c = cin.get(); }\n        if (flag) x = -x;\n    };\n    read(n); read(m); read(k); read(v1); read(v2);\n    t = n * 110 + 1;\n    for (int i = 2; i <= 110; ++i) add(1 + (i - 1) * n, t, inf, 0);\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 110; ++j)\n            add(i + (j - 1) * n, i + j * n, inf, v1);\n    for (int i = 1, x; i <= k; ++i) { read(x); add(s, x, 1, 0); }\n    for (int i = 1; i <= m; ++i) {\n        int x, y; read(x); read(y);\n        for (int j = 1; j < 110; ++j)\n            for (int l = 1; l <= k; ++l) {\n                add(x + (j - 1) * n, y + j * n, 1, v2 * (2 * l - 1) + v1);\n                add(y + (j - 1) * n, x + j * n, 1, v2 * (2 * l - 1) + v1);\n            }\n    }\n    cout << dinic();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_edge(graph, fr, to, cap, cost):\n    graph[fr].append(Edge(to, len(graph[to]), cap, cost))\n    graph[to].append(Edge(fr, len(graph[fr]) - 1, 0, -cost))\n\ndef min_cost_flow(graph, s, t, maxf=INF):\n    n = len(graph)\n    dist = [0] * n\n    inqueue = [False] * n\n    prevv = [0] * n\n    preve = [0] * n\n    flow = 0\n    cost = 0\n    while flow < maxf:\n        # SPFA\n        for i in range(n):\n            dist[i] = INF\n            inqueue[i] = False\n        dist[s] = 0\n        q = deque([s])\n        inqueue[s] = True\n        while q:\n            v = q.popleft()\n            inqueue[v] = False\n            for i, e in enumerate(graph[v]):\n                if e.cap > 0 and dist[e.to] > dist[v] + e.cost:\n                    dist[e.to] = dist[v] + e.cost\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    if not inqueue[e.to]:\n                        inqueue[e.to] = True\n                        q.append(e.to)\n        if dist[t] == INF:\n            break\n        # DFS (augment)\n        d = maxf - flow\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            d = min(d, e.cap)\n            v = prevv[v]\n        flow += d\n        cost += d * dist[t]\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            e.cap -= d\n            graph[v][e.rev].cap += d\n            v = prevv[v]\n    return cost\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    v1 = next(it)\n    v2 = next(it)\n    s = 0\n    t = n * 110 + 1\n    N = t + 1\n    graph = [[] for _ in range(N)]\n    # edges from layer 1..110 to sink for node 1\n    for i in range(2, 111):\n        add_edge(graph, 1 + (i - 1) * n, t, INF, 0)\n    # vertical edges for nodes 2..n\n    for i in range(2, n + 1):\n        for j in range(1, 110):\n            add_edge(graph, i + (j - 1) * n, i + j * n, INF