p[edge_cnt] = val;\n        cost[edge_cnt] = cst;\n        head[from] = edge_cnt;\n\n        edge_cnt++;\n        to[edge_cnt] = from;\n        nxt[edge_cnt] = head[to];\n        cap[edge_cnt] = 0;\n        cost[edge_cnt] = -cst;\n        head[to] = edge_cnt;\n    }\n\n    static boolean spfa() {\n        Queue<Integer> q = new LinkedList<>();\n        for (int i = s; i <= t; ++i) {\n            dis[i] = INF;\n            vis[i] = false;\n        }\n        q.offer(s);\n        dis[s] = 0;\n        vis[s] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            vis[x] = false;\n            for (int i = head[x]; i != 0; i = nxt[i]) {\n                int y = to[i];\n                int c = cost[i];\n                if (dis[y] <= dis[x] + c || cap[i] == 0) continue;\n                dis[y] = dis[x] + c;\n                if (!vis[y]) {\n                    vis[y] = true;\n                    q.offer(y);\n                }\n            }\n        }\n        return dis[t] != INF;\n    }\n\n    static int dfs(int x, int lim) {\n        if (x == t) return lim;\n        vis[x] = true;\n        int flow, res = lim;\n        for (int i = head[x]; i != 0; i = nxt[i]) {\n            int y = to[i];\n            int v = cap[i];\n            if (dis[y] != dis[x] + cost[i] || v == 0 || vis[y]) continue;\n            flow = dfs(y, Math.min(res, v));\n            if (flow > 0) {\n                res -= flow;\n                cap[i] -= flow;\n                cap[i ^ 1] += flow;\n                if (res == 0) break;\n            }\n        }\n        return lim - res;\n    }\n\n    static int dinic() {\n        int flow, sum = 0;\n        while (spfa()) {\n            while ((flow = dfs(s, INF)) != 0) {\n                sum += flow * dis[t];\n            }\n        }\n        return sum;\n    }\n\n    static class FastReader {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public FastReader() {\n            br = new BufferedReader(new Inp