uct"}, "response": {"samples": [{"content": "<original_code>\nimport java.util.* ;\n\npublic class Solution{\n    \n    public static void main(String[] args){\n        \n        Scanner in = new Scanner(System.in) ;\n        int n = in.nextInt() ;\n        int B = in.nextInt() ;\n        int[] a = new int[n] ;\n        \n        for(int i=0;i<n;i++){\n            a[i] = in.nextInt() ;\n        }\n        \n        int c0 =0,c1 = 0;\n        PriorityQueue<Integer> q = new PriorityQueue<Integer>() ;\n        \n        for(int i=0;i<n;i++){\n            if(a[i] % 2 == 0){\n                c0 ++ ;\n            }else{\n                c1 ++ ;\n            }\n            \n            if(c0 == c1 && i < n-1){\n                q.add( Math.abs(a[i+1] - a[i]) ) ;\n            }\n            \n        }\n        \n         int cnt =0,sum = 0;\n            \n            while(!q.isEmpty() && sum + q.peek() <=  B){\n                sum += q.poll() ;\n                cnt++;\n            }\n            \n            System.out.println(cnt) ;\n    }\n    \n}\n</original_code>\n\n<translated_code>\n#include <iostream>\n#include <queue>\n#include <vector>\n\nusing namespace std;\n\nint main() {\n    int n, B;\n    cin >> n >> B;\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n    }\n\n    int c0 = 0, c1 = 0;\n    priority_queue<int> q;\n\n    for (int i = 0; i < n; i++) {\n        if (a[i] % 2 == 0) {\n            c0++;\n        } else {\n            c1++;\n        }\n\n        if (c0 == c1 && i < n - 1) {\n            q.push(abs(a[i + 1] - a[i]));\n        }\n    }\n\n    int cnt = 0, sum = 0;\n    while (!q.empty() && sum + q.top() <= B) {\n        sum += q.top();\n        q.pop();\n        cnt++;\n    }\n\n    cout << cnt << endl;\n    return 0;\n}\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.35201895236968994, -8.476139919366688e-05, -0.18422138690948486, -0.11076962947845459, -0.002328302711248398, -0.0006955