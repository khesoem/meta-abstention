class Main {\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int t, int c, int co, int r) {\n            to = t; to = t; cap = c; cost = co; rev = r;\n    }\n    static class MCMF {\n        int V;\n        ArrayList<Edge>[] g;\n        long[] h, dist;\n        int[] prev, pree;\n        void init(int n) {\n            V = n;\n            g = new ArrayList[n+1];\n            for (int i=0;i<=n;i++) g[i] = new ArrayList<>();\n        }\n        void add_edge(int u, int v, int cap, int cost) {\n            g[u].add(new Edge(v, cap, cost, g[v].size()));\n            g[v].add(new Edge(u, 0, -cost, g[u].size()-1));\n        }\n        long min_cost(int s, int t, int f) {\n            long flow = 0, res = 0;\n            h = new long[V+1];\n            dist = new long[V+1];\n            prev = new int[V+1];\n            pree = new int[V+1];\n            while (f > 0) {\n                Arrays.fill(dist, Long.MAX_VALUE);\n                PriorityQueue<Node> pq = new PriorityQueue<>();\n                dist[s] = 0;\n                pq.add(new Node(0, s));\n                while (!pq.isEmpty()) {\n                    Node cur = pq.poll();\n                    int d = cur.dist;\n                    int v = cur.v;\n                    if (dist[v] < d) continue;\n                    for (int i=0;i<g[v].size();i++) {\n                        Edge e = g[v].get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                            prev[e.to] = v;\n                            pree[e.to] = i;\n                            pq.add(new Node(dist[e.to], e.to));\n                        }\n                    }\n                }\n                if (dist[t] == Long.MAX_VALUE) break;\n                for (int i=0;i<=V;i++) h[i] += dist[i];\n                int d = f;\n                for (int v=t;v!=s;v=prev[v]) d = Math.min(d, g[prev[v]