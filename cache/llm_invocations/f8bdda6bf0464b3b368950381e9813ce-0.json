      self.bfs.append(0)\n        idx = 0\n        while idx < len(self.bfs):\n            x = self.bfs[idx]\n            idx += 1\n            self.used[x] = 0\n            for r in self.e[x]:\n                y, c, v, ty = self.es[r]\n                if c > 0 and self.mi[x] + v < self.mi[y]:\n                    self.mi[y] = self.mi[x] + v\n                    self.lt[y] = r\n                    if not self.used[y]:\n                        self.used[y] = 1\n                        self.bfs.append(y)\n        if self.mi[EE] == INF:\n            return -1\n        now = EE\n        while now:\n            r = self.lt[now]\n            if self.es[r][3] == 1:\n                self.es[r][2] += 2 * self.d\n                self.es[r ^ 1][2] -= 2 * self.d\n            self.es[r][1] -= 1\n            self.es[r ^ 1][1] += 1\n            now = self.es[r ^ 1][0]\n        return self.mi[EE]\n\n    def solve(self, nn):\n        v = 0\n        for _ in range(nn):\n            v += self.flow()\n        return v\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    C = next(it)\n    d = next(it)\n    mcf = MinCostFlow(n * 100 + 1, C, d)\n    for _ in range(k):\n        x = next(it)\n        mcf.add_edge(0, x, 1, 0, 0)\n    for i in range(1, 100):  # i from 1 to 99 inclusive\n        mcf.add_edge(1 + i * n, 100 * n + 1, INF, 0, 0)\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            mcf.add_edge(i + (j - 1) * n, i + j * n, INF, C, 0)\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for j in range(1, 100):\n            mcf.add_edge(x + (j - 1) * n, y + j * n, INF, C + d, 1)\n            mcf.add_edge(y + (j - 1) * n, x + j * n, INF, C + d, 1)\n    print(mcf.solve(k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0003389737685211003, 0.0, -2.3841855067985307