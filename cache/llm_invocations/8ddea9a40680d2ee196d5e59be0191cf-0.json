{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1e9;\nconst int T = 150;\n\nstruct Edge {\n    int to, rev, cap, flow, cost;\n};\n\nclass MinCostMaxFlow {\n    int n;\n    vector<vector<Edge>> g;\n\npublic:\n    MinCostMaxFlow(int n_) : n(n_), g(n_) {}\n\n    void add_edge(int s, int t, int cap, int cost) {\n        Edge a{t, (int)g[t].size(), cap, 0, cost};\n        Edge b{s, (int)g[s].size(), 0, 0, -cost};\n        g[s].push_back(a);\n        g[t].push_back(b);\n    }\n\n    pair<int, int> get_flow(int s, int t) {\n        int flow = 0, flow_cost = 0;\n\n        while (true) {\n            vector<int> dist(n, INF), pv(n, -1), pe(n, -1);\n            vector<char> inq(n, 0);\n            deque<int> dq;\n\n            dist[s] = 0;\n            dq.push_back(s);\n            inq[s] = 1;\n\n            while (!dq.empty()) {\n                int v = dq.front();\n                dq.pop_front();\n                inq[v] = 0;\n\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap - e.flow <= 0) continue;\n\n                    if (dist[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        pv[e.to] = v;\n                        pe[e.to] = i;\n\n                        if (!inq[e.to]) {\n                            if (!dq.empty() && dist[e.to] < dist[dq.front()]) {\n                                dq.push_front(e.to);\n                            } else {\n                                dq.push_back(e.to);\n                            }\n                            inq[e.to] = 1;\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            int add = INF - flow;\n            for (int v = t; v != s; v = pv[v]) {\n                Edge &e = g[pv[v]][pe[v]];\n                add = min(add, e.cap - e.flow);\n            }\n\n            flow += add;\n            for (int v = t; v != s; v = pv[v]) {\n                Edge &e = g[pv[v]][pe[v]];\n                e.flow += add;\n                g[v][e.rev].flow -= add;\n                flow_cost += add * e.cost;\n            }\n        }\n\n        return {flow, flow_cost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MinCostMaxFlow mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    pair<int, int> ans = mcf.get_flow(N, N + 1);\n    assert(ans.first == k);\n    cout << ans.second << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1_000_000_000;\n    static final int T = 150;\n\n    static class Edge {\n        int to, rev, cap, flow, cost;\n        Edge(int to, int rev, int cap, int flow, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int n;\n        ArrayList<ArrayList<Edge>> g;\n\n        MinCostMaxFlow(int n_) {\n            n = n_;\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                g.add(new ArrayList<>());\n            }\n        }\n\n        void addEdge(int s, int t, int cap, int cost) {\n            Edge a = new Edge(t, g.get(t).size(), cap, 0, cost);\n            Edge b = new Edge(s, g.get(s).size(), 0, 0, -cost);\n            g.get(s).add(a);\n            g.get(t).add(b);\n        }\n\n        int[] getFlow(int s, int t) {\n            int flow = 0, flowCost = 0;\n\n            while (true) {\n                int[] dist = new int[n];\n                Arrays.fill(dist, INF);\n                int[] pv = new int[n];\n                Arrays.fill(pv, -1);\n                int[] pe = new int[n];\n                Arrays.fill(pe, -1);\n                boolean[] inq = new boolean[n];\n                Deque<Integer> dq = new ArrayDeque<>();\n\n                dist[s] = 0;\n                dq.addLast(s);\n                inq[s] = true;\n\n                while (!dq.isEmpty()) {\n                    int v = dq.pollFirst();\n                    inq[v] = false;\n\n                    for (int i = 0; i < g.get(v).size(); i++) {\n                        Edge e = g.get(v).get(i);\n                        if (e.cap - e.flow <= 0) continue;\n\n                        if (dist[e.to] > dist[v] + e.cost) {\n                            dist[e.to] = dist[v] + e.cost;\n                            pv[e.to] = v;\n                            pe[e.to] = i;\n\n                            if (!inq[e.to]) {\n                                if (!dq.isEmpty() && dist[e.to] < dist[dq.peekFirst()]) {\n                                    dq.addFirst(e.to);\n                                } else {\n                                    dq.addLast(e.to);\n                                }\n                                inq[e.to] = true;\n                            }\n                        }\n                    }\n                }\n\n                if (dist[t] == INF) break;\n\n                int add = INF - flow;\n                for (int v = t; v != s; v = pv[v]) {\n                    Edge e = g.get(pv[v]).get(pe[v]);\n                    add = Math.min(add, e.cap - e.flow);\n                }\n\n                flow += add;\n                for (int v = t; v != s; v = pv[v]) {\n                    Edge e = g.get(pv[v]).get(pe[v]);\n                    e.flow += add;\n                    g.get(v).get(e.rev).flow -= add;\n                    flowCost += add * e.cost;\n                }\n            }\n\n            return new int[]{flow, flowCost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int N = n * T;\n        MinCostMaxFlow mcf = new MinCostMaxFlow(N + 2);\n\n        // edges for staying in same building\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        // sink edges (only from first T nodes, i.e., building 0's time steps)\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i, N + 1, INF, 0);\n        }\n\n        // source to initial positions\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            mcf.addEdge(N, x * T, 1, 0);\n        }\n\n        // roads\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int j = 0; j < T - 1; j++) {\n                int cur = 1;\n                for (int z = 0; z < k; z++) {\n                    mcf.addEdge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                    mcf.addEdge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        int[] ans = mcf.getFlow(N, N + 1);\n        assert ans[0] == k : \"Flow must equal number of people\";\n        System.out.println(ans[1]);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.318072337307967e-06, 0.0, 0.0, -5.340433563105762e-05, -0.0003471963864285499, 0.0, -0.008614521473646164, -0.009289376437664032, -0.014195065014064312, -1.1920928244535389e-07, -0.12785035371780396, -0.0485939159989357, -0.0009130837861448526, -0.011266068555414677, -0.001933373394422233, -3.540453326422721e-05, 0.0, -3.576278118089249e-07, -0.20846255123615265, -0.25197815895080566, -1.7881377516459906e-06, -1.0728830375228426e-06, 0.0, -2.3841855067985307e-07, -7.152555099310121e-07, -3.6954811548639555e-06, -0.001986317802220583, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, 0.0, -1.549708758830093e-05, -1.6689286894688848e-06, 0.0, -1.311301275563892e-06, -0.0059578209184110165, -1.4305104514