s import deque\nimport heapq\n\nclass FlowGraph:\n    def __init__(self, n, source, sink):\n        self.n = n\n        self.source = source\n        self.sink = sink\n        self.adj = [[] for _ in range(n)]\n        self.edges = []\n\n    def add_edge(self, a, b, cap, cost):\n        id = len(self.edges)\n        self.adj[a].append(id)\n        self.edges.append([b, 0, cap, cost, cost])  # to, flow, cap, cost, orig\n        self.adj[b].append(id + 1)\n        self.edges.append([a, 0, 0, -cost, -cost])\n        return id\n\n    def bellman_ford(self):\n        INF = 10**9\n        dist = [INF] * self.n\n        dist[self.source] = 0\n\n        for rep in range(self.n):\n            changed = False\n            for id in range(len(self.edges)):\n                v = self.edges[id ^ 1][0]\n                u = self.edges[id][0]\n                if self.edges[id][1] < self.edges[id][2] and \\\n                   dist[v] != INF and dist[u] > dist[v] + self.edges[id][3]:\n                    dist[u] = dist[v] + self.edges[id][3]\n                    changed = True\n            if not changed:\n                break\n\n        for id in range(len(self.edges)):\n            v = self.edges[id ^ 1][0]\n            u = self.edges[id][0]\n            if dist[v] < INF and dist[u] < INF:\n                self.edges[id][3] += dist[v] - dist[u]\n\n    def dijkstra(self):\n        INF = 10**9\n        dist = [INF] * self.n\n        prev = [-1] * self.n\n        maxf = [0] * self.n\n\n        dist[self.source] = 0\n        prev[self.source] = -2\n        maxf[self.source] = INF\n        pq = [(0, self.source)]\n\n        while pq:\n            d, v = heapq.heappop(pq)\n            if d != dist[v]:\n                continue\n\n            for id in self.adj[v]:\n                e = self.edges[id]\n                if e[1] < e[2]:\n                    nd = d + e[3]\n                    if nd < dist[e[0]]:\n                        dist[e[0]] = nd\n                        prev[e[0]] = id