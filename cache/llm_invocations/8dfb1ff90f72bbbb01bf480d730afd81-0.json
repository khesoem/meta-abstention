Reader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    out.println(e);\n                }\n            }\n            return st.nextToken();\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n    }\n\n    public static void main(String[] args) {\n        FastScanner in = new FastScanner();\n        long n = in.nextLong();\n        long k = in.nextLong();\n        fact[0] = 1;\n        for (int i = 1; i <= n; i++) fact[i] = fact[i - 1] * i % MOD;\n        if (k >= n) out.println(0);\n        else if (k == 0) out.println(fact[(int) n]);\n        else {\n            long ans = 2 * C((int) n, (int) (n - k)) % MOD * solve((int) n, (int) k) % MOD;\n            out.println(ans);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef mod_pow(a, b):\n    return pow(a, b, MOD)\n\ndef comb(n, k, fact):\n    if k > n:\n        return 0\n    return fact[n] * mod_pow(fact[k], MOD - 2) % MOD * mod_pow(fact[n - k], MOD - 2) % MOD\n\ndef solve(n, k, fact):\n    m = n - k\n    ans = 0\n    for i in range(m + 1):\n        term = comb(m, i, fact) * mod_pow(m - i, n) % MOD\n        if i % 2 == 0:\n            ans = (ans + term) % MOD\n        else:\n            ans = (ans - term + MOD) % MOD\n    return ans\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i - 1] * i % MOD\n    if k >= n:\n        sys.stdout.write(\"0\\n\")\n    elif k == 0:\n        sys.stdout.write(str(fact[n]) + \