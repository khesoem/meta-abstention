in);\n        long n = sc.nextLong();\n        int base = sc.nextInt();\n        int sz = base + 1;\n        int[][][][] mat = new int[60][32][][];\n        for (int i = 0; i < 60; ++i)\n            for (int j = 0; j < 32; ++j)\n                mat[i][j] = new int[sz][sz];\n        \n        for (int i = 0; i < base; ++i)\n            for (int j = 0; j < sz; ++j)\n                for (int k = 0; k < sz; ++k)\n                    mat[0][i][j][k] = (i == j || j == k) ? 1 : 0;\n        \n        int ci = 0, cj = 0;\n        long step = 1;\n        while (step <= n / base) {\n            ++ci;\n            step *= base;\n        }\n        \n        for (int i = 1; i <= ci; ++i) {\n            for (int j = 0; j < base; ++j) {\n                for (int k = 0; k < sz; ++k)\n                    for (int l = 0; l < sz; ++l)\n                        mat[i][j][k][l] = (k == l) ? 1 : 0;\n                for (int k = 0; k < base; ++k) {\n                    int[][] tmp = new int[sz][sz];\n                    mmult(mat[i][j], mat[i-1][(j+k)%base], tmp, sz);\n                    mcopy(tmp, mat[i][j], sz);\n                }\n            }\n        }\n        \n        int[][] have = new int[sz][sz];\n        for (int k = 0; k < sz; ++k)\n            for (int l = 0; l < sz; ++l)\n                have[k][l] = (k == l) ? 1 : 0;\n        \n        for (; ci >= 0; --ci, step /= base) {\n            int times = (int)((n / step) % base);\n            for (int x = 0; x < times; ++x) {\n                int[][] tmp = new int[sz][sz];\n                mmult(have, mat[ci][cj], tmp, sz);\n                mcopy(tmp, have, sz);\n                if (++cj >= base) cj -= base;\n            }\n        }\n        \n        int ret = 0;\n        for (int k = 0; k < sz; ++k) {\n            ret += have[k][base];\n            if (ret >= MOD) ret -= MOD;\n        }\n        System.out.println(ret);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [0