b[i] / (1.0 - sm[mask]);\n        }\n    }\n\n    for (Mask mask = 0; mask < (1U << n); ++mask) {\n        if (__builtin_popcount(mask) != k) continue;\n        for (int i = 0; i < n; ++i) {\n            if (mask & (1U << i)) ans[i] += dp[mask];\n        }\n    }\n\n    for (int i = 0; i < total; ++i) {\n        if (id[i] == -1) printf(\"0 \");\n        else printf(\"%.10lf \", ans[id[i]]);\n    }\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 20;\n    static final double EPS = 1e-9;\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int total = sc.nextInt();\n        int k = sc.nextInt();\n\n        double[] inP = new double[MAXN];\n        double[] prob = new double[MAXN];\n        int[] id = new int[MAXN];\n        int n = 0;\n\n        for (int i = 0; i < total; ++i) {\n            inP[i] = sc.nextDouble();\n            if (inP[i] > EPS) {\n                prob[n] = inP[i];\n                id[i] = n++;\n            } else {\n                id[i] = -1;\n            }\n        }\n\n        k = Math.min(k, n);\n\n        double[] sm = new double[1 << n];\n        double[] dp = new double[1 << n];\n        double[] ans = new double[n];\n\n        sm[0] = 0.0;\n        dp[0] = 1.0;\n\n        for (int mask = 1; mask < (1 << n); ++mask) {\n            int low = mask & -mask;\n            sm[mask] = sm[mask ^ low] + prob[Integer.numberOfTrailingZeros(low)];\n        }\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            for (int i = 0; i < n; ++i) {\n                if ((mask & (1 << i)) != 0) continue;\n                dp[mask | (1 << i)] += dp[mask] * prob[i] / (1.0 - sm[mask]);\n            }\n        }\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (Integer.bit