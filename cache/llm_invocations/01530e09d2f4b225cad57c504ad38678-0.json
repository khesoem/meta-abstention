er() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        String nextLine() {\n            String str = \"\";\n            try {\n                str = br.readLine();\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n            return str;\n        }\n    }\n\n    static int[] li() {\n        String[] input = new FastReader().nextLine().split(\" \");\n        int[] arr = new int[input.length];\n        for (int i = 0; i < input.length; i++) {\n            arr[i] = Integer.parseInt(input[i]);\n        }\n        return arr;\n    }\n\n    static int val() {\n        return new FastReader().nextInt();\n    }\n\n    static String st() {\n        return new FastReader().nextLine();\n    }\n\n    static int[] li2() {\n        String input = new FastReader().nextLine();\n        int[] arr = new int[input.length()];\n        for (int i = 0; i < input.length(); i++) {\n            arr[i] = input.charAt(i) - '0';\n        }\n        return arr;\n    }\n\n    static int[] li3() {\n        String[] input = new FastReader().nextLine().split(\" \");\n        int[] arr = new int[input.length];\n        for (int i = 0; i < input.length; i++) {\n            arr[i] = Integer.parseInt(input[i]);\n        }\n        return arr;\n    }\n\n    static int match(int a, int b) {\n        if (a == b) return 0;\n        else if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n        else return -1;\n    }\n\n    static int give(int[] l1, int[] l2) {\n        int ans = 0;\n        int curr1 = 0, curr2 = 0;\n        while (l1.length > 0 || l2.length > 0) {\n            if (curr1 == 0) curr1 = l1[0];\n            if (curr2 == 0) curr2 = l2[0];\n            ans += Math.max(0, Math.min(curr1[0], curr2[0]) * match(curr1[1], curr2[1]));\n            if (curr1[0] < curr2[0]) {\n                curr2[0] -= curr1[0];\n                l1 = Arrays.copyOfRange(l1, 1, l1.length);\n                curr1 = 0;\n            } else if (curr1[0] > curr2[0]) {\n                curr1[0] -= curr2[0];\n                l2 = Arrays.copyOfRange(l2, 1, l2.length);\n                curr2 = 0;\n            } else {\n                l1 = Arrays.copyOfRange(l1, 1, l1.length);\n                l2 = Arrays.copyOfRange(l2, 1, l2.length);\n                curr1 = curr2 = 0;\n            }\n        }\n        return ans;\n    }\n\n    static int minimum() {\n        int ans = Integer.MAX_VALUE;\n        int[] l = new int[][]{{val(), 1}, {val(), 2}, {val(), 3}};\n        int[][] l1 = new int[l.length][];\n        for (int i = 0; i < l.length; i++) {\n            l1[i] = l[i];\n        }\n        int[] l2 = new int[][]{{val(), 1}, {val(), 2}, {val(), 3}};\n        int[][] l2s = new int[l2.length][];\n        for (int i = 0; i < l2.length; i++) {\n            l2s[i] = l2[i];\n        }\n        for (int[] i : l1) {\n            for (int[] j : l2s) {\n                int[] mylist1 = Arrays.copyOf(i, i.length);\n                int[] mylist2 = Arrays.copyOf(j, j.length);\n                ans = Math.min(ans, give(mylist1, mylist2));\n            }\n        }\n        return ans;\n    }\n\n    static int maximum() {\n        int ans = Math.min(val(), val()) + Math.min(val(), val()) + Math.min(val(), val());\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        System.