{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <climits>\n#include <algorithm>\nusing namespace std;\n\nstruct Edge {\n    int dest;\n    int capacity;\n    int flow;\n    int weight;\n    Edge() : dest(0), capacity(0), flow(0), weight(0) {}\n    Edge(int d, int c, int f, int w) : dest(d), capacity(c), flow(f), weight(w) {}\n};\n\nvector<Edge> edges;\nconst int MAX_SIZE = 14043;\nvector<int> graph[MAX_SIZE];\n\nlong long totalCost = 0;\nlong long dist[MAX_SIZE];\nint prevNode[MAX_SIZE];\nint prevEdgeIdx[MAX_SIZE];\nbool inQueue[MAX_SIZE];\n\nconst long long INF = 1000000000000000000LL;\n\nint source = MAX_SIZE - 2;\nint sink = MAX_SIZE - 1;\n\nint remainingCapacity(int idx) {\n    return edges[idx].capacity - edges[idx].flow;\n}\n\nvoid computeShortestPath() {\n    fill(dist, dist + MAX_SIZE, INF);\n    fill(prevNode, prevNode + MAX_SIZE, -1);\n    fill(prevEdgeIdx, prevEdgeIdx + MAX_SIZE, -1);\n    fill(inQueue, inQueue + MAX_SIZE, false);\n    \n    dist[source] = 0;\n    queue<int> q;\n    q.push(source);\n    inQueue[source] = true;\n    \n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inQueue[u] = false;\n        \n        for (int idx : graph[u]) {\n            if (remainingCapacity(idx) == 0) continue;\n            int v = edges[idx].dest;\n            int w = edges[idx].weight;\n            if (dist[v] > dist[u] + w) {\n                dist[v] = dist[u] + w;\n                prevNode[v] = u;\n                prevEdgeIdx[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    int cur = sink;\n    while (cur != source) {\n        int idx = prevEdgeIdx[cur];\n        edges[idx].flow++;\n        edges[idx ^ 1].flow--;\n        cur = prevNode[cur];\n    }\n    \n    if (dist[sink] < INF) {\n        totalCost += dist[sink];\n    }\n}\n\nvoid addConnection(int u, int v, int cap, int cost) {\n    graph[u].push_back(edges.size());\n    edges.emplace_back(v, cap, 0, cost);\n    graph[v].push_back(edges.size());\n    edges.emplace_back(u, 0, 0, -cost);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        x--;\n        addConnection(source, x, 1, 0);\n    }\n    \n    const int T = 101;\n    for (int t = 0; t < T; t++) {\n        addConnection(0 + t * n, sink, k, t * c);\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        u--; v--;\n        \n        for (int t = 0; t < T - 1; t++) {\n            for (int j = 0; j < k; j++) {\n                addConnection(u + t * n, v + t * n + n, 1, d * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < T - 1; t++) {\n            for (int j = 0; j < k; j++) {\n                addConnection(v + t * n, u + t * n + n, 1, d * (2 * j + 1));\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; i++) {\n        for (int t = 0; t < T - 1; t++) {\n            addConnection(i + t * n, i + t * n + n, k, 0);\n        }\n    }\n    \n    for (int i = 0; i < k; i++) {\n        computeShortestPath();\n    }\n    \n    cout << totalCost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    def __init__(self, dest, capacity, flow, weight):\n        self.dest = dest\n        self.capacity = capacity\n        self.flow = flow\n        self.weight = weight\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    edges = []\n    MAX_SIZE = 14043\n    graph = [[] for _ in range(MAX_SIZE)]\n    \n    source = MAX_SIZE - 2\n    sink = MAX_SIZE - 1\n    \n    def remaining_capacity(edge_idx):\n        return edges[edge_idx].capacity - edges[edge_idx].flow\n    \n    def add_connection(u, v, cap, cost):\n        graph[u].append(len(edges))\n        edges.append(Edge(v, cap, 0, cost))\n        graph[v].append(len(edges))\n        edges.append(Edge(u, 0, 0, -cost))\n    \n    totalCost = 0\n    dist = [float('inf')] * MAX_SIZE\n    prevNode = [-1] * MAX_SIZE\n    prevEdgeIdx = [-1] * MAX_SIZE\n    inQueue = [False] * MAX_SIZE\n    \n    def compute_shortest_path():\n        nonlocal totalCost\n        dist[:] = [float('inf')] * MAX_SIZE\n        prevNode[:] = [-1] * MAX_SIZE\n        prevEdgeIdx[:] = [-1] * MAX_SIZE\n        inQueue[:] = [False] * MAX_SIZE\n        \n        dist[source] = 0\n        q = deque()\n        q.append(source)\n        inQueue[source] = True\n        \n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            \n         