{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include <iostream>\n#include <queue>\n#include <map>\nusing namespace std;\ntypedef map<int,int> mi;\n\nmi edge[7000];\nchar buf[20][20];\nint n,m,vn,from[7000],flow[7000],tox[10][10];\n\ninline int enc(int x,int y,int t){\n  return x+y*n+t*n*n+2;\n}\n\nint max_flow(int s, int t) {\n    int total = 0;\n    const int INF = 1e9;\n    while (true) {\n        for (int i = vn; i--;) from[i] = -1;\n        from[s] = s;\n        flow[s] = INF;\n        queue<int> bfs;\n        bfs.push(s);\n        bool found = false;\n        while (!bfs.empty()) {\n            int x = bfs.front(); bfs.pop();\n            if (x == t) {\n                found = true;\n                int aug = flow[t];\n                for (int v = t; v != s; v = from[v]) {\n                    int u = from[v];\n                    edge[u][v] -= aug;\n                    edge[v][u] += aug;\n                }\n                total += aug;\n                break;\n            }\n            for (auto &e : edge[x]) {\n                if (e.second > 0 && from[e.first] == -1) {\n                    from[e.first] = x;\n                    flow[e.first] = min(e.second, flow[x]);\n                    bfs.push(e.first);\n                }\n            }\n        }\n        if (!found) break;\n    }\n    return total;\n}\n\nint main(){\n  ios::sync_with_stdio(0);\n  cin>>n>>m;\n\n  int res=0;\n  for (int i=0; i<n; i++)\n    for (int j=!(cin>>buf[i]); j<n; j++)\n      if (buf[i][j]>'0' and buf[i][j]<='9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  res = max_flow(0,1);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    \n    # First grid: digits (n lines)\n    buf1 = []\n    for _ in range(n):\n        buf1.append(next(it))\n    \n    # Second grid: with Z, Y, etc. (n lines)\n    buf2 = []\n    for _ in range(n):\n        buf2.append(next(it))\n    \n    # We'll work with buf2 for the rest, but we need digits from buf1 for initial edges\n    # Actually the first grid is used only for digits, so we keep buf1 for that.\n    \n    # Node encoding: enc(x,y,t) = x + y*n + t*n*n + 2\n    def enc(x, y, t):\n        return x + y * n + t * n * n + 2\n    \n    # Build adjacency list: list of dicts\n    max_nodes = enc(n-1, n-1, m) + 1\n    edge = [dict() for _ in range(max_nodes)]\n    \n    # Source is 0, sink is 1\n    # Add edges from source to enc(i,j,0) for digits in buf1\n    for i in range(n):\n        row = buf1[i]\n        for j in range(n):\n            ch = row[j]\n            if '0' < ch <= '9':\n                val = ord(ch) - ord('0')\n                edge[0][enc(i,j,0)] = val\n    \n    # Compute tox distances from 'Z' cells using BFS\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    \n    tox = [[m+1]*n for _ in range(n)]\n    bfs = deque()\n    for i in range(n):\n        for j in range(n):\n            if buf2[i][j] == 'Z':\n                tox[i][j] = 0\n                bfs.append((i,j))\n    \n    while bfs:\n        x, y = bfs.popleft()\n        t = tox[x][y]\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 0 <= nx < n and 0 <= ny < n and buf2[nx][ny] != 'Y' and t+1 < tox[nx][ny]:\n                tox[nx][ny] = t+1\n                bfs.append((nx,ny))\n    \n    # Build edges for flow network\n    for i in range(n):\n        for j in range(n):\n            for t in range(m):\n                # Edges to next time step (moving)\n                for d in range(4):\n                    nx = i + dx[d]\n                    ny = j + dy[d]\n                    if 0 <= nx < n and 0 <= ny < n and buf2[nx][ny] != 'Y':\n                        # condition: t+1 < tox[nx][ny] + (1 if buf2[nx][ny] is digit else 0)\n                        # and t < tox[i][j]\n                        extra = 1 if ('0' < buf2[nx][ny] <= '9') else 0\n                        if t+1 < tox[nx][ny] + extra and t < tox[i][j]:\n                            edge[enc(i,j,t)][enc(nx,ny,t+1)] = 1000\n                # Edges to sink layer (if digit)\n                if '0' < buf2[i][j] <= '9':\n                    val = ord(buf2[i][j]) - ord('0')\n                    edge[enc(i,j,t)][enc(i,j,m)] = val\n            # Final edge from enc(i,j,m) to sink (1)\n            if '0' < buf2[i][j] <= '9':\n                val = ord(buf2[i][j]) - ord('0')\n                edge[enc(i,j,m)][1] = val\n    \n    # Max flow (Edmonds-Karp)\n    def max_flow(s, t):\n        total = 0\n        INF = 10**9\n        while True:\n            from_node = [-1] * max_nodes\n            flow_val = [0] * max_nodes\n            from_node[s] = s\n            flow_val[s] = INF\n            q = deque([s])\n            found = False\n            while q:\n                x = q.popleft()\n                if x == t:\n                    found = True\n                    aug = flow_val[t]\n                    v = t\n                    while v != s:\n                        u = from_node[v]\n                        edge[u][v] -= aug\n                        edge[v][u] = edge[v].get(u, 0) + aug\n                        v = u\n                    total += aug\n                    break\n                for v, cap in edge[x].items():\n                    if cap > 0 and from_node[v] == -1:\n                        from_node[v] = x\n                        flow_val[v] = min(cap, flow_val[x])\n                        q.append(v)\n            if not found:\n                break\n        return total\n    \n    res = max_flow(0, 1)\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.933898824470816e-06, 0.0, 0.0, -0.0003500564198475331, -0.00064876489341259, -3.576278118089249e-07, -0.0011744751827791333, -7.950943836476654e-05, -0.0004318020073696971, -1.1920928244535389e-07, -0.00020656836568377912, -0.011785168200731277, -0.006062688771635294, -1.2093619108200073, -0.0003363520372658968, -7.152555099310121e-07, -0.006840620189905167, -1.7881377516459906e-06, -1.7762025890988298e-05, 0.0, -2.3841574147809297e-05, -1.1920928244535389e-07, -0.023247310891747475, -0.474137544631958, -1.7881377516459906e-06, -0.31483545899391174, -2.861018856492592e-06, 0.0, -0.0007098776986822486, -2.3841855067985307e-07, 0.0, -5.4238757002167404e-05, -9.536738616588991e-07, -0.011837240308523178, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.099436753473128e-06, -3.576278118089249e-07, -1.311301275563892e-06, -2.50339189733495e-06, 0.0, 0.0, 0.0, -0.0007188120507635176, 0.0, 0.0, -8.95221673999913e-05, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -0.2519318163394928, -0.07889514416456223, -2.3841855067985307e-07, -0.02329075336456299, -0.6646097898483276, -0.41396135091781616, -0.13584107160568237, -0.2122846394777298, -0.8365678191184998, -0.4641466736793518, -0.10259868949651718, -0.037650350481271744, 0.0, -0.2724906802177429, -0.22479280829429626, -3.099436753473128e-06, -0.20908792316913605, 0.0, -2.2411095415009186e-05, -0.006715585943311453, -1.311301275563892e-06, 0.0, -2.3841855067985307e-07, -1.0728830375228426e-06, -2.9802276912960224e-06, -0.1643812656402588, -4.768370445162873e-07, -1.1920928244535389e-07, -0.0009280903614126146, -2.3841855067985307e-07, -0.032113876193761826, -0.47485315799713135, -1.1920928244535389e-07, -0.00020644917094614357, -0.00046397410915233195, -2.3841855067985307e-07, -0.0012900849105790257, -1.055989384651184, -0.3872547149658203, -0.024964697659015656, -1.1920922133867862e-06, -0.12719208002090454