{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing i64 = long long;\n\ni64 mod_val;\n\ninline i64 modnorm(i64 x) {\n    x %= mod_val;\n    if (x < 0) x += mod_val;\n    return x;\n}\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(nullptr);\n\n    int n_val, m_val;\n    while (cin >> n_val >> m_val >> mod_val) {\n\n        vector<vector<i64>> C(m_val + 1, vector<i64>(m_val + 1, 0));\n        for (int i = 0; i <= m_val; ++i) {\n            C[i][0] = 1 % mod_val;\n            for (int j = 1; j <= i; ++j) {\n                C[i][j] = modnorm(C[i-1][j-1] + C[i-1][j]);\n            }\n        }\n\n        vector<i64> W(m_val + 1, 0), S(m_val + 1, 0), Sn(m_val + 1, 0);\n        for (int i = 1; i <= m_val; ++i) {\n            Sn[i] = (i64)i * (i + 1) / 2 % mod_val;\n        }\n        W[0] = 1 % mod_val;\n\n        for (int l = 1; l <= m_val; ++l) {\n            for (int p = 0; p < l; ++p) {\n                int L = p, R = l - 1 - p;\n                i64 pw = modnorm(W[L] * W[R]);\n                i64 cf = modnorm((i64)(l + 1) * C[l - 1][p]);\n\n                W[l] = modnorm(W[l] + cf * pw);\n\n                i64 ts = modnorm(S[L] * W[R] + S[R] * W[L]);\n                S[l] = modnorm(S[l] + cf * ts);\n                S[l] = modnorm(S[l] + pw * C[l-1][p] % mod_val * (Sn[L] + Sn[R]) % mod_val);\n            }\n        }\n\n        vector<vector<i64>> W2(n_val + 1, vector<i64>(m_val + 1, 0));\n        vector<vector<i64>> S2(n_val + 1, vector<i64>(m_val + 1, 0));\n        W2[0][0] = 1 % mod_val;\n\n        for (int i = 1; i <= n_val; ++i) {\n            for (int j = 0; j <= min(i, m_val); ++j) {\n                W2[i][j] = W2[i - 1][j];\n                S2[i][j] = S2[i - 1][j];\n                for (int k = 1; k <= j; ++k) {\n                    int ni = max(0, i - k - 1);\n                    int nj = j - k;\n                    i64 tw = modnorm(W[k] * W2[ni][nj] % mod_val * C[j][k]);\n                    i64 ts2 = modnorm((S[k] * W2[ni][nj] + W[k] * S2[ni][nj]) % mod_val * C[j][k]);\n                    W2[i][j] = modnorm(W2[i][j] + tw);\n                    S2[i][j] = modnorm(S2[i][j] + ts2);\n                }\n            }\n        }\n\n        cout << modnorm(S2[n_val][m_val]) << '\\n';\n    }\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\ndef modnorm(x, mod_val):\n    x %= mod_val\n    if x < 0:\n        x += mod_val\n    return x\n\ndef main():\n    import sys\n    data = sys.stdin.read().split()\n    idx = 0\n    results = []\n    \n    while idx < len(data):\n        n_val = int(data[idx]); m_val = int(data[idx+1]); mod_val = int(data[idx+2])\n        idx += 3\n        \n        # Initialize binomial coefficients C\n        C = [[0] * (m_val + 1) for _ in range(m_val + 1)]\n        for i in range(m_val + 1):\n            C[i][0] = 1 % mod_val\n            for j in range(1, i + 1):\n                C[i][j] = modnorm(C[i-1][j-1] + C[i-1][j], mod_val)\n        \n        # Initialize W, S, Sn arrays\n        W = [0] * (m_val + 1)\n        S = [0] * (m_val + 1)\n        Sn = [0] * (m_val + 1)\n        \n        for i in range(1, m_val + 1):\n            Sn[i] = (i * (i + 1) // 2) % mod_val\n        \n        W[0] = 1 % mod_val\n        \n        # Compute W and S arrays\n        for l in range(1, m_val + 1):\n            for p in range(l):\n                L = p\n                R = l - 1 - p\n                pw = modnorm(W[L] * W[R], mod_val)\n                cf = modnorm((l + 1) * C[l-1][p], mod_val)\n                \n                W[l] = modnorm(W[l] + cf * pw, mod_val)\n                \n                ts = modnorm(S[L] * W[R] + S[R] * W[L], mod_val)\n                S[l] = modnorm(S[l] + cf * ts, mod_val)\n                S[l] = modnorm(S[l] + pw * C[l-1][p] % mod_val * (Sn[L] + Sn[R]) % mod_val, mod_val)\n        \n        # Initialize W2 and S2 2D arrays\n        W2 = [[0] * (m_val + 1) for _ in range(n_val + 1)]\n        S2 = [[0] * (m_val + 1) for _ in range(n_val + 1)]\n        W2[0][0] = 1 % mod_val\n        \n        for i in range(1, n_val + 1):\n            for j in range(min(i, m_val) + 1):\n                W2[i][j] = W2[i-1][j]\n                S2[i][j] = S2[i-1][j]\n                for k in range(1, j + 1):\n                    ni = max(0, i - k - 1)\n                    nj = j - k\n                    tw = modnorm(W[k] * W2[ni][nj] % mod_val * C[j][k], mod_val)\n                    ts2 = modnorm((S[k] * W2[ni][nj] + W[k] * S2[ni][nj]) % mod_val * C[j][k], mod_val)\n                    W2[i][j] = modnorm(W2[i][j] + tw, mod_val)\n                    S2[i][j] = modnorm(S2[i][j] + ts2, mod_val)\n        \n        results.append(str(modnorm(S2[n_val][m_val], mod_val)))\n    \n    print('\\n'.join(results))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016127715934999287, -8.344646857949556e-07, -7.152555099310121e-07, -0.5764840245246887, -0.20159995555877686, -0.0034616803