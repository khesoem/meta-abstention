ort deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    mxt = 50 * 3 + 1\n    s = n * mxt\n    t = s + 1\n    fn = t + 1\n    \n    # Initialize graph structures\n    e = [[] for _ in range(fn)]\n    to = []\n    fw = []\n    co = []\n    \n    def adde(u, v, w, cost):\n        idx1 = len(to)\n        e[u].append(idx1)\n        to.append(v)\n        fw.append(w)\n        co.append(cost)\n        \n        idx2 = len(to)\n        e[v].append(idx2)\n        to.append(u)\n        fw.append(0)\n        co.append(-cost)\n    \n    # Read starting positions\n    for _ in range(k):\n        u = int(next(it)) - 1\n        adde(s, u, 1, 0)\n    \n    # Read edges\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for i in range(mxt - 1):\n            for p in range(1, k + 1):\n                cost = 2 * d * p - d\n                adde(i * n + u, (i + 1) * n + v, 1, cost)\n                adde(i * n + v, (i + 1) * n + u, 1, cost)\n    \n    # Self loops\n    for u in range(n):\n        for i in range(mxt - 1):\n            adde(i * n + u, (i + 1) * n + u, k, 0)\n    \n    # Connect to sink\n    for i in range(mxt):\n        adde(i * n, t, k, i * c)\n    \n    INF = 0x3f3f3f3f\n    linf = 0x3f3f3f3f3f3f3f3f\n    \n    def spfa():\n        dep = [INF] * fn\n        pre = [-1] * fn\n        vis = [False] * fn\n        q = deque()\n        q.append(s)\n        vis[s] = True\n        dep[s] = 0\n        \n        while q:\n            u = q.popleft()\n            vis[u] = False\n            for idx in e[u]:\n                if fw[idx] > 0 and dep[to[idx]] > dep[u] + co[idx]:\n                    dep[to[idx]] = dep[u] + co[idx]\n                    pre[to[idx]] = idx\n                    if not vis[to[idx]]:\n                        vis[to[idx]] = True\n          