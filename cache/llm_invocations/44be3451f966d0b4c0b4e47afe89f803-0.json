 g;\n        }\n        if (denominator < 0) {\n            numerator = -numerator;\n            denominator = -denominator;\n        }\n    }\n    \n    void display() const {\n        cout << numerator << \"/\" << denominator;\n    }\n};\n\nint main() {\n    cin >> x >> y >> n;\n    \n    Fraction target(x, y);\n    Fraction minDifference(50, 1);\n    Fraction bestFraction;\n    \n    for (long long i = 1; i <= n; ++i) {\n        long long q = (target.numerator * i) / target.denominator;\n        long long r = (target.numerator * i) % target.denominator;\n        \n        if (r > target.denominator / 2) {\n            q++;\n            r = target.denominator - r;\n        }\n        \n        Fraction diff(r, i * target.denominator);\n        diff.simplify();\n        \n        if (diff < minDifference) {\n            minDifference = diff;\n            bestFraction.numerator = q;\n            bestFraction.denominator = i;\n        }\n    }\n    \n    bestFraction.display();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static long n, x, y;\n\n    static long euclideanGcd(long a, long b) {\n        while (b != 0) {\n            long r = a % b;\n            a = b;\n            b = r;\n        }\n        return a;\n    }\n\n    static class Fraction {\n        long numerator;\n        long denominator;\n\n        Fraction() {\n            numerator = 0;\n            denominator = 1;\n        }\n\n        Fraction(long num, long den) {\n            numerator = num;\n            denominator = den;\n        }\n\n        void subtract(Fraction other) {\n            numerator = numerator * other.denominator - other.numerator * denominator;\n            denominator = denominator * other.denominator;\n        }\n\n        boolean lessThan(Fraction other) {\n            return numerator * other.denominator < other.numerator * denominator;\n        }\n\n        void simplify() {\n            long g = euclideanGcd(Math.abs(numerator), Math.abs(denominator));\n            if (g != 0) {\n                numerator /= g;\n                denominator /= g;\n            }\n            if (denominator < 0) {\n                numerator = -numerator;\n                denominator = -denominator;\n            }\n        }\n\n        void display() {\n            System.out.println(numerator + \"/\" + denominator);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        x = scanner.nextLong();\n        y = scanner.nextLong();\n        n = scanner.nextLong();\n\n        Fraction target = new Fraction(x, y);\n        Fraction minDifference = new Fraction(50, 1);\n        Fraction bestFraction = new Fraction();\n\n        for (long i = 1; i <= n; ++i) {\n            long q = (target.numerator * i) / target.denominator;\n            long r = (target.numerator * i) % target.denominator;\n\n            if (r > target.denominator / 2) {\n                q++;\n                r = target.denominator - r;\n            }\n\n            Fraction diff = new Fraction(r, i * target.denominator);\n            diff.simplify();\n\n            if (diff.lessThan(minDifference)) {\n                minDifference = diff;\n                bestFraction.numerator = q;\n                bestFraction.denominator = i;\n            }\n        }\n\n        bestFraction.display();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.0649541915627196e-05, -0.00010287232726113871, -1.6689286894688848e-06, -8.344646857949556e-07, -0.0002562671434134245, -1.4424220353248529e-05, -0.013206509873270988, -0.2071228176355362, -0.043008703738451004, -2.3841855067985307e-07, -7.116541382856667e-05, -0.014163684099912643, -0.005929617211222649, -0.41355088353157043, -0.01107992883771658, -0.02577419206500053