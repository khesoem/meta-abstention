{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\n#define DEBUG 0\ntypedef long long ll;\ntypedef pair<int,int> pii;\ntypedef pair<ll,ll> pll;\n#define fore(i,ii,iii) for(int i=ii;i<iii;i++)\n#define pb push_back\n#define SZ(a) ((int)(a).size())\n#define mset(a,b) memset(a,b,sizeof(a));\n#define ALL(a) a.begin(),a.end()\n#define fst first\n#define snd second\n\nconst int MAXN=50*100+15;\nint SRC = MAXN-1;\nint SNC = MAXN-2;\n\ntypedef ll tf;const tf INFFLUJO=1e14;\ntypedef ll tc;const tc INFCOSTO=1e14;\nstruct edge {\n\tint u,v;tf cap,flow;tc cost;\n\ttf rem(){return cap-flow;}\n};\nint nodes=MAXN; // remember to init nodes\nvector<int> g[MAXN];\nvector<edge> e;\nvoid add_edge(int u, int v, tf cap, tc cost) {\n\tif(DEBUG) {\n\t\tstring dem=to_string(u),pen=to_string(v);\n\t\tif(u==SRC)dem=\"SRC\";\n\t\tif(u==SNC)dem=\"SINC\";\n\t\tif(v==SRC)pen=\"SRC\";\n\t\tif(v==SNC)pen=\"SINC\";\n\t\tcout<<\"add edge: \"<<dem<<\" \"<<pen<<\" \"<<cap<<\" \"<<cost<<endl;\n\t}\n\tg[u].pb(SZ(e));e.pb((edge){u,v,cap,0,cost});\n\tg[v].pb(SZ(e));e.pb((edge){v,u,0,0,-cost});\n}\ntc dist[MAXN],mncost;\nint pre[MAXN];\ntf cap[MAXN],mxflow;\nbool in_queue[MAXN];\nvoid flow(int s, int t){\n\tmemset(in_queue,0,sizeof(in_queue));\n\tmxflow=mncost=0;\n\twhile(1){\n\t\tfill(dist,dist+nodes,INFCOSTO);dist[s]=0;\n\t\tmemset(pre,-1,sizeof(pre));pre[s]=0;\n\t\tmemset(cap,0,sizeof(cap));cap[s]=INFFLUJO;\n\t\tqueue<int> q;q.push(s);in_queue[s]=1;\n\t\twhile(SZ(q)){\n\t\t\tint u=q.front();q.pop();in_queue[u]=0;\n\t\t\tfore(_,0,SZ(g[u])){\n\t\t\t\tint i=g[u][_];\n\t\t\t\tedge &E=e[i];\n\t\t\t\tif(E.rem()&&dist[E.v]>dist[u]+E.cost+1e-9){\n\t\t\t\t\tdist[E.v]=dist[u]+E.cost;\n\t\t\t\t\tpre[E.v]=i;\n\t\t\t\t\tcap[E.v]=min(cap[u],E.rem());\n\t\t\t\t\tif(!in_queue[E.v])q.push(E.v),in_queue[E.v]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(pre[t]<0)break;\n\t\tmxflow+=cap[t];mncost+=cap[t]*dist[t];\n\t\tfor(int v=t;v!=s;v=e[pre[v]].u){\n\t\t\te[pre[v]].flow+=cap[t];e[pre[v]^1].flow-=cap[t];\n\t\t}\n\t}\n}\nint main() {\n  ios::sync_with_stdio(false);\n\tll n,m,k,c,d;\n  cin>>n>>m>>k>>c>>d;\n\tint MAXT=n+k;\n\tif(DEBUG)cout<<\"MAXT: \"<<MAXT<<endl;\n\tvector<int>a(k);\n\tfore(i,0,k){\n\t\tcin>>a[i];a[i]--;\n\t\tadd_edge(SRC,a[i]*MAXT,1,0);\n\t}\n\tfore(j,0,MAXT)add_edge(j,SNC,k,0);\n\tfore(i,0,m) {\n\t\tint x,y;cin>>x>>y;x--,y--;\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(x*MAXT+j,y*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(y*MAXT+j,x*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t}\n\tfore(i,0,n) {\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(i*MAXT+j,i*MAXT+j+1,1,c);\n\t\t}\n\t}\n\tflow(SRC,SNC);\n\tif(DEBUG)cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n\tcout<<mncost<<endl;\n}\n\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\nimport math\n\nINFFLOW = 10**14\nINFCOST = 10**14\n\nclass Edge:\n    __slots__ = ('u', 'v', 'cap', 'flow', 'cost')\n    def __init__(self, u, v, cap, flow, cost):\n        self.u = u\n        self.v = v\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n    def rem(self):\n        return self.cap - self.flow\n\ndef min_cost_flow(s, t, graph, edges):\n    n = len(graph)\n    dist = [INFCOST] * n\n    pre = [-1] * n\n    cap = [0] * n\n    in_queue = [False] * n\n    mxflow = 0\n    mncost = 0\n    \n    while True:\n        dist = [INFCOST] * n\n        dist[s] = 0\n        pre = [-1] * n\n        pre[s] = 0\n        cap = [0] * n\n        cap[s] = INFFLOW\n        in_queue = [False] * n\n        q = deque()\n        q.append(s)\n        in_queue[s] = True\n        \n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            for idx in graph[u]:\n                e = edges[idx]\n                if e.rem() > 0 and dist[e.v] > dist[u] + e.cost + 1e-9:\n                    dist[e.v] = dist[u] + e.cost\n                    pre[e.v] = idx\n                    cap[e.v] = min(cap[u], e.rem())\n                    if not in_queue[e.v]:\n                        q.append(e.v)\n                        in_queue[e.v] = True\n        \n        if pre[t] < 0:\n            break\n        \n        f = cap[t]\n        mxflow += f\n        mncost += f * dist[t]\n        v = t\n        while v != s:\n            idx = pre[v]\n            edges[idx].flow += f\n            edges[idx ^ 1].flow -= f\n            v = edges[idx].u\n    \n    return mxflow, mncost\n\ndef solve():\n    data = list(map(int, sys.stdin.read().strip().split()))\n    if not data:\n        return\n    idx = 0\n    n = data[idx]; idx += 1\n    m = data[idx]; idx += 1\n    k = data[idx]; idx += 1\n    c = data[idx]; idx += 1\n    d = data[idx]; idx += 1\n    \n    MAXT = n + k\n    total_nodes = n * MAXT + 2\n    SRC = total_nodes - 1\n    SNC = total_nodes - 2\n    \n    graph = [[] for _ in range(total_nodes)]\n    edges = []\n    \n    def add_edge(u, v, cap, cost):\n        graph[u].append(len(edges))\n        edges.append(Edge(u, v, cap, 0, cost))\n        graph[v].append(len(edges))\n        edges.append(Edge(v, u, 0, 0, -cost))\n    \n    a = []\n    for _ in range(k):\n        a_i = data[idx] - 1\n        idx += 1\n        a.append(a_i)\n        add_edge(SRC, a_i * MAXT, 1, 0)\n    \n    for j in range(MAXT):\n        add_edge(j, SNC, k, 0)\n    \n    for _ in range(m):\n        x = data[idx] - 1\n        y = data[idx+1] - 1\n        idx += 2\n        for j in range(MAXT - 1):\n            for K in range(1, k+1):\n                cost = c + d * (2*K - 1)\n                add_edge(x*MAXT + j, y*MAXT + j+1, 1, cost)\n                add_edge(y*MAXT + j, x*MAXT + j+1, 1, cost)\n    \n    for i in range(n):\n        for j in range(MAXT - 1):\n            for K in range(1, k+1):\n                add_edge(i*MAXT + j, i*MAXT + j+1, 1, c)\n    \n    mxflow, mncost = min_cost_flow(SRC, SNC, graph, edges)\n    print(mncost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1\n</confidence>", "token_logprobs": [-2.1695856e-05, 0.0, -1.3113013e-06, -0.00046814448, -0.17362413, -0.0026069249, -0.011291647, -0.023876283, -0.0013537776, -1.1920928e-07, -0.001175785, -2.1285896, -0.74383354, -0.0044969385, -0.0009719177, -3.6136672, -0.004666866, -1.1402686, -0.00095548265, -7.950944e-05, -0.0015410226, -0.00026496715, -0.008663449, -0.003981759, -0.00022528018, -0.00071249844, -0.00016640233, -1.7881378e-06, -0.00012623466, -9.5367386e-07, -6.675698e-06, -3.576278e-07, -2.4437606e-05, -0.048678737, -0.12828612, -0.025668582, -2.0384581e-05, -6.4372807e-06, -0.6931834, -1.1920928e-07, -4.7683704e-07, -3.933899e-06, -1.5139465e-05, -0.022248898, -0.00053367676, -0.04858767, -3.576278e-07, 0.0, -1.072883e-06, -2.3841855e-07, -0.00010084597, -1.072883e-06, -2.3841855e-07, -9.679326e-05, -4.7683704e-07, -3.576278e-07, -1.1920928e-07, -0.0005652499, -1.6808368e-05, -1.1920928e-07, -1.3113013e-06, -1.1920928e-07, -1.1920928e-07, -2.3841855e-07, -1.0251946e-0