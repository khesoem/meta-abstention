eturn R;\n}\nvector<vector<int>> pref[100];\nvoid init() {\n    ll digs = 0, tmp = N;\n    while (tmp) { tmp /= K; digs++; }\n    pref[0].assign(K + 1, vector<int>(K + 1, 0));\n    for (int i = 1; i < K; ++i) pref[0][i][i] = 1;\n    pref[0][0][K] = 1;\n    pref[0][K][0] = MOD - 1;\n    pref[0][K][K] = 2;\n    for (int step = 0; step < digs; ++step) {\n        pref[step + 1] = pref[step];\n        auto cur = pref[step];\n        for (int i = 1; i <= K - 1; ++i) {\n            cur = shift(cur);\n            pref[step + 1] = matMul(pref[step + 1], cur);\n        }\n    }\n}\nvector<vector<int>> solve(ll n) {\n    if (n == 0) {\n        vector<vector<int>> I(K + 1, vector<int>(K + 1, 0));\n        for (int i = 0; i <= K; ++i) I[i][i] = 1;\n        return I;\n    }\n    ll dig = 0, pw = 1;\n    while (pw <= n / K) { pw *= K; dig++; }\n    if (n == pw) return pref[dig];\n    ll steps = n / pw;\n    ll left = n - steps * pw;\n    auto res = solve(0);\n    auto coef = pref[dig];\n    for (int i = 0; i < steps; ++i) {\n        res = matMul(res, coef);\n        coef = shift(coef);\n    }\n    auto other = solve(left);\n    for (int i = 0; i < steps; ++i) other = shift(other);\n    return matMul(res, other);\n}\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    srand(239);\n    cin >> N >> K;\n    init();\n    auto M = solve(N);\n    cout << M[K][K] << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static final int MOD = 1_000_000_007;\n    static long N;\n    static int K;\n    static int[][][] pref; // pref[step] is a matrix of size (K+1) x (K+1)\n\n    static int add(int a, int b) {\n        int s = a + b;\n        return s >= MOD ? s - MOD : s;\n    }\n\n    static int sub(int a, int b) {\n        int s = a - b;\n        return s < 0 ? s + MOD : s