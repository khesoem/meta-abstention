nverse factorials up to max(n, 20)\n    max_n = max(n, 20)\n    fact = [1] * (max_n + 1)\n    for i in range(1, max_n + 1):\n        fact[i] = fact[i-1] * i % mod\n    inv_fact = [1] * (max_n + 1)\n    inv_fact[max_n] = pow(fact[max_n], mod-2, mod)\n    for i in range(max_n, 0, -1):\n        inv_fact[i-1] = inv_fact[i] * i % mod\n\n    # helper for combination C(n, k) with n <= max_n\n    def comb(n: int, k: int) -> int:\n        if k < 0 or k > n:\n            return 0\n        return fact[n] * inv_fact[k] % mod * inv_fact[n-k] % mod\n\n    # extract bits of n\n    bits = []\n    for b in range(20):\n        if n & (1 << b):\n            bits.append(1 << b)\n    bit_cnt = len(bits)\n    total_subsets = 1 << bit_cnt\n\n    # precompute subset values (in increasing order)\n    subset_vals = [0] * total_subsets\n    for mask in range(1, total_subsets):\n        # compute value by ORing bits corresponding to set bits in mask\n        # we can compute incrementally: subset_vals[mask] = subset_vals[mask & (mask-1)] | bits[lsb_index]\n        # but simple loop is fine since bit_cnt <= 19\n        val = 0\n        for b in range(bit_cnt):\n            if mask & (1 << b):\n                val |= bits[b]\n        subset_vals[mask] = val\n\n    # dp as flat array: dp[i*20 + j] for i from 0..n, j from 0..19\n    dp = array('I', [0]) * ((n+1) * 20)\n    dp[0] = 1  # dp[0][0] = 1\n\n    # process subsets in increasing order\n    for mask in range(1, total_subsets):\n        i = subset_vals[mask]\n        if i == 0:\n            continue\n        # highest power of two <= i\n        mx_i = 1 << (i.bit_length() - 1)\n        now = i ^ mx_i\n        cnt_i = i.bit_count()\n        # iterate over submasks k of now\n        k = now\n        while True:\n            cur1 = k + mx_i\n            cur2 = i ^ cur1\n            cnt_cur2 = cur2.bit_count()\n            up = min(K - 1, cnt_cur2)\n            if up >= 0:\n                tmp = comb(i, cur1)\n                base_i = i * 20\n  