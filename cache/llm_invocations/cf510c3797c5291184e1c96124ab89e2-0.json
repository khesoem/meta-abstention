st) ^ (hash<int>()(p.second) << 1);\n    }\n};\n\nint main() {\n    int n, h;\n    cin >> n >> h;\n    unordered_map<pair<int, int>, long long, pair_hash> v;\n    cout << go(n, n, v) - go(n, max(0, h - 1), v) << endl;\n    return 0;\n}\n\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.3053745627403259, -2.4868770196917467e-05, -0.22599761188030243, -7.896309739408025e-07, -1.9361264946837764e-07, -3.128163257315464e-07, -0.5764380097389221, 0.0, -0.0007107630372047424, -0.0007105246186256409, -4.320199877838604e-07, -0.09237220138311386, -0.5784640908241272, -0.06933233141899109, -2.2200749754119897e-06, 0.0, -0.0004961982485838234, -0.6482692956924438, -0.002490522339940071, -7.111979357432574e-05, -2.629921436891891e-05, -1.7432603272027336e-06, -0.00026217024424113333, -1.9361264946837764e-07, -3.8889261304575484e-06, -7.896309739408025e-07, -0.0002246357616968453, 0.0, -0.009301839396357536, -6.704273118884885e-07, -0.6931717991828918, -1.9361264946837764e-07, -1.2664456789934775e-06, -3.054500666621607e-06, -5.512236498361744e-07, -0.0010875897714868188, -0.20428156852722168, -0.35782745480537415, -1.9361264946837764e-07, -0.22542954981327057, 0.0, -0.027406159788370132, -7.226628895296017e-06, -0.00022845028433948755, -0.02828296832740307, -9.729906196298543e-06, -0.0002651503309607506, -0.08980480581521988, -3.128163257315464e-07, -0.0021948604844510555, -1.9361264946837764e-07, 0.0, -2.165027217415627e-05, -0.029818419367074966, -0.002505982294678688, -4.320199877838604e-07, 0.0, -0.002481246367096901, 0.0, -8.232493564719334e-05, -0.0001422770437784493, -0.0435059480369091, -0.00015455135144293308, -2.935296834039036e-06, -0.0059289163909852505, -1.0280383548888494e-06, -2.2200749754119897e-06, -2.5776860184123507e-06, 0.0, -6.704273118884885e-07, -1.8550976164988242e-05, -2.2961512513575144e-05, 0.0, -0.5797293782234192, -0.0003055493871215731, 0.0, -0.005518684629350901, -1.9361264946837764e-07, 0.0, -0.0019608670845627785, -6.392202976712724e-0