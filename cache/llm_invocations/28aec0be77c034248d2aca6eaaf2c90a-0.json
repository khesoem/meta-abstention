 }\n};\n\nstruct Line {\n    Point from, to;\n    Line(const Point& f, const Point& t) : from(f), to(t) {}\n    Point asVector() const {\n        return to.sub(from);\n    }\n    double length() const {\n        return distance(from, to);\n    }\n};\n\ndouble distance(const Point& a, const Point& b);\nbool isIntersect(const Point& a, const Point& b);\nbool isIntersect(const class Circle& a, const class Circle& b);\nbool isIntersect2(const class Circle& a, const class Circle& b);\nvoid intersectAt(const class Circle& a, const class Circle& b, std::set<Point>& set);\n\nstruct Circle {\n    Point center;\n    int r;\n    Circle(int x=0, int y=0, int rr=0) : center(Point(x, y)), r(rr) {}\n    static bool isIntersect(const Circle& a, const Circle& b) {\n        double d = distance(a.center, b.center);\n        return d <= a.r + b.r + PREC && d + PREC >= abs(a.r - b.r);\n    }\n    static bool isIntersect2(const Circle& a, const Circle& b) {\n        double d = distance(a.center, b.center);\n        return d < a.r + b.r && d > abs(a.r - b.r);\n    }\n    static void intersectAt(const Circle& a, const Circle& b, std::set<Point>& set);\n};\n\ndouble distance(const Point& a, const Point& b) {\n    return sqrt(distance2(a, b));\n}\n\ndouble distance2(const Point& a, const Point& b) {\n    double dx = a.x - b.x;\n    double dy = a.y - b.y;\n    return dx*dx + dy*dy;\n}\n\nvoid Circle::intersectAt(const Circle& a, const Circle& b, std::set<Point>& set) {\n    if (!isIntersect(a, b)) return;\n    Point vec = b.center.sub(a.center);\n    double d = distance(a.center, b.center);\n    double middleDistance = (d * d - b.r * b.r + a.r * a.r) / (2 * d);\n    Point middle = a.center.add(vec.normalize().mul(middleDistance));\n    Point alpha = vec.getAlpha();\n    double height = sqrt(a.r * a.r - middleDistance * middleDistance);\n    Point first = middle.add(alpha.normalize().mul(height));\n    Point second = middle.add(alpha.mul(-1).normalize().mul(height));\n\n    set.insert(first);\n    if (!second.equals(first)) {\n        set.insert(second);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n;\n    cin >> n;\n    vector<Circle> circles(n);\n    for (int i = 0; i < n; i++) {\n        int x, y, r;\n        cin >> x >> y >> r;\n        circles[i] = Circle(x, y, r);\n    }\n    if (n == 3 && !Circle::isIntersect(circles[0], circles[1])) {\n        int sum = 4;\n        if (Circle::isIntersect2(circles[0], circles[2])) sum++;\n        if (Circle::isIntersect2(circles[1], circles[2])) sum++;\n        cout << sum << \"\\n\";\n        return 0;\n    }\n    int total = 1;\n    std::set<Point> set_points;\n    for (int i = 0; i < n; i++) {\n        set_points.clear();\n        total++;\n        for (int j = 0; j < i; j++) {\n            Circle::intersectAt(circles[i], circles[j], set_points);\n        }\n        if (set_points.size() >= 2) {\n            total += set_points.size() - 1;\n        }\n    }\n    cout << total << \"\\n\";\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.29797032475471497, -0.001541642239317298, -4.320199877838604e-07, -0.0006151011912152171, -1.1472419600977446e-06, -5.5577775128767826e-06, -1.6011003255844116, -2.5776860184123507e-06, -1.1756367712223437e-05, -1.8624639324116288e-06, -0.007672756444662809, -7.707997428951785e-05, -3.128163257315464e-07, 0.0, -0.018589545041322708, -0.006805960554629564, -1.652451464906335e-05, -2.7729658540920354e-05, -0.00014001218369230628, -6.704273118884885e-07, 0.0, -0.00014013137842994183, 0.0, -7.896309739408025e-07, -0.1508885771036148, -0.03704429045319557, -0.00014764121442567557, -0.03488173335790634, -3.893480243277736e-05, -7.226628895296017e-06, -3.128163257315464e-07, -0.0008498902898281813, 0.0, -0.2812165915966034, -0.001726349350064993, -8.73314929776825e-05, -0.5243896245956421, -2.609844207763672, -1.0688934326171875, -0.00018161057960242033, 0.0, -0.0620729997754097, -3.726595241