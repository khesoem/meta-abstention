har = wrongChars.get(0);\n                for (int i = 0; i < n/2; i++) {\n                    Char chr = chars1.get(i);\n                    if (chr.chr != wrongChar.chr && chars[n - chr.idx - 1] != wrongChar.chr) {\n                        diff = wrongChar.val + chr.val;\n                        break;\n                    }\n                }\n            } else if (wrongChars.size() > 1) {\n                Map<Character, Integer> map = new TreeMap<>();\n                for (Char c : wrongChars) {\n                    map.merge(c.chr, 1, Integer::sum);\n                }\n                Map.Entry<Character, Integer> max = null;\n                for (Map.Entry<Character, Integer> entry : map.entrySet()) {\n                    if (max == null || entry.getValue() > max.getValue()) {\n                        max = entry;\n                    }\n                }\n                List<Char> append = new ArrayList<>();\n                while (max.getValue() * 2 > wrongChars.size() + append.size()) {\n                    Character maxChar = max.getKey();\n                    for (int i = 0; i < n/2; i++) {\n                        Char chr = chars1.get(i);\n                        if (chr.chr != maxChar && chars[n - chr.idx - 1] != maxChar && !wrongChars.contains(chr) && !append.contains(chr)) {\n                            append.add(chr);\n                            break;\n                        }\n                    }\n                }\n                diff = wrongChars.stream().mapToInt(chr -> chr.val).sum() + append.stream().mapToInt(chr -> chr.val).sum();\n            }\n        }\n\n        int sum = Arrays.stream(vals).sum();\n        System.out.println(sum - diff);\n    }\n\n    private static void swap(int i) {\n        char tmp = chars[i];\n        chars[i] = chars[n - i - 1];\n        chars[n - i - 1] = tmp;\n\n        int tmpVal = vals[i];\n        vals[i] = vals[n - i - 1];\n        vals[n - i - 1] = tmpVal;\n    }\n\n    private static void swap(int i, int j) {\n        char tmp = chars[i];\n        chars[i] = chars[j];\n        chars[j] = tmp;\n\n        int tmpVal = vals[i];\n        vals[i] = vals[n - i - 1];\n        vals[n - i - 1] = tmpVal;\n    }\n\n    private static boolean isAntiPalindrome(char[] chars) {\n        int n = chars.length;\n        for (int i = 0; i < n/2; i++) {\n            if (chars[i] == chars[n - i - 1]) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    static class Char {\n        char chr;\n        int val;\n        int idx;\n\n        Char(char chr, int val, int idx) {\n            this.chr = chr;\n            this.val = val;\n            this.idx = idx;\n        }\n\n        @Override\n        public String toString() {\n            return \"Char{\" +\n                    \"chr=\" + chr +\n                    \", val=\" + val +\n                    \", idx=\" + idx +\n                    '}';\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <map>\n#include <numeric>\n#include <string>\n#include <cctype>\n\nstruct Char {\n    char chr;\n    int val;\n    int idx;\n    \n    Char(char c, int v, int i) : chr(c), val(v), idx(i) {}\n};\n\nbool isAntiPalindrome(const std::vector<char>& chars) {\n    int n = chars.size();\n    for (int i = 0; i < n/2; i++) {\n        if (chars[i] == chars[n - i - 1]) {\n            return false;\n        }\n    }\n    return true;\n}\n\nvoid swap(std::vector<char>& chars, std::vector<int>& vals, int i) {\n    int n = chars.size();\n    char tmp = chars[i];\n    chars[i] = chars[n - i - 1];\n    chars[n - i - 1] = tmp;\n    \n    int tmpVal = vals[i];\n    vals[i] = vals[n - i - 1];\n    vals[n - i - 1] = tmpVal;\n}\n\nint main() {\n    int n;\n    std::cin >> n;\n    std::cin.ignore();\n    \n    std::string s;\n    std::getline(std::cin, s);\n    s.erase(0, s.find_first_not_of(\" \\t\\r\\n\"));\n    s.erase(s.find_last_not_of(\" \\t\\r\\n\") + 1);\n    \n    std::vector<char> chars(s.begin(), s.end());\n    \n    std::vector<int> vals(n);\n    for (int i = 0; i < n; i++) {\n        std::cin >> vals[i];\n    }\n    std::cin.ignore();\n    \n    std::vector<Char> wrongChars;\n    std::vector<Char> chars1;\n    \n    for (int i = 0; i < n / 2; i++) {\n        if (vals[i] > vals[n - i - 1]) {\n            swap(chars, vals, i);\n        }\n        \n        Char chr(chars[i], vals[i], i);\n        if (chars[i] == chars[n - i - 1]) {\n            wrongChars.push_back(chr);\n        }\n        chars1.push_back(chr);\n    }\n    \n    std::sort(chars1.begin(), chars1.end(), [](const Char& a, const Char& b) {\n        return a.val < b.val;\n    });\n    \n    int diff = 0;\n    if (!isAntiPalindrome(chars)) {\n        if (wrongChars.size() == 1) {\n            Char wrongChar = wrongChars[0];\n            for (int i = 0; i < n/2; i++) {\n                Char chr = chars1[i];\n                if (chr.chr != wrongChar.chr && chars[n - chr.idx - 1] != wrongChar.chr) {\n                    diff = wrongChar.val + chr.val;\n                    break;\n                }\n            }\n        } else if (wrongChars.size() > 1) {\n            std::map<char, int> map;\n            for (const Char& c : wrongChars) {\n                map[c.chr]++;\n            }\n            \n            std::pair<char, int> maxPair = {'\\0', 0};\n            for (const auto& entry : map) {\n                if (maxPair.second < entry.second) {\n                    maxPair = entry;\n                }\n            }\n            \n            std::vector<Char> append;\n            while (maxPair.second * 2 > wrongChars.size() + append.size()) {\n                char maxChar = maxPair.first;\n                bool found = false;\n                for (int i = 0; i < n/2; i++) {\n                    Char chr = chars1[i];\n                    bool foundWrong = false;\n                    for (const Char& w : wrongChars) {\n                        if (w.idx == chr.idx) {\n                            foundWrong = true;\n                            break;\n                        }\n                    }\n                    if (!foundWrong) {\n                        for (const Char& a : append) {\n                            if (a.idx == chr.idx) {\n                                foundWrong = true;\n                                break;\n                            }\n                        }\n                    }\n                    if (!foundWrong && chr.chr != maxChar && chars[n - chr.idx - 1] != maxChar) {\n                        append.push_back(chr);\n                        found = true;\n                        break;\n                    }\n                }\n                if (!found) {\n                    break;\n                }\n            }\n            \n            diff = 0;\n            for (const Char& chr : wrongChars) {\n                diff += chr.val;\n            }\n            for (const Char& chr : append) {\n                diff += chr.val;\n            }\n        }\n    }\n    \n    int sum = std::accumulate(vals.begin(), vals.end(), 0);\n    std::cout << sum - diff << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00017081231635529548, -9.179073458653875e-06, -8.344646857949556e-07, -0.0001967951684491709, -5.960462772236497e-07, -2.3841574147809297e-05, -4.768370445162873e-07, -7.390948667307384e-06, -2.3841855067985307e-07, -0.00023874769976828247, -2.3841855067985307e-07, -9.369411418447271e-05, -7.152555099310121e-07, -0.07636253535747528, -1.1920928244535389e-07, -1.07287787614041e-05, -3.576278118089249e-07, -0.0018584138015285134, -1.0132738680113107e-05, -1.7165990357170813e-05, -1.6689286894688848e-06, -0.9844359755516052, -0.02324696071445942, -0.00062744005