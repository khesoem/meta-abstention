t(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for arg in args:\n                r = self.mult_two(r, arg)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g %= r\n                g, r = r, g\n                x -= q * y\n                x, y = y, x\n            if g != 1:\n                raise AssertionError()\n            if y != self.modulus() and y != -self.modulus():\n                raise AssertionError()\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    raise RuntimeError(\"No more input\")\n                self.tokenizer = line.strip().split()\n            except Exception as e:\n                raise RuntimeError(e)\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_reader, out):\n        self.n = in_reader.