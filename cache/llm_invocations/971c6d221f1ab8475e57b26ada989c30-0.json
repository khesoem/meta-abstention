{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <cmath>\n\nusing namespace std;\n\nclass FractionFinder\n{\npublic:\n    int findGcd(int a, int b)\n    {\n        int g = (a > b) ? a : b;\n        while (!(a % g == 0 && b % g == 0))\n        {\n            g--;\n        }\n        return g;\n    }\n\n    void getDifference(double x, double y, double a, double b, double &num, double &den)\n    {\n        num = fabs(x * b - y * a);\n        den = y * b;\n    }\n\n    void reduceFraction(int &num, int &den)\n    {\n        int g = findGcd(num, den);\n        if (g != 1)\n        {\n            num = num / g;\n            den = den / g;\n        }\n    }\n\n    void run()\n    {\n        double x, y, n, a, b;\n        double best = 1000000.0;\n        int bestA = 0;\n        int bestB = 0;\n\n        cin >> x >> y >> n;\n\n        if (n > y)\n        {\n            int g = findGcd((int)x, (int)y);\n            if (g != 1)\n            {\n                x = x / g;\n                y = y / g;\n            }\n            cout << x << \"/\" << y << endl;\n            return;\n        }\n\n        for (b = n; b >= 1.0; b = b - 1.0)\n        {\n            a = (x * b) / y;\n\n            if (floor(a) == a)\n            {\n                bestA = (int)a;\n                bestB = (int)b;\n                break;\n            }\n\n            double num, den, temp;\n\n            getDifference(x, y, floor(a), b, num, den);\n            temp = num / den;\n\n            if (temp < best)\n            {\n                best = temp;\n                bestA = (int)floor(a);\n                bestB = (int)b;\n            }\n            else if (temp == best && floor(a) < bestA)\n            {\n                bestA = (int)floor(a);\n                bestB = (int)b;\n            }\n\n            getDifference(x, y, ceil(a), b, num, den);\n            temp = num / den;\n\n            if (temp < best)\n            {\n                best = temp;\n                bestA = (int)ceil(a);\n                bestB = (int)b;\n            }\n            else if (temp == best && ceil(a) < bestA)\n            {\n                bestA = (int)ceil(a);\n                bestB = (int)b;\n            }\n        }\n\n        reduceFraction(bestA, bestB);\n        cout << bestA << \"/\" << bestB << endl;\n    }\n};\n\nint main()\n{\n    FractionFinder finder;\n    finder.run();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef find_gcd(a, b):\n    # Simple GCD using Euclidean algorithm (more efficient)\n    return math.gcd(a, b)\n\ndef reduce_fraction(num, den):\n    g = find_gcd(num, den)\n    if g != 1:\n        num //= g\n        den //= g\n    return num, den\n\ndef run():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, n = map(float, data[:3])\n\n    if n > y:\n        # Reduce x/y directly\n        num = int(x)\n        den = int(y)\n        num, den = reduce_fraction(num, den)\n        print(f\"{num}/{den}\")\n        return\n\n    best = float('inf')\n    best_a = 0\n    best_b = 0\n\n    # Loop from int(n) down to 1\n    for b in range(int(n), 0, -1):\n        a = (x * b) / y\n\n        # Check if a is exactly integer\n        if a == math.floor(a):\n            best_a = int(a)\n            best_b = b\n            break\n\n        # Consider floor(a)\n        floor_a = math.floor(a)\n        num = abs(x * b - y * floor_a)\n        den = y * b\n        temp = num / den\n        if temp < best:\n            best = temp\n            best_a = int(floor_a)\n            best_b = b\n        elif temp == best and floor_a < best_a:\n            best_a = int(floor_a)\n            best_b = b\n\n        # Consider ceil(a)\n        ceil_a = math.ceil(a)\n        num = abs(x * b - y * ceil_a)\n        den = y * b\n        temp = num / den\n        if temp < best:\n            best = temp\n            best_a = int(ceil_a)\n            best_b = b\n        elif temp == best and ceil_a < best_a:\n            best_a = int(ceil_a)\n            best_b = b\n\n    best_a, best_b = reduce_fraction(best_a, best_b)\n    print(f\"{best_a}/{best_b}\")\n\nif __name__ == \"__main__\":\n    run()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.6954811548639555e-06, 0.0, 0.0, -4.8397800128441304e-05, -1.490105023549404e-05, -0.06196761503815651, -0.0005617947317659855, -0.0024757706560194492, 0.0, -0.00010132275929208845, -0.5759670734405518, -0.053049635142087936, -0.001177332829684019, 0.0, -2.9802276912960224e-06, -0.20145952701568604, 0.0, -8.380061626667157e-05, -1.1920922133867862e-06, -0.829987108707428, -1.4516148567199707, -0.3450547158718109, -0.47120052576065063, -0.3077690303325653, -0.00025340684805996716, -1.2369695901870728, -0.3617391884326935, -0.00010656742961145937, -0.5791123509407043, 0.0, -0.3286970555782318, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.0012638922780752182, -1.0728830375228426e-06, -3.576278118089249e-07, -0.0151