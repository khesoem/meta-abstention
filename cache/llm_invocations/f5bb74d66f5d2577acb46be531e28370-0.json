ts[i][j];\n            if (get_match(1)) s+=bin[i-1];\n        }\n        (f[s]+=pro)%=MOD;\n        return;\n    }\n    ma[a[x]][y]=0;\n    if (y==n) dfs2(x+1,1,(LL)pro*(1-p[a[x]][y]+MOD)%MOD);\n    else dfs2(x,y+1,(LL)pro*(1-p[a[x]][y]+MOD)%MOD);\n    ma[a[x]][y]=1;\n    if (y==n) dfs2(x+1,1,(LL)pro*p[a[x]][y]%MOD);\n    else dfs2(x,y+1,(LL)pro*p[a[x]][y]%MOD);\n}\n\nvoid dfs1(int x,int y,int s) {\n    if (y==3) {\n        id[s]=++tot; sta[tot]=s;\n        for (int i=1;i<=3;++i) pts[tot][i]=a[i];\n        return;\n    }\n    if (x>n) return;\n    dfs1(x+1,y,s);\n    a[y+1]=x;\n    dfs1(x+1,y+1,s+bin[x-1]);\n}\n\nvoid pre() {\n    for (int i=0;i<tot;++i)\n        for (int j=0;j<bin[tot];++j)\n            if (j & bin[i]) (g[j]+=g[j^bin[i]])%=MOD;\n}\n\nint main() {\n    init();\n    dfs1(1,0,0);\n    a[1]=1; a[2]=2; a[3]=3;\n    dfs2(1,1,1);\n    for (int i=0;i<bin[tot];++i) {\n        int t=0;\n        for (int j=1;j<=tot;++j) {\n            int rev=id[bin[n]-1-sta[j]];\n            if (i & bin[j-1]) t+=bin[rev-1];\n        }\n        g[t]=f[i];\n        f[i]=0;\n    }\n    a[1]=4; a[2]=5; a[3]=6;\n    dfs2(1,1,1);\n    pre();\n    int ans=0;\n    for (int i=0;i<bin[tot];++i)\n        ans=(ans+(LL)f[i]*g[bin[tot]-1-i])%MOD;\n    printf(\"%d\\n\",(1-ans+MOD)%MOD);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\nN = 10\nM = 25\nS = 1048580  # 2^20 = 1048576, S is a bit larger, but we use up to 2^20, but we allocate size S\n# Actually we need bin size 21, but we use bin[tot] where tot <= 20, so 2^20 = 1048576, S is enough.\n# We'll allocate lists of size S for f and g.\n# But we also use bin up to 20, so bin size 21.\nbin = [0] * 21\np = [[0] * (N + 1) for _ in range(N + 1)]\nma = [[0] * (N + 1) for _ in range(N + 1)]\na = [0] * (N + 1)\nb = [0] * (N + 1)\nf = [0] * S\ng = [0] * S\ntot = 0\nid = [0] * 70\npts = [[0] * (N + 1) for _ in range(M + 1)]\nsta = [0] * (M + 1)\nvis = [0] * 4  # indices 1..3\n\ndef ksm(x, y):\n    ans = 1\n    while y:\n        if y & 1:\n            ans = (ans * x) % MOD\n        x = (x * x) % MOD\n        y >>= 1\n    return ans\n\ndef init():\n    global n, p, bin\n    bin[0] = 1\n    for i in range(1, 21):\n        bin[i] = bin[i-1] * 2\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    inv = ksm(100, MOD-2)\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            p[i][j] = next(it)\n            p[i][j] = (p[i][j] * inv) % MOD\n    while n < 6:\n        n += 1\n        p[n][n] = 1\n\ndef get_match(x):\n    if x > 3:\n        return 1\n    for i in range(1, 4):\n        if not vis[i] and ma[a[x]][b[i]]:\n            vis[i] = 1\n            flag = get_match(x+1)\n            vis[i] = 0\n            if flag:\n                return 1\n    return 0\n\ndef dfs2(x, y, pro):\n    if x > 3:\n        s = 0\n        for i in range(1, tot+1):\n            for j in range(1, 4):\n                b[j] = pts[i][j]\n            if get_match(1):\n                s += bin[i-1]\n        f[s] = (f[s] + pro) % MOD\n        return\n    ma[a[x]][y] = 0\n    if y == n:\n        dfs2(x+1, 1, (pro * (1 - p[a[x]][y] + MOD)) % MOD)\n    else:\n        dfs2(x, y+1, (pro * (1 - p[a[x]][y] + MOD)) % MOD)\n    ma[a[x]][y] = 1\n    if y == n:\n        dfs2(x+1, 1, (pro * p[a[x]][y]) % MOD)\n    else:\n        dfs2(x, y+1, (pro * p[a[x]][y]) % MOD)\n\ndef dfs1(x, y, s):\n    global tot\n    if y == 3:\n        tot += 1\n        id[s] = tot\n        sta[tot] = s\n        for i in range(1, 4):\n            pts[tot][i] = a[i]\n        return\n    if x > n:\n        return\n    dfs1(x+1, y, s)\n    a[y+1] = x\n    dfs1(x+1, y+1, s + bin[x-1])\n\ndef pre():\n    for i in range(tot):\n        for j in range(bin[tot]):\n            if j & bin[i]:\n                g[j] = (g[j] + g[j ^ bin[i]]) % MOD\n\ndef main():\n    global n, a, f, g, tot, id, sta, pts, ma, vis, b, bin, p\n    init()\n    dfs1(1, 0, 0)\n    a[1] = 1; a[2] = 2; a[3] = 3\n    dfs2(1, 1, 1)\n    for i in range(bin[tot]):\n        t = 0\n        for j in range(1, tot+1):\n            rev = id[bin[n] - 1 - sta[j]]\n            if i & bin[j-1]:\n                t += bin[rev-1]\n        g[t] = f[i]\n        f[i] = 0\n    a[1] = 4; a[2] = 5; a[3] = 6\n    dfs2(1, 1, 1)\n    pre()\n    ans = 0\n    for i in range(bin[tot]):\n        ans = (ans + f[i] * g[bin[tot] - 1 - i]) % MOD\n    print((1 - ans + MOD) % MOD)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -0.1269933581352234, -0.0002865380665753037, -5.006777428206988e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -2.622600959512056e-06, -1.1920928244535389e-07, -0.0015034097013995051, -8.463501580990851e-05, -9.65590606938349e-06, 0.0, -4.410734163684538e-06, -7.033323527139146e-06, -0.00023862851958256215, -2.8490614567999728e-05, -7.152555099310121e-07, -1.0371154530730564e-05, -2.95634672511369e-05, -0.04899002984166145, -0.0003980797773692757, -7.152555099310121e-07, -1.311301275563892e-06, -2.8490614567999728e-05, -4.4225667807040736e-05, -0.21909311413764954, -6.198863957251888e-06, -1.396760106086731, -0.08009622246026993, -0.033809203654527664, -0.0003233625029679388, -0.08822482824325562, -3.611976353568025e-05, -0.010176675394177437, -0.0004292996891308576, -0.0007414452848024666, -0.10533492267131805, -0.8649243712425232, -0.24215823411941528, -0.6104291081428528, -0.05480083078145981, -0.004398789722472429, -0.6033075451850891, -0.35592517256736755, -0.04588058963418007, -0.618068277835846, -0.9433215260505676, -5.006777428206988e-06, -0.1626797616481781, -0.1325846016407013, -0.0035409152042120695, -0.25266024470329285, -0.3615601658821106, -0.3924950659275055, -0.04041377827525139, -0.30642834305763245, -0.8820490837