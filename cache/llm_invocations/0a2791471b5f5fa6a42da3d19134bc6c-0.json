ge>[] graph, int s, int t) {\n            int flow = 0;\n            int[] level = new int[graph.length];\n            int[] it = new int[graph.length];\n            int INF = Integer.MAX_VALUE;\n\n            while (bfsLevel(graph, s, t, level)) {\n                Arrays.fill(it, 0);\n                while (true) {\n                    int f = dfsFlow(graph, s, t, INF, level, it);\n                    if (f == 0) break;\n                    flow += f;\n                }\n            }\n            return flow;\n        }\n\n        static boolean bfsLevel(List<Edge>[] graph, int s, int t, int[] level) {\n            Arrays.fill(level, -1);\n            Queue<Integer> q = new ArrayDeque<>();\n            q.add(s);\n            level[s] = 0;\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                for (Edge e : graph[u]) {\n                    if (e.cap > 0 && level[e.to] < 0) {\n                        level[e.to] = level[u] + 1;\n                        q.add(e.to);\n                    }\n                }\n            }\n            return level[t] >= 0;\n        }\n\n        static int dfsFlow(List<Edge>[] graph, int u, int t, int f, int[] level, int[] it) {\n            if (u == t) return f;\n            for (; it[u] < graph[u].size(); it[u]++) {\n                Edge e = graph[u].get(it[u]);\n                if (e.cap > 0 && level[u] + 1 == level[e.to]) {\n                    int d = dfsFlow(graph, e.to, t, Math.min(f, e.cap), level, it);\n                    if (d > 0) {\n                        e.cap -= d;\n                        graph[e.to].get(e.rev).cap += d;\n                        return d;\n                    }\n                }\n            }\n            return 0;\n        }\n    }\n\n    static class InputReader {\n        final InputStream is;\n        final byte[] buf = new byte[1024];\n        int pos;\n        int size;\n\n        public InputReader(InputStream is) {\n            this.is = is;\n        }\n\n   