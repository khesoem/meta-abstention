nt r = i / m;\n            int c = i % m;\n            if (((r + c) & 1) == 0) {\n                addEdge(graph, S, 2 + i, 1);\n                for (int j : g[i]) {\n                    addEdge(graph, 2 + i, 2 + v + j, 1);\n                }\n            } else {\n                addEdge(graph, 2 + v + i, T, 1);\n            }\n        }\n\n        int flow = maxFlow(graph, S, T);\n        cout << flow * 2 << endl;\n    } else {\n        long long res;\n        if (n == 1) {\n            res = m / 6 * 6;\n            if (m % 6 == 4) res += 2;\n            else if (m % 6 == 5) res += 4;\n        } else {\n            res = V;\n            res -= res % 2;\n        }\n        cout << res << endl;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.06334315985441208, -2.0146166207268834e-05, 0.0, -2.3841855067985307e-07, -0.0002627027570270002, -0.0003762729174923152, -1.1920922133867862e-06, -0.25194644927978516, -6.9141146923357155e-06, 0.0, 0.0, -5.006777428206988e-06, -1.311301275563892e-06, 0.0, 0.0, -2.1815061700181104e-05, -1.4305104514278355e-06, 0.0, 0.0, -0.006758686620742083, -3.2186455882765586e-06, 0.0, 0.0, -0.07954788208007812, -0.023256978020071983, -0.0001431601122021675, -6.198863957251888e-06, 0.0, -0.10027711093425751, -0.008688858710229397, -0.005234227981418371, 0.0, -0.04863570258021355, -4.875540980719961e-05, -0.3869289755821228, -1.3232143828645349e-05, -2.264974000354414e-06, 0.0, -1.1920922133867862e-06, -0.017653129994869232, -9.894321920000948e-06, -1.311301275563892e-06, -6.318072337307967e-06, 0.0, 0.0, -1.2993727978027891e-05, -1.1920928244535389e-07, -0.0024776733480393887, -3.6954811548639555e-06, -2.9802276912960224e-06, -0.0001234931987710297, 0.0, -0.001929447171278298, -0.0153220035135746, -0.005815728101879358, 0.0, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-0