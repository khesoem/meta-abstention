s import permutations\n            for perm in permutations(selected):\n                valid = True\n                for idx2 in range(len(perm)):\n                    bitPos = idx2 * n + perm[idx2]\n                    if not (mask & (1 << bitPos)):\n                        valid = False\n                        break\n                if valid:\n                    valid_found = True\n                    break\n            \n            if valid_found:\n                successMask |= (1 << m)\n                break\n        \n        prob[successMask] = (prob[successMask] + p) % MOD\n    \n    # Second part: process masks for the remaining h2 rows\n    for mask in range(1 << (n * h2)):\n        p = 1\n        for bit in range(n * h2):\n            row = bit // n + h\n            col = bit % n\n            if mask & (1 << bit):\n                p = (p * P[row][col] % MOD) * inv100 % MOD\n            else:\n                p = (p * (100 - P[row][col]) % MOD) * inv100 % MOD\n        \n        successMask = 0\n        for m in range(len(masks)):\n            selected = []\n            for k in range(n):\n                if not (masks[m] & (1 << k)):\n                    selected.append(k)\n            selected.sort()\n            valid_found = False\n            from itertools import permutations\n            for perm in permutations(selected):\n                valid = True\n                for idx2 in range(len(perm)):\n                    bitPos = idx2 * n + perm[idx2]\n                    if not (mask & (1 << bitPos)):\n                        valid = False\n                        break\n                if valid:\n                    valid_found = True\n                    break\n            \n            if valid_found:\n                successMask |= (1 << m)\n                break\n        \n        prob2[successMask] = (prob2[successMask] + p) % MOD\n    \n    numMasks = len(masks)\n    \n    # Sum over subsets for prob2\n    for i in range(1 << numMasks):\n  