in(){\n    LL n;\n    cin>>n;\n//    for(int i = 1; i <= n; i++) cout<<i<<\" \"<<process(i)<<endl;\n    cout<<process(n)<<endl;  \n//    system(\"PAUSE\");\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\ndef num(n: int) -> int:\n    cnt = 0\n    while n:\n        n //= 10\n        cnt += 1\n    return cnt\n\ndef find(n: int) -> int:\n    ex = num(n)\n    cur = 0\n    ad = 1\n    for _ in range(ex):\n        cur += ad\n        ad *= 10\n    if cur <= n:\n        return cur\n    return (cur - 1) // 10\n\ndef process(n: int) -> int:\n    if n <= 6:\n        return n\n    if n <= 11:\n        return 13 - n\n    tmp = find(n)\n    more = tmp * 10 + 1\n    if n % tmp == 0:\n        t = n // tmp\n        if n <= more // 2 + tmp:\n            return num(tmp) * t\n        else:\n            cur = process(more - n)\n            return num(more) + cur\n    else:\n        _m = (n // tmp) * tmp\n        # _M = (n // tmp + 1) * tmp  # not used\n        res = process(_m) + process(n - _m)\n        if n > more // 2:\n            res = min(process(_m) + process(n - _m), num(more) + process(more - n))\n        return res\n\ndef main():\n    n = int(input().strip())\n    print(process(n))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-5.364403477869928e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00016640232934150845, -0.4750491678714752, -6.544376083184034e-05, -0.005336681846529245, -0.47409117221832275, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.4305104514278355e-06, -1.4305104514278355e-06, -0.40701591968536377, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, 0.0, 0.0, -1.5258672647178173e-05, 0.0, -0.000436091679148376, 0.0, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 