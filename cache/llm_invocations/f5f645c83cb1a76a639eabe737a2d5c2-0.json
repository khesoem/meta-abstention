XN+1);\nvector<long long> factInvs(MAXN+1);\n\nlong long mul(long long a, long long b) {\n    return (a * b) % MOD;\n}\n\nlong long fastPow(long long base, long long exp) {\n    long long result = 1;\n    while (exp > 0) {\n        if (exp & 1) result = mul(result, base);\n        base = mul(base, base);\n        exp >>= 1;\n    }\n    return result;\n}\n\nvoid precomp() {\n    facts[0] = factInvs[0] = 1;\n    for (int i = 1; i <= MAXN; ++i) facts[i] = mul(facts[i-1], i);\n    factInvs[MAXN] = fastPow(facts[MAXN], MOD - 2);\n    for (int i = MAXN - 1; i >= 0; --i) factInvs[i] = mul(factInvs[i+1], i+1);\n}\n\nlong long nCk(int n, int k) {\n    if (k < 0 || k > n) return 0;\n    return mul(facts[n], mul(factInvs[k], factInvs[n-k]));\n}\n\nlong long powGo(int base, long long exp) {\n    long long sum = 0;\n    for (int sub = 0; sub < base; ++sub) {\n        long long delta = mul(fastPow(base - sub, exp), nCk(base, sub));\n        if (sub % 2 == 0) sum = (sum + delta) % MOD;\n        else sum = (sum + MOD - delta) % MOD;\n    }\n    return sum;\n}\n\nint main() {\n    precomp();\n    int n, k;\n    cin >> n >> k;\n    if (k == 0) {\n        cout << facts[n] << endl;\n        return 0;\n    }\n    if (k >= n) {\n        cout << 0 << endl;\n        return 0;\n    }\n    int nUsable = n - k;\n    long long assignWays = powGo(nUsable, n);\n    long long pickThese = nCk(n, nUsable);\n    long long ways = mul(assignWays, pickThese);\n    cout << mul(ways, 2) << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-4.410734163684538e-06, 0.0, 0.0, -0.00016008525562938303, -0.0002530493075028062, -4.291525328881107e-06, -0.029767543077468872, -1.2993727978027891e-05, -2.3841855067985307e-07, 0.0, -1.5497195136049413e-06, -0.011049983091652393, -0.014166152104735374, -1.1920928244535389e-07, -0.0608515702188015, -0.3869786858558655, -0.0789799690246582, -4.768360213347478e-06, 0.0, -0.2519352436065674, -0.10433833301067352, -0.00026