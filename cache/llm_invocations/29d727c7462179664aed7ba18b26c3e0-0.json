 x) return 0;\n            else x = b;\n        } else if (data[size - 1] != '_') {\n            int v = getDigit(size - 1);\n            if (v != b) return 0;\n        }\n        long res = 1;\n        for (int i = 0; i < size - 2; i++) {\n            if (i == 0) {\n                if (data[i] == 'X' && x == 0) return 0;\n                if (getDigit(0) == 0) return 0;\n            }\n            if (data[i] == '_') {\n                res *= (i == 0) ? 9 : 10;\n            } else if (data[i] == 'X') {\n                if (x != -1) continue;\n                x = 10;\n                res *= (i == 0) ? 9 : 10;\n            }\n        }\n        return (int) res;\n    }\n\n    private static int getDigit(int idx) {\n        char c = data[idx];\n        if (c == '_' || c == 'X') return -1;\n        return c - '0';\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <cctype>\n\nusing namespace std;\n\nvector<char> data;\nint size;\n\nint getDigit(int idx) {\n    char c = data[idx];\n    if (c == '_' || c == 'X') return -1;\n    return c - '0';\n}\n\nint solve(int a, int b) {\n    if (size == 2 && a == 0) return 0;\n    int x = -1;\n    if (data[size - 2] == 'X') {\n        x = a;\n    } else if (data[size - 2] != '_') {\n        int v = getDigit(size - 2);\n        if (v != a) return 0;\n    }\n    if (data[size - 1] == 'X') {\n        if (x != -1 && b != x) return 0;\n        else x = b;\n    } else if (data[size - 1] != '_') {\n        int v = getDigit(size - 1);\n        if (v != b) return 0;\n    }\n    long long res = 1;\n    for (int i = 0; i < size - 2; i++) {\n        if (i == 0) {\n            if (data[i] == 'X' && x == 0) return 0;\n            if (getDigit(0) == 0) return 0;\n        }\n        if (data[i] == '_') {\n            res *= (i == 0) ? 9 : 10;\n        } else if (data[i] == 'X') {\n            if (x != -1) continue;\n            x = 10;\n            res *= (i == 0) ? 9 : 10;\n        }\n    }\n    return (int)res;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    data.assign(line.begin(), line.end());\n    size = data.size();\n    int count = 0;\n    if (size == 1) {\n        char c = data[0];\n        if (c == 'X' || c == '_' || (c >= '0' && c <= '9' && c == '0')) count = 1;\n    } else {\n        count += solve(2, 5);\n        count += solve(5, 0);\n        count += solve(7, 5);\n        count += solve(0, 0);\n    }\n    cout << count << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012587709352374077, -1.311301275563892e-06, -2.3841855067985307e-07, -0.0017351347487419844, -7.152555099310121e-07, -5.364403477869928e-06, -3.576278118089249e-07, -2.3841830625315197e-06, -3.576278118089249e-07, -0.030278978869318962, -0.0004371640970930457, -0.0007101159426383674, -1.0728830375228426e-06, -0.20532114803791046, -0.25193071365356445, -0.38689175248146057, -8.22540732769994e-06, -0.04299934208393097, -3.4570634852570947e-06, -0.3132666051387787, -0.027566922828555107, -1.537788011773955e-05, -1.6689286894688848e-06, -8.344646857949556e-07, -0.8830505013465881, -0.001190787530504167, -3.4570634852570947e-06, -1.9073468138230965e-06, -4.0531076592742465e-06, -3.480850500636734e-05, -3.576272320060525e-06, -4.1483970562694594e-05, -0.00014685506175737828, -0.03364945948123932, -7.533743337262422e-05, -2.3841830625315197e-06, -2.264974000354414e-06, -0.0053643095307052135, -2.3841855067985307e-07, -1.6689286894688848e-06, -4.172316494077677e-06, 0.0, 0.0, -4.0531076592742465e-06, -3.576278118089249e-07, -7.033323527139146e-06, -8.344646857949556e-07, -3.576278118089249e-07, 0.0, -5.960462772236497e-07, 0.0, -1.9788545614574105e-05, -4.768370445162873e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.0847986231965479e-05