ist[t] >= INF:\n        return 0\n    df = INF\n    i = t\n    while i != s:\n        e = par[i]\n        df = min(df, cap[e] - flo[e])\n        i = ep[e]\n    i = t\n    while i != s:\n        e = par[i]\n        flo[e] += df\n        flo[e ^ 1] -= df\n        price += df * cost[e]\n        i = ep[e]\n    for i in range(n):\n        pot[i] = min(INF, dist[i] + pot[i])\n    return df\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    source = 0\n    sink = n * T + 1\n    init()\n\n    for _ in range(k):\n        a = int(next(it))\n        add_edge(source, a, 1, 0)\n\n    for t in range(T):\n        add_edge(1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost_edge = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                add_edge(a + (t - 1) * n, b + t * n, 1, cost_edge * d + c)\n                add_edge(b + (t - 1) * n, a + t * n, 1, cost_edge * d + c)\n\n    mcf_pot_init(N)\n    price = 0\n    flow = 0\n    while True:\n        df = mcf_update(source, sink, price, N)\n        if df == 0:\n            break\n        flow += df\n    if flow != k:\n        raise RuntimeError(\"flow mismatch\")\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-0.06239352375268936, -3.576278118089249e-07, -0.001505433232523501, -3.0874729418428615e-05, 0.0, -0.0181602630764246, -0.02842668630182743, -9.65590606938349e-06, -3.4570634852570947e-06, -4.291525328881107e-06, -0.038041528314352036, -3.564294092939235e-05, -0.06213802471756935, -1.680836794548668e-05, -0.0008110094931907952, -1.1920928244535389e-07, 0.0, -4.076874756719917e-05, -2.3841855067985307e-07, -