n    void mcf_pot_init(int n) {\n        memset(pot, 0, sizeof pot);\n        // all edge costs >= 0, so potentials stay zero\n    }\n\n    ll mcf_update(int s, int t, ll& price, int n) {\n        memset(vis, 0, sizeof vis);\n        fill(dist, dist + n, INF);\n        dist[s] = 0;\n        memset(inq, -1, sizeof inq);\n        int qs = 0;\n        inq[q[qs++] = s] = 0;\n        while (qs) {\n            int u = q[0];\n            inq[u] = -1;\n            q[0] = q[--qs];\n            if (qs) inq[q[0]] = 0;\n            for (int i = 0, j = 2*i + 1, t; j < qs; i = j, j = 2*i + 1) {\n                if (j + 1 < qs && dist[q[j+1]] < dist[q[j]]) ++j;\n                if (dist[q[j]] >= dist[q[i]]) break;\n                int tmp = q[i]; q[i] = q[j]; q[j] = tmp;\n                tmp = inq[q[i]]; inq[q[i]] = inq[q[j]]; inq[q[j]] = tmp;\n            }\n            if (vis[u]) continue;\n            vis[u] = 1;\n            for (int e = first[u]; e != -1; e = nxt[e]) {\n                int v = ep[e^1];\n                if (flo[e] < cap[e] && dist[v] > dist[u] + pot[u] - pot[v] + cost[e]) {\n                    dist[v] = dist[u] + pot[u] - pot[v] + cost[e];\n                    par[v] = e;\n                    if (inq[v] < 0) {\n                        inq[q[qs] = v] = qs;\n                        qs++;\n                    }\n                    for (int i = inq[v], j = (i-1)/2, t; dist[q[i]] < dist[q[j]]; i = j, j = (i-1)/2) {\n                        int tmp = q[i]; q[i] = q[j]; q[j] = tmp;\n                        tmp = inq[q[i]]; inq[q[i]] = inq[q[j]]; inq[q[j]] = tmp;\n                    }\n                }\n            }\n        }\n        if (dist[t] >= INF) return 0;\n        ll df = INF;\n        for (int e, i = t; i != s; i = ep[e]) {\n            e = par[i];\n            df = min(df, cap[e] - flo[e]);\n        }\n        for (int e, i = t; i != s; i = ep[e]) {\n            e = par[i];\n            flo[e] += df;\n            flo[e^1] -= df;\n            price +=