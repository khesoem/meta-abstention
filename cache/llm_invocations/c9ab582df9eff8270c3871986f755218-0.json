;\n            Arrays.fill(cap, 0);\n            cap[s] = INF_FLUJO;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            encola[s] = true;\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                encola[u] = false;\n                for (int idx : adj[u]) {\n                    Arista E = ars.get(idx);\n                    if (E.rem() > 0 && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                        dist[E.v] = dist[u] + E.cost;\n                        previo[E.v] = idx;\n                        cap[E.v] = Math.min(cap[u], E.rem());\n                        if (!encola[E.v]) {\n                            q.add(E.v);\n                            encola[E.v] = true;\n                        }\n                    }\n                }\n            }\n            if (previo[t] < 0) break;\n            flujomax += cap[t];\n            costomin += cap[t] * dist[t];\n            for (int v = t; v != s; v = ars.get(previo[v]).u) {\n                ars.get(previo[v]).flow += cap[t];\n                ars.get(previo[v] ^ 1).flow -= cap[t];\n            }\n        }\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        long m = sc.nextLong();\n        long k = sc.nextLong();\n        long c = sc.nextLong();\n        long d = sc.nextLong();\n        int MAXT = (int)(n + k);\n        if (DBG != 0) System.out.println(\"MAXT: \" + MAXT);\n\n        for (int i = 0; i < nodos; i++) {\n            adj[i] = new ArrayList<>();\n        }\n\n        int[] a = new int[(int)k];\n        for (int i = 0; i < k; i++) {\n            a[i] = sc.nextInt() - 1;\n            agregar(SRC, a[i] * MAXT, 1, 0);\n        }\n\n        for (int j = 0; j < MAXT; j++) {\n            agregar(j, SNC, k, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    agregar(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    agregar(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1));\n                }\n            }\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < MAXT - 1; j++) {\n                for (int K = 1; K <= k; K++) {\n                    agregar(i * MAXT + j, i * MAXT + j + 1, 1, c);\n                }\n            }\n        }\n\n        flujo(SRC, SNC);\n        if (DBG != 0) System.out.println(\"costomin: \" + costomin + \" flujomax: \" + flujomax);\n        System.out.println(costomin);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.622601e-06, 0.0, 0.0, -0.00014840455, -0.00034910307, -1.072883e-06, -0.029751342, -1.7015934, -0.00037341297, -4.0531077e-06, -2.883881, -0.20413613, -7.4979835e-05, -2.145765e-06, -0.004795123, -0.00056703703, -0.0034888848, -2.3841855e-07, -0.0069581815, -0.0069043157, -0.0067447145, -2.134556, -0.0001236124, -0.0037250195, -0.695495, -0.82776386, -2.264974e-06, -1.6093125e-05, -7.152555e-07, -9.727005e-05, -0.0018140303, -0.014165682, -0.0016135066, -2.8848232e-05, -0.032815404, -0.3134335, -0.00019965562, -0.00032074074, -4.5060096e-05, -7.7125434e-05, -0.001263178, -0.07890087, -1.5497195e-06, -3.921909e-05, -3.6715788e-05, -2.3841855e-07, -0.0001643761, -0.00010835537, -9.6435666e-05, -4.672895e-05, -5.6028207e-06, -1.3132645, -0.00033659037, -6.6158966e-05, -2.3841855e-07, -1.1563234e-05, -5.7220295e-06, 0.0, -5.9006856e-05, -5.960463e-07, -3.8146245e-05, -1.7404405e-05, -1.1920928e-07, -7.152555e-07, 0.0, -5.864925e-05, -5.1259863e-06, -0.0005658456, -0.000640783, -1.4305105e-06, -1.5497195e-06, 0.0