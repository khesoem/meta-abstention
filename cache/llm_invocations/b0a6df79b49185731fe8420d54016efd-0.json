          }\n            for (Edge &e : g[x]) {\n                if (e.cap >= cap && from[e.to] == -1) {\n                    from[e.to] = x;\n                    flow[e.to] = min(e.cap, flow[x]);\n                    bfs.push(e.to);\n                }\n            }\n        }\n    }\n    return result;\n}\n\nchar buf[20][20];\nint n,m,vn,tox[10][10];\n\nint main(){\n  ios::sync_with_stdio(0);\n  cin>>n>>m;\n\n  int res=0;\n  for (int i=0; i<n; i++)\n    for (int j=!(cin>>buf[i]); j<n; j++)\n      if (buf[i][j]>'0' and buf[i][j]<='9') add_edge(0,enc(i,j,0),buf[i][j]-'0');\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n  g.resize(vn);\n  from.resize(vn);\n  flow.resize(vn);\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            add_edge(enc(i,j,t),enc(x,y,t+1),1000);\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          add_edge(enc(i,j,t),enc(i,j,m),buf[i][j]-'0');\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        add_edge(enc(i,j,m),1,buf[i][j]-'0');\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev, cap;\n        Edge(int to, int rev, int cap) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n        }\n    }\n\n    static ArrayList<ArrayList<Edge>> g;\n    static int[] from, flow;\n    static char[][] buf;\n    static int n, m, vn;\n    static int[][] tox;\n    static final int[] dx = {-1, 0, 1, 0};\n    static final int[] dy = {0, -1, 0, 1};\n\n    static int enc(int x, int y, int t) {\n        return (x * n + y) * (m + 1) + t + 2;\n    }\n\n    static void add_edge(int from, int to, int cap) {\n        g.get(from).add(new Edge(to, g.get(to).size(), cap));\n        g.get(to).add(new Edge(from, g.get(from).size() - 1, 0));\n    }\n\n    static int aug(int s, int t, int cap) {\n        int result = 0;\n        while (true) {\n            Arrays.fill(from, -1);\n            from[s] = s;\n            flow[s] = cap;\n            Queue<Integer> bfs = new LinkedList<>();\n            bfs.add(s);\n            boolean found = false;\n            while (!bfs.isEmpty()) {\n                int x = bfs.poll();\n                if (x == t) {\n                    int augFlow = flow[t];\n                    for (int v = t; v != s; v = from[v]) {\n                        int u = from[v];\n                        for (Edge e : g.get(u)) {\n                            if (e.to == v) {\n                                e.cap -= augFlow;\n                                break;\n                            }\n                        }\n                        for (Edge e : g.get(v)) {\n                            if (e.to == u) {\n                                e.cap += augFlow;\n                                break;\n                            }\n                        }\n                    }\n                    result += augFlow;\n                    found = true;\n                    break;\n                }\n                for (Edge e : g.get(x)) {\n                    if (e.cap >= cap && from[e.to] == -1) {\n                        from[e.to] = x;\n                        flow[e.to] = Math.min(e.cap, flow[x]);\n                        bfs.add(e.to);\n                    }\n                }\n            }\n            if (!found) break;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        sc.nextLine(); // consume newline\n\n        // First grid: read n lines and add edges from source (0) to enc(i,j,0)\n        for (int i = 0; i < n; i++) {\n            String line = sc.next();\n            for (int j = 0; j < n; j++) {\n                char c = line.charAt(j);\n                if (c > '0' && c <= '9') {\n                    add_edge(0, enc(i, j, 0), c - '0');\n                }\n            }\n        }\n\n        // Second grid: read n lines into buf\n        buf = new char[n][n];\n        for (int i = 0; i < n; i++) {\n            String line = sc.next();\n            for (int j = 0; j < n; j++) {\n                buf[i][j] = line.charAt(j);\n            }\n        }\n\n        // BFS to compute tox (distance to nearest 'Z')\n        tox = new int[n][n];\n        Queue<int[]> bfs = new LinkedList<>();\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (buf[i][j] == 'Z') {\n                    tox[i][j] = 0;\n                    bfs.add(new int[]{i, j});\n                } else {\n                    tox[i][j] = m + 1;\n                }\n            }\n        }\n\n        while (!bfs.isEmpty()) {\n            int[] cur = bfs.poll();\n            int t = tox[cur[0]][cur[1]];\n            for (int d = 0; d < 4; d++) {\n                int x = cur[0] + dx[d];\n                int y = cur[1] + dy[d];\n                if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y' && t + 1 < tox[x][y]) {\n                    tox[x][y] = t + 1;\n                    bfs.add(new int[]{x, y});\n                }\n            }\n        }\n\n        vn = enc(n - 1, n - 1, m) + 1;\n        g = new ArrayList<>(vn);\n        for (int i = 0; i < vn; i++) g.add(new ArrayList<>());\n        from = new int[vn];\n        flow = new int[vn];\n\n        // Build graph\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                for (int t = 0; t < m; t++) {\n                    for (int d = 0; d < 4; d++) {\n                        int x = i + dx[d];\n                        int y = j + dy[d];\n                        if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y') {\n                            int extra = (buf[x][y] > '0' && buf[x][y] <= '9') ? 1 : 0;\n                            if (t + 1 < tox[x][y] + extra && t < tox[i][j]) {\n                                add_edge(enc(i, j, t), enc(x, y, t + 1), 1000);\n                            }\n                        }\n                    }\n                    if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                        add_edge(enc(i, j, t), enc(i, j, m), buf[i][j] - '0');\n                    }\n                }\n                if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                    add_edge(enc(i, j, m), 1, buf[i][j] - '0');\n                }\n            }\n        }\n\n        int res = 0;\n        for (int u = 8; u > 0; u /= 2) {\n            res += aug(0, 1, u);\n        }\n        System.out.println(res);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.03013717755675316, -1.3232143828645349e-05, 0.0, 0.0, -0.0001209901092806831, -0.0006785474251955748, 0.0, -1.2993727978027891e-05, -0.06353525817394257, -0.0009317824151366949, -2.3841855067985307e-07, -2.5