in at_positions:\n        # Build candidate with this \"at\" as '@'\n        candidate = \"\"\n        i = 0\n        while i < len(line):\n            if i == at_idx:\n                candidate += \"@\"\n                i += 2\n            elif i < len(line) - 2 and line[i:i+3] == \"dot\":\n                candidate += \".\"\n                i += 3\n            else:\n                candidate += line[i]\n                i += 1\n        \n        if is_valid_email(candidate):\n            candidates.append(candidate)\n    \n    # Also consider: what if there are multiple \"at\" and we need to be careful?\n    # The problem says exactly one '@' in the final address, so we must replace exactly one \"at\" with \"@\"\n    \n    if candidates:\n        # Sort by length first, then lexicographically\n        candidates.sort(key=lambda x: (len(x), x))\n        return candidates[0]\n    \n    # If no valid candidate found, try to handle edge cases\n    # Maybe the input doesn't have \"at\" at all? But problem says email has exactly one '@'\n    # So input must contain at least one \"at\"\n    \n    # Fallback: just replace first \"at\" with \"@\" and all \"dot\" with \".\"\n    # But this might be invalid, so we need to handle it\n    candidate = \"\"\n    i = 0\n    first_at_found = False\n    while i < len(line):\n        if not first_at_found and i < len(line) - 1 and line[i:i+2] == \"at\":\n            candidate += \"@\"\n            first_at_found = True\n            i += 2\n        elif i < len(line) - 2 and line[i:i+3] == \"dot\":\n            candidate += \".\"\n            i += 3\n        else:\n            candidate += line[i]\n            i += 1\n    \n    return candidate\n\nprint solve()\n</repaired_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-5.960462772236497e-07, -0.0009762050467543304, -1.0728830375228426e-06, -5.960462772236497e-07, -0.09912551939487457, -6.913899414939806e-05, -0.009765706956386566, -0.09579753875732422, 0.0, -7.1525550