    static int s = N - 2;\n    static int t = N - 1;\n\n    static int rem(int x) {\n        return e.get(x).c - e.get(x).f;\n    }\n\n    static void pushFlow() {\n        Arrays.fill(d, INF64);\n        Arrays.fill(p, -1);\n        Arrays.fill(pe, -1);\n        Arrays.fill(inq, 0);\n        d[s] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.add(s);\n        inq[s] = 1;\n        while (!q.isEmpty()) {\n            int k = q.poll();\n            inq[k] = 0;\n            for (int x : g[k]) {\n                if (rem(x) == 0) continue;\n                int c = e.get(x).cost;\n                int y = e.get(x).y;\n                if (d[y] > d[k] + c) {\n                    d[y] = d[k] + c;\n                    p[y] = k;\n                    pe[y] = x;\n                    if (inq[y] == 0) {\n                        inq[y] = 1;\n                        q.add(y);\n                    }\n                }\n            }\n        }\n        int cur = t;\n        while (cur != s) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = p[cur];\n        }\n        ans += d[t];\n    }\n\n    static void addEdge(int x, int y, int c, int cost) {\n        g[x].add(e.size());\n        e.add(new Edge(y, c, 0, cost));\n        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        for (int i = 0; i < N; i++) {\n            g[i] = new ArrayList<>();\n        }\n        int n = scanner.nextInt();\n        int m = scanner.nextInt();\n        int k = scanner.nextInt();\n        int c = scanner.nextInt();\n        int d = scanner.nextInt();\n        for (int i = 0; i < k; i++) {\n            int x = scanner.nextInt();\n            x--;\n            addEdge(s, x, 1, 0);\n        }\n        int tt = 101;\n        for (int i = 0; i < tt; i++) {\n            addEdge(0 + i * n, t, k, i * c);\n        }\n        for (int i