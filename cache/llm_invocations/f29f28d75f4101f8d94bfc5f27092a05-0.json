 0; --i) suf[0][i] = A[0][i] * suf[0][i+1];\n        return;\n    }\n    build(level - 1);\n    A[level][0] = suf[level-1][0];\n    for (int j = 1; j < K; ++j)\n        A[level][j] = suf[level-1][j] * sum[level-1][j-1];\n    sum[level][0] = A[level][0];\n    for (int j = 1; j < K; ++j) sum[level][j] = sum[level][j-1] * A[level][j];\n    suf[level][K-1] = A[level][K-1];\n    for (int j = K-2; j >= 0; --j) suf[level][j] = A[level][j] * suf[level][j+1];\n}\n\nvoid process(int idx, int &last) {\n    if (idx < 0) return;\n    for (int j = 0; j < dig[idx]; ++j)\n        ans = ans * A[idx][(j + last) % K];\n    last += dig[idx];\n    process(idx - 1, last);\n}\n\nint main() {\n    scanf(\"%lld%lld\", &N, &K);\n    while (N) { dig[cnt++] = N % K; N /= K; }\n    build(cnt - 1);\n    ans.A[0][K] = 1; ans.N = K;\n    ans = ans * sum[cnt-1][dig[cnt-1] - 1];\n    int last = dig[cnt-1];\n    process(cnt - 2, last);\n    LL res = 0;\n    for (int i = 0; i <= K; ++i) res += ans.A[0][i];\n    printf(\"%lld\\n\", res % MOD);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef mat_mul(A, B, N):\n    \"\"\"Multiply two (N+1)x(N+1) matrices modulo MOD.\"\"\"\n    C = [[0] * (N + 1) for _ in range(N + 1)]\n    for i in range(N + 1):\n        for k in range(N + 1):\n            aik = A[i][k]\n            if aik == 0:\n                continue\n            for j in range(N + 1):\n                C[i][j] = (C[i][j] + aik * B[k][j]) % MOD\n    return C\n\ndef copy_matrix(mat):\n    \"\"\"Deep copy a matrix.\"\"\"\n    return [row[:] for row in mat]\n\ndef build(level):\n    global A, sum_mat, suf, K\n    if level == 0:\n        for i in range(K):\n            mat = [[0] * (K + 1) for _ in range(K + 1)]\n            for j in range(K + 1):\n                mat[j][j] = 1\n                mat[j][i] = 1\n            A[0][i] = mat\n        sum_mat[0][0] = copy_matrix(A[0][0])\n        for i in range(1, K):\n            sum_mat[0][i] = mat_mul(sum_mat[0][i - 1], A[0][i], K)\n        suf[0][K - 1] = copy_matrix(A[0][K - 1])\n        for i in range(K - 2, -1, -1):\n            suf[0][i] = mat_mul(A[0][i], suf[0][i + 1], K)\n        return\n    build(level - 1)\n    A[level][0] = copy_matrix(suf[level - 1][0])\n    for j in range(1, K):\n        A[level][j] = mat_mul(suf[level - 1][j], sum_mat[level - 1][j - 1], K)\n    sum_mat[level][0] = copy_matrix(A[level][0])\n    for j in range(1, K):\n        sum_mat[level][j] = mat_mul(sum_mat[level][j - 1], A[level][j], K)\n    suf[level][K - 1] = copy_matrix(A[level][K - 1])\n    for j in range(K - 2, -1, -1):\n        suf[level][j] = mat_mul(A[level][j], suf[level][j + 1], K)\n\ndef process(idx, last):\n    global ans, dig, A, K\n    if idx < 0:\n        return last\n    for j in range(dig[idx]):\n        ans = mat_mul(ans, A[idx][(j + last) % K], K)\n    last += dig[idx]\n    return process(idx - 1, last)\n\ndef main():\n    global N, K, dig, cnt, ans, A, sum_mat, suf\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n    dig = []\n    temp = N\n    while temp:\n        dig.append(temp % K)\n        temp //= K\n    cnt = len(dig)\n    # Initialize arrays for levels and digits\n    max_level = cnt\n    A = [[None] * K for _ in range(max_level)]\n    sum_mat = [[None] * K for _ in range(max_level)]\n    suf = [[None] * K for _ in range(max_level)]\n    build(cnt - 1)\n    # Initialize ans as a row vector (first row)\n    ans = [[0] * (K + 1) for _ in range(K + 1)]\n    ans[0][K] = 1\n    ans = mat_mul(ans, sum_mat[cnt - 1][dig[cnt - 1] - 1], K)\n    last = dig[cnt - 1]\n    last = process(cnt - 2, last)\n    res = sum(ans[0][i] for i in range(K + 1)) % MOD\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_