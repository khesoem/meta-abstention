{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nusing ll = long long;\n\nconst int MAX_LG = 18;\nconst int MAX_N = (1 << MAX_LG) + 10;\nconst int MOD_BASE = 1000000007;\n\nint mod;\nint N, orig_n;\nint dp[MAX_N][MAX_LG + 3];\nint buf1[MAX_LG + 3];\nint buf2[MAX_LG + 3];\nint fact[MAX_N];\nint inv_fact[MAX_N];\n\nint mod_exp(int b, int e) {\n    int res = 1;\n    while (e) {\n        if (e & 1) res = (ll)res * b % mod;\n        b = (ll)b * b % mod;\n        e >>= 1;\n    }\n    return res;\n}\n\nvoid add_poly(int *a, const int *b) {\n    for (int i = 0; i <= N; ++i) {\n        a[i] = (a[i] + b[i]) % mod;\n        if (a[i] < 0) a[i] += mod;\n    }\n}\n\nvoid sub_poly(int *a, const int *b) {\n    for (int i = 0; i <= N; ++i) {\n        a[i] = (a[i] - b[i]) % mod;\n        if (a[i] < 0) a[i] += mod;\n    }\n}\n\nvoid mul_poly(int *res, const int *a, const int *b) {\n    memset(buf1, 0, sizeof(buf1));\n    for (int i = 0; i <= N; ++i) {\n        for (int j = 0; j <= i; ++j) {\n            buf1[i] = (buf1[i] + (ll)a[j] * b[i - j]) % mod;\n        }\n    }\n    memcpy(res, buf1, sizeof(buf1));\n}\n\nvoid zeta_transform(int table[][MAX_LG + 3]) {\n    for (int pos = 0; pos < N; ++pos) {\n        for (int mask = orig_n; mask >= 0; --mask) {\n            if (mask & (1 << pos)) {\n                add_poly(table[mask], table[mask ^ (1 << pos)]);\n            }\n        }\n    }\n}\n\nvoid mobius_transform(int table[][MAX_LG + 3]) {\n    for (int pos = 0; pos < N; ++pos) {\n        for (int mask = orig_n; mask >= 0; --mask) {\n            if (mask & (1 << pos)) {\n                sub_poly(table[mask], table[mask ^ (1 << pos)]);\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int K;\n    cin >> orig_n >> K >> mod;\n\n    int total = mod_exp(K, orig_n);\n    if (orig_n % 2 == 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n\n    N = __builtin_popcount(orig_n);\n    vector<int> bits;\n    for (int i = 0; i < MAX_LG; ++i) {\n        if (orig_n & (1 << i)) bits.push_back(i);\n    }\n\n    int n_mask = (1 << N) - 1;\n\n    fact[0] = 1;\n    for (int i = 1; i < MAX_N; ++i) fact[i] = (ll)i * fact[i - 1] % mod;\n\n    inv_fact[MAX_N - 1] = mod_exp(fact[MAX_N - 1], mod - 2);\n    for (int i = MAX_N - 2; i >= 0; --i)\n        inv_fact[i] = (ll)(i + 1) * inv_fact[i + 1] % mod;\n\n    for (int mask = 0; mask <= n_mask; ++mask) {\n        int real_val = 0;\n        for (int j = 0; j < N; ++j) {\n            if (mask & (1 << j)) real_val += 1 << bits[j];\n        }\n        dp[mask][__builtin_popcount(mask)] = inv_fact[real_val];\n    }\n\n    zeta_transform(dp);\n\n    for (int mask = 0; mask <= n_mask; ++mask) {\n        int k = K;\n        memset(buf2, 0, sizeof(buf2));\n        buf2[0] = 1;\n\n        while (k) {\n            if (k & 1) mul_poly(buf2, buf2, dp[mask]);\n            mul_poly(dp[mask], dp[mask], dp[mask]);\n            k >>= 1;\n        }\n        memcpy(dp[mask], buf2, sizeof(buf2));\n    }\n\n    mobius_transform(dp);\n\n    int final_val = (ll)dp[n_mask][N] * fact[orig_n] % mod;\n    int answer = (total - final_val) % mod;\n    if (answer < 0) answer += mod;\n\n    cout << answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport copy\n\ndef mod_exp(b, e, mod):\n    res = 1\n    while e:\n        if e & 1:\n            res = (res * b) % mod\n        b = (b * b) % mod\n        e >>= 1\n    return res\n\ndef add_poly(a, b, mod):\n    for i in range(len(a)):\n        a[i] = (a[i] + b[i]) % mod\n        if a[i] < 0:\n            a[i] += mod\n\ndef sub_poly(a, b, mod):\n    for i in range(len(a)):\n        a[i] = (a[i] - b[i]) % mod\n        if a[i] < 0:\n            a[i] += mod\n\ndef mul_poly(a, b, mod, max_deg):\n    buf1 = [0] * (max_deg + 3)\n    for i in range(len(a)):\n        for j in range(i + 1):\n            buf1[i] = (buf1[i] + a[j] * b[i - j]) % mod\n    return buf1[:max_deg + 3]\n\ndef zeta_transform(table, N, orig_n, mod):\n    for pos in range(N):\n        for mask in range(orig_n, -1, -1):\n            if mask & (1 << pos):\n                add_poly(table[mask], table[mask ^ (1 << pos)], mod)\n\ndef mobius_transform(table, N, orig_n, mod):\n    for pos in range(N):\n        for mask in range(orig_n, -1, -1):\n            if mask & (1 << pos):\n                sub_poly(table[mask], table[mask ^ (1 << pos)], mod)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    orig_n = int(data[0])\n    K = int(data[1])\n    mod = int(data[2])\n    \n    total = mod_exp(K, orig_n, mod)\n    if orig_n % 2 == 1:\n        print(total)\n        return\n\n    # Calculate N = number of set bits in orig_n\n    N = bin(orig_n).count('1')\n    \n    # Get the positions of set bits\n    bits = []\n    for i in range(18):  # MAX_LG = 18\n        if orig_n & (1 << i):\n            bits.append(i)\n    \n    n_mask = (1 << N) - 1\n    \n    # Precompute factorials and inverse factorials\n    MAX_N = (1 << 18) + 10\n    fact = [1] * MAX_N\n    for i in range(1, MAX_N):\n        fact[i] = (i * fact[i-1]) % mod\n    \n    inv_fact = [1] * MAX_N\n    inv_fact[MAX_N-1] = mod_exp(fact[MAX_N-1], mod-2, mod)\n    for i in range(MAX_N-2, -1, -1):\n        inv_fact[i] = ((i+1) * inv_fact[i+1]) % mod\n    \n    # Initialize dp table\n    MAX_LG = 18\n    dp = [[0] * (MAX_LG + 3) for _ in range(n_mask + 1)]\n    \n    for mask in range(n_mask + 1):\n        real_val = 0\n        for j in range(N):\n            if mask & (1 << j):\n                real_val += 1 << bits[j]\n        popcount = bin(mask).count('1')\n        dp[mask][popcount] = inv_fact[real_val]\n    \n    # Zeta transform\n    zeta_transform(dp, N, n_mask, mod)\n    \n    # Polynomial exponentiation\n    for mask in range(n_mask + 1):\n        k = K\n        buf2 = [0] * (MAX_LG + 3)\n        buf2[0] = 1\n        \n        while k:\n            if k & 1:\n                buf2 = mul_poly(buf2, dp[mask], mod, MAX_LG)\n            dp[mask] = mul_poly(dp[mask], dp[mask], mod, MAX_LG)\n            k >>= 1\n        \n        dp[mask] = buf2\n    \n    # Mobius transform\n    mobius_transform(dp, N, n_mask, mod)\n    \n    final_val = (dp[n_mask][N] * fact[orig_n]) % mod\n    answer = (total - final_val) % mod\n    if answer < 0:\n        answer += mod\n    \n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00018165845540352166, -8.344646857949556e-07, -5.960462772236497e-07, -0.033482544124126434, -0.00012134769349358976, -0.5232110023498535, -0.15336324274539948, -0.47692209482192993, -0.00011920218821614981, -0.16551904380321503, -0.021146433427929878, -0.0002022777043748647, -0.00033861625706776977, -3.6954811548639555e-06, -4.768370445162873e-07, -4.6132929128361866e-05, -2.0265373677830212e-05, -0.000215507170651