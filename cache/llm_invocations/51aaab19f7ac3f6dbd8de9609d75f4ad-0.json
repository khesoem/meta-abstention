(long[] input) {\n            for (int i = 0; i < input.length; i++) {\n                coefficients[i] = input[i];\n            }\n        }\n\n        long[] evaluate(boolean isForward) {\n            return performDFT(0, 1, isForward);\n        }\n\n        private long[] performDFT(int offset, int stride, boolean forward) {\n            if (stride == N) {\n                return new long[]{coefficients[offset]};\n            }\n            long[] evenPart = performDFT(offset, stride << 1, forward);\n            long[] oddPart = performDFT(offset + stride, stride << 1, forward);\n            int halfSize = evenPart.length;\n            long[] combined = new long[halfSize << 1];\n            for (int i = 0; i < halfSize; i++) {\n                long twiddle = forward ? W_POWERS[i * stride] : W_INV_POWERS[i * stride];\n                combined[i] = (evenPart[i] + twiddle * oddPart[i]) % MOD;\n            }\n            for (int i = 0; i < halfSize; i++) {\n                long twiddle = forward ? W_POWERS[i * stride] : W_INV_POWERS[i * stride];\n                combined[halfSize + i] = ((evenPart[i] - twiddle * oddPart[i]) % MOD + MOD) % MOD;\n            }\n            return combined;\n        }\n    }\n\n    long[] computeDFT(long[] input) {\n        long[] output = new long[N];\n        long wPower = 1;\n        for (int i = 0; i < N; i++) {\n            long x = 1;\n            for (int j = 0; j < input.length; j++) {\n                output[i] = (output[i] + input[j] * x) % MOD;\n                x = x * wPower % MOD;\n            }\n            wPower = wPower * W % MOD;\n        }\n        return output;\n    }\n\n    long[] powerPolynomial(long[] arr, int exponent) {\n        for (int i = 0; i < arr.length; i++) {\n            arr[i] = modularExponentiate(arr[i], exponent);\n        }\n        return arr;\n    }\n\n    long modularExponentiate(long base, int exp) {\n        if (exp == 0) return 1;\n        if ((exp & 1) == 1) return modularExponentiate(base