\n            \n            return combined\n\n    def __init__(self):\n        self.input_reader = None\n        self.output_writer = sys.stdout\n        self.use_std_io = True\n        self.tokenizer = None\n\n    def compute_dft(self, input_list):\n        output = [0] * FFT.N\n        w_power = 1\n        for i in range(FFT.N):\n            x = 1\n            for j in range(len(input_list)):\n                output[i] = (output[i] + input_list[j] * x) % FFT.MOD\n                x = (x * w_power) % FFT.MOD\n            w_power = (w_power * FFT.W) % FFT.MOD\n        return output\n\n    def power_polynomial(self, arr, exponent):\n        for i in range(len(arr)):\n            arr[i] = self.modular_exponentiate(arr[i], exponent)\n        return arr\n\n    def modular_exponentiate(self, base, exp):\n        if exp == 0:\n            return 1\n        if exp & 1:\n            return (self.modular_exponentiate(base, exp - 1) * base) % FFT.MOD\n        half = self.modular_exponentiate(base, exp >> 1)\n        return (half * half) % FFT.MOD\n\n    def execute(self):\n        n = self.read_int()\n        k = self.read_int()\n        poly = [0] * 10\n        for _ in range(k):\n            idx = self.read_int()\n            if idx < len(poly):\n                poly[idx] = 1\n        transformed = self.compute_dft(poly)\n        transformed = self.power_polynomial(transformed, n // 2)\n        buffer = self.Polynomial(transformed)\n        transformed = buffer.evaluate(False)\n        for i in range(len(transformed)):\n            transformed[i] = (transformed[i] * FFT.N_INVERSE) % FFT.MOD\n        result = 0\n        for coefficient in transformed:\n            result = (result + coefficient * coefficient) % FFT.MOD\n        self.output_writer.write(str(result) + \"\\n\")\n\n    def configure(self):\n        try:\n            self.input_reader = sys.stdin\n            self.execute()\n        except Exception as e:\n            print(e, file=sys.stderr)\n\n    def read_int