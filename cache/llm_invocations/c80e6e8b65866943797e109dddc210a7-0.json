 i % P\n    inv = [0] * (n + 1)\n    inv[1] = 1\n    for i in range(2, n + 1):\n        inv[i] = (P - P // i) * inv[P % i] % P\n\ndef fpow(f, n, k):\n    global P, inv\n    t = f[:]  # copy\n    f[0] = (1 - f[0]) % P\n    g = [0] * n\n    for i in range(1, n):\n        f[i] = 0\n        g[i] = 0\n        for j in range(1, i):\n            f[i] = (f[i] + f[i - j] * g[j]) % P\n            g[i] = (g[i] + t[i - j] * g[j]) % P\n        f[i] = (f[i] - g[i]) % P\n        f[i] = (t[i] + f[i] * inv[i] % P) * k % P\n        g[i] = (t[i] - g[i] * inv[i] % P) * i % P\n\ndef FMT(f, n):\n    global P\n    l = 1\n    while l < n:\n        for i in range(0, n, l * 2):\n            for j in range(l):\n                f[i + j + l] = (f[i + j + l] + f[i + j]) % P\n        l <<= 1\n\ndef IFMT(f, n):\n    global P\n    l = 1\n    while l < n:\n        for i in range(0, n, l * 2):\n            for j in range(l):\n                f[i + j + l] = (f[i + j + l] - f[i + j]) % P\n        l <<= 1\n\ndef main():\n    global P\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    P = int(data[2])\n    ans = pow(k, n, P)\n    if n % 2 == 0:\n        m = n.bit_length()\n        size = 1 << m\n        init(size)\n        f = [[0] * size for _ in range(m + 1)]\n        for i in range(size):\n            pop = bin(i).count('1')\n            f[pop][i] = ifac[i]\n        for pop in range(m + 1):\n            FMT(f[pop], size)\n        for i in range(n + 1):\n            F = [f[j][i] for j in range(m + 1)]\n            fpow(F, m + 1, k)\n            for j in range(m + 1):\n                f[j][i] = F[j]\n        IFMT(f[bin(n).count('1')], size)\n        ans = (P + ans - f[bin(n).count('1')][n] * fac[n] % P) % P\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0728830375228426e-06, 0.0, 0.0, -0.00016139635408762842, -0.10024292767047882, 0.0, -8.546940