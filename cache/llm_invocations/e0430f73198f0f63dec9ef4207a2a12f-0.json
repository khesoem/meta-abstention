 m = Integer.parseInt(line1[1]);\n        \n        String[] line2 = br.readLine().split(\" \");\n        long[] a = new long[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = Long.parseLong(line2[i]);\n        }\n        \n        List<Long> a1 = new ArrayList<>();\n        List<Long> a2 = new ArrayList<>();\n        int n1 = n / 2;\n        \n        sums1(a, a1, 0, 0, n1, m);\n        sums2(a, a2, n1, 0, n, m);\n        \n        long ans = 0;\n        \n        Collections.sort(a1);\n        a1 = new ArrayList<>(new LinkedHashSet<>(a1)); // Remove duplicates while preserving order\n        \n        for (long i : a2) {\n            int j = Collections.binarySearch(a1, m - i);\n            if (j < 0) {\n                j = -j - 1;\n            }\n            if (j > 0) {\n                long candidate = a1.get(j - 1) + i;\n                if (ans < candidate) {\n                    ans = candidate;\n                }\n            }\n        }\n        \n        System.out.println(ans);\n    }\n    \n    static void sums1(long[] a, List<Long> result, int i, long sum, int n1, int m) {\n        if (i == n1) {\n            result.add(sum % m);\n        } else {\n            sums1(a, result, i + 1, (sum + a[i]) % m, n1, m);\n            sums1(a, result, i + 1, sum, n1, m);\n        }\n    }\n    \n    static void sums2(long[] a, List<Long> result, int i, long sum, int n, int m) {\n        if (i == n) {\n            result.add(sum % m);\n        } else {\n            sums2(a, result, i + 1, (sum + a[i]) % m, n, m);\n            sums2(a, result, i + 1, sum, n, m);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001591317413840443, -1.4305104514278355e-06, -2.3841855067985307e-07, -4.0411134250462055e-05, -1.3828182090946939e-05, -0.04858948662877083, -0.42920926213264465, -0.005265297368168831, -2.4914430468925275e-05, -0.0001720042055239901, -0.0009005781612358987, -0.0001113352773245424, -1.66892868946