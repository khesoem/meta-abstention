\"%d\",&p);\n    adl(S,P(0,p),1,0);\n  }for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&s[i*2].f,&s[i*2].t);\n    s[i*2-1]=(Data){s[i*2].t,s[i*2].f};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      adl(P(t-1,i),P(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      adl(P(t-1,s[i].f),P(t,s[i].t),1,D);\n      pl[t][i]=tl;st[t][i]=1;\n    }adl(P(t,1),T,INF,t*C);\n  }\n  int sav,cans=0;\n  while(sav=spfa()){\n    int u=T;\n    while(u!=S){\n      int las=pre[u];\n      g[lp[u]].c-=sav;\n      g[lp[u]^1].c+=sav;\n      u=las;\n    }cans+=dis[T]*sav;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (g[pl[t][i]].c){\n          st[t][i]++;\n          adl(P(t-1,s[i].f),P(t,s[i].t),1,D*(st[t][i]*2-1));\n          pl[t][i]=tl;\n        }\n  }printf(\"%d\\n\",cans);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn = int(input())\nm = int(input())\nk = int(input())\nC = int(input())\nD = int(input())\n\nMaxn = 5500\nMaxm = 35500\nINF = 1000000000\n\nclass Line:\n    def __init__(self, nxt, t, c, l):\n        self.nxt = nxt\n        self.t = t\n        self.c = c\n        self.l = l\n\ng = [Line(0,0,0,0) for _ in range(Maxm)]\nfir = [0]*(Maxn)\ntl = 1\n\ndef adl(f, t, c, cost):\n    global tl\n    tl +=1\n    g[tl] = Line(fir[f], t, c, cost)\n    fir[f] = tl\n    tl +=1\n    g[tl] = Line(fir[t], f, 0, -cost)\n    fir[t] = tl\n\nS = (n + k) * n + 1\nT = S + 2\n\n# Initialize adjacency list and flow\nimport sys\nsys.setrecursionlimit(10**7)\n\ndis = [0]*(Maxn)\nflow = [0]*(Maxn)\npre = [0]*(Maxn)\nlp = [0]*(Maxn)\ninq = [False]*(Maxn)\nfrom collections import deque\n\ndef spfa():\n    for i in range(1, T+1):\n        dis[i] = INF\n        flow[i] = 0\n    flow[S] = INF\n    dis[S] = 0\n    q = deque([S])\n    inq[S] = True\n    while q:\n        u = q.popleft()\n        inq[u] = False\n        i = fir[u]\n       