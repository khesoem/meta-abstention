 queue<int> q;\n        q.push(src);\n\n        while (!q.empty()) {\n            int node = q.front();\n            q.pop();\n            visited[node] = false;\n\n            for (int eid : adj[node]) {\n                Edge &e = edge_list[eid];\n                if (e.cap > e.flow && dist_arr[e.to] > dist_arr[node] + e.cost) {\n                    dist_arr[e.to] = dist_arr[node] + e.cost;\n                    parent_edge[e.to] = eid;\n                    bottleneck[e.to] = min(bottleneck[node], e.cap - e.flow);\n\n                    if (!visited[e.to]) {\n                        q.push(e.to);\n                        visited[e.to] = true;\n                    }\n                }\n            }\n        }\n\n        if (dist_arr[dst] == BIG) return false;\n\n        flow = bottleneck[dst];\n        cost_per_unit = dist_arr[dst];\n        int cur = dst;\n        while (cur != src) {\n            edge_list[parent_edge[cur]].flow += bottleneck[dst];\n            edge_list[parent_edge[cur] ^ 1].flow -= bottleneck[dst];\n            cur = edge_list[parent_edge[cur]].from;\n        }\n        return true;\n    }\n\n    pair<lint, lint> solve(int source, int destination) {\n        src = source;\n        dst = destination;\n        lint total_flow = 0;\n        lint min_cost = 0;\n        lint f, c;\n\n        while (shortest_path(f, c)) {\n            total_flow += f;\n            min_cost += f * c;\n        }\n        return {total_flow, min_cost};\n    }\n};\n\nint main() {\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MinCostMaxFlow g(n * MAX_T + 2);\n    int src_node = n * MAX_T;\n    int dst_node = n * MAX_T + 1;\n\n    for (int t = 0; t < MAX_T; ++t)\n        g.connect(t, dst_node, k, C * t);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        g.connect(src_node, x * MAX_T, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int t = 1; t < MAX_T; ++t)\n            g.connect(i * MAX_T + t - 1, i * MAX_T + t, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u, --v;\n\n        for (int t = 1; t < MAX_T; ++t) {\n            int edge1_from = u * MAX_T + t - 1;\n            int edge1_to   = v * MAX_T + t;\n            int edge2_from = v * MAX_T + t - 1;\n            int edge2_to   = u * MAX_T + t;\n\n            for (int idx = 1, price = D; idx <= k; ++idx, price += 2 * D) {\n                g.connect(edge1_from, edge1_to, 1, price);\n                g.connect(edge2_from, edge2_to, 1, price);\n            }\n        }\n    }\n\n    pair<lint, lint> ans = g.solve(src_node, dst_node);\n    cout << ans.second << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAX_N = 5005\nBIG = 1000000007\nMAX_T = 100\n\nclass Edge:\n    __slots__ = ('from_node', 'to', 'cap', 'flow', 'cost')\n    def __init__(self, from_node, to, cap, flow, cost):\n        self.from_node = from_node\n        self.to = to\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nclass MinCostMaxFlow:\n    def __init__(self, total_nodes):\n        self.num_nodes = total_nodes\n        self.num_edges = 0\n        self.adj = [[] for _ in range(total_nodes)]\n        self.edge_list = []\n        self.src = 0\n        self.dst = 0\n\n    def connect(self, u, v, capacity, weight):\n        self.edge_list.append(Edge(u, v, capacity, 0, weight))\n        self.edge_list.append(Edge(v, u, 0, 0, -weight))\n        idx = len(self.edge_list)\n        self.adj[u].append(idx - 2)\n        self.adj[v].append(idx - 1)\n\n    def shortest_path(self):\n        dist_arr = [BIG] * self.num_nodes\n        visited = [False] * self.num_nodes\n        parent_edge = [-1] * self.num_nodes\n        bottleneck = [0] * self.num_nodes\n        \n        dist_arr[self.src] = 0\n        visited[self.src] =