ples": [{"content": "<original_code>\nimport java.io.*;\r\nimport java.util\r\n\r\npublic class Codeforces\r\n{\r\n    public static void main(String args[])throws Exception\r\n    {\r\n        BufferedReader bu=new BufferedReader(new InputStreamReader(System.in));\r\n        StringBuilder sb=new StringBuilder();\r\n        String s[]=bu.readLine().split(\" \");\r\n        int n=Integer.parseInt(s[0]);\r\n        int i; double p=Double.parseDouble(s[1]);\r\n\r\n        for(i=0;i<=n;i++)\r\n        if(probab(n,i)>=p) break;\r\n        System.out.println(i);\r\n    }\r\n\r\n    static int ncr(int n,int r)\r\n    {\r\n        if(r>n) return 0;\r\n        int ans=1,i;\r\n        for(i=n;i>n-r;i--) ans*=i;\r\n        for(i=2;i<=r;i++) ans/=i;\r\n        return ans;\r\n    }\r\n\r\n    static double probab(int n,int x)\r\n    {\r\n        int a=ncr(x,3)*ncr(n-x,0);\r\n        int b=ncr(x,2)*ncr(n-x,1);\r\n        int c=ncr(x,1)*ncr(n-x,2);\r\n        return 1.0*((3.0/6)*c+a+b)/ncr(n,3);\r\n    }\r\n}\n</original_code>\n\n<translated_code>\nimport math\n\ndef ncr(n, r):\n    if r > n:\n        return 0\n    ans = 1\n    for i in range(n, n - r, -1):\n        ans *= i\n    for i in range(2, r + 1):\n        ans //= i\n    return ans\n\ndef probab(n, x):\n    a = ncr(x, 3) * ncr(n - x, 0)\n    b = ncr(x, 2) * ncr(n - x, 1)\n    c = ncr(x, 1) * ncr(n - x, 2)\n    return ((3.0 / 6) * c + a + b) / ncr(n, 3)\n\ndef main():\n    s = input().split()\n    n = int(s[0])\n    p = float(s[1])\n    i = 0\n    while True:\n        if probab(n, i) >= p:\n            break\n        i += 1\n    print(i)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.1440652459859848, -5.817582496092655e-05, -0.05919273942708969, -0.14995025098323822, -0.01360570453107357, -0.001608054619282484, -0.8235295414924622, -8.798032649792731e-05, -2.0265784769435413e-05, -6.377900717779994e-05, -0.5419703722000122, -0.002035661833360791,