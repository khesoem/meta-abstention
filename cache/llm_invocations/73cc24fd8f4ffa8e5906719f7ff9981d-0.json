                    Edge &e=adj[u][i];\n                    if(e.cap<=e.f) continue;\n                    int v=e.to;\n                    int nd=d+e.cost+pot[u]-pot[v];\n                    if(prio[v]>nd) {\n                        prio[v]=nd;\n                        q.push({nd,v});\n                        prevnode[v]=u;\n                        prevedge[v]=i;\n                        curflow[v]=min(curflow[u], e.cap-e.f);\n                    }\n                }\n            }\n            if(prio[t]==INT_MAX) break;\n            for(int i=0;i<n;++i) pot[i]+=prio[i];\n            int df=min(curflow[t], INF-flow);\n            flow+=df;\n            for(int v=t; v!=s; v=prevnode[v]) {\n                Edge &e=adj[prevnode[v]][prevedge[v]];\n                e.f+=df;\n                adj[v][e.rev].f-=df;\n                flowCost+=df*e.cost;\n            }\n        }\n        return {flow, flowCost};\n    }\n};\n\nint main(){\n    int n,m,k,c,d;\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    MCF nt(6+107*n);\n    for(int _=0;_<k;++_) {\n        int x; scanf(\"%d\",&x); --x;\n        nt.addEdge(0,1+x,1,0);\n    }\n    for(int _=0;_<m;++_) {\n        int x,y; scanf(\"%d%d\",&x,&y); --x; --y;\n        for(int i=0;i<105;++i) {\n            for(int j=0;j<51;++j) {\n                nt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n                nt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n            }\n        }\n    }\n    for(int i=0;i<105;++i)\n        for(int j=0;j<n;++j)\n            nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n    for(int i=0;i<105;++i)\n        nt.addEdge(1+i*n,1+105*n,51,0);\n    auto ans=nt.minCostFlow(0,1+105*n);\n    printf(\"%d\\n\",ans.second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, f, cap, cost, rev;\n        Edge(int to, int f, int cap, int cost, int rev) {\n            this.to = to;\n            this.f = f;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static class MCF {\n        int n;\n        ArrayList<ArrayList<Edge>> adj;\n        int[] prio, curflow, prevedge, prevnode, pot;\n\n        MCF(int n) {\n            this.n = n;\n            adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n            prio = new int[n];\n            curflow = new int[n];\n            prevedge = new int[n];\n            prevnode = new int[n];\n            pot = new int[n];\n        }\n\n        void addEdge(int s, int t, int cap, int cost) {\n            Edge a = new Edge(t, 0, cap, cost, adj.get(t).size());\n            Edge b = new Edge(s, 0, 0, -cost, adj.get(s).size());\n            adj.get(s).add(a);\n            adj.get(t).add(b);\n        }\n\n        int[] minCostFlow(int s, int t) {\n            int flow = 0, flowCost = 0;\n            int INF = Integer.MAX_VALUE / 2; // large but not overflow when adding\n            while (flow < INF) {\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                Arrays.fill(prio, Integer.MAX_VALUE);\n                prio[s] = 0;\n                curflow[s] = Integer.MAX_VALUE;\n                pq.offer(new int[]{0, s});\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int d = cur[0], u = cur[1];\n                    if (d != prio[u]) continue;\n                    for (int i = 0; i < adj.get(u).size(); i++) {\n                        Edge e = adj.get(u).get(i);\n                        if (e.cap <= e.f) continue;\n                        int v = e.to;\n                        int nd = d + e.cost + pot[u] - pot[v];\n                        if (prio[v] > nd) {\n                            prio[v] = nd;\n                   