{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\nusing vi = vector<int>;\nusing vvi = vector<vi>;\n\nmt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());\n\nconst ll INF = 1e18;\nconst int MAX_N = 1001;\n\nint dx[4] = {0, 0, -1, 1};\nint dy[4] = {-1, 1, 0, 0};\n\nvector<int> adj[MAX_N];\nbool visited[MAX_N];\nint match[MAX_N];\n\nbool in_bounds(int x, int y, const vector<string>& grid) {\n    return x >= 0 && y >= 0 && x < (int)grid.size() && y < (int)grid.size() && grid[x][y] != 'Y' && grid[x][y] != 'Z';\n}\n\nvvi bfs_search(int sx, int sy, const vector<string>& grid) {\n    int n = grid.size();\n    vvi dist(n, vi(n, INF));\n    deque<pii> dq;\n    dist[sx][sy] = 0;\n    dq.emplace_back(sx, sy);\n\n    while (!dq.empty()) {\n        auto [x, y] = dq.front();\n        dq.pop_front();\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (!in_bounds(nx, ny, grid) || dist[nx][ny] != INF) continue;\n            dist[nx][ny] = dist[x][y] + 1;\n            dq.emplace_back(nx, ny);\n        }\n    }\n    return dist;\n}\n\nvoid input_handling() {\n    int N, T;\n    cin >> N >> T;\n    vector<string> g1(N), g2(N);\n    for (int i = 0; i < N; ++i) cin >> g1[i];\n    for (int i = 0; i < N; ++i) cin >> g2[i];\n\n    int rx = -1, ry = -1;\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (g1[i][j] == 'Z') rx = i, ry = j;\n        }\n    }\n\n    auto dist_from_reactor = bfs_search(rx, ry, g1);\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (!in_bounds(i, j, g1)) continue;\n            auto dist_from_source = bfs_search(i, j, g1);\n\n            for (int x = 0; x < N; ++x) {\n                for (int y = 0; y < N; ++y) {\n                    if (!in_bounds(x, y, g1) ||\n                        dist_from_source[x][y] > T ||\n                        dist_from_source[x][y] > dist_from_reactor[x][y])\n                        continue;\n\n                    if (dist_from_source[x][y] == dist_from_reactor[x][y]) {\n                        bool can_escape = false;\n                        for (int d = 0; d < 4; ++d) {\n                            int nx = x + dx[d], ny = y + dy[d];\n                            if (!in_bounds(nx, ny, g1) ||\n                                dist_from_source[nx][ny] >= dist_from_reactor[nx][ny])\n                                continue;\n                            can_escape = true;\n                        }\n                        if (!can_escape) continue;\n                    }\n\n                    int c1 = g1[i][j] - '0';\n                    int c2 = g2[x][y] - '0';\n                    for (int u = 1; u <= c1; ++u) {\n                        for (int v = 1; v <= c2; ++v) {\n                            adj[100 * i + 10 * j + u].push_back(100 * x + 10 * y + v);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\nbool augment(int u) {\n    if (visited[u]) return false;\n    visited[u] = true;\n    for (int v : adj[u]) {\n        if (!match[v] || augment(match[v])) {\n            match[v] = u;\n            return true;\n        }\n    }\n    return false;\n}\n\nvoid compute_matching() {\n    input_handling();\n    int max_nodes = 1000;\n    int matching_size = 0;\n    for (int i = 0; i < max_nodes; ++i) {\n        fill(visited, visited + max_nodes, false);\n        if (augment(i)) ++matching_size;\n    }\n    cout << matching_size << '\\n';\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    compute_matching();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    idx = 0\n    N = int(input_data[idx]); idx += 1\n    T = int(input_data[idx]); idx += 1\n    \n    g1 = []\n    g2 = []\n    for i in range(N):\n        g1.append(input_data[idx]); idx += 1\n    for i in range(N):\n        g2.append(input_data[idx]); idx += 1\n\n    # Find reactor position\n    rx, ry = -1, -1\n    for i in range(N):\n        for j in range(N):\n            if g1[i][j] == 'Z':\n                rx, ry = i, j\n\n    INF = 10**18\n    MAX_N = 1001\n\n    dx = [0, 0, -1, 1]\n    dy = [-1, 1, 0, 0]\n\n    def in_bounds(x, y, grid):\n        return (x >= 0 and y >= 0 and \n                x < len(grid) and y < len(grid[0]) and \n                grid[x][y] != 'Y' and grid[x][y] != 'Z')\n\n    def bfs_search(sx, sy, grid):\n        n = len(grid)\n        dist = [[INF] * n for _ in range(n)]\n        dq = deque()\n        dist[sx][sy] = 0\n        dq.append((sx, sy))\n\n        while dq:\n            x, y = dq.popleft()\n            for d in range(4):\n                nx, ny = x + dx[d], y + dy[d]\n                if not in_bounds(nx, ny, grid) or dist[nx][ny] != INF:\n                    continue\n                dist[nx][ny] = dist[x][y] + 1\n                dq.append((nx, ny))\n        return dist\n\n    dist_from_reactor = bfs_search(rx, ry, g1)\n\n    # Build adjacency list\n    adj = [[] for _ in range(MAX_N * MAX_N * 10)]  # Sufficiently large\n\n    for i in range(N):\n        for j in range(N):\n            if not in_bounds(i, j, g1):\n                continue\n            dist_from_source = bfs_search(i, j, g1)\n\n            for x in range(N):\n                for y in range(N):\n                    if not in_bounds(x, y, g1):\n                        continue\n                    if dist_from_source[x][y] > T:\n                        continue\n                    if dist_from_source[x][y] > dist_from_reactor[x][y]:\n                        continue\n\n                    if dist_from_source[x][y] == dist_from_reactor[x][y]:\n                        can_escape = False\n                        for d in range(4):\n                            nx, ny = x + dx[d], y + dy[d]\n                            if not in_bounds(nx, ny, g1):\n                                continue\n                            if dist_from_source[nx][ny] >= dist_from_reactor[nx][ny]:\n                                continue\n                            can_escape = True\n                            break\n                        if not can_escape:\n                            continue\n\n                    c1 = ord(g1[i][j]) - ord('0')\n                    c2 = ord(g2[x][y]) - ord('0')\n                    for u in range(1, c1 + 1):\n                        for v in range(1, c2 + 1):\n                            node1 = 100 * i + 10 * j + u\n                            node2 = 100 * x + 10 * y + v\n                            adj[node1].append(node2)\n\n    # Hungarian algorithm for bipartite matching\n    visited = [False] * MAX_N * MAX_N * 10\n    match = [0] * MAX_N * MAX_N * 10\n\n    def augment(u):\n        if visited[u]:\n            return False\n        visited[u] = True\n        for v in adj[u]:\n            if match[v] == 0 or augment(match[v]):\n                match[v] = u\n                return True\n        return False\n\n    matching_size = 0\n    max_nodes = 1000\n    for i in range(max_nodes):\n        visited = [False] * (MAX_N * MAX_N * 10)\n        if augment(i):\n            matching_size += 1\n\n    print(matching_size)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0001787979417713359, -8.344646857949556e-07, -1.1920928244535389e-07, -0.021042434498667717, -0.0010446811793372035, -1.1920922133867862e-06, -0.007641134783625603, -7.998623186722398e-05, -1.0728830375228426e-06, -1.2874520507466514e-05, -0.06999336183071136, -0.5873560905456543, -0.2943771481513977, -8.928377064876258e-05, -7.152555099310121e-07, -0.48894786834716797, -0.19901444017887115, -4.172316494077677e-06, -0.0025301130954176188, -9.775113539944869e-06, -9.405170567333698e-05, -0.0006644901586696506, -0.16024065017700195, -0.5653671622276306, -1.311301275563892e-06, -0.5214734077453613, -1.3947389561508317e-05, -2.0265558760002023e-06, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -0.018176183104515076, -0.05732632055878639, -1.5497195136049413e-06, -0.39543524384498596, -1.9073468138230965e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -1.4305104514278355e-06, -7.033323527139146e-06, -9.679325739853084e-05, -4.5536911784438416e-05, -4.768370445162873e-07, -3.576278118089249e-07, 0.0, -3.576278118089249e-07, -0.06207304447889328, -2.992108420585282e-05, -1.0728830375228426e-06, 0.0, 0.0, -2.3841830625315197e-06, -2.861018856492592e-06, 0.0, -3.6954811548639555e-06, -1.1920858014491387e-05, -1.4305104514278355e-06, -1.311301275563892e-06, -2.145764938177308e-06, -0.00019643761334009469, -2.50339189733495e-06, -6.318072337307967e-06, -2.3841855067985307e-07, -1.5497195136049413e-06, -0.126970574259758, 0.0, -0.0006300