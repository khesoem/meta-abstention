nt[]> que = new LinkedList<>();\n        vis[A * n + B] = 0;\n        que.add(new int[]{A, B});\n        while (!que.isEmpty()) {\n            int[] now = que.poll();\n            int p = now[0] * n + now[1];\n            int dis = vis[p];\n            if (check && (mat[bi * n + bj][p] <= dis || t <= dis)) {\n                if (mat[bi * n + bj][p] < dis || t < dis) vis[p] = INF + 1;\n                continue;\n            }\n            for (int d = 0; d < 4; d++) {\n                int i = dir[d][0] + now[0];\n                int j = dir[d][1] + now[1];\n                if (i < 0 || j < 0 || i == n || j == n) continue;\n                if (b[i][j] < '0' || b[i][j] > '9') continue;\n                int q = i * n + j;\n                if (vis[q] != INF) continue;\n                vis[q] = dis + 1;\n                que.add(new int[]{i, j});\n            }\n        }\n    }\n\n    static void build() {\n        int totalNodes = 2 + 2 * n * n;\n        cap = new int[totalNodes][totalNodes];\n        flow = new int[totalNodes][totalNodes];\n        pre = new int[totalNodes];\n        que = new int[totalNodes];\n        d = new int[totalNodes];\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (b[i][j] <= '0' || b[i][j] > '9') continue;\n                ca.add(i);\n                cb.add(j);\n                int p = i * n + j;\n                cap[p + 2 + n * n][1] = b[i][j] - '0';\n            }\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (a[i][j] <= '0' || a[i][j] > '9') continue;\n                int p = i * n + j;\n                cap[0][p + 2] = a[i][j] - '0';\n                for (int k = 0; k < ca.size(); k++) {\n                    int ii = ca.get(k);\n                    int jj = cb.get(k);\n                    int q = ii * n + jj;\n                    if (mat[p][q] < INF) {\n                        cap[p + 2][q + 2 + n * n] = INF;\n                    }\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        t = sc.nextInt();\n        a = new char[n][n];\n        b = new char[n][n];\n        mat = new int[n * n][n * n];\n        for (int[] row : mat) Arrays.fill(row, INF);\n\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            a[i] = s.toCharArray();\n        }\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            b[i] = s.toCharArray();\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (a[i][j] == 'Z') {\n                    bi = i;\n                    bj = j;\n                }\n            }\n        }\n\n        solve(bi, bj, mat[bi * n + bj], false);\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (a[i][j] >= '1' && a[i][j] <= '9') {\n                    solve(i, j, mat[i * n + j], true);\n                }\n            }\n        }\n        build();\n        System.out.println(edmondsKarp(2 + 2 * n * n, 0, 1));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.007023881655186415, -9.536738616588991e-07, 0.0, 0.0, -7.164221460698172e-05, -0.0002195594133809209, 0.0, -6.198863957251888e-06, -0.11610114574432373, -0.00010132275929208845, -1.1920928244535389e-07, -0.01917235367000103, -0.003184250323101878, -3.6954195820726454e-05, -0.0012824652949348092, -0.6931818723678589, -0.32821327447891235, -3.576278118089249e-07, -0.04859868437051773, 0.0, 0.0, -0.0024818354286253452, -3.576278118089249e-07, -0.0001012035645544529, -0.01934085786342621, -0.00043072958942502737, -6.318072337307967e-06, -2.2053474822314456e-05, -0.0060407682321965694, -0.0005584587925113738, -0.25245532393455505, -3.576278118089249e-07, -0.0005432083853520453, 0.0, -1.4305104514278