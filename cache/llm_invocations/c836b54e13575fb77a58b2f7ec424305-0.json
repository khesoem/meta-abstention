     last_known = self.invFactorial.size() - 1\n            if last_known < n:\n                f_inv = [0] * (n - last_known)\n                f_inv[0] = self.inv(self.fact(n))\n                for i in range(1, len(f_inv)):\n                    f_inv[i] = self.mult(f_inv[i - 1], n - i + 1)\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(f_inv[i])\n            return self.invFactorial.get(n)\n\n        def paritySign(self, k):\n            return 1 if (k & 1) == 0 else self.modulus() - 1\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def div(self, a, b):\n            return self.mult(a, self.inv(b))\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g %= r\n                g, r = r, g\n                x -= q * y\n                x, y = y, x\n            if g != 1:\n                raise AssertionError()\n            if y == self.modulus() or y == -self.modulus():\n                pass\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n\n    def solve(self, testNumber, in_reader, out_writer):\n        n = in_reader.nextInt()\n        m = in_reader.nextInt()\n\n        self.mod.fInv(n + m)\n\n        phaseSize = 1\n        p = 1\n        for i in range(n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, n - i, self.mod.smallInv(n + m - i))\n            phaseSize = self.mod.add(phaseSize, p)\n\n        answer = 0\n        for k in range(1, n + 1):\n            sign = self.mod.paritySign(k + 1)\n            numPhases = self.mod.div(m + k, k)\n            term = self.mod.mult(sign, self.mod.ncr(n, k), numPhases, phaseSize)\n            answer = self.mod.add(answer, term)\n\n        out_writer.println(answer)\n\n\ndef main():\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out_writer = PrintWriter(outputStream)\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out_writer)\n    out_writer.close()\n\n\nclass PrintWriter:\n    def __init__(self, stream):\n        self.stream = stream\n\n    def println(self, obj):\n        self.stream.write(str(obj) + '\\n')\n        self.stream.flush()\n\n    def close(self):\n        self.stream.flush()\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.280832192511298e-05, -1.0728830375228426e-06, -4.768370445162873e-07, -0.0008868813747540116, -0.02661414071917534, -0.009164766408503056, -0.22546981275081635, -0.22120867669582367, -0.007690819911658764, -0.03861665353178978, -0.7321274876594543, -1.9073468138230965e-06, -3.576272320060525e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -0.0005432083853520453, -1.311301275563892e-06, -3.576278118089249e-07, -3.576272320060525e-06, -2.3841855067985307e-07, -2.3364747903542593e-05, -9.059865078597795e-06, -1.6689286894688848e-06, -3.8265450