{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\nusing namespace std;\n\nstruct Edge {\n    int to, rev;\n    int cap;\n};\n\nvector<vector<Edge>> g;\nvector<int> from, flow;\n\ninline int enc(int x,int y,int t){\n  return (x*n + y)*(m+1) + t + 2;\n}\n\nvoid add_edge(int from, int to, int cap) {\n    g[from].push_back({to, (int)g[to].size(), cap});\n    g[to].push_back({from, (int)g[from].size()-1, 0});\n}\n\nint aug(int s, int t, int cap) {\n    int result = 0;\n    for (int aug = 1; aug--;) {\n        from.assign(g.size(), -1);\n        from[s] = s;\n        flow[s] = cap;\n        queue<int> bfs;\n        bfs.push(s);\n        while (!bfs.empty()) {\n            int x = bfs.front(); bfs.pop();\n            if (x == t) {\n                for (aug = 1; x != s; x = from[x]) {\n                    int u = from[x];\n                    for (Edge &e : g[u]) if (e.to == x) { e.cap -= flow[t]; break; }\n                    for (Edge &e : g[x]) if (e.to == u) { e.cap += flow[t]; break; }\n                }\n                result += flow[t];\n                break;\n            }\n            for (Edge &e : g[x]) {\n                if (e.cap >= cap && from[e.to] == -1) {\n                    from[e.to] = x;\n                    flow[e.to] = min(e.cap, flow[x]);\n                    bfs.push(e.to);\n                }\n            }\n        }\n    }\n    return result;\n}\n\nchar buf[20][20];\nint n,m,vn,tox[10][10];\n\nint main(){\n  ios::sync_with_stdio(0);\n  cin>>n>>m;\n\n  int res=0;\n  for (int i=0; i<n; i++)\n    for (int j=!(cin>>buf[i]); j<n; j++)\n      if (buf[i][j]>'0' and buf[i][j]<='9') add_edge(0,enc(i,j,0),buf[i][j]-'0');\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n  g.resize(vn);\n  from.resize(vn);\n  flow.resize(vn);\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            add_edge(enc(i,j,t),enc(x,y,t+1),1000);\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          add_edge(enc(i,j,t),enc(i,j,m),buf[i][j]-'0');\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        add_edge(enc(i,j,m),1,buf[i][j]-'0');\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef enc(x, y, t, n, m):\n    return (x * n + y) * (m + 1) + t + 2\n\ndef add_edge(g, fr, to, cap):\n    g[fr].append([to, len(g[to]), cap])\n    g[to].append([fr, len(g[fr]) - 1, 0])\n\ndef aug(g, s, t, cap, n, m):\n    result = 0\n    while True:\n        from_ = [-1] * len(g)\n        flow = [0] * len(g)\n        from_[s] = s\n        flow[s] = cap\n        q = deque([s])\n        found = False\n        while q:\n            x = q.popleft()\n            if x == t:\n                # augment\n                aug_flow = flow[t]\n                while x != s:\n                    u = from_[x]\n                    for e in g[u]:\n                        if e[0] == x:\n                            e[2] -= aug_flow\n                            break\n                    for e in g[x]:\n                        if e[0] == u:\n                            e[2] += aug_flow\n                            break\n                    x = u\n                result += aug_flow\n                found = True\n                break\n            for e in g[x]:\n                if e[2] >= cap and from_[e[0]] == -1:\n                    from_[e[0]] = x\n                    flow[e[0]] = min(e[2], flow[x])\n                    q.append(e[0])\n        if not found:\n            break\n    return result\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first_line = data[0].split()\n    n = int(first_line[0])\n    m = int(first_line[1])\n    # read first n lines (grid with digits)\n    buf1 = []\n    idx = 1\n    for i in range(n):\n        buf1.append(data[idx].strip())\n        idx += 1\n    # read next n lines (grid with Z, Y, etc.)\n    buf2 = []\n    for i in range(n):\n        buf2.append(data[idx].strip())\n        idx += 1\n\n    # Build graph\n    vn = enc(n-1, n-1, m, n, m) + 1\n    g = [[] for _ in range(vn)]\n    from_ = [0] * vn\n    flow = [0] * vn\n\n    # Add edges from source to digit cells at time 0\n    for i in range(n):\n        for j in range(n):\n            if '1' <= buf1[i][j] <= '9':\n                add_edge(g, 0, enc(i, j, 0, n, m), int(buf1[i][j]))\n\n    # BFS to compute distances from 'Z' in buf2\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n    tox = [[m+1]*n for _ in range(n)]\n    q = deque()\n    for i in range(n):\n        for j in range(n):\n            if buf2[i][j] == 'Z':\n                tox[i][j] = 0\n                q.append((i, j))\n    while q:\n        i, j = q.popleft()\n        t = tox[i][j]\n        for d in range(4):\n            x = i + dx[d]\n            y = j + dy[d]\n            if 0 <= x < n and 0 <= y < n and buf2[x][y] != 'Y' and t+1 < tox[x][y]:\n                tox[x][y] = t+1\n                q.append((x, y))\n\n    # Build edges for time steps\n    for i in range(n):\n        for j in range(n):\n            for t in range(m):\n                # edges to neighbors\n                for d in range(4):\n                    x = i + dx[d]\n                    y = j + dy[d]\n                    if 0 <= x < n and 0 <= y < n and buf2[x][y] != 'Y':\n                        # condition: t+1 < tox[x][y] + (1 if digit else 0) and t < tox[i][j]\n                        digit_extra = 1 if '1' <= buf2[x][y] <= '9' else 0\n                        if t+1 < tox[x][y] + digit_extra and t < tox[i][j]:\n                            add_edge(g, enc(i, j, t, n, m), enc(x, y, t+1, n, m), 1000)\n                # edges to sink (time m) if digit\n                if '1' <= buf1[i][j] <= '9':\n                    add_edge(g, enc(i, j, t, n, m), enc(i, j, m, n, m), int(buf1[i][j]))\n            # final edges from time m to sink\n            if '1' <= buf1[i][j] <= '9':\n                add_edge(g, enc(i, j, m, n, m), 1, int(buf1[i][j]))\n\n    # Capacity scaling\n    res = 0\n    u = 8\n    while u:\n        res += aug(g, 0, 1, u, n, m)\n        u //= 2\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.986990567587782e-06, 0.0, 0.0, -0.00019524575327523053, -0.0032285728957504034, -1.1920928244535389e-07, -0.038054611533880234, -0.0004397855664137751, -9.941560711013153e-05, 0.0, -8.344646857949556e-07, -0.00023314618738368154, -0.009290912188589573, -0.11811792850494385, -1.1324817933200393e-05, -0.00041237910045310855, 0.0, -2.3841855067985307e-07, -3.3378546504536644e-06, -0.4741021990776062, -5.924526340095326e-05, -4.541770613286644e-05, -8.344646857949556e-07, -9.65590606938349e-06, -9.536738616588991e-07, -0.25284984707832336, -0.0031798535492271185, -0.00020525732543319464, -0.0009116546134464443, -9.536738616588991e-07, 0.0, 0.0, -2.145764938177308e-06, 0.0, 0.0, -3.576278118089249e-07, -2.861018856492592e-06, -1.1920928244535389e-07, -9.536738616588991e-07, 0.0, 0.0, 0.0, -1.5497195136049413e-06, 0.0, -1.1920928244535389e-07, -0.00012742661056108773, -5.1616290875244886e-05, -7.247662142617628e-05, -3.576278118089249e-07, -0.003250911831855774, -2.0265558760002023e-06, -0.27248096466064453, -4.768370445162873e-07, -3.576278118089249e-07, -1.7881377516459906e-06, -1.1920922133867862e-06, -4.410734163684538e-06, -1.1920928244535389e-07, -0.0037944952491670847, -9.536738616588991e-07, 0.0, -2.3841855067985307e-07, 0.0, -0.0007252446957863867, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, 0.0, -1.311301275563892e-06, 0.0, -4.0411134250462055e-05, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.9802276912960224e-06, 0.0, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -4.768370445162873e-07, 0.0, -0.0005529781919904053, -2.3841855067985307e-07, -4.005352093372494e-05, -2.3841855067985307e-07, -5.960462772236497e-07, -2.3841855067985307e