{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 5005;\nconst int INF = 1000000007;\nconst int K = 100;\n\nstruct Edge {\n    int u, v;\n    int cap, flow, cost;\n};\n\nstruct MCMF {\n    int n, m, s, t;\n    vector<int> G[MAXN];\n    vector<Edge> E;\n    int d[MAXN];\n    int prev[MAXN];\n    int aug[MAXN];\n\n    MCMF(int n) : n(n) {}\n\n    void addEdge(int u, int v, int cap, int cost) {\n        E.push_back({u, v, cap, 0, cost});\n        E.push_back({v, u, 0, 0, -cost});\n        m = (int)E.size();\n        G[u].push_back(m - 2);\n        G[v].push_back(m - 1);\n    }\n\n    bool shortestPath(int &f, int &cost) {\n        fill(d, d + n, INF);\n        fill(aug, aug + n, INF);\n        fill(prev, prev + n, -1);\n        d[s] = 0;\n        prev[s] = -1;\n        aug[s] = INF;\n\n        for (int iter = 0; iter < n - 1; ++iter) {\n            bool any = false;\n            for (int u = 0; u < n; ++u) {\n                if (d[u] == INF) continue;\n                for (int id : G[u]) {\n                    Edge &e = E[id];\n                    if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                        d[e.v] = d[u] + e.cost;\n                        prev[e.v] = id;\n                        aug[e.v] = min(aug[u], e.cap - e.flow);\n                        any = true;\n                    }\n                }\n            }\n            if (!any) break;\n        }\n\n        if (d[t] == INF) return false;\n\n        f = aug[t];\n        cost = d[t];\n        for (int v = t; v != s; v = E[prev[v]].u) {\n            E[prev[v]].flow += aug[t];\n            E[prev[v] ^ 1].flow -= aug[t];\n        }\n        return true;\n    }\n\n    pair<int,int> minCost(int s, int t) {\n        this->s = s;\n        this->t = t;\n        int totalFlow = 0;\n        int totalCost = 0;\n        int f, c;\n        while (shortestPath(f, c)) {\n            totalFlow += f;\n            totalCost += f * c;\n        }\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MCMF solver(n * K + 2);\n    int source = n * K, sink = n * K + 1;\n\n    for (int i = 0; i < K; ++i)\n        solver.addEdge(i, sink, k, C * i);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        solver.addEdge(source, x * K, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 1; j < K; ++j)\n            solver.addEdge(i * K + j - 1, i * K + j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n\n        for (int j = 1; j < K; ++j) {\n            int a = u * K + j - 1, b = v * K + j;\n            int c = v * K + j - 1, d = u * K + j;\n\n            for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n\n    auto ans = solver.minCost(source, sink);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```java\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 5005;\n    static final int INF = 1000000007;\n    static final int K = 100;\n\n    static class Edge {\n        int u, v;\n        int cap, flow, cost;\n\n        Edge(int u, int v, int cap, int flow, int cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static class MCMF {\n        int n, m, s, t;\n        ArrayList<Integer>[] G;\n        ArrayList<Edge> E;\n        int[] d;\n        int[] prev;\n        int[] aug;\n\n        MCMF(int n) {\n            this.n = n;\n            G = new ArrayList[n];\n            for (int i = 0; i < n; i++) {\n                G[i] = new ArrayList<>();\n            }\n            E = new ArrayList<>();\n            d = new int[n];\n            prev = new int[n];\n            aug = new int[n];\n        }\n\n        void addEdge(int u, int v, int cap, int cost) {\n            E.add(new Edge(u, v, cap, 0, cost));\n            E.add(new Edge(v, u, 0, 0, -cost));\n            m = E.size();\n            G[u].add(m - 2);\n            G[v].add(m - 1);\n        }\n\n        boolean shortestPath(int[] flow, int[] cost) {\n            Arrays.fill(d, INF);\n            Arrays.fill(aug, INF);\n            Arrays.fill(prev, -1);\n            d[s] = 0;\n            prev[s] = -1;\n            aug[s] = INF;\n\n            for (int iter = 0; iter < n - 1; ++iter) {\n                boolean any = false;\n                for (int u = 0; u < n; ++u) {\n                    if (d[u] == INF) continue;\n                    for (int id : G[u]) {\n                        Edge e = E.get(id);\n                        if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                            d[e.v] = d[u] + e.cost;\n                            prev[e.v] = id;\n                            aug[e.v] = Math.min(aug[u], e.cap - e.flow);\n                            any = true;\n                        }\n                    }\n                }\n                if (!any) break;\n            }\n\n            if (d[t] == INF) return false;\n\n            flow[0] = aug[t];\n            cost[0] = d[t];\n            for (int v = t; v != s; v = E.get(prev[v]).u) {\n                Edge e = E.get(prev[v]);\n                e.flow += aug[t];\n                E.get(prev[v] ^ 1).flow -= aug[t];\n            }\n            return true;\n        }\n\n        int[] minCost(int s, int t) {\n            this.s = s;\n            this.t = t;\n            int totalFlow = 0;\n            int totalCost = 0;\n            int[] f = new int[1];\n            int[] c = new int[1];\n            while (shortestPath(f, c)) {\n                totalFlow += f[0];\n                totalCost += f[0] * c[0];\n            }\n            return new int[]{totalFlow, totalCost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        MCMF solver = new MCMF(n * K + 2);\n        int source = n * K;\n        int sink = n * K + 1;\n\n        for (int i = 0; i < K; ++i) {\n            solver.addEdge(i, sink, k, C * i);\n        }\n\n        for (int i = 0; i < k; ++i) {\n            int x = sc.nextInt();\n            --x;\n            solver.addEdge(source, x * K, 1, 0);\n        }\n\n        for (int i = 0; i < n; ++i) {\n            for (int j = 1; j < K; ++j) {\n                solver.addEdge(i * K + j - 1, i * K + j, k, 0);\n            }\n        }\n\n        while (m-- > 0) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            --u; --v;\n\n            for (int j = 1; j < K; ++j) {\n                int a = u * K + j - 1, b = v * K + j;\n                int c = v * K + j - 1, d = u * K + j;\n\n                for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                    solver.addEdge(a, b, 1, cc);\n                    solver.addEdge(c, d, 1, cc);\n                }\n            }\n        }\n\n        int[] ans = solver.minCost(source, sink);\n        System.out.println(ans[1]);\n    }\n}\n```", "token_logprobs": [-5.960462772236497e-07, -0.00012373158824630082, -9.548207890475169e-05, 0.0, -0.00026127262390218675, -0.06370584666728973, -0.10053545236587524, -2.3841855067985307e-07, -0.0048017664812505245, -0.023254064843058586, -0.00026246439665555954, -0.006941607687622309, -0.008620667271316051, -1.1920928244535389e-07, -0.0011704268399626017, -8.702239938429557e-06, 0.0, -7.152555099310121e-07, -0.00015138434537220746, -9.536738616588991e-07, -0.0017889224691316485, -1.1920928244535389e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -5.960462772236497e-07, -2.9802276912960224e-06, 0.0, -9.775113539944869e-06, -0.00015948931104503572, -3.576278118089249e-07, -2.50339189733495e-06, -1.0728830375228426e-06, -0.0003401654539629817, -7.152555099310121e-07, -9.536738616588991e-07, -1.311301275563892e-06, 0.0, -5.960462772236497e-07, -9.536697689327411e-06, 0.0, -5.960462772236497e-07, -0.0008357845945283771, -1.1920928244535389e-07, -1.7881233361549675e-05, -3.576278118089249e-07, -1.3112935448589269e-05, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -1.5497195136049413e-06, 0.0, -0.06196996942162514, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -2.264974000354414e-06, -4.172316494077677e-06, 0.0, -0.6328799724578857, 0.0, -0.00015853578224778175, -4.565611743601039e-05, -3.576278118089249e-07, -6.437280717364047e-06, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, -0.002477316651493311, 0.0, 0.0, -3.576278118089249e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-