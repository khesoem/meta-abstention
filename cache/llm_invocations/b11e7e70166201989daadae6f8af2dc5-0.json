eturn level[sink] != -1;\n    }\n    \n    ll augment(int u, ll flow) {\n        if (u == sink) return flow;\n        for (int &i = iter[u]; i < (int)graph[u].size(); ++i) {\n            Edge &e = graph[u][i];\n            if (e.capacity > 0 && level[e.to] == level[u] + 1) {\n                ll pushed = augment(e.to, min(flow, e.capacity));\n                if (pushed > 0) {\n                    e.capacity -= pushed;\n                    graph[e.to][e.reverse].capacity += pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n    \n    ll dinic() {\n        ll total = 0;\n        while (buildLevel()) {\n            fill(iter.begin(), iter.end(), 0);\n            ll pushed;\n            while ((pushed = augment(source, 1e18)) > 0) {\n                total += pushed;\n            }\n        }\n        return total;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, T;\n    cin >> n >> T;\n    \n    vector<string> grid(n);\n    int zy = -1, zx = -1;\n    for (int i = 0; i < n; ++i) {\n        cin >> grid[i];\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] == 'Z') {\n                zy = i; zx = j;\n            }\n        }\n    }\n    \n    string dummy;\n    getline(cin, dummy);\n    getline(cin, dummy);\n    \n    vector<string> exits(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> exits[i];\n    }\n    \n    vector<vector<int>> dist(n, vector<int>(n, -1));\n    queue<pair<int, int>> bfsQ;\n    bfsQ.push({zy, zx});\n    dist[zy][zx] = 0;\n    \n    const int dy[] = {1, -1, 0, 0};\n    const int dx[] = {0, 0, 1, -1};\n    \n    while (!bfsQ.empty()) {\n        auto [y, x] = bfsQ.front(); bfsQ.pop();\n        for (int d = 0; d < 4; ++d) {\n            int ny = y + dy[d], nx = x + dx[d];\n            if (ny < 0 || ny >= n || nx < 0 || nx >= n) continue;\n            if (dist[ny][nx] != -1 || grid[ny][nx] == 'Y') continue;\n           