ted_code>\nfrom collections import deque\nimport sys\n\nclass FlowGraph:\n    class Edge:\n        __slots__ = ('to', 'reverse', 'capacity')\n        def __init__(self, to, reverse, capacity):\n            self.to = to\n            self.reverse = reverse\n            self.capacity = capacity\n    \n    def __init__(self, nodes, s, t):\n        self.graph = [[] for _ in range(nodes)]\n        self.level = [0] * nodes\n        self.iter = [0] * nodes\n        self.source = s\n        self.sink = t\n    \n    def addEdge(self, u, v, cap):\n        self.graph[u].append(self.Edge(v, len(self.graph[v]), cap))\n        self.graph[v].append(self.Edge(u, len(self.graph[u]) - 1, 0))\n    \n    def buildLevel(self):\n        self.level = [-1] * len(self.level)\n        self.level[self.source] = 0\n        q = deque()\n        q.append(self.source)\n        while q:\n            u = q.popleft()\n            for e in self.graph[u]:\n                if e.capacity > 0 and self.level[e.to] == -1:\n                    self.level[e.to] = self.level[u] + 1\n                    q.append(e.to)\n        return self.level[self.sink] != -1\n    \n    def augment(self, u, flow):\n        if u == self.sink:\n            return flow\n        for i in range(self.iter[u], len(self.graph[u])):\n            self.iter[u] = i\n            e = self.graph[u][i]\n            if e.capacity > 0 and self.level[e.to] == self.level[u] + 1:\n                pushed = self.augment(e.to, min(flow, e.capacity))\n                if pushed > 0:\n                    e.capacity -= pushed\n                    self.graph[e.to][e.reverse].capacity += pushed\n                    return pushed\n        return 0\n    \n    def dinic(self):\n        total = 0\n        while self.buildLevel():\n            self.iter = [0] * len(self.iter)\n            pushed = self.augment(self.source, float('inf'))\n            while pushed > 0:\n                total += pushed\n                pushed = self.augment(self.source, float('inf'))\n        return total\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    if not data:\n        return\n    \n    n, T = map(int, data[0].split())\n    \n    grid = []\n    zy, zx = -1, -1\n    for i in range(1, n + 1):\n        line = data[i]\n        grid.append(line)\n        for j in range(len(line)):\n            if line[j] == 'Z':\n                zy, zx = i - 1, j\n    \n    # Skip two empty lines\n    idx = n + 1\n    while idx < len(data) and data[idx].strip() == '':\n        idx += 1\n    \n    exits = []\n    while idx < len(data) and len(exits) < n:\n        exits.append(data[idx])\n        idx += 1\n    \n    dist = [[-1] * n for _ in range(n)]\n    bfsQ = deque()\n    bfsQ.append((zy, zx))\n    dist[zy][zx] = 0\n    \n    dy = [1, -1, 0, 0]\n    dx = [0, 0, 1, -1]\n    \n    while bfsQ:\n        y, x = bfsQ.popleft()\n        for d in range(4):\n            ny, nx = y + dy[d], x + dx[d]\n            if ny < 0 or ny >= n or nx < 0 or nx >= n:\n                continue\n            if dist[ny][nx] != -1 or grid[ny][nx] == 'Y':\n                continue\n            dist[ny][nx] = dist[y][x] + 1\n            if dist[ny][nx] < T:\n                bfsQ.append((ny, nx))\n    \n    for i in range(n):\n        for j in range(n):\n            if '0' <= grid[i][j] <= '9':\n                if dist[i][j] == -1:\n                    dist[i][j] = T\n                else:\n                    dist[i][j] = min(dist[i][j], T)\n    \n    nodeId = [[-1] * n for _ in range(n)]\n    nodeCount = 0\n    \n    for i in range(n):\n        for j in range(n):\n            if '0' <= grid[i][j] <= '9':\n                nodeId[i][j] = nodeCount\n                nodeCount += 1\n            if '0' <= exits[i][j] <= '9':\n                nodeId[i][j] = nodeCount\n                nodeCount += 1\n    \n    src = 0\n    dst = nodeCount + 1\n    flow = FlowGraph(nodeCount + 2, src, dst)\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= grid[i][j] <= '9':\n                flow.addEdge(src, nodeId[i][j], ord(grid[i][j]) - ord('0'))\n            \n            if '1' <= exits[i][j] <= '9':\n                flow.addEdge(nodeId[i][j], dst, ord(exits[i][j]) - ord('0'))\n            \n            for d in range(4):\n                ni, nj = i + dy[d], j + dx[d]\n                if ni < 0 or ni >= n or nj < 0 or nj >= n:\n                    continue\n                if grid[ni][nj] == 'Y' or grid[ni][nj] == 'Z':\n                    continue\n                \n                if nodeId[i][j] != -1 and nodeId[ni][nj] != -1:\n                    flow.addEdge(nodeId[i][j], nodeId[ni][nj], 1000000000)\n    \n    print(flow.dinic())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920922133867862e-06, -0.00015793983766343445, -1.9073468138230965e-06, -1.1920928244535389e-07, -0.5957769155502319, -0.00026544384309090674, -3.576278118089249e-07, -0.0003406421164982021, -0.004404961597174406, -0.00018070495571009815, -7.152301259338856e-05, -0.00036352223833091557, -0.02979080006480217, -0.07894538342952728, -1.7762025890988298e-05, -8.22540732769994e-06, -2.3841855067985307e-07, -0.00018308870494365692, -1.2516897186287679e-05, -7.152555099310121e-07, -1.9073468138230965e-06, -0.5759404897689819, -8.713819261174649e-05, -1.311301275563892e-06, -1.0728830375228426e-06, -0.0017485818825662136, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -1.156323378381785e-05, -1.1920922133867862e-06, 0.0, -6.6756979322235566e-06, -0.00038389943074434996, -0.5231469869613647, -2.3841855067985307e-07, -9.536738616588991e-07, -4.172316494077677e-06, -1.1920928244535389e-07, -1.7881377516459906e-06, 0.0, -4.768370445162873e-07, -0.0005445189890451729, -0.00017438798386137933, -0.00016330339713022113, -2.7418097943154862e-06, -1.4305104514278355e-06, -3.7431014789035544e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -5.9