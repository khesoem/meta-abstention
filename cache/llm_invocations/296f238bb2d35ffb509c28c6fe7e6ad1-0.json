nse": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, flow, cost;\n        Edge(int to, int cap, int flow, int cost) {\n            this.to = to;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final int MAXN = 14043;\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[MAXN];\n    static long totalCost = 0;\n    static long[] dist = new long[MAXN];\n    static int[] parent = new int[MAXN];\n    static int[] parentEdge = new int[MAXN];\n    static boolean[] inQueue = new boolean[MAXN];\n    static final long INF = 1000000000000000000L;\n    static int S = MAXN - 2;\n    static int T = MAXN - 1;\n\n    static int residualCapacity(int id) {\n        return edges.get(id).cap - edges.get(id).flow;\n    }\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        adj[u].add(edges.size());\n        edges.add(new Edge(v, cap, 0, cost));\n        adj[v].add(edges.size());\n        edges.add(new Edge(u, 0, 0, -cost));\n    }\n\n    static void augmentOne() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(parent, -1);\n        Arrays.fill(parentEdge, -1);\n        Arrays.fill(inQueue, false);\n\n        dist[S] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.add(S);\n        inQueue[S] = true;\n\n        while (!q.isEmpty()) {\n            int v = q.poll();\n            inQueue[v] = false;\n\n            for (int id : adj[v]) {\n                if (residualCapacity(id) == 0) continue;\n                int to = edges.get(id).to;\n                int w = edges.get(id).cost;\n                if (dist[to] > dist[v] + w) {\n                    dist[to] = dist[v] + w;\n                    parent[to] = v;\n                    parentEdge[to] = id;\n                    if (!inQueue[to]) {\n                        inQueue[to] = true;\n                        q.add(to);\n                    }\n                }\n            }\n        }\n\n        int cur = T;\n        while (cur != S) {\n            int id = parentEdge[cur];\n            edges.get(id).flow++;\n            edges.get(id ^ 1).flow--;\n            cur = parent[cur];\n        }\n\n        totalCost += dist[T];\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        for (int i = 0; i < MAXN; i++) {\n            adj[i] = new ArrayList<>();\n        }\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            addEdge(S, x, 1, 0);\n        }\n\n        final int TIMES = 101;\n\n        for (int i = 0; i < TIMES; i++) {\n            addEdge(i * n, T, k, i * c);\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n\n            for (int tm = 0; tm < TIMES - 1; tm++) {\n                for (int p = 0; p < k; p++) {\n                    addEdge(x + tm * n, y + (tm + 1) * n, 1, d * (2 * p + 1));\n                }\n            }\n            for (int tm = 0; tm < TIMES - 1; tm++) {\n                for (int p = 0; p < k; p++) {\n                    addEdge(y + tm * n, x + (tm + 1) * n, 1, d * (2 * p + 1));\n                }\n            }\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int tm = 0; tm < TIMES - 1; tm++) {\n                addEdge(i + tm * n, i + (tm + 1) * n, k, 0);\n            }\n        }\n\n        for (int i = 0; i < k; i++) {\n            augmentOne();\n        }\n\n        System.out.println(totalCost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, 0.0, 0.0, -9.798523387871683e-05, -0.038074348121881485, -1.1920928244535389e-07, -0.03804141283035278, -0.048596639186143875, 0.0, 0.0, -1.1920928244535389e-07, -2.1219027985353023e-05, -0.0002961912250611931, 0.0, -0.00875420868396759, -0.01816318929195404, -0.0009127265075221658, -0.00721787940710783, -0.011075095273554325, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -0.0015025765169411898, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -8.940656698541716e-06, 0.0, -0.0019328974885866046, -1.0132738680113107e-05, -7.497983460780233e-05, -0.10021068155765533, -9.60780744208023e-05, -1.1920928244535389e-07, 0.0, 0.0, -7.152555099310121e-07, 0.0, -0.00043084874050691724, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.7881377516459906e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -8.487341256113723e-05, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.4305104514278355e-06, -2.0265558760002023e-06, 0.0, -6.318072337307967e-06, -1.1920928244535389e-07, 0.0, -9.536738616588991e-07, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -4.768370445162873e-07, -0.0002964295563288033, -0.0013261580606922507, 0.0, -0.00012110930401831865, -3.6238969187252223e-05, -4.768370445162873e-07, 0.0, -2.264974000354414e-06, 0.0, -1.1920928244535389e-07, -3.3378546504536644e-06, -8.821448318485636e-06, -8.821448318485636e-06, 0.0, -2.3841855067985307e-07, -0.20182259380817413, -1.0251946150674485e-05, -5.483612312673358e-06, 0.0, 0.0, -0.004078523721545935, 0.0, 0.0, -2.41991929215