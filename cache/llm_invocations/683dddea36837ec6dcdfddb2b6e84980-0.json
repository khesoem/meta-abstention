 in range(1, n + 1):\n        l = 0\n        r = 10**6\n        maxv = (x / y) + (rp_num / rp_den)\n        maxv = (maxv + 2) * b\n        r = min(r, int(maxv))\n        \n        while l <= r:\n            mid = l + (r - l) // 2\n            # Current candidate fraction: mid/b\n            ab_num, ab_den = mid, b\n            \n            # Calculate difference |x/y - mid/b|\n            dif_num, dif_den = sub_fraction(x, y, ab_num, ab_den)\n            dif_num, dif_den = abs_fraction(dif_num, dif_den)\n            \n            # Compare difference with current best difference\n            comp = compare_fraction(dif_num, dif_den, rp_num, rp_den)\n            \n            if comp == 0:\n                # Same difference, choose with smaller denominator, then smaller numerator\n                if ab_den < rv_den:\n                    rv_num, rv_den = ab_num, ab_den\n                elif ab_den == rv_den and ab_num < rv_num:\n                    rv_num, rv_den = ab_num, ab_den\n            elif comp < 0:\n                # Found better approximation\n                rp_num, rp_den = dif_num, dif_den\n                rv_num, rv_den = ab_num, ab_den\n            \n            # Compare ab with x/y to decide search direction\n            comp_ab_xy = compare_fraction(ab_num, ab_den, x, y)\n            if comp_ab_xy < 0:\n                l = mid + 1\n            else:\n                r = mid - 1\n    \n    print(f\"{rv_num}/{rv_den}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011729506513802335, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.0008157739648595452, -0.5254747271537781, -3.576278118089249e-07, -0.01253123302012682, -0.00040344204171560705, -1.1920928244535389e-07, -0.06993812322616577, -0.0021360930986702442, -6.6756979322235566e-06, -0.3132633864879608, -0.18243524432182312, -7.152555099310121e-07, -0.0003392120997887105, -0.07005160301923752, -0.000298574683256447