{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <climits>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int MAX_NODE = 5500;\nconst int MAX_EDGE = 35500;\nconst int INF = 1000000000;\n\nstruct Arc {\n    int next;\n    int dest;\n    int cap;\n    int cost;\n};\n\nvector<Arc> graph(MAX_EDGE * 2 + 10);\nvector<int> adj(MAX_NODE + 10);\nint edge_cnt = 1;\n\nvoid add_arc(int u, int v, int c, int w) {\n    graph[++edge_cnt] = {adj[u], v, c, w};\n    adj[u] = edge_cnt;\n    graph[++edge_cnt] = {adj[v], u, 0, -w};\n    adj[v] = edge_cnt;\n}\n\nint s, t, prev_node[MAX_NODE], last_arc[MAX_NODE], flow_arr[MAX_NODE], dist_arr[MAX_NODE];\nbool in_q[MAX_NODE];\n\nint spfa_run() {\n    fill(dist_arr + 1, dist_arr + t + 1, INF);\n    fill(flow_arr + 1, flow_arr + t + 1, 0);\n    flow_arr[s] = INF;\n    dist_arr[s] = 0;\n    queue<int> q;\n    q.push(s);\n    in_q[s] = true;\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        in_q[u] = false;\n\n        for (int e = adj[u]; e; e = graph[e].next) {\n            int v = graph[e].dest;\n            if (graph[e].cap && dist_arr[v] > dist_arr[u] + graph[e].cost) {\n                dist_arr[v] = dist_arr[u] + graph[e].cost;\n                flow_arr[v] = min(flow_arr[u], graph[e].cap);\n                last_arc[v] = e;\n                prev_node[v] = u;\n                if (!in_q[v]) {\n                    in_q[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return flow_arr[t];\n}\n\nint n, m, k, base_cost, unit_cost;\nint loc_record[105][105];\nint edge_count_rec[105][105];\nstruct Journey { int src, dst; } edges_in[105];\n\n#define to_node(r,c) ((r)*(n)+(c))\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> n >> m >> k >> base_cost >> unit_cost;\n    s = to_node(n+k, n) + 1;\n    t = s + 2;\n\n    add_arc(to_node(0,1), t, INF, 0);\n\n    for (int i = 1, port; i <= k; ++i) {\n        cin >> port;\n        add_arc(s, to_node(0,port), 1, 0);\n    }\n\n    for (int i = 1; i <= m; ++i) {\n        cin >> edges_in[i*2].src >> edges_in[i*2].dst;\n        edges_in[i*2-1] = {edges_in[i*2].dst, edges_in[i*2].src};\n    }\n    m <<= 1;\n\n    for (int day = 1; day <= n + k; ++day) {\n        for (int i = 1; i <= n; ++i)\n            add_arc(to_node(day-1, i), to_node(day, i), INF, 0);\n        for (int i = 1; i <= m; ++i) {\n            add_arc(to_node(day-1, edges_in[i].src), to_node(day, edges_in[i].dst), 1, unit_cost);\n            loc_record[day][i] = edge_cnt;\n            edge_count_rec[day][i] = 1;\n        }\n        add_arc(to_node(day, 1), t, INF, day * base_cost);\n    }\n\n    int augment, total = 0;\n    while (augment = spfa_run()) {\n        int cur = t;\n        while (cur != s) {\n            int u = prev_node[cur];\n            graph[last_arc[cur]].cap -= augment;\n            graph[last_arc[cur]^1].cap += augment;\n            cur = u;\n        }\n        total += dist_arr[t] * augment;\n\n        for (int day = 1; day <= n+n; ++day)\n            for (int i