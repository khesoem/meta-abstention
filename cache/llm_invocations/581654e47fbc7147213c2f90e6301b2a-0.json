ue;\n        }\n        if (s.charAt(0) == '0') {\n            bw.write(\"0\\n\");\n            bw.flush();\n            return true;\n        }\n        return false;\n    }\n\n    static int computeWays(String s, String v, int n) {\n        String[] digits = {\"25\", \"50\", \"75\", \"00\"};\n        String[] arr1 = {\"__\", \"_X\", \"X_\", \"XX\"};\n        int[] way = {4, 4, 4, 1};\n        if (s.charAt(0) == 'X') {\n            way[1] = 2;\n            way[2] = 3;\n        }\n        if (n == 2) {\n            way[0] = 3;\n            way[1] = 3;\n        }\n        int ways = 0;\n        for (int i = 0; i < 4; i++) {\n            if (v.equals(digits[i])) {\n                ways = 1;\n            }\n        }\n        char c0 = v.charAt(0);\n        char c1 = v.charAt(1);\n        if (c0 == '_' || c0 == 'X') {\n            ways = 2;\n            if (c1 == '0' && s.charAt(0) == 'X') {\n                ways = 1;\n            }\n        } else if (c1 == '_' || c1 == 'X') {\n            ways = 1;\n        }\n        for (int i = 0; i < 4; i++) {\n            if (v.equals(arr1[i])) {\n                ways = way[i];\n            }\n        }\n        if (v.equals(\"XX\") && s.charAt(0) == 'X') {\n            ways = 0;\n        }\n        if (c0 != '2' && c0 != '5' && c0 != '7' && c0 != '0' && c0 != 'X' && c0 != '_') {\n            ways = 0;\n        }\n        if (c1 != '0' && c1 != '5' && c1 != 'X' && c1 != '_') {\n            ways = 0;\n        }\n        return ways;\n    }\n\n    static long computeToti(String s, int n, String v, int ways) {\n        boolean ok = false;\n        long toti = 1L;\n        for (int i = 0; i < n - 2; i++) {\n            char ch = s.charAt(i);\n            if (ch == 'X') {\n                ok = true;\n            }\n            if (ch == '_') {\n                if (i == 0) {\n                    toti *= 9L;\n                } else {\n                    toti *= 10L;\n                }\n            }\n        }\n        char c0 = v.cha