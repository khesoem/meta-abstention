 long numPhases = multiply(m + k, smallInv(k, fact, invFact));\n            long ncr = multiply(fact[n], invFact[k], invFact[n - k]);\n            long term = multiply(sign, ncr, numPhases, phaseSize);\n            ans += term;\n            if (ans >= MOD) ans -= MOD;\n        }\n        System.out.println(ans);\n    }\n\n    static long multiply(long... xs) {\n        long r = 1;\n        for (long x : xs) r = r * x % MOD;\n        return r;\n    }\n\n    static long smallInv(int x, long[] fact, long[] invFact) {\n        return invFact[x] * fact[x - 1] % MOD;\n    }\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nconst long long MOD = 998244353LL;\n\nlong long pow_mod(long long a, long long e) {\n    long long res = 1;\n    while (e) {\n        if (e & 1) res = res * a % MOD;\n        a = a * a % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nlong long mul(long long a, long long b) {\n    return a * b % MOD;\n}\n\nlong long mul(long long a, long long b, long long c) {\n    return mul(mul(a, b), c);\n}\n\nlong long smallInv(int x, const vector<long long>& fact, const vector<long long>& invFact) {\n    return invFact[x] * fact[x - 1] % MOD;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    int max = n + m;\n    vector<long long> fact(max + 1), invFact(max + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= max; ++i) fact[i] = fact[i - 1] * i % MOD;\n    invFact[max] = pow_mod(fact[max], MOD - 2);\n    for (int i = max; i >= 1; --i) invFact[i - 1] = invFact[i] * i % MOD;\n\n    long long phaseSize = 1;\n    long long p = 1;\n    for (int i = 0; p != 0; ++i) {\n        p = mul(p, n - i);\n        p = mul(p, smallInv(n + m - i, fact, invFact));\n        phaseSize += p;\n        if (phaseSize >= MOD) phaseSize -= MOD;\n    }\n\n    long long ans = 