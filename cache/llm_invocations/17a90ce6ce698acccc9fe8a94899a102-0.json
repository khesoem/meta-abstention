 dep[i][j] = dis[i][j]\n\n    # Build flow network\n    S = 0\n    T = 1\n    t = 1  # current node count\n    # First pass to count nodes and assign ids\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if '1' <= ma[i][j] <= '9':\n                t += 1\n                p[i][j] = t\n            if '1' <= mb[i][j] <= '9':\n                t += 1\n                s[i][j] = t\n    max_nodes = t + 1\n    b = [0] * (max_nodes + 1)\n    a = []  # list of [to, cap, next]\n\n    def add_edge(x, y, c):\n        nonlocal a, b\n        a.append([y, c, b[x]])\n        b[x] = len(a) - 1\n        a.append([x, 0, b[y]])\n        b[y] = len(a) - 1\n\n    # Add source and sink edges\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if '1' <= ma[i][j] <= '9':\n                add_edge(S, p[i][j], int(ma[i][j]))\n            if '1' <= mb[i][j] <= '9':\n                add_edge(s[i][j], T, int(mb[i][j]))\n\n    # Second BFS from each source node to add edges to sinks\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if p[i][j]:\n                bfs(i, j, True)\n\n    # Dinic max flow\n    level = [0] * (max_nodes + 1)\n    it_edges = [0] * (max_nodes + 1)\n\n    def bfs_level():\n        nonlocal level\n        for i in range(max_nodes + 1):\n            level[i] = 0\n        q = deque()\n        q.append(S)\n        level[S] = 1\n        while q:\n            x = q.popleft()\n            i = b[x]\n            while i != 0:\n                y, cap, nxt = a[i]\n                if level[y] == 0 and cap > 0:\n                    level[y] = level[x] + 1\n                    q.append(y)\n                i = nxt\n        return level[T] != 0\n\n    def dfs(x, flow):\n        if x == T:\n            return flow\n        i = it_edges[x]\n        while i != 0:\n            y, cap, nxt = a[i]\n            if level[y] == level[x] + 1 and cap > 0:\n                ret = dfs(y, min(flow, cap))\n                if ret > 0:\n                    a[i][1] -= ret\n                    a[i ^ 1][1] += ret\n                    it_edges[x] = i\n                    return ret\n            i = nxt\n        it_edges[x] = i\n        return 0\n\n    ans = 0\n    while bfs_level():\n        for i in range(max_nodes + 1):\n            it_edges[i] = b[i]\n        while True:\n            pushed = dfs(S, INF)\n            if pushed == 0:\n                break\n            ans += pushed\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.169585604860913e-05, -1.1920928244535389e-07, -8.344646857949556e-07, -0.0002157455455744639, -0.0004060635983478278, 0.0, -4.291525328881107e-06, -1.0728830375228426e-06, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -4.494089080253616e-05, -2.0503786799963564e-05, -0.04930349439382553, -0.0004320403386373073, -1.311301275563892e-06, -0.006206168793141842, -1.1920928244535389e-07, -4.0531076592742465e-06, 0.0, -0.00024256148026324809, -3.576278118089249e-07, -1.680836794548668e-05, -2.50339189733495e-06, 0.0, -0.014167563058435917, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -1.156323378381785e-05, -7.867782187531702e-06, -0.0001551984460093081, -2.2649508537142538e-05, 0.0, 0.0, 0.0, -0.00013445904187392443, 0.0, -0.0008297099848277867, -7.998623186722398e-05, 0.0, -1.1920928244535389e-07, 0.0, -0.16022957861423492, -0.1269288957118988, -0.2520248591899872, -7.152555099310121e-07, -0.001930398982949555, -6.794906312279636e-06, -9.536738616588991e-07, -0.0004354958946350962, 0.0, -1.1920928244535389e-07, -0.0024756519123911858, 0.0, -8.67805938469246e-05, -5.149708886165172e-05, 0.0, -0.006718190852552652, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.0009114163694903255, 0.0, -3.576278118089249e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -0.0003505330823827535, -1.1920928244535389e-07, 0.0, 0.0, -4.61329291283618