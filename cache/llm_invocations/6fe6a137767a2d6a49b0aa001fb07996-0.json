g tgt, int pos, const vector<long long>& pw, const vector<long long>& sm) {\n        if (cur == tgt) return true;\n        if (pos < 0) return false;\n        \n        long long rem = sm[pos + 1];\n        long long nxt = pw[pos];\n        \n        if (cur - rem > tgt || cur + rem < tgt) return false;\n        \n        if (cur + sm[pos] < tgt) {\n            return explore(cur + nxt, tgt, pos - 1, pw, sm);\n        } else if (cur - sm[pos] > tgt) {\n            return explore(cur - nxt, tgt, pos - 1, pw, sm);\n        } else {\n            return explore(cur, tgt, pos - 1, pw, sm);\n        }\n    }\n};\n\nclass FastScanner {\nprivate:\n    istream* in;\n    string buffer;\n    size_t pos;\n    \npublic:\n    FastScanner() : in(&cin), buffer(\"\"), pos(0) {}\n    \n    string next() {\n        while (pos >= buffer.size()) {\n            if (!getline(*in, buffer)) {\n                throw runtime_error(\"No more input\");\n            }\n            pos = 0;\n        }\n        \n        while (pos < buffer.size() && buffer[pos] == ' ') {\n            pos++;\n        }\n        \n        if (pos >= buffer.size()) {\n            return next();\n        }\n        \n        size_t start = pos;\n        while (pos < buffer.size() && buffer[pos] != ' ') {\n            pos++;\n        }\n        \n        return buffer.substr(start, pos - start);\n    }\n    \n    long long nextLong() {\n        string s = next();\n        return stoll(s);\n    }\n};\n\nint main() {\n    FastScanner fs;\n    long long w = fs.nextLong();\n    long long m = fs.nextLong();\n    \n    TaskC solver;\n    cout << (solver.determine(w, m) ? \"YES\" : \"NO\") << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.738924563862383e-05, -3.4570634852570947e-06, -3.576278118089249e-07, -0.0004390706308186054, -8.344646857949556e-07, -7.867782187531702e-06, -4.0531076592742465e-06, -8.4638240878121e-06, -1.4305104514278355e-06, -0.099250532686