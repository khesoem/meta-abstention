\n    static long[] rep = new long[20];\n    static int best;\n\n    static void dfs(long x, int cost) {\n        if (cost >= best) return;\n        if (x == 0) {\n            best = cost;\n            return;\n        }\n        int len = 0;\n        long tmp = x;\n        while (tmp >= 10) {\n            tmp /= 10;\n            len++;\n        }\n        int t = (int) tmp;\n        // first operation: subtract t repeated (len+1) times\n        dfs(Math.abs(x - rep[len] * t), cost + t * (len + 1));\n        // second operation: subtract (t-1) repeated (len+1) times if t-1 > 0\n        if (t - 1 > 0) {\n            dfs(Math.abs(x - rep[len] * (t - 1)), cost + (t - 1) * (len + 1));\n        }\n        // third operation: use rep[len+1] (one more digit) and subtract x from it\n        if (t > 1) {\n            dfs(Math.abs(rep[len + 1] - x), cost + (len + 2));\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        rep[0] = 1;\n        for (int i = 1; i <= 18; i++) {\n            rep[i] = rep[i - 1] * 10 + 1;\n        }\n        best = 1000000000;\n        dfs(n, 0);\n        System.out.println(best);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-4.768370445162873e-07, 0.0, 0.0, -3.790783375734463e-05, -5.125986263010418e-06, -1.1920928244535389e-07, -2.264974000354414e-06, -0.014222448691725731, -0.00020656836568377912, -3.58813522325363e-05, 0.0, -3.576272320060525e-06, -2.1815061700181104e-05, -4.6491513785440475e-06, -0.0011710221879184246, -5.018585216021165e-05, -3.576278118089249e-07, 0.0, -0.00033563701435923576, 0.0, 0.0, 0.0, -5.245195097813848e-06, -9.60780744208023e-05, 0.0, 0.0, -7.521823135903105e-05, -1.1920928244535389e-07, -0.013843591324985027, -1.1920928244535389e-07, -0.008653285913169384, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -5.960462772236497e-07, 0.0, -1.1920928