] + 1;\n            dq.emplace_back(nr, nc);\n        }\n    }\n    return dist;\n}\n\nvoid populate_graph() {\n    int N, T;\n    cin >> N >> T;\n    vs G1(N), G2(N);\n    for (int i = 0; i < N; ++i) cin >> G1[i];\n    for (int i = 0; i < N; ++i) cin >> G2[i];\n\n    int rx = -1, ry = -1;\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            if (G1[i][j] == 'Z') rx = i, ry = j;\n\n    auto dist_to_react = BFS(rx, ry, G1);\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (!valid(i, j, G1)) continue;\n            auto dist_from_src = BFS(i, j, G1);\n\n            for (int x = 0; x < N; ++x) {\n                for (int y = 0; y < N; ++y) {\n                    if (!valid(x, y, G1)) continue;\n                    if (dist_from_src[x][y] > T) continue;\n                    if (dist_from_src[x][y] > dist_to_react[x][y]) continue;\n\n                    bool special = (dist_from_src[x][y] == dist_to_react[x][y]);\n                    if (special) {\n                        bool escapable = false;\n                        for (int d = 0; d < 4; ++d) {\n                            int nx = x + DR[d], ny = y + DC[d];\n                            if (valid(nx, ny, G1) && dist_from_src[nx][ny] < dist_to_react[nx][ny]) {\n                                escapable = true;\n                                break;\n                            }\n                        }\n                        if (!escapable) continue;\n                    }\n\n                    int val1 = G1[i][j] - '0';\n                    int val2 = G2[x][y] - '0';\n                    for (int u = 1; u <= val1; ++u) {\n                        for (int v = 1; v <= val2; ++v) {\n                            int src = 100 * i + 10 * j + u;\n                            int dst = 100 * x + 10 * y + v;\n                            adj[src].push_back(dst);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\nbool match_step(int u) {\n    if (marker[u]) return false;\n    marker[u] = true;\n    for (int v : adj[u]) {\n        if (!link[v] || match_step(link[v])) {\n            link[v] = u;\n            return true;\n        }\n    }\n    return false;\n}\n\nvoid process_and_output() {\n    populate_graph();\n    int count = 0;\n    for (int u = 0; u < MAX_NODE; ++u) {\n        fill(marker, marker + MAX_NODE, false);\n        if (match_step(u)) ++count;\n    }\n    cout << count << '\\n';\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    process_and_output();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long INF = (long)1e18;\n    static int MAX_NODE = 1000;\n    static int[] DR = {0, 0, -1, 1};\n    static int[] DC = {-1, 1, 0, 0};\n    \n    static List<Integer>[] adj = new ArrayList[MAX_NODE];\n    static boolean[] marker = new boolean[MAX_NODE];\n    static int[] link = new int[MAX_NODE];\n    \n    static boolean valid(int r, int c, List<String> grid) {\n        int n = grid.size();\n        return r >= 0 && c >= 0 && r < n && c < n && \n               grid.get(r).charAt(c) != 'Y' && grid.get(r).charAt(c) != 'Z';\n    }\n    \n    static List<List<Long>> BFS(int sr, int sc, List<String> grid) {\n        int n = grid.size();\n        List<List<Long>> dist = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            List<Long> row = new ArrayList<>();\n            for (int j = 0; j < n; j++) {\n                row.add(INF);\n            }\n            dist.add(row);\n        }\n        \n        Deque<int[]> dq = new ArrayDeque<>();\n        dist.get(sr).set(sc, 0L);\n        dq.add(new int[]{sr, sc});\n        \n        while (!dq.isEmpty()) {\n            int[] cell = dq.pollFirst();\n            int r = cell[0];\n            int c = cell[1];\n            \n            for (int k = 0; k < 4; k++) {\n                int nr = r + DR[k];\n                int nc = c + DC[k];\n                if (!valid(nr, nc, grid) || !dist.get(nr).get(nc).equals(INF)) continue;\n                dist.get(nr).set(nc, dist.get(r).get(c) + 1);\n                dq.add(new int[]{nr, nc});\n            }\n        }\n        return dist;\n    }\n    \n    static void populate_graph() {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int T = sc.nextInt();\n        sc.nextLine();\n        \n        List<String> G1 = new ArrayList<>();\n        List<String> G2 = new ArrayList<>();\n        \n        for (int i = 0; i < N; i++) G1.add(sc.nextLine());\n        for (int i = 0; i < N; i++) G2.add(sc.nextLine());\n        \n        int rx = -1, ry = -1;\n        for (int i = 0; i < N; i++) {\n            for (int j = 0; j < N; j++) {\n                if (G1.get(i).charAt(j) == 'Z') {\n                    rx = i;\n                    ry = j;\n                }\n            }\n        }\n        \n        List<List<Long>> dist_to_react = BFS(rx, ry, G1);\n        \n        for (int i = 0; i < N; i++) {\n            for (int j = 0; j < N; j++) {\n                if (!valid(i, j, G1)) continue;\n                List<List<Long>> dist_from_src = BFS(i, j, G1);\n                \n                for (int x = 0; x < N; x++) {\n                    for (int y = 0; y < N; y++) {\n                        if (!valid(x, y, G1)) continue;\n                        if (dist_from_src.get(x).get(y) > T) continue;\n                        if (dist_from_src.get(x).get(y) > dist_to_react.get(x).get(y)) continue;\n                        \n                        boolean special = (dist_from_src.get(x).get(y).equals(dist_to_react.get(x).get(y)));\n                        if (special) {\n                            boolean escapable = false;\n                            for (int d = 0; d < 4; d++) {\n                                int nx = x + DR[d];\n                                int ny = y + DC[d];\n                                if (valid(nx, ny, G1) && \n                                    dist_from_src.get(nx).get(ny) < dist_to_react.get(nx).get(ny)) {\n                                    escapable = true;\n                                    break;\n                                }\n                            }\n                            if (!escapable) continue;\n                        }\n                        \n                        int val1 = G1.get(i).charAt(j) - '0';\n                        int val2 = G2.get(x).charAt(y) - '0';\n                        for (int u = 1; u <= val1; u++) {\n                            for (int v = 1; v <= val2; v++) {\n                                int src = 100 * i + 10 * j + u;\n                                int dst = 100 * x + 10 * y + v;\n                                if (adj[src] == null) adj[src] = new ArrayList<>();\n                                adj[src].add(dst);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    \n    static boolean match_step(int u) {\n        if (marker[u]) return false;\n        marker[u] = true;\n        if (adj[u] != null) {\n            for (int v : adj[u]) {\n                if (link[v] == 0 || match_step(link[v])) {\n                    link[v] = u;\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n    \n    static void process_and_output() {\n        populate_graph();\n        int count = 0;\n        for (int u = 0; u < MAX_NODE; u++) {\n            Arrays.fill(marker, false);\n            if (match_step(u)) ++count;\n        }\n        System.out.println(count);\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        process_and_output();\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00016437610611319542, -2.50339189733495e-06, -8.344646857949556e-07, -0.0009908534120768309, -4.8636207793606445e-05, -0.02630242146551609, -0.17975729703903198, -0.0002733095607254654, -3.1709168979432434e-05, -7.70062324590981e-05, -0.0010720703285187483, -0.0002119316632160917, -3.576278118089249e-07, -3.123234637314454e-05, -0.054886817932128906, -2.455681169521995e-05, -0.013987721875309944, -0.7628093957901001, -0.0014332984574139118, -1.6689286894688848e-06, -0.0013262771535664797, -6.318072337307967e-06, -1.9192511899746023e-05, -0.17974942922592163, 0.0, 0.0, -2.3841855067985307e-07, -1.6689286894688848e-06, -1.5497195136049413e-06, -3.814689989667386e-06, -0.3132724463939667, -1.5616295058862306e-05, -2.2172682292875834e-05, -1.1920928244535389e-07, 0.0, 0.0, -2.622600959512056e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -0.020577052608132362, -0.6326155066490173, -5.006777428206988e-06, -0.0007824220228940248, -0.004571225959807634, -3.981510963058099e-05, -3.576278118089249e-07, -4.768370445162873e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -4.410734163684538e-06, -1.7881377516459906e-06, -1.4305104514278355e-06, -1.0728830375228426e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -1.5020257706055418e-05, -1.1920928244535389e-07, -2.0265373677830212e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -4.0531076592742465e-06, -1.4305104514278355e-06, -1.1920928244535389e-07, -2.622600959512056e-06, -2.264974000354414e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -2.50339189733495e-06, -0.10021607577800751, -0.4740908741950989, -7.152555099310121e-07, -0.008624331094324589, -0.08357229083776474, -0.16023334860801697, -7.509902934543788e-05, -2.622600959512056e-06, -0.009756498970091343, -2.5629668016335927e-05, -0.6329229474067688, -1.2159273865108844e-05, -3.123234637314454e-