     if w == 50:\n            cnt1 += 1\n        else:\n            cnt2 += 1\n\n    # precompute nCr up to 100\n    nCr = [[0]*100 for _ in range(100)]\n    for i in range(100):\n        for j in range(i+1):\n            if j == 0 or j == i:\n                nCr[i][j] = 1\n            else:\n                nCr[i][j] = (nCr[i-1][j] + nCr[i-1][j-1]) % MOD\n\n    # dist and dp arrays: [x][y][z] where x = number of 50kg on left, y = number of 100kg on left, z = side (0 left, 1 right)\n    dist = [[[INF]*2 for _ in range(200)] for __ in range(200)]\n    dp = [[[0]*2 for _ in range(200)] for __ in range(200)]\n    dist[0][0][0] = 0\n    dp[0][0][0] = 1\n\n    # queue as list with head/tail pointers\n    queue = [0] * (200*200*2)\n    head = 0\n    tail = 0\n\n    def pack(x, y, z):\n        return (x * 200 + y) * 2 + z\n\n    queue[tail] = pack(0, 0, 0)\n    tail += 1\n\n    while head < tail:\n        id = queue[head]\n        head += 1\n        z = id & 1\n        t = id >> 1\n        y = t % 200\n        x = t // 200\n        d = dist[x][y][z]\n\n        if z == 0:  # boat on left, move to right\n            remX = cnt1 - x\n            remY = cnt2 - y\n            for i in range(remX + 1):\n                if i * 50 > K:\n                    break\n                for j in range(remY + 1):\n                    if i * 50 + j * 100 > K:\n                        break\n                    if i + j == 0:\n                        continue\n                    ways = dp[x][y][z] * nCr[remX][i] % MOD\n                    ways = ways * nCr[remY][j] % MOD\n                    nx = x + i\n                    ny = y + j\n                    nz = z ^ 1\n                    if dist[nx][ny][nz] >= d + 1:\n                        if dist[nx][ny][nz] > d + 1:\n                            dist[nx][ny][nz] = d + 1\n                            dp[nx][ny][nz] = ways\n                            queue[tail] = pack(nx, ny, nz)\n                            tail += 1\n                        else:\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + ways) % MOD\n        else:  # boat on right, move to left\n            remX = x\n            remY = y\n            for i in range(remX + 1):\n                if i * 50 > K:\n                    break\n                for j in range(remY + 1):\n                    if i * 50 + j * 100 > K:\n                        break\n                    if i + j == 0:\n                        continue\n                    ways = dp[x][y][z] * nCr[remX][i] % MOD\n                    ways = ways * nCr[remY][j] % MOD\n                    nx = x - i\n                    ny = y - j\n                    nz = z ^ 1\n                    if dist[nx][ny][nz] >= d + 1:\n                        if dist[nx][ny][nz] > d + 1:\n                            dist[nx][ny][nz] = d + 1\n                            dp[nx][ny][nz] = ways\n                            queue[tail] = pack(nx, ny, nz)\n                            tail += 1\n                        else:\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + ways) % MOD\n\n    if dist[cnt1][cnt2][1] == INF:\n        print(-1)\n        print(dp[cnt1][cnt2][1])\n    else:\n        print(dist[cnt1][cnt2][1])\n        print(dp[cnt1][cnt2][1])\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.2172682292875834e-05, -2.3841855067985307e-07, 0.0, -7.319182623177767e-05, -0.0015911312075331807, 0.0, -0.04862048476934433, -0.020295102149248123, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.1616290875244886e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -0.0011815002653747797, -1.1920928244535389e-07, -4.768370445162873e-07, -1.1086402082582936e-05, -0.31329545378685, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -6.318072337307967e-06, -9.202533692587167e-05, -0.004815409891307354, -0.0013225865550339222, -0.054477229714393616, -0.1271307766437530