  int K = ni();\n            int cnt1 = 0, cnt2 = 0;\n\n            for (int i = 0; i < 100; i++) {\n                for (int j = 0; j <= i; j++) {\n                    if (j == 0 || j == i)\n                        nCr[i][j] = 1;\n                    else\n                        nCr[i][j] = (nCr[i - 1][j] + nCr[i - 1][j - 1]) % mod;\n                }\n            }\n\n            for (int i = 0; i < n; i++) {\n                if (ni() == 50)\n                    cnt1++;\n                else\n                    cnt2++;\n            }\n\n            long[][][] dist = new long[200][200][2];\n            long[][][] dp = new long[200][200][2];\n            for (int i = 0; i < 200; i++)\n                for (int j = 0; j < 200; j++)\n                    Arrays.fill(dist[i][j], INF);\n\n            dist[0][0][0] = 0;\n            dp[0][0][0] = 1;\n\n            int[] queue = new int[200 * 200 * 2];\n            int head = 0, tail = 0;\n            queue[tail++] = pack(0, 0, 0);\n\n            while (head < tail) {\n                int id = queue[head++];\n                int z = id & 1;\n                int t = id >> 1;\n                int y = t % 200;\n                int x = t / 200;\n                long d = dist[x][y][z];\n\n                if (z == 0) {\n                    int remX = cnt1 - x;\n                    int remY = cnt2 - y;\n                    for (int i = 0; i <= remX; i++) {\n                        for (int j = 0; j <= remY; j++) {\n                            if (i + j == 0)\n                                continue;\n                            if (i * 50 + j * 100 > K)\n                                break;\n                            long ways = f(dp[x][y][z], remX, i, remY, j);\n                            int nx = x + i;\n                            int ny = y + j;\n                            int nz = z ^ 1;\n                            if (dist[nx][ny][nz] >= d + 1) {\n                                if (dist[nx][ny][nz] > d + 1) {\n                                    dist[nx][ny][nz] = d + 1;\n                                    dp[nx][ny][nz] += ways;\n                                    dp[nx][ny][nz] %= mod;\n                                    queue[tail++] = pack(nx, ny, nz);\n                                } else {\n                                    dp[nx][ny][nz] += ways;\n                                    dp[nx][ny][nz] %= mod;\n                                }\n                            }\n                        }\n                    }\n                } else {\n                    int remX = x;\n                    int remY = y;\n                    for (int i = 0; i <= remX; i++) {\n                        for (int j = 0; j <= remY; j++) {\n                            if (i + j == 0)\n                                continue;\n                            if (i * 50 + j * 100 > K)\n                                break;\n                            long ways = f(dp[x][y][z], remX, i, remY, j);\n                            int nx = x - i;\n                            int ny = y - j;\n                            int nz = z ^ 1;\n                            if (dist[nx][ny][nz] >= d + 1) {\n                                if (dist[nx][ny][nz] > d + 1) {\n                                    dist[nx][ny][nz] = d + 1;\n                                    dp[nx][ny][nz] += ways;\n                                    dp[nx][ny][nz] %= mod;\n                                    queue[tail++] = pack(nx, ny, nz);\n                                } else {\n                                    dp[nx][ny][nz] += ways;\n                                    dp[nx][ny][nz] %= mod;\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n\n            if (dist[cnt1][cnt2][1] == INF)\n                pn(-1);\n            else\n                pn(dist[cnt1][cnt2][1]);\n            pn(dp[cnt1][cnt2][1]);\n   