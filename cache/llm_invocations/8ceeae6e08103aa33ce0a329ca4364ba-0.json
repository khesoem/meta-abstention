n    private static long[] rearrange(long[] arr, int k) {\n        long[] res = new long[arr.length];\n        for (int i = 0; i < arr.length; i++) {\n            res[bitReverse(i, k)] = arr[i];\n        }\n        return res;\n    }\n\n    private static long[] nttCompute(long[] coef, int k, boolean inverse) {\n        coef = rearrange(coef, k);\n        long[] roots = generateRoots(k, inverse);\n        for (int s = 0; s < k; s++) {\n            int len = 1 << s;\n            for (int st = 0; st < coef.length; st += 2 * len) {\n                long curRoot = 1;\n                for (int j = st; j < st + len; j++) {\n                    long t = (curRoot * coef[j + len]) % MOD;\n                    long u = coef[j];\n                    coef[j] = (u + t) % MOD;\n                    long diff = u - t;\n                    if (diff < 0) diff += MOD;\n                    coef[j + len] = diff % MOD;\n                    curRoot = (roots[s] * curRoot) % MOD;\n                }\n            }\n        }\n        return coef;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt() / 2;\n        int m = sc.nextInt();\n        int[] nums = new int[m];\n        int maxVal = 0;\n        for (int i = 0; i < m; i++) {\n            nums[i] = sc.nextInt();\n            maxVal = Math.max(maxVal, nums[i]);\n        }\n        int requiredSize = n * maxVal + 1;\n        int k = 0, size = 1;\n        while (size < requiredSize) {\n            size <<= 1;\n            k++;\n        }\n        long[] poly = new long[size];\n        for (int num : nums) poly[num] = 1;\n        poly = nttCompute(poly, k, false);\n        for (int i = 0; i < size; i++) poly[i] = modPow(poly[i], n);\n        poly = nttCompute(poly, k, true);\n        long sum = 0;\n        for (int i = 0; i < size; i++) sum = (sum + poly[i] * poly[i]) % MOD;\n        long invSize = modInverse(size);\n        System.out.println((sum * invSize % MOD) 