 = {false, true, true, true, true, true, true};\n        int state = 0;\n        for (int i = 1; i <= 6; ++i) {\n            for (int j = i + 1; j <= 6; ++j) {\n                for (int k = j + 1; k <= 6; ++k) {\n                    if (valid(i, j, k)) {\n                        used[i] = used[j] = used[k] = false;\n                        int x = -1, y = -1, z = -1;\n                        for (int l = 1; l <= 6; ++l) {\n                            if (!used[l]) {\n                                if (x == -1) x = l;\n                                else if (y == -1) y = l;\n                                else z = l;\n                            }\n                        }\n                        used[i] = used[j] = used[k] = true;\n                        if (z != -1) state |= mask3[x][y][z];\n                    }\n                }\n            }\n        }\n        dp[state] = add(dp[state], cur);\n        return;\n    }\n    g[r][c] = 1;\n    int nxt = mul(cur, p[r][c]);\n    if (c == 6) dfs1(nxt, r + 1, 1);\n    else dfs1(nxt, r, c + 1);\n    g[r][c] = 0;\n    nxt = mul(cur, sub(1, p[r][c]));\n    if (c == 6) dfs1(nxt, r + 1, 1);\n    else dfs1(nxt, r, c + 1);\n}\n\nvoid dfs2(int cur, int r, int c) {\n    if (!cur) return;\n    if (r == 7) {\n        int state = 0;\n        for (int i = 1; i <= 6; ++i) {\n            for (int j = i + 1; j <= 6; ++j) {\n                for (int k = j + 1; k <= 6; ++k) {\n                    if (valid(i, j, k)) state |= mask3[i][j][k];\n                }\n            }\n        }\n        ans = add(ans, mul(cur, dp[fullMask ^ state]));\n        return;\n    }\n    g[r - 3][c] = 1;\n    int nxt = mul(cur, p[r][c]);\n    if (c == 6) dfs2(nxt, r + 1, 1);\n    else dfs2(nxt, r, c + 1);\n    g[r - 3][c] = 0;\n    nxt = mul(cur, sub(1, p[r][c]));\n    if (c == 6) dfs2(nxt, r + 1, 1);\n    else dfs2(nxt, r, c + 1);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> n;\n    int inv100 = modPow(100, MOD