tic class Edge {\n        int to, capacity, cost, rev;\n        Edge(int to, int capacity, int cost, int rev) {\n            this.to = to;\n            this.capacity = capacity;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int V;\n        int[] H, dis, PreV, PreE;\n        ArrayList<Edge>[] G;\n\n        @SuppressWarnings(\"unchecked\")\n        void Init(int n) {\n            V = n;\n            G = new ArrayList[V + 1];\n            for (int i = 0; i <= V; ++i) G[i] = new ArrayList<>();\n            H = new int[V + 1];\n            dis = new int[V + 1];\n            PreV = new int[V + 1];\n            PreE = new int[V + 1];\n        }\n\n        void add_edge(int from, int to, int cap, int cost) {\n            G[from].add(new Edge(to, cap, cost, G[to].size()));\n            G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n        }\n\n        int minCost(int s, int t, int f) {\n            int flow = 0;\n            int res = 0;\n            Arrays.fill(H, 0);\n            while (f > 0) {\n                PriorityQueue<int[]> q = new PriorityQueue<>((a, b) -> a[0] - b[0]);\n                Arrays.fill(dis, Integer.MAX_VALUE / 2);\n                dis[s] = 0;\n                q.offer(new int[]{0, s});\n                while (!q.isEmpty()) {\n                    int[] now = q.poll();\n                    int v = now[1];\n                    if (dis[v] < now[0]) continue;\n                    for (int i = 0; i < G[v].size(); ++i) {\n                        Edge e = G[v].get(i);\n                        if (e.capacity > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n                            dis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n                            PreV[e.to] = v;\n                            PreE[e.to] = i;\n                            q.offer(new int[]{dis[e.to], e.to});\n                        }\n                    }\n                }\n                if (dis[t] == Integer.MAX_VALUE / 2) break;\n                for (int i = 0; i <= V; ++i) H[i] += dis[i];\n                int d = f;\n                for (int v = t; v != s; v = PreV[v]) {\n                    d = Math.min(d, G[PreV[v]].get(PreE[v]).capacity);\n                }\n                f -= d;\n                flow += d;\n                res += d * H[t];\n                for (int v = t; v != s; v = PreV[v]) {\n                    Edge e = G[PreV[v]].get(PreE[v]);\n                    e.capacity -= d;\n                    G[v].get(e.rev).capacity += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MinCostMaxFlow mcmf = new MinCostMaxFlow();\n        mcmf.Init(n * (n + 55) + 2);\n        for (int i = 0; i < k; ++i) {\n            int u = sc.nextInt();\n            mcmf.add_edge(0, u, 1, 0);\n        }\n\n        List<int[]> edges = new ArrayList<>();\n        for (int i = 0; i < m; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            edges.add(new int[]{x, y});\n        }\n\n        int tar = n * (n + 55) + 1;\n        for (int t = 0; t < n + 54; ++t) {\n            for (int[] e : edges) {\n                for (int j = 1; j <= k; ++j) {\n                    mcmf.add_edge(e[0] + t * n, e[1] + (t + 1) * n, 1, c + d * (j * 2 - 1));\n                    mcmf.add_edge(e[1] + t * n, e[0] + (t + 1) * n, 1, c + d * (j * 2 - 1));\n                }\n            }\n            for (int i = 2; i <= n; ++i) {\n                mcmf.add_edge(i + t * n, i + (t + 1) * n, k, c);\n            }\n            mcmf.add_edge(1 + t * n, tar, k, 0);\n        }\n\n        System.out.println(mcmf.minCost(0, tar, k));\n        sc.close();\n    }\n}\n</translat