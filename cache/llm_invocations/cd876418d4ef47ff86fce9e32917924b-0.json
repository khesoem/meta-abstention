dd(int x, int y) {\n        x += y;\n        if (x >= md) x -= md;\n        return x;\n    }\n\n    static int sub(int x, int y) {\n        x -= y;\n        if (x < 0) x += md;\n        return x;\n    }\n\n    static int mul(int x, int y) {\n        return (int)((long)x * y % md);\n    }\n\n    static int fpow(int x, int y) {\n        int ans = 1;\n        while (y > 0) {\n            if ((y & 1) == 1) ans = mul(ans, x);\n            y >>= 1;\n            x = mul(x, x);\n        }\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        md = sc.nextInt();\n        sc.close();\n\n        // Pascal triangle\n        Cbin = new int[n + 1][n + 1];\n        for (int i = 0; i <= n; i++) {\n            Cbin[i][0] = Cbin[i][i] = 1;\n            for (int j = 1; j < i; j++) {\n                Cbin[i][j] = add(Cbin[i - 1][j - 1], Cbin[i - 1][j]);\n            }\n        }\n\n        // factorials and inverse factorials\n        fac = new int[n + 1];\n        inv = new int[n + 1];\n        fac[0] = 1;\n        for (int i = 1; i <= n; i++) fac[i] = mul(fac[i - 1], i);\n        inv[n] = fpow(fac[n], md - 2);\n        for (int i = n; i >= 1; i--) inv[i - 1] = mul(inv[i], i);\n\n        // f and g arrays\n        f = new int[n + 1];\n        g = new int[n + 1];\n        f[0] = 0;\n        g[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= i; j++) {\n                int now = mul(Cbin[i - 1][j - 1], i + 1);\n                g[i] = add(g[i], mul(mul(g[j - 1], g[i - j]), now));\n                f[i] = add(f[i], mul(mul(f[j - 1], g[i - j]), now));\n                f[i] = add(f[i], mul(mul(g[j - 1], f[i - j]), now));\n                int extra = (j - 1) * j / 2 + (i - j) * (i - j + 1) / 2;\n                f[i] = add(f[i], mul(mul(Cbin[i - 1][j - 1], mul(g[j - 1], g[i - j])), extra));\n            }\n        }\n\n        // DP tables\n        dp = new int[n + 1][m + 1][2];\n        dp2 = new int[n + 1][m + 1][2];\n        dp2[0][0][1] = 1; // dp[0][0][1] is already 0\n\n        for (int i = 1; i <= n; i++) {\n            int maxJ = Math.min(i, m);\n            for (int j = 0; j <= maxJ; j++) {\n                // dp[i][j][1] and dp2[i][j][1] from previous row\n                int prev0 = (j <= i - 1) ? dp[i - 1][j][0] : 0;\n                int prev1 = (j <= i - 1) ? dp[i - 1][j][1] : 0;\n                dp[i][j][1] = add(prev0, prev1);\n                int prev20 = (j <= i - 1) ? dp2[i - 1][j][0] : 0;\n                int prev21 = (j <= i - 1) ? dp2[i - 1][j][1] : 0;\n                dp2[i][j][1] = add(prev20, prev21);\n\n                // dp[i][j][0] and dp2[i][j][0] from smaller components\n                for (int k = 1; k <= j; k++) {\n                    int comb = Cbin[j][k];\n                    int term1 = mul(comb, mul(dp2[i - k][j - k][1], f[k]));\n                    dp[i][j][0] = add(dp[i][j][0], term1);\n                    int term2 = mul(comb, mul(dp[i - k][j - k][1], g[k]));\n                    dp[i][j][0] = add(dp[i][j][0], term2);\n                    int term3 = mul(comb, mul(dp2[i - k][j - k][1], g[k]));\n                    dp2[i][j][0] = add(dp2[i][j][0], term3);\n                }\n            }\n        }\n\n        int ans = add(dp[n][m][0], dp[n][m][1]);\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.7523612768854946e-05, 0.0, -1.1920928244535389e-07, -4.446407547220588e-05, -0.000285584683297202, -1.1920928244535389e-07, -4.2914423829643056e-05, -0.029895512387156487, -0.00043406602344475687, -4.6491513785440475e-06, 0.0, -7.271740287251305e-06, -0.0007120219524949789, -7.510157047363464e-06, -0.003186864545568824, -0.0002696150622796267, -0.1150563657283783, -0.56550133228302, -0.018150312826037407, -7.748303323751315e-05, -0.00010227633902104571, -0.39166152477264404, -3.51661