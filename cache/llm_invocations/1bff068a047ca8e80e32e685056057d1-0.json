 int N;\n        int[][] a = new int[MAXN][MAXN];\n\n        void init(int _N, int _V) {\n            N = _N;\n            for (int i = 0; i < N; i++) {\n                for (int j = 0; j < N; j++) {\n                    a[i][j] = _V;\n                }\n            }\n        }\n\n        void mul(Matrix b) {\n            // copy this to l, b to r\n            for (int i = 0; i < N; i++) {\n                System.arraycopy(this.a[i], 0, l.a[i], 0, N);\n                System.arraycopy(b.a[i], 0, r.a[i], 0, N);\n            }\n            // compute product\n            for (int i = 0; i < N; i++) {\n                for (int j = 0; j < N; j++) {\n                    long t = 0;\n                    for (int k = 0; k < N; k++) {\n                        t += (long) l.a[i][k] * r.a[k][j] % MOD;\n                    }\n                    this.a[i][j] = (int) (t % MOD);\n                }\n            }\n        }\n    }\n\n    static void pre_calc(int i) {\n        prefix[i][1] = new Matrix();\n        prefix[i][1].init(k + 1, 0);\n        for (int p = 0; p < k + 1; p++) {\n            System.arraycopy(A[i][0].a[p], 0, prefix[i][1].a[p], 0, k + 1);\n        }\n        for (int j = 2; j <= k; j++) {\n            prefix[i][j] = new Matrix();\n            prefix[i][j].init(k + 1, 0);\n            for (int p = 0; p < k + 1; p++) {\n                System.arraycopy(prefix[i][j - 1].a[p], 0, prefix[i][j].a[p], 0, k + 1);\n            }\n            prefix[i][j].mul(A[i][j - 1]);\n        }\n        suffix[i][k - 1] = new Matrix();\n        suffix[i][k - 1].init(k + 1, 0);\n        for (int p = 0; p < k + 1; p++) {\n            System.arraycopy(A[i][k - 1].a[p], 0, suffix[i][k - 1].a[p], 0, k + 1);\n        }\n        for (int j = k - 2; j >= 0; j--) {\n            suffix[i][j] = new Matrix();\n            suffix[i][j].init(k + 1, 0);\n            for (int p = 0; p < k + 1; p++) {\n                System.arraycopy(A[i][j].a[p], 0, suffix[i][j].a[p], 0, k + 1);\n            }