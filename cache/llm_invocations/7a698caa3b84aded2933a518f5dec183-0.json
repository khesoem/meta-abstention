{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MOD = 1000000007;\nusing ull = unsigned long long;\n\nint n;\nint p[10][10];\nint q[10][64];\n\nint qpow(int a,int b) {\n    int res = 1;\n    while(b) {\n        if(b & 1) res = 1LL * res * a % MOD;\n        a = 1LL * a * a % MOD;\n        b >>= 1;\n    }\n    return res;\n}\n\null transition(ull s,int mask) {\n    ull t = s;\n    int M = 1 << n;\n    for(int j = 0; j < M; ++j)\n        for(int k = 0; k < n; ++k)\n            if(((j >> k) & 1) && ((mask >> k) & 1) && ((s >> (j ^ (1 << k))) & 1))\n                t |= (1ull << j);\n    return t;\n}\n\nvoid addTo(map<ull,int>& mp, ull state, int val) {\n    if(val == 0) return;\n    auto it = mp.find(state);\n    if(it == mp.end()) {\n        mp.emplace(state, val);\n    } else {\n        it->second += val;\n        if(it->second >= MOD) it->second -= MOD;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n;\n\n    for(int i = 0; i < n; ++i)\n        for(int j = 0; j < n; ++j) {\n            cin >> p[i][j];\n            p[i][j] = 1LL * p[i][j] * qpow(100, MOD - 2) % MOD;\n        }\n\n    for(int i = 0; i < n; ++i)\n        for(int mask = 0; mask < (1 << n); ++mask) {\n            q[i][mask] = 1;\n            for(int k = 0; k < n; ++k) {\n                if((mask >> k) & 1)\n                    q[i][mask] = 1LL * q[i][mask] * p[k][i] % MOD;\n                else\n                    q[i][mask] = 1LL * q[i][mask] * (MOD + 1 - p[k][i]) % MOD;\n            }\n        }\n\n    map<ull,int> cur, nxt;\n    cur[1] = 1;\n    int M = 1 << n;\n\n    for(int i = 0; i < n; ++i) {\n        nxt.clear();\n        for(const auto &pr : cur) {\n            ull s = pr.first;\n            int val = pr.second;\n            for(int mask = 0; mask < M; ++mask) {\n                int delta = 1LL * val * q[i][mask] % MOD;\n                if(delta) addTo(nxt, transition(s, mask), delta);\n            }\n        }\n        cur.swap(nxt);\n    }\n\n    ull target;\n    if(n < 6) target = (1ull << (1 << n)) - 1;\n    else target = numeric_limits<ull>::max();\n\n    auto it = cur.find(target);\n    cout << (it == cur.end() ? 0 : it->second) << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef qpow(a, b):\n    # Not needed, use pow(a, b, MOD) instead\n    return pow(a, b, MOD)\n\ndef transition(s, mask, n):\n    M = 1 << n\n    t = s\n    for j in range(M):\n        for k in range(n):\n            if ((j >> k) & 1) and ((mask >> k) & 1) and ((s >> (j ^ (1 << k))) & 1):\n                t |= (1 << j)\n    return t\n\ndef add_to(mp, state, val):\n    if val == 0:\n        return\n    if state in mp:\n        mp[state] = (mp[state] + val) % MOD\n    else:\n        mp[state] = val\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    p = [[0]*n for _ in range(n)]\n    inv100 = pow(100, MOD-2, MOD)\n    for i in range(n):\n        for j in range(n):\n            p[i][j] = int(next(it)) * inv100 % MOD\n\n    M = 1 << n\n    q = [[0]*M for _ in range(n)]\n    for i in range(n):\n        for mask in range(M):\n            prod = 1\n            for k in range(n):\n                if (mask >> k) & 1:\n                    prod = prod * p[k][i] % MOD\n                else:\n                    prod = prod * (MOD + 1 - p[k][i]) % MOD\n            q[i][mask] = prod\n\n    cur = {1: 1}\n    for i in range(n):\n        nxt = {}\n        for s, val in cur.items():\n            for mask in range(M):\n                delta = val * q[i][mask] % MOD\n                if delta:\n                    add_to(nxt, transition(s, mask, n), delta)\n        cur = nxt\n\n    if n < 6:\n        target = (1 << (1 << n)) - 1\n    else:\n        target = (1 << 64) - 1\n\n    result = cur.get(target, 0)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-5.936446541454643e-05, 0.0, -2.3841855067985307e-07, -0.00035720644518733025, -0.0016398091102018952, 0.0, -0.008616294711828232, -8.344646857949556e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -8.105902816168964e-05, -6.198863957251888e-06, -2.3841855067985307e-07, 0.0, -0.0007114263135008514, -0.00017045476124621928, -0.017985470592975616, 0.0, -1.9073468138230965e-06, -0.0011832863092422485, 0.0, -0.0004903068183921278, -1.1920928244535389e-07, -0.5379549264907837, -1.7569602727890015, -0.5434539318084717, -0.5744709372520447, -0.19076402485370636, -0.03819632902741432, -0.5874303579330444, -0.01416344940662384, -3.576278118089249e-07, -1.1920928244535389e-07, -8.22540732769994e-06, -0.3135027587413788, -0.16419151425361633, -0.3075743615627289, -1.1920928244535389e-07, -0.31529223918914795, -1.4066597032069694e-05, -7.152555099310121e-07, -6.198863957251888e-06, -1.1920928244535389e-07, -7.152555099310121e-07, -7.