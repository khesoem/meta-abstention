e2[2]);\n        \n        System.out.println(min_score(r1, s1, p1, r2, s2, p2) + \" \" + max_score(r1, s1, p1, r2, s2, p2));\n    }\n    \n    public static int max_score(int r1, int s1, int p1, int r2, int s2, int p2) {\n        return Math.min(r1, s2) + Math.min(s1, p2) + Math.min(p1, r2);\n    }\n    \n    public static int win_lose(int a, int b) {\n        if (a == b) {\n            return 0;\n        } else if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) {\n            return 1;\n        }\n        return -1;\n    }\n    \n    public static int match_game(List<int[]> arr1, List<int[]> arr2) {\n        int score = 0;\n        int[] c1 = new int[2];\n        int[] c2 = new int[2];\n        boolean c1_valid = false;\n        boolean c2_valid = false;\n        \n        while (!arr1.isEmpty() || !arr2.isEmpty()) {\n            try {\n                if (!c1_valid && !arr1.isEmpty()) {\n                    int[] last = arr1.remove(arr1.size() - 1);\n                    c1[0] = last[0];\n                    c1[1] = last[1];\n                    c1_valid = true;\n                }\n                if (!c2_valid && !arr2.isEmpty()) {\n                    int[] last = arr2.remove(arr2.size() - 1);\n                    c2[0] = last[0];\n                    c2[1] = last[1];\n                    c2_valid = true;\n                }\n            } catch (Exception e) {\n                break;\n            }\n            \n            if (!c1_valid || !c2_valid) {\n                break;\n            }\n            \n            score += Math.max(0, Math.min(c1[0], c2[0]) * win_lose(c1[1], c2[1]));\n            \n            if (c1[0] < c2[0]) {\n                c2[0] -= c1[0];\n                c1_valid = false;\n            } else if (c1[0] > c2[0]) {\n                c1[0] -= c2[0];\n                c2_valid = false;\n            } else {\n                c1_valid = false;\n                c2_valid = false;\n            }\n        }\n        return score;\n    }\n    \n    public static int min_score(int r1, int s1, int p1, int r2, int s2, int p2) {\n        List<int[]> options1 = new ArrayList<>();\n        options1.add(new int[]{r1, 1});\n        options1.add(new int[]{s1, 2});\n        options1.add(new int[]{p1, 3});\n        \n        List<int[]> options2 = new ArrayList<>();\n        options2.add(new int[]{r2, 1});\n        options2.add(new int[]{s2, 2});\n        options2.add(new int[]{p2, 3});\n        \n        List<List<int[]>> perm1 = permute(options1);\n        List<List<int[]>> perm2 = permute(options2);\n        \n        int result = Integer.MAX_VALUE;\n        for (List<int[]> a : perm1) {\n            for (List<int[]> b : perm2) {\n                List<int[]> arr_a = new ArrayList<>();\n                for (int[] x : a) {\n                    arr_a.add(new int[]{x[0], x[1]});\n                }\n                List<int[]> arr_b = new ArrayList<>();\n                for (int[] x : b) {\n                    arr_b.add(new int[]{x[0], x[1]});\n                }\n                int score = match_game(arr_a, arr_b);\n                if (score < result) {\n                    result = score;\n                }\n            }\n        }\n        return result;\n    }\n    \n    public static List<List<int[]>> permute(List<int[]> nums) {\n        List<List<int[]>> result = new ArrayList<>();\n        permuteHelper(nums, 0, result);\n        return result;\n    }\n    \n    public static void permuteHelper(List<int[]> nums, int start, List<List<int[]>> result) {\n        if (start == nums.size()) {\n            result.add(new ArrayList<>(nums));\n            return;\n        }\n        for (int i = start; i < nums.size(); i++) {\n            Collections.swap(nums, i, start);\n            permuteHelper(nums, start + 1, result);\n            Collections.swap(nums, start, i);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002797450579237193, -2.98022769129