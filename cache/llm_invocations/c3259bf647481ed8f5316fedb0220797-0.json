                  Edge e = g[v].get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.offer(new int[]{dist[e.to], e.to});\n                        }\n                    }\n                }\n                if (dist[t] == INF) return -1;\n                for (int i = 0; i < V; ++i) {\n                    h[i] += dist[i];\n                }\n                int flow = f;\n                for (int v = t; v != s; v = prevv[v]) {\n                    flow = Math.min(flow, g[prevv[v]].get(preve[v]).cap);\n                }\n                f -= flow;\n                res += flow * h[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g[prevv[v]].get(preve[v]);\n                    e.cap -= flow;\n                    g[v].get(e.rev).cap += flow;\n                }\n            }\n            return res;\n        }\n    }\n\n    static MCF mcf;\n    static int n, m, k, c, d;\n    static int[] a = new int[50];\n    static int[] cnt = new int[50];\n    static List<Integer>[] adj = new List[50];\n    static final int TIME_STEPS = 100;\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        for (int i = 0; i < k; ++i) {\n            a[i] = sc.nextInt();\n            ++cnt[a[i] - 1];\n        }\n        \n        for (int i = 0; i < 50; ++i) {\n            adj[i] = new ArrayList<>();\n        }\n        \n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            --u;\n            --v;\n            adj[u].add(v);\n            adj[v].add(u);\n        }\n        \n        mcf = new MCF(n * TIME_STEPS + 2);\n        for (int i = 0; i < n; ++i) {\n            mcf.add_edge(n * TIME_STEPS, i, cnt[i], 0);\n        }\n        for (int t = 0; t < TIME_STEPS; ++t) {\n            mcf.add_edge(t * n, n * TIME_STEPS + 1, k, c * t);\n        }\n        for (int i = 0; i < n; ++i) {\n            for (int t = 0; t < TIME_STEPS - 1; ++t) {\n                mcf.add_edge(t * n + i, (t + 1) * n + i, k, 0);\n            }\n            for (int to : adj[i]) {\n                for (int t = 0; t < TIME_STEPS - 1; ++t) {\n                    for (int u = 0; u < k; ++u) {\n                        int cost = (u + 1) * (u + 1) * d - u * u * d;\n                        mcf.add_edge(t * n + i, (t + 1) * n + to, 1, cost);\n                    }\n                }\n            }\n        }\n        System.out.println(mcf.solve(n * TIME_STEPS, n * TIME_STEPS + 1, k));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001656871900195256, -2.264974000354414e-06, -8.344646857949556e-07, -0.007019028067588806, -9.357491217087954e-05, -0.054887156933546066, -0.5232020616531372, -8.880697714630514e-05, -5.960462772236497e-07, -6.115249561844394e-05, -0.016034817323088646, -4.565611743601039e-05, -0.001116367639042437, -0.20301948487758636, -2.9802276912960224e-06, -5.507317473529838e-05, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, -8.344646857949556e-07, -3.576278118089249e-07, 0.0, -2.0265558760002023e-06, -1.1920928244535389e-07, -1.1920922133867862e-06, -3.3378546504536644e-06, -9.536738616588991e-07, -7.867782187531702e-06, -7.152555099310121e-07, -7.033323527139146e-06, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, -0.08893978595733643, -5.960462772236497e-07, -4.529942543740617e-06, -4.887569048150908e-06, -1.8596476365928538e-05, -4.768370445162873e-07, -9.536738616588991e-07, -1.1920928244535389e-07, -1.6689286894688848e-06, -2.0265558760002023e-06, -1.9073468138230965e-06, 0.0, -2.384