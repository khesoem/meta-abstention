irs = 0;\n\n        for (int i = 1; i < n; i++) {\n            if (!visited[i]) {\n                dfs(i, adj, visited);\n                pairs++;\n            }\n        }\n\n        if (k == 1) {\n            System.out.println(modPow(n, n, MOD));\n        } else {\n            System.out.println(modPow(n, pairs, MOD));\n        }\n    }\n\n    static void dfs(int start, int[] adj, boolean[] visited) {\n        int n = adj.length - 1;\n        int nCurrent = start;\n        visited[nCurrent] = true;\n        while (!visited[adj[nCurrent]]) {\n            nCurrent = adj[nCurrent];\n            visited[nCurrent] = true;\n        }\n    }\n\n    static long modPow(long base, long exp, long mod) {\n        long result = 1;\n        base = base % mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.03178892284631729, -0.00018685187387745827, -1.0280383548888494e-06, -2.963691804325208e-05, -1.7432603272027336e-06, -1.9361264946837764e-07, -0.0004882152716163546, -0.01744074746966362, -0.009762344881892204, -2.339278580620885e-06, -3.128163257315464e-07, -0.00030424181022681296, -0.008621077984571457, -0.00018506382184568793, -0.26170405745506287, 0.0, -0.0029949357267469168, -2.696889623621246e-06, -4.723352049040841e-06, -9.088346359931165e-07, -5.512236498361744e-07, -0.0004904801025986671, -3.5716304410016164e-05, -3.128163257315464e-07, -0.0013284528395161033, -0.2529676556587219, -2.0219828002154827e-05, -1.9361264946837764e-07, 0.0, 0.0, -1.9361264946837764e-07, -0.02642442099750042, -0.008671184070408344, -0.030818337574601173, -9.472211968386546e-05, -0.0008266602526418865, -7.982165698194876e-05, -3.4121114822482923e-06, 0.0, -0.0010718696285039186, 0.0, -1.9361264946837764e-07, -1.9361264946837764