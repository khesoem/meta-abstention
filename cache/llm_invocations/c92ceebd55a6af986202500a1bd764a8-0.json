irs = 0;\n\n        for (int i = 1; i < n; i++) {\n            if (!visited[i]) {\n                dfs(i, adj, visited);\n                pairs++;\n            }\n        }\n\n        if (k == 1) {\n            System.out.println(pow(n, n, mod));\n        } else {\n            System.out.println(pow(n, pairs, mod));\n        }\n        scanner.close();\n    }\n\n    private static void dfs(int n, int[] adj, boolean[] visited) {\n        visited[n] = true;\n        while (!visited[adj[n]]) {\n            n = adj[n];\n            visited[n] = true;\n        }\n    }\n\n    private static long pow(long base, int exp, long mod) {\n        long result = 1;\n        long curr = base % mod;\n        int e = exp;\n        while (e > 0) {\n            if ((e & 1) == 1) {\n                result = (result * curr) % mod;\n            }\n            curr = (curr * curr) % mod;\n            e >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0917515978217125, -0.0002477502857800573, -2.935296834039036e-06, -3.106736039626412e-05, -1.2664456789934775e-06, -1.9361264946837764e-07, -0.0006267757853493094, -0.012139685451984406, -0.006725549232214689, -1.8624639324116288e-06, -3.128163257315464e-07, -0.0003467865171842277, -0.007614201866090298, -0.00019710339256562293, -0.09375021606683731, 0.0, -0.0016781524755060673, -2.339278580620885e-06, -4.723352049040841e-06, -1.1472419600977446e-06, -6.704273118884885e-07, -0.0005557744298130274, -3.464347173576243e-05, -3.128163257315464e-07, -0.0021880913991481066, -0.2527552843093872, -3.023293538717553e-05, -1.9361264946837764e-07, 0.0, 0.0, -1.9361264946837764e-07, -0.026411423459649086, -0.00867011770606041, -0.050265565514564514, -3.953082341467962e-05, -0.0013574945041909814, -0.00020926215802319348, -1.0206720617134124e-05, 0.0, -0.0009861272992566228, 0.0, -1.9361264946837764e-07, -1.9361264946837764e-07, -2.570319702499546e-05, -1.5048530030981055e-0