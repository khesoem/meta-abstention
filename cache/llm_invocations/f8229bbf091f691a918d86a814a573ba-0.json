{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing ll = long long;\nusing tf = int;\nusing tc = int;\nconstexpr tf INF = 1000000000;\n\nstruct Edge {\n    int to, rev;\n    tf f, cap;\n    tc cost;\n};\n\nclass FlowNetwork {\nprivate:\n    int nodeCount;\n    vector<tc> d, phi;\n    vector<tf> f;\n    vector<int> pe, pv;\n    priority_queue<pair<tc, int>, vector<pair<tc, int>>, greater<pair<tc, int>>> pq;\n    vector<vector<Edge>> g;\n\npublic:\n    FlowNetwork(int n) : nodeCount(n), d(n), phi(n), f(n), pe(n), pv(n), g(n) {}\n\n    void addEdge(int u, int v, tf cap, tc cost) {\n        g[u].emplace_back(Edge{v, (int)g[v].size(), 0, cap, cost});\n        g[v].emplace_back(Edge{u, (int)g[u].size() - 1, 0, 0, -cost});\n    }\n\n    pair<tf, tc> compute(int s, int t) {\n        tf totalFlow = 0;\n        tc totalCost = 0;\n\n        while (true) {\n            pq.emplace(0, s);\n            fill(d.begin(), d.end(), INF);\n            d[s] = 0;\n            f[s] = INF;\n\n            while (!pq.empty()) {\n                auto [dist, u] = pq.top();\n                pq.pop();\n\n                if (dist != d[u]) continue;\n\n                for (int i = 0; i < (int)g[u].size(); ++i) {\n                    Edge &e = g[u][i];\n                    int v = e.to;\n\n                    if (e.cap <= e.f) continue;\n\n                    tc nd = d[u] + e.cost + phi[u] - phi[v];\n                    if (d[v] > nd) {\n                        d[v] = nd;\n                        pq.emplace(nd, v);\n                        pv[v] = u;\n                        pe[v] = i;\n                        f[v] = min(f[u], e.cap - e.f);\n                    }\n                }\n            }\n\n            if (d[t] == INF) break;\n\n            for (int i = 0; i < nodeCount; ++i)\n                phi[i] += d[i];\n\n            tf df = min(f[t], INF - totalFlow);\n            totalFlow += df;\n\n            for (int v = t; v != s; v = pv[v]) {\n                Edge &e = g[pv[v]][pe[v]];\n                e.f += df;\n                g[v][e.rev].f -= df;\n                totalCost += df * e.cost;\n            }\n        }\n\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int T = 150;\n    int N = n * T;\n    FlowNetwork network(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            network.addEdge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        network.addEdge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        network.addEdge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n\n        for (int j = 0; j < T - 1; ++j) {\n            int mult = 1;\n            for (int _ = 0; _ < k; ++_) {\n                network.addEdge(x * T + j, y * T + j + 1, 1, mult * d + c);\n                network.addEdge(y * T + j, x * T + j + 1, 1, mult * d + c);\n                mult += 2;\n            }\n        }\n    }\n\n    auto result = network.compute(N, N + 1);\n    assert(result.first == k);\n    cout << result.second << '\\n';\n\n    return 0;\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nINF = 1000000000\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'f', 'cap', 'cost')\n    def __init__(self, to, rev, f, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.f = f\n        self.cap = cap\n        self.cost = cost\n\nclass FlowNetwork:\n    def __init__(self, n):\n        self.nodeCount = n\n        self.d = [INF] * n\n        self.phi = [0] * n\n        self.f = [0] * n\n        self.pe = [-1] * n\n        self.pv = [-1] * n\n        self.g = [[] for _ in range(n)]\n    \n    def addEdge(self, u, v, cap, cost):\n        self.g[u].append(Edge(v, len(self.g[v]), 0, cap, cost))\n        self.g[v].append(Edge(u, len(self.g[u]) - 1, 0, 0, -cost))\n    \n    def compute(self, s, t):\n        totalFlow = 0\n        totalCost = 0\n        \n        while True:\n            # Dijkstra's algorithm with priority queue\n            pq = [(0, s)]\n            self.d = [INF] * self.nodeCount\n            self.d[s] = 0\n            self.f = [0] * self.nodeCount\n            self.f[s] = INF\n            self.pe = [-1] * self.nodeCount\n            self.pv = [-1] * self.nodeCount\n            \n            while pq:\n                dist, u = heapq.heappop(pq)\n                if dist != self.d[u]:\n                    continue\n                \n                for i in range(len(self.g[u])):\n                    e = self.g[u][i]\n                    v = e.to\n                    \n                    if e.cap <= e.f:\n                        continue\n                    \n                    nd = self.d[u] + e.cost + self.phi[u] - self.phi[v]\n                    if self.d[v] > nd:\n                        self.d[v] = nd\n                        heapq.heappush(pq, (nd, v))\n                        self.pv[v] = u\n                        self.pe[v] = i\n                        self.f[v] = min(self.f[u], e.cap - e.f)\n            \n            if self.d[t] == INF:\n                break\n            \n            for i in range(self.nodeCount):\n                self.phi[i] += self.d[i]\n            \n            df = min(self.f[t], INF - totalFlow)\n            totalFlow += df\n            \n            v = t\n            while v != s:\n                e = self.g[self.pv[v]][self.pe[v]]\n                e.f += df\n                self.g[v][e.rev].f -= df\n                totalCost += df * e.cost\n                v = self.pv[v]\n        \n        return (totalFlow, totalCost)\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d_val = int(data[idx]); idx += 1\n    \n    T = 150\n    N = n * T\n    network = FlowNetwork(N + 2)\n    \n    # Add edges for time progression\n    for i in range(n):\n        for j in range(T - 1):\n            network.addEdge(i * T + j, i * T + j + 1, INF, c)\n    \n    # Add edges from source to time 0\n    for i in range(T):\n        network.addEdge(i, N + 1, INF, 0)\n    \n    # Add edges for k starting positions\n    for _ in range(k):\n        x = int(data[idx]); idx += 1\n        x -= 1\n        network.addEdge(N, x * T, 1, 0)\n    \n    # Add edges for m connections\n    for _ in range(m):\n        x = int(data[idx]); idx += 1\n        y = int(data[idx]); idx += 1\n        x -= 1\n        y -= 1\n        \n        for j in range(T - 1):\n            mult = 1\n            for _ in range(k):\n                network.addEdge(x * T + j, y * T + j + 1, 1, mult * d_val + c)\n                network.addEdge(y * T + j, x * T + j + 1, 1, mult * d_val + c)\n                mult += 2\n    \n    result = network.compute(N, N + 1)\n    assert result[0] == k\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016485285595990717, -3.814689989667386e-06, -2.3841855067985307e-07, -7.509902934543788e-05, -0.08917009830474854, -0.06224701926112175, -0.043007105588912964, -6.83045873302035e-05, -0.20435850322246552, -0.2094411700963974, -1.1920928244535389e-07, -6.318072337307967e-06, 0.0, -2.50339189733495e-06, -0.0005538121913559735, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -6.663577369181439e-05, -7.271740287251305e-06, -2.753696753643453e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.20141401886940002, -5.864924969500862e-05, -4.529942543740617e-06, -4.887569048150908e-06, -0.0011735226726159453, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00016342257731594145, -8.344646857949556e-07, 0.0, -7.867782187531702e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.7881377516459906e-06, -1.2755313036905136e-05, -0.0013260389678180218, -3.576278118089249e-07, -8.344646857949556e-07, -1.7881377516459906e-06, -1.1920928244535389e-07, -2.50339189733495e-06, 0.0, -8.344646857949556e-07, -7.152555099310121e-07, -1.8000440832111053e-05, -4.768370445162873e-07, -2.312633478140924e-05, -1.0728830375228426e-06, -3.576278118089249e-07, 0.0, -1.5497195136049413e-06, -4.768370445162873e-07, -3.0517112463712692e-05, -3.576278118089249e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -5.960462772236497e-07, -3.71926071238704e-05, -1.1920922133867862e-06, -4.291525328881107e-06, -3.576278118089249e-07, -8.344646857949556e-07, -3.576278118089