  int[] predecessorVertex;\n        int[] predecessorArc;\n\n        MinCostMaxFlow() {\n            adjacency = new List[MAX_VERTEX];\n            for (int i = 0; i < MAX_VERTEX; i++) {\n                adjacency[i] = new ArrayList<>();\n            }\n            height = new int[MAX_VERTEX];\n            shortestPath = new int[MAX_VERTEX];\n            predecessorVertex = new int[MAX_VERTEX];\n            predecessorArc = new int[MAX_VERTEX];\n        }\n\n        void establish(int n) {\n            vertexCount = n;\n        }\n\n        void insert(int src, int dst, int cap, int cst) {\n            adjacency[src].add(new Arc(dst, cap, cst, adjacency[dst].size()));\n            adjacency[dst].add(new Arc(src, 0, -cst, adjacency[src].size() - 1));\n        }\n\n        int optimize(int source, int sink, int demand) {\n            int totalCost = 0;\n            Arrays.fill(height, 0);\n            while (demand > 0) {\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                Arrays.fill(shortestPath, INFINITY);\n                shortestPath[source] = 0;\n                pq.offer(new int[]{0, source});\n                while (!pq.isEmpty()) {\n                    int[] top = pq.poll();\n                    int dist = top[0], u = top[1];\n                    if (shortestPath[u] < dist) continue;\n                    for (int i = 0; i < adjacency[u].size(); ++i) {\n                        Arc arc = adjacency[u].get(i);\n                        if (arc.capacity > 0 && shortestPath[arc.destination] > shortestPath[u] + arc.weight + height[u] - height[arc.destination]) {\n                            shortestPath[arc.destination] = shortestPath[u] + arc.weight + height[u] - height[arc.destination];\n                            predecessorVertex[arc.destination] = u;\n                            predecessorArc[arc.destination] = i;\n                            pq.offer(new int[]{shortestPath[arc.destination], arc.destination});\n                        }\n                    }\n                }\n                if (shortestPath[sink] == INFINITY) return -1;\n                for (int i = 0; i < vertexCount; ++i) {\n                    height[i] += shortestPath[i];\n                }\n                int flow = demand;\n                for (int v = sink; v != source; v = predecessorVertex[v]) {\n                    flow = Math.min(flow, adjacency[predecessorVertex[v]][predecessorArc[v]].capacity);\n                }\n                demand -= flow;\n                totalCost += flow * height[sink];\n                for (int v = sink; v != source; v = predecessorVertex[v]) {\n                    Arc arc = adjacency[predecessorVertex[v]][predecessorArc[v]];\n                    arc.capacity -= flow;\n                    adjacency[v].get(arc.complement).capacity += flow;\n                }\n            }\n            return totalCost;\n        }\n    }\n\n    static MinCostMaxFlow mcf = new MinCostMaxFlow();\n    static int n, m, k, c, d;\n    static int[] input = new int[50];\n    static int[] frequency = new int[50];\n    static List<Integer>[] neighbors = new List[50];\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        for (int i = 0; i < 50; i++) {\n            neighbors[i] = new ArrayList<>();\n        }\n        \n        for (int i = 0; i < k; ++i) {\n            input[i] = sc.nextInt();\n            ++frequency[input[i] - 1];\n        }\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            --u; --v;\n            neighbors[u].add(v);\n            neighbors[v].add(u);\n        }\n        mcf.establish(n * TIMESTEP + 2);\n        for (int i = 0; i < n; ++i)\n            mcf.insert(n * TIMESTEP, i, frequency[i], 0);\n        for (int t = 0; t < TIMESTEP; ++t)\n            mcf.insert(t * n, n * TIMESTEP + 1, k, c * t);\n        for (int i = 0; i < n; ++i) {\n            for (int t = 0; t < TIMESTEP - 1; ++t)\n                mcf.insert(t * n + i, (t + 1) * n + i, k, 0);\n            for (int neighbor : neighbors[i]) {\n                for (int t = 0; t < TIMESTEP - 1; ++t) {\n                    for (int u = 0; u < k; ++u) {\n                        int cost = (u + 1) * (u + 1) * d - u * u * d;\n                        mcf.insert(t * n + i, (t + 1) * n + neighbor, 1, cost);\n                    }\n                }\n            }\n        }\n        System.out.println(mcf.optimize(n * TIMESTEP, n * TIMESTEP + 1, k));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001941730733960867, -2.7418097943154862e-06, -2.3841855067985307e-07, -0.001891610911116004, -4.494089080253616e-05, -0.11282937228679657, -0.5232138633728027, -0.00043478095903992653, -1.1920922133867862e-06, -0.0028568191919475794, -0.012511101551353931, -1.2040065485052764e-05, -0.011088416911661625, -0.03810223564505577, -0.161373108625412, -1.3947389561508317e-05, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -4.768370445162873e-07, -2.3841855067985307e-07, -9.536738616588991e-07, -4.768370445162873e-07, -5.960462772236497e-07, -1.8596476365928538e-05, -0.0017060976242646575, -3.3378546504536644e-06, -7.688703772146255e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, 0.0, 0.0, -6.6756979322235566e-06, 0.0, -9.536738616588991e-07, -3.099436753473128e-06, -2.50339189733495e-06, 0.0, -0.2254161536693573, -7.152555099310121e-07, -1.0728830375228426e-06, -3.814689989667386e-06, -1.0371154530730564e-05, -3.933898824470816e-06, -1.0728830375228426e-06, -1.5497195136049413e-06, -3.3378546504536644e-06, 0.0, -2.3841855067985307e-07, 0.0, -1.5497195136049413e-06, -1.1920928244535389e-07, -9.536738616588991e-07, -4.887569048150908e-06, -3.576278118