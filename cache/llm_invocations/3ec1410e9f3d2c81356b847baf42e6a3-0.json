t j=0;j<=L-i;j++) C[i+j] += A[i]*B[j];\n    for(int i=0;i<=L;i++) C[i]%=mod;\n    return C;\n}\nvector<long long> poly_pow(vector<long long> A,int k){\n    vector<long long> C(L+1,0); C[0]=1;\n    while(k){\n        if(k&1) C=poly_mul(C,A);\n        A=poly_mul(A,A);\n        k>>=1;\n    }\n    return C;\n}\nint main(){\n    ios::sync_with_stdio(false); cin.tie(0);\n    cin>>n>>k>>mod;\n    init_fact(n);\n    if(n&1){ cout<<pw(k,n)<<\"\\n\"; return 0; }\n    m=1; L=0; while(m<=n){ m<<=1; L++; }\n    for(int i=0;i<m;i++) cnt[i]=cnt[i>>1]+(i&1);\n    init_fact(m);\n    for(int i=0;i<m;i++) f[cnt[i]][i]=inv[i];\n    for(int s=0;s<=L;s++) fwt(f[s],m,1);\n    gv.resize(L+1);\n    for(int s=0;s<m;s++){\n        for(int b=0;b<=L;b++) gv[b]=f[b][s];\n        gv=poly_pow(gv,k);\n        for(int b=0;b<=L;b++) f[b][s]=gv[b];\n    }\n    fwt(f[cnt[n]],m,-1);\n    long long ans = pw(k,n) - (long long)f[cnt[n]][n]*jc[n]%mod;\n    ans %= mod; if(ans<0) ans+=mod;\n    cout<<ans<<\"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\nimport java.io.PrintWriter;\n\npublic class Main {\n    static final int MAXN = 270005;\n    static int m, n, k, mod;\n    static int[][] f = new int[19][MAXN];\n    static long[] gv;\n    static int[] cnt = new int[MAXN];\n    static int[] jc = new int[MAXN];\n    static int[] inv = new int[MAXN];\n    static int L;\n\n    static int addmod(int x) {\n        if (x < 0) return x + mod;\n        if (x >= mod) return x - mod;\n        return x;\n    }\n\n    static void add2(int[] a, int idx, int y) {\n        a[idx] = addmod(a[idx] + y);\n    }\n\n    static int pw(int x, int y) {\n        long res = 1;\n        long base = x % mod;\n        while (y > 0) {\n            if ((y & 1) == 1) res = (res * base) % mod;\n            base = (base * base) % mod;\n            y >>= 1;\n        }\n    