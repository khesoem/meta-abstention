 final int MOD = 1000000007;\n\n    static long modPow(long base, long exp) {\n        base %= MOD;\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n        sc.close();\n\n        BitSet vis = new BitSet(p);\n        int components = 0;\n\n        for (int i = 1; i < p; ++i) {\n            if (!vis.get(i)) {\n                int cur = i;\n                while (!vis.get(cur)) {\n                    vis.set(cur);\n                    cur = (int)(((long)cur * k) % p);\n                }\n                ++components;\n            }\n        }\n\n        long ans = modPow(p, components + (k == 1 ? 1 : 0));\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -7.903263758635148e-05, -1.4662635294371285e-05, 0.0, -0.0002673506969586015, -0.09007733315229416, -1.1920928244535389e-07, 0.0, -2.9802276912960224e-06, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -3.564294092939235e-05, -3.969590397900902e-05, -2.3841855067985307e-07, -0.014992768876254559, -0.004084103740751743, -0.0002615109842736274, -0.6942447423934937, -4.768370445162873e-07, -0.011047743260860443, 0.0, 0.0, -3.576278118089249e-07, -0.014164506457746029, -1.07287787614041e-05, 0.0, 0.0, -0.004083035048097372, -5.960462772236497e-07, -0.021311337128281593, -1.4424220353248529e-05, -1.9073468138230965e-06, -0.00016068121476564556, -1.6689160474925302e-05, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -4.768360213347478e-06, -2.0265558760002023e-06, -4.768370445162873e-07, 0.0, -0.0011713793501257896, -1.43051045142783