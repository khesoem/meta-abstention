n        }\n        \n        String[] line = br.readLine().split(\" \");\n        int n = Integer.parseInt(line[0]);\n        long k = Long.parseLong(line[1]);\n        \n        if (k >= n) {\n            pw.println(0);\n            pw.flush();\n            return;\n        }\n        if (k == 0) {\n            pw.println(factorial[n]);\n            pw.flush();\n            return;\n        }\n        if (k == n - 1) {\n            pw.println(2 * n);\n            pw.flush();\n            return;\n        }\n        \n        int filledCols = n - (int)k;\n        long chooseCols = nCr(n, filledCols);\n        \n        long total = 0;\n        for (int empty = 0; empty <= filledCols; empty++) {\n            long waysChoose = nCr(filledCols, empty);\n            long waysFill = modPow(filledCols - empty, n);\n            long term = (waysChoose * waysFill) % MOD;\n            if (empty % 2 == 1) {\n                term = (MOD - term) % MOD;\n            }\n            total = (total + term) % MOD;\n        }\n        \n        total = (total * chooseCols) % MOD;\n        total = (total * 2) % MOD;\n        \n        pw.println(total);\n        pw.flush();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef mod_pow(base, exp):\n    result = 1\n    base %= MOD\n    while exp > 0:\n        if (exp & 1) == 1:\n            result = (result * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return result\n\nfactorial = None\n\ndef nCr(n, r):\n    if r > n or r < 0:\n        return 0\n    num = factorial[n]\n    den = (factorial[n - r] * factorial[r]) % MOD\n    return (num * mod_pow(den, MOD - 2)) % MOD\n\ndef main():\n    global factorial\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    k = int(data[1])\n    \n    factorial = [1] * (int(2e5) + 1)\n    for i in range(1, len(facto