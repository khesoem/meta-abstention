          int u = heap.top().id;\n            heap.pop();\n            if (vis[u]) continue;\n            vis[u] = true;\n            \n            for (int i = hd[u]; i; i = e[i].next) {\n                int v = e[i].to;\n                ll w = pot[u] + e[i ^ 1].cost - pot[v];\n                if (e[i ^ 1].cap && dist[u] + w < dist[v]) {\n                    dist[v] = dist[u] + w;\n                    heap.push(State(v, dist[v]));\n                }\n            }\n        }\n        \n        for (int i = 1; i <= node_cnt; ++i)\n            pot[i] = min(pot[i] + dist[i], INF);\n        \n        if (!vis[src]) return false;\n        fill(vis + 1, vis + node_cnt + 1, false);\n        return true;\n    }\n    \n    int dfs(int u, int dst, int flow) {\n        if (u == dst || !flow) return flow;\n        int pushed = 0;\n        vis[u] = true;\n        \n        for (int& i = cur[u]; i; i = e[i].next) {\n            if (e[i].cap) {\n                int v = e[i].to;\n                int f;\n                if (!vis[v] && pot[v] + e[i].cost == pot[u] &&\n                    (f = dfs(v, dst, min(flow, e[i].cap)))) {\n                    e[i].cap -= f;\n                    e[i ^ 1].cap += f;\n                    pushed += f;\n                    flow -= f;\n                    if (!flow) break;\n                }\n            }\n        }\n        \n        vis[u] = false;\n        return pushed;\n    }\n    \n    int total_flow;\n    ll total_cost;\n    \n    void run(int src, int dst) {\n        while (spfa(src, dst)) {\n            int f = dfs(src, dst, INF);\n            total_flow += f;\n            total_cost += (ll)f * pot[src];\n        }\n    }\n}\n\nint src = 1, dst = 2, n, m, k, c, d;\n\ninline int idx(int t, int x) { return t * n + x + 2; }\n\nvoid layer(int t) {\n    node_cnt += n;\n    \n    for (int u = 1; u <= n; ++u)\n        for (int v : g[u])\n            for (int p = 1; p <= k; ++p)\n                link(idx(t, u), idx(t + 1, v), 1, d * (2 * p - 1));\