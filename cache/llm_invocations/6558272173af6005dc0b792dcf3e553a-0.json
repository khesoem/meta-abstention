 i in range(1, self.node_cnt + 1):\n            self.cur[i] = self.hd[i]\n        self.dist[dst] = 0\n        \n        heap = []\n        heapq.heappush(heap, (0, dst))\n        \n        while heap:\n            d, u = heapq.heappop(heap)\n            if self.vis[u]:\n                continue\n            self.vis[u] = True\n            \n            i = self.hd[u]\n            while i:\n                v = self.e[i].to\n                w = self.pot[u] + self.e[i ^ 1].cost - self.pot[v]\n                if self.e[i ^ 1].cap and self.dist[u] + w < self.dist[v]:\n                    self.dist[v] = self.dist[u] + w\n                    heapq.heappush(heap, (self.dist[v], v))\n                i = self.e[i].next\n        \n        for i in range(1, self.node_cnt + 1):\n            self.pot[i] = min(self.pot[i] + self.dist[i], INF)\n        \n        if not self.vis[src]:\n            return False\n        \n        for i in range(1, self.node_cnt + 1):\n            self.vis[i] = False\n        return True\n    \n    def dfs(self, u, dst, flow):\n        if u == dst or not flow:\n            return flow\n        pushed = 0\n        self.vis[u] = True\n        \n        i = self.cur[u]\n        while i:\n            if self.e[i].cap:\n                v = self.e[i].to\n                f = 0\n                if not self.vis[v] and self.pot[v] + self.e[i].cost == self.pot[u]:\n                    f = self.dfs(v, dst, min(flow, self.e[i].cap))\n                if f:\n                    self.e[i].cap -= f\n                    self.e[i ^ 1].cap += f\n                    pushed += f\n                    flow -= f\n                    if not flow:\n                        break\n            self.cur[u] = i\n            i = self.e[i].next\n        \n        self.vis[u] = False\n        return pushed\n    \n    def run(self, src, dst):\n        while self.spfa(src, dst):\n            f = self.dfs(src, dst, INF)\n            self.total_flow += f\n            self.total_cost += f * self.pot[src]\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    node_cnt = n + 2\n    g = defaultdict(list)\n    \n    src = 1\n    dst = 2\n    \n    def idx(t, x):\n        return t * n + x + 2\n    \n    mcf = MCF(100010)\n    \n    for _ in range(k):\n        a = int(next(it))\n        mcf.link(src, idx(0, a), 1, 0)\n    \n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        g[u].append(v)\n        g[v].append(u)\n    \n    mcf.link(idx(0, 1), dst, INF, 0)\n    \n    def layer(t):\n        nonlocal node_cnt\n        node_cnt += n\n        \n        for u in range(1, n + 1):\n            for v in g[u]:\n                for p in range(1, k + 1):\n                    mcf.link(idx(t, u), idx(t + 1, v), 1, d * (2 * p - 1))\n        \n        for u in range(1, n + 1):\n            mcf.link(idx(t, u), idx(t + 1, u), INF, 0)\n        \n        mcf.link(idx(t + 1, 1), dst, INF, c * (t + 1))\n    \n    for i in range(n + k + 1):\n        layer(i)\n    \n    mcf.run(src, dst)\n    print(mcf.total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00016544880054425448, -1.0728830375228426e-06, -1.1920928244535389e-07, -6.067568756407127e-05, -0.4290004074573517, -3.576278118089249e-07, -0.00462284404784441, -0.0012994902208447456, -0.5761584639549255, -0.0003967689990531653, -0.0003375437227077782, -7.152555099310121e-07, -0.012512161396443844, -0.07956880331039429, -0.7505419254302979, -2.264974000354414e-06, -0.004637676291167736, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.3499913215637207, -0.07889040559530258, -0.016739854589104652, -0.004314637742936611, -0.02345774881541729, -7.331102824537084e-05, -7.152555099310121e-07, -2.3841855067985307e-07, -0.4740779399871