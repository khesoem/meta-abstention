if (!in_queue[edges[r].y]) {\n                    in_queue[edges[r].y] = 1;\n                    queue_buf[qt++] = edges[r].y;\n                }\n            }\n        }\n    }\n    if (dist[sink] == INF) return -1;\n    int cur = sink;\n    while (cur) {\n        int r = prev_edge[cur];\n        if (edges[r].ty == 1) {\n            edges[r].v += 2 * d;\n            edges[r ^ 1].v -= 2 * d;\n        }\n        edges[r].c--;\n        edges[r ^ 1].c++;\n        cur = edges[r ^ 1].y;\n    }\n    return dist[sink];\n}\n\nint solve(int num_flow) {\n    int total = 0;\n    for (int i = 0; i < num_flow; ++i) total += augment();\n    return total;\n}\n\nint main() {\n    int n, m, k;\n    R(n, m, k, C, d);\n    init_flow(n * 100 + 1);\n    for (int i = 1; i <= k; ++i) {\n        int x;\n        R(x);\n        add_edge(0, x, 1, 0, 0);\n    }\n    for (int i = 1; i <= 99; ++i) {\n        add_edge(1 + i * n, 100 * n + 1, INF, 0, 0);\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= 99; ++j) {\n            add_edge(i + (j - 1) * n, i + j * n, INF, C, 0);\n        }\n    }\n    for (int i = 1; i <= m; ++i) {\n        int x, y;\n        R(x, y);\n        for (int j = 1; j <= 99; ++j) {\n            add_edge(x + (j - 1) * n, y + j * n, INF, C + d, 1);\n            add_edge(y + (j - 1) * n, x + j * n, INF, C + d, 1);\n        }\n    }\n    W(solve(k));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1034567890\nMAX_EDGE_NUM = 1000000\nMAX_NODE_NUM = 100000\n\nedges = []\nadj = [[] for _ in range(MAX_NODE_NUM)]\nC = 0\nd = 0\nedge_cnt = 0\nsink = 0\ndist = [0] * MAX_NODE_NUM\nprev_edge = [0] * MAX_NODE_NUM\nin_queue = [0] * MAX_NODE_NUM\n\ndef init_flow(_sink):\n    global sink, edge_cnt\n    sink = _sink\n    for i in range(sink + 1):\n        adj[i].clear()\n    edge_cnt