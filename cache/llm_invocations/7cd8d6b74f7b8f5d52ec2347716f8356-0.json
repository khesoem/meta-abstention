t_prod[i-1][j]*left_prod[i-1][j-1];\n\t\t}\n\t\tleft_prod[i][0]=T[i][0];\n\t\tfor(int j=1;j<m;j++)left_prod[i][j]=left_prod[i][j-1]*T[i][j];\n\t\tright_prod[i][m-1]=T[i][m-1];\n\t\tfor(int j=m-2;j>=0;j--)right_prod[i][j]=T[i][j]*right_prod[i][j+1];\n\t}\n\tfor(int i=0;i<=m;i++)S.cell[0][i]=1;\n\tfor(int i=len-1,j=0;i>=0;i--)\n\t\twhile(base[i]--)S=S*T[i][j],j=(j+1)%m;\n\tprintf(\"%d\",S.cell[0][m]);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef multiply(A, B, m, MOD=1000000007):\n    C = [[0] * (m + 1) for _ in range(m + 1)]\n    for i in range(m + 1):\n        for j in range(m + 1):\n            for k in range(m + 1):\n                C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD\n    return C\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    m = int(data[1])\n    \n    base = [0] * 65\n    base[0] = n\n    length = 0\n    while base[length]:\n        length += 1\n        base[length] = base[length - 1] // m\n        base[length - 1] %= m\n    \n    # Initialize matrices\n    S = [[0] * (m + 1) for _ in range(m + 1)]\n    T = [[[None for _ in range(35)] for __ in range(65)] for ___ in range(65)]\n    left_prod = [[[0] * (m + 1) for _ in range(35)] for __ in range(65)]\n    right_prod = [[[0] * (m + 1) for _ in range(35)] for __ in range(65)]\n    \n    for i in range(65):\n        for j in range(35):\n            T[i][j] = [[0] * (m + 1) for _ in range(m + 1)]\n    \n    for i in range(length):\n        if i == 0:\n            for j in range(m):\n                T[i][j][m][m] = 1\n                for a in range(m):\n                    if a != j:\n                        T[i][j][a][a] = 1\n                    else:\n                        for b in range(m + 1):\n                            T[i][j][a][b] = 1\n        else:\n            for j in range(m):\n                if j == 0:\n     