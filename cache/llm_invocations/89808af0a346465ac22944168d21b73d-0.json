 = int(1e9)\nLINF = int(1e18)\nMOD = int(1e9 + 7)\nPI = math.acos(-1)\n\ndef go(n):\n    if n == 0:\n        return 0\n    k = 1\n    cnt = 1\n    while k * 10 + 1 < n:\n        k = k * 10 + 1\n        cnt += 1\n    rem1 = n % k\n    div1 = n // k\n    rem2 = (k * 10 + 1 - n) % k\n    div2 = (k * 10 + 1 - n) // k\n    val1 = go(rem1) + div1 * cnt\n    val2 = go(rem2) + (cnt + 1) + div2 * cnt\n    return min(val1, val2)\n\ndef solve():\n    n = int(sys.stdin.readline().strip())\n    print(go(n))\n\ndef gcd(a, b):\n    while b != 0:\n        r = a % b\n        a = b\n        b = r\n    return a\n\ndef lcm(a, b):\n    return a // gcd(a, b) * b\n\ndef fpow(n, k, p):\n    r = 1\n    while k > 0:\n        if k % 2 == 1:\n            r = (r * n) % p\n        n = (n * n) % p\n        k >>= 1\n    return r\n\ndef floor_nth_root(x, n):\n    if n <= 0 or x < 0:\n        raise ValueError(\"Invalid input\")\n    if x == 0:\n        return 0\n    if n == 1:\n        return x\n    a = 0\n    b = 1 << (1 + (x.bit_length() // n))\n    while True:\n        a = b\n        b = (a * (n - 1) + x // (a ** (n - 1))) // n\n        if b >= a:\n            break\n    return a\n\ndef sqrt_decimal(A, SCALE):\n    x0 = Decimal(\"0\")\n    x1 = Decimal(math.sqrt(float(A)))\n    while x0 != x1:\n        x0 = x1\n        x1 = A / x1\n        x1 = x1 + x0\n        x1 = x1 / Decimal(2)\n        x1 = x1.quantize(Decimal(10) ** -SCALE, rounding=ROUND_HALF_UP)\n    return x1\n\nclass SegmentTree:\n    def __init__(self):\n        self.maxn = 100010\n        self.st = [0] * (4 * self.maxn)\n    \n    def update(self, node, i, L, R, val):\n        if i < L or i > R:\n            return\n        if L == R:\n            self.st[node] += val\n            return\n        mid = (L + R) // 2\n        self.update(node << 1, i, L, mid, val)\n        self.update((node << 1) + 1, i, mid + 1, R, val)\n        self.st[node] = self.st[node << 1] + self.st[(node << 1) + 1]\n    \n    def query(self, node, l, r, L, R):\n        if l > R or r < L:\n            return 0\n        if l <= L and r >= R:\n            return self.st[node]\n        mid = (L + R) // 2\n        return (self.query(node << 1, l, r, L, mid) + \n                self.query((node << 1) + 1, l, r, mid + 1, R))\n\nclass Matrix:\n    def __init__(self):\n        self.maxn = 2\n        self.x = [[0] * self.maxn for _ in range(self.maxn)]\n    \n    def mul(self, A):\n        res = Matrix()\n        for i in range(self.maxn):\n            for k in range(self.maxn):\n                for j in range(self.maxn):\n                    res.x[i][j] = (res.x[i][j] + self.x[i][k] * A.x[k][j]) % MOD\n        return res\n    \n    def pow(self, k):\n        res = Matrix()\n        T = Matrix()\n        for i in range(self.maxn):\n            for j in range(self.maxn):\n                res.x[i][j] = self.x[i][j]\n                T.x[i][j] = self.x[i][j]\n        k -= 1\n        while k > 0:\n            if k & 1:\n                res = res.mul(T)\n            T = T.mul(T)\n            k >>= 1\n        return res\n\nclass Pair:\n    def __init__(self, fi, se):\n        self.fi = fi\n        self.se = se\n    \n    def __lt__(self, oth):\n        if self.fi > oth.fi:\n            return False\n        if self.fi < oth.fi:\n            return True\n        if self.se > oth.se:\n            return False\n        if self.se < oth.se:\n            return True\n        return False\n    \n    def __eq__(self, oth):\n        return self.fi == oth.fi and self.se == oth.se\n\ndef main():\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.655486064730212e-05, -1.1920922133867862e-06, -1.1920922133867862e-06, -0.0005336767644621432, -0.0361679308116436, -1.2397689715726301e-05, -0.005238971672952175, -0.001589583931490779, -3.576214658096433e-05, -0.28115254640579224, -0.019412530586123466, 0.0, -6.103329360485077e-05, -2.622600959512056e-06, -0.1278617978096