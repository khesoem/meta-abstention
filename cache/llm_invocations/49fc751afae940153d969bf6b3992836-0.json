mb(sem,n/2-cnt);\n            rasp+=ncnt;\n            }\n        }\n    printf(\"%lld\\n\",rasp);\nreturn 0;\n}\n\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    r = int(data[0])\n    c = int(data[1])\n    s = data[2]\n    n = 2 * (r + c)\n\n    # comb function\n    def comb(n_val, k_val):\n        if n_val < k_val or k_val < 0:\n            return 0\n        rez = 1\n        for i in range(k_val):\n            rez = rez * (n_val - i) // (i + 1)\n        return rez\n\n    # lsc array (only indices 2*r-1 to n-1 are used)\n    lsc = [0] * n\n    lsc[2 * r - 1] = 1\n    for i in range(2 * r, n):\n        lsc[i] = lsc[i - 1] * i // (i - 2 * r + 1)\n\n    # rsc and rsc2 arrays (0..n)\n    rsc = [0] * (n + 1)\n    rsc2 = [0] * (n + 1)\n    for i in range(n + 1):\n        rsc[i] = comb(i, r)\n        rsc2[i] = comb(i, r - 1)\n\n    n_sum = rsc[n // 2] * rsc[n // 2]\n\n    cnta = 0\n    cntb = 0\n    m_sum = 0\n    for i in range(n - 1, -1, -1):\n        if m_sum > 0:\n            ok = 1\n        else:\n            ok = 0\n        if cntb == n // 2:\n            ok = 1\n        if cnta == n // 2:\n            ok = 0\n        if ok:\n            cnta += 1\n            m_sum = m_sum - rsc2[n // 2 - cnta] * rsc[n // 2 - cntb]\n        else:\n            cntb += 1\n            m_sum = m_sum + rsc2[n // 2 - cntb] * rsc[n // 2 - cnta]\n    m_sum = max(m_sum, -m_sum)\n\n    # DP: mm maps (sum, cnt) -> count\n    mm = {(0, 0): 1}\n    for i in range(n - 1, 2 * r - 2, -1):\n        nm = defaultdict(int)\n        for (sum_val, cnt), ncnt in mm.items():\n            ast = n // 2 - cnt\n            bst = i + 1 - ast\n            # values from rsc/rsc2 with bounds check (0 for out-of-range)\n            rsc2_ast_minus1 = rsc2[ast - 1] if 0 <= ast - 1 <= n else 0\n            rsc_bst = rsc[bst] if 0 <= bst <= n else 0\n            asum = sum_val + rsc2_ast_minus1 * rsc_bst\n            rsc2_bst_minus1 = rsc2[bst - 1] if 0 <= bst - 1 <= n else 0\n            rsc_ast = rsc[ast] if 0 <= ast <= n else 0\n            bsum = sum_val - rsc2_bst_minus1 * rsc_ast\n            if s[i] == 'A':\n                nm[(asum, cnt + 1)] += ncnt\n                # nm[(bsum, cnt)] += 0   # optional, can be omitted\n            elif s[i] == 'B':\n                nm[(bsum, cnt)] += ncnt\n                # nm[(asum, cnt + 1)] += 0\n            else:  # '?'\n                nm[(asum, cnt + 1)] += ncnt\n                nm[(bsum, cnt)] += ncnt\n        n_sum -= lsc[i]  # not used further, but kept for fidelity\n        mm.clear()\n        for (sum_val, cnt), ncnt in nm.items():\n            ast = n // 2 - cnt\n            bst = i - ast\n            if cnt > n // 2 or (n - i - cnt) > n // 2:\n                continue\n            rsc_ast = rsc[ast] if 0 <= ast <= n else 0\n            rsc_bst = rsc[bst] if 0 <= bst <= n else 0\n            bound = rsc_ast * rsc_bst\n            if sum_val < -m_sum - bound or sum_val > m_sum + bound:\n                continue\n            mm[(sum_val, cnt)] = mm.get((sum_val, cnt), 0) + ncnt\n\n    # find minimal absolute sum among remaining states\n    b_sum = 10**18  # large number\n    for (sum_val, cnt) in mm:\n        b_sum = min(b_sum, max(sum_val, -sum_val))\n\n    rasp = 0\n    for (sum_val, cnt), ncnt in mm.items():\n        if sum_val == b_sum or sum_val == -b_sum:\n            sem = 0\n            for j in range(2 * r - 1):\n                if s[j] == '?':\n                    sem += 1\n                elif s[j] == 'A':\n                    cnt += 1\n            ncnt *= comb(sem, n // 2 - cnt)\n            rasp += ncnt\n\n    sys.stdout.write(str(rasp) + '\\n')\n\nif __name__ == '__main__':\n    solve()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs