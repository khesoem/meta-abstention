{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\nconst ll INF = 1e18;\nconst int T = 99;\nconst int C = 12;\n\nstruct Edge {\n    int to, rev;\n    ll cap, cost;\n};\n\nvector<Edge> edges;\nvector<int> head, nxt;\n\nvoid add_edge(int from, int to, ll cap, ll cost) {\n    edges.push_back({to, -1, cap, cost});\n    nxt.push_back(head[from]);\n    head[from] = (int)edges.size() - 1;\n    edges.push_back({from, -1, 0, -cost});\n    nxt.push_back(head[to]);\n    head[to] = (int)edges.size() - 1;\n    // set rev indices\n    edges[edges.size()-2].rev = edges.size()-1;\n    edges[edges.size()-1].rev = edges.size()-2;\n}\n\nll min_cost_flow(int s, int t, ll &price, int n) {\n    vector<ll> potential(n, 0), dist(n);\n    vector<int> prevv(n), preve(n);\n    ll flow = 0;\n    price = 0;\n    while (true) {\n        fill(dist.begin(), dist.end(), INF);\n        dist[s] = 0;\n        priority_queue<pair<ll,int>, vector<pair<ll,int>>, greater<pair<ll,int>>> pq;\n        pq.push({0, s});\n        while (!pq.empty()) {\n            auto [d, v] = pq.top(); pq.pop();\n            if (dist[v] < d) continue;\n            for (int e = head[v]; e != -1; e = nxt[e]) {\n                Edge &edge = edges[e];\n                if (edge.cap > 0 && dist[edge.to] > dist[v] + edge.cost + potential[v] - potential[edge.to]) {\n                    dist[edge.to] = dist[v] + edge.cost + potential[v] - potential[edge.to];\n                    prevv[edge.to] = v;\n                    preve[edge.to] = e;\n                    pq.push({dist[edge.to], edge.to});\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        for (int v = 0; v < n; ++v) potential[v] += dist[v];\n        ll d = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            d = min(d, edges[preve[v]].cap);\n        }\n        flow += d;\n        price += d * potential[t];\n        for (int v = t; v != s; v = prevv[v]) {\n            Edge &e = edges[preve[v]];\n            e.cap -= d;\n            edges[e.rev].cap += d;\n        }\n    }\n    return flow;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n    head.assign(sink + 1, -1);\n    nxt.clear();\n    edges.clear();\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                add_edge(i + (t-1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            ll cost = (j+1)*(j+1) - j*j;\n            for (int t = 1; t < T; ++t) {\n                add_edge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                add_edge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price;\n    ll flow = min_cost_flow(source, sink, price, sink + 1);\n    assert(flow == k);\n    cout << price << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nINF = 10**18\nT = 99\nC = 12\n\ndef add_edge(edges, head, nxt, fr, to, cap, cost):\n    # forward edge\n    edges.append([to, -1, cap, cost])\n    nxt.append(head[fr])\n    head[fr] = len(edges) - 1\n    # backward edge\n    edges.append([fr, -1, 0, -cost])\n    nxt.append(head[to])\n    head[to] = len(edges) - 1\n    # set rev indices\n    edges[-2][1] = len(edges) - 1\n    edges[-1][1] = len(edges) - 2\n\ndef min_cost_flow(edges, head, nxt, s, t, n):\n    potential = [0] * n\n    prevv = [0] * n\n    preve = [0] * n\n    flow = 0\n    price = 0\n    while True:\n        dist = [INF] * n\n        dist[s] = 0\n        pq = [(0, s)]\n        while pq:\n            d, v = heapq.heappop(pq)\n            if dist[v] < d:\n                continue\n            e = head[v]\n            while e != -1:\n                to, rev, cap, cost = edges[e]\n                if cap > 0 and dist[to] > dist[v] + cost + potential[v] - potential[to]:\n                    dist[to] = dist[v] + cost + potential[v] - potential[to]\n                    prevv[to] = v\n                    preve[to] = e\n                    heapq.heappush(pq, (dist[to], to))\n                e = nxt[e]\n        if dist[t] == INF:\n            break\n        for v in range(n):\n            potential[v] += dist[v]\n        d = INF\n        v = t\n        while v != s:\n            d = min(d, edges[preve[v]][2])\n            v = prevv[v]\n        flow += d\n        price += d * potential[t]\n        v = t\n        while v != s:\n            e = preve[v]\n            edges[e][2] -= d\n            edges[edges[e][1]][2] += d\n            v = prevv[v]\n    return flow, price\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    source = 0\n    sink = n * T + 1\n    total_nodes = sink + 1\n    head = [-1] * total_nodes\n    edges = []\n    nxt = []\n\n    for _ in range(k):\n        a = int(next(it))\n        add_edge(edges, head, nxt, source, a, 1, 0)\n\n    for t in range(T):\n        add_edge(edges, head, nxt, 1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                add_edge(edges, head, nxt, i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                add_edge(edges, head, nxt, a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                add_edge(edges, head, nxt, b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    flow, price = min_cost_flow(edges, head, nxt, source, sink, total_nodes)\n    # assert flow == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.0009133219718933105, 0.0, 0.0, -7.83174327807501e-05, -0.00047708096099086106, -0.01418531034141779, -0.0015147175872698426, -0.0002037079248111695, -0.00865777675062418, -0.06203506514430046, -0.018236234784126282, -5.364403477869928e-06, -2.7418097943154862e-06, -3.814689989667386e-06, -0.023245446383953094, -2.622600959512056e-06, -0.04861469566822052, -1.1324817933200393e-05, -1.2993727978027891e-05, 0.0, -2.50339189733495e-06, -0.0005411829333752394, -2.50339189733495e-06, -1.2755313036905136e-05, -1.1920928244535389e-07, 0.0, -0.0005567907355725765, -0.7299286723136902, -0.17283616960048676, -2.7894584491150454e-05, -0.6498615145683289, -0.0008123196894302964, -1.299