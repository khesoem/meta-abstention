c long mult(long... args) {\n            long res = 1;\n            for (long x : args) res = mult(res, x);\n            return res;\n        }\n\n        public long mult(long a, long b) {\n            return (a * b) % modulus();\n        }\n\n        public long pow(long base, int exp) {\n            long res = 1;\n            base = normalize(base);\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = mult(res, base);\n                base = mult(base, base);\n                exp >>= 1;\n            }\n            return res;\n        }\n\n        public long inv(long x) {\n            long m = modulus(), a = x, b = m;\n            long u = 1, v = 0;\n            while (b != 0) {\n                long q = a / b;\n                long r = a % b;\n                a = b; b = r;\n                long t = u - q * v; u = v; v = t;\n            }\n            return normalize(u);\n        }\n    }\n\n    static class InputReader {\n        private final BufferedReader reader;\n        private StringTokenizer tokenizer;\n\n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream), 32768);\n        }\n\n        public String next() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() { return Integer.parseInt(next()); }\n        public long nextLong() { return Long.parseLong(next()); }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nclass Mod998:\n    def __init__(self):\n        self.modulus_val = 998244353\n        self.facts = [1]\n        self.invFacts = [1]\n\n    def fact(self, n):\n        while len(self.facts) <= n:\n            self.facts.append((self.facts[-1] * len(self.facts)) % self.modulus_val)\n        return self.facts[n]\n\n    def invFact(self, n):\n        last = len(self.invFacts) - 1\n        if last < n:\n            temp = [0] * (n - last)\n            temp[0] = pow(self.fact(n), self.modulus_val - 2, self.modulus_val)\n            for i in range(1, len(temp)):\n                temp[i] = (temp[i - 1] * (n - i + 1)) % self.modulus_val\n            for i in range(len(temp) - 1, -1, -1):\n                self.invFacts.append(temp[i])\n        return self.invFacts[n]\n\n    def paritySign(self, k):\n        return 1 if k % 2 == 0 else self.modulus_val - 1\n\n    def ncr(self, n, r):\n        if r < 0 or n < r:\n            return 0\n        return (self.fact(n) * self.invFact(r) % self.modulus_val) * self.invFact(n - r) % self.modulus_val\n\n    def normalize(self, x):\n        x %= self.modulus_val\n        return x if x >= 0 else x + self.modulus_val\n\n    def add(self, a, b):\n        s = a + b\n        return s - self.modulus_val if s >= self.modulus_val else s\n\n    def mult(self, *args):\n        res = 1\n        for x in args:\n            res = (res * x) % self.modulus_val\n        return res\n\n    def pow(self, base, exp):\n        res = 1\n        base = self.normalize(base)\n        while exp > 0:\n            if exp & 1:\n                res = (res * base) % self.modulus_val\n            base = (base * base) % self.modulus_val\n            exp >>= 1\n        return res\n\n    def inv(self, x):\n        m = self.modulus_val\n        a, b = x % m, m\n        u, v = 1, 0\n        while b != 0:\n            q = a // b\n            r = a % b\n            a, b = b, r\n            u, v = v, u - q * v\n        return self.normalize(u)\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n