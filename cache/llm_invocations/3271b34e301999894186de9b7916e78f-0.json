{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Edge {\n    int to, cap, flow, cost;\n    Edge() : to(0), cap(0), flow(0), cost(0) {}\n    Edge(int to, int cap, int flow, int cost) : to(to), cap(cap), flow(flow), cost(cost) {}\n};\n\nconst int MAXV = 14043;\nvector<Edge> edges;\nvector<int> adj[MAXV];\n\nlong long answer = 0;\nlong long dist[MAXV];\nint parent[MAXV];\nint parentEdge[MAXV];\nint inQueue[MAXV];\nconst long long INF = (long long)1e18;\nint src = MAXV - 2, sink = MAXV - 1;\n\nint residual(int id) {\n    return edges[id].cap - edges[id].flow;\n}\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    adj[u].push_back((int)edges.size());\n    edges.emplace_back(v, cap, 0, cost);\n    adj[v].push_back((int)edges.size());\n    edges.emplace_back(u, 0, 0, -cost);\n}\n\nvoid augmentOnce() {\n    for (int i = 0; i < MAXV; ++i) {\n        dist[i] = INF;\n        parent[i] = -1;\n        parentEdge[i] = -1;\n        inQueue[i] = 0;\n    }\n    dist[src] = 0;\n\n    vector<int> q;\n    q.reserve(1 << 20);\n    q.push_back(src);\n    inQueue[src] = 1;\n\n    for (size_t head = 0; head < q.size(); ++head) {\n        int v = q[head];\n        inQueue[v] = 0;\n        for (int id : adj[v]) {\n            if (residual(id) <= 0) continue;\n            int to = edges[id].to;\n            int w = edges[id].cost;\n            if (dist[to] > dist[v] + w) {\n                dist[to] = dist[v] + w;\n                parent[to] = v;\n                parentEdge[to] = id;\n                if (!inQueue[to]) {\n                    inQueue[to] = 1;\n                    q.push_back(to);\n                }\n            }\n        }\n    }\n\n    int cur = sink;\n    while (cur != src) {\n        int id = parentEdge[cur];\n        edges[id].flow++;\n        edges[id ^ 1].flow--;\n        cur = parent[cur];\n    }\n    answer += dist[sink];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        addEdge(src, x, 1, 0);\n    }\n\n    const int T = 101;\n\n    for (int i = 0; i < T; ++i)\n        addEdge(i * n, sink, k, i * c);\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        for (int time = 0; time < T - 1; ++time)\n            for (int person = 0; person < k; ++person)\n                addEdge(x + time * n, y + (time + 1) * n, 1, d * (2 * person + 1));\n        for (int time = 0; time < T - 1; ++time)\n            for (int person = 0; person < k; ++person)\n                addEdge(y + time * n, x + (time + 1) * n, 1, d * (2 * person + 1));\n    }\n\n    for (int v = 0; v < n; ++v)\n        for (int time = 0; time < T - 1; ++time)\n            addEdge(v + time * n, v + (time + 1) * n, k, 0);\n\n    for (int i = 0; i < k; ++i)\n        augmentOnce();\n\n    cout << answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [