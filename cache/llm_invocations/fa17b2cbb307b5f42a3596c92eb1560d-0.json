     fact = new long[maxN + 1];\n        invFact = new long[maxN + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= maxN; i++) {\n            fact[i] = fact[i - 1] * i % MOD;\n        }\n        invFact[maxN] = fastPow(fact[maxN], MOD - 2);\n        for (int i = maxN - 1; i >= 0; i--) {\n            invFact[i] = invFact[i + 1] * (i + 1) % MOD;\n        }\n    }\n\n    long nCr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n    }\n\n    long fastPow(long base, long exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = res * base % MOD;\n            base = base * base % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</your_rewritten_code_4>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\nusing namespace std;\n\nconst long long MOD = 998244353LL;\n\nvector<long long> fact;\nvector<long long> invFact;\n\nlong long fastPow(long long base, long long exp) {\n    long long res = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) res = (res * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nvoid buildTables(int maxN) {\n    fact.resize(maxN + 1);\n    invFact.resize(maxN + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= maxN; i++) {\n        fact[i] = (fact[i - 1] * i) % MOD;\n    }\n    invFact[maxN] = fastPow(fact[maxN], MOD - 2);\n    for (int i = maxN - 1; i >= 0; i--) {\n        invFact[i] = (invFact[i + 1] * (i + 1)) % MOD;\n    }\n}\n\nlong long nCr(int n, int r) {\n    if (r < 0 || r > n) return 0;\n    return (fact[n] * invFact[r] % MOD) * invFact[n - r] % MOD;\n}\n\nint main() {\n    int n;\n    long long tmp;\n    cin >> n >> tmp;\n    \n    if (n <= tmp) {\n        cout 