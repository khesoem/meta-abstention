r v, cap, rev in self.adj[u]:\n                if cap > 0 and level[v] == -1:\n                    level[v] = level[u] + 1\n                    q.append(v)\n        return level[t] != -1\n    \n    def dfs(self, u, t, f, level, it):\n        if u == t:\n            return f\n        for i in range(it[u], len(self.adj[u])):\n            it[u] = i\n            v, cap, rev = self.adj[u][i]\n            if cap > 0 and level[v] == level[u] + 1:\n                ret = self.dfs(v, t, min(f, cap), level, it)\n                if ret > 0:\n                    # update forward edge\n                    self.adj[u][i][1] -= ret\n                    # update backward edge\n                    self.adj[v][rev][1] += ret\n                    return ret\n        return 0\n    \n    def max_flow(self, s, t):\n        flow = 0\n        level = [-1] * self.n\n        it = [0] * self.n\n        while self.bfs(s, t, level):\n            for i in range(self.n):\n                it[i] = 0\n            while True:\n                f = self.dfs(s, t, INF, level, it)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef main():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    g = []\n    for _ in range(n):\n        g.append(next(it).decode())\n    h = []\n    for _ in range(n):\n        h.append(next(it).decode())\n    \n    # directions\n    dx = [-1, 0, 1, 0]\n    dy = [0, 1, 0, -1]\n    \n    def in_bounds(x, y):\n        return 0 <= x < n and 0 <= y < n\n    \n    # tim array for bfs1\n    tim = [[INF]*n for _ in range(n)]\n    # bfs1 from each 'Z' (only last one matters due to overwriting)\n    for i in range(n):\n        for j in range(n):\n            if g[i][j] == 'Z':\n                # reset tim\n                for ii in range(n):\n                    for jj in range(n):\n                        tim[ii][jj] = INF\n                q = deque()\n                q.append((i, j))\n                tim[i][j] = 0\n                while q:\n                    x, y = q.popleft()\n                    for k in range(4):\n                        nx = x + dx[k]\n                        ny = y + dy[k]\n                        if in_bounds(nx, ny) and '0' <= g[nx][ny] <= '9' and tim[nx][ny] > tim[x][y] + 1:\n                            tim[nx][ny] = tim[x][y] + 1\n                            q.append((nx, ny))\n    \n    # Build graph\n    S = 0\n    T = n * n * 2 + 1\n    dinic = Dinic(T + 1)\n    \n    # Add edges from source to g cells\n    for i in range(n):\n        for j in range(n):\n            if '0' < g[i][j] <= '9':\n                cap = ord(g[i][j]) - ord('0')\n                dinic.add_edge(S, i * n + j + 1, cap)\n    \n    # Add edges from h cells to sink\n    for i in range(n):\n        for j in range(n):\n            if '0' < h[i][j] <= '9':\n                cap = ord(h[i][j]) - ord('0')\n                dinic.add_edge(n * n + i * n + j + 1, T, cap)\n    \n    # For each source cell, run bfs2 and add edges\n    for i in range(n):\n        for j in range(n):\n            if '0' < g[i][j] <= '9':\n                # bfs2 from (i,j)\n                dis = [[INF]*n for _ in range(n)]\n                q = deque()\n                q.append((i, j))\n                dis[i][j] = 0\n                while q:\n                    x, y = q.popleft()\n                    for k in range(4):\n                        nx = x + dx[k]\n                        ny = y + dy[k]\n                        if in_bounds(nx, ny) and '0' <= h[nx][ny] <= '9' and dis[nx][ny] > dis[x][y] + 1:\n                            if tim[nx][ny] >= dis[x][y] + 1:\n                                dis[nx][ny] = dis[x][y] + 1\n                                if tim[nx][ny] > dis[nx][ny]:\n                                    q.append((nx, ny))\n                # add edges to all reachable h cells within time t\n                for x in range(n):\n                    