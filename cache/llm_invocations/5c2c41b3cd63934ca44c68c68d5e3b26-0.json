      pop_heap(heap.begin(), heap.end(), greater<pair<ll,int>>());\n                auto [d, v] = heap.back();\n                heap.pop_back();\n                if (dist[v] < d) continue;\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        heap.push_back({dist[e.to], e.to});\n                        push_heap(heap.begin(), heap.end(), greater<pair<ll,int>>());\n                    }\n                }\n            }\n            if (dist[t] >= INF) break;\n            for (int v = 0; v < n; ++v) pot[v] += dist[v];\n            ll add = maxf - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                add = min(add, g[prevv[v]][preve[v]].cap);\n            }\n            flow += add;\n            res += add * pot[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= add;\n                g[v][e.rev].cap += add;\n            }\n        }\n        return res;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0); cout.tie(0);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n    MinCostFlow mcf(n * T + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        mcf.add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        mcf.add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                mcf.add_edge(i + (t-1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;