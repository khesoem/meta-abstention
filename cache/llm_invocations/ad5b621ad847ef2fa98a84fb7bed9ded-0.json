arch(const vector<ll>& arr, ll x) {\n    int lo = 0, hi = arr.size();\n    while (lo < hi) {\n        int mid = (lo + hi) / 2;\n        if (arr[mid] < x)\n            lo = mid + 1;\n        else\n            hi = mid;\n    }\n    return lo;\n}\n\nvoid sums(int i, int end, const vector<ll>& a, vector<ll>& lst, ll cur, ll m) {\n    if (i == end) {\n        lst.push_back(cur);\n    } else {\n        sums(i+1, end, a, lst, (cur + a[i]) % m, m);\n        sums(i+1, end, a, lst, cur, m);\n    }\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n\n    int n, m;\n    cin >> n >> m;\n    vector<ll> a(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> a[i];\n    }\n\n    int n1 = n / 2;\n\n    vector<ll> a1, a2;\n    sums(0, n1, a, a1, 0, m);\n    sums(n1, n, a, a2, 0, m);\n\n    // Sort and remove duplicates from a1\n    sort(a1.begin(), a1.end());\n    auto last = unique(a1.begin(), a1.end());\n    a1.erase(last, a1.end());\n\n    ll ans = 0;\n    for (ll i : a2) {\n        int j = binary_search(a1, m - i);\n        if (j > 0) {\n            ll candidate = a1[j-1] + i;\n            if (candidate > ans)\n                ans = candidate;\n        }\n    }\n\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.13197332620620728, -1.4185804502631072e-05, 0.0, 0.0, -5.864924969500862e-05, -0.0005728749092668295, 0.0, -0.0011762612266466022, -8.940656698541716e-06, 0.0, 0.0, -1.9073468138230965e-06, -9.536738616588991e-07, 0.0, 0.0, -1.1920928244535389e-07, -0.25193941593170166, -0.20142824947834015, 0.0, -0.03730162978172302, -0.004163526464253664, -7.486063259420916e-05, -0.07954612374305725, -0.003390399506315589, -1.1205610462639015e-05, 0.0, -0.0015103134792298079, -0.2174147665500641, -0.0024995533749461174, 0.0, -0.0001652104256208986, -0.0001510267611593008, -0.19029906392097473, -0.2169785350561142, -4.768370445162873e-07, -0.1321871429681778, -0.015154816210269928, -0.