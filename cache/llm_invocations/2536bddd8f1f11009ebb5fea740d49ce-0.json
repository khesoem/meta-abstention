yte();\n        } while (b <= ' ');\n        while (b > ' ') {\n            ret += b;\n            b = nextByte();\n        }\n        return ret;\n    }\n};\n\nclass BIT {\npublic:\n    vector<int> tree;\n\n    BIT(int len) {\n        tree.resize(len + 5, 0);\n    }\n\n    void update(int index, int val) {\n        index++;\n        while (index < (int)tree.size()) {\n            tree[index] ^= val;\n            index += index & -index;\n        }\n    }\n\n    int query(int index) {\n        int result = 0;\n        index++;\n        while (index > 0) {\n            result ^= tree[index];\n            index -= index & -index;\n        }\n        return result;\n    }\n\n    int rangeSum(int low, int high) {\n        return query(high) - query(low - 1);\n    }\n};\n\nvector<vector<int>> adjList;\nvector<int> tin, tout;\nvector<vector<int>> BL;\nint ct;\n\nint log2_int(int n) {\n    return (int)ceil(log2(n));\n}\n\nvoid recur_bl(int v, int p) {\n    tin[v] = ++ct;\n    BL[v][0] = p;\n    for (int i = 1; i <= log2_int((int)adjList.size()); ++i) {\n        BL[v][i] = BL[BL[v][i-1]][i-1];\n    }\n\n    for (int i = 0; i < (int)adjList[v].size(); i++) {\n        if (adjList[v][i] != p) {\n            recur_bl(adjList[v][i], v);\n        }\n    }\n\n    tout[v] = ++ct;\n}\n\nvoid preprocess(int root) {\n    ct = 0;\n    tin.resize(adjList.size());\n    tout.resize(adjList.size());\n    BL.assign(adjList.size(), vector<int>(log2_int((int)adjList.size()) + 1, 0));\n\n    recur_bl(root, root);\n}\n\nbool is_ancestor(int u, int v) {\n    return tin[u] <= tin[v] && tout[u] >= tout[v];\n}\n\nint lca(int u, int v) {\n    if (is_ancestor(u, v)) return u;\n    if (is_ancestor(v, u)) return v;\n\n    for (int i = log2_int((int)adjList.size()); i >= 0; --i) {\n        if (!is_ancestor(BL[u][i], v)) {\n            u = BL[u][i];\n        }\n    }\n    return BL[u][0];\n}\n\nint main() {\n    bool DEBUG = true;\n    string name = \"I\";\n\n    FastScanner* scan;\n    ofstream* out;\n\n    if (DEBUG) {\n        scan = new FastScanner(cin);\n        out = new ofstream(cout.rdbuf());\n    } else {\n        scan = new FastScanner(name + \".in\");\n        out = new ofstream(name + \".out\");\n    }\n\n    float N = stof(scan->nextString());\n    float P = stof(scan->nextString());\n\n    for (int i = 0; i <= N; i += 1) {\n        double val = i * (i - 1) * (i - 2) / 6.0 + \n                     i * (i - 1) * (N - i) / 2.0 + \n                     i * (N - i) * (N - i - 1) / 4.0;\n        val = val / (N * (N - 1) * (N - 2) / 6.0);\n\n        if (val >= P) {\n            *out << i << endl;\n            break;\n        }\n    }\n\n    if (DEBUG) {\n        out->flush();\n    } else {\n        out->close();\n    }\n\n    delete scan;\n    delete out;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016842853801790625, -2.3841830625315197e-06, -1.0728830375228426e-06, -0.000337305391440168, -5.960462772236497e-07, -0.0008174415561370552, -1.0609570381348021e-05, -9.536738616588991e-07, 0.0, -0.11386115849018097, -3.6954811548639555e-06, -1.5139465176616795e-05, -5.960462772236497e-07, -0.8041371703147888, -4.768370445162873e-07, -7.748573807475623e-06, -1.1920928244535389e-07, -0.2967822551727295, -1.1920928244535389e-07, -1.883488948806189e-05, -1.1920922133867862e-06, -0.011568369343876839, -5.960462772236497e-07, -4.577531944960356e-05, -5.960462772236497e-07, -0.32602670788764954, -0.003178665181621909, -0.006716888397932053, -2.7418097943154862e-06, -0.20536133646965027, -0.3484494686126709, -0.07937667518854141, -6.794906312279636e-06, -0.3383971154689789, -4.207999518257566e-05, -0.34845206141471863, -0.09842818230390549, -1.2159273865108844e-05, -2.7418097943154862e-06, -1.311301275563892e-06, -0.9073314070701599, -0.12509886920452118, -1.0609570381348021e-05, -2.682172998902388e-05, -0.2257409393787384, -5.960462772236497e-07, -1.0132738680113107e-05, -0.45697689056396484, -1.2159273865108844e-