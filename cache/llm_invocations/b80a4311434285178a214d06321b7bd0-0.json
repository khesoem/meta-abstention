{nx, ny});\n        }\n    }\n    return dist;\n}\n\nvoid read_and_build() {\n    int N, T;\n    cin >> N >> T;\n    grid A(N), B(N);\n    for (int i = 0; i < N; ++i) cin >> A[i];\n    for (int i = 0; i < N; ++i) cin >> B[i];\n\n    int rx = -1, ry = -1;\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            if (A[i][j] == 'Z') rx = i, ry = j;\n\n    auto D = calc_dist(rx, ry, A);\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (!ok(i, j, A)) continue;\n            auto D2 = calc_dist(i, j, A);\n            for (int x = 0; x < N; ++x) {\n                for (int y = 0; y < N; ++y) {\n                    if (!ok(x, y, A) ||\n                        D2[x][y] > T ||\n                        D2[x][y] > D[x][y])\n                        continue;\n\n                    if (D2[x][y] == D[x][y]) {\n                        bool ok_flag = false;\n                        for (int k = 0; k < 4; ++k) {\n                            int nx = x + dx[k], ny = y + dy[k];\n                            if (ok(nx, ny, A) && D2[nx][ny] < D[nx][ny]) ok_flag = true;\n                        }\n                        if (!ok_flag) continue;\n                    }\n\n                    int c1 = A[i][j] - '0';\n                    int c2 = B[x][y] - '0';\n                    for (int u = 1; u <= c1; ++u) {\n                        for (int v = 1; v <= c2; ++v) {\n                            int src = i * 100 + j * 10 + u;\n                            int dst = x * 100 + y * 10 + v;\n                            g[src].push_back(dst);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\nbool dfs(int u) {\n    if (vis[u]) return false;\n    vis[u] = true;\n    for (int v : g[u]) {\n        if (!mt[v] || dfs(mt[v])) {\n            mt[v] = u;\n            return true;\n        }\n    }\n    return false;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    read_and_build();\n    int cnt = 0;\n    for (int i = 0; i < MAXN; ++i) {\n        fill(vis, vis + MAXN, false);\n        cnt += dfs(i);\n    }\n    cout << cnt << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    if not data:\n        return\n    \n    N, T = map(int, data[0].split())\n    A = []\n    B = []\n    for i in range(1, N + 1):\n        A.append(data[i])\n    for i in range(N + 1, 2 * N + 1):\n        B.append(data[i])\n    \n    INF = 10**18\n    MAXN = 1000\n    \n    dx = [0, 0, -1, 1]\n    dy = [-1, 1, 0, 0]\n    \n    def ok(x, y, grid):\n        return (x >= 0 and y >= 0 and \n                x < len(grid) and y < len(grid) and \n                grid[x][y] not in 'YZ')\n    \n    def calc_dist(sx, sy, grid):\n        n = len(grid)\n        dist = [[INF] * n for _ in range(n)]\n        q = deque()\n        dist[sx][sy] = 0\n        q.append((sx, sy))\n        while q:\n            x, y = q.popleft()\n            for k in range(4):\n                nx, ny = x + dx[k], y + dy[k]\n                if not ok(nx, ny, grid) or dist[nx][ny] != INF:\n                    continue\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n        return dist\n    \n    rx, ry = -1, -1\n    for i in range(N):\n        for j in range(N):\n            if A[i][j] == 'Z':\n                rx, ry = i, j\n    \n    D = calc_dist(rx, ry, A)\n    \n    g = [[] for _ in range(MAXN)]\n    \n    for i in range(N):\n        for j in range(N):\n            if not ok(i, j, A):\n                continue\n            D2 = calc_dist(i, j, A)\n            for x in range(N):\n                for y in range(N):\n                    if not ok(x, y, A) or D2[x][y] > T or D2[x][y] > 