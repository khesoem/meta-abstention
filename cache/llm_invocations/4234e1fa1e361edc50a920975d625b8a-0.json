{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n/* \ufffd\ufffd\ufffd\ufffd\u037c\ufffd\ufffd\ufffd\u01a5\ufffd\ufffd / \ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\u3de8 / Hungary(DFS)\n\nBy \ufffd\ufffd\ufffd\ufffd\u04b2\ufffd\ufffd\ufffd @ 2011.04.10 */\n\n#include <cstring>\n#include <vector>\nusing namespace std;\n\nclass Hungary{\npublic:\n    static const int SIZE = 2000; // \ufffd\ufffd\udb96\udd72\ufffd\ufffd\ufffd\ufffd\ufffd\n    int cnt,pos[SIZE],rev[SIZE];\n    // \ufffd\u38e1\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\u01a5\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffdcnt\ufffd\ufffd\u03b4\u01a5\ufffd\ufffd\ufffd\ufffd\ufffdpos\ufffd\ufffdrev\u05b5\u03aa-1\n    // \ufffd\ufffd\ufffd\ufffd\ufffd\u04e6\ufffd\ufffd\ufffd\u04b2\ufffd\ufffd\ufffd\u0174\ufffd\ufffd\ufffdpos[]\ufffd\ufffd\ufffd\u04b2\ufffd\ufffd\ufffd\u04e6\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\u0174\ufffd\ufffd\ufffdrev[]\n    // \ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\u0138\ufffd\ufffd\ufffdn\ufffd\ufffd\ufffd\ufffd\ufffd\ufffd\u0133\ufffd\ufffd\ufffde[]\n    int gao(int n, vector<int> e[]){\n        cnt=0;\n        memset(pos,255,sizeof(pos));\n        memset(rev,255,sizeof(rev));\n        for(int i=0;i<n;i++){\n            memset(v,0,sizeof(v));\n            if(match(i,e)) cnt++;\n        }\n        return cnt;\n    }\nprivate:\n    int v[SIZE];\n    bool match(int x, vector<int> e[]){\n        for(int i=0;i<int(e[x].size());i++){\n            int y=e[x][i];\n            if(!v[y]) v[y]=1; else continue;\n            if(rev[y]<0 || match(rev[y],e)){\n                pos[x]=y;\n                rev[y]=x;\n                return true;\n            }\n        }\n        return false;\n    }\n};\n\n#include <cstdio>\n#include <cmath>\n#include <cstring>\n#include <utility>\n#include <vector>\n#include <queue>\n#include <algorithm>\nusing namespace std;\n\nconst int INF=1000000000;\nconst int mr[]={0,-1,0,1};\nconst int mc[]={1,0,-1,0};\n\nint a[12][12],b[12][12],f[12][12],m,t;\nvector<int> e[2000];\nvector<int> c[12][12];\n\nvoid floodfill(int sr, int sc){\n    queue<int> qr;\n    queue<int> qc;\n    memset(f,255,sizeof(f));\n    qr.push(sr);\n    qc.push(sc);\n    f[sr][sc]=0;\n    while(!qr.empty()){\n        sr=qr.front(); qr.pop();\n        sc=qc.front(); qc.pop();\n        for(int i=0;i<4;i++){\n            int tr=sr+mr[i];\n            int tc=sc+mc[i];\n            if(a[tr][tc]>=0 && f[tr][tc]<0){\n                f[tr][tc]=f[sr][sc]+1;\n                qr.push(tr);\n                qc.push(tc);\n            }\n        }\n    }\n}\n\nvoid setmark(int sr, int sc, int cnt){\n    int v[12][12];\n    queue<int> qr;\n    queue<int> qc;\n    memset(v,255,sizeof(v));\n    qr.push(sr);\n    qc.push(sc);\n    v[sr][sc]=0;\n    //printf(\"escape from (%d,%d) ->\",sr,sc);\n    while(!qr.empty()){\n        sr=qr.front(); qr.pop();\n        sc=qc.front(); qc.pop();\n        if(v[sr][sc]> min(t,f[sr][sc])) continue;\n        for(int j=0;j<int(c[sr][sc].size());j++)\n            for(int i=0;i<cnt;i++) e[m+i].push_back(c[sr][sc][j]);\n        if(v[sr][sc]==min(t,f[sr][sc])) continue;\n        for(int i=0;i<4;i++){\n            int tr=sr+mr[i];\n            int tc=sc+mc[i];\n            if(a[tr][tc]>=0 && v[tr][tc]<0){\n                v[tr][tc]=v[sr][sc]+1;\n                qr.push(tr);\n                qc.push(tc);\n            }\n        }\n    }\n    //printf(\" %d\\n\",e[m].size());\n    m+=cnt;\n}\n\nHungary match;\n\nint main(){\n    int n,sr,sc,o=m=0;\n    scanf(\"%d%d\",&n,&t);\n    memset(a,255,sizeof(a));\n    memset(b,255,sizeof(b));\n    for(int i=1;i<=n;i++){\n        while(getchar()!='\\n');\n        for(int j=1;j<=n;j++){\n            char ch=getchar();\n            if(ch>='0' && ch<='9') a[i][j]=ch-'0';\n            if(ch=='Z'){\n                sr=i;\n                sc=j;\n            }\n        }\n    }\n    floodfill(sr,sc);\n    while(getchar()!='\\n');\n    for(int i=1;i<=n;i++){\n        while(getchar()!='\\n');\n        for(int j=1;j<=n;j++){\n            char ch=getchar();\n            if(ch>='0' && ch<='9') b[i][j]=ch-'0';\n            for(int k=0;k<b[i][j];k++) c[i][j].push_back(o++);\n        }\n    }\n    for(int i=1;i<=n;i++) for(int j=1;j<=n;j++) if(f[i][j]<0) f[i][j]=INF;\n    for(int i=1;i<=n;i++) for(int j=1;j<=n;j++) if(a[i][j]>0) setmark(i,j,a[i][j]);\n    /*\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",a[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",b[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n        for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",f[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n    printf(\"%d %d -> \",m,o);\n    //*/\n    printf(\"%d\\n\",match.gao(m,e));\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Hungary:\n    SIZE = 2000\n    \n    def __init__(self):\n        self.cnt = 0\n        self.pos = [-1] * self.SIZE\n        self.rev = [-1] * self.SIZE\n        self.v = [0] * self.SIZE\n    \n    def match(self, x, e):\n        for y in e[x]:\n            if not self.v[y]:\n                self.v[y] = 1\n            else:\n                continue\n            if self.rev[y] < 0 or self.match(self.rev[y], e):\n                self.pos[x] = y\n                self.rev[y] = x\n                return True\n        return False\n    \n    def gao(self, n, e):\n        self.cnt = 0\n        self.pos = [-1] * self.SIZE\n        self.rev = [-1] * self.SIZE\n        for i in range(n):\n            self.v = [0] * self.SIZE\n            if self.match(i, e):\n                self.cnt += 1\n        return self.cnt\n\ndef main():\n    input_data = sys.stdin.read().splitlines()\n    if not input_data:\n        return\n    \n    n, t = map(int, input_data[0].split())\n    \n    a = [[-1] * 12 for _ in range(12)]\n    b = [[-1] * 12 for _ in range(12)]\n    f = [[-1] * 12 for _ in range(12)]\n    m = 0\n    o = 0\n    \n    # Direction vectors for flood fill\n    mr = [0, -1, 0, 1]\n    mc = [1, 0, -1, 0]\n    \n    e = [[] for _ in range(2000)]\n    c = [[[] for _ in range(12)] for _ in range(12)]\n    \n    # Read grid a\n    line_idx = 1\n    for i in range(1, n+1):\n        if line_idx >= len(input_data):\n            break\n        line = input_data[line_idx]\n        line_idx += 1\n        for j in range(1, n+1):\n            if j <= len(line):\n                ch = line[j-1]\n                if ch.isdigit():\n                    a[i][j] = int(ch)\n                elif ch == 'Z':\n                    sr, sc = i, j\n    \n    # Flood fill from sr, sc\n    def floodfill(sr, sc):\n        qr = deque()\n        qc = deque()\n        for i in range(12):\n            for j in range(12):\n                f[i][j] = -1\n        qr.append(sr)\n        qc.append(sc)\n        f[sr][sc] = 0\n        while qr:\n            sr = qr.popleft()\n            sc = qc.popleft()\n            for i in range(4):\n                tr = sr + mr[i]\n                tc = sc + mc[i]\n                if 0 <= tr < 12 and 0 <= tc < 12 and a[tr][tc] >= 0 and f[tr][tc] < 0:\n                    f[tr][tc] = f[sr][sc] + 1\n                    qr.append(tr)\n                    qc.append(tc)\n    \n    floodfill(sr, sc)\n    \n    # Read grid b\n    for i in range(1, n+1):\n        if line_idx >= len(input_data):\n            break\n        line = input_data[line_idx]\n        line_idx += 1\n        for j in range(1, n+1):\n            if j <= len(line):\n                ch = line[j-1]\n                if ch.isdigit():\n                    b[i][j] = int(ch)\n                for k in range(b[i][j]):\n                    c[i][j].append(o)\n                    o += 1\n    \n    # Set INF for unreachable cells\n    INF = 1000000000\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if f[i][j] < 0:\n                f[i][j] = INF\n    \n    # Process each cell with a[i][j] > 0\n    def setmark(sr, sc, cnt):\n        nonlocal m\n        v = [[-1] * 12 for _ in range(12)]\n        qr = deque()\n        qc = deque()\n        for i in range(12):\n            for j in range(12):\n                v[i][j] = -1\n        qr.append(sr)\n        qc.append(sc)\n        v[sr][sc] = 0\n        \n        while qr:\n            sr = qr.popleft()\n            sc = qc.popleft()\n            if v[sr][sc] > min(t, f[sr][sc]):\n                continue\n            for j in range(len(c[sr][sc])):\n                for i in range(cnt):\n                    e[m + i].append(c[sr][sc][j])\n            if v[sr][sc] == min(t, f[sr][sc]):\n                continue\n            for i in range(4):\n                tr = sr + mr[i]\n                tc = sc + mc[i]\n                if 0 <= tr < 12 and 0 <= tc < 12 and a[tr][tc] >= 0 and v[tr][tc] < 0:\n                    v[tr][tc] = v[sr][sc] + 1\n                    qr.append(tr)\n                    qc.append(tc)\n        m += cnt\n    \n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if a[i][j] > 0:\n                setmark(i, j, a[i][j])\n    \n    match = Hungary()\n    print(match.gao(m, e))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012313561455812305, -1.7881377516459906e-06, -3.576278118089249e-07, -0.06836968660354614, -0.0019957164768129587, -4.0531076592742465e-06, -0.008617476560175419, -0.00024387246230617166, -1.7881377516459906e-06, -0.00026520551182329655, -0.1799207180738449, -0.20807643234729767, -0.00038818930624984205, -2.074220174108632e-05, -1.5497195136049413e-06, -0.11292500048875809, -1.7881377516459906e-06, 0.0, -1.7881233361549675e-05, -1.4305104514278355e-06, -2.2053474822314456e-05, -2.777537883957848e-05, -0.3287520408630371, -5.960446742392378e-06, -5.006777428206988e-06, -0.0003466005437076092, -5.960462772236497e-07, -8.344646857949556e-07, -3.576278118089249e-07, -5.960462772236497e-07, -1.490105023549404e-05, -1.311301275563892e-06, -0.08069594204425812, -1.1205610462639015e-05, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.1920922133867862e-06, -2.3841855067985307e-07, -3.4570634852570947e-06, -1.2040065485052764e-05, -1.1920928244535389e-07, -4.815939246327616e-05, -5.960462772236497e-07, -8.344646857949556e-07, 0.0, -0.000679500459227711, -2.1457441107486375e-05, -6.9141146923357155e-06, -2.3841855067985307e-07, 0.0, -1.9073304429184645e-05, -4.768370445162873e-07, -9.536738616588991e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -2.0265373677830212e-05, -1.0728830375228426e-06, -4.3987260141875595e-05, -0.5379549264907837, -5.960462772236497e-07, -5.602820692729438e-06, -0.008192387409508228, -1.311301275563892e-06, -1.5020257706055418e-05, -2.145764938177308e-06, 0.0, -1.1920928244535389e-07, -6.079655122448457e-06, -7.319182623177767e-05, -0.04781417176127434, -5.006777428206988e-06, -3.4570634852570947e-06, -0.049083102494478226, -0.0022671727929264307,