pseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        scanner.close();\n\n        long bestNum = -1;\n        int bestDen = -1;\n\n        for (int i = 1; i <= n; i++) {\n            long cur = i * x / y;\n            update(cur - 1, i, x, y, bestNum, bestDen);\n            update(cur, i, x, y, bestNum, bestDen);\n            update(cur + 1, i, x, y, bestNum, bestDen);\n        }\n\n        System.out.println(bestNum + \"/\" + bestDen);\n    }\n\n    private static void update(long a, int b, long x, long y, long bestNum, int bestDen) {\n        if (a < 0) return;\n        if (bestNum == -1) {\n            bestNum = a;\n            bestDen = b;\n            return;\n        }\n        long left = Math.abs(bestDen * x - bestNum * y) * b;\n        long right = Math.abs(b * x - a * y) * bestDen;\n        if (left > right) {\n            bestNum = a;\n            bestDen = b;\n        } else if (left == right && (b < bestDen || (b == bestDen && a < bestNum))) {\n            bestNum = a;\n            bestDen = b;\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.5\n</confidence>", "token_logprobs": [-6.198864e-06, 0.0, 0.0, -8.225407e-06, -1.6569955e-05, -2.264974e-06, -0.10022017, -0.015279505, -0.008634022, -8.225407e-06, 0.0, -0.0019831054, -0.00010346831, -0.00012849936, -0.019579709, 0.0, -0.00026723152, -1.1920928e-07, -5.960463e-07, -9.655906e-06, -1.6689287e-06, -1.6689287e-06, -3.70734e-05, -2.3841855e-07, -0.00012396998, -0.6971947, 0.0, 0.0, -8.344647e-07, -9.5367386e-07, 0.0, -5.161629e-05, -0.0024773167, -4.7563375e-05, -0.00043787903, -0.00861464, -9.5367386e-07, -8.344647e-07, 0.0, -6.675698e-06, 0.0, 0.0, -1.1920928e-07, 0.0, -8.344647e-07, -2.3841855e-07, 0.0, -2