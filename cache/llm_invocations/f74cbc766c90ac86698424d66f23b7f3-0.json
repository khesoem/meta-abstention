ot in online judge environment\n    try:\n        import os\n        if not os.environ.get('ONLINE_JUDGE'):\n            if os.path.exists('input.txt'):\n                sys.stdin = open('input.txt', 'r')\n            if os.path.exists('output.txt'):\n                sys.stdout = open('output.txt', 'w')\n    except:\n        pass\n    \n    # Read input\n    line = input().split()\n    mod = int(line[0])\n    k = int(line[1])\n    \n    j = 1\n    if k != 0:\n        t = 1\n        for i in range(1, mod):\n            t = (t * k) % mod\n            if t == 1:\n                j = i\n                break\n    \n    ans = 1\n    num = (mod - 1) // j\n    for i in range(num):\n        ans = (ans * mod) % MOD7\n    \n    if k == 1:\n        ans = (ans * mod) % MOD7\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012087091454304755, -9.536738616588991e-07, -1.1920928244535389e-07, -0.03184405341744423, -0.000418575422372669, -0.0011706650257110596, -0.47423964738845825, -1.0490362910786644e-05, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -1.0251946150674485e-05, 0.0, 0.0, 0.0, -7.152531907195225e-06, -1.1920928244535389e-07, 0.0, -6.318072337307967e-06, -7.152555099310121e-07, -0.0010742137674242258, -4.255681051290594e-05, -1.9550132492440753e-05, -5.602820692729438e-06, -0.22739684581756592, -0.22719208896160126, -0.028217291459441185, -0.04220287501811981, -5.960462772236497e-07, -0.5405339002609253, -0.03228287026286125, -0.3296343684196472, -0.03688672557473183, -0.0031884093768894672, -0.36645689606666565, -0.0003355178632773459, -3.099436753473128e-06, -0.1286066323518753, -4.768370445162873e-07, -1.4305104514278355e-06, -0.4522002339363098, -0.007941930554807186, -1.2397689715726301e-05, -1.156323378381785e-05, -1.3589766240329482e-05, -0.00503782881423831, -0.007642908953130245, -0.10085224360227585, -2.3841855067985307e-07, -0.029755739495158195, -0.00668539060279727