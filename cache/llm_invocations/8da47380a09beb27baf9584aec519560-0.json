][i - 1]\n    for neighbor in adjList[v]:\n        if neighbor != p:\n            recur_bl(neighbor, v)\n    ct += 1\n    tout[v] = ct\n\ndef is_ancestor(u, v):\n    return tin[u] <= tin[v] and tout[u] >= tout[v]\n\ndef lca(u, v):\n    if is_ancestor(u, v):\n        return u\n    if is_ancestor(v, u):\n        return v\n    for i in reversed(range(log2(len(adjList)) + 1)):\n        if not is_ancestor(BL[u][i], v):\n            u = BL[u][i]\n    return BL[u][0]\n\ndef log2(n):\n    return math.ceil(math.log10(n) / math.log10(2))\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0005219352315180004, -0.0002821928064804524, -3.054500666621607e-06, -0.00012130453251302242, -0.012581470422446728, -0.38688212633132935, -0.00409371592104435, -9.372294698550832e-06, -7.896309739408025e-07, -0.0028773918747901917, -0.030688010156154633, -2.1888679839321412e-05, -1.5048530030981055e-06, -0.0003510741807986051, -4.842555426876061e-06, -5.319370302458992e-06, -0.00020354038861114532, -5.512236498361744e-07, -0.04317616671323776, -0.2632285952568054, -0.00021927160560153425, -3.7697225252486533e-06, -0.0007450680714100599, -0.009423366747796535, -2.7372048862162046e-05, -3.054500666621607e-06, -1.1472419600977446e-06, -0.21924157440662384, -0.9417995810508728, -2.927930654550437e-05, -1.9361264946837764e-07, -1.2664456789934775e-06, -0.0017067246371880174, -0.1427145153284073, -0.003630954073742032, -0.25580593943595886, -9.253090865968261e-06, -7.896309739408025e-07, -8.895480277715251e-06, -2.6895233531831764e-05, -0.00020413640595506877, -0.00012511172099038959, -3.128163257315464e-07, -4.320199877838604e-07, -0.004778872709721327, -0.0011873723706230521, -2.5776860184123507e-06, -1.6240566083070007e-06, -0.2519770860671997, -1.5048530030981055e-06, -9.627176768844947e-05, -1.1160349458805285e-05, -0.04302305355668068, -0.2811613380908966, -5.88418151892256e-05, -5.013994814362377e-05, -8.9953973656520