  this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final int N = 14043;\n    static final long INF = (long)4e18;\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[N];\n    static long[] potential = new long[N];\n    static long[] dist = new long[N];\n    static int[] pv = new int[N];\n    static int[] pe = new int[N];\n    static final int S = N - 2;\n    static final int T = N - 1;\n    static long answer = 0;\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        adj[u].add(edges.size());\n        edges.add(new Edge(u, v, cap, 0, cost));\n        adj[v].add(edges.size());\n        edges.add(new Edge(v, u, 0, 0, -cost));\n    }\n\n    static void dijkstra() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(pv, -1);\n        Arrays.fill(pe, -1);\n\n        PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n        dist[S] = 0;\n        pq.add(new long[]{0, S});\n\n        while (!pq.isEmpty()) {\n            long[] cur = pq.poll();\n            long d = cur[0];\n            int u = (int)cur[1];\n\n            if (d != dist[u]) continue;\n\n            for (int id : adj[u]) {\n                Edge e = edges.get(id);\n                if (e.cap - e.flow <= 0) continue;\n\n                int v = e.to;\n                long w = (long)e.cost + potential[u] - potential[v];\n\n                if (dist[v] > d + w) {\n                    dist[v] = d + w;\n                    pv[v] = u;\n                    pe[v] = id;\n                    pq.add(new long[]{dist[v], v});\n                }\n            }\n        }\n\n        for (int i = 0; i < N; i++) {\n            if (dist[i] < INF / 2) {\n                potential[i] += dist[i];\n            }\n        }\n    }\n\n    static void augment() {\n        int cur = T;\n        while (cur != S) {\n            int id = pe[cur];\n            Edge e = edges.get(id);\n            e.flow++;\n            edges.get(id ^ 1).flow--;\n            cur = pv[cur];\n        }\n        answer += potential[T];\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        for (int i = 0; i < N; i++) {\n            adj[i] = new ArrayList<>();\n        }\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(st.nextToken());\n            addEdge(S, x, 1, 0);\n        }\n\n        int tt = 101;\n        for (int i = 0; i < tt; i++) {\n            addEdge(1 + i * n, T, k, i * c);\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            for (int step = 0; step < tt - 1; step++) {\n                for (int j = 0; j < k; j++) {\n                    addEdge(x + step * n, y + step * n + n, 1, d * (j * 2 + 1));\n                    addEdge(y + step * n, x + step * n + n, 1, d * (j * 2 + 1));\n                }\n            }\n        }\n\n        for (int city = 0; city < n; city++) {\n            for (int step = 0; step < tt - 1; step++) {\n                addEdge(city + step * n, city + step * n + n, k, 0);\n            }\n        }\n\n        for (int i = 0; i < k; i++) {\n            dijkstra();\n            augment();\n        }\n\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [0.0, -0.20141352713108063,