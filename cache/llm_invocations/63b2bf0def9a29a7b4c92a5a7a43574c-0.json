is.to = to;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static final int MAXN = 14043;\n    static List<Edge> edges = new ArrayList<>();\n    static List<Integer>[] adj = new ArrayList[MAXN];\n    static long total_cost = 0;\n    static long[] dist = new long[MAXN];\n    static int[] parent = new int[MAXN];\n    static int[] parent_edge = new int[MAXN];\n    static boolean[] in_queue = new boolean[MAXN];\n    static final long INF = (long) 1e18;\n    static int source = MAXN - 2;\n    static int sink = MAXN - 1;\n\n    static int residual(int idx) {\n        return edges.get(idx).cap - edges.get(idx).flow;\n    }\n\n    static void augment() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(parent, -1);\n        Arrays.fill(parent_edge, -1);\n        Arrays.fill(in_queue, false);\n        dist[source] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.add(source);\n        in_queue[source] = true;\n        while (!q.isEmpty()) {\n            int v = q.poll();\n            in_queue[v] = false;\n            for (int idx : adj[v]) {\n                if (residual(idx) == 0) continue;\n                int c = edges.get(idx).cost;\n                int to = edges.get(idx).to;\n                if (dist[to] > dist[v] + c) {\n                    dist[to] = dist[v] + c;\n                    parent[to] = v;\n                    parent_edge[to] = idx;\n                    if (!in_queue[to]) {\n                        in_queue[to] = true;\n                        q.add(to);\n                    }\n                }\n            }\n        }\n        int cur = sink;\n        while (cur != source) {\n            Edge e = edges.get(parent_edge[cur]);\n            e.flow++;\n            Edge rev = edges.get(parent_edge[cur] ^ 1);\n            rev.flow--;\n            cur = parent[cur];\n        }\n        total_cost += dist[sink];\n    }\n\n    static void add_edge(int x, int y, int cap, int co