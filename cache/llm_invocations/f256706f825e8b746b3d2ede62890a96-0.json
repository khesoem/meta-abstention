nd remainder\n        prod = i * x\n        j = prod // y\n        r = prod % y\n\n        # round to nearest integer (if remainder > y/2, increment)\n        if r > y - r:\n            j += 1\n\n        # compare absolute errors: |bestA/y - x/bestB| vs |j/y - x/i|\n        # using cross-multiplication to avoid floating point\n        if bestA == -1:\n            bestA = j\n            bestB = i\n        else:\n            # compute |bestA * y - x * bestB| * i  vs  |j * y - x * i| * bestB\n            left = abs(bestA * y - x * bestB) * i\n            right = abs(j * y - x * i) * bestB\n            if left > right:\n                bestA = j\n                bestB = i\n        i += 1\n\n    sys.stdout.write(f\"{bestA}/{bestB}\\n\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.3828182090946939e-05, 0.0, -1.1920928244535389e-07, -8.809178689261898e-05, -0.012758651748299599, -5.829164365422912e-05, -0.00249396450817585, -9.679325739853084e-05, -0.0032656455878168344, -0.0009128456003963947, -1.1920922133867862e-06, -0.06859923154115677, 0.0, -7.10462118149735e-05, 0.0, -0.014163801446557045, -8.344646857949556e-07, -0.06196772679686546, -1.0132738680113107e-05, -1.1920928244535389e-07, -2.861018856492592e-06, 0.0, -4.410734163684538e-06, -0.06196828559041023, -1.1920928244535389e-07, -2.1576648578047752e-05, -3.576278118089249e-07, -2.3841855067985307e-07, -5.960462772236497e-07, 0.0, -8.583032467868179e-06, -0.2519312798976898, 0.0, 0.0, 0.0, 0.0, -4.529942543740617e-06, -4.565611743601039e-05, 0.0, -1.1920928244535389e-07, -0.0006721144891344011, -1.1920928244535389e-07, -0.4741373062133789, 0.0, -2.3841855067985307e-07, -0.018265029415488243, -6.198863957251888e-06, -1.2755313036905136e-05, 0.0, -2.2649508537142538e-05, 0.0, -3.099436753473128e-06, 0.0, 0.0, -0.0016285026213154197, -0.31327036023139954, -0.5794224143028259, 0.0, -0.915186882019043, -0.028483577072620392, -0.086636848747730