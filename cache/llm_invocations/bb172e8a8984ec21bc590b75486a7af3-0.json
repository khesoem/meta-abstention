s": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXV = 10005;\n    static final int MAXE = 2000000 + 10;\n    static final int INF = 2000000000;\n\n    static class MinCostFlow {\n        int[] head, to, nxt, cap, cost;\n        int edgeCnt;\n        int src, sink;\n        Queue<Integer> q;\n        long[] dis;\n        boolean[] inq;\n\n        MinCostFlow(int s, int t) {\n            src = s;\n            sink = t;\n            edgeCnt = 1;\n            head = new int[MAXV];\n            to = new int[MAXE];\n            nxt = new int[MAXE];\n            cap = new int[MAXE];\n            cost = new int[MAXE];\n            q = new LinkedList<>();\n            dis = new long[MAXV];\n            inq = new boolean[MAXV];\n        }\n\n        void addEdge(int u, int v, int flow, int w) {\n            to[++edgeCnt] = v;\n            nxt[edgeCnt] = head[u];\n            head[u] = edgeCnt;\n            cap[edgeCnt] = flow;\n            cost[edgeCnt] = w;\n            to[++edgeCnt] = u;\n            nxt[edgeCnt] = head[v];\n            head[v] = edgeCnt;\n            cap[edgeCnt] = 0;\n            cost[edgeCnt] = -w;\n        }\n\n        boolean spfa() {\n            Arrays.fill(inq, false);\n            Arrays.fill(dis, Long.MAX_VALUE / 2);\n            q.add(sink);\n            dis[sink] = 0;\n            inq[sink] = true;\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                inq[x] = false;\n                for (int i = head[x]; i != 0; i = nxt[i]) {\n                    int y = to[i];\n                    if (cap[i ^ 1] > 0 && dis[y] > dis[x] + cost[i ^ 1]) {\n                        dis[y] = dis[x] + cost[i ^ 1];\n                        if (!inq[y]) {\n                            q.add(y);\n                            inq[y] = true;\n                        }\n                    }\n                }\n        