(len(x), x, 0);\n    cout << answer << '\\n';\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    init();\n    run();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(10000)\n\nrep = [0] * 20\np10 = [0] * 20\nanswer = -1\n\ndef init():\n    global rep, p10\n    p10[0] = 1\n    for i in range(1, 20):\n        p10[i] = p10[i-1] * 10\n        rep[i] = rep[i-1] * 10 + 1\n\ndef len_func(x):\n    if x == 0:\n        return 1\n    c = 0\n    while x:\n        c += 1\n        x //= 10\n    return c\n\ndef dfs(lvl, val, steps):\n    global answer\n    if answer != -1 and steps >= answer:\n        return\n    \n    if val == 0 or lvl == 0:\n        if answer == -1:\n            answer = steps\n        else:\n            answer = min(answer, steps)\n        return\n    \n    if val < 0:\n        val = -val\n    \n    r = val\n    s = 0\n    while r >= p10[lvl-1]:\n        r -= rep[lvl]\n        s += lvl\n    dfs(lvl-1, r, steps + s)\n    \n    r = rep[lvl+1] - val\n    s = 0\n    while r >= p10[lvl-1]:\n        r -= rep[lvl]\n        s += lvl\n    dfs(lvl-1, r, steps + lvl + 1 + s)\n\ndef run():\n    global answer\n    x = int(input().strip())\n    answer = -1\n    dfs(len_func(x), x, 0)\n    print(answer)\n\nif __name__ == \"__main__\":\n    init()\n    run()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018618757894728333, -5.960462772236497e-07, -1.1920928244535389e-07, -0.016051122918725014, -0.0007927850820124149, -0.47408396005630493, -0.18020538985729218, -2.3841855067985307e-07, -4.51792984677013e-05, -1.9192511899746023e-05, -2.7656173188006505e-05, -2.3841855067985307e-07, -9.059865078597795e-06, -1.5497195136049413e-06, -7.152555099310121e-07, 0.0, -2.0265558760002023e-06, -0.08894818276166916, -0.6075693368911743, -3.576278118089249e-07, -