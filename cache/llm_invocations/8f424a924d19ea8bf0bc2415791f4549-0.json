distance = [INF] * n\n        self.inqueue = [False] * n\n        self.prev_edge_index = [-1] * n\n        self.min_flow_on_path = [INF] * n\n\n    def addEdge(self, u, v, cap, cst):\n        idx = len(self.edges)\n        self.edges.append(Edge(u, v, cap, 0, cst))\n        self.edges.append(Edge(v, u, 0, 0, -cst))\n        self.adj[u].append(idx)\n        self.adj[v].append(idx + 1)\n\n    def computePath(self):\n        self.distance = [INF] * self.nodes\n        self.inqueue = [False] * self.nodes\n        self.prev_edge_index = [-1] * self.nodes\n        self.min_flow_on_path = [INF] * self.nodes\n\n        q = deque()\n        q.append(0)\n        self.distance[0] = 0\n        self.inqueue[0] = True\n        self.min_flow_on_path[0] = INF\n\n        while q:\n            u = q.popleft()\n            self.inqueue[u] = False\n\n            for eidx in self.adj[u]:\n                e = self.edges[eidx]\n                if e.capacity > e.flow and self.distance[e.to_node] > self.distance[u] + e.cost:\n                    self.distance[e.to_node] = self.distance[u] + e.cost\n                    self.prev_edge_index[e.to_node] = eidx\n                    self.min_flow_on_path[e.to_node] = min(self.min_flow_on_path[u], e.capacity - e.flow)\n                    if not self.inqueue[e.to_node]:\n                        q.append(e.to_node)\n                        self.inqueue[e.to_node] = True\n\n        if self.distance[1] == INF:\n            return False, 0, 0\n\n        flow_on_this_path = self.min_flow_on_path[1]\n        cost_per_flow = self.distance[1]\n        cur = 1\n        while cur != 0:\n            eidx = self.prev_edge_index[cur]\n            self.edges[eidx].flow += flow_on_this_path\n            self.edges[eidx ^ 1].flow -= flow_on_this_path\n            cur = self.edges[eidx].from_node\n\n        return True, flow_on_this_path, cost_per_flow\n\n    def getMinCostFlow(self, src, dst):\n        # Adjust node mapping: shift everything so src and dst go where expected\n        for e in self.edges:\n            if e.from_node == 0:\n                e.from_node = src\n            elif e.from_node == 1:\n                e.from_node = dst\n            if e.to_node == 0:\n                e.to_node = src\n            elif e.to_node == 1:\n                e.to_node = dst\n\n        total_flow = 0\n        total_cost = 0\n\n        while True:\n            found, flow, cost = self.computePath()\n            if not found:\n                break\n            total_flow += flow\n            total_cost += flow * cost\n\n        return total_flow, total_cost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    total_nodes = n * MAX_TIME + 2\n    solver = MCMF(total_nodes)\n    source_id = n * MAX_TIME\n    sink_id = n * MAX_TIME + 1\n\n    for t in range(MAX_TIME):\n        solver.addEdge(t, sink_id, k, C * t)\n\n    for i in range(k):\n        x = int(next(it)) - 1\n        solver.addEdge(source_id, x * MAX_TIME, 1, 0)\n\n    for i in range(n):\n        for t in range(1, MAX_TIME):\n            solver.addEdge(i * MAX_TIME + t - 1, i * MAX_TIME + t, k, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n\n        for t in range(1, MAX_TIME):\n            a = u * MAX_TIME + t - 1\n            b = v * MAX_TIME + t\n            c = v * MAX_TIME + t - 1\n            d = u * MAX_TIME + t\n\n            cc = D\n            for i in range(1, k + 1):\n                solver.addEdge(a, b, 1, cc)\n                solver.addEdge(c, d, 1, cc)\n                cc += 2 * D\n\n    result = solver.getMinCostFlow(source_id, sink_id)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-5.221230458118953e-05, -0.00028784899041056633, -1.072883