gree++) {\n            power = power * mInv % MOD;\n            result = (result + (long)dp[degree] * power) % MOD;\n        }\n        \n        System.out.println(result);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef mod_inverse(a):\n    # Using Fermat's little theorem since MOD is prime\n    # a^(-1) mod MOD = a^(MOD-2) mod MOD\n    return pow(a, MOD - 2, MOD)\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    m = int(data[1])\n    m_inv = mod_inverse(m)\n    k = int(data[2])\n    \n    dp = [0] * (k + 1)\n    dp[0] = 1\n    \n    for step in range(k):\n        for degree in range(k - 1, -1, -1):\n            if dp[degree] != 0:\n                dp[degree + 1] = (dp[degree + 1] + dp[degree] * (n - degree)) % MOD\n                dp[degree] = (dp[degree] * degree) % MOD\n    \n    power = 1\n    result = 0\n    for degree in range(1, k + 1):\n        power = (power * m_inv) % MOD\n        result = (result + dp[degree] * power) % MOD\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012265883560758084, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.297468900680542, -0.01439813431352377, -0.029759788885712624, -0.0205860435962677, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -1.9073468138230965e-06, -8.344646857949556e-07, -1.311301275563892e-06, -1.2278481335670222e-05, -2.8609820219571702e-05, -6.6756979322235566e-06, -5.960462772236497e-07, -7.033323527139146e-06, -1.4066597032069694e-05, -4.649054244509898e-05, -0.11285993456840515, -1.7881377516459906e-06, -0.25196611881256104, -4.0531076592742465e-06, -0.13810686767101288, -0.02956930734217167, -0.24142248928546906, -1.2874520507466514e-05, -4.768370445162873e-07, -0.0015316194621846