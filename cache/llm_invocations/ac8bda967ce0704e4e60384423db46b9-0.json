iginal_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom functools import lru_cache\n\ndef main():\n    n = int(sys.stdin.readline().strip())\n    \n    rep = [0] * 18\n    rep[1] = 1\n    for i in range(2, 18):\n        rep[i] = rep[i-1] * 10 + 1\n    \n    init = 0\n    cur = n\n    while cur > 0:\n        for i in range(1, 18):\n            if rep[i] > cur:\n                init += (i - 1)\n                cur -= rep[i-1]\n                break\n    \n    optimal = init\n    \n    def traverse(depth, rem, pos):\n        nonlocal optimal\n        if depth >= optimal:\n            return\n        if rem == 0:\n            optimal = depth\n            return\n        unit = rep[pos]\n        multiple = rem // unit\n        traverse(depth + pos * multiple, rem - multiple * unit, pos - 1)\n        traverse(depth + pos * (multiple + 1), multiple * unit - rem, pos - 1)\n    \n    traverse(0, n, 16)\n    print(optimal)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.3774932641536e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.28642746806144714, -0.00045885046711191535, -0.02975238487124443, -0.07016462832689285, -0.004648949019610882, -4.768370445162873e-07, -0.0002470903273206204, -5.066266385256313e-05, -0.0002795067266561091, -4.172238186583854e-05, -0.00248873233795166, -0.0015168600948527455, -2.8609820219571702e-05, -3.576278118089249e-07, -0.014512460678815842, -4.0531076592742465e-06, -2.9802276912960224e-06, -0.10022900998592377, -2.264974000354414e-06, -9.440929716220126e-05, -0.004087665118277073, -1.1920922133867862e-06, -9.179073458653875e-06, 0.0, -1.1920928244535389e-07, -1.7523612768854946e-05, -2.3841855067985307e-07, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -4.768370445162873e-07, -6.9141146923357155e-06, -1.6689286894688848e-06, 0