    res = 1\n    base %= MOD\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return res\n\ndef f(e, o, s, t, dp):\n    if s in dp[t]:\n        return dp[t][s]\n    \n    if s == 1:\n        dp[t][s] = e if t == 0 else o\n        return dp[t][s]\n    \n    if s % 2 == 1:\n        res = (e * f(e, o, s - 1, t, dp) % MOD + \n               o * f(e, o, s - 1, 1 - t, dp) % MOD) % MOD\n    else:\n        half = s // 2\n        c = f(e, o, half, 0, dp)\n        nc = f(e, o, half, 1, dp)\n        if t == 0:\n            res = (c * c % MOD + nc * nc % MOD) % MOD\n        else:\n            res = (2 * c % MOD * nc % MOD) % MOD\n    \n    dp[t][s] = res\n    return res\n\ndef main():\n    fs = FastScanner()\n    n = fs.nextLong()\n    m = fs.nextLong()\n    p = fs.nextLong()\n    q = fs.nextLong()\n    \n    len_val = q - p + 1\n    odd = (len_val + 1) // 2 if p % 2 == 1 else len_val // 2\n    even = len_val - odd\n    \n    dp = [defaultdict(int) for _ in range(2)]\n    \n    if ((n & m) % 2 == 0):\n        ans = f(even, odd, n * m, 0, dp)\n        print(ans)\n    else:\n        ans = pow_func(even + odd, n * m)\n        print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.3774932641536e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -0.008528360165655613, -0.006011382210999727, -0.0010334871476516128, -0.05588802322745323, -0.0014971011551097035, -2.3841855067985307e-07, -0.00020716428116429597, -0.0021906918846070766, -8.999896090244874e-05, 0.0, -4.768370445162873e-07, 0.0, -7.152555099310121e-07, -2.0265558760002023e-06, -1.2516897186287679e-05, -0.0001037067049765028, -1.4781842764932662e-05, -3.4927710657939315e-05, -3.3378546504536644e-06, -1.2993727978027891e-05, -5.8530047681415454e-05, -0.38690638542175293, -2.074220174108632e-05, -8.821448318485636e-06, -2.7418097943154862e-06, -0.0001172950