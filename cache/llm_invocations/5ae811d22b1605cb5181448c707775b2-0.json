i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef enc(x, y, t, n, m):\n    return x + y * n + t * n * n + 2\n\ndef aug(s, t, cap, n, m, vn, edge):\n    result = 0\n    while True:\n        from_node = [-1] * vn\n        flow = [0] * vn\n        from_node[s] = s\n        flow[s] = cap\n        q = deque()\n        q.append(s)\n        found = False\n        while q:\n            x = q.popleft()\n            if x == t:\n                # augment\n                aug_flow = flow[t]\n                cur = t\n                while cur != s:\n                    prev = from_node[cur]\n                    edge[prev][cur] -= aug_flow\n                    if cur not in edge:\n                        edge[cur] = {}\n                    edge[cur][prev] = edge[cur].get(prev, 0) + aug_flow\n                    cur = prev\n                result += aug_flow\n                found = True\n                break\n            for nxt, cap_edge in edge[x].items():\n                if cap_edge >= cap and from_node[nxt] == -1:\n                    from_node[nxt] = x\n                    flow[nxt] = min(cap_edge, flow[x])\n                    q.append(nxt)\n        if not found:\n            break\n    return result\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    # first grid\n    buf = [[''] * n for _ in range(n)]\n    for i in range(n):\n        row = next(it)\n        for j in range(n):\n            buf[i][j] = row[j]\n    # second grid\n    buf2 = [[''] * n for _ in range(n)]\n    for i in range(n):\n        row = next(it)\n        for j in range(n):\n            buf2[i][j] = row[j]\n\n    # Build initial edges from source (0) to enc(i,j,0) for digits in first grid\n    edge = [{} for _ in range(7000)]  # enough size\n    for i in range(n):\n        for j in range(n):\n            if '0' < buf[i][j] <= '9':\n                node = enc(i, j, 0, n, m)\n                edge[0][node] = edge[0].get(node, 0) + (ord(buf[i][j]) - ord('0'))\n\n    # Now buf2 is used for the rest\n    buf = buf2  # rename for clarity\n\n    dx = [-1, 0, 1, 0]\n    dy = [0, -1, 0, 1]\n\n    # BFS to compute tox (distance to nearest 'Z')\n    tox = [[m+1] * n for _ in range(n)]\n    bfs_q = deque()\n    for i in range(n):\n        for j in range(n):\n            if buf[i][j] == 'Z':\n                tox[i][j] = 0\n                bfs_q.append((i, j))\n\n    while bfs_q:\n        i, j = bfs_q.popleft()\n        t = tox[i][j]\n        for d in range(4):\n            x = i + dx[d]\n            y = j + dy[d]\n            if 0 <= x < n and 0 <= y < n and buf[x][y] != 'Y' and t + 1 < tox[x][y]:\n                tox[x][y] = t + 1\n                bfs_q.append((x, y))\n\n    vn = enc(n-1, n-1, m, n, m) + 1\n\n    # Build edges for time steps\n    for i in range(n):\n        for j in range(n):\n            for t in range(m):\n                # edges to neighbors\n                for d in range(4):\n                    x = i + dx[d]\n                    y = j + dy[d]\n                    if 0 <= x < n and 0 <= y < n and buf[x][y] != 'Y':\n                        # condition: t+1 < tox[x][y] + (1 if buf[x][y] is digit else 0)\n                        extra = 1 if '0' < buf[x][y] <= '9' else 0\n                        if t + 1 < tox[x][y] + extra and t < tox[i][j]:\n                            u = enc(i, j, t, n, m)\n                            v = enc(x, y, t+1, n, m)\n                            edge[u][v] = edge[u].get(v, 0) + 1000\n                # edges to final time if digit\n                if '0' < buf[i][j] <= '9':\n                    u = enc(i, j, t, n, m)\n                    v = enc(i, j, m, n, m)\n                    edge[u][v] = edge[u].get(v, 0) + (ord(buf[i][j]) - ord('0'))\n            # edge from final time to sink\n            if '0' < buf[i][j] <= '9':\n                u = enc(i, j, m, n, m)\n                edge[u][1] = edge[u].get(1, 0) + (ord(buf[i][j]) - ord('0'))\n\n    res = 0\n    u = 8\n    while u:\n        res += aug(0, 1, u, n, m, vn, edge)\n        u //= 2\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.60137271147687e-05, 0.0, 0.0, -0.00018869050836656243, -0.00039641151670366526, -3.576278118089249e-07, -0.0009196343016810715, -1.764281842042692e-05, -8.344646857949556e-07, 0.0, -5.9126061387360096e-05, -0.0007164295529946685