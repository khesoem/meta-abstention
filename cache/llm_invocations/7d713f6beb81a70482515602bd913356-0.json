al_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final double INF = 1e9;\n\n    static double myabs(double n) {\n        return n < 0 ? -n : n;\n    }\n\n    static int solve_it(int x, int y, int b) {\n        double target = (double) x / y;\n        int lb = 0, ub = 1000000;\n        for (int i = 0; i < 25; i++) {\n            int a = (lb + ub) >> 1;\n            if ((double) a / b < target) {\n                lb = a;\n            } else {\n                ub = a;\n            }\n        }\n        int res = 0;\n        double diff = Double.MAX_VALUE;\n        for (int a = lb - 10; a <= ub + 10; a++) {\n            double d = myabs((double) a / b - target);\n            if (d < diff) {\n                diff = d;\n                res = a;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int x = scanner.nextInt();\n        int y = scanner.nextInt();\n        int n = scanner.nextInt();\n        int ans1 = 0, ans2 = 0;\n        double best_diff = Double.MAX_VALUE;\n        for (int b = 1; b <= n; b++) {\n            int a = solve_it(x, y, b);\n            double d = myabs((double) a / b - (double) x / y);\n            if (d < best_diff) {\n                best_diff = d;\n                ans1 = a;\n                ans2 = b;\n            }\n        }\n        System.out.println(ans1 + \"/\" + ans2);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014482879487331957, -2.264974000354414e-06, -4.768370445162873e-07, -0.00041869457345455885, -5.960446742392378e-06, -0.029787791892886162, -0.11008775979280472, -3.075552376685664e-05, -4.768370445162873e-07, -3.015949550899677e-05, -0.009757207706570625, -0.002805704018101096, -0.20601610839366913, -0.002198780421167