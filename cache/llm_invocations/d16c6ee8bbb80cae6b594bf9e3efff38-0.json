{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <cmath>\n\nusing namespace std;\n\nint gcd (int x, int y)\n{\n    int gcd;\n    if (x > y)\n        gcd = x;\n    else\n        gcd = y;\n\n    while (true)\n    {\n        if (x%gcd == 0 && y%gcd == 0)\n            break;\n        gcd--;\n    }\n    return gcd;\n}\n\nvoid diff (double x, double y, double a, double b, double &num, double &den)\n{\n    num = x*b - y*a;\n    num = fabs (num);\n    den = y*b;  \n}\n\n\nint main()\n{\n    double x,y,n,a,b;\n    double min;\n    int mina, minb;\n    min = 1000000;\n\n    cin>>x>>y>>n;\n\n    if (n > y){\n        int gc = gcd (x, y);\n        if (gc != 1){       \n            x = x/gc;\n            y = y/gc;\n        }\n        cout<<x<<\"/\"<<y<<endl;\n        return 0;\n    }\n\n    for (b = n; b >= 1; b--)\n    {\n        a = (x*b)/y;\n        if (floor(a) == a){\n            mina = a;\n            minb = b;\n            break;\n        }\n        else{\n            double temp, tempa, tempb;\n            diff(x,y,floor(a),b,tempa,tempb);\n            temp = tempa/tempb;\n\n            if(temp < min){\n                mina = floor(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(floor(a) < mina){\n                    mina = floor(a);\n                    minb = b;                   \n                }\n            }\n            \n            diff(x,y,ceil(a),b,tempa,tempb);        \n            temp = tempa/tempb;\n\n            if(temp < min){\n                mina = ceil(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(ceil(a) < mina){\n                    mina = ceil(a);\n                    minb = b;                   \n                }\n            }\n        }\n    }\n\n    int gc = gcd (mina, minb);\n    if (gc != 1){       \n        mina = mina/gc;\n        minb = minb/gc;\n    }\n\n    cout<<mina<<\"/\"<<minb<<endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef gcd(x, y):\n    # C++ version: decrement from max until both divisible\n    # Use math.gcd for simplicity, but ensure ints\n    return math.gcd(x, y)\n\ndef diff(x, y, a, b):\n    # returns numerator and denominator of absolute difference\n    num = abs(x * b - y * a)\n    den = y * b\n    return num, den\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x = float(data[0])\n    y = float(data[1])\n    n = float(data[2])\n\n    min_val = float('inf')\n    mina = 0\n    minb = 0\n\n    if n >= y:\n        # simplify x/y\n        g = gcd(int(x), int(y))\n        if g != 1:\n            x = int(x) // g\n            y = int(y) // g\n        else:\n            x = int(x)\n            y = int(y)\n        print(f\"{x}/{y}\")\n        return\n\n    # iterate b from n down to 1\n    for b in range(int(n), 0, -1):\n        a = (x * b) / y\n        if a == int(a):  # exact integer\n            mina = int(a)\n            minb = b\n            break\n        else:\n            # floor candidate\n            floor_a = int(math.floor(a))\n            num, den = diff(x, y, floor_a, b)\n            temp = num / den\n            if temp < min_val:\n                min_val = temp\n                mina = floor_a\n                minb = b\n            elif temp == min_val:\n                if floor_a < mina:\n                    mina = floor_a\n                    minb = b\n\n            # ceil candidate\n            ceil_a = int(math.ceil(a))\n            num, den = diff(x, y, ceil_a, b)\n            temp = num / den\n            if temp < min_val:\n                min_val = temp\n                mina = ceil_a\n                minb = b\n            elif temp == min_val:\n                if ceil_a < mina:\n                    mina = ceil_a\n                    minb = b\n\n    # simplify the best fraction\n    g = gcd(mina, minb)\n    if g != 1:\n        mina //= g\n        minb //= g\n\n    print(f\"{mina}/{minb}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.894321920000948e-06, 0.0, 0.0, -0.00016223068814724684, -7.974783511599526e-05, -0.2014133334159851, -0.0015093612018972635, -3.540453326422721e-05, 0.0, -0.0002643712505232543, -7.617183291586116e-05, -0.1288861483335495, -0.07239123433828354, -0.008959685452282429, 0.0, -7.760223525110632e-05, -1.0728830375228426e-06, -0.07558304071426392, -2.116769552230835, -4.9232225137529895e-05, -0.26311203837394714, -0.28597888350486755, -0.5771602392196655, -0.0025000290479511023, -0.0037216939963400364, -1.6212332411669195e-05, -0.5434565544128418, -0.11105527728796005, -0.0021394239738583565, -0.1214948296546936, 0.0, -0.14161282777786255, -0.4293379485607147, -0.007676742970943451, -1.1920928244535389e-07, 0.0, -0.0985855758190155, -0.9164671301841736, -0.7553462386131287, -0.0136728640