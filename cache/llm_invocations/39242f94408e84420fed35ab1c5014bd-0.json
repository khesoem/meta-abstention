s)\n        self.adj[a].append(len(self.edges))\n        self.edges.append([b, 0, cap, cost, cost])\n        self.adj[b].append(len(self.edges))\n        self.edges.append([a, 0, 0, -cost, -cost])\n        return result\n    \n    def djk(self) -> Tuple[int, int]:\n        INF = 10**18\n        states = [{'dist': INF, 'prev': -1, 'maxf': 0} for _ in range(self.n)]\n        states[self.source] = {'dist': 0, 'prev': -2, 'maxf': 10**18}\n        pq = [(states[self.source]['dist'], self.source)]\n        \n        while pq:\n            d, v = heapq.heappop(pq)\n            if d != states[v]['dist']:\n                continue\n            for edid in self.adj[v]:\n                u, flow, cap, cost, _ = self.edges[edid]\n                if flow < cap and states[u]['dist'] > states[v]['dist'] + cost:\n                    states[u]['dist'] = states[v]['dist'] + cost\n                    states[u]['prev'] = edid\n                    states[u]['maxf'] = min(states[v]['maxf'], cap - flow)\n                    heapq.heappush(pq, (states[u]['dist'], u))\n        \n        lastid = states[self.sink]['prev']\n        extraflow = states[self.sink]['maxf']\n        atcost = 0\n        \n        if lastid == -1:\n            return (0, 0)\n        \n        id_ = lastid\n        while id_ != -2:\n            e = self.edges[id_]\n            self.edges[id_][1] += extraflow\n            self.edges[id_ ^ 1][1] -= extraflow\n            atcost += e[4]  # origcost\n            id_ = states[self.edges[id_ ^ 1][0]]['prev']\n        \n        for id_ in range(len(self.edges)):\n            v = self.edges[id_ ^ 1][0]\n            u = self.edges[id_][0]\n            if states[v]['prev'] != -1 and states[u]['prev'] != -1:\n                self.edges[id_][3] += states[v]['dist'] - states[u]['dist']\n        \n        return (extraflow, atcost)\n    \n    def mfmc(self) -> Tuple[int, int]:\n        flow = 0\n        cost = 0\n        \n        if any(e[1] > 0 and e[3] < 0 for e in self.edges):\n            self.bellamanford()\n        \n        while True:\n            extraflow, atcost = self.djk()\n            if extraflow <= 0:\n                break\n            flow += extraflow\n            cost += extraflow * atcost\n        \n        return (flow, cost)\n    \n    def bellamanford(self):\n        INF = 10**18\n        dist = [INF] * self.n\n        dist[self.source] = 0\n        \n        for rep in range(self.n):\n            changed = False\n            for id_ in range(len(self.edges)):\n                v = self.edges[id_ ^ 1][0]\n                u = self.edges[id_][0]\n                if self.edges[id_][1] < self.edges[id_][2] and dist[v] != INF and dist[u] > dist[v] + self.edges[id_][3]:\n                    dist[u] = dist[v] + self.edges[id_][3]\n                    changed = True\n            if not changed:\n                break\n        \n        for id_ in range(len(self.edges)):\n            v = self.edges[id_ ^ 1][0]\n            u = self.edges[id_][0]\n            if dist[v] < INF and dist[u] < INF:\n                self.edges[id_][3] += dist[v] - dist[u]\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    a = [int(next(it)) for _ in range(k)]\n    \n    e = [[] for _ in range(n + 1)]\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        e[x].append(y)\n        e[y].append(x)\n    \n    max_time = 120\n    nd = 0\n    to = [[0] * (n + 1) for _ in range(max_time)]\n    for i in range(max_time):\n        for j in range(1, n + 1):\n            to[i][j] = nd\n            nd += 1\n    \n    S = nd\n    nd += 1\n    T = nd\n    nd += 1\n    \n    flow = SSP(nd, S, T)\n    \n    for i in range(k):\n        flow.add_edge(S, to[0][a[i]], 1, 0)\n    \n    for i in range(max_time):\n        flow.add_edge(to[i