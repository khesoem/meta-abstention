ge_id;\n    }\n\n    static void add(int u, int v, int val, int w) {\n        addEdge(u, v, val, w);\n        addEdge(v, u, 0, -w);\n    }\n\n    static boolean SPFA() {\n        Arrays.fill(dis, 1, tot + 1, inf);\n        Queue<Integer> q = new LinkedList<>();\n        q.add(0);\n        dis[0] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != 0; i = e[i].next) {\n                int v = e[i].to;\n                if (e[i].val != 0 && dis[v] > dis[u] + e[i].w) {\n                    dis[v] = dis[u] + e[i].w;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return dis[tot] < inf;\n    }\n\n    static CF mcmf() {\n        CF res = new CF();\n        while (SPFA()) {\n            int flow = inf;\n            for (int x = tot; x != 0; x = e[pre[x] ^ 1].to) {\n                flow = Math.min(flow, e[pre[x]].val);\n            }\n            for (int x = tot; x != 0; x = e[pre[x] ^ 1].to) {\n                e[pre[x]].val -= flow;\n                e[pre[x] ^ 1].val += flow;\n            }\n            res.flow += flow;\n            res.cost += dis[tot] * flow;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        int cs = 2 * k;\n        tot = cs * n;\n        int s = tot + 1;\n        int t = tot + 2;\n        int[][] E = new int[m + 1][2];\n        int tp;\n        for (int i = 1; i <= k; i++) {\n            st = new StringTokenizer(br.readLine());\n            tp = Integer.parseInt(st.nextToken());\n            add(0, P(0, tp), 1, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            E[i][0] = Integer.parseInt(st.nextToken());\n            E[i][1] = Integer.parseInt(st.nextToken());\n        }\n        for (int i = 1; i <= cs - 1; i++) {\n            add(P(i, 1), t, k, c * i);\n            for (int j = 1; j <= n; j++) {\n                add(P(i - 1, j), P(i, j), k, 0);\n            }\n            for (int j = 1; j <= m; j++) {\n                for (int t = 1; t <= k; t++) {\n                    add(P(i - 1, E[j][0]), P(i, E[j][1]), 1, (2 * t - 1) * d);\n                    add(P(i - 1, E[j][1]), P(i, E[j][0]), 1, (2 * t - 1) * d);\n                }\n            }\n        }\n        System.out.println(mcmf().cost);\n    }\n\n    static int P(int i, int j) {\n        return (i) * n + (j);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.18429972231388092, -0.010016911663115025, -0.05034002289175987, -0.029782678931951523, -0.00017722031043376774, -0.3872995376586914, -0.7688663005828857, -0.0005018778028897941, -1.2159421203250531e-05, -0.0030895464587956667, -0.13735222816467285, -0.08177796006202698, -1.0967314665322192e-05, -0.02474641427397728, -0.18130142986774445, -0.2433691769838333, -0.1683412343263626, -0.7380744814872742, -0.5468988418579102, -0.042180247604846954, -0.0020514894276857376, -0.010907314717769623, -0.1319582462310791, -0.0064461724832654, -0.22377562522888184, -0.004543597344309092, -0.08297558128833771, -0.0014315355801954865, -0.05795831233263016, -0.11059931665658951, -0.11296246200799942, -0.632942795753479, -7.975419430295005e-05, -0.019551202654838562, -0.9485183954238892, -1.2534414529800415, -0.0031285297591239214, -0.00019808585057035089, -0.14616861939430237, -1.175369143486023, -0