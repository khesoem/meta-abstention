{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = (ll)1e18;\nconst int MAXN = 1000007;\n\nstruct Edge {\n    int to, cap, flow, cost;\n    Edge() {}\n    Edge(int to, int cap, int flow, int cost)\n        : to(to), cap(cap), flow(flow), cost(cost) {}\n};\n\nvector<Edge> edges;\nvector<int> adj[MAXN];\nll dist[MAXN];\nint prv[MAXN], usedEdge[MAXN], inQueue[MAXN];\nint S = MAXN - 2;\nint T = MAXN - 1;\nint L = 101;\nll totalCost = 0;\n\nint residual(int id) {\n    return edges[id].cap - edges[id].flow;\n}\n\nvoid addEdge(int u, int v, int capacity, int cost) {\n    adj[u].push_back((int)edges.size());\n    edges.push_back(Edge(v, capacity, 0, cost));\n    adj[v].push_back((int)edges.size());\n    edges.push_back(Edge(u, 0, 0, cost));\n}\n\nvoid shortestPaths() {\n    for (int i = 0; i < MAXN; ++i) {\n        dist[i] = INF;\n        prv[i] = -1;\n        usedEdge[i] = -1;\n        inQueue[i] = 0;\n    }\n    queue<int> q;\n    dist[S] = 0;\n    q.push(S);\n    inQueue[S] = 1;\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inQueue[u] = 0;\n        for (int id : adj[u]) {\n            if (residual(id) == 0) continue;\n            int v = edges[id].to;\n            if (dist[v] > dist[u] + edges[id].cost) {\n                dist[v] = dist[u] + edges[id].cost;\n                prv[v] = u;\n                usedEdge[v] = id;\n                if (!inQueue[v]) {\n                    inQueue[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n}\n\nvoid pushOneUnit() {\n    shortestPaths();\n    int cur = T;\n    while (cur != S) {\n        edges[usedEdge[cur]].flow++;\n        edges[usedEdge[cur] ^ 1].flow--;\n        cur = prv[cur];\n    }\n    totalCost += dist[T];\n}\n\nint n, m, k, c, d;\n\nvoid readAndBuild() {\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        --x;\n        addEdge(S, x, 1, 0);\n    }\n    for (int t = 0; t < L; ++t) {\n        addEdge(t * n, T, k, t * c);\n    }\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        scanf(\"%d %d\", &x, &y);\n        --x; --y;\n        for (int t = 0; t < L - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n        for (int t = 0; t < L - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n}\n\nvoid solve() {\n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < L - 1; ++t) {\n            addEdge(i + t * n, i + t * n + n, k, 0);\n        }\n    }\n    for (int i = 0; i < k; ++i) {\n        pushOneUnit();\n    }\n    printf(\"%lld\\n\", totalCost);\n}\n\nint main() {\n    readAndBuild();\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    L = 101\n    nodes = n * L + 2\n    S = nodes - 2\n    T = nodes - 1\n\n    edges = []  # each edge: [to, cap, flow, cost]\n    adj = [[] for _ in range(nodes)]\n\n    INF = 10**18\n    dist = [0] * nodes\n    prv = [0] * nodes\n    usedEdge = [0] * nodes\n    inQueue = [0] * nodes\n    totalCost = 0\n\n    def residual(eid):\n        return edges[eid][1] - edges[eid][2]\n\n    def addEdge(u, v, capacity, cost):\n        adj[u].append(len(edges))\n        edges.append([v, capacity, 0, cost])\n        adj[v].append(len(edges))\n        edges.append([u, 0, 0, cost])  # reverse edge with same cost (as in original)\n\n    # read starting positions\n    for _ in range(k):\n        x = next(it) - 1\n        addEdge(S, x, 1, 0)\n\n    # sink edges from city 0 at each time\n    for t in range(L):\n        addEdge(t * n, T, k, t * c)\n\n    # read edges between cities\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        for t in range(L - 1):\n            for j in range(k):\n                addEdge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1))\n        for t in range(L - 1):\n            for j in range(k):\n                addEdge(y + t * n, x + t * n + n, 1, d * (j * 2 + 1))\n\n    # stay edges\n    for i in range(n):\n        for t in range(L - 1):\n            addEdge(i + t * n, i + t * n + n, k, 0)\n\n    def shortestPaths():\n        for i in range(nodes):\n            dist[i] = INF\n            prv[i] = -1\n            usedEdge[i] = -1\n            inQueue[i] = 0\n        q = deque()\n        dist[S] = 0\n        q.append(S)\n        inQueue[S] = 1\n        while q:\n            u = q.popleft()\n            inQueue[u] = 0\n            for eid in adj[u]:\n                if residual(eid) == 0:\n                    continue\n                v = edges[eid][0]\n                if dist[v] > dist[u] + edges[eid][3]:\n                    dist[v] = dist[u] + edges[eid][3]\n                    prv[v] = u\n                    usedEdge[v] = eid\n                    if not inQueue[v]:\n                        inQueue[v] = 1\n                        q.append(v)\n\n    def pushOneUnit():\n        nonlocal totalCost\n        shortestPaths()\n        cur = T\n        while cur != S:\n            eid = usedEdge[cur]\n            edges[eid][2] += 1\n            edges[eid ^ 1][2] -= 1\n            cur = prv[cur]\n        totalCost += dist[T]\n\n    for _ in range(k):\n        pushOneUnit()\n\n    print(totalCost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.683499380713329e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0004589696181938052, -0.0025222653057426214, -1.1920928244535389e-07, -0.00013195598148740828, -0.00047255316167138517, -4.768370445162873e-07, -1.1920928244535389e-07, -2.145764938177308e-06, -0.0003398079425096512, -0.7043635249137878, -0.18480432033538818, -0.06482865661382675, -3.576272320060525e-06, -0.01817302219569683, -1.1920928244535389e-07, -0.2520030736923218, -1.7881377516459906e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.00016127715934999287, 0.0, -0.006715585943311453, -3.3378546504536644e-06, -5.8530047681415454e-05, -0.31544286012649536, -1.1920928244535389e-07, -0.0004306104383431375, 0.0, -0.0003090619284193963, -0.0009116546134464443, -3.8980677345534787e-05, -0.00015889335190877318, -4.172238186583854e-05, 0.0, -0.4741317629814148, 0.0, -1.1920928244535389e-07, -0.00025507534155622125, 0.0, -1.1920928244535389e-07, -2.9802276912960224e-06, 0.0, -5.876845170860179e-05, -0.0035311745014041662, 0.0, -1.1920928244535389e-07, -4.887569048150908e-06, -1.1920928244535389e-07, -0.0002739054325502366, -0.0010882653295993805, 0.0, 0.0, -1.4066597032069694e-05, -1.1920928244535