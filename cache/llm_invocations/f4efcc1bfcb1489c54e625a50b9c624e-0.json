ent % MOD1 + MOD1) % MOD1);\n    total = (total + vals[depth].back()) % MOD1;\n    counter1++;\n    for (ll digit = 0; digit <= 9; ++digit)\n        dfs1(depth + 1, current * 10 + digit);\n}\n\nvoid dfs2(ll depth, ll current) {\n    if (current > n) return;\n    if (is_valid(current)) {\n        for (ll d = 0; d <= 6; ++d) {\n            ll needed = ((counter2 + 1 - current * powers[d]) % MOD1 + MOD1) % MOD1;\n            auto it = lower_bound(vals[d].begin(), vals[d].end(), needed);\n            ll idx = it - vals[d].begin();\n            ll contrib = (total + needed * (ll)vals[d].size() - MOD1 * (ll)(vals[d].size() - idx)) % MOD2;\n            total = (total + contrib) % MOD2;\n        }\n        counter2 += counter1;\n    } else {\n        counter2++;\n        total = (total + ((counter2 - current) % MOD1 + MOD1) % MOD2) % MOD2;\n        for (ll digit = (depth == 0); digit <= 9; ++digit)\n            dfs2(depth + 1, current * 10 + digit);\n    }\n}\n\nint main() {\n    n = read();\n    dfs1(0, 0);\n    for (ll i = 0; i <= 6; ++i) sort(vals[i].begin(), vals[i].end());\n    counter2 = -1;\n    dfs2(0, 0);\n    writeln((total % MOD2 + MOD2) % MOD2);\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nsys.setrecursionlimit(1000000)\n\nMOD1 = 998244353\nMOD2 = 1000000007\n\n# Fast input/output\ndef gc():\n    return sys.stdin.read(1)\n\ndef read():\n    pos = 1\n    num = 0\n    ch = gc()\n    while ch and not ch.isdigit():\n        if ch == '-':\n            pos = -1\n        ch = gc()\n    while ch and ch.isdigit():\n        num = num * 10 + (ord(ch) - ord('0'))\n        ch = gc()\n    return pos * num\n\ndef write(x):\n    if x < 0:\n        sys.stdout.write('-')\n        write(-x)\n        return\n    if x >= 10:\n        write(x // 10)\n    sys.stdout.write(chr(x % 10 + ord('0')))\n\ndef writeln(x):\n    write(x)\n    sys.