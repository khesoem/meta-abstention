d(c) - ord('a')] += 1\n    for cnt in f:\n        if cnt > n // 2:\n            print(-1)\n            return\n\n    # Swap pairs based on a values\n    for i in range(n // 2):\n        if a[i] > a[n - 1 - i]:\n            a[i], a[n - 1 - i] = a[n - 1 - i], a[i]\n            s[i], s[n - 1 - i] = s[n - 1 - i], s[i]\n\n    # Build graph\n    src = n\n    sink = n + 1\n    edges = []\n    for i in range(n // 2):\n        edges.append(Edge(src, i, 1, 0))\n        edges.append(Edge(n - 1 - i, sink, 1, 0))\n        for j in range(n // 2):\n            if s[i] != s[n - 1 - j]:\n                cost = 0 if i == j else a[i]\n                edges.append(Edge(i, n - 1 - j, 1, cost))\n\n    g = compileWD(sink + 1, edges)\n    total = sum(a)\n    mincost = solveMinCostFlow(g, src, sink, n)\n    print(total - mincost)\n\nif __name__ == '__main__':\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.145764938177308e-06, 0.0, 0.0, -0.0004894727608188987, -0.001190549461171031, 0.0, -0.01816518045961857, -0.008634612895548344, -0.0001250427303602919, -1.1920928244535389e-07, -4.768370445162873e-07, -0.16022725403308868, 0.0, 0.0, -7.152555099310121e-07, -4.768370445162873e-07, -0.02060951665043831, -0.0008837846689857543, -0.2626742124557495, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, 0.0, -0.0001255195093108341, -3.576278118089249e-07, 0.0, -2.7656173188006505e-05, -1.1920928244535389e-07, 0.0, 0.0, -7.271740287251305e-06, -1.9073468138230965e-06, -3.576278118089249e-07, 0.0, -1.1801649634435307e-05, -6.318072337307967e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.33385443687438965, -0.2543817460536957, 0.0, -0.038042102009058, -0.0003357561945449561, -2.729855441430118e-05, 0.0, -0.0003369478799868375, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.3132794201374054, 0.0, -6.627816765103489e-05, 0.0, 0.0, -1.19