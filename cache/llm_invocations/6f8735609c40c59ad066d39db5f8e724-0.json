 out.println((total * factor) % MOD);\n        out.close();\n    }\n    \n    private static long nChooseK(int n, int k) {\n        long denom = (factorial[k] * factorial[n - k]) % MOD;\n        long invDenom = fastPow(denom, MOD - 2, MOD);\n        return (factorial[n] * invDenom) % MOD;\n    }\n    \n    private static long fastPow(long base, long exp, long modulus) {\n        if (exp < 0) return 0L;\n        long result = 1;\n        base %= modulus;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % modulus;\n            }\n            base = (base * base) % modulus;\n            exp >>= 1;\n        }\n        return result;\n    }\n    \n    static class InputReader {\n        BufferedReader reader;\n        StringTokenizer tokenizer;\n        \n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream));\n        }\n        \n        public String next() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n        \n        public int readInt() {\n            return Integer.parseInt(next());\n        }\n        \n        public long readLong() {\n            return Long.parseLong(next());\n        }\n        \n        public double readDouble() {\n            return Double.parseDouble(next());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nMOD = 998244353\n\ndef fast_pow(base, exp, modulus):\n    if exp < 0:\n        return 0\n    result = 1\n    base %= modulus\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % modulus\n        base = (base * base) % modulus\n        exp >>= 1\n    return result\n\ndef precompute_factorials(max_n):\n    factorial = [1] * (max_n + 1)\n    for i in range(1, max_n + 1):\n        factorial[i] = (i * factorial[i-1]) % MOD\n    return factorial\n\ndef n_choose_k(n, k, factorial):\n    if k < 0 or k > n:\n        return 0\n    denom = (factorial[k] * factorial[n - k]) % MOD\n    inv_denom = fast_pow(denom, MOD - 2, MOD)\n    return (factorial[n] * inv_denom) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    N = int(data[0])\n    K = int(data[1])\n    \n    if K >= N:\n        print(0)\n        return\n    \n    C = N - int(K)\n    \n    max_fact = 200000\n    factorial = precompute_factorials(max_fact)\n    \n    total = 0\n    parity = 1\n    for i in range(C, 0, -1):\n        term = (n_choose_k(C, i, factorial) * fast_pow(i, N, MOD)) % MOD\n        total = (total + parity * term + 2 * MOD) % MOD\n        parity = -parity\n    \n    if C == N:\n        factor = 1\n    else:\n        factor = (2 * n_choose_k(N, C, factorial)) % MOD\n    \n    result = (total * factor) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.55629628454335e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -0.0002618685248307884, -0.002889032242819667, -0.002806179691106081, -0.0027305721305310726, -0.004279503133147955, -0.001929566147737205, -0.0001998939987970516, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -2.9802276912960224e-06, -7.986990567587782e-06, -4.529942543740617e-06, -0.0003219324571546167, -3.4570634852570947e-06, -2.3841855067985307e-07, -0.4287048578262329, -0.03096064180135727, -0.304822713136673, -0.006884781178086996, -2.264974000354414e-06, -1.1920928244535389e-07, -1.823885577323381e-05, -9.536738616588991e