rue:\n                pushed = self.dfs(self.s, INF)\n                if not pushed:\n                    break\n                flow += pushed\n        return flow\n\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    deadline = int(next(it)) + 1\n    m = n\n\n    sci = [next(it) for _ in range(n)]\n    rea = [next(it) for _ in range(n)]\n\n    # compute danger (time when zombie reaches each cell)\n    danger = [[INF] * m for _ in range(n)]\n    q0 = deque()\n    for i in range(n):\n        for j in range(m):\n            if rea[i][j] == 'Z':\n                q0.append((i, j))\n                danger[i][j] = 1\n\n    while q0:\n        x, y = q0.popleft()\n        for da in (-1, 0, 1):\n            for db in (-1, 0, 1):\n                if abs(da) + abs(db) != 1:\n                    continue\n                nx, ny = x + da, y + db\n                if 0 <= nx < n and 0 <= ny < m and danger[nx][ny] == INF and sci[nx][ny] != 'Y':\n                    danger[nx][ny] = danger[x][y] + 1\n                    q0.append((nx, ny))\n\n    def cell_id(x, y):\n        return 1 + m * x + y\n\n    src = 0\n    sink = n * n + n * n + 1\n    dinic = Dinic(n * n * 2 + 2, src, sink)\n\n    # add edges from source to scientist cells and from reader cells to sink\n    for x in range(n):\n        for y in range(m):\n            if '1' <= sci[x][y] <= '9':\n                dinic.add_edge(src, cell_id(x, y), ord(sci[x][y]) - ord('0'))\n            if '1' <= rea[x][y] <= '9':\n                dinic.add_edge(n * n + cell_id(x, y), sink, ord(rea[x][y]) - ord('0'))\n\n    # add edges between scientist and reader cells if a safe path exists\n    for x in range(n):\n        for y in range(m):\n            if sci[x][y] == 'Y' or sci[x][y] == 'Z':\n                continue\n            for X in range(n):\n                for Y in range(m):\n                    if rea[X][Y] == 'Y' or rea[X][Y] == 'Z':\n                        continue\n           