in range(1, K + M + 3):\n            node_id[i][j] = node_count + 1\n            node_count += 1\n            if i == 1:\n                add_bidirectional(node_id[i][j], sink, INF, C * (j - 1))\n            if j > 1:\n                add_bidirectional(node_id[i][j - 1], node_id[i][j], INF, 0)\n        if cnt[i]:\n            add_bidirectional(src, node_id[i][1], cnt[i], 0)\n\n    for _ in range(M):\n        a = rd()\n        b = rd()\n        for j in range(1, K + M + 2):\n            for k in range(1, 2 * K, 2):\n                add_bidirectional(node_id[a][j], node_id[b][j + 1], 1, k * D)\n                add_bidirectional(node_id[b][j], node_id[a][j + 1], 1, k * D)\n\n    total_flow = 0\n    min_cost = 0\n\n    while spfa():\n        vis = [False] * (node_count + 1)\n        flow = dfs(src, INF, vis)\n        while flow:\n            total_flow += flow\n            min_cost += dist[sink] * flow\n            vis = [False] * (node_count + 1)\n            flow = dfs(src, INF, vis)\n\n    assert total_flow == K\n    print(min_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00017927470616996288, -8.344646857949556e-07, -3.576278118089249e-07, -0.0002714027068577707, -0.0002184867626056075, -1.1920922133867862e-06, -0.0017088347813114524, -0.00029118589009158313, -2.145764938177308e-06, -0.0006317288498394191, -0.010785382241010666, -0.2007480263710022, -0.579897940158844, -0.03394437953829765, -5.960462772236497e-07, -0.18961724638938904, -0.0345417857170105, -0.01825578324496746, -7.450303382938728e-05, -7.152555099310121e-07, -0.0011089849285781384, -0.007685142103582621, -5.8887653722194955e-05, -2.0265558760002023e-06, -6.23445157543756e-05, -0.0011512563796713948, -5.006777428206988e-06, -0.35876837372779846, -0.00011336160969221964, -0.2256339192390442, -2.8371408916427754e-05, -9.65590606938349e-06, -7.867782187531702e-06, -2.109982233378105e-05, -0.09352697432041168, -1.549719513