{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 300;\nconst int ROOM = -1;\nconst int REAC = -2;\nconst int BAD_REAC = -3;\nconst int CAPSULE = ROOM;\n\nint stationMap[MAXN][MAXN], capsuleNum[MAXN][MAXN];\nint poison[61][MAXN][MAXN];\nint dirX[4] = {-1, 0, 1, 0};\nint dirY[4] = {0, -1, 0, 1};\n\nstruct Point {\n    int x, y, amount;\n    Point(int a = 0, int b = 0, int c = 0) : x(a), y(b), amount(c) {}\n};\n\nvector<Point> people, capsules;\n\nint residualGraph[MAXN][MAXN];\n\nbool validCell(int x, int y, int n) {\n    return x >= 0 && x < n && y >= 0 && y < n && stationMap[x][y] == ROOM;\n}\n\nint getType(char c) {\n    if (c >= '0' && c <= '9') return ROOM;\n    if (c == 'Y') return REAC;\n    if (c == 'Z') return BAD_REAC;\n    return -1;\n}\n\nint getValue(char c) {\n    return c - '0';\n}\n\nvoid expandPoison(int x, int y, int T, int n) {\n    poison[0][x][y] = 1;\n    for (int t = 1; t <= T; ++t) {\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                if (poison[t - 1][i][j]) {\n                    poison[t][i][j] = 1;\n                    for (int d = 0; d < 4; ++d) {\n                        int nx = i + dirX[d];\n                        int ny = j + dirY[d];\n                        if (validCell(nx, ny, n)) poison[t][nx][ny] = 1;\n                    }\n                }\n            }\n        }\n    }\n}\n\nint shortestPath(const Point &from, const Point &to, int n, int limit) {\n    vector<bitset<MAXN>> visited(n);\n    queue<pair<int, Point>> q;\n    q.push({0, from});\n    visited[from.x][from.y] = 1;\n\n    while (!q.empty()) {\n        auto cur = q.front();\n        q.pop();\n\n        int t = cur.first;\n        Point p = cur.second;\n\n        if (p.x == to.x && p.y == to.y) return t;\n        if (t == limit) continue;\n        if (poison[t][p.x][p.y]) continue;\n\n        for (int d = 0; d < 4; ++d) {\n            Point nxt(p.x + dirX[d], p.y + dirY[d], 0);\n            if (validCell(nxt.x, nxt.y, n) && !visited[nxt.x][nxt.y] && !poison[t][nxt.x][nxt.y]) {\n                visited[nxt.x][nxt.y] = 1;\n                q.push({t + 1, nxt});\n            }\n        }\n    }\n\n    return 999;\n}\n\nlong long maxFlow(int s, int t) {\n    int parent[MAXN];\n    long long total = 0;\n\n    while (true) {\n        for (int i = 0; i < MAXN; ++i) parent[i] = -1;\n\n        queue<int> q;\n        q.push(s);\n        parent[s] = s;\n        bool found = false;\n\n        while (!q.empty() && !found) {\n            int u = q.front();\n            q.pop();\n\n            for (int v = 0; v < MAXN; ++v) {\n                if (parent[v] == -1 && residualGraph[u][v] > 0) {\n                    parent[v] = u;\n                    if (v == t) {\n                        found = true;\n                        break;\n                    }\n                    q.push(v);\n                }\n            }\n        }\n\n        if (!found) break;\n\n        int push = INT_MAX;\n        for (int v = t; v != s; v = parent[v]) {\n            push = min(push, residualGraph[parent[v]][v]);\n        }\n\n        for (int v = t; v != s; v = parent[v]) {\n            residualGraph[parent[v]][v] -= push;\n            residualGraph[v][parent[v]] += push;\n        }\n\n        total += push;\n    }\n\n    return total;\n}\n\nint main() {\n    int N, T;\n    scanf(\" %d %d\", &N, &T);\n\n    Point bad(0, 0, 0);\n    char ch;\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            scanf(\" %c\", &ch);\n            int type = getType(ch);\n            int val = getValue(ch);\n\n            stationMap[i][j] = type;\n            if (type == ROOM && val > 0) people.push_back(Point(i, j, val));\n            if (type == BAD_REAC) bad = Point(i, j, 0);\n        }\n    }\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            scanf(\" %c\", &ch);\n            int type = getType(ch);\n            int val = getValue(ch);\n\n            if (type == CAPSULE && val > 0) {\n                capsules.push_back(Point(i, j, val));\n                capsuleNum[i][j] = val;\n            }\n        }\n    }\n\n    int S = 0, SNK = MAXN - 1;\n\n    for (size_t i = 0; i < people.size(); ++i)\n        residualGraph[S][(int)i * 2 + 1] += people[i].amount;\n\n    for (size_t i = 0; i < capsules.size(); ++i)\n        residualGraph[(int)i * 2 + 2][SNK] += capsules[i].amount;\n\n    expandPoison(bad.x, bad.y, T, N);\n\n    for (size_t i = 0; i < people.size(); ++i) {\n        for (size_t j = 0; j < capsules.size(); ++j) {\n            int t = shortestPath(people[i], capsules[j], N, T);\n            if (t <= T) residualGraph[(int)i * 2 + 1][(int)j * 2 + 2] += 999;\n        }\n    }\n\n    printf(\"%lld\\n\", maxFlow(S, SNK));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 300\nROOM = -1\nREAC = -2\nBAD_REAC = -3\nCAPSULE = ROOM\n\ndirX = [-1, 0, 1, 0]\ndirY = [0, -1, 0, 1]\n\nclass Point:\n    def __init__(self, a=0, b=0, c=0):\n        self.x = a\n        self.y = b\n        self.amount = c\n\ndef validCell(x, y, n):\n    return 0 <= x < n and 0 <= y < n and stationMap[x][y] == ROOM\n\ndef getType(c):\n    if '0' <= c <= '9':\n        return ROOM\n    if c == 'Y':\n        return REAC\n    if c == 'Z':\n        return BAD_REAC\n    return -1\n\ndef getValue(c):\n    return ord(c) - ord('0')\n\ndef expandPoison(x, y, T, n):\n    poison[0][x][y] = 1\n    for t in range(1, T+1):\n        for i in range(n):\n            for j in range(n):\n                if poison[t-1][i][j]:\n                    poison[t][i][j] = 1\n                    for d in range(4):\n                        nx = i + dirX[d]\n                        ny = j + dirY[d]\n                        if validCell(nx, ny, n):\n                            poison[t][nx][ny] = 1\n\ndef shortestPath(from_, to, n, limit):\n    visited = [[False]*n for _ in range(n)]\n    q = deque()\n    q.append((0, from_))\n    visited[from_.x][from_.y] = True\n\n    while q:\n        t, p = q.popleft()\n        if p.x == to.x and p.y == to.y:\n            return t\n        if t == limit:\n            continue\n        if poison[t][p.x][p.y]:\n            continue\n        for d in range(4):\n            nx = p.x + dirX[d]\n            ny = p.y + dirY[d]\n            if validCell(nx, ny, n) and not visited[nx][ny] and not poison[t][nx][ny]:\n                visited[nx][ny] = True\n                q.append((t+1, Point(nx, ny, 0)))\n    return 999\n\ndef maxFlow(s, t):\n    parent = [-1]*MAXN\n    total = 0\n    while True:\n        for i in range(MAXN):\n            parent[i] = -1\n        q = deque()\n        q.append(s)\n        parent[s] = s\n        found = False\n        while q and not found:\n            u = q.popleft()\n            for v in range(MAXN):\n                if parent[v] == -1 and residualGraph[u][v] > 0:\n                    parent[v] = u\n                    if v == t:\n                        found = True\n                        break\n                    q.append(v)\n        if not found:\n            break\n        push = 10**9\n        v = t\n        while v != s:\n            push = min(push, residualGraph[parent[v]][v])\n            v = parent[v]\n        v = t\n        while v != s:\n            residualGraph[parent[v]][v] -= push\n            residualGraph[v][parent[v]] += push\n            v = parent[v]\n        total += push\n    return total\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    T = int(next(it))\n\n    global stationMap, capsuleNum, poison, people, capsules, residualGraph\n    stationMap = [[0]*N for _ in range(N)]\n    capsuleNum = [[0]*N for _ in range(N)]\n    poison = [[[0]*N for _ in range(N)] for _ in range(T+1)]\n    people = []\n    capsules = []\n\n    bad = Point(0,0,0)\n\n    for i in range(N):\n        line = next(it)\n        for j, ch in enumerate(line):\n            typ = getType(ch)\n            val = getValue(ch)\n            stationMap[i][j] = typ\n            if typ == ROOM and val > 0:\n                people.append(Point(i, j, val))\n            if typ == BAD_REAC:\n                bad = Point(i, j, 0)\n\n    for i in range(N):\n        line = next(it)\n        for j, ch in enumerate(line):\n            typ = getType(ch)\n            val = getValue(ch)\n            if typ == CAPSULE and val > 0:\n                capsules.append(Point(i, j, val))\n                capsuleNum[i][j] = val\n\n    S = 0\n    SNK = MAXN - 1\n    residualGraph = [[0]*MAXN for _ in range(MAXN)]\n\n    for i, p in enumerate(people):\n        residualGraph[S][i*2 + 1] += p.amount\n\n    for i, cap in enumerate(capsules):\n        residualGraph[i*2 + 2][SNK] += cap.amount\n\n    expandPoison(bad.x, bad.y, T, N)\n\n    for i, p in enumerate(people):\n        for j, cap in enumerate(capsules):\n            t = shortestPath(p, cap, N, T)\n            if t <= T:\n                residualGraph[i*2 + 1][j*2 + 2] += 999\n\n    print(maxFlow(S, SNK))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -4.8397800128441304e-05, -0.0002090712368953973, -4.6491513785440475e-06, 0.0, -1.8000440832111053e-05, -0.010586649179458618, -0.00010525626566959545, -3.2186455882765586e-06, -1.5020257706055418e-05, -2.3841855067985307e-07, -0.00024184639914892614, -0.00010632903286023065, -7.986990567587782e-06, -2.3841855067985307e-07, -3.802703940891661e-05, -2.145764938177308e-06, -3.6954811548639555e-06, -1.311301275563892e-06, -8.344646857949556e-07, -2.3841855067985307e-07, -5.960462772236497e-07, -3.814689989667386e-06, -1.5497195136049413e-06, -1.0013530300057027e-05, -1.680836794548668e-05, -1.4305104514278355e-06, 0.0, -4.768370445162873e-07, -3.2186455882765586e-06, -7.152555099310121e-07, -1.549708758830093e-05, -1.0728830375228426e-06, -2.3841855067985307e-07, -2.264974000354414e-06, -1.4305104514278355e-06, -2.8132995794294402e-05, -3.576278118089249e-07, -0.0027197536546736956, -0.3658992052078247, -0.0034393463283777237, 0.0, -0.0009141556802205741, 0.0, 0.0, -6.794698856538162e-05, -6.198863957251888e-06, -1.311301275563892e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -5.006777428206988e-06, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -2.7418097943154862e-06, -1.1324817933200393e-05, 0.0, -2.753696753643453e-05, -5.960462772236497e-07, -7.152555099310121e-07, -1.9073468138230965e-06, -2.861018856492592e-06, -2.264974000354414e-06, -2.264974000354414e-06, -8.344646857949556e-07, -0.00021860594279132783, -0.14693132042884827, -3.576278118089249e-07, -5.960462772236497e-07, -1.4305104514278355e-06, -0.0619717612862587, -1.7881377516459906e-06, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.5759