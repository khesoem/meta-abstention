n periods of time; and if yes, find the minimum number of flips he needs to cook the cutlet.\n</problem_description>\n\nHere is the Java 8 code you have to repair:\n<original_code>\nimport java.io.*;\nimport java.util.*;\nimport java.util.stream.*;\n\npublic class CF939_D2_F_V1 {\n    public static void main(String[] args) throws Throwable {\n        MyScanner sc = new MyScanner();\n        PrintWriter pw = new PrintWriter(System.out);\n\n        int n = sc.nextInt() * 2;\n        int k = sc.nextInt();\n        int[] l = new int[k + 1];\n        int[] r = new int[k + 1];\n        SparseTable[][] seg = new SparseTable[k + 1][2];\n\n        for (int i = 0; i < k; i++) {\n            l[i] = sc.nextInt();\n            r[i] = sc.nextInt();\n        }\n        l[k] = n;\n\n        for (int j = 0; j < 2; j++) {\n            int[] a = new int[n + 2];\n            Arrays.fill(a, INF);\n            a[n / 2] = 0;\n            seg[k][j] = new SparseTable(a);\n        }\n\n        for (int i = k - 1; i >= 0; i--) {\n            for (int j = 0; j < 2; j++) {\n                int[] a = new int[n + 2];\n                Arrays.fill(a, INF);\n                for (int c = 0; c <= l[i]; c++) {\n                    int best = seg[i + 1][j].query(c + l[i + 1] - l[i], c + l[i + 1] - l[i]);\n                    int alt = l[i + 1] - (c + r[i] - l[i]);\n                    int alt2 = l[i + 1] - c;\n                    best = Math.min(best, 1 + seg[i + 1][1 - j].query(alt, alt2));\n                    if (r[i] > l[i]) {\n                        best = Math.min(best, 2 + seg[i + 1][j].query(c + 1, c + r[i] - l[i]));\n                    }\n                    a[c] = best;\n                }\n                seg[i][j] = new SparseTable(a);\n            }\n        }\n\n        int ans = Math.min(seg[0][0].query(l[0], l[0]), seg[0][1].query(l[0], l[0]));\n        if (ans > 2 * k) {\n            pw.println(\"Hungry\");\n        } else {\n            pw.println(\"Full\");\n            pw.println(ans);\n        }\n        pw.flush();\n        pw.close();\n    }\n\n    static final int INF = (int) 1e7;\n\n    static class SparseTable {\n        int[] arr;\n        int[][] table;\n\n        SparseTable(int[] arr) {\n            int n = arr.length;\n            this.arr = arr;\n            int k = (int) Math.floor(Math.log(n) / Math.log(2)) + 1;\n            table = new int[n][k];\n            for (int i = 0; i < n; i++) {\n                table[i][0] = i;\n            }\n            for (int j = 1; (1 << j) <= n; j++) {\n                for (int i = 0; i + (1 << j) - 1 < n; i++) {\n                    int left = table[i][j - 1];\n                    int right = table[i + (1 << (j - 1))][j - 1];\n                    table[i][j] = arr[left] <= arr[right] ? left : right;\n                }\n            }\n        }\n\n        int query(int i, int j) {\n            int len = j - i + 1;\n            int k = (int) Math.floor(Math.log(len) / Math.log(2));\n            int p1 = table[i][k];\n            int p2 = table[j - (1 << k) + 1][k];\n            return Math.min(arr[p1], arr[p2]);\n        }\n    }\n\n    static class MyScanner {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public MyScanner() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        String nextLine() {\n            String str = \"\";\n            try {