urrent side having exactly n seconds\n                    if (dp[i + 1][side] < INF) {\n                        dp[i][side] = Math.min(dp[i][side], dp[i + 1][side]);\n                    }\n                }\n                \n                // Option 2: Flip once in this interval\n                for (int flipTime = l[i]; flipTime <= r[i] && flipTime <= 2 * n; flipTime++) {\n                    int timeBeforeFlip = flipTime - l[i];\n                    int timeAfterFlip = l[i + 1] - flipTime;\n                    \n                    if (timeBeforeFlip <= n && timeAfterFlip <= n) {\n                        int newSide = 1 - side;\n                        if (dp[i + 1][newSide] < INF) {\n                            dp[i][side] = Math.min(dp[i][side], 1 + dp[i + 1][newSide]);\n                        }\n                    }\n                }\n                \n                // Option 3: Flip twice in this interval (flip, then flip back)\n                for (int flip1 = l[i]; flip1 <= r[i] && flip1 <= 2 * n; flip1++) {\n                    for (int flip2 = flip1 + 1; flip2 <= r[i] && flip2 <= 2 * n; flip2++) {\n                        int timeBeforeFirst = flip1 - l[i];\n                        int timeBetween = flip2 - flip1;\n                        int timeAfterSecond = l[i + 1] - flip2;\n                        \n                        if (timeBeforeFirst <= n && timeBetween <= n && timeAfterSecond <= n) {\n                            if (dp[i + 1][side] < INF) {\n                                dp[i][side] = Math.min(dp[i][side], 2 + dp[i + 1][side]);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n        \n        int ans = dp[0][0];\n        if (ans >= INF / 2) {\n            pw.println(\"Hungry\");\n        } else {\n            pw.println(\"Full\");\n            pw.println(ans);\n        }\n        pw.flush();\n        pw.close();\n    }\n\n    static final int INF = (int) 1e9;\n\n    static class MyScanner {\n        BufferedReader br;\n        StringTokenizer st;\n\n        public MyScanner() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreElements()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        long nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n        String nextLine() {\n            String str = \"\";\n            try {\n                str = br.readLine();\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n            return str;\n        }\n    }\n}\n</repaired_code>\n<confidence>\n0.3\n</confidence>", "token_logprobs": [-5.960462772236497e-07, -9.83428253675811e-05, -3.6954811548639555e-06, -3.576278118089249e-07, -5.6265202147187665e-05, -1.549708758830093e-05, -2.264974000354414e-06, -7.748573807475623e-06, -5.936446541454643e-05, -2.062299427052494e-05, -3.576278118089249e-07, -0.0004325169720686972, -4.529942543740617e-06, -1.4662635294371285e-05, -0.0001463782973587513, -6.198863957251888e-06, -0.00034564718953333795, -7.629365427419543e-06, -5.960462772236497e-07, -0.015064637176692486, -5.960462772236497e-07, -2.861018856492592e-06, -1.4305104514278355e-06, -9.83428253675811e-05, -4.291525328881107e-06, -2.407998726994265e-05, -0.0017816636245697737, -0.0008074360666796565, -0.00011801023356383666, -3.576278118089249e-07, -0.002186290919780731, -3.576278118089249e-07, -4.529942543740617e-06, -3.3378546504536644e-06, -4.529942543740617e-06, -3.7431014789035544