{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\nusing i64 = long long;\n\nconst i64 MOD = 1000000007;\n\ni64 mod_pow(i64 b, i64 e, i64 m) {\n    i64 res = 1;\n    b %= m;\n    while (e) {\n        if (e & 1) res = (res * b) % m;\n        b = (b * b) % m;\n        e >>= 1;\n    }\n    return res;\n}\n\nstruct UnionFind {\n    vector<int> parent, rank;\n    UnionFind(int n) : parent(n), rank(n, 1) {\n        for (int i = 0; i < n; ++i) parent[i] = i;\n    }\n    int find(int x) {\n        if (parent[x] != x) parent[x] = find(parent[x]);\n        return parent[x];\n    }\n    void connect(int x, int y) {\n        x = find(x), y = find(y);\n        if (x == y) return;\n        if (rank[x] < rank[y]) swap(x, y);\n        parent[y] = x;\n        rank[x] += rank[y];\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, k;\n    cin >> n >> k;\n    \n    if (k == 0) {\n        cout << mod_pow(n, n - 1, MOD) << '\\n';\n        return 0;\n    }\n    \n    UnionFind uf(n);\n    for (int i = 0; i < n; ++i) {\n        uf.connect(i, (1LL * i * k) % n);\n    }\n    \n    i64 answer = 1;\n    for (int i = 0; i < n; ++i) {\n        if (uf.find(i) != i) continue;\n        i64 component_size = uf.rank[i];\n        i64 check = mod_pow(k, component_size, n);\n        if (check == 1) {\n            answer = (answer * n) % MOD;\n        }\n    }\n    \n    cout << answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long MOD = 1000000007;\n\n    static long mod_pow(long b, long e, long m) {\n        long res = 1;\n        b %= m;\n        while (e > 0) {\n            if ((e & 1) == 1) {\n                res = (res * b) % m;\n            }\n            b = (b * b) % m;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static class UnionFind {\n        int[] parent;\n        int[] rank;\n\n        UnionFind(int n) {\n            parent = new int[n];\n            rank = new int[n];\n            for (int i = 0; i < n; ++i) {\n                parent[i] = i;\n                rank[i] = 1;\n            }\n        }\n\n        int find(int x) {\n            if (parent[x] != x) {\n                parent[x] = find(parent[x]);\n            }\n            return parent[x];\n        }\n\n        void connect(int x, int y) {\n            x = find(x);\n            y = find(y);\n            if (x == y) return;\n            if (rank[x] < rank[y]) {\n                int temp = x;\n                x = y;\n                y = temp;\n            }\n            parent[y] = x;\n            rank[x] += rank[y];\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int k = sc.nextInt();\n        \n        if (k == 0) {\n            System.out.println(mod_pow(n, n - 1, MOD));\n            return;\n        }\n        \n        UnionFind uf = new UnionFind(n);\n        for (int i = 0; i < n; ++i) {\n            uf.connect(i, (int)((1L * i * k) % n));\n        }\n        \n        long answer = 1;\n        for (int i = 0; i < n; ++i) {\n            if (uf.find(i) != i) continue;\n            long component_size = uf.rank[i];\n            long check = mod_pow(k, component_size, n);\n            if (check == 1) {\n                answer = (answer * n) % MOD;\n            }\n        }\n        \n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019643761334009469, -1.6689286894688848e-06, -3.576278118089249e-07, -0.0007724162423983216, -4.172238186583854e-05, -0.07001614570617676, -0.31584322452545166, -0.00012635385792236775, -8.344646857949556e-07, -4.5060096454108134e-05, -0.0008052920456975698, -4.005352093372494e-05, -0.033758148550987244, -7.497983460780233e-05, -8.630380034446716e-05, -3.3378546504536644e-06, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -2.753696753643453e-05, 0.0, -1.1920928244535389e-07, -6.198863957251888e-06, 0.0, 0.0, -1.7881377516459906e-06, 0.0, -2.3841830625315197e-06, -0.05498724430799484, -4.6491513785440475e-06, -0.001327824778854847, -5.0424259825376794e-05, -3.933898824470816e-06, -0.03807205334305763, -1.5020257706055418e-05, -0.00023064337437972426, 0.0, -2.861018856492592e-06, -4.768370445162873e-07, -2.3841855067985307e-07, -1.4424220353248529e-05, 0.0, -3.576278118089249e-07, 0.0, -5.090107151772827e-05, -2.9802276912960224e-06, -3.576278118089249e-07, 0.0, 0.0, 0.0, -1.1920922133867862e-06, 0.0, -2.3841855067985307e-07, -2.9802276912960224e-06, 0.0, -1.4305104514278355e-06, -1.1920928244535389e-07, -2.3841830625315197e-06, -1.1920922133867862e-06, 0.0, -0.01603446528315544, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, -1.1920922133867862e-06, -6.9141146923357155e-06, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -2.38418306