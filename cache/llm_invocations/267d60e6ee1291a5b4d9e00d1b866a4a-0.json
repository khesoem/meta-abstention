{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = INT_MAX;\nconst int MAXN = 10001;\n\nstruct Edge {\n    int to, rev, cap, cost;\n};\n\nvector<Edge> g[MAXN];\nint nodeCnt;\nint dist[MAXN], prevV[MAXN], prevE[MAXN];\nbool inQueue[MAXN];\n\nint addNodes(int cnt) {\n    while (cnt--) g[nodeCnt++].clear();\n    return nodeCnt - 1;\n}\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    g[u].push_back({v, (int)g[v].size(), cap, cost});\n    g[v].push_back({u, (int)g[u].size() - 1, 0, -cost});\n}\n\nbool spfa(int s, int t) {\n    fill(dist, dist + nodeCnt, INF);\n    fill(inQueue, inQueue + nodeCnt, false);\n\n    queue<int> q;\n    dist[s] = 0;\n    q.push(s);\n    inQueue[s] = true;\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inQueue[u] = false;\n\n        for (int i = 0; i < (int)g[u].size(); ++i) {\n            Edge &e = g[u][i];\n            int v = e.to;\n\n            if (e.cap > 0 && dist[v] > dist[u] + e.cost) {\n                dist[v] = dist[u] + e.cost;\n                prevV[v] = u;\n                prevE[v] = i;\n\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n\n    return dist[t] != INF;\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n\n    nodeCnt = 0;\n    int L = max(n, k) * 2;\n\n    addNodes(L * n);\n    int s = addNodes(1);\n    int t = addNodes(1);\n\n    for (int j = 0; j < k; ++j) {\n        int a;\n        scanf(\"%d\", &a);\n        --a;\n        addEdge(s, a, 1, 0);\n    }\n\n    for (int z = 0; z < m; ++z) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        --u;\n        --v;\n\n        for (int i = 0; i + 1 < L; ++i) {\n            int u1 = u + i * n;\n            int v1 = v + (i + 1) * n;\n            int u2 = u + (i + 1) * n;\n            int v2 = v + i * n;\n\n            for (int j = 0; j < k; ++j) {\n                int w = c + d * (2 * j + 1);\n                addEdge(u1, v1, 1, w);\n                addEdge(v2, u2, 1, w);\n            }\n        }\n    }\n\n    for (int i = 0; i + 1 < L; ++i) {\n        for (int j = 0; j < n; ++j) {\n            int u = j + i * n;\n            int v = j + (i + 1) * n;\n            addEdge(u, v, INF, c);\n        }\n    }\n\n    for (int i = 0; i < L; ++i)\n        addEdge(i * n, t, INF, 0);\n\n    int flow = 0, cost = 0;\n\n    while (flow < k) {\n        if (!spfa(s, t)) break;\n\n        int add = INF;\n        for (int v = t; v != s; v = prevV[v])\n            add = min(add, g[prevV[v]][prevE[v]].cap);\n\n        for (int v = t; v != s; v = prevV[v]) {\n            Edge &e = g[prevV[v]][prevE[v]];\n            e.cap -= add;\n            g[v][e.rev].cap += add;\n        }\n\n        flow += add;\n        cost += add * dist[t];\n    }\n\n    printf(\"%d\\n\", cost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev, cap, cost;\n        Edge(int to, int rev, int cap, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static final int INF = Integer.MAX_VALUE;\n    static ArrayList<ArrayList<Edge>> g;\n    static int nodeCnt;\n    static int[] dist, prevV, prevE;\n    static boolean[] inQueue;\n\n    static int addNodes(int cnt) {\n        while (cnt-- > 0) {\n            g.add(new ArrayList<>());\n            nodeCnt++;\n        }\n        return nodeCnt - 1;\n    }\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        g.get(u).add(new Edge(v, g.get(v).size(), cap, cost));\n        g.get(v).add(new Edge(u, g.get(u).size() - 1, 0, -cost));\n    }\n\n    static boolean spfa(int s, int t) {\n        Arrays.fill(dist, INF);\n        Arrays.fill(inQueue, false);\n        Queue<Integer> q = new LinkedList<>();\n        dist[s] = 0;\n        q.add(s);\n        inQueue[s] = true;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = false;\n            for (int i = 0; i < g.get(u).size(); i++) {\n                Edge e = g.get(u).get(i);\n                int v = e.to;\n                if (e.cap > 0 && dist[v] > dist[u] + e.cost) {\n                    dist[v] = dist[u] + e.cost;\n                    prevV[v] = u;\n                    prevE[v] = i;\n                    if (!inQueue[v]) {\n                        inQueue[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return dist[t] != INF;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        g = new ArrayList<>();\n        nodeCnt = 0;\n        int L = Math.max(n, k) * 2;\n\n        addNodes(L * n);\n        int s = addNodes(1);\n        int t = addNodes(1);\n\n        for (int j = 0; j < k; j++) {\n            int a = sc.nextInt() - 1;\n            addEdge(s, a, 1, 0);\n        }\n\n        for (int z = 0; z < m; z++) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int i = 0; i + 1 < L; i++) {\n                int u1 = u + i * n;\n                int v1 = v + (i + 1) * n;\n                int u2 = u + (i + 1) * n;\n                int v2 = v + i * n;\n                for (int j = 0; j < k; j++) {\n                    int w = c + d * (2 * j + 1);\n                    addEdge(u1, v1, 1, w);\n                    addEdge(v2, u2, 1, w);\n                }\n            }\n        }\n\n        for (int i = 0; i + 1 < L; i++) {\n            for (int j = 0; j < n; j++) {\n                int u = j + i * n;\n                int v = j + (i + 1) * n;\n                addEdge(u, v, INF, c);\n            }\n        }\n\n        for (int i = 0; i < L; i++) {\n            addEdge(i * n, t, INF, 0);\n        }\n\n        dist = new int[nodeCnt];\n        prevV = new int[nodeCnt];\n        prevE = new int[nodeCnt];\n        inQueue = new boolean[nodeCnt];\n\n        int flow = 0, cost = 0;\n        while (flow < k) {\n            if (!spfa(s, t)) break;\n            int add = INF;\n            for (int v = t; v != s; v = prevV[v]) {\n                add = Math.min(add, g.get(prevV[v]).get(prevE[v]).cap);\n            }\n            for (int v = t; v != s; v = prevV[v]) {\n                Edge e = g.get(prevV[v]).get(prevE[v]);\n                e.cap -= add;\n                g.get(v).get(e.rev).cap += add;\n            }\n            flow += add;\n            cost += add * dist[t];\n        }\n\n        System.out.println(cost);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-5.972207145532593e-05, 0