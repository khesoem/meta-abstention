ro subsets of U\n    int T = U;\n    while (T) {\n        res = (res + (long long)invFact[mask - T] * solve(cur + 1, T)) % MOD;\n        T = (T - 1) & U;\n    }\n    res = (res + (long long)invFact[mask] * solve(cur + 1, 0)) % MOD;\n    dp[cur][mask] = res;\n    return res;\n}\n\nint main() {\n    scanf(\"%d %d %d\", &N, &K, &MOD);\n    int ans = 1;\n    for (int i = 1; i <= N; ++i)\n        ans = (long long)ans * K % MOD;\n    if (N % 2 == 0) {\n        precompute();\n        memset(dp, -1, sizeof(dp));\n        ans = (ans - solve(0, N) + MOD) % MOD;\n    }\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef fast_pow(base, exp, mod):\n    result = 1\n    cur = base\n    while exp:\n        if exp & 1:\n            result = (result * cur) % mod\n        cur = (cur * cur) % mod\n        exp >>= 1\n    return result\n\ndef lowbit(x):\n    return x & -x\n\ndef precompute():\n    global fact, inv_fact, N, MOD\n    fact = [1] * (N + 1)\n    for i in range(1, N + 1):\n        fact[i] = (fact[i-1] * i) % MOD\n    inv_fact = [1] * (N + 1)\n    inv_fact[N] = fast_pow(fact[N], MOD - 2, MOD)\n    for i in range(N, 0, -1):\n        inv_fact[i-1] = (inv_fact[i] * i) % MOD\n\ndef solve(cur, mask):\n    if mask in dp[cur]:\n        return dp[cur][mask]\n    if mask == 0:\n        val = fact[N]\n        for i in range(1, cur + 1):\n            val = (val * (K - i + 1)) % MOD\n        dp[cur][mask] = val\n        return val\n    U = mask - lowbit(mask)\n    res = 0\n    T = U\n    while T:\n        res = (res + inv_fact[mask - T] * solve(cur + 1, T)) % MOD\n        T = (T - 1) & U\n    res = (res + inv_fact[mask] * solve(cur + 1, 0)) % MOD\n    dp[cur][mask] = res\n    return res\n\ndef main():\n    global N, K, MOD, fact, inv_fact, dp\n    data = sys.stdin.read().strip().split()\n    if not data:\n      