  flow[e.first] = min(e.second, flow[x]);\n                    bfs.push(e.first);\n                }\n            }\n        }\n        if (!found) break;\n    }\n    return total;\n}\n\nint main(){\n  ios::sync_with_stdio(0);\n  cin>>n>>m;\n\n  int res=0;\n  for (int i=0; i<n; i++)\n    for (int j=!(cin>>buf[i]); j<n; j++)\n      if (buf[i][j]>'0' and buf[i][j]<='9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  res = max_flow(0,1);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static HashMap<Integer, Integer>[] edge;\n    static int n, m, vn;\n    static int[] from, flow;\n    static int[][] tox;\n    static char[][] buf;\n    static final int[] dx = {-1, 0, 1, 0};\n    static final int[] dy = {0, -1, 0, 1};\n\n    static int enc(int x, int y, int t) {\n        return x + y * n + t * n * n + 2;\n    }\n\n    static int maxFlow(int s, int t) {\n        int total = 0;\n        final int INF = 1000000000;\n        while (true) {\n            Arrays.fill(from, -1);\n            from[s] = s;\n            flow[s] = INF;\n            Queue<Integer> bfs = new LinkedList<>();\n            bfs.add(s);\n            boolean found = false;\n            while (!bfs.isEmpty()) {\n                int x = bfs.poll();\n                if (x == t) {\n                    found = true;\n                    int aug = flow[t];\n                    for (int v = t; v != s; v = from[v]) {\n                        int u = from[v];\n                        int cap = edge[u].get(v);\n                        edge[u].put(v, cap - aug);\n                        edge[v].put(u, edge[v].getOrDefault(u, 0) + aug);\n                    }\n                    total += aug;\n                    break;\n                }\n                for (Map.Entry<Integer, Integer> e : edge[x].entrySet()) {\n                    int v = e.getKey();\n                    int cap = e.getValue();\n                    if (cap > 0 && from[v] == -1) {\n                        from[v] = x;\n                        flow[v] = Math.min(cap, flow[x]);\n                        bfs.add(v);\n                    }\n                }\n            }\n            if (!found) break;\n        }\n        return total;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        vn = (m + 1) * n * n + 2;\n        edge = new HashMap[vn];\n        for (int i = 0; i < vn; i++) edge[i] = new HashMap<>();\n        from = new int[vn];\n        flow = new int[vn];\n        buf = new char[n][n];\n\n        // Read first n lines (digits) and add edges from source\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            buf[i] = s.toCharArray();\n            for (int j = 0; j < n; j++) {\n                char c = buf[i][j];\n                if (c > '0' && c <= '9') {\n                    edge[0].put(enc(i, j, 0), c - '0');\n                }\n            }\n        }\n\n        // Read second n lines (grid with Z, Y, etc.)\n        for (int i = 0; i < n; i++) {\n            String s = sc.next();\n            buf[i] = s.toCharArray();\n        }\n\n        tox = new int[n][n];\n        Queue<int[]> bfs = new LinkedList<>();\n        for (int i = n - 1; i >= 0; i--) {\n            for (int j = n - 1; j >= 0; j--) {\n                if (buf[i][j] == 'Z') {\n                    tox[i][j] = 0;\n                    bfs.add(new int[]{i, j});\n                } else {\n                    tox[i][j] = m + 1;\n                }\n            }\n        }\n\n        while (!bfs.isEmpty()) {\n            int[] cur = bfs.poll();\n            int t = tox[cur[0]][cur[1]];\n            for (int d = 0; d < 4; d++) {\n                int x = cur[0] + dx[d];\n                int y = cur[1] + dy[d];\n                if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y' && t + 1 < tox[x][y]) {\n                    tox[x][y] = t + 1;\n                    bfs.add(new int[]{x, y});\n                }\n            }\n        }\n\n        // Add edges for the second part\n        for (int i = n - 1; i >= 0; i--) {\n            for (int j = n - 1; j >= 0; j--) {\n                for (int t = 0; t < m; t++) {\n                    for (int d = 0; d < 4; d++) {\n                        int x = i + dx[d];\n                        int y = j + dy[d];\n                        if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y') {\n                            int add = (buf[x][y] > '0' && buf[x][y] <= '9') ? 1 : 0;\n                            if (t + 1 < tox[x][y] + add && t < tox[i][j]) {\n                                edge[enc(i, j, t)].put(enc(x, y, t + 1), 1000);\n                            }\n                        }\n                    }\n                    if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                        edge[enc(i, j, t)].put(enc(i, j, m), buf[i][j] - '0');\n                    }\n                }\n                if (buf[i][j] > '0' && buf[i][j] <= '9') {\n                    edge[enc(i, j, m)].put(1, buf[i][j] - '0');\n                }\n            }\n        }\n\n        int res = maxFlow(0, 1);\n        System.out.println(res);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.8636207793606445e-05, -3.8265450712060556e-05, 0.0, -2.1457441107486375e-05, -0.0019945267122238874, -7.784063927829266e-05, 0.0, -2.622600959512056e-06, -0.003180447733029723, -1.585470999998506e-05, -0.0012373419012874365, -0.0766536295413971, 0.0, 0.0, -0.2519294023513794, 0.0, -1.7881377516459906e-06, -4.887569048150908e-06, -0.0002337421028641984, 0.0, 0.0, -0.0009136793087236583, -0.00046957432641647756, -5.602820692729438e-06, -5.960462772236497e-07, -9.619726915843785e-05, -3.540453326422721e-05, -1.1920928244535389e-07, -3.0397906812140718e-05, 0.0, 0.0, -1.585470999998506e-05, -1.311301275563892e-06, -2.264974000354414e-06, -0.003179021645337343, -1.1920928244535389e-07, -1.9073468138230965e-06, 0.0, 0.0, -0.004084815736860037, -8.583032467868179e-06, -8.344646857949556e-07, -0.0003630455757956952, 0.0, 0.0, -6.556489552167477e-06, 0.0, -4.172316494077677e-06, -0.0028769078198820353, -8.344646857949556e-07, -1.5497195136049413e-06, -0.0015023384476080537, -1.1920928244535389e-07, -2.753696753643453e-05, -5.006777428206988e-06, -1.1920928244535389e-07, -0.0007161913090385497, 0.0, 0.0, -0.0028055852744728327, -1.0728830375228426e-06, 0.0, -3.576278118089249e-07, -4.768370445162873e-07, 0.0, -5.960462772236497e-07, -1.0728830375228426e-