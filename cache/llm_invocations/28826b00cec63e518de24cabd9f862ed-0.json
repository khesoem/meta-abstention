    } else {\n                    boolean found = false;\n                    for (Integer j : waitingList) {\n                        if (res[j] != res[i]) {\n                            int minB1 = b[j] < b[getvisavis(n, j)] ? j : getvisavis(n, j);\n                            int minB2 = b[i] < b[getvisavis(n, i)] ? i : getvisavis(n, i);\n                            swap(res, minB1, minB2);\n                            b[minB1] = 0;\n                            b[minB2] = 0;\n                            waitingList.remove(j);\n                            found = true;\n                            break;\n                        }\n                    }\n                    if (!found) waitingList.add(i);\n                }\n            }\n        }\n\n        w.put(0, new HashSet<>());\n        for (int i = 0; i < n; ++i) {\n            if (!w.containsKey(b[i])) w.put(b[i], new HashSet<>());\n            w.get(b[i]).add(i);\n        }\n\n        for (int i = 0; i < n / 2; ++i) {\n            if (res[i] == res[getvisavis(n, i)]) {\n                boolean finished = false;\n                int indexToChange = b[i] < b[getvisavis(n, i)] ? i : getvisavis(n, i);\n                for (Map.Entry<Integer, Set<Integer>> l : w.entrySet()) {\n                    Set<Integer> candidates = l.getValue();\n                    for (Integer j : candidates) {\n                        if (j == i || j == indexToChange || res[indexToChange] == res[j] || res[indexToChange] == res[getvisavis(n, j)]) {\n                            continue;\n                        }\n                        swap(res, indexToChange, j);\n                        b[j] = 0;\n                        b[indexToChange] = 0;\n                        w.get(0).add(j);\n                        w.get(0).add(indexToChange);\n                        w.get(b[indexToChange]).remove(indexToChange);\n                        w.get(b[j]).remove(j);\n                        finished = true;\n                        break;\