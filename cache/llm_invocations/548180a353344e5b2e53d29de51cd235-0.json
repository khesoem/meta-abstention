{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n#define INF 0x7f7f7f7f\nint N, M, S, T, P, C, D, X[505], Y[505];\nint MF, MC;\nint E = 1;\nint H[5000005], NX[5000005<<1], TO[5000005<<1], VL[5000005<<1], CT[5000005<<1];\nint DS[5000005], PR[5000005], LS[5000005], FL[5000005];\nbool V[5000005];\n\nvoid AE(int a, int b, int c, int d) {\n    NX[++E] = H[a];\n    TO[E] = b;\n    VL[E] = c;\n    CT[E] = d;\n    H[a] = E;\n}\n\nbool SP() {\n    memset(DS, INF, sizeof(DS));\n    memset(V, 0, sizeof(V));\n    queue<int> Q;\n    Q.push(S);\n    V[S] = 1;\n    DS[S] = 0;\n    FL[S] = INF;\n    PR[T] = -1;\n    while (!Q.empty()) {\n        int x = Q.front();\n        Q.pop();\n        V[x] = 0;\n        for (int i = H[x]; i; i = NX[i]) {\n            if (VL[i] && DS[TO[i]] > DS[x] + CT[i]) {\n                DS[TO[i]] = DS[x] + CT[i];\n                PR[TO[i]] = x;\n                LS[TO[i]] = i;\n                FL[TO[i]] = min(FL[x], VL[i]);\n                if (!V[TO[i]]) {\n                    V[TO[i]] = 1;\n                    Q.push(TO[i]);\n                }\n            }\n        }\n    }\n    return PR[T] != -1;\n}\n\nvoid MCMF() {\n    MF = MC = 0;\n    while (SP()) {\n        int nw = T;\n        MF += FL[T];\n        MC += FL[T] * DS[T];\n        while (nw != S) {\n            VL[LS[nw]] -= FL[T];\n            VL[LS[nw] ^ 1] += FL[T];\n            nw = PR[nw];\n        }\n    }\n}\n\nint ZH(int t, int x) {\n    return t * N + x;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> N >> M >> P >> C >> D;\n    S = 0;\n    T = N * 99 + 1;\n    for (int i = 1, a; i <= P && cin >> a; i++) {\n        AE(S, ZH(0, a), 1, 0);\n        AE(ZH(0, a), S, 0, 0);\n    }\n    for (int i = 1; i <= M; cin >> X[i] >> Y[i], i++);\n    for (int i = 0; i <= 99; i++) {\n        AE(ZH(i, 1), ZH(i + 1, 1), INF, 0);\n        AE(ZH(i + 1, 1), ZH(i, 1), 0, 0);\n        for (int j = 2; j <= N; j++) {\n            AE(ZH(i, j), ZH(i + 1, j), INF, C);\n            AE(ZH(i + 1, j), ZH(i, j), 0, -C);\n        }\n        for (int j = 1; j <= M; j++) {\n            for (int k = 1; k <= P; k++) {\n                int CST = D * k * k - D * (k - 1) * (k - 1) + C;\n                AE(ZH(i, X[j]), ZH(i + 1, Y[j]), 1, CST);\n                AE(ZH(i + 1, Y[j]), ZH(i, X[j]), 0, -CST);\n                AE(ZH(i, Y[j]), ZH(i + 1, X[j]), 1, CST);\n                AE(ZH(i + 1, X[j]), ZH(i, Y[j]), 0, -CST);\n            }\n        }\n    }\n    MCMF();\n    cout << MC << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    N = next(it)\n    M = next(it)\n    P = next(it)\n    C = next(it)\n    D = next(it)\n    \n    # starting positions\n    starts = [next(it) for _ in range(P)]\n    \n    # edges (X, Y)\n    X = [0] * (M+1)\n    Y = [0] * (M+1)\n    for i in range(1, M+1):\n        X[i] = next(it)\n        Y[i] = next(it)\n    \n    # node indexing: ZH(t, x) = t * N + x, with t from 0 to 100, x from 1 to N\n    # S = 0, T = N*99 + 1\n    S = 0\n    T = N * 99 + 1\n    max_node = 101 * N + 1  # enough for t=100, x=N\n    graph = [[] for _ in range(max_node + 1)]\n    \n    def add_edge(u, v, cap, cost):\n        # forward edge\n        graph[u].append([v, len(graph[v]), cap, cost])\n        # reverse edge\n        graph[v].append([u, len(graph[u]) - 1, 0, -cost])\n    \n    # add edges from source to starting positions at time 0\n    for a in starts:\n        add_edge(S, 0 * N + a, 1, 0)\n    \n    # time steps from 0 to 99\n    for i in range(0, 100):\n        # stay at node 1: infinite capacity, cost 0\n        add_edge(i * N + 1, (i+1) * N + 1, INF, 0)\n        # stay at other nodes: infinite capacity, cost C\n        for j in range(2, N+1):\n            add_edge(i * N + j, (i+1) * N + j, INF, C)\n        # edges for each road (X[j], Y[j])\n        for j in range(1, M+1):\n            for k in range(1, P+1):\n                CST = D * k * k - D * (k-1) * (k-1) + C\n                # from X to Y\n                add_edge(i * N + X[j], (i+1) * N + Y[j], 1, CST)\n                # from Y to X\n                add_edge(i * N + Y[j], (i+1) * N + X[j], 1, CST)\n    \n    V = len(graph)\n    dist = [0] * V\n    prevv = [0] * V\n    preve = [0] * V\n    flow = [0] * V\n    inqueue = [False] * V\n    \n    def spfa():\n        for i in range(V):\n            dist[i] = INF\n            inqueue[i] = False\n        q = deque()\n        dist[S] = 0\n        flow[S] = INF\n        prevv[T] = -1\n        q.append(S)\n        inqueue[S] = True\n        while q:\n            u = q.popleft()\n            inqueue[u] = False\n            for i, e in enumerate(graph[u]):\n                v, rev, cap, cost = e\n                if cap > 0 and dist[v] > dist[u] + cost:\n                    dist[v] = dist[u] + cost\n                    prevv[v] = u\n                    preve[v] = i\n                    flow[v] = min(flow[u], cap)\n                    if not inqueue[v]:\n                        q.append(v)\n                        inqueue[v] = True\n        return prevv[T] != -1\n    \n    MF = 0\n    MC = 0\n    while spfa():\n        d = flow[T]\n        MF += d\n        MC += d * dist[T]\n        v = T\n        while v != S:\n            u = prevv[v]\n            e_idx = preve[v]\n            graph[u][e_idx][2] -= d\n            rev = graph[u][e_idx][1]\n            graph[v][rev][2] += d\n            v = u\n    \n    print(MC)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015960850578267127, 0.0, -1.1920928244535389e-07, -0.000717025191988796, -0.003281686222180724, -7.152555099310121e-07, -8.22540732769994e-06, -5.876845170860179e-05, 0.0, 0.0, -5.960462772236497e-07, -0.00026472879108041525, -0.4744717478752136, -7.795983401592821e-05, -5.722029527532868e-06, -3.158996332786046e-05, -0.03804141283035278, -7.70062324590981e-05, -0.0012846082681789994, -0.0014068715972825885, -0.2559654712677002, -0.16028016805648804, -1.0728830375228426e-06, -0.00010990492592100054, 0.0, -0.018163306638598442, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.00033825874561443925, 0.0, -0.00020346954988781363, -1.1920922133867862e-06, -2.264974000354414e-06, -0.476765513420105, -3.6954811548639555e-06, 0.0, -0.00026127262390218675, -4.768370445162873e-07, 0.0, -9.179073458653875e-06, -1.311301275563892e-06, -0.016884271055459976, -1.1920928244535389e-07, -0.00033539868309162557, 0.0, -1.537788011773955e-05, -3.6954811548639555e-06, -3.2186455882765586e-06, -7.497983460780233e-05, -1.7881377516459906e-06, 0.0, -0.38698551058769226, 0.0, 0.0, -1.1205610462639015e-05, 0.0, 0.0, -4.291525328881107e-06, 0.0, -4.768370445162873e-07, -0.00010179955279454589, 0.0, 0.0, -1.156323378381785e-05, 0.0, -2.264974000354