{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\nconst int MOD = 1000000007;\nauto add = [](int a, int b) -> int { return (a += b) >= MOD ? a - MOD : a; };\nauto mul = [](int a, int b) -> int { return (int)((long long)a * b % MOD); };\nauto sub = [](int a, int b) -> int { return (a -= b) < 0 ? a + MOD : a; };\nauto power = [](int a, int b) -> int { int r=1; while(b){ if(b&1) r=mul(r,a); a=mul(a,a); b>>=1; } return r; };\nauto lowbit = [](int x) -> int { return x & -x; };\n\nint main() {\n    int n;\n    cin >> n;\n    vector<vector<int>> trans(1, vector<int>(1<<n)); // will resize later\n    map<bitset<128>, int> id;\n    int idcnt = 0;\n    function<int(bitset<128>)> dfs = [&](bitset<128> s) -> int {\n        if(id.count(s)) return id[s];\n        id[s] = ++idcnt;\n        if(trans.size() <= idcnt) trans.resize(idcnt+1, vector<int>(1<<n));\n        for(int mask = 0; mask < (1<<n); ++mask) {\n            bitset<128> t = s;\n            for(int j = 0; j < (1<<n); ++j) {\n                if(!t[j]) {\n                    int x = mask & j;\n                    while(x) {\n                        int lb = lowbit(x);\n                        if(s[j ^ lb]) { t[j] = 1; break; }\n                        x -= lb;\n                    }\n                }\n            }\n            trans[idcnt][mask] = dfs(t);\n        }\n        return idcnt;\n    };\n    dfs(1);\n    vector<vector<int>> prob(n, vector<int>(1<<n));\n    vector<vector<int>> a(n, vector<int>(n));\n    for(int i=0; i<n; ++i)\n        for(int j=0; j<n; ++j) {\n            cin >> a[i][j];\n            a[i][j] = mul(a[i][j], power(100, MOD-2));\n        }\n    for(int i=0; i<n; ++i) {\n        for(int mask = 0; mask < (1<<n); ++mask) {\n            prob[i][mask] = 1;\n            for(int k=0; k<n; ++k) {\n                if(mask & (1<<k)) prob[i][mask] = mul(prob[i][mask], a[i][k]);\n                else prob[i][mask] = mul(prob[i][mask], sub(1, a[i][k]));\n            }\n        }\n    }\n    vector<vector<int>> dp(n+1, vector<int>(idcnt+1, 0));\n    dp[0][1] = 1;\n    for(int i=1; i<=n; ++i) {\n        for(int st=1; st<=idcnt; ++st) {\n            for(int mask=0; mask<(1<<n); ++mask) {\n                int nxt = trans[st][mask];\n                dp[i][nxt] = add(dp[i][nxt], mul(dp[i-1][st], prob[i-1][mask]));\n            }\n        }\n    }\n    bitset<128> full;\n    for(int i=0; i<(1<<n); ++i) full[i]=1;\n    cout << dp[n][id[full]] << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add(a, b):\n    return (a + b) % MOD\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef sub(a, b):\n    return (a - b) % MOD\n\ndef power(a, b):\n    return pow(a, b, MOD)\n\ndef lowbit(x):\n    return x & -x\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it)\n    size = 1 << n\n\n    # read matrix a\n    a = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            a[i][j] = next(it)\n            a[i][j] = mul(a[i][j], power(100, MOD - 2))\n\n    # probability for each i and mask\n    prob = [[0] * size for _ in range(n)]\n    for i in range(n):\n        for mask in range(size):\n            p = 1\n            for k in range(n):\n                if mask & (1 << k):\n                    p = mul(p, a[i][k])\n                else:\n                    p = mul(p, sub(1, a[i][k]))\n            prob[i][mask] = p\n\n    # state ids and transitions\n    id_map = {}\n    idcnt = 0\n    trans = [[0] * size]  # dummy row for index 0\n\n    sys.setrecursionlimit(10000)\n\n    def dfs(s):\n        nonlocal idcnt, trans\n        if s in id_map:\n            return id_map[s]\n        idcnt += 1\n        id_map[s] = idcnt\n        # ensure trans has enough rows\n        while len(trans) <= idcnt:\n            trans.append([0] * size)\n        # compute transitions for each mask\n        for mask in range(size):\n            t = s\n            for j in range(size):\n                if (t >> j) & 1 == 0:\n                    x = mask & j\n                    while x:\n                        lb = lowbit(x)\n                        if (s >> (j ^ lb)) & 1:\n                            t |= (1 << j)\n                            break\n                        x ^= lb\n            trans[idcnt][mask] = dfs(t)\n        return idcnt\n\n    dfs(1)  # initial state: only empty set present\n\n    # DP\n    dp = [[0] * (idcnt + 1) for _ in range(n + 1)]\n    dp[0][1] = 1  # state id 1 corresponds to initial state\n\n    for i in range(1, n + 1):\n        for st in range(1, idcnt + 1):\n            for mask in range(size):\n                nxt = trans[st][mask]\n                dp[i][nxt] = add(dp[i][nxt], mul(dp[i - 1][st], prob[i - 1][mask]))\n\n    full = (1 << size) - 1\n    print(dp[n][id_map[full]])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.6212332411669