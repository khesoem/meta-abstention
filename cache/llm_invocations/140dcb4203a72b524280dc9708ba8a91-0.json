for (int i = 0; i < g[v].size(); ++i) {\n                        Edge& e = g[v][i];\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                            dist[e.to] = dist[v] + e.cost;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            updated = true;\n                        }\n                    }\n                }\n            }\n            if (dist[sink] == INF) break;\n            \n            int flow = INF;\n            for (int v = sink; v != source; v = prevv[v]) {\n                flow = min(flow, g[prevv[v]][preve[v]].cap);\n            }\n            \n            total_cost += flow * dist[sink];\n            for (int v = sink; v != source; v = prevv[v]) {\n                Edge& e = g[prevv[v]][preve[v]];\n                e.cap -= flow;\n                g[v][e.rev].cap += flow;\n            }\n        }\n        return total_cost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int S = 0, T = 1;\n    int total_nodes = 2 + (n + k + 1) * (n + 1);\n    MinCostFlow mcf(total_nodes);\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        mcf.add_edge(S, x + 1, 1, 0);\n    }\n    \n    vector<pair<int, int>> edges(m);\n    for (int i = 0; i < m; ++i) {\n        cin >> edges[i].first >> edges[i].second;\n    }\n    \n    for (int layer = 0; layer <= n + k; ++layer) {\n        mcf.add_edge(2 + layer * (n + 1), T, k, 0);\n        if (layer == n + k) break;\n        \n        for (int i = 0; i < m; ++i) {\n            int u = edges[i].first, v = edges[i].second;\n            for (int l = k; l >= 0; --l) {\n                int w = (l * 2 + 1) * d + c;\n                mcf.add_edge(u + 1 + layer * (n + 1), v + 1 + layer * (n + 1) + n, 1, w);\n                mcf.add_edge(v + 1 + layer * (n + 1), u + 1 + layer * (n + 1) +