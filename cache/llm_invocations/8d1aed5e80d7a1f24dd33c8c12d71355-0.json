od - mod / i) * inv_tbl[mod % i] % mod;\n        fact_tbl[i] = fact_tbl[i-1] * i % mod;\n    }\n    for (int i = 2; i <= limit; ++i) {\n        inv_tbl[i] = inv_tbl[i-1] * inv_tbl[i] % mod;\n    }\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    \n    i64 n_val, k_val, mod_val;\n    std::cin >> n_val >> k_val >> mod_val;\n    comb_init(n_val + 5, mod_val);\n    \n    if (n_val & 1) {\n        std::cout << mod_pow(k_val, n_val, mod_val) << '\\n';\n        return 0;\n    }\n    \n    sub_list.clear();\n    for (int i = 2; i <= n_val; i += 2) {\n        if ((i & n_val) == i) {\n            sub_list.push_back(i);\n        }\n    }\n    \n    std::memset(dp_tab, 0, sizeof(dp_tab));\n    dp_tab[0][n_val] = 1;\n    i64 tot_ans = 0;\n    int max_depth = std::min(17LL, k_val);\n    \n    for (int depth = 1; depth <= max_depth; ++depth) {\n        i64 sub_sum = 0;\n        for (int idx = 0; idx < (int)sub_list.size(); ++idx) {\n            int curr = sub_list[idx];\n            if (dp_tab[depth-1][curr] == 0) continue;\n            \n            int next_node = curr & (curr - 1);\n            int diff = next_node ^ curr;\n            \n            for (int step = diff; step <= next_node; step += diff) {\n                if ((step & next_node) == step) {\n                    dp_tab[depth][step] = (dp_tab[depth][step] +\n                        dp_tab[depth-1][curr] * fact_tbl[curr] % mod_val *\n                        inv_tbl[step] % mod_val * inv_tbl[curr - step] % mod_val) % mod_val;\n                }\n            }\n            sub_sum = (sub_sum + dp_tab[depth-1][curr]) % mod_val;\n        }\n        tot_ans = (tot_ans + sub_sum * inv_tbl[k_val - depth] % mod_val) % mod_val;\n    }\n    \n    tot_ans = tot_ans * fact_tbl[k_val] % mod_val;\n    i64 final = (mod_pow(k_val, n_val, mod_val) - tot_ans % mod_val + mod_val) % mod_val;\n    std::cout << final << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_siz