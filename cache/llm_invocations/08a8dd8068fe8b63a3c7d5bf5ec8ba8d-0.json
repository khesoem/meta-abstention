                f_inv[i] = (f_inv[i - 1] * (n - i + 1)) % self.MOD\n            for i in range(len(f_inv) - 1, -1, -1):\n                self.inv_factorial.append(f_inv[i])\n        return self.inv_factorial[n]\n\n    def parity_sign(self, k):\n        return 1 if (k & 1) == 0 else self.MOD - 1\n\n    def ncr(self, n, r):\n        if r < 0 or n < r:\n            return 0\n        return (self.fact(n) * self.f_inv(r) % self.MOD) * self.f_inv(n - r) % self.MOD\n\n    def normalize(self, x):\n        x %= self.MOD\n        if x < 0:\n            x += self.MOD\n        return x\n\n    def add(self, a, b):\n        v = a + b\n        return v if v < self.MOD else v - self.MOD\n\n    def mult(self, *args):\n        r = 1\n        for x in args:\n            r = (r * x) % self.MOD\n        return r\n\n    def pow(self, x, e):\n        if e < 0:\n            x = pow(x, self.MOD - 2, self.MOD)\n            e = -e\n        if e == 0:\n            return 1\n        if e & 1:\n            return (x * self.pow(x, e - 1)) % self.MOD\n        return self.pow((x * x) % self.MOD, e // 2)\n\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    return None\n                self.tokenizer = line.strip().split()\n            except Exception:\n                raise RuntimeError(\"IO Error\")\n        return self.tokenizer.pop(0)\n\n    def next_int(self):\n        return int(self.next())\n\n    def next_long(self):\n        return int(self.next())\n\n\ndef main():\n    input_data = sys.stdin\n    output_data = sys.stdout\n    in_reader = InputReader(input_data)\n    out = output_data\n\n    mod = Mod998()\n    n = in_reader.next_int()\n    k = in_reader.next_long()\n\n    if k == 0:\n        out.write(str(mod.fact(n)) + \"\\n\")\