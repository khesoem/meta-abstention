                }\n            }\n        }\n        \n        System.out.println(sum);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    string line;\n    getline(cin, line);\n    line.erase(0, line.find_first_not_of(\" \\t\\r\\n\"));\n    line.erase(line.find_last_not_of(\" \\t\\r\\n\") + 1);\n    int n = stoi(line);\n    \n    const int MOD = 1000000007;\n    long long sum = 0;\n    \n    // Initialize DP table as 2D vector\n    vector<vector<int>> dp(n + 1, vector<int>(n + 1, 0));\n    \n    // Initialize first column\n    for (int i = 0; i <= n; i++) {\n        dp[i][0] = 1;\n        if (i % 2 == 1) {\n            sum = (sum + 1) % MOD;\n        }\n    }\n    \n    // Fill DP table\n    for (int j = 1; j <= n; j++) {\n        for (int i = j; i <= n; i++) {\n            int val = (dp[i][j - 1] + dp[i - 1][j]) % MOD;\n            dp[i][j] = val;\n            if ((i + j) % 2 == 1) {\n                sum = (sum + val) % MOD;\n            }\n        }\n    }\n    \n    cout << sum << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014280252798926085, -3.099436753473128e-06, -3.576278118089249e-07, -1.966933996300213e-05, -1.0728830375228426e-06, -3.4570634852570947e-06, -2.145764938177308e-06, -4.0531076592742465e-06, -2.145764938177308e-06, -0.00026055757189169526, -5.006777428206988e-06, -0.005931276362389326, -4.0531076592742465e-06, -0.18339082598686218, -0.0006272017490118742, -0.018151599913835526, -5.483612312673358e-06, -0.34364455938339233, -0.632608950138092, -0.5232013463973999, -1.5497195136049413e-06, -1.1920922133867862e-06, -5.960462772236497e-07, -0.005938149522989988, -3.21864558