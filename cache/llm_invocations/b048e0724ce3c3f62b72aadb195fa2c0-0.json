i = 0; i < G[v].size(); ++i) {\n                        Edge e = G[v].get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            que.offer(new int[]{dist[e.to], e.to});\n                        }\n                    }\n                }\n                if (dist[t] == Integer.MAX_VALUE) return -1;\n                for (int v = 0; v < V; ++v) h[v] += dist[v];\n                int d = f;\n                for (int v = t; v != s; v = prevv[v])\n                    d = Math.min(d, G[prevv[v]].get(preve[v]).cap);\n                f -= d;\n                res += d * h[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = G[prevv[v]].get(preve[v]);\n                    e.cap -= d;\n                    G[v].get(e.rev).cap += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    static MinCostFlow mcf = new MinCostFlow();\n    static int n, m, k, c, d;\n    static int[] a = new int[50];\n    static int[] cnt = new int[50];\n    static List<Integer>[] e = new List[50];\n    static final int T = 100;\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n        \n        for (int i = 0; i < k; ++i) {\n            a[i] = Integer.parseInt(br.readLine());\n        }\n        \n        for (int i = 0; i < 50; ++i) {\n            e[i] = new ArrayList<>();\n        }\n        \n        for (int i = 0; i < k; ++i) {\n            ++cnt[a[i] - 1];\n        }\n        \n        for (int i = 0; i < m; ++i) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            e[x].add(y);\n            e[y].add(x);\n        }\n        \n        mcf.init(n * T + 2);\n        for (int i = 0; i < n; ++i)\n            mcf.add_edge(n * T, i, cnt[i], 0);\n        for (int i = 0; i < T; ++i)\n            mcf.add_edge(i * n, n * T + 1, k, c * i);\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < T - 1; ++j)\n                mcf.add_edge(j * n + i, (j + 1) * n + i, k, 0);\n            for (int to : e[i]) {\n                for (int j = 0; j < T - 1; ++j) {\n                    for (int u = 0; u < k; ++u) {\n                        int cost = (u + 1) * (u + 1) * d - u * u * d;\n                        mcf.add_edge(j * n + i, (j + 1) * n + to, 1, cost);\n                    }\n                }\n            }\n        }\n        System.out.println(mcf.min_cost_flow(n * T, n * T + 1, k));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017093151109293103, -2.145764938177308e-06, -4.768370445162873e-07, -0.009953626431524754, -6.55629628454335e-05, -0.12693655490875244, -0.6326842308044434, -0.0013760393485426903, -4.2914423829643056e-05, -1.0371154530730564e-05, -0.00047565114800818264, -0.0006437613046728075, -7.152555099310121e-07, -4.8993817472364753e-05, -0.009758741594851017, -4.649054244509898e-05, -0.0004855407460127026, -0.2022964358329773, -4.565611743601039e-05, -3.576278118089249e-07, -1.311301275563892e-06, -4.768370445162873e-07, -8.344646857949556e-07, -1.1920922133867862e-06, -6.794906312279636e-06, 0.0, -2.50339189733495e-06, 0.0, -2.622600959512056e-06, -0.029750533401966095, -0.0006267252028919756, -2.8967437174287625e-05, -5.960462772236497e-07, -0.0002044230350293219, 0.