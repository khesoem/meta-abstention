{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing frac = pair<ll, ll>;\n\nfrac diff_abs(frac a, frac b) {\n    ll common = lcm(a.second, b.second);\n    ll na = a.first * (common / a.second);\n    ll nb = b.first * (common / b.second);\n    ll d = na - nb;\n    if (d < 0) d = -d;\n    ll g = gcd(d, common);\n    return {d / g, common / g};\n}\n\nint cmp_frac(frac a, frac b) {\n    ll common = lcm(a.second, b.second);\n    ll na = a.first * (common / a.second);\n    ll nb = b.first * (common / b.second);\n    if (na == nb) return 0;\n    return na < nb ? -1 : 1;\n}\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n\n    ll x, y, n;\n    cin >> x >> y >> n;\n\n    ll g = gcd(x, y);\n    x /= g;\n    y /= g;\n\n    frac target = {x, y};\n    frac bestDiff = {1000000000000LL, 1};\n    frac best = {0, 0};\n\n    for (ll den = 1; den <= n; ++den) {\n        ll left = 0;\n        double limit = (double)x / (double)y;\n        limit += (double)bestDiff.first / (double)bestDiff.second;\n        ll right = (ll)((limit + 2.0) * (double)den);\n\n        while (left <= right) {\n            ll mid = left + (right - left) / 2;\n            frac candidate = {mid, den};\n            frac curDiff = diff_abs(target, candidate);\n\n            int comparison = cmp_frac(curDiff, bestDiff);\n            if (comparison == 0) {\n                if (candidate.second < best.second ||\n                    (candidate.second == best.second && candidate.first < best.first)) {\n                    best = candidate;\n                }\n            } else if (comparison < 0) {\n                bestDiff = curDiff;\n                best = candidate;\n            }\n\n            if (cmp_frac(candidate, target) < 0)\n                left = mid + 1;\n            else\n                right = mid - 1;\n        }\n    }\n\n    cout << best.first << \"/\" << best.second;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.math.BigInteger;\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long x = sc.nextLong();\n        long y = sc.nextLong();\n        long n = sc.nextLong();\n\n        long g = gcd(x, y);\n        x /= g;\n        y /= g;\n\n        // target fraction\n        long targetNum = x;\n        long targetDen = y;\n\n        // bestDiff as BigInteger\n        BigInteger bestDiffNum = BigInteger.valueOf(1000000000000L);\n        BigInteger bestDiffDen = BigInteger.ONE;\n        long bestNum = 0;\n        long bestDen = 0;\n\n        for (long den = 1; den <= n; ++den) {\n            long left = 0;\n            double limit = (double)x / (double)y + bestDiffNum.doubleValue() / bestDiffDen.doubleValue();\n            long right = (long)((limit + 2.0) * (double)den);\n\n            while (left <= right) {\n                long mid = left + (right - left) / 2;\n                // candidate fraction\n                long candNum = mid;\n                long candDen = den;\n\n                // compute absolute difference\n                BigInteger[] curDiff = diff_abs(targetNum, targetDen, candNum, candDen);\n                int comp = cmp_frac(curDiff[0], curDiff[1], bestDiffNum, bestDiffDen);\n\n                if (comp == 0) {\n                    if (candDen < bestDen || (candDen == bestDen && candNum < bestNum)) {\n                        bestNum = candNum;\n                        bestDen = candDen;\n                    }\n                } else if (comp < 0) {\n                    bestDiffNum = curDiff[0];\n                    bestDiffDen = curDiff[1];\n                    bestNum = candNum;\n                    bestDen = candDen;\n                }\n\n                if (cmp_frac(candNum, candDen, targetNum, targetDen) < 0)\n                    left = mid + 1;\n                else\n                    right = mid - 1;\n            }\n        }\n\n        System.out.println(bestNum + \"/\" + bestDen);\n    }\n\n    public static long gcd(long a, long b) {\n        while (b != 0) {\n            long t = b;\n            b = a % b;\n            a = t;\n        }\n        return a;\n    }\n\n    public static BigInteger[] diff_abs(long aNum, long aDen, long bNum, long bDen) {\n        BigInteger aNumB = BigInteger.valueOf(aNum);\n        BigInteger aDenB = BigInteger.valueOf(aDen);\n        BigInteger bNumB = BigInteger.valueOf(bNum);\n        BigInteger bDenB = BigInteger.valueOf(bDen);\n        BigInteger num = aNumB.multiply(bDenB).subtract(bNumB.multiply(aDenB)).abs();\n        BigInteger den = aDenB.multiply(bDenB);\n        BigInteger g = num.gcd(den);\n        return new BigInteger[]{num.divide(g), den.divide(g)};\n    }\n\n    public static int cmp_frac(long aNum, long aDen, long bNum, long bDen) {\n        BigInteger left = BigInteger.valueOf(aNum).multiply(BigInteger.valueOf(bDen));\n        BigInteger right = BigInteger.valueOf(bNum).multiply(BigInteger.valueOf(aDen));\n        return left.compareTo(right);\n    }\n\n    public static int cmp_frac(BigInteger aNum, BigInteger aDen, BigInteger bNum, BigInteger bDen) {\n        BigInteger left = aNum.multiply(bDen);\n        BigInteger right = bNum.multiply(aDen);\n        return left.compareTo(right);\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-1.0728830375228426e-06, -2.3841855067985307e-07, -0.0006445952458307147, -0.0032768147066235542, -2.3841855067985307e-07, -0.12697350978851318, -1.7165990357170813e-05, 0.0, -1.0371154530730564e-05, -0.0010187203297391534, -4.2914423829643056e-05, -5.722029527532868e-06, -0.00010048838157672435, -0.014757518656551838, -0.004094076342880726, -0.00016068121476564556, -2.0265558760002023e-06, -0.0337299108505249, -0.16033418476581573, -0.07899825274944305, -0.3913670480251312, -1.1920928244535389e-07, -0.048680439591407776, -2.3841855067985307e-07, -6.437280717364047e-06, -4.410734163684538e-06, -6.55629628454335e-05, -0.001900891656987369, -0.0033698459155857563, -0.00011407678539399058, -0.008114466443657875, -0.18549567461013794, -0.00045622908510267735, -4.95898348162882e-05, -0.0001438752660760656, -0.0013487775577232242, -0.00886965449899435, -0.008503892458975315, -0.007654265966266394, -0.0005729940603487194, -0.00014423283573705703, -0.005471373908221722, -0.011125789023935795, -0.004762021824717522, -0.01006008218973875, -0.01971658691763878, -0.0006195771275088191, -0.1121944934129715, -0.04353053495287895, -0.007306639105081558, -0.0028733417857438326, -0.0017861855449154973, -0.0021470370702445507, -0.005903545767068863, -0.0005794276366941631, -0.02791534550487995, -0.010023260489106178, -0.0029678368009626865, -0.004215877968817949, -0.0036889140028506517, -0.00589027302339673, -0.3225213587284088, -0.001508170971646905, -0.16576682031154633, -0.03764438256621361, -0.007504723034799099, -0.0027839497197419405, -0.15770190954208374, -0.0732322707772