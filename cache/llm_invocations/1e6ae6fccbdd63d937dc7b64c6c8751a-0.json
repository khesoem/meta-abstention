{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define MOD 1000000007LL\n\nusing namespace std;\n\nstruct vec {\n  long long a[30];\n};\n\nstruct mat {\n  long long a[30][30];\n};\n\nlong long n, k;\n\nint val (long long um) {\n  if (um < k) return um;\n  return (um + val (um / k)) % k;\n}\n\nmat M[30], MI[30];\nmat E[200][40], EI[200][40];\nvec cur;\n\nmat mult (mat m1, mat m2) {\n  mat m3;\n  for (int i = 0; i < k; i++) {\n    for (int j = 0; j < k; j++) {\n      m3.a[i][j] = 0;\n      for (int l = 0; l < k; l++) {\n    m3.a[i][j] = (m3.a[i][j] + (m1.a[i][l] * m2.a[l][j]) % MOD) % MOD;\n      }\n    }\n  }\n  return m3;\n}\n\nvec mult (mat m, vec v) {\n  vec v2;\n  for (int i = 0; i < k; i++) {\n    v2.a[i] = 0;\n    for (int j = 0; j < k; j++) {\n      v2.a[i] = (v2.a[i] + (v.a[j] * m.a[i][j]) % MOD) % MOD;\n    }\n  }\n  return v2;\n}\n\nvoid pre_comp() {\n  for (int i = 0; i < k; i++) {\n    E[0][i] = M[i];\n    EI[0][i] = MI[i];\n  }\n  int LOG = 0;\n  long long t = n;\n  while (t > 0) {\n    LOG++;\n    t /= k;\n  }\n  for (int j = 1; j <= LOG; j++) {\n    E[j][0] = E[j - 1][0];\n    EI[j][0] = EI[j - 1][0];\n    for (int l = 1; l < k; l++) {\n      E[j][0] = mult (E[j - 1][l], E[j][0]);\n      EI[j][0] = mult (EI[j][0], EI[j - 1][l]);\n    }\n    for (int i = 1; i < k; i++) {\n      E[j][i] = mult (E[j - 1][i - 1], mult (E[j][i - 1], EI[j - 1][i - 1]));\n      EI[j][i] = mult (E[j - 1][i - 1], mult (EI[j][i - 1], EI[j - 1][i - 1]));\n    }\n  }\n}\n\nvec solve (long long n, vec v, int at) {\n  if (n == 0) return v;\n  int w = val (n / k);\n  v = solve (n / k, v, at + 1);\n  for (int i = 0; i < n % k; i++) {\n    v = mult (E[at][(w + i) % k], v);\n  }\n  return v;\n}\n\nint main() {\n  scanf (\"%lld %lld\", &n, &k);\n  for (int i = 0; i < k; i++) {\n    cur.a[i] = 1;\n    for (int j = 0; j < k; j++) {\n      for (int l = 0; l < k; l++) {\n    if (j == l) {\n      M[i].a[j][l] = 1;\n      MI[i].a[j][l] = 1;\n    }\n    else if (j == i) {\n      M[i].a[j][l] = 1;\n      MI[i].a[j][l] = -1;\n    }\n    else {\n      M[i].a[j][l] = 0;\n      MI[i].a[j][l] = 0;\n    }\n      }\n    }\n  }\n  pre_comp();\n  cur = solve (n, cur, 0);\n  long long tot = 0;\n  for (int i = 0; i < k; i++) {\n    tot = (tot + cur.a[i]) % MOD;\n  }\n  tot = (tot - 1 + MOD) % MOD;\n  while (tot % (k - 1) != 0) {\n    tot = (tot + MOD) % (MOD * (k - 1));\n  }\n  printf (\"%lld\\n\", tot / (k - 1));\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef val(um, k):\n    if um < k:\n        return um\n    return (um + val(um // k, k)) % k\n\ndef mat_mult(m1, m2, k):\n    m3 = [[0] * k for _ in range(k)]\n    for i in range(k):\n        for j in range(k):\n            m3[i][j] = 0\n            for l in range(k):\n                m3[i][j] = (m3[i][j] + (m1[i][l] * m2[l][j]) % MOD) % MOD\n    return m3\n\ndef vec_mult(m, v, k):\n    v2 = [0] * k\n    for i in range(k):\n        v2[i] = 0\n        for j in range(k):\n            v2[i] = (v2[i] + (v[j] * m[i][j]) % MOD) % MOD\n    return v2\n\ndef pre_comp(n, k, M, MI):\n    LOG = 0\n    t = n\n    while t > 0:\n        LOG += 1\n        t //= k\n    \n    E = [[[0] * k for _ in range(k)] for _ in range(LOG + 1)]\n    EI = [[[0] * k for _ in range(k)] for _ in range(LOG + 1)]\n    \n    for i in range(k):\n        E[0][i] = [row[:] for row in M[i]]\n        EI[0][i] = [row[:] for row in MI[i]]\n    \n    for j in range(1, LOG + 1):\n        E[j][0] = [row[:] for row in E[j-1][0]]\n        EI[j][0] = [row[:] for row in EI[j-1][0]]\n        for l in range(1, k):\n            E[j][0] = mat_mult(E[j-1][l], E[j][0], k)\n            EI[j][0] = mat_mult(EI[j][0], EI[j-1][l], k)\n        for i in range(1, k):\n            temp = mat_mult(E[j][i-1], EI[j-1][i-1], k)\n            E[j][i] = mat_mult(E[j-1][i-1], temp, k)\n            temp_ei = mat_mult(EI[j][i-1], EI[j-1][i-1], k)\n            EI[j][i] = mat_mult(EI[j-1][i-1], temp_ei, k)\n    \n    return E, EI, LOG\n\ndef solve(n, v, at, k, E, EI):\n    if n == 0:\n        return v\n    w = val(n // k, k)\n    v = solve(n // k, v, at + 1, k, E, EI)\n    for i in range(n % k):\n        v = vec_mult(E[at][(w + i) % k], v, k)\n    return v\n\ndef main():\n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    k = int(data[1])\n    \n    M = []\n    MI = []\n    for i in range(k):\n        mat_i = [[0] * k for _ in range(k)]\n        mat_i_inv = [[0] * k for _ in range(k)]\n        for j in range(k):\n            for l in range(k):\n                if j == l:\n                    mat_i[j][l] = 1\n                    mat_i_inv[j][l] = 1\n                elif j == i:\n                    mat_i[j][l] = 1\n                    mat_i_inv[j][l] = -1\n                else:\n                    mat_i[j][l] = 0\n                    mat_i_inv[j][l] = 0\n        M.append(mat_i)\n        MI.append(mat_i_inv)\n    \n    E, EI, LOG = pre_comp(n, k, M, MI)\n    \n    cur = [1] * k\n    cur = solve(n, cur, 0, k, E, EI)\n    \n    tot = 0\n    for i in range(k):\n        tot = (tot + cur[i]) % MOD\n    tot = (tot - 1 + MOD) % MOD\n    \n    # Handle division by (k-1) in modular arithmetic\n    # Since we need tot / (k-1) and tot is divisible by (k-1)\n    # We compute modular inverse of (k-1) modulo MOD\n    def mod_inverse(a, mod):\n        def extended_gcd(a, b):\n            if a == 0:\n                return b, 0, 1\n            gcd, x1, y1 = extended_gcd(b % a, a)\n            x = y1 - (b // a) * x1\n            y = x1\n            return gcd, x, y\n        \n        gcd, x, _ = extended_gcd(a % mod, mod)\n        if gcd != 1:\n            return -1  # Inverse doesn't exist\n        else:\n            return (x % mod + mod) % mod\n    \n    inv = mod_inverse(k - 1, MOD)\n    result = (tot * inv) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00017391123401466757, -7.152555099310121e-07, -4.768370445162873e-07, -0.19951188564300537, -0.00013457823661156, -6.01988795096986e-05, -0.006802259013056755, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.01603657566010952, 0.0, -1.5497195136049413e-06, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -2.825220326485578e-05, -0.16044172644615173, -0.27962779998779297, -0.18580299615859985, -1.311301275563892e-06, -0.5760774612426758, -8.344646857949556e-07, -0.0052597238682210445, -4.410734163684538e-06, -2.3841855067985307e-07, -5.722029527532868e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -9.536738616588991e-07, -2.3841855067985307e-07, 0.0, -1.8000440832111053e-05, -8.761498611420393e-05, -1.1920928244535389e-07, -3.5523738915799186e-05, -1.9073468138230965e-06, -8.344646857949556e-07, -7.986990567587782e-06, -2.9802276912960224e-06, -3.6954811548639555e-06, -2.3841830625315197e-06, -1.311301275563892e-06, -2.3841855067985307e-07, -3.6954811548639555e-06, -3.576278118089249e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07