] > dist[u] + w) {\n                dist[v] = dist[u] + w;\n                prevV[v] = u;\n                prevE[v] = idx;\n                if (!inQ[v]) {\n                    inQ[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n}\n\nvoid augmentFlow() {\n    findShortestPath();\n    if (dist[sink] >= INF) return;\n    \n    int cur = sink;\n    while (cur != source) {\n        int idx = prevE[cur];\n        edgeVec[idx].flow++;\n        edgeVec[idx ^ 1].flow--;\n        cur = prevV[cur];\n    }\n    minCost += dist[sink];\n}\n\nvoid addConnection(int u, int v, int cap, int cost) {\n    adj[u].push_back(edgeVec.size());\n    edgeVec.emplace_back(u, v, cap, 0, cost);\n    adj[v].push_back(edgeVec.size());\n    edgeVec.emplace_back(v, u, 0, 0, -cost);\n}\n\nint n, m, k, c, d;\nconst int TIME_LAYERS = 101;\n\nvoid initialize() {\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    \n    for (int i = 0; i < k; ++i) {\n        int x; scanf(\"%d\", &x); --x;\n        addConnection(source, x, 1, 0);\n    }\n    \n    for (int t = 0; t < TIME_LAYERS; ++t) {\n        addConnection(t * n, sink, k, t * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int u, v; scanf(\"%d %d\", &u, &v); --u, --v;\n        for (int t = 0; t < TIME_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addConnection(u + t * n, v + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < TIME_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addConnection(v + t * n, u + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n    }\n}\n\nvoid execute() {\n    for (int t = 0; t < TIME_LAYERS - 1; ++t) {\n        for (int i = 0; i < n; ++i) {\n            addConnection(i + t * n, i + (t + 1) * n, k, 0);\n        }\n    }\n    \n    for (int i = 0; i < k; ++i) {\n        augmentFlow();\n    }\n    \n    printf(\"%lld\\n\", minCost);\n}\n\nint main() {