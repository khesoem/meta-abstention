    curr = mat_mult(prev, base[lvl - 1, i], k_val)\n            prefix.append(curr)\n\n        for sh in range(k_val):\n            base[lvl, sh] = prefix[0][:]\n            for i in range(k_val - sh):\n                base[lvl, sh] = mat_mult(base[lvl, sh], base[lvl - 1, (i + sh) % k_val], k_val)\n            base[lvl, sh] = mat_mult(base[lvl, sh], prefix[sh], k_val)\n\n    # Initialize dp matrix\n    dp = [[0] * (k_val + 1) for _ in range(k_val + 1)]\n    dp[0][k_val] = 1\n\n    rem = 0\n    for i in range(len(digits) - 1, -1, -1):\n        while digits[i] > 0:\n            dp = mat_mult(dp, base.get((i, rem), [[1 if j == t else 0 for t in range(k_val + 1)] for j in range(k_val + 1)]), k_val)\n            rem = (rem + 1) % k_val\n            digits[i] -= 1\n\n    ans = 0\n    for i in range(k_val + 1):\n        ans = add_mod(ans, dp[0][i])\n    print(ans)\n\ndef main():\n    while True:\n        n_val, k_val = read_input()\n        if n_val is None:\n            break\n        solve_case(n_val, k_val)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00025412190007045865, -2.3841830625315197e-06, -1.1920922133867862e-06, -0.10075782984495163, -0.00011062010162277147, -0.005259842611849308, -0.2017040252685547, -1.1920928244535389e-07, -7.152555099310121e-07, 0.0, -9.536738616588991e-07, -0.0001401803019689396, 0.0, -2.825220326485578e-05, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, -1.1920928244535389e-07, -5.602820692729438e-06, -0.0031787839252501726, -6.794906312279636e-06, -2.145764938177308e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.160317621426657e-05, -3.3854863431770355e-05, -0.012968719936907291, -0.17117543518543243, -1.1444026313256472e-05, -0.00013219437096267939, -2.50339189733495e-06, -0.4054071009159088, -3.576278118089249e-07, -0.004091464448720217, -1.4305104514278355e-06, -8.201262971851975e-05, -0.02630683407187462, -0.57594