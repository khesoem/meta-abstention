nt();\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                g[i][j] = sc.nextInt();\n                g[i][j] = (int)((g[i][j] * 1L * E100) % MOD);\n            }\n        }\n        for (int i = 1; i < (1<<n); ++i) {\n            bitcnt[i] = bitcnt[i ^ (i & -i)] + 1;\n        }\n        for (int i = 0; i <= MAXN; ++i) {\n            S[i] = new ArrayList<>();\n        }\n        for (int i = 0; i < (1<<n); ++i) {\n            id[i] = S[bitcnt[i]].size();\n            S[bitcnt[i]].add(i);\n        }\n        for (int i = 1; i < (1<<n); ++i) {\n            for (int j = 0; j < (1<<n); ++j) {\n                long val = 0;\n                for (int k = 0; k < n; ++k) {\n                    if ((i & (1<<k)) != 0 && (j & (1<<k)) == 0) {\n                        val |= 1L << id[j | (1<<k)];\n                    }\n                }\n                nxt[i][j] = val;\n            }\n        }\n        for (int i = 0; i < n; ++i) {\n            dp[i] = new HashMap<>();\n        }\n        int ans = solve(0, 1L);\n        ans = (ans % MOD + MOD) % MOD;\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, 0.0, 0.0, -4.1960789531003684e-05, -1.764281842042692e-05, -1.1920928244535389e-07, -8.582700684200972e-05, -0.06215460225939751, -0.00012563870404846966, 0.0, -6.318072337307967e-06, -0.0002051381452474743, -4.768360213347478e-06, -0.0003883084573317319, -2.753696753643453e-05, 0.0, -0.029750416055321693, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -1.0251946150674485e-05, 0.0, -1.1920928244535389e-07, -1.7881377516459906e-06, -3.540453326422721e-05, 0.0, 0.0, -0.002477435627952218, -0.25192922353744507, -9.536738616588991e-07, 0.0, -4.768360213347478e-06, -9.619726915843785e-05, 0.0, -2.7656173188006505e-05, -7.152531907195225e-06, -0.0031777145341038704, -2.3841855067985307e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0