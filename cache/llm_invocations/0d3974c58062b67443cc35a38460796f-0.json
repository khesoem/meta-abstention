{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static class Task {\n        // Use a single Edge class for both flows (with all fields)\n        static class Edge {\n            int to, rev, cap, flow, cost;\n            Edge(int to, int rev, int cap, int cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n        static List<Edge>[] graph;\n        static int n;\n\n        // Dinic max flow (ignores cost)\n        static boolean bfs(int src, int dest, int[] dist) {\n            Arrays.fill(dist, -1);\n            dist[src] = 0;\n            int[] q = new int[n];\n            int qs = 0;\n            q[qs++] = src;\n            for (int i = 0; i < qs; i++) {\n                int u = q[i];\n                for (Edge e : graph[u]) {\n                    if (dist[e.to] < 0 && e.flow < e.cap) {\n                        dist[e.to] = dist[u] + 1;\n                        q[qs++] = e.to;\n                    }\n                }\n            }\n            return dist[dest] >= 0;\n        }\n        static long dfs(int[] ptr, int[] dist, int dest, int u, long f) {\n            if (u == dest) return f;\n            for (; ptr[u] < graph[u].size(); ++ptr[u]) {\n                Edge e = graph[u].get(ptr[u]);\n                if (dist[e.to] == dist[u] + 1 && e.flow < e.cap) {\n                    long df = dfs(ptr, dist, dest, e.to, Math.min(f, e.cap - e.flow));\n                    if (df > 0) {\n                        e.flow += df;\n                        graph[e.to].get(e.rev).flow -= df;\n                        return df;\n                    }\n                }\n            }\n            return 0;\n        }\n        static long maxFlow(int src, int dest) {\n            long flow = 0;\n            int[] dist = new int[n];\n            while (bfs(src, dest, dist)) {\n                int[] ptr = new int[n];\n                while (true) {\n                    long df = dfs(ptr, dist, dest, src, Long.MAX_VALUE);\n                    if (df == 0) break;\n                    flow += df;\n                }\n            }\n            return flow;\n        }\n\n        // Min-cost flow (Bellman-Ford with queue)\n        static void bellmanFord(int s, int[] dist, int[] prevNode, int[] prevEdge, int[] curFlow) {\n            Arrays.fill(dist, 0, n, Integer.MAX_VALUE);\n            dist[s] = 0;\n            curFlow[s] = Integer.MAX_VALUE;\n            boolean[] inQ = new boolean[n];\n            int[] q = new int[n];\n            int qt = 0;\n            q[qt++] = s;\n            for (int qh = 0; (qh - qt) % n != 0; qh++) {\n                int u = q[qh % n];\n                inQ[u] = false;\n                for (int i = 0; i < graph[u].size(); i++) {\n                    Edge e = graph[u].get(i);\n                    if (e.flow >= e.cap) continue;\n                    int v = e.to;\n                    int nd = dist[u] + e.cost;\n                    if (dist[v] > nd) {\n                        dist[v] = nd;\n                        prevNode[v] = u;\n                        prevEdge[v] = i;\n                        curFlow[v] = Math.min(curFlow[u], e.cap - e.flow);\n                        if (!inQ[v]) {\n                            inQ[v] = true;\n                            q[qt++ % n] = v;\n                        }\n                    }\n                }\n            }\n        }\n        static int[] minCostFlow(int s, int t, int maxf) {\n            int[] dist = new int[n];\n            int[] curFlow = new int[n];\n            int[] prevEdge = new int[n];\n            int[] prevNode = new int[n];\n            int flow = 0, cost = 0;\n            while (flow < maxf) {\n                bellmanFord(s, dist, prevNode, prevEdge, curFlow);\n                if (dist[t] == Integer.MAX_VALUE) break;\n                int df = Math.min(curFlow[t], maxf - flow);\n                flow += df;\n                for (int v = t; v != s; v = prevNode[v]) {\n                    Edge e = graph[prevNode[v]].get(prevEdge[v]);\n                    e.flow += df;\n                    graph[v].get(e.rev).flow -= df;\n                    cost += df * e.cost;\n                }\n            }\n            return new int[]{flow, cost};\n        }\n\n        public void solve(Scanner sc, PrintWriter pw) throws IOException {\n            int N = sc.nextInt();\n            int M = sc.nextInt();\n            int K = sc.nextInt();\n            int C = sc.nextInt();\n            int D = sc.nextInt();\n            int[] pos = new int[N];\n            for (int i = 0; i < K; i++) pos[sc.nextInt() - 1]++;\n            int T = 100;\n            n = (T + 1) * N + 2;\n            graph = new List[n];\n            for (int i = 0; i < n; i++) graph[i] = new ArrayList<>();\n            // Add edges\n            for (int i = 0; i < N; i++) if (pos[i] > 0) addEdge(0, i + 1, pos[i], 0);\n            for (int i = 0; i < T; i++) for (int j = 0; j < N; j++) addEdge(1 + i * N + j, 1 + (i + 1) * N + j, K, 0);\n            for (int i = 0; i <= T; i++) for (int j = 1; j <= K; j++) addEdge(1 + i * N, (T + 1) * N + 1, 1, C * i);\n            for (int i = 0; i < M; i++) {\n                int a = sc.nextInt() - 1, b = sc.nextInt() - 1;\n                for (int j = 0; j < T; j++) {\n                    int cost = 0;\n                    for (int l = 1; l <= K; l++) {\n                        addEdge(1 + j * N + a, 1 + (j + 1) * N + b, 1, l * l * D - cost);\n                        addEdge(1 + j * N + b, 1 + (j + 1) * N + a, 1, l * l * D - cost);\n                        cost = l * l * D;\n                    }\n                }\n            }\n            int[] res = minCostFlow(0, (T + 1) * N + 1, K);\n            System.err.println(res[0]);\n            pw.println(res[1]);\n        }\n        void addEdge(int s, int t, int cap, int cost) {\n            graph[s].add(new Edge(t, graph[t].size(), cap, cost));\n            graph[t].add(new Edge(s, graph[s].size() - 1, 0, -cost));\n        }\n    }\n\n    static long TIME_START, TIME_END;\n\n    public static void main(String[] args) throws IOException {\n        Scanner sc = new Scanner(System.in);\n        PrintWriter pw = new PrintWriter(new BufferedOutputStream(System.out));\n        Runtime rt = Runtime.getRuntime();\n        long memBefore = rt.totalMemory() - rt.freeMemory();\n        TIME_START = System.currentTimeMillis();\n        new Task().solve(sc, pw);\n        TIME_END = System.currentTimeMillis();\n        long memAfter = rt.totalMemory() - rt.freeMemory();\n        pw.close();\n        System.err.println(\"Memory increased: \" + (memAfter - memBefore) / 1000000);\n        System.err.println(\"Time used: \" + (TIME_END - TIME_START) + \".\");\n    }\n\n    static class Scanner {\n        StringTokenizer st;\n        BufferedReader br;\n        Scanner(InputStream s) { br = new BufferedReader(new InputStreamReader(s)); }\n        Scanner(FileReader s) throws FileNotFoundException { br = new BufferedReader(s); }\n        String next() throws IOException {\n            while (st == null || !st.hasMoreTokens()) st = new StringTokenizer(br.readLine());\n            return st.nextToken();\n        }\n        int nextInt() throws IOException { return Integer.parseInt(next()); }\n        long nextLong() throws IOException { return Long.parseLong(next()); }\n        String nextLine() throws IOException { return br.readLine(); }\n        double nextDouble() throws IOException { return Double.parseDouble(next()); }\n        boolean ready() throws IOException { return br.ready(); }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.flow = 0\n        self.cost = cost\n\ndef add_edge(graph, s, t, cap, cost):\n    graph[s].append(Edge(t, len(graph[t]), cap, cost))\n    graph[t].append(Edge(s, len(graph[s]) - 1, 0, -cost))\n\ndef bellman_ford(graph, n, s, dist, prev_node, prev_edge, cur_flow):\n    INF = 10**18\n    dist[:] = [INF] * n\n    dist[s] = 0\n    cur_flow[s] = INF\n    in_q = [False] * n\n    q = deque()\n    q.append(s)\n    in_q[s] = True\n    while q:\n        u = q.popleft()\n        in_q[u] = False\n        for i, e in enumerate(graph[u]):\n            if e.flow >= e.cap:\n                continue\n            v = e.to\n            nd = dist[u] + e.cost\n            if dist[v] > nd:\n                dist[v] = nd\n                prev_node[v] = u\n                prev_edge[v] = i\n                cur_flow[v] = min(cur_flow[u], e.cap - e.flow)\n                if not in_q[v]:\n                    in_q[v] = True\n                    q.append(v)\n\ndef min_cost_flow(graph, n, s, t, maxf):\n    INF = 10**18\n    dist = [0] * n\n    cur_flow = [0] * n\n    prev_node = [0] * n\n    prev_edge = [0] * n\n    flow = 0\n    cost = 0\n    while flow < maxf:\n        bellman_ford(graph, n, s, dist, prev_node, prev_edge, cur_flow)\n        if dist[t] == INF:\n            break\n        df = min(cur_flow[t], maxf - flow)\n        flow += df\n        v = t\n        while v != s:\n            u = prev_node[v]\n            e = graph[u][prev_edge[v]]\n            e.flow += df\n            graph[v][e.rev].flow -= df\n            cost += df * e.cost\n            v = u\n    return [flow, cost]\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    pos = [0] * N\n    for _ in range(K):\n        p = int(next(it)) - 1\n        pos[p] += 1\n    T = 100\n    n = (T + 1) * N + 2\n    graph = [[] for _ in range(n)]\n    # source to initial positions\n    for i in range(N):\n        if pos[i] > 0:\n            add_edge(graph, 0, i + 1, pos[i], 0)\n    # stay edges\n    for i in range(T):\n        for j in range(N):\n            add_edge(graph, 1 + i * N + j, 1 + (i + 1) * N + j, K, 0)\n    # sink edges\n    for i in range(T + 1):\n        for _ in range(1, K + 1):\n            add_edge(graph, 1 + i * N, (T + 1) * N + 1, 1, C * i)\n    # road edges\n    for _ in range(M):\n        a = int(next(it)) - 1\n        b = int(next(it)) - 1\n        for j in range(T):\n            cost_acc = 0\n            for l in range(1, K + 1):\n                add_edge(graph, 1 + j * N + a, 1 + (j + 1) * N + b, 1, l * l * D - cost_acc)\n                add_edge(graph, 1 + j * N + b, 1 + (j + 1) * N + a, 1, l * l * D - cost_acc)\n                cost_acc = l * l * D\n    res = min_cost_flow(graph, n, 0, (T + 1) * N + 1, K)\n    print(res[1], file=sys.stdout)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1801649634435307e-05, -3.576278118089249e-07, 0.0, -5.304672595229931e-05, -0.0002708