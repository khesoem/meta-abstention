{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.InputStream;\nimport java.io.OutputStream;\nimport java.io.IOException;\nimport java.io.PrintWriter;\nimport java.io.InputStreamReader;\nimport java.util.StringTokenizer;\nimport java.io.BufferedReader;\nimport java.util.stream.Stream;\nimport java.util.stream.LongStream;\n\npublic class Main {\n    static final long MOD = 998244353L;\n    static long[] fact;\n    static long[] invFact;\n\n    public static void main(String[] args) {\n        InputStream inputStream = System.in;\n        OutputStream outputStream = System.out;\n        InputReader in = new InputReader(inputStream);\n        PrintWriter out = new PrintWriter(outputStream);\n        solve(in, out);\n        out.close();\n    }\n\n    static void solve(InputReader in, PrintWriter out) {\n        int n = in.nextInt();\n        int m = in.nextInt();\n        int N = n + m;\n        precompute(N);\n\n        long phaseSize = Stream.iterate(new long[]{1, 0}, state -> {\n            long p = state[0];\n            long i = state[1];\n            long nextP = (i < n) ? p * (n - i) % MOD * smallInverse((int) (N - i)) % MOD : 0;\n            return new long[]{nextP, i + 1};\n        }).limit((long) n + 1).mapToLong(state -> state[0]).reduce(0L, Main::add);\n\n        long answer = LongStream.rangeClosed(1, n)\n                .mapToLong(k -> {\n                    long sign = ((k & 1) == 1) ? 1 : MOD - 1;\n                    return mul(sign, ncr(n, (int) k), m + k, smallInverse((int) k), phaseSize);\n                })\n                .reduce(0L, Main::add);\n\n        out.println(answer);\n    }\n\n    static void precompute(int N) {\n        fact = new long[N + 1];\n        invFact = new long[N + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= N; i++) {\n            fact[i] = fact[i - 1] * i % MOD;\n        }\n        invFact[N] = modPow(fact[N], MOD - 2);\n        for (int i = N; i >= 1; i--) {\n            invFact[i - 1] = invFact[i] * i % MOD;\n        }\n    }\n\n    static long modPow(long a, long e) {\n        long res = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) res = res * a % MOD;\n            a = a * a % MOD;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static long smallInverse(int x) {\n        return invFact[x] * fact[x - 1] % MOD;\n    }\n\n    static long ncr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n    }\n\n    static long mul(long... vals) {\n        long res = 1;\n        for (long v : vals) res = res * v % MOD;\n        return res;\n    }\n\n    static long add(long a, long b) {\n        long res = a + b;\n        return res >= MOD ? res - MOD : res;\n    }\n\n    static class InputReader {\n        public final BufferedReader reader;\n        public StringTokenizer tokenizer;\n\n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream), 32768);\n            tokenizer = null;\n        }\n\n        public String next() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\nfact = []\ninv_fact = []\n\ndef precompute(N):\n    global fact, inv_fact\n    fact = [1] * (N + 1)\n    for i in range(1, N + 1):\n        fact[i] = fact[i-1] * i % MOD\n    inv_fact = [1] * (N + 1)\n    inv_fact[N] = pow(fact[N], MOD - 2, MOD)\n    for i in range(N, 0, -1):\n        inv_fact[i-1] = inv_fact[i] * i % MOD\n\ndef small_inverse(x):\n    return inv_fact[x] * fact[x-1] % MOD\n\ndef ncr(n, r):\n    if r < 0 or r > n:\n        return 0\n    return fact[n] * inv_fact[r] % MOD * inv_fact[n-r] % MOD\n\ndef mul(*vals):\n    res = 1\n    for v in vals:\n        res = res * v % MOD\n    return res\n\ndef add(a, b):\n    res = a + b\n    return res - MOD if res >= MOD else res\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n    N = n + m\n    precompute(N)\n\n    # compute phaseSize: sum over i=0..n of p_i where p_0=1, p_{i+1}=p_i * (n-i) * small_inverse(N-i) if i<n else 0\n    phase_size = 0\n    p = 1\n    for i in range(0, n+1):\n        phase_size = add(phase_size, p)\n        if i < n:\n            p = p * (n - i) % MOD * small_inverse(N - i) % MOD\n        else:\n            p = 0\n\n    answer = 0\n    for k in range(1, n+1):\n        sign = 1 if (k & 1) == 1 else MOD - 1\n        term = mul(sign, ncr(n, k), m + k, small_inverse(k), phase_size)\n        answer = add(answer, term)\