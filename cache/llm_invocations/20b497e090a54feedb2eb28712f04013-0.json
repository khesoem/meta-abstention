ue<Integer> q = new LinkedList<>();\n        q.add(s);\n        incf[s] = INF;\n        inq[s] = true;\n        dis[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            for (int i = hed[u]; i != 0; i = nxt[i]) {\n                if (val[i] == 0 || dis[to[i]] <= dis[u] + w[i]) continue;\n                dis[to[i]] = dis[u] + w[i];\n                incf[to[i]] = Math.min(incf[u], val[i]);\n                pre[to[i]] = i;\n                if (!inq[to[i]]) {\n                    inq[to[i]] = true;\n                    q.add(to[i]);\n                }\n            }\n        }\n        return dis[t] != INF;\n    }\n\n    static void update() {\n        int tmp = t;\n        while (tmp != s) {\n            int i = pre[tmp];\n            val[i] -= incf[t];\n            val[i ^ 1] += incf[t];\n            tmp = to[i ^ 1];\n        }\n        ans += incf[t] * dis[t];\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n        t = (n + k - 1) * n + 1;\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 1; i <= k; i++) {\n            int x = Integer.parseInt(st.nextToken());\n            add(s, x, 1, 0);\n        }\n\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            for (int j = 1; j <= n + k; j++) {\n                for (int h = 1; h <= k; h++) {\n                    add(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n          