ic class Main {\n    static class Edge {\n        int to, next, val, w;\n        Edge(int to, int next, int val, int w) {\n            this.to = to;\n            this.next = next;\n            this.val = val;\n            this.w = w;\n        }\n    }\n\n    static class FlowResult {\n        int c, f;\n        FlowResult(int c, int f) {\n            this.c = c;\n            this.f = f;\n        }\n    }\n\n    static final int N = 5005;\n    static final int INF = (int)1e9;\n\n    static int n, m, k, c_val, d_val, s, t, tot;\n    static int[] head, pre, dis;\n    static boolean[] vis;\n    static Edge[] e;\n    static List<int[]> edges;\n    static int edge_id;\n\n    static void add_edge(int u, int v, int val, int w) {\n        edge_id++;\n        e[edge_id] = new Edge(v, head[u], val, w);\n        head[u] = edge_id;\n    }\n\n    static void add(int u, int v, int val, int w) {\n        add_edge(u, v, val, w);\n        add_edge(v, u, 0, -w);\n    }\n\n    static boolean SPFA() {\n        Arrays.fill(dis, 1, tot + 1, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        dis[s] = 0;\n        Arrays.fill(vis, false);\n        vis[s] = true;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != 0; i = e[i].next) {\n                int v = e[i].to;\n                if (e[i].val > 0 && dis[v] > dis[u] + e[i].w) {\n                    dis[v] = dis[u] + e[i].w;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return dis[t] < INF;\n    }\n\n    static FlowResult mcmf() {\n        FlowResult res = new FlowResult(0, 0);\n        while (SPFA()) {\n            int flow = INF;\n            for (int x = t; x != s; x = e[pre[x] ^ 1].to) {\n                flow = Math.min(flow, e[pre[x]].val);\n            }\n            for (int x = t; x != s; x = e[pre[x] ^ 1].to) {\n                e[pre[x]].val -= flow;\n                e[pre[x] ^ 1].val += flow;\n            }\n            res.f += flow;\n            res.c += dis[t] * flow;\n        }\n        return res;\n    }\n\n    static int P(int i, int j) {\n        return i * n + j;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c_val = sc.nextInt();\n        d_val = sc.nextInt();\n        \n        int cs = 2 * k;\n        tot = cs * n;\n        s = ++tot;\n        t = ++tot;\n\n        head = new int[tot + 10];\n        pre = new int[tot + 10];\n        dis = new int[tot + 10];\n        vis = new boolean[tot + 10];\n        e = new Edge[8 * N * (int)Math.sqrt(N) + 10];\n        edges = new ArrayList<>();\n\n        for (int i = 1; i <= k; i++) {\n            int tp = sc.nextInt();\n            add(s, P(0, tp), 1, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            edges.add(new int[]{u, v});\n        }\n\n        for (int i = 1; i <= cs - 1; i++) {\n            add(P(i, 1), t, k, c_val * i);\n            for (int j = 1; j <= n; j++) {\n                add(P(i - 1, j), P(i, j), k, 0);\n            }\n            for (int[] edge : edges) {\n                int u = edge[0], v = edge[1];\n                for (int t_val = 1; t_val <= k; t_val++) {\n                    add(P(i - 1, u), P(i, v), 1, (2 * t_val - 1) * d_val);\n                    add(P(i - 1, v), P(i, u), 1, (2 * t_val - 1) * d_val);\n                }\n            }\n        }\n\n        System.out.println(mcmf().c);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001234931987710297, -2.0265558760002023e-06, -7.152555099310121e-07, -0.0012425805907696486, -3