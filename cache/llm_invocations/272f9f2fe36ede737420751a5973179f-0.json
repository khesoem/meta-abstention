ounds(nx, ny, grid) || dist[nx][ny] != INF) continue;\n                dist[nx][ny] = dist[x][y] + 1;\n                dq.add(new int[]{nx, ny});\n            }\n        }\n        return dist;\n    }\n    \n    static void inputHandling() {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int T = sc.nextInt();\n        List<String> g1 = new ArrayList<>();\n        List<String> g2 = new ArrayList<>();\n        for (int i = 0; i < N; i++) g1.add(sc.next());\n        for (int i = 0; i < N; i++) g2.add(sc.next());\n        \n        int rx = -1, ry = -1;\n        for (int i = 0; i < N; i++) {\n            for (int j = 0; j < N; j++) {\n                if (g1.get(i).charAt(j) == 'Z') {\n                    rx = i;\n                    ry = j;\n                }\n            }\n        }\n        \n        long[][] distFromReactor = bfsSearch(rx, ry, g1);\n        \n        for (int i = 0; i < N; i++) {\n            for (int j = 0; j < N; j++) {\n                if (!inBounds(i, j, g1)) continue;\n                long[][] distFromSource = bfsSearch(i, j, g1);\n                \n                for (int x = 0; x < N; x++) {\n                    for (int y = 0; y < N; y++) {\n                        if (!inBounds(x, y, g1) ||\n                            distFromSource[x][y] > T ||\n                            distFromSource[x][y] > distFromReactor[x][y])\n                            continue;\n                        \n                        if (distFromSource[x][y] == distFromReactor[x][y]) {\n                            boolean canEscape = false;\n                            for (int d = 0; d < 4; d++) {\n                                int nx = x + dx[d], ny = y + dy[d];\n                                if (!inBounds(nx, ny, g1) ||\n                                    distFromSource[nx][ny] >= distFromReactor[nx][ny])\n                                    continue;\n                                canEscape = true;\n                            }\n                            if (!canEscape) continue;\n                        }\n                        \n                        int c1 = g1.get(i).charAt(j) - '0';\n                        int c2 = g2.get(x).charAt(y) - '0';\n                        for (int u = 1; u <= c1; u++) {\n                            for (int v = 1; v <= c2; v++) {\n                                int node1 = 100 * i + 10 * j + u;\n                                int node2 = 100 * x + 10 * y + v;\n                                if (adj[node1] == null) adj[node1] = new ArrayList<>();\n                                adj[node1].add(node2);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    \n    static boolean augment(int u) {\n        if (visited[u]) return false;\n        visited[u] = true;\n        if (adj[u] != null) {\n            for (int v : adj[u]) {\n                if (match[v] == 0 || augment(match[v])) {\n                    match[v] = u;\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n    \n    static void computeMatching() {\n        inputHandling();\n        int maxNodes = 1000;\n        int matchingSize = 0;\n        for (int i = 0; i < maxNodes; i++) {\n            Arrays.fill(visited, false);\n            if (augment(i)) matchingSize++;\n        }\n        System.out.println(matchingSize);\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        computeMatching();\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00012313561455812305, -1.7881377516459906e-06, -4.768370445162873e-07, -0.000699156429618597, -6.341733387671411e-05, -0.14268025755882263, -0.4741075038909912, -0.00035041390219703317, -1.3351351299206726e-05, -4.6132929128361866e-05, -0.0004217927053105086, -0.000390215078368783, -1.0728830375228426e-06,