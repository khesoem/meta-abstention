y);\n        }\n    }\n    return dist;\n}\n\nvoid input_handling() {\n    int N, T;\n    cin >> N >> T;\n    vector<string> g1(N), g2(N);\n    for (int i = 0; i < N; ++i) cin >> g1[i];\n    for (int i = 0; i < N; ++i) cin >> g2[i];\n\n    int rx = -1, ry = -1;\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (g1[i][j] == 'Z') rx = i, ry = j;\n        }\n    }\n\n    auto dist_from_reactor = bfs_search(rx, ry, g1);\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (!in_bounds(i, j, g1)) continue;\n            auto dist_from_source = bfs_search(i, j, g1);\n\n            for (int x = 0; x < N; ++x) {\n                for (int y = 0; y < N; ++y) {\n                    if (!in_bounds(x, y, g1) ||\n                        dist_from_source[x][y] > T ||\n                        dist_from_source[x][y] > dist_from_reactor[x][y])\n                        continue;\n\n                    if (dist_from_source[x][y] == dist_from_reactor[x][y]) {\n                        bool can_escape = false;\n                        for (int d = 0; d < 4; ++d) {\n                            int nx = x + dx[d], ny = y + dy[d];\n                            if (!in_bounds(nx, ny, g1) ||\n                                dist_from_source[nx][ny] >= dist_from_reactor[nx][ny])\n                                continue;\n                            can_escape = true;\n                        }\n                        if (!can_escape) continue;\n                    }\n\n                    int c1 = g1[i][j] - '0';\n                    int c2 = g2[x][y] - '0';\n                    for (int u = 1; u <= c1; ++u) {\n                        for (int v = 1; v <= c2; ++v) {\n                            adj[100 * i + 10 * j + u].push_back(100 * x + 10 * y + v);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\nbool augment(int u) {\n    if (visited[u]) return false;\n  