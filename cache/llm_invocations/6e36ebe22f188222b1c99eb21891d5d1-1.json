 = 0; i < 100; ++i) {\n                sum[i + 1] = p + sum[i];\n                pw[i] = p;\n                p *= w;\n                if (p > 1L << 40) {\n                    mx = i;\n                    break;\n                }\n            }\n            process(0, m, mx);\n            out.println(OK ? \"YES\" : \"NO\");\n        }\n\n        void process(long cur, long target, int pos) {\n            //System.out.println(\"cur = \" + cur + \" pos = \" + pos);\n\n            if (cur == target) {\n                OK = true;\n                return;\n            }\n            long remaining = sum[pos + 1];\n            long next = pw[pos];\n\n            //System.out.println(\"remaining = \" + remaining + \" next = \" + next);\n            if (cur - remaining > target) {\n            } else if (cur + remaining < target) {\n            } else {\n                if (cur + sum[pos] < target) {\n                    process(cur + next, target, pos - 1);\n                } else if (cur - sum[pos] > target) {\n                    process(cur - next, target, pos - 1);\n                } else {\n                    process(cur, target, pos - 1);\n                }\n            }\n        }\n\n    }\n\n    static class InputReader {\n        private BufferedReader reader;\n        private StringTokenizer tokenizer = new StringTokenizer(\"\");\n\n        public InputReader(InputStream inputStream) {\n            this.reader = new BufferedReader(\n                    new InputStreamReader(inputStream));\n        }\n\n        public String next() {\n            while (!tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public long nextLong() {\n            return Long.parseLong(next());\n        }\n\n    }\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport io\n\nclass InputReader:\n    def __init__(self, inputStream):\n        self.reader = io.BufferedReader(io.InputStreamReader(inputStream))\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readLine()\n                if line is None:\n                    return None\n                self.tokenizer = line.split()\n            except Exception as e:\n                print(e)\n        return self.tokenizer.pop(0)\n\n    def nextLong(self):\n        return int(self.next())\n\nclass TaskC:\n    def __init__(self):\n        self.sum = [0] * 105\n        self.pw = [0] * 105\n        self.OK = False\n\n    def solve(self, testNumber, in_reader, out):\n        w = in_reader.nextLong()\n        m = in_reader.nextLong()\n        p = 1\n        mx = 0\n        for i in range(100):\n            self.sum[i + 1] = p + self.sum[i]\n            self.pw[i] = p\n            p *= w\n            if p > 1 << 40:\n                mx = i\n                break\n        self.process(0, m, mx)\n        out.println(\"YES\" if self.OK else \"NO\")\n\n    def process(self, cur, target, pos):\n        if cur == target:\n            self.OK = True\n            return\n        \n        remaining = self.sum[pos + 1]\n        next_val = self.pw[pos]\n\n        if cur - remaining > target:\n            pass\n        elif cur + remaining < target:\n            pass\n        else:\n            if cur + self.sum[pos] < target:\n                self.process(cur + next_val, target, pos - 1)\n            elif cur - self.sum[pos] > target:\n                self.process(cur - next_val, target, pos - 1)\n            else:\n                self.process(cur, target, pos - 1)\n\nclass PrintWriter:\n    def __init__(self, outputStream):\n        self.outputStream = outputStream\n        self.buffer = []\n\n    def println(self, line):\n        self.outputStream.write((line + \"\\n\").encode())\n\n    def close(self):\n        self.outputStream.flush()\n\ndef main():\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out = PrintWriter(outputStream)\n    solver = TaskC()\n    solver.solve(1, in_reader, out)\n    out.close()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-5.7338023907504976e-05, -7.152555099310121e-07, -5.960462772236497e-07, -0.00015484087634831667, -0.00032848684350028634, -0.1797884702682495, -0.4288806915283203, -0.13433469831943512, -0.17977552115917206, -0.06223424896597862, -0.115351602435112, -1.5497195136049413e-06, -2.7418097943154862e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -7.986990567587782e-06, -2.264974000354414e-06, -3.576278118089249e-07, -3.099436753473128e-06, 0.0, -0.004299800843000412, -5.8412379075889476e-06, -1.9073468138230965e-06, -1.6689286894688848e-06, -0.00015043080202303827, -1.1920928244535389e-07, -4.2676016164477915e-05, -0.5345213413238525, -0.00225242436863482, -0.40667951107025146, -0.00020823694649152458, -0.00026008085114881396, -2.0265558760002023e-06, -3.933898824470816e-06, -0.00017248096992261708, -6.198863957251888e-06, -1.1920928244535389e-07, -0.7866466045379639, -0.35177233815193176, -1.0609570381348021e-05, -2.145764938177308e-06, -0.023728331550955772, -0.00030357998912222683, -3.242440288886428e-05, -4.768370445162873e-07, -3.015949550899677e-05, -5.340433563105762e-05, -2.145764938177308e-06, -2.0265558760002023e-06, -2.3841830625315197e-06, -2.861018856492592e-06, -8.344646857949556e-07, -0.0006277974462136626, -0.006742583122104406, -5.8412379075889476e-06, -9.536738616588991e-07, -0.13483349978923798, -3.3378546504536644e-06, -0.006730742286890745, -9.536738616588991e-07, -5.9604467