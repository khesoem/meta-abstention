ot ((j >> i) & 1):\n                    new_j = j | (1 << i)\n                    derived[i] |= (cur >> j) & 1 << new_j\n        \n        for mask in range(1 << N):\n            next_state = cur\n            for bit in range(N):\n                if (mask >> bit) & 1:\n                    next_state |= derived[bit]\n            \n            if next_state not in state_index:\n                new_id = len(state_index)\n                state_index[next_state] = new_id\n                index_state.append(next_state)\n                bfs_queue.append((next_state, new_id))\n    \n    total_states = len(state_index)\n    trans = [[0] * (1 << N) for _ in range(total_states)]\n    \n    for i in range(total_states):\n        cur = index_state[i]\n        derived = [0] * N\n        for j in range(N):\n            for k in range(1 << N):\n                if not ((k >> j) & 1):\n                    new_k = k | (1 << j)\n                    derived[j] |= (cur >> k) & 1 << new_k\n        \n        for mask in range(1 << N):\n            next_state = cur\n            for bit in range(N):\n                if (mask >> bit) & 1:\n                    next_state |= derived[bit]\n            trans[i][mask] = state_index[next_state]\n    \n    # Compute modular inverse of 100\n    inv100 = pow(100, MOD-2, MOD)\n    \n    # DP initialization\n    dp = [defaultdict(int), defaultdict(int)]\n    start_state = init\n    dp[0][state_index[start_state]] = 1\n    cur_layer = 0\n    \n    for round_num in range(N):\n        probs = [0] * (1 << N)\n        for mask in range(1 << N):\n            prob = 1\n            for k in range(N):\n                if (mask >> k) & 1:\n                    coefficient = P[round_num][k]\n                else:\n                    coefficient = 100 - P[round_num][k]\n                prob = (prob * inv100) % MOD\n                prob = (prob * coefficient) % MOD\n            probs[mask] = prob\n        \n        # Reset next layer\n        dp[cur_layer ^ 1].clear