t[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        update = true;\n                    }\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        \n        int d = INF;\n        for (int v = t; v != s; v = prevv[v]) {\n            d = min(d, graph[prevv[v]][preve[v]].cap - graph[prevv[v]][preve[v]].flow);\n        }\n        \n        flow += d;\n        cost += d * dist[t];\n        for (int v = t; v != s; v = prevv[v]) {\n            Edge &e = graph[prevv[v]][preve[v]];\n            e.flow += d;\n            graph[v][e.rev].flow -= d;\n        }\n    }\n    return {flow, cost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    graph.resize(MAXN);\n    \n    for (int i = 0; i < k; i++) {\n        int x; cin >> x;\n        add_edge(0, x, 1, 0);\n    }\n    \n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j < k; j++) {\n            add_edge(1 + i * n, 9999, 1, i * c);\n        }\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v; cin >> u >> v;\n        for (int j = 1; j < 100; j++) {\n            for (int gg = 1; gg <= k; gg++) {\n                add_edge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                add_edge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n            }\n        }\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j < 100; j++) {\n            add_edge(i + (j - 1) * n, i + j * n, k, 0);\n        }\n    }\n    \n    auto result = min_cost_flow(0, 9999);\n    cout << result.second << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 10000;\n    static final int MAXM = 2000000;\n    static final int INF = 0x3f3f3f3f;\n\n    static class Edge {\n        int to, cap, flow, cost, rev;\n\n        Edge(int t, int c, int f, int co, int r) {\n            to = t;\n            cap = c;\n            flow = f;\n            cost = co;\n            rev = r;\n        }\n    }\n\n    static List<List<Edge>> graph;\n    static int[] dist = new int[MAXN];\n    static int[] prevv = new int[MAXN];\n    static int[] preve = new int[MAXN];\n\n    static void add_edge(int from, int to, int cap, int cost) {\n        graph.get(from).add(new Edge(to, cap, 0, cost, graph.get(to).size()));\n        graph.get(to).add(new Edge(from, 0, 0, -cost, graph.get(from).size() - 1));\n    }\n\n    static class Pair {\n        int first, second;\n\n        Pair(int f, int s) {\n            first = f;\n            second = s;\n        }\n    }\n\n    static Pair min_cost_flow(int s, int t) {\n        int flow = 0, cost = 0;\n        while (true) {\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            boolean update = true;\n            while (update) {\n                update = false;\n                for (int v = 0; v < MAXN; ++v) {\n                    if (dist[v] == INF) continue;\n                    for (int i = 0; i < graph.get(v).size(); ++i) {\n                        Edge e = graph.get(v).get(i);\n                        if (e.cap > e.flow && dist[e.to] > dist[v] + e.cost) {\n                            dist[e.to] = dist[v] + e.cost;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            update = true;\n                        }\n                    }\n                }\n            }\n            if (dist[t] == INF) break;\n\n            int d = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge edge = graph.get(prevv[v]).get(preve[v]);\n                d = Math.min(d, edge.cap - edge.flow);\n            }\n\n            flow += d;\n            cost += d * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = graph.get(prevv[v]).get(preve[v]);\n                e.flow += d;\n                graph.get(v).get(e.rev).flow -= d;\n            }\n        }\n        return new Pair(flow, cost);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        graph = new ArrayList<>();\n        for (int i = 0; i < MAXN; i++) {\n            graph.add(new ArrayList<>());\n        }\n        \n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            add_edge(0, x, 1, 0);\n        }\n        \n        for (int i = 0; i < 100; i++) {\n            for (int j = 0; j < k; j++) {\n                add_edge(1 + i * n, 9999, 1, i * c);\n            }\n        }\n        \n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                for (int gg = 1; gg <= k; gg++) {\n                    add_edge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                    add_edge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n                }\n            }\n        }\n        \n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                add_edge(i + (j - 1) * n, i + j * n, k, 0);\n            }\n        }\n        \n        Pair result = min_cost_flow(0, 9999);\n        System.out.println(result.second);\n        \n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011383838864276186, -2.3841830625315197e-06, -2.3841855067985307e-07, -0.00549970893189311, -3.802703940