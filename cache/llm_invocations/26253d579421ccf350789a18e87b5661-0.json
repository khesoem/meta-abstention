{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nconst int N = 1000000;\nint fr[N+2], sr, sn;\nvector<int> gr[N+2];\nconst int INF = 1000000000;\n\nclass MinCostFlow {\npublic:\n    struct Edge { int to, rev; int cap, cost; };\n    vector<vector<Edge>> g;\n    vector<int> h, dist, prevv, preve;\n    MinCostFlow(int n) : g(n), h(n, 0), dist(n), prevv(n), preve(n) {}\n    void addEdge(int from, int to, int cap, int cost) {\n        g[from].push_back({to, (int)g[to].size(), cap, cost});\n        g[to].push_back({from, (int)g[from].size()-1, 0, -cost});\n    }\n    pair<int,int> minCostFlow(int s, int t, int maxf) {\n        int flow = 0, cost = 0;\n        while (flow < maxf) {\n            fill(dist.begin(), dist.end(), INF);\n            dist[s] = 0;\n            priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;\n            pq.push({0, s});\n            while (!pq.empty()) {\n                auto [d, v] = pq.top(); pq.pop();\n                if (dist[v] < d) continue;\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    auto &e = g[v][i];\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        pq.push({dist[e.to], e.to});\n                    }\n                }\n            }\n            if (dist[t] == INF) break;\n            for (int v = 0; v < (int)g.size(); ++v) h[v] += dist[v];\n            int d = maxf - flow;\n            for (int v = t; v != s; v = prevv[v]) d = min(d, g[prevv[v]][preve[v]].cap);\n            flow += d;\n            cost += d * h[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                auto &e = g[prevv[v]][preve[v]];\n                e.cap -= d;\n                g[v][e.rev].cap += d;\n            }\n        }\n        return {flow, cost};\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(0); cin.tie(0);\n    int n, m, k, c, d; cin >> n >> m >> k >> c >> d;\n    for (int i = 1; i <= k; ++i) {\n        int x; cin >> x; fr[x]++;\n    }\n    for (int i = 1; i <= m; ++i) {\n        int u, v; cin >> u >> v;\n        gr[u].push_back(v);\n        gr[v].push_back(u);\n    }\n    sr = 0, sn = 100 * n + n + 1;\n    MinCostFlow mcf(sn + 1);\n    for (int tm = 0; tm <= 99; ++tm) {\n        for (int i = 1; i <= n; ++i) {\n            mcf.addEdge(n * tm + i, n * (tm + 1) + i, k, 0);\n            for (auto x : gr[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    mcf.addEdge(n * tm + i, n * (tm + 1) + x, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        if (fr[i]) mcf.addEdge(sr, i, fr[i], 0);\n    for (int tm = 0; tm <= 100; ++tm)\n        mcf.addEdge(n * tm + 1, sn, k, c * tm);\n    auto ans = mcf.minCostFlow(sr, sn, INF);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1000000000;\n\n    static class MinCostFlow {\n        static class Edge {\n            int to, rev, cap, cost;\n            Edge(int to, int rev, int cap, int cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n\n        ArrayList<Edge>[] g;\n        int[] h, dist, prevv, preve;\n\n        MinCostFlow(int n) {\n            g = new ArrayList[n];\n            for (int i = 0; i < n; i++) {\n                g[i] = new ArrayList<>();\n            }\n            h = new int[n];\n            dist = new int[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void addEdge(int from, int to, int cap, int cost) {\n            g[from].add(new Edge(to, g[to].size(), cap, cost));\n            g[to].add(new Edge(from, g[from].size() - 1, 0, -cost));\n        }\n\n        int[] minCostFlow(int s, int t, int maxf) {\n            int flow = 0, cost = 0;\n            while (flow < maxf) {\n                Arrays.fill(dist, INF);\n                dist[s] = 0;\n                PriorityQueue<Node> pq = new PriorityQueue<>(Comparator.comparingInt(node -> node.dist));\n                pq.add(new Node(0, s));\n                while (!pq.isEmpty()) {\n                    Node node = pq.poll();\n                    int d = node.dist;\n                    int v = node.vertex;\n                    if (dist[v] < d) continue;\n                    for (int i = 0; i < g[v].size(); i++) {\n                        Edge e = g[v].get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.add(new Node(dist[e.to], e.to));\n                        }\n                    }\n                }\n                if (dist[t] == INF) break;\n                for (int v = 0; v < g.length; v++) {\n                    h[v] += dist[v];\n                }\n                int d = maxf - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, g[prevv[v]].get(preve[v]).cap);\n                }\n                flow += d;\n                cost += d * h[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g[prevv[v]].get(preve[v]);\n                    e.cap -= d;\n                    g[v].get(e.rev).cap += d;\n                }\n            }\n            return new int[]{flow, cost};\n        }\n\n        static class Node {\n            int dist, vertex;\n            Node(int d, int v) {\n                this.dist = d;\n                this.vertex = v;\n            }\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int[] fr = new int[n + 1];\n        st = new StringTokenizer(br.readLine());\n        for (int i = 1; i <= k; i++) {\n            int x = Integer.parseInt(st.nextToken());\n            fr[x]++;\n        }\n\n        ArrayList<Integer>[] gr = new ArrayList[n + 1];\n        for (int i = 1; i <= n; i++) {\n            gr[i] = new ArrayList<>();\n        }\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            gr[u].add(v);\n            gr[v].add(u);\n        }\n\n        int sr = 0;\n        int sn = 100 * n + n + 1;\n        MinCostFlow mcf = new MinCostFlow(sn + 1);\n\n        for (int tm = 0; tm <= 99; tm++) {\n            for (int i = 1; i <= n; i++) {\n                mcf.addEdge(n * tm + i, n * (tm + 1) + i, k, 0);\n                for (int x : gr[i]) {\n                    for (int cp = 1; cp <= k; cp++) {\n                        mcf.addEdge(n * tm + i, n * (tm + 1) + x, 1, d * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            if (fr[i] > 0) {\n                mcf.addEdge(sr, i, fr[i], 0);\n            }\n        }\n\n        for (int tm = 0; tm <= 100; tm++) {\n            mcf.addEdge(n * tm + 1, sn, k, c * tm);\n        }\n\n        int[] ans = mcf.minCostFlow(sr, sn, INF);\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.93382906622719e-05, -0.021211674436926842, -3.099436753473128e-06, -1.1920928244535389e-07, -2.264974000354414e-06, -0.0008797351038083434, -0.0005253365379758179, -7.152555099310121e-07, -0.04859016835689545, -0.07927118241786957, -9.536738616588991e-07, -7.152555099310121e-07, -3.576278118089249e-07, -0.0012060280423611403, -0.001958239823579788, -5.960462772236497e-07, -0.00036507140612229705, -0.023326274007558823, -0.0012012654915452003, -0.011608786880970001, -0.038238320499658585, -0.00012396997772157192, -0.0019309938652440906, -7.152555099310121e-07, -0.0008244690834544599, -0.002147155813872814, -9.452849917579442e-05, -0.03879888355731964, -0.0017477489309385419, -0.58693528175354, -6.496695277746767e-05, -0.005962916649878025, -7.855583680793643e-05, -0.6952273845672607, -0.0008529362385161221, -0.0009178477921523154, -0.00039009589818306267, -2.7418097943154862e-06