int i = 0; i <= n; i++) {\n        int cnt = 0;\n        int j = i;\n        while (j) {\n            cnt++;\n            j = (j - 1) & j;\n        }\n        len[i] = cnt;\n    }\n    \n    for (int i = n; ; i = (i - 1) & n) {\n        vis[i] = true;\n        if (i == 0) break;\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        if (vis[i]) {\n            for (int j = i; j > 0; j = (j - 1) & i) {\n                int l = min(k, len[i - j] + 1);\n                for (int s = 1; s <= l; s++) {\n                    if (dp[s - 1][i - j]) {\n                        dp[s][i] = (dp[s][i] + 1LL * dp[s - 1][i - j] * inv[j]) % mod;\n                    }\n                }\n            }\n        }\n    }\n    \n    int ans = 0;\n    for (int i = 0; i <= min(k, len[n]); i++) {\n        if (dp[i][n]) {\n            int tmp = 1LL * dp[i][n] * fac[k] % mod;\n            tmp = 1LL * tmp * inv[k - i] % mod;\n            tmp = 1LL * tmp * inv[i] % mod;\n            tmp = 1LL * tmp * fac[n] % mod;\n            ans = (ans + tmp) % mod;\n        }\n    }\n    \n    cout << (power(k, n) - ans + mod) % mod << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    input = sys.stdin.readline\n    n, k, mod = map(int, input().split())\n    \n    def power(a, n):\n        if n == 0:\n            return 1\n        ret = power(a, n // 2)\n        ret = (ret * ret) % mod\n        if n % 2:\n            ret = (ret * a) % mod\n        return ret\n    \n    if n % 2:\n        print(power(k, n))\n        return\n    \n    fac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    len_arr = [0] * (n + 1)\n    vis = [False] * (1 << n)\n    dp = [[0] * (1 << n) for _ in range(k + 1)]\n    \n    fac[0] = 1\n    for i in range(1, n + 1):\n        fac[i] = (fac[i - 1] * i) % mod\n    \n    inv[n] = power(fac[n], mod - 2)\n    for i in range(n -