i) {\n            Edge& e = graph[v][i];\n            if (e.cap > 0 && level[v] < level[e.to]) {\n                int d = dfs(e.to, t, min(f, e.cap));\n                if (d > 0) {\n                    e.cap -= d;\n                    graph[e.to][e.rev].cap += d;\n                    return d;\n                }\n            }\n        }\n        return 0;\n    }\n    int max_flow(int s, int t) {\n        int flow = 0;\n        while (bfs(s, t)) {\n            fill(iter.begin(), iter.end(), 0);\n            int f;\n            while ((f = dfs(s, t, INT_MAX)) > 0)\n                flow += f;\n        }\n        return flow;\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, t;\n    cin >> n >> t;\n\n    vector<string> nau(n), pom(n);\n    for (auto& s : nau) cin >> s;\n    for (auto& s : pom) cin >> s;\n\n    vector<vector<int>> odl(n, vector<int>(n, 1000));\n    int sx = -1, sy = -1;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (nau[i][j] == 'Z') { sx = i; sy = j; }\n\n    const int dx[] = {-1, 0, 1, 0, 0};\n    const int dy[] = {0, 1, 0, -1, 0};\n\n    auto ok = [n](int x, int y) { return x >= 0 && x < n && y >= 0 && y < n; };\n\n    queue<pair<int,int>> q;\n    odl[sx][sy] = 0;\n    q.push({sx, sy});\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (ok(nx, ny) && nau[nx][ny] >= '0' && nau[nx][ny] <= '9' && odl[nx][ny] == 1000) {\n                odl[nx][ny] = odl[x][y] + 1;\n                q.push({nx, ny});\n            }\n        }\n    }\n\n    bool moge[60][10][10][10][10] = {};\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            for (int d = 0; d < 5; ++d) {\n                int ni = i + dx[d], nj = j + dy[d];\n                if (ok(ni, nj) && nau[i][j] >= '0' && nau[i][j] <= '9' && nau[ni][nj] >= '0' && nau[ni][nj] <= '9')\n                    moge[0][i][j][ni][nj] = true;\n            }\n\n    for (int k = 0; k <= t - 2; ++k)\n        for (int i = 0; i < n; ++i)\n            for (int j = 0; j < n; ++j)\n                for (int l = 0; l < n; ++l)\n                    for (int m = 0; m < n; ++m) {\n                        if (!moge[k][i][j][l][m]) continue;\n                        for (int d = 0; d < 5; ++d) {\n                            int nl = l + dx[d], nm = m + dy[d];\n                            if (ok(nl, nm) && nau[nl][nm] >= '0' && nau[nl][nm] <= '9' && odl[l][m] >= k+2 && odl[nl][nm] >= k+2)\n                                moge[k+1][i][j][nl][nm] = true;\n                        }\n                    }\n\n    vector<pair<int,int>> a;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (nau[i][j] >= '0' && nau[i][j] <= '9')\n                a.push_back({i, j});\n\n    int V = 2 * a.size() + 2;\n    Dinic dinic(V);\n    for (int i = 0; i < (int)a.size(); ++i) {\n        int c1 = nau[a[i].first][a[i].second] - '0';\n        int c2 = pom[a[i].first][a[i].second] - '0';\n        dinic.add_edge(0, i+1, c1);\n        dinic.add_edge(a.size()+1+i, V-1, c2);\n    }\n\n    for (int i = 0; i < (int)a.size(); ++i)\n        for (int j = 0; j < (int)a.size(); ++j) {\n            bool reach = false;\n            for (int k = 0; k <= t-1; ++k)\n                if (moge[k][a[i].first][a[i].second][a[j].first][a[j].second]) {\n                    reach = true;\n                    break;\n                }\n            if (reach)\n                dinic.add_edge(i+1, a.size()+1+j, 1000);\n        }\n\n    cout << dinic.max_flow(0, V-1);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap')\n    def __init__(self, to, rev, cap):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n\nclass Dinic:\n    def __init__(self, n):\n        self.graph = [[] for _ in range(n)]\n        self.level = [0] * n\n        self.iter = [0] * n\n\n    def add_edge(self, fr, to, cap):\n        forward = Edge(to, len(self.graph[to]), cap)\n        backward = Edge(fr, len(self.graph[fr]), 0)\n        self.graph[fr].append(forward)\n        self.graph[to].append(backward)\n\n    def bfs(self, s, t):\n        self.level = [-1] * len(self.graph)\n        q = deque()\n        self.level[s] = 0\n        q.append(s)\n        while q:\n            v = q.popleft()\n            for e in self.graph[v]:\n                if e.cap > 0 and self.level[e.to] < 0:\n                    self.level[e.to] = self.level[v] + 1\n                    q.append(e.to)\n        return self.level[t] >= 0\n\n    def dfs(self, v, t, f):\n        if v == t:\n            return f\n        for i in range(self.iter[v], len(self.graph[v])):\n            self.iter[v] = i\n            e = self.graph[v][i]\n            if e.cap > 0 and self.level[v] < self.level[e.to]:\n                d = self.dfs(e.to, t, min(f, e.cap))\n                if d > 0:\n                    e.cap -= d\n                    self.graph[e.to][e.rev].cap += d\n                    return d\n        return 0\n\n    def max_flow(self, s, t):\n        flow = 0\n        INF = 10**9\n        while self.bfs(s, t):\n            self.iter = [0] * len(self.graph)\n            while True:\n                f = self.dfs(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    nau = [next(it) for _ in range(n)]\n    pom = [next(it) for _ in range(n)]\n\n    # distance from start 'Z'\n    odl = [[1000]*n for _ in range(n)]\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if nau[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n\n    dx = [-1, 0, 1, 0, 0]\n    dy = [0, 1, 0, -1, 0]\n\n    def ok(x, y):\n        return 0 <= x < n and 0 <= y < n\n\n    q = deque()\n    odl[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx, ny = x + dx[d], y + dy[d]\n            if ok(nx, ny) and '0' <= nau[nx][ny] <= '9' and odl[nx][ny] == 1000:\n                odl[nx][ny] = odl[x][y] + 1\n                q.append((nx, ny))\n\n    # moge[k][i][j][l][m] : can go from (i,j) to (l,m) in k steps\n    # allocate size t (since we use indices up to t-1)\n    moge = [[[[[False]*n for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(t)]\n\n    # initial step 0: stay or move to adjacent (including same cell)\n    for i in range(n):\n        for j in range(n):\n            for d in range(5):\n                ni, nj = i + dx[d], j + dy[d]\n                if ok(ni, nj) and '0' <= nau[i][j] <= '9' and '0' <= nau[ni][nj] <= '9':\n                    moge[0][i][j][ni][nj] = True\n\n    # dynamic programming for steps 1..t-1\n    for k in range(t-1):\n        for i in range(n):\n            for j in range(n):\n                for l in range(n):\n                    for m in range(n):\n                        if not moge[k][i][j][l][m]:\n                            continue\n                        for d in range(5):\n                            nl, nm = l + dx[d], m + dy[d]\n                            if ok(nl, nm) and '0' <= nau[nl][nm] <= '9' and odl[l][m] >= k+2 and odl[nl][nm] >= k+2:\n                                moge[k+1][i][j][nl][nm] = True\n\n    # collect positions of digits\n    a = []\n    for i in range(n):\n        for j in range(n):\n            if '0' <= nau[i][j] <= '9':\n                a.append((i, j))\n\n    V = 2 * len(a) + 2\n    dinic = Dinic(V)\n    for idx, (x, y) in enumerate(a):\n        c1 = int(nau[x][y])\n        c2 = int(pom[x][y])\n        dinic.add_edge(0, idx+1, c1)\n        dinic.add_edge(len(a)+1+idx, V-1, c2)\n\n    for i in range(len(a)):\n        for j in range(len(a)):\n            reach = False\n            for k in range(t):\n                if moge[k][a[i][0]][a[i][1]][a[j][0]][a[j][1]]:\n                    reach = True\n                    break\n            if reach:\n                dinic.add_edge(i+1, len(a)+1+j, 1000)\n\n    print(dinic.max_flow(0, V-1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0009214208112098277, 0.0, 0.0, -0.0004463391669560224, -0.005380197893828154, -2.3841855067985307e-07, -0.00012790338951162994, -7.30726242181845e-05, -3.099436753473128e-06, 0.0, -8.702239938429557e-06, -0.014184604398906231, -0.00424294313415885, -0.12693507969379425, -3.576278118089249e-07, -2.50339189733495e-06, -0.1269468367099762, 0.0, 0.0, -1.6689286894688848e-06, -1.5497195136049413e-06, -0.000713213172275573, -1.1920928244535389e-07, -0.00033539868309162557, 0.0, -2.3841855067985307e-07, -8.344646857949556e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -1.6212332411669195e-05, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, -0.005239327438175678, 0.0, 0.0, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -0.0008074360666796565, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -5.483612312673358e-06, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, -3.6238969187252223e-05, -4.768370445162873e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -5.125986263010418e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -5.8410845667822286e-05, -1.4185804502631072e-05, 0.0, -1.1920928244535389e-07, -0.07912393659353256,