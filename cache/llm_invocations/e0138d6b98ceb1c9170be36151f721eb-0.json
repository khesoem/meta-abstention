++) {\n        G.add(new ArrayList<>());\n      }\n    }\n\n    public void add(int u, int v, long c, long w) {\n      int i = G.get(u).size();\n      int j = G.get(v).size();\n      G.get(u).add(new Edge(v, c, w, j));\n      G.get(v).add(new Edge(u, 0, -w, i));\n    }\n\n    public long run(int s, int t, long f) {\n      int N = G.size();\n      long res = 0;\n      long[] H = new long[N];\n      long[] D = new long[N];\n      long INF = 1_000_000_000_000_000_000L;\n      int[] PE = new int[N];\n      int[] PV = new int[N];\n      PriorityQueue<Pair> q = new PriorityQueue<>();\n      while (f > 0) {\n        Arrays.fill(D, INF);\n        D[s] = 0;\n        q.add(new Pair(0, s));\n        while (!q.isEmpty()) {\n          long d = -q.peek().first;\n          int u = q.peek().second;\n          q.poll();\n          if (D[u] < d) continue;\n          for (Edge e : G.get(u)) {\n            if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n              D[e.v] = D[u] + e.w + H[u] - H[e.v];\n              q.add(new Pair(-D[e.v], e.v));\n              PV[e.v] = u;\n              PE[e.v] = G.get(u).indexOf(e);\n            }\n          }\n        }\n        if (D[t] == INF) return -1;\n        for (int i = 0; i < N; i++) H[i] += D[i];\n        long d = f;\n        for (int i = t; i != s; i = PV[i]) {\n          d = Math.min(d, G.get(PV[i]).get(PE[i]).c);\n        }\n        f -= d;\n        res += d * H[t];\n        for (int i = t; i != s; i = PV[i]) {\n          Edge e = G.get(PV[i]).get(PE[i]);\n          e.c -= d;\n          G.get(i).get(e.r).c += d;\n        }\n      }\n      return res;\n    }\n  }\n\n  static class Pair implements Comparable<Pair> {\n    long first;\n    int second;\n\n    public Pair(long first, int second) {\n      this.first = first;\n      this.second = second;\n    }\n\n    @Override\n    public int compareTo(Pair o) {\n      return Long.compare(first, o.first);\n    }\n  }\n\n  public static void main(String[] args) throws IOException {\n 