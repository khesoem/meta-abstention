{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int INF = 0x7f7f7f7f;\nint n,m,s,t,p,c,d,x[505],y[505];\nint total_flow,total_cost;\nint edge_num=1,head[5000005],nxt[5000005<<1],to[5000005<<1],cap[5000005<<1],cost[5000005<<1];\nint dist[5000005],parent[5000005],last[5000005],augment[5000005];\nbool mark[5000005];\n\nvoid add(int u,int v,int w,int c) {\n\tnxt[++edge_num]=head[u];\n\tto[edge_num]=v;\n\tcap[edge_num]=w;\n\tcost[edge_num]=c;\n\thead[u]=edge_num;\n}\n\nbool spfa() {\n\tfor(int i=0;i<5000005;i++) dist[i]=INF;\n\tfor(int i=0;i<5000005;i++) mark[i]=0;\n\tqueue<int> q;\n\tq.push(s);\n\tmark[s]=1;\n\tdist[s]=0;\n\taugment[s]=INF;\n\tparent[t]=-1;\n\twhile(!q.empty()) {\n\t\tint u=q.front(); q.pop();\n\t\tmark[u]=0;\n\t\tfor(int i=head[u];i;i=nxt[i]) {\n\t\t\tif(cap[i] && dist[to[i]]>dist[u]+cost[i]) {\n\t\t\t\tdist[to[i]]=dist[u]+cost[i];\n\t\t\t\tparent[to[i]]=u;\n\t\t\t\tlast[to[i]]=i;\n\t\t\t\taugment[to[i]]=min(augment[u],cap[i]);\n\t\t\t\tif(!mark[to[i]]) {\n\t\t\t\t\tmark[to[i]]=1;\n\t\t\t\t\tq.push(to[i]);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn parent[t]!=-1;\n}\n\nvoid min_cost_flow() {\n\ttotal_flow=total_cost=0;\n\twhile(spfa()) {\n\t\tint v=t;\n\t\ttotal_flow+=augment[t];\n\t\ttotal_cost+=augment[t]*dist[t];\n\t\twhile(v!=s) {\n\t\t\tcap[last[v]]-=augment[t];\n\t\t\tcap[last[v]^1]+=augment[t];\n\t\t\tv=parent[v];\n\t\t}\n\t}\n}\n\nint compress(int t,int x) {\n\treturn t*n+x;\n}\n\nint main() {\n\tcin>>n>>m>>p>>c>>d;\n\ts=0; t=n*99+1;\n\tfor(int i=1,tmp;i<=p&&cin>>tmp;i++) {\n\t\tadd(s,compress(0,tmp),1,0);\n\t\tadd(compress(0,tmp),s,0,0);\n\t}\n\tfor(int i=1;i<=m;i++) cin>>x[i]>>y[i];\n\tfor(int i=0;i<=99;i++) {\n\t\tadd(compress(i,1),compress(i+1,1),INF,0);\n\t\tadd(compress(i+1,1),compress(i,1),0,0);\n\t\tfor(int j=2;j<=n;j++) {\n\t\t\tadd(compress(i,j),compress(i+1,j),INF,c);\n\t\t\tadd(compress(i+1,j),compress(i,j),0,-c);\n\t\t}\n\t\tfor(int j=1;j<=m;j++) {\n\t\t\tfor(int k=1;k<=p;k++) {\n\t\t\t\tint w=d*k*k-d*(k-1)*(k-1)+c;\n\t\t\t\tadd(compress(i,x[j]),compress(i+1,y[j]),1,w);\n\t\t\t\tadd(compress(i+1,y[j]),compress(i,x[j]),0,-w);\n\t\t\t\tadd(compress(i,y[j]),compress(i+1,x[j]),1,w);\n\t\t\t\tadd(compress(i+1,x[j]),compress(i,y[j]),0,-w);\n\t\t\t}\n\t\t}\n\t}\n\tmin_cost_flow();\n\tcout<<total_cost<<endl;\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```python\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    p = next(it)\n    c = next(it)\n    d = next(it)\n\n    # starting nodes for people\n    start_nodes = [next(it) for _ in range(p)]\n\n    # edges (x, y)\n    x = [0] * (m + 1)\n    y = [0] * (m + 1)\n    for i in range(1, m + 1):\n        x[i] = next(it)\n        y[i] = next(it)\n\n    # graph size: maximum node index = compress(100, n) = 100*n + n = 101*n\n    # also s=0, t = n*99+1, so max node is max(101*n, n*99+1) = 101*n for n>=1\n    N = 101 * n + 5\n    INF = 10**18\n\n    # adjacency list: graph[node] = list of edge indices\n    graph = [[] for _ in range(N)]\n    edges = []  # each edge: [to, cap, cost, rev]\n\n    def add_edge(u: int, v: int, cap: int, cost: int) -> None:\n        forward = len(edges)\n        graph[u].append(forward)\n        edges.append([v, cap, cost, None])  # rev will be set later\n        reverse = len(edges)\n        graph[v].append(reverse)\n        edges.append([u, 0, -cost, None])\n        edges[forward][3] = reverse\n        edges[reverse][3] = forward\n\n    def compress(t: int, node: int) -> int:\n        return t * n + node\n\n    s = 0\n    t_node = n * 99 + 1\n\n    # add source edges for each person\n    for node in start_nodes:\n        add_edge(s, compress(0, node), 1, 0)\n\n    # build time-expanded graph\n    for i in range(0, 100):  # i from 0 to 99\n        # stay at node 1 with zero cost\n        add_edge(compress(i, 1), compress(i + 1, 1), INF, 0)\n        # stay at other nodes with cost c\n        for j in range(2, n + 1):\n            add_edge(compress(i, j), compress(i + 1, j), INF, c)\n        # travel edges\n        for j in range(1, m + 1):\n            for k in range(1, p + 1):\n                w = d * k * k - d * (k - 1) * (k - 1) + c\n                add_edge(compress(i, x[j]), compress(i + 1, y[j]), 1, w)\n                add_edge(compress(i, y[j]), compress(i + 1, x[j]), 1, w)\n\n    # min-cost flow (SPFA)\n    dist = [INF] * N\n    mark = [False] * N\n    parent = [-1] * N\n    last = [-1] * N\n    augment = [0] * N\n\n    def spfa() -> bool:\n        for i in range(N):\n            dist[i] = INF\n            mark[i] = False\n        q = deque()\n        q.append(s)\n        mark[s] = True\n        dist[s] = 0\n        augment[s] = INF\n        parent[t_node] = -1\n        while q:\n            u = q.popleft()\n            mark[u] = False\n            for ei in graph[u]:\n                e = edges[ei]\n                if e[1] > 0 and dist[e[0]] > dist[u] + e[2]:\n                    dist[e[0]] = dist[u] + e[2]\n                    parent[e[0]] = u\n                    last[e[0]] = ei\n                    augment[e[0]] = min(augment[u], e[1])\n                    if not mark[e[0]]:\n                        mark[e[0]] = True\n                        q.append(e[0])\n        return parent[t_node] != -1\n\n    total_flow = 0\n    total_cost = 0\n    while spfa():\n        v = t_node\n        total_flow += augment[t_node]\n        total_cost += augment[t_node] * dist[t_node]\n        while v != s:\n            ei = last[v]\n            edges[ei][1] -= augment[t_node]\n            rev = edges[ei][3]\n            edges[rev][1] += augment[t_node]\n            v = parent[v]\n\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    solve()\n```", "token_logprobs": [-2.3841574147809297e-05, -0.6990200281143188, -8.344646857949556e-07, -2.9801878554280847e-05, -2.1934269170742482e-05, -1.1920928244535389e-07, -9.536738616588991e-07, -6.437280717364047e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.900685573578812e-05, -0.5760616064071655, -0.052455153316259384, -0.5759465098381042, -9.775113539944869e-06, -7.486063259420916e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.001192097319290042, -4.768370445162873e-07, -0.0031822300516068935, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.5497195136049413e-06, -3.540453326422721e-05, -0.6940529942512512, 0.0, -7.867782187531702e-06, 0.0, -0.0024851649068295956, -0.00861463975161314, -0.00021240839851088822, -0.0002616301644593477, -1.4305104514278355e-06, 0.0, -0.20152072608470917, 0.0, 0.0, -1.549708758830093e-05, 0.0, 0.0, -8.940656698541716e-06, 0.0, -2.0265558760002023e-06, -0.0001134808044298552, 0.0, 0.0, -7.986990567587782e-06, 0.0, -0.00028272447525523603, -0.002621073741465807, -2.3841855067985307e-07, 0.0, -1.490105023549404e-05, 0.0, -2.6702524337451905e-05, -0.0005349873681552708