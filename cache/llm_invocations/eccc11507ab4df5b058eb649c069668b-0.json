{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int maxn = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, cnt, ans, a[maxn], x[maxn], y[maxn];\nint head[maxn], pre[maxn], dist[maxn], inq[maxn];\nqueue<int> q;\nstruct edge { int to, cap, cost, nxt; } e[2000010];\nint id(int t, int v) { return t * n + v; }\n\nvoid add(int from, int to, int cap, int cost) {\n    e[cnt] = (edge){to, cap, cost, head[from]}, head[from] = cnt++;\n    e[cnt] = (edge){from, 0, -cost, head[to]}, head[to] = cnt++;\n}\n\nbool spfa(int s, int t) {\n    memset(dist, 0x3f, sizeof(dist));\n    q.push(s), dist[s] = 0;\n    while (!q.empty()) {\n        int v = q.front(); q.pop(), inq[v] = 0;\n        for (int i = head[v], u; ~i; i = e[i].nxt) {\n            if (e[i].cap && dist[u = e[i].to] > dist[v] + e[i].cost) {\n                dist[u] = dist[v] + e[i].cost, pre[u] = i;\n                if (!inq[u]) q.push(u), inq[u] = 1;\n            }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid upd(int s, int t) {\n    for (int i = t; i ^ s; i = e[pre[i] ^ 1].to) {\n        e[pre[i]].cap--, e[pre[i] ^ 1].cap++;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &a[i]), add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &x[i], &y[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            for (int j = 1; j <= min(k, 25); j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nmaxn = 6010\nINF = 0x3f3f3f3f\n\nn, m, k, c, d = map(int, sys.stdin.readline().split())\na = [0] * (maxn)\nx = [0] * (maxn)\ny = [0] * (maxn)\nhead = [-1] * (maxn * 2 * maxn)\npre = [0] * (maxn * 2 * maxn)\ndist = [INF] * (maxn * 2 * maxn)\ninq = [0] * (maxn * 2 * maxn)\n\nclass Edge:\n    def __init__(self, to, cap, cost, nxt):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.nxt = nxt\n\ne = []\n\ndef id_func(t, v):\n    return t * n + v\n\ncnt = 0\n\ndef add(from_node, to_node, cap, cost):\n    global cnt\n    e.append(Edge(to_node, cap, cost, head[from_node]))\n    head[from_node] = cnt\n    cnt += 1\n    e.append(Edge(from_node, 0, -cost, head[to_node]))\n    head[to_node] = cnt\n    cnt += 1\n\ndef spfa(s, t):\n    for i in range(len(dist)):\n        dist[i] = INF\n    q = deque()\n    q.append(s)\n    dist[s] = 0\n    inq[:] = [0] * len(inq)\n    inq[s] = 1\n    while q:\n        v = q.popleft()\n        inq[v] = 0\n        i = head[v]\n        while i != -1:\n            u = e[i].to\n            if e[i].cap > 0 and dist[u] > dist[v] + e[i].cost:\n                dist[u] = dist[v] + e[i].cost\n                pre[u] = i\n                if not inq[u]:\n                    q.append(u)\n                    inq[u] = 1\n            i = e[i].nxt\n    return dist[t] < 1e9\n\ndef upd(s, t):\n    i = t\n    while i != s:\n        e[pre[i]].cap -= 1\n        e[pre[i] ^ 1].cap += 1\n        i = e[pre[i] ^ 1].to\n    global ans\n    ans += dist[t]\n\n# Initialize head array\nfor i in range(len(head)):\n    head[i] = -1\n\nS = 0\nT = 6000\nans = 0\n\n# Read input\na_input = list(map(int, sys.stdin.readline().split()))\nfor i in range(1, k + 1):\n    a[i] = a_input[i - 1]\n    add(S, id_func(0, a[i]), 1, 0)\n\nxy_input = [list(map(int, sys.stdin.readline().split())) for _ in range(m)]\nfor i in range(1, m + 1):\n    x[i], y[i] = xy_input[i - 1]\n\nfor t in range(0, 101):\n    for i in range(2, n + 1):\n        add(id_func(t, i), id_func(t + 1, i), k, c)\n    add(id_func(t, 1), T, k, 0)\n    for i in range(1, m + 1):\n        for j in range(1, min(k, 25) + 1):\n            cost_value = c + (2 * j - 1) * d\n            add(id_func(t, x[i]), id_func(t + 1, y[i]), 1, cost_value)\n            add(id_func(t, y[i]), id_func(t + 1, x[i]), 1, cost_value)\n\nwhile spfa(S, T):\n    upd(S, T)\n\nprint(ans)\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0006926587666384876, -0.00037490393151529133, -1.981667537620524e-06, -7.941850526549388e-06, -0.1056203842163086, -9.372294698550832e-06, -1.0445127372804563e-05, -0.02378995530307293, -4.68022444692906e-05, 0.0, -2.339278580620885e-06, -0.00036299455678090453, -0.0016303133452311158, -7.896309739408025e-07, -4.8590300139039755e-05, 0.0, -4.4849443838757e-06, -6.704273118884885e-07, -3.4881879400927573e-05, -5.0020742492051795e-05, -4.320199877838604e-07, -0.062038935720