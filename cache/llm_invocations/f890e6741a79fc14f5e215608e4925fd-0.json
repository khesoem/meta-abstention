[[-1]*12 for _ in range(12)]\nf = [[-1]*12 for _ in range(12)]\ne: List[List[int]] = [[] for _ in range(2000)]\nc: List[List[List[int]]] = [[[] for _ in range(12)] for _ in range(12)]\nm = 0\n\nclass Hungary:\n    SIZE = 2000\n    def __init__(self):\n        self.cnt = 0\n        self.pos = [-1]*self.SIZE\n        self.rev = [-1]*self.SIZE\n        self.v = [0]*self.SIZE\n\n    def gao(self, n: int, e: List[List[int]]) -> int:\n        self.cnt = 0\n        self.pos = [-1]*self.SIZE\n        self.rev = [-1]*self.SIZE\n        for i in range(n):\n            self.v = [0]*self.SIZE\n            if self.match(i, e):\n                self.cnt += 1\n        return self.cnt\n\n    def match(self, x: int, e: List[List[int]]) -> bool:\n        for y in e[x]:\n            if self.v[y] == 0:\n                self.v[y] = 1\n            else:\n                continue\n            if self.rev[y] < 0 or self.match(self.rev[y], e):\n                self.pos[x] = y\n                self.rev[y] = x\n                return True\n        return False\n\ndef floodfill(sr: int, sc: int):\n    global f\n    f = [[-1]*12 for _ in range(12)]\n    qr = deque([sr])\n    qc = deque([sc])\n    f[sr][sc] = 0\n    while qr:\n        sr = qr.popleft()\n        sc = qc.popleft()\n        for i in range(4):\n            tr = sr + mr[i]\n            tc = sc + mc[i]\n            if a[tr][tc] >= 0 and f[tr][tc] < 0:\n                f[tr][tc] = f[sr][sc] + 1\n                qr.append(tr)\n                qc.append(tc)\n\ndef setmark(sr: int, sc: int, cnt: int):\n    global m\n    v = [[-1]*12 for _ in range(12)]\n    qr = deque([sr])\n    qc = deque([sc])\n    v[sr][sc] = 0\n    while qr:\n        sr = qr.popleft()\n        sc = qc.popleft()\n        if v[sr][sc] > min(t, f[sr][sc]):\n            continue\n        for j in c[sr][sc]:\n            for i in range(cnt):\n                e[m+i].append(j)\n        if v[sr][sc] == min(t, f[sr][sc]):\n            continue\n        for i in range(4):\n            tr = sr + mr[i]\n            tc = sc + mc[i]\n            if a[tr][tc] >= 0 and v[tr][tc] < 0:\n                v[tr][tc] = v[sr][sc] + 1\n                qr.append(tr)\n                qc.append(tc)\n    m += cnt\n\nmatch = Hungary()\n\ndef main():\n    global m, a, b, c, f\n    n, t = map(int, sys.stdin.readline().split())\n    a = [[-1]*12 for _ in range(12)]\n    b = [[-1]*12 for _ in range(12)]\n    f = [[-1]*12 for _ in range(12)]\n    c = [[[] for _ in range(12)] for _ in range(12)]\n    o = 0\n    m = 0\n    sr = sc = 0\n    for i in range(1, n+1):\n        sys.stdin.readline()  # skip the newline after each row\n        line = sys.stdin.readline().strip()\n        for j, ch in enumerate(line, 1):\n            if '0' <= ch <= '9':\n                a[i][j] = int(ch)\n            elif ch == 'Z':\n                sr = i\n                sc = j\n    floodfill(sr, sc)\n    sys.stdin.readline()  # skip the newline\n    for i in range(1, n+1):\n        sys.stdin.readline()  # skip the newline\n        line = sys.stdin.readline().strip()\n        for j, ch in enumerate(line, 1):\n            if '0' <= ch <= '9':\n                b[i][j] = int(ch)\n            for k in range(b[i][j]):\n                c[i][j].append(o)\n                o += 1\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if f[i][j] < 0:\n                f[i][j] = INF\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if a[i][j] > 0:\n                setmark(i, j, a[i][j])\n    print(match.gao(m, e))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.960463e-07, 0.0, 0.0, -0.0007269124, -0.27150583, -0.0005759726, -0.006778934, -0.0061285663, -0.00057358976, -1.1920928e-07, -0.00020895206, -3.288619, -1.2795691, -0.0596231, 0.0, -2.2172682e-05, -0.20160054, -0.41246238, -0.00027485884, -0.0004365683, -0.07974086, -1.0967195e-05, -9.5367386e-07, -1.800044e-05, -0.06199820