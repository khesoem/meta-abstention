{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int maxn = 6010;\nint n, m, k, c, d, cnt, ans, a[maxn], x[maxn], y[maxn];\nint head[maxn], pre[maxn], dist[maxn], inq[maxn];\nqueue<int> q;\nstruct edge { int to, cap, cost, nxt; } e[2000010];\nint id(int t, int v) { return t * n + v; }\n\nvoid add(int from, int to, int cap, int cost) {\n    e[cnt] = {to, cap, cost, head[from]}, head[from] = cnt++;\n    e[cnt] = {from, 0, -cost, head[to]}, head[to] = cnt++;\n}\n\nbool spfa(int s, int t) {\n    memset(dist, 63, sizeof(dist));\n    q.push(s), dist[s] = 0;\n    while (!q.empty()) {\n        int v = q.front(); q.pop(), inq[v] = 0;\n        for (int i = head[v], u; ~i; i = e[i].nxt) {\n            if (e[i].cap && dist[u = e[i].to] > dist[v] + e[i].cost) {\n                dist[u] = dist[v] + e[i].cost, pre[u] = i;\n                if (!inq[u]) q.push(u), inq[u] = 1;\n            }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid upd(int s, int t) {\n    for (int i = t; i ^ s; i = e[pre[i] ^ 1].to) {\n        e[pre[i]].cap--, e[pre[i] ^ 1].cap++;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    fill(head, head + maxn, -1);\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &a[i]), add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &x[i], &y[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            int lim = min(k, 25);\n            for (int j = 1; j <= lim; j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 6010\nINF = 10**9\n\ndef id(t, v):\n    return t * n + v\n\ndef add_edge(fr, to, cap, cost):\n    graph[fr].append([to, cap, cost, len(graph[to])])\n    graph[to].append([fr, 0, -cost, len(graph[fr]) - 1])\n\ndef spfa(s, t):\n    global dist, pre, inq\n    for i in range(MAXN):\n        dist[i] = INF\n        inq[i] = False\n        pre[i] = (-1, -1)\n    q = deque()\n    dist[s] = 0\n    q.append(s)\n    inq[s] = True\n    while q:\n        v = q.popleft()\n        inq[v] = False\n        for idx, e in enumerate(graph[v]):\n            if e[1] > 0 and dist[e[0]] > dist[v] + e[2]:\n                dist[e[0]] = dist[v] + e[2]\n                pre[e[0]] = (v, idx)\n                if not inq[e[0]]:\n                    q.append(e[0])\n                    inq[e[0]] = True\n    return dist[t] < INF\n\ndef upd(s, t):\n    global ans\n    i = t\n    while i != s:\n        v, idx = pre[i]\n        e = graph[v][idx]\n        e[1] -= 1\n        rev = graph[i][e[3]]\n        rev[1] += 1\n        i = v\n    ans += dist[t]\n\ndata = list(map(int, sys.stdin.buffer.read().split()))\nn, m, k, c, d = data[0:5]\na = data[5:5 + k]\npairs = data[5 + k:5 + k + 2 * m]\nx = [pairs[i] for i in range(0, 2 * m, 2)]\ny = [pairs[i + 1] for i in range(0, 2 * m, 2)]\n\nS = 0\nT = 6000\n\ngraph = [[] for _ in range(MAXN)]\ndist = [0] * MAXN\npre = [(-1, -1)] * MAXN\ninq = [False] * MAXN\nans = 0\n\nfor ai in a:\n    add_edge(S, id(0, ai), 1, 0)\n\nfor t in range(0, 101):\n    for i in range(2, n + 1):\n        add_edge(id(t, i), id(t + 1, i), k, c)\n    add_edge(id(t, 1), T, k, 0)\n    lim = min(k, 25)\n    for i in range(m):\n        for j in range(1, lim + 1):\n            cost = c + (2 * j - 1) * d\n            add_edge(id(t, x[i]), id(t + 1, y[i]), 1, cost)\n            add_edge(id(t, y[i]), id(t + 1, x[i]), 1, cost)\n\nwhile spfa(S, T):\n    upd(S, T)\n\nprint(ans)\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.344646857949556e-07, 0.0, -4.768370445162873e-07, -0.0005606033373624086, -0.011136635206639767, 0.0, -5.602820692729438e-06, -2.264974000354414e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0004319211875554174, -0.01935523934662342, -2.5987286790041253e-05, -1.1920928244535389e-07, 0.0, -8.4638240878121e-06, 0.0, -0.005250236950814724, -0.0013198483502492309, 0.0, -1.0251946150674485e-05, -3.7788631743751466e-05, -0.12692846357822418, -2.682172998902388e-05, -0.004104405175894499, -0.261098712682724, -0.08174876868724823, -0.009588142856955528, -0.00043096792069263756, -5.829164365422912e-05, -0.31378230452537537, -1.1920928244535389e-07, -0.0009666775586083531, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.0371154530730564e-05, -1.9073468138230965e-06, 0.0, -6.151010165922344e-05, -0.0023388906847685575, -5.364403477869928e-06, -5.960462772236497e-07, -8.535020606359467e-05, -3.6954811548639555e-06, -1.4