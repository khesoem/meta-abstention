j < n; ++j) if (!(i & (1 << j)))\n            s[j].set(i | (1 << j));\n    for (int i = 0; i < (1 << n); ++i) {\n        LLL ng = w;\n        for (int j = 0; j < n; ++j) if (i & (1 << j)) ng |= s[j];\n        ans = (ans + f[x][i] * dfs(x + 1, ng)) % MOD;\n    }\n    return st[x][w] = ans;\n}\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(0);\n    cin >> n;\n    for (int i = 0; i < (1 << n); ++i) mx.set(i);\n    stt.set(0);\n    i100 = fpm(100, MOD - 2);\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            a[i][j] = a[i][j] * i100 % MOD;\n        }\n    for (int i = 0; i < n; ++i) is[1 << i] = i;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < (1 << n); ++j) {\n            f[i][j] = 1;\n            for (int k = 0; k < n; ++k)\n                if (j & (1 << k))\n                    f[i][j] = f[i][j] * a[k][i] % MOD;\n                else\n                    f[i][j] = f[i][j] * (MOD + 1 - a[k][i]) % MOD;\n        }\n    cout << dfs(0, stt) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef fpm(a, b):\n    return pow(a, b, MOD)\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    # mx: bitmask with bits 0..(1<<n)-1 set\n    mx = (1 << (1 << n)) - 1\n    stt = 1  # bit 0 set\n    i100 = fpm(100, MOD - 2)\n    a = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            val = int(next(it))\n            a[i][j] = val * i100 % MOD\n    # f[i][j] for i in 0..n-1, j in 0..(1<<n)-1\n    f = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        for j in range(1 << n):\n            prod = 1\n            for k in range(n):\n                if (j >> k) & 1:\n                    prod = 