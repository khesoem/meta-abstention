def max_flow():\n    flow = 0\n    level = build_level_graph()\n    while level[T] != -1:\n        it = [0] * (T+1)\n        while True:\n            pushed = dinic_dfs(S, INF, level, it)\n            if not pushed:\n                break\n            flow += pushed\n        level = build_level_graph()\n    return flow\n\n# Read input\ndata = sys.stdin.read().split()\nif not data:\n    exit()\nit = iter(data)\nn = int(next(it))\ntt = int(next(it))\nma = [''] * (n+1)\nmb = [''] * (n+1)\nfor i in range(1, n+1):\n    ma[i] = ' ' + next(it)  # 1-indexed, add dummy at index 0\nfor i in range(1, n+1):\n    mb[i] = ' ' + next(it)\n\n# Initialize arrays\ndep = [[INF] * (n+2) for _ in range(n+2)]\ndis = [[INF] * (n+2) for _ in range(n+2)]\np = [[0] * (n+2) for _ in range(n+2)]\ns = [[0] * (n+2) for _ in range(n+2)]\n\n# First BFS from 'Z' to compute dep\nfor i in range(1, n+1):\n    for j in range(1, n+1):\n        if ma[i][j] == 'Z':\n            dis = bfs_dist(i, j, False)\n            # copy dis to dep\n            for x in range(1, n+1):\n                for y in range(1, n+1):\n                    dep[x][y] = dis[x][y]\n\n# Build graph\nt = 1\nS = 0\nT = 1\ngraph = [[] for _ in range(2 + 2 * n * n)]  # enough space, will expand if needed\n\n# Assign node ids for supply and demand\nfor i in range(1, n+1):\n    for j in range(1, n+1):\n        if ma[i][j].isdigit() and ma[i][j] != '0':\n            t += 1\n            p[i][j] = t\n            add_edge(S, t, int(ma[i][j]))\n        if mb[i][j].isdigit() and mb[i][j] != '0':\n            t += 1\n            s[i][j] = t\n            add_edge(t, T, int(mb[i][j]))\n\n# Second BFS from supply cells\nfor i in range(1, n+1):\n    for j in range(1, n+1):\n        if p[i][j]:\n            bfs_dist(i, j, True)\n\n# Compute max flow\nans = max_flow()\nprint(ans)\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0013530300057027e-05, 0.0, 0.0, -0.0005685858195647597, -0.000536655425094068, -8.3446468579495