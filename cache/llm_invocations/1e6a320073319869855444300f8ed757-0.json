\n#include <vector>\n#include <algorithm>\n#include <set>\n#include <cmath>\n\nusing namespace std;\n\nint n, m;\nvector<int> a;\nvector<int> left_part;\nvector<int> right_part;\n\nvoid traverse_left(int pos, int acc) {\n    if (pos == n / 2) {\n        left_part.push_back(acc);\n    } else {\n        traverse_left(pos + 1, (acc + a[pos]) % m);\n        traverse_left(pos + 1, acc);\n    }\n}\n\nvoid traverse_right(int pos, int acc) {\n    if (pos == n) {\n        right_part.push_back(acc);\n    } else {\n        traverse_right(pos + 1, (acc + a[pos]) % m);\n        traverse_right(pos + 1, acc);\n    }\n}\n\nint main() {\n    cin >> n >> m;\n    a.resize(n);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n    }\n\n    traverse_left(0, 0);\n    traverse_right(n / 2, 0);\n\n    set<int> left_set(left_part.begin(), left_part.end());\n    left_part.assign(left_set.begin(), left_set.end());\n    sort(left_part.begin(), left_part.end());\n\n    int result = 0;\n    for (int right_val : right_part) {\n        int complement = m - right_val;\n        auto it = lower_bound(left_part.begin(), left_part.end(), complement);\n        if (it != left_part.begin()) {\n            --it;\n            int temp = *it + right_val;\n            if (temp > result) {\n                result = temp;\n            }\n        }\n    }\n\n    cout << result << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013255194062367082, -6.437280717364047e-06, -8.344646857949556e-07, -0.00025817399728111923, -3.576278118089249e-07, -3.862306402879767e-05, -2.3841855067985307e-07, -4.768370445162873e-07, -5.960462772236497e-07, -1.8715683836489916e-05, -4.768370445162873e-07, -7.152555099310121e-07, -2.3841855067985307e-07, -0.06999580562114716, -1.3112935448589269e-05, -0.0003357561945449561, -4.529942543740617e-06, -0.0009111781837418675, -0.25193023681640625, -0.0889546126127243, -7.152555099310121e-07, -0.36263030767440796, -0.054888736