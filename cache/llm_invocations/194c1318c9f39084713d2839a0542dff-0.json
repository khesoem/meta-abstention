mp=C(i,cur1);\t\n\t\t\trep(j,0,up){\n\t\t\t\tdp[i][j+1]=(dp[i][j+1]+1ll*dp[cur2][j]*tmp)%mod;\t\t\t\t\t\t\n\t\t\t}\n\t\t\tif(k==0)\tbreak;\n\t\t}\n\t}\n\trep(j,1,min(cnt[n],K))\tans=(ans+1ll*dp[n][j]*C(K,j)%mod*cj[j])%mod;\n\tans=(power(K,n)-ans+mod)%mod;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static int N = 300010;\n    static int n, K, mod;\n    static int[][] dp = new int[N][20];\n    static int[] cnt = new int[N];\n    static int[] mx = new int[N];\n    static int[] cj = new int[N];\n    static int[] inv = new int[N];\n\n    static int power(int x, int y) {\n        int ret = 1;\n        for (; y > 0; y >>= 1, x = (int) ((long) x * x % mod)) {\n            if ((y & 1) == 1) {\n                ret = (int) ((long) ret * x % mod);\n            }\n        }\n        return ret;\n    }\n\n    static int C(int i, int j) {\n        return (int) ((long) cj[i] * inv[j] % mod * inv[i - j] % mod);\n    }\n\n    public static void main(String[] args) throws IOException {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        K = sc.nextInt();\n        mod = sc.nextInt();\n\n        int ans = 0;\n        if ((n & 1) == 1) {\n            System.out.println(power(K, n));\n            return;\n        }\n\n        cj[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            cj[i] = (int) ((long) cj[i - 1] * i % mod);\n        }\n\n        inv[n] = power(cj[n], mod - 2);\n        inv[0] = 1;\n        for (int i = n - 1; i >= 1; i--) {\n            inv[i] = (int) ((long) inv[i + 1] * (i + 1) % mod);\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= 18; j++) {\n                if (((1 << j) & i) != 0) {\n                    cnt[i]++;\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 18; j >= 0; j--) {\n                if (((1 << j) & i) != 0) {\n                    mx[i] = 1 << j;\n                    break;\n                }\n            }\n        }\n\n        dp[0][0] = 1;\n\n        for (int i = 1; i <= n; i++) {\n            if ((n & i) != i) {\n                continue;\n            }\n            int now = i ^ mx[i];\n            for (int k = now; k >= 0; k = (k - 1) & now) {\n                int cur1 = k + mx[i];\n                int cur2 = i ^ cur1;\n                int up = Math.min(K - 1, cnt[cur2]);\n                int tmp = C(i, cur1);\n                for (int j = 0; j <= up; j++) {\n                    dp[i][j + 1] = (dp[i][j + 1] + (int) ((long) dp[cur2][j] * tmp % mod)) % mod;\n                }\n                if (k == 0) break;\n            }\n        }\n\n        int minVal = Math.min(cnt[n], K);\n        for (int j = 1; j <= minVal; j++) {\n            ans = (ans + (int) ((long) dp[n][j] * C(K, j) % mod * cj[j] % mod)) % mod;\n        }\n\n        ans = (power(K, n) - ans + mod) % mod;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010799778101500124, -1.7881377516459906e-06, -4.768370445162873e-07, -0.00042572495294734836, -1.9430925021879375e-05, -0.07892797142267227, -0.40089789032936096, -0.0006384003208950162, -2.3483953555114567e-05, -0.0004848258395213634, -0.0012197205796837807, -7.390948667307384e-06, -5.960462772236497e-07, -2.586808113846928e-05, -0.011060947552323341, -0.00034671969478949904, -0.015692438930273056, -0.3891029953956604, -0.16540417075157166, -5.006777428206988e-06, 0.0, 0.0, 0.0, 0.0, -7.986990567587782e-06, 0.0, 0.0, -7.152555099310121e-07, -5.23315102327615e-05, -0.00977444276213646, -0.023255929350852966, -0.5283371210098267, -1.1920922133867862e-06, -2.3841830625315197e-06, -1.192092824453