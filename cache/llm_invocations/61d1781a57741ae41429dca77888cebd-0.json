t strictly needed, hop will be set\n    dist[s] = 0;\n    hop[s] = 0;\n    pq.push({0, {0, s}});\n    while (!pq.empty()) {\n        auto top = pq.top(); pq.pop();\n        int u = top.second.second;\n        int d = top.first;\n        int h = top.second.first;\n        if (d != dist[u] || h != hop[u]) continue; // outdated\n        for (int ei : adj[u]) {\n            if (edges[ei].cap == 0) continue;\n            int v = edges[ei].v;\n            int nd = dist[u] + (edges[ei].cost);\n            int nh = hop[u] + 1;\n            if (nd < dist[v] || (nd == dist[v] && nh < hop[v])) {\n                dist[v] = nd;\n                hop[v] = nh;\n                prev_edge[v] = ei;\n                pq.push({nd, {nh, v}});\n            }\n        }\n    }\n}\n\nvoid push(int s, int t) {\n    // Unit flow push as in original\n    int u = t;\n    while (u != s) {\n        int ei = prev_edge[u];\n        edges[ei].cap--;\n        edges[ei ^ 1].cap++;\n        u = edges[ei].u;\n    }\n}\n\nvoid add_edge(int u, int v, int cap, int cost) {\n    int idx = edges.size();\n    edges.push_back({u, v, u ^ v, cost, cap});\n    edges.push_back({v, u, v ^ u, -cost, 0});\n    adj[u].push_back(idx);\n    adj[v].push_back(idx + 1);\n}\n\nint min_cost_flow(int s, int t) {\n    int flow_cost = 0;\n    // copy original costs (the cost_ is not needed if we use reduced costs directly)\n    // In this variant, we maintain reduced costs in edges[].cost and update after each dijkstra\n    // But the original updates cost_ after each dijkstra. We need to replicate that.\n    // To keep it simple, let's keep a separate cost array 'orig_cost' and modify after each iteration.\n    // Actually, we can modify edges[].cost directly and restore later? The algorithm uses cost_ that is updated.\n    // So we need to store original cost separately and apply updates.\n    std::vector<int> orig_cost(edges.size());\n    for (size_t i = 0; i < edges.size(); i++) orig_cost[i] = edges[i].cost;\n\n    while (true) {\n        dijkstra(s);\n        if (dist[t] == INF) break;\n        push(s, t);\n        for (int u = 0; u < N_; u++) {\n            if (dist[u] == INF) continue;\n            for (int ei : adj[u]) {\n                if (edges[ei].cap > 0 && dist[ edges[ei].v ] != INF) {\n                    edges[ei].cost += dist[u] - dist[ edges[ei].v ];\n                }\n            }\n        }\n    }\n    for (size_t ei = 0; ei < edges.size(); ei++) {\n        // original cost is orig_cost[ei], and we add cost of back edges (ei^1) which have cap > 0 after flow\n        if (ei % 2 == 1) { // back edge (the one that was added second)\n            flow_cost += orig_cost[ei] * edges[ei].cap;\n        }\n    }\n    return flow_cost;\n}\n\nint main() {\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(0);\n\n    int n, m, k, c, d;\n    std::cin >> n >> m >> k >> c >> d;\n    std::vector<int> start(k);\n    for (int i = 0; i < k; i++) {\n        std::cin >> start[i];\n        start[i]--;\n    }\n\n    // Build initial adjacency (undirected)\n    std::vector<std::vector<int>> base_adj(n);\n    for (int i = 0; i < m; i++) {\n        int a, b;\n        std::cin >> a >> b;\n        a--; b--;\n        base_adj[a].push_back(b);\n        base_adj[b].push_back(a);\n    }\n\n    int t = n + k + 1;\n    int N_total = n * t + 1;\n    adj.assign(N_total, std::vector<int>());\n\n    // Add edges for movement\n    for (int i = 0; i < n; i++) {\n        for (int s = 0; s < t - 1; s++) {\n            int u = i * t + s;\n            for (int j : base_adj[i]) {\n                int v = j * t + s + 1;\n                for (int x = 1; x <= k; x++) {\n                    add_edge(u, v, 1, c + (x * 2 - 1) * d);\n                }\n            }\n        }\n    }\n\n    // Stay edges\n    for (int i = 0; i < n; i++) {\n        for (int s = 0; s < t - 1; s++) {\n            int u = i * t + s, v = u + 1;\n            int stay_cost = (i == 0 ? 0 : c);\n            add_edge(u, v, k, stay_cost)