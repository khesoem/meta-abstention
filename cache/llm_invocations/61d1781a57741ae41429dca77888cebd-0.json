st flow\n    orig_cost = [e[2] for e in edges]\n\n    def dijkstra(s):\n        dist = [INF] * N_total\n        hop = [INF] * N_total\n        prev_edge = [-1] * N_total\n        dist[s] = 0\n        hop[s] = 0\n        pq = [(0, 0, s)]  # (dist, hop, node)\n        while pq:\n            d, h, u = heapq.heappop(pq)\n            if d != dist[u] or h != hop[u]:\n                continue\n            for ei in adj[u]:\n                if edges[ei][3] == 0:\n                    continue\n                v = edges[ei][1]\n                nd = dist[u] + edges[ei][2]\n                nh = hop[u] + 1\n                if nd < dist[v] or (nd == dist[v] and nh < hop[v]):\n                    dist[v] = nd\n                    hop[v] = nh\n                    prev_edge[v] = ei\n                    heapq.heappush(pq, (nd, nh, v))\n        return dist, prev_edge\n\n    def push(s, t, prev_edge):\n        u = t\n        while u != s:\n            ei = prev_edge[u]\n            edges[ei][3] -= 1\n            edges[ei ^ 1][3] += 1\n            u = edges[ei][0]\n\n    flow_cost = 0\n    while True:\n        dist, prev_edge = dijkstra(source)\n        if dist[sink] == INF:\n            break\n        push(source, sink, prev_edge)\n        # Update reduced costs\n        for u in range(N_total):\n            if dist[u] == INF:\n                continue\n            for ei in adj[u]:\n                if edges[ei][3] > 0 and dist[edges[ei][1]] != INF:\n                    edges[ei][2] += dist[u] - dist[edges[ei][1]]\n\n    # Compute total cost from back edges\n    for ei in range(len(edges)):\n        if ei % 2 == 1:  # back edge\n            flow_cost += orig_cost[ei] * edges[ei][3]\n\n    print(flow_cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002882065309677273, -1.1920928244535389e-07, 0.0, -0.0015234065940603614, -0.0010839784517884254, -0.006716651376336813, -0.0032048076391220093, -0.003182824235