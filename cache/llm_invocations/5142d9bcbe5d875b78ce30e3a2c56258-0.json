{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<algorithm>\n#include<cstdio>\n#include<queue>\n#define Maxn 5500\n#define Maxm 35500\n#define INF 1000000000\nusing namespace std;\nstruct Line\n{int nxt,t,c,l;}g[Maxm];\nint fir[Maxn],tl=1;\nvoid adl(int f,int t,int c,int cost){\n  g[++tl]=(Line){fir[f],t,c,cost};fir[f]=tl;\n  g[++tl]=(Line){fir[t],f,0,-cost};fir[t]=tl;\n}\nint S,T,pre[Maxn],lp[Maxn],flow[Maxn],dis[Maxn];\nbool in[Maxn];\nqueue<int> q;\nint spfa()\n{\n  for (int i=1;i<=T;i++)\n    {dis[i]=INF;flow[i]=0;}\n  flow[S]=INF;dis[S]=0;\n  q.push(S);in[S]=1;\n  while(!q.empty()){\n    int u=q.front();\n    in[u]=0;q.pop();\n    for (int i=fir[u],v;i;i=g[i].nxt)\n      if (g[i].c&&dis[v=g[i].t]>dis[u]+g[i].l){\n        dis[v]=dis[u]+g[i].l;\n        flow[v]=min(flow[u],g[i].c);\n        lp[v]=i;pre[v]=u;\n        if (!in[v]){in[v]=1;q.push(v);}\n     }\n  }return flow[T];\n}\nint n,m,k,C,D,pl[105][105],st[105][105];\nstruct Data\n{int f,t;}s[105];\n#define P(x,y) ((x)*n+(y))\nint main()\n{\n  scanf(\"%d%d%d%d%d\",&n,&m,&k,&C,&D);\n  S=P(n+k,n)+1;T=S+2;\n  adl(P(0,1),T,INF,0);\n  for (int i=1;i<=k;i++){\n    int p;\n    scanf(\"%d\",&p);\n    adl(S,P(0,p),1,0);\n  }\n  for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&s[i*2].f,&s[i*2].t);\n    s[i*2-1]=(Data){s[i*2].t,s[i*2].f};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      adl(P(t-1,i),P(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      adl(P(t-1,s[i].f),P(t,s[i].t),1,D);\n      pl[t][i]=tl;st[t][i]=1;\n    }adl(P(t,1),T,INF,t*C);\n  }\n  int sav,cans=0;\n  while((sav=spfa())!=0){\n    int u=T;\n    while(u!=S){\n      int las=pre[u];\n      g[lp[u]].c-=sav;\n      g[lp[u]^1].c+=sav;\n      u=las;\n    }cans+=dis[T]*sav;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (g[pl[t][i]].c){\n          st[t][i]++;\n          adl(P(t-1,s[i].f),P(t,s[i].t),1,D*(st[t][i]*2-1));\n          pl[t][i]=tl;\n        }\n  }printf(\"%d\\n\",cans);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\n\nINF = 1000000000\nMaxn = 5500\nMaxm = 35500\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'cost')\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\ndef add_edge(fr, to, cap, cost):\n    graph[fr].append(Edge(to, len(graph[to]), cap, cost))\n    graph[to].append(Edge(fr, len(graph[fr]) - 1, 0, -cost))\n\ndef min_cost_flow(s, t, maxf):\n    n = len(graph)\n    prevv = [0] * n\n    preve = [0] * n\n    res = 0\n    flow = 0\n    while flow < maxf:\n        dist = [INF] * n\n        dist[s] = 0\n        inq = [False] * n\n        q = deque([s])\n        inq[s] = True\n        while q:\n            v = q.popleft()\n            inq[v] = False\n            for i, e in enumerate(graph[v]):\n                if e.cap > 0 and dist[e.to] > dist[v] + e.cost:\n                    dist[e.to] = dist[v] + e.cost\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n        if dist[t] == INF:\n            return None, res\n        d = maxf - flow\n        v = t\n        while v != s:\n            d = min(d, graph[prevv[v]][preve[v]].cap)\n            v = prevv[v]\n        flow += d\n        res += d * dist[t]\n        v = t\n        while v != s:\n            e = graph[prevv[v]][preve[v]]\n            e.cap -= d\n            graph[v][e.rev].cap += d\n            v = prevv[v]\n    return flow, res\n\nn, m, k, C, D = map(int, input().split())\ntotal_time = n + k\nnode_count = P = lambda x, y: x * n + y\nS = P(total_time, n) + 1\nT = S + 2\ngraph = [[] for _ in range(T + 1)]\nadd_edge(P(0, 1), T, INF, 0)\n\nfor _ in range(k):\n    p = int(input())\n    add_edge(S, P(0, p), 1, 0)\n\nedges = []\nfor _ in range(m):\n    a, b = map(int, input().split())\n    edges.append((a, b))\n    edges.append((b, a))\nm *= 2\n\npl = [[0] * (m + 1) for _ in range(total_time + 1)]\nst = [[1] * (m + 1) for _ in range(total_time + 1)]\n\nfor t in range(1, total_time + 1):\n    for i in range(1, n + 1):\n        add_edge(P(t - 1, i), P(t, i), INF, 0)\n    for i in range(1, m + 1):\n        f, t_ = edges[i - 1]\n        add_edge(P(t - 1, f), P(t, t_), 1, D)\n        pl[t][i] = len(graph[P(t - 1, f)]) - 1\n    add_edge(P(t, 1), T, INF, t * C)\n\nans = 0\nwhile True:\n    sav, cost = min_cost_flow(S, T, INF)\n    if cost is None:\n        break\n    ans += cost\n    for t in range(1, total_time + 1):\n        for i in range(1, m + 1):\n            if graph[P(t - 1, edges[i - 1][0])][pl[t][i]].cap > 0:\n                st[t][i] += 1\n                f, t_ = edges[i - 1]\n                add_edge(P(t - 1, f), P(t, t_), 1, D * (st[t][i] * 2 - 1))\n                pl[t][i] = len(graph[P(t - 1, f)]) - 1\n\nprint(ans)\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-1.0251946e-05, 0.0, -2.384185