bit];\n    }\n\n    int m = min(len(goods), k);\n    loop(step, 0, m) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int idx : goods) {\n                if (mask & (1 << idx)) continue;\n                dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / s[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    loop(i, 0, n) {\n        if (!ok[i]) {\n            cout << fixed << setprecision(12) << 0.0 << \"\\n\";\n        } else {\n            T res = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    res += dp[cur][mask];\n            }\n            cout << fixed << setprecision(12) << (double)res << \"\\n\";\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << fixed << setprecision(6) << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport time\n\ndef solve(n):\n    k = int(sys.stdin.readline().strip())\n    \n    p = list(map(float, sys.stdin.readline().strip().split()))\n    \n    dp = [[0.0] * (1 << n) for _ in range(2)]\n    \n    ok = [0] * n\n    goods = []\n    for i in range(n):\n        if p[i] != 0:\n            ok[i] = 1\n            goods.append(i)\n    \n    dp[0][0] = 1.0\n    cur = 1\n    \n    s = [0.0] * (1 << n)\n    s[0] = 1.0\n    for mask in range(1, 1 << n):\n        bit = (mask & -mask).bit_length() - 1\n        s[mask] = s[mask ^ (1 << bit