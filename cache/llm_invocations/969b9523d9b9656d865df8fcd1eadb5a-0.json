include <cassert>\nusing namespace std;\n\ntypedef long long ll;\n\nconst ll MOD = 998244353;\n\nstruct NumberTheory {\n    static vector<ll> factorial;\n    static vector<ll> invFactorial;\n\n    static void initFactorial(int n) {\n        if (factorial.empty()) {\n            factorial.push_back(1);\n            invFactorial.push_back(1);\n        }\n        while (factorial.size() <= n) {\n            factorial.push_back(mult(factorial.back(), factorial.size()));\n        }\n        if (invFactorial.size() <= n) {\n            int last = invFactorial.size() - 1;\n            ll fInvN = inv(fact(n));\n            invFactorial.resize(n+1);\n            invFactorial[n] = fInvN;\n            for (int i = n-1; i > last; --i) {\n                invFactorial[i] = mult(invFactorial[i+1], i+1);\n            }\n        }\n    }\n\n    static ll fact(int n) {\n        initFactorial(n);\n        return factorial[n];\n    }\n\n    static ll fInv(int n) {\n        initFactorial(n);\n        return invFactorial[n];\n    }\n\n    static ll paritySign(ll k) {\n        return (k & 1) == 0 ? 1 : MOD - 1;\n    }\n\n    static ll ncr(int n, int r) {\n        assert(n >= 0);\n        if (r < 0 || n < r) return 0;\n        return mult(fact(n), mult(fInv(r), fInv(n-r)));\n    }\n\n    static ll normalize(ll x) {\n        x %= MOD;\n        if (x < 0) x += MOD;\n        return x;\n    }\n\n    static ll add(ll a, ll b) {\n        ll v = a + b;\n        return v < MOD ? v : v - MOD;\n    }\n\n    static ll mult(ll a, ll b) {\n        return (a % MOD) * (b % MOD) % MOD;\n    }\n\n    static ll mult(ll a, ll b, ll c) {\n        return mult(mult(a,b), c);\n    }\n\n    static ll pow(ll x, int e) {\n        if (e < 0) {\n            x = inv(x);\n            e = -e;\n        }\n        if (e == 0) return 1;\n        if (e & 1) return mult(x, pow(x, e-1));\n        return pow(mult(x,x), e/2);\n    }\n\n    static ll inv(ll value) {\n        ll g = MOD, x = 0, y = 1;\n        ll r = value;\n    