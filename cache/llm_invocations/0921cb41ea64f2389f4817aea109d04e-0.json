result[0] = 0;\n\n        for (int i = 1; i < n; i++) {\n            long val = (result[i - 1] * (i + 1)) % mod;\n            long[] inv = inversions.get(i - 1);\n\n            for (int j = 0; j < inv.length; j++) {\n                for (int k = j + 2; k < inv.length; k++) {\n                    long diff = k - j;\n                    long m = diff <= i + 1 ? diff : i + 1;\n                    long factor = (m - 1) * (2L * i - (m - 2)) / 2;\n                    val = (val + ((inv[j] * inv[k]) % mod) * factor) % mod;\n                }\n            }\n            result[i] = val;\n        }\n\n        System.out.println(result[n - 1]);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nvector<vector<long long>> solve(int n, int mod) {\n    vector<vector<long long>> inversions;\n    inversions.push_back({1});\n\n    for (int i = 1; i < n; i++) {\n        vector<long long> prev = inversions[i - 1];\n        int size = i * (i + 1) / 2 + 1;\n        vector<long long> curr(size, 0);\n\n        for (int j = 0; j < size; j++) {\n            long long sum = 0;\n            int upper = min(j, i);\n            for (int k = upper; k >= 0; k--) {\n                int idx = j - k;\n                if (idx < (int)prev.size()) {\n                    sum = (sum + prev[idx]) % mod;\n                }\n            }\n            curr[j] = sum;\n        }\n        inversions.push_back(curr);\n    }\n\n    vector<long long> result(n, 0);\n    result[0] = 0;\n\n    for (int i = 1; i < n; i++) {\n        long long val = (result[i - 1] * (i + 1)) % mod;\n        vector<long long> inv = inversions[i - 1];\n\n        for (int j = 0; j < (int)inv.size(); j++) {\n            for (int k = j + 2; k < (int)inv.size(); k++) {\n                long long diff = k - j;\n                long lon