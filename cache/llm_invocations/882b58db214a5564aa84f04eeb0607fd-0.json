s[v] + r[i].w) {\n                        int f = dfs(v, t, Math.min(fl, r[i].f));\n                        if (f > 0) {\n                            r[i].f -= f;\n                            r[i ^ 1].f += f;\n                            res += f;\n                            fl -= f;\n                        }\n                    }\n                }\n            }\n            vis[u] = false;\n            return res;\n        }\n        \n        int maxf;\n        long minw;\n        \n        void work(int s, int t) {\n            while (spfa(s, t)) {\n                int w = dfs(s, t, (int)INF);\n                maxf += w;\n                minw += (long)w * dis[s];\n            }\n        }\n    }\n    \n    static int id(int t, int x) {\n        return t * n + x + 2;\n    }\n    \n    static void work(int t) {\n        all += n;\n        for (int u = 1; u <= n; u++) {\n            for (int v : g[u]) {\n                for (int p = 1; p <= k; p++) {\n                    add(id(t, u), id(t + 1, v), 1, (long)d * (2 * p - 1));\n                }\n            }\n        }\n        for (int u = 1; u <= n; u++) {\n            add(id(t, u), id(t + 1, u), (int)INF, 0);\n        }\n        add(id(t + 1, 1), tt, (int)INF, (long)c * (t + 1));\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        all = n + 2;\n        for (int i = 1; i <= n; i++) {\n            g[i] = new ArrayList<>();\n        }\n        for (int i = 1; i <= k; i++) {\n            int a = sc.nextInt();\n            add(ss, id(0, a), 1, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            g[u].add(v);\n            g[v].add(u);\n        }\n        add(id(0, 1), tt, (int)INF, 0);\n        for (int i = 0; i <= n + k; i++) {\n       