r> a1 = sums(0, n1, 0, a, m);\n        List<Integer> a2 = sums(n1, n, 0, a, m);\n\n        Set<Integer> set = new HashSet<>(a1);\n        a1 = new ArrayList<>(set);\n        Collections.sort(a1);\n\n        int ans = 0;\n        for (int i : a2) {\n            int ip = Collections.binarySearch(a1, m - i);\n            if (ip < 0) {\n                ip = -ip - 1;\n            }\n            if (ip > 0) {\n                int cand = a1.get(ip - 1) + i;\n                if (cand > ans) {\n                    ans = cand;\n                }\n            }\n        }\n        System.out.println(ans);\n    }\n\n    private static List<Integer> sums(int idx, int end, int cur, int[] a, int m) {\n        if (idx == end) {\n            List<Integer> list = new ArrayList<>();\n            list.add(cur);\n            return list;\n        }\n        List<Integer> left = sums(idx + 1, end, (cur + a[idx]) % m, a, m);\n        List<Integer> right = sums(idx + 1, end, cur, a, m);\n        List<Integer> result = new ArrayList<>(left.size() + right.size());\n        result.addAll(left);\n        result.addAll(right);\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -7.533743337262422e-05, -4.637133679352701e-05, -2.3841855067985307e-07, -0.006715348921716213, -0.02988012507557869, -3.099436753473128e-06, 0.0, -0.006135438568890095, -2.1934269170742482e-05, -3.6954811548639555e-06, -0.003854228649288416, 0.0, -0.0003271759778726846, 0.0, 0.0, -5.960462772236497e-07, 0.0, -4.768370445162873e-07, -0.00020430385484360158, 0.0, -3.2186455882765586e-06, -0.25269412994384766, 0.0, 0.0, -4.768370445162873e-07, 0.0, 0.0, -8.583032467868179e-06, -6.198863957251888e-06, -9.762764238985255e-05, 0.0, -5.960462772236497e-07, 0.0, 0.0, -3.2186455882765586e-06, -1.1920928244535389e-07, -2.1457441107486375e-05, -5.960462772236497e-07, 0.0, 0.0, 0.0, -1.1920922133867862e-06, -6.198863957251888e-06, -0.01417543739080429, -2.3841