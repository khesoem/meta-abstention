\n        \n        List<Integer> a1 = new ArrayList<>();\n        List<Integer> a2 = new ArrayList<>();\n        int n1 = n / 2;\n        \n        sums1(a, a1, 0, 0, n1, m);\n        sums2(a, a2, n1, 0, n, m);\n        \n        // Remove duplicates and sort a1\n        Set<Integer> set = new HashSet<>(a1);\n        a1 = new ArrayList<>(set);\n        Collections.sort(a1);\n        \n        int ans = 0;\n        for (int i : a2) {\n            int j = Collections.binarySearch(a1, m - i);\n            if (j < 0) {\n                j = -j - 1;\n            }\n            if (j > 0) {\n                int candidate = a1.get(j - 1) + i;\n                if (ans < candidate) {\n                    ans = candidate;\n                }\n            }\n        }\n        \n        System.out.println(ans);\n    }\n    \n    private static void sums1(int[] a, List<Integer> result, int i, int sum, int n1, int m) {\n        if (i == n1) {\n            result.add(sum % m);\n        } else {\n            sums1(a, result, i + 1, sum + a[i], n1, m);\n            sums1(a, result, i + 1, sum, n1, m);\n        }\n    }\n    \n    private static void sums2(int[] a, List<Integer> result, int i, int sum, int n, int m) {\n        if (i == n) {\n            result.add(sum % m);\n        } else {\n            sums2(a, result, i + 1, sum + a[i], n, m);\n            sums2(a, result, i + 1, sum, n, m);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013720047718379647, -1.7881377516459906e-06, -2.3841855067985307e-07, -3.981510963058099e-05, -1.8596476365928538e-05, -0.011049510911107063, -0.4746473729610443, -6.6756979322235566e-06, -9.536738616588991e-07, -7.92710343375802e-05, -0.0021858150139451027, -9.775113539944869e-06, -0.15114061534404755, -1.311301275563892e-06, -0.0005413020844571292, -3.814689989667386e-06, -1.4305104514278355e-06, -2.0265558760002023e-06, -0.00017307691450696439, -2.145764938177308e-06, -8.22540732769994e-06,