            d[i] = Integer.MAX_VALUE;\n            inq = new int[n + 1];\n            Arrays.fill(inq, 0);\n            d[s] = 0;\n            inq[s] = 1;\n            p = new int[n + 1];\n            a = new int[n + 1];\n            Arrays.fill(a, Integer.MAX_VALUE);\n            Queue<Integer> Q = new LinkedList<>();\n            Q.add(s);\n            while (!Q.isEmpty()) {\n                int u = Q.poll();\n                inq[u] = 0;\n                for (int i = 0; i < g[u].size(); i++) {\n                    edge ee = e.get(g[u].get(i));\n                    if (ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost) {\n                        d[ee.to] = d[u] + ee.cost;\n                        p[ee.to] = g[u].get(i);\n                        a[ee.to] = Math.min(a[u], ee.cap - ee.flow);\n                        if (!inq[ee.to]) {\n                            Q.add(ee.to);\n                            inq[ee.to] = 1;\n                        }\n                    }\n                }\n            }\n            if (d[t] == Integer.MAX_VALUE)\n                return false;\n            flow[0] += a[t];\n            cost[0] += d[t] * a[t];\n            int u = t;\n            while (u != s) {\n                e.get(p[u]).flow += a[t];\n                e.get(p[u] ^ 1).flow -= a[t];\n                u = e.get(p[u]).from;\n            }\n            return true;\n        }\n\n        int minCost(int s, int t) {\n            int flow = 0, cost = 0;\n            while (bellman(s, t, new int[]{flow}, new int[]{cost}));\n            return cost[0];\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        int[] a = new int[k + 1];\n        for (int i = 1; i <= k; i++) {\n            a[i] = Integer.parseInt(br.readLine());\n        }\n        MCMF solve = new MCMF();\n        int startPoint = 0;\n        int endPoint = n * 100 + 1;\n        for (int i = 1; i <= k; i++) {\n            solve.add(startPoint, 1 + (a[i] - 1) * 100, 1, 0);\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                int p = (i - 1) * 100;\n                solve.add(p + j, p + j + 1, Integer.MAX_VALUE, d);\n            }\n        }\n        for (int i = 1; i <= 100; i++) {\n            solve.add(i, endPoint, Integer.MAX_VALUE, 0);\n        }\n        while (m-- > 0) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            for (int i = 1; i < 100; i++) {\n                int p = (x - 1) * 100 + i;\n                int pp = (y - 1) * 100 + i + 1;\n                for (int j = 1; j <= 50; j++) {\n                    solve.add(p, pp, 1, d * (j * j - (j - 1) * (j - 1)) + c);\n                }\n            }\n            for (int i = 1; i < 100; i++) {\n                int p = (y - 1) * 100 + i;\n                int pp = (x - 1) * 100 + i + 1;\n                for (int j = 1; j <= 50; j++) {\n                    solve.add(p, pp, 1, d * (j * j - (j - 1) * (j - 1)) + c);\n                }\n            }\n        }\n        pw.println(solve.minCost(startPoint, endPoint));\n        pw.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.2034681886434555, -0.005436748266220093, -0.2267811894416809, -0.009084776043891907, -0.00022431743855122477, -0.5764688849449158, -0.5582977533340454, -6.878612475702539e-05, -1.0013630344474223e-05, -1.5378116586362012e-05, -1.5974172