routines\n  struct Edge { int v, r; ll f, c, p; };\n  vector<Edge> adj[N]; int sz[N]; ll mc;\n  void init(int n=N) { mc=0; fill(sz,sz+n,0); fill(adj,adj+n,vector<Edge>()); }\n  void add_edge(int a, int b, ll c=1, ll p=0) { mc = max(mc,c);\n    adj[a].push_back({b, sz[b]++, 0, c, p});\n    adj[b].push_back({a, sz[a]++, 0, 0, -p}); }  // change 0 to c for undirected\n\n  // Minimum cost maximum flow, assuming there are no negative cost cycles\n  // USAGE: 1) add edges 2) min_cost_flow(S, T, price, V, sparse?);\n  // use O(V^2) Dijkstra for dense graphs, and O(E*log(V)) otherwise\n  bool vis[N]; int par[N]; ll pot[N], dist[N];\n  void pot_init(int n) { fill(pot, pot+n, 0);\n    // if all edge costs >= 0, we don't need to run the Bellman-Ford here\n    for(int i=1; i<n; i++) for(int u=0; u<n; u++) for(const Edge& e:adj[u])\n      if(e.c) pot[e.v] = min(pot[e.v], pot[u] + e.p); }\n  ll mcf(int s, int t, ll& price, int n, bool sparse) {\n    fill(vis, vis+n, 0); fill(dist, dist+n, INF); dist[s] = 0;\n    // only need one of the branches below\n    if(sparse) { // replace priority_queue with queue for SPFA\n      queue<int> dk; dk.push(s); while(!dk.empty()) {\n        int u = dk.front(); dk.pop(); if(vis[u]) continue;\n        for(const Edge& e:adj[u]) {\n          if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r;\n            dk.push(e.v); } } }\n    } else { // dense\n      for(int u = s; u != -1; ) { vis[u] = true; for(const Edge& e: adj[u]) {\n        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n          dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p; par[e.v] = e.r; } }\n        u = -1; ll best = INF;\n        for(int i=0; i<n; i++) if(!vis[i] && dist[i]<best) best = dist[u=i]; }\n    } // end branches\n    if (dist[t] >= INF) { return 0; } ll df = INF;\n    for(int u = t; u != s; ) { const Edge& r = adj[u][par[u]];\n      df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f); u = r.v; }\n    for(int u = t; u != s; ) { Edge& r=adj[u][par[u]], &e=adj[r.v][r.r];\n      e.f += df; r.f -= df; price += df*e.p; u = r.v; }\n    for(int i=0; i<n; i++) { pot[i] = min(INF, dist[i]+pot[i]); } return df; }\n  ll min_cost_flow(int s, int t, ll& price, int n=N, bool sparse=false) {\n    pot_init(n); ll flow = price = 0;\n    while(ll df=mcf(s, t, price, n, sparse)) { flow += df; } return flow; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tll price, flow = Flow::min_cost_flow(source, sink, price, sink+1, true);\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nfrom collections import deque\nINF = 10**18\n\nclass Flow:\n    def __init__(self, N):\n        self.N = N\n        self.adj = [[] for _ in range(N)]\n        self.mc = 0\n\n    def add_edge(self, a, b, c=1, p=0):\n        if c > self.mc:\n            self.mc = c\n        self.adj[a].append([b, len(self.adj[b]), 0, c, p])\n        self.adj[b].append([a, len(self.adj[a]) - 1, 0, 0, -p])\n\n    def pot_init(self, n):\n        self.pot = [0] * n\n        for _ in range(1, n):\n            updated = False\n            for u in range(n):\n                for e in self.adj[u]:\n                    if e[3] > 0:  # capacity > 0\n                        if self.pot[e[0]] > self.pot[u] + e[4]:\n                            self.pot[e[0]] = self.pot[u] + e[4]\n                            updated = True\n            if not updated:\n                break\n\n    def mcf(self, s, t, n, sparse):\n        self.vis = [False] * n\n        self.dist = [INF] * n\n        self.dist[s] = 0\n        self.par = [-1] * n\n        if sparse:\n            q = deque([s])\n            while q:\n                u = q.popleft()\n                if self.vis[u]:\n                    continue\n                self.vis[u] = True\n                for e in self.adj[u]:\n                    if e[2] < e[3]:  # flow < capacity\n                        nd = self.dist[u] + self.pot[u] - self.pot[e[0]] + e[4]\n                        if self.dist[e[0]] > nd:\n                            self.dist[e[0]] = nd\n                            self.par[e[0]] = e[1]\n                            q.append(e[0])\n        else:\n            for _ in range(n):\n                u = -1\n                best = INF\n                for i in range(n):\n                    if not self.vis[i] and self.dist[i] < best:\n                        best = self.dist[i]\n                        u = i\n                if u == -1:\n                    break\n                self.vis[u] = True\n                for e in self.adj[u]:\n                    if e[2] < e[3]:\n                        nd = self.dist[u] + self.pot[u] - self.pot[e[0]] + e[4]\n                        if self.dist[e[0]] > nd:\n                            self.dist[e[0]] = nd\n                            self.par[e[0]] = e[1]\n        if self.dist[t] >= INF:\n            return 0\n        df = INF\n        u = t\n        while u != s:\n            rev_e = self.adj[u][self.par[u]]\n            e = self.adj[rev_e[0]][rev_e[1]]\n            df = min(df, e[3] - e[2])\n            u = rev_e[0]\n        u = t\n        while u != s:\n            rev_e = self.adj[u][self.par[u]]\n            e = self.adj[rev_e[0]][rev_e[1]]\n            e[2] += df\n            rev_e[2] -= df\n            self.price += df * e[4]\n            u = rev_e[0]\n        for i in range(n):\n            self.pot[i] = min(INF, self.dist[i] + self.pot[i])\n        return df\n\n    def min_cost_flow(self, s, t, n, sparse=False):\n        self.pot_init(n)\n        self.price = 0\n        flow = 0\n        while True:\n            df = self.mcf(s, t, n, sparse)\n            if df == 0:\n                break\n            flow += df\n        return flow, self.price\n\ndef main():\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    T = 99\n    C = 12\n    flow_N = 50 * T + 2\n    source = 0\n    sink = n * T + 1\n\n    flow_net = Flow(flow_N)\n\n    for _ in range(k):\n        a = int(next(it))\n        flow_net.add_edge(source, a, 1, 0)\n\n    for t in range(T):\n        flow_net.add_edge(1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow_net.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                flow_net.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow_net.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    flow, price = flow_net.min_cost_flow(source, sink, sink + 1, True)\n    # assert flow == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.394739e-05, 0.0, -9.5367386e-07, -0.00021753329, -0.0524426