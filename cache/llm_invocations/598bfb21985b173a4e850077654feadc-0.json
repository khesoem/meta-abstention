int[]{2 * N, 2 * N});\n            int cur = 0;\n            int[] dp0 = new int[N + 1];\n            int[] dp1 = new int[N + 1];\n            Arrays.fill(dp0, MAX);\n            Arrays.fill(dp1, MAX);\n            dp0[0] = 0;\n            for (int i = 0; i < interval.size(); i++) {\n                int[] seg = interval.get(i);\n                int diff = seg[0] - cur;\n                for (int j = N; j >= 0; j--) {\n                    int prev = j - diff;\n                    dp0[j] = (prev >= 0) ? dp0[prev] : MAX;\n                }\n                cur = seg[1];\n                int sz = seg[1] - seg[0];\n                for (int j = N; j >= 0; j--) {\n                    int[] put = new int[2];\n                    for (int z = 0; z <= 1; z++) {\n                        int[] curDp = (z == 0) ? dp0 : dp1;\n                        int[] otherDp = (z == 0) ? dp1 : dp0;\n                        int twoSwaps = query(curDp, j - sz, j, MAX);\n                        int oneSwap = query(otherDp, j - sz, j, MAX);\n                        int noSwap;\n                        if (z == 1) {\n                            noSwap = curDp[j];\n                        } else {\n                            noSwap = (j - sz >= 0) ? curDp[j - sz] : MAX;\n                        }\n                        put[z] = Math.min(twoSwaps + 2, Math.min(oneSwap + 1, noSwap));\n                    }\n                    dp0[j] = put[0];\n                    dp1[j] = put[1];\n                }\n            }\n            int ans = Math.min(dp0[N], dp1[N]);\n            if (ans >= MAX) {\n                out.println(\"Hungry\");\n            } else {\n                out.println(\"Full\");\n                out.println(ans);\n            }\n        }\n\n        private int query(int[] arr, int l, int r, int MAX) {\n            if (r < 0) return MAX;\n            l = Math.max(0, l);\n            if (l > r) return MAX;\n            int min = MAX;\n            for (int i = l; i <= r; i++) {\n    