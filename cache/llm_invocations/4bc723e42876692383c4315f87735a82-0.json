);\n    \n    static int s = N - 2;\n    static int t = N - 1;\n    \n    static int rem(int x) {\n        return e.get(x).c - e.get(x).f;\n    }\n    \n    static void push_flow() {\n        for(int i = 0; i < N; i++) {\n            d[i] = INF64;\n            p[i] = -1;\n            pe[i] = -1;\n            inq[i] = 0;\n        }\n        d[s] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        inq[s] = 1;\n        \n        while(!q.isEmpty()) {\n            int k = q.poll();\n            inq[k] = 0;\n            for(int x : g[k]) {\n                if(rem(x) == 0) continue;\n                int c = e.get(x).cost;\n                int y = e.get(x).y;\n                if(d[y] > d[k] + c) {\n                    d[y] = d[k] + c;\n                    p[y] = k;\n                    pe[y] = x;\n                    if(inq[y] == 0) {\n                        inq[y] = 1;\n                        q.offer(y);\n                    }\n                }\n            }\n        }\n        \n        int cur = t;\n        while(cur != s) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = p[cur];\n        }\n        ans += d[t];\n    }\n    \n    static void add_edge(int x, int y, int c, int cost) {\n        g[x].add(e.size());\n        e.add(new Edge(y, c, 0, cost));\n        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        for(int i = 0; i < N; i++) {\n            g[i] = new ArrayList<>();\n        }\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d_val = sc.nextInt();\n        \n        for(int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            --x;\n            add_edge(s, x, 1, 0);\n        }\n        \n        int tt = 101;\n        for(int i = 0; i < tt; i++) {\n            add_edge(0 + i * n, t, k, i * c);\n        }\n        \n        for(int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            --x;\n            --y;\n            for(int i_layer = 0; i_layer < tt - 1; i_layer++) {\n                for(int j = 0; j < k; j++) {\n                    add_edge(x + i_layer * n, y + i_layer * n + n, 1, d_val * (j * 2 + 1));\n                }\n                for(int j = 0; j < k; j++) {\n                    add_edge(y + i_layer * n, x + i_layer * n + n, 1, d_val * (j * 2 + 1));\n                }\n            }\n        }\n        \n        for(int i = 0; i < n; i++) {\n            for(int j = 0; j < tt - 1; j++) {\n                add_edge(i + j * n, i + j * n + n, k, 0);\n            }\n        }\n        \n        for(int i = 0; i < k; i++) {\n            push_flow();\n        }\n        \n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019107422849629074, -5.960446742392378e-06, -1.6689286894688848e-06, -0.0008519833791069686, -5.531158240046352e-05, -0.00976181123405695, -0.023499436676502228, -8.821448318485636e-06, -5.960462772236497e-07, -5.674201020156033e-05, -0.05488354712724686, -0.0036052961368113756, -0.0007627676823176444, -0.02781204879283905, -7.879423355916515e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, -1.883488948806189e-05, -3.576278118089249e-07, -0.0011749514378607273, -7.510157047363464e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -0.00010787858627736568, -4.541770613286644e-05, -3.313963316031732e-05, -0.005932342726737261, -0.010190009139478207, -1.6689286894688848e-06, -1.2874520507466514e-05, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -3.6954811548639555e-06, 0.0, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, -1.1920922133867862e-06, -8.344646857949556e-07, -3.576278118089249e-07, -0.0004886387032