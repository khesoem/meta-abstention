ix):\n    for i in range(mm_n):\n        for j in range(mm_n):\n            matrix[i][j] = ((matrix[i][j] % MO) + MO) % MO\n\ndef multiply(A, B):\n    global mm_n\n    temp = [[0] * MM_N for _ in range(MM_N)]\n    INF = 8 * 10**18\n    for k in range(mm_n):\n        for i in range(mm_n):\n            for j in range(mm_n):\n                temp[i][j] += A[i][k] * B[k][j]\n                if temp[i][j] >= INF:\n                    temp[i][j] %= MO\n    C = [[0] * MM_N for _ in range(MM_N)]\n    for i in range(mm_n):\n        for j in range(mm_n):\n            C[i][j] = temp[i][j] % MO\n    return C\n\ndef matrix_pow(base, exp):\n    global mm_n\n    normalize_matrix(base)\n    result = [row[:] for row in identity]\n    while exp:\n        if exp & 1:\n            result = multiply(result, base)\n        base = multiply(base, base)\n        exp >>= 1\n    return result\n\ndef init_matrix(size):\n    global mm_n, identity\n    mm_n = size\n    for i in range(mm_n):\n        for j in range(mm_n):\n            identity[i][j] = 0\n    for i in range(mm_n):\n        identity[i][i] = 1\n\ndef shift_matrix(M, d):\n    global mm_n\n    res = [[0] * MM_N for _ in range(MM_N)]\n    for i in range(mm_n):\n        for j in range(mm_n):\n            ni = (i + d) % mm_n if i != mm_n - 1 else mm_n - 1\n            nj = (j + d) % mm_n if j != mm_n - 1 else mm_n - 1\n            res[ni][nj] = M[i][j]\n    return res\n\ndef main():\n    global n, k, digits, digit_count\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    \n    init_matrix(k + 1)\n    \n    digits = []\n    while n:\n        digits.append(n % k)\n        n //= k\n    \n    digit_count = len(digits)\n    \n    A = []\n    # Initialize A[0]\n    A0 = [[0] * MM_N for _ in range(MM_N)]\n    for j in range(k + 1):\n        A0[0][j] = 1\n        A0[j][j] = 1\n    A.append(A0)\n    \n    for i in range(1, digit_count):\n        cur = [row[:] for row in identity]