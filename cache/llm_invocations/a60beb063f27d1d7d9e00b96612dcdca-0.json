 aliceLine = sc.nextLine().trim();\n        String bobLine = sc.nextLine().trim();\n        \n        String[] aliceParts = aliceLine.split(\" \");\n        String[] bobParts = bobLine.split(\" \");\n        \n        List<Integer> alice = new ArrayList<>();\n        List<Integer> bob = new ArrayList<>();\n        \n        for (String s : aliceParts) {\n            alice.add(Integer.parseInt(s));\n        }\n        for (String s : bobParts) {\n            bob.add(Integer.parseInt(s));\n        }\n        \n        // Rotate bob left by 1 (equivalent to Python's deque.rotate(-1))\n        Collections.rotate(bob, -1);\n        \n        int maxWin = 0;\n        int minWin = 0;\n        \n        // Compute maxWin and also find max values\n        int maxAlice = Collections.max(alice);\n        int maxBob = Collections.max(bob);\n        \n        for (int i = 0; i < alice.size(); i++) {\n            int a = alice.get(i);\n            int b = bob.get(i);\n            maxWin += Math.min(a, b);\n        }\n        \n        // Compute minWin\n        for (int i = 0; i < alice.size(); i++) {\n            int a = alice.get(i);\n            int b = bob.get(i);\n            if (b == maxBob) {\n                minWin = Math.max(minWin, a + b);\n            }\n            if (a == maxAlice) {\n                minWin = Math.max(minWin, a + b);\n            }\n        }\n        \n        if (minWin > turnNum) {\n            minWin -= turnNum;\n        } else {\n            minWin = 0;\n        }\n        \n        System.out.println(minWin + \" \" + maxWin);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-7.152555099310121e-07, 0.0, 0.0, -1.2516897186287679e-05, -0.0002212279650848359, 0.0, -6.198863957251888e-06, -0.0020367607939988375, -2.0265558760002023e-06, 0.0, -8.4638240878121e-06, -1.7881233361549675e-05, -1.7881377516459906e-06, -3.576278118089249e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.7881377516459906e-06, 0.0, -3.57627