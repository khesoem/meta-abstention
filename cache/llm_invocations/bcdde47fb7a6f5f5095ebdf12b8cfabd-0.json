 for _ in range(n)]\n    grid2 = [list(next(it).strip()) for _ in range(n)]\n\n    INF = 1000\n    dist = [[INF] * n for _ in range(n)]\n\n    # find start 'Z'\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if grid1[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n\n    dx = [-1, 0, 1, 0, 0]\n    dy = [0, 1, 0, -1, 0]\n\n    def valid(x, y):\n        return 0 <= x < n and 0 <= y < n\n\n    def digit(c):\n        return '0' <= c <= '9'\n\n    # BFS from start to digit cells\n    q = deque()\n    dist[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for d in range(4):\n            nx, ny = x + dx[d], y + dy[d]\n            if valid(nx, ny) and digit(grid1[nx][ny]) and dist[nx][ny] == INF:\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n\n    # reachability over time steps\n    reach = [[[[[False] * n for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(t)]\n\n    # initialize k=0\n    for i in range(n):\n        for j in range(n):\n            for d in range(5):\n                ni, nj = i + dx[d], j + dy[d]\n                if valid(ni, nj) and digit(grid1[i][j]) and digit(grid1[ni][nj]):\n                    reach[0][i][j][ni][nj] = True\n\n    # propagate\n    for k in range(t - 1):\n        for i in range(n):\n            for j in range(n):\n                for l in range(n):\n                    for m in range(n):\n                        if not reach[k][i][j][l][m]:\n                            continue\n                        for d in range(5):\n                            nl, nm = l + dx[d], m + dy[d]\n                            if valid(nl, nm) and digit(grid1[nl][nm]) and dist[l][m] >= k + 2 and dist[nl][nm] >= k + 2:\n                                reach[k + 1][i][j][nl][nm] = True\n\n    # collect digit cells from grid1\n    cells = [(i, j) for i in range(n) for j in range(n) if digit(grid1[i][j])]\n    V = 2 * len(cells) + 2\n    graph = [[] for _ in range(V)]\n\n    # source and sink edges\n    for idx, (x, y) in enumerate(cells):\n        c1 = int(grid1[x][y])\n        graph[0].append([idx + 1, c1])\n        graph[idx + 1].append([0, 0])\n        c2 = int(grid2[x][y])\n        graph[len(cells) + 1 + idx].append([V - 1, c2])\n        graph[V - 1].append([len(cells) + 1 + idx, 0])\n\n    # edges between left and right nodes if reachable\n    for i, (x1, y1) in enumerate(cells):\n        for j, (x2, y2) in enumerate(cells):\n            ok = False\n            for k in range(t):\n                if reach[k][x1][y1][x2][y2]:\n                    ok = True\n                    break\n            if ok:\n                graph[i + 1].append([len(cells) + 1 + j, 1000])\n                graph[len(cells) + 1 + j].append([i + 1, 0])\n\n    # max flow (Edmonds-Karp)\n    flow = 0\n    while True:\n        visited = [False] * V\n        parent = [-1] * V\n        q = deque()\n        visited[0] = True\n        q.append(0)\n        while q:\n            u = q.popleft()\n            for v, cap in graph[u]:\n                if not visited[v] and cap > 0:\n                    visited[v] = True\n                    parent[v] = u\n                    q.append(v)\n        if parent[V - 1] == -1:\n            break\n\n        # find bottleneck\n        inc = 1000\n        v = V - 1\n        while v != 0:\n            u = parent[v]\n            for edge in graph[u]:\n                if edge[0] == v:\n                    inc = min(inc, edge[1])\n                    break\n            v = u\n\n        # update capacities\n        v = V - 1\n        while v != 0:\n            u = parent[v]\n            for edge in graph[u]:\n                if edge[0] == v:\n                    edge[1] -= inc\n                    break\n            for edge in graph[v]:\n                if edge[0] == u:\n                    edge[1] += inc\n                    break\