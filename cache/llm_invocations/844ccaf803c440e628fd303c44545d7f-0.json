for (int i = 0; i < n; i++) {\n            if (i != 0 && even == odd) {\n                differences.add(Math.abs(values[i] - values[i - 1]));\n            }\n            if (values[i] % 2 == 0) {\n                even++;\n            } else {\n                odd++;\n            }\n        }\n        \n        Collections.sort(differences);\n        int count = 0;\n        for (int diff : differences) {\n            if (k >= diff) {\n                count++;\n                k -= diff;\n            } else {\n                break;\n            }\n        }\n        return count;\n    }\n}\n\npublic class AlternativeSolution {\n    public static void main(String[] args) throws Exception {\n        CustomReader reader = new CustomReader();\n        int n = reader.nextInt();\n        int k = reader.nextInt();\n        int[] values = new int[n];\n        for (int i = 0; i < n; i++) {\n            values[i] = reader.nextInt();\n        }\n        \n        ProblemSolver solver = new ProblemSolver();\n        System.out.println(solver.solve(n, k, values));\n    }\n\n    static int gcd(int a, int b) {\n        return b == 0 ? a : gcd(b, a % b);\n    }\n\n    static int lcm(int a, int b) {\n        return a * (b / gcd(a, b));\n    }\n\n    static int modExp(int base, int exp, int mod) {\n        if (base == 0) return 0;\n        if (exp == 0) return 1;\n        long result;\n        if (exp % 2 == 0) {\n            result = modExp(base, exp / 2, mod);\n            result = (result * result) % mod;\n        } else {\n            result = base % mod;\n            result = (result * modExp(base, exp - 1, mod)) % mod;\n        }\n        return (int) ((result + mod) % mod);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nclass CustomReader:\n    def __init__(self):\n        self.bufferedReader = sys.stdin\n        self.tokenizer = []\n\n    def nextInt(self):\n        return int(self.next())\n\n    def next(self):\n        while not self.tokenizer:\n            line = self.bufferedReader.readline()\n            if not line:\n                raise EOFError(\"No more input\")\n            self.tokenizer = line.strip().split()\n        return self.tokenizer.pop(0)\n\n    def nextLong(self):\n        return int(self.next())\n\n    def nextDouble(self):\n        return float(self.next())\n\n    def nextLine(self):\n        line = self.bufferedReader.readline()\n        if not line:\n            raise EOFError(\"No more input\")\n        return line.strip()\n\nclass ProblemSolver:\n    def solve(self, n, k, values):\n        even = 0\n        odd = 0\n        differences = []\n        \n        for i in range(n):\n            if i != 0 and even == odd:\n                differences.append(abs(values[i] - values[i - 1]))\n            if values[i] % 2 == 0:\n                even += 1\n            else:\n                odd += 1\n        \n        differences.sort()\n        count = 0\n        for diff in differences:\n            if k >= diff:\n                count += 1\n                k -= diff\n            else:\n                break\n        return count\n\ndef gcd(a, b):\n    return a if b == 0 else gcd(b, a % b)\n\ndef lcm(a, b):\n    return a * (b // gcd(a, b))\n\ndef modExp(base, exp, mod):\n    if base == 0:\n        return 0\n    if exp == 0:\n        return 1\n    if exp % 2 == 0:\n        result = modExp(base, exp // 2, mod)\n        result = (result * result) % mod\n    else:\n        result = base % mod\n        result = (result * modExp(base, exp - 1, mod)) % mod\n    return int((result + mod) % mod)\n\ndef main():\n    reader = CustomReader()\n    n = reader.nextInt()\n    k = reader.nextInt()\n    values = [reader.nextInt() for _ in range(n)]\n    \n    solver = ProblemSolver()\n    print(solver.solve(n, k, values))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>