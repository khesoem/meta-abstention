                self.cost_graph.append(Edge(i, j, self.cost[i][j]))\n\n        self.d[self.src] = 0\n        changed = False\n        for _ in range(self.v_num - 1):\n            for e in self.cost_graph:\n                if self.d[e.from_] != float('inf') and self.d[e.from_] + e.cost < self.d[e.to]:\n                    self.d[e.to] = self.d[e.from_] + e.cost\n                    self.p[e.to] = e.from_\n                    changed = True\n            if not changed:\n                break\n\n        return self.p[self.sink] != -1\n\n    def augment_path(self, from_, to, flow):\n        path_cost = 0\n        for cur in range(to, from_, -1):\n            flow = min(flow, self.res[self.p[cur]][cur])\n        for cur in range(to, from_, -1):\n            self.res[self.p[cur]][cur] -= flow\n            self.res[cur][self.p[cur]] += flow\n            path_cost += self.cost[self.p[cur]][cur] * flow\n        return [flow, path_cost]\n\n    def get_min_cost_max_flow(self):\n        flow = 0\n        total_cost = 0\n        while self.find_cheapest_path():\n            result = self.augment_path(self.src, self.sink, float('inf'))\n            flow += result[0]\n            total_cost += result[1]\n        return [flow, total_cost]\n\ndef main():\n    in_reader = InputReader()\n    out_writer = OutputWriter(sys.stdout)\n    letters = ord('z') - ord('a') + 1\n    n = in_reader.next_int()\n    s = in_reader.next()\n    string = list(s)\n    let_count = [0 for _ in range(letters)]\n    for i in range(n):\n        let_count[ord(string[i]) - ord('a')] += 1\n    b = [in_reader.next_int() for _ in range(n)]\n    source = 0\n    char_offset = 1\n    pair_offset = char_offset + letters\n    sink_offset = pair_offset + n // 2\n    sink = sink_offset\n    v_num = sink_offset + 1\n\n    g = Graph(v_num, source, sink)\n    for i in range(letters):\n        g.add_edge(source, char_offset + i, let_count[i], 0)\n        for j in range(n // 2):\n            c1 = string[j]\n            c2 = string[n - j - 1]\n            if c1 == chr(ord('a') + i):\n                if c1 == c2:\n                    g.add_edge(char_offset + i, pair_offset + j, 1, -max(b[j], b[n - j - 1]))\n                else:\n                    g.add_edge(char_offset + i, pair_offset + j, 1, -b[j])\n            else:\n                if c2 == chr(ord('a') + i):\n                    g.add_edge(char_offset + i, pair_offset + j, 1, -b[n - j - 1])\n                else:\n                    g.add_edge(char_offset + i, pair_offset + j, 1, 0)\n    for i in range(n // 2):\n        g.add_edge(pair_offset + i, sink, 2, 0)\n\n    ans = g.get_min_cost_max_flow()\n    out_writer.println(-ans[1])\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.05802198126912117, -0.0002538884000387043, -0.03931441158056259, -0.16683685779571533, -0.02680484764277935, -0.6945473551750183, -0.6040951013565063, -0.8946921825408936, -1.1086525773862377e-05, -0.0008499657269567251, -0.3105836510658264, -0.01273324154317379, -0.6844393014907837, -0.004088941961526871, -0.0026463086251169443, -0.0028990169521421194, -0.009365408681333065, -0.0006484106997959316, -8.106264431262389e-06, -9.536747711536009e-07, -9.417578439752106e-06, -0.42981600761413574, -0.7225872278213501, -0.10190250724554062, -0.00010288290650350973, -0.0003668742720037699, -0.0008392278105020523, -1.025205165205989e-05, -0.0020462931133806705, -0.01991279609501362, -0.00012577371671795845, -8.77418860909529e-05, -0.13109901547431946, -0.0009777556406334043, -7.391003236989491e-06, -0.006753368768841028, -0.6350523233413696, -0.011220465414226055, -1.6808651707833633e-05, -0.11665365099906921, -0.43099838495254517, -0.6931531429290771, -0.026311015710234642, -0.01255360059440136, -2.694166323635727e-05, -0.0641617625951767, -2.5391900635440834e-05, -0.00020488214795477688, -0.000528654083609581, -0.013970654457807541, -2.98023678624304e-06, -3.4570753086882178e-06, -0.00020