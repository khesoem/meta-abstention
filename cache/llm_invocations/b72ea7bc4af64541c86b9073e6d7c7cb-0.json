er == null || !tokenizer.hasMoreTokens()) {\n                tokenizer = new StringTokenizer(reader.readLine());\n            }\n            return tokenizer.nextToken();\n        }\n        \n        int nextInt() {\n            try {\n                return Integer.parseInt(nextToken());\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n        \n        long nextLong() {\n            try {\n                return Long.parseLong(nextToken());\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n        \n        double nextDouble() {\n            try {\n                return Double.parseDouble(nextToken());\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n        \n        String nextLine() {\n            try {\n                return reader.readLine();\n            } catch (IOException e) {\n                throw new RuntimeException(e);\n            }\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\n\nconst long long MOD = 998244353LL;\nvector<long long> fact;\n\nlong long modPow(long long base, long long exp, long long mod) {\n    long long result = 1LL;\n    base %= mod;\n    while (exp > 0) {\n        if ((exp & 1) == 1) {\n            result = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nlong long modInverse(long long a, long long mod) {\n    return modPow(a, mod - 2, mod);\n}\n\nlong long nCr(int n, int r) {\n    if (r < 0 || r > n) return 0LL;\n    if (r == 0 || r == n) return 1LL;\n    long long denominator = (fact[r] *