n            qt = 0\n            q[qt] = s\n            qt += 1\n            d[s] = 0\n            while qh != qt:\n                v = q[qh]\n                qh += 1\n                if qh == n:\n                    qh = 0\n                id[v] = 2\n                for i, e in enumerate(self.g[v]):\n                    if e.flow < e.cap and d[v] + e.cost < d[e.to]:\n                        d[e.to] = d[v] + e.cost\n                        if id[e.to] == 0:\n                            q[qt] = e.to\n                            qt += 1\n                            if qt == n:\n                                qt = 0\n                        elif id[e.to] == 2:\n                            qh -= 1\n                            if qh == -1:\n                                qh = n - 1\n                            q[qh] = e.to\n                        id[e.to] = 1\n                        p[e.to] = v\n                        p_edge[e.to] = i\n            if d[t] == INF:\n                break\n            add = maxf - flow\n            v = t\n            while v != s:\n                pv = p[v]\n                pe = p_edge[v]\n                add = min(add, self.g[pv][pe].cap - self.g[pv][pe].flow)\n                v = pv\n            v = t\n            while v != s:\n                pv = p[v]\n                pe = p_edge[v]\n                rev = self.g[pv][pe].rev\n                self.g[pv][pe].flow += add\n                self.g[v][rev].flow -= add\n                cost += self.g[pv][pe].cost * add\n                v = pv\n            flow += add\n        return (flow, cost)\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n_vertices = next(it)\n    m_edges = next(it)\n    num_people = next(it)\n    c_cost = next(it)\n    d_cost = next(it)\n\n    tim = 99\n    total_nodes = 50 * tim + 1  # source 0 + tim*50 nodes (nodes 1..50*tim)\n    mcf = MinCostFlow(total_nodes)\n\n    # initial positions\n    init_pos = [0] * (num_people + 1)\n    for i in range(1, num_people + 1):\n        init_pos[i] = next(it)\n        mcf.add_edge(0, init_pos[i], 1, 0)\n\n    # waiting edges (except vertex 1)\n    for j in range(tim - 1):\n        for i in range(2, n_vertices + 1):\n            mcf.add_edge(j * 50 + i, (j + 1) * 50 + i, 50, c_cost)\n\n    # arrival edges to sink (node 1)\n    for j in range(1, tim):\n        mcf.add_edge(j * 50 + 1, 1, 50, 0)\n\n    # movement edges\n    for _ in range(m_edges):\n        x = next(it)\n        y = next(it)\n        for j in range(tim - 1):\n            for l in range(50):\n                cost = c_cost + d_cost * ((l + 1) * (l + 1) - l * l)\n                mcf.add_edge(j * 50 + x, (j + 1) * 50 + y, 1, cost)\n                mcf.add_edge(j * 50 + y, (j + 1) * 50 + x, 1, cost)\n\n    s = 0\n    t = 1\n    res = mcf.min_cost_flow(s, t, 10**18)\n    print(res[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.9430925021879375e-05, 0.0, -1.1920928244535389e-07, -0.00033849707688204944, -0.00020859450160060078, -1.7881377516459906e-06, -0.1002325713634491, -0.032432448118925095, -0.20141664147377014, -4.768370445162873e-07, -3.3378546504536644e-06, -0.4741002917289734, 0.0, -3.576278118089249e-07, -5.960462772236497e-07, -2.622600959512056e-06, -0.0044023506343364716, 0.0, -0.00020346954988781363, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, 0.0, 0.0, -1.1920928244535389e-07, -7.152555099310121e-07, -3.576278118089249e-07, 0.0, -1.3828182090946939e-05, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.0728830375228426e-06, -5.960462772236497e-07, -0.003196252044290304, 0.0, -4.768370445162873e-07, 0.0, -0.0007103541865944862, -0.018154878169298172, -1.549708758830093e-05, 0.0, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.311301275563892e-06, -2.9802276912960224e-06, -0.0007487116381525993, 0.0, 0.0, 0.0, 0.0, -2.384