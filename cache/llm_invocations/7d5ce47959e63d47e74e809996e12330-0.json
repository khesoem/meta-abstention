{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int MAX_N = 250005;\nint n, k, mod;\nusing ll = long long;\n\nll modPow(ll base, ll exp) {\n    ll result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\ninline int getLowbit(int x) { return x & -x; }\n\nll factorial[MAX_N], invFactorial[MAX_N];\nll memo[26][MAX_N];\n\nll solve(int position, int mask) {\n    if (memo[position][mask] != -1) return memo[position][mask];\n    \n    if (mask == 0) {\n        memo[position][mask] = factorial[n];\n        for (int i = 0; i < position; ++i) {\n            memo[position][mask] = (memo[position][mask] * (k - i)) % mod;\n        }\n        return memo[position][mask];\n    }\n    \n    memo[position][mask] = 0;\n    int submask = mask - getLowbit(mask);\n    \n    for (int subset = submask; subset > 0; subset = (subset - 1) & submask) {\n        memo[position][mask] = (memo[position][mask] + invFactorial[mask - subset] * solve(position + 1, subset)) % mod;\n    }\n    \n    memo[position][mask] = (memo[position][mask] + invFactorial[mask] * solve(position + 1, 0)) % mod;\n    return memo[position][mask];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> mod;\n    ll total = modPow(k, n);\n    \n    if (n % 2 == 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    factorial[0] = 1;\n    for (int i = 1; i <= n; ++i) factorial[i] = factorial[i-1] * i % mod;\n    \n    invFactorial[n] = modPow(factorial[n], mod - 2);\n    for (int i = n; i >= 1; --i) {\n        invFactorial[i-1] = invFactorial[i] * i % mod;\n    }\n    \n    memset(memo, -1, sizeof(memo));\n    ll subtract = solve(0, n);\n    ll result = (total - subtract + mod) % mod;\n    cout << result << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(1000000)\n\ndef modPow(base, exp, mod):\n    result = 1\n    base %= mod\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return result\n\ndef getLowbit(x):\n    return x & -x\n\ndef solve(position, mask, n, k, mod, factorial, invFactorial, memo):\n    if memo[position][mask] != -1:\n        return memo[position][mask]\n    \n    if mask == 0:\n        memo[position][mask] = factorial[n]\n        for i in range(position):\n            memo[position][mask] = (memo[position][mask] * (k - i)) % mod\n        return memo[position][mask]\n    \n    memo[position][mask] = 0\n    submask = mask - getLowbit(mask)\n    \n    subset = submask\n    while subset > 0:\n        memo[position][mask] = (memo[position][mask] + invFactorial[mask - subset] * solve(position + 1, subset, n, k, mod, factorial, invFactorial, memo)) % mod\n        subset = (subset - 1) & submask\n    \n    memo[position][mask] = (memo[position][mask] + invFactorial[mask] * solve(position + 1, 0, n, k, mod, factorial, invFactorial, memo)) % mod\n    return memo[position][mask]\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    n = int(input_data[0])\n    k = int(input_data[1])\n    mod = int(input_data[2])\n    \n    total = modPow(k, n, mod)\n    \n    if n % 2 == 1:\n        print(total)\n        return\n    \n    factorial = [0] * (n + 1)\n    factorial[0] = 1\n    for i in range(1, n + 1):\n        factorial[i] = factorial[i-1] * i % mod\n    \n    invFactorial = [0] * (n + 1)\n    invFactorial[n] = modPow(factorial[n], mod - 2, mod)\n    for i in range(n, 0, -1):\n        invFactorial[i-1] = invFactorial[i] * i % mod\n    \n    memo = [[-1] * (n + 1) for _ in range(26)]\n    subtract = solve(0, n, n, k, mod, factorial, invFactorial, memo)\n    result = (total - subtract + mod) % mod\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013505500101018697, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0024408092722296715, -8.463501580990851e-05, -0.4287310838699341, -0.4472576975822449, -1.1920928244535389e-07, -5.4596363042946905e-05, -3.683499380713329e-05, -1.5616295058862306e-05, -3.576278118089249e-07, -0.25443997979164124, -0.00023588736075907946, -0.0008133916999213398, -9.536738616588991e-07, -1.537788011773955e-05, -0.225472092628479, -0.012512985616922379, -0.00762398075312376, -0.014874504879117012, -0.5929967761039734, -0.01910136453807354, -2.9802276912960224e-06, -3.576278118089249e-07, -3.325883881188929e-05, -0.0002978596603497863, -2.884823152271565e-05, -0.0007700338610447943, -3.576278118089249e-07, -7.629365427419543e-06, 0.0, 0.0, -2.3841855067985307e-07, -1.6689286894688848e-06, 0.0, -5.960462772236497e-07, -0.00011598391574807465, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -3