\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    raise RuntimeError(\"No more input\")\n                self.tokenizer = line.strip().split()\n            except Exception as e:\n                raise RuntimeError(e)\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\nclass Modulus:\n    def __init__(self):\n        initial_capacity = 100000\n        self.factorial = [1] * initial_capacity\n        self.invFactorial = [1] * initial_capacity\n\n    def modulus(self):\n        raise NotImplementedError\n\n    def prepare(self, n):\n        while len(self.factorial) <= n:\n            new_length = len(self.factorial) << 1\n            new_fact = self.factorial + [0] * (new_length - len(self.factorial))\n            new_inv_fact = self.invFactorial + [0] * (new_length - len(self.invFactorial))\n            self.factorial = new_fact\n            self.invFactorial = new_inv_fact\n\n        for i in range(len(self.factorial), n + 1):\n            self.factorial[i] = self.multiply(self.factorial[i - 1], i)\n\n        if len(self.invFactorial) <= n:\n            self.invFactorial[n] = self.inverse(self.factorial[n])\n            for i in range(n - 1, len(self.invFactorial) - 1, -1):\n                self.invFactorial[i] = self.multiply(self.invFactorial[i + 1], i + 1)\n\n    def factorial(self, n):\n        return self.factorial[n]\n\n    def invFactorial(self, n):\n        return self.invFactorial[n]\n\n    def sign(self, k):\n        return 1 if (k & 1) == 0 else self.modulus() - 1\n\n    def binomial(self, n, r):\n        if r < 0 or r > n:\n            return 0\n        return self.multiply(self.factorial(n), self.multiply(self.invFactorial(r), self.invFactorial(n - r)))\n\n    def getSmallInverse(self, n):\n        return self.multiply(self.invFactorial(n), self.factorial(n - 1))\n\n    def add(self, a, b):\n        sum_val = a + b\n        return sum_val - self.modulus() if sum_val >= self.modulus() else sum_val\n\n    def multiply(self, *values):\n        result = 1\n        for val in values:\n            result = (result * val) % self.modulus()\n        return result\n\n    def inverse(self, value):\n        g, x, y = self.modulus(), 0, 1\n        r = value\n        while r != 0:\n            q = g // r\n            g %= r\n            g, r = r, g\n            x -= q * y\n            x, y = y, x\n        return self.normalize(x)\n\n    def normalize(self, x):\n        x %= self.modulus()\n        return x + self.modulus() if x < 0 else x\n\nclass Mod998(Modulus):\n    def modulus(self):\n        return 998244353\n\ndef main():\n    reader = InputReader(sys.stdin)\n    n = reader.nextInt()\n    m = reader.nextInt()\n\n    mod = Mod998()\n    mod.prepare(n + m)\n\n    phase = 1\n    current = 1\n    i = 0\n    while current != 0:\n        current = mod.multiply(current, mod.multiply(n - i, mod.getSmallInverse(n + m - i)))\n        phase = mod.add(phase, current)\n        i += 1\n\n    result = 0\n    for k in range(1, n + 1):\n        sign = 1 if ((k + 1) & 1) == 0 else mod.modulus() - 1\n        comb = mod.binomial(n, k)\n        part = mod.multiply(m + k, mod.getSmallInverse(k), phase)\n        result = mod.add(result, mod.multiply(sign, comb, part))\n\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.030505417380482e-05, -1.1920922133867862e-06, -5.960462772236497e-07, -0.02741406485438347, -0.00027223696815781295, -0.20144861936569214, -0.3877772390842438, -0.06367587298154831, -0.002809032564982772, -0.024667002260684967, -0.6327536106109619, -1.7881377516459906e-06, -2.264974000354414e-06, -4.768370445162873e-07, -1.192092