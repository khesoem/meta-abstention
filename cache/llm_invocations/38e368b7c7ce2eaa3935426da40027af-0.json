et - (double)nr / i);\n            if (dr < dl) {\n                try_update(dr, best, bestNum, bestDen, nr, i);\n            } else {\n                try_update(dl, best, bestNum, bestDen, nl, i);\n            }\n        }\n    }\n    ll g = gcd(bestNum, bestDen);\n    printf(\"%lld/%lld\", bestNum / g, bestDen / g);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static long gcd(long a, long b) {\n        return b == 0 ? a : gcd(b, a % b);\n}\n\npublic static void main(String[] args) {\n    Scanner sc = new Scanner(System.in);\n    long x = sc.nextLong();\n    long y = sc.nextLong();\n    long n = sc.nextLong();\n    sc.close();\n    if (y <= n) {\n        long g = gcd(x, y);\n        System.out.println((x / g) + \"/\" + (y / g));\n        return;\n    }\n    if (x == y) {\n        System.out.println(\"1/1\");\n        return;\n    }\n    double best = 1e18;\n    double target = (double) x / (double) y;\n    long bestNum = 0, bestDen = 0;\n    long lo = 0, hi = y;\n    for (long i = 1; i <= n; ++i) {\n        while (i * x > hi) {\n            lo += y;\n            hi += y;\n        }\n        if (i * x >= lo && i * x <= hi) {\n            long nl = lo / y;\n            long nr = hi / y;\n            double dl = Math.abs(target - (double) nl / i);\n            double dr = Math.abs(target - (double) nr / i);\n            if ((float) dl < (float) best) {\n                best = dl;\n                bestNum = nl;\n                bestDen = i;\n            } else if ((float) dr < (float) best) {\n                best = dr;\n                bestNum = nr;\n                bestDen = i;\n            }\n        }\n    }\n    long g = gcd(bestNum, bestDen);\n    System.out.println((bestNum / g) + \"/\" + (bestDen / g));\n}\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "t