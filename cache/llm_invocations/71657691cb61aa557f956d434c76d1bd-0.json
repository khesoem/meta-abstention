dd(m);\n                    }\n                }\n                H.put(S, value);\n            }\n            G.clear();\n\n            for (int j = 0; j < (1 << N); ++j) {\n                FieldMod pst = new FieldMod(1);\n                for (int k = 0; k < N; ++k) {\n                    if (((j >> k) & 1) == 1) {\n                        pst = pst.multiply(new FieldMod(P[i][k]));\n                    } else {\n                        pst = pst.multiply(new FieldMod(100 - P[i][k]));\n                    }\n                }\n                for (Map.Entry<List<Integer>, FieldMod> h : H.entrySet()) {\n                    BitSet ans = new BitSet();\n                    for (int l = 0; l < N; ++l) {\n                        if (((j >> l) & 1) == 0) continue;\n                        for (int m : h.getKey()) {\n                            if (((m >> l) & 1) == 0) {\n                                int newM = m | (1 << l);\n                                ans.set(newM);\n                            }\n                        }\n                    }\n                    if (ans.cardinality() > 0) {\n                        FieldMod prev = G.getOrDefault(ans, new FieldMod(0));\n                        G.put(ans, prev.add(h.getValue().multiply(pst)));\n                    }\n                }\n            }\n        }\n\n        FieldMod ans = new FieldMod(0);\n        for (FieldMod g : G.values()) {\n            ans = ans.add(g);\n        }\n        for (int i = 0; i < N * N; ++i) {\n            ans = ans.divide(new FieldMod(100));\n        }\n        bw.write(ans.toString());\n        bw.newLine();\n        bw.flush();\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));\n        new E2MarekAndMatchingHardVersion().solve(br, bw);\n    }\n}\n\nclass FieldMod {\n    static final int MO