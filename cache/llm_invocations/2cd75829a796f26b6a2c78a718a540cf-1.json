 self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            assert g == 1\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    raise RuntimeError(\"No more input\")\n                self.tokenizer = line.strip().split()\n            except Exception as e:\n                raise RuntimeError(e)\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\n\ndef main():\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream)\n    out = outputStream\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out)\n    out.close()\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n\n    def solve(self, testNumber, in_reader, out):\n        n = in_reader.nextInt()\n        m = in_reader.nextInt()\n\n        self.mod.fInv(n + m)\n\n        phase_size = 1\n        p = 1\n        for i in range(n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, n - i, self.mod.smallInv(n + m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, n + 1):\n            sign = self.mod.parity_sign(k + 1)\n            num_phases = self.mod.mult(m + k, self.mod.smallInv(k))\n            term = self.mod.mult(sign, self.mod.ncr(n, k), num_phases, phase_size)\n            answer = self.mod.add(answer, term)\n\n        out.write(str(answer) + '\\n')\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.0424259825376794e-05, -1.0728830375228426e-06, -5.960462772236497e-07, -0.0006223172531463206, -0.018492083996534348, -0.003101659705862403, -0.1797676533460617, -0.32186663150787354, -0.018480148166418076, -0.05606025829911232, -0.9188823103904724, -4.768360213347478e-06, -1.5497195136049413e-06, -1.1920928244535389e-07, -1.6689286894688848e-06, -0.0007438276661559939, -8.344646857949556e-07, -1.1920928244535389e-07, -1.5497195136049413e-06, -0.005234109237790108, -8.34461570775602e-06, -2.0265558760002023e-06, 0.0, -4.172316494077677e-06, -5.602820692729438e-06, -2.622600959512056e-06, -8.34461570775602e-06, -5.960462772236497e-07, -0.0004975749761797488, -1.1920928244535389e-07, 0.0, -1.4305104514278355e-06, -2.9802276912960224e-06, -5.960462772236497e-07, -3.576278118089249e-07, 0.0, -1.4305104514278355e-06, -3.9457496313843876e-05, 0.0, 0.0, -0.07921391725540161, -4.768370445162873e-07, -8.344646857949556e-07, -3.814624506048858e-05, 0.0, 0.0, -1.1920928244535389e-07, -4.529942543740617e-06, -7.986990567587782e-06, -7.152555099310121e-07, -9.536738616588991e-07, -4.768370445162873e-07, -2.622600959512056e-06, -6.556489552167477e-06, -1.4305104514278355e-06, -0.0003666205739136785, 