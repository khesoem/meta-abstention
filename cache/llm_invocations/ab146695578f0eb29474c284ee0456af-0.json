am in) {\n            br = new BufferedReader(new InputStreamReader(in));\n        }\n\n        public String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return st.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998244353L;\n        private long[] fact, invFact;\n\n        public void build(int max) {\n            fact = new long[max + 1];\n            invFact = new long[max + 1];\n            fact[0] = 1;\n            for (int i = 1; i <= max; i++) fact[i] = (fact[i - 1] * i) % MOD;\n            invFact[max] = modPow(fact[max], MOD - 2);\n            for (int i = max; i > 0; i--) invFact[i - 1] = (invFact[i] * i) % MOD;\n        }\n\n        public long binom(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return (fact[n] * invFact[r] % MOD) * invFact[n - r] % MOD;\n        }\n\n        public long inv(int x) {\n            return modPow(x, MOD - 2);\n        }\n\n        public long sum(long a, long b) {\n            a %= MOD; b %= MOD;\n            long s = a + b;\n            return s >= MOD ? s - MOD : s;\n        }\n\n        public long diff(long a, long b) {\n            a %= MOD; b %= MOD;\n            long d = a - b;\n            return d < 0 ? d + MOD : d;\n        }\n\n        public long prod(long a, long b) {\n            return (a * b) % MOD;\n        }\n\n        private long modPow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = (res * base) % MOD;\n                base = (base * base) % MOD;\n                exp >>= 1;\n            }\n    