ound(v[i], v[i] + L[i], M - t) - v[i];\n        ans = (ans + s[i] + t * L[i] - 1ll * M * (L[i] - g)) % M2;\n    }\n}\n\nvoid dfs2_iter() {\n    stack<pair<ll, int>> st;\n    st.push({0, 0});\n    while (!st.empty()) {\n        auto [x, state] = st.top(); st.pop();\n        if (state == 0) {\n            if ((x + 1) * p[6] <= n + 1 && x * p[7] > n) {\n                query(x, Idx + 1);\n                Idx += idx;\n                continue;\n            }\n            ++Idx;\n            ans = Del1(ans + Del((Idx - x) % M + M));\n            st.push({x, 1});\n            for (int i = 9; i >= (!x); --i) {\n                if (x * 10 + i <= n) st.push({x * 10 + i, 0});\n            }\n        }\n    }\n}\n\nint main() {\n    dfs1_iter();\n    cin >> n;\n    dfs2_iter();\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long[] p = {1, 10, 100, 1000, 10000, 100000, 1000000, 10000000};\n    static final int M = 998244353;\n    static final int M2 = 1000000007;\n    static int idx, ans;\n    static long n;\n    static long[] s = new long[10];\n    static long Idx = -1;\n    static int[][] v = new int[10][1000005];\n    static int[] L = new int[10];\n\n    static int Del(int x) {\n        return x >= M ? x - M : x;\n    }\n\n    static int Del1(int x) {\n        return x >= M2 ? x - M2 : x;\n    }\n\n    static int lowerBound(int[] arr, int len, int target) {\n        int lo = 0, hi = len;\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            if (arr[mid] < target) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        return lo;\n    }\n\n    static void dfs1_iter() {\n        Deque<int[]> stack = new ArrayDeque<>();\n        stack.push(new int[]{0, 0});\n        while 