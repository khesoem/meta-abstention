or (int i = 0; i < n; ++i) {\n            if (p[i] != 0) {\n                isgood[i] = true;\n                good.add(i);\n            }\n        }\n\n        dp[0][0] = 1.0;\n        int cur = 1;\n\n        double[] sum = new double[1 << n];\n        sum[0] = 1.0;\n        for (int mask = 1; mask < (1 << n); ++mask) {\n            int bit = Integer.numberOfTrailingZeros(mask);\n            sum[mask] = sum[mask ^ (1 << bit)] - p[bit];\n        }\n\n        int limit = Math.min(good.size(), k);\n        for (int step = 0; step < limit; ++step) {\n            Arrays.fill(dp[cur], 0.0);\n\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (Integer.bitCount(mask) != step) continue;\n\n                for (int idx : good) {\n                    if ((mask & (1 << idx)) != 0) continue;\n                    dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / sum[mask];\n                }\n            }\n\n            cur ^= 1;\n        }\n\n        cur ^= 1;\n        for (int i = 0; i < n; ++i) {\n            if (!isgood[i]) {\n                System.out.printf(\"%.12f\\n\", 0.0);\n            } else {\n                double res = 0.0;\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    if ((mask & (1 << i)) != 0) {\n                        res += dp[cur][mask];\n                    }\n                }\n                System.out.printf(\"%.12f\\n\", res);\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015293381875380874, -1.6689286894688848e-06, -5.960462772236497e-07, -0.0003997480380348861, -3.814624506048858e-05, -0.2812899351119995, -0.3132862150669098, -3.0874729418428615e-05, -2.884823152271565e-05, -0.0004844683862756938, -0.00978530291467905, -0.00014554394874721766, -9.536738616588991e-07, -9.011816291604191e-05, -0.10020971298217773, -0.00015960850578267127, -0.018485061824321747, -1.2278481335670222e-05, -4.7205765440594405