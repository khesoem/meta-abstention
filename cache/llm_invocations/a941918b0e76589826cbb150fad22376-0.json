{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <cstring>\nusing namespace std;\n\nusing ll = long long;\n\nstruct Edge {\n    int v;\n    int capacity;\n    int flow;\n    int cost;\n    Edge(int v, int cap, int fl, int cst) : v(v), capacity(cap), flow(fl), cost(cst) {}\n};\n\nvector<Edge> edgeList;\nvector<vector<int>> graph;\nconst int MAXN = 14043;\nll distance[MAXN];\nint prevNode[MAXN];\nint prevEdge[MAXN];\nbool inQueue[MAXN];\n\nconst ll INFL = (ll)1e18;\n\nint S, T;\n\nint getRemaining(int idx) {\n    return edgeList[idx].capacity - edgeList[idx].flow;\n}\n\nvoid bellmanFord() {\n    fill(distance, distance + MAXN, INFL);\n    fill(prevNode, prevNode + MAXN, -1);\n    fill(prevEdge, prevEdge + MAXN, -1);\n    fill(inQueue, inQueue + MAXN, false);\n    distance[S] = 0;\n    queue<int> q;\n    q.push(S);\n    inQueue[S] = true;\n\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inQueue[u] = false;\n        for (int idx : graph[u]) {\n            if (getRemaining(idx) == 0) continue;\n            int v = edgeList[idx].v;\n            int w = edgeList[idx].cost;\n            if (distance[v] > distance[u] + w) {\n                distance[v] = distance[u] + w;\n                prevNode[v] = u;\n                prevEdge[v] = idx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n}\n\nvoid augment() {\n    bellmanFord();\n    int cur = T;\n    while (cur != S) {\n        edgeList[prevEdge[cur]].flow++;\n        edgeList[prevEdge[cur] ^ 1].flow--;\n        cur = prevNode[cur];\n    }\n}\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    graph[u].push_back(edgeList.size());\n    edgeList.emplace_back(v, cap, 0, cost);\n    graph[v].push_back(edgeList.size());\n    edgeList.emplace_back(u, 0, 0, -cost);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    S = MAXN - 2;\n    T = MAXN - 1;\n\n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        --x;\n        addEdge(S, x, 1, 0);\n    }\n\n    int TMAX = 101;\n    for (int t = 0; t < TMAX; t++) {\n        addEdge(t * n, T, k, t * c);\n    }\n\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        for (int t = 0; t < TMAX - 1; t++) {\n            for (int j = 0; j < k; j++) {\n                addEdge(u + t * n, v + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < TMAX - 1; t++) {\n            for (int j = 0; j < k; j++) {\n                addEdge(v + t * n, u + (t + 1) * n, 1, d * (2 * j + 1));\n            }\n        }\n    }\n\n    for (int i = 0; i < n; i++) {\n        for (int t = 0; t < TMAX - 1; t++) {\n            addEdge(i + t * n, i + (t + 1) * n, k, 0);\n        }\n    }\n\n    ll ans = 0;\n    for (int i = 0; i < k; i++) {\n        augment();\n        ans += distance[T];\n    }\n\n    cout << ans << '\\n';\n    return