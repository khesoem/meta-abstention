) ? 1.0 : 0.0;\n                    System.out.printf(\"%.15f\", pp);\n                    if (i + 1 == n) {\n                        System.out.println();\n                    } else {\n                        System.out.print(\" \");\n                    }\n                }\n                continue;\n            }\n\n            // Precompute list of set bits for each mask\n            List<List<Integer>> bits = new ArrayList<>(totalMasks);\n            for (int mask = 0; mask < totalMasks; mask++) {\n                List<Integer> list = new ArrayList<>();\n                for (int i = 0; i < n; i++) {\n                    if ((mask & (1 << i)) != 0) {\n                        list.add(i);\n                    }\n                }\n                bits.add(list);\n            }\n\n            double[] dp = new double[totalMasks];\n            dp[0] = 1.0;\n            for (int mask = 0; mask < totalMasks; mask++) {\n                int rmask = (~mask) & (totalMasks - 1);\n                for (int i : bits.get(rmask)) {\n                    if (p[i] > 1e-5) {\n                        dp[mask | (1 << i)] += dp[mask] * p[i] / sum[rmask];\n                    }\n                }\n            }\n\n            double[] ans = new double[n];\n            for (int mask = 0; mask < totalMasks; mask++) {\n                if (bits.get(mask).size() != k) continue;\n                for (int i : bits.get(mask)) {\n                    ans[i] += dp[mask];\n                }\n            }\n\n            for (int i = 0; i < n; i++) {\n                System.out.printf(\"%.15f\", ans[i]);\n                if (i + 1 == n) {\n                    System.out.println();\n                } else {\n                    System.out.print(\" \");\n                }\n            }\n        }\n        scanner.close();\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.014418580569326878, -3.576278118089249e-07, -1.1920928244535389e-07, -2.3841855067985307