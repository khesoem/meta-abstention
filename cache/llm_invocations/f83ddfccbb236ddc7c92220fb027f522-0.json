ata:\n        return\n    it = iter(data)\n    dim = int(next(it))\n    time_to_die = int(next(it))\n    \n    max_nodes = 2 * dim * dim + 2\n    cap = [[0] * max_nodes for _ in range(max_nodes)]\n    gr = [[] for _ in range(max_nodes)]\n    \n    labsci = []\n    labcap = []\n    \n    vert = [[[0, 0] for _ in range(dim)] for _ in range(dim)]\n    N = 2  # source is 0, sink is 1, next free node index\n    \n    for i in range(dim):\n        row = next(it)\n        labsci.append(row)\n        for j, ch in enumerate(row):\n            if '1' <= ch <= '9':\n                cap[0][N] = int(ch)\n                gr[0].append(N)\n                gr[N].append(0)\n                vert[i][j][0] = N\n                N += 1\n            elif ch == 'Z':\n                malfunc = 100 * i + j\n                # replace Z with Y in labsci (but we already have row string, we'll modify later)\n                # Actually we need to modify the string, but strings are immutable. We'll store as list.\n                # We'll convert labsci to list of lists later.\n                # For now, we note the position.\n                # We'll handle after reading all rows.\n    \n    # Convert labsci to list of lists for mutability\n    labsci = [list(row) for row in labsci]\n    # Now replace Z with Y\n    for i in range(dim):\n        for j in range(dim):\n            if labsci[i][j] == 'Z':\n                labsci[i][j] = 'Y'\n                malfunc = 100 * i + j\n    \n    M = N\n    for i in range(dim):\n        row = next(it)\n        labcap.append(row)\n        for j, ch in enumerate(row):\n            if '1' <= ch <= '9':\n                cap[M][1] = int(ch)\n                gr[M].append(1)\n                vert[i][j][1] = M\n                M += 1\n    \n    # die times\n    die = [[time_to_die + 1] * dim for _ in range(dim)]\n    die[malfunc // 100][malfunc % 100] = 0\n    \n    from collections import deque\n    q = deque()\n    q.append(malfunc)\n    ds = [(1,0), (0,1), (-1,0), 