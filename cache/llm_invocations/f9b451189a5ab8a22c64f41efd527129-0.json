ferences.add(Math.abs(values[i] - values[i + 1]));\n                }\n            }\n\n            Collections.sort(differences);\n            long accumulated = 0;\n            int selected = 0;\n            \n            for (int diff : differences) {\n                if ((accumulated += diff) <= budget) {\n                    selected++;\n                } else {\n                    break;\n                }\n            }\n            \n            out.println(selected);\n        }\n    }\n\n    static class InputReader {\n        private final BufferedReader reader;\n        private StringTokenizer tokenizer;\n\n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream));\n        }\n\n        private String readToken() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new UncheckedIOException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int readInt() {\n            return Integer.parseInt(readToken());\n        }\n\n        public long readLong() {\n            return Long.parseLong(readToken());\n        }\n    }\n\n    static class OutputWriter {\n        private final PrintWriter writer;\n\n        public OutputWriter(OutputStream stream) {\n            writer = new PrintWriter(stream);\n        }\n\n        public void println(int value) {\n            writer.println(value);\n        }\n\n        public void close() {\n            writer.close();\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def read_token(self):\n        while self.tokenizer is None or not self.tokenizer:\n            line = self.reader.readline()\n            if not line:\n                raise EOFError(\"No more input\")\n            self.tokenizer = line.strip().split()\n        return self.tokenizer.pop(0)\n\n    def read_int(self):\n        return int(self.read_token())\n\n    def read_long(self):\n        return int(self.read_token())\n\nclass OutputWriter:\n    def __init__(self, stream):\n        self.writer = stream\n\n    def println(self, value):\n        self.writer.write(str(value) + '\\n')\n        self.writer.flush()\n\n    def close(self):\n        pass\n\nclass Unstoppable:\n    def solve(self, in_reader, out_writer):\n        n = in_reader.read_int()\n        budget = in_reader.read_long()\n        values = [0] * n\n        signs = [0] * n\n        \n        for i in range(n):\n            values[i] = in_reader.read_int()\n            signs[i] = 1 if values[i] % 2 == 0 else -1\n\n        differences = []\n        running_sum = 0\n        \n        for i in range(n - 1):\n            running_sum += signs[i]\n            if running_sum == 0:\n                differences.append(abs(values[i] - values[i + 1]))\n\n        differences.sort()\n        accumulated = 0\n        selected = 0\n        \n        for diff in differences:\n            accumulated += diff\n            if accumulated <= budget:\n                selected += 1\n            else:\n                break\n        \n        out_writer.println(selected)\n\ndef main():\n    in_reader = InputReader(sys.stdin)\n    out_writer = OutputWriter(sys.stdout)\n    \n    solver = Unstoppable()\n    solver.solve(in_reader, out_writer)\n    \n    out_writer.close()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011431517486926168, -9.536738616588991e-07, 0.0, -5.006664650863968e-05, -0.0079929