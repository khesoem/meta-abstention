{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nstruct Ratio {\n    ll num;\n    ll den;\n};\n\nRatio subtract(Ratio a, Ratio b) {\n    ll common = lcm(a.den, b.den);\n    ll na = a.num * (common / a.den);\n    ll nb = b.num * (common / b.den);\n    ll d = na - nb;\n    ll g = gcd(abs(d), common);\n    return {d / g, common / g};\n}\n\nRatio abs_ratio(Ratio a) {\n    if (a.num < 0) a.num = -a.num;\n    return a;\n}\n\nint compare(Ratio a, Ratio b) {\n    ll common = lcm(a.den, b.den);\n    ll na = a.num * (common / a.den);\n    ll nb = b.num * (common / b.den);\n    if (na == nb) return 0;\n    return na < nb ? -1 : 1;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout.tie(nullptr);\n\n    ll x, y, n;\n    cin >> x >> y >> n;\n\n    ll g = gcd(x, y);\n    x /= g;\n    y /= g;\n\n    Ratio target{x, y};\n    Ratio bestDiff{1000000000000LL, 1};\n    Ratio best{0, 0};\n\n    for (ll b = 1; b <= n; ++b) {\n        ll lo = 0;\n        double upper = (double)x / y;\n        upper += (double)bestDiff.num / bestDiff.den;\n        ll hi = (ll)((upper + 2.0) * (double)b);\n\n        while (lo <= hi) {\n            ll mid = lo + (hi - lo) / 2;\n            Ratio cand{mid, b};\n            Ratio diff = abs_ratio(subtract(target, cand));\n            int c = compare(diff, bestDiff);\n\n            if (c == 0) {\n                if (cand.den < best.den ||\n                    (cand.den == best.den && cand.num < best.num)) {\n                    best = cand;\n                }\n            } else if (c < 0) {\n                bestDiff = diff;\n                best = cand;\n            }\n\n            if (compare(cand, target) < 0)\n                lo = mid + 1;\n            else\n                hi = mid - 1;\n        }\n    }\n\n    cout << best.num << \"/\" << best.den;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    static class Ratio {\n        long num;\n        long den;\n        Ratio(long num, long den) {\n            this.num = num;\n            this.den = den;\n        }\n    }\n\n    static long gcd(long a, long b) {\n        while (b != 0) {\n            long t = b;\n            b = a % b;\n            a = t;\n        }\n        return a;\n    }\n\n    static long lcm(long a, long b) {\n        return a / gcd(a, b) * b;\n    }\n\n    static Ratio subtract(Ratio a, Ratio b) {\n        long common = lcm(a.den, b.den);\n        long na = a.num * (common / a.den);\n        long nb = b.num * (common / b.den);\n        long d = na - nb;\n        long g = gcd(Math.abs(d), common);\n        return new Ratio(d / g, common / g);\n    }\n\n    static Ratio absRatio(Ratio a) {\n        if (a.num < 0) {\n            return new Ratio(-a.num, a.den);\n        }\n        return new Ratio(a.num, a.den);\n    }\n\n    static int compare(Ratio a, Ratio b) {\n        long common = lcm(a.den, b.den);\n        long na = a.num * (common / a.den);\n        long nb = b.num * (common / b.den);\n        if (na == nb) return 0;\n        return na < nb ? -1 : 1;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long x = sc.nextLong();\n        long y = sc.nextLong();\n        long n = sc.nextLong();\n        sc.close();\n\n        long g = gcd(x, y);\n        x /= g;\n        y /= g;\n\n        Ratio target = new Ratio(x, y);\n        Ratio bestDiff = new Ratio(1000000000000L, 1);\n        Ratio best = new Ratio(0, 0);\n\n        for (long b = 1; b <= n; ++b) {\n            long lo = 0;\n            double upper = (double) x / y;\n            upper += (double) bestDiff.num / bestDiff.den;\n            long hi = (long) ((upper + 2.0) * (double) b);\n\n            while (lo <= hi) {\n                long mid = lo + (hi - lo) / 2;\n                Ratio cand = new Ratio(mid, b);\n                Ratio diff = absRatio(subtract(target, cand));\n                int c = compare(diff, bestDiff);\n\n                if (c == 0) {\n                    if (cand.den < best.den ||\n                        (cand.den == best.den && cand.num < best.num)) {\n                        best = cand;\n                    }\n                } else if (c < 0) {\n                    bestDiff = diff;\n                    best = cand;\n                }\n\n                if (compare(cand, target) < 0)\n                    lo = mid + 1;\n                else\n                    hi = mid - 1;\n            }\n        }\n\n        System.out.println(best.num + \"/\" + best.den);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.516612196108326e-05, -2.3841855067985307e-07, 0.0, -3.802703940891661e-05, -3.85038583772257e-05, -4.768370445162873e-07, -4.1483970562694594e-05, -0.6948036551475525, -0.0031871020328253508, -0.0015262633096426725, 0.0, -0.0014812698354944587, -0.006718901451677084, -0.0031825865153223276, -0.0005897