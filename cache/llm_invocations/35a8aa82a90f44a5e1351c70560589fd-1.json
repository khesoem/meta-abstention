dge(i + j * n, i + j * n + n, k, 0)\n    \n    dist = [INF64] * N\n    pred = [-1] * N\n    pe = [-1] * N\n    inq = [0] * N\n    \n    ans = 0\n    \n    def dijkstra():\n        for i in range(N):\n            dist[i] = INF64\n            pred[i] = -1\n            pe[i] = -1\n            inq[i] = 0\n        dist[source] = 0\n        q = deque()\n        q.append(source)\n        inq[source] = 1\n        while q:\n            k = q.popleft()\n            inq[k] = 0\n            for x in g[k]:\n                if not residualCapacity(x):\n                    continue\n                cost = e[x].cost\n                y = e[x].from_node\n                if dist[y] > dist[k] + cost:\n                    dist[y] = dist[k] + cost\n                    pred[y] = k\n                    pe[y] = x\n                    if inq[y] == 0:\n                        inq[y] = 1\n                        q.append(y)\n    \n    def pushFlow():\n        nonlocal ans\n        dijkstra()\n        cur = target\n        while cur != source:\n            e[pe[cur]].f += 1\n            e[pe[cur] ^ 1].f -= 1\n            cur = pred[cur]\n        ans += dist[target]\n    \n    for _ in range(k):\n        pushFlow()\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0002374367177253589, -1.5497195136049413e-06, -3.576278118089249e-07, -9.333651541965082e-05, -0.004122925456613302, -2.3841830625315197e-06, -0.00026603974401950836, -0.0003695997002068907, -1.1920922133867862e-06, -0.0001839230244513601, -0.003812665119767189, -0.07272139191627502, -1.0728830375228426e-06, -0.00013362467871047556, -1.1920928244535389e-07, -0.002945016138255596, 0.0, -2.8132995794294402e-05, -0.0002616301644593477, 0.0, 0.0, -0.029792189598083496, -0.0036582706961780787, -1.3708974620385561e-05, -2.3841855067985307e-07, -7.390948667307384e-06, -0.0011703077470883727, -2.3841855067985307e-07, -2.0265558760002023e-06, -1.19209