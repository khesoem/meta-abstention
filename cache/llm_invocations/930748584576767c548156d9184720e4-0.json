   for j in range(base + 1):\n            print(f\"{A[i][j]:2d}\", end=\" \")\n        print()\n\ndef run():\n    input_line = sys.stdin.readline().strip()\n    n, base = map(int, input_line.split())\n    \n    # Initialize mat[0][i][j][k]\n    mat = {}\n    for i in range(60):\n        mat[i] = {}\n        for j in range(base + 1):\n            mat[i][j] = [[0] * (base + 1) for _ in range(base + 1)]\n    \n    for i in range(base):\n        for j in range(base + 1):\n            for k in range(base + 1):\n                mat[0][i][j][k] = 1 if (i == j or j == k) else 0\n    \n    ci = 0\n    cj = 0\n    step = 1\n    while step <= n // base:\n        ci += 1\n        step *= base\n    \n    # Fill mat for higher powers\n    for i in range(1, ci + 1):\n        for j in range(base):\n            # Initialize as identity matrix\n            for k in range(base + 1):\n                for l in range(base + 1):\n                    mat[i][j][k][l] = 1 if k == l else 0\n            \n            # Multiply with previous matrices\n            for k in range(base):\n                tmp = [[0] * (base + 1) for _ in range(base + 1)]\n                mmult(mat[i][j], mat[i-1][(j + k) % base], tmp, base)\n                mcopy(tmp, mat[i][j])\n    \n    # Initialize 'have' as identity matrix\n    have = [[0] * (base + 1) for _ in range(base + 1)]\n    for k in range(base + 1):\n        have[k][k] = 1\n    \n    # Process the matrix exponentiation\n    for c in range(ci, -1, -1):\n        step //= base\n        times = (n // step) % base\n        for x in range(times):\n            tmp = [[0] * (base + 1) for _ in range(base + 1)]\n            mmult(have, mat[c][cj], tmp, base)\n            mcopy(tmp, have)\n            cj += 1\n            if cj >= base:\n                cj -= base\n    \n    # Calculate result\n    ret = 0\n    for k in range(base + 1):\n        ret += have[k][base]\n        if ret >= MOD:\n            ret -= MOD\n    print(ret)\n\nif __name__ == \"__main__\":