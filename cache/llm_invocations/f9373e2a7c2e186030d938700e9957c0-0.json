{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Cutting {\n\n    private static int[] toIntArray(String s) {\n        return Arrays.stream(s.trim().split(\"\\\\s+\"))\n                     .mapToInt(Integer::parseInt)\n                     .toArray();\n    }\n\n    private static boolean isBalanced(int[] arr, int k) {\n        int evens = 0, odds = 0;\n        for (int i = 0; i <= k; i++) {\n            if ((arr[i] & 1) == 0) evens++;\n            else odds++;\n        }\n        return evens == odds;\n    }\n\n    private static int findOptimalCut(int[] arr, int coins, Set<Integer> blocked) {\n        int best = -1;\n        int minCost = coins + 1;\n\n        for (int i = 1; i < arr.length - 1; i++) {\n            int cost = Math.abs(arr[i] - arr[i + 1]);\n            if (cost < minCost && isBalanced(arr, i) && !blocked.contains(i)) {\n                minCost = cost;\n                best = i;\n            }\n        }\n        return best;\n    }\n\n    public int getMaximumCuts(int n, int budget, int[] arr) {\n        int coins = budget;\n        int cuts = 0;\n        Set<Integer> used = new HashSet<>();\n\n        while (coins > 0) {\n            int idx = findOptimalCut(arr, coins, used);\n            if (idx == -1) break;\n\n            used.add(idx);\n            coins -= Math.abs(arr[idx] - arr[idx + 1]);\n            cuts++;\n        }\n        return cuts;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] firstLine = br.readLine().trim().split(\"\\\\s+\");\n        String[] secondLine = br.readLine().trim().split(\"\\\\s+\");\n\n        int n = Integer.parseInt(firstLine[0]);\n        int b = Integer.parseInt(firstLine[1]);\n        int[] a = new int[secondLine.length];\n        for (int i = 0; i < secondLine.length; i++) {\n            a[i] = Integer.parseInt(secondLine[i]);\n        }\n\n        Cutting c = new Cutting();\n        System.out.println(c.getMaximumCuts(n, b, a));\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <set>\n#include <string>\n#include <sstream>\n#include <cmath>\n#include <algorithm>\n\nusing namespace std;\n\nclass Cutting {\npublic:\n    vector<int> toIntArray(const string& s) {\n        vector<int> result;\n        istringstream iss(s);\n        string token;\n        while (iss >> token) {\n            result.push_back(stoi(token));\n        }\n        return result;\n    }\n\n    bool isBalanced(const vector<int>& arr, int k) {\n        int evens = 0, odds = 0;\n        for (int i = 0; i <= k; i++) {\n            if ((arr[i] & 1) == 0) evens++;\n            else odds++;\n        }\n        return evens == odds;\n    }\n\n    int findOptimalCut(const vector<int>& arr, int coins, const set<int>& blocked) {\n        int best = -1;\n        int minCost = coins + 1;\n\n        for (int i = 1; i < (int)arr.size() - 1; i++) {\n            int cost = abs(arr[i] - arr[i + 1]);\n            if (cost < minCost && isBalanced(arr, i) && blocked.find(i) == blocked.end()) {\n                minCost = cost;\n                best = i;\n            }\n        }\n        return best;\n    }\n\n    int getMaximumCuts(int n, int budget, vector<int> arr) {\n        int coins = budget;\n        int cuts = 0;\n        set<int> used;\n\n        while (coins > 0) {\n            int idx = findOptimalCut(arr, coins, used);\n            if (idx == -1) break;\n\n            used.insert(idx);\n            coins -= abs(arr[idx] - arr[idx + 1]);\n            cuts++;\n        }\n        return cuts;\n    }\n};\n\nint main() {\n    string firstLine, secondLine;\n    getline(cin, firstLine);\n    getline(cin, secondLine);\n\n    vector<string> firstTokens;\n    istringstream iss1(firstLine);\n    string token;\n    while (iss1 >> token) {\n        firstTokens.push_back(token);\n    }\n\n    vector<string> secondTokens;\n    istringstream iss2(secondLine);\n    while (iss2 >> token) {\n        secondTokens.push_back(token);\n    }\n\n    int n = stoi(firstTokens[0]);\n    int b = stoi(firstTokens[1]);\n    vector<int> a(secondTokens.size());\n    for (int i = 0; i < (int)secondTokens.size(); i++) {\n        a[i] = stoi(secondTokens[i]);\n    }\n\n    Cutting c;\n    cout << c.getMaximumCuts(n, b, a) << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.795983401592821e-05, -4.410734163684538e-06, -1.1920928244535389e-07, -0.00017498392844572663, -9.536738616588991e-07, -7.867782187531702e-06, -5.960462772236497e-07, -1.9073468138230965e-06, -3.576272320060525e-06, -0.027626296505331993, -3.576278118089249e-07, -2.3245540432981215e-05, -1.1920928244535389e-07, -0.1941283494234085, -4.768370445162873e-07, -5.125986263010418e-06, -3.576278118089249e-07, -0.24858681857585907, -4.768370445162873e-07, -3.6954811548639555e-06, -7.152555099310121e-07, -0.00098406