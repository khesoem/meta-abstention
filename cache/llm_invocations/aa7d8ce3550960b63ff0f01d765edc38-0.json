{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <queue>\n#include <unordered_set>\n#include <vector>\n#include <cmath>\n#include <functional>\n#include <cctype>\n#include <algorithm>\n\nusing namespace std;\n\nusing i64 = long long;\n\nstruct Node {\n    i64 value;\n    int cost;\n    bool operator<(const Node& other) const {\n        return cost > other.cost;\n    }\n};\n\nunordered_set<i64> visited;\n\nbool check_visited(i64 x) {\n    return visited.find(x) != visited.end();\n}\n\nNode compute_uupper(i64 n) {\n    i64 res = 0;\n    int cnt = 0;\n    while (res < n) {\n        res = res * 10 + 1;\n        ++cnt;\n    }\n    return {res, cnt};\n}\n\nNode compute_upper(i64 n) {\n    i64 res = 0;\n    int cnt = 0;\n    while (res * 10 + 1 <= n) {\n        res = res * 10 + 1;\n        ++cnt;\n    }\n    i64 base = res;\n    int base_cnt = cnt;\n    while (res < n) {\n        res += base;\n        cnt += base_cnt;\n    }\n    return {res, cnt};\n}\n\nNode compute_lower(i64 n) {\n    i64 res = 0;\n    int cnt = 0;\n    while (res * 10 + 1 <= n) {\n        res = res * 10 + 1;\n        ++cnt;\n    }\n    i64 base = res;\n    int base_cnt = cnt;\n    while (res + base <= n) {\n        res += base;\n        cnt += base_cnt;\n    }\n    return {res, cnt};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    i64 n;\n    cin >> n;\n\n    priority_queue<Node> pq;\n    pq.push({n, 0});\n\n    while (!pq.empty()) {\n        Node cur = pq.top();\n        pq.pop();\n\n        if (cur.value == 0) {\n            cout << cur.cost << '\\n';\n            return 0;\n        }\n\n        if (check_visited(cur.value)) continue;\n        visited.insert(cur.value);\n\n        vector<Node> candidates;\n        candidates.push_back(compute_lower(cur.value));\n        candidates.push_back(compute_upper(cur.value));\n        candidates.push_back(compute_uupper(cur.value));\n\n        for (auto& cand : candidates) {\n            cand.cost += cur.cost;\n            cand.value = std::abs(cur.value - cand.value);\n            pq.push(cand);\n        }\n    }\n\n    cout << 0 << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nfrom collections import deque\n\ndef main():\n    n = int(input().strip())\n    \n    visited = set()\n    \n    def compute_uupper(n_val):\n        res = 0\n        cnt = 0\n        while res < n_val:\n            res = res * 10 + 1\n            cnt += 1\n        return (res, cnt)\n    \n    def compute_upper(n_val):\n        res = 0\n        cnt = 0\n        while res * 10 + 1 <= n_val:\n            res = res * 10 + 1\n            cnt += 1\n        base = res\n        base_cnt = cnt\n        while res < n_val:\n            res += base\n            cnt += base_cnt\n        return (res, cnt)\n    \n    def compute_lower(n_val):\n        res = 0\n        cnt = 0\n        while res * 10 + 1 <= n_val:\n            res = res * 10 + 1\n            cnt += 1\n        base = res\n        base_cnt = cnt\n        while res + base <= n_val:\n            res += base\n            cnt += base_cnt\n        return (res, cnt)\n    \n    # Priority queue: (cost, value)\n    pq = []\n    heapq.heappush(pq, (0, n))\n    \n    while pq:\n        cost, value = heapq.heappop(pq)\n        \n        if value == 0:\n            print(cost)\n            return\n        \n        if value in visited:\n            continue\n        visited.add(value)\n        \n        candidates = []\n        candidates.append(compute_lower(value))\n        candidates.append(compute_upper(value))\n        candidates.append(compute_uupper(value))\n        \n        for res, cnt in candidates:\n            new_cost = cost + cnt\n            new_value = abs(value - res)\n            heapq.heappush(pq, (new_cost, new_value))\n    \n    print(0)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011967896716669202, -8.344646857949556e-07, -3.576278118089249e-07, -2.3841574147809297e-05, -0.013022142462432384, -0.07039220631122589, -0.2520749568939209, -0.0282880999147892, -2.145764938177308e-06, -0.05196806415915489, -0.00114292127545923, -0.3705003261566162, -0.5055180788040161, -3.71926071238704e-05, -7.152555099310121e-07, -0.25285735726356506, -2.6464111215318553e-05, -2.9802276912960224e-06, -4.291525328881107e-06, -0.006873415783047676, -7.152555099310121e-07, -0.16022653877735138, -0.0003363520372658968, -5.960462772236497e-07, -0.04549235478043556, -4.768370445162873e-07, -7.033323527139146e-06, -0.0009129646932706237, -0.0010347970528528094, -8.344646857949556e-07, -0.47895240783691406, -0.20143117010593414, -0.0002060916303889826, -2.729855441430118e-05, -1.0123660564422607, -0.0068361214362084866, -7.629365427419543e-06, -1.1920922133867862e-06, -3.814689989667386e-06, 0.0, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -6.437280717364047e-06, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, -9.536738616588991e