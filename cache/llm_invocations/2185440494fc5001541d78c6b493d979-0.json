ith_stdio(false);\n    cin.tie(nullptr);\n\n    initPerms();\n\n    int n;\n    cin >> n;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> P[i][j];\n            P[i][j] = (P[i][j] * INV) % MOD;\n        }\n\n    for (int i = 0; i < 6; ++i)\n        for (int j = n; j < 6; ++j) {\n            if (i == j) P[i][j] = 1;\n            else { P[i][j] = 0; P[j][i] = 0; }\n        }\n\n    for (int mask = 0; mask < (1<<18); ++mask) {\n        ll probL = 1, probR = 1;\n        int bitsL = 0, bitsR = 0;\n        for (int i = 0; i < 6; ++i) {\n            for (int j = 0; j < 3; ++j) {\n                int pos = i*3 + j;\n                int pL = P[i][j], pR = P[i][j+3];\n                if (mask & (1<<pos)) {\n                    probL = probL * pL % MOD;\n                    probR = probR * pR % MOD;\n                } else {\n                    probL = probL * (MOD+1-pL) % MOD;\n                    probR = probR * (MOD+1-pR) % MOD;\n                }\n            }\n        }\n        for (int t = 0; t < 20; ++t) {\n            if (check(permL[t].first, mask)) bitsL |= (1<<t);\n            if (check(permR[t].first, mask)) bitsR |= (1<<t);\n        }\n        L[bitsL] = (L[bitsL] + probL) % MOD;\n        R[bitsR] = (R[bitsR] + probR) % MOD;\n    }\n\n    memcpy(S, L, sizeof L);\n    for (int b = 0; b < 20; ++b) {\n        for (int mask = 0; mask < (1<<20); ++mask) {\n            if (mask & (1<<b)) {\n                S[mask] = (S[mask] + S[mask ^ (1<<b)]) % MOD;\n            }\n        }\n    }\n\n    ll ans = 0;\n    int full = (1<<20)-1;\n    for (int i = 0; i < (1<<20); ++i) {\n        ans = (ans + R[i] * S[full ^ i]) % MOD;\n    }\n    cout << (1 + MOD - ans) % MOD << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport itertools\n\nMOD = 1000000007\nINV = 570000004\n\ndef ini