 % mod, x + 1, 4)\n    else:\n        dfs2(P * (mod + 1 - a[x][y]) % mod, x, y + 1)\n\ndef main():\n    global n, lim, ans, p1, p2, a, h\n    input = sys.stdin.read\n    data = input().split()\n    n = int(data[0])\n    idx = 1\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            a[i][j] = int(data[idx])\n            idx += 1\n            a[i][j] = a[i][j] * inv(100) % mod\n    for i in range(n + 1, 7):\n        a[i][i] = 1\n    tot = 0\n    for i in range(1, 7):\n        for j in range(i + 1, 7):\n            for k in range(j + 1, 7):\n                h[i][j][k] = 1 << tot\n                tot += 1\n    dfs1(1, 1, 1)\n    lim = (1 << 20) - 1\n    for i in range(20):\n        for j in range(lim + 1):\n            if (j >> i) & 1:\n                p1[j] = (p1[j] + p1[j ^ (1 << i)]) % mod\n    dfs2(1, 1, 4)\n    ans = (mod + 1 - ans) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.001295596593990922, -0.00029494395130313933, -1.1472419600977446e-06, -3.023293538717553e-05, -0.6490972638130188, -0.0018793739145621657, -0.006744269747287035, -0.39456358551979065, -0.16026373207569122, -0.2811938226222992, -0.6330284476280212, -0.0006504826596938074, -0.0009486184571869671, -0.22584299743175507, -0.048598501831293106, -0.31326842308044434, -2.6060808522743173e-05, -0.026300301775336266, -3.128163257315464e-07, -0.0017021986423060298, -0.0001097417771234177, -1.9361264946837764e-07, -0.030015433207154274, -0.005259253084659576, -7.076218025758862e-05, -0.0010342379100620747, -3.130576806142926e-05, -0.0019289902411401272, -7.107425062713446e-06, 0.0, -8.7689099018462e-05, -4.320199877838604e-07, -7.941850526549388e-06, -6.704273118884885e-07, -0.015345276333391666, -0.0778212770819664, -0.0017810913268476725, -0.6348879337310791, -3.128163257315464e-07, -9.341087570646778e-05, -3.416665640543215e-05, -0.0004894073354080319, -0.0002370329457335174, -