 = 1000000007L;\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int P = sc.nextInt();\n        int K = sc.nextInt();\n        sc.close();\n\n        if (K == 0) {\n            System.out.println(modPow(P, P - 1, M));\n        } else if (K == 1) {\n            System.out.println(modPow(P, P, M));\n        } else {\n            int[] k = new int[P];\n            for (int i = 0; i < P; i++) {\n                k[i] = (int)(((long)K * i) % P);\n            }\n\n            boolean[] used = new boolean[P];\n            int[] cycleLenCounts = new int[P];\n            for (int start = 0; start < P; start++) {\n                if (used[start]) continue;\n                int cur = start;\n                int length = 0;\n                while (!used[cur]) {\n                    used[cur] = true;\n                    cur = k[cur];\n                    length++;\n                }\n                cycleLenCounts[length]++;\n            }\n\n            long ans = 1L;\n            for (int length = 2; length < P; length++) {\n                int cnt = cycleLenCounts[length];\n                if (cnt > 0) {\n                    long base = (long)length * cnt + 1;\n                    ans = ans * modPow(base, cnt, M) % M;\n                }\n            }\n            System.out.println(ans);\n        }\n    }\n\n    static long modPow(long base, long exp, long mod) {\n        long result = 1L;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.6689286894688848e-06, 0.0, 0.0, -0.0002562671434134245, -5.0424259825376794e-05, 0.0, -0.0001037067049765028, -0.10109879821538925, -0.005252964794635773, -8.583032467868179e-06, 0.0, -0.021904442459344864,