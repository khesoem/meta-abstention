{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <cassert>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MOD = 1000000007;\n\ntypedef vector< vector< int > > mt;\n\nmt shift(const mt &a, int shift)\n{\n    int k = int(a.size()) - 1;\n    shift = (k - shift) % k;\n    mt res = a;\n    for (int i = 0; i < k; ++i) {\n        for (int j = 0; j < k; ++j) {\n            res[i][j] = a[(i + shift) % k][(j + shift) % k];\n        }\n    }\n    for (int j = 0; j < k; ++j) {\n        res[k][j] = a[k][(j + shift) % k];\n    }\n    return res;\n}\n\nmt operator *(const mt &a, const mt &b)\n{\n    int n = int(a.size()), k = int(a[0].size()), m = int(b[0].size());\n    mt res(n, vector< int >(m, 0));\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < m; ++j) {\n            int tmp = 0;\n            for (int l = 0; l < k; ++l) {\n                tmp = (tmp + 1ll * a[i][l] * b[l][j]) % MOD;\n            }\n            res[i][j] = tmp;\n        }\n    }\n    return res;\n}\n\n// Recursive digit processing\nvoid process_digits(const vector<int>& vec, int idx, mt& base, int& sl, const vector<mt>& dp, int k)\n{\n    if (idx < 0) return;\n    int rest = vec[idx];\n    for (int it = 0; it < rest; ++it, sl = (sl + 1) % k) {\n        base = base * shift(dp[idx], sl);\n    }\n    process_digits(vec, idx - 1, base, sl, dp, k);\n}\n\nint main()\n{\n    ll n;\n    int k;\n    cin >> n >> k;\n    int max_depth = 0;\n    {\n        ll tmp = n;\n        while (tmp != 0) {\n            ++max_depth;\n            tmp /= k;\n        }\n    }\n    vector<mt> dp(max_depth);\n    dp[0].assign(k + 1, vector< int >(k + 1, 0));\n    for (int i = 0; i <= k; ++i) {\n        for (int j = 0; j <= k; ++j) {\n            dp[0][i][j] = (i == j || j == 0);\n        }\n    }\n    mt e(k + 1, vector< int >(k + 1, 0));\n    for (int i = 0; i <= k; ++i) {\n        e[i][i] = 1;\n    }\n    for (int depth = 1; depth < max_depth; ++depth) {\n        dp[depth] = e;\n        mt bs = dp[depth - 1];\n        int curx = k;\n        for (int i = 0; (1 << i) <= curx; ++i) {\n            if (curx & (1 << i)) {\n                dp[depth] = bs * shift(dp[depth], (1 << i));\n                curx ^= (1 << i);\n            }\n            bs = bs * shift(bs, (1 << i));\n        }\n    }\n    mt base(1, vector< int >(k + 1, 0));\n    base[0][k] = 1;\n    int sl = 0;\n    ll x = n;\n    vector<int> vec;\n    while (x != 0) {\n        vec.push_back(x % k);\n        x /= k;\n    }\n    process_digits(vec, int(vec.size()) - 1, base, sl, dp, k);\n    int res = 0;\n    for (int i = 0; i <= k; ++i) {\n        res = (res + base[0][i]) % MOD;\n    }\n    cout << res << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef shift(a, shift_val):\n    k = len(a) - 1\n    shift_val = (k - shift_val) % k\n    res = [row[:] for row in a]\n    for i in range(k):\n        for j in range(k):\n            res[i][j] = a[(i + shift_val) % k][(j + shift_val) % k]\n    for j in range(k):\n        res[k][j] = a[k][(j + shift_val) % k]\n    return res\n\ndef mat_mul(a, b):\n    n = len(a)\n    k = len(a[0])\n    m = len(b[0])\n    res = [[0] * m for _ in range(n)]\n    for i in range(n):\n        for j in range(m):\n            tmp = 0\n            for l in range(k):\n                tmp = (tmp + a[i][l] * b[l][j]) % MOD\n            res[i][j] = tmp\n    return res\n\ndef identity(n):\n    return [[1 if i == j else 0 for j in range(n)] for i in range(n)]\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n\n    # compute number of digits in base k\n    max_depth = 0\n    tmp = n\n    while tmp != 0:\n        max_depth += 1\n        tmp //= k\n\n    # dp[depth] is a (k+1) x (k+1) matrix\n    dp = [None] * max_depth\n    dp[0] = [[0] * (k + 1) for _ in range(k + 1)]\n    for i in range(k + 1):\n        for j in range(k + 1):\n            dp[0][i][j] = 1 if (i == j or j == 0) else 0\n\n    e = identity(k + 1)\n\n    for depth in range(1, max_depth):\n        dp[depth] = [row[:] for row in e]  # copy of identity\n        bs = [row[:] for row in dp[depth - 1]]  # copy\n        curx = k\n        i = 0\n        while (1 << i) <= curx:\n            if curx & (1 << i):\n                dp[depth] = mat_mul(bs, shift(dp[depth], (1 << i)))\n                curx ^= (1 << i)\n            bs = mat_mul(bs, shift(bs, (1 << i)))\n            i += 1\n\n    # base is a 1 x (k+1) matrix\n    base = [[0] * (k + 1)]\n    base[0][k] = 1\n    sl = 0\n\n    # convert n to base k digits (least significant first)\n    vec = []\n    x = n\n    while x != 0:\n        vec.append(x % k)\n        x //= k\n\n    # process digits from most significant to least\n    for idx in range(len(vec) - 1, -1, -1):\n        d = vec[idx]\n        for _ in range(d):\n            base = mat_mul(base, shift(dp[idx], sl))\n            sl = (sl + 1)