             connect(node_id[sr][sc], node_id[nr][nc] + node_cnt, 10)\n            \n            sz = len(q2r)\n            for _ in range(sz):\n                ur, uc = q2r.popleft(), q2c.popleft()\n                for k in range(4):\n                    nr, nc = ur + dr[k], uc + dc[k]\n                    if valid(nr, nc) and d2[nr][nc] == -1:\n                        d2[nr][nc] = d2[ur][uc] + 1\n                        q2r.append(nr)\n                        q2c.append(nc)\n    \n    def bfs_level():\n        lvl = [-1] * (2 * node_cnt + 2)\n        q = deque()\n        q.append(0)\n        lvl[0] = 0\n        while q:\n            u = q.popleft()\n            for e in adj[u]:\n                if e[1] > 0 and lvl[e[0]] == -1:\n                    lvl[e[0]] = lvl[u] + 1\n                    q.append(e[0])\n        return lvl[2 * node_cnt + 1] != -1\n    \n    def dfs_flow(u, flow, ptr):\n        if u == 2 * node_cnt + 1:\n            return flow\n        for i in range(ptr[u], len(adj[u])):\n            ptr[u] = i\n            e = adj[u][i]\n            if e[1] > 0 and lvl[e[0]] == lvl[u] + 1:\n                pushed = dfs_flow(e[0], min(flow, e[1]), ptr)\n                if pushed > 0:\n                    e[1] -= pushed\n                    adj[e[0]][e[2]][1] += pushed\n                    return pushed\n        return 0\n    \n    def dinic_max_flow():\n        total = 0\n        while bfs_level():\n            ptr = [0] * (2 * node_cnt + 2)\n            pushed = dfs_flow(0, float('inf'), ptr)\n            while pushed > 0:\n                total += pushed\n                pushed = dfs_flow(0, float('inf'), ptr)\n        return total\n    \n    # Initialize node_id and node_cnt\n    for i in range(n):\n        for j in range(n):\n            if board1[i][j] == 'Z':\n                zero_r, zero_c = i, j\n            elif valid(i, j):\n                node_id[i][j] = node_cnt + 1\n                node_cnt += 1\n    \n    # Expand connections\n    for i in range(