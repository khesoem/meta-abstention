n}\n\nvoid dijkstra(int s) {\n    for (int i=0;i<maxn;i++) {\n        d[i] = INF;\n    }\n    d[s] = 0;\n    set<pair<ll,int>> q;\n    q.insert({0,s});\n    while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i=0;i<g[v].size();i++) {\n            int eid = g[v][i];\n            if (edges[eid].cap==edges[eid].flow) continue;\n            int to = edges[eid].to;\n            ll len = edges[eid].cost + phi[v] - phi[to];\n            if (d[v]+len<d[to]) {\n                q.erase({d[to],to});\n                d[to] = d[v]+len;\n                par[to] = eid;\n                q.insert({d[to],to});\n            }\n        }\n    }\n}\n\npair<ll,ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (1) {\n        if (d[t]==INF) break;\n        ll pushed=  INF, sum = 0;\n        for (int tmp = t;tmp!=s;) {\n//            if (tmp==100) {\n//                cout << \"xyu\";\n//            }\n            int eid = par[tmp];\n            pushed = min(pushed, edges[eid].cap-edges[eid].flow);\n            sum+=edges[eid].cost;\n            tmp = edges[eid].from;\n        }\n        flow+=pushed;\n        cost+=pushed*sum;\n        //cout << \"flow: \" << flow << \", cost: \" << cost << endl <<  t << \" \";\n        for (int tmp=t;tmp!=s;) {\n            int eid = par[tmp];\n            edges[eid].flow+=pushed;\n            edges[eid^1].flow-=pushed;\n            tmp = edges[eid].from;\n          //  cout << tmp << \" \";\n        }\n        //cout << endl;\n\n        dijkstra(s);\n        for (int i=0;i<maxn;i++) {\n            phi[i] = d[i];\n        }\n    }\n    return {cost, flow};\n}\nvoid solve() {\n    int n,m,k,c,d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnts(n,0);\n    for (int i=0;i<k;i++) {\n        int ai;\n        cin >> ai;\n        ai--;\n        cnts[ai]++;\n    }\n    for (int i=0;i<n;i++) {\n        add_edge(5000, i, cnts[i],0);\n    }\n    for (int it=0;it<m;it++) {\n        int u,v;\n        cin >> u >> v;\n        u--; v--;\n        for (int i=0;i<99;i++) {\n            ll cost = d;\n            for (int j=0;j<50;j++) {\n                add_edge(u+i*50, v+(i+1)*50, 1, cost);\n                add_edge(v+i*50, u+(i+1)*50, 1, cost);\n                cost+=2*d;\n            }\n        }\n    }\n    for (int i=0;i<=99;i++) {\n        add_edge(0+i*50, 5001, INF, c*i);\n    }\n\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<99;j++) {\n            add_edge(i+j*50, i+(j+1)*50, INF, 0);\n        }\n    }\n    //add_edge(0+99*50, 5001, INF, 0);\n\n    auto p = mincost_maxflow(5000, 5001);\n    assert(p.second==k);\n    cout << p.first;\n}\nint main() {\n    cin.tie(0);\n    cout.tie(0);\n    ios_base::sync_with_stdio(false);\n    cout << setprecision(20) << fixed;\n   // freopen(\"input.txt\",\"r\", stdin);\n//    int t;\n//    cin >> t;\n//    for (int i=0;i<t;i++)\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class MinCostMaxFlow {\n    static class Edge {\n        int from, to;\n        long cap, cost, flow;\n        Edge(int from, int to, long cap, long cost) {\n            this.from = from;\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.flow = 0;\n        }\n    }\n\n    static final int maxn = 5007;\n    static final long INF = (long)1e9;\n    static List<Edge> edges = new ArrayList<>();\n    static List<Integer>[] g = new ArrayList[maxn];\n    static long[] d = new long[maxn], phi = new long[maxn];\n    static int[] par = new int[maxn];\n\n    static {\n        for (int i = 0; i < maxn; i++) {\n            g[i] = new ArrayList<>();\n        }\n    }\n\n    static void addEdge(int u, int v, long cap, long cost) {\n        g[u].add(edges.size());\n        edges.add(new Edge(u, v, cap, cost));\n        g[v].add(edges.size());\n        edges.add(new Edge(v, u, 0, -cost));\n    }\n\n    static void fordBellman(int s, int n) {\n        Arrays.fill(phi, INF);\n        phi[s] = 0;\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < edges.size(); j++) {\n                Edge e = edges.get(j);\n                if (e.cap == e.flow) continue;\n                int from = e.from;\n                int to = e.to;\n                long len = e.cost;\n                if (phi[from] == INF) continue;\n                phi[to] = Math.min(phi[to], phi[from] + len);\n            }\n        }\n    }\n\n    static void dijkstra(int s) {\n        Arrays.fill(d, INF);\n        d[s] = 0;\n        PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n        pq.offer(new long[]{0, s});\n        while (!pq.isEmpty()) {\n            long[] curr = pq.poll();\n            long dist = curr[0];\n            int v = (int) curr[1];\n            if (dist > d[v]) continue;\n            for (int eid : g[v]) {\n                Edge e = edges.get(eid);\n                if (e.cap == e.flow) continue;\n                int to = e.to;\n                long len = e.cost + phi[v] - phi[to];\n                if (d[v] + len < d[to]) {\n                    d[to] = d[v] + len;\n                    par[to] = eid;\n                    pq.offer(new long[]{d[to], to});\n                }\n            }\n        }\n    }\n\n    static long[] minCostMaxFlow(int s, int t) {\n        fordBellman(s, 50);\n        dijkstra(s);\n        long flow = 0, cost = 0;\n        while (true) {\n            if (d[t] == INF) break;\n            long pushed = INF, sum = 0;\n            for (int tmp = t; tmp != s; tmp = edges.get(par[tmp]).from) {\n                int eid = par[tmp];\n                pushed = Math.min(pushed, edges.get(eid).cap - edges.get(eid).flow);\n                sum += edges.get(eid).cost;\n            }\n            flow += pushed;\n            cost += pushed * sum;\n            for (int tmp = t; tmp != s; tmp = edges.get(par[tmp]).from) {\n                int eid = par[tmp];\n                edges.get(eid).flow += pushed;\n                edges.get(eid ^ 1).flow -= pushed;\n            }\n            dijkstra(s);\n            for (int i = 0; i < maxn; i++) {\n                phi[i] = d[i];\n            }\n        }\n        return new long[]{cost, flow};\n    }\n\n    public static void solve() {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] cnts = new int[n];\n        for (int i = 0; i < k; i++) {\n            int ai = sc.nextInt();\n            ai--;\n            cnts[ai]++;\n        }\n\n        for (int i = 0; i < n; i++) {\n            addEdge(5000, i, cnts[i], 0);\n        }\n\n        for (int it = 0; it < m; it++) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int i = 0; i < 99; i++) {\n                long costVal = d;\n                for (int j = 0; j < 50; j++) {\n                    addEdge(u + i * 50, v + (i + 1) * 50, 1, costVal);\n                    addEdge(v + i * 50, u + (i + 1) * 50, 1, costVal);\n                    costVal += 2L * d;\n                }\n            }\n        }\n\n        for (int i = 0; i <= 99; i++) {\n            addEdge(0 + i * 50, 5001, INF, c * i);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < 99; j++) {\n                addEdge(i + j * 50, i + (j + 1) * 50, INF, 0);\n            }\n        }\n\n        long[] p = minCostMaxFlow(5000, 5001);\n        if (p[1] != k) {\n            throw new AssertionError();\n        }\n        System.out.println(p[0]);\n    }\n\n    public static void main(String[] args) {\n        solve();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0005050156614743173, -0.00015169414109550416, -1.3856492842023727e-06, -7.553032628493384e-05, -1.1472419600977446e-06, -9.088346359931165e-07, -0.012584884651005268, -0.2821162939071655, -0.0006108098896220326, -0.00026264708139933646, -0.0291792843490839, -0.0006395269301719964, -0.008624029345810413, -3.128163257315464e-07, -0.45411503314971924, -3.726595241460018e-05, -0.038069259375333786, -2.696889623621246e-06, -0.2977924644947052, -0.0304257832467556, -0.0016110315918922424, -0.3153987526893616, -1.5048530030981055e-06, -2.3080716346157715e-05, -1.0280383548888494e-06, -4.961759259458631e-06, -2.1008713702030946e-06, -0.0005137138650752604, -3.128163257315464e-07, -0.00016444525681436062, -5.512236498361744e-07, -2.1008713702030946e-06, -8.518582762917504e-05, -2.629921436891891e-05, -4.847109812544659e-05, -0.004081128165125847, -3.128163257315464e-07, -0.20155122876167297, -0.0005717403837479651, -0.14271526038646698, -0.00019710339256562293, -0.0011892797192558646, -5.073596548754722e-05, -4.320199877838604e-07, -1.9361264946837764e-07, -3.173704271830502e-06, -1.9361264946837764e-07, -1.9361264946837764e-07, -3.650518920039758e-06, -1.1472419600977446e-06, -1.2664456789934775e-06, -0.008708884008228779, -7.719917630311102e-05, -2.696889623621246e-06, -1.9361264946837764e-07, -2.696889623621246e-06, -0.003602917306125164, -9.610702363715973e-06, -0.10021325200796127, -3.128163257315464e-07, -4.320199877838604e-07, -6.704273118884885e-07, -0.0002702760975807905, -5.080963092041202e-06, -1.0802738870552275e-05, -4.842555426876061e-06, 0.0, -3.8889261304575484e-06, -1.259079363080673e-05, -1.9361264946837764e-07, -8.180258191714529e-06, -4.320199877838604e-07, 0.0, -7.107425062713446e-06, -1.306760805164231e-05, -4.60414821645827e-06, -8.2994620242971e-06, -3.166338137816638e-05, -1.0921942703134846e-05, -1.9361264946837764e-07, -2.0219828002154827e-05, -6.611323624383658e-05, 0.0, -0.0007166040013544261, 0.