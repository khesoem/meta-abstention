                        if (i == j || j == k || k == i) continue;\n                        \n                        long[] v1 = new long[5];\n                        long[] v2 = new long[5];\n                        for (int d = 0; d < 5; d++) {\n                            v1[d] = points[j][d] - points[i][d];\n                            v2[d] = points[k][d] - points[i][d];\n                        }\n                        \n                        double dot = 0, m1 = 0, m2 = 0;\n                        for (int d = 0; d < 5; d++) {\n                            dot += v1[d] * v2[d];\n                            m1 += v1[d] * v1[d];\n                            m2 += v2[d] * v2[d];\n                        }\n                        \n                        double angle = Math.toDegrees(Math.acos(dot / Math.sqrt(m1 * m2)));\n                        if (angle < 90 - 1e-9) {\n                            foundBad = true;\n                            badIndices.add(i);\n                        }\n                    }\n                }\n            }\n            \n            pw.println(n - badIndices.size());\n            for (int i = 1; i <= n; i++) {\n                if (!badIndices.contains(i)) {\n                    pw.println(i);\n                }\n            }\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <set>\n#include <cmath>\n#include <sstream>\n#include <string>\n#include <algorithm>\n\nint main() {\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    \n    int n;\n    std::cin >> n;\n    std::cin.ignore();\n    \n    if (n >= 100) {\n        std::cout << 0 << std::endl;\n        return 0;\n    }\n    \n    std::vector<std::vector<int>> points(n + 1, std::vector<in