{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nstruct Arc {\n    int head;\n    int capacity;\n    int flow;\n    int weight;\n};\n\nconst int MAX_N = 10000;\nconst long long INF = 1e18;\n\nvector<Arc> arcs;\nvector<int> adj[MAX_N];\nlong long dist[MAX_N];\nint prevV[MAX_N], prevE[MAX_N];\nbool inq[MAX_N];\n\nvoid link(int u, int v, int cap, int w) {\n    adj[u].push_back(arcs.size());\n    arcs.push_back({v, cap, 0, w});\n    adj[v].push_back(arcs.size());\n    arcs.push_back({u, 0, 0, -w});\n}\n\nbool spfa(int s, int t) {\n    fill(dist, dist + MAX_N, INF);\n    fill(prevV, prevV + MAX_N, -1);\n    fill(prevE, prevE + MAX_N, -1);\n    fill(inq, inq + MAX_N, false);\n    \n    queue<int> q;\n    q.push(s);\n    dist[s] = 0;\n    inq[s] = true;\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = false;\n        \n        for (int i : adj[u]) {\n            Arc& a = arcs[i];\n            if (a.capacity - a.flow <= 0) continue;\n            int v = a.head;\n            long long nd = dist[u] + a.weight;\n            if (nd < dist[v]) {\n                dist[v] = nd;\n                prevV[v] = u;\n                prevE[v] = i;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    if (dist[t] == INF) return false;\n    \n    int cur = t;\n    while (cur != s) {\n        arcs[prevE[cur]].flow++;\n        arcs[prevE[cur] ^ 1].flow--;\n        cur = prevV[cur];\n    }\n    \n    return true;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    const int src = 9998, dst = 9999;\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        link(src, x, 1, 0);\n    }\n    \n    for (int i = 1; i <= 101; ++i) {\n        link((i - 1) * n, dst, k, (i - 1) * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        for (int layer = 1; layer <= 100; ++layer) {\n            for (int j = 1; j <= k; ++j) {\n                int cost = d * ((j - 1) * 2 + 1);\n                link(x + (layer - 1) * n, y + (layer - 1) * n + n, 1, cost);\n                link(y + (layer - 1) * n, x + (layer - 1) * n + n, 1, cost);\n            }\n        }\n    }\n    \n    for (int node = 0; node < n; ++node) {\n        for (int layer = 1; layer <= 100; ++layer) {\n            link(node + (layer - 1) * n, node + (layer - 1) * n + n, k, 0);\n        }\n    }\n    \n    long long total = 0;\n    for (int i = 0; i < k; ++i) {\n        if (spfa(src, dst)) {\n            total += dist[dst];\n        }\n    }\n    \n    cout << total << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Arc {\n        int head;\n        int capacity;\n        int flow;\n        int weight;\n        \n        Arc(int head, int capacity, int flow, int weight) {\n            this.head = head;\n            this.capacity = capacity;\n            this.flow = flow;\n            this.weight = weight;\n        }\n    }\n    \n    static final int MAX_N = 10000;\n    static final long INF = (long)1e18;\n    \n    static List<Arc> arcs = new ArrayList<>();\n    static List<Integer>[] adj = new List[MAX_N];\n    static long[] dist = new long[MAX_N];\n    static int[] prevV = new int[MAX_N];\n    static int[] prevE = new int[MAX_N];\n    static boolean[] inq = new boolean[MAX_N];\n    \n    static void link(int u, int v, int cap, int w) {\n        adj[u].add(arcs.size());\n        arcs.add(new Arc(v, cap, 0, w));\n        adj[v].add(arcs.size());\n        arcs.add(new Arc(u, 0, 0, -w));\n    }\n    \n    static boolean spfa(int s, int t) {\n        Arrays.fill(dist, INF);\n        Arrays.fill(prevV, -1);\n        Arrays.fill(prevE, -1);\n        Arrays.fill(inq, false);\n        \n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        dist[s] = 0;\n        inq[s] = true;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            \n            for (int i : adj[u]) {\n                Arc a = arcs.get(i);\n                if (a.capacity - a.flow <= 0) continue;\n                int v = a.head;\n                long nd = dist[u] + a.weight;\n                if (nd < dist[v]) {\n                    dist[v] = nd;\n                    prevV[v] = u;\n                    prevE[v] = i;\n                    if (!inq[v]) {\n                        inq[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        \n        if (dist[t] == INF) return false;\n        \n        int cur = t;\n        while (cur != s) {\n            arcs.get(prevE[cur]).flow++