riginal_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int to, int cap, int cost, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static final int INF = 0x3f3f3f3f;\n\n    static void addEdge(ArrayList<ArrayList<Edge>> g, int u, int v, int flow, int cost) {\n        Edge a = new Edge(v, flow, cost, g.get(v).size());\n        Edge b = new Edge(u, 0, -cost, g.get(u).size());\n        g.get(u).add(a);\n        g.get(v).add(b);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int s = 0;\n        int t = n * 100 + 1;\n        int nodeCount = t + 1;\n        ArrayList<ArrayList<Edge>> g = new ArrayList<>(nodeCount);\n        for (int i = 0; i < nodeCount; i++) {\n            g.add(new ArrayList<>());\n        }\n\n        // edges from time layers to sink\n        for (int i = 1; i <= 100; i++) {\n            addEdge(g, i, t, 100, 0);\n        }\n\n        // initial people\n        for (int i = 1; i <= k; i++) {\n            int v = sc.nextInt();\n            addEdge(g, s, (v - 1) * 100 + 1, 1, 0);\n        }\n\n        // stay edges\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                addEdge(g, (i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n            }\n        }\n\n        // road edges\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                int idx = (u - 1) * 100 