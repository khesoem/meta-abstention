 << vr)) continue;\n    Val ri = Val(0.0, 0.0);\n    dbl same = 0.0;\n\n    for(int i = 0;i < n;++i)\n      if(i != vr)\n        if(msk & (1 << i)){\n          same += p[i];\n          ri = Add(ri, Mult(dp[msk ^ (1 << i)], p[i]));\n        }\n\n    dp[msk] = Div(ri, 1.0 - same);\n  }\n\n  Val tot(1.0, 0.0);\n  for(int msk = 1;msk < (1 << n);++msk)\n    if(!(msk & (1 << vr))){\n      tot = Add(tot, dp[msk]);\n    }\n\n  dbl alp = (1.0 - tot.se) / tot.fi;\n\n  Val bad(0.0, 0.0);\n  for(int msk = 0;msk < (1 << n);++msk){\n    if(msk & (1 << vr)) continue;\n    if(BITS(msk) >= k) bad = Add(bad, dp[msk]);\n  }\n\n  return 1.0 - (alp * bad.fi + bad.se);\n}\n\nint main(){\n  int tc = 1;\n  while(tc--) {\n    scanf(\"%d%d\", &n, &k);\n    for(int i = 0;i < n;++i)\n      scanf(\"%lf\", &p[i]);\n\n    for(int i = 0;i < n;++i)\n      printf(\"%.12f%c\", Solve(i), (i + 1 == n ? '\\n' : ' '));\n  }\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nimport sys\n\ndef sz(a):\n    return len(a)\n\ndef BITS(a):\n    return bin(a).count('1')\n\nEPS = 1e-9\n\nclass Val:\n    def __init__(self, fi, se):\n        self.fi = fi\n        self.se = se\n    \n    def __add__(self, other):\n        return Val(self.fi + other.fi, self.se + other.se)\n    \n    def __sub__(self, other):\n        return Val(self.fi - other.fi, self.se - other.se)\n    \n    def __mul__(self, w):\n        return Val(self.fi * w, self.se * w)\n    \n    def __truediv__(self, w):\n        return Val(self.fi / w, self.se / w)\n\ndef Add(f, s):\n    return Val(f.fi + s.fi, f.se + s.se)\n\ndef Sub(f, s):\n    return Val(f.fi - s.fi, f.se - s.se)\n\ndef Mult(f, w):\n    return Val(f.fi * w, f.se * w)\n\ndef Div(f, w):\n    return Val(f.fi / w, f.se / w)\n\ndef Solve(vr, n, k, p, dp):\n    if p[vr] < EPS:\n        return 0.0\n    \n    dp[0] = Val(1.0, 0.0)\n    \n    for msk in range(1, 1 << n):\n        if msk & (1 << vr):\n            continue\n        ri = Val(0.0, 0.0)\n        same = 0.0\n        \n        for i in range(n):\n            if i != vr and (msk & (1 << i)):\n                same += p[i]\n                ri = Add(ri, Mult(dp[msk ^ (1 << i)], p[i]))\n        \n        dp[msk] = Div(ri, 1.0 - same)\n    \n    tot = Val(1.0, 0.0)\n    for msk in range(1, 1 << n):\n        if not (msk & (1 << vr)):\n            tot = Add(tot, dp[msk])\n    \n    alp = (1.0 - tot.se) / tot.fi\n    \n    bad = Val(0.0, 0.0)\n    for msk in range(1 << n):\n        if msk & (1 << vr):\n            continue\n        if BITS(msk) >= k:\n            bad = Add(bad, dp[msk])\n    \n    return 1.0 - (alp * bad.fi + bad.se)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    idx = 0\n    tc = int(data[idx])\n    idx += 1\n    \n    results = []\n    for _ in range(tc):\n        n = int(data[idx])\n        k = int(data[idx + 1])\n        idx += 2\n        p = []\n        for i in range(n):\n            p.append(float(data[idx]))\n            idx += 1\n        \n        dp = [None] * (1 << 20)\n        res = []\n        for i in range(n):\n            res.append(Solve(i, n, k, p, dp))\n        results.append(\" \".join(\"{:.12f}\".format(x) for x in res))\n    \n    print(\"\\n\".join(results))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00016842853801790625, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0005416594794951379, -0.31346651911735535, -0.22541967034339905, -0.08897402882575989, -0.0002269487304147333, -1.2278481335670222e-05, -0.02118833176791668, -0.8413825631141663, -5.125986263010418e-06, -0.00023147765023168176, -2.3841855067985307e-07, -4.768370445162873e-07, -2.932505594799295e-05, -1.1920928244535389e-07, -1.1086402082582936e-05, -0.11731700599193573, -0.07840787619352341, -0.00040415700641460717, -2.50339189733