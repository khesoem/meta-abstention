 int[] tmp = new int[Lg + 3];\n    int[] tmp2 = new int[Lg + 3];\n    int[] fac = new int[Max];\n    int[] ifac = new int[Max];\n\n    int bit(int x, int k) {\n        return (x >> k) & 1;\n    }\n\n    int powmod(int a, int b) {\n        int r = 1;\n        while (b > 0) {\n            if ((b & 1) == 1) r = (int)((1L * r * a) % mod);\n            a = (int)((1L * a * a) % mod);\n            b >>= 1;\n        }\n        return r;\n    }\n\n    void addPoly(int[] a, int[] b) {\n        for (int i = 0; i <= N; i++) {\n            a[i] = (a[i] + b[i]) % mod;\n            if (a[i] < 0) a[i] += mod;\n        }\n    }\n\n    void subPoly(int[] a, int[] b) {\n        for (int i = 0; i <= N; i++) {\n            a[i] = (a[i] - b[i]) % mod;\n            if (a[i] < 0) a[i] += mod;\n        }\n    }\n\n    void mulPoly(int[] res, int[] a, int[] b) {\n        Arrays.fill(tmp, 0);\n        for (int i = 0; i <= N; i++) {\n            for (int j = 0; j <= i; j++) {\n                tmp[i] = (int)((tmp[i] + 1L * a[j] * b[i - j]) % mod);\n            }\n        }\n        System.arraycopy(tmp, 0, res, 0, tmp.length);\n    }\n\n    void zetaTransform() {\n        for (int i = 0; i < N; i++) {\n            for (int msk = n; msk >= 0; msk--) {\n                if (bit(msk, i) == 1) {\n                    addPoly(Ans[msk], Ans[msk ^ (1 << i)]);\n                }\n            }\n        }\n    }\n\n    void mobiusTransform() {\n        for (int i = 0; i < N; i++) {\n            for (int msk = n; msk >= 0; msk--) {\n                if (bit(msk, i) == 1) {\n                    subPoly(Ans[msk], Ans[msk ^ (1 << i)]);\n                }\n            }\n        }\n    }\n\n    public void run() throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        K = Integer.parseInt(st.nextToken());\n        mod = Integer.parseInt(st.nextToken());\n\n        long ans = powmod(K, n);\n        if ((n & 1) == 1) {\n            System.out.println(ans);\n            return;\n        }\n        N = Integer.bitCount(n);\n        int Nbef = n;\n        int[] vec = new int[Lg];\n        int cnt = 0;\n        for (int i = 0; i < Lg; i++) {\n            if (bit(n, i) == 1) vec[cnt++] = i;\n        }\n        n = (1 << N) - 1;\n\n        fac[0] = 1;\n        for (int i = 1; i < Max; i++) {\n            fac[i] = (int)((1L * i * fac[i - 1]) % mod);\n        }\n        ifac[Max - 1] = powmod(fac[Max - 1], mod - 2);\n        for (int i = Max - 2; i >= 0; i--) {\n            ifac[i] = (int)((1L * (i + 1) * ifac[i + 1]) % mod);\n        }\n\n        for (int i = 0; i <= n; i++) {\n            int Real = 0;\n            for (int j = 0; j < N; j++) {\n                if (bit(i, j) == 1) Real += (1 << vec[j]);\n            }\n            Ans[i][Integer.bitCount(i)] = ifac[Real];\n        }\n\n        zetaTransform();\n\n        for (int i = 0; i <= n; i++) {\n            int KK = K;\n            Arrays.fill(tmp2, 0);\n            tmp2[0] = 1;\n            while (KK > 0) {\n                if ((KK & 1) == 1) mulPoly(tmp2, tmp2, Ans[i]);\n                mulPoly(Ans[i], Ans[i], Ans[i]);\n                KK >>= 1;\n            }\n            System.arraycopy(tmp2, 0, Ans[i], 0, tmp2.length);\n        }\n\n        mobiusTransform();\n        ans = (ans - 1L * Ans[n][N] * fac[Nbef]) % mod;\n        if (ans < 0) ans += mod;\n        System.out.println(ans);\n    }\n\n    public static void main(String[] args) throws IOException {\n        new Solver().run();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.152555e-07, 0.0, 0.0, -0.00010013079, -4.4344873e-05, -3.4570635e-06, -1.502225, -0.062260572, -1.1920922e-06, -1.1920928e-07, -0.00193028, -0.0016484971, -0.001998691, -2.145765e-06, -0.3923355, -1.072883e-06, -0.006715112, -0.00016175392, -1.3438028, -0.025801029, -9.1790735e-06, -0.