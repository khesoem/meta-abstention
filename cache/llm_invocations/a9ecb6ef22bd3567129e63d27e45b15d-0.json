\n            }\n        }\n    }\n    return level[t] != -1;\n}\nlong long dfs(int u, long long f) {\n    if (u == sink) return f;\n    inq[u] = 1;\n    for (int &i = iter[u]; i < (int)graph[u].size(); ++i) {\n        Edge &e = graph[u][i];\n        if (e.cap > 0 && !inq[e.to] && level[e.to] == level[u] + e.cost) {\n            long long d = dfs(e.to, min(f, (long long)e.cap));\n            if (d > 0) {\n                total_cost += d * e.cost;\n                e.cap -= d;\n                graph[e.to][e.rev].cap += d;\n                return d;\n            }\n        }\n    }\n    return 0;\n}\nlong long dinic(int s, int t) {\n    total_cost = 0; sink = t;\n    while (spfa(s, t)) {\n        memset(iter, 0, sizeof(iter));\n        while (dfs(s, INF) > 0);\n    }\n    return total_cost;\n}\nint n, m, kk, c, d, a[55];\nint main() {\n    ios::sync_with_stdio(false);\n    cin >> n >> m >> kk >> c >> d;\n    for (int i = 1; i <= kk; ++i) cin >> a[i];\n    int s = 0, t = n * 100 + 1;\n    for (int i = 1; i <= 100; ++i) add_edge(i, t, INF, 0);\n    for (int i = 1; i <= kk; ++i) add_edge(s, (a[i] - 1) * 100 + 1, 1, 0);\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 100; ++j)\n            add_edge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, INF, c);\n    int t1, t2;\n    for (int _ = 1; _ <= m; ++_) {\n        cin >> t1 >> t2;\n        for (int i = 1; i < 100; ++i)\n            for (int j = 1; j <= kk; ++j) {\n                int val = c + d * (j * j - (j - 1) * (j - 1));\n                add_edge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val);\n                add_edge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val);\n            }\n    }\n    cout << dinic(s, t) << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev;\n     