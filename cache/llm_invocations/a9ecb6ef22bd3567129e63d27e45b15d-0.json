nic(int s, int t) {\n        totalCost = 0;\n        sink = t;\n        while (spfa(s, t)) {\n            Arrays.fill(iter, 0);\n            while (dfs(s, INF) > 0);\n        }\n        return totalCost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int kk = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] a = new int[kk + 1];\n        for (int i = 1; i <= kk; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        int maxNode = n * 100 + 2;\n        graph = new ArrayList[maxNode];\n        for (int i = 0; i < maxNode; i++) {\n            graph[i] = new ArrayList<>();\n        }\n        level = new int[maxNode];\n        iter = new int[maxNode];\n        inq = new boolean[maxNode];\n\n        int s = 0;\n        int t = n * 100 + 1;\n\n        for (int i = 1; i <= 100; i++) {\n            addEdge(i, t, INF, 0);\n        }\n        for (int i = 1; i <= kk; i++) {\n            addEdge(s, (a[i] - 1) * 100 + 1, 1, 0);\n        }\n        for (int i = 2; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, INF, c);\n            }\n        }\n        for (int _ = 1; _ <= m; _++) {\n            int t1 = sc.nextInt();\n            int t2 = sc.nextInt();\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= kk; j++) {\n                    int val = c + d * (j * j - (j - 1) * (j - 1));\n                    addEdge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val);\n                    addEdge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val);\n                }\n            }\n        }\n\n        System.out.println(dinic(s, t));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, -4.911301948595792e-05, -0.00013565097469836473, 0.0, 