std;\n\nclass FastScanner {\npublic:\n    int nextInt() {\n        char c;\n        // skip non-printable characters (ASCII <33 or >126)\n        while (true) {\n            c = getchar();\n            if (c == EOF) return 0; // should not happen for valid input\n            if (c >= 33 && c <= 126) break;\n        }\n        int sign = 1;\n        if (c == '-') {\n            sign = -1;\n            c = getchar();\n        }\n        int val = 0;\n        while (c >= '0' && c <= '9') {\n            val = val * 10 + (c - '0');\n            c = getchar();\n        }\n        // delimeter (non-printable) is consumed, next call will skip it\n        return sign * val;\n    }\n};\n\nint main() {\n    FastScanner sc;\n    int n = sc.nextInt();\n    if (n >= 12) {\n        cout << 0 << endl;\n        return 0;\n    }\n    vector<vector<int>> a(n, vector<int>(5));\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 5; j++) {\n            a[i][j] = sc.nextInt();\n        }\n    }\n    vector<int> ans;\n    for (int i = 0; i < n; i++) {\n        bool flag = true;\n        for (int j = 0; j < n && flag; j++) {\n            for (int k = 0; k < n && flag; k++) {\n                if (i == j || j == k || k == i) continue;\n                int sum = 0;\n                for (int l = 0; l < 5; l++) {\n                    sum += (a[j][l] - a[i][l]) * (a[k][l] - a[i][l]);\n                }\n                if (sum > 0) {\n                    flag = false;\n                }\n            }\n        }\n        if (flag) {\n            ans.push_back(i + 1);\n        }\n    }\n    cout << ans.size() << endl;\n    for (size_t i = 0; i < ans.size(); i++) {\n        cout << ans[i] << endl;\n    }\n    return 0;\n}\n</translated_code>\n<confidence>0.99</confidence>", "token_logprobs": [-1.311301275563892e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00016878610767889768, -2.038458114839159e-05, -2.50339189733495e-06, -0.0015037668636068702, -2.753696753643453e-05, 0.0