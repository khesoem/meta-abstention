{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdio>\n#include <utility>\n\nusing ll = long long;\nusing pii = std::pair<int, int>;\nusing vi = std::vector<int>;\nusing vvc = std::vector<std::vector<char>>;\n\nconst int MOD = 1000000007;\n\nint add(int x, int y) {\n    x += y;\n    if (x >= MOD) x -= MOD;\n    return x;\n}\n\nint subtract(int x, int y) {\n    x -= y;\n    if (x < 0) x += MOD;\n    return x;\n}\n\nint multiply(int x, int y) {\n    return static_cast<int>(1LL * x * y % MOD);\n}\n\nint mod_exp(int base, int exp) {\n    int result = 1;\n    while (exp) {\n        if (exp & 1) result = multiply(result, base);\n        base = multiply(base, base);\n        exp >>= 1;\n    }\n    return result;\n}\n\nint mod_inverse(int a) {\n    return mod_exp(a, MOD - 2);\n}\n\nint divide_mod(int a, int b) {\n    return multiply(a, mod_inverse(b));\n}\n\nint main() {\n#ifdef LOCAL\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    scanf(\"%d\", &n);\n\n    std::vector<std::vector<int>> grid(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &grid[i][j]);\n            grid[i][j] = divide_mod(grid[i][j], 100);\n        }\n\n    std::vector<std::pair<std::vector<char>, int>> states;\n    states.reserve(1024);\n    states.emplace_back(std::vector<char>{0}, 1);\n\n    for (int col = 0; col < n; ++col) {\n        std::vector<std::pair<std::vector<char>, int>> next_states;\n        next_states.reserve(4096);\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prob = 1;\n            for (int j = 0; j < n; ++j) {\n                if (mask & (1 << j))\n                    prob = multiply(prob, grid[j][col]);\n                else\n                    prob = multiply(prob, subtract(1, grid[j][col]));\n            }\n\n            for (const auto& [old_masks, coeff] : states) {\n                std::vector<char> new_masks;\n                new_masks.reserve(old_masks.size() * __builtin_popcount(mask));\n\n                for (char b : old_masks) {\n                    int remaining = mask ^ (b & mask);\n                    while (remaining) {\n                        int bit = remaining & -remaining;\n                        new_masks.push_back(b | bit);\n                        remaining ^= bit;\n                    }\n                }\n\n                if (new_masks.empty()) continue;\n\n                std::sort(new_masks.begin(), new_masks.end());\n                new_masks.erase(std::unique(new_masks.begin(), new_masks.end()), new_masks.end());\n                next_states.emplace_back(std::move(new_masks), multiply(coeff, prob));\n            }\n        }\n\n        std::sort(next_states.begin(), next_states.end(),\n            [](const auto& a, const auto& b) {\n                return a.first < b.first;\n            });\n\n        states.clear();\n        int idx = 0;\n        while (idx < (int)next_states.size()) {\n            int j = idx;\n            int sum_coeff = 0;\n            auto& base = next_states[idx].first;\n            while (j < (int)next_states.size() && next_states[j].first == base)\n                sum_coeff = add(sum_coeff, next_states[j++].second);\n            states.emplace_back(base, sum_coeff);\n            idx = j;\n        }\n    }\n\n    int result = 0;\n    for (const auto& [_, coeff] : states)\n        result = add(result, coeff);\n    printf(\"%d\\n\", result);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\n\ndef add(x, y):\n    x += y\n    if x >= MOD:\n        x -= MOD\n    return x\n\ndef subtract(x, y):\n    x -= y\n    if x < 0:\n        x += MOD\n    return x\n\ndef multiply(x, y):\n    return (x * y) % MOD\n\ndef mod_exp(base, exp):\n    result = 1\n    while exp:\n        if exp & 1:\n            result = multiply(result, base)\n        base = multiply(base, base)\n        exp >>= 1\n    return result\n\ndef mod_inverse(a):\n    return mod_exp(a, MOD - 2)\n\ndef divide_mod(a, b):\n    return multiply(a, mod_inverse(b))\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    \n    grid = []\n    for i in range(n):\n        row = []\n        for j in range(n):\n            val = int(next(it))\n            row.append(divide_mod(val, 100))\n        grid.append(row)\n    \n    # states: list of (tuple_of_chars, coefficient)\n    # Using tuple for immutability and hashability\n    states = [([0], 1)]\n    \n    for col in range(n):\n        next_states = []\n        \n        for mask in range(1 << n):\n            prob = 1\n            for j in range(n):\n                if mask & (1 << j):\n                    prob = multiply(prob, grid[j][col])\n                else:\n                    prob = multiply(prob, subtract(1, grid[j][col]))\n            \n            for old_masks_tuple, coeff in states:\n                # Convert old_masks from list to tuple for processing\n                old_masks = list(old_masks_tuple)\n                \n                new_masks = []\n                for b in old_masks:\n                    remaining = mask ^ (b & mask)\n                    while remaining:\n                        bit = remaining & -remaining\n                        new_masks.append(b | bit)\n                        remaining ^= bit\n                \n                if not new_masks:\n                    continue\n                \n                # Sort and deduplicate\n                new_masks.sort()\n                unique_masks = []\n                prev = None\n                for m in new_masks:\n                    if m != prev:\n                        unique_masks.append(m)\n                        prev = m\n                \n                new_coeff = multiply(coeff, prob)\n                next_states.append((tuple(unique_masks), new_coeff))\n        \n        # Group by mask tuple and sum coefficients\n        grouped = defaultdict(int)\n        for masks_tuple, coeff in next_states:\n            grouped[masks_tuple] = add(grouped[masks_tuple], coeff)\n        \n        states = [(masks, coeff) for masks, coeff in grouped.items()]\n    \n    result = 0\n    for _, coeff in states:\n        result = add(result, coeff)\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011526874004630372, -7.152555099310121e-07, -2.3841855067985307e-07, -0.0012382942950353026, -0.0003880701260641217, -0.020545169711112976, -0.16173692047595978, -0.02466316521167755, -7.152555099310121e-07, -8.082063141046092e-05, -0.07900993525981903, -0.00047755756531842053, 0.0, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, -0.0028109345585107803, 0.0, -2.3841855067985307e-07, 0.0, 