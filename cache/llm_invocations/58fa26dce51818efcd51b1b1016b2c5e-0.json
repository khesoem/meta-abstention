{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long lld;\nconst int MOD = 1000000007;\nconst int LIM = 30;\n\nstruct Matrix {\n    int a[31][31];\n    Matrix() {\n        memset(a, 0, sizeof(a));\n    }\n    Matrix times(const Matrix &o) const {\n        Matrix r;\n        for (int i = 0; i <= K; ++i) {\n            for (int j = 0; j <= K; ++j) {\n                for (int k = 0; k <= K; ++k) {\n                    r.a[i][j] = (r.a[i][j] + (lld)a[i][k] * o.a[k][j]) % MOD;\n                }\n            }\n        }\n        return r;\n    }\n};\n\nlld N;\nint K;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> N >> K;\n    vector<int> base;\n    while (N) {\n        base.push_back(N % K);\n        N /= K;\n    }\n\n    vector<array<Matrix, LIM>> A(max(1, (int)base.size()));\n    for (int i = 0; i < K; ++i) {\n        for (int j = 0; j <= K; ++j) {\n            A[0][i].a[j][j] = 1;\n            A[0][i].a[i][j] = 1;\n        }\n    }\n\n    vector<array<Matrix, LIM>> P(base.size()), S(base.size());\n    for (int i = 1; i < (int)base.size(); ++i) {\n        P[i - 1][0] = A[i - 1][0];\n        for (int j = 1; j < K; ++j)\n            P[i - 1][j] = P[i - 1][j - 1].times(A[i - 1][j]);\n\n        S[i - 1][K - 1] = A[i - 1][K - 1];\n        for (int j = K - 1; j--;)\n            S[i - 1][j] = A[i - 1][j].times(S[i - 1][j + 1]);\n\n        for (int j = 0; j < K; ++j) {\n            A[i][j] = S[i - 1][j];\n            if (j) A[i][j] = A[i][j].times(P[i - 1][j - 1]);\n        }\n    }\n\n    Matrix res;\n    for (int i = 0; i <= K; ++i) res.a[i][i] = 1;\n\n    int x = 0;\n    for (int i = (int)base.size(); i--;) {\n        for (int j = 0; j < base[i]; ++j) {\n            res = res.times(A[i][x]);\n            x = (x + 1) % K;\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= K; ++i)\n        ans = (ans + res.a[i][K]) % MOD;\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef mat_mul(A, B, K):\n    size = K + 1\n    C = [[0] * size for _ in range(size)]\n    for i in range(size):\n        for k in range(size):\n            aik = A[i][k]\n            if aik:\n                for j in range(size):\n                    C[i][j] = (C[i][j] + aik * B[k][j]) % MOD\n    return C\n\ndef identity(K):\n    size = K + 1\n    I = [[0] * size for _ in range(size)]\n    for i in range(size):\n        I[i][i] = 1\n    return I\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n\n    base = []\n    temp = N\n    while temp:\n        base.append(temp % K)\n        temp //= K\n\n    size = max(1, len(base))\n    # A[i][j] for i in range(size), j in range(K)\n    A = [[None] * K for _ in range(size)]\n\n    # Initialize A[0]\n    for i in range(K):\n        mat = [[0] * (K + 1) for _ in range(K + 1)]\n        for j in range(K + 1):\n            mat[j][j] = 1\n            mat[i][j] = 1\n        A[0][i] = mat\n\n    # Precompute P and S for each level\n    P = [[None] * K for _ in range(size)]\n    S = [[None] * K for _ in range(size)]\n\n    for i in range(1, size):\n        # P[i-1]\n        P[i-1][0] = A[i-1][0]\n        for j in range(1, K):\n            P[i-1][j] = mat_mul(P[i-1][j-1], A[i-1][j], K)\n\n        # S[i-1]\n        S[i-1][K-1] = A[i-1][K-1]\n        for j in range(K-2, -1, -1):\n            S[i-1][j] = mat_mul(A[i-1][j], S[i-1][j+1], K)\n\n        # A[i]\n        for j in range(K):\n            A[i][j] = S[i-1][j]\n            if j > 0:\n                A[i][j] = mat_mul(A[i][j], P[i-1][j-1], K)\n\n    res = identity(K)\n    x = 0\n    for i in range(len(base)-1, -1, -1):\n        for _ in range(base[i]):\n            res = mat_mul(res, A[i][x], K)\n            x = (x + 1) % K\n\n    ans = 0\n    for i in range(K + 1):\n        ans = (ans + res[i][K]) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.622600959512056e-06, 0.0, 0.0, -0.00024911639047786593, -0.00545252300798893, 0.0, -0.000558220490347594, -4.541770613286644e-05, -2.3841855067985307e-07, 0.0, -7.033323527139146e-06, 0.0, 0.0, 0.0, -0.2521401047706604, -4.291525328881107e-06, -0.0007216709782369435, -0.0003407612966839224, 0.0, -0.000125281119835563, -1.0728830375228426e-06, 0.0, -1.2993727978027891e-05, -5.6622808187967166e-05, -1.5020257706055418e-05, -1.1920928244535389e-07, -0.20790068805217743, -1.1920928244535389e-07, 0.0, -2.1457441107486375e-05, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -0.001589583931490779, 0.0, -1.1920928244535389e-07, 0.0, -0.0007098776986822486, 0.0, -8.344646857949556e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -5.960462772236497e-07, 0.0, -9.655486064730212e-05, -2.3841855067985307e-07, -1.7881377516459906e-06, 0.0, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -0.0637