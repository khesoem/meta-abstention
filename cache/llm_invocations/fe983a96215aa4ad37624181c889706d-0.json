c)\n        # forward edge\n        self.adj[a].append([b, self.sz[b], 0, c, p])\n        self.sz[b] += 1\n        # reverse edge\n        self.adj[b].append([a, self.sz[a], 0, 0, -p])\n        self.sz[a] += 1\n\n    def pot_init(self):\n        self.pot = [0] * self.n\n        # all edge costs >= 0, so no Bellman-Ford needed\n\n    def mcf(self, s, t, price, lb):\n        n = self.n\n        vis = [False] * n\n        dist = [INF] * n\n        dist[s] = 0\n        par = [0] * n\n        # sparse version: Dijkstra with priority queue\n        pq = [(0, s)]\n        while pq:\n            d, u = heapq.heappop(pq)\n            if vis[u]:\n                continue\n            vis[u] = True\n            for e in self.adj[u]:\n                v, rev, f, cap, p = e\n                if f <= cap - lb and dist[v] > dist[u] + self.pot[u] - self.pot[v] + p:\n                    dist[v] = dist[u] + self.pot[u] - self.pot[v] + p\n                    par[v] = rev\n                    heapq.heappush(pq, (dist[v], v))\n        if dist[t] >= INF:\n            return 0\n        df = INF\n        u = t\n        while u != s:\n            rev = par[u]\n            e_rev = self.adj[u][rev]\n            v = e_rev[0]\n            rev_rev = e_rev[1]\n            e = self.adj[v][rev_rev]\n            df = min(df, e[3] - e[2])  # capacity - flow\n            u = v\n        u = t\n        while u != s:\n            rev = par[u]\n            e_rev = self.adj[u][rev]\n            v = e_rev[0]\n            rev_rev = e_rev[1]\n            e = self.adj[v][rev_rev]\n            e[2] += df\n            e_rev[2] -= df\n            price += df * e[4]\n            u = v\n        for i in range(n):\n            self.pot[i] = min(INF, dist[i] + self.pot[i])\n        return df\n\n    def min_cost_flow(self, s, t, price, sparse=True):\n        self.pot_init()\n        flow = 0\n        price = 0\n        lb = 1 << 30\n        while lb > 0:\n            while True:\n                df = self.mcf(s, t, price, lb)\n                if df == 0:\n                    break\n                flow += df\n            lb //= 2\n        return flow\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    source = 0\n    sink = n * T + 1\n    flow = Flow(sink + 1)\n\n    for _ in range(k):\n        a = int(next(it))\n        flow.add_edge(source, a, 1, 0)\n\n    for t in range(T):\n        flow.add_edge(1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n\n    for _ in range(m):\n        a = int(next(it))\n        b = int(next(it))\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                flow.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    price = 0\n    flow_val = flow.min_cost_flow(source, sink, price, sparse=True)\n    # assert flow_val == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841574147809297e-05, 0.0, 0.0, -0.00045265440712682903, -0.0011857867939397693, -0.001945747178979218, -0.014199413359165192, -0.004088615067303181, -0.07906467467546463, -0.20146918296813965, -0.3237035870552063, -0.000902007392141968, -0.048591870814561844, -0.06529857963323593, -0.00010954733443213627, -0.0007204797584563494, -5.566918844124302e-05, -0.00033539868309162557, -0.11376434564590454, -0.41240832209587097, -0.18282979726791382, -0.0007414452848024666, 0.0, -3.576278118089249e-07, -0.015599139034748077, -0.006199889350682497, -0.01206081174314022, -4.768370445162873e-07, -1.1920922133867862e-06, -0.02332359552383423, -0.03900917246937752, -0.8177027106285095,