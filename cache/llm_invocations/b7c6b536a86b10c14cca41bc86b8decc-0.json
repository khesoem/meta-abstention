tion = 0;\n        if (choice == 0 && cnt_a > 0) {\n            for (int j = 0; j < n; ++j) {\n                contribution += C[cnt_a-1][n-1] * C[cnt_b][j] * C[N-pos][n-j];\n            }\n            dfs_b(pos-1, cnt_a-1, cnt_b, sum + contribution);\n        } else if (choice == 1 && cnt_b > 0) {\n            for (int j = 0; j < n; ++j) {\n                contribution -= C[cnt_b-1][n-1] * C[cnt_a][j] * C[N-pos][n-j];\n            }\n            dfs_b(pos-1, cnt_a, cnt_b-1, sum + contribution);\n        }\n    }\n}\n\nvoid bfs_a() {\n    for (int i = 0; i <= n+m; ++i) {\n        for (int j = 0; j <= n+m; ++j) {\n            memo_a[i][j].clear();\n        }\n    }\n    memo_a[0][0][0] = 1;\n    \n    for (int i = 0; i <= n+m; ++i) {\n        for (int j = 0; j <= n+m; ++j) {\n            for (auto &[cur_sum, cnt] : memo_a[i][j]) {\n                if (i + j == mid) {\n                    auto it = lower_bound(memo_b[i][j].begin(), memo_b[i][j].end(), make_pair(-cur_sum, -1));\n                    if (it != memo_b[i][j].end()) {\n                        update_min(abs(cur_sum + it->first), cnt * it->second);\n                    }\n                    if (it != memo_b[i][j].begin()) {\n                        --it;\n                        update_min(abs(cur_sum + it->first), cnt * it->second);\n                    }\n                } else {\n                    int idx = i + j;\n                    for (int choice = 0; choice < 2; ++choice) {\n                        if (fixed_constraints[idx] != -1 && choice != fixed_constraints[idx]) continue;\n                        int na = i, nb = j;\n                        if (choice == 0) ++na;\n                        else ++nb;\n                        if (na <= n+m && nb <= n+m) {\n                            i64 delta = 0;\n                            if (choice == 0) {\n                                for (int l = 0; l < n; ++l) {\n                                    delta += C[na-1][n-1] * C[nb][l] * C[N-idx-1][n-l];\