 long res = 0;\n        for (int i = 0; i < base; i++) {\n            long term = mul(fastPow(base - i, exp), nCr(base, i));\n            res = (i % 2 == 0) ? add(res, term) : sub(res, term);\n        }\n        return res;\n    }\n\n    private static void init() {\n        fact = new long[1_000_000];\n        invFact = new long[1_000_000];\n        fact[0] = invFact[0] = 1;\n        for (int i = 1; i < 1_000_000; i++) {\n            fact[i] = mul(fact[i - 1], i);\n        }\n        invFact[999999] = fastPow(fact[999999], MOD - 2);\n        for (int i = 999998; i >= 0; i--) {\n            invFact[i] = mul(invFact[i + 1], i + 1);\n        }\n    }\n\n    private static long nCr(int n, int r) {\n        return mul(fact[n], mul(invFact[r], invFact[n - r]));\n    }\n\n    private static long add(long a, long b) {\n        return (a + b) % MOD;\n    }\n\n    private static long sub(long a, long b) {\n        return ((a - b) % MOD + MOD) % MOD;\n    }\n\n    private static long mul(long a, long b) {\n        return (a * b) % MOD;\n    }\n\n    private static long fastPow(long base, long exp) {\n        if (exp == 0) return 1;\n        long half = fastPow(base, exp >> 1);\n        long sq = mul(half, half);\n        return (exp & 1) == 1 ? mul(sq, base) : sq;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\nfact = None\ninvFact = None\n\ndef add(a, b):\n    return (a + b) % MOD\n\ndef sub(a, b):\n    return ((a - b) % MOD + MOD) % MOD\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef fastPow(base, exp):\n    if exp == 0:\n        return 1\n    half = fastPow(base, exp >> 1)\n    sq = mul(half, half)\n    return mul(sq, base) if (exp & 1) == 1 else sq\n\ndef init():\n    global fact, invFact\n    fact = [0] * 1_000_000\n    invFact = [0] * 1_000_000\n    fact[0] = 1\n    invFact[0] = 1\n    for i in range(1, 1_000_000)