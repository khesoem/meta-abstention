 static void BFS1() {\n        for (int[] row : bum) Arrays.fill(row, t);\n        bum[br][bc] = 0;\n        Queue<int[]> q = new LinkedList<>();\n        q.add(new int[]{br, bc});\n        while (!q.isEmpty()) {\n            int[] v = q.poll();\n            int d = bum[v[0]][v[1]];\n            for (int i = 0; i < MAXD; i++) {\n                int nr = v[0] + dy[i];\n                int nc = v[1] + dx[i];\n                if (nr >= 0 && nr < n && nc >= 0 && nc < n && a[nr][nc] != 'Y' && d + 1 < bum[nr][nc]) {\n                    bum[nr][nc] = d + 1;\n                    q.add(new int[]{nr, nc});\n                }\n            }\n        }\n    }\n    \n    private static void BFS2(int sr, int sc) {\n        for (int[] row : dist) Arrays.fill(row, INF);\n        dist[sr][sc] = 0;\n        for (boolean[] row : pos) Arrays.fill(row, false);\n        pos[sr][sc] = true;\n        Queue<int[]> q = new LinkedList<>();\n        q.add(new int[]{sr, sc});\n        while (!q.isEmpty()) {\n            int[] v = q.poll();\n            int d = dist[v[0]][v[1]];\n            pos[v[0]][v[1]] = d <= bum[v[0]][v[1]];\n            if (d >= bum[v[0]][v[1]]) continue;\n            for (int i = 0; i < MAXD; i++) {\n                int nr = v[0] + dy[i];\n                int nc = v[1] + dx[i];\n                if (nr >= 0 && nr < n && nc >= 0 && nc < n && a[nr][nc] != 'Y' && d + 1 < dist[nr][nc]) {\n                    dist[nr][nc] = d + 1;\n                    q.add(new int[]{nr, nc});\n                }\n            }\n        }\n    }\n    \n    private static void BFS(int sr, int sc, int[][] distArr, int INFVAL) {\n        for (int[] row : distArr) Arrays.fill(row, INFVAL);\n        distArr[sr][sc] = 0;\n        Queue<int[]> q = new LinkedList<>();\n        q.add(new int[]{sr, sc});\n        while (!q.isEmpty()) {\n            int[] v = q.poll();\n            int d = distArr[v[0]][v[1]];\n            for (int i = 0; i < MAXD; i++) {\n                int nr = v[0] + dy[i];\n        