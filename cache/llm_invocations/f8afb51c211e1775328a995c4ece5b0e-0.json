     return;\n        }\n\n        for (int b = (int)n; b >= 1; --b) {\n            double a_val = (x * b) / y;\n            if (Math.abs(a_val - Math.floor(a_val)) < 1e-9) {\n                bestNum = (int)a_val;\n                bestDen = b;\n                break;\n            } else {\n                double[] result1 = new double[2];\n                double diff1 = computeDifference(x, y, Math.floor(a_val), b, result1);\n\n                if (diff1 < bestDiff || (Math.abs(diff1 - bestDiff) < 1e-9 && (int)Math.floor(a_val) < bestNum)) {\n                    bestNum = (int)Math.floor(a_val);\n                    bestDen = b;\n                    bestDiff = diff1;\n                }\n\n                double[] result2 = new double[2];\n                double diff2 = computeDifference(x, y, Math.ceil(a_val), b, result2);\n\n                if (diff2 < bestDiff || (Math.abs(diff2 - bestDiff) < 1e-9 && (int)Math.ceil(a_val) < bestNum)) {\n                    bestNum = (int)Math.ceil(a_val);\n                    bestDen = b;\n                    bestDiff = diff2;\n                }\n            }\n        }\n\n        int g = computeGCD(bestNum, bestDen);\n        if (g != 1) {\n            bestNum /= g;\n            bestDen /= g;\n        }\n\n        System.out.println(bestNum + \"/\" + bestDen);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.047575440490618e-05, -1.6689286894688848e-06, -4.768370445162873e-07, -0.006831740494817495, -1.2993727978027891e-05, -0.00031394799589179456, -0.39846542477607727, -2.7179348762729205e-05, -3.576278118089249e-07, -2.4199192921514623e-05, -0.00048828122089616954, -0.00026353701832704246, -0.09070572257041931, -1.7881377516459906e-06, -0.0059310393407940865, -5.364403477869928e-06, -2.3841855067985307e-07, -9.179073458653875e-06, -1.0728830375228426e-06, 0.0, 0.0, -4.768370445162873e-07, -2.8371408916427754e-05, -1.1920928244535389e-07, 0.0, -5.07818695041351e-05, -4.768370445162873e-07,