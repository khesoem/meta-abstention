    pc[i] = pc[i >> 1] + (i & 1)\n\n    # mark subsets of n\n    vis = [False] * (n + 1)\n    i = n\n    while True:\n        vis[i] = True\n        if i == 0:\n            break\n        i = (i - 1) & n\n\n    for i in range(1, n + 1):\n        if not vis[i]:\n            continue\n        submask = i\n        while submask:\n            j = submask\n            l = min(k, pc[i - j] + 1)\n            for s in range(1, l + 1):\n                if dp[s - 1][i - j]:\n                    dp[s][i] = (dp[s][i] + dp[s - 1][i - j] * inv[j]) % mod\n            submask = (submask - 1) & i\n\n    ans = 0\n    max_s = min(k, pc[n])\n    for s in range(max_s + 1):\n        if dp[s][n]:\n            tmp = dp[s][n] * fac[k] % mod\n            tmp = tmp * inv[k - s] % mod\n            tmp = tmp * inv[s] % mod\n            tmp = tmp * fac[n] % mod\n            ans = (ans + tmp) % mod\n\n    result = (pow(k, n, mod) - ans + mod) % mod\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.0010040724882856011, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0007706294418312609, -2.1314401626586914, -0.35613811016082764, -0.02325616218149662, -3.576214658096433e-05, -0.023353757336735725, -5.864924969500862e-05, -0.003768724389374256, -4.768370445162873e-07, -0.882165253162384, -1.9073468138230965e-06, -0.0009389282786287367, 0.0, -0.001210552523843944, -1.1205610462639015e-05, -0.1602349728345871, -6.198863957251888e-06, -2.3841855067985307e-07, -2.264974000354414e-06, -2.3841855067985307e-07, -1.4662635294371285e-05, -9.63164638960734e-05, 0.0, -0.005233753472566605, -8.344646857949556e-07, -1.311301275563892e-06, -5.960462772236497e-07, -1.1920928244535389e-07, -0.04864126443862915, -0.576500654220581, 0.0, -4.768370445162873e-07, 0.0, -1.4305104514278355e-06, -1.3133445978164673, -5.960462772236497e-07, -2.2649508537142538e-05, 0.0, -1.1920928244535389e-07, 0.0, -1.3470558769768104e-05, -1