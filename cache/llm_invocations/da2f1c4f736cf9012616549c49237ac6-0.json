rn t\n\nclass Matrix:\n    def __init__(self, N, M):\n        self.N = N\n        self.M = M\n        self.dat = [[0] * M for _ in range(N)]\n\n    def init(self):\n        for i in range(self.N):\n            for j in range(self.M):\n                self.dat[i][j] = 0\n\n    def iden(self):\n        self.init()\n        min_dim = min(self.N, self.M)\n        for i in range(min_dim):\n            self.dat[i][i] = 1\n\n    def trans(self):\n        out = Matrix(self.M, self.N)\n        for i in range(self.M):\n            for j in range(self.N):\n                out.dat[i][j] = self.dat[j][i]\n        return out\n\n    def __getitem__(self, x):\n        return self.dat[x]\n\n    def __setitem__(self, x, value):\n        self.dat[x] = value\n\n    def __add__(self, a):\n        out = Matrix(self.N, self.M)\n        for i in range(self.N):\n            for j in range(self.M):\n                out.dat[i][j] = add(self.dat[i][j], a.dat[i][j])\n        return out\n\n    def __mul__(self, x):\n        out = Matrix(self.N, self.M)\n        for i in range(self.N):\n            for j in range(self.M):\n                out.dat[i][j] = mult(self.dat[i][j], x)\n        return out\n\ndef mat_mult(a, b):\n    N = a.N\n    M = b.M\n    K_dim = a.M\n    out = Matrix(N, M)\n    out.init()\n    for i in range(N):\n        for j in range(K_dim):\n            if a.dat[i][j]:\n                for k in range(M):\n                    out.dat[i][k] = add(out.dat[i][k], mult(a.dat[i][j], b.dat[j][k]))\n    return out\n\nA = [[[Matrix(35, 35) for _ in range(35)] for _ in range(65)] for _ in range(65)]\nS = [[[Matrix(35, 35) for _ in range(35)] for _ in range(65)] for _ in range(65)]\nP = [[[Matrix(35, 35) for _ in range(35)] for _ in range(65)] for _ in range(65)]\nfor i in range(65):\n    for j in range(35):\n        for k in range(35):\n            A[i][j][k] = Matrix(35, 35)\nfor _ in range(K):\n    for i in range(35):\n        A[0][i][i].iden()\n        for j in range(K + 1):\n           