                   for (int num2 = 1; num2 <= digit2; num2++) {\n                                int u = 10 * (j + i * 10) + num1;\n                                int v = 10 * (y + 10 * x) + num2;\n                                if (gr[u] == null) gr[u] = new ArrayList<>();\n                                gr[u].add(v);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n        sc.close();\n    }\n\n    static boolean kuhn(int v) {\n        if (used[v]) return false;\n        used[v] = true;\n        for (int to : gr[v]) {\n            if (pa[to] == 0 || kuhn(pa[to])) {\n                pa[to] = v;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    static void solve() {\n        for (int i = 0; i < MAX_N; i++) {\n            gr[i] = new ArrayList<>();\n        }\n        scan();\n        for (int i = 0; i < MAX_N; i++) {\n            kuhn(i);\n            Arrays.fill(used, false);\n        }\n        int res = 0;\n        for (int i = 0; i < MAX_N; i++) {\n            if (pa[i] != 0) res++;\n        }\n        System.out.println(res);\n    }\n\n    public static void main(String[] args) {\n        solve();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.8412379075889476e-06, 0.0, 0.0, -5.340433563105762e-05, -0.0007285801111720502, 0.0, -3.540453326422721e-05, -0.007108989637345076, -0.0001006075763143599, 0.0, -1.9073468138230965e-06, -0.003179259365424514, -1.156323378381785e-05, -0.0006213641609065235, -0.010235556401312351, -0.10020766407251358, -0.03857995197176933, -0.25225070118904114, -0.004079235717654228, 0.0, -0.00016044282529037446, -1.680836794548668e-05, -7.867782187531702e-06, 0.0, -1.1920928244535389e-07, -1.5497195136049413e-06, -8.583032467868179e-06, 0.0, -0.001929566147737205, 0.0, -2.9802276912960224e-06, -3.540453326422721e-05, 0.0, -0.00011145447206217796, -0.0011701886542141438, 0.0, 