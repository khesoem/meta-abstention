pdate(base - 1, i);\n        update(base, i);\n        update(base + 1, i);\n    }\n    \n    cout << best_num << \"/\" << best_den;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static long x, y, n;\n    static long best_num = -1;\n    static long best_den = -1;\n    static final long INF = 1000000007;\n\n    static void update(long numerator, int denominator) {\n        if (numerator < 0) return;\n        \n        if (best_num == -1) {\n            best_num = numerator;\n            best_den = denominator;\n            return;\n        }\n        \n        long current_diff = Math.abs(denominator * x - numerator * y) * best_den;\n        long best_diff = Math.abs(best_den * x - best_num * y) * denominator;\n        \n        if (current_diff < best_diff) {\n            best_num = numerator;\n            best_den = denominator;\n        } else if (current_diff == best_diff) {\n            if (denominator < best_den || (denominator == best_den && numerator < best_num)) {\n                best_num = numerator;\n                best_den = denominator;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        x = scanner.nextLong();\n        y = scanner.nextLong();\n        n = scanner.nextLong();\n        \n        for (int i = 1; i <= n; ++i) {\n            long base = (long)i * x / y;\n            \n            update(base - 1, i);\n            update(base, i);\n            update(base + 1, i);\n        }\n        \n        System.out.println(best_num + \"/\" + best_den);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012468514614738524, -2.50339189733495e-06, -4.768370445162873e-07, -5.757642793469131e-05, -8.4638240878121e-06, -0.04880919307470322, -0.0