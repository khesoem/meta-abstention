eturn true;\n            grow(2);\n            if (reach[tx][ty] == 2) return false;\n        }\n        return false;\n    }\n\n    static int augment(int u, int sink, int bneck) {\n        if (u == sink) return bneck;\n        if (seen[u] == stamp) return 0;\n        seen[u] = stamp;\n        for (int v = 0; v <= sink; v++) {\n            if (flowcap[u][v] > 0) {\n                int ret = augment(v, sink, Math.min(bneck, flowcap[u][v]));\n                if (ret != 0) {\n                    flowcap[u][v] -= ret;\n                    flowcap[v][u] += ret;\n                    return ret;\n                }\n            }\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        T = sc.nextInt();\n        sc.nextLine(); // consume newline\n\n        // Initialize shortest with large value (0x01010101 in C++ = 16843009)\n        for (int i = 1; i <= 14; i++)\n            for (int j = 1; j <= 14; j++)\n                for (int k = 1; k <= 14; k++)\n                    for (int l = 1; l <= 14; l++)\n                        shortest[i][j][k][l] = 16843009;\n\n        for (int i = 1; i <= n; i++) {\n            String line = sc.next();\n            for (int j = 1; j <= n; j++) {\n                lab[i][j] = line.charAt(j - 1);\n                shortest[i][j][i][j] = 0;\n                if (lab[i][j] == 'Z') {\n                    infx = i;\n                    infy = j;\n                }\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            String line = sc.next();\n            for (int j = 1; j <= n; j++) {\n                req[i][j] = line.charAt(j - 1);\n            }\n        }\n\n        // Initialize edges for shortest paths\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                for (int d = 0; d < 4; d++) {\n                    int ni = i + dirx[d], nj = j + diry[d];\n                    if (ni > 0 && ni <= n && nj > 0 && nj <= n && lab[i][j] != 'Y' && lab[ni][nj] != 'Y')\n                        shortest[i][j][ni][nj] = 1;\n                }\n            }\n        }\n\n        // Floyd-Warshall\n        for (int kx = 1; kx <= n; kx++) {\n            for (int ky = 1; ky <= n; ky++) {\n                for (int tx = 1; tx <= n; tx++) {\n                    for (int ty = 1; ty <= n; ty++) {\n                        for (int sx = 1; sx <= n; sx++) {\n                            for (int sy = 1; sy <= n; sy++) {\n                                shortest[sx][sy][tx][ty] = Math.min(shortest[sx][sy][tx][ty],\n                                        shortest[sx][sy][kx][ky] + shortest[kx][ky][tx][ty]);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        int src = n * n * 2 + 1;\n        int sink = n * n * 2 + 2;\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= n; j++) {\n                if (Character.isDigit(lab[i][j]))\n                    flowcap[src][node_id(i, j)] = lab[i][j] - '0';\n                if (Character.isDigit(req[i][j]))\n                    flowcap[n * n + node_id(i, j)][sink] = req[i][j] - '0';\n                if (Character.isDigit(lab[i][j])) {\n                    for (int a = 1; a <= n; a++) {\n                        for (int b = 1; b <= n; b++) {\n                            if (lab[i][j] > '0' && req[a][b] > '0' && Character.isDigit(req[a][b]) &&\n                                shortest[i][j][a][b] <= T && can(i, j, a, b, infx, infy))\n                                flowcap[node_id(i, j)][n * n + node_id(a, b)] = 1000;\n                        }\n                    }\n                }\n            }\n        }\n\n        int ans = 0, ret;\n        while ((ret = augment(src, sink, 1000)) != 0) {\n            ans += ret;\n            stamp++;\n        }\n        System.out.println(ans);\n        sc.close();\n    }\n}\