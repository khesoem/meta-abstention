      int lo = from, hi = to;\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            if (arr[mid] < key) lo = mid + 1;\n            else hi = mid;\n        }\n        return lo;\n    }\n\n    static void solve(int x, long v) {\n        if (v > n) return;\n        if (check(v)) {\n            for (int i = 0; i <= 6; ++i) {\n                int t = mod(tot2 + 1 - v * pow10[i], P1);\n                int begin = offset[i];\n                int end = begin + size[i];\n                int loc = lowerBound(vec_data, begin, end, P1 - t);\n                ans = mod(ans + s[i] + (long)t * size[i] - (long)P1 * (size[i] - loc), P2);\n            }\n            tot2 += tot1;\n        } else {\n            tot2++;\n            ans = mod(ans + mod(tot2 - v, P1), P2);\n            for (int i = (x == 0 ? 0 : 1); i < 10; ++i) solve(x + 1, v * 10 + i);\n        }\n    }\n\n    public static void main(String[] args) {\n        offset[0] = 0;\n        for (int i = 1; i < 7; ++i) offset[i] = offset[i-1] + size[i-1];\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextLong();\n        init(0, 0);\n        for (int i = 0; i <= 6; ++i) Arrays.sort(vec_data, offset[i], offset[i] + size[i]);\n        tot2 = -1;\n        solve(0, 0);\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, -0.00010954733443213627, -9.536697689327411e-06, 0.0, -1.3589766240329482e-05, -0.8138099908828735, -0.004092651419341564, -6.198863957251888e-06, -5.960462772236497e-07, -5.960462772236497e-07, -1.311301275563892e-06, -1.9550132492440753e-05, -6.318072337307967e-06, -1.1920928244535389e-07, -2.1815061700181104e-05, -0.003180091269314289, -2.884823152271565e-05, -0.06228700652718544, -2.992108420585282e-05, -0.00015841660206206143, -1.5497195136049413e-06, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -9.536738616588991e-07, 0.0, 0.0, 0.0, -1.7881377516459906e-06, 0.0, 0.0, -1.1920928244535389e-0