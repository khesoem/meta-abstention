[pr].back\n            g[v][back_idx].f -= addflow\n            cost += g[pv][pr].c * addflow\n            v = pv\n        flow += addflow\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.004146068822592497, -0.0004094619944225997, -4.320199877838604e-07, -1.1398757123970427e-05, -0.023241400718688965, -7.107425062713446e-06, -0.1002415120601654, -0.5847377777099609, -0.00427296943962574, 0.0, -4.723352049040841e-06, -0.002373035065829754, -6.20603168499656e-05, -5.5577775128767826e-06, -4.36574100604048e-06, -0.4287133812904358, -0.25192928314208984, -1.0280383548888494e-06, 0.0, -0.001586389378644526, -7.898723561083898e-05, -0.005514415446668863, -3.054500666621607e-06, -1.3856492842023727e-06, -2.8444881536415778e-05, -1.5048530030981055e-06, 0.0, 0.0, 0.0, -1.4140441635390744e-05, -1.2471589798224159e-05, -0.00010092071170220152, -1.5048530030981055e-06, -2.935296834039036e-06, -1.9361264946837764e-07, -0.03805755823850632, -7.896309739408025e-07, -0.00047690561041235924, -1.0921942703134846e-05, -5.6100132496794686e-05, -1.9361264946837764e-07, -9.13388703338569e-06, -4.320199877838604e-07, -3.054500666621607e-06, -1.8624639324116288e-06, -0.09076151996850967, -3.128163257315464e-07, 0.0, -1.9361264946837764e-07, -2.45848218582978e-06, 0.0, -6.158350151963532e-05, -4.320199877838604e-07, 0.0, -6.988221684878226e-06, -1.981667537620524e-06, -1.9361264946837764e-07, -7.896309739408025e-07, -3.128163257315464e-07, 0.0, -1.9361264946837764e-07, -2.5776860184123507e-06, -4.320199877838604e-07, -5.080963092041202e-06, -3.128163257315464e-07, -1.5048530030981055e-06, -5.200166469876422e-06, -4.008129963040119e-06, -4.320199877838604e-07, -0.0010214977664873004, -1.0280383548888494e-06, -4.320199877838604e-07, 0.0, -0.00010306637705070898, -0.0003407071635592729, -1.1472419600977446e-06, -1.9361264946837764e-07, -2.1008713702030946e-06, 0.0, -0.0005155019462108612, -6.704273118