   return 0 <= r < rows and 0 <= c < cols\n    \n    def cellId(r, c):\n        return 1 + cols * r + c\n    \n    for x in range(rows):\n        for y in range(cols):\n            if scientists[x][y].isdigit() and '1' <= scientists[x][y] <= '9':\n                connect(source, cellId(x, y), int(scientists[x][y]))\n            if reactors[x][y].isdigit() and '1' <= reactors[x][y] <= '9':\n                connect(rows * rows + cellId(x, y), sink, int(reactors[x][y]))\n            for X in range(rows):\n                for Y in range(cols):\n                    if scientists[x][y] in ['Y', 'Z'] or reactors[X][Y] in ['Y', 'Z']:\n                        continue\n                    visitedCells = [[0] * cols for _ in range(rows)]\n                    bq = deque()\n                    bq.append((x, y, 1))\n                    visitedCells[x][y] = 1\n                    found = False\n                    while bq:\n                        cx, cy, t = bq.popleft()\n                        if cx == X and cy == Y:\n                            visitedCells[cx][cy] = 1\n                            found = True\n                            break\n                        if t >= disableTime[cx][cy] or t >= T:\n                            continue\n                        for di, dj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                            nx, ny = cx + di, cy + dj\n                            if inside(nx, ny) and not visitedCells[nx][ny] and \\\n                               scientists[nx][ny] not in ['Y', 'Z'] and t + 1 <= disableTime[nx][ny]:\n                                visitedCells[nx][ny] = 1\n                                bq.append((nx, ny, t + 1))\n                    if found:\n                        connect(cellId(x, y), rows * rows + cellId(X, Y), INF)\n    \n    # Dinic's algorithm implementation\n    level = [-1] * (cols * cols * 2 + 2)\n    ptr = [0] * (cols * cols * 2 + 2)\n    \n    def build_level_graph():\n        for i in range(len(level)):\n            level[i] = -1\n        level[source] = 0\n        q = deque()\n        q.append(source)\n        while q:\n            u = q.popleft()\n            for id in adj[u]:\n                e = edgeList[id]\n                if level[e.v] == -1 and e.f < e.c:\n                    level[e.v] = level[u] + 1\n                    q.append(e.v)\n                    if e.v == sink:\n                        return True\n        return False\n    \n    def push_flow(u, flow):\n        if u == sink or flow == 0:\n            return flow\n        for i in range(ptr[u], len(adj[u])):\n            ptr[u] = i\n            id = adj[u][i]\n            e = edgeList[id]\n            if level[e.v] != level[u] + 1:\n                continue\n            pushed = push_flow(e.v, min(flow, e.c - e.f))\n            if pushed:\n                e.f += pushed\n                edgeList[id ^ 1].f -= pushed\n                return pushed\n        return 0\n    \n    total = 0\n    while build_level_graph():\n        for i in range(len(ptr)):\n            ptr[i] = 0\n        pushed = push_flow(source, INF)\n        while pushed > 0:\n            total += pushed\n            pushed = push_flow(source, INF)\n    \n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010823617776622996, -1.5497195136049413e-06, -3.576278118089249e-07, -0.2820172607898712, -0.0011087467428296804, -1.1920928244535389e-07, -7.688703772146255e-05, -0.00021646064124070108, -1.7881377516459906e-06, -0.0002658013836480677, -0.01641823910176754, -0.022748811170458794, 0.0, -8.4638240878121e-06, 0.0, -1.7881377516459906e-06, -0.0011713793501257896, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -2.50339189733495e-06, -5.602820692729438e-06, -3.58813522325363e-05, -0.0017287085065618157, -1.4662635294371285e-05, -4.768360213347478e-06, -1.1920928244535389e-07, -0.142675608396