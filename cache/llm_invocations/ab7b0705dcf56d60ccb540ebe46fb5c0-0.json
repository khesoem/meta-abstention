{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <tuple>\n#include <climits>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = 1000000009;\n\nstruct Edge {\n    int u, v, f, c;\n    Edge(int u, int v, int f, int c) : u(u), v(v), f(f), c(c) {}\n};\n\nint source, sink;\nvector<vector<int>> adj;\nvector<Edge> edgeList;\n\nvoid connect(int u, int v, int cap) {\n    adj[u].push_back(edgeList.size());\n    edgeList.emplace_back(u, v, 0, cap);\n    adj[v].push_back(edgeList.size());\n    edgeList.emplace_back(v, u, 0, 0);\n}\n\nint ptr[1001], level[1001];\n\nbool buildLevelGraph() {\n    memset(level, -1, sizeof(level));\n    level[source] = 0;\n    queue<int> q;\n    q.push(source);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (int id : adj[u]) {\n            auto& e = edgeList[id];\n            if (level[e.v] == -1 && e.f < e.c) {\n                level[e.v] = level[u] + 1;\n                q.push(e.v);\n                if (e.v == sink) return true;\n            }\n        }\n    }\n    return false;\n}\n\nll pushFlow(int u, ll flow) {\n    if (u == sink || flow == 0) return flow;\n    for (int& i = ptr[u]; i < (int)adj[u].size(); ++i) {\n        int id = adj[u][i];\n        auto& e = edgeList[id];\n        if (level[e.v] != level[u] + 1) continue;\n        ll pushed = pushFlow(e.v, min(flow, (ll)e.c - e.f));\n        if (pushed) {\n            e.f += pushed;\n            edgeList[id ^ 1].f -= pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nll computeMaxFlow() {\n    ll total = 0;\n    while (buildLevelGraph()) {\n        memset(ptr, 0, sizeof(ptr));\n        ll pushed;\n        while ((pushed = pushFlow(source, INF)) > 0)\n            total += pushed;\n    }\n    return total;\n}\n\nstring scientists[101], reactors[101];\nbool pathExists[10][10][10][10];\nint visitedCells[101][101];\nint disableTime[10][10];\nint rows, cols;\n\nbool inside(int r, int c) {\n    return r >= 0 && c >= 0 && r < rows && c < cols;\n}\n\nint cellId(int r, int c) {\n    return 1 + cols * r + c;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int T;\n    cin >> rows >> T;\n    ++T;\n    cols = rows;\n    sink = cols * cols * 2 + 1;\n    source = 0;\n    adj.resize(cols * cols * 2 + 2);\n    queue<pair<int, int>> q;\n    for (int i = 0; i < rows; ++i) cin >> scientists[i];\n    for (int i = 0; i < rows; ++i) {\n        cin >> reactors[i];\n        for (int j = 0; j < cols; ++j) {\n            disableTime[i][j] = INF;\n            if (reactors[i][j] == 'Z') {\n                q.push({i, j});\n                disableTime[i][j] = 1;\n            }\n        }\n    }\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        for (int di = -1; di <= 1; ++di)\n            for (int dj = -1; dj <= 1; ++dj)\n                if (abs(di) + abs(dj) == 1) {\n                    int nx = x + di, ny = y + dj;\n                    if (inside(nx, ny) && disableTime[nx][ny] == INF && scientists[nx][ny] != 'Y') {\n                        disableTime[nx][ny] = disableTime[x][y] + 1;\n                        q.push({nx, ny});\n                    }\n                }\n    }\n    for (int x = 0; x < rows; ++x)\n        for (int y = 0; y < cols; ++y) {\n            if (scientists[x][y] >= '1' && scientists[x][y] <= '9')\n                connect(source, cellId(x, y), scientists[x][y] - '0');\n            if (reactors[x][y] >= '1' && reactors[x][y] <= '9')\n                connect(rows * rows + cellId(x, y), sink, reactors[x][y] - '0');\n            for (int X = 0; X < rows; ++X)\n                for (int Y = 0; Y < cols; ++Y) {\n                    if (scientists[x][y] == 'Y' || scientists[x][y] == 'Z' ||\n                        reactors[X][Y] == 'Y' || reactors[X][Y] == 'Z')\n                        continue;\n                    memset(visitedCells, 0, sizeof(visitedCells));\n                    queue<tuple<int, int, int>> bq;\n                    bq.emplace(x, y, 1);\n                    visitedCells[x][y] = 1;\n                    while (!bq.empty()) {\n                        auto [cx, cy, t] = bq.front(); bq.pop();\n                        if (cx == X && cy == Y) {\n                            visitedCells[cx][cy] = 1;\n                            break;\n                        }\n                        if (t >= disableTime[cx][cy] || t >= T) continue;\n                        for (int di = -1; di <= 1; ++di)\n                            for (int dj = -1; dj <= 1; ++dj)\n                                if (abs(di) + abs(dj) == 1) {\n                                    int nx = cx + di, ny = cy + dj;\n                                    if (inside(nx, ny) && !visitedCells[nx][ny] &&\n                                        scientists[nx][ny] != 'Y' && scientists[nx][ny] != 'Z' &&\n                                        t + 1 <= disableTime[nx][ny]) {\n                                        visitedCells[nx][ny] = 1;\n                                        bq.emplace(nx, ny, t + 1);\n                                    }\n   