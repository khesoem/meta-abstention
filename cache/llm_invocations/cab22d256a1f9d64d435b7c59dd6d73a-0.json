 57:  # '0' to '9'\n            ret = ret * 10 + (c - 48)\n            c = self.read()\n        if neg:\n            ret = -ret\n        return ret\n\n    def next_long(self):\n        return self.next_int()  # Python handles arbitrary precision integers\n\n    def next_double(self):\n        ret = 0.0\n        div = 1.0\n        c = self.read()\n        while c != -1 and c <= 32:\n            c = self.read()\n        if c == -1:\n            return 0.0\n        neg = (c == ord('-'))\n        if neg:\n            c = self.read()\n        while c != -1 and 48 <= c <= 57:\n            ret = ret * 10 + (c - 48)\n            c = self.read()\n        if c == ord('.'):\n            c = self.read()\n            while c != -1 and 48 <= c <= 57:\n                ret += (c - 48) / (div * 10)\n                div *= 10\n                c = self.read()\n        if neg:\n            ret = -ret\n        return ret\n\n    def fill_buffer(self):\n        self.buffer_pointer = 0\n        chunk = self.din.read(self.BUFFER_SIZE)\n        self.bytes_read = len(chunk)\n        if self.bytes_read == 0:\n            self.buffer[0] = -1\n        else:\n            self.buffer[:self.bytes_read] = chunk\n\n    def read(self):\n        if self.buffer_pointer >= self.bytes_read:\n            self.fill_buffer()\n        if self.buffer_pointer >= self.bytes_read:\n            return -1  # End of stream\n        b = self.buffer[self.buffer_pointer]\n        self.buffer_pointer += 1\n        return b\n\n    def close(self):\n        if self.din is not None and self.din is not sys.stdin.buffer:\n            self.din.close()\n\ndef get(w, m):\n    if m == 0:\n        return True\n    if m % w != 0:\n        return False\n    m = m // w\n    if m == 1:\n        return True\n    return get(w, m) or get(w, m - 1) or get(w, m + 1)\n\ndef main():\n    reader = Reader()\n    w = reader.next_int()\n    m = reader.next_int()\n    ans = get(w, m) or get(w, m - 1) or get(w, m + 1)\n    if ans:\n        print(