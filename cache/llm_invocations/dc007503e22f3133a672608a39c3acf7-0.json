shed\n        return 0\n\n    def max_flow(self, S, T):\n        total = 0\n        while self.bfs(S, T):\n            self.pt = [0]*self.N\n            while True:\n                flow = self.dfs(S, T)\n                if not flow:\n                    break\n                total += flow\n        return total\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    g1 = [list(next(it).strip()) for _ in range(n)]\n    g2 = [list(next(it).strip()) for _ in range(n)]\n\n    # dist BFS from 'Z'\n    dist = [[-1]*n for _ in range(n)]\n    q = []\n    for i in range(n):\n        for j in range(n):\n            if g1[i][j] == 'Z':\n                q.append((i,j))\n                dist[i][j] = 0\n    qpos = 0\n    while qpos < len(q):\n        uy, ux = q[qpos]; qpos += 1\n        for dy, dx in dirs:\n            vy = uy + dy\n            vx = ux + dx\n            if 0 <= vy < n and 0 <= vx < n and g1[vy][vx] != 'Y' and dist[vy][vx] == -1:\n                dist[vy][vx] = dist[uy][ux] + 1\n                q.append((vy, vx))\n\n    for i in range(n):\n        for j in range(n):\n            if dist[i][j] == -1 or dist[i][j] > t:\n                dist[i][j] = INF\n\n    # node ids\n    id_counter = 1\n    node_id = [[[0]*n for _ in range(n)] for __ in range(t+2)]  # time 0..t+1\n    for time in range(t+2):\n        for i in range(n):\n            for j in range(n):\n                node_id[time][i][j] = id_counter\n                id_counter += 1\n    source = 0\n    sink = id_counter\n    id_counter += 1\n\n    dinic = Dinic(id_counter)\n\n    # source edges\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g1[i][j] <= '9':\n                dinic.add_edge(source, node_id[0][i][j], ord(g1[i][j]) - ord('0'))\n\n    # time edges\n    for i in range(n):\n        for j in range(n):\n            if g1[i][j] in ('Y','Z'):\n                continue\n        