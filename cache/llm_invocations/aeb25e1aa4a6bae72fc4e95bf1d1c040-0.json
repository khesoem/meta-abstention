ruct L l91[M * 2], *l = l91;\n    l->j = j;\n    l->next = aa[i].next; aa[i].next = l++;\n}\n\nstatic void add_(int i, int h) {\n    static struct L l91[M_ * 2], *l = l91;\n    l->j = h;\n    l->next = aa_[i].next; aa_[i].next = l++;\n}\n\nstatic int n_, m_;\nstatic int uu[M_], vv[M_], uv[M_], cost[M_], cost_[M_];\nstatic int cc[M_ * 2];\n\nstatic void link(int u, int v, int cap, int cos) {\n    int h = m_++;\n    uu[h] = u, vv[h] = v, uv[h] = u ^ v;\n    cost[h] = cos;\n    cc[h << 1 ^ 0] = cap;\n    add_(u, h << 1 ^ 0);\n    add_(v, h << 1 ^ 1);\n}\n\nstatic void dijkstra(int s) {\n    memset(pi, 0x3f, n_ * sizeof *pi);\n    pi[s] = 0;\n    pq_add(s);\n    while (cnt) {\n        struct L *l;\n        int u = pq_remove_first(), v;\n        int h, h_, p, k = kk[u] + 1;\n        for (l = aa_[u].next; l; l = l->next)\n            if (cc[h_ = l->j]) {\n                h = h_ >> 1;\n                p = pi[u] + ((h_ & 1) == 0 ? cost_[h] : -cost_[h]);\n                v = u ^ uv[h];\n                if (pi[v] == INF) {\n                    pi[v] = p;\n                    kk[v] = k;\n                    bb[v] = h_;\n                    pq_add(v);\n                } else if (pi[v] > p || (pi[v] == p && kk[v] > k)) {\n                    pi[v] = p;\n                    kk[v] = k;\n                    bb[v] = h_;\n                    pq_up(v);\n                }\n            }\n    }\n}\n\nstatic void push(int s, int t) {\n    int u, h, h_, c = INF;\n    for (u = t; u != s; u ^= uv[h]) {\n        h = (h_ = bb[u]) >> 1;\n        if (c > cc[h_]) c = cc[h_];\n    }\n    for (u = t; u != s; u ^= uv[h]) {\n        h = (h_ = bb[u]) >> 1;\n        cc[h_] -= c; cc[h_ ^ 1] += c;\n    }\n}\n\nstatic int edmonds_karp(int s, int t) {\n    int c, h;\n    memcpy(cost_, cost, m_ * sizeof *cost);\n    while (1) {\n        dijkstra(s);\n        if (pi[t] == INF) break;\n        push(s, t);\n        for (h = 0; h < m_; h++) {\n            int u = uu[h], v = vv[h];\n            if (pi[u] != INF