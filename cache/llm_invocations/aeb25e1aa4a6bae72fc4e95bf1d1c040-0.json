_)]\n\n    # edge data\n    uu = []\n    vv = []\n    uv = []\n    cost = []\n    cost_ = []\n    cc = []  # capacities for each arc (2 per edge)\n\n    def link(u, v, cap, cos):\n        h = len(uu)\n        uu.append(u)\n        vv.append(v)\n        uv.append(u ^ v)\n        cost.append(cos)\n        cost_.append(cos)\n        cc.append(cap)   # forward arc capacity\n        cc.append(0)     # reverse arc capacity\n        aa_[u].append(2 * h)      # forward arc index\n        aa_[v].append(2 * h + 1)  # reverse arc index\n\n    # build time-expanded graph\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            # edges to neighbors at next time\n            for j in aa[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    link(u, v, 1, c + (2 * x - 1) * d)\n            # self-loop edge\n            v = u + 1\n            link(u, v, k, 0 if i == 0 else c)\n\n    # source to start positions at time 0\n    src = n_ - 1\n    for h in range(k):\n        link(src, ii[h] * t + 0, 1, 0)\n\n    sink = 0 * t + t - 1\n\n    # min-cost max-flow with potentials\n    def dijkstra(s):\n        pi = [INF] * n_\n        kk = [0] * n_\n        bb = [-1] * n_\n        pi[s] = 0\n        kk[s] = 0\n        heap = [(0, 0, s)]\n        while heap:\n            d, steps, u = heapq.heappop(heap)\n            if d != pi[u] or steps != kk[u]:\n                continue\n            for h_ in aa_[u]:\n                if cc[h_] == 0:\n                    continue\n                h = h_ >> 1\n                # cost of this arc: forward (even) -> cost_[h], reverse (odd) -> -cost_[h]\n                w = cost_[h] if (h_ & 1) == 0 else -cost_[h]\n                v = u ^ uv[h]\n                nd = pi[u] + w\n                nsteps = kk[u] + 1\n                if nd < pi[v] or (nd == pi[v] and nsteps < kk[v]):\n                    pi[v] = nd\n                    kk[v] = nsteps\n                    bb[v] = h_