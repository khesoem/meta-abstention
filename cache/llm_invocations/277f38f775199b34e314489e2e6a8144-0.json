 = pq.top(); pq.pop();\n            if (d > dist[u]) continue;\n            for (int i = 0; i < adj[u].size(); ++i) {\n                auto &e = adj[u][i];\n                if (e.capacity > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    pq.push({dist[e.to], e.to});\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n    \n    int getMinCost(int s, int t) {\n        int totalFlow = 0, totalCost = 0;\n        while (dijkstra(s, t)) {\n            int flow = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                flow = min(flow, adj[prevv[v]][preve[v]].capacity);\n            }\n            totalFlow += flow;\n            totalCost += dist[t] * flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                auto &e = adj[prevv[v]][preve[v]];\n                e.capacity -= flow;\n                adj[v][e.index].capacity += flow;\n            }\n        }\n        return totalCost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int s = 0, t = n*100 + 1;\n    MinCostFlow mcf(t + 1);\n    \n    // Level 100 to sink\n    for (int i = 1; i <= 100; ++i) {\n        mcf.addEdge(i, t, 100, 0);\n    }\n    \n    // Source to starting positions\n    for (int i = 0; i < k; ++i) {\n        int v;\n        cin >> v;\n        mcf.addEdge(s, (v-1)*100+1, 1, 0);\n    }\n    \n    // Intra-node edges (level j to j+1)\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            mcf.addEdge((i-1)*100+j, (i-1)*100+j+1, 100, c);\n        }\n    }\n    \n    // Inter-node edges\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        \n        for (int j = 1; j < 100; ++j) {\n            int from = (u-1)*100+j;\n           