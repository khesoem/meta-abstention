.offer(new int[]{0, s});\n\n            while (!pq.isEmpty()) {\n                int[] cur = pq.poll();\n                int d = cur[0], u = cur[1];\n                if (d > dist[u]) continue;\n                for (int i = 0; i < adj.get(u).size(); ++i) {\n                    Edge e = adj.get(u).get(i);\n                    if (e.capacity > 0 && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        pq.offer(new int[]{dist[e.to], e.to});\n                    }\n                }\n            }\n            return dist[t] < INF;\n        }\n\n        int getMinCost(int s, int t) {\n            int totalFlow = 0, totalCost = 0;\n            while (dijkstra(s, t)) {\n                int flow = INF;\n                for (int v = t; v != s; v = prevv[v]) {\n                    flow = Math.min(flow, adj.get(prevv[v]).get(preve[v]).capacity);\n                }\n                totalFlow += flow;\n                totalCost += dist[t] * flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = adj.get(prevv[v]).get(preve[v]);\n                    e.capacity -= flow;\n                    adj.get(v).get(e.index).capacity += flow;\n                }\n            }\n            return totalCost;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int s = 0;\n        int t = n * 100 + 1;\n        MinCostFlow mcf = new MinCostFlow(t + 1);\n        \n        // Level 100 to sink\n        for (int i = 1; i <= 100; ++i) {\n            mcf.addEdge(i, t, 100, 0);\n        }\n        \n        // Source to starting positions\n        for (int i = 0; i < k; ++i) {\n            int v = sc.nextInt();\n            mcf.addEdge(s, (v - 1) * 100 + 1, 1, 0);\n        }\n        \n        // Intra-node edges (level j to j+1)\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j < 100; ++j) {\n                mcf.addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n            }\n        }\n        \n        // Inter-node edges\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            \n            for (int j = 1; j < 100; ++j) {\n                int from = (u - 1) * 100 + j;\n                int to = (v - 1) * 100 + j + 1;\n                for (int step = 1; step <= 50; ++step) {\n                    int cost = c + (step * step - (step - 1) * (step - 1)) * d;\n                    mcf.addEdge(from, to, 1, cost);\n                }\n            }\n            \n            for (int j = 1; j < 100; ++j) {\n                int from = (v - 1) * 100 + j;\n                int to = (u - 1) * 100 + j + 1;\n                for (int step = 1; step <= 50; ++step) {\n                    int cost = c + (step * step - (step - 1) * (step - 1)) * d;\n                    mcf.addEdge(from, to, 1, cost);\n                }\n            }\n        }\n        \n        System.out.println(mcf.getMinCost(s, t));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017414960893802345, -3.576272320060525e-06, -7.152555099310121e-07, -0.006027497351169586, -7.354942499659956e-05, -0.1426793336868286, -0.08906301856040955, -0.0001436368766007945, -3.576278118089249e-07, -0.00023898606013972312, -0.014163684099912643, -0.0009121309849433601, -0.002560672117397189, -0.10128022730350494, -3.2186455882765586e-06, -1.2159273865108844e-05, -1.1920928244535389e-07, -1.9192511899746023e-05, 0.0, -3.135155202471651e-05, -1.1920928244535389e-07, -1.1920922133867862e-06, 0.0, -1.311301275563892e-06, -4.768370445162873e-07, -3.576278118089249e-07, -3.576272