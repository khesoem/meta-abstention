ction = 0; action < (1 << N); ++action) {\n        bitset<128> future_state = current_state;\n        for (int idx = 0; idx < (1 << N); ++idx) {\n            if (!future_state[idx]) {\n                int overlap = action & idx;\n                bool covered = false;\n                while (overlap) {\n                    int single_bit = extract_lowest_bit(overlap);\n                    if (current_state[idx ^ single_bit]) {\n                        future_state[idx] = 1;\n                        covered = true;\n                        break;\n                    }\n                    overlap -= single_bit;\n                }\n                if (!covered) future_state[idx] = 0;\n            }\n        }\n        transition_table[node_index][action] = traverse_states(future_state);\n    }\n    return node_index;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N;\n    traverse_states(1);\n    \n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            cin >> adjacency[i][j];\n            adjacency[i][j] = modular_multiply(adjacency[i][j], modular_pow(100, MOD - 2));\n        }\n    }\n    \n    for (int i = 0; i < N; ++i) {\n        for (int mask = 0; mask < (1 << N); ++mask) {\n            probabilities[i][mask] = 1;\n            for (int k = 0; k < N; ++k) {\n                if ((mask >> k) & 1)\n                    probabilities[i][mask] = modular_multiply(probabilities[i][mask], adjacency[i][k]);\n                else\n                    probabilities[i][mask] = modular_multiply(probabilities[i][mask], modular_subtract(1, adjacency[i][k]));\n            }\n        }\n    }\n    \n    dp[0][1] = 1;\n    for (int step = 1; step <= N; ++step) {\n        for (int node = 1; node <= state_id_counter; ++node) {\n            for (int choice = 0; choice < (1 << N); ++choice) {\n                int next_node = transition_table[node][choice];\n                dp[step][next_node] = modular_add