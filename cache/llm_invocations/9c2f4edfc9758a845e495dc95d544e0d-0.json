nt set_v(int _v) {\n            v = (_v < MOD) ? _v : _v - MOD;\n            return this;\n        }\n\n        boolean isZero() { return v == 0; }\n\n        Mint negate() { return new Mint(0).subtract(this); }\n\n        Mint add(Mint r) {\n            return new Mint(0).set_v(v + r.v);\n        }\n\n        Mint subtract(Mint r) {\n            return new Mint(0).set_v(v + MOD - r.v);\n        }\n\n        Mint multiply(Mint r) {\n            return new Mint(0).set_v((int)((long)v * r.v % MOD));\n        }\n\n        Mint divide(Mint r) {\n            return multiply(r.inv());\n        }\n\n        Mint pow(long n) {\n            Mint x = this, r = new Mint(1);\n            while (n > 0) {\n                if ((n & 1) == 1) r = r.multiply(x);\n                x = x.multiply(x);\n                n >>= 1;\n            }\n            return r;\n        }\n\n        Mint inv() {\n            return pow(MOD - 2);\n        }\n\n        @Override\n        public String toString() {\n            return Integer.toString(v);\n        }\n\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (o == null || getClass() != o.getClass()) return false;\n            Mint mint = (Mint) o;\n            return v == mint.v;\n        }\n\n        @Override\n        public int hashCode() {\n            return v;\n        }\n\n        static final Mint ONE = new Mint(1);\n        static final Mint ZERO = new Mint(0);\n    }\n\n    static class Pair<L, R> {\n        L first;\n        R second;\n\n        Pair(L first, R second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken