 c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    T = 99\n    C = 15\n    \n    # Flow network implementation\n    N = 50 * T + 2\n    M = 2 * N * C + N + 7\n    \n    # Initialize flow structures\n    first = [-1] * N\n    nxt = [0] * (2 * M)\n    ep = [0] * (2 * M)\n    cap = [0] * (2 * M)\n    cost_arr = [0] * (2 * M)\n    flo = [0] * (2 * M)\n    m_flow = 0\n    \n    def add_edge(a, b, c_cap=1, p_cost=0):\n        nonlocal m_flow\n        # Forward edge\n        nxt[m_flow] = first[a]\n        first[a] = m_flow\n        ep[m_flow] = a\n        cap[m_flow] = c_cap\n        cost_arr[m_flow] = p_cost\n        m_flow += 1\n        \n        # Backward edge\n        nxt[m_flow] = first[b]\n        first[b] = m_flow\n        ep[m_flow] = b\n        cap[m_flow] = 0\n        cost_arr[m_flow] = -p_cost\n        m_flow += 1\n    \n    # Read source connections\n    for _ in range(k):\n        a = int(data[idx]); idx += 1\n        add_edge(0, a, 1, 0)\n    \n    # Connect time layers\n    for t in range(T):\n        add_edge(1 + t * n, n * T + 1, float('inf'), 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                add_edge(i + (t - 1) * n, i + t * n, float('inf'), c)\n    \n    # Read edges\n    for _ in range(m):\n        a = int(data[idx]); idx += 1\n        b = int(data[idx]); idx += 1\n        for j in range(C):\n            cost_val = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                add_edge(a + (t - 1) * n, b + t * n, 1, cost_val * d + c)\n                add_edge(b + (t - 1) * n, a + t * n, 1, cost_val * d + c)\n    \n    # Initialize potentials\n    pot = [0] * N\n    INF = float('inf')\n    \n    # Bellman-Ford for initial potentials\n    for _ in range(1, N):\n        for e in range(m_flow):\n            if cap[e]:\n                u = ep[e]\n                v = ep[e ^ 1]\n                if pot[u] + cost_arr[e] < pot[v]:\n                    pot[v] = pot[u] + cost_arr[e]\n    \n    # Dijkstra-based shortest path with potentials\n    def dijkstra(s, t, n):\n        dist = [INF] * n\n        parent = [-1] * n\n        dist[s] = 0\n        heap = [(0, s)]\n        \n        while heap:\n            d, u = heapq.heappop(heap)\n            if d > dist[u]:\n                continue\n            i = first[u]\n            while i != -1:\n                v = ep[i ^ 1]\n                if flo[i] < cap[i] and dist[v] > dist[u] + pot[u] - pot[v] + cost_arr[i]:\n                    dist[v] = dist[u] + pot[u] - pot[v] + cost_arr[i]\n                    parent[v] = i\n                    heapq.heappush(heap, (dist[v], v))\n                i = nxt[i]\n        return dist, parent\n    \n    price = 0\n    flow = 0\n    \n    while True:\n        dist, parent = dijkstra(0, n * T + 1, N)\n        if dist[n * T + 1] >= INF:\n            break\n        \n        df = INF\n        node = n * T + 1\n        while node != 0:\n            e = parent[node]\n            df = min(df, cap[e] - flo[e])\n            node = ep[e ^ 1]\n        \n        if df == 0:\n            break\n        \n        node = n * T + 1\n        while node != 0:\n            e = parent[node]\n            flo[e] += df\n            flo[e ^ 1] -= df\n            price += df * cost_arr[e]\n            node = ep[e ^ 1]\n        \n        flow += df\n        \n        for i in range(N):\n            if dist[i] < INF:\n                pot[i] += dist[i]\n    \n    assert flow == k\n    print(price)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00020466140995267779, -1.4305104514278355e-06, -3.576278118089249e-07, -0.0006273209000937641, -0.001682177186012268, -1.311301275563892e-06, -0.01417532004415989, -0.1399020552635193, -3.576278118089249e-07, -0.043001625686883926, -0.33193933963775635, -2.264974000354414e-06, -0.11282586306333542, -0.0020899376831948757, -1.1920928244535389e-07, -0.3132857084274292, -0.035993270576000214,