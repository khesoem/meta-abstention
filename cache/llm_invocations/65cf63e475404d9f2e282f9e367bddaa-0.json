 > D[u] + e.w + H[u] - H[e.v]) {\n            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n            q.emplace(-D[e.v], e.v);\n            PV[e.v] = u;\n            PE[e.v] = idx;\n          }\n        }\n      }\n      if (D[t] == INF) return -1;\n      for (int i = 0; i < N; i++) H[i] += D[i];\n      ll d = f;\n      for (int i = t; i != s; i = PV[i]) {\n        d = min(d, edges[PE[i]].c);\n      }\n      f -= d;\n      res += d * H[t];\n      for (int i = t; i != s; i = PV[i]) {\n        edge &e = edges[PE[i]];\n        e.c -= d;\n        edges[e.r].c += d;\n      }\n    }\n    return res;\n  }\n};\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  for (int i = 0; i < K; i++) {\n    cin >> A[i];\n    A[i]--;\n  }\n  vector<int> us(M), vs(M);\n  for (int i = 0; i < M; i++) {\n    cin >> us[i] >> vs[i];\n    us[i]--;\n    vs[i]--;\n  }\n  mincostflow mcf(N * 101 + 2);\n  int s = N * 101;\n  int t = s + 1;\n  for (int i = 0; i < K; i++) {\n    mcf.add(s, A[i], 1, 0);\n  }\n  for (int i = 0; i <= 100; i++) {\n    mcf.add(N * i, t, K, C * i);\n  }\n  for (int i = 0; i < 100; i++) {\n    for (int j = 0; j < N; j++) {\n      mcf.add(i * N + j, (i + 1) * N + j, K, 0);\n    }\n    for (int j = 0; j < M; j++) {\n      for (int k = 1; k <= K; k++) {\n        mcf.add(N * i + us[j], N * (i + 1) + vs[j], 1, (2 * k - 1) * D);\n        mcf.add(N * i + vs[j], N * (i + 1) + us[j], 1, (2 * k - 1) * D);\n      }\n    }\n  }\n  cout << mcf.run(s, t, K) << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class MinCostFlow {\n        static class Edge {\n            int v;\n            long c;\n            long w;\n            int r;\n            Edge(int v, long c, long w, int r) {\n                this.v = v;\n                this.c = c;\n                this.w = w;\n                this.r = r;\n            }\n        }\n\n        List<Edge> edges;\n        List<List<Integer>> adj;\n\n        MinCostFlow(int n) {\n            edges = new ArrayList<>();\n            adj = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                adj.add(new ArrayList<>());\n            }\n        }\n\n        void add(int u, int v, long c, long w) {\n            int i = edges.size();\n            int j = i + 1;\n            edges.add(new Edge(v, c, w, j));\n            edges.add(new Edge(u, 0, -w, i));\n            adj.get(u).add(i);\n            adj.get(v).add(j);\n        }\n\n        long run(int s, int t, long f) {\n            int N = adj.size();\n            long res = 0;\n            long INF = (long) 1e18;\n            long[] H = new long[N];\n            long[] D = new long[N];\n            int[] PE = new int[N];\n            int[] PV = new int[N];\n            while (f > 0) {\n                Arrays.fill(D, INF);\n                D[s] = 0;\n                PriorityQueue<long[]> pq = new PriorityQueue<>((a, b) -> Long.compare(a[0], b[0]));\n                pq.offer(new long[]{0, s});\n                while (!pq.isEmpty()) {\n                    long[] top = pq.poll();\n                    long d = top[0];\n                    int u = (int) top[1];\n                    if (D[u] < d) continue;\n                    for (int idx : adj.get(u)) {\n                        Edge e = edges.get(idx);\n                        if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n                            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n                            pq.offer(new long[]{D[e.v], e.v});\n                            PV[e.v] = u;\n                            PE[e.v] = idx;\n                        }\n                    }\n                }\n                if (D[t] == INF) return -1;\n                for (int i = 0; i < N; i++) H[i] += D[i];\n                long d = f;\n                for (int i = t; i != s; i = PV[i]) {\n                    d = Math.min(d, edges.get(PE[i]).c);\n                }\n                f -= d;\n                res += d * H[t];\n                for (int i = t; i != s; i = PV[i]) {\n                    Edge e = edges.get(PE[i]);\n                    e.c -= d;\n                    edges.get(e.r).c += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = sc.nextInt();\n        int K = sc.nextInt();\n        long C = sc.nextLong();\n        long D = sc.nextLong();\n        int[] A = new int[K];\n        for (int i = 0; i < K; i++) {\n            A[i] = sc.nextInt() - 1;\n        }\n        int[] us = new int[M];\n        int[] vs = new int[M];\n        for (int i = 0; i < M; i++) {\n            us[i] = sc.nextInt() - 1;\n            vs[i] = sc.nextInt() - 1;\n        }\n        MinCostFlow mcf = new MinCostFlow(N * 101 + 2);\n        int s = N * 101;\n        int t = s + 1;\n        for (int i = 0; i < K; i++) {\n            mcf.add(s, A[i], 1, 0);\n        }\n        for (int i = 0; i <= 100; i++) {\n            mcf.add(N * i, t, K, C * i);\n        }\n        for (int i = 0; i < 100; i++) {\n            for (int j = 0; j < N; j++) {\n                mcf.add(i * N + j, (i + 1) * N + j, K, 0);\n            }\n            for (int j = 0; j < M; j++) {\n                for (int k = 1; k <= K; k++) {\n                    mcf.add(N * i + us[j], N * (i + 1) + vs[j], 1, (2 * k - 1) * D);\n                    mcf.add(N * i + vs[j], N * (i + 1) + us[j], 1, (2 * k - 1) * D);\n                }\n            }\n        }\n        System.out.println(mcf.run(s, t, K));\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.264974e-06, 0.0, 0.0, -0.000114076785, -0.0002715219, -7.152555e-07, -0.06196784, -0.