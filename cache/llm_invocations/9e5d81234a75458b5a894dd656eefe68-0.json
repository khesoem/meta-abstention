nsition t = pq.poll();\n            if (k >= t.cost && prefixParity[t.index] == 0) {\n                k -= t.cost;\n                operations++;\n            }\n        }\n        \n        System.out.println(operations);\n    }\n    \n    static class Transition implements Comparable<Transition> {\n        int cost;\n        int index;\n        \n        Transition(int c, int idx) {\n            cost = c;\n            index = idx;\n        }\n        \n        @Override\n        public int compareTo(Transition other) {\n            if (cost != other.cost) return Integer.compare(cost, other.cost);\n            return Integer.compare(index, other.index);\n        }\n    }\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cmath>\n\nstruct Transition {\n    int cost;\n    int index;\n    \n    Transition(int c, int idx) : cost(c), index(idx) {}\n    \n    bool operator<(const Transition& other) const {\n        if (cost != other.cost) {\n            return cost > other.cost; // Min-heap behavior\n        }\n        return index > other.index;\n    }\n};\n\nint main() {\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    \n    int n, k;\n    std::cin >> n >> k;\n    \n    std::vector<int> sequence(n);\n    std::vector<int> prefixParity(n);\n    \n    for (int i = 0; i < n; i++) {\n        std::cin >> sequence[i];\n        if (i == 0) {\n            prefixParity[i] = ((sequence[i] & 1) == 0) ? 1 : -1;\n        } else {\n            prefixParity[i] = prefixParity[i-1] + (((sequence[i] & 1) == 0) ? 1 : -1);\n        }\n    }\n    \n    std::priority_queue<Transition> pq;\n    for (int i = 0; i < n-1; i++) {\n        int diff = std::abs(sequence[i+1] - sequence[i]);\n        pq.push(Transition(diff, i));\n    }\n    \n    int operations = 0;\