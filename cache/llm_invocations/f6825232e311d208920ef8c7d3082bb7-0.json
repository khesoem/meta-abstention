{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nint add(int a, int b) { return (a += b) >= MOD ? a - MOD : a; }\nint sub(int a, int b) { return (a -= b) < 0 ? a + MOD : a; }\nint mul(long long a, long long b) { return a * b % MOD; }\nint binpow(int a, int e) {\n    int r = 1;\n    while (e) {\n        if (e & 1) r = mul(r, a);\n        a = mul(a, a);\n        e >>= 1;\n    }\n    return r;\n}\nint modinv(int a) { return binpow(a, MOD - 2); }\nint divide(int a, int b) { return mul(a, modinv(b)); }\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifdef LOCAL\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    cin >> n;\n\n    vector<vector<int>> mat(n, vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> mat[i][j];\n            mat[i][j] = divide(mat[i][j], 100);\n        }\n\n    using State = pair<vector<char>, int>;\n    vector<State> dp = {{{0}, 1}};\n\n    for (int col = 0; col < n; ++col) {\n        vector<State> nxt;\n\n        for (int bitmask = 0; bitmask < (1 << n); ++bitmask) {\n            int p = 1;\n            for (int i = 0; i < n; ++i)\n                p = mul(p, (bitmask >> i & 1) ? mat[i][col] : sub(1, mat[i][col]));\n\n            for (const auto& [maskvec, coef] : dp) {\n                vector<char> nmasks;\n                for (char base : maskvec) {\n                    int rem = bitmask ^ (base & bitmask);\n                    while (rem) {\n                        int low = rem & -rem;\n                        nmasks.push_back(base | low);\n                        rem ^= low;\n                    }\n                }\n                if (nmasks.empty()) continue;\n                sort(nmasks.begin(), nmasks.end());\n                nmasks.erase(unique(nmasks.begin(), nmasks.end()), nmasks.end());\n                nxt.emplace_back(nmasks, mul(coef, p));\n            }\n        }\n\n        sort(nxt.begin(), nxt.end());\n        dp.clear();\n\n        for (int i = 0; i < (int)nxt.size(); ) {\n            int j = i;\n            int sum = 0;\n            while (j < (int)nxt.size() && nxt[j].first == nxt[i].first)\n                sum = add(sum, nxt[j++].second);\n            dp.emplace_back(nxt[i].first, sum);\n            i = j;\n        }\n    }\n\n    int ans = 0;\n    for (const auto& [_, coef] : dp) ans = add(ans, coef);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n\n    static int add(int a, int b) {\n        a += b;\n        return a >= MOD ? a - MOD : a;\n    }\n\n    static int sub(int a, int b) {\n        a -= b;\n        return a < 0 ? a + MOD : a;\n    }\n\n    static int mul(long a, long b) {\n        return (int) ((a * b) % MOD);\n    }\n\n    static int binpow(int a, int e) {\n        int r = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) r = mul(r, a);\n            a = mul(a, a);\n            e >>= 1;\n        }\n        return r;\n    }\n\n    static int modinv(int a) {\n        return binpow(a, MOD - 2);\n    }\n\n    static int divide(int a, int b) {\n        return mul(a, modinv(b));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n\n        int[][] mat = new int[n][n];\n        for (int i = 0; i < n; ++i) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; ++j) {\n                mat[i][j] = divide(Integer.parseInt(st.nextToken()), 100);\n            }\n        }\n\n        // Using List of int[] for maskvec and int for coef\n        List<State> dp = new ArrayList<>();\n        dp.add(new State(new int[]{0}, 1));\n\n        for (int col = 0; col < n; ++col) {\n            List<State> nxt = new ArrayList<>();\n\n            for (int bitmask = 0; bitmask < (1 << n); ++bitmask) {\n                int p = 1;\n                for (int i = 0; i < n; ++i) {\n                    if ((bitmask >> i & 1) == 1) {\n                        p = mul(p, mat[i][col]);\n                    } else {\n                        p = mul(p, sub(1, mat[i][col]));\n                    }\n                }\n\n                for (State state : dp) {\n                    int[] maskvec = state.maskvec;\n                    int coef = state.coef;\n                    List<Integer> nmasks = new ArrayList<>();\n\n                    for (int base : maskvec) {\n                        int rem = bitmask ^ (base & bitmask);\n                        while (rem != 0) {\n                            int low = rem & -rem;\n                            nmasks.add(base | low);\n                            rem ^= low;\n                        }\n                    }\n\n                    if (nmasks.isEmpty()) continue;\n\n                    Collections.sort(nmasks);\n                    // Remove duplicates\n                    List<Integer> uniqueNmasks = new ArrayList<>();\n                    for (int k = 0; k < nmasks.size(); ++k) {\n                        if (k == 0 || nmasks.get(k) != nmasks.get(k - 1)) {\n                            uniqueNmasks.add(nmasks.get(k));\n                        }\n                    }\n\n                    int[] nmasksArray = new int[uniqueNmasks.size()];\n                    for (int k = 0; k < uniqueNmasks.size(); ++k) {\n                        nmasksArray[k] = uniqueNmasks.get(k);\n                    }\n\n                    nxt.add(new State(nmasksArray, mul(coef, p)));\n                }\n            }\n\n            Collections.sort(nxt, (a, b) -> {\n                if (a.maskvec.length != b.maskvec.length) {\n                    return a.maskvec.length - b.maskvec.length;\n                }\n                for (int i = 0; i < Math.min(a.maskvec.length, b.maskvec.length); ++i) {\n                    if (a.maskvec[i] != b.maskvec[i]) {\n                        return a.maskvec[i] - b.maskvec[i];\n                    }\n                }\n                return 0;\n            });\n\n            dp.clear();\n\n            for (int i = 0; i < nxt.size(); ) {\n                int j = i;\n                int sum = 0;\n                while (j < nxt.size() && statesEqual(nxt.get(i), nxt.get(j))) {\n                    sum = add(sum, nxt.get(j).coef);\n                    j++;\n                }\n                dp.add(new State(nxt.get(i).maskvec, sum));\n                i = j;\n            }\n        }\n\n        int ans = 0;\n        for (State state : dp) {\n            ans = add(ans, state.coef);\n        }\n        System.out.println(ans);\n    }\n\n    static boolean statesEqual(State a, State b) {\n        if (a.maskvec.length != b.maskvec.length) return false;\n        for (int i = 0; i < a.maskvec.length; ++i) {\n            if (a.maskvec[i] != b.maskvec[i]) return false;\n        }\n        return true;\n    }\n\n    static class State {\n        int[] maskvec;\n        int coef;\n\n        State(int[] maskvec, int coef) {\n            this.maskvec = maskvec;\n            this.coef = coef;\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00014804698002990335, -2.264974000354414e-06, -4.768370445162873e-07, -0.000196556793525815, -3.862306402879767e-05, -0.020566774532198906, -0.3484784960746765, -0.0036593396216630936, -3.2066785934148356e-05, -0.0003146630187984556, -0.0003381395654287189, -0.00013183678674977273, -1.9073468138230965e-06, -6.842378934379667e-05, -0.004623081535100937, -4.529942543740617e-06, -0.018275564536452293, -9.762764238985255e-05, -1.2516897186287679e-05, -2.622600959512056e-06, 0.0, 0.0, 0.0, -4.005352093372494e-05, 0.0, 0.0, -2.0265558760002023e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.002805109601467848, -7.152555099310121e-07, -0.0011747133685275912, -1.0371154530730564e-05, -5.960446742392378e-06, -4.446407547220588e-05, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -0.03364565595984459, -2.145764938177308e-06, -0.523144006729126, -0.16024157404899597, -4.768370445162873e-07, -1.0728830375228426e-06, -1.1920922133867862e-06, -0.08894708752632141, -0.0003106111544184387, 0.0, -9.775113539944869e-06, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, -1.4185804502631072e-05, 0.0, -3.2186455882765586e-06, -2.3841830625315197e-06, -4.410734163684538e-06, -1.549708758830093e-05, 0.0, -1.1920922133867862e-06, -2.264974000354414e-06, -7.593343616463244e-05, -4.410734163684538e-06, -2.3841855067985307e-07, 0.0, -4.172316494077677e-06, -0.000952386180870235, -4.768370445162873e-07, 0.0, -2.0265558760002023e-06, -9.2982809292