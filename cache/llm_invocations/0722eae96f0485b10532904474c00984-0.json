(nx, ny, n, station) and not seen[nx][ny] and not poison[t][nx][ny]:\n                seen[nx][ny] = True\n                q.append((t+1, nx, ny))\n    return 999\n\nclass FlowNetwork:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.parent = [-1]*n\n        self.parent_edge = [-1]*n\n\n    def add_edge(self, u, v, c):\n        forward = [v, len(self.adj[v]), 0, c]\n        backward = [u, len(self.adj[u]), 0, 0]\n        self.adj[u].append(forward)\n        self.adj[v].append(backward)\n\n    def bfs(self, s, t):\n        self.parent = [-1]*self.n\n        self.parent_edge = [-1]*self.n\n        q = deque()\n        q.append(s)\n        self.parent[s] = s\n        while q:\n            u = q.popleft()\n            for i, e in enumerate(self.adj[u]):\n                if e[3] - e[2] > 0 and self.parent[e[0]] == -1:\n                    self.parent[e[0]] = u\n                    self.parent_edge[e[0]] = i\n                    if e[0] == t:\n                        return True\n                    q.append(e[0])\n        return False\n\n    def augment(self, s, t):\n        pushed = float('inf')\n        v = t\n        while v != s:\n            u = self.parent[v]\n            e = self.adj[u][self.parent_edge[v]]\n            pushed = min(pushed, e[3] - e[2])\n            v = u\n        v = t\n        while v != s:\n            u = self.parent[v]\n            e = self.adj[u][self.parent_edge[v]]\n            e[2] += pushed\n            rev = self.adj[v][e[1]]\n            rev[2] -= pushed\n            v = u\n        return pushed\n\n    def max_flow(self, s, t):\n        total = 0\n        while self.bfs(s, t):\n            total += self.augment(s, t)\n        return total\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    N = int(first[0])\n    T = int(first[1])\n    station = [[0]*N for _ in range(N)]\n    person = []\n    bad = Pos(0,0,0)\n    line_idx = 1\n    for i in range(N):\n        line = data[line_idx].strip()\n        line_idx += 1\n        for j, ch in enumerate(line):\n            typ = cell_type(ch)\n            val = cell_number(ch)\n            station[i][j] = typ\n            if typ == ROOM and val > 0:\n                person.append(Pos(i, j, val))\n            if typ == BAD_REAC:\n                bad = Pos(i, j, 0)\n    capsule = []\n    for i in range(N):\n        line = data[line_idx].strip()\n        line_idx += 1\n        for j, ch in enumerate(line):\n            typ = cell_type(ch)\n            val = cell_number(ch)\n            if typ == CAPSULE and val > 0:\n                capsule.append(Pos(i, j, val))\n    flow = FlowNetwork(MAXN)\n    S = 0\n    SNK = MAXN - 1\n    for i, p in enumerate(person):\n        flow.add_edge(S, i*2 + 1, p.qnt)\n    for j, c in enumerate(capsule):\n        flow.add_edge(j*2 + 2, SNK, c.qnt)\n    poison = spread_venom(bad.x, bad.y, T, N, station)\n    for i, p in enumerate(person):\n        for j, c in enumerate(capsule):\n            t = travel_time(p, c, N, T, station, poison)\n            if t <= T:\n                flow.add_edge(i*2 + 1, j*2 + 2, 999)\n    print(flow.max_flow(S, SNK))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.825220326485578e-05, 0.0, 0.0, -0.001190311275422573, -0.0007394201820716262, -1.1920928244535389e-07, -2.5510462364763953e-05, -1.168244216387393e-05, -1.311301275563892e-06, 0.0, -3.576278118089249e-07, -0.0012162677012383938, -0.0002422039397060871, -6.318072337307967e-06, -1.0728830375228426e-06, 0.0, -1.1920928244535389e-07, -0.0001245659514097497, -1.5497195136049413e-06, 0.0, -2.539125671319198e-05, -4.768370445162873e-07, -1.1920922133867862e-06, -5.960462772236497e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.4305104514278355e-06, -3.576278118089249e-07, -4.768370445162873e-07, -4.768370445162873e-