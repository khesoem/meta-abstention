                       int ni = i + dx[d], nj = j + dy[d];\n                        if (inside(ni, nj, n)) poison[t][ni][nj] = 1;\n                    }\n                }\n            }\n        }\n    }\n}\n\nint travel_time(const Pos &a, const Pos &b, int n, int T) {\n    vector<bitset<MAXN>> seen(n);\n    queue<pair<int, Pos>> q;\n    q.push({0, a});\n    seen[a.x][a.y] = 1;\n\n    while (!q.empty()) {\n        int t = q.front().first;\n        Pos cur = q.front().second;\n        q.pop();\n\n        if (cur.x == b.x && cur.y == b.y) return t;\n        if (t == T) continue;\n        if (poison[t][cur.x][cur.y]) continue;\n\n        for (int d = 0; d < 4; ++d) {\n            Pos nxt(cur.x + dx[d], cur.y + dy[d], 0);\n            if (inside(nxt.x, nxt.y, n) && !seen[nxt.x][nxt.y] && !poison[t][nxt.x][nxt.y]) {\n                seen[nxt.x][nxt.y] = 1;\n                q.push({t + 1, nxt});\n            }\n        }\n    }\n    return 999;\n}\n\nstruct Edge {\n    int to, rev, flow, cap;\n    int rest() const {\n        return cap - flow;\n    }\n};\n\nclass FlowNetwork {\n    int n;\n    vector<vector<Edge>> adj;\n    vector<int> parent, parentEdge;\n\npublic:\n    FlowNetwork(int _n) : n(_n), adj(_n), parent(_n), parentEdge(_n) {}\n\n    void addEdge(int u, int v, int c) {\n        Edge a = {v, (int)adj[v].size(), 0, c};\n        Edge b = {u, (int)adj[u].size(), 0, 0};\n        adj[u].push_back(a);\n        adj[v].push_back(b);\n    }\n\n    bool bfs(int s, int t) {\n        fill(parent.begin(), parent.end(), -1);\n        fill(parentEdge.begin(), parentEdge.end(), -1);\n\n        queue<int> q;\n        q.push(s);\n        parent[s] = s;\n\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n\n            for (int i = 0; i < (int)adj[u].size(); ++i) {\n                Edge &e = adj[u][i];\n                if (e.rest() > 0 && parent[e.to] == -1) {\n                    parent[e.to] = u;\n                    parentEdge[e.to] = i;\n    