isited[tx][ty] || g1[tx][ty] == 'Y')\n                continue;\n            q.push_back({{tx, ty}, p.second + 1});\n        }\n    }\n}\n\nint index(int level, int x, int y) {\n    return level * n * n + (x - 1) * n + y;\n}\n\nint main() {\n    int i, t, j, k;\n    scanf(\"%d%d\", &n, &t);\n    for (i = 1; i <= n; ++i) scanf(\"%s\", g1[i] + 1);\n    for (i = 1; i <= n; ++i) scanf(\"%s\", g2[i] + 1);\n    \n    mf.s = 0; mf.t = MAX_SIZE - 2;\n    int x = 0, y = 0;\n    for (i = 1; i <= n; ++i) {\n        for (j = 1; j <= n; ++j) {\n            if (g1[i][j] == 'Z') { x = i; y = j; break; }\n        }\n    }\n    \n    for (i = 1; i <= n * n; ++i) tgt[i] = MAX_SIZE - 3 - (n * n - i);\n    \n    BFS(x, y);\n    \n    for (i = 1; i <= n; ++i) {\n        for (j = 1; j <= n; ++j) {\n            if (g1[i][j] >= '0' && g1[i][j] <= '9')\n                mf.addedge(mf.s, index(0, i, j), g1[i][j] - '0');\n            if (g2[i][j] >= '0' && g2[i][j] <= '9')\n                mf.addedge(tgt[index(0, i, j)], mf.t, g2[i][j] - '0');\n            mf.addedge(index(0, i, j), tgt[index(0, i, j)], INF);\n        }\n    }\n    \n    int dx[4] = {1, 0, 0, -1}, dy[4] = {0, 1, -1, 0};\n    for (i = 1; i <= t; ++i) {\n        for (j = 1; j <= n; ++j) {\n            for (k = 1; k <= n; ++k) {\n                if (g1[j][k] == 'Y' || g1[j][k] == 'Z') continue;\n                for (int l = 0; l < 4; ++l) {\n                    int tx = dx[l] + j, ty = dy[l] + k;\n                    if (tx >= 1 && tx <= n && ty >= 1 && ty <= n && g1[tx][ty] != 'Y' && g1[tx][ty] != 'Z') {\n                        if (dist[j][k] >= i && dist[tx][ty] >= i && g1[j][k] != 'Y' && g1[j][k] != 'Z') {\n                            mf.addedge(index(i-1, tx, ty), index(i, j, k), INF);\n                        }\n                    }\n                }\n                mf.addedge(index(i, j, k), tgt[index(0, j, k)], INF);\n            }\n        }\n    }\n    printf(\"%lld\\n\", mf.Dinic());\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport collections\nimport math\n\nMAX_SIZE = 7100\nINF = 1000000000\n\nclass Maxflow:\n    def __init__(self):\n        self.s = 0\n        self.t = MAX_SIZE - 2\n        self.graph = [[] for _ in range(MAX_SIZE)]\n        self.level = [0] * MAX_SIZE\n        self.it = [0] * MAX_SIZE\n\n    def add_edge(self, fr, to, cap):\n        forward = [to, cap, None]\n        backward = [fr, 0, None]\n        forward[2] = len(self.graph[to])\n        backward[2] = len(self.graph[fr])\n        self.graph[fr].append(forward)\n        self.graph[to].append(backward)\n\n    def bfs(self):\n        for i in range(len(self.level)):\n            self.level[i] = -1\n        q = collections.deque()\n        self.level[self.s] = 0\n        q.append(self.s)\n        while q:\n            v = q.popleft()\n            for e in self.graph[v]:\n                if e[1] > 0 and self.level[e[0]] < 0:\n                    self.level[e[0]] = self.level[v] + 1\n                    q.append(e[0])\n        return self.level[self.t] >= 0\n\n    def dfs(self, v, f):\n        if v == self.t:\n            return f\n        for i in range(self.it[v], len(self.graph[v])):\n            self.it[v] = i\n            e = self.graph[v][i]\n            if e[1] > 0 and self.level[v] < self.level[e[0]]:\n                ret = self.dfs(e[0], min(f, e[1]))\n                if ret > 0:\n                    e[1] -= ret\n                    rev = self.graph[e[0]][e[2]]\n                    rev[1] += ret\n                    return ret\n        return 0\n\n    def dinic(self):\n        flow = 0\n        while self.bfs():\n            self.it = [0] * MAX_SIZE\n            while True:\n                pushed = self.dfs(self.s, INF)\n                if pushed == 0:\n                    break\n                flow += pushed\n        return flow\n\ndef index(level, x, y):\n    return level * n * n + (x - 1) * n + y\n\ndef bfs_start(x, y):\n    global dist, visited\n    visited = [[False] * (n+1) for _ in range(n+1)]\n    dist = [[111] * (n+1) for _ in range(n+1)]\n    q = collections.deque()\n    dist[x][y] = 0\n    q.append((x, y, 0))\n    dx = [1,0,0,-1]\n    dy = [0,1,-1,0]\n    while q:\n        cx, cy, d = q.popleft()\n        if visited[cx][cy]:\n            continue\n        visited[cx][cy] = True\n        dist[cx][cy] = d\n        for i in range(4):\n            nx = cx + dx[i]\n            ny = cy + dy[i]\n            if 1 <= nx <= n and 1 <= ny <= n and not visited[nx][ny] and g1[nx][ny] != 'Y':\n                q.append((nx, ny, d+1))\n\ndef main():\n    global n, g1, g2, visited, dist\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    t = int(next(it))\n    g1 = [None] * (n+1)\n    g2 = [None] * (n+1)\n    for i in range(1, n+1):\n        g1[i] = ' ' + next(it)\n    for i in range(1, n+1):\n        g2[i] = ' ' + next(it)\n\n    mf = Maxflow()\n    mf.s = 0\n    mf.t = MAX_SIZE - 2\n\n    x = y = 0\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if g1[i][j] == 'Z':\n                x, y = i, j\n                break\n        if x: break\n\n    tgt = [0] * (n*n + 1)\n    for i in range(1, n*n + 1):\n        tgt[i] = MAX_SIZE - 3 - (n*n - i)\n\n    bfs_start(x, y)\n\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '0' <= g1[i][j] <= '9':\n                mf.add_edge(mf.s, index(0,i,j), ord(g1[i][j]) - ord('0'))\n            if '0' <= g2[i][j] <= '9':\n                mf.add_edge(tgt[index(0,i,j)], mf.t, ord(g2[i][j]) - ord('0'))\n            mf.add_edge(index(0,i,j), tgt[index(0,i,j)], INF)\n\n    dx = [1,0,0,-1]\n    dy = [0,1,-1,0]\n    for l in range(1, t+1):\n        for i in range(1, n+1):\n            for j in range(1, n+1):\n                if g1[i][j] in ('Y','Z'):\n                    continue\n     