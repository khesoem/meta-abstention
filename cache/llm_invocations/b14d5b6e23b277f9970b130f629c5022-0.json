pair (u,v)\n        for (int i = 1; i <= m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            // u -> v\n            for (int j = 1; j < 100; ++j) {\n                int idx = (u - 1) * 100 + j;\n                int idy = (v - 1) * 100 + j + 1;\n                for (int kk = 1; kk <= 20; ++kk) {\n                    add(idx, idy, 1, c + (kk * kk - (kk - 1) * (kk - 1)) * d);\n                }\n            }\n            // v -> u\n            for (int j = 1; j < 100; ++j) {\n                int idx = (v - 1) * 100 + j;\n                int idy = (u - 1) * 100 + j + 1;\n                for (int kk = 1; kk <= 20; ++kk) {\n                    add(idx, idy, 1, c + (kk * kk - (kk - 1) * (kk - 1)) * d);\n                }\n            }\n        }\n        System.out.println(minCostFlow(s, t));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0013530300057027e-05, 0.0, 0.0, -0.0002205128694185987, -6.41325386823155e-05, -1.1920928244535389e-07, -0.00043072958942502737, -0.050322771072387695, -7.223821739898995e-05, -1.1920928244535389e-07, -0.014289671555161476, -0.0004377598816063255, -2.145764938177308e-06, -0.0009844223968684673, -1.7762025890988298e-05, -8.344646857949556e-07, -0.47657760977745056, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920858014491387e-05, 0.0, -3.576278118089249e-07, -4.768360213347478e-06, 0.0, -5.125986263010418e-06, -1.1920928244535389e-07, -4.541770613286644e-05, -2.264974000354414e-06, -1.1920928244535389e-07, -0.20156683027744293, 0.0, -5.960462772236497e-07, -3.576278118089249e-07, 0.0, -1.680836794548668e-05, -1.1920928244535389e-07, -3.3378546504536644e-06, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, -0.00010775939153973013, -0.00012337400403339416, -6.437280717364047e-06, -0.005233872216194868, -5.960462772236497e-07, -0.0009126074146479368, 0.0, -1.9073468138230965e-06, -4.7683602133474