q.heappush(pq, (nd, v))\n                        self.pn[v] = u\n                        self.pe[v] = i\n                        self.f[v] = min(self.f[u], e.cap - e.f)\n            \n            if self.d[t] == INF:\n                break\n            \n            for i in range(self.nodes):\n                self.phi[i] += self.d[i]\n            \n            df = min(self.f[t], INF - totalFlow)\n            totalFlow += df\n            \n            v = t\n            while v != s:\n                e = self.g[self.pn[v]][self.pe[v]]\n                e.f += df\n                self.g[v][e.rev].f -= df\n                totalCost += df * e.cost\n                v = self.pn[v]\n        \n        return (totalFlow, totalCost)\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d_val = int(data[idx]); idx += 1\n    \n    T = 150\n    N = n * T\n    net = NetworkFlow(N + 2)\n    \n    for i in range(n):\n        for j in range(T - 1):\n            net.addEdge(i * T + j, i * T + j + 1, INF, c)\n    \n    for i in range(T):\n        net.addEdge(i, N + 1, INF, 0)\n    \n    for _ in range(k):\n        x = int(data[idx]); idx += 1\n        x -= 1\n        net.addEdge(N, x * T, 1, 0)\n    \n    for _ in range(m):\n        x = int(data[idx]); idx += 1\n        y = int(data[idx]); idx += 1\n        x -= 1\n        y -= 1\n        \n        for j in range(T - 1):\n            mult = 1\n            for _ in range(k):\n                net.addEdge(x * T + j, y * T + j + 1, 1, mult * d_val + c)\n                net.addEdge(y * T + j, x * T + j + 1, 1, mult * d_val + c)\n                mult += 2\n    \n    ans = net.solve(N, N + 1)\n    assert ans[0] == k\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019834458