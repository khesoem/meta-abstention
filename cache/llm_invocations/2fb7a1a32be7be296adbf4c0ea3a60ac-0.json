 h[e.to];\n                if (dist[e.to] > nd) {\n                    dist[e.to] = nd;\n                    prex[e.to] = x;\n                    prei[e.to] = i;\n                    pq.push(mp(nd, e.to));\n                }\n            }\n        }\n    }\n\n    int tot = 0;\n    int dfs(int x, int flow) {\n        if (prex[x] == -1) return flow;\n        int y = x;\n        x = prex[y];\n        int i = prei[y];\n        Edge &e = g[x][i];\n        int f = dfs(x, min(flow, e.cap));\n        e.cap -= f;\n        g[y][e.rev].cap += f;\n        return f;\n    }\n\n    pii solve(int s, int t) {\n        int ans = 0;\n        tot = 0;\n        memset(h, 0, sizeof h);\n        while (1) {\n            dijkstra(s);\n            if (dist[t] > 1e9) break;\n            for (int i = 0; i < nn; ++i)\n                if (dist[i] < 1e9) h[i] += dist[i];\n            int f = dfs(t, inf);\n            tot += f * h[t];\n            ans += f;\n        }\n        return mp(ans, tot);\n    }\n};\n\nint n, m, s = nn - 1, t = nn - 2;\nint k, c, d;\nint get(int x, int tim) {\n    return tim * 52 - 52 + x;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int kk = k;\n    while (k--) {\n        int x;\n        scanf(\"%d\", &x);\n        mcmf::add_edge(s, get(x, 1), 1, 0);\n    }\n    k = kk;\n    while (m--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n        for (int i = 1; i < 100; i++)\n            for (int j = 1; j <= k; j++)\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n        swap(x, y);\n        for (int i = 1; i < 100; i++)\n            for (int j = 1; j <= k; j++)\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n    }\n    for (int i = 1; i < 100; i++) {\n        for (int j = 1; j <= n; j++)\n            mcmf::add_edge(get(j, i), get(j, i + 1), inf, 0);\n        mcmf::add_edge(get(1, i), t, inf, c * (i - 1));\n    }\n    printf(\"%d\", mcmf::solve(s, t).second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class mcmf {\n        static class Edge {\n            int to, rev, cap, cost;\n            Edge(int to, int rev, int cap, int cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n\n        static final int nn = 6000;\n        static final int INF = 100000000;\n        static ArrayList<Edge>[] g = new ArrayList[nn];\n        static int[] dist = new int[nn];\n        static int[] h = new int[nn];\n        static int[] prex = new int[nn];\n        static int[] prei = new int[nn];\n        static int tot = 0;\n\n        static void add_edge(int x, int y, int c, int w) {\n            g[x].add(new Edge(y, g[y].size(), c, w));\n            g[y].add(new Edge(x, g[x].size() - 1, 0, -w));\n        }\n\n        static void dijkstra(int s) {\n            Arrays.fill(dist, Integer.MAX_VALUE / 2);\n            Arrays.fill(prex, -1);\n            dist[s] = 0;\n            PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n            pq.offer(new int[]{0, s});\n            while (!pq.isEmpty()) {\n                int[] cur = pq.poll();\n                int d = cur[0], x = cur[1];\n                if (dist[x] < d) continue;\n                for (int i = 0; i < g[x].size(); i++) {\n                    Edge e = g[x].get(i);\n                    if (e.cap == 0) continue;\n                    int nd = d + e.cost + h[x] - h[e.to];\n                    if (dist[e.to] > nd) {\n                        dist[e.to] = nd;\n                        prex[e.to] = x;\n                        prei[e.to] = i;\n                        pq.offer(new int[]{nd, e.to});\n                    }\n                }\n            }\n        }\n\n        static int dfs(int x, int flow) {\n            if (prex[x] == -1) return flow;\n            int y = x;\n            x = prex[y];\n            int i = prei[y];\n            Edge e = g[x].get(i);\n            int f = dfs(x, Math.min(flow, e.cap));\n            e.cap -= f;\n            g[y].get(e.rev).cap += f;\n            return f;\n        }\n\n        static int[] solve(int s, int t) {\n            int ans = 0;\n            tot = 0;\n            Arrays.fill(h, 0);\n            while (true) {\n                dijkstra(s);\n                if (dist[t] > 1e9) break;\n                for (int i = 0; i < nn; i++) {\n                    if (dist[i] < 1e9) h[i] += dist[i];\n                }\n                int f = dfs(t, INF);\n                tot += f * h[t];\n                ans += f;\n            }\n            return new int[]{ans, tot};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int s = mcmf.nn - 1;\n        int t = mcmf.nn - 2;\n\n        // Initialize graph\n        for (int i = 0; i < mcmf.nn; i++) {\n            mcmf.g[i] = new ArrayList<>();\n        }\n\n        int kk = k;\n        st = new StringTokenizer(br.readLine());\n        while (k-- > 0) {\n            int x = Integer.parseInt(st.nextToken());\n            mcmf.add_edge(s, get(x, 1), 1, 0);\n        }\n        k = kk;\n\n        while (m-- > 0) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    mcmf.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n            // swap x and y\n            int tmp = x; x = y; y = tmp;\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    mcmf.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n        }\n\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= n; j++) {\n                mcmf.add_edge(get(j, i), get(j, i + 1), mcmf.INF, 0);\n            }\n            mcmf.add_edge(get(1, i), t, mcmf.INF, c * (i - 1));\n        }\n\n        int[] result = mcmf.solve(s, t);\n        System.out.println(result[1]);\n    }\n\n    static int get(int x, int tim) {\n        return tim * 52 - 52 + x;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -0.474077045917511, -0.10023117065429688, 0.0, 0.0, 0.0, -0.00010239553375868127, -0.001620766706764698, 0.0, -0.00011693747364915907, -0.00863284058868885, -0.00043215948971919715, -0.005595378577709198, -0.3896569311618805, -0.6044104099273682, -2.1457441107486375e-05, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -7.509902934543788e-05, -0.12741628289222717, -1.0728830375228426e-06, -2.264974000354414e-06, -2.3841855067985307e-07, 0.0, 0.0, -1.2993727978027891e-05, 0.0, -1.7881377516459906e-06, -1.1920922133867862e-06, -7.152555099310121e-07, 0.0, -0.0002978596603497863, -1.3232143828645349e-05, -4.541770613286644e-05, -1.7404405298293568e-05, -0.20141644775867462, -8.487341256113723e-05, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -3.576278118089249e-07, -1.0132738680113107e-05, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -0.0031777145341038704, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -4.7683704451