{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <unordered_map>\n\nusing namespace std;\ntypedef long long ll;\nconst ll MOD = 1e9+7;\nll add(ll x, ll y) {\n    ll r = x + y;\n    if (r >= MOD) r -= MOD;\n    return r;\n}\nll sub(ll x, ll y) {\n    x -= y;\n    if (x < 0) x += MOD;\n    return x;\n}\nll mult(ll x, ll y) {\n    return (x * y) % MOD;\n}\nll modpow(ll x, ll p) {\n    if (p == 0) return 1;\n    if (p & 1) return mult(x, modpow(x, p-1));\n    return modpow(mult(x, x), p>>1);\n}\nll modinv(ll x) {\n    return modpow(x, MOD-2);\n}\n\nint n;\nvector<vector<ll>> A;\nll T[8][1<<7][1<<7];\nvector<unordered_map<ll,ll>> DP;\nvector<int> family(1<<7,0);\nvector<int> family_id(1<<7,0);\nvector<vector<int>> family_mask;\n\nvoid calc() {\n    family_mask.resize(n+1);\n    for (int mask=1; mask<(1<<n); ++mask) {\n        family[mask] = family[mask>>1] + (mask & 1);\n    }\n    for (int mask=0; mask<(1<<n); ++mask) {\n        family_id[mask] = (int)family_mask[family[mask]].size();\n        family_mask[family[mask]].push_back(mask);\n    }\n    for (int k=0; k<=n; ++k) {\n        int sz = (int)family_mask[k].size();\n        for (int i=0; i<sz; ++i) {\n            int cm = family_mask[k][i];\n            for (int mask=0; mask<(1<<n); ++mask) {\n                if ((mask & cm) == mask) { T[k][i][mask] = 0; continue; }\n                ll ans = 0;\n                for (int x=0; x<n; ++x) {\n                    if (cm & (1<<x)) continue;\n                    if ((mask & (1<<x))==0) continue;\n                    int newmask = cm | (1<<x);\n                    ans |= (1ll << family_id[newmask]);\n                }\n                T[k][i][mask] = ans;\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin>>n;\n    A.resize(n);\n    for (int i=0; i<n; ++i) {\n        A[i].resize(n);\n        for (int j=0; j<n; ++j) {\n            cin>>A[i][j];\n            A[i][j] = mult(A[i][j],modinv(100));\n        }\n    }\n    calc();\n    DP.resize(n+1);\n    DP[0][1] = 1;\n    for (int k=0; k<n; ++k) {\n        for (int edges=0; edges<(1<<n); ++edges) {\n            ll prob = 1;\n            for (int i=0; i<n; ++i) {\n                if (edges & (1<<i)) prob = mult(prob, A[k][i]);\n                else prob = mult(prob, sub(1,A[k][i]));\n            }\n            for (auto S : DP[k]) {\n                ll mask = S.first;\n                ll newmask = 0;\n                ll p = mult(prob, S.second);\n                for (int i=0; i<(int)family_mask[k].size(); ++i) {\n                    if (mask & (1ll<<i)) {\n                        newmask |= T[k][i][edges];\n                    }\n                }\n                if (newmask != 0) DP[k+1][newmask] = add(DP[k+1][newmask], p);\n            }\n        }\n    }\n    cout << DP[n][1] << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add(x, y):\n    r = x + y\n    if r >= MOD:\n        r -= MOD\n    return r\n\ndef sub(x, y):\n    x -= y\n    if x < 0:\n        x += MOD\n    return x\n\ndef mult(x, y):\n    return (x * y) % MOD\n\ndef modpow(x, p):\n    if p == 0:\n        return 1\n    if p & 1:\n        return mult(x, modpow(x, p - 1))\n    return modpow(mult(x, x), p >> 1)\n\ndef modinv(x):\n    return modpow(x, MOD - 2)\n\ndef calc():\n    global n, A, T, family, family_id, family_mask\n    family_mask = [[] for _ in range(n + 1)]\n    for mask in range(1, 1 << n):\n        family[mask] = family[mask >> 1] + (mask & 1)\n    for mask in range(1 << n):\n        family_id[mask] = len(family_mask[family[mask]])\n        family_mask[family[mask]].append(mask)\n    T = [[[0] * (1 << n) for _ in range(len(family_mask[k]))] for k in range(n + 1)]\n    for k in range(n + 1):\n        sz = len(family_mask[k])\n        for i in range(sz):\n            cm = family_mask[k][i]\n            for mask in range(1 << n):\n                if (mask & cm) == mask:\n                    T[k][i][mask] = 0\n                    continue\n                ans = 0\n                for x in range(n):\n                    if cm & (1 << x):\n                        continue\n                    if (mask & (1 << x)) == 0:\n                        continue\n                    newmask = cm | (1 << x)\n                    ans |= (1 << family_id[newmask])\n                T[k][i][mask] = ans\n\ndef main():\n    global n, A, T, family, family_id, family_mask\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    A = [[0] * n for _ in range(n)]\n    inv100 = modinv(100)\n    for i in range(n):\n        for j in range(n):\n            val = int(next(it))\n            A[i][j] = mult(val, inv100)\n    family = [0] * (1 << n)\n    family_id = [0] * (1 << n)\n    family_mask = []\n    calc()\n    DP = [dict() for _ in range(n + 1)]\n    DP[0][1] = 1\n    for k in range(n):\n        for edges in range(1 << n):\n  