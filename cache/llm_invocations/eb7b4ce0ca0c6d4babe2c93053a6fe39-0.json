{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, edge_idx, min_cost, arrivals[6010], froms[6010], tos[6010];\nint adj_head[MAXN], prev_edge[MAXN], shortest_dist[MAXN], in_queue[MAXN];\nqueue<int> bfs_queue;\nstruct Edge { int target, capacity, weight, next_edge; } edges[2000010];\n\nint encode(int t, int v) { return t * n + v; }\n\nvoid insert_edge(int src, int dst, int cap, int cost) {\n    edges[edge_idx] = {dst, cap, cost, adj_head[src]};\n    adj_head[src] = edge_idx++;\n    edges[edge_idx] = {src, 0, -cost, adj_head[dst]};\n    adj_head[dst] = edge_idx++;\n}\n\nbool find_min_cost_path(int source, int sink) {\n    fill(shortest_dist, shortest_dist + MAXN, INF);\n    bfs_queue.push(source);\n    shortest_dist[source] = 0;\n    while (!bfs_queue.empty()) {\n        int cur = bfs_queue.front(); bfs_queue.pop();\n        in_queue[cur] = 0;\n        for (int i = adj_head[cur]; ~i; i = edges[i].next_edge) {\n            int next_node = edges[i].target;\n            if (edges[i].capacity && shortest_dist[next_node] > shortest_dist[cur] + edges[i].weight) {\n                shortest_dist[next_node] = shortest_dist[cur] + edges[i].weight;\n                prev_edge[next_node] = i;\n                if (!in_queue[next_node]) {\n                    bfs_queue.push(next_node);\n                    in_queue[next_node] = 1;\n                }\n            }\n        }\n    }\n    return shortest_dist[sink] < 1000000000;\n}\n\nvoid augment_flow(int source, int sink) {\n    for (int node = sink; node != source; node = edges[prev_edge[node] ^ 1].target) {\n        edges[prev_edge[node]].capacity--;\n        edges[prev_edge[node] ^ 1].capacity++;\n    }\n    min_cost += shortest_dist[sink];\n}\n\nint main() {\n    memset(adj_head, -1, sizeof(adj_head));\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> n >> m >> k >> c >> d;\n    int source = 0, sink = 6000;\n    for (int i = 1; i <= k; i++) {\n        cin >> arrivals[i];\n        insert_edge(source, encode(0, arrivals[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        cin >> froms[i] >> tos[i];\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            insert_edge(encode(t, i), encode(t + 1, i), k, c);\n        }\n        insert_edge(encode(t, 1), sink, k, 0);\n        for (int i = 1; i <= m; i++) {\n            int max_j = min(k, 25);\n            for (int j = 1; j <= max_j; j++) {\n                int cost = c + (2 * j - 1) * d;\n                insert_edge(encode(t, froms[i]), encode(t + 1, tos[i]), 1, cost);\n                insert_edge(encode(t, tos[i]), encode(t + 1, froms[i]), 1, cost);\n            }\n        }\n    }\n    while (find_min_cost_path(source, sink)) augment_flow(source, sink);\n    cout << min_cost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 6010;\n    static final int INF = 0x3f3f3f3f;\n    static int n, m, k, c, d, edge_idx, min_cost;\n    static int[] arrivals = new int[6010];\n    static int[] froms = new int[6010];\n    static int[] tos = new int[6010];\n    static int[] adj_head = new int[MAXN];\n    static int[] prev_edge = new int[MAXN];\n    static int[] shortest_dist = new int[MAXN];\n    static int[] in_queue = new int[MAXN];\n    static Queue<Integer> bfs_queue = new LinkedList<>();\n    static Edge[] edges = new Edge[2000010];\n\n    static class Edge {\n        int target, capacity, weight, next_edge;\n\n        Edge(int target, int capacity, int weight, int next_edge) {\n            this.target = target;\n            this.capacity = capacity;\n            this.weight = weight;\n            this.next_edge = next_edge;\n        }\n    }\n\n    static int encode(int t, int v) {\n        return t * n + v;\n    }\n\n    static void insert_edge(int src, int dst, int cap, int cost) {\n        edges[edge_idx] = new Edge(dst, cap, cost, adj_head[src]);\n        adj_head[src] = edge_idx++;\n        edges[edge_idx] = new Edge(src, 0, -cost, adj_head[dst]);\n        adj_head[dst] = edge_idx++;\n    }\n\n    static boolean find_min_cost_path(int source, int sink) {\n        Arrays.fill(shortest_dist, INF);\n        bfs_queue.clear();\n        bfs_queue.add(source);\n        shortest_dist[source] = 0;\n        while (!bfs_queue.isEmpty()) {\n            int cur = bfs_queue.poll();\n            in_queue[cur] = 0;\n            for (int i = adj_head[cur]; i != -1; i = edges[i].next_edge) {\n                int next_node = edges[i].target;\n                if (edges[i].capacity > 0 && shortest_dist[next_node] > shortest_dist[cur] + edges[i].weight) {\n                    shortest_dist[next_node] = shortest_dist[cur] + edges[i].weight;\n                    prev_edge[next_node] = i;\n                    if (in_queue[next_node] == 0) {\n                        bfs_queue.add(next_node);\n                        in_queue[next_node] = 1;\n                    }\n                }\n            }\n        }\n        return shortest_dist[sink] < 1000000000;\n    }\n\n    static void augment_flow(int source, int sink) {\n        for (int node = sink; node != source; node = edges[prev_edge[node] ^ 1].target) {\n            edges[prev_edge[node]].capacity--;\n            edges[prev_edge[node] ^ 1].capacity++;\n        }\n        min_cost += shortest_dist[sink];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        Arrays.fill(adj_head, -1);\n        \n        int source = 0;\n        int sink = 6000;\n        \n        for (int i = 1; i <= k; i++) {\n            arrivals[i] = sc.nextInt();\n            insert_edge(source, encode(0, arrivals[i]), 1, 0);\n        }\n        \n        for (int i = 1; i <= m; i++) {\n            froms[i] = sc.nextInt();\n            tos[i] = sc.nextInt();\n        }\n        \n        for (int t = 0; t <= 100; t++) {\n            for (int i = 2; i <= n; i++) {\n                insert_edge(encode(t, i), encode(t + 1, i), k, c);\n            }\n            insert_edge(encode(t, 1), sink, k, 0);\n            for (int i = 1; i <= m; i++) {\n                int max_j = Math.min(k, 25);\n                for (int j = 1; j <= max_j; j++) {\n                    int cost = c + (2 * j - 1) * d;\n                    insert_edge(encode(t, froms[i]), encode(t + 1, tos[i]), 1, cost);\n                    insert_edge(encode(t, tos[i]), encode(t + 1, froms[i]), 1, cost);\n                }\n            }\n        }\n        \n        while (find_min_cost_path(source, sink)) {\n            augment_flow(source, sink);\n        }\n        \n        System.out.println(min_cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.619726915843785e-05, -1