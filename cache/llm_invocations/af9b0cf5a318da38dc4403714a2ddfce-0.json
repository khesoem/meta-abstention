(boat > 0) {\n\t\t\tfor(int i = nA; i >= 0 && 50 * (nA - i) <= k; i--)\n\t\t\t\tfor(int j = nB; j >= 0 && 50 * (nA - i) + 100 * (nB - j) <= k; j--)\n\t\t\t\t\tif(i != nA || j != nB)\n\t\t\t\t\t\tresolve(i, j, boat, mask, choose[nA][i] * choose[nB][j] % MOD);\n\t\t} else {\n\t\t\tfor(int i = nA; i <= a && 50 * (i - nA) <= k; i++)\n\t\t\t\tfor(int j = nB; j <= b && 50 * (i - nA) + 100 * (j - nB) <= k; j++)\n\t\t\t\t\tif(i != nA || j != nB)\n\t\t\t\t\t\tresolve(i, j, boat, mask, choose[a - nA][i - nA] * choose[b - nB][j - nB] % MOD);\n\t\t}\n\t}\n\tstatic void resolve(int i, int j, int boat, int mask, long edgeWays) {\n\t\tint newMask = 1000000 * (1 - boat) + i * 100 + j;\n\t\tint newD = ways.get(mask).d + 1;\n\t\tif(!ways.containsKey(newMask)) {\n\t\t\tways.put(newMask, new Pair(newD, 0));\n\t\t\tq.add(newMask);\n\t\t}\n\t\tif(ways.get(newMask).d == newD)\n\t\t\tways.get(newMask).w = (ways.get(newMask).w + ways.get(mask).w * edgeWays % MOD) % MOD;\n\t}\n\tstatic void fillChoose() {\n\t\tfor(int i = 0; i < 100; i++)\n\t\t\tchoose[i][0] = 1;\n\t\tfor(int i = 1; i < 100; i++)\n\t\t\tfor(int j = 1; j <= i; j++)\n\t\t\t\tchoose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD;\n\t}\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <unordered_map>\n#include <algorithm>\nusing namespace std;\n\nconst long long MOD = 1000000007;\n\nstruct Pair {\n    int d;\n    long long w;\n    Pair(int D, long long W) : d(D), w(W) {}\n};\n\nint n, k, a = 0, b = 0;\nlong long choose[100][100];\nqueue<int> q;\nunordered_map<int, Pair> ways;\n\nvoid fillChoose() {\n    for (int i = 0; i < 100; i++)\n        choose[i][0] = 1;\n    for (int i = 1; i < 100; i++)\n        for (int j = 1; j <= i; j++)\n            choose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD;\n}\n\nvoid resolve(int i, int j, int boat, int mask, long long edgeWays) {\n    int newMask = 1000000 * (1 - boat) + i * 100 + j;\n    int newD = ways[mask].d + 1;\n    if (ways.find(newMask) == ways.end()) {\n        ways[newMask] = Pair(newD, 0);\n        q.push(newMask);\n    }\n    if (ways[newMask].d == newD) {\n        ways[newMask].w = (ways[newMask].w + ways[mask].w * edgeWays % MOD) % MOD;\n    }\n}\n\nvoid bfs(int mask) {\n    int boat = mask / 1000000;\n    int nA = (mask % 1000000) / 100;\n    int nB = mask % 100;\n    if (boat > 0) {\n        for (int i = nA; i >= 0 && 50 * (nA - i) <= k; i--) {\n            for (int j = nB; j >= 0 && 50 * (nA - i) + 100 * (nB - j) <= k; j--) {\n                if (i != nA || j != nB) {\n                    long long edgeWays = (choose[nA][i] * choose[nB][j]) % MOD;\n                    resolve(i, j, boat, mask, edgeWays);\n                }\n            }\n        }\n    } else {\n        for (int i = nA; i <= a && 50 * (i - nA) <= k; i++) {\n            for (int j = nB; j <= b && 50 * (i - nA) + 100 * (j - nB) <= k; j++) {\n                if (i != nA || j != nB) {\n                    long long edgeWays = (choose[a - nA][i - nA] * choose[b - nB][j - nB]) % MOD;\n                    resolve(i, j, boat, mask, edgeWays);\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    cin >> n >> k;\n    for (int i = 0; i < n; i++) {\n        int x;\n        cin >> x;\n        if (x == 50)\n            a++;\n        else\n            b++;\n    }\n    \n    fillChoose();\n    int startMask = 1000000 + 100 * a + b;\n    q.push(startMask);\n    ways[startMask] = Pair(0, 1);\n    \n    while (!q.empty()) {\n        bfs(q.front());\n        q.pop();\n    }\n    \n    if (ways.find(0) != ways.end()) {\n        cout << ways[0].d << \"\\n\" << ways[0].w << endl;\n    } else {\n        cout << \"-1\\n0\" << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015877417172305286, -4.529