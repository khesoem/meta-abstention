   }\n\n    static void pushFlow() {\n        int size = N;\n        d = new long[size];\n        p = new int[size];\n        pe = new int[size];\n        inq = new int[size];\n\n        Arrays.fill(d, INF64);\n        Arrays.fill(p, -1);\n        Arrays.fill(pe, -1);\n        Arrays.fill(inq, 0);\n\n        d[s] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        inq[s] = 1;\n\n        while (!q.isEmpty()) {\n            int k = q.poll();\n            inq[k] = 0;\n            for (int x : g.get(k)) {\n                if (rem(x) == 0) continue;\n                int c = e.get(x).cost;\n                int y = e.get(x).y;\n                if (d[y] > d[k] + c) {\n                    d[y] = d[k] + c;\n                    p[y] = k;\n                    pe[y] = x;\n                    if (inq[y] == 0) {\n                        inq[y] = 1;\n                        q.offer(y);\n                    }\n                }\n            }\n        }\n        int cur = t;\n        while (cur != s) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = p[cur];\n        }\n        ans += d[t];\n    }\n\n    static void addEdge(int x, int y, int c, int cost) {\n        g.get(x).add(e.size());\n        e.add(new Edge(y, c, 0, cost));\n        g.get(y).add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        for (int i = 0; i < N; i++) {\n            g.add(new ArrayList<>());\n        }\n\n        s = N - 2;\n        t = N - 1;\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            addEdge(s, x, 1, 0);\n        }\n\n        int tt = 101;\n        for (int i = 0; i < tt; i++) {\n            addEdge(i * n, t, k, i * c);\n