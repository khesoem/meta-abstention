val = modpow(val, p);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    int n, k;\n    cin >> n >> k;\n    vector<ll> arr(10, 0);\n    for (int i = 0; i < k; ++i) {\n        int d;\n        cin >> d;\n        arr[d] = 1;\n    }\n    // initialize roots\n    warr[0] = 1;\n    winvarr[0] = 1;\n    for (int i = 1; i < SZ; ++i) {\n        warr[i] = warr[i - 1] * W % MOD;\n        winvarr[i] = winvarr[i - 1] * W % MOD;\n    }\n    vector<ll> x = fft(arr);\n    pow_vec(x, n / 2);\n    Vector v(x);\n    x = v.FFT1();\n    ll ans = 0;\n    for (auto& val : x) {\n        ans = (ans + val * val) % MOD;\n    }\n    cout << ans << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.10273090749979019, -2.455681169521995e-05, 0.0, -2.3841855067985307e-07, -0.0003782987187150866, -5.054346183896996e-05, -1.1920928244535389e-07, -7.497983460780233e-05, -8.940656698541716e-06, 0.0, 0.0, -1.1920928244535389e-07, -0.0019298041006550193, -0.0031794970855116844, -1.1920928244535389e-07, -0.10104923695325851, -0.25202539563179016, -0.25197526812553406, -4.4225667807040736e-05, 0.0, -0.38688576221466064, -0.47408783435821533, 0.0, -7.867782187531702e-06, 0.0, 0.0, -0.07892246544361115, -2.3841830625315197e-06, -4.756337511935271e-05, -0.00012337400403339416, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.011053637601435184, -2.3841855067985307e-07, -2.753696753643453e-05, -1.9073468138230965e-06, -1.9073468138230965e-06, 0.0, 0.0, -0.00013958434283267707, -7.879423355916515e-05, -0.00043156370520591736, -1.0728830375228426e-06, -9.536738616588991e-07, 0.0, -2.1457441107486375e-05, -7.152555099310121e-07, -0.006715585943311453, -1.1920928244535389e-07, 0.0, -0.001763218897394836, -0.0001971527235582471, -7.83174327807501e-05, -0.0031856761779636145, -2.3841855067985307e-07, -4.6491513785440475e-06, 0.0, -1.1920928244535389e-07, -5.602820692729438e-06, -5.125986263010418e-06, -4.768370445