;\n            ++len;\n        }\n        ret = pow_mod(p, (p - 1) / len, MOD);\n    }\n    printf(\"%lld\\n\", ret);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\n\npublic class Main {\n    private static final long MOD = 1000000007L;\n\n    private static long read() throws IOException {\n        int ch = System.in.read();\n        long x = 0, f = 1;\n        while (ch < '0' || ch > '9') {\n            if (ch == '-') f = -1;\n            ch = System.in.read();\n        }\n        x = ch - '0';\n        while (true) {\n            ch = System.in.read();\n            if (ch < '0' || ch > '9') break;\n            x = x * 10 + (ch - '0');\n        }\n        return x * f;\n    }\n\n    private static long mul_mod(long a, long b, long m) {\n        long ans = 0;\n        while (b != 0) {\n            if ((b & 1) == 1) ans = (ans + a) % m;\n            b >>= 1;\n            a = (a + a) % m;\n        }\n        return ans;\n    }\n\n    private static long pow_mod(long a, long b, long m) {\n        if (b == 0) return 1 % m;\n        if ((b & 1) == 1) return mul_mod(a, pow_mod(a, b - 1, m), m);\n        long half = pow_mod(a, b >> 1, m);\n        return mul_mod(half, half, m);\n    }\n\n    public static void main(String[] args) throws IOException {\n        long p = read();\n        long k = read();\n        long ret;\n        if (k == 0) {\n            ret = pow_mod(p, p - 1, MOD);\n        } else if (k == 1) {\n            ret = pow_mod(p, p, MOD);\n        } else {\n            long len = 1;\n            long cur = k;\n            while (cur != 1) {\n                cur = (cur * k) % p;\n                ++len;\n            }\n            ret = pow_mod(p, (p - 1) / len, MOD);\n        }\n        System.out.println(ret);\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-2.38418