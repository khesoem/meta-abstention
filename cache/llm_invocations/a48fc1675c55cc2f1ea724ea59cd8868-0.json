(ans-solve(0,n)+p)%p;\n\t}\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef fpow(a, b, p):\n    ans = 1\n    t = a % p\n    while b:\n        if b & 1:\n            ans = (ans * t) % p\n        t = (t * t) % p\n        b >>= 1\n    return ans\n\ndef lowbit(x):\n    return x & (-x)\n\ndef main():\n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    \n    ans = 1\n    for i in range(1, n + 1):\n        ans = (ans * k) % p\n    \n    if n % 2 == 0:\n        # Initialize factorials and inverse factorials\n        fac = [0] * (n + 1)\n        inv = [0] * (n + 1)\n        fac[0] = 1\n        for i in range(1, n + 1):\n            fac[i] = (fac[i - 1] * i) % p\n        \n        inv[n] = fpow(fac[n], p - 2, p)\n        for i in range(n, 0, -1):\n            inv[i - 1] = (inv[i] * i) % p\n        \n        # Initialize memoization table\n        # f[cur][S] where cur up to 26 and S up to 250010\n        # We'll use a dictionary for sparse storage\n        f = {}\n        \n        def solve(cur, S):\n            if (cur, S) in f:\n                return f[(cur, S)]\n            \n            if S == 0:\n                res = fac[n]\n                for i in range(1, cur + 1):\n                    res = (res * (k - i + 1)) % p\n                f[(cur, S)] = res\n                return res\n            \n            res = 0\n            U = S - lowbit(S)\n            T = U\n            while T:\n                res = (res + (inv[S - T] * solve(cur + 1, T)) % p) % p\n                T = (T - 1) & U\n            \n            res = (res + (inv[S] * solve(cur + 1, 0)) % p) % p\n            f[(cur, S)] = res\n            return res\n        \n        # Initialize f with -1 equivalent using dictionary\n        # We'll just use the solve function with memoization\n        ans = (ans - solve(0, n) + p) % p\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016425691137555987, -9.536738616588991e-07, -2.3841855067985307e-07, -0.02653740905225277, -8.49926145747304e-05, -0.12694716453552246, -0.0012406755704432726, -0.18789160251617432, -1.9073468138230965e-06, -2.145764938177308e-06, -6.318072337307967e-06, -4.768370445162873e-07, -0.00033766290289349854, -0.3875097930431366, -5.8412379075889476e-06, -1.311301275563892e-06, -1.4543427823809907e-05, -7.152555099310121e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.5759427547454834, 0.0, -1.311301275563892e-06, -1.6331539882230572e-05, -2.264974000354414e-06, 0.0, -0.005935898050665855, 0.0, -2.3841855067985307e-07, -6.437280717364047e-06, -3.3378546504536644e-06, 0.0, 0.0, -3.576278118089249e-07, -1.4305104514278355e-06, -4.529942543740617e-06, 0.0, -0.0013321106089279056, -0.000502817565575242, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, -4.768370445162873e-07, -1.7404405298293568e-05, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -9.536738616588991e-07, -1.1920928244535389e-07, -7.033323527139146e-06, 0.0, -2.3841855067985307e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -4.887569048150908e-06, -1.7881377516459906e-06, -7.152555099310121e-07, -8.237022848334163e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.145764938177308e-06, -4.768370445162873e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -0.02054879069328308, -2.622600959512056e-06, -4.410734163684538e-06, -0.0052179815247654915, -0.9587913751602173, -2.7418097943154862e-06, -1.311301275563892e-06, -0.43781334161758423, -1.311301275563892e-06, -0.0146036297082901, -1.4424220353248529e-05, -0.22610698640346