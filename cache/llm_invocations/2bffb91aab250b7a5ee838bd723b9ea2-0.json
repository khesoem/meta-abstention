 {\n        Scanner scanner = new Scanner(System.in);\n        String[] input = scanner.nextLine().split(\" \");\n        int n = Integer.parseInt(input[0]);\n        int m = Integer.parseInt(input[1]);\n        String[] lStr = scanner.nextLine().split(\" \");\n        int[] l = new int[lStr.length];\n        for (int i = 0; i < lStr.length; i++) {\n            l[i] = Integer.parseInt(lStr[i]);\n        }\n        int[] first = Arrays.copyOfRange(l, 0, n / 2);\n        int[] sec = Arrays.copyOfRange(l, n / 2, l.length);\n        int n1 = n / 2;\n        int n2 = n / 2 + (n % 2);\n        int t1 = (1 << n1);\n        int t2 = (1 << n2);\n        int[] s1 = new int[t1];\n        for (int i = 0; i < t1; i++) {\n            int now = 0;\n            for (int j = 0; j < first.length; j++) {\n                if ((i & (1 << j)) != 0) {\n                    now += first[j];\n                }\n            }\n            s1[i] = now % m;\n        }\n        int[] s2 = new int[t2];\n        for (int i = 0; i < t2; i++) {\n            int now = 0;\n            for (int j = 0; j < sec.length; j++) {\n                if ((i & (1 << j)) != 0) {\n                    now += sec[j];\n                }\n            }\n            s2[i] = now % m;\n        }\n        Arrays.sort(s1);\n        Arrays.sort(s2);\n        int maxi = 0;\n        int[] s2Copy = s2.clone();\n        Arrays.sort(s2Copy);\n        Arrays.reverse(s2Copy);\n        for (int i = 0; i < s1.length; i++) {\n            int req = m - s1[i];\n            int pair = binarySearch(s2Copy, req);\n            maxi = Math.max(maxi, (s1[i] + pair) % m);\n        }\n        System.out.println(maxi);\n    }\n\n    public static int binarySearch(int[] arr, int target) {\n        int lo = 0;\n        int hi = arr.length - 1;\n        int ans = 0;\n        while (lo <= hi) {\n            int mi = (lo + hi) / 2;\n            if (arr[mi] < target) {\n                ans = arr[mi];\n                lo = mi + 1;\n            } else {\n                hi = mi - 1;\n            }\n        }\n        return ans;\n    }\n}\n```\n\n<confidence>0.95</confidence>", "token_logprobs": [-5.0424259825376794e-05, -0.31383639574050903, -0.78420090675354, -0.0003859252028632909, -6.318072337307967e-06, -5.006777428206988e-06, -0.0001711698860162869, -0.04576170817017555, -0.06994334608316422, -0.013172038830816746, -2.861018856492592e-06, -0.03115721605718136, -0.2021225094795227, -0.013749883510172367, -0.040320005267858505, -9.536738616588991e-07, -0.015346069820225239, -0.000144709600135684, -3.6000557884108275e-05, -9.345571743324399e-05, -2.5629668016335927e-05, -0.00029845553217455745, -0.000392598332837224, -0.0003067976504098624, -0.010145522654056549, -0.05747940018773079, -1.597391747054644e-05, -3.6954811548639555e-06, -9.775113539944869e-06, -1.6212332411669195e-05, -1.0013530300057027e-05, -0.06197209656238556, -0.012566196732223034, -0.653548538684845, -0.00898827612400055, -0.507077693939209, -0.09639853239059448, -0.00013469743134919554, -0.006726953200995922, -7.986990567587782e-06, -0.004138002637773752, -0.08167801797389984, -0.001013718661852181, -4.732496745418757e-05, -0.0009723940747790039, -0.0023553031496703625, -0.00021550717065110803, -0.00012396997772157192, -9.643566590966657e-05, -7.271740287251305e-06, -1.5497195136049413e-06, -3.3378546504536644e-06, -0.005590873770415783, -3.2186455882765586e-06, -0.00042965717148035765, -0.00015793983766343445, -4.172316494077677e-06, -5.483612312673358e-06, -2.753696753643453e-05, -8.4638240878121e-06, -5.960462772236497e-07, -9.536738616588991e-07, -0.16032220423221588, -0.009775033220648766, -0.3578430414199829, -0.20941032469272614, -0.7436044812202454, -0.39399152994155884, -0.0012898467248305678, -0.00047743841423653066, -0.00024089295766316354, -7.152555099310121e-07, -2.2053474822314456e-05, -3.0517112463712692e-05, -8.511180931236595e-05, -2.396077979938127e-05, -0.007760967127978802, -0.015275631099939346, -0.005229603033512831, -0