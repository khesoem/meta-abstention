erse\n        def extended_gcd(a, b):\n            if a == 0:\n                return b, 0, 1\n            gcd, x1, y1 = extended_gcd(b % a, a)\n            x = y1 - (b // a) * x1\n            y = x1\n            return gcd, x, y\n        \n        _, x, _ = extended_gcd(a % mod, mod)\n        return (x % mod + mod) % mod\n\n    @staticmethod\n    def initialize():\n        FFT.MOD = 998244353\n        FFT.N = 1 << 20\n        FFT.PRIMITIVE_ROOT = 646\n        \n        # Calculate W and W_INV arrays\n        FFT.W[0] = 1\n        FFT.W_INV[0] = 1\n        for i in range(1, FFT.N):\n            FFT.W[i] = (FFT.W[i-1] * FFT.PRIMITIVE_ROOT) % FFT.MOD\n            FFT.W_INV[i] = (FFT.W_INV[i-1] * FFT.PRIMITIVE_ROOT) % FFT.MOD\n        \n        # Calculate N_INV\n        FFT.N_INV = FFT.mod_inverse(FFT.N, FFT.MOD)\n\n    class Coefficients:\n        def __init__(self, input_list):\n            self.data = [0] * FFT.N\n            for i in range(len(input_list)):\n                self.data[i] = input_list[i]\n\n        def evaluate(self, forward):\n            return self.recursive_transform(0, 1, forward)\n\n        def recursive_transform(self, start, step, forward):\n            if step == FFT.N:\n                return [self.data[start]]\n            \n            even = self.recursive_transform(start, step << 1, forward)\n            odd = self.recursive_transform(start + step, step << 1, forward)\n            \n            half = len(even)\n            result = [0] * (half << 1)\n            \n            for i in range(half):\n                w_index = i * step\n                w = FFT.W[w_index] if forward else FFT.W_INV[w_index]\n                result[i] = (even[i] + w * odd[i]) % FFT.MOD\n            \n            for i in range(half):\n                w_index = i * step\n                w = FFT.W[w_index] if forward else FFT.W_INV[w_index]\n                result[half + i] = ((even[i] - w * odd[i]) % FFT.MOD + FFT.MOD) % FFT.MOD\n            \n            return result\n\n    def direct_dft(self, input_list):\n        output = [0] * FFT.N\n        w_power = 1\n        for i in range(FFT.N):\n            x = 1\n            for j in range(len(input_list)):\n                output[i] = (output[i] + input_list[j] * x) % FFT.MOD\n                x = (x * w_power) % FFT.MOD\n            w_power = (w_power * FFT.PRIMITIVE_ROOT) % FFT.MOD\n        return output\n\n    def raise_to_power(self, arr, exponent):\n        for i in range(len(arr)):\n            arr[i] = self.fast_pow(arr[i], exponent)\n        return arr\n\n    def fast_pow(self, base, exp):\n        if exp == 0:\n            return 1\n        if exp & 1:\n            return (self.fast_pow(base, exp - 1) * base) % FFT.MOD\n        half = self.fast_pow(base, exp >> 1)\n        return (half * half) % FFT.MOD\n\n    def compute(self):\n        n, k = map(int, sys.stdin.readline().split())\n        coeffs = [0] * 10\n        for _ in range(k):\n            idx = int(sys.stdin.readline())\n            coeffs[idx] = 1\n        \n        transformed = self.direct_dft(coeffs)\n        transformed = self.raise_to_power(transformed, n // 2)\n        buffer = self.Coefficients(transformed)\n        transformed = buffer.evaluate(False)\n        \n        for i in range(len(transformed)):\n            transformed[i] = (transformed[i] * FFT.N_INV) % FFT.MOD\n        \n        answer = 0\n        for value in transformed:\n            answer = (answer + value * value) % FFT.MOD\n        \n        print(answer)\n\n    def setup(self):\n        # Initialize static arrays\n        self.initialize()\n        self.compute()\n\nif __name__ == \"__main__\":\n    fft = FFT()\n    fft.setup()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00012265883560758084, -9.536738616588991e-07, -1.1920928244535389e-07, -0.00015198028995655477, -0.007737900596112013, -4.887569048150908e-06, -0.06256721913814545, -0.023219823837280273, -0.6326057314872742, -0.53790247440