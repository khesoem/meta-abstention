ate(boolean forward) {\n            return recursiveTransform(0, 1, forward);\n        }\n\n        private long[] recursiveTransform(int start, int step, boolean forward) {\n            if (step == N) {\n                return new long[]{data[start]};\n            }\n            long[] even = recursiveTransform(start, step << 1, forward);\n            long[] odd = recursiveTransform(start + step, step << 1, forward);\n            int half = even.length;\n            long[] result = new long[half << 1];\n            for (int i = 0; i < half; i++) {\n                long w = forward ? W[i * step] : W_INV[i * step];\n                result[i] = (even[i] + w * odd[i]) % MOD;\n            }\n            for (int i = 0; i < half; i++) {\n                long w = forward ? W[i * step] : W_INV[i * step];\n                result[half + i] = ((even[i] - w * odd[i]) % MOD + MOD) % MOD;\n            }\n            return result;\n        }\n    }\n\n    long[] directDFT(long[] input) {\n        long[] output = new long[N];\n        long wPower = 1;\n        for (int i = 0; i < N; i++) {\n            long x = 1;\n            for (int j = 0; j < input.length; j++) {\n                output[i] = (output[i] + input[j] * x) % MOD;\n                x = x * wPower % MOD;\n            }\n            wPower = wPower * PRIMITIVE_ROOT % MOD;\n        }\n        return output;\n    }\n\n    long[] raiseToPower(long[] arr, int exponent) {\n        for (int i = 0; i < arr.length; i++) {\n            arr[i] = fastPow(arr[i], exponent);\n        }\n        return arr;\n    }\n\n    long fastPow(long base, int exp) {\n        if (exp == 0) return 1;\n        if ((exp & 1) == 1) return fastPow(base, exp - 1) * base % MOD;\n        long half = fastPow(base, exp >> 1);\n        return half * half % MOD;\n    }\n\n    void compute() {\n        int n = readInt();\n        int k = readInt();\n        long[] coeffs = new long[10];\n        for (int i = 0; i < k; i++) {\n            coeffs[readInt()] 