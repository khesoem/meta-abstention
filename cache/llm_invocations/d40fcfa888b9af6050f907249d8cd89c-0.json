.Entry<Pair, Long> entry : mm.entrySet()) {\n                long sum = entry.getKey().first;\n                int cnt = entry.getKey().second;\n                long ncnt = entry.getValue();\n                int ast = n / 2 - cnt;\n                int bst = i + 1 - ast;\n                long asum = sum + rsc2[ast - 1] * rsc[bst];\n                long bsum = sum - rsc2[bst - 1] * rsc[ast];\n                char ch = s.charAt(i);\n                if (ch == 'A') {\n                    Pair key1 = new Pair(asum, cnt + 1);\n                    nm.put(key1, nm.getOrDefault(key1, 0L) + ncnt);\n                    Pair key2 = new Pair(bsum, cnt);\n                    nm.put(key2, nm.getOrDefault(key2, 0L) + 0);\n                } else if (ch == 'B') {\n                    Pair key1 = new Pair(asum, cnt + 1);\n                    nm.put(key1, nm.getOrDefault(key1, 0L) + 0);\n                    Pair key2 = new Pair(bsum, cnt);\n                    nm.put(key2, nm.getOrDefault(key2, 0L) + ncnt);\n                } else { // '?'\n                    Pair key1 = new Pair(asum, cnt + 1);\n                    nm.put(key1, nm.getOrDefault(key1, 0L) + ncnt);\n                    Pair key2 = new Pair(bsum, cnt);\n                    nm.put(key2, nm.getOrDefault(key2, 0L) + ncnt);\n                }\n            }\n            nsum = nsum - lsc[i];\n            mm.clear();\n            for (Map.Entry<Pair, Long> entry : nm.entrySet()) {\n                long sum = entry.getKey().first;\n                int cnt = entry.getKey().second;\n                long ncnt = entry.getValue();\n                int ast = n / 2 - cnt;\n                int bst = i - ast;\n                if (cnt > n / 2 || n - i - cnt > n / 2) continue;\n                if (sum < -msum - rsc[ast] * rsc[bst] || sum > msum + rsc[ast] * rsc[bst]) continue;\n                Pair key = new Pair(sum, cnt);\n                mm.put(key, mm.getOrDefault(key, 0L) + ncnt);\n            }\n        }\n        long bsum = Long.MAX_VALUE;\n        for (Map.Entry<Pair, Long> entry : mm.entrySet()) {\n            long sum = entry.getKey().first;\n            bsum = Math.min(bsum, Math.max(sum, -sum));\n        }\n        long rasp = 0;\n        for (Map.Entry<Pair, Long> entry : mm.entrySet()) {\n            long sum = entry.getKey().first;\n            long ncnt = entry.getValue();\n            int cnt = entry.getKey().second;\n            if (sum == bsum || sum == -bsum) {\n                int sem = 0;\n                for (int i = 0; i < 2 * r - 1; i++) {\n                    if (s.charAt(i) == '?') sem++;\n                    else if (s.charAt(i) == 'A') cnt++;\n                }\n                ncnt = ncnt * comb(sem, n / 2 - cnt);\n                rasp += ncnt;\n            }\n        }\n        System.out.println(rasp);\n    }\n\n    static class Pair {\n        long first;\n        int second;\n        Pair(long f, int s) { first = f; second = s; }\n        @Override\n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (!(o instanceof Pair)) return false;\n            Pair p = (Pair) o;\n            return first == p.first && second == p.second;\n        }\n        @Override\n        public int hashCode() {\n            return (int)(first ^ (first >>> 32)) * 31 + second;\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.537788011773955e-05, 0.0, 0.0, -2.4914430468925275e-05, -2.264974000354414e-06, -1.1920928244535389e-07, -0.00012385078298393637, -0.03900481387972832, -0.00034421717282384634, 0.0, -0.007369121536612511, -0.0015075758565217257, -0.0002653246629051864, -0.03396892175078392, -8.987976616481319e-05, -0.011361660435795784, -0.0019290901254862547, 0.0, -2.0265558760002023e-06, -5.960462772236497e-07, 0.0, -7.152555099310121e-07, -1.4305104514278355e-06, 0.0, -1.1920928244535389e-07, 0.0, -2.753696753643453e-05, -4.768370445162873e-07, -8.344646857949556e-07, 0.0, 0.0, 0.0, 0.0