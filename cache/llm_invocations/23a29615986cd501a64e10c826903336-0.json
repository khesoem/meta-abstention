ont(); q.pop();\n            vis[x] = 0;\n            for (int i = 0; i < adj[x].size(); ++i) {\n                int y = adj[x][i];\n                int cc = dist[x] + edge_cost[x][i];\n                if (dist[y] > cc && edge_cap[x][i]) {\n                    dist[y] = cc;\n                    prex[y] = x;\n                    prei[y] = i;\n                    if (!vis[y]) {\n                        vis[y] = 1;\n                        q.push(y);\n                    }\n                }\n            }\n        }\n    }\n    \n    int tot = 0;\n    \n    int dfs(int x, int flow) {\n        if (prex[x] == -1) return flow;\n        int y = x;\n        x = prex[y];\n        int i = prei[y];\n        int j = rev[x][i];\n        int f = dfs(x, min(flow, edge_cap[x][i]));\n        edge_cap[x][i] -= f;\n        edge_cap[y][j] += f;\n        return f;\n    }\n    \n    pii solve(int s, int t, int n) {\n        int ans = 0;\n        tot = 0;\n        while (true) {\n            spfa(s, n);\n            if (dist[t] > 1e9) break;\n            int f = dfs(t, INF);\n            tot += f * dist[t];\n            ans += f;\n        }\n        return {ans, tot};\n    }\n}\n\nint n, m, s, t;\nint k, c, d;\n\nint get(int x, int tim) {\n    return tim * 52 - 52 + x;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int kk = k;\n    \n    s = MAXN - 1;\n    t = MAXN - 2;\n    \n    while (k--) {\n        int x;\n        scanf(\"%d\", &x);\n        mcmf::add_edge(s, get(x, 1), 1, 0);\n    }\n    k = kk;\n    \n    while (m--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= k; ++j) {\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n            }\n        }\n        swap(x, y);\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= k; ++j) {\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n            }\n        }\n    }\n    \n    for (int i = 1; i < 100; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            mcmf::add_edge(get(j, i), get(j, i + 1), INF, 0);\n        }\n        mcmf::add_edge(get(1, i), t, INF, c * (i - 1));\n    }\n    \n    printf(\"%d\", mcmf::solve(s, t, MAXN).second);\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 100000000;\n    static final int MAXN = 6000;\n\n    static class MCMF {\n        List<List<Integer>> adj, rev;\n        List<List<Integer>> edge_cost, edge_cap;\n        int[] dist, vis;\n        int[] prex, prei;\n\n        MCMF(int n) {\n            adj = new ArrayList<>(n);\n            rev = new ArrayList<>(n);\n            edge_cost = new ArrayList<>(n);\n            edge_cap = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                adj.add(new ArrayList<>());\n                rev.add(new ArrayList<>());\n                edge_cost.add(new ArrayList<>());\n                edge_cap.add(new ArrayList<>());\n            }\n            dist = new int[n];\n            vis = new int[n];\n            prex = new int[n];\n            prei = new int[n];\n        }\n\n        void addEdge(int x, int y, int cap, int cost) {\n            rev.get(x).add(adj.get(y).size());\n            rev.get(y).add(adj.get(x).size());\n            adj.get(x).add(y);\n            adj.get(y).add(x);\n            edge_cost.get(x).add(cost);\n            edge_cost.get(y).add(-cost);\n            edge_cap.get(x).add(cap);\n            edge_cap.get(y).add(0);\n        }\n\n        void spfa(int s, int n) {\n            Arrays.fill(dist, 0x3f3f3f3f);\n            Arrays.fill(vis, 0);\n            prex[s] = -1;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            dist[s] = 0;\n            vis[s] = 1;\n\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                vis[x] = 0;\n                for (int i = 0; i < adj.get(x).size(); i++) {\n                    int y = adj.get(x).get(i);\n                    int cc = dist[x] + edge_cost.get(x).get(i);\n                    if (dist[y] > cc && edge_cap.get(x).get(i) > 0) {\n                        dist[y] = cc;\n                        prex[y] = x;\n                        prei[y] = i;\n                        if (vis[y] == 0) {\n                            vis[y] = 1;\n                            q.offer(y);\n                        }\n                    }\n                }\n            }\n        }\n\n        int tot = 0;\n\n        int dfs(int x, int flow) {\n            if (prex[x] == -1) return flow;\n            int y = x;\n            x = prex[y];\n            int i = prei[y];\n            int j = rev.get(x).get(i);\n            int f = dfs(x, Math.min(flow, edge_cap.get(x).get(i)));\n            edge_cap.get(x).set(i, edge_cap.get(x).get(i) - f);\n            edge_cap.get(y).set(j, edge_cap.get(y).get(j) + f);\n            return f;\n        }\n\n        int[] solve(int s, int t, int n) {\n            int ans = 0;\n            tot = 0;\n            while (true) {\n                spfa(s, n);\n                if (dist[t] > 1e9) break;\n                int f = dfs(t, INF);\n                tot += f * dist[t];\n                ans += f;\n            }\n            return new int[]{ans, tot};\n        }\n    }\n\n    static int get(int x, int tim) {\n        return tim * 52 - 52 + x;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int kk = k;\n\n        int s = MAXN - 1;\n        int t = MAXN - 2;\n\n        MCMF mcmf = new MCMF(MAXN);\n\n        while (k-- > 0) {\n            int x = sc.nextInt();\n            mcmf.addEdge(s, get(x, 1), 1, 0);\n        }\n        k = kk;\n\n        while (m-- > 0) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    mcmf.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n            int temp = x;\n            x = y;\n            y = temp;\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    mcmf.addEdge(get(x, i), get(y, i + 1), 1, d * (j + j - 1));\n                }\n            }\n        }\n\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= n; j++) {\n                mcmf.addEdge(get(j, i), get(j, i + 1), INF, 0);\n            }\n            mcmf.addEdge(get(1, i), t, INF, c * (i - 1));\n        }\n\n        int[] result = mcmf.solve(s, t, MAXN);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014757021563127637, -1.6689286894688848e-06, -7.152555099310121e-07, -0.0012681784573942423, -2.610649426060263e-05, -0.02054610475897789, -0.07005004584789276, -3.242440288886428e-05, -8.344646857949556e-07, -5.006664650863968e-05, -0.016035638749599457, -0.00012337400403339416, -0.11713220924139023, -0.07258160412311554, -1.8596476365928538e-05, -3.182837463100441e-05, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.264974000354414e-06, -1.1920928244535389e-07, 0.0, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -2.0265558760002023e-06, -1.9073468138230965e-06, -8.344646857949556e-07, -6.437280717364047e-06, -2.3841855067985307e-07, -9.417489309271332e-06, -2.7418097943154862e-06, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -6.556489552167477e-06, -0.2254147231578827, -1.1920922