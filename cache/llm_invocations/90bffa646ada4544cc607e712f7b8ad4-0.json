 = 1e18\n    aout = 0\n    bout = 1\n    b = 1\n    while b <= n:\n        a1 = (x * b) // y\n        a2 = (x * b + y - 1) // y\n        diff1 = abs(a1 / b - x / y)\n        diff2 = abs(a2 / b - x / y)\n        if diff1 < mn - EPS:\n            mn = diff1\n            aout = a1\n            bout = b\n        if diff2 < mn - EPS:\n            mn = diff2\n            aout = a2\n            bout = b\n        b += 1\n    print(f\"{aout}/{bout}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-7.152555099310121e-07, -2.3841855067985307e-07, 0.0, -2.884823152271565e-05, -0.00017009719158522785, -0.006715348921716213, -0.3143865466117859, -0.002513584913685918, -1.1920928244535389e-07, -2.3007127310847864e-05, -0.3175016939640045, -8.344646857949556e-07, 0.0, -4.768370445162873e-07, -3.576278118089249e-07, -1.7881377516459906e-06, -1.1920928244535389e-07, -0.0015043619787320495, -0.004197359550744295, -0.006720677483826876, -7.533743337262422e-05, -3.814689989667386e-06, -0.021247386932373047, 0.0, -0.00021479207498487085, 0.0, -0.0019286142196506262, -2.861018856492592e-06, -0.003177833277732134, -0.00033539868309162557, -1.1920928244535389e-07, -1.0728830375228426e-06, 0.0, -9.536738616588991e-07, -0.0019288521725684404, 0.0, -1.0132738680113107e-05, -2.3841855067985307e-07, -1.6689286894688848e-06, -9.536738616588991e-07, -1.1920928244535389e-07, -2.861018856492592e-06, -0.02975226752460003, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -4.887569048150908e-06, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -0.0072077009826898575, -1.1920928244535389e-07, -0.01821516454219818, -0.004078879952430725, -0.02291298471391201, -1.1920928244535389e-07, -0.38687101006507874, -7.152555099310121e-07, -3.6954811548639555e-06, -0.0007499027997255325, -4.565611743601039e-05, -1.1920928244535389e-07, -0.006722808815538883, -0.0009116546134464443, -0.003180091269314289, -0.03378315642476082, -1.0728830375228426e-