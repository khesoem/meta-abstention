lgo(b % a, a);\n    long long x = ans.y - (b / a) * ans.x;\n    long long y = ans.x;\n    return Triplet(ans.gcd, x, y);\n}\n\nlong long ModInverse(long long a, long long m) {\n    Triplet ans = ExtendedEuclideanAlgo(a, m);\n    if (ans.gcd != 1) {\n        return -1;\n    } else {\n        long long result = (ans.x % m + m) % m;\n        return result;\n    }\n}\n\nclass FastReader {\npublic:\n    string line;\n    int pos;\n    \n    FastReader() : pos(0) {}\n    \n    string next() {\n        while (pos == 0 || pos >= line.size()) {\n            if (!getline(cin, line)) return \"\";\n            pos = 0;\n        }\n        while (pos < line.size() && line[pos] == ' ') pos++;\n        int start = pos;\n        while (pos < line.size() && line[pos] != ' ') pos++;\n        return line.substr(start, pos - start);\n    }\n    \n    int nextInt() {\n        return stoi(next());\n    }\n    \n    long long nextLong() {\n        return stoll(next());\n    }\n};\n\nvoid solve() {\n    PreCompute();\n    FastReader s;\n    int n = s.nextInt();\n    long long k = s.nextLong();\n    \n    if (k == 0) {\n        cout << fact[n] << endl;\n        return;\n    }\n    if (n <= k) {\n        cout << 0 << endl;\n        return;\n    }\n    \n    long long ans = nCr(n, (int)k);\n    int cols = n - (int)k;\n    long long sum = 0;\n    \n    for (int i = 0; i <= cols; i++) {\n        long long tempans = nCr(cols, i);\n        tempans = (tempans * fast(cols - i, n)) % mod;\n        if ((i & 1) == 1) {\n            sum -= tempans;\n            if (sum < 0) sum += mod;\n        } else {\n            sum += tempans;\n            if (sum >= mod) sum -= mod;\n        }\n    }\n    \n    long long result = (2 * ((ans * sum) % mod)) % mod;\n    cout << result << endl;\n}\n\nint main() {\n    solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013100242358632386, -1.7881377516459906e-06, -9.536738616588991e-07, -0.00046135272714309394, 