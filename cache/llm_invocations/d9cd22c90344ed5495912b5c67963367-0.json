{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nconst int N = 14043;\nconst ll INF = (ll)1e18;\n\nstruct MinCostFlow {\n    struct Edge {\n        int to, cap, flow, cost;\n    };\n\n    int n;\n    vector<vector<int>> g;\n    vector<Edge> e;\n    vector<ll> dist;\n    vector<int> pv, pe, inq;\n    ll total;\n\n    MinCostFlow(int n) : n(n), g(n), dist(n), pv(n), pe(n), inq(n), total(0) {}\n\n    int residual(int id) const {\n        return e[id].cap - e[id].flow;\n    }\n\n    void addEdge(int u, int v, int cap, int cost) {\n        g[u].push_back((int)e.size());\n        e.push_back({v, cap, 0, cost});\n        g[v].push_back((int)e.size());\n        e.push_back({u, 0, 0, -cost});\n    }\n\n    void augment(int s, int t) {\n        fill(dist.begin(), dist.end(), INF);\n        fill(pv.begin(), pv.end(), -1);\n        fill(pe.begin(), pe.end(), -1);\n        fill(inq.begin(), inq.end(), 0);\n\n        queue<int> q;\n        dist[s] = 0;\n        q.push(s);\n        inq[s] = 1;\n\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n            inq[u] = 0;\n\n            for (int id : g[u]) {\n                if (residual(id) <= 0) continue;\n                int v = e[id].to;\n                if (dist[v] > dist[u] + e[id].cost) {\n                    dist[v] = dist[u] + e[id].cost;\n                    pv[v] = u;\n                    pe[v] = id;\n                    if (!inq[v]) {\n                        inq[v] = 1;\n                        q.push(v);\n                    }\n                }\n            }\n        }\n\n        int cur = t;\n        while (cur != s) {\n            int id = pe[cur];\n            e[id].flow++;\n            e[id ^ 1].flow--;\n            cur = pv[cur];\n        }\n\n        total += dist[t];\n    }\n\n    ll minCost(int s, int t, int flow) {\n        for (int i = 0; i < flow; i++) augment(s, t);\n        return total;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int S = N - 2;\n    const int T = N - 1;\n    MinCostFlow mf(N);\n\n    for (int i = 0; i < k; i++) {\n        int x;\n        cin >> x;\n        mf.addEdge(S, x, 1, 0);\n    }\n\n    int tt = 101;\n    for (int i = 0; i < tt; i++)\n        mf.addEdge(1 + i * n, T, k, i * c);\n\n    for (int i = 0; i < m; i++) {\n        int x, y;\n        cin >> x >> y;\n        for (int step = 0; step < tt - 1; step++) {\n            for (int j = 0; j < k; j++) {\n                mf.addEdge(x + step * n, y + step * n + n, 1, d * (j * 2 + 1));\n                mf.addEdge(y + step * n, x + step * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n    }\n\n    for (int city = 0; city < n; city++)\n        for (int step = 0; step < tt - 1; step++)\n            mf.addEdge(city + step * n, city + step * n + n, k, 0);\n\n    cout << mf.minCost(S, T, k) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass MinCostFlow:\n    def __init__(self, n):\n        self.n = n\n        self.g = [[] for _ in range(n)]\n        self.e = []  # list of edges: [to, cap, flow, cost]\n        self.dist = [0] * n\n        self.pv = [0] * n\n        self.pe = [0] * n\n        self.inq = [0] * n\n        self.total = 0\n\n    def residual(self, id):\n        return self.e[id][1] - self.e[id][2]\n\n    def addEdge(self, u, v, cap, cost):\n        self.g[u].append(len(self.e))\n        self.e.append([v, cap, 0, cost])\n        self.g[v].append(len(self.e))\n        self.e.append([u, 0, 0, -cost])\n\n    def augment(self, s, t):\n        INF = 10**18\n        self.dist = [INF] * self.n\n        self.pv = [-1] * self.n\n        self.pe = [-1] * self.n\n        self.inq = [0] * self.n\n\n        q = deque()\n        self.dist[s] = 0\n        q.append(s)\n        self.inq[s] = 1\n\n        while q:\n            u = q.popleft()\n            self.inq[u] = 0\n            for id in self.g[u]:\n                if self.residual(id) <= 0:\n                    continue\n                v = self.e[id][0]\n                if self.dist[v] > self.dist[u] + self.e[id][3]:\n                    self.dist[v] = self.dist[u] + self.e[id][3]\n                    self.pv[v] = u\n                    self.pe[v] = id\n                    if not self.inq[v]:\n                        self.inq[v] = 1\n                        q.append(v)\n\n        cur = t\n        while cur != s:\n            id = self.pe[cur]\n            self.e[id][2] += 1\n            self.e[id ^ 1][2] -= 1\n            cur = self.pv[cur]\n\n        self.total += self.dist[t]\n\n    def minCost(self, s, t, flow):\n        for _ in range(flow):\n            self.augment(s, t)\n        return self.total\n\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    tt = 101\n    nodes = n * tt + 2\n    S = nodes - 2\n    T = nodes - 1\n    mf = MinCostFlow(nodes)\n\n    for _ in range(k):\n        x = int(next(it))\n        mf.addEdge(S, x, 1, 0)\n\n    for i in range(tt):\n        mf.addEdge(1 + i * n, T, k, i * c)\n\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        for step in range(tt - 1):\n            for j in range(k):\n                mf.addEdge(x + step * n, y + step * n + n, 1, d * (j * 2 + 1))\n                mf.addEdge(y + step * n, x + step * n + n, 1, d * (j * 2 + 1))\n\n    for city in range(n):\n        for step in range(tt - 1):\n            mf.addEdge(city + step * n, city + step * n + n, k, 0)\n\n    print(mf.minCost(S, T, k))\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1324817933200393e-05, 0.0, 0.0, -0.00045849301386624575, -0.0237960834056139, -2.825220326485578e-05, -1.3708974620385561e-05, -1.3112935448589269e-05, -3.576278118089249e-07, 0.0, -1.6689286894688848e-06, -0.000436925794929266, -0.2027883678674698, -5.8887653722194955e-05, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.07902854681015015, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -8.344646857949556e-07, -0.0005631053354591131, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -0.000342191313393414, 0.0, -1.1920928244535389e-07, -0.0015036477707326412, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.1920922133867862e-06, 0.0, -3.576278118089249e-07, -0.061968062072992325, 0.0, -1.4305104514278355e-06, -0.018178759142756462, 0.0, -0.014164154417812824, -0.02490365505218506, -5.960462772236497e-07, -0.27438393235206604, -1.7881377516459906e-06, -0.3186047375202179, -0.10104427486658096, -0.17285773158073425, -7.152555099310121e-07, 0.0, -2.861018856492592e-06, 0.0, -6.9141146923357155e-06, 0.0, -2.3841855067985307e-07, -2.4318398573086597e-05, -1.19