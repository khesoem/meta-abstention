t i = head[u]; i; i = edges[i].nxt) {\n            int v = edges[i].to, c = edges[i].cost;\n            if (edges[i].cap > 0 && dist[v] > dist[u] + c) {\n                dist[v] = dist[u] + c;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return dist[t] != INF;\n}\n\nint dfs(int u, int flowLimit, bool vis[]) {\n    if (u == t) return flowLimit;\n    vis[u] = true;\n    int pushed = 0, total = flowLimit;\n\n    for (int i = head[u]; i; i = edges[i].nxt) {\n        int v = edges[i].to, cap = edges[i].cap;\n        if (vis[v] || cap == 0 || dist[v] != dist[u] + edges[i].cost) continue;\n\n        int f = dfs(v, min(total, cap), vis);\n        if (f > 0) {\n            total -= f;\n            edges[i].cap -= f;\n            edges[i ^ 1].cap += f;\n            pushed += f;\n            if (total == 0) break;\n        }\n    }\n    return pushed;\n}\n\nint minCostMaxFlow() {\n    int totalFlow = 0, totalCost = 0;\n    while (spfa()) {\n        bool vis[MAXN] = {false};\n        int flow = dfs(s, INF, vis);\n        if (flow > 0) {\n            totalFlow += flow;\n            totalCost += flow * dist[t];\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    read(n), read(m), read(k), read(v1), read(v2);\n    t = idx(n, 110, n) + 1;\n\n    for (int i = 2; i <= 110; ++i)\n        addEdge(idx(1, i, n), t, INF, 0);\n\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 110; ++j)\n            addEdge(idx(i, j, n), idx(i, j + 1, n), INF, v1);\n\n    for (int i = 1, x; i <= k; ++i) {\n        read(x);\n        addEdge(s, idx(x, 1, n), 1, 0);\n    }\n\n    for (int i = 1; i <= m; ++i) {\n        int x, y;\n        read(x), read(y);\n        for (int j = 1; j < 110; ++j)\n            for (int l = 1; l <= k; ++l) {\n                int cost = v2 * (2 * l - 1) + v1;\n                addEdge(idx(x, j, n), idx(y, j + 1, n), 1, cost);\n            