ng long ans = 0;\n    if (k == 0) {\n        ans = opow(p, p - 1, mod);\n    } else {\n        for (long long i = 1; i < p; i++) {\n            if ((p - 1) % i == 0 && opow(k, i, p) == 1) {\n                ans = opow(p, (p - 1) / i, mod);\n                if (k == 1) {\n                    ans = (ans * p) % mod;\n                }\n                break;\n            }\n        }\n    }\n    cout << ans << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.199982064776123e-05, -2.9802276912960224e-06, -3.576278118089249e-07, -2.396077979938127e-05, -3.576278118089249e-07, -5.8412379075889476e-06, -2.3841830625315197e-06, -0.16023364663124084, -2.145764938177308e-06, -0.651244044303894, -0.11282447725534439, -0.000949885172303766, -5.125986263010418e-06, -2.9802276912960224e-06, -7.152555099310121e-07, -0.0009147512027993798, -2.3841830625315197e-06, -0.06708945333957672, -5.960462772236497e-07, -1.3232143828645349e-05, -3.814689989667386e-06, -2.622600959512056e-06, 0.0, -3.933898824470816e-06, -4.637133679352701e-05, 0.0, 0.0, -0.0031808041967451572, -9.536738616588991e-07, -3.576278118089249e-07, -4.172316494077677e-06, -4.768370445162873e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -5.960462772236497e-07, -8.702239938429557e-06, 0.0, 0.0, 0.0, -8.583032467868179e-06, -3.516612196108326e-05, -6.9141146923357155e-06, -1.5020257706055418e-05, 0.0, -0.02630288526415825, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, -6.05564855504781e-05, -1.1920928244535389e-07, -2.622600959512056e-06, -1.0371154530730564e-05, 0.0, -1.6927575416048057e-05, -5.125986263010418e-06, -1.0728830375228426e-06, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, -3.576278118089249e-07, -4.768370445162873e-07, -5.960462772236497e-07, -1.311301275563892e-06, -1.4424220353248529e-05, 0.0, 0.0, -1.7881377516459906e-06, -2.3841855067985307e