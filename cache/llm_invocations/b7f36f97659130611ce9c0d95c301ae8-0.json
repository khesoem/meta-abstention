en(\"out.out\", \"w\", stdout);\n#endif // ONLINE_JUDGE\n\n\tscanf(\"%d\",&n);\n    int r100 = power(100, mod-2, mod);\n    for(int i=0; i<n; i++) {\n        for(int j=0; j<n; j++) {\n            scanf(\"%d\", p[i]+j);\n            p[i][j] = (INT)p[i][j] * r100 % mod;\n        }\n    }\n    for(int i=0; i<n; i++) {\n        for(int j=0; j<1<<n; j++) {\n            pro[i][j] = 1;\n            for(int k=0; k<n; k++) if((j>>k)&1) {\n                pro[i][j] = (INT)pro[i][j] * p[i][k] % mod;\n            } else pro[i][j] = (INT)pro[i][j] * (mod+1-p[i][k]) % mod;\n        }\n    }\n\n    for(int i=0; i<1<<n; i++) bpt[i] = __builtin_popcount(i);\n    for(int i=0; i<1<<n; i++) vec[bpt[i]].pb(i), id[i] = vec[bpt[i]].size() - 1;\n\tfor(int i=0; i<1<<n; i++) {\n        for(int j=0; j<n; j++) if(not ((i>>j)&1)) q[i][1<<j] = 1LL<<id[i|(1<<j)];\n        for(int j=0; j<1<<n; j++) q[i][j] = q[i][j&-j] | q[i][j ^ (j&-j)];\n\t}\n\tcout << calc(0, 1) << endl;\n}\n\n                      \n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\n\ndef power(a, n, mod, ans=1):\n    while n:\n        if n & 1:\n            ans = (ans * a) % mod\n        a = (a * a) % mod\n        n >>= 1\n    return ans\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    idx = 0\n    n = int(data[idx]); idx += 1\n    r100 = power(100, MOD-2, MOD)\n    p = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            p[i][j] = int(data[idx]); idx += 1\n            p[i][j] = (p[i][j] * r100) % MOD\n\n    pro = [[1]*(1<<n) for _ in range(n)]\n    for i in range(n):\n        for j in range(1<<n):\n            for k in range(n):\n                if (j >> k) & 1:\n                    pro[i][j] = (pro[i][j] * p[i][k]) % MOD\n                else:\n                    pro[i][j] = (pro[i][j] * (MOD + 1 - p[i][k])) % MOD\n\n    bpt = [0]*(1<<n)\n    for i in range(1<<n):\n        bpt[i] = bin(i).count('1')\n    \n    vec = [[] for _ in range(n+1)]\n    id = [0]*(1<<n)\n    for i in range(1<<n):\n        vec[bpt[i]].append(i)\n        id[i] = len(vec[bpt[i]]) - 1\n\n    q = [[0]*(1<<n) for _ in range(1<<n)]\n    for i in range(1<<n):\n        for j in range(n):\n            if not ((i >> j) & 1):\n                q[i][1<<j] = 1 << id[i | (1<<j)]\n        for j in range(1<<n):\n            q[i][j] = q[i][j & -j] | q[i][j ^ (j & -j)]\n\n    mp = {}\n    def calc(now, st):\n        if st == 0:\n            return 0\n        if now == n:\n            return 1\n        key = (now, st)\n        if key in mp:\n            return mp[key]\n        ans = 0\n        for j in range(1, 1<<n):\n            nst = 0\n            k = 0\n            while k < len(vec[now]):\n                if not ((st >> k) & 1):\n                    k += 1\n                    continue\n                cur = vec[now][k]\n                nxt = j - (j & cur)\n                nst |= q[cur][nxt]\n                k += 1\n            ans = (ans + pro[now][j] * calc(now+1, nst)) % MOD\n        mp[key] = ans\n        return ans\n\n    result = calc(0, 1)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.1815062e-05, 0.0, -1.072883e-06, -0.0007865911, -0.29550785, -6.425174e-05, -0.693417, -0.50314915, -1.5104377, -3.576278e-07, -0.0011041027, -0.018370956, -0.20648818, -8.344647e-07, -0.0019313508, -3.0490046, -1.072883e-06, -5.960463e-07, -0.00014935808, -0.03915568, -0.00037114884, -0.0061192065, -0.0009522671, -0.0011737607, -1.6689287e-06, -0.01418296, -0.0009247556, -0.87645984, -2.384183e-06, -7.867782e-06, -1.1920922e-06, -9.1790735e-06, -2.503392e-06, -0.0015969631, -1.1920928e-07, -0.008628822, 0.0, -0.00016068121, -4.7683704e-07, -6.4372807e-06, 0.0, -1.1920928e