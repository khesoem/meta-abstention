;\n        List<Integer> a2 = new ArrayList<>();\n        int n1 = n / 2;\n        \n        sums1(a, a1, 0, 0, n1, m);\n        sums2(a, a2, n1, 0, n, m);\n        \n        int ans = 0;\n        Collections.sort(a1);\n        a1 = new ArrayList<>(new HashSet<>(a1)); // Remove duplicates and sort\n        \n        for (int i : a2) {\n            int target = (m - i) % m;\n            int j = Collections.binarySearch(a1, target);\n            if (j < 0) {\n                j = -j - 1;\n            }\n            if (j > 0) {\n                int candidate = a1.get(j - 1) + i;\n                if (ans < candidate) {\n                    ans = candidate;\n                }\n            }\n        }\n        \n        System.out.println(ans);\n    }\n    \n    private static void sums1(int[] a, List<Integer> result, int i, int sum, int n1, int m) {\n        if (i == n1) {\n            result.add(sum % m);\n        } else {\n            sums1(a, result, i + 1, (sum + a[i]) % m, n1, m);\n            sums1(a, result, i + 1, sum, n1, m);\n        }\n    }\n    \n    private static void sums2(int[] a, List<Integer> result, int i, int sum, int n, int m) {\n        if (i == n) {\n            result.add(sum % m);\n        } else {\n            sums2(a, result, i + 1, (sum + a[i]) % m, n, m);\n            sums2(a, result, i + 1, sum, n, m);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010358751023886725, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.00012039413559250534, -1.5735502529423684e-05, -0.004621301311999559, -0.349253386259079, -2.50339189733495e-06, -5.960462772236497e-07, -6.878139538457617e-05, -0.00020418466010596603, -3.6954811548639555e-06, -0.018185431137681007, -5.960462772236497e-07, -1.168244216387393e-05, -1.1920922133867862e-06, -8.344646857949556e-07, -1.4305104514278355e-06, -2.682172998902388e-05, -1.0728830375228426e-06, -9.536738616588991e-07, -1.7881377516459906e-06, -3.564294092939235e-