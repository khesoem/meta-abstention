{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3.11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3.11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define pb push_back\n#define x first\n#define y second\n\nusing namespace std;\ntypedef long long INT;\ntypedef pair <int, int> pii;\ntypedef vector <int> VI;\n\n#define NN 6555\nstruct edge {\n\tint to, capacity, cost, rev;\n\tedge() {}\n\tedge(int to,int _capacity,int _cost,int _rev):\n\t\tto(to), capacity(_capacity), cost(_cost), rev(_rev) {}\n};\n\nconst int inf=0x3f3f3f3f;\n\nstruct Min_Cost_Max_Flow {\n\tint V, H[NN + 5], dis[NN +5], PreV[NN +5], PreE[NN + 5];\n\tvector<edge> G[NN + 5];\n\tvoid Init(int n) {\n\t\tV = n;\n\t\tfor (int i = 0; i <= V; ++i) G[i].clear();\n   \t}\n\tvoid add_edge(int from, int to, int cap, int cost) {\n\t\tG[from].push_back(edge(to, cap, cost, G[to].size()));\n\t\tG[to].push_back(edge(from,0, -cost, G[from].size() - 1));\n\t}\n\tint minCost(int s, int t, int f) {\n\t\tint flow = 0;\n\t\tint res = 0;\n\t\tfill(H, H +1 + V, 0);\n\t\twhile (f) {\n   \t\t\tpriority_queue <pii, vector<pii>, greater<pii> > q;\n   \t\t\tfill(dis, dis + 1 + V, inf);\n   \t\t\tdis[s] = 0; q.push(pii(0, s));\n\t\t\twhile (!q.empty()) {\n   \t\t\t\tpii now = q.top(); q.pop();\n\t\t\t\tint v = now.second;\n\t\t\t\tif (dis[v] < now.first)continue;\n\t\t\t\tfor (int i = 0; i < G[v].size(); ++i) {\n   \t\t\t\t\tedge& e = G[v][i];\n\t\t\t\t\tif (e.capacity > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n   \t\t\t\t\t\tdis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n   \t\t\t\t\t\tPreV[e.to] = v;\n   \t\t\t\t\t\tPreE[e.to] = i;\n   \t\t\t\t\t\tq.push(pii(dis[e.to], e.to));\n\t   \t\t\t\t}\n\t   \t\t\t}\n\t   \t\t}\n\t\t\tif (dis[t] == inf)   break;\n\t\t\tfor (int i = 0; i <= V; ++i)H[i] += dis[i];\n\t\t\tint d = f;\n\t\t\tfor (int v = t; v != s; v = PreV[v])d = min(d, G[PreV[v]][PreE[v]].capacity);\n   \t\t\tf -= d; flow += d; res += d*H[t];\n\t\t\tfor (int v = t; v != s; v = PreV[v]) {\n   \t\t\t\tedge& e = G[PreV[v]][PreE[v]];\n   \t\t\t\te.capacity -= d;\n   \t\t\t\tG[v][e.rev].capacity += d;\n\t\t\t}\n   \t\t}\n\t\treturn res;\n   \t}\n} mcmf;\n\nint main (){\n#ifndef ONLINE_JUDGE\n\tfreopen (\"in.in\", \"r\", stdin);\n\tfreopen (\"out.out\", \"w\", stdout);\n#endif\n\t\n\tint n, m, k, c, d;\n\t\n\tcin >> n >> m >> k >> c >> d;\n\t\n\tmcmf.Init(n*(n+55)+2);\n\tfor(int i=0; i<k; i++){\n\t\tint u; cin >> u;\n\t\tmcmf.add_edge(0, u, 1, 0);\n\t}\n\t\n\tvector <pii> edge=vector <pii> (m);\n\tfor(int i=0; i<m; i++) cin >> edge[i].x >> edge[i].y;\n\t\n\tint tar=n*(n+55)+1;\n\tfor(int t=0; t<n+54; t++){\n\t\tfor(pii e : edge){\n\t\t\tfor(int j=1; j<=k; j++){\n\t\t\t\tmcmf.add_edge(e.x+t*n, e.y+(t+1)*n, 1, c+d*(j*2-1));\n\t\t\t\tmcmf.add_edge(e.y+t*n, e.x+(t+1)*n, 1, c+d*(j*2-1));\n\t\t\t}\n\t\t}\n\t\tfor(int i=2; i<=n; i++){\n\t\t\tmcmf.add_edge(i+t*n, i+(t+1)*n, k, c);\n\t\t}\n\t\tmcmf.add_edge(1+t*n, tar, k, 0);\n\t}\n\t\n\tcout << mcmf.minCost(0, tar, k) << endl;\n\t\n\treturn 0;\n}\n\n                  \n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn, m, k, c, d = map(int, input().split())\n\nclass Edge:\n    def __init__(self, to, capacity, cost, rev):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.rev = rev\n\nclass Min_Cost_Max_Flow:\n    def __init__(self):\n        self.V = 0\n        self.G = []\n\n    def init(self, n):\n        self.V = n\n        self.G = [[] for _ in range(n)]\n\n    def add_edge(self, fr, to, cap, cost):\n        self.G[fr].append(Edge(to, cap, cost, len(self.G[to])))\n        self.G[to].append(Edge(fr, 0, -cost, len(self.G[fr]) - 1))\n\n    def minCost(self, s, t, f):\n        import heapq\n        flow = 0\n        res = 0\n        H = [0] * self.V\n        while f > 0:\n            dis = [float('inf')] * self.V\n            dis[s] = 0\n            pq = [(0, s)]\n            PreV = [-1] * self.V\n            PreE = [-1] * self.V\n            while pq:\n                cd, v = heapq.heappop(pq)\n                if dis[v] < cd:\n                    continue\n                for i, e in enumerate(self.G[v]):\n                    if e.capacity > 0 and dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]:\n                        dis[e.to] = dis[v] + e.cost + H[v] - H[e.to]\n                        PreV[e.to] = v\n                        PreE[e.to] = i\n                        heapq.heappush(pq, (dis[e.to], e.to))\n            if dis[t] == float('inf'):\n                break\n            for i in range(self.V):\n                if dis[i] < float('inf'):\n                    H[i] += dis[i]\n            d = f\n            v = t\n            while v != s:\n                u = PreV[v]\n                e = self.G[u][PreE[v]]\n                d = min(d, e.capacity)\n                v = u\n            f -= d\n            flow += d\n            res += d * H[t]\n            v = t\n            while v != s:\n                u = PreV[v]\n                e = self.G[u][PreE[v]]\n                e.capacity -= d\n                self.G[v][e.rev].capacity += d\n                v = u\n        return res\n\nmcmf = Min_Cost_Max_Flow()\nmax_node = n * (n + 55) + 2\nmcmf.init(max_node)\n\nfor _ in range(k):\n    u = int(input())\n    mcmf.add_edge(0, u, 1, 0)\n\nedge = [tuple(map(int, input().split())) for _ in range(m)]\n\ntar = n * (n + 55) + 1\nfor t in range(n + 54):\n    for e in edge:\n        for j in range(1, k + 1):\n            mcmf.add_edge(e[0] + t * n, e[1] + (t + 1) * n, 1, c + d * (j * 2 - 1))\n            mcmf.add_edge(e[1] + t * n, e[0] + (t + 1) * n, 1, c + d * (j * 2 - 1))\n    for i in range(2, n + 1):\n        mcmf.add_edge(i + t * n, i + (t + 1) * n, k, c)\n    mcmf.add_edge(1 + t * n, tar, k, 0)\n\nprint(mcmf.minCost(0, tar, k))\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00010783452307805419, -0.0004907185211777687, -5.512236498361744e-07, -2.7372048862162046e-05, -1.7556275129318237, -0.9814133048057556, 0.0, -1.3856492842023727e-06, -1.3856492842023727e-06, -7.896309739408025e-07, 0.0, -9.968312951968983e-06, 0.0, -2.45848218582978e-06, -1.3856492842023727e-06, -3.128163257315464e-07, -9.088346359931165e-07, -1.9361264946837764e-07, 0.0, -3.7697225252486533e-06, -0.012820523232221603, -0.10613284260034561, -0.06996355950832367, -6.988221684878226e-06, -2.951771421066951e-05, -6.098748053773306e-05, -9.088346359931165e-07, 0.0, 0.0, 0.0, -8.77627644513268e-06, -2.1054253011243418e-05, -0.020589301362633705, -0.0024768433067947626, -2.5107177862082608e-05, -2.339278580620885e-06, -1.981667537620524e-06, -8.65707261255011e-06, -0.00016098834748845547, -5.512236498361744e-07, -1.7432603272027336e-06, -1.9361264946837764e-07, -1.1637164789135568e-05, -2.696889623621246e-06, -5.438573680294212e-06, -3.128163257315464e-07, 0.0, -1.318681188422488e-05, -2.2200749754119897e-06, -1.3902033970225602e-05, -1.9361264946837764e-07, 0.0, 0.0, -5.512236498361744e-07, -4.36574100604048e-06, -9.968312951968983e-06, 0.0, 0.0, 0.0, -1.9361264946837764e-07, -4.320199877838604e-07, -4.320199877838604e-07, -0.0019291093340143561, -0.100