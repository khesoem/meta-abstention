 flow += a[t]\n        cost += d[t] * a[t]\n        u = t\n        while u != s:\n            e = self.edges[p[u]]\n            e[3] += a[t]\n            rev = self.edges[p[u] ^ 1]\n            rev[3] -= a[t]\n            u = e[0]\n        return True, flow, cost\n\n    def min_cost(self, s, t):\n        flow = 0\n        cost = 0\n        while True:\n            ok, flow, cost = self.bellman(s, t, flow, cost)\n            if not ok:\n                break\n        return cost\n\ndef main():\n    data = list(read_ints())\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n\n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = next(it)\n\n    start = 0\n    end = n * 100 + 1\n    solver = MCMF(end)\n\n    for i in range(1, k + 1):\n        solver.add_edge(start, 1 + (a[i] - 1) * 100, 1, 0)\n\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            p = (i - 1) * 100 + j\n            solver.add_edge(p, p + 1, 10**9, c)\n\n    for i in range(1, 101):\n        solver.add_edge(i, end, 10**9, 0)\n\n    for _ in range(m):\n        x = next(it)\n        y = next(it)\n        for i in range(1, 100):\n            p = (x - 1) * 100 + i\n            pp = (y - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d * (j * j - (j - 1) * (j - 1)) + c\n                solver.add_edge(p, pp, 1, cost)\n        for i in range(1, 100):\n            p = (y - 1) * 100 + i\n            pp = (x - 1) * 100 + i + 1\n            for j in range(1, 51):\n                cost = d * (j * j - (j - 1) * (j - 1)) + c\n                solver.add_edge(p, pp, 1, cost)\n\n    print(solver.min_cost(start, end))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.075552376685664e-05, -1.1920928244535389e-07, 0.0, -0.00037126801908016205, -0.0003413571394048631, 0.0, -0.313393235206604, -0.05815019831061363, -0.11798307