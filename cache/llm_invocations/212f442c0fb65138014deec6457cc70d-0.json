ge(graph, i * 101 + j, i * 101 + j + 1, INT_MAX, 0);\n        }\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        --u; --v;\n        for (int j = 0; j < 100; ++j) {\n            for (int K = 1; K <= k; ++K) {\n                int deltaCost = d * (K * K - (K - 1) * (K - 1));\n                addEdge(graph, u * 101 + j, v * 101 + j + 1, 1, deltaCost);\n                addEdge(graph, v * 101 + j, u * 101 + j + 1, 1, deltaCost);\n            }\n        }\n    }\n    \n    int source = nodeCount - 2;\n    int sink = nodeCount - 1;\n    int totalFlow = 0, minCost = 0;\n    \n    while (totalFlow < k) {\n        vector<int> dist(nodeCount, MAX_COST);\n        vector<int> prevNode(nodeCount, -1);\n        vector<size_t> prevEdge(nodeCount);\n        vector<bool> inQueue(nodeCount, false);\n        queue<int> q;\n        \n        dist[source] = 0;\n        q.push(source);\n        inQueue[source] = true;\n        \n        while (!q.empty()) {\n            int cur = q.front();\n            q.pop();\n            inQueue[cur] = false;\n            \n            for (size_t i = 0; i < graph[cur].size(); ++i) {\n                Edge& e = graph[cur][i];\n                if (e.flow < e.capacity && dist[cur] + e.weight < dist[e.destination]) {\n                    dist[e.destination] = dist[cur] + e.weight;\n                    prevNode[e.destination] = cur;\n                    prevEdge[e.destination] = i;\n                    if (!inQueue[e.destination]) {\n                        q.push(e.destination);\n                        inQueue[e.destination] = true;\n                    }\n                }\n            }\n        }\n        \n        if (dist[sink] == MAX_COST) break;\n        \n        int flowIncrement = k - totalFlow;\n        for (int v = sink; v != source; v = prevNode[v]) {\n            int u = prevNode[v];\n            size_t idx = prevEdge[v];\n            flowIncrement = min(flowIncrement, graph[u][idx].capacity - graph[u][idx].flow);\n        }\n        \n        for (int v = sink; v != source; v = prevNode[v]) {\n            int u = prevNode[v];\n            size_t idx = prevEdge[v];\n            size_t revIdx = graph[u][idx].reverseIndex;\n            graph[u][idx].flow += flowIncrement;\n            graph[v][revIdx].flow -= flowIncrement;\n            minCost += graph[u][idx].weight * flowIncrement;\n        }\n        \n        totalFlow += flowIncrement;\n    }\n    \n    if (totalFlow != k) return 1;\n    printf(\"%d\\n\", minCost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_COST = 1000000000;\n\n    static class Edge {\n        int destination;\n        int capacity;\n        int weight;\n        int flow;\n        int reverseIndex;\n\n        Edge(int destination, int capacity, int weight, int flow, int reverseIndex) {\n            this.destination = destination;\n            this.capacity = capacity;\n            this.weight = weight;\n            this.flow = flow;\n            this.reverseIndex = reverseIndex;\n        }\n    }\n\n    static void addEdge(List<List<Edge>> adj, int src, int dest, int cap, int cost) {\n        Edge forward = new Edge(dest, cap, cost, 0, adj.get(dest).size());\n        Edge backward = new Edge(src, 0, -cost, 0, adj.get(src).size());\n        adj.get(src).add(forward);\n        adj.get(dest).add(backward);\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int N = scanner.nextInt();\n        int m = scanner.nextInt();\n        int k = scanner.nextInt();\n        int c = scanner.nextInt();\n        int d = scanner.nextInt();\n        \n        int nodeCount = N * 101 + 2;\n        List<List<Edge>> graph = new ArrayList<>();\n        for (int i = 0; i < nodeCount; i++) {\n            graph.add(new ArrayList<>());\n        }\n        \n        for (int i = 0; i < k; ++i) {\n            int x = scanner.nextInt();\n            --x;\n            addEdge(graph, nodeCount - 2, x * 101, 1, 0);\n        }\n        \n        for (int i = 0; i < 101; ++i) {\n            addEdge(graph, i, nodeCount - 1, Integer.MAX_VALUE, i * c);\n        }\n        \n        for (int i = 1; i < N; ++i) {\n            for (int j = 0; j < 100; ++j) {\n                addEdge(graph, i * 101 + j, i * 101 + j + 1, Integer.MAX_VALUE, 0);\n            }\n        }\n        \n        for (int i = 0; i < m; ++i) {\n            int u = scanner.nextInt();\n            int v = scanner.nextInt();\n            --u; --v;\n            for (int j = 0; j < 100; ++j) {\n                for (int K = 1; K <= k; ++K) {\n                    int deltaCost = d * (K * K - (K - 1) * (K - 1));\n                    addEdge(graph, u * 101 + j, v * 101 + j + 1, 1, deltaCost);\n                    addEdge(graph, v * 101 + j, u * 101 + j + 1, 1, deltaCost);\n                }\n            }\n        }\n        \n        int source = nodeCount - 2;\n        int sink = nodeCount - 1;\n        int totalFlow = 0, minCost = 0;\n        \n        while (totalFlow < k) {\n            int[] dist = new int[nodeCount];\n            Arrays.fill(dist, MAX_COST);\n            int[] prevNode = new int[nodeCount];\n            Arrays.fill(prevNode, -1);\n            int[] prevEdge = new int[nodeCount];\n            boolean[] inQueue = new boolean[nodeCount];\n            Queue<Integer> q = new LinkedList<>();\n            \n            dist[source] = 0;\n            q.offer(source);\n            inQueue[source] = true;\n            \n            while (!q.isEmpty()) {\n                int cur = q.poll();\n                inQueue[cur] = false;\n                \n                for (int i = 0; i < graph.get(cur).size(); ++i) {\n                    Edge e = graph.get(cur).get(i);\n                    if (e.flow < e.capacity && dist[cur] + e.weight < dist[e.destination]) {\n                        dist[e.destination] = dist[cur] + e.weight;\n                        prevNode[e.destination] = cur;\n                        prevEdge[e.destination] = i;\n                        if (!inQueue[e.destination]) {\n                            q.offer(e.destination);\n                            inQueue[e.destination] = true;\n                        }\n                    }\n                }\n            }\n            \n            if (dist[sink] == MAX_COST) break;\n            \n            int flowIncrement = k - totalFlow;\n            for (int v = sink; v != source; v = prevNode[v]) {\n                int u = prevNode[v];\n                int idx = prevEdge[v];\n                flowIncrement = Math.min(flowIncrement, graph.get(u).get(idx).capacity - graph.get(u).get(idx).flow);\n            }\n            \n            for (int v = sink; v != source; v = prevNode[v]) {\n                int u = prevNode[v];\n                int idx = prevEdge[v];\n                int revIdx = graph.get(u).get(idx).reverseIndex;\n                graph.get(u).get(idx).flow += flowIncrement;\n                graph.get(v).get(revIdx).flow -= flowIncrement;\n                minCost += graph.get(u).get(idx).weight * flowIncrement;\n            }\n            \n            totalFlow += flowIncrement;\n        }\n        \n        if (totalFlow != k) {\n            System.out.println(-1);\n        } else {\n            System.out.println(minCost);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013410145766101778, -1.5497195136049413e-06, -4.768370445162873e-07, -0.002981505123898387, -3.755022044060752e-05, -0.10021143406629562, -0.6326517462730408, -2.5987286790041253e-05, -3.576278118089249e-07, -0.00011503035057103261, -0.026300910860300064, -0.0003359945258125663, -0.0034113090950995684, -0.07258115708827972, -3.814689989667386