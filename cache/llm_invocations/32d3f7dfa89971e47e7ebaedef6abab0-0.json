eque()\n    q.append(sx*10 + sy)\n    tim[sx][sy] = 0\n    while q:\n        code = q.popleft()\n        x = code // 10\n        y = code % 10\n        for dx, dy in [(-1,0),(0,1),(1,0),(0,-1)]:\n            nx = x + dx\n            ny = y + dy\n            if inside(nx, ny, n) and '0' <= g[nx][ny] <= '9' and tim[nx][ny] > tim[x][y] + 1:\n                tim[nx][ny] = tim[x][y] + 1\n                q.append(nx*10 + ny)\n    return tim\n\ndef bfs2(sx, sy, g, h, tim, n):\n    dis = [[INF]*n for _ in range(n)]\n    q = deque()\n    q.append(sx*10 + sy)\n    dis[sx][sy] = 0\n    while q:\n        code = q.popleft()\n        x = code // 10\n        y = code % 10\n        for dx, dy in [(-1,0),(0,1),(1,0),(0,-1)]:\n            nx = x + dx\n            ny = y + dy\n            if inside(nx, ny, n) and '0' <= h[nx][ny] <= '9' and dis[nx][ny] > dis[x][y] + 1:\n                if tim[nx][ny] >= dis[x][y] + 1:\n                    dis[nx][ny] = dis[x][y] + 1\n                    if tim[nx][ny] > dis[nx][ny]:\n                        q.append(nx*10 + ny)\n    return dis\n\nclass MaxFlow:\n    def __init__(self, n):\n        self.n = n\n        self.head = [-1]*n\n        self.to = []\n        self.cap = []\n        self.flow = []\n        self.nxt = []\n        self.level = [0]*n\n        self.it = [0]*n\n\n    def add_edge(self, u, v, c):\n        idx = len(self.to)\n        self.to.append(v)\n        self.cap.append(c)\n        self.flow.append(0)\n        self.nxt.append(self.head[u])\n        self.head[u] = idx\n        self.to.append(u)\n        self.cap.append(0)\n        self.flow.append(0)\n        self.nxt.append(self.head[v])\n        self.head[v] = idx ^ 1\n\n    def bfs(self, s, t):\n        self.level = [-1]*self.n\n        q = deque()\n        self.level[s] = 0\n        q.append(s)\n        while q:\n            u = q.popleft()\n            e = self.head[u]\n            while e != -1:\n                v = self.to[e]\n                if self.level[v] == -1 and self.cap[e] > self.flow[e]:\n                    self.level[v] = self.level[u] + 1\n                    q.append(v)\n                e = self.nxt[e]\n        return self.level[t] != -1\n\n    def dfs(self, u, a, t):\n        if u == t or a == 0:\n            return a\n        ret = 0\n        e = self.it[u]\n        while e != -1:\n            v = self.to[e]\n            if self.level[v] == self.level[u] + 1 and self.cap[e] > self.flow[e]:\n                f = self.dfs(v, min(a, self.cap[e] - self.flow[e]), t)\n                if f > 0:\n                    self.flow[e] += f\n                    self.flow[e ^ 1] -= f\n                    a -= f\n                    ret += f\n                    if a == 0:\n                        break\n            e = self.nxt[e]\n            self.it[u] = e\n        return ret\n\n    def max_flow(self, s, t):\n        ans = 0\n        while self.bfs(s, t):\n            self.it = self.head[:]\n            ans += self.dfs(s, INF, t)\n        return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    g = [list(next(it).strip()) for _ in range(n)]\n    h = [list(next(it).strip()) for _ in range(n)]\n\n    tim = None\n    for i in range(n):\n        for j in range(n):\n            if g[i][j] == 'Z':\n                tim = bfs1(i, j, g, n)\n                break\n        if tim is not None:\n            break\n\n    S = 0\n    T = n * n * 2 + 1\n    mf = MaxFlow(T + 1)\n\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                mf.add_edge(S, i * n + j + 1, ord(g[i][j]) - ord('0'))\n            if '1' <= h[i][j] <= '9':\n                mf.add_edge(n * n + i * n + j + 1, T, ord(h[i][j]) - ord('0'))\n\n    for i in range(n):\n        for j in range(n):\n            if '1' <= g[i][j] <= '9':\n                dis = bfs2(i, j, g, h, tim, n)\n                for x in range(n):\n           