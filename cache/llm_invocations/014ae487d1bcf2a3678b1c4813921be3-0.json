\n        }\n    }\n}\n\nvoid dijkstra(int source) {\n    fill(dist, dist + MAX_NODES, INF);\n    dist[source] = 0;\n    set<pair<lli, int>> pq;\n    pq.emplace(0, source);\n    while (!pq.empty()) {\n        auto [d_val, v] = *pq.begin();\n        pq.erase(pq.begin());\n        for (int eid : adj[v]) {\n            auto& e = edge_list[eid];\n            if (e.capacity == e.flow) continue;\n            int w = e.dst;\n            lli reduced_cost = e.weight + pot[v] - pot[w];\n            if (dist[v] + reduced_cost < dist[w]) {\n                pq.erase({dist[w], w});\n                dist[w] = dist[v] + reduced_cost;\n                prev_edge[w] = eid;\n                pq.emplace(dist[w], w);\n            }\n        }\n    }\n}\n\npair<lli, lli> min_cost_max_flow(int src, int dst) {\n    bellman_ford(src, 50);\n    dijkstra(src);\n    lli total_flow = 0, total_cost = 0;\n    while (dist[dst] != INF) {\n        lli bottleneck = INF;\n        lli sum_cost = 0;\n        for (int cur = dst; cur != src; ) {\n            int eid = prev_edge[cur];\n            bottleneck = min(bottleneck, edge_list[eid].capacity - edge_list[eid].flow);\n            sum_cost += edge_list[eid].weight;\n            cur = edge_list[eid].src;\n        }\n        total_flow += bottleneck;\n        total_cost += bottleneck * sum_cost;\n        for (int cur = dst; cur != src; ) {\n            int eid = prev_edge[cur];\n            edge_list[eid].flow += bottleneck;\n            edge_list[eid ^ 1].flow -= bottleneck;\n            cur = edge_list[eid].src;\n        }\n        dijkstra(src);\n        for (int i = 0; i < MAX_NODES; ++i) pot[i] = dist[i];\n    }\n    return {total_cost, total_flow};\n}\n\nvoid process() {\n    int n, m, k, c_val, d_val;\n    cin >> n >> m >> k >> c_val >> d_val;\n    vector<int> counts(n, 0);\n    for (int i = 0; i < k; ++i) {\n        int ai;\n        cin >> ai;\n        counts[--ai]++;\n    }\n    for (int i = 0; i < n; ++i) {\n        add_edge(5000, i, counts[i], 