ge(len(dp[0])):\n                total_sum += dp[i][j]\n                total_sum %= self.mod\n                if total_sum == 0:\n                    total_sum += self.mod\n                sums[i][j] = total_sum\n\n        # init\n        fact = [0] * (501 * 501)\n        fact[0] = fact[1] = 1\n        for i in range(2, len(fact)):\n            fact[i] = fact[i - 1] * i\n            fact[i] %= self.mod\n\n        ncr = [[0] * 501 for _ in range(501)]\n        ncr[0][0] = 1\n        for i in range(1, len(ncr)):\n            ncr[i][0] = 1\n            for j in range(1, len(ncr[0])):\n                ncr[i][j] = (ncr[i - 1][j] + ncr[i - 1][j - 1]) % self.mod\n                if ncr[i][j] == 0:\n                    ncr[i][j] += self.mod\n\n        res = 0\n        for i in range(n - 1):\n            cnt = n - i\n            pre = n - cnt\n            com = (ncr[n][pre] * fact[pre]) % self.mod\n            if com == 0:\n                com += self.mod\n            sum_val = 0\n\n            last = dp[cnt - 2]\n            ssum = 0\n            total = 0\n            for j in range(2, len(dp[0])):  # j == inversions\n                total += sums[cnt - 2][j - 2] * (cnt - 1)\n                total %= self.mod\n                if total == 0:\n                    total += self.mod\n\n                sum_val += last[j] * total\n                sum_val %= self.mod\n                if sum_val == 0:\n                    sum_val += self.mod\n\n                ssum += sums[cnt - 2][j - 2]\n                if j - cnt - 1 >= 0:\n                    ssum -= sums[cnt - 2][j - cnt - 1]\n                ssum += self.mod\n                ssum %= self.mod\n                if ssum == 0:\n                    ssum += self.mod\n\n                total -= ssum\n                total += self.mod\n                total %= self.mod\n                if total == 0:\n                    total += self.mod\n\n            res += sum_val * com\n            res %= self.mod\n            if res == 0:\n   