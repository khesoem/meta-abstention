while (cur != src) {\n        int prev = g[cur][par[cur]].to;\n        int idx = g[cur][par[cur]].rev;\n        f = min(f, g[prev][idx].cap);\n        cur = prev;\n    }\n    \n    flow += f;\n    cost += f * ddist[dst];\n    \n    cur = dst;\n    while (cur != src) {\n        int prev = g[cur][par[cur]].to;\n        int idx = g[cur][par[cur]].rev;\n        g[cur][par[cur]].cap += f;\n        g[prev][idx].cap -= f;\n        cur = prev;\n    }\n}\n\nint idx(int v, int t) {\n    return v + t * n;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> m >> k >> c >> d;\n    src = MAXN - 2;\n    dst = MAXN - 1;\n    int T = n + k;\n    \n    for (int i = 0; i < k; ++i) {\n        cin >> u;\n        link(src, idx(u, 0), 0, 1);\n    }\n    \n    for (int t = 0; t <= T; ++t) {\n        link(idx(1, t), dst, c * t, k);\n    }\n    \n    for (int v = 1; v <= n; ++v) {\n        for (int t = 0; t < T; ++t) {\n            link(idx(v, t), idx(v, t + 1), 0, k);\n        }\n    }\n    \n    while (m--) {\n        cin >> u >> v;\n        for (int i = 1; i <= k; ++i) {\n            for (int t = 0; t < T; ++t) {\n                int w = d * (2 * i - 1);\n                link(idx(u, t), idx(v, t + 1), w, 1);\n                link(idx(v, t), idx(u, t + 1), w, 1);\n            }\n        }\n    }\n    \n    while (flow < k) {\n        spfa();\n        path_augment();\n    }\n    \n    cout << cost;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 5500;\n    static final long INF = 1000000007L;\n\n    static int n, m, k, c, d;\n    static int src, dst;\n    static int flow = 0;\n    static long cost = 0;\n    static long[] ddist = new long[MAXN];\n    static int[] par = new int[MAXN];\n\n    static class Edge {\n        int to;\n        int w;\n        int rev;\n        int cap;\n\n        Edge(int to, int w, int rev, int cap) {\n            this.to = to;\n            this.w = w;\n            this.rev = rev;\n            this.cap = cap;\n        }\n    }\n\n    static List<Edge>[] g = new List[MAXN];\n\n    static void link(int u, int v, int w, int cap) {\n        int sz1 = g[u].size(), sz2 = g[v].size();\n        g[u].add(new Edge(v, w, sz2, cap));\n        g[v].add(new Edge(u, -w, sz1, 0));\n    }\n\n    static void spfa() {\n        Arrays.fill(ddist, INF);\n        Queue<Integer> q = new LinkedList<>();\n        ddist[src] = 0;\n        q.offer(src);\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            for (Edge e : g[u]) {\n                if (e.cap > 0 && ddist[e.to] > ddist[u] + e.w) {\n                    ddist[e.to] = ddist[u] + e.w;\n                    par[e.to] = e.rev;\n                    q.offer(e.to);\n                }\n            }\n        }\n    }\n\n    static void path_augment() {\n        int f = k;\n        int cur = dst;\n        while (cur != src) {\n            int prev = g[cur].get(par[cur]).to;\n            int idx = g[cur].get(par[cur]).rev;\n            f = Math.min(f, g[prev].get(idx).cap);\n            cur = prev;\n        }\n\n        flow += f;\n        cost += f * ddist[dst];\n\n        cur = dst;\n        while (cur != src) {\n            int prev = g[cur].get(par[cur]).to;\n            int idx = g[cur].get(par[cur]).rev;\n            g[cur].get(par[cur]).cap += f;\n            g[prev].get(idx).cap -= f;\n            cur = prev;\n        }\n    }\n\n    static int idx(int v, int t) {\n        return v + t * n;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        for (int i = 0; i < MAXN; i++) {\n            g[i] = new ArrayList<>();\n        }\n\n       