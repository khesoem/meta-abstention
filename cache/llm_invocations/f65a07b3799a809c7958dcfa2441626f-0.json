": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    x, y, n = map(int, sys.stdin.readline().split())\n    \n    rem = 1 << 32\n    res_a = 1 << 32\n    res_b = 1 << 32\n    \n    def update_if_better(a, b):\n        nonlocal rem, res_a, res_b\n        diff = abs(x * b - a * y)\n        if rem * b > diff * res_b:\n            rem = diff\n            res_a = a\n            res_b = b\n        elif rem * b == diff * res_b:\n            if res_b > b or (res_b == b and res_a > a):\n                rem = diff\n                res_a = a\n                res_b = b\n    \n    for b in range(1, n + 1):\n        a0 = (x * b) // y\n        if a0 > 10:\n            a0 -= 10\n        else:\n            a0 = 0\n        \n        for j in range(20):\n            update_if_better(a0 + j, b)\n    \n    print(f\"{res_a}/{res_b}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.152301259338856e-05, -9.536738616588991e-07, -3.576278118089249e-07, -0.05939868092536926, -0.632726788520813, -0.3132719397544861, -3.4570634852570947e-06, -0.001212338567711413, -2.7656173188006505e-05, -1.0728830375228426e-06, -0.07525946944952011, -2.145764938177308e-06, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -1.4305104514278355e-06, -2.455681169521995e-05, -2.5748875486897305e-05, -9.536738616588991e-07, -0.313292920589447, -6.9141146923357155e-06, -3.540453326422721e-05, -3.576278118089249e-07, -0.018202170729637146, -0.5759479999542236, -5.722029527532868e-06, -2.3841855067985307e-07, -0.001392705482430756, -4.172316494077677e-06, -1.5139465176616795e-05, -0.00010895135346800089, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.5258672647178173e-05, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -8.344646857