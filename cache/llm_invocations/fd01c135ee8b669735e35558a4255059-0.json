id);\n            Point dir = segment.direction().perpendicular();\n            double h = Math.sqrt(a.radius * a.radius - distToMid * distToMid);\n            Point p1 = mid.translate(dir, h);\n            Point p2 = mid.translate(dir, -h);\n\n            set.add(p1);\n            if (!p2.equals(p1)) {\n                set.add(p2);\n            }\n        }\n    }\n\n    public static class Point implements Comparable<Point> {\n        double x, y;\n\n        public Point(double x, double y) {\n            this.x = x;\n            this.y = y;\n        }\n\n        @Override\n        public String toString() {\n            return \"(\" + x + \",\" + y + \")\";\n        }\n\n        public Point subtract(Point other) {\n            return new Point(x - other.x, y - other.y);\n        }\n\n        public Point translate(Line line, double dist) {\n            return translate(line.direction(), dist);\n        }\n\n        public Point translate(Point vector, double dist) {\n            Point unit = vector.normalize();\n            return add(unit.multiply(dist));\n        }\n\n        public Point add(Point other) {\n            return new Point(x + other.x, y + other.y);\n        }\n\n        public Point multiply(double factor) {\n            return new Point(x * factor, y * factor);\n        }\n\n        public Point normalize() {\n            double mag = Math.sqrt(x * x + y * y);\n            return divide(mag);\n        }\n\n        public Point divide(double divisor) {\n            return new Point(x / divisor, y / divisor);\n        }\n\n        public Point perpendicular() {\n            return new Point(-y, x);\n        }\n\n        @Override\n        public boolean equals(Object obj) {\n            Point other = (Point) obj;\n            return Math.abs(x - other.x) < EPSILON && Math.abs(y - other.y) < EPSILON;\n        }\n\n        @Override\n        public int compareTo(Point o) {\n            if (equals(o)) {\n                return 0;\n            }\n   