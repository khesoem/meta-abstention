DGE\" in sys.argv or sys.platform.startswith(\"linux\")\n\nclass Point:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n    \n    def __repr__(self):\n        return f\"({self.x},{self.y})\"\n    \n    def subtract(self, other):\n        return Point(self.x - other.x, self.y - other.y)\n    \n    def translate(self, line, dist):\n        return self.translate_vector(line.direction(), dist)\n    \n    def translate_vector(self, vector, dist):\n        unit = vector.normalize()\n        return self.add(unit.multiply(dist))\n    \n    def add(self, other):\n        return Point(self.x + other.x, self.y + other.y)\n    \n    def multiply(self, factor):\n        return Point(self.x * factor, self.y * factor)\n    \n    def normalize(self):\n        mag = math.sqrt(self.x * self.x + self.y * self.y)\n        return self.divide(mag)\n    \n    def divide(self, divisor):\n        return Point(self.x / divisor, self.y / divisor)\n    \n    def perpendicular(self):\n        return Point(-self.y, self.x)\n    \n    def __eq__(self, other):\n        if not isinstance(other, Point):\n            return False\n        return abs(self.x - other.x) < EPSILON and abs(self.y - other.y) < EPSILON\n    \n    def __hash__(self):\n        return hash((round(self.x / EPSILON), round(self.y / EPSILON)))\n    \n    def __lt__(self, other):\n        if self == other:\n            return False\n        if abs(self.x - other.x) < EPSILON:\n            return self.y < other.y\n        return self.x < other.x\n\nclass Line:\n    def __init__(self, start, end):\n        self.start = start\n        self.end = end\n    \n    def direction(self):\n        return self.end.subtract(self.start)\n    \n    def length(self):\n        return math.sqrt((self.end.x - self.start.x)**2 + (self.end.y - self.start.y)**2)\n\nclass Circle:\n    def __init__(self, x, y, r):\n        self.center = Point(x, y)\n        self.radius = r\n    \n    @staticmethod\n    def distance(a, b):\n        return math.sqrt((a.x - b.x)**2 + (a.y - b.y)**2)\n    \n    @staticmethod\n    def overlap(a, b):\n        d = Circle.distance(a.center, b.center)\n        return d <= a.radius + b.radius + EPSILON and d + EPSILON >= abs(a.radius - b.radius)\n    \n    @staticmethod\n    def overlap2(a, b):\n        d = Circle.distance(a.center, b.center)\n        return d < a.radius + b.radius and d > abs(a.radius - b.radius)\n    \n    @staticmethod\n    def get_intersections(a, b, point_set):\n        if not Circle.overlap(a, b):\n            return\n        \n        segment = Line(a.center, b.center)\n        d = Circle.distance(a.center, b.center)\n        dist_to_mid = (d * d - b.radius * b.radius + a.radius * a.radius) / (2 * d)\n        mid = a.center.translate(segment, dist_to_mid)\n        dir_vec = segment.direction().perpendicular()\n        h = math.sqrt(a.radius * a.radius - dist_to_mid * dist_to_mid)\n        p1 = mid.translate_vector(dir_vec, h)\n        p2 = mid.translate_vector(dir_vec, -h)\n        \n        point_set.add(p1)\n        if not p2 == p1:\n            point_set.add(p2)\n\ndef main():\n    if not IS_REMOTE_JUDGE:\n        try:\n            sys.stdin = open(\"D:\\\\DataBase\\\\TESTCASE\\\\codeforces\\\\CF933C.in\", \"r\")\n        except:\n            pass\n    \n    n = int(input().strip())\n    circles = []\n    \n    for _ in range(n):\n        x, y, r = map(int, input().strip().split())\n        circles.append(Circle(x, y, r))\n    \n    if n == 3 and not Circle.overlap(circles[0], circles[1]):\n        count = 4\n        if Circle.overlap2(circles[0], circles[2]):\n            count += 1\n        if Circle.overlap2(circles[1], circles[2]):\n            count += 1\n        print(count)\n        return\n    \n    total = 1\n    for i in range(n):\n        points = set()\n        total += 1\n        for j in range(i):\n            Circle.get_intersections(circles[i], circles[j], points)\n        if len(points) >= 2:\n            total += len(points