mp = x - q * y\n            x, y = y, tmp\n        return self.normalize(x)\n\nclass InputReader:\n    def __init__(self, stream):\n        self.reader = stream\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.reader.readline()\n                if not line:\n                    return None\n                self.tokenizer = line.strip().split()\n            except Exception as e:\n                raise RuntimeError(e)\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\n    def nextLong(self):\n        return int(self.next())\n\ndef main():\n    in_reader = InputReader(sys.stdin)\n    out = sys.stdout\n    solver = EPlacingRooks()\n    solver.solve(1, in_reader, out)\n    out.close()\n\nclass EPlacingRooks:\n    def __init__(self):\n        self.mod = Mod998()\n\n    def solve(self, testNumber, in_reader, out):\n        n = in_reader.nextInt()\n        k = in_reader.nextLong()\n        if k == 0:\n            out.write(str(self.mod.fact(n)) + \"\\n\")\n            return\n\n        if k > n - 1:\n            out.write(\"0\\n\")\n            return\n\n        c = n - k\n\n        answer = 0\n        for i in range(1, c + 1):\n            term = self.mod.mult(self.mod.paritySign(c - i), self.mod.ncr(c, i), self.mod.pow(i, n))\n            answer = self.mod.add(answer, term)\n\n        answer = self.mod.mult(answer, 2, self.mod.ncr(n, c))\n        out.write(str(answer) + \"\\n\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.521823135903105e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.00012635385792236775, -0.007737190928310156, -0.0008092227508313954, -0.142801895737648, -0.01880379021167755, -0.03809179365634918, -0.015459700487554073, -0.0026600712444633245, -0.1428208202123642, -1.7881377516459906e-06, -2.622600959512056e