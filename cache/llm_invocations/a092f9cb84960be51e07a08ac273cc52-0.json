p.get(i))\n                ret[pos++] = i;\n        return ret;\n    }\n\n    int[] primes = sieveEratosthenes(400000);\n\n    static class PrimeCounter {\n        int[] primes;\n        int[] xcums;\n        long[] isp;\n        int cachelimit;\n        Map<Long, Long> picache;\n\n        PrimeCounter(long n) {\n            assert n >= 4;\n            picache = new HashMap<>();\n            int s = (int) Math.sqrt(n) * 100;\n            cachelimit = s;\n            this.primes = sieveEratosthenes(s);\n            xcums = new int[(s >>> 6) + 1];\n            isp = new long[(s >>> 6) + 1];\n            for (int p : this.primes)\n                isp[p >>> 6] |= 1L << p;\n            for (int i = 0; i < xcums.length - 1; i++)\n                xcums[i + 1] = xcums[i] + Long.bitCount(isp[i]);\n        }\n\n        private long sqrt(long n) {\n            long i = Math.max(0, (long) Math.sqrt(n) - 2);\n            while (i * i <= n)\n                i++;\n            return i - 1;\n        }\n\n        private long cbrt(long n) {\n            long i = Math.max(0, (long) Math.cbrt(n) - 2);\n            while (i * i * i <= n)\n                i++;\n            return i - 1;\n        }\n\n        long pi(long x) {\n            if (x <= cachelimit) {\n                int ix = (int) x;\n                return xcums[ix >>> 6] + Long.bitCount(isp[ix >>> 6] << ~ix);\n            }\n            Long cached = picache.get(x);\n            if (cached != null)\n                return cached;\n            int A = (int) pi(sqrt(sqrt(x)));\n            long ret = A + phi(x, A) - P2(x, A) - P3(x, A) - 1;\n            picache.put(x, ret);\n            return ret;\n        }\n\n        private long phi(long x, int A) {\n            if (A == 0)\n                return x;\n            if (x <= (long) primes[A - 1] * primes[A - 1])\n                return pi(x) - A + 1;\n            long ret = x;\n            for (int i = A - 1; i >= 0; i--)\n                ret -= phi(x / primes[i], i);\n    