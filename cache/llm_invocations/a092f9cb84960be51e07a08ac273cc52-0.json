 <= n:\n            i += 1\n        return i - 1\n\n    def pi(self, x):\n        if x <= self.cachelimit:\n            ix = int(x)\n            idx = ix >> 6\n            return self.xcums[idx] + (self.isp[idx] << (63 - (ix & 63))).bit_count()\n        cached = self.picache.get(x)\n        if cached is not None:\n            return cached\n        A = int(self.pi(self.sqrt(self.sqrt(x))))\n        ret = A + self.phi(x, A) - self.P2(x, A) - self.P3(x, A) - 1\n        self.picache[x] = ret\n        return ret\n\n    def phi(self, x, A):\n        if A == 0:\n            return x\n        if x <= self.primes[A - 1] * self.primes[A - 1]:\n            return self.pi(x) - A + 1\n        ret = x\n        for i in range(A - 1, -1, -1):\n            ret -= self.phi(x // self.primes[i], i)\n        return ret\n\n    def P2(self, x, A):\n        B = int(self.pi(self.sqrt(x)))\n        ret = 0\n        for i in range(A, B):\n            ret += self.pi(x // self.primes[i])\n        ret -= (B - A) * (B + A - 1) // 2\n        return ret\n\n    def P3(self, x, A):\n        C = int(self.pi(self.cbrt(x)))\n        ret = 0\n        for i in range(A, C):\n            xi = x // self.primes[i]\n            B = int(self.pi(self.sqrt(xi)))\n            for j in range(i, B):\n                ret += self.pi(xi // self.primes[j]) - j\n        return ret\n\ndef solve():\n    n = int(sys.stdin.readline().strip())\n    ml = PrimeCounter(n // 2)\n    ans = 0\n    for i, p in enumerate(primes):\n        v = ml.pi(n // p) - (i + 1)\n        if v <= 0:\n            break\n        ans += v\n    for p in primes:\n        if p * p * p <= n:\n            ans += 1\n        else:\n            break\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.622600959512056e-06, 0.0, 0.0, -0.00017212340026162565, -0.00011789103882620111, -0.0004314445541240275, -0.001190073206089437, -0.0009128456003963947, -7.748573807475623e-