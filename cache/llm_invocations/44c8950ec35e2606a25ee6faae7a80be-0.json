          if (B[nr][nc] != '.') continue;\n            if (D2[nr][nc] >= 0) continue;\n            if (D1[nr][nc] >= 0 && D1[nr][nc] < D2[u.r][u.c] + 1) continue;\n            D2[nr][nc] = D2[u.r][u.c] + 1;\n            q.push(P(nr, nc));\n        }\n    }\n}\n\nint augment(int v, int t, int f, int n, vector<vector<int> >& cap, vector<int>& used) {\n    if (v == t) return f;\n    used[v] = 1;\n    for (int u = 0; u < n; ++u) {\n        if (used[u] || cap[v][u] <= 0) continue;\n        int got = augment(u, t, min(f, cap[v][u]), n, cap, used);\n        if (got > 0) {\n            cap[v][u] -= got;\n            cap[u][v] += got;\n            return got;\n        }\n    }\n    return 0;\n}\n\nint maxflow(int s, int t, vector<vector<int> > cap) {\n    int n = (int)cap.size();\n    int total = 0;\n    while (true) {\n        vector<int> used(n, 0);\n        int f = augment(s, t, INT_MAX, n, cap, used);\n        if (f == 0) break;\n        total += f;\n    }\n    return total;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> N >> T;\n\n    memset(B1, '#', sizeof(B1));\n    for (int r = 1; r <= N; ++r) {\n        cin >> B1[r] + 1;\n        B1[r][N + 1] = '#';\n    }\n\n    memset(B2, '#', sizeof(B2));\n    for (int r = 1; r <= N; ++r) {\n        cin >> B2[r] + 1;\n        B2[r][N + 1] = '#';\n    }\n\n    memset(B, '#', sizeof(B));\n    vector<P> scientists, capsules;\n    P z;\n    for (int r = 1; r <= N; ++r) {\n        for (int c = 1; c <= N; ++c) {\n            if (B1[r][c] >= '0' && B1[r][c] <= '9') {\n                if (B1[r][c] > '0') scientists.push_back(P(r, c));\n                B[r][c] = '.';\n            } else if (B1[r][c] == 'Z') {\n                z = P(r, c);\n                B[r][c] = '.';\n            }\n            if (B2[r][c] >= '0' && B2[r][c] <= '9' && B2[r][c] > '0')\n                capsules.push_back(P(r, c));\n        }\n    }\n\n    bfs_z(z);\n\n    int nS = (int)scientists.size();\n    int nC = (int