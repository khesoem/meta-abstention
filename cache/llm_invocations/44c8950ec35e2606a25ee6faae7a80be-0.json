entists)\n    nC = len(capsules)\n    SRC = 0\n    SINK = nS + nC + 1\n    cap = [[0] * (SINK+1) for _ in range(SINK+1)]\n    INF = 98765432\n\n    for i, (r, c) in enumerate(scientists):\n        cap[SRC][i+1] += int(B1[r][c])\n    for j, (r, c) in enumerate(capsules):\n        cap[nS + j + 1][SINK] += int(B2[r][c])\n\n    for i, s in enumerate(scientists):\n        bfs_source(s)\n        for j, c in enumerate(capsules):\n            if D2[c[0]][c[1]] >= 0 and D2[c[0]][c[1]] <= T:\n                cap[i+1][nS + j + 1] = INF\n\n    print(maxflow(SRC, SINK, cap))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.9907753085135482e-05, 0.0, 0.0, -0.0004385939973872155, -0.00047791501856409013, -1.1920928244535389e-07, -9.894321920000948e-06, -0.00015877417172305286, -2.3841855067985307e-07, 0.0, -8.344646857949556e-07, -0.0019455092260614038, -0.0945480540394783, -0.40330231189727783, -8.821448318485636e-06, -0.001046229270286858, -0.6100184321403503, -8.344646857949556e-07, -0.017463840544223785, -0.025141878053545952, -6.556489552167477e-06, -0.03804256021976471, -0.0021371636539697647, -0.4741458296775818, 0.0, -0.531587541103363, -0.038589127361774445, -2.264974000354414e-06, -3.576278118089249e-07, -0.1172032430768013, -0.016143091022968292, -0.0069895521737635136, -0.00017891713650897145, -4.768370445162873e-07, -0.2014167457818985, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -3.099436753473128e-06, 0.0, -7.152555099310121e-07, -1.7881377516459906e-06, -2.3841855067985307e-07, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.1920922133867862e-06, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.00021872512297704816, -1.1920928244535389e-07, 0.0, -1.0132738680113107e-05, 0.0, -0.26611146330833435, 0.0, 0.0, 0.0, -0.0001586549769854173, -2.3841855067985307e-07, 0.0, -6.318072337307967e-06, 0.0, -2.3841855067