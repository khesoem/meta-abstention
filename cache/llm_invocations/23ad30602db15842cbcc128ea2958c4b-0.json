ile (b > 0) {\n            if ((b & 1) == 1) {\n                res = (res * a) % MOD;\n            }\n            a = (a * a) % MOD;\n            b >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long p = scanner.nextLong();\n        long k = scanner.nextLong();\n        \n        if (k == 0) {\n            System.out.println(binpow(p, p - 1));\n        } else if (k == 1) {\n            System.out.println(binpow(p, p));\n        } else {\n            long ord = 1;\n            long cur = k % p;\n            while (cur != 1) {\n                cur = (cur * k) % p;\n                ord++;\n            }\n            long cnt = (p - 1) / ord;\n            System.out.println(binpow(p, cnt));\n        }\n        \n        scanner.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000164018536452204, -1.6689286894688848e-06, -1.1920928244535389e-07, -4.303362584323622e-05, -3.6954195820726454e-05, -0.0004894727608188987, -0.014516337774693966, -6.794906312279636e-06, -3.349725011503324e-05, -1.5497195136049413e-06, -3.528532761265524e-05, -0.00523612555116415, -0.001929566147737205, -0.3893525004386902, -0.00035148640745319426, -0.0004980515805073082, -1.7881377516459906e-06, 0.0, 0.0, -2.3841855067985307e-07, -2.4318398573086597e-05, 0.0, -1.1920928244535389e-07, -2.0265558760002023e-06, 0.0, 0.0, -1.6689286894688848e-06, 0.0, 0.0, -0.0032168091274797916, -5.245195097813848e-06, -0.04300128296017647, -3.3378546504536644e-06, -2.3841830625315197e-06, -1.0132738680113107e-05, -2.455681169521995e-05, -5.960462772236497e-07, 0.0, -2.7418097943154862e-06, 0.0, -5.960462772236497e-07, 0.0, -9.405170567333698e-05, -2.622600959512056e-06, -3.576278118089249e-07, 0.0, 0.0, -3.576278118089249e-07, -2.622600959512056e-06, -6.556489552167477e-06, -1.1920928244535389e-07, -4.088794958079234e-05, -6.318072337307967e-06, -3.5762723200