     adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                adj.add(new ArrayList<>());\n            }\n            potential = new int[n];\n            dist = new int[n];\n            back = new Edge[n];\n        }\n\n        public void addEdge(int src, int dst, long cap, int cost) {\n            adj.get(src).add(new Edge(src, dst, adj.get(dst).size(), 0, cap, cost));\n            if (src == dst) {\n                adj.get(src).get(adj.get(src).size() - 1).rev++;\n            }\n            adj.get(dst).add(new Edge(dst, src, adj.get(src).size() - 1, 0, 0, -cost));\n        }\n\n        public int rcost(Edge e) {\n            return e.cost + potential[e.src] - potential[e.dst];\n        }\n\n        public int dijkstra(int source, int sink) {\n            Arrays.fill(dist, Integer.MAX_VALUE);\n            PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> a[0] - b[0]);\n            pq.add(new int[]{dist[source] = 0, source});\n            while (!pq.isEmpty()) {\n                int[] p = pq.poll();\n                if (dist[p[1]] < p[0]) {\n                    continue;\n                }\n                if (p[1] == sink) {\n                    break;\n                }\n                for (Edge e : adj.get(p[1])) {\n                    if (e.flow < e.cap && dist[e.dst] > dist[e.src] + rcost(e)) {\n                        back[e.dst] = e;\n                        pq.add(new int[]{dist[e.dst] = dist[e.src] + rcost(e), e.dst});\n                    }\n                }\n            }\n            return dist[sink];\n        }\n\n        public long maxFlow(int source, int sink) {\n            long flow = 0;\n            int cost = 0;\n            for (int i = 0; i < n; i++) {\n                for (Edge e : adj.get(i)) {\n                    e.flow = 0;\n                }\n            }\n            Arrays.fill(potential, 0);\n            Arrays.fill(dist, 0);\n            Arrays.fill(back, null);\n            while (dijkstra(source, sink) < Integer.MAX_VALUE) {\n                for (int u = 0; u < n; u++) {\n                    if (dist[u] < dist[sink]) {\n                        potential[u] += dist[u] - dist[sink];\n                    }\n                }\n                long f = Long.MAX_VALUE;\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    f = Math.min(f, e.cap - e.flow);\n                }\n                for (Edge e = back[sink]; e != null; e = back[e.src]) {\n                    e.flow += f;\n                    adj.get(e.dst).get(e.rev).flow -= f;\n                }\n                flow += f;\n                cost += f * (potential[sink] - potential[source]);\n            }\n            return flow;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        MinCostMaxFlow g = new MinCostMaxFlow((n + 2) * 102);\n        for (int i = 0; i < 102; i++) {\n            g.addEdge((i * (n + 2)) + 1, i * (n + 2), 100, i * c);\n        }\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < n + 1; j++) {\n                g.addEdge(j + (i * (n + 2)), j + ((i + 1) * (n + 2)), 100, 0);\n            }\n        }\n        for (int i = 0; i < k; i++) {\n            int u = Integer.parseInt(br.readLine());\n            g.addEdge(n + 1, u, 1, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(u + (j * (n + 2)), v + ((j + 1) * (n + 2)), 1, (2 * f + 1) * d);\n                    g.addEdge(v + (j * (n + 2)), u + ((j + 1) * (n + 2)), 1, (2 * f + 1) * d);\n                }\n            }\n        }\n\n        pw.println(g.maxFlow(n + 1, (101 * (n + 2))) * c);\n\n        pw.close();\n    }\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.06470619142055511, -0.006911864038556814, -0.3147122859954834, -0.009091392159461975, -0.0002716552698984742, -0.3875086009502411, -0.6273219585418701, -0.00013328486238606274, -1.9908149624825455e-05, -0.008078514598309994, -0.20891274511814117, -0.02853279374539852, -2.5391900635440834e-05, -0.06877339631319046, -0.23960965871810913, -0.01384415477514267, -0.36719876527786255, -0.21978434920310974, -0.4707128405570984, -0.027750959619879723, -9.334523201687261e-05, -0.013294040225446224, -0.03642857447266579, -0.00395584711804986, -0.001751823932863772, -0.009794299490749836, -0.0019254134967923164, -0.01446792297065258, -2.0265599687263602e-06, -0.4935259222984314, -0.0018328524893149734, -0.0020274794660508633, -0.006228192243725061, -0.004314657300710678, -1.9431303371675313e-05, -0.26313769817352295, -0.00017400109209120274, -0.16036899387836456, -0.07004695385694504, -0.3165770173072815, -4.184333738521673e-05, -0.06536735594272614, -0.04845739156007767, -0.32354259490966797, -0.0004205992154311389, -0.008945842273533344, -5.400326699600555e-05, -0.011804602108895779, -1.0132840543519706e-05, -0.021153347566723824, -0.007803289219737053, -0.0036804969422519207, -1.9073504518019035e-06, -0.44767212867736816, -0.13223809003829956, -0.0004205992154311389, -0.00022503285435959697, -0.0017128942999988794, -0.011018738150596619, -4.410753263073275e-06, -0.1518581062555313, -0.011906655505299568, -0.004043038934469223, -0.08058422058820724, -2.3841887468734