ouble amag = a.mag();\n    double bmag = b.mag();\n    double abmag = a.v * b.v + a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z;\n    double angle = acos(abmag / (amag * bmag)) * 180.0 / M_PI;\n    return angle < 90;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n;\n    cin >> n;\n    if (n > 11) {\n        cout << 0 << \"\\n\";\n        return 0;\n    }\n    vector<Point> arr;\n    for (int i = 0; i < n; i++) {\n        int a, b, c, d, e;\n        cin >> a >> b >> c >> d >> e;\n        arr.emplace_back(a, b, c, d, e);\n    }\n    unordered_set<int> good;\n    for (int i = 0; i < n; i++) {\n        bool b = true;\n        for (int j = 0; j < n; j++) {\n            for (int k = 0; k < n; k++) {\n                if (i != j && i != k && j != k) {\n                    Point one = arr[j];\n                    Point two = arr[k];\n                    Point three = arr[i];\n                    Point lol2(one.v - three.v, one.w - three.w, one.x - three.x, one.y - three.y, one.z - three.z);\n                    Point lol1(two.v - three.v, two.w - three.w, two.x - three.x, two.y - three.y, two.z - three.z);\n                    if (angle(lol1, lol2)) {\n                        b = false;\n                    }\n                }\n            }\n        }\n        if (b) {\n            good.insert(i + 1);\n        }\n    }\n    if (good.empty()) {\n        cout << 0 << \"\\n\";\n    } else {\n        cout << good.size() << \"\\n\";\n        for (int i : good) {\n            cout << i << \"\\n\";\n        }\n    }\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0048187305219471455, -2.463036435074173e-05, -0.201589435338974, -8.41866585687967e-06, -8.2994620242971e-06, -2.2200749754119897e-06, -0.0029230411164462566, -5.490809417096898e-05, 0.0, -1.9361264946837764e-07, -0.042633261531591415, -0.3934829533100128, -0.0014282134361565113, -8.149051427608356e-05, -0.00013166792632546276, -0.002