s(-1)\n\ndef go(n):\n    if n == 0:\n        return 0\n    k = 1\n    cnt = 1\n    while k * 10 + 1 < n:\n        k = k * 10 + 1\n        cnt += 1\n    option1 = go(n % k) + (n // k) * cnt\n    option2 = go((k * 10 + 1 - n) % k) + (cnt + 1) + ((k * 10 + 1 - n) // k) * cnt\n    return min(option1, option2)\n\ndef solve():\n    n = int(input())\n    print(go(n))\n\ndef gcd(a, b):\n    while b != 0:\n        r = a % b\n        a = b\n        b = r\n    return a\n\ndef lcm(a, b):\n    return a // gcd(a, b) * b\n\ndef fpow(n, k, p):\n    r = 1\n    while k > 0:\n        if k % 2 == 1:\n            r = (r * n) % p\n        n = (n * n) % p\n        k >>= 1\n    return r\n\ndef FloorOfNthRoot(x, n):\n    if n <= 0 or x < 0:\n        raise ValueError()\n    if x == 0:\n        return 0\n    if n == 1:\n        return x\n    a = 0\n    b = 1 << (1 + x.bit_length() // n)\n    while True:\n        a = b\n        b = (a * (n - 1) + x // (a ** (n - 1))) // n\n        if b >= a:\n            break\n    return a\n\ndef sqrt_decimal(A, SCALE):\n    x0 = Decimal(\"0\")\n    x1 = Decimal(math.sqrt(float(A)))\n    while x0 != x1:\n        x0 = x1\n        x1 = A / x1\n        x1 = x1 + x0\n        x1 = x1 / Decimal(2)\n        x1 = x1.quantize(Decimal(10) ** -SCALE, rounding=ROUND_HALF_UP)\n    return x1\n\nclass SegmentTree:\n    def __init__(self):\n        self.maxn = 100010\n        self.st = [0] * (4 * self.maxn)\n    \n    def update(self, node, i, L, R, val):\n        if i < L or i > R:\n            return\n        if L == R:\n            self.st[node] += val\n            return\n        self.update(node << 1, i, L, (L + R) >> 1, val)\n        self.update((node << 1) + 1, i, ((L + R) >> 1) + 1, R, val)\n        self.st[node] = self.st[node << 1] + self.st[(node << 1) + 1]\n    \n    def query(self, node, l, r, L, R):\n        if l > R or r < L:\n            return 0\n        if l <= L and r >= R:\n            return self.st[node]\n        return (self.query(node << 1, l, r, L, (L + R) >> 1) + \n                self.query((node << 1) + 1, l, r, ((L + R) >> 1) + 1, R))\n\nclass Matrix:\n    def __init__(self):\n        self.maxn = 2\n        self.x = [[0] * self.maxn for _ in range(self.maxn)]\n    \n    def mul(self, A):\n        res = Matrix()\n        for i in range(self.maxn):\n            for k in range(self.maxn):\n                for j in range(self.maxn):\n                    res.x[i][j] = (res.x[i][j] + self.x[i][k] * A.x[k][j]) % MOD\n        return res\n    \n    def pow(self, k):\n        res = Matrix()\n        T = Matrix()\n        # Copy current matrix to res and T\n        for i in range(self.maxn):\n            for j in range(self.maxn):\n                res.x[i][j] = self.x[i][j]\n                T.x[i][j] = self.x[i][j]\n        k -= 1\n        while k > 0:\n            if k & 1:\n                res = res.mul(T)\n            T = T.mul(T)\n            k >>= 1\n        return res\n\nclass Pair:\n    def __init__(self, fi, se):\n        self.fi = fi\n        self.se = se\n    \n    def __lt__(self, oth):\n        if self.fi > oth.fi:\n            return False\n        if self.fi < oth.fi:\n            return True\n        if self.se > oth.se:\n            return False\n        if self.se < oth.se:\n            return True\n        return False\n    \n    def __eq__(self, oth):\n        return self.fi == oth.fi and self.se == oth.se\n\ndef main():\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.046303264563903e-05, -7.152555099310121e-07, -1.311301275563892e-06, -0.0001734344696160406, -0.06393466889858246, -9.775113539944869e-06, -0.005239683203399181, -0.0015467357588931918, -1.7046782886609435e-05, -0.2254149168729782, -0.02204403467476368, 0.0, -4.672895011026412e-05, -2.264974000354414e-06, -0.16153277456760406, -4.768360213347478e-06, -3.4570634852570947e-06, -0.5796756148338318, -0.029760021716356277, -0.00784920621663332, -1.192092