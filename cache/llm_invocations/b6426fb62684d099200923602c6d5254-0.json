       result += temp;\n                } else if (n == 3) {\n                    result += (arr[0] == '_') ? 9 : 1;\n                }\n            }\n        }\n\n        return result;\n    }\n\n    static long matchPattern(char[] arr, String suffix, int n, int unknowns) {\n        if (n < 2) return 0;\n        char last = suffix.charAt(1);\n        char first = suffix.charAt(0);\n        if ((arr[n - 1] == '_' || arr[n - 1] == last) &&\n            (arr[n - 2] == '_' || arr[n - 2] == first)) {\n            return (long) Math.pow(10, unknowns);\n        }\n        return 0;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class B {\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String s = br.readLine().trim();\n        char[] arr = s.toCharArray();\n        int n = arr.length;\n\n        long total = 0;\n        boolean hasX = false;\n        for (char c : arr) {\n            if (c == 'X') {\n                hasX = true;\n                break;\n            }\n        }\n\n        if (hasX) {\n            for (char d = '0'; d <= '9'; d++) {\n                char[] replaced = replaceX(arr, d);\n                total += countValid(replaced);\n            }\n        } else {\n            total += countValid(arr);\n        }\n\n        System.out.println(total);\n    }\n\n    static char[] replaceX(char[] arr, char replacement) {\n        char[] res = new char[arr.length];\n        for (int i = 0; i < arr.length; i++) {\n            res[i] = (arr[i] == 'X') ? replacement : arr[i];\n        }\n        return res;\n    }\n\n    static long countValid(char[] arr) {\n        int n = arr.length;\n        \n        // Check for leading zero\n        if (arr[0] == '0') return 0;\n        if (arr[