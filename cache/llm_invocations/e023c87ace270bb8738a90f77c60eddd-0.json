\ndef compileWD(n, edges):\n    g = [[] for _ in range(n)]\n    # Clone edges\n    for e in edges:\n        clone = Edge(e.to, e.from_, e.capacity, -e.cost)\n        clone.flow = e.capacity\n        clone.complement = e\n        e.complement = clone\n        edges.append(clone)\n    p = [0] * n\n    for e in edges:\n        p[e.from_] += 1\n    for e in edges:\n        g[e.from_].append(e)\n    return g\n\ndef solveMinCostFlow(g, source, sink, all_flow):\n    n = len(g)\n    mincost = 0\n    potential = [0] * n\n    INF = 10**9\n    while all_flow > 0:\n        d = [INF] * n\n        inedge = [None] * n\n        d[source] = 0\n        # Priority queue for Dijkstra\n        heap = [(0, source)]\n        while heap:\n            dist, u = heapq.heappop(heap)\n            if dist > d[u]:\n                continue\n            for e in g[u]:\n                if e.capacity - e.flow > 0:\n                    nd = d[u] + e.cost + potential[u] - potential[e.to]\n                    if d[e.to] > nd:\n                        d[e.to] = nd\n                        inedge[e.to] = e\n                        heapq.heappush(heap, (nd, e.to))\n        if inedge[sink] is None:\n            break\n        minflow = all_flow\n        sumcost = 0\n        e = inedge[sink]\n        while e:\n            residual = e.capacity - e.flow\n            if residual < minflow:\n                minflow = residual\n            sumcost += e.cost\n            e = inedge[e.from_]\n        mincost += minflow * sumcost\n        e = inedge[sink]\n        while e:\n            e.flow += minflow\n            e.complement.flow -= minflow\n            e = inedge[e.from_]\n        all_flow -= minflow\n        for i in range(n):\n            potential[i] += d[i]\n    return mincost\n\ndef ni():\n    return int(sys.stdin.readline())\n\ndef ns(n):\n    return sys.stdin.readline().strip()[:n]\n\ndef na(n):\n    return list(map(int, sys.stdin.readline().split()))\n\nif __name__ == \"__main__\":\n    solve()\n</tr