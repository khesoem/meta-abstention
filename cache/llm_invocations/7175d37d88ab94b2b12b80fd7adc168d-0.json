{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = (ll)1e18;\nconst int MAXN = 6000;\n\nvector<int> to_arr;\nvector<ll> cap_arr;\nvector<ll> cost_arr;\nvector<int> g2[MAXN];\n\nll dist2[MAXN];\nint pre1[MAXN], pre2[MAXN];\nbool inq2[MAXN];\nint n2, s2, t2;\n\nvoid init2(int n, int s, int t) {\n    to_arr.clear();\n    cap_arr.clear();\n    cost_arr.clear();\n    for (int i = 0; i <= n; ++i) g2[i].clear();\n    n2 = n;\n    s2 = s;\n    t2 = t;\n}\n\nvoid add_flow_edge(int u, int v, ll c, ll w) {\n    int id = (int)to_arr.size();\n    to_arr.push_back(v);\n    cap_arr.push_back(c);\n    cost_arr.push_back(w);\n    to_arr.push_back(u);\n    cap_arr.push_back(0);\n    cost_arr.push_back(-w);\n    g2[u].push_back(id);\n    g2[v].push_back(id ^ 1);\n}\n\nll get_min_cost_flow(ll f) {\n    ll ans = 0;\n    while (f > 0) {\n        fill(dist2, dist2 + n2, INF);\n        dist2[s2] = 0;\n        queue<int> q;\n        q.push(s2);\n        inq2[s2] = true;\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq2[u] = false;\n            for (int eid : g2[u]) {\n                if (cap_arr[eid] > 0 && dist2[u] + cost_arr[eid] < dist2[to_arr[eid]]) {\n                    dist2[to_arr[eid]] = dist2[u] + cost_arr[eid];\n                    pre1[to_arr[eid]] = u;\n                    pre2[to_arr[eid]] = eid;\n                    if (!inq2[to_arr[eid]]) {\n                        inq2[to_arr[eid]] = true;\n                        q.push(to_arr[eid]);\n                    }\n                }\n            }\n        }\n        if (dist2[t2] == INF) return -1;\n        ll add = f;\n        for (int v = t2; v != s2; v = pre1[v])\n            add = min(add, cap_arr[pre2[v]]);\n        f -= add;\n        ans += add * dist2[t2];\n        for (int v = t2; v != s2; v = pre1[v]) {\n            int eid = pre2[v];\n            cap_arr[eid] -= add;\n            cap_arr[eid ^ 1] += add;\n        }\n    }\n    return ans;\n}\n\nll N, M, K, C, D;\nll A[58];\nvector<int> H[57];\n\nint32_t main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cin >> N >> M >> K >> C >> D;\n    for (ll i = 1; i <= K; ++i) {\n        int x;\n        cin >> x;\n        A[x]++;\n    }\n    for (int i = 1; i <= M; ++i) {\n        int x, y;\n        cin >> x >> y;\n        H[x].push_back(y);\n        H[y].push_back(x);\n    }\n\n    init2(5103, 0, 5101);\n    for (int i = 2; i <= N; ++i) add_flow_edge(0, i, A[i], 0);\n    for (int i = 0; i <= 100; ++i) {\n        for (int l = 1; l <= N; ++l) {\n            add_flow_edge(50 * i + l, 50 * (i + 1) + l, K, 0);\n            for (int j : H[l]) {\n                for (ll k = 1; k <= K; ++k) {\n                    add_flow_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                }\n            }\n        }\n    }\n    for (int i = 1; i <= 101; ++i) add_flow_edge(50 * i + 1, 5101, K, C * i);\n    cout << get_min_cost_flow(K) << endl;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\nto_arr = []\ncap_arr = []\ncost_arr = []\ng2 = [[] for _ in range(6000)]  # we'll resize later\n\ndist2 = [0] * 6000\npre1 = [0] * 6000\npre2 = [0] * 6000\ninq2 = [False] * 6000\n\nn2 = 0\ns2 = 0\nt2 = 0\n\ndef init2(n, s, t):\n    global n2, s2, t2, to_arr, cap_arr, cost_arr, g2\n    to_arr.clear()\n    cap_arr.clear()\n    cost_arr.clear()\n    # clear g2: we need to reset each sublist\n    for i in range(n+1):\n        g2[i].clear()\n    # ensure g2 has enough capacity, but we already allocated 6000\n    n2 = n\n    s2 = s\n    t2 = t\n\ndef add_flow_edge(u, v, c, w):\n    global to_arr, cap_arr, cost_arr, g2\n    # forward edge\n    to_arr.append(v)\n    cap_arr.append(c)\n    cost_arr.append(w)\n    # reverse edge\n    to_arr.append(u)\n    cap_arr.append(0)\n    cost_arr.append(-w)\n    eid = len(to_arr) - 2   # forward edge index\n    g2[u].append(eid)\n    g2[v].append(eid ^ 1)\n\ndef get_min_cost_flow(f):\n    global dist2, pre1, pre2, inq2, n2, s2, t2\n    ans = 0\n    while f > 0:\n        dist2 = [INF] * n2\n        dist2[s2] = 0\n        q = deque()\n        q.append(s2)\n        inq2[s2] = True\n        while q:\n            u = q.popleft()\n            inq2[u] = False\n            for eid in g2[u]:\n                if cap_arr[eid] > 0 and dist2[u] + cost_arr[eid] < dist2[to_arr[eid]]:\n                    dist2[to_arr[eid]] = dist2[u] + cost_arr[eid]\n                    pre1[to_arr[eid]] = u\n                    pre2[to_arr[eid]] = eid\n                    if not inq2[to_arr[eid]]:\n                        inq2[to_arr[eid]] = True\n                        q.append(to_arr[eid])\n        if dist2[t2] == INF:\n            return -1\n        add = f\n        v = t2\n        while v != s2:\n            add = min(add, cap_arr[pre2[v]])\n            v = pre1[v]\n        f -= add\n        ans += add * dist2[t2]\n        v = t2\n        while v != s2:\n            eid = pre2[v]\n            cap_arr[eid] -= add\n            cap_arr[eid ^ 1] += add\n            v = pre1[v]\n    return ans\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    A = [0] * (N + 1)   # 1-indexed\n    for _ in range(K):\n        x = int(next(it))\n        A[x] += 1\n\n    H = [[] for _ in range(N + 1)]\n    for _ in range(M):\n        x = int(next(it))\n        y = int(next(it))\n        H[x].append(y)\n        H[y].append(x)\n\n    init2(5103, 0, 5101)\n\n    # source edges: from node 0 to nodes with people\n    for i in range(2, N + 1):\n        if A[i] > 0:\n            add_flow_edge(0, i, A[i], 0)\n\n    # time steps 0..100 (101 steps)\n    for i in range(0, 101):\n        # waiting edges (self-loop)\n        for l in range(1, N + 1):\n            add_flow_edge(50 * i + l, 50 * (i + 1) + l, K, 0)\n        # moving edges\n        for l in range(1, N + 1):\n            for j in H[l]:\n                for k in range(1, K + 1):\n                    add_flow_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1))\n\n    # sink edges from node 1 at each time step\n    for i in range(1, 102):\n        add_flow_edge(50 * i + 1, 5101, K, C * i)\n\n    ans = get_min_cost_flow(K)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -0.00012718822108581662, -0.00021073981770314276, -4.172316494077677e-06, -2.3841855067985307e-07, -1.5497195136049413e-06, -0.00016640232934150845, -0.11067777127027512, -9.536738616588991e-07, -1.9192511899746023e-05, -1.6689286894688848e-06, -0.12692910432815552, -2.0146166207268834e-05, -0.07958883792161942, -0.22937826812267303, -1.311301275563892e-06, -0.00014661667228210717, -0.004108797758817673, -1.0728830375228426e-06, 0.0, -