Num = -1;\n        long bestDen = 0;\n\n        for (long i = 1; i <= n; ++i) {\n            long j = i * x / y;\n            if (i * x - j * y > (j + 1) * y - i * x) {\n                ++j;\n            }\n            if (bestNum == -1 ||\n                Math.abs(bestNum * y - x * bestDen) * i >\n                Math.abs(j * y - x * i) * bestDen) {\n                bestNum = j;\n                bestDen = i;\n            }\n        }\n\n        System.out.println(bestNum + \"/\" + bestDen);\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, 0.0, -2.1219027985353023e-05, -6.353653589030728e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -0.00033682872890494764, -0.0015070997178554535, -4.577531944960356e-05, 0.0, -0.001636000582948327, -7.676783570786938e-05, -9.703165414975956e-05, -0.008030745200812817, 0.0, -0.018151599913835526, 0.0, -2.3841855067985307e-07, -5.960462772236497e-07, 0.0, -3.576278118089249e-07, -1.1920922133867862e-06, 0.0, -4.672895011026412e-05, -0.4796363115310669, 0.0, 0.0, 0.0, -0.0025512785650789738, -1.9550132492440753e-05, -0.0006283930852077901, -3.5523738915799186e-05, -6.949660019017756e-05, -2.7418097943154862e-06, -0.014168855734169483, -5.709961988031864e-05, -4.136476854910143e-05, -1.7046782886609435e-05, -7.045020902296528e-05, -8.344646857949556e-07, -5.483612312673358e-06, -1.5497195136049413e-06, -8.344646857949556e-07, -0.0075597395189106464, -0.0010527789127081633, -0.0002935693773906678, -0.008271957747638226, -2.7656173188006505e-05, -0.00014029949670657516, -0.024606406688690186, -9.369411418447271e-05, -0.0002464944263920188, -0.0007367995567619801, -0.00027259447961114347, -0.11300038546323776, -0.02982505038380623, -0.030051924288272858, -0.001444011926651001, -0.03403148800134659, -4.0531076592742465e-06, -9.393251093570143e-05, -9.011816291604191e-05, -0.16171512007713318, -0.00020716428116429597, -0.00043394684325903654, -1.4305012882687151e-05, -0.00