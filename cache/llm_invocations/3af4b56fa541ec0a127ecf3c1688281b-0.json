bs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\nconst ll MOD = 1000000007;\nconst ll INF = (ll)1e18 + 1;\n\nll nCr[100][100];\n\nll f(ll p, int a, int b, int c, int d) {\n    p = p * nCr[a][b] % MOD;\n    p = p * nCr[c][d] % MOD;\n    return p;\n}\n\nstruct Tuple {\n    ll d;\n    int x, y, z;\n    Tuple(ll d, int x, int y, int z) : d(d), x(x), y(y), z(z) {}\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    // Precompute nCr\n    for (int i = 0; i < 100; ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if (j == 0 || j == i)\n                nCr[i][j] = 1;\n            else\n                nCr[i][j] = (nCr[i-1][j] + nCr[i-1][j-1]) % MOD;\n        }\n    }\n\n    int n, K;\n    cin >> n >> K;\n    int cnt1 = 0, cnt2 = 0;\n    for (int i = 0; i < n; ++i) {\n        int x;\n        cin >> x;\n        if (x == 50) cnt1++;\n        else cnt2++;\n    }\n\n    // dist and dp arrays: [200][200][2]\n    vector<vector<vector<ll>>> dist(200, vector<vector<ll>>(200, vector<ll>(2, INF)));\n    vector<vector<vector<ll>>> dp(200, vector<vector<ll>>(200, vector<ll>(2, 0)));\n\n    dist[0][0][0] = 0;\n    dp[0][0][0] = 1;\n\n    queue<Tuple> q;\n    q.push(Tuple(0, 0, 0, 0));\n\n    while (!q.empty()) {\n        Tuple cur = q.front(); q.pop();\n        int x = cur.x, y = cur.y, z = cur.z;\n        ll d = dist[x][y][z];\n\n        if (z == 0) {\n            int rem_x = cnt1 - x;\n            int rem_y = cnt2 - y;\n            for (int i = 0; i <= rem_x; ++i) {\n                for (int j = 0; j <= rem_y; ++j) {\n                    if (i + j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int nx = x + i, ny = y + j, nz = z ^ 1;\n                    if (dist[nx][ny][nz] >= d + 1) {\n                        ll ways = f(dp[x][y][z], rem_x, i, rem_y, j);\n                        if (dist[nx][ny][nz] > d + 1) {\n                            dist[nx][ny][nz] = d + 1;\n                            q.push(Tuple(dist[nx][ny][nz], nx, ny, nz));\n                            dp[nx][ny][nz] = ways % MOD;\n                        } else {\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + ways) % MOD;\n                        }\n                    }\n                }\n            }\n        } else {\n            int rem_x = x;\n            int rem_y = y;\n            for (int i = 0; i <= rem_x; ++i) {\n                for (int j = 0; j <= rem_y; ++j) {\n                    if (i + j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int nx = x - i, ny = y - j, nz = z ^ 1;\n                    if (dist[nx][ny][nz] >= d + 1) {\n                        ll ways = f(dp[x][y][z], rem_x, i, rem_y, j);\n                        if (dist[nx][ny][nz] > d + 1) {\n                            dist[nx][ny][nz] = d + 1;\n                            q.push(Tuple(dist[nx][ny][nz], nx, ny, nz));\n                            dp[nx][ny][nz] = ways % MOD;\n                        } else {\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + ways) % MOD;\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    if (dist[cnt1][cnt2][1] == INF)\n        cout << -1 << '\\n';\n    else\n        cout << dist[cnt1][cnt2][1] << '\\n';\n    cout << dp[cnt1][cnt2][1] << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.539125671319198e-05, 0.0, -1.1920928244535389e-07, -0.0003849719068966806, -0.00038044367101974785, -3.564294092939235e-05, -0.4741828739643097, -3.576278118089249e-07, 0.0, 0.0, -0.000580499938223511, -1.9430925021879375e-05, 0.0, 0.0, -0.16023415327072144, -0.2607579231262207, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.9205850296420977e-05, -0.3868791162967682, -7.65294389566406