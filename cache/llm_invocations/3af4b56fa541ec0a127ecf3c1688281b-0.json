bs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <queue>\n#include <algorithm>\n\nusing namespace std;\ntypedef long long ll;\n\nconst ll MOD = 1000000007;\nconst ll INF = (ll)1e18 + 1;\n\nll nCr[100][100];\n\nll f(ll p, int a, int b, int c, int d) {\n    p = p * nCr[a][b] % MOD;\n    p = p * nCr[c][d] % MOD;\n    return p;\n}\n\nstruct Tuple {\n    ll d;\n    int x, y, z;\n};\n\nint main() {\n    for (int i = 0; i < 100; i++) {\n        for (int j = 0; j <= i; j++) {\n            if (j == 0 || j == i)\n                nCr[i][j] = 1;\n            else\n                nCr[i][j] = (nCr[i-1][j] + nCr[i-1][j-1]) % MOD;\n        }\n    }\n\n    int n, K;\n    cin >> n >> K;\n    int cnt1 = 0, cnt2 = 0;\n    for (int i = 0; i < n; i++) {\n        int x;\n        cin >> x;\n        if (x == 50) cnt1++;\n        else cnt2++;\n    }\n\n    static ll dist[200][200][2];\n    static ll dp[200][200][2];\n\n    for (int i = 0; i < 200; i++) {\n        for (int j = 0; j < 200; j++) {\n            for (int k = 0; k < 2; k++) {\n                dist[i][j][k] = INF;\n                dp[i][j][k] = 0;\n            }\n        }\n    }\n\n    dist[0][0][0] = 0;\n    dp[0][0][0] = 1;\n\n    queue<Tuple> q;\n    q.push({0, 0, 0, 0});\n\n    while (!q.empty()) {\n        Tuple cur = q.front();\n        q.pop();\n        int x = cur.x, y = cur.y, z = cur.z;\n        ll d = cur.d;\n\n        if (z == 0) {\n            int rem_x = cnt1 - x;\n            int rem_y = cnt2 - y;\n            for (int i = 0; i <= rem_x; i++) {\n                for (int j = 0; j <= rem_y; j++) {\n                    if (i + j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int newx = x + i;\n                    int newy = y + j;\n                    int newz = z ^ 1;\n                    if (dist[newx][newy][newz] >= d + 1) {\n                        if (dist[newx][newy][newz] > d + 1) {\n                            dist[newx][newy][newz] = d + 1;\n                            q.push({d + 1, newx, newy, newz});\n                        }\n                        ll add = f(dp[x][y][z], rem_x, i, rem_y, j);\n                        dp[newx][newy][newz] = (dp[newx][newy][newz] + add) % MOD;\n                    }\n                }\n            }\n        } else {\n            int rem_x = x;\n            int rem_y = y;\n            for (int i = 0; i <= rem_x; i++) {\n                for (int j = 0; j <= rem_y; j++) {\n                    if (i + j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int newx = x - i;\n                    int newy = y - j;\n                    int newz = z ^ 1;\n                    if (dist[newx][newy][newz] >= d + 1) {\n                        if (dist[newx][newy][newz] > d + 1) {\n                            dist[newx][newy][newz] = d + 1;\n                            q.push({d + 1, newx, newy, newz});\n                        }\n                        ll add = f(dp[x][y][z], rem_x, i, rem_y, j);\n                        dp[newx][newy][newz] = (dp[newx][newy][newz] + add) % MOD;\n                    }\n                }\n            }\n        }\n    }\n\n    if (dist[cnt1][cnt2][1] == INF)\n        cout << -1 << '\\n';\n    else\n        cout << dist[cnt1][cnt2][1] << '\\n';\n    cout << dp[cnt1][cnt2][1] << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.010930425487458706, -0.0004557524516712874, -1.6689286894688848e-06, 0.0, 0.0, -0.00028606137493625283, -0.0002261144545627758, -1.0728830375228426e-06, -3.933898824470816e-06, -2.753696753643453e-05, 0.0, 0.0, -1.1920922133867862e-06, -0.1602480709552765, -0.048710983246564865, 0.0, -0.12737734615802765, -1.1374926567077637, -0.006761173252016306, -2.861018856492592e-06, 0.0, -0.06197433918714523, -0.00016199229867197573, -1.1920928244535389e-07, 0.0, -2.777537883957