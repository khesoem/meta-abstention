ublic static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        long m = sc.nextLong();\n\n        M[][] bi = new M[65][65];\n        M I = new M((int) (m + 1));\n        for (int i = 0; i <= m; i++) {\n            I.s[i][i] = 1;\n        }\n\n        // compute x and y = m^x\n        long y = 1;\n        int x = 0;\n        while (y * m <= n) {\n            y *= m;\n            x++;\n        }\n\n        // base matrix for t=0\n        bi[0][0] = new M((int) (m + 1));\n        for (int i = 0; i <= m; i++) {\n            bi[0][0].s[i][i] = 1;\n            bi[0][0].s[0][i] = 1;\n        }\n\n        // compute bi[t][i] for t=0..x, i=0..m-1\n        for (int t = 0; t <= x; t++) {\n            if (t > 0) {\n                bi[t][0] = bi[t - 1][0].copy();\n                for (int i = 1; i < m; i++) {\n                    bi[t][0] = M.multiply(bi[t][0], bi[t - 1][i]);\n                }\n            }\n            for (int i = 1; i < m; i++) {\n                M tmp = bi[t][i - 1].copy();\n                // rotate rows\n                for (int j = (int) (m - 2); j >= 0; j--) {\n                    for (int k = 0; k <= m; k++) {\n                        long temp = tmp.s[j][k];\n                        tmp.s[j][k] = tmp.s[j + 1][k];\n                        tmp.s[j + 1][k] = temp;\n                    }\n                }\n                // rotate columns\n                for (int j = (int) (m - 2); j >= 0; j--) {\n                    for (int k = 0; k <= m; k++) {\n                        long temp = tmp.s[k][j];\n                        tmp.s[k][j] = tmp.s[k][j + 1];\n                        tmp.s[k][j + 1] = temp;\n                    }\n                }\n                bi[t][i] = tmp;\n            }\n        }\n\n        long add = 0;\n        int z = 0;\n        while (add < n) {\n            if (add <= n - y) {\n                add += y;\n                I = M.multiply(I, bi[x][z]);\n             