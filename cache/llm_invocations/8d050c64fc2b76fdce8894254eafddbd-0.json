nt id = adj[u][i];\n        auto& e = edges[id];\n        if (dist[e.v] != dist[u] + 1) continue;\n        ll pushed = dfs(e.v, min(flow, (ll)e.cap - e.flow));\n        if (pushed) {\n            e.flow += pushed;\n            edges[id ^ 1].flow -= pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\n\nll dinic() {\n    ll flow = 0;\n    while (bfs()) {\n        memset(ptr, 0, sizeof(ptr));\n        ll pushed;\n        while ((pushed = dfs(src, INF)) > 0)\n            flow += pushed;\n    }\n    return flow;\n}\n\nstring scientists[101], reactors[101];\nbool reachable[10][10][10][10];\nint visited[101][101];\nint unusable_at[10][10];\nint n, m;\n\nbool valid(int r, int c) {\n    return r >= 0 && c >= 0 && r < n && c < m;\n}\n\nint id(int x, int y) { return 1 + m * x + y; }\n\nint main() {\n    ios::sync_with_stdio(false);\n    int T;\n    cin >> n >> T;\n    ++T;\n    m = n;\n    snk = m * m * 2 + 1;\n    src = 0;\n    adj.resize(m * m * 2 + 2);\n    queue<pair<int, int>> q;\n    for (int i = 0; i < n; ++i) cin >> scientists[i];\n    for (int i = 0; i < n; ++i) {\n        cin >> reactors[i];\n        for (int j = 0; j < m; ++j) {\n            unusable_at[i][j] = INF;\n            if (reactors[i][j] == 'Z') {\n                q.push({i, j});\n                unusable_at[i][j] = 1;\n            }\n        }\n    }\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        for (int di = -1; di <= 1; ++di)\n            for (int dj = -1; dj <= 1; ++dj)\n                if (abs(di) + abs(dj) == 1) {\n                    int nx = x + di, ny = y + dj;\n                    if (valid(nx, ny) && unusable_at[nx][ny] == INF && scientists[nx][ny] != 'Y') {\n                        unusable_at[nx][ny] = unusable_at[x][y] + 1;\n                        q.push({nx, ny});\n                    }\n                }\n    }\n    for (int x = 0; x < n; ++x)\n        for (int y = 0; y < m; ++y) {\n            if (scientists[x][y] >= '1' && scientists[x][y] <= '9')\n                add_edge(src, id(x, y), scientists[x][y] - '0');\n            if (reactors[x][y] >= '1' && reactors[x][y] <= '9')\n                add_edge(n * n + id(x, y), snk, reactors[x][y] - '0');\n            for (int X = 0; X < n; ++X)\n                for (int Y = 0; Y < m; ++Y) {\n                    if (scientists[x][y] == 'Y' || scientists[x][y] == 'Z' ||\n                        reactors[X][Y] == 'Y' || reactors[X][Y] == 'Z')\n                        continue;\n                    memset(visited, 0, sizeof(visited));\n                    queue<tuple<int, int, int>> bfsq;\n                    bfsq.emplace(x, y, 1);\n                    visited[x][y] = 1;\n                    while (!bfsq.empty()) {\n                        auto [cx, cy, t] = bfsq.front(); bfsq.pop();\n                        if (cx == X && cy == Y) {\n                            visited[cx][cy] = 1;\n                            break;\n                        }\n                        if (t >= unusable_at[cx][cy] || t >= T) continue;\n                        for (int di = -1; di <= 1; ++di)\n                            for (int dj = -1; dj <= 1; ++dj)\n                                if (abs(di) + abs(dj) == 1) {\n                                    int nx = cx + di, ny = cy + dj;\n                                    if (valid(nx, ny) && !visited[nx][ny] &&\n                                        scientists[nx][ny] != 'Y' && scientists[nx][ny] != 'Z' &&\n                                        t + 1 <= unusable_at[nx][ny]) {\n                                        visited[nx][ny] = 1;\n                                        bfsq.emplace(nx, ny, t + 1);\n                                    }\n                                }\n                    }\n                    if (visited[X][Y])\n                        add_edge(id(x, y), n * n + id(X, Y), INF);\n                }\n        }\n    cout << dinic() << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9 + 9\n\nclass Edge:\n    def __init__(self, u, v, flow, cap):\n        self.u = u\n        self.v = v\n        self.flow = flow\n        self.cap = cap\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    T = int(data[idx]); idx += 1\n    T += 1\n    m = n\n    snk = m * m * 2 + 1\n    src = 0\n    adj = [[] for _ in range(m * m * 2 + 2)]\n    edges = []\n    \n    def add_edge(u, v, cap):\n        adj[u].append(len(edges))\n        edges.append(Edge(u, v, 0, cap))\n        adj[v].append(len(edges))\n        edges.append(Edge(v, u, 0, 0))\n    \n    scientists = []\n    reactors = []\n    for i in range(n):\n        scientists.append(data[idx]); idx += 1\n    for i in range(n):\n        reactors.append(data[idx]); idx += 1\n    \n    unusable_at = [[INF] * m for _ in range(n)]\n    q = deque()\n    for i in range(n):\n        for j in range(m):\n            if reactors[i][j] == 'Z':\n                q.append((i, j))\n                unusable_at[i][j] = 1\n    \n    while q:\n        x, y = q.popleft()\n        for di in (-1, 0, 1):\n            for dj in (-1, 0, 1):\n                if abs(di) + abs(dj) == 1:\n                    nx, ny = x + di, y + dj\n                    if 0 <= nx < n and 0 <= ny < m and unusable_at[nx][ny] == INF and scientists[nx][ny] != 'Y':\n                        unusable_at[nx][ny] = unusable_at[x][y] + 1\n                        q.append((nx, ny))\n    \n    def valid(r, c):\n        return 0 <= r < n and 0 <= c < m\n    \n    def id_func(x, y):\n        return 1 + m * x + y\n    \n    for x in range(n):\n        for y in range(m):\n            if '1' <= scientists[x][y] <= '9':\n                add_edge(src, id_func(x, y), int(scientists[x][y]))\n            if '1' <= reactors[x][y] <= '9':\n                add_edge(n * n + id_func(x, y), snk, int(reactors[x][y]))\n            for X in range(n):\n                for Y in range(m):\n                    if scientists[x][y] in ('Y', 'Z') or reactors[X][Y] in ('Y', 'Z'):\n                        continue\n                    visited = [[0] * m for _ in range(n)]\n                    bfsq = deque()\n                    bfsq.append((x, y, 1))\n                    visited[x][y] = 1\n                    while bfsq:\n                        cx, cy, t = bfsq.popleft()\n                        if cx == X and cy == Y:\n                            visited[cx][cy] = 1\n                            break\n                        if t >= unusable_at[cx][cy] or t >= T:\n                            continue\n                        for di in (-1, 0, 1):\n                            for dj in (-1, 0, 1):\n                                if abs(di) + abs(dj) == 1:\n                                    nx, ny = cx + di, cy + dj\n                                    if valid(nx, ny) and not visited[nx][ny] and \\\n                                       scientists[nx][ny] not in ('Y', 'Z') and \\\n                                       t + 1 <= unusable_at[nx][ny]:\n                                        visited[nx][ny] = 1\n                                        bfsq.append((nx, ny, t + 1))\n                    if visited[X][Y]:\n                        add_edge(id_func(x, y), n * n + id_func(X, Y), INF)\n    \n    # Dinic's algorithm\n    dist = [-1] * (m * m * 2 + 2)\n    ptr = [0] * (m * m * 2 + 2)\n    \n    def bfs():\n        for i in range(len(dist)):\n            dist[i] = -1\n        dist[src] = 0\n        q = deque()\n        q.append(src)\n        while q:\n            u = q.popleft()\n            for edge_id in adj[u]:\n                e = edges[edge_id]\n                if dist[e.v] == -1 and e.flow < e.cap:\n                    dist[e.v] = dist[u] + 1\n                    q.append(e.v)\n                    if e.v == snk:\n                        return True\n        return False\n    \n    def dfs(u, flow):\n        if u == snk or flow == 0:\n            return flow\n        for i in range(ptr[u], len(adj[u])):\n            ptr[u] = i\n            edge_id = adj[u][i]\n            e = edges[edge_id]\n            if dist[e.v] != dist[u] + 1:\n                continue\n            pushed = dfs(e.v, min(flow, e.cap - e.flow))\n            if pushed:\n                e.flow += pushed\n                edges[edge_id ^ 1].flow -= pushed\n                return pushed\n        return 0\n    \n    flow = 0\n    while bfs():\n        for i in range(len(ptr)):\n            ptr[i] = 0\n        pushed = dfs(src, INF)\n        while pushed > 0:\n            flow += pushed\n            pushed = dfs(src, INF)\n    \n    print(flow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012182447244413197, -7.152555099310121e-07, -1.1920928244535389e-07, -0.34989672899246216, -0.0027751526795327663, -1.1920928244535389e-07, -0.00018094333063345402, -0.000169382052263245, -1.9073468138230965e-06, -7.426462980220094e-05, -0.043011102825403214, -0.04400600865483284, -1.1920928244535389e-07, -0.001611959422007203, 0.0, -3.576214658096433e-05, -0.008714266121387482, -2.3841830625315197e-06, -1.1920928244535389e-07, 0.0, -2.0265558760002023e-06, -5.2927523938706145e-05, -0.016805384308099747, -1.4066597032069694e-05, -1.4305104514278355e-06, -2.3841855067985307e-07, -0.07889030128717422, -2.9802276912960224e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -2.622600959512056e-06, 0.0, -9.536738616588991e-07, 0.0, 0.0, 0.0, -0.14268769323825836, -5.125986263010418e-06, -3.6954811548639555e-06, -0.0001308832288486883, -3.814689989667386e-06, -2.3841855067985307e-07, -1.311301275563892e-06, -2.622600959512056e-06, -2.3841855067985307e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -1.0728830375228426e-06, -1.7165990357170813e-05