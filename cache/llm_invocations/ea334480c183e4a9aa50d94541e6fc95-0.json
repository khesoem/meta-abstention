ments inside parentheses\n        int count = 0;\n        inParen = false;\n        StringBuilder segment = new StringBuilder();\n        for (char c : s.toCharArray()) {\n            if (c == '(') {\n                inParen = true;\n                segment.setLength(0);\n            } else if (c == ')') {\n                if (inParen) {\n                    String seg = segment.toString();\n                    if (!seg.isEmpty()) {\n                        String[] parts = seg.split(\"_+\", -1);\n                        for (String p : parts) {\n                            if (!p.isEmpty()) count++;\n                        }\n                    }\n                }\n                inParen = false;\n            } else if (inParen) {\n                segment.append(c);\n            }\n        }\n        \n        System.out.println(count);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <algorithm>\n#include <sstream>\n\nint main() {\n    int n;\n    std::string s;\n    \n    std::cin >> n;\n    std::cin >> s;\n    \n    // First pass: compute max length of non-parenthesized segments\n    int maxLen = 0;\n    int currLen = 0;\n    bool inParen = false;\n    \n    for (char c : s) {\n        if (c == '(') {\n            inParen = true;\n            if (currLen > 0) {\n                maxLen = std::max(maxLen, currLen);\n                currLen = 0;\n            }\n        } else if (c == ')') {\n            inParen = false;\n            if (currLen > 0) {\n                maxLen = std::max(maxLen, currLen);\n                currLen = 0;\n            }\n        } else if (!inParen) {\n            currLen++;\n        }\n    }\n    if (currLen > 0) {\n        maxLen = std::max(maxLen, currLen);\n    }\n    \n    std::cout << maxLen << std::endl;\n    \n    // Second pass: count 