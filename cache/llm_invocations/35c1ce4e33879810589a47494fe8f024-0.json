{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3.11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3.11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1000*1000*1000;\n\nstruct rib {\n\tint b, u, c, f;\n\tsize_t back;\n};\n\nvoid add_rib (vector < vector<rib> > & g, int a, int b, int u, int c) {\n\trib r1 = { b, u, c, 0, g[b].size() };\n\trib r2 = { a, 0, -c, 0, g[a].size() };\n\tg[a].push_back (r1);\n\tg[b].push_back (r2);\n}\n\nint main()\n{\n\tint N, m, k, c, d;\n\tscanf(\"%d %d %d %d %d\", &N, &m, &k, &c, &d);\n\tint n = N * 101 + 2;\n\tvector < vector<rib> > g (n);\n\tfor (int i = 0; i < k; i++) {\n\t\tint x;\n\t\tscanf(\"%d\", &x);\n\t\tx--;\n\t\tadd_rib(g, n - 2, x*101, 1, 0);\n\t}\n\tfor (int i = 0; i < 101; i++)\n\t{\n\t\tadd_rib(g, i, n-1, INF, i*c);\n\t}\n\tfor (int i = 1; i < N; i++) {\n\t\tfor (int j = 0; j+1 < 101; j++) {\n\t\t\tadd_rib(g, i*101 + j, i*101 + j + 1, INF, 0);\n\t\t}\n\t}\n\tfor (int i = 0; i < m; i++) {\n\t\tint u, v;\n\t\tscanf(\"%d %d\", &u, &v);\n\t\tu--;\n\t\tv--;\n\t\tfor (int j = 0; j+1 < 101; j++) {\n\t\t\tfor (int K = 1; K <= k; K++) {\n\t\t\t\tadd_rib(g, u*101 + j, v*101 + j + 1, 1, d*K*K - d*(K-1)*(K-1));\n\t\t\t\tadd_rib(g, v*101 + j, u*101 + j + 1, 1, d*K*K - d*(K-1)*(K-1));\n\t\t\t}\n\t\t}\n\t}\n\tint s, t;\n\ts = n-2;\n\tt = n-1;\n\tint flow = 0, cost = 0;\n\twhile (flow < k) {\n\t\tvector<int> id (n, 0);\n\t\tvector<int> d (n, INF);\n\t\tvector<int> q (n);\n\t\tvector<int> p (n);\n\t\tvector<size_t> p_rib (n);\n\t\tint qh=0, qt=0;\n\t\tq[qt++] = s;\n\t\td[s] = 0;\n\t\twhile (qh != qt) {\n\t\t\tint v = q[qh++];\n\t\t\tid[v] = 2;\n\t\t\tif (qh == n)  qh = 0;\n\t\t\tfor (size_t i=0; i<g[v].size(); ++i) {\n\t\t\t\trib & r = g[v][i];\n\t\t\t\tif (r.f < r.u && d[v] + r.c < d[r.b]) {\n\t\t\t\t\td[r.b] = d[v] + r.c;\n\t\t\t\t\tif (id[r.b] == 0) {\n\t\t\t\t\t\tq[qt++] = r.b;\n\t\t\t\t\t\tif (qt == n)  qt = 0;\n\t\t\t\t\t}\n\t\t\t\t\telse if (id[r.b] == 2) {\n\t\t\t\t\t\tif (--qh == -1)  qh = n-1;\n\t\t\t\t\t\tq[qh] = r.b;\n\t\t\t\t\t}\n\t\t\t\t\tid[r.b] = 1;\n\t\t\t\t\tp[r.b] = v;\n\t\t\t\t\tp_rib[r.b] = i;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif (d[t] == INF)  break;\n\t\tint addflow = k - flow;\n\t\tfor (int v=t; v!=s; v=p[v]) {\n\t\t\tint pv = p[v];  size_t pr = p_rib[v];\n\t\t\taddflow = min (addflow, g[pv][pr].u - g[pv][pr].f);\n\t\t}\n\t\tfor (int v=t; v!=s; v=p[v]) {\n\t\t\tint pv = p[v];  size_t pr = p_rib[v],  r = g[pv][pr].back;\n\t\t\tg[pv][pr].f += addflow;\n\t\t\tg[v][r].f -= addflow;\n\t\t\tcost += g[pv][pr].c * addflow;\n\t\t}\n\t\tflow += addflow;\n\t}\n\tassert(flow == k);\n\tcout<<cost<<endl;\n\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nN, m, k, c, d = map(int, input().split())\nINF = 10**9\n\nclass Rib:\n    def __init__(self, b, u, c, f, back):\n        self.b = b\n        self.u = u\n        self.c = c\n        self.f = f\n        self.back = back\n\ndef add_rib(g, a, b, u, c):\n    r1 = Rib(b, u, c, 0, len(g[b]))\n    r2 = Rib(a, 0, -c, 0, len(g[a]))\n    g[a].append(r1)\n    g[b].append(r2)\n\nn = N * 101 + 2\ng = [[] for _ in range(n)]\nfor _ in range(k):\n    x = int(input())\n    x -= 1\n    add_rib(g, n - 2, x * 101, 1, 0)\n\nfor i in range(101):\n    add_rib(g, i, n - 1, INF, i * c)\n\nfor i in range(1, N):\n    for j in range(100):\n        add_rib(g, i*101 + j, i*101 + j + 1, INF, 0)\n\nfor _ in range(m):\n    u, v = map(int, input().split())\n    u -= 1\n    v -= 1\n    for j in range(100):\n        for K in range(1, k+1):\n            add_rib(g, u*101 + j, v*101 + j + 1, 1, d * K * K - d * (K - 1) * (K - 1))\n            add_rib(g, v*101 + j, u*101 + j + 1, 1, d * K * K - d * (K - 1) * (K - 1))\n\ns = n - 2\nt = n - 1\nflow = 0\ncost = 0\n\nwhile flow < k:\n    id = [0] * n\n    d = [INF] * n\n    q = [0] * n\n    p = [0] * n\n    p_rib = [0] * n\n    qh = 0\n    qt = 0\n    q[qt] = s\n    qt += 1\n    d[s] = 0\n    while qh != qt:\n        v = q[qh]\n        qh += 1\n        if qh == n:\n            qh = 0\n        id[v] = 2\n        for i in range(len(g[v])):\n            r = g[v][i]\n            if r.f < r.u and d[v] + r.c < d[r.b]:\n                d[r.b] = d[v] + r.c\n                if id[r.b] == 0:\n                    q[qt] = r.b\n                    qt += 1\n                    if qt == n:\n                        qt = 0\n                elif id[r.b] == 2:\n                    qh -= 1\n                    if qh == -1:\n                        qh = n - 1\n                    q[qh] = r.b\n                id[r.b] = 1\n                p[r.b] = v\n                p_rib[r.b] = i\n    if d[t] == INF:\n        break\n    addflow = k - flow\n    v = t\n    while v != s:\n        pv = p[v]\n        pr = p_rib[v]\n        addflow = min(addflow, g[pv][pr].u - g[pv][pr].f)\n        v = pv\n    v = t\n    while v != s:\n        pv = p[v]\n        pr = p_rib[v]\n        g[pv][pr].f += addflow\n        back_idx = g[pv][pr].back\n        g[v][back_idx].f -= addflow\n        cost += g[pv][pr].c * addflow\n        v = pv\n    flow += addflow\n\nprint(cost)\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token