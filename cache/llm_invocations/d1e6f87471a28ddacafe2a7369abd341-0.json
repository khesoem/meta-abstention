    return mult(fact(n), mult(fInv(r), fInv(n - r)));\n        }\n\n        public long normalize(long x) {\n            x %= modulus();\n            if (x < 0) x += modulus();\n            return x;\n        }\n\n        public long add(long a, long b) {\n            long v = a + b;\n            return v < modulus() ? v : v - modulus();\n        }\n\n        public long subtract(long a, long b) {\n            long v = a - b;\n            return v < 0 ? v + modulus() : v;\n        }\n\n        public long mult(long... x) {\n            long r = 1;\n            for (long val : x) r = mult(r, val);\n            return r;\n        }\n\n        public long mult(long a, long b) {\n            return (a * b) % modulus();\n        }\n\n        public long div(long a, long b) {\n            return mult(a, inv(b));\n        }\n\n        public long inv(long value) {\n            long g = modulus(), x = 0, y = 1;\n            long r = value;\n            while (r != 0) {\n                long q = g / r;\n                long temp = g % r;\n                g = r;\n                r = temp;\n                \n                temp = x;\n                x = y;\n                y = temp - q * y;\n            }\n            return normalize(x);\n        }\n    }\n}\n</repaired_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.960462772236497e-07, -0.00011514954530866817, -3.099436753473128e-06, -1.1920928244535389e-07, -5.447716102935374e-05, -1.9192511899746023e-05, -3.576278118089249e-07, -5.483612312673358e-06, -5.280832192511298e-05, -4.172316494077677e-06, -1.1920928244535389e-07, -0.00015245705435518175, -9.536738616588991e-07, -1.0728830375228426e-06, -4.0531076592742465e-06, -4.291525328881107e-06, 0.0, -0.0001551984460093081, -9.536738616588991e-07, -3.4570634852570947e-06, -1.5497195136049413e-06, -2.264974000354414e-06, -9.154854342341423e-05, -3.814689989667386e-06, -1.9073468138230965e-06, -1.4305104514278355e-06, -3.576278118089249e-07, -1.9073468138230