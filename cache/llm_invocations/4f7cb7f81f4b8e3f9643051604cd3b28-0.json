] for d in range(M + 1)]\n            # set dp[i] to identity polynomial (1)\n            for d in range(M + 1):\n                dp[i * 19 + d] = 1 if d == 0 else 0\n            # binary exponentiation of polynomial base to power k\n            exp = k\n            cur = [0] * (M + 1)\n            cur[0] = 1\n            while exp:\n                if exp & 1:\n                    # cur = cur * base\n                    sq = [0] * (M + 1)\n                    for a in range(M + 1):\n                        if cur[a]:\n                            ca = cur[a]\n                            for b in range(M + 1 - a):\n                                sq[a + b] = (sq[a + b] + ca * base[b]) % MOD\n                    cur = sq\n                exp >>= 1\n                if exp:\n                    # base = base * base\n                    sq = [0] * (M + 1)\n                    for a in range(M + 1):\n                        if base[a]:\n                            ba = base[a]\n                            for b in range(M + 1 - a):\n                                sq[a + b] = (sq[a + b] + ba * base[b]) % MOD\n                    base = sq\n            # write back result to dp[i]\n            for d in range(M + 1):\n                dp[i * 19 + d] = cur[d]\n\n    # inverse SOS (M\u00f6bius transform)\n    for bit in range(18):\n        if (n >> bit) & 1:\n            sub = n\n            while sub:\n                if (sub >> bit) & 1:\n                    idx_sub = sub * 19\n                    idx_xor = (sub ^ (1 << bit)) * 19\n                    for d in range(M + 1):\n                        dp[idx_sub + d] = (dp[idx_sub + d] - dp[idx_xor + d]) % MOD\n                sub = (sub - 1) & n\n\n    ans = dp[n * 19 + M]\n    for i in range(1, n + 1):\n        ans = (ans * i) % MOD\n    total = (qpow(k, n, MOD) - ans) % MOD\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.127758249640