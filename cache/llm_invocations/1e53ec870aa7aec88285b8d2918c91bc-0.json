{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int N = 12;\nconst int INF = 1000000009;\nconst int dx[4] = {0, 1, 0, -1};\nconst int dy[4] = {1, 0, -1, 0};\n\nint n, t;\nchar a[N * N], b[N * N]; // flattened grids\nint sx, sy;\nint dist[N * N];\n\ninline int id(int x, int y) { return x * n + y; }\ninline bool digit(char c) { return c >= '0' && c <= '9'; }\n\nvoid bfsDist(int start) {\n    fill(dist, dist + n * n, INF);\n    bool vis[N * N] = {};\n    queue<int> q;\n    vis[start] = true;\n    dist[start] = 0;\n    q.push(start);\n    while (!q.empty()) {\n        int cur = q.front(); q.pop();\n        int x = cur / n, y = cur % n;\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + dx[k], ny = y + dy[k];\n            if (nx >= 0 && nx < n && ny >= 0 && ny < n) {\n                int nid = id(nx, ny);\n                if (!vis[nid] && digit(a[nid])) {\n                    vis[nid] = true;\n                    dist[nid] = dist[cur] + 1;\n                    q.push(nid);\n                }\n            }\n        }\n    }\n}\n\nconst int STATES = N * N * N * N;\nbool dp[72][STATES];\nbool reachable[STATES];\n\nvoid solve() {\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 0; i < n; ++i) {\n        scanf(\" %s\", a + i * n); // read row into flattened array\n    }\n    for (int i = 0; i < n; ++i) {\n        scanf(\" %s\", b + i * n);\n    }\n    scanf(\"%d%d\", &sx, &sy);\n    for (int i = 0; i < n * n; ++i) {\n        if (a[i] == 'Z') {\n            sx = i / n;\n            sy = i % n;\n        }\n    }\n    bfsDist(id(sx, sy));\n\n    // Initialize dp[0]\n    for (int i = 0; i < n * n; ++i) {\n        if (digit(a[i])) {\n            int state = (i * n * n) + i; // (sx,sy,x,y) all same\n            dp[0][state] = true;\n        }\n    }\n\n    // DP transitions\n    for (int yt = 0; yt < t; ++yt) {\n        for (int state = 0; state < STATES; ++state) {\n            if (!dp[yt][state]) continue;\n            int s = state / (n * n);\n            int x = (state % (n * n)) / n;\n            int y = (state % (n * n)) % n;\n            if (dist[id(x, y)] <= yt) continue;\n            for (int k = 0; k < 4; ++k) {\n                int nx = x + dx[k], ny = y + dy[k];\n                if (nx >= 0 && nx < n && ny >= 0 && ny < n && digit(a[id(nx, ny)]) && dist[id(nx, ny)] >= yt + 1) {\n                    int nstate = s * n * n + id(nx, ny);\n                    dp[yt + 1][nstate] = true;\n                }\n            }\n        }\n    }\n\n    // Build reachable\n    for (int yt = 0; yt <= t; ++yt)\n        for (int s = 0; s < STATES; ++s)\n            if (dp[yt][s])\n                reachable[s] = true;\n\n    // Max flow graph\n    int V = 2 * n * n + 2;\n    int cap[V][V] = {};\n    // Source to first layer\n    for (int i = 0; i < n * n; ++i) {\n        if (digit(a[i]))\n            cap[0][i + 1] = a[i] - '0';\n    }\n    // Second layer to sink\n    for (int i = 0; i < n * n; ++i) {\n        if (digit(b[i]))\n            cap[n * n + i + 1][2 * n * n + 1] = b[i] - '0';\n    }\n    // Between layers\n    for (int i = 0; i < n * n; ++i) {\n        if (!digit(a[i])) continue;\n        for (int j = 0; j < n * n; ++j) {\n            if (!digit(a[j])) continue;\n            if (reachable[i * n * n + j])\n                cap[i + 1][n * n + j + 1] = INF;\n        }\n    }\n\n    // Ford-Fulkerson with BFS\n    int parent[V];\n    bool vis[V];\n    while (true) {\n        memset(vis, 0, sizeof(vis));\n        memset(parent, 0, sizeof(parent));\n        queue<int> q;\n        vis[0] = true;\n        q.push(0);\n        while (!q.empty()) {\n            int v = q.front(); q.pop();\n            if (v == 2 * n * n + 1) break;\n            for (int u = 0; u < V; ++u) {\n                if (cap[v][u] > 0 && !vis[u]) {\n                    vis[u] = true;\n                    parent[u] = v;\n                    q.push(u);\n                }\n            }\n        }\n        if (!vis[2 * n * n + 1]) break;\n        int flow = INF;\n        for (int v = 2 * n * n + 1; v; v = parent[v])\n            flow = min(flow, cap[parent[v]][v]);\n        for (int v = 2 * n * n + 1; v; v = parent[v]) {\n            cap[parent[v]][v] -= flow;\n            cap[v][parent[v]] += flow;\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i < V; ++i)\n        ans += cap[i][0];\n    printf(\"%d\\n\", ans);\n}\n\nint main() {\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nN = 12\nINF = 1000000009\ndx = [0, 1, 0, -1]\ndy = [1, 0, -1, 0]\n\ndef id(x, y, n):\n    return x * n + y\n\ndef digit(c):\n    return '0' <= c <= '9'\n\ndef bfsDist(start, n, a):\n    dist = [INF] * (n * n)\n    vis = [False] * (n * n)\n    q = deque()\n    vis[start] = True\n    dist[start] = 0\n    q.append(start)\n    while q:\n        cur = q.popleft()\n        x = cur // n\n        y = cur % n\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if 0 <= nx < n and 0 <= ny < n:\n                nid = id(nx, ny, n)\n                if not vis[nid] and digit(a[nid]):\n                    vis[nid] = True\n                    dist[nid] = dist[cur] + 1\n                    q.append(nid)\n    return dist\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [''] * (n * n)\n    for i in range(n):\n        row = next(it)\n        for j in range(n):\n            a[i * n + j] = row[j]\n    b = [''] * (n * n)\n    for i in range(n):\n        row = next(it)\n        for j in range(n):\n            b[i * n + j] = row[j]\n    sx = int(next(it))\n    sy = int(next(it))\n    # Find 'Z' in a and update sx, sy\n    for i in range(n * n):\n        if a[i] == 'Z':\n            sx = i // n\n            sy = i % n\n            break\n    start = id(sx, sy, n)\n    dist = bfsDist(start, n, a)\n\n    STATES = n * n * n * n\n    dp = [[False] * STATES for _ in range(t + 1)]\n\n    # Initialize dp[0]\n    for i in range(n * n):\n        if digit(a[i]):\n            state = i * n * n + i\n            dp[0][state] = True\n\n    # DP transitions\n    for yt in range(t):\n        for state in range(STATES):\n            if not dp[yt][state]:\n                continue\n            s = state // (n * n)\n            x = (state % (n * n)) // n\n            y = (state % (n * n)) % n\n            if dist[id(x, y, n)] <= yt:\n                continue\n            for k in range(4):\n                nx = x + dx[k]\n                ny = y + dy[k]\n                if 0 <= nx < n and 0 <= ny < n and digit(a[id(nx, ny, n)]) and dist[id(nx, ny, n)] >= yt + 1:\n                    nstate = s * n * n + id(nx, ny, n)\n                    dp[yt + 1][nstate] = True\n\n    # Build reachable\n    reachable = [False] * STATES\n    for yt in range(t + 1):\n        for s in range(STATES):\n            if dp[yt][s]:\n                reachable[s] = True\n\n    # Max flow graph\n    V = 2 * n * n + 2\n    cap = [[0] * V for _ in range(V)]\n    # Source to first layer\n    for i in range(n * n):\n        if digit(a[i]):\n            cap[0][i + 1] = int(a[i])\n    # Second layer to sink\n    for i in range(n * n):\n        if digit(b[i]):\n            cap[n * n + i + 1][2 * n * n + 1] = int(b[i])\n    # Between layers\n    for i in range(n * n):\n        if not digit(a[i]):\n            continue\n        for j in range(n * n):\n            if not digit(a[j]):\n                continue\n            if reachable[i * n * n + j]:\n                cap[i + 1][n * n + j + 1] = INF\n\n    # Ford-Fulkerson with BFS\n    parent = [0] * V\n    vis = [False] * V\n    while True:\n        vis = [False] * V\n        parent = [0] * V\n        q = deque()\n        vis[0] = True\n        q.append(0)\n        while q:\n            v = q.popleft()\n            if v == 2 * n * n + 1:\n                break\n            for u in range(V):\n                if cap[v][u] > 0 and not vis[u]:\n                    vis[u] = True\n                    parent[u] = v\n                    q.append(u)\n        if not vis[2 * n * n + 1]:\n            break\n        flow = INF\n        v = 2 * n * n + 1\n        while v:\n            flow = min(flow, cap[parent[v]][v])\n            v = parent[v]\n        v = 2 * n * n + 1\n        while v:\n            cap[parent[v]][v] -= flow\n            cap[v][parent[v]] += flow\n            v = parent[v]\n\n    ans = 0\n    for i in range(V):\n        ans += cap[i][0]\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.3378546504536644e-06, 0.0, 0.0, -0.0005992047372274101, -0.0009332115878351033, -1.1920928244535389e-07, -2.4199192921514623e-05, -0.0001591317413840443, -3.576272320060525e-06, 0.0, -2.9802276912960224e-06, -0.0008991489303298295, -0.5033374428749084, -0.000382707774406299, -1.1920928244535389e-07, -2.2649740003544