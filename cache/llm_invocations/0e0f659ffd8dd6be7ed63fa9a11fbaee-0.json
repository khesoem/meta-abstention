     for (int v = 0; v < N; ++v) {\n                if (pot[v] == INF) continue;\n                for (const Edge& e : g[v]) {\n                    if (e.cap > 0 && pot[e.to] > pot[v] + e.cost) {\n                        pot[e.to] = pot[v] + e.cost;\n                        upd = true;\n                    }\n                }\n            }\n            if (!upd) break;\n        }\n\n        int total = 0;\n        while (true) {\n            vector<int> dist(N, INF);\n            vector<int> pv(N, -1);\n            vector<int> pe(N, -1);\n            dist[s] = 0;\n\n            // priority queue: (distance, vertex)\n            priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;\n            pq.push({0, s});\n\n            while (!pq.empty()) {\n                auto cur = pq.top(); pq.pop();\n                long long d = cur.first;\n                int v = cur.second;\n                if (d != dist[v]) continue;\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    const Edge& e = g[v][i];\n                    if (e.cap <= 0) continue;\n                    long long nd = d + e.cost + pot[v] - pot[e.to];\n                    if (dist[e.to] > nd) {\n                        dist[e.to] = nd;\n                        pv[e.to] = v;\n                        pe[e.to] = i;\n                        pq.push({nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int v = 0; v < N; ++v)\n                if (dist[v] < INF) pot[v] += dist[v];\n\n            int add = 0;\n            for (int v = t; v != s; v = pv[v]) {\n                int u = pv[v];\n                Edge& e = g[u][pe[v]];\n                add += e.cost;\n                e.cap--;\n                g[v][e.rev].cap++;\n            }\n            total += add;\n        }\n        return total;\n    }\n\n    void run() {\n        int len;\n        cin >> len;\n        n = len / 2;\n        N = 1 + n + A + 1;\n        g.assign(N, vector<Edge>());\n\n        string s;\n        cin >> s;\n        vector<int> b(2 * n);\n        for (int i = 0; i < 2 * n; ++i) cin >> b[i];\n\n        int source = 0, sink = N - 1;\n        for (int i = 0; i < n; ++i) addEdge(source, 1 + i, 2, 0);\n        for (int i = 0; i < n; ++i) {\n            int j = 2 * n - 1 - i;\n            int ai = s[i] - 'a';\n            int aj = s[j] - 'a';\n            for (int a = 0; a < A; ++a) {\n                int val;\n                if (a == ai && a == aj) val = max(b[i], b[j]);\n                else if (a == ai) val = b[i];\n                else if (a == aj) val = b[j];\n                else val = 0;\n                addEdge(1 + i, 1 + n + a, 1, -val);\n            }\n        }\n\n        vector<int> cnt(A, 0);\n        for (int i = 0; i < 2 * n; ++i) cnt[s[i] - 'a']++;\n        for (int a = 0; a < A; ++a) addEdge(1 + n + a, sink, cnt[a], 0);\n\n        cout << -minCostFlow(source, sink) << endl;\n    }\n};\n\nint main() {\n    CF884F solver;\n    solver.run();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.2543604902457446e-05, 0.0, -3.576278118089249e-07, -0.0007584794075228274, -0.0043846662156283855, -5.245195097813848e-06, -0.2014361470937729, -7.867782187531702e-06, 0.0, 0.0, -0.00034290633630007505, -1.4305104514278355e-06, 0.0, 0.0, -0.0007382289622910321, -1.5497195136049413e-06, 0.0, 0.0, -0.018858423456549644, -3.3378546504536644e-06, 0.0, 0.0, -7.629103492945433e-05, 0.0, 0.0, -9.894321920000948e-06, -3.576278118089249e-07, 0.0, -0.07901015132665634, -2.3483953555114567e-05, -0.0015476880362257361, -0.00020346954988781363, -4.768370445162873e-07, -0.006768514402210712, -0.06197534501552582, -0.03804336488246918, -1.1920928244535389e-07, -0.00279845274053514, -0.16082921624183655, -4.1483970562694594e-05, -8.344646857949556e-07, 0.0, -5.8887653722194955e-05, -0.007199652958661318, -2.38418550679853