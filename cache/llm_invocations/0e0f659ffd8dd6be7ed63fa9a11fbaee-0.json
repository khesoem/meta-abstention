n                        upd = true;\n                    }\n                }\n            }\n            if (!upd) break;\n        }\n\n        int total = 0;\n        while (true) {\n            int[] dist = new int[N];\n            int[] pv = new int[N];\n            int[] pe = new int[N];\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n\n            PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n            pq.add(new long[] {0, s});\n\n            while (!pq.isEmpty()) {\n                long[] cur = pq.poll();\n                int v = (int) cur[1];\n                int d = (int) cur[0];\n                if (d != dist[v]) continue;\n                for (int i = 0; i < g.get(v).size(); i++) {\n                    Edge e = g.get(v).get(i);\n                    if (e.cap <= 0) continue;\n                    int nd = d + e.cost + pot[v] - pot[e.to];\n                    if (dist[e.to] > nd) {\n                        dist[e.to] = nd;\n                        pv[e.to] = v;\n                        pe[e.to] = i;\n                        pq.add(new long[] {nd, e.to});\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            for (int v = 0; v < N; v++)\n                if (dist[v] < INF) pot[v] += dist[v];\n\n            int add = 0;\n            for (int v = t; v != s; v = pv[v]) {\n                int u = pv[v];\n                Edge e = g.get(u).get(pe[v]);\n                add += e.cost;\n                e.cap--;\n                g.get(v).get(e.rev).cap++;\n            }\n            total += add;\n        }\n        return total;\n    }\n\n    void run() {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt() / 2;\n        N = 1 + n + A + 1;\n        g = new ArrayList<>();\n        for (int i = 0; i < N; i++) g.add(new ArrayList<>());\n\n        byte[] s = sc.next().getBytes();\n        int[] b = new int[n * 2];\n        for (int i = 0