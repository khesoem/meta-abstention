int rev, int cap, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static void addEdge(ArrayList<ArrayList<Edge>> g, int from, int to, int cap, int cost) {\n        g.get(from).add(new Edge(to, g.get(to).size(), cap, cost));\n        g.get(to).add(new Edge(from, g.get(from).size() - 1, 0, -cost));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int n = N * 101 + 2;\n        ArrayList<ArrayList<Edge>> g = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            g.add(new ArrayList<>());\n        }\n\n        // Precompute road costs\n        int[] roadCost = new int[k + 1];\n        for (int K = 1; K <= k; K++) {\n            roadCost[K] = d * (2 * K - 1);\n        }\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            x--;\n            addEdge(g, n - 2, x * 101, 1, 0);\n        }\n\n        for (int i = 0; i < 101; i++) {\n            addEdge(g, i, n - 1, INF, i * c);\n        }\n\n        for (int i = 1; i < N; i++) {\n            for (int j = 0; j + 1 < 101; j++) {\n                addEdge(g, i * 101 + j, i * 101 + j + 1, INF, 0);\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            u--;\n            v--;\n            for (int j = 0; j + 1 < 101; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(g, u * 101 + j, v * 101 + j + 1, 1, roadCost[K]);\n                    addEdge(g, v * 101 + j, u * 101 + j + 1, 1, roadCost[K]);\n                }\n            }\n        }\n\n        int s = n - 2, t = n - 1;\n        int flow = 0, cost = 0;\n        while (flow < k) {\n      