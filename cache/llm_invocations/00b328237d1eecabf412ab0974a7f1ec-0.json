{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing ull = unsigned long long;\nusing ld = long double;\nusing vi = vector<int>;\nusing vvi = vector<vi>;\n\n#define forn(i, n) for (int i = 0; i < (int)(n); ++i)\n#define ford(i, n) for (int i = (int)(n) - 1; i >= 0; --i)\n#define sz(c) ((int)(c).size())\n#define mp make_pair\n#define pb push_back\n\nvoid solve(int n) {\n    int k;\n    cin >> k;\n\n    using T = double;\n    vector<T> p(n);\n    for (int i = 0; i < n; ++i)\n        cin >> p[i];\n\n    T dp[2][1 << n];\n    memset(dp, 0, sizeof(dp));\n\n    vector<char> isgood(n, 0);\n    vi good;\n    for (int i = 0; i < n; ++i)\n        if (p[i] != 0) {\n            isgood[i] = 1;\n            good.pb(i);\n        }\n\n    dp[0][0] = 1.0;\n    int cur = 1;\n\n    vector<T> sum(1 << n, 0.0);\n    sum[0] = 1.0;\n    for (int mask = 1; mask < (1 << n); ++mask) {\n        int bit = __builtin_ctz(mask);\n        sum[mask] = sum[mask ^ (1 << bit)] - p[bit];\n    }\n\n    int limit = min((int)good.size(), k);\n    for (int step = 0; step < limit; ++step) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int idx : good) {\n                if (mask & (1 << idx)) continue;\n                dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / sum[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    for (int i = 0; i < n; ++i) {\n        if (!isgood[i])\n            printf(\"%.12f\\n\", 0.0);\n        else {\n            T res = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    res += dp[cur][mask];\n            }\n            printf(\"%.12f\\n\", (double)res);\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport array\n\ndef solve(n):\n    data = sys.stdin.readline().split()\n    k = int(data[0])\n    \n    p = list(map(float, sys.stdin.readline().split()))\n    \n    dp = [[0.0] * (1 << n) for _ in range(2)]\n    \n    isgood = [0] * n\n    good = []\n    for i in range(n):\n        if p[i] != 0:\n            isgood[i] = 1\n            good.append(i)\n    \n    dp[0][0] = 1.0\n    cur = 1\n    \n    sum_arr = [0.0] * (1 << n)\n    sum_arr[0] = 1.0\n    for mask in range(1, 1 << n):\n        bit = (mask & -mask).bit_length() - 1\n        sum_arr[mask] = sum_arr[mask ^ (1 << bit)] - p[bit]\n    \n    limit = min(len(good), k)\n    for step in range(limit):\n        dp[cur] = [0.0] * (1 << n)\n        \n        for mask in range(1 << n):\n            if bin(mask).count('1') != step:\n                continue\n            \n            for idx in good:\n                if mask & (1 << idx):\n                    continue\n                if sum_arr[mask] != 0:\n                    dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / sum_arr[mask]\n        \n        cur ^= 1\n    \n    cur ^= 1\n    for i in range(n):\n        if not isgood[i]:\n            print(\"{:.12f}\".format(0.0))\n        else:\n            res = 0.0\n            for mask in range(1 << n):\n                if mask & (1 << i):\n                    res += dp[cur][mask]\n            print(\"{:.12f}\".format(res))\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    index = 0\n    while index < len(input_data):\n        n = int(input_data[index])\n        index += 1\n        solve(n)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001037067049765028, -9.536738616588991e-07, -1.1920928244535389e-07, -0.000327652640407905, -0.0017497718799859285, -0.00010990492592100054, -0.0006443570018745959, -0.0012504386249929667, -0.6326006650924683, -0.5760470032691956, -0.7013231515884399, -0.0002119316632160917, -2.586808113846928e-05, -0.0004285847535356879, -0.1012248545885086, -0.0002351722796447575, -3.4570634852570947e-06, -0.25676777958869934, -0.002312725642696023, -0.5148371458053589, -4.1960789531003684e-05, -0.006077618338167667, -4.6132929128361866e-05, -0.0036162238102406263, -2.9802276912960224e-06, -2.50339189733495e-06, -0.31768104434013367, -4.768370445162873e-07, -1.4305104514278355e-06, -2.145764938177308e-06, -0.00038246947224251926, -1.1920928244535389e-07, -0.06197568029165268, -0.005234465003013611, -1.1920928244535389e-07, -0.58465975522995, -0.008146392181515694, -0.051367390900850296, -5.543078441405669e-05, -0.000356133939931169