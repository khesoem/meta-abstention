 dfs1(0,0);\n\tfor(int i=0;i<=6;++i)\n\t\tsort(v[i].begin(),v[i].end());\n\tord=0;\n\tfor(int i=1;i<=9;++i)\n\t\tdfs2(i);\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nmod = 1000000007\nMOD = 998244353\nmaxk = 7\nbase = 1000000\n\nn = 0\norder = 0\nans = 0\nsum_arr = [0] * maxk\nv = [[] for _ in range(maxk)]\n\ndef modadd(a, b):\n    return (a + b) % mod\n\ndef modsub(a, b):\n    return (a - b + mod) % mod\n\ndef dfs1(x, length):\n    global order, sum_arr, v\n    order += 1\n    val = (order % MOD - x % MOD + MOD) % MOD\n    v[length].append(val)\n    sum_arr[length] = (sum_arr[length] + val) % mod\n    if length == 6:\n        return\n    for i in range(10):\n        dfs1(x * 10 + i, length + 1)\n\ndef dfs2(x):\n    global order, ans, n, v, sum_arr\n    if x > n:\n        return\n    if x * base + base - 1 <= n and x * base * 10 > n:\n        now = order\n        mul = 1\n        for i in range(7):\n            sz = len(v[i])\n            dif = (now % MOD - (x * mul) % MOD + MOD) % MOD\n            target = MOD - dif\n            pos = bisect.bisect_left(v[i], target)\n            ans = modadd(ans, (dif * sz + sum_arr[i]) % mod)\n            ans = modsub(ans, (MOD * (sz - pos)) % mod)\n            order += sz\n            mul *= 10\n        return\n    order += 1\n    ans = modadd(ans, ((order - x) % MOD + MOD) % mod)\n    for i in range(10):\n        dfs2(x * 10 + i)\n\ndef main():\n    global n, order, ans, v, sum_arr\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    order = 0\n    dfs1(0, 0)\n    for i in range(7):\n        v[i].sort()\n    order = 0\n    for i in range(1, 10):\n        dfs2(i)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_