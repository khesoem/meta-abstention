out.erase(unique(out.begin(), out.end()), out.end());\n    return out;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    vector<int> data;\n    int x;\n    while (cin >> x) {\n        data.push_back(x);\n    }\n    if (data.size() < 2) return 0;\n    int n = data[0];\n    int m = data[1];\n    vector<int> a(data.begin() + 2, data.begin() + 2 + n);\n    for (int& v : a) v %= m;\n\n    int h = n / 2;\n    vector<int> left = subset_sums(vector<int>(a.begin(), a.begin() + h), m);\n    vector<int> right = subset_sums(vector<int>(a.begin() + h, a.end()), m);\n    // right is already sorted and unique from subset_sums\n\n    int best = 0;\n    for (int val : left) {\n        // find largest element in right < m - val\n        auto it = lower_bound(right.begin(), right.end(), m - val);\n        if (it != right.begin()) {\n            --it;\n            best = max(best, val + *it);\n        }\n    }\n    cout << best << '\\n';\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.099436753473128e-06, 0.0, 0.0, -5.602679812000133e-05, -2.6225699912174605e-05, -4.768360213347478e-06, -0.008615703321993351, 0.0, -3.576278118089249e-07, 0.0, -0.00021646064124070108, -1.0371154530730564e-05, -1.1920928244535389e-07, 0.0, -4.0531076592742465e-06, -0.00039152585668489337, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -6.556489552167477e-06, 0.0, -7.486063259420916e-05, 0.0, 0.0, -1.6689160474925302e-05, -4.172316494077677e-06, 0.0, -1.4305104514278355e-06, -7.986990567587782e-06, -5.960462772236497e-07, -1.1920928244535389e-07, -6.6756979322235566e-06, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -0.0002217047003796324, -0.0004702892620116472, -1.1920928244535389e-07, 0.0, -7.867782187531702e-06, 0.0, -7.390948667307384e-06, -3.6954811548639555e-06, -1.1920928244535389e-07, -0.0004316828562878072, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, 0.0, -0.00071523