d(a.val, MOD, x, y);\n        assert(g == 1);\n        return mi(x);\n    }\n    static ll extended_gcd(ll a, ll b, ll& x, ll& y) {\n        if (b == 0) { x = 1; y = 0; return a; }\n        ll x1, y1;\n        ll g = extended_gcd(b, a % b, x1, y1);\n        x = y1;\n        y = x1 - (a / b) * y1;\n        return g;\n    }\n};\n\nul no[7];\nint n;\nmi p[7][7];\n\nul po(int x) {\n    return (ul)1 << x;\n}\n\nint main() {\n    scanf(\"%d\", &n);\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            int x;\n            scanf(\"%d\", &x);\n            p[i][j] = mi(x) / mi(100);\n        }\n    }\n    for (int i = 0; i < n; ++i) {\n        no[i] = 0;\n        for (int j = 0; j < (1 << n); ++j) {\n            if (!((j >> i) & 1)) {\n                no[i] |= po(j);\n            }\n        }\n    }\n    std::unordered_map<ul, mi> m;\n    m[1] = mi(1);\n    for (int i = 0; i < n; ++i) {\n        std::unordered_map<ul, mi> M;\n        for (auto& t : m) {\n            for (int j = 0; j < (1 << n); ++j) {\n                ul res = 0;\n                mi prob = 1;\n                for (int k = 0; k < n; ++k) {\n                    if (j & (1 << k)) {\n                        prob *= p[i][k];\n                        res |= (t.first & no[k]) << (1 << k);\n                    } else {\n                        prob *= mi(1) - p[i][k];\n                    }\n                }\n                M[res] += t.second * prob;\n            }\n        }\n        m.swap(M);\n    }\n    ul target = po((1 << n) - 1);\n    mi ans = m[target];\n    printf(\"%d\\n\", ans.val);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass ModInt:\n    __slots__ = ('val',)\n    def __init__(self, v=0):\n        if isinstance(v, ModInt):\n            self.val = v.val\n        else:\n            v %= MOD\n            if v < 0:\n                v += MOD\n            self.val = int(v)\n\n    def __neg__(self):\n        return ModInt(-self.val)\n\n    def __iadd__(self, other):\n        if isinstance(other, ModInt):\n            self.val += other.val\n        else:\n            self.val += other\n        if self.val >= MOD:\n            self.val -= MOD\n        return self\n\n    def __isub__(self, other):\n        if isinstance(other, ModInt):\n            self.val -= other.val\n        else:\n            self.val -= other\n        if self.val < 0:\n            self.val += MOD\n        return self\n\n    def __imul__(self, other):\n        if isinstance(other, ModInt):\n            self.val = (self.val * other.val) % MOD\n        else:\n            self.val = (self.val * other) % MOD\n        return self\n\n    def __add__(self, other):\n        res = ModInt(self)\n        res += other\n        return res\n\n    def __sub__(self, other):\n        res = ModInt(self)\n        res -= other\n        return res\n\n    def __mul__(self, other):\n        res = ModInt(self)\n        res *= other\n        return res\n\n    def __truediv__(self, other):\n        return self * ModInt.inv(other)\n\n    @staticmethod\n    def inv(a):\n        x, y = 0, 1\n        g = ModInt._extended_gcd(a.val, MOD, x, y)\n        # g should be 1\n        return ModInt(x)\n\n    @staticmethod\n    def _extended_gcd(a, b, x, y):\n        if b == 0:\n            x = 1\n            y = 0\n            return a\n        x1, y1 = 0, 0\n        g = ModInt._extended_gcd(b, a % b, x1, y1)\n        x = y1\n        y = x1 - (a // b) * y1\n        return g\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    n = data[0]\n    idx = 1\n    p = [[ModInt(0) for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            x = data[idx]; idx += 1\n            p[i][j] = ModInt(x) / ModInt(100)\n\n    no = [0] * n\n    for i in r