List<ArrayList<Edge>> g;\n        long[] dual, dist;\n        int[] pv, pe;\n        boolean[] vis;\n\n        MCFGraphIntCost(int n) {\n            this.n = n;\n            pos = new ArrayList<>();\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) g.add(new ArrayList<>());\n        }\n\n        int addEdge(int from, int to, long cap, long cost) {\n            int m = pos.size();\n            pos.add(new int[]{from, g.get(from).size()});\n            g.get(from).add(new Edge(to, g.get(to).size(), cap, cost));\n            g.get(to).add(new Edge(from, g.get(from).size() - 1, 0, -cost));\n            return m;\n        }\n\n        class EdgeInfo {\n            int from, to;\n            long cap, flow, cost;\n            EdgeInfo(int from, int to, long cap, long flow, long cost) {\n                this.from = from;\n                this.to = to;\n                this.cap = cap;\n                this.flow = flow;\n                this.cost = cost;\n            }\n        }\n\n        EdgeInfo getEdge(int i) {\n            int[] p = pos.get(i);\n            Edge e = g.get(p[0]).get(p[1]);\n            Edge re = g.get(e.to).get(e.rev);\n            return new EdgeInfo(p[0], e.to, e.cap + re.cap, re.cap, e.cost);\n        }\n\n        ArrayList<EdgeInfo> edges() {\n            ArrayList<EdgeInfo> ret = new ArrayList<>();\n            for (int i = 0; i < pos.size(); i++) {\n                int[] p = pos.get(i);\n                Edge e = g.get(p[0]).get(p[1]);\n                Edge re = g.get(e.to).get(e.rev);\n                ret.add(new EdgeInfo(p[0], e.to, e.cap + re.cap, re.cap, e.cost));\n            }\n            return ret;\n        }\n\n        boolean dualRef(int s, int t) {\n            dist = new long[n];\n            Arrays.fill(dist, BIG);\n            pv = new int[n];\n            Arrays.fill(pv, -1);\n            pe = new int[n];\n            Arrays.fill(pe, -1);\n            vis = new boolean[n];\n\n            PriorityQueue<Long> pq = new PriorityQueue<>();\n            dist[s] = 0;\n            pq.add((dist[s] << 32) + s);\n            while (!pq.isEmpty()) {\n                long cur = pq.poll();\n                int v = (int) (cur & BIG);\n                if (vis[v]) continue;\n                vis[v] = true;\n                if (v == t) break;\n                for (int i = 0; i < g.get(v).size(); i++) {\n                    Edge e = g.get(v).get(i);\n                    if (vis[e.to] || e.cap == 0) continue;\n                    long cost = e.cost - dual[e.to] + dual[v];\n                    if (dist[e.to] > dist[v] + cost) {\n                        dist[e.to] = dist[v] + cost;\n                        pv[e.to] = v;\n                        pe[e.to] = i;\n                        pq.add((dist[e.to] << 32) + e.to);\n                    }\n                }\n            }\n            if (!vis[t]) return false;\n            for (int v = 0; v < n; v++) {\n                if (vis[v]) {\n                    dual[v] -= dist[t] - dist[v];\n                }\n            }\n            return true;\n        }\n\n        ArrayList<long[]> slope(int s, int t, long flowLimit) {\n            dual = new long[n];\n            dist = new long[n];\n            pv = new int[n];\n            pe = new int[n];\n            vis = new boolean[n];\n\n            long flow = 0;\n            long cost = 0;\n            long prevCost = -1;\n            ArrayList<long[]> result = new ArrayList<>();\n            result.add(new long[]{flow, cost});\n            while (flow < flowLimit) {\n                if (!dualRef(s, t)) break;\n                long c = flowLimit - flow;\n                int v = t;\n                while (v != s) {\n                    c = Math.min(c, g.get(pv[v]).get(pe[v]).cap);\n                    v = pv[v];\n                }\n                v = t;\n                while (v != s) {\n                    Edge e = g.get(pv[v]).get(pe[v]);\n                    e.cap -= c;\n                    g.get(v).get(e.rev).cap += c;\n                    v = pv[v];\n                }\n                long d = -dual[s];\n                flow += c;\n                cost += c * d;\n                if (prevCost == d) {\n                    result.remove(result.size() - 1);\n                }\n                result.add(new long[]{flow, cost});\n                prevCost = cost;\n            }\n            return result;\n        }\n\n        long[] flow(int s, int t, long flowLimit) {\n            ArrayList<long[]> slopeResult = slope(s, t, flowLimit);\n            return slopeResult.get(slopeResult.size() - 1);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        long a1 = sc.nextLong(), a2 = sc.nextLong(), a3 = sc.nextLong();\n        long b1 = sc.nextLong(), b2 = sc.nextLong(), b3 = sc.nextLong();\n\n        MCFGraphIntCost g = new MCFGraphIntCost(8);\n        g.addEdge(0, 1, a1, 0);\n        g.addEdge(0, 2, a2, 0);\n        g.addEdge(0, 3, a3, 0);\n        g.addEdge(4, 7, b1, 0);\n        g.addEdge(5, 7, b2, 0);\n        g.addEdge(6, 7, b3, 0);\n        for (int i = 1; i <= 3; i++) {\n            for (int j = 4; j <= 6; j++) {\n                long cost = ((j - i) % 3 == 1) ? 1 : 0;\n                g.addEdge(i, j, INF, cost);\n            }\n        }\n\n        long[] result = g.flow(0, 7, BIG);\n        long ans1 = result[1];\n        long ans2 = Math.min(a1, b2) + Math.min(a2, b3) + Math.min(a3, b1);\n        System.out.println(ans1 + \" \" + ans2);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.3841855e-07, 0.0, 0.0, -0.0002752164, -0.0005573865, -2.0265559e-06, -0.0024762463, -0.02526219, -0.6933007, -4.7683704e-07, -0.1450226, -0.20143428, -0.029761525, -0.019757144, -0.57784307, -0.1602638, -4.76836e-06, -7.3072624e-05, -1.1380899, -0.00021860594, -7.867782e-06, -0.20266172, -0.00034362133, -2.2649509e-05, -0.0017226393