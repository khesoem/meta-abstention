 < 0) x = -x;\n    while (x >= 10) {\n        x /= 10;\n    }\n    return x;\n}\n\ni64 deleteLastDigit(i64 x) {\n    if (x < 0) x = -x;\n    vector<int> digits;\n    while (x >= 10) {\n        digits.push_back(x % 10);\n        x /= 10;\n    }\n    i64 result = 0;\n    for (int i = digits.size() - 1; i >= 0; --i) {\n        result = result * 10 + digits[i];\n    }\n    return result;\n}\n\nunordered_map<i64, i64> dp;\n\ni64 solve(i64 x) {\n    if (x <= 11) return min(13 - x, x);\n    if (dp.find(x) != dp.end()) return dp[x];\n    i64 n = 0, power = 1;\n    while (power < x) {\n        power *= 10;\n        power += 1;\n        ++n;\n    }\n    if (x * 2 >= power) {\n        i64 option1 = solve(power - x) + n + 1;\n        i64 base = power / 10;\n        i64 option2 = (x / base) * n + solve(x % base);\n        return dp[x] = min(option1, option2);\n    }\n    i64 base = power / 10;\n    return dp[x] = (x / base) * n + solve(x % base);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    i64 a;\n    cin >> a;\n    cout << solve(a) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static Map<Long, Long> dp = new HashMap<>();\n\n    static long countDigits(long x) {\n        if (x == 0) return 1;\n        if (x < 0) x = -x;\n        long cnt = 0;\n        while (x > 0) {\n            ++cnt;\n            x /= 10;\n        }\n        return cnt;\n    }\n\n    static long nextNumber(long x) {\n        List<Integer> digits = new ArrayList<>();\n        boolean negative = x < 0;\n        if (negative) x = -x;\n        while (x > 0) {\n            int d = (int)(x % 10);\n            digits.add(d - (negative ? -1 : 1));\n            x /= 10;\n        }\n        long result = 0;\n        for (int i = digits.size() - 1; i >= 0; --i) {\n            result = result * 10 + digits.get(i);\n        }\n        return negative ? -result : result;\n    }\n\n    static long prevNumber(long x) {\n        boolean negative = x < 0;\n        if (negative) x = -x;\n        long adjustment = 0;\n        long original = x;\n        while (x > 0) {\n            adjustment = adjustment * 10 + (negative ? -1 : 1);\n            x /= 10;\n        }\n        adjustment = adjustment * 10 + 1;\n        return negative ? original + adjustment : original - adjustment;\n    }\n\n    static long lastDigit(long x) {\n        if (x < 0) x = -x;\n        while (x >= 10) {\n            x /= 10;\n        }\n        return x;\n    }\n\n    static long deleteLastDigit(long x) {\n        if (x < 0) x = -x;\n        List<Integer> digits = new ArrayList<>();\n        while (x >= 10) {\n            digits.add((int)(x % 10));\n            x /= 10;\n        }\n        long result = 0;\n        for (int i = digits.size() - 1; i >= 0; --i) {\n            result = result * 10 + digits.get(i);\n        }\n        return result;\n    }\n\n    static long solve(long x) {\n        if (x <= 11) return Math.min(13 - x, x);\n        if (dp.containsKey(x)) return dp.get(x);\n        long n = 0, power = 1;\n        while (power < x) {\n            power *= 10;\n            power += 1;\n            ++n;\n        }\n        if (x * 2 >= power) {\n            long option1 = solve(power - x) + n + 1;\n            long base = power / 10;\n            long option2 = (x / base) * n + solve(x % base);\n            long result = Math.min(option1, option2);\n            dp.put(x, result);\n            return result;\n        }\n        long base = power / 10;\n        long result = (x / base) * n + solve(x % base);\n        dp.put(x, result);\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long a = scanner.nextLong();\n        System.out.println(solve(a));\n    }\n}\n</translated_code>\n<confidence>