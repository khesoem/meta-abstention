nt = n\n\n    def insert(self, src, dst, cap, cst):\n        # Forward arc\n        complement_dst = len(self.adjacency[dst])\n        self.adjacency[src].append(Arc(dst, cap, cst, complement_dst))\n        \n        # Backward arc\n        complement_src = len(self.adjacency[src]) - 1\n        self.adjacency[dst].append(Arc(src, 0, -cst, complement_src))\n\n    def optimize(self, source, sink, demand):\n        totalCost = 0\n        self.height = [0] * self.MAX_VERTEX\n        \n        while demand > 0:\n            # Dijkstra's algorithm with priority queue\n            pq = []\n            self.shortestPath = [1 << 30] * self.MAX_VERTEX\n            self.shortestPath[source] = 0\n            heapq.heappush(pq, (0, source))\n            \n            while pq:\n                dist, u = heapq.heappop(pq)\n                if self.shortestPath[u] < dist:\n                    continue\n                for i in range(len(self.adjacency[u])):\n                    arc = self.adjacency[u][i]\n                    if arc.capacity > 0:\n                        new_dist = self.shortestPath[u] + arc.weight + self.height[u] - self.height[arc.destination]\n                        if self.shortestPath[arc.destination] > new_dist:\n                            self.shortestPath[arc.destination] = new_dist\n                            self.predecessorVertex[arc.destination] = u\n                            self.predecessorArc[arc.destination] = i\n                            heapq.heappush(pq, (new_dist, arc.destination))\n            \n            if self.shortestPath[sink] == 1 << 30:\n                return -1\n            \n            # Update heights\n            for i in range(self.vertexCount):\n                self.height[i] += self.shortestPath[i]\n            \n            # Find minimum flow along the path\n            flow = demand\n            v = sink\n            while v != source:\n                u = self.predecessorVertex[v]\n                arc_idx = self.predecessorArc[v]\n                flow = min(flow, self.adjacency[u][arc_idx].capacity)\n                v = u\n            \n            demand -= flow\n            totalCost += flow * self.height[sink]\n            \n            # Update capacities\n            v = sink\n            while v != source:\n                u = self.predecessorVertex[v]\n                arc_idx = self.predecessorArc[v]\n                arc = self.adjacency[u][arc_idx]\n                arc.capacity -= flow\n                complement_arc = self.adjacency[v][arc.complement]\n                complement_arc.capacity += flow\n                v = u\n        \n        return totalCost\n\ndef main():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    input_list = []\n    frequency = [0] * 50\n    for i in range(k):\n        val = int(input_data[idx]); idx += 1\n        input_list.append(val)\n        frequency[val - 1] += 1\n    \n    neighbors = [[] for _ in range(50)]\n    for i in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        u -= 1\n        v -= 1\n        neighbors[u].append(v)\n        neighbors[v].append(u)\n    \n    TIMESTEP = 100\n    mcf = MinCostMaxFlow()\n    mcf.establish(n * TIMESTEP + 2)\n    \n    # Source to nodes\n    for i in range(n):\n        mcf.insert(n * TIMESTEP, i, frequency[i], 0)\n    \n    # Time steps to sink\n    for t in range(TIMESTEP):\n        mcf.insert(t * n, n * TIMESTEP + 1, k, c * t)\n    \n    # Same node across time steps\n    for i in range(n):\n        for t in range(TIMESTEP - 1):\n            mcf.insert(t * n + i, (t + 1) * n + i, k, 0)\n    \n    # Neighbor transitions\n    for i in range(n):\n        for neighbor in neighbors[i]:\n            for t in range(TIMESTEP - 1):\n                for u in range(k):\n                    cost = (u + 1) * (u + 1) * d - u * u * d\n                    mcf.insert(t * n + i, (t + 1) * n + neighbor, 1, cost)\n    \n    result = mcf.optimize(n * TIMESTEP, n * TIMESTEP + 1, k)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019524575327523053, -1.1920922133867862e-06, -1.1920928244535389e-07, -6.425174069590867e-05, -0.22572334110736847, -0.0086548225954175, -0.2254178673028946, -0.0009665584657341242, -0.16039825975894928, -0.00013851160474587232, -0.011494835838675499, -3.576278118089249e-07, -5.9126061387360096e-05, -0.0004291805380489677, -0.2781495749950409, -0.006806639954447746, -2.861018856492592e-06, -1.1920928244535389e-07, -0.20141401886940002, -3.135155202471651e-05, -1.168244216387393e-05, -5.960462772236497e-07, -0.5239187479019165, -1.8596476365928538e-05, -4.768370445162873e-07, 0.0, -5.8412379075889476e-06, -1.9073468138230965e-06, -1.1920928244535389e-07, -3.6954811548639555e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -3.3378546504536644e-06, -1.549708758830093e-05, -0.012510277330875397, -5.960462772236497e-07, -2.3841855067985307e-07, -3.4570634852570947e-06, -1.1920928244535389e-07, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.0003143055073451251, -4.172316494077677e-06, -1.0132738680113107e-05, -2.3841855067985307e-07, -9.536738616588991e-07, -1.1920928244535389e-07, -5.006777428206988e-06, -1.1920922133867862e-06, -1.2993727978027891e-05, -1.6689286894688848e-06, -3.814689989667386e-06, -2.9802276912960224e-06, -1.3232143828645349e-05, -5.960462772236497e-07, -4.887569048150908e-06, -1.1920928244535389e-07, -5.1020273531321436e-05, 0.0, -4.23184028477408e-05, -5.960462772236497e-07, -7.152531907195225e-06, -4.529942543740617e-06, -8.583032467868179e-06, 0.0, -1.5497195136049413e-06, -4.768370445162873e-07, -3.862306402879767e-05, -8.344646857949556e-07, -8.344646857