nd > 0) {\n            priority_queue<ip, vector<ip>, greater<ip>> pq;\n            fill(shortestPath, shortestPath + vertexCount, INFINITY);\n            shortestPath[source] = 0;\n            pq.emplace(0, source);\n            while (!pq.empty()) {\n                auto [dist, u] = pq.top(); pq.pop();\n                if (shortestPath[u] < dist) continue;\n                for (int i = 0; i < adjacency[u].size(); ++i) {\n                    auto& arc = adjacency[u][i];\n                    if (arc.capacity > 0 && shortestPath[arc.destination] > shortestPath[u] + arc.weight + height[u] - height[arc.destination]) {\n                        shortestPath[arc.destination] = shortestPath[u] + arc.weight + height[u] - height[arc.destination];\n                        predecessorVertex[arc.destination] = u;\n                        predecessorArc[arc.destination] = i;\n                        pq.emplace(shortestPath[arc.destination], arc.destination);\n                    }\n                }\n            }\n            if (shortestPath[sink] == INFINITY) return -1;\n            for (int i = 0; i < vertexCount; ++i) height[i] += shortestPath[i];\n            int flow = demand;\n            for (int v = sink; v != source; v = predecessorVertex[v])\n                flow = min(flow, adjacency[predecessorVertex[v]][predecessorArc[v]].capacity);\n            demand -= flow;\n            totalCost += flow * height[sink];\n            for (int v = sink; v != source; v = predecessorVertex[v]) {\n                auto& arc = adjacency[predecessorVertex[v]][predecessorArc[v]];\n                arc.capacity -= flow;\n                adjacency[v][arc.complement].capacity += flow;\n            }\n        }\n        return totalCost;\n    }\n};\n\nMinCostMaxFlow mcf;\nint n, m, k, c, d;\nint input[50], frequency[50];\nvector<int> neighbors[50];\nconst int TIMESTEP = 100;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    for 