aps[i][j].no[k])\n\n        for di, dj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            k, l = i + di, j + dj\n            if 0 <= k < n and 0 <= l < n and d1[k][l] > d1[i][j] + 1:\n                d1[k][l] = d1[i][j] + 1\n                q.append(Node(k, l, 0))\n\ndef dfs(s):\n    if col[s]:\n        return False\n    col[s] = 1\n\n    for i in range(len(v[s])):\n        k = v[s][i]\n        if left[k] == -1:\n            left[k] = s\n            right[s] = i\n            return True\n        elif dfs(left[k]):\n            left[k] = s\n            right[s] = i\n            return True\n\n    return False\n\ndef match(n):\n    global left, right, col\n    left = [-1] * 1000\n    right = [-1] * 1000\n    col = [0] * 1000\n\n    while True:\n        done = True\n        for i in range(1, n + 1):\n            if right[i] == -1 and dfs(i):\n                done = False\n\n        if done:\n            break\n\n    k = 0\n    for i in range(1, n + 1):\n        if right[i] != -1:\n            k += 1\n\n    return k\n\ndef read_input():\n    global n, t\n    n, t = map(int, input().split())\n\n    for i in range(n):\n        grid[i] = input()\n\n    for i in range(n):\n        grid1[i] = input()\n\n    for i in range(n):\n        for j in range(n):\n            if grid[i][j] == 'Z':\n                bfs(Node(i, j, 0))\n\n    mark = 1\n\n    for i in range(n):\n        for j in range(n):\n            if grid1[i][j].isdigit():\n                k = int(grid1[i][j])\n                if k > 0:\n                    caps[i][j].fl = 1\n                caps[i][j].ind = k\n                for l in range(1, k + 1):\n                    caps[i][j].no[l] = mark\n                mark += 1\n\n    mark = 1\n\n    for i in range(n):\n        for j in range(n):\n            if grid[i][j].isdigit():\n                k = int(grid[i][j])\n                for l in range(1, k + 1):\n                    bfs(Node(i, j, mark))\n                    mark += 1\n\n    print(match(mark - 1))\n\nif _