{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MOD = 1000000007;\ntypedef long long ll;\n\nstruct Mod {\n    int x;\n    Mod(ll v = 0) : x(v % MOD) { if (x < 0) x += MOD; }\n    Mod operator+(const Mod& o) const { return Mod(x + o.x); }\n    Mod operator*(const Mod& o) const { return Mod((ll)x * o.x); }\n    Mod& operator+=(const Mod& o) { x = (x + o.x) % MOD; return *this; }\n    Mod& operator*=(const Mod& o) { x = (ll)x * o.x % MOD; return *this; }\n    Mod operator/(int d) const { return *this * Mod(pow_mod(d, MOD-2)); }\n    static ll pow_mod(ll a, ll e) { ll r=1; while(e) { if(e&1) r=r*a%MOD; a=a*a%MOD; e>>=1; } return r; }\n};\n\nconstexpr int S = 128;\n\nclass E2MarekAndMatchingHardVersion {\npublic:\n    void solve(istream& cin, ostream& cout) {\n        int N; cin >> N;\n        vector<vector<int>> P(N, vector<int>(N));\n        for (int i=0; i<N; ++i) for (int j=0; j<N; ++j) cin >> P[i][j];\n\n        // Use a map from bitset to Mod, but avoid converting to vector by iterating over bits directly\n        map<bitset<S>, Mod> G;\n        bitset<S> start; start[0] = 1;\n        G[start] = 1;\n\n        for (int i = 0; i < N; ++i) {\n            map<bitset<S>, Mod> H;\n            for (auto& g : G) {\n                H[g.first] = g.second; // just copy, we'll iterate over bits later\n            }\n            G.clear();\n            for (int j = 0; j < (1<<N); ++j) {\n                Mod pst = 1;\n                for (int k = 0; k < N; ++k) {\n                    if (j & (1<<k)) pst = pst * Mod(P[i][k]);\n                    else pst = pst * Mod(100 - P[i][k]);\n                }\n                for (auto& h : H) {\n                    bitset<S> cur = h.first;\n                    bitset<S> ans;\n                    for (int l = 0; l < N; ++l) {\n                        if ((j & (1<<l)) == 0) continue;\n                        for (int m = 0; m < (1<<N); ++m) {\n                            if (cur[m] && ((m & (1<<l)) == 0)) {\n                                ans[m | (1<<l)] = 1;\n                            }\n                        }\n                    }\n                    if (ans.any()) {\n                        G[ans] += h.second * pst;\n                    }\n                }\n            }\n        }\n\n        Mod ans = 0;\n        for (auto& g : G) ans += g.second;\n        Mod inv100 = Mod(1) / 100;\n        for (int i = 0; i < N*N; ++i) ans = ans * inv100;\n        cout << ans.x << endl;\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false); cin.tie(nullptr);\n    E2MarekAndMatchingHardVersion solver;\n    solver.solve(cin, cout);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef pow_mod(a, e):\n    r = 1\n    while e:\n        if e & 1:\n            r = r * a % MOD\n        a = a * a % MOD\n        e >>= 1\n    return r\n\nclass Mod:\n    def __init__(self, v=0):\n        self.x = v % MOD\n        if self.x < 0:\n            self.x += MOD\n\n    def __add__(self, other):\n        return Mod(self.x + other.x)\n\n    def __mul__(self, other):\n        return Mod(self.x * other.x)\n\n    def __iadd__(self, other):\n        self.x = (self.x + other.x) % MOD\n        return self\n\n    def __imul__(self, other):\n        self.x = (self.x * other.x) % MOD\n        return self\n\n    def __truediv__(self, d):\n        return self * Mod(pow_mod(d, MOD - 2))\n\n    def __repr__(self):\n        return str(self.x)\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    P = [[0] * N for _ in range(N)\n    for i in range(N):\n        for j in range(N):\n            P[i][j] = int(next(it))\n    G = {}\n    start = 1 << 0  # bit 0 set (empty matching)\n    G[start] = Mod(1)\n    for i in range(N):\n        H = G.copy()\n        G.clear()\n        for j in range(1 << N):\n            pst = Mod(1)\n            for k in range(N):\n                if j & (1 << k):\n                    pst *= Mod(P[i][k])\n                else:\n                    pst *= Mod(100 - P[i][k])\n            for cur_state, cur_val in H.items():\n                ans = 0\n                m_bits = cur_state\n                while m_bits:\n                    lsb = m_bits & -m_bits\n                m = (lsb.bit_length() - 1)\n                m_bits ^= lsb\n                j_bits = j\n                while j_bits:\n                    lsb2 = j_bits & -j_bits\n                l = (lsb2.bit_length() - 1)\n                if not (m & (1 << l)):\n                    ans |= 1 << (m | (1 << l))\n                j_bits ^= lsb2\n                if ans:\n                    if ans in G:\n                        G[ans] += cur_val * pst\n                    else:\n                        G[ans] = cur_val * pst\n    total = Mod(0)\n    for val in G.values():\n        total += val\n    inv100 = Mod(1) / 100\n    for _ in range(N * N):\n        total *= inv100\n    