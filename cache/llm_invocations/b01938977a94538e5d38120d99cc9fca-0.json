f, o):\n        if self.c.equals(o.c):\n            return None\n        dir_vec = o.c.sub(self.c)\n        d2 = dir_vec.mag2()\n        d = math.sqrt(d2)\n        if self.r + o.r < d or self.r + d < o.r or o.r + d < self.r:\n            return None\n        if abs(self.r + o.r - d) < Vec.EPS or abs(o.r + d - self.r) < Vec.EPS:\n            return [self.c.add(dir_vec.scale(self.r / d))]\n        if abs(self.r + d - o.r) < Vec.EPS:\n            return [self.c.sub(dir_vec.scale(self.r / d))]\n        d1 = (self.r * self.r + d2 - o.r * o.r) / (2 * d)\n        h = math.sqrt(self.r * self.r - d1 * d1)\n        unitDir = dir_vec.unit()\n        rInt = self.c.add(unitDir.scale(d1)).add(unitDir.rot270().scale(h))\n        lInt = self.c.add(unitDir.scale(d1)).add(unitDir.rot90().scale(h))\n        return [rInt, lInt]\n\ndef main():\n    input_lines = sys.stdin.read().splitlines()\n    n = int(input_lines[0])\n    circ = []\n    index = 1\n    for _ in range(n):\n        x = int(input_lines[index])\n        y = int(input_lines[index + 1])\n        r = int(input_lines[index + 2])\n        index += 3\n        circ.append(Circle(Vec(x, y), r))\n    points = []\n    par = list(range(n))\n    res = 1\n    for i in range(n):\n        points2 = []\n        for j in range(n):\n            if i == j:\n                continue\n            arr = circ[i].intersect(circ[j])\n            if arr is None:\n                continue\n            a = par[i]\n            b = par[j]\n            par[a] = b\n            for e in arr:\n                if any(e.equals(e2) for e2 in points2):\n                    continue\n                points2.append(e)\n        res += len(points2)\n        for e in points2:\n            if any(e.equals(e2) for e2 in points):\n                continue\n            points.append(e)\n    res -= len(points)\n    res += sum(1 - abs(math.copysign(1, i - par[i])) for i in range(n))\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<conf