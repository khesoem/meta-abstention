     for (int k = j + 1; k <= 6; ++k)\n                if (checkTriple(i, j, k)) {\n                    int x = 1;\n                    while (x == i || x == j || x == k) ++x;\n                    int y = x + 1;\n                    while (y == i || y == j || y == k) ++y;\n                    int z = y + 1;\n                    while (z == i || z == j || z == k) ++z;\n                    sta |= h[x][y][z];\n                }\n    p1[sta] = (p1[sta] + P) % mod;\n}\n\nvoid finishSecond(int P) {\n    int sta = 0;\n    for (int i = 1; i <= 6; ++i)\n        for (int j = i + 1; j <= 6; ++j)\n            for (int k = j + 1; k <= 6; ++k)\n                if (checkTriple(i, j, k)) sta |= h[i][j][k];\n    p2[sta] = (p2[sta] + P) % mod;\n    ans = (ans + 1LL * p1[lim ^ sta] * P) % mod;\n}\n\nvoid runPhase(int phase) {\n    vector<State> st;\n    st.push_back({0, 1, 1, phase ? 4 : 1});\n\n    while (!st.empty()) {\n        State cur = st.back();\n        st.pop_back();\n\n        if (cur.x == 7) {\n            setFlagMask(cur.mask);\n            if (cur.y == 1) finishFirst(cur.P);\n            else finishSecond(cur.P);\n            continue;\n        }\n\n        int col = cur.y <= 3 ? cur.y : cur.y - 3;\n        int id = (cur.x - 1) * 3 + (col - 1);\n        int nx = (cur.y == 3 || cur.y == 6) ? cur.x + 1 : cur.x;\n        int ny;\n        if (cur.y == 3) ny = 1;\n        else if (cur.y == 6) ny = 4;\n        else ny = cur.y + 1;\n\n        int selected = 1LL * cur.P * a[cur.x][cur.y] % mod;\n        int skipped = 1LL * cur.P * (mod + 1 - a[cur.x][cur.y]) % mod;\n\n        st.push_back({cur.mask, skipped, nx, ny});\n        st.push_back({cur.mask | (1 << id), selected, nx, ny});\n    }\n}\n\nint main() {\n    scanf(\"%d\", &n);\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j) {\n            scanf(\"%d\", &a[i][j]);\n            a[i][j] = 1LL * a[i][j] * inv(100) % mod;\n        }\n    for (int i = n + 1; i <= 6; ++i) a[i][i] = 1;\n\n    int tot = 0;\n   