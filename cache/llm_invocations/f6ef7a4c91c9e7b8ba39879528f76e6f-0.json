[])\nans = 0\ndist = [INF64] * N\npred = [-1] * N\npe = [-1] * N\ninq = [0] * N\n\nsource = N - 2\ntarget = N - 1\n\ndef residualCapacity(x):\n    return e[x].capacity - e[x].flow\n\ndef pushFlow():\n    global ans\n    for i in range(N):\n        dist[i] = INF64\n        pred[i] = -1\n        pe[i] = -1\n        inq[i] = 0\n    dist[source] = 0\n    q = deque()\n    q.append(source)\n    inq[source] = 1\n    while q:\n        k = q.popleft()\n        inq[k] = 0\n        for x in g[k]:\n            if not residualCapacity(x):\n                continue\n            cost = e[x].cost\n            y = e[x].y\n            if dist[y] > dist[k] + cost:\n                dist[y] = dist[k] + cost\n                pred[y] = k\n                pe[y] = x\n                if inq[y] == 0:\n                    inq[y] = 1\n                    q.append(y)\n    cur = target\n    while cur != source:\n        e[pe[cur]].flow += 1\n        e[pe[cur] ^ 1].flow -= 1\n        cur = pred[cur]\n    ans += dist[target]\n\ndef addEdge(x, y, capacity, cost):\n    g[x].append(len(e))\n    e.append(Edge(y, capacity, 0, cost))\n    g[y].append(len(e))\n    e.append(Edge(x, 0, 0, -cost))\n\ndef input():\n    global n, m, k, c, d\n    data = sys.stdin.read().strip().split()\n    n, m, k, c, d = map(int, data[:5])\n    idx = 5\n    for _ in range(k):\n        x = int(data[idx])\n        idx += 1\n        x -= 1\n        addEdge(source, x, 1, 0)\n    timeLayers = 101\n    for i in range(timeLayers):\n        addEdge(i * n, target, k, i * c)\n    for _ in range(m):\n        x = int(data[idx])\n        y = int(data[idx + 1])\n        idx += 2\n        x -= 1\n        y -= 1\n        for i in range(timeLayers - 1):\n            for j in range(k):\n                addEdge(x + i * n, y + i * n + n, 1, d * (j * 2 + 1))\n        for i in range(timeLayers - 1):\n            for j in range(k):\n                addEdge(y + i * n, x + i * n + n, 1, d * (j * 2 + 1))\n    for i in range(n):\n        for j in range(timeLayers - 1):\n            addEdge(i + j * n, i + j * n + n, k, 0)\n    for _ in range(k):\n        pushFlow()\n    print(ans)\n\ndef solve():\n    # No additional implementation needed as main logic is in input()\n    pass\n\ndef main():\n    input()\n    solve()\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0016161426901817322, -0.000526938121765852, -5.512236498361744e-07, -7.107425062713446e-06, -0.12120313942432404, -0.0031791406217962503, -0.0003510741807986051, -0.6409309506416321, -9.805981972021982e-05, -9.746380237629637e-05, -0.020847240462899208, -0.000960296718403697, 0.0, -2.546478935983032e-05, -0.0007722244481556118, -0.12816034257411957, -0.2586042881011963, -0.39813506603240967, -0.5367769598960876, -1.5570885807392187e-05, -4.320199877838604e-07, -1.3856492842023727e-06, -1.282920129597187e-05, -1.1472419600977446e-06, -6.24179228907451e-05, -2.339278580620885e-06, -0.11296957731246948, -0.020542705431580544, -0.003600071184337139, -1.9361264946837764e-07, -8.995397365652025e-05, -0.5800765156745911, -2.6537622034084052e-05, -2.2200749754119897e-06, -0.014164566993713379, -6.704273118884885e-07, -3.054500666621607e-06, 0.0, -4.632542913896032e-05, -3.128163257315464e-07, -7.107425062713446e-06, -0.005234475247561932, -2.451116051815916e-05, -6.2729995988775045e-06, -1.9361264946837764e-07, -1.9027791495318525e-05, -8.53050296427682e-05, -3.8889261304575484e-06, -0.0019464874640107155, -3.054500666621607e-06, -1.3856492842023727e-06, -5.512236498361744e-07, -2.15310683415737e-05, -6.869017852295656e-06, -1.5048530030981055e-06, 0.0, -0.02634674683213234, 0.0, -0.0001422770437784493, -5.512236498361744e-07, -1.4855663721391466e-05, -7.517272024415433e-05, -6.611323624383658e-05, -1.4974866644479334e-05, 0.0, -1.0445127372804563e-05, -0.10147558152675629, -0.5970157384872437, -0.405038446187973, -0.003408231772482395, -0.015273897908627987, 0.0, -3.810037742368877e-05, 