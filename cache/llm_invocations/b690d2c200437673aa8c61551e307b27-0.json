{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <string>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nusing ll = long long;\n\nstruct MaxFlow {\n    struct Edge {\n        int dest;\n        int back;\n        ll cap;\n    };\n    \n    vector<vector<Edge>> adj;\n    vector<int> dist, cur;\n    int source, target;\n    \n    MaxFlow(int n, int s, int t) : adj(n), dist(n), cur(n), source(s), target(t) {}\n    \n    void connect(int u, int v, ll c) {\n        adj[u].push_back({v, (int)adj[v].size(), c});\n        adj[v].push_back({u, (int)adj[u].size()-1, 0});\n    }\n    \n    bool levelGraph() {\n        fill(dist.begin(), dist.end(), -1);\n        dist[source] = 0;\n        queue<int> q;\n        q.push(source);\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            for (auto &e : adj[u]) {\n                if (e.cap > 0 && dist[e.dest] == -1) {\n                    dist[e.dest] = dist[u] + 1;\n                    q.push(e.dest);\n                }\n            }\n        }\n        return dist[target] != -1;\n    }\n    \n    ll blockingFlow(int u, ll flow) {\n        if (u == target) return flow;\n        for (int &i = cur[u]; i < (int)adj[u].size(); ++i) {\n            Edge &e = adj[u][i];\n            if (e.cap > 0 && dist[e.dest] == dist[u] + 1) {\n                ll pushed = blockingFlow(e.dest, min(flow, e.cap));\n                if (pushed > 0) {\n                    e.cap -= pushed;\n                    adj[e.dest][e.back].cap += pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n    \n    ll solve() {\n        ll result = 0;\n        while (levelGraph()) {\n            fill(cur.begin(), cur.end(), 0);\n            ll pushed;\n            while ((pushed = blockingFlow(source, 1e18)) > 0) {\n                result += pushed;\n            }\n        }\n        return result;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, T;\n    cin >> n >> T;\n    \n    vector<string> grid(n);\n    int zy = -1, zx = -1;\n    for (int i = 0; i < n; ++i) {\n        cin >> grid[i];\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] == 'Z') {\n                zy = i; zx = j;\n            }\n        }\n    }\n    \n    string dummy;\n    getline(cin, dummy);\n    getline(cin, dummy);\n    \n    vector<string> exits(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> exits[i];\n    }\n    \n    vector<vector<int>> timeLimit(n, vector<int>(n, -1));\n    queue<pair<int, int>> q;\n    q.push({zy, zx});\n    timeLimit[zy][zx] = 0;\n    \n    const int dy[] = {1, -1, 0, 0};\n    const int dx[] = {0, 0, 1, -1};\n    \n    while (!q.empty()) {\n        auto [y, x] = q.front(); q.pop();\n        for (int d = 0; d < 4; ++d) {\n            int ny = y + dy[d], nx = x + dx[d];\n            if (ny < 0 || ny >= n || nx < 0 || nx >= n) continue;\n            if (timeLimit[ny][nx] != -1 || grid[ny][nx] == 'Y') continue;\n            timeLimit[ny][nx] = timeLimit[y][x] + 1;\n            if (timeLimit[ny][nx] < T) {\n                q.push({ny, nx});\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '0' && grid[i][j] <= '9') {\n                if (timeLimit[i][j] == -1) timeLimit[i][j] = T;\n                else timeLimit[i][j] = min(timeLimit[i][j], T);\n            }\n        }\n    }\n    \n    vector<vector<int>> nodeId(n, vector<int>(n, -1));\n    int nodeCount = 0;\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '0' && grid[i][j] <= '9') {\n                nodeId[i][j] = nodeCount++;\n            }\n            if (exits[i][j] >= '1' && exits[i][j] <= '9') {\n                nodeId[i][j] = nodeCount++;\n            }\n        }\n    }\n    \n    int src = 0, dst = nodeCount + 1;\n    MaxFlow flow(nodeCount + 2, src, dst);\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '1' && grid[i][j] <= '9') {\n                flow.connect(src, nodeId[i][j], grid[i][j] - '0');\n            }\n            \n            if (exits[i][j] >= '1' && exits[i][j] <= '9') {\n                flow.connect(nodeId[i][j], dst, exits[i][j] - '0');\n            }\n            \n            for (int d = 0; d < 4; ++d) {\n                int ni = i + dy[d], nj = j + dx[d];\n                if (ni < 0 || ni >= n || nj < 0 || nj >= n) continue;\n                if (grid[ni][nj] == 'Y' || grid[ni][nj] == 'Z') continue;\n                \n                if (nodeId[i][j] != -1 && nodeId[ni][nj] != -1) {\n                    flow.connect(nodeId[i][j], nodeId[ni][nj], 1000000000);\n                }\n            }\n        }\n    }\n    \n    cout << flow.solve() << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\nimport sys\n\nclass MaxFlow:\n    class Edge:\n        def __init__(self, dest, back, cap):\n            self.dest = dest\n            self.back = back\n            self.cap = cap\n\n    def __init__(self, n, s, t):\n        self.adj = [[] for _ in range(n)]\n        self.dist = [-1] * n\n        self.cur = [0] * n\n        self.source = s\n        self.target = t\n\n    def connect(self, u, v, c):\n        self.adj[u].append(self.Edge(v, len(self.adj[v]), c))\n        self.adj[v].append(self.Edge(u, len(self.adj[u]) - 1, 0))\n\n    def levelGraph(self):\n        self.dist = [-1] * len(self.dist)\n        self.dist[self.source] = 0\n        q = deque()\n        q.append(self.source)\n        while q:\n            u = q.popleft()\n            for e in self.adj[u]:\n                if e.cap > 0 and self.dist[e.dest] == -1:\n                    self.dist[e.dest] = self.dist[u] + 1\n                    q.append(e.dest)\n        return self.dist[self.target] != -1\n\n    def blockingFlow(self, u, flow):\n        if u == self.target:\n            return flow\n        for i in range(self.cur[u], len(self.adj[u])):\n            self.cur[u] = i\n            e = self.adj[u][i]\n            if e.cap > 0 and self.dist[e.dest] == self.dist[u] + 1:\n                pushed = self.blockingFlow(e.dest, min(flow, e.cap))\n                if pushed > 0:\n                    e.cap -= pushed\n                    self.adj[e.dest][e.back].cap += pushed\n                    return pushed\n        return 0\n\n    def solve(self):\n        result = 0\n        while self.levelGraph():\n            self.cur = [0] * len(self.cur)\n            pushed = self.blockingFlow(self.source, 10**18)\n            while pushed > 0:\n                result += pushed\n                pushed = self.blockingFlow(self.source, 10**18)\n        return result\n\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    n, T = map(int, data[0].split())\n    \n    grid = []\n    zy, zx = -1, -1\n    for i in range(1, n + 1):\n        grid.append(data[i])\n        for j in range(n):\n            if grid[i-1][j] == 'Z':\n                zy, zx = i-1, j\n    \n    # Skip two empty lines\n    idx = n + 1\n    while idx < len(data) and data[idx].strip() == \"\":\n        idx += 1\n    \n    exits = []\n    for i in range(n):\n        if idx + i < len(data):\n            exits.append(data[idx + i])\n        else:\n            exits.append(\"\")\n    \n    timeLimit = [[-1] * n for _ in range(n)]\n    q = deque()\n    q.append((zy, zx))\n    timeLimit[zy][zx] = 0\n    \n    dy = [1, -1, 0, 0]\n    dx = [0, 0, 1, -1]\n    \n    while q:\n        y, x = q.popleft()\n        for d in range(4):\n            ny, nx = y + dy[d], x + dx[d]\n            if ny < 0 or ny >= n or nx < 0 or nx >= n:\n                continue\n            if timeLimit[ny][nx] != -1 or grid[ny][nx] == 'Y':\n                continue\n            timeLimit[ny][nx] = timeLimit[y][x] + 1\n            if timeLimit[ny][nx] < T:\n                q.append((ny, nx))\n    \n    for i in range(n):\n        for j in range(n):\n            if '0' <= grid[i][j] <= '9':\n                if timeLimit[i][j] == -1:\n                    timeLimit[i][j] = T\n                else:\n                    timeLimit[i][j] = min(timeLimit[i][j], T)\n    \n    nodeId = [[-1] * n for _ in range(n)]\n    nodeCount = 0\n    \n    for i in range(n):\n        for j in range(n):\n            if '0' <= grid[i][j] <= '9':\n                nodeId[i][j] = nodeCount\n                nodeCount += 1\n            if '0' <= exits[i][j] <= '9':\n                nodeId[i][j] = nodeCount\n                nodeCount += 1\n    \n    src = 0\n    dst = nodeCount + 1\n    flow = MaxFlow(nodeCount + 2, src, dst)\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= grid[i][j] <= '9':\n                flow.connect(src, nodeId[i][j], ord(grid[i][j]) - ord('0'))\n            \n            if '1' <= exits[i][j] <= '9':\n                flow.connect(nodeId[i][j], dst, ord(exits[i][j]) - ord('0'))\n            \n            for d in range(4):\n                ni, nj = i + dy[d], j + dx[d]\n                if ni < 0 or ni >= n or nj < 0 or nj >= n:\n                    continue\n                if grid[ni][nj] == 'Y' or grid[ni][nj] == 'Z':\n                    continue\n                \n                if nodeId[i][j] != -1 and nodeId[ni][nj] != -1:\n                    flow.connect(nodeId[i][j], nodeId[ni][nj], 1000000000)\n    \n    print(flow.solve())\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017557987303007394, -2.0265558760002023e-06, -1.1920928244535389e-07, -0.4768942892551422, -0.00027533553657121956, -7.152555099310121e-07, -0.0003399271226953715, -0.003942694049328566, -0.00012432756193447858, -7.378782902378589e-05, -0.0015309053706005216, -0.014149109832942486, -0.38695448637008667, -2.3603161025675945e-05, -5.006777428206988e-06, -1.1920928244535389e-07, -0.0002972637885250151, -8.702239938429557e-06, -9.536738616588991e-07, -2.0265558760002023e-06, -0.34844550490379333, -5.960462772236497e-07, -8.4638240878121e-06, 0.0, -5.960462772236497e-07, -3.576278118089249e-07, -4.5536911784438416e-05, -1.1920928244535389e-07, -1.2755313036905136e-05, -2.884823152271565e-05, -2.50339189733495e-06, -3.4570634852570947e-06, -1.3947389561508317e-05, 0.0, -1.0132738680113107e-05, 0.0, -3.576272320060525e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -5.960462772236497e-07, -1.597391747054644e-05, -4.768370445162873e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -2.0265558760002023e-06, -1.4305104514278355e-06, -4.589452510117553e-05, 0.0, -2.7418097943154862e-06, -0.34911733865737915, -1.728519782773219e-05, -5.722029527532868e-06, -7.152555099310121e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, 0.0, -5.96046277223