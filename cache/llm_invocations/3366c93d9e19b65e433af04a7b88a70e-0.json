erse):\n        a = a[:]\n        len_ = 1\n        while len_ < sz:\n            for i in range(0, sz, len_ << 1):\n                for j in range(len_):\n                    u = a[i + j]\n                    v = a[i + j + len_]\n                    if not inverse:\n                        a[i + j + len_] = (u + v) % mod\n                    else:\n                        a[i + j + len_] = (v - u + mod) % mod\n            len_ <<= 1\n        return a\n    \n    g_transformed = []\n    for i in range(n + 1):\n        g_transformed.append(fwht(g[i], size, False))\n    \n    h = [0] * (n + 1)\n    p = [0] * (n + 1)\n    \n    f = [[0] * size for _ in range(n + 1)]\n    \n    for s in range(size):\n        for i in range(n + 1):\n            h[i] = g_transformed[i][s]\n        \n        # log series\n        p[0] = 0\n        for i in range(1, n + 1):\n            p[i] = (h[i] * i) % mod\n            for j in range(1, i):\n                p[i] = (p[i] - p[j] * h[i - j] % mod * j % mod + mod) % mod\n            p[i] = (p[i] * inv[i]) % mod\n        for i in range(n + 1):\n            h[i] = (p[i] + mod) % mod\n        \n        # multiply by k\n        for i in range(n + 1):\n            h[i] = (h[i] * k) % mod\n        \n        # exp series\n        p[0] = 1\n        for i in range(1, n + 1):\n            p[i] = 0\n            for j in range(1, i + 1):\n                p[i] = (p[i] + h[j] * p[i - j] % mod * j) % mod\n            p[i] = (p[i] * inv[i]) % mod\n        for i in range(n + 1):\n            h[i] = p[i]\n        \n        for i in range(n + 1):\n            f[i][s] = h[i]\n    \n    f_transformed = fwht(f[n], size, True)\n    \n    result = (f_transformed[size - 1] * fac[L]) % mod\n    result = (total - result + mod) % mod\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001770101225702092, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.047520700842142105, -0.