otal_nodes + 1):\n        adj[i].reverse()\n    \n    dist = [0] * (total_nodes + 1)\n    \n    def spfa():\n        nonlocal dist\n        dist = [INF] * (total_nodes + 1)\n        in_queue = [False] * (total_nodes + 1)\n        dist[src] = 0\n        q = deque([src])\n        in_queue[src] = True\n        while q:\n            x = q.popleft()\n            in_queue[x] = False\n            for idx in adj[x]:\n                e = edges[idx]\n                if e[2] <= 0:\n                    continue\n                y = e[0]\n                nd = dist[x] + e[3]\n                if nd < dist[y]:\n                    dist[y] = nd\n                    if not in_queue[y]:\n                        q.append(y)\n                        in_queue[y] = True\n        return dist[sink] < INF\n    \n    sys.setrecursionlimit(1000000)\n    \n    answer = 0\n    sent = 0\n    \n    while spfa():\n        while True:\n            used = [False] * (total_nodes + 1)\n            \n            def augment(x, flow):\n                if x == src:\n                    return flow\n                used[x] = True\n                pushed = 0\n                for idx in adj[x]:\n                    e = edges[idx]\n                    rev = edges[e[1]]\n                    y = e[0]\n                    if used[y] or rev[2] <= 0 or dist[x] < dist[y] + rev[3]:\n                        continue\n                    got = augment(y, min(flow - pushed, rev[2]))\n                    if got:\n                        rev[2] -= got\n                        e[2] += got\n                        pushed += got\n                        if pushed == flow:\n                            break\n                return pushed\n            \n            added = augment(sink, INF)\n            if added == 0:\n                break\n            sent += added\n            answer += dist[sink] * added\n    \n    # assert sent == k\n    print(answer)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<co