{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconstexpr int MAXN = 55;\nconstexpr int MAXT = 2 * MAXN;\nconstexpr int MAXP = MAXT * MAXN;\nconstexpr int MAXE = 5 * MAXT * MAXN * MAXN;\nconstexpr int INF = 1000000000;\n\nstruct Edge {\n    int to, rev, cap, cost;\n};\n\nvector<Edge> edges;\nvector<int> adj[MAXP];\n\nint n, m, k, c, d;\nint people[MAXN];\nint id[MAXN][MAXT];\nint src = 1, sink = 2, nodeCnt = 2;\nbool used[MAXP];\nint dist[MAXP];\nint answer;\n\nvoid addEdge(int u, int v, int cost, int cap) {\n    int fwd = (int)edges.size();\n    edges.push_back({v, fwd + 1, cap, cost});\n    edges.push_back({u, fwd, 0, -cost});\n    adj[u].push_back(fwd);\n    adj[v].push_back(fwd + 1);\n}\n\nbool spfa() {\n    for (int i = 1; i <= nodeCnt; ++i) {\n        used[i] = false;\n        dist[i] = INF;\n    }\n    queue<int> q;\n    dist[src] = 0;\n    q.push(src);\n    used[src] = true;\n    while (!q.empty()) {\n        int x = q.front();\n        q.pop();\n        used[x] = false;\n        for (int idx : adj[x]) {\n            const Edge &e = edges[idx];\n            if (e.cap <= 0) continue;\n            int y = e.to;\n            if (dist[y] > dist[x] + e.cost) {\n                dist[y] = dist[x] + e.cost;\n                if (!used[y]) {\n                    q.push(y);\n                    used[y] = true;\n                }\n            }\n        }\n    }\n    return dist[sink] < INF;\n}\n\nint augment(int x, int flow) {\n    if (x == src) return flow;\n    used[x] = true;\n    int pushed = 0;\n    for (int idx : adj[x]) {\n        Edge &e = edges[idx];\n        Edge &rev = edges[e.rev];\n        int y = e.to;\n        if (used[y] || rev.cap <= 0 || dist[x] < dist[y] + rev.cost) continue;\n        int got = augment(y, min(flow - pushed, rev.cap));\n        if (got) {\n            rev.cap -= got;\n            e.cap += got;\n            pushed += got;\n            if (pushed == flow) break;\n        }\n    }\n    return pushed;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    edges.reserve(MAXE);\n\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 1; i <= k; ++i) {\n        int x;\n        cin >> x;\n        ++people[x];\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= k + m + 2; ++j) {\n            id[i][j] = ++nodeCnt;\n            if (i == 1) addEdge(id[i][j], sink, c * (j - 1), INF);\n            if (j > 1) addEdge(id[i][j - 1], id[i][j], 0, INF);\n        }\n        if (people[i]) addEdge(src, id[i][1], 0, people[i]);\n    }\n    for (int i = 1; i <= m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 1; j <= k + m + 1; ++j) {\n            for (int cost = 1; cost <= 2 * k - 1; cost += 2) {\n                addEdge(id[a][j], id[b][j + 1], cost * d, 1);\n                addEdge(id[b][j], id[a][j + 1], cost * d, 1);\n            }\n        }\n    }\n\n    for (int i = 1; i <= nodeCnt; ++i) reverse(adj[i].begin(), adj[i].end());\n\n    int sent = 0;\n    while (spfa()) {\n        int add = -1;\n        while (add) {\n            memset(used, 0, sizeof(used));\n   