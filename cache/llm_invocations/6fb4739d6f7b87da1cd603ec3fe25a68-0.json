XE\n        self.nxt = [0] * MAXE\n        self.ecnt = 0\n        self.level = [0] * MAXN\n        self.it = [0] * MAXN\n\n    def init(self):\n        self.head = [-1] * MAXN\n        self.ecnt = 0\n\n    def add_edge(self, u, v, c):\n        self.to[self.ecnt] = v\n        self.cap[self.ecnt] = c\n        self.nxt[self.ecnt] = self.head[u]\n        self.head[u] = self.ecnt\n        self.ecnt += 1\n        self.to[self.ecnt] = u\n        self.cap[self.ecnt] = 0\n        self.nxt[self.ecnt] = self.head[v]\n        self.head[v] = self.ecnt\n        self.ecnt += 1\n\n    def bfs(self, s, t):\n        self.level = [-1] * MAXN\n        q = deque()\n        self.level[s] = 0\n        q.append(s)\n        while q:\n            v = q.popleft()\n            e = self.head[v]\n            while e != -1:\n                if self.cap[e] > 0 and self.level[self.to[e]] == -1:\n                    self.level[self.to[e]] = self.level[v] + 1\n                    q.append(self.to[e])\n                e = self.nxt[e]\n        return self.level[t] != -1\n\n    def dfs(self, v, t, f):\n        if v == t:\n            return f\n        e = self.it[v]\n        while e != -1:\n            if self.cap[e] > 0 and self.level[v] + 1 == self.level[self.to[e]]:\n                pushed = self.dfs(self.to[e], t, min(f, self.cap[e]))\n                if pushed:\n                    self.cap[e] -= pushed\n                    self.cap[e ^ 1] += pushed\n                    return pushed\n            e = self.nxt[e]\n            self.it[v] = e\n        return 0\n\n    def maxflow(self, s, t):\n        ans = 0\n        while self.bfs(s, t):\n            self.it = self.head[:]\n            while True:\n                pushed = self.dfs(s, t, 1 << 30)\n                if not pushed:\n                    break\n                ans += pushed\n        return ans\n\nflow = Flow()\n\ndef valid(r, c):\n    return 0 <= r < n and 0 <= c < n\n\ndef searchEdges(a, b):\n    mark = [[0] * n for _ in range(n)]\n    di