 * (L + 1)\n    ifac[L] = pow(fac[L], P - 2, P)\n    for i in range(L, 0, -1):\n        ifac[i-1] = ifac[i] * i % P\n\n    # collect bits of L (starting from 2^1)\n    bit = []\n    i = 1\n    while (1 << i) <= L:\n        if (L >> i) & 1:\n            bit.append(1 << i)\n        i += 1\n    n = len(bit)\n    m = 1 << n\n\n    # bit count for indices 0..m-1\n    bitcnt = [0] * m\n    for i in range(1, m):\n        bitcnt[i] = bitcnt[i >> 1] + (i & 1)\n\n    # build suma\n    suma = [[0] * m for _ in range(n + 1)]\n    for i in range(m):\n        s = 0\n        for j in range(n):\n            if (i >> j) & 1:\n                s += bit[j]\n        suma[bitcnt[i]][i] = ifac[s]\n\n    # FWHT (zeta transform) on each row of suma\n    for t in range(n + 1):\n        a = suma[t]\n        l = m\n        while l >= 2:\n            half = l >> 1\n            for j in range(0, m, l):\n                for k in range(half):\n                    a[j + k + half] = (a[j + k + half] + a[j + k]) % P\n            l >>= 1\n\n    # dp = copy of suma\n    dp = [row[:] for row in suma]\n\n    # reverse bits of K and count bits\n    revK = 0\n    cc = 0\n    tempK = K\n    while tempK:\n        revK = (revK << 1) | (tempK & 1)\n        cc += 1\n        tempK >>= 1\n    cc -= 1\n    revK >>= 1\n\n    # exponentiation loop\n    while cc > 0:\n        # square dp\n        tmp = [[0] * m for _ in range(n + 1)]\n        for a in range(n + 1):\n            for b in range(n + 1 - a):\n                f = tmp[a + b]\n                g = dp[a]\n                h = dp[b]\n                for j in range(m):\n                    f[j] += g[j] * h[j]\n        for t in range(n + 1):\n            row = tmp[t]\n            for j in range(m):\n                dp[t][j] = row[j] % P\n\n        if revK & 1:\n            # multiply by suma\n            tmp = [[0] * m for _ in range(n + 1)]\n            for a in range(n + 1):\n                for b in range(n + 1 - a):\n                    f = tmp[a + b]\n                    g = dp[a]\n                    h = suma[b]\n                    for j in range(m):\n                        f[j] += g[j] * h[j]\n            for t in range(n + 1):\n                row = tmp[t]\n                for j in range(m):\n                    dp[t][j] = row[j] % P\n\n        cc -= 1\n        revK >>= 1\n\n    # copy dp to sumc\n    sumc = [row[:] for row in dp]\n\n    # inverse FWHT (Mobius transform) on each row of sumc\n    for t in range(n + 1):\n        a = sumc[t]\n        l = 2\n        while l <= m:\n            half = l >> 1\n            for j in range(0, m, l):\n                for k in range(half):\n                    a[j + k + half] = (a[j + k + half] - a[j + k]) % P\n            l <<= 1\n        for j in range(m):\n            a[j] = a[j] % P\n\n    ans = (all_val - sumc[n][m - 1] * fac[L] % P + P) % P\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.775113539944869e-06, 0.0, 0.0, -0.0001691436773398891, -0.022556520998477936, -3.576278118089249e-07, -0.00043764073052443564, -0.004205906298011541, -0.5772987008094788, -0.5759536027908325, -8.821448318485636e-06, -4.768360213347478e-06, -9.536738616588991e-07, -1.311301275563892e-06, -0.16333352029323578, -2.3841855067985307e-07, -0.0007602662080898881, 0.0, -0.006837897468358278, -1.7881377516459906e-06, -0.011048096232116222, -2.861018856492592e-06, 0.0, -2.264974000354414e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -5.960462772236497e-07, 0.0, -5.829164365422912e-05, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -0.008618303574621677, -0.12693561613559723, 0.0, 0.0, 0.0, -3.576278118089249e-07, -0.12694862484931946, 0.0, -3.576278118089249e-07, -0.0002865380665753037, 0.0, -2.3841855067985307e-07, 0.0, -1.537788011773955e-05, -1.8954096958623268e-05, 0.0, -4.649054244509898e-05, -4.410734163684538e-06, 0.0, -2.3841855067985307e-07, 0.0, -1.1920922133867862e-06, -0.01