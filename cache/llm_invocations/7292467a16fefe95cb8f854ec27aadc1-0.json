UDGE\n    freopen(\"in.in\", \"r\", stdin);\n    freopen(\"out.out\", \"w\", stdout);\n#endif\n    scanf(\"%d\", &n);\n    int inv100 = power(100, MOD - 2, MOD);\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &p[i][j]);\n            p[i][j] = (ll)p[i][j] * inv100 % MOD;\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prod = 1;\n            for (int j = 0; j < n; ++j)\n                if ((mask >> j) & 1)\n                    prod = (ll)prod * p[i][j] % MOD;\n                else\n                    prod = (ll)prod * (MOD + 1 - p[i][j]) % MOD;\n            prob[i][mask] = prod;\n        }\n\n    for (int mask = 0; mask < (1 << n); ++mask) {\n        int pc = __builtin_popcount(mask);\n        vec[pc].push_back(mask);\n        id[mask] = (int)vec[pc].size() - 1;\n    }\n\n    keyShift = 0;\n    for (int i = 0; i <= n; ++i)\n        keyShift = max(keyShift, (int)vec[i].size());\n\n    for (int mask = 0; mask < (1 << n); ++mask) {\n        for (int bit = 0; bit < n; ++bit)\n            if (!((mask >> bit) & 1))\n                q[mask][1 << bit] = 1LL << id[mask | (1 << bit)];\n        for (int sub = 1; sub < (1 << n); ++sub) {\n            int low = sub & -sub;\n            q[mask][sub] = q[mask][low] | q[mask][sub ^ low];\n        }\n    }\n\n    cout << calc(0, 1) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef power(a, b, mod):\n    return pow(a, b, mod)\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    inv100 = power(100, MOD - 2, MOD)\n    p = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            p[i][j] = next(it) * inv100 % MOD\n\n    # prob[i][mask] for i from 0 to n-1, mask from 0 to (1<<n)-1\n    prob = [[0] * (1 << n) for _ in range(n)]\n    for i in range(n):\n        for mask in range(1 << n):\n            prod = 1\n            for j in range(n):\n                if (mask >> j) & 1:\n                    prod = prod * p[i][j] % MOD\n                else:\n                    prod = prod * (MOD + 1 - p[i][j]) % MOD\n            prob[i][mask] = prod\n\n    # vec[popcount] = list of masks with that popcount\n    vec = [[] for _ in range(n + 1)]\n    id_mask = [0] * (1 << n)\n    for mask in range(1 << n):\n        pc = mask.bit_count()\n        vec[pc].append(mask)\n        id_mask[mask] = len(vec[pc]) - 1\n\n    keyShift = max(len(vec[i]) for i in range(n + 1))\n\n    # q[mask][sub] is a bitmask of indices in vec[popcount(mask)+1]\n    q = [[0] * (1 << n) for _ in range(1 << n)]\n    for mask in range(1 << n):\n        for bit in range(n):\n            if not ((mask >> bit) & 1):\n                q[mask][1 << bit] = 1 << id_mask[mask | (1 << bit)]\n        for sub in range(1, 1 << n):\n            low = sub & -sub\n            q[mask][sub] = q[mask][low] | q[mask][sub ^ low]\n\n    memo = {}\n\n    def make_key(v, s):\n        return (v << keyShift) | s\n\n    def calc(v, s):\n        if s == 0:\n            return 0\n        if v == n:\n            return 1\n        key = make_key(v, s)\n        if key in memo:\n            return memo[key]\n        res = 0\n        for j in range(1, 1 << n):\n            ns = 0\n            for k in range(len(vec[v])):\n                if (s >> k) & 1:\n                    cur = vec[v][k]\n                    ns |= q[cur][j - (j & cur)]\n            res = (res + prob[v][j] * calc(v + 1, ns)) % MOD\n        memo[key] = res\n        return res\n\n    ans = calc(0, 1)\n    sys.stdout.write(str(ans) + '\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-4.660974445869215e-