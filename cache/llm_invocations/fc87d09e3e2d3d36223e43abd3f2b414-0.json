T, head, vv, nxtE, cap, pre, seen):\n        add = 10000000\n        v = T\n        while v != S:\n            e = pre[v]\n            add = min(add, cap[e])\n            v = vv[e ^ 1]\n        v = T\n        while v != S:\n            e = pre[v]\n            cap[e] -= add\n            cap[e ^ 1] += add\n            v = vv[e ^ 1]\n        ans += add\n    return ans\n\ndef main():\n    global dx, dy\n    dx = [0, 0, 1, -1]\n    dy = [1, -1, 0, 0]\n\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    limitT = int(next(it))\n    s1 = [next(it) for _ in range(n)]\n    s2 = [next(it) for _ in range(n)]\n\n    id = [[-1]*n for _ in range(n)]\n    cnt = 0\n    zx = zy = -1\n    for i in range(n):\n        for j in range(n):\n            if s1[i][j] == 'Z':\n                zx, zy = i, j\n            elif inside(i, j, n, s1):\n                cnt += 1\n                id[i][j] = cnt\n\n    S = 0\n    T = 2 * cnt + 1\n\n    head = [-1] * (T + 1)\n    vv = []\n    nxtE = []\n    cap = []\n    tot = 0\n\n    for i in range(n):\n        for j in range(n):\n            if inside(i, j, n, s1):\n                tot = buildNetwork(i, j, s1, s2, id, cnt, S, T, limitT, n, zx, zy, vv, nxtE, cap, head, tot)\n\n    pre = [0] * (T + 1)\n    seen = [0] * (T + 1)\n    result = maxFlow(S, T, head, vv, nxtE, cap, pre, seen)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00043644916149787605, -0.1271219700574875, -7.533743337262422e-05, -4.6491513785440475e-06, -4.172316494077677e-06, -1.9073468138230965e-06, 0.0, -1.4305104514278355e-06, -0.0003510097449179739, -0.4797694683074951, -0.02373531647026539, -2.372236667724792e-05, -5.960462772236497e-07, -3.93382906622719e-05, -2.4914430468925275e-05, -8.666139910928905e-05, -0.05105140060186386, -0.01866152137517929, -3.576278118089249e-07, -3.576278118089249e-07, -1.311301275563892e-