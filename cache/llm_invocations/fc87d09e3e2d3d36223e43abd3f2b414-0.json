a.push({sx, sy});\n    qb.push({zx, zy});\n    d1[sx][sy] = 0;\n    d2[zx][zy] = 0;\n\n    while (!qa.empty()) {\n        int layer = (int)qa.size();\n        while (layer--) {\n            int x = qa.front().first;\n            int y = qa.front().second;\n            qa.pop();\n\n            if (d2[x][y] >= 0) continue;\n\n            for (int i = 0; i < 4; ++i) {\n                int nx = x + dx[i];\n                int ny = y + dy[i];\n                if (inside(nx, ny) && d1[nx][ny] < 0) {\n                    d1[nx][ny] = d1[x][y] + 1;\n                    if (d1[nx][ny] > limitT) break;\n                    if (d2[nx][ny] >= 0) continue;\n                    qa.push({nx, ny});\n                    if (s2[nx][ny] != '0') {\n                        addEdge(id[sx][sy], id[nx][ny] + cnt, 10);\n                    }\n                }\n            }\n        }\n\n        layer = (int)qb.size();\n        while (layer--) {\n            int x = qb.front().first;\n            int y = qb.front().second;\n            qb.pop();\n\n            for (int i = 0; i < 4; ++i) {\n                int nx = x + dx[i];\n                int ny = y + dy[i];\n                if (inside(nx, ny) && d2[nx][ny] < 0) {\n                    d2[nx][ny] = d2[x][y] + 1;\n                    qb.push({nx, ny});\n                }\n            }\n        }\n    }\n}\n\nbool findAugPath() {\n    memset(seen, 0, sizeof(seen));\n    queue<int> q;\n    seen[S] = 1;\n    q.push(S);\n\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        for (int e = head[u]; e != -1; e = nxtE[e]) {\n            int v = vv[e];\n            if (cap[e] > 0 && !seen[v]) {\n                pre[v] = e;\n                if (v == T) return true;\n                seen[v] = 1;\n                q.push(v);\n            }\n        }\n    }\n    return false;\n}\n\nint maxFlow() {\n    int ans = 0;\n    while (findAugPath()) {\n        int add = 10000000;\n        for (int v = T; v != S; ) {\n            int e = pre[v];\n            add = min(add, cap[e]);\n            v = vv[e ^ 1];\n        }\n        for (int v = T; v != S; ) {\n            int e = pre[v];\n            cap[e] -= add;\n            cap[e ^ 1] += add;\n            v = vv[e ^ 1];\n        }\n        ans += add;\n    }\n    return ans;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> limitT;\n    for (int i = 0; i < n; ++i) cin >> s1[i];\n    for (int i = 0; i < n; ++i) cin >> s2[i];\n\n    memset(head, -1, sizeof(head));\n    tot = 0;\n    memset(id, -1, sizeof(id));\n    cnt = 0;\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (s1[i][j] == 'Z') {\n                zx = i;\n                zy = j;\n            } else if (inside(i, j)) {\n                id[i][j] = ++cnt;\n            }\n        }\n    }\n\n    S = 0;\n    T = 2 * cnt + 1;\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (inside(i, j)) buildNetwork(i, j);\n        }\n    }\n\n    cout << maxFlow() << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXE = 1000007\nMAXN = 1000\n\ndef inside(x, y, n, s1):\n    return 0 <= x < n and 0 <= y < n and '0' <= s1[x][y] <= '9'\n\ndef addEdge(u, v, c, vv, nxtE, cap, head, tot):\n    vv.append(v)\n    nxtE.append(head[u])\n    cap.append(c)\n    head[u] = tot\n    tot += 1\n\n    vv.append(u)\n    nxtE.append(head[v])\n    cap.append(0)\n    head[v] = tot\n    tot += 1\n    return tot\n\ndef buildNetwork(sx, sy, s1, s2, id, cnt, S, T, limitT, n, zx, zy, vv, nxtE, cap, head, tot):\n    if s2[sx][sy] != '\\0':\n        tot = addEdge(id[sx][sy] + cnt, T, ord(s2[sx][sy]) - ord('0'), vv, nxtE, cap, head, tot)\n    if s1[sx][sy] == '0':\n        return tot\n    tot = addEdge(S, id[sx][sy]