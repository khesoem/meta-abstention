         dfs(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n    }\n\n    static long solve(long x, long y, int v1, int v2) {\n        State state = new State(x, v1, v2);\n        if (dp.containsKey(state)) return dp.get(state);\n        long diff = Math.abs(x - y);\n        if (diff - sumC[v1] * sumC[v2] > best) {\n            dp.put(state, 0L);\n            return 0;\n        }\n        if (v1 < R || v2 < R) {\n            if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n                int sum = v1 + v2;\n                v1 -= cntA[sum];\n                v2 -= cntB[sum];\n                long res = binom[v1 + v2][v1];\n                dp.put(state, res);\n                return res;\n            }\n            dp.put(state, 0L);\n            return 0;\n        }\n        long res = 0;\n        char c = s.charAt(v1 + v2 - 1);\n        if (c != 'B') {\n            long cur1 = diffC[v1];\n            long sum2 = sumC[v2];\n            res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (c != 'A') {\n            long sum1 = sumC[v1];\n            long cur2 = diffC[v2];\n            res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n        dp.put(state, res);\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        R = sc.nextInt();\n        C = sc.nextInt();\n        int maxN = 2 * (R + C);\n        binom = new long[maxN + 1][maxN + 1];\n        for (int i = 0; i <= maxN; i++) {\n            for (int j = 0; j <= maxN; j++) {\n                if (j == 0) binom[i][j] = 1;\n                else if (i == 0) binom[i][j] = 0;\n                else binom[i][j] = binom[i - 1][j] + binom[i - 1][j - 1];\n            }\n        }\n        total = binom[R + C][R] * binom[R + C][R];\n        precompute();\n        {\n            long x = 0, y = 0;\n            int v1 = R + C, v2 = R + C;\n            while (v1 >= R && v2 >= R) {\n                if (x > y) {\n                    long cur1 = diffC[v1];\n                    long sum2 = sumC[v2];\n                    y += cur1 * sum2;\n                    v1--;\n                } else {\n                    long sum1 = sumC[v1];\n                    long cur2 = diffC[v2];\n                    x += sum1 * cur2;\n                    v2--;\n                }\n            }\n            best = Math.abs(x - y);\n        }\n        dfs(0, 0, R + C, R + C);\n        s = sc.next();\n        int len = 2 * (R + C);\n        cntA = new int[len + 1];\n        cntB = new int[len + 1];\n        cntA[0] = cntB[0] = 0;\n        for (int i = 0; i < len; i++) {\n            cntA[i + 1] = cntA[i] + (s.charAt(i) == 'A' ? 1 : 0);\n            cntB[i + 1] = cntB[i] + (s.charAt(i) == 'B' ? 1 : 0);\n        }\n        long ans = solve(0, 0, R + C, R + C);\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.07287787614041e-05, 0.0, 0.0, -7.974783511599526e-05, -0.00011073929636040702, 0.0, -6.842378934379667e-05, -0.005876525770872831, -0.0015088851796463132, 0.0, -1.5020257706055418e-05, -0.0011722128838300705, -5.483612312673358e-06, -0.00026556302327662706, -0.0007535954937338829, -0.0007185738068073988, -2.9802276912960224e-06, 0.0, -0.00014423283573705703, 0.0, -1.1920928244535389e-07, -0.00015877417172305286, -2.3841855067985307e-07, -4.6132929128361866e-05, 0.0, -3.0874729418428615e-05, 0.0, -2.7656173188006505e-05, -8.344646857949556e-07, -0.011049157939851284, -0.0007251255447044969, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0006767605082131922, -0.31350773572921753, 0.0, 0.0, -0.7499092817306519, -1.1920928244535389e-07, -2.3603161025675945e-05, -8.940656698541716e-06, 0.0, -0.12694254517555237, -0.0001234931987710297, -2.145764938177308e-06, 0.0, -0.00021371940965764225, -1.6689160474925302e-05, -9.60780744208023e-05, -0.38697779178619385, -0.0019370617810636759, -0.00035124807618