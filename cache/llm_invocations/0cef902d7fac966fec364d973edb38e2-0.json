class Vector:\n        def __init__(self, a, sz):\n            self.sz = sz\n            self.v = [0] * sz\n            for i in range(len(a)):\n                self.v[i] = a[i]\n\n        def FFT(self):\n            return self.DFT(0, 1, True)\n\n        def FFT1(self):\n            x = self.DFT(0, 1, False)\n            for i in range(len(x)):\n                x[i] = (x[i] * self.szinv) % self.mod\n            return x\n\n        def DFT(self, first, pow, straight):\n            if pow == self.sz:\n                return [self.v[first]]\n            zero = self.DFT(first, 2 * pow, straight)\n            one = self.DFT(first + pow, 2 * pow, straight)\n            n = len(zero)\n            ans = [0] * (2 * n)\n            for i in range(n):\n                val = (self.warr[i * pow] if straight else self.winvarr[i * pow]) * one[i] % self.mod\n                ans[i] = (zero[i] + val) % self.mod\n                ans[n + i] = (zero[i] - val + self.mod) % self.mod\n            return ans\n\n    def fft(self, a):\n        ans = [0] * self.sz\n        for i in range(self.sz):\n            x = 1\n            for j in range(len(a)):\n                ans[i] = (ans[i] + a[j] * x) % self.mod\n                x = (x * self.w) % self.mod\n        return ans\n\n    def pow(self, ans, p):\n        for i in range(len(ans)):\n            ans[i] = self._pow(ans[i], p)\n        return ans\n\n    def _pow(self, x, p):\n        result = 1\n        base = x % self.mod\n        while p > 0:\n            if p % 2 == 1:\n                result = (result * base) % self.mod\n            base = (base * base) % self.mod\n            p //= 2\n        return result\n\n    def solve(self):\n        input_data = sys.stdin.read().strip().split()\n        n = int(input_data[0])\n        k = int(input_data[1])\n        arr = [0] * 10\n        for i in range(k):\n            arr[int(input_data[2 + i])] = 1\n        warr = self.warr\n        winvarr = self.winvarr\n        for i in range(1, self.sz):\n