n    int cnt = 0;\n    while (x && (x & 1) == 0) {\n        ++cnt;\n        x >>= 1;\n    }\n    return cnt;\n}\n\nint twoSum[262155];\n\nint nCr(int N, int M) {\n    return (long long)fact[N] * invFact[M] % MOD * invFact[N - M] % MOD;\n}\n\nint topDown(int N, int K) {\n    if (N == 0) return 1;\n    if (K == 0) return 0;\n    if (memoTable[N][K] != -1) return memoTable[N][K];\n    \n    int step = 1 << bitLog[N];\n    int sum = 0;\n    for (int i = N; i >= step; i -= 2) {\n        sum = (sum + (long long)nCr(N, i) * topDown(N - i, K - 1) % MOD * K) % MOD;\n    }\n    return memoTable[N][K] = sum;\n}\n\nvector<pair<int, int>> processingOrder;\n\nint bottomUp(int N, int K) {\n    queue<pair<int, int>> q;\n    q.push({N, K});\n    \n    while (!q.empty()) {\n        int curN = q.front().first;\n        int curK = q.front().second;\n        q.pop();\n        processingOrder.push_back({curN, curK});\n        \n        if (curN == 0 || curK == 0) continue;\n        \n        int step = 1 << bitLog[curN];\n        for (int i = curN; i >= step; i -= 2) {\n            if (twoSum[i] + twoSum[curN - i] == twoSum[curN] && !visitedTable[curN - i][curK - 1]) {\n                visitedTable[curN - i][curK - 1] = true;\n                q.push({curN - i, curK - 1});\n            }\n        }\n    }\n    \n    for (int i = processingOrder.size() - 1; i >= 0; --i) {\n        int curN = processingOrder[i].first;\n        int curK = processingOrder[i].second;\n        \n        if (curN == 0) {\n            memoTable[curN][curK] = 1;\n            continue;\n        }\n        if (curK == 0) {\n            memoTable[curN][curK] = 0;\n            continue;\n        }\n        \n        int step = 1 << bitLog[curN];\n        for (int i = curN; i >= step; i -= 2) {\n            if (twoSum[i] + twoSum[curN - i] == twoSum[curN]) {\n                memoTable[curN][curK] = (memoTable[curN][curK] + (long long)nCr(curN, i) * memoTable[curN - i][curK - 1] % MOD * curK) % MOD;\n            }\n    