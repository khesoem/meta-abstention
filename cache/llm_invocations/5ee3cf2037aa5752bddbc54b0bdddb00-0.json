    new Main().solve();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <cmath>\n\nusing namespace std;\n\nbool dfs(long long W, long long M) {\n    if (M == 1) return true;\n    if (M % W == 0) return dfs(W, M / W);\n    else if ((M - 1) % W == 0) return dfs(W, (M - 1) / W);\n    else if ((M + 1) % W == 0) return dfs(W, (M + 1) / W);\n    return false;\n}\n\nvoid solve() {\n    long long W, M;\n    cin >> W >> M;\n\n    int cur = 0;\n    while (pow(W, cur) < M) cur++;\n    double pw = pow(W, cur);\n\n    bool yes = false;\n    if (pw == M) {\n        yes = true;\n    } else {\n        long long max = (long long)pw;\n        long long sum = (max - 1) / (W - 1);\n        if (max - sum == M) {\n            yes = true;\n        } else {\n            yes = dfs(W, M);\n        }\n    }\n\n    cout << (yes ? \"YES\" : \"NO\") << endl;\n}\n\nint main() {\n    solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018535325943958014, -1.3351351299206726e-05, 0.0, -1.1920928244535389e-07, -3.9457496313843876e-05, -4.887569048150908e-06, -2.3841855067985307e-07, -1.311301275563892e-06, -1.0132738680113107e-05, 0.0, 0.0, -1.1920928244535389e-07, -0.16023527085781097, -0.03256399929523468, -2.8013790142722428e-05, 0.0, -1.1920858014491387e-05, -0.0692182332277298, -3.2186455882765586e-06, -2.7418097943154862e-06, 0.0, -2.50339189733495e-06, 0.0, 0.0, 0.0, 0.0, -0.00043442347669042647, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -4.768370445162873e-07, -0.000834355247206986, -0.038042906671762466, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.5497195136049413e-06, -4.768370445162873e-07, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -7.521823135903105e-05, -0.0031785464379936457, 0.0, 0