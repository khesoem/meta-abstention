n        dist[src] = 0;\n        priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n        pq.emplace(0, src);\n\n        while (!pq.empty()) {\n            auto [d, u] = pq.top(); pq.pop();\n            if (visited[u]) continue;\n            visited[u] = true;\n            for (int i = 0; i < graph[u].size(); ++i) {\n                auto& e = graph[u][i];\n                if (e.flow <= e.capacity - lb && dist[e.to] > dist[u] + pot[u] - pot[e.to] + e.cost) {\n                    dist[e.to] = dist[u] + pot[u] - pot[e.to] + e.cost;\n                    par_node[e.to] = u;\n                    par_edge[e.to] = i;\n                    pq.emplace(dist[e.to], e.to);\n                }\n            }\n        }\n        return dist[dst] < INF;\n    }\n\n    pair<ll, ll> augment(int src, int dst) {\n        ll flow = INF;\n        for (int v = dst; v != src; v = par_node[v]) {\n            auto& e = graph[par_node[v]][par_edge[v]];\n            flow = min(flow, e.capacity - e.flow);\n        }\n        ll cost = 0;\n        for (int v = dst; v != src; v = par_node[v]) {\n            auto& e = graph[par_node[v]][par_edge[v]];\n            e.flow += flow;\n            graph[v][e.reverse].flow -= flow;\n            cost += flow * graph[v][e.reverse].cost;\n        }\n        for (int i = 0; i < nodes; ++i) {\n            if (dist[i] < INF) pot[i] += dist[i];\n        }\n        return {flow, cost};\n    }\n\n    ll compute(int src, int dst, ll& totalCost) {\n        totalCost = 0;\n        ll totalFlow = 0;\n\n        for (ll lb = 1LL << 30; lb > 0; lb >>= 1) {\n            while (dijkstra(src, dst, lb)) {\n                auto [df, dc] = augment(src, dst);\n                totalFlow += df;\n                totalCost += dc;\n            }\n        }\n        return totalFlow;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> 