45];\nunordered_map<long long, long long> memo;\n\nlong long compute(long long valA, long long valB, int idxA, int idxB) {\n    long long key = valA * 10000 + idxA * 100 + idxB;\n    if (memo.count(key))\n        return memo[key];\n        \n    long long &result = memo[key];\n    long long diff = abs(valA - valB);\n    if (diff - comb[idxA][rows] * comb[idxB][rows] > minDiff) {\n        return result = 0;\n    }\n    \n    if (idxA < rows || idxB < rows) {\n        if (idxA >= prefixA[idxA + idxB] && idxB >= prefixB[idxA + idxB]) {\n            int total = idxA + idxB;\n            idxA -= prefixA[total];\n            idxB -= prefixB[total];\n            return result = comb[total][idxA];\n        }\n        return result = 0;\n    }\n    \n    result = 0;\n    char ch = inputStr[idxA + idxB - 1];\n    if (ch != 'B') {\n        long long deltaA = comb[idxA][rows] - comb[idxA - 1][rows];\n        long long sumB = comb[idxB][rows];\n        result += compute(valA, valB + deltaA * sumB, idxA - 1, idxB);\n    }\n    if (ch != 'A') {\n        long long sumA = comb[idxA][rows];\n        long long deltaB = comb[idxB][rows] - comb[idxB - 1][rows];\n        result += compute(valA + sumA * deltaB, valB, idxA, idxB - 1);\n    }\n    return result;\n}\n\nint main() {\n    scanf(\"%d %d\", &rows, &cols);\n    for (int i = 0; i <= 2 * (rows + cols); i++) {\n        for (int j = 0; j <= 2 * (rows + cols); j++) {\n            if (j == 0) comb[i][j] = 1;\n            else if (i == 0) comb[i][j] = 0;\n            else comb[i][j] = comb[i - 1][j] + comb[i - 1][j - 1];\n        }\n    }\n    \n    totalWays = comb[rows + cols][rows] * comb[rows + cols][rows];\n    \n    {\n        long long a = 0, b = 0;\n        int i = rows + cols, j = rows + cols;\n        while (i >= rows && j >= rows) {\n            if (a > b) {\n                long long deltaA = comb[i][rows] - comb[i - 1][rows];\n                long long sumB = comb[j][rows];\n                b += deltaA * sumB;\n            