 void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n        \n        int[] left_part = Arrays.copyOfRange(a, 0, n / 2);\n        int[] right_part = Arrays.copyOfRange(a, n / 2, n);\n        \n        List<Integer> left_sums = new ArrayList<>();\n        List<Integer> right_sums = new ArrayList<>();\n        \n        computeLeft(left_part, 0, 0, m, left_sums);\n        computeRight(right_part, 0, 0, m, right_sums);\n        \n        int ans = 0;\n        Set<Integer> leftSet = new HashSet<>(left_sums);\n        List<Integer> sortedLeft = new ArrayList<>(leftSet);\n        Collections.sort(sortedLeft);\n        \n        for (int r : right_sums) {\n            int needed = m - r;\n            int pos = binarySearchLeft(sortedLeft, needed);\n            if (pos > 0) {\n                int val = sortedLeft.get(pos - 1) + r;\n                if (val > ans) {\n                    ans = val;\n                }\n            }\n        }\n        \n        System.out.println(ans);\n    }\n    \n    private static void computeLeft(int[] left_part, int idx, int total, int m, List<Integer> left_sums) {\n        if (idx == left_part.length) {\n            left_sums.add(total % m);\n        } else {\n            computeLeft(left_part, idx + 1, (total + left_part[idx]) % m, m, left_sums);\n            computeLeft(left_part, idx + 1, total, m, left_sums);\n        }\n    }\n    \n    private static void computeRight(int[] right_part, int idx, int total, int m, List<Integer> right_sums) {\n        if (idx == right_part.length) {\n            right_sums.add(total % m);\n        } else {\n            computeRight(right_part, idx + 1, (total + right_part[idx]) % m, m, right_sums);\n            computeRight(right_part, idx + 1, total, m, right_sums);\n        }\n    }\n    \n    private static int binarySearchLeft(List<Integer> list, int target) {\n        int left = 0;\n        int right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) < target) {\n                left = mid + 1;\n            } else {\n                right = mid;\n            }\n        }\n        return left;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.667406266089529e-05, -1.9073468138230965e-06, -2.3841855067985307e-07, -3.802703940891661e-05, -1.6331539882230572e-05, -0.0021858150139451027, -0.10395216196775436, -1.9073468138230965e-06, -9.536738616588991e-07, -0.0001494772732257843, -9.298280929215252e-06, -1.0728830375228426e-06, -0.004508924670517445, -7.152555099310121e-07, -0.00011705666838679463, -2.145764938177308e-06, -1.1920922133867862e-06, -4.768370445162873e-07, -0.0001230164198204875, -7.152555099310121e-07, -3.576278118089249e-07, -1.5497195136049413e-06, -4.660974445869215e-05, -0.3903675973415375, -2.145764938177308e-06, -1.1920928244535389e-07, -1.0013530300057027e-05, -3.2186455882765586e-06, -3.814689989667386e-06, -3.576272320060525e-06, -0.47408097982406616, -2.13382354559144e-05, 0.0, -2.3841855067985307e-07, -1.7881377516459906e-06, -1.6689286894688848e-06, -1.4305104514278355e-06, -1.1920928244535389e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -9.775113539944869e-06, -9.536738616588991e-07, -5.960462772236497e-07, -1.1920928244535389e-07, -0.2519308030605316, -0.0013024666113778949, -3.576278118089249e-07, -3.576278118089249e-07, 0.0, -2.50339189733495e-06, -4.768370445162873e-07, -1.1920928244535389e-07, -3.814689989667386e-06, -3.5523738915799186e-05, -1.5497195136049413e-06, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -4.0531076592742465e-06, -1.0728830375228426e-06, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, -5.960462772236497e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -3.8146