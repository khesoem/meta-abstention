[l_idx-1][N]\n            sum_right = C[r_idx][N]\n            search(left, right + add_left * sum_right, l_idx - 1, r_idx)\n        \n        if r_idx >= N:\n            sum_left = C[l_idx][N]\n            add_right = C[r_idx][N] - C[r_idx-1][N]\n            search(left + sum_left * add_right, right, l_idx, r_idx - 1)\n    \n    search(0, 0, N + M, N + M)\n    \n    # Read input string\n    if len(input_data) > 1:\n        input_str = input_data[1].strip()\n    else:\n        input_str = \"\"\n    \n    # Precompute pa and pb arrays\n    pa = [0] * (2 * (N + M) + 10)\n    pb = [0] * (2 * (N + M) + 10)\n    \n    for i in range(len(input_str)):\n        pa[i+1] = pa[i] + (1 if input_str[i] == 'A' else 0)\n        pb[i+1] = pb[i] + (1 if input_str[i] == 'B' else 0)\n    \n    # DP memoization\n    dp = {}\n    \n    def recurse(val_a, val_b, ia, ib):\n        key = (val_a << 24) ^ (ia << 12) ^ ib\n        if key in dp:\n            return dp[key]\n        \n        diff = abs(val_a - val_b)\n        if diff - C[ia][N] * C[ib][N] > min_gap:\n            dp[key] = 0\n            return 0\n        \n        if ia < N or ib < N:\n            step = ia + ib\n            if ia >= pa[step] and ib >= pb[step]:\n                new_ia = ia - pa[step]\n                new_ib = ib - pb[step]\n                result = C[new_ia + new_ib][new_ia]\n                dp[key] = result\n                return result\n            dp[key] = 0\n            return 0\n        \n        ans = 0\n        if ia + ib - 1 < len(input_str):\n            c = input_str[ia + ib - 1]\n        else:\n            c = ''\n        \n        if c != 'B':\n            inc_a = C[ia][N] - C[ia-1][N]\n            sum_b = C[ib][N]\n            ans += recurse(val_a, val_b + inc_a * sum_b, ia - 1, ib)\n        \n        if c != 'A':\n            sum_a = C[ia][N]\n            inc_b = C[ib][N] - C[ib-1][N]\n            ans += recurse(val_a + sum_a * inc_b, val_b, ia, ib - 1)\n        \n        dp[key] = ans\n      