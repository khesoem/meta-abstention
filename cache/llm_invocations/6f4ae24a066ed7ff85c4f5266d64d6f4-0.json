t\ttmp=C(i,cur1);\t\n\t\t\trep(j,0,up){\n\t\t\t\tdp[i][j+1]=(dp[i][j+1]+1ll*dp[cur2][j]*tmp)%mod;\t\t\t\t\t\t\n\t\t\t}\n\t\t\tif(k==0)\tbreak;\n\t\t}\n\t}\n\trep(j,1,min(cnt[n],K))\tans=(ans+1ll*dp[n][j]*C(K,j)%mod*cj[j])%mod;\n\tans=(power(K,n)-ans+mod)%mod;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<original_code>\n#include<cstdio>\n#include<cstring>\n#include<algorithm>\n#define rep(i,a,b) for(i=a;i<=b;i++)\nusing namespace std;\nconst int N=300010;\n//const int N=20;\nint n,K,mod;\nint dp[N][20];\nint cnt[N],mx[N];\nint cj[N],inv[N];\n\nint power(int x,int y){\n\tint ret=1;\n\tfor(;y;y>>=1,x=1ll*x*x%mod){\n\t\tif(y&1)\tret=1ll*ret*x%mod;\n\t}\n\treturn ret;\n}\n\nint C(int i,int j){\n\treturn 1ll*cj[i]*inv[j]%mod*inv[i-j]%mod;\n}\n\nint main(){\n//\tfreopen(\"a.in\",\"r\",stdin);\n//\tfreopen(\"a.out\",\"w\",stdout);\nscanf(\"%d%d%d\",&n,&K,&mod);\nint i,j,k;int ans=0;int down,up,tmp,now,cur1,cur2;\nif(n&1){printf(\"%d\\n\",power(K,n));return 0;}\ncj[0]=1;rep(i,1,n)\tcj[i]=1ll*cj[i-1]*i%mod;\ninv[n]=power(cj[n],mod-2);inv[0]=1;\nfor(i=n-1;i;i--)\tinv[i]=1ll*inv[i+1]*(i+1)%mod;\nrep(i,1,n)\n\trep(j,0,18)\n\t\tif(1<<j&i)\tcnt[i]++;\nrep(i,1,n)\n\tfor(j=18;j>=0;j--)\n\t\tif(1<<j&i){mx[i]=1<<j;break;}\ndp[0][0]=1;\nrep(i,1,n){\n\tif((n&i)!=i)\tcontinue;\n\tnow=i^mx[i];\nfor(k=now;k>=0;k=(k-1)&now){\t\t\t\n\tcur1=k+mx[i];cur2=i^cur1;\nup=min(K-1,cnt[cur2]);\ntmp=C(i,cur1);\t\nrep(j,0,up){\n\tdp[i][j+1]=(dp[i][j+1]+1ll*dp[cur2][j]*tmp)%mod;\t\t\t\t\t\t\n}\nif(k==0)\tbreak;\n}\n}\nrep(j,1,min(cnt[n],K))\tans=(ans+1ll*dp[n][j]*C(K,j)%mod*cj[j])%mod;\nans=(power(K,n)-ans+mod)%mod;\nprintf(\"%d\\n\",ans);\nreturn 0;\n}\n\n</original_code>\n\n<translated_code>\ndef power(x, y, mod):\n    ret = 1\n    for _ in range(y.bit_length()):\n        if y & 1:\n    