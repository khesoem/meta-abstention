         for (int j = 0; j < step; ++j) {\n                    buf[i + j + step] = (buf[i + j] - buf[i + j + step] + mod) % mod;\n                }\n            }\n        }\n    } else {\n        for (int step = 1; step < len; step <<= 1) {\n            for (int i = 0; i < len; i += step << 1) {\n                for (int j = 0; j < step; ++j) {\n                    buf[i + j + step] = (buf[i + j] + buf[i + j + step]) % mod;\n                }\n            }\n        }\n    }\n    \n    for (int i = 0; i < len; ++i) {\n        a[i] = (int)(buf[i] % mod);\n        if (a[i] < 0) a[i] += mod;\n    }\n}\n\ninline void mod_reduce(long long &x) {\n    if (x >= mod2) x -= mod2;\n}\n\nvoid multiply_arrays() {\n    for (int i = 0; i <= 19; ++i) {\n        memset(t1[i], 0, sizeof(int[maxN + 1]));\n        memset(tmp_arr[i], 0, sizeof(long long[maxN + 1]));\n    }\n    \n    for (int i = 0; i <= maxN; ++i)\n        t1[popcount_arr[i]][i] = f[i];\n    \n    for (int i = 0; i <= 19; ++i)\n        fwht(t1[i], maxN + 1);\n    \n    for (int q = 0; q <= 19; ++q)\n        for (int l = 0; q + l <= 19; ++l)\n            for (int s = 0; s <= maxN; ++s)\n                mod_reduce(tmp_arr[q + l][s] += 1LL * t1[q][s] * t2[l][s]);\n    \n    for (int q = 0; q <= 19; ++q)\n        for (int s = 0; s <= maxN; ++s)\n            t3[q][s] = (int)(tmp_arr[q][s] % mod);\n    \n    for (int i = 0; i <= 19; ++i)\n        fwht(t3[i], maxN + 1, true);\n    \n    for (int i = 0; i <= maxN; ++i)\n        f[i] = t3[popcount_arr[i]][i];\n}\n\nvoid square_arrays() {\n    static int temp[20][MAXN];\n    for (int i = 0; i <= 19; ++i)\n        memset(tmp_arr[i], 0, sizeof(long long[maxN + 1]));\n    \n    for (int q = 0; q <= 19; ++q)\n        for (int l = 0; q + l <= 19; ++l)\n            for (int s = 0; s <= maxN; ++s)\n                mod_reduce(tmp_arr[q + l][s] += 1LL * t2[q][s] * t2[l][s]);\n    \n    for (int q = 0; q <= 19; ++q)\n        for (int s = 0; s <= maxN; ++s)\n            temp[q][s] = (int)