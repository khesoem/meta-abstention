 << 1):\n            for i in range(0, len_arr, step << 1):\n                for j in range(step):\n                    buf[i + j + step] = (buf[i + j] + buf[i + j + step]) % mod\n    \n    for i in range(len_arr):\n        a[i] = buf[i] % mod\n        if a[i] < 0:\n            a[i] += mod\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n    mod2 = mod * mod\n    \n    if n & 1:\n        print(binpow(k, n, mod))\n        return\n    \n    # Initialize arrays\n    MAXN = (1 << 19) + 5\n    f = [0] * MAXN\n    popcount_arr = [0] * MAXN\n    \n    # Precompute popcount\n    for i in range(MAXN):\n        popcount_arr[i] = bin(i).count('1')\n    \n    maxN = next_pow2(n + 1) - 1\n    \n    # Compute factorial and inverse factorial\n    fact = [1] * (maxN + 1)\n    inv_fact = [1] * (maxN + 1)\n    \n    for i in range(1, maxN + 1):\n        fact[i] = fact[i-1] * i % mod\n    \n    inv_fact[maxN] = binpow(fact[maxN], mod - 2, mod)\n    for i in range(maxN - 1, -1, -1):\n        inv_fact[i] = inv_fact[i+1] * (i + 1) % mod\n    \n    # Initialize t2 arrays (20 layers)\n    t2 = [[0] * (maxN + 1) for _ in range(20)]\n    for i in range(maxN + 1):\n        t2[popcount_arr[i]][i] = inv_fact[i]\n    \n    # Apply FWHT to t2\n    for i in range(20):\n        fwht(t2[i], maxN + 1, False)\n    \n    orig_k = k\n    while k:\n        if k & 1:\n            # multiply_arrays logic\n            t1 = [[0] * (maxN + 1) for _ in range(20)]\n            tmp_arr = [[0] * (maxN + 1) for _ in range(20)]\n            \n            for i in range(maxN + 1):\n                t1[popcount_arr[i]][i] = f[i]\n            \n            for i in range(20):\n                fwht(t1[i], maxN + 1, False)\n            \n            for q in range(20):\n                for l in range(20 - q + 1):\n                    for s in range(maxN + 1):\n                        tmp_arr[q + l][s] = (tmp_arr[q + l][s] + t1[q][s] * t2[l][s]) % mod\n            \n            t3 = [[0] * (maxN + 1) for _ in range(20)]\n            for q in range(20):\n                for s in range(maxN + 1):\n                    t3[q][s] = tmp_arr[q][s] % mod\n            \n            for i in range(20):\n                fwht(t3[i], maxN + 1, True)\n            \n            for i in range(maxN + 1):\n                f[i] = t3[popcount_arr[i]][i]\n        \n        k >>= 1\n        if k:\n            # square_arrays logic\n            temp = [[0] * (maxN + 1) for _ in range(20)]\n            tmp_arr = [[0] * (maxN + 1) for _ in range(20)]\n            \n            for q in range(20):\n                for l in range(20 - q + 1):\n                    for s in range(maxN + 1):\n                        tmp_arr[q + l][s] = (tmp_arr[q + l][s] + t2[q][s] * t2[l][s]) % mod\n            \n            for q in range(20):\n                for s in range(maxN + 1):\n                    temp[q][s] = tmp_arr[q][s] % mod\n            \n            for i in range(20):\n                fwht(temp[i], maxN + 1, True)\n            \n            for i in range(20):\n                t2[i] = [0] * (maxN + 1)\n            \n            for i in range(maxN + 1):\n                t2[popcount_arr[i]][i] = temp[popcount_arr[i]][i]\n            \n            for i in range(20):\n                fwht(t2[i], maxN + 1, False)\n    \n    result = (binpow(orig_k, n, mod) - fact[n] * f[n] % mod + mod) % mod\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.35\n</confidence>", "token_logprobs": [-0.00018094333063345402, -9.536738616588991e-07, -5.960462772236497e-07, -0.004552001599222422, -0.003351786872372031, -0.1797918677330017, -0.23039989173412323, -0.3447362184524536, -5.125868119648658e-05, -1.5497195136049413e-06, -1.1920928244535389e-07, 0.0, -0.00011228884250158444, -1.6569954823353328e-05, -4.792098479811102e-05, -2.3841855067985307e-07, -0.0004888770054094493, 0.0