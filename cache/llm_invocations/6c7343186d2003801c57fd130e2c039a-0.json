r(a_val), b, num1, den1);\n            if (error1 < smallestError || (fabs(error1 - smallestError) < 1e-12 && (int)floor(a_val) < numerator)) {\n                numerator = (int)floor(a_val);\n                denominator = b;\n                smallestError = error1;\n            }\n\n            double num2, den2;\n            double error2 = absoluteDifference(x, y, ceil(a_val), b, num2, den2);\n            if (error2 < smallestError || (fabs(error2 - smallestError) < 1e-12 && (int)ceil(a_val) < numerator)) {\n                numerator = (int)ceil(a_val);\n                denominator = b;\n                smallestError = error2;\n            }\n        }\n    }\n\n    int g = greatestCommonDivisor(numerator, denominator);\n    if (g != 1) {\n        numerator /= g;\n        denominator /= g;\n    }\n\n    cout << numerator << \"/\" << denominator << endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef greatestCommonDivisor(p, q):\n    g = max(p, q)\n    while True:\n        if p % g == 0 and q % g == 0:\n            break\n        g -= 1\n    return g\n\ndef absoluteDifference(x, y, m, d, num, den):\n    num[0] = abs(x * d - y * m)\n    den[0] = y * d\n    return num[0] / den[0]\n\ndef main():\n    x, y, n = map(float, input().split())\n    x = float(x)\n    y = float(y)\n    n = float(n)\n    \n    smallestError = 1e10\n    numerator = 0\n    denominator = 1\n\n    if n > y:\n        g = greatestCommonDivisor(int(x), int(y))\n        if g != 1:\n            x /= g\n            y /= g\n        print(f\"{int(x)}/{int(y)}\")\n        return\n\n    for b in range(int(n), 0, -1):\n        a_val = (x * b) / y\n        if a_val == math.floor(a_val):\n            numerator = int(a_val)\n            denominator = b\n            break\n        else:\n            num1 = [0]\n            den1 = [0]\n            error1 = absoluteDifference(x, y, math.floor(a_val), b, num1, den1)\n            if error1 < smallestError or (abs(error1 - smallestError) < 1e-12 and int(math.floor(a_val)) < numerator):\n                numerator = int(math.floor(a_val))\n                denominator = b\n                smallestError = error1\n\n            num2 = [0]\n            den2 = [0]\n            error2 = absoluteDifference(x, y, math.ceil(a_val), b, num2, den2)\n            if error2 < smallestError or (abs(error2 - smallestError) < 1e-12 and int(math.ceil(a_val)) < numerator):\n                numerator = int(math.ceil(a_val))\n                denominator = b\n                smallestError = error2\n\n    g = greatestCommonDivisor(numerator, denominator)\n    if g != 1:\n        numerator //= g\n        denominator //= g\n\n    print(f\"{numerator}/{denominator}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.807903602952138e-05, -5.960462772236497e-07, 0.0, -0.000491855782456696, -0.0019664489664137363, -0.1797938495874405, -4.172316494077677e-06, -9.047575440490618e-05, -0.34867027401924133, -3.909988299710676e-05, -2.3841855067985307e-07, -4.6491513785440475e-06, 0.0, -4.2199197196168825e-05, -2.9802276912960224e-06, -2.3841855067985307e-07, -1.1920922133867862e-06, -5.960462772236497e-07, -3.4570634852570947e-06, 0.0, 0.0, -3.099436753473128e-06, -7.152555099310121e-07, 0.0, -1.1920922133867862e-06, -7.152531907195225e-06, -2.3841855067985307e-07, 0.0, 0.0, -1.2874520507466514e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.0265558760002023e-06, 0.0, 0.0, -6.198863957251888e-06, -3.576278118089249e-07, -1.0728830375228426e-06, -1.311301275563892e-06, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -1.5139465176616795e-05, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -4.29152532