 pow(MOD - 2);\n        }\n\n        @Override\n        public String toString() {\n            return Integer.toString(v);\n        }\n    }\n\n    static class Pair {\n        List<Integer> key;\n        Mint value;\n        Pair(List<Integer> key, Mint value) {\n            this.key = key;\n            this.value = value;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n\n        Mint[][] mat = new Mint[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                int x = sc.nextInt();\n                mat[i][j] = new Mint(x).divide(new Mint(100));\n            }\n        }\n\n        List<Pair> sts = new ArrayList<>();\n        List<Integer> initList = new ArrayList<>();\n        initList.add(0);\n        sts.add(new Pair(initList, Mint.ONE));\n\n        for (int ph = 0; ph < n; ph++) {\n            TreeMap<List<Integer>, Mint> map = new TreeMap<>(new Comparator<List<Integer>>() {\n                @Override\n                public int compare(List<Integer> a, List<Integer> b) {\n                    int len = Math.min(a.size(), b.size());\n                    for (int i = 0; i < len; i++) {\n                        int cmp = Integer.compare(a.get(i), b.get(i));\n                        if (cmp != 0) return cmp;\n                    }\n                    return Integer.compare(a.size(), b.size());\n                }\n            });\n\n            int fullMask = 1 << n;\n            for (int f = 1; f < fullMask; f++) {\n                Mint freq = Mint.ONE;\n                for (int i = 0; i < n; i++) {\n                    if ((f >> i & 1) == 1) {\n                        freq = freq.multiply(mat[ph][i]);\n                    } else {\n                        freq = freq.multiply(Mint.ONE.subtract(mat[ph][i]));\n                    }\n                }\n\n                for (Pair st : sts) {\n                    List<Integer> nst = new ArrayList<>();\n                    for (int d : st.key) {\n                        for (int i = 0; i < n; i++) {\n                            if ((d >> i & 1) == 0 && (f >> i & 1) == 1) {\n                                nst.add(d ^ (1 << i));\n                            }\n                        }\n                    }\n                    if (nst.isEmpty()) continue;\n                    Collections.sort(nst);\n                    // dedup\n                    List<Integer> dedup = new ArrayList<>();\n                    for (int val : nst) {\n                        if (dedup.isEmpty() || dedup.get(dedup.size() - 1) != val) {\n                            dedup.add(val);\n                        }\n                    }\n                    Mint prob = st.value.multiply(freq);\n                    map.merge(dedup, prob, (a, b) -> a.add(b));\n                }\n            }\n\n            sts = new ArrayList<>();\n            for (Map.Entry<List<Integer>, Mint> e : map.entrySet()) {\n                sts.add(new Pair(e.getKey(), e.getValue()));\n            }\n        }\n\n        Mint ans = sts.isEmpty() ? Mint.ZERO : sts.get(0).value;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.6491513785440475e-06, 0.0, -3.576278118089249e-07, -1.7762025890988298e-05, -0.00012396997772157192, -2.0265558760002023e-06, -2.9682672902708873e-05, -0.06213163584470749, -0.0009744186536408961, -1.1920928244535389e-07, -6.6756979322235566e-06, -0.0141681507229805, -0.0004328744253143668, -0.007414679042994976, -0.0002649671514518559, -0.0005571481888182461, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.0008089845650829375, -0.16023162007331848, -2.1815061700181104e-05, -4.768370445162873e-07, -2.396077979938127e-05, -0.22878053784370422, -4.768370445162873e-07, -0.003273844253271818, -7.521823135903105e-05, -0.0005529781919904053, -3.540453326422721e-05, -7.152555099310121e-07, -0.00211