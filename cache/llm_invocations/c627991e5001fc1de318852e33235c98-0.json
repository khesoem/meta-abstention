cm / i);\n            double diff2 = Math.abs(target - ceil_val) / (double)current_lcm;\n            \n            if (diff2 < best_diff) {\n                best_diff = diff2;\n                num = ceil_mult;\n                den = i;\n            }\n        }\n        \n        long g = gcd(num, den);\n        num /= g;\n        den /= g;\n        \n        System.out.println(num + \"/\" + den);\n    }\n    \n    private static long gcd(long a, long b) {\n        if (b == 0) return a;\n        return gcd(b, a % b);\n    }\n    \n    private static long lcm(long a, long b) {\n        return a / gcd(a, b) * b;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001711698860162869, -1.311301275563892e-06, -3.576278118089249e-07, -0.00047291061491705477, -1.764281842042692e-05, -0.008634967729449272, -0.6949703693389893, -0.000302030734019354, -5.8410845667822286e-05, -0.005943956319242716, -0.0007471630233339965, -1.7762025890988298e-05, -4.768370445162873e-07, -2.4676019165781327e-05, -0.00012420836719684303, -9.417489309271332e-06, -0.3908054232597351, -1.0013530300057027e-05, -0.00021073981770314276, -1.7881377516459906e-06, -9.536738616588991e-07, -2.50339189733495e-06, -3.313963316031732e-05, -5.960462772236497e-07, -0.2014753222465515, -0.00978105328977108, -1.1086402082582936e-05, -7.629365427419543e-06, -0.005008057225495577, -0.00048029806930571795, -7.152555099310121e-07, -4.768370445162873e-07, -5.006777428206988e-06, -1.645074735279195e-05, -3.480850500636734e-05, -1.6689160474925302e-05, -1.5497195136049413e-06, -4.2199197196168825e-05, -1.1920922133867862e-06, -0.8699327707290649, -7.70062324590981e-05, -4.768370445162873e-07, -1.5497195136049413e-06, -9.214453893946484e-05, -7.152555099310121e-07, -1.1920858014491387e-05, -4.887569048150908e-06, -0.06994056701660156, -6.198863957251888e-06, -3.9219088648678735e-05, 0.0, -8.940656698541716e-06, -0.00019894051365554333, -0.000129691296024248, -4.184158387943171e-05, 