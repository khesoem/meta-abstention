rn;\n    \n    int k;\n    ll val;\n    for (k = 0, val = prefix; k <= 6 && val <= n; ++k) val *= 10;\n    --k;\n    \n    for (int i = 0; i <= k; ++i) {\n        val = total - prefix * ten[i];\n        answer = (answer + (val / MOD1 - (val < 0) + MOD2) * ten[i]) % MOD2;\n        val = (val % MOD1 + MOD1) % MOD1;\n        int pos = lower_bound(store[k][i].begin(), store[k][i].end(), MOD1 - val) - store[k][i].begin();\n        answer = (answer + ten[i] - pos) % MOD2;\n    }\n    for (int i = 0; i <= k; ++i) total += ten[i];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n;\n    ten[0] = 1;\n    for (int i = 1; i <= 6; ++i) ten[i] = ten[i-1] * 10;\n    \n    for (int k = 0; k <= 6; ++k) {\n        total = 0;\n        build(0, 0, k);\n        for (int i = 0; i <= k; ++i) {\n            sort(store[k][i].begin(), store[k][i].end());\n        }\n    }\n    \n    if (n < 1000000) {\n        total = 0;\n        for (int i = 1; i <= 9; ++i) brute_force(i, 1);\n    } else {\n        ll temp_n = n;\n        while (temp_n >= 1000000) temp_n /= 10;\n        total = 0;\n        for (int i = 1; i <= 9; ++i) solve_prefix(i, 1);\n    }\n    \n    cout << (int)((MOD2 - answer) * MOD1 % MOD2) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport bisect\nimport sys\n\nMOD1 = 998244353\nMOD2 = 1000000007\n\ndef main():\n    input_data = sys.stdin.read().split()\n    n = int(input_data[0])\n    \n    ten = [1] * 7\n    for i in range(1, 7):\n        ten[i] = ten[i-1] * 10\n    \n    store = [[[] for _ in range(7)] for _ in range(7)]\n    \n    def build(prefix, depth, max_depth):\n        nonlocal total\n        store[max_depth][depth].append(total - prefix + 1)\n        total += 1\n        if depth == max_depth:\n            return\n        for digit in range(10):\n            build(prefix * 10 + di