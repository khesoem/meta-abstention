] + wgt[e];\n\t\t\tmin_flow[to[e]] = min(min_flow[u], cap[e]);\n\t\t\tparent_edge[to[e]] = e;\n\t\t\tif (!inq[to[e]]) {\n\t\t\t\tinq[to[e]] = true;\n\t\t\t\tq.push(to[e]);\n\t\t\t}\n\t\t}\n\t}\n\treturn dist[dst] != INF;\n}\nvoid push_flow() {\n\tint f = min_flow[dst];\n\tint cur = dst;\n\twhile (cur != src) {\n\t\tint e = parent_edge[cur];\n\t\tcap[e] -= f;\n\t\tcap[e ^ 1] += f;\n\t\tcur = to[e ^ 1];\n\t}\n\tmin_cost += f * dist[dst];\n}\nint main() {\n\tscanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n\tdst = (n + k - 1) * n + 1;\n\tfor (int i = 1, x; i <= k; i++) {\n\t\tscanf(\"%d\", &x);\n\t\tconnect(src, x, 1, 0);\n\t}\n\tfor (int i = 1, u, v; i <= m; i++) {\n\t\tscanf(\"%d %d\", &u, &v);\n\t\tfor (int layer = 1; layer <= n + k; layer++) {\n\t\t\tfor (int hop = 1; hop <= k; hop++) {\n\t\t\t\tint weight = d * hop * 2 - d + c;\n\t\t\t\tconnect(u + (layer - 1) * n, v + layer * n, 1, weight);\n\t\t\t\tconnect(v + (layer - 1) * n, u + layer * n, 1, weight);\n\t\t\t}\n\t\t}\n\t}\n\tfor (int layer = 1; layer < n + k; layer++) {\n\t\tfor (int node = 2; node <= n; node++) {\n\t\t\tconnect(node + (layer - 1) * n, node + layer * n, 1000000000, c);\n\t\t}\n\t\tconnect(1 + (layer - 1) * n, 1 + layer * n, 1000000000, 0);\n\t}\n\twhile (find_path()) push_flow();\n\tprintf(\"%d\\n\", min_cost);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_NODES = 10000010;\n    static final int INF = 0x3f3f3f3f;\n    \n    static int n, m, c, d, k, src, dst, min_cost;\n    static int edge_idx = 1;\n    static int[] first = new int[MAX_NODES];\n    static int[] to = new int[MAX_NODES];\n    static int[] next_edge = new int[MAX_NODES];\n    static int[] cap = new int[MAX_NODES];\n    static int[] wgt = new int[MAX_NODES];\n    static int[] dist = new int[MAX_NODES];\n    static int[] min_flow = new int[MAX_NODES];\n    static int[] parent_edge = new int[MAX_NODES];\n    static boolean[] inq = new boolean[MAX_NODES];\n\n    static void connect(int u, int v, int capacity, int weight) {\n        to[++edge_idx] = v;\n        next_edge[edge_idx] = first[u];\n        first[u] = edge_idx;\n        cap[edge_idx] = capacity;\n        wgt[edge_idx] = weight;\n        to[++edge_idx] = u;\n        next_edge[edge_idx] = first[v];\n        first[v] = edge_idx;\n        cap[edge_idx] = 0;\n        wgt[edge_idx] = -weight;\n    }\n\n    static boolean find_path() {\n        Arrays.fill(min_flow, 0);\n        Arrays.fill(dist, INF);\n        Arrays.fill(inq, false);\n        Queue<Integer> q = new LinkedList<>();\n        q.push(src);\n        min_flow[src] = INF;\n        dist[src] = 0;\n        inq[src] = true;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            for (int e = first[u]; e != 0; e = next_edge[e]) {\n                if (cap[e] == 0 || dist[to[e]] <= dist[u] + wgt[e]) continue;\n                dist[to[e]] = dist[u] + wgt[e];\n                min_flow[to[e]] = Math.min(min_flow[u], cap[e]);\n                parent_edge[to[e]] = e;\n                if (!inq[to[e]]) {\n                    inq[to[e]] = true;\n                    q.push(to[e]);\n                }\n            }\n        }\n        return dist[dst] != INF;\n    }\n\n    static void push_flow() {\n        int f = min_flow[dst];\n        int cur = dst;\n        while (cur != src) {\n            int e = parent_edge[cur];\n            cap[e] -= f;\n            cap[e ^ 1] += f;\n            cur = to[e ^ 1];\n        }\n        min_cost += f * dist[dst];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        dst = (n + k - 1) * n + 1;\n        \n 