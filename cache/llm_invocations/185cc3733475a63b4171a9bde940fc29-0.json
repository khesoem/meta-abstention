d;\n        return *this;\n    }\n    MOD& operator*=(const MOD& rhs) {\n        val = (long long)val * rhs.val % mod;\n        return *this;\n    }\n    MOD& operator/=(const MOD& rhs) {\n        return *this *= rhs.inv();\n    }\n    friend MOD operator+(const MOD& a, const MOD& b) { return MOD(a) += b; }\n    friend MOD operator-(const MOD& a, const MOD& b) { return MOD(a) -= b; }\n    friend MOD operator*(const MOD& a, const MOD& b) { return MOD(a) *= b; }\n    friend MOD operator/(const MOD& a, const MOD& b) { return MOD(a) /= b; }\n    friend ostream& operator<<(ostream& os, const MOD& m) { os << m.val; return os; }\n};\n\nMOD fact[MAXV], invfact[MAXV];\n\nvoid init_factorials(int mod) {\n    fact[0] = MOD(mod, 1);\n    for(int i = 1; i < MAXV; i++) fact[i] = fact[i-1] * MOD(mod, i);\n    invfact[MAXV-1] = fact[MAXV-1].pow(mod-2);\n    for(int i = MAXV-2; i >= 0; i--) invfact[i] = invfact[i+1] * MOD(mod, i+1);\n}\n\nint mod_power(int base, int exp, int mod) {\n    int res = 1 % mod;\n    int cur = base % mod;\n    while(exp) {\n        if(exp & 1) res = (ll)res * cur % mod;\n        cur = (ll)cur * cur % mod;\n        exp >>= 1;\n    }\n    return res;\n}\n\nvoid solve() {\n    int n, m, mod;\n    cin >> n >> m >> mod;\n    init_factorials(mod);\n    auto get_pow = [&](int base, int exp) {\n        return MOD(mod, mod_power(base, exp, mod));\n    };\n    MOD ans(mod, 0);\n    for(int len = 1; len < m; len++) {\n        MOD f = MOD(mod, len+1).pow(len) * MOD(mod, len) / MOD(mod, n-len) * invfact[len];\n        for(int i = 0; i < m - len; i++) {\n            int j = i + len;\n            MOD g = get_pow(n-len, i) * invfact[i];\n            MOD h = MOD(mod, n-j) * get_pow(n+1, m-1-j) * fact[j];\n            ans += f * g * h;\n        }\n    }\n    ans *= get_pow(2, m-1) * MOD(mod, n+1-m);\n    cout << ans << \"\\n\";\n}\n\nint32_t main() {\n    cin.tie(0);\n    ios::sync_with_stdio(false);\n    cout << fixed << setprecision(20);\n    solve();\n    return 0;\n}\n<