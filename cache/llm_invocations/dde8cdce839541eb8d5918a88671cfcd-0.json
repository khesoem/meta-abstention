{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconstexpr int INF = 0x3f3f3f3f;\n\nstruct Edge {\n    int dest;\n    int reverse;\n    int capacity;\n    int weight;\n};\n\nvector<vector<Edge>> adj;\nvector<int> seen, ptr, d, pot;\nint total_nodes;\n\nint new_node() {\n    adj.emplace_back();\n    return total_nodes++;\n}\n\nvoid connect(int u, int v, int cap, int cost) {\n    adj[u].push_back({v, (int)adj[v].size(), cap, cost});\n    adj[v].push_back({u, (int)adj[u].size() - 1, 0, -cost});\n}\n\nbool shortest_path(int src, int dst) {\n    fill(d.begin(), d.end(), INF);\n    fill(seen.begin(), seen.end(), 0);\n    using pii = pair<int, int>;\n    priority_queue<pii, vector<pii>, greater<pii>> heap;\n    heap.emplace(d[src] = 0, src);\n    while (!heap.empty()) {\n        auto [du, u] = heap.top(); heap.pop();\n        if (seen[u]) continue;\n        seen[u] = true;\n        for (auto& e : adj[u]) {\n            int v = e.dest;\n            int dv = du + pot[u] + e.weight - pot[v];\n            if (e.capacity == 0 || seen[v] || d[v] <= dv) continue;\n            heap.emplace(d[v] = dv, v);\n        }\n    }\n    return seen[dst];\n}\n\nbool bfs_layered(int src, int dst) {\n    fill(seen.begin(), seen.end(), 0);\n    queue<int> q;\n    q.push(src);\n    seen[src] = 1;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (auto& e : adj[u]) {\n            int v = e.dest;\n            if (seen[v] || e.capacity == 0) continue;\n            if (d[v] != d[u] + e.weight - pot[v] + pot[u]) continue;\n            seen[v] = seen[u] + 1;\n            q.push(v);\n        }\n    }\n    return seen[dst];\n}\n\nint dfs_flow(int u, int dst, int flow) {\n    if (u == dst) return flow;\n    int pushed = 0;\n    for (int& i = ptr[u]; i < (int)adj[u].size(); ++i) {\n        auto& e = adj[u][i];\n        int v = e.dest;\n        if (e.capacity == 0 || seen[v] != seen[u] + 1) continue;\n        if (d[v] != d[u] + e.weight - pot[v] + pot[u]) continue;\n        int df = dfs_flow(v, dst, min(e.capacity, flow));\n        pushed += df;\n        flow -= df;\n        e.capacity -= df;\n        adj[v][e.reverse].capacity += df;\n        if (flow == 0) break;\n    }\n    return pushed;\n}\n\npair<int, int> solve(int src, int dst, int limit) {\n    int total_flow = 0, total_cost = 0;\n    fill(pot.begin(), pot.end(), 0);\n    while (shortest_path(src, dst)) {\n        int flow = 0;\n        while (bfs_layered(src, dst)) {\n            fill(ptr.begin(), ptr.end(), 0);\n            int df = dfs_flow(src, dst, limit);\n            limit -= df;\n            flow += df;\n            if (limit == 0) break;\n        }\n        total_flow += flow;\n        total_cost += (d[dst] + pot[dst]) * flow;\n        for (int i = 0; i < total_nodes; ++i)\n            pot[i] += d[i];\n        if (limit == 0) break;\n    }\n    return {total_flow, total_cost};\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int layers = max(n, k) * 2;\n    new_node();\n    int source = new_node();\n    int sink = new_node();\n    for (int j = 0;