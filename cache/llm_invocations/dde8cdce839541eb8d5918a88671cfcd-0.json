 - 1, 0, -cost))\n    \n    source = new_node()\n    sink = new_node()\n    \n    for j in range(k):\n        a = int(input_data[idx]); idx += 1\n        a -= 1\n        connect(source, a, 1, 0)\n    \n    for z in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        u -= 1\n        v -= 1\n        for i in range(layers - 1):\n            u1 = u + i * n\n            v1 = v + (i + 1) * n\n            u2 = u + (i + 1) * n\n            v2 = v + i * n\n            for j in range(k):\n                connect(u1, v1, 1, c + d_val * (2 * j + 1))\n                connect(v2, u2, 1, c + d_val * (2 * j + 1))\n    \n    for i in range(layers - 1):\n        for j in range(n):\n            u = j + i * n\n            v = j + (i + 1) * n\n            connect(u, v, INF, c)\n    \n    for i in range(layers):\n        connect(i * n, sink, INF, 0)\n    \n    # Dijkstra + DFS flow implementation\n    d = [INF] * total_nodes\n    seen = [0] * total_nodes\n    ptr = [0] * total_nodes\n    pot = [0] * total_nodes\n    \n    def shortest_path(src, dst):\n        for i in range(total_nodes):\n            d[i] = INF\n            seen[i] = 0\n        heap = []\n        d[src] = 0\n        heapq.heappush(heap, (0, src))\n        while heap:\n            du, u = heapq.heappop(heap)\n            if seen[u]:\n                continue\n            seen[u] = 1\n            for e in adj[u]:\n                v = e.dest\n                dv = du + pot[u] + e.weight - pot[v]\n                if e.capacity == 0 or seen[v] or d[v] <= dv:\n                    continue\n                d[v] = dv\n                heapq.heappush(heap, (dv, v))\n        return seen[dst]\n    \n    def bfs_layered(src, dst):\n        for i in range(total_nodes):\n            seen[i] = 0\n        queue = []\n        queue.append(src)\n        seen[src] = 1\n        while queue:\n            u = queue.pop(0)\n            for e in adj[u]:\n                v = e.dest\n                if seen[v] or e.capacity == 0:\n                    continue\n                if d[v] != d[u] + e.weight - pot[v] + pot[u]:\n                    continue\n                seen[v] = seen[u] + 1\n                queue.append(v)\n        return seen[dst]\n    \n    def dfs_flow(u, dst, flow):\n        if u == dst:\n            return flow\n        pushed = 0\n        while ptr[u] < len(adj[u]):\n            e = adj[u][ptr[u]]\n            v = e.dest\n            if e.capacity == 0 or seen[v] != seen[u] + 1:\n                ptr[u] += 1\n                continue\n            if d[v] != d[u] + e.weight - pot[v] + pot[u]:\n                ptr[u] += 1\n                continue\n            df = dfs_flow(v, dst, min(e.capacity, flow))\n            if df > 0:\n                pushed += df\n                flow -= df\n                e.capacity -= df\n                adj[v][e.reverse].capacity += df\n                if flow == 0:\n                    break\n            else:\n                ptr[u] += 1\n        return pushed\n    \n    def solve(src, dst, limit):\n        total_flow = 0\n        total_cost = 0\n        for i in range(total_nodes):\n            pot[i] = 0\n        while shortest_path(src, dst):\n            flow = 0\n            while bfs_layered(src, dst):\n                for i in range(total_nodes):\n                    ptr[i] = 0\n                df = dfs_flow(src, dst, limit)\n                limit -= df\n                flow += df\n                if limit == 0:\n                    break\n            total_flow += flow\n            total_cost += (d[dst] + pot[dst]) * flow\n            for i in range(total_nodes):\n                pot[i] += d[i]\n            if limit == 0:\n                break\n        return (total_flow, total_cost)\n    \n    result = solve(source, sink, INF)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00023398046323563904, -7.