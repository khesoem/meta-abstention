  int layer = (int)q1.size();\n        while (layer--) {\n            int x = q1.front().first;\n            int y = q1.front().second;\n            q1.pop();\n\n            if (d2[x][y] >= 0) continue;\n\n            for (int i = 0; i < 4; ++i) {\n                int nx = x + dx[i];\n                int ny = y + dy[i];\n                if (inside(nx, ny) && d1[nx][ny] < 0) {\n                    d1[nx][ny] = d1[x][y] + 1;\n                    if (d1[nx][ny] > limitT) break;\n                    if (d2[nx][ny] >= 0) continue;\n                    q1.push({nx, ny});\n                    if (b[nx][ny] != '0') {\n                        addEdge(id[sx][sy], id[nx][ny] + cnt, 10);\n                    }\n                }\n            }\n        }\n\n        layer = (int)q2.size();\n        while (layer--) {\n            int x = q2.front().first;\n            int y = q2.front().second;\n            q2.pop();\n\n            for (int i = 0; i < 4; ++i) {\n                int nx = x + dx[i];\n                int ny = y + dy[i];\n                if (inside(nx, ny) && d2[nx][ny] < 0) {\n                    d2[nx][ny] = d2[x][y] + 1;\n                    q2.push({nx, ny});\n                }\n            }\n        }\n    }\n}\n\nint maxFlow() {\n    int ans = 0;\n    while (true) {\n        vector<int> pv(T + 1, -1), pe(T + 1, -1);\n        queue<int> q;\n        q.push(S);\n        pv[S] = S;\n\n        while (!q.empty() && pv[T] == -1) {\n            int u = q.front();\n            q.pop();\n            for (int i = 0; i < (int)g[u].size(); ++i) {\n                Edge &e = g[u][i];\n                if (e.cap > 0 && pv[e.to] == -1) {\n                    pv[e.to] = u;\n                    pe[e.to] = i;\n                    if (e.to == T) break;\n                    q.push(e.to);\n                }\n            }\n        }\n\n        if (pv[T] == -1) break;\n\n        int add = 10000000;\n        for (int v = T; v != S; v = pv[v]) {\n            add = min(add, g[pv[v]][pe[v