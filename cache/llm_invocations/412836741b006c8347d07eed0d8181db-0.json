{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nlong long comb[777][777];\nint rows, cols;\nlong long total;\nlong long best_val = (long long) 1e18, best_z = -1;\nvoid dfs(long long x, long long y, int v1, int v2) {\n    long long diff = abs(x - y);\n    if (best_val <= 1 || diff - comb[v1][rows] * comb[v2][rows] >= best_val) return;\n    if (v1 == rows - 1 && v2 == rows - 1) {\n        long long diff = abs(x - y);\n        if (diff < best_val) { best_val = diff; best_z = x; }\n        return;\n    }\n    if (v1 >= rows) {\n        long long cur1 = comb[v1][rows] - comb[v1 - 1][rows];\n        long long sum2 = comb[v2][rows];\n        dfs(x, y + cur1 * sum2, v1 - 1, v2);\n    }\n    if (v2 >= rows) {\n        long long sum1 = comb[v1][rows];\n        long long cur2 = comb[v2][rows] - comb[v2 - 1][rows];\n        dfs(x + sum1 * cur2, y, v1, v2 - 1);\n    }\n}\nchar str[12345];\nint cntA[12345], cntB[12345];\nunordered_map<long long, long long> memo;\nlong long solve(long long x, long long y, int v1, int v2) {\n    long long state = x * 10000 + v1 * 100 + v2;\n    auto it = memo.find(state);\n    if (it != memo.end()) return it->second;\n    long long &res = memo[state];\n    long long diff = abs(x - y);\n    if (diff - comb[v1][rows] * comb[v2][rows] > best_val) return res = 0;\n    if (v1 < rows || v2 < rows) {\n        if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n            int sum = v1 + v2;\n            v1 -= cntA[sum];\n            v2 -= cntB[sum];\n            return res = comb[v1 + v2][v1];\n        }\n        return res = 0;\n    }\n    res = 0;\n    char c = str[v1 + v2 - 1];\n    if (c != 'B') {\n        long long cur1 = comb[v1][rows] - comb[v1 - 1][rows];\n        long long sum2 = comb[v2][rows];\n        res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n    }\n    if (c != 'A') {\n        long long sum1 = comb[v1][rows];\n        long long cur2 = comb[v2][rows] - comb[v2 - 1][rows];\n        res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n    }\n    return res;\n}\nint main() {\n    scanf(\"%d %d\", &rows, &cols);\n    for (int i = 0; i <= 2 * (rows + cols); i++) {\n        for (int j = 0; j <= 2 * (rows + cols); j++) {\n            if (j == 0) comb[i][j] = 1;\n            else if (i == 0) comb[i][j] = 0;\n            else comb[i][j] = comb[i - 1][j] + comb[i - 1][j - 1];\n        }\n    }\n    total = comb[rows + cols][rows] * comb[rows + cols][rows];\n    {\n        long long x = 0, y = 0;\n        int v1 = rows + cols, v2 = rows + cols;\n        while (v1 >= rows && v2 >= rows) {\n            if (x > y) {\n                long long cur1 = comb[v1][rows] - comb[v1 - 1][rows];\n                long long sum2 = comb[v2][rows];\n                y += cur1 * sum2;\n                v1--;\n            } else {\n                long long sum1 = comb[v1][rows];\n                long long cur2 = comb[v2][rows] - comb[v2 - 1][rows];\n                x += sum1 * cur2;\n                v2--;\n            }\n        }\n        best_val = abs(x - y);\n    }\n    dfs(0, 0, rows + cols, rows + cols);\n    scanf(\"%s\", str);\n    cntA[0] = cntB[0] = 0;\n    for (int i = 0; i < 2 * (rows + cols); i++) {\n        cntA[i + 1] = cntA[i] + (str[i] == 'A');\n        cntB[i + 1] = cntB[i] + (str[i] == 'B');\n    }\n    long long ans = solve(0, 0, rows + cols, rows + cols);\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(1000000)\n\n# Global variables\ncomb = []\nrows = 0\ncols = 0\ntotal = 0\nbest_val = 10**18\nbest_z = -1\nstr_input = \"\"\ncntA = []\ncntB = []\nmemo = {}\n\ndef dfs(x, y, v1, v2):\n    global best_val, best_z\n    diff = abs(x - y)\n    if best_val <= 1 or diff - comb[v1][rows] * comb[v2][rows] >= best_val:\n        return\n    if v1 == rows - 1 and v2 == rows - 1:\n        diff = abs(x - y)\n        if diff < best_val:\n            best_val = diff\n            best_z = x\n        return\n    if v1 >= rows:\n        cur1 = comb[v1][rows] - comb[v1 - 1][rows]\n        sum2 = comb[v2][rows]\n        dfs(x, y + cur1 * sum2, v1 - 1, v2)\n    if v2 >= rows:\n        sum1 = comb[v1][rows]\n        cur2 = comb[v2][rows] - comb[v2 - 1][rows]\n        dfs(x + sum1 * cur2, y, v1, v2 - 1)\n\ndef solve(x, y, v1, v2):\n    global best_val, memo, str_input, cntA, cntB, comb, rows\n    state = x * 10000 + v1 * 100 + v2\n    if state in memo:\n        return memo[state]\n    res = 0\n    diff = abs(x - y)\n    if diff - comb[v1][rows] * comb[v2][rows] > best_val:\n        memo[state] = 0\n        return 0\n    if v1 < rows or v2 < rows:\n        if v1 >= cntA[v1 + v2] and v2 >= cntB[v1 + v2]:\n            s = v1 + v2\n            v1 -= cntA[s]\n            v2 -= cntB[s]\n            res = comb[v1 + v2][v1]\n            memo[state] = res\n            return res\n        memo[state] = 0\n        return 0\n    c = str_input[v1 + v2 - 1]\n    if c != 'B':\n        cur1 = comb[v1][rows] - comb[v1 - 1][rows]\n        sum2 = comb[v2][rows]\n        res += solve(x, y + cur1 * sum2, v1 - 1, v2)\n    if c != 'A':\n        sum1 = comb[v1][rows]\n        cur2 = comb[v2][rows] - comb[v2 - 1][rows]\n        res += solve(x + sum1 * cur2, y, v1, v2 - 1)\n    memo[state] = res\n    return res\n\ndef main():\n    global rows, cols, total, best_val, best_z, comb, str_input, cntA, cntB, memo\n    rows, cols = map(int, sys.stdin.readline().split())\n    max_n = 2 * (rows + cols)\n    # Initialize comb table up to max_n\n    comb = [[0] * (max_n + 1) for _ in range(max_n + 1)]\n    for i in range(max_n + 1):\n        for j in range(max_n + 1):\n            if j == 0:\n                comb[i][j] = 1\n            elif i == 0:\n                comb[i][j] = 0\n            else:\n                comb[i][j] = comb[i - 1][j] + comb[i - 1][j - 1]\n    total = comb[rows + cols][rows] * comb[rows + cols][rows]\n    # Initial greedy best_val\n    x = 0\n    y = 0\n    v1 = rows + cols\n    v2 = rows + cols\n    while v1 >= rows and v2 >= rows:\n        if x > y:\n            cur1 = comb[v1][rows] - comb[v1 - 1][rows]\n            sum2 = comb[v2][rows]\n            y += cur1 * sum2\n            v1 -= 1\n        else:\n            sum1 = comb[v1][rows]\n            cur2 = comb[v2][rows] - comb[v2 - 1][rows]\n            x += sum1 * cur2\n            v2 -= 1\n    best_val = abs(x - y)\n    # DFS to improve best_val\n    dfs(0, 0, rows + cols, rows + cols)\n    # Read string\n    str_input = sys.stdin.readline().strip()\n    # Compute prefix counts\n    cntA = [0] * (2 * (rows + cols) + 1)\n    cntB = [0] * (2 * (rows + cols) + 1)\n    for i in range(2 * (rows + cols)):\n        cntA[i + 1] = cntA[i] + (1 if str_input[i] == 'A' else 0)\n        cntB[i + 1] = cntB[i] + (1 if str_input[i] == 'B' else 0)\n    # Solve\n    memo.clear()\n    ans = solve(0, 0, rows + cols, rows + cols)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000174