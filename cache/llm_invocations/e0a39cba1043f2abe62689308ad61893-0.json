 class Main {\n    static final int N = 1000007;\n    static final int SOURCE = N - 2;\n    static final int TARGET = N - 1;\n    static final long INF = (long)1e18;\n\n    static class Edge {\n        int to, cap, flow, cost;\n        Edge(int to, int cap, int flow, int cost) {\n            this.to = to;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[N];\n    static long[] dist = new long[N];\n    static int[] pred = new int[N];\n    static int[] pe = new int[N];\n    static boolean[] inq = new boolean[N];\n    static long answer = 0;\n\n    static int residual(int id) {\n        return edges.get(id).cap - edges.get(id).flow;\n    }\n\n    static void addEdge(int u, int v, int capacity, int costValue) {\n        adj[u].add(edges.size());\n        edges.add(new Edge(v, capacity, 0, costValue));\n        adj[v].add(edges.size());\n        edges.add(new Edge(u, 0, 0, -costValue));\n    }\n\n    static void pushFlowSLF() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(pred, -1);\n        Arrays.fill(pe, -1);\n        Arrays.fill(inq, false);\n\n        Deque<Integer> dq = new ArrayDeque<>();\n        dist[SOURCE] = 0;\n        dq.addLast(SOURCE);\n        inq[SOURCE] = true;\n\n        while (!dq.isEmpty()) {\n            int u = dq.removeFirst();\n            inq[u] = false;\n\n            for (int id : adj[u]) {\n                if (residual(id) == 0) continue;\n                int v = edges.get(id).to;\n                long nd = dist[u] + edges.get(id).cost;\n                if (dist[v] > nd) {\n                    dist[v] = nd;\n                    pred[v] = u;\n                    pe[v] = id;\n                    if (!inq[v]) {\n                        inq[v] = true;\n                        if (!dq.isEmpty() && dist[v] < dist[dq.getFirst()]) {\n                            dq.addFirst(v)