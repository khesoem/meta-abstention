tations with fixed inversion counts,\n                // exactly half will have p lex smaller than q (by symmetry)\n                // But this is only true if we consider all permutations, which we are\n                total = (total + pairs) % mod;\n            }\n        }\n        \n        // Since for any two distinct permutations, either p < q or q < p lexicographically,\n        // and we want p < q with inv(p) > inv(q), this is exactly half of all pairs where inv(p) != inv(q)\n        // But wait, that's not quite right - we need to be more careful\n        \n        // Actually, let's reconsider: we want pairs (p, q) where p is lex smaller than q AND inv(p) > inv(q)\n        // Total pairs where p != q: n! * (n! - 1) / 2\n        // But we need to count only those with inv(p) > inv(q) when p < q lex\n        \n        // Alternative approach: iterate over all permutation pairs\n        // But n can be up to 8 in easy version, so we can do O((n!)^2) for small n\n        \n        // Let's use brute force for small n (easy version constraints are small)\n        if (n <= 8) {\n            List<int[]> perms = generatePermutations(n);\n            long count = 0;\n            for (int i = 0; i < perms.size(); i++) {\n                for (int j = 0; j < perms.size(); j++) {\n                    if (i == j) continue;\n                    int[] p = perms.get(i);\n                    int[] q = perms.get(j);\n                    if (isLexSmaller(p, q) && countInversions(p) > countInversions(q)) {\n                        count++;\n                    }\n                }\n            }\n            System.out.println(count % mod);\n            return;\n        }\n        \n        System.out.println(total % mod);\n    }\n    \n    static List<int[]> generatePermutations(int n) {\n        List<int[]> result = new ArrayList<>();\n        int[] perm = new int[n];\n        for (int i = 0; i < n; i++) perm[i] = i + 1;\n        permute(perm, 0, result);\n        return result;\n    }\n    \n    static void permute(int[] arr, int k, List<int[]> result) {\n        for (int i = k; i < arr.length; i++) {\n            swap(arr, i, k);\n            permute(arr, k + 1, result);\n            swap(arr, i, k);\n        }\n        if (k == arr.length - 1) {\n            result.add(arr.clone());\n        }\n    }\n    \n    static void swap(int[] arr, int i, int j) {\n        int temp = arr[i];\n        arr[i] = arr[j];\n        arr[j] = temp;\n    }\n    \n    static boolean isLexSmaller(int[] p, int[] q) {\n        for (int i = 0; i < p.length; i++) {\n            if (p[i] < q[i]) return true;\n            if (p[i] > q[i]) return false;\n        }\n        return false;\n    }\n    \n    static int countInversions(int[] arr) {\n        int count = 0;\n        for (int i = 0; i < arr.length; i++) {\n            for (int j = i + 1; j < arr.length; j++) {\n                if (arr[i] > arr[j]) count++;\n            }\n        }\n        return count;\n    }\n\n    static class FastScanner {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(\"\");\n\n        String next() {\n            while (!st.hasMoreTokens()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n}\n</repaired_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -4.5298504119273275e-05, -1.7881377516459906e-06, 0.0, -0.00021920185827184469, -7.271740287251305e-06, -2.1576648578047752e-05, -8.821448318485636e-06, -2.0265558760002023e-06, -9.775113539944869e-06, -2.264974000354414e-06, -0.002217455068603158, -2.264974000354414e-06, -2.1815061700181104e-05, -0.014595523476600647,