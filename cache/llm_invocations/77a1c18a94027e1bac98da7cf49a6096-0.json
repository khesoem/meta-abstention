 repair:\n<original_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class e1542easy {\n    public static void main(String[] args) {\n        FastScanner fs = new FastScanner();\n        int n = fs.nextInt();\n        int mod = fs.nextInt();\n        solve(n, mod);\n    }\n\n    static void solve(int n, int mod) {\n        List<int[]> inv = new ArrayList<>();\n        inv.add(new int[]{1});\n\n        for (int i = 1; i < n; i++) {\n            int[] prev = inv.get(i - 1);\n            int len = i * (i + 1) / 2 + 1;\n            int[] curr = new int[len];\n\n            for (int j = 0; j < len; j++) {\n                int val = 0;\n                for (int x = 0; x <= Math.min(j, i); x++) {\n                    if (j - x < prev.length) {\n                        val = (val + prev[j - x]) % mod;\n                    }\n                }\n                curr[j] = val;\n            }\n            inv.add(curr);\n        }\n\n        int[] ans = new int[n];\n        ans[0] = 0;\n\n        for (int i = 1; i < n; i++) {\n            long cur = (long) ans[i - 1] * i % mod;\n            int[] invs = inv.get(i - 1);\n\n            for (int a = 0; a < invs.length; a++) {\n                for (int b = a + 2; b < invs.length; b++) {\n                    int diff = b - a - 1;\n                    long term = (long) invs[a] * invs[b] * diff * (2L * i - diff + 1) / 2;\n                    cur = (cur + term) % mod;\n                }\n            }\n            ans[i] = (int) ((cur % mod + mod) % mod);\n        }\n\n        System.out.println(ans[n - 1]);\n    }\n\n    static class FastScanner {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(\"\");\n\n        String next() {\n            while (!st.hasMoreTokens()) {\n                try {\n                    st = new StringTokenizer(br.readLine());\n                } catch (IOException e) {\n                    e.printStackTrace();\n     