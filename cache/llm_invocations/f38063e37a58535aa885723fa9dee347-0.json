_update() {\n\tint f = aug[t];\n\tint cur = t;\n\twhile (cur != s) {\n\t\tint e = prevv[cur];\n\t\tcap[e] -= f;\n\t\tcap[e ^ 1] += f;\n\t\tcur = to[e ^ 1];\n\t}\n\ttotal += f * ddist[t];\n}\nint main() {\n\tscanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n\tt = (n + k - 1) * n + 1;\n\tfor (int i = 1, x; i <= k; i++) {\n\t\tscanf(\"%d\", &x);\n\t\tlink(s, x, 1, 0);\n\t}\n\tfor (int i = 1, u, v; i <= m; i++) {\n\t\tscanf(\"%d%d\", &u, &v);\n\t\tfor (int lvl = 1; lvl <= n + k; lvl++) {\n\t\t\tfor (int hop = 1; hop <= k; hop++) {\n\t\t\t\tint w = d * hop * 2 - d + c;\n\t\t\t\tlink(u + (lvl - 1) * n, v + lvl * n, 1, w);\n\t\t\t\tlink(v + (lvl - 1) * n, u + lvl * n, 1, w);\n\t\t\t}\n\t\t}\n\t}\n\tfor (int lvl = 1; lvl < n + k; lvl++) {\n\t\tfor (int node = 2; node <= n; node++) {\n\t\t\tlink(node + (lvl - 1) * n, node + lvl * n, 1000000000, c);\n\t\t}\n\t\tlink(1 + (lvl - 1) * n, 1 + lvl * n, 1000000000, 0);\n\t}\n\twhile (dijkstra_like()) flow_update();\n\tprintf(\"%d\\n\", total);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    \n    idx = 1\n    MAXN = 10000010\n    INF = 0x3f3f3f3f\n    \n    n = data[0]\n    m = data[1]\n    k = data[2]\n    c = data[3]\n    d = data[4]\n    \n    s = 0\n    t = (n + k - 1) * n + 1\n    total = 0\n    \n    adj = [0] * MAXN\n    to = [0] * MAXN\n    nxt = [0] * MAXN\n    cap = [0] * MAXN\n    cost = [0] * MAXN\n    \n    def link(u, v, c_val, w):\n        nonlocal idx\n        idx += 1\n        to[idx] = v\n        nxt[idx] = adj[u]\n        adj[u] = idx\n        cap[idx] = c_val\n        cost[idx] = w\n        \n        idx += 1\n        to[idx] = u\n        nxt[idx] = adj[v]\n        adj[v] = idx\n        cap[idx] = 0\n        cost[idx] = -w\n    \n    # Read k sources\n    po