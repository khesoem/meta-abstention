ntB, mp\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    r = int(data[0])\n    c = int(data[1])\n    maxN = 2 * (r + c)\n    # Initialize C as list of lists of zeros\n    C = [[0] * (maxN + 1) for _ in range(maxN + 1)]\n    for i in range(maxN + 1):\n        C[i][0] = 1\n        for j in range(1, i + 1):\n            C[i][j] = C[i-1][j] + C[i-1][j-1]\n        # j from i+1 to maxN are already 0\n    total = C[r + c][r] * C[r + c][r]  # not used later but kept for completeness\n    best = 10**18\n    best_z = -1\n    # Initial greedy to set best\n    x = 0\n    y = 0\n    v1 = r + c\n    v2 = r + c\n    while v1 >= r and v2 >= r:\n        if x > y:\n            cur1 = C[v1][r] - C[v1-1][r]\n            sum2 = C[v2][r]\n            y += cur1 * sum2\n            v1 -= 1\n        else:\n            sum1 = C[v1][r]\n            cur2 = C[v2][r] - C[v2-1][r]\n            x += sum1 * cur2\n            v2 -= 1\n    best = abs(x - y)\n    # DFS to refine best\n    dfs(0, 0, r + c, r + c)\n    # Read the string s (third input)\n    s = data[2] if len(data) > 2 else ''\n    len_s = 2 * (r + c)\n    cntA = [0] * (len_s + 1)\n    cntB = [0] * (len_s + 1)\n    for i in range(len_s):\n        cntA[i+1] = cntA[i] + (1 if s[i] == 'A' else 0)\n        cntB[i+1] = cntB[i] + (1 if s[i] == 'B' else 0)\n    mp = {}\n    ans = solve(0, 0, r + c, r + c)\n    print(ans)\n\ndef dfs(x, y, v1, v2):\n    global best, best_z, C, r\n    diff = abs(x - y)\n    if best <= 1 or diff - C[v1][r] * C[v2][r] >= best:\n        return\n    if v1 == r - 1 and v2 == r - 1:\n        diff = abs(x - y)\n        if diff < best:\n            best = diff\n            best_z = x\n        return\n    if v1 >= r:\n        cur1 = C[v1][r] - C[v1-1][r]\n        sum2 = C[v2][r]\n        dfs(x, y + cur1 * sum2, v1 - 1, v2)\n    if v2 >= r:\n        sum1 = C[v1][r]\n        cur2 = C[v2][r] - C[v2-1][r]\n        dfs(x + sum1 * cur2, y, v1, v2 - 1)\n\ndef solve(x, y, v1, v2):\n    global best, C, r