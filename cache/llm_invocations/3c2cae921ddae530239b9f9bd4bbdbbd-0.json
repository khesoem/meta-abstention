353;\n\nint add(int a, int b) {\n    int sum = a + b;\n    if (sum >= MOD) sum -= MOD;\n    if (sum < 0) sum += MOD;\n    return sum;\n}\n\nlong long multiply(long long x, long long y) {\n    return (x * y) % MOD;\n}\n\nint multiply(int x, int y) {\n    return (int)((long long)x * y % MOD);\n}\n\nint multiply(int x, int y, int z) {\n    return (int)((long long)x * y % MOD * z % MOD);\n}\n\nint stirling[5001][5001];\n\nvoid precomputeStirling() {\n    for (int i = 0; i < 5001; i++) {\n        stirling[i][0] = 0;\n        stirling[0][i] = (i == 1) ? 1 : 0;\n    }\n    for (int i = 1; i < 5001; i++) {\n        stirling[i][i] = 1;\n    }\n    for (int i = 2; i < 5001; i++) {\n        for (int j = 1; j < i; j++) {\n            stirling[i][j] = add(multiply(stirling[i-1][j], i-1), stirling[i-1][j-1]);\n        }\n    }\n}\n\nlong long modPow(long long base, long long exp, long long mod) {\n    long long result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) {\n            result = (result * base) % mod;\n        }\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nlong long modInverse(long long a, long long mod) {\n    return modPow(a, mod - 2, mod);\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    precomputeStirling();\n    \n    int n, m, k;\n    cin >> n >> m >> k;\n    \n    long long invM = modInverse(m, MOD);\n    \n    vector<int> p(5001, 0);\n    p[0] = 1;\n    int current = n;\n    int power = 1;\n    \n    for (int i = 1; i <= k; i++) {\n        power = multiply(power, current, (int)invM);\n        current = add(current, MOD - 1);\n        \n        int temp = power;\n        for (int j = i-1; j >= 1; j--) {\n            int term = multiply(stirling[i][j], p[j]);\n            if ((i - j) % 2 == 1) {\n                temp = add(temp, term);\n            } else {\n                temp = add(temp, MOD - term);\n            }\n        }\n        p[i] = temp;\n    }\