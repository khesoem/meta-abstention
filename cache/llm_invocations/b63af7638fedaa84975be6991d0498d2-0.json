   if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    a = [0] + [int(next(it)) for _ in range(k)]\n    \n    mx = 100\n    cnt = 0\n    id = [[0] * (mx + 1) for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        for j in range(mx + 1):\n            cnt += 1\n            id[i][j] = cnt\n    \n    mcmf = MCMF(cnt + 5)\n    s = mcmf.n - 2\n    t = mcmf.n - 3\n    \n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(mx):\n            for h in range(1, k + 1):\n                tmp = h * h * d - (h - 1) * (h - 1) * d\n                mcmf.link(id[u][j], id[v][j + 1], 1, c + tmp)\n                mcmf.link(id[v][j], id[u][j + 1], 1, c + tmp)\n    \n    for i in range(1, n + 1):\n        for j in range(mx):\n            mcmf.link(id[i][j], id[i][j + 1], INF, c)\n    \n    for i in range(1, k + 1):\n        mcmf.link(s, id[a[i]][0], 1, 0)\n    \n    for j in range(1, mx + 1):\n        mcmf.link(id[1][j], t, INF, 0)\n    \n    ans = mcmf.run(s, t)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.2411095415009186e-05, 0.0, 0.0, -0.0004558716027531773, -0.0009534580749459565, -2.3841855067985307e-07, -3.3378044463461265e-05, -0.00033790123416110873, 0.0, 0.0, -1.1920928244535389e-07, -0.0015070997178554535, -0.1622866988182068, -3.4570634852570947e-06, -2.622600959512056e-06, -0.00012444675667211413, -0.029750533401966095, -0.0012374608777463436, -0.003177239093929529, -1.5616295058862306e-05, -3.8265450712060556e-05, -3.933898824470816e-06, 0.0, -1.4305104514278355e-06, -3.576278118089249e-07, -3.1709168979432434e-05, -5.8530047681415454e-05, 0.0, -1.1920928244535389e-07, 0.0, -0.20141839981079102, -0.0016859853640198708, -0.00011646069469861686, 0.0, -5.8412379075889476e-06, -3.659658250398934e-05, -4.768370445162