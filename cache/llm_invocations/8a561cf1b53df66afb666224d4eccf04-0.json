 memset(rev,255,sizeof(rev));\n        for(int i=0;i<n;i++){\n            memset(v,0,sizeof(v));\n            if(match(i,e)) cnt++;\n        }\n        return cnt;\n    }\nprivate:\n    int v[SIZE];\n    bool match(int x, vector<int> e[]){\n        for(int i=0;i<int(e[x].size());i++){\n            int y=e[x][i];\n            if(!v[y]) v[y]=1; else continue;\n            if(rev[y]<0 || match(rev[y],e)){\n                pos[x]=y;\n                rev[y]=x;\n                return true;\n            }\n        }\n        return false;\n    }\n};\n\n#include <cstdio>\n#include <cmath>\n#include <cstring>\n#include <utility>\n#include <vector>\n#include <queue>\n#include <algorithm>\nusing namespace std;\n\nconst int INF=1000000000;\nconst int mr[]={0,-1,0,1};\nconst int mc[]={1,0,-1,0};\n\nint a[12][12],b[12][12],f[12][12],m,t;\nvector<int> e[2000];\nvector<int> c[12][12];\n\nvoid floodfill(int sr, int sc){\n    queue<int> qr;\n    queue<int> qc;\n    memset(f,255,sizeof(f));\n    qr.push(sr);\n    qc.push(sc);\n    f[sr][sc]=0;\n    while(!qr.empty()){\n        sr=qr.front(); qr.pop();\n        sc=qc.front(); qc.pop();\n        for(int i=0;i<4;i++){\n            int tr=sr+mr[i];\n            int tc=sc+mc[i];\n            if(a[tr][tc]>=0 && f[tr][tc]<0){\n                f[tr][tc]=f[sr][sc]+1;\n                qr.push(tr);\n                qc.push(tc);\n            }\n        }\n    }\n}\n\nvoid setmark(int sr, int sc, int cnt){\n    int v[12][12];\n    queue<int> qr;\n    queue<int> qc;\n    memset(v,255,sizeof(v));\n    qr.push(sr);\n    qc.push(sc);\n    v[sr][sc]=0;\n    //printf(\"escape from (%d,%d) ->\",sr,sc);\n    while(!qr.empty()){\n        sr=qr.front(); qr.pop();\n        sc=qc.front(); qc.pop();\n        if(v[sr][sc]> min(t,f[sr][sc])) continue;\n        for(int j=0;j<int(c[sr][sc].size());j++)\n            for(int i=0;i<cnt;i++) e[m+i].push_back(c[sr][sc][j]);\n        if(v[sr][sc]==min(t,f[sr][sc])) continue;\n        for(int i=0;i<4;i++){\n            int tr=sr+mr[i];\n            int tc=sc+mc[i];\n            if(a[tr][tc]>=0 && v[tr][tc]<0){\n                v[tr][tc]=v[sr][sc]+1;\n                qr.push(tr);\n                qc.push(tc);\n            }\n        }\n    }\n    //printf(\" %d\\n\",e[m].size());\n    m+=cnt;\n}\n\nHungary match;\n\nint main(){\n    int n,sr,sc,o=m=0;\n    scanf(\"%d%d\",&n,&t);\n    memset(a,255,sizeof(a));\n    memset(b,255,sizeof(b));\n    for(int i=1;i<=n;i++){\n        while(getchar()!='\\n');\n        for(int j=1;j<=n;j++){\n            char ch=getchar();\n            if(ch>='0' && ch<='9') a[i][j]=ch-'0';\n            if(ch=='Z'){\n                sr=i;\n                sc=j;\n            }\n        }\n    }\n    floodfill(sr,sc);\n    while(getchar()!='\\n');\n    for(int i=1;i<=n;i++){\n        while(getchar()!='\\n');\n        for(int j=1;j<=n;j++){\n            char ch=getchar();\n            if(ch>='0' && ch<='9') b[i][j]=ch-'0';\n            for(int k=0;k<b[i][j];k++) c[i][j].push_back(o++);\n        }\n    }\n    for(int i=1;i<=n;i++) for(int j=1;j<=n;j++) if(f[i][j]<0) f[i][j]=INF;\n    for(int i=1;i<=n;i++) for(int j=1;j<=n;j++) if(a[i][j]>0) setmark(i,j,a[i][j]);\n    /*\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",a[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",b[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n        for(int i=1;i<=n;i++){\n        for(int j=1;j<=n;j++) printf(\"%d \",f[i][j]);\n        puts(\"\");\n    }\n    puts(\"\");\n    printf(\"%d %d -> \",m,o);\n    //*/\n    printf(\"%d\\n\",match.gao(m,e));\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nclass Hungary:\n    SIZE = 2000  # Maximum size\n\n    def __init__(self):\n        self.cnt = 0\n        self.pos = [-1] * self.SIZE\n        self.rev = [-1] * self.SIZE\n        self.v = [0] * self.SIZE\n\n    def gao(self, n, e):\n        self.cnt = 0\n        self.pos = [-1] * self.SIZE\n        self.rev = [-1] * self.SIZE\n        for i in range(n):\n            self.v = [0] * self.SIZE\n            if self.match(i, e):\n                self.cnt += 1\n        return self.cnt\n\n    def match(self, x, e):\n        for y in e[x]:\n            if self.v[y] == 0:\n                self.v[y] = 1\n                if self.rev[y] < 0 or self.match(self.rev[y], e):\n                    self.pos[x] = y\n                    self.rev[y] = x\n                    return True\n        return False\n\nimport sys\nfrom collections import deque\n\nINF = 1000000000\nmr = [0, -1, 0, 1]\nmc = [1, 0, -1, 0]\n\na = [[-1 for _ in range(12)] for _ in range(12)]\nb = [[-1 for _ in range(12)] for _ in range(12)]\nf = [[-1 for _ in range(12)] for _ in range(12)]\nc = [[[] for _ in range(12)] for _ in range(12)]\ne = [[] for _ in range(2000)]  # adjacency list\nm = 0\nt = 0\n\ndef floodfill(sr, sc):\n    queue_sr = deque()\n    queue_sc = deque()\n    for i in range(12):\n        for j in range(12):\n            f[i][j] = -1\n    queue_sr.append(sr)\n    queue_sc.append(sc)\n    f[sr][sc] = 0\n    while queue_sr:\n        r = queue_sr.popleft()\n        c_ = queue_sc.popleft()\n        for i in range(4):\n            tr = r + mr[i]\n            tc = c_ + mc[i]\n            if 0 <= tr < 12 and 0 <= tc < 12 and a[tr][tc] >= 0 and f[tr][tc] < 0:\n                f[tr][tc] = f[r][c_] + 1\n                queue_sr.append(tr)\n                queue_sc.append(tc)\n\ndef setmark(sr, sc, cnt):\n    v = [[-1 for _ in range(12)] for _ in range(12)]\n    queue_sr = deque()\n    queue_sc = deque()\n    queue_sr.append(sr)\n    queue_sc.append(sc)\n    v[sr][sc] = 0\n    while queue_sr:\n        r = queue_sr.popleft()\n        c_ = queue_sc.popleft()\n        if v[r][c_] > min(t, f[r][c_]):\n            continue\n        for j in c[r][c_]:\n            for i in range(cnt):\n                e[m + i].append(j)\n        if v[r][c_] == min(t, f[r][c_]):\n            continue\n        for i in range(4):\n            tr = r + mr[i]\n            tc = c_ + mc[i]\n            if 0 <= tr < 12 and 0 <= tc < 12 and a[tr][tc] >= 0 and v[tr][tc] < 0:\n                v[tr][tc] = v[r][c_] + 1\n                queue_sr.append(tr)\n                queue_sc.append(tc)\n    global m\n    m += cnt\n\ndef main():\n    global m, t\n    input_lines = sys.stdin.read().splitlines()\n    # Read n and t\n    n = int(input_lines[0])\n    t = int(input_lines[1])\n    line_idx = 2\n\n    # Read grid for 'a'\n    for i in range(1, n + 1):\n        row_str = input_lines[line_idx]\n        line_idx += 1\n        for j in range(1, n + 1):\n            ch = row_str[j - 1]\n            if ch >= '0' and ch <= '9':\n                a[i][j] = ord(ch) - ord('0')\n            elif ch == 'Z':\n                sr, sc = i, j\n\n    floodfill(sr, sc)\n\n    # Read grid for 'b'\n    for i in range(1, n + 1):\n        row_str = input_lines[line_idx]\n        line_idx += 1\n        for j in range(1, n + 1):\n            ch = row_str[j - 1]\n            if ch >= '0' and ch <= '9':\n                b[i][j] = ord(ch) - ord('0')\n                for _ in range(b[i][j]):\n                    c[i][j].append(len(e))\n                    e.append([])\n                    # No need to update global 'o' in Python explicitly as e's length manages indices\n\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if f[i][j] < 0:\n                f[i][j] = INF\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if a[i][j] > 0:\n                setmark(i, j, a[i][j])\n\n    matcher = Hungary()\n    max_match = matcher.gao(m, e)\n    print(max_match)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00028088156250305474, -0.0002502535644453019, -4.320199877838604e-07, -7.3