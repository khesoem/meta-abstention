        if (s <= 0 || t <= 0 || s > n || t > m) {\n                return;\n            }\n            graph[id[i][j]].add(id[s][t]);\n        }\n    }\n\n    static class HopcroftKarp {\n        static final int INF = 10000000;\n        static final int NIL = 0;\n\n        int m;\n        int n;\n        List<Integer>[] graph;\n        int[] pairU;\n        int[] pairV;\n        int[] dist;\n\n        HopcroftKarp(int m, int n, List<Integer>[] graph) {\n            this.m = m;\n            this.n = n;\n            this.graph = graph;\n            pairU = new int[m + 1];\n            pairV = new int[n + 1];\n            dist = new int[m + 1];\n        }\n\n        int maxMatching() {\n            Arrays.fill(pairU, NIL);\n            Arrays.fill(pairV, NIL);\n\n            int result = 0;\n            while (bfs()) {\n                for (int i = 1; i <= m; i++) {\n                    if (pairU[i] == NIL && dfs(i)) {\n                        result++;\n                    }\n                }\n            }\n            return result;\n        }\n\n        boolean bfs() {\n            ArrayDeque<Integer> queue = new ArrayDeque<>();\n\n            for (int i = 1; i <= m; i++) {\n                if (pairU[i] == NIL) {\n                    queue.add(i);\n                    dist[i] = 0;\n                } else {\n                    dist[i] = INF;\n                }\n            }\n\n            dist[NIL] = INF;\n\n            while (!queue.isEmpty()) {\n                int u = queue.poll();\n                if (dist[u] < dist[NIL]) {\n                    for (int v : graph[u]) {\n                        if (dist[pairV[v]] == INF) {\n                            queue.add(pairV[v]);\n                            dist[pairV[v]] = dist[u] + 2;\n                        }\n                    }\n                }\n            }\n\n            return dist[NIL] < INF;\n        }\n\n        boolean dfs(int u) {\n            if (u == NIL) {\n                return true;\n       