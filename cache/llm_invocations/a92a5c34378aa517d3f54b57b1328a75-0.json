Num = 1;\n        bestDen = 1;\n    }\n    int g = gcd(bestNum, bestDen);\n    printf(\"%d/%d\\n\", bestNum / g, bestDen / g);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef gcd(a, b):\n    return math.gcd(a, b)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, limit = map(int, data[:3])\n    target = x / y\n    best_dist = 1e9\n    best_num = 0\n    best_den = 0\n    for i in range(1, limit + 1):\n        b = (x * i) // y\n        n1 = b\n        n2 = abs(b - 1)\n        n3 = b + 1\n        a1 = n1 / i\n        a2 = n2 / i\n        a3 = n3 / i\n        d1 = abs(target - a1)\n        d2 = abs(target - a2)\n        d3 = abs(target - a3)\n        if d1 < best_dist:\n            best_dist = d1\n            best_num = n1\n            best_den = i\n        if d2 < best_dist:\n            best_dist = d2\n            best_num = n2\n            best_den = i\n        if d3 < best_dist:\n            best_dist = d3\n            best_num = n3\n            best_den = i\n    dist_one = abs(1.0 - target)\n    dist_best = abs(best_num / best_den - target)\n    if dist_one <= dist_best + 1e-9:\n        best_num = 1\n        best_den = 1\n    g = gcd(best_num, best_den)\n    print(f\"{best_num // g}/{best_den // g}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.1324817933200393e-05, 0.0, 0.0, -1.4066597032069694e-05, -0.00016640232934150845, -0.03804141283035278, -0.011210784316062927, -0.0019334923708811402, 0.0, -2.8729025871143676e-05, -8.654219709569588e-05, -0.09060642868280411, -2.288792165927589e-05, -0.004153673071414232, 0.0, -1.0847986231965479e-05, -4.768370445162873e-07, -0.029914256185293198, -0.0009925207123160362, 0.0, 0.0, -0.0002053765201708302, -2.3841855067985307e-07,