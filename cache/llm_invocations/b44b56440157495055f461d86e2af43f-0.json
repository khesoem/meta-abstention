)) {\n                min_diff = diff;\n                best = {num, den};\n            }\n        };\n        \n        try_candidate(floor_val, i);\n        try_candidate(ceil_val, i);\n    }\n    \n    pii reduced = reduce_fraction(best.first, best.second);\n    cout << reduced.first << \"/\" << reduced.second << \"\\n\";\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nfrom math import gcd\n\ndef reduce_fraction(a, b):\n    g = gcd(a, b)\n    return (a // g, b // g)\n\ndef main():\n    x, y, n_double = map(float, input().split())\n    n = int(n_double)\n    \n    ratio = x / y\n    best = (0, 1)\n    min_diff = float('inf')\n    EPS = 1e-15\n    \n    for i in range(1, n + 1):\n        scaled = ratio * i\n        floor_val = int(math.floor(scaled + EPS))\n        ceil_val = int(math.ceil(scaled - EPS))\n        \n        def try_candidate(num, den):\n            nonlocal min_diff, best\n            approx = num / den\n            diff = abs(ratio - approx)\n            if diff < min_diff - EPS or (abs(diff - min_diff) < EPS and den < best[1]):\n                min_diff = diff\n                best = (num, den)\n        \n        try_candidate(floor_val, i)\n        try_candidate(ceil_val, i)\n    \n    reduced = reduce_fraction(best[0], best[1])\n    print(f\"{reduced[0]}/{reduced[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010764019680209458, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.00013648532330989838, -0.0009461931767873466, -0.1270037442445755, -0.048622872680425644, -0.5794249773025513, -1.311301275563892e-06, -0.0005694198189303279, -0.0013379440642893314, -0.004212435334920883, -0.0006748544401489198, -2.038458114839159e-05, -7.152555099310121e-07, 0.0, -9.417489309271332e-06, -4.172316494077677e-06, -8.3446