ort java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int t, int c, int co, int r) {\n            to = t;\n            cap = c;\n            cost = co;\n            rev = r;\n        }\n    }\n\n    static class MCMF {\n        int N;\n        int[] H, D, P, E;\n        ArrayList<Edge>[] adj;\n\n        void init(int n) {\n            N = n;\n            H = new int[N + 1];\n            D = new int[N + 1];\n            P = new int[N + 1];\n            E = new int[N + 1];\n            adj = new ArrayList[N + 1];\n            for (int i = 0; i <= N; i++) {\n                adj[i] = new ArrayList<>();\n            }\n        }\n\n        void addEdge(int from, int to, int cap, int cost) {\n            adj[from].add(new Edge(to, cap, cost, adj[to].size()));\n            adj[to].add(new Edge(from, 0, -cost, adj[from].size() - 1));\n        }\n\n        int minCost(int s, int t, int f) {\n            int flow = 0, ans = 0;\n            Arrays.fill(H, 0);\n            while (f > 0) {\n                Arrays.fill(D, Integer.MAX_VALUE / 2);\n                PriorityQueue<int[]> pq = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                D[s] = 0;\n                pq.offer(new int[]{0, s});\n                while (!pq.isEmpty()) {\n                    int[] cur = pq.poll();\n                    int v = cur[1];\n                    if (D[v] < cur[0]) continue;\n                    for (int i = 0; i < adj[v].size(); i++) {\n                        Edge e = adj[v].get(i);\n                    if (e.cap > 0 && D[e.to] > D[v] + e.cost + H[v] - H[e.to]) {\n                        D[e.to] = D[v] + e.cost + H[v] - H[e.to];\n                    P[e.to] = v;\n                    E[e.to] = i;\n                    pq.offer(new int[]{D[e.to], e.to});\n                }\n            }\n            if (D[t] == Integer.MAX_VALUE / 2) break;\n            for (int i = 0; i <= N; i++) H[i] += D[i];\n            int add