Num = q - 1;\n            }\n        }\n\n        ++i;\n    }\n\n    printf(\"%lld/%lld\\n\", bestNum, bestDen);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long a = sc.nextLong();\n        long b = sc.nextLong();\n        long n = sc.nextLong();\n\n        double target = (double) a / b;\n        double bestErr = 1_000_000_000.0;\n        long bestNum = 0, bestDen = 0;\n\n        long i = 1;\n        while (i <= n) {\n            long q = (a * i) / b;\n\n            double e = Math.abs((double) q / i - target);\n            if (e < bestErr || (e == bestErr && (i < bestDen || (i == bestDen && q < bestNum)))) {\n                bestErr = e;\n                bestDen = i;\n                bestNum = q;\n            }\n\n            e = Math.abs((double) (q + 1) / i - target);\n            if (e < bestErr || (e == bestNum && (i < bestDen || (i == bestDen && q + 1 < bestNum)))) {\n                bestErr = e;\n                bestDen = i;\n                bestNum = q + 1;\n            }\n\n            if (q != 0) {\n                e = Math.abs((double) (q - 1) / i - target);\n                if (e < bestErr || (e == bestNum && (i < bestDen || (i == bestDen && q + 1 < bestNum)))) {\n                    bestErr = e;\n                    bestDen = i;\n                    bestNum = q - 1;\n                }\n            }\n\n            ++i;\n        }\n\n        System.out.println(bestNum + \"/\" + bestDen);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0006204110686667264, -9.536738616588991e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -5.9960475482512265e-05, -8.344646857949556e-07, -3.576278118089249e-07, -3.58813522325363e-05, -0.00