] + edges.get(e).cost) {\n                    d[v] = d[u] + edges.get(e).cost;\n                    min_flow[v] = Math.min(min_flow[u], edges.get(e).cap);\n                    prev_e[v] = e;\n                    prev_v[v] = u;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return min_flow[target];\n    }\n\n    static int N, M, K, C_cost, D_cost;\n    static int[][] plan = new int[105][105];\n    static int[][] count_st = new int[105][105];\n\n    static class Segment {\n        int u, v;\n        Segment(int u, int v) {\n            this.u = u;\n            this.v = v;\n        }\n    }\n\n    static Segment[] seg = new Segment[105];\n\n    static int V(int node_day, int loc) {\n        return node_day * N + loc;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        C_cost = sc.nextInt();\n        D_cost = sc.nextInt();\n\n        // Initialize edges and head lists\n        edges = new ArrayList<>();\n        head = new ArrayList<>();\n        for (int i = 0; i < MAX_V + 20; i++) {\n            edges.add(new Edge(0, 0, 0, 0));\n            head.add(0);\n        }\n        e_idx = 1;\n\n        source = V(N + K, N) + 1;\n        target = source + 2;\n\n        add_edge(V(0, 1), target, INF, 0);\n\n        for (int i = 1; i <= K; i++) {\n            int p = sc.nextInt();\n            add_edge(source, V(0, p), 1, 0);\n        }\n\n        for (int i = 1; i <= M; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            seg[i * 2] = new Segment(u, v);\n            seg[i * 2 - 1] = new Segment(v, u);\n        }\n        M <<= 1;\n\n        for (int day = 1; day <= N + K; day++) {\n            for (int i = 1; i <= N; i++)\n                add_edge(V(day - 1, i), V(day, i), INF, 0);\n            for (int i = 1; i <= M; i++) {\n                add_edge(V(day - 1, seg[i].u), V(day, seg[i].v), 1, D_cost);\n                plan[day][i] = e_idx;\n                count_st[day][i] = 1;\n            }\n            add_edge(V(day, 1), target, INF, day * C_cost);\n        }\n\n        int aug;\n        int total_cost = 0;\n        while ((aug = spfa_algo(source, target)) > 0) {\n            int v = target;\n            while (v != source) {\n                int u = prev_v[v];\n                int e = prev_e[v];\n                Edge edge = edges.get(e);\n                Edge revEdge = edges.get(e ^ 1);\n                edge.cap -= aug;\n                revEdge.cap += aug;\n                v = u;\n            }\n            total_cost += d[target] * aug;\n\n            for (int day = 1; day <= N + N; day++) {\n                for (int i = 1; i <= M; i++) {\n                    if (edges.get(plan[day][i]).cap > 0) {\n                        count_st[day][i]++;\n                        add_edge(V(day - 1, seg[i].u), V(day, seg[i].v), 1,\n                                D_cost * (count_st[day][i] * 2 - 1));\n                        plan[day][i] = e_idx;\n                    }\n                }\n            }\n        }\n\n        System.out.println(total_cost);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00018273114983458072, -1.7881377516459906e-06, -1.0728830375228426e-06, -0.0016623024130240083, -4.2914423829643056e-05, -0.14267860352993011, -0.4287692904472351, -3.40932747349143e-05, -2.3841855067985307e-07, -6.12716976320371e-05, -0.009756735526025295, -4.5536911784438416e-05, -0.009416216053068638, -0.014798394404351711, -1.1920922133867862e-06, -1.6689160474925302e-05, -2.3841855067985307e-07, 0.0, 0.0, -3.576278118089249e-07, 0.0, -4.029192859889008e-05, -1.311301275563892e-06, -5.960462772236497e-07, 0.0, -8.4638240878121e-06, -1.7881377516459906e-06, -3.57627811808