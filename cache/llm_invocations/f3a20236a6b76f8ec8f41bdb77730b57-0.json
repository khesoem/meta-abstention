c[i][d] = a[i][d]\n    return c\n\ndef shift(a, x):\n    c = [[0] * (d + 1) for _ in range(d + 1)]\n    for i in range(d + 1):\n        for j in range(d + 1):\n            c[i][j] = 0\n    for i in range(d):\n        for j in range(d):\n            c[(i + x) % d][(j + x) % d] = a[i][j]\n        c[(i + x) % d][d] = a[i][d]\n    for i in range(d):\n        c[d][(i + x) % d] = a[d][i]\n    c[d][d] = a[d][d]\n    return c\n\ndef get(v, md, d):\n    h = 0\n    pw = 1\n    t = -1\n    while h >= d:\n        h //= d\n        pw *= d\n        t += 1\n    x = v[-1] % pw\n    if t == -1:\n        return md[h]\n    ans = md[t]\n    ht = md[t]\n    for i in range(1, h):\n        ht = shift(ht, 1)\n        ans = merge(ans, ht)\n    ht = get(v[:-1], md, d)\n    ht = shift(ht, h)\n    ans = merge(ans, ht)\n    return ans\n\nif __name__ == '__main__':\n    sys.stdin = open(0)\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.25747159123420715, -0.00017602801381144673, -0.11529957503080368, -0.40254732966423035, -0.32912492752075195, -0.41051599383354187, -0.7219588160514832, -1.0003926753997803, -2.98023678624304e-06, -0.4906255304813385, -0.4910479485988617, -1.348637580871582, -1.3099160194396973, -0.5196793079376221, -0.6361150741577148, -0.09381657838821411, -0.06746695935726166, -0.007349851541221142, -0.49711742997169495, -0.0005194701952859759, -0.00036842457484453917, -0.3139076828956604, -3.57628505298635e-06, -0.013093826361000538, -9.704106923891231e-05, -0.4811142086982727, -0.011321616359055042, -0.3657817542552948, -0.8769821524620056, -0.058504994958639145, -0.006489966064691544, -0.0003251365851610899, -0.00012505835911724716, -0.0010320503497496247, -0.01617920771241188, -2.527268952690065e-05, -3.57628505298635e-06, -0.021407730877399445, -0.46558311581611633, -0.8480340242385864, -1.7754850387573242, -1.1421958208084106, -0.010041415691375732, -0.0005612159729935229, -0.48040828108787537, -9.513353870715946e-05, -0.0010202