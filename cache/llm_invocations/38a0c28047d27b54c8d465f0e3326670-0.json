n        cout << power(k, n) << '\\n';\n        return 0;\n    }\n\n    vector<int> dp_prev(n + 1, 0), dp_cur(n + 1, 0);\n    dp_prev[n] = 1;\n    int ans = 0;\n\n    for (int i = 1; i <= k; ++i) {\n        fill(dp_cur.begin(), dp_cur.end(), 0);\n        int res = 0;\n        for (int j = 1; j <= n; ++j) {\n            int tmp = dp_prev[j];\n            if (!tmp) continue;\n            int u = j ^ (j & -j);\n            for (int sub = u; sub; sub = (sub - 1) & u)\n                dp_cur[sub] = mod_add(dp_cur[sub], mod_mul(tmp, C(j, sub)));\n            res = mod_add(res, tmp);\n        }\n        ans = mod_add(ans, mod_mul(res, ifac[k - i]));\n        swap(dp_prev, dp_cur);\n    }\n\n    ans = mod_mul(ans, fac[k]);\n    ans = mod_sub(power(k, n), ans);\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static int MOD;\n    static int[] fac, ifac;\n\n    static int mod_add(int a, int b) {\n        int res = a + b;\n        if (res >= MOD) res -= MOD;\n        return res;\n    }\n\n    static int mod_mul(int a, int b) {\n        return (int)((long)a * b % MOD);\n    }\n\n    static int mod_sub(int a, int b) {\n        int res = a - b;\n        if (res < 0) res += MOD;\n        return res;\n    }\n\n    static int power(int x, int y) {\n        int res = 1;\n        while (y > 0) {\n            if ((y & 1) == 1) res = mod_mul(res, x);\n            x = mod_mul(x, x);\n            y >>= 1;\n        }\n        return res;\n    }\n\n    static int C(int x, int y) {\n        if (y < 0 || y > x) return 0;\n        return mod_mul(fac[x], mod_mul(ifac[x - y], ifac[y]));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st 