{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing pii = pair<int, int>;\n\nconst int T = 99;\nconst int C = 12;\nconst ll INF = 0x3f3f3f3f3f3f3f3fLL;\n\nstruct Edge {\n    int to, rev;\n    ll flow, cap, cost;\n};\n\nclass FlowNetwork {\npublic:\n    int n;\n    vector<vector<Edge>> adj;\n    vector<ll> dist, phi;\n    vector<int> par;\n\n    FlowNetwork(int size) : n(size), adj(size), dist(size), phi(size, 0), par(size) {}\n\n    void connect(int u, int v, ll capacity, ll cost) {\n        adj[u].push_back({v, (int)adj[v].size(), 0, capacity, cost});\n        adj[v].push_back({u, (int)adj[u].size()-1, 0, 0, -cost});\n    }\n\n    ll solve(int s, int t, ll& totalCost) {\n        totalCost = 0;\n        ll totalFlow = 0;\n\n        for (ll block = 1LL << 30; block > 0; block >>= 1) {\n            while (true) {\n                fill(dist.begin(), dist.end(), INF);\n                fill(par.begin(), par.end(), -1);\n                dist[s] = 0;\n\n                using P = pair<ll, int>;\n                priority_queue<P, vector<P>, greater<P>> pq;\n                pq.emplace(0, s);\n\n                while (!pq.empty()) {\n                    auto [d, u] = pq.top(); pq.pop();\n                    if (d != dist[u]) continue;\n                    for (int i = 0; i < adj[u].size(); ++i) {\n                        auto& e = adj[u][i];\n                        if (e.cap - e.flow >= block && dist[e.to] > dist[u] + phi[u] - phi[e.to] + e.cost) {\n                            dist[e.to] = dist[u] + phi[u] - phi[e.to] + e.cost;\n                            par[e.to] = i;\n                            pq.emplace(dist[e.to], e.to);\n                        }\n                    }\n                }\n\n                if (dist[t] >= INF) break;\n\n                for (int i = 0; i < n; ++i) {\n                    if (dist[i] < INF) phi[i] += dist[i];\n                }\n\n                ll df = INF;\n                for (int v = t; v != s; v = adj[v][par[v]].to) {\n                    df = min(df, adj[adj[v][par[v]].to][adj[v][par[v]].rev].cap - adj[adj[v][par[v]].to][adj[v][par[v]].rev].flow);\n                }\n\n                for (int v = t; v != s; v = adj[v][par[v]].to) {\n                    auto& e = adj[adj[v][par[v]].to][adj[v][par[v]].rev];\n                    e.flow += df;\n                    adj[v][par[v]].flow -= df;\n                    totalCost += df * e.cost;\n                }\n                totalFlow += df;\n            }\n        }\n        return totalFlow;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int source = 0;\n    int sink = n * T + 1;\n    FlowNetwork fn(sink + 1);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        fn.connect(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        fn.connect(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                fn.connect(i + (t - 1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            int cost = (j + 1) * (j + 1) - j * j;\n            for (int t = 1; t < T; ++t) {\n                fn.connect(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                fn.connect(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n            }\n        }\n    }\n\n    ll price;\n    ll flow = fn.solve(source, sink, price);\n    assert(flow == k);\n    cout << price << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int T = 99;\n    static final int C = 12;\n    static final long INF = 0x3f3f3f3f3f3f3f3fL;\n\n    static class Edge {\n        int to, rev;\n        long flow, cap, cost;\n\n        Edge(int to, int rev, long flow, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.flow = flow;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static class FlowNetwork {\n        int n;\n        List<List<Edge>> adj;\n        long[] dist, phi;\n        int[] par;\n\n        FlowNetwork(int size) {\n            n = size;\n            adj = new ArrayList<>(size);\n            for (int i = 0; i < size; i++) {\n                adj.add(new ArrayList<>());\n            }\n            dist = new long[size];\n            phi = new long[size];\n            par = new int[size];\n        }\n\n        void connect(int u, int v, long capacity, long cost) {\n            adj.get(u).add(new Edge(v, adj.get(v).size(), 0, capacity, cost));\n            adj.get(v).add(new Edge(u, adj.get(u).size() - 1, 0, 0, -cost));\n        }\n\n        long solve(int s, int t, long[] totalCost) {\n            totalCost[0] = 0;\n            long totalFlow = 0;\n\n            for (long block = 1L << 30; block > 0; block >>= 1) {\n                while (true) {\n                    Arrays.fill(dist, INF);\n                    Arrays.fill(par, -1);\n                    dist[s] = 0;\n\n                    PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> Long.compare(a[0], b[0]));\n                    pq.offer(new int[]{0, s});\n\n                    while (!pq.isEmpty()) {\n                        int[] cur = pq.poll();\n                        long d = cur[0];\n                        int u = cur[1];\n                        if (d != dist[u]) continue;\n                        for (int i = 0; i < adj.get(u).size(); ++i) {\n                            Edge e = adj.get(u).get(i);\n                            if (e.cap - e.flow >= block && dist[e.to] > dist[u] + phi[u] - phi[e.to] + e.cost) {\n                                dist[e.to] = dist[u] + phi[u] - phi[e.to] + e.cost;\n                                par[e.to] = i;\n                                pq.offer(new int[]{(int) dist[e.to], e.to});\n                            }\n                        }\n                    }\n\n                    if (dist[t] >= INF) break;\n\n                    for (int i = 0; i < n; ++i) {\n                        if (dist[i] < INF) phi[i] += dist[i];\n                    }\n\n                    long df = INF;\n                    for (int v = t; v != s; v = adj.get(v).get(par[v]).to) {\n                        Edge revEdge = adj.get(adj.get(v).get(par[v]).to).get(adj.get(v).get(par[v]).rev);\n                        df = Math.min(df, revEdge.cap - revEdge.flow);\n                    }\n\n                    for (int v = t; v != s; v = adj.get(v).get(par[v]).to) {\n                        Edge revEdge = adj.get(adj.get(v).get(par[v]).to).get(adj.get(v).get(par[v]).rev);\n                        revEdge.flow += df;\n                        adj.get(v).get(par[v]).flow -= df;\n                        totalCost[0] += df * revEdge.cost;\n                    }\n                    totalFlow += df;\n                }\n            }\n            return totalFlow;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int source = 0;\n        int sink = n * T + 1;\n        FlowNetwork fn = new FlowNetwork(sink + 1);\n\n        for (int i = 0; i < k; ++i) {\n            int a = sc.nextInt();\n            fn.connect(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; ++t) {\n            fn.connect(1 + t * n, sink, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; ++i) {\n                    fn.connect(i + (t - 1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; ++j) {\n                int cost = (j + 1) * (j + 1) - j * j;\n                for (int t = 1; t < T; ++t) {\n                    fn.connect(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                    fn.connect(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n\n        long[] price = new long[1];\n        long flow = fn.solve(source, sink, price);\n        System.out.println(price[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013779645087197423, -4.0531076592742465e-06, -8.344646857949556e-07, -0.012760652229189873, -6.627816765103489e-05, -0.4741212725639343, -0.4741477966308594, -0.000163541772053577, -8.344646857949556e-07, -0.0034332876093685627, -0.008614994585514069, -6.675497570540756e-05, -0.006896501872688532, -0.1637531965970993, -0.07889889180660248, -9.775113539944869e-06, -1.8834889488