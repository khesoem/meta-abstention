n == pattern.length()) {\n            return (lastTwo == 0 || lastTwo == 25 || lastTwo == 50 || lastTwo == 75) ? 1 : 0;\n        }\n        if (dp[position][placeholder][lastTwo] != -1) {\n            return dp[position][placeholder][lastTwo];\n        }\n        int total = 0;\n        char current = pattern.charAt(position);\n        if (current == 'X') {\n            if (placeholder != 10) {\n                total = solve(position + 1, placeholder, (lastTwo % 10) * 10 + placeholder, pattern);\n            } else {\n                int start = (position == 0) ? 1 : 0;\n                for (int digit = start; digit < 10; digit++) {\n                    total += solve(position + 1, digit, (lastTwo % 10) * 10 + digit, pattern);\n                }\n            }\n        } else if (current == '_') {\n            int start = (position == 0) ? 1 : 0;\n            for (int digit = start; digit < 10; digit++) {\n                total += solve(position + 1, placeholder, (lastTwo % 10) * 10 + digit, pattern);\n            }\n        } else {\n            int digit = current - '0';\n            total += solve(position + 1, placeholder, (lastTwo % 10) * 10 + digit, pattern);\n        }\n        dp[position][placeholder][lastTwo] = total;\n        return total;\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader reader = new BufferedReader(new InputStreamReader(System.in));\n        String line = reader.readLine();\n        int len = line.length();\n        if (len == 1) {\n            System.out.println(line.equals(\"0\") ? 1 : 0);\n        } else if (line.charAt(0) == '0') {\n            System.out.println(0);\n        } else {\n            dp = new int[len][11][100];\n            for (int i = 0; i < len; i++) {\n                for (int j = 0; j < 11; j++) {\n                    Arrays.fill(dp[i][j], -1);\n                }\n            }\n            System.out.println(solve(0, 10, 0, line));\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n\n    private static int[][][] dp;\n\n    public static int solve(int position, int placeholder, int lastTwo, String pattern, boolean started) {\n        if (position == pattern.length()) {\n            return (lastTwo == 0 || lastTwo == 25 || lastTwo == 50 || lastTwo == 75) ? 1 : 0;\n        }\n        if (dp[position][placeholder][lastTwo] != -1) {\n            return dp[position][placeholder][lastTwo];\n        }\n        int total = 0;\n        char current = pattern.charAt(position);\n        if (current == 'X') {\n            if (placeholder != 10) {\n                int digit = placeholder;\n                boolean newStarted = started || (digit != 0);\n                int newLastTwo = (started ? (lastTwo % 10) * 10 + digit : digit);\n                total += solve(position + 1, placeholder, newLastTwo, pattern, newStarted);\n            } else {\n                int start = (position == 0) ? 1 : 0;\n                for (int digit = start; digit < 10; digit++) {\n                    boolean newStarted = started || (digit != 0);\n                    int newLastTwo = (started ? (lastTwo % 10) * 10 + digit : digit);\n                    total += solve(position + 1, digit, newLastTwo, pattern, newStarted);\n                }\n            }\n        } else if (current == '_') {\n            int start = (position == 0) ? 1 : 0;\n            for (int digit = start; digit < 10; digit++) {\n                boolean newStarted = started || (digit != 0);\n                int newLastTwo = (started ? (lastTwo % 10) * 10 + digit : digit);\n                total += solve(position + 1, placeholder, newLastTwo, pattern, newStarted);\n            }\n        } else {\n            int digit = current - '0';\n            boolean newStarted = started || (digit != 0);\n         