= sc.nextInt();\n        }\n        int startPoint = 0;\n        int endPoint = n * 100 + 1;\n        MCMF solve = new MCMF();\n        solve.init(endPoint);\n        for (int i = 1; i <= k; i++) {\n            solve.add(startPoint, 1 + (a[i] - 1) * 100, 1, 0);\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                int p = (i - 1) * 100;\n                solve.add(p + j, p + j + 1, (int)INF, c);\n            }\n        }\n        for (int i = 1; i <= 100; i++) {\n            solve.add(i, endPoint, (int)INF, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                int p = (x - 1) * 100 + j;\n                int pp = (y - 1) * 100 + j + 1;\n                for (int jj = 1; jj <= 50; jj++) {\n                    solve.add(p, pp, 1, d * (jj * jj - (jj - 1) * (jj - 1)) + c);\n                }\n            }\n            for (int j = 1; j < 100; j++) {\n                int p = (y - 1) * 100 + j;\n                int pp = (x - 1) * 100 + j + 1;\n                for (int jj = 1; jj <= 50; jj++) {\n                    solve.add(p, pp, 1, d * (jj * jj - (jj - 1) * (jj - 1)) + c);\n                }\n            }\n        }\n        System.out.println(solve.minCost(startPoint, endPoint));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.3378547e-06, 0.0, -3.576278e-07, -0.00057633, -0.0005751386, -1.1920922e-06, -0.10020982, -0.252618, -0.011383582, -1.7881378e-06, -0.0019884591, -0.011114943, -0.0031903104, -0.019411478, -0.20902312, -0.25193626, -1.0379932, -0.006907157, -4.112636e-05, -0.038055185, -0.0031072453, -0.00950974, -0.00038735516, -3.0994368e-06, -6.7949063e-06, -0.0007264359, -0.00117257, -6.3180723e-06, -1.7881378e-06, -0.38708392, -0.00032836766, -2.384183e-06, -5.6028207e-06, -0.00034207213, -0.07709761, -0.390564