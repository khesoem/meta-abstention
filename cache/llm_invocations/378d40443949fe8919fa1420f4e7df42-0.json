ck(m-2);\n        g[to].push_back(m-1);\n    }\n    bool bellman(int s,int t,int& flow,int& cost)\n    {\n        for(int i = 0;i <= t; i++)\n            d[i] = inf,inq[i] = 0;\n        d[s] = 0;inq[s] = 1;p[s] = 0;a[s] = inf;\n        queue<int>Q;\n        Q.push(s);\n        while(!Q.empty())\n        {\n            int u = Q.front();\n\n            Q.pop();\n            inq[u] = 0;\n\n            for(int i = 0;i < g[u].size(); i++)\n            {\n                edge& ee = e[g[u][i]];\n\n                //cout<<ee.cap<<\"  \"<<ee.flow<<\"  \"<<d[ee.to]<<\"  \"<<d[u]<<\"  \"<<ee.cost<<endl;\n                if(ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost)\n                {\n                    //cout<<\"zzzz\"<<endl;\n                    d[ee.to] = d[u] + ee.cost;\n                    p[ee.to] = g[u][i];\n                    a[ee.to] = min(a[u],ee.cap - ee.flow);\n                    if(!inq[ee.to])\n                    {\n                        Q.push(ee.to);\n                        //cout<<\"in=\"<<ee.to<<endl;\n                        inq[ee.to] = 1;\n                    }\n                }\n            }\n        }\n\n        //cout<<\"hahaha\"<<endl;\n        if(d[t] == inf)\n            return false;\n        flow += a[t];\n        cost += d[t] * a[t];\n        int u = t;\n        while(u != s){\n            e[p[u]].flow += a[t];\n            e[p[u]^1].flow -= a[t];\n            u = e[p[u]].from;\n        }\n\n        return true;\n    }\n    int minCost(int s,int t)\n    {\n        int flow = 0,cost = 0;\n        while(bellman(s,t,flow,cost));\n        return cost;\n    }\n}solve;\n\n\nint main(){\n    int k,c,d;\n    cin>>n>>m>>k>>c>>d;\n\n    for(int i=1;i<=k;i++){\n        scanf(\"%d\",&a[i]);\n    }\n\n    startPoint=0,endPoint=n*100+1;\n\n    for(int i=1;i<=k;i++){\n        solve.add(startPoint,1+(a[i]-1)*100,1,0);\n    }\n\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<100;j++){\n            int p=(i-1)*100LL;\n            solve.add(p+j,p+j+1,inf,c);\n        }\n    }\n\n    for(int i=1;i<=100;i++)solve.add(i,endPoint,inf,0);\n\n    while(m--){\n        int x,y;\n        scanf(\"%d%d\",&x,&y);\n        for(int i=1;i<100;i++){\n            int p=(x-1)*100+i;\n            int pp=(y-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n        for(int i=1;i<100;i++){\n            int p=(y-1)*100+i;\n            int pp=(x-1)*100+i+1;\n            for(int j=1;j<=50;j++){\n                solve.add(p,pp,1,d*(j*j-(j-1)*(j-1))+c);\n            }\n        }\n\n    }\n\n    printf(\"%d\\n\",solve.minCost(startPoint,endPoint));\n    return 0;\n\n\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class MCMF {\n        static final int INF = 1000000007;\n        int N;\n        ArrayList<Edge> edges;\n        ArrayList<Integer>[] adj;\n\n        class Edge {\n            int from, to, cap, flow, cost;\n            Edge(int from, int to, int cap, int flow, int cost) {\n                this.from = from;\n                this.to = to;\n                this.cap = cap;\n                this.flow = flow;\n                this.cost = cost;\n            }\n        }\n\n        void init(int n) {\n            this.N = n;\n            edges = new ArrayList<>();\n            adj = new ArrayList[n + 1];\n            for (int i = 0; i <= n; i++) {\n                adj[i] = new ArrayList<>();\n            }\n        }\n\n        void addEdge(int from, int to, int cap, int cost) {\n            edges.add(new Edge(from, to, cap, 0, cost));\n            edges.add(new Edge(to, from, 0, 0, -cost));\n            int m = edges.size();\n            adj[from].add(m - 2);\n            adj[to].add(m - 1);\n        }\n\n        boolean bellman(int s, int t, int[] flow, int[] cost) {\n            int[] d = new int[N + 1];\n            int[] inq = new int[N + 1];\n            int[] p = new int[N + 1];\n            int[] capa = new int[N + 1];\n            Arrays.fill(d, INF);\n            d[s] = 0;\n            inq[s] = 1;\n            p[s] = 0;\n            capa[s] = INF;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = 0;\n                for (int idx : adj[u]) {\n                    Edge ee = edges.get(idx);\n                    if (ee.cap > ee.flow && d[ee.to] > d[u] + ee.cost) {\n                        d[ee.to] = d[u] + ee.cost;\n                        p[ee.to] = idx;\n                        capa[ee.to] = Math.min(capa[u], ee.cap - ee.flow);\n                        if (inq[ee.to] == 0) {\n                            q.add(ee.to);\n                            inq[ee.to] = 1;\n                        }\n                    }\n                }\n            }\n            if (d[t] == INF) return false;\n            flow[0] += capa[t];\n            cost[0] += d[t] * capa[t];\n            int u = t;\n            while (u != s) {\n                Edge fwd = edges.get(p[u]);\n                fwd.flow += capa[t];\n                edges.get(p[u] ^ 1).flow -= capa[t];\n                u = fwd.from;\n            }\n            return true;\n        }\n\n        int minCost(int s, int t) {\n            int[] flow = new int[]{0};\n            int[] cost = new int[]{0};\n            while (bellman(s, t, flow, cost));\n            return cost[0];\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] a = new int[k + 1];\n        for (int i = 1; i <= k; i++) {\n            a[i] = sc.nextInt();\n        }\n        int startPoint = 0;\n        int endPoint = n * 100 + 1;\n        MCMF solve = new MCMF();\n        solve.init(endPoint + 1);\n\n        for (int i = 1; i <= k; i++) {\n            int node = 1 + (a[i] - 1) * 100;\n            solve.addEdge(startPoint, node, 1, 0);\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                int from = (i - 1) * 100 + j;\n                int to = from + 1;\n                solve.addEdge(from, to, 1000000000, c);\n            }\n        }\n\n        for (int i = 1; i <= 100; i++) {\n            solve.addEdge(i, endPoint, 1000000000, 0);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                int p = (x - 1) * 100 + j;\n                int pp = (y - 1) * 100 + j + 1;\n                for (int t = 1; t <= 50; t++) {\n                    int cost = d * (t * t - (t - 1) * (t - 1)) + c;\n                    solve.addEdge(p, pp, 1, cost);\n                }\n                int p2 = (y - 1) * 100 + j;\n                int pp2 = (x - 1) * 100 + j + 1;\n                for (int t = 1; t <= 50; t++) {\n                    int cost = d * (t * t - (t - 1) * (t - 1)) + c;\n                    solve.addEdge(p2, pp2, 1, cost);\n                }\n            }\n        }\n\n        int result = solve.minCost(startPoint, endPoint);\n        System.out.println(result);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-7.033323527139146e-06, 0.0, -5.960462772236497e-07, -0.0002498314715921879, -0.00047803416964598, 0.0, -2.4437606043647975e-05, -0.006619312800467014, -0.31402096152305603, -2.3841855067985307e-07, -0.0013603252591565251, -0.038143545389175415, -0.005255454685539007, -0.08186586201190948, -0.25238603353500366, -0.6931694746017456, -4.529942543740617e-06, -1.1920928244535389e-07, -8.344646857949556e-