{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = 1000000000LL;\n\nstruct MinCostFlow {\n    struct Edge {\n        int to, rev;\n        ll cap, flow, cost;\n    };\n\n    int n;\n    vector<vector<Edge>> g;\n    vector<ll> dist;\n    vector<int> prevv, preve, inq;\n\n    MinCostFlow(int n) : n(n), g(n) {}\n\n    void add_edge(int v, int u, ll cap, ll cost) {\n        g[v].push_back({u, (int)g[u].size(), cap, 0, cost});\n        g[u].push_back({v, (int)g[v].size() - 1, 0, 0, -cost});\n    }\n\n    pair<ll, ll> min_cost_flow(int s, int t) {\n        ll flow = 0, total_cost = 0;\n\n        while (true) {\n            dist.assign(n, INF);\n            prevv.assign(n, -1);\n            preve.assign(n, -1);\n            inq.assign(n, 0);\n\n            queue<int> q;\n            dist[s] = 0;\n            q.push(s);\n            inq[s] = 1;\n\n            while (!q.empty()) {\n                int v = q.front();\n                q.pop();\n                inq[v] = 0;\n\n                for (int i = 0; i < (int)g[v].size(); ++i) {\n                    Edge &e = g[v][i];\n                    if (e.cap <= e.flow) continue;\n\n                    if (dist[e.to] > dist[v] + e.cost) {\n                        dist[e.to] = dist[v] + e.cost;\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n\n                        if (!inq[e.to]) {\n                            q.push(e.to);\n                            inq[e.to] = 1;\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) break;\n\n            ll add = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                add = min(add, e.cap - e.flow);\n            }\n\n            flow += add;\n\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.flow += add;\n                g[v][e.rev].flow -= add;\n                total_cost += add * e.cost;\n            }\n        }\n\n        return {flow, total_cost};\n    }\n};\n\nconst int T = 500;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    int N = n * T;\n    MinCostFlow mcf(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        mcf.add_edge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        mcf.add_edge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x;\n        --y;\n\n        for (int j = 0; j < T - 1; ++j) {\n            int cur = 1;\n            for (int z = 0; z < k; ++z) {\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    auto res = mcf.min_cost_flow(N, N + 1);\n    assert(res.first == k);\n    cout << res.second << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```java\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final long INF = 1000000000L;\n    static final int T = 500;\n\n    static class MinCostFlow {\n        static class Edge {\n            int to, rev;\n            long cap, flow, cost;\n            Edge(int to, int rev, long cap, long flow, long cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.flow = flow;\n                this.cost = cost;\n            }\n        }\n\n        int n;\n        ArrayList<ArrayList<Edge>> g;\n        long[] dist;\n        int[] prevv, preve;\n        boolean[] inq;\n\n        MinCostFlow(int n) {\n            this.n = n;\n            g = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                g.add(new ArrayList<>());\n            }\n        }\n\n        void addEdge(int v, int u, long cap, long cost) {\n            g.get(v).add(new Edge(u, g.get(u).size(), cap, 0, cost));\n            g.get(u).add(new Edge(v, g.get(v).size() - 1, 0, 0, -cost));\n        }\n\n        long[] minCostFlow(int s, int t) {\n            long flow = 0, totalCost = 0;\n            dist = new long[n];\n            prevv = new int[n];\n            preve = new int[n];\n            inq = new boolean[n];\n\n            while (true) {\n                Arrays.fill(dist, Long.MAX_VALUE / 2);\n                Arrays.fill(prevv, -1);\n                Arrays.fill(preve, -1);\n                Arrays.fill(inq, false);\n\n                Queue<Integer> q = new LinkedList<>();\n                dist[s] = 0;\n                q.add(s);\n                inq[s] = true;\n\n                while (!q.isEmpty()) {\n                    int v = q.poll();\n                    inq[v] = false;\n                    for (int i = 0; i < g.get(v).size(); i++) {\n                        Edge e = g.get(v).get(i);\n                        if (e.cap <= e.flow) continue;\n                        if (dist[e.to] > dist[v] + e.cost) {\n                            dist[e.to] = dist[v] + e.cost;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            if (!inq[e.to]) {\n                                q.add(e.to);\n                                inq[e.to] = true;\n                            }\n                        }\n                    }\n                }\n\n                if (dist[t] == Long.MAX_VALUE / 2) break;\n\n                long add = Long.MAX_VALUE / 2;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    add = Math.min(add, e.cap - e.flow);\n                }\n\n                flow += add;\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.flow += add;\n                    g.get(v).get(e.rev).flow -= add;\n                    totalCost += add * e.cost;\n                }\n            }\n            return new long[]{flow, totalCost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int N = n * T;\n        MinCostFlow mcf = new MinCostFlow(N + 2);\n\n        // stay edges\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        // sink edges from node 0's time steps\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i, N + 1, INF, 0);\n        }\n\n        // source edges\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            mcf.addEdge(N, x * T, 1, 0);\n        }\n\n        // road edges\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j < T - 1; j++) {\n                int cur = 1;\n                for (int z = 0; z < k; z++) {\n                    mcf.addEdge(x * T + j, y * T + j + 1, 1, cur * d + c);\n                    mcf.addEdge(y * T + j, x * T + j + 1, 1, cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        long[] res = mcf.minCostFlow(N, N + 1);\n        // assert res[0] == k;\n        System.out.println(res[1]);\n    }\n}\n```", "token_logprobs": [-0.016490356996655464, -0.5777350664138794, -1.0728830375228426e-06, -0.00020394629973452538, -7.497983460780233e-05, 0.0, -0.12692804634571075, -0.3868939280509949, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -2.3245540432981215e-05, -0.10046817362308502, 0.0, -0.049215320497751236, -0.10021822899580002, -0.004081729333847761, -0.0688636526465416, -0.3873548209667206, -0.0007139279623515904, -1.7881377516459906e-06, -0.0010315817780792713, -0.0004592079494614154, -0.04859982058405876, -5.602820692729438e-06, -3.576278118089249e-07, -3.0040289857424796e-05, -2.3841855067985307e-07, -0.4087372124195099, -0.005234109237790108, -2.884823152271565e-05, -0.0002097863471135497, -0.000