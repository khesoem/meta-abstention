{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n<your_rewritten_code_5>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 10005;\nconst long long INF = 1LL << 50;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int co, int r) : to(t), cap(c), cost(co), rev(r) {}\n};\n\nvector<Edge> adj[MAX_NODES];\nint dist[MAX_NODES], prevv[MAX_NODES], preve[MAX_NODES];\nbool inq[MAX_NODES];\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    adj[u].emplace_back(v, cap, cost, (int)adj[v].size());\n    adj[v].emplace_back(u, 0, -cost, (int)adj[u].size() - 1);\n}\n\nlong long minCostFlow(int src, int dst) {\n    long long totalCost = 0;\n    while (true) {\n        fill(dist, dist + MAX_NODES, INF);\n        fill(inq, inq + MAX_NODES, false);\n        queue<int> q;\n        dist[src] = 0;\n        q.push(src);\n        inq[src] = true;\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            for (int i = 0; i < adj[u].size(); ++i) {\n                auto& e = adj[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[dst] == INF) break;\n\n        long long flow = INF;\n        for (int v = dst; v != src; v = prevv[v]) {\n            flow = min(flow, (long long)adj[prevv[v]][preve[v]].cap);\n        }\n\n        for (int v = dst; v != src; v = prevv[v]) {\n            auto& e = adj[prevv[v]][preve[v]];\n            e.cap -= flow;\n            adj[v][e.rev].cap += flow;\n            totalCost += flow * e.cost;\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> positions(k + 1);\n    for (int i = 1; i <= k; ++i) cin >> positions[i];\n\n    int source = 0;\n    int sink = n * 100 + 1;\n\n    for (int floor = 1; floor <= 100; ++floor) {\n        addEdge(floor, sink, INT_MAX, 0);\n    }\n\n    for (int i = 1; i <= k; ++i) {\n        addEdge(source, (positions[i] - 1) * 100 + 1, 1, 0);\n    }\n\n    for (int floor = 2; floor <= n; ++floor) {\n        for (int level = 1; level < 100; ++level) {\n            addEdge((floor - 1) * 100 + level, (floor - 1) * 100 + level + 1, INT_MAX, c);\n        }\n    }\n\n    int u, v;\n    for (int _ = 0; _ < m; ++_) {\n        cin >> u >> v;\n        for (int level = 1; level < 100; ++level) {\n            for (int group = 1; group <= k; ++group) {\n                int edgeCost = c + d * (group * group - (group - 1) * (group - 1));\n                addEdge((u - 1) * 100 + level, (v - 1) * 100 + level + 1, 1, edgeCost);\n                addEdge((v - 1) * 100 + level, (u - 1) * 100 + level + 1, 1, edgeCost);\n            }\n        }\n    }\n\n    cout << minCostFlow(source, sink) << '\\n';\n    return 0;\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAX_NODES = 10005\nINF = 1 << 50\n\nclass Edge:\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nadj = [[] for _ in range(MAX_NODES)]\ndist = [0] * MAX_NODES\nprevv = [0] * MAX_NODES\npreve = [0] * MAX_NODES\ninq = [False] * MAX_NODES\n\ndef addEdge(u, v, cap, cost):\n    adj[u].append(Edge(v, cap, cost, len(adj[v])))\n    adj[v].append(Edge(u, 0, -cost, len(adj[u]) - 1))\n\ndef minCostFlow(src, dst):\n    totalCost = 0\n    while True:\n        for i in range(MAX_NODES):\n            dist[i] = INF\n        for i in range(MAX_NODES):\n            inq[i] = False\n        q = deque()\n        dist[src] = 0\n        q.append(src)\n        inq[src] = True\n\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for i in range(len(adj[u])):\n                e = adj[u][i]\n                if e.cap > 0 and dist[e.to] > dist[u] + e.cost:\n                    dist[e.to] = dist[u] + e.cost\n                    prevv[e.to] = u\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n\n        if dist[dst] == INF:\n            break\n\n        flow = INF\n        v = dst\n        while v != src:\n            flow = min(flow, adj[prevv[v]][preve[v]].cap)\n            v = prevv[v]\n\n        v = dst\n        while v != src:\n            e = adj[prevv[v]][preve[v]]\n            e.cap -= flow\n            adj[v][e.rev].cap += flow\n            totalCost += flow * e.cost\n            v = prevv[v]\n\n    return totalCost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    positions = [0] * (k + 1)\n    for i in range(1, k + 1):\n        positions[i] = int(data[idx]); idx += 1\n\n    source = 0\n    sink = n * 100 + 1\n\n    for floor in range(1, 101):\n        addEdge(floor, sink, 2**31 - 1, 0)\n\n    for i in range(1, k + 1):\n        addEdge(source, (positions[i] - 1) * 100 + 1, 1, 0)\n\n    for floor in range(2, n + 1):\n        for level in range(1, 100):\n            addEdge((floor - 1) * 100 + level, (floor - 1) * 100 + level + 1, 2**31 - 1, c)\n\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for level in range(1, 100):\n            for group in range(1, k + 1):\n                edgeCost = c + d * (group * group - (group - 1) * (group - 1))\n                addEdge((u - 1) * 100 + level, (v - 1) * 100 + level + 1, 1, edgeCost)\n                addEdge((v - 1) * 100 + level, (u - 1) * 100 + level + 1, 1, edgeCost)\n\n    print(minCostFlow(source, sink))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014876213390380144, -2.145764938177308e-06, -1.311301275563892e-06, -0.09313986450433731, -0.0015705404803156853, -5.960462772236497e-07, -0.00018368464952800423, -0.0002892790944315493, -1.0728830375228426e-06, -0.0011745942756533623, -0.023259539157152176, -0.24225422739982605, -8.940656698541716e-06, 0.0, 0.0, -1.1920928244535389e-07, -1.311301275563892e-06, -8.344646857949556e-07, -0.0003033416287507862, -2.0265558760002023e-06, -1.3470558769768104e-05, -5.304672595229931e-05, -2.50339189733495e-06, -0.009760159067809582, -2.3841855067985307e-07, -0.0028196123894304037, 0.0, -5.960462772236497e-07, 0.0, -1.0371154530730564e-05, -0.0009717986104078591, -1.847726889536716e-05, -9.536738616588991e-07, -3.576278118089249e-07, -0.3868715167045593,