e[level] > target) {\n            return tryCombinations(current - nextPower, target, level - 1, powers, cumulative);\n        } else {\n            return tryCombinations(current, target, level - 1, powers, cumulative);\n        }\n    }\n};\n\nint main() {\n    InputHandler handler;\n    long long w = handler.readLong();\n    long long m = handler.readLong();\n    \n    Solver solver;\n    std::cout << (solver.check(w, m) ? \"YES\" : \"NO\") << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.905801562126726e-05, -2.0265558760002023e-06, -2.3841855067985307e-07, -0.00010799778101500124, -1.4305104514278355e-06, -2.861018856492592e-06, -6.6756979322235566e-06, -1.1920858014491387e-05, -3.4570634852570947e-06, -0.05055240914225578, -8.4638240878121e-06, -0.00016151554882526398, -7.152555099310121e-07, -0.03272553160786629, -0.0002980979916173965, -0.000263894529780373, -1.7165990357170813e-05, -0.07661885023117065, -0.01104962918907404, -4.6967357775429264e-05, -9.536738616588991e-07, -0.48358261585235596, -0.6931509971618652, -0.011061654426157475, -5.960462772236497e-07, -0.665902316570282, -0.054887156933546066, -0.31344518065452576, -0.313552588224411, -5.960462772236497e-07, -1.6093124941107817e-05, -0.05493297055363655, 0.0, -7.152555099310121e-07, -6.6756979322235566e-06, -3.576278118089249e-07, -1.3702330589294434, -0.6571915745735168, -0.0008118432597257197, -4.768370445162873e-07, -0.0005626287311315536, -1.1920928244535389e-07, -0.00781573262065649, -0.27341535687446594, -0.10021618008613586, -0.24649621546268463, -1.2040065485052764e-05, -1.0728830375228426e-06, -4.768370445162873e-07, -0.011189330369234085, -2.3841855067985307e-07, -2.861018856492592e-06, -0.25366586446762085, -0.01705198921263218, -0.3682883679866791, -1.1920922133867862e-06, -0.11745131015777588, -4.434487345861271e-05, -5.960462772236497e-07, -0.000286657246761024, -5.960462772236497e-07, -1.6689286894688848e-06, -1.370