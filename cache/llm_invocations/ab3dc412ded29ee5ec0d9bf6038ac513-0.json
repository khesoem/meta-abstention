t.a[1][i] = 1;\n    A.push_back(init);\n    vector<int> V;\n    for (ll tmp = n; tmp; tmp /= k) {\n        V.push_back(tmp % k);\n        Mat x = A.back();\n        Mat next;\n        next.unit(k + 1);\n        ll power = k;\n        int p = 0;\n        while (power) {\n            if (power & 1) next = next * move_mat(x, (power ^ 1) << p);\n            x = move_mat(x, 1 << p) * x;\n            power >>= 1;\n            ++p;\n        }\n        A.push_back(next);\n    }\n    int step = 0;\n    vector<int> ans(k + 2, 0);\n    ans[k + 1] = 1;\n    for (int T = (int)V.size() - 1; T >= 0; --T) {\n        int cur = V[T];\n        if (cur) {\n            vector<int> tmp(k + 2);\n            for (int times = 0; times < cur; ++times) {\n                for (int i = 1; i <= k + 1; ++i) tmp[i] = ans[i];\n                for (int i = 1; i <= k + 1; ++i) ans[i] = 0;\n                Mat B = move_mat(A[T], times + step);\n                for (int i = 1; i <= k + 1; ++i)\n                    for (int j = 1; j <= k + 1; ++j)\n                        ans[i] = (ans[i] + (ll)tmp[j] * B.a[i][j]) % Mod;\n            }\n        }\n        step += cur;\n    }\n    int res = 0;\n    for (int i = 1; i <= k + 1; ++i) res = (res + ans[i]) % Mod;\n    cout << res << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nK = 105\nMOD = 10 ** 9 + 7\n\nclass Mat:\n    def __init__(self):\n        self.a = [[0] * K for _ in range(K)]\n\n    def unit(self, length):\n        for i in range(1, length + 1):\n            self.a[i][i] = 1\n\ndef id_func(x, step, k):\n    return ((x + step - 1) % k + 1) if x <= k else x\n\ndef move_mat(base, step, k):\n    step %= k\n    res = Mat()\n    for i in range(1, k + 2):\n        for j in range(1, k + 2):\n            res.a[id_func(i, step, k)][id_func(j, step, k)] = base.a[i][j]\n    return res\n\ndef mat_mul(lh