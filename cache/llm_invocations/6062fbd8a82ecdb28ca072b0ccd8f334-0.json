   int[][][] dist = new int[c50 + 1][c100 + 1][2];\n        long[][][] ways = new long[c50 + 1][c100 + 1][2];\n\n        int start = enc(c50, c100, 0);\n        int target = enc(0, 0, 1);\n        dist[c50][c100][0] = 1;\n        ways[c50][c100][0] = 1;\n\n        ArrayDeque<Integer> q = new ArrayDeque<>();\n        q.add(start);\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            int ub = u & 1;\n            int tmp = u >> 1;\n            int uj = tmp % base;\n            int ui = tmp / base;\n            int udist = dist[ui][uj][ub];\n\n            if (ub == 0) {\n                int p50c = Math.min(k / 50, ui);\n                int p100c = Math.min(k / 100, uj);\n                for (int x = p100c; x >= 0; x--) {\n                    int ymax = Math.min(p50c, (k - 100 * x) / 50);\n                    for (int y = ymax; y >= 0; y--) {\n                        if (x == 0 && y == 0) continue;\n                        int vi = ui - y;\n                        int vj = uj - x;\n                        int vb = 1;\n                        if (dist[vi][vj][vb] == 0 || dist[vi][vj][vb] == udist + 1) {\n                            long p1 = c[ui][Math.abs(ui - vi)];\n                            long p2 = c[uj][Math.abs(uj - vj)];\n                            ways[vi][vj][vb] = (ways[vi][vj][vb] + (ways[ui][uj][ub] * ((p1 * p2) % mod)) % mod) % mod;\n                            if (dist[vi][vj][vb] == 0) {\n                                dist[vi][vj][vb] = udist + 1;\n                                q.add(enc(vi, vj, vb));\n                            }\n                        }\n                    }\n                }\n            } else {\n                int maxX = Math.min(k / 100, c100 - uj);\n                for (int x = maxX; x >= 0; x--) {\n                    int ymax = Math.min((k - 100 * x) / 50, c50 - ui);\n                    for (int y = ymax; y >= 0; y--) {\n                        if (x == 0 && y == 0) continue;\n               