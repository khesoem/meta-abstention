)*n+to, 1, cost);\n                }\n            }\n        }\n    }\n    printf(\"%d\\n\", mcf.min_cost_flow(n*T, n*T+1, k));\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom heapq import heappop, heappush\nfrom collections import defaultdict\n\nclass edge:\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nclass MIN_COST_FLOW:\n    def __init__(self):\n        self.V = 0\n        self.G = [[] for _ in range(5010)]\n        self.h = [0] * 5010\n        self.dist = [float('inf')] * 5010\n        self.prevv = [0] * 5010\n        self.preve = [0] * 5010\n\n    def init(self, n):\n        self.V = n\n\n    def add_edge(self, from_, to, cap, cost):\n        self.G[from_].append(edge(to, cap, cost, len(self.G[to])))\n        self.G[to].append(edge(from_, 0, -cost, len(self.G[from_])-1))\n\n    def min_cost_flow(self, s, t, f):\n        res = 0\n        while f > 0:\n            que = []\n            for i in range(self.V):\n                self.dist[i] = float('inf')\n            self.dist[s] = 0\n            heappush(que, (0, s))\n            while que:\n                p = heappop(que)\n                v = p[1]\n                if self.dist[v] < p[0]:\n                    continue\n                for i in range(len(self.G[v])):\n                    e = self.G[v][i]\n                    if e.cap > 0 and self.dist[e.to] > self.dist[v] + e.cost + self.h[v] - self.h[e.to]:\n                        self.dist[e.to] = self.dist[v] + e.cost + self.h[v] - self.h[e.to]\n                        self.prevv[e.to] = v\n                        self.preve[e.to] = i\n                        heappush(que, (self.dist[e.to], e.to))\n            if self.dist[t] == float('inf'):\n                return -1\n            for i in range(self.V):\n                self.h[i] += self.dist[i]\n            d = f\n            for v in range(t, s, -1):\n                d = min(d, self.G[self.prevv[v]][self.preve[v]].cap)\n            f -= d\n            res += d * self.h[t]\n            for v in range(t, s, -1):\n                e = self.G[self.prevv[v]][self.preve[v]]\n                e.cap -= d\n                self.G[v][e.rev].cap += d\n        return res\n\nmcf = MIN_COST_FLOW()\n\nn, m, k, c, d = map(int, input().split())\na = list(map(int, input().split()))\ncnt = [0] * 50\nfor i in range(k):\n    cnt[a[i]-1] += 1\ne = [[] for _ in range(50)]\nfor _ in range(m):\n    x, y = map(int, input().split())\n    x -= 1\n    y -= 1\n    e[x].append(y)\n    e[y].append(x)\n\nmcf.init(n*100+2)\nfor i in range(n):\n    mcf.add_edge(n*100, i, cnt[i], 0)\nfor i in range(100):\n    mcf.add_edge(i*n, n*100+1, k, c*i)\nfor i in range(n):\n    for j in range(99):\n        mcf.add_edge(j*n+i, (j+1)*n+i, k, 0)\n    for to in e[i]:\n        for j in range(99):\n            for u in range(k):\n                cost = (u+1)*(u+1)*d-u*u*d\n                mcf.add_edge(j*n+i, (j+1)*n+to, 1, cost)\nprint(mcf.min_cost_flow(n*100, n*100+1, k))\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.6956349611282349, -0.0002454224450048059, -0.18094073235988617, -0.42689475417137146, -0.15544924139976501, -0.2547090947628021, -0.6198840141296387, -0.3117673099040985, -9.536747711536009e-07, -0.21043753623962402, -2.0265599687263602e-06, -0.14267857372760773, -0.00011969328625127673, -0.01761002652347088, -8.964940207079053e-05, -7.152560215217818e-07, -0.6942071914672852, -0.12357024848461151, -0.3638463616371155, -2.3841860752327193e-07, -0.47750362753868103, -0.170122429728508, -0.6138443946838379, -0.8502018451690674, -0.01097167283296585, -0.0029700950253754854, -0.0015321184182539582, -2.6703237381298095e-05, -9.536747711536009e-07, -0.0001119437874876894, -0.00023922204854898155, -0.04627653583884239, -0.0128426952287554