{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\n\nconst int N=10005,S=N-2,T=N-1;\nconst int M=2e6+10;\nconst int inf=2e9;\n\nint head[N],to[M],nxt[M],w[M],c[M],cnt=1;\n\ninline void addedge(int x, int y, int flow, int cost){\n\tto[++cnt]=y,nxt[cnt]=head[x],head[x]=cnt;\n\tw[cnt]=flow,c[cnt]=cost;\n\tto[++cnt]=x,nxt[cnt]=head[y],head[y]=cnt;\n\tw[cnt]=0,c[cnt]=-cost;\n}\n\nqueue <int> q;\nlong long dis[N];\nbool mark[N];\n\ninline bool spfa(){\n\tmemset(mark,0,sizeof(mark));\n\tmemset(dis,0x3f,sizeof(dis));\n\tq.push(T); dis[T]=0; mark[T]=1;\n\twhile (!q.empty()){\n\t\tint x=q.front();\n\t\tmark[x]=0; q.pop();\n\t\tfor (int i=head[x];i;i=nxt[i]){\n\t\t\tint y=to[i];\n\t\t\tif (w[i^1]&&dis[y]>dis[x]+c[i^1]){\n\t\t\t\tdis[y]=dis[x]+c[i^1];\n\t\t\t\tif (!mark[y]){\n\t\t\t\t\tq.push(y); mark[y]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn dis[S]<1e18;\n}\n\ninline int dfs(int x, int lim, ll &cost){\n\tint flow=0; mark[x]=1;\n\tif (x==T) return lim;\n\tfor (int i=head[x];i;i=nxt[i]){\n\t\tint y=to[i];\n\t\tif (!w[i]||mark[y]) continue;\n\t\tif (dis[x]!=dis[y]+c[i]) continue;\n\t\tint t=dfs(y,min(w[i],lim-flow),cost);\n\t\tw[i]-=t; w[i^1]+=t;\n\t\tflow+=t; cost+=t*c[i];\n\t\tif (flow==lim) return lim;\n\t}\n\treturn flow;\n}\n\ninline ll costflow(){\n\tint flow=0; ll cost=0;\n\twhile (spfa())\n\t\tdo{\n\t\t\tmemset(mark,0,sizeof(mark));\n\t\t\tflow+=dfs(S,inf,cost);\n\t\t}while (mark[T]);\n\treturn cost;\n}\n\nint main(){\n\tint n,m,k,c,d,lim=101;\n\tcin>>n>>m>>k>>c>>d;\n\tfor (int i=0;i<k;i++){\n\t\tint x; cin>>x; x--;\n\t\taddedge(S,x,1,0);\n\t}\n\tfor (int i=0;i<lim;i++)\n\t\taddedge(i*n,T,k,c*i);\n\tfor (int i=0;i<n;i++)\n\t\tfor (int j=0;j<lim-1;j++)\n\t\t\taddedge(i+j*n,i+(j+1)*n,k,0);\n\twhile (m--){\n\t\tint x,y; cin>>x>>y; x--,y--;\n\t\tfor (int i=0;i<lim-1;i++)\n\t\t\tfor (int j=k-1;~j;j--){\n\t\t\t\taddedge(x+i*n,y+(i+1)*n,1,d*(j<<1|1));\n\t\t\t\taddedge(y+i*n,x+(i+1)*n,1,d*(j<<1|1));\n\t\t\t}\n\t}\n\tcout<<costflow();\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    S = n * 101 - 2\n    T = n * 101 - 1\n    \n    # Graph representation: adjacency list with edges stored as [to, capacity, cost, reverse_edge_index]\n    # We'll use a list of lists for the graph\n    graph_size = n * 101\n    graph = [[] for _ in range(graph_size)]\n    \n    def add_edge(x, y, flow, cost):\n        # Forward edge\n        graph[x].append([y, flow, cost, len(graph[y])])\n        # Backward edge\n        graph[y].append([x, 0, -cost, len(graph[x]) - 1])\n    \n    # Read k starting points\n    for _ in range(k):\n        x = int(data[idx]); idx += 1\n        x -= 1\n        add_edge(S, x, 1, 0)\n    \n    # Add edges from time layers to T\n    for i in range(101):\n        add_edge(i * n, T, k, c * i)\n    \n    # Add edges between consecutive time layers for each node\n    for i in range(n):\n        for j in range(100):\n            add_edge(i + j * n, i + (j + 1) * n, k, 0)\n    \n    # Process m edges\n    for _ in range(m):\n        x = int(data[idx]); idx += 1\n        y = int(data[idx]); idx += 1\n        x -= 1\n        y -= 1\n        for i in range(100):\n            for j in range(k - 1, -1, -1):\n                cost_val = d * (j * 2 + 1)\n                add_edge(x + i * n, y + (i + 1) * n, 1, cost_val)\n                add_edge(y + i * n, x + (i + 1) * n, 1, cost_val)\n    \n    # SPFA for shortest path in residual graph\n    def spfa():\n        INF = 10**18\n        dist = [INF] * graph_size\n        in_queue = [False] * graph_size\n        dist[T] = 0\n        queue = deque([T])\n        in_queue[T] = True\n        \n        while queue:\n            x = queue.popleft()\n            in_queue[x] = False\n            for edge in graph[x]:\n                y, cap, cost, _ = edge\n                # Check reverse edge (backward edge in residual graph)\n                rev_edge = graph[y][edge[3]]\n                if rev_edge[1] > 0 and dist[y] > dist[x] + cost:\n                    dist[y] = dist[x] + cost\n                    if not in_queue[y]:\n                        queue.append(y)\n                        in_queue[y] = True\n        return dist[S] < INF\n    \n    # DFS for augmenting path\n    def dfs(x, lim, cost_container):\n        mark[x] = True\n        if x == T:\n            return lim\n        flow = 0\n        for edge in graph[x]:\n            y, cap, cost, rev_idx = edge\n            if cap == 0 or mark[y]:\n                continue\n            # Check reduced cost condition\n            if dist[x] != dist[y] + cost:\n                continue\n            t = dfs(y, min(cap, lim - flow), cost_container)\n            if t > 0:\n                # Update capacities\n                edge[1] -= t\n                graph[y][rev_idx][1] += t\n                flow += t\n                cost_container[0] += t * cost\n                if flow == lim:\n                    return lim\n        return flow\n    \n    # Main cost flow algorithm\n    total_flow = 0\n    total_cost = [0]  # Use list to allow modification in nested function\n    \n    while spfa():\n        mark = [False] * graph_size\n        while True:\n            mark = [False] * graph_size\n            flow_added = dfs(S, 10**9, total_cost)\n            if flow_added == 0:\n                break\n            total_flow += flow_added\n    \n    print(total_cost[0])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00012694983161054552, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0002743821241892874, -0.005615886766463518, -4.768370445162873e-07, -4.827859811484814e-05, -0.0002802217786666006, -3.3378546504536644e-06, -0.0001823735801735893, -0.0002646096108946949, -0.12382955849170685, -0.16818243265151978, -6.854299135738984e-05, -1.9073468138230965e-06, -0.5471466779708862, -0.000920825288631022, -1.0967194612021558e-05, -1.8954096958623268e-05, -0.11472830921411514, -4.9470632802695036e-05, -1.1920922133867862e-06, -9.345571743324399e-05, 0.0, -0.07895275950431824, -1.311301275563892e-06, -0.00020919041708111763, -8.427741704508662e-05, -0.08894338458776474, -1.0728830375228426e-06, -0.4821569323539734, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -3.576272320060525e-06, 0.0, -8.344646857949556e-07, -0.00038115866482257843, -3.576272320060525e-06, -1.311301275563892e-06, -4.768370445162873e-07, -0.003359984839335084, -9.107174992095679e-05, -0.0003800861886702478, -3.576278118089249e-07, 0.0, -9.536738616588991e-07, -3.576278118089249e-07, 0.0, -1.7881377516459906e-06, -1.311301275563892e-06, -1.6689286894688848e-06, -1.3113012755638