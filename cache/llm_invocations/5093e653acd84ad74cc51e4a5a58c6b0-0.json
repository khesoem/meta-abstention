int mask) {\n            if (ways[len-1][mask] == 0) return;\n            int rest = ((int)N) ^ mask;\n            each_submask(rest, [&](int part) {\n                ways[len][mask + part] += ways[len-1][mask] * invfact[part];\n                if (ways[len][mask + part] > BIG) ways[len][mask + part] %= MOD;\n            });\n        });\n        each_submask((int)N, [&](int mask) {\n            ways[len][mask] %= MOD;\n        });\n        ans = (ans + ways[len][(int)N] * choose((int)K, len)) % MOD;\n    }\n    return ans * fact[(int)N] % MOD;\n}\n\nint main() {\n    cin >> N >> K >> MOD;\n    ull ans = power(K, N);\n    if (N % 2 == 0) ans = (ans - calc_thing() + MOD) % MOD;\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 0\nN = 0\nK = 0\nfact = []\ninvfact = []\nways = []\n\ndef each_submask(mask):\n    s = mask\n    while s:\n        yield s\n        s = (s - 1) & mask\n\ndef power(a, b):\n    return pow(a, b, MOD)\n\ndef choose(a, b):\n    return fact[a] * invfact[b] % MOD * invfact[a - b] % MOD\n\ndef calc_thing():\n    global fact, invfact, ways\n    fact = [1] * (N + 1)\n    for i in range(1, N + 1):\n        fact[i] = fact[i - 1] * i % MOD\n    invfact = [1] * (N + 1)\n    invfact[N] = power(fact[N], MOD - 2)\n    for i in range(N - 1, -1, -1):\n        invfact[i] = invfact[i + 1] * (i + 1) % MOD\n\n    # ways[1][i] = invfact[i] for i=1..N\n    ways = [[0] * (N + 1) for _ in range(18)]\n    for i in range(1, N + 1):\n        ways[1][i] = invfact[i]\n\n    ans = ways[1][N] * choose(K, 1) % MOD\n    lim = min(17, K)\n\n    # Precompute all submasks of N\n    submasks_N = list(each_submask(N))\n\n    for length in range(2, lim + 1):\n        # First pass: update ways[length] using ways[length-1]\n        for mask in submasks_N:\n            if ways[length - 1][mask] == 0:\n      