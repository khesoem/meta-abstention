lt(mod.ncr(n, k), e);\n                \n                if (k % 2 == 1) {\n                    answer = mod.add(answer, term);\n                } else {\n                    answer = mod.subtract(answer, term);\n                }\n            }\n            \n            pw.println(answer);\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    static class Mod998 {\n        private static final long MOD = 998244353L;\n        private long[] fact;\n        private long[] invFact;\n        \n        public void precompute(int n) {\n            fact = new long[n + 1];\n            invFact = new long[n + 1];\n            \n            fact[0] = 1;\n            for (int i = 1; i <= n; i++) {\n                fact[i] = mult(fact[i - 1], i);\n            }\n            \n            invFact[n] = inv(fact[n]);\n            for (int i = n; i > 0; i--) {\n                invFact[i - 1] = mult(invFact[i], i);\n            }\n        }\n        \n        public long ncr(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return mult(fact[n], mult(invFact[r], invFact[n - r]));\n        }\n        \n        public long inv(int x) {\n            return inv((long)x);\n        }\n        \n        public long inv(long x) {\n            return pow(x, MOD - 2);\n        }\n        \n        public long add(long a, long b) {\n            a += b;\n            return a >= MOD ? a - MOD : a;\n        }\n        \n        public long subtract(long a, long b) {\n            a -= b;\n            return a < 0 ? a + MOD : a;\n        }\n        \n        public long mult(long a, long b) {\n            return (a * b) % MOD;\n        }\n        \n        public long pow(long base, long exp) {\n            long result = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) {\n                    result = (result * base) % MOD;\n                }\n                base = (base * base) %