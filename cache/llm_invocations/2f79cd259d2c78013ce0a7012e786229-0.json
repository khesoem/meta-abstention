nputReader:\n    def __init__(self, stream):\n        self.stream = stream\n        self.buffer = []\n        self.index = 0\n    \n    def read(self):\n        if self.index >= len(self.buffer):\n            data = self.stream.read(1024)\n            if not data:\n                return -1\n            self.buffer = list(data)\n            self.index = 0\n        val = self.buffer[self.index]\n        self.index += 1\n        return val\n    \n    def next_int(self):\n        c = self.read()\n        while c != -1 and chr(c) in ' \\n\\r\\t':\n            c = self.read()\n        if c == -1:\n            raise ValueError(\"No more input\")\n        \n        sign = 1\n        if c == ord('-'):\n            sign = -1\n            c = self.read()\n        \n        res = 0\n        while c >= ord('0') and c <= ord('9'):\n            res = res * 10 + (c - ord('0'))\n            c = self.read()\n            if c != -1 and chr(c) in ' \\n\\r\\t':\n                return res * sign\n        \n        if c != -1:\n            raise ValueError(\"Invalid integer format\")\n        return res * sign\n    \n    def next(self):\n        c = self.read()\n        while c != -1 and chr(c) in ' \\n\\r\\t':\n            c = self.read()\n        if c == -1:\n            return \"\"\n        \n        res = [chr(c)]\n        c = self.read()\n        while c != -1 and chr(c) not in ' \\n\\r\\t':\n            res.append(chr(c))\n            c = self.read()\n        return ''.join(res)\n\nclass OutputWriter:\n    def __init__(self, stream):\n        self.writer = stream\n    \n    def println(self, value):\n        self.writer.write(str(value) + '\\n')\n        self.writer.flush()\n\nclass TaskC:\n    def solve(self, test_number, in_reader, out_writer):\n        n = in_reader.next_int()\n        c_str = in_reader.next()\n        c = list(c_str)\n        \n        self.cv = self.ck = self.cs = 0\n        self.freq = [[0]*3 for _ in range(n + 1)]\n        self.pos = [[] for _ in range(3)]\