ong a, long b) {\n        return (a + b) % MOD;\n    }\n\n    static long mod_sub(long a, long b) {\n        return ((a - b) % MOD + MOD) % MOD;\n    }\n\n    static long mod_mul(long a, long b) {\n        return (a * b) % MOD;\n    }\n\n    static long mod_pow(long base, long exp) {\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = mod_mul(res, base);\n            }\n            base = mod_mul(base, base);\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static long mod_inv(long x) {\n        return mod_pow(x, MOD - 2);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n\n        long[][] A = new long[n][n];\n        for (int i = 0; i < n; ++i) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; ++j) {\n                A[i][j] = Long.parseLong(st.nextToken());\n                A[i][j] = mod_mul(A[i][j], mod_inv(100));\n            }\n        }\n\n        int[] cnt_bits = new int[1 << n];\n        for (int m = 0; m < (1 << n); ++m) {\n            cnt_bits[m] = Integer.bitCount(m);\n        }\n\n        List<List<Integer>> masks_by_cnt = new ArrayList<>();\n        for (int i = 0; i <= n; ++i) {\n            masks_by_cnt.add(new ArrayList<>());\n        }\n        for (int m = 0; m < (1 << n); ++m) {\n            masks_by_cnt.get(cnt_bits[m]).add(m);\n        }\n\n        long[][][] T = new long[n + 1][n + 1][1 << n];\n        for (int k = 0; k <= n; ++k) {\n            for (int idx = 0; idx < masks_by_cnt.get(k).size(); ++idx) {\n                int cm = masks_by_cnt.get(k).get(idx);\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    if ((mask & cm) == mask) continue;\n                    long val = 0;\n                    for (int x = 0; x < n; ++x) {\n                        if ((cm & (1 << x)) != 0) continue;\n                        if ((mask & (1 << x)) == 0) continue;\n                        int nm = cm | (1 << x);\n                        int cnt_nm = cnt_bits[nm];\n                        int size = masks_by_cnt.get(cnt_nm).size();\n                        if (size < 63) {\n                            val |= (1L << size);\n                        }\n                    }\n                    T[k][idx][mask] = val;\n                }\n            }\n        }\n\n        Map<Long, Long>[] DP = new HashMap[n + 1];\n        for (int i = 0; i <= n; ++i) {\n            DP[i] = new HashMap<>();\n        }\n        DP[0].put(1L, 1L);\n\n        for (int k = 0; k < n; ++k) {\n            for (int edges = 0; edges < (1 << n); ++edges) {\n                long prob = 1;\n                for (int i = 0; i < n; ++i) {\n                    long p = ((edges >> i) & 1) == 1 ? A[k][i] : mod_sub(1, A[k][i]);\n                    prob = mod_mul(prob, p);\n                }\n                for (Map.Entry<Long, Long> entry : DP[k].entrySet()) {\n                    long mask = entry.getKey();\n                    long val = entry.getValue();\n                    long newmask = 0;\n                    long p = mod_mul(prob, val);\n                    List<Integer> current_masks = masks_by_cnt.get(k);\n                    for (int i = 0; i < current_masks.size(); ++i) {\n                        if ((mask & (1 << i)) != 0) {\n                            newmask |= T[k][i][edges];\n                        }\n                    }\n                    if (newmask != 0) {\n                        DP[k + 1].put(newmask, mod_add(DP[k + 1].getOrDefault(newmask, 0L), p));\n                    }\n                }\n            }\n        }\n\n        System.out.println(DP[n].getOrDefault(1L, 0L));\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs":