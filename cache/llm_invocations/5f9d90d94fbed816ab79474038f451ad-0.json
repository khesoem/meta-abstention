'9') edge[0][enc(i,j,0)]=buf[i][j]-'0';\n  for (int i=0; i<n; i++) cin>>buf[i];\n\n  static int const dx[]={-1,0,1,0};\n  static int const dy[]={0,-1,0,1};\n\n  queue<pair<int,int>> bfs;\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      if (buf[i][j]=='Z') tox[i][j]=0, bfs.emplace(i,j);\n      else tox[i][j]=m+1;\n    }\n\n  for (; not bfs.empty(); bfs.pop()){\n    for (int i=4; i--;){\n      int t=tox[bfs.front().first][bfs.front().second];\n      int x=bfs.front().first+dx[i];\n      int y=bfs.front().second+dy[i];\n      if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]){\n        tox[x][y]=t+1;\n        bfs.emplace(x,y);\n      }\n    }\n  }\n\n  vn=enc(n-1,n-1,m)+1;\n\n  for (int i=n; i--;)\n    for (int j=n; j--;){\n      for (int t=0; t<m; t++){\n        for (int q=4; q--;){\n          int x=i+dx[q];\n          int y=j+dy[q];\n          if (x>=0 and y>=0 and x<n and y<n and buf[x][y]!='Y' and t+1<tox[x][y]+(buf[x][y]>'0' and buf[x][y]<='9') and t<tox[i][j]){\n            edge[enc(i,j,t)][enc(x,y,t+1)]=1000;\n          }\n        }\n        if (buf[i][j]>'0' and buf[i][j]<='9'){\n          edge[enc(i,j,t)][enc(i,j,m)]=buf[i][j]-'0';\n        }\n      }\n      if (buf[i][j]>'0' and buf[i][j]<='9'){\n        edge[enc(i,j,m)][1]=buf[i][j]-'0';\n      }\n    }\n\n  for (int u=8; u; u/=2) res+=aug(0,1,u);\n  cout<<res<<'\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static int n, m, vn;\n    static int[] from;\n    static ArrayList<HashMap<Integer, Integer>> edge;\n    static int[][] tox;\n    static char[][] buf;\n    static final int[] dx = {-1, 0, 1, 0};\n    static final int[] dy = {0, -1, 0, 1};\n\n    static int enc(int x, int y, int t) {\n        return x + y * n + t * n * n + 2;\n    }\n\n    static int dfs(int v, int t, int f, int cap) {\n        if (v == t) return f;\n        HashMap<Integer, Integer> map = edge.get(v);\n        for (Map.Entry<Integer, Integer> e : map.entrySet()) {\n            int to = e.getKey();\n            int capEdge = e.getValue();\n            if (capEdge >= cap && from[to] == -1) {\n                from[to] = v;\n                int d = dfs(to, t, Math.min(f, capEdge), cap);\n                if (d > 0) {\n                    // decrease forward capacity\n                    map.put(to, capEdge - d);\n                    // increase reverse capacity\n                    HashMap<Integer, Integer> revMap = edge.get(to);\n                    revMap.put(v, revMap.getOrDefault(v, 0) + d);\n                    return d;\n                }\n            }\n        }\n        return 0;\n    }\n\n    static int aug(int s, int t, int cap) {\n        int result = 0;\n        while (true) {\n            Arrays.fill(from, -1);\n            from[s] = s;\n            int f = dfs(s, t, cap, cap);\n            if (f == 0) break;\n            result += f;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        sc.nextLine(); // consume newline\n\n        // First grid: read n lines\n        char[][] firstGrid = new char[n][n];\n        for (int i = 0; i < n; i++) {\n            String line = sc.nextLine();\n            firstGrid[i] = line.toCharArray();\n        }\n\n        // Second grid: read n lines\n        buf = new char[n][n];\n        for (int i = 0; i < n; i++) {\n            String line = sc.nextLine();\n            buf[i] = line.toCharArray();\n        }\n\n        // Initialize tox with BFS from 'Z'\n        tox = new int[n][n];\n        for (int i = 0; i < n; i++) {\n            Arrays.fill(tox[i], m + 1);\n        }\n        Queue<int[]> queue = new LinkedList<>();\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (buf[i][j] == 'Z') {\n                    tox[i][j] = 0;\n                    queue.add(new int[]{i, j});\n                }\n            }\n        }\n        while (!queue.isEmpty()) {\n            int[] cur = queue.poll();\n            int t = tox[cur[0]][cur[1]];\n            for (int d = 0; d < 4; d++) {\n                int x = cur[0] + dx[d];\n                int y = cur[1] + dy[d];\n                if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y' && t + 1 < tox[x][y]) {\n                    tox[x][y] = t + 1;\n                    queue.add(new int[]{x, y});\n                }\n            }\n        }\n\n        // Compute number of vertices\n        vn = enc(n - 1, n - 1, m) + 1;\n        edge = new ArrayList<>(vn);\n        for (int i = 0; i < vn; i++) {\n            edge.add(new HashMap<>());\n        }\n        from = new int[vn];\n\n        // Add edges from source (0) to cells with initial numbers\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                char c = firstGrid[i][j];\n                if (c > '0' && c <= '9') {\n                    int cap = c - '0';\n                    edge.get(0).put(enc(i, j, 0), cap);\n                }\n            }\n        }\n\n        // Build rest of the graph\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                for (int t = 0; t < m; t++) {\n                    // edges to adjacent cells at next time\n                    for (int d = 0; d < 4; d++) {\n                        int x = i + dx[d];\n                        int y = j + dy[d];\n                        if (x >= 0 && y >= 0 && x < n && y < n && buf[x][y] != 'Y' &&\n                            t + 1 < tox[x][y] + (buf[x][y] > '0' && buf[x][y] <= '9' ? 1 : 0) &&\n                            t < tox[i][j]) {\n                            edge.get(enc(i, j, t)).put(enc(x, y, t + 1), 1000);\n                        }\n                    }\n                    // edge to same cell at time m if digit\n                    char c = buf[i][j];\n                    if (c > '0' && c <= '9') {\n                        edge.get(enc(i, j, t)).put(enc(i, j, m), c - '0');\n                    }\n                }\n                // edge from time m to sink\n                char c = buf[i][j];\n                if (c > '0' && c <= '9') {\n                    edge.get(enc(i, j, m)).put(1, c - '0');\n                }\n            }\n        }\n\n        int res = 0;\n        for (int u = 8; u > 0; u /= 2) {\n            res += aug(0, 1, u);\n        }\n        System.out.println(res);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, -4.362964682513848e-05, -0.00018082413589581847, 0.0, -2.1457441107486375e-05, -0.0029246911872178316, -0.0001292145170737058, 0.0, -0.0025758917909115553, -0.004081610590219498, -0.00013553177996072918, -0.004231665749102831, -0.43705207109451294, -0.004053710028529167, -0.0003014348621945828, -1.4305104514278355e-06, -0.008618776686489582, -2.9802276912960224e-06, -1.1920928244535389e-07, -2.825220326485578e-05, 0.0, -2.264974000354414e-06, -0.36310333013534546, -0.0052490513771772385, -1.728519782773219e-05, -0.004582973662763834, -3.576278118089249e-07, -0.00026174934464506805, -0.12417833507061005, 0.0, -9.798523387871683e-05, 0.0, 0.0, -0.16022419929504395, 0.0, -4.124556289752945e-05, -0.0672890767455101, -0.0009116546134464443, -2.8013790142722428e-05, -0.4773654341697693, -0.062079206109046936, -0.00038747431244701147, -0.06787636876106262, -3.540453326422721e-05, -2.861018856492592e-06, -0.0017739288741722703, -2.7418097943154862e-06, -0.10029792040586472, -0.3418610095977783, -0.06197041645646095, -0.0002754547167569399, -0.4742293357849121, -2.861018856492592e-06, -0.0002917817619163543, -9.643566590966657e-05, -2.3841855067985307e-07, -0.0005806190893054008, 0.0, 0.0, -0.0019292091019451618, -3.6954811548639555e-06, -1