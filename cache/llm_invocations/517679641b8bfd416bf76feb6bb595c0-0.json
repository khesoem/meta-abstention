ap.empty()) {\n                auto [d, u] = heap.top();\n                heap.pop();\n\n                if (d != dist[u]) continue;\n\n                for (int i = 0; i < (int)adj[u].size(); ++i) {\n                    Edge &e = adj[u][i];\n                    int v = e.to;\n\n                    if (e.cap <= e.f) continue;\n\n                    tc nd = dist[u] + e.cost + pot[u] - pot[v];\n                    if (dist[v] > nd) {\n                        dist[v] = nd;\n                        heap.emplace(nd, v);\n                        prevV[v] = u;\n                        prevE[v] = i;\n                        flow[v] = min(flow[u], e.cap - e.f);\n                    }\n                }\n            }\n\n            if (dist[sink] == INF) break;\n\n            for (int i = 0; i < n; ++i)\n                pot[i] += dist[i];\n\n            tf df = min(flow[sink], INF - totalFlow);\n            totalFlow += df;\n\n            for (int v = sink; v != source; v = prevV[v]) {\n                Edge &e = adj[prevV[v]][prevE[v]];\n                e.f += df;\n                adj[v][e.rev].f -= df;\n                totalCost += df * e.cost;\n            }\n        }\n\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int T = 150;\n    int N = n * T;\n    MinCostFlowSolver solver(N + 2);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < T - 1; ++j) {\n            solver.addEdge(i * T + j, i * T + j + 1, INF, c);\n        }\n    }\n\n    for (int i = 0; i < T; ++i) {\n        solver.addEdge(i, N + 1, INF, 0);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        solver.addEdge(N, x * T, 1, 0);\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n\n        for (int j = 0; j < T - 1; ++j) {\n            int mult =