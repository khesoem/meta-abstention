t i=0;i<=EE;i++)mi[i]=INF,used[i]=0;\n    mi[EE]=INF;\n    bfs[0]=0;\n    mi[0]=0;\n    int rr=1;\n    for(int i=0;i<rr;i++){\n        int x=bfs[i];\n        used[x]=0;\n        for(int j=0;j<(int)e[x].size();j++){\n            int r=e[x][j];\n            if(es[r].c>0&&mi[x]+es[r].v<mi[es[r].y]){\n                mi[es[r].y]=mi[x]+es[r].v;\n                lt[es[r].y]=r;\n                if(!used[es[r].y]){\n                    used[es[r].y]=1;\n                    bfs[rr++]=es[r].y;\n                }\n            }\n        }\n    }\n    if(mi[EE]==INF)return -1;\n    int now=EE;\n    while(now){\n        int r=lt[now];\n        if(es[r].ty==1){\n            if((r&1)==1){\n                es[r].v+=2*d;\n                es[r^1].v-=2*d;\n            }\n            else{\n                es[r].v+=2*d;\n                es[r^1].v-=2*d;\n            }\n        }\n        es[r].c--;\n        es[r^1].c++;\n        now=es[r^1].y;\n    }\n    return mi[EE];\n}\nint solve(int nn){\n    int v=0;\n    for(int i=0;i<nn;i++)v+=flow();\n    return v;\n}\nint main(){\n    int n,m,k;\n    cin>>n>>m>>k>>C>>d;\n    flow_clear(n*100+1);\n    for(int i=1;i<=k;i++){\n        int x;\n        cin>>x;\n        add_edge(0,x,1,0,0);\n    }\n    for(int i=1;i<=99;i++){\n        add_edge(1+i*n,100*n+1,INF,0,0);\n    }\n    for(int i=1;i<=n;i++){\n        for(int j=1;j<=99;j++){\n            add_edge(i+(j-1)*n,i+j*n,INF,C,0);\n        }\n    }\n    for(int i=1;i<=m;i++){\n        int x,y; cin>>x>>y;\n        for(int j=1;j<=99;j++){\n            add_edge(x+(j-1)*n,y+j*n,INF,C+d,1);\n            add_edge(y+(j-1)*n,x+j*n,INF,C+d,1);\n        }\n    }\n    cout<<solve(k)<<'\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1034567890; // note: original had 1034567890, but int max is 2147483647, so this is less.\n    static int C, d;\n    static int EE;\n    static int en;\n    static ArrayList<ArrayList<Integer>> e;\n    static ArrayList<Edge> es;\n\n    static class Edge {\n        int y, c, v, ty;\n        Edge(int y, int c, int v, int ty) {\n            this.y = y;\n            this.c = c;\n            this.v = v;\n            this.ty = ty;\n        }\n    }\n\n    static void flow_clear(int _EE) {\n        EE = _EE;\n        e = new ArrayList<>(EE + 1);\n        for (int i = 0; i <= EE; i++) {\n            e.add(new ArrayList<>());\n        }\n        es = new ArrayList<>();\n        en = 0;\n    }\n\n    static void add_edge(int x, int y, int c, int v, int _ty) {\n        e.get(x).add(en);\n        es.add(new Edge(y, c, v, _ty));\n        en++;\n        e.get(y).add(en);\n        if (_ty == 1) {\n            es.add(new Edge(x, 0, -C + d, _ty));\n        } else {\n            es.add(new Edge(x, 0, -v, _ty));\n        }\n        en++;\n    }\n\n    static int flow() {\n        int[] mi = new int[EE + 1];\n        int[] lt = new int[EE + 1];\n        boolean[] used = new boolean[EE + 1];\n        Arrays.fill(mi, INF);\n        mi[EE] = INF;\n        mi[0] = 0;\n        ArrayDeque<Integer> queue = new ArrayDeque<>();\n        queue.add(0);\n        used[0] = true;\n        while (!queue.isEmpty()) {\n            int x = queue.poll();\n            used[x] = false;\n            for (int idx : e.get(x)) {\n                Edge edge = es.get(idx);\n                if (edge.c > 0 && mi[x] + edge.v < mi[edge.y]) {\n                    mi[edge.y] = mi[x] + edge.v;\n                    lt[edge.y] = idx;\n                    if (!used[edge.y]) {\n                        used[edge.y] = true;\n                        queue.add(edge.y);\n                    }\n                }\n            }\n        }\n        if (mi[EE] == INF) return -1;\n        int now = EE;\n        while (now != 0) {\n            int r = lt[now];\n            Edge edge = es.get(r);\n            if (edge.ty == 1) {\n                edge.v += 2 * d;\n                Edge rev = es.get(r ^ 1);\n                rev.v -= 2 * d;\n            }\n            es.get(r).c--;\n            es.get(r ^ 1).c++;\n            now = es.get(r ^ 1).y;\n        }\n        return mi[EE];\n    }\n\n    static int solve(int nn) {\n        int v = 0;\n        for (int i = 0; i < nn; i++) v += flow();\n        return v;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        C = sc.nextInt();\n        d = sc.nextInt();\n        flow_clear(n * 100 + 1);\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            add_edge(0, x, 1, 0, 0);\n        }\n        for (int i = 0; i < 99; i++) {\n            add_edge(1 + i * n, 100 * n + 1, INF, 0, 0);\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= 99; j++) {\n                add_edge(i + (j - 1) * n, i + j * n, INF, C, 0);\n            }\n        }\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int j = 1; j <= 99; j++) {\n                add_edge(x + (j - 1) * n, y + j * n, INF, C + d, 1);\n                add_edge(y + (j - 1) * n, x + j * n, INF, C + d, 1);\n            }\n        }\n        System.out.println(solve(k));\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0005809764843434095, -3.576278118089249e-07, -3.814689989667386e-06, -0.0003675738989841193, -0.0013267532922327518, -5.960462772236497e-07, -0.00043072958942502737, -0.29568108916282654, -0.00781727023422718, -2.7418097943154862e-06, -8.415821503149346e-05, -0.001189477858133614, -0.0009193961159326136, -0.016246778890490532, -3.3123509883880615, -2.7656173188006505e-05, -0.0002699726028367877, -4.768370445162873e-07, -3.814689989667386e-06