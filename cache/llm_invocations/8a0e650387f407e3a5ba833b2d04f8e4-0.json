od((a * a) % m, b / 2, m) % m;\n}\n\nvector<long long> f(asz);\n\nlong long C(int n, int k) {\n    if (k > n) return 0LL;\n    return (f[n] * BigMod(f[k], MOD - 2, MOD) % MOD) * BigMod(f[n - k], MOD - 2, MOD) % MOD;\n}\n\nlong long solve(int n, int k) {\n    long long ans = 0;\n    for (int i = 0; i <= n - k; i++) {\n        long long term = C(n - k, i) * BigMod(n - k - i, n, MOD) % MOD;\n        if (i % 2 == 0) {\n            ans = (ans + term) % MOD;\n        } else {\n            ans = (ans - term + MOD) % MOD;\n        }\n    }\n    return ans;\n}\n\nint main() {\n    int t = 1;\n    // cin >> t;\n    for (int qq = 1; qq <= t; qq++) {\n        long long n, k;\n        cin >> n >> k;\n        \n        f[0] = 1;\n        for (long long i = 1; i <= n; i++) {\n            f[i] = f[i - 1] * i % MOD;\n        }\n        \n        if (k >= n) {\n            cout << 0 << endl;\n        } else if (k == 0) {\n            cout << f[n] << endl;\n        } else {\n            cout << (2LL * C((int)n, (int)(n - k)) % MOD * solve((int)n, (int)k) % MOD) << endl;\n        }\n    }\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014101465058047324, -2.622600959512056e-06, -7.152555099310121e-07, -0.0009548871894367039, -7.152555099310121e-07, -2.658331868587993e-05, -2.264974000354414e-06, -0.00010168035078095272, -5.960462772236497e-07, -0.5290151238441467, -6.556489552167477e-06, -8.010543388081715e-05, 0.0, -0.013322854414582253, -1.5258672647178173e-05, -0.0008095800876617432, -7.629365427419543e-06, -0.04124346747994423, -0.0017027654685080051, -0.02975805476307869, -8.344646857949556e-07, -0.7393351793289185, -0.048588693141937256, -0.42874303460121155, -7.867782187531702e-06, -3.814689989667386e-06, -2.7418097943154862e-06, -0.7558836936950684, -3.313963316031732e-05, -3.814689989667386e-06, -4.291525328881107e-06, -1.4305104514278355e-06, 0.0, -1.1920928244535389e-07, 0.0, -1.5497195136049413e-06, -7.152555099310121e-07,