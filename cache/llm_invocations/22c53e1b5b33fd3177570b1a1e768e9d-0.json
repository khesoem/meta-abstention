istHK[0] != INF;\n}\n\nbool dfsHK(int u) {\n    if (u == 0) return true;\n    for (int i = 0; i < (int)e[u - 1].size(); ++i) {\n        int v = e[u - 1][i] + 1;\n        if (distHK[pairV[v]] == distHK[u] + 1) {\n            if (dfsHK(pairV[v])) {\n                pairV[v] = u;\n                pairU[u] = v;\n                return true;\n            }\n        }\n    }\n    distHK[u] = INF;\n    return false;\n}\n\nint hopcroftKarp() {\n    for (int i = 0; i <= leftCnt; ++i) pairU[i] = 0;\n    for (int i = 0; i <= rightCnt; ++i) pairV[i] = 0;\n    int ans = 0;\n    while (bfsHK()) {\n        for (int u = 1; u <= leftCnt; ++u) {\n            if (pairU[u] == 0 && dfsHK(u)) ++ans;\n        }\n    }\n    return ans;\n}\n\nvoid bfsFromStart(int sr, int sc) {\n    queue<int> qr, qc;\n    memset(F, 255, sizeof(F));\n    qr.push(sr);\n    qc.push(sc);\n    F[sr][sc] = 0;\n    while (!qr.empty()) {\n        int r = qr.front(); qr.pop();\n        int c = qc.front(); qc.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k];\n            int nc = c + dc[k];\n            if (A[nr][nc] >= 0 && F[nr][nc] < 0) {\n                F[nr][nc] = F[r][c] + 1;\n                qr.push(nr);\n                qc.push(nc);\n            }\n        }\n    }\n}\n\nvoid addMonsterEdges(int sr, int sc, int cnt) {\n    int seen[12][12];\n    queue<int> qr, qc;\n    memset(seen, 255, sizeof(seen));\n    qr.push(sr);\n    qc.push(sc);\n    seen[sr][sc] = 0;\n    while (!qr.empty()) {\n        int r = qr.front(); qr.pop();\n        int c = qc.front(); qc.pop();\n        int lim = min(T, F[r][c]);\n        if (seen[r][c] > lim) continue;\n        for (int i = 0; i < (int)things[r][c].size(); ++i)\n            for (int k = 0; k < cnt; ++k)\n                e[leftCnt + k].push_back(things[r][c][i]);\n        if (seen[r][c] == lim) continue;\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k];\n            int nc = c + dc[k];\n            if (A[nr][nc] >= 0 && seen[nr][nc] < 0) {\n                seen[nr][nc] = seen[r][c] + 1;\n                qr.push(nr);\n                qc.push(nc);\n            }\n        }\n    }\n    leftCnt += cnt;\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &T);\n    memset(A, 255, sizeof(A));\n    memset(B, 255, sizeof(B));\n    for (int i = 1; i <= n; ++i) {\n        while (getchar() != '\\n');\n        for (int j = 1; j <= n; ++j) {\n            int ch = getchar();\n            if (ch >= '0' && ch <= '9') A[i][j] = ch - '0';\n            if (ch == 'Z') {\n                startR = i;\n                startC = j;\n            }\n        }\n    }\n    bfsFromStart(startR, startC);\n    while (getchar() != '\\n');\n    for (int i = 1; i <= n; ++i) {\n        while (getchar() != '\\n');\n        for (int j = 1; j <= n; ++j) {\n            int ch = getchar();\n            if (ch >= '0' && ch <= '9') B[i][j] = ch - '0';\n            for (int k = 0; k < B[i][j]; ++k)\n                things[i][j].push_back(rightCnt++);\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (F[i][j] < 0) F[i][j] = INF;\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (A[i][j] > 0) addMonsterEdges(i, j, A[i][j]);\n    printf(\"%d\\n\", hopcroftKarp());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nsys.setrecursionlimit(10000)\n\nINF = 1000000000\nMAXN = 2000\ndr = [0, -1, 0, 1]\ndc = [1, 0, -1, 0]\n\nn = 0\nT = 0\nstartR = 0\nstartC = 0\nA = [[-1] * 12 for _ in range(12)]\nB = [[-1] * 12 for _ in range(12)]\nF = [[-1] * 12 for _ in range(12)]\nthings = [[[] for _ in range(12)] for _ in range(12)]\ne = []  # list of lists for left nodes (0-indexed)\nleftCnt = 0\nrightCnt = 0\n\npairU = [0] * (MAXN + 1)\npairV = [0] * (MAXN + 1)\ndistHK = [0] * (MAXN + 1)\n\n\ndef bfsHK():\n    q = deque()\n    for u in range(1, leftCnt + 1):\n        if pairU[u] == 0:\n            distHK[u] = 0\n            q.append(u)\n        else:\n            distHK[u] = INF\n    distHK[0] = INF\n    while q:\n        u = q.popleft()\n        if distHK[u] < distHK[0]:\n            for v in e[u - 1]:  # v is 0-indexed right node\n                v1 = v + 1\n                if distHK[pairV[v1]] == INF:\n                    distHK[pairV[v1]] = distHK[u] + 1\n                    q.append(pairV[v1])\n    return distHK[0] != INF\n\n\ndef dfsHK(u):\n    if u == 0:\n        return True\n    for v in e[u - 1]:\n        v1 = v + 1\n        if distHK[pairV[v1]] == distHK[u] + 1:\n            if dfsHK(pairV[v1]):\n                pairV[v1] = u\n                pairU[u] = v1\n                return True\n    distHK[u] = INF\n    return False\n\n\ndef hopcroftKarp():\n    global pairU, pairV\n    for i in range(leftCnt + 1):\n        pairU[i] = 0\n    for i in range(rightCnt + 1):\n        pairV[i] = 0\n    ans = 0\n    while bfsHK():\n        for u in range(1, leftCnt + 1):\n            if pairU[u] == 0 and dfsHK(u):\n                ans += 1\n    return ans\n\n\ndef bfsFromStart(sr, sc):\n    global F\n    F = [[-1] * 12 for _ in range(12)]\n    qr = deque()\n    qc = deque()\n    qr.append(sr)\n    qc.append(sc)\n    F[sr][sc] = 0\n    while qr:\n        r = qr.popleft()\n        c = qc.popleft()\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if A[nr][nc] >= 0 and F[nr][nc] < 0:\n                F[nr][nc] = F[r][c] + 1\n                qr.append(nr)\n                qc.append(nc)\n\n\ndef addMonsterEdges(sr, sc, cnt):\n    global leftCnt, e\n    seen = [[-1] * 12 for _ in range(12)]\n    qr = deque()\n    qc = deque()\n    qr.append(sr)\n    qc.append(sc)\n    seen[sr][sc] = 0\n    start_left = leftCnt  # index of first new left node (0-indexed)\n    for _ in range(cnt):\n        e.append([])\n        leftCnt += 1\n    while qr:\n        r = qr.popleft()\n        c = qc.popleft()\n        lim = min(T, F[r][c])\n        if seen[r][c] > lim:\n            continue\n        for thing in things[r][c]:\n            for k in range(cnt):\n                e[start_left + k].append(thing)\n        if seen[r][c] == lim:\n            continue\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if A[nr][nc] >= 0 and seen[nr][nc] < 0:\n                seen[nr][nc] = seen[r][c] + 1\n                qr.append(nr)\n                qc.append(nc)\n\n\ndef main():\n    global n, T, startR, startC, A, B, things, rightCnt, leftCnt, e, F\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    n = int(first[0])\n    T = int(first[1])\n    # read grid A\n    for i in range(1, n + 1):\n        line = data[i]\n        for j, ch in enumerate(line[:n], start=1):\n            if ch.isdigit():\n                A[i][j] = int(ch)\n            elif ch == 'Z':\n                startR = i\n                startC = j\n    # read grid B\n    for i in range(1, n + 1):\n        line = data[n + i]  # data[0] is first line, data[1..n] are A, data[n+1..2n] are B\n        for j, ch in enumerate(line[:n], start=1):\n            if ch.isdigit():\n                B[i][j] = int(ch)\n            for _ in range(B[i][j]):\n                things[i][j].append(rightCnt)\n                rightCnt += 1\n    # BFS from start\n    bfsFromStart(startR, startC)\n    # set unreachable cells to INF\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if F[i][j] < 0:\n                F[i][j] = INF\n    # add monster edges\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if A[i][j] > 0:\n                addMonsterEdges(i, j, A[i][j])\n    # compute maximum matching\n    result = hopcroftKarp()\n    print(result)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\