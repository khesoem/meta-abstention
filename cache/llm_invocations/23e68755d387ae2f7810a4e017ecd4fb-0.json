nt u = q.front(); q.pop();\n        inq[u] = false;\n        for (int i = adj[u]; ~i; i = edges[i].next) {\n            int v = edges[i].to;\n            if (edges[i].cap > edges[i].flow && dist[v] > dist[u] + edges[i].cost) {\n                dist[v] = dist[u] + edges[i].cost;\n                prev_idx[v] = i;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return prev_idx[t] != -1;\n}\n\nint mcmf(int src, int dst, int &cost) {\n    int flow = 0;\n    cost = 0;\n    while (find_path(src, dst)) {\n        int bottleneck = INF;\n        for (int i = prev_idx[dst]; ~i; i = prev_idx[edges[i^1].to])\n            bottleneck = min(bottleneck, edges[i].cap - edges[i].flow);\n        for (int i = prev_idx[dst]; ~i; i = prev_idx[edges[i^1].to]) {\n            edges[i].flow += bottleneck;\n            edges[i^1].flow -= bottleneck;\n            cost += edges[i].cost * bottleneck;\n        }\n        flow += bottleneck;\n    }\n    return flow;\n}\n\nint idx(int x, int y) { return (x-1)*50 + y; }\n\nint main() {\n    int src = 101*55, dst = src + 1;\n    n = read_int(), m = read_int(), k = read_int(), c = read_int(), d = read_int();\n    int val;\n    setup(dst + 1);\n    for (int i = 1; i <= k; i++) {\n        val = read_int();\n        link(src, val, 1, 0);\n    }\n    for (int col = 1; col <= 50; col++) {\n        for (int row = 1; row <= 103; row++) {\n            int u = idx(row, col), v = idx(row+1, col);\n            link(u, v, INF, c);\n        }\n    }\n    for (int i = 0; i < 102; i++) {\n        int node = i*50 + 1;\n        link(node, dst, INF, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        int u = read_int(), v = read_int();\n        for (int row = 1; row <= 102; row++) {\n            int a = idx(row, u), a1 = idx(row+1, u);\n            int b1 = idx(row+1, v), b = idx(row, v);\n            for (int layer = 0; layer < 50; layer++) {\n              