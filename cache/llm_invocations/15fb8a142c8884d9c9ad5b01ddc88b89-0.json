 return a * modInv(b); }\n\nconst int MAX_N = 1024000;\nModInt fact[MAX_N], invFact[MAX_N];\n\nvoid initFactorials(int n = MAX_N) {\n    fact[0] = ModInt(1);\n    invFact[0] = ModInt(1);\n    for (int i = 1; i < n; ++i) {\n        fact[i] = fact[i-1] * ModInt(i);\n        invFact[i] = invFact[i-1] / ModInt(i);\n    }\n}\n\nModInt comb(int n, int r) {\n    if (r < 0 || r > n) return ModInt(0);\n    return fact[n] * invFact[r] * invFact[n - r];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    vector<vector<ModInt>> pers(6, vector<ModInt>(6));\n    \n    // Read N\n    int N;\n    cin >> N;\n    int s = 3 - (N + 1) / 2;\n    \n    for (int i = 0; i < s; ++i) {\n        pers[i][i] = ModInt(1);\n    }\n    \n    for (int i = s; i < s + N; ++i) {\n        for (int j = s; j < s + N; ++j) {\n            int p;\n            cin >> p;\n            pers[i][j] = ModInt(p) / ModInt(100);\n        }\n    }\n    \n    for (int i = s + N; i < 6; ++i) {\n        pers[i][i] = ModInt(1);\n    }\n\n    // Generate all permutations of {0,0,0,1,1,1}\n    vector<int> v = {0, 0, 0, 1, 1, 1};\n    map<int, int> permMap;\n    int id = 0;\n    do {\n        int mask = 0;\n        for (int k = 0; k < 6; ++k) {\n            if (v[k]) mask |= (1 << k);\n        }\n        permMap[mask] = id++;\n    } while (next_permutation(v.begin(), v.end()));\n\n    // Solve for upper and lower parts\n    auto solve = [&](int offset) -> vector<ModInt> {\n        vector<ModInt> result(1 << 20, ModInt(0));\n        for (int mask = 0; mask < (1 << 18); ++mask) {\n            vector<vector<int>> haves(3, vector<int>(6, 0));\n            ModInt prob(1);\n            \n            for (int i = 0; i < 3; ++i) {\n                for (int j = 0; j < 6; ++j) {\n                    int idx = i * 6 + j;\n                    if (mask & (1 << idx)) {\n                        haves[i][j] = 1;\n                        prob *= pers[offset + i][j];\n                    } else {\n              