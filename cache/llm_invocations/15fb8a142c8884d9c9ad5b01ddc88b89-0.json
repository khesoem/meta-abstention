dd__(self, other):\n        return ModInt((self.val + other.val) % MOD)\n    \n    def __sub__(self, other):\n        return ModInt((self.val - other.val + MOD) % MOD)\n    \n    def __mul__(self, other):\n        return ModInt((self.val * other.val) % MOD)\n    \n    def __truediv__(self, other):\n        return self * modInv(other)\n    \n    def __iadd__(self, other):\n        self.val = (self.val + other.val) % MOD\n        return self\n    \n    def __isub__(self, other):\n        self.val = (self.val - other.val + MOD) % MOD\n        return self\n    \n    def __imul__(self, other):\n        self.val = (self.val * other.val) % MOD\n        return self\n    \n    def __eq__(self, other):\n        return self.val == other.val\n    \n    def __bool__(self):\n        return self.val != 0\n\ndef modPow(base, exp):\n    res = ModInt(1)\n    while exp > 0:\n        if exp & 1:\n            res *= base\n        base *= base\n        exp >>= 1\n    return res\n\ndef modInv(a):\n    return modPow(a, MOD - 2)\n\nMAX_N = 1024000\nfact = [ModInt(0)] * MAX_N\ninvFact = [ModInt(0)] * MAX_N\n\ndef initFactorials(n=MAX_N):\n    fact[0] = ModInt(1)\n    invFact[0] = ModInt(1)\n    for i in range(1, n):\n        fact[i] = fact[i-1] * ModInt(i)\n        invFact[i] = invFact[i-1] / ModInt(i)\n\ndef comb(n, r):\n    if r < 0 or r > n:\n        return ModInt(0)\n    return fact[n] * invFact[r] * invFact[n - r]\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    \n    N = int(data[idx]); idx += 1\n    s = 3 - (N + 1) // 2\n    \n    pers = [[ModInt(0) for _ in range(6)] for _ in range(6)]\n    \n    for i in range(s):\n        pers[i][i] = ModInt(1)\n    \n    for i in range(s, s + N):\n        for j in range(s, s + N):\n            p = int(data[idx]); idx += 1\n            pers[i][j] = ModInt(p) / ModInt(100)\n    \n    for i in range(s + N, 6):\n        pers[i][i] = ModInt(1)\n    \n    # Generate all permutations of {0,0,0,1,1,1}\n    v = [0, 0