air:\n<original_code>\n#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing ll = long long;\nusing ld = long double;\n\nconstexpr ld eps = 1e-6;\nconstexpr int INF = 1000000000;\nconstexpr int MAXN = 21;\nconstexpr int MAXMASK = 1 << MAXN;\n\nbool equal(ld a, ld b) { return std::abs(a - b) < eps; }\n\nint n, N, k, mmask;\nll binom[MAXN][MAXN];\nld prob[MAXN];\nld subsetSum[MAXMASK];\nint originalIndex[MAXN], popcountArr[MAXMASK];\nld result[MAXN];\nld coefficients[MAXN];\n\nvoid outputResult() {\n    std::cout.precision(20);\n    for (int i = 0; i < N; ++i) {\n        std::cout << result[i];\n        std::cout << (i == N - 1 ? '\\n' : ' ');\n    }\n}\n\nint main() {\n    std::cin >> n >> k;\n    N = n;\n    for (int i = 0; i < n; ++i) std::cin >> prob[i];\n\n    for (int i = 0; i < n; ++i) {\n        if (equal(prob[i], 1.0)) {\n            result[i] = 1.0;\n            outputResult();\n            return 0;\n        }\n    }\n\n    for (int i = 0; i < n; ++i) originalIndex[i] = i;\n\n    for (int i = 0; i < n; ++i) {\n        if (equal(prob[i], 0.0)) {\n            for (int j = i; j < n - 1; ++j) {\n                prob[j] = prob[j + 1];\n                originalIndex[j] = originalIndex[j + 1];\n            }\n            --n;\n            --i;\n        }\n    }\n\n    if (n <= k) {\n        for (int i = 0; i < n; ++i) result[originalIndex[i]] = 1.0;\n        outputResult();\n        return 0;\n    }\n\n    binom[0][0] = 1;\n    for (int i = 1; i < MAXN; ++i) {\n        binom[i][0] = 1;\n        for (int j = 1; j < MAXN; ++j)\n            binom[i][j] = binom[i - 1][j - 1] + binom[i - 1][j];\n    }\n\n    for (int j = k - 1; j >= 1; --j) {\n        coefficients[j] = 1;\n        for (int i = 1; i <= k - 1 - j; ++i)\n            coefficients[j] -= binom[n - j - 1][i];\n    }\n\n    mmask = 1 << n;\n    for (int mask = 0; mask < mmask; ++mask) {\n        subsetSum[mask] = 0;\n        popcountArr[mask] = 0;\n        for (int i = 0; i < n; ++i)\n            if (mask 