       Arrays.fill(dis, Long.MAX_VALUE / 2);\n        q.add(T);\n        dis[T] = 0;\n        mark[T] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            mark[x] = false;\n            for (int i = head[x]; i != 0; i = nxt[i]) {\n                int y = to[i];\n                if (w[i ^ 1] != 0 && dis[y] > dis[x] + c[i ^ 1]) {\n                    dis[y] = dis[x] + c[i ^ 1];\n                    if (!mark[y]) {\n                        q.add(y);\n                        mark[y] = true;\n                    }\n                }\n            }\n        }\n        return dis[S] < 1e18;\n    }\n\n    static int dfs(int x, int lim, long[] cost) {\n        int flow = 0;\n        mark[x] = true;\n        if (x == T) return lim;\n        for (int i = head[x]; i != 0; i = nxt[i]) {\n            int y = to[i];\n            if (w[i] == 0 || mark[y]) continue;\n            if (dis[x] != dis[y] + c[i]) continue;\n            int t = dfs(y, Math.min(w[i], lim - flow), cost);\n            w[i] -= t;\n            w[i ^ 1] += t;\n            flow += t;\n            cost[0] += (long) t * c[i];\n            if (flow == lim) return lim;\n        }\n        return flow;\n    }\n\n    static long costFlow() {\n        long cost = 0;\n        while (spfa()) {\n            do {\n                Arrays.fill(mark, false);\n                dfs(S, INF, new long[]{cost});\n            } while (mark[T]);\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int lim = 101;\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            addEdge(S, x, 1, 0);\n        }\n\n        for (int i = 0; i < lim; i++) {\n            addEdge(i * n + T, T, k, c * i);\n        }\n\n        for (int i = 0; i < n;