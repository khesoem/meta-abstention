rk, false);\n        Arrays.fill(dis, Long.MAX_VALUE / 2);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(T);\n        dis[T] = 0;\n        mark[T] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            mark[x] = false;\n            for (int i = head[x]; i != 0; i = nxt[i]) {\n                int y = to[i];\n                if (w[i ^ 1] > 0 && dis[y] > dis[x] + c[i ^ 1]) {\n                    dis[y] = dis[x] + c[i ^ 1];\n                    if (!mark[y]) {\n                        q.offer(y);\n                        mark[y] = true;\n                    }\n                }\n            }\n        }\n        return dis[S] < 1e18;\n    }\n\n    static int dfs(int x, int lim, long[] costRef) {\n        int flow = 0;\n        mark[x] = true;\n        if (x == T) return lim;\n        for (int i = head[x]; i != 0; i = nxt[i]) {\n            int y = to[i];\n            if (w[i] == 0 || mark[y]) continue;\n            if (dis[x] != dis[y] + c[i]) continue;\n            int t = dfs(y, Math.min(w[i], lim - flow), costRef);\n            w[i] -= t;\n            w[i ^ 1] += t;\n            flow += t;\n            costRef[0] += (long) t * c[i];\n            if (flow == lim) return lim;\n        }\n        return flow;\n    }\n\n    static long costFlow() {\n        int flow = 0;\n        long cost = 0;\n        while (spfa()) {\n            do {\n                Arrays.fill(mark, false);\n                long[] costRef = new long[]{cost};\n                flow += dfs(S, INF, costRef);\n                cost = costRef[0];\n            } while (mark[T]);\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int lim = 101;\n\n        for (int i = 0; i < k; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            addEdge(S, x, 1, 0);\n        }\n\n        for (int i = 0; i < lim; i++) {\n            addEdge(i * n, T, k, c * i);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < lim - 1; j++) {\n                addEdge(i + j * n, i + (j + 1) * n, k, 0);\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j < lim - 1; j++) {\n                for (int t = k - 1; t >= 0; t--) {\n                    int cost = d * ((t << 1) | 1);\n                    addEdge(x + j * n, y + (j + 1) * n, 1, cost);\n                    addEdge(y + j * n, x + (j + 1) * n, 1, cost);\n                }\n            }\n        }\n\n        System.out.println(costFlow());\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.536738616588991e-07, -1.1920928244535389e-07, 0.0, -4.5298504119273275e-05, -0.0002889215829782188, -1.1920928244535389e-07, -0.5759395360946655, -0.011151371523737907, -1.1920928244535389e-07, 0.0, -1.6689286894688848e-06, -0.00013040646445006132, -2.8609820219571702e-05, 0.0, -1.0013530300057027e-05, -0.01826900988817215, -0.0003592322755139321, -0.005685349460691214, -0.0002661589242052287, -1.1920928244535389e-07, -0.0007556205382570624, -7.974783511599526e-05, -1.1920928244535389e-07, -3.3378546504536644e-06, -1.883488948806189e-05, -0.005534326657652855, 0.0, -1.1920922133867862e-06, -1.2993727978027891e-05, 0.0, -0.00010072677832795307, -2.264974000354414e-06, -2.50339189733495e-06, -9.65