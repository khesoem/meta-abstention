rn a; return gcd(b, a%b);}\nint pow_mod(int a,int b){\n    int ans=1;\n    while(b){\n        if(b&1)ans=ans*(ll)a%mod;\n        a=(ll)a*a%mod;b>>=1;\n    }\n    return ans;\n}\n\nconst int M = 105;\nint src[51], id[51][M];\npii edge_list[51];\nint cnt, head[N], d[N], p[N], vis[N];\nstruct node{\n    int v, c, w, next;\n}g[N<<2];\nvoid add_edge(int a, int b, int c, int w){\n    g[cnt] = {b, c, w, head[a]}, head[a] = cnt++;\n    g[cnt] = {a, 0, -w, head[b]}, head[b] = cnt++;\n}\nbool shortest_path(int s, int t){\n    rep(i, 0, t+1) d[i] = inf, vis[i] = 0;\n    queue<int>q;\n    q.push(s); d[s] = 0;\n    while(!q.empty()){\n        int u = q.front(); q.pop(); vis[u] = 0;\n        for(int i = head[u]; ~i; i = g[i].next){\n            int j = g[i].v;\n            if(g[i].c && d[j] > d[u] + g[i].w){\n                d[j] = d[u] + g[i].w;\n                p[j] = i;\n                if(!vis[j]){\n                    vis[j] = 1;\n                    q.push(j);\n                }\n            }\n        }\n    }\n    return d[t] < inf;\n}\nint max_flow(int s, int t){\n    int ans = 0, res = 0;\n    while(shortest_path(s, t)){\n        int x = t, f = inf;\n        while(x != s){\n            Min(f, g[p[x]].c), x = g[p[x] ^ 1].v;\n        }\n        ans += f * d[t];\n        res += f;\n        x = t;\n        while(x != s){\n            g[p[x]].c -= f, g[p[x] ^ 1].c += f;\n            x = g[p[x] ^ 1].v;\n        }\n    }\n    DBG(res)\n    return ans;\n}\nint main(){\n    int j,k,i,T,ca=0, K = 0, m, n;\n    int C,D;\n    cin >> n >> m >> K >> C >> D;\n    rep(i,0,K) { cin >> src[i]; src[i]--; }\n    rep(i,0,m){\n        cin >> edge_list[i].x >> edge_list[i].y;\n        edge_list[i].x--; edge_list[i].y--;\n    }\n    int sz = 0;\n    cnt = 0;\n    memset(head, -1, sizeof(head));\n    rep(i,0,n) rep(j,0,M) id[i][j] = sz++;\n    int s = sz, t = s + 1;\n    rep(i,0,K){\n        add_edge(s, id[src[i]][0], 1, 0);\n    }\n    rep(i,0,M) add_edge(id[0][i], t, K, C * i);\n    rep(i,0,n