[c100 + 1][2];\n        for (int i = 0; i <= c50; i++) {\n            for (int j = 0; j <= c100; j++) {\n                ns[i][j][0] = new Node(i, j, 0);\n                ns[i][j][1] = new Node(i, j, 1);\n            }\n        }\n        for (int i = 0; i <= c50; i++) {\n            for (int j = 0; j <= c100; j++) {\n                int p50c = Math.min(k / 50, i);\n                int p100c = Math.min(k / 100, j);\n                for (int x = p100c; x >= 0; x--) {\n                    for (int y = Math.min(p50c, (k - 100 * x) / 50); y >= 0; y--) {\n                        if ( 0 == y && 0 == x) continue;\n                        ns[i][j][0].s.add(ns[i - y][j - x][1]);\n                        ns[i - y][j - x][1].s.add(ns[i][j][0]);\n//                        System.out.println(\"(\" + i + \", \" + j + \", 0) -> (\" + (i - y) + \", \" + (j - x) + \", 1)\");\n//                        System.out.println(\"(\" + (i - y) + \", \" + (j - x) + \", 1) -> (\" + i + \", \" + j + \", 0)\");\n                    }\n                }\n            }\n        }\n        ArrayDeque<Node> q = new ArrayDeque<>();\n        ns[c50][c100][0].n = 1;\n        ns[c50][c100][0].am = 1;\n        q.add(ns[c50][c100][0]);\n        while (!q.isEmpty()) {\n            Node cur = q.pop();\n            for (Node  ch: cur.s) {\n                if (ch.n == 0 || ch.n == cur.n + 1) {\n                    long p1 = c[cur.b == 0 ? cur.c50 : c50 - cur.c50][Math.abs(cur.c50 - ch.c50)];\n                    long p2 = c[cur.b == 0 ? cur.c100 : c100 - cur.c100][Math.abs(cur.c100 - ch.c100)];\n                    ch.am = (ch.am + (cur.am * (p1 * p2) % mod) % mod) % mod;\n                    if (ch.n == 0) {\n                        ch.n = cur.n + 1;\n                        q.add(ch);\n                    }\n//                    System.out.println(\"p1: \" + p1 + \", i: \" + (cur.b == 0 ? cur.c50 : c50 - cur.c50) + \", j:\" +\n//                            (Math.abs(cur.c50 - ch.c50)));\n//               