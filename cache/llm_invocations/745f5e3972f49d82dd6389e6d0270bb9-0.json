t[i] = (fact[i-1] * i) % MOD;\n        invFact[i] = pow_mod(fact[i], MOD - 2);\n    }\n}\n\nlong long nCr(int r, int n) {\n    if (r < 0 || r > n) return 0;\n    return (fact[n] * invFact[r] % MOD) * invFact[n - r] % MOD;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    int N;\n    long long K;\n    iss >> N >> K;\n    \n    if (K >= N) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    int C = N - (int)K;\n    buildFactorials(200000);\n    \n    long long ans = pow_mod(C, N);\n    for (int k = 1; k < C; k++) {\n        long long term = pow_mod(C - k, N);\n        term = term * nCr(k, C) % MOD;\n        if ((k & 1) == 1) {\n            ans = (ans - term + MOD) % MOD;\n        } else {\n            ans = (ans + term) % MOD;\n        }\n    }\n    ans = ans * nCr(C, N) % MOD;\n    if (K > 0) {\n        ans = ans * 2 % MOD;\n    }\n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002674698771443218, -2.622600959512056e-06, -1.1920922133867862e-06, -0.001149589428678155, -1.1920928244535389e-07, -0.00017867876158561558, -6.198863957251888e-06, -5.960462772236497e-07, -2.3841855067985307e-07, -0.07291236519813538, -6.9141146923357155e-06, -0.0002636561985127628, -4.768360213347478e-06, -0.02479330077767372, -1.1920922133867862e-06, -0.0002040654799202457, -1.3470558769768104e-05, -0.001946580014191568, -0.002477435627952218, -0.06197601929306984, -2.3841855067985307e-07, -0.14641731977462769, -0.20141547918319702, -0.20146849751472473, -1.537788011773955e-05, -4.6491513785440475e-06, -1.0728830375228426e-06, -0.0025496138259768486, -5.960446742392378e-06, -1.2040065485052764e-05, -4.291525328881107e-06, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, -5.960462772236497e-07, -2.264974000354414e-06, -4.0531076592742465e-06, -1.4305104514278355e-06, -9.536738616588991e-07, -1.1920928244535389e-07, -0.6537977457046509, -0.126929000020027