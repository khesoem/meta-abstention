{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cmath>\n#include <algorithm>\n#include <map>\n\nusing namespace std;\n\nusing ll = long long;\n\nll mod_pow(ll base, int exp, int mod) {\n    ll result = 1;\n    base %= mod;\n    while (exp > 0) {\n        if (exp & 1) \n            result = (result * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, k, p;\n    cin >> n >> k >> p;\n\n    if (n % 2 == 1) {\n        cout << mod_pow(k, n, p) << '\\n';\n        return 0;\n    }\n\n    vector<ll> fact(n + 1), rfact(n + 1);\n    fact[0] = 1;\n    rfact[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        fact[i] = fact[i-1] * i % p;\n        rfact[i] = mod_pow(fact[i], p-2, p);\n    }\n\n    vector<vector<ll>> g(n + 1, vector<ll>(17, 0));\n    g[0][0] = 1;\n\n    for (int mask = 1; mask <= n; ++mask) {\n        if ((mask & n) != mask) continue;\n        \n        vector<int> bits;\n        for (int j = 0; j < 18; ++j) {\n            if (mask & (1 << j)) \n                bits.push_back(j);\n        }\n\n        if (bits.empty()) continue;\n\n        // Count subsets\n        int total_subsets = 1 << bits.size();\n        for (int subset = 1; subset < total_subsets; ++subset) {\n            int l = 0;\n            for (int j = 0; j < (int)bits.size(); ++j) {\n                if (subset & (1 << j)) {\n                    l ^= (1 << bits[j]);\n                }\n            }\n            for (int i = 1; i < 17; ++i) {\n                g[mask][i] = (g[mask][i] + rfact[l] * g[mask ^ l][i-1]) % p;\n            }\n        }\n    }\n\n    for (int i = 0; i <= n; ++i) {\n        for (int j = 0; j < 17; ++j) {\n            g[i][j] %= p;\n            if (g[i][j] < 0) g[i][j] += p;\n        }\n    }\n\n    ll ans = 0;\n    int upper = min(16, k);\n    for (int i = 1; i <= upper; ++i) {\n        ll term = fact[n] * g[n][i] % p;\n        term = term * fact[k] % p;\n        term = term * rfact[k - i] % p;\n        ans = (ans + term) % p;\n    }\n\n    ans = (mod_pow(k, n, p) - ans + p) % p;\n    cout << ans << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long mod_pow(long base, int exp, int mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) \n                result = (result * base) % mod;\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int p = Integer.parseInt(st.nextToken());\n\n        if (n % 2 == 1) {\n            System.out.println(mod_pow(k, n, p));\n            return;\n        }\n\n        long[] fact = new long[n + 1];\n        long[] rfact = new long[n + 1];\n        fact[0] = 1;\n        rfact[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            fact[i] = fact[i-1] * i % p;\n            rfact[i] = mod_pow(fact[i], p-2, p);\n        }\n\n        long[][] g = new long[n + 1][17];\n        g[0][0] = 1;\n\n        for (int mask = 1; mask <= n; ++mask) {\n            if ((mask & n) != mask) continue;\n            \n            List<Integer> bits = new ArrayList<>();\n            for (int j = 0; j < 18; ++j) {\n                if ((mask & (1 << j)) != 0) \n                    bits.add(j);\n            }\n\n            if (bits.isEmpty()) continue;\n\n            // Count subsets\n            int total_subsets = 1 << bits.size();\n            for (int subset = 1; subset < total_subsets; ++subset) {\n                int l = 0;\n                for (int j = 0; j < bits.size(); ++j) {\n                    if ((subset & (1 << j)) != 0) {\n                        l ^= (1 << bits.get(j));\n                    }\n                }\n                for (int i = 1; i < 17; ++i) {\n                    g[mask][i] = (g[mask][i] + rfact[l] * g[mask ^ l][i-1]) % p;\n                }\n            }\n        }\n\n        for (int i = 0; i <= n; ++i) {\n            for (int j = 0; j < 17; ++j) {\n                g[i][j] %= p;\n                if (g[i][j] < 0) g[i][j] += p;\n            }\n        }\n\n        long ans = 0;\n        int upper = Math.min(16, k);\n        for (int i = 1; i <= upper; ++i) {\n            long term = fact[n] * g[n][i] % p;\n            term = term * fact[k] % p;\n            term = term * rfact[k - i] % p;\n            ans = (ans + term) % p;\n        }\n\n        ans = (mod_pow(k, n, p) - ans + p) % p;\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs":