 = new Scanner(System.in);\n        long n = sc.nextLong();\n        long m = sc.nextLong();\n        long P = sc.nextLong();\n        MOD = P;\n        int N = (int)(n + 1);\n        \n        long[] fact = new long[N + 2];\n        long[] invf = new long[N + 2];\n        fact[0] = 1;\n        for (int i = 1; i <= N + 1; i++) fact[i] = fact[i-1] * i % P;\n        invf[N + 1] = modPow(fact[N + 1], P - 2, P);\n        for (int i = N + 1; i >= 1; i--) invf[i-1] = invf[i] * i % P;\n        \n        // comb function\n        java.util.function.BiFunction<Integer, Integer, Long> comb = (x, y) -> {\n            if (x < y || y < 0) return 0L;\n            return fact[x] * invf[y] % P * invf[x - y] % P;\n        };\n        \n        // sum function\n        java.util.function.Function<Integer, Long> sum = x -> (long)x * (x + 1) / 2;\n        \n        long[] f = new long[(int)(m + 1)];\n        long[] g = new long[(int)(m + 1)];\n        f[0] = 1;\n        for (int i = 1; i <= m; i++) {\n            for (int j = 0; j < i; j++) {\n                long c = comb.apply(i - 1, j);\n                long fj = f[j], fij = f[i - 1 - j];\n                long gj = g[j], gij = g[i - 1 - j];\n                f[i] = (f[i] + fj * fij % P * c) % P;\n                long term1 = (gj * fij % P + fj * gij % P) * (i + 1) % P;\n                long term2 = fj * fij % P * (sum.apply(j) + sum.apply(i - 1 - j)) % P;\n                g[i] = (g[i] + (term1 + term2) % P * c) % P;\n            }\n            f[i] = f[i] * (i + 1) % P;\n        }\n        \n        long[][] F = new long[(int)(m + 1)][(int)(n + 1)];\n        long[][] G = new long[(int)(m + 1)][(int)(n + 1)];\n        for (long[] row : F) Arrays.fill(row, -1);\n        for (long[] row : G) Arrays.fill(row, -1);\n        \n        // getF as a recursive function\n        java.util.function.BiFunction<Integer, Integer, Long> getF = new java.util.function.BiFunction<Integer, Integer, Long>() {\n            @Override\n            public Long apply(Integer i, Integer j) {\n                if (i == 0) return 1L;\n                if (j < i) return 0L;\n                if (F[i][j] != -1) return F[i][j];\n                long res = this.apply(i, j - 1);\n                for (int l = 1; l <= i; l++) {\n                    long c = comb.apply(i, l);\n                    res = (res + this.apply(i - l, j - 1 - l) * f[l] % P * c) % P;\n                }\n                F[i][j] = res;\n                return res;\n            }\n        };\n        \n        java.util.function.BiFunction<Integer, Integer, Long> getG = new java.util.function.BiFunction<Integer, Integer, Long>() {\n            @Override\n            public Long apply(Integer i, Integer j) {\n                if (i == 0) return 0L;\n                if (j < i) return 0L;\n                if (G[i][j] != -1) return G[i][j];\n                long res = this.apply(i, j - 1);\n                for (int l = 1; l <= i; l++) {\n                    long c = comb.apply(i, l);\n                    long fl = f[l], gl = g[l];\n                    long Fil = getF.apply(i - l, j - 1 - l);\n                    long Gil = this.apply(i - l, j - 1 - l);\n                    res = (res + (Gil * fl % P + Fil * gl % P) * c) % P;\n                }\n                G[i][j] = res;\n                return res;\n            }\n        };\n        \n        System.out.println(getG.apply((int)m, (int)n));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.7656173e-05, 0.0, -1.1920928e-07, -6.592056e-05, -0.00045336934, -2.145765e-06, -0.12825173, -3.2905607, -0.00017951308, -4.7683704e-07, -0.002123484, -0.0025095418, -0.0032217999, -0.040660582, -0.017191324, -2.948268, -0.6983384, -0.25199547, -7.6293654e-06, -0.027568199, -0.0015562577, -1.7022355, -0.8260346, -1.1920928e-07, -1.03711545e-05, 0.0, -3.576278e-07, -1.7404405e-05, -0.04858767, -2.3841855e-07, -0.00013100242, -8.344647e-07, -3.81469e-06, -1.1920928e-07, -2.145765e-06, -0.0