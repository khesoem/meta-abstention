es[idx].cost) {\n                dist[v] = dist[u] + edges[idx].cost;\n                prev_edge_idx[v] = idx;\n                min_cap[v] = min(min_cap[u], edges[idx].capacity - edges[idx].flow);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (dist[dst] == INF) return {0, 0};\n\n    int augment = min_cap[dst];\n    int cur = dst;\n    while (cur != src) {\n        int eid = prev_edge_idx[cur];\n        edges[eid].flow += augment;\n        edges[eid ^ 1].flow -= augment;\n        cur = edges[eid].from;\n    }\n\n    return {augment, augment * dist[dst]};\n}\n\npii min_cost_flow(int n) {\n    int total_flow = 0, total_cost = 0;\n    while (true) {\n        pii result = spfa(n);\n        if (result.first == 0) break;\n        total_flow += result.first;\n        total_cost += result.second;\n    }\n    return {total_flow, total_cost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        adj_graph[u].push_back(v);\n        adj_graph[v].push_back(u);\n    }\n\n    src = 0;\n    dst = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            connect(t * n + i, (t + 1) * n + i, k, 0);\n            for (int nb : adj_graph[i]) {\n                for (int cp = 1; cp <= k; ++cp) {\n                    connect(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        if (freq[i]) {\n            connect(src, i, freq[i], 0);\n        }\n    }\n\n    for (int t = 0; t <= 100; ++t) {\n        connect(t * n + 1, dst, k, c * t);\n    }\n\n    cout << min_cost_flow(dst).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAXN = 1000002;\n    static final int INF = 1000000000;\n\n    static int[] freq = new int[MAXN];\n    static int src, dst;\n    static Vector<Integer>[] adj_graph = new Vector[MAXN];\n\n    static class Edge {\n        int from, to, flow, capacity, cost;\n        Edge(int f, int t, int fl, int cp, int cs) {\n            from = f; to = t; flow = fl; capacity = cp; cost = cs;\n        }\n    }\n\n    static Vector<Edge> edges = new Vector<>();\n    static Vector<Integer>[] node_adj = new Vector[MAXN];\n\n    static void connect(int u, int v, int cap, int cost) {\n        edges.add(new Edge(u, v, 0, cap, cost));\n        node_adj[u].add(edges.size() - 1);\n        edges.add(new Edge(v, u, 0, 0, -cost));\n        node_adj[v].add(edges.size() - 1);\n    }\n\n    static int[] dist = new int[MAXN];\n    static int[] inq = new int[MAXN];\n    static int[] min_cap = new int[MAXN];\n    static int[] prev_edge_idx = new int[MAXN];\n\n    static class Pair {\n        int first, second;\n        Pair(int f, int s) { first = f; second = s; }\n    }\n\n    static Pair spfa(int n) {\n        Arrays.fill(dist, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(src);\n        dist[src] = 0;\n        inq[src] = 1;\n        min_cap[src] = INF;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = 0;\n            for (int idx : node_adj[u]) {\n                Edge edge = edges.get(idx);\n                int v = edge.to;\n                if (edge.capacity > edge.flow && dist[v] > dist[u] + edge.cost) {\n                    dist[v] = dist[u] + edge.cost;\n                    prev_edge_idx[v] = idx;\n                    min_cap[v] = Math.min(min_cap[u], edge.capacity - edge.flow);\n                    if (inq[v] == 0) {\n                        q.offer(v);\n                        inq[v] = 1;\n                    }\n                }\n            }\n        }\n\n        if (dist[dst] == INF) return new Pair(0, 0);\n\n        int augment = min_cap[dst];\n        int cur = dst;\n        while (cur != src) {\n            int eid = prev_edge_idx[cur];\n            edges.get(eid).flow += augment;\n            edges.get(eid ^ 1).flow -= augment;\n            cur = edges.get(eid).from;\n        }\n\n        return new Pair(augment, augment * dist[dst]);\n    }\n\n    static Pair min_cost_flow(int n) {\n        int total_flow = 0, total_cost = 0;\n        while (true) {\n            Pair result = spfa(n);\n            if (result.first == 0) break;\n            total_flow += result.first;\n            total_cost += result.second;\n        }\n        return new Pair(total_flow, total_cost);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        for (int i = 0; i < MAXN; ++i) {\n            adj_graph[i] = new Vector<>();\n            node_adj[i] = new Vector<>();\n        }\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; ++i) {\n            int x = Integer.parseInt(st.nextToken());\n            freq[x]++;\n        }\n\n        for (int i = 0; i < m; ++i) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            adj_graph[u].add(v);\n            adj_graph[v].add(u);\n        }\n\n        src = 0;\n        dst = 100 * n + n + 1;\n\n        for (int t = 0; t < 100; ++t) {\n            for (int i = 1; i <= n; ++i) {\n                connect(t * n + i, (t + 1) * n + i, k, 0);\n                for (int nb : adj_graph[i]) {\n                    for (int cp = 1; cp <= k; ++cp) {\n                        connect(t * n + i, (t + 1) * n + nb, 1, d * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; ++i) {\n            if (freq[i] > 0) {\n                connect(src, i, freq[i], 0);\n            }\n        }\n\n        for (int t = 0; t <= 100; ++t) {\n            connect(t * n + 1, dst, k, c * t);\n        }\n\n        System.out.println(min_cost_flow(dst).second);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010942813969450071, -1.5497195136049413e-06, -8.344646857949556e-07, -0.001211028778925538, -7.259582343976945e-05, -0.2811550498008728, -1.6005034446716309, -0.00045944625162519515, -6.210611172718927e-05, -4.6491513785440475e-06, -0.0007657456444576383, -0.0002324311062693596, -7.152555099310121e-07, -4.005352093372494e-05, -0.00975756160914898, -0.00014053787162993103, -0.005989104975014925, -0.388529509305954, -0.0007126175914891064, -0.000386640167562291, -8.22540732769994e-06, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, -1.1920928244535389e-07, 0.0, -2.622600959512056e-06, 0.0, -1.311301275563892e-06, -1.4305104514278355e-06, -4.768370445162873e-07, -1.6689286894688848e-06, -2.3841855067985307e-07, -3.6954811548639555e-06, -2.455681169521995e-05, -6.9141146923357155e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, -1.1444026313256472e-05, -2.3841855067985307e-07, -1.0728830375228426e-06, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, -1.1205610462639015e-05, -2.3841855067985307e-07, -3.099436753473128e-06, -0.12692825496196747, -4.768370445162873e-07, -0.00026341783814132214,