{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cstring>\n#include <ctime>\n#include <cassert>\n#include <cmath>\n\nusing namespace std;\n\nusing i64 = long long;\nusing u64 = unsigned long long;\nusing f64 = long double;\nusing vi = vector<int>;\nusing vvi = vector<vi>;\n\n#define loop(i, a, b) for (int i = (a); i < (b); ++i)\n#define rloop(i, a, b) for (int i = (b) - 1; i >= (a); --i)\n#define len(c) ((int)(c).size())\n#define mkp make_pair\n#define eb emplace_back\n\nvoid solve(int n) {\n    int k;\n    cin >> k;\n\n    using T = double;\n    vector<T> p(n);\n    for (int i = 0; i < n; ++i)\n        cin >> p[i];\n\n    T dp[2][1 << n];\n    memset(dp, 0, sizeof(dp));\n\n    vector<char> ok(n, 0);\n    vi goods;\n    loop(i, 0, n) {\n        if (p[i] != 0) {\n            ok[i] = 1;\n            goods.eb(i);\n        }\n    }\n\n    dp[0][0] = 1.0;\n    int cur = 1;\n\n    vector<T> s(1 << n, 0.0);\n    s[0] = 1.0;\n    loop(mask, 1, 1 << n) {\n        int bit = __builtin_ctz(mask);\n        s[mask] = s[mask ^ (1 << bit)] - p[bit];\n    }\n\n    int m = min(len(goods), k);\n    loop(step, 0, m) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int idx : goods) {\n                if (mask & (1 << idx)) continue;\n                dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / s[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    loop(i, 0, n) {\n        if (!ok[i]) {\n            printf(\"%.12f\\n\", 0.0);\n        } else {\n            T res = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    res += dp[cur][mask];\n            }\n            printf(\"%.12f\\n\", (double)res);\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        while (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            solve(n, sc);\n        }\n    }\n\n    public static void solve(int n, Scanner sc) {\n        int k = sc.nextInt();\n        double[] p = new double[n];\n        for (int i = 0; i < n; ++i) {\n            p[i] = sc.nextDouble();\n        }\n\n        double[][] dp = new double[2][1 << n];\n        for (int i = 0; i < 2; ++i) {\n            Arrays.fill(dp[i], 0.0);\n        }\n\n        boolean[] ok = new boolean[n];\n        List<Integer> goods = new ArrayList<>();\n        for (int i = 0; i < n; ++i) {\n            if (p[i] != 0) {\n                ok[i] = true;\n                goods.add(i);\n            }\n        }\n\n        dp[0][0] = 1.0;\n        int cur = 1;\n\n        double[] s = new double[1 << n];\n        s[0] = 1.0;\n        for (int mask = 1; mask < (1 << n); ++mask) {\n            int bit = Integer.numberOfTrailingZeros(mask);\n            s[mask] = s[mask ^ (1 << bit)] - p[bit];\n        }\n\n        int m = Math.min(goods.size(), k);\n        for (int step = 0; step < m; ++step) {\n            Arrays.fill(dp[cur], 0.0);\n\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (Integer.bitCount(mask) != step) continue;\n\n                for (int idx : goods) {\n                    if ((mask & (1 << idx)) != 0) continue;\n                    dp[cur][mask ^ (1 << idx)] += dp[cur ^ 1][mask] * p[idx] / s[mask];\n                }\n            }\n\n            cur ^= 1;\n        }\n\n        cur ^= 1;\n        for (int i = 0; i < n; ++i) {\n            if (!ok[i]) {\n                System.out.printf(\"%.12f\\n\", 0.0);\n            } else {\n                double res = 0.0;\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    if ((mask & (1 << i)) != 0) {\n                        res += dp[cur][mask];\n                    }\n                }\n                System.out.printf(\"%.12f\\n\", res);\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013863079948350787, -1.4305104514278355e-06, -4.768370445162873e-07, -0.0003828269545920193, -2.253030106658116e-05, -0.3869478404521942, -0.07892455905675888, -1.0132738680113107e-05, -3.0874729418428615e-05, -0.0011342290090397, -0.020599007606506348, -8.427741704508662e-05, -5.960462772236497e-07, -8.189342770492658e-05, -0.14267870783805847, -0.00020430385484360158, -0.16126486659049988, -3.8742269680369645e-05, -0.000114911155833