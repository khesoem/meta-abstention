= p[0];\n            res[1] = e[1];\n            res[2] = e[0] + re[0];\n            res[3] = re[0];\n            return res;\n        }\n\n        public List<long[]> getEdges() {\n            int M = pos.size();\n            List<long[]> res = new ArrayList<>();\n            for (int i = 0; i < M; i++) {\n                res.add(getEdge(i));\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String[] line1 = br.readLine().trim().split(\" \");\n        int N = Integer.parseInt(line1[0]);\n        int M = 3;\n        String[] line2 = br.readLine().trim().split(\" \");\n        int[] A = new int[M];\n        for (int i = 0; i < M; i++) {\n            A[i] = Integer.parseInt(line2[i]);\n        }\n        String[] line3 = br.readLine().trim().split(\" \");\n        int[] B = new int[M];\n        for (int i = 0; i < M; i++) {\n            B[i] = Integer.parseInt(line3[i]);\n        }\n\n        int ans1 = 0;\n        for (int i = 0; i < M; i++) {\n            ans1 += Math.min(A[i], B[(i + 1) % M]);\n        }\n\n        int ans2 = 0;\n        Dinic dinic = new Dinic(2 * M + 2);\n        int s = 2 * M;\n        int t = 2 * M + 1;\n        for (int i = 0; i < M; i++) {\n            dinic.add_edge(s, i, N);\n            dinic.add_edge(M + i, t, B[i]);\n            dinic.add_edge(i, M + i, A[i]);\n            dinic.add_edge(i, M + (i - 1 + M) % M, A[i]);\n        }\n        ans2 = N - (int) dinic.flow(s, t);\n\n        System.out.println(ans2 + \" \" + ans1);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016306500765495002, -3.3378546504536644e-06, -4.768370445162873e-07, -6.270212179515511e-05, -4.660974445869215e-05, -0.4740808606147766, -0.6931915283203125, -0.0001752223033690825, -1.9192511899746023e-05, -2.288792165927589e-05, -0.0004338276921771467, -7.569503213