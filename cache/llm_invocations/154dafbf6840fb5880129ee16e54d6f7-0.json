t[e.to] = u;\n                    parent_edge[e.to] = i;\n                    q.push(e.to);\n                }\n            }\n        }\n        if (parent[t] == -1) break;\n        int push = INF;\n        for (int v = t; v != s; v = parent[v]) {\n            push = min(push, flow_graph[parent[v]][parent_edge[v]].cap);\n        }\n        for (int v = t; v != s; v = parent[v]) {\n            Edge &e = flow_graph[parent[v]][parent_edge[v]];\n            e.cap -= push;\n            flow_graph[v][e.rev].cap += push;\n        }\n        total += push;\n    }\n    return total;\n}\n\nint node_no(int n, int i, int j, bool right) {\n    return i * n + j + (right ? n * n : 0);\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n\n    int n, t;\n    cin >> n >> t;\n    string line;\n    pair<int,int> blast;\n\n    for (int i = 0; i < n; ++i) {\n        cin >> line;\n        for (int j = 0; j < n; ++j) {\n            char ch = line[j];\n            if (ch == 'Y') mp[i][j] = 'Y';\n            else if (ch == 'Z') {\n                mp[i][j] = 'Z';\n                blast = {i, j};\n            } else {\n                mp[i][j] = '.';\n                n_experts[i][j] += ch - '0';\n            }\n        }\n    }\n\n    for (int i = 0; i < n; ++i) {\n        cin >> line;\n        for (int j = 0; j < n; ++j) {\n            if (line[j] != 'Y' && line[j] != 'Z') n_help[i][j] += line[j] - '0';\n        }\n    }\n\n    memset(infected_at, -1, sizeof infected_at);\n    infected_at[blast.first][blast.second] = 0;\n    queue<pair<int,int>> q;\n    q.push(blast);\n    while (!q.empty()) {\n        int i = q.front().first, j = q.front().second;\n        q.pop();\n        for (int d = 0; d < 4; ++d) {\n            int ni = i + dir_i[d], nj = j + dir_j[d];\n            if (0 <= ni && ni < n && 0 <= nj && nj < n && mp[ni][nj] == '.' && infected_at[ni][nj] == -1) {\n                infected_at[ni][nj] = infected_at[i][j] + 1;\n                q.push({ni, nj});\n      