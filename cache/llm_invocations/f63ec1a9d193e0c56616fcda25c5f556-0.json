.min(f, e.cap - e.f));\n            if (df > 0) {\n                e.f += df;\n                adj.get(v).get(e.rev).f -= df;\n                return df;\n            }\n            ptr[u] = i + 1; // update pointer after loop? Actually we need to increment i in loop, but we use ptr[u] as index\n        }\n        return 0;\n    }\n\n    static int mf() {\n        int res = 0;\n        while (bfs()) {\n            Arrays.fill(ptr, 0);\n            int df;\n            while ((df = dfs(src, Integer.MAX_VALUE)) > 0) {\n                res += df;\n            }\n        }\n        return res;\n    }\n\n    static int[] dx = {-1, 0, 0, 1};\n    static int[] dy = {0, -1, 1, 0};\n\n    static int n, m;\n    static int[][] obs, tim, dii;\n\n    static void gbfs(int r, int c, int[][] dis, boolean chk) {\n        for (int i = 0; i < n; i++) Arrays.fill(dis[i], -1);\n        dis[r][c] = 0;\n        Queue<int[]> q = new LinkedList<>();\n        q.add(new int[]{r, c});\n        while (!q.isEmpty()) {\n            int[] p = q.poll();\n            if (chk && dis[p[0]][p[1]] == tim[p[0]][p[1]]) continue;\n            for (int i = 0; i < 4; i++) {\n                int nr = p[0] + dx[i];\n                int nc = p[1] + dy[i];\n                if (nr < 0 || nr >= n || nc < 0 || nc >= n) continue;\n                if (dis[nr][nc] != -1 || obs[nr][nc] == 1) continue;\n                if (chk && tim[nr][nc] > -1 && dis[p[0]][p[1]] + 1 > tim[nr][nc]) continue;\n                dis[nr][nc] = dis[p[0]][p[1]] + 1;\n                q.add(new int[]{nr, nc});\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        sc.nextLine();\n        String[] lab = new String[n];\n        String[] rea = new String[n];\n        for (int i = 0; i < n; i++) lab[i] = sc.nextLine();\n        for (int i = 0; i < n; i++) rea[i] = sc.nextLine();\n\n        obs = new int[n][n];\n        tim = new int[n][n];\n        dii = new int[n][n];\n\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < n; j++)\n                obs[i][j] = (lab[i].charAt(j) == 'Y') ? 1 : 0;\n\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < n; j++)\n                if (lab[i].charAt(j) == 'Z')\n                    gbfs(i, j, tim, false);\n\n        int totalNodes = 2 * n * n + 2;\n        src = 2 * n * n;\n        dst = src + 1;\n        adj = new ArrayList<>();\n        for (int i = 0; i < totalNodes; i++) adj.add(new ArrayList<>());\n        dis = new int[totalNodes];\n        ptr = new int[totalNodes];\n\n        for (int x = 0; x < n; x++) {\n            for (int y = 0; y < n; y++) {\n                if (lab[x].charAt(y) == 'Z' || lab[x].charAt(y) == 'Y') continue;\n                addEdge(src, n * x + y, lab[x].charAt(y) - '0', 0);\n                addEdge(n * n + n * x + y, dst, rea[x].charAt(y) - '0', 0);\n                gbfs(x, y, dii, true);\n                for (int xp = 0; xp < n; xp++) {\n                    for (int yp = 0; yp < n; yp++) {\n                        if (dii[xp][yp] != -1 && dii[xp][yp] <= m) {\n                            addEdge(n * x + y, n * n + n * xp + yp, Integer.MAX_VALUE, 0);\n                        }\n                    }\n                }\n            }\n        }\n        System.out.println(mf());\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.583032467868179e-06, 0.0, 0.0, -0.0001551984460093081, -0.0009385710000060499, 0.0, -0.008614521473646164, -0.01819690316915512, -0.001206861576065421, -1.1920928244535389e-07, -0.0025894464924931526, -0.008617713116109371, -0.0002044230350293219, -0.0008157739648595452, -0.02583448588848114, -1.1920928244535389e-07, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.861018856492592e-06, 0.0, -0.0001234931987710297, -6.711257447022945e-05, 0.0, 0.0, -0.001042775809764862, -1.7881377516459906e-06, -9.60