    int df = dfs(v, Math.min(f, e.cap - e.f));\n            if (df > 0) {\n                e.f += df;\n                adj.get(v).get(e.rev).f -= df;\n                return df;\n            }\n        }\n        return 0;\n    }\n\n    static int maxFlow() {\n        int flow = 0;\n        while (bfs()) {\n            Arrays.fill(ptr, 0);\n            while (true) {\n                int df = dfs(src, INF);\n                if (df == 0) break;\n                flow += df;\n            }\n        }\n        return flow;\n    }\n\n    static int[] dx = {-1, 0, 0, 1};\n    static int[] dy = {0, -1, 1, 0};\n\n    static int n, m;\n    static int[][] obs, tim, dii;\n\n    static void gbfs(int r, int c, int[][] dis, boolean chk) {\n        for (int i = 0; i < n; i++) Arrays.fill(dis[i], -1);\n        dis[r][c] = 0;\n        Queue<int[]> q = new LinkedList<>();\n        q.add(new int[]{r, c});\n        while (!q.isEmpty()) {\n            int[] p = q.poll();\n            if (chk && dis[p[0]][p[1]] == tim[p[0]][p[1]]) continue;\n            for (int i = 0; i < 4; i++) {\n                int nx = p[0] + dx[i];\n                int ny = p[1] + dy[i];\n                if (nx < 0 || nx >= n || ny < 0 || ny >= n) continue;\n                if (dis[nx][ny] != -1 || obs[nx][ny] == 1) continue;\n                if (chk && tim[nx][ny] > -1 && dis[p[0]][p[1]] + 1 > tim[nx][ny]) continue;\n                dis[nx][ny] = dis[p[0]][p[1]] + 1;\n                q.add(new int[]{nx, ny});\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        sc.nextLine();\n        String[] lab = new String[n];\n        String[] rea = new String[n];\n        for (int i = 0; i < n; i++) lab[i] = sc.nextLine();\n        for (int i = 0; i < n; i++) rea[i] = sc.nextLine();\n\n        obs = new int[n][n];\n        tim = new int[n][n];\n        dii = new int[n][n];\n\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < n; j++)\n                obs[i][j] = (lab[i].charAt(j) == 'Y') ? 1 : 0;\n\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < n; j++)\n                tim[i][j] = -1;\n\n        for (int i = 0; i < n; i++)\n            for (int j = 0; j < n; j++)\n                if (lab[i].charAt(j) == 'Z')\n                    gbfs(i, j, tim, false);\n\n        int totalNodes = 2 * n * n + 10;\n        src = 2 * n * n + 5;\n        dst = src + 1;\n\n        adj = new ArrayList<>(totalNodes);\n        for (int i = 0; i < totalNodes; i++) adj.add(new ArrayList<>());\n        dis = new int[totalNodes];\n        ptr = new int[totalNodes];\n\n        for (int x = 0; x < n; x++) {\n            for (int y = 0; y < n; y++) {\n                char c = lab[x].charAt(y);\n                if (c == 'Z' || c == 'Y') continue;\n                int inNode = n * x + y;\n                int outNode = n * n + n * x + y;\n                addEdge(src, inNode, c - '0', 0);\n                addEdge(outNode, dst, rea[x].charAt(y) - '0', 0);\n\n                gbfs(x, y, dii, true);\n                for (int xp = 0; xp < n; xp++) {\n                    for (int yp = 0; yp < n; yp++) {\n                        if (dii[xp][yp] != -1 && dii[xp][yp] <= m) {\n                            addEdge(inNode, n * n + n * xp + yp, INF, 0);\n                        }\n                    }\n                }\n            }\n        }\n\n        System.out.println(maxFlow());\n        sc.close();\n    }\n}\n```</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.31861618161201477, -0.6940596699714661, -1.311301275563892e-06, -4.649054244509898e-05, -5.054346183896996e-05, -2.3841855067985307e-07, -0.0019299230771139264, -0.0015017433324828744, -0.00015138434537220746, -3.576278118089249e-07, -0.017474032938480377, -0.02326349914073944, -0.0015124559868127108, -0.018645023927092552, -0.5928126573562622, -4.768370445162873e-