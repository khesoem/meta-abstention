ac[i-1]*i%P;\n\tifac[n]=fpow(fac[n],P-2);\n\tfor(int i=n-1;~i;--i)ifac[i]=ifac[i+1]*(i+1ll)%P;\n\tinv[1]=1;\n\tfor(int i=2;i<=n;++i)inv[i]=1ll*(P-P/i)*inv[P%i]%P;\n}\ninline void add(int &x,int y){x+=y;if(x>=P)x-=P;}\ninline void sub(int &x,int y){x-=y;x-=(x>>31)*P;}\ninline int sub(int x){return x-(x>>31)*P;}\nint t[20],g[20];\ninline void fpow(int *f,int n,int k){\n\tmemcpy(t,f,4*n+4);\n\tf[0]=1-f[0],g[0]=0;\n\tfor(int i=1;i<n;++i)\n\t{\n\t\tf[i]=g[i]=0;\n\t\tfor(int j=1;j<i;++j)\n\t\t\tf[i]=(f[i]+1ll*f[i-j]*g[j])%P,\n\t\t\tg[i]=(g[i]+1ll*t[i-j]*g[j])%P;\n\t\tsub(f[i],g[i]);\n\t\tf[i]=(t[i]+1ll*f[i]*inv[i])%P*k%P,\n\t\tg[i]=(t[i]-1ll*g[i]*inv[i])%P*i%P;\n\t}\n}\ninline void FMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(RG int j=0;j<l;++j)\n\t\t\t\tadd(f[i+j+l],f[i+j]);\n}\ninline void IFMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(RG int j=0;j<l;++j)\n\t\t\t\tsub(f[i+j+l],f[i+j]);\n}\nint n,k;\n#define pop(x) __builtin_popcount(x)\nint main(void)\n{\n\tn=gi,k=gi;P=gi;\n\tint ans=fpow(k,n);\n\tif(~n&1){\n\t\tint m=(int)log2(n)+1;\n\t\tinit(1<<m);\n\t\tfor(int i=0;i<(1<<m);++i)f[pop(i)][i]=ifac[i];\n\t\tfor(int i=0;i<=m;++i)FMT(f[i],1<<m);\n\t\tstatic int F[20];\n\t\tfor(int i=0;i<=n;++i){\n\t\t\tfor(int j=0;j<=m;++j)F[j]=f[j][i];\n\t\t\tfpow(F,m+1,k);\n\t\t\tfor(int j=0;j<=m;++j)f[j][i]=F[j];\n\t\t}\n\t\tIFMT(f[pop(n)],1<<m);\n\t\tans=(P+ans-1ll*f[pop(n)][n]*fac[n]%P)%P;\n\t}\n\tpi(ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final int N = 300000 + 10;\n    static final int P = 1000000009;\n    static long[] fac = new long[N];\n    static long[] ifac = new long[N];\n    static long[] inv = new long[N];\n    static long[] f = new long[20][N];\n    static long[] t = new long[20];\n    static long[] g = new long[20];\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int p = Integer.parseInt(st.nextToken());\n        P = p;\n        long ans = pow(k, n);\n        if (n % 2 == 0) {\n            int m = (int) (Math.log(n) / Math.log(2)) + 1;\n            init(1 << m);\n            for (int i = 0; i < (1 << m); i++) {\n                f[Integer.bitCount(i)][i] = ifac(i);\n            }\n            for (int i = 0; i <= m; i++) {\n                FMT(f[i], 1 << m);\n            }\n            long[] F = new long[20];\n            for (int i = 0; i <= n; i++) {\n                for (int j = 0; j <= m; j) {\n                    F[j] = f[j][i];\n                }\n                fpow(F, m + 1, k);\n                for (int j = 0; j <= m; j) {\n                    f[j][i] = F[j];\n                }\n            }\n            IFMT(f[Integer.bitCount(n)], 1 << m);\n            ans = (P + ans - 1L * f[Integer.bitCount(n)][n] * fac(n) % P) % P;\n        }\n        pw.println(ans);\n        pw.close();\n    }\n\n    static long pow(long a, int b) {\n        long res = 1;\n        for (; b > 0; b >>= 1, a = a * a % P) {\n            if (b % 2 == 1) {\n                res = res * a % P;\n            }\n        }\n        return res;\n    }\n\n    static long ifac(long n) {\n        return pow(fac((int) n), P - 2);\n    }\n\n    static long fac(long n) {\n        return n == 0 ? 1 : fac((int) (n - 1)) * n % P;\n    }\n\n    static void init(int n) {\n        fac[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            fac[i] = fac[i - 1] * i % P;\n        }\n        ifac[n] = pow(fac[n], P - 2);\n        for (int i = n - 1; i >= 0; i--) {\n            ifac[i] = ifac[i + 1] * (i + 1) % P;\n        }\n        inv[1] = 1;\n        for (int i = 2; i <= n; i++) {\n            inv[i] = (P - P / i) * inv[P % i] % P;\n        }\n    }\n\n    static void add(long[] f, int i, int j) {\n        f[i] += j;\n        if (f[i] >= P) {\n            f[i] -= P;\n        }\n    }\n\n    static void sub(long[] f, int i, int j) {\n        f[i] -= j;\n        if (f[i] < 0) {\n            f[i] += P;\n        }\n    }\n\n    static void FMT(long[] f, int n) {\n        for (int l = 1; l < n; l <<= 1) {\n            for (int i = 0; i < n; i += l << 1) {\n                for (int j = 0; j < l; j++) {\n                    add(f, i + j + l, f[i + j]);\n                }\n            }\n        }\n    }\n\n    static void IFMT(long[] f, int n) {\n        for (int l = 1; l < n; l <<= 1) {\n            for (int i = 0; i < n; i += l << 1) {\n                for (int j = 0; j < l; j++) {\n                    sub(f, i + j + l, f[i + j]);\n                }\n            }\n        }\n    }\n\n    static void fpow(long[] f, int n, long k) {\n        System.arraycopy(f, 0, t, 0, 4 * n + 4);\n        f[0] = 1 - f[0];\n        g[0] = 0;\n        for (int i = 1; i < n; i++) {\n            f[i] = g[i] = 0;\n            for (int j = 1; j < i; j++) {\n                f[i] = (f[i] + 1L * f[i - j] * g[j]) % P;\n                g[i] = (g[i] + 1L * t[i - j] * g[j]) % P;\n            }\n            sub(f[i], g[i]);\n            f[i] = (t[i] + 1L * f[i] * inv[i]) % P * k % P;\n            g[i] = (t[i] - 1L * g[i] * inv[i]) % P * i % P;\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.578715443611145, -0.007952097803354263, -0.024871796369552612, -0.029366858303546906, -0.001264119055122137, -0.22765226662158966, -0.49957937002182007, -0.0015208956319838762, -0.00016499926277901977, -0.03755654767155647, -0.3946087062358856, -0.005335113033652306, -0.00013423866766970605,