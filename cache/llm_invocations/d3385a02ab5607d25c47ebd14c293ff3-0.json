 = dq.pollFirst();\n            int r = cell[0];\n            int c = cell[1];\n            for (int k = 0; k < 4; ++k) {\n                int nr = r + dR[k];\n                int nc = c + dC[k];\n                if (!safe(nr, nc, grid) || !dist.get(nr).get(nc).equals(INF)) continue;\n                dist.get(nr).set(nc, dist.get(r).get(c) + 1);\n                dq.add(new int[]{nr, nc});\n            }\n        }\n        return dist;\n    }\n\n    static void constructGraph(Scanner cin) {\n        int N = cin.nextInt();\n        int T = cin.nextInt();\n        List<String> A = new ArrayList<>();\n        List<String> B = new ArrayList<>();\n        for (int i = 0; i < N; ++i) A.add(cin.next());\n        for (int i = 0; i < N; ++i) B.add(cin.next());\n\n        int rx = -1, ry = -1;\n        for (int i = 0; i < N; ++i) {\n            for (int j = 0; j < N; ++j) {\n                if (A.get(i).charAt(j) == 'Z') {\n                    rx = i;\n                    ry = j;\n                }\n            }\n        }\n\n        List<List<Long>> dist_react = distanceField(rx, ry, A);\n\n        for (int i = 0; i < N; ++i) {\n            for (int j = 0; j < N; ++j) {\n                if (!safe(i, j, A)) continue;\n                List<List<Long>> dist_src = distanceField(i, j, A);\n\n                for (int x = 0; x < N; ++x) {\n                    for (int y = 0; y < N; ++y) {\n                        if (!safe(x, y, A)) continue;\n                        if (dist_src.get(x).get(y) > T) continue;\n                        if (dist_src.get(x).get(y) > dist_react.get(x).get(y)) continue;\n\n                        boolean critical = (dist_src.get(x).get(y).equals(dist_react.get(x).get(y)));\n                        if (critical) {\n                            boolean able_to_escape = false;\n                            for (int k = 0; k < 4; ++k) {\n                                int nx = x + dR[k], ny = y + dC[k];\n                                if (safe(nx, ny, A) && dist_src.get(nx).get(ny) < dist_react.get(nx).get(ny)) {\n                                    able_to_escape = true;\n                                    break;\n                                }\n                            }\n                            if (!able_to_escape) continue;\n                        }\n\n                        int cap1 = A.get(i).charAt(j) - '0';\n                        int cap2 = B.get(x).charAt(y) - '0';\n                        for (int u = 1; u <= cap1; ++u) {\n                            for (int v = 1; v <= cap2; ++v) {\n                                int src_id = 100 * i + 10 * j + u;\n                                int dst_id = 100 * x + 10 * y + v;\n                                if (graph[src_id] == null) {\n                                    graph[src_id] = new ArrayList<>();\n                                }\n                                graph[src_id].add(dst_id);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    static boolean tryAugment(int u) {\n        if (visited[u]) return false;\n        visited[u] = true;\n        if (graph[u] != null) {\n            for (int v : graph[u]) {\n                if (mate[v] == 0 || tryAugment(mate[v])) {\n                    mate[v] = u;\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n\n    static void execute(Scanner cin) {\n        constructGraph(cin);\n        int matches = 0;\n        for (int u = 0; u < MAX_NODES; ++u) {\n            Arrays.fill(visited, false);\n            matches += tryAugment(u) ? 1 : 0;\n        }\n        System.out.println(matches);\n    }\n\n    public static void main(String[] args) {\n        Scanner cin = new Scanner(System.in);\n        execute(cin);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012540031457319856, -3.933898824470816e-06, -9.53673861658