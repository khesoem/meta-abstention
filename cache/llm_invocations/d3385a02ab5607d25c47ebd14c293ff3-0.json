           dist[nr][nc] = dist[r][c] + 1;\n            dq.emplace_back(nr, nc);\n        }\n    }\n    return dist;\n}\n\nvoid construct_graph() {\n    int N, T;\n    cin >> N >> T;\n    vs A(N), B(N);\n    for (int i = 0; i < N; ++i) cin >> A[i];\n    for (int i = 0; i < N; ++i) cin >> B[i];\n\n    int rx = -1, ry = -1;\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            if (A[i][j] == 'Z') rx = i, ry = j;\n\n    auto dist_react = distance_field(rx, ry, A);\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (!safe(i, j, A)) continue;\n            auto dist_src = distance_field(i, j, A);\n\n            for (int x = 0; x < N; ++x) {\n                for (int y = 0; y < N; ++y) {\n                    if (!safe(x, y, A)) continue;\n                    if (dist_src[x][y] > T) continue;\n                    if (dist_src[x][y] > dist_react[x][y]) continue;\n\n                    bool critical = (dist_src[x][y] == dist_react[x][y]);\n                    if (critical) {\n                        bool able_to_escape = false;\n                        for (int k = 0; k < 4; ++k) {\n                            int nx = x + dR[k], ny = y + dC[k];\n                            if (safe(nx, ny, A) && dist_src[nx][ny] < dist_react[nx][ny]) {\n                                able_to_escape = true;\n                                break;\n                            }\n                        }\n                        if (!able_to_escape) continue;\n                    }\n\n                    int cap1 = A[i][j] - '0';\n                    int cap2 = B[x][y] - '0';\n                    for (int u = 1; u <= cap1; ++u) {\n                        for (int v = 1; v <= cap2; ++v) {\n                            int src_id = 100 * i + 10 * j + u;\n                            int dst_id = 100 * x + 10 * y + v;\n                            graph[src_id].push_back(dst_id);\n                        }\n                    }\n