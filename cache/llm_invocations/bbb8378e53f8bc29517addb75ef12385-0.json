ong val = 1;\n        long ans = 0;\n        long prob = 1;\n        for(int i = k; i > 0; i--){\n            val = (val * (n - (k - i))) % MOD;\n            prob = (prob * p) % MOD;\n            ans = (ans + ((val * prob) % MOD) * stirling[k][k-i+1]) % MOD;\n        }\n        System.out.println(ans);\n    }\n\n    public static long fact(int n){\n        long res = 1;\n        for(int i=2; i<=n; i++) res = (res * i) % MOD;\n        return res;\n    }\n\n    public static long comb(int n, int r){\n        if(r < 0 || r > n) return 0;\n        return (fact(n) * modInverse((fact(r) * fact(n-r)) % MOD, MOD)) % MOD;\n    }\n\n    public static long modInverse(long x, long p){\n        return power(x, p-2, p);\n    }\n\n    public static long power(long x, long y, long p){\n        long res = 1;\n        x = x % p;\n        while (y > 0) {\n            if (y % 2 == 1)\n                res = (res * x) % p;\n            y = y >> 1;\n            x = (x * x) % p;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef modinv(x):\n    return pow(x, MOD - 2, MOD)\n\ndef fact(n, fact_list):\n    # fact_list is precomputed up to needed length\n    return fact_list[n]\n\ndef comb(n, r, fact_list):\n    if r < 0 or r > n:\n        return 0\n    return (fact_list[n] * modinv((fact_list[r] * fact_list[n - r]) % MOD)) % MOD\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n    k = int(data[2])\n    p = modinv(m)  # modular inverse of m modulo MOD\n\n    # Precompute factorials up to k\n    fact_list = [1] * (k + 1)\n    for i in range(2, k + 1):\n        fact_list[i] = (fact_list[i - 1] * i) % MOD\n\n    # Compute Stirling numbers of the second kind S(i,j) for i,j <= k\n    stirling = [[0] * (k + 1) for _ in