];\ntf cap[MAXN],mxflow;\nbool in_queue[MAXN];\nvoid flow(int s, int t){\n\tmemset(in_queue,0,sizeof(in_queue));\n\tmxflow=mncost=0;\n\twhile(1){\n\t\tfill(dist,dist+nodes,INFCOSTO);dist[s]=0;\n\t\tmemset(pre,-1,sizeof(pre));pre[s]=0;\n\t\tmemset(cap,0,sizeof(cap));cap[s]=INFFLUJO;\n\t\tqueue<int> q;q.push(s);in_queue[s]=1;\n\t\twhile(SZ(q)){\n\t\t\tint u=q.front();q.pop();in_queue[u]=0;\n\t\t\tfore(_,0,SZ(g[u])){\n\t\t\t\tint i=g[u][_];\n\t\t\t\tedge &E=e[i];\n\t\t\t\tif(E.rem()&&dist[E.v]>dist[u]+E.cost+1e-9){\n\t\t\t\t\tdist[E.v]=dist[u]+E.cost;\n\t\t\t\t\tpre[E.v]=i;\n\t\t\t\t\tcap[E.v]=min(cap[u],E.rem());\n\t\t\t\t\tif(!in_queue[E.v])q.push(E.v),in_queue[E.v]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(pre[t]<0)break;\n\t\tmxflow+=cap[t];mncost+=cap[t]*dist[t];\n\t\tfor(int v=t;v!=s;v=e[pre[v]].u){\n\t\t\te[pre[v]].flow+=cap[t];e[pre[v]^1].flow-=cap[t];\n\t\t}\n\t}\n}\nint main() {\n  ios::sync_with_stdio(false);\n\tll n,m,k,c,d;\n  cin>>n>>m>>k>>c>>d;\n\tint MAXT=n+k;\n\tif(DEBUG)cout<<\"MAXT: \"<<MAXT<<endl;\n\tvector<int>a(k);\n\tfore(i,0,k){\n\t\tcin>>a[i];a[i]--;\n\t\tadd_edge(SRC,a[i]*MAXT,1,0);\n\t}\n\tfore(j,0,MAXT)add_edge(j,SNC,k,0);\n\tfore(i,0,m) {\n\t\tint x,y;cin>>x>>y;x--,y--;\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(x*MAXT+j,y*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(y*MAXT+j,x*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t}\n\tfore(i,0,n) {\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(i*MAXT+j,i*MAXT+j+1,1,c);\n\t\t}\n\t}\n\tflow(SRC,SNC);\n\tif(DEBUG)cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n\tcout<<mncost<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nDEBUG = 0\n\nMAXN = 50 * 100 + 15\nSRC = MAXN - 1\nSNC = MAXN - 2\n\nINFFLUJO = 10**14\nINFCOSTO = 10**14\n\nclass Edge:\n    def __init__(self, u, v, cap, flow, cost):\n        self.u = u\n        self.v = v\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n    \n    def rem(self):\n        return self.cap - self.flow\n\nnodes = MAXN\ng = [[] for _ in range(MAXN)]\ne = []\n\ndef add_edge(u, v, cap, cost):\n    if DEBUG:\n        dem = str(u)\n        pen = str(v)\n        if u == SRC:\n            dem = \"SRC\"\n        if u == SNC:\n            dem = \"SINC\"\n        if v == SRC:\n            pen = \"SRC\"\n        if v == SNC:\n            pen = \"SINC\"\n        print(f\"add edge: {dem} {pen} {cap} {cost}\")\n    \n    g[u].append(len(e))\n    e.append(Edge(u, v, cap, 0, cost))\n    \n    g[v].append(len(e))\n    e.append(Edge(v, u, 0, 0, -cost))\n\ndef flow(s, t):\n    global mxflow, mncost\n    in_queue = [False] * MAXN\n    mxflow = 0\n    mncost = 0\n    \n    while True:\n        dist = [INFCOSTO] * MAXN\n        dist[s] = 0\n        pre = [-1] * MAXN\n        pre[s] = 0\n        cap = [0] * MAXN\n        cap[s] = INFFLUJO\n        q = deque()\n        q.append(s)\n        in_queue[s] = True\n        \n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            \n            for idx in g[u]:\n                E = e[idx]\n                if E.rem() > 0 and dist[E.v] > dist[u] + E.cost + 1e-9:\n                    dist[E.v] = dist[u] + E.cost\n                    pre[E.v] = idx\n                    cap[E.v] = min(cap[u], E.rem())\n                    if not in_queue[E.v]:\n                        q.append(E.v)\n                        in_queue[E.v] = True\n        \n        if pre[t] < 0:\n            break\n        \n        mxflow += cap[t]\n        mncost += cap[t] * dist[t]\n        \n        v = t\n        while v != s:\n            edge_idx = pre[v]\n            e[edge_idx].flow += cap[t]\n            e[edge_idx ^ 1].flow -= cap[t]\n            v = e[edge_idx].u\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    \n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    MAXT = n + k\n    \n    if DEBUG:\n        print(f\"MAXT: {MAXT}\")\n    \n    a = []\n    for i in range(k):\n        val = int(input_data[idx]); idx += 1\n        a.append(val - 1)\n        add_edge(SRC, a[i] * MAXT, 1, 0)\n    \n    for j in range(MAXT):\n        add_edge(j, SNC, k, 0)\n    \n    for _ in range(m):\n        x = int(input_data[idx]); idx += 1\n        y = int(input_data[idx]); idx += 1\n        x -= 1\n        y -= 1\n        \n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(x * MAXT + j, y * MAXT + j + 1, 1, c + d * (2 * K - 1))\n        \n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(y * MAXT + j, x * MAXT + j + 1, 1, c + d * (2 * K - 1))\n    \n    for i in range(n):\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c)\n    \n    flow(SRC, SNC)\n    \n    if DEBUG:\n        print(f\"mncost: {mncost} mxflow: {mxflow}\")\n    \n    print(mncost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010859376925509423, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0009554826538078487, -0.0009527434594929218, -7.152555099310121e-07, -0.0010400369064882398, -0.0002488780301064253, -1.7881377516459906e-06, -0.00023362292267847806, -0.08899442106485367, -0.35399869084358215, -1.1920928244535389e-07, -0.0010352734243497252, -4.768370445162873e-07, -0.10021273046731949, -0.12075872719287872, -2.90866428258596e-05, -1.311301275563892e-06, -7.033323527139146e-06, -5.960462772236497e-07, -3.933898824470816e-06, -0.011675596237182617, 0.0, 0.0, 0.0, -7.0333