ns = modPow(k, n);\n    \n    if (n % 2 == 0) {\n        fill(f, f + MAX_N, 0);\n        f[n] = fact[n];\n        \n        for (int iter = 1; iter <= k; ++iter) {\n            fill(g, g + MAX_N, 0);\n            \n            for (int mask = n; mask; mask = (mask - 1) & n) {\n                if (!f[mask]) continue;\n                \n                for (int sub = mask; 2 * sub >= mask; sub = (sub - 1) & mask) {\n                    g[mask ^ sub] = (g[mask ^ sub] + f[mask] * invFact[sub]) % P;\n                }\n            }\n            \n            swap(f, g);\n            \n            i64 val = f[0];\n            for (int j = 0; j < iter; ++j) {\n                val = val * (k - j) % P;\n            }\n            ans = (ans - val % P + P) % P;\n        }\n    }\n    \n    cout << ans % P << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAX_N = 1000010;\n    static int n, k, P;\n    static long[] fact = new long[MAX_N];\n    static long[] invFact = new long[MAX_N];\n    static long[] f = new long[MAX_N];\n    static long[] g = new long[MAX_N];\n\n    static long modPow(long base, long exp) {\n        long res = 1 % P;\n        base %= P;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % P;\n            }\n            base = (base * base) % P;\n            exp >>= 1;\n        }\n        return res;\n    }\n\n    static long modInv(long x) {\n        if (x <= 1) return 1;\n        return modInv(P % x) * (P - P / x) % P;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n   