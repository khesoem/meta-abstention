(dist, INF);\n        dist[source] = 0;\n        boolean[] inQueue = new boolean[numVertices];\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(source);\n        inQueue[source] = true;\n        \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = false;\n            \n            for (int i = 0; i < graph.get(u).size(); i++) {\n                Edge e = graph.get(u).get(i);\n                if (e.capacity > 0 && dist[u] + e.cost < dist[e.to]) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevNode[e.to] = u;\n                    prevEdge[e.to] = i;\n                    if (!inQueue[e.to]) {\n                        q.offer(e.to);\n                        inQueue[e.to] = true;\n                    }\n                }\n            }\n        }\n        return dist[sink] != INF;\n    }\n    \n    int minCostFlow(int source, int sink) {\n        int[] dist = new int[numVertices];\n        int[] prevNode = new int[numVertices];\n        int[] prevEdge = new int[numVertices];\n        int flow = 0;\n        int cost = 0;\n        \n        while (spfa(source, sink, dist, prevNode, prevEdge)) {\n            int f = INF;\n            for (int v = sink; v != source; v = prevNode[v]) {\n                Edge e = graph.get(prevNode[v]).get(prevEdge[v]);\n                f = Math.min(f, e.capacity);\n            }\n            \n            for (int v = sink; v != source; v = prevNode[v]) {\n                Edge e = graph.get(prevNode[v]).get(prevEdge[v]);\n                e.capacity -= f;\n                graph.get(v).get(e.rev).capacity += f;\n            }\n            \n            flow += f;\n            cost += f * dist[sink];\n        }\n        \n        return cost;\n    }\n    \n    void process() {\n        int n = sc.nextInt() / 2;\n        numVertices = 1 + n + ALPHABET_SIZE + 1;\n        \n        createGraph();\n        \n        byte[] chars = sc.next().getBytes();\n        int[] values = new int[n * 2];\n        for (int i = 0; i < n * 2; i++) {\n            values[i] = sc.nextInt();\n        }\n        \n        // Source to positions\n        for (int i = 0; i < n; i++) {\n            addBiDirectionalEdge(0, 1 + i, 2, 0);\n        }\n        \n        // Positions to letters\n        for (int i = 0; i < n; i++) {\n            int j = n * 2 - 1 - i;\n            int charI = chars[i] - 'a';\n            int charJ = chars[j] - 'a';\n            \n            for (int letter = 0; letter < ALPHABET_SIZE; letter++) {\n                int val;\n                if (letter == charI && letter == charJ) {\n                    val = Math.max(values[i], values[j]);\n                } else if (letter == charI) {\n                    val = values[i];\n                } else if (letter == charJ) {\n                    val = values[j];\n                } else {\n                    val = 0;\n                }\n                addBiDirectionalEdge(1 + i, 1 + n + letter, 1, -val);\n            }\n        }\n        \n        int[] letterCounts = new int[ALPHABET_SIZE];\n        for (int i = 0; i < n * 2; i++) {\n            int ch = chars[i] - 'a';\n            letterCounts[ch]++;\n        }\n        \n        // Letters to sink\n        for (int letter = 0; letter < ALPHABET_SIZE; letter++) {\n            addBiDirectionalEdge(1 + n + letter, numVertices - 1, letterCounts[letter], 0);\n        }\n        \n        int result = minCostFlow(0, numVertices - 1);\n        println(-result);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    def __init__(self, to, capacity, cost, rev):\n        self.to = to\n        self.capacity = capacity\n        self.cost = cost\n        self.rev = rev\n\nclass CF884F:\n    ALPHABET_SIZE = 26\n    INF = 0x3f3f3f3f\n    \n    def __init__(self):\n        self.graph = None\n        self.numVertices = 0\n    \n    def createGraph(self):\n        self.graph = [[] for _ in range(self.numVertices)]\n    \n    def addBiDirectionalEdge(self, u, v, cap, cost):\n        self.graph[u].append(Edge(v, cap, cost, len(self.graph[v])))\n        self.graph[v].append(Edge(u, 0, -cost, len(self.graph[u]) - 1))\n    \n    def spfa(self, source, sink, dist, prevNode, prevEdge):\n        dist[:] = [self.INF] * len(dist)\n        dist[source] = 0\n        inQueue = [False] * self.numVertices\n        q = deque()\n        q.append(source)\n        inQueue[source] = True\n        \n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            \n            for i in range(len(self.graph[u])):\n                e = self.graph[u][i]\n                if e.capacity > 0 and dist[u] + e.cost < dist[e.to]:\n                    dist[e.to] = dist[u] + e.cost\n                    prevNode[e.to] = u\n                    prevEdge[e.to] = i\n                    if not inQueue[e.to]:\n                        q.append(e.to)\n                        inQueue[e.to] = True\n        return dist[sink] != self.INF\n    \n    def minCostFlow(self, source, sink):\n        dist = [0] * self.numVertices\n        prevNode = [0] * self.numVertices\n        prevEdge = [0] * self.numVertices\n        flow = 0\n        cost = 0\n        \n        while self.spfa(source, sink, dist, prevNode, prevEdge):\n            f = self.INF\n            v = sink\n            while v != source:\n                e = self.graph[prevNode[v]][prevEdge[v]]\n                f = min(f, e.capacity)\n                v = prevNode[v]\n            \n            v = sink\n            while v != source:\n                e = self.graph[prevNode[v]][prevEdge[v]]\n                e.capacity -= f\n                rev_edge = self.graph[v][e.rev]\n                rev_edge.capacity += f\n                v = prevNode[v]\n            \n            flow += f\n            cost += f * dist[sink]\n        \n        return cost\n    \n    def process(self):\n        n = int(input().strip()) // 2\n        self.numVertices = 1 + n + self.ALPHABET_SIZE + 1\n        \n        self.createGraph()\n        \n        chars = input().strip().encode()\n        values = list(map(int, input().strip().split()))\n        \n        # Source to positions\n        for i in range(n):\n            self.addBiDirectionalEdge(0, 1 + i, 2, 0)\n        \n        # Positions to letters\n        for i in range(n):\n            j = n * 2 - 1 - i\n            charI = chars[i] - ord('a')\n            charJ = chars[j] - ord('a')\n            \n            for letter in range(self.ALPHABET_SIZE):\n                if letter == charI and letter == charJ:\n                    val = max(values[i], values[j])\n                elif letter == charI:\n                    val = values[i]\n                elif letter == charJ:\n                    val = values[j]\n                else:\n                    val = 0\n                self.addBiDirectionalEdge(1 + i, 1 + n + letter, 1, -val)\n        \n        letterCounts = [0] * self.ALPHABET_SIZE\n        for i in range(n * 2):\n            ch = chars[i] - ord('a')\n            letterCounts[ch] += 1\n        \n        # Letters to sink\n        for letter in range(self.ALPHABET_SIZE):\n            self.addBiDirectionalEdge(1 + n + letter, self.numVertices - 1, letterCounts[letter], 0)\n        \n        result = self.minCostFlow(0, self.numVertices - 1)\n        print(-result)\n\nif __name__ == \"__main__\":\n    CF884F().process()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001161031104857102, -7.152555099310121e-07, 0.0, -0.00014876213390380144, -0.003753285389393568, -4.0531076592742465e-06, -0.001705264556221664, -0.00034814971149899065, -4.768370445162873e-07, -0.016045374795794487, -0.2256554216146469, -0.3057633638381958, -0.0032907165586948395, -5.960462772236497e-07, -5.960462772236497