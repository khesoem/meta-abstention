-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        int m = scanner.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = scanner.nextInt();\n        }\n\n        int split = n / 2;\n        List<Integer> leftList = new ArrayList<>();\n        List<Integer> rightList = new ArrayList<>();\n\n        exploreLeft(a, 0, split, 0, m, leftList);\n        exploreRight(a, split, n, 0, m, rightList);\n\n        // Remove duplicates and sort leftList\n        Set<Integer> leftSet = new HashSet<>(leftList);\n        List<Integer> sortedLeft = new ArrayList<>(leftSet);\n        Collections.sort(sortedLeft);\n\n        int maxValue = 0;\n        for (int rightItem : rightList) {\n            int required = (m - rightItem) % m;\n            int position = binarySearch(sortedLeft, required);\n            if (position > 0) {\n                int value = sortedLeft.get(position - 1) + rightItem;\n                if (value > maxValue) {\n                    maxValue = value;\n                }\n            }\n        }\n\n        System.out.println(maxValue);\n    }\n\n    private static void exploreLeft(int[] a, int index, int split, int current, int m, List<Integer> result) {\n        if (index == split) {\n            result.add(current);\n        } else {\n            exploreLeft(a, index + 1, split, (current + a[index]) % m, m, result);\n            exploreLeft(a, index + 1, split, current, m, result);\n        }\n    }\n\n    private static void exploreRight(int[] a, int index, int n, int current, int m, List<Integer> result) {\n        if (index == n) {\n            result.add(current);\n        } else {\n            exploreRight(a, index + 1, n, (current + a[index]) % m, m, result);\n            exploreRight(a, index + 1, n, current, 