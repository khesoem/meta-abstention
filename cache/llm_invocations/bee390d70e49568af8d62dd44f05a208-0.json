 + P1) % P1;\n                        auto it = lower_bound(val[i].begin(), val[i].end(), P1 - coef);\n                        ans = (ans + 1LL * coef * val[i].size() + sum[i]) % P2;\n                        ans = (ans - 1LL * P1 * (val[i].end() - it) % P2 + P2) % P2;\n                    }\n                    for (int i = 0; i <= 6; ++i) cnt += val[i].size();\n                    st.pop(); continue;\n                }\n                ans = (ans + (++cnt - f.v % P1 + P1) % P1) % P2;\n            }\n            f.next = (f.d == 0 ? 1 : 0);\n        }\n        if (f.next < 10) {\n            int c = f.next++;\n            st.push({f.d + 1, f.v * 10 + c, 0, false});\n        } else {\n            st.pop();\n        }\n    }\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nP1 = 998244353\nP2 = 1000000007\nB = 1000000\n\ndef solve() -> None:\n    n = int(sys.stdin.readline().strip())\n    val = [[] for _ in range(7)]\n    cnt = 0\n\n    def dfs1(d: int, v: int) -> None:\n        nonlocal cnt\n        cnt += 1\n        val[d].append((cnt - v) % P1)\n        if d == 6:\n            return\n        for c in range(10):\n            dfs1(d + 1, v * 10 + c)\n\n    dfs1(0, 0)\n\n    sum_val = [0] * 7\n    for d in range(7):\n        val[d].sort()\n        s = 0\n        for x in val[d]:\n            s = (s + x) % P2\n        sum_val[d] = s\n\n    cnt = 0\n    ans = 0\n\n    # stack frames: [d, v, next_digit, processed]\n    stack = [[0, 0, 0, False]]\n\n    while stack:\n        f = stack[-1]\n        if not f[3]:\n            f[3] = True\n            if f[1] > n:\n                stack.pop()\n                continue\n            if f[0] != 0:\n                # check block condition\n                if f[1] * B > n // 10 and (f[1] + 1) * B - 1 <= n:\n                    # process whole block\n                    for i in range(7):\n                        pw = 10 ** i\n                        coef = (cnt - (f[1] * pw) % P1) % P1\n                        it = bisect.bisect_left(val[i], P1 - coef)\n                        ans = (ans + coef * len(val[i]) + sum_val[i]) % P2\n                        ans = (ans - P1 * (len(val[i]) - it) % P2 + P2) % P2\n                    for i in range(7):\n                        cnt += len(val[i])\n                    stack.pop()\n                    continue\n                # add individual number\n                cnt += 1\n                ans = (ans + (cnt - f[1] % P1) % P1) % P2\n            # set next digit start\n            f[2] = 1 if f[0] == 0 else 0\n        # process children\n        if f[2] < 10:\n            c = f[2]\n            f[2] += 1\n            stack.append([f[0] + 1, f[1] * 10 + c, 0, False])\n        else:\n            stack.pop()\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.617183291586116e-05, 0.0, -1.1920928244535389e-07, -0.00016640232934150845, -0.0020268866792321205, -0.023246610537171364, -0.0009198724874295294, -0.0009288049186579883, -1.4305104514278355e-06, 0.0, -0.00015925093612167984, -0.3868965208530426, 0.0, -7.64102369430475e-05, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.0265558760002023e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.814689989667386e-06, -3.790783375734463e-05, -1.1920928244535389e-07, -3.933898824470816e-06, -6.687417771900073e-05, -0.20159849524497986, -0.6964461207389832, -0.5759465098381042, -3.2186455882765586e-06, -0.0001234931987710297, -4.768370445162873e-07, 0.0, -0.5762633681297302, -0.03835775703191757, -1.0251946150674485e-05, -9.643566590966657e-05, 0.0, -1.6689160474925302e-05, -0.25511106848716