   for (int i=0;i<4;i++) {\n                int nx=x+dx[i], ny=y+dy[i];\n                if (ok(nx,ny) && d2[nx][ny]>=1e9 && a[nx].charAt(ny)!='Y' && d2[x][y]+1 <= d1[nx][ny]) {\n                    d2[nx][ny]=d2[x][y]+1;\n                    qx.add(nx); qy.add(ny);\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        t = sc.nextInt();\n        sc.nextLine();\n        for (int i=0;i<n;i++) a[i] = sc.nextLine();\n        int wx=0, wy=0;\n        for (int i=0;i<n;i++) {\n            b[i] = sc.nextLine();\n            for (int j=0;j<n;j++) {\n                if (b[i].charAt(j)=='Z') {\n                    StringBuilder sba = new StringBuilder(a[i]);\n                    StringBuilder sbb = new StringBuilder(b[i]);\n                    sba.setCharAt(j, 'Y');\n                    sbb.setCharAt(j, 'Y');\n                    a[i] = sba.toString();\n                    b[i] = sbb.toString();\n                    wx=i; wy=j;\n                }\n            }\n        }\n        for (int i=0;i<1000;i++) g[i] = new ArrayList<>();\n        bfs1(wx,wy);\n        source=0; sink=2*n*n+1;\n        for (int i=0;i<n;i++) {\n            for (int j=0;j<n;j++) {\n                if (a[i].charAt(j)=='Y') continue;\n                int what = i*n+j+1;\n                int what2 = n*n+i*n+j+1;\n                addEdge(source, what, a[i].charAt(j)-'0');\n                addEdge(what2, sink, b[i].charAt(j)-'0');\n                bfs2(i,j);\n                for (int x=0;x<n;x++) {\n                    for (int y=0;y<n;y++) {\n                        if (b[x].charAt(y)=='Y' || d2[x][y] > t) continue;\n                        addEdge(what, n*n+x*n+y+1, a[i].charAt(j)-'0');\n                    }\n                }\n            }\n        }\n        n = 2*n*n+5;\n        System.out.println(maxFlow());\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "