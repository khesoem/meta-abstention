t = 0; bit < N; ++bit) {\n                    if (mask >> bit & 1) curr |= derived[bit];\n                }\n                transitions[id][mask] = get_or_create(curr);\n            }\n            \n            return id;\n        }\n    };\n}\n\nint N, P[7][7], inv100;\nint dp[2][70003];\n\nint modpow(long long base, int exp) {\n    long long result = 1;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % detail::MOD;\n        base = (base * base) % detail::MOD;\n        exp >>= 1;\n    }\n    return (int)result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    cin >> N;\n    \n    detail::memoizer m;\n    m.transitions.resize(70003);\n    state_t init;\n    init.set(0);\n    m.get_or_create(init);\n    \n    inv100 = modpow(100, detail::MOD - 2);\n    \n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            cin >> P[i][j];\n    \n    int cur = 0;\n    fill(dp[cur], dp[cur] + 70003, 0);\n    dp[cur][1] = 1;\n    \n    vector<int> probs(1 << N);\n    \n    for (int stage = 0; stage < N; ++stage) {\n        for (int mask = 0; mask < (1 << N); ++mask) {\n            probs[mask] = 1;\n            for (int k = 0; k < N; ++k) {\n                int val = (mask >> k & 1) ? P[stage][k] : (100 - P[stage][k]);\n                probs[mask] = (long long)probs[mask] * inv100 % detail::MOD * val % detail::MOD;\n            }\n        }\n        \n        fill(dp[cur ^ 1], dp[cur ^ 1] + 70003, 0);\n        for (int s = 1; s <= m.counter; ++s) {\n            if (!dp[cur][s]) continue;\n            for (int mask = 0; mask < (1 << N); ++mask) {\n                dp[cur ^ 1][m.transitions[s][mask]] = \n                    (dp[cur ^ 1][m.transitions[s][mask]] + \n                     (long long)dp[cur][s] * probs[mask]) % detail::MOD;\n            }\n        }\n        cur ^= 1;\n    }\n    \n    state_t full;\n    full.flip();\n    cout << dp[cur][m.mapping[full]] << '\\n';\n    \n    return 0;\n}\n</origi