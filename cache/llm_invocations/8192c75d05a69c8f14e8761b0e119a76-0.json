ges[i].cost) {\n                    dist[v] = dist[u] + edges[i].cost;\n                    prevNode[v] = u;\n                    edgeId[v] = i;\n                    if (!inQueue[v]) {\n                        inQueue[v] = true;\n                        q.push(v);\n                    }\n                }\n            }\n        }\n        \n        if (dist[T] >= 0x3f3f3f3f) return false;\n        \n        int flow = 0x3f3f3f3f;\n        for (int v = T; v != S; v = prevNode[v]) {\n            flow = min(flow, edges[edgeId[v]].cap);\n        }\n        \n        totalCost += dist[T] * flow;\n        for (int v = T; v != S; v = prevNode[v]) {\n            edges[edgeId[v]].cap -= flow;\n            edges[edgeId[v] ^ 1].cap += flow;\n        }\n        return true;\n    }\n}\n\nusing namespace MCMF;\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &r, &c, &d);\n    memset(head, -1, sizeof(head));\n    \n    S = (r + n + 1) * n + 1;\n    T = (r + n + 1) * n + 2;\n    \n    for (int i = 1; i <= r; i++) {\n        int x;\n        scanf(\"%d\", &x);\n        occ[x]++;\n    }\n    \n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d%d\", &points[i].first, &points[i].second);\n    }\n    \n    for (int i = 0; i < r + n; i++) {\n        for (int j = 1; j <= m; j++) {\n            for (int k = 1; k <= r; k++) {\n                addEdge(i * n + points[j].first, (i + 1) * n + points[j].second, 1, (2 * k - 1) * d);\n                addEdge(i * n + points[j].second, (i + 1) * n + points[j].first, 1, (2 * k - 1) * d);\n            }\n        }\n    }\n    \n    for (int i = 1; i <= r + n; i++) {\n        addEdge(i * n + 1, T, 0x3f3f3f3f, i * c);\n        for (int j = 2; j <= n; j++) {\n            addEdge((i - 1) * n + j, i * n + j, 0x3f3f3f3f, 0);\n        }\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        addEdge(S, i, occ[i], 0);\n    }\n    \n    while (spfa());\n    \n    printf(\"%d\\n\", totalCost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample