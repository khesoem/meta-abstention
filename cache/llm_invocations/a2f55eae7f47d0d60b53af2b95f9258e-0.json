{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\nimport java.math.*;\n\npublic class Main {\n    private static final long MOD = 998244353L;\n    private static long[] factorial;\n    \n    public static void main(String[] args) {\n        InputReader in = new InputReader(System.in);\n        PrintWriter out = new PrintWriter(System.out);\n        \n        int N = in.readInt();\n        long K = in.readLong();\n        \n        if (K >= N) {\n            out.println(0);\n            out.close();\n            return;\n        }\n        \n        int C = N - (int)K;\n        \n        factorial = new long[200001];\n        factorial[0] = 1;\n        for (int i = 1; i <= 200000; i++) {\n            factorial[i] = (i * factorial[i-1]) % MOD;\n        }\n        \n        long total = 0;\n        int parity = 1;\n        for (int i = C; i >= 1; i--) {\n            long term = (nChooseK(C, i) * fastPow(i, N, MOD)) % MOD;\n            total = (total + parity * term + 2 * MOD) % MOD;\n            parity = -parity;\n        }\n        \n        long factor = (C == N) ? 1 : (2 * nChooseK(N, C)) % MOD;\n        out.println((total * factor) % MOD);\n        out.close();\n    }\n    \n    private static long nChooseK(int n, int k) {\n        long denom = (factorial[k] * factorial[n - k]) % MOD;\n        long invDenom = fastPow(denom, MOD - 2, MOD);\n        return (factorial[n] * invDenom) % MOD;\n    }\n    \n    private static long fastPow(long base, long exp, long modulus) {\n        if (exp < 0) return 0L;\n        long result = 1;\n        base %= modulus;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % modulus;\n            }\n            base = (base * base) % modulus;\n            exp >>= 1;\n        }\n        return result;\n    }\n    \n    static class InputReader {\n        BufferedReader reader;\n        StringTokenizer tokenizer;\n        \n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream));\n        }\n        \n        public String next() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n        \n        public int readInt() {\n            return Integer.parseInt(next());\n        }\n        \n        public long readLong() {\n            return Long.parseLong(next());\n        }\n        \n        public double readDouble() {\n            return Double.parseDouble(next());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\n\nconst long long MOD = 998244353LL;\nvector<long long> factorial;\n\nlong long nChooseK(int n, int k);\nlong long fastPow(long long base, long long exp, long long modulus);\n\nclass InputReader {\nprivate:\n    istream& stream;\n    string buffer;\n    size_t pos;\n    \npublic:\n    InputReader(istream& s) : stream(s), pos(0) {}\n    \n    string next() {\n        while (true) {\n            if (pos >= buffer.size()) {\n                if (!getline(stream, buffer)) {\n                    throw runtime_error(\"End of input\");\n                }\n                pos = 0;\n            }\n            \n            while (pos < buffer.size() && isspace(buffer[pos])) {\n                pos++;\n            }\n            \n            if (pos >= buffer.size()) continue;\n            \n            size_t start = pos;\n            while (pos < buffer.size() && !isspace(buffer[pos])) {\n                pos++;\n            }\n            return buffer.substr(start, pos - start);\n        }\n    }\n    \n    int readInt() {\n        return stoi(next());\n    }\n    \n    long long readLong() {\n        return stoll(next());\n    }\n    \n    double readDouble() {\n        return stod(next());\n    }\n};\n\nint main() {\n    InputReader in(cin);\n    cout.tie(nullptr);\n    \n    int N = in.readInt();\n    long long K = in.readLong();\n    \n    if (K >= N) {\n        cout << 0 << endl;\n        return 0;\n    }\n    \n    int C = N - (int)K;\n    \n    factorial.resize(200001);\n    factorial[0] = 1;\n    for (int i = 1; i <= 200000; i++) {\n        factorial[i] = (i * factorial[i-1]) % MOD;\n    }\n    \n    long long total = 0;\n    int parity = 1;\n    for (int i = C; i >= 1; i--) {\n        long long term = (nChooseK(C, i) * fastPow(i, N, MOD)) % MOD;\n        total = (total + parity * term + 2 * MOD) % MOD;\n        parity = -parity;\n    }\n    \n    long long factor = (C == N) ? 1 : (2 * nChooseK(N, C)) % MOD;\n    cout << (total * factor) % MOD << endl;\n    \n    return 0;\n}\n\nlong long nChooseK(int n, int k) {\n    long long denom = (factorial[k] * factorial[n - k]) % MOD;\n    long long invDenom = fastPow(denom, MOD - 2, MOD);\n    return (factorial[n] * invDenom) % MOD;\n}\n\nlong long fastPow(long long base, long long exp, long long modulus) {\n    if (exp < 0) return 0LL;\n    long long result = 1;\n    base %= modulus;\n    while (exp > 0) {\n        if ((exp & 1) == 1) {\n            result = (result * base) % modulus;\n        }\n        base = (base * base) % modulus;\n        exp >>= 1;\n    }\n    return result;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001774868869688362, -2.622600959512056e-06, -5.960462772236497e-07, -0.0017873755423352122, -3.576278118089249e-07, -8.4638240878121e-06, -3.099436753473128e-06, -2.7418097943154862e-06, -1.0728830375228426e-06, -0.1066025123000145, -8.22540732769994e-06, -0.0002774807217065245, -2.622600959512056e-06, -0.014962118119001389, -4.672895011026412e-05, -0.0002343380037928, -2.3841830625315197e-06, -0.04492459073662758, -5.8530047681415454e-05, -0.004079948179423809, -5.960462772236497e-07, -0.5597566366195679, -0.04299968108534813, -0.31328344345092773, -5.960462772236497e-07, -0.11024674773216248, -0.42870306968688965, -0.3869292438030243, -1.549708758830093e-05, -2.861018856492592e-06, -9.536738616588991e-07, -0.005371660925447941, -7.629365427419543e-06, -1.1444026313256472e-05, -3.814689989667386e-06, 0.0, 0.0, 0.0, 0.0, -5.960462772236497e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -5.006777428206988e-06, -9.536738616588991e-07, -3.576278118089249e-07, -1.0728830375228426e-06, -0.12002705782651901, -0.2519301474094391, -1.6927575416048057e-05, -2.3841855067985307e-07, -9.179073458653875e-06, -8.344646857949556e-07, -8.344646857949556e-07, -0.004747665952891111, -0.004196053370833397, -2.276871418871451e-05, -0.7876797318458557, -0.002795837353914976, -3.576272320060525e-06, -0.0009140365873463452, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.3