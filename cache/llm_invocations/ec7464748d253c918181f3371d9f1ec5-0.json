ile q:\n            u = q.pop(0)\n            inq[u] = False\n            i = head[u]\n            while i != -1:\n                v = to[i]\n                w = cap[i]\n                c = cost[i]\n                if w and dis[v] > dis[u] + c:\n                    dis[v] = dis[u] + c\n                    flow[v] = min(flow[u], w)\n                    pre[v] = u\n                    las[v] = i\n                    if not inq[v]:\n                        q.append(v)\n                        inq[v] = True\n                i = nxt[i]\n        return pre[t] != 0\n\n    max_flow = 0\n    min_cost = 0\n    while spfa():\n        u = t\n        fl = flow[t]\n        max_flow += fl\n        min_cost += fl * dis[t]\n        while u != s:\n            cap[las[u]] -= fl\n            cap[las[u] ^ 1] += fl\n            u = pre[u]\n\n    write_int(min_cost)\n    sys.stdout.write('\\n')\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.242440288886428e-05, 0.0, 0.0, -0.00020776021119672805, -0.00016592556494288146, 0.0, -0.2519931495189667, -0.3196822702884674, -3.576278118089249e-07, -0.0007099968497641385, -3.373566141817719e-05, -0.2519294023513794, -1.1920928244535389e-07, -0.004705902189016342, -0.05255265533924103, -0.7981840968132019, -0.06960693001747131, 0.0, -0.00011562632425921038, -9.536738616588991e-07, -0.016717931255698204, 0.0, -0.0024947968777269125, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -0.011047743260860443, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -0.021408190950751305, -0.17931121587753296, -5.960462772236497e-07, 0.0, -1.1920922133867862e-06, -6.735097849741578e-05, -0.01119817141443491, -0.06652567535638809, -0.12918005883693695, -2.7418097943154862e-06, -0.0001225396408699453, 0.0, -0.3134705126285553, 0.0, 0.0, -2.3841855067985307e-07, -9.536738616588991e-07, -0.018189646303653717, -0.17452779412269592, -0.6191972494125366, -1.8358061424805783e-05, -2.3841855067985307e