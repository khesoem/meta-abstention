{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MX = 5500;\nconst long long INF = 1E9 + 7;\n\nstruct Edge {\n    int to;\n    int cost;\n    int rev;\n    int cap;\n};\n\nint n, m, k, c, d;\nint u, v, mx, s = MX - 2, t = MX - 1, mf = 0;\nint tr[MX];\nlong long ans = 0, dis[MX];\nvector<Edge> edges;\nvector<int> adj[MX];\npriority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;\n\nvoid add_edge(int u, int v, int cost, int cap) {\n    int fwd = edges.size();\n    int rev = fwd + 1;\n    edges.push_back({v, cost, rev, cap});\n    edges.push_back({u, -cost, fwd, 0});\n    adj[u].push_back(fwd);\n    adj[v].push_back(rev);\n}\n\nvoid dijkstra() {\n    fill(dis, dis + MX, INF);\n    pq.push({dis[s] = 0, s});\n    while (!pq.empty()) {\n        auto [du, x] = pq.top();\n        pq.pop();\n        if (du > dis[x]) continue;\n        for (int eid : adj[x]) {\n            Edge &e = edges[eid];\n            if (e.cap > 0 && dis[e.to] > du + e.cost) {\n                tr[e.to] = e.rev;\n                pq.push({dis[e.to] = du + e.cost, e.to});\n            }\n        }\n    }\n}\n\nvoid trace() {\n    int delta = k, v = t;\n    while (v != s) {\n        int rev_id = tr[v];\n        int nxt = edges[rev_id].to;\n        int fwd_id = edges[rev_id].rev;\n        delta = min(delta, edges[fwd_id].cap);\n        v = nxt;\n    }\n    mf += delta;\n    ans += delta * dis[t];\n    v = t;\n    while (v != s) {\n        int rev_id = tr[v];\n        int nxt = edges[rev_id].to;\n        int fwd_id = edges[rev_id].rev;\n        edges[rev_id].cap += delta;\n        edges[fwd_id].cap -= delta;\n        v = nxt;\n    }\n}\n\nint at(int u, int tm) {\n    return u + tm * n;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    mx = n + k;\n    for (int i = 0; i < k; i++) {\n        cin >> u;\n        add_edge(s, at(u, 0), 0, 1);\n    }\n    for (int i = 0; i <= mx; i++)\n        add_edge(at(1, i), t, c * i, k);\n    for (int i = 1; i <= n; i++)\n        for (int j = 0; j < mx; j++)\n            add_edge(at(i, j), at(i, j + 1), 0, k);\n    while (m--) {\n        cin >> u >> v;\n        for (int i = 1; i <= k; i++)\n            for (int j = 0; j < mx; j++) {\n                add_edge(at(u, j), at(v, j + 1), d * (2 * i - 1), 1);\n                add_edge(at(v, j), at(u, j + 1), d * (2 * i - 1), 1);\n            }\n    }\n    while (mf < k) {\n        dijkstra();\n        trace();\n    }\n    cout << ans;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MX = 5500;\n    static final long INF = 1000000007L;\n\n    static class Edge {\n        int to;\n        int cost;\n        int rev;\n        int cap;\n        Edge(int to, int cost, int rev, int cap) {\n            this.to = to;\n            this.cost = cost;\n            this.rev = rev;\n            this.cap = cap;\n        }\n    }\n\n    static int n, m, k, c, d;\n    static int u, v, mx, s = MX - 2, t = MX - 1, mf = 0;\n    static int[] tr = new int[MX];\n    static long ans = 0;\n    static long[] dis = new long[MX];\n    static List<Edge> edges = new ArrayList<>();\n    static List<Integer>[] adj = new ArrayList[MX];\n    static PriorityQueue<Node> pq = new PriorityQueue<>();\n\n    static class Node implements Comparable<Node> {\n        long dist;\n        int id;\n        Node(long dist, int id) {\n            this.dist = dist;\n            this.id = id;\n        }\n        public int compareTo(Node other) {\n            return Long.compare(this.dist, other.dist);\n        }\n    }\n\n    static void add_edge(int u, int v, int cost, int cap) {\n        int fwd = edges.size();\n        int rev = fwd + 1;\n        edges.add(new Edge(v, cost, rev, cap));\n        edges.add(new Edge(u, -cost, fwd, 0));\n        adj[u].add(fwd);\n        adj[v].add(rev);\n    }\n\n    static void dijkstra() {\n        Arrays.fill(dis, INF);\n        pq.clear();\n        pq.add(new Node(0, s));\n        dis[s] = 0;\n        while (!pq.isEmpty()) {\n            Node cur = pq.poll();\n            long du = cur.dist;\n            int x = cur.id;\n            if (du > dis[x]) continue;\n            for (int eid : adj[x]) {\n                Edge e = edges.get(eid);\n                if (e.cap > 0 && dis[e.to] > du + e.cost) {\n                    tr[e.to] = e.rev;\n                    dis[e.to] = du + e.cost;\n                    pq.add(new Node(dis[e.to], e.to));\n                }\n            }\n        }\n    }\n\n    static void trace() {\n        int delta = k;\n        int v = t;\n        while (v != s) {\n            int rev_id = tr[v];\n            int nxt = edges.get(rev_id).to;\n            int fwd_id = edges.get(rev_id).rev;\n            delta = Math.min(delta, edges.get(fwd_id).cap);\n            v = nxt;\n        }\n        mf += delta;\n        ans += delta * dis[t];\n        v = t;\n        while (v != s) {\n            int rev_id = tr[v];\n            int nxt = edges.get(rev_id).to;\n            int fwd_id = edges.get(rev_id).rev;\n            edges.get(rev_id).cap += delta;\n            edges.get(fwd_id).cap -= delta;\n            v = nxt;\n        }\n    }\n\n    static int at(int u, int tm) {\n        return u + tm * n;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        mx = n + k;\n        for (int i = 0; i < MX; i++) {\n            adj[i] = new ArrayList<>();\n        }\n        for (int i = 0; i < k; i++) {\n            u = sc.nextInt();\n            add_edge(s, at(u, 0), 0, 1);\n        }\n        for (int i = 0; i <= mx; i++) {\n            add_edge(at(1, i), t, c * i, k);\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                add_edge(at(i, j), at(i, j + 1), 0, k);\n            }\n        }\n        for (int i = 0; i < m; i++) {\n            u = sc.nextInt();\n            v = sc.nextInt();\n            for (int j = 1; j <= k; j++) {\n                for (int tm = 0; tm < mx; tm++) {\n                    add_edge(at(u, tm), at(v, tm + 1), d * (2 * j - 1), 1);\n                    add_edge(at(v, tm), at(u, tm + 1), d * (2 * j - 1), 1);\n                }\n            }\n        }\n        while (mf < k) {\n            dijkstra();\n            trace();\n        }\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.313963316031732e-05, 0.0, 0.0, -4.565611743601039e-05, -8.308542601298541e-05, 0.0, -0.0009116546134464443, -0.0017525089206174016, -0.0001760566228767857, 0.0, -0.006212092004716396, -0.011054109781980515, -0.00016008525562938303, -0.0025049042887985706, -0.31331655383110046, -3.576278118089249e-07, -2.38