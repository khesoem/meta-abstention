ject o) {\n                if (!(o instanceof Key)) return false;\n                Key k = (Key) o;\n                return n == k.n && h == k.h;\n            }\n            @Override\n            public int hashCode() {\n                return 31 * n + h;\n            }\n        }\n        \n        long go(int n, int h) {\n            Key key = new Key(n, h);\n            Long cached = cache.get(key);\n            if (cached != null) return cached;\n            long result;\n            if (n == 0) {\n                result = 1;\n            } else if (h == 0) {\n                result = 0;\n            } else {\n                long sum = 0;\n                for (int i = 0; i < n; i++) {\n                    sum += go(i, h - 1) * go(n - 1 - i, h - 1);\n                }\n                result = sum;\n            }\n            cache.put(key, result);\n            return result;\n        }\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        String line = sc.nextLine();\n        String[] parts = line.split(\" \");\n        int n = Integer.parseInt(parts[0]);\n        int h = Integer.parseInt(parts[1]);\n        TreeCounter counter = new TreeCounter();\n        long result = counter.go(n, n) - counter.go(n, Math.max(0, h - 1));\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.050629131495952606, -6.9141146923357155e-06, 0.0, -1.1920928244535389e-07, -1.2874520507466514e-05, -7.772143726469949e-05, 0.0, -2.9802276912960224e-06, -0.0023078492376953363, -0.029758170247077942, 0.0, -0.003189241047948599, -0.00012444675667211413, -1.680836794548668e-05, -0.0001787979417713359, -1.1920928244535389e-07, -2.825220326485578e-05, 0.0, 0.0, -1.1920928244535389e-07, -0.008619958534836769, -0.0014649622607976198, -1.1920928244535389e-07, -2.2411095415009186e-05, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, 0.0, -1.5497195136049413e-0