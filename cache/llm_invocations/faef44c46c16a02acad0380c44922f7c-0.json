space K {\n    ll n, m, k, c, d;\n}\nvector<ll> vr[55];\nll lr[50];\nint main()\n{\n    ll N = 50*99+1, M, K = INF;\n    vector<vector<Edge>> g(N);\n    ll s, t;\n\n    cin >> K::n >> K::m >> K::k >> K::c >> K::d;\n\n    ll tim = 99;\n    for (int i = 1; i <= K::k; ++i) {\n        cin >> lr[i];\n        addEdge(g, 0, lr[i], 1, 0);\n    }\n    for (int j = 0; j < tim-1; ++j) {\n        for (int i = 2; i <= K::n; ++i)\n            addEdge(g, j*50+i, (j+1)*50+i, 50, K::c);\n    }\n    for (int j = 1; j < tim; ++j) {\n        addEdge(g, j*50+1, 1, 50, 0);\n    }\n    for (int i = 0; i < K::m; ++i) {\n        ll x, y;\n        cin >> x >> y;\n        vr[x].push_back(y);\n        vr[y].push_back(x);\n        for (int j = 0; j < tim-1; ++j) {\n            for (int l = 0; l < 50; ++l) {\n                addEdge(g, j*50+x, (j+1)*50+y, 1, K::c + K::d * ((l+1)*(l+1) - l*l));\n                addEdge(g, j*50+y, (j+1)*50+x, 1, K::c + K::d * ((l+1)*(l+1) - l*l));\n            }\n        }\n    }\n    s = 0, t = 1;\n\n    ll flow = 0, cost = 0;\n    while (flow < K) {\n        vector<ll> dist(N, INF);\n        vector<ll> prevv(N, -1);\n        vector<size_t> preve(N);\n        queue<ll> q;\n        vector<bool> inq(N, false);\n        q.push(s);\n        dist[s] = 0;\n        inq[s] = true;\n        while (!q.empty()) {\n            ll v = q.front(); q.pop();\n            inq[v] = false;\n            for (size_t i = 0; i < g[v].size(); ++i) {\n                Edge &e = g[v][i];\n                if (e.flow < e.cap && dist[v] + e.cost < dist[e.to]) {\n                    dist[e.to] = dist[v] + e.cost;\n                    prevv[e.to] = v;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        q.push(e.to);\n                        inq[e.to] = true;\n                    }\n                }\n            }\n        }\n        if (dist[t] == INF) break;\n        ll add = K - flow;\n        for (ll v = t; v != s; v = prevv[v]) {\n          