  # next available index\n    \n    inds = [[-1]*n for _ in range(n)]\n    inds2 = [[-1]*n for _ in range(n)]\n    \n    # Adjacency list: for each node, list of edges [to, cap, rev]\n    adj = [[] for _ in range(500)]  # enough space, will expand if needed\n    \n    def add_edge(f, t, c):\n        nonlocal node_count\n        # Ensure adjacency list size\n        max_node = max(f, t) + 1\n        while len(adj) <= max_node:\n            adj.append([])\n        # forward edge\n        adj[f].append([t, c, len(adj[t])])\n        # reverse edge\n        adj[t].append([f, 0, len(adj[f]) - 1])\n    \n    # First pass: assign indices for digits in gr and gr2, add source/sink edges\n    rp = cp = -1\n    for i in range(n):\n        for j in range(n):\n            if '1' <= gr[i][j] <= '9':\n                inds[i][j] = node_count\n                add_edge(S, node_count, ord(gr[i][j]) - ord('0'))\n                node_count += 1\n            if gr[i][j] == 'Z':\n                rp, cp = i, j\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= gr2[i][j] <= '9':\n                inds2[i][j] = node_count\n                add_edge(node_count, T, ord(gr2[i][j]) - ord('0'))\n                node_count += 1\n    \n    # BFS for each digit in gr\n    def valid(a, b):\n        return 0 <= a < n and 0 <= b < n\n    \n    def busc(a, b):\n        # local arrays for BFS\n        mk = [[0]*n for _ in range(n)]\n        c = [[-1]*n for _ in range(n)]\n        # mark all 'Y' cells as 1\n        for i in range(n):\n            for j in range(n):\n                if gr[i][j] == 'Y':\n                    mk[i][j] = 1\n        q = deque()\n        q.append((rp, cp))\n        q.append((a, b))\n        c[a][b] = 0\n        c[rp][cp] = 0\n        mk[a][b] = 1\n        mk[rp][cp] = 2\n        while q:\n            now = q.popleft()\n            x, y = now\n            # If from a 'Y' cell (mk==1) and current cell is a digit in gr2, add edge\n            if mk[x][y] == 1 and '1' <= gr2[x][y] <= '9':\n                add_edge(inds[a][b], inds2[x][y], 9)\n            # If from a 'Y' cell and distance == t, do not expand further\n            if mk[x][y] == 1 and c[x][y] == t:\n                continue\n            for d in range(4):\n                nx = x + dx[d]\n                ny = y + dy[d]\n                if valid(nx, ny):\n                    if mk[nx][ny] == 0:\n                        mk[nx][ny] = mk[x][y]\n                        c[nx][ny] = c[x][y] + 1\n                        q.append((nx, ny))\n                    elif mk[x][y] == 1 and mk[nx][ny] == 2 and c[nx][ny] == c[x][y] + 1 and '1' <= gr2[nx][ny] <= '9':\n                        add_edge(inds[a][b], inds2[nx][ny], 9)\n    \n    # Add direct edges and call busc for each digit in gr\n    for i in range(n):\n        for j in range(n):\n            if '1' <= gr[i][j] <= '9':\n                if '1' <= gr2[i][j] <= '9':\n                    add_edge(inds[i][j], inds2[i][j], 9)\n                busc(i, j)\n    \n    # Dinic max flow\n    level = [0]*len(adj)\n    copy_adj = [0]*len(adj)\n    \n    def bfs(source, sink):\n        for i in range(len(level)):\n            level[i] = -1\n        level[source] = 0\n        q = deque([source])\n        while q:\n            u = q.popleft()\n            for edge in adj[u]:\n                if edge[1] > 0 and level[edge[0]] == -1:\n                    level[edge[0]] = level[u] + 1\n                    q.append(edge[0])\n        return level[sink] != -1\n    \n    def dfs(u, sink, flow):\n        if u == sink:\n            return flow\n        for i in range(copy_adj[u], len(adj[u])):\n            copy_adj[u] = i\n            edge = adj[u][i]\n            if edge[1] > 0 and level[u] + 1 == level[edge[0]]:\n                nflow = dfs(edge[0], sink, min(flow, edge[1]))\n                if nflow:\n                    edge[1] -= nflow\n                    adj[edge[0]][edge[2]][1] += nflow\n                    return nflow\n        return 0\n    \n    def maxflow(source, sink):\n        flow = 0\n        while bfs(source, sink):\n            for i in range(len(copy_adj)):\n                copy_adj[i] = 0\n            while True:\n                add = dfs(source, sink, 1<<30)\n                if add:\n                    flow += add\n                else:\n                    break\n        return flow\n    \n    result = maxflow(S, T)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.4305104514278355e-06, 0.0, -1.1920928244535389e-07, -0.0012056708801537752, -0.0005772831500507891, 0.0, -3.0397906812140718e-05, -0.3213502764701843, -1.9073468138230965e-06, 0.0, -4.768370445162873e-07, -0.04860095679759979, -0.48807424306869507, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.011096198111772537, -0.0031785464379936457, -0.02331276424229145, -0.006817059125751257, -0.8648918271064758, -0.9853838682174683, -0.006767922081053257, -3.4570634852570947e-06, -0.20948448777198792, -3.576278118089249e-07, -0.00012516192509792745, 0.0, -0.00017271934484597296, -1.1920922133867862e-06, -0.06196951866149902, -0.008633667603135109, -9.536738616588991e-07, -0.13359224796295166, -7.867782187531702e-06, 0.0, -0.0009114163694903255, -2.3841855067985307e-07, 0.0, -3.099436753473128e-06, -1.1920928244535389e-07, -0.09891141206026077, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.6954811548639555e-06, -1.0728830375228426e-06, -1.8000440832111053e-05, -6.556489552167477e-06, 0.0, 0.0, 0.0, -0.0001528146385680884, 0.0, -0.0005710878176614642, -0.00028868322260677814, 0.0, 0.0, 0.0, -0.1602431982755661, -0.38687774538993835, -1.6689286894688848e-06, -0.6064378023147583, 0.0, -0.396136999130249, -1.1920928244535389e-07, -0.002009041141718626, -0.004078761208802462, -1.5497195136049413e-06, 0.0, -5.960462772236497e-07, -1.7881377516459906e-06, -4.291525328881107e-06, -0.21360985934734344, -7