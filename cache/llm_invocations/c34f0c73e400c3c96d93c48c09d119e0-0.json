{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing lint = long long;\nconst lint MOD = 1000000007;\n\ninline lint mod_add(lint a, lint b) { return (a + b) % MOD; }\ninline lint mod_sub(lint a, lint b) { return ((a - b) % MOD + MOD) % MOD; }\ninline lint mod_mul(lint a, lint b) { return (a * b) % MOD; }\n\nlint mod_pow(lint base, lint exp) {\n    lint res = 1;\n    while (exp) {\n        if (exp & 1) res = mod_mul(res, base);\n        base = mod_mul(base, base);\n        exp >>= 1;\n    }\n    return res;\n}\n\nlint mod_inv(lint x) { return mod_pow(x, MOD - 2); }\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n;\n    cin >> n;\n    \n    vector<vector<lint>> A(n, vector<lint>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> A[i][j];\n            A[i][j] = mod_mul(A[i][j], mod_inv(100));\n        }\n    \n    vector<int> cnt_bits(1 << n);\n    for (int m = 0; m < (1 << n); ++m)\n        cnt_bits[m] = __builtin_popcount(m);\n    \n    vector<vector<int>> masks_by_cnt(n + 1);\n    for (int m = 0; m < (1 << n); ++m)\n        masks_by_cnt[cnt_bits[m]].push_back(m);\n    \n    vector<vector<vector<lint>>> T(n + 1, vector<vector<lint>>(n + 1, vector<lint>(1 << n, 0)));\n    for (int k = 0; k <= n; ++k) {\n        for (int idx = 0; idx < (int)masks_by_cnt[k].size(); ++idx) {\n            int cm = masks_by_cnt[k][idx];\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if ((mask & cm) == mask) continue;\n                lint val = 0;\n                for (int x = 0; x < n; ++x) {\n                    if (cm & (1 << x)) continue;\n                    if (!(mask & (1 << x))) continue;\n                    int nm = cm | (1 << x);\n                    val |= (1LL << (int)masks_by_cnt[cnt_bits[nm]].size());\n                }\n                T[k][idx][mask] = val;\n            }\n        }\n    }\n    \n    vector<unordered_map<lint, lint>> DP(n + 1);\n    DP[0][1] = 1;\n    \n    for (int k = 0; k < n; ++k) {\n        for (int edges = 0; edges < (1 << n); ++edges) {\n            lint prob = 1;\n            for (int i = 0; i < n; ++i) {\n                lint p = (edges >> i) & 1 ? A[k][i] : mod_sub(1, A[k][i]);\n                prob = mod_mul(prob, p);\n            }\n            for (auto& [mask, val] : DP[k]) {\n                lint newmask = 0;\n                lint p = mod_mul(prob, val);\n                for (int i = 0; i < (int)masks_by_cnt[k].size(); ++i) {\n                    if (mask & (1 << i))\n                        newmask |= T[k][i][edges];\n                }\n                if (newmask)\n                    DP[k + 1][newmask] = mod_add(DP[k + 1][newmask], p);\n            }\n        }\n    }\n    \n    cout << DP[n][1] << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\n\ndef mod_add(a, b):\n    return (a + b) % MOD\n\ndef mod_sub(a, b):\n    return ((a - b) % MOD + MOD) % MOD\n\ndef mod_mul(a, b):\n    return (a * b) % MOD\n\ndef mod_pow(base, exp):\n    res = 1\n    while exp:\n        if exp & 1:\n            res = mod_mul(res, base)\n        base = mod_mul(base, base)\n        exp >>= 1\n    return res\n\ndef mod_inv(x):\n    return mod_pow(x, MOD - 2)\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    index = 1\n    \n    A = [[0] * n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            A[i][j] = int(data[index])\n            index += 1\n            A[i][j] = mod_mul(A[i][j], mod_inv(100))\n    \n    cnt_bits = [0] * (1 << n)\n    for m in range(1 << n):\n        cnt_bits[m] = bin(m).count('1')\n    \n    masks_by_cnt = [[] for _ in range(n + 1)]\n    for m in range(1 << n):\n        masks_by_cnt[cnt_bits[m]].append(m)\n    \n    T = [[[0] * (1 << n) for _ in range(len(masks_by_cnt[k]))] for k in range(n + 1)]\n    for k in range(n + 1):\n        for idx in range(len(masks_by_cnt[k])):\n            cm = masks_by_cnt[k][idx]\n            for mask in range(1 << n):\n                if (mask & cm) == mask:\n                    continue\n                val = 0\n                for x in range(n):\n                    if cm & (1 << x):\n                        continue\n                    if not (mask & (1 << x)):\n                        continue\n                    nm = cm | (1 << x)\n                    bit_pos = len(masks_by_cnt[cnt_bits[nm]])\n                    val |= (1 << bit_pos)\n                T[k][idx][mask] = val\n    \n    DP = [defaultdict(int) for _ in range(n + 1)]\n    DP[0][1] = 1\n    \n    for k in range(n):\n        for edges in range(1 << n):\n            prob = 1\n            for i in range(n):\n                p = A[k][i] if (edges >> i) & 1 else mod_sub(1, A[k][i])\n                prob = mod_mul(prob, p)\n            \n            for mask, val in DP[k].items():\n            