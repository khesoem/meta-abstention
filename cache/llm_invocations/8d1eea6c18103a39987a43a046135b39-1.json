          q.pop();\n            inq[now]=0;\n            for (int i=0;i<sz(G[now]);i++)\n            {\n                edge &e=G[now][i];\n                if (e.cap>0&&dist[now]+e.cost<dist[e.to])\n                {\n                    dist[e.to]=dist[now]+e.cost;\n                    prevv[e.to]=now;\n                    preve[e.to]=i;\n                    if (!inq[e.to]) inq[e.to]=1,q.push(e.to);\n                }\n            }\n        }\n\n        if (dist[t]==inff) return -1;\n\n        int d=f;\n        for (int v=t;v!=s;v=prevv[v])\n        {\n            d=min(d,G[prevv[v]][preve[v]].cap);\n        }\n        f-=d;\n        res+=d*dist[t];\n        for (int v=t;v!=s;v=prevv[v])\n        {\n            edge &e=G[prevv[v]][preve[v]];\n            e.cap-=d;\n            G[v][e.rev].cap+=d;\n        }\n    }\n    return res;\n}\n\nint N,M,K,C,D,X,Y;\nint A[58];\nvector<int> H[57];\n\nint32_t main()\n{\n    IOS\n    cin>>N>>M>>K>>C>>D;\n    for (int i=1;i<=K;i++)\n    {\n        cin>>X;\n        A[X]++;\n    }\n    for (int i=1;i<=M;i++)\n    {\n        cin>>X>>Y;\n        H[X].pb(Y);\n        H[Y].pb(X);\n    }\n\n    init(5103,0,5101);\n    for (int i=2;i<=N;i++) add_edge(0,i,A[i],0);\n    for (int i=0;i<=100;i++)\n    {\n        for (int l=1;l<=N;l++)\n        {\n            add_edge(50*i+l,50*(i+1)+l,K,0);\n            for (int j:H[l])\n            {\n                for (int k=1;k<=K;k++)\n                {\n                    add_edge(50*i+l,50*(i+1)+j,1,D*(2*k-1));\n                }\n            }\n        }\n    }\n    for (int i=1;i<=101;i++) add_edge(50*i+1,5101,K,C*i);\n    cout<<min_cost_flow(K)<<endl;\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    sys.stdin = open(0, 'r')\n    sys.stdout = open(1, 'w')\n    \n    N, M, K, C, D = map(int, sys.stdin.readline().split())\n    \n    A = [0] * (N + 1)\n    for _ in range(K):\n        X = int(sys.stdin.readline())\n        A[X] += 1\n    \n    H = [[] for _ in range(N + 1)]\n    for _ in range(M):\n        X, Y = map(int, sys.stdin.readline().split())\n        H[X].append(Y)\n        H[Y].append(X)\n    \n    # Graph setup\n    maxn = 6000\n    inf = float('inf')\n    mod = 10**9 + 7\n    \n    class Edge:\n        __slots__ = ('to', 'cap', 'cost', 'rev')\n        def __init__(self, to, cap, cost, rev):\n            self.to = to\n            self.cap = cap\n            self.cost = cost\n            self.rev = rev\n    \n    G = [[] for _ in range(maxn)]\n    \n    def add_edge(from_node, to_node, cap, cost):\n        G[from_node].append(Edge(to_node, cap, cost, len(G[to_node])))\n        G[to_node].append(Edge(from_node, 0, -cost, len(G[from_node]) - 1))\n    \n    def min_cost_flow(f):\n        res = 0\n        while f > 0:\n            dist = [inf] * 5103\n            dist[0] = 0\n            prevv = [-1] * 5103\n            preve = [-1] * 5103\n            inq = [0] * 5103\n            q = deque()\n            q.append(0)\n            inq[0] = 1\n            \n            while q:\n                now = q.popleft()\n                inq[now] = 0\n                for i, e in enumerate(G[now]):\n                    if e.cap > 0 and dist[now] + e.cost < dist[e.to]:\n                        dist[e.to] = dist[now] + e.cost\n                        prevv[e.to] = now\n                        preve[e.to] = i\n                        if not inq[e.to]:\n                            inq[e.to] = 1\n                            q.append(e.to)\n            \n            if dist[5101] == inf:\n                return -1\n            \n            d = f\n            v = 5101\n            while v != 0:\n                d = min(d, G[prevv[v]][preve[v]].cap)\n                v = prevv[v]\n            \n            f -= d\n            res += d * dist[5101]\n            \n            v = 5101\n            while v != 0:\n                e = G[prevv[v]][preve[v]]\n                e.cap -= d\n                G[v][e.rev].cap += d\n                v = prevv[v]\n        \n        return res\n    \n    # Initialize graph\n    for i in range(5103):\n        G[i].clear()\n    \n    for i in range(2, N + 1):\n        add_edge(0, i, A[i], 0)\n    \n    for i in range(101):\n        for l in range(1, N + 1):\n            add_edge(50 * i + l, 50 * (i + 1) + l, K, 0)\n            for j in H[l]:\n                for k in range(1, K + 1):\n                    add_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1))\n    \n    for i in range(1, 102):\n        add_edge(50 * i + 1, 5101, K, C * i)\n    \n    print(min_cost_flow(K))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001472126314183697, -7.152555099310121e-07, -4.768370445162873e-07, -0.0031798535492271185, -0.0012536532012745738, -4.768370445162873e-07, -0.00010084597306558862, -0.0002205128694185987, -5.960462772236497e-07, -0.0017080017132684588, -0.22052104771137238, -0.24391908943653107, -0.337671160697937, -8.344646857949556e-07, -1.7881377516459906e-06, -0.4495568871498108, -0.008805611170828342, -0.0006724718841724098, -0.000764673575758934, -8.618460560683161e-05, -1.1920922133867862e-06, -0.4295808672904968, -0.00026723151677288115, -0.002496223896741867, -0.012518871575593948, -0.00038115866482257843, -0.000582644424866885, -3.3378044463461265e-05, -2.3841855067985307e-07, -5.125986263010418e-06, -2.3841855067985307e-07, -1.4305104514278355e-06, -1.1920928244535389e-07, 0.0, -2.264974000354414e-06, -0.03434149920940399, -0.01251345593482256, -3.576272320060525e-06, -1.3469942808151245, -1.4662635294371285e-05, -2.3841855067985307e-07, -4.768370445162873e-07, -3.576278118089249e-07, -5.6265202147187665e-05, -1.9073468138230965e-06, -4.768370445162873e-07, -3.576278118089249e-07, -2.145764938177308e-06, -6.5205356804654e-05, -0.007748