ng long ans = powmod(m, n, mod);\n    for (int i = 1; i <= n; i++) popcnt[i] = popcnt[i >> 1] + (i & 1);\n    if (n & 1) {\n        cout << ans << endl;\n        return 0;\n    }\n    dp[0][0] = 1;\n    int limit = min(0LL + popcnt[n], m);\n    for (int i = 0; i < limit; i++) {\n        for (int j = 0; j < n; j++) {\n            if (!dp[i][j]) continue;\n            int x = n ^ j;\n            for (int k = x, r; k > j; k = (k - 1) & x) {\n                r = k | j;\n                add(dp[i + 1][r], dp[i][j] * inv_fact[k]);\n            }\n        }\n    }\n    long long sum = 0;\n    for (int i = 1; i <= m; i++)\n        sum = (sum + dp[i][n] * fact[m] % mod * inv_fact[m - i] % mod * fact[n]) % mod;\n    ans = (ans - sum + mod) % mod;\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef modinv(a, mod):\n    b = mod\n u = 1\n v = 0\n while b:\n  t = a // b\n  a -= t * b\n  a, b = b, a\n  u -= t * v\n  u, v = v, u\n u %= mod\n if u < 0:\n  u += mod\n return u\n\ndef powmod(a, b, mod):\n res = 1\n while b:\n  if b & 1:\n   res = res * a % mod\n  a = a * a % mod\n  b >>= 1\n return res\n\ndef add(x, y):\n x += y\n if x >= mod:\n  x %= mod\n return x\n\ndef main():\n data = sys.stdin.read().split()\n n, m, mod = map(int, data)\n fact = [0] * (n + 1)\n inv_fact = [0] * (n + 1)\n fact[0] = fact[1] = 1\n for i in range(2, n + 1):\n  fact[i] = fact[i - 1] * i % mod\n inv_fact[0] = inv_fact[1] = 1\n for i in range(2, n + 1):\n  inv_i = modinv(i, mod)\n  inv_fact[i] = inv_fact[i - 1] * inv_i % mod\n ans = powmod(m, n, mod)\n popcnt = [0] * (n + 1)\n for i in range(1, n + 1):\n  popcnt[i] = popcnt[i >> 1] + (i & 1)\n if n & 1:\n  print(ans)\n  return\n limit = min(popcnt[n], m)\n dp = [{} for _ in range(limit + 1)]\n dp[0][0] = 1\n for i in range(limit):\n  for j, val in dp[i].items():\n   x = n ^ j\n  