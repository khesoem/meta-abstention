code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static final long INF64 = (long)1e18;\n    static final int N = 1000007;\n    static ArrayList<Integer>[] g = new ArrayList[N];\n    static ArrayList<Edge> e = new ArrayList<>();\n    static long[] dist = new long[N];\n    static int[] pred = new int[N];\n    static int[] pe = new int[N];\n    static int[] inq = new int[N];\n    static int source = N - 2;\n    static int target = N - 1;\n    static long ans = 0;\n    static int n, m, k, c, d;\n    static int timeLayers = 101;\n\n    static class Edge {\n        int from;\n        int to;\n        int f;\n        int cost;\n        Edge() {}\n        Edge(int _from, int _to, int _f, int _cost) {\n            from = _from;\n            to = _to;\n            f = _f;\n            cost = _cost;\n        }\n    }\n\n    static int residualCapacity(int x) {\n        return e.get(x).to - e.get(x).f;\n    }\n\n    static void dijkstra() {\n        for (int i = 0; i < N; i++) {\n            dist[i] = INF64;\n            pred[i] = -1;\n            pe[i] = -1;\n            inq[i] = 0;\n        }\n        dist[source] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.add(source);\n        inq[source] = 1;\n        while (!q.isEmpty()) {\n            int k = q.poll();\n            inq[k] = 0;\n            for (int x : g[k]) {\n                if (residualCapacity(x) == 0) continue;\n                int cost = e.get(x).cost;\n                int y = e.get(x).from;\n                if (dist[y] > dist[k] + cost) {\n                    dist[y] = dist[k] + cost;\n                    pred[y] = k;\n                    pe[y] = x;\n                    if (inq[y] == 0) {\n                        inq[y] = 1;\n                        q.add(y);\n                    }\n                }\n            }\n        }\n    }\n\n    static void pushFlow() {\n        dijkstra();\n        int cur = target;\n        while (cur != source) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = pred[cur];\n        }\n        ans += dist[target];\n    }\n\n    static void addEdge(int x, int y, int capacity, int cost) {\n        g[x].add(e.size());\n        e.add(new Edge(y, capacity, 0, cost));\n        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n\n    static void inputAndBuildGraph() throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n        for (int i = 0; i < k; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            addEdge(source, x, 1, 0);\n        }\n        for (int i = 0; i < timeLayers; i++) {\n            addEdge(i * n, target, k, i * c);\n        }\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int t = 0; t < timeLayers - 1; t++) {\n                for (int j = 0; j < k; j++) {\n                    addEdge(x + t * n, y + (t + 1) * n, 1, d * (j * 2 + 1));\n                }\n            }\n            for (int t = 0; t < timeLayers - 1; t++) {\n                for (int j = 0; j < k; j++) {\n                    addEdge(y + t * n, x + (t + 1) * n, 1, d * (j * 2 + 1));\n                }\n            }\n        }\n    }\n\n    static void solve() {\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < timeLayers - 1; j++) {\n                addEdge(i + j * n, i + (j + 1) * n, k, 0);\n            }\n        }\n        for (int i = 0; i < k; i++) {\n            pushFlow();\n        }\n        System.out.println(ans);\n    }\n\n    public static void main(String[] args) throws IOException {\n        for (int i = 0; i < N; i++) {\n            g[i] = new ArrayList<>();\n        }\n        inputAndBuildGraph();\n        solve();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.6961281895637512, -6.317892984952778e-05, 0.0, -1.1920928244535389e-07, -7.402622577501461e-05, -5.0424259825376794e-05, 0.0, -0.16022419929504395, -0.014178610406816006, 0.0, 0.0, -2.1576648578047752e-05, -0.0002494739310350269, -0.0002631794777698815, 0.0, -0.0068912929855287075, -0.0086353225633502, -0.00017236177518498152, -0.0029848332051187754, -0.023833448067307472, -0.10020712018013, 0.0, -0.0009115354623645544, 0.0, -0.018407121300697327, -4.768370445162873e-07, -4.768360213347478e-06, -0.38687458634376526, 0.0, -5.960462772236497e-07, -0.00010311071673640981, -0.0019286142196506262, -1.7165990357170813e-05, -0.015135208144783974, 0.0, -0.00033682872890494764, -1.1920928244535389e-07, -0.1269303560256958, -0.0031802100129425526, -5.960446742392378e-06, -0.001206861576065421, -0.11670936644077301, -0.048587895929813385, -4.0531076592742465e-06, -0.11034753173589706, -0.6933648586273193, -1.1920928244535389e-07, -1.4305104514278355e-06, -1.1920922133867862e-06, -0.0297533106058836, -5.829164365422912e-05, 0.0, -1.1920928244535389e-07, -3.85038583772257e-05, -8.344646857949556e-07, -7.152555099310121e-07, -0.0003793711948674172, -1.0728830375228426e-06, -7.152555099310121e-07, -1.1920928244535389e-07, -7.986990567587782e-06, -2.3841830625315197e-06, 0.0, 0.0, -0.0005926521262153983, -0.00043072958942502737, -3.576278118089249e-07, -0.0031847255304455757, -0.694118857383728, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -7.152555099310121e-07, 0.0