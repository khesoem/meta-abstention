pth][bitmask] = 0;\n    for (int submask = remaining; submask; submask = (submask - 1) & remaining)\n        cache[depth][bitmask] = (cache[depth][bitmask] + 1LL * compute(depth + 1, submask) * inv_factorial[bitmask - submask] % MOD) % MOD;\n    cache[depth][bitmask] = (cache[depth][bitmask] + 1LL * compute(depth + 1, 0) * inv_factorial[bitmask] % MOD) % MOD;\n    return cache[depth][bitmask];\n}\n\nint main() {\n    scanf(\"%d %d %d\", &n, &k, &MOD);\n    precompute();\n    int result = mod_exp(k, n);\n    if (n % 2 == 0) {\n        memset(cache, -1, sizeof(cache));\n        result = (result - compute(0, n) + MOD) % MOD;\n    }\n    printf(\"%d\", result);\n    return 0;\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    MOD = int(data[2])\n    \n    # Precompute factorials and inverse factorials\n    max_n = n + 3\n    factorial = [1] * (max_n + 1)\n    inv_factorial = [1] * (max_n + 1)\n    \n    for i in range(1, max_n + 1):\n        factorial[i] = (factorial[i-1] * i) % MOD\n    \n    # Compute modular inverse using Fermat's little theorem\n    def mod_exp(base, exponent):\n        result = 1\n        while exponent:\n            if exponent & 1:\n                result = (result * base) % MOD\n            base = (base * base) % MOD\n            exponent >>= 1\n        return result\n    \n    inv_factorial[max_n] = mod_exp(factorial[max_n], MOD - 2)\n    for i in range(max_n - 1, -1, -1):\n        inv_factorial[i] = (inv_factorial[i+1] * (i+1)) % MOD\n    \n    # Initialize cache with -1\n    # cache[depth][bitmask] where depth up to 27 and bitmask up to n\n    cache = [[-1] * (n + 1) for _ in range(27)]\n    \n    def lsb(x):\n        return x & -x\n    \n    def compute(depth, bitmask):\n        if cache[depth][bitmask] != -1:\n            return cache[depth][bitmask]\n        if bitmask == 0:\n            cache[depth][bitmask] = (factorial[n] * factorial[k] % MOD) * inv_factorial[k - depth] % MOD\n            return cache[depth][bitmask]\n        \n        remaining = bitmask - lsb(bitmask)\n        total = 0\n        submask = remaining\n        while submask:\n            total = (total + compute(depth + 1, submask) * inv_factorial[bitmask - submask]) % MOD\n            submask = (submask - 1) & remaining\n        \n        total = (total + compute(depth + 1, 0) * inv_factorial[bitmask]) % MOD\n        cache[depth][bitmask] = total\n        return total\n    \n    result = mod_exp(k, n)\n    if n % 2 == 0:\n        result = (result - compute(0, n) + MOD) % MOD\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017414960893802345, -1.4305104514278355e-06, -7.152555099310121e-07, -0.026748549193143845, -9.548207890475169e-05, -0.016040213406085968, -0.0020517506636679173, -0.7422313094139099, -5.435795901576057e-05, -8.344646857949556e-07, -0.1484188437461853, -5.960462772236497e-07, -0.04017504304647446, -2.6940935640595853e-05, -0.576357901096344, -1.645074735279195e-05, -0.00019810620869975537, -1.728519782773219e-05, -3.576278118089249e-07, -0.6433234214782715, -8.940656698541716e-06, -3.576278118089249e-07, -5.245195097813848e-06, 0.0, -1.9192511899746023e-05, -0.054898668080568314, -2.3841855067985307e-07, -0.00019703354337252676, -0.026308806613087654, -1.6689286894688848e-06, -1.4305104514278355e-06, 0.0, 0.0, -0.00020990552729927003, 0.0, -1.1920928244535389e-07, -4.291525328881107e-06, -3.6954811548639555e-06, -1.5020257706055418e-05, -5.960462772236497e-07, -3.576278118089249e-07, -3.135155202471651e-05, -1.1920928244535389e-07, -2.253030106658116e-05, -3.576272320060525e-06, -2.3841830625315197e-06, -1.6689286894688848e-06, -4.