d; j++) {\n                    for (int k = 1; k <= n && !foundBad; k++) {\n                        if (i == j || j == k || k == i) continue;\n                        \n                        long[] v1 = new long[5];\n                        long[] v2 = new long[5];\n                        for (int d = 0; d < 5; d++) {\n                            v1[d] = points[j][d] - points[i][d];\n                            v2[d] = points[k][d] - points[i][d];\n                        }\n                        \n                        long dot = 0, mag1 = 0, mag2 = 0;\n                        for (int d = 0; d < 5; d++) {\n                            dot += v1[d] * v2[d];\n                            mag1 += v1[d] * v1[d];\n                            mag2 += v2[d] * v2[d];\n                        }\n                        \n                        double cosAngle = dot / Math.sqrt(mag1 * mag2);\n                        double angleDeg = Math.toDegrees(Math.acos(cosAngle));\n                        \n                        if (angleDeg + 1e-9 < 90.0) {\n                            foundBad = true;\n                        }\n                    }\n                }\n                if (foundBad) goodIndices.remove(i);\n            }\n            \n            pw.println(goodIndices.size());\n            goodIndices.stream().sorted().forEach(pw::println);\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <set>\n#include <cmath>\n#include <algorithm>\n#include <sstream>\n#include <string>\n#include <cctype>\n\nint main() {\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    \n    int n;\n    std::cin >> n;\n    std::cin.ignore();\n    \n    if (n >= 100) {\n        std::cout << 0 << std::end