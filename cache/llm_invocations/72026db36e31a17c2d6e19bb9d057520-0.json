        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (Integer.bitCount(mask) == m1) {\n                idx_left[mask] = cnt1++;\n                sub1.add(mask);\n            }\n            if (Integer.bitCount(mask) == m2) {\n                idx_right[mask] = cnt2++;\n                sub2.add(mask);\n            }\n        }\n        for (int i = 0; i < sub2.size(); ++i) {\n            int mask = sub2.get(i);\n            for (int big = 0; big < (1 << cnt2); ++big)\n                if ((big & (1 << i)) != 0)\n                    rev[big] |= (1 << idx_left[(1 << n) - 1 - mask]);\n        }\n        ArrayList<Integer> l1 = new ArrayList<>();\n        ArrayList<Integer> l2 = new ArrayList<>();\n        ArrayList<Integer> r = new ArrayList<>();\n        for (int i = n; i < n + n; ++i) r.add(i);\n        for (int i = 0; i < m1; ++i) l1.add(i);\n        for (int i = m1; i < n; ++i) l2.add(i);\n        compute(f, l1, r, sub1, idx_left);\n        compute(g, l2, r, sub2, idx_right);\n        for (int i = 0; i < cnt1; ++i)\n            for (int mask = 0; mask < (1 << cnt1); ++mask)\n                if ((mask & (1 << i)) != 0)\n                    f[mask] = (f[mask] + f[mask ^ (1 << i)]) % MOD;\n        long ans = 0;\n        for (int mask = 1; mask < (1 << cnt2); ++mask) {\n            int w = (1 - f[(1 << cnt1) - 1 - rev[mask]] + MOD) % MOD;\n            ans = (ans + 1L * w * g[mask]) % MOD;\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.10060584545135498, -3.4570634852570947e-06, 0.0, -1.1920928244535389e-07, -4.470248313737102e-05, -3.015949550899677e-05, 0.0, -1.2755313036905136e-05, -0.0028433867264539003, -7.795983401592821e-05, 0.0, -7.033323527139146e-06, -0.0004328744253143668, -9.775113539944869e-06, -0.0007884969236329198, -5.960462772236497e-07, -4.768360213347478e-06, 0.0, 0.0, -3.576278118089249e-07, -0.0019289711490273476, -2.3841830625315197e-06, -2.38418550