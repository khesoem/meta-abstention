nt w = edges[eIdx].weight;\n            if (dist[v] > dist[u] + w) {\n                dist[v] = dist[u] + w;\n                parent[v] = u;\n                parentEdge[v] = eIdx;\n                if (!inQueue[v]) {\n                    inQueue[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    int cur = sink;\n    while (cur != source) {\n        edges[parentEdge[cur]].flow++;\n        edges[parentEdge[cur] ^ 1].flow--;\n        cur = parent[cur];\n    }\n    totalCost += dist[sink];\n}\n\nvoid addBidirectionalEdge(int u, int v, int cap, int weight) {\n    adj[u].push_back(edges.size());\n    edges.emplace_back(v, cap, 0, weight);\n    adj[v].push_back(edges.size());\n    edges.emplace_back(u, 0, 0, -weight);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m, k, c, d_val;\n    cin >> n >> m >> k >> c >> d_val;\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        addBidirectionalEdge(source, x, 1, 0);\n    }\n    const int TIME_LIMIT = 101;\n    for (int t = 0; t < TIME_LIMIT; ++t) {\n        addBidirectionalEdge(t * n, sink, k, t * c);\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n        for (int t = 0; t < TIME_LIMIT - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addBidirectionalEdge(u + t * n, v + (t + 1) * n, 1, d_val * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < TIME_LIMIT - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addBidirectionalEdge(v + t * n, u + (t + 1) * n, 1, d_val * (2 * j + 1));\n            }\n        }\n    }\n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < TIME_LIMIT - 1; ++t) {\n            addBidirectionalEdge(i + t * n, i + (t + 1) * n, k, 0);\n        }\n    }\n    for (int i = 0; i < k; ++i) {\n        augmentPath();\n    }\n    cout << totalCost << '\\n';\n    retur