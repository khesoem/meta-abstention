lFirst();\n                inQueue[u] = false;\n                for (int id : g.get(u)) {\n                    if (residual(id) == 0) continue;\n                    int v = edges.get(id).to;\n                    long nd = dist[u] + edges.get(id).cost;\n                    if (dist[v] > nd) {\n                        dist[v] = nd;\n                        pred[v] = u;\n                        predEdge[v] = id;\n                        if (!inQueue[v]) {\n                            inQueue[v] = true;\n                            q.addLast(v);\n                        }\n                    }\n                }\n            }\n\n            for (int cur = T; cur != S; cur = pred[cur]) {\n                int id = predEdge[cur];\n                edges.get(id).flow++;\n                edges.get(id ^ 1).flow--;\n            }\n        }\n\n        static class Edge {\n            int to, capacity, flow, cost;\n            Edge(int t, int cap, int fl, int co) {\n                to = t; capacity = cap; flow = fl; cost = co;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MinCostFlow mcmf = new MinCostFlow(N, SOURCE, TARGET);\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            mcmf.addEdge(SOURCE, x, 1, 0);\n        }\n\n        final int LAYERS = 101;\n        for (int t = 0; t < LAYERS; t++) {\n            mcmf.addEdge(t * n, TARGET, k, t * c);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int t = 0; t < LAYERS - 1; t++) {\n                for (int j = 0; j < k; j++) {\n                    mcmf.addEdge(x + t * n, y + t * n + n, 1, d * (j * 2 + 1));\n                }\n            }\n         