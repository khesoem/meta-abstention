t len, int val, int base) {\n        for (int i = len - 1; i >= 0; i--) {\n            arr[i] = val % base;\n            val /= base;\n        }\n    }\n\n    bool isInvalid(vector<int>& a, vector<int>& b, int len) {\n        for (int i = 0; i < len; i++) if (a[i] == 0 && b[i] == 0) return true;\n        return false;\n    }\n\n    void propagate(vector<int>& b, vector<int>& a, int len) {\n        for (int i = 0; i < len; i++) {\n            if (b[i] == 0 && (a[i] == 2 || (i > 0 && b[i-1] == 2) || (i+1 < len && b[i+1] == 2))) {\n                b[i] = 1;\n            }\n        }\n    }\n\n    bool containsZero(vector<int>& arr, int len) {\n        for (int i = 0; i < len; i++) if (arr[i] == 0) return true;\n        return false;\n    }\n};\n\nint main() {\n    CF111C_v2 solver;\n    solver.start();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018368464952800423, -2.3841830625315197e-06, -7.152555099310121e-07, -0.0013681822456419468, -8.344646857949556e-07, -1.645074735279195e-05, -2.7418097943154862e-06, -4.291525328881107e-06, -5.960462772236497e-07, -0.060555506497621536, -1.6689286894688848e-06, -5.125868119648658e-05, -4.768370445162873e-07, -0.0002150304353563115, -1.0728830375228426e-06, -0.0002965487365145236, -2.0265558760002023e-06, -0.0008459088858217001, -0.16022582352161407, -0.20142912864685059, -2.3841830625315197e-06, -0.06964395195245743, -3.3378546504536644e-06, -0.07889338582754135, -0.22169940173625946, -9.536697689327411e-06, -1.1920922133867862e-06, -1.311301275563892e-06, -0.14833827316761017, -0.035442981868982315, -3.576278118089249e-07, -4.291525328881107e-06, -2.706014311115723e-05, -8.344646857949556e-07, -0.00010358751023886725, -2.7418097943154862e-06, -7.86750388215296e-05, -0.04306602478027344, -1.4305104514278355e-06, -1.5497195136049413e-06, -0.10286890715360641, -0.22738488018512726, -0.031079676002264023, -1.4305104514278355e-06, -9.775113539944869e-06, -0.00025674383505247533