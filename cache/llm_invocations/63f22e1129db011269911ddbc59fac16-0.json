          add_edge(graph, j * 50 + i, (j + 1) * 50 + i, 50, c_in);\n        }\n    }\n    \n    for (ll j = 1; j < TIME_STEPS; ++j) {\n        add_edge(graph, j * 50 + 1, 1, 50, 0);\n    }\n    \n    vector<vector<ll>> adj(55);\n    for (ll i = 0; i < m_in; ++i) {\n        ll x, y;\n        cin >> x >> y;\n        adj[x].push_back(y);\n        adj[y].push_back(x);\n        \n        for (ll j = 0; j < TIME_STEPS - 1; ++j) {\n            for (ll l = 0; l < 50; ++l) {\n                ll delta_cost = c_in + d_in * ((l + 1) * (l + 1) - l * l);\n                add_edge(graph, j * 50 + x, (j + 1) * 50 + y, 1, delta_cost);\n                add_edge(graph, j * 50 + y, (j + 1) * 50 + x, 1, delta_cost);\n            }\n        }\n    }\n    \n    ll total_flow = 0;\n    ll total_cost = 0;\n    \n    while (total_flow < k_in) {\n        vector<ll> dist(N_NODES, INF);\n        vector<ll> parent(N_NODES, -1);\n        vector<size_t> parent_edge_idx(N_NODES);\n        vector<ll> in_queue(N_NODES, 0);\n        queue<ll> q;\n        \n        dist[s] = 0;\n        q.push(s);\n        in_queue[s] = 1;\n        \n        while (!q.empty()) {\n            ll u = q.front();\n            q.pop();\n            in_queue[u] = 0;\n            \n            for (size_t i = 0; i < graph[u].size(); ++i) {\n                Edge& e = graph[u][i];\n                if (e.flow < e.cap && dist[u] + e.cost < dist[e.to]) {\n                    dist[e.to] = dist[u] + e.cost;\n                    parent[e.to] = u;\n                    parent_edge_idx[e.to] = i;\n                    if (!in_queue[e.to]) {\n                        q.push(e.to);\n                        in_queue[e.to] = 1;\n                    }\n                }\n            }\n        }\n        \n        if (dist[t] == INF) break;\n        \n        ll flow_add = k_in - total_flow;\n        for (ll v = t; v != s; v = parent[v]) {\n            ll u = parent[v];\n            size_t idx = parent_edge_idx[v];\n            flow_add = min(