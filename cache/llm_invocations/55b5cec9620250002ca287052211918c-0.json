\nbool acuteAngle(const Point& a, const Point& b) {\n    double amag = a.mag();\n    double bmag = b.mag();\n    double dot = (double)a.v*b.v + a.w*b.w + a.x*b.x + a.y*b.y + a.z*b.z;\n    double angle = acos(dot / (amag * bmag)) * 180.0 / M_PI;\n    return angle < 90.0;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n\n    int n;\n    cin >> n;\n\n    if (n > 11) {\n        cout << \"0\\n\";\n        return 0;\n    }\n\n    vector<Point> points;\n    points.reserve(n);\n    for (int i = 0; i < n; ++i) {\n        int a, b, c, d, e;\n        cin >> a >> b >> c >> d >> e;\n        points.emplace_back(a, b, c, d, e);\n    }\n\n    set<int> good;\n    for (int i = 0; i < n; ++i) {\n        bool ok = true;\n        for (int j = 0; j < n && ok; ++j) {\n            if (j == i) continue;\n            for (int k = 0; k < n && ok; ++k) {\n                if (k == i || k == j) continue;\n                Point vec1(points[j].v - points[i].v,\n                           points[j].w - points[i].w,\n                           points[j].x - points[i].x,\n                           points[j].y - points[i].y,\n                           points[j].z - points[i].z);\n                Point vec2(points[k].v - points[i].v,\n                           points[k].w - points[i].w,\n                           points[k].x - points[i].x,\n                           points[k].y - points[i].y,\n                           points[k].z - points[i].z);\n                if (acuteAngle(vec1, vec2)) {\n                    ok = false;\n                }\n            }\n        }\n        if (ok) {\n            good.insert(i + 1); // 1-indexed\n        }\n    }\n\n    if (good.empty()) {\n        cout << \"0\\n\";\n    } else {\n        cout << good.size() << \"\\n\";\n        for (int idx : good) {\n            cout << idx << \"\\n\";\n        }\n    }\n\n    return 0;\n}\n```\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.16062071919441223, -2.593355894088745, -0.00038