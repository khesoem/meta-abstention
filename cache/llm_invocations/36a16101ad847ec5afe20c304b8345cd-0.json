, sys.stdin.readline().strip().split()))\n        arr.append(row)\n    return arr\n\ndef ri():\n    return int(sys.stdin.readline().strip())\n\ndef rl():\n    return int(sys.stdin.readline().strip())\n\ndef rs():\n    return sys.stdin.readline().strip()\n\ndef gcd(a, b):\n    if b == 0:\n        return a\n    return gcd(b, a % b)\n\ndef bsearch(list_vals, val, ind):\n    l = ind\n    r = len(list_vals) - 1\n    res = len(list_vals)\n\n    while l <= r:\n        mid = (l + r) // 2\n        if list_vals[mid] > val:\n            if mid == 0:\n                return mid\n            if list_vals[mid - 1] <= val:\n                return mid\n            r = mid - 1\n        else:\n            l = mid + 1\n    return res\n\ndef calc(list_nodes, b, i):\n    if i == 3:\n        return 0\n\n    first = list_nodes[i]\n    bInd = first.ind - 1\n    if bInd == -1:\n        bInd = 2\n\n    min1 = min(first.val, b[bInd])\n    first.val -= min1\n    b[bInd] -= min1\n\n    min2 = min(first.val, b[first.ind])\n    first.val -= min2\n    b[first.ind] -= min2\n    sum_val = first.val\n    sum_val += calc(list_nodes, b, i + 1)\n    first.val += min1 + min2\n    b[bInd] += min1\n    b[first.ind] += min2\n\n    first = list_nodes[i]\n    bInd = first.ind - 1\n    if bInd == -1:\n        bInd = 2\n\n    min1 = min(first.val, b[first.ind])\n    first.val -= min1\n    b[first.ind] -= min1\n\n    min2 = min(first.val, b[bInd])\n    first.val -= min2\n    b[bInd] -= min2\n    sum2 = first.val\n    sum2 += calc(list_nodes, b, i + 1)\n    first.val += min1 + min2\n    b[bInd] += min2\n    b[first.ind] += min1\n\n    return min(sum_val, sum2)\n\ndef main():\n    ans = []\n    t = 1\n    for _ in range(t):\n        n = int(input())\n        a = list(map(int, input().split()))\n        b = list(map(int, input().split()))\n\n        max_val = min(a[0], b[1]) + min(a[1], b[2]) + min(a[2], b[0])\n        min_val = max(0, a[0] + b[1] - n) + max(0, a[1] + b[2] - n) + max(0, a[2] + b[0] - n)\n        ans.append(f\"{min_val} {max_val}\")\n\n    print(\"\\n\".join(ans))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-8.34430247778073e-05, -1.1920922133867862e-06, -3.576278118089249e-07, -4.7801782784517854e-05, -0.14298759400844574, -0.14273451268672943, -0.1798403561115265, -0.10486036539077759, -0.4287393093109131, -0.004206143785268068, -0.0032661210279911757, -1.8954096958623268e-05, -4.0531076592742465e-06, -4.649054244509898e-05, -1.1920928244535389e-07, -4.649054244509898e-05, -2.7418097943154862e-06, -4.768370445162873e-07, -7.152555099310121e-07, -1.311301275563892e-06, -7.152531907195225e-06, -1.2755313036905136e-05, -0.037538181990385056, -8.344646857949556e-07, -3.8265450712060556e-05, -1.0728830375228426e-06, -0.12943030893802643, -1.2397689715726301e-05, -9.179073458653875e-06, -0.08542544394731522, -1.168244216387393e-05, -0.114019013941288, -1.7881377516459906e-06, -3.576278118089249e-07, -0.00028224775451235473, -8.821448318485636e-06, -5.245195097813848e-06, -7.152555099310121e-07, -1.9550132492440753e-05, -0.005251778755337, -1.6689286894688848e-06, -1.5497195136049413e-06, -0.004626759793609381, -1.5497195136049413e-06, -0.4288627803325653, -5.245195097813848e-06, -7.152531907195225e-06, -6.758938252460212e-05, -7.152531907195225e-06, -0.04859505221247673, -1.311301275563892e-06, -1.490105023549404e-05, -0.018160028383135796, -1.0728830375228426e-06, -2.264974000354414e-06, -1.4305104514278355e-06, -0.08672408014535904, -0.008635440841317177, -4.768370445162873e-07, -3.2186455882765586e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.0490362910786644e-05, -0.02976893074810505, -1.1920928244535389e-07, -5.960446742392378e-06, -1.2755313036905136e-05, -0.20141664147377014, -4.6491513785440475e-06, -5.960462772236497e-07, -4.768370445162873e-07, 0.0, -1.1920928244535389e-07, 0.0, -0.0013273486401885748, -1.1920922133867862e-06, -1.1920928244535