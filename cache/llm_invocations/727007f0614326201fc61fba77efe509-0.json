= self.T\n            while v != self.S:\n                u = prev_v[v]\n                e_idx = prev_e[v]\n                e = self.g[u][e_idx]\n                total_cost += add * e[4]  # orig cost\n                e[2] -= add\n                rev = self.g[v][e[1]]\n                rev[2] += add\n                v = u\n\n            flow += add\n\n            # Update potentials\n            for v in range(self.N):\n                if dist[v] == INF:\n                    continue\n                for e in self.g[v]:\n                    if dist[e[0]] != INF:\n                        e[3] += dist[v] - dist[e[0]]\n\n        return flow, total_cost\n\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    K = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    max_time = 120\n    start = [int(next(it)) for _ in range(K)]\n\n    adj = [[] for _ in range(n + 1)]\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        adj[x].append(y)\n        adj[y].append(x)\n\n    def node_id(t, j):\n        return t * n + (j - 1)\n\n    S = max_time * n\n    T = S + 1\n    mf = MCMF(max_time * n + 2, S, T)\n\n    for i in range(K):\n        mf.add_edge(S, node_id(0, start[i]), 1, 0)\n\n    for t in range(max_time):\n        mf.add_edge(node_id(t, 1), T, K, c * t)\n\n    for t in range(max_time - 1):\n        for j in range(1, n + 1):\n            for nb in adj[j]:\n                for z in range(1, 106, 2):\n                    mf.add_edge(node_id(t, j), node_id(t + 1, nb), 1, d * z)\n            mf.add_edge(node_id(t, j), node_id(t + 1, j), K, 0)\n\n    ans = mf.run()\n    print(ans[1])\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-3.576278118089249e-07, -3.576278118089249e-07, 0.0, -0.00033778208307921886, -0.00010251473577227443, -0.0015028145862743258, -0.002476722002029419, -2.7536967536434