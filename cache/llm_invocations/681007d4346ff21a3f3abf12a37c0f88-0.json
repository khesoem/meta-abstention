in(){\n    LL n;\n    cin>>n;\n//    for(int i = 1; i <= n; i++) cout<<i<<\" \"<<process(i)<<endl;\n    cout<<process(n)<<endl;  \n//    system(\"PAUSE\");\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<original_code>\n#include <iostream>\n#include <cstdio>\n#include <algorithm>\n#define LL long long\nusing namespace std;\n\nLL res = 0;\nint num(LL n){\n   int num = 0;\n    while(n){\n        n /= 10;\n        num++;\n    }\n    return num; \n}\n\n//same \nLL find(LL n){\n    int ex = num(n);\n    LL cur = 0, ad = 1;\n    for(int i = 0; i <= ex-1; i++){\n            cur += ad;\n            ad *= 10;\n    }\n    if(cur <= n) return cur;\n    return ((cur-1)/10);\n}\n\nLL process(LL n){\n //   cout<<n<<endl;          \n    if(n <= 6){\n        return n;\n    }\n    if(n <= 11) return (13 - n);\n    LL tmp = find(n);\n    LL more = tmp*10+1;\n    if(n % tmp == 0){\n         LL t = n / tmp;\n         if(n <= more/2 + tmp) return num(tmp)*t;\n         else{\n              LL cur = process(more - n);\n              return num(more) + cur;\n         }\n    }\n    else{\n        LL _m = (n / tmp)*tmp;\n        LL _M = (n / tmp + 1)*tmp;\n        LL res = process(_m) + process(n - _m);\n        if(n > more/2) res = min(process(_m) + process(n - _m), num(more) + process(more-n));\n        return res;\n    }\n}\nint main(){\n    LL n;\n    cin>>n;\n//    for(int i = 1; i <= n; i++) cout<<i<<\" \"<<process(i)<<endl;\n    cout<<process(n)<<endl;  \n//    system(\"PAUSE\");\n    return 0;\n}\n\n</original_code>\n\ndef num(n):\n    count = 0\n    while n:\n        n //= 10\n        count += 1\n    return count\n\ndef find(n):\n    ex = num(n)\n    cur = 0\n    ad = 1\n    for i in range(ex):\n        cur += ad\n        ad *= 10\n    if cur <= n:\n        return cur\n    return (cur - 1) // 10\n\ndef process(n):\n    if n <= 6:\n        return n\n    if n