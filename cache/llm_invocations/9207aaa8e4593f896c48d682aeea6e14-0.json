{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <cctype>\n#include <algorithm>\nusing namespace std;\nconst int dir[4][2]={{-1,0},{1,0},{0,-1},{0,1}};\nint S,T,tot=1,n,tt,inf,b[1000],q[1000000],edge[1000000][3],head[1000],s[20][20],dep[20][20],dis[20][20],pid[20][20],sgrid[20][20];\nchar grid[20][20],bgrid[20][20];\nvoid link(int u,int v,int cap)\n{\n    edge[++tot][0]=v,edge[tot][1]=cap,edge[tot][2]=head[u],head[u]=tot;\n    edge[++tot][0]=u,edge[tot][1]=0,edge[tot][2]=head[v],head[v]=tot;\n}\nvoid bfs(int sx,int sy,bool build)\n{\n    int l=1,r=1,idx=pid[sx][sy];\n    q[1]=sx*1000+sy;\n    memset(dis,63,sizeof(dis));\n    inf=dis[0][0];\n    dis[sx][sy]=0;\n    while(l<=r)\n    {\n        int cx=q[l]/1000,cy=q[l++]%1000;\n        if(build && sgrid[cx][cy]!=0 && dis[cx][cy]<=tt && dis[cx][cy]<=dep[cx][cy])\n            link(idx,sgrid[cx][cy],inf);\n        if(dis[cx][cy]>tt || dis[cx][cy]>=dep[cx][cy])\n            continue;\n        if(idx==3 && sgrid[cx][cy]==9)\n            printf(\"%d\\n\",dis[cx][cy]);\n        for(int k=0;k<4;k++)\n        {\n            int nx=cx+dir[k][0],ny=cy+dir[k][1];\n            if(nx>0 && nx<=n && ny>0 && ny<=n && isdigit(grid[nx][ny]) && dis[nx][ny]==inf)\n            {\n                dis[nx][ny]=dis[cx][cy]+1;\n                q[++r]=nx*1000+ny;\n            }\n        }\n    }\n}\nint depth[1000];\nbool bfs_level()\n{\n    memset(depth,0,sizeof(depth));\n    int l=1,r=1;\n    q[1]=S;\n    depth[S]=1;\n    while(l<=r)\n    {\n        int u=q[l++];\n        for(int i=head[u];i;i=edge[i][2])\n        {\n            int v=edge[i][0];\n            if(depth[v] || edge[i][1]==0)\n                continue;\n            depth[v]=depth[u]+1;\n            q[++r]=v;\n            if(v==T)\n                return true;\n        }\n    }\n    return false;\n}\nint dfs(int u,int f)\n{\n    if(u==T)\n        return f;\n    int used=0;\n    for(int i=head[u];i && f-used;i=edge[i][2])\n    {\n        int v=edge[i][0];\n        if(depth[v]!=depth[u]+1 || edge[i][1]==0)\n            continue;\n        int pushed=dfs(v,min(f-used,edge[i][1]));\n        used+=pushed;\n        edge[i][1]-=pushed;\n        edge[i^1][1]+=pushed;\n    }\n    if(used==0)\n        depth[u]=-1;\n    return used;\n}\nint main()\n{\n    scanf(\"%d%d\",&n,&tt);\n    for(int i=1;i<=n;i++)\n        scanf(\"%s\",grid[i]+1);\n    for(int i=1;i<=n;i++)\n        scanf(\"%s\",bgrid[i]+1);\n    memset(dep,63,sizeof(dep));\n    for(int i=1;i<=n;i++)\n        for(int j=1;j<=n;j++)\n            if(grid[i][j]=='Z')\n                bfs(i,j,false);\n    memcpy(dep,dis,sizeof(dis));\n    int node_count=1;\n    S=0;\n    T=1;\n    for(int i=1;i<=n;i++)\n        for(int j=1;j<=n;j++)\n        {\n            if(grid[i][j]>'0' && grid[i][j]<='9')\n            {\n                pid[i][j]=++node_count;\n                link(S,pid[i][j],grid[i][j]-'0');\n            }\n            if(bgrid[i][j]>'0' && bgrid[i][j]<='9')\n            {\n                sgrid[i][j]=++node_count;\n                link(sgrid[i][j],T,bgrid[i][j]-'0');\n            }\n        }\n    for(int i=1;i<=n;i++)\n        for(int j=1;j<=n;j++)\n            if(pid[i][j])\n                bfs(i,j,true);\n    int maxflow=0;\n    while(bfs_level())\n        maxflow+=dfs(S,inf);\n    printf(\"%d\\n\",maxflow);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    n, tt = map(int, data[0].split())\n    grid = []\n    bgrid = []\n    \n    for i in range(1, n+1):\n        grid.append(list(data[i]))\n    \n    for i in range(n+1, 2*n+1):\n        bgrid.append(list(data[i]))\n    \n    # Initialize arrays\n    dir = [[-1,0],[1,0],[0,-1],[0,1]]\n    inf = 10**9\n    \n    # Initialize 2D arrays\n    dep = [[inf]*20 for _ in range(20)]\n    dis = [[inf]*20 for _ in range(20)]\n    pid = [[0]*20 for _ in range(20)]\n    sgrid = [[0]*20 for _ in range(20)]\n    \n    # Edge list: [v, cap, next]\n    edge = [[0]*3 for _ in range(1000000)]\n    head = [0]*1000\n    \n    tot = 1  # Edge counter (starts at 1)\n    \n    def link(u, v, cap):\n        nonlocal tot\n        tot += 1\n        edge[tot][0] = v\n        edge[tot][1] = cap\n        edge[tot][2] = head[u]\n        head[u] = tot\n        \n        tot += 1\n        edge[tot][0] = u\n        edge[tot][1] = 0\n        edge[tot][2] = head[v]\n        head[v] = tot\n    \n    def bfs(sx, sy, build):\n        nonlocal inf\n        l = 0\n        r = 0\n        idx = pid[sx][sy]\n        q = deque()\n        q.append((sx, sy))\n        \n        # Reset dis array\n        for i in range(20):\n            for j in range(20):\n                dis[i][j] = inf\n        \n        dis[sx][sy] = 0\n        \n        while q:\n            cx, cy = q.popleft()\n            \n            if build and sgrid[cx][cy] != 0 and dis[cx][cy] <= tt and dis[cx][cy] <= dep[cx][cy]:\n                link(idx, sgrid[cx][cy], inf)\n            \n            if dis[cx][cy] > tt or dis[cx][cy] >= dep[cx][cy]:\n                continue\n            \n            if idx == 3 and sgrid[cx][cy] == 9:\n                print(dis[cx][cy])\n            \n            for k in range(4):\n                nx, ny = cx + dir[k][0], cy + dir[k][1]\n                if 1 <= nx <= n and 1 <= ny <= n and grid[nx-1][ny-1].isdigit() and dis[nx][ny] == inf:\n                    dis[nx][ny] = dis[cx][cy] + 1\n                    q.append((nx, ny))\n    \n    # Process 'Z' cells\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if grid[i-1][j-1] == 'Z':\n                bfs(i, j, False)\n    \n    # Copy dis to dep\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            dep[i][j] = dis[i][j]\n    \n    node_count = 1\n    S = 0\n    T = 1\n    \n    # Build node mapping\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if grid[i-1][j-1].isdigit() and grid[i-1][j-1] > '0':\n                pid[i][j] = node_count\n                node_count += 1\n                link(S, pid[i][j], int(grid[i-1][j-1]))\n            \n            if bgrid[i-1][j-1].isdigit() and bgrid[i-1][j-1] > '0':\n                sgrid[i][j] = node_count\n                node_count += 1\n                link(sgrid[i][j], T, int(bgrid[i-1][j-1]))\n    \n    # Build flow network\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if pid[i][j]:\n                bfs(i, j, True)\n    \n    # Dinic's algorithm\n    depth = [0] * 1000\n    \n    def bfs_level():\n        for i in range(1000):\n            depth[i] = 0\n        q = deque()\n        q.append(S)\n        depth[S] = 1\n        \n        while q:\n            u = q.popleft()\n            i = head[u]\n            while i:\n                v = edge[i][0]\n                if depth[v] == 0 and edge[i][1] > 0:\n                    depth[v] = depth[u] + 1\n                    q.append(v)\n                    if v == T:\n                        return True\n                i = edge[i][2]\n        return False\n    \n    def dfs(u, f):\n        if u == T:\n            return f\n        used = 0\n        i = head[u]\n        while i and f - used > 0:\n            v = edge[i][0]\n            if depth[v] == depth[u] + 1 and edge[i][1] > 0:\n                pushed = dfs(v, min(f - used, edge[i][1]))\n                used += pushed\n                edge[i][1] -= pushed\n                edge[i^1][1] += pushed\n            i = edge[i][2]\n        if used == 0:\n            depth[u] = -1\n        return used\n    \n    maxflow = 0\n    while bfs_level():\n        maxflow += dfs(S, inf)\n    \n    print(maxflow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-8.380061626667157e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -0.019686315208673477, -0.0006417360855266452, -2.50339189733495e-06, -0.004094313830137253, -0.00027295202016830444, -9.536738616588991e-07, -0.00018225439998786896, -0.12696930766105652, -0.29817429184913635, -0.0109635591506958, -2.264974000354414e-06, -1.9073468138230965e-06, -0.03526083007454872, -0.06186923384666443, -1.0609570381348021e-05, -1.537788011773955e-05, -0.05523927882313728, -0.0013158005895093083, -3.4570634852570947e-06, -0.00013672371278516948, -1.1920928244535389e-07, -3.1470757676288486e-05, -3.576272320060525e-06, -0.0010387268848717213, -0.4514903724193573, -4.529942543740617e-06, -0.1269294172525406, -4.768370445162873e-07, -0.662024974822998, -2.13382354559144e-05, -5.125868119648658e-05, -4.8874615458771586e-05, -8.713819261174649e-05, -3.325883881188929e-05, -3.576278118089249e-07, -9.536738616588991e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -3.6954811548639555e-06, -1.2278481335670222e-05, -3.933898824470816e-06, -0.008614994585514069, -0.000200609109015204, -0.0019555033650249243, -0.0018537732539698482, -9.536738616588991e-