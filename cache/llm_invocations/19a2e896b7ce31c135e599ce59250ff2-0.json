{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\n#define long long long\nusing namespace std;\nconst int N=1e6;\nint fr[N+2],sr,sn;\nvector<int>gr[N+2];\n\nconst int inf=1e9;\nstruct edge\n{\n  int a,b,f,c,d;\n};\nvector<edge>ed;\nvector<int>adj[N+2];\nvoid addEdge(int a,int b,int c,int d)\n{\n  edge e;e={a,b,0,c,d};\n  adj[a].push_back(ed.size());\n  ed.push_back(e);\n\n  e={b,a,0,0,-d};\n  adj[b].push_back(ed.size());\n  ed.push_back(e);\n}\nint dis[N+2],inq[N+2],mnf[N+2],pth[N+2];\npair<int,int>spfa(int n)\n{\n  for(int i=0;i<=n;i++)dis[i]=inf;\n  queue<int>q;q.push(sr);\n  dis[sr]=0,inq[sr]=1,mnf[sr]=inf;\n  while(!q.empty())\n  {\n    int u=q.front();q.pop();inq[u]=0;\n    for(auto id:adj[u])\n    {\n      int v=ed[id].b;\n      if(ed[id].c>ed[id].f&&dis[v]>dis[u]+ed[id].d)\n      {\n        dis[v]=dis[u]+ed[id].d,pth[v]=id;\n        mnf[v]=min(mnf[u],ed[id].c-ed[id].f);\n        if(!inq[v])q.push(v),inq[v]=1;\n      }\n    }\n  }\n  if(dis[sn]==inf)return {0,0};\n  int v=sn;\n  while(v!=sr)\n  {\n    int id=pth[v];\n    ed[id].f+=mnf[sn],ed[id^1].f-=mnf[sn];\n    v=ed[id].a;\n  }\n  return {mnf[sn],dis[sn]*mnf[sn]};\n}\npair<int,int>mcmf(int n)\n{\n  int flow=0,cost=0;\n  while(true)\n  {\n    pair<int,int>p=spfa(n);\n    if(!p.first)return {flow,cost};\n    flow+=p.first,cost+=p.second;\n  }\n}\n\nint main()\n{\n  ios_base::sync_with_stdio(0);cin.tie(0);\n  int n,m,k,c,d;cin>>n>>m>>k>>c>>d;\n  for(int i=1;i<=k;i++)\n  {\n    int x;cin>>x;fr[x]++;\n  }\n  for(int i=1;i<=m;i++)\n  {\n    int u,v;cin>>u>>v;\n    gr[u].push_back(v);\n    gr[v].push_back(u);\n  }\n  sr=0,sn=100*n+n+1;\n  for(int tm=0;tm<=99;tm++)\n  {\n    for(int i=1;i<=n;i++)\n    {\n      addEdge(n*tm+i,n*(tm+1)+i,k,0);\n      for(auto x:gr[i])\n      {\n        for(int cp=1;cp<=k;cp++)\n        {\n          addEdge(n*tm+i,n*(tm+1)+x,1,d*(2*cp-1));\n        }\n      }\n    }\n  }\n  for(int i=1;i<=n;i++)\n    if(fr[i])addEdge(sr,i,fr[i],0);\n  for(int tm=0;tm<=100;tm++)\n    addEdge(n*tm+1,sn,k,c*tm);\n  cout<<mcmf(sn).second<<endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    fr = [0] * (n + 2)\n    for _ in range(k):\n        x = int(next(it))\n        fr[x] += 1\n    \n    gr = [[] for _ in range(n + 2)]\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        gr[u].append(v)\n        gr[v].append(u)\n    \n    # Edge structure: [a, b, f, c, d]\n    ed = []\n    adj = [[] for _ in range(n * 102 + 2)]\n    \n    def add_edge(a, b, c, d):\n        # Forward edge\n        ed.append([a, b, 0, c, d])\n        adj[a].append(len(ed) - 1)\n        # Backward edge\n        ed.append([b, a, 0, 0, -d])\n        adj[b].append(len(ed) - 1)\n    \n    sr = 0\n    sn = 100 * n + n + 1\n    \n    # Build time-expanded network\n    for tm in range(100):\n        for i in range(1, n + 1):\n            # Stay at same node\n            add_edge(n * tm + i, n * (tm + 1) + i, k, 0)\n            # Move to neighbor\n            for x in gr[i]:\n                for cp in range(1, k + 1):\n                    add_edge(n * tm + i, n * (tm + 1) + x, 1, d * (2 * cp - 1))\n    \n    # Source connections for initial positions\n    for i in range(1, n + 1):\n        if fr[i]:\n            add_edge(sr, i, fr[i], 0)\n    \n    # Sink connections at each time step\n    for tm in range(101):\n        add_edge(n * tm + 1, sn, k, c * tm)\n    \n    INF = 10**9\n    \n    def spfa(n):\n        dis = [INF] * (n + 2)\n        inq = [0] * (n + 2)\n        mnf = [0] * (n + 2)\n        pth = [-1] * (n + 2)\n        \n        dis[sr] = 0\n        inq[sr] = 1\n        mnf[sr] = INF\n        q = deque([sr])\n        \n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for idx in adj[u]:\n                a, b, f, cap, cost = ed[idx]\n                if cap > f and dis[b] > dis[u] + cost:\n                    dis[b] = dis[u] + cost\n                    pth[b] = idx\n                    mnf[b] = min(mnf[u], cap - f)\n                    if not inq[b]:\n                        inq[b] = 1\n                        q.append(b)\n        \n        if dis[sn] == INF:\n            return (0, 0)\n        \n        # Augment path\n        v = sn\n        flow = mnf[sn]\n        while v != sr:\n            idx = pth[v]\n            ed[idx][2] += flow\n            ed[idx ^ 1][2] -= flow\n            v = ed[idx][0]\n        \n        return (flow, dis[sn] * flow)\n    \n    def mcmf(n):\n        total_flow = 0\n        total_cost = 0\n        while True:\n            flow, cost = spfa(n)\n            if flow == 0:\n                break\n            total_flow += flow\n            total_cost += cost\n        return (total_flow, total_cost)\n    \n    result = mcmf(sn)\