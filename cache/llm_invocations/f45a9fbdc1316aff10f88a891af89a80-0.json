                    \n                        long[] ax = new long[5];\n                        long[] ay = new long[5];\n                        for (int d = 0; d < 5; d++) {\n                            ax[d] = points[j][d] - points[i][d];\n                            ay[d] = points[k][d] - points[i][d];\n                        }\n                        \n                        double dotProduct = 0;\n                        double mag1 = 0, mag2 = 0;\n                        for (int d = 0; d < 5; d++) {\n                            dotProduct += ax[d] * ay[d];\n                            mag1 += ax[d] * ax[d];\n                            mag2 += ay[d] * ay[d];\n                        }\n                        \n                        double cosAngle = dotProduct / Math.sqrt(mag1 * mag2);\n                        double angleDeg = Math.toDegrees(Math.acos(cosAngle));\n                        \n                        if (angleDeg + 1e-9 < 90) {\n                            badIndices.add(i);\n                            break;\n                        }\n                    }\n                    if (badIndices.contains(i)) break;\n                }\n            }\n            \n            pw.println(n - badIndices.size());\n            for (int i = 1; i <= n; i++) {\n                if (!badIndices.contains(i)) {\n                    pw.println(i);\n                }\n            }\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    n = int(data[0].strip())\n    if n >= 100:\n        print(0)\n        return\n    \n    points = [[0] * 5 for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        line = data[i].split()\n        for j i