ic void main(String[] args) throws IOException {\n        Scanner sc = new Scanner();\n        int w = sc.nextInt();\n        int m = sc.nextInt();\n        \n        boolean result = solve(w, m) || solve(w, m - 1) || solve(w, m + 1);\n        System.out.println(result ? \"YES\" : \"NO\");\n    }\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve(w, m):\n    if m == 0:\n        return True\n    if m == 1:\n        return True\n    if w == 1:\n        return m >= 0\n    if w == 0:\n        return m == 0\n    \n    remainder = ((m % w) + w) % w  # floorMod equivalent\n    if remainder == 0:\n        return solve(w, m // w)\n    elif remainder == 1:\n        return solve(w, (m - 1) // w)\n    elif remainder == w - 1:\n        return solve(w, (m + 1) // w)\n    return False\n\ndef main():\n    data = sys.stdin.read().split()\n    w = int(data[0])\n    m = int(data[1])\n    \n    result = solve(w, m) or solve(w, m - 1) or solve(w, m + 1)\n    print(\"YES\" if result else \"NO\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.583967766957358e-05, -1.4305104514278355e-06, -5.960462772236497e-07, -0.09250778704881668, -0.001613506581634283, -0.3132680058479309, -0.28115731477737427, -0.02996678091585636, -1.4305104514278355e-06, -1.1920928244535389e-07, 0.0, -2.145764938177308e-06, -6.556489552167477e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.1934269170742482e-05, -1.4305104514278355e-06, 0.0, -9.536738616588991e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -1.0251946150674485e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, 0.0, -7.271740287251305e-06, -4.768370445162873e-07, -1.1920922133867862e-06, -8.344646857949556e-07, 