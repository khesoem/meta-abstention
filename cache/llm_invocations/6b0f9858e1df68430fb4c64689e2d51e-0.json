{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Edge { int to, rev, cap; };\nvector<vector<Edge>> g;\nvector<int> level, ptr;\n\nvoid addEdge(int u, int v, int c) {\n    g[u].push_back({v, (int)g[v].size(), c});\n    g[v].push_back({u, (int)g[u].size()-1, 0});\n}\n\nbool bfsLevels(int s, int t) {\n    fill(level.begin(), level.end(), -1);\n    queue<int> q;\n    level[s] = 0;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (auto &e : g[u]) {\n            if (e.cap > 0 && level[e.to] == -1) {\n                level[e.to] = level[u] + 1;\n                q.push(e.to);\n            }\n        }\n    }\n    return level[t] != -1;\n}\n\nint dfsFlow(int u, int t, int f) {\n    if (u == t) return f;\n    for (int &i = ptr[u]; i < (int)g[u].size(); ++i) {\n        Edge &e = g[u][i];\n        if (e.cap > 0 && level[e.to] == level[u] + 1) {\n            int pushed = dfsFlow(e.to, t, min(f, e.cap));\n            if (pushed) {\n                e.cap -= pushed;\n                g[e.to][e.rev].cap += pushed;\n                return pushed;\n            }\n        }\n    }\n    return 0;\n}\n\nint maxFlow(int s, int t) {\n    int total = 0;\n    level.assign(t+1, -1);\n    ptr.assign(t+1, 0);\n    while (bfsLevels(s, t)) {\n        fill(ptr.begin(), ptr.end(), 0);\n        int pushed;\n        while ((pushed = dfsFlow(s, t, 10000)) > 0) total += pushed;\n    }\n    return total;\n}\n\nint n, T, sinkNode;\nint srcCap[10][10], snkCap[10][10], srcId[10][10], snkId[10][10];\nint plant[10][10][61];\nconst int dr[4] = {0,0,-1,1};\nconst int dc[4] = {-1,1,0,0};\n\nbool ok(int r, int c) {\n    return r >= 0 && r < n && c >= 0 && c < n;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> T;\n    vector<string> grid(n);\n    for (int i = 0; i < n; ++i) cin >> grid[i];\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] == 'Y' || grid[i][j] == 'Z') {\n                plant[i][j][0] = grid[i][j] - 'X';\n                srcCap[i][j] = 0;\n            } else {\n                plant[i][j][0] = 0;\n                srcCap[i][j] = grid[i][j] - '0';\n            }\n        }\n\n    for (int i = 0; i < n; ++i) cin >> grid[i];\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] == 'Y' || grid[i][j] == 'Z') {\n                plant[i][j][0] = grid[i][j] - 'X';\n                snkCap[i][j] = 0;\n            } else {\n                plant[i][j][0] = 0;\n                snkCap[i][j] = grid[i][j] - '0';\n            }\n        }\n\n    for (int tm = 1; tm <= T; ++tm) {\n        for (int i = 0; i < n; ++i)\n            for (int j = 0; j < n; ++j)\n                plant[i][j][tm] = plant[i][j][tm-1];\n\n        for (int i = 0; i < n; ++i)\n            for (int j = 0; j < n; ++j)\n                if (plant[i][j][tm-1] == 2)\n                    for (int d = 0; d < 4; ++d) {\n                        int ni = i + dr[d], nj = j + dc[d];\n                        if (ok(ni,nj) && plant[ni][nj][tm-1] == 0)\n                            plant[ni][nj][tm] = 2;\n                    }\n    }\n\n    memset(srcId, -1, sizeof(srcId));\n    memset(snkId, -1, sizeof(snkId));\n    sinkNode = 1;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (srcCap[i][j] != 0) srcId[i][j] = sinkNode++;\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (snkCap[i][j] != 0) snkId[i][j] = sinkNode++;\n\n    g.assign(sinkNode + 1, vector<Edge>());\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (srcCap[i][j] == 0) continue;\n            queue<pair<int,pair<int,int>>> q;\n            q.push({0, {i, j}});\n            vector<vector<bool>> vis(n, vector<bool>(n, false));\n            vis[i][j] = true;\n            int src = srcId[i][j];\n            while (!q.empty()) {\n                auto cur = q.front(); q.pop();\n                int tm = cur.first;\n                int r = cur.second.first;\n                int c = cur.second.second;\n                if (snkCap[r][c] != 0) addEdge(src, snkId[r][c], 10000);\n                if (tm == T) continue;\n                if (plant[r][c][tm] != 0) continue;\n                for (int d = 0; d < 4; ++d) {\n                    int nr = r + dr[d], nc = c + dc[d];\n                    if (ok(nr,nc) && plant[nr][nc][tm] == 0 && !vis[nr][nc]) {\n                        vis[nr][nc] = true;\n                        q.push({tm+1, {nr, nc}});\n                    }\n                }\n            }\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (srcCap[i][j] != 0) addEdge(0, srcId[i][j], srcCap[i][j]);\n            if (snkCap[i][j] != 0) addEdge(snkId[i][j], sinkNode, snkCap[i][j]);\n        }\n\n    cout << maxFlow(0, sinkNode) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content"