            src_cap[i][j] = ord(grid[i][j]) - ord('0')\n\ngrid = [list(next(it).strip()) for _ in range(n)]\n\nfor i in range(n):\n    for j in range(n):\n        if grid[i][j] in ('Y', 'Z'):\n            plant[i][j][0] = ord(grid[i][j]) - ord('X')\n            snk_cap[i][j] = 0\n        else:\n            plant[i][j][0] = 0\n            snk_cap[i][j] = ord(grid[i][j]) - ord('0')\n\ndr = [0, 0, -1, 1]\ndc = [-1, 1, 0, 0]\n\nfor tm in range(1, T+1):\n    for i in range(n):\n        for j in range(n):\n            plant[i][j][tm] = plant[i][j][tm-1]\n    for i in range(n):\n        for j in range(n):\n            if plant[i][j][tm-1] == 2:\n                for d in range(4):\n                    ni = i + dr[d]\n                    nj = j + dc[d]\n                    if ok(ni, nj) and plant[ni][nj][tm-1] == 0:\n                        plant[ni][nj][tm] = 2\n\nsink_node = 1\nfor i in range(n):\n    for j in range(n):\n        if src_cap[i][j] != 0:\n            src_id[i][j] = sink_node\n            sink_node += 1\n\nfor i in range(n):\n    for j in range(n):\n        if snk_cap[i][j] != 0:\n            snk_id[i][j] = sink_node\n            sink_node += 1\n\ng = [[] for _ in range(sink_node + 1)]\nlevel = []\nptr = []\n\nfor i in range(n):\n    for j in range(n):\n        if src_cap[i][j] == 0:\n            continue\n        q = deque()\n        q.append((0, i, j))\n        vis = [[False]*n for _ in range(n)]\n        vis[i][j] = True\n        src = src_id[i][j]\n        while q:\n            tm, r, c = q.popleft()\n            if snk_cap[r][c] != 0:\n                add_edge(src, snk_id[r][c], 10000)\n            if tm == T:\n                continue\n            if plant[r][c][tm] != 0:\n                continue\n            for d in range(4):\n                nr = r + dr[d]\n                nc = c + dc[d]\n                if ok(nr, nc) and plant[nr][nc][tm] == 0 and not vis[nr][nc]:\n                    vis[nr][nc] = True\n                    q.append((tm+1, nr, nc))\