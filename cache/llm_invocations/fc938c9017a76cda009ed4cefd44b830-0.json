n3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    string input_line;\n    getline(cin, input_line);\n    \n    vector<string> data;\n    string current = \"\";\n    for (char c : input_line) {\n        if (c == ' ') {\n            if (!current.empty()) {\n                data.push_back(current);\n                current = \"\";\n            }\n        } else {\n            current += c;\n        }\n    }\n    if (!current.empty()) {\n        data.push_back(current);\n    }\n    \n    int n = stoi(data[0]);\n    int h = stoi(data[1]);\n    \n    // Create memoization table\n    vector<vector<long long>> memo(36, vector<long long>(36, 0));\n    memo[0][0] = 1;\n    \n    // Compute number of binary trees with n nodes and minimum height h\n    for (int total_nodes = 1; total_nodes < 36; total_nodes++) {\n        for (int target_height = 0; target_height <= total_nodes; target_height++) {\n            long long ways = 0;\n            for (int root_val = 1; root_val <= total_nodes; root_val++) {\n                int left_nodes = root_val - 1;\n                int right_nodes = total_nodes - root_val;\n                long long left_all = memo[left_nodes][0];\n                long long right_all = memo[right_nodes][0];\n                long long left_low = memo[left_nodes][max(target_height - 1, 0)];\n                long long right_low = memo[right_nodes][max(target_height - 1, 0)];\n                ways += left_all * right_all - (left_all - left_low) * (right_all - right_low);\n            }\n            memo[total_nodes][target_height] = ways;\n        }\n    }\n    \n    cout << memo[n][h] << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.651657167822123e-05, -2.145764938177308e-06, -3.576278118089249e-07, -4.172316494077677e-06, -3.576278118089249e-07, -3.802703940891661e-05, -5.0