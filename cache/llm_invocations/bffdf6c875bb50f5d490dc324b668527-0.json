th should be non-null now because we have at least one element in each list or from previous\n            int q = Math.min(h1[0], h2[0]);\n            int outcome = roundScore(h1[1], h2[1]);\n            if (outcome > 0) {\n                total += q;\n            }\n            if (h1[0] < h2[0]) {\n                h2[0] -= h1[0];\n                h1 = null;\n            } else if (h1[0] > h2[0]) {\n                h1[0] -= h2[0];\n                h2 = null;\n            } else {\n                h1 = null;\n                h2 = null;\n            }\n        }\n        return total;\n    }\n\n    static int maxPossible(int r1, int s1, int p1, int r2, int s2, int p2) {\n        return Math.min(r1, s2) + Math.min(s1, p2) + Math.min(p1, r2);\n    }\n\n    static int minPossible(int n, int r1, int s1, int p1, int r2, int s2, int p2) {\n        int best = n;\n        int[][] arr1 = {{r1, 1}, {s1, 2}, {p1, 3}};\n        int[][] arr2 = {{r2, 1}, {s2, 2}, {p2, 3}};\n        // All permutations of indices 0,1,2\n        int[][] perms = {{0,1,2},{0,2,1},{1,0,2},{1,2,0},{2,0,1},{2,1,0}};\n        for (int[] perm1 : perms) {\n            for (int[] perm2 : perms) {\n                ArrayList<int[]> c1 = new ArrayList<>();\n                ArrayList<int[]> c2 = new ArrayList<>();\n                for (int i : perm1) {\n                    c1.add(new int[]{arr1[i][0], arr1[i][1]});\n                }\n                for (int i : perm2) {\n                    c2.add(new int[]{arr2[i][0], arr2[i][1]});\n                }\n                int val = simulateRounds(c1, c2);\n                if (val < best) {\n                    best = val;\n                }\n            }\n        }\n        return best;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int r1 = sc.nextInt();\n        int s1 = sc.nextInt();\n        int p1 = sc.nextInt();\n        int r2 = sc.nextInt();\n        int s2 = sc.