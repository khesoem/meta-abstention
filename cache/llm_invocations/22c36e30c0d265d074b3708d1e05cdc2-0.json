n        g.get(a).add(new Rib(b, u, c, 0, g.get(b).size()));\n        g.get(b).add(new Rib(a, 0, -c, 0, g.get(a).size() - 1));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c_val = sc.nextInt(); // 'c' conflicts with variable name\n        int d = sc.nextInt();\n\n        int n = N * 101 + 2;\n        List<List<Rib>> g = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            g.add(new ArrayList<>());\n        }\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            x--;\n            addRib(g, n - 2, x * 101, 1, 0);\n        }\n        for (int i = 0; i < 101; i++) {\n            addRib(g, i, n - 1, INF, i * c_val);\n        }\n        for (int i = 1; i < N; i++) {\n            for (int j = 0; j + 1 < 101; j++) {\n                addRib(g, i * 101 + j, i * 101 + j + 1, INF, 0);\n            }\n        }\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            u--;\n            v--;\n            for (int j = 0; j + 1 < 101; j++) {\n                for (int K = 1; K <= k; K++) {\n                    int flowCost = d * K * K - d * (K - 1) * (K - 1);\n                    addRib(g, u * 101 + j, v * 101 + j + 1, 1, flowCost);\n                    addRib(g, v * 101 + j, u * 101 + j + 1, 1, flowCost);\n                }\n            }\n        }\n        int s = n - 2;\n        int t = n - 1;\n        int flow = 0;\n        int cost = 0;\n        while (flow < k) {\n            int[] id = new int[n];\n            int[] d = new int[n];\n            Arrays.fill(d, INF);\n            int[] p = new int[n];\n            int[] p_rib = new int[n];\n\n            Queue<Integer> q = new LinkedList<>();\n            int[] qArr = new int[n];\n\n            q.add(s);\n            d[s] = 0;\n\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                id[v] = 2;\n                for (int i = 0; i < g.get(v).size(); i++) {\n                    Rib r = g.get(v).get(i);\n                    if (r.f < r.u && d[v] + r.c < d[r.b]) {\n                        d[r.b] = d[v] + r.c;\n                        p[r.b] = v;\n                        p_rib[r.b] = i;\n                        if (id[r.b] == 0) {\n                            q.add(r.b);\n                        } else if (id[r.b] == 2) {\n                            q.add(r.b);\n                        }\n                        id[r.b] = 1;\n                    }\n                }\n            }\n            if (d[t] == INF) break;\n\n            int addflow = k - flow;\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = p_rib[v];\n                addflow = Math.min(addflow, g.get(pv).get(pr).u - g.get(pv).get(pr).f);\n            }\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = p_rib[v];\n                g.get(pv).get(pr).f += addflow;\n                int backIdx = g.get(pv).get(pr).back;\n                g.get(v).get(backIdx).f -= addflow;\n                cost += g.get(pv).get(pr).c * addflow;\n            }\n            flow += addflow;\n        }\n        System.out.println(cost);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00750535586848855, -0.00018220659694634378, -1.5048530030981055e-06, -0.00014859484508633614, -3.8889261304575484e-06, -3.128163257315464e-07, -0.000553151941858232, -0.37267157435417175, -0.07889650017023087, -3.128163257315464e-07, -0.1166677251458168, -0.1602778434753418, -0.010779914446175098, -0.0024377352092415094, -0.35042962431907654, -0.0003357006062287837, -6.704273118884885e-07, -4.36574100604048e-06, -1.9385402993066236e-05, -0.0004311460361350328, -1.6004129648208618, -0.0233402848243713