get(a).add(new Rib(b, u, c, 0, g.get(b).size()));\n        g.get(b).add(new Rib(a, 0, -c, 0, g.get(a).size() - 1));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int n = N * 101 + 2;\n        List<List<Rib>> g = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            g.add(new ArrayList<>());\n        }\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            x--;\n            addRib(g, n - 2, x * 101, 1, 0);\n        }\n\n        for (int i = 0; i < 101; i++) {\n            addRib(g, i, n - 1, INF, i * c);\n        }\n\n        for (int i = 1; i < N; i++) {\n            for (int j = 0; j + 1 < 101; j++) {\n                addRib(g, i * 101 + j, i * 101 + j + 1, INF, 0);\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int j = 0; j + 1 < 101; j++) {\n                for (int K = 1; K <= k; K++) {\n                    int costDiff = d * K * K - d * (K - 1) * (K - 1);\n                    addRib(g, u * 101 + j, v * 101 + j + 1, 1, costDiff);\n                    addRib(g, v * 101 + j, u * 101 + j + 1, 1, costDiff);\n                }\n            }\n        }\n\n        int s = n - 2;\n        int t = n - 1;\n        int flow = 0;\n        int cost = 0;\n\n        while (flow < k) {\n            int[] id = new int[n];\n            int[] d = new int[n];\n            Arrays.fill(d, INF);\n            int[] q = new int[n];\n            int[] p = new int[n];\n            int[] p_rib = new int[n];\n\n            int qh = 0, qt = 0;\n            q[qt++] = s;\n            d[s] = 0;\n\n            while (qh != qt) {\n                int v = q[qh++];\n                if (qh == n) qh = 0;\n                id[v] = 2;\n                for (int i = 0; i < g.get(v).size(); i++) {\n                    Rib r = g.get(v).get(i);\n                    if (r.f < r.u && d[v] + r.c < d[r.b]) {\n                        d[r.b] = d[v] + r.c;\n                        if (id[r.b] == 0) {\n                            q[qt++] = r.b;\n                            if (qt == n) qt = 0;\n                        } else if (id[r.b] == 2) {\n                            if (--qh == -1) qh = n - 1;\n                            q[qh] = r.b;\n                        }\n                        id[r.b] = 1;\n                        p[r.b] = v;\n                        p_rib[r.b] = i;\n                    }\n                }\n            }\n\n            if (d[t] == INF) break;\n\n            int addFlow = k - flow;\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = p_rib[v];\n                addFlow = Math.min(addFlow, g.get(pv).get(pr).u - g.get(pv).get(pr).f);\n            }\n\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = p_rib[v];\n                Rib r = g.get(pv).get(pr);\n                r.f += addFlow;\n                g.get(v).get(r.back).f -= addFlow;\n                cost += r.c * addFlow;\n            }\n\n            flow += addFlow;\n        }\n\n        System.out.println(cost);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.8056209087371826, -0.00043925188947468996, -7.896309739408025e-07, -6.0868278524139896e-05, -3.4121114822482923e-06, -5.512236498361744e-07, -0.0007101670489646494, -0.31850430369377136, -0.16023631393909454, -4.320199877838604e-07, -0.10182135552167892, -0.1798088699579239, -0.01079548429697752, -0.003150027245283127, -0.35133054852485657, -0.0004309076175559312, -7.896309739408025e-07, -4.842555426876061e-06, -1.4617256056226324e-05, -0.00091217877343297, -0.3868713080883026, -1.48556