[][] E = new int[N][2];\n\n    static int offset(int i, int j) {\n        return i * n + j;\n    }\n\n    static void addEdge(int u, int v, int val, int w) {\n        edges.add(new Edge(v, head[u], val, w));\n        head[u] = edge_id++;\n    }\n\n    static void add(int u, int v, int val, int w) {\n        addEdge(u, v, val, w);\n        addEdge(v, u, 0, -w);\n    }\n\n    static boolean spfa() {\n        Arrays.fill(dis, inf);\n        Arrays.fill(vis, false);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        dis[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != 0; i = edges.get(i - 1).next) {\n                Edge e = edges.get(i - 1);\n                int v = e.to;\n                if (e.val > 0 && dis[v] > dis[u] + e.w) {\n                    dis[v] = dis[u] + e.w;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return dis[t] < inf;\n    }\n\n    static Result mcmf() {\n        Result res = new Result();\n        while (spfa()) {\n            int flow = inf;\n            for (int x = t; x != s; x = edges.get(pre[x] ^ 1).to) {\n                flow = Math.min(flow, edges.get(pre[x] - 1).val);\n            }\n            for (int x = t; x != s; x = edges.get(pre[x] ^ 1).to) {\n                Edge e = edges.get(pre[x] - 1);\n                e.val -= flow;\n                edges.set(pre[x] - 1, e);\n                Edge rev = edges.get(pre[x] ^ 1);\n                rev.val += flow;\n                edges.set(pre[x] ^ 1, rev);\n            }\n            res.f += flow;\n            res.c += dis[t] * flow;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        cs = 2 * k;\n        tot = cs * n;\n        s = ++tot;\n        t = ++tot;\n\n        for (int i = 0; i <= tot; i++) {\n            head[i] = 0;\n        }\n\n        for (int i = 1; i <= m; i++) {\n            E[i][0] = sc.nextInt();\n            E[i][1] = sc.nextInt();\n        }\n\n        for (int i = 1; i <= k; i++) {\n            int tp = sc.nextInt();\n            add(s, offset(0, tp), 1, 0);\n        }\n\n        for (int i = 1; i <= cs - 1; i++) {\n            add(offset(i, 1), t, k, c * i);\n            for (int j = 1; j <= n; j++) {\n                add(offset(i - 1, j), offset(i, j), k, 0);\n            }\n            for (int j = 1; j <= m; j++) {\n                for (int t = 1; t <= k; t++) {\n                    add(offset(i - 1, E[j][0]), offset(i, E[j][1]), 1, (2 * t - 1) * d);\n                    add(offset(i - 1, E[j][1]), offset(i, E[j][0]), 1, (2 * t - 1) * d);\n                }\n            }\n        }\n\n        System.out.println(mcmf().c);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.007057284936308861, -9.400689305039123e-05, -9.088346359931165e-07, -0.00016802136087790132, -9.088346359931165e-07, -4.320199877838604e-07, -0.001502717612311244, -1.05511474609375, -0.04859009385108948, -3.128163257315464e-07, -0.22603613138198853, -0.038081202656030655, -0.008377340622246265, -0.0005573204252868891, -0.4391844868659973, -0.007470685988664627, -3.3213025744771585e-05, -1.9361264946837764e-07, -8.2994620242971e-06, -5.9795445849886164e-05, -0.0005713827558793128, -0.0036748945713043213, -1.2113979209971149e-05, -0.00016587569552939385, -2.4034345187828876e-05, -0.00012642296496778727, -2.0178654193878174, -1.3856492842023727e-06, -0.42872223258018494, -0.020608223974704742, -0.00043376852408982813, -5.097437315271236e-05, 0.0, -0.00017922651022672653, -1.8908587662735954e-05,