static int[][] E = new int[N][2];\n\n    static int P(int i, int j) {\n        return i * n + j;\n    }\n\n    static boolean SPFA() {\n        Arrays.fill(dis, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        dis[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != 0; i = edges.get(i).next) {\n                Edge e = edges.get(i);\n                int v = e.to;\n                if (e.val > 0 && dis[v] > dis[u] + e.w) {\n                    dis[v] = dis[u] + e.w;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return dis[t] < INF;\n    }\n\n    static FlowResult mcmf() {\n        FlowResult res = new FlowResult();\n        while (SPFA()) {\n            int flow = INF;\n            for (int x = t; x != s; x = edges.get(pre[x] ^ 1).to) {\n                flow = Math.min(flow, edges.get(pre[x]).val);\n            }\n            for (int x = t; x != s; x = edges.get(pre[x] ^ 1).to) {\n                edges.get(pre[x]).val -= flow;\n                edges.get(pre[x] ^ 1).val += flow;\n            }\n            res.f += flow;\n            res.c += dis[t] * flow;\n        }\n        return res;\n    }\n\n    static void addEdge(int u, int v, int val, int w) {\n        edges.add(new Edge(v, head[u], val, w));\n        head[u] = edges.size() - 1;\n    }\n\n    static void add(int u, int v, int val, int w) {\n        addEdge(u, v, val, w);\n        addEdge(v, u, 0, -w);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n\n        int cs = 2 * k;\n        tot = cs * n;\n        edge_id = 0;\n        Arrays.fill(head, 0);\n        edges.clear();\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 1; i <= k; i++) {\n            int tp = Integer.parseInt(st.nextToken());\n            add(s = ++tot, P(0, tp), 1, 0);\n        }\n\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            E[i][0] = Integer.parseInt(st.nextToken());\n            E[i][1] = Integer.parseInt(st.nextToken());\n        }\n\n        for (int i = 1; i <= cs - 1; i++) {\n            add(P(i, 1), t = ++tot, k, c * i);\n            for (int j = 1; j <= n; j++) {\n                add(P(i - 1, j), P(i, j), k, 0);\n            }\n            for (int j = 1; j <= m; j++) {\n                for (int tIdx = 1; tIdx <= k; tIdx++) {\n                    add(P(i - 1, E[j][0]), P(i, E[j][1]), 1, (2 * tIdx - 1) * d);\n                    add(P(i - 1, E[j][1]), P(i, E[j][0]), 1, (2 * tIdx - 1) * d);\n                }\n            }\n        }\n\n        System.out.println(mcmf().c);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.03868956118822098, -5.512236498361744e-07, -0.0031781906727701426, -0.2260076105594635, -0.4983171224594116, -0.0003831252979580313, -0.03095703385770321, -0.0002238013403257355, -0.005236598663032055, -1.1472419600977446e-06, -0.08045810461044312, -0.043077293783426285, -0.017793769016861916, -0.00034774013329297304, -0.3213636577129364, -0.03450775146484375, -2.451116051815916e-05, -4.320199877838604e-07, -7.3458322731312364e-06, -4.394135612528771e-05, -0.0007235141238197684, -0.008054196834564209, -1.27099974633893e-05, -0.0002466774603817612, -3.547789674485102e-05, -0.00013166792632546276, -0.1272982507944107, -0.04382740706205368, -0.38692513108253