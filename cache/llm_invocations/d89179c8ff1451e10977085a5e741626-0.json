teger.MAX_VALUE);\n            flow += result[0];\n            totalCost += result[1];\n        }\n        return new int[]{flow, totalCost};\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass Edge:\n    def __init__(self, to, rev, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.cost = cost\n\nclass Graph:\n    def __init__(self, v_num, src, sink):\n        self.v_num = v_num\n        self.src = src\n        self.sink = sink\n        self.adj = [[] for _ in range(v_num)]\n        self.p = [-1] * v_num\n        self.d = [0] * v_num\n        self.pot = [0] * v_num\n\n    def add_edge(self, fr, to, cap, cost):\n        self.adj[fr].append(Edge(to, len(self.adj[to]), cap, cost))\n        self.adj[to].append(Edge(fr, len(self.adj[fr]) - 1, 0, -cost))\n\n    def find_cheapest_path(self):\n        INF = 10**18\n        self.d = [INF] * self.v_num\n        self.p = [-1] * self.v_num\n        self.d[self.src] = 0\n        pq = [(0, self.src)]\n        while pq:\n            dist, u = heapq.heappop(pq)\n            if dist != self.d[u]:\n                continue\n            for e in self.adj[u]:\n                if e.cap > 0:\n                    nd = self.d[u] + e.cost + self.pot[u] - self.pot[e.to]\n                    if nd < self.d[e.to]:\n                        self.d[e.to] = nd\n                        self.p[e.to] = u\n                        heapq.heappush(pq, (nd, e.to))\n        for i in range(self.v_num):\n            if self.d[i] < INF:\n                self.pot[i] += self.d[i]\n        return self.p[self.sink] != -1\n\n    def augment_path(self, fr, to, flow):\n        path_cost = 0\n        # find min capacity along path\n        cur = to\n        while cur != fr:\n            prev = self.p[cur]\n            for e in self.adj[prev]:\n                if e.to == cur and e.cap > 0:\n                    flow = min(flow, e.cap)\n                    break\n            cur = prev\n        # update edges\n        cur = to\n        while cur != fr:\n            prev = self.p[cur]\n            for e in self.adj[prev]:\n                if e.to == cur and e.cap > 0:\n                    e.cap -= flow\n                    self.adj[cur][e.rev].cap += flow\n                    path_cost += e.cost * flow\n                    break\n            cur = prev\n        return flow, path_cost\n\n    def get_min_cost_max_flow(self):\n        flow = 0\n        total_cost = 0\n        while self.find_cheapest_path():\n            f, c = self.augment_path(self.src, self.sink, 10**18)\n            flow += f\n            total_cost += c\n        return flow, total_cost\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    s = next(it)\n    b = [int(next(it)) for _ in range(n)]\n\n    letters = 26\n    let_count = [0] * letters\n    for ch in s:\n        let_count[ord(ch) - ord('a')] += 1\n\n    source = 0\n    char_offset = 1\n    pair_offset = char_offset + letters\n    sink_offset = pair_offset + n // 2\n    sink = sink_offset\n    v_num = sink_offset + 1\n\n    g = Graph(v_num, source, sink)\n\n    for i in range(letters):\n        g.add_edge(source, char_offset + i, let_count[i], 0)\n        for j in range(n // 2):\n            c1 = s[j]\n            c2 = s[n - j - 1]\n            if c1 == chr(ord('a') + i):\n                if c1 == c2:\n                    g.add_edge(char_offset + i, pair_offset + j, 1, -max(b[j], b[n - j - 1]))\n                else:\n                    g.add_edge(char_offset + i, pair_offset + j, 1, -b[j])\n            else:\n                if c2 == chr(ord('a') + i):\n                    g.add_edge(char_offset + i, pair_offset + j, 1, -b[n - j - 1])\n                else:\n                    g.add_edge(char_offset + i, pair_offset + j, 1, 0)\n\n    for i in range(n // 2):\n        g.add_edge(pair_offset + i, sink, 2, 0)\n\n    flow, total_cost = g.get_min_cost_max_flow()\n    print(-total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-3.8980677345534787e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.00025650550378486514, -0.00010144196130568162, -1.6689160474925302e-05, -6.925819616299123e-05, -4.768370445162873e-07, -6.031808152329177e-05, -0.04043633118271828, -0.11753324419260025, -0.14298924803733826, -1.0728830375228426e-06, -2.861018856492592e-06, -0.5760011672973633, -1.5497195136049413e-06, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -7.510157047363464e-06, -0.0041166334412992, -1.1920928244535389e-07, -3.4570634852570947e-06, -0.00012385078298393637, -9.536738616588991e-07, 0.0, -2.622600959512056e-06, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0038156339433044195, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, 0.0, -8.749579137656838e-05, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920922133867862e-06, -4.6132929128361866e-05, -3.576278118089249e-07, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, -9.536738616588991e-07, 0.0, -0.00862787663936615, -1.5258672647178173e-05, -0.0005586970364674926, -3.933898824470816e-06, 0.0, -0.0002632986579556018, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.04686775431036949, -0.35568496584892273, -1.7881377516459906e-06, -0.00129341846331954, -2.861018856492592e-06, -1.2993727978027891e-05, -2.0265558760002023e-06, 0.0, 0.0, -6.55629628454335e-05, -0.00013505500101018697, 0.0, 0.0, 0.0, -7.152555099310121e-07, 0.0, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -2.3841855067985307e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.4305104514278355e-06, -0.0015217402251437306, 0.0,