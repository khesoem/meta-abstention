ng MOD = 998244353L;\n        private long[] fact, invFact;\n\n        public void prepare(int max) {\n            fact = new long[max + 1];\n            invFact = new long[max + 1];\n            fact[0] = 1;\n            for (int i = 1; i <= max; i++) fact[i] = (fact[i - 1] * i) % MOD;\n            invFact[max] = modPow(fact[max], MOD - 2);\n            for (int i = max; i > 0; i--) invFact[i - 1] = (invFact[i] * i) % MOD;\n        }\n\n        public long combination(int n, int r) {\n            if (r < 0 || r > n) return 0;\n            return (fact[n] * invFact[r] % MOD) * invFact[n - r] % MOD;\n        }\n\n        public long modInverse(int x) {\n            return modPow(x, MOD - 2);\n        }\n\n        public long add(long a, long b) {\n            a %= MOD; b %= MOD;\n            long s = a + b;\n            return s >= MOD ? s - MOD : s;\n        }\n\n        public long sub(long a, long b) {\n            a %= MOD; b %= MOD;\n            long d = a - b;\n            return d < 0 ? d + MOD : d;\n        }\n\n        public long multiply(long a, long b) {\n            return (a * b) % MOD;\n        }\n\n        private long modPow(long base, long exp) {\n            long res = 1;\n            base %= MOD;\n            while (exp > 0) {\n                if ((exp & 1) == 1) res = (res * base) % MOD;\n                base = (base * base) % MOD;\n                exp >>= 1;\n            }\n            return res;\n        }\n    }\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    m = int(data[1])\n    \n    mod = Mod998()\n    mod.prepare(n + m)\n    \n    totalPhases = 1\n    current = 1\n    i = 0\n    while current != 0:\n        current = mod.multiply(current, mod.multiply(n - i, mod.modInverse(n + m - i)))\n        totalPhases =