++) {\n                    int y = v.get(x).get(i);\n                    int cc = dist[x] + cost.get(x).get(i);\n                    if (dist[y] > cc && cap.get(x).get(i) > 0) {\n                        dist[y] = cc;\n                        prex[y] = x;\n                        prei[y] = i;\n                        if (vis[y] == 0) {\n                            vis[y] = 1;\n                            q.add(y);\n                        }\n                    }\n                }\n            }\n        }\n\n        static int dfs(int x, int flow) {\n            if (prex[x] == -1) return flow;\n            int y = x;\n            x = prex[y];\n            int i = prei[y];\n            int j = rev.get(x).get(i);\n            int f = dfs(x, Math.min(flow, cap.get(x).get(i)));\n            cap.get(x).set(i, cap.get(x).get(i) - f);\n            cap.get(y).set(j, cap.get(y).get(j) + f);\n            return f;\n        }\n\n        static int[] solve(int s, int t) {\n            int ans = 0;\n            tot = 0;\n            while (true) {\n                spfa(s);\n                if (dist[t] > 1e9) break;\n                int f = dfs(t, INF);\n                tot += f * dist[t];\n                ans += f;\n            }\n            return new int[]{ans, tot};\n        }\n    }\n\n    static int get(int x, int tim) {\n        return tim * 52 - 52 + x;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        int kk = k;\n        while (k-- > 0) {\n            int x = sc.nextInt();\n            MCMF.add_edge(s, get(x, 1), 1, 0);\n        }\n        k = kk;\n        // Precompute costs for j to avoid repeated multiplication\n        int[] cost_j = new int[k + 1];\n        for (int j = 1; j <= k; j++) cost_j[j] = d * (2 * j - 1);\n        while (m-- > 0) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= k; j++) {\n                    MCMF.add_edge(get(x, i), get(y, i + 1), 1, cost_j[j]);\n                    MCMF.add_edge(get(y, i), get(x, i + 1), 1, cost_j[j]);\n                }\n            }\n        }\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= n; j++)\n                MCMF.add_edge(get(j, i), get(j, i + 1), INF, 0);\n            MCMF.add_edge(get(1, i), t, INF, c * (i - 1));\n        }\n        int[] result = MCMF.solve(s, t);\n        System.out.print(result[1]);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.9073468138230965e-06, 0.0, 0.0, -0.00011336160969221964, -0.0012435331009328365, 0.0, -1.0132738680113107e-05, -0.012169516645371914, -0.0004518203204497695, 0.0, -7.271740287251305e-06, -0.0007115454645827413, -1.3351351299206726e-05, -0.0004988856380805373, -0.4766950011253357, -0.006771829444915056, -7.152555099310121e-07, 0.0, -0.0005558376433327794, -0.4741329550743103, -0.0009357126546092331, -0.00010299152199877426, -3.576278118089249e-07, -2.3841855067985307e-07, -0.023259306326508522, 0.0, -9.643566590966657e-05, -0.575939416885376, -0.0007644353318028152, -0.02331334725022316, -0.019626233726739883, -0.10034763067960739, -0.3132646977901459, -0.7083460092544556, -9.536738616588991e-07, -3.576278118089249e-07, -4.768370445162873e-07, -1.847726889536716e-05, -5.960446742392378e-06, -0.030293088406324387, -0.001943962532095611, -0.0007702721050009131, -0.4848831295967102, -0.0024796947836875916, -0.0019286142196506262, -0.7081524133682251, 0.0, -2.622600959512056e-06, -2.753696753643453e-05, 0.0, -0.840358316898346, 0.0, -0.0001262346631847322, -0.12700921297073364, -7.152555099310121e-07, -0.13039091229438782, -1.1920928244535389e-07, 0.0, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.002056390279904008, -0.0001584166020620614