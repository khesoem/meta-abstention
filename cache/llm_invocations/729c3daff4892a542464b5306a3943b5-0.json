x][i];\n                if (dist[y] > cc && cap[x][i]) {\n                    dist[y] = cc;\n                    prex[y] = x;\n                    prei[y] = i;\n                    if (!vis[y]) {\n                        vis[y] = 1;\n                        q.push(y);\n                    }\n                }\n            }\n        }\n    }\n\n    int tot = 0;\n    int dfs(int x, int flow) {\n        if (prex[x] == -1) return flow;\n        int y = x;\n        x = prex[y];\n        int i = prei[y], j = rev[x][i];\n        int f = dfs(x, min(flow, cap[x][i]));\n        cap[x][i] -= f;\n        cap[y][j] += f;\n        return f;\n    }\n\n    pii solve(int s, int t) {\n        int ans = 0;\n        tot = 0;\n        while (1) {\n            spfa(s);\n            if (dist[t] > 1e9) break;\n            int f = dfs(t, inf);\n            tot += f * dist[t];\n            ans += f;\n        }\n        return mp(ans, tot);\n    }\n};\n\nint n, m, s = nn - 1, t = nn - 2;\nint k, c, d;\nint get(int x, int tim) {\n    return tim * 52 - 52 + x;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int kk = k;\n    while (k--) {\n        int x;\n        scanf(\"%d\", &x);\n        mcmf::add_edge(s, get(x, 1), 1, 0);\n    }\n    k = kk;\n    // Precompute costs for j to avoid repeated multiplication\n    vector<int> cost_j(k + 1);\n    for (int j = 1; j <= k; ++j) cost_j[j] = d * (2 * j - 1);\n    while (m--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n        // Add both directions in one loop\n        for (int i = 1; i < 100; ++i) {\n            for (int j = 1; j <= k; ++j) {\n                mcmf::add_edge(get(x, i), get(y, i + 1), 1, cost_j[j]);\n                mcmf::add_edge(get(y, i), get(x, i + 1), 1, cost_j[j]);\n            }\n        }\n    }\n    for (int i = 1; i < 100; ++i) {\n        for (int j = 1; j <= n; ++j)\n            mcmf::add_edge(get(j, i), get(j, i + 1), inf, 0);\n        mcmf::add_edge(get(1, i), t, inf, c * (i - 1));\n    