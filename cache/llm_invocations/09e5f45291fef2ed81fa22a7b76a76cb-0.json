ues\n    b1, b2, b3 = b_values\n    \n    theoretical_max = min(a1, b2) + min(a2, b3) + min(a3, b1)\n    \n    best_result = 0\n    for permutation in itertools.permutations([1, 2, 3, 4, 5, 6]):\n        temp_a1, temp_a2, temp_a3 = a1, a2, a3\n        temp_b1, temp_b2, temp_b3 = b1, b2, b3\n        current_sum = 0\n        \n        for val in permutation:\n            if val == 1:\n                match_val = min(temp_a1, temp_b1)\n                temp_a1 -= match_val\n                temp_b1 -= match_val\n                current_sum += match_val\n            elif val == 2:\n                match_val = min(temp_a1, temp_b3)\n                temp_a1 -= match_val\n                temp_b3 -= match_val\n                current_sum += match_val\n            elif val == 3:\n                match_val = min(temp_a2, temp_b2)\n                temp_a2 -= match_val\n                temp_b2 -= match_val\n                current_sum += match_val\n            elif val == 4:\n                match_val = min(temp_a2, temp_b1)\n                temp_a2 -= match_val\n                temp_b1 -= match_val\n                current_sum += match_val\n            elif val == 5:\n                match_val = min(temp_a3, temp_b3)\n                temp_a3 -= match_val\n                temp_b3 -= match_val\n                current_sum += match_val\n            elif val == 6:\n                match_val = min(temp_a3, temp_b2)\n                temp_a3 -= match_val\n                temp_b2 -= match_val\n                current_sum += match_val\n        \n        best_result = max(best_result, current_sum)\n    \n    print(f\"{n - best_result} {theoretical_max}\")\n\ndef main_entry():\n    try:\n        num_cases = 1\n        for _ in range(num_cases):\n            compute_solution()\n    finally:\n        input_file.close()\n        output_file.close()\n        sys.stdout = saved_stdout\n\nif __name__ == \"__main__\":\n    main_entry()\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, 