n            last_known = self.invFactorial.size() - 1\n            if last_known < n:\n                f_inv = [0.0] * (n - last_known)\n                f_inv[0] = self.inv(self.fact(n))\n                for i in range(1, len(f_inv)):\n                    f_inv[i] = self.mult(f_inv[i - 1], n - i + 1)\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(int(f_inv[i]))\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n\n    def solve(self, testNumber, in_reader, out):\n        n = in_reader.nextInt()\n        m = in_reader.nextInt()\n\n        self.mod.fInv(n + m)\n\n        phase_size = 1\n        p = 1\n        for i in range(n + 1):\n            if p == 0:\n                break\n            p = self.mod.mult(p, n - i, self.mod.smallInv(n + m - i))\n            phase_size = self.mod.add(phase_size, p)\n\n        answer = 0\n        for k in range(1, n + 1):\n            num_phases = self.mod.mult(m + k, self.mod.smallInv(k))\n            term = self.mod.mult(self.mod.ncr(n, k), num_phases, phase_size)\n            if k % 2 == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out.println(answer)\n\n\ndef main():\n    input_stream = sys.stdin\n    output_stream = sys.stdout\n\n    in_reader = InputReader(input_stream)\n    out = output_stream\n\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out)\n\n    out.flush()\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.8662193370983e-05, -9.536738616588991e-07, -5.960462772236497e-07, -0.0007924277451820672, -0.05522890016436577, -0.004566360730677843, -0.1427193284034729, -0.1722024530172348, -0.007983914576470852, -0.049439653754234314, -0.7250436544418335, -1.7881377516459906e-06, -4.291525328881107e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -6.12716976320371e-05, -1.1920922133867862e-06, -5.960462772236497e-07, -2.861018856492592e-06, -3.576278118089249e-07, -2.4914430468925275e-05, -1.156323378381785e-05, -2.0265558760002023e-06, -2.5629668016335927e-05, -0.0001401803019689396, -2.3841855067985307e-07, -0.011955629102885723, -0.00046754872892051935, -2.861018856492592e-06, -1.9788545614574105e-05, -0.0005403488758020103, -1.1444026313256472e-05, -4.768370445162873e-07, -0.0028191369492560625, -0.01000260654836893, -3.576278118089249e-07, -1.0728830375228426e-06, -0.0002599