{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3.11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3.11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\n#define long long long\nusing namespace std;\nconst int N=1e6;\nint fr[N+2],sr,sn;\nvector<int>gr[N+2];\n\nconst int inf=1e9;\nstruct edge\n{\n  int a,b,f,c,d;\n};\nvector<edge>ed;\nvector<int>adj[N+2];\nvoid addEdge(int a,int b,int c,int d)\n{\n  edge e;e={a,b,0,c,d};\n  adj[a].push_back(ed.size());\n  ed.push_back(e);\n\n  e={b,a,0,0,-d};\n  adj[b].push_back(ed.size());\n  ed.push_back(e);\n}\nint dis[N+2],inq[N+2],mnf[N+2],pth[N+2];\npair<int,int>spfa(int n)\n{\n  for(int i=0;i<=n;i++)dis[i]=inf;\n  queue<int>q;q.push(sr);\n  dis[sr]=0,inq[sr]=1,mnf[sr]=inf;\n  while(!q.empty())\n  {\n    int u=q.front();q.pop();inq[u]=0;\n    for(auto id:adj[u])\n    {\n      int v=ed[id].b;\n      if(ed[id].c>ed[id].f&&dis[v]>dis[u]+ed[id].d)\n      {\n        dis[v]=dis[u]+ed[id].d,pth[v]=id;\n        mnf[v]=min(mnf[u],ed[id].c-ed[id].f);\n        if(!inq[v])q.push(v),inq[v]=1;\n      }\n    }\n  }\n  if(dis[sn]==inf)return {0,0};\n  int v=sn;\n  while(v!=sr)\n  {\n    int id=pth[v];\n    ed[id].f+=mnf[sn],ed[id^1].f-=mnf[sn];\n    v=ed[id].a;\n  }\n  return {mnf[sn],dis[sn]*mnf[sn]};\n}\npair<int,int>mcmf(int n)\n{\n  int flow=0,cost=0;\n  while(true)\n  {\n    pair<int,int>p=spfa(n);\n    if(!p.first)return {flow,cost};\n    flow+=p.first,cost+=p.second;\n  }\n}\n\nint main()\n{\n  ios_base::sync_with_stdio(0);cin.tie(0);\n  int n,m,k,c,d;cin>>n>>m>>k>>c>>d;\n  for(int i=1;i<=k;i++)\n  {\n    int x;cin>>x;fr[x]++;\n  }\n  for(int i=1;i<=m;i++)\n  {\n    int u,v;cin>>u>>v;\n    gr[u].push_back(v);\n    gr[v].push_back(u);\n  }\n  sr=0,sn=100*n+n+1;\n  for(int tm=0;tm<=99;tm++)\n  {\n    for(int i=1;i<=n;i++)\n    {\n      addEdge(n*tm+i,n*(tm+1)+i,k,0);\n      for(auto x:gr[i])\n      {\n        for(int cp=1;cp<=k;cp++)\n        {\n          addEdge(n*tm+i,n*(tm+1)+x,1,d*(2*cp-1));\n        }\n      }\n    }\n  }\n  for(int i=1;i<=n;i++)\n    if(fr[i])addEdge(sr,i,fr[i],0);\n  for(int tm=0;tm<=100;tm++)\n    addEdge(n*tm+1,sn,k,c*tm);\n  cout<<mcmf(sn).second<<endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn, m, k, c, d = map(int, input().split())\nfr = [0] * (10**6 + 3)\nsr, sn = 0, 100 * n + n + 1\ngr = [[] for _ in range(10**6 + 3)]\n\nfor _ in range(k):\n    x = int(input())\n    fr[x] += 1\n    \nfor _ in range(m):\n    u, v = map(int, input().split())\n    gr[u].append(v)\n    gr[v].append(u)\n\nclass Edge:\n    def __init__(self, a, b, f, c, d):\n        self.a = a\n        self.b = b\n        self.f = f\n        self.c = c\n        self.d = d\n\ned = []\nadj = [[] for _ in range(10**6 + 3)]\ndef addEdge(a, b, c, d):\n    e = Edge(a, b, 0, c, d)\n    adj[a].append(len(ed))\n    ed.append(e)\n    e_rev = Edge(b, a, 0, 0, -d)\n    adj[b].append(len(ed))\n    ed.append(e_rev)\n\ndef mcmf(n):\n    flow, cost = 0, 0\n    while True:\n        result = spfa(n)\n        if result[0] == 0:\n            return flow, cost\n        flow += result[0]\n        cost += result[1]\n\ndef spfa(n):\n    inf = 10**9\n    dis = [inf] * (n + 1)\n    inq = [0] * (n + 1)\n    mnf = [0] * (n + 1)\n    pth = [0] * (n + 1)\n    from collections import deque\n    q = deque()\n    q.append(sr)\n    dis[sr] = 0\n    inq[sr] = 1\n    mnf[sr] = inf\n    while q:\n        u = q.popleft()\n        inq[u] = 0\n        for id in adj[u]:\n            v = ed[id].b\n            if ed[id].c > ed[id].f and dis[v] > dis[u] + ed[id].d:\n                dis[v] = dis[u] + ed[id].d\n                pth[v] = id\n                mnf[v] = min(mnf[u], ed[id].c - ed[id].f)\n                if not inq[v]:\n                    q.append(v)\n                    inq[v] = 1\n    if dis[sn] == inf:\n        return (0, 0)\n    v = sn\n    while v != sr:\n        id = pth[v]\n        ed[id].f += mnf[sn]\n        ed[id ^ 1].f -= mnf[sn]\n        v = ed[id].a\n    return (mnf[sn], dis[sn] * mnf[sn])\n\n# Build the graph\nfor tm in range(101):\n    for i in range(1, n + 1):\n        addEdge(n * tm + i, n * (tm + 1) + i, k, 0)\n        for x in gr[i]:\n            for cp in range(1, k + 1):\n                addEdge(n * tm + i, n * (tm + 1) + x, 1, d * (2 * cp - 1))\n# Source edges\nfor i in range(1, n + 1):\n    if fr[i]:\n        addEdge(sr, i, fr[i], 0)\n# Sink edges\nfor tm in range(101):\n    addEdge(n * tm + 1, sn, k, c * tm)\n\nresult = mcmf(sn)\nprint(result[1])\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00012761499965563416, -0.0006065295310690999, -1.9361264946837764e-07, -1.8550976164988242e-05, -0.5398380160331726, -3.7811782360076904, 0.0, -2.816093228830141e-06, -2.5776860184123507e-06, -2.45848218582978e-06, -6.704273118884885e-07, -8.180258191714529e-06, 0.0, -4.008129963040119e-06, -3.173704271830502e-06, -4.320199877838604e-07, -2.816093228830141e-06, -1.9361264946837764e-07, 0.0, -3.650518920039758e-06, -0.3140295445919037, -0.001377137377858162, -8.65707261255011e-06, 0.0, -1.9361264946837764e-07, -0.043105270713567734, -5.319370302458992e-06, -4.048445043736