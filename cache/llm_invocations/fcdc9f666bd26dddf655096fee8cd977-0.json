.combination(n, n - k, facts));\n\n        if (k != 0) ans = mod.times(ans, 2);\n        out.println(ans);\n    }\n}\n\nclass FastReader {\n    private static final BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n    private static StringTokenizer tokenizer;\n\n    public String next() {\n        while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n            try {\n                tokenizer = new StringTokenizer(br.readLine());\n            } catch (IOException e) {\n                return null;\n            }\n        }\n        return tokenizer.nextToken();\n    }\n\n    public BigDecimal nextBigDecimal() { return new BigDecimal(next()); }\n    public BigInteger nextBigInteger() { return new BigInteger(next()); }\n    public boolean nextBoolean() { return Boolean.parseBoolean(next()); }\n    public byte nextByte() { return Byte.parseByte(next()); }\n    public double nextDouble() { return Double.parseDouble(next()); }\n    public double[] nextDoubleArray(int len) {\n        double[] arr = new double[len];\n        for (int i = 0; i < len; i++) arr[i] = nextDouble();\n        return arr;\n    }\n    public int nextInt() { return Integer.parseInt(next()); }\n    public int[] nextIntArray(int len) {\n        int[] arr = new int[len];\n        for (int i = 0; i < len; i++) arr[i] = nextInt();\n        return arr;\n    }\n    public long nextLong() { return Long.parseLong(next()); }\n    public long[] nextLongArray(int len) {\n        long[] arr = new long[len];\n        for (int i = 0; i < len; i++) arr[i] = nextLong();\n        return arr;\n    }\n}\n\nclass FastWriter extends PrintWriter {\n    public FastWriter() { super(System.out); }\n\n    public void println(boolean[] a) { printArray(a); }\n    public void println(double[] a) { printArray(a); }\n    public void println(int[] a) { printArray(a); }\n    public void println(long[] a) { printArray(a); }\n    public void println(Object... a) { printArray(a); }\n\n    private <T> vo