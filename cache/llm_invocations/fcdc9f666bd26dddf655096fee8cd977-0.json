== 1:\n            arg = args[0]\n            if isinstance(arg, list) or isinstance(arg, tuple):\n                self.printArray(arg)\n            elif isinstance(arg, bool):\n                self.output.write(str(arg).lower() + '\\n')\n            else:\n                self.output.write(str(arg) + '\\n')\n        else:\n            self.printArray(args)\n    \n    def printArray(self, arr):\n        for i, val in enumerate(arr):\n            self.output.write(str(val))\n            if i < len(arr) - 1:\n                self.output.write(' ')\n            else:\n                self.output.write('\\n')\n    \n    def flush(self):\n        self.output.flush()\n\nclass Modulo:\n    def __init__(self, mod):\n        self.mod = mod\n    \n    def plus(self, a, b):\n        c = (a + b) % self.mod\n        if c >= self.mod:\n            c -= self.mod\n        return c\n    \n    def minus(self, a, b):\n        c = (a - b) % self.mod\n        if c < 0:\n            c += self.mod\n        return c\n    \n    def times(self, a, b):\n        return (a * b) % self.mod\n    \n    def div(self, a, b):\n        return self.times(a, self.pow(b, self.mod - 2))\n    \n    def pow(self, a, b):\n        c = 1\n        a = a % self.mod\n        while b > 0:\n            if b & 1:\n                c = (c * a) % self.mod\n            a = (a * a) % self.mod\n            b >>= 1\n        return c\n    \n    def combination(self, n, k):\n        return self.div(self.factorial(n), self.times(self.factorial(k), self.factorial(n - k)))\n    \n    def combination_with_factorials(self, n, k, factorials):\n        return self.div(factorials[n], self.times(factorials[k], factorials[n - k]))\n    \n    def factorial(self, n):\n        f = 1\n        for i in range(1, n + 1):\n            f = (f * i) % self.mod\n        return f\n    \n    def factorials(self, n):\n        f = [1] * (n + 1)\n        for i in range(1, n + 1):\n            f[i] = (f[i - 1] * i) % self.mod\n        return f\n\ndef main():\n    in_reader = FastReader()\n    out_writer = FastWriter()\n    \n    t = in_reader.nextInt()\n    for _ in range(t):\n        n = in_reader.nextInt()\n        kt = in_reader.nextLong()\n        \n        if kt >= n:\n            out_writer.println(0)\n            continue\n        \n        k = int(kt)\n        mod = Modulo(998244353)\n        facts = mod.factorials(n)\n        \n        ans = 0\n        c = n - k\n        for i in range(c + 1):\n            comb = mod.combination_with_factorials(c, i, facts)\n            power = mod.pow(c - i, n)\n            term = mod.times(comb, power)\n            if i % 2 == 0:\n                ans = mod.plus(ans, term)\n            else:\n                ans = mod.minus(ans, term)\n        \n        ans = mod.times(ans, mod.combination_with_factorials(n, n - k, facts))\n        \n        if k != 0:\n            ans = mod.times(ans, 2)\n        \n        out_writer.println(ans)\n    \n    out_writer.flush()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.92710343375802e-05, -1.5497195136049413e-06, -2.3841855067985307e-07, -0.0008911690674722195, -0.03393147140741348, -0.00012706902634818107, -0.07004237920045853, -0.0062539116479456425, -0.16023202240467072, -0.06995268166065216, -0.6177576780319214, -1.1920928244535389e-07, -0.00012838016846217215, -0.11039193719625473, -0.9069719910621643, -9.536288416711614e-05, -0.4287109673023224, -0.018420930951833725, -0.1476496458053589, -1.1920928244535389e-07, -0.0016934829764068127, -0.5231547355651855, -0.20578120648860931, -0.917563259601593, -7.152555099310121e-07, -0.2045922726392746, -0.6326144337654114, -0.18268929421901703, -2.1934269170742482e-05, -3.576278118089249e-07, -0.00011693747364915907, -4.887569048150908e-06, -1.311301275563892e-06, -0.5013928413391113, -0.00042465253500267863, -0.00025602878304198384, -0.07593833655118942, -0.043047644197940826, -0.34942343831062317, -2.491443046