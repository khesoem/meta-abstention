{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <cassert>\n#include <algorithm>\n#include <queue>\n#include <vector>\nusing namespace std;\n\ntypedef long long ll;\nconst int iinf = 0x3f3f3f3f;\nconst ll linf = 0x3f3f3f3f3f3f3f3f;\n\nconst int N = 50;\nint n, m, k, c, d, mxt;\n\nconst int fN = (N * 3 + 1) * N + 2;\nint s, t, fn;\n\nstruct Edge {\n    int to, rev, cap, cost;\n};\nvector<Edge> G[fN];\n\nvoid add_edge(int u, int v, int cap, int cost) {\n    G[u].push_back({v, (int)G[v].size(), cap, cost});\n    G[v].push_back({u, (int)G[u].size() - 1, 0, -cost});\n}\n\nint dist[fN], prevv[fN], preve[fN];\nbool inq[fN];\n\nbool spfa() {\n    fill(dist, dist + fn, iinf);\n    fill(prevv, prevv + fn, -1);\n    fill(inq, inq + fn, false);\n    queue<int> q;\n    q.push(s);\n    inq[s] = true;\n    dist[s] = 0;\n    while (!q.empty()) {\n        int u = q.front();\n        q.pop();\n        inq[u] = false;\n        for (int i = 0; i < (int)G[u].size(); ++i) {\n            Edge &e = G[u][i];\n            if (e.cap && dist[e.to] > dist[u] + e.cost) {\n                dist[e.to] = dist[u] + e.cost;\n                prevv[e.to] = u;\n                preve[e.to] = i;\n                if (!inq[e.to]) {\n                    q.push(e.to);\n                    inq[e.to] = true;\n                }\n            }\n        }\n    }\n    return dist[t] < iinf;\n}\n\npair<int, int> mcmf() {\n    pair<int, int> res(0, 0);\n    while (spfa()) {\n        int f = iinf;\n        for (int u = t; u != s; u = prevv[u]) {\n            f = min(f, G[prevv[u]][preve[u]].cap);\n        }\n        for (int u = t; u != s; u = prevv[u]) {\n            Edge &e = G[prevv[u]][preve[u]];\n            e.cap -= f;\n            G[e.to][e.rev].cap += f;\n        }\n        res.first += f;\n        res.second += dist[t] * f;\n    }\n    return res;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    mxt = N * 3 + 1;\n    fn = (t = (s = n * mxt) + 1) + 1;\n    for (int i = 0; i < k; ++i) {\n        int u;\n        scanf(\"%d\", &u);\n        --u;\n        add_edge(s, u, 1, 0);\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        scanf(\"%d%d\", &u, &v);\n        --u; --v;\n        for (int i2 = 0; i2 < mxt - 1; ++i2) {\n            for (int p = 1; p <= k; ++p) {\n                add_edge(i2 * n + u, (i2 + 1) * n + v, 1, 2 * d * p - d);\n                add_edge(i2 * n + v, (i2 + 1) * n + u, 1, 2 * d * p - d);\n            }\n        }\n    }\n    for (int u = 0; u < n; ++u) {\n        for (int i = 0; i < mxt - 1; ++i) {\n            add_edge(i * n + u, (i + 1) * n + u, k, 0);\n        }\n    }\n    for (int i = 0; i < mxt; ++i) {\n        add_edge(i * n, t, k, i * c);\n    }\n    pair<int, int> ans = mcmf();\n    assert(ans.first == k);\n    printf(\"%d\\n\", ans.second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = Integer.MAX_VALUE / 2;\n    static final int N = 50;\n    static int n, m, k, c, d, mxt;\n    static int s, t, fn;\n    static ArrayList<Edge>[] G;\n    static int[] dist, prevv, preve;\n    static boolean[] inq;\n\n    static class Edge {\n        int to, rev, cap, cost;\n        Edge(int to, int rev, int cap, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        G[u].add(new Edge(v, G[v].size(), cap, cost));\n        G[v].add(new Edge(u, G[u].size() - 1, 0, -cost));\n    }\n\n    static boolean spfa() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(prevv, -1);\n        Arrays.fill(inq, false);\n        Queue<Integer> q = new LinkedList<>();\n        q.add(s);\n        inq[s] = true;\n        dist[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            for (int i = 0; i < G[u].size(); ++i) {\n                Edge e = G[u].get(i);\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        q.add(e.to);\n                        inq[e.to] = true;\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n\n    static int[] mcmf() {\n        int flow = 0, cost = 0;\n        while (spfa()) {\n            int f = INF;\n            for (int u = t; u != s; u = prevv[u]) {\n                f = Math.min(f, G[prevv[u]].get(preve[u]).cap);\n            }\n            for (int u = t; u != s; u = prevv[u]) {\n                Edge e = G[prevv[u]].get(preve[u]);\n                e.cap -= f;\n                G[e.to].get(e.rev).cap += f;\n            }\n            flow += f;\n            cost += dist[t] * f;\n        }\n        return new int[]{flow, cost};\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        mxt = N * 3 + 1;\n        fn = n * mxt + 2;\n        s = n * mxt;\n        t = s + 1;\n        G = new ArrayList[fn];\n        for (int i = 0; i < fn; ++i) G[i] = new ArrayList<>();\n        dist = new int[fn];\n        prevv = new int[fn];\n        preve = new int[fn];\n        inq = new boolean[fn];\n\n        for (int i = 0; i < k; ++i) {\n            int u = sc.nextInt() - 1;\n            addEdge(s, u, 1, 0);\n        }\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n            for (int i2 = 0; i2 < mxt - 1; ++i2) {\n                for (int p = 1; p <= k; ++p) {\n                    addEdge(i2 * n + u, (i2 + 1) * n + v, 1, 2 * d * p - d);\n                    addEdge(i2 * n + v, (i2 + 1) * n + u, 1, 2 * d * p - d);\n                }\n            }\n        }\n        for (int u = 0; u < n; ++u) {\n            for (int i = 0; i < mxt - 1; ++i) {\n                addEdge(i * n + u, (i + 1) * n + u, k, 0);\n            }\n        }\n        for (int i = 0; i < mxt; ++i) {\n            addEdge(i * n, t, k, i * c);\n        }\n        int[] ans = mcmf();\n        // assert ans[0] == k;\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.7881233361549675e-05, 0.0, 0.0, -5.9126061387360096e-05, -0.0015263822861015797, 0.0, -0.004078404977917671, -0.011306026950478554, -0.0010755236726254225, 0.0, -3.6238969187252223e-05, -0.0019325405592098832, -4.684815212385729e-05, -0.005370949395000935, -0.06198778375983238, -3.6954811548639555e-06, -0.5809100866317749, -1.7165990357170813e-05, -0.06197993829846382, 0.0, 0.0, -0.0003358753747306764, -1.1920928244535389e-07, -1.1086402082582936e-0