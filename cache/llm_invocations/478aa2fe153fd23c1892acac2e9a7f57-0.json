{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cctype>\n#include <cmath>\n#include <iomanip>\n#include <queue>\n#include <map>\n#include <set>\nusing namespace std;\nusing lint = long long;\nconst lint MOD1 = 998244353, MOD2 = 1000000007, BLOCK = 1000000;\nvector<lint> bucket[7];\nlint bucket_total[7];\nlint n, counter, answer;\n\nvoid dfs_construct(lint x, int depth) {\n    ++counter;\n    bucket[depth].push_back((counter - x + MOD1) % MOD1);\n    bucket_total[depth] = (bucket_total[depth] + bucket[depth].back()) % MOD2;\n    if (depth == 6) return;\n    for (int digit = 0; digit <= 9; ++digit) {\n        dfs_construct(x * 10 + digit, depth + 1);\n    }\n}\n\nvoid dfs_compute(lint x) {\n    if (x > n) return;\n    if (x * BLOCK + BLOCK - 1 <= n && x * BLOCK * 10 > n) {\n        lint base = counter;\n        for (int d = 0, power = 1; d <= 6; ++d, power *= 10) {\n            lint size = bucket[d].size();\n            lint diff = ((base - x * power) % MOD1 + MOD1) % MOD1;\n            lint pos = lower_bound(bucket[d].begin(), bucket[d].end(), MOD1 - diff) - bucket[d].begin();\n            answer = (answer + diff * size + bucket_total[d]) % MOD2;\n            answer = (answer - (size - pos) * MOD1 % MOD2 + MOD2) % MOD2;\n            counter += size;\n        }\n        return;\n    }\n    ++counter;\n    answer = (answer + ((counter - x) % MOD1 + MOD1) % MOD1) % MOD2;\n    for (int digit = 0; digit <= 9; ++digit) {\n        dfs_compute(x * 10 + digit);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n;\n    dfs_construct(0, 0);\n    counter = 0;\n    for (int i = 0; i <= 6; ++i) {\n        sort(bucket[i].begin(), bucket[i].end());\n    }\n    for (int i = 1; i <= 9; ++i) {\n        dfs_compute(i);\n    }\n    cout << answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nsys.setrecursionlimit(1000000)\n\nMOD1 = 998244353\nMOD2 = 1000000007\nBLOCK = 1000000\n\nbucket = [[] for _ in range(7)]\nbucket_total = [0] * 7\nn = 0\ncounter = 0\nanswer = 0\n\ndef dfs_construct(x, depth):\n    global counter\n    counter += 1\n    val = (counter - x + MOD1) % MOD1\n    bucket[depth].append(val)\n    bucket_total[depth] = (bucket_total[depth] + val) % MOD2\n    if depth == 6:\n        return\n    for digit in range(10):\n        dfs_construct(x * 10 + digit, depth + 1)\n\ndef dfs_compute(x):\n    global counter, answer\n    if x > n:\n        return\n    if x * BLOCK + BLOCK - 1 <= n and x * BLOCK * 10 > n:\n        base = counter\n        power = 1\n        for d in range(7):\n            size = len(bucket[d])\n            diff = ((base - x * power) % MOD1 + MOD1) % MOD1\n            # Find the first position where bucket[d][pos] >= (MOD1 - diff)\n            pos = bisect.bisect_left(bucket[d], MOD1 - diff)\n            contribution = (diff * size + bucket_total[d]) % MOD2\n            contribution = (contribution - ((size - pos) * MOD1) % MOD2 + MOD2) % MOD2\n            answer = (answer + contribution) % MOD2\n            counter += size\n            power *= 10\n        return\n    counter += 1\n    val = ((counter - x) % MOD1 + MOD1) % MOD1\n    answer = (answer + val) % MOD2\n    for digit in range(10):\n        dfs_compute(x * 10 + digit)\n\ndef main():\n    global n, counter, answer\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    n = int(input_data[0])\n    \n    dfs_construct(0, 0)\n    counter = 0\n    for i in range(7):\n        bucket[i].sort()\n    \n    for i in range(1, 10):\n        dfs_compute(i)\n    \n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00023588736075907946, -1.1920922133867862e-06, -5.960462772236497e-07, -0.030256079509854317, -0.009894492104649544, -0.00015984688070602715, -0.6000354290008545, -0.0015156697481870651, -1.0728830375228426e-06, -0.42870545387268066, -0.23697331547737122, -9.536738616588991e-07, -5.9126061387360096e-05, -2.3364747903542593e-05, -1.1920858014491387e-05, -4.768370445162873e-07, -0.0004961451631970704, -0.004118414130061865, -0.03383490443229675, -1.1920928244535389e-07, -3.814689989667386e-06, -0.0619824044406414, -0.04859902337193489, -0.026323089376091957, -0.018364518880844116, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -2.3841830625315197e-06, -8.344646857949556e-07, -2.074220174108632e-05, -5.722029527532868e-06, -0.00012373158824630082, -1.168244216387393e-05, -2.0265558760002023e-06, 0.0, -1.3708974620385561e-05, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -2.264974000354414e-06, 0.0, 0.0, -1.1920928244535389e-07, -4.0531076592742465e-06, -7.033323527139146e-06, -1.1920922133867862e-06, -4.529942543740617e-06, -1.1920928244535389e-07, -4.887569048150908e-06, -7.152555099310121e-07, 0.0, -3.576278118089249e-07, -1.192092213386786