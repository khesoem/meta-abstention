        }\n    }\n\n    static void update_flow() {\n        int bottleneck = K;\n        int cur = SINK;\n        while (cur != SOURCE) {\n            int prev = adj[cur].get(prev_edge_idx[cur]).dest;\n            int idx = adj[cur].get(prev_edge_idx[cur]).reverse_index;\n            bottleneck = Math.min(bottleneck, adj[prev].get(idx).cap);\n            cur = prev;\n        }\n\n        total_flow += bottleneck;\n        total_cost += (long) bottleneck * dist[SINK];\n\n        cur = SINK;\n        while (cur != SOURCE) {\n            int prev = adj[cur].get(prev_edge_idx[cur]).dest;\n            int idx = adj[cur].get(prev_edge_idx[cur]).reverse_index;\n            adj[cur].get(prev_edge_idx[cur]).cap += bottleneck;\n            adj[prev].get(idx).cap -= bottleneck;\n            cur = prev;\n        }\n    }\n\n    static int get_node(int vertex, int time_step) {\n        return vertex + time_step * N;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n\n        SOURCE = MAX_NODES - 2;\n        SINK = MAX_NODES - 1;\n        int max_time = N + K;\n\n        for (int i = 0; i < MAX_NODES; i++) {\n            adj[i] = new ArrayList<>();\n        }\n\n        for (int i = 0; i < K; ++i) {\n            int u = sc.nextInt();\n            connect(SOURCE, get_node(u, 0), 0, 1);\n        }\n\n        for (int t = 0; t <= max_time; ++t) {\n            connect(get_node(1, t), SINK, (int) ((long) C * t), K);\n        }\n\n        for (int v = 1; v <= N; ++v) {\n            for (int t = 0; t < max_time; ++t) {\n                connect(get_node(v, t), get_node(v, t + 1), 0, K);\n            }\n        }\n\n        while (M-- > 0) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int i = 1; i <= K; ++i) {\n                for (int t = 0; t < max_time; ++t)