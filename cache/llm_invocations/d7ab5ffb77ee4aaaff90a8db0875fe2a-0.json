/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev;\n        long cap, cost;\n        Edge(int to, int rev, long cap, long cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static ArrayList<ArrayList<Edge>> g;\n    static long[] h, dist;\n    static int[] prevv, preve;\n    static final long INF = (long)1e18;\n    static final int T = 99;\n    static final int C = 12;\n\n    static void add_edge(int from, int to, long cap, long cost) {\n        g.get(from).add(new Edge(to, g.get(to).size(), cap, cost));\n        g.get(to).add(new Edge(from, g.get(from).size() - 1, 0, -cost));\n    }\n\n    static long min_cost_flow(int s, int t, long[] price, int n) {\n        h = new long[n];\n        long flow = 0;\n        price[0] = 0;\n        while (true) {\n            dist = new long[n];\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            boolean[] inq = new boolean[n];\n            inq[s] = true;\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                inq[v] = false;\n                for (int i = 0; i < g.get(v).size(); ++i) {\n                    Edge e = g.get(v).get(i);\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            q.add(e.to);\n                            inq[e.to] = true;\n                        }\n                    }\n                }\n            }\n            if (dist[t] == INF) break;\n            for (int v = 0; v < n; ++v) h[v] += dist[v];\n            long d = INF;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = Math.min(d, g.get(prevv[v]).get(preve[v]).cap);\n            }\n            flow += d;\n            price[0] += d * h[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = g.get(prevv[v]).get(preve[v]);\n                e.cap -= d;\n                g.get(v).get(e.rev).cap += d;\n            }\n        }\n        return flow;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        final int source = 0;\n        final int sink = n * T + 1;\n        g = new ArrayList<>(sink + 1);\n        for (int i = 0; i <= sink; ++i) g.add(new ArrayList<>());\n\n        for (int i = 0; i < k; ++i) {\n            int a = sc.nextInt();\n            add_edge(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; ++t) {\n            add_edge(1 + t * n, sink, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; ++i) {\n                    add_edge(i + (t-1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; ++j) {\n                long cost = (j+1)*(j+1) - j*j;\n                for (int t = 1; t < T; ++t) {\n                    add_edge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                    add_edge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n\n        long[] price = new long[1];\n        long flow = min_cost_flow(source, sink, price, sink + 1);\n        // assert(flow == k); // Java assert disabled by default; we check\n        if (flow != k) {\n            // Should not happen, but for safety\n            System.ou