nc] = 1;\n                qr.push(nr); qc.push(nc);\n            }\n        }\n    }\n}\n\nbool pathExists(int r1, int c1, int r2, int c2, int t) {\n    if (t > T) return false;\n    int& ans = dp[r1][c1][r2][c2][t];\n    if (ans != -1) return ans;\n    if (r1 == r2 && c1 == c2) return ans = (dist[r1][c1] >= t);\n    if (dist[r1][c1] <= t) return ans = false;\n    for (int k = 0; k < 4; ++k) {\n        int nr = r1 + dr[k];\n        int nc = c1 + dc[k];\n        if (ok(nr, nc) && pathExists(nr, nc, r2, c2, t + 1)) return ans = true;\n    }\n    return ans = false;\n}\n\nbool bfs(int s, int t) {\n    memset(par, -1, sizeof(par));\n    par[s] = -2;\n    queue<int> q;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (int v = s; v <= t; ++v) {\n            if (par[v] == -1 && cap[u][v] > 0) {\n                par[v] = u;\n                q.push(v);\n            }\n        }\n    }\n    return par[t] != -1;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(32);\n\n    cin >> N >> T;\n    for (int i = 0; i < N; ++i) cin >> gridS[i];\n    for (int i = 0; i < N; ++i) cin >> gridL[i];\n\n    vector<pair<int, int>> pts;\n    vector<int> labC, sciC;\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (gridS[i][j] == 'Z') {\n                r0 = i; c0 = j;\n            } else if (isdigit(gridS[i][j])) {\n                pts.emplace_back(i, j);\n                labC.push_back(gridL[i][j] - '0');\n                sciC.push_back(gridS[i][j] - '0');\n            }\n        }\n    }\n\n    int m = pts.size();\n    memset(cap, 0, sizeof(cap));\n    for (int i = 0; i < m; ++i) {\n        cap[0][i + 1] = sciC[i];\n        cap[m + 1 + i][2 * m + 1] = labC[i];\n    }\n\n    initBFS();\n    memset(dp, -1, sizeof(dp));\n    for (int i = 0; i < m; ++i) {\n        for (int j = 0; j < m; ++j) {\n            if (pathExists(pts[i].first, pts[i].second, pts[j].first, pts[j].second, 0)) {\n                cap[i + 1][m + 1 + j] = 1000;\n            }\n        }\n    }\n\n    int flow = 0;\n    while (bfs(0, 2 * m + 1)) {\n        int sink = 2 * m + 1;\n        int f = 1000000;\n        while (par[sink] >= 0) {\n            f = min(f, cap[par[sink]][sink]);\n            sink = par[sink];\n        }\n        sink = 2 * m + 1;\n        while (par[sink] >= 0) {\n            cap[par[sink]][sink] -= f;\n            cap[sink][par[sink]] += f;\n            sink = par[sink];\n        }\n        flow += f;\n    }\n\n    cout << flow;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx]); idx += 1\n    T = int(data[idx]); idx += 1\n    \n    gridS = []\n    for i in range(N):\n        gridS.append(data[idx]); idx += 1\n    \n    gridL = []\n    for i in range(N):\n        gridL.append(data[idx]); idx += 1\n    \n    dr = [1, -1, 0, 0]\n    dc = [0, 0, 1, -1]\n    \n    def ok(r, c):\n        return 0 <= r < N and 0 <= c < N and gridL[r][c] != 'Y' and gridL[r][c] != 'Z'\n    \n    # Find starting position and collect points\n    r0, c0 = 0, 0\n    pts = []\n    labC = []\n    sciC = []\n    \n    for i in range(N):\n        for j in range(N):\n            if gridS[i][j] == 'Z':\n                r0, c0 = i, j\n            elif gridS[i][j].isdigit():\n                pts.append((i, j))\n                labC.append(ord(gridL[i][j]) - ord('0'))\n                sciC.append(ord(gridS[i][j]) - ord('0'))\n    \n    m = len(pts)\n    \n    # Initialize distance and visited arrays\n    INF = 10**9\n    dist = [[INF] * N for _ in range(N)]\n    vis = [[0] * N for _ in range(N)]\n    \n    # BFS from starting position\n    dist[r0][c0] = 0\n    vis[r0][c0] = 1\n    qr = deque()\n    qc = deque()\n    qr.append(r0)\n    qc.append(c0)\n    \n    while qr:\n        r = qr.popleft()\n        c = qc.popleft()\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if ok(nr, nc) and not vis[nr][nc]:\n                dist[nr][nc] = dist[r][c] + 1\n                vis[nr][nc] = 1\n                qr.append(nr)\n                qc.append(nc)\n    \n    # DP memoization array\n    dp = [[[[[-1] * 62 for _ in range(12)] for _ in range(12)] for _ in range(12)] for _ in range(12)]\n    \n    def pathExists(r1, c1, r2, c2, t):\n        if t > T:\n            return False\n        if dp[r1][c1][r2][c2][t] != -1:\n            return dp[r1][c1][r2][c2][t]\n        if r1 == r2 and c1 == c2:\n            dp[r1][c1][r2][c2][t] = 1 if dist[r1][c1] >= t else 0\n            return dp[r1][c1][r2][c2][t]\n        if dist[r1][c1] <= t:\n            dp[r1][c1][r2][c2][t] = 0\n            return False\n        for k in range(4):\n            nr = r1 + dr[k]\n            nc = c1 + dc[k]\n            if ok(nr, nc) and pathExists(nr, nc, r2, c2, t + 1):\n                dp[r1][c1][r2][c2][t] = 1\n                return True\n        dp[r1][c1][r2][c2][t] = 0\n        return False\n    \n    # Build capacity graph\n    cap = [[0] * (2 * m + 2) for _ in range(2 * m + 2)]\n    \n    for i in range(m):\n        cap[0][i + 1] = sciC[i]\n        cap[m + 1 + i][2 * m + 1] = labC[i]\n    \n    for i in range(m):\n        for j in range(m):\n            if pathExists(pts[i][0], pts[i][1], pts[j][0], pts[j][1], 0):\n                cap[i + 1][m + 1 + j] = 1000\n    \n    # Ford-Fulkerson / BFS for max flow\n    def bfs(s, t):\n        par = [-1] * (2 * m + 2)\n        par[s] = -2\n        q = deque()\n        q.append(s)\n        while q:\n            u = q.popleft()\n            for v in range(s, t + 1):\n                if par[v] == -1 and cap[u][v] > 0:\n                    par[v] = u\n                    q.append(v)\n        return par[t] != -1\n    \n    flow = 0\n    while bfs(0, 2 * m + 1):\n        sink = 2 * m + 1\n        f = 1000000\n        path_nodes = []\n        while par[sink] >= 0:\n            path_nodes.append(sink)\n            f = min(f, cap[par[sink]][sink])\n            sink = par[sink]\n        path_nodes.append(0)\n        sink = 2 * m + 1\n        while par[sink] >= 0:\n            cap[par[sink]][sink] -= f\n            cap[sink][par[sink]] += f\n            sink = par[sink]\n        flow += f\n    \n    print(flow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021419614495243877, -1.1920922133867862e-06, -5.960462772236497e-07, -0.14353694021701813, -0.0013230626937001944, -3.576278118089249e-07, -0.004079948179423809, -0.0002746204845607281, -1.311301275563892e-06, -0.00012683063687290996, -0.3137114942073822, -0.02669701725244522, -0.046680841594934464, -4.768370445162873e-07, -5.960462772236497e-07, -0.00797823816537857, -0.014272983185946941, -1.0251946150674485e-05, -1.3112935448589269e-05, -0.026720810681581497, -0.0005937243695370853, -3.2186455882765586e-06, -0.0007849234389141202, -1.1920928244535389e-07, -1.9550132492440753e-05, -1.1920922133867862e-06, -0.001177451922558248, -0.6966006755828857, -0.06197243183851242, -5.960462772236497e-07, -0.7104938626289368, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, -6.556489552167477e-06, -7.152555099310121e-07, -4.768370445162873e-07, -1.1920922133867862e-06, -5.960462772236497e-07, -7.152555099310121e-07, -2.3841855067985307e-07, -0.004160677082836628, -0.0008226824575103819, -1.5497195136049413e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.002188669750466943, -7.390948667307384e-06, -3.933898824470816e-06, -4.0531076592742465e-06, -9.417090768693015e-05, -2.622600959512056e-06, -7.033323527139146e-06, -3.576278118089249e-07, -4.768370445162873e-07, -0.04863468185067177, -2.3841855067985307e-07