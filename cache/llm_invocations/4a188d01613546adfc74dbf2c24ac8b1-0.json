    int[] alice = new int[aliceParts.length];\n        for (int i = 0; i < aliceParts.length; i++) {\n            alice[i] = Integer.parseInt(aliceParts[i]);\n        }\n        \n        String bobLine = scanner.nextLine().trim();\n        String[] bobParts = bobLine.split(\" \");\n        int[] bob = new int[bobParts.length];\n        for (int i = 0; i < bobParts.length; i++) {\n            bob[i] = Integer.parseInt(bobParts[i]);\n        }\n        \n        // Rotate bob left by one: bob[1:] + [bob[0]]\n        int[] rotatedBob = new int[bob.length];\n        for (int i = 0; i < bob.length - 1; i++) {\n            rotatedBob[i] = bob[i + 1];\n        }\n        rotatedBob[bob.length - 1] = bob[0];\n        bob = rotatedBob;\n        \n        // maxWin = sum of element-wise min\n        int maxWin = 0;\n        for (int i = 0; i < alice.length; i++) {\n            maxWin += Math.min(alice[i], bob[i]);\n        }\n        \n        int maxAlice = 0;\n        for (int a : alice) {\n            if (a > maxAlice) maxAlice = a;\n        }\n        int maxBob = 0;\n        for (int b : bob) {\n            if (b > maxBob) maxBob = b;\n        }\n        \n        List<Integer> candidates = new ArrayList<>();\n        for (int i = 0; i < alice.length; i++) {\n            if (bob[i] == maxBob || alice[i] == maxAlice) {\n                candidates.add(alice[i] + bob[i]);\n            }\n        }\n        \n        int minWin = 0;\n        if (!candidates.isEmpty()) {\n            minWin = Collections.max(candidates);\n        }\n        if (minWin > turnNum) {\n            minWin -= turnNum;\n        } else {\n            minWin = 0;\n        }\n        \n        System.out.println(minWin + \" \" + maxWin);\n        \n        scanner.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.9192511899746023e-05, 0.0, -1.1920928244535389e-07, -1.585470999998506e-05, -3.3378546504536644e-06, 0.0, -6.198863957251888e-06, -0.53650760650