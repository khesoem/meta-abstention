    }\n        }\n        return pre[t] != -1;\n    }\n\n    static int minCostMaxflow(int s, int t, int[] cost) {\n        int flow = 0;\n        cost[0] = 0;\n        while (spfa(s, t)) {\n            int Min = Integer.MAX_VALUE;\n            for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n                if (Min > edge[i].cap - edge[i].flow)\n                    Min = edge[i].cap - edge[i].flow;\n            }\n            for (int i = pre[t]; i != -1; i = pre[edge[i ^ 1].to]) {\n                edge[i].flow += Min;\n                edge[i ^ 1].flow -= Min;\n                cost[0] += edge[i].cost * Min;\n            }\n            flow += Min;\n        }\n        return flow;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.16288045048713684, -0.018551543354988098, -0.5776816010475159, -0.0626220777630806, -0.00017251071403734386, -0.429259330034256, -0.6774806976318359, -5.3526404371950775e-05, -1.0609683158691041e-05, -9.298368240706623e-06, -1.7762342395144515e-05, -0.104259192943573, -4.768372718899627e-07, -1.1920935776288388e-06, -3.57628505298635e-06, -3.933914285880746e-06, -0.0076231504790484905, -3.1352534278994426e-05, -1.4543638826580718e-05, -1.0371261851105373e-05, -0.2524355947971344, -0.01710634119808674, -0.0013264867011457682, -0.00013400021998677403, -4.303548121242784e-05, -0.002065167063847184, -1.019755482673645, -9.298368240706623e-06, -0.0004887583199888468, -1.0132840543519706e-05, -2.4318991563632153e-05, -4.768372718899627e-07, -0.8848052024841309, -0.6931490898132324, -0.019196180626749992, -9.775209946383256e-06, -0.11373592913150787, -0.5302067995071411, -0.037080515176057816, -0.03294137865304947, -0.34897735714912415, -0.00614716624841094, -0.0113390376791358, -9.918704745359719e-05, -0.0040749371983110905, -0.014637323096394539, -0.029995474964380264, -0.06878942251205444, -0.0011482868576422334, -0.012929276563227177, -8.380764484172687e-05, -0.004281075205653906, -0.000247091782