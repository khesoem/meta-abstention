{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cctype>\nusing namespace std;\n\nusing ll = long long;\n\nint n, K, MOD;\nvector<vector<int>> dp;\nvector<ll> temp;\nvector<int> bit_count;\n\ninline int norm(int x) {\n    return (x % MOD + MOD) % MOD;\n}\n\ninline void add(int &x, int y) {\n    x = norm(x + y);\n}\n\nint power(int base, int exp) {\n    int res = 1;\n    base = norm(base);\n    while (exp) {\n        if (exp & 1) res = (ll)res * base % MOD;\n        base = (ll)base * base % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nvector<int> fact, inv_fact;\n\nvoid init_fact(int max_n) {\n    fact.resize(max_n + 1);\n    inv_fact.resize(max_n + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= max_n; ++i)\n        fact[i] = (ll)fact[i-1] * i % MOD;\n    inv_fact[max_n] = power(fact[max_n], MOD - 2);\n    for (int i = max_n - 1; i >= 0; --i)\n        inv_fact[i] = (ll)inv_fact[i+1] * (i+1) % MOD;\n}\n\nvoid fwht(vector<int> &a, int sign) {\n    int n = a.size();\n    for (int len = 1; len < n; len <<= 1) {\n        for (int i = 0; i < n; i += len << 1) {\n            for (int j = 0; j < len; ++j) {\n                int x = a[i + j];\n                int y = (ll)sign * a[i + j + len] % MOD;\n                a[i + j] = norm(x + y);\n                a[i + j + len] = norm(x - y);\n            }\n        }\n    }\n}\n\nint main() {\n#ifdef pig\n    freopen(\"C.in\", \"r\", stdin);\n    freopen(\"C.out\", \"w\", stdout);\n#endif\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> K >> MOD;\n    init_fact(n);\n    \n    if (n & 1) {\n        cout << power(K, n);\n        return 0;\n    }\n    \n    int m = 1, L = 0;\n    while (m <= n) {\n        m <<= 1;\n        ++L;\n    }\n    \n    bit_count.resize(m);\n    for (int i = 0; i < m; ++i)\n        bit_count[i] = __builtin_popcount(i);\n    \n    init_fact(m);\n    \n    dp.assign(L + 1, vector<int>(m, 0));\n    for (int i = 0; i < m; ++i)\n        dp[bit_count[i]][i] = inv_fact[i];\n    \n    for (int i = 0; i <= L; ++i)\n        fwht(dp[i], 1);\n    \n    temp.resize(L + 1);\n    for (int s = 0; s < m; ++s) {\n        for (int i = 0; i <= L; ++i)\n            temp[i] = dp[i][s];\n        \n        vector<ll> res(L + 1, 0);\n        res[0] = 1;\n        vector<ll> base(temp.begin(), temp.end());\n        int exp = K;\n        \n        while (exp) {\n            if (exp & 1) {\n                vector<ll> new_res(L + 1, 0);\n                for (int i = 0; i <= L; ++i)\n                    for (int j = 0; j <= L - i; ++j)\n                        new_res[i + j] = (new_res[i + j] + res[i] * base[j]) % MOD;\n                res = move(new_res);\n            }\n            vector<ll> sq(L + 1, 0);\n            for (int i = 0; i <= L; ++i)\n                for (int j = 0; j <= L - i; ++j)\n                    sq[i + j] = (sq[i + j] + base[i] * base[j]) % MOD;\n            base = move(sq);\n            exp >>= 1;\n        }\n        \n        for (int i = 0; i <= L; ++i)\n            dp[i][s] = res[i];\n    }\n    \n    fwht(dp[bit_count[n]], m, -1);\n    \n    int ans = norm(power(K, n) - (ll)dp[bit_count[n]][n] * fact[n] % MOD);\n    cout << ans;\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    K = int(data[1])\n    MOD = int(data[2])\n    \n    def norm(x):\n        return (x % MOD + MOD) % MOD\n    \n    def power(base, exp):\n        res = 1\n        base = norm(base)\n        while exp:\n            if exp & 1:\n                res = (res * base) % MOD\n            base = (base * base) % MOD\n            exp >>= 1\n        return res\n    \n    # Initialize factorials\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = (fact[i-1] * i) % MOD\n    \n    # If n is odd\n    if n & 1:\n        print(power(K, n))\n        return\n    \n    # Compute m and L\n    m = 1\n    L = 0\n    while m <= n:\n        m <<= 1\n        L += 1\n    \n    # Compute bit counts\n    bit_count = [bin(i).count('1') for i in range(m)]\n    \n    # Compute inverse factorials up to m\n    inv_fact = [1] * (m + 1)\n    inv_fact[m] = power(fact[m], MOD - 2)\n    for i in range(m - 1, -1, -1):\n        inv_fact[i] = (inv_fact[i+1] * (i+1)) % MOD\n    \n    # Initialize dp\n    dp = [[0] * m for _ in range(L + 1)]\n    for i in range(m):\n        dp[bit_count[i]][i] = inv_fact[i]\n    \n    # FWHT function\n    def fwht(a, sign):\n        n_a = len(a)\n        len_ = 1\n        while len_ < n_a:\n            for i in range(0, n_a, len_ << 1):\n                for j in range(len_):\n                    x = a[i + j]\n                    y = (sign * a[i + j + len_]) % MOD\n                    a[i + j] = norm(x + y)\n                    a[i + j + len_] = norm(x - y)\n            len_ <<= 1\n    \n    # Apply FWHT to each dp[i]\n    for i in range(L + 1):\n        fwht(dp[i], 1)\n    \n    # Process each s\n    temp = [0] * (L + 1)\n    for s in range(m):\n        for i in range(L + 1):\n            temp[i] = dp[i][s]\n        \n        res = [0] * (L + 1)\n        res[0] = 1\n        base = temp[:]\n        exp = K\n        \n        while exp:\n            if exp & 1:\n                new_res = [0] * (L + 1)\n                for i in range(L + 1):\n                    for j in range(L + 1 - i):\n                        new_res[i + j] = (new_res[i + j] + res[i] * base[j]) % MOD\n                res = new_res\n            sq = [0] * (L + 1)\n            for i in range(L + 1):\n                for j in range(L + 1 - i):\n                    sq[i + j] = (sq[i + j] + base[i] * base[j]) % MOD\n            base = sq\n            exp >>= 1\n        \n        for i in range(L + 1):\n            dp[i][s] = res[i]\n    \n    # Inverse FWHT on dp[bit_count[n]]\n    fwht(dp[bit_count[n]], -1)\n    \n    ans = norm(power(K, n) - (dp[bit_count[n]][n] * fact[n]) % MOD)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00023767507809679955, -9.536738616588991e-07, -4.768370445162873e-07, -0.006534281652420759, -0.0007713441736996174, -0.4287976324558258, -0.01315133273601532, -0.6076947450637817, -8.189342770492658e-05, -2.50339189733495e-06, -0.4021284580230713, -4.768370445162873e-07, -0.000706780469045043, -2.002696055569686e-05, -0.04420778900384903, -2.264974000354414e-06, -0.02979855239391327, -1.7046782886609435e-05, -4.768370445162873e-07, -0.05112536624073982, -8.4638240878121e-06, -2.3841855067985307e-07, -1.6093124941107817e-05, -1.1920928244535389e-07, -4.6491513785440475e-06, -0.06996113061904907, -5.960462772236497e-07, -0.057366278022527695, -0.020543068647384644, -2.3841830625315197e-06, -2.50339189733495e-06, -1.1920928244535389e-07, 0.0, -0.0002374367177253589, 0.0, -4.6967357775429264e-05, -2.1576648578047752e-05, -1.54971951360494