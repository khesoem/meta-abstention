  inQueue[SRC] = true;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inQueue[u] = false;\n\n            for (int i = firstLink[u]; i != 0; i = links[i].nextLink) {\n                int v = links[i].target, w = links[i].cost;\n                if (links[i].flow > 0 && distToNode[v] > distToNode[u] + w) {\n                    distToNode[v] = distToNode[u] + w;\n                    if (!inQueue[v]) {\n                        inQueue[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return distToNode[DST] != INF_COST;\n    }\n\n    static int pushFlow(int u, int limit, boolean[] visited) {\n        if (u == DST) return limit;\n        visited[u] = true;\n        int pushed = 0, remaining = limit;\n\n        for (int i = firstLink[u]; i != 0; i = links[i].nextLink) {\n            int v = links[i].target, cap = links[i].flow;\n            if (visited[v] || cap == 0 || distToNode[v] != distToNode[u] + links[i].cost) continue;\n            int f = pushFlow(v, Math.min(remaining, cap), visited);\n            if (f > 0) {\n                remaining -= f;\n                links[i].flow -= f;\n                links[i ^ 1].flow += f;\n                pushed += f;\n                if (remaining == 0) break;\n            }\n        }\n        return pushed;\n    }\n\n    static int minCostFlow() {\n        int total = 0;\n        while (findPath()) {\n            boolean[] visited = new boolean[MAX_NODES];\n            int flow = pushFlow(SRC, INF_COST, visited);\n            if (flow > 0) total += flow * distToNode[DST];\n        }\n        return total;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        V1 = sc.nextInt();\n        V2 = sc.nextInt();\n        DST = node(N, 110, N) + 1;\n\n        for (int i = 2; i <= 110; ++i)\n            connect(node(1, i, N), DST, INF_COST, 0);\n\n        for (int i = 2; i <= N; ++i)\n            for (int j = 1; j < 110; ++j)\n                connect(node(i, j, N), node(i, j + 1, N), INF_COST, V1);\n\n        for (int i = 1; i <= K; ++i) {\n            int x = sc.nextInt();\n            connect(SRC, node(x, 1, N), 1, 0);\n        }\n\n        for (int i = 1; i <= M; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int j = 1; j < 110; ++j)\n                for (int l = 1; l <= K; ++l) {\n                    int c = V2 * (2 * l - 1) + V1;\n                    connect(node(x, j, N), node(y, j + 1, N), 1, c);\n                    connect(node(y, j, N), node(x, j + 1, N), 1, c);\n                }\n        }\n\n        System.out.println(minCostFlow());\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001255195093108341, -2.0265558760002023e-06, -9.536738616588991e-07, -0.00028975578607060015, -4.172238186583854e-05, -0.4740980565547943, -0.038194261491298676, -5.0424259825376794e-05, -3.576278118089249e-07, -6.758938252460212e-05, -0.01603505201637745, -9.619726915843785e-05, -0.11314858496189117, -0.002908050548285246, -2.9802276912960224e-06, -5.364403477869928e-06, -5.483612312673358e-06, -1.1920928244535389e-07, 0.0, -2.0265558760002023e-06, -1.1920928244535389e-07, -4.589452510117553e-05, -1.490105023549404e-05, -0.0031781899742782116, -3.576278118089249e-07, 0.0, -1.0728830375228426e-06, 0.0, -1.1920922133867862e-06, -1.9073468138230965e-06, -5.125986263010418e-06, -3.6954811548639555e-06, -9.298280929215252e-06, 0.0, -5.960462772236497e-07, 0.0, -1.1444026313256472e-05, 0.0, 0.0, -8.344646857949556e-07, 0.0, -1.1920928244535389e-07, -7.152555099310121e-07, -3.576278118089249e-07, -9.059865078597795e-06, -0.47407734394073486, -3.576278118089249e-07, -3.7431014789035544e-05, -0.039412882179021835, -0.0025081150233745575, -2.264974000354414e-06, 0.0, 0.0, 0.0, -1.07288303752284