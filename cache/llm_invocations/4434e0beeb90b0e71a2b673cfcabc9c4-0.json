K = next(it); C = next(it); D = next(it)\n    cnt = [0] * (N + 1)\n    for _ in range(K):\n        cnt[next(it)] += 1\n    roads = []\n    for _ in range(M):\n        a = next(it); b = next(it)\n        roads.append((a, b))\n\n    max_time = K + M + 2\n    pct = 2\n    S = 1\n    E = 2\n    id = [[0] * (max_time + 1) for _ in range(N + 1)]\n    head = [0] * (pct + 1)  # will be resized later\n    edges = []  # list of (b, l, c, ne)\n\n    def add_edge(a, b, c, l):\n        nonlocal pct, head, edges\n        # forward edge\n        edges.append((b, l, c, head[a]))\n        head[a] = len(edges) - 1\n        # reverse edge\n        edges.append((a, 0, -c, head[b]))\n        head[b] = len(edges) - 1\n\n    # Build nodes\n    for i in range(1, N + 1):\n        for j in range(1, max_time + 1):\n            pct += 1\n            id[i][j] = pct\n            # extend head list if needed\n            while len(head) <= pct:\n                head.append(0)\n            if i == 1:\n                add_edge(id[i][j], E, C * (j - 1), 10**9)\n            if j > 1:\n                add_edge(id[i][j - 1], id[i][j], 0, 10**9)\n        if cnt[i]:\n            add_edge(S, id[i][1], 0, cnt[i])\n\n    # Add roads\n    for a, b in roads:\n        for j in range(1, max_time):  # j from 1 to K+M+1 inclusive\n            for k in range(1, 2 * K, 2):\n                add_edge(id[a][j], id[b][j + 1], k * D, 1)\n                add_edge(id[b][j], id[a][j + 1], k * D, 1)\n\n    # Min-cost max-flow\n    INF = 10**9\n    dis = [0] * (pct + 1)\n    inq = [False] * (pct + 1)\n    flag = [False] * (pct + 1)\n\n    def spfa():\n        for i in range(1, pct + 1):\n            dis[i] = INF\n            inq[i] = False\n        dis[S] = 0\n        q = [S]\n        inq[S] = True\n        while q:\n            p = q.pop(0)\n            inq[p] = False\n            i = head[p]\n            while i:\n                b, l, c, ne = edges[i]\n                if l > 0 and dis[b] > dis[p] + c:\n                   