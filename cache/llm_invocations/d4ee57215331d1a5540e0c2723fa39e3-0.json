\n        }\n\n        long dfs(int pos, long flow) {\n            if (pos == t) return flow;\n            vis[pos] = true;\n            long tmp = flow;\n            for (int i = (cur[pos] != -1 ? cur[pos] : head[pos]); i != -1; i = nxt[i]) {\n                if (!vis[v[i]] && w[i] > 0 && dis[v[i]] == dis[pos] + c[i]) {\n                    cur[pos] = i;\n                    long fl = dfs(v[i], Math.min(flow, w[i]));\n                    cost += fl * c[i];\n                    w[i] -= fl;\n                    w[i ^ 1] += fl;\n                    flow -= fl;\n                    if (flow == 0) break;\n                }\n            }\n            return tmp - flow;\n        }\n\n        long dinic(int s, int t) {\n            cost = 0;\n            this.t = t;\n            while (spfa(s, t)) {\n                Arrays.fill(cur, -1);\n                dfs(s, INF);\n            }\n            return cost;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        FlowGraph g = new FlowGraph();\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int kk = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] a = new int[55];\n        for (int i = 1; i <= kk; ++i) a[i] = sc.nextInt();\n\n        int s = 0;\n        int t = n * 100 + 1;\n\n        // sink edges\n        for (int i = 1; i <= 100; ++i) {\n            g.add_edge(i, t, INF, 0);\n        }\n\n        // source edges\n        for (int i = 1; i <= kk; ++i) {\n            g.add_edge(s, (a[i] - 1) * 100 + 1, 1, 0);\n        }\n\n        // stay edges\n        for (int i = 2; i <= n; ++i) {\n            for (int j = 1; j < 100; ++j) {\n                g.add_edge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, INF, c);\n            }\n        }\n\n        int t1, t2;\n        for (int _ = 1; _ <= m; ++_) {\n            t1 = sc.nextInt();\n            t2 = sc.nextInt();\n            for (int i = 1; i < 100; +