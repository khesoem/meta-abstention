ring[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int N = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        int n = N * 101 + 2;\n        List<List<Edge>> g = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            g.add(new ArrayList<>());\n        }\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(br.readLine()) - 1;\n            addEdge(g, n - 2, x * 101, 1, 0);\n        }\n        for (int i = 0; i < 101; i++) {\n            addEdge(g, i, n - 1, Integer.MAX_VALUE, i * c);\n        }\n        for (int i = 1; i < N; i++) {\n            for (int j = 0; j + 1 < 101; j++) {\n                addEdge(g, i * 101 + j, i * 101 + j + 1, Integer.MAX_VALUE, 0);\n            }\n        }\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken()) - 1;\n            int v = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j + 1 < 101; j++) {\n                for (int K = 1; K <= k; K++) {\n                    addEdge(g, u * 101 + j, v * 101 + j + 1, 1, d * K * K - d * (K - 1) * (K - 1));\n                    addEdge(g, v * 101 + j, u * 101 + j + 1, 1, d * K * K - d * (K - 1) * (K - 1));\n                }\n            }\n        }\n        int s = n - 2;\n        int t = n - 1;\n        int flow = 0;\n        int cost = 0;\n        while (flow < k) {\n            int[] id = new int[n];\n            int[] d = new int[n];\n            int[] q = new int[n];\n            int[] p = new int[n];\n            int[] p_rib = new int[n];\n            int qh = 0, qt = 0;\n            q[qt++] = s;\n            d[s] = 0;\n            while (qh != qt) {\n                int v = q[qh++];\n                id[v] = 2;\n                if (qh == n) qh = 0;\n                for (Edge e : g.get(v)) {\n                    if (e.flow < e.capacity && d[v] + e.cost < d[e.to]) {\n                        d[e.to] = d[v] + e.cost;\n                        if (id[e.to] == 0) {\n                            q[qt++] = e.to;\n                            if (qt == n) qt = 0;\n                        } else if (id[e.to] == 2) {\n                            if (--qh == -1) qh = n - 1;\n                            q[qh] = e.to;\n                        }\n                        id[e.to] = 1;\n                        p[e.to] = v;\n                        p_rib[e.to] = g.get(v).indexOf(e);\n                    }\n                }\n            }\n            if (d[t] == Integer.MAX_VALUE) break;\n            int addflow = k - flow;\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                addflow = Math.min(addflow, g.get(pv).get(p_rib[v]).capacity - g.get(pv).get(p_rib[v]).flow);\n            }\n            for (int v = t; v != s; v = p[v]) {\n                int pv = p[v];\n                int pr = p_rib[v];\n                g.get(pv).get(pr).flow += addflow;\n                g.get(v).get(g.get(pv).get(pr).back).flow -= addflow;\n                cost += g.get(pv).get(pr).cost * addflow;\n            }\n            flow += addflow;\n        }\n        assert (flow == k);\n        System.out.println(cost);\n    }\n\n    public static void addEdge(List<List<Edge>> g, int a, int b, int capacity, int cost) {\n        Edge e1 = new Edge(b, 0, capacity, cost, g.get(b).size());\n        Edge e2 = new Edge(a, 0, -capacity, -cost, g.get(a).size());\n        g.get(a).add(e1);\n        g.get(b).add(e2);\n    }\n</translated_code>\n<confidence>\n<0.95>\n</confidence>", "token_logprobs": [-0.18291828036308289, -0.008906270377337933, -0.03092573955655098, -0.009384240023791