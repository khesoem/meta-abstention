while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i = 0; i < (int)g[v].size(); i++) {\n            int eid = g[v][i];\n            Edge &e = edges[eid];\n            if (e.cap == e.flow) continue;\n            int to = e.to;\n            ll len = e.cost + phi[v] - phi[to];\n            if (d[v] + len < d[to]) {\n                q.erase({d[to], to});\n                d[to] = d[v] + len;\n                par[to] = eid;\n                q.insert({d[to], to});\n            }\n        }\n    }\n}\n\npair<ll, ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (true) {\n        if (d[t] == INF) break;\n        ll pushed = INF, sum = 0;\n        for (int tmp = t; tmp != s; tmp = edges[par[tmp]].from) {\n            int eid = par[tmp];\n            pushed = min(pushed, edges[eid].cap - edges[eid].flow);\n            sum += edges[eid].cost;\n        }\n        flow += pushed;\n        cost += pushed * sum;\n        for (int tmp = t; tmp != s; tmp = edges[par[tmp]].from) {\n            int eid = par[tmp];\n            edges[eid].flow += pushed;\n            edges[eid ^ 1].flow -= pushed;\n        }\n        dijkstra(s);\n        for (int i = 0; i < maxn; i++) phi[i] = d[i];\n    }\n    return {cost, flow};\n}\n\nvoid solve() {\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnts(n, 0);\n    for (int i = 0; i < k; i++) {\n        int ai;\n        cin >> ai;\n        ai--;\n        cnts[ai]++;\n    }\n    for (int i = 0; i < n; i++) {\n        add_edge(5000, i, cnts[i], 0);\n    }\n    for (int it = 0; it < m; it++) {\n        int u, v;\n        cin >> u >> v;\n        u--;\n        v--;\n        for (int i = 0; i < 99; i++) {\n            ll cost = d;\n            for (int j = 0; j < 50; j++) {\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cost);\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost);\n     