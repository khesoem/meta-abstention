n\n    static void solve() throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int[] cnts = new int[n];\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int ai = Integer.parseInt(st.nextToken()) - 1;\n            cnts[ai]++;\n        }\n\n        for (int i = 0; i < maxn; i++) g[i] = new ArrayList<>();\n\n        for (int i = 0; i < n; i++) {\n            add_edge(5000, i, cnts[i], 0);\n        }\n\n        for (int it = 0; it < it < m; it++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken()) - 1;\n            int v = Integer.parseInt(st.nextToken()) - 1;\n            for (int i = 0; i < 99; i++) {\n                long cost = d;\n            for (int j = 0; j < 50; j++) {\n                add_edge(u + i * 50, v + (i + 1) * 50, 1, cost);\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost);\n                cost += 2 * d;\n            }\n        }\n    }\n\n    for (int i = 0; i <= 99; i++) {\n        add_edge(0 + i * 50, 5001, INF, c * i);\n    }\n\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < 99; j++) {\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0);\n        }\n    }\n\n    long[] res = mincost_maxflow(5000, 5001);\n    long flow = res[1];\n    long cost = res[0];\n    if (flow != k) {\n        throw new RuntimeException(\"Assertion failed: flow != k\");\n    }\n    System.out.println(cost);\n}\n\npublic static void main(String[] args) throws IOException {\n    solve();\n}\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "t