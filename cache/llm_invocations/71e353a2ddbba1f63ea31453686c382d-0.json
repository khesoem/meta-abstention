{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nint add(int a, int b) { return (a += b) >= MOD ? a - MOD : a; }\nint sub(int a, int b) { return (a -= b) < 0 ? a + MOD : a; }\nint mul(long long a, long long b) { return a * b % MOD; }\nint binpow(int a, int e) {\n    int r = 1;\n    while (e) {\n        if (e & 1) r = mul(r, a);\n        a = mul(a, a);\n        e >>= 1;\n    }\n    return r;\n}\nint modinv(int a) { return binpow(a, MOD - 2); }\nint divide(int a, int b) { return mul(a, modinv(b)); }\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifdef LOCAL\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    cin >> n;\n\n    vector<vector<int>> mat(n, vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> mat[i][j];\n            mat[i][j] = divide(mat[i][j], 100);\n        }\n\n    using State = pair<vector<char>, int>;\n    vector<State> dp = {{{0}, 1}};\n\n    for (int col = 0; col < n; ++col) {\n        vector<State> nxt;\n\n        for (int bitmask = 0; bitmask < (1 << n); ++bitmask) {\n            int p = 1;\n            for (int i = 0; i < n; ++i)\n                p = mul(p, (bitmask >> i & 1) ? mat[i][col] : sub(1, mat[i][col]));\n\n            for (const auto& [maskvec, coef] : dp) {\n                vector<char> nmasks;\n                for (char base : maskvec) {\n                    int rem = bitmask ^ (base & bitmask);\n                    while (rem) {\n                        int low = rem & -rem;\n                        nmasks.push_back(base | low);\n                        rem ^= low;\n                    }\n                }\n                if (nmasks.empty()) continue;\n                sort(nmasks.begin(), nmasks.end());\n                nmasks.erase(unique(nmasks.begin(), nmasks.end()), nmasks.end());\n                nxt.emplace_back(nmasks, mul(coef, p));\n            }\n        }\n\n        sort(nxt.begin(), nxt.end());\n        dp.clear();\n\n        for (int i = 0; i < (int)nxt.size(); ) {\n            int j = i;\n            int sum = 0;\n            while (j < (int)nxt.size() && nxt[j].first == nxt[i].first)\n                sum = add(sum, nxt[j++].second);\n            dp.emplace_back(nxt[i].first, sum);\n            i = j;\n        }\n    }\n\n    int ans = 0;\n    for (const auto& [_, coef] : dp) ans = add(ans, coef);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\n\ndef add(a, b):\n    a += b\n    return a - MOD if a >= MOD else a\n\ndef sub(a, b):\n    a -= b\n    return a + MOD if a < 0 else a\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef binpow(a, e):\n    r = 1\n    while e:\n        if e & 1:\n            r = mul(r, a)\n        a = mul(a, a)\n        e >>= 1\n    return r\n\ndef modinv(a):\n    return binpow(a, MOD - 2)\n\ndef divide(a, b):\n    return mul(a, modinv(b))\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    \n    n = int(data[idx])\n    idx += 1\n    \n    mat = []\n    for i in range(n):\n        row = []\n        for j in range(n):\n            val = int(data[idx])\n            idx += 1\n            row.append(divide(val, 100))\n        mat.append(row)\n    \n    # dp: list of (mask_vector, coefficient)\n    # mask_vector is a tuple of integers representing the state\n    dp = [((1,), 1)]  # Start with a single state: mask_vector = (1,), coef = 1\n    \n    for col in range(n):\n        nxt = []\n        \n        for bitmask in range(1 << n):\n            p = 1\n            for i in range(n):\n                if (bitmask >> i) & 1:\n                    p = mul(p, mat[i][col])\n                else:\n                    p = mul(p, sub(1, mat[i][col]))\n            \n            for maskvec, coef in dp:\n                nmasks = []\n                for base in maskvec:\n                    rem = bitmask ^ (base & bitmask)\n                    while rem:\n                        low = rem & -rem\n                        nmasks.append(base | low)\n                        rem ^= low\n                \n                if not nmasks:\n                    continue\n                \n                nmasks = sorted(set(nmasks))\n                nxt.append((tuple(nmasks), mul(coef, p)))\n        \n        # Group by mask_vector and sum coefficients\n        dp_dict = defaultdict(int)\n        for maskvec, coef in nxt:\n            dp_dict[maskvec] = add(dp_dict[maskvec], coef)\n        \n        dp = [(maskvec, coef) for maskvec, coef in dp_dict.items()]\n    \n    ans = 0\n    for _, coef in dp:\n        ans = add(ans, coef)\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001481661747675389, -1.1920922133867862e-06, -3.5