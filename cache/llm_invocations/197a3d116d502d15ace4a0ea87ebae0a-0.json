f (edges[e].cap && d[v] > d[u] + edges[e].cost) {\n                d[v] = d[u] + edges[e].cost;\n                min_flow[v] = min(min_flow[u], edges[e].cap);\n                prev_e[v] = e;\n                prev_v[v] = u;\n                if (!vis[v]) {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return min_flow[target];\n}\n\nint N, M, K, C_cost, D_cost;\nint plan[105][105];\nint count_st[105][105];\nstruct Segment { int u, v; } seg[105];\n\n#define V(node_day,loc) ((node_day) * N + (loc))\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> N >> M >> K >> C_cost >> D_cost;\n    source = V(N + K, N) + 1;\n    target = source + 2;\n\n    add_edge(V(0,1), target, INF, 0);\n\n    for (int i = 1, p; i <= K; ++i) {\n        cin >> p;\n        add_edge(source, V(0,p), 1, 0);\n    }\n\n    for (int i = 1; i <= M; ++i) {\n        cin >> seg[i*2].u >> seg[i*2].v;\n        seg[i*2-1] = {seg[i*2].v, seg[i*2].u};\n    }\n    M <<= 1;\n\n    for (int day = 1; day <= N + K; ++day) {\n        for (int i = 1; i <= N; ++i)\n            add_edge(V(day-1, i), V(day, i), INF, 0);\n        for (int i = 1; i <= M; ++i) {\n            add_edge(V(day-1, seg[i].u), V(day, seg[i].v), 1, D_cost);\n            plan[day][i] = e_idx;\n            count_st[day][i] = 1;\n        }\n        add_edge(V(day, 1), target, INF, day * C_cost);\n    }\n\n    int aug, total_cost = 0;\n    while (aug = spfa_algo()) {\n        int v = target;\n        while (v != source) {\n            int u = prev_v[v];\n            edges[prev_e[v]].cap -= aug;\n            edges[prev_e[v]^1].cap += aug;\n            v = u;\n        }\n        total_cost += d[target] * aug;\n\n        for (int day = 1; day <= N + N; ++day)\n            for (int i = 1; i <= M; ++i)\n                if (edges[plan[day][i]].cap) {\n                    count_st[day][i]++;\n                    add_edge(V(day-1, seg[i].u), V(day, seg[i].v)