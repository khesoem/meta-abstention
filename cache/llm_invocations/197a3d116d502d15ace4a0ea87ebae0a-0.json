 + K + 1):\n        for i in range(1, N + 1):\n            add_edge(V(day - 1, i), V(day, i), INF, 0)\n        for i in range(1, M + 1):\n            add_edge(V(day - 1, seg[i]['u']), V(day, seg[i]['v']), 1, D_cost)\n            plan[day][i] = e_idx\n            count_st[day][i] = 1\n        add_edge(V(day, 1), target, INF, day * C_cost)\n    \n    prev_v = [0] * MAX_V\n    prev_e = [0] * MAX_V\n    min_flow = [0] * MAX_V\n    d = [INF] * MAX_V\n    vis = [False] * MAX_V\n    \n    def spfa_algo():\n        nonlocal d, min_flow, prev_v, prev_e, vis\n        for i in range(1, target + 1):\n            d[i] = INF\n            min_flow[i] = 0\n        min_flow[source] = INF\n        d[source] = 0\n        q = deque()\n        q.append(source)\n        vis[source] = True\n        \n        while q:\n            u = q.popleft()\n            vis[u] = False\n            \n            e = head[u]\n            while e:\n                edge = edges[e]\n                v = edge.to\n                if edge.cap and d[v] > d[u] + edge.cost:\n                    d[v] = d[u] + edge.cost\n                    min_flow[v] = min(min_flow[u], edge.cap)\n                    prev_e[v] = e\n                    prev_v[v] = u\n                    if not vis[v]:\n                        vis[v] = True\n                        q.append(v)\n                e = edge.next\n        \n        return min_flow[target]\n    \n    total_cost = 0\n    while True:\n        aug = spfa_algo()\n        if aug == 0:\n            break\n        \n        v = target\n        while v != source:\n            u = prev_v[v]\n            e = prev_e[v]\n            edges[e].cap -= aug\n            edges[e ^ 1].cap += aug\n            v = u\n        \n        total_cost += d[target] * aug\n        \n        for day in range(1, N + N + 1):\n            for i in range(1, M + 1):\n                if edges[plan[day][i]].cap:\n                    count_st[day][i] += 1\n                    u = seg[i]['u']\n                    v = seg[i]['v']\n                    add_edge(V(day - 1, u), V(day, v), 1,\n                            D_cost * (count_st[day][i] * 2 - 1))\n                    plan[day][i] = e_idx\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001419681793777272, -5.960462772236497e-07, -3.576278118089249e-07, -0.01629943959414959, -0.0030761088710278273, -3.576278118089249e-07, -0.0003387354372534901, -0.00031728477915748954, -1.311301275563892e-06, -0.0024807651061564684, -0.0024924185127019882, -0.4033471345901489, -0.0118910763412714, -8.344646857949556e-07, -2.7418097943154862e-06, -0.019323201850056648, -0.003910871222615242, -5.602820692729438e-06, -1.2993727978027891e-05, -0.17906157672405243, -0.0009034366230480373, -2.264974000354414e-06, -0.0002488780301064253, -1.1920928244535389e-07, -0.001975491177290678, -1.0728830375228426e-06, -0.00023755589791107923, -0.00010466027742950246, -0.34845003485679626, -1.4305104514278355e-06, -0.18335579335689545, -0.00013731967192143202, -1.1920928244535389e-07, -2.3841855067985307e-07, -4.827859811484814e-05, -5.364403477869928e-06, -7.557583012385294e-05, -1.3232143828645349e-05, -3.3378546504536644e-06, -1.4305104514278355e-06, -3.576278118089249e-07, -0.0010250320192426443, -0.00021062063751742244, -8.487341256113723e-05, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -6.198863957251888e-06, -1.1920928244535389e-07, -0.006094917189329863, -1.1920922133867862e-06, -1.1920922133867862e-06, -2.622600959512056e-06, -0.00014494798961095512, -6.079655122448457e-06, -1.6689286894688848e-06, 0.0, -1.1920922133867862e-06, -4.768370445162873e-07, 0.0, -3.4570634852570947e-06, -1.311301275563892e-06, -1.0728830375228426e-06, -1.0728830375228426e-06, -1.0728830375228426e-06, -7.092700980138034e-05, -2.622600959512056e-06, -2.264974000354414e-06, -1.1920928244535389e-07, -2.7418097943154862e-06, -5.125986263010418e-06, -2.3841