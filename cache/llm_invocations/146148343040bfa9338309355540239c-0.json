 List<Integer>[] g = new ArrayList[N];\n    static long ans = 0;\n    static long[] d = new long[N];\n    static int[] p = new int[N];\n    static int[] pe = new int[N];\n    static int[] inq = new int[N];\n\n    static int rem(int x) {\n        return e.get(x).cap - e.get(x).flow;\n    }\n\n    static void pushFlow() {\n        Arrays.fill(d, INF);\n        Arrays.fill(p, -1);\n        Arrays.fill(pe, -1);\n        Arrays.fill(inq, 0);\n        d[s] = 0;\n        Queue<Integer> q = new ArrayDeque<>();\n        q.add(s);\n        inq[s] = 1;\n        while (!q.isEmpty()) {\n            int k = q.poll();\n            inq[k] = 0;\n            for (int idx = 0; idx < g[k].size(); ++idx) {\n                int x = g[k].get(idx);\n                if (rem(x) == 0) continue;\n                int c = e.get(x).cost;\n                int y = e.get(x).to;\n                if (d[y] > d[k] + c) {\n                    d[y] = d[k] + c;\n                    p[y] = k;\n                    pe[y] = x;\n                    if (inq[y] == 0) {\n                        inq[y] = 1;\n                        q.add(y);\n                    }\n                }\n            }\n        }\n        int cur = t;\n        while (cur != s) {\n            Edge curEdge = e.get(pe[cur]);\n            curEdge.flow++;\n            Edge revEdge = e.get(pe[cur] ^ 1);\n            revEdge.flow--;\n            cur = p[cur];\n        }\n        ans += d[t];\n    }\n\n    static void addEdge(int x, int y, int cap, int cost) {\n        g[x].add(e.size());\n        e.add(new Edge(y, cap, 0, cost));\n        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        for (int i = 0; i < N; ++i) {\n            g[i] = new ArrayList<>();\n        }\n\n