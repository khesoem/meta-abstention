                    preEdge[v] = e;\n                        if (!inq[v]) {\n                            inq[v] = true;\n                            q.add(v);\n                        }\n                    }\n                }\n            }\n            return dist[t] < INF;\n        }\n\n        int minCostFlow(int s, int t) {\n            this.s = s;\n            this.t = t;\n            int res = 0;\n            int[] dist = new int[n];\n            int[] pre = new int[n];\n            int[] preEdge = new int[n];\n            while (spfa(dist, pre, preEdge)) {\n                int add = INF;\n                for (int v = t; v != s; v = pre[v]) {\n                    add = Math.min(add, edges.get(preEdge[v]).cap);\n                }\n                for (int v = t; v != s; v = pre[v]) {\n                    int e = preEdge[v];\n                    edges.get(e).cap -= add;\n                    edges.get(e ^ 1).cap += add;\n                }\n                res += dist[t] * add;\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int S = 0;\n        int T = n * 100 + 1;\n        MCMF solver = new MCMF(T + 1);\n\n        // Connect each time layer to sink\n        for (int i = 1; i <= 100; ++i) {\n            solver.addEdge(i, T, 100, 0);\n        }\n\n        // Source to start positions\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; ++i) {\n            int v = Integer.parseInt(st.nextToken());\n            solver.addEdge(S, (v - 1) * 100 + 1, 1, 0);\n        }\n\n        // Stay edges (waiting)\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j < 100; ++j) {\n                solver.addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n            }\n        }\n\n        // Move edges (bidirectional)\n        for (int i = 0; i < m; ++i) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            // u -> v\n            for (int j = 1; j < 100; ++j) {\n                int a = (u - 1) * 100 + j;\n                int b = (v - 1) * 100 + j + 1;\n                for (int kk = 1; kk <= 50; ++kk) {\n                    solver.addEdge(a, b, 1, c + (2 * kk - 1) * d);\n                }\n            }\n            // v -> u\n            for (int j = 1; j < 100; ++j) {\n                int a = (v - 1) * 100 + j;\n                int b = (u - 1) * 100 + j + 1;\n                for (int kk = 1; kk <= 50; ++kk) {\n                    solver.addEdge(a, b, 1, c + (2 * kk - 1) * d);\n                }\n            }\n        }\n\n        System.out.println(solver.minCostFlow(S, T));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -2.7417760065873154e-05, -1.764281842042692e-05, 0.0, -0.1602240949869156, -0.16024360060691833, 0.0, 0.0, 0.0, -2.396077979938127e-05, -0.006736070849001408, 0.0, -0.002996837254613638, -0.0031861516181379557, -2.2172682292875834e-05, -0.006770290434360504, -0.02979450300335884, -2.264974000354414e-06, 0.0, -1.1920928244535389e-07, -1.1920922133867862e-06, -7.867782187531702e-06, 0.0, 0.0, -1.6689160474925302e-05, 0.0, -1.1920928244535389e-07, 0.0, -9.536738616588991e-07, 0.0, 0.0, -0.016142621636390686, -5.960462772236497e-07, -2.50339189733495e-06, 0.0, -0.12692856788635254, -3.3378546504536644e-06, 0.0, -1.1920928244535389e-07, 0.0, -0.06204637885093689, -1.1920928244535389e-07, 0.0, -0.000430729589425027