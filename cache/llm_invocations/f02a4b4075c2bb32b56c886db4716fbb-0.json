st;\n                    pre[v] = u;\n                    preEdge[v] = e;\n                    if (!inq[v]) {\n                        inq[v] = 1;\n                        q.push(v);\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    }\n\n    int minCostFlow(int s, int t) {\n        this->s = s;\n        this->t = t;\n        int res = 0;\n        vector<int> dist, pre, preEdge;\n        while (spfa(dist, pre, preEdge)) {\n            int add = INF;\n            for (int v = t; v != s; v = pre[v])\n                add = min(add, edges[preEdge[v]].cap);\n            for (int v = t; v != s; v = pre[v]) {\n                int e = preEdge[v];\n                edges[e].cap -= add;\n                edges[e ^ 1].cap += add;\n            }\n            res += dist[t] * add;\n        }\n        return res;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    int S = 0;\n    int T = n * 100 + 1;\n    MCMF solver(T + 1);\n    for (int i = 1; i <= 100; ++i)\n        solver.addEdge(i, T, 100, 0);\n    for (int i = 0; i < k; ++i) {\n        int v; cin >> v;\n        solver.addEdge(S, (v - 1) * 100 + 1, 1, 0);\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            solver.addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n        }\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v; cin >> u >> v;\n        for (int j = 1; j < 100; ++j) {\n            int a = (u - 1) * 100 + j;\n            int b = (v - 1) * 100 + j + 1;\n            for (int kk = 1; kk <= 50; ++kk) {\n                solver.addEdge(a, b, 1, c + (2 * kk - 1) * d);\n            }\n        }\n        for (int j = 1; j < 100; ++j) {\n            int a = (v - 1) * 100 + j;\n            int b = (u - 1) * 100 + j + 1;\n            for (int kk = 1; kk <= 50; ++kk) {\n                solver.addEdge(a, b, 1, c + (2 * kk 