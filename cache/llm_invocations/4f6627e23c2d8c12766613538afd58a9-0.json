fill(dist, dist + t + 1, INT_MAX);\n        fill(inq, inq + t + 1, false);\n        fill(flow, flow + t + 1, INT_MAX);\n        queue<int> q;\n\n        dist[s] = 0;\n        flow[s] = INT_MAX;\n        q.push(s);\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n\n            for (int idx : AL[u]) {\n                arc& e = EL[idx];\n                if (e.cap > e.f && dist[e.t] > dist[u] + e.c) {\n                    dist[e.t] = dist[u] + e.c;\n                    par[e.t] = idx;\n                    flow[e.t] = min(flow[u], e.cap - e.f);\n                    if (!inq[e.t]) {\n                        inq[e.t] = true;\n                        q.push(e.t);\n                    }\n                }\n            }\n        }\n\n        if (dist[t] == INT_MAX) return false;\n        total_flow += flow[t];\n        total_cost += dist[t] * flow[t];\n        int cur = t;\n        while (cur != s) {\n            int idx = par[cur];\n            EL[idx].f += flow[t];\n            EL[idx ^ 1].f -= flow[t];\n            cur = EL[idx].s;\n        }\n        return true;\n    }\n\n    int solve(int s, int t) {\n        int flow = 0, cost = 0;\n        while (dijkstra(s, t, flow, cost));\n        return cost;\n    }\n} solver;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> n >> m >> k >> C >> D;\n\n    for (int i = 1; i <= k; ++i) {\n        scanf(\"%d\", &P[i]);\n    }\n\n    src = 0;\n    dst = n * 100 + 1;\n\n    for (int i = 1; i <= k; ++i) {\n        solver.link(src, 1 + (P[i] - 1) * 100, 1, 0);\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        int base = (i - 1) * 100;\n        for (int j = 1; j < 100; ++j) {\n            solver.link(base + j, base + j + 1, INT_MAX, C);\n        }\n    }\n\n    for (int i = 1; i <= 100; ++i) {\n        solver.link(i, dst, INT_MAX, 0);\n    }\n\n    while (m--) {\n        int x, y;\n        scanf(\"%d%d\", &x, &y);\n        for (int i = 1; i < 100; ++i) {\n            int u = (x - 1) * 100 + i;\n            int v = (y - 1) * 100 + i + 1;\n            for (int j = 1; j <= 50; ++j) {\n                int w = D * (j * j - (j - 1) * (j - 1)) + C;\n                solver.link(u, v, 1, w);\n            }\n        }\n\n        for (int i = 1; i < 100; ++i) {\n            int u = (y - 1) * 100 + i;\n            int v = (x - 1) * 100 + i + 1;\n            for (int j = 1; j <= 50; ++j) {\n                int w = D * (j * j - (j - 1) * (j - 1)) + C;\n                solver.link(u, v, 1, w);\n            }\n        }\n    }\n\n    printf(\"%d\\n\", solver.solve(src, dst));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport queue\n\nINF = 1000000007\nINT_MAX = 2**31 - 1\n\ndef scan():\n    x = 0\n    c = sys.stdin.read(1)\n    while c and not c.isdigit():\n        c = sys.stdin.read(1)\n    while c and c.isdigit():\n        x = x * 10 + (ord(c) - ord('0'))\n        c = sys.stdin.read(1)\n    return x\n\nclass Arc:\n    def __init__(self, s, t, cap, f, c):\n        self.s = s\n        self.t = t\n        self.cap = cap\n        self.f = f\n        self.c = c\n\nclass MinCostFlow:\n    def __init__(self):\n        self.nv = 0\n        self.EL = []\n        self.AL = []\n        self.dist = []\n        self.par = []\n        self.flow = []\n        self.inq = []\n\n    def clear(self, n):\n        self.nv = n\n        self.AL = [[] for _ in range(n + 1)]\n        self.EL = []\n        self.dist = [0] * (n + 1)\n        self.par = [0] * (n + 1)\n        self.flow = [0] * (n + 1)\n        self.inq = [False] * (n + 1)\n\n    def link(self, u, v, cap, cost):\n        self.EL.append(Arc(u, v, cap, 0, cost))\n        self.EL.append(Arc(v, u, 0, 0, -cost))\n        sz = len(self.EL)\n        self.AL[u].append(sz - 2)\n        self.AL[v].append(sz - 1)\n\n    def dijkstra(self, s, t, total_flow, total_cost):\n        for i in range(t + 1):\n            self.dist[i] = INT_MAX\n            self.inq[i] = False\n            self.flow[i] = INT_MAX\n        \n        q = queue.Queue()\n        self.dist[s] = 0\n        self.flow[s] = INT_MAX\n        q.put(s)\n\n        while not q.empty():\n            u = q.get()\n            self.inq[u] = False\n\n            for idx in self.AL[u]:\n                e = self.EL[idx]\n                if e.cap > e.f and self.dist[e.t] > self.dist[u] + e.c:\n                    self.dist[e.t] = self.dist[u] + e.c\n                    self.par[e.t] = idx\n                    self.flow[e.t] = min(self.flow[u], e.cap - e.f)\n                    if not self.inq[e.t]:\n                        self.inq[e.t] = True\n                        q.put(e.t)\n\n        if self.dist[t] == INT_MAX:\n            return False, total_flow, total_cost\n        \n        total_flow += self.flow[t]\n        total_cost += self.dist[t] * self.flow[t]\n        cur = t\n        while cur != s:\n            idx = self.par[cur]\n            self.EL[idx].f += self.flow[t]\n            self.EL[idx ^ 1].f -= self.flow[t]\n            cur = self.EL[idx].s\n        \n        return True, total_flow, total_cost\n\n    def solve(self, s, t):\n        flow = 0\n        cost = 0\n        while True:\n            success, flow, cost = self.dijkstra(s, t, flow, cost)\n            if not success:\n                break\n        return cost\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    P = [0] * (k + 1)\n    for i in range(1, k + 1):\n        P[i] = int(next(it))\n\n    src = 0\n    dst = n * 100 + 1\n\n    solver = MinCostFlow()\n    solver.clear(dst + 1)\n\n    for i in range(1, k + 1):\n        solver.link(src, 1 + (P[i] - 1) * 100, 1, 0)\n\n    for i in range(1, n + 1):\n        base = (i - 1) * 100\n        for j in range(1, 100):\n            solver.link(base + j, base + j + 1, INT_MAX, C)\n\n    for i in range(1, 101):\n        solver.link(i, dst, INT_MAX, 0)\n\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        for i in range(1, 100):\n            u = (x - 1) * 100 + i\n            v = (y - 1) * 100 + i + 1\n            for j in range(1, 51):\n                w = D * (j * j - (j - 1) * (j - 1)) + C\n                solver.link(u, v, 1, w)\n\n        for i in range(1, 100):\n            u = (y - 1) * 100 + i\n            v = (x - 1) * 100 + i + 1\n            for j in range(1, 51):\n                w = D * (j * j - (j - 1) * (j - 1)) + C\n                solver.link(u, v, 1, w)\n\n    print(solver.solve(src, dst))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015841660206206143, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.00010489867418073118, -0.0024090574588626623, -2.3841830625315197e-06, -0.4740813672542572, -0.38599345088005066, -0.1602482795715332, -0.4888509511947632, -0.006108424626290798, -0.0028079627081751823, -4.172316494077677e-06, -8.344646857949556e-07, -0.06200660765171051, 0.0, -1.5497195136049413e-06, 0.0, -8.106198947643861e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.6931712627410889, -0.0008485292200930417, -0.005353993736207485, -2.288792165927589e-05, -0.01511289831250906, -3.9219088648678735e-05, -0.08986084908246994, -0.0028049908578395844, -5.960446742392378e-06, -2.622600959512056e-06, 0.0, -2.3841855067985307e-07, -0.00024673278676345944, -0.6937556862831116, -0.0002233732520835474, -0.011470440775156021, -1.4305104514278355e-06, -0.024574652314186096, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0002649671514518559, -3.576278118089249e-07, -0.001859127776697278, -4.0411134250462055e-05, -5.0