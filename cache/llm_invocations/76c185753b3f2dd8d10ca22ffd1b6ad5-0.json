dout.write(f\"{n - getLostMaxFast(inputA2, inputB2)} {getWonMaxFast(inputA, inputB)}\\n\")\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nint getWonMaxFast(vector<int>& a, vector<int>& b) {\n    vector<int> wins(3, 0);\n    for (int i = 0; i < 3; i++) {\n        int j = (i + 1) % 3;\n        int match = min(a[i], b[j]);\n        wins[i] = match;\n        a[i] -= match;\n        b[j] -= match;\n    }\n    return wins[0] + wins[1] + wins[2];\n}\n\nint getLostMaxFast(vector<int> a, vector<int> b) {\n    vector<vector<int>> patterns = {{0, 2}, {1, 0}, {2, 1}, {0, 0}, {1, 1}, {2, 2}};\n    int max_loss = 0;\n    \n    sort(patterns.begin(), patterns.end());\n    \n    do {\n        vector<int> loss(3, 0);\n        vector<int> temp_a = a;\n        vector<int> temp_b = b;\n        \n        for (int k = 0; k < 6; k++) {\n            int src = patterns[k][0];\n            int dst = patterns[k][1];\n            int transfer = min(temp_a[src], temp_b[dst]);\n            temp_a[src] -= transfer;\n            temp_b[dst] -= transfer;\n            loss[src] += transfer;\n        }\n        \n        int total = loss[0] + loss[1] + loss[2];\n        if (total > max_loss) {\n            max_loss = total;\n        }\n    } while (next_permutation(patterns.begin(), patterns.end()));\n    \n    return max_loss;\n}\n\nint main() {\n    int n;\n    cin >> n;\n    \n    vector<int> inputA(3);\n    vector<int> inputB(3);\n    \n    for (int i = 0; i < 3; i++) {\n        cin >> inputA[i];\n    }\n    for (int i = 0; i < 3; i++) {\n        cin >> inputB[i];\n    }\n    \n    vector<int> inputA2 = inputA;\n    vector<int> inputB2 = inputB;\n    \n    cout << (n - getLostMaxFast(inputA2, inputB2)) << \" \" << getWonMaxFast(inputA, inputB) << endl;\n    \n    return 0;\n}\