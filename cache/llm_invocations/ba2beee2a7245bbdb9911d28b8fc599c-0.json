   sum %= mod;\n                }\n            }\n            res += sum * com;\n            res %= mod;\n            if (res == 0) res += mod;\n        }\n\n        out.println(res % mod);\n    }\n};\n\nclass PrintWriter {\npublic:\n    FILE* file;\n    bool isConsole;\n\n    PrintWriter(FILE* f) : file(f), isConsole(f == stdout) {}\n\n    void println(long long val) {\n        fprintf(file, \"%lld\\n\", val);\n        fflush(file);\n    }\n\n    void println(int val) {\n        fprintf(file, \"%d\\n\", val);\n        fflush(file);\n    }\n\n    void println(string val) {\n        fprintf(file, \"%s\\n\", val.c_str());\n        fflush(file);\n    }\n\n    void flush() {\n        fflush(file);\n    }\n};\n\nint main() {\n    FastScanner fs;\n    PrintWriter out(stdout);\n\n    int T = 1;\n    for (int t = 0; t < T; t++) {\n        Solution sol1(out, fs);\n        sol1.solution(T, t);\n    }\n    out.flush();\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00011169286881340668, -2.0265558760002023e-06, -1.168244216387393e-05, -0.011650617234408855, -1.1920922133867862e-06, -0.0022053224965929985, -5.590759246842936e-05, -0.00011228884250158444, -4.768370445162873e-07, -0.11248087882995605, -2.264974000354414e-06, -9.107174992095679e-05, -7.271740287251305e-06, -0.022968675941228867, -3.576272320060525e-06, -0.000977038755081594, -1.4305012882687151e-05, -0.5047181844711304, -1.4305104514278355e-06, -0.001111485529690981, -3.576278118089249e-07, -0.24932844936847687, -5.23315102327615e-05, -0.000710592488758266, -4.768370445162873e-07, -0.2703242599964142, -0.007606589701026678, -0.04300642013549805, -7.152555099310121e-07, -0.16585589945316315, -3.814689989667386e-06, -0.47408008575439453, -0.4287489652633667, -1.2159273865108844e-05, -0.017602063715457916, -0.4287048578262329, -0.38691434264183044, -1.4066597032069694e-05, -0.5997529029846191, -0.42870283126831055, -0.5231804847717285, -2.777537883957848e-05, -1.111