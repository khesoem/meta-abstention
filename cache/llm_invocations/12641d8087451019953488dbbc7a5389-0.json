   dq.appendleft(e.to)\n                            else:\n                                dq.append(e.to)\n                            inq[e.to] = True\n\n            if dist[t] == INF:\n                break\n\n            add = INF - flow\n            v = t\n            while v != s:\n                e = self.g[pv[v]][pe[v]]\n                add = min(add, e.cap - e.flow)\n                v = pv[v]\n\n            flow += add\n            v = t\n            while v != s:\n                e = self.g[pv[v]][pe[v]]\n                e.flow += add\n                self.g[v][e.rev].flow -= add\n                flow_cost += add * e.cost\n                v = pv[v]\n\n        return flow, flow_cost\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    N = n * T\n    mcf = MinCostMaxFlow(N + 2)\n\n    # waiting edges\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c)\n\n    # sink edges\n    for i in range(T):\n        mcf.add_edge(i, N + 1, INF, 0)\n\n    # source to initial positions\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcf.add_edge(N, x * T, 1, 0)\n\n    # movement edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for j in range(T - 1):\n            cur = 1\n            for _ in range(k):\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c)\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c)\n                cur += 2\n\n    flow, cost = mcf.get_flow(N, N + 1)\n    # assert flow == k\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.6491513785440475e-06, 0.0, 0.0, -0.00014029949670657516, -0.10310947895050049, -4.887569048150908e-06, -8.702239938429557e-06, -7.533743