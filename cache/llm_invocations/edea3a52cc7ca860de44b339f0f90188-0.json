.println(calcMin(r1, s1, p1, r2, s2, p2) + \" \" + calcMax(r1, s1, p1, r2, s2, p2));\n    }\n    \n    static int calcMax(int r1, int s1, int p1, int r2, int s2, int p2) {\n        return Math.min(r1, s2) + Math.min(s1, p2) + Math.min(p1, r2);\n    }\n    \n    static int compare(int x, int y) {\n        if (x == y) return 0;\n        else if ((x == 1 && y == 2) || (x == 2 && y == 3) || (x == 3 && y == 1)) return 1;\n        return -1;\n    }\n    \n    static int play(List<int[]> arr1, List<int[]> arr2) {\n        int score = 0;\n        int[] c1 = new int[2];\n        int[] c2 = new int[2];\n        boolean c1Valid = false;\n        boolean c2Valid = false;\n        \n        while (!arr1.isEmpty() || !arr2.isEmpty()) {\n            try {\n                if (!c1Valid && !arr1.isEmpty()) {\n                    int[] last = arr1.remove(arr1.size() - 1);\n                    c1[0] = last[0];\n                    c1[1] = last[1];\n                    c1Valid = true;\n                }\n                if (!c2Valid && !arr2.isEmpty()) {\n                    int[] last = arr2.remove(arr2.size() - 1);\n                    c2[0] = last[0];\n                    c2[1] = last[1];\n                    c2Valid = true;\n                }\n            } catch (Exception e) {\n                break;\n            }\n            \n            if (c1Valid && c2Valid) {\n                int cmp = compare(c1[1], c2[1]);\n                score += Math.max(0, Math.min(c1[0], c2[0]) * cmp);\n                \n                if (c1[0] < c2[0]) {\n                    c2[0] -= c1[0];\n                    c1Valid = false;\n                } else if (c1[0] > c2[0]) {\n                    c1[0] -= c2[0];\n                    c2Valid = false;\n                } else {\n                    c1Valid = false;\n                    c2Valid = false;\n                }\n            }\n            \n            if (!c1Valid && arr1.isEmpty()) {\n                c1Valid = false;\n            }\n            if (!c2Valid && arr2.isEmpty()) {\n                c2Valid = false;\n            }\n        }\n        return score;\n    }\n    \n    static int calcMin(int r1, int s1, int p1, int r2, int s2, int p2) {\n        List<int[]> arr1Base = new ArrayList<>();\n        arr1Base.add(new int[]{r1, 1});\n        arr1Base.add(new int[]{s1, 2});\n        arr1Base.add(new int[]{p1, 3});\n        \n        List<int[]> arr2Base = new ArrayList<>();\n        arr2Base.add(new int[]{r2, 1});\n        arr2Base.add(new int[]{s2, 2});\n        arr2Base.add(new int[]{p2, 3});\n        \n        List<List<int[]>> perms1 = permute(arr1Base);\n        List<List<int[]>> perms2 = permute(arr2Base);\n        \n        int minVal = Integer.MAX_VALUE;\n        for (List<int[]> p1 : perms1) {\n            for (List<int[]> p2 : perms2) {\n                List<int[]> a1 = new ArrayList<>();\n                for (int[] x : p1) {\n                    a1.add(new int[]{x[0], x[1]});\n                }\n                List<int[]> a2 = new ArrayList<>();\n                for (int[] x : p2) {\n                    a2.add(new int[]{x[0], x[1]});\n                }\n                minVal = Math.min(minVal, play(a1, a2));\n            }\n        }\n        return minVal;\n    }\n    \n    static List<List<int[]>> permute(List<int[]> arr) {\n        List<List<int[]>> result = new ArrayList<>();\n        permuteHelper(arr, 0, result);\n        return result;\n    }\n    \n    static void permuteHelper(List<int[]> arr, int start, List<List<int[]>> result) {\n        if (start == arr.size()) {\n            result.add(new ArrayList<>(arr));\n            return;\n        }\n        for (int i = start; i < arr.size(); i++) {\n            Collections.swap(arr, i, start);\n            permuteHelper(arr, start + 1, result);\n            Collections.swap(arr, start, i);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012730741582345217, -2.50339189733495e-06,