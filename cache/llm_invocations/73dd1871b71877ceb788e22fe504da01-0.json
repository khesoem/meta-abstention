ge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val[j]);\n            }\n    }\n    cout << g.dinic(s, t) << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport collections\nsys.setrecursionlimit(1 << 20)\n\nINF = 10**18\n\nclass MinCostMaxFlow:\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n\n    def add_edge(self, u, v, cap, cost):\n        # forward edge\n        self.adj[u].append([v, cap, cost, len(self.adj[v])])\n        # backward edge\n        self.adj[v].append([u, 0, -cost, len(self.adj[u]) - 1])\n\n    def spfa(self, s, t):\n        dist = [INF] * self.n\n        inq = [False] * self.n\n        q = collections.deque([s])\n        dist[s] = 0\n        inq[s] = True\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for edge in self.adj[u]:\n                v, cap, cost, _ = edge\n                if cap > 0 and dist[v] > dist[u] + cost:\n                    dist[v] = dist[u] + cost\n                    if not inq[v]:\n                        inq[v] = True\n                        q.append(v)\n        return dist[t] != INF, dist\n\n    def dfs(self, u, t, flow, dist, ptr):\n        if u == t:\n            return flow\n        for i in range(ptr[u], len(self.adj[u])):\n            edge = self.adj[u][i]\n            v, cap, cost, rev = edge\n            if cap > 0 and dist[v] == dist[u] + cost:\n                pushed = self.dfs(v, t, min(flow, cap), dist, ptr)\n                if pushed:\n                    # update forward edge\n                    edge[1] -= pushed\n                    # update backward edge\n                    self.adj[v][rev][1] += pushed\n                    self.total_cost += pushed * cost\n                    return pushed\n            ptr[u] += 1\n        return 0\n\n    def dinic(self, s, t):\n        self.total_cost = 0\n        while True:\n            ok, dist = self.spfa(s, t)\n            if not ok:\n                break\n            ptr = [0] * self.n\n            while True:\n                pushed = self.dfs(s, t, INF, dist, ptr)\n                if not pushed:\n                    break\n        return self.total_cost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    kk = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    a = [0] * (kk + 1)\n    for i in range(1, kk + 1):\n        a[i] = int(next(it))\n    \n    # total nodes: 0 is source, n*100+1 is sink\n    T = n * 100 + 1\n    g = MinCostMaxFlow(T + 1)   # nodes 0..T inclusive\n    s = 0\n    t = T\n\n    # precompute val[j]\n    val = [0] * (kk + 1)\n    for j in range(1, kk + 1):\n        val[j] = c + d * (j * j - (j - 1) * (j - 1))\n\n    # connect building 1 time nodes to sink\n    for i in range(1, 101):\n        g.add_edge(i, t, INF, 0)\n\n    # source to starting buildings\n    for i in range(1, kk + 1):\n        start_node = (a[i] - 1) * 100 + 1\n        g.add_edge(s, start_node, 1, 0)\n\n    # internal time edges for buildings 2..n\n    for i in range(2, n + 1):\n        for j in range(1, 100):\n            u = (i - 1) * 100 + j\n            v = (i - 1) * 100 + j + 1\n            g.add_edge(u, v, INF, c)\n\n    # edges between buildings (given roads)\n    for _ in range(m):\n        t1 = int(next(it))\n        t2 = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, kk + 1):\n                u = (t1 - 1) * 100 + i\n                v = (t2 - 1) * 100 + i + 1\n                g.add_edge(u, v, 1, val[j])\n                u = (t2 - 1) * 100 + i\n                v = (t1 - 1) * 100 + i + 1\n                g.add_edge(u, v, 1, val[j])\n\n    result = g.dinic(s, t)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002540027489885688, -5.960462772236497e-07, 0.0, -0.0007351318490691483, -0.0009703694959171116, -3.576278118089249e-07, -0.0007907600956968963, -0.7765414714813232, -0.03399265930056572, -0.4741339683532715, -0.25237417221069336, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -3.4570634852570947e-06, -0.9582666754722595, -0.1629435420036316, -2.3841855067985307e-07, -2.2398858070373535, -0.023329418152570724, -0.9774909615516663, -8.034383063204587e-05, -1.823885577323381e-05, -0.0003359945258125663, -0.3868712782859802, -0.006792550440877676, -0.0029233836103230715, -1.597391747054644e-05, -0.0009146321099251509, 0.0, -2.3841855067985307e-07, 0.0, -5.125986263010418e-06, -2.0265558760002023e-06, -6.913899414939806e-05, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -0.3868773281574249, -0.00018714107864070684, 0.0, -2.3841855067985307e-07, -0.029750648885965347, -2.3841855067985307e-07, 0.0, -1.3470558769768104e-05, 0.0, -7.497983460780233e-05, -1.3148332834243774, -0.00012861855793744326, 0.0, -2.932505594799295e-05, -3.576278118089249e-07, 0.0, -4.768370445162873e-07, 0.0, -3.576278118089249e-07, -0.10308916121721268, -1.1920928244535389e-07, -1.7881377516459906e-06, -5.125986263010418e-06, -5.960446742392378e-06, 0.0, 0.0, -0.038313817232847214, -1.0371154530730564e-05, 0.0, -1.1920928244535389e-07, -0.0001255195093108341, -4.768370445162873e-07, -5.960446742392378e-06, -8.702239938429557e-06, -9.536738616588991e-07, -0.1860884577035904, -0.004578227177262306, -0.018426548689603806, -0.16181054711341858, 0.0, -0.0001928620331455022, -4.768370445162873e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -9.298280929215252e-06, -1.1920928244535389e-07, 0.0, -2.50339189733495e-06, 0.0, -7.510157047363464e-06, -5.960462772236497e-07, -4.8397800128441304e-05, 0.0, -1.1920928244535389e-07, 0.0, -4.8875