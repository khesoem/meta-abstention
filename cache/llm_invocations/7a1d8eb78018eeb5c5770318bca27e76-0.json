tatic int[] f = new int[N];\n    static int[] g = new int[N];\n    static int[][][] dp = new int[N][N][2];\n    static int[][][] dp2 = new int[N][N][2];\n\n    static int add(int x, int y) {\n        x += y;\n        if (x >= md) x -= md;\n        return x;\n    }\n\n    static int sub(int x, int y) {\n        x -= y;\n        if (x < 0) x += md;\n        return x;\n    }\n\n    static int mul(int x, int y) {\n        return (int)((long)x * y % md);\n    }\n\n    static int fpow(int x, int y) {\n        int ans = 1;\n        while (y > 0) {\n            if ((y & 1) == 1) ans = mul(ans, x);\n            y >>= 1;\n            x = mul(x, x);\n        }\n        return ans;\n    }\n\n    static int C(int n, int m) {\n        if (m < 0 || m > n) return 0;\n        return mul(fac[n], mul(inv[m], inv[n - m]));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        md = Integer.parseInt(st.nextToken());\n\n        fac[0] = 1;\n        for (int i = 1; i <= n; ++i) fac[i] = mul(fac[i - 1], i);\n        inv[n] = fpow(fac[n], md - 2);\n        for (int i = n; i >= 1; --i) inv[i - 1] = mul(inv[i], i);\n\n        f[0] = 0;\n        g[0] = 1;\n\n        // compute g first\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j <= i; ++j) {\n                int now = mul(C(i - 1, j - 1), i + 1);\n                g[i] = add(g[i], mul(mul(g[j - 1], g[i - j]), now));\n            }\n        }\n\n        // compute f\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j <= i; ++j) {\n                int now = mul(C(i - 1, j - 1), i + 1);\n                f[i] = add(f[i], mul(mul(f[j - 1], g[i - j]), now));\n                f[i] = add(f[i], mul(mul(g[j - 1], f[i - j]), now));\n                int extra = (j - 1) * j / 2 + (i - j) * (i - j + 1) / 2;\n                f[i] = add(f[i], mul(mul(C(i - 1, j - 1), mul(g[j - 1], g[i - j])), extra));\n            }\n        }\n\n        // initialize dp and dp2\n        for (int i = 0; i <= n; ++i) {\n            for (int j = 0; j <= n; ++j) {\n                dp[i][j][0] = dp[i][j][1] = 0;\n                dp2[i][j][0] = dp2[i][j][1] = 0;\n            }\n        }\n        dp[0][0][1] = 0;\n        dp2[0][0][1] = 1;\n\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 0; j <= i; ++j) {\n                dp[i][j][1] = add(dp[i - 1][j][0], dp[i - 1][j][1]);\n                dp2[i][j][1] = add(dp2[i - 1][j][0], dp2[i - 1][j][1]);\n                for (int k = 1; k <= j; ++k) {\n                    dp[i][j][0] = add(dp[i][j][0], mul(C(j, k), mul(dp2[i - k][j - k][1], f[k])));\n                    dp[i][j][0] = add(dp[i][j][0], mul(C(j, k), mul(dp[i - k][j - k][1], g[k])));\n                    dp2[i][j][0] = add(dp2[i][j][0], mul(C(j, k), mul(dp2[i - k][j - k][1], g[k])));\n                }\n            }\n        }\n\n        int result = add(dp[n][m][0], dp[n][m][1]);\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.6927575416048057e-05, 0.0, -1.1920928244535389e-07, -0.00021217002358753234, -0.00012814177898690104, -1.1920928244535389e-07, -0.0031777145341038704, -0.12700869143009186, -1.1920928244535389e-07, 0.0, -6.198863957251888e-06, -0.005302057601511478, -1.2397689715726301e-05, 0.0, -0.003513474715873599, -0.004092770162969828, -0.00010108436981681734, -0.023403367027640343, -0.5864984393119812, -9.536738616588991e-07, -0.00010299152199877426, -4.291525328881107e-06, -1.1920928244535389e-07, -1.6689286894688848e-06, -0.00026901919045485556, -1.6689160474925302e-05, -1.6689286894688848e-06, -9.095255518332124e-05, -0.0004686211177613586, -0.0004318020073696971, -1.311301275563892e-06, -1.0251946150674485e-05, -0.00