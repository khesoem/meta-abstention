{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cmath>\n#include <climits>\nusing namespace std;\n\nusing lli = long long;\n\nint MOD;\n\nint mod_exp(int b, int e) {\n    lli res = 1, base = b;\n    while (e) {\n        if (e & 1) res = (res * base) % MOD;\n        base = (base * base) % MOD;\n        e >>= 1;\n    }\n    return res;\n}\n\nint n, k;\nvector<vector<int>> dp_table;\nvector<int> factorial, inv_factorial, modular_inverse;\n\nint compute(int used, int mask) {\n    if (dp_table[used][mask] != -1) return dp_table[used][mask];\n    \n    if (mask == 0) {\n        int result = factorial[n];\n        for (int i = 1; i <= used; ++i) {\n            result = (1LL * result * (k - i + 1)) % MOD;\n        }\n        return dp_table[used][mask] = result;\n    }\n    \n    if (used > k) return 0;\n    \n    int lsb = mask & -mask;\n    int upper_mask = mask - lsb;\n    int result = 0;\n    \n    for (int sub = upper_mask; ; sub = (sub - 1) & upper_mask) {\n        int complement = mask - sub;\n        result = (result + 1LL * inv_factorial[complement] * compute(used + 1, sub)) % MOD;\n        if (sub == 0) break;\n    }\n    \n    return dp_table[used][mask] = result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> MOD;\n    \n    if (n & 1) {\n        cout << mod_exp(k, n) << '\\n';\n        return 0;\n    }\n    \n    factorial.resize(n + 1);\n    inv_factorial.resize(n + 1);\n    modular_inverse.resize(n + 1);\n    \n    factorial[0] = inv_factorial[0] = factorial[1] = inv_factorial[1] = modular_inverse[1] = 1;\n    \n    for (int i = 2; i <= n; ++i) {\n        factorial[i] = 1LL * factorial[i-1] * i % MOD;\n        modular_inverse[i] = 1LL * (MOD - MOD / i) * modular_inverse[MOD % i] % MOD;\n        inv_factorial[i] = 1LL * inv_factorial[i-1] * modular_inverse[i] % MOD;\n    }\n    \n    dp_table.assign(19, vector<int>(n + 1, -1));\n    int total_ways = mod_exp(k, n);\n    int bad_ways = compute(0, n);\n    int answer = (total_ways - bad_ways + MOD) % MOD;\n    cout << answer << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_exp(b, e, MOD):\n    res = 1\n    base = b\n    while e:\n        if e & 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        e >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k = int(data[1])\n    MOD = int(data[2])\n    \n    if n & 1:\n        print(mod_exp(k, n, MOD))\n        return\n    \n    factorial = [0] * (n + 1)\n    inv_factorial = [0] * (n + 1)\n    modular_inverse = [0] * (n + 1)\n    \n    factorial[0] = inv_factorial[0] = factorial[1] = inv_factorial[1] = modular_inverse[1] = 1\n    \n    for i in range(2, n + 1):\n        factorial[i] = factorial[i-1] * i % MOD\n        modular_inverse[i] = (MOD - MOD // i) * modular_inverse[MOD % i] % MOD\n        inv_factorial[i] = inv_factorial[i-1] * modular_inverse[i] % MOD\n    \n    # dp_table: dimensions [used][mask], used up to k (max 18), mask up to n\n    dp_table = [[-1] * (n + 1) for _ in range(19)]\n    \n    def compute(used, mask):\n        if dp_table[used][mask] != -1:\n            return dp_table[used][mask]\n        \n        if mask == 0:\n            result = factorial[n]\n            for i in range(1, used + 1):\n                result = result * (k - i + 1) % MOD\n            dp_table[used][mask] = result\n            return result\n        \n        if used > k:\n            dp_table[used][mask] = 0\n            return 0\n        \n        lsb = mask & -mask\n        upper_mask = mask - lsb\n        result = 0\n        \n        sub = upper_mask\n        while True:\n            complement = mask - sub\n            result = (result + inv_factorial[complement] * compute(used + 1, sub)) % MOD\n            if sub == 0:\n                break\n            sub = (sub - 1) & upper_mask\n        \n        dp_table[used][mask] = result\n        return result\n    \n    total_ways = mod_exp(k, n, MOD)\n    bad_ways = compute(0, n)\n    answer = (total_ways - bad_ways + MOD) % MOD\n    print(answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012432756193447858, -9.536738616588991e-07, -1.1920928244535389e-07, -0.02992362715303898, -8.904537389753386e-05, -0.34846895933151245, -0.06233001872897148, -0.6500214338302612, -2.074220174108632e-05, -0.00023147765023168176, -1.6927575416048057e-05, -2.3841855067985307e-07, -0.03364715352654457, -0.007763333152979612, -9.894321920000948e-06, -1.6689286894688848e-06, -9.536697689327411e-06, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -7.152555099310121e-07, 0.0, 0.0, -0.42870524525642395, -2.3841855067985307e-07, -2.5629668016335927e-05, -2.3841855067985307e-07, -0.0008074360666796565, -1.1920928244535389e-07, -1.1920928244535389e-07,