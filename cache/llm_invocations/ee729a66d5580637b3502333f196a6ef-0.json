{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n<your_rewritten_code_2>\n#include <iostream>\n#include <cstring>\n#include <vector>\nusing namespace std;\n\nconst int MAX_N = 250005;\nint n, k, mod;\nusing ll = long long;\n\nll modPow(ll base, ll exp) {\n    ll res = 1;\n    base %= mod;\n    while (exp) {\n        if (exp & 1) res = (res * base) % mod;\n        base = (base * base) % mod;\n        exp >>= 1;\n    }\n    return res;\n}\n\ninline int lowbit(int x) { return x & -x; }\n\nll fact[MAX_N], invFact[MAX_N];\nll memo[26][MAX_N];\n\nll solve(int pos, int mask) {\n    if (memo[pos][mask] != -1) return memo[pos][mask];\n    \n    if (mask == 0) {\n        memo[pos][mask] = fact[n];\n        for (int i = 0; i < pos; ++i) {\n            memo[pos][mask] = (memo[pos][mask] * (k - i)) % mod;\n        }\n        return memo[pos][mask];\n    }\n    \n    memo[pos][mask] = 0;\n    int rest = mask ^ lowbit(mask);\n    \n    for (int sub = rest; sub; sub = (sub - 1) & rest) {\n        memo[pos][mask] = (memo[pos][mask] + invFact[mask ^ sub] * solve(pos + 1, sub)) % mod;\n    }\n    \n    memo[pos][mask] = (memo[pos][mask] + invFact[mask] * solve(pos + 1, 0)) % mod;\n    return memo[pos][mask];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> n >> k >> mod;\n    ll total = modPow(k, n);\n    \n    if (n & 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = fact[i-1] * i % mod;\n    \n    invFact[n] = modPow(fact[n], mod - 2);\n    for (int i = n; i > 0; --i) invFact[i-1] = invFact[i] * i % mod;\n    \n    memset(memo, -1, sizeof(memo));\n    ll bad = solve(0, n);\n    ll ans = (total - bad + mod) % mod;\n    cout << ans << '\\n';\n    \n    return 0;\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(10000)\n\ndef modPow(base, exp, mod):\n    res = 1\n    base %= mod\n    while exp:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef lowbit(x):\n    return x & -x\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n    \n    total = modPow(k, n, mod)\n    \n    if n & 1:\n        print(total)\n        return\n    \n    MAX_N = n + 5\n    fact = [1] * MAX_N\n    invFact = [1] * MAX_N\n    \n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % mod\n    \n    invFact[n] = modPow(fact[n], mod - 2, mod)\n    for i in range(n, 0, -1):\n        invFact[i-1] = invFact[i] * i % mod\n    \n    # Initialize memoization table\n    memo = [[-1] * (n + 1) for _ in range(26)]\n    \n    def solve(pos, mask):\n        if memo[pos][mask] != -1:\n            return memo[pos][mask]\n        \n        if mask == 0:\n            res = fact[n]\n            for i in range(pos):\n                res = res * (k - i) % mod\n            memo[pos][mask] = res\n            return res\n        \n        memo[pos][mask] = 0\n        rest = mask ^ lowbit(mask)\n        \n        sub = rest\n        while sub:\n            memo[pos][mask] = (memo[pos][mask] + invFact[mask ^ sub] * solve(pos + 1, sub)) % mod\n            sub = (sub - 1) & rest\n        \n        memo[pos][mask] = (memo[pos][mask] + invFact[mask] * solve(pos + 1, 0)) % mod\n        return memo[pos][mask]\n    \n    bad = solve(0, n)\n    ans = (total - bad + mod) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014780859055463225, -1.0728830375228426e-06, -1.4305104514278355e-06, -0.074685238301754, -0.00010632903286023065, -0.4287192225456238, -0.5058284401893616, -1.1920928244535389e-07, -5.07818695041351e-05, -2.4437606043647975e-05, -1.7881233361549675e-05, -1.1920928244535389e-07, -0.14580680429935455, -5.578839045483619e-05, -4.184158387943171e-05, -7.152555099310121e-07, -6.318072337307967e-06, -0.4741232991218567, -0.05461844429373741, -0.2140561193227768, -0.06555695831775665, -2.861018856492592e-06, -2.3841855067985307e-07, -4.339123915997334e-05, -0.00029797881143167615, -1.728519782773219e-05, -0.0002851079625543207, -3.576278118089249e-07, -1.0251946150674485e-05, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -0.00038795097498223186, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -2.7418097943154862e-06, -1.4662635294371285e-05, -0.0003389737685211003, 0.0, 0.0, -8.189342770492658e-05, -3.576278118089249e-07, 0.0, 0.0, -3.576278118089249e-07, -2.288792165927589e-05, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -2.5510462364763953e-05, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.0728830375228426e-06, -2.3841855067985307e-07, -3.4570634852570947e-06, 0.