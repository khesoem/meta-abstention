{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 0x3f3f3f3f;\n\nstruct Edge {\n    int to;\n    int rev;\n    int cap;\n    int w;\n};\n\nvector<Edge> g[10001];\nint vis[10001], cur[10001], n;\nint dis[10001], pot[10001];\n\nint addv(int c) {\n    while (c--) g[n++].clear();\n    return n - 1;\n}\n\nvoid adde(int u, int v, int c, int w) {\n    g[u].push_back({v, (int)g[v].size(), c, w});\n    g[v].push_back({u, (int)g[u].size() - 1, 0, -w});\n}\n\nbool dijkstra(int s, int t) {\n    fill(dis, dis + n, INF);\n    fill(vis, vis + n, 0);\n    using pii = pair<int, int>;\n    priority_queue<pii, vector<pii>, greater<pii>> q;\n    q.push({dis[s] = 0, s});\n    while (!q.empty()) {\n        int du, u;\n        tie(du, u) = q.top(); q.pop();\n        if (vis[u]) continue;\n        vis[u] = 1;\n        for (auto& e : g[u]) {\n            int v = e.to;\n            int dv = du + pot[u] + e.w - pot[v];\n            if (!e.cap || vis[v] || dis[v] <= dv) continue;\n            q.push({dis[v] = dv, v});\n        }\n    }\n    return vis[t];\n}\n\nbool dinic_bfs(int s, int t) {\n    fill(vis, vis + n, 0);\n    queue<int> q;\n    q.push(s);\n    vis[s] = 1;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (auto& e : g[u]) {\n            int v = e.to;\n            if (vis[v] || !e.cap) continue;\n            if (dis[v] != dis[u] + e.w - pot[v] + pot[u]) continue;\n            vis[v] = vis[u] + 1;\n            q.push(v);\n        }\n    }\n    return vis[t];\n}\n\nint dinic_dfs(int u, int t, int f) {\n    if (u == t) return f;\n    int sf = 0;\n    for (int& i = cur[u]; i < (int)g[u].size(); ++i) {\n        auto& e = g[u][i];\n        int v = e.to;\n        if (!e.cap || vis[v] != vis[u] + 1) continue;\n        if (dis[v] != dis[u] + e.w - pot[v] + pot[u]) continue;\n        int df = dinic_dfs(v, t, min(e.cap, f));\n        sf += df;\n        f -= df;\n        e.cap -= df;\n        g[v][e.rev].cap += df;\n        if (!f) break;\n    }\n    return sf;\n}\n\npair<int, int> mcmf(int s, int t, int mf) {\n    int sf = 0, sc = 0;\n    fill(pot, pot + n, 0);\n    while (dijkstra(s, t)) {\n        int f = 0;\n        while (dinic_bfs(s, t)) {\n            fill(cur, cur + n, 0);\n            int df = dinic_dfs(s, t, mf);\n            mf -= df;\n            f += df;\n            if (!mf) break;\n        }\n        sf += f;\n        sc += (dis[t] + pot[t]) * f;\n        for (int i = 0; i < n; ++i) pot[i] += dis[i];\n        if (!mf) break;\n    }\n    return {sf, sc};\n}\n\nint main() {\n    int n_in, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &n_in, &m, &k, &c, &d);\n    int layers = max(n_in, k) * 2;\n    mcmf::addv(layers * n_in);\n    int s = mcmf::addv(1);\n    int t = mcmf::addv(1);\n    for (int j = 0; j < k; ++j) {\n        int a;\n        scanf(\"%d\", &a);\n        --a;\n        mcmf::adde(s, a, 1, 0);\n    }\n    for (int z = 1; z <= m; ++z) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        --u; --v;\n        for (int i = 0; i + 1 < layers; ++i) {\n            int u1 = u + i * n_in, v1 = v + (i + 1) * n_in;\n            int u2 = u + (i + 1) * n_in, v2 = v + i * n_in;\n            for (int j = 0; j < k; ++j) {\n                mcmf::adde(u1, v1, 1, c + d * (2 * j + 1));\n                mcmf::adde(v2, u2, 1, c + d * (2 * j + 1));\n            }\n        }\n    }\n    for (int i = 0; i + 1 < layers; ++i) {\n        for (int j = 0; j < n_in; ++j) {\n            int u = j + i * n_in, v = j + (i + 1) * n_in;\n            mcmf::adde(u, v, INF, c);\n        }\n    }\n    for (int i = 0; i < layers; ++i)\n        mcmf::adde(i * n_in, t, INF, 0);\n    printf(\"%d\\n\", mcmf::mcmf(s, t, INF).second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\nfrom collections import deque\n\nINF = 0x3f3f3f3f\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'cap', 'w')\n    def __init__(self, to, rev, cap, w):\n        self.to = to\n        self.rev = rev\n        self.cap = cap\n        self.w = w\n\nclass MCMF:\n    def __init__(self):\n        self.g = [[] for _ in range(10001)]\n        self.n = 0\n    \n    def addv(self, c):\n        while c:\n            self.g[self.n].clear()\n            self.n += 1\n            c -= 1\n        return self.n - 1\n    \n    def adde(self, u, v, c, w):\n        self.g[u].append(Edge(v, len(self.g[v]), c, w))\n        self.g[v].append(Edge(u, len(self.g[u]) - 1, 0, -w))\n    \n    def dijkstra(self, s, t, dis, vis, pot):\n        for i in range(self.n):\n            dis[i] = INF\n            vis[i] = 0\n        dis[s] = 0\n        q = [(0, s)]\n        while q:\n            du, u = heapq.heappop(q)\n            if vis[u]:\n                continue\n            vis[u] = 1\n            for e in self.g[u]:\n                v = e.to\n                dv = du + pot[u] + e.w - pot[v]\n                if not e.cap or vis[v] or dis[v] <= dv:\n                    continue\n                dis[v] = dv\n                heapq.heappush(q, (dv, v))\n        return vis[t]\n    \n    def dinic_bfs(self, s, t, dis, vis, pot):\n        for i in range(self.n):\n            vis[i] = 0\n        q = deque()\n        q.append(s)\n        vis[s] = 1\n        while q:\n            u = q.popleft()\n            for e in self.g[u]:\n                v = e.to\n                if vis[v] or not e.cap:\n                    continue\n                if dis[v] != dis[u] + e.w - pot[v] + pot[u]:\n                    continue\n                vis[v] = vis[u] + 1\n                q.append(v)\n        return vis[t]\n    \n    def dinic_dfs(self, u, t, f, dis, vis, pot, cur):\n        if u == t:\n            return f\n        sf = 0\n        while cur[u] < len(self.g[u]):\n            e = self.g[u][cur[u]]\n            v = e.to\n            if not e.cap or vis[v] != vis[u] + 1:\n                cur[u] += 1\n                continue\n            if dis[v] != dis[u] + e.w - pot[v] + pot[u]:\n                cur[u] += 1\n                continue\n            df = self.dinic_dfs(v, t, min(e.cap, f), dis, vis, pot, cur)\n            if df > 0:\n                sf += df\n                f -= df\n                e.cap -= df\n                self.g[v][e.rev].cap += df\n                if f == 0:\n                    break\n            else:\n                cur[u] += 1\n        return sf\n    \n    def mcmf(self, s, t, mf):\n        sf = 0\n        sc = 0\n        pot = [0] * self.n\n        dis = [INF] * self.n\n        vis = [0] * self.n\n        cur = [0] * self.n\n        \n        while self.dijkstra(s, t, dis, vis, pot):\n            f = 0\n            while self.dinic_bfs(s, t, dis, vis, pot):\n                for i in range(self.n):\n                    cur[i] = 0\n                df = self.dinic_dfs(s, t, mf, dis, vis, pot, cur)\n                mf -= df\n                f += df\n                if not mf:\n                    break\n            sf += f\n            sc += (dis[t] + pot[t]) * f\n            for i in range(self.n):\n                pot[i] += dis[i]\n            if not mf:\n                break\n        return (sf, sc)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n_in = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    layers = max(n_in, k) * 2\n    mcmf_instance = MCMF()\n    mcmf_instance.addv(layers * n_in)\n    s = mcmf_instance.addv(1)\n    t = mcmf_instance.addv(1)\n    \n    for _ in range(k):\n        a = int(next(it)) - 1\n        mcmf_instance.adde(s, a, 1, 0)\n    \n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for i in range(layers - 1):\n            u1 = u + i * n_in\n            v1 = v + (i + 1) * n_in\n            u2 = u + (i + 1) * n_in\n            v2 = v + i * n_in\n            for j in range(k):\n                mcmf_instance.adde(u1, v1, 1, c + d * (2 * j + 1))\n                mcmf_instance.adde(v2, u2, 1, c + d * (2 * j + 1))\n    \n    for i in range(layers - 1):\n        for j in range(n_in):\n            u = j + i * n_in\n            v = j + (i + 1) * n_in\n            mcmf_instance.adde(u, v, INF, c)\n    \n    for i in range(layers):\n        mcmf_instance.adde(i * n_in, t, INF, 0)\n    \n    result = mcmf_instance.mcmf(s, t, INF)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022349244682118297, -1.1920922133867862e-06, -4.768370445162873e-07, -0.0002967870968859643, -0.10048391669988632, -9.536738616588991e-07, -0.038047611713409424, -0.005269803572446108, -0.20143282413482666, -0.0003430254873819649, -0.0001746263587847352, -1.0728830375228426e-06, -0.0059351869858801365, -0.000296310376143083, -0.020453255623579025, -3.576278118089249e-07, -0.0011813811725005507, -5.483612312673358e-06, -1.7881377516459906e-06, 0.0, -2.777537883957848e-05, 