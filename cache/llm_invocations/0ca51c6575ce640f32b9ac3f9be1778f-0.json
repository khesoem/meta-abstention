tring(lastEnd);\n        for (String part : tail.split(\"_\", -1)) {\n            if (part.length() > maxLen) maxLen = part.length();\n        }\n        \n        System.out.println(maxLen + \" \" + count);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n#include <sstream>\n#include <algorithm>\n\nint main() {\n    std::string line;\n    std::getline(std::cin, line); // Skip first line\n    std::getline(std::cin, line);\n    \n    int maxLen = 0;\n    int count = 0;\n    int lastEnd = 0;\n    \n    while (true) {\n        size_t open = line.find('(', lastEnd);\n        if (open == std::string::npos || open >= line.rfind(')')) break;\n        \n        size_t close = line.find(')', open);\n        if (close == std::string::npos) break;\n        \n        std::string before = line.substr(lastEnd, open - lastEnd);\n        std::istringstream iss_before(before);\n        std::string part;\n        while (std::getline(iss_before, part, '_')) {\n            if (static_cast<int>(part.length()) > maxLen) {\n                maxLen = part.length();\n            }\n        }\n        \n        std::string inside = line.substr(open + 1, close - open - 1);\n        std::istringstream iss_inside(inside);\n        while (std::getline(iss_inside, part, '_')) {\n            if (!part.empty()) count++;\n        }\n        \n        lastEnd = close + 1;\n    }\n    \n    std::string tail = line.substr(lastEnd);\n    std::istringstream iss_tail(tail);\n    while (std::getline(iss_tail, part, '_')) {\n        if (static_cast<int>(part.length()) > maxLen) {\n            maxLen = part.length();\n        }\n    }\n    \n    std::cout << maxLen << \" \" << count << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013600854435935616, -1.0728830