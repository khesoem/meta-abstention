{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nmt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());\n\nconst int MAXN = 12;\nconst int INF = 1000000009;\nconst int dx[4] = {0, 1, 0, -1};\nconst int dy[4] = {1, 0, -1, 0};\n\nint N, T;\nchar gridA[MAXN][MAXN], gridB[MAXN][MAXN];\nint dist[MAXN][MAXN];\nbool visited[MAXN][MAXN];\n\nstruct Point {\n    int x, y;\n    Point() {}\n    Point(int x, int y) : x(x), y(y) {}\n};\n\nvoid bfs(int sx, int sy) {\n    for (int i = 0; i < N; ++i)\n        fill(dist[i], dist[i] + N, INF);\n    fill(&visited[0][0], &visited[N][0], false);\n    queue<Point> q;\n    visited[sx][sy] = true;\n    dist[sx][sy] = 0;\n    q.push(Point(sx, sy));\n    while (!q.empty()) {\n        Point cur = q.front(); q.pop();\n        for (int i = 0; i < 4; ++i) {\n            int nx = cur.x + dx[i], ny = cur.y + dy[i];\n            if (nx >= 0 && nx < N && ny >= 0 && ny < N && !visited[nx][ny] && isdigit(gridA[nx][ny])) {\n                visited[nx][ny] = true;\n                dist[nx][ny] = dist[cur.x][cur.y] + 1;\n                q.push(Point(nx, ny));\n            }\n        }\n    }\n}\n\nbool dp[72][12][12][12][12];\nbool reachable[12][12][12][12];\n\nint capacity[290][290];\nint parent[290];\nbool vis[290];\n\nbool bfsFlow() {\n    fill(vis, vis + 290, false);\n    fill(parent, parent + 290, 0);\n    queue<int> q;\n    vis[0] = true;\n    q.push(0);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        if (u == 2 * N * N + 1) return true;\n        for (int v = 0; v <= 2 * N * N + 1; ++v) {\n            if (capacity[u][v] && !vis[v]) {\n                vis[v] = true;\n                parent[v] = u;\n                q.push(v);\n            }\n        }\n    }\n    return false;\n}\n\nvoid solve() {\n    cin >> N >> T;\n    for (int i = 0; i < N; ++i) cin >> gridA[i];\n    for (int i = 0; i < N; ++i) cin >> gridB[i];\n    int sx, sy;\n    cin >> sx >> sy;\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (gridA[i][j] == 'Z') {\n                sx = i; sy = j;\n            }\n        }\n    }\n    bfs(sx, sy);\n    memset(dp, 0, sizeof(dp));\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (isdigit(gridA[i][j])) {\n                dp[0][i][j][i][j] = true;\n            }\n        }\n    }\n    for (int t = 0; t < T; ++t) {\n        for (int px = 0; px < N; ++px) {\n            for (int py = 0; py < N; ++py) {\n                for (int x = 0; x < N; ++x) {\n                    for (int y = 0; y < N; ++y) {\n                        if (!dp[t][px][py][x][y]) continue;\n                        if (dist[x][y] <= t) continue;\n                        for (int d = 0; d < 4; ++d) {\n                            int nx = x + dx[d], ny = y + dy[d];\n                            if (nx >= 0 && nx < N && ny >= 0 && ny < N && isdigit(gridA[nx][ny]) && dist[nx][ny] >= t + 1) {\n                                dp[t + 1][px][py][nx][ny] = true;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    memset(reachable, 0, sizeof(reachable));\n    for (int t = 0; t <= T; ++t) {\n        for (int px = 0; px < N; ++px) {\n            for (int py = 0; py < N; ++py) {\n                for (int x = 0; x < N; ++x) {\n                    for (int y = 0; y < N; ++y) {\n                        if (dp[t][px][py][x][y]) {\n                            reachable[px][py][x][y] = true;\n                        }\n                    }\n                }\n            }\n        }\n    }\n    memset(capacity, 0, sizeof(capacity));\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (isdigit(gridA[i][j])) {\n                capacity[0][i * N + j + 1] = gridA[i][j] - '0';\n            }\n        }\n    }\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (isdigit(gridB[i][j])) {\n                capacity[N * N + i * N + j + 1][2 * N * N + 1] = gridB[i][j] - '0';\n            }\n        }\n    }\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (!isdigit(gridA[i][j])) continue;\n            for (int k = 0; k < N; ++k) {\n                for (int l = 0; l < N; ++l) {\n                    if (!isdigit(gridA[k][l])) continue;\n                    if (!reachable[i][j][k][l]) continue;\n                    capacity[i * N + j + 1][N * N + k * N + l + 1] = INF;\n                }\n            }\n        }\n    }\n    while (bfsFlow()) {\n        int flow = INF;\n        for (int u = 2 * N * N + 1; u; u = parent[u]) {\n            flow = min(flow, capacity[parent[u]][u]);\n        }\n        for (int u = 2 * N * N + 1; u; u = parent[u]) {\n            capacity[parent[u]][u] -= flow;\n            capacity[u][parent[u]] += flow;\n        }\n    }\n    int result = 0;\n    for (int i = 0; i <= 2 * N * N + 1; ++i) {\n        result += capacity[i][0];\n    }\n    cout << result << '\\n';\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    if not data:\n        return\n    \n    N, T = map(int, data[0].split())\n    gridA = []\n    gridB = []\n    \n    idx = 1\n    for i in range(N):\n        gridA.append(data[idx])\n        idx += 1\n    \n    for i in range(N):\n        gridB.append(data[idx])\n        idx += 1\n    \n    sx, sy = map(int, data[idx].split())\n    idx += 1\n    \n    # Find 'Z' position\n    for i in range(N):\n        for j in range(N):\n            if gridA[i][j] == 'Z':\n                sx, sy = i, j\n    \n    # Directions: right, down, left, up\n    dx = [0, 1, 0, -1]\n    dy = [1, 0, -1, 0]\n    \n    INF = 1000000009\n    dist = [[INF] * N for _ in range(N)]\n    visited = [[False] * N for _ in range(N)]\n    \n    # BFS\n    q = deque()\n    visited[sx][sy] = True\n    dist[sx][sy] = 0\n    q.append((sx, sy))\n    \n    while q:\n        x, y = q.popleft()\n        for i in range(4):\n            nx, ny = x + dx[i], y + dy[i]\n            if 0 <= nx < N and 0 <= ny < N and not visited[nx][ny] and gridA[nx][ny].isdigit():\n                visited[nx][ny] = True\n                dist[nx][ny] = dist[x][y] + 1\n                q.append((nx, ny))\n    \n    # dp[t][px][py][x][y]\n    dp = [[[[[False] * N for _ in range(N)] for _ in range(N)] for _ in range(N)] for _ in range(T + 1)]\n    \n    for i in range(N):\n        for j in range(N):\n            if gridA[i][j].isdigit():\n                dp[0][i][j][i][j] = True\n    \n    for t in range(T):\n        for px in range(N):\n            for py in range(N):\n                for x in range(N):\n                    for y in range(N):\n                        if not dp[t][px][py][x][y]:\n                            continue\n                        if dist[x][y] <= t:\n                            continue\n                        for d in range(4):\n                            nx, ny = x + dx[d], y + dy[d]\n                            if 0 <= nx < N and 0 <= ny < N and gridA[nx][ny].isdigit() and dist[nx][ny] >= t + 1:\n                                dp[t + 1][px][py][nx][ny] = True\n    \n    # reachable[px][py][x][y]\n    reachable = [[[[False] * N for _ in range(N)] for _ in range(N)] for _ in range(N)]\n    \n    for t in range(T + 1):\n        for px in range(N):\n            for py in range(N):\n                for x in range(N):\n                    for y in range(N):\n                        if dp[t][px][py][x][y]:\n                            reachable[px][py][x][y] = True\n    \n    # Flow network setup\n    total_nodes = 2 * N * N + 2\n    capacity = [[0] * total_nodes for _ in range(total_nodes)]\n    \n    # Source to A cells\n    for i in range(N):\n        for j in range(N):\n            if gridA[i][j].isdigit():\n                capacity[0][i * N + j + 1] = int(gridA[i][j])\n    \n    # B cells to sink\n    for i in range(N):\n        for j in range(N):\n            if gridB[i][j].isdigit():\n                capacity[N * N + i * N + j + 1][2 * N * N + 1] = int(gridB[i][j])\n    \n    # A cells to B cells if reachable\n    for i in range(N):\n        for j in range(N):\n            if not gridA[i][j].isdigit():\n                continue\n            for k in range(N):\n                for l in range(N):\n                    if not gridA[k][l].isdigit():\n                        continue\n                    if reachable[i][j][k][l]:\n                        capacity[i * N + j + 1][N * N + k * N + l + 1] = INF\n    \n    # Ford-Fulkerson / Edmonds-Karp\n    def bfs_flow():\n        vis = [False] * total_nodes\n        parent = [-1] * total_nodes\n        q = deque()\n        vis[0] = True\n        q.append(0)\n        \n        while q:\n            u = q.popleft()\n            if u == 2 * N * N + 1:\n                return True\n            for v in range(total_nodes):\n                if capacity[u][v] > 0 and not vis[v]:\n                    vis[v] = True\n                    parent[v] = u\n                    q.append(v)\n        return False\n    \n    while bfs_flow():\n        flow = INF\n        u = 2 * N * N + 1\n        while u != 0:\n            p = parent[u]\n            flow = min(flow, capacity[p][u])\n            u = p\n        \n        u = 2 * N * N + 1\n        while u != 0:\n            p = parent[u]\n            capacity[p][u] -= flow\n            capacity[u][p] += flow\n            u = p\n    \n    # Calculate result\n    result = 0\n    for i in range(total_nodes):\n        result += capacity[i][0]\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019977481861133128, -1.4305104514278355e-06, -3.576278118089249e-07, -0.031633410602808, -0.0005018643569201231, -2.3841855067985307e-07, -0.0009142747730948031, -0.00014053787162993103, -1.7881377516459906e-06, -0.00011657988943625242, -0.6328558325767517, -0.08800597488880157, -0.8007007837295532, -4.7205765440594405e-05, -1.4305104514278355e-06, -0.12149092555046082, -0.011933130212128162, -7.867782187531702e-06, -1.823885577323381e-05, -0.043588053435087204, -0.0002397011558059603, -2.0265558760002023e-06, -0.0004758894501719624, -1.1920928244535389e-07, -2.0861407392658293e-05, -1.5497195136049413e-06, -0.006723045837134123, -0.6345319747924805, -1.2040065485052764e-05, -0.2811537981033325, -8.344646857949556e-07, -0.7967658042907715, -3.313963316031732e-05, -1.5497195136049413e-06, -0.0004260824352968484, -1.1920928244535389e-07, -0.0006388768670149148, -0.0005173536483198404, -8.344646857949556e-07, -0.19618359208106995, -4.8874615458771586e-05, -1.1920928244535389e-07, -1.9073468138230965e-06, -0.00014