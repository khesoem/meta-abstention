      q.pop();\n            inq[now]=0;\n            for (int i=0;i<sz(G[now]);i++)\n            {\n                edge &e=G[now][i];\n                if (e.cap>0&&dist[now]+e.cost<dist[e.to])\n                {\n                    dist[e.to]=dist[now]+e.cost;\n                    prevv[e.to]=now;\n                    preve[e.to]=i;\n                    if (!inq[e.to]) inq[e.to]=1,q.push(e.to);\n                }\n            }\n        }\n\n        if (dist[t]==inff) return -1;\n\n        int d=f;\n        for (int v=t;v!=s;v=prevv[v])\n        {\n            d=min(d,G[prevv[v]][preve[v]].cap);\n        }\n        f-=d;\n        res+=d*dist[t];\n        for (int v=t;v!=s;v=prevv[v])\n        {\n            edge &e=G[prevv[v]][preve[v]];\n            e.cap-=d;\n            G[v][e.rev].cap+=d;\n        }\n    }\n    return res;\n}\n\nint N,M,K,C,D,X,Y;\nint A[58];\nvector<int> H[57];\n\nint32_t main()\n{\n    IOS\n    cin>>N>>M>>K>>C>>D;\n    for (int i=1;i<=K;i++)\n    {\n        cin>>X;\n        A[X]++;\n    }\n    for (int i=1;i<=M;i++)\n    {\n        cin>>X>>Y;\n        H[X].pb(Y);\n        H[Y].pb(X);\n    }\n\n    init(5103,0,5101);\n    for (int i=2;i<=N;i++) add_edge(0,i,A[i],0);\n    for (int i=0;i<=100;i++)\n    {\n        for (int l=1;l<=N;l++)\n        {\n            add_edge(50*i+l,50*(i+1)+l,K,0);\n            for (int j:H[l])\n            {\n                for (int k=1;k<=K;k++)\n                {\n                    add_edge(50*i+l,50*(i+1)+j,1,D*(2*k-1));\n                }\n            }\n        }\n    }\n    for (int i=1;i<=101;i++) add_edge(50*i+1,5101,K,C*i);\n    cout<<min_cost_flow(K)<<endl;\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int maxn = 6000;\n    static final long inf = Long.MAX_VALUE;\n    static final long mod = 1000000007;\n    \n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int to, int cap, int cost, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n    \n    static List<Edge>[] G = new List[maxn];\n    static long[] dist = new long[maxn];\n    static int[] prevv = new int[maxn];\n    static int[] preve = new int[maxn];\n    static int[] inq = new int[maxn];\n    \n    static void init(int _n, int _s, int _t) {\n        for (int i = 0; i <= _n; i++) {\n            G[i] = new ArrayList<>();\n        }\n    }\n    \n    static void add_edge(int from, int to, int cap, int cost) {\n        G[from].add(new Edge(to, cap, cost, G[to].size()));\n        G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n    }\n    \n    static long min_cost_flow(int f) {\n        long res = 0;\n        while (f > 0) {\n            Arrays.fill(dist, inf);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            inq[s] = 1;\n            \n            while (!q.isEmpty()) {\n                int now = q.poll();\n                inq[now] = 0;\n                for (int i = 0; i < G[now].size(); i++) {\n                    Edge e = G[now].get(i);\n                    if (e.cap > 0 && dist[now] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[now] + e.cost;\n                        prevv[e.to] = now;\n                        preve[e.to] = i;\n                        if (inq[e.to] == 0) {\n                            inq[e.to] = 1;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n            \n            if (dist[t] == inf) return -1;\n            \n            int d = f;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = Math.min(d, G[prevv[v]].get(preve[v]).cap);\n            }\n            f -= d;\n           