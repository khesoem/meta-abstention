{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <cstdio>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nvoid solveCase(int n) {\n    int k;\n    scanf(\"%d\", &k);\n\n    vector<double> p(n);\n    for (int i = 0; i < n; ++i) {\n        scanf(\"%lf\", &p[i]);\n    }\n\n    int m = 1 << n;\n    vector<double> dp(2 * m, 0.0);\n\n    vector<unsigned char> pc(m, 0);\n    for (int mask = 1; mask < m; ++mask) {\n        pc[mask] = (unsigned char)(pc[mask >> 1] + (mask & 1));\n    }\n\n    vector<char> good_flag(n, 0);\n    vector<int> good;\n    for (int i = 0; i < n; ++i) {\n        if (p[i] != 0.0) {\n            good_flag[i] = 1;\n            good.push_back(i);\n        }\n    }\n\n    vector<double> remain(m, 0.0);\n    remain[0] = 1.0;\n    for (int mask = 1; mask < m; ++mask) {\n        int low = mask & -mask;\n        int id = __builtin_ctz(low);\n        remain[mask] = remain[mask ^ low] - p[id];\n    }\n\n    dp[0] = 1.0;\n    int layer = 1;\n\n    for (int step = 0; step < k && step < (int)good.size(); ++step) {\n        fill(dp.begin() + layer * m, dp.begin() + (layer + 1) * m, 0.0);\n\n        for (int mask = 0; mask < m; ++mask) {\n            if (pc[mask] != step) {\n                continue;\n            }\n\n            for (int gi = 0; gi < (int)good.size(); ++gi) {\n                int v = good[gi];\n                if (mask & (1 << v)) {\n                    continue;\n                }\n\n                int target = mask | (1 << v);\n                dp[layer * m + target] +=\n                    dp[(layer ^ 1) * m + mask] * p[v] / remain[mask];\n            }\n        }\n\n        layer ^= 1;\n    }\n\n    layer ^= 1;\n\n    for (int i = 0; i < n; ++i) {\n        if (!good_flag[i]) {\n            printf(\"%.12f \\n\", 0.0);\n        } else {\n            double ans = 0.0;\n            for (int mask = 0; mask < m; ++mask) {\n                if (mask & (1 << i)) {\n                    ans += dp[layer * m + mask];\n                }\n            }\n            printf(\"%.12f \\n\", ans);\n        }\n    }\n}\n\nint main() {\n    int n;\n    while (scanf(\"%d\", &n) == 1) {\n        solveCase(n);\n    }\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef solve_case(n, tokens, idx):\n    k = int(tokens[idx]); idx += 1\n    p = [0.0] * n\n    for i in range(n):\n        p[i] = float(tokens[idx]); idx += 1\n\n    m = 1 << n\n    dp = [0.0] * (2 * m)\n\n    # popcount for all masks\n    pc = [0] * m\n    for mask in range(1, m):\n        pc[mask] = pc[mask >> 1] + (mask & 1)\n\n    good_flag = [0] * n\n    good = []\n    for i in range(n):\n        if p[i] != 0.0:\n            good_flag[i] = 1\n            good.append(i)\n\n    remain = [0.0] * m\n    remain[0] = 1.0\n    for mask in range(1, m):\n        low = mask & -mask\n        # index of lowest set bit: low.bit_length() - 1\n        id = low.bit_length() - 1\n        remain[mask] = remain[mask ^ low] - p[id]\n\n    dp[0] = 1.0\n    layer = 1\n\n    max_steps = min(k, len(good))\n    for step in range(max_steps):\n        # clear next layer\n        start = layer * m\n        end = (layer + 1) * m\n        for i in range(start, end):\n            dp[i] = 0.0\n\n        for mask in range(m):\n            if pc[mask] != step:\n                continue\n            for gi in range(len(good)):\n                v = good[gi]\n                if mask & (1 << v):\n                    continue\n                target = mask | (1 << v)\n                dp[layer * m + target] += dp[(layer ^ 1) * m + mask] * p[v] / remain[mask]\n\n        layer ^= 1\n\n    layer ^= 1  # final layer\n\n    out_lines = []\n    for i in range(n):\n        if not good_flag[i]:\n            out_lines.append(f\"{0.0:.12f} \")\n        else:\n            ans = 0.0\n            for mask in range(m):\n                if mask & (1 << i):\n                    ans += dp[layer * m + mask]\n            out_lines.append(f\"{ans:.12f} \")\n    return out_lines, idx\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    idx = 0\n    while idx < len(data):\n        n = int(data[idx]); idx += 1\n        lines, idx = solve_case(n, data, idx)\n        sys.stdout.write(\"\\n\".join(lines) + \"\\n\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.9073304429184645e-05, -0.009041793644428253, -1.5735502529423684e-05, 0.0, -1.1920928244535389e-07, -0.0003682888636831194, -0.006791721563786268, -2.861018856492592e-06, -0.5762595534324646, -0.006840857211500406, -2.50339189733495e-06, -3.707340147229843e-05, -4.589452510117553e-05, -0.0012313887709751725, -0.001364849042147398, -0.00018487652414478362, -0.001989648910239339, -0.1860506534576416, -0.20253653824329376, -0.03145448863506317, -5.781483559985645e-05, 0.0, -0.018333619460463524, -1.0609570381348021e-05, -0.018151365220546722, -0.0002616301644593477, 0.0, -3.576278118089249e-07, -0.00