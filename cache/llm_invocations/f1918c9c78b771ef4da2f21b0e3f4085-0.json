>(Comparator.comparingLong(a -> a[0]));\n                dist[s] = 0;\n                pq.offer(new long[]{0, s});\n\n                while (!pq.isEmpty()) {\n                    long[] top = pq.poll();\n                    long d = top[0];\n                    int v = (int) top[1];\n                    if (d != dist[v]) continue;\n\n                    for (int id : adj.get(v)) {\n                        Edge e = edges.get(id);\n                        if (e.flow >= e.cap) continue;\n\n                        long nd = d + e.cost + pot[v] - pot[e.to];\n                        if (dist[e.to] > nd) {\n                            dist[e.to] = nd;\n                            pv[e.to] = v;\n                            pe[e.to] = id;\n                            pq.offer(new long[]{nd, e.to});\n                        }\n                    }\n                }\n\n                if (dist[t] == INF) break;\n\n                for (int i = 0; i < n; i++) pot[i] += dist[i];\n\n                long add = INF;\n                for (int v = t; v != s; v = pv[v]) {\n                    int id = pe[v];\n                    add = Math.min(add, edges.get(id).cap - edges.get(id).flow);\n                }\n\n                flow += add;\n                for (int v = t; v != s; v = pv[v]) {\n                    int id = pe[v];\n                    Edge e = edges.get(id);\n                    e.flow += add;\n                    edges.get(id ^ 1).flow -= add;\n                    totalCost += add * e.cost;\n                }\n            }\n            return new long[]{flow, totalCost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int N = n * T;\n        MinCostMaxFlow mcf = new MinCostMaxFlow(N + 2);\n\n        // waiting edges\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(i * T + j, i * T + j + 1, INF, c);\n            }\n        }\n\n        // sink edges (only from first T nodes)\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i, N + 1, INF, 0);\n        }\n\n        // source to start positions\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            mcf.addEdge(N, x * T, 1, 0);\n        }\n\n        // road edges\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken()) - 1;\n            int y = Integer.parseInt(st.nextToken()) - 1;\n            for (int j = 0; j < T - 1; j++) {\n                int cur = 1;\n                for (int z = 0; z < k; z++) {\n                    mcf.addEdge(x * T + j, y * T + j + 1, 1, (long) cur * d + c);\n                    mcf.addEdge(y * T + j, x * T + j + 1, 1, (long) cur * d + c);\n                    cur += 2;\n                }\n            }\n        }\n\n        long[] res = mcf.minCostFlow(N, N + 1);\n        // assert res[0] == k; // optional check\n        System.out.println(res[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -4.6967357775429264e-05, -1.7881377516459906e-06, 0.0, -0.3868710994720459, -0.02332359552383423, -1.1920928244535389e-07, 0.0, -0.00013028726971242577, -0.00016032364510465413, -0.04875106364488602, -1.1920928244535389e-07, -0.041277214884757996, -0.0040831537917256355, -0.0003359945258125663, -0.0022512348368763924, -0.0019453902496024966, -0.004078523721545935, 0.0, 0.0, -1.6569954823353328e-05,