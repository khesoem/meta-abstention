{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n// luogu-judger-enable-o2\n#include<bits/stdc++.h>\nusing namespace std;\n#define pii pair<int,int>\n#define mp make_pair\n#define inf 100000000\n#define nn 6000\nnamespace mcmf{\n\tvector<int> v[nn],rev[nn],cost[nn],cap[nn];\n\tvoid add_edge(int x,int y,int c,int w)\n\t{\n\t\trev[x].push_back(v[y].size());rev[y].push_back(v[x].size());\n\t\tv[x].push_back(y);v[y].push_back(x);\n\t\tcost[x].push_back(w);cost[y].push_back(-w);\n\t\tcap[x].push_back(c);cap[y].push_back(0);\n\t}\n\t\n\tint dist[nn];int vis[nn];\n\tint prex[nn],prei[nn];\n\tvoid spfa(int s)\n\t{\n\t\tmemset(dist,0x3f,sizeof dist);\n\t\tmemset(vis,0,sizeof vis);prex[s]=-1;\n\t\tqueue<int> q;q.push(s);dist[s]=0;vis[s]=1;\n\t\t\n\t\twhile(q.size())\n\t\t{\n\t\t\tint x=q.front();q.pop();vis[x]=0;\n\t\t\tfor(int i=0;i<v[x].size();i++)\n\t\t\t{\n\t\t\t\tint y=v[x][i];\n\t\t\t\tint cc=dist[x]+cost[x][i];\n\t\t\t\tif(dist[y]>cc and cap[x][i])\n\t\t\t\t{\n\t\t\t\t\tdist[y]=cc;prex[y]=x,prei[y]=i;\n\t\t\t\t\tif(!vis[y]) vis[y]=1,q.push(y);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t\n\t}\n\t\n\tint tot=0;\n\tint dfs(int x,int flow)\n\t{\n\t\tif(prex[x]==-1) return flow;\n\t\tint y=x;x=prex[y];int i=prei[y],j=rev[x][i];\n\t\tint f=dfs(x,min(flow,cap[x][i]));\n\t\tcap[x][i]-=f,cap[y][j]+=f;\n\t\treturn f;\n\t}\n\t\n\tpii solve(int s,int t)\n\t{\n\t\tint ans=0;tot=0;\n\t\twhile(1)\n\t\t{\n\t\t\tspfa(s);\n\t\t\tif(dist[t]>1e9) break;\n\t\t\tint f=dfs(t,inf);\n\t\t\ttot+=f*dist[t];\n\t\t\tans+=f;\n\t\t}\n\t\treturn mp(ans,tot);\n\t}\n\t\n};\n\n\nint n,m,s=nn-1,t=nn-2;\nint k,c,d;\nint get(int x,int tim){\n\treturn tim*52-52+x;\n}\nint main() \n{\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);int kk=k;\n\twhile(k--){\n\t\tint x;scanf(\"%d\",&x);\n\t\tmcmf::add_edge(s,get(x,1),1,0);\n\t}k=kk;\n\twhile(m--){\n\t\tint x,y;scanf(\"%d%d\",&x,&y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t\t\n\t\tswap(x,y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t}\n\tfor(int i=1;i<100;i++){\n\t\tfor(int j=1;j<=n;j++) mcmf::add_edge(get(j,i),get(j,i+1),inf,0);\n\t\tmcmf::add_edge(get(1,i),t,inf,c*(i-1));\n\t}\n\t\n\tprintf(\"%d\",mcmf::solve(s,t).second);\n\t\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.BufferedReader;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.io.PrintWriter;\nimport java.util.ArrayDeque;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.StringTokenizer;\n\npublic class Main {\n    static class Edge {\n        int to, cap, cost, rev;\n    }\n\n    static class Pair {\n        int first, second;\n\n        public Pair(int first, int second) {\n            this.first = first;\n            this.second = second;\n        }\n    }\n\n    static ArrayList<Edge>[] adj;\n    static int[] dist, prex, prei;\n    static int s, t, n, m, k, c, d;\n    static int tot;\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n        s = 2 * n + 1;\n        t = 2 * n + 2;\n        adj = new ArrayList[2 * n + 3];\n        for (int i = 0; i < adj.length; i++) {\n            adj[i] = new ArrayList<>();\n        }\n        for (int i = 1; i <= n; i++) {\n            addEdge(s, i, 1, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            int x = Integer.parseInt(br.readLine());\n            addEdge(s, x, 1, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            int x = Integer.parseInt(br.readLine());\n            for (int j = 1; j <= k; j++) {\n                addEdge(x, x + 1, 1, d * (j + j - 1));\n            }\n            swap(x, x + 1);\n            for (int j = 1; j <= k; j++) {\n                addEdge(x, x + 1, 1, d * (j + j - 1));\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= 99; j++) {\n                addEdge(i + j * 52, i + (j + 1) * 52, 1, 0);\n            }\n            addEdge(1 + i * 52, t, 1, c * (i - 1));\n        }\n        Pair ans = solve(s, t);\n        pw.println(ans.second);\n        pw.close();\n    }\n\n    static void addEdge(int x, int y, int cap, int cost) {\n        Edge a = new Edge();\n        a.to = y;\n        a.cap = cap;\n        a.cost = cost;\n        a.rev = adj[y].size();\n        adj[x].add(a);\n        Edge b = new Edge();\n        b.to = x;\n        b.cap = 0;\n        b.cost = -cost;\n        b.rev = adj[x].size();\n        adj[y].add(b);\n    }\n\n    static Pair solve(int s, int t) {\n        dist = new int[2 * n + 3];\n        prex = new int[2 * n + 3];\n        prei = new int[2 * n + 3];\n        Arrays.fill(dist, Integer.MAX_VALUE);\n        Arrays.fill(prex, -1);\n        ArrayDeque<Integer> q = new ArrayDeque<>();\n        q.add(s);\n        dist[s] = 0;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            for (Edge e : adj[x]) {\n                int y = e.to;\n                int cc = dist[x] + e.cost;\n                if (dist[y] > cc && e.cap > 0) {\n                    dist[y] = cc;\n                    prex[y] = x;\n                    prei[y] = e.rev;\n                    if (!adj[y].contains(e.rev)) {\n                        adj[y].add(e.rev);\n                    }\n                    q.add(y);\n                }\n            }\n        }\n        tot = 0;\n        int ans = 0;\n        while (true) {\n            for (int i = 0; i < adj.length; i++) {\n                adj[i].clear();\n            }\n            Arrays.fill(dist, Integer.MAX_VALUE);\n            Arrays.fill(prex, -1);\n            q = new ArrayDeque<>();\n            q.add(t);\n            dist[t] = 0;\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                for (Edge e : adj[x]) {\n                    int y = e.to;\n                    int cc = dist[x] + e.cost;\n                    if (dist[y] > cc && e.cap > 0) {\n                        dist[y] = cc;\n                        prex[y] = x;\n                        prei[y] = e.rev;\n                        if (!adj[y].contains(e.rev)) {\n                            adj[y].add(e.rev);\n                        }\n                        q.add(y);\n                    }\n                }\n            }\n            if (dist[t] == Integer.MAX_VALUE) {\n                break;\n            }\n            int f = dfs(t, Integer.MAX_VALUE);\n            ans += f;\n            tot += f * dist[t];\n        }\n        return new Pair(ans, tot);\n    }\n\n    static int dfs(int x, int flow) {\n        if (prex[x] == -1) {\n            return flow;\n        }\n        int y = x;\n        x = prex[y];\n        int i = prei[y];\n        int j = adj[x].get(i).rev;\n        int f = dfs(x, Math.min(flow, adj[x].get(i).cap));\n        adj[x].get(i).cap -= f;\n        adj[y].get(j).cap += f;\n        return f;\n    }\n}\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.22859452664852142, -0.005559791345149279, -0.2538655996322632, -0.02022348903119564, -0.00015367257583420724, -0.4293678402900696, -0.5676298141479492, -0.0002073860669042915, -1.8716033082455397e-05, -1.4424427718040533e-05, -3.7313202483346686e-05, -0.13031220436096191, -1.3113030945532955e-06, -1.0728841743912199e-06, -1.561653880344238e-05, -1.120573597290786e-05, -0.004639104474335909, -4.053198063047603e-05, -9.536788638797589e-06, -1.1920999895664863e-05, -0.25329339504241943, -0.025594815611839294, -0.0002621159655973315, -6.079858576413244e-05, -4.2916264646919444e-05, -0.004552698694169521, -0.8935784697532654, -9.059946933120955e-06, -9.787561430130154e-05, -9.298368240706623e-06, -2.515347659937106e-05, -4.768372718899627e-07, -0.6988586187362671, -0.014164513908326626, -8.71457887114957e-05, -0.00011242067557759583, -1.3113030945532955e-06, -0.879939079284668, -0.002476238878443837, -6.592491263290867e-05, -2.360371763643343e-05, -3.337865791763761e-06, -1.3364641666412354, -3.7790057831443846e-05, -0.2014184296131134, -0.017806412652134895, -2.8133788873674348e-05, -0.0433262474834919, -0.5885753631591797, -0.4130654036998749, -0.10816522687673569, -0.29058322310447693, -0.5147070288658142, -0.04661794751882553, -0.0020431873854249716, -0.01851772330701351, -0.43972137570381165, -0.1158185675740242, -0.5538060069084167, -0.0050962865352630615, -0.48836198449134827, -0.1955537050962448, -0.3443206250667572, -0.6416991949081421, -0.6939747929573059, -0.021366871893405914, -4.887700197286904e-05, -0.021099653095006943, -0.6519906520843506, -0.870