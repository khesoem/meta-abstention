nt n, int m) {\n    std::vector<Point> even, odd;\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < m; ++j) {\n            int sum = i + j;\n            if (sum % 2 == 0) {\n                even.emplace_back(i, j);\n            } else {\n                odd.emplace_back(i, j);\n            }\n        }\n    }\n\n    std::vector<std::vector<bool>> match(even.size(), std::vector<bool>(odd.size(), false));\n    for (size_t i = 0; i < even.size(); ++i) {\n        for (size_t j = 0; j < odd.size(); ++j) {\n            int d = std::abs(even[i].x - odd[j].x) + std::abs(even[i].y - odd[j].y);\n            if (d == 3) {\n                match[i][j] = true;\n            }\n        }\n    }\n\n    return 2 * maxMatching(match);\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    std::cin >> n >> m;\n\n    if (n > m) std::swap(n, m);\n\n    if (n == 1) {\n        m--;\n        const int left[] = {0, 0, 0, 2, 4, 6};\n        long long res = (m / 6) * 6 + left[m % 6];\n        std::cout << res << \"\\n\";\n        return 0;\n    } else if (n == 2) {\n        if (m < 20) {\n            std::cout << bruteforce(n, m) << \"\\n\";\n        } else {\n            std::cout << 1LL * n * m << \"\\n\";\n        }\n        return 0;\n    } else if (n == 3) {\n        if (m < 20) {\n            std::cout << bruteforce(n, m) << \"\\n\";\n        } else {\n            long long res = 1LL * n * m;\n            if (res % 2 != 0) res--;\n            std::cout << res << \"\\n\";\n        }\n        return 0;\n    }\n\n    if (1LL * n * m < 1000) {\n        std::cout << bruteforce(n, m) << \"\\n\";\n        return 0;\n    }\n\n    long long res = 1LL * n * m;\n    if (res % 2 != 0) res--;\n    std::cout << res << \"\\n\";\n\n    return 0;\n}\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.8372434973716736, -6.392202976712724e-06, -0.07891292124986649, -3.650518920039758e-06, -9.372294698550832e-06, -1.028038354888849