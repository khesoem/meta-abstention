b;\n        return lhs.a < rhs.a;\n    };\n    \n    sort(pool.begin(), pool.end(), cmp);\n    \n    cout << pool[0].a << \"/\" << pool[0].b << '\\n';\n    \n    return 0;\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Candidate {\n        long a;\n        long b;\n\n        Candidate(long a, long b) {\n            this.a = a;\n            this.b = b;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        int x = scanner.nextInt();\n        int y = scanner.nextInt();\n        int n = scanner.nextInt();\n        \n        List<Candidate> pool = new ArrayList<>();\n        pool.ensureCapacity(2 * n);\n        \n        for (int b = 1; b <= n; ++b) {\n            long[] bounds = getBounds(x, y, b);\n            pool.add(new Candidate(bounds[0], b));\n            pool.add(new Candidate(bounds[1], b));\n        }\n        \n        pool.sort((lhs, rhs) -> {\n            long el = error(lhs, x, y);\n            long er = error(rhs, x, y);\n            if (el != er) {\n                return Long.compare(el, er);\n            }\n            if (lhs.b != rhs.b) {\n                return Long.compare(lhs.b, rhs.b);\n            }\n            return Long.compare(lhs.a, rhs.a);\n        });\n        \n        System.out.println(pool.get(0).a + \"/\" + pool.get(0).b);\n    }\n    \n    private static long[] getBounds(int x, int y, int b) {\n        long num = (long) b * x;\n        long lo = num / y;\n        long hi = (num + y - 1) / y;\n        return new long[]{lo, hi};\n    }\n    \n    private static long error(Candidate c, int x, int y) {\n        return Math.abs((long) x * c.b - c.a * y);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000101441961