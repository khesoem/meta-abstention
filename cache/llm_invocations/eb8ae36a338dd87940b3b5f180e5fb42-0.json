e>\nimport java.util.*;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n\n    static long[][] matmul(long[][] A, long[][] B) {\n        int n = A.length;\n        long[][] C = new long[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int k = 0; k < n; k++) {\n                if (A[i][k] != 0) {\n                    for (int j = 0; j < n; j++) {\n                        C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD;\n                    }\n                }\n            }\n        }\n        return C;\n    }\n\n    static long[][] rotate(long[][] M, int shift) {\n        int n = M.length;\n        long[][] R = new long[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                if (M[i][j] != 0) {\n                    if (i == j) {\n                        R[i][j] = M[i][j];\n                    } else {\n                        R[i][(j + shift) % n] = M[i][j];\n                    }\n                }\n            }\n        }\n        return R;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long N = sc.nextLong();\n        int K = sc.nextInt();\n        \n        List<Integer> base_rep = new ArrayList<>();\n        long tempN = N;\n        while (tempN != 0) {\n            base_rep.add((int)(tempN % K));\n            tempN /= K;\n        }\n        \n        // B[level][digit] = matrix\n        long[][][][] B = new long[60][30][][]; // level 0 to 59, digit 0 to 29\n        long[][][][] PREFIX = new long[60][30][][];\n        long[][][][] SUFFIX = new long[60][30][][];\n        \n        // Initialize level 0\n        for (int i = 0; i < K; i++) {\n            B[0][i] = new long[K + 1][K + 1];\n            for (int j = 0; j <= K; j++) {\n                B[0][i][j][j] = 1;\n                B[0][i][j][i] = 1;\n            }\n        }\n        \n        int baseSize = base_rep.size();\n        for (int lvl = 1; lvl < baseSize; lvl++) {\n            // PREFIX[lvl-1][0] = B[lvl-1][0]\n            PREFIX[lvl-1][0] = B[lvl-1][0];\n            for (int j = 1; j < K; j++) {\n                PREFIX[lvl-1][j] = matmul(PREFIX[lvl-1][j-1], B[lvl-1][j]);\n            }\n            \n            // SUFFIX[lvl-1][K-1] = B[lvl-1][K-1]\n            SUFFIX[lvl-1][K-1] = B[lvl-1][K-1];\n            for (int j = K-2; j >= 0; j--) {\n                SUFFIX[lvl-1][j] = matmul(B[lvl-1][j], SUFFIX[lvl-1][j+1]);\n            }\n            \n            // B[lvl][0] = PREFIX[lvl-1][K-1]\n            B[lvl][0] = PREFIX[lvl-1][K-1];\n            for (int j = 1; j < K; j++) {\n                B[lvl][j] = matmul(SUFFIX[lvl-1][j], PREFIX[lvl-1][j-1]);\n            }\n        }\n        \n        long[][] trans_matrix = new long[K + 1][K + 1];\n        for (int i = 0; i <= K; i++) {\n            trans_matrix[i][i] = 1;\n        }\n        \n        int running_mod = 0;\n        for (int idx = baseSize - 1; idx >= 0; idx--) {\n            int d = base_rep.get(idx);\n            for (int step = 0; step < d; step++) {\n                trans_matrix = matmul(trans_matrix, B[idx][running_mod]);\n                running_mod++;\n                if (running_mod >= K) running_mod -= K;\n            }\n        }\n        \n        long final_res = 1;\n        for (int i = 0; i < K; i++) {\n            final_res = (final_res + trans_matrix[K][i]) % MOD;\n        }\n        \n        System.out.println(final_res);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00013743886665906757, -3.099436753473128e-06, -4.768370445162873e-07, -0.0006031363154761493, -3.7788631743751466e-05, -0.029975341632962227, -0.4290071725845337, -1.0490362910786644e-05, -1.311301275563892e-06, -3.58813522325363e-05, -0.023246262222528458, -1.168244216387393e-05, -0.07703812420368195, -0.016757789999246597, -0.0008186326595023274, -3.4570634852570947e-06, 0.0, -1.1920928244535389e-07, 0.0, -0.0004306104383431375, 0