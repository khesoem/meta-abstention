                prevv[e.to] = u;\n                preve[e.to] = i;\n                if (!inq[e.to]) {\n                    q.push(e.to);\n                    inq[e.to] = true;\n                }\n            }\n        }\n    }\n    return dist[t] < iinf;\n}\n\npair<int, int> mcmf() {\n    pair<int, int> res(0, 0);\n    while (spfa()) {\n        int f = iinf;\n        for (int u = t; u != s; u = prevv[u]) {\n            f = min(f, G[prevv[u]][preve[u]].cap);\n        }\n        for (int u = t; u != s; u = prevv[u]) {\n            Edge &e = G[prevv[u]][preve[u]];\n            e.cap -= f;\n            G[e.to][e.rev].cap += f;\n        }\n        res.first += f;\n        res.second += dist[t] * f;\n    }\n    return res;\n}\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    mxt = N * 3 + 1;\n    fn = (t = (s = n * mxt) + 1) + 1;\n    for (int i = 0; i < k; ++i) {\n        int u;\n        scanf(\"%d\", &u);\n        --u;\n        add_edge(s, u, 1, 0);\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        scanf(\"%d%d\", &u, &v);\n        --u; --v;\n        for (int i2 = 0; i2 < mxt - 1; ++i2) {\n            for (int p = 1; p <= k; ++p) {\n                add_edge(i2 * n + u, (i2 + 1) * n + v, 1, 2 * d * p - d);\n                add_edge(i2 * n + v, (i2 + 1) * n + u, 1, 2 * d * p - d);\n            }\n        }\n    }\n    for (int u = 0; u < n; ++u) {\n        for (int i = 0; i < mxt - 1; ++i) {\n            add_edge(i * n + u, (i + 1) * n + u, k, 0);\n        }\n    }\n    for (int i = 0; i < mxt; ++i) {\n        add_edge(i * n, t, k, i * c);\n    }\n    pair<int, int> ans = mcmf();\n    assert(ans.first == k);\n    printf(\"%d\\n\", ans.second);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 0x3f3f3f3f\n\ndef solve():\n    data = list(map(int, sys.