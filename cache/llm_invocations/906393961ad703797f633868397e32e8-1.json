       for(int k = h[c]; ~k; k = ne[k]) if (cap[k] > 0) {\n                int v = to[k];\n                if(dis[c] + cost[k] < dis[v]){\n                    dis[v] = dis[c] + cost[k];\n                    pre[v] = k;\n                    if(!ing[v]) Q.push(v) , ing[v] = 1;\n                }\n            }\n        }\n        return dis[t] != inf;\n    }\n    U flow; V mincost;\n    pair<U, V> run(int _s,int _t){\n        s = _s , t = _t;\n        flow = mincost = 0;\n        while(spfa()){\n            U pl = inf; int p, k;\n            for(p = t;p != s;p = to[k^1]) pl = min(pl, cap[k = pre[p]]);\n            for(p = t;p != s;p = to[k^1]) cap[k = pre[p]] -= pl, cap[k^1] += pl;\n\t\t\tmincost += pl * dis[t];\n            flow += pl;\n        }\n        return make_pair(flow, mincost);\n    }\n};\nMCMF<int,int> flow;\nint n , m , k ,c , d ,a[N] , id[55][2500];\nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\trep(i , 1 , k + 1)\n\t\tscanf(\"%d\",&a[i]);\n\tflow.ini(50*50*4 + 10);\n\tint s = flow.n - 2,t = flow.n - 3;\n\tint cnt = 0 ,mx = 100;\n\trep(i , 1 , n + 1)\n\t\trep(j , 0 , mx + 1)\n\t\t\tid[i][j] = ++cnt;\n\tint u , v;\n\trep(i , 1 , m + 1){\n\t\tscanf(\"%d%d\",&u,&v);\n\t\trep(j , 0 , mx){\n\t\t\trep(h , 1 , k + 1){\n\t\t\t\tint tmp = h*h*d - (h-1)*(h-1)*d;\n\t\t\t\tflow.link(id[u][j] , id[v][j + 1] , 1 , c + tmp);\n\t\t\t\tflow.link(id[v][j] , id[u][j + 1] , 1 , c + tmp);\n\t\t\t}\n\t\t}\n\t}\n\trep(i , 1 , n + 1)\n\t\trep(j , 0 , mx)\n\t\t\tflow.link(id[i][j] , id[i][j + 1] , inf , c);\n\trep(i , 1 , k + 1)\n\t\tflow.link(s , id[a[i]][0] , 1 , 0);\n\trep(j , 1 , mx + 1)flow.link(id[1][j] , t , inf , 0);\n\tint ans = flow.run(s , t).se;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.head = [-1] * n\n        self.to = []\n        self.cap = []\n        self.cost = []\n        self.ne = []\n        self.e = 0\n\n    def add_edge(self, u, v, cap, cost):\n        # forward edge\n        self.to.append(v)\n        self.cap.append(cap)\n        self.cost.append(cost)\n        self.ne.append(self.head[u])\n        self.head[u] = self.e\n        self.e += 1\n        # reverse edge\n        self.to.append(u)\n        self.cap.append(0)\n        self.cost.append(-cost)\n        self.ne.append(self.head[v])\n        self.head[v] = self.e\n        self.e += 1\n\n    def link(self, u, v, cap, cost):\n        self.add_edge(u, v, cap, cost)\n\n    def spfa(self, s, t):\n        INF = 10 ** 18\n        n = self.n\n        dis = [INF] * n\n        ing = [0] * n\n        pre = [-1] * n\n        dis[s] = 0\n        q = deque([s])\n        ing[s] = 1\n        while q:\n            c = q.popleft()\n            ing[c] = 0\n            k = self.head[c]\n            while k != -1:\n                if self.cap[k] > 0:\n                    v = self.to[k]\n                    if dis[c] + self.cost[k] < dis[v]:\n                        dis[v] = dis[c] + self.cost[k]\n                        pre[v] = k\n                        if not ing[v]:\n                            q.append(v)\n                            ing[v] = 1\n                k = self.ne[k]\n        return pre, dis, dis[t] != INF\n\n    def run(self, s, t):\n        flow = 0\n        mincost = 0\n        INF = 10 ** 18\n        while True:\n            pre, dis, ok = self.spfa(s, t)\n            if not ok:\n                break\n            # find bottleneck\n            pl = INF\n            p = t\n            while p != s:\n                k = pre[p]\n                pl = min(pl, self.cap[k])\n                p = self.to[k ^ 1]\n            # augment\n            p = t\n            while p != s:\n                k = pre[p]\n                self.cap[k] -= pl\n                self.cap[k ^ 1] += pl\n                p = self.to[k ^ 1]\n            mincost += pl * dis[t]\n            flow += pl\n        return flow, mincost\n\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = int(next(it))\n\n    mx = 100\n    # assign node ids for each (node, time)\n    cnt = 0\n    id = [[0] * (mx + 1) for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        for j in range(0, mx + 1):\n            id[i][j] = cnt\n            cnt += 1\n\n    totalNodes = cnt + 2\n    s = cnt       # source\n    t = cnt + 1   # sink\n\n    flow = MCMF(totalNodes)\n\n    INF_CAP = 10 ** 9\n\n    # read graph edges\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(mx):\n            for h in range(1, k + 1):\n                tmp = (h * h - (h - 1) * (h - 1)) * d\n                flow.link(id[u][j], id[v][j + 1], 1, c + tmp)\n                flow.link(id[v][j], id[u][j + 1], 1, c + tmp)\n\n    # stay edges (wait)\n    for i in range(1, n + 1):\n        for j in range(mx):\n            flow.link(id[i][j], id[i][j + 1], INF_CAP, c)\n\n    # source to start positions\n    for i in range(1, k + 1):\n        flow.link(s, id[a[i]][0], 1, 0)\n\n    # sink from node 1 (exit) at times 1..mx\n    for j in range(1, mx + 1):\n        flow.link(id[1][j], t, INF_CAP, 0)\n\n    # run min-cost max-flow and print mincost\n    ans = flow.run(s, t)[1]\n    print(ans)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.9802276912960224e-06, 0.0, 0.0, -0.0006840273272246122, -0.006821795366704464, -6.6756979322235566e-06, -0.004113546572625637, -0.0002693767019081861, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -0.00025781645672395825, -0.011132155545055866, -2.38418550679