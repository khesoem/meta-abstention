n        \n        length *= 2\n    \n    if inverse:\n        for i in range(n):\n            a_real[i] /= n\n            a_imaginary[i] /= n\n\ndef multiply_mod(a, b, mod):\n    need = len(a) + len(b) - 1\n    n = max(2, 1 << (need - 1).bit_length())\n    \n    a_real = [0.0] * n\n    a_imaginary = [0.0] * n\n    for i in range(len(a)):\n        x = a[i] % mod\n        a_real[i] = x & ((1 << 15) - 1)\n        a_imaginary[i] = x >> 15\n    \n    fft(a_real, a_imaginary, False)\n    \n    b_real = [0.0] * n\n    b_imaginary = [0.0] * n\n    for i in range(len(b)):\n        x = b[i] % mod\n        b_real[i] = x & ((1 << 15) - 1)\n        b_imaginary[i] = x >> 15\n    \n    fft(b_real, b_imaginary, False)\n    \n    fa_real = [0.0] * n\n    fa_imaginary = [0.0] * n\n    fb_real = [0.0] * n\n    fb_imaginary = [0.0] * n\n    \n    for i in range(n):\n        j = (n - i) & (n - 1)\n        \n        a1r = (a_real[i] + a_real[j]) / 2\n        a1i = (a_imaginary[i] - a_imaginary[j]) / 2\n        a2r = (a_imaginary[i] + a_imaginary[j]) / 2\n        a2i = (a_real[j] - a_real[i]) / 2\n        \n        b1r = (b_real[i] + b_real[j]) / 2\n        b1i = (b_imaginary[i] - b_imaginary[j]) / 2\n        b2r = (b_imaginary[i] + b_imaginary[j]) / 2\n        b2i = (b_real[j] - b_real[i]) / 2\n        \n        fa_real[i] = a1r * b1r - a1i * b1i - a2r * b2i - a2i * b2r\n        fa_imaginary[i] = a1r * b1i + a1i * b1r + a2r * b2r - a2i * b2i\n        \n        fb_real[i] = a1r * b2r - a1i * b2i + a2r * b1r - a2i * b1i\n        fb_imaginary[i] = a1r * b2i + a1i * b2r + a2r * b1i + a2i * b1r\n    \n    fft(fa_real, fa_imaginary, True)\n    fft(fb_real, fb_imaginary, True)\n    \n    res = [0] * need\n    for i in range(need):\n        aa = int(fa_real[i] + 0.5)\n        bb = int(fb_real[i] + 0.5)\n        cc = int(fa_imaginary[i] + 0.5)\n        res[i] = int((aa + ((bb % mod) << 15) + ((cc % mod) << 30)) % mod)\n    \n    return res\n\ndef solve():\n    mod = 998244353\n    n, k = map(int, sys.stdin.readline().split())\n    v = [0] * 10\n    for _ in range(k):\n        x = int(sys.stdin.readline())\n        v[x] = 1\n    \n    ans = [1]\n    p = n // 2\n    while True:\n        if p % 2 != 0:\n            ans = multiply_mod(ans, v, mod)\n        p //= 2\n        if p == 0:\n            break\n        v = multiply_mod(v, v, mod)\n    \n    res = 0\n    for x in ans:\n        res = (res + x * x) % mod\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011228884250158444, -1.1920922133867862e-06, -5.960462772236497e-07, -0.002013562014326453, -0.0035892606247216463, -0.010050404816865921, -0.008649268187582493, -0.0007297713309526443, -0.0056464700028300285, -0.28137579560279846, -0.6957964301109314, -0.0015528061194345355, -0.22609148919582367, -1.1920928244535389e-07, -2.2291887944447808e-05, -9.48860906646587e-05, -0.12695451080799103, -1.1920928244535389e-07, -6.365573790390044e-05, -0.0021893836092203856, -8.344646857949556e-07, -5.960462772236497e-07, -1.0728830375228426e-06, -6.794906312279636e-06, 0.0, -5.722029527532868e-06, -9.536738616588991e-07, -1.3351351299206726e-05, -0.07269301265478134, -0.00033742457162588835, -0.13830412924289703, 0.0, -0.20141372084617615, -8.344646857949556e-07, -8.344646857949556e-07, -1.4305104514278355e-06, -0.067445769906044, -5.960462772236497e-07, -0.043475180864334106, -0.304039865732193, -0.577006995677948, -0.00019786784832831472, -4.768370445162873e-07, -0.0010725465836003423, -2.4914430468925275e-05, -9.536738616588991e-07, -0.2633301019668579, -2.3841855067985307e-07, -0.22719788551330566, -5.960462772236497e-07, -0.0040197535417973995, 0.0, -3.576278118089249e-07, -1.9073468138230965e-06, -0.00041059168870560825, -0.00011073929636040702, -2.5033637939486653e-05, -5.960462772236497e-07, -0.003626320045441389, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.6931478977203369, -1.1920928