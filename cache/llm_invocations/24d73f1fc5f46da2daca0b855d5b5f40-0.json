coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n\nint main() {\n    int n, b;\n    std::cin >> n >> b;\n    \n    std::vector<int> cuts;\n    std::vector<int> arr(n);\n    \n    int even = 0, odd = 0;\n    \n    for (int i = 0; i < n; i++) {\n        std::cin >> arr[i];\n    }\n    \n    for (int i = 0; i < n; i++) {\n        if (i != 0 && even == odd) {\n            cuts.push_back(std::abs(arr[i] - arr[i - 1]));\n        }\n        \n        if (arr[i] % 2 == 0) {\n            even++;\n        } else {\n            odd++;\n        }\n    }\n    \n    std::sort(cuts.begin(), cuts.end());\n    \n    int count = 0;\n    for (int i = 0; i < cuts.size(); i++) {\n        if (cuts[i] <= b) {\n            count++;\n            b -= cuts[i];\n        }\n    }\n    \n    std::cout << count << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016330339713022113, -3.814689989667386e-06, -5.722029527532868e-06, -0.00012957210128661245, -1.311301275563892e-06, -1.3828182090946939e-05, -8.344646857949556e-07, -9.894321920000948e-06, -2.861018856492592e-06, -2.288792165927589e-05, -4.768370445162873e-07, -7.748573807475623e-06, -2.3841855067985307e-07, -0.0010184821439906955, -2.4437606043647975e-05, -0.0001802282058633864, -1.0847986231965479e-05, -0.07893910259008408, -0.038044627755880356, -0.06197299435734749, -1.7881377516459906e-06, -1.0728830375228426e-06, -1.5020257706055418e-05, -1.311301275563892e-06, -0.012578439898788929, 0.0, -5.960462772236497e-07, 0.0, -7.152531907195225e-06, -2.0265558760002023e-06, -5.829164365422912e-05, -5.960462772236497e-07, -0.0003535122668836266, -8.344646857949556e-07, -1.1920928244535389e-07, -5.006777428206988e-06, -1.1920922133867862e-06, -5.280832192511298e-05, -0.14267952740192413, -3.0636318115284666e-05, -2.3841830625315197e-06, 0.0, -2.0265558760002023e-06, -3.814689