) {\n        this.n = n;\n        this.source = source;\n        this.sink = sink;\n        adj = new ArrayList<>(n);\n        for (int i = 0; i < n; i++) {\n            adj.add(new ArrayList<>());\n        }\n        edges = new ArrayList<>();\n    }\n\n    int addEdge(int a, int b, int cap, int cost) {\n        int result = edges.size();\n        adj.get(a).add(edges.size());\n        edges.add(new Edge(b, 0, cap, cost, cost));\n        adj.get(b).add(edges.size());\n        edges.add(new Edge(a, 0, 0, -cost, -cost));\n        return result;\n    }\n\n    int[] djk() {\n        PriorityQueue<int[]> pq = new PriorityQueue<>((x, y) -> x[0] - y[0]);\n        int[] dist = new int[n];\n        int[] prev = new int[n];\n        int[] maxf = new int[n];\n        Arrays.fill(dist, Integer.MAX_VALUE / 2);\n        Arrays.fill(prev, -1);\n        Arrays.fill(maxf, 0);\n        dist[source] = 0;\n        prev[source] = -2;\n        maxf[source] = Integer.MAX_VALUE;\n        pq.add(new int[]{0, source});\n        while (!pq.isEmpty()) {\n            int[] top = pq.poll();\n            int d = top[0], v = top[1];\n            if (d != dist[v]) continue;\n            for (int edid : adj.get(v)) {\n                Edge ed = edges.get(edid);\n                if (ed.flow < ed.cap && dist[ed.u] > dist[v] + ed.cost) {\n                    dist[ed.u] = dist[v] + ed.cost;\n                    prev[ed.u] = edid;\n                    maxf[ed.u] = Math.min(maxf[v], ed.cap - ed.flow);\n                    pq.add(new int[]{dist[ed.u], ed.u});\n                }\n            }\n        }\n        int lastid = prev[sink];\n        int extraflow = maxf[sink];\n        int atcost = 0;\n        if (lastid == -1) return new int[]{0, 0};\n        for (int id = lastid; id != -2; id = prev[edges.get(id ^ 1).u]) {\n            edges.get(id).flow += extraflow;\n            edges.get(id ^ 1).flow -= extraflow;\n            atcost += edges.get(id).origcost;\n        }\n        for (int id = 0; id < edges.size(); id++) {\n            int v = edges.get(id ^ 1).u, u = edges.get(id).u;\n            if (prev[v] != -1 && prev[u] != -1) {\n                edges.get(id).cost += dist[v] - dist[u];\n            }\n        }\n        return new int[]{extraflow, atcost};\n    }\n\n    int[] mfmc() {\n        int flow = 0, cost = 0;\n        boolean hasNeg = false;\n        for (Edge ed : edges) {\n            if (ed.flow > 0 && ed.cost < 0) {\n                hasNeg = true;\n                break;\n            }\n        }\n        if (hasNeg) bellamanford();\n        while (true) {\n            int[] res = djk();\n            int extraflow = res[0], atcost = res[1];\n            if (extraflow == 0) break;\n            flow += extraflow;\n            cost += extraflow * atcost;\n        }\n        return new int[]{flow, cost};\n    }\n\n    void bellamanford() {\n        int[] dist = new int[n];\n        Arrays.fill(dist, Integer.MAX_VALUE / 2);\n        dist[source] = 0;\n        for (int rep = 0; rep < n; rep++) {\n            boolean changed = false;\n            for (int id = 0; id < edges.size(); id++) {\n                int v = edges.get(id ^ 1).u, u = edges.get(id).u;\n                if (edges.get(id).flow < edges.get(id).cap && dist[v] != Integer.MAX_VALUE / 2 &&\n                    dist[u] > dist[v] + edges.get(id).cost) {\n                    dist[u] = dist[v] + edges.get(id).cost;\n                    changed = true;\n                    if (rep == n - 1) throw new RuntimeException(\"Negative cycle\");\n                }\n            }\n            if (!changed) break;\n        }\n        for (int id = 0; id < edges.size(); id++) {\n            int v = edges.get(id ^ 1).u, u = edges.get(id).u;\n            if (dist[v] < Integer.MAX_VALUE / 2 && dist[u] < Integer.MAX_VALUE / 2) {\n                edges.get(id).cost += dist[v] - dist[u];\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt(), m = sc.nextInt(), k = sc.nextInt(), c = sc.nextInt(), d = sc.nextInt();\n        final int maxTime = 120;\n        int[] a = new int[k];\n        for (int i = 0; i < k; i++) a[i] = sc.nextInt();\n        List<Integer>[] e = new ArrayList[n + 1];\n        for (int i = 1; i <= n; i++) e[i] = new ArrayList<>();\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt(), y = sc.nextInt();\n            e[x].add(y);\n            e[y].add(x);\n        }\n        int nd = 0;\n        int[][] to = new int[maxTime][n + 1];\n        for (int i = 0; i < maxTime; i++) {\n            for (int j = 1; j <= n; j++) to[i][j] = nd++;\n        }\n        int S = nd++, T = nd++;\n        SSP flow = new SSP(nd, S, T);\n        for (int i = 0; i < k; i++) flow.addEdge(S, to[0][a[i]], 1, 0);\n        for (int i = 0; i < maxTime; i++) flow.addEdge(to[i][1], T, k, c * i);\n        for (int i = 0; i < maxTime - 1; i++) {\n            for (int j = 1; j <= n; j++) {\n                for (int u : e[j]) {\n                    for (int z = 0; z <= 52; z++) {\n                        flow.addEdge(to[i][j], to[i + 1][u], 1, d * (2 * z + 1));\n                    }\n                }\n                flow.addEdge(to[i][j], to[i + 1][j], k, 0);\n            }\n        }\n        int[] result = flow.mfmc();\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-5.960463e-07, 0.0, 0.0, -0.00019107423, -0.00057037297, -2.264974e-06, -0.023246262, -0.4744072, -0.048690658, -4.2915253e-06, -1.9205632, -0.011806139, -0.00020811777, -0.10546881, -3.6954812e-06, -0.00012385078, -1.6689287e-06, -2.3841855e-07, 0.0, -7.867782e-06, -3.576278e-07, -0.12766236, -0.003215502, -6.3180723e-06, -0.00091141637, -1.1920928e-07, -0.0029515533, -0.0052343467, -0.09184475, -2.8490615e-05, -4.5299425e-06, 0.0, -2.3841855e-07, -0.24405321, -1.1920928e-07, -0.83359563, -0.00021848676, -3.6954812e-06, -4.7683704e-