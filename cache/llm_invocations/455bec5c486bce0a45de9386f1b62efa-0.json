(int i = 0; i < N; ++i) {\n            tmp[i] = new BitSet();\n            for (int j = 0; j < (1 << N); ++j) {\n                if (x.get(j)) {\n                    int newBit = j | (1 << i);\n                    tmp[i].set(newBit);\n                }\n            }\n        }\n\n        int size = 1 << N;\n        int[] curTrans = new int[size];\n        for (int mask = 0; mask < size; ++mask) {\n            BitSet tp = (BitSet)x.clone();\n            for (int j = 0; j < N; ++j) {\n                if ((mask >> j & 1) == 1) {\n                    tp.or(tmp[j]);\n                }\n            }\n            curTrans[mask] = dfs(tp);\n        }\n        trans.add(curTrans);\n        return cur;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        BitSet start = new BitSet();\n        start.set(0);\n        dfs(start);\n        inv100 = modPow(100, MOD - 2);\n        for (int i = 0; i < N; ++i) {\n            for (int j = 0; j < N; ++j) {\n                P[i][j] = sc.nextInt();\n            }\n        }\n\n        int[][] dp = new int[2][cnt + 1];\n        dp[0][1] = 1;\n        int cur = 0;\n        int size = 1 << N;\n        for (int i = 0; i < N; ++i) {\n            for (int mask = 0; mask < size; ++mask) {\n                long prod = 1;\n                for (int k = 0; k < N; ++k) {\n                    int val = ((mask >> k & 1) == 1) ? P[i][k] : (100 - P[i][k]);\n                    prod = prod * val % MOD * inv100 % MOD;\n                }\n                prob[mask] = (int)prod;\n            }\n            cur ^= 1;\n            Arrays.fill(dp[cur], 0);\n            for (int j = 1; j <= cnt; ++j) {\n                int base = dp[cur ^ 1][j];\n                if (base == 0) continue;\n                int[] transj = trans.get(j - 1);\n                for (int mask = 0; mask < size; ++mask) {\n                    int nxt = transj[mask];\n                    dp[cur][nxt] = (int