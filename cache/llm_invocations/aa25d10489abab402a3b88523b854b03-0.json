{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 1000000000;\n\nstruct Edge {\n    int to, cap, cost, flow;\n    size_t rev;\n};\n\nvoid insertEdge(vector<vector<Edge>>& graph, int from, int to, int capacity, int cost) {\n    Edge forward = {to, capacity, cost, 0, graph[to].size()};\n    Edge backward = {from, 0, -cost, 0, graph[from].size()};\n    graph[from].push_back(forward);\n    graph[to].push_back(backward);\n}\n\nint main() {\n    int N, m, k, c, d;\n    scanf(\"%d %d %d %d %d\", &N, &m, &k, &c, &d);\n    int totalNodes = N * 101 + 2;\n    vector<vector<Edge>> graph(totalNodes);\n    \n    for (int i = 0; i < k; i++) {\n        int x;\n        scanf(\"%d\", &x);\n        x--;\n        insertEdge(graph, totalNodes - 2, x * 101, 1, 0);\n    }\n    \n    for (int i = 0; i < 101; i++) {\n        insertEdge(graph, i, totalNodes - 1, INF, i * c);\n    }\n    \n    for (int i = 1; i < N; i++) {\n        for (int j = 0; j < 100; j++) {\n            insertEdge(graph, i * 101 + j, i * 101 + j + 1, INF, 0);\n        }\n    }\n    \n    for (int i = 0; i < m; i++) {\n        int u, v;\n        scanf(\"%d %d\", &u, &v);\n        u--; v--;\n        for (int j = 0; j < 100; j++) {\n            for (int K = 1; K <= k; K++) {\n                int edgeCost = d * (K * K - (K - 1) * (K - 1));\n                insertEdge(graph, u * 101 + j, v * 101 + j + 1, 1, edgeCost);\n                insertEdge(graph, v * 101 + j, u * 101 + j + 1, 1, edgeCost);\n            }\n        }\n    }\n    \n    int source = totalNodes - 2;\n    int sink = totalNodes - 1;\n    int totalFlow = 0, totalCost = 0;\n    \n    while (totalFlow < k) {\n        vector<int> dist(totalNodes, INF);\n        vector<int> parent(totalNodes, -1);\n        vector<size_t> parentEdgeIndex(totalNodes);\n        vector<int> inQueue(totalNodes, 0);\n        queue<int> q;\n        \n        dist[source] = 0;\n        q.push(source);\n        inQueue[source] = 1;\n        \n        while (!q.empty()) {\n            int node = q.front();\n            q.pop();\n            inQueue[node] = 0;\n            \n            for (size_t idx = 0; idx < graph[node].size(); idx++) {\n                Edge& e = graph[node][idx];\n                if (e.flow < e.cap && dist[node] + e.cost < dist[e.to]) {\n                    dist[e.to] = dist[node] + e.cost;\n                    parent[e.to] = node;\n                    parentEdgeIndex[e.to] = idx;\n                    if (!inQueue[e.to]) {\n                        q.push(e.to);\n                        inQueue[e.to] = 1;\n                    }\n                }\n            }\n        }\n        \n        if (dist[sink] == INF) break;\n        \n        int augmentFlow = k - totalFlow;\n        for (int v = sink; v != source; v = parent[v]) {\n            int u = parent[v];\n            size_t idx = parentEdgeIndex[v];\n            augmentFlow = min(augmentFlow, graph[u][idx].cap - graph[u][idx].flow);\n        }\n        \n        for (int v = sink; v != source; v = parent[v]) {\n            int u = parent[v];\n            size_t idx = parentEdgeIndex[v];\n            size_t revIdx = graph[u][idx].rev;\n            graph[u][idx].flow += augmentFlow;\n            graph[v][revIdx].flow -= augmentFlow;\n            totalCost += graph[u][idx].cost * augmentFlow;\n        }\n        \n        totalFlow += augmentFlow;\n    }\n    \n    assert(totalFlow == k);\n    printf(\"%d\\n\", totalCost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1000000000\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'flow', 'rev')\n    def __init__(self, to, cap, cost, flow, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.flow = flow\n        self.rev = rev\n\ndef insertEdge(graph, from_node, to_node, capacity, cost):\n    forward = Edge(to_node, capacity, cost, 0, len(graph[to_node]))\n    backward = Edge(from_node, 0, -cost, 0, len(graph[from_node]))\n    graph[from_node].append(forward)\n    graph[to_node].append(backward)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    N = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    totalNodes = N * 101 + 2\n    graph = [[] for _ in range(totalNodes)]\n    \n    for i in range(k):\n        x = int(next(it))\n        x -= 1\n        insertEdge(graph, totalNodes - 2, x * 101, 1, 0)\n    \n    for i in range(101):\n        insertEdge(graph, i, totalNodes - 1, INF, i * c)\n    \n    for i in range(1, N):\n        for j in range(100):\n            insertEdge(graph, i * 101 + j, i * 101 + j + 1, INF, 0)\n    \n    for i in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for j in range(100):\n            for K in range(1, k + 1):\n                edgeCost = d * (K * K - (K - 1) * (K - 1))\n                insertEdge(graph, u * 101 + j, v * 101 + j + 1, 1, edgeCost)\n                insertEdge(graph, v * 101 + j, u * 101 + j + 1, 1, edgeCost)\n    \n    source = totalNodes - 2\n    sink = totalNodes - 1\n    totalFlow = 0\n    totalCost = 0\n    \n    while totalFlow < k:\n        dist = [INF] * totalNodes\n        parent = [-1] * totalNodes\n        parentEdgeIndex = [0] * totalNodes\n        inQueue = [0] * totalNodes\n        q = deque()\n        \n        dist[source] = 0\n        q.append(source)\n        inQueue[source] = 1\n        \n        while q:\n            node = q.popleft()\n            inQueue[node] = 0\n            \n            for idx in range(len(graph[node])):\n                e = graph[node][idx]\n                if e.flow < e.cap and dist[node] + e.cost < dist[e.to]:\n                    dist[e.to] = dist[node] + e.cost\n                    parent[e.to] = node\n                    parentEdgeIndex[e.to] = idx\n                    if not inQueue[e.to]:\n                        q.append(e.to)\n                        inQueue[e.to] = 1\n        \n        if dist[sink] == INF:\n            break\n        \n        augmentFlow = k - totalFlow\n        v = sink\n        while v != source:\n            u = parent[v]\n            idx = parentEdgeIndex[v]\n            augmentFlow = min(augmentFlow, graph[u][idx].cap - graph[u][idx].flow)\n            v = u\n        \n        v = sink\n        while v != source:\n            u = parent[v]\n            idx = parentEdgeIndex[v]\n            revIdx = graph[u][idx].rev\n            graph[u][idx].flow += augmentFlow\n            graph[v][revIdx].flow -= augmentFlow\n            totalCost += graph[u][idx].cost * augmentFlow\n            v = u\n        \n        totalFlow += augmentFlow\n    \n    assert totalFlow == k\n    print(totalCost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011967896716669202, -7.152555099310121e-07, -1.