{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ull = unsigned long long;\n\nconst int MAXN = 250010;\n\nint n, k, p, lim;\nint pc[MAXN];\null dp[26][MAXN], fact[MAXN], invfact[MAXN], powv, total;\n\null mod_pow(ull base, int expo) {\n    ull res = 1;\n    while (expo > 0) {\n        if (expo & 1) res = res * base % p;\n        base = base * base % p;\n        expo >>= 1;\n    }\n    return res;\n}\n\null solve_dp(int K, int N) {\n    if (pc[N] < K) return 0;\n    if (K == 1) return dp[K][N] = invfact[N];\n    if (dp[K][N]) return dp[K][N];\n\n    ull cur = 0;\n    int cnt = 0;\n    for (int sub = N & (N - 1); sub; sub = N & (sub - 1)) {\n        if (pc[sub] >= K - 1) {\n            cur += solve_dp(K - 1, sub) * invfact[N ^ sub];\n            if (++cnt == 18) {\n                cnt = 0;\n                cur %= p;\n            }\n        }\n    }\n    return dp[K][N] = cur % p;\n}\n\null comb(int N, int M) {\n    return fact[N] * invfact[M] % p * invfact[N - M] % p;\n}\n\nint main() {\n#ifndef ONLINE_JUDGE\n    freopen(\"255x.in\", \"r\", stdin);\n    freopen(\"255x.out\", \"w\", stdout);\n#endif\n    if (scanf(\"%d%d%d\", &n, &k, &p) != 3) return 0;\n\n    for (int i = 1; i <= n; ++i) pc[i] = pc[i >> 1] + (i & 1);\n\n    powv = mod_pow(k, n);\n    if (n & 1) {\n        printf(\"%d\\n\", powv);\n        return 0;\n    }\n\n    lim = min(k, pc[n]);\n\n    fact[0] = 1;\n    for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i % p;\n\n    invfact[n] = mod_pow(fact[n], p - 2);\n    for (int i = n; i >= 1; --i) invfact[i - 1] = invfact[i] * i % p;\n\n    total = 0;\n    for (int i = lim; i >= 1; --i) total += comb(k, i) * solve_dp(i, n);\n\n    ull ans = (powv - total % p * fact[n] % p + p) % p;\n    printf(\"%lld\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n\n    # popcount array\n    pc = [0] * (n + 1)\n    for i in range(1, n + 1):\n        pc[i] = pc[i >> 1] + (i & 1)\n\n    # modular exponentiation\n    def mod_pow(base, expo):\n        res = 1\n        while expo > 0:\n            if expo & 1:\n                res = res * base % p\n            base = base * base % p\n            expo >>= 1\n        return res\n\n    powv = mod_pow(k, n)\n    if n & 1:\n        print(powv)\n        return\n\n    lim = min(k, pc[n])\n\n    # factorials\n    fact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i - 1] * i % p\n\n    invfact = [1] * (n + 1)\n    invfact[n] = mod_pow(fact[n], p - 2)\n    for i in range(n, 0, -1):\n        invfact[i - 1] = invfact[i] * i % p\n\n    # DP memoization: list of dicts for each K (0..25)\n    dp = [{} for _ in range(26)]\n\n    def solve_dp(K, N):\n        if pc[N] < K:\n            return 0\n        if K == 1:\n            dp[K][N] = invfact[N]\n            return dp[K][N]\n        if N in dp[K]:\n            return dp[K][N]\n\n        cur = 0\n        cnt = 0\n        sub = N & (N - 1)\n        while sub:\n            if pc[sub] >= K - 1:\n                cur += solve_dp(K - 1, sub) * invfact[N ^ sub]\n                cnt += 1\n                if cnt == 18:\n                    cnt = 0\n                    cur %= p\n            sub = N & (sub - 1)\n        cur %= p\n        dp[K][N] = cur\n        return cur\n\n    def comb(N, M):\n        return fact[N] * invfact[M] % p * invfact[N - M] % p\n\n    total = 0\n    for i in range(lim, 0, -1):\n        total += comb(k, i) * solve_dp(i, n)\n\n    ans = (powv - (total % p) * fact[n] % p + p) % p\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0004359725280664861, -0.005824142601341009, -3.576278118089249e-07, -0.018162721768021584, -0.0011319665936753154, -0.41298708319664, -0.05123772472143173, -2.50339189733495e-06, -0.005281542893499136, -2.0265558760002023e-06, -0.00041166413575410843, 0.0, -0.0015376898227259517, -7.867782187531702e-06, -0.029750995337963104, -2.861018856492592e-06, 0.0, -4.768360213347478e-06, -1.1920928244535389e-07, 0.0, -0.048587556928396225, 0.0, -0.0002924968139268458, 0.0, -1.0728830375228426e-06, -2.9802276912960224e-06, -1.1920928244535389e-07, -0.019608115777373314, -0.4744754433631897, 0.0, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, -0.5759897828102112, 0.0, -8.344646857949556e-07, -0.00044050050200894475, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.932505594799295e-05, -3.611976353568025e-05, 0.0, -2.9802276912960224e-06, -2.8013790142722428e-05, 0.0, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, -0.16039998829364777, -1.1920922133867862e-06, -0.043471869081258774, -0.04582377150654793, -2.3603161025675945e-05, -0.18761417269706726, -0.26593175530433655, 0.0, -0.0022351776715368032, 0.0, 0.0, 0.0, 0.0, -0.00015841660206206143, -7.1525