ensions\n    if n > 100:\n        nn = (n - 100) % 6\n        nq = (n - 100) // 6\n        ans += nq * 6 * m\n        n = 100 + nn\n\n    if m > 100:\n        nm = (m - 100) % 6\n        mq = (m - 100) // 6\n        ans += mq * 6 * n\n        m = 100 + nm\n\n    # grid with indices 1..n, 1..m\n    mat = [[0] * (m + 1) for _ in range(n + 1)]\n\n    u = 1\n    v = 1\n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            if (i + j) % 2 == 0:\n                mat[i][j] = u\n                u += 1\n\n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            if (i + j) % 2 != 0:\n                mat[i][j] = v\n                v += 1\n\n    # graph: adjacency list for left side (even cells)\n    g = [[] for _ in range(u)]  # indices 0..u-1, we use 1..u-1\n\n    # helper to add edge if inside grid\n    def add_edge(i, j, s, t):\n        if 1 <= s <= n and 1 <= t <= m:\n            g[mat[i][j]].append(mat[s][t])\n\n    # add all knight-like moves for even cells\n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            if (i + j) % 2 == 0:\n                add_edge(i, j, i - 3, j)\n                add_edge(i, j, i - 2, j - 1)\n                add_edge(i, j, i - 2, j + 1)\n                add_edge(i, j, i, j - 3)\n                add_edge(i, j, i - 1, j - 2)\n                add_edge(i, j, i + 1, j - 2)\n                add_edge(i, j, i, j + 3)\n                add_edge(i, j, i - 1, j + 2)\n                add_edge(i, j, i + 1, j + 2)\n                add_edge(i, j, i + 3, j)\n                add_edge(i, j, i + 2, j - 1)\n                add_edge(i, j, i + 2, j + 1)\n\n    # Hopcroft-Karp bipartite matching\n    class HopcroftKarpBipartiteMatching:\n        def __init__(self, left_size, right_size, graph):\n            self.left_size = left_size\n            self.right_size = right_size\n            self.graph = graph  # adjacency list, 1-indexed left nodes\n            self.NIL = 0\n            self.INF = 10**7\n            self.pairU = [0] * (left_size + 1)\n            self.pairV = [0] * (right_size + 1)\n            self.dist = [0] * (left_size + 1)\n\n        def bfs(self):\n            q = deque()\n            for u in range(1, self.left_size + 1):\n                if self.pairU[u] == self.NIL:\n                    q.append(u)\n                    self.dist[u] = 0\n                else:\n                    self.dist[u] = self.INF\n            self.dist[self.NIL] = self.INF\n            while q:\n                u = q.popleft()\n                if self.dist[u] < self.dist[self.NIL]:\n                    for v in self.graph[u]:\n                        if self.dist[self.pairV[v]] == self.INF:\n                            self.dist[self.pairV[v]] = self.dist[u] + 2\n                            q.append(self.pairV[v])\n            return self.dist[self.NIL] < self.INF\n\n        def dfs(self, u):\n            if u != self.NIL:\n                for v in self.graph[u]:\n                    if self.dist[self.pairV[v]] == self.dist[u] + 2:\n                        if self.dfs(self.pairV[v]):\n                            self.pairV[v] = u\n                            self.pairU[u] = v\n                            return True\n                self.dist[u] = self.INF\n                return False\n            else:\n                return True\n\n        def maximum_matching(self):\n            self.pairU = [0] * (self.left_size + 1)\n            self.pairV = [0] * (self.right_size + 1)\n            matching = 0\n            while self.bfs():\n                for u in range(1, self.left_size + 1):\n                    if self.pairU[u] == self.NIL and self.dfs(u):\n                        matching += 1\n            return matching\n\n    left_size = u - 1\n    right_size = v - 1\n    bpm = HopcroftKarpBipartiteMatching(left_size, right_size, g)\n    matching = bpm.maximum_matching()\n    ans += 2 * matching\n\n    print(ans)\n\n\nif __name__ == \"__main__\":\n    solve()\n</tran