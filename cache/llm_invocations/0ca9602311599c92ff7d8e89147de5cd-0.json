        while (!pq.isEmpty()) {\n                    Pair p = pq.poll();\n                    long d = p.dist;\n                    int v = p.node;\n                    if (dist[v] < d) continue;\n                    for (int i = 0; i < g.get(v).size(); i++) {\n                        Edge e = g.get(v).get(i);\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to];\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.add(new Pair(dist[e.to], e.to));\n                        }\n                    }\n                }\n                if (dist[t] >= INF) break;\n                for (int v = 0; v < n; v++) pot[v] += dist[v];\n                long add = maxf - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    add = Math.min(add, g.get(prevv[v]).get(preve[v]).cap);\n                }\n                flow += add;\n                res += add * pot[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.cap -= add;\n                    g.get(v).get(e.rev).cap += add;\n                }\n            }\n            return res;\n        }\n\n        static class Pair {\n            long dist;\n            int node;\n            Pair(long dist, int node) {\n                this.dist = dist;\n                this.node = node;\n            }\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        final int T = 99;\n        final int C = 15;\n        final int source = 0;\n        final int sink = n * T + 1;\n        MinCostFlow mcf = new MinCostFlow(n * T + 2);\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int a = Integer.parseInt(st.nextToken());\n            mcf.addEdge(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; t++) {\n            mcf.addEdge(1 + t * n, sink, Long.MAX_VALUE, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; i++) {\n                    mcf.addEdge(i + (t - 1) * n, i + t * n, Long.MAX_VALUE, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int a = Integer.parseInt(st.nextToken());\n            int b = Integer.parseInt(st.nextToken());\n            for (int j = 0; j < C; j++) {\n                int cost = (j + 1) * (j + 1) - j * j;\n                for (int t = 1; t < T; t++) {\n                    mcf.addEdge(a + (t - 1) * n, b + t * n, 1, (long) cost * d + c);\n                    mcf.addEdge(b + (t - 1) * n, a + t * n, 1, (long) cost * d + c);\n                }\n            }\n        }\n\n        long price = mcf.minCostFlow(source, sink, k);\n        System.out.println(price);\n    }\n}\n```", "token_logprobs": [-0.006073826923966408, -0.5763304829597473, -1.311301275563892e-06, -7.64102369430475e-05, -1.1920858014491387e-05, 0.0, -0.005233753472566605, -0.2014283388853073, 0.0, 0.0, -2.3841855067985307e-07, -0.00011383838864276186, -0.0034563345834612846, 0.0, -0.003219661070033908, -0.16051837801933289, -0.00523553229868412, -0.01064220443367958, -0.3869990110397339, -0.0036438989918679, -9.536738616588991e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -7.497983460780233e-05, 0.0, -7.152555099310121e-07, 0.0, -2.3841855067985307e-07, 0.0, -2.384185506798