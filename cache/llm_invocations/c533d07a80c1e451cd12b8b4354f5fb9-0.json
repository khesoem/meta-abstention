{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include<cstdio>\n#include<vector>\n#include<iostream>\nusing namespace std;\nconst int K=33,mod=1000000007;\nstruct matrix{long long a[K][K];};\nmatrix t[K]={},ans={{}},pre[K]={},suf[K]={};\nlong long n;\nint k;\ninline void matmul(const matrix &A,const matrix &B,matrix &C)\n{\n\tmatrix T={{}};\n\tfor(int i=0;i<=k;i++)\n\tfor(int j=0;j<=k;j++){\n\t\tT.a[i][j]=0;\n\t\tfor(int p=0;p<=k;p++)\n\t\t(T.a[i][j]+=A.a[i][p]*B.a[p][j])%=mod;\n\t}\n\tC=T;\n}\nvoid init(){\n\tcin>>n>>k;\n\tfor(int i=0;i<=k;i++)\n\tfor(int j=0;j<=k;j++)\n\tans.a[i][j]=(i==j);\n\tfor(int p=0;p<k;p++)\n\tfor(int i=0;i<=k;i++)\n\tfor(int j=0;j<=k;j++)\n\tt[p].a[i][j]=(i==j||i==p);\n}\nvoid work(){\n\tvector<int> digits;\n\tfor(;n;n/=k)digits.push_back(n%k);\n\tdigits.push_back(0);\n\tpartial_sum(digits.rbegin(),digits.rend(),digits.rbegin());\n\tfor(size_t idx=0;idx<digits.size()-1;idx++){\n\t\tfor(int val=digits[idx]-1;val>=digits[idx+1];val--)\n\t\t\tmatmul(t[val%k],ans,ans);\n\t\tpre[0]=t[0];\n\t\tfor(int i=1;i<k;i++)matmul(pre[i-1],t[i],pre[i]);\n\t\tsuf[k-1]=t[k-1];\n\t\tfor(int i=k-2;i>=0;i--)matmul(t[i],suf[i+1],suf[i]);\n\t\tt[0]=suf[0];\n\t\tfor(int i=1;i<k;i++)matmul(suf[i],pre[i-1],t[i]);\n\t}\n\tlong long sum=0;\n\tfor(int i=0;i<=k;i++)sum+=ans.a[i][k];\n\tprintf(\"%lld\\n\",(sum%mod+mod)%mod);\n}\nint main(){\n\tios::sync_with_stdio(false);\n\tcin.tie(0);\n\tinit();\n\twork();\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nK = 33\nmod = 1000000007\n\nclass Matrix:\n    def __init__(self):\n        self.a = [[0] * K for _ in range(K)]\n\ndef matmul(A, B, C):\n    T = Matrix()\n    for i in range(k + 1):\n        for j in range(k + 1):\n            T.a[i][j] = 0\n            for p in range(k + 1):\n                T.a[i][j] = (T.a[i][j] + A.a[i][p] * B.a[p][j]) % mod\n    C.a = [row[:] for row in T.a]\n\ndef init():\n    global n, k\n    n, k = map(int, sys.stdin.readline().split())\n    for i in range(k + 1):\n        for j in range(k + 1):\n            ans.a[i][j] = 1 if i == j else 0\n    for p in range(k):\n        for i in range(k + 1):\n            for j in range(k + 1):\n                t[p].a[i][j] = 1 if (i == j or i == p) else 0\n\ndef work():\n    digits = []\n    temp_n = n\n    while temp_n:\n        digits.append(temp_n % k)\n        temp_n //= k\n    digits.append(0)\n    \n    # partial_sum of reversed digits\n    for i in range(len(digits) - 2, -1, -1):\n        digits[i] = (digits[i] + digits[i + 1]) % mod\n    \n    for idx in range(len(digits) - 1):\n        for val in range(digits[idx] - 1, digits[idx + 1] - 1, -1):\n            temp_matrix = Matrix()\n            matmul(t[val % k], ans, temp_matrix)\n            ans.a = [row[:] for row in temp_matrix.a]\n        \n        pre[0].a = [row[:] for row in t[0].a]\n        for i in range(1, k):\n            temp_matrix = Matrix()\n            matmul(pre[i - 1], t[i], temp_matrix)\n            pre[i].a = [row[:] for row in temp_matrix.a]\n        \n        suf[k - 1].a = [row[:] for row in t[k - 1].a]\n        for i in range(k - 2, -1, -1):\n            temp_matrix = Matrix()\n            matmul(t[i], suf[i + 1], temp_matrix)\n            suf[i].a = [row[:] for row in temp_matrix.a]\n        \n        t[0].a = [row[:] for row in suf[0].a]\n        for i in range(1, k):\n            temp_matrix = Matrix()\n            matmul(suf[i], pre[i - 1], temp_matrix)\n            t[i].a = [row[:] for row in temp_matrix.a]\n    \n    total_sum = 0\n    for i in range(k + 1):\n        total_sum = (total_sum + ans.a[i][k]) % mod\n    print((total_sum % mod + mod) % mod)\n\n# Initialize global variables\nt = [Matrix() for _ in range(K)]\nans = Matrix()\npre = [Matrix() for _ in range(K)]\nsuf = [Matrix() for _ in range(K)]\nn = 0\nk = 0\n\nif __name__ == \"__main__\":\n    init()\n    work()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001282609737245366, -1.311301275563892e-06, -2.3841855067985307e-07, -0.45173388719558716, -0.0002847504511009902, -0.026303814724087715, -0.6066611409187317, -7.867782187531702e-06, 0.0, 0.0, -2.145764938177308e-06, -3.576278118089249e-07, -0.0011731653939932585, -3.576278118089249e-07, 0.0, 0.0, -7.152555099310121e-07, -5.8530047681415454e-05, 0.0, -5.960462772236497e-07, 0.0, -3.576278118089249e-07, -9.536738616588991e-07, -2.3841855067985307e-07, -1.3708974620385561e-05, -0.00024423000286333263, -0.03954993933439255, -0.01427521649748087, -5.722029527532868e-06, -7.152555099310121e-07, -1.3351351299206726e-05, -2.264974000354414e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -0.3484543263912201, -7.64102369430475e-05, -1.9073468138230965e-06, -2.3841855067985307e-07, -2.1815061700181104e-05, -4.160317621426657e-05, -1.9073468138230965e-06, -0.1518072783946991, -3.3378546504536644e-06, -9.667406266089529e-05, -8.344646857949556e-07, -5.960462772236497e-07, -3.576278118089249e-07, -2.145764938177308e-06, -7.152555099310121e-07, -0.2811664