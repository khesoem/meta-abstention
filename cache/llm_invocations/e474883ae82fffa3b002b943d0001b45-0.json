em.exit(0);\n        }\n\n        list=new ArrayList<>();\n        list.add(1L); list.add(W);\n\n        long cur=W;\n        final long MAX=(long)(1e10);\n\n        while (true)\n        {\n            cur*=W;\n            if(cur<0||cur>MAX) break;\n\n            list.add(cur);\n        }\n\n        subsets = new ArrayList<>();\n        allSubsets(0,0);\n\n        boolean flag=false;\n        for(long x: subsets)\n        {\n            flag |= check(M, W, x);\n            if(flag) break;\n        }\n\n        System.out.println(flag?\"YES\":\"NO\");\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <algorithm>\n\nusing namespace std;\n\nvector<long long> list, subsets;\n\nvoid allSubsets(int i, long long sum) {\n    if (i == list.size()) {\n        subsets.push_back(sum);\n        return;\n    }\n    \n    allSubsets(i + 1, sum + list[i]);\n    allSubsets(i + 1, sum);\n}\n\nbool check(long long M, long long W, long long x) {\n    if (x == M) return true;\n    \n    bool flag = true;\n    x += M;\n    while (x > 0) {\n        if (x % W > 1) {\n            flag = false;\n            break;\n        }\n        x /= W;\n    }\n    \n    return flag;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    \n    long long W, M;\n    ss >> W >> M;\n    \n    if (W == 2) {\n        cout << \"YES\" << endl;\n        return 0;\n    }\n    \n    list.clear();\n    list.push_back(1LL);\n    list.push_back(W);\n    \n    long long cur = W;\n    const long long MAX = (long long)(1e10);\n    \n    while (true) {\n        cur *= W;\n        if (cur < 0 || cur > MAX) break;\n        \n        list.push_back(cur);\n    }\n    \n    subsets.clear();\n    allSubsets(0, 0);\n    \n    bool flag = false;\n    for (long long x : subsets) {\n