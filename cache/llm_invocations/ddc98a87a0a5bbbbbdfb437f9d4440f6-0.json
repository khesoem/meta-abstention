        g[y].add(e.size());\n        e.add(new Edge(x, 0, 0, -cost));\n    }\n\n    static int n, m, k, c, d;\n\n    static void input(Scanner sc) {\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        for (int i = 0; i < N; i++) {\n            g[i] = new ArrayList<>();\n        }\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            addEdge(source, x, 1, 0);\n        }\n\n        int timeLayers = 101;\n        for (int i = 0; i < timeLayers; i++) {\n            addEdge(i * n, target, k, i * c);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt() - 1;\n            int y = sc.nextInt() - 1;\n            for (int j = 0; j < timeLayers - 1; j++) {\n                addEdge(x + j * n, y + j * n + n, 1, d * (j * 2 + 1));\n            }\n            for (int j = 0; j < timeLayers - 1; j++) {\n                addEdge(y + j * n, x + j * n + n, 1, d * (j * 2 + 1));\n            }\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < timeLayers - 1; j++) {\n                addEdge(i + j * n, i + j * n + n, k, 0);\n            }\n        }\n\n        for (int i = 0; i < k; i++) {\n            pushFlow();\n        }\n        System.out.println(ans);\n    }\n\n    static void solve() {\n        // No additional implementation needed as logic is in input()\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        input(sc);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.021184833720326424, -0.000500966387335211, -3.054500666621607e-06, -0.00014740281039848924, -1.3856492842023727e-06, -1.9361264946837764e-07, -0.007657977286726236, -0.04017364978790283, -0.034704193472862244, -0.00023154958034865558, -0.07270283252000809, -0.0007372042746283114, -0.0005561320576816797, -3.12