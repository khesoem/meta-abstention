ndef dfs(v, flow, t, d, ptr):\n    if v == t:\n        return flow\n    while ptr[v] < len(g[v]):\n        e = g[v][ptr[v]]\n        to = e['to']\n        cf = e['c'] - e['f']\n        if d[to] == d[v] + 1 and cf > 0:\n            pushed = dfs(to, min(flow, cf), t, d, ptr)\n            if pushed > 0:\n                e['f'] += pushed\n                g[to][e['rev']]['f'] -= pushed\n                return pushed\n        ptr[v] += 1\n    return 0\n\ndef dinic():\n    flow = 0\n    while True:\n        d = build_lev_net()\n        if d[t] == INF:\n            break\n        ptr = [0] * (SIZE)\n        while True:\n            pushed = dfs(s, INF, t, d, ptr)\n            if pushed == 0:\n                break\n            flow += pushed\n    return flow\n\n# Directions for BFS\nX = [-1, 1, 0, 0]\nY = [0, 0, -1, 1]\n\n# Initialize dst array\ndst = [[[[INF for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(n)]\ntbad = int(tbad)\n\ndef check(v):\n    return 0 <= v[0] < n and 0 <= v[1] < n and a[v[0]][v[1]] != 'Y' and a[v[0]][v[1]] != 'Z'\n\nfrom collections import deque\n\ndef bfs(xs, ys):\n    for i in range(n):\n        for j in range(n):\n            dst[xs][ys][i][j] = INF\n    dst[xs][ys][xs][ys] = 0\n    go = deque()\n    go.append((xs, ys))\n    while go:\n        v = go.popleft()\n        v_x, v_y = v\n        if dst[xs][ys][v_x][v_y] == dst[bad[0]][bad[1]][v_x][v_y] and (bad[0] != xs or bad[1] != ys):\n            continue\n        for i in range(4):\n            nv = (v_x + X[i], v_y + Y[i])\n            if check(nv):\n                if dst[xs][ys][nv[0]][nv[1]] == INF:\n                    if dst[xs][ys][v_x][v_y] + 1 <= dst[bad[0]][bad[1]][nv[0]][nv[1]]:\n                        dst[xs][ys][nv[0]][nv[1]] = dst[xs][ys][v_x][v_y] + 1\n                        go.append(nv)\n\n# Find 'Z' position\nbad = (px, py)\nbfs(px, py)\nfor i in range(n):\n    for j in range(n):\n        dst[bad[0]][bad[1]][i][j] = min(dst[bad[0]][bad[1]][i][j], tbad)\n\n# Run BFS from all relevant points\nfor i in range(n):\n    for j in range(n):\n        if check((i, j)):\n            bfs(i, j)\n\n# Build the flow network\nfor i in range(n):\n    for j in range(n):\n        node_in = i * n + j + 1\n        node_out = node_in + n * n\n        if a[i][j] != '0':\n            add_edge(s, node_in, int(a[i][j]))\n        if b[i][j] != '0':\n            add_edge(node_out, t, int(b[i][j]))\n        # Connect in to out\n        add_edge(node_in, node_out, INF)\n\n# Connect nodes based on distances\nfor i in range(n):\n    for j in range(n):\n        for i1 in range(n):\n            for j1 in range(n):\n                if check((i, j)) and check((i1, j1)):\n                    if dst[i][j][i1][j1] <= dst[bad[0]][bad[1]][i1][j1]:\n                        add_edge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF)\n\n# Compute max flow\nprint(dinic())\n\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00019662656995933503, -0.00033403540146537125, -9.088346359931165e-07, -1.771655115589965e-05, -0.20676717162132263, -0.07471376657485962, -5.676981345459353e-06, -5.512236498361744e-07, -0.09234392642974854, -9.088346359931165e-07, -6.146429223008454e-05, -7.584239938296378e-06, 0.0, -3.128163257315464e-07, -0.1159902885556221, -0.2187780737876892, -1.688212614681106e-05, -0.0626184493303299, -0.0003601336502470076, -1.1472419600977446e-06, -0.12693651020526886, -0.0003802680876106024, -9.088346359931165e-07, -9.088346359931165e-07, 0.0, -5.512236498361744e-07, 0.0, -5.512236498361744e-07, -4.723352049040841e-06, -1.3856492842023727e-06, -9.13388703338569e-06, -3.128163257315464e-07, -7.896309739408025e-07, -1.27099974633893e-05, -1.9361264946837764e-07, -2.5776860184123507e-06, -4.320199877838604e-07, -3.7697225252486533e-06, 0.0, -5.512236498361744e-07, 0.0, -4.320199877838604e-07, -0.0018441593274474144, -0.7641664147377014, -0.14338745176792145, -0.3920243978500366, -0.00016766376211307943, -0.00686952518299222, 