{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nusing ld = long double;\nusing ull = unsigned long long;\n\nconst int dr[4] = {1, -1, 0, 0};\nconst int dc[4] = {0, 0, 1, -1};\n\nint N, T, rStart, cStart;\nstring gridL[20], gridS[20];\nint memo[12][12][12][12][62];\nint cap[250][250], par[250];\nint dist[20][20], vis[20][20];\n\nbool valid(int r, int c) {\n    return r >= 0 && r < N && c >= 0 && c < N && gridL[r][c] != 'Y' && gridL[r][c] != 'Z';\n}\n\nvoid bfsDist() {\n    memset(dist, 0x3f, sizeof(dist));\n    memset(vis, 0, sizeof(vis));\n    dist[rStart][cStart] = 0;\n    vis[rStart][cStart] = 1;\n    queue<int> qr, qc;\n    qr.push(rStart); qc.push(cStart);\n    while (!qr.empty()) {\n        int r = qr.front(); qr.pop();\n        int c = qc.front(); qc.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k];\n            int nc = c + dc[k];\n            if (valid(nr, nc) && !vis[nr][nc]) {\n                dist[nr][nc] = dist[r][c] + 1;\n                vis[nr][nc] = 1;\n                qr.push(nr); qc.push(nc);\n            }\n        }\n    }\n}\n\nbool dfsPath(int r1, int c1, int r2, int c2, int step) {\n    if (step > T) return false;\n    int& res = memo[r1][c1][r2][c2][step];\n    if (res != -1) return res;\n    if (r1 == r2 && c1 == c2) return res = (dist[r1][c1] >= step);\n    if (dist[r1][c1] <= step) return res = false;\n    for (int k = 0; k < 4; ++k) {\n        int nr = r1 + dr[k];\n        int nc = c1 + dc[k];\n        if (valid(nr, nc) && dfsPath(nr, nc, r2, c2, step + 1)) return res = true;\n    }\n    return res = false;\n}\n\nbool bfsFlow(int s, int t) {\n    memset(par, -1, sizeof(par));\n    par[s] = -2;\n    queue<int> q;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        for (int v = s; v <= t; ++v) {\n            if (par[v] == -1 && cap[u][v] > 0) {\n                par[v] = u;\n                q.push(v);\n            }\n        }\n    }\n    return par[t] != -1;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cout << fixed << setprecision(32);\n\n    cin >> N >> T;\n    for (int i = 0; i < N; ++i) cin >> gridS[i];\n    for (int i = 0; i < N; ++i) cin >> gridL[i];\n\n    vector<pair<int, int>> points;\n    vector<int> labC, sciC;\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (gridS[i][j] == 'Z') {\n                rStart = i; cStart = j;\n            } else if (isdigit(gridS[i][j])) {\n                points.emplace_back(i, j);\n                labC.push_back(gridL[i][j] - '0');\n                sciC.push_back(gridS[i][j] - '0');\n            }\n        }\n    }\n\n    int m = points.size();\n    memset(cap, 0, sizeof(cap));\n    for (int i = 0; i < m; ++i) {\n        cap[0][i + 1] = sciC[i];\n        cap[m + 1 + i][2 * m + 1] = labC[i];\n    }\n\n    bfsDist();\n    memset(memo, -1, sizeof(memo));\n    for (int i = 0; i < m; ++i) {\n        for (int j = 0; j < m; ++j) {\n            if (dfsPath(points[i].first, points[i].second, points[j].first, points[j].second, 0)) {\n                cap[i + 1][m + 1 + j] = 1000;\n            }\n        }\n    }\n\n    int maxFlow = 0;\n    while (bfsFlow(0, 2 * m + 1)) {\n        int sink = 2 * m + 1;\n        int flow = 1000000;\n        while (par[sink] >= 0) {\n            flow = min(flow, cap[par[sink]][sink]);\n            sink = par[sink];\n        }\n        sink = 2 * m + 1;\n        while (par[sink] >= 0) {\n            cap[par[sink]][sink] -= flow;\n            cap[sink][par[sink]] += flow;\n            sink = par[sink];\n        }\n        maxFlow += flow;\n    }\n\n    cout << maxFlow;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    if not data:\n        return\n    \n    N, T = map(int, data[0].split())\n    gridS = []\n    gridL = []\n    for i in range(1, N + 1):\n        gridS.append(data[i])\n    for i in range(N + 1, 2 * N + 1):\n        gridL.append(data[i])\n    \n    dr = [1, -1, 0, 0]\n    dc = [0, 0, 1, -1]\n    \n    def valid(r, c):\n        return 0 <= r < N and 0 <= c < N and gridL[r][c] != 'Y' and gridL[r][c] != 'Z'\n    \n    rStart, cStart = -1, -1\n    points = []\n    labC = []\n    sciC = []\n    \n    for i in range(N):\n        for j in range(N):\n            if gridS[i][j] == 'Z':\n                rStart, cStart = i, j\n            elif gridS[i][j].isdigit():\n                points.append((i, j))\n                labC.append(int(gridL[i][j]))\n                sciC.append(int(gridS[i][j]))\n    \n    m = len(points)\n    \n    # Initialize memo with -1\n    memo = [[[[[-1 for _ in range(62)] for _ in range(12)] for _ in range(12)] for _ in range(12)] for _ in range(12)]\n    \n    # BFS for distances\n    INF = 10**9\n    dist = [[INF] * N for _ in range(N)]\n    vis = [[0] * N for _ in range(N)]\n    \n    if rStart != -1 and cStart != -1:\n        dist[rStart][cStart] = 0\n        vis[rStart][cStart] = 1\n        qr, qc = deque(), deque()\n        qr.append(rStart)\n        qc.append(cStart)\n        \n        while qr:\n            r = qr.popleft()\n            c = qc.popleft()\n            for k in range(4):\n                nr = r + dr[k]\n                nc = c + dc[k]\n                if valid(nr, nc) and not vis[nr][nc]:\n                    dist[nr][nc] = dist[r][c] + 1\n                    vis[nr][nc] = 1\n                    qr.append(nr)\n                    qc.append(nc)\n    \n    def dfsPath(r1, c1, r2, c2, step):\n        if step > T:\n            return False\n        if memo[r1][c1][r2][c2][step] != -1:\n            return memo[r1][c1][r2][c2][step]\n        if r1 == r2 and c1 == c2:\n            memo[r1][c1][r2][c2][step] = (dist[r1][c1] >= step)\n            return memo[r1][c1][r2][c2][step]\n        if dist[r1][c1] <= step:\n            memo[r1][c1][r2][c2][step] = False\n            return False\n        for k in range(4):\n            nr = r1 + dr[k]\n            nc = c1 + dc[k]\n            if valid(nr, nc) and dfsPath(nr, nc, r2, c2, step + 1):\n                memo[r1][c1][r2][c2][step] = True\n                return True\n        memo[r1][c1][r2][c2][step] = False\n        return False\n    \n    # Initialize capacity matrix\n    cap = [[0] * (2 * m + 2) for _ in range(2 * m + 2)]\n    \n    for i in range(m):\n        cap[0][i + 1] = sciC[i]\n        cap[m + 1 + i][2 * m + 1] = labC[i]\n    \n    # Fill capacity based on path existence\n    for i in range(m):\n        for j in range(m):\n            if dfsPath(points[i][0], points[i][1], points[j][0], points[j][1], 0):\n                cap[i + 1][m + 1 + j] = 1000\n    \n    # Ford-Fulkerson for max flow\n    def bfsFlow(s, t):\n        par = [-1] * (2 * m + 2)\n        par[s] = -2\n        q = deque()\n        q.append(s)\n        while q:\n            u = q.popleft()\n            for v in range(s, t + 1):\n                if par[v] == -1 and cap[u][v] > 0:\n                    par[v] = u\n                    q.append(v)\n        return par[t] != -1\n    \n    maxFlow = 0\n    while bfsFlow(0, 2 * m + 1):\n        sink = 2 * m + 1\n        flow = 1000000\n        while par[sink] >= 0:\n            flow = min(flow, cap[par[sink]][sink])\n            sink = par[sink]\n        sink = 2 * m + 1\n        while par[sink] >= 0:\n            cap[par[sink]][sink] -= flow\n            cap[sink][par[sink]] += flow\n            sink = par[sink]\n        maxFlow += flow\n    \n    print(maxFlow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016234986833296716, -1.311301275563892e-06, -2.3841855067985307e-07, -0.07239610701799393, -0.0013842533808201551, -2.3841855067985307e-07, -0.002187599427998066, -0.0002169373765354976, -1.311301275563892e-06, -8.570780482841656e-05, -0.42876169085502625, -0.021590666845440865, -0.03923557698726654, -3.683499380713329e-05, -5.960462772236497e-07, -0.02205231413245201, -0.005210984963923693, -1.0609570381348021e-05, -1.7165990357170813e-05, -0.03894978389143944, -0.000558220490347594, -2.0265558760002023e-06, -0.0004231034545227885, -1.1920928244535389e-07, -2.455681169521995e-05, -1.7881377516459906e-06, -0.0013331820955500007, -0.12815599143505096, -1.1801649634435307e-05, -0.08894120156764984, -4.768370445162873e-07, -0.5283257961273193, -1.1920858014491387e-05, -1.6689286894688848e-06, -0.0005611990345641971, 0.0, -0.02978351153433323, -4.8993817472364753e-05, -1.4305104514278355e-06, -0.0250923540443182, -2.0861407392658293e-05, -2.3841855067985307e-07, -1.4185804502631072e-05, -2.9682672902708873e-05, -6.437280717364047e-06, -5.960462772236497e-07, -5.960462772236497e-07, -1.7881377516459906e-06, 0.0, -3.933898824470816e-06, -1.3112935448589269e-05, -6.318072337307967e-06, -0.0009117737063206732, -3.528532761265524e-05, -4.29152532888