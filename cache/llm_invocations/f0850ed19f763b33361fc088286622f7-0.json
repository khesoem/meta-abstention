_mul__(self, o):\n        res = Matrix(self.n)\n        for i in range(self.n):\n            for j in range(self.n):\n                for k in range(self.n):\n                    res.data[i][k] = (res.data[i][k] + self.data[i][j] * o.data[j][k]) % MOD\n        return res\n    \n    def __imul__(self, o):\n        self.data = (self * o).data\n        return self\n    \n    def fast_pow(self, p):\n        res = Matrix(self.n, 1)\n        base = Matrix(self.n)\n        for i in range(self.n):\n            for j in range(self.n):\n                base.data[i][j] = self.data[i][j]\n        \n        while p:\n            if p & 1:\n                res *= base\n            base *= base\n            p >>= 1\n        return res\n    \n    def display(self):\n        for i in range(self.n):\n            for j in range(self.n):\n                print(int(self.data[i][j]), end=' ')\n            print()\n        print()\n    \n    def __getitem__(self, i):\n        return self.data[i]\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    N = int(input_data[0])\n    K = int(input_data[1])\n    \n    if N <= K:\n        result = pow(2, N, MOD)\n        print(result)\n        return\n    \n    depth = int(math.log(N + 0.0) / math.log(K + 0.0) + 2)\n    \n    T = Matrix(K + 1, 1)\n    for j in range(K):\n        T[j][j] = 0\n        T[(j + 1) % K][j] = 1\n    \n    P = [None] * depth\n    P[0] = Matrix(K + 1, 1)\n    for i in range(1, K + 1):\n        P[0][0][i] = 1\n    \n    for i in range(1, depth):\n        P[i] = (P[i - 1] * T).fast_pow(K)\n    \n    exp_idx = 0\n    length = 1\n    while N // length >= K:\n        exp_idx += 1\n        length *= K\n    \n    vec = Matrix(K + 1, 1)\n    remaining = N\n    while remaining > 0:\n        if length <= remaining:\n            q = int(remaining // length)\n            vec *= (P[exp_idx] * T).fast_pow(q)\n            remaining -= length * q\n        exp_idx -= 1\n        length /