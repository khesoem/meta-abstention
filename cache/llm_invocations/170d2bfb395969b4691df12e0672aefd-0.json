e(); ++i) {\n        Edge &e = G[v][i];\n        if (e.cap > 0 && level[v] < level[e.to]) {\n            int d = dfs_flow(e.to, min(f, e.cap));\n            if (d > 0) {\n                e.cap -= d;\n                G[e.to][e.rev].cap += d;\n                return d;\n            }\n        }\n    }\n    return 0;\n}\n\nint max_flow() {\n    int flow = 0;\n    while (bfs_flow()) {\n        memset(iter, 0, sizeof(iter));\n        int f;\n        while ((f = dfs_flow(S, 1e9)) > 0)\n            flow += f;\n    }\n    return flow;\n}\n\nint n, t;\n\nvoid wk(int a, int b) {\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            dd[i][j] = 100000;\n    deque<pair<int,int>> q;\n    dd[a][b] = 0;\n    q.push_back(make_pair(a,b));\n    while (!q.empty()) {\n        int x = q.front().first, y = q.front().second;\n        q.pop_front();\n        for (int i = 0; i < np[x][y].size(); ++i)\n            for (int j = 0; j < ns[a][b].size(); ++j)\n                add_edge(ns[a][b][j], np[x][y][i], 1);\n        if (dd[x][y] == ir[x][y]) continue;\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (sc[nx][ny] != -1 && dd[nx][ny] > dd[x][y] + 1 && dd[x][y] + 1 <= ir[nx][ny]) {\n                dd[nx][ny] = dd[x][y] + 1;\n                q.push_back(make_pair(nx,ny));\n            }\n        }\n    }\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            ir[i][j] = t;\n    for (int i = 1; i <= n; ++i)\n        scanf(\"%s\", s[i] + 1);\n    for (int i = 1; i <= n; ++i)\n        scanf(\"%s\", p[i] + 1);\n    int rx, ry;\n    sp = 1; pp = 1000;\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if (s[i][j] == 'Z' || s[i][j] == 'Y')\n                sc[i][j] = -1, ir[i][j] = 0;\n            if (s[i][j] == 'Z')\n                rx = i, ry = j, ir[i][j] = 0;\n            if ('0' <= s[i][j] && s[i][j] <= '9')\n                sc[i][j] = s[i][j] - '0';\n            for (int k = 0; k < sc[i][j]; ++k)\n                ns[i][j].push_back(sp++);\n        }\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= n; ++j) {\n            if ('0' <= p[i][j] && p[i][j] <= '9')\n                pc[i][j] = p[i][j] - '0';\n            for (int k = 0; k < pc[i][j]; ++k)\n                np[i][j].push_back(pp++);\n        }\n    }\n    deque<pair<int,int>> q;\n    q.push_back(make_pair(rx, ry));\n    while (!q.empty()) {\n        rx = q.front().first; ry = q.front().second;\n        q.pop_front();\n        int nx, ny;\n        for (int d = 0; d < 4; ++d) {\n            nx = rx + dx[d];\n            ny = ry + dy[d];\n            if (ir[nx][ny] > ir[rx][ry] + 1 && sc[nx][ny] != -1) {\n                ir[nx][ny] = ir[rx][ry] + 1;\n                q.push_back(make_pair(nx, ny));\n            }\n        }\n    }\n    S = 0; T = 2000;\n    for (int i = 1; i < sp; ++i)\n        add_edge(S, i, 1);\n    for (int i = 1000; i < pp; ++i)\n        add_edge(i, T, 1);\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j)\n            if (sc[i][j] > 0)\n                wk(i, j);\n    printf(\"%d\", max_flow());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nsys.setrecursionlimit(10000)\n\n# Global variables\nn = 0\nt = 0\nir = [[0]*20 for _ in range(20)]\nsc = [[0]*20 for _ in range(20)]\npc = [[0]*20 for _ in range(20)]\ns = [['']*20 for _ in range(20)]\np = [['']*20 for _ in range(20)]\ndd = [[0]*20 for _ in range(20)]\ndx = [0, 1, -1, 0]\ndy = [1, 0, 0, -1]\nns = [[[] for _ in range(20)] for __ in range(20)]\nnp = [[[] for _ in range(20)] for __ in range(20)]\nsp = 1\npp = 1000\nS = 0\nT = 2000\nG = [[] for _ in range(2001)]\nlevel = [0]*2001\niter = [0]*2001\n\ndef add_edge(fr, to, cap):\n    G[fr].append([to, len(G[to]), cap])\n    G[to].append([fr, len(G[fr])-1, 0])\n\ndef bfs_flow():\n    global level\n    level = [-1]*2001\n    q = deque()\n    level[S] = 0\n    q.append(S)\n    while q:\n        v = q.popleft()\n        for e in G[v]:\n            if e[2] > 0 and level[e[0]] < 0:\n                level[e[0]] = level[v] + 1\n                q.append(e[0])\n    return level[T] >= 0\n\ndef dfs_flow(v, f):\n    if v == T:\n        return f\n    for i in range(iter[v], len(G[v])):\n        e = G[v][i]\n        if e[2] > 0 and level[v] < level[e[0]]:\n            d = dfs_flow(e[0], min(f, e[2]))\n            if d > 0:\n                e[2] -= d\n                G[e[0]][e[1]][2] += d\n                return d\n        iter[v] += 1\n    return 0\n\ndef max_flow():\n    flow = 0\n    while bfs_flow():\n        global iter\n        iter = [0]*2001\n        while True:\n            f = dfs_flow(S, 10**9)\n            if f == 0:\n                break\n            flow += f\n    return flow\n\ndef wk(a, b):\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            dd[i][j] = 100000\n    q = deque()\n    dd[a][b] = 0\n    q.append((a,b))\n    while q:\n        x, y = q.popleft()\n        # add edges from source nodes at (a,b) to target nodes at (x,y)\n        for src in ns[a][b]:\n            for dst in np[x][y]:\n                add_edge(src, dst, 1)\n        if dd[x][y] == ir[x][y]:\n            continue\n        for d in range(4):\n            nx = x + dx[d]\n            ny = y + dy[d]\n            if 1 <= nx <= n and 1 <= ny <= n:\n                if sc[nx][ny] != -1 and dd[nx][ny] > dd[x][y] + 1 and dd[x][y] + 1 <= ir[nx][ny]:\n                    dd[nx][ny] = dd[x][y] + 1\n                    q.append((nx, ny))\n\ndef main():\n    global n, t, sp, pp, ir, sc, pc, s, p, ns, np, G, level, iter\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    # initialize ir\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            ir[i][j] = t\n    # read s\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            s[i][j] = line[j-1]\n    # read p\n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            p[i][j] = line[j-1]\n    rx = ry = 0\n    sp = 1\n    pp = 1000\n    # process s\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if s[i][j] == 'Z' or s[i][j] == 'Y':\n                sc[i][j] = -1\n                ir[i][j] = 0\n            if s[i][j] == 'Z':\n                rx, ry = i, j\n                ir[i][j] = 0\n            if '0' <= s[i][j] <= '9':\n                sc[i][j] = int(s[i][j])\n            for k in range(sc[i][j]):\n                ns[i][j].append(sp)\n                sp += 1\n    # process p\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '0' <= p[i][j] <= '9':\n                pc[i][j] = int(p[i][j])\n            for k in range(pc[i][j]):\n                np[i][j].append(pp)\n                pp += 1\n    # BFS from Z to compute ir (time to reach each cell)\n    q = deque()\n    q.append((rx, ry))\n    while q:\n        rx, ry = q.popleft()\n        for d in range(4):\n            nx = rx + dx[d]\n            ny = ry + dy[d]\n            if 1 <= nx <= n and 1 <= ny <= n:\n                if ir[nx][ny] > ir[rx][ry] + 1 and sc[nx][ny] != -1:\n                    ir[nx][ny] = ir[rx][ry] + 1\n                    q.append((nx, ny))\n    # build graph\n    S = 0\n    T = 2000\n    G = [[] for _ in range(2001)]\n    for i in range(1, sp):\n        add_edge(S, i, 1)\n    for i in range(1000, pp):\n        add_edge(i, T, 1)\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if sc[i][j] > 0:\n                wk(i, j)\n    print(max_flow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence