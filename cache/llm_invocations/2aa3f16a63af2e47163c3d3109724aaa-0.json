ange(n + 1):\n        for j in range(n + 1):\n            if i == 0 or j == 0:\n                c[i][j] = 1\n            else:\n                c[i][j] = (c[i - 1][j] + c[i][j - 1]) % mod\n    \n    # a[i] = (count, sum)\n    a = [(0, 0) for _ in range(m + 1)]\n    a[0] = (1, 0)\n    \n    for i in range(1, m + 1):\n        for j in range(i):\n            cnt1, sum1 = a[j]\n            cnt2, sum2 = a[i - 1 - j]\n            \n            cur_cnt = (cnt1 * cnt2) % mod\n            cur_sum = (sum1 * cnt2 + cnt1 * sum2) % mod\n            \n            # ss(x) = x * (x + 1) // 2\n            ss_j = j * (j + 1) // 2\n            ss_other = (i - 1 - j) * (i - 1 - j + 1) // 2\n            \n            cur_sum = (cur_sum * (i + 1) + (ss_j + ss_other) * cur_cnt) % mod\n            cur_cnt = (cur_cnt * (i + 1)) % mod\n            cur_cnt = (cur_cnt * c[j][i - 1 - j]) % mod\n            cur_sum = (cur_sum * c[j][i - 1 - j]) % mod\n            \n            a[i] = ((a[i][0] + cur_cnt) % mod, (a[i][1] + cur_sum) % mod)\n    \n    # d[i][j] = (count, sum)\n    d = [[(0, 0) for _ in range(m + 1)] for _ in range(n + 2)]\n    d[0][0] = (1, 0)\n    \n    for i in range(n + 2):\n        for j in range(m + 1):\n            max_k = min(n - i, m - j)\n            for k in range(max_k + 1):\n                cnt1, sum1 = a[k]\n                cnt2, sum2 = d[i][j]\n                \n                cur_cnt = (cnt1 * cnt2) % mod\n                cur_sum = (sum1 * cnt2 + cnt1 * sum2) % mod\n                \n                cur_cnt = (cur_cnt * c[j][k]) % mod\n                cur_sum = (cur_sum * c[j][k]) % mod\n                \n                new_i = i + k + 1\n                new_j = j + k\n                if new_i <= n + 1 and new_j <= m:\n                    d[new_i][new_j] = ((d[new_i][new_j][0] + cur_cnt) % mod, (d[new_i][new_j][1] + cur_sum) % mod)\n    \n    print(d[n + 1][m][1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "