n        if (c != 'B') {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        mp.put(state, res);\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        r = sc.nextInt();\n        c = sc.nextInt();\n        sc.nextLine(); // consume newline\n        int maxN = 2 * (r + c);\n        for (int i = 0; i <= maxN; i++) {\n            for (int j = 0; j <= maxN; j++) {\n                if (j == 0) C[i][j] = 1;\n                else if (i == 0) C[i][j] = 0;\n                else C[i][j] = C[i - 1][j] + C[i - 1][j - 1];\n            }\n        }\n        long total = C[r + c][r] * C[r + c][r];\n        {\n            long x = 0, y = 0;\n            int v1 = r + c, v2 = r + c;\n            while (v1 >= r && v2 >= r) {\n                if (x > y) {\n                    long cur1 = C[v1][r] - C[v1 - 1][r];\n                    long sum2 = C[v2][r];\n                    y += cur1 * sum2;\n                    v1--;\n                } else {\n                    long sum1 = C[v1][r];\n                    long cur2 = C[v2][r] - C[v2 - 1][r];\n                    x += sum1 * cur2;\n                    v2--;\n                }\n            }\n            best = Math.abs(x - y);\n        }\n        dfs(0, 0, r + c, r + c);\n        String line = sc.nextLine();\n        s = line.toCharArray();\n        cntA[0] = cntB[0] = 0;\n        for (int i = 0; i < 2 * (r + c); i++) {\n            cntA[i + 1] = cntA[i] + (s[i] == 'A' ? 1 : 0);\n            cntB[i + 1] = cntB[i] + (s[i] == 'B' ? 1 : 0);\n        }\n        long ans = solve(0, 0, r + c, r + c);\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.3141166567802429, -1.6689160474925302e-05, -1.1920928244535389e-07, -3.576278118089249e-07, -5.364274329622276e-05, 