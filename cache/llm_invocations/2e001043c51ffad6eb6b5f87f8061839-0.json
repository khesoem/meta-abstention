xt"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nfrom sortedcontainers import SortedDict, SortedSet\n\ndef main():\n    x, y, n = map(int, input().split())\n    \n    g = math.gcd(x, y)\n    x //= g\n    y //= g\n    q = x // y\n    r = x % y\n    \n    store = {}\n    \n    def record(a):\n        g = math.gcd(a, b)\n        num = b // g\n        den = a // g\n        key = abs(u - a * z) / t\n        if key not in store:\n            store[key] = set()\n        store[key].add((num, den))\n    \n    for b_val in range(1, n + 1):\n        b = b_val\n        g = math.gcd(y, b)\n        c = b // g\n        z = y // g\n        t = b * z\n        u = q * t + r * c\n        \n        record(u // z)\n        \n        if u % z:\n            record((u + z - 1) // z)\n    \n    # Get the smallest key and then the first element in its set\n    sorted_keys = sorted(store.keys())\n    first_key = sorted_keys[0]\n    first_set = store[first_key]\n    first_pair = min(first_set)  # Get the smallest pair lexicographically\n    \n    print(f\"{first_pair[1]}/{first_pair[0]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00012838016846217215, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0016074366867542267, -0.011184142902493477, -0.0013266343157738447, -0.00015960850578267127, -0.7207335829734802, -9.154854342341423e-05, -7.152555099310121e-07, -0.0004349001101218164, -0.8985280394554138, -0.5793420672416687, -0.00035982808913104236, -0.199189692735672, -0.22605574131011963, -0.09017559140920639, -0.5322638154029846, -4.7444173105759546e-05, -1.1920922133867862e-06, -0.0742194876074791, -2.145764938177308e-06, -5.960462772236497e-07, -3.6954811548639555e-06, -1.4305104514278355e-06, -3.576278118089249e-07, -2.455681169521995e-05, -3.40932747349143e-05, -9.536738616588991e-07, -1.1205610462639015e-05, -8.344646857949556e-07, -1.585470999998506e-05, -2.7894584491150454e-0