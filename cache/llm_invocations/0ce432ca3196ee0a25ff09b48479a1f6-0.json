low) {\n        int pathCost = 0;\n        for (int cur = to; cur != from; cur = p[cur]) {\n            flow = std::min(flow, res[p[cur]][cur]);\n        }\n        for (; to != from; to = p[to]) {\n            res[p[to]][to] -= flow;\n            res[to][p[to]] += flow;\n            pathCost += cost[p[to]][to] * flow;\n        }\n        return {flow, pathCost};\n    }\n\n    std::vector<int> getMinCostMaxFlow() {\n        int flow = 0;\n        int totalCost = 0;\n        while (findCheapestPath()) {\n            auto result = augmentPath(src, sink, INT_MAX);\n            flow += result[0];\n            totalCost += result[1];\n        }\n        return {flow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n; cin >> n;\n    string s; cin >> s;\n    vector<char> string(s.begin(), s.end());\n    int letters = 'z' - 'a' + 1;\n    vector<int> letCount(letters, 0);\n    for (int i = 0; i < n; ++i) {\n        letCount[string[i] - 'a']++;\n    }\n    vector<int> b(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> b[i];\n    }\n\n    int source = 0;\n    int charOffSet = 1;\n    int pairOffSet = charOffSet + letters;\n    int sinkOffSet = pairOffSet + n / 2;\n    int sink = sinkOffSet;\n    int vNum = sinkOffSet + 1;\n\n    Graph g(vNum, source, sink);\n\n    // Source -> Letters -> Pairs\n    for (int i = 0; i < letters; ++i) {\n        g.addEdge(source, charOffSet + i, letCount[i], 0);\n        for (int j = 0; j < n / 2; ++j) {\n            char c1 = string[j];\n            char c2 = string[n - j - 1];\n            if (c1 == 'a' + i) {\n                if (c1 == c2) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -std::max(b[j], b[n - j - 1]));\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[j]);\n                }\n            } else {\n                if (c2 == 'a' + i) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -