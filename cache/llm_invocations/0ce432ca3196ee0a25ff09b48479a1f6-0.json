  vector<int> augmentPath(int from, int to, int flow) {\n        int pathCost = 0;\n        for (int cur = to; cur != from; cur = p[cur]) {\n            flow = min(flow, res[p[cur]][cur]);\n        }\n        for (int cur = to; cur != from; cur = p[cur]) {\n            res[p[cur]][cur] -= flow;\n            res[cur][p[cur]] += flow;\n            pathCost += cost[p[cur]][cur] * flow;\n        }\n        return {flow, pathCost};\n    }\n\n    vector<int> getMinCostMaxFlow() {\n        int flow = 0;\n        int totalCost = 0;\n        while (findCheapestPath()) {\n            vector<int> result = augmentPath(src, sink, INT_MAX);\n            flow += result[0];\n            totalCost += result[1];\n        }\n        return {flow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n;\n    cin >> n;\n    string s;\n    cin >> s;\n    int letters = 'z' - 'a' + 1;\n    vector<int> letCount(letters, 0);\n    for (int i = 0; i < n; ++i) {\n        letCount[s[i] - 'a']++;\n    }\n    vector<int> b(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> b[i];\n    }\n\n    int source = 0;\n    int charOffSet = 1;\n    int pairOffSet = charOffSet + letters;\n    int sinkOffSet = pairOffSet + n / 2;\n    int sink = sinkOffSet;\n    int vNum = sinkOffSet + 1;\n\n    Graph g(vNum, source, sink);\n\n    for (int i = 0; i < letters; ++i) {\n        g.addEdge(source, charOffSet + i, letCount[i], 0);\n        for (int j = 0; j < n / 2; ++j) {\n            char c1 = s[j];\n            char c2 = s[n - j - 1];\n            if (c1 == 'a' + i) {\n                if (c1 == c2) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -max(b[j], b[n - j - 1]));\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[j]);\n                }\n            } else {\n                if (c2 == 'a' + i) {\n                    g.addEdge(charOffSet + i, pairOffSet + j, 1, -b[n - j - 1]);\n          