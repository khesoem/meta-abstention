 buildBinomial(n);\n        \n        long[] polyP = new long[2 * n + 1];\n        long[] polyQ = new long[2 * n + 1];\n        \n        polyP[n] = modExp(2, n);\n        \n        for (int step = 0; step < n; step++) {\n            for (int deg = 2 * n; deg >= 1; deg--) {\n                polyP[deg] = (polyP[deg] - polyP[deg - 1]) % MOD;\n            }\n        }\n        \n        long[] resultPoly = polyP.clone();\n        long inv2 = (MOD + 1) / 2;\n        \n        for (int iter = 1; iter <= n - k; iter++) {\n            // Divide by 2x: shift right and multiply by inv2\n            for (int deg = 0; deg < 2 * n; deg++) {\n                polyQ[deg] = polyP[deg + 1] * inv2 % MOD;\n            }\n            polyQ[2 * n] = 0;\n            \n            // Divide by (1 - x): prefix sums\n            for (int deg = 1; deg <= 2 * n; deg++) {\n                polyQ[deg] = (polyQ[deg] + polyQ[deg - 1]) % MOD;\n            }\n            \n            // Update polyP = polyQ - polyP\n            for (int deg = 0; deg <= 2 * n; deg++) {\n                polyP[deg] = (polyQ[deg] - polyP[deg]) % MOD;\n            }\n            \n            long coeff = binom[n][iter];\n            for (int deg = 0; deg <= 2 * n; deg++) {\n                resultPoly[deg] = (resultPoly[deg] + coeff * polyP[deg]) % MOD;\n            }\n        }\n        \n        // Integrate polynomial\n        long integralValue = 0;\n        for (int deg = 0; deg <= 2 * n; deg++) {\n            integralValue = (integralValue + resultPoly[deg] * modExp(deg + 1, MOD - 2)) % MOD;\n        }\n        \n        integralValue = (integralValue * L % MOD + MOD) % MOD;\n        System.out.println(integralValue);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef build_binomial(maxN):\n    binom = [[0] * (maxN + 1) for _ in range(maxN + 1)]\n    for i in range(maxN + 1):\n        binom[i][0] = 1\n        for j in range(1, i + 1):\n            binom[i][j] = (binom[i-1][j] + binom[i-1][j-1]) % MOD\n    return binom\n\ndef mod_exp(base, exp):\n    res = 1\n    base %= MOD\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    k = int(data[1])\n    L = int(data[2])\n    \n    binom = build_binomial(n)\n    \n    polyP = [0] * (2 * n + 1)\n    polyQ = [0] * (2 * n + 1)\n    \n    polyP[n] = mod_exp(2, n)\n    \n    for step in range(n):\n        for deg in range(2 * n, 0, -1):\n            polyP[deg] = (polyP[deg] - polyP[deg - 1]) % MOD\n    \n    resultPoly = polyP.copy()\n    inv2 = (MOD + 1) // 2\n    \n    for iter_count in range(1, n - k + 1):\n        # Divide by 2x: shift right and multiply by inv2\n        for deg in range(2 * n):\n            polyQ[deg] = polyP[deg + 1] * inv2 % MOD\n        polyQ[2 * n] = 0\n        \n        # Divide by (1 - x): prefix sums\n        for deg in range(1, 2 * n + 1):\n            polyQ[deg] = (polyQ[deg] + polyQ[deg - 1]) % MOD\n        \n        # Update polyP = polyQ - polyP\n        for deg in range(2 * n + 1):\n            polyP[deg] = (polyQ[deg] - polyP[deg]) % MOD\n        \n        coeff = binom[n][iter_count]\n        for deg in range(2 * n + 1):\n            resultPoly[deg] = (resultPoly[deg] + coeff * polyP[deg]) % MOD\n    \n    # Integrate polynomial\n    integral_value = 0\n    for deg in range(2 * n + 1):\n        integral_value = (integral_value + resultPoly[deg] * mod_exp(deg + 1, MOD - 2)) % MOD\n    \n    integral_value = (integral_value * L % MOD + MOD) % MOD\n    print(integral_value)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.402622577501461e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -0.0205