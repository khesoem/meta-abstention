, i - 1)) % M;\n            e = (e + (w * (w + 1) / 2) * t) % M;\n        }\n        sumE = (sumE + e) % M;\n    }\n    cout << ans * sumE % M << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(10**6)\n\nM = 0\nbinomMemo = {}\n\ndef modPow(a, b):\n    if b == 0:\n        return 1 % M\n    if b & 1:\n        return modPow(a, b - 1) * a % M\n    t = modPow(a, b >> 1)\n    return t * t % M\n\ndef modInv(a):\n    return modPow(a, M - 2)\n\ndef binom(n, k):\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    key = n * 1000 + k\n    if key in binomMemo:\n        return binomMemo[key]\n    res = (binom(n - 1, k - 1) + binom(n - 1, k)) % M\n    binomMemo[key] = res\n    return res\n\ndef f(c, p):\n    if p == 0:\n        return 1\n    return modPow(c + 1, p - 1) * (c + 1 - p) % M\n\ndef main():\n    global M\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    c = int(data[0])\n    p = int(data[1])\n    M = int(data[2])\n    ans = f(c, p) * modPow(2, p) % M\n    sumE = 0\n    for i in range(1, p + 1):\n        e = 0\n        for w in range(1, i):\n            t = binom(i - 1, w) * f(w, w) % M\n            t = t * f(c - w - 1, i - 1 - w) % M\n            t = t * modInv(modPow(c + 1, i - 1)) % M\n            e = (e + (w * (w + 1) // 2) * t) % M\n        sumE = (sumE + e) % M\n    print(ans * sumE % M)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.344646857949556e-07, -2.50339189733495e-06, 0.0, -0.00015877417172305286, -0.00012432756193447858, 0.0, -0.023248475044965744, -0.0006277974462136626, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.1757580041885376, -0.00016652150952722877, -0.002692409558221698, -0.005243951920419931, -0.0803973376750946, -7.70062324590981e-05, -0.006