\t\t\tmatr<N,M> out=*this;\n\t\t\t\tfor(int i=0; i<N; i++)\n\t\t\t\t\tfor(int j=0; j<M; j++)out[i][j]=mult(out[i][j],x);\n\t\t\t\treturn out;\n\t\t\t}\n\t\t\ttemplate<int X>\n\t\t\tfriend matr<N,M> operator *(const matr<N,X> a,const matr<X,M> b)\n\t\t\t{\n\t\t\t\tmatr<N,M> out;\n\t\t\t\tout.init();\n\t\t\t\tfor(int i=0; i<N; i++)\n\t\t\t\t{\n\t\t\t\t\tfor(int j=0; j<X; j++)\n\t\t\t\t\t{\n\t\t\t\t\t\tif(a[i][j])\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor(int k=0; k<M; k++)\n\t\t\t\t\t\t\t\tout[i][k]=add(out[i][k],mult(a[i][j],b[j][k]));\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn out;\n\t\t\t}\n\t};\n};\nusing namespace matrix;\ntypedef long long ll;\nll n;\nint K;\nvector<int> digit;\nmatr<35,35> A[65][35],S[65][35],P[65][35],ans;\nint main()\n{\n\tscanf(\"%lld%d\",&n,&K);\n\tfor(int i=0;i<K;i++)\n\t{\n\t\tA[0][i].iden();\n\t\tfor(int j=0;j<=K;j++)A[0][i][i][j]=1;\n\t}\n\tll len=K;\n\tfor(int i=1;len<=n;i++,len*=K)\n\t{\n\t\tS[i-1][K-1]=A[i-1][K-1];\n\t\tfor(int j=K-2;j>=0;j--) S[i-1][j]=A[i-1][j]*S[i-1][j+1];\n        P[i-1][0]=A[i-1][0];\n        for(int j=1;j<K;j++)P[i-1][j]=P[i-1][j-1]*A[i-1][j];\n        A[i][0]=S[i-1][0];\n        for(int j=1;j<K;j++)A[i][j]=S[i-1][j]*P[i-1][j-1];\n\t}\n\twhile(n)\n\t{\n        digit.push_back(n%K);\n        n/=K;\n    }\n    int s=0;\n    ans.iden();\n    for(int i=digit.size()-1;i>=0;i--)\n\t{\n        for(int j=0;j<digit[i];j++)\n            ans=ans*A[i][(j+s)%K];\n        s=(s+digit[i])%K;\n    }\n\tint res=1;\n\tfor(int i=0;i<K;i++)res=add(res,ans[i][K]);\n\tprintf(\"%d\\n\",res);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nmod = 1000000007\n\ndef add(a, b):\n    a += b\n    if a >= mod:\n        a -= mod\n    return a\n\ndef mult(a, b):\n    t = a * b\n    if t >= mod:\n        t %= mod\n    return t\n\nclass Matr:\n    def __init__(self, N, M):\n        self.N = N\n        self.M = M\n        self.dat = [[0] * M for _ in range(N)]\n    \n    def init(self):\n        self.dat = [[0] * self.M for _ in range(self.N)]\n    \n    def iden(self):\n        self.init()\n        for i in range(min(self.N, self.M)):\n            self.dat[i][i] = 1\n    \n    def trans(self):\n        out = Matr(self.M, self.N)\n        for i in range(self.M):\n            for j in range(self.N):\n                out.dat[i][j] = self.dat[j][i]\n        return out\n    \n    def __getitem__(self, x):\n        return self.dat[x]\n    \n    def __add__(self, a):\n        out = Matr(self.N, self.M)\n        for i in range(self.N):\n            for j in range(self.M):\n                out.dat[i][j] = add(self.dat[i][j], a.dat[i][j])\n        return out\n    \n    def __mul__(self, x):\n        out = Matr(self.N, self.M)\n        for i in range(self.N):\n            for j in range(self.M):\n                out.dat[i][j] = mult(self.dat[i][j], x)\n        return out\n    \n    def mat_mult(self, b):\n        assert self.M == b.N\n        out = Matr(self.N, b.M)\n        out.init()\n        for i in range(self.N):\n            for j in range(self.M):\n                if self.dat[i][j]:\n                    for k in range(b.M):\n                        out.dat[i][k] = add(out.dat[i][k], mult(self.dat[i][j], b.dat[j][k]))\n        return out\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    K = int(data[1])\n    \n    digit = []\n    \n    A = [[[Matr(35, 35) for _ in range(35)] for __ in range(65)] for ___ in range(1)]\n    S = [[[Matr(35, 35) for _ in range(35)] for __ in range(65)] for ___ in range(1)]\n    P = [[[Matr(35, 35) for _ in range(35)] for __ in range(65)] for ___ in range(1)]\n    \n    for i in range(K):\n        A[0][i].iden()\n        for j in range(K + 1):\n            A[0][i].dat[i][j] = 1\n    \n    len_val = K\n    i = 1\n    while len_val <= n:\n        S[0][i-1][K-1] = A[0][i-1][K-1]\n        for j in range(K-2, -1, -1):\n            S[0][i-1][j] = A[0][i-1][j].mat_mult(S[0][i-1][j+1])\n        \n        P[0][i-1][0] = A[0][i-1][0]\n        for j in range(1, K):\n            P[0][i-1][j] = P[0][i-1][j-1].mat_mult(A[0][i-1][j])\n        \n        A[0][i][0] = S[0][i-1][0]\n        for j in range(1, K):\n            A[0][i][j] = S[0][i-1][j].mat_mult(P[0][i-1][j-1])\n        \n        i += 1\n        len_val *= K\n    \n    while n > 0:\n        digit.append(n % K)\n        n //= K\n    \n    s = 0\n    ans = Matr(35, 35)\n    ans.iden()\n    \n    for i in range(len(digit)-1, -1, -1):\n        for j in range(digit[i]):\n            ans = ans.mat_mult(A[0][i][(j + s) % K])\n        s = (s + digit[i]) % K\n    \n    res = 1\n    for i in range(K):\n        res = add(res, ans.dat[i][K])\n    \n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00015841660206206143, -1.4305104514278355e-06, -7.152555099310121e-07, -0.04204481095075607, -0.00022802136663813144, -0.0006306566647253931, -0.02181066945195198, -4.017272294731811e-05, 0.0, 0.0, -1.1920928244535389e-07, -0.0028072495479136705, 0.0, -8.344646857949556e-07, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.8371408916427754e-05, -3.3378546504536644e-06, -0.0009118927991949022, -1.5735502529423684e-05, -5.006777428206988e-06, -9.059865078597795e-06, -2.7418097943154862e-06, -3.099436753473128e-06, -1.0728830375228426e-06, -0.00012206286191940308, -0.06994190067052841, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -2.50339189733495e-06, -1.1920922133867862e-06, 0.0, -1.4305104514278355e-06, -1.0728830375228426e-06, -3.576278118089249e-07, -2.3841830625315197e-06, -2.3841830625315197e-06, -5.960462772236497e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -5.960462772236497e-07, -5.364403477869928e-06, -1.311301275563892e-06, -0.0002603192115202546, -5.96046277