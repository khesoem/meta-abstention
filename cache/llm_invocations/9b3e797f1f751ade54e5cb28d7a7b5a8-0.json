esult = 1\n    base %= mod\n    while exp > 0:\n        if exp & 1:\n            result = (result * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return result\n\ndef countBits(x: int) -> int:\n    cnt = 0\n    while x:\n        cnt += x & 1\n        x >>= 1\n    return cnt\n\ndef getHash(state: List[bool], sz: int) -> int:\n    pos = 0\n    for bit in state:\n        pos = (pos * 2 + (1 if bit else 0)) % sz\n    return pos\n\ndef makeBit(n: int) -> List[bool]:\n    res = [False] * 128\n    res[n] = True\n    return res\n\ndef findOrInsert(state: List[bool], hashTable: List[List[bool]], hashIndex: List[int], totalStates: int, sz: int) -> int:\n    pos = getHash(state, sz)\n    while True:\n        if hashTable[pos] == state:\n            return hashIndex[pos]\n        if not hashTable[pos]:  # empty list\n            hashTable[pos] = state[:]\n            bfs_states.append(state[:])\n            hashIndex[pos] = totalStates\n            return totalStates\n        pos = (pos + 1) % sz\n\ndef precompute(n: int):\n    global bfs_states, transition, match_state\n    N = 1 << n\n    bfs_states = []\n    bfs_states.append([False] * 128)\n    bfs_states[0][0] = True\n\n    fixedSize = [[False] * 128 for _ in range(n + 1)]\n    for mask in range(N):\n        cnt = countBits(mask)\n        fixedSize[cnt][mask] = True\n\n    hashTableSize = 0\n    if n <= 6:\n        sizes = [0, 5, 11, 37, 137, 821, 7529, 164184]\n        hashTableSize = sizes[n]\n\n    hashTable = [[] for _ in range(hashTableSize)]\n    hashIndex = [-1] * hashTableSize\n    totalStates = 1\n\n    nextMask = [[-1] * N for _ in range(N)]\n    match_state = [0] * N\n\n    for k in range(totalStates):\n        state = bfs_states[k]\n        predHall = [[False] * 128 for _ in range(n)]\n\n        for mask in range(N):\n            if state[mask]:\n                for i in range(n):\n                    predHall[i][mask | (1 << i)] = True\n\n        for mask in range(N):\n            nextState = state[:]\n            for i in range(n):\n                if mask & (1 << i):\n                    for j in range(128):\n                        if predHall[i][j]:\n                            nextState[j] = True\n            nextMask[mask][k] = findOrInsert(nextState, hashTable, hashIndex, totalStates, hashTableSize)\n\n        for i in range(n, -1, -1):\n            if any(state[j] and fixedSize[i][j] for j in range(128)):\n                match_state[k] = i\n                break\n\n    transition = nextMask\n    match_state = match_state[:totalStates]\n\ndef computeExpectedMatching(n: int, m: int, probMatrix: List[List[int]]) -> int:\n    global bfs_states, transition, match_state\n    N = 1 << n\n    totalStates = len(bfs_states)\n\n    dp_prev = [0] * totalStates\n    dp_prev[0] = 1\n\n    for j in range(m):\n        dp_cur = [0] * totalStates\n\n        for mask in range(N):\n            probability = 1\n            for i in range(n):\n                if mask & (1 << i):\n                    probability = (probability * probMatrix[i][j]) % mod\n                else:\n                    probability = (probability * (mod - probMatrix[i][j])) % mod\n\n            for k in range(totalStates):\n                nextStateIndex = transition[mask][k]\n                dp_cur[nextStateIndex] = (dp_cur[nextStateIndex] + probability * dp_prev[k]) % mod\n\n        dp_prev = dp_cur\n\n    result = 0\n    for k in range(totalStates):\n        if match_state[k] == n:\n            result = (result + dp_prev[k]) % mod\n    return result\n\ndef main():\n    global bfs_states, transition, match_state\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    m = n\n\n    precompute(n)\n\n    p = [[0] * m for _ in range(n)]\n    inv100 = modPow(100, mod - 2)\n    idx = 1\n    for i in range(n):\n        for j in range(m):\n            val = int(data[idx])\n            idx += 1\n            p[i][j] = (val * inv100) % mod\n\n   