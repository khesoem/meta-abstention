v_coef[i];\n    }\n\n    for (int idx = 0; idx < n; ++idx) {\n        long double res = 0.0L;\n        if (prob[idx] > 0.005L) {\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << idx)) continue;\n                if (popcount[mask] >= K) continue;\n                res += inv_coef[popcount[mask]] / (1.0L - subset_sum[mask]);\n            }\n        }\n        printf(\"%.12lf \", (double)(prob[idx] * res));\n    }\n    puts(\"\");\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    K = int(next(it))\n    \n    prob = [0.0] * n\n    for i in range(n):\n        prob[i] = float(next(it))\n    \n    # Initialize comb table\n    comb = [[0.0] * 21 for _ in range(21)]\n    comb[0][0] = 1.0\n    for i in range(1, n + 1):\n        comb[i][0] = 1.0\n        for j in range(1, i + 1):\n            comb[i][j] = comb[i-1][j-1] + comb[i-1][j]\n    \n    # Precompute popcount and subset_sum\n    size = 1 << n\n    popcount = [0] * size\n    subset_sum = [0.0] * size\n    \n    for mask in range(size):\n        popcount[mask] = bin(mask).count('1')\n        total = 0.0\n        for idx in range(n):\n            if mask & (1 << idx):\n                total += prob[idx]\n        subset_sum[mask] = total\n    \n    # Compute inv_coef\n    inv_coef = [0.0] * 21\n    inv_coef[K-1] = 1.0\n    for i in range(K - 2, -1, -1):\n        inv_coef[i] = 0.0\n        for j in range(i + 1, K):\n            inv_coef[i] -= comb[n - 1 - i][j - i] * inv_coef[j]\n        inv_coef[i] = 1.0 - inv_coef[i]\n    \n    # Calculate result for each index\n    res_list = []\n    for idx in range(n):\n        res = 0.0\n        if prob[idx] > 0.005:\n            for mask in range(size