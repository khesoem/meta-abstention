\nint log2Val[262155];\n\nint getPowerOfTwo(int x) {\n    int cnt = 0;\n    while ((x & 1) == 0 && x) {\n        ++cnt;\n        x >>= 1;\n    }\n    return cnt;\n}\n\nint powerCount[262155];\n\nint comb(int N, int M) {\n    return (long long)factorial[N] * invFactorial[M] % MOD * invFactorial[N - M] % MOD;\n}\n\nint solveRec(int N, int K) {\n    if (N == 0) return 1;\n    if (K == 0) return 0;\n    if (memo[N][K] != -1) return memo[N][K];\n    \n    int step = 1 << log2Val[N];\n    int sum = 0;\n    for (int i = N; i >= step; i -= 2) {\n        sum = (sum + (long long)comb(N, i) * solveRec(N - i, K - 1) % MOD * K) % MOD;\n    }\n    return memo[N][K] = sum;\n}\n\nvector<pair<int, int>> seq;\n\nint solveIter(int N, int K) {\n    queue<pair<int, int>> q;\n    q.emplace(N, K);\n    \n    while (!q.empty()) {\n        auto [curN, curK] = q.front(); q.pop();\n        seq.emplace_back(curN, curK);\n        \n        if (curN == 0 || curK == 0) continue;\n        \n        int step = 1 << log2Val[curN];\n        for (int i = curN; i >= step; i -= 2) {\n            if (powerCount[i] + powerCount[curN - i] == powerCount[curN] && !processed[curN - i][curK - 1]) {\n                processed[curN - i][curK - 1] = true;\n                q.emplace(curN - i, curK - 1);\n            }\n        }\n    }\n    \n    for (int i = seq.size() - 1; i >= 0; --i) {\n        auto [curN, curK] = seq[i];\n        if (curN == 0) {\n            memo[curN][curK] = 1;\n            continue;\n        }\n        if (curK == 0) {\n            memo[curN][curK] = 0;\n            continue;\n        }\n        \n        int step = 1 << log2Val[curN];\n        for (int i = curN; i >= step; i -= 2) {\n            if (powerCount[i] + powerCount[curN - i] == powerCount[curN]) {\n                memo[curN][curK] = (memo[curN][curK] + (long long)comb(curN, i) * memo[curN - i][curK - 1] % MOD * curK) % MOD;\n            }\n        }\n    }\n    \n    return memo[N][K];\n}\n\nint main() {\n    fastRead(n);\n   