         for (int i = 0; i < (int)g[v].size(); ++i) {\n                        Edge &e = g[v][i];\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost) {\n                            dist[e.to] = dist[v] + e.cost;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            updated = true;\n                        }\n                    }\n                }\n                if (!updated) break;\n            }\n            if (dist[t] >= INF) break;\n            ll add = maxf - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                add = min(add, g[prevv[v]][preve[v]].cap);\n            }\n            flow += add;\n            res += add * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = g[prevv[v]][preve[v]];\n                e.cap -= add;\n                g[v][e.rev].cap += add;\n            }\n        }\n        return res;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0); cout.tie(0);\n    cout << fixed << setprecision(10);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    const int source = 0;\n    const int sink = n * T + 1;\n    MinCostFlow mcf(n * T + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int a;\n        cin >> a;\n        mcf.add_edge(source, a, 1, 0);\n    }\n\n    for (int t = 0; t < T; ++t) {\n        mcf.add_edge(1 + t * n, sink, INF, 0);\n        if (t > 0) {\n            for (int i = 1; i <= n; ++i) {\n                mcf.add_edge(i + (t-1) * n, i + t * n, INF, c);\n            }\n        }\n    }\n\n    for (int i = 0; i < m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 0; j < C; ++j) {\n            int cost = (j+1)*(j+1) - j*j;\n            for (int t = 1; t < T; ++t) {\n                mcf.add_edge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                mcf.add_edge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n            }\n  