ng[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextLong();\n        }\n        int n1 = n / 2;\n        long[] part1 = Arrays.copyOfRange(a, 0, n1);\n        long[] part2 = Arrays.copyOfRange(a, n1, n);\n        \n        // Generate all subset sums for first half\n        int size1 = part1.length;\n        TreeSet<Long> set1 = new TreeSet<>();\n        for (int mask = 0; mask < (1 << size1); mask++) {\n            long sum = 0;\n            for (int j = 0; j < size1; j++) {\n                if ((mask & (1 << j)) != 0) {\n                    sum = (sum + part1[j]) % m;\n                }\n            }\n            set1.add(sum);\n        }\n        List<Long> a1 = new ArrayList<>(set1); // sorted and unique\n        \n        // Generate all subset sums for second half\n        int size2 = part2.length;\n        List<Long> a2 = new ArrayList<>();\n        for (int mask = 0; mask < (1 << size2); mask++) {\n            long sum = 0;\n            for (int j = 0; j < size2; j++) {\n                if ((mask & (1 << j)) != 0) {\n                    sum = (sum + part2[j]) % m;\n                }\n            }\n            a2.add(sum);\n        }\n        \n        long ans = 0;\n        for (long i : a2) {\n            long target = m - i;\n            int idx = Collections.binarySearch(a1, target);\n            if (idx < 0) {\n                idx = -idx - 2; // element before insertion point\n            } else {\n                idx = idx - 1; // strictly less than target\n            }\n            if (idx >= 0) {\n                long candidate = a1.get(idx) + i;\n                if (candidate > ans) {\n                    ans = candidate;\n                }\n            }\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -2.169585604860913e-05, -0.000727508042473346, 0.0, -0.00015877417172305286, -0.006786985322833061, -3.6954811548639555e-06, 0.0, -