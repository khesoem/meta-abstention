ist[u] + e.cost + potential[u] - potential[e.to]) {\n            dist[e.to] = dist[u] + e.cost + potential[u] - potential[e.to];\n            prev_node[e.to] = u;\n            prev_edge[e.to] = i;\n            pq.emplace(dist[e.to], e.to);\n          }\n        }\n      }\n\n      if (dist[sink] == 1e18) return -1;\n      for (int i = 0; i < n; ++i) potential[i] += dist[i];\n\n      ll flow = flow_needed;\n      for (int v = sink; v != source; v = prev_node[v]) {\n        flow = min(flow, graph[prev_node[v]][prev_edge[v]].cap);\n      }\n\n      flow_needed -= flow;\n      total_cost += flow * potential[sink];\n\n      for (int v = sink; v != source; v = prev_node[v]) {\n        auto& e = graph[prev_node[v]][prev_edge[v]];\n        e.cap -= flow;\n        graph[v][e.rev].cap += flow;\n      }\n    }\n    return total_cost;\n  }\n};\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n  \n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  for (int i = 0; i < K; ++i) {\n    cin >> A[i];\n    --A[i];\n  }\n  vector<int> u(M), v(M);\n  for (int i = 0; i < M; ++i) {\n    cin >> u[i] >> v[i];\n    --u[i];\n    --v[i];\n  }\n\n  MCF mcf(N * 101 + 2);\n  int source = N * 101;\n  int sink = source + 1;\n\n  for (int i = 0; i < K; ++i) {\n    mcf.add_edge(source, A[i], 1, 0);\n  }\n\n  for (int day = 0; day <= 100; ++day) {\n    mcf.add_edge(day * N, sink, K, C * day);\n  }\n\n  for (int day = 0; day < 100; ++day) {\n    for (int node = 0; node < N; ++node) {\n      mcf.add_edge(day * N + node, (day + 1) * N + node, K, 0);\n    }\n    for (int edge_idx = 0; edge_idx < M; ++edge_idx) {\n      for (int k = 1; k <= K; ++k) {\n        mcf.add_edge(day * N + u[edge_idx], (day + 1) * N + v[edge_idx], 1, (2 * k - 1) * D);\n        mcf.add_edge(day * N + v[edge_idx], (day + 1) * N + u[edge_idx], 1, (2 * k - 1) * D);\n      }\n    }\n  }\n\n  cout << mcf.solve(source, sink, K) << '\\n';\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "samp