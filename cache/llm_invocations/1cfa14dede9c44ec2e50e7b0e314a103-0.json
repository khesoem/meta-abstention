) {\n                res = (res * a) % MOD;\n            }\n            a = (a * a) % MOD;\n            b >>= 1;\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long p = scanner.nextLong();\n        long k = scanner.nextLong();\n        \n        if (k == 0) {\n            System.out.println(binpow(p, p - 1));\n        } else if (k == 1) {\n            System.out.println(binpow(p, p));\n        } else {\n            long ord = 1;\n            long cur = k % p;\n            while (cur != 1) {\n                cur = (cur * k) % p;\n                ord++;\n            }\n            System.out.println(binpow(p, (p - 1) / ord));\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001958416833076626, -9.536738616588991e-07, -2.3841855067985307e-07, -8.987976616481319e-05, -3.707340147229843e-05, -7.533743337262422e-05, -0.03299258276820183, -2.5510462364763953e-05, -7.629365427419543e-06, -4.768370445162873e-07, -3.9934315282152966e-05, -1.9311717551317997e-05, -3.576278118089249e-07, -0.2601996958255768, -2.3603161025675945e-05, -4.410734163684538e-06, -1.7881377516459906e-06, 0.0, 0.0, -1.1920928244535389e-07, -7.867782187531702e-06, 0.0, 0.0, -3.3378546504536644e-06, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -4.768370445162873e-07, -0.0732949748635292, -3.933898824470816e-06, -0.002806536154821515, -1.1920922133867862e-06, -4.0531076592742465e-06, -1.8358061424805783e-05, -1.2040065485052764e-05, -1.1920928244535389e-07, 0.0, -9.536738616588991e-07, 0.0, -1.4305104514278355e-06, 0.0, -4.0649541915627196e-05, -1.6689286894688848e-06, -2.3841855067985307e-07, 0.0, 0.0, -8.344646857949556e-07, -2.0265558760002023e-06, 0.0, -8.821448318485636e-06, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, 0.0, -1.4305104514278355e-06, -4.768370445162873e-07, -6.603976362384856e-05, 0.0, -4.7683704451