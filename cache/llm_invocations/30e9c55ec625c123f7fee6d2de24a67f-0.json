b] * calc(lvl + 1, sub)) % p;\n    memo[lvl][mask] = (memo[lvl][mask] + inv_fact[mask] * calc(lvl + 1, 0)) % p;\n    return memo[lvl][mask];\n}\n\nint main() {\n    scanf(\"%d %d %d\", &n, &k, &p);\n    long long res = 1;\n    for (int i = 0; i < n; ++i) res = res * k % p;\n    if (n % 2 == 0) {\n        setup();\n        memset(memo, -1, sizeof(memo));\n        res = (res - calc(0, n) + p) % p;\n    }\n    printf(\"%lld\\n\", res);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_exp(b, e, p):\n    r = 1\n    b %= p\n    while e:\n        if e & 1:\n            r = (r * b) % p\n        b = (b * b) % p\n        e >>= 1\n    return r\n\ndef lb(x):\n    return x & -x\n\ndef setup(fact, inv_fact, n, k, p):\n    fact[0] = 1\n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % p\n    inv_fact[n] = mod_exp(fact[n], p-2, p)\n    for i in range(n, 0, -1):\n        inv_fact[i-1] = inv_fact[i] * i % p\n\ndef calc(lvl, mask, memo, fact, inv_fact, n, k, p):\n    if memo[lvl][mask] != -1:\n        return memo[lvl][mask]\n    if not mask:\n        memo[lvl][mask] = fact[n]\n        for i in range(1, lvl + 1):\n            memo[lvl][mask] = memo[lvl][mask] * (k - i + 1) % p\n        return memo[lvl][mask]\n    memo[lvl][mask] = 0\n    comp = mask - lb(mask)\n    sub = comp\n    while sub:\n        memo[lvl][mask] = (memo[lvl][mask] + inv_fact[mask - sub] * calc(lvl + 1, sub, memo, fact, inv_fact, n, k, p)) % p\n        sub = (sub - 1) & comp\n    memo[lvl][mask] = (memo[lvl][mask] + inv_fact[mask] * calc(lvl + 1, 0, memo, fact, inv_fact, n, k, p)) % p\n    return memo[lvl][mask]\n\ndef main():\n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    \n    res = 1\n    for i in range(n):\n        res = res * k % p\n    \n    if n % 2 == 0:\n        # Initialize arrays\n        memo = [[-1] * (250010) for _ in range(26)]\n        fact = [0] * (250010)\n        inv_fact = [0] * (250010)\n        \n        setup(fact, inv_fact, n, k, p)\n        res = (res - calc(0, n, memo, fact, inv_fact, n, k, p) + p) % p\n    \n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012444675667211413, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0014044907875359058, -0.00010430268594063818, -0.3132714033126831, -0.003185794921591878, -0.2390184849500656, -3.933898824470816e-06, -1.7762025890988298e-05, -1.0251946150674485e-05, -1.1920928244535389e-07, -0.0015049570938572288, -0.029904190450906754, -6.007967749610543e-05, -3.576278118089249e-07, -2.4437606043647975e-05, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.003610759973526001, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.2040065485052764e-05, -3.099436753473128e-06, -4.768370445162873e-07, -2.610649426060263e-05, 0.0, -1.1920928244535389e-07, -2.622600959512056e-06, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.4185804502631072e-05, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, 0.0, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -1.311301275563892e-06, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, -4.768370445162873e-07, -7.152555099310121e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -7.152555099310121e-07, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -9.536738616588991e-07, 0.0, -2.3841855067985307e-07, -0.0002315968304174021, -3.933898824470816e-06, -3.4570634852570947e-06, -0.00030191155383363366, -1.4305104514278355e-06, -0.00017998983094003052, 0.0, -3.576278118089249e-07, 0.0, -1.0728830375228426e-06, -3.576278118089249e-07, -2.264974000354414e-06, -4.768370445162873e-07, -0.020884374156594276, -0.16116289794445038, -0.6051074266433716, -3.