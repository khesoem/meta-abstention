 0; i < n; ++i) {\n            arr[i] = scanner.nextInt();\n        }\n        \n        Arrays.sort(arr);\n        \n        int itv = scanner.nextInt();\n        int ans = 0;\n        \n        for (int i = 0; i < n; ++i) {\n            ans = Math.max(ans, Get(i, arr, n, itv));\n        }\n        \n        System.out.println(ans);\n    }\n    \n    private static int Get(int pos, int[] arr, int n, int itv) {\n        int ret = 0;\n        for (int i = pos; i < n; ++i) {\n            if (arr[i] <= itv + arr[pos]) {\n                ret++;\n            }\n        }\n        return ret;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013124081306159496, -1.7881377516459906e-06, -3.576278118089249e-07, -9.738924563862383e-05, -3.313963316031732e-05, -0.005235058255493641, -0.4531620144844055, -5.722029527532868e-06, -4.768370445162873e-07, -1.4185804502631072e-05, -0.00033706706017255783, -1.585470999998506e-05, -0.07173624634742737, -1.6689286894688848e-06, -0.009760631248354912, -8.34461570775602e-06, -3.814689989667386e-06, -2.9802276912960224e-06, -1.6331539882230572e-05, -1.311301275563892e-06, -9.536738616588991e-07, -1.1920922133867862e-06, -0.0002337421028641984, -0.28178372979164124, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.3112935448589269e-05, -3.814689989667386e-06, -4.768370445162873e-07, -1.9073468138230965e-06, -0.033651188015937805, -6.6756979322235566e-06, -0.0008222059695981443, -0.22546638548374176, -5.960462772236497e-07, -9.65590606938349e-06, -5.960462772236497e-07, -4.768360213347478e-06, -2.50339189733495e-06, -7.152555099310121e-07, -9.536738616588991e-07, -3.576278118089249e-07, 0.0, -5.960462772236497e-07, 0.0, -0.3868715167045593, -2.932505594799295e-05, -0.2811538875102997, -2.0265558760002023e-06, -0.005929735954850912, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -7.629365427419543e-06, -1.1920928244535389e-07, -0.05488286912441254, -0.000295952864