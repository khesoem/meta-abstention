  }\n    long long dfs(int pos,long long flow)\n    {\n        if (pos == t) return flow;\n        vis[pos] = 1;\n        long long tmp = flow;\n        for (int i = cur[pos] != -1 ? cur[pos] : head[pos];i != -1;i = nxt[i])\n            if (!vis[v[i]] && w[i] && dis[v[i]] == dis[pos] + c[i])\n            {\n                cur[pos] = i;\n                long long fl = dfs(v[i],min(flow,w[i]));\n                cost += fl * c[i];\n                w[i] -= fl;w[i ^ 1] += fl;\n                flow -= fl;\n                if (!flow) break;\n            }\n        return tmp - flow;\n    }\npublic:\n    FlowGraph()\n    {memset(head,-1,sizeof(head));memset(nxt,-1,sizeof(nxt));}\n    inline void add_edge(int uu,int vv,long long ww,int cc)\n    {\n        padd_edge(uu,vv,ww,cc);padd_edge(vv,uu,0,-cc);\n    }\n    long long dinic(int s,int t)\n    {\n        cost = 0;this->t = t;\n        while (spfa(s,t)) \n        {\n            memset(cur,-1,sizeof(cur));dfs(s,inf);\n        }\n        return cost;\n    }\n};\nFlowGraph g;\nint n,m,kk,c,d,a[55];\nint main ()\n{\n    ios::sync_with_stdio(false);\n    cin >> n >> m >> kk >> c >> d;\n    for (int i = 1;i <= kk;i++) cin >> a[i];\n    int s = 0,t = n * 100 + 1;\n    for (int i = 1;i <= 100;i++) g.add_edge(i,t,inf,0);\n    for (int i = 1;i <= kk;i++) g.add_edge(s,(a[i] - 1) * 100 + 1,1,0);\n    for (int i = 2;i <= n;i++)\n        for (int j = 1;j < 100;j++)\n            g.add_edge((i - 1) * 100 + j,(i - 1) * 100 + j + 1,inf,c);\n    int t1,t2;\n    for (int _ = 1;_ <= m;_++)\n    {\n        cin >> t1 >> t2;\n        for (int i = 1;i < 100;i++)\n            for (int j = 1;j <= kk;j++) //\u5176\u5b9e\u4e0d\u7528\u679a\u4e3e\u5230kk\uff0c\u679a\u4e3e\u523025\u5de6\u53f3\u5373\u53ef\n            {\n                int val = c + d * (j * j - (j - 1) * (j - 1));\n                g.add_edge((t1 - 1) * 100 + i,(t2 - 1) * 100 + i + 1,1,val);\n                g.add_edge((t2 - 1) * 100 + i,(t1 - 1) * 100 + i + 1,1,val);\n            }\n    }\n    cout << g.dinic(s,t) << endl;\n    return 0;\n}\n// \u6700\u5c0f\u8d39\u7528\u6d41 \u73c2\u4ee5\u5229\u7528\u6d41\u91cf\u6765\u5904\u7406\u591a\u4eba\u8d70\u540c\u4e00\u6761\u8def\u7684\u60c5\u51b5\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nN = 10000\nM = N * 100\ninf = 1 << 60\n\nclass FlowGraph:\n    def __init__(self):\n        self.head = [-1] * N\n        self.v = [0] * M\n        self.nxt = [-1] * M\n        self.c = [0] * M\n        self.w = [0] * M\n        self.ptr = 0\n        self.cost = 0\n        self.t = 0\n\n        self.dis = [-1] * N\n        self.id = [0] * N\n        self.cur = [-1] * N\n        self.vis = [False] * N\n\n    def padd_edge(self, uu, vv, ww, cc):\n        self.v[self.ptr] = vv\n        self.w[self.ptr] = ww\n        self.c[self.ptr] = cc\n        self.nxt[self.ptr] = self.head[uu]\n        self.head[uu] = self.ptr\n        self.ptr += 1\n\n    def add_edge(self, u, v, w, c):\n        self.padd_edge(u, v, w, c)\n        self.padd_edge(v, u, 0, -c)\n\n    def spfa(self, s, t):\n        for i in range(len(self.vis)):\n            self.vis[i] = False\n            self.dis[i] = -1\n        q = deque()\n        q.append(s)\n        self.dis[s] = 0\n        self.id[s] = 1\n        while q:\n            nd = q.popleft()\n            self.vis[nd] = False\n            i = self.head[nd]\n            while i != -1:\n                if self.w[i] and (self.dis[self.v[i]] == -1 or self.dis[self.v[i]] > self.dis[nd] + self.c[i]):\n                    self.dis[self.v[i]] = self.dis[nd] + self.c[i]\n                    if not self.vis[self.v[i]]:\n                        self.vis[self.v[i]] = True\n                        q.append(self.v[i])\n                i = self.nxt[i]\n        return self.dis[t] != -1\n\n    def dfs(self, pos, flow, t):\n        if pos == t:\n            return flow\n        self.vis[pos] = True\n        tmp = flow\n        i = self.cur[pos]\n        if i == -1:\n            i = self.head[pos]\n        while i != -1:\n            if (not self.vis[self.v[i]] and self.w[i] and self.dis[self.v[i]] == self.dis[pos] + self.c[i]):\n                self.cur[pos] = i\n                fl = self.dfs(self.v[i], min(flow, self.w[i]), t)\n                self.cost += fl * self.c[i]\n                self.w[i] -= fl\n                self.w[i ^ 1] += fl\n                flow -= fl\n                if flow == 0:\n                    break\n            i = self.nxt[i]\n        self.vis[pos] = False\n        return tmp - flow\n\n    def dinic(self, s, t):\n        self.cost = 0\n        self.t = t\n        while self.spfa(s, t):\n            for i in range(len(self.cur)):\n                self.cur[i] = self.head[i]\n            self.dfs(s, inf, t)\n        return self.cost\n\ng = FlowGraph()\ndata = list(map(int, sys.stdin.read().split()))\nn, m, kk, c, d = data[0:5]\na = [0]+data[5:5+kk]\n\ns = 0\nt = n * 100 + 1\n\nfor i in range(1, 101):\n    g.add_edge(i, t, inf, 0)\n\nfor i in range(1, kk+1):\n    g.add_edge(s, (a[i] - 1) * 100 + 1, 1, 0)\n\nfor i in range(2, n+1):\n    for j in range(1, 100):\n        g.add_edge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, inf, c)\n\nidx = 5 + kk\nfor _ in range(m):\n    t1, t2 = data[idx], data[idx+1]\n    idx += 2\n    for i in range(1, 100):\n        val = c + d * (i * i - (i - 1) * (i - 1))\n        g.add_edge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val)\n        g.add_edge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val)\n\nprint(g.dinic(s, t))\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-7.946405094116926e-05, -0.0003119863977190107, -5.512236498361744e-07, -2.9160102712921798e-05, -0.41349488496780396, -2.451116051815916e-05, -3.2855416066013277e-05, -0.12762358784675598, -0.0006909898947924376, 0.0, -1.981667537620524e-06, -0.048835236579179764, -0.00312