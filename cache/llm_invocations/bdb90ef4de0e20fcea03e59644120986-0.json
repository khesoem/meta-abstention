                      if (i == j || j == k || k == i) continue;\n                        \n                        long[] v1 = new long[5];\n                        long[] v2 = new long[5];\n                        for (int d = 0; d < 5; d++) {\n                            v1[d] = points[j][d] - points[i][d];\n                            v2[d] = points[k][d] - points[i][d];\n                        }\n                        \n                        double dot = 0, m1 = 0, m2 = 0;\n                        for (int d = 0; d < 5; d++) {\n                            dot += v1[d] * v2[d];\n                            m1 += v1[d] * v1[d];\n                            m2 += v2[d] * v2[d];\n                        }\n                        \n                        double angle = Math.toDegrees(Math.acos(dot / Math.sqrt(m1 * m2)));\n                        if (angle < 90 - 1e-9) {\n                            foundBad = true;\n                            badIndices.add(i);\n                        }\n                    }\n                }\n            }\n            \n            pw.println(n - badIndices.size());\n            for (int i = 1; i <= n; i++) {\n                if (!badIndices.contains(i)) {\n                    pw.println(i);\n                }\n            }\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef main():\n    input_data = sys.stdin.read().splitlines()\n    if not input_data:\n        return\n    \n    n = int(input_data[0].strip())\n    if n >= 100:\n        print(0)\n        return\n    \n    points = [[0] * 5 for _ in range(n + 1)]\n    for i in range(1, n + 1):\n        line = input_data[i].split()\n        for j in range(5):\n            points[i][j] = int(line[j])\n    \n    bad_indices = set()\n   