i) {\n                if (mask & (1 << i)) {\n                    res[i] += p[mask];\n                }\n            }\n        }\n    }\n    // Output using cout with fixed precision\n    cout << fixed << setprecision(10);\n    for (int i = 0; i < n; ++i) {\n        cout << res[i];\n        if (i < n - 1) cout << ' ';\n    }\n    cout << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        final int N = 20;\n        final double eps = 1e-10;\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int k = sc.nextInt();\n        double[] a = new double[N];\n        int zeroCnt = 0;\n        for (int i = 0; i < n; ++i) {\n            a[i] = sc.nextDouble();\n            if (a[i] < eps) ++zeroCnt;\n        }\n        k = Math.min(n - zeroCnt, k);\n        double[] p = new double[1 << N];\n        double[] res = new double[N];\n        p[0] = 1.0;\n        for (int mask = 1; mask < (1 << n); ++mask) {\n            double suma = 0.0;\n            boolean ok = true;\n            int bits = 0;\n            for (int i = 0; i < n; ++i) {\n                if ((mask & (1 << i)) != 0) {\n                    suma += a[i];\n                    if (a[i] < eps) ok = false;\n                    ++bits;\n                }\n            }\n            if (!ok) {\n                p[mask] = 0.0;\n                continue;\n            }\n            double sump = 0.0;\n            for (int i = 0; i < n; ++i) {\n                if ((mask & (1 << i)) != 0) {\n                    sump += a[i] / (1.0 - suma + a[i]) * p[mask ^ (1 << i)];\n                }\n            }\n            p[mask] = sump;\n            if (bits == k) {\n                for (int i = 0; i < n; ++i) {\n                    if ((mask & (1 << i)) != 0) {