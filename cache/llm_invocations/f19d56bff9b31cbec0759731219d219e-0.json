OD : 0;\n            return new long[]{nextP, i + 1};\n        }).limit((long) n + 1).mapToLong(state -> state[0]).reduce(0L, Main::add);\n\n        long answer = LongStream.rangeClosed(1, n)\n                .mapToLong(k -> {\n                    long sign = ((k & 1) == 1) ? 1 : MOD - 1;\n                    return mul(sign, ncr(n, (int) k), m + k, smallInverse((int) k), phaseSize);\n                })\n                .reduce(0L, Main::add);\n\n        out.println(answer);\n    }\n\n    static void precompute(int N) {\n        fact = new long[N + 1];\n        invFact = new long[N + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= N; i++) {\n            fact[i] = fact[i - 1] * i % MOD;\n        }\n        invFact[N] = modPow(fact[N], MOD - 2);\n        for (int i = N; i >= 1; i--) {\n            invFact[i - 1] = invFact[i] * i % MOD;\n        }\n    }\n\n    static long modPow(long a, long e) {\n        long res = 1;\n        while (e > 0) {\n            if ((e & 1) == 1) res = res * a % MOD;\n            a = a * a % MOD;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static long smallInverse(int x) {\n        return invFact[x] * fact[x - 1] % MOD;\n    }\n\n    static long ncr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;\n    }\n\n    static long mul(long... vals) {\n        long res = 1;\n        for (long v : vals) res = res * v % MOD;\n        return res;\n    }\n\n    static long add(long a, long b) {\n        long res = a + b;\n        return res >= MOD ? res - MOD : res;\n    }\n\n    static class InputReader {\n        public final BufferedReader reader;\n        public StringTokenizer tokenizer;\n\n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream), 32768);\n            tokenizer = null;\n        }\n\n        public String next() {\n            while (tokenizer == null || !tokenizer.ha