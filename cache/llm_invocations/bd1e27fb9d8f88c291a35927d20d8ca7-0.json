 long cost) : to(to), rev(rev), cap(cap), cost(cost) {}\n};\n\nclass MinCostFlow {\npublic:\n    vector<vector<Edge>> graph;\n    vector<long long> potential, dist;\n    vector<int> prevv, preve;\n\n    MinCostFlow(int n) {\n        graph.resize(n);\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        prevv.assign(n, 0);\n        preve.assign(n, 0);\n    }\n\n    void addEdge(int from, int to, long long cap, long long cost) {\n        graph[from].push_back(Edge(to, (int)graph[to].size(), cap, cost));\n        graph[to].push_back(Edge(from, (int)graph[from].size() - 1, 0, -cost));\n    }\n\n    pair<long long, long long> minCostMaxFlow(int s, int t, long long maxf) {\n        long long flow = 0, cost = 0;\n        fill(potential.begin(), potential.end(), 0);\n        while (flow < maxf) {\n            fill(dist.begin(), dist.end(), LLONG_MAX);\n            dist[s] = 0;\n            priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;\n            pq.push({0, s});\n            while (!pq.empty()) {\n                auto cur = pq.top(); pq.pop();\n                int v = cur.second;\n                if (dist[v] < cur.first) continue;\n                for (int i = 0; i < (int)graph[v].size(); ++i) {\n                    Edge &e = graph[v][i];\n                    if (e.cap > 0) {\n                        long long nd = dist[v] + e.cost + potential[v] - potential[e.to];\n                        if (dist[e.to] > nd) {\n                            dist[e.to] = nd;\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.push({nd, e.to});\n                        }\n                    }\n                }\n            }\n            if (dist[t] == LLONG_MAX) break;\n            for (int v = 0; v < (int)graph.size(); ++v) {\n                if (dist[v] < LLONG_MAX) potential[v] += dist[v];\n            }\n            long long d = maxf - flow;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = min(d, graph[prevv[v]][preve[v]].cap);\n            }\n            flow += d;\n            cost += d * potential[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge &e = graph[prevv[v]][preve[v]];\n                e.cap -= d;\n                graph[v][e.rev].cap += d;\n            }\n        }\n        return {cost, flow};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    string s;\n    cin >> s;\n    vector<int> ugliness(n);\n    for (int i = 0; i < n; ++i) {\n        int x;\n        cin >> x;\n        ugliness[i] = -x;\n    }\n\n    int V = 1 + 26 + n / 2 + 1;\n    MinCostFlow mcf(V);\n\n    // edges from letter nodes to pair nodes\n    for (char c = 'a'; c <= 'z'; ++c) {\n        for (int i = 0; i < n / 2; ++i) {\n            long long cost = 0;\n            if (c == s[i]) {\n                cost = min(cost, (long long)ugliness[i]);\n            }\n            if (c == s[n - 1 - i]) {\n                cost = min(cost, (long long)ugliness[n - 1 - i]);\n            }\n            mcf.addEdge(1 + (c - 'a'), 1 + 26 + i, 1, cost);\n        }\n    }\n\n    // edges from source to letter nodes\n    int occurs[128] = {0};\n    for (int i = 0; i < n; ++i) occurs[s[i]]++;\n    for (char c = 'a'; c <= 'z'; ++c) {\n        mcf.addEdge(0, 1 + (c - 'a'), occurs[c], 0);\n    }\n\n    // edges from pair nodes to sink\n    for (int i = 0; i < n / 2; ++i) {\n        mcf.addEdge(1 + 26 + i, 1 + 26 + n / 2, 2, 0);\n    }\n\n    auto res = mcf.minCostMaxFlow(0, 1 + 26 + n / 2, n);\n    cout << -res.first << endl;\n\n    return 0;\n}\n```", "token_logprobs": [-0.5798567533493042, -2.8013790142722428e-05, -1.490105023549404e-05, -2.777537883957848e-05, -6.318072337307967e-06, -0.3133857548236847, -1.0132738680113107e-05, 0.0, 0.0, -0.0025648337323218584, -7.152555099310121e-07, 0.0, 0.0, -0.20477646589279175, -1.549719