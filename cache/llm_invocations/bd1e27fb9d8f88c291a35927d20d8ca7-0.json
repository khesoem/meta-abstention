 cost = Math.min(cost, ugliness[n - 1 - i]);\n                    }\n                    mcf.addEdge(1 + (c - 'a'), 1 + 26 + i, 1, cost);\n                }\n            }\n\n            int[] occurs = new int[128];\n            for (int i = 0; i < n; ++i) occurs[s[i]]++;\n            for (char c = 'a'; c <= 'z'; ++c) {\n                mcf.addEdge(0, 1 + (c - 'a'), occurs[c], 0);\n            }\n\n            for (int i = 0; i < n / 2; ++i) {\n                mcf.addEdge(1 + 26 + i, 1 + 26 + n / 2, 2, 0);\n            }\n\n            long[] flow = mcf.minCostMaxFlow(0, 1 + 26 + n / 2, n);\n            out.println(-flow[0]);\n        }\n    }\n\n    static class MinCostFlow {\n        class Edge {\n            int to, rev;\n            long cap, cost;\n            Edge(int to, int rev, long cap, long cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n\n        List<Edge>[] graph;\n        long[] potential, dist;\n        int[] prevv, preve;\n\n        @SuppressWarnings(\"unchecked\")\n        MinCostFlow(int n) {\n            graph = new List[n];\n            for (int i = 0; i < n; i++) graph[i] = new ArrayList<>();\n            potential = new long[n];\n            dist = new long[n];\n            prevv = new int[n];\n            preve = new int[n];\n        }\n\n        void addEdge(int from, int to, long cap, long cost) {\n            graph[from].add(new Edge(to, graph[to].size(), cap, cost));\n            graph[to].add(new Edge(from, graph[from].size() - 1, 0, -cost));\n        }\n\n        long[] minCostMaxFlow(int s, int t, long maxf) {\n            long flow = 0, cost = 0;\n            Arrays.fill(potential, 0);\n            while (flow < maxf) {\n                Arrays.fill(dist, Long.MAX_VALUE);\n                dist[s] = 0;\n                PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[1]));\n                