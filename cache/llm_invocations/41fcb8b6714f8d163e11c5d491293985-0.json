       // from left (b=0) to right (b=1)\n                        ns[i][j][0].s.push_back(&ns[i - y][j - x][1]);\n                        ns[i - y][j - x][1].s.push_back(&ns[i][j][0]);\n                    }\n                }\n            }\n        }\n\n        // BFS\n        queue<Node*> q;\n        ns[c50][c100][0].n = 1;\n        ns[c50][c100][0].am = 1;\n        q.push(&ns[c50][c100][0]);\n        while (!q.empty()) {\n            Node* cur = q.front();\n            q.pop();\n            for (Node* ch : cur->s) {\n                if (ch->n == 0 || ch->n == cur->n + 1) {\n                    int avail50 = (cur->b == 0) ? cur->c50 : c50 - cur->c50;\n                    int move50 = abs(cur->c50 - ch->c50);\n                    int avail100 = (cur->b == 0) ? cur->c100 : c100 - cur->c100;\n                    int move100 = abs(cur->c100 - ch->c100);\n                    long long p1 = c[avail50][move50];\n                    long long p2 = c[avail100][move100];\n                    ch->am = (ch->am + (cur->am * ((p1 * p2) % MOD)) % MOD) % MOD;\n                    if (ch->n == 0) {\n                        ch->n = cur->n + 1;\n                        q.push(ch);\n                    }\n                }\n            }\n        }\n\n        Node& goal = ns[0][0][1];\n        cout << goal.n - 1 << \"\\n\" << goal.am << \"\\n\";\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    Main m;\n    m.solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.1920922133867862e-06, 0.0, 0.0, -0.00013159839727450162, -0.00011789103882620111, -2.50339189733495e-06, -0.00026520551182329655, -2.4318398573086597e-05, 0.0, 0.0, -5.125986263010418e-06, -2.0265558760002023e-06, 0.0, 0.0, -1.0967194612021558e-05, -2.622600959512056e-06, -1.1920928244535389e-07, 0.0, -0.047383710741996765, -0.00020704510097857565, -0.07694706320762634, -0.02326408214867115, -3.576278118089249e-07, -0.3968737721443176, -0.38