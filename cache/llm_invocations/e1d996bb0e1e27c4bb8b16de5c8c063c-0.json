n        int result = -1;\n        for(int i=0; i<=N; i+=1) {\n            double favorable = 0;\n            \n            // Case 1: Johnny studies i maps\n            // We need to count scenarios where at least one of the studied maps is selected\n            \n            // Total ways to choose 3 maps from N\n            double total = (double)N * (N-1) * (N-2) / 6.0;\n            \n            // Count favorable cases:\n            // Case A: All 3 maps are studied (i choose 3)\n            favorable += (double)i * (i-1) * (i-2) / 6.0;\n            \n            // Case B: 2 maps studied, 1 not studied (i choose 2) * (N-i choose 1)\n            // In this case, both players might discard the unstudied one, or one discards studied and one unstudied\n            // If both discard unstudied: system picks randomly between 2 studied -> probability 1 that studied is played\n            // If one discards studied and one unstudied: system picks randomly between 1 studied and 1 unstudied -> probability 0.5\n            // If both discard studied: system picks the unstudied -> probability 0\n            // But opponents pick randomly, so we need to compute probabilities\n            double caseB = (double)i * (i-1) / 2.0 * (N-i);\n            favorable += caseB * (1.0/3.0 + 2.0/3.0 * 0.5); // 1/3 chance both pick unstudied (guaranteed), 2/3 chance one picks each (50%)\n            \n            // Case C: 1 map studied, 2 not studied (i choose 1) * (N-i choose 2)\n            // Johnny will discard one of the unstudied, opponents pick randomly\n            // If both opponents discard the same unstudied: system picks between studied and remaining unstudied -> 50%\n            // If opponents discard different unstudied: system must pick studied -> 100%\n            double caseC = (double)i * (N-i) * (N-i-1) / 2.0;\n            favorable += caseC * (1.0/3.0 * 0.5 + 2.0/3.0 * 1.0); // 1/3 both pick same unstudied, 2/3 pick different\n            \n            // Case D: 0 maps studied (N-i choose 3) - no favorable outcomes\n            // Already not counted in favorable\n            \n            double probability = favorable / total;\n            \n            if(probability >= P) {\n                result = i;\n                break;\n            }\n        }\n        \n        out.println(result);\n\n        out.close();\n    }\n\n    static class FastScanner {\n        InputStream dis;\n        byte[] buffer = new byte[1 << 17];\n        int pointer = 0;\n\n        public FastScanner (String fileName) throws IOException {\n            dis = new FileInputStream(fileName);\n        }\n\n        public FastScanner (InputStream is) throws IOException {\n            dis = is;\n        }\n\n        int nextInt() throws IOException {\n            int ret = 0;\n\n            byte b;\n            do {\n                b = nextByte();\n            } while (b <= ' ');\n            boolean negative = false;\n            if (b == '-') {\n                negative = true;\n                b = nextByte();\n            }\n            while (b >= '0' && b <= '9') {\n                ret = 10 * ret + b - '0';\n                b = nextByte();\n            }\n\n            return (negative) ? -ret : ret;\n        }\n\n        long nextLong() throws IOException {\n            long ret = 0;\n\n            byte b;\n            do {\n                b = nextByte();\n            } while (b <= ' ');\n            boolean negative = false;\n            if (b == '-') {\n                negative = true;\n                b = nextByte();\n            }\n            while (b >= '0' && b <= '9') {\n                ret = 10 * ret + b - '0';\n                b = nextByte();\n            }\n\n            return (negative) ? -ret : ret;\n        }\n\n        byte nextByte() throws IOException {\n            if (pointer == buffer.length) {\n                dis.read(buffer, 0, buffer.length);\n                pointer = 0;\n            }\n            return buffer[p