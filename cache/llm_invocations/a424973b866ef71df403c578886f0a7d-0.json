ng nextLong() {\n            return Long.parseLong(next());\n        }\n\n        double nextDouble() {\n            return Double.parseDouble(next());\n        }\n\n    }\n\n    public static void main(String[] args) {\n        FastScanner in = new FastScanner(System.in);\n        int n = in.nextInt();\n        int budget = in.nextInt();\n\n        int[] arr = new int[n];\n        for (int i = 0; i < n; i++) {\n            arr[i] = in.nextInt();\n        }\n\n        int evenCount = 0, oddCount = 0;\n        List<Integer> costs = new ArrayList<>();\n        for (int i = 0; i < n - 1; i++) {\n            if (arr[i] % 2 == 0) evenCount++;\n            else oddCount++;\n            if (evenCount == oddCount) {\n                costs.add(Math.abs(arr[i] - arr[i + 1]));\n            }\n        }\n\n        costs.sort(Integer::compareTo);\n        int operations = 0;\n        for (int cost : costs) {\n            if (budget < cost) break;\n            budget -= cost;\n            operations++;\n        }\n        System.out.println(operations);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nclass FastScanner:\n    def __init__(self, f):\n        if isinstance(f, str):\n            try:\n                self.br = open(f, 'r')\n            except FileNotFoundError:\n                import traceback\n                traceback.print_exc()\n                self.br = None\n        else:\n            self.br = sys.stdin\n        \n        self.st = []\n    \n    def nextLine(self):\n        try:\n            return self.br.readline()\n        except:\n            return None\n    \n    def next(self):\n        while not self.st:\n            try:\n                line = self.br.readline()\n                if not line:\n                    return None\n                self.st = line.strip().split()\n            except:\n                impor