gh 64 bits of unsigned 128-bit product\n        static long unsignedMultiplyHigh(long x, long y) {\n            // Use BigInteger for simplicity\n            java.math.BigInteger xBig = java.math.BigInteger.valueOf(x);\n            java.math.BigInteger yBig = java.math.BigInteger.valueOf(y);\n            java.math.BigInteger product = xBig.multiply(yBig);\n            // Shift right 64 bits\n            java.math.BigInteger high = product.shiftRight(64);\n            return high.longValue();\n        }\n        // Compare two unsigned long values\n        static int compareUnsigned(long a, long b) {\n            return Long.compareUnsigned(a, b);\n        }\n    }\n    static Modulo M = new Modulo();\n    static class Data {\n        int[] f = new int[N];\n        int[] g = new int[N];\n    }\n    static Data d = new Data();\n    static int[][] dp1 = new int[N][N];\n    static int[][] dp2 = new int[N][N];\n    static int[][] C = new int[N][N];\n    \n    static void addmod(int[] a, int b) {\n        a[0] += b;\n        if (a[0] >= mod) a[0] -= mod;\n    }\n    // Modified to pass array reference\n    static void addmod(int[] a, int b, int[] out) { // unused, we use direct\n    }\n    static long s(int x) {\n        return (long) x * (x + 1) / 2;\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        mod = sc.nextInt();\n        M.init(mod);\n        \n        // Precompute combinations\n        for (int i = 0; i < N; i++) {\n            C[i][0] = 1;\n            for (int j = 1; j <= i; j++) {\n                C[i][j] = C[i-1][j-1] + C[i-1][j];\n                if (C[i][j] >= mod) C[i][j] -= mod;\n            }\n        }\n        \n        d.g[0] = 1;\n        for (int i = 1; i <= m; i++) {\n            for (int j = 1; j <= i; j++) {\n                int tmp = C[i-1][j-1];\n                // Use temporary variables for modular multiplication\n   