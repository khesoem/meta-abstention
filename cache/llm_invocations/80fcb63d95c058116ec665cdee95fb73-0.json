{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nconst int N = 1000000;\nint cnt[N+2], src, snk;\nvector<int> g[N+2];\nconst int INF = 1e9;\n\nvector<int> a, b, f, c, d;\nvector<vector<int>> adj;\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    int id = a.size();\n    a.push_back(u); b.push_back(v); f.push_back(0); c.push_back(cap); d.push_back(cost);\n    adj[u].push_back(id);\n    a.push_back(v); b.push_back(u); f.push_back(0); c.push_back(0); d.push_back(-cost);\n    adj[v].push_back(id+1);\n}\n\nint dist[N+2], inq[N+2], mnf[N+2], pth[N+2];\npair<int,int> spfa(int n) {\n    for (int i=0;i<=n;++i) dist[i]=INF;\n    queue<int> q; q.push(src);\n    dist[src]=0; inq[src]=1; mnf[src]=INF;\n    while (!q.empty()) {\n        int u=q.front(); q.pop(); inq[u]=0;\n        for (int id : adj[u]) {\n            int v = b[id];\n            if (c[id] > f[id] && dist[v] > dist[u] + d[id]) {\n                dist[v] = dist[u] + d[id];\n                pth[v] = id;\n                mnf[v] = min(mnf[u], c[id] - f[id]);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v]=1;\n                }\n            }\n        }\n    }\n    if (dist[snk]==INF) return {0,0};\n    int v = snk;\n    while (v != src) {\n        int id = pth[v];\n        f[id] += mnf[snk];\n        f[id^1] -= mnf[snk];\n        v = a[id];\n    }\n    return {mnf[snk], dist[snk]*mnf[snk]};\n}\npair<int,int> mcmf(int n) {\n    int flow=0, cost=0;\n    while (true) {\n        auto p = spfa(n);\n        if (!p.first) return {flow,cost};\n        flow += p.first;\n        cost += p.second;\n    }\n}\n\nint main() {\n    ios_base::sync_with_stdio(0); cin.tie(0);\n    int n, m, k, cst, dst; cin >> n >> m >> k >> cst >> dst;\n    for (int i=1;i<=k;++i) {\n        int x; cin >> x; cnt[x]++;\n    }\n    for (int i=1;i<=m;++i) {\n        int u,v; cin >> u >> v;\n        g[u].push_back(v);\n        g[v].push_back(u);\n    }\n    src = 0; snk = 100*n + n + 1;\n    adj.resize(snk+1);\n    for (int tm=0; tm<=99; ++tm) {\n        for (int i=1;i<=n;++i) {\n            addEdge(n*tm+i, n*(tm+1)+i, k, 0);\n            for (int x : g[i]) {\n                for (int cp=1; cp<=k; ++cp) {\n                    addEdge(n*tm+i, n*(tm+1)+x, 1, dst*(2*cp-1));\n                }\n            }\n        }\n    }\n    for (int i=1;i<=n;++i)\n        if (cnt[i]) addEdge(src, i, cnt[i], 0);\n    for (int tm=0; tm<=100; ++tm)\n        addEdge(n*tm+1, snk, k, cst*tm);\n    cout << mcmf(snk).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    cst = int(next(it))\n    dst = int(next(it))\n\n    cnt = [0] * (n + 2)\n    for _ in range(k):\n        x = int(next(it))\n        cnt[x] += 1\n\n    g = [[] for _ in range(n + 2