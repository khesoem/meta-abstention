cost_val)\n                add_edge(y, x, 1, cost_val)\n        for j in range(n):\n            add_edge(node_id(i, j), node_id(i, j + 1), k, c)\n\ndef min_cost_max_flow():\n    flow = 0\n    cost = 0\n    while True:\n        dist = [float('inf')] * NODES\n        in_queue = [False] * NODES\n        dist[S] = 0\n        from collections import deque\n        queue = deque([S])\n        while queue:\n            u = queue.popleft()\n            in_queue[u] = False\n            for i, (v, cap, cst, rev) in enumerate(G[u]):\n                if cap > 0 and dist[v] > dist[u] + cst:\n                    dist[v] = dist[u] + cst\n                    prev = (u, i)\n                    if not in_queue[v]:\n                        in_queue[v] = True\n                        queue.append(v)\n        if dist[T] == float('inf'):\n            break\n        # Find minimal residual capacity\n        flow_increment = float('inf')\n        v = T\n        parent = [None] * NODES\n        while v != S:\n            u, i = parent[v]\n            flow_increment = min(flow_increment, G[u][i][1])\n            v = u\n        # Apply flow\n        v = T\n        v_prev = None\n        while v != S:\n            u, i = parent[v]\n            G[u][i][1] -= flow_increment\n            rev = G[u][i][3]\n            G[v][rev][1] += flow_increment\n            cost += flow_increment * G[u][i][2]\n            v = u\n        flow += flow_increment\n    return cost\n\nprint(min_cost_max_flow())\n\n</translated_code>\n<confidence>\n0.7\n</confidence>", "token_logprobs": [-0.0009759013773873448, -0.0007485175738111138, -3.128163257315464e-07, -2.6060808522743173e-05, -0.6586847305297852, -0.11762940138578415, -1.6240566083070007e-06, -9.088346359931165e-07, -0.08562491089105606, -1.9361264946837764e-07, -4.842555426876061e-06, 0.0, 0.0, -2.6776029699249193e-05, 0.0, -1.9981420336989686e-05, 0.0, 0.0, -5.7530574849806726e-05, -4.36574100604048e-06, -0.0002655079588294029, -1.9361264946837764e-07, -3.12