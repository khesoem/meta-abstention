 i = head[u]; i; i = e[i].next) {\n            int v = e[i].to, w = e[i].cost;\n            if (e[i].cap > 0 && dist[v] > dist[u] + w) {\n                dist[v] = dist[u] + w;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return dist[t] != INF;\n}\n\nint dfs(int u, int flow, bool vis[]) {\n    if (u == t) return flow;\n    vis[u] = true;\n    int pushed = 0, remain = flow;\n    for (int i = head[u]; i; i = e[i].next) {\n        int v = e[i].to, cap = e[i].cap;\n        if (vis[v] || cap == 0 || dist[v] != dist[u] + e[i].cost) continue;\n        int f = dfs(v, min(remain, cap), vis);\n        if (f > 0) {\n            remain -= f;\n            e[i].cap -= f;\n            e[i ^ 1].cap += f;\n            pushed += f;\n            if (remain == 0) break;\n        }\n    }\n    return pushed;\n}\n\nint solve() {\n    int cost = 0;\n    while (spfa()) {\n        bool vis[MAXN] = {false};\n        int flow = dfs(s, INF, vis);\n        if (flow) cost += flow * dist[t];\n    }\n    return cost;\n}\n\nint main() {\n    read(n); read(m); read(k); read(v1); read(v2);\n    t = idx(n, 110, n) + 1;\n\n    for (int i = 2; i <= 110; ++i) add(idx(1, i, n), t, INF, 0);\n    for (int i = 2; i <= n; ++i)\n        for (int j = 1; j < 110; ++j)\n            add(idx(i, j, n), idx(i, j + 1, n), INF, v1);\n    for (int i = 1, x; i <= k; ++i) {\n        read(x);\n        add(s, idx(x, 1, n), 1, 0);\n    }\n    for (int i = 1; i <= m; ++i) {\n        int x, y;\n        read(x); read(y);\n        for (int j = 1; j < 110; ++j)\n            for (int l = 1; l <= k; ++l) {\n                int c = v2 * (2 * l - 1) + v1;\n                add(idx(x, j, n), idx(y, j + 1, n), 1, c);\n                add(idx(y, j, n), idx(x, j + 1, n), 1, c);\n            }\n    }\n    printf(\"%d\", solve());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 5000010;\n    static final int INF = (int)1e9;\n\n    static int idx(int x, int k, int n) {\n        return x + (k - 1) * n;\n    }\n\n    static class Edge {\n        int to, next, cap, cost;\n        Edge(int to, int next, int cap, int cost) {\n            this.to = to;\n            this.next = next;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static int n, m, k, v1, v2, s, t;\n    static int[] dist;\n    static boolean[] inq;\n    static Edge[] e;\n    static int[] head;\n    static int ecnt = 1;\n\n    static void add(int u, int v, int c, int w) {\n        e[++ecnt] = new Edge(v, head[u], c, w);\n        head[u] = ecnt;\n        e[++ecnt] = new Edge(u, head[v], 0, -w);\n        head[v] = ecnt;\n    }\n\n    static boolean spfa() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(inq, false);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        dist[s] = 0;\n        inq[s] = true;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            for (int i = head[u]; i != 0; i = e[i].next) {\n                int v = e[i].to, w = e[i].cost;\n                if (e[i].cap > 0 && dist[v] > dist[u] + w) {\n                    dist[v] = dist[u] + w;\n                    if (!inq[v]) {\n                        inq[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return dist[t] != INF;\n    }\n\n    static int dfs(int u, int flow, boolean[] vis) {\n        if (u == t) return flow;\n        vis[u] = true;\n        int pushed = 0, remain = flow;\n        for (int i = head[u]; i != 0; i = e[i].next) {\n            int v = e[i].to, cap = e[i].cap;\n            if (vis[v] || cap == 0 || dist[v] != dist[u] + e[i].cost) continue;\n            int f = dfs(v, Math.min(remain, cap), vis);\n            if (f > 0) {\n                remain -= f;\n                e[i].cap -= f;\n                e[i ^ 1].cap += f;\n                pushed += f;\n                if (remain == 0) break;\n            }\n        }\n        return pushed;\n    }\n\n    static int solve() {\n        int cost = 0;\n        while (spfa()) {\n            boolean[] vis = new boolean[MAXN];\n            int flow = dfs(s, INF, vis);\n            if (flow > 0) {\n                cost += flow * dist[t];\n            }\n        }\n        return cost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        v1 = sc.nextInt();\n        v2 = sc.nextInt();\n        t = idx(n, 110, n) + 1;\n\n        dist = new int[MAXN];\n        inq = new boolean[MAXN];\n        e = new Edge[MAXN];\n        head = new int[MAXN];\n\n        for (int i = 2; i <= 110; ++i) {\n            add(idx(1, i, n), t, INF, 0);\n        }\n        for (int i = 2; i <= n; ++i) {\n            for (int j = 1; j < 110; ++j) {\n                add(idx(i, j, n), idx(i, j + 1, n), INF, v1);\n            }\n        }\n        for (int i = 1; i <= k; ++i) {\n            int x = sc.nextInt();\n            add(s, idx(x, 1, n), 1, 0);\n        }\n        for (int i = 1; i <= m; ++i) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            for (int j = 1; j < 110; ++j) {\n                for (int l = 1; l <= k; ++l) {\n                    int c = v2 * (2 * l - 1) + v1;\n                    add(idx(x, j, n), idx(y, j + 1, n), 1, c);\n                    add(idx(y, j, n), idx(x, j + 1, n), 1, c);\n                }\n            }\n        }\n        System.out.print(solve());\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018308870494365692, -2.264974000354414e-06, -2.