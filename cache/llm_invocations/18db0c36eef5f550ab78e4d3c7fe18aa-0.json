{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nstruct step {\n    ll val;\n    int cost;\n    bool operator>(const step &c) const {\n        return cost > c.cost;\n    }\n};\n\nunordered_set<ll> visited;\n\nbool wasVisited(ll c) {\n    return visited.find(c) != visited.end();\n}\n\nstep uupper(ll n) {\n    ll res = 0;\n    int i = 0;\n    while (res < n) {\n        res = res * 10 + 1;\n        i++;\n    }\n    return {res, i};\n}\n\nstep upper(ll n) {\n    ll res = 0;\n    int i = 0;\n    while (res * 10 + 1 <= n) {\n        res = res * 10 + 1;\n        i++;\n    }\n    ll resmul = res;\n    int imul = i;\n    while (res < n) {\n        res += resmul;\n        i += imul;\n    }\n    return {res, i};\n}\n\nstep lower(ll n) {\n    ll res = 0;\n    int i = 0;\n    while (res * 10 + 1 <= n) {\n        res = res * 10 + 1;\n        i++;\n    }\n    ll resmul = res;\n    int imul = i;\n    while (res + resmul <= n) {\n        res += resmul;\n        i += imul;\n    }\n    return {res, i};\n}\n\nint main(int argc, char **argv) {\n    ll n;\n    cin >> n;\n    priority_queue<step, vector<step>, greater<step>> pq;\n    pq.push({n, 0});\n    while (pq.top().val != 0) {\n        ll val = pq.top().val;\n        int cost = pq.top().cost;\n        pq.pop();\n        if (wasVisited(val))\n            continue;\n        visited.insert(val);\n        for (step next : {lower(val), upper(val), uupper(val)}) {\n            next.cost += cost;\n            next.val = abs(val - next.val);\n            pq.push(next);\n        }\n    }\n    cout << pq.top().cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\ndef uupper(n):\n    res = 0\n    i = 0\n    while res < n:\n        res = res * 10 + 1\n        i += 1\n    return (res, i)\n\ndef upper(n):\n    res = 0\n    i = 0\n    while res * 10 + 1 <= n:\n        res = res * 10 + 1\n        i += 1\n    resmul = res\n    imul = i\n    while res < n:\n        res += resmul\n        i += imul\n    return (res, i)\n\ndef lower(n):\n    res = 0\n    i = 0\n    while res * 10 + 1 <= n:\n        res = res * 10 + 1\n        i += 1\n    resmul = res\n    imul = i\n    while res + resmul <= n:\n        res += resmul\n        i += imul\n    return (res, i)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    heap = [(0, n)]\n    visited = set()\n    while heap and heap[0][1] != 0:\n        cost, val = heapq.heappop(heap)\n        if val in visited:\n            continue\n        visited.add(val)\n        for fn in (lower, upper, uupper):\n            next_val, next_cost = fn(val)\n            new_val = abs(val - next_val)\n            new_cost = cost + next_cost\n            heapq.heappush(heap, (new_cost, new_val))\n    if heap:\n        print(heap[0][0])\n    else:\n        print(0)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</conf