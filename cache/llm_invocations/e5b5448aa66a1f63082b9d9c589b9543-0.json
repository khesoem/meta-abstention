{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\n\nconst int MAXV = 10005;\nconst int MAXE = 2000000 + 10;\nconst int INF = 2000000000;\nconst int SRC = MAXV - 2;\nconst int SNK = MAXV - 1;\n\nint to[MAXE], cap[MAXE], ecost[MAXE], ecnt = 1;\nvector<int> adj[MAXV];\nll dis[MAXV];\nbool used[MAXV];\nqueue<int> q;\n\ninline void add(int u, int v, int f, int w) {\n    ++ecnt;\n    to[ecnt] = v; cap[ecnt] = f; ecost[ecnt] = w;\n    adj[u].push_back(ecnt);\n    ++ecnt;\n    to[ecnt] = u; cap[ecnt] = 0; ecost[ecnt] = -w;\n    adj[v].push_back(ecnt);\n}\n\ninline bool spfa() {\n    memset(used, 0, sizeof(used));\n    memset(dis, 0x3f, sizeof(dis));\n    q.push(SNK); dis[SNK] = 0; used[SNK] = 1;\n    while (!q.empty()) {\n        int x = q.front(); q.pop();\n        used[x] = 0;\n        for (int idx = (int)adj[x].size() - 1; idx >= 0; --idx) {\n            int e = adj[x][idx];\n            int y = to[e];\n            if (cap[e ^ 1] && dis[y] > dis[x] + ecost[e ^ 1]) {\n                dis[y] = dis[x] + ecost[e ^ 1];\n                if (!used[y]) { q.push(y); used[y] = 1; }\n            }\n        }\n    }\n    return dis[SRC] < 1e18;\n}\n\ninline int dfs(int x, int lim, ll &total) {\n    int flow = 0;\n    used[x] = 1;\n    if (x == SNK) return lim;\n    for (int idx = (int)adj[x].size() - 1; idx >= 0; --idx) {\n        int e = adj[x][idx];\n        int y = to[e];\n        if (!cap[e] || used[y]) continue;\n        if (dis[x] != dis[y] + ecost[e]) continue;\n        int t = dfs(y, min(cap[e], lim - flow), total);\n        cap[e] -= t;\n        cap[e ^ 1] += t;\n        flow += t;\n        total += t * ecost[e];\n        if (flow == lim) return lim;\n    }\n    return flow;\n}\n\ninline ll minCostFlow() {\n    int totalFlow = 0;\n    ll totalCost = 0;\n    while (spfa()) {\n        do {\n            memset(used, 0, sizeof(used));\n            totalFlow += dfs(SRC, INF, totalCost);\n        } while (used[SNK]);\n    }\n    return totalCost;\n}\n\nint main() {\n    int n, m, k, c, d, lim = 101;\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 0; i < k; i++) { int x; cin >> x; --x; add(SRC, x, 1, 0); }\n    for (int i = 0; i < lim; i++) add(i * n, SNK, k, c * i);\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < lim - 1; j++)\n            add(i + j * n, i + (j + 1) * n, k, 0);\n    while (m--) {\n        int x, y; cin >> x >> y; --x; --y;\n        for (int i = 0; i < lim - 1; i++)\n            for (int j = k - 1; j >= 0; j--) {\n                add(x + i * n, y + (i + 1) * n, 1, d * (2 * j + 1));\n                add(y + i * n, x + (i + 1) * n, 1, d * (2 * j + 1));\n            }\n    }\n    cout << minCostFlow();\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport collections\n\nMAXV = 10005\nINF = 2000000000\nSRC = MAXV - 2\nSNK = MAXV - 1\n\nto = []\ncap = []\necost = []\nadj = [[] for _ in range(MAXV)]\n\ndef add(u, v, f, w):\n    # forward edge\n    to.append(v)\n    cap.append(f)\n    ecost.append(w)\n    adj[u].append(len(to) - 1)\n    # reverse edge\n    to.append(u)\n    cap.append(0)\n    ecost.append(-w)\n    adj[v].append(len(to) - 1)\n\ndis = [0] * MAXV\nused = [False] * MAXV\n\ndef spfa():\n    global dis, used\n    used = [False] * MAXV\n    dis = [float('inf')] * MAXV\n    q = collections.deque()\n    q.append(SNK)\n    dis[SNK] = 0\n    used[SNK] = True\n    while q:\n        x = q.popleft()\n        used[x] = False\n        # iterate over edges from x\n        for idx in range(len(adj[x]) - 1, -1, -1):\n            e = adj[x][idx]\n            y = to[e]\n            if cap[e ^ 1] and dis[y] > dis[x] + ecost[e ^ 1]:\n                dis[y] = dis[x] + ecost[e ^ 1]\n                if not used[y]:\n                    q.append(y)\n                    used[y] = True\n    return dis[SRC] < 1e18\n\ndef dfs(x, lim, total):\n    global used\n    flow = 0\n    used[x] = True\n    if x == SNK:\n        return lim\n    # iterate backward to mimic original order\n    for idx in range(len(adj[x]) - 1, -1, -1):\n        e = adj[x][idx]\n        y = to[e]\n        if not cap[e] or used[y]:\n            continue\n        if dis[x] != dis[y] + ecost[e]:\n            continue\n        t = dfs(y, min(cap[e], lim - flow), total)\n        cap[e] -= t\n        cap[e ^ 1] += t\n        flow += t\n        total[0] += t * ecost[e]\n        if flow == lim:\n            return lim\n    return flow\n\ndef min_cost_flow():\n    total_cost = [0]\n    while spfa():\n        while True:\n            used = [False] * MAXV\n            # totalFlow not needed, we just call dfs to augment flow\n            dfs(SRC, INF, total_cost)\n            if not used[SNK]:\n                break\n    return total_cost[0]\n\ndef main():\n    import sys\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    lim = 101\n    # add edges from source to initial people positions\n    for _ in range(k):\n        x = int(next(it)) - 1\n        add(SRC, x, 1, 0)\n    # sink edges for each time layer\n    for i in range(lim):\n        add(i * n, SNK, k, c * i)\n    # wait edges: stay in same node from one time step to the next\n    for i in range(n):\n        for j in range(lim - 1):\n            add(i + j * n, i + (j + 1) * n, k, 0)\n    # road edges\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for i in range(lim - 1):\n            for j in range(k - 1, -1, -1):\n                add(x + i * n, y + (i + 1) * n, 1, d * (2 * j + 1))\n                add(y + i * n, x + (i + 1) * n, 1, d * (2 * j + 1))\n    print(min_cost_flow())\n\nif __name__ == \"__main__\":\n    import sys\n    sys.setrecursionlimit(1000000)\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.3947389561508317e-05, 0.0, -3.576278118089249e-07, -0.0002493547508493066, -0.0025373664684593678, -1.1920928244535389e-07, -0.02328970469534397, -2.142949342727661, -0.4155429005622864, -0.07917250692844391, -0.06518644839525223, -2.861018856492592e-06, -2.622600959512056e-06, -1.1920928244535389e-07, -9.536738616588991e-07, -1.5497195136049413e-06, -0.0003496989083942026, -0.5137743353843689, -0.001434488920494914, -3.290122185717337e-05, -0.0012400802224874496, -1.1920928244535389e-07, -2.0265558760002023e-06, -1.7881233361549675e-05, -0.0016465928638353944, -0.0005098473629914224, 0.0, -9.536738616588991e-07, -6.198863957251888e-06, 0.0, -1.0967194612021558e-05, 0.0, -5.960462772236497e-07, -6.389413465512916e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -8.344646857949556e-07, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -1.7881377516459906e-06, -4.768370445162873e-07, -7.533743337262422e-05, -0.20515784621238708, -0.0003401654539629817, -0.02518884278833866, -1.0967194612021558e-05, -1.2516897186287679e-05, -4.887569048150908e-06, -0.03606157377