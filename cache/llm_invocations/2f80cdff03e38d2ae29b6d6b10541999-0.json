{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n#define int long long\nconst int N = 1000000;\nint fr[N+2], src, snk;\nvector<int> gr[N+2];\nconst int INF = 1e9;\nstruct Edge { int a,b,f,c,d; };\nvector<Edge> ed;\nvector<int> adj[N+2];\nvoid addEdge(int a, int b, int cap, int cost) {\n    ed.push_back({a,b,0,cap,cost});\n    adj[a].push_back(ed.size()-1);\n    ed.push_back({b,a,0,0,-cost});\n    adj[b].push_back(ed.size()-1);\n}\nint dis[N+2], inq[N+2], mnf[N+2], pth[N+2];\npair<int,int> spfa(int n) {\n    for (int i=0;i<=n;++i) dis[i]=INF;\n    queue<int> q; q.push(src);\n    dis[src]=0; inq[src]=1; mnf[src]=INF;\n    while (!q.empty()) {\n        int u = q.front(); q.pop(); inq[u]=0;\n        for (int id : adj[u]) {\n            int v = ed[id].b;\n            if (ed[id].c > ed[id].f && dis[v] > dis[u] + ed[id].d) {\n                dis[v] = dis[u] + ed[id].d;\n                pth[v] = id;\n                mnf[v] = min(mnf[u], ed[id].c - ed[id].f);\n                if (!inq[v]) { q.push(v); inq[v]=1; }\n            }\n        }\n    }\n    if (dis[snk] == INF) return {0,0};\n    int v = snk;\n    while (v != src) {\n        int id = pth[v];\n        ed[id].f += mnf[snk];\n        ed[id^1].f -= mnf[snk];\n        v = ed[id].a;\n    }\n    return {mnf[snk], dis[snk] * mnf[snk]};\n}\npair<int,int> mcmf(int n) {\n    int flow = 0, cost = 0;\n    while (true) {\n        auto p = spfa(n);\n        if (!p.first) break;\n        flow += p.first;\n        cost += p.second;\n    }\n    return {flow, cost};\n}\nint32_t main() {\n    ios_base::sync_with_stdio(0); cin.tie(0);\n    int n, m, k, c, d; cin >> n >> m >> k >> c >> d;\n    for (int i=1; i<=k; ++i) { int x; cin >> x; fr[x]++; }\n    for (int i=1; i<=m; ++i) {\n        int u, v; cin >> u >> v;\n        gr[u].push_back(v); gr[v].push_back(u);\n    }\n    src = 0; snk = 100 * n + n + 1;\n    for (int t = 0; t < 100; ++t) {\n        for (int i = 1; i <= n; ++i) {\n            addEdge(n*t+i, n*(t+1)+i, k, 0);\n            for (int x : gr[i])\n                for (int cp = 1; cp <= k; ++cp)\n                    addEdge(n*t+i, n*(t+1)+x, 1, d * (2*cp - 1));\n        }\n    }\n    for (int i = 1; i <= n; ++i)\n        if (fr[i]) addEdge(src, i, fr[i], 0);\n    for (int t = 0; t <= 100; ++t)\n        addEdge(n*t+1, snk, k, c * t);\n    cout << mcmf(snk).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long INF = 1000000000L;\n    static int src, snk;\n    static ArrayList<Edge> ed = new ArrayList<>();\n    static ArrayList<Integer>[] adj;\n    static long[] dis;\n    static int[] inq, pth;\n    static long[] mnf;\n\n    static class Edge {\n        int a, b;\n        long f, c, d;\n        Edge(int a, int b, long f, long c, long d) {\n            this.a = a;\n            this.b = b;\n            this.f = f;\n            this.c = c;\n            this.d = d;\n        }\n    }\n\n    static void addEdge(int a, int b, long cap, long cost) {\n        ed.add(new Edge(a, b, 0, cap, cost));\n        adj[a].add(ed.size() - 1);\n        ed.add(new Edge(b, a, 0, 0, -cost));\n        adj[b].add(ed.size() - 1);\n    }\n\n    static long[] spfa(int n) {\n        Arrays.fill(dis, 0, n + 1, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.add(src);\n        dis[src] = 0;\n        inq[src] = 1;\n        mnf[src] = INF;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = 0;\n            for (int id : adj[u]) {\n                Edge e = ed.get(id);\n                int v = e.b;\n                if (e.c > e.f && dis[v] > dis[u] + e.d) {\n                    dis[v] = dis[u] + e.d;\n                    pth[v] = id;\n                    mnf[v] = Math.min(mnf[u], e.c - e.f);\n                    if (inq[v] == 0) {\n                        q.add(v);\n                        inq[v] = 1;\n                    }\n                }\n            }\n        }\n        if (dis[snk] == INF) return new long[]{0, 0};\n        int v = snk;\n        while (v != src) {\n            int id = pth[v];\n            Edge e = ed.get(id);\n            e.f += mnf[snk];\n            ed.get(id ^ 1).f -= mnf[snk];\n            v = e.a;\n        }\n        return new long[]{mnf[snk], dis[snk] * mnf[snk]};\n    }\n\n    static long[] mcmf(int n) {\n        long flow = 0, cost = 0;\n        while (true) {\n            long[] p = spfa(n);\n            if (p[0] == 0) break;\n            flow += p[0];\n            cost += p[1];\n        }\n        return new long[]{flow, cost};\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        int[] fr = new int[n + 2];\n        for (int i = 1; i <= k; i++) {\n            int x = sc.nextInt();\n            fr[x]++;\n        }\n        ArrayList<Integer>[] gr = new ArrayList[n + 2];\n        for (int i = 1; i <= n; i++) gr[i] = new ArrayList<>();\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            gr[u].add(v);\n            gr[v].add(u);\n        }\n        src = 0;\n        snk = 100 * n + n + 1;\n        int maxNodes = snk + 1;\n        adj = new ArrayList[maxNodes];\n        for (int i = 0; i < maxNodes; i++) adj[i] = new ArrayList<>();\n        dis = new long[maxNodes];\n        inq = new int[maxNodes];\n        pth = new int[maxNodes];\n        mnf = new long[maxNodes];\n        for (int t = 0; t < 100; t++) {\n            for (int i = 1; i <= n; i++) {\n                addEdge(n * t + i, n * (t + 1) + i, k, 0);\n                for (int x : gr[i]) {\n                    for (int cp = 1; cp <= k; cp++) {\n                        addEdge(n * t + i, n * (t + 1) + x, 1, d * (2L * cp - 1));\n                    }\n                }\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            if (fr[i] > 0) addEdge(src, i, fr[i], 0);\n        }\n        for (int t = 0; t <= 100; t++) {\n            addEdge(n * t + 1, snk, k, c * t);\n        }\n        long[] result = mcmf(snk);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -1.1920928244535389e-07, -1.9192511899746023e-05, -3.957670196541585e-05, 0.0, -0.004078523721545935, -0.01462489366531372, -0.00034540885826572776, 0.0, -0.010930072516202927, -0.0005544078885577619, -1.0251946150674485e-05, -0.0001728385395836085, -0.3156103491783142, -0.12692983448505402, -1.6689160474925302e-05, -1.1920928244535389e-07, -0.10021056979894638, -0.0005538121913559735, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.1470757676288486e-05, -0.00012373158824630082, -0.0035618215333670378, -0.00012337400403339416, -3.6954811548639555e-06, -0.44128644466400146, -0.08291317522525787,