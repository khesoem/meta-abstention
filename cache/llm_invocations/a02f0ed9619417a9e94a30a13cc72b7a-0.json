 _ in range(cnt+1)]  # f[i][j] for i=0..cnt, j=0..m-1\n    if cnt >= 0:\n        for i in range(m):\n            mat = [[0]*(m+1) for _ in range(m+1)]\n            for j in range(m+1):\n                mat[j][i] = 1\n                mat[j][j] = 1\n            f[0][i] = mat\n\n        # compute f[i][j] for i=1..cnt\n        for i in range(1, cnt+1):\n            pre = [None]*m\n            suf = [None]*m\n            pre[0] = f[i-1][0]\n            for j in range(1, m):\n                pre[j] = mat_mul(pre[j-1], f[i-1][j], m)\n            suf[m-1] = f[i-1][m-1]\n            for j in range(m-2, -1, -1):\n                suf[j] = mat_mul(f[i-1][j], suf[j+1], m)\n            f[i][0] = suf[0]\n            for j in range(1, m):\n                f[i][j] = mat_mul(suf[j], pre[j-1], m)\n\n        cur = 0\n        for i in range(cnt, -1, -1):\n            while dig[i] > 0:\n                g = mat_mul(g, f[i][cur], m)\n                cur = (cur + 1) % m\n                dig[i] -= 1\n\n    ans = sum(g[0][j] for j in range(m+1)) % MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.01173203345388174, -0.0003500564198475331, 0.0, -5.960462772236497e-07, -0.00021550717065110803, -0.6106172800064087, -4.768360213347478e-06, -0.006716414820402861, -0.38689523935317993, 0.0, 0.0, -2.7418097943154862e-06, -0.0006521005416288972, -9.63164638960734e-05, -0.2552351951599121, -0.0406465046107769, -5.125986263010418e-06, -1.3828182090946939e-05, -3.2186455882765586e-06, -0.005463193170726299, -0.048913635313510895, 0.0, -6.198863957251888e-06, -0.0012680593645200133, 0.0, -0.004078523721545935, -6.794906312279636e-06, -0.0021757043432444334, -0.5363735556602478, -0.001321515068411827, 0.0, -0.014845024794340134, -4.768370445162873e-07, -1.1920928244535389e-07, -0.00523636257275939, -0.17525649070739746, -0.0006358985556289554, -2.3841855067985307e-07, -0.2847236394882202, -0.2730812728404999, -0.0