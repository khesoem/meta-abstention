t.close();\n    }\n\n    private static long exp(long base, long e) {\n        if (e <= 0L) {\n            return 1L;\n        }\n        if (e == 1L) {\n            return base % MOD;\n        }\n        long half = exp(base, e / 2L);\n        half = half * half % MOD;\n        if ((e & 1L) == 1L) {\n            half = half * base % MOD;\n        }\n        return half;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <cstdint>\n\nusing namespace std;\n\nconst long long MOD = 998244353LL;\n\nlong long pow_mod(long long base, long long e) {\n    if (e <= 0) return 1LL;\n    long long result = 1LL;\n    long long b = base;\n    while (e > 0) {\n        if (e & 1LL) {\n            result = (unsigned long long)result * b % MOD;\n        }\n        b = (unsigned long long)b * b % MOD;\n        e >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    long long N, M, L, R;\n    cin >> N >> M >> L >> R;\n\n    // Compute squares with overflow mimicking Java's signed overflow\n    unsigned long long prod = (unsigned long long)N * (unsigned long long)M;\n    long long squares = (long long)prod;\n\n    long long number = R - L + 1;\n    long long computed = pow_mod(number, squares);\n    long long inv2 = (MOD + 1) / 2;\n    long long answer;\n\n    if (squares % 2 == 1) {\n        answer = computed;\n    } else if (number % 2 == 0) {\n        answer = computed * inv2 % MOD;\n    } else {\n        answer = (computed + 1) * inv2 % MOD;\n    }\n\n    cout << answer << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.07287787614041e-05, 0.0, 0.0, -8.05822346592322e-05, -1.0847986231965479e-05, -1.1920928244535389e-07, -7.152555099310121e-07, -0.25195053219795227, -0.31338104605674744, 0.0, -0.05348026379942894, -0.06457981467247009, -6.198863957251888e-06, -0.20237015