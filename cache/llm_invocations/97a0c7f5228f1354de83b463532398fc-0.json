 n;\n    cin >> n;\n    cout << compute(n) << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\ndef digit_len(n: int) -> int:\n    length = 0\n    while n:\n        n //= 10\n        length += 1\n    return length\n\ndef max_repunit(n: int) -> int:\n    d = digit_len(n)\n    cur = 0\n    mul = 1\n    for _ in range(d):\n        cur += mul\n        mul *= 10\n    if cur <= n:\n        return cur\n    return (cur - 1) // 10\n\ndef compute(n: int) -> int:\n    if n <= 6:\n        return n\n    if n <= 11:\n        return 13 - n\n    r = max_repunit(n)\n    more = r * 10 + 1\n    if n % r == 0:\n        t = n // r\n        if n <= more // 2 + r:\n            return digit_len(r) * t\n        else:\n            cur = compute(more - n)\n            return digit_len(more) + cur\n    else:\n        low = (n // r) * r\n        high = (n // r + 1) * r  # high is computed but not used in original code\n        ans = compute(low) + compute(n - low)\n        if n > more // 2:\n            ans = min(compute(low) + compute(n - low), digit_len(more) + compute(more - n))\n        return ans\n\ndef main():\n    n = int(input().strip())\n    print(compute(n))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.290122185717337e-05, -3.576278118089249e-07, -4.768370445162873e-07, -0.00013302871957421303, -0.4744095206260681, -1.6689286894688848e-06, -1.1920928244535389e-07, -1.0728830375228426e-06, -0.693158745765686, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -2.622600959512056e-06, -0.005651685409247875, -4.768370445162873e-07, 0.0, -8.344646857949556e-07, 0.0, 0.0, -4.494089080253616e-05, 0.0, -0.0003718638326972723, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0