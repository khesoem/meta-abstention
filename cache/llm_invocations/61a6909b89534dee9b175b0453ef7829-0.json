nter += 1;\n            continue;\n        }\n        ans += compute(key.first, key.second);\n    }\n    ans %= MOD2;\n    cout << (long long)ans;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMOD1 = 998244353\nMOD2 = 1000000007\nMAXN = 1000005\npow10 = [1] * 15\ngood = [\"\"] * MAXN\nlenlist = [[] for _ in range(7)]  # index 0..6\nok = [[[] for _ in range(7)] for _ in range(7)]  # ok[i][j] list\nsum_ = [[0] * 7 for _ in range(7)]  # sum[i][j]\ncounter = 1  # global counter\n\ndef to_int(s: str) -> int:\n    res = 0\n    for c in s:\n        res = res * 10 + (ord(c) - 48)\n    return res\n\ndef compute(cur: str, maxlen: int) -> int:\n    global counter\n    if maxlen == -1:\n        return 0\n    L = maxlen // 2\n    R = maxlen - L\n    if maxlen == 1:\n        L = 1\n        R = 0\n    res = (counter - to_int(cur)) % MOD1\n    counter += 1\n    for left in lenlist[L]:\n        res = (res + (-to_int(cur + left) + counter)) % MOD1\n        counter += 1\n        if len(left) == L:\n            c = to_int(cur + left) % MOD1\n            for o in range(1, R + 1):\n                cnst = (counter - c * pow10[o]) % MOD1\n                pos = bisect.bisect_left(ok[R][o], (MOD1 - cnst) % MOD1)\n                res = (res + len(ok[R][o]) * cnst + sum_[R][o] - MOD1 * (len(ok[R][o]) - pos)) % MOD1\n            counter += len(lenlist[R])\n    return res\n\ndef main():\n    global counter\n    data = sys.stdin.read().strip()\n    if not data:\n        return\n    n = int(data)\n    s = str(n)\n    N = len(s)\n    pow10[0] = 1\n    for i in range(1, 15):\n        pow10[i] = pow10[i-1] * 10\n\n    # generate good and lenlist\n    for i in range(MAXN):\n        good[i] = str(i)\n        now = good[i]\n        while len(now) <= 6:\n            lenlist[len(now)].append(now)\n            now = \"0\" + now\n\n    # build ok and sum\n    for i in range(1, 7):\n        # copy from previous length\n        for key in lenlist[i-1]:\n            lenlist[i].append(key)\n        lenlist[i].sort()\n        for j, key in enumerate(lenlist[i]):\n            ok[i][len(key)].append((j - int(key)) % MOD1)\n        for j in range(1, i+1):\n            ok[i][j].sort()\n            sum_[i][j] = sum(ok[i][j])\n\n    # build Q\n    Q = []\n    cur = \"\"\n    for idx, ch in enumerate(s):\n        digit = ord(ch) - 48\n        for j in range(10):\n            if j == digit:\n                continue\n            if idx == 0 and j == 0:\n                continue\n            cur += chr(48 + j)\n            if j <= digit:\n                Q.append((cur, len(s) - idx - 1))\n            else:\n                Q.append((cur, len(s) - idx - 2))\n            cur = cur[:-1]\n        cur += ch\n        Q.append((cur, 0))\n\n    Q.sort(key=lambda x: x[0])\n    ans = 0\n    for key in Q:\n        if s[len(key[0]) - 1] == key[0][-1]:\n            ans = (ans + (-to_int(key[0]) + counter)) % MOD1\n            counter += 1\n            continue\n        ans = (ans + compute(key[0], key[1])) % MOD1\n\n    ans %= MOD2\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.10218042135238647, -1.7881233361549675e-05, 0.0, -2.3841855067985307e-07, -0.001538880169391632, -0.0007298904820345342, -1.6689160474925302e-05, -0.000432278640801087, -0.01815335638821125, -1.9073468138230965e-06, -4.768370445162873e-07, -0.0004325169720686972, -0.0001984637783607468, -4.768370445162873e-07, -3.814689989667386e-06, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -3.3378546504536644e-06, 0.0, 0.0, -3.814689989667386e-06, -1.4305104514278355e-06, -0.0015061474405229092, -3.6954811548639555e-06, -2.3841855067985307e-07, -5.960462772236497e-07, -7.5101570