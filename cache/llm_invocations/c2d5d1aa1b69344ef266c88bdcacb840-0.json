    for (LL i = !A; i <= 9; i++) DFS2(A+1, B*10+i);\n    }\n}\n\nint main() {\n    for (int i = 0; i < 7; i++) val[i] = new LL[sz[i]];\n    scanf(\"%lld\", &n);\n    DFS1(0, 0);\n    for (int i = 0; i < 7; i++) sort(val[i], val[i] + cnt[i]);\n    Cnt2 = -1;\n    DFS2(0, 0);\n    printf(\"%lld\", ans);\n    for (int i = 0; i < 7; i++) delete[] val[i];\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nMod1 = 998244353\nMod2 = 1000000007\n\nans = 0\nn = 0\nCnt1 = 0\nsum_arr = [0] * 7\nval = [[] for _ in range(7)]\nTpow = [1, 10, 100, 1000, 10000, 100000, 1000000]\nCnt2 = 0\n\ndef DFS1(A, B):\n    global Cnt1, sum_arr, val\n    if A == 7:\n        return\n    t = (Cnt1 - B) % Mod1\n    val[A].append(t)\n    sum_arr[A] += t\n    Cnt1 += 1\n    for i in range(10):\n        DFS1(A + 1, B * 10 + i)\n\ndef check(x):\n    Cut = 1000000\n    return x * Cut + 999999 <= n and x * Cut * 10 > n\n\ndef DFS2(A, B):\n    global ans, Cnt2, Cnt1, sum_arr, val\n    if B > n:\n        return\n    if check(B):\n        for i in range(7):\n            cur = (Cnt2 + 1 - B * Tpow[i]) % Mod1\n            target = (Mod1 - cur) % Mod1\n            pos = bisect.bisect_left(val[i], target)\n            cnt_i = len(val[i])\n            ans = (ans + sum_arr[i] + cur * cnt_i - Mod1 * (cnt_i - pos)) % Mod2\n        Cnt2 += Cnt1\n    else:\n        Cnt2 += 1\n        ans = (ans + ((Cnt2 - B) % Mod1)) % Mod2\n        start = 1 if A == 0 else 0\n        for i in range(start, 10):\n            DFS2(A + 1, B * 10 + i)\n\ndef main():\n    global n, Cnt1, Cnt2, ans, sum_arr, val\n    n = int(sys.stdin.readline().strip())\n    DFS1(0, 0)\n    for i in range(7):\n        val[i].sort()\n    Cnt2 = -1\n    DFS2(0, 0)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs":