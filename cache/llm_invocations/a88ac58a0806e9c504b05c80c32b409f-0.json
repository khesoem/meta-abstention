n {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        int n1 = n / 2;\n        List<Integer> a1 = new ArrayList<>();\n        List<Integer> a2 = new ArrayList<>();\n\n        generateSumsLeft(a, a1, 0, 0, n1, m);\n        generateSumsRight(a, a2, n1, 0, n, m);\n\n        // Remove duplicates and sort a1\n        Set<Integer> set = new HashSet<>(a1);\n        a1 = new ArrayList<>(set);\n        Collections.sort(a1);\n\n        int ans = 0;\n        for (int val : a2) {\n            int target = m - val;\n            int pos = binarySearchLeft(a1, target);\n            if (pos > 0 && ans < (a1.get(pos - 1) + val)) {\n                ans = a1.get(pos - 1) + val;\n            }\n        }\n\n        System.out.println(ans);\n    }\n\n    private static void generateSumsLeft(int[] a, List<Integer> result, int idx, int currentSum, int n1, int m) {\n        if (idx == n1) {\n            result.add(currentSum % m);\n        } else {\n            generateSumsLeft(a, result, idx + 1, (currentSum + a[idx]) % m, n1, m);\n            generateSumsLeft(a, result, idx + 1, currentSum, n1, m);\n        }\n    }\n\n    private static void generateSumsRight(int[] a, List<Integer> result, int idx, int currentSum, int n, int m) {\n        if (idx == n) {\n            result.add(currentSum % m);\n        } else {\n            generateSumsRight(a, result, idx + 1, (currentSum + a[idx]) % m, n, m);\n            generateSumsRight(a, result, idx + 1, currentSum, n, m);\n        }\n    }\n\n    private static int binarySearchLeft(List<Integer> list, int target) {\n        int left = 0;\n        int right = list.size();\n        while (left < right) {\n            int mid = (left + right) / 2;\n            if (list.get(mid) < target) {\n                left = mid + 1;