ic class Edge {\n        int to, cap, flow, cost;\n        Edge(int t, int c, int f, int co) {\n            to = t;\n            cap = c;\n            flow = f;\n            cost = co;\n        }\n    }\n\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] adj = new ArrayList[N];\n    static long[] dist = new long[N];\n    static int[] pred = new int[N];\n    static int[] pe = new int[N];\n    static boolean[] inq = new boolean[N];\n    static long answer = 0;\n\n    static int residual(int id) {\n        return edges.get(id).cap - edges.get(id).flow;\n    }\n\n    static void addEdge(int u, int v, int capacity, int costValue) {\n        adj[u].add(edges.size());\n        edges.add(new Edge(v, capacity, 0, costValue));\n        adj[v].add(edges.size());\n        edges.add(new Edge(u, 0, 0, -costValue));\n    }\n\n    static void pushFlow() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(pred, -1);\n        Arrays.fill(pe, -1);\n        Arrays.fill(inq, false);\n\n        dist[SOURCE] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.add(SOURCE);\n        inq[SOURCE] = true;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n\n            for (int id : adj[u]) {\n                if (residual(id) == 0) continue;\n                int v = edges.get(id).to;\n                long nd = dist[u] + edges.get(id).cost;\n                if (dist[v] > nd) {\n                    dist[v] = nd;\n                    pred[v] = u;\n                    pe[v] = id;\n                    if (!inq[v]) {\n                        inq[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n\n        for (int cur = TARGET; cur != SOURCE; cur = pred[cur]) {\n            int id = pe[cur];\n            edges.get(id).flow++;\n            edges.get(id ^ 1).flow--;\n        }\n        answer += dist[TARGET];\n    }\n\n    public static void 