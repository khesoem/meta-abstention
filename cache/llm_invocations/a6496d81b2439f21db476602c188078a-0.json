        }\n        }\n    }\n}\n\nvoid augment() {\n    int f = K;\n    int cur = T;\n    while (cur != S) {\n        int prev = adj[cur][par_edge[cur]].to;\n        int idx = adj[cur][par_edge[cur]].rev;\n        f = min(f, adj[prev][idx].cap);\n        cur = prev;\n    }\n    \n    total_flow += f;\n    total_cost += f * dist[T];\n    \n    cur = T;\n    while (cur != S) {\n        int prev = adj[cur][par_edge[cur]].to;\n        int idx = adj[cur][par_edge[cur]].rev;\n        adj[cur][par_edge[cur]].cap += f;\n        adj[prev][idx].cap -= f;\n        cur = prev;\n    }\n}\n\nint node(int v, int t) {\n    return v + t * N;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N >> M >> K >> C >> D;\n    S = MAXN - 2;\n    T = MAXN - 1;\n    int max_t = N + K;\n    \n    for (int i = 0; i < K; ++i) {\n        cin >> u;\n        add_edge(S, node(u, 0), 0, 1);\n    }\n    \n    for (int t = 0; t <= max_t; ++t) {\n        add_edge(node(1, t), T, C * t, K);\n    }\n    \n    for (int v = 1; v <= N; ++v) {\n        for (int t = 0; t < max_t; ++t) {\n            add_edge(node(v, t), node(v, t + 1), 0, K);\n        }\n    }\n    \n    while (M--) {\n        cin >> u >> v;\n        for (int i = 1; i <= K; ++i) {\n            for (int t = 0; t < max_t; ++t) {\n                int w = D * (2 * i - 1);\n                add_edge(node(u, t), node(v, t + 1), w, 1);\n                add_edge(node(v, t), node(u, t + 1), w, 1);\n            }\n        }\n    }\n    \n    while (total_flow < K) {\n        dijkstra();\n        augment();\n    }\n    \n    cout << total_cost;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    K = int