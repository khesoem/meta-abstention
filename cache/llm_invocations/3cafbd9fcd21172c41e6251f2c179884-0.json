e(size):\n                    res[i][j] = (res[i][j] + a_im * B[mid][j]) % MOD\n    return res\n\ndef mat_identity(size):\n    \"\"\"Return identity matrix of given size.\"\"\"\n    I = [[0] * size for _ in range(size)]\n    for i in range(size):\n        I[i][i] = 1\n    return I\n\ndef mat_move(base, step, k):\n    \"\"\"Apply cyclic shift to rows and columns of base matrix.\n    For indices 0..k-1, shift by step modulo k; index k stays fixed.\"\"\"\n    size = k + 1\n    res = [[0] * size for _ in range(size)]\n    for i in range(size):\n        new_i = (i + step) % k if i < k else k\n        for j in range(size):\n            new_j = (j + step) % k if j < k else k\n            res[new_i][new_j] = base[i][j]\n    return res\n\ndef solve():\n    import sys\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    size = k + 1\n\n    # Build A[0]\n    A = []\n    A0 = mat_identity(size)\n    # Set first row (index 0) to all ones\n    for j in range(size):\n        A0[0][j] = 1\n    A.append(A0)\n\n    # Extract digits of n in base k (least significant first)\n    V = []\n    temp_n = n\n    while temp_n > 0:\n        V.append(temp_n % k)\n        temp_n //= k\n\n    # Build A[1..len(V)] using exponentiation by squaring\n    for idx in range(len(V)):\n        x = A[idx]  # base matrix for this digit\n        # Initialize A[idx+1] as identity\n        A_next = mat_identity(size)\n        power = k\n        p = 0\n        while power:\n            if power & 1:\n                # Multiply A_next by Move(x, (power ^ 1) << p)\n                shift = (power ^ 1) << p\n                moved = mat_move(x, shift, k)\n                A_next = mat_mul(A_next, moved, size)\n            # Update x = Move(x, 1 << p) * x\n            shift2 = 1 << p\n            moved2 = mat_move(x, shift2, k)\n            x = mat_mul(moved2, x, size)\n            power >>= 1\n            p += 1\n        A.append(A_next)\n\n    # Final computation: iterate over digits from most significant to least\n    ans = [0] * size\n    ans[k] = 1  # index k corresponds to the extra row (k+1 in 1-indexed)\n    step = 0\n    for T in range(len(V) - 1, -1, -1):\n        cur = V[T]\n        if cur:\n            tmp = [0] * size\n            for times in range(cur):\n                # copy ans to tmp, then zero ans\n                for i in range(size):\n                    tmp[i] = ans[i]\n                    ans[i] = 0\n                B = mat_move(A[T], times + step, k)\n                for i in range(size):\n                    for j in range(size):\n                        ans[i] = (ans[i] + tmp[j] * B[i][j]) % MOD\n        step += cur\n\n    res = sum(ans) % MOD\n    print(res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010048838157672435, 0.0, -1.1920928244535389e-07, -0.0008157739648595452, -0.5613577961921692, -1.1920928244535389e-07, -0.0024764842819422483, -0.03824210911989212, -0.008614876307547092, 0.0, -0.0007098776986822486, -7.867782187531702e-06, -2.3841855067985307e-07, -0.0001262346631847322, -0.03837473317980766, -0.7219380736351013, -0.0953269973397255, 0.0, -0.0906246080994606, -1.1920928244535389e-07, 0.0, -0.2014676183462143, -0.1924576759338379, -9.83428253675811e-05, -2.50339189733495e-06, -0.18877942860126495, -0.05360998213291168, -0.00016950124700088054, -0.7327591180801392, -0.18464507162570953, -0.03854404762387276, -0.4245205521583557, -0.0004677870310842991, -0.10579970479011536, 0.0, -0.12721307575702667, -0.2067720592021942, -1.7523612768854946e-05, -0.04653850197792053, 0.0, -0.315280944108963, -1.1920928244535389e-07, -4.5536911784438416e-05, 0.0, -0.16028788685798645, -2.0265558760002023e-06, -7.497983460780233e-05, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, -1.5497195136049413e-06, -1.1920928244535389e-07, -0.0002134810492862016, 0.0, -2.3841855067985307e-07, 0.0, -4.768370445162873