ff;\n            best = cand;\n        }\n    }\n    \n    cout << best.first << '/' << best.second;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef main():\n    x, y, n = map(int, input().split())\n    \n    candidates = []\n    target = x / y\n    \n    if y <= 1:\n        print(f\"{x}/{y}\")\n        return\n    \n    for d in range(1, n + 1):\n        num_floor = math.floor(target * d)\n        num_ceil = math.ceil(target * d)\n        candidates.append((num_floor, d))\n        if num_floor != num_ceil:\n            candidates.append((num_ceil, d))\n    \n    best = (0, 1)\n    min_diff = 1e30\n    \n    for num, den in candidates:\n        if den == 0:\n            continue\n        diff = abs(target - num / den)\n        if diff < min_diff:\n            min_diff = diff\n            best = (num, den)\n    \n    print(f\"{best[0]}/{best[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.917721035890281e-05, -1.6689286894688848e-06, -1.1920928244535389e-07, -4.053033626405522e-05, -0.023331165313720703, -0.6326094269752502, -0.0005975367967039347, -7.986990567587782e-06, -2.1934269170742482e-05, -1.9073468138230965e-06, -0.08954360336065292, -0.00018106251081917435, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -8.344646857949556e-07, -2.3603161025675945e-05, -0.0001776060671545565, -3.576278118089249e-07, -0.00018368464952800423, -4.768370445162873e-07, -7.271502545336261e-05, -6.9141146923357155e-06, -5.8410845667822286e-05, 0.0, -0.024815397337079048, -5.960462772236497e-07, -2.3007127310847864e-05, -3.576278118089249e-07, -2.0265558760002023e-06, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -3.933898824470816e-06, -0.013316148892045021, -3.576278118089249e-07, -3.933898824470816e-06, -3.57627811