t = { 1, -1, 0, 0 };\n    static final int NEG_INF = -1000000;\n\n    public static int solve(int row, int currentMask, int previousMask) {\n        if (row == rows) {\n            return (previousMask == 0) ? 0 : NEG_INF;\n        }\n        if (memo[row][currentMask][previousMask] != -1) {\n            return memo[row][currentMask][previousMask];\n        }\n        int best = 0;\n        int maxMask = 1 << cols;\n        for (int placement = 0; placement < maxMask; placement++) {\n            int prev = previousMask;\n            int curr = currentMask;\n            int nextRow = maxMask - 1;\n            for (int bit = 0; bit < cols; bit++) {\n                if ((placement & (1 << bit)) != 0) {\n                    if (bit > 0) curr &= ~(1 << (bit - 1));\n                    if (bit < cols - 1) curr &= ~(1 << (bit + 1));\n                    nextRow &= ~(1 << bit);\n                    prev &= ~(1 << bit);\n                }\n            }\n            if (prev != 0) continue;\n            int count = cols - Integer.bitCount(placement);\n            int nextVal = solve(row + 1, nextRow, curr & ~placement);\n            best = Math.max(best, count + nextVal);\n        }\n        memo[row][currentMask][previousMask] = best;\n        return best;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int a = scanner.nextInt();\n        int b = scanner.nextInt();\n        rows = Math.max(a, b);\n        cols = Math.min(a, b);\n        memo = new int[rows][1 << cols][1 << cols];\n        for (int i = 0; i < rows; i++) {\n            for (int j = 0; j < (1 << cols); j++) {\n                Arrays.fill(memo[i][j], -1);\n            }\n        }\n        System.out.println(solve(0, (1 << cols) - 1, 0));\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\nimport java.util.Arrays;\nimport java.u