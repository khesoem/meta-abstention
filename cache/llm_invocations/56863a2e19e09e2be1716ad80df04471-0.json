{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.math.BigInteger;\nimport java.util.stream.IntStream;\n\npublic class Main {\n    static final int MOD = 998244353;\n    static int add(int a, int b) {\n        int c = a + b;\n        if (c >= MOD) return c - MOD;\n        if (c < 0) return c + MOD;\n        return c;\n    }\n    static int mul(int a, int b) { return (int)((long)a * b % MOD); }\n    static int mul(int... x) {\n        return IntStream.of(x).reduce(1, (a, b) -> mul(a, b));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(new BufferedOutputStream(System.out));\n        String[] parts = br.readLine().split(\" \");\n        int n = Integer.parseInt(parts[0]);\n        int m = Integer.parseInt(parts[1]);\n        int k = Integer.parseInt(parts[2]);\n        int invm = BigInteger.valueOf(m).modInverse(BigInteger.valueOf(MOD)).intValue();\n\n        // Precompute Stirling numbers up to k using 1D array\n        int[] stirPrev = new int[k + 1];\n        int[] stirCurr = new int[k + 1];\n        stirPrev[0] = 1; // S(0,0)=1\n        for (int i = 1; i <= k; i++) {\n            stirCurr[0] = 0;\n            for (int j = 1; j <= i; j++) {\n                stirCurr[j] = add(mul(stirPrev[j], i - 1), stirPrev[j - 1]);\n            }\n            int[] temp = stirPrev;\n            stirPrev = stirCurr;\n            stirCurr = temp;\n        }\n        int[] stir = stirPrev; // S(k, j) for j=0..k\n\n        // Compute pVal using recurrence but with streams for inner sum\n        int[] pVal = new int[k + 1];\n        pVal[0] = 1;\n        int md = n;\n        int prp = 1;\n        for (int i = 1; i <= k; i++) {\n            prp = mul(prp, md, invm);\n            md = add(md, -1);\n            final int iFinal = i;\n            final int prpFinal = prp;\n            int sub = IntStream.rangeClosed(1, i - 1)\n                .map(j -> mul(stir[iFinal][j], ((iFinal - j) % 2 == 1) ? pVal[j] : add(0, -pVal[j])))\n                .reduce(prpFinal, (a, b) -> add(a, b));\n            pVal[i] = sub;\n        }\n        pw.println(pVal[k]);\n        pw.close();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <algorithm>\n\nusing namespace std;\n\nconst int MOD = 998244353;\n\nint add(int a, int b) {\n    int c = a + b;\n    if (c >= MOD) return c - MOD;\n    if (c < 0) return c + MOD;\n    return c;\n}\n\nint mul(int a, int b) {\n    return (int)((long long)a * b % MOD);\n}\n\nint mul(int a, int b, int c) {\n    return mul(mul(a, b), c);\n}\n\nint modpow(int base, int exp) {\n    int res = 1;\n    while (exp) {\n        if (exp & 1) res = mul(res, base);\n        base = mul(base, base);\n        exp >>= 1;\n    }\n    return res;\n}\n\nint modinv(int x) {\n    return modpow(x, MOD - 2);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    int n, m, k;\n    ss >> n >> m >> k;\n\n    int invm = modinv(m);\n\n    // Precompute Stirling numbers up to k (2D array)\n    vector<vector<int>> stir(k + 1, vector<int>(k + 1, 0));\n    stir[0][0] = 1;\n    for (int i = 1; i <= k; ++i) {\n        stir[i][0] = 0;\n        for (int j = 1; j <= i; ++j) {\n            stir[i][j] = add(mul(stir[i-1][j], i - 1), stir[i-1][j-1]);\n        }\n    }\n\n    // Compute pVal\n    vector<int> pVal(k + 1, 0);\n    pVal[0] = 1;\n    int md = n;\n    int prp = 1;\n    for (int i = 1; i <= k; ++i) {\n        prp = mul(prp, md, invm);\n        md = add(md, -1);\n        int sub = prp;\n        for (int j = 1; j <= i - 1; ++j) {\n            int sign = ((i - j) % 2 == 1) ? 1 : -1;\n            int term = mul(stir[i][j], (sign == 1) ? pVal[j] : add(0, -pVal[j]));\n            sub = add(sub, term);\n        }\n        pVal[i] = sub;\n    }\n\n    cout << pVal[k] << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.8\n</confidence>", "token_logprobs": [-0.4913018047809601, -3.218599158572033e-05, 0.0, -1.1920928244535389e-07, -6.294052582234144e-05, -3.9219088648678735e-05, -5.960462772236497e-07, -0.011053166352212429, -2.1457441107486375e-05, 0.0, 0.0, -0.018413323909044266, -2.622600959512056e-06, -2.3841855067985307e-07, 0.0, -0.053479019552469254, -7.152531907195225e-06, -2.3841855067985307e-07, 0.0, -0.0005071069463156164, 0.0, -0.12696333229541779, -0.2014911025762558, 0.0, -0.015688566491007805, -0.31331002712249756, -0.4818151295185089, -8.34461570775602e-06, 0.0, -0.008617003448307514, -0.0009357126546092331, -0.002489089034497738, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, -9.667406266089529e-05, -0.001513170194812119, -0.0007150000892579556, -0.00011860620725201443, -1.0728830375228426e-06, 0.0, 0.0, 0.0, -5.364403477869928e-06, -7.152555099310121e-07, -6.19886395725188