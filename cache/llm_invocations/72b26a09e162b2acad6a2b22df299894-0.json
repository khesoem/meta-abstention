ult[1]\n        return [flow, totalCost]\n\nclass Edge:\n    def __init__(self, from_, to, cost):\n        self.from_ = from_\n        self.to = to\n        self.cost = cost\n\nif __name__ == \"__main__\":\n    program = MinCostMaxFlow()\n    program.main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015395533409900963, -0.0003945688367821276, -1.981667537620524e-06, -5.490809417096898e-05, -0.00218452257104218, -2.696889623621246e-06, -0.38734033703804016, -0.6333258748054504, -0.06429430842399597, -0.3883811831474304, -0.14058178663253784, -0.35074061155319214, -4.320199877838604e-07, -1.9361264946837764e-07, 0.0, -0.0010465048253536224, -0.0005458841915242374, -0.027590671554207802, -0.02057388611137867, -6.704273118884885e-07, -3.128163257315464e-07, -3.128163257315464e-07, -0.3485220670700073, -4.320199877838604e-07, -0.26013365387916565, -1.01710844039917, -0.03931497782468796, -2.3557529857498594e-05, -6.704273118884885e-07, -0.012617009691894054, -0.03836069256067276, -0.5759421586990356, -0.00013417120499070734, -0.00024084746837615967, -0.0002453662164043635, -0.6864801049232483, -9.491498531133402e-06, -7.896309739408025e-07, 0.0, -0.5824460387229919, -0.002244462026283145, -1.3425219549390022e-05, -0.03763790428638458, -0.6948034763336182, -8.2994620242971e-06, -9.088346359931165e-07, -0.08938117325305939, -9.491498531133402e-06, -2.339278580620885e-06, -1.4498052223643754e-05, -2.1008713702030946e-06, -4.320199877838604e-07, -6.704273118884885e-07, -3.128163257315464e-07, -5.512236498361744e-07, -3.128163257315464e-07, -5.157039049663581e-05, -0.002476016292348504, -2.935296834039036e-06, -3.650518920039758e-06, 0.0, -1.9361264946837764e-07, 0.0, -0.027244217693805695, -0.001402144436724484, -1.700132997939363e-05, -0.002514658262953162, -0.061982810497283936, -6.704273118884885e-07, -1.0280383548888494e-06, 0.0, -6.034592388459714e-06, 0.0, -5.512236498361744e-07, -5.512236498361744e-07, -0.030412496998906136, -0.