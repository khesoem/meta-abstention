": {"samples": [{"content": "<translated_code>\nimport java.util.BitSet;\nimport java.util.Scanner;\n\npublic class Main {\n    static final long MOD = 1000000007L;\n\n    static long powRecImpl(long a, long e, int bit, long acc) {\n        if (bit < 0) return acc;\n        acc = (acc * acc) % MOD;\n        if ((e >> bit & 1L) != 0) acc = (acc * a) % MOD;\n        return powRecImpl(a, e, bit - 1, acc);\n    }\n\n    static long powRec(long a, long e) {\n        long acc = 1;\n        return powRecImpl(a, e, 30, acc);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long p = sc.nextLong();\n        long k = sc.nextLong();\n        sc.close();\n\n        BitSet visited = new BitSet((int) p);\n\n        if (k == 1) {\n            System.out.println(powRec(p, p));\n            return;\n        }\n\n        long ans = 0;\n        for (int i = 1; i < p; ++i) {\n            if (!visited.get(i)) {\n                visited.set(i);\n                ++ans;\n                long cur = (i * k) % p;\n                while (!visited.get((int) cur)) {\n                    visited.set((int) cur);\n                    cur = (cur * k) % p;\n                }\n            }\n        }\n\n        System.out.println(powRec(p, ans));\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-4.649054244509898e-05, -3.576278118089249e-07, -2.3841855067985307e-07, -3.2066785934148356e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -0.001178047270514071, -0.1279921680688858, 0.0, 0.0, -2.622600959512056e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.521823135903105e-05, -3.194758028257638e-05, -1.1920928244535389e-07, -0.0034520579501986504, -0.0004320403386373073, -8.4638240878121e-06, -0.2520020604133606, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -0.00043084874050691724, -1.1920928244535389e-07, 0.0, -4.768370445162