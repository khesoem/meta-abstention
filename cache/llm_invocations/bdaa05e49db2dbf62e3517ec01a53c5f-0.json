0; i < m; ++i) {\n        Edge& orig = edges[i];\n        Edge comp;\n        comp.from = orig.to;\n        comp.to = orig.from;\n        comp.capacity = orig.capacity;\n        comp.cost = -orig.cost;\n        comp.flow = orig.capacity;\n        comp.complement = i;\n        orig.complement = edges.size();\n        edges.push_back(comp);\n    }\n    // Build graph adjacency list (indices)\n    vector<vector<int>> g(n);\n    for (int i = 0; i < (int)edges.size(); ++i) {\n        g[edges[i].from].push_back(i);\n    }\n    return g;\n}\n\n// Min-cost flow (Bellman-Ford)\nlong long solveMinCostFlow(const vector<vector<int>>& g, vector<Edge>& edges, int source, int sink, long long all) {\n    int n = g.size();\n    long long mincost = 0;\n    vector<int> d(n);\n    vector<int> inedge(n, -1); // index of edge used to reach vertex\n    while (all > 0) {\n        fill(d.begin(), d.end(), INT_MAX / 2);\n        fill(inedge.begin(), inedge.end(), -1);\n        d[source] = 0;\n        bool updated;\n        for (int iter = 0; iter < n; ++iter) {\n            updated = false;\n            for (int v = 0; v < n; ++v) {\n                if (d[v] == INT_MAX / 2) continue;\n                for (int ei : g[v]) {\n                    Edge& e = edges[ei];\n                    if (e.capacity - e.flow > 0) {\n                        int nd = d[v] + e.cost;\n                        if (d[e.to] > nd) {\n                            d[e.to] = nd;\n                            inedge[e.to] = ei;\n                            updated = true;\n                        }\n                    }\n                }\n            }\n            if (!updated) break;\n        }\n        if (inedge[sink] == -1) break;\n        long long minflow = all;\n        long long sumcost = 0;\n        for (int ei = inedge[sink]; ei != -1; ei = inedge[edges[ei].from]) {\n            Edge& e = edges[ei];\n            if (e.capacity - e.flow < minflow) minflow = e.capacity - e.flow;\n            sumcost += e.cost;\n        }\n        mincost += minflow * sumcost;\n        for (int ei = inedge[sink]; ei != -1; ei = inedge[edges[ei].from]) {\n            Edge& e = edges[ei];\n            e.flow += minflow;\n            edges[e.complement].flow -= minflow;\n        }\n        all -= minflow;\n    }\n    return mincost;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    cin.ignore(); // skip newline after n\n\n    string s;\n    getline(cin, s);\n    // s should have length n, but we trust input\n\n    string line;\n    getline(cin, line);\n    istringstream iss(line);\n    vector<int> a(n);\n    for (int i = 0; i < n; ++i) {\n        iss >> a[i];\n    }\n\n    // Check frequency condition\n    vector<int> f(26, 0);\n    for (char c : s) f[c - 'a']++;\n    for (int i = 0; i < 26; ++i) {\n        if (f[i] > n / 2) {\n            cout << -1 << endl;\n            return 0;\n        }\n    }\n\n    // Swap pairs based on a[i] > a[n-1-i]\n    for (int i = 0; i < n / 2; ++i) {\n        if (a[i] > a[n - 1 - i]) {\n            swap(a[i], a[n - 1 - i]);\n            swap(s[i], s[n - 1 - i]);\n        }\n    }\n\n    // Build edges for min-cost flow\n    vector<Edge> edges;\n    int src = n, sink = n + 1;\n    for (int i = 0; i < n / 2; ++i) {\n        edges.push_back({src, i, 1, 0, 0, -1});\n        edges.push_back({n - 1 - i, sink, 1, 0, 0, -1});\n        for (int j = 0; j < n / 2; ++j) {\n            if (s[i] != s[n - 1 - j]) {\n                int cost = (i == j) ? 0 : a[i];\n                edges.push_back({i, n - 1 - j, 1, cost, 0, -1});\n            }\n        }\n    }\n\n    // Build graph with complements\n    auto g = compileWD(sink + 1, edges);\n\n    // Compute total sum of a\n    long long ans = 0;\n    for (int x : a) ans += x;\n    ans -= solveMinCostFlow(g, edges, src, sink, n / 2);\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.194758028257