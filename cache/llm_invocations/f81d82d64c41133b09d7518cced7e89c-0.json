nt[20];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n        \n        List<Integer> b = new ArrayList<>();\n        int halfSize1 = n / 2 + n % 2;\n        \n        for (int i = 0; i < (1 << halfSize1); i++) {\n            int t = 0;\n            int k = i;\n            for (int j = 0; j < 20; j++) {\n                if ((k & 1) == 1) {\n                    t += a[j];\n                }\n                k = k >> 1;\n            }\n            b.add(t % m);\n        }\n        \n        Collections.sort(b);\n        \n        int otv = 0;\n        int halfSize2 = n / 2;\n        \n        for (int i = 0; i < (1 << halfSize2); i++) {\n            int t = 0;\n            int k = i;\n            for (int j = 0; j < 20; j++) {\n                if ((k & 1) == 1) {\n                    t += a[halfSize1 + j];\n                }\n                k = k >> 1;\n            }\n            t = t % m;\n            \n            int target = m - t - 1;\n            int k = Collections.binarySearch(b, target);\n            if (k < 0) {\n                k = -(k + 1);\n            }\n            \n            int t2 = 0;\n            if (k < b.size()) {\n                t2 = b.get(k);\n                if (t2 > target) {\n                    if (k - 1 >= 0) {\n                        t2 = b.get(k - 1);\n                    }\n                }\n            } else {\n                t2 = b.get(b.size() - 1);\n            }\n            \n            int candidate1 = (t + t2) % m;\n            int candidate2 = (t + b.get(b.size() - 1)) % m;\n            otv = Math.max(otv, Math.max(candidate1, candidate2));\n        }\n        \n        System.out.println(otv % m);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.033100700937212e-05, -8.344646857949556e-07, -1.0728830375228426e-06, -0.0005446380819194019, -2.253030106658116e-05, -0.005234227981418371, -0.21054227650165558, -3.933898824470816e-06, -1.1920922