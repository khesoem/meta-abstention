n        return Double.parseDouble(next());\n    }\n\n    public int nextInt() {\n        return Integer.parseInt(next());\n    }\n\n    public long nextLong() {\n        return Long.parseLong(next());\n    }\n\n    public byte nextByte() {\n        return Byte.parseByte(next());\n    }\n}\n\nclass Task {\n    public void solve() {\n        int w = in.nextInt();\n        int m = in.nextInt();\n\n        while (m != 0) {\n            int mod = m % w;\n            if (mod == 0 || mod == 1) {\n                m = m / w;\n            } else if (mod == w - 1) {\n                m = (m + 1) / w;\n            } else {\n                out.println(\"NO\");\n                return;\n            }\n        }\n        out.println(\"YES\");\n    }\n\n    private InputReader in;\n    private PrintWriter out;\n\n    Task(InputReader in, PrintWriter out) {\n        this.in = in;\n        this.out = out;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <sstream>\n#include <stdexcept>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n#include <iomanip>\n#include <cstdio>\n\nusing namespace std;\n\nclass InputReader {\npublic:\n    istream& stream;\n    string buffer;\n    size_t pos;\n\n    InputReader(istream& s) : stream(s), pos(0) {}\n\n    string next() {\n        while (true) {\n            if (buffer.empty() || pos >= buffer.size()) {\n                if (!getline(stream, buffer)) {\n                    throw runtime_error(\"No more input\");\n                }\n                pos = 0;\n            }\n            while (pos < buffer.size() && isspace(buffer[pos])) {\n                pos++;\n            }\n            if (pos >= buffer.size()) {\n                buffer.clear();\n                continue;\n            }\n            size_t start = pos;\n            while (pos < buffer.size() && !isspace(buffer[pos])) {\n                pos++;\n            }\n            return buffer.substr(start, pos - start);\n        }\n    }\n\n    double nextDouble() {\n        return stod(next());\n    }\n\n    int nextInt() {\n        return stoi(next());\n    }\n\n    long long nextLong() {\n        return stoll(next());\n    }\n};\n\nclass Task {\npublic:\n    void solve() {\n        int w = in.nextInt();\n        int m = in.nextInt();\n\n        while (m != 0) {\n            int mod = m % w;\n            if (mod == 0 || mod == 1) {\n                m = m / w;\n            } else if (mod == w - 1) {\n                m = (m + 1) / w;\n            } else {\n                out << \"NO\" << endl;\n                return;\n            }\n        }\n        out << \"YES\" << endl;\n    }\n\n    InputReader& in;\n    ostream& out;\n\n    Task(InputReader& in, ostream& out) : in(in), out(out) {}\n};\n\nint main() {\n    InputReader in(cin);\n    Task task(in, cout);\n    task.solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002294515579706058, -4.410734163684538e-06, -3.576278118089249e-07, -0.00010287232726113871, -1.0728830375228426e-06, -7.748573807475623e-06, -9.536738616588991e-07, -2.169585604860913e-05, -7.152555099310121e-07, -0.12302244454622269, -4.136476854910143e-05, -9.881961887003854e-05, -4.6491513785440475e-06, -0.07403440773487091, -0.00043096792069263756, -5.018585216021165e-05, -8.344646857949556e-07, -0.5438815355300903, -0.2519305348396301, -0.0019372997339814901, -2.7418097943154862e-06, -0.5795465707778931, -0.6326029300689697, -0.008666404522955418, -4.291525328881107e-06, -0.5877143144607544, -0.42870453000068665, -0.01816752180457115, -1.311301275563892e-06, -0.45774412155151367, -0.6931486129760742, -0.029764186590909958, -8.344646857949556e-07, -0.03424658253788948, -0.11282437294721603, -0.001931350794620812, -4.410734163684538e-06, -0.9748080372810364, -0.38687336444854736, -0.3870010375