         for j in range(st, st + length):\n                t = (cur_root * coef[j + length]) % MOD\n                u = coef[j]\n                coef[j] = (u + t) % MOD\n                coef[j + length] = (u - t) % MOD\n                cur_root = (roots[s] * cur_root) % MOD\n    return coef\n\ndef main():\n    n = int(input()) // 2\n    m = int(input())\n    nums = list(map(int, input().split()))\n    max_num = max(nums) if nums else 0\n    min_size = n * max_num + 1\n    size = 1\n    k = 0\n    while size < min_size:\n        size <<= 1\n        k += 1\n    a = [0] * size\n    for num in nums:\n        a[num] = 1\n    a = number_theoretic_transform(a, k, False)\n    for i in range(len(a)):\n        a[i] = mod_pow(a[i], n)\n    a = number_theoretic_transform(a, k, True)\n    ans = 0\n    for val in a:\n        ans = (ans + val * val) % MOD\n    multiplier = mod_inv(size)\n    result = (((ans * multiplier) % MOD) * multiplier) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00033200893085449934, -0.0001617035741219297, -9.088346359931165e-07, -7.32654589228332e-05, -0.4289189577102661, -0.4758530259132385, -0.25294581055641174, -0.0059342472814023495, -2.816093228830141e-06, -3.128163257315464e-07, 0.0, -1.0280383548888494e-06, -4.320199877838604e-07, -0.018007585778832436, -0.00014203863975126296, -0.06283733248710632, -4.36574100604048e-06, -1.9361264946837764e-07, 0.0, -0.0035590888001024723, -1.9361264946837764e-07, -1.5048530030981055e-06, -3.128163257315464e-07, -7.896309739408025e-07, 0.0, 0.0, -0.011972317472100258, -5.2166411478538066e-05, -3.941161776310764e-05, -0.20144003629684448, -3.650518920039758e-06, -0.00012415809032972902, -9.968312951968983e-06, -2.534558552724775e-05, -1.0280383548888494e-06, -0.042085129767656326, -0.0021853535436093807, -0.24461492896080017, -0.00014251544780563563, -0.06562021374702454, -0.0320722721517086, -0.002667926950380