 if (i + 2 < (int)phone.length () && i > 0 && phone.substr (i, 2) == \"at\")\n\t\t\tpos.pb (mp (i, \"@\"));\n\tfind ();\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nstring phone;\nvector<pair<int, string>> markers;\n\nbool isValid(const string& s) {\n    if (s.empty()) return false;\n    if (s[0] == '.' || s.back() == '.') return false;\n    if (s[0] == '@' || s.back() == '@') return false;\n    \n    int atCount = 0;\n    for (char c : s) {\n        if (c == '@') atCount++;\n        else if (c != '.' && (c < 'a' || c > 'z')) return false;\n    }\n    \n    if (atCount != 1) return false;\n    return true;\n}\n\nstring result = \"\";\nint minLen = INT_MAX;\n\nvoid backtrack(int idx, string current, int balance) {\n    if (idx == (int)markers.size()) {\n        if (isValid(current)) {\n            if (current.length() < minLen || (current.length() == minLen && current < result)) {\n                minLen = current.length();\n                result = current;\n            }\n        }\n        return;\n    }\n    \n    int pos = markers[idx].first + balance;\n    string original = markers[idx].second;\n    \n    // Try replacing with the actual symbol\n    string replacement = (original == \"at\") ? \"@\" : \".\";\n    int replaceLen = (original == \"at\") ? 1 : 1;\n    int removedLen = (original == \"at\") ? 2 : 3;\n    \n    string nextStr = current.substr(0, pos) + replacement + current.substr(pos + removedLen);\n    backtrack(idx + 1, nextStr, balance - (removedLen - replaceLen));\n    \n    // Try not replacing (keep original text)\n    backtrack(idx + 1, current, balance);\n}\n\nint main() {\n    cin >> phone;\n    \n    // Find all occurrences of \"dot\" and \"at\"\n    for (int i = 0; i < (int)phone.length