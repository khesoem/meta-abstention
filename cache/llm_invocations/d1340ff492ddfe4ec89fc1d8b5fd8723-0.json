{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int maxn = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, cnt, ans, a[maxn], x[maxn], y[maxn];\nint head[maxn], pre[maxn], dist[maxn], inq[maxn];\nqueue<int> q;\nstruct edge { int to, cap, cost, nxt; } e[2000010];\nint id(int t, int v) { return t * n + v; }\n\nvoid add(int from, int to, int cap, int cost) {\n    e[cnt] = (edge){to, cap, cost, head[from]}, head[from] = cnt++;\n    e[cnt] = (edge){from, 0, -cost, head[to]}, head[to] = cnt++;\n}\n\nbool spfa(int s, int t) {\n    fill(dist, dist + maxn, INF);\n    q.push(s), dist[s] = 0;\n    while (!q.empty()) {\n        int v = q.front(); q.pop(), inq[v] = 0;\n        for (int i = head[v], u; ~i; i = e[i].nxt) {\n            if (e[i].cap && dist[u = e[i].to] > dist[v] + e[i].cost) {\n                dist[u] = dist[v] + e[i].cost, pre[u] = i;\n                if (!inq[u]) q.push(u), inq[u] = 1;\n            }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid upd(int s, int t) {\n    for (int i = t; i != s; i = e[pre[i] ^ 1].to) {\n        e[pre[i]].cap--, e[pre[i] ^ 1].cap++;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    cin >> n >> m >> k >> c >> d;\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        cin >> a[i], add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        cin >> x[i] >> y[i];\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            for (int j = 1; j <= min(k, 25); j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    \n    a = [0] * (k + 1)\n    for i in range(1, k + 1):\n        a[i] = next(it)\n    \n    x = [0] * (m + 1)\n    y = [0] * (m + 1)\n    for i in range(1, m + 1):\n        x[i] = next(it)\n        y[i] = next(it)\n    \n    # compute maximum node index needed\n    max_node = max(6001, 101 * n + 2)  # source=0, sink=6000, plus time-expanded nodes\n    head = [-1] * max_node\n    e_to = []\n    e_cap = []\n    e_cost = []\n    e_nxt = []\n    \n    def add_edge(fr, to, cap, cost):\n        idx = len(e_to)\n        e_to.append(to)\n        e_cap.append(cap)\n        e_cost.append(cost)\n        e_nxt.append(head[fr])\n        head[fr] = idx\n        # reverse edge\n        e_to.append(fr)\n        e_cap.append(0)\n        e_cost.append(-cost)\n        e_nxt.append(head[to])\n        head[to] = idx + 1\n    \n    def id_time(t, v):\n        return t * n + v\n    \n    S = 0\n    T = 6000\n    \n    # source to initial positions\n    for i in range(1, k + 1):\n        add_edge(S, id_time(0, a[i]), 1, 0)\n    \n    # build time-expanded graph\n    for t in range(0, 101):  # t = 0 .. 100 inclusive\n        # stay edges for nodes 2..n\n        for i in range(2, n + 1):\n            add_edge(id_time(t, i), id_time(t + 1, i), k, c)\n        # node 1 to sink\n        add_edge(id_time(t, 1), T, k, 0)\n        # movement edges\n        limit = min(k, 25)\n        for i in range(1, m + 1):\n            for j in range(1, limit + 1):\n                cost = c + (2 * j - 1) * d\n                add_edge(id_time(t, x[i]), id_time(t + 1, y[i]), 1, cost)\n                add_edge(id_time(t, y[i]), id_time(t + 1, x[i]), 1, cost)\n    \n    ans = 0\n    \n    def spfa(s, t):\n        dist = [INF] * max_node\n        pre = [-1] * max_node\n        inq = [0] * max_node\n        q = deque()\n        dist[s] = 0\n        q.append(s)\n        inq[s] = 1\n        while q:\n            v = q.popleft()\n            inq[v] = 0\n            i = head[v]\n            while i != -1:\n                if e_cap[i] and dist[e_to[i]] > dist[v] + e_cost[i]:\n                    dist[e_to[i]] = dist[v] + e_cost[i]\n                    pre[e_to[i]] = i\n                    if not inq[e_to[i]]:\n                        q.append(e_to[i])\n                        inq[e_to[i]] = 1\n                i = e_nxt[i]\n        return dist[t] < INF\n    \n    def upd(s, t):\n        nonlocal ans\n        u = t\n        while u != s:\n            i = pre[u]\n            e_cap[i] -= 1\n            e_cap[i ^ 1] += 1\n            u = e_to[i ^ 1]\n        ans += dist[t]\n    \n    while spfa(S, T):\n        upd(S, T)\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>",