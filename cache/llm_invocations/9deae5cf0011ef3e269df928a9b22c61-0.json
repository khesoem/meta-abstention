    return true;\n        }\n\n        ArrayList<long[]> slope(int s, int t, long flowLimit) {\n            dual = new long[n];\n            long flow = 0;\n            long cost = 0;\n            while (flow < flowLimit) {\n                if (!_dualRef(s, t)) break;\n                long c = flowLimit - flow;\n                int v = t;\n                while (v != s) {\n                    _Edge e = g.get(pv[v]).get(pe[v]);\n                    c = Math.min(c, e.cap);\n                    v = pv[v];\n                }\n                v = t;\n                while (v != s) {\n                    _Edge e = g.get(pv[v]).get(pe[v]);\n                    e.cap -= c;\n                    g.get(v).get(e.rev).cap += c;\n                    v = pv[v];\n                }\n                long d = -dual[s];\n                flow += c;\n                cost += c * d;\n            }\n            ArrayList<long[]> res = new ArrayList<>();\n            res.add(new long[]{flow, cost});\n            return res;\n        }\n\n        long[] flow(int s, int t, long flowLimit) {\n            ArrayList<long[]> slopes = slope(s, t, flowLimit);\n            return slopes.get(slopes.size() - 1);\n        }\n\n        static class _Edge {\n            int to, rev, cap, cost;\n            _Edge(int to, int rev, int cap, int cost) {\n                this.to = to;\n                this.rev = rev;\n                this.cap = cap;\n                this.cost = cost;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt(); // not used\n        int a1 = sc.nextInt(), a2 = sc.nextInt(), a3 = sc.nextInt();\n        int b1 = sc.nextInt(), b2 = sc.nextInt(), b3 = sc.nextInt();\n\n        MCF g = new MCF(8);\n        g.addEdge(0, 1, a1, 0);\n        g.addEdge(0, 2, a2, 0);\n        g.addEdge(0, 3, a3, 0);\n        g.addEdge(4, 7, b1, 0);\n        g.addEdge(5, 7, b2, 0);\n        g.addEdge(6, 7, b3, 0