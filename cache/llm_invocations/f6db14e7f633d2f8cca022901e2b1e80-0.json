atic final int MAX_FN = (MAX_N * 3 + 1) * MAX_N + 2;\n\n    static int n, m, k, c, d;\n    static int s, t, fn;\n    static ArrayList<Integer>[] e;\n    static ArrayList<Integer> toList, fwList, coList;\n\n    static void adde(int u, int v, int w, int c) {\n        e[u].add(toList.size());\n        toList.add(v);\n        fwList.add(w);\n        coList.add(c);\n        e[v].add(toList.size());\n        toList.add(u);\n        fwList.add(0);\n        coList.add(-c);\n    }\n\n    static int[] dep, pre;\n    static boolean[] vis;\n\n    static boolean spfa() {\n        Arrays.fill(dep, INF);\n        Arrays.fill(pre, -1);\n        Arrays.fill(vis, false);\n        Queue<Integer> q = new LinkedList<>();\n        q.add(s);\n        vis[s] = true;\n        dep[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int idx : e[u]) {\n                int cap = fwList.get(idx);\n                int v = toList.get(idx);\n                int cost = coList.get(idx);\n                if (cap > 0 && dep[v] > dep[u] + cost) {\n                    dep[v] = dep[u] + cost;\n                    pre[v] = idx;\n                    if (!vis[v]) {\n                        q.add(v);\n                        vis[v] = true;\n                    }\n                }\n            }\n        }\n        return dep[t] < INF;\n    }\n\n    static int[] mcmf() {\n        int flow = 0, cost = 0;\n        while (spfa()) {\n            int f = INF;\n            for (int u = t; u != s; u = toList.get(pre[u] ^ 1)) {\n                f = Math.min(f, fwList.get(pre[u]));\n            }\n            for (int u = t; u != s; u = toList.get(pre[u] ^ 1)) {\n                int idx = pre[u];\n                fwList.set(idx, fwList.get(idx) - f);\n                fwList.set(idx ^ 1, fwList.get(idx ^ 1) + f);\n            }\n            flow += f;\n            cost += dep[t] * f;\n        }\n        return new int[]{flow, cost};\n    }\n\n    public 