{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n<your_rewritten_code_2>\n#include <iostream>\n#include <algorithm>\n#include <vector>\n#include <cmath>\n#include <climits>\n#include <cstdlib>\nusing namespace std;\n\nusing i64 = long long;\n\nstruct Fraction {\n    i64 numerator;\n    i64 denominator;\n};\n\ninline pair<i64, i64> computeApproximations(int x, int y, int b) {\n    i64 num = static_cast<i64>(b) * x;\n    i64 lower = num / y;\n    i64 upper = (num + y - 1) / y;\n    return {lower, upper};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int x, y, n;\n    cin >> x >> y >> n;\n    \n    vector<Fraction> pool;\n    pool.reserve(2 * n);\n    \n    for (int b = 1; b <= n; ++b) {\n        auto [lo, hi] = computeApproximations(x, y, b);\n        pool.push_back({lo, b});\n        pool.push_back({hi, b});\n    }\n    \n    auto distance = [&](i64 num, i64 den) -> i64 {\n        return llabs(static_cast<i64>(x) * den - num * y);\n    };\n    \n    auto cmp = [&](const Fraction& a, const Fraction& b) {\n        i64 da = distance(a.numerator, a.denominator);\n        i64 db = distance(b.numerator, b.denominator);\n        if (da != db) return da < db;\n        if (a.denominator != b.denominator) return a.denominator < b.denominator;\n        return a.numerator < b.numerator;\n    };\n    \n    nth_element(pool.begin(), pool.begin(), pool.end(), cmp);\n    auto best = *min_element(pool.begin(), pool.end(), cmp);\n    \n    cout << best.numerator << \"/\" << best.denominator << '\\n';\n    \n    return 0;\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class Fraction {\n        long numerator;\n        long denominator;\n        \n        Fraction(long num, long den) {\n            numerator = num;\n            denominator = den;\n        }\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int x = Integer.parseInt(st.nextToken());\n        int y = Integer.parseInt(st.nextToken());\n        int n = Integer.parseInt(st.nextToken());\n        \n        List<Fraction> pool = new ArrayList<>();\n        pool.ensureCapacity(2 * n);\n        \n        for (int b = 1; b <= n; ++b) {\n            long[] approx = computeApproximations(x, y, b);\n            pool.add(new Fraction(approx[0], b));\n            pool.add(new Fraction(approx[1], b));\n        }\n        \n        final int[] finalX = {x};\n        final int[] finalY = {y};\n        \n        Comparator<Fraction> cmp = (a, b) -> {\n            long da = distance(finalX[0], finalY[0], a.numerator, a.denominator);\n            long db = distance(finalX[0], finalY[0], b.numerator, b.denominator);\n            if (da != db) return Long.compare(da, db);\n            if (a.denominator != b.denominator) return Long.compare(a.denominator, b.denominator);\n            return Long.compare(a.numerator, b.numerator);\n        };\n        \n        Collections.sort(pool, cmp);\n        Fraction best = pool.get(0);\n        \n        System.out.println(best.numerator + \"/\" + best.denominator);\n    }\n    \n    private static long[] computeApproximations(int x, int y, int b) {\n        long num = (long) b * x;\n        long lower = num / y;\n        long upper = (num + y - 1) / y;\n        return new long[]{lower, upper};\n    }\n    \n    private static long distance(int x, int y, long num, long den) {\n        return Math.abs((long) x * den - num * y);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001461399078834802, -1.1920922133867862e-06, -5.960462772236497e-07, -0.00293586403131485, -2.169585604860913e-05, -0.029763955622911453, -0.38721221685409546, -0.00040260792593471706, -2.95634672511369e-05, -0.0002269487304147333, -0.00038580605178140104, -0.0003343261778354645, -1.1920928244535389e-07, -6.496695277746767e-05, -0.00012444675667211413, -0.001929447171278298, -0.00030632095877081156, -0.0001674750237725675, -9.881961887003854e-05, -0.00012468514614738524, -3.4570634852570947e-06, -3.4570634852570947e-06, -3.576278118089249e-07, -7.152555099310121e-07, -5.960462772236497e-07, -0.00020525732543319464, -1.1920922133867862e-06, -0.06995078921318054, -0.00523636257275939, -0.00016652150952722877, -0.0010031197452917695, -2.622600959512056e-06, -0.08693097531795502, 0.0, -2.3483953555114567e-05, -0.011148659512400627, -5.364403477869928e-06, -1.1920928244535389e-07, -1.7404405298293568e-05, -0.020550191402435303, 0.0, -2.3841855067985307e-07, -8.344646857949556e-07, -2.3841830625315197e-06, -0.0001161031104857102, 0.0, -8.618460560683161e-05, -1.5497195136049413e-06, -3.576278118089249e-07, -9.536738616588991e-07, -7.152555099310121e-07, -0.0010351543314754963, 0.0, -4.768370445162873e-07, -0.7287318110466003, -2.145764938177308e-06, -0.002772