 id: int, l: int, r: int, nodes: List[Node]):\n        if l == r:\n            self.st[id] = nodes[l]\n            return\n        mid = (l + r) // 2\n        self._build((id << 1) + 1, l, mid, nodes)\n        self._build((id << 1) + 2, mid + 1, r, nodes)\n        self.st[id] = self.merge(self.st[(id << 1) + 1], self.st[(id << 1) + 2])\n    \n    def update(self, i: int, node: Node):\n        self._update(0, 0, self.n - 1, i, node)\n    \n    def _update(self, id: int, l: int, r: int, i: int, node: Node):\n        if i < l or r < i:\n            return\n        if l == r:\n            self.st[id] = node\n            return\n        mid = (l + r) // 2\n        self._update((id << 1) + 1, l, mid, i, node)\n        self._update((id << 1) + 2, mid + 1, r, i, node)\n        self.st[id] = self.merge(self.st[(id << 1) + 1], self.st[(id << 1) + 2])\n    \n    def query(self, x: int, y: int) -> Node:\n        return self._query(0, 0, self.n - 1, x, y)\n    \n    def _query(self, id: int, l: int, r: int, x: int, y: int) -> Node:\n        if x > r or y < l:\n            return Node()\n        if x <= l and r <= y:\n            return self.st[id]\n        mid = (l + r) // 2\n        left_res = self._query((id << 1) + 1, l, mid, x, y)\n        right_res = self._query((id << 1) + 2, mid + 1, r, x, y)\n        return self.merge(left_res, right_res)\n    \n    def merge(self, a: Node, b: Node) -> Node:\n        if a is None:\n            return b\n        if b is None:\n            return a\n        overlap = min(a.open, b.close)\n        return Node(a.data + b.data + 2 * overlap, a.open + b.open - overlap, a.close + b.close - overlap)\n\ndef combination(n: int, k: int) -> int:\n    if k > n or k < 0:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    res = 1\n    for j in range(k):\n        res = res * (n - j) // (j + 1)\n    return res\n\ndef probability(m: int, n: int) -> float:\n    total = combination(n, 3)\n    favorable = 0.0\n    favorable += combination(m, 3)\n    favorable += combination(m, 2) * (n - m)\n    favorable += 0.5 * combination(m, 1) * combination(n - m, 2)\n    return favorable / total\n\ndef solve():\n    n = int(input())\n    p = float(input())\n    \n    left = 0\n    right = n - 1\n    while left < right:\n        mid = left + (right - left) // 2\n        val = probability(mid, n)\n        if val >= p:\n            right = mid\n        else:\n            left = mid + 1\n    print(left)\n\ndef main():\n    tt = 1\n    for _ in range(tt):\n        solve()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010084597306558862, -4.768370445162873e-07, -3.576278118089249e-07, -5.435795901576057e-05, -0.026783136650919914, -4.410734163684538e-06, -0.0005594118847511709, -0.04417756572365761, -2.264974000354414e-06, -0.002190929837524891, -0.0008235162240453064, -0.08895166963338852, -0.14268697798252106, -0.2979631721973419, -2.3841855067985307e-07, -0.11406485736370087, -1.0649935007095337, -0.0014800796052441, -0.07114488631486893, -0.31326818466186523, -0.2512158453464508, -7.152555099310121e-07, -8.880697714630514e-05, -0.00043478095903992653, -0.04994872957468033, -0.0011803095694631338, -0.001824739621952176, -0.11945819109678268, -0.6740453839302063, -0.014694556593894958, -2.145764938177308e-06, -2.3841855067985307e-07, -8.546940807718784e-05, -0.00015233787416946143, -2.3483953555114567e-05, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, 0.0, -0.1805170327425003, -1.0728830375228426e-06, -1.0132738680113107e-05, -1.1920928244535389e-07, -3.814689989667386e-06, -4.291525328881107e-06, -8.344646857949556e-07, -2.50339189733495e-06, -2.3841855067985307e-07, -8.344646857949556e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -4.768370445162873e-07, -1.6689286894688848e-06, -7.748573807475623e-06, -1.1920928244535389e-07, -1.8596476365928538e-05, -0.4778408110141754, -5.6980417866725475e-05, -5.0