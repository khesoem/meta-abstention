na = floor(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(floor(a) < mina){\n                    mina = floor(a);\n                    minb = b;                   \n                }\n            }\n            \n            diff(x,y,ceil(a),b,tempa,tempb);        \n            temp = tempa/tempb;\n\n            if(temp < min){\n                mina = ceil(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(ceil(a) < mina){\n                    mina = ceil(a);\n                    minb = b;                   \n                }\n            }\n        }\n    }\n\n    int gc = gcd (mina, minb);\n    if (gc != 1){       \n        mina = mina/gc;\n        minb = minb/gc;\n    }\n\n    cout<<mina<<\"/\"<<minb<<endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static int gcd(int x, int y) {\n        int gcd;\n        if (x > y)\n            gcd = x;\n        else\n            gcd = y;\n\n        while (true) {\n            if (x % gcd == 0 && y % gcd == 0)\n                break;\n            gcd--;\n        }\n        return gcd;\n    }\n\n    public static void diff(double x, double y, double a, double b, double[] result) {\n        result[0] = x * b - y * a;\n        result[0] = Math.abs(result[0]);\n        result[1] = y * b;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        double x = scanner.nextDouble();\n        double y = scanner.nextDouble();\n        double n = scanner.nextDouble();\n        \n        double min = 1000000;\n        int mina = 0;\n        int minb = 0;\n\n        if (n > y) {\n            int gc = gcd((int) x, (int) y);\n   