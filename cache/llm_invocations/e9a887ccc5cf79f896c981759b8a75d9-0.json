eque\n\nMOD = 1000000007\n\ndef solveBFS(fifty, hundred, K):\n    # dist[t][f][h] = min steps to reach state (t, f, h)\n    dist = [[[-1] * (hundred + 1) for _ in range(fifty + 1)] for __ in range(2)]\n    q = deque()\n    dist[0][fifty][hundred] = 0\n    q.append((0, fifty, hundred))\n\n    while q:\n        t, f, h = q.popleft()\n        if f == 0 and h == 0:\n            return dist[t][f][h]\n\n        if t == 1:  # on right side, send one person back to left\n            nf, nh = f, h\n            if f < fifty:\n                nf += 1\n            else:\n                nh += 1\n            if 0 <= nf <= fifty and 0 <= nh <= hundred and dist[0][nf][nh] == -1:\n                dist[0][nf][nh] = dist[t][f][h] + 1\n                q.append((0, nf, nh))\n        else:  # on left side, send some people to right\n            for i in range(f + 1):\n                if i * 50 > K:\n                    break\n                for j in range(h + 1):\n                    totalW = i * 50 + j * 100\n                    if totalW > K:\n                        break\n                    # condition from original code\n                    if (fifty - f + i > 0 and totalW > 50) or (hundred - h + j > 1 and totalW > 100) or (i == fifty and j == hundred):\n                        if dist[1][f - i][h - j] == -1:\n                            dist[1][f - i][h - j] = dist[t][f][h] + 1\n                            q.append((1, f - i, h - j))\n    return 10**6\n\ndef solve2(t, f, h, r, memo2, fifty, hundred, K, comb):\n    if r == 0 and f == 0 and h == 0:\n        return 1\n    if r == 0:\n        return 0\n    if memo2[t][f][h][r] != -1:\n        return memo2[t][f][h][r]\n\n    ans = 0\n    if t == 1:  # on right side, send people back to left\n        for i in range(f + 1):\n            if i * 50 > K:\n                break\n            for j in range(h + 1):\n                if i == 0 and j == 0:\n                    continue\n                totalW = i * 50 + j * 100\n                if totalW > K:\n                    break\n                ways = (comb[f][i] * comb[h][j]) % MOD\n                ans = (ans + ways * solve2(0, f - i, h - j, r - 1, memo2, fifty, hundred, K, comb)) % MOD\n    else:  # on left side, send people to right\n        for i in range(fifty - f + 1):\n            if i * 50 > K:\n                break\n            for j in range(hundred - h + 1):\n                if i == 0 and j == 0:\n                    continue\n                totalW = i * 50 + j * 100\n                if totalW > K:\n                    break\n                ways = (comb[fifty - f][i] * comb[hundred - h][j]) % MOD\n                ans = (ans + ways * solve2(1, f + i, h + j, r - 1, memo2, fifty, hundred, K, comb)) % MOD\n\n    memo2[t][f][h][r] = ans\n    return ans\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    K = int(next(it))\n    fifty = 0\n    hundred = 0\n    for _ in range(N):\n        val = int(next(it))\n        if val == 50:\n            fifty += 1\n        else:\n            hundred += 1\n\n    # precompute combinations up to 100\n    max_n = 100\n    comb = [[0] * (max_n + 1) for _ in range(max_n + 1)]\n    for n in range(max_n + 1):\n        comb[n][0] = comb[n][n] = 1\n        for k in range(1, n):\n            comb[n][k] = (comb[n-1][k-1] + comb[n-1][k]) % MOD\n\n    min_steps = solveBFS(fifty, hundred, K)\n\n    if min_steps >= 10**6:\n        print(-1)\n        print(0)\n    else:\n        # memo2[t][f][h][r]\n        memo2 = [[[[-1] * (min_steps + 1) for _ in range(hundred + 1)] for __ in range(fifty + 1)] for ___ in range(2)]\n        ways = solve2(0, fifty, hundred, min_steps, memo2, fifty, hundred, K, comb)\n        print(min_steps)\n        print(ways)\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(10000)\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.917721035890281e-05, 0.0, -1.19209282