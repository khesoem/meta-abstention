= K; c++) {\n                    base[0][i][r][c] = 0;\n                }\n                base[0][i][r][r] = 1;\n                base[0][i][r][i] = 1;\n            }\n        }\n        \n        // pref and suf for levels 0..digits-2\n        long[][][][] pref = null;\n        long[][][][] suf = null;\n        if (digits > 1) {\n            pref = new long[digits-1][K][K+1][K+1];\n            suf = new long[digits-1][K][K+1][K+1];\n        }\n        \n        for (int i = 1; i < digits; i++) {\n            // compute pref[i-1][j]\n            pref[i-1][0] = base[i-1][0];\n            for (int j = 1; j < K; j++) {\n                pref[i-1][j] = mat_mul(pref[i-1][j-1], base[i-1][j]);\n            }\n            // compute suf[i-1][j]\n            suf[i-1][K-1] = base[i-1][K-1];\n            for (int j = K-2; j >= 0; j--) {\n                suf[i-1][j] = mat_mul(base[i-1][j], suf[i-1][j+1]);\n            }\n            // compute base[i][j]\n            base[i][0] = pref[i-1][K-1];\n            for (int j = 1; j < K; j++) {\n                base[i][j] = mat_mul(suf[i-1][j], pref[i-1][j-1]);\n            }\n        }\n        \n        // trans = identity matrix\n        long[][] trans = new long[K+1][K+1];\n        for (int i = 0; i <= K; i++) {\n            trans[i][i] = 1;\n        }\n        \n        int sum = 0;\n        for (int i = digits - 1; i >= 0; i--) {\n            int x = num.get(i);\n            for (int j = 0; j < x; j++) {\n                trans = mat_mul(trans, base[i][sum]);\n                sum++;\n                if (sum >= K) sum -= K;\n            }\n        }\n        \n        long ans = 1;\n        for (int i = 0; i < K; i++) {\n            ans += trans[K][i];\n            ans %= MOD;\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.47952248173533e-05, -0.04922712221741676, -1.597391747054644e-05, 0.0, 0.0, -9.381330892210826e-05, -0.00012039413559250534, 