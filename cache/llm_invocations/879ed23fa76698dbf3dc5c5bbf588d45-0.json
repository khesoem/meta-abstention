       long choose = C[totalF - f][i] * C[totalS - s][j] % MOD;\n                ans = (ans + choose * solve(f + i, s + j, rides - 1, 1)) % MOD;\n            }\n        }\n\n        memo.put(k, ans);\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        cap = sc.nextInt() / 50;\n        totalF = 0;\n        totalS = 0;\n        for (int i = 0; i < n; i++) {\n            if (sc.nextInt() == 100) totalF++;\n            else totalS++;\n        }\n\n        C = new long[51][51];\n        for (int i = 0; i <= 50; i++) {\n            C[i][0] = C[i][i] = 1;\n            for (int j = 1; j < i; j++) {\n                C[i][j] = (C[i - 1][j - 1] + C[i - 1][j]) % MOD;\n            }\n        }\n\n        moves = new List[totalF + 1][totalS + 1];\n        for (int a = 0; a <= totalF; a++) {\n            for (int b = 0; b <= totalS; b++) {\n                List<int[]> list = new ArrayList<>();\n                for (int i = 0; i <= a; i++) {\n                    for (int j = 0; j <= b; j++) {\n                        if (i + j > 0 && 2 * i + j <= cap) {\n                            list.add(new int[]{i, j});\n                        }\n                    }\n                }\n                moves[a][b] = list;\n            }\n        }\n\n        for (int rides = 1; rides <= 200; rides++) {\n            long ways = solve(totalF, totalS, rides, 1);\n            if (ways != 0) {\n                System.out.println(rides);\n                System.out.println(ways);\n                return;\n            }\n        }\n\n        System.out.println(-1);\n        System.out.println(0);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import defaultdict\n\nMOD = 1000000007\ncap = 0\ntotalF = 0\ntotalS = 0\nC = [[0] * 51 for _