];\n                if (dp[lvl][mask] > INF) dp[lvl][mask] %= mod;\n            }\n            dp[lvl][mask] %= mod;\n        }\n        res = (res + dp[lvl][n] * binom(k, lvl)) % mod;\n    }\n    \n    res = (res * fac[n]) % mod;\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    cin >> n >> k >> mod;\n    ull total = mod_exp(k, n);\n    \n    if (n & 1) {\n        cout << total << '\\n';\n        return 0;\n    }\n    \n    total = (total - solve() + mod) % mod;\n    cout << total << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\ndef mod_exp(base, exp, mod):\n    res = 1\n    while exp:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n    \n    total = mod_exp(k, n, mod)\n    \n    if n & 1:\n        print(total)\n        return\n    \n    INF = 17446744073709551616\n    \n    # Initialize arrays\n    fac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    \n    fac[0] = 1\n    for i in range(1, n + 1):\n        fac[i] = (fac[i-1] * i) % mod\n    \n    inv[n] = mod_exp(fac[n], mod - 2, mod)\n    for i in range(n - 1, -1, -1):\n        inv[i] = (inv[i+1] * (i + 1)) % mod\n    \n    # dp[lvl][mask] - using list of dictionaries for sparse representation\n    dp = [dict() for _ in range(18)]\n    \n    for i in range(1, n + 1):\n        dp[1][i] = inv[i]\n    \n    def binom(a, b):\n        if b < 0 or b > a:\n            return 0\n        return ((fac[a] * inv[b]) % mod * inv[a - b]) % mod\n    \n    res = (dp[1].get(n, 0) * binom(k, 1)) % mod\n    limit = min(17, k)\n    \n    for lvl in range(2, limit + 1):\n        # Iterate over all masks that are subsets of n\n        mask = n\n        while mask:\n            dp[lvl][mask] = 0\n            sub = mask\n            while sub:\n                prev_mask = mask ^ sub\n                val = dp[lvl-1].get(prev_mask, 0) * inv.get(sub, 0)\n                dp[lvl][mask] = (dp[lvl][mask] + val) % mod\n                sub = (sub - 1) & mask\n            if dp[lvl][mask] > INF:\n                dp[lvl][mask] %= mod\n            dp[lvl][mask] %= mod\n            res = (res + dp[lvl].get(n, 0) * binom(k, lvl)) % mod\n            mask = (mask - 1) & n\n    \n    res = (res * fac[n]) % mod\n    total = (total - res + mod) % mod\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00020013237372040749, -8.344646857949556e-07, -3.576278118089249e-07, -0.47758668661117554, -0.08080744743347168, -3.957670196541585e-05, -4.410734163684538e-06, -1.9192511899746023e-05, -1.9311717551317997e-05, -0.0008069596369750798, -0.0002273062855238095, -0.0060264309868216515, -2.0265558760002023e-06, -1.5497195136049413e-06, 0.0, 0.0, 0.0, -1.6689286894688848e-06, -5.364403477869928e-06, -0.3484484553337097, -1.0609570381348021e-05, -0.00012706902634818107, -1.1920928244535389e-07, 0.0, -3.8742269680369645e-05, -2.3841855067985307e-07, 0.0, 0.0, -3.576278118089249e-07, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -9.536738616588991e-07, 0.0, 0.0, -2.0265558760002023e-06, 0.0, 0.0, -7.152555099310121e-07, -4.768370445162873e-07, -0.0003152588615193963, -2.3841855067985307e-07, 0.0, 0.0, -7.152555099310121e-07, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, 0.0, -5.960462772236497e-07, -3.576278118089249e-07, -1.7881377516459906e-06, -7.152531907195225e-06, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -1.6689286894688848e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -1.7165990357170813e-05, -4.458328112377785e-05, -0.37304240465164185, -1.2040065