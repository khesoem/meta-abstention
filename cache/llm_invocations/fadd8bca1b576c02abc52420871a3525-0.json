de <cmath>\n\nusing namespace std;\n\nint lca(vector<int>& match, vector<int>& base, vector<int>& p, int a, int b) {\n    vector<bool> used(match.size(), false);\n    while (true) {\n        a = base[a];\n        used[a] = true;\n        if (match[a] == -1) break;\n        a = p[match[a]];\n    }\n    while (true) {\n        b = base[b];\n        if (used[b]) return b;\n        b = p[match[b]];\n    }\n}\n\nvoid markPath(vector<int>& match, vector<int>& base, vector<bool>& blossom, vector<int>& p, int u, int curbase, int child) {\n    for (; base[u] != curbase; u = p[match[u]]) {\n        blossom[base[u]] = true;\n        blossom[base[match[u]]] = true;\n        p[u] = child;\n        child = match[u];\n    }\n}\n\nint findPath(vector<vector<int>>& graph, vector<int>& match, vector<int>& p, int root) {\n    fill(p.begin(), p.end(), -1);\n    int n = graph.size();\n    vector<int> base(n);\n    for (int i = 0; i < n; ++i) base[i] = i;\n\n    vector<bool> used(n, false);\n    vector<int> q(n);\n    int qt = 0;\n    used[root] = true;\n    q[qt++] = root;\n    for (int qh = 0; qh < qt; qh++) {\n        int u = q[qh];\n        for (int v : graph[u]) {\n            if (base[u] == base[v] || match[u] == v) continue;\n            if (v == root || (match[v] != -1 && p[match[v]] != -1)) {\n                int curbase = lca(match, base, p, u, v);\n                vector<bool> blossom(n, false);\n                markPath(match, base, blossom, p, u, curbase, v);\n                markPath(match, base, blossom, p, v, curbase, u);\n                for (int i = 0; i < n; ++i)\n                    if (blossom[base[i]]) {\n                        base[i] = curbase;\n                        if (!used[i]) {\n                            used[i] = true;\n                            q[qt++] = i;\n                        }\n                    }\n            } else if (p[v] == -1) {\n                p[v] = u;\n                if (match[v] == -1)\n                    return v;\n                v = match[v];\n                used[v] = true;\n                q[qt++] = v;\n            }\n        }\n    }\n    return -1;\n}\n\nint maxMatching(vector<vector<int>>& graph) {\n    int n = graph.size();\n    vector<int> match(n, -1);\n    vector<int> p(n);\n    for (int i = 0; i < n; ++i) {\n        if (match[i] == -1) {\n            int v = findPath(graph, match, p, i);\n            while (v != -1) {\n                int pv = p[v];\n                int ppv = match[pv];\n                match[v] = pv;\n                match[pv] = v;\n                v = ppv;\n            }\n        }\n    }\n    int cnt = 0;\n    for (int x : match) if (x != -1) cnt++;\n    return cnt / 2;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    vector<int> nums;\n    int num = 0;\n    bool negative = false;\n    for (char c : line) {\n        if (c == ' ' || c == '\\t') {\n            if (!nums.empty() || num != 0 || (line.find_first_not_of(\" \\t\") != string::npos && nums.size() < 2)) {\n                if (negative) num = -num;\n                nums.push_back(num);\n                num = 0;\n                negative = false;\n            }\n        } else if (c == '-') {\n            negative = true;\n        } else {\n            num = num * 10 + (c - '0');\n        }\n    }\n    if (negative) num = -num;\n    nums.push_back(num);\n    \n    int n = nums[0];\n    int m = nums[1];\n    \n    if (n > m) {\n        int temp = n;\n        n = m;\n        m = temp;\n    }\n\n    long long V = (long long)n * m;\n\n    if (V < 100) {\n        vector<vector<int>> g((int)V);\n        for (int i = 0; i < V; i++) {\n            for (int j = 0; j < V; j++) {\n                int r1 = i / m;\n                int c1 = i % m;\n                int r2 = j / m;\n                int c2 = j % m;\n                if (abs(r1 - r2) + abs(c1 - c2) == 3) {\n                    g[i].push_back(j);\n                }\n            }\n        }\n\n        int res = maxMatching(g) * 2;\n     