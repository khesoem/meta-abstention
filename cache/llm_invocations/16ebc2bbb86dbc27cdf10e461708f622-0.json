(i, hh - 1)\n                    right = get_dp(nn - 1 - i, hh - 1)\n                    total += left * right\n                dp[(nn, hh)] = total\n\n    return cat[n] - dp[(n, h)]\n\nn, h = map(int, raw_input().split())\nprint compute(n, h)\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nlong long compute(int n, int h) {\n    // Catalan numbers\n    vector<long long> cat(n + 1, 0);\n    cat[0] = 1;\n    if (n >= 1) cat[1] = 1;\n    for (int m = 2; m <= n; ++m) {\n        long long total = 0;\n        for (int i = 0; i < m; ++i) {\n            total += cat[i] * cat[m - 1 - i];\n        }\n        cat[m] = total;\n    }\n\n    // DP table: dp[n][h] for n nodes and height <= h\n    // We'll use a 2D vector, initialized to 0.\n    vector<vector<long long>> dp(n + 1, vector<long long>(h + 1, 0));\n\n    // Helper function to get dp value with conditions\n    auto get_dp = [&](int nn, int hh) -> long long {\n        // Compute 2^(hh-1) safely\n        long long max_nodes;\n        if (hh - 1 >= 60) {\n            max_nodes = LLONG_MAX;\n        } else {\n            max_nodes = 1LL << (hh - 1);\n        }\n        if (nn < 0 || hh <= 0 || nn >= max_nodes) return 0;\n        if (nn < 2) return 1;\n        if (nn < hh) return cat[nn];\n        return dp[nn][hh];\n    };\n\n    // Fill DP bottom-up\n    for (int hh = 1; hh <= h; ++hh) {\n        for (int nn = 0; nn <= n; ++nn) {\n            // Compute 2^(hh-1) safely\n            long long max_nodes;\n            if (hh - 1 >= 60) {\n                max_nodes = LLONG_MAX;\n            } else {\n                max_nodes = 1LL << (hh - 1);\n            }\n            if (nn < 0 || hh <= 0 || nn >= max_nodes) continue;\n            if (nn < 2) {\n                dp[nn][hh] = 1;\n            } else if (nn < hh) {\n                dp[nn][hh] = cat[nn];\n            } else {\n                long long total = 0;\n                for (int i = 0; i < nn; ++i) {\n                    long long left = get_dp(i, hh - 1);\n                    long long right = get_dp(nn - 1 - i, hh - 1);\n                    total += left * right;\n                }\n                dp[nn][hh] = total;\n            }\n        }\n    }\n\n    return cat[n] - dp[n][h];\n}\n\nint main() {\n    int n, h;\n    cin >> n >> h;\n    cout << compute(n, h) << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013267113536130637, 0.0, -7.152555099310121e-07, -0.0007306052139028907, -8.67805938469246e-05, -8.344646857949556e-07, -5.364403477869928e-06, -1.1444026313256472e-05, 0.0, 0.0, -1.1920928244535389e-07, -0.00014077626110520214, -3.5523738915799186e-05, 0.0, -0.16086870431900024, -0.005250474438071251, -0.0011703077470883727, 0.0, -4.887569048150908e-06, 0.0, 0.0, -0.06200537458062172, -0.007249833550304174, -1.1920922133867862e-06, 0.0, -0.00012516192509792745, -0.2939118444919586, 0.0, -0.45812350511550903, -0.00691532576456666, -3.576278118089249e-07, -3.576278118089249e-07, -1.5497195136049413e-06, -9.536738616588991e-07, -8.642300235806033e-05, -1.1920922133867862e-06, -1.4305104514278355e-06, -0.0016001766780391335, -0.17014333605766296, -8.344646857949556e-07, -0.2528361678123474, 0.0, -8.344646857949556e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -7.152555099310121e-07, -4.172316494077677e-06, -0.005233753472566605, 0.0, -4.100715523236431e-05, -0.0007099968497641385, 0.0, -2.861018856492592e-06, -1.2278481335670222e-05, 0.0, -0.00015841660206206143, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -3.576278118089249e-07, -1.0967194612021558e-05, 0.0, 0.0, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.0009114163694903255, -0.008617713116109371, 0.0, -5.96