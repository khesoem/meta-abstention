{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\n#include <array>\n#include <utility>\nusing namespace std;\n\ntypedef pair<int, int> pii;\n\nconst int N = 11;\nconst int INF = 1e9;\nconst int MAXV = 2 * N * N + 5;\n\nstruct edge {\n    int to, c, f, rev;\n    edge() {}\n    edge(int to_, int c_, int f_, int rev_)\n        : to(to_), c(c_), f(f_), rev(rev_) {}\n};\n\nvector<edge> g[MAXV];\nint d[MAXV], ptr[MAXV], s, t, n;\nqueue<int> q;\n\nvoid addEdge(int v, int u, int cap) {\n    g[v].push_back(edge(u, cap, 0, 0));\n    g[u].push_back(edge(v, 0, 0, 0));\n    g[v].back().rev = (int)g[u].size() - 1;\n    g[u].back().rev = (int)g[v].size() - 1;\n}\n\nbool buildLevNet() {\n    for (int i = 0; i <= t; ++i) d[i] = INF;\n    d[s] = 0;\n    q.push(s);\n\n    while (!q.empty()) {\n        int v = q.front(); q.pop();\n        for (size_t i = 0; i < g[v].size(); ++i) {\n            int to = g[v][i].to;\n            int cf = g[v][i].c - g[v][i].f;\n            if (d[to] == INF && cf > 0) {\n                d[to] = d[v] + 1;\n                q.push(to);\n            }\n        }\n    }\n    return d[t] != INF;\n}\n\nint dfs(int v, int curFlow) {\n    if (v == t) return curFlow;\n\n    for (int &i = ptr[v]; i < (int)g[v].size(); ++i) {\n        int to = g[v][i].to;\n        int cf = g[v][i].c - g[v][i].f;\n\n        if (d[to] == d[v] + 1 && cf > 0) {\n            int add = dfs(to, min(curFlow, cf));\n            if (add) {\n                g[v][i].f += add;\n                g[to][g[v][i].rev].f -= add;\n                return add;\n            }\n        }\n    }\n    return 0;\n}\n\nint dinica() {\n    int flow = 0;\n    while (buildLevNet()) {\n        memset(ptr, 0, sizeof(ptr));\n        int add;\n        while ((add = dfs(s, INF)) != 0) flow += add;\n    }\n    return flow;\n}\n\nusing Matrix = array<array<int, N>, N>;\narray<array<Matrix, N>, N> dst;\n\nint tbad;\nchar a[N][N], b[N][N];\npii bad;\nqueue<pii> go;\n\nconst int X[] = {-1, 1, 0, 0};\nconst int Y[] = {0, 0, -1, 1};\n\nbool check(pii v) {\n    return v.first >= 0 && v.first < n && v.second >= 0 && v.second < n &&\n           a[v.first][v.second] != 'Y' && a[v.first][v.second] != 'Z';\n}\n\nvoid bfs(int xs, int ys) {\n    Matrix &cur = dst[xs][ys];\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            cur[i][j] = INF;\n\n    cur[xs][ys] = 0;\n    go.push(make_pair(xs, ys));\n\n    while (!go.empty()) {\n        pii v = go.front(); go.pop();\n\n        if (cur[v.first][v.second] == dst[bad.first][bad.second][v.first][v.second] &&\n            (bad.first != xs || bad.second != ys))\n            continue;\n\n        for (int k = 0; k < 4; ++k) {\n            int nx = v.first + X[k];\n            int ny = v.second + Y[k];\n            pii nv = make_pair(nx, ny);\n\n            if (check(nv) && cur[nx][ny] == INF &&\n                cur[v.first][v.second] + 1 <= dst[bad.first][bad.second][nx][ny]) {\n                cur[nx][ny] = cur[v.first][v.second] + 1;\n                go.push(nv);\n            }\n        }\n    }\n}\n\nint main() {\n    cin >> n >> tbad;\n\n    int px = 0, py = 0;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            if (a[i][j] == 'Z') px = i, py = j;\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            cin >> b[i][j];\n\n    bad = make_pair(px, py);\n    bfs(px, py);\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            dst[bad.first][bad.second][i][j] = min(dst[bad.first][bad.second][i][j], tbad);\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (check(make_pair(i, j))) bfs(i, j);\n\n    s = 0;\n    t = 2 * n * n + 1;\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            if (a[i][j] != '0') addEdge(s, i * n + j + 1, a[i][j] - '0');\n            if (b[i][j] != '0') addEdge(i * n + j + 1 + n * n, t, b[i][j] - '0');\n        }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            for (int i1 = 0; i1 < n; ++i1)\n                for (int j1 = 0; j1 < n; ++j1)\n                    if (check(make_pair(i, j)) && check(make_pair(i1, j1)) &&\n                        dst[i][j][i1][j1] <= dst[px][py][i1][j1])\n                        addEdge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF);\n\n    cout << dinica();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10 ** 9\nN = 11\nMAXV = 2 * N * N + 5\n\ng = [[] for _ in range(MAXV)]\nd = [0] * MAXV\nptr = [0] * MAXV\ns = 0\nt = 0\nn = 0\n\ndef addEdge(v, u, cap):\n    g[v].append([u, cap, 0, len(g[u])])\n    g[u].append([v, 0, 0, len(g[v]) - 1])\n\ndef buildLevNet():\n    global d\n    for i in range(t + 1):\n        d[i] = INF\n    d[s] = 0\n    q = deque()\n    q.append(s)\n    while q:\n        v = q.popleft()\n        for e in g[v]:\n            to, c, f, rev = e\n            if d[to] == INF and c - f > 0:\n                d[to] = d[v] + 1\n                q.append(to)\n    return d[t] != INF\n\ndef dfs(v, curFlow):\n    if v == t:\n        return curFlow\n    while ptr[v] < len(g[v]):\n        e = g[v][ptr[v]]\n        to, c, f, rev = e\n        if d[to] == d[v] + 1 and c - f > 0:\n            add = dfs(to, min(curFlow, c - f))\n            if add:\n                e[2] += add\n                g[to][rev][2] -= add\n                return add\n        ptr[v] += 1\n    return 0\n\ndef dinica():\n    flow = 0\n    while buildLevNet():\n        for i in range(t + 1):\n            ptr[i] = 0\n        while True:\n            add = dfs(s, INF)\n            if add == 0:\n                break\n            flow += add\n    return flow\n\ndef check(v):\n    return 0 <= v[0] < n and 0 <= v[1] < n and a[v[0]][v[1]] != 'Y' and a[v[0]][v[1]] != 'Z'\n\ndef bfs(xs, ys):\n    cur = dst[xs][ys]\n    for i in range(n):\n        for j in range(n):\n            cur[i][j] = INF\n    cur[xs][ys] = 0\n    q = deque()\n    q.append((xs, ys))\n    while q:\n        v = q.popleft()\n        if cur[v[0]][v[1]] == dst[bad[0]][bad[1]][v[0]][v[1]] and (bad[0] != xs or bad[1] != ys):\n            continue\n        for k in range(4):\n            nx = v[0] + X[k]\n            ny = v[1] + Y[k]\n            nv = (nx, ny)\n            if check(nv) and cur[nx][ny] == INF and cur[v[0]][v[1]] + 1 <= dst[bad[0]][bad[1]][nx][ny]:\n                cur[nx][ny] = cur[v[0]][v[1]] + 1\n                q.append(nv)\n\nX = [-1, 1, 0, 0]\nY = [0, 0, -1, 1]\n\ndef main():\n    global n, s, t, a, b, dst, bad\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    tbad = int(data[1])\n    chars = ''.join(data[2:])\n    a = [list(chars[i*n:(i+1)*n]) for i in range(n)]\n    b = [list(chars[n*n + i*n : n*n + (i+1)*n]) for i in range(n)]\n\n    px = py = 0\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Z':\n                px, py = i, j\n\n    # Initialize dst as 4D list\n    dst = [[ [ [INF]*n for _ in range(n) ] for _ in range(n) ] for _ in range(n)]\n\n    bad = (px, py)\n    bfs(px, py)\n\n    for i in range(n):\n        for j in range(n):\n            dst[bad[0]][bad[1]][i][j] = min(dst[bad[0]][bad[1]][i][j], tbad)\n\n    for i in range(n):\n        for j in range(n):\n            if check((i, j)):\n                bfs(i, j)\n\n    s = 0\n    t = 2 * n * n + 1\n\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] != '0':\n                addEdge(s, i * n + j + 1, int(a[i][j]))\n            if b[i][j] != '0':\n                addEdge(i * n + j + 1 + n * n, t, int(b[i][j]))\n\n    for i in range(n):\n        for j in range(n):\n            for i1 in range(n):\n                for j1 in range(n):\n                    if check((i, j)) and check((i1, j1)) and dst[i][j][i1][j1] <= dst[px][py][i1][j1]:\n                        addEdge(i * n + j + 1, i1 * n + j1 + 1 + n * n, INF)\n\n    print(dinica())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.001745249843224883, -7.152555099310121e-07, 0.0, 0.0, -0.00035232058144174516, -0.004096688237041235, 0.0, -1.311301275563892e-06, -0.0003936707798857242, 0.0, 0.0, -2.3841855067985307e-07, -0.00872383825480938, -0.09563233703374863, -1.311301275563892e-06, -1.1444026313256472e-05, -1.2993727978027891e-05, -0.5759479999542236, -2.3841855067985307e-07, -3.576278118089249e-07, -0.47670358419418335, -0.5903962850570679, -0.04809039831161499, -5.602820692729438e-06, -0.00024184639914892614, -0.18162387609481812, -0.0012963948538526893, -1.1324817933200393e-05, -1.6689286894688848e-06, -2.3841855067985307e-07, -1.311301275563892e-06, 0.0, -1.4305104514278355e-06, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -4.6491513785440475e-06, -0.007265929132699966, -0.43297293782234