{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <queue>\n#include <unordered_set>\n#include <vector>\n#include <cmath>\n#include <functional>\n#include <cctype>\n\nusing namespace std;\n\nusing i64 = long long;\n\nstruct Node {\n    i64 value;\n    int cost;\n    bool operator<(const Node& other) const {\n        return cost > other.cost;\n    }\n};\n\nunordered_set<i64> visited_set;\n\ninline bool is_visited(i64 x) {\n    return visited_set.count(x) != 0;\n}\n\nNode make_uupper(i64 n) {\n    i64 res = 0;\n    int cnt = 0;\n    while (res < n) {\n        res = res * 10 + 1;\n        ++cnt;\n    }\n    return {res, cnt};\n}\n\nNode make_upper(i64 n) {\n    i64 res = 0;\n    int cnt = 0;\n    while (res * 10 + 1 <= n) {\n        res = res * 10 + 1;\n        ++cnt;\n    }\n    i64 base = res;\n    int base_cnt = cnt;\n    while (res < n) {\n        res += base;\n        cnt += base_cnt;\n    }\n    return {res, cnt};\n}\n\nNode make_lower(i64 n) {\n    i64 res = 0;\n    int cnt = 0;\n    while (res * 10 + 1 <= n) {\n        res = res * 10 + 1;\n        ++cnt;\n    }\n    i64 base = res;\n    int base_cnt = cnt;\n    while (res + base <= n) {\n        res += base;\n        cnt += base_cnt;\n    }\n    return {res, cnt};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    i64 n;\n    cin >> n;\n\n    priority_queue<Node> pq;\n    pq.push({n, 0});\n\n    while (!pq.empty()) {\n        Node cur = pq.top();\n        pq.pop();\n\n        if (cur.value == 0) {\n            cout << cur.cost << '\\n';\n            return 0;\n        }\n\n        if (is_visited(cur.value)) continue;\n        visited_set.insert(cur.value);\n\n        vector<Node> next_nodes;\n        next_nodes.emplace_back(make_lower(cur.value));\n        next_nodes.emplace_back(make_upper(cur.value));\n        next_nodes.emplace_back(make_uupper(cur.value));\n\n        for (auto& nd : next_nodes) {\n            nd.cost += cur.cost;\n            nd.value = std::abs(cur.value - nd.value);\n            pq.push(nd);\n        }\n    }\n\n    cout << 0 << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nfrom collections import deque\n\ndef main():\n    n = int(input().strip())\n    \n    visited_set = set()\n    \n    def is_visited(x):\n        return x in visited_set\n    \n    def make_uupper(n_val):\n        res = 0\n        cnt = 0\n        while res < n_val:\n            res = res * 10 + 1\n            cnt += 1\n        return (res, cnt)\n    \n    def make_upper(n_val):\n        res = 0\n        cnt = 0\n        while res * 10 + 1 <= n_val:\n            res = res * 10 + 1\n            cnt += 1\n        base = res\n        base_cnt = cnt\n        while res < n_val:\n            res += base\n            cnt += base_cnt\n        return (res, cnt)\n    \n    def make_lower(n_val):\n        res = 0\n        cnt = 0\n        while res * 10 + 1 <= n_val:\n            res = res * 10 + 1\n            cnt += 1\n        base = res\n        base_cnt = cnt\n        while res + base <= n_val:\n            res += base\n            cnt += base_cnt\n        return (res, cnt)\n    \n    # Priority queue: (cost, value)\n    pq = []\n    heapq.heappush(pq, (0, n))\n    \n    while pq:\n        cost, value = heapq.heappop(pq)\n        \n        if value == 0:\n            print(cost)\n            return\n        \n        if is_visited(value):\n            continue\n        visited_set.add(value)\n        \n        next_nodes = []\n        next_nodes.append(make_lower(value))\n        next_nodes.append(make_upper(value))\n        next_nodes.append(make_uupper(value))\n        \n        for res, cnt in next_nodes:\n            new_cost = cost + cnt\n            new_value = abs(value - res)\n            heapq.heappush(pq, (new_cost, new_value))\n    \n    print(0)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.131014667218551e-05, -8.344646857949556e-07, -1.1920928244535389e-07, -1.3470558769768104e-05, -0.017883017659187317, -0.03401397541165352, -0.3133423328399658, -0.010491455905139446, -8.344646857949556e-07, -0.05291984602808952, -0.0012076949933543801, -0.7212756872177124, -0.7705860733985901, -4.279521817807108e-05, -5.960462772236497e-07, -0.2069719284772873, -7.10462118149735e-05, -2.264974000354414e-06, -3.6954811548639555e-06, -0.01828925870358944, -7.152555099310121e-07, -0.1602267473936081, -0.00020418466010596603, -8.344646857949556e-07, -0.06770627200603485, -0.06197366490960121, -1.6689286894688848e-06, -7.390948667307384e-06, -0.00018034738604910672, -0.0028067738749086857, -9.536738616588991e-07, -0.46498316526412964, -0.1128750592470169, -0.00010442188795423135, 0.0, -9.536738616588991e-07, -3.576278118089249e-07, -5.960462772236497e-07, 0.0, -3.576278118089249e-07, -4.768360213347478e-06, -8.344646857949556e-07, -0.005933883599936962, -2.7418097943154862e-06, -0.005570602603256702, -2.622600959512056e-06, -0.00679870694