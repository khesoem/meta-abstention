 length = len(digits)\n    T = [None] * (length + 5)\n    P = [None] * (length + 5)\n    T[0] = M[k - 1]\n    P[0] = matrix_power(T[0], k - 1)\n    if length > 1:\n        T[1] = buildTrans(k - 1, k)\n        P[1] = matrix_power(T[1], k - 1)\n    suf = Matrix.identity(2 * k + 1)\n    for j in range(2, length + 1):\n        idx = k - j % k\n        if idx == k:\n            idx = 0\n        T[j] = buildTrans(idx, k)\n        suf = suf * P[j - 1]\n        T[j] = T[j] * suf\n        P[j] = matrix_power(T[j], k - 1)\n    r = n % k\n    n -= r\n    shift = 0\n    tmp = n\n    if tmp > 0:\n        while tmp % k == 0:\n            shift += 1\n            tmp //= k\n    shift = (k - shift % k) % k\n    ans = Matrix.identity(2 * k + 1)\n    ans = matrix_power(M[shift], r) * matrix_power(M[shift + k], max(r - shift, 0))\n    n //= k\n    if n == 0:\n        return (ans.at(2 * k, 0) + ans.at(0, 0)) % MOD\n    n -= 1\n    d = []\n    while n > 0:\n        d.append(n % k)\n        n //= k\n    pos = 1\n    for dig in d:\n        if dig > 0:\n            ans = ans * matrix_power(T[pos], dig)\n        pos += 1\n    ans = ans * T[1]\n    return (ans.at(2 * k, 0) + ans.at(0, 0)) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n    for i in range(2 * K + 1):\n        M[i] = Matrix(2 * K + 1, 2 * K + 1)\n        for j in range(i):\n            M[i].data[0][j] = 1\n        for j in range(2 * K - 1):\n            M[i].data[j + 1][j] = 1\n        M[i].data[2 * K][0] = 1\n        M[i].data[2 * K][2 * K] = 1\n    print(countWays(N, K))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.0002890407631639391, -1.311301275563892e-06, -4.768370445162873e-07, -0.5528879165649414, -0.0014457975048571825, -0.0702522024512291, -0.0012169820256531239, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, -0.0036083844