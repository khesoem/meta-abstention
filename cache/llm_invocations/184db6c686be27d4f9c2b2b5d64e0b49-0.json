        moves = new List[totalF + 1][totalS + 1];\n        for (int a = 0; a <= totalF; a++) {\n            for (int b = 0; b <= totalS; b++) {\n                List<int[]> list = new ArrayList<>();\n                for (int i = 0; i <= a; i++) {\n                    for (int j = 0; j <= b; j++) {\n                        if (i + j > 0 && 2 * i + j <= cap) {\n                            list.add(new int[]{i, j});\n                        }\n                    }\n                }\n                moves[a][b] = list;\n            }\n        }\n\n        Map<Integer, Long> cur = new HashMap<>();\n        cur.put(encode(totalF, totalS, 1), 1L);\n        int target = encode(0, 0, 0);\n\n        for (int rides = 1; rides <= 200; rides++) {\n            Map<Integer, Long> next = new HashMap<>();\n            for (Map.Entry<Integer, Long> e : cur.entrySet()) {\n                int code = e.getKey();\n                long w = e.getValue();\n                int f = decodeF(code);\n                int s = decodeS(code);\n                int b = decodeB(code);\n\n                if (b == 1) {\n                    for (int[] mv : moves[f][s]) {\n                        int i = mv[0];\n                        int j = mv[1];\n                        long add = w * C[f][i] % MOD * C[s][j] % MOD;\n                        int nc = encode(f - i, s - j, 0);\n                        Long old = next.get(nc);\n                        long nv = add + (old == null ? 0 : old);\n                        if (nv >= MOD) nv -= MOD;\n                        if (nv == 0) next.remove(nc);\n                        else next.put(nc, nv);\n                    }\n                } else {\n                    for (int[] mv : moves[totalF - f][totalS - s]) {\n                        int i = mv[0];\n                        int j = mv[1];\n                        long add = w * C[totalF - f][i] % MOD * C[totalS - s][j] % MOD;\n                        int nc = encode(f + i, s + j, 1);\n                    