self.E[i ^ 1]['cap'] += f\n                    if flow == in_:\n                        break\n        if flow < in_:\n            self.d[u] = -1\n        return flow\n\n    def dinic(self, _src, _sink):\n        self.src = _src\n        self.sink = _sink\n        self.u = 0\n        self.v = 0\n        flow = 0\n        while self.bfs():\n            flow += self.dfs(self.src, sys.maxsize)\n        return flow\n\nN = 15\ndx = [-1, 1, 0, 0]\ndy = [0, 0, -1, 1]\n\ndef In(i, j):\n    return 0 <= i < n and 0 <= j < n\n\nn = int(input())\nt = int(input())\nfield = [list(input()) for _ in range(n)]\ncapsule = [list(input()) for _ in range(n)]\nZ = [[0] * n for _ in range(n)]\nS = [[0] * n for _ in range(n)]\nF = MaxFlow(210)\n\nfor i in range(n):\n    for j in range(n):\n        if field[i][j] == 'Z':\n            x, y = i, j\n\nfor i in range(n):\n    for j in range(n):\n        if capsule[i][j] != 'Y':\n            Z[i][j] = 0\n        else:\n            Z[i][j] = 1\n\nfor i in range(n):\n    for j in range(n):\n        if capsule[i][j] != 'Y':\n            if capsule[i][j].isdigit():\n                F.add(i * n + j + n * n, i * n + j + n * n, int(capsule[i][j]))\n        else:\n            F.add(x * n + y, i * n + j + n * n, 1)\n\nbfs(x, y, Z, False)\n\nfor i in range(n):\n    for j in range(n):\n        if field[i][j].isdigit():\n            F.add(0, i * n + j, int(field[i][j]))\n            bfs(i, j, S, True)\n\nprint(F.dinic(0, n * n + n * n))\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.2292732447385788, -0.00021656711760442704, -0.0711333230137825, -0.42282482981681824, -0.03908859193325043, -0.3962596654891968, -0.3895147442817688, -0.06743941456079483, -2.0265599687263602e-06, -0.01451678667217493, -0.294157475233078, -0.41959697008132935, -0.3963080644607544, -0.00023612187942489982, -0.012981325387954712, -0.0489460714161396, -0.012266762554645538, -0.0007316762348636985, -6.07969241173123e-06, -6.6757424974639434e-06, -7.77