{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <string>\n#include <algorithm>\nusing namespace std;\n\nint n, t;\nstring a[30], b[30];\nint dist1[30][30], dist2[30][30];\nint dx[] = {0,0,-1,1};\nint dy[] = {1,-1,0,0};\n\nstruct Edge {\n    int to, rev, cap;\n};\nvector<Edge> g[1000];\nint level[1000], it[1000];\n\nvoid add_edge(int from, int to, int cap) {\n    g[from].push_back({to, (int)g[to].size(), cap});\n    g[to].push_back({from, (int)g[from].size()-1, 0});\n}\n\nbool ok(int x, int y) { return x>=0 && x<n && y>=0 && y<n; }\n\nvoid bfs1(int sx, int sy) {\n    for (int i=0;i<30;i++) for (int j=0;j<30;j++) dist1[i][j]=1e9;\n    queue<pair<int,int>> q;\n    q.push({sx,sy});\n    dist1[sx][sy]=0;\n    while (!q.empty()) {\n        int x=q.front().first, y=q.front().second; q.pop();\n        for (int i=0;i<4;i++) {\n            int nx=x+dx[i], ny=y+dy[i];\n            if (ok(nx,ny) && dist1[nx][ny]>=1e9 && b[nx][ny]!='Y') {\n                dist1[nx][ny]=dist1[x][y]+1;\n                q.push({nx,ny});\n            }\n        }\n    }\n}\n\nbool bfs(int s, int t) {\n    memset(level,-1,sizeof(level));\n    queue<int> q;\n    q.push(s);\n    level[s]=0;\n    while (!q.empty()) {\n        int v=q.front(); q.pop();\n        for (Edge &e : g[v]) {\n            if (level[e.to]==-1 && e.cap>0) {\n                level[e.to]=level[v]+1;\n                q.push(e.to);\n            }\n        }\n    }\n    return level[t]!=-1;\n}\n\nint dfs(int v, int t, int f) {\n    if (v==t) return f;\n    for (int &i=it[v]; i<(int)g[v].size(); i++) {\n        Edge &e=g[v][i];\n        if (level[e.to]==level[v]+1 && e.cap>0) {\n            int d=dfs(e.to,t,min(f,e.cap));\n            if (d>0) {\n                e.cap-=d;\n                g[e.to][e.rev].cap+=d;\n                return d;\n            }\n        }\n    }\n    return 0;\n}\n\nint max_flow(int s, int t) {\n    int flow=0;\n    while (bfs(s,t)) {\n        memset(it,0,sizeof(it));\n        while (int f=dfs(s,t,1e9)) flow+=f;\n    }\n    return flow;\n}\n\nvoid bfs2(int sx, int sy) {\n    for (int i=0;i<30;i++) for (int j=0;j<30;j++) dist2[i][j]=1e9;\n    queue<pair<int,int>> q;\n    q.push({sx,sy});\n    dist2[sx][sy]=0;\n    while (!q.empty()) {\n        int x=q.front().first, y=q.front().second; q.pop();\n        if (dist2[x][y]>=dist1[x][y]) continue;\n        for (int i=0;i<4;i++) {\n            int nx=x+dx[i], ny=y+dy[i];\n            if (ok(nx,ny) && dist2[nx][ny]>=1e9 && a[nx][ny]!='Y' && dist2[x][y]+1<=dist1[nx][ny]) {\n                dist2[nx][ny]=dist2[x][y]+1;\n                q.push({nx,ny});\n            }\n        }\n    }\n}\n\nint main() {\n    cin>>n>>t;\n    for (int i=0;i<n;i++) cin>>a[i];\n    int wx, wy;\n    for (int i=0;i<n;i++) {\n        cin>>b[i];\n        for (int j=0;j<n;j++) {\n            if (b[i][j]=='Z') {\n                b[i][j]=a[i][j]='Y';\n                wx=i; wy=j;\n            }\n        }\n    }\n    bfs1(wx,wy);\n    int source=0, sink=2*n*n+1;\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<n;j++) {\n            if (a[i][j]=='Y') continue;\n            int what=i*n+j+1;\n            int what2=n*n+i*n+j+1;\n            add_edge(source,what,a[i][j]-'0');\n            add_edge(what2,sink,b[i][j]-'0');\n            bfs2(i,j);\n            for (int x=0;x<n;x++) {\n                for (int y=0;y<n;y++) {\n                    if (b[x][y]=='Y' || dist2[x][y]>t) continue;\n                    add_edge(what,n*n+x*n+y+1,a[i][j]-'0');\n                }\n            }\n        }\n    }\n    n=2*n*n+5;\n    cout<<max_flow(source,sink)<<endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    a = [list(next(it).strip()) for _ in range(n)]\n    b = [list(next(it).strip()) for _ in range(n)]\n\n    # Find 'Z' and replace with 'Y' in both grids\n    wx = wy = -1\n    for i in range(n):\n        for j in range(n):\n            if b[i][j] == 'Z':\n                b[i][j] = 'Y'\n                a[i][j] = 'Y'\n                wx, wy = i, j\n\n    INF = 10**9\n    dx = [0, 0, -1, 1]\n    dy = [1, -1, 0, 0]\n\n    def ok(x, y):\n        return 0 <= x < n and 0 <= y < n\n\n    # BFS from zombie position on grid b\n    dist1 = [[INF]*30 for _ in range(30)]\n    q = deque()\n    q.append((wx, wy))\n    dist1[wx][wy] = 0\n    while q:\n        x, y = q.popleft()\n        for i in range(4):\n            nx, ny = x + dx[i], y + dy[i]\n            if ok(nx, ny) and dist1[nx][ny] >= INF and b[nx][ny] != 'Y':\n                dist1[nx][ny] = dist1[x][y] + 1\n                q.append((nx, ny))\n\n    # Dinic max flow\n    N = 2 * n * n + 5\n    graph = [[] for _ in range(N)]\n\n    def add_edge(fr, to, cap):\n        graph[fr].append([to, len(graph[to]), cap])\n        graph[to].append([fr, len(graph[fr]) - 1, 0])\n\n    level = [0]*N\n    it = [0]*N\n\n    def bfs_level(s, t):\n        for i in range(N):\n            level[i] = -1\n        q = deque()\n        q.append(s)\n        level[s] = 0\n        while q:\n            v = q.popleft()\n            for e in graph[v]:\n                if level[e[0]] == -1 and e[2] > 0:\n                    level[e[0]] = level[v] + 1\n                    q.append(e[0])\n        return level[t] != -1\n\n    def dfs_flow(v, t, f):\n        if v == t:\n            return f\n        for i in range(it[v], len(graph[v])):\n            e = graph[v][i]\n            if level[e[0]] == level[v] + 1 and e[2] > 0:\n                d = dfs_flow(e[0], t, min(f, e[2]))\n                if d > 0:\n                    e[2] -= d\n                    graph[e[0]][e[1]][2] += d\n                    return d\n            it[v] += 1\n        return 0\n\n    def max_flow(s, t):\n        flow = 0\n        while bfs_level(s, t):\n            for i in range(N):\n                it[i] = 0\n            while True:\n                f = dfs_flow(s, t, INF)\n                if f == 0:\n                    break\n                flow += f\n        return flow\n\n    source = 0\n    sink = 2 * n * n + 1\n\n    # Build graph\n    for i in range(n):\n        for j in range(n):\n            if a[i][j] == 'Y':\n                continue\n            what = i * n + j + 1\n            what2 = n * n + i * n + j + 1\n            cap_a = ord(a[i][j]) - ord('0')\n            cap_b = ord(b[i][j]) - ord('0')\n            add_edge(source, what, cap_a)\n            add_edge(what2, sink, cap_b)\n\n            # BFS from (i,j) on grid a with constraints\n            dist2 = [[INF]*30 for _ in range(30)]\n            q = deque()\n            q.append((i, j))\n            dist2[i][j] = 0\n            while q:\n                x, y = q.popleft()\n                if dist2[x][y] >= dist1[x][y]:\n                    continue\n                for k in range(4):\n                    nx, ny = x + dx[k], y + dy[k]\n                    if ok(nx, ny) and dist2[nx][ny] >= INF and a[nx][ny] != 'Y' and dist2[x][y] + 1 <= dist1[nx][ny]:\n                        dist2[nx][ny] = dist2[x][y] + 1\n                        q.append((nx, ny))\n\n            for x in range(n):\n                for y in range(n):\n                    if b[x][y] == 'Y' or dist2[x][y] > t:\n                        continue\n                    add_edge(what, n * n + x * n + y + 1, cap_a)\n\n    # Compute max flow\n    result = max_flow(source, sink)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.00016473367577418685, 0.0, -1.1920928244535389e-07, -0.0002867764269467443, -0.002678974997252226, -3.576278118089249e-07, -0.001934444298967719, -0.00018726025882642716, -1.3470558769768104e-05, 0.0, -1.311301275563892e-06, -0.005256996490061283, -0.40432974696159363, -0.4443901777267456, -0.20145875215530396, -4.0531076592742465e-06, -0.03032211773097515, -1.1920922133867862e-06, -2.038458114839159e-05, 0.0, -8.22540732769994e-06, -1.1920928244535389e-07, -0.5759438872337341, -0.038068726658821106, -4.768370445162873e-07, -0.04099154472351074, -1.1920928244535389e-07, 0.0, -0.0011701886542141438, -2.3841855067985307e-07, 0.0, -1.311301275563892e-06, -4.768370445162873e-07, -0.05411004647612572, -0.00022968991834204644, -1.6689160474925302e-05, -2.3841855067985307e-07, -1.1920922133867862e-06, -2.3841855067985307e-07, -0.0012022180017083883, -0.0016125545371323824, 0.0, -1.1920928244535389e-07, 0.0, -0.0008126770262606442, 0.0, -0.006887504365295172, -0.0006970121758058667, 0.0, -1.1920928244535389e-07, 0.0, -0.0015034097013995051, -0.004078761208802462, -0.00041654970846138895, -1.2278481335670222e-05, -0.0495416484773159, -0.04972893372178078, -1.5497195136049413e-06, 0.0, -0.018157687038183212, -1.0371154530730564e-05, -4.6491513785440475e-06, 0.0, -1.1920928244535389e-07, -4.7