t\ttmp=C(i,cur1);\t\n\t\t\trep(j,0,up){\n\t\t\t\tdp[i][j+1]=(dp[i][j+1]+1ll*dp[cur2][j]*tmp)%mod;\t\t\t\t\t\t\n\t\t\t}\n\t\t\tif(k==0)\tbreak;\n\t\t}\n\t}\n\trep(j,1,min(cnt[n],K))\tans=(ans+1ll*dp[n][j]*C(K,j)%mod*cj[j])%mod;\n\tans=(power(K,n)-ans+mod)%mod;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    K = int(data[1])\n    mod = int(data[2])\n    \n    def power(x, y):\n        ret = 1\n        x %= mod\n        while y:\n            if y & 1:\n                ret = (ret * x) % mod\n            y >>= 1\n            x = (x * x) % mod\n        return ret\n    \n    if n & 1:\n        print(power(K, n))\n        return\n    \n    N = n + 1\n    cj = [0] * N\n    inv = [0] * N\n    \n    cj[0] = 1\n    for i in range(1, n + 1):\n        cj[i] = (cj[i-1] * i) % mod\n    \n    inv[n] = power(cj[n], mod - 2)\n    inv[0] = 1\n    for i in range(n - 1, 0, -1):\n        inv[i] = (inv[i + 1] * (i + 1)) % mod\n    \n    def comb(i, j):\n        if j < 0 or j > i:\n            return 0\n        return (cj[i] * inv[j] % mod) * inv[i - j] % mod\n    \n    cnt = [0] * N\n    for i in range(1, n + 1):\n        cnt[i] = bin(i).count('1')\n    \n    mx = [0] * N\n    for i in range(1, n + 1):\n        # Find highest power of 2 <= i\n        j = 18\n        while j >= 0:\n            if (1 << j) <= i:\n                mx[i] = 1 << j\n                break\n            j -= 1\n    \n    dp = [[0] * 20 for _ in range(N)]\n    dp[0][0] = 1\n    \n    for i in range(1, n + 1):\n        if (n & i) != i:\n            continue\n        now = i ^ mx[i]\n        k = now\n        while True:\n            cur1 = k + mx[i]\n            cur2 = i ^ cur1\n            up = min(K - 1, cnt[cur2])\n            tmp = comb(i, cur1)\n            for j in range(up + 1):\n                dp[i][j + 1] = (dp[i][j + 1] + dp[cur2][j] * tmp) % mod\n            if k == 0:\n                break\n            k = (k - 1) & now\n    \n    ans = 0\n    max_j = min(cnt[n], K)\n    for j in range(1, max_j + 1):\n        ans = (ans + dp[n][j] * comb(K, j) % mod * cj[j]) % mod\n    \n    ans = (power(K, n) - ans + mod) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018809456378221512, -1.1920922133867862e-06, -2.3841855067985307e-07, -0.012769714929163456, -9.858122211880982e-05, -0.00038378025055862963, -0.0003937899600714445, -0.3748900592327118, -5.972207145532593e-05, -1.5497195136049413e-06, -0.20936711132526398, -4.768370445162873e-07, -0.0075285048224031925, -2.6940935640595853e-05, -0.474365234375, -6.09140915912576e-05, -0.005964812356978655, -1.537788011773955e-05, -4.768370445162873e-07, -0.042770929634571075, -1.168244216387393e-05, -2.3841855067985307e-07, -4.0649541915627196e-05, 0.0, -3.099436753473128e-06, -0.029761988669633865, -5.960462772236497e-07, -0.03607192263007164, -0.03364819288253784, -5.8412379075889476e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, 0.0, -0.002828052267432213, -6.198863957251888e-06, -1.7881377516459906e-06, -0.005930683575570583, -1.6689286894688848e-06, -5.960462772236497e-07, -3.576278118089249e-07, -5.960462772236497e-07, -1.6689160474925302e-05, -1.1920928244535389e-07, -1.6689286894688848e-06, -1.5497195136049413e-06, -1.1920922133867862e-06, -1.7881377516459906e-06, -4.768370445162873e-07, -9.059865078597795e-06, -0.0008141063735820353, -2.8371408916427754e-05, -1.5258672647178173e-05, -0.1753169149160385, -8.332382276421413e-05, -6.318072337307967e-06, -2.622600959512056e-06, -5.960462772236497e-07, -1.6689286894688848e-06, -7.152555099310121e-07, -0.0002783149539027363, -8.344646