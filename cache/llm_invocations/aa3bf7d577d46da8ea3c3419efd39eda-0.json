k(v, u, 0, 0, -cost);\n        int idx = edges.size();\n        adj[u].pb(idx - 2);\n        adj[v].pb(idx - 1);\n    }\n\n    bool spfa(int s, int t, int &totalFlow, int &totalCost) {\n        fill(dist, dist + t + 1, INF);\n        fill(inq, inq + t + 1, false);\n        dist[s] = 0;\n        inq[s] = true;\n        bottleneck[s] = INF;\n        queue<int> q;\n        q.push(s);\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n\n            for (int eid : adj[u]) {\n                Edge& e = edges[eid];\n                if (e.capacity > e.flow && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    parentEdge[e.to] = eid;\n                    bottleneck[e.to] = min(bottleneck[u], e.capacity - e.flow);\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[t] == INF) return false;\n        totalFlow += bottleneck[t];\n        totalCost += dist[t] * bottleneck[t];\n        int cur = t;\n        while (cur != s) {\n            int eid = parentEdge[cur];\n            edges[eid].flow += bottleneck[t];\n            edges[eid ^ 1].flow -= bottleneck[t];\n            cur = edges[eid].from;\n        }\n        return true;\n    }\n\n    int getMinCost(int s, int t) {\n        int flow = 0, cost = 0;\n        while (spfa(s, t, flow, cost));\n        return cost;\n    }\n} solver;\n\nint main() {\n    int c, d_val;\n    cin >> n >> m >> K >> c >> d_val;\n\n    for (int i = 1; i <= K; ++i) {\n        scanf(\"%d\", &A[i]);\n    }\n\n    src = 0;\n    sink = n * 100 + 1;\n\n    for (int i = 1; i <= K; ++i) {\n        solver.addEdge(src, 1 + (A[i] - 1) * 100, 1, 0);\n    }\n\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            int base = (i - 1) * 100LL;\n            solver.addEdge(base