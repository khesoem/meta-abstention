        idx = len(self.edges)\n        self.adj[u].append(idx - 2)\n        self.adj[v].append(idx - 1)\n\n    def spfa(self, s, t):\n        self.dist = [INF] * (self.nodeCount + 1)\n        self.inq = [False] * (self.nodeCount + 1)\n        self.dist[s] = 0\n        self.inq[s] = True\n        self.bottleneck[s] = INF\n        q = deque()\n        q.append(s)\n\n        while q:\n            u = q.popleft()\n            self.inq[u] = False\n\n            for eid in self.adj[u]:\n                e = self.edges[eid]\n                if e.capacity > e.flow and self.dist[e.to] > self.dist[u] + e.cost:\n                    self.dist[e.to] = self.dist[u] + e.cost\n                    self.parentEdge[e.to] = eid\n                    self.bottleneck[e.to] = min(self.bottleneck[u], e.capacity - e.flow)\n                    if not self.inq[e.to]:\n                        self.inq[e.to] = True\n                        q.append(e.to)\n\n        if self.dist[t] == INF:\n            return False, 0, 0\n\n        total_flow = self.bottleneck[t]\n        total_cost = self.dist[t] * self.bottleneck[t]\n        cur = t\n        while cur != s:\n            eid = self.parentEdge[cur]\n            self.edges[eid].flow += self.bottleneck[t]\n            self.edges[eid ^ 1].flow -= self.bottleneck[t]\n            cur = self.edges[eid].from_node\n\n        return True, total_flow, total_cost\n\n    def getMinCost(self, s, t):\n        flow = 0\n        cost = 0\n        while True:\n            found, f, c = self.spfa(s, t)\n            if not found:\n                break\n            flow += f\n            cost += c\n        return cost\n\ndef readInt():\n    X = 0\n    w = 0\n    ch = sys.stdin.read(1)\n    while not ch.isdigit():\n        if ch == '-':\n            w = 1\n        ch = sys.stdin.read(1)\n    while ch.isdigit():\n        X = (X << 3) + (X << 1) + (ord(ch) - 48)\n        ch = sys.stdin.read(1)\n    return -X if w else X\n\ndef main():\n    data = sys.stdin.read().split