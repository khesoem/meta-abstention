 }\n}\n\nstatic void bfs(int state) {\n    int boat = state / 1000000;\n    int currA = (state % 1000000) / 100;\n    int currB = state % 100;\n\n    if (boat == 1) {\n        for (int takeA = currA; takeA >= 0 && 50 * (currA - takeA) <= k; takeA--) {\n            for (int takeB = currB; takeB >= 0 && 50 * (currA - takeA) + 100 * (currB - takeB) <= k; takeB--) {\n                if (takeA != currA || takeB != currB) {\n                    long long ways = (choose[currA][takeA] * choose[currB][takeB]) % MOD;\n                    updateState(takeA, takeB, 0, state, ways);\n                }\n            }\n        }\n    } else {\n        for (int takeA = currA; takeA <= a && 50 * (takeA - currA) <= k; takeA++) {\n            for (int takeB = currB; takeB <= b && 50 * (takeA - currA) + 100 * (takeB - currB) <= k; takeB++) {\n                if (takeA != currA || takeB != currB) {\n                    long long ways = (choose[a - currA][takeA - currA] * choose[b - currB][takeB - currB]) % MOD;\n                    updateState(takeA, takeB, 1, state, ways);\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    cin >> n >> k;\n    for (int i = 0; i < n; i++) {\n        int x;\n        cin >> x;\n        if (x == 50) a++;\n        else b++;\n    }\n\n    precomputeBinomialCoefficients();\n    int startState = encodeState(1, a, b);\n    queue_bfs.push(startState);\n    stateMap[startState] = make_pair(0, 1);\n\n    while (!queue_bfs.empty()) {\n        int state = queue_bfs.front();\n        queue_bfs.pop();\n        bfs(state);\n    }\n\n    if (stateMap.find(0) != stateMap.end()) {\n        cout << stateMap[0].first << \"\\n\" << stateMap[0].second << endl;\n    } else {\n        cout << \"-1\\n0\" << endl;\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019870213873218745, -3.099436753473128e-06, -8.344646857949556e-07, -0.00016258825780823827, -5.960462772236497e-07, -9.298280929215252e-0