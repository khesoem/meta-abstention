= N % K\n    N -= r\n    shift = 0\n    tmp = N\n    if tmp > 0:\n        while tmp % K == 0:\n            shift += 1\n            tmp //= K\n    shift = (K - shift % K) % K\n    ans = Matrix.ident(2 * K + 1)\n    ans = pow_matrix(A[shift], r) * pow_matrix(A[shift + K], max(r - shift, 0))\n    N //= K\n    if N == 0:\n        return (ans.v[2 * K][0] + ans.v[0][0]) % MOD\n    N -= 1\n    num = []\n    while N > 0:\n        num.append(N % K)\n        N //= K\n    pos = 1\n    for d in num:\n        if d > 0:\n            ans = ans * pow_matrix(T[pos], d)\n        pos += 1\n    ans = ans * T[1]\n    return (ans.v[2 * K][0] + ans.v[0][0]) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    for i in range(2 * k + 1):\n        A[i] = Matrix(2 * k + 1, 2 * k + 1)\n        for j in range(i):\n            A[i].v[0][j] = 1\n        for j in range(2 * k - 1):\n            A[i].v[j + 1][j] = 1\n        A[i].v[2 * k][0] = 1\n        A[i].v[2 * k][2 * k] = 1\n    print(eval_func(n, k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015531764074694365, -5.960462772236497e-07, -3.576278118089249e-07, -0.20612932741641998, -0.0008122005965560675, -0.048663180321455, -0.00030882356804795563, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, 0.0, -0.002479338087141514, 0.0, -2.264974000354414e-06, 0.0, 0.0, 0.0, 0.0, -5.364403477869928e-06, -0.0011767374817281961, -0.0005545270396396518, -1.9788545614574105e-05, -1.1920922133867862e-06, -1.1920928244535389e-07, -2.7418097943154862e-06, -2.50339189733495e-06, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.311301275563892e-06, -3.576278118089249e-07, -1.120880126953125, -0.13261571526527405, -2.145764938177308e-06, -0.0009118927991949022, -0.001368777477182448, -0.5237621665000916, -9.298280929215252e-06, -3.4570634852570947e-06, -2.3841855067985307e-07, -7.49798