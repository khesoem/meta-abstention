trix A[65];\n\nMatrix make_matrix(int i, int k) {\n    return pow_matrix(A[i + k], k - i) * pow_matrix(A[i], i);\n}\n\nll eval(ll N, ll K) {\n    if (N == 0) return 1;\n    vector<ll> digits;\n    ll tmp = N;\n    while (tmp) {\n        digits.push_back(tmp % K);\n        tmp /= K;\n    }\n    reverse(digits.begin(), digits.end());\n    int len = digits.size();\n    vector<Matrix> T(len + 5), P(len + 5);\n    T[0] = A[K - 1];\n    P[0] = pow_matrix(T[0], K - 1);\n    if (len > 1) {\n        T[1] = make_matrix(K - 1, K);\n        P[1] = pow_matrix(T[1], K - 1);\n    }\n    Matrix suffix = Matrix::ident(2 * K + 1);\n    for (int j = 2; j <= len; ++j) {\n        int idx = K - (j % K);\n        if (idx == K) idx = 0;\n        T[j] = make_matrix(idx, K);\n        suffix = suffix * P[j - 1];\n        T[j] = T[j] * suffix;\n        P[j] = pow_matrix(T[j], K - 1);\n    }\n    ll r = N % K;\n    N -= r;\n    ll shift = 0;\n    tmp = N;\n    if (tmp > 0) {\n        while (tmp % K == 0) {\n            ++shift;\n            tmp /= K;\n        }\n    }\n    shift = (K - shift % K) % K;\n    Matrix ans = Matrix::ident(2 * K + 1);\n    ans = pow_matrix(A[shift], r) * pow_matrix(A[shift + K], max(r - shift, (ll)0));\n    N /= K;\n    if (N == 0) {\n        return (ans.at(2 * K, 0) + ans.at(0, 0)) % MOD;\n    }\n    --N;\n    vector<ll> num;\n    while (N > 0) {\n        num.push_back(N % K);\n        N /= K;\n    }\n    int pos = 1;\n    for (ll d : num) {\n        if (d > 0) ans = ans * pow_matrix(T[pos], d);\n        ++pos;\n    }\n    ans = ans * T[1];\n    return (ans.at(2 * K, 0) + ans.at(0, 0)) % MOD;\n}\n\nint main() {\n    ll n, k;\n    cin >> n >> k;\n    for (ll i = 0; i < 2 * k + 1; ++i) {\n        A[i] = Matrix(2 * k + 1, 2 * k + 1);\n        for (ll j = 0; j < i; ++j) A[i].at(0, j) = 1;\n        for (ll j = 0; j < 2 * k - 1; ++j) A[i].at(j + 1, j) = 1;\n        A[i].at(2 * k, 0) = 1;\n        A[i].at(2 * k, 2 * k) = 1;\n    }\n    cout << eval(n, k) << '\\n';\n    retu