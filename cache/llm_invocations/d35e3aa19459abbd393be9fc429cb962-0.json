 % MOD\n        res[i] = (even[i] + t) % MOD\n        res[i + n // 2] = (even[i] - t) % MOD\n        w = (w * root) % MOD\n    return res\n\ndef number_theoretic_transform(coef, k, inverse):\n    roots = calc_roots(k, inverse)\n    reordered = [0] * len(coef)\n    for i in range(len(coef)):\n        reordered[bit_reverse(i, k)] = coef[i]\n    return ntt_recursive(reordered, k, inverse, roots)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it)) // 2\n    m = int(next(it))\n    nums = [int(next(it)) for _ in range(m)]\n    max_val = max(nums)\n    min_size = n * max_val + 1\n    size = 1\n    k = 0\n    while size < min_size:\n        size *= 2\n        k += 1\n    a = [0] * size\n    for num in nums:\n        a[num] = 1\n    a = number_theoretic_transform(a, k, False)\n    for i in range(size):\n        a[i] = mod_pow(a[i], n)\n    a = number_theoretic_transform(a, k, True)\n    ans = 0\n    for i in range(size):\n        ans = (ans + a[i] * a[i]) % MOD\n    multiplier = mod_inv(size)\n    result = ((ans * multiplier) % MOD) * multiplier % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.794906312279636e-06, -1.1920928244535389e-07, 0.0, -0.00010382589971413836, -0.00038342276820912957, -1.311301275563892e-06, -0.06198206916451454, -2.9802276912960224e-06, -4.768370445162873e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -2.0265558760002023e-06, -0.062243323773145676, -0.004089090041816235, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -3.933898824470816e-06, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -3.71926071238704e-05, -6.794906312279636e-06, -4.672895011026412e-05, -0.2519565522670746, -2.264974000354414e-06, -3.969590397900902e-05, -0.004079354461282492, 0.0, -2.264974000354414e-06, -1.1920928244535389e-07, -1.9073468138230965e-06, 0.0, 0.0, 0