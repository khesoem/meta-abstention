 a, b):\n        return a if b == 0 else self.gcd(b, a % b)\n    \n    def modPow(self, base, exp):\n        result = 1\n        base %= MOD\n        while exp > 0:\n            if (exp & 1) == 1:\n                result = result * base % MOD\n            base = base * base % MOD\n            exp >>= 1\n        return result\n    \n    def readChar(self):\n        return self.readToken()[0]\n    \n    def readLine(self):\n        try:\n            return self.in_stream.readline()\n        except:\n            return \"-1\"\n    \n    def readDouble(self):\n        return float(self.readToken())\n    \n    def readLong(self):\n        return int(self.readToken())\n    \n    def readInt(self):\n        return int(self.readToken())\n    \n    def readToken(self):\n        while self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.in_stream.readline()\n                if not line:\n                    raise EOFError()\n                self.tokenizer = line.strip().split()\n            except:\n                raise RuntimeError(\"Failed to read token\")\n        \n        return self.tokenizer.pop(0)\n    \n    def setup(self):\n        self.tokenizer = []\n    \n    def execute(self):\n        self.setup()\n        self.process()\n        self.out.flush()\n\nif __name__ == \"__main__\":\n    utkarsh_v3().execute()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.5205356804654e-05, -1.1920922133867862e-06, -2.3841855067985307e-07, -3.564294092939235e-05, -0.011121663264930248, -0.0002047805901383981, -0.009979946538805962, -0.06430608779191971, -0.014169207774102688, -0.39985066652297974, -2.3841855067985307e-07, 0.0, 0.0, -1.311301275563892e-06, -1.5497195136049413e-06, -1.585470999998506e-05, -3.576278118089249e-07, -6.639736966462806e-05, -6.997340824455023e-05, -1.1801649634435307e-05, -5.960462772236497e-07, -0.04302605986595154, -0.00010990492592100054, -6.198863957251888e-06, -1.430510451427835