        init();\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextLong();\n        K = sc.nextInt();\n        r = K + 1;\n\n        // 0 -> single 1\n        // i -> i - 1\n        for (int i = 0; i <= K; i++) {\n            base_one[i].reset_to_identity();\n            if (i != 0) {\n                for (int j = 0; j <= K; j++)\n                    base_one[i].a[i][j] = 1;\n            }\n        }\n\n        for (int i = 0; i <= K; i++) {\n            row_shift[i].reset_to_identity();\n            if (i == 1) {\n                row_shift[i].reset_to_zero();\n                row_shift[i].a[0][0] = 1;\n                row_shift[i].a[1][K] = 1;\n                for (int j = 2; j <= K; j++)\n                    row_shift[i].a[j][j - 1] = 1;\n            } else if (i > 1) {\n                row_shift[i] = row_shift[1].multiply(row_shift[i - 1]);\n            }\n        }\n\n        for (int i = 0; i <= K; i++) {\n            col_shift[i].reset_to_identity();\n            if (i == 1) {\n                col_shift[i].reset_to_zero();\n                col_shift[i].a[0][0] = 1;\n                col_shift[i].a[K][1] = 1;\n                for (int j = 2; j <= K; j++)\n                    col_shift[i].a[j - 1][j] = 1;\n            } else if (i > 1) {\n                col_shift[i] = col_shift[i - 1].multiply(col_shift[1]);\n            }\n        }\n\n        combined_two[1].reset_to_identity();\n        for (int i = 1; i <= K; i++) {\n            combined_two[1] = base_one[i].multiply(combined_two[1]);\n        }\n\n        int[] digits = new int[70];\n        int bit = 0;\n        long tempN = n;\n        while (tempN != 0) {\n            digits[bit++] = (int) (tempN % K);\n            tempN /= K;\n        }\n\n        for (int i = 2; i <= bit; i++) {\n            combined_two[i].reset_to_identity();\n            for (int j = 0; j < K; j++) {\n                Matrix temp1 = row_shift[j].multiply(combined_two[i - 1]);\n                Matrix temp2 = temp1.multiply(col_shift[j]);\n                combined_two[i] = temp2.multiply(combined_two[i]);\n            }\n        }\n\n        // Reverse digits\n        for (int i = 0; i < bit / 2; i++) {\n            int t = digits[i];\n            digits[i] = digits[bit - 1 - i];\n            digits[bit - 1 - i] = t;\n        }\n\n        Matrix result = new Matrix();\n        result.reset_to_identity();\n\n        int position = 0;\n        for (int i = 0; i < bit; i++) {\n            if (i == bit - 1) {\n                for (int j = 0; j < digits[i]; j++) {\n                    result = base_one[position % K + 1].multiply(result);\n                    position++;\n                }\n            } else {\n                for (int j = 0; j < digits[i]; j++) {\n                    Matrix temp1 = row_shift[position % K].multiply(combined_two[bit - i - 1]);\n                    Matrix temp2 = temp1.multiply(col_shift[position % K]);\n                    result = temp2.multiply(result);\n                    position++;\n                }\n            }\n        }\n\n        long answer = 1;\n        for (int i = 1; i <= K; i++) {\n            answer = (answer + result.a[i][0]) % MOD;\n        }\n\n        System.out.println(answer);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012790338951162994, -7.510157047363464e-06, -4.768370445162873e-07, -0.001815577270463109, -2.074220174108632e-05, -0.10390112549066544, -0.5235138535499573, -8.797258487902582e-05, -3.361645576660521e-05, -0.0010761191369965672, -0.001794396317563951, -6.69933797325939e-05, -8.344646857949556e-07, -4.1126360883936286e-05, -0.11284417659044266, -0.0003725788265001029, -0.002808200428262353, -0.2085367739200592, -0.05491548031568527, -0.007254567462950945, -3.4570634852570947e-06, 0.0, -1.5497195136049413e-06, -2.8371408916427754e-05, -9.536738616588991e-07, -2.264974000354414e-06, -1.5497195136049413e-06, -0.0006420934805646539, -0.0015163839561864734, -0.225645437836