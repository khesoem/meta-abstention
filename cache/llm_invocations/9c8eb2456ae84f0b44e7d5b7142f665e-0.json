vate static boolean at(String str, int pos) {\n        return pos + 1 < str.length() && str.charAt(pos + 1) == 't';\n    }\n\n    private static boolean dot(String str, int pos) {\n        int len = str.length();\n        return pos + 2 < len - 1 && str.charAt(pos + 1) == 'o' && str.charAt(pos + 2) == 't';\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        String s = scanner.next();\n        scanner.close();\n\n        StringBuilder ans = new StringBuilder(s.length());\n        ans.append(s.charAt(0));\n\n        boolean replacedAt = false;\n\n        for (int i = 1; i < s.length(); ) {\n            if (s.charAt(i) == 'a' && !replacedAt && at(s, i)) {\n                ans.append('@');\n                replacedAt = true;\n                i += 2;\n            } else if (s.charAt(i) == 'd' && dot(s, i)) {\n                ans.append('.');\n                i += 3;\n            } else {\n                ans.append(s.charAt(i));\n                ++i;\n            }\n        }\n\n        System.out.println(ans.toString());\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0002858230145648122, -3.933898824470816e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -3.8265450712060556e-05, -3.6954811548639555e-06, 0.0, -2.1457441107486375e-05, -0.0009120118920691311, -0.0002646096108946949, -5.876845170860179e-05, 0.0, -0.004672442562878132, -7.617183291586116e-05, -0.00026246439665555954, -0.14123447239398956, -3.576278118089249e-07, -5.125986263010418e-06, -0.00016604475968051702, -0.00024029705673456192, -0.0015031717484816909, 0.0, 0.0, -1.4305104514278355e-06, -1.0251946150674485e-05, -5.960462772236497e-07, 0.0, -0.0009858515113592148, -7.712543447269127e-05, 0.0, 0.0, -4.541770613286644e-05, -1.1920928244535389e-07, -6.198863957251888e-06, 0.0, 0.0, -9.536738616588991e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.0967194612021558e-05, 0.0, 0.0, 0.0, 