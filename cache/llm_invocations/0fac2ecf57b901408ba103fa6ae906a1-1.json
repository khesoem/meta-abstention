starting positions\n    for _ in range(k):\n        tp = int(data[idx]); idx += 1\n        add(s, (0 * n + tp), 1, 0)\n    \n    # Read edges\n    E = []\n    for _ in range(m):\n        u = int(data[idx]); v = int(data[idx+1]); idx += 2\n        E.append((u, v))\n    \n    # Build the graph\n    for i in range(1, cs):\n        add(i * n + 1, t, k, c * i)\n        for j in range(1, n + 1):\n            add((i - 1) * n + j, i * n + j, k, 0)\n        for j in range(m):\n            u, v = E[j]\n            for t_val in range(1, k + 1):\n                add((i - 1) * n + u, i * n + v, 1, (2 * t_val - 1) * d)\n                add((i - 1) * n + v, i * n + u, 1, (2 * t_val - 1) * d)\n    \n    # SPFA and MCMF\n    def spfa():\n        dis = [10**9] * (tot + 1)\n        vis = [False] * (tot + 1)\n        pre = [-1] * (tot + 1)\n        q = deque()\n        dis[s] = 0\n        q.append(s)\n        \n        while q:\n            u = q.popleft()\n            vis[u] = False\n            i = head[u]\n            while i != -1:\n                edge = e[i]\n                v = edge['to']\n                if edge['val'] > 0 and dis[v] > dis[u] + edge['w']:\n                    dis[v] = dis[u] + edge['w']\n                    pre[v] = i\n                    if not vis[v]:\n                        vis[v] = True\n                        q.append(v)\n                i = edge['next']\n        \n        return dis[t] < 10**9\n    \n    total_cost = 0\n    total_flow = 0\n    \n    while spfa():\n        flow = 10**9\n        x = t\n        while x != s:\n            edge_idx = pre[x]\n            flow = min(flow, e[edge_idx]['val'])\n            x = e[edge_idx ^ 1]['to']\n        \n        x = t\n        while x != s:\n            edge_idx = pre[x]\n            e[edge_idx]['val'] -= flow\n            e[edge_idx ^ 1]['val'] += flow\n            x = e[edge_idx ^ 1]['to']\n        \n        total_flow += flow\n        total_cost += dis[t] * flow\n    \n    print(total_cost)\n\nif __name_