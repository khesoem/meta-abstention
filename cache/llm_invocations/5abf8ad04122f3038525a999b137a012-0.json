{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static int cap, totalF, totalS;\n    static long[][] C;\n    static List<int[]>[][] moves;\n\n    static int encode(int f, int s, int b) {\n        return ((f * (totalS + 1) + s) << 1) | b;\n    }\n\n    static int decodeF(int code) {\n        return (code >> 1) / (totalS + 1);\n    }\n\n    static int decodeS(int code) {\n        return (code >> 1) % (totalS + 1);\n    }\n\n    static int decodeB(int code) {\n        return code & 1;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        cap = sc.nextInt() / 50;\n        totalF = 0;\n        totalS = 0;\n        for (int i = 0; i < n; i++) {\n            if (sc.nextInt() == 100) totalF++;\n            else totalS++;\n        }\n\n        C = new long[51][51];\n        for (int i = 0; i <= 50; i++) {\n            C[i][0] = C[i][i] = 1;\n            for (int j = 1; j < i; j++) {\n                C[i][j] = (C[i - 1][j - 1] + C[i - 1][j]) % MOD;\n            }\n        }\n\n        moves = new List[totalF + 1][totalS + 1];\n        for (int a = 0; a <= totalF; a++) {\n            for (int b = 0; b <= totalS; b++) {\n                List<int[]> list = new ArrayList<>();\n                for (int i = 0; i <= a; i++) {\n                    for (int j = 0; j <= b; j++) {\n                        if (i + j > 0 && 2 * i + j <= cap) {\n                            list.add(new int[]{i, j});\n                        }\n                    }\n                }\n                moves[a][b] = list;\n            }\n        }\n\n        long[][][] cur = new long[totalF + 1][totalS + 1][2];\n        cur[totalF][totalS][1] = 1;\n        List<Integer> active = new ArrayList<>();\n        active.add(encode(totalF, totalS, 1));\n\n        for (int rides = 1; rides <= 200; rides++) {\n            long[][][] next = new long[totalF + 1][totalS + 1][2];\n            boolean[][][] seen = new boolean[totalF + 1][totalS + 1][2];\n            List<Integer> nextActive = new ArrayList<>();\n\n            for (int code : active) {\n                int f = decodeF(code);\n                int s = decodeS(code);\n                int b = decodeB(code);\n                long w = cur[f][s][b];\n                if (w == 0) continue;\n\n                if (b == 1) {\n                    for (int[] mv : moves[f][s]) {\n                        int i = mv[0];\n                        int j = mv[1];\n                        int nf = f - i;\n                        int ns = s - j;\n                        long add = w * C[f][i] % MOD * C[s][j] % MOD;\n                        if (!seen[nf][ns][0] && add != 0) {\n                            seen[nf][ns][0] = true;\n                            nextActive.add(encode(nf, ns, 0));\n                        }\n                        next[nf][ns][0] = (next[nf][ns][0] + add) % MOD;\n                    }\n                } else {\n                    for (int[] mv : moves[totalF - f][totalS - s]) {\n                        int i = mv[0