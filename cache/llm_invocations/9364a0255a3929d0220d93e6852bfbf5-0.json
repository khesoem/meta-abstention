Mtx pow(int e) const {\n        Mtx res(dim, 1);\n        Mtx base = *this;\n        while (e) {\n            if (e & 1) res *= base;\n            base *= base;\n            e >>= 1;\n        }\n        return res;\n    }\n\n    void show() const {\n        for (int i = 0; i < dim; ++i) {\n            for (int j = 0; j < dim; ++j)\n                DB1(\"%d \", (int)m[i][j]);\n            DB1(\"\\n\");\n        }\n        DB1(\"\\n\");\n    }\n\n    ll* operator[](int i) { return m[i]; }\n    const ll* operator[](int i) const { return m[i]; }\n};\n\nint main() {\n#ifdef DBG1\n    freopen(\".in\", \"r\", stdin);\n    freopen(\".out\", \"w\", stdout);\n    freopen(\".err\", \"w\", stderr);\n#endif\n\n    ll N;\n    int K;\n    cin >> N >> K;\n\n    if (N <= K) {\n        cout << ((1LL << N) % MOD) << '\\n';\n        return 0;\n    }\n\n    int depth = static_cast<int>(log(N + 0.0) / log(K + 0.0) + 2);\n\n    Mtx trans(K + 1, 1);\n    for (int j = 0; j < K; ++j) {\n        trans[j][j] = 0;\n        trans[(j + 1) % K][j] = 1;\n    }\n\n    vector<Mtx> pre(depth);\n    pre[0] = Mtx(K + 1, 1);\n    for (int i = 1; i <= K; ++i) pre[0][0][i] = 1;\n\n    for (int i = 1; i < depth; ++i)\n        pre[i] = (pre[i - 1] * trans).pow(K);\n\n    int expIdx = 0;\n    ll block = 1;\n    while (N / block >= K) {\n        ++expIdx;\n        block *= K;\n    }\n\n    Mtx state(K + 1, 1);\n    while (N) {\n        if (block <= N) {\n            int cnt = static_cast<int>(N / block);\n            state *= (pre[expIdx] * trans).pow(cnt);\n            N -= block * cnt;\n        }\n        --expIdx;\n        block /= K;\n    }\n\n    ll total = 0;\n    for (int i = 0; i <= K; ++i)\n        (total += state[i][K]) %= MOD;\n    cout << total << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\nimport sys\n\nMOD = 1000000007\n\nclass Mtx:\n    MA