em != 1)\n    {\n        frac[0] /= greater;\n        frac[1] /= greater;\n    }\n}\n\nint main()\n{\n    long long x, y, limit;\n    while (cin >> x >> y >> limit)\n    {\n        long long ans[2];\n\n        if (y <= limit)\n        {\n            ans[0] = x;\n            ans[1] = y;\n        }\n        else\n        {\n            search_best(x, y, limit, ans);\n        }\n\n        reduce_array(ans);\n        cout << ans[0] << \"/\" << ans[1] << endl;\n    }\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef search_best(x, y, limit):\n    best = 1.0\n    frac = [0, 0]\n    for i in range(1, limit + 1):\n        k = i * x // y\n        # error for k/i\n        err = float(x / y - k / i)\n        if err < best:\n            best = err\n            frac[0] = k\n            frac[1] = i\n        # error for (k+1)/i\n        err = float((k + 1) / i - x / y)\n        if err < best:\n            best = err\n            frac[0] = k + 1\n            frac[1] = i\n    return frac\n\ndef reduce_array(frac):\n    g = math.gcd(frac[0], frac[1])\n    if g != 0:\n        frac[0] //= g\n        frac[1] //= g\n\ndef main():\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.split()\n        if len(parts) < 3:\n            continue\n        x, y, limit = map(int, parts[:3])\n        if y <= limit:\n            ans = [x, y]\n        else:\n            ans = search_best(x, y, limit)\n        reduce_array(ans)\n        print(f\"{ans[0]}/{ans[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.2698590159416199, -0.001739775761961937, -1.5497195136049413e-06, -2.3841855067985307e-07, 0.0, -2.658331868587993e-05, -2.312633478140924e-05, -0.0007098776986822486, -0.062492303550