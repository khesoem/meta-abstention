{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<algorithm>\n#include<cstdio>\n#include<queue>\n#define Maxn 5500\n#define Maxm 35500\n#define INF 1000000000\nusing namespace std;\nstruct Edge\n{int nxt,to,cost,cap;}ed[Maxm];\nint head[Maxn],ptr=1;\nvoid add(int from,int to,int cap,int cost){\n  ed[++ptr]=(Edge){head[from],to,cost,cap};head[from]=ptr;\n  ed[++ptr]=(Edge){head[to],from,-cost,0};head[to]=ptr;\n}\nint S,T,prev[Maxn],edge_idx[Maxn],flow_val[Maxn],dist_val[Maxn];\nbool mark[Maxn];\nqueue<int> qq;\nint spfa()\n{\n  for (int i=1;i<=T;i++){\n    dist_val[i]=INF;flow_val[i]=0;\n  }\n  flow_val[S]=INF;dist_val[S]=0;\n  qq.push(S);mark[S]=1;\n  while(!qq.empty()){\n    int u=qq.front();\n    mark[u]=0;qq.pop();\n    for (int i=head[u],v;i;i=ed[i].nxt)\n      if (ed[i].cap>0&&dist_val[v=ed[i].to]>dist_val[u]+ed[i].cost){\n        dist_val[v]=dist_val[u]+ed[i].cost;\n        flow_val[v]=min(flow_val[u],ed[i].cap);\n        edge_idx[v]=i;prev[v]=u;\n        if (!mark[v]){mark[v]=1;qq.push(v);}\n     }\n  }return flow_val[T];\n}\nint n,m,k,C,D,pos[105][105],state[105][105];\nstruct Node\n{int from,to;}nodes[105];\n#define encode(x,y) ((x)*n+(y))\nint main()\n{\n  scanf(\"%d%d%d%d%d\",&n,&m,&k,&C,&D);\n  S=encode(n+k,n)+1;T=S+2;\n  add(encode(0,1),T,INF,0);\n  for (int i=1;i<=k;i++){\n    int p;\n    scanf(\"%d\",&p);\n    add(S,encode(0,p),1,0);\n  }\n  for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&nodes[i*2].from,&nodes[i*2].to);\n    nodes[i*2-1]=(Node){nodes[i*2].to,nodes[i*2].from};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      add(encode(t-1,i),encode(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      add(encode(t-1,nodes[i].from),encode(t,nodes[i].to),1,D);\n      pos[t][i]=ptr;state[t][i]=1;\n    }add(encode(t,1),T,INF,t*C);\n  }\n  int added_flow,total=0;\n  while((added_flow=spfa())!=0){\n    int u=T;\n    while(u!=S){\n      int v=prev[u];\n      ed[edge_idx[u]].cap-=added_flow;\n      ed[edge_idx[u]^1].cap+=added_flow;\n      u=v;\n    }total+=dist_val[T]*added_flow;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (ed[pos[t][i]].cap>0){\n          state[t][i]++;\n          add(encode(t-1,nodes[i].from),encode(t,nodes[i].to),1,D*(state[t][i]*2-1));\n          pos[t][i]=ptr;\n        }\n  }printf(\"%d\\n\",total);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); C = next(it); D = next(it)\n    \n    # encode function: (x, y) -> x*n + y, x from 0 to n+k, y from 1 to n\n    def encode(x, y):\n        return x * n + y\n    \n    # total nodes: S and T are separate\n    max_node = encode(n + k, n)  # maximum node index from encoding\n    S = max_node + 1\n    T = S + 2\n    total_nodes = T\n    \n    # edge storage: list of [nxt, to, cost, cap], 1-indexed, index 0 is dummy\n    edges = [[0, 0, 0, 0]]  # dummy edge at index 0\n    head = [0] * (total_nodes + 1)\n    \n    def add_edge(from_node, to_node, cap, cost):\n        # forward edge\n        edges.append([head[from_node], to_node, cost, cap])\n        head[from_node] = len(edges) - 1\n        # reverse edge\n        edges.append([head[to_node], from_node, -cost, 0])\n        head[to_node] = len(edges) - 1\n    \n    # initial edges\n    add_edge(encode(0, 1), T, 10**9, 0)  # INF = 10**9\n    \n    for _ in range(k):\n        p = next(it)\n        add_edge(S, encode(0, p), 1, 0)\n    \n    # read edges (bidirectional)\n    nodes = [None] * (2 * m + 1)  # 1-indexed, pairs\n    for i in range(1, m + 1):\n        u = next(it); v = next(it)\n        nodes[2 * i] = (u, v)\n        nodes[2 * i - 1] = (v, u)\n    m *= 2  # now m is number of directed edges\n    \n    # pos[t][i] and state[t][i] for t up to n+k (and possibly more)\n    max_t = n + k\n    pos = [[0] * (m + 1) for _ in range(max_t + 1)]  # 1-indexed t and i\n    state = [[0] * (m + 1) for _ in range(max_t + 1)]\n    \n    # build initial time layers\n    for t in range(1, max_t + 1):\n        # stay edges (infinite capacity, zero cost)\n        for i in range(1, n + 1):\n            add_edge(encode(t - 1, i), encode(t, i), 10**9, 0)\n        # move edges\n        for i in range(1, m + 1):\n            u, v = nodes[i]\n            add_edge(encode(t - 1, u), encode(t, v), 1, D)\n            pos[t][i] = len(edges) - 2  # index of forward edge (since we just added two edges)\n            state[t][i] = 1\n        # edge to sink with cost t*C\n        add_edge(encode(t, 1), T, 10**9, t * C)\n    \n    # SPFA (shortest path faster algorithm)\n    dist = [0] * (total_nodes + 1)\n    flow = [0] * (total_nodes + 1)\n    prev = [0] * (total_nodes + 1)\n    edge_idx = [0] * (total_nodes + 1)\n    in_queue = [False] * (total_nodes + 1)\n    \n    def spfa():\n        for i in range(1, total_nodes + 1):\n            dist[i] = 10**9\n            flow[i] = 0\n        flow[S] = 10**9\n        dist[S] = 0\n        q = deque()\n        q.append(S)\n        in_queue[S] = True\n        while q:\n            u = q.popleft()\n            in_queue[u] = False\n            i = head[u]\n            while i != 0:\n                v = edges[i][1]\n                cap = edges[i][3]\n                cost = edges[i][2]\n                if cap > 0 and dist[v] > dist[u] + cost:\n                    dist[v] = dist[u] + cost\n                    flow[v] = min(flow[u], cap)\n                    prev[v] = u\n                    edge_idx[v] = i\n                    if not in_queue[v]:\n                        in_queue[v] = True\n                        q.append(v)\n                i = edges[i][0]\n        return flow[T]\n    \n    total_cost = 0\n    while True:\n        added_flow = spfa()\n        if added_flow == 0:\n            break\n        u = T\n        while u != S:\n            v = prev[u]\n            e = edge_idx[u]\n            edges[e][3] -= added_flow\n            edges[e ^ 1][3] += added_flow\n            u = v\n        total_cost += dist[T] * added_flow\n        \n        # update edges for each time step (note: loop bound is n+n as in original code)\n        for t in range(1, n + n + 1):\n            for i in range(1, m + 1):\n                if t <= max_t and pos[t][i] != 0 and edges[pos[t][i]][3] > 0:\n                    state[t][i] += 1\n                    u, v = nodes[i]\n                    add_edge(encode(t - 1, u), encode(t, v), 1, D * (state[t][i] * 2 - 1))\n                    pos[t][i] = len(edges) - 2  # index of new forward edge\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012706902634818107, 0.0, 0.0, -0.0002119316632160917, -0.018242554739117622, 0.0, -7.748573807475623e-06, -7.629103492945433e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.70062324590981e-05, -0.060890380293130875, -0.2597586810588