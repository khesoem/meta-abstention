;\n\n    for(int i = 0; i < n; ++i) {\n        for(int j = 0; j < n; ++j) {\n            cin >> prob[i][j];\n            prob[i][j] = 1LL * prob[i][j] * modPow(100, MOD - 2) % MOD;\n        }\n    }\n\n    for(int i = 0; i < n; ++i) {\n        for(int mask = 0; mask < (1 << n); ++mask) {\n            transProb[i][mask] = 1;\n            for(int k = 0; k < n; ++k) {\n                if((mask >> k) & 1)\n                    transProb[i][mask] = 1LL * transProb[i][mask] * prob[k][i] % MOD;\n                else\n                    transProb[i][mask] = 1LL * transProb[i][mask] * (MOD + 1 - prob[k][i]) % MOD;\n            }\n        }\n    }\n\n    dp[0][1] = 1;\n    for(int i = 0; i < n; ++i) {\n        for(int j = 1; j <= cnt; ++j) {\n            for(int mask = 0; mask < (1 << n); ++mask) {\n                int to = nxtState[j][mask];\n                dp[i + 1][to] = (dp[i + 1][to] + 1LL * dp[i][j] * transProb[i][mask]) % MOD;\n            }\n        }\n    }\n\n    if(n < 6)\n        cout << dp[n][mp[(1ull << (1 << n)) - 1]] << '\\n';\n    else\n        cout << dp[n][mp[ULLONG_MAX]] << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MAXS = 100000 + 10;\n    static final int MOD = 1000000007;\n    static int n, cnt = 0;\n    static int[][] nxtState = new int[MAXS][64];\n    static int[][] prob = new int[10][10];\n    static int[][] transProb = new int[10][64];\n    static int[][] dp = new int[10][MAXS];\n    static Map<Long, Integer> mp = new HashMap<>();\n\n    static int modPow(int a, int b) {\n        long res = 1;\n        long base = a;\n        while (b > 0) {\n            if ((b & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            b >>= 1;\n        }\n        return (int) res;\n    }\n\n    static