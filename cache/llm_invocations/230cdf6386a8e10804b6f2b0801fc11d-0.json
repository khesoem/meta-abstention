            } else {\n                break;\n            }\n        }\n        \n        System.out.println(total);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n\nint main() {\n    std::string line1;\n    std::getline(std::cin, line1);\n    std::vector<std::string> parts1;\n    size_t pos = 0;\n    while ((pos = line1.find(\" \")) != std::string::npos) {\n        parts1.push_back(line1.substr(0, pos));\n        line1.erase(0, pos + 1);\n    }\n    parts1.push_back(line1);\n    \n    int length = std::stoi(parts1[0]);\n    int money = std::stoi(parts1[1]);\n    \n    std::string line2;\n    std::getline(std::cin, line2);\n    std::vector<std::string> data_parts;\n    pos = 0;\n    while ((pos = line2.find(\" \")) != std::string::npos) {\n        data_parts.push_back(line2.substr(0, pos));\n        line2.erase(0, pos + 1);\n    }\n    data_parts.push_back(line2);\n    \n    std::vector<int> data;\n    for (const auto& s : data_parts) {\n        data.push_back(std::stoi(s));\n    }\n    \n    int odd = 0, even = 0, total = 0;\n    std::vector<int> diffs(length);\n    int diffIndex = 0;\n    \n    for (int i = 0; i < length - 1; i++) {\n        int current = data[i];\n        if (current % 2 == 0) even++;\n        else odd++;\n        \n        if (odd == even) {\n            int next = data[i + 1];\n            int diff = std::abs(next - current);\n            diffs[diffIndex++] = diff;\n        }\n    }\n    \n    std::sort(diffs.begin(), diffs.begin() + diffIndex);\n    \n    for (int i = 0; i < diffIndex; i++) {\n        if (money >= diffs[i]) {\n            money -= diffs[i];\n            total++;\n        } else {\n            break;\n        }\n    }\n    \n    std::cout << total << std::endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n