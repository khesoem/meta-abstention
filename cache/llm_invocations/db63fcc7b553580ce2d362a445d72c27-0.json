          # check that each item's assigned group has bit 1 in mask\n                good = True\n                used = 0\n                for idx, grp in enumerate(assign):\n                    bit = (mask >> (idx * n + grp)) & 1\n                    if not bit:\n                        good = False\n                        break\n                    if used & (1 << grp):\n                        good = False\n                        break\n                    used |= 1 << grp\n                if good:\n                    msk = used\n                    if R == n:\n                        msk ^= (1 << n) - 1\n                    idx_mask = valOfMask[msk]\n                    if idx_mask != -1:\n                        sets |= 1 << idx_mask\n            callback(sets, p)\n\n    # first half\n    run(0, mid, lambda s, p: sum_arr.__setitem__(s, (sum_arr[s] + p) % MOD))\n\n    # SOS DP (subset sum)\n    size = len(sum_arr)\n    d = 1\n    while d < size:\n        for i in range(size):\n            if (i & d) == 0:\n                sum_arr[i | d] = (sum_arr[i | d] + sum_arr[i]) % MOD\n        d <<= 1\n\n    total = sum_arr[-1]\n    ans = 0\n    # second half\n    def second_callback(s, p):\n        nonlocal ans\n        complement = (size - 1) - s\n        ans = (ans + p * (total - sum_arr[complement])) % MOD\n\n    run(mid, n, second_callback)\n\n    print(ans % MOD)\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-0.47616785764694214, -1.4305104514278355e-06, -0.0002361257211305201, -0.0010109796421602368, -0.0031840126030147076, -0.0016608743462711573, -0.0141682680696249, -0.014165212400257587, -0.02977471612393856, -4.684815212385729e-05, -7.152555099310121e-07, -4.768370445162873e-07, -0.0005806190893054008, -3.099436753473128e-06, -2.3841855067985307e-07, -1.6689286894688848e-06, -0.16022512316703796, -0.07890021055936813, -1.1920928244535389e-07, -0.005234109237790108, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, 0.0, -3.576