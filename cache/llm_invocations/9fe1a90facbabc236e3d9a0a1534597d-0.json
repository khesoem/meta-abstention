cnt(n + 1);\n    for (int m = 0; m < (1 << n); ++m) {\n        masks_by_popcnt[popcnt[m]].push_back(m);\n    }\n    \n    vector<vector<vector<i64>>> T(n + 1, vector<vector<i64>>(n + 1, vector<i64>(1 << n, 0)));\n    for (int k = 0; k <= n; ++k) {\n        for (int idx = 0; idx < (int)masks_by_popcnt[k].size(); ++idx) {\n            int cm = masks_by_popcnt[k][idx];\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if ((mask & cm) == mask) continue;\n                i64 val = 0;\n                for (int x = 0; x < n; ++x) {\n                    if (cm & (1 << x)) continue;\n                    if (!(mask & (1 << x))) continue;\n                    int nm = cm | (1 << x);\n                    val |= (1LL << (int)masks_by_popcnt[popcnt[nm]].size());\n                }\n                T[k][idx][mask] = val;\n            }\n        }\n    }\n    \n    vector<unordered_map<i64, i64>> DP(n + 1);\n    DP[0][1] = 1;\n    \n    for (int k = 0; k < n; ++k) {\n        for (int edges = 0; edges < (1 << n); ++edges) {\n            i64 prob = 1;\n            for (int i = 0; i < n; ++i) {\n                i64 p = ((edges >> i) & 1) ? A[k][i] : sub(1, A[k][i]);\n                prob = mul(prob, p);\n            }\n            for (const auto& [mask, val] : DP[k]) {\n                i64 newmask = 0;\n                i64 p = mul(prob, val);\n                for (int i = 0; i < (int)masks_by_popcnt[k].size(); ++i) {\n                    if (mask & (1 << i)) {\n                        newmask |= T[k][i][edges];\n                    }\n                }\n                if (newmask) {\n                    DP[k + 1][newmask] = add(DP[k + 1][newmask], p);\n                }\n            }\n        }\n    }\n    \n    cout << DP[n][1] << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final long MOD = 1000000007;\n    \n    static long add(long a, long b) {\n        return (a + b) % MOD;\n    }\n    \n    static long sub(long a, long b) {\n        return ((a - b) % MOD + MOD) % MOD;\n    }\n    \n    static long mul(long a, long b) {\n        return (a * b) % MOD;\n    }\n    \n    static long pow_mod(long base, long exp) {\n        long res = 1;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = mul(res, base);\n            base = mul(base, base);\n            exp >>= 1;\n        }\n        return res;\n    }\n    \n    static long inv_mod(long x) {\n        return pow_mod(x, MOD - 2);\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        \n        long[][] A = new long[n][n];\n        for (int i = 0; i < n; ++i) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; ++j) {\n                A[i][j] = mul(Long.parseLong(st.nextToken()), inv_mod(100));\n            }\n        }\n        \n        int[] popcnt = new int[1 << n];\n        for (int m = 0; m < (1 << n); ++m) {\n            popcnt[m] = Integer.bitCount(m);\n        }\n        \n        List<List<Integer>> masks_by_popcnt = new ArrayList<>();\n        for (int i = 0; i <= n; ++i) {\n            masks_by_popcnt.add(new ArrayList<>());\n        }\n        for (int m = 0; m < (1 << n); ++m) {\n            masks_by_popcnt.get(popcnt[m]).add(m);\n        }\n        \n        long[][][] T = new long[n + 1][n + 1][1 << n];\n        for (int k = 0; k <= n; ++k) {\n            for (int idx = 0; idx < masks_by_popcnt.get(k).size(); ++idx) {\n                int cm = masks_by_popcnt.get(k).get(idx);\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    if ((mask & cm) == mask) continue;\n                    long val = 0;\n                    for (int x = 0; x < n; ++x) {\n                        if ((cm & (1 << x)) != 0) continue;\n                        if ((mask & (1 << x)) == 0) continue;\n                        int nm = cm | (1 << x);\n                        val |= (1L << masks_by_popcnt.get(popcnt[nm]).size());\n                    }\n                    T[k][idx][mask] = val;\n                }\n            }\n        }\n        \n        List<Map<Long, Long>> DP = new ArrayList<>();\n        for (int i = 0; i <= n; ++i) {\n            DP.add(new HashMap<>());\n        }\n        DP.get(0).put(1L, 1L);\n        \n        for (int k = 0; k < n; ++k) {\n            for (int edges = 0; edges < (1 << n); ++edges) {\n                long prob = 1;\n                for (int i = 0; i < n; ++i) {\n                    long p = ((edges >> i) & 1) == 1 ? A[k][i] : sub(1, A[k][i]);\n                    prob = mul(prob, p);\n                }\n                for (Map.Entry<Long, Long> entry : DP.get(k).entrySet()) {\n                    long mask = entry.getKey();\n                    long val = entry.getValue();\n                    long newmask = 0;\n                    long p = mul(prob, val);\n                    for (int i = 0; i < masks_by_popcnt.get(k).size(); ++i) {\n                        if ((mask & (1L << i)) != 0) {\n                            newmask |= T[k][i][edges];\n                        }\n                    }\n                    if (newmask != 0) {\n                        DP.get(k + 1).put(newmask, add(DP.get(k + 1).getOrDefault(newmask, 0L), p));\n                    }\n                }\n            }\n        }\n        \n        System.out.println(DP.get(n).getOrDefault(1L, 0L));\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00014304091746453196, -1.7881377516459906e-06, -9.536738616588991e-07, -0.0004065402317792177, -3.361645576660521e-05,