ue;\n                            q.add(to_arr.get(eid));\n                        }\n                    }\n                }\n            }\n            if (dist2[t2] == INF) return -1;\n            long add = f;\n            for (int v = t2; v != s2; v = pre1[v])\n                add = Math.min(add, cap_arr.get(pre2[v]));\n            f -= add;\n            ans += add * dist2[t2];\n            for (int v = t2; v != s2; v = pre1[v]) {\n                int eid = pre2[v];\n                cap_arr.set(eid, cap_arr.get(eid) - add);\n                cap_arr.set(eid ^ 1, cap_arr.get(eid ^ 1) + add);\n            }\n        }\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long N = sc.nextLong();\n        long M = sc.nextLong();\n        long K = sc.nextLong();\n        long C = sc.nextLong();\n        long D = sc.nextLong();\n        long[] A = new long[58];\n        for (long i = 1; i <= K; i++) {\n            int x = sc.nextInt();\n            A[x]++;\n        }\n        ArrayList<Integer>[] H = new ArrayList[57];\n        for (int i = 0; i < 57; i++) H[i] = new ArrayList<>();\n        for (int i = 1; i <= M; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            H[x].add(y);\n            H[y].add(x);\n        }\n\n        init2(5103, 0, 5101);\n        for (int i = 2; i <= N; i++) add_flow_edge(0, i, A[i], 0);\n        for (int i = 0; i <= 100; i++) {\n            for (int l = 1; l <= N; l++) {\n                add_flow_edge(50 * i + l, 50 * (i + 1) + l, K, 0);\n                for (int j : H[l]) {\n                    for (long k = 1; k <= K; k++) {\n                        add_flow_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                    }\n                }\n            }\n        }\n        for (int i = 1; i <= 101; i++) add_flow_edge(50 * i + 1, 5101, K, C * i);\n        System.out.println(get_min_cost_flow(K));\n    }\n}\n</tr