t(rev,255,sizeof(rev));\n        for(int i=0;i<n;i++){\n            memset(v,0,sizeof(v));\n            if(match(i,e)) cnt++;\n        }\n        return cnt;\n    }\nprivate:\n    int v[SIZE];\n    bool match(int x, vector<int> e[]){\n        for(int i=0;i<int(e[x].size());i++){\n            int y=e[x][i];\n            if(!v[y]) v[y]=1; else continue;\n            if(rev[y]<0 || match(rev[y],e)){\n                pos[x]=y;\n                rev[y]=x;\n                return true;\n            }\n        }\n        return false;\n    }\n};\n\n#include <cstdio>\n#include <cmath>\n#include <cstring>\n#include <utility>\n#include <vector>\n#include <queue>\n#include <algorithm>\nusing namespace std;\n\nconst int INF=1000000000;\nconst int mr[]={0,-1,0,1};\nconst int mc[]={1,0,-1,0};\n\nint a[12][12],b[12][12],f[12][12],m,t;\nvector<int> e[2000];\nvector<int> c[12][12];\n\nvoid floodfill(int sr, int sc){\n    queue<int> qr;\n    queue<int> qc;\n    memset(f,255,sizeof(f));\n    qr.push(sr);\n    qc.push(sc);\n    f[sr][sc]=0;\n    while(!qr.empty()){\n        sr=qr.front(); qr.pop();\n        sc=qc.front(); qc.pop();\n        for(int i=0;i<4;i++){\n            int tr=sr+mr[i];\n            int tc=sc+mc[i];\n            if(a[tr][tc]>=0 && f[tr][tc]<0){\n                f[tr][tc]=f[sr][sc]+1;\n                qr.push(tr);\n                qc.push(tc);\n            }\n        }\n    }\n}\n\nvoid setmark(int sr, int sc, int cnt){\n    int v[12][12];\n    queue<int> qr;\n    queue<int> qc;\n    memset(v,255,sizeof(v));\n    qr.push(sr);\n    qc.push(sc);\n    v[sr][sc]=0;\n    //printf(\"escape from (%d,%d) ->\",sr,sc);\n    while(!qr.empty()){\n        sr=qr.front(); qr.pop();\n        sc=qc.front(); qc.pop();\n        if(v[sr][sc]> min(t,f[sr][sc])) continue;\n        for(int j=0;j<int(c[sr][sc].size());j++)\n            for(int i=0;i<cnt;i++) e[m+i].push_back(c[sr][sc][j]);\n        if(v[sr][sc]==min(t,f[sr][sc])) continue;\n        for(int i=0;i<4;i++){\n            int tr