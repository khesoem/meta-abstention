* self.SIZE\n\n    def gao(self, n, e):\n        self.cnt = 0\n        self.pos = [-1] * self.SIZE\n        self.rev = [-1] * self.SIZE\n        for i in range(n):\n            self.v = [0] * self.SIZE\n            if self.match(i, e):\n                self.cnt += 1\n        return self.cnt\n\n    def match(self, x, e):\n        for y in e[x]:\n            if self.v[y] == 0:\n                self.v[y] = 1\n                if self.rev[y] < 0 or self.match(self.rev[y], e):\n                    self.pos[x] = y\n                    self.rev[y] = x\n                    return True\n        return False\n\nimport sys\nfrom collections import deque\n\nINF = 10**9\nmr = [0, -1, 0, 1]\nmc = [1, 0, -1, 0]\n\nn, t = 0, 0\na = [[-1] * 12 for _ in range(12)]\nb = [[-1] * 12 for _ in range(12)]\nf = [[-1] * 12 for _ in range(12)]\ne = [[] for _ in range(2000)]\nc = [[[] for _ in range(12)] for _ in range(12)]\n\ndef floodfill(sr, sc):\n    queue = deque()\n    queue.append((sr, sc))\n    f[sr][sc] = 0\n    while queue:\n        sr, sc = queue.popleft()\n        for i in range(4):\n            tr = sr + mr[i]\n            tc = sc + mc[i]\n            if 0 <= tr < 12 and 0 <= tc < 12 and a[tr][tc] >= 0 and f[tr][tc] < 0:\n                f[tr][tc] = f[sr][sc] + 1\n                queue.append((tr, tc))\n\ndef setmark(sr, sc, cnt, m, o):\n    v = [[-1] * 12 for _ in range(12)]\n    queue = deque()\n    queue.append((sr, sc))\n    v[sr][sc] = 0\n    while queue:\n        sr, sc = queue.popleft()\n        if v[sr][sc] > min(t, f[sr][sc]):\n            continue\n        for j in c[sr][sc]:\n            for i in range(cnt):\n                e[m + i].append(j)\n        if v[sr][sc] == min(t, f[sr][sc]):\n            continue\n        for i in range(4):\n            tr = sr + mr[i]\n            tc = sc + mc[i]\n            if 0 <= tr < 12 and 0 <= tc < 12 and a[tr][tc] >= 0 and v[tr][tc] < 0:\n                v[tr][tc] = v[sr][sc] + 1\n                queue.append((tr, tc))\n    return m 