2 in range(len(selected)):\n                    bitPos = idx2 * n + selected[idx2]\n                    if not (mask & (1 << bitPos)):\n                        valid = False\n                        break\n                if valid:\n                    successMask |= (1 << m)\n                    valid_found = True\n                    break\n                if not next_permutation(selected):\n                    break\n            if valid_found:\n                continue\n        \n        prob[successMask] = (prob[successMask] + p) % MOD\n    \n    # Second part: process masks for the remaining h2 rows\n    for mask in range(1 << (n * h2)):\n        p = 1\n        for bit in range(n * h2):\n            row = bit // n + h\n            col = bit % n\n            if mask & (1 << bit):\n                p = (p * P[row][col] % MOD) * inv100 % MOD\n            else:\n                p = (p * (100 - P[row][col]) % MOD) * inv100 % MOD\n        \n        successMask = 0\n        for m in range(len(masks)):\n            selected = []\n            for k in range(n):\n                if not (masks[m] & (1 << k)):\n                    selected.append(k)\n            selected.sort()\n            valid_found = False\n            while True:\n                valid = True\n                for idx2 in range(len(selected)):\n                    bitPos = idx2 * n + selected[idx2]\n                    if not (mask & (1 << bitPos)):\n                        valid = False\n                        break\n                if valid:\n                    successMask |= (1 << m)\n                    valid_found = True\n                    break\n                if not next_permutation(selected):\n                    break\n            if valid_found:\n                continue\n        \n        prob2[successMask] = (prob2[successMask] + p) % MOD\n    \n    # Sum over subsets for prob2\n    numMasks = len(masks)\n    for i in range(1 << numMasks):\n        for j in range(numMasks):\n            if i & (1 << j):\n                prob2[i] = (prob2[i] + prob2[i ^ (1 << j)]) % MOD\n    \n    # Calculate final answer\n    answer = 0\n    for i in range(1 << numMasks):\n        answer = (answer + prob[i] * prob2[((1 << numMasks) - 1) ^ i]) % MOD\n    \n    print((MOD + 1 - answer) % MOD)\n\ndef next_permutation(arr):\n    # Find the largest index k such that arr[k] < arr[k+1]\n    k = len(arr) - 2\n    while k >= 0 and arr[k] >= arr[k + 1]:\n        k -= 1\n    if k < 0:\n        return False\n    \n    # Find the largest index l > k such that arr[k] < arr[l]\n    l = len(arr) - 1\n    while arr[k] >= arr[l]:\n        l -= 1\n    \n    # Swap arr[k] and arr[l]\n    arr[k], arr[l] = arr[l], arr[k]\n    \n    # Reverse the suffix starting at arr[k+1]\n    arr[k+1:] = reversed(arr[k+1:])\n    return True\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.570780482841656e-05, -1.7881377516459906e-06, -3.576278118089249e-07, -0.013488936237990856, -0.009476322680711746, -0.009760631248354912, -0.35071173310279846, -0.022512931376695633, -0.17975032329559326, -0.10319399833679199, -9.536738616588991e-07, -2.264974000354414e-06, 0.0, 0.0, -0.00524205481633544, 0.0, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, -4.768370445162873e-07, -5.960462772236497e-07, -2.3841855067985307e-07, -5.722029527532868e-06, -2.7656173188006505e-05, -8.761498611420393e-05, -0.47485047578811646, -1.4305104514278355e-06, -1.1920928244535389e-07, -2.586808113846928e-05, -4.207999518257566e-05, -5.960462772236497e-07, -8.4638240878121e-06, 0.0, 0.0, 0.0, -2.3841830625315197e-06, 0.0, -1.311301275563892e-06, -9.703165414975956e-05, -1.7762025890988298e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1324817933200393e-05, -1.3828182090946939e-05, -2.3841855067985307e-07, 0.0, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, 0.0, -5.721882189391181e-05, -4.768370445162873e-07, 0.0, 0.0, -3.5762781180