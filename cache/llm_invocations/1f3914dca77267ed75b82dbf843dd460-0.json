= m; ++j) A[i][0].a[j][j] = 1;\n        if (i == 0) {\n            for (int j = 0; j < m; ++j) {\n                A[i][j].a[m][m] = 1;\n                for (int k = 0; k < m; ++k) {\n                    if (k != j) {\n                        A[i][j].a[k][k] = 1;\n                        continue;\n                    }\n                    for (int l = 0; l <= m; ++l) A[i][j].a[k][l] = 1;\n                }\n            }\n        } else {\n            for (int j = 0; j < m; ++j) {\n                if (j == 0) A[i][j] = S[i-1][0];\n                else A[i][j] = S[i-1][j] * P[i-1][j-1];\n            }\n        }\n        P[i][0] = A[i][0];\n        for (int j = 1; j < m; ++j) P[i][j] = P[i][j-1] * A[i][j];\n        S[i][m-1] = A[i][m-1];\n        for (int j = m-2; j >= 0; --j) S[i][j] = A[i][j] * S[i][j+1];\n    }\n    int idx = 0;\n    for (int i = len-1; i >= 0; --i) {\n        while (bin[i]-- > 0) {\n            ans = ans * A[i][idx];\n            ++idx;\n            if (idx == m) idx = 0;\n        }\n    }\n    cout << ans.a[0][m] << endl;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass Mat:\n    def __init__(self, size, init_val=0):\n        self.size = size\n        self.a = [[init_val] * size for _ in range(size)]\n\n    def __mul__(self, other):\n        n = self.size\n        res = Mat(n)\n        for i in range(n):\n            for j in range(n):\n                s = 0\n                for k in range(n):\n                    s = (s + self.a[i][k] * other.a[k][j]) % MOD\n                res.a[i][j] = s\n        return res\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n\n    # compute digits of n in base m (least significant first)\n    bin_digits = []\n    tmp = n\n    while tmp:\n        bin_digits.append(tmp % m)