er scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        int k = scanner.nextInt();\n        scanner.close();\n\n        int p;\n        if (k == 0) {\n            p = n - 1;\n        } else if (k == 1) {\n            p = n;\n        } else {\n            int t = computeOrder(n, k);\n            p = (n - 1) / t;\n        }\n\n        long result = 1;\n        long base = n % MOD;\n        while (p > 0) {\n            if ((p & 1) == 1) {\n                result = (result * base) % MOD;\n            }\n            base = (base * base) % MOD;\n            p >>= 1;\n        }\n\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.676783570786938e-05, -2.861018856492592e-06, -1.1920928244535389e-07, -7.235741941258311e-05, -1.9550132492440753e-05, -0.0005395148764364421, -0.5893499851226807, -5.94836674281396e-05, -9.65590606938349e-06, -2.3841855067985307e-07, -3.58813522325363e-05, -0.0013275867095217109, -0.00033563701435923576, -0.05919218808412552, -1.680836794548668e-05, -0.12694820761680603, -3.3378546504536644e-06, 0.0, -0.12692931294441223, -1.1920928244535389e-07, -0.008614521473646164, 0.0, 0.0, -0.0002960720448754728, 0.0, 0.0, 0.0, 0.0, -6.794906312279636e-06, -0.03407919034361839, -2.622600959512056e-06, -0.2519654631614685, -0.47409048676490784, -5.602820692729438e-06, -0.0004522969538811594, -0.0009118927991949022, -1.1920928244535389e-07, 0.0, -5.149708886165172e-05, -1.1920928244535389e-07, -3.099436753473128e-06, -2.3841855067985307e-07, -1.7881377516459906e-06, -0.004640643019229174, -4.172316494077677e-06, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -8.344646857949556e-07, -7.152555099310121e-07, -1.7881377516459906e-06, 0.0, 0.0, -2.3841855067985307e-07, -7.152555099310121e-07, -2.3841855067985307e-07, -5.125986263010418e-06, -3.9934315282152966e-05, -0.008621140383183956, -1.78813775164599