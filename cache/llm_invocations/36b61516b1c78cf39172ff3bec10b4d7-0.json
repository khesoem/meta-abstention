eption e) {\n            in = new FastReader();\n            out = new PrintWriter(new BufferedWriter(new OutputStreamWriter(System.out)));\n        }\n\n        int n = in.nextInt();\n        int size = 2 * n;\n        int[][] dp = new int[size][n + 1];\n        dp[0][1] = 1;\n\n        for (int i = 1; i < size; i++) {\n            int[] prev = dp[i - 1];\n            int[] cur = dp[i];\n            for (int j = 0; j <= n; j++) {\n                int v = prev[j];\n                if (v != 0) {\n                    if (j + 1 <= n) {\n                        cur[j + 1] = (cur[j + 1] + v) % MOD;\n                    }\n                    if (j - 1 >= 0) {\n                        cur[j - 1] = (cur[j - 1] + v) % MOD;\n                    }\n                }\n            }\n        }\n\n        int ans = 0;\n        for (int i = size - 2; i >= 0; i -= 2) {\n            int limit = size - 1 - i;\n            for (int j = 0; j <= n; j++) {\n                if ((j & 1) == 1 && j <= limit) {\n                    ans = (ans + dp[i][j]) % MOD;\n                }\n            }\n        }\n\n        out.print(ans);\n        out.flush();\n        out.close();\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nclass FastReader {\n    istream* stream;\n    string buffer;\n    size_t pos;\npublic:\n    FastReader(const string& file) {\n        stream = new ifstream(file);\n        if (!((ifstream*)stream)->is_open()) {\n            delete stream;\n            stream = &cin;\n        }\n        pos = string::npos;\n    }\n    FastReader() {\n        stream = &cin;\n        pos = string::npos;\n    }\n    ~FastReader() {\n        if (stream != &cin) delete stream;\n    }\n    string next() {\n        if (pos == string::npos || pos >= buffer.size()) {\n            getline(*stre