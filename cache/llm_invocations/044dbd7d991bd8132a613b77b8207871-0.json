{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing lli = long long int;\nconst int MOD = 1000000007;\n\ninline void modadd(int& x, int y) {\n    x += y;\n    if (x >= MOD) x -= MOD;\n}\n\nint modpow(int b, int e) {\n    int r = 1;\n    while (e) {\n        if (e & 1) r = (lli)r * b % MOD;\n        b = (lli)b * b % MOD;\n        e >>= 1;\n    }\n    return r;\n}\n\nint N;\nvector<vector<int>> prob;\nvector<vector<int>> prod;\nvector<vector<int>> popcount_list;\nvector<int> pos_in_group;\nvector<vector<lli>> trans;\nunordered_map<lli, int> cache;\n\nint dp(int idx, lli mask) {\n    if (mask == 0) return 0;\n    if (idx == N) return 1;\n    \n    lli key = (lli)idx << 40 | mask;\n    if (cache.count(key)) return cache[key];\n    \n    int ans = 0;\n    for (int m = 1; m < (1 << N); ++m) {\n        lli new_mask = 0;\n        for (int k = 0; k < N; ++k) {\n            if (!(mask & (1LL << k))) continue;\n            int cur = popcount_list[k];\n            int rem = m & ~cur;\n            new_mask |= trans[cur][rem];\n        }\n        modadd(ans, (lli)prod[idx][m] * dp(idx + 1, new_mask) % MOD);\n    }\n    \n    return cache[key] = ans;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    cin >> N;\n    int inv100 = modpow(100, MOD - 2);\n    \n    prob.assign(N, vector<int>(N));\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            cin >> prob[i][j];\n            prob[i][j] = (lli)prob[i][j] * inv100 % MOD;\n        }\n    }\n    \n    prod.assign(N, vector<int>(1 << N, 1));\n    for (int i = 0; i < N; ++i) {\n        for (int mask = 0; mask < (1 << N); ++mask) {\n            for (int j = 0; j < N; ++j) {\n                if (mask & (1 << j)) {\n                    prod[i][mask] = (lli)prod[i][mask] * prob[i][j] % MOD;\n                } else {\n                    prod[i][mask] = (lli)prod[i][mask] * ((MOD + 1 - prob[i][j]) % MOD) % MOD;\n                }\n            }\n        }\n    }\n    \n    popcount_list.clear();\n    for (int i = 0; i < N; ++i) popcount_list.push_back(1 << i);\n    \n    pos_in_group.assign(1 << N, 0);\n    vector<vector<int>> by_popcount(N + 1);\n    for (int mask = 0; mask < (1 << N); ++mask) {\n        int cnt = __builtin_popcount(mask);\n        by_popcount[cnt].push_back(mask);\n        pos_in_group[mask] = by_popcount[cnt].size() - 1;\n    }\n    \n    trans.assign(1 << N, vector<lli>(1 << N, 0));\n    for (int mask = 0; mask < (1 << N); ++mask) {\n        for (int j = 0; j < N; ++j) {\n            if (!(mask & (1 << j))) {\n                int next_mask = mask | (1 << j);\n                int cnt = __builtin_popcount(mask);\n                int pos = pos_in_group[next_mask];\n                trans[mask][1 << j] = 1LL << pos;\n            }\n        }\n        for (int j = 1; j < (1 << N); ++j) {\n            int lb = j & -j;\n            trans[mask][j] = trans[mask][lb] | trans[mask][j ^ lb];\n        }\n    }\n    \n    cout << dp(0, 1) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom functools import lru_cache\n\nMOD = 1000000007\n\ndef modadd(x, y):\n    x += y\n    if x >= MOD:\n        x -= MOD\n    return x\n\ndef modpow(b, e):\n    r = 1\n    while e:\n        if e & 1:\n            r = (r * b) % MOD\n        b = (b * b) % MOD\n        e >>= 1\n    return r\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    N = int(data[idx])\n    idx += 1\n    \n    inv100 = modpow(100, MOD - 2)\n    \n    prob = []\n    for i in range(N):\n        row = []\n        for j in range(N):\n            p = int(data[idx])\n            idx += 1\n            p = (p * inv100) % MOD\n            row.append(p)\n        prob.append(row)\n    \n    prod = [[1] * (1 << N) for _ in range(N)]\n    for i in range(N):\n        for mask in range(1 << N):\n            for j in range(N):\n                if mask & (1 << j):\n                    prod[i][mask] = (prod[i][mask] * prob[i][j]) % MOD\n                else:\n                    prod[i][mask] = (prod[i][mask] * ((MOD + 1 - prob[i][j]) % MOD)) % MOD\n    \n    popcount_list = [1 << i for i in range(N)]\n    \n    pos_in_group = [0] * (1 << N)\n    by_popcount = [[] for _ in range(N + 1)]\n    for mask in range(1 << N):\n        cnt = bin(mask).count('1')\n        by_popcount[cnt].append(mask)\n        pos_in_group[mask] = len(by_popcount[cnt]) - 1\n    \n    trans = [[0] * (1 << N) for _ in range(1 << N)]\n    for mask in range(1 << N):\n        for j in range(N):\n            if not (mask & (1 << j)):\n                next_mask = mask | (1 << j)\n                cnt = bin(mask).count('1')\n                pos = pos_in_group[next_mask]\n                trans[mask][1 << j] = 1 << pos\n        for j in range(1, 1 << N):\n            lb = j & -j\n            trans[mask][j] = trans[mask][lb] | trans[mask][j ^ lb]\n    \n    # Use memoization for dp\n    cache = {}\n    \n    def dp(idx, mask):\n        if mask == 0:\n            return 0\n        if idx == N:\n            return 1\n        \n        key = (idx << 40) | mask\n        if key in cache:\n            return cache[key]\n        \n        ans = 0\n        for m in range(1, 1 << N):\n            new_mask = 0\n            for k in range(N):\n                if not (mask & (1 << k)):\n                    continue\n                cur = popcount_list[k]\n                rem = m & ~cur\n                new_mask |= trans[cur][rem]\n            ans = modadd(ans, (prod[idx][m] * dp(idx + 1, new_mask)) % MOD)\n        \n        cache[key] = ans\n        return ans\n    \n    print(dp(0, 1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00018010901112575084, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.002285965019837022, -0.00013684290752280504, -0.00020740265608765185, -0.16591760516166687, -0.5258607864379883, -6.556489552167477e-06, -0.0001230164198204875, -3.313963316031732e-05, -5.149708886165172e-05, -1.2397689715726301e-05, -0.016395019367337227, 0.0, -5.960462772236497e-07, 0.0, -3.576278118089249e-07, -0.000380324519937858, -1.1920928244535389e-07, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, -3.4570634852570947e-06, -1.1920928244535389e-07, -5.960446742392378e-06, -1.4543427823809907e-05, -0.00020561488054227084, -8.320462075062096e-05, -0.09231975674629211, -1.0013530300057027e-05, -4.768370445162873e-07, 0.0, -3.814689989667386e-06, -3.576278118089249e-07, -0.012520048767328262, -0.2263363152742386, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -2.7656173188006505e-05, -1.1920928244535389e-07, 0.0, -1.5497195136049413e-06, -4.768370445162873e-07, -1.4305104514278355e-06, -3.814689989667386e-06, -9.059865078597795e-06, -4.935142715112306e-05, -1.5497195136049413e-06, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.9788545614574105e-05, -3.099436753473128e-06, -5.00677742820698