f __init__(self):\n        self.adj = []          # list of lists of [to, rev, cap, cost]\n        self.potential = []    # will be resized dynamically\n        self.nodes = 0\n\n    def addNodes(self, cnt):\n        for _ in range(cnt):\n            self.adj.append([])\n            self.nodes += 1\n        return self.nodes - 1\n\n    def addEdge(self, u, v, cap, cost):\n        self.adj[u].append([v, len(self.adj[v]), cap, cost])\n        self.adj[v].append([u, len(self.adj[u]) - 1, 0, -cost])\n\n    def dijkstra(self, s, t):\n        dist = [INF] * self.nodes\n        done = [False] * self.nodes\n        dist[s] = 0\n        pq = [(0, s)]\n\n        while pq:\n            du, u = heapq.heappop(pq)\n            if done[u]:\n                continue\n            done[u] = True\n\n            for e in self.adj[u]:\n                if e[2] == 0:\n                    continue\n                v = e[0]\n                if done[v]:\n                    continue\n                nd = du + self.potential[u] + e[3] - self.potential[v]\n                if dist[v] > nd:\n                    dist[v] = nd\n                    heapq.heappush(pq, (nd, v))\n\n        self.dist_arr = dist          # store for later use\n        return done[t]\n\n    def buildLevelGraph(self, s, t):\n        level = [0] * self.nodes\n        q = deque()\n        q.append(s)\n        level[s] = 1\n\n        while q:\n            u = q.popleft()\n            for e in self.adj[u]:\n                v = e[0]\n                if e[2] == 0 or level[v]:\n                    continue\n                if self.dist_arr[v] == self.dist_arr[u] + e[3] - self.potential[v] + self.potential[u]:\n                    level[v] = level[u] + 1\n                    q.append(v)\n\n        self.level_arr = level\n        return level[t] != 0\n\n    def dfs(self, u, t, f):\n        if u == t:\n            return f\n        sent = 0\n        i = self.iter_arr[u]\n        while i < len(self.adj[u]):\n            e = self.adj[