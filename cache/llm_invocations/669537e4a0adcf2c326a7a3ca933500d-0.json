{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <deque>\n#include <algorithm>\n#include <chrono>\n#include <random>\n#include <cstring>\nusing namespace std;\n\nusing i64 = long long;\nusing pii = pair<int, int>;\nusing grid = vector<string>;\n\nconstexpr i64 INF = (i64)1e18;\nconstexpr int MAXN = 1000;\n\nconst int dx[4] = {0, 0, -1, 1};\nconst int dy[4] = {-1, 1, 0, 0};\n\nvector<int> g[MAXN];\nbool vis[MAXN];\nint mt[MAXN];\n\nbool ok(int x, int y, const grid& a) {\n    return x >= 0 && y >= 0 && x < (int)a.size() && y < (int)a.size() && a[x][y] != 'Y' && a[x][y] != 'Z';\n}\n\nvector<vector<i64>> calc_dist(int sx, int sy, const grid& a) {\n    int n = a.size();\n    vector<vector<i64>> dist(n, vector<i64>(n, INF));\n    deque<pii> q;\n    dist[sx][sy] = 0;\n    q.push_back({sx, sy});\n    while (!q.empty()) {\n        auto [x, y] = q.front();\n        q.pop_front();\n        for (int k = 0; k < 4; ++k) {\n            int nx = x + dx[k], ny = y + dy[k];\n            if (!ok(nx, ny, a) || dist[nx][ny] != INF) continue;\n            dist[nx][ny] = dist[x][y] + 1;\n            q.push_back({nx, ny});\n        }\n    }\n    return dist;\n}\n\nvoid read_and_build() {\n    int N, T;\n    cin >> N >> T;\n    grid A(N), B(N);\n    for (int i = 0; i < N; ++i) cin >> A[i];\n    for (int i = 0; i < N; ++i) cin >> B[i];\n\n    int rx = -1, ry = -1;\n    for (int i = 0; i < N; ++i)\n        for (int j = 0; j < N; ++j)\n            if (A[i][j] == 'Z') rx = i, ry = j;\n\n    auto D = calc_dist(rx, ry, A);\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (!ok(i, j, A)) continue;\n            auto D2 = calc_dist(i, j, A);\n            for (int x = 0; x < N; ++x) {\n                for (int y = 0; y < N; ++y) {\n                    if (!ok(x, y, A) ||\n                        D2[x][y] > T ||\n                        D2[x][y] > D[x][y])\n                        continue;\n\n                    if (D2[x][y] == D[x][y]) {\n                        bool ok_flag = false;\n                        for (int k = 0; k < 4; ++k) {\n                            int nx = x + dx[k], ny = y + dy[k];\n                            if (ok(nx, ny, A) && D2[nx][ny] < D[nx][ny]) ok_flag = true;\n                        }\n                        if (!ok_flag) continue;\n                    }\n\n                    int c1 = A[i][j] - '0';\n                    int c2 = B[x][y] - '0';\n                    for (int u = 1; u <= c1; ++u) {\n                        for (int v = 1; v <= c2; ++v) {\n                            int src = i * 100 + j * 10 + u;\n                            int dst = x * 100 + y * 10 + v;\n                            g[src].push_back(dst);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\nbool dfs(int u) {\n    if (vis[u]) return false;\n    vis[u] = true;\n    for (int v : g[u]) {\n        if (!mt[v] || dfs(mt[v])) {\n            mt[v] = u;\n            return true;\n        }\n    }\n    return false;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    read_and_build();\n    int cnt = 0;\n    for (int i = 0; i < MAXN; ++i) {\n        fill(vis, vis + MAXN, false);\n        cnt += dfs(i);\n    }\n    cout << cnt << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long INF = (long) 1e18;\n    static final int MAXN = 1000;\n    static final int[] dx = {0, 0, -1, 1};\n    static final int[] dy = {-1, 1, 0, 0};\n\n    static List<List<Integer>> g = new ArrayList<>(MAXN);\n    static boolean[] vis = new boolean[MAXN];\n    static int[] mt = new int[MAXN];\n\n    static boolean ok(int x, int y, List<String> a) {\n        return x >= 0 && y >= 0 && x < a.size() && y < a.size() &&\n               a.get(x).charAt(y) != 'Y' && a.get(x).charAt(y) != 'Z';\n    }\n\n    static List<List<Long>> calcDist(int sx, int sy, List<String> a) {\n        int n = a.size();\n        List<List<Long>> dist = new ArrayList<>();\n        for (int i = 0; i < n; i++) {\n            List<Long> row = new ArrayList<>();\n            for (int j = 0; j < n; j++) {\n                row.add(INF);\n            }\n            dist.add(row);\n        }\n\n        Deque<int[]> q = new ArrayDeque<>();\n        dist.get(sx).set(sy, 0L);\n        q.add(new int[]{sx, sy});\n\n        while (!q.isEmpty()) {\n            int[] cell = q.pollFirst();\n            int x = cell[0];\n            int y = cell[1];\n\n            for (int k = 0; k < 4; k++) {\n                int nx = x + dx[k];\n                int ny = y + dy[k];\n                if (!ok(nx, ny, a) || !dist.get(nx).get(ny).equals(INF)) continue;\n                dist.get(nx).set(ny, dist.get(x).get(y) + 1);\n                q.add(new int[]{nx, ny});\n            }\n        }\n\n        return dist;\n    }\n\n    static void readAndBuild(Scanner scanner) {\n        int N = scanner.nextInt();\n        int T = scanner.nextInt();\n        List<String> A = new ArrayList<>();\n        List<String> B = new ArrayList<>();\n\n        for (int i = 0; i < N; i++) {\n            A.add(scanner.next());\n        }\n        for (int i = 0; i < N; i++) {\n            B.add(scanner.next());\n        }\n\n        int rx = -1, ry = -1;\n        for (int i = 0; i < N; i++) {\n            for (int j = 0; j < N; j++) {\n                if (A.get(i).charAt(j) == 'Z') {\n                    rx = i;\n                    ry = j;\n                }\n            }\n        }\n\n        List<List<Long>> D = calcDist(rx, ry, A);\n\n        for (int i = 0; i < N; i++) {\n            for (int j = 0; j < N; j++) {\n                if (!ok(i, j, A)) continue;\n                List<List<Long>> D2 = calcDist(i, j, A);\n                for (int x = 0; x < N; x++) {\n                    for (int y = 0; y < N; y++) {\n                        if (!ok(x, y, A) ||\n                            D2.get(x).get(y) > T ||\n                            D2.get(x).get(y) > D.get(x).get(y)) {\n                            continue;\n                        }\n\n                        if (D2.get(x).get(y).equals(D.get(x).get(y))) {\n                            boolean okFlag = false;\n                            for (int k = 0; k < 4; k++) {\n                                int nx = x + dx[k];\n                                int ny = y + dy[k];\n                                if (ok(nx, ny, A) && D2.get(nx).get(ny) < D.get(nx).get(ny)) {\n                                    okFlag = true;\n                                }\n                            }\n                            if (!okFlag) continue;\n                        }\n\n                        int c1 = A.get(i).charAt(j) - '0';\n                        int c2 = B.get(x).charAt(y) - '0';\n                        for (int u = 1; u <= c1; u++) {\n                            for (int v = 1; v <= c2; v++) {\n                                int src = i * 100 + j * 10 + u;\n                                int dst = x * 100 + y * 10 + v;\n                                g.get(src).add(dst);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    static boolean dfs(int u) {\n        if (vis[u]) return false;\n        vis[u] = true;\n        for (int v : g.get(u)) {\n            if (mt[v] == 0 || dfs(mt[v])) {\n                mt[v] = u;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        for (int i = 0; i < MAXN; i++) {\n            g.add(new ArrayList<>());\n        }\n        \n        readAndBuild(scanner);\n        int cnt = 0;\n        for (int i = 0; i < MAXN; i++) {\n            Arrays.fill(vis, false);\n            cnt += dfs(i) ? 1 : 0;\n        }\n        System.out.println(cnt);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013839241000823677, -2.0265558760002023e-06, -7.152555099310121e-07, -0.0002315968304174021, -3.814624506048858e-05, -0.1269327700138092, -0.5759726762771606, -9.059865078597795e-06, -4.768370445162873e-07, -9.679325739853084e-05, -0.038044512271881104, -4.0411134250462055e-05, -0.009427552111446857, -0.2437746673822403, -0.0010705222375690937, -8.106198947643861e-06, -1.1920928244535389e-07, -0.002186766592785716, -8.821448318485636e-06, -8.344646857949556e-07, -0.1426762193441391, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -5.960446742392378e-06, -2.038458114839159e-05, -1.7881377516459906e-06, -4.31528314948082e-05, -9.536738616588991e-07, -2.622600959512056e-06, -5.245195097813848e-06, -2.3841855067985307e-07, 0.0, -1.1920922133867862e-06, -4.529942543740617e-06, -1.311301275563892e-06, -4.887569048150908e-06, -0.2813052535057068, -0.5759578347206116, -3.361645576660521e-05, -0.030165746