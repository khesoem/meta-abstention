  in_queue[u] = 0;\n                \n                for (int i = 0; i < graph.get(u).size(); ++i) {\n                    Edge e = graph.get(u).get(i);\n                    if (e.flow < e.cap && dist[u] + e.cost < dist[(int)e.to]) {\n                        dist[(int)e.to] = dist[u] + e.cost;\n                        parent[(int)e.to] = u;\n                        parent_edge_idx[(int)e.to] = i;\n                        if (in_queue[(int)e.to] == 0) {\n                            q.offer((int)e.to);\n                            in_queue[(int)e.to] = 1;\n                        }\n                    }\n                }\n            }\n            \n            if (dist[(int)t] == INF) break;\n            \n            long flow_add = k_in - total_flow;\n            for (long v = t; v != s; v = parent[v]) {\n                long u = parent[v];\n                int idx = parent_edge_idx[(int)v];\n                flow_add = Math.min(flow_add, graph.get((int)u).get(idx).cap - graph.get((int)u).get(idx).flow);\n            }\n            \n            for (long v = t; v != s; v = parent[v]) {\n                long u = parent[v];\n                int idx = parent_edge_idx[(int)v];\n                long rev_idx = graph.get((int)u).get(idx).rev;\n                graph.get((int)u).get(idx).flow += flow_add;\n                graph.get((int)v).get((int)rev_idx).flow -= flow_add;\n                total_cost += graph.get((int)u).get(idx).cost * flow_add;\n            }\n            \n            total_flow += flow_add;\n        }\n        \n        System.out.println(total_cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001311216183239594, -2.50339189733495e-06, -3.576278118089249e-07, -0.002146561164408922, -5.900685573578812e-05, -0.10022717714309692, -0.1270393431186676, -2.372236667724792e-05, -5.960462772236497e-07, -6.592056161025539e-05, -0.016034582629799843, -0.00020418466010596603, -0.0009521479951217771, -0.1549870371