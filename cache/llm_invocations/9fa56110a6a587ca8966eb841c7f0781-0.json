][n] = k\n                    n1 += k\n    # Copy ok to okb\n    for i in range(12):\n        for j in range(12):\n            okb[i][j] = ok[i][j]\n    # Second m lines\n    for i in range(1, m+1):\n        line = input_data[m + i].strip()\n        for j in range(1, m+1):\n            ch = line[j-1]\n            if ch == 'Z' or ch == 'Y':\n                continue\n            k = ord(ch) - ord('0')\n            if k > 0:\n                n += 1\n                b[i][j] = n\n                capacity[n][m*m + 1] = k\n    # Adjust sink if n != m*m\n    if n != m*m:\n        for i in range(1, m+1):\n            for j in range(1, m+1):\n                if b[i][j] > 0:\n                    k = b[i][j]\n                    capacity[k][n+1] = capacity[k][m*m+1]\n                    capacity[k][m*m+1] = 0\n    sinkNode = n + 1\n    # BFS from 'Z' to compute d0\n    while q:\n        r, c, dis = q.popleft()\n        d0[r][c] = dis\n        for dx, dy in [(-1,0),(0,-1),(1,0),(0,1)]:\n            nr, nc = r+dx, c+dy\n            if 1 <= nr <= m and 1 <= nc <= m and ok[nr][nc]:\n                q.append((nr, nc, dis+1))\n                ok[nr][nc] = False\n    # For each source cell, BFS to connect to sink cells\n    for i in range(1, m+1):\n        for j in range(1, m+1):\n            if a[i][j] == 0:\n                continue\n            # Reset ok to okb\n            for x in range(12):\n                for y in range(12):\n                    ok[x][y] = okb[x][y]\n            ok[i][j] = False\n            qq = deque()\n            qq.append((i, j, 0))\n            while qq:\n                x, y, dis = qq.popleft()\n                if b[x][y] > 0 and dis <= d0[x][y]:\n                    capacity[a[i][j]][b[x][y]] = n1\n                if dis + 1 > lim or dis >= d0[x][y]:\n                    continue\n                for dx, dy in [(-1,0),(0,-1),(1,0),(0,1)]:\n                    nx, ny = x+dx, y+dy\n                    if 1 <= nx <= m and 1 <= ny <= m and ok[nx][ny]:\n 