eses) {\n\t\t\tif (!word.isEmpty() && word.length() > maxWordWithoutParanthesesLength) {\n\t\t\t\tmaxWordWithoutParanthesesLength = word.length();\n\t\t\t}\n\t\t}\n\t\t\n\t\tSystem.out.println(maxWordWithoutParanthesesLength + \" \" + numberOfWordsInParantheses);\n\t\t\n\t\t// Close scanner\n\t\tread.close();\n\t}\n}\n</original_code>\n\n<translated_code>\nimport re\n\ndef read_input():\n    return input()\n\ndef main():\n    n = int(input())\n    input()  # Consume newline left-over\n    line = read_input()\n    \n    line_without_parantheses = ''\n    number_of_words_in_parantheses = 0\n    i = 0\n    while i < len(line):\n        if line[i] == '(':\n            line_without_parantheses += '_'\n            i += 1\n            parantheses_words = ''\n            while line[i] != ')':\n                parantheses_words += line[i]\n                i += 1\n            words_in_parantheses = re.split('_+', parantheses_words)\n            for word in words_in_parantheses:\n                if word:\n                    number_of_words_in_parantheses += 1\n        else:\n            line_without_parantheses += line[i]\n        i += 1\n    \n    max_word_without_parantheses_length = 0\n    words_without_parantheses = re.split('_+', line_without_parantheses)\n    \n    for word in words_without_parantheses:\n        if word and len(word) > max_word_without_parantheses_length:\n            max_word_without_parantheses_length = len(word)\n    \n    print(max_word_without_parantheses_length, number_of_words_in_parantheses)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.05705263093113899, -0.5636676549911499, -0.0015248350100591779, -9.059865078597795e-06, -1.1920922133867862e-06, -3.099436753473128e-06, -2.3841855067985307e-07, -2.4676019165781327e-05, 0.0, -6.139089964563027e-05, -1.1920928244535389e-07, -5.960462772236497e-07, -0.00018344627460464835, -0.007172549609094858, -0.0014419882791116834, 