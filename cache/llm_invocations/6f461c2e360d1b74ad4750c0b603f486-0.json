    private static long[] bitReverseArray(long[] arr, int k) {\n        long[] res = new long[arr.length];\n        for (int i = 0; i < arr.length; i++) {\n            res[bitReverse(i, k)] = arr[i];\n        }\n        return res;\n    }\n\n    private static long[] performNTT(long[] coef, int k, boolean inverse) {\n        coef = bitReverseArray(coef, k);\n        long[] roots = computeRoots(k, inverse);\n        for (int s = 0; s < k; s++) {\n            int len = 1 << s;\n            for (int st = 0; st < coef.length; st += 2 * len) {\n                long curRoot = 1;\n                for (int j = st; j < st + len; j++) {\n                    long t = (curRoot * coef[j + len]) % MOD;\n                    long u = coef[j];\n                    coef[j] = (u + t) % MOD;\n                    long diff = (u - t) % MOD;\n                    if (diff < 0) diff += MOD;\n                    coef[j + len] = diff;\n                    curRoot = (roots[s] * curRoot) % MOD;\n                }\n            }\n        }\n        return coef;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt() / 2;\n        int m = sc.nextInt();\n        int[] nums = new int[m];\n        int maxVal = 0;\n        for (int i = 0; i < m; i++) {\n            nums[i] = sc.nextInt();\n            if (nums[i] > maxVal) maxVal = nums[i];\n        }\n        int requiredSize = n * maxVal + 1;\n        int k = 0, size = 1;\n        while (size < requiredSize) {\n            size <<= 1;\n            k++;\n        }\n        long[] poly = new long[size];\n        for (int num : nums) poly[num] = 1;\n        poly = performNTT(poly, k, false);\n        for (int i = 0; i < size; i++) poly[i] = modPow(poly[i], n);\n        poly = performNTT(poly, k, true);\n        long result = 0;\n        for (int i = 0; i < size; i++) {\n            result = (result + poly[i] * poly[i]) % MOD;\n        }\n        long invSize = modInverse(size);\n        System.out.println((result * invSize % MOD) * invSize % MOD);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\nTWO_POW = 23\nROOT = 15311432\n\ndef bit_reverse(n, k):\n    return int(bin(n)[2:].zfill(k)[::-1], 2)\n\ndef mod_pow(base, exp):\n    res = 1\n    base %= MOD\n    while exp > 0:\n        if (exp & 1) == 1:\n            res = (res * base) % MOD\n        base = (base * base) % MOD\n        exp >>= 1\n    return res\n\ndef mod_inverse(a):\n    return mod_pow(a, MOD - 2)\n\ndef compute_roots(k, inverse):\n    root = mod_pow(ROOT, mod_pow(2, TWO_POW - k))\n    if inverse:\n        root = mod_inverse(root)\n    rts = [0] * k\n    if k > 0:\n        rts[k - 1] = root\n        for i in range(k - 1, 0, -1):\n            rts[i - 1] = (rts[i] * rts[i]) % MOD\n    return rts\n\ndef bit_reverse_array(arr, k):\n    n = len(arr)\n    res = [0] * n\n    for i in range(n):\n        res[bit_reverse(i, k)] = arr[i]\n    return res\n\ndef perform_ntt(coef, k, inverse):\n    coef = bit_reverse_array(coef, k)\n    roots = compute_roots(k, inverse)\n    coef = list(coef)  # Convert to list for mutability\n    for s in range(k):\n        length = 1 << s\n        for st in range(0, len(coef), 2 * length):\n            cur_root = 1\n            for j in range(st, st + length):\n                t = (cur_root * coef[j + length]) % MOD\n                u = coef[j]\n                coef[j] = (u + t) % MOD\n                diff = (u - t) % MOD\n                if diff < 0:\n                    diff += MOD\n                coef[j + length] = diff\n                cur_root = (roots[s] * cur_root) % MOD\n    return coef\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0]) // 2\n    m = int(data[1])\n    nums = []\n    max_val = 0\n    for i in range(m):\n        num = int(data[2 + i])\n        nums.append(num)\n        if num > max_val:\n            max_val = num\n    \n    required_size = n * max_val + 1\n    k = 0\n    size = 1\n    while size < required_size:\n        size <<= 1\n        k += 1\n    \n    poly = [0] * size\n    for num in nums:\n        poly[num] = 1\n    \n    poly = perform_ntt(poly, k, False)\n    for i in range(size):\n        poly[i] = mod_pow(poly[i], n)\n    \n    poly = perform_ntt(poly, k, True)\n    \n    result = 0\n    for i in range(size):\n        result = (result + poly[i] * poly[i]) % MOD\n    \n    inv_size = mod_inverse(size)\n    final_result = (result * inv_size) % MOD\n    final_result = (final_result * inv_size) % MOD\n    print(final_result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.709961988031864e-05, -7.152555099310121e-07, -5.960462772236497e-07, -0.0063432310707867146, -0.31388726830482483, -0.04860970005393028, -0.048649102449417114, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.6689286894688848e-06, -1.0728830375228426e-06, -5.960462772236497e-07, -2.13382354559144e-05, -7.176141662057489e-05, -4.470248313737102e-05, -1.5497195136049413e-06, -3.6954811548639555e-06, -1.1801649634435307e-05, -1.1920928244535389e-07, -2.7418097943154862e-06, -4.768370445162873e-07, -2.3841855067985307e-07, -2.264974000354414e-06, -8.702239938429557e-06, -9.536738616588991e-07, 0.0, -7.510157047363464e-06, -3.933898824470816e-06, -8.344646857949556e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -2.50339189733495e-06, -3.576272320060525e-06, -2.9444261599564925e-05, -1.8715683836489916e-05, -1.3589766240329482e-05, -1.7881377516459906e-06, -0.0003849719068966806, -5.364403477869928e-06, -0.0015613758005201817, -0.07906467467546463, -4.0531076592742465e-06, -5.900685573578812e-05, -5.960462772236497e-07, -2.7418097943154862e-06, -3.099436753473128e-06, -0.2993425130844116, -0.011043262667953968, -0.06596839427947998, -1.811964830267243e-05, -0.0028664474375