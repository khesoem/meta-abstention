{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\nusing namespace std;\n\nconst int MAXN = 2000005;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int c, int cst, int r) : to(t), cap(c), cost(cst), rev(r) {}\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(0);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int S = 0, T = 1;\n    int total_nodes = 2 + (n + k + 1) * (n + 1);\n    vector<vector<Edge>> graph(total_nodes);\n    \n    auto add_edge = [&](int from, int to, int cap, int cost) {\n        graph[from].emplace_back(to, cap, cost, graph[to].size());\n        graph[to].emplace_back(from, 0, -cost, graph[from].size() - 1);\n    };\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        add_edge(S, x + 1, 1, 0);\n    }\n    \n    vector<pair<int, int>> edges(m);\n    for (int i = 0; i < m; ++i) {\n        cin >> edges[i].first >> edges[i].second;\n    }\n    \n    for (int layer = 0; layer <= n + k; ++layer) {\n        add_edge(2 + layer * (n + 1), T, k, 0);\n        if (layer == n + k) break;\n        \n        for (int i = 0; i < m; ++i) {\n            int u = edges[i].first, v = edges[i].second;\n            for (int l = k; l >= 0; --l) {\n                int w = (l * 2 + 1) * d + c;\n                add_edge(u + 1 + layer * (n + 1), v + 1 + layer * (n + 1) + n, 1, w);\n                add_edge(v + 1 + layer * (n + 1), u + 1 + layer * (n + 1) + n, 1, w);\n            }\n        }\n        \n        for (int i = 1; i <= n; ++i) {\n            add_edge(i + 1 + layer * (n + 1), i + 1 + layer * (n + 1) + n, k, c);\n        }\n    }\n    \n    int total_cost = 0;\n    while (true) {\n        vector<int> dist(total_nodes, 1e9);\n        vector<int> prev_node(total_nodes, -1);\n        vector<int> prev_edge(total_nodes, -1);\n        queue<int> q;\n        vector<bool> in_queue(total_nodes, false);\n        \n        dist[S] = 0;\n        q.push(S);\n        in_queue[S] = true;\n        \n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            in_queue[u] = false;\n            \n            for (int i = 0; i < graph[u].size(); ++i) {\n                Edge& e = graph[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prev_node[e.to] = u;\n                    prev_edge[e.to] = i;\n                    if (!in_queue[e.to]) {\n                        in_queue[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n        \n        if (dist[T] >= 1e9) break;\n        \n        int flow = 1e9;\n        for (int v = T; v != S; v = prev_node[v]) {\n            flow = min(flow, graph[prev_node[v]][prev_edge[v]].cap);\n        }\n        \n        total_cost += flow * dist[T];\n        \n        for (int v = T; v != S; v = prev_node[v]) {\n            int u = prev_node[v];\n            int idx = prev_edge[v];\n            graph[u][idx].cap -=