 IOException {\n            int[] arr = new int[n];\n            for (int i = 0; i < n; i++) arr[i] = nextInt();\n            return arr;\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        FastInput in = new FastInput();\n        int n = in.nextInt();\n        int budget = in.nextInt();\n        int[] arr = in.nextIntArray(n);\n\n        int[] odd = new int[n + 1];\n        int[] even = new int[n + 1];\n\n        for (int i = 1; i <= n; i++) {\n            odd[i] = odd[i - 1] + (arr[i - 1] & 1);\n            even[i] = even[i - 1] + ((arr[i - 1] & 1) ^ 1);\n        }\n\n        int last = 0;\n        PriorityQueue<Integer> costs = new PriorityQueue<>();\n        for (int i = 1; i < n; i++) {\n            int o = odd[i] - odd[last];\n            int e = even[i] - even[last];\n            if (o == e) {\n                costs.add(Math.abs(arr[i] - arr[i - 1]));\n                last = i;\n            }\n        }\n\n        int total = 0;\n        int k = 0;\n        while (!costs.isEmpty() && total <= budget) {\n            total += costs.poll();\n            k++;\n        }\n\n        if (k == 0) {\n            System.out.println(0);\n        } else {\n            System.out.println(costs.isEmpty() && total <= budget ? k : k - 1);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nclass FastInput {\nprivate:\n    static const int BUFFER_SIZE = 1 << 16;\n    unsigned char buffer[BUFFER_SIZE];\n    int ptr, len;\n    FILE* file;\n\npublic:\n    FastInput() : ptr(0), len(0), file(stdin) {}\n\n    int fillBuffer() {\n        ptr = 0;\n        len = fread(buffer, 1, BUFFER_SIZE, file);\n        return len;\n    }\n\n    int read() {\n        if (ptr >= len) {\n            fillBuffer();\n        }\n        return buffer[ptr++];\n    }\n\n    int skip() {\n        int c;\n        while ((c = read()) <= 32 && c != EOF) {}\n        return c;\n    }\n\n    int nextInt() {\n        int c = skip();\n        int sign = 1;\n        if (c == '-') {\n            sign = -1;\n            c = read();\n        }\n        int val = 0;\n        do {\n            val = val * 10 + c - '0';\n            c = read();\n        } while (c > ' ');\n        return val * sign;\n    }\n\n    vector<int> nextIntArray(int n) {\n        vector<int> arr(n);\n        for (int i = 0; i < n; i++) {\n            arr[i] = nextInt();\n        }\n        return arr;\n    }\n};\n\nint main() {\n    FastInput in;\n    int n = in.nextInt();\n    int budget = in.nextInt();\n    vector<int> arr = in.nextIntArray(n);\n\n    vector<int> odd(n + 1, 0);\n    vector<int> even(n + 1, 0);\n\n    for (int i = 1; i <= n; i++) {\n        odd[i] = odd[i - 1] + (arr[i - 1] & 1);\n        even[i] = even[i - 1] + ((arr[i - 1] & 1) ^ 1);\n    }\n\n    int last = 0;\n    priority_queue<int, vector<int>, greater<int>> costs;\n    for (int i = 1; i < n; i++) {\n        int o = odd[i] - odd[last];\n        int e = even[i] - even[last];\n        if (o == e) {\n            costs.push(abs(arr[i] - arr[i - 1]));\n            last = i;\n        }\n    }\n\n    int total = 0;\n    int k = 0;\n    while (!costs.empty() && total <= budget) {\n        total += costs.top();\n        costs.pop();\n        k++;\n    }\n\n    if (k == 0) {\n        cout << 0 << endl;\n    } else {\n        if (costs.empty() && total <= budget) {\n            cout << k << endl;\n        } else {\n            cout << k - 1 << endl;\n        }\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002517383254598826, -6.079655122448457e-06, -9.536738616588991e-07, -0.004114496521651745, -2.622600959512056e-06, -1.6927575416048057e-05, -1.1920922133867862e-06, -3.576272320060525e-06,