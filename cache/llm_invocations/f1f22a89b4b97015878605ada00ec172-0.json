> q;\n    vis[0] = true;\n    q.push(0);\n    while (!q.empty()) {\n        int v = q.front(); q.pop();\n        if (v == 2 * n * n + 1) return true;\n        for (int u = 0; u <= 2 * n * n + 1; ++u) {\n            if (cap[v][u] > 0 && !vis[u]) {\n                vis[u] = true;\n                parent[u] = v;\n                q.push(u);\n            }\n        }\n    }\n    return false;\n}\n\nvoid solve() {\n    scanf(\"%d%d\", &n, &t);\n    for (int i = 0; i < n; ++i) scanf(\" %s\", a[i]);\n    for (int i = 0; i < n; ++i) scanf(\" %s\", b[i]);\n    scanf(\"%d%d\", &sx, &sy);\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (a[i][j] == 'Z') { sx = i; sy = j; }\n    computeDist();\n\n    // Use queue for DP propagation\n    queue<tuple<int,int,int,int,int>> q; // (yt, sx, sy, x, y)\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (isdigit(a[i][j]))\n                q.emplace(0, i, j, i, j);\n\n    while (!q.empty()) {\n        auto [yt, s1, s2, x, y] = q.front(); q.pop();\n        if (reachable[s1][s2][x][y]) continue; // already processed at this or earlier yt? Actually we need to allow multiple yt? We'll use a visited array per yt? Simpler: we store in reachable and also process all yt up to t. But we need to ensure we don't miss states with larger yt. We'll use a 5D visited? Instead, we'll use a queue that processes each state once per yt, but we can just use the DP array as before but with queue. Let's do a queue for each yt: we'll store states in a vector per yt.\n    }\n\n    // Actually easier: use DP array but populate via queue for each time step.\n    bool dp[72][N][N][N][N] = {};\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (isdigit(a[i][j]))\n                dp[0][i][j][i][j] = true;\n\n    for (int yt = 0; yt < t; ++yt) {\n        // Collect all states at time yt into a queue\n        queue<tuple<int,int,int,int>> cur;\n        for (int s1 