(n):\n            if a[i][j].isdigit():\n                dp[0][i][j][i][j] = True\n    \n    # propagate\n    for yt in range(t):\n        cur = deque()\n        for s1 in range(n):\n            for s2 in range(n):\n                for x in range(n):\n                    for y in range(n):\n                        if dp[yt][s1][s2][x][y]:\n                            cur.append((s1, s2, x, y))\n        while cur:\n            s1, s2, x, y = cur.popleft()\n            if dist[x][y] <= yt:\n                continue\n            for k in range(4):\n                nx, ny = x + dx[k], y + dy[k]\n                if 0 <= nx < n and 0 <= ny < n and a[nx][ny].isdigit() and dist[nx][ny] >= yt + 1:\n                    if not dp[yt+1][s1][s2][nx][ny]:\n                        dp[yt+1][s1][s2][nx][ny] = True\n    \n    # reachable[s1][s2][x][y] = True if robot can go from (s1,s2) to (x,y) within time t\n    reachable = [[[[False]*n for _ in range(n)] for _ in range(n)] for _ in range(n)]\n    for yt in range(t + 1):\n        for s1 in range(n):\n            for s2 in range(n):\n                for x in range(n):\n                    for y in range(n):\n                        if dp[yt][s1][s2][x][y]:\n                            reachable[s1][s2][x][y] = True\n    \n    # build flow network\n    total_nodes = 2 * n * n + 2\n    cap = [[0]*total_nodes for _ in range(total_nodes)]\n    # source to a cells\n    for x in range(n):\n        for y in range(n):\n            if a[x][y].isdigit():\n                cap[0][x * n + y + 1] = int(a[x][y])\n            if b[x][y].isdigit():\n                cap[n * n + x * n + y + 1][total_nodes - 1] = int(b[x][y])\n    \n    # edges from a cells to b cells if reachable\n    for x1 in range(n):\n        for y1 in range(n):\n            if a[x1][y1].isdigit():\n                for x2 in range(n):\n                    for y2 in range(n):\n                        if a[x2][y2].isdigit() and reachable[x1][y1][x2][y2]:\n                           