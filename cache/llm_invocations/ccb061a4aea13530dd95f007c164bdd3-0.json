{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <cstring>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\n\nusing ll = long long;\nusing PII = pair<int, int>;\n\nconst int INF = 0x3f3f3f3f;\nconst int MAXN = 6555;\n\nstruct Edge {\n    int target;\n    int capacity;\n    int cost;\n    int reverseIndex;\n    Edge(int t, int cap, int cst, int rev) : target(t), capacity(cap), cost(cst), reverseIndex(rev) {}\n};\n\nstruct MinCostMaxFlowSolver {\n    int numVertices;\n    int potential[MAXN + 5];\n    int dist[MAXN + 5];\n    int prevVertex[MAXN + 5];\n    int prevEdge[MAXN + 5];\n    vector<Edge> adjList[MAXN + 5];\n\n    void initialize(int n) {\n        numVertices = n;\n        for (int i = 0; i <= n; ++i) adjList[i].clear();\n    }\n\n    void insertEdge(int from, int to, int cap, int cst) {\n        adjList[from].emplace_back(to, cap, cst, (int)adjList[to].size());\n        adjList[to].emplace_back(from, 0, -cst, (int)adjList[from].size() - 1);\n    }\n\n    int calculate(int source, int sink, int flowNeeded) {\n        int totalFlow = 0, totalCost = 0;\n        memset(potential, 0, sizeof(potential));\n        while (flowNeeded > 0) {\n            priority_queue<PII, vector<PII>, greater<PII>> pq;\n            fill(dist, dist + numVertices + 1, INF);\n            dist[source] = 0;\n            pq.emplace(0, source);\n            while (!pq.empty()) {\n                auto [d, u] = pq.top(); pq.pop();\n                if (d != dist[u]) continue;\n                for (int i = 0; i < adjList[u].size(); ++i) {\n                    auto& e = adjList[u][i];\n                    if (e.capacity > 0 && dist[e.target] > dist[u] + e.cost + potential[u] - potential[e.target]) {\n                        dist[e.target] = dist[u] + e.cost + potential[u] - potential[e.target];\n                        prevVertex[e.target] = u;\n                        prevEdge[e.target] = i;\n                        pq.emplace(dist[e.target], e.target);\n                    }\n                }\n            }\n            if (dist[sink] == INF) break;\n            for (int i = 0; i <= numVertices; ++i) potential[i] += dist[i];\n            int flow = flowNeeded;\n            for (int v = sink; v != source; v = prevVertex[v])\n                flow = min(flow, adjList[prevVertex[v]][prevEdge[v]].capacity);\n            flowNeeded -= flow;\n            totalFlow += flow;\n            totalCost += flow * potential[sink];\n            for (int v = sink; v != source; v = prevVertex[v]) {\n                auto& e = adjList[prevVertex[v]][prevEdge[v]];\n                e.capacity -= flow;\n                adjList[v][e.reverseIndex].capacity += flow;\n            }\n        }\n        return totalCost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    MinCostMaxFlowSolver solver;\n    solver.initialize(n * (n + 55) + 2);\n\n    for (int i = 0; i < k; ++i) {\n        int u; cin >> u;\n        solver.insertEdge(0, u, 1, 0);\n    }\n\n    vector<PII> edges(m);\n    for (int i = 0; i < m; ++i) {\n        cin >> edges[i].first >> edges[i].second;\n    }\n\n    int sinkNode = n * (n + 55) + 1;\n    for (int t = 0; t < n + 54; ++t) {\n        for (const auto& e : edges) {\n            for (int j = 1; j <= k; ++j) {\n                int cost = c + d * (2 * j - 1);\n                solver.insertEdge(e.first + t * n, e.second + (t + 1) * n, 1, cost);\n                solver.insertEdge(e.second + t * n, e.first + (t + 1) * n, 1, cost);\n            }\n        }\n        for (int i = 2; i <= n; ++i) {\n            solver.insertEdge(i + t * n, i + (t + 1) * n, k, c);\n        }\n        solver.insertEdge(1 + t * n, sinkNode, k, 0);\n    }\n\n    cout << solver.calculate(0, sinkNode, k) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\nfrom collections import defaultdict\n\nclass Edge:\n    def __init__(self, target, capacity, cost, reverseIndex):\n        self.target = target\n        self.capacity = capacity\n        self.cost = cost\n        self.reverseIndex = reverseIndex\n\nclass MinCostMaxFlowSolver:\n    def __init__(self):\n        self.numVertices = 0\n        self.MAXN = 6555\n        self.potential = [0] * (self.MAXN + 5)\n        self.dist = [0] * (self.MAXN + 5)\n        self.prevVertex = [0] * (self.MAXN + 5)\n        self.prevEdge = [0] * (self.MAXN + 5)\n        self.adjList = defaultdict(list)\n    \n    def initialize(self, n):\n        self.numVertices = n\n        self.adjList = defaultdict(list)\n    \n    def insertEdge(self, from_node, to_node, cap, cst):\n        # Forward edge\n        forward_index = len(self.adjList[to_node])\n        reverse_index = len(self.adjList[from_node])\n        self.adjList[from_node].append(Edge(to_node, cap, cst, forward_index))\n        # Backward edge\n        self.adjList[to_node].append(Edge(from_node, 0, -cst, reverse_index))\n    \n    def calculate(self, source, sink, flowNeeded):\n        totalFlow = 0\n        totalCost = 0\n        # Reset potential\n        self.potential = [0] * (self.MAXN + 5)\n        \n        while flowNeeded > 0:\n            # Dijkstra's algorithm with priority queue\n            self.dist = [float('inf')] * (self.MAXN + 5)\n            self.dist[source] = 0\n            pq = [(0, source)]\n            visited = set()\n            \n            while pq:\n                d, u = heapq.heappop(pq)\n                if u in visited:\n                    continue\n                visited.add(u)\n                if d != self.dist[u]:\n                    continue\n                for i, e in enumerate(self.adjList[u]):\n                    if e.capacity > 0 and self.dist[e.target] > self.dist[u] + e.cost + self.potential[u] - self.potential[e.target]:\n                        self.dist[e.target] = self.dist[u] + e.cost + self.potential[u] - self.potential[e.target]\n                        self.prevVertex[e.target] = u\n                        self.prevEdge[e.target] = i\n                        heapq.heappush(pq, (self.dist[e.target], e.target))\n            \n            if self.dist[sink] == float('inf'):\n                break\n            \n            # Update potential\n            for i in range(self.numVertices + 1):\n                self.potential[i] += self.dist[i]\n            \n            # Find the minimum capacity along the path\n            flow = flowNeeded\n            v = sink\n            while v != source:\n                u = self.prevVertex[v]\n                edge_index = self.prevEdge[v]\n                edge = self.adjList[u][edge_index]\n                flow = min(flow, edge.capacity)\n                v = u\n            \n            flowNeeded -= flow\n            totalFlow += flow\n            totalCost += flow * self.potential[sink]\n            \n            # Update capacities\n            v = sink\n            while v != source:\n                u = self.prevVertex[v]\n                edge_index = self.prevEdge[v]\n                edge = self.adjList[u][edge_index]\n                edge.capacity -= flow\n                reverse_edge = self.adjList[v][edge.reverseIndex]\n                reverse_edge.capacity += flow\n                v = u\n        \n        return totalCost\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    \n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    solver = MinCostMaxFlowSolver()\n    solver.initialize(n * (n + 55) + 2)\n    \n    for _ in range(k):\n        u = int(input_data[idx]); idx += 1\n        solver.insertEdge(0, u, 1, 0)\n    \n    edges = []\n    for _ in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        edges.append((u, v))\n    \n    sinkNode = n * (n + 55) + 1\n    for t in range(n + 54):\n        for u, v in edges:\n            for j in range(1, k + 1):\n                cost = c + d * (2 * j - 1)\n                solver.insertEdge(u + t * n, v + (t + 1) * n, 1, cost)\n                solver.insertEdge(v + t * n, u + (t + 1) * n, 1, cost)\n        \n        for i in range(2, n + 1):\n            solver.insertEdge(i + t * n, i + (t + 1) * n, k, c)\n        \n        solver.insertEdge(1 + t * n, sinkNode, k, 0)\n    \n    print(solver.calculate(0, sinkNode, k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00017236177518498152, -1.0728830375228426e-06, -2.3841855067985307e-07, -9.238292841473594e-05, -0.12725885212421417, -0.009796163998544216, -0.11282501369714737, -0.00033778208307921886, -0.5234515070915222, -0.00019929806876461953, -0.010283580049872398, -4.7683704