ny] - 1, LIM):\n                dist[nx][ny] = nt\n                q.append((nx, ny))\n            if nt <= min(infTime[nx][ny], LIM) and oneToNine(m2[nx][ny]):\n                flow.addEdge(N * sx + sy, N * N + N * nx + ny, INF)\n\ndef main():\n    global N, LIM, m1, m2, infTime, flow\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    N = int(first[0])\n    LIM = int(first[1])\n    m1 = [list(data[i+1].strip()) for i in range(N)]\n    zx = zy = 0\n    for i in range(N):\n        for j in range(N):\n            if m1[i][j] == 'Z':\n                zx, zy = i, j\n    flow = EdmondsKarp(MAXV)\n    for i in range(N):\n        for j in range(N):\n            if oneToNine(m1[i][j]):\n                flow.addEdge(MAXV - 2, i * N + j, int(m1[i][j]))\n    infTime = [[INF] * N for _ in range(N)]\n    infectBFS(zx, zy)\n    m2 = [list(data[i+1+N].strip()) for i in range(N)]\n    for i in range(N):\n        for j in range(N):\n            if oneToNine(m2[i][j]):\n                flow.addEdge(N * N + i * N + j, MAXV - 1, int(m2[i][j]))\n    for i in range(N):\n        for j in range(N):\n            if oneToNine(m1[i][j]):\n                createEdgesFrom(i, j)\n    print(flow.maxFlow(MAXV - 2, MAXV - 1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-4.7205765440594405e-05, -0.47474801540374756, -0.0002613918040879071, 0.0, -1.1920928244535389e-07, -0.20143039524555206, -3.1470757676288486e-05, -3.814689989667386e-06, -0.0001597276859683916, -0.0025536566972732544, -1.5258672647178173e-05, -3.099436753473128e-06, 0.0, 0.0, -3.576278118089249e-07, -2.264974000354414e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -6.198863957251888e-06, 0.0, -1.5497195136049413e-06, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -0.1467820703983307, -1.4305104514278355e-06, -4.529942543740617e-06, -8.106198947643861e-06, -2.3245540432981215e-05, -0.2519297003