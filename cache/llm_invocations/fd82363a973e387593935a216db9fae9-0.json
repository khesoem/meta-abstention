if ch == 'V':\n            vPos.append(i)\n        elif ch == 'K':\n            kPos.append(i)\n        else:\n            otherPos.append(i)\n    \n    V_max = len(vPos)\n    K_max = len(kPos)\n    O_max = len(otherPos)\n    \n    # dp[last][V][K][O] where last = 0 or 1 (0: last placed char not V, 1: last placed char is V)\n    # Initialize with INF\n    dp = [[[[INF] * (O_max + 1) for _ in range(K_max + 1)] for _ in range(V_max + 1)] for _ in range(2)]\n    dp[0][0][0][0] = 0\n    \n    for V in range(V_max + 1):\n        for K in range(K_max + 1):\n            for O in range(O_max + 1):\n                for last in range(2):\n                    cur = dp[last][V][K][O]\n                    if cur == INF:\n                        continue\n                    # Try placing a 'V' next\n                    if V < V_max:\n                        dp[1][V+1][K][O] = min(dp[1][V+1][K][O], \n                            cur + count(vPos[V], K, kPos) + count(vPos[V], O, otherPos))\n                    # Try placing a 'K' next (only if last != 1 i.e. not preceded by V)\n                    if K < K_max and last == 0:\n                        dp[0][V][K+1][O] = min(dp[0][V][K+1][O], \n                            cur + count(kPos[K], V, vPos) + count(kPos[K], O, otherPos))\n                    # Try placing an other character next\n                    if O < O_max:\n                        dp[0][V][K][O+1] = min(dp[0][V][K][O+1], \n                            cur + count(otherPos[O], V, vPos) + count(otherPos[O], K, kPos))\n    \n    return min(dp[0][V_max][K_max][O_max], dp[1][V_max][K_max][O_max])\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    # Note: The Java code reads an integer n first but does not use it.\n    # We read it to consume input, then read the string s.\n    n = int(data[0])  # n is not used, but we must read it\n    s = data[1]\n    ans = solve(list(s))\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n