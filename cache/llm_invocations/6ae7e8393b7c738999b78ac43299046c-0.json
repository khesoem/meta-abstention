bj.m\n        self.mod = input_obj.mod\n\nclass Data(Input):\n    def __init__(self):\n        super().__init__()\n        self.ans = 0\n\n    def write(self):\n        print(self.ans)\n\nclass Solution(Data):\n    def __init__(self):\n        super().__init__()\n        self.N = 500\n        self.c = [[0] * (self.N + 1) for _ in range(self.N + 1)]\n        self.a = [(0, 0)] * (self.N + 1)\n        self.d = [[(0, 0)] * (self.N + 1) for _ in range(self.N + 2)]\n        self.mod = 1\n\n    def pw(self, x, y):\n        res = 1\n        while y:\n            if y & 1:\n                res = res * x % self.mod\n            x = x * x % self.mod\n            y >>= 1\n        return res\n\n    def inv(self, x):\n        return self.pw(x, self.mod - 2)\n\n    def ss(self, x):\n        return x * (x + 1) // 2\n\n    def solve(self):\n        for i in range(self.n + 1):\n            for j in range(self.n + 1):\n                if i == 0 or j == 0:\n                    self.c[i][j] = 1\n                else:\n                    self.c[i][j] = (self.c[i - 1][j] + self.c[i][j - 1]) % self.mod\n\n        self.a = [(1, 0)] + [(0, 0)] * self.m\n        for i in range(1, self.m + 1):\n            for j in range(i):\n                cur_fs = self.a[j][0] * self.a[i - 1 - j][0] % self.mod\n                cur_sc = (self.a[j][1] * self.a[i - 1 - j][0] + self.a[j][0] * self.a[i - 1 - j][1]) % self.mod\n                cur_sc = (cur_sc * (i + 1) + (self.ss(j) + self.ss(i - 1 - j)) * cur_fs) % self.mod\n                cur_fs = (cur_fs * (i + 1)) % self.mod\n                cur_fs = (cur_fs * self.c[j][i - 1 - j]) % self.mod\n                cur_sc = (cur_sc * self.c[j][i - 1 - j]) % self.mod\n                self.a[i] = ( (self.a[i][0] + cur_fs) % self.mod, (self.a[i][1] + cur_sc) % self.mod )\n\n        self.d = [[(0, 0)] * (self.m + 1) for _ in range(self.n + 2)]\n        self.d[0][0] = (1, 0)\n\n        for i in range(self.n + 2):\n            for j in range(self.m + 1):\n            