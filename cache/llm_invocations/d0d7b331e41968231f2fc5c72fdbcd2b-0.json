E:\n                return [self.buffer[start]]\n            even = self.recursive_dft(start, step * 2, forward)\n            odd = self.recursive_dft(start + step, step * 2, forward)\n            half = len(even)\n            result = [0] * (half * 2)\n            for i in range(half):\n                twiddle = FFT.W_ARR[i * step] if forward else FFT.W_INV_ARR[i * step]\n                result[i] = (even[i] + twiddle * odd[i]) % FFT.MOD\n            for i in range(half):\n                twiddle = FFT.W_ARR[i * step] if forward else FFT.W_INV_ARR[i * step]\n                result[half + i] = ((even[i] - twiddle * odd[i]) % FFT.MOD + FFT.MOD) % FFT.MOD\n            return result\n\n    def compute_dft(self, input_arr):\n        n = FFT.MAX_SIZE\n        output = [0] * n\n        w_power = 1\n        for i in range(n):\n            x = 1\n            for j in range(len(input_arr)):\n                output[i] = (output[i] + input_arr[j] * x) % FFT.MOD\n                x = (x * w_power) % FFT.MOD\n            w_power = (w_power * FFT.W) % FFT.MOD\n        return output\n\n    def exponentiate(self, arr, exponent):\n        for i in range(len(arr)):\n            arr[i] = self.modular_exponentiation(arr[i], exponent)\n        return arr\n\n    def modular_exponentiation(self, base, exp):\n        if exp == 0:\n            return 1\n        if exp & 1:\n            return (self.modular_exponentiation(base, exp - 1) * base) % FFT.MOD\n        half = self.modular_exponentiation(base, exp >> 1)\n        return (half * half) % FFT.MOD\n\n    def process(self):\n        n = self.scanner.nextInt()\n        k = self.scanner.nextInt()\n        values = [0] * 10\n        for _ in range(k):\n            idx = self.scanner.nextInt()\n            values[idx] = 1\n        transformed = self.compute_dft(values)\n        transformed = self.exponentiate(transformed, n // 2)\n        buffer = self.DataBuffer(transformed)\n        transformed = buffer.transform(False)\n        for i in range(len(transformed)):\n            transformed[i] = (transformed[i] * FFT.SIZE_INV) % FFT.MOD\n        result = 0\n        for val in transformed:\n            result = (result + val * val) % FFT.MOD\n        self.writer.println(result)\n\n    def initialize(self):\n        try:\n            self.scanner = FastScanner(sys.stdin)\n            self.writer = PrintWriter(sys.stdout)\n            self.process()\n            self.writer.close()\n        except Exception as e:\n            print(e)\n\n    class FastScanner:\n        def __init__(self, stream):\n            self.reader = stream\n            self.tokenizer = []\n\n        def next_line(self):\n            try:\n                return self.reader.readline()\n            except Exception:\n                return None\n\n        def next_token(self):\n            while not self.tokenizer:\n                try:\n                    line = self.reader.readline()\n                    if not line:\n                        return None\n                    self.tokenizer = line.strip().split()\n                except Exception:\n                    print(\"Error reading input\")\n                    return None\n            return self.tokenizer.pop(0)\n\n        def nextInt(self):\n            token = self.next_token()\n            return int(token) if token is not None else 0\n\n        def nextLong(self):\n            token = self.next_token()\n            return int(token) if token is not None else 0\n\n        def nextDouble(self):\n            token = self.next_token()\n            return float(token) if token is not None else 0.0\n\n    class PrintWriter:\n        def __init__(self, stream):\n            self.stream = stream\n\n        def println(self, value):\n            self.stream.write(str(value) + '\\n')\n            self.stream.flush()\n\n# Initialize static variables\nFFT.init_static()\n\nif __name__ == \"__main__\":\n    fft = FFT()\n    fft.initialize()\n</translated_code>\n<confidence>\n0.75\n</co