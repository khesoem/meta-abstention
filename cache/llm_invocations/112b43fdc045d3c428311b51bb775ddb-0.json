nt);\n                current = \"\";\n            }\n        } else {\n            current += c;\n        }\n    }\n    if (!current.empty()) {\n        input.push_back(current);\n    }\n    \n    int n = stoi(input[0]);\n    int m = stoi(input[1]);\n    \n    if (n > m) {\n        int swap = n;\n        n = m;\n        m = swap;\n    }\n\n    long long totalCells = (long long)n * m;\n\n    if (totalCells < 100) {\n        vector<vector<int>> adjacency((int)totalCells);\n        \n        for (int i = 0; i < totalCells; i++) {\n            for (int j = 0; j < totalCells; j++) {\n                int r1 = i / m, c1 = i % m;\n                int r2 = j / m, c2 = j % m;\n                if (abs(r1 - r2) + abs(c1 - c2) == 3) {\n                    adjacency[i].push_back(j);\n                }\n            }\n        }\n\n        int matchingCount = computeMaximumMatching(adjacency);\n        cout << matchingCount * 2 << endl;\n    } else {\n        long long finalAnswer;\n        if (n == 1) {\n            finalAnswer = (m / 6) * 6 + ((m % 6 == 4) ? 2 : 0) + ((m % 6 == 5) ? 4 : 0);\n        } else {\n            finalAnswer = (long long)n * m;\n            finalAnswer -= finalAnswer % 2;\n        }\n        cout << finalAnswer << endl;\n    }\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.3\n</confidence>", "token_logprobs": [-9.893881360767409e-05, -2.7418097943154862e-06, -1.1920922133867862e-06, -0.0013891342096030712, -8.344646857949556e-07, -3.099436753473128e-06, -3.576278118089249e-07, -8.702239938429557e-06, -2.145764938177308e-06, -0.0017296605510637164, -2.3841855067985307e-07, -3.814624506048858e-05, -1.6689286894688848e-06, -0.11098529398441315, -1.9073468138230965e-06, -4.291525328881107e-06, -3.576278118089249e-07, -0.003955161664634943, -5.960462772236497e-07, -1.168244216387393e-05, -4.0531076592742465e-06, -0.7778390645980835, -0.016035521402955055, -0.054886143654584885, -1.6093124941107817e-05, -0.711540699005127, -0.5759461522102356, -0