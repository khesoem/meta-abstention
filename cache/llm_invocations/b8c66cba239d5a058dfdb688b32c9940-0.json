oat > 0) {\n\t\t\tfor(int i = nA; i >= 0 && 50 * (nA - i) <= k; i--)\n\t\t\t\tfor(int j = nB; j >= 0 && 50 * (nA - i) + 100 * (nB - j) <= k; j--)\n\t\t\t\t\tif(i != nA || j != nB)\n\t\t\t\t\t\tresolve(i, j, boat, mask, choose[nA][i] * choose[nB][j] % MOD);\n\t\t} else {\n\t\t\tfor(int i = nA; i <= a && 50 * (i - nA) <= k; i++)\n\t\t\t\tfor(int j = nB; j <= b && 50 * (i - nA) + 100 * (j - nB) <= k; j++)\n\t\t\t\t\tif(i != nA || j != nB)\n\t\t\t\t\t\tresolve(i, j, boat, mask, choose[a - nA][i - nA] * choose[b - nB][j - nB] % MOD);\n\t\t}\n\t}\n\tstatic void resolve(int i, int j, int boat, int mask, long edgeWays) {\n\t\tint newMask = 1000000 * (1 - boat) + i * 100 + j;\n\t\tint newD = ways.get(mask).d + 1;\n\t\tif(!ways.containsKey(newMask)) {\n\t\t\tways.put(newMask, new Pair(newD, 0));\n\t\t\tq.add(newMask);\n\t\t}\n\t\tif(ways.get(newMask).d == newD)\n\t\t\tways.get(newMask).w = (ways.get(newMask).w + ways.get(mask).w * edgeWays % MOD) % MOD;\n\t}\n\tstatic void fillChoose() {\n\t\tfor(int i = 0; i < 100; i++)\n\t\t\tchoose[i][0] = 1;\n\t\tfor(int i = 1; i < 100; i++)\n\t\t\tfor(int j = 1; j <= i; j++)\n\t\t\t\tchoose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD;\n\t}\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMOD = 1000000007\nn = k = a = b = 0\nchoose = [[0]*100 for _ in range(100)]\n\ndef fill_choose():\n    for i in range(100):\n        choose[i][0] = 1\n    for i in range(1, 100):\n        for j in range(1, i+1):\n            choose[i][j] = (choose[i-1][j-1] + choose[i-1][j]) % MOD\n\ndef bfs(mask, ways, q):\n    boat = mask // 1000000\n    nA = (mask % 1000000) // 100\n    nB = mask % 100\n    if boat > 0:\n        for i in range(nA, -1, -1):\n            if 50 * (nA - i) > k:\n                break\n            for j in range(nB, -1, -1):\n                if 50 * (nA - i) + 100 * (nB - j) > k:\n                    break\n                if i == nA and j == nB:\n                    continue\n                edge_ways = choose[nA][i] * choose[nB][j] % MOD\n                resolve(i, j, boat, mask, edge_ways, ways, q)\n    else:\n        for i in range(nA, a+1):\n            if 50 * (i - nA) > k:\n                break\n            for j in range(nB, b+1):\n                if 50 * (i - nA) + 100 * (j - nB) > k:\n                    break\n                if i == nA and j == nB:\n                    continue\n                edge_ways = choose[a - nA][i - nA] * choose[b - nB][j - nB] % MOD\n                resolve(i, j, boat, mask, edge_ways, ways, q)\n\ndef resolve(i, j, boat, mask, edge_ways, ways, q):\n    new_mask = 1000000 * (1 - boat) + i * 100 + j\n    new_d = ways[mask][0] + 1\n    if new_mask not in ways:\n        ways[new_mask] = [new_d, 0]\n        q.append(new_mask)\n    if ways[new_mask][0] == new_d:\n        ways[new_mask][1] = (ways[new_mask][1] + ways[mask][1] * edge_ways) % MOD\n\ndef main():\n    global n, k, a, b\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    a = 0\n    b = 0\n    for i in range(n):\n        val = int(data[2+i])\n        if val == 50:\n            a += 1\n        else:\n            b += 1\n    fill_choose()\n    start_mask = 1000000 + 100 * a + b\n    q = deque()\n    q.append(start_mask)\n    ways = {start_mask: [0, 1]}\n    while q:\n        mask = q.popleft()\n        bfs(mask, ways, q)\n    if 0 in ways:\n        print(ways[0][0])\n        print(ways[0][1])\n    else:\n        print(\"-1\")\n        print(\"0\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.2874520507466514e-05, -1.1920928244535389e-07, 0.0, -0.00013136000779923052, -0.00036221143091097474, -2.861018856492592e-06, -5.6265202147187665e-05, -0.00010096516780322418, -3.576278118089249e-07, 0