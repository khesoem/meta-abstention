{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 11 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 11 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    private static BufferedReader in;\n    private static StringTokenizer st;\n    private static final PrintWriter out = new PrintWriter(new BufferedWriter(new OutputStreamWriter(System.out)));\n\n    public static void main(String[] args) throws IOException {\n        in = new BufferedReader(new InputStreamReader(System.in));\n        new Main().solve();\n        out.flush();\n        in.close();\n    }\n\n    private void solve() throws IOException {\n        String line = in.readLine();\n        if (line == null || line.trim().isEmpty()) return;\n\n        st = new StringTokenizer(line);\n        int T = Integer.parseInt(st.nextToken());\n        nextLine();\n        int N = T;\n        int[] A = readInts(3);\n        nextLine();\n        int[] B = readInts(3);\n\n        int alice = 0;\n        int bob = 0;\n\n        // Alice's points\n        if (A[0] > 0) alice += Math.min(A[0], B[1]);\n        if (A[1] > 0) alice += Math.min(A[1], B[2]);\n        if (A[2] > 0) alice += Math.min(A[2], B[0]);\n\n        // Bob's points with resource updates\n        if (B[0] > 0) {\n            int use = Math.min(B[0], A[1]);\n            bob += use;\n            B[0] -= use;\n            if (B[0] > 0) bob += Math.min(B[0], A[0]);\n        }\n        if (B[1] > 0) {\n            int use = Math.min(B[1], A[2]);\n            bob += use;\n            B[1] -= use;\n            if (B[1] > 0) bob += Math.min(B[1], A[1]);\n        }\n        if (B[2] > 0) {\n            int use = Math.min(B[2], A[0]);\n            bob += use;\n            B[2] -= use;\n            if (B[2] > 0) bob += Math.min(B[2], A[2]);\n        }\n\n        System.out.println((N - bob) + \" \" + alice);\n    }\n\n    private static void nextLine() throws IOException {\n        String line = in.readLine();\n        if (line != null && !line.trim().isEmpty()) {\n            st = new StringTokenizer(line);\n        }\n    }\n\n    private static int nextInt() {\n        return st.hasMoreTokens() ? Integer.parseInt(st.nextToken()) : 0;\n    }\n\n    private static int[] readInts(int n) {\n        int[] res = new int[n];\n        for (int i = 0; i < n; i++) res[i] = nextInt();\n        return res;\n    }\n\n    private static long nextLong() {\n        return st.hasMoreTokens() ? Long.parseLong(st.nextToken()) : 0L;\n    }\n\n    private static long[] readLongs(int n) {\n        long[] res = new long[n];\n        for (int i = 0; i < n; i++) res[i] = nextLong();\n        return res;\n    }\n\n    private static double nextDouble() {\n        return Double.parseDouble(st.nextToken());\n    }\n\n    private static String nextToken() {\n        return st.hasMoreTokens() ? st.nextToken() : \"\";\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <sstream>\n#include <string>\n#include <vector>\n#include <algorithm>\n#include <cctype>\n\nclass Main {\nprivate:\n    std::string line;\n    std::istringstream iss;\n    \n    void nextLine() {\n        if (std::getline(std::cin, line)) {\n            iss.str(line);\n            iss.clear();\n        }\n    }\n    \n    int nextInt() {\n        int val;\n        if (iss >> val) {\n            return val;\n        }\n        return 0;\n    }\n    \n    std::vector<int> readInts(int n) {\n        std::vector<int> res(n);\n        for (int i = 0; i < n; ++i) {\n            res[i] = nextInt();\n        }\n        return res;\n    }\n\npublic:\n    void solve() {\n        if (!std::getline(std::cin, line)) return;\n        \n        if (line.empty() || std::all_of(line.begin(), line.end(), ::isspace)) return;\n        \n        iss.str(line);\n        iss.clear();\n        int T = nextInt();\n        nextLine();\n        int N = T;\n        std::vector<int> A = readInts(3);\n        nextLine();\n        std::vector<int> B = readInts(3);\n\n        int alice = 0;\n        int bob = 0;\n\n        // Alice's points\n        if (A[0] > 0) alice += std::min(A[0], B[1]);\n        if (A[1] > 0) alice += std::min(A[1], B[2]);\n        if (A[2] > 0) alice += std::min(A[2], B[0]);\n\n        // Bob's points with resource updates\n        if (B[0] > 0) {\n            int use = std::min(B[0], A[1]);\n            bob += use;\n            B[0] -= use;\n            if (B[0] > 0) bob += std::min(B[0], A[0]);\n        }\n        if (B[1] > 0) {\n            int use = std::min(B[1], A[2]);\n            bob += use;\n            B[1] -= use;\n            if (B[1] > 0) bob += std::min(B[1], A[1]);\n        }\n        if (B[2] > 0) {\n            int use = std::min(B[2], A[0]);\n            bob += use;\n            B[2] -= use;\n            if (B[2] > 0) bob += std::min(B[2], A[2]);\n        }\n\n        std::cout << (N - bob) << \" \" << alice << std::endl;\n    }\n};\n\nint main() {\n    Main solver;\n    solver.solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001515035255579278, -