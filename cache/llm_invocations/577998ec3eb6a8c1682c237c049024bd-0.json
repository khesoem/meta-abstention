            String cand = String.format(\"%02d\", i);\n            if (matchTwo(pat, cand)) cnt++;\n        }\n        return cnt;\n    }\n\n    private static boolean matchTwo(String p, String c) {\n        char a = p.charAt(0), b = p.charAt(1);\n        char x = c.charAt(0), y = c.charAt(1);\n\n        if (Character.isDigit(a)) {\n            if (Character.isDigit(b)) return p.equals(c);\n            if (b == '_') return a == x;\n        } else if (a == '_') {\n            if (Character.isDigit(b)) return b == y;\n            if (b == '_') return true;\n        } else if (a == 'X') {\n            if (Character.isDigit(b)) return b == y;\n            if (b == '_') return true;\n        }\n        return false;\n    }\n\n    private static boolean isValidPattern(String pat, String cand) {\n        Set<Character> digits = new HashSet<>();\n        for (int i = 0; i < pat.length(); i++) {\n            char pc = pat.charAt(i);\n            char cc = cand.charAt(i);\n            if (pc == '_') continue;\n            if (pc == 'X') {\n                digits.add(cc);\n                if (digits.size() > 1) return false;\n            } else if (pc != cc) {\n                return false;\n            }\n        }\n        return digits.size() <= 1;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef is_single_char_valid(s):\n    return s in (\"0\", \"_\", \"X\")\n\ndef match_two(p, c):\n    a, b = p[0], p[1]\n    x, y = c[0], c[1]\n    \n    if a.isdigit():\n        if b.isdigit():\n            return p == c\n        if b == '_':\n            return a == x\n    elif a == '_':\n        if b.isdigit():\n            return b == y\n        if b == '_':\n            return True\n    elif a == 'X':\n        if b.isdigit():\n            return b == y\n        if b == '_':\n            return True\n    return False\n\ndef count_two_digit_matches(pat):\n    cnt = 0\n    for i in range(25, 96, 25):\n        cand = f\"{i:02d}\"\n        if match_two(pat, cand):\n            cnt += 1\n    return cnt\n\ndef is_valid_pattern(pat, cand):\n    digits = set()\n    for i in range(len(pat)):\n        pc = pat[i]\n        cc = cand[i]\n        if pc == '_':\n            continue\n        if pc == 'X':\n            digits.add(cc)\n            if len(digits) > 1:\n                return False\n        elif pc != cc:\n            return False\n    return len(digits) <= 1\n\ndef main():\n    s = sys.stdin.readline().strip()\n    n = len(s)\n    \n    if n == 1:\n        print(1 if is_single_char_valid(s) else 0)\n        return\n    \n    if n == 2:\n        print(count_two_digit_matches(s))\n        return\n    \n    low = 10 ** (n - 1)\n    high = 10 ** n\n    cnt = 0\n    \n    for num in range(low, high, 25):\n        num_str = str(num)\n        if is_valid_pattern(s, num_str):\n            cnt += 1\n    \n    print(cnt)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00012396997772157192, -4.768370445162873e-07, -1.1920928244535389e-07, -0.005252727307379246, -0.01023001130670309, -0.02630683407187462, -8.821448318485636e-06, -0.6326552629470825, -0.3484874963760376, -1.9788545614574105e-05, -5.8412379075889476e-06, -9.536738616588991e-07, -8.4638240878121e-06, -2.3841855067985307e-07, -2.622600959512056e-06, -1.1920928244535389e-07, -0.0009270184673368931, -0.20614755153656006, 0.0, -2.3841855067985307e-07, -0.0009198724874295294, -3.576278118089249e-07, 0.0, 0.0, -3.194758028257638e-05, -4.768370445162873e-07, -0.5759548544883728, -0.0002540027489885688, -1.7881233361549675e-05, -2.50339189733495e-06, -1.1920928244535389e-07, -5.960446742392378e-06, -5.960462772236497e-07, -1.0609570381348021e-05, -0.0336463488638401, -2.3841855067985307e-07, -2.3841855067985307e-07, -8.344646857949556e-07, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07