his.p = p;\n        }\n    }\n    \n    static class Flow {\n        static final int N = 50 * T + 2;\n        static List<Edge>[] adj = new ArrayList[N];\n        static int[] sz = new int[N];\n        static long mc;\n        static boolean[] vis = new boolean[N];\n        static int[] par = new int[N];\n        static long[] pot = new long[N];\n        static long[] dist = new long[N];\n        \n        static void init(int n) {\n            mc = 0;\n            Arrays.fill(sz, 0, n, 0);\n            for (int i = 0; i < n; i++) adj[i] = new ArrayList<>();\n        }\n        \n        static void addEdge(int a, int b, long c, long p) {\n            mc = Math.max(mc, c);\n            adj[a].add(new Edge(b, sz[b]++, 0, c, p));\n            adj[b].add(new Edge(a, sz[a]++, 0, 0, -p));\n        }\n        \n        static long mcf(int s, int t, long[] price, int n, boolean sparse) {\n            Arrays.fill(vis, 0, n, false);\n            Arrays.fill(dist, 0, n, INF);\n            dist[s] = 0;\n            \n            if (sparse) {\n                PriorityQueue<long[]> pq = new PriorityQueue<>((a,b) -> Long.compare(a[0], b[0]));\n                pq.offer(new long[]{0, s});\n                while (!pq.isEmpty()) {\n                    long[] cur = pq.poll();\n                    int u = (int) cur[1];\n                    if (vis[u]) continue;\n                    vis[u] = true;\n                    for (Edge e : adj[u]) {\n                        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                            par[e.v] = e.r;\n                            pq.offer(new long[]{-dist[e.v], e.v});\n                        }\n                    }\n                }\n            } else {\n                for (int u = s; u != -1; ) {\n                    vis[u] = true;\n                    for (Edge e : adj[u]) {\n                        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                            par[e.v] = e.r;\n                        }\n                    }\n                    u = -1;\n                    long best = INF;\n                    for (int i = 0; i < n; i++) {\n                        if (!vis[i] && dist[i] < best) {\n                            best = dist[i];\n                            u = i;\n                        }\n                    }\n                }\n            }\n            \n            if (dist[t] >= INF / 2) return 0;\n            long df = INF;\n            for (int u = t; u != s; ) {\n                Edge r = adj[u].get(par[u]);\n                df = Math.min(df, adj[r.v].get(r.r).c - adj[r.v].get(r.r).f);\n                u = r.v;\n            }\n            for (int u = t; u != s; ) {\n                Edge r = adj[u].get(par[u]);\n                Edge e = adj[r.v].get(r.r);\n                e.f += df;\n                r.f -= df;\n                price[0] += df * e.p;\n                u = r.v;\n            }\n            for (int i = 0; i < n; i++) {\n                pot[i] = Math.min(INF, dist[i] + pot[i]);\n            }\n            return df;\n        }\n        \n        static long minCostFlow(int s, int t, long[] price, int n, boolean sparse) {\n            long flow = 0;\n            price[0] = 0;\n            while (true) {\n                long df = mcf(s, t, price, n, sparse);\n                if (df == 0) break;\n                flow += df;\n            }\n            return flow;\n        }\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        final int source = 0;\n        final int sink = n * T + 1;\n        \n        Flow.init(sink + 1);\n        \n        for (int i = 0; i < k; i++) {\n            int a = sc.nextInt();\n            Flow.addEdge(source, a, 1, 0);\n        }\n        \n        for (int t = 0; t < T; t++) {\n            Flow.addEdge(1 + t * n, sink, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; i++) {\n                    Flow.addEdge(i + (t-1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n        \n        for (int i = 0; i < m; i++) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; j++) {\n                int cost = (j+1)*(j+1) - j*j;\n                for (int t = 1; t < T; t++) {\n                    Flow.addEdge(a + (t-1) * n, b + t * n, 1, cost * d + c);\n                    Flow.addEdge(b + (t-1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n        \n        long[] price = new long[1];\n        long flow = Flow.minCostFlow(source, sink, price, sink + 1, true);\n        \n        System.out.println(price[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.0265559e-06, 0.0, 0.0, -2.324554e-05, -0.00045813556, -2.503392e-06, -0.100212835, -0.8260518, -0.0026108485, -3.576278e-07, -0.00090593775, -0.006733347, -0.002505261, -0.26073992, -0.12700942, -0.13066648, -0.025898028, -1.6689287e-06, 0.0, -8.821448e-06, -0.000107044216, 0.0, 0.0, -2.3841855e-07, -4.7683704e-07, -3.7192607e-05, -1.5497195e-06, -1.1920928e-07, -1.7881378e-06, -0.02327107, -0.048587896, -4.3868058e-05, -0.0035289174, -0.5765501, -5.0238132, -1.4781843e-05, -0.82594234, -0.038063332, -4.5299425e-06, -3.576278e-07, -0.00028415458, -0.0032144326, -0.0031779523, -4.887569e-06, -0.00017176583, -0.0038045896, -1.1920928e-07, -0.0012679403, -0.58219796, -2.3841855e-07, 0.0, -0.0074471007, -9.5367386e-07, -1.3167906, -0.6339841, -0.82595044, -8.344647e-07, -0.014738489, -0.0002930927, -0.16273355, -6.723178e-05, -2.3841855e-07, -3.576278