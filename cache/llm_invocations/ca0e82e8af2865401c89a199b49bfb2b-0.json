    it = iter(data)\n    N = int(next(it)\n    prob = [[None] * N for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            p = int(next(it))\n        prob[i][j] = [None] * N\n        for j in range(N):\n            p = int(next(it))\n            prob[i][j] = mod_int(p) / mod_int(100)\n\n    # possible_masks: map from integer (bitmask of reachable subsets) to mod_int probability\n    possible_masks = {1: mod_int(1)}  # only subset 0 is reachable initially\n\n    for left in range(N):\n        new_possible_masks = {}\n        for current in range(1 << N):\n            # compute product of probabilities for this current assignment\n            product = mod_int(1)\n            for right in range(N):\n                if (current >> right) & 1:\n                    product *= prob[left][right]\n                else:\n                    product *= (mod_int(1) - prob[left][right])\n            # iterate over all current possible masks\n            for possible_int, prob_val in possible_masks.items():\n                new_possible_int = 0\n                # iterate over set bits of possible_int (each bit corresponds to a mask of right nodes)\n                m = possible_int\n                while m:\n                    lsb = m & -m\n                    mask = (lsb.bit_length() - 1)\n                    m ^= lsb\n                    # for each i where current has bit and mask does not\n                    for i in range(N):\n                        if (current >> i) & 1 and not ((mask >> i) & 1):\n                            new_mask = mask | (1 << i)\n                            new_possible_int |= (1 << new_mask)\n                # add to new_possible_masks\n                key = new_possible_int\n                if key in new_possible_masks:\n                    new_possible_masks[key] += prob_val * product\n                else:\n                    new_possible_masks[key] = prob_val * product\n        possible_masks = new_possible_masks\n  