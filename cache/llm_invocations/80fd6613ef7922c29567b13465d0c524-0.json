int n = Integer.parseInt(tokens[0]);\n        int k = Integer.parseInt(tokens[1]);\n        int L = Integer.parseInt(tokens[2]);\n        \n        computeBinomial(n);\n        \n        long[] p = new long[2 * n + 1];\n        long[] q = new long[2 * n + 1];\n        \n        p[n] = modPow(2, n);\n        \n        for (int step = 0; step < n; step++) {\n            for (int i = 2 * n; i > 0; i--) {\n                p[i] = (p[i] - p[i - 1]) % MOD;\n            }\n        }\n        \n        long[] result = p.clone();\n        long inv2 = (MOD + 1) / 2;\n        \n        for (int iter = 1; iter <= n - k; iter++) {\n            // Divide by 2x: shift and scale\n            for (int i = 0; i < 2 * n; i++) {\n                q[i] = p[i + 1] * inv2 % MOD;\n            }\n            q[2 * n] = 0;\n            \n            // Divide by (1 - x): cumulative sum\n            for (int i = 1; i <= 2 * n; i++) {\n                q[i] = (q[i] + q[i - 1]) % MOD;\n            }\n            \n            // Update p = q - p\n            for (int i = 0; i <= 2 * n; i++) {\n                p[i] = (q[i] - p[i]) % MOD;\n            }\n            \n            long c = binomial[n][iter];\n            for (int i = 0; i <= 2 * n; i++) {\n                result[i] = (result[i] + c * p[i]) % MOD;\n            }\n        }\n        \n        // Compute definite integral from 0 to L\n        long integral = 0;\n        for (int i = 0; i <= 2 * n; i++) {\n            integral = (integral + result[i] * modInverse(i + 1, MOD)) % MOD;\n        }\n        integral = (integral * L % MOD + MOD) % MOD;\n        System.out.println(integral);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <algorithm>\n\nusing namespace std;\n\nconst int MOD = 998244353;\n\nvector<vector<long long>> binomial;\n\nlong long modPow(long long base, int exp) {\n    long long result = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if (exp & 1) {\n            result = (result * base) % MOD;\n        }\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return result;\n}\n\nlong long modInverse(long long a, int mod) {\n    return modPow(a, mod - 2);\n}\n\nvoid computeBinomial(int maxN) {\n    binomial.assign(maxN + 1, vector<long long>(maxN + 1, 0));\n    for (int i = 0; i <= maxN; i++) {\n        binomial[i][0] = 1;\n        for (int j = 1; j <= i; j++) {\n            binomial[i][j] = (binomial[i-1][j] + binomial[i-1][j-1]) % MOD;\n        }\n    }\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    vector<string> tokens;\n    string token;\n    while (ss >> token) {\n        tokens.push_back(token);\n    }\n    \n    int n = stoi(tokens[0]);\n    int k = stoi(tokens[1]);\n    int L = stoi(tokens[2]);\n    \n    computeBinomial(n);\n    \n    vector<long long> p(2 * n + 1, 0);\n    vector<long long> q(2 * n + 1, 0);\n    \n    p[n] = modPow(2, n);\n    \n    for (int step = 0; step < n; step++) {\n        for (int i = 2 * n; i > 0; i--) {\n            p[i] = (p[i] - p[i - 1]) % MOD;\n        }\n    }\n    \n    vector<long long> result = p;\n    long long inv2 = (MOD + 1) / 2;\n    \n    for (int iter = 1; iter <= n - k; iter++) {\n        // Divide by 2x: shift and scale\n        for (int i = 0; i < 2 * n; i++) {\n            q[i] = p[i + 1] * inv2 % MOD;\n        }\n        q[2 * n] = 0;\n        \n        // Divide by (1 - x): cumulative sum\n        for (int i = 1; i <= 2 * n; i++) {\n            q[i] = (q[i] + q[i - 1]) % MOD;\n        }\n        \n        // Update p = q - p\n        for (int i = 0; i <= 2 * n; i++) {\n            p[i] = (q[i] - p[i]) % MOD;\n        }\n        \n        long long c = binomial[n][iter];\n        for (int i = 0; i <= 2 * n; i++) {\n            result[i] = (result[i] +