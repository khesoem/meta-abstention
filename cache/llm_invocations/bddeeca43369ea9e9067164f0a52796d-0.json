q.top().first;\n                int v = pq.top().second;\n                pq.pop();\n\n                if (d != dist[v]) continue;\n\n                for (int id : adj[v]) {\n                    Edge &e = edges[id];\n                    if (e.flow < e.cap) {\n                        int rcost = e.cost + pot[v] - pot[e.to];\n                        int nd = d + rcost;\n\n                        if (nd < dist[e.to]) {\n                            dist[e.to] = nd;\n                            prev_edge[e.to] = id;\n                            maxf[e.to] = min(maxf[v], e.cap - e.flow);\n                            pq.push(make_pair(nd, e.to));\n                        }\n                    }\n                }\n            }\n\n            if (dist[sink] == INF) break;\n\n            int add = maxf[sink];\n            for (int v = sink; v != source; v = edges[prev_edge[v] ^ 1].to) {\n                Edge &e = edges[prev_edge[v]];\n                e.flow += add;\n                edges[prev_edge[v] ^ 1].flow -= add;\n                cost += add * e.cost;\n            }\n\n            for (int v = 0; v < n; ++v)\n                if (dist[v] < INF) pot[v] += dist[v];\n\n            flow += add;\n        }\n\n        return make_pair(flow, cost);\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, K, c, d;\n    cin >> n >> m >> K >> c >> d;\n\n    const int max_time = 120;\n    vector<int> start(K);\n    for (int i = 0; i < K; ++i) cin >> start[i];\n\n    vector<vector<int>> adj(n + 1);\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        adj[x].push_back(y);\n        adj[y].push_back(x);\n    }\n\n    auto id = [n](int t, int j) {\n        return t * n + (j - 1);\n    };\n\n    int S = max_time * n;\n    int T = S + 1;\n    PotentialMinCost mf(max_time * n + 2, S, T);\n\n    for (int i = 0; i < K; ++i)\n        mf.add_edge(S, id(0, start[i]), 1, 0);\n\n    for (int t = 0; t < max_time; ++t)\