{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <climits>\nusing namespace std;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int t, int cp, int cs, int rv) : to(t), cap(cp), cost(cs), rev(rv) {}\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, r, c, d;\n    cin >> n >> m >> r >> c >> d;\n    \n    vector<int> occ(101, 0);\n    vector<pair<int, int>> pts(m + 1);\n    \n    for (int i = 1; i <= r; i++) {\n        int x;\n        cin >> x;\n        occ[x]++;\n    }\n    \n    for (int i = 1; i <= m; i++) {\n        cin >> pts[i].first >> pts[i].second;\n    }\n    \n    int S = (r + n + 1) * n + 1;\n    int T = (r + n + 1) * n + 2;\n    int nodes = T + 1;\n    \n    vector<vector<Edge>> g(nodes);\n    \n    auto add_edge = [&](int u, int v, int cap, int cost) {\n        g[u].emplace_back(v, cap, cost, g[v].size());\n        g[v].emplace_back(u, 0, -cost, g[u].size() - 1);\n    };\n    \n    for (int i = 0; i < r + n; i++) {\n        for (int j = 1; j <= m; j++) {\n            for (int k = 1; k <= r; k++) {\n                add_edge(i * n + pts[j].first, (i + 1) * n + pts[j].second, 1, (2 * k - 1) * d);\n                add_edge(i * n + pts[j].second, (i + 1) * n + pts[j].first, 1, (2 * k - 1) * d);\n            }\n        }\n    }\n    \n    for (int i = 1; i <= r + n; i++) {\n        add_edge(i * n + 1, T, INT_MAX / 2, i * c);\n        for (int j = 2; j <= n; j++) {\n            add_edge((i - 1) * n + j, i * n + j, INT_MAX / 2, 0);\n        }\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        add_edge(S, i, occ[i], 0);\n    }\n    \n    int total_cost = 0;\n    \n    while (true) {\n        vector<int> dist(nodes, INT_MAX);\n        vector<int> prevv(nodes, -1), preve(nodes, -1);\n        vector<bool> inq(nodes, false);\n        queue<int> q;\n        \n        dist[S] = 0;\n        q.push(S);\n        inq[S] = true;\n        \n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            \n            for (int i = 0; i < g[u].size(); ++i) {\n                auto& e = g[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevv[e.to] = u;\n                    preve[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n        \n        if (dist[T] == INT_MAX) break;\n        \n        int flow = INT_MAX;\n        for (int v = T; v != S; v = prevv[v]) {\n            flow = min(flow, g[prevv[v]][preve[v]].cap);\n        }\n        \n        for (int v = T; v != S; v = prevv[v]) {\n            auto& e = g[prevv[v]][preve[v]];\n            e.cap -= flow;\n            g[v][e.rev].cap += flow;\n        }\n        \n        total_cost += dist[T] * flow;\n    }\n    \n    cout << total_cost << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    r = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    occ = [0] * 101\n    pts = [(0, 0)] * (m + 1)\n    \n    for i in range(1, r + 1):\n        x = int(data[idx]); idx += 1\n        occ[x] += 1\n    \n    for i in range(1, m + 1):\n        x = int(data[idx]); idx += 1\n        y = int(data[idx]); idx += 1\n        pts[i] = (x, y)\n    \n    S = (r + n + 1) * n + 1\n    T = (r + n + 1) * n + 2\n    nodes = T + 1\n    \n    g = [[] for _ in range(nodes)]\n    \n    def add_edge(u, v, cap, cost):\n        g[u].append(Edge(v, cap, cost, len(g[v])))\n        g[v].append(Edge(u, 0, -cost, len(g[u]) - 1))\n    \n    for i in range(r + n):\n        for j in range(1, m + 1):\n            for k in range(1, r + 1):\n                add_edge(i * n + pts[j][0], (i + 1) * n + pts[j][1], 1, (2 * k - 1) * d)\n                add_edge(i * n + pts[j][1], (i + 1) * n + pts[j][0], 1, (2 * k - 1) * d)\n    \n    for i in range(1, r + n + 1):\n        add_edge(i * n + 1, T, float('inf') // 2, i * c)\n        for j in range(2, n + 1):\n            add_edge((i - 1) * n + j, i * n + j, float('inf') // 2, 0)\n    \n    for i in range(1, n + 1):\n        add_edge(S, i, occ[i], 0)\n    \n    total_cost = 0\n    \n    while True:\n        dist = [float('inf')] * nodes\n        prevv = [-1] * nodes\n        preve = [-1] * nodes\n        inq = [False] * nodes\n        q = deque()\n        \n        dist[S] = 0\n        q.append(S)\n        inq[S] = True\n        \n        while q:\n            u = q.popleft()\n            inq[u] = False\n            \n            for i in range(len(g[u])):\n                e = g[u][i]\n                if e.cap > 0 and dist[e.to] > dist[u] + e.cost:\n                    dist[e.to] = dist[u] + e.cost\n                    prevv[e.to] = u\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n        \n        if dist[T] == float('inf'):\n            break\n        \n        flow = float('inf')\n        v = T\n        while v != S:\n            flow = min(flow, g[prevv[v]][preve[v]].cap)\n            v = prevv[v]\n        \n        v = T\n        while v != S:\n            e = g[prevv[v]][preve[v]]\n            e.cap -= flow\n            g[v][e.rev].cap += flow\n            v = prevv[v]\n        \n        total_cost += dist[T] * flow\n    \n    print(total_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00024625606602057815, -1.4305104514278355e-06, -1.1920928244535389e-07, -0.014181196689605713, -0.0004462200158741325, -5.960462772236497e-07, -0.0028080816846340895, -0.0003491030656732619, -9.536738616588991e-07, -0.00248231110163033, -0.31818684935569763, -0.5959135293960571, -2.5629668016335927e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.1426755040884018, -4.303362584323622e-05, -3.3378546504536644e-06, -0.00015615197480656207, -0.0003812778159044683, 0.0, -4.768370445162873e-07, 0.0, -1.9073468138230965e-06, 0.0, 0.0, -7.986990567587782e-06, -4.172316494077677e-06, 0.0, -8.344646857949556e-07, -1.3470558769768104e-05, -5.2689116273541003e-05, -1.1920928244535389e-07, -2.145764938177308e-06, -4.410734163684538e-06, -2.3841855067985307e-07, -3.099436753473128e-06, 0.0, -4.0531076592742465e-06, -0.0006550788530148566, -1.2040065485052764e-05, 0.0, -3.2186455882765586e