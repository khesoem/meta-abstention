n        if (n & (1 << i)) {\n            list_vec.push_back(i);\n        }\n    }\n    \n    dp[0][0] = 1;\n    \n    for (int i = 0; i <= n; i++) {\n        int cnt = 0;\n        int x = i;\n        while (x) {\n            cnt++;\n            x &= x - 1;\n        }\n        len[i] = cnt;\n    }\n    \n    for (int i = n; ; i = (i - 1) & n) {\n        vis[i] = true;\n        if (i == 0) break;\n    }\n    \n    for (int mask = 1; mask <= n; mask++) {\n        if (!vis[mask]) continue;\n        for (int sub = mask; sub; sub = (sub - 1) & mask) {\n            int l = min(k, len[mask - sub] + 1);\n            for (int s = 1; s <= l; s++) {\n                if (dp[s - 1][mask - sub]) {\n                    dp[s][mask] = (dp[s][mask] + 1LL * dp[s - 1][mask - sub] * inv[sub]) % mod;\n                }\n            }\n        }\n    }\n    \n    int ans = 0;\n    for (int i = 0; i <= min(k, len[n]); i++) {\n        if (dp[i][n]) {\n            long long tmp = 1LL * dp[i][n] * fac[k] % mod;\n            tmp = tmp * inv[k - i] % mod;\n            tmp = tmp * inv[i] % mod;\n            tmp = tmp * fac[n] % mod;\n            ans = (ans + tmp) % mod;\n        }\n    }\n    \n    printf(\"%d\\n\", (binpow(k, n, mod) - ans + mod) % mod);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef binpow(base, exp, mod):\n    res = 1\n    base %= mod\n    while exp > 0:\n        if exp & 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n    \n    if n % 2:\n        print(binpow(k, n, mod))\n        return\n    \n    fac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    len_arr = [0] * (n + 1)\n    vis = [False] * (1 << n)\n    dp = [[0] * (1 << n) for _ in range(