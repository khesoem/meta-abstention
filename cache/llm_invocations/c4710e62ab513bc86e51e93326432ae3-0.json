s\n\nDEBUG = True\nname = \"I\"\n\nclass FastScanner:\n    def __init__(self, source):\n        if isinstance(source, str):\n            self.dis = open(source, 'rb')\n        else:\n            self.dis = os.fdopen(source.fileno(), 'rb')\n        self.buffer = bytearray(1 << 17)\n        self.pointer = 0\n        self.buffer_size = 0\n        self._fill_buffer()\n\n    def _fill_buffer(self):\n        self.buffer_size = self.dis.readinto(self.buffer)\n        self.pointer = 0\n\n    def next_byte(self):\n        if self.pointer == self.buffer_size:\n            self._fill_buffer()\n            if self.buffer_size == 0:\n                raise EOFError(\"End of file reached\")\n        byte = self.buffer[self.pointer]\n        self.pointer += 1\n        return byte\n\n    def next_int(self):\n        ret = 0\n        b = self.next_byte()\n        while b <= ord(' '):\n            b = self.next_byte()\n        negative = False\n        if b == ord('-'):\n            negative = True\n            b = self.next_byte()\n        while ord('0') <= b <= ord('9'):\n            ret = 10 * ret + (b - ord('0'))\n            b = self.next_byte()\n        return -ret if negative else ret\n\n    def next_long(self):\n        ret = 0\n        b = self.next_byte()\n        while b <= ord(' '):\n            b = self.next_byte()\n        negative = False\n        if b == ord('-'):\n            negative = True\n            b = self.next_byte()\n        while ord('0') <= b <= ord('9'):\n            ret = 10 * ret + (b - ord('0'))\n            b = self.next_byte()\n        return -ret if negative else ret\n\n    def next_string(self):\n        ret = []\n        b = self.next_byte()\n        while b <= ord(' '):\n            b = self.next_byte()\n        while b > ord(' '):\n            ret.append(chr(b))\n            b = self.next_byte()\n        return ''.join(ret)\n\nclass BIT:\n    def __init__(self, length):\n        self.tree = [0] * (length + 5)\n\n    def update(self, index, val):\n        index += 1\n        while index < len(self.tree):\n            self.tree[index] ^= val\n            index += index & -index\n\n    def query(self, index):\n        result = 0\n        index += 1\n        while index > 0:\n            result ^= self.tree[index]\n            index -= index & -index\n        return result\n\n    def range_sum(self, low, high):\n        if low == 0:\n            return self.query(high)\n        return self.query(high) ^ self.query(low - 1)\n\ndef log2(n):\n    return math.ceil(math.log2(n)) if n > 0 else 0\n\ndef preprocess(root, adjList):\n    ct = 0\n    n = len(adjList)\n    tin = [0] * n\n    tout = [0] * n\n    BL = [[0] * (log2(n) + 1) for _ in range(n)]\n\n    def recur_bl(v, p):\n        nonlocal ct\n        ct += 1\n        tin[v] = ct\n        BL[v][0] = p\n        for i in range(1, log2(n) + 1):\n            BL[v][i] = BL[BL[v][i-1]][i-1]\n        for neighbor in adjList[v]:\n            if neighbor != p:\n                recur_bl(neighbor, v)\n        ct += 1\n        tout[v] = ct\n\n    recur_bl(root, root)\n    return tin, tout, BL\n\ndef is_ancestor(u, v, tin, tout):\n    return tin[u] <= tin[v] and tout[u] >= tout[v]\n\ndef lca(u, v, adjList, tin, tout):\n    if is_ancestor(u, v, tin, tout):\n        return u\n    if is_ancestor(v, u, tin, tout):\n        return v\n    n = len(adjList)\n    for i in range(log2(n), -1, -1):\n        if not is_ancestor(BL[u][i], v, tin, tout):\n            u = BL[u][i]\n    return BL[u][0]\n\ndef main():\n    scan = None\n    out = None\n    if DEBUG:\n        scan = FastScanner(sys.stdin)\n        out = sys.stdout\n    else:\n        scan = FastScanner(name + \".in\")\n        out = open(name + \".out\", 'w')\n\n    N = float(scan.next_string())\n    P = float(scan.next_string())\n\n    for i in range(int(N) + 1):\n        val = i * (i - 1) * (i - 2) / 6.0\n        val += i * (i - 1) * (N - i) / 2.0\n        val += i * (N - i) * (N - i - 1) / 4.0\n        val /= (N * (N - 1) * (N - 2) / 6.0)\n\n        if val >= P:\n            out.write(str(i) + '\\n')\n            break\n\n    if not DEBUG:\n        out.close()\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001821352052502334, -5.960462772236497e-07, -7.152555099310121e-07, -0.00037877538125030696, -0.012295284308493137, -3.6000557884108275e-05, -1.5258672647178173e-05, -0.00048530244384892285, -0.3868729770183563, -0.2521285116672516, -0.045216888189315796, -0.006754186935722828, -0.45084866881370544, -1.0728830375228426e-06, -0.006592193618416786, -1.1920928244535389e-07, -1.4662635294371285e-05, -1.311301275563892e-06, 0.0, -2.622600959512056e-06, -0.020572848618030548, -0.04329151660203934, -0.011331133544445038, -1.8596476365928538e-05, -4.172316494077677e-06, -2.3841855067985307e-07, -9.536738616588991e-07, -2.1219027985353023e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -5.960462772236497e-07, -0.03696059808135033, -1.3112935448589269e-05, -1.9073468138230965e-06, -0.003182824235409498, -1.0132738680113107e-05, -1.4305104514278355e-06, -2.3841855067985307e-07, -0.001753103919327259, -6.437280717364047e-06, -5.960462772236497e-07, -4.172316494077677e-06, -0.16824853420257568, -1.4305104514278355e-06, -2.90866428258596e-05, -4.0531076592742465e-06, -1.1920928244535389e-07, -8.487341256113723e-05, -4.8993817472364753e-05, -0.00016318420239258558, -0.0024758896324783564, -5.364403477869928e-06, -2.3841855067985307e-07, -2.145764938177308e-06, -7.152531907195225e-06, -0.0002623452164698392, -1.1920928244535389e-07, -0.4573137164115906, -0.008568782359361649, -0.00025900822947733104, -0.031049862504005432, -0.00013743886665906757, -1.4305104514278355e-06, -6.198863957251888e-06, 0.0, -4.768370445162873e-07, -0.6329950094223022, -0.002007613657042384, -3.2186455882765586e-06, -9.298280929215252e-06, -5.590759246842936e-05, -0.020571796223521233, -1.9550132492440753e-05, 0.0, -7.15