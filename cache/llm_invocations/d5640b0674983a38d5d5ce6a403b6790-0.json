_num = 1;\n        best_den = 1;\n    }\n    \n    int g = gcd(best_num, best_den);\n    printf(\"%d/%d\\n\", best_num / g, best_den / g);\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef gcd(a, b):\n    a = abs(a)\n    b = abs(b)\n    while b:\n        r = a % b\n        a = b\n        b = r\n    return a\n\ndef main():\n    x, y, L = map(int, input().split())\n    \n    target = x / y\n    best_num = 0\n    best_den = 1\n    best_err = 1e10\n    \n    for d in range(1, L + 1):\n        num_val = x * d\n        base = num_val // y\n        \n        for offset in range(-1, 2):\n            num = base + offset\n            if num < 0:\n                continue\n            \n            val = num / d\n            err = abs(target - val)\n            \n            if err < best_err or (abs(err - best_err) < 1e-9 and num * best_den < best_num * d):\n                best_err = err\n                best_num = num\n                best_den = d\n    \n    if abs(1.0 - target) <= best_err + 1e-9:\n        best_num = 1\n        best_den = 1\n    \n    g = gcd(best_num, best_den)\n    print(f\"{best_num // g}/{best_den // g}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011419598013162613, -8.344646857949556e-07, -1.1920928244535389e-07, -0.0009908534120768309, -0.001975610153749585, -0.14270630478858948, -3.933898824470816e-06, -4.589452510117553e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -0.0007150000892579556, -8.34461570775602e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -4.2914423829643056e-05, -1.1920928244535389e-07, -3.576278118089249e-07, -3.576278118089249e-07, -2.0146166207268834e-05, -3.6954811548639555e-06, -0.00015686711412854493, -4.768370445162873e-07, -9.536738616588991e-07, -4.