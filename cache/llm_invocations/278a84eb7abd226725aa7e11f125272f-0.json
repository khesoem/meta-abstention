int d = (depth == 0 ? 1 : 0); d <= 9; d++) search(depth + 1, val * 10 + d);\n}\nint main() {\n    scanf(\"%lld\", &n), build(0, 0);\n    for (int i = 0; i <= 6; i++) {\n        sort(lists[i].begin(), lists[i].end());\n        for (int j = 0; j < (int)lists[i].size(); j++) sum[i] += lists[i][j];\n    }\n    counter = 0, search(0, 0), printf(\"%d\\n\", result);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int P = 998244353;\n    static final int MOD = 1000000007;\n    static final int B = 1000000;\n    \n    static long n;\n    static long counter;\n    static long[] sum = new long[7];\n    static int result;\n    static ArrayList<Integer>[] lists = new ArrayList[7];\n    \n    static int modPositive(long d) {\n        return (int)((d % P + P) % P);\n    }\n    \n    static void build(int depth, long val) {\n        counter++;\n        lists[depth].add(modPositive(counter - val));\n        if (depth < 6) {\n            for (int d = 0; d <= 9; d++) {\n                build(depth + 1, val * 10 + d);\n            }\n        }\n    }\n    \n    static int compute(int idx, int f) {\n        // lower_bound: first index where lists[idx].get(i) >= P - f\n        int pos = lowerBound(lists[idx], P - f);\n        long res = (long)f * lists[idx].size() + sum[idx] - (long)P * (lists[idx].size() - pos);\n        return (int)(res % MOD);\n    }\n    \n    static int lowerBound(ArrayList<Integer> list, int key) {\n        int lo = 0, hi = list.size();\n        while (lo < hi) {\n            int mid = (lo + hi) / 2;\n            if (list.get(mid) < key) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        return lo;\n    }\n    \n    static void search(int depth, long val) {\n        if (val > n) return;\n        if (depth