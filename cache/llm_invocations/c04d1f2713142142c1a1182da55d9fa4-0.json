{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAX_NODES = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, edge_count, total_cost, arrival_times[6010], from_node[6010], to_node[6010];\nint head[6010], prev_edge[6010], dist[6010], in_queue[6010];\nqueue<int> q;\nstruct Edge { int dest, capacity, weight, next; } edges[2000010];\n\nint encode(int time, int vertex) { return time * n + vertex; }\n\nvoid insert_edge(int src, int dst, int cap, int cost) {\n    edges[edge_count] = {dst, cap, cost, head[src]};\n    head[src] = edge_count++;\n    edges[edge_count] = {src, 0, -cost, head[dst]};\n    head[dst] = edge_count++;\n}\n\nbool find_shortest_path(int source, int sink) {\n    fill(dist, dist + MAX_NODES, INF);\n    q.push(source);\n    dist[source] = 0;\n    while (!q.empty()) {\n        int cur = q.front(); q.pop();\n        in_queue[cur] = 0;\n        for (int idx = head[cur]; ~idx; idx = edges[idx].next) {\n            int v = edges[idx].dest;\n            if (edges[idx].capacity && dist[v] > dist[cur] + edges[idx].weight) {\n                dist[v] = dist[cur] + edges[idx].weight;\n                prev_edge[v] = idx;\n                if (!in_queue[v]) {\n                    q.push(v);\n                    in_queue[v] = 1;\n                }\n            }\n        }\n    }\n    return dist[sink] < 1000000000;\n}\n\nvoid augment_path(int source, int sink) {\n    for (int node = sink; node != source; node = edges[prev_edge[node] ^ 1].dest) {\n        edges[prev_edge[node]].capacity--;\n        edges[prev_edge[node] ^ 1].capacity++;\n    }\n    total_cost += dist[sink];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int source = 0, sink = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &arrival_times[i]);\n        insert_edge(source, encode(0, arrival_times[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &from_node[i], &to_node[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            insert_edge(encode(t, i), encode(t + 1, i), k, c);\n        }\n        insert_edge(encode(t, 1), sink, k, 0);\n        for (int i = 1; i <= m; i++) {\n            for (int j = 1; j <= min(k, 25); j++) {\n                insert_edge(encode(t, from_node[i]), encode(t + 1, to_node[i]), 1, c + (2 * j - 1) * d);\n                insert_edge(encode(t, to_node[i]), encode(t + 1, from_node[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (find_shortest_path(source, sink)) augment_path(source, sink);\n    printf(\"%d\\n\", total_cost);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAX_NODES = 6010\nINF = 0x3f3f3f3f\n\ndef main():\n    global n, m, k, c, d, edge_count, total_cost, arrival_times, from_node, to_node\n    global head, prev_edge, dist, in_queue, edges, q\n    \n    n, m, k, c, d = map(int, sys.stdin.readline().split())\n    \n    edge_count = 0\n    total_cost = 0\n    arrival_times = [0] * (k + 1)\n    from_node = [0] * (m + 1)\n    to_node = [0] * (m + 1)\n    \n    head = [-1] * MAX_NODES\n    prev_edge = [0] * MAX_NODES\n    dist = [INF] * MAX_NODES\n    in_queue = [0] * MAX_NODES\n    q = deque()\n    \n    # Edge structure: (dest, capacity, weight, next)\n    edges = [(0, 0, 0, 0)] * 2000010\n    \n    def encode(time, vertex):\n        return time * n + vertex\n    \n    def insert_edge(src, dst, cap, cost):\n        global edge_count\n        edges[edge_count] = (dst, cap, cost, head[src])\n        head[src] = edge_count\n        edge_count += 1\n        edges[edge_count] = (src, 0, -cost, head[dst])\n        head[dst] = edge_count\n        edge_count += 1\n    \n    def find_shortest_path(source, sink):\n        for i in range(MAX_NODES):\n            dist[i] = INF\n        q.append(source)\n        dist[source] = 0\n        while q:\n            cur = q.popleft()\n            in_queue[cur] = 0\n            idx = head[cur]\n            while idx != -1:\n                v = edges[idx][0]\n                if edges[idx][1] > 0 and dist[v] > dist[cur] + edges[idx][2]:\n                    dist[v] = dist[cur] + edges[idx][2]\n                    prev_edge[v] = idx\n                    if not in_queue[v]:\n                        q.append(v)\n                        in_queue[v] = 1\n                idx = edges[idx][3]\n        return dist[sink] < 1000000000\n    \n    def augment_path(source, sink):\n        nonlocal total_cost\n        node = sink\n        while node != source:\n            edge_idx = prev_edge[node]\n            # Update capacity\n            edges[edge_idx] = (edges[edge_idx][0], edges[edge_idx][1] - 1, edges[edge_idx][2], edges[edge_idx][3])\n            edges[edge_idx ^ 1] = (edges[edge_idx ^ 1][0], edges[edge_idx ^ 1][1] + 1, edges[edge_idx ^ 1][2], edges[edge_idx ^ 1][3])\n            node = edges[edge_idx ^ 1][0]\n        total_cost +=