ws = rows\n        self.cols = cols\n        self.data = [[init_val] * cols for _ in range(rows)]\n\n    def init(self):\n        for i in range(self.rows):\n            for j in range(self.cols):\n                self.data[i][j] = 0\n\n    def iden(self):\n        self.init()\n        for i in range(min(self.rows, self.cols)):\n            self.data[i][i] = 1\n\n    def transpose(self):\n        out = Matrix(self.cols, self.rows)\n        for i in range(self.rows):\n            for j in range(self.cols):\n                out.data[j][i] = self.data[i][j]\n        return out\n\n    def __getitem__(self, i):\n        return self.data[i]\n\n    def __setitem__(self, i, val):\n        self.data[i] = val\n\n    def __add__(self, other):\n        out = Matrix(self.rows, self.cols)\n        for i in range(self.rows):\n            for j in range(self.cols):\n                out.data[i][j] = add(self.data[i][j], other.data[i][j])\n        return out\n\n    def __mul__(self, other):\n        if isinstance(other, int):\n            out = Matrix(self.rows, self.cols)\n            for i in range(self.rows):\n                for j in range(self.cols):\n                    out.data[i][j] = mult(self.data[i][j], other)\n            return out\n        elif isinstance(other, Matrix):\n            N = self.rows\n            X = self.cols\n            M = other.cols\n            if X != other.rows:\n                raise ValueError(\"Incompatible dimensions\")\n            out = Matrix(N, M)\n            for i in range(N):\n                for j in range(X):\n                    if self.data[i][j]:\n                        aik = self.data[i][j]\n                        for k in range(M):\n                            out.data[i][k] = add(out.data[i][k], mult(aik, other.data[j][k]))\n            return out\n        else:\n            raise TypeError(\"Unsupported type\")\n\n    def __rmul__(self, other):\n        if isinstance(other, int):\n            return self.__mul__(other)\n        else:\n            raise TypeError\n\ndef main():\n    import sys\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    K = int(data[1])\n\n    # Initialize A[0]\n    A = []\n    A0 = [None] * K\n    for i in range(K):\n        mat = Matrix(35, 35)\n        mat.iden()\n        for j in range(K + 1):\n            mat[i][j] = 1\n        A0[i] = mat\n    A.append(A0)\n\n    # Build higher levels\n    len_val = K\n    i = 1\n    while len_val <= n:\n        # Compute S_prev and P_prev for index i-1\n        S_prev = [None] * K\n        P_prev = [None] * K\n        S_prev[K-1] = A[i-1][K-1]\n        for j in range(K-2, -1, -1):\n            S_prev[j] = A[i-1][j] * S_prev[j+1]\n        P_prev[0] = A[i-1][0]\n        for j in range(1, K):\n            P_prev[j] = P_prev[j-1] * A[i-1][j]\n        # Compute A[i]\n        A_i = [None] * K\n        A_i[0] = S_prev[0]\n        for j in range(1, K):\n            A_i[j] = S_prev[j] * P_prev[j-1]\n        A.append(A_i)\n        len_val *= K\n        i += 1\n\n    # Extract digits in base K\n    digit = []\n    temp_n = n\n    while temp_n:\n        digit.append(temp_n % K)\n        temp_n //= K\n    # digit is least significant first\n\n    ans = Matrix(35, 35)\n    ans.iden()\n    s = 0\n    for idx in range(len(digit)-1, -1, -1):\n        d = digit[idx]\n        for j in range(d):\n            ans = ans * A[idx][(j + s) % K]\n        s = (s + d) % K\n\n    res = 1\n    for i in range(K):\n        res = add(res, ans[i][K])\n    print(res)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.768370445162873e-07, 0.0, -2.3841855067985307e-07, -0.00019488819816615433, -0.7023547291755676, -0.0015024575404822826, 0.0, -2.7418097943154862e-06, 0.0, -1.1920928244535389e-07, 0.0, -0.00016962042718660086, -1.9073468138230965e-06, -3.933898824470816e-06, -3.2186455882765586e-06, -0.0038874782621860504, 0.0, -1.072883