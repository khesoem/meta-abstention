{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cstring>\n#include <ctime>\n#include <cassert>\n#include <cmath>\n#include <algorithm>\n\nusing namespace std;\n\nusing i64 = long long;\nusing u64 = unsigned long long;\nusing f64 = long double;\nusing vi = vector<int>;\nusing vvi = vector<vi>;\n\n#define FOR(i, a, b) for (int i = (a); i < (b); ++i)\n#define FORR(i, a, b) for (int i = (b) - 1; i >= (a); --i)\n#define SIZE(c) ((int)(c).size())\n#define ALL(c) (c).begin(), (c).end()\n#define MP make_pair\n#define EB emplace_back\n\nvoid solve(int n) {\n    int k;\n    cin >> k;\n\n    using T = double;\n    vector<T> p(n);\n    for (int i = 0; i < n; ++i)\n        cin >> p[i];\n\n    T dp[2][1 << n];\n    memset(dp, 0, sizeof(dp));\n\n    vector<char> good(n, 0);\n    vi idxs;\n    FOR(i, 0, n) {\n        if (p[i] != 0) {\n            good[i] = 1;\n            idxs.EB(i);\n        }\n    }\n\n    dp[0][0] = 1.0;\n    int cur = 1;\n\n    vector<T> pref(1 << n, 0.0);\n    pref[0] = 1.0;\n    FOR(mask, 1, 1 << n) {\n        int lsb = mask & -mask;\n        int bit = __builtin_ctz(lsb);\n        pref[mask] = pref[mask ^ (1 << bit)] - p[bit];\n    }\n\n    int steps = min(SIZE(idxs), k);\n    FOR(step, 0, steps) {\n        memset(dp[cur], 0, sizeof(dp[cur]));\n\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            if (__builtin_popcount(mask) != step) continue;\n\n            for (int j : idxs) {\n                if (mask & (1 << j)) continue;\n                dp[cur][mask ^ (1 << j)] += dp[cur ^ 1][mask] * p[j] / pref[mask];\n            }\n        }\n\n        cur ^= 1;\n    }\n\n    cur ^= 1;\n    FOR(i, 0, n) {\n        if (!good[i]) {\n            printf(\"%.12f\\n\", 0.0);\n        } else {\n            T val = 0.0;\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (mask & (1 << i))\n                    val += dp[cur][mask];\n            }\n            printf(\"%.12f\\n\", (double)val);\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n#ifndef ONLINE_JUDGE\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n\n    int n;\n    while (cin >> n)\n        solve(n);\n\n#ifdef LOCAL\n    cerr << \"Time: \" << (double)clock() / CLOCKS_PER_SEC << endl;\n#endif\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        while (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            solve(n, sc);\n        }\n    }\n\n    static void solve(int n, Scanner sc) {\n        int k = sc.nextInt();\n        double[] p = new double[n];\n        for (int i = 0; i < n; ++i) {\n            p[i] = sc.nextDouble();\n        }\n\n        double[][] dp = new double[2][1 << n];\n        for (int i = 0; i < 2; ++i) {\n            Arrays.fill(dp[i], 0.0);\n        }\n\n        boolean[] good = new boolean[n];\n        List<Integer> idxs = new ArrayList<>();\n        for (int i = 0; i < n; ++i) {\n            if (p[i] != 0) {\n                good[i] = true;\n                idxs.add(i);\n            }\n        }\n\n        dp[0][0] = 1.0;\n        int cur = 1;\n\n        double[] pref = new double[1 << n];\n        pref[0] = 1.0;\n        for (int mask = 1; mask < (1 << n); ++mask) {\n            int lsb = mask & -mask;\n            int bit = Integer.numberOfTrailingZeros(lsb);\n            pref[mask] = pref[mask ^ (1 << bit)] - p[bit];\n        }\n\n        int steps = Math.min(idxs.size(), k);\n        for (int step = 0; step < steps; ++step) {\n            Arrays.fill(dp[cur], 0.0);\n\n            for (int mask = 0; mask < (1 << n); ++mask) {\n                if (Integer.bitCount(mask) != step) continue;\n\n                for (int j : idxs) {\n                    if ((mask & (1 << j)) != 0) continue;\n                    dp[cur][mask ^ (1 << j)] += dp[cur ^ 1][mask] * p[j] / pref[mask];\n                }\n            }\n\n            cur ^= 1;\n        }\n\n        cur ^= 1;\n        for (int i = 0; i < n; ++i) {\n            if (!good[i]) {\n                System.out.printf(\"%.12f\\n\", 0.0);\n            } else {\n                double val = 0.0;\n                for (int mask = 0; mask < (1 << n); ++mask) {\n                    if ((mask & (1 << i)) != 0)\n                        val += dp[cur][mask];\n                }\n                System.out.printf(\"%.12f\\n\", val);\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013159839727450162, -2.3841830625315197e-06, -4.768370445162873e-07, -0.0007740838918834925, -3.361645576660521e-05, -0.6327097415924072, -0.08896606415510178, -1.5616295058862306e-05, -2.884823152271565e-05, -0.0008386432309634984, -0.00982697308063507, -5.9960475482512265e-05, -7.152555099310121e-07, -9.15485