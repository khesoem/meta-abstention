d\n        k >>= 1\n    return res\n\ndef main():\n    # Precompute factorials and combinations\n    f = [1] * 51\n    for i in range(1, 51):\n        f[i] = (f[i-1] * i) % mod\n    \n    c = [[0] * 51 for _ in range(51)]\n    for i in range(51):\n        c[i][0] = 1\n    for i in range(1, 51):\n        for j in range(1, i+1):\n            c[i][j] = (f[i] * inv((f[j] * f[i-j]) % mod)) % mod\n\n    # Read input\n    data = sys.stdin.read().split()\n    idx = 0\n    n = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    \n    c50 = 0\n    c100 = 0\n    for _ in range(n):\n        val = int(data[idx]); idx += 1\n        if val == 100:\n            c100 += 1\n        else:\n            c50 += 1\n\n    # Create nodes\n    class Node:\n        def __init__(self, x, y, z):\n            self.c50 = x\n            self.c100 = y\n            self.b = z\n            self.s = []\n            self.n = 0\n            self.am = 0\n\n    ns = [[[None for _ in range(2)] for _ in range(c100 + 1)] for _ in range(c50 + 1)]\n    for i in range(c50 + 1):\n        for j in range(c100 + 1):\n            ns[i][j][0] = Node(i, j, 0)\n            ns[i][j][1] = Node(i, j, 1)\n\n    # Build graph\n    for i in range(c50 + 1):\n        for j in range(c100 + 1):\n            p50c = min(k // 50, i)\n            p100c = min(k // 100, j)\n            for x in range(p100c, -1, -1):\n                for y in range(min(p50c, (k - 100 * x) // 50), -1, -1):\n                    if y == 0 and x == 0:\n                        continue\n                    ns[i][j][0].s.append(ns[i - y][j - x][1])\n                    ns[i - y][j - x][1].s.append(ns[i][j][0])\n\n    # BFS with DP\n    q = deque()\n    ns[c50][c100][0].n = 1\n    ns[c50][c100][0].am = 1\n    q.append(ns[c50][c100][0])\n    \n    while q:\n        cur = q.popleft()\n        for ch in cur.s:\n            if ch.n == 0 or ch.n == cur.n + 1:\n                p1 = c[cur.b == 0 and cur.c50 or c50 - cur.c50][abs(cur.c50 - ch.c50)]\n     