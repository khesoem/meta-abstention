         int u = q.front();\n            q.pop();\n            inQueue[u] = false;\n\n            for (int id : adj[u]) {\n                Arc &e = edges[id];\n                if (e.cap > e.flow && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prev[e.to] = id;\n                    possible[e.to] = min(possible[u], e.cap - e.flow);\n                    if (!inQueue[e.to]) {\n                        q.push(e.to);\n                        inQueue[e.to] = true;\n                    }\n                }\n            }\n        }\n\n        if (dist[T] == INF) return false;\n\n        augFlow = possible[T];\n        pathCost = dist[T];\n\n        for (int v = T; v != S; v = edges[prev[v]].from) {\n            edges[prev[v]].flow += possible[T];\n            edges[prev[v] ^ 1].flow -= possible[T];\n        }\n        return true;\n    }\n\n    pair<CostType, CostType> minCost(int s, int t) {\n        S = s;\n        T = t;\n        CostType totalCost = 0;\n        CostType totalFlow = 0;\n        CostType f = 0, c = 0;\n\n        while (shortestPath(f, c)) {\n            totalFlow += f;\n            totalCost += f * c;\n        }\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MinCostFlow solver(n * TIME + 2);\n    int src = n * TIME;\n    int snk = src + 1;\n\n    for (int t = 0; t < TIME; ++t) {\n        solver.addEdge(t, snk, k, C * t);\n    }\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        solver.addEdge(src, x * TIME, 1, 0);\n    }\n\n    for (int city = 0; city < n; ++city) {\n        for (int t = 1; t < TIME; ++t) {\n            solver.addEdge(city * TIME + t - 1, city * TIME + t, k, 0);\n        }\n    }\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n\n        for (int t = 1; t < TI