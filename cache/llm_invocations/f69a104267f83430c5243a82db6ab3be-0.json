     in_queue[e['to']] = True\n\n        if dist[t] == INF:\n            return False, 0, 0\n\n        aug_flow = possible[t]\n        path_cost = dist[t]\n\n        v = t\n        while v != s:\n            eid = prev[v]\n            self.edges[eid]['flow'] += aug_flow\n            self.edges[eid ^ 1]['flow'] -= aug_flow\n            v = self.edges[eid]['from']\n\n        return True, aug_flow, path_cost\n\n    def min_cost(self, s, t):\n        total_flow = 0\n        total_cost = 0\n        while True:\n            found, f, c = self.shortest_path(s, t)\n            if not found:\n                break\n            total_flow += f\n            total_cost += f * c\n        return total_flow, total_cost\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    solver = MinCostFlow(n * TIME + 2)\n    src = n * TIME\n    snk = src + 1\n\n    for t in range(TIME):\n        solver.add_edge(t, snk, k, C * t)\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        solver.add_edge(src, x * TIME, 1, 0)\n\n    for city in range(n):\n        for t in range(1, TIME):\n            solver.add_edge(city * TIME + t - 1, city * TIME + t, k, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for t in range(1, TIME):\n            a = u * TIME + t - 1\n            b = v * TIME + t\n            c = v * TIME + t - 1\n            d = u * TIME + t\n            cost = D\n            for i in range(1, k + 1):\n                solver.add_edge(a, b, 1, cost)\n                solver.add_edge(c, d, 1, cost)\n                cost += 2 * D\n\n    ans = solver.min_cost(src, snk)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.298280929215252e-06, 0.0, 0.0, -0.00033623288