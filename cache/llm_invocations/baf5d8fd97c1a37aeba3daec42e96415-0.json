ble>(x * b - a * y) / (y * b));\n        if (diff2 < minDiff) {\n            minDiff = diff2;\n            bestA = a;\n            bestB = b;\n        }\n        \n        double diff3 = std::abs(static_cast<double>(x * b - (a + 1) * y) / (y * b));\n        if (diff3 < minDiff) {\n            minDiff = diff3;\n            bestA = a + 1;\n            bestB = b;\n        }\n    }\n    \n    std::cout << bestA << \"/\" << bestB << std::endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        \n        double minDiff = Double.MAX_VALUE;\n        long bestA = 0;\n        long bestB = 0;\n        \n        for (long b = 1; b <= n; ++b) {\n            long a = (x * b) / y;\n            \n            // Check exact matches first\n            if (a > 0 && x * b == (a - 1) * y) {\n                System.out.println((a - 1) + \"/\" + b);\n                return;\n            }\n            if (x * b == a * y) {\n                System.out.println(a + \"/\" + b);\n                return;\n            }\n            if (x * b == (a + 1) * y) {\n                System.out.println((a + 1) + \"/\" + b);\n                return;\n            }\n            \n            // Update best approximation\n            if (a > 0) {\n                double diff1 = Math.abs((double)(x * b - (a - 1) * y) / (y * b));\n                if (diff1 < minDiff) {\n                    minDiff = diff1;\n                    bestA = a - 1;\n                    bestB = b;\n                }\n            }\n            \n            double diff2 = Math.abs((double)(x * b - a * y) / (y * b));\n            if (diff2 <