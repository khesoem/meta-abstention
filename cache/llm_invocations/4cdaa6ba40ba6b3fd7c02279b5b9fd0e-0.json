en/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    budget = int(data[1])\n    arr = [int(data[i + 2]) for i in range(n)]\n    \n    evens = 0\n    odds = 0\n    diffs = []\n    \n    for i in range(n):\n        if arr[i] % 2 == 0:\n            evens += 1\n        else:\n            odds += 1\n            \n        if evens == odds and i < n - 1:\n            diff = abs(arr[i + 1] - arr[i])\n            heapq.heappush(diffs, diff)\n    \n    count = 0\n    spent = 0\n    \n    while diffs and spent + diffs[0] <= budget:\n        spent += heapq.heappop(diffs)\n        count += 1\n        \n    print(count)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.0424259825376794e-05, -1.1920922133867862e-06, -2.3841855067985307e-07, -7.271740287251305e-06, -0.08357623964548111, -0.5759418606758118, -0.00047338721924461424, -3.790783375734463e-05, -1.0728830375228426e-06, -1.1086402082582936e-05, -0.000476246903417632, -1.3589766240329482e-05, -2.145764938177308e-06, -0.6978361010551453, -6.794906312279636e-06, -0.011206894181668758, -6.318072337307967e-06, -4.458328112377785e-05, -1.4662635294371285e-05, -0.00012742661056108773, -1.4662635294371285e-05, -1.4305104514278355e-06, -0.1154501736164093, 0.0, -1.5497195136049413e-06, -9.536738616588991e-07, -1.1920928244535389e-07, 0.0, -1.1324817933200393e-05, 0.0, -2.0265558760002023e-06, -8.344646857949556e-07, -3.933898824470816e-06, -1.966933996300213e-05, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920922133867862e-06, -0.005235058255493641, -1.6689286894688848e-06, 0.0, -0.10695134848356247, -5.221230458118953e-05, -0.0024801704566925764, -0.016035521402955055, -0.6211503744125366, 0.0, -5.960462772236497e-07, -2.3841855067985307e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3