             rev[1] += d\n                v = self.prevv[v]\n        return res\n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    a = [0] * k\n    cnt = [0] * n\n    for i in range(k):\n        a[i] = int(next(it))\n        cnt[a[i] - 1] += 1\n    e = [[] for _ in range(n)]\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        e[x].append(y)\n        e[y].append(x)\n    T = 100\n    V = n * T + 2\n    S = n * T\n    T_node = n * T + 1\n    mcf = MinCostFlow(V)\n    for i in range(n):\n        if cnt[i] > 0:\n            mcf.add_edge(S, i, cnt[i], 0)\n    for i in range(T):\n        mcf.add_edge(i * n, T_node, k, c * i)\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(j * n + i, (j + 1) * n + i, k, 0)\n    for i in range(n):\n        for to in e[i]:\n            for j in range(T - 1):\n                for u in range(k):\n                    cost = (u + 1) * (u + 1) * d - u * u * d\n                    mcf.add_edge(j * n + i, (j + 1) * n + to, 1, cost)\n    ans = mcf.min_cost_flow(S, T_node, k)\n    print(ans)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.539125671319198e-05, 0.0, -1.1920928244535389e-07, -0.0005787128466181457, -0.0009259465732611716, -2.1457441107486375e-05, -0.004082797560840845, -3.6238969187252223e-05, -3.58813522325363e-05, -0.023525051772594452, -0.010537461377680302, -0.0012469858629629016, -1.1920922133867862e-06, -2.3841855067985307e-07, -4.291525328881107e-06, -2.0265558760002023e-06, -0.0002942844294011593, -0.0011711412807926536, -1.1920928244535389e-07, -3.814689989667386e-06, 0.0, -0.5759601593017578, -0.038764022290706635, -0.0006493605324067175, -1.1920928244535389e-07, -3.85038583772257e-05, -0.00162909773644