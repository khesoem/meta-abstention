{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\nconst int inf = 0x3f3f3f3f;\nconst int MAXN = 10000;\nconst int MAXM = 3000000;\n\nint h[MAXN], eTo[MAXM], eCap[MAXM], eCost[MAXM], eNext[MAXM];\nint d[MAXN], inQue[MAXN], from[MAXN], edgeIdx[MAXN];\nint src, sink, edgeCnt;\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    eTo[edgeCnt] = v; eCap[edgeCnt] = cap; eCost[edgeCnt] = cost; eNext[edgeCnt] = h[u]; h[u] = edgeCnt++;\n    eTo[edgeCnt] = u; eCap[edgeCnt] = 0; eCost[edgeCnt] = -cost; eNext[edgeCnt] = h[v]; h[v] = edgeCnt++;\n}\n\nint spfa() {\n    queue<int> q;\n    memset(d, inf, sizeof(d));\n    memset(inQue, 0, sizeof(inQue));\n    memset(from, -1, sizeof(from));\n    d[src] = 0;\n    q.push(src);\n    inQue[src] = 1;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inQue[u] = 0;\n        for (int i = h[u]; i != -1; i = eNext[i]) {\n            int v = eTo[i];\n            if (eCap[i] > 0 && d[v] > d[u] + eCost[i]) {\n                d[v] = d[u] + eCost[i];\n                from[v] = u;\n                edgeIdx[v] = i;\n                if (!inQue[v]) {\n                    inQue[v] = 1;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return d[sink] < inf;\n}\n\nint minCostMaxFlow() {\n    int total = 0;\n    while (spfa()) {\n        int add = inf;\n        for (int v = sink; v != src; v = from[v])\n            add = min(add, eCap[edgeIdx[v]]);\n        for (int v = sink; v != src; v = from[v]) {\n            int e = edgeIdx[v];\n            eCap[e] -= add;\n            eCap[e ^ 1] += add;\n        }\n        total += d[sink] * add;\n    }\n    return total;\n}\n\nint main() {\n    memset(h, -1, sizeof(h));\n    int n, m, k, C, D;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &C, &D);\n    src = 0;\n    sink = n * 100 + 1;\n    auto nodeId = [](int v, int tm) { return (v - 1) * 100 + tm; };\n    for (int tm = 1; tm <= 100; ++tm)\n        addEdge(tm, sink, 100, 0);\n    for (int i = 0; i < k; ++i) {\n        int v;\n        scanf(\"%d\", &v);\n        addEdge(src, nodeId(v, 1), 1, 0);\n    }\n    for (int v = 1; v <= n; ++v) {\n        for (int tm = 1; tm < 100; ++tm) {\n            addEdge(nodeId(v, tm), nodeId(v, tm + 1), 100, C);\n        }\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        scanf(\"%d%d\", &u, &v);\n        for (int tm = 1; tm < 100; ++tm) {\n            int a = nodeId(u, tm), b = nodeId(v, tm + 1);\n            for (int p = 1; p <= 50; ++p) {\n                int cost = C + (2 * p - 1) * D;\n                addEdge(a, b, 1, cost);\n            }\n        }\n        for (int tm = 1; tm < 100; ++tm) {\n            int a = nodeId(v, tm), b = nodeId(u, tm + 1);\n            for (int p = 1; p <= 50; ++p) {\n                int cost = C + (2 * p - 1) * D;\n                addEdge(a, b, 1, cost);\n            }\n        }\n    }\n    printf(\"%d\\n\", minCostMaxFlow());\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n