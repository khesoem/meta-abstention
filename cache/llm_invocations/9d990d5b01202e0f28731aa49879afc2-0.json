           int l = 0;\n            for (int j=0; j<bsz; j++)\n                if (sub & (1<<j)) l ^= (1<<idx[j]);\n\n            lint c = invf[l];\n            for (int t=1; t<=16; t++) {\n                dp[msk][t] = (dp[msk][t] + c * dp[msk^l][t-1]) % p;\n            }\n        }\n    }\n\n    lint res = 0;\n    for (int t=1; t<=min(16, k); t++) {\n        lint cur = fact[n] * dp[n][t] % p;\n        cur = cur * fact[k] % p;\n        cur = cur * invf[k-t] % p;\n        res = (res + cur) % p;\n    }\n    lint total = mod_exp(k, n, p);\n    lint ans = (total - res % p + p) % p;\n    cout << ans << '\\n';\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_exp(b, e, m):\n    r = 1\n    b %= m\n    while e:\n        if e & 1:\n            r = (r * b) % m\n        b = (b * b) % m\n        e >>= 1\n    return r\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    \n    if n & 1:\n        print(mod_exp(k, n, p))\n        return\n    \n    fact = [1] * (n + 1)\n    invf = [1] * (n + 1)\n    \n    for i in range(1, n + 1):\n        fact[i] = fact[i - 1] * i % p\n    \n    invf[n] = mod_exp(fact[n], p - 2, p)\n    for i in range(n, 0, -1):\n        invf[i - 1] = invf[i] * i % p\n    \n    MAXM = 1 << 18\n    dp = [[0] * 17 for _ in range(MAXM)]\n    dp[0][0] = 1\n    \n    for msk in range(1, n + 1):\n        if (msk & n) != msk:\n            continue\n        \n        idx = []\n        for b in range(18):\n            if msk & (1 << b):\n                idx.append(b)\n        if not idx:\n            continue\n        \n        bsz = len(idx)\n        for sub in range(1, 1 << bsz):\n            l = 0\n            for j in range(bsz):\n                if sub & (1 << j):\n                    l ^= (1 << idx[j])\n            \n            c = invf[l]\n            for t in range(1, 17):\n                dp[msk][t] = (dp[msk][t] + c * dp[msk ^ l][t - 1]) % p\n    \n    res = 0\n    for t in range(1, min(16, k) + 1):\n        cur = fact[n] * dp[n][t] % p\n        cur = cur * fact[k] % p\n        cur = cur * invf[k - t] % p\n        res = (res + cur) % p\n    \n    total = mod_exp(k, n, p)\n    ans = (total - res % p + p) % p\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00021920185827184469, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.2525192201137543, -0.00019059749320149422, -0.026307065039873123, -0.0002256377338198945, -1.8000440832111053e-05, -3.933898824470816e-06, -0.00029690624796785414, -1.6927575416048057e-05, -2.3841855067985307e-07, 0.0, -5.960462772236497e-07, -1.883488948806189e-05, -1.1920928244535389e-07, -7.033323527139146e-06, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.0022033003624528646, -8.344646857949556e-07, -1.1920928244535389e-07, 0.0, -2.264974000354414e-06, -2.3841855067985307e-07, -2.0265558760002023e-06, 0.0, -2.3841855067985307e-07, -2.145764938177308e-06, 0.0, 0.0, 0.0, -4.768370445162873e-07, -1.5497195136049413e-06, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, -3.6954811548639555e-06, -4.768370445162873e-07, 0.0, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -5.960462772236497e-07, -8.344646857949556e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -1.7881377516459906e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -3.3378546504536644e-06, -2.3841855067985307e-07, 0.0, -1.9073468138230965e-06, -2.3841830625315197e-06, -7.152555099310121e-07, -1.3232143828645349e-05, -3.4689302992774174e-05, -8.344646857949556e-07, -0.28163954615592957, -0.10602381080389023, -1.1324817933200393e-05, -9.369411418447271e-05, -0.5570762157440186, -0.00791614875197