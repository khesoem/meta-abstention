= list(cand)\n\n    for b in range(1, n + 1):\n        # compute hi as in original: (x/y + bestDiff[0]/bestDiff[1] + 2.0) * b\n        hiLimit = x / y + bestDiff[0] / bestDiff[1] + 2.0\n        hi = int(hiLimit * b)\n        lo = 0\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            cand = (mid, b)\n            diff = absSub(target, cand)\n            relax(cand, diff)\n            if cmp(cand, target) < 0:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n\n    sys.stdout.write(f\"{best[0]}/{best[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [0.0, -9.929640509653836e-05, -4.31528314948082e-05, -4.541770613286644e-05, -0.008616176433861256, -0.0002613918040879071, 0.0, -0.00016449528629891574, -3.4570634852570947e-06, -0.11957433819770813, -0.008616294711828232, -1.0728830375228426e-06, -0.05073780193924904, 0.0, -4.6132929128361866e-05, 0.0, -0.47407907247543335, -7.486063259420916e-05, -0.47408196330070496, -0.006715348921716213, 0.0, -1.4305104514278355e-06, -1.1920928244535389e-07, -0.00027164106722921133, -7.497983460780233e-05, 0.0, -9.60780744208023e-05, -4.768370445162873e-07, -4.768370445162873e-07, -2.0265558760002023e-06, 0.0, -3.576278118089249e-07, -0.038071826100349426, 0.0, 0.0, 0.0, 0.0, -2.861018856492592e-06, -1.6689286894688848e-06, 0.0, -2.3841855067985307e-07, -0.3871704638004303, -0.12692952156066895, -7.56950321374461e-05, 0.0, 0.0, 0.0, 0.0, -5.602820692729438e-06, -3.4570634852570947e-06, 0.0, -0.002476127352565527, -1.1920928244535389e-07, -5.960462772236497e-07, -1.7881377516459906e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.5808001756668091, 0.0, -0.0002213471452705562, -1.4305104514278355e-06, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -0.05552011728286743, -1.2993727978027891e-05, -0.01417261641472578, -0.10060454905033112, 0.0, -7.497983460780233e-