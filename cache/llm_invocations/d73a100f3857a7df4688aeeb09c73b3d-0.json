   \n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = false;\n            \n            for (int i = hed[u]; i != 0; i = nxt[i]) {\n                if (val[i] == 0 || dis[to[i]] <= dis[u] + w[i]) continue;\n                \n                dis[to[i]] = dis[u] + w[i];\n                incf[to[i]] = Math.min(incf[u], val[i]);\n                pre[to[i]] = i;\n                \n                if (!inq[to[i]]) {\n                    inq[to[i]] = true;\n                    q.offer(to[i]);\n                }\n            }\n        }\n        \n        return dis[t] != INF;\n    }\n    \n    static void update() {\n        int tmp = t;\n        for (; tmp != s;) {\n            int i = pre[tmp];\n            val[i] -= incf[t];\n            val[i ^ 1] += incf[t];\n            tmp = to[i ^ 1];\n        }\n        ans += incf[t] * dis[t];\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        n = scanner.nextInt();\n        m = scanner.nextInt();\n        k = scanner.nextInt();\n        c = scanner.nextInt();\n        d = scanner.nextInt();\n        \n        t = (n + k - 1) * n + 1;\n        \n        for (int i = 1; i <= k; i++) {\n            int x = scanner.nextInt();\n            add(s, x, 1, 0);\n        }\n        \n        for (int i = 1; i <= m; i++) {\n            int x = scanner.nextInt();\n            int y = scanner.nextInt();\n            for (int j = 1; j <= n + k; j++) {\n                for (int h = 1; h <= k; h++) {\n                    add(x + (j - 1) * n, y + j * n, 1, d * h * 2 - d + c);\n                    add(y + (j - 1) * n, x + j * n, 1, d * h * 2 - d + c);\n                }\n            }\n        }\n        \n        for (int i = 1; i < n + k; i++) {\n            for (int j = 2; j <= n; j++) {\n                add(j + (i - 1) * n, j + i * n, INF, c);\n            }\n            add(1 + (i - 1) * n, 1 + i * n, INF, 0);\n        }\n        \n        