_error = error;\n                best_numerator = num;\n                best_denominator = d;\n            }\n        }\n    }\n    \n    if (fabs(1.0 - target) <= smallest_error + 1e-9) {\n        best_numerator = 1;\n        best_denominator = 1;\n    }\n    \n    int g = gcd(best_numerator, best_denominator);\n    printf(\"%d/%d\\n\", best_numerator / g, best_denominator / g);\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static int gcd(int a, int b) {\n        if (a == 0) return b;\n        if (b == 0) return a;\n        return gcd(b, a % b);\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int x = scanner.nextInt();\n        int y = scanner.nextInt();\n        int limit = scanner.nextInt();\n        \n        double target = (double)x / y;\n        int best_numerator = 0;\n        int best_denominator = 1;\n        double smallest_error = 1e10;\n        \n        for (int d = 1; d <= limit; d++) {\n            int n = (int)((long)x * d / y);\n            \n            List<Integer> candidates = Arrays.asList(n-1, n, n+1);\n            for (int num : candidates) {\n                if (num < 0) continue;\n                \n                double error = Math.abs(target - (double)num / d);\n                boolean update = false;\n                \n                if (error < smallest_error) {\n                    update = true;\n                } else if (Math.abs(error - smallest_error) < 1e-9) {\n                    if (num * best_denominator < best_numerator * d) {\n                        update = true;\n                    }\n                }\n                \n                if (update) {\n                    smallest_error = error;\n                    best_numerator = num;\n                  