xp > 0) {\n        if (exp & 1) result = (1LL * result * base) % mod;\n        base = (1LL * base * base) % mod;\n        exp >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    scanf(\"%d %d %d\", &n, &k, &mod);\n    \n    invFactorial[0] = invFactorial[1] = factorial[0] = 1;\n    \n    for (int i = 2; i <= n; ++i) {\n        invFactorial[i] = 1LL * (mod - mod / i) * invFactorial[mod % i] % mod;\n    }\n    \n    for (int i = 1; i <= n; i <<= 1) {\n        for (int j = i >> 1; j < i && j <= n; ++j) {\n            highestPower[j] = i;\n        }\n    }\n    \n    for (int i = 1; i <= n; ++i) {\n        factorial[i] = 1LL * factorial[i-1] * i % mod;\n        invFactorial[i] = 1LL * invFactorial[i-1] * invFactorial[i] % mod;\n    }\n    \n    answer = modPow(k, n);\n    \n    if (n % 2 == 0) {\n        dp[0][0] = 1;\n        for (int i = 0; i < 26; ++i) {\n            for (int j = 0; j <= n; ++j) {\n                if (dp[i][j] && (j & n) == j) {\n                    for (int next = j + highestPower[j]; next <= n; next = (next + 1) | j) {\n                        if ((next & n) == next) {\n                            dp[i+1][next] = (dp[i+1][next] + 1LL * dp[i][j] * invFactorial[next - j] % mod) % mod;\n                        }\n                    }\n                }\n            }\n        }\n        \n        int temp = 0;\n        for (int i = 1; i <= 26; ++i) {\n            temp = (temp + 1LL * dp[i][n] * invFactorial[k - i] % mod) % mod;\n        }\n        answer = (answer - 1LL * temp * factorial[n] % mod * factorial[k] % mod + mod) % mod;\n    }\n    \n    printf(\"%d\", answer);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<repaired_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 250005;\nint n, k, mod, answer;\nint highestPower[MAXN], factorial[MAXN], invFactorial[MAXN], dp[27][MAXN];\n\nint modPow(int base, 