   intervals[k][0] = 2 * N;\n            intervals[k][1] = 2 * N;\n            int cur = 0;\n            SegmentTree[] dp = new SegmentTree[2];\n            dp[0] = new SegmentTree(N + 1);\n            dp[1] = new SegmentTree(N + 1);\n            dp[0].assign(0, 0);\n            for (int i = 0; i < intervals.length; i++) {\n                int[] interval = intervals[i];\n                for (int j = N; j >= 0; j--) {\n                    dp[0].assign(j, dp[0].getVal(j - (interval[0] - cur)));\n                }\n                cur = interval[1];\n                int sz = interval[1] - interval[0];\n                for (int j = N; j >= 0; j--) {\n                    int[] put = new int[2];\n                    for (int z = 0; z <= 1; z++) {\n                        int twoSwaps = dp[z].query(j - sz, j);\n                        int oneSwap = dp[(z + 1) % 2].query(j - sz, j);\n                        int noSwap;\n                        if (z == 1) {\n                            noSwap = dp[z].getVal(j);\n                        } else {\n                            noSwap = dp[z].getVal(j - sz);\n                        }\n                        put[z] = Math.min(twoSwaps + 2, Math.min(oneSwap + 1, noSwap));\n                    }\n                    dp[0].assign(j, put[0]);\n                    dp[1].assign(j, put[1]);\n                }\n            }\n            int ans = Math.min(dp[0].query(N, N), dp[1].query(N, N));\n            if (ans >= MAX) {\n                out.println(\"Hungry\");\n            } else {\n                out.println(\"Full\");\n                out.println(ans);\n            }\n        }\n\n        class SegmentTree {\n            int[] tree;\n            int[] arr;\n            int size;\n\n            public SegmentTree(int N) {\n                size = N;\n                tree = new int[4 * N];\n                arr = new int[N];\n                Arrays.fill(arr, MAX);\n                Arrays.fill(tree, MAX);\n            }\n\n        