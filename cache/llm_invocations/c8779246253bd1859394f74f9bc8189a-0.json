     }\n                        int leftBase = 100 * i + 10 * j;\n                        int rightBase = 100 * x + 10 * y;\n                        int leftCount = s1.get(i).charAt(j) - '0';\n                        int rightCount = s2.get(x).charAt(y) - '0';\n                        for (int u = 1; u <= leftCount; u++) {\n                            for (int v = 1; v <= rightCount; v++) {\n                                g[leftBase + u].add(rightBase + v);\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        for (int i = 0; i < MAXN; i++) {\n            timer++;\n            dfsKuhn(i);\n        }\n\n        int answer = 0;\n        for (int i = 0; i < MAXN; i++) {\n            if (matchRight[i] != 0) answer++;\n        }\n        System.out.println(answer);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.3351351299206726e-05, 0.0, 0.0, -1.5020257706055418e-05, -3.290122185717337e-05, 0.0, -2.753696753643453e-05, -0.0013393727131187916, -1.966933996300213e-05, -1.1920928244535389e-07, -0.0018861376447603106, -0.0024776733480393887, -1.7881233361549675e-05, -0.0002286172821186483, -7.652943895664066e-05, -0.02324567921459675, 0.0, 0.0, -0.0009158230968751013, -0.00020418466010596603, -6.198863957251888e-06, 0.0, 0.0, -9.536738616588991e-07, -0.004149043001234531, 0.0, -0.03804474323987961, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.0728830375228426e-06, 0.0, 0.0, -3.576278118089249e-07, -4.768370445162873e-07, -0.3133190870285034, -0.10020744800567627, -2.3841855067985307e-07, -0.09034986793994904, -0.00020656836568377912, -0.0009965697536244988, -1.1920928244535389e-07, 0.0, -3.576214658096433e-05, -5.960462772236497e-07, 0.0, -0.0019300420535728335, -9.536738616588991e-07, 0.0, -1.1920922133867862e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -5.960462772236497e-07, -2.3841855067985307e-