{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n \nusing namespace std;\n \n#define fore(i, s, e) for(int i = s; i < e; i++)\n#define pb push_back\n#define ALL(a) a.begin(), a.end()\n#define SZ(a) ((int)a.size())\n#define mset(a, b) memset(a, b, sizeof(a))\n#define fst first\n#define snd second\n \ntypedef long long ll;\n \ntypedef int tf;\ntypedef int tc;\nconst tf INF=1e9;\nstruct MCF{\n\tint n;\n\tvector<tc> prio, pot; vector<tf> curflow; vector<int> prevedge,prevnode;\n\tpriority_queue<pair<tc, int>, vector<pair<tc, int>>, greater<pair<tc, int>>> q;\n\tstruct edge{int to, rev; tf f, cap; tc cost;};\n\tvector<vector<edge>> g;\n\tMCF(int n):n(n),prio(n),curflow(n),prevedge(n),prevnode(n),pot(n),g(n){}\n\tvoid add_edge(int s, int t, tf cap, tc cost) {\n    // cout << s << \" \" << t << \" \" << cap << endl;\n\t\tg[s].pb((edge){t,SZ(g[t]),0,cap,cost});\n\t\tg[t].pb((edge){s,SZ(g[s])-1,0,0,-cost});\n\t}\n\tpair<tf,tc> get_flow(int s, int t) {\n\t\ttf flow=0; tc flowcost=0;\n    // cout << s << \" \" << t << endl;\n\t\twhile(1){\n\t\t\tq.push({0, s});\n\t\t\tfill(ALL(prio),INF); \n\t\t\tprio[s]=0; curflow[s]=INF;\n\t\t\twhile(!q.empty()) {\n\t\t\t\tauto cur=q.top();\n\t\t\t\ttc d=cur.fst;\n        int u=cur.snd;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u]) continue;\n\t\t\t\tfor(int i=0; i<SZ(g[u]); ++i) {\n\t\t\t\t\tedge &e=g[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif(e.cap<=e.f) continue;\n\t\t\t\t\ttc nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif(prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push({nprio, v});\n\t\t\t\t\t\tprevnode[v]=u; prevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INF) break;\n\t\t\tfore(i,0,n) pot[i]+=prio[i];\n\t\t\ttf df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tedge &e=g[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df; g[v][e.rev].f-=df;\n\t\t\t\tflowcost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn {flow,flowcost};\n\t}\n};\n\nint T = 150; // I'm supposing this works\n\nint main() {\n  int n, m, k, c, d; cin >> n >> m >> k >> c >> d;\n  int N = n*T;\n  MCF mcf(N + 2);\n  fore(i, 0, n) fore(j, 0, T - 1) {\n    mcf.add_edge(i * T + j, i * T + j + 1, INF, c); // Wait a minute on this city\n  }\n  fore(i, 0, T) mcf.add_edge(i, N + 1, INF, 0); // Arrive to city 0 on time i\n  fore(i, 0, k) {\n    int x; cin >> x; x--;\n    mcf.add_edge(N, x * T, 1, 0); // One person in city x at time 0\n  }\n  fore(i, 0, m) {\n    int x, y; cin >> x >> y; x--, y--;\n    fore(j, 0, T - 1) { // for each time\n      int cur = 1;\n      fore(_, 0, k) { // k different people can go there\n        mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c);\n        mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c);\n        cur += 2; // squared cost\n      }\n    }\n  }\n  auto p = mcf.get_flow(N, N + 1);\n  assert(p.fst == k); \n  cout << p.snd << endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it)); m = int(next(it)); k = int(next(it)); c = int(next(it)); d = int(next(it))\n    \n    T = 150\n    N = n * T\n    \n    # Graph representation: adjacency list with edges\n    # Each edge: [to, rev_index, flow, capacity, cost]\n    class MCF:\n        def __init__(self, n):\n            self.n = n\n            self.g = [[] for _ in range(n)]\n            self.prio = [10**9] * n\n            self.curflow = [0] * n\n            self.prevedge = [0] * n\n            self.prevnode = [0] * n\n            self.pot = [0] * n\n        \n        def add_edge(self, s, t, cap, cost):\n            # Forward edge\n            rev_s = len(self.g[t])\n            rev_t = len(self.g[s])\n            self.g[s].append([t, rev_s, 0, cap, cost])\n            # Backward edge\n            self.g[t].append([s, rev_t, 0, 0, -cost])\n        \n        def get_flow(self, s, t):\n            flow = 0\n            flowcost = 0\n            \n            while True:\n                # Dijkstra's algorithm with priority queue\n                self.prio = [10**9] * self.n\n                self.curflow = [0] * self.n\n                self.prevedge = [-1] * self.n\n                self.prevnode = [-1] * self.n\n                \n                self.prio[s] = 0\n                self.curflow[s] = 10**9\n                \n                # Priority queue: (distance, node)\n                q = [(0, s)]\n                \n                while q:\n                    d, u = heapq.heappop(q)\n                    if d != self.prio[u]:\n                        continue\n                    for i, edge in enumerate(self.g[u]):\n                        v, rev, f, cap, cost = edge\n                        if cap <= f:\n                            continue\n                        nprio = self.prio[u] + cost + self.pot[u] - self.pot[v]\n                        if self.prio[v] > nprio:\n                            self.prio[v] = nprio\n                            heapq.heappush(q, (nprio, v))\n                            self.prevnode[v] = u\n                            self.prevedge[v] = i\n                            self.curflow[v] = min(self.curflow[u], cap - f)\n                \n                if self.prio[t] == 10**9:\n                    break\n                \n                # Update potentials\n                for i in range(self.n):\n                    self.pot[i] += self.prio[i]\n                \n                df = min(self.curflow[t], 10**9 - flow)\n                flow += df\n                \n                # Update flow along the path\n                v = t\n                while v != s:\n                    u = self.prevnode[v]\n                    edge_idx = self.prevedge[v]\n                    edge = self.g[u][edge_idx]\n                    edge[2] += df  # forward edge flow\n                    rev_edge = self.g[v][edge[1]]\n                    rev_edge[2] -= df  # backward edge flow\n                    flowcost += df * edge[4]\n                    v = u\n            \n            return (flow, flowcost)\n    \n    mcf = MCF(N + 2)\n    \n    # Edges for waiting in cities\n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(i * T + j, i * T + j + 1, 10**9, c)\n    \n    # Edges from source to city 0 at different times\n    for i in range(T):\n        mcf.add_edge(i, N + 1, 10**9, 0)\n    \n    # Edges for people starting at cities\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcf.add_edge(N, x * T, 1, 0)\n    \n    # Edges for roads between cities\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for j in range(T - 1):\n            cur = 1\n            for _ in range(k):\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c)\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c)\n                cur += 2\n    \n    p = mcf.get_flow(N, N + 1)\n    \n    assert p[0] == k\n    print(p[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00023803261865396053, -1.311301275563892e-06, -1.1920928244535389e-07, -3.290122185717337e-05, -0.3488641679286957, -0.14300918579101562, -0.2015106976032257, -0.00016616393986623734, -0.5773364901542664, -0.7824453115463257, -0.08228953182697296, -4.160317621426657e-05, -2.253030106658116e-05, -0.15123142302036285, -0.09715905040502548, -1.3708974620385561e-05, -9.536738616588991e-07, -0.02388792298734188, -0.0018662670627236366, -2.145764938177308e-06, -4.756337511935271e-05, 0.0, -0.05490419641137123, -1.5497195136049413e-06, -0.004085053224116564, -4.732496745418757e-05, -0.5231314301490784, -2.7418097943154862e-06, -0.4428137540817261, -1.1920922133867862e-06, -0.00023421882360707968, -0.1426960676908493, -2.622600959512056e-06, -9.679325739853084e-05, -7.152531907195225e-06, -4.577531944960356e-05, -1.3708974620385561e-05, -3.361645576660521e-05, -7.510157047363464e-06, -0.4742124676704407, -3.576278118089249e-07, -2.3841855067985307e-07, -5.960446742392378e-06, -1.5258672647178173e-05, -9.536697689327411e-06, -0.00030048147891648114, -4.768370445162873e-07, -0.00015984688070602715, -2.50339189733495e-06, -1.1801649634435307e-05, -1.2636104656849056e-05, -0.06205299124121666, -1.5497195136049413e-06, -3.194758028257638e-05, -5.125986263010418e-06, -4.0531076592742465e-06, -0.0001137191939051263, -0.00021205084340181202, -9.536738616588991e-07, -0.00010942813969450071, -1.3112935448589269e-05, -6.6756979322235566e-06, -6.9141146923357155e-06, -0.00012635385792236775, -0.06993945688009262, -2.3841855067985307e-07, -0.00017450717859901488, -5.960462772236497e-07, 0.0, 0.0, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.06390481442213058, -5.245195097813848e-06, -3.099436753473128e-06, -4.172238186583854e-05, 0.0, -1.0728830375228426e-06, 