s[v]) dis[v]=dis[u]+w,q.push(node(v,dis[v]));\n            }\n        }\n        for(int i=1;i<=all;i++) tag[i]=min(tag[i]+dis[i],winf);\n        if(!vis[s]) return false;\n        for(int i=1;i<=all;i++) vis[i]=false;\n        return true;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && tag[v]+r[i].w==tag[u] && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(dij(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*tag[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int N = 100010;\n    static final int M = 1000010;\n    static final int INF = 1000000000;\n    static final int WIN = 1000000000;\n    \n    static class Road {\n        int nxt, to, f;\n        int w;\n        Road(int nxt, int to, int f, int w) {\n            this.nxt = nxt;\n            this.to = to;\n            this.f = f;\n            this.w = w;\n        }\n    }\n    \n    static Road[] r = new Road[M << 1];\n    static int[] head = new int[N];\n    static int cnt = 1;\n    static int all;\n    \n    static void add(int u, int v, int f, int w) {\n        r[++cnt] = new Road(head[u], v, f, w);\n        head[u] = cnt;\n        r[++cnt] = new Road(head[v], u, 0, -w);\n        head[v] = cnt;\n    }\n    \n    static class MinCostFlow {\n        int[] cur = new int[N];\n        boolean[] vis = new boolean[N];\n        PriorityQueue<Node> q = new PriorityQueue<>();\n        int[] dis = new int[N];\n        int[] tag = new int[N];\n        int maxf;\n        int minw;\n        \n        class Node implements Comparable<Node> {\n            int u;\n            int v;\n            Node(int u, int v) {\n                this.u = u;\n                this.v = v;\n            }\n            public int compareTo(Node other) {\n                return Integer.compare(this.v, other.v);\n            }\n        }\n        \n        boolean dij(int s, int t) {\n            for (int i = 1; i <= all; i++) {\n                dis[i] = WIN;\n                cur[i] = head[i];\n            }\n            dis[t] = 0;\n            q.add(new Node(t, 0));\n            while (!q.isEmpty()) {\n                int u = q.poll().u;\n                if (vis[u]) continue;\n                vis[u] = true;\n                for (int i = head[u]; i != 0; i = r[i].nxt) {\n                    int v = r[i].to;\n                    int w = tag[u] + r[i^1].w - tag[v];\n                    if (r[i^1].f != 0 && dis[u] + w < dis[v]) {\n                        dis[v] = dis[u] + w;\n                        q.add(new Node(v, dis[v]));\n                    }\n                }\n            }\n            for (int i = 1; i <= all; i++) {\n                tag[i] = Math.min(tag[i] + dis[i], WIN);\n            }\n            if (!vis[s]) return false;\n            for (int i = 1; i <= all; i++) vis[i] = false;\n            return true;\n        }\n        \n        int dfs(int u, int t, int fl) {\n            if (u == t || fl == 0) return fl;\n            int res = 0;\n            vis[u] = true;\n            for (int i = cur[u]; i != 0; i = r[i].nxt) {\n                cur[u] = i;\n                if (r[i].f != 0) {\n                    int v = r[i].to;\n                    if (!vis[v] && tag[v] + r[i].w == tag[u]) {\n                        int f = dfs(v, t, Math.min(fl, r[i].f));\n                        if (f != 0) {\n                            r[i].f -= f;\n                            r[i^1].f += f;\n                            res += f;\n                            fl -= f;\n                            if (fl == 0) break;\n                        }\n                    }\n                }\n            }\n            vis[u] = false;\n            return res;\n        }\n        \n        void work(int s, int t) {\n            while (dij(s, t)) {\n                int w = dfs(s, t, INF);\n                maxf += w;\n                minw += w * tag[s];\n            }\n        }\n    }\n    \n    static int ss = 1, tt = 2, n, m, k, c, d;\n    static List<Integer>[] g = new ArrayList[N];\n    \n    static int id(int t, int x) {\n        return t * n + x + 2;\n    }\n    \n    static void work(int t) {\n        all += n;\n        for (int u = 1; u <= n; u++) {\n            for (int v : g[u]) {\n                for (int p = 1; p <= k; p++) {\n                    add(id(t, u), id(t + 1, v), 1, d * (2 * p - 1));\n                }\n            }\n        }\n        for (int u = 1; u <= n; u++) {\n            add(id(t, u), id(t + 1, u), INF, 0);\n        }\n        add(id(t + 1, 1), tt, INF, c * (t + 1));\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        all = n + 2;\n        for (int i = 1; i <= n; i++) {\n            g[i] = new ArrayList<>();\n        }\n        for (int i = 1; i <= k; i++) {\n            int a = sc.nextInt();\n            add(ss, id(0, a), 1, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            g[u].add(v);\n            g[v].add(u);\n        }\n        add(id(0, 1), tt, INF, 0);\n        for (int i = 0; i <= n + k; i++) {\n            work(i);\n        }\n        MinCostFlow mcf = new MinCostFlow();\n        mcf.work(ss, tt);\n        System.out.println(mcf.minw);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.7683704e-07, 0.0, 0.0, -0.00016914368, -0.0002673507, -7.152555e-07, -0.048587784, -0.07940112, -0.00075240433, -2.3841855e-07, -0.0055014873, -0.0025100175, -0.00016282663, -0.0021357364, -0.47826904, -1.03711545e-05, -0.002217574, -2.9802277e-06, -1.5139465e-05, -0.0005304598, -3.802704e-05, -0.014194007, -1.5497195e-06, -3.0994368e-06, -0.00088985893, -2.264974e-06, -1.1563234e-05, -3.81469e-06, -2.9802277e-06, -0.00013410146, -7.986991e-06, -1.072883e-06, -0.00010299152, -1.6927575e-05, -1.5497195e-06, -0.00020668755, -0.00012480434, -0.023329068, -2.4556812e-05, -0.0003710297, -0.0011785235, -8.344647e-07, -2.7418098e-06, -3.373566e-05, -0.00043728325, -0.0015031717, -9.536698e-06, -0.001145779, -0.023281319, -0.38743034, -1.3594894, -0.0052883024, -7.4503034e-05, -5.960463e-07, -4.0172723e-05, -0.0002967871, -0.28122804, -0.1269418, -9.5367386e-07, -6.0079677e-05, -0.0032439013, -0.6931975, -6.520536e-05, -1.072883e-06, -1.4305105e-06, -0.007888237, -8.344647e-07, -2.8848232e-05, -1.2278481e-05, -0.000111573674, -0.0001