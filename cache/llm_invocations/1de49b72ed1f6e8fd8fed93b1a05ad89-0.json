           }\n        }\n        return pre[t] != -1;\n    }\n\n    static int mcmf(int s, int t, int[] cost) {\n        int flow = 0;\n        cost[0] = 0;\n        while (spfa(s, t)) {\n            int bottleneck = INF;\n            for (int i = pre[t]; ~i != 0; i = pre[e[i^1].to])\n                bottleneck = Math.min(bottleneck, e[i].cap - e[i].flow);\n            for (int i = pre[t]; ~i != 0; i = pre[e[i^1].to]) {\n                e[i].flow += bottleneck;\n                e[i^1].flow -= bottleneck;\n                cost[0] += e[i].cost * bottleneck;\n            }\n            flow += bottleneck;\n        }\n        return flow;\n    }\n\n    static int encode(int x, int y) {\n        return (x-1)*50 + y;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int src = 101*55, dst = src + 1;\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        int val;\n        init(dst + 1);\n        for (int i = 1; i <= k; i++) {\n            val = sc.nextInt();\n            link(src, val, 1, 0);\n        }\n        for (int col = 1; col <= 50; col++) {\n            for (int row = 1; row <= 103; row++) {\n                int u = encode(row, col), v = encode(row+1, col);\n                link(u, v, INF, c);\n            }\n        }\n        for (int i = 0; i < 102; i++) {\n            int node = i*50 + 1;\n            link(node, dst, INF, 0);\n        }\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int row = 1; row <= 102; row++) {\n                int a = encode(row, u), a1 = encode(row+1, u);\n                int b1 = encode(row+1, v), b = encode(row, v);\n                for (int layer = 0; layer < 50; layer++) {\n                    int cost = d*(layer*2+1) + c;\n                    link(a, b1, 1, cost);\n                    link(b, a1, 1, cost);\n                }\n            }\n        }\n        int[] total_cost = new int[1];\n        mcmf(src, dst, total_cost);\n        System.out.println(total_cost[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00015162272029556334, -2.861018856492592e-06, -8.344646857949556e-07, -0.0009971652179956436, -4.827859811484814e-05, -0.16023050248622894, -0.07900024205446243, -1.0967194612021558e-05, -3.576278118089249e-07, -5.2569914259947836e-05, -0.06993711739778519, -0.0019292091019451618, -0.049440789967775345, -0.002547354670241475, -4.0531076592742465e-06, -7.271740287251305e-06, 0.0, -1.5139465176616795e-05, 0.0, -2.4437606043647975e-05, -3.576278118089249e-07, -2.861018856492592e-06, 0.0, -9.536738616588991e-07, -1.1920928244535389e-07, 0.0, -9.536738616588991e-07, -1.5497195136049413e-06, -4.768370445162873e-07, -2.145764938177308e-06, -3.576278118089249e-07, -6.472854875028133e-05, -1.0728830375228426e-06, -2.145764938177308e-06, -7.033323527139146e-06, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -1.1444026313256472e-05, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841830625315197e-06, -0.00020966715237591416, -7.033323527139146e-06, -4.386805812828243e-05, 0.0, -1.0251946150674485e-05, -1.0728830375228426e-06, 0.0, 0.0, -3.4570634852570947e-06, -1.6689286894688848e-06, -1.311301275563892e-06, -3.4570634852570947e-06, -0.005929380189627409, -3.576278118089249e-07, -6.9141146923357155e-06, -0.06159622222185135, -0.008806674741208553, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -7.390948667307384e-06, -1.7404405298293568e-05, -8.106198947643861e-06, -6.318072337307967e-06, -9.536697689327411e-06, -0.20141449570655823, -5.960462772236497e-07, -0.00045193947153165936, -0.4367006719112396, -0.0006568658282049, -8.344646857949556e-07, -1.0728830375228426e-06, -7.152555099310121e-07, -1.4305104514278355e-06, -4.660974445869215e-05, -2.3245540432981215e-05, -1.1920928244535389e-07, -1.0728830375228426