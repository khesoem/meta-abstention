{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int INF = 0x3f3f3f3f;\nconst int MAX_M = 2000015;\nconst int MAX_N = 5775;\n\nint n, m, c, d, k;\n\nint read() {\n    int x = 0, f = 1;\n    char c = getchar();\n    while (c < '0' || c > '9') { if (c == '-') f = -1; c = getchar(); }\n    while (c >= '0' && c <= '9') { x = x * 10 + c - '0'; c = getchar(); }\n    return x * f;\n}\n\nstruct Edge {\n    int to, next, cap, flow, cost;\n} e[MAX_M];\n\nint h[MAX_N], ec;\nint pre[MAX_N], dis[MAX_N];\nbool inq[MAX_N];\nint N;\n\nvoid init(int nodes) {\n    N = nodes;\n    ec = 0;\n    memset(h, -1, sizeof(h));\n}\n\nvoid link(int u, int v, int cap, int cost) {\n    e[ec] = {v, h[u], cap, 0, cost};\n    h[u] = ec++;\n    e[ec] = {u, h[v], 0, 0, -cost};\n    h[v] = ec++;\n}\n\nbool spfa(int s, int t) {\n    queue<int> q;\n    fill(dis, dis + N, INF);\n    fill(inq, inq + N, false);\n    fill(pre, pre + N, -1);\n    dis[s] = 0;\n    inq[s] = true;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = false;\n        for (int i = h[u]; ~i; i = e[i].next) {\n            int v = e[i].to;\n            if (e[i].cap > e[i].flow && dis[v] > dis[u] + e[i].cost) {\n                dis[v] = dis[u] + e[i].cost;\n                pre[v] = i;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return pre[t] != -1;\n}\n\nint mcmf(int s, int t, int &cost) {\n    int flow = 0;\n    cost = 0;\n    while (spfa(s, t)) {\n        int bottleneck = INF;\n        for (int i = pre[t]; ~i; i = pre[e[i^1].to])\n            bottleneck = min(bottleneck, e[i].cap - e[i].flow);\n        for (int i = pre[t]; ~i; i = pre[e[i^1].to]) {\n            e[i].flow += bottleneck;\n            e[i^1].flow -= bottleneck;\n            cost += e[i].cost * bottleneck;\n        }\n        flow += bottleneck;\n    }\n    return flow;\n}\n\nint encode(int x, int y) { return (x-1)*50 + y; }\n\nint main() {\n    int src = 101*55, dst = src + 1;\n    n = read(), m = read(), k = read(), c = read(), d = read();\n    int val;\n    init(dst + 1);\n    for (int i = 1; i <= k; i++) {\n        val = read();\n        link(src, val, 1, 0);\n    }\n    for (int col = 1; col <= 50; col++) {\n        for (int row = 1; row <= 103; row++) {\n            int u = encode(row, col), v = encode(row+1, col);\n            link(u, v, INF, c);\n        }\n    }\n    for (int i = 0; i < 102; i++) {\n        int node = i*50 + 1;\n        link(node, dst, INF, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        int u = read(), v = read();\n        for (int row = 1; row <= 102; row++) {\n            int a = encode(row, u), a1 = encode(row+1, u);\n            int b1 = encode(row+1, v), b = encode(row, v);\n            for (int layer = 0; layer < 50; layer++) {\n                int cost = d*(layer*2+1) + c;\n                link(a, b1, 1, cost);\n                link(b, a1, 1, cost);\n            }\n        }\n    }\n    int total_cost = 0;\n    mcmf(src, dst, total_cost);\n    cout << total