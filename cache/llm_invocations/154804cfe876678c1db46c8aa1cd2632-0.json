 = dp[k + 1][i];\n            int cnt = 0;\n            int hb = highest_bit(i);\n\n            for (int j = i - hb; j >= 0; j = (j - 1) & i) {\n                int jj = j + hb;\n                res += dp[k][i ^ jj] * (ull)rf[jj];\n                if (++cnt == 18) {\n                    res %= MOD;\n                    cnt = 0;\n                }\n                if (j == 0) break;\n            }\n            res %= MOD;\n        }\n    }\n\n    int ans = 0;\n    for (int i = 0; i <= K; ++i)\n        (ans += 1LL * f[n] * dp[i][n] % MOD * permute(K, i) % MOD) %= MOD;\n\n    cout << (mpow(K, n) + MOD - ans) % MOD << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mpow(x, n, MOD):\n    r = 1\n    while n:\n        if n & 1:\n            r = (r * x) % MOD\n        x = (x * x) % MOD\n        n >>= 1\n    return r\n\ndef highest_bit(x):\n    h = 1\n    while (h << 1) <= x:\n        h <<= 1\n    return h\n\ndef main():\n    data = sys.stdin.read().split()\n    n, K, MOD = map(int, data)\n    if n & 1:\n        print(mpow(K, n, MOD))\n        return\n\n    N = n + 1\n    f = [0] * N\n    f[0] = 1\n    for i in range(1, N):\n        f[i] = (f[i-1] * i) % MOD\n\n    rf = [0] * N\n    rf[n] = mpow(f[n], MOD - 2, MOD)\n    for i in range(n-1, -1, -1):\n        rf[i] = (rf[i+1] * (i+1)) % MOD\n\n    dp = [[0] * N for _ in range(K+1)]\n    dp[0][0] = 1\n\n    for k in range(K):\n        for i in range(n, 0, -1):\n            if (i & n) != i:\n                continue\n            res = dp[k+1][i]\n            hb = highest_bit(i)\n            j = i - hb\n            while True:\n                jj = j + hb\n                res += dp[k][i ^ jj] * rf[jj]\n                if j == 0:\n                    break\n                j = (j - 1) & i\n            dp[k+1][i] = res % MOD\n\n    ans = 0\n    for i in range(K+1):\n     