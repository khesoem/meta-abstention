) * (r - l + 1) / 2;\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        long m = sc.nextLong();\n        MOD = sc.nextLong();\n        \n        int N = (int)n;\n        int M = (int)m;\n        \n        // comb up to M\n        mint[][] comb = new mint[M+1][M+1];\n        for (int i = 0; i <= M; i++) {\n            comb[i][0] = new mint(1);\n            comb[i][i] = new mint(1);\n            for (int j = 1; j < i; j++) {\n                comb[i][j] = comb[i-1][j-1].add(comb[i-1][j]);\n            }\n        }\n        \n        mint[] a = new mint[M+1];\n        mint[] c = new mint[M+1];\n        a[0] = new mint(0);\n        c[0] = new mint(1);\n        a[1] = new mint(0);\n        c[1] = new mint(2);\n        for (int i = 2; i <= M; i++) {\n            mint tmp = new mint(0);\n            mint tmpc = new mint(0);\n            for (int l = 0; l < i; l++) {\n                long r = i - 1 - l;\n                mint term1 = c[l].multiply(c[(int)r]).multiply(new mint(s1(1,l) + s1(1,r))).multiply(comb[i-1][l]);\n                mint term2 = a[l].multiply(c[(int)r]).add(a[(int)r].multiply(c[l])).multiply(comb[i-1][l]).multiply(new mint(i+1));\n                tmp.addAssign(term1.add(term2));\n                mint termc = c[l].multiply(c[(int)r]).multiply(new mint(i+1)).multiply(comb[i-1][l]);\n                tmpc.addAssign(termc);\n            }\n            a[i] = tmp;\n            c[i] = tmpc;\n        }\n        \n        // dpc and dp arrays\n        mint[][][] dpc = new mint[N+1][M+1][2];\n        mint[][][] dp = new mint[N+1][M+1][2];\n        // initialize all to 0\n        for (int i = 0; i <= N; i++) {\n            for (int j = 0; j <= M; j++) {\n                dpc[i][j][0] = new mint(0);\n                dpc[i][j][1] = new mint(0);\n                dp[i][j][0] = new mint(0);\n                dp[i][j][1] = new mint(0);\n            }\n        }\n        dpc[0][0][