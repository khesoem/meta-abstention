Num = vNum\n        self.src = src\n        self.sink = sink\n        self.res = [[0] * vNum for _ in range(vNum)]\n        self.cost = [[0] * vNum for _ in range(vNum)]\n        self.costGraph = []\n        self.d = [0] * vNum\n        self.p = [0] * vNum\n\n    def addEdge(self, from_, to, capacity, cost):\n        self.res[from_][to] += capacity\n        self.cost[from_][to] = cost\n        self.cost[to][from_] = -cost\n\n    def findCheapestPath(self):\n        self.costGraph.clear()\n        for i in range(self.vNum):\n            for j in range(self.vNum):\n                if self.res[i][j] > 0:\n                    self.costGraph.append(Edge(i, j, self.cost[i][j]))\n        for i in range(self.vNum):\n            self.d[i] = float('inf')\n            self.p[i] = -1\n        self.d[self.src] = 0\n        for _ in range(self.vNum - 1):\n            changed = False\n            for e in self.costGraph:\n                if self.d[e.from] != float('inf') and self.d[e.from] + e.cost < self.d[e.to]:\n                    self.d[e.to] = self.d[e.from] + e.cost\n                    self.p[e.to] = e.from\n                    changed = True\n            if not changed:\n                break\n        return self.p[self.sink] != -1\n\n    def augmentPath(self, from_, to, flow):\n        pathCost = 0\n        for cur in iterPath(to, from_, self.p):\n            flow = min(flow, self.res[self.p[cur]][cur])\n        for cur in iterPath(to, from_, self.p):\n            self.res[self.p[cur]][cur] -= flow\n            self.res[cur][self.p[cur]] += flow\n            pathCost += self.cost[self.p[cur]][cur] * flow\n        return [flow, pathCost]\n\n    def getMinCostMaxFlow(self):\n        flow = 0\n        totalCost = 0\n        while self.findCheapestPath():\n            result = self.augmentPath(self.src, self.sink, float('inf'))\n            flow += result[0]\n            totalCost += result[1]\n        return [flow, totalCost]\n\ndef iterPath(to, frm, p):\n    path = []\n    cur = to\n    while cur != frm:\n        path.append(cur)\n        cur = p[cur]\n    path.reverse()\n    return path\n\nclass Edge:\n    def __init__(self, from_, to, cost):\n        self.from_ = from_\n        self.to = to\n        self.cost = cost\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0001314295077463612, -0.00036406738217920065, -9.088346359931165e-07, -7.302704761968926e-05, -0.0013128553982824087, -1.6405310816480778e-05, -0.7581690549850464, -0.6988969445228577, -0.009942012839019299, -1.3856492842023727e-06, -1.7432603272027336e-06, -5.532393932342529, -2.2784738540649414, -0.061762288212776184, -0.10690335929393768, -1.9361264946837764e-07, -0.17258818447589874, -0.2951759994029999, -9.088346359931165e-07, 0.0, -1.2948405128554441e-05, -0.0002072357019642368, -1.804750680923462, -3.2020991056924686e-05, -0.0019621781539171934, -0.0015387886669486761, -1.0325924449716695e-05, 0.0, -1.9361264946837764e-07, -1.9361264946837764e-07, 0.0, -1.747814349073451e-05, -9.088346359931165e-07, -2.816093228830141e-06, -8.2994620242971e-06, -1.6047699318733066e-05, -2.3080716346157715e-05, -1.9361264946837764e-07, -0.0003837213444057852, -0.0015179537003859878, -0.00017565040616318583, -0.1222788542509079, -1.747814349073451e-05, -2.696889623621246e-06, -3.128163257315464e-07, -5.200166469876422e-06, 0.0, -4.11996734328568e-05, -2.339278580620885e-06, -0.0821005180478096, -0.0007104054093360901, -1.22365403175354, -0.0028458870947360992, -0.1814902424812317, -0.07402126491069794, -0.005061313975602388, -0.0002036595979006961, -5.512236498361744e-07, -0.4742555022239685, -1.2268383502960205, -1.9361264946837764e-07, -0.007891705259680748, -0.0011013990733772516, -0.04860677942633629, -3.128163257315464e-07, -2.0184855461120605, -1.2664456789934775e-06, -0.08575917035341263, -0.3132631182670593, -0.06997033953666687, -1.652451464906335e-05, -1.3425219549390022e-05, 0.0, -7.3458322731312364