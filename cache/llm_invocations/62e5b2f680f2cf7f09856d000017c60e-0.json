 + 1, INF);\n        fill(current_head + 1, current_head + total_nodes + 1, head[1]);\n        distance[dst] = 0;\n        pq.push(PQNode(dst, 0));\n        \n        while (!pq.empty()) {\n            int u = pq.top().id;\n            pq.pop();\n            if (visited[u]) continue;\n            visited[u] = true;\n            \n            for (int i = head[u]; i; i = edges[i].next) {\n                int v = edges[i].to;\n                T w = potential[u] + edges[i ^ 1].cost - potential[v];\n                if (edges[i ^ 1].cap && distance[u] + w < distance[v]) {\n                    distance[v] = distance[u] + w;\n                    pq.push(PQNode(v, distance[v]));\n                }\n            }\n        }\n        \n        for (int i = 1; i <= total_nodes; ++i)\n            potential[i] = min(potential[i] + distance[i], INF);\n        \n        if (!visited[src]) return false;\n        fill(visited + 1, visited + total_nodes + 1, false);\n        return true;\n    }\n    \n    int augment(int u, int dst, int flow) {\n        if (u == dst || !flow) return flow;\n        int pushed = 0;\n        visited[u] = true;\n        \n        for (int& i = current_head[u]; i; i = edges[i].next) {\n            if (edges[i].cap) {\n                int v = edges[i].to;\n                int f;\n                if (!visited[v] && potential[v] + edges[i].cost == potential[u] &&\n                    (f = augment(v, dst, min(flow, edges[i].cap)))) {\n                    edges[i].cap -= f;\n                    edges[i ^ 1].cap += f;\n                    pushed += f;\n                    flow -= f;\n                    if (!flow) break;\n                }\n            }\n        }\n        \n        visited[u] = false;\n        return pushed;\n    }\n    \n    int max_flow;\n    T min_cost;\n    \n    void process(int src, int dst) {\n        while (shortest_path(src, dst)) {\n            int f = augment(src, dst, INF);\n            max_flow += f;\n            min_cost += (T)f