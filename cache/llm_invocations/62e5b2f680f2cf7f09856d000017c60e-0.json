ect(u, v, cap, cost):\n        nonlocal edge_count\n        edge_count += 1\n        edges[edge_count] = {'next': head[u], 'to': v, 'cap': cap, 'cost': cost}\n        head[u] = edge_count\n        edge_count += 1\n        edges[edge_count] = {'next': head[v], 'to': u, 'cap': 0, 'cost': -cost}\n        head[v] = edge_count\n    \n    def get_node(t, x):\n        return t * n + x + 2\n    \n    # Read k sources\n    for _ in range(k):\n        a = int(next(it))\n        connect(1, get_node(0, a), 1, 0)\n    \n    # Read m edges\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        adj_list[u].append(v)\n        adj_list[v].append(u)\n    \n    connect(get_node(0, 1), 2, INF, 0)\n    \n    # Build graph for time steps\n    for i in range(n + k + 1):\n        total_nodes += n\n        for u in range(1, n + 1):\n            for v in adj_list[u]:\n                for p in range(1, k + 1):\n                    connect(get_node(i, u), get_node(i + 1, v), 1, d * (2 * p - 1))\n        \n        for u in range(1, n + 1):\n            connect(get_node(i, u), get_node(i + 1, u), INF, 0)\n        \n        connect(get_node(i + 1, 1), 2, INF, c * (i + 1))\n    \n    # Min Cost Max Flow implementation\n    source_node = 1\n    sink_node = 2\n    \n    current_head = [0] * (total_nodes + 10)\n    visited = [False] * (total_nodes + 10)\n    distance = [INF] * (total_nodes + 10)\n    potential = [0] * (total_nodes + 10)\n    \n    class PQNode:\n        def __init__(self, id, priority):\n            self.id = id\n            self.priority = priority\n        \n        def __lt__(self, other):\n            return self.priority > other.priority\n    \n    def shortest_path(src, dst):\n        for i in range(1, total_nodes + 1):\n            distance[i] = INF\n        for i in range(1, total_nodes + 1):\n            current_head[i] = head[i]\n        distance[dst] = 0\n        pq = []\n        heapq.heappush(pq, PQNode(dst, 0))\n        \n        while pq