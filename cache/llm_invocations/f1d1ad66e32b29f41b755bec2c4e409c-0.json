o[v]]=true);\n    }\n    return dep[t]<iinf;\n}\npair<int,int> mcmf(){\n    pair<int,int> res(0,0);\n    while(spfa()){\n        int f=iinf;\n        for(int u=t;u!=s;u=to[pre[u]^1]) f=min(f,fw[pre[u]]);\n        for(int u=t;u!=s;u=to[pre[u]^1]) fw[pre[u]]-=f,fw[pre[u]^1]+=f;\n        res.x+=f,res.y+=dep[t]*f;\n    }\n    return res;\n}\n\n//Main\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0),cout.tie(0);\n    cin>>n>>m>>k>>c>>d,mxt=N*3+1;\n    fn=(t=(s=n*mxt)+1)+1;\n    R(i,0,k){int u;cin>>u,--u,adde(s,u,1,0);}\n    while(m--){\n        int u,v; cin>>u>>v,--u,--v;\n        R(i,0,mxt-1)R(p,1,k+1)\n            adde(i*n+u,(i+1)*n+v,1,2*d*p-d),\n            adde(i*n+v,(i+1)*n+u,1,2*d*p-d);\n    }\n    R(u,0,n)R(i,0,mxt-1) adde(i*n+u,(i+1)*n+u,k,0);\n    R(i,0,mxt) adde(i*n,t,k,i*c);\n    pair<int,int> ans=mcmf();\n    assert(ans.x==k);\n    cout<<ans.y<<'\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\n#Start\ninf = 0x3f3f3f3f\nclass Edge:\n    def __init__(self, to, w, c):\n        self.to = to\n        self.w = w\n        self.c = c\n\n#Data\nN = 50\nn, m, k, c, d, mxt = 0, 0, 0, 0, 0, N * 3 + 1\nfN = (N * 3 + 1) * N + 2\ns, t, fn = 0, 0, 0\ne = [[] for _ in range(fN)]\nto, fw, co = [], [], []\n\ndef add_edge(u, v, w, c):\n    e[u].append(len(to))\n    to.append(v)\n    fw.append(w)\n    co.append(c)\n    e[v].append(len(to))\n    to.append(u)\n    fw.append(0)\n    co.append(-c)\n\ndef spfa():\n    global dep, pre, vis\n    dep = [inf] * fn\n    pre = [-1] * fn\n    vis = [False] * fn\n    q = deque()\n    q.append(s)\n    vis[s] = True\n    dep[s] = 0\n    while q:\n        u = q.popleft()\n        vis[u] = False\n        for i in range(len(e[u])):\n            v = to[i]\n            if fw[i] and dep[v] > dep[u] + co[i]:\n                dep[v] = dep[u] + co[i]\n