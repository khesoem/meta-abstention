:longValue).toArray();\n\n        for (int mask = 0; mask < (1 << n); mask++) {\n            long val = m;\n            for (int i = 0; i < n; i++) {\n                if ((mask & (1 << i)) != 0) val += arr[i];\n            }\n            for (int i = n - 1; i >= 0; i--) {\n                if ((mask & (1 << i)) == 0 && val >= arr[i]) {\n                    val -= arr[i];\n                }\n            }\n            if (val == 0) {\n                answer.append(\"YES\\n\");\n                return;\n            }\n        }\n        answer.append(\"NO\\n\");\n    }\n\n    void flush() {\n        out.print(answer);\n        out.flush();\n    }\n\n    static class Reader {\n        private BufferedReader br;\n        private StringTokenizer st;\n\n        Reader() {\n            br = new BufferedReader(new InputStreamReader(System.in));\n        }\n\n        String next() {\n            try {\n                while (st == null || !st.hasMoreTokens()) {\n                    st = new StringTokenizer(br.readLine());\n                }\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n            return st.nextToken();\n        }\n\n        int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n}\n</your_rewritten_code_3>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <algorithm>\n#include <cmath>\n#include <climits>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\nconst int MI = 1000000000;\nconst long long ML = 1000000000000000000LL;\n\nclass Reader {\npublic:\n    string nextToken;\n    bool hasToken;\n    \n    Reader() : hasToken(false) {}\n    \n    string next() {\n        if (hasToken) {\n            hasToken = false;\n            return nextToken;\n        }\n        string line;\n      