mnf[sn]};\n}\npair<int,int>mcmf(int n)\n{\n  int flow=0,cost=0;\n  while(true)\n  {\n    pair<int,int>p=spfa(n);\n    if(!p.first)return {flow,cost};\n    flow+=p.first,cost+=p.second;\n  }\n}\n\nint main()\n{\n  ios_base::sync_with_stdio(0);cin.tie(0);\n  int n,m,k,c,d;cin>>n>>m>>k>>c>>d;\n  for(int i=1;i<=k;i++)\n  {\n    int x;cin>>x;fr[x]++;\n  }\n  for(int i=1;i<=m;i++)\n  {\n    int u,v;cin>>u>>v;\n    gr[u].push_back(v);\n    gr[v].push_back(u);\n  }\n  sr=0,sn=100*n+n+1;\n  for(int tm=0;tm<=99;tm++)\n  {\n    for(int i=1;i<=n;i++)\n    {\n      addEdge(n*tm+i,n*(tm+1)+i,k,0);\n      for(auto x:gr[i])\n      {\n        for(int cp=1;cp<=k;cp++)\n        {\n          addEdge(n*tm+i,n*(tm+1)+x,1,d*(2*cp-1));\n        }\n      }\n    }\n  }\n  for(int i=1;i<=n;i++)\n    if(fr[i])addEdge(sr,i,fr[i],0);\n  for(int tm=0;tm<=100;tm++)\n    addEdge(n*tm+1,sn,k,c*tm);\n  cout<<mcmf(sn).second<<endl;\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    fr = [0] * (n + 2)\n    for _ in range(k):\n        x = int(next(it))\n        fr[x] += 1\n    \n    gr = [[] for _ in range(n + 2)]\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        gr[u].append(v)\n        gr[v].append(u)\n    \n    sr = 0\n    sn = 100 * n + n + 1\n    \n    # Edge structure: [a, b, f, c, d]\n    ed = []\n    adj = [[] for _ in range(sn + 2)]\n    \n    def addEdge(a, b, c, d):\n        # Forward edge\n        ed.append([a, b, 0, c, d])\n        adj[a].append(len(ed) - 1)\n        # Backward edge\n        ed.append([b, a, 0, 0, -d])\n        adj[b].append(len(ed) - 1)\n    \n    for tm in range(100):\n        for i in range(1, n + 1):\n            addEdge(n * tm + i, n * (tm + 1) + i, k, 0)\n            for x in gr[i]:\n                for cp in range(1, k + 1):\n                    addEdge(n * tm + i, n * (tm + 1) + x, 1, d * (2 * cp - 1))\n    \n    for i in range(1, n + 1):\n        if fr[i]:\n            addEdge(sr, i, fr[i], 0)\n    \n    for tm in range(101):\n        addEdge(n * tm + 1, sn, k, c * tm)\n    \n    INF = 10**9\n    \n    def spfa(n):\n        dis = [INF] * (n + 2)\n        inq = [0] * (n + 2)\n        mnf = [0] * (n + 2)\n        pth = [-1] * (n + 2)\n        \n        dis[sr] = 0\n        inq[sr] = 1\n        mnf[sr] = INF\n        q = deque()\n        q.append(sr)\n        \n        while q:\n            u = q.popleft()\n            inq[u] = 0\n            for id in adj[u]:\n                v = ed[id][1]\n                if ed[id][3] > ed[id][2] and dis[v] > dis[u] + ed[id][4]:\n                    dis[v] = dis[u] + ed[id][4]\n                    pth[v] = id\n                    mnf[v] = min(mnf[u], ed[id][3] - ed[id][2])\n                    if not inq[v]:\n                        q.append(v)\n                        inq[v] = 1\n        \n        if dis[sn] == INF:\n            return (0, 0)\n        \n        v = sn\n        while v != sr:\n            id = pth[v]\n            ed[id][2] += mnf[sn]\n            ed[id ^ 1][2] -= mnf[sn]\n            v = ed[id][0]\n        \n        return (mnf[sn], dis[sn] * mnf[sn])\n    \n    def mcmf(n):\n        flow = 0\n        cost = 0\n        while True:\n            p = spfa(n)\n            if not p[0]:\n                return (flow, cost)\n            flow += p[0]\n            cost += p[1]\n    \n    result = mcmf(sn)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010251473577227443, -9.536738616588991e-07, -1.1920928244535389e-07, -0.01062816847115755, -0.009882924146950245, -