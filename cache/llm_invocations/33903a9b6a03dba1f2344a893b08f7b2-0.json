n    if (n % 2 == 1) {\n        cout << qpow(k, n) << endl;\n        return 0;\n    }\n    fac[0] = ifac[0] = f[0][0] = 1;\n    m = 1; lg = 0;\n    while (m <= n) { m <<= 1; ++lg; }\n    for (int i = 1; i <= n; ++i) {\n        inv[i] = (i == 1) ? 1 : 1LL * (mod - mod / i) * inv[mod % i] % mod;\n        fac[i] = 1LL * fac[i - 1] * i % mod;\n        ifac[i] = 1LL * ifac[i - 1] * inv[i] % mod;\n        cnt[i] = __builtin_popcount(i);\n        f[i][cnt[i]] = ifac[i];\n    }\n    v[n] = 1;\n    for (int i = n; i >= 1; --i) {\n        if (!v[i]) continue;\n        for (int j = i; j; j = (j - 1) & i)\n            v[j] = 1;\n    }\n    for (int step = 1; step < m; step <<= 1)\n        for (int j = 0; j <= n; ++j)\n            if (j & step) add(f[j], f[j ^ step], 1);\n    for (int i = 0; i <= n; ++i)\n        if (v[i]) fpm(f[i], k);\n    for (int step = 1; step < m; step <<= 1)\n        for (int j = 0; j <= n; ++j)\n            if (j & step) add(f[j], f[j ^ step], 0);\n    int res = (qpow(k, n) - 1LL * f[n][cnt[n]] * fac[n] % mod + mod) % mod;\n    cout << res << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n\n    # fast modular exponentiation\n    def qpow(a: int, b: int) -> int:\n        res = 1\n        while b:\n            if b & 1:\n                res = (res * a) % mod\n            a = (a * a) % mod\n            b >>= 1\n        return res\n\n    if n % 2 == 1:\n        print(qpow(k, n))\n        return\n\n    # compute m and lg (smallest power of two > n)\n    m = 1\n    lg = 0\n    while m <= n:\n        m <<= 1\n        lg += 1\n\n    # precompute factorials, inverse factorials, popcounts\n    fac = [0] * (n + 1)\n    ifac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    cnt = [0] * (n + 1)\n    fac[0] = ifac[0] = 1\n    for i in range(1, n + 1):\n        inv[i] = 1 if i == 1 else (mod - mod // i) * inv[mod % i] % mod\n        fac[i] = fac[i - 1] * i % mod\n        ifac[i] = ifac[i - 1] * inv[i] % mod\n        cnt[i] = i.bit_count()\n\n    # f[i] is a list of length lg, representing a polynomial\n    f = [[0] * lg for _ in range(n + 1)]\n    f[0][0] = 1\n    for i in range(1, n + 1):\n        f[i][cnt[i]] = ifac[i]\n\n    # v marks subsets of n\n    v = [0] * (n + 1)\n    v[n] = 1\n    for i in range(n, 0, -1):\n        if v[i]:\n            j = i\n            while j:\n                v[j] = 1\n                j = (j - 1) & i\n\n    # helper functions for polynomial operations\n    def add(a: list, b: list, fg: int) -> None:\n        # fg=1: add, fg=0: subtract\n        for i in range(lg):\n            if fg:\n                a[i] += b[i]\n            else:\n                a[i] += mod - b[i]\n            if a[i] >= mod:\n                a[i] -= mod\n\n    def mul(a: list, b: list) -> None:\n        c = [0] * lg\n        for i in range(lg):\n            if a[i] == 0:\n                continue\n            ai = a[i]\n            for j in range(lg - i):\n                c[i + j] = (c[i + j] + ai * b[j]) % mod\n        a[:] = c\n\n    def fpm(a: list, b: int) -> None:\n        ans = [0] * lg\n        ans[0] = 1\n        while b:\n            if b & 1:\n                mul(ans, a)\n            b >>= 1\n            if b:\n                mul(a, a)\n        a[:] = ans\n\n    # first subset transform (addition)\n    step = 1\n    while step < m:\n        for j in range(n + 1):\n            if j & step:\n                add(f[j], f[j ^ step], 1)\n        step <<= 1\n\n    # raise each subset polynomial to the k-th power\n    for i in range(n + 1):\n        if v[i]:\n            fpm(f[i], k)\n\n    # second subset transform (subtraction)\n    step = 1\n    while step < m:\n        for j in range(n + 1):\n         