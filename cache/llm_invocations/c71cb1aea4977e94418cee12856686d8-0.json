n    S = [''] + list(S_str)  # S[1]..S[N]\n\n    # precompute combinations up to N\n    comb = [[0] * (N + 1) for _ in range(N + 1)]\n    for i in range(N + 1):\n        comb[i][0] = 1\n        for j in range(1, i + 1):\n            comb[i][j] = comb[i-1][j-1] + comb[i-1][j]\n\n    prefA = [0] * (N + 1)\n    prefB = [0] * (N + 1)\n    for idx in range(1, N + 1):\n        prefA[idx] = prefA[idx-1] + (1 if S[idx] == 'A' else 0)\n        prefB[idx] = prefB[idx-1] + (1 if S[idx] == 'B' else 0)\n\n    good = [[] for _ in range(C + 2)]\n    bad = [[] for _ in range(C + 2)]\n\n    def diff(mask, a0, b0):\n        res = 0\n        for i in range(C + 1):\n            if mask & (1 << i):\n                b0 += 1\n                t1 = comb[b0 - 1][R - 1]\n                t2 = comb[N - b0][R] - comb[a0][R]\n                res -= t1 * t2\n            else:\n                a0 += 1\n                t1 = comb[a0 - 1][R - 1]\n                t2 = comb[N - a0][R] - comb[b0][R]\n                res += t1 * t2\n        return res\n\n    def valid(mask):\n        for i in range(C + 1):\n            idx = 2 * R + C + i\n            if S[idx] == 'A' and ((mask >> i) & 1):\n                return False\n            if S[idx] == 'B' and not ((mask >> i) & 1):\n                return False\n        return True\n\n    def build_second():\n        limit = 1 << (C + 1)\n        for mask in range(limit):\n            bcnt = mask.bit_count()\n            acnt = C + 1 - bcnt\n            val = diff(mask, R + C - acnt, R + C - bcnt)\n            if valid(mask):\n                good[acnt].append(val)\n            else:\n                bad[acnt].append(val)\n        for i in range(C + 2):\n            good[i].sort()\n            bad[i].sort()\n\n    def coeff(mask):\n        i = 0\n        while i < C + 1:\n            if ((mask >> i) & 1) != (mask & 1):\n                break\n            i += 1\n        for j in range(i, C + 1):\n            idx = 2 * R - 1 + j\n            if S[idx] == 'A' and