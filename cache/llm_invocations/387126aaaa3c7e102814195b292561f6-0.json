nd b == 3) or (a == 3 and b == 1):\n        return 1\n    return -1\n\ndef simulate(p1, p2):\n    total = 0\n    c1 = c2 = 0\n    while p1 or p2:\n        try:\n            if c1 == 0:\n                c1 = p1.pop()\n            if c2 == 0:\n                c2 = p2.pop()\n        except:\n            break\n\n        total += max(0, min(c1[0], c2[0]) * outcome(c1[1], c2[1]))\n        if c1[0] < c2[0]:\n            c2[0] -= c1[0]\n            c1 = 0\n        elif c1[0] > c2[0]:\n            c1[0] -= c2[0]\n            c2 = 0\n        else:\n            c1 = c2 = 0\n    return total\n\ndef compute_min():\n    base1 = [[rock1, 1], [sci1, 2], [paper1, 3]]\n    base2 = [[rock2, 1], [sci2, 2], [paper2, 3]]\n    perms1 = [list(p) for p in permutations(base1)]\n    perms2 = [list(p) for p in permutations(base2)]\n    \n    min_score = float('inf')\n    for p1 in perms1:\n        for p2 in perms2:\n            arr1 = [x[:] for x in p1]\n            arr2 = [x[:] for x in p2]\n            min_score = min(min_score, simulate(arr1, arr2))\n    return min_score\n\nprint(compute_min(), compute_max())\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cmath>\n#include <climits>\n#include <queue>\n#include <stack>\n#include <map>\n#include <set>\n#include <iomanip>\n#include <cstring>\n#include <numeric>\nusing namespace std;\n\nconst long long MOD = 998244353;\n\nvector<long long> factors(long long n) {\n    vector<long long> res;\n    for (long long i = 1; i <= (long long)sqrt(n); ++i) {\n        if (n % i == 0) {\n            res.push_back(i);\n            if (i != n / i) {\n                res.push_back(n / i);\n            }\n        }\n    }\n    sort(res.begin(), res.end());\n    res.erase(unique(res.begin(), res.end()), res.end());\n    return res;\n}\n\nlong long inv_mod(long long n) {\n    long long base = n, exp = MOD - 2, result = 1;\n    while (exp > 0) {\n        if (exp & 1) result = (result * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return result;\n}\n\nlong long get_int() {\n    long long x;\n    cin >> x;\n    return x;\n}\n\nvector<long long> get_ints() {\n    vector<long long> v(3);\n    for (int i = 0; i < 3; ++i) {\n        cin >> v[i];\n    }\n    return v;\n}\n\nlong long compute_max(long long rock1, long long sci1, long long paper1,\n                      long long rock2, long long sci2, long long paper2) {\n    return min(rock1, sci2) + min(sci1, paper2) + min(paper1, rock2);\n}\n\nint outcome(long long a, long long b) {\n    if (a == b) return 0;\n    else if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1))\n        return 1;\n    return -1;\n}\n\nlong long simulate(vector<vector<long long>>& p1, vector<vector<long long>>& p2) {\n    long long total = 0;\n    vector<vector<long long>> c1 = p1;\n    vector<vector<long long>> c2 = p2;\n    \n    reverse(c1.begin(), c1.end());\n    reverse(c2.begin(), c2.end());\n    \n    while (!c1.empty() || !c2.empty()) {\n        long long card1_count = 0, card1_type = 0;\n        long long card2_count = 0, card2_type = 0;\n        \n        if (!c1.empty()) {\n            card1_count = c1.back()[0];\n            card1_type = c1.back()[1];\n        }\n        if (!c2.empty()) {\n            card2_count = c2.back()[0];\n            card2_type = c2.back()[1];\n        }\n        \n        if (card1_count == 0 && card2_count == 0) break;\n        \n        if (card1_count > 0 && card2_count > 0) {\n            long long match = min(card1_count, card2_count);\n            total += max(0LL, match * outcome(card1_type, card2_type));\n            \n            if (card1_count < card2_count) {\n                c2.back()[0] -= card1_count;\n                c1.pop_back();\n            } else if (card1_count > card2_count) {\n                c1.back()[0] -