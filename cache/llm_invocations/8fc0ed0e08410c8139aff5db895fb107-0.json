) % MOD;\n                sum = (sum + alternating * term) % MOD;\n                alternating = -alternating;\n            }\n\n            if (sum < 0) sum += MOD;\n            sum = (sum * nCr(N, c)) % MOD;\n            if (k != 0) sum = (2 * sum) % MOD;\n\n            System.out.println((sum % MOD + MOD) % MOD);\n        } catch (IOException e) {\n            throw new RuntimeException(e);\n        }\n    }\n\n    static long nCr(int n, int r) {\n        if (r < 0 || r > n) return 0;\n        long denom = (factorialMemo[r] * factorialMemo[n - r]) % MOD;\n        return (factorialMemo[n] * modPow(denom, MOD - 2)) % MOD;\n    }\n\n    static long modPow(long base, int exp) {\n        long res = 1;\n        base %= MOD;\n        while (exp > 0) {\n            if ((exp & 1) == 1) res = (res * base) % MOD;\n            base = (base * base) % MOD;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</your_rewritten_code_5>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\n\nconst int MOD = 998244353;\nvector<long long> factorialMemo;\n\nlong long modPow(long long base, int exp) {\n    long long res = 1;\n    base %= MOD;\n    while (exp > 0) {\n        if ((exp & 1) == 1) res = (res * base) % MOD;\n        base = (base * base) % MOD;\n        exp >>= 1;\n    }\n    return res;\n}\n\nlong long nCr(int n, int r) {\n    if (r < 0 || r > n) return 0;\n    long long denom = (factorialMemo[r] * factorialMemo[n - r]) % MOD;\n    return (factorialMemo[n] * modPow(denom, MOD - 2)) % MOD;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    vector<string> tokens;\n    string token;\n    while (ss >> token) {\n        tokens.push_back(token);\n    }\n    \n    int N = stoi(