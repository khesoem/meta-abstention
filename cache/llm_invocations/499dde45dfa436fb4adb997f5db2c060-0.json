ed:\n                    break\n        return self.cost\n\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    kk = next(it)\n    c = next(it)\n    d = next(it)\n    a = [0] * (kk + 1)\n    for i in range(1, kk + 1):\n        a[i] = next(it)\n\n    N = n * 100 + 2\n    s = 0\n    t = n * 100 + 1\n    g = Flow(N)\n\n    # connect all time layers of node 1 to sink\n    for i in range(1, 101):\n        g.add_edge(i, t, 10**18, 0)\n\n    # waiting edges for nodes 2..n\n    for i in range(2, n + 1):\n        base = (i - 1) * 100\n        for j in range(1, 100):\n            g.add_edge(base + j, base + j + 1, 10**18, c)\n\n    # source to initial positions\n    for i in range(1, kk + 1):\n        g.add_edge(s, (a[i] - 1) * 100 + 1, 1, 0)\n\n    # movement edges\n    for _ in range(m):\n        t1 = next(it)\n        t2 = next(it)\n        for i in range(1, 100):\n            for j in range(1, kk + 1):\n                val = c + d * (j * j - (j - 1) * (j - 1))\n                g.add_edge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val)\n                g.add_edge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val)\n\n    print(g.dinic(s, t))\n\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-0.00125698687043041, -0.6940813660621643, -4.768370445162873e-07, -0.00030286493711173534, -0.00020037073409184813, -2.3841855067985307e-07, -5.602820692729438e-06, -0.0033006970770657063, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0297846682369709, -0.14701540768146515, -0.014225621707737446, -2.6940935640595853e-05, 0.0, -0.00255437009036541, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.3868885934352875, -0.0015265013789758086, 0.0, -3.576278118089249e-07, -0.2519370913505554, -3.576278118089249e-07, 0.0, -0.00011908298620255664, 0.0, -4.768370445162873e-07, -0.001179595128633082, 0.0, -1.1920928244535389