           q.push(e.to);\n                }\n            }\n        }\n        return level[T] >= 0;\n    }\n    int augment(int v, int f) {\n        if (v == T) return f;\n        for (int &i = work[v]; i < (int)graph[v].size(); ++i) {\n            Edge &e = graph[v][i];\n            if (level[e.to] == level[v] + 1 && e.cap > 0) {\n                int ret = augment(e.to, min(f, e.cap));\n                if (ret) {\n                    e.cap -= ret;\n                    graph[e.to][e.rev].cap += ret;\n                    return ret;\n                }\n            }\n        }\n        return 0;\n    }\n    ll solve() {\n        ll total = 0;\n        while (levelize()) {\n            fill(work.begin(), work.end(), 0);\n            while (true) {\n                int get = augment(S, 2e9);\n                if (!get) break;\n                total += get;\n            }\n        }\n        return total;\n    }\n};\n\nvoid bfs() {\n    queue<pair<int,int>> q;\n    q.push({sy, sx});\n    mark[sy][sx] = 1;\n    int depth = 1;\n    while (!q.empty()) {\n        int sz = (int)q.size();\n        for (int i = 0; i < sz; ++i) {\n            auto cur = q.front(); q.pop();\n            for (int k = 0; k < 4; ++k) {\n                int ny = cur.first + dy[k];\n                int nx = cur.second + dx[k];\n                if (ny < 0 || ny >= n || nx < 0 || nx >= n) continue;\n                if (mark[ny][nx] || mp[ny][nx] == 'Y') continue;\n                mark[ny][nx] = depth;\n                q.push({ny, nx});\n            }\n        }\n        ++depth;\n        depth = min(depth, tim);\n    }\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> n >> tim;\n    for (int i = 0; i < n; ++i) {\n        cin >> mp[i];\n        for (int j = 0; j < n; ++j)\n            if (mp[i][j] == 'Z') { sy = i; sx = j; }\n    }\n    getline(cin, mp[n]);\n    getline(cin, mp[n]);\n    for (int i = 0; i < n; ++i) cin >> goal[i];\n    bfs();\n    int cnt = 0;\n    f