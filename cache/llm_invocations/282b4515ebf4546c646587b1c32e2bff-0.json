data[0].split()\n    n = int(first[0])\n    tim = int(first[1])\n    # next n lines: mp\n    mp = [list(data[i+1]) for i in range(n)]\n    # next line: blank (skip)\n    # next line: first goal line (skip) - stored in mp[n] in C++ but unused\n    # then n lines: goal\n    # total lines: 1 + n + 1 + 1 + n = 2n+3\n    # index: 0: first, 1..n: mp, n+1: blank, n+2: first goal (skip), n+3..2n+2: goal\n    goal = [list(data[i]) for i in range(n+3, 2*n+3)]\n    # find start Z\n    sy = sx = -1\n    for i in range(n):\n        for j in range(n):\n            if mp[i][j] == 'Z':\n                sy, sx = i, j\n    # BFS to compute mark distances\n    mark = [[0]*n for _ in range(n)]\n    q = deque()\n    q.append((sy, sx))\n    mark[sy][sx] = 1\n    depth = 1\n    dy = [0, 0, 1, -1]\n    dx = [1, -1, 0, 0]\n    while q:\n        sz = len(q)\n        for _ in range(sz):\n            y, x = q.popleft()\n            for k in range(4):\n                ny = y + dy[k]\n                nx = x + dx[k]\n                if ny < 0 or ny >= n or nx < 0 or nx >= n:\n                    continue\n                if mark[ny][nx] or mp[ny][nx] == 'Y':\n                    continue\n                mark[ny][nx] = depth\n                q.append((ny, nx))\n        depth += 1\n        if depth > tim:\n            depth = tim\n    # nodeNo: 3D list, initialize to 0\n    nodeNo = [[[0]*(tim+2) for _ in range(n)] for _ in range(n)]\n    cnt = 0\n    for i in range(n):\n        for j in range(n):\n            if '0' <= mp[i][j] <= '9':\n                if mark[i][j] == 0:\n                    mark[i][j] = tim\n                for t in range(mark[i][j]):\n                    cnt += 1\n                    nodeNo[i][j][t] = cnt\n            if '1' <= goal[i][j] <= '9':\n                cnt += 1\n                nodeNo[i][j][mark[i][j]] = cnt\n    INF = 10**9\n    source = 0\n    sink = cnt + 3\n    flow = MaxFlow(cnt + 5, source, sink)\n    for i in range(n):\n        for j in range(n):\n            if '1' <= mp[i][j] <= '9':\n                flow.add_edge(source, nodeNo[i][j][0], ord(mp[i][j]) - ord('0'))\n            for d in range(4):\n                ny = i + dy[d]\n                nx = j + dx[d]\n                if ny < 0 or ny >= n or nx < 0 or nx >= n:\n                    continue\n                if mp[ny][nx] == 'Y' or mp[ny][nx] == 'Z':\n                    continue\n                t = 0\n                while True:\n                    if nodeNo[i][j][t] == 0:\n                        break\n                    if t == mark[i][j] and '1' <= goal[i][j] <= '9':\n                        break\n                    if nodeNo[ny][nx][t+1]:\n                        flow.add_edge(nodeNo[i][j][t], nodeNo[ny][nx][t+1], INF)\n                    t += 1\n            if '1' <= goal[i][j] <= '9':\n                for t in range(mark[i][j]):\n                    flow.add_edge(nodeNo[i][j][t], nodeNo[i][j][t+1], INF)\n                flow.add_edge(nodeNo[i][j][mark[i][j]], sink, ord(goal[i][j]) - ord('0'))\n    print(flow.max_flow())\n\nclass MaxFlow:\n    def __init__(self, V, s, t):\n        self.graph = [[] for _ in range(V)]\n        self.level = [0]*V\n        self.work = [0]*V\n        self.S = s\n        self.T = t\n    def add_edge(self, fr, to, cap):\n        self.graph[fr].append([to, cap, len(self.graph[to])])\n        self.graph[to].append([fr, 0, len(self.graph[fr])-1])\n    def bfs(self):\n        self.level = [-1]*len(self.graph)\n        q = deque()\n        q.append(self.S)\n        self.level[self.S] = 0\n        while q:\n            v = q.popleft()\n            for e in self.graph[v]:\n                if self.level[e[0]] < 0 and e[1] > 0:\n                    self.level[e[0]] = self.level[v] + 1\n                    q.append(e[0])\n        return self.level[self.T] >= 0\n    def dfs(self, v, f):\n        if v == self.T:\n            return f\n        for i in range(self.work[v], len(self.graph[v])):\n            e = self.graph[v][i]\n            if self.level[e[0]] == self.level[v] + 1 and e[1] > 0:\n                ret = self.dfs(e[0], min(f, e[1]))\n                if ret:\n                    e[1] -= ret\n                    self.graph[e[0]][e[2]][1] += ret\n                    return ret\n            self.work[v] += 1\n        return 0\n    def max_flow(self):\n        total = 0\n        while self.bfs():\n            self.work = [0]*len(self.graph)\n            while True:\n                f = self.dfs(self.S, 10**9)\n                if not f:\n                    break\n                total += f\n        return total\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-2.5152843591058627e-05, -0.1651301234960556, -0.0002643712505232543, 0.0, -2.3841855067985307e-07, -0.0019593106117099524, -0.0011267272057011724, -1.1920928244535389e-07, -3.0874729418428615e-05, -0.25600025057792664, -2.9802276912960224e-06, 0.0, -1.6689286894688848e-06, -0.160400390625, -1.0650354623794556, -0.17779582738876343, -0.03122631274163723, -1.4305104514278355e-06, -0.28835949301719666, -6.794906312279636e-06, -0.004141207784414291, 0.0, -7.581423415103927e-05, -8.344646857949556e-07, -0.014166387729346752, -0.0006017066189087927, -5.07818695041351e-05, -0.00012396997772157192, -0.7887428998947144, -0.9636106491088867, -5.364403477869928e-06, -0.06252209097146988, -3.933898824470816e-06, -0.28991371393203735, -1.0847986231965479e-05, -2.7418097943154862e-06, -0.44962990283966064, -0.20142249763011932, -0.0009155849111266434, -1.4781842764932662e-05, -1.4305104514278355e-06, -3.933898824470816e-06, -0.3132628798484802, -2.753696753643453e-05, -1.1920928244535389e-07, -0.04861355945467949, -0.003183061955496669, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -1.9073468138230965e-06, -0.00013398226292338222, 0.0, -7.83174327807501e-05, -7.402622577501461e-05, -1.1920928244535389e-07, -1.7881377516459906e-06, -5.960462772236497e-07, -4.76836021334747