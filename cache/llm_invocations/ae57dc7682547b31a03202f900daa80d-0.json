er(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int[] a = new int[n];\n        for (int i = 0; i < n; i++) {\n            a[i] = sc.nextInt();\n        }\n        int mid = n / 2;\n        int[] left = Arrays.copyOfRange(a, 0, mid);\n        int[] right = Arrays.copyOfRange(a, mid, n);\n\n        List<Integer> s1 = generate(left, m);\n        List<Integer> s2 = generate(right, m);\n        Collections.sort(s1);\n        Collections.sort(s2);\n\n        int best = 0;\n        for (int i : s1) {\n            int cur = (i + largestLessThan(s2, m - i)) % m;\n            if (cur > best) {\n                best = cur;\n            }\n        }\n        System.out.println(best);\n    }\n\n    private static List<Integer> generate(int[] part, int m) {\n        List<Integer> res = new ArrayList<>();\n        dfs(0, 0L, part, m, res);\n        return res;\n    }\n\n    private static void dfs(int pos, long total, int[] part, int m, List<Integer> res) {\n        if (pos == part.length) {\n            res.add((int)(total % m));\n            return;\n        }\n        dfs(pos + 1, total, part, m, res);\n        dfs(pos + 1, (total + part[pos]) % m, part, m, res);\n    }\n\n    private static int largestLessThan(List<Integer> lst, int x) {\n        int lo = 0, hi = lst.size() - 1;\n        int ans = 0;\n        while (lo <= hi) {\n            int mid = (lo + hi) / 2;\n            if (lst.get(mid) < x) {\n                ans = lst.get(mid);\n                lo = mid + 1;\n            } else {\n                hi = mid - 1;\n            }\n        }\n        return ans;\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.311301275563892e-06, 0.0, -1.1920928244535389e-07, -2.47952248173533e-05, -1.6569954823353328e-05, 0.0, -7.867782187531702e-06, -0.006983278319239616, -2.145764938177308e-06, 0.0, -2.622600959512056e-06, -0.00043156370520591736, -2.8609820219571702e-05, -0.011197110638022423, 0.0, -0.0003369