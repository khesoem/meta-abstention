nclude <algorithm>\n#include <cstring>\n#include <string>\n#include <sstream>\n#include <climits>\n#include <cstdlib>\n#include <cstdio>\n#include <deque>\n#include <queue>\n#include <stack>\n#include <set>\n#include <map>\n#include <bitset>\n#include <functional>\n#include <numeric>\nusing namespace std;\n\ntypedef long long ll;\n\nstruct FastReader {\n    // In C++ we use cin directly with sync\n    FastReader() {\n        ios_base::sync_with_stdio(false);\n        cin.tie(NULL);\n    }\n    int nextInt() {\n        int x;\n        cin >> x;\n        return x;\n    }\n    long long nextLong() {\n        long long x;\n        cin >> x;\n        return x;\n    }\n    double nextDouble() {\n        double x;\n        cin >> x;\n        return x;\n    }\n    string next() {\n        string s;\n        cin >> s;\n        return s;\n    }\n    string nextLine() {\n        string s;\n        getline(cin, s);\n        return s;\n    }\n};\n\nstruct Node {\n    ll pp;\n    ll a, b;\n    Node(ll x, ll y) : a(x), b(y), pp(a * b) {}\n};\n\nstruct Comp {\n    bool operator()(const Node& o1, const Node& o2) const {\n        return o1.pp < o2.pp;\n    }\n};\n\nint gcd(int x, int y) {\n    if (y == 0) return x;\n    return gcd(y, x % y);\n}\n\nlong long mod_pow(long long a, long long b, long long mod) {\n    a %= mod;\n    if (b == 0) return 1 % mod;\n    if (b & 1) return (a * mod_pow(a, b - 1, mod)) % mod;\n    long long u = mod_pow(a, b >> 1, mod);\n    return (u * u) % mod;\n}\n\nlong long _pow(long long a, long long b) {\n    if (b == 0) return 1;\n    if (b & 1) return a * _pow(a, b - 1);\n    long long u = _pow(a, b >> 1);\n    return u * u;\n}\n\nint modInv(int a, int m) {\n    if (gcd(a, m) != 1) return -999;\n    return (a % m + m) % m;\n}\n\nbool isPowerOfTwo(int x) {\n    return x != 0 && ((x & (x - 1)) == 0);\n}\n\nbool isprime(int x) {\n    for (int i = 2; i <= (int)sqrt(x); i++) {\n        if (x % i == 0) return false;\n    }\n    return true;\n}\n\nconst int INT_MAX = 1000007;\nvector<bool> prime(INT_MAX);\n\nvoid sieve() {\n    fill(prime.begin(), prime.end(), true);\n    prime[0] = prime[1] = false;\n    for (int i = 2; i <= (int)sqrt(INT_MAX); i++) {\n        if (prime[i]) {\n            for (int j = i * 2; j < INT_MAX; j += i) {\n                prime[j] = false;\n            }\n        }\n    }\n}\n\nstruct Pair {\n    int ff, ss;\n    Pair(int ff, int ss) : ff(ff), ss(ss) {}\n};\n\nint main() {\n    FastReader sc;\n    // For output, we use cout\n    int n = sc.nextInt();\n    int w = sc.nextInt();\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) a[i] = sc.nextInt();\n    int e = 0, o = 0;\n    vector<int> cuts;\n    for (int i = 0; i < n - 1; i++) {\n        if ((a[i] & 1) == 0) ++e;\n        else ++o;\n        if (e == o) cuts.push_back(abs(a[i] - a[i+1]));\n    }\n    n = cuts.size();\n    vector<vector<int>> dp(n + 1, vector<int>(w + 1, 0));\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= w; j++) {\n            if (cuts[i-1] <= j) {\n                dp[i][j] = max(1 + dp[i-1][j - cuts[i-1]], dp[i-1][j]);\n            } else {\n                dp[i][j] = dp[i-1][j];\n            }\n        }\n    }\n    int ans = dp[n][w];\n    cout << ans << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -0.00014506718434859067, -0.0006092122639529407, -0.00015901254664640874, -1.3132671117782593, -1.6689160474925302e-05, 0.0, 0.0, -0.00264711189083755, -2.264974000354414e-06, 0.0, 0.0, -1.5482105016708374, -4.005352093372494e-05, 0.0, 0.0, -0.1274213194847107, -2.3245540432981215e-05, -3.6954811548639555e-06, -1.1920928244535389e-07, -0.016313161700963974, -0.018507063388824463, -0.004629132803529501, -0.011064366437494755, -1.1920922133867862e-06, -2.6501266956329346, -0.0009707267745397985, -0.0011726891389116645, -3.576278118089249e-07, -0.10167711973190308, -2.3841855067985307e-07, -0.006750516593456268, -0.0052625699900090694, -2.6226