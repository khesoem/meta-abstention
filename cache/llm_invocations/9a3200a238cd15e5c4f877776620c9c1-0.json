{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\n\nconst int N=10005,S=N-2,T=N-1;\nconst int M=2e6+10;\nconst int inf=2e9;\n\nint head[N],to[M],nxt[M],w[M],c[M],cnt=1;\n\ninline void addedge(int x, int y, int flow, int cost){\n\tto[++cnt]=y,nxt[cnt]=head[x],head[x]=cnt;\n\tw[cnt]=flow,c[cnt]=cost;\n\tto[++cnt]=x,nxt[cnt]=head[y],head[y]=cnt;\n\tw[cnt]=0,c[cnt]=-cost;\n}\n\nqueue <int> q;\nlong long dis[N];\nbool mark[N];\n\ninline bool spfa(){\n\tmemset(mark,0,sizeof(mark));\n\tmemset(dis,0x3f,sizeof(dis));\n\tq.push(T); dis[T]=0; mark[T]=1;\n\twhile (!q.empty()){\n\t\tint x=q.front();\n\t\tmark[x]=0; q.pop();\n\t\tfor (int i=head[x];i;i=nxt[i]){\n\t\t\tint y=to[i];\n\t\t\tif (w[i^1]&&dis[y]>dis[x]+c[i^1]){\n\t\t\t\tdis[y]=dis[x]+c[i^1];\n\t\t\t\tif (!mark[y]){\n\t\t\t\t\tq.push(y); mark[y]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn dis[S]<1e18;\n}\n\ninline int dfs(int x, int lim, ll &cost){\n\tint flow=0; mark[x]=1;\n\tif (x==T) return lim;\n\tfor (int i=head[x];i;i=nxt[i]){\n\t\tint y=to[i];\n\t\tif (!w[i]||mark[y]) continue;\n\t\tif (dis[x]!=dis[y]+c[i]) continue;\n\t\tint t=dfs(y,min(w[i],lim-flow),cost);\n\t\tw[i]-=t; w[i^1]+=t;\n\t\tflow+=t; cost+=t*c[i];\n\t\tif (flow==lim) return lim;\n\t}\n\treturn flow;\n}\n\ninline ll costflow(){\n\tint flow=0; ll cost=0;\n\twhile (spfa())\n\t\tdo{\n\t\t\tmemset(mark,0,sizeof(mark));\n\t\t\tflow+=dfs(S,inf,cost);\n\t\t}while (mark[T]);\n\treturn cost;\n}\n\nint main(){\n\tint n,m,k,c,d,lim=101;\n\tcin>>n>>m>>k>>c>>d;\n\tfor (int i=0;i<k;i++){\n\t\tint x; cin>>x; x--;\n\t\taddedge(S,x,1,0);\n\t}\n\tfor (int i=0;i<lim;i++)\n\t\taddedge(i*n,T,k,c*i);\n\tfor (int i=0;i<n;i++)\n\t\tfor (int j=0;j<lim-1;j++)\n\t\t\taddedge(i+j*n,i+(j+1)*n,k,0);\n\twhile (m--){\n\t\tint x,y; cin>>x>>y; x--,y--;\n\t\tfor (int i=0;i<lim-1;i++)\n\t\t\tfor (int j=k-1;~j;j--){\n\t\t\t\taddedge(x+i*n,y+(i+1)*n,1,d*(j<<1|1));\n\t\t\t\taddedge(y+i*n,x+(i+1)*n,1,d*(j<<1|1));\n\t\t\t}\n\t}\n\tcout<<costflow();\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nsys.setrecursionlimit(1_000_000)\n\nINF = 10**18\nN = 10005\nS = N - 2\nT = N - 1\nLIM = 101\n\nhead = [-1] * (N + 5)\nto = []\nnxt = []\nw = []\nc = []\n\ndef add_edge(x, y, flow, cost):\n    # forward edge\n    to.append(y)\n    nxt.append(head[x])\n    head[x] = len(to) - 1\n    w.append(flow)\n    c.append(cost)\n    # reverse edge\n    to.append(x)\n    nxt.append(head[y])\n    head[y] = len(to) - 1\n    w.append(0)\n    c.append(-cost)\n\ndef spfa():\n    global dis, mark\n    dis = [INF] * N\n    mark = [False] * N\n    q = deque()\n    q.append(T)\n    dis[T] = 0\n    mark[T] = True\n    while q:\n        x = q.popleft()\n        mark[x] = False\n        i = head[x]\n        while i != -1:\n            y = to[i]\n            if w[i ^ 1] and dis[y] > dis[x] + c[i ^ 1]:\n                dis[y] = dis[x] + c[i ^ 1]\n                if not mark[y]:\n                    q.append(y)\n                    mark[y] = True\n            i = nxt[i]\n    return dis[S] < INF / 2\n\ndef dfs(x, lim, cost_list):\n    flow = 0\n    mark[x] = True\n    if x == T:\n        return lim\n    i = head[x]\n    while i != -1:\n        y = to[i]\n        if w[i] and not mark[y] and dis[x] == dis[y] + c[i]:\n            t = dfs(y, min(w[i], lim - flow), cost_list)\n            w[i] -= t\n            w[i ^ 1] += t\n            flow += t\n            cost_list[0] += t * c[i]\n            if flow == lim:\n                return flow\n        i = nxt[i]\n    return flow\n\ndef costflow():\n    total_cost = 0\n    while spfa():\n        while True:\n            mark = [False] * N\n            cost_container = [total_cost]\n            total_flow_added = dfs(S, INF, cost_container)\n            total_cost = cost_container[0]\n            if not mark[T]:\n                break\n    return total_cost\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c_param = next(it)\n    d_param = next(it)\n    people = [next(it) - 1 for _ in range(k)]\n\n    # source to initial positions\n    for x in people:\n        add_edge(S, x, 1, 0)\n\n    # edges to sink at each time step\n    for t in range(LIM):\n        add_edge(t * n, T, k, c_param * t)\n\n    # waiting edges\n    for node in range(n):\n        for t in range(LIM - 1):\n            add_edge(node + t * n, node + (t + 1) * n, k, 0)\n\n    # movement edges\n    for _ in range(m):\n        x = next(it) - 1\n        y = next(it) - 1\n        for t in range(LIM - 1):\n            for j in range(k - 1, -1, -1):\n                cost = d_param * (2 * j + 1)\n                add_edge(x + t * n, y + (t + 1) * n, 1, cost)\n                add_edge(y + t * n, x + (t + 1) * n, 1, cost)\n\n    print(costflow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00