nue;\n\t\tint t=dfs(y,min(w[i],lim-flow),cost);\n\t\tw[i]-=t; w[i^1]+=t;\n\t\tflow+=t; cost+=t*c[i];\n\t\tif (flow==lim) return lim;\n\t}\n\treturn flow;\n}\n\ninline ll costflow(){\n\tint flow=0; ll cost=0;\n\twhile (spfa())\n\t\tdo{\n\t\t\tmemset(mark,0,sizeof(mark));\n\t\t\tflow+=dfs(S,inf,cost);\n\t\t}while (mark[T]);\n\treturn cost;\n}\n\nint main(){\n\tint n,m,k,c,d,lim=101;\n\tcin>>n>>m>>k>>c>>d;\n\tfor (int i=0;i<k;i++){\n\t\tint x; cin>>x; x--;\n\t\taddedge(S,x,1,0);\n\t}\n\tfor (int i=0;i<lim;i++)\n\t\taddedge(i*n,T,k,c*i);\n\tfor (int i=0;i<n;i++)\n\t\tfor (int j=0;j<lim-1;j++)\n\t\t\taddedge(i+j*n,i+(j+1)*n,k,0);\n\twhile (m--){\n\t\tint x,y; cin>>x>>y; x--,y--;\n\t\tfor (int i=0;i<lim-1;i++)\n\t\t\tfor (int j=k-1;~j;j--){\n\t\t\t\taddedge(x+i*n,y+(i+1)*n,1,d*(j<<1|1));\n\t\t\t\taddedge(y+i*n,x+(i+1)*n,1,d*(j<<1|1));\n\t\t\t}\n\t}\n\tcout<<costflow();\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef solve() -> None:\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    lim = 101\n\n    N = 10005\n    S = N - 2\n    T = N - 1\n    INF = 10**18\n\n    head = [0] * N\n    to = [0]\n    nxt = [0]\n    w = [0]\n    cost_arr = [0]\n    cnt = 1\n\n    def add_edge(x: int, y: int, flow: int, cost: int) -> None:\n        nonlocal cnt\n        to.append(y)\n        nxt.append(head[x])\n        head[x] = cnt\n        w.append(flow)\n        cost_arr.append(cost)\n        cnt += 1\n        to.append(x)\n        nxt.append(head[y])\n        head[y] = cnt\n        w.append(0)\n        cost_arr.append(-cost)\n        cnt += 1\n\n    # read starting positions\n    for _ in range(k):\n        x = next(it) - 1\n        add_edge(S, x, 1, 0)\n\n    # sink edges from node 