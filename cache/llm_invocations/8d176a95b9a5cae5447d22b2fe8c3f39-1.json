   for j in range(n):\n            if a[i][j] == 'Z':\n                bi, bj = i, j\n    \n    dir_moves = [[0,1],[0,-1],[1,0],[-1,0]]\n    \n    def solve(A, B, vis, check):\n        que = deque()\n        vis[A*n+B] = 0\n        que.append((A, B))\n        \n        while que:\n            now = que.popleft()\n            p = now[0]*n + now[1]\n            dis = vis[p]\n            \n            if check and (mat[bi*n+bj][p] <= dis or t <= dis):\n                if mat[bi*n+bj][p] < dis or t < dis:\n                    vis[p] = INF + 1\n                continue\n            \n            for d in range(4):\n                i = dir_moves[d][0] + now[0]\n                j = dir_moves[d][1] + now[1]\n                if i < 0 or j < 0 or i == n or j == n:\n                    continue\n                if not ('0' <= b[i][j] <= '9'):\n                    continue\n                q = i*n + j\n                if vis[q] != INF:\n                    continue\n                vis[q] = dis + 1\n                que.append((i, j))\n    \n    solve(bi, bj, mat[bi*n+bj], False)\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= a[i][j] <= '9':\n                solve(i, j, mat[i*n+j], True)\n    \n    ca = []\n    cb = []\n    \n    cap = [[0] * (2 + n*n + n*n) for _ in range(2 + n*n + n*n)]\n    \n    for i in range(n):\n        for j in range(n):\n            if b[i][j] <= '0' or b[i][j] > '9':\n                continue\n            ca.append(i)\n            cb.append(j)\n            p = i*n + j\n            cap[p + 2 + n*n][1] = ord(b[i][j]) - ord('0')\n    \n    for i in range(n):\n        for j in range(n):\n            if a[i][j] <= '0' or a[i][j] > '9':\n                continue\n            p = i*n + j\n            cap[0][p + 2] = ord(a[i][j]) - ord('0')\n            for k in range(len(ca)):\n                ii = ca[k]\n                jj = cb[k]\n                q = ii*n + jj\n                if mat[p][q] < INF:\n                    cap[p 