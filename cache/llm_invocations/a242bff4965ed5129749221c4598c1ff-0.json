_cost += self.ptnl[dst] * resid\n                        aug = True\n                    if block != self.n:\n                        node = dst\n                        while node != block:\n                            shut[node] = True\n                            node = last[node].src\n                        shut[block] = True\n            if not aug:\n                break\n        for s in self.supp:\n            if s > 0:\n                return False\n        return True\n\n    def optimal(self):\n        return self.min_cost if self.flow() else -1\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    tlim = 105\n    total_nodes = n * (tlim + 1) + 1\n    mcf = MinCostFlow(total_nodes)\n    for _ in range(k):\n        j = next(it) - 1\n        mcf.supply(j, 1)\n    for _ in range(m):\n        u = next(it) - 1\n        v = next(it) - 1\n        for t in range(tlim):\n            nu = u + n\n            nv = v + n\n            for x in range(k):\n                mcf.add_edge(u, nv, 1, c + d * (x * 2 + 1))\n                mcf.add_edge(v, nu, 1, c + d * (x * 2 + 1))\n            u = nu\n            v = nv\n    for i in range(1, n):\n        for t in range(tlim):\n            mcf.add_edge(n * t + i, n * (t + 1) + i, k, c)\n    dst = mcf.n - 1\n    mcf.supply(dst, -k)\n    for t in range(tlim + 1):\n        mcf.add_edge(t * n, dst, k, 0)\n    print(mcf.optimal())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-4.672895011026412e-05, 0.0, -2.3841855067985307e-07, -0.0011744751827791333, -0.0005633435794152319, -0.0015023384476080537, -0.01104880403727293, -4.768370445162873e-07, -4.768360213347478e-06, -0.0004567056894302368, -6.425174069590867e-05, -6.318072337307967e-06, -4.768370445162873e-07, -1.4305104514278355e-06, -0.006733465939760208, 0.0, 0.0, -1.072