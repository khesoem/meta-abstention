  }\n            if (a != 1) throw new ArithmeticException(\"Not invertible\");\n            return make((int)((x % MOD + MOD) % MOD));\n        }\n        \n        Mint pow(long p) {\n            if (p < 0) return inv().pow(-p);\n            Mint res = new Mint(1);\n            Mint base = this;\n            while (p > 0) {\n                if ((p & 1) == 1) res = res.mul(base);\n                base = base.mul(base);\n                p >>= 1;\n            }\n            return res;\n        }\n        \n        public boolean equals(Object o) {\n            if (this == o) return true;\n            if (!(o instanceof Mint)) return false;\n            Mint m = (Mint) o;\n            return v == m.v;\n        }\n        public int hashCode() { return v; }\n        public String toString() { return Integer.toString(v); }\n    }\n    \n    static boolean B(int x, int i) {\n        return ((x >> i) & 1) == 1;\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int N = Integer.parseInt(st.nextToken());\n        \n        Mint[][] p = new Mint[N][N];\n        Mint inv100 = new Mint(100).inv();\n        for (int i = 0; i < N; i++) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < N; j++) {\n                int val = Integer.parseInt(st.nextToken());\n                p[i][j] = new Mint(val).mul(inv100);\n            }\n        }\n        \n        Map<BitSet, Mint> cur = new HashMap<>();\n        BitSet init = new BitSet(128);\n        init.set(0);\n        cur.put(init, new Mint(1));\n        \n        for (int i = 0; i < N; i++) {\n            Map<BitSet, Mint> nxt = new HashMap<>();\n            for (Map.Entry<BitSet, Mint> entry : cur.entrySet()) {\n                BitSet b = entry.getKey();\n                Mint prob = entry.getValue();\n                \n                List<Integer> ones = new ArrayList<>();\n                for (int j = b.nextSetBit(0); j >= 0; j = b.nextSetBit(j+1)) {\n                    ones.add(j);\n                }\n                \n                int maxE = 1 << N;\n                for (int e = 0; e < maxE; e++) {\n                    Mint pr = new Mint(1);\n                    for (int j = 0; j < N; j++) {\n                        if (B(e, j)) {\n                            pr = pr.mul(p[i][j]);\n                        } else {\n                            pr = pr.mul(new Mint(1).sub(p[i][j]));\n                        }\n                    }\n                    \n                    BitSet nb = new BitSet(128);\n                    for (int x : ones) {\n                        for (int r = 0; r < N; r++) {\n                            if (B(e, r) && !B(x, r)) {\n                                nb.set(x | (1 << r));\n                            }\n                        }\n                    }\n                    \n                    Mint add = prob.mul(pr);\n                    Mint old = nxt.get(nb);\n                    if (old == null) {\n                        nxt.put(nb, add);\n                    } else {\n                        nxt.put(nb, old.add(add));\n                    }\n                }\n            }\n            cur = nxt;\n        }\n        \n        Mint ans = new Mint(0);\n        int fullMask = (1 << N) - 1;\n        for (Map.Entry<BitSet, Mint> entry : cur.entrySet()) {\n            if (entry.getKey().get(fullMask)) {\n                ans = ans.add(entry.getValue());\n            }\n        }\n        pw.println(ans);\n        pw.flush();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.288792165927589e-05, 0.0, -4.768370445162873e-07, -3.0636318115284666e-05, -2.932505594799295e-05, -2.3841855067985307e-07, -0.16023284196853638, -0.0001752223033690825, 