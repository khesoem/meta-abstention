5 * g * m1;\n        double den = (g + b) * m3 * m4 / 6.0;\n        return den == 0 ? proba <= 0 : num / den >= proba;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\ndef check(good, bad, proba):\n    g = good\n    b = bad\n    m0 = max(0, b - 1)\n    m1 = max(0, g - 1)\n    m2 = max(0, g - 2)\n    m3 = max(0, g + b - 1)\n    m4 = max(0, g + b - 2)\n    num = 0.25 * b * m0 * g + g * (m1 * m2 / 6.0) + b * 0.5 * g * m1\n    den = (g + b) * m3 * m4 / 6.0\n    if den == 0:\n        return proba <= 0\n    else:\n        return num / den >= proba\n\ndef main():\n    line = input().strip()\n    idx = line.find(' ')\n    x = int(line[:idx].strip())\n    prob = float(line[idx + 1:].strip())\n    pos = x\n    step = x\n    while step > 0:\n        while pos - step >= 0 and check(pos - step, x - (pos - step), prob):\n            pos -= step\n        step //= 2\n    print(pos)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.401333666872233e-05, -7.152555099310121e-07, -3.576278118089249e-07, -0.0015061474405229092, -0.635041356086731, -0.03805449604988098, -8.583032467868179e-06, -0.001854725182056427, -5.125986263010418e-06, 0.0, -3.3378546504536644e-06, -8.344646857949556e-07, 0.0, -6.198863957251888e-06, -0.00010907054820563644, -1.7881377516459906e-06, -1.1920928244535389e-07, -2.539125671319198e-05, 0.0, -0.10025910288095474, -3.373566141817719e-05, 0.0, -4.768370445162873e-07, -2.861018856492592e-06, -2.145764938177308e-06, -3.576278118089249e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.6954811548639555e-06, 0.0, 0.0, -2.753696753643453e-05, -3.576278118089249e-07, 0.0, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -9.536738616588991e-07, -3.576278118089249e-07, -2.0265558760002023