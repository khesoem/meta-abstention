, sys.stdin.readline().strip().split()))\n        arr.append(row)\n    return arr\n\ndef ri():\n    return int(sys.stdin.readline().strip())\n\ndef rl():\n    return int(sys.stdin.readline().strip())\n\ndef rs():\n    return sys.stdin.readline().strip()\n\ndef gcd(a, b):\n    if b == 0:\n        return a\n    return gcd(b, a % b)\n\ndef bsearch(list_vals, val, ind):\n    l = ind\n    r = len(list_vals) - 1\n    res = len(list_vals)\n\n    while l <= r:\n        mid = (l + r) // 2\n        if list_vals[mid] > val:\n            if mid == 0:\n                return mid\n            if list_vals[mid - 1] <= val:\n                return mid\n            r = mid - 1\n        else:\n            l = mid + 1\n    return res\n\ndef calc(list_nodes, b, i):\n    if i == 3:\n        return 0\n\n    first = list_nodes[i]\n    bInd = first.ind - 1\n    if bInd == -1:\n        bInd = 2\n\n    min1 = min(first.val, b[bInd])\n    first.val -= min1\n    b[bInd] -= min1\n\n    min2 = min(first.val, b[first.ind])\n    first.val -= min2\n    b[first.ind] -= min2\n    sum_val = first.val\n    sum_val += calc(list_nodes, b, i + 1)\n    first.val += min1 + min2\n    b[bInd] += min1\n    b[first.ind] += min2\n\n    first = list_nodes[i]\n    bInd = first.ind - 1\n    if bInd == -1:\n        bInd = 2\n\n    min1 = min(first.val, b[first.ind])\n    first.val -= min1\n    b[first.ind] -= min1\n\n    min2 = min(first.val, b[bInd])\n    first.val -= min2\n    b[bInd] -= min2\n    sum2 = first.val\n    sum2 += calc(list_nodes, b, i + 1)\n    first.val += min1 + min2\n    b[bInd] += min2\n    b[first.ind] += min1\n\n    return min(sum_val, sum2)\n\ndef main():\n    ans = []\n    t = 1\n    for _ in range(t):\n        n = int(sys.stdin.readline().strip())\n        a = list(map(int, sys.stdin.readline().strip().split()))\n        b = list(map(int, sys.stdin.readline().strip().split()))\n\n        max_val = min(a[0], b[1]) + min(a[1], b[2]) + min(a[2], b[0])\n        min_val = max(0, a[0] + b[1] - n) 