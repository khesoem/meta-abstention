uilder();\n        while (c != -1 && !Character.isWhitespace(c)) {\n            sb.append((char) c);\n            c = dis.read();\n        }\n        return Long.parseLong(sb.toString());\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <string>\n#include <vector>\n\nlong long readLong() {\n    int c;\n    while ((c = std::cin.get()) != EOF && (c == ' ' || c == '\\n' || c == '\\t'));\n    std::string numStr;\n    while (c != EOF && c != ' ' && c != '\\n' && c != '\\t') {\n        numStr += static_cast<char>(c);\n        c = std::cin.get();\n    }\n    return std::stoll(numStr);\n}\n\nint main() {\n    long long n = readLong();\n    long long m = readLong();\n    \n    std::vector<long long> remainders(32, 0);\n    for (int i = 0; i < 30; i++) {\n        remainders[i] = m % n;\n        m /= n;\n    }\n    \n    bool result = true;\n    for (int i = 0; i < 30; i++) {\n        long long r = remainders[i];\n        if (r == 0 || r == 1) continue;\n        if (r == n || r == n - 1) {\n            remainders[i + 1]++;\n        } else {\n            result = false;\n            break;\n        }\n    }\n    \n    std::cout << (result ? \"YES\" : \"NO\") << std::endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000188332938705571, -4.768360213347478e-06, -3.576278118089249e-07, -6.103329360485077e-05, -7.152555099310121e-07, -8.702239938429557e-06, -2.3841830625315197e-06, -2.2172682292875834e-05, -3.576278118089249e-07, -0.12467548251152039, -0.007652491331100464, -0.001327943871729076, -3.099436753473128e-06, -1.350393295288086, -0.6326037049293518, -0.059047795832157135, -0.018163658678531647, -1.3112935448589269e-05, -0.0002466136065777391, -0.16037195920944214, -1.1920928244535389e-07, -4.768370445162873e-07, -0.21797484159469604, 0.0, -0.005939097609370947, -7.1525