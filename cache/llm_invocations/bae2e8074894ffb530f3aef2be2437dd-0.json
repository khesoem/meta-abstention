        return level[t] >= 0;\n    }\n    ll dfs(int v, ll f) {\n        if (v == t) return f;\n        for (int &i = it[v]; i < (int)g[v].size(); ++i) {\n            Edge &e = g[v][i];\n            if (e.cap > 0 && level[v] < level[e.to]) {\n                ll d = dfs(e.to, min(f, e.cap));\n                if (d > 0) {\n                    e.cap -= d;\n                    g[e.to][e.rev].cap += d;\n                    return d;\n                }\n            }\n        }\n        return 0;\n    }\n    ll max_flow() {\n        ll flow = 0;\n        while (bfs()) {\n            fill(it.begin(), it.end(), 0);\n            ll f;\n            while ((f = dfs(s, 1e18)) > 0) flow += f;\n        }\n        return flow;\n    }\n};\n\nint n, t;\nstring sci[15], cap[15];\nvector<vector<int>> dist;\nint dp[65][12][12][12][12];\n\nbool valid(int x, int y) {\n    if (x < 0 || y < 0 || x >= n || y >= n) return false;\n    if (sci[x][y] == 'Y' || sci[x][y] == 'Z') return false;\n    return true;\n}\n\nvoid bfs_zombie(int sx, int sy) {\n    dist.assign(n, vector<int>(n, -1));\n    queue<pii> q;\n    q.push({sx, sy});\n    dist[sx][sy] = 0;\n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        for (int i = 0; i < 4; ++i) {\n            int nx = x + dx[i], ny = y + dy[i];\n            if (valid(nx, ny) && dist[nx][ny] == -1) {\n                dist[nx][ny] = dist[x][y] + 1;\n                q.push({nx, ny});\n            }\n        }\n    }\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (dist[i][j] == -1) dist[i][j] = 1000000000;\n}\n\nbool reachable(int tt, int x0, int y0, int x, int y) {\n    if (dist[x0][y0] < tt) return 0;\n    if (x0 == x && y0 == y) return 1;\n    if (tt >= t) return 0;\n    if (dist[x0][y0] <= tt) return 0;\n    int &res = dp[tt][x0][y0][x][y];\n    if (res != -1) return res;\n    for (int i = 0; i < 4; ++i) {\n        int nx = x0 + dx[i], ny = y0 + dy[i];\n        if (nx < 0 || nx >= n || ny < 0 |