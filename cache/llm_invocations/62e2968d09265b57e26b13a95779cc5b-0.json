ase)\n        exp >>= 1\n    return res\n\ndef main():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    \n    dig = []\n    tmp = n\n    cnt = -1\n    while tmp:\n        dig.append(tmp % m)\n        tmp //= m\n        cnt += 1\n    \n    g = Matrix(m + 1)\n    g.a[0][m] = 1\n    \n    # Initialize f[0][i]\n    f = [[[Matrix(m + 1) for _ in range(m)] for __ in range(MAX_DIG)] for ___ in range(1)]\n    \n    for i in range(m):\n        for j in range(m + 1):\n            f[0][0][i].a[j][i] = 1\n            f[0][0][i].a[j][j] = 1\n    \n    # Precompute f[i][j] for i > 0\n    for i in range(1, cnt + 2):\n        f.append([Matrix(m + 1) for _ in range(m)])\n        pre = [Matrix(m + 1) for _ in range(m)]\n        suf = [Matrix(m + 1) for _ in range(m)]\n        \n        pre[0] = f[i-1][0].copy()\n        for j in range(1, m):\n            pre[j] = mul(pre[j-1], f[i-1][j])\n        \n        suf[m-1] = f[i-1][m-1].copy()\n        for j in range(m-2, -1, -1):\n            suf[j] = mul(f[i-1][j], suf[j+1])\n        \n        f[i][0] = suf[0].copy()\n        for j in range(1, m):\n            f[i][j] = mul(suf[j], pre[j-1])\n    \n    cur = 0\n    for i in range(cnt, -1, -1):\n        while dig[i] > 0:\n            g = mul(g, f[i][cur])\n            cur = (cur + 1) % m\n            dig[i] -= 1\n    \n    ans = 0\n    for i in range(m + 1):\n        ans = (ans + g.a[0][i]) % MOD\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.35\n</confidence>", "token_logprobs": [-0.0001389883691444993, -7.152555099310121e-07, -1.1920928244535389e-07, -0.007716371677815914, -0.00010477947944309562, -0.000631848000921309, -0.0701320692896843, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.0002616301644593477, 0.0, -1.168244216387393e-05, 0.0, -1.1920928244535389e-07, 0.0, -1.0728830375228426e-06, -1.1920928244