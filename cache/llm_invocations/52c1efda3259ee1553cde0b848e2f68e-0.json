   d[S] = 0;\n    queue<int> q;\n    q.push(S);\n    inq[S] = true;\n    \n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = false;\n        \n        for (int idx : G[u]) {\n            if (!resCap(idx)) continue;\n            int v = E[idx].to;\n            int c = E[idx].cost;\n            if (d[v] > d[u] + c) {\n                d[v] = d[u] + c;\n                par[v] = u;\n                pe[v] = idx;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    int cur = T;\n    while (cur != S) {\n        E[pe[cur]].flow++;\n        E[pe[cur] ^ 1].flow--;\n        cur = par[cur];\n    }\n}\n\nvoid addEdge(int u, int v, int cap, int cost) {\n    G[u].push_back(E.size());\n    E.emplace_back(v, cap, 0, cost);\n    G[v].push_back(E.size());\n    E.emplace_back(u, 0, 0, -cost);\n}\n\nint n, m, k, c, d;\n\nint main() {\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        scanf(\"%d\", &x);\n        --x;\n        addEdge(S, x, 1, 0);\n    }\n    \n    const int T_LAYERS = 101;\n    for (int t = 0; t < T_LAYERS; ++t) {\n        addEdge(t * n, T, k, t * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        scanf(\"%d %d\", &x, &y);\n        --x, --y;\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(x + t * n, y + t * n + n, 1, d * (2 * j + 1));\n            }\n        }\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            for (int j = 0; j < k; ++j) {\n                addEdge(y + t * n, x + t * n + n, 1, d * (2 * j + 1));\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < T_LAYERS - 1; ++t) {\n            addEdge(i + t * n, i + t * n + n, k, 0);\n        }\n    }\n    \n    ll ans = 0;\n    for (int i = 0; i < k; ++i) {\