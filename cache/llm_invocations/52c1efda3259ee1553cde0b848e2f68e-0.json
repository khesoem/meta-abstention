 k, c, d\n    \n    data = sys.stdin.readline().split()\n    n = int(data[0])\n    m = int(data[1])\n    k = int(data[2])\n    c = int(data[3])\n    d_val = int(data[4])\n    \n    for i in range(k):\n        x = int(sys.stdin.readline().strip())\n        x -= 1\n        addEdge(S, x, 1, 0)\n    \n    T_LAYERS = 101\n    for t in range(T_LAYERS):\n        addEdge(t * n, T, k, t * c)\n    \n    for i in range(m):\n        data = sys.stdin.readline().split()\n        x = int(data[0]) - 1\n        y = int(data[1]) - 1\n        for t in range(T_LAYERS - 1):\n            for j in range(k):\n                addEdge(x + t * n, y + t * n + n, 1, d_val * (2 * j + 1))\n        for t in range(T_LAYERS - 1):\n            for j in range(k):\n                addEdge(y + t * n, x + t * n + n, 1, d_val * (2 * j + 1))\n    \n    for i in range(n):\n        for t in range(T_LAYERS - 1):\n            addEdge(i + t * n, i + t * n + n, k, 0)\n    \n    ans = 0\n    for i in range(k):\n        spfa()\n        ans += d[T]\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002256377338198945, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.0012916326522827148, -0.0014910305617377162, -7.152555099310121e-07, -0.0005557184922508895, -0.00029059001826681197, -8.344646857949556e-07, -0.0002644904307089746, -0.00038961926475167274, -0.8094667196273804, -5.960462772236497e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -0.00012408917245920748, 0.0, -1.5497195136049413e-06, 0.0, -1.5497195136049413e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -3.504691630951129e-05, -0.03804359585046768, -0.0007350126979872584, -0.0019469369435682893, -3.576278118089249e-07, -3.802703940891661e-05, -1.1920928244535389e-07, -1.680836794548668e-05, -2.7894584491150454e-05, -1.537788011773955e-05, -2.3841855067985307e-07, 0.0, -2.264974000354414e-06, -8.34461570775602e-06, -0.0784296989440918, -8.