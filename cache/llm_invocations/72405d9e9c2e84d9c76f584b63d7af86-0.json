   \n            void convertToArray(){\n                ja = new Edge[N][];\n                for(int i = 0; i < N; i++){\n                    int sz = al[i].size();\n                    ja[i] = new Edge[sz];\n                    for(int j = 0; j < sz; j++){\n                        ja[i][j] = al[i].get(j);\n                    }\n                    al[i].clear();\n                }\n            }\n            \n            MinCostMaxFlow(int n , int source , int sink){\n                N = n; S = source; T = sink; maxFlow = 0; minCost = 0;\n                al = new ArrayList[N];\n                for(int i = 0; i < N; i++){\n                    al[i] = new ArrayList<>();\n                }\n            }\n            \n            int[] dist, prv, prve;\n            \n            boolean bellmanFord(){\n                dist = new int[N];\n                prv = new int[N];\n                prve = new int[N];\n                Arrays.fill(dist, gmax);\n                dist[S] = 0;\n                for(int i = 0; i < N-1; i++){\n                    boolean updated = false;\n                    for(int u = 0; u < N; u++){\n                        if(dist[u] == gmax) continue;\n                        for(int e = 0; e < ja[u].length; e++){\n                            Edge edge = ja[u][e];\n                            if(edge.flow == 0) continue;\n                            int v = edge.u;\n                            int nd = dist[u] + edge.cost;\n                            if(nd < dist[v]){\n                                dist[v] = nd;\n                                prv[v] = u;\n                                prve[v] = e;\n                                updated = true;\n                            }\n                        }\n                    }\n                    if(!updated) break;\n                }\n                return dist[T] != gmax;\n            }\n            \n            int augment(){\n                int p = T, min = gmax;\n                while(p != S){\n                    int u = prv[p], e = prve[p];\n                    min = Math.min(min, ja[u][e].flow);\n                    p = u;\n                }\n                p = T;\n                while(p != S){\n                    int u = prv[p], e = prve[p];\n                    ja[u][e].flow -= min;\n                    ja[p][ja[u][e].rid].flow += min;\n                    p = u;\n                }\n                maxFlow += min;\n                return min;\n            }\n            \n            void calBellmanFord(){\n                while(bellmanFord()){\n                    minCost += dist[T] * augment();\n                }\n            }\n        }\n        int n , m, k, c, d, a[], f[];\n       public void solve(int testNumber, InputReader in, PrintWriter out) {\n        n = in.nextInt(); m = in.nextInt(); k = in.nextInt(); c = in.nextInt(); d= in.nextInt();\n        int maxl = n + k, T = n * maxl + 1;\n        MinCostMaxFlow ans = new MinCostMaxFlow(T + 1, 0, T);\n        a = new int[k + 1]; f = new int[n + 1];\n        for(int i = 1; i <= k; i++){\n            a[i] = in.nextInt();\n            f[a[i]]++;\n        }\n        for(int i = 1; i <= n; i++){\n            if(f[i] == 0)continue;\n            ans.addEdge(0 , i , f[i], 0);\n        }\n        for(int i = 2; i <= n; i++){\n            for(int l = 0; l < maxl - 1; l++){\n                ans.addEdge(l * n + i , (l + 1) * n + i, k, c);\n            }\n        }\n        for(int i = 1; i <= m; i++){\n            int a = in.nextInt(), b = in.nextInt();\n            for(int l = 0; l < maxl - 1; l++){\n                for(int p = 1; p <= k; p++){\n                    if(a != 1)\n                        ans.addEdge(n * l + a, n * (l + 1) + b, 1, d * (2 * p - 1) + c);\n                    if(b != 1)\n                        ans.addEdge(n * l + b, n * (l + 1) + a, 1, d * (2 * p - 1) + c);\n                }\n            } \n        }\n        for(int l = 1; l < maxl; l++){\n            ans.addEdge(l * n + 1, T, k, 0);\n        }\n        ans.convertToArray();\n        ans.calBellmanFord();\n        if(ans.maxFlow != k){\n            out.println(\"BUG\");\n        }else{\n            out.println((int)ans.minCost);\n        }\n      }\n    }\n    static class InputReader {\n        BufferedReader br;\n        StringTokenizer st;\n        public InputReader(InputStream stream) {\n            br = new BufferedReader(new InputStreamReader(stream));\n            st = null;\n        }\n\n        String next() {\n            while (st == null || !st.hasMoreTokens()) {\n                String s = null;\n                try {\n                    s = br.readLine();\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n                if (s == null)\n                    return null;\n                st = new StringTokenizer(s);\n            }\n            return st.nextToken();\n        }\n\n        boolean hasMoreTokens() {\n            while (st == null || !st.hasMoreTokens()) {\n                String s = null;\n                try {\n                    s = br.readLine();\n                } catch (IOException e) {\n                    e.printStackTrace();\n                }\n                if (s == null)\n                    return false;\n                st = new StringTokenizer(s);\n            }\n            return true;\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n        public long nextLong() {\n            return Long.parseLong(next());\n        }\n        public double nextDouble() {\n            return Double.parseDouble(next());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nclass MinCostMaxFlow:\n    def __init__(self, N, S, T):\n        self.N = N\n        self.S = S\n        self.T = T\n        self.maxFlow = 0\n        self.minCost = 0\n        self.graph = [[] for _ in range(N)]\n        self.INF = 10**9\n\n    def addEdge(self, u, v, flow, cost):\n        # forward edge\n        forward = Edge(v, flow, cost, len(self.graph[v]))\n        # reverse edge\n        reverse = Edge(u, 0, -cost, len(self.graph[u]))\n        self.graph[u].append(forward)\n        self.graph[v].append(reverse)\n\n    def bellmanFord(self):\n        self.dist = [self.INF] * self.N\n        self.prv = [-1] * self.N\n        self.prve = [-1] * self.N\n        self.dist[self.S] = 0\n        for _ in range(self.N - 1):\n            updated = False\n            for u in range(self.N):\n                if self.dist[u] == self.INF:\n                    continue\n                for e_idx, edge in enumerate(self.graph[u]):\n                    if edge.flow == 0:\n                        continue\n                    v = edge.u\n                    nd = self.dist[u] + edge.cost\n                    if nd < self.dist[v]:\n                        self.dist[v] = nd\n                        self.prv[v] = u\n                        self.prve[v] = e_idx\n                        updated = True\n            if not updated:\n                break\n        return self.dist[self.T] != self.INF\n\n    def augment(self):\n        p = self.T\n        min_flow = self.INF\n        while p != self.S:\n            u = self.prv[p]\n            e_idx = self.prve[p]\n            edge = self.graph[u][e_idx]\n            min_flow = min(min_flow, edge.flow)\n            p = u\n        p = self.T\n        while p != self.S:\n            u = self.prv[p]\n            e_idx = self.prve[p]\n            edge = self.graph[u][e_idx]\n            edge.flow -= min_flow\n            # reverse edge\n            rev_idx = edge.rid\n            self.graph[p][rev_idx].flow += min_flow\n            p = u\n        self.maxFlow += min_flow\n        return min_flow\n\n    def calBellmanFord(self):\n        while self.bellmanFord():\n            self.minCost += self.dist[self.T] * self.augment()\n\n\nclass Edge:\n    __slots__ = ('u', 'flow', 'cost', 'rid')\n    def __init__(self, u, flow, cost, rid):\n        self.u = u\n        self.flow = flow\n        self.cost = cost\n        self.rid = rid\n\n\ndef solve():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    it = iter(data)\n    n = next(it)\n    m = next(it)\n    k = next(it)\n    c = next(it)\n    d = next(it)\n    maxl = n + k\n    T = n * maxl + 1\n    ans = MinCostMaxFlow(T + 1, 0, T)\n    a = [0] * (k + 1)\n    f = [0] * (n + 1)\n    for i in range(1, k + 1):\n        a[i] = next(it)\n        f[a[i]] += 1\n    for i in range(1, n + 1):\n        if f[i] == 0:\n            continue\n        ans.addEdge(0, i, f[i], 0)\n    for i in range(2, n + 1):\n        for l in range(maxl - 1):\n            ans.addEdge(l * n + i, (l + 1) * n + i, k, c)\n    for _ in range(m):\n        a_node = next(it)\n        b_node = next(it)\n        for l in range(maxl - 1):\n            for p in range(1, k + 1):\n                if a_node != 1:\n                    ans.addEdge(n * l + a_node, n * (l + 1) + b_node, 1, d * (2 * p - 1) + c)\n                if b_node != 1:\n                    ans.addEdge(n * l + b_node, n * (l + 1) + a_node, 1, d * (2 * p - 1) + c)\n    for l in range(1, maxl):\n        ans.addEdge(l * n + 1, T, k, 0)\n    ans.calBellmanFord()\n    if ans.maxFlow != k:\n        sys.stdout.write(\"BUG\\n\")\n    else:\n        sys.stdout.write(str(ans.minCost) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.049077656120061874, -4.6491513785440475e-06, -2.3841855067985307e-07, 0.0, -0.0001691436773398891, -0.001957882894203067, -2.3841855067985307e-07, -0.02987387776374817, -0.31586670875549316, -0.21350298821926117, 0.0, 0.0, 0.0, -7.033323527139146e-06, -2.0265558760002023e-06, -0.1931227296590805, -1.1920928244535389e-07, -1.192092824