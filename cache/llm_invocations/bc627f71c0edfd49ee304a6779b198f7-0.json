{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <map>\nusing namespace std;\n\nconst int MOD = 1000000007;\nconst int MAXN = 10;\n\nint a[MAXN][MAXN];\n\nint add(int x, int y) {\n    x += y;\n    return x >= MOD ? x - MOD : x;\n}\n\nint sub(int x, int y) {\n    x -= y;\n    return x < 0 ? x + MOD : x;\n}\n\nint mul(int x, int y) {\n    return (1LL * x * y) % MOD;\n}\n\nint power(int x, int e) {\n    int res = 1;\n    while (e) {\n        if (e & 1) res = mul(res, x);\n        x = mul(x, x);\n        e >>= 1;\n    }\n    return res;\n}\n\nint inv(int x) {\n    return power(x, MOD - 2);\n}\n\nint divv(int x, int y) {\n    return mul(x, inv(y));\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            a[i][j] = divv(a[i][j], 100);\n        }\n\n    map<vector<int>, int> dp;\n    dp[{0}] = 1;\n\n    for (int col = 0; col < n; ++col) {\n        map<vector<int>, int> ndp;\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prob = 1;\n            for (int row = 0; row < n; ++row) {\n                if (mask & (1 << row))\n                    prob = mul(prob, a[row][col]);\n                else\n                    prob = mul(prob, sub(1, a[row][col]));\n            }\n            for (auto &entry : dp) {\n                vector<int> newVec;\n                for (int m : entry.first) {\n                    int diff = (~m) & mask;\n                    while (diff) {\n                        int bit = diff & -diff;\n                        newVec.push_back(m | bit);\n                        diff ^= bit;\n                    }\n                }\n                if (newVec.empty()) continue;\n                sort(newVec.begin(), newVec.end());\n                newVec.erase(unique(newVec.begin(), newVec.end()), newVec.end());\n                int val = mul(entry.second, prob);\n                auto it = ndp.find(newVec);\n                if (it == ndp.end())\n                    ndp[newVec] = val;\n                else\n                    it->second = add(it->second, val);\n            }\n        }\n        dp = move(ndp);\n    }\n\n    int ans = 0;\n    for (auto &entry : dp)\n        ans = add(ans, entry.second);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static final int MOD = 1000000007;\n    static final int MAXN = 10;\n    static int[][] a = new int[MAXN][MAXN];\n\n    static int add(int x, int y) {\n        x += y;\n        if (x >= MOD) x -= MOD;\n        return x;\n    }\n\n    static int sub(int x, int y) {\n        x -= y;\n        if (x < 0) x += MOD;\n        return x;\n    }\n\n    static int mul(int x, int y) {\n        return (int)((long)x * y % MOD);\n    }\n\n    static int power(int x, int e) {\n        int res = 1;\n        while (e > 0) {\n            if ((e & 1) != 0) res = mul(res, x);\n            x = mul(x, x);\n            e >>= 1;\n        }\n        return res;\n    }\n\n    static int inv(int x) {\n        return power(x, MOD - 2);\n    }\n\n    static int divv(int x, int y) {\n        return mul(x, inv(y));\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        for (int i = 0; i < n; ++i) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; ++j) {\n                a[i][j] = Integer.parseInt(st.nextToken());\n                a[i][j] = divv(a[i][j], 100);\n            }\n        }\n\n        Map<List<Integer>, Integer> dp = new HashMap<>();\n        dp.put(new ArrayList<>(Collections.singletonList(0)), 1);\n\n        for (int col = 0; col < n; ++col) {\n            Map<List<Integer>, Integer> ndp = new HashMap<>();\n            int totalMasks = 1 << n;\n            for (int mask = 0; mask < totalMasks; ++mask) {\n                int prob = 1;\n                for (int row = 0; row < n; ++row) {\n                    if ((mask & (1 << row)) != 0)\n                        prob = mul(prob, a[row][col]);\n                    else\n                        prob = mul(prob, sub(1, a[row][col]));\n                }\n                for (Map.Entry<List<Integer>, Integer> entry : dp.entrySet()) {\n                    List<Integer> vec = entry.getKey();\n                    Set<Integer> newSet = new TreeSet<>();\n                    for (int m : vec) {\n                        int diff = (~m) & mask;\n                        while (diff != 0) {\n                            int bit = diff & -diff;\n                            newSet.add(m | bit);\n                            diff ^= bit;\n                        }\n                    }\n                    if (newSet.isEmpty()) continue;\n                    List<Integer> newVec = new ArrayList<>(newSet);\n                    int val = mul(entry.getValue(), prob);\n                    Integer existing = ndp.get(newVec);\n                    if (existing == null)\n                        ndp.put(newVec, val);\n                    else\n                        ndp.put(newVec, add(existing, val));\n                }\n            }\n            dp = ndp;\n        }\n\n        int ans = 0;\n        for (int val : dp.values()) {\n            ans = add(ans, val);\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0132739e-05, 0.0, 0.0, -0.0011737607, -8.6780594e-05, -1.6689287e-06, -0.10041567, -0.5766047, -0.00049471535, -4.553691e-05, -0.45637614, -0.0052998043, -5.435796e-05, -3.576278e-07, -0.0048466106, -0.003191261, -0.00020573408, -0.12843104, -6.4372807e-06, -0.00026127262, -1.1920928e-07, -1.1920928e-07, -7.3909487e-06, -0.018151835, -1.2755313e-05, -1.072883e-06, -2.264974e-06, -0.004110222, -0.00012373159, -6.5564896e-06, -0.0015037669, -5.960463e-07, -5.960463e-07, -2.5987287e-05, -1.1920928e-07, -1.3113013e-06, -3.3139633e-05, -0.038079742, -0.006717125, -1.1563234e-05, -0.001316991, -0.00040868513, -1.060957e-05, -0.0005057963, 0.0, 0.0, -5.2450712e-05, 0.0, -1.1920928e-07, -2.384183e-06, 0.0, -0.016044436, -1.4305105e-06, -0.0087429825, -1.4662635e-05, -9.298281e-06, -1.7642818e-05, 0.0, -2.3841855e-07, -3.576278e-07, 0.0, -2.3841855e-07, -4.2915253e-06, -2.3841855e-07, -2.3841574e-05, -1.668916e-05, 0.0, -3.576278e-07, -3.576278e-07, -4.0181518, -7.486063e-05, 0.0, -1.072883e-06, 0.0, -0.0004307296, -0.20173773, -4.76836e-06, -1.1920928e-07, -7.152555e-07, -1.1920928e-07, -2.467602e-05, 0.0, -1.060957e-05, -2.8610189e-06, -5.8530048e-05, -2.3841855e-07, -4.7683704e-07, 0.0, -5.0067774e-06, -1.1920922e-06, -1.1920928e-07, -1.1920928e-