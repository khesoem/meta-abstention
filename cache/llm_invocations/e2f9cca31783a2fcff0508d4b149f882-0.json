{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <queue>\n#include <algorithm>\n#include <climits>\n\nusing namespace std;\nusing llong = long long;\n\nstruct Edge {\n    int to;\n    llong cap;\n    llong cost;\n    int rev;\n};\n\nclass MCF {\n    vector<vector<Edge>> adj;\n    int n;\n\npublic:\n    MCF(int nodes) : n(nodes), adj(nodes) {}\n\n    void add_edge(int u, int v, llong c, llong w) {\n        adj[u].push_back({v, c, w, (int)adj[v].size()});\n        adj[v].push_back({u, 0, -w, (int)adj[u].size() - 1});\n    }\n\n    llong solve(int s, int t, llong f) {\n        vector<llong> dist(n, LLONG_MAX);\n        vector<llong> pot(n, 0);\n        vector<int> par_node(n), par_edge(n);\n\n        llong total_cost = 0;\n\n        while (f > 0) {\n            fill(dist.begin(), dist.end(), LLONG_MAX);\n            priority_queue<pair<llong, int>, vector<pair<llong, int>>, greater<pair<llong, int>>> pq;\n            dist[s] = 0;\n            pq.emplace(0, s);\n\n            while (!pq.empty()) {\n                auto [d, u] = pq.top(); pq.pop();\n                if (d != dist[u]) continue;\n                for (int i = 0; i < adj[u].size(); ++i) {\n                    auto& e = adj[u][i];\n                    if (e.cap > 0 && dist[e.to] > dist[u] + e.cost + pot[u] - pot[e.to]) {\n                        dist[e.to] = dist[u] + e.cost + pot[u] - pot[e.to];\n                        par_node[e.to] = u;\n                        par_edge[e.to] = i;\n                        pq.emplace(dist[e.to], e.to);\n                    }\n                }\n            }\n\n            if (dist[t] == LLONG_MAX) return -1;\n            for (int i = 0; i < n; ++i) pot[i] += dist[i];\n\n            llong flow = f;\n            for (int v = t; v != s; v = par_node[v]) {\n                flow = min(flow, adj[par_node[v]][par_edge[v]].cap);\n            }\n\n            f -= flow;\n            total_cost += flow * pot[t];\n\n            for (int v = t; v != s; v = par_node[v]) {\n                auto& e = adj[par_node[v]][par_edge[v]];\n                e.cap -= flow;\n                adj[v][e.rev].cap += flow;\n            }\n        }\n        return total_cost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    llong N, M, K, C, D;\n    cin >> N >> M >> K >> C >> D;\n\n    vector<int> A(K);\n    for (int i = 0; i < K; ++i) {\n        cin >> A[i];\n        --A[i];\n    }\n\n    vector<int> U(M), V(M);\n    for (int i = 0; i < M; ++i) {\n        cin >> U[i] >> V[i];\n        --U[i];\n        --V[i];\n    }\n\n    MCF network(N * 101 + 2);\n    int src = N * 101;\n    int dst = src + 1;\n\n    for (int i = 0; i < K; ++i) {\n        network.add_edge(src, A[i], 1, 0);\n    }\n\n    for (int day = 0; day <= 100; ++day) {\n        network.add_edge(day * N, dst, K, C * day);\n    }\n\n    for (int day = 0; day < 100; ++day) {\n        for (int node = 0; node < N; ++node) {\n            network.add_edge(day * N + node, (day + 1) * N + node, K, 0);\n        }\n        for (int edge_idx = 0; edge_idx < M; ++edge_idx) {\n            for (int k = 1; k <= K; ++k) {\n                network.add_edge(day * N + U[edge_idx], (day + 1) * N + V[edge_idx], 1, (2 * k - 1) * D);\n                network.add_edge(day * N + V[edge_idx], (day + 1) * N + U[edge_idx], 1, (2 * k - 1) * D);\n            }\n        }\n    }\n\n    cout << network.solve(src, dst, K) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nclass MCF:\n    def __init__(self, nodes):\n        self.n = nodes\n        self.adj = [[] for _ in range(nodes)]\n    \n    def add_edge(self, u, v, c, w):\n        self.adj[u].append(Edge(v, c, w, len(self.adj[v])))\n        self.adj[v].append(Edge(u, 0, -w, len(self.adj[u]) - 1))\n    \n    def solve(self, s, t, f):\n        dist = [float('inf')] * self.n\n        pot = [0] * self.n\n        par_node = [0] * self.n\n        par_edge = [0] * self.n\n        \n        total_cost = 0\n        \n        while f > 0:\n            dist = [float('inf')] * self.n\n            pq = []\n            dist[s] = 0\n            heapq.heappush(pq, (0, s))\n            \n            while pq:\n                d, u = heapq.heappop(pq)\n                if d != dist[u]:\n                    continue\n                for i in range(len(self.adj[u])):\n                    e = self.adj[u][i]\n                    if e.cap > 0 and dist[e.to] > dist[u] + e.cost + pot[u] - pot[e.to]:\n                        dist[e.to] = dist[u] + e.cost + pot[u] - pot[e.to]\n                        par_node[e.to] = u\n                        par_edge[e.to] = i\n                        heapq.heappush(pq, (dist[e.to], e.to))\n            \n            if dist[t] == float('inf'):\n                return -1\n            \n            for i in range(self.n):\n                pot[i] += dist[i]\n            \n            flow = f\n            v = t\n            while v != s:\n                flow = min(flow, self.adj[par_node[v]][par_edge[v]].cap)\n                v = par_node[v]\n            \n            f -= flow\n            total_cost += flow * pot[t]\n            \n            v = t\n            while v != s:\n                e = self.adj[par_node[v]][par_edge[v]]\n                e.cap -= flow\n                self.adj[v][e.rev].cap += flow\n                v = par_node[v]\n        \n        return total_cost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    K = int(data[idx]); idx += 1\n    C = int(data[idx]); idx += 1\n    D = int(data[idx]); idx += 1\n    \n    A = []\n    for i in range(K):\n        A.append(int(data[idx]) - 1)\n        idx += 1\n    \n    U = []\n    V = []\n    for i in range(M):\n        U.append(int(data[idx]) - 1)\n        idx += 1\n        V.append(int(data[idx]) - 1)\n        idx += 1\n    \n    network = MCF(N * 101 + 2)\n    src = N * 101\n    dst = src + 1\n    \n    for i in range(K):\n        network.add_edge(src, A[i], 1, 0)\n    \n    for day in range(101):\n        network.add_edge(day * N, dst, K, C * day)\n    \n    for day in range(100):\n        for node in range(N):\n            network.add_edge(day * N + node, (day + 1) * N + node, K, 0)\n        for edge_idx in range(M):\n            for k in range(1, K + 1):\n                network.add_edge(day * N + U[edge_idx], (day + 1) * N + V[edge_idx], 1, (2 * k - 1) * D)\n                network.add_edge(day * N + V[edge_idx], (day + 1) * N + U[edge_idx], 1, (2 * k - 1) * D)\n    \n    print(network.solve(src, dst, K))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000113361609692219