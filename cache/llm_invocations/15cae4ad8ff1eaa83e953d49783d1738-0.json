nsertEdge(source, (v - 1) * TIME_LIMIT + 1, 1, 0);\n        }\n        \n        // Time progression edges\n        for (int i = 1; i <= n; ++i) {\n            for (int t = 1; t < TIME_LIMIT; ++t) {\n                insertEdge((i - 1) * TIME_LIMIT + t, (i - 1) * TIME_LIMIT + t + 1, 100, c);\n            }\n        }\n        \n        // Bidirectional edges with capacity splitting\n        for (int i = 0; i < m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int t = 1; t < TIME_LIMIT; ++t) {\n                for (int j = 1; j <= 20; ++j) {\n                    int cost = c + (j * j - (j - 1) * (j - 1)) * d;\n                    insertEdge((u - 1) * TIME_LIMIT + t, (v - 1) * TIME_LIMIT + t + 1, 1, cost);\n                    insertEdge((v - 1) * TIME_LIMIT + t, (u - 1) * TIME_LIMIT + t + 1, 1, cost);\n                }\n            }\n        }\n        \n        System.out.println(computeMinCostFlow(source, sink));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001463782973587513, -1.7881377516459906e-06, -4.768370445162873e-07, -0.0017253764672204852, -4.3748852476710454e-05, -0.0297533106058836, -0.048691682517528534, -1.4662635294371285e-05, -5.960462772236497e-07, -0.00040665941196493804, -0.0015025765169411898, -7.986990567587782e-06, -0.011486350558698177, -0.5893549919128418, -0.006724111270159483, -6.317892984952778e-05, -6.079655122448457e-06, -3.790783375734463e-05, -0.00030620177858509123, -4.410734163684538e-06, -4.768370445162873e-07, 0.0, 0.0, -5.960462772236497e-07, -4.410734163684538e-06, -1.0728830375228426e-06, -1.4662635294371285e-05, -5.602820692729438e-06, -0.2812456786632538, 0.0, 0.0, 0.0, -1.5497195136049413e-06, 0.0, 0.0, -1.0728830375228426e-06, 0.0, -1.1920922133867862e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -9.536738616588991e-07, -7.152555099310121e-07, -5.960462772236497e-07, -1.19209