apacity > 0 && distance[e.to] > distance[u] + e.cost) {\n                distance[e.to] = distance[u] + e.cost;\n                prev_vertex[e.to] = u;\n                prev_edge[e.to] = i;\n                if (!inQueue[e.to]) {\n                    inQueue[e.to] = true;\n                    q.push(e.to);\n                }\n            }\n        }\n    }\n    return distance[sink] < INF;\n}\n\nint computeMinCostFlow(int source, int sink) {\n    int totalCost = 0;\n    while (shortestPath(source, sink)) {\n        int flow = INF;\n        for (int v = sink; v != source; v = prev_vertex[v]) {\n            flow = min(flow, graph[prev_vertex[v]][prev_edge[v]].capacity);\n        }\n        totalCost += distance[sink] * flow;\n        for (int v = sink; v != source; v = prev_vertex[v]) {\n            auto& e = graph[prev_vertex[v]][prev_edge[v]];\n            e.capacity -= flow;\n            graph[v][e.reverse].capacity += flow;\n        }\n    }\n    return totalCost;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int source = 0;\n    int sink = n * TIME_LIMIT + 1;\n    graph.resize(sink + 1);\n    distance.resize(sink + 1);\n    prev_vertex.resize(sink + 1);\n    prev_edge.resize(sink + 1);\n    \n    // Connect all nodes' final time layer to sink\n    for (int i = 1; i <= n; ++i) {\n        insertEdge((i - 1) * TIME_LIMIT + TIME_LIMIT, sink, 100, 0);\n    }\n    \n    // Connect source to initial positions\n    for (int i = 0; i < k; ++i) {\n        int v;\n        cin >> v;\n        insertEdge(source, (v - 1) * TIME_LIMIT + 1, 1, 0);\n    }\n    \n    // Time progression edges\n    for (int i = 1; i <= n; ++i) {\n        for (int t = 1; t < TIME_LIMIT; ++t) {\n            insertEdge((i - 1) * TIME_LIMIT + t, (i - 1) * TIME_LIMIT + t + 1, 100, c);\n        }\n    }\n    \n    // Bidirectional edges with capacity splitting\n    for (int i = 0; i < m; ++i) {\n