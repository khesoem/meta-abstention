return ModInt((a.val * b.val) % MOD);\n}\n\nModInt operator/(const ModInt& a, const ModInt& b) {\n    return a * ModInt(mod_pow(b.val, MOD - 2, MOD));\n}\n\nbool operator==(const ModInt& a, const ModInt& b) {\n    return a.val == b.val;\n}\n\nconst int MAX_N = 1 << 18;\nModInt fact[MAX_N], factinv[MAX_N];\n\nvoid init_factorials() {\n    fact[0] = 1;\n    for (int i = 0; i < MAX_N - 1; ++i) {\n        fact[i + 1] = fact[i] * (i + 1);\n    }\n    factinv[MAX_N - 1] = ModInt(1) / fact[MAX_N - 1];\n    for (int i = MAX_N - 2; i >= 0; --i) {\n        factinv[i] = factinv[i + 1] * (i + 1);\n    }\n}\n\nModInt comb(int n, int k) {\n    if (k < 0 || k > n) return ModInt(0);\n    return fact[n] * factinv[k] * factinv[n - k];\n}\n\nusing mP = pair<ModInt, ModInt>;\n\nmP mul(const mP& a, const mP& b) {\n    return {a.first * b.first, a.second * b.first + a.first * b.second};\n}\n\nmP add(const mP& a, const mP& b) {\n    return {a.first + b.first, a.second + b.second};\n}\n\nmP dp[501];\n\nvoid precompute() {\n    init_factorials();\n    dp[0] = {ModInt(1), ModInt(0)};\n    dp[1] = {ModInt(2), ModInt(0)};\n    for (int n = 2; n <= 500; ++n) {\n        for (int j = 0; j < n; ++j) {\n            ModInt cnt = n + 1;\n            ModInt sum = 0;\n            for (int k = 0; k < n; ++k) {\n                sum += abs(j - k);\n            }\n            mP cl = dp[j];\n            mP cr = dp[n - 1 - j];\n            mP x = mul(cl, cr);\n            x.first *= comb(n - 1, j);\n            x.second *= comb(n - 1, j);\n            x = mul(x, {cnt, sum});\n            dp[n] = add(dp[n], x);\n        }\n    }\n}\n\nmP dp2[502][501];\n\nvoid solve() {\n    int n, m;\n    cin >> n >> m;\n    cin >> MOD;\n    precompute();\n    dp2[0][0] = {ModInt(1), ModInt(0)};\n    for (int i = 0; i < n; ++i) {\n        for (int k = 0; k <= i; ++k) {\n            for (int j = i; j < n; ++j) {\n                int ni = min(j + 2, n);\n                int nk = k + j - i + 1;\n                if (nk <= m) {\