nsion; ++i)\n            for (int p = 1; p <= dimension; ++p)\n                for (int j = 1; j <= dimension; ++j)\n                    temp[i][j] += (i64)data[i][p] * rhs.data[p][j];\n        \n        for (int i = 1; i <= dimension; ++i)\n            for (int j = 1; j <= dimension; ++j)\n                result.data[i][j] = temp[i][j] % MOD;\n        \n        return result;\n    }\n};\n\nMatrix base_matrices[80][MAX_SIZE];\nMatrix prefix_products[80][MAX_SIZE];\nMatrix suffix_products[80][MAX_SIZE];\n\nvoid process() {\n    vector<int> digits;\n    i64 current = n;\n    while (current > 0) {\n        digits.push_back(current % k);\n        current /= k;\n    }\n    reverse(digits.begin(), digits.end());\n    \n    int num_digits = digits.size();\n    \n    for (int digit = 0; digit < k; ++digit) {\n        base_matrices[0][digit].dimension = k + 1;\n        base_matrices[0][digit].make_identity();\n        for (int col = 1; col <= k + 1; ++col) {\n            base_matrices[0][digit].data[digit + 1][col] = 1;\n        }\n    }\n    \n    prefix_products[0][0] = base_matrices[0][0];\n    suffix_products[0][k - 1] = base_matrices[0][k - 1];\n    \n    for (int digit = 1; digit < k; ++digit)\n        prefix_products[0][digit] = base_matrices[0][digit] * prefix_products[0][digit - 1];\n    \n    for (int digit = k - 2; digit >= 0; --digit)\n        suffix_products[0][digit] = suffix_products[0][digit + 1] * base_matrices[0][digit];\n    \n    for (int level = 1; level < num_digits; ++level) {\n        for (int digit = 0; digit < k; ++digit) {\n            if (digit == 0)\n                base_matrices[level][digit] = suffix_products[level - 1][digit];\n            else\n                base_matrices[level][digit] = prefix_products[level - 1][digit - 1] * suffix_products[level - 1][digit];\n        }\n        \n        prefix_products[level][0] = base_matrices[level][0];\n        suffix_products[level][k - 1] = base_matrices[level][k - 1];\n        \n        for (int d