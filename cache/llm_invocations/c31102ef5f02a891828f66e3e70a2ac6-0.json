{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconst ll INF = (ll)1e18;\nconst int MAXV = 6000;\n\nstruct Edge {\n    ll nxt, cap, cost, rev;\n};\n\nvector<Edge> graph[MAXV];\nll dist[MAXV];\nll preNode[MAXV], preEdge[MAXV];\nbool inqueue[MAXV];\nint nodeCount, source, sink;\n\nvoid initialize(int n, int s, int t) {\n    for (int i = 0; i <= n; ++i) graph[i].clear();\n    nodeCount = n;\n    source = s;\n    sink = t;\n}\n\nvoid add_edge(int u, int v, ll capacity, ll weight) {\n    graph[u].push_back({v, capacity, weight, (ll)graph[v].size()});\n    graph[v].push_back({u, 0, -weight, (ll)graph[u].size() - 1});\n}\n\nll min_cost_flow(ll flowLimit) {\n    ll answer = 0;\n    while (flowLimit > 0) {\n        fill(dist, dist + nodeCount, INF);\n        dist[source] = 0;\n        queue<int> q;\n        q.push(source);\n        inqueue[source] = true;\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inqueue[u] = false;\n            for (int i = 0; i < (int)graph[u].size(); ++i) {\n                Edge &e = graph[u][i];\n                if (e.cap > 0 && dist[u] + e.cost < dist[e.nxt]) {\n                    dist[e.nxt] = dist[u] + e.cost;\n                    preNode[e.nxt] = u;\n                    preEdge[e.nxt] = i;\n                    if (!inqueue[e.nxt]) {\n                        inqueue[e.nxt] = true;\n                        q.push(e.nxt);\n                    }\n                }\n            }\n        }\n        if (dist[sink] == INF) return -1;\n        ll pushed = flowLimit;\n        for (int v = sink; v != source; v = preNode[v])\n            pushed = min(pushed, graph[preNode[v]][preEdge[v]].cap);\n        flowLimit -= pushed;\n        answer += pushed * dist[sink];\n        for (int v = sink; v != source; v = preNode[v]) {\n            Edge &e = graph[preNode[v]][preEdge[v]];\n            e.cap -= pushed;\n            graph[v][e.rev].cap += pushed;\n        }\n    }\n    return answer;\n}\n\nll N, M, K, C, D;\nll A[58];\nvector<int> H[57];\n\nint32_t main() {\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cin >> N >> M >> K >> C >> D;\n    for (ll i = 1; i <= K; ++i) {\n        int x;\n        cin >> x;\n        A[x]++;\n    }\n    for (int i = 1; i <= M; ++i) {\n        int x, y;\n        cin >> x >> y;\n        H[x].push_back(y);\n        H[y].push_back(x);\n    }\n\n    initialize(5103, 0, 5101);\n    for (int i = 2; i <= N; ++i) add_edge(0, i, A[i], 0);\n    for (int i = 0; i <= 100; ++i) {\n        for (int l = 1; l <= N; ++l) {\n            add_edge(50 * i + l, 50 * (i + 1) + l, K, 0);\n            for (int j : H[l]) {\n                for (ll k = 1; k <= K; ++k) {\n                    add_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                }\n            }\n        }\n    }\n    for (int i = 1; i <= 101; ++i) add_edge(50 * i + 1, 5101, K, C * i);\n    cout << min_cost_flow(K) << endl;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\n\ndef min_cost_flow(graph, source, sink, flow_limit):\n    n = len(graph)\n    answer = 0\n    flow = flow_limit\n    dist = [0] * n\n    pre_node = [0] * n\n    pre_edge = [0] * n\n    inqueue = [False] * n\n\n    while flow > 0:\n        for i in range(n):\n            dist[i] = INF\n        dist[source] = 0\n        q = deque()\n        q.append(source)\n        inqueue[source] = True\n\n        while q:\n            u = q.popleft()\n            inqueue[u] = False\n            for i, (v, cap, cost, rev) in enumerate(graph[u]):\n                if cap > 0 and dist[u] + cost < dist[v]:\n                    dist[v] = dist[u] + cost\n                    pre_node[v] = u\n                    pre_edge[v] = i\n                    if not inqueue[v]:\n                        inqueue[v] = True\n                        q.append(v)\n\n        if dist[sink] == INF:\n            return -1\n\n        pushed = flow\n        v = sink\n        while v != source:\n            u = pre_node[v]\n            e = graph[u][pre_edge[v]]\n            pushed = min(pushed, e[1])  # cap\n            v = u\n\n        flow -= pushed\n        answer += pushed * dist[sink]\n\n        v = sink\n        while v != source:\n            u = pre_node[v]\n            edge_idx = pre_edge[v]\n            e = graph[u][edge_idx]\n            e[1] -= pushed\n            rev_idx = e[3]\n            graph[v][rev_idx][1] += pushed\n            v = u\n\n    return answer\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    A = [0] * (N + 1)\n    for _ in range(K):\n        x = int(next(it))\n        A[x] += 1\n\n    H = [[] for _ in range(N + 1)]\n    for _ in range(M):\n        x = int(next(it))\n        y = int(next(it))\n        H[x].append(y)\n        H[y].append(x)\n\n    # node indices: source=0, sink=5101, time-expanded nodes: 50*i + l for i=0..100, l=1..N\n    # total nodes needed: 5103 (0..5102)\n    node_count = 5103\n    source = 0\n    sink = 5101\n    graph = [[] for _ in range(node_count)]\n\n    def add_edge(u, v, cap, cost):\n        graph[u].append([v, cap, cost, len(graph[v])])\n        graph[v].append([u, 0, -cost, len(graph[u]) - 1])\n\n    # source to vertices 2..N\n    for i in range(2, N + 1):\n        if A[i] > 0:\n            add_edge(source, 50 * 0 + i, A[i], 0)\n\n    # time steps i=0..100\n    for i in range(0, 101):\n        for l in range(1, N + 1):\n            # wait edge\n            add_edge(50 * i + l, 50 * (i + 1) + l, K, 0)\n            # movement edges to neighbors\n            for j in H[l]:\n                for k in range(1, K + 1):\n                    add_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1))\n\n    # sink connections\n    for i in range(1, 102):\n        add_edge(50 * i + 1, sink, K, C * i)\n\n    result = min_cost_flow(graph, source, sink, K)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.079655122448457e-06, 0.0, 0.0, -0.00042143522296100855, -0.022317564114928246, -5.9602869441732764e-05, -1.966933996300213e-05, -7.70062324590981e-05, -1.6689286894688848e-06, 0.0, -1.4185804502631072e-05, -0.005326366052031517, -0.04925991967320442, -1.6689286894688848e-06, -0.0001161031104857102, -7.271740287251305e-06, -0.06196828559041023, -3.111314072157256e-05, -0.20160911977291107, -0.4969557523727417, -0.4151495099067688, -1.311301275563892e-06, -1.6689160474925302e-05, 0.0, -0.20559129118919373, -6.437280717364047e-06, -0.1612863689661026, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, -0.04110778868198395, -0.8259698152542114, -0.3132980763912201, -1.7881377516459906e-06, -0.015513811260461807, -0.0007376333815045655, -2.3841855067985307e-07, -9.536738616588991e