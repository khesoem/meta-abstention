ated_code>\nimport sys\nimport math\n\nINF = int(1e8)\n\nclass Node:\n    def __init__(self):\n        self.left = None\n        self.right = None\n        self.batchSetValue = 0\n        self.dirty = False\n        self.min = INF\n\n    def setValue(self, val):\n        self.min = val\n        self.batchSetValue = val\n        self.dirty = True\n\n    def pushDown(self):\n        if self.dirty:\n            if self.left:\n                self.left.setValue(self.batchSetValue)\n            if self.right:\n                self.right.setValue(self.batchSetValue)\n            self.dirty = False\n\n    def pushUp(self):\n        self.min = min(self.left.min if self.left else INF, self.right.min if self.right else INF)\n\n    @staticmethod\n    def build(l, r):\n        node = Node()\n        if l != r:\n            m = (l + r) >> 1\n            node.left = Node.build(l, m)\n            node.right = Node.build(m + 1, r)\n        return node\n\n    @staticmethod\n    def query(f, t, l, r, node):\n        if f > r or t < l:\n            return INF\n        if f <= l and r <= t:\n            return node.min\n        node.pushDown()\n        m = (l + r) >> 1\n        return min(Node.query(f, t, l, m, node.left), Node.query(f, t, m + 1, r, node.right))\n\n    @staticmethod\n    def update(i, l, r, val, node):\n        if i > r or i < l:\n            return\n        if l == r:\n            node.min = min(node.min, val)\n            return\n        node.pushDown()\n        m = (l + r) >> 1\n        Node.update(i, l, m, val, node.left)\n        Node.update(i, m + 1, r, val, node.right)\n        node.pushUp()\n\n    @staticmethod\n    def toArray(l, r, data, node):\n        if l == r:\n            data[l] = node.min\n            return\n        node.pushDown()\n        m = (l + r) >> 1\n        Node.toArray(l, m, data, node.left)\n        Node.toArray(m + 1, r, data, node.right)\n\n    @staticmethod\n    def fromArray(l, r, data, node):\n        if l == r:\n            node.min = data[l]\n            return\n        node.dirty = False\n        m = (l + r) >> 1\n        Node.fromArray(l, m, data, node.left)\n        Node.fromArray(m + 1, r, data, node.right)\n        node.pushUp()\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    n = int(input_data[0])\n    k = int(input_data[1])\n    intervals = [[0,0]] * (k + 2)\n    idx = 2\n    for i in range(1, k + 1):\n        intervals[i] = [int(input_data[idx]), int(input_data[idx + 1])]\n        idx += 2\n    intervals[k + 1] = [2 * n, 2 * n]\n    k += 1\n\n    loop = [None, None]\n    loop[0] = Node.build(0, n)\n    loop[1] = Node.build(0, n)\n\n    data = [0] * (n + 1)\n\n    for i in range(1, k + 1):\n        curDp = loop[i & 1]\n        lastDp = loop[(i - 1) & 1]\n        interval = intervals[i]\n        intervalLength = interval[1] - interval[0]\n        middleLength = interval[0] - intervals[i - 1][1]\n\n        Node.toArray(0, n, data, lastDp)\n        copy_start = min(len(data), intervalLength + middleLength)\n        for j in range(copy_start):\n            data[j] = data[j]\n        for j in range(copy_start, len(data)):\n            data[j] = 0\n        for j in range(min(len(data), intervalLength + middleLength)):\n            data[j] = INF\n\n        minX = interval[1] - middleLength - intervalLength\n        maxX = interval[1] - middleLength\n        for j in range(n + 1):\n            minNeedTime = Node.query(minX - j, maxX - j, 0, n, lastDp)\n            data[j] = min(data[j], minNeedTime + 1)\n\n        for j in range(n + 1):\n            minNeedTime = Node.query(j - middleLength - intervalLength, j - middleLength, 0, n, lastDp)\n            data[j] = min(data[j], minNeedTime + 2)\n\n        Node.fromArray(0, n, data, curDp)\n\n    minFlipTime = Node.query(n, n, 0, n, loop[k & 1])\n\n    if minFlipTime < INF:\n        print(\"Full\")\n        print(minFlipTime)\n    else:\n        print(\"Hungry\")\n\nif __name__ == \"__main__\":\n    solve()\n\n</translated_code>\n<co