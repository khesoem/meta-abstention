OD;\n        }\n        \n        System.out.println(ans);\n    }\n    \n    public static long modPow(long base, long exp, long mod) {\n        long res = 1;\n        base = ((base % mod) + mod) % mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                res = (res * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return res;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_pow(base, exp, mod):\n    res = 1\n    base = ((base % mod) + mod) % mod\n    while exp > 0:\n        if (exp & 1) == 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.read().split()\n    idx = 0\n    \n    S = [[0] * 5005 for _ in range(5005)]\n    MOD = 998244353\n    \n    S[0][0] = 1\n    for i in range(1, 5001):\n        S[i][0] = 0\n        S[i][i] = 1\n        for j in range(1, i + 1):\n            S[i][j] = (S[i-1][j] * j % MOD + S[i-1][j-1]) % MOD\n    \n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    \n    m = mod_pow(m, MOD - 2, MOD)\n    \n    dp = [0] * 5005\n    dp[0] = 1\n    limit = min(n, k)\n    for i in range(1, limit + 1):\n        dp[i] = dp[i-1] * ((n - i + 1) % MOD) % MOD\n    \n    ans = 0\n    for i in range(1, limit + 1):\n        term = dp[i]\n        term = (term * mod_pow(m, i, MOD)) % MOD\n        term = (term * S[k][i]) % MOD\n        ans = (ans + term) % MOD\n    \n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.911301948595792e-05, -8.344646857949556e-07, -3.576278118089249e-07, -0.4749591648578644, -0.03441314399242401, -0.0004349001101218164, -0.0022512348368763924, -0.11284322291612625