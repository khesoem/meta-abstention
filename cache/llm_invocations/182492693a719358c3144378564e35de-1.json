  int[] a3 = new int[3];\n        int[] b1 = new int[3];\n        int[] b2 = new int[3];\n        int[] b3 = new int[3];\n\n        for (int i = 0; i < 3; i++) {\n            a1[i] = scanner.nextInt();\n            a2[i] = scanner.nextInt();\n            a3[i] = scanner.nextInt();\n            b1[i] = scanner.nextInt();\n            b2[i] = scanner.nextInt();\n            b3[i] = scanner.nextInt();\n        }\n\n        int mx = Math.min(a1[0], b2[0]) + Math.min(a2[0], b3[0]) + Math.min(a3[0], b1[0]);\n        int temp = 0;\n\n        List<int[]> permutations = new ArrayList<>();\n        for (int i = 0; i < 6; i++) {\n            permutations.add(new int[]{1, 2, 3, 4, 5, 6});\n            Collections.swap(permutations.get(permutations.size() - 1), i, i + 1);\n        }\n\n        for (int[] permutation : permutations) {\n            int[] ta1 = Arrays.copyOf(a1, 3);\n            int[] ta2 = Arrays.copyOf(a2, 3);\n            int[] ta3 = Arrays.copyOf(a3, 3);\n            int[] tb1 = Arrays.copyOf(b1, 3);\n            int[] tb2 = Arrays.copyOf(b2, 3);\n            int[] tb3 = Arrays.copyOf(b3, 3);\n\n            int tmx = 0;\n            for (int el : permutation) {\n                int t1 = 0;\n                if (el == 1) {\n                    t1 = Math.min(ta1[0], tb1[0]);\n                    ta1[0] -= t1;\n                    tb1[0] -= t1;\n                    tmx += t1;\n                } else if (el == 2) {\n                    t1 = Math.min(ta1[0], tb3[0]);\n                    ta1[0] -= t1;\n                    tb3[0] -= t1;\n                    tmx += t1;\n                } else if (el == 3) {\n                    t1 = Math.min(ta2[0], tb2[0]);\n                    ta2[0] -= t1;\n                    tb2[0] -= t1;\n                    tmx += t1;\n                } else if (el == 4) {\n                    t1 = Math.min(ta2[0], tb1[0]);\n                    tb1[0] -= t1;\n                    ta2[0] -= t1;\n                    tmx += t1;\n                } else if (el == 5) {\n                    t1 = Math.min(ta3[0], tb3[0]);\n                    ta3[0] -= t1;\n                    tb3[0] -= t1;\n                    tmx += t1;\n                } else if (el == 6) {\n                    t1 = Math.min(ta3[0], tb2[0]);\n                    tb2[0] -= t1;\n                    ta3[0] -= t1;\n                    tmx += t1;\n                }\n            }\n            temp = Math.max(temp, tmx);\n        }\n        writer.println(n - temp + \" \" + mx);\n    }\n\n    public static long modpow(long a, long p) {\n        long ans = 1;\n        while (p > 0) {\n            if ((p & 1) == 1) {\n                ans = (ans * a) % MOD;\n            }\n            p >>= 1;\n            a = (a * a) % MOD;\n        }\n        return ans;\n    }\n\n    public static long fac_cal(int n) {\n        long ans = 1;\n        for (int i = 1; i <= n; i++) {\n            ans = (ans * i) % MOD;\n        }\n        return ans;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>\n```", "token_logprobs": [-0.4515082836151123, -0.018318038433790207, -0.001941119902767241, -0.06018659844994545, -0.009986569173634052, -0.11410398036241531, -0.0017555856611579657, -0.00025412687682546675, -0.14409670233726501, -0.37447160482406616, -0.0007260692655108869, -0.00034505120129324496, -0.09285657107830048, -0.5657084584236145, -0.017015336081385612, -6.6757424974639434e-06, -0.027656223624944687, -0.3144245743751526, -0.16836592555046082, -0.8409931659698486, -0.003788306377828121, -0.45592164993286133, -0.7295657396316528, -0.00117102253716439, -0.0020003642421215773, -0.6329972743988037, -0.004810919985175133, -0.00893525779247284, -0.27263638377189636, -2.47958396357717e-05, -0.0001432998396921903, -2.849142583727371e-05, -0.00044588252785615623, -3.922062387573533e-05, -2.5868750526569784e-05, -0.6933488249778748, -0.0002659316814970225, -0.0327116958796978, -0.001332574407570064, -0.6965209245681763, -1.0581681728363037, -0.8456161022186279