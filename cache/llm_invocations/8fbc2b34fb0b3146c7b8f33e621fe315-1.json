                       heapq.heappush(que, (self.dist[e.to], e.to))\n            \n            if self.dist[t] == float('inf'):\n                return -1\n            \n            for v in range(self.V):\n                self.h[v] += self.dist[v]\n            \n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[self.prevv[v]][self.preve[v]].cap)\n                v = self.prevv[v]\n            \n            f -= d\n            res += d * self.h[t]\n            \n            v = t\n            while v != s:\n                e = self.G[self.prevv[v]][self.preve[v]]\n                e.cap -= d\n                self.G[v][e.rev].cap += d\n                v = self.prevv[v]\n        \n        return res\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    a = [0] * k\n    for i in range(k):\n        a[i] = int(data[idx]); idx += 1\n    \n    cnt = [0] * n\n    for i in range(k):\n        cnt[a[i] - 1] += 1\n    \n    e = [[] for _ in range(n)]\n    for _ in range(m):\n        x = int(data[idx]) - 1; idx += 1\n        y = int(data[idx]) - 1; idx += 1\n        e[x].append(y)\n        e[y].append(x)\n    \n    T = 100\n    mcf = MIN_COST_FLOW()\n    mcf.init(n * T + 2)\n    \n    for i in range(n):\n        mcf.add_edge(n * T, i, cnt[i], 0)\n    \n    for i in range(T):\n        mcf.add_edge(i * n, n * T + 1, k, c * i)\n    \n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(j * n + i, (j + 1) * n + i, k, 0)\n        \n        for to in e[i]:\n            for j in range(T - 1):\n                for u in range(k):\n                    cost = (u + 1) * (u + 1) * d - u * u * d\n                    mcf.add_edge(j * n + i, (j + 1) * n + to, 1, cost)\n    \n    print(mcf.min_cost_flow(n * 