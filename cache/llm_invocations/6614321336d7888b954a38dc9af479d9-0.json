RS = MAXCOMP\n\nclass Res:\n    def __init__(self, ways=0, summaddness=0):\n        self.ways = ways\n        self.summaddness = summaddness\n\ndef calcsum(l, r):\n    return (l + r) * (r - l + 1) // 2\n\ndef main():\n    global ncomp, npers, MOD, choose, done2, mem2, done1, mem1\n    \n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    ncomp = int(input_data[0])\n    npers = int(input_data[1])\n    MOD = int(input_data[2])\n    \n    # Initialize choose table\n    choose = [[0] * (MAXCOMP + 1) for _ in range(MAXCOMP + 1)]\n    for i in range(MAXCOMP + 1):\n        choose[i][0] = choose[i][i] = 1\n        for j in range(1, i):\n            choose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD\n    \n    # Initialize memoization structures for go2\n    done2 = [False] * (MAXCOMP + 1)\n    mem2 = [Res() for _ in range(MAXCOMP + 1)]\n    \n    # Initialize memoization structures for go1\n    done1 = [[False] * (MAXPERS + 1) for _ in range(MAXCOMP)]\n    mem1 = [[Res() for _ in range(MAXPERS + 1)] for _ in range(MAXCOMP)]\n    \n    def go2(n):\n        if n == 1:\n            return Res(2, 0)\n        if done2[n]:\n            return mem2[n]\n        ret = Res()\n        for i in range(n):\n            lcnt = i\n            rcnt = n - i - 1\n            lres = Res(1, 0) if lcnt == 0 else go2(lcnt)\n            rres = Res(1, 0) if rcnt == 0 else go2(rcnt)\n            mways = (lcnt + 1) + (rcnt + 1)\n            msummaddness = calcsum(0, lcnt) + calcsum(0, rcnt)\n            mlt = choose[lcnt + rcnt][lcnt]\n            \n            # Update ways\n            term = lres.ways * mways % MOD\n            term = term * rres.ways % MOD\n            term = term * mlt % MOD\n            ret.ways = (ret.ways + term) % MOD\n            \n            # Update summaddness\n            term1 = lres.summaddness * mways % MOD\n            term1 = term1 * rres.ways % MOD\n            term1 = term1 * mlt % MOD\n            \n         