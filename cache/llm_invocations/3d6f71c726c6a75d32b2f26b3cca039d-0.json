n                                         mul_mod(F[j], F[i-1-j])));\n        }\n        F[i] = mul_mod(F[i], i+1);\n    }\n\n    dp1.assign(MAXN, vector<int>(MAXN, 0));\n    dp2.assign(MAXN, vector<int>(MAXN, 0));\n    dp1[0][0] = 1;\n    for(int k = 1; k <= N; k++) {\n        dp1[k][0] = 1;\n        for(int i = 1; i <= min(M, k); i++) {\n            dp1[k][i] = dp1[k-1][i];\n            dp2[k][i] = dp2[k-1][i];\n            for(int j = 1; j <= i; j++) {\n                dp1[k][i] = add_mod(dp1[k][i], mul_mod(mul_mod(F[j], dp1[max(k-j-1, 0)][i-j]), Cbin[i][j]));\n                dp2[k][i] = add_mod(dp2[k][i], mul_mod(mul_mod(C[j], dp1[max(k-j-1, 0)][i-j]), Cbin[i][j]));\n                dp2[k][i] = add_mod(dp2[k][i], mul_mod(mul_mod(F[j], dp2[max(k-j-1, 0)][i-j]), Cbin[i][j]));\n            }\n        }\n    }\n    printf(\"%d\\n\", dp2[N][M]);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMAXN = 510\n\ndef add_mod(a, b):\n    return (a + b) % MOD\n\ndef mul_mod(a, b):\n    return (a * b) % MOD\n\ndef p(x):\n    return x * (x + 1) // 2\n\ndef build_triangle():\n    for i in range(MAXN):\n        Cbin[i][0] = Cbin[i][i] = 1\n        for j in range(1, i):\n            Cbin[i][j] = add_mod(Cbin[i-1][j-1], Cbin[i-1][j])\n\ndef main():\n    global MOD, Cbin, F, C, dp1, dp2\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    N = int(data[0])\n    M = int(data[1])\n    MOD = int(data[2])\n\n    # Initialize binomial coefficient table\n    Cbin = [[0] * MAXN for _ in range(MAXN)]\n    build_triangle()\n\n    F = [0] * (MAXN)\n    C = [0] * (MAXN)\n    F[0] = 1\n    for i in range(1, M + 1):\n        for j in range(0, i):\n            # F[i] update\n            term1 = mul_mod(mul_mod(Cbin[i-1][j], F[j]), F[i-1-j])\n            F[i] = add_mod(F[i], term1)\n            # C[i] update part 1\n 