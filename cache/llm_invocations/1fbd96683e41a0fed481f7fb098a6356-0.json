{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MOD = 1000000007;\nconst int MAX_S = (1 << 20) + 5;\n\nint n, fullMask, total;\nint F1[MAX_S], F2[MAX_S];\nint C[10][10], V[10][10], T[10][10][10];\n\nlong long modPow(long long b, long long e) {\n    long long r = 1;\n    while (e) {\n        if (e & 1) r = (r * b) % MOD;\n        b = (b * b) % MOD;\n        e >>= 1;\n    }\n    return r;\n}\n\nlong long modInv(long long x) { return modPow(x, MOD - 2); }\n\nbool ok(int a, int b, int c) {\n    int vals[3] = {a, b, c};\n    int idx[3] = {0, 1, 2};\n    do {\n        if (C[vals[idx[0]]][1] && C[vals[idx[1]]][2] && C[vals[idx[2]]][3]) return true;\n    } while (next_permutation(idx, idx + 3));\n    return false;\n}\n\nvoid walk1(int coef, int r, int c) {\n    if (r == 7 && c == 1) {\n        int state = 0;\n        for (int i = 1; i <= 6; ++i)\n            for (int j = i + 1; j <= 6; ++j)\n                for (int k = j + 1; k <= 6; ++k)\n                    if (ok(i, j, k)) {\n                        int x = 1;\n                        while (x == i || x == j || x == k) ++x;\n                        int y = x + 1;\n                        while (y == i || y == j || y == k) ++y;\n                        int z = y + 1;\n                        while (z == i || z == j || z == k) ++z;\n                        state |= T[x][y][z];\n                    }\n        F1[state] = (F1[state] + coef) % MOD;\n        return;\n    }\n    \n    C[r][c] = 1;\n    if (c == 3) walk1(1LL * coef * V[r][c] % MOD, r + 1, 1);\n    else walk1(1LL * coef * V[r][c] % MOD, r, c + 1);\n    C[r][c] = 0;\n    \n    if (c == 3) walk1(1LL * coef * (MOD + 1 - V[r][c]) % MOD, r + 1, 1);\n    else walk1(1LL * coef * (MOD + 1 - V[r][c]) % MOD, r, c + 1);\n}\n\nvoid walk2(int coef, int r, int c) {\n    if (r == 7 && c == 4) {\n        int state = 0;\n        for (int i = 1; i <= 6; ++i)\n            for (int j = i + 1; j <= 6; ++j)\n                for (int k = j + 1; k <= 6; ++k)\n                    if (ok(i, j, k)) state |= T[i][j][k];\n        F2[state] = (F2[state] + coef) % MOD;\n        total = (total + 1LL * F1[fullMask ^ state] * coef) % MOD;\n        return;\n    }\n    \n    C[r][c - 3] = 1;\n    if (c == 6) walk2(1LL * coef * V[r][c] % MOD, r + 1, 4);\n    else walk2(1LL * coef * V[r][c] % MOD, r, c + 1);\n    C[r][c - 3] = 0;\n    \n    if (c == 6) walk2(1LL * coef * (MOD + 1 - V[r][c]) % MOD, r + 1, 4);\n    else walk2(1LL * coef * (MOD + 1 - V[r][c]) % MOD, r, c + 1);\n}\n\nint main() {\n    scanf(\"%d\", &n);\n    for (int i = 1; i <= n; ++i)\n        for (int j = 1; j <= n; ++j) {\n            int t; scanf(\"%d\", &t);\n            V[i][j] = 1LL * t * modInv(100) % MOD;\n        }\n    for (int i = n + 1; i <= 6; ++i) V[i][i] = 1;\n    \n    int bit = 0;\n    for (int i = 1; i <= 6; ++i)\n        for (int j = i + 1; j <= 6; ++j)\n            for (int k = j + 1; k <= 6; ++k)\n                T[i][j][k] = 1 << bit++;\n    \n    walk1(1, 1, 1);\n    fullMask = (1 << 20) - 1;\n    \n    for (int b = 0; b < 20; ++b)\n        for (int s = 0; s <= fullMask; ++s)\n            if (s >> b & 1)\n                F1[s] = (F1[s] + F1[s ^ (1 << b)]) % MOD;\n    \n    walk2(1, 1, 4);\n    total = (MOD + 1 - total) % MOD;\n    printf(\"%d\\n\", total);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom itertools import permutations\n\nMOD = 1000000007\nMAX_S = (1 << 20) + 5\n\ndef mod_pow(b, e):\n    r = 1\n    while e:\n        if e & 1:\n            r = (r * b) % MOD\n        b = (b * b) % MOD\n        e >>= 1\n    return r\n\ndef mod_inv(x):\n    return mod_pow(x, MOD - 2)\n\ndef ok(a, b, c):\n    vals = [a, b, c]\n    idx = [0, 1, 2]\n    for perm in permutations(idx):\n        if C[vals[perm[0]]][1] and C[vals[perm[1]]][2] and C[vals[perm[2]]][3]:\n            return True\n    return False\n\ndef walk1(coef, r, c):\n    global F1\n    if r == 7 and c == 1:\n        state = 0\n        for i in range(1, 7):\n            for j in range(i + 1, 7):\n                for k in range(j + 1, 7):\n                    if ok(i, j, k):\n                        x = 1\n                        while x == i or x == j or x == k:\n                            x += 1\n                        y = x + 1\n                        while y == i or y == j or y == k:\n                            y += 1\n                        z = y + 1\n                        while z == i or z == j or z == k:\n                            z += 1\n                        state |= T[x][y][z]\n        F1[state] = (F1[state] + coef) % MOD\n        return\n    \n    C[r][c] = 1\n    if c == 3:\n        walk1((coef * V[r][c]) % MOD, r + 1, 1)\n    else:\n        walk1((coef * V[r][c]) % MOD, r, c + 1)\n    C[r][c] = 0\n    \n    if c == 3:\n        walk1((coef * (MOD + 1 - V[r][c])) % MOD, r + 1, 1)\n    else:\n        walk1((coef * (MOD + 1 - V[r][c])) % MOD, r, c + 1)\n\ndef walk2(coef, r, c):\n    global F2, total\n    if r == 7 and c == 4:\n        state = 0\n        for i in range(1, 7):\n            for j in range(i + 1, 7):\n                for k in range(j + 1, 7):\n                    if ok(i, j, k):\n                        state |= T[i][j][k]\n        F2[state] = (F2[state] + coef) % MOD\n        total = (total + F1[fullMask ^ state] * coef) % MOD\n        return\n    \n    C[r][c - 3] = 1\n    if c == 6:\n        walk2((coef * V[r][c]) % MOD, r + 1, 4)\n    else:\n        walk2((coef * V[r][c]) % MOD, r, c + 1)\n    C[r][c - 3] = 0\n    \n    if c == 6:\n        walk2((coef * (MOD + 1 - V[r][c])) % MOD, r + 1, 4)\n    else:\n        walk2((coef * (MOD + 1 - V[r][c])) % MOD, r, c + 1)\n\ndef main():\n    global n, fullMask, total, F1, F2, C, V, T\n    \n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx])\n    idx += 1\n    \n    # Initialize arrays\n    C = [[0] * 10 for _ in range(10)]\n    V = [[0] * 10 for _ in range(10)]\n    T = [[[0] * 10 for _ in range(10)] for _ in range(10)]\n    F1 = [0] * MAX_S\n    F2 = [0] * MAX_S\n    \n    # Read V matrix\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            t = int(input_data[idx])\n            idx += 1\n            V[i][j] = (t * mod_inv(100)) % MOD\n    \n    for i in range(n + 1, 7):\n        V[i][i] = 1\n    \n    # Initialize T\n    bit = 0\n    for i in range(1, 7):\n        for j in range(i + 1, 7):\n            for k in range(j + 1, 7):\n                T[i][j][k] = 1 << bit\n                bit += 1\n    \n    # Walk1\n    walk1(1, 1, 1)\n    fullMask = (1 << 20) - 1\n    \n    # Sum over subsets\n    for b in range(20):\n        for s in range(fullMask + 1):\n            if (s >> b) & 1:\n                F1[s] = (F1[s] + F1[s ^ (1 << b)]) % MOD\n    \n    # Walk2\n    total = 0\n    walk2(1, 1, 4)\n    total = (MOD + 1 - total) % MOD\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019