{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, ec, total, a[6010], u[6010], v[6010];\nint head[MAXN], prev_idx[MAXN], dist[MAXN], inq[MAXN];\nqueue<int> q;\nstruct Edge { int to, cap, cost, next; } e[2000010];\n\nint node_id(int t, int v) { return t * n + v; }\n\nvoid add_edge(int s, int d, int cap, int cost) {\n    e[ec] = {d, cap, cost, head[s]};\n    head[s] = ec++;\n    e[ec] = {s, 0, -cost, head[d]};\n    head[d] = ec++;\n}\n\nbool spfa(int src, int dst) {\n    fill(dist, dist + MAXN, INF);\n    q.push(src);\n    dist[src] = 0;\n    while (!q.empty()) {\n        int cur = q.front(); q.pop();\n        inq[cur] = 0;\n        for (int i = head[cur]; ~i; i = e[i].next) {\n            int to = e[i].to;\n            if (e[i].cap && dist[to] > dist[cur] + e[i].cost) {\n                dist[to] = dist[cur] + e[i].cost;\n                prev_idx[to] = i;\n                if (!inq[to]) {\n                    q.push(to);\n                    inq[to] = 1;\n                }\n            }\n        }\n    }\n    return dist[dst] < 1e9;\n}\n\nvoid update(int src, int dst) {\n    for (int cur = dst; cur != src; cur = e[prev_idx[cur] ^ 1].to) {\n        e[prev_idx[cur]].cap--;\n        e[prev_idx[cur] ^ 1].cap++;\n    }\n    total += dist[dst];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m >> k >> c >> d;\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        cin >> a[i];\n        add_edge(S, node_id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        cin >> u[i] >> v[i];\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add_edge(node_id(t, i), node_id(t + 1, i), k, c);\n        }\n        add_edge(node_id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            int limit = min(k, 25);\n            for (int j = 1; j <= limit; j++) {\n                int cost = c + (2 * j - 1) * d;\n                add_edge(node_id(t, u[i]), node_id(t + 1, v[i]), 1, cost);\n                add_edge(node_id(t, v[i]), node_id(t + 1, u[i]), 1, cost);\n            }\n        }\n    }\n    while (spfa(S, T)) update(S, T);\n    cout << total << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 6010;\n    static final int INF = 0x3f3f3f3f;\n    static int n, m, k, c, d, ec, total;\n    static int[] a = new int[6010];\n    static int[] u = new int[6010];\n    static int[] v = new int[6010];\n    static int[] head = new int[MAXN];\n    static int[] prev_idx = new int[MAXN];\n    static int[] dist = new int[MAXN];\n    static int[] inq = new int[MAXN];\n    static Queue<Integer> q = new LinkedList<>();\n    static Edge[] e = new Edge[2000010];\n\n    static class Edge {\n        int to, cap, cost, next;\n        Edge(int to, int cap, int cost, int next) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.next = next;\n        }\n    }\n\n    static int node_id(int t, int v) {\n        return t * n + v;\n    }\n\n    static void add_edge(int s, int d, int cap, int cost) {\n        e[ec] = new Edge(d, cap, cost, head[s]);\n        head[s] = ec++;\n        e[ec] = new Edge(s, 0, -cost, head[d]);\n        head[d] = ec++;\n    }\n\n    static boolean spfa(int src, int dst) {\n        Arrays.fill(dist, INF);\n        q.offer(src);\n        dist[src] = 0;\n        while (!q.isEmpty()) {\n            int cur = q.poll();\n            inq[cur] = 0;\n            for (int i = head[cur]; ~i != 0; i = e[i].next) {\n                int to = e[i].to;\n                if (e[i].cap > 0 && dist[to] > dist[cur] + e[i].cost) {\n                    dist[to] = dist[cur] + e[i].cost;\n                    prev_idx[to] = i;\n                    if (inq[to] == 0) {\n                        q.offer(to);\n                        inq[to] = 1;\n                    }\n                }\n            }\n        }\n        return dist[dst] < 1e9;\n    }\n\n    static void update(int src, int dst) {\n        for (int cur = dst; cur != src; cur = e[prev_idx[cur] ^ 1].to) {\n            e[prev_idx[cur]].cap--;\n            e[prev_idx[cur] ^ 1].cap++;\n        }\n        total += dist[dst];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        Arrays.fill(head, -1);\n        ec = 0;\n        total = 0;\n        \n        int S = 0;\n        int T = 6000;\n        \n        for (int i = 1; i <= k; i++) {\n            a[i] = sc.nextInt();\n            add_edge(S, node_id(0, a[i]), 1, 0);\n        }\n        \n        for (int i = 1; i <= m; i++) {\n            u[i] = sc.nextInt();\n            v[i