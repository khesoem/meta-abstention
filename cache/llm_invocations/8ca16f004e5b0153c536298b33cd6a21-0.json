{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\nconst int LIM=270005;\nint n,k,mod;\nint m,deg;\nint bits[LIM], fact[LIM], ifact[LIM];\nint dp[19][LIM];\ninline int adj(int x){ return x<0 ? x+mod : x>=mod ? x-mod : x; }\ninline void r_add(int &x,int y){ x=adj(x+y); }\nint qpow(int a,int b){\n    int r=1;\n    for(;b;b>>=1){ if(b&1) r=1LL*r*a%mod; a=1LL*a*a%mod; }\n    return r;\n}\nvoid prep(int lim){\n    fact[0]=1;\n    for(int i=1;i<=lim;i++) fact[i]=1LL*fact[i-1]*i%mod;\n    ifact[lim]=qpow(fact[lim],mod-2);\n    for(int i=lim-1;i>=0;i--) ifact[i]=1LL*ifact[i+1]*(i+1)%mod;\n}\nvoid do_fwt(int *arr,int len,int sgn){\n    for(int step=1;step<len;step<<=1){\n        for(int base=0;base<len;base+=(step<<1)){\n            int *p=arr+base;\n            for(int k=0;k<step;k++) r_add(p[k+step],sgn*p[k]);\n        }\n    }\n}\nvector<long long> mul_poly(const vector<long long>&x,const vector<long long>&y){\n    vector<long long> z(deg+1,0);\n    for(int i=0;i<=deg;i++)\n        for(int j=0;j<=deg-i;j++)\n            z[i+j] += x[i]*y[j];\n    for(int i=0;i<=deg;i++) z[i]%=mod;\n    return z;\n}\nvector<long long> poly_pow(vector<long long> a,int e){\n    vector<long long> res(deg+1,0); res[0]=1;\n    while(e){\n        if(e&1) res=mul_poly(res,a);\n        a=mul_poly(a,a);\n        e>>=1;\n    }\n    return res;\n}\nint main(){\n    scanf(\"%d%d%d\",&n,&k,&mod);\n    prep(n);\n    if(n&1){ printf(\"%d\\n\",qpow(k,n)); return 0; }\n    m=1; deg=0;\n    while(m<=n){ m<<=1; deg++; }\n    for(int i=0;i<m;i++) bits[i]=bits[i>>1]+(i&1);\n    prep(m);\n    for(int i=0;i<m;i++) dp[bits[i]][i]=ifact[i];\n    for(int i=0;i<=deg;i++) do_fwt(dp[i],m,1);\n    vector<long long> g(deg+1);\n    for(int s=0;s<m;s++){\n        for(int i=0;i<=deg;i++) g[i]=dp[i][s];\n        g=poly_pow(g,k);\n        for(int i=0;i<=deg;i++) dp[i][s]=g[i];\n    }\n    do_fwt(dp[bits[n]],m,-1);\n    int ans=qpow(k,n)-1LL*dp[bits[n]][n]*fact[n]%mod;\n    printf(\"%d\\n\",adj(ans));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nLIM = 270005\nmod = 0\nfact = [0] * (LIM + 1)\nifact = [0] * (LIM + 1)\nbits = [0] * LIM\ndp = [[0] * LIM for _ in range(19)]\ndeg = 0\nm = 0\n\ndef adj(x):\n    return x % mod\n\ndef qpow(a, b):\n    return pow(a, b, mod)\n\ndef prep(lim):\n    global fact, ifact, mod\n    fact[0] = 1\n    for i in range(1, lim + 1):\n        fact[i] = fact[i-1] * i % mod\n    ifact[lim] = qpow(fact[lim], mod - 2)\n    for i in range(lim - 1, -1, -1):\n        ifact[i] = ifact[i+1] * (i+1) % mod\n\ndef do_fwt(arr, length, sgn):\n    step = 1\n    while step < length:\n        for base in range(0, length, step * 2):\n            for k in range(step):\n                u = arr[base + k]\n                v = arr[base + k + step]\n                arr[base + k + step] = (v + sgn * u) % mod\n        step <<= 1\n\ndef mul_poly(x, y):\n    z = [0] * (deg + 1)\n    for i in range(deg + 1):\n        for j in range(deg + 1 - i):\n            z[i + j] = (z[i + j] + x[i] * y[j]) % mod\n    return z\n\ndef poly_pow(a, e):\n    res = [0] * (deg + 1)\n    res[0] = 1\n    while e:\n        if e & 1:\n            res = mul_poly(res, a)\n        a = mul_poly(a, a)\n        e >>= 1\n    return res\n\ndef main():\n    global mod, fact, ifact, bits, dp, deg, m\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, mod = map(int, data[:3])\n    prep(n)\n    if n & 1:\n        print(qpow(k, n))\n        return\n    m = 1\n    deg = 0\n    while m <= n:\n        m <<= 1\n        deg += 1\n    for i in range(m):\n        bits[i] = bits[i >> 1] + (i & 1)\n    prep(m)\n    for i in range(m):\n        dp[bits[i]][i] = ifact[i]\n    for i in range(deg + 1):\n        do_fwt(dp[i], m, 1)\n    for s in range(m):\n        g = [dp[i][s] for i in range(deg + 1)]\n        g = poly_pow(g, k)\n        for i in range(deg + 1):\n            dp[i][s] = g[i]\n    do_fwt(dp[bits[n]], m, -1)\n    ans = (qpow(k, n) - dp[bits[n]][n] * fact[n]) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001627074379939586, 0.0, -7.152555099310121e-07, -0.0002208704245276749, -0.025108514353632927, -2.9802276912960224e-06, -0.008629058487713337, -0.3307667076587677, -3.218599158572033e-05, -3.576278118089249e-07, -7.390948667307384e-06, -6.794906312279636e-06, -0.578263521194458, -0.12916098535060883, -0.0015248350100591779, -0.0002138386043952778, -0.0007101159426383674, -0.0067872218787670135, -0.04937690868973732, -1.4305104514278355e-06, -0.0038859345950186253, -9.60780744208023e-05, -0.011048214510083199, -0.00015841660206206143, -0.5759446620941162, -5.960462772236497e-07, -0.043508850038051605, 0.0, -0.014204819686710835, -0.0005540504935197532, -3.814689989667386e-06, 0.0, -7.152555099310121e-07, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.0181