l)%mod1+mod1)%mod1)%mod2;\n\t\tfor(int i=(!len);i<=9;++i) dfs2(len+1,val*10+i);\n\t}\n}\nint main(){\n\tn=read();\n\tdfs1(0,0);\n\tfor(int i=0;i<=6;++i) sort(v[i].begin(),v[i].end());\n\tdfs2(0,0);\n\tprintf(\"%lld\\n\",ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nmod1 = 998244353\nmod2 = 1000000007\npw = [1, 10, 100, 1000, 10000, 100000, 1000000]\n\ndef read():\n    s = sys.stdin.readline().strip()\n    # handle possible negative sign\n    if s and s[0] == '-':\n        return -int(s[1:])\n    return int(s)\n\ndef main():\n    global cnt1, sum_, v, cnt2, ans, n\n    n = read()\n    cnt1 = 0\n    sum_ = [0] * 10\n    v = [[] for _ in range(10)]\n\n    def dfs1(length, val):\n        nonlocal cnt1\n        if length > 6:\n            return\n        v[length].append((cnt1 - val) % mod1)\n        sum_[length] += (cnt1 - val) % mod1\n        cnt1 += 1\n        for i in range(10):\n            dfs1(length + 1, val * 10 + i)\n\n    def check(x):\n        return x * 1000000 + 999999 <= n and x * 10000000 > n\n\n    cnt2 = 0\n    ans = 0\n\n    def dfs2(length, val):\n        nonlocal cnt2, ans\n        if val > n:\n            return\n        if check(val):\n            for i in range(7):\n                v1 = ((cnt2 + 1 - val * pw[i]) % mod1 + mod1) % mod1\n                num = bisect.bisect_left(v[i], (mod1 - v1) % mod1)\n                ans = (ans + (sum_[i] + len(v[i]) * v1 - mod1 * (len(v[i]) - num))) % mod2\n            cnt2 += cnt1\n        else:\n            if length:\n                cnt2 += 1\n            ans = (ans + ((cnt2 - val) % mod1 + mod1) % mod1) % mod2\n            start = 0 if length else 1\n            for i in range(start, 10):\n                dfs2(length + 1, val * 10 + i)\n\n    dfs1(0, 0)\n    for i in range(7):\n        v[i].sort()\n    dfs2(0, 0)\n    print(ans)\n\nif __n