[t] == INF:\n                return -1\n            for i in range(self.V):\n                self.h[i] += self.dist[i]\n            flow = f\n            v = t\n            while v != s:\n                flow = min(flow, self.g[self.prevv[v]][self.preve[v]].cap)\n                v = self.prevv[v]\n            f -= flow\n            res += flow * self.h[t]\n            v = t\n            while v != s:\n                e = self.g[self.prevv[v]][self.preve[v]]\n                e.cap -= flow\n                self.g[v][e.rev].cap += flow\n                v = self.prevv[v]\n        return res\n\ndef main():\n    data = list(map(int, sys.stdin.readline().strip().split()))\n    n, m, k, c, d = data[0], data[1], data[2], data[3], data[4]\n    \n    a = [0] * k\n    cnt = [0] * n\n    \n    data = list(map(int, sys.stdin.readline().strip().split()))\n    for i in range(k):\n        a[i] = data[i]\n        cnt[a[i] - 1] += 1\n    \n    adj = [[] for _ in range(n)]\n    for _ in range(m):\n        u, v = map(int, sys.stdin.readline().strip().split())\n        u -= 1\n        v -= 1\n        adj[u].append(v)\n        adj[v].append(u)\n    \n    mcf = MCF()\n    TIME_STEPS = 100\n    mcf.init(n * TIME_STEPS + 2)\n    \n    for i in range(n):\n        mcf.add_edge(n * TIME_STEPS, i, cnt[i], 0)\n    \n    for t in range(TIME_STEPS):\n        mcf.add_edge(t * n, n * TIME_STEPS + 1, k, c * t)\n    \n    for i in range(n):\n        for t in range(TIME_STEPS - 1):\n            mcf.add_edge(t * n + i, (t + 1) * n + i, k, 0)\n        for to in adj[i]:\n            for t in range(TIME_STEPS - 1):\n                for u in range(k):\n                    cost = (u + 1) * (u + 1) * d - u * u * d\n                    mcf.add_edge(t * n + i, (t + 1) * n + to, 1, cost)\n    \n    result = mcf.solve(n * TIME_STEPS, n * TIME_STEPS + 1, k)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000287729839328676