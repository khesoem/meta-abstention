].size(); ++i) {\n                    auto& e = g[v][i];\n                    if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                        dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                        prevv[e.to] = v;\n                        preve[e.to] = i;\n                        pq.push({dist[e.to], e.to});\n                    }\n                }\n            }\n            if (dist[t] == INF) return -1;\n            for (int i = 0; i < V; ++i) h[i] += dist[i];\n            int flow = f;\n            for (int v = t; v != s; v = prevv[v])\n                flow = min(flow, g[prevv[v]][preve[v]].cap);\n            f -= flow;\n            res += flow * h[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                auto& e = g[prevv[v]][preve[v]];\n                e.cap -= flow;\n                g[v][e.rev].cap += flow;\n            }\n        }\n        return res;\n    }\n};\n\nMCF mcf;\nint n, m, k, c, d;\nint a[50], cnt[50];\nvector<int> adj[50];\nconst int TIME_STEPS = 100;\n\nint main() {\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    for (int i = 0; i < k; ++i) {\n        scanf(\"%d\", &a[i]);\n        ++cnt[a[i] - 1];\n    }\n    for (int i = 0; i < m; ++i) {\n        int u, v; scanf(\"%d%d\", &u, &v);\n        --u; --v;\n        adj[u].push_back(v);\n        adj[v].push_back(u);\n    }\n    mcf.init(n * TIME_STEPS + 2);\n    for (int i = 0; i < n; ++i)\n        mcf.add_edge(n * TIME_STEPS, i, cnt[i], 0);\n    for (int t = 0; t < TIME_STEPS; ++t)\n        mcf.add_edge(t * n, n * TIME_STEPS + 1, k, c * t);\n    for (int i = 0; i < n; ++i) {\n        for (int t = 0; t < TIME_STEPS - 1; ++t)\n            mcf.add_edge(t * n + i, (t + 1) * n + i, k, 0);\n        for (int to : adj[i]) {\n            for (int t = 0; t < TIME_STEPS - 1; ++t) {\n                for (int u = 0; u < k; ++u) {\n                    int cost = (u + 1) * (u + 1) * d - u * u * d;\n                    mcf.add_edge(t * n + i, (t +