inal long M = 1000000007L;\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int T = 1;\n        for (int _ = 0; _ < T; _++) {\n            process(scanner);\n        }\n        scanner.close();\n    }\n\n    private static void process(Scanner scanner) {\n        int P = scanner.nextInt();\n        int K = scanner.nextInt();\n\n        long[] k = new long[P];\n        for (int x = 0; x < P; x++) {\n            k[x] = (long)K * x % P;\n        }\n\n        if (K == 0) {\n            System.out.println(modPow(P, P - 1, M));\n            return;\n        }\n\n        int[] f = new int[P];\n        int[] c = new int[P];\n        long ans = 1;\n\n        for (int i = 0; i < P; i++) {\n            if (f[i] != 0) continue;\n\n            int cnt = 1;\n            int u = i;\n            f[u] = 1;\n            while (f[(int)k[u]] == 0) {\n                u = (int)k[u];\n                f[u] = 1;\n                cnt++;\n            }\n            c[cnt]++;\n        }\n\n        for (int i = 1; i < P; i++) {\n            if (c[i] != 0) {\n                long cntVal = (long) i * c[i] + (i > 1 ? 1 : 0);\n                ans = (ans * modPow(cntVal, c[i], M)) % M;\n            }\n        }\n\n        System.out.println(ans);\n    }\n\n    private static long modPow(long base, long exp, long mod) {\n        long result = 1L;\n        base = base % mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.005826060194522142, -0.0013091674773022532, -4.961759259458631e-06, -4.334533878136426e-05, -1.981667537620524e-06, -1.9361264946837764e-07, -0.00016909420082811266, -0.03339001163840294, -0.01606873981654644, -3.054500666621607e-06, -1.9361264946837764e-07, -0.000