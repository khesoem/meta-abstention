long)n * n) % MOD);\n        }\n        return (int)r;\n    }\n\n    // next permutation in lexicographic order, returns false if no more\n    static boolean nextPermutation(int[] a) {\n        int i = a.length - 2;\n        while (i >= 0 && a[i] >= a[i + 1]) i--;\n        if (i < 0) return false;\n        int j = a.length - 1;\n        while (a[j] <= a[i]) j--;\n        int tmp = a[i];\n        a[i] = a[j];\n        a[j] = tmp;\n        // reverse from i+1 to end\n        for (int l = i + 1, r = a.length - 1; l < r; l++, r--) {\n            tmp = a[l];\n            a[l] = a[r];\n            a[r] = tmp;\n        }\n        return true;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int[][] P = new int[n][n];\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                P[i][j] = sc.nextInt();\n            }\n        }\n        sc.close();\n\n        int h = (n + 1) / 2;\n        int h2 = n - h;\n        int inv100 = inv(100);\n\n        // generate masks with exactly h bits set\n        ArrayList<Integer> masks = new ArrayList<>();\n        ArrayList<Integer> masks2 = new ArrayList<>();\n        for (int i = 0; i < (1 << n); i++) {\n            if (Integer.bitCount(i) == h) masks.add(i);\n            if (Integer.bitCount(i) == h2) masks2.add(i);\n        }\n\n        int[] prob = new int[MAX_MASKS];\n        int[] prob2 = new int[MAX_MASKS];\n\n        // first half rows\n        int totalBits1 = n * h;\n        for (int i = 0; i < (1 << totalBits1); i++) {\n            long p = 1;\n            for (int j = 0; j < totalBits1; j++) {\n                int x = j / n;\n                int y = j % n;\n                if ((i & (1 << j)) != 0) {\n                    p = (p * ((long)P[x][y] * inv100 % MOD)) % MOD;\n                } else {\n                    p = (p * ((long)(100 - P[x][y]) * inv100 % MOD)) % MOD;\n                }\n            }\n            int poss = 0;\n            for (int idx = 0; idx < masks.size(); idx++) {\n                int mask = masks.get(idx);\n                // collect columns in mask\n                int[] cols = new int[h];\n                int pos = 0;\n                for (int k = 0; k < n; k++) {\n                    if ((mask & (1 << k)) != 0) {\n                        cols[pos++] = k;\n                    }\n                }\n                // sort to start with first permutation\n                Arrays.sort(cols);\n                boolean found = false;\n                do {\n                    boolean ok = true;\n                    for (int k = 0; k < h; k++) {\n                        int bit = k * n + cols[k];\n                        if ((i & (1 << bit)) == 0) {\n                            ok = false;\n                            break;\n                        }\n                    }\n                    if (ok) {\n                        found = true;\n                        break;\n                    }\n                } while (nextPermutation(cols));\n                if (found) {\n                    poss |= (1 << idx);\n                }\n            }\n            prob[poss] = (int)((prob[poss] + p) % MOD);\n        }\n\n        // second half rows\n        int totalBits2 = n * h2;\n        for (int i = 0; i < (1 << totalBits2); i++) {\n            long p = 1;\n            for (int j = 0; j < totalBits2; j++) {\n                int x = j / n + h;\n                int y = j % n;\n                if ((i & (1 << j)) != 0) {\n                    p = (p * ((long)P[x][y] * inv100 % MOD)) % MOD;\n                } else {\n                    p = (p * ((long)(100 - P[x][y]) * inv100 % MOD)) % MOD;\n                }\n            }\n            int poss = 0;\n            for (int idx = 0; idx < masks.size(); idx++) {\n                int mask = masks.get(idx);\n                // collect columns NOT in mask\n                int[] cols = new int[h2];\n  