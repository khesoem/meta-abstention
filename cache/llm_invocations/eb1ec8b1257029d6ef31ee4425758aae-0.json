& dis[nx][ny] == inf) {\n                    dis[nx][ny] = dis[x][y] + 1;\n                    q[++r] = nx * 1000 + ny;\n                }\n            }\n        }\n    }\n\n    static boolean build() {\n        for (int i = 0; i < 1000; i++) d[i] = 0;\n        int l, r;\n        q[l = r = 1] = S;\n        d[S] = 1;\n        while (l <= r) {\n            int x = q[l++];\n            for (int i = head[x]; i != 0; i = next[i]) {\n                int y = to[i];\n                if (d[y] != 0 || cap[i] == 0) continue;\n                d[y] = d[x] + 1;\n                q[++r] = y;\n                if (y == T) return true;\n            }\n        }\n        return false;\n    }\n\n    static int dinic(int x, int flow) {\n        if (x == T) return flow;\n        int k = flow;\n        for (int i = head[x]; i != 0; i = next[i]) {\n            int y = to[i];\n            if (d[y] != d[x] + 1 || cap[i] == 0) continue;\n            int t = dinic(y, Math.min(k, cap[i]));\n            k -= t;\n            cap[i] -= t;\n            cap[i ^ 1] += t;\n            if (k == 0) return flow;\n        }\n        if (k == flow) d[x] = -1;\n        return flow - k;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        tt = sc.nextInt();\n        sc.nextLine();\n        for (int i = 1; i <= n; i++) {\n            String line = sc.nextLine();\n            for (int j = 1; j <= n; j++) {\n                ma[i][j] = line.charAt(j - 1);\n            }\n        }\n        for (int i = 1; i <= n; i++) {\n            String line = sc.nextLine();\n            for (int j = 1; j <= n; j++) {\n                mb[i][j] = line.charAt(j - 1);\n            }\n        }\n\n        // Initialize inf as a large number\n        inf = Integer.MAX_VALUE / 2;\n        for (int i = 0; i < 20; i++) {\n            for (int j = 0; j < 20; j++) {\n                dep[i][j] = inf;\n            }\n        }\n\n        // First BFS from