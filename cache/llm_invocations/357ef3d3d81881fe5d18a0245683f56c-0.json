(\"FieldElement overflow!\", file=sys.stderr)\n            sys.exit(1)\n    \n    def get(self):\n        return self.val\n    \n    def __add__(self, o):\n        return FieldElement((self.val + o.val) % MOD)\n    \n    def __sub__(self, o):\n        return FieldElement((self.val - o.val + MOD) % MOD)\n    \n    def __mul__(self, o):\n        return FieldElement((self.val * o.val) % MOD)\n    \n    def __truediv__(self, o):\n        return self * o.inverse()\n    \n    def __iadd__(self, o):\n        self.val = (self.val + o.val) % MOD\n        return self\n    \n    def __isub__(self, o):\n        self.val = (self.val - o.val + MOD) % MOD\n        return self\n    \n    def __imul__(self, o):\n        self.val = (self.val * o.val) % MOD\n        return self\n    \n    def __itruediv__(self, o):\n        return self.__imul__(o.inverse())\n    \n    def inverse(self):\n        exp = MOD - 2\n        base = self.val\n        res = 1\n        while exp:\n            if exp & 1:\n                res = (res * base) % MOD\n            base = (base * base) % MOD\n            exp >>= 1\n        return FieldElement(res)\n\ndef matmul(A, B):\n    rowsA = len(A)\n    colsA = len(A[0])\n    rowsB = len(B)\n    colsB = len(B[0])\n    if colsA != rowsB:\n        print(\"Matrix multiplication dimension mismatch!\", file=sys.stderr)\n        sys.exit(1)\n    \n    result = [[FieldElement(0) for _ in range(colsB)] for _ in range(rowsA)]\n    for i in range(rowsA):\n        for j in range(colsB):\n            for k in range(colsA):\n                result[i][j] = result[i][j] + A[i][k] * B[k][j]\n    return result\n\ndef matvecmul(A, v):\n    rows = len(A)\n    cols = len(A[0])\n    if len(v) != cols:\n        print(\"Matrix-vector dimension mismatch!\", file=sys.stderr)\n        sys.exit(1)\n    \n    result = [FieldElement(0) for _ in range(rows)]\n    for i in range(rows):\n        for j in range(cols):\n            result[i] = result[i] + A[i][j] * v[j]\n    return result\n\ndef make2D(r, c, val=None):\n    if val is None:\n        val = FieldElement(0)\n    return [[val for _ in range(c)] for _ in range(r)]\n\ndef make3D(d1, d2, d3, val=None):\n    if val is None:\n        val = FieldElement(0)\n    return [[[val for _ in range(d3)] for _ in range(d2)] for _ in range(d1)]\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    n = int(input_data[0])\n    d = int(input_data[1])\n    \n    shifts = make3D(d, d + 1, d + 1)\n    for k in range(d):\n        for i in range(d):\n            shifts[k][i][(i + k) % d] = FieldElement(1)\n        shifts[k][d][d] = FieldElement(1)\n    \n    units = make3D(d, d + 1, d + 1)\n    for k in range(d):\n        for i in range(d + 1):\n            units[k][i][i] = FieldElement(1)\n        for i in range(d + 1):\n            units[k][k][i] = FieldElement(1)\n    \n    I = make2D(d + 1, d + 1)\n    for i in range(d + 1):\n        I[i][i] = FieldElement(1)\n    \n    memo = {}\n    \n    def buildMatrix(p):\n        if p in memo:\n            return memo[p]\n        if p <= d:\n            M = [row[:] for row in I]\n            for k in range(p):\n                M = matmul(units[k], M)\n            return M\n        \n        block = d\n        while (p + block - 1) // block > d:\n            block *= d\n        \n        child = buildMatrix(block)\n        M = [row[:] for row in child]\n        rem = p - block\n        \n        for k in range(1, d):\n            if rem >= block:\n                M = matmul(matmul(matmul(shifts[d - k], child), shifts[k]), M)\n                rem -= block\n            elif rem > 0:\n                M = matmul(matmul(matmul(shifts[d - k], buildMatrix(rem)), shifts[k]), M)\n                rem = 0\n            else:\n                break\n        \n        memo[p] = M\n        return M\n    \n    M = buildMatrix(n)\n    base = [FieldElement(0) for _ in range(d + 1)]\n    base[d] = FieldElement(1)\n    resVec = matvecmul(M, base)\n