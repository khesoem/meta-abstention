;\n    return *this;\n  }\n  FieldElement& operator/=(const FieldElement& o) {\n    return (*this) *= o.inverse();\n  }\n  FieldElement inverse() const {\n    int64 exp = MOD - 2;\n    int64 base = val;\n    int64 res = 1;\n    while (exp) {\n      if (exp & 1) res = (res * base) % MOD;\n      base = (base * base) % MOD;\n      exp >>= 1;\n    }\n    return FieldElement(res);\n  }\n};\n\ntemplate<typename T>\nvector<vector<T>> matmul(const vector<vector<T>>& A, const vector<vector<T>>& B) {\n  int rowsA = A.size();\n  int colsA = A[0].size();\n  int rowsB = B.size();\n  int colsB = B[0].size();\n  if (colsA != rowsB) {\n    cerr << \"Matrix multiplication dimension mismatch!\" << endl;\n    exit(1);\n  }\n  vector<vector<T>> result(rowsA, vector<T>(colsB, T(0)));\n  for (int i = 0; i < rowsA; ++i) {\n    for (int j = 0; j < colsB; ++j) {\n      for (int k = 0; k < colsA; ++k) {\n        result[i][j] = result[i][j] + A[i][k] * B[k][j];\n      }\n    }\n  }\n  return result;\n}\n\ntemplate<typename T>\nvector<T> matvecmul(const vector<vector<T>>& A, const vector<T>& v) {\n  int rows = A.size();\n  int cols = A[0].size();\n  if (v.size() != cols) {\n    cerr << \"Matrix-vector dimension mismatch!\" << endl;\n    exit(1);\n  }\n  vector<T> result(rows, T(0));\n  for (int i = 0; i < rows; ++i) {\n    for (int j = 0; j < cols; ++j) {\n      result[i] = result[i] + A[i][j] * v[j];\n    }\n  }\n  return result;\n}\n\ntemplate<typename T>\nvector<vector<T>> make2D(int r, int c, const T& val = T()) {\n  return vector<vector<T>>(r, vector<T>(c, val));\n}\n\ntemplate<typename T>\nvector<vector<vector<T>>> make3D(int d1, int d2, int d3, const T& val = T()) {\n  return vector<vector<vector<T>>>(d1, vector<vector<T>>(d2, vector<T>(d3, val)));\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int64 n;\n  int d;\n  cin >> n >> d;\n\n  auto shifts = make3D<FieldElement>(d, d + 1, d + 1);\n  for (int k = 0; k < d; ++k) {\n    for (int i = 0; i < d; ++i) {\n 