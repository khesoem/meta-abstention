inue;\n        if(int df = dfs(v, min(f, e.cap - e.f))) {\n            e.f += df;\n            adj[v][e.rev].f -= df;\n            return df;\n        }\n    }\n    return 0;\n}\n\nint mf() {\n    int res = 0;\n    while(bfs()) {\n        memset(ptr, 0, sizeof ptr);\n        while(int df = dfs(src, INF))\n            res += df;\n    }\n    return res;\n}\n\nint dx[] = {-1, 0, 0, 1};\nint dy[] = {0, -1, 1, 0};\n\nint n, m;\ntypedef vector<vector<int>> grid;\ntypedef array<int, 2> pa;\ngrid obs, tim, dii;\n\nvoid gbfs(int r, int c, grid &dis, bool chk = false) {\n    for(int i = 0; i < n; i++)\n        fill(dis[i].begin(), dis[i].end(), -1);\n    dis[r][c] = 0;\n    queue<pa> q;\n    q.push({r, c});\n    while(q.size()) {\n        auto p = q.front(); q.pop();\n        if(chk && dis[p[0]][p[1]] == tim[p[0]][p[1]])\n        \tcontinue;\n        pa r;\n        for(int i = 0; i < 4; i++) {\n            r = {p[0] + dx[i], p[1] + dy[i]};\n            if(r[0] < 0 || r[0] >= n || r[1] < 0 || r[1] >= n || dis[r[0]][r[1]] != -1 || obs[r[0]][r[1]]) \n                continue;\n            if(chk && tim[r[0]][r[1]] > -1 && dis[p[0]][p[1]] + 1 > tim[r[0]][r[1]])\n            \tcontinue;\n            dis[r[0]][r[1]] = dis[p[0]][p[1]] + 1;\n            q.push(r);\n        }\n    }\n}\n\nvector<string> lab, rea;\n\nint main() {\n    cin >> n >> m;\n    lab.resize(n);\n    rea.resize(n);\n    for(auto &x : lab)\n        cin >> x;\n    for(auto &x : rea)\n        cin >> x;\n    obs.assign(n, vector<int>(n));\n    tim.assign(n, vector<int>(n));\n    dii.assign(n, vector<int>(n));\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tobs[i][j] = (lab[i][j] == 'Y');\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tif(lab[i][j] == 'Z')\n    \t\t\tgbfs(i, j, tim);\n    src = 2*n*n + 5;\n    dst = src + 1;\n    for(int x = 0; x < n; x++) {\n    \tfor(int y = 0; y < n; y++) {\n    \t\tif(lab[x][y] == 'Z' || lab[x][y] == 'Y')\n    \t\t\tcontinue;\n    \t\tadd_edge(src, n*x + y, lab[x][y] - '0');\n    \t\tadd_edge(n*n + n*x + y, dst, rea[x][y] - '0');\n    \t\tgbfs(x, y, dii, true);\n    \t\tfor(int xp = 0; xp < n; xp++) {\n    \t\t\tfor(int yp = 0; yp < n; yp++) {\n    \t\t\t\tif(dii[xp][yp] != -1 && dii[xp][yp] <= m) {\n    \t\t\t\t\tadd_edge(n*x + y, n*n + n*xp + yp, INF);\n    \t\t\t\t}\n    \t\t\t}\n    \t\t}\n    \t}\n    }\n    cout << mf() << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMAXN = 300\nINF = 10**9\n\nclass Edge:\n    def __init__(self, to, rev, f, cap):\n        self.to = to\n        self.rev = rev\n        self.f = f\n        self.cap = cap\n\nadj = [[] for _ in range(MAXN)]\n\ndef add_edge(u, v, c, rc=0):\n    a = Edge(v, len(adj[v]), 0, c)\n    b = Edge(u, len(adj[u]), 0, rc)\n    adj[u].append(a)\n    adj[v].append(b)\n\ndis = [0] * MAXN\nptr = [0] * MAXN\nsrc = 0\ndst = 0\n\ndef bfs():\n    global dis\n    dis = [-1] * MAXN\n    dis[src] = 0\n    q = deque([src])\n    while q and dis[dst] == -1:\n        u = q.popleft()\n        for e in adj[u]:\n            v = e.to\n            if dis[v] == -1 and e.f < e.cap:\n                dis[v] = dis[u] + 1\n                q.append(v)\n    return dis[dst] != -1\n\ndef dfs(u, f):\n    if u == dst or not f:\n        return f\n    for i in range(ptr[u], len(adj[u])):\n        ptr[u] = i\n        e = adj[u][i]\n        v = e.to\n        if dis[v] != dis[u] + 1:\n            continue\n        df = dfs(v, min(f, e.cap - e.f))\n        if df:\n            e.f += df\n            adj[v][e.rev].f -= df\n            return df\n    return 0\n\ndef mf():\n    res = 0\n    while bfs():\n        ptr = [0] * MAXN\n        while True:\n            df = dfs(src, INF)\n            if not df:\n                break\n            res += df\n    return res\n\ndx = [-1, 0, 0, 1]\ndy = [0, -1, 1, 0]\n\nn = 0\nm = 0\n\ndef gbfs(r, c, dis_grid, chk=False):\n    for i in range(n):\n        for j in range(n):\n            dis_grid[i][j] = -1\n    dis_grid[r][c] = 0\n    q = deque()\n    q.append((r, c))\n    while q:\n        p = q.popleft()\n        if chk and dis_grid[p[0]][p[1]] == tim[p[0]][p[1]]:\n            continue\n        for i in range(4):\n            r_new = (p[0] + dx[i], p[1] + dy[i])\n            if r_new[0] < 0 or r_new[0] >= n or r_new[1] < 0 or r_new[1] >= n or dis_grid[r_new[0]][r_new[1]] != -1 or obs[r_new[0]][r_new[1]]:\n                continue\n            if chk and tim[r_new[0]][r_new[1]] > -1 and dis_grid[p[0]][p[1]] + 1 > tim[r_new[0]][r_new[1]]:\n                continue\n            dis_grid[r_new[0]][r_new[1]] = dis_grid[p[0]][p[1]] + 1\n            q.append(r_new)\n\nlab = []\nrea = []\n\ndef main():\n    global n, m, obs, tim, dii, src, dst, adj\n    input_data = sys.stdin.read().strip().split('\\n')\n    if not input_data:\n        return\n    idx = 0\n    n, m = map(int, input_data[idx].split())\n    idx += 1\n    lab = input_data[idx:idx+n]\n    idx += n\n    rea = input_data[idx:idx+n]\n    idx += n\n    \n    obs = [[0]*n for _ in range(n)]\n    tim = [[0]*n for _ in range(n)]\n    dii = [[0]*n for _ in range(n)]\n    \n    for i in range(n):\n        for j in range(n):\n            obs[i][j] = 1 if lab[i][j] == 'Y' else 0\n    \n    for i in range(n):\n        for j in range(n):\n            if lab[i][j] == 'Z':\n                gbfs(i, j, tim)\n    \n    src = 2*n*n + 5\n    dst = src + 1\n    \n    # Reset adjacency list\n    adj = [[] for _ in range(MAXN)]\n    \n    for x in range(n):\n        for y in range(n):\n            if lab[x][y] == 'Z' or lab[x][y] == 'Y':\n                continue\n            add_edge(src, n*x + y, int(lab[x][y]))\n            add_edge(n*n + n*x + y, dst, int(rea[x][y]))\n            gbfs(x, y, dii, True)\n            for xp in range(n):\n                for yp in range(n):\n                    if dii[xp][yp] != -1 and dii[xp][yp] <= m:\n                        add_edge(n*x + y, n*n + n*xp + yp, INF)\n    \n    print(mf())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014482879487331957, -1.1920922133867862e-06, -3.576278118089249e-07, -0.15043842792510986, -0.006233653519302607, -3.576278118089249e-07, -7.676783570786938e-05, -0.00021240839851088822, -9.536738616588991e-07, -5.030505417380482e-05, -0.0024942022282630205, -0.5781784653663635, -4.768370445162873e-07, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -1.2874520507466514e-05, -6.735097849741578e-05, -0.0001081169830285944, -8.344646857949556e-07, -0.03208063170313835, -2.3841855067985307e-07, -1.7881233361549675e-05, -8.010543388081715e-05, -3.611976353568025e-05, -8.34461570775602e-06, -0.018345791846513748, -0.0002865380665753037, -2.0265558760002023e-06, -3.576278118089249e-07, -0.6325996518135071, -1.1920928244535389e-07, -3.2186455882765586e-06, -1.1920928244535389e-07, -1.311301275563892e-06, 0.0, -2.622600959512056e-06, -0.0002924968139268458, -3.313963316031732e-05, -8.594620157964528e-05, -3.814689989667386e-06, -7.688703772146255e-05, -2.7418097943154862e-06, -1.9073468138230965e-06, -6.198863957251888e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, 0.0, -0.00010525626566959545, -3.576278118089249e-07, -6.198863957251888e-06, -7.152555099310121e-07, -2.3841855067985307e-07, -4.529942543740617e-06, 0.0, -1.1920928244535389e-07, -2.0265558760002023e-06, -4.768370445162873e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -1.3947389561508317e-05, -2.3841855067985307e-07, -3.814689989667386e-06, -7.223821739898995e-05, -0.02069651149213314, -5.364403477869928e-06, -0.0007284610182978213, -9.536738616588991e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -1.6689286894688848e-06, -1.5020257706055418e-05, 0.0, -6.19886395725