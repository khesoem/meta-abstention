];\ntf cap[MAXN],mxflow;\nbool in_queue[MAXN];\nvoid flow(int s, int t){\n\tmemset(in_queue,0,sizeof(in_queue));\n\tmxflow=mncost=0;\n\twhile(1){\n\t\tfill(dist,dist+nodes,INFCOSTO);dist[s]=0;\n\t\tmemset(pre,-1,sizeof(pre));pre[s]=0;\n\t\tmemset(cap,0,sizeof(cap));cap[s]=INFFLUJO;\n\t\tqueue<int> q;q.push(s);in_queue[s]=1;\n\t\twhile(SZ(q)){\n\t\t\tint u=q.front();q.pop();in_queue[u]=0;\n\t\t\tfore(_,0,SZ(g[u])){\n\t\t\t\tint i=g[u][_];\n\t\t\t\tedge &E=e[i];\n\t\t\t\tif(E.rem()&&dist[E.v]>dist[u]+E.cost+1e-9){\n\t\t\t\t\tdist[E.v]=dist[u]+E.cost;\n\t\t\t\t\tpre[E.v]=i;\n\t\t\t\t\tcap[E.v]=min(cap[u],E.rem());\n\t\t\t\t\tif(!in_queue[E.v])q.push(E.v),in_queue[E.v]=1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(pre[t]<0)break;\n\t\tmxflow+=cap[t];mncost+=cap[t]*dist[t];\n\t\tfor(int v=t;v!=s;v=e[pre[v]].u){\n\t\t\te[pre[v]].flow+=cap[t];e[pre[v]^1].flow-=cap[t];\n\t\t}\n\t}\n}\nint main() {\n  ios::sync_with_stdio(false);\n\tll n,m,k,c,d;\n  cin>>n>>m>>k>>c>>d;\n\tint MAXT=n+k;\n\tif(DEBUG)cout<<\"MAXT: \"<<MAXT<<endl;\n\tvector<int>a(k);\n\tfore(i,0,k){\n\t\tcin>>a[i];a[i]--;\n\t\tadd_edge(SRC,a[i]*MAXT,1,0);\n\t}\n\tfore(j,0,MAXT)add_edge(j,SNC,k,0);\n\tfore(i,0,m) {\n\t\tint x,y;cin>>x>>y;x--,y--;\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(x*MAXT+j,y*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(y*MAXT+j,x*MAXT+j+1,1,c+d*(2*K-1));\n\t\t}\n\t}\n\tfore(i,0,n) {\n\t\tfore(j,0,MAXT-1)fore(K,1,k+1) {\n\t\t\tadd_edge(i*MAXT+j,i*MAXT+j+1,1,c);\n\t\t}\n\t}\n\tflow(SRC,SNC);\n\tif(DEBUG)cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n\tcout<<mncost<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    MAXT = n + k\n    # constants for min-cost max-flow\n    INFCOSTO = 10**14\n    INFFLUJO = 10**14\n    MAXN = 50 * 100 + 15\n    SRC = MAXN - 1\n    SNC = MAXN - 2\n    nodes = MAXN\n    # graph representation\n    e = []  # list of edges: [u, v, cap, flow, cost]\n    g = [[] for _ in range(nodes)]  # adjacency list: list of edge indices\n\n    def add_edge(u: int, v: int, cap: int, cost: int) -> None:\n        g[u].append(len(e))\n        e.append([u, v, cap, 0, cost])\n        g[v].append(len(e))\n        e.append([v, u, 0, 0, -cost])\n\n    # read starting positions\n    a = []\n    for _ in range(k):\n        pos = int(next(it)) - 1\n        a.append(pos)\n        add_edge(SRC, pos * MAXT, 1, 0)\n\n    # sink edges from every time node (index j) for place 0?\n    for j in range(MAXT):\n        add_edge(j, SNC, k, 0)\n\n    # movement edges between places\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                cost = c + d * (2 * K - 1)\n                add_edge(x * MAXT + j, y * MAXT + j + 1, 1, cost)\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                cost = c + d * (2 * K - 1)\n                add_edge(y * MAXT + j, x * MAXT + j + 1, 1, cost)\n\n    # stay edges\n    for i in range(n):\n        for j in range(MAXT - 1):\n            for K in range(1, k + 1):\n                add_edge(i * MAXT + j, i * MAXT + j + 1, 1, c)\n\n    # min-cost max-flow (successive shortest augmenting path with SPFA)\n    def flow(s: int, t: int):\n        mncost = 0\n        mxflow = 0\n        while True:\n            dist = [INFCOSTO] * nodes\n            pre = [-1] * nodes\n            cap = [0] * nodes\n            in_queue = [False] * nodes\n            dist[s] = 0\n            cap[s] = INFFLUJO\n            q = [s]\n            in_queue[s] = True\n            while q:\n                u = q.pop(0)\n                in_queue[u] = False\n                for idx in g[u]:\n                    E = e[idx]\n                    if E[2] - E[3] > 0 and dist[E[1]] > dist[u] + E[4]:\n                        dist[E[1]] = dist[u] + E[4]\n                        pre[E[1]] = idx\n                        cap[E[1]] = min(cap[u], E[2] - E[3])\n                        if not in_queue[E[1]]:\n                            q.append(E[1])\n                            in_queue[E[1]] = True\n            if pre[t] < 0:\n                break\n            mxflow += cap[t]\n            mncost += cap[t] * dist[t]\n            v = t\n            while v != s:\n                idx = pre[v]\n                e[idx][3] += cap[t]\n                e[idx ^ 1][3] -= cap[t]\n                v = e[idx][0]\n        return mxflow, mncost\n\n    mxflow, mncost = flow(SRC, SNC)\n    print(mncost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.318072337307967e-06, -1.0728830375228426e-06, 0.0, -0.0006115949945524335, -0.0025202438700944185, -9.536738616588991e-07, -0.3133963644504547, -0.1448938101530075, -0.18562182784080505, -0.8262466788291931, -6.603976362384856e-05, -2.264974000354414e-06, -3.4570634852570947e-06, -7.033323527139146e-06, -0.23593823611736298, -4.768258077092469e-05, -0.014355949126183987, -1.1920928244535389e-07, -0.0013303249143064022, -6.198863957251888e-06, -0.2014191746711731, -3.6954811548639555e-06, 0.0, -6.437280717364047e-06, -2.3841855067985307e-07, -0.0019317077239975333, -2.3841855067985307e-07, 0.0, -0.0007098776986822486, -3.576278118089249e-07, -1.4305104514278355e-06, -3.158996332786046e-05, -5.960462772236497e-07, -6.151010165922344e-05, -1.0728830375228426e-06, 0.0, -0.0005539313424378633, -0.048594824969768524, -0.04859652742743492, -0.0015282867243513465, -0.00012575789878610522, 0.0, 0.0, 0.0, -0.011127793230116367, 0.0, 0.0, -2.2053474822314456e-05, 0.0, -