        List<Integer> a1 = new ArrayList<>();\n        List<Integer> a2 = new ArrayList<>();\n        int n1 = n / 2;\n\n        // Generate all subset sums for first half\n        sums1(0, 0, n1, a, m, a1);\n        // Generate all subset sums for second half\n        sums2(n1, 0, n, a, m, a2);\n\n        // Remove duplicates and sort\n        Set<Integer> setA1 = new HashSet<>(a1);\n        a1 = new ArrayList<>(setA1);\n        Collections.sort(a1);\n\n        int ans = 0;\n\n        // For each sum in second half, find best complement in first half\n        for (int sumSec : a2) {\n            int target = m - sumSec;\n            int idx = bisectLeft(a1, target);\n            if (idx > 0) {\n                int candidate = a1.get(idx - 1) + sumSec;\n                if (candidate > ans) {\n                    ans = candidate;\n                }\n            }\n        }\n\n        System.out.println(ans);\n        sc.close();\n    }\n\n    static void sums1(int i, int sum, int limit, int[] a, int m, List<Integer> list) {\n        if (i == limit) {\n            list.add(sum % m);\n        } else {\n            sums1(i + 1, sum + a[i], limit, a, m, list);\n            sums1(i + 1, sum, limit, a, m, list);\n        }\n    }\n\n    static void sums2(int i, int sum, int n, int[] a, int m, List<Integer> list) {\n        if (i == n) {\n            list.add(sum % m);\n        } else {\n            sums2(i + 1, sum + a[i], n, a, m, list);\n            sums2(i + 1, sum, n, a, m, list);\n        }\n    }\n\n    static int bisectLeft(List<Integer> list, int target) {\n        int low = 0, high = list.size();\n        while (low < high) {\n            int mid = (low + high) / 2;\n            if (list.get(mid) < target) {\n                low = mid + 1;\n            } else {\n                high = mid;\n            }\n        }\n        return low;\n    }\n}\n</translated_code>\n<confidence>0.9</confidence>", "token_logprobs": [-0.00026264708139933646, -5.512236498361744e-07,