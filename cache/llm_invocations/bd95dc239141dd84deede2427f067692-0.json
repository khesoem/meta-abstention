ain {\n    static final long MOD = 1000000007L;\n\n    static long qmul(long a, long b, long Mod) {\n        long ans = 0;\n        while (b != 0) {\n            if ((b & 1) != 0) ans = (ans + a) % Mod;\n            b >>= 1;\n            a = (a + a) % Mod;\n        }\n        return ans;\n    }\n\n    static long qpow(long a, long b, long Mod) {\n        long ans = 1;\n        while (b != 0) {\n            if ((b & 1) != 0) ans = qmul(ans, a, Mod);\n            b >>= 1;\n            a = qmul(a, a, Mod);\n        }\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long p = scanner.nextLong();\n        long k = scanner.nextLong();\n        scanner.close();\n\n        long ret = 0;\n        if (k == 0) {\n            ret = qpow(p, p - 1, MOD);\n        } else if (k == 1) {\n            ret = qpow(p, p, MOD);\n        } else if (k > 1) {\n            long len = 1;\n            long cur = k;\n            while (cur != 1) {\n                cur = (cur * k) % p;\n                ++len;\n            }\n            ret = qpow(p, (p - 1) / len, MOD);\n        }\n        System.out.println(ret);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.576278e-07, 0.0, 0.0, -0.00021145493, -1.6450747e-05, -1.7881378e-06, -0.0023392476, -0.014591765, -0.00092928135, -9.8700424e-05, -1.1920928e-07, -0.019988183, -0.0024873053, -0.00194075, -0.3380352, -0.005238734, -2.801379e-05, -0.16022795, -2.3841855e-07, -3.2186456e-06, -0.00055309734, -3.576278e-07, -1.1920928e-07, -1.3113013e-06, -8.106199e-06, -0.0067243483, -1.7881378e-06, -0.015883354, -3.576278e-07, -0.007352081, -0.0040848157, -4.7683704e-07, 0.0, 0.0, -1.1920928e-07, 0.0, -0.0007098777, 0.0, -0.97437453, -5.960463e-07, -2.622601e-06, -1.1920928e-07, -7.748574e-06, -1.4305105e-06, 0.0, 0.0, -2.3841855e-07, -7.5933436e-05, -2.3841855e-07, -0.0034644129, 0.0, 0.0, -0.4740801, 0.0, -1.1920928e-07, -1.430510