\t\t\tll cur=q.top();\n\t\t\t\tint d=cur>>32, u=cur;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u])\n\t\t\t\t\tcontinue;\n\t\t\t\tfor(int i=0; i<SZ(adj[u]); ++i) {\n\t\t\t\t\tEdge &e=adj[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif (e.cap<=e.f)\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\tint nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif (prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push(((ll)nprio<<32)+v);\n\t\t\t\t\t\tprevnode[v]=u;\n\t\t\t\t\t\tprevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INT_MAX)\n\t\t\t\tbreak;\n\t\t\tfor(int i=0; i<n; ++i)\n\t\t\t\tpot[i]+=prio[i];\n\t\t\tint df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tEdge &e=adj[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df;\n\t\t\t\tadj[v][e.rev].f-=df;\n\t\t\t\tflowCost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn make_pair(flow, flowCost);\n\t}\n};\n\nint n,m,k,c,d;\n \nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tMCF nt(6+107*n);\n\tfore(_,0,k){\n\t\tint x;\n\t\tscanf(\"%d\",&x);x--;\n\t\tnt.addEdge(0,1+x,1,0);\n\t}\n\tfore(_,0,m){\n\t\tint x,y;\n\t\tscanf(\"%d%d\",&x,&y);x--;y--;\n\t\tfore(i,0,105){\n\t\t\tfore(j,0,51){\n\t\t\t\tnt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n\t\t\t\tnt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n\t\t\t}\n\t\t}\n\t}\n\tfore(i,0,105)fore(j,0,n)nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n\tfore(i,0,105)nt.addEdge(1+i*n,1+105*n,51,0);\n\tauto ans=nt.minCostFlow(0,1+105*n);\n\tprintf(\"%d\\n\",ans.snd);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1_000_000_000;\n\n    static class Edge {\n        int to, f, cap, cost, rev;\n        Edge(int to, int f, int cap, int cost, int rev) {\n            this.to = to;\n            this.f = f;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static class MCF {\n        int n;\n        int[] u, v, prio, curflow, prevedge, prevnode, pot;\n        List<List<Edge>> adj;\n        PriorityQueue<Long> q;\n\n        MCF(int n) {\n            this.n = n;\n            this.u = new int[n];\n            this.v = new int[n];\n            this.prio = new int[n];\n            this.curflow = new int[n];\n            this.prevedge = new int[n];\n            this.prevnode = new int[n];\n            this.pot = new int[n];\n            this.adj = new ArrayList<>();\n            for (int i = 0; i < n; i++) {\n                adj.add(new ArrayList<>());\n            }\n            this.q = new PriorityQueue<>();\n        }\n\n        void addEdge(int s, int t, int cap, int cost) {\n            Edge a = new Edge(t, 0, cap, cost, adj.get(t).size());\n            Edge b = new Edge(s, 0, 0, -cost, adj.get(s).size());\n            adj.get(s).add(a);\n            adj.get(t).add(b);\n        }\n\n        int[] minCostFlow(int s, int t) {\n            int flow = 0, flowCost = 0;\n            while (flow < INF) {\n                q.offer((long) s);\n                Arrays.fill(prio, Integer.MAX_VALUE);\n                prio[s] = 0;\n                curflow[s] = Integer.MAX_VALUE;\n\n                while (!q.isEmpty()) {\n                    long cur = q.poll();\n                    int d = (int) (cur >>> 32);\n                    int uNode = (int) cur;\n                    if (d != prio[uNode]) continue;\n\n                    for (int i = 0; i < adj.get(uNode).size(); i++) {\n                        Edge e = adj.get(uNode).get(i);\n                        int v = e.to;\n                        if (e.cap <= e.f) continue;\n                        int nprio = prio[uNode] + e.cost + pot[uNode] - pot[v];\n                        if (prio[v] > nprio) {\n                            prio[v] = nprio;\n                            q.offer(((long) nprio << 32) + v);\n                            prevnode[v] = uNode;\n                            prevedge[v] = i;\n                            curflow[v] = Math.min(curflow[uNode], e.cap - e.f);\n                        }\n                    }\n                }\n\n                if (prio[t] == Integer.MAX_VALUE) break;\n\n                for (int i = 0; i < n; i++) {\n                    pot[i] += prio[i];\n                }\n\n                int df = Math.min(curflow[t], INF - flow);\n                flow += df;\n                for (int v = t; v != s; v = prevnode[v]) {\n                    Edge e = adj.get(prevnode[v]).get(prevedge[v]);\n                    e.f += df;\n                    adj.get(v).get(e.rev).f -= df;\n                    flowCost += df * e.cost;\n                }\n            }\n            return new int[]{flow, flowCost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        MCF nt = new MCF(6 + 107 * n);\n\n        for (int _ = 0; _ < k; _++) {\n            int x = sc.nextInt();\n            x--;\n            nt.addEdge(0, 1 + x, 1, 0);\n        }\n\n        for (int _ = 0; _ < m; _++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            x--;\n            y--;\n            for (int i = 0; i < 105; i++) {\n                for (int j = 0; j < 51; j++) {\n                    nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1));\n                    nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1));\n                }\n            }\n        }\n\n        for (int i = 0; i < 105; i++) {\n            for (int j = 0; j < n; j++) {\n                nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c);\n            }\n        }\n\n        for (int i = 0; i < 105; i++) {\n            nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0);\n        }\n\n        int[] ans = nt.minCostFlow(0, 1 + 105 * n);\n        System.out.println(ans[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015925093612167984, -4.0531076592742465e-06, -4.768370445162873e-07, -0.0017776177264750004, -2.7656173188006505e-05, -0.31327348947525024, -0.22548627853393555, -0.00043466180795803666, -9.536738616588991e-07, -0.0001674750237725675, -0.07889106869697571, -0.0025206005666404963, -0.008818254806101322, -0.6485876441001892, -0.000105375460407231, -3.480850500636734e-05, -1.1920928244535389e-07, -0.12696512043476105, -4.768370445162873e-07, -0.0788944810628891, 0.0, 0.0, 0.0, -9.536738616588991e-07, 0.0, 0.0, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -4.768370445162873e-07, -0.2014138251543045, -2.3841830625315197e-06, -8.106198947643861e-06, -6.437280717364047e-06, -0.04893803969025612, -7.629365427419543e-06, -5.960462772236497e-07, -4.0531076592742465e-06, -1.0728830375228426e-06, -0.004647880792617798, -0.005967419594526291, -1.1920928244535389e-07, -5.602820692729438e-06, 0.0, -2.0265558760002023e-06, 0.0, -5.125986263010418e-06, -0.4740772843360901, -0.20142151415348053, -6.615896563744172e-05, -1.7881377516459906e-06, -4.529942543740617e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, -1.6689286894688848e-06, 0.0, -2.3841855067985307e-07, -4.529942543740617e-06, 0.0, 0.0, -9.536697689327411e-06, -7.152555099310121e-07, -4.768370445162873e-07, -3.576214658096433e-05, -2.50339189733495e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.053033626405522e-05, -1.5497195136049413e-06, -2.145764938177308e-06, -1.1920928244535389e-07, 0.0, 0.0, -3.576278118089249e-07, -4.172316494077677e-06, -8.344646857949556e-07, -2.288792165927589e-05, 0.0, -1.5497195136049413e-06, -8.344646857949556e-07, -6.186770770000294