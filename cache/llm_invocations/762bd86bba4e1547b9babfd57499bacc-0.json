 long s2 = C[cv2][r];\n                stack.push(new long[]{cx, cy + c1 * s2, cv1 - 1, cv2});\n            }\n        }\n    }\n\n    long solve(long x, long y, int v1, int v2) {\n        long k = x * 10000 + v1 * 100 + v2;\n        Long got = cache.get(k);\n        if (got != null) return got;\n        long val = 0L;\n        long d = Math.abs(x - y);\n        if (d - C[v1][r] * C[v2][r] > best) {\n            cache.put(k, val);\n            return val;\n        }\n        if (v1 == 0 && v2 == 0) return 1L;\n        char ch = cs[v1 + v2 - 1];\n        if (v1 > 0 && ch != 'B') {\n            long c1 = C[v1][r] - C[v1 - 1][r];\n            long s2 = C[v2][r];\n            val += solve(x, y + c1 * s2, v1 - 1, v2);\n        }\n        if (v2 > 0 && ch != 'A') {\n            long s1 = C[v1][r];\n            long c2 = C[v2][r] - C[v2 - 1][r];\n            val += solve(x + s1 * c2, y, v1, v2 - 1);\n        }\n        cache.put(k, val);\n        return val;\n    }\n\n    void start() {\n        r = in.nextInt();\n        c = in.nextInt();\n        in.nextLine();\n        cs = in.nextLine().toCharArray();\n        int n = 2 * (r + c);\n        for (int i = 0; i <= n; i++) {\n            for (int j = 0; j <= n; j++) {\n                if (j == 0) C[i][j] = 1L;\n                else if (i == 0) C[i][j] = 0L;\n                else C[i][j] = C[i - 1][j - 1] + C[i - 1][j];\n            }\n        }\n        int v1 = r + c, v2 = r + c;\n        long x = 0, y = 0;\n        while (v1 >= r && v2 >= r) {\n            if (x > y) {\n                long c1 = C[v1][r] - C[v1 - 1][r];\n                long s2 = C[v2][r];\n                y += c1 * s2;\n                v1--;\n            } else {\n                long s1 = C[v1][r];\n                long c2 = C[v2][r] - C[v2 - 1][r];\n                x += s1 * c2;\n                v2--;\n            }\n        }\n        best = Math.abs(x - y);\n        dfs(0, 0, r + c, r + c);\n        System.out.println(solve(0, 0, r + c, r + c));\n   