{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n#define db(x) cout << (x) << '\\n';\nusing namespace std;\ntypedef long long ll;\ntypedef pair<ll,ll> pii;\ntypedef pair<ll,pii> pip;\ntypedef pair<pii,pii> ppp;\ntypedef long double ld;\n#include <ext/pb_ds/assoc_container.hpp>\n#include <ext/pb_ds/tree_policy.hpp>\nusing namespace __gnu_pbds;\n\ntypedef tree<ll, null_type, less<ll>,rb_tree_tag, tree_order_statistics_node_update> ordered_set;\n\n/*\n    Minimum Cost Flow (Tomizawa, Edmonds-Karp)\n    Complexity:\n    O(F m log n), where F is the amount of maximum flow\n    Tested:\n    Codeforces [http://codeforces.com/problemset/problem/717/G]\n*/\ntemplate<typename flow_type, typename cost_type>\nstruct min_cost_max_flow\n{\n    struct edge\n    {\n        size_t src, dst, rev;\n        flow_type flow, cap;\n        cost_type cost;\n    };\n    int n;\n    vector<vector<edge>> adj;\n    min_cost_max_flow(int n) : n(n), adj(n), potential(n), dist(n), back(n) {}\n    void add_edge(size_t src, size_t dst, flow_type cap, cost_type cost)\n    {\n        adj[src].push_back({src, dst, adj[dst].size(), 0, cap, cost});\n        if (src == dst)\n            adj[src].back().rev++;\n        adj[dst].push_back({dst, src, adj[src].size() - 1, 0, 0, -cost});\n    }\n    vector<cost_type> potential;\n    inline cost_type rcost(const edge &e)\n    {\n        return e.cost + potential[e.src] - potential[e.dst];\n    }\n\n//    void bellman_ford(int source)\n//    {\n//        for (int k = 0; k < n; ++k)\n//            for (int u = 0; u < n; ++u)\n//                for (edge &e : adj[u])\n//                    if (e.cap > 0 && rcost(e) < 0)\n//                        potential[e.dst] += rcost(e);\n//    }\n    const cost_type oo = numeric_limits<cost_type>::max();\n    vector<cost_type> dist;\n    vector<edge * > back;\n    cost_type dijkstra(int source, int sink)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> node;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        for (pq.push({dist[source] = 0, source}); !pq.empty();)\n        {\n            node p = pq.top();\n            pq.pop();\n            if (dist[p.second] < p.first)\n                continue;\n            if (p.second == sink)\n                break;\n            for (edge &e : adj[p.second])\n                if (e.flow < e.cap &&\n                        dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({\n                        dist[e.dst] = dist[e.src] + rcost(e),\n                        e.dst\n                    });\n                }\n        }\n        return dist[sink];\n    }\n    pair<flow_type, cost_type> max_flow(int source, int sink)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        back.assign(n, nullptr);\n//        bellman_ford(source); // remove negative costs\n        while (dijkstra(source, sink) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n            if (dist[u] < dist[sink])\n                potential[u] += dist[u] - dist[sink];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (edge * e = back[sink]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (edge * e = back[sink]; e; e = back[e->src])\n                e->flow += f, adj[e->dst][e->rev].flow -= f;\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n\n    int n,m,k,c,d,u,v;\n    cin >> n >> m >> k >> c >> d;\n    min_cost_max_flow<int,int> g((n+2)*102);\n    for(int i=0;i<102;i++)\n        g.add_edge((i*(n+2))+1,i*(n+2),100,(i*c));\n    for(int i=0;i<101;i++)\n        for(int j=0;j<n+1;j++)\n            g.add_edge(j+(i*(n+2)),j+((i+1)*(n+2)),100,0);\n    for(int i=0;i<k;i++)\n    {\n        cin >> u;\n        g.add_edge(n+1,u,1,0);\n    }\n\n    for(int i=0;i<m;i++)\n    {\n        cin >> u >> v;\n        for(int j=0;j<101;j++)\n            for(int f=0;f<k;f++)\n            {\n                g.add_edge(u+(j*(n+2)),v+((j+1)*(n+2)),1,((2*f)+1)*d);\n                g.add_edge(v+(j*(n+2)),u+((j+1)*(n+2)),1,((2*f)+1)*d);\n            }\n    }\n\n    db(g.max_flow(n+1,(101*(n+2))).second)\n\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    n, m, k, c, d = map(int, data[:5])\n    data_idx = 5\n\n    class Edge:\n        def __init__(self, src, dst, rev, flow, cap, cost):\n            self.src = src\n            self.dst = dst\n            self.rev = rev\n            self.flow = flow\n            self.cap = cap\n            self.cost = cost\n\n    class MinCostMaxFlow:\n        def __init__(self, n):\n            self.n = n\n            self.adj = [[] for _ in range(n)]\n            self.potential = [0] * n\n            self.dist = [0] * n\n            self.back = [None] * n\n\n        def add_edge(self, src, dst, cap, cost):\n            self.adj[src].append(Edge(src, dst, len(self.adj[dst]), 0, cap, cost))\n            if src == dst:\n                self.adj[src][-1].rev += 1\n            self.adj[dst].append(Edge(dst, src, len(self.adj[src]) - 1, 0, 0, -cost))\n\n        def rcost(self, e):\n            return e.cost + self.potential[e.src] - self.potential[e.dst]\n\n        def dijkstra(self, source, sink):\n            oo = float('inf')\n            self.dist = [oo] * self.n\n            self.back = [None] * self.n\n            self.dist[source] = 0\n            pq = [(0, source)]\n            while pq:\n                dist_u, u = heapq.heappop(pq)\n                if self.dist[u] < dist_u:\n                    continue\n                if u == sink:\n                    break\n                for e in self.adj[u]:\n                    if e.flow < e.cap and self.dist[e.dst] > self.dist[u] + self.rcost(e):\n                        self.dist[e.dst] = self.dist[u] + self.rcost(e)\n                        self.back[e.dst] = e\n                        heapq.heappush(pq, (self.dist[e.dst], e.dst))\n            return self.dist[sink]\n\n        def max_flow(self, source, sink):\n            flow = 0\n            cost = 0\n            for u in range(self.n):\n                for e in self.adj[u]:\n                    e.flow = 0\n            self.potential = [0] * self.n\n            self.dist = [0] * self.n\n            self.back = [None] * self.n\n            while self.dijkstra(source, sink) < float('inf'):\n                for u in range(self.n):\n                    if self.dist[u] < self.dist[sink]:\n                        self.potential[u] += self.dist[u] - self.dist[sink]\n                f = float('inf')\n                e = self.back[sink]\n                while e:\n                    f = min(f, e.cap - e.flow)\n                    e = self.back[e.src]\n                e = self.back[sink]\n                while e:\n                    e.flow += f\n                    self.adj[e.dst][e.rev].flow -= f\n                    e = self.back[e.src]\n                flow += f\n                cost += f * (self.potential[sink] - self.potential[source])\n            return flow, cost\n\n    g = MinCostMaxFlow((n + 2) * 102)\n\n    for i in range(102):\n        g.add_edge((i * (n + 2)) + 1, i * (n + 2), 100, i * c)\n    for i in range(101):\n        for j in range(n + 1):\n            g.add_edge(j + (i * (n + 2)), j + ((i + 1) * (n + 2)), 100, 0)\n    for _ in range(k):\n        u = int(data[data_idx])\n        data_idx += 1\n        g.add_edge(n + 1, u, 1, 0)\n\n    for _ in range(m):\n        u = int(data[data_idx])\n        v = int(data[data_idx + 1])\n        data_idx += 2\n        for j in range(101):\n            for f in range(k):\n                g.add_edge(u + (j * (n + 2)), v + ((j + 1) * (n + 2)), 1, ((2 * f) + 1) * d)\n                g.add_edge(v + (j * (n + 2)), u + ((j + 1) * (n + 2)), 1, ((2 * f) + 1) * d)\n\n    _, min_cost = g.max_flow(n + 1, (101 * (n + 2)))\n    print(min_cost)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00015788905147928745, -5.431207682704553e-05, -9.088346359931165e-07, -1.664371848164592e-05, -0.14391757547855377, -0.0019528986886143684, -3.619311974034645e-05, -0.0009237268241122365, -0.006936540361493826, -4.320199877838604e-07, -0.5764803886413574, -0.18123190104961395, -0.4872058033943176, -7.896309739408025e-07, -4.961759259458631e-06, -0.0032050427980720997, -0.016767989844083786, -1.9361264946837764e-07, 0.0, -0.00014036978245712817, -0.18214163184165955, -1.2664456789934775e-06, -0.0007811574032530189, -5.180879816180095e-05, -0.179783