os, stdout);\n        out_pos = 0;\n    }\n    \n    inline void put_char(char c) {\n        out_buf[out_pos++] = c;\n        if (out_pos >= BUF_SIZE) flush_out();\n    }\n    \n    template<typename T>\n    inline void write_int(T x, char sep = '\\n') {\n        if (x < 0) { put_char('-'); x = -x; }\n        if (x == 0) { put_char('0'); if (sep != -1) put_char(sep); return; }\n        char tmp[20];\n        int len = 0;\n        while (x) { tmp[len++] = '0' + x % 10; x /= 10; }\n        while (len--) put_char(tmp[len]);\n        if (sep != -1) put_char(sep);\n    }\n    \n    inline void write_str(const char* s) {\n        while (*s) put_char(*s++);\n    }\n}\n\nusing namespace IO;\n\nll pows[8] = {1, 10, 100, 1000, 10000, 100000, 1000000, 10000000};\nint global_idx = 0, result = 0;\nll N;\nll sum_vals[7];\nint cnt_vals[7];\nvector<int> stored_vals[7];\n\nvoid precompute(int cur, int depth) {\n    int val = (global_idx - cur + MOD) % MOD;\n    stored_vals[depth].push_back(val);\n    sum_vals[depth] = (sum_vals[depth] + val) % MOD;\n    cnt_vals[depth]++;\n    global_idx++;\n    \n    if (depth == 6) return;\n    for (int digit = 0; digit < 10; ++digit) {\n        precompute(cur * 10 + digit, depth + 1);\n    }\n}\n\nvoid handle_query(int base, ll pos) {\n    for (int d = 0; d < 7; ++d) {\n        ll target = (pos - 1LL * base * pows[d]) % MOD;\n        if (target < 0) target += MOD;\n        \n        int idx = lower_bound(stored_vals[d].begin(), stored_vals[d].end(), MOD - target) - stored_vals[d].begin();\n        int remaining = stored_vals[d].size() - idx;\n        \n        int term1 = sum_vals[d];\n        int term2 = (1LL * target * cnt_vals[d]) % MOD;\n        int term3 = (1LL * remaining * MOD) % MOD;\n        \n        result = (result + term1 + term2 - term3) % MOD2;\n        if (result < 0) result += MOD2;\n    }\n}\n\nvoid process_numbers(ll cur) {\n    if ((cur + 1) * pows[6] <= N + 1 && cur * pows[7] > N) {\n        handle_query(cur, global_idx + 1);