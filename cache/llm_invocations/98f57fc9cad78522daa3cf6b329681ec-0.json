          cost += f * (potential[sink] - potential[source]);\n            }\n            return new long[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        MinCostMaxFlow g = new MinCostMaxFlow((n + 2) * 102);\n        for (int i = 0; i < 102; i++) {\n            g.addEdge(i * (n + 2) + 1, i * (n + 2), 100, (long) i * c);\n        }\n        for (int i = 0; i < 101; i++) {\n            for (int j = 0; j < n + 1; j++) {\n                g.addEdge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0);\n            }\n        }\n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            g.addEdge(n + 1, u, 1, 0);\n        }\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < 101; j++) {\n                for (int f = 0; f < k; f++) {\n                    g.addEdge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, (long)(2 * f + 1) * d);\n                    g.addEdge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, (long)(2 * f + 1) * d);\n                }\n            }\n        }\n        long ans = g.maxFlow(n + 1, 101 * (n + 2))[1];\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [0.0, -1.1920928244535389e-07, -6.806619057897478e-05, -0.0001284993631998077, -1.1920928244535389e-07, -0.00015853578224778175, -0.022283174097537994, -0.02422715723514557, -2.3841855067985307e-07, -0.3139423131942749, -0.07891067862510681, -0.0052462052553892136, -0.009495452046394348, -0.00036054308293387294, -0.693391740322113, 0.0, -1.1920928244535389e-07, -1.5497195136049413e-06, -0.0015479261055588722, -4.0531076592742465e-06, -0.007915439084172249, -0.00012551