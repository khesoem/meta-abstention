 q in range(20):\n        for l in range(20 - q):\n            for s in range(maxi + 1):\n                T[q + l][s] += A[q][s] * B[l][s]\n    # set C from T mod p\n    for q in range(20):\n        for s in range(maxi + 1):\n            C[q][s] = T[q][s] % p\n    # fwt each C[i] inverse\n    for i in range(20):\n        fwt(C[i], maxi + 1, p, True)\n    # update F\n    for i in range(maxi + 1):\n        F[i] = C[pc[i]][i]\n\ndef sq(B, D, T, maxi, p, pc):\n    # reset T\n    for i in range(20):\n        T[i] = [0] * (maxi + 1)\n    # accumulate\n    for q in range(20):\n        for l in range(20 - q):\n            for s in range(maxi + 1):\n                T[q + l][s] += B[q][s] * B[l][s]\n    # set D from T mod p\n    for q in range(20):\n        for s in range(maxi + 1):\n            D[q][s] = T[q][s] % p\n    # fwt each D[i] inverse\n    for i in range(20):\n        fwt(D[i], maxi + 1, p, True)\n    # reset B\n    for i in range(20):\n        B[i] = [0] * (maxi + 1)\n    # set B from D\n    for i in range(maxi + 1):\n        B[pc[i]][i] = D[pc[i]][i]\n    # fwt each B[i] forward\n    for i in range(20):\n        fwt(B[i], maxi + 1, p, False)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n    if n & 1:\n        print(qpow(k, n, p))\n        return\n    maxi = nxt(n + 1) - 1\n    fac, ifac = pre(maxi, p)\n    pc = [0] * (maxi + 1)\n    for i in range(maxi + 1):\n        pc[i] = bin(i).count('1')\n    # initialize B\n    B = [[0] * (maxi + 1) for _ in range(20)]\n    for i in range(maxi + 1):\n        B[pc[i]][i] = ifac[i]\n    for i in range(20):\n        fwt(B[i], maxi + 1, p, False)\n    # initialize F\n    F = [0] * (maxi + 1)\n    F[0] = 1\n    # prepare arrays for mul and sq\n    A = [[0] * (maxi + 1) for _ in range(20)]\n    C = [[0] * (maxi + 1) for _ in range(20)]\n    T = [[0] * (maxi + 1) for _ in range(20)]\n    D = [[0] * (maxi + 1) for _ in range(20)]\n    orig = k\n    while k:\n        if k & 1:\n            mul(F, A, B, C, T, maxi, p, pc)\n        k >>= 1\n        if k:\n            sq(B, D, T, maxi, p, pc)\n    ans = (qpow(orig, n, p) - fac[n] * F[n] % p + p) % p\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.629365427419543e-06, 0.0, -2.3841855067985307e-07, -0.0009440494468435645, -0.008531905710697174, -1.6927575416048057e-05, -0.008654113858938217, -0.020292531698942184, -0.043045129626989365, -2.3841855067985307e-07, -0.00014876213390380144, -0.0003359945258125663, 0.0, -0.16034911572933197, -0.5762864947319031, -0.00036816971260122955, -1.5497195136049413e-06, -0.7258948683738708, -0.001176380319520831, -3.540453326422721e-05, 0.0, -7.545663538621739e-05, 0.0, -0.03900871425867081, 0.0, 0.0, -0.5759400725364685, 0.0, -4.0531076592742465e-06, 0.0, -9.655486064730212e-05, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -2.50339189733495e-06, -3.576278118089249e-07, 0.0, 0.0, -0.38687312602996826, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -7.867782187531702e-06, 0.0, 0.0, 0.0, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -0.00015853578224778175, 0.0, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, -4.768370445162873e-07, -0.0007126175914891064, -0.00030655929003842175, -0.31341660022735596, -1.1920928244535389e-07, -3.4570634852570947e-06, -2.13382354559144e-05, -1.1920928244535389e-07, -0.16401274502277374, 0.0, -0.12710873782634735, 0.0, -0.0019290901254862547, -3.3378546504536644e-06, 0.0, -8.344646857949556e-07, -1.1920928244535389e-07, -8.344646857949556e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.015849679708480835, 0.0, -1.0728830375228426e-06, 0.0, -0.5759404897689819, -2.3841855067985307e-07, -0.2519364655017853, -1.1920928244535389e-0