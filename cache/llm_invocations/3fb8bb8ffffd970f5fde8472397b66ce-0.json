 == 0 && cnt_a > 0) {\n            for (int j = 0; j < n; ++j) {\n                contrib += binom[cnt_a-1][n-1] * binom[cnt_b][j] * binom[total-pos][n-j];\n            }\n            dfs_b(pos-1, cnt_a-1, cnt_b, sum + contrib);\n        } else if (choice == 1 && cnt_b > 0) {\n            for (int j = 0; j < n; ++j) {\n                contrib -= binom[cnt_b-1][n-1] * binom[cnt_a][j] * binom[total-pos][n-j];\n            }\n            dfs_b(pos-1, cnt_a, cnt_b-1, sum + contrib);\n        }\n    }\n}\n\nvoid bfs_a() {\n    for (int i = 0; i <= n+m; ++i) {\n        for (int j = 0; j <= n+m; ++j) {\n            memo_a[i][j].clear();\n        }\n    }\n    memo_a[0][0][0] = 1;\n    \n    for (int i = 0; i <= n+m; ++i) {\n        for (int j = 0; j <= n+m; ++j) {\n            for (auto &[cur_sum, cnt] : memo_a[i][j]) {\n                if (i + j == mid) {\n                    auto it = lower_bound(memo_b[i][j].begin(), memo_b[i][j].end(), make_pair(-cur_sum, -1));\n                    if (it != memo_b[i][j].end()) {\n                        update_best(abs(cur_sum + it->first), cnt * it->second);\n                    }\n                    if (it != memo_b[i][j].begin()) {\n                        --it;\n                        update_best(abs(cur_sum + it->first), cnt * it->second);\n                    }\n                } else {\n                    int idx = i + j;\n                    for (int choice = 0; choice < 2; ++choice) {\n                        if (fixed_vals[idx] != -1 && choice != fixed_vals[idx]) continue;\n                        int na = i, nb = j;\n                        if (choice == 0) ++na;\n                        else ++nb;\n                        if (na <= n+m && nb <= n+m) {\n                            ll delta = 0;\n                            if (choice == 0) {\n                                for (int l = 0; l < n; ++l) {\n                                    delta += binom[na-1][n-1] * binom[nb][l] * binom[total-idx-1][n-l];\n                                }\n                            } else {\n                                for (int l = 0; l < n; ++l) {\n                                    delta -= binom[nb-1][n-1] * binom[na][l] * binom[total-idx-1][n-l];\n                                }\n                            }\n                            memo_a[na][nb][cur_sum + delta] += cnt;\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\nvoid process() {\n    for (int i = 0; i <= n+m; ++i) {\n        for (int j = 0; j <= n+m; ++j) {\n            memo_b[i][j].clear();\n        }\n    }\n    dfs_b(total, n+m, n+m);\n    \n    for (int i = 0; i <= n+m; ++i) {\n        for (int j = 0; j <= n+m; ++j) {\n            sort(memo_b[i][j].begin(), memo_b[i][j].end());\n            vector<pair<ll, int>> tmp;\n            int sz = memo_b[i][j].size();\n            for (int k = 0; k < sz; ) {\n                ll val = memo_b[i][j][k].first;\n                int total_cnt = 0;\n                while (k < sz && memo_b[i][j][k].first == val) {\n                    total_cnt += memo_b[i][j][k].second;\n                    ++k;\n                }\n                tmp.emplace_back(val, total_cnt);\n            }\n            memo_b[i][j] = move(tmp);\n        }\n    }\n    bfs_a();\n}\n\nint main() {\n#ifdef matthew99\n    freopen(\"input.txt\", \"r\", stdin);\n    freopen(\"output.txt\", \"w\", stdout);\n#endif\n    precompute_binomials();\n    char s[MAX_N + 5];\n    scanf(\"%d %d %s\", &n, &m, s);\n    total = (n + m) * 2;\n    mid = max(0, total - LIM);\n    memset(fixed_vals, -1, sizeof(fixed_vals));\n    \n    process();\n    best_count = 0;\n    for (int i = 0; i < total; ++i) {\n        if (s[i] == 'A') fixed_vals[i] = 0;\n        else if (s[i] == 'B') fixed_vals[i] = 1;\n    }\n    process();\n    cout << best_count << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "r