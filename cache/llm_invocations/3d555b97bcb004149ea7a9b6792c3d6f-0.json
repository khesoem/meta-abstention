{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Edge {\n    int to, cap, cost, rev;\n    Edge(int to, int cap, int cost, int rev) : to(to), cap(cap), cost(cost), rev(rev) {}\n};\n\nconst int INF = 0x3f3f3f3f;\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int s = 0, t = n * 100 + 1;\n    int nodeCount = t + 1;\n    vector<vector<Edge>> g(nodeCount);\n\n    auto addEdge = [&](int u, int v, int flow, int cost) {\n        Edge a(v, flow, cost, (int)g[v].size());\n        Edge b(u, 0, -cost, (int)g[u].size());\n        g[u].push_back(a);\n        g[v].push_back(b);\n    };\n\n    for (int i = 1; i <= 100; ++i) addEdge(i, t, 100, 0);\n    for (int i = 1; i <= k; ++i) {\n        int v; scanf(\"%d\", &v);\n        addEdge(s, (v - 1) * 100 + 1, 1, 0);\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j < 100; ++j) {\n            addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n        }\n    }\n    for (int i = 1; i <= m; ++i) {\n        int u, v; scanf(\"%d%d\", &u, &v);\n        for (int j = 1; j < 100; ++j) {\n            int idx = (u - 1) * 100 + j;\n            int idy = (v - 1) * 100 + j + 1;\n            for (int kk = 1; kk <= 20; ++kk) {\n                addEdge(idx, idy, 1, c + (kk * kk - (kk - 1) * (kk - 1)) * d);\n            }\n            int idx2 = (v - 1) * 100 + j;\n            int idy2 = (u - 1) * 100 + j + 1;\n            for (int kk = 1; kk <= 20; ++kk) {\n                addEdge(idx2, idy2, 1, c + (kk * kk - (kk - 1) * (kk - 1)) * d);\n            }\n        }\n    }\n\n    vector<int> dist(nodeCount), pre(nodeCount), preEdge(nodeCount);\n    vector<bool> inq(nodeCount, false);\n\n    auto spfa = [&]() -> bool {\n        fill(dist.begin(), dist.end(), INF);\n        fill(pre.begin(), pre.end(), -1);\n        fill(inq.begin(), inq.end(), false);\n        queue<int> q;\n        dist[s] = 0;\n        q.push(s);\n        inq[s] = true;\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n            for (int i = 0; i < (int)g[u].size(); ++i) {\n                Edge &e = g[u][i];\n                if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    pre[e.to] = u;\n                    preEdge[e.to] = i;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n        return dist[t] < INF;\n    };\n\n    int ans = 0;\n    while (spfa()) {\n        int add = INF;\n        for (int v = t; v != s; v = pre[v]) {\n            int u = pre[v];\n            int i = preEdge[v];\n            add = min(add, g[u][i].cap);\n        }\n        for (int v = t; v != s; v = pre[v]) {\n            int u = pre[v];\n            int i = preEdge[v];\n            Edge &e = g[u][i];\n            e.cap -= add;\n            g[v][e.rev].cap += add;\n        }\n        ans += dist[t] * add;\n    }\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nINF = 10**18\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    s = 0\n    t = n * 100 + 1\n    nodeCount = t + 1\n    g = [[] for _ in range(nodeCount)]\n\n    def add_edge(u, v, flow, cost):\n        g[u].append(Edge(v, flow, cost, len(g[v])))\n        g[v].append(Edge(u, 0, -cost, len(g[u]) - 1))\n\n    # sink edges from person1's time steps\n    for i in range(1, 101):\n        add_edge(i, t, 100, 0)\n\n    # source edges for initial persons\n    for _ in range(k):\n        v = next(it)\n        add_edge(s, (v - 1) * 100 + 1, 1, 0)\n\n    # waiting edges for each person\n    for i in range(1, n + 1):\n        base = (i - 1) * 100\n        for j in range(1, 100):\n            add_edge(base + j, base + j + 1, 100, c)\n\n    # road edges\n    for _ in range(m):\n        u = next(it); v = next(it)\n        for j in range(1, 100):\n            idx = (u - 1) * 100 + j\n            idy = (v - 1) * 100 + j + 1\n            for kk in range(1, 21):\n                cost_inc = c + (kk * kk - (kk - 1) * (kk - 1)) * d\n                add_edge(idx, idy, 1, cost_inc)\n            idx2 = (v - 1) * 100 + j\n            idy2 = (u - 1) * 100 + j + 1\n            for kk in range(1, 21):\n                cost_inc = c + (kk * kk - (kk - 1) * (kk - 1)) * d\n                add_edge(idx2, idy2, 1, cost_inc)\n\n    dist = [0] * nodeCount\n    pre = [0] * nodeCount\n    pre_edge = [0] * nodeCount\n    inq = [False] * nodeCount\n\n    def spfa():\n        for i in range(nodeCount):\n            dist[i] = INF\n            pre[i] = -1\n            inq[i] = False\n        q = deque()\n        dist[s] = 0\n        q.append(s)\n        inq[s] = True\n        while q:\n            u = q.popleft()\n            inq[u] = False\n            for i, e in enumerate(g[u]):\n                if e.cap > 0 and dist[e.to] > dist[u] + e.cost:\n                    dist[e.to] = dist[u] + e.cost\n                    pre[e.to] = u\n                    pre_edge[e.to] = i\n                    if not inq[e.to]:\n                        inq[e.to] = True\n                        q.append(e.to)\n        return dist[t] < INF\n\n    ans = 0\n    while spfa():\n        add = INF\n        v = t\n        while v != s:\n            u = pre[v]\n            i = pre_edge[v]\n            add = min(add, g[u][i].cap)\n            v = u\n        v = t\n        while v != s:\n            u = pre[v]\n            i = pre_edge[v]\n            e = g[u][i]\n            e.cap -= add\n            g[v][e.rev].cap += add\n            v = u\n        ans += dist[t] * add\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.00034278715611435473, 0.0, 0.0, -0.0004503904783632606, -0.004153435584157705, 0.0, -0.00016258825780823827, -9.727005090098828e-05, -5.960462772236497e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -0.0024927754420787096, -0.21637526154518127, 0.0, -3.576278118089249e-07, -9.536738616588991e-07, -0.00012683063687290996, 0.0, 0.0, -1.9073468138230965e-06, -5.483612312673358e-06, -0.0033893303479999304, -1.1920928244535389e-07, -0.00043072958942502737, 0.0, -3.099436753473128e-06, -1.1920928244535389e-07, 0.0, -2.50339189733495e-06, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -8.583032467868179e-06, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -2.3841855067985307e-07, -0.014179