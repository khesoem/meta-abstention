n        if (src == dst)\n            adj[src].back().rev++;\n        adj[dst].push_back({dst, src, adj[src].size() - 1, 0, 0, -cost});\n    }\n    vector<cost_type> potential;\n    inline cost_type rcost(const edge &e)\n    {\n        return e.cost + potential[e.src] - potential[e.dst];\n    }\n\n//    void bellman_ford(int source)\n//    {\n//        for (int k = 0; k < n; ++k)\n//            for (int u = 0; u < n; ++u)\n//                for (edge &e : adj[u])\n//                    if (e.cap > 0 && rcost(e) < 0)\n//                        potential[e.dst] += rcost(e);\n//    }\n    const cost_type oo = numeric_limits<cost_type>::max();\n    vector<cost_type> dist;\n    vector<edge * > back;\n    cost_type dijkstra(int source, int sink)\n    {\n        fill(dist.begin(), dist.end(), oo);\n        typedef pair<cost_type, int> node;\n        priority_queue<node, vector<node>, greater<node>> pq;\n        for (pq.push({dist[source] = 0, source}); !pq.empty();)\n        {\n            node p = pq.top();\n            pq.pop();\n            if (dist[p.second] < p.first)\n                continue;\n            if (p.second == sink)\n                break;\n            for (edge &e : adj[p.second])\n                if (e.flow < e.cap &&\n                        dist[e.dst] > dist[e.src] + rcost(e))\n                {\n                    back[e.dst] = &e;\n                    pq.push({\n                        dist[e.dst] = dist[e.src] + rcost(e),\n                        e.dst\n                    });\n                }\n        }\n        return dist[sink];\n    }\n    pair<flow_type, cost_type> max_flow(int source, int sink)\n    {\n        flow_type flow = 0;\n        cost_type cost = 0;\n        for (int u = 0; u < n; ++u)\n            for (edge &e : adj[u])\n                e.flow = 0;\n        potential.assign(n, 0);\n        dist.assign(n, 0);\n        back.assign(n, nullptr);\n//        bellman_ford(source); // remove negative costs\n        while (dijkstra(source, sink) < oo)\n        {\n            for (int u = 0; u < n; ++u)\n            if (dist[u] < dist[sink])\n                potential[u] += dist[u] - dist[sink];\n            flow_type f = numeric_limits<flow_type>::max();\n            for (edge * e = back[sink]; e; e = back[e->src])\n                f = min(f, e->cap - e->flow);\n            for (edge * e = back[sink]; e; e = back[e->src])\n                e->flow += f, adj[e->dst][e->rev].flow -= f;\n            flow += f;\n            cost += f * (potential[sink] - potential[source]);\n        }\n        return {flow, cost};\n    }\n};\n\nint main()\n{\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n\n    int n,m,k,c,d,u,v;\n    cin >> n >> m >> k >> c >> d;\n    min_cost_max_flow<int,int> g((n+2)*102);\n    for(int i=0;i<102;i++)\n        g.add_edge((i*(n+2))+1,i*(n+2),100,(i*c));\n    for(int i=0;i<101;i++)\n        for(int j=0;j<n+1;j++)\n            g.add_edge(j+(i*(n+2)),j+((i+1)*(n+2)),100,0);\n    for(int i=0;i<k;i++)\n    {\n        cin >> u;\n        g.add_edge(n+1,u,1,0);\n    }\n\n    for(int i=0;i<m;i++)\n    {\n        cin >> u >> v;\n        for(int j=0;j<101;j++)\n            for(int f=0;f<k;f++)\n            {\n                g.add_edge(u+(j*(n+2)),v+((j+1)*(n+2)),1,((2*f)+1)*d);\n                g.add_edge(v+(j*(n+2)),u+((j+1)*(n+2)),1,((2*f)+1)*d);\n            }\n    }\n\n    db(g.max_flow(n+1,(101*(n+2))).second)\n\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\nfrom collections import defaultdict\n\nclass MinCostMaxFlow:\n    class Edge:\n        def __init__(self, src, dst, rev, flow, cap, cost):\n            self.src = src\n            self.dst = dst\n            self.rev = rev\n            self.flow = flow\n            self.cap = cap\n            self.cost = cost\n\n    def __init__(self, n):\n        self.n = n\n        self.adj = [[] for _ in range(n)]\n        self.potential = [0] * n\n        self.dist = [float('inf')] * n\n        self.back = [None] * n\n\n    def add_edge(self, src, dst, cap, cost):\n        # Forward edge\n        forward_edge = self.Edge(src, dst, len(self.adj[dst]), 0, cap, cost)\n        self.adj[src].append(forward_edge)\n        \n        # Reverse edge\n        reverse_edge = self.Edge(dst, src, len(self.adj[src]) - 1, 0, 0, -cost)\n        self.adj[dst].append(reverse_edge)\n        \n        # Update reverse index for forward edge\n        forward_edge.rev = len(self.adj[dst]) - 1\n        \n        # If self-loop, adjust reverse index\n        if src == dst:\n            reverse_edge.rev += 1\n\n    def rcost(self, e):\n        return e.cost + self.potential[e.src] - self.potential[e.dst]\n\n    def dijkstra(self, source, sink):\n        self.dist = [float('inf')] * self.n\n        self.back = [None] * self.n\n        \n        pq = [(0, source)]\n        self.dist[source] = 0\n        \n        while pq:\n            d, u = heapq.heappop(pq)\n            if self.dist[u] < d:\n                continue\n            if u == sink:\n                break\n            for e in self.adj[u]:\n                if e.flow < e.cap and self.dist[e.dst] > self.dist[e.src] + self.rcost(e):\n                    self.back[e.dst] = e\n                    self.dist[e.dst] = self.dist[e.src] + self.rcost(e)\n                    heapq.heappush(pq, (self.dist[e.dst], e.dst))\n        \n        return self.dist[sink]\n\n    def max_flow(self, source, sink):\n        flow = 0\n        cost = 0\n        \n        # Reset flows\n        for u in range(self.n):\n            for e in self.adj[u]:\n                e.flow = 0\n        \n        self.potential = [0] * self.n\n        \n        while self.dijkstra(source, sink) < float('inf'):\n            # Update potentials\n            for u in range(self.n):\n                if self.dist[u] < self.dist[sink]:\n                    self.potential[u] += self.dist[u] - self.dist[sink]\n            \n            # Find minimum capacity along the path\n            f = float('inf')\n            e = self.back[sink]\n            while e is not None:\n                f = min(f, e.cap - e.flow)\n                e = self.back[e.src]\n            \n            # Update flows along the path\n            e = self.back[sink]\n            while e is not None:\n                e.flow += f\n                e.rev_edge.flow -= f\n                e = self.back[e.src]\n            \n            flow += f\n            cost += f * (self.potential[sink] - self.potential[source])\n        \n        return flow, cost\n\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    g = MinCostMaxFlow((n + 2) * 102)\n    \n    # Add edges for time layers\n    for i in range(102):\n        g.add_edge(i * (n + 2) + 1, i * (n + 2), 100, i * c)\n    \n    # Add edges between consecutive time layers\n    for i in range(101):\n        for j in range(n + 1):\n            g.add_edge(j + i * (n + 2), j + (i + 1) * (n + 2), 100, 0)\n    \n    # Add edges from source to nodes\n    for i in range(k):\n        u = int(data[idx]); idx += 1\n        g.add_edge(n + 1, u, 1, 0)\n    \n    # Add edges for m connections\n    for i in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        for j in range(101):\n            for f in range(k):\n                g.add_edge(u + j * (n + 2), v + (j + 1) * (n + 2), 1, (2 * f + 1) * d)\n                g.add_edge(v + j * (n + 2), u + (j + 1) * (n + 2), 1, (2 * f + 1) * d)\n    \n    # Find max flow and print cost\n    flow, total_cost = g.max_flow(n + 1, 101 * (n + 2))\n    print(total_cost)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n