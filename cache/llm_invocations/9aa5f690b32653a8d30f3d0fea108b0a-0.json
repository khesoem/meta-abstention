 i64 result = 1;\n    for (int i = 0; i < n; ++i) {\n        if (dsu.find(i) != i) continue;\n        i64 comp_size = dsu.r[i];\n        i64 val = power(k, comp_size, n);\n        if (val == 1) {\n            result = (result * n) % MOD;\n        }\n    }\n    \n    cout << result << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final long MOD = 1000000007;\n\n    static long power(long base, long exp, long mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    static class DSU {\n        int[] p;\n        int[] r;\n\n        DSU(int n) {\n            p = new int[n];\n            r = new int[n];\n            for (int i = 0; i < n; ++i) {\n                p[i] = i;\n                r[i] = 1;\n            }\n        }\n\n        int find(int x) {\n            if (p[x] == x) {\n                return x;\n            }\n            p[x] = find(p[x]);\n            return p[x];\n        }\n\n        void merge(int x, int y) {\n            x = find(x);\n            y = find(y);\n            if (x == y) return;\n            if (r[x] < r[y]) {\n                int temp = x;\n                x = y;\n                y = temp;\n            }\n            p[y] = x;\n            r[x] += r[y];\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int k = sc.nextInt();\n        \n        if (k == 0) {\n            System.out.println(power(n, n - 1, MOD));\n            return;\n        }\n        \n        DSU dsu = new DSU(n);\n        for (int i = 0; i < n; ++i) {\n            dsu.merge(i, (int)((1L * i * k) % n));\n        }\n        \n        long result = 1;\n        for (int i = 0; i < n; ++i) {\n            if (dsu.find(i) != i) continue;\n            int comp_size = dsu.r[i];\n            long val = power(k, comp_size, n);\n            if (val == 1) {\n                result = (result * n) % MOD;\n            }\n        }\n        \n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012766500003635883, -2.861018856492592e-06, -4.768370445162873e-07, -0.0004640932602342218, -1.7523612768854946e-05, -0.1270376592874527, -0.31651946902275085, -7.83174327807501e-05, -1.0728830375228426e-06, -3.814624506048858e-05, -0.0004889961564913392, -1.6689160474925302e-05, -0.040998637676239014, -0.00013839241000823677, -0.00016783259343355894, -3.814689989667386e-06, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, -3.123234637314454e-05, 0.0, -3.576278118089249e-07, -3.3378546504536644e-06, 0.0, 0.0, -5.960462772236497e-07, 0.0, -5.1616290875244886e-05, -0.15015050768852234, -1.1920928244535389e-07, -0.0011723319767042994, -3.421248038648628e-05, -9.65590606938349e-06, -7.390948667307384e-06, -1.4305104514278355e-06, 0.0, -1.0728830375228426e-06, -2.50339189733495e-06, 0.0, -9.536738616588991e-07, -1.4305104514278355e-06, -2.622600959512056e-06, 0.0, -6.0794889577664435e-05, -2.7418097943154862e-06, -9.536738616588991e-07, 0.0, 0.0, 0.0, -2.7418097943154862e-06, -1.1920928244535389e-07, -7.152555099310121e-07, -1.0728830375228426e-06, -2.3841855067985307e-07, -2.145764938177308e-06, -3.099436753473128e-06, -2.0265558760002023e-06, -1.1920928244535389e-07, -9.536738616588991e-07, -0.009756263345479965, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -2.264974000354414e-06, -1.4305104514278355e-06, -7.152531907195225e-06, -1.4305104514278355e-06, -1.1920928244535389e-07, 0.0, 0.0, -2.145764938177308e-06, -0.0004409771354403347, 0.0, 0.0, -8.535