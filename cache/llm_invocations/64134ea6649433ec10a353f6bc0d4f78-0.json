le.intersects2(circles[1], circles[2])) {\n                count++;\n            }\n            System.out.println(count);\n            return;\n        }\n\n        int total = 1;\n        TreeSet<Point> points = new TreeSet<>();\n        for (int i = 0; i < n; i++) {\n            points.clear();\n            total++;\n            for (int j = 0; j < i; j++) {\n                Circle.intersectionPoints(circles[i], circles[j], points);\n            }\n            if (points.size() >= 2) {\n                total += points.size() - 1;\n            }\n        }\n\n        System.out.println(total);\n    }\n\n    public static double euclidean(Point a, Point b) {\n        return Math.sqrt(euclideanSq(a, b));\n    }\n\n    public static double euclideanSq(Point a, Point b) {\n        double dx = a.x - b.x;\n        double dy = a.y - b.y;\n        return dx * dx + dy * dy;\n    }\n\n    public static class Circle {\n        Point center;\n        int radius;\n\n        public Circle(int x, int y, int r) {\n            this.center = new Point(x, y);\n            this.radius = r;\n        }\n\n        public static boolean intersects(Circle a, Circle b) {\n            double d = euclidean(a.center, b.center);\n            return d <= a.radius + b.radius + DELTA && d + DELTA >= Math.abs(a.radius - b.radius);\n        }\n\n        public static boolean intersects2(Circle a, Circle b) {\n            double d = euclidean(a.center, b.center);\n            return d < a.radius + b.radius && d > Math.abs(a.radius - b.radius);\n        }\n\n        public static void intersectionPoints(Circle a, Circle b, Set<Point> set) {\n            if (!intersects(a, b)) {\n                return;\n            }\n\n            Line segment = new Line(a.center, b.center);\n            double d = euclidean(a.center, b.center);\n            double distToMid = (d * d - b.radius * b.radius + a.radius * a.radius) / (2 * d);\n            Point mid = a.center.move(segment, distToMid);\n            Point dir = segment.direction().perp();\n            double h = Math.sqrt(a.radius * a.radius - distToMid * distToMid);\n            Point p1 = mid.move(dir, h);\n            Point p2 = mid.move(dir, -h);\n\n            set.add(p1);\n            if (!p2.equals(p1)) {\n                set.add(p2);\n            }\n        }\n    }\n\n    public static class Point implements Comparable<Point> {\n        double x, y;\n\n        public Point(double x, double y) {\n            this.x = x;\n            this.y = y;\n        }\n\n        @Override\n        public String toString() {\n            return \"(\" + x + \",\" + y + \")\";\n        }\n\n        public Point minus(Point other) {\n            return new Point(x - other.x, y - other.y);\n        }\n\n        public Point move(Line line, double dist) {\n            return move(line.direction(), dist);\n        }\n\n        public Point move(Point vec, double dist) {\n            Point unit = vec.normalize();\n            return plus(unit.scale(dist));\n        }\n\n        public Point plus(Point other) {\n            return new Point(x + other.x, y + other.y);\n        }\n\n        public Point scale(double factor) {\n            return new Point(x * factor, y * factor);\n        }\n\n        public Point normalize() {\n            double mag = Math.sqrt(x * x + y * y);\n            return divide(mag);\n        }\n\n        public Point divide(double divisor) {\n            return new Point(x / divisor, y / divisor);\n        }\n\n        public Point perp() {\n            return new Point(-y, x);\n        }\n\n        @Override\n        public boolean equals(Object obj) {\n            Point other = (Point) obj;\n            return Math.abs(x - other.x) < DELTA && Math.abs(y - other.y) < DELTA;\n        }\n\n        @Override\n        public int compareTo(Point o) {\n            if (equals(o)) {\n                return 0;\n            }\n            if (Math.abs(x - o.x) < DELTA) {\n                return Double.compare(y,