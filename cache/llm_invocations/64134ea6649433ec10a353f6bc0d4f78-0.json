     self.y = y\n    \n    def __str__(self):\n        return f\"({self.x},{self.y})\"\n    \n    def minus(self, other):\n        return Point(self.x - other.x, self.y - other.y)\n    \n    def move_line(self, line, dist):\n        return self.move_vec(line.direction(), dist)\n    \n    def move_vec(self, vec, dist):\n        unit = vec.normalize()\n        return self.plus(unit.scale(dist))\n    \n    def plus(self, other):\n        return Point(self.x + other.x, self.y + other.y)\n    \n    def scale(self, factor):\n        return Point(self.x * factor, self.y * factor)\n    \n    def normalize(self):\n        mag = math.sqrt(self.x * self.x + self.y * self.y)\n        return self.divide(mag)\n    \n    def divide(self, divisor):\n        return Point(self.x / divisor, self.y / divisor)\n    \n    def perp(self):\n        return Point(-self.y, self.x)\n    \n    def __eq__(self, other):\n        return abs(self.x - other.x) < DELTA and abs(self.y - other.y) < DELTA\n    \n    def __lt__(self, other):\n        if self == other:\n            return False\n        if abs(self.x - other.x) < DELTA:\n            return self.y < other.y\n        return self.x < other.x\n    \n    def __hash__(self):\n        return hash((round(self.x / DELTA), round(self.y / DELTA)))\n\nclass Line:\n    def __init__(self, from_point, to_point):\n        self.from_point = from_point\n        self.to_point = to_point\n    \n    def direction(self):\n        return self.to_point.minus(self.from_point)\n    \n    def length(self):\n        return euclidean(self.from_point, self.to_point)\n\nclass Circle:\n    def __init__(self, x, y, r):\n        self.center = Point(x, y)\n        self.radius = r\n    \n    @staticmethod\n    def intersects(a, b):\n        d = euclidean(a.center, b.center)\n        return d <= a.radius + b.radius + DELTA and d + DELTA >= abs(a.radius - b.radius)\n    \n    @staticmethod\n    def intersects2(a, b):\n        d = euclidean(a.center, b.center)\n        return d < a.radius + b.radius and d > abs(a.radius - b.radius)\n    \n    @staticmethod\n    def intersection_points(a, b, point_set):\n        if not Circle.intersects(a, b):\n            return\n        \n        segment = Line(a.center, b.center)\n        d = euclidean(a.center, b.center)\n        dist_to_mid = (d * d - b.radius * b.radius + a.radius * a.radius) / (2 * d)\n        mid = a.center.move_line(segment, dist_to_mid)\n        dir_vec = segment.direction().perp()\n        h = math.sqrt(a.radius * a.radius - dist_to_mid * dist_to_mid)\n        p1 = mid.move_vec(dir_vec, h)\n        p2 = mid.move_vec(dir_vec, -h)\n        \n        point_set.add(p1)\n        if not p2 == p1:\n            point_set.add(p2)\n\ndef euclidean(a, b):\n    return math.sqrt(euclidean_sq(a, b))\n\ndef euclidean_sq(a, b):\n    dx = a.x - b.x\n    dy = a.y - b.y\n    return dx * dx + dy * dy\n\ndef main():\n    global IS_CODEFORCES\n    \n    # Check if running on Codeforces\n    IS_CODEFORCES = \"ONLINE_JUDGE\" in str(sys.argv)\n    \n    if not IS_CODEFORCES:\n        try:\n            sys.stdin = open(\"D:\\\\DataBase\\\\TESTCASE\\\\codeforces\\\\CF933C.in\", \"r\")\n        except:\n            pass\n    \n    input_lines = []\n    try:\n        for line in sys.stdin:\n            input_lines.append(line.strip())\n    except:\n        pass\n    \n    idx = 0\n    n = int(input_lines[idx])\n    idx += 1\n    \n    circles = []\n    for i in range(n):\n        parts = input_lines[idx].split()\n        x, y, r = int(parts[0]), int(parts[1]), int(parts[2])\n        circles.append(Circle(x, y, r))\n        idx += 1\n    \n    if n == 3 and not Circle.intersects(circles[0], circles[1]):\n        count = 4\n        if Circle.intersects2(circles[0], circles[2]):\n            count += 1\n        if Circle.intersects2(circles[1], circles[2]):\n            count += 1\n        print(count)\n        return\n    \n    total = 1\n    for i in range(n):\n        points = set()\n        total += 1\n  