ss J:\n    def __init__(self):\n        self.ONLINE_JUDGE = 'ONLINE_JUDGE' in sys.argv\n        self.inp = sys.stdin\n        self.out = sys.stdout\n        self.tok = ''\n\n    def init(self):\n        self.inp = io.TextIOWrapper(sys.stdin.buffer, encoding='utf-8')\n        self.out = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')\n\n    def read_string(self):\n        while not self.tok:\n            self.tok = self.inp.readline().split()\n        return self.tok.pop(0)\n\n    def read_int(self):\n        return int(self.read_string())\n\n    def read_long(self):\n        return int(self.read_string())\n\n    def read_double(self):\n        return float(self.read_string())\n\n    def read_array_int(self, size):\n        return [int(self.read_string()) for _ in range(size)]\n\n    def time(self):\n        self.time_end = time.time()\n        print(\"Time = \" + str(self.time_end - self.time_begin), file=sys.stderr)\n\n    def solve(self):\n        n = self.read_int()\n        s = list(self.read_string())\n        vcnt = 0\n        kcnt = 0\n        xcnt = 0\n        for i in range(n):\n            if s[i] == 'V':\n                vcnt += 1\n                continue\n            if s[i] == 'K':\n                kcnt += 1\n                continue\n            xcnt += 1\n            s[i] = 'X'\n        self.dp = [[[[-1 for _ in range(3)] for _ in range(xcnt + 1)] for _ in range(kcnt + 1)] for _ in range(vcnt + 1)]\n        for v in range(vcnt + 1):\n            for k in range(kcnt + 1):\n                for x in range(xcnt + 1):\n                    self.dp[v][k][x] = [-1 for _ in range(3)]\n        self.dp[0][0][0][0] = self.dp[0][0][0][1] = self.dp[0][0][0][2] = 0\n        for v in range(vcnt + 1):\n            for k in range(kcnt + 1):\n                for x in range(xcnt + 1):\n                    rv = v + 1 <= vcnt and self.count(s, 'V', v + 1, k, x) or 0\n                    rk = k + 1 <= kcnt and self.count(s, 'K', v, k + 1, x) or 0\n                   