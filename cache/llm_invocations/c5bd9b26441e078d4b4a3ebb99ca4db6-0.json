\n    }\n\n    static void add(int u, int v, int val, int w) {\n        add_edge(u, v, val, w);\n        add_edge(v, u, 0, -w);\n    }\n\n    static boolean SPFA() {\n        Arrays.fill(dis, 1, tot + 1, INF);\n        ArrayDeque<Integer> q = new ArrayDeque<>();\n        q.add(s);\n        dis[s] = 0;\n        vis[s] = true;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != -1; i = edges.get(i).next) {\n                Edge e = edges.get(i);\n                int v = e.to;\n                if (e.val > 0 && dis[v] > dis[u] + e.w) {\n                    dis[v] = dis[u] + e.w;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return dis[t] < INF;\n    }\n\n    static int[] mcmf() {\n        int flow = 0, cost = 0;\n        while (SPFA()) {\n            int f = INF;\n            for (int x = t; x != s; x = edges.get(pre[x] ^ 1).to) {\n                f = Math.min(f, edges.get(pre[x]).val);\n            }\n            for (int x = t; x != s; x = edges.get(pre[x] ^ 1).to) {\n                edges.get(pre[x]).val -= f;\n                edges.get(pre[x] ^ 1).val += f;\n            }\n            flow += f;\n            cost += dis[t] * f;\n        }\n        return new int[]{cost, flow};\n    }\n\n    static int P(int i, int j) {\n        return i * n + j;\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n\n        int cs = 2 * k;\n        tot = cs * n;\n        s = ++tot;\n        t = ++tot;\n\n        head = new int[tot + 5];\n        Arrays.fill(head, -1);\n        edges = new ArrayList<>();\n        dis = new int[tot + 5];\n        pre = new int[tot + 5];\n        vis = new boolean[tot + 5];\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 1; i <= k; i++) {\n            int tp = Integer.parseInt(st.nextToken());\n            add(s, P(0, tp), 1, 0);\n        }\n\n        int[][] E = new int[m + 1][2];\n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            E[i][0] = Integer.parseInt(st.nextToken());\n            E[i][1] = Integer.parseInt(st.nextToken());\n        }\n\n        for (int i = 1; i <= cs - 1; i++) {\n            add(P(i, 1), t, k, c * i);\n            for (int j = 1; j <= n; j++) {\n                add(P(i - 1, j), P(i, j), k, 0);\n            }\n            for (int j = 1; j <= m; j++) {\n                for (int tt = 1; tt <= k; tt++) {\n                    add(P(i - 1, E[j][0]), P(i, E[j][1]), 1, (2 * tt - 1) * d);\n                    add(P(i - 1, E[j][1]), P(i, E[j][0]), 1, (2 * tt - 1) * d);\n                }\n            }\n        }\n\n        int[] result = mcmf();\n        System.out.println(result[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -4.768370445162873e-07, -8.439661905867979e-05, -0.000977038755081594, 0.0, -0.10020658373832703, -0.06198778375983238, 0.0, 0.0, -2.3841855067985307e-07, -6.961580220377073e-05, -0.00034421717282384634, 0.0, -0.0018565100617706776, -0.005275614093989134, -7.366862701019272e-05, -0.0007740838918834925, -0.06498852372169495, -1.7881377516459906e-06, -0.0003399271226953715, 0.0, -0.048614807426929474, -0.02976430207490921, -1.7881377516459906e-06, -7.152555099310121e-07, -6.83045873302035e-05, -0.0837567076086998, -0.029750879853963852, -2.3841830625315197e-06, -0.000258054817095