\n\n    # First half\n    totalEdges1 = n * h\n    for state in range(1 << totalEdges1):\n        p = 1\n        for e in range(totalEdges1):\n            x = e // n\n            y = e % n\n            if state & (1 << e):\n                p = p * P[x][y] % MOD * inv100 % MOD\n            else:\n                p = p * (100 - P[x][y]) % MOD * inv100 % MOD\n        poss = 0\n        for idx, pm_list in enumerate(permMasks1):\n            for pm in pm_list:\n                if (state & pm) == pm:\n                    poss |= (1 << idx)\n                    break\n        prob[poss] = (prob[poss] + p) % MOD\n\n    # Second half\n    totalEdges2 = n * h2\n    for state in range(1 << totalEdges2):\n        p = 1\n        for e in range(totalEdges2):\n            x = e // n + h\n            y = e % n\n            if state & (1 << e):\n                p = p * P[x][y] % MOD * inv100 % MOD\n            else:\n                p = p * (100 - P[x][y]) % MOD * inv100 % MOD\n        poss = 0\n        for idx, pm_list in enumerate(permMasks2):\n            for pm in pm_list:\n                if (state & pm) == pm:\n                    poss |= (1 << idx)\n                    break\n        prob2[poss] = (prob2[poss] + p) % MOD\n\n    # SOS DP on prob2 (subset sum)\n    for i in range(M):\n        for j in range(1 << M):\n            if j & (1 << i):\n                prob2[j] = (prob2[j] + prob2[j ^ (1 << i)]) % MOD\n\n    ans = 0\n    fullMask = (1 << M) - 1\n    for i in range(1 << M):\n        ans = (ans + prob[i] * prob2[fullMask ^ i]) % MOD\n\n    print((MOD + 1 - ans) % MOD)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.8371408916427754e-05, 0.0, -1.1920928244535389e-07, -0.0005059154354967177, -0.000976919662207365, -1.0728830375228426e-06, -0.00016246906307060272, -0.014165329746901989, -1.0251946150674485e-05, -0.0005721600609831512, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -2.02655587