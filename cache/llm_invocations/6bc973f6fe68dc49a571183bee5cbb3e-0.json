[i-1]*i%P;\n\tifac[n]=fpow(fac[n],P-2);\n\tfor(int i=n-1;i>=0;--i)ifac[i]=ifac[i+1]*(i+1ll)%P;\n\tinv[1]=1;\n\tfor(int i=2;i<=n;++i)inv[i]=1ll*(P-P/i)*inv[P%i]%P;\n}\ninline void add(int &x,int y){x+=y;if(x>=P)x-=P;}\ninline void sub(int &x,int y){x-=y;x-=(x>>31)*P;}\ninline void FMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(RG int j=0;j<l;++j)\n\t\t\t\tadd(f[i+j+l],f[i+j]);\n}\ninline void IFMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(RG int j=0;j<l;++j)\n\t\t\t\tsub(f[i+j+l],f[i+j]);\n}\nint n,k;\n#define pop(x) __builtin_popcount(x)\nint lp[N];\ninline void ln(int *f,int *g,int n){\n\tg[0]=0;\n\tfor(int i=1;i<n;++i)\n\t{\n\t\tg[i]=0;\n\t\tfor(int j=1;j<i;++j)g[i]=(g[i]+1ll*f[i-j]*g[j]%P*j)%P;\n\t\tg[i]=(f[i]+1ll*g[i]*(P-inv[i]))%P;\n\t}\n}\ninline void exp(int *f,int *g,int n){\n\tg[0]=1;\n\tfor(int i=1;i<n;++i){\n\t\tg[i]=0;\n\t\tfor(int j=1;j<=i;++j)g[i]=(g[i]+1ll*g[i-j]*f[j]%P*j)%P;\n\t\tg[i]=(1ll*g[i]*inv[i])%P;\n\t}\n}\nint main(void)\n{\n\t#ifndef ONLINE_JUDGE\n// \tFile(\"onmyodo\");\n\t#endif\n\tn=gi,k=gi,P=gi;\n\tint ans=fpow(k,n);\n\tif((n&1)==0){\n\t\tint m=(int)log2(n)+1;\n\t\tinit(1<<m);\n\t\tfor(int i=0;i<(1<<m);++i)f[pop(i)][i]=ifac[i];\n\t\tfor(int i=0;i<=m;++i)FMT(f[i],1<<m);\n\t\tstatic int F[20],G[20];\n\t\tfor(int i=0;i<(1<<m);++i){\n\t\t\tfor(int j=0;j<=m;++j)F[j]=f[j][i];\n\t\t\tln(F,G,m+1);\n\t\t\tfor(int j=0;j<=m;++j)G[j]=1ll*G[j]*k%P;\n\t\t\texp(G,F,m+1);\n\t\t\tfor(int j=0;j<=m;++j)f[j][i]=F[j];\n\t\t}\n\t\tIFMT(f[pop(n)],1<<m);\n\t\tans=(P+ans-1ll*f[pop(n)][n]*fac[n]%P)%P;\n\t}\n\tpi(ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef input():\n    return sys.stdin.readline().rstrip()\n\ndef geti():\n    xi = 0\n    ch = sys.stdin.read(1)\n    f = False\n    while ch and not ch.isdigit():\n        if ch == '-':\n            f = True\n        ch = sys.stdin.read(1)\n    while ch and ch.isdigit():\n        xi = xi * 10 + ord(ch) - 48\n        ch = sys.stdin.read(1)\n    return -xi if f else xi\n\ndef pi(k, ch=0):\n    if k < 0:\n        k = -k\n        sys.stdout.write('-')\n    if k >= 10:\n        pi(k // 10)\n    sys.stdout.write(chr(k % 10 + 48))\n    if ch:\n        sys.stdout.write(chr(ch))\n\ndef fpow(a, b, c=1):\n    P = globals()['P']\n    while b:\n        if b & 1:\n            c = c * a % P\n        a = a * a % P\n        b >>= 1\n    return c\n\ndef init(n):\n    fac = globals()['fac']\n    ifac = globals()['ifac']\n    inv = globals()['inv']\n    P = globals()['P']\n    \n    fac[0] = 1\n    for i in range(1, n + 1):\n        fac[i] = fac[i - 1] * i % P\n    \n    ifac[n] = fpow(fac[n], P - 2)\n    for i in range(n - 1, -1, -1):\n        ifac[i] = ifac[i + 1] * (i + 1) % P\n    \n    inv[1] = 1\n    for i in range(2, n + 1):\n        inv[i] = (P - P // i) * inv[P % i] % P\n\ndef add(x, y):\n    x[0] = (x[0] + y)\n    if x[0] >= globals()['P']:\n        x[0] -= globals()['P']\n\ndef sub(x, y):\n    x[0] = (x[0] - y)\n    P = globals()['P']\n    x[0] -= (x[0] >> 31) * P\n\ndef FMT(f, n):\n    P = globals()['P']\n    for l in range(1, n):\n        if l >= n:\n            break\n        for i in range(0, n, l << 1):\n            for j in range(l):\n                add(f[i + j + l], f[i + j])\n\ndef IFMT(f, n):\n    P = globals()['P']\n    for l in range(1, n):\n        if l >= n:\n            break\n        for i in range(0, n, l << 1):\n            for j in range(l):\n                sub(f[i + j + l], f[i + j])\n\ndef ln(f, g, n):\n    P = globals()['P']\n    inv = globals()['inv']\n    g[0] = 0\n    for i in range(1, n):\n        g[i] = 0\n        for j in range(1, i):\n            g[i] = (g[i] + f[i - j] * g[j] % P * j) % P\n        g[i] = (f[i] + g[i] * (P - inv[i])) % P\n\ndef exp(f, g, n):\n    P = globals()['P']\n    inv = globals()['inv']\n    g[0] = 1\n    for i in range(1, n):\n        g[i] = 0\n        for j in range(1, i + 1):\n            g[i] = (g[i] + g[i - j] * f[j] % P * j) % P\n        g[i] = g[i] * inv[i] % P\n\ndef main():\n    global P, fac, ifac, inv\n    \n    n = geti()\n    k = geti()\n    P = geti()\n    \n    ans = fpow(k, n)\n    \n    if n & 1 == 0:\n        m = int(math.log2(n)) + 1\n        size = 1 << m\n        \n        # Initialize arrays\n        fac = [0] * (size + 1)\n        ifac = [0] * (size + 1)\n        inv = [0] * (size + 1)\n        init(size)\n        \n        # Initialize f array\n        f = [[0] * size for _ in range(19)]\n        for i in range(size):\n            bits = bin(i).count('1')\n            f[bits][i] = ifac[i]\n        \n        # Apply FMT to each row\n        for i in range(19):\n            FMT(f[i], size)\n        \n        # Process each position\n        F = [0] * 20\n        G = [0] * 20\n        \n        for i in range(size):\n            for j in range(19):\n                F[j] = f[j][i]\n            \n            ln(F, G, m + 1)\n            \n            for j in range(m + 1):\n                G[j] = G[j] * k % P\n            \n            exp(G, F, m + 1)\n            \n            for j in range(m + 1):\n                f[j][i] = F[j]\n        \n        # Apply IFMT\n        IFMT(f[bin(n).count('1')], size)\n        \n        ans = (P + ans - f[bin(n).count('1')][n] * fac[n] % P) % P\n    \n    pi(ans)\n    sys.stdout.write('\\n')\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00015639036428183317, -1.6689286894688848e-06, -8.344646857949556e-07, -0.006226900964975357, -0.026407383382320404, -0.10021671652793884, -0.06504862010478973, -0.00030357998912222683, -0.006728610955178738, -0.004010254982858896, -0.18695968389511108, -0.00025948495022021234, -2.264974000354414e-06, -4.0531076592742465e-06, -1.8954096958623268e-05, -4.172316494077677e-06, -0.0077402