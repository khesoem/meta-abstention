f next(self):\n        while not self.st:\n            line = self.br.readline()\n            if not line:\n                return None\n            self.st = line.strip().split()\n        return self.st.pop(0)\n    \n    def nextInt(self):\n        return int(self.next())\n    \n    def nextLong(self):\n        return int(self.next())\n    \n    def nextDouble(self):\n        return float(self.next())\n\ndef go(n, m):\n    INF = int(1e9)\n    MOD = 1000000007\n    \n    if n > m:\n        n, m = m, n\n    \n    product = n * m\n    \n    if n <= 3 and m <= 3:\n        if n == 1 or m == 1:\n            return 0\n        if n == 2 and m == 2:\n            return 0\n        if n == 2 and m == 3:\n            return 4\n        if n == 3 and m == 2:\n            return 4\n        if n == 3 and m == 3:\n            return 8\n        return 0\n    \n    if n == 1:\n        m = m % 6\n        if m == 4:\n            m = 2\n        elif m == 5:\n            m = 1\n        return product - m\n    elif n == 2:\n        m = 2 if (m == 3 or m == 7) else 0\n        return product - m\n    \n    return product - (product & 1)\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    idx = 0\n    t = 1\n    results = []\n    \n    while idx < len(data) and t > 0:\n        n = int(data[idx])\n        m = int(data[idx + 1])\n        idx += 2\n        ans = go(n, m)\n        results.append(str(ans))\n        t -= 1\n    \n    print(\"\\n\".join(results))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.010543388081715e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.06294664740562439, -0.08905200660228729, -0.00861712172627449, -0.07894240319728851, -0.6787489652633667, -0.06993689388036728, -0.2533584237098694, -0.4354710578918457, -2.264974000354414e-06, -3.933898824470816e-06, -1.9073468138230965e-06, -2.145764938177308e-06, -8.702239938429557e-06, -2.62260095