 = dist[u] + a.weight;\n            if (nd < dist[v]) {\n                dist[v] = nd;\n                prevV[v] = u;\n                prevE[v] = i;\n                if (!inq[v]) {\n                    inq[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    \n    if (dist[t] == INF) return false;\n    \n    int cur = t;\n    while (cur != s) {\n        arcs[prevE[cur]].flow++;\n        arcs[prevE[cur] ^ 1].flow--;\n        cur = prevV[cur];\n    }\n    \n    return true;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    const int src = 9998, dst = 9999;\n    \n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        link(src, x, 1, 0);\n    }\n    \n    for (int i = 1; i <= 101; ++i) {\n        link((i - 1) * n, dst, k, (i - 1) * c);\n    }\n    \n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n        for (int layer = 1; layer <= 100; ++layer) {\n            for (int j = 1; j <= k; ++j) {\n                int cost = d * ((j - 1) * 2 + 1);\n                link(x + (layer - 1) * n, y + (layer - 1) * n + n, 1, cost);\n                link(y + (layer - 1) * n, x + (layer - 1) * n + n, 1, cost);\n            }\n        }\n    }\n    \n    for (int node = 0; node < n; ++node) {\n        for (int layer = 1; layer <= 100; ++layer) {\n            link(node + (layer - 1) * n, node + (layer - 1) * n + n, k, 0);\n        }\n    }\n    \n    long long total = 0;\n    for (int i = 0; i < k; ++i) {\n        if (spfa(src, dst)) {\n            total += dist[dst];\n        }\n    }\n    \n    cout << total << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Arc:\n   