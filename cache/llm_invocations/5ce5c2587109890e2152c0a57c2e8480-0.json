ev].f -= df\n            return df\n        ptr[u] += 1\n    return 0\n\ndef mf():\n    res = 0\n    while bfs():\n        ptr = [0] * MAXN\n        df = dfs(src, INF)\n        while df:\n            res += df\n            df = dfs(src, INF)\n    return res\n\ndx = [-1, 0, 0, 1]\ndy = [0, -1, 1, 0]\n\nn = 0\nm = 0\nobs = []\ntim = []\ndii = []\n\ndef gbfs(r, c, dis_grid, chk=False):\n    for i in range(n):\n        for j in range(n):\n            dis_grid[i][j] = -1\n    dis_grid[r][c] = 0\n    q = deque()\n    q.append((r, c))\n    while q:\n        p = q.popleft()\n        if chk and dis_grid[p[0]][p[1]] == tim[p[0]][p[1]]:\n            continue\n        for i in range(4):\n            nr = p[0] + dx[i]\n            nc = p[1] + dy[i]\n            if nr < 0 or nr >= n or nc < 0 or nc >= n or dis_grid[nr][nc] != -1 or obs[nr][nc]:\n                continue\n            if chk and tim[nr][nc] > -1 and dis_grid[p[0]][p[1]] + 1 > tim[nr][nc]:\n                continue\n            dis_grid[nr][nc] = dis_grid[p[0]][p[1]] + 1\n            q.append((nr, nc))\n\nlab = []\nrea = []\n\ndef main():\n    global n, m, obs, tim, dii, src, dst, adj\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    lab = []\n    rea = []\n    for i in range(n):\n        lab.append(data[idx]); idx += 1\n    for i in range(n):\n        rea.append(data[idx]); idx += 1\n    \n    obs = [[0]*n for _ in range(n)]\n    tim = [[0]*n for _ in range(n)]\n    dii = [[0]*n for _ in range(n)]\n    \n    for i in range(n):\n        for j in range(n):\n            obs[i][j] = 1 if lab[i][j] == 'Y' else 0\n    \n    for i in range(n):\n        for j in range(n):\n            if lab[i][j] == 'Z':\n                gbfs(i, j, tim)\n    \n    src = 2 * n * n + 5\n    dst = src + 1\n    \n    # Reset adjacency list\n    adj = [[] for _ in range(MAXN)]\n    \n    for x in range(n):\n        for y in range(n):\n            if lab[x][y] == 'Z' or lab[x][y] == 'Y':\n                continue\n            add_edge(src, n * x + y, int(lab[x][y]))\n            add_edge(n * n + n * x + y, dst, int(rea[x][y]))\n            gbfs(x, y, dii, True)\n            for xp in range(n):\n                for yp in range(n):\n                    if dii[xp][yp] != -1 and dii[xp][yp] <= m:\n                        add_edge(n * x + y, n * n + n * xp + yp, INF)\n    \n    print(mf())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014077626110520214, -1.4305104514278355e-06, -2.3841855067985307e-07, -0.31906259059906006, -0.005449321586638689, -3.576278118089249e-07, -5.2689116273541003e-05, -0.0001486429391661659, -1.4305104514278355e-06, -3.516612196108326e-05, -0.00048137042904272676, -0.5276176929473877, -7.152555099310121e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.2159273865108844e-05, -6.913899414939806e-05, -8.546940807718784e-05, -9.536738616588991e-07, -0.05499503016471863, -3.576278118089249e-07, -2.0503786799963564e-05, -0.00019405389321036637, -2.5152843591058627e-05, -1.6331539882230572e-05, -0.04734334722161293, -0.0001072826053132303, -2.622600959512056e-06, -3.576278118089249e-07, -0.38687190413475037, -5.018585216021165e-05, -7.033323527139146e-06, -1.9550132492440753e-05, -0.0067187827080488205, 0.0, -1.311301275563892e-06, 0.0, -1.0728830375228426e-06, -2.7418097943154862e-06, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.4305104514278355e-06, -0.00010287232726113871, -1.2993727978027891e-05, -1.1920928244535389e-07, -5.960462772236497e-07, -1.0728830375228426e-06, -2.3841855067985307e-07, -3.3378546504536644e-06, 0.0, -1.1920922133867862e-06, -0.00015293381875380874, -3.93382906622719e-05, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.0265558760002023e-06, -9.536738616588991e-07, -2.4318398573086597e-05, -2.3841855067985307e-07, -1.19209282445353