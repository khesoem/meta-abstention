is[u] + 1)\n            continue;\n        if (int df = dfs(v, min(f, e.cap - e.f))) {\n            e.f += df;\n            adj[v][e.rev].f -= df;\n            return df;\n        }\n    }\n    return 0;\n}\n\nint mf() {\n    int res = 0;\n    while (bfs()) {\n        memset(ptr, 0, sizeof ptr);\n        int df;\n        while ((df = dfs(src, INF)))\n            res += df;\n    }\n    return res;\n}\n\nint dx[] = {-1, 0, 0, 1};\nint dy[] = {0, -1, 1, 0};\n\nint n, m;\nusing grid = vector<vector<int>>;\nusing pa = array<int, 2>;\ngrid obs, tim, dii;\n\nvoid gbfs(int r, int c, grid& dis, bool chk = false) {\n    for (int i = 0; i < n; ++i)\n        fill(dis[i].begin(), dis[i].end(), -1);\n    dis[r][c] = 0;\n    queue<pa> q;\n    q.push({r, c});\n    while (!q.empty()) {\n        auto p = q.front(); q.pop();\n        if (chk && dis[p[0]][p[1]] == tim[p[0]][p[1]])\n            continue;\n        for (int i = 0; i < 4; ++i) {\n            pa r = {p[0] + dx[i], p[1] + dy[i]};\n            if (r[0] < 0 || r[0] >= n || r[1] < 0 || r[1] >= n || dis[r[0]][r[1]] != -1 || obs[r[0]][r[1]])\n                continue;\n            if (chk && tim[r[0]][r[1]] > -1 && dis[p[0]][p[1]] + 1 > tim[r[0]][r[1]])\n                continue;\n            dis[r[0]][r[1]] = dis[p[0]][p[1]] + 1;\n            q.push(r);\n        }\n    }\n}\n\nvector<string> lab, rea;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> m;\n    lab.resize(n);\n    rea.resize(n);\n    for (auto& x : lab)\n        cin >> x;\n    for (auto& x : rea)\n        cin >> x;\n    obs.assign(n, vector<int>(n));\n    tim.assign(n, vector<int>(n));\n    dii.assign(n, vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            obs[i][j] = (lab[i][j] == 'Y');\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (lab[i][j] == 'Z')\n                gbfs(i, j, tim);\n    src = 2 * n * n + 5;\n    dst = src + 1;\n    for (