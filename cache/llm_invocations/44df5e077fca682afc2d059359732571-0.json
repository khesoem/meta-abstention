bidirectional between layers)\n        for j in range(1, m + 1):\n            u1 = x_vals[j] + 1 + i * n\n            v1 = y_vals[j] + 1 + (i + 1) * n\n            u2 = y_vals[j] + 1 + i * n\n            v2 = x_vals[j] + 1 + (i + 1) * n\n            for l in range(k, -1, -1):\n                cost = (l * 2 + 1) * d + c\n                add_edge(u1, v1, 1, cost)\n                add_edge(u2, v2, 1, cost)\n\n        # staying edges\n        for p in range(1, n + 1):\n            u = p + 1 + i * n\n            v = p + 1 + (i + 1) * n\n            add_edge(u, v, k, c)\n\n    # min-cost flow\n    INF = 10 ** 18\n    dist = [0] * total_nodes\n    in_queue = [False] * total_nodes\n    visited = [False] * total_nodes\n    cur = [0] * total_nodes\n\n    from collections import deque\n    Q = deque()\n\n    def spfa():\n        for i in range(total_nodes):\n            dist[i] = INF\n        dist[S] = 0\n        Q.append(S)\n        in_queue[S] = True\n        while Q:\n            u = Q.popleft()\n            in_queue[u] = False\n            for edge in adj[u]:\n                v, cap, cost, rev = edge\n                if cap and dist[v] > dist[u] + cost:\n                    dist[v] = dist[u] + cost\n                    if not in_queue[v]:\n                        in_queue[v] = True\n                        Q.append(v)\n        return dist[T] < INF\n\n    def dfs(u, f):\n        if u == T:\n            return f\n        visited[u] = True\n        total = 0\n        while cur[u] < len(adj[u]):\n            edge = adj[u][cur[u]]\n            v, cap, cost, rev = edge\n            if not visited[v] and cap and dist[v] == dist[u] + cost:\n                d = dfs(v, min(f, cap))\n                if d:\n                    edge[1] -= d\n                    adj[v][rev][1] += d\n                    total += d\n                    f -= d\n                    if f == 0:\n                        break\n            cur[u] += 1\n        visited[u] = False\n        return total\n\n    def min_cost_flow():\n        ans = 0\n        while spfa():\n            for i in range(total_nodes):\n                cur[i] = 0\n                visited[i] = False\n            f = dfs(S, INF)\n            if f == 0:\n                break\n            ans += f * dist[T]\n        return ans\n\n    print(min_cost_flow())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.992108420585282e-05, -2.622600959512056e-06, -1.1920928244535389e-07, -0.001841636374592781, -0.008759526535868645, 0.0, -0.01110751647502184, -0.18006311357021332, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -5.960462772236497e-07, -0.0026805205270648003, -2.0265558760002023e-06, -0.0014429405564442277, -0.011078985407948494, -0.0007390628452412784, -0.001987864263355732, -0.029756896197795868, -3.0517112463712692e-05, -0.0010662352433428168, -1.0728830375228426e-06, -0.0001003691868390888, 0.0, -0.3132646977901459, -8.344646857949556e-07, -0.0002619877050165087, -2.145764938177308e-06, -7.152555099310121e-07, -4.511058807373047, -5.960446742392378e-06, -1.1920928244535389e-07, -0.003178308717906475, -5.125986263010418e-06, -6.318072337307967e-06, -3.0397906812140718e-05, -1.311301275563892e-06, -2.8132995794294402e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -2.145764938177308e-06, -0.0006280356901697814, -0.00012373158824630082, -2.3841830625315197e-06, -1.2516897186287679e-05, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -0.011075920425355434, 0.0, -1.1920928244535389e-07, -1.883488948806189e-05, 0.0, -2.3841855067985307e-07, 0.0, -3.4570634852570947e-06, 0.0, -3.099436753473128e-06, -0.0012407946633175015, 0.0, -1.5497195136049413e-06, 0.0, -5.483612312673358e-06, 0.0, -6.806619057897478e-05, -0.0005247407825663686, -5.125986263010418e-06, -2.3841855067985307e-07, 0.0, -1.3470558769768104e-05, -1.1920928244535389e-07, -2.861018856492592e-06, -0.00013553177996072918, -5.960462772236497e-07, -2.3841855067985307e