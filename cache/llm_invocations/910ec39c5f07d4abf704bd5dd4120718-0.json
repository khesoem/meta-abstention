obal minCost, maxFlow, dist, pre, capacity, inQueue\n    maxFlow = 0\n    minCost = 0\n    while True:\n        for i in range(nodes):\n            dist[i] = INF\n            pre[i] = -1\n            capacity[i] = 0\n            inQueue[i] = False\n        dist[s] = 0\n        pre[s] = 0\n        capacity[s] = INF\n        q = deque()\n        q.append(s)\n        inQueue[s] = True\n        while q:\n            u = q.popleft()\n            inQueue[u] = False\n            for it in adj[u]:\n                f = edges[it]\n                if f.rem() > 0 and dist[f.v] > dist[u] + f.cost + 1e-9:\n                    dist[f.v] = dist[u] + f.cost\n                    pre[f.v] = it\n                    capacity[f.v] = min(capacity[u], f.rem())\n                    if not inQueue[f.v]:\n                        q.append(f.v)\n                        inQueue[f.v] = True\n        if pre[t] < 0:\n            break\n        maxFlow += capacity[t]\n        minCost += capacity[t] * dist[t]\n        v = t\n        while v != s:\n            edges[pre[v]].flow += capacity[t]\n            edges[pre[v] ^ 1].flow -= capacity[t]\n            v = edges[pre[v]].u\n\ndef main():\n    global nodes, adj, edges\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    # compute number of nodes: source (0) + (T+1)*n cities (1..(T+1)*n)\n    nodes = (T + 1) * n + 1\n    # reset adjacency and edges\n    for i in range(nodes):\n        adj[i].clear()\n    edges.clear()\n    # initial people\n    for _ in range(k):\n        x = int(next(it)) - 1\n        addEdge(0, x + 1, 1, 0)\n    # roads\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for t in range(T):\n            for j in range(CAP):\n                addEdge(t * n + x + 1, (t + 1) * n + y + 1, 1, c + d * (2 * j + 1))\n                addEdge(t 