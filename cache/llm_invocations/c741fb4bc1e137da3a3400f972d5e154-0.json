th>\n\nusing namespace std;\n\nset<int> collect_sums(const vector<int>& arr, int mod) {\n    set<int> result;\n    result.insert(0);\n    \n    for (int val : arr) {\n        set<int> new_results;\n        for (int r : result) {\n            new_results.insert((r + val) % mod);\n            new_results.insert(r);\n        }\n        for (int nr : new_results) {\n            result.insert(nr);\n        }\n    }\n    \n    return result;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    \n    vector<int> a(n);\n    for (int i = 0; i < n; i++) {\n        cin >> a[i];\n        a[i] = a[i] % m;\n    }\n    \n    int half = n / 2;\n    set<int> left = collect_sums(vector<int>(a.begin(), a.begin() + half), m);\n    set<int> right = collect_sums(vector<int>(a.begin() + half, a.end()), m);\n    \n    vector<int> right_sorted(right.begin(), right.end());\n    sort(right_sorted.begin(), right_sorted.end());\n    \n    int max_total = 0;\n    \n    for (int s : left) {\n        int complement = m - s;\n        auto it = lower_bound(right_sorted.begin(), right_sorted.end(), complement);\n        int idx = it - right_sorted.begin();\n        \n        for (int j : {idx - 1, idx}) {\n            if (j >= 0 && j < (int)right_sorted.size()) {\n                int candidate = s + right_sorted[j];\n                if (candidate > max_total) {\n                    max_total = candidate;\n                }\n            }\n        }\n    }\n    \n    cout << max_total << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.997340824455023e-05, -3.2186455882765586e-06, -3.576278118089249e-07, -8.737658936297521e-05, -2.3841855067985307e-07, -6.282132380874828e-05, -3.576278118089249e-07, -1.4305104514278355e-06, -8.344646857949556e-07, -5.2569914259947836e-05, -8.344646857949556e-07, -4.410734163684538e-06, -9.536738616588991e-07, -0.00025412190007045865, -1.1920922133867862e-06, -4.768370445162873e-07, 0.0, -0.0002588890492