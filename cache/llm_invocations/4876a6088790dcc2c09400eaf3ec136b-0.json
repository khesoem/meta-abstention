OG = 0;\n    ll t = n;\n    while (t > 0) { ++LOG; t /= k; }\n    for (int j = 1; j <= LOG; ++j) {\n        memcpy(E[j][0], E[j-1][0], sizeof(E[j-1][0]));\n        memcpy(EI[j][0], EI[j-1][0], sizeof(EI[j-1][0]));\n        for (int l = 1; l < k; ++l) {\n            ll tmp[MAXK][MAXK];\n            mult_mat(tmp, E[j-1][l], E[j][0]);\n            memcpy(E[j][0], tmp, sizeof(tmp));\n            mult_mat(tmp, EI[j][0], EI[j-1][l]);\n            memcpy(EI[j][0], tmp, sizeof(tmp));\n        }\n        for (int i = 1; i < k; ++i) {\n            ll tmp1[MAXK][MAXK], tmp2[MAXK][MAXK];\n            mult_mat(tmp1, E[j][i-1], EI[j-1][i-1]);\n            mult_mat(tmp2, E[j-1][i-1], tmp1);\n            memcpy(E[j][i], tmp2, sizeof(tmp2));\n            mult_mat(tmp1, EI[j][i-1], EI[j-1][i-1]);\n            mult_mat(tmp2, E[j-1][i-1], tmp1);\n            memcpy(EI[j][i], tmp2, sizeof(tmp2));\n        }\n    }\n}\n\nvoid solve(ll n, ll v[MAXK], int at) {\n    if (n == 0) return;\n    int w = val(n / k);\n    solve(n / k, v, at + 1);\n    for (int i = 0; i < n % k; ++i) {\n        ll tmp[MAXK];\n        mult_mat_vec(tmp, E[at][(w + i) % k], v);\n        memcpy(v, tmp, sizeof(tmp));\n    }\n}\n\nint main() {\n    scanf(\"%lld %lld\", &n, &k);\n    for (int i = 0; i < k; ++i) {\n        cur[i] = 1;\n        for (int j = 0; j < k; ++j) {\n            for (int l = 0; l < k; ++l) {\n                if (j == l) {\n                    M[i][j][l] = 1;\n                    MI[i][j][l] = 1;\n                } else if (j == i) {\n                    M[i][j][l] = 1;\n                    MI[i][j][l] = -1;\n                } else {\n                    M[i][j][l] = 0;\n                    MI[i][j][l] = 0;\n                }\n            }\n        }\n    }\n    pre_comp();\n    solve(n, cur, 0);\n    ll tot = 0;\n    for (int i = 0; i < k; ++i) tot += cur[i];\n    --tot;\n    tot %= MOD;\n    if (tot < 0) tot += MOD;\n    while (tot % (k - 1) != 0) tot += MOD;\n    printf(\"%lld\\n\", tot / (k - 1