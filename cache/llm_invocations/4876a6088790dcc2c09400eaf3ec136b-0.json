, k):\n            tmp = [[0]*k for _ in range(k)]\n            mult_mat(tmp, E[j-1][l], E[j][0], k)\n            for i in range(k):\n                for m in range(k):\n                    E[j][0][i][m] = tmp[i][m]\n            mult_mat(tmp, EI[j][0], EI[j-1][l], k)\n            for i in range(k):\n                for m in range(k):\n                    EI[j][0][i][m] = tmp[i][m]\n        for i in range(1, k):\n            tmp1 = [[0]*k for _ in range(k)]\n            tmp2 = [[0]*k for _ in range(k)]\n            mult_mat(tmp1, E[j][i-1], EI[j-1][i-1], k)\n            mult_mat(tmp2, E[j-1][i-1], tmp1, k)\n            for a in range(k):\n                for b in range(k):\n                    E[j][i][a][b] = tmp2[a][b]\n            mult_mat(tmp1, EI[j][i-1], EI[j-1][i-1], k)\n            mult_mat(tmp2, E[j-1][i-1], tmp1, k)\n            for a in range(k):\n                for b in range(k):\n                    EI[j][i][a][b] = tmp2[a][b]\n    return M, MI, E, EI, LOG\n\ndef solve(n, v, at, E, k):\n    if n == 0:\n        return\n    w = val(n // k, k)\n    solve(n // k, v, at + 1, E, k)\n    for i in range(n % k):\n        tmp = [0]*k\n        mult_mat_vec(tmp, E[at][(w + i) % k], v, k)\n        for j in range(k):\n            v[j] = tmp[j]\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    cur = [1]*k\n    M, MI, E, EI, LOG = pre_comp(n, k)\n    solve(n, cur, 0, E, k)\n    tot = sum(cur) - 1\n    tot %= MOD\n    if tot < 0:\n        tot += MOD\n    while tot % (k-1) != 0:\n        tot += MOD\n    print(tot // (k-1))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0728830375228426e-06, 0.0, 0.0, -9.786603914108127e-05, -0.0008839037618599832, -1.7881377516459906e-06, -0.3132837116718292, -5.245071224635467e-05, -9.536738616588991e-07, -3.576278118089249e-07, -2.3841574147809297e-05, 0.0, -1.1920928244