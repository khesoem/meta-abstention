 = iter[u]; i < (int)g[u].size(); ++i) {\n            Edge &e = g[u][i];\n            if (e.cap > 0 && level[e.to] == level[u] + 1) {\n                ll pushed = dfs(e.to, min(f, e.cap));\n                if (pushed > 0) {\n                    e.cap -= pushed;\n                    g[e.to][e.rev].cap += pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n    \n    ll maxFlow() {\n        ll result = 0;\n        while (bfs()) {\n            fill(iter.begin(), iter.end(), 0);\n            ll pushed;\n            while ((pushed = dfs(s, 1LL << 60)) > 0) {\n                result += pushed;\n            }\n        }\n        return result;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, T;\n    cin >> n >> T;\n    \n    vector<string> grid(n);\n    int zy = -1, zx = -1;\n    for (int i = 0; i < n; ++i) {\n        cin >> grid[i];\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] == 'Z') {\n                zy = i; zx = j;\n            }\n        }\n    }\n    \n    string dummy;\n    getline(cin, dummy);\n    getline(cin, dummy);\n    \n    vector<string> exits(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> exits[i];\n    }\n    \n    vector<vector<int>> dist(n, vector<int>(n, -1));\n    queue<pair<int, int>> q;\n    q.push({zy, zx});\n    dist[zy][zx] = 0;\n    \n    const int dy[] = {1, -1, 0, 0};\n    const int dx[] = {0, 0, 1, -1};\n    \n    while (!q.empty()) {\n        auto [y, x] = q.front(); q.pop();\n        for (int d = 0; d < 4; ++d) {\n            int ny = y + dy[d], nx = x + dx[d];\n            if (ny < 0 || ny >= n || nx < 0 || nx >= n) continue;\n            if (dist[ny][nx] != -1 || grid[ny][nx] == 'Y') continue;\n            dist[ny][nx] = dist[y][x] + 1;\n            if (dist[ny][nx] < T) {\n                q.push({ny, nx});\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '0' && grid[i][j] <= '9') {\n                if (dist[i][j] == -1) dist[i][j] = T;\n                else dist[i][j] = min(dist[i][j], T);\n            }\n        }\n    }\n    \n    vector<vector<int>> nodeId(n, vector<int>(n, -1));\n    int nodeCount = 0;\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '0' && grid[i][j] <= '9') {\n                nodeId[i][j] = nodeCount++;\n            }\n            if (exits[i][j] >= '1' && exits[i][j] <= '9') {\n                nodeId[i][j] = nodeCount++;\n            }\n        }\n    }\n    \n    int src = 0, dst = nodeCount + 1;\n    DinicAlgorithm flow(nodeCount + 2, src, dst);\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (grid[i][j] >= '1' && grid[i][j] <= '9') {\n                flow.addEdge(src, nodeId[i][j], grid[i][j] - '0');\n            }\n            \n            if (exits[i][j] >= '1' && exits[i][j] <= '9') {\n                flow.addEdge(nodeId[i][j], dst, exits[i][j] - '0');\n            }\n            \n            for (int d = 0; d < 4; ++d) {\n                int ni = i + dy[d], nj = j + dx[d];\n                if (ni < 0 || ni >= n || nj < 0 || nj >= n) continue;\n                if (grid[ni][nj] == 'Y' || grid[ni][nj] == 'Z') continue;\n                \n                if (nodeId[i][j] != -1 && nodeId[ni][nj] != -1) {\n                    flow.addEdge(nodeId[i][j], nodeId[ni][nj], 1000000000);\n                }\n            }\n        }\n    }\n    \n    cout << flow.maxFlow() << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\nimport sys\n\nclass DinicAlgorithm:\n    class Edge:\n        __slots__ = ('to', 'rev', 'cap')\n        \n        def __init__(self, to, rev, cap):\n            self.to = to\n            self.rev = rev\n            self.cap = cap\n    \n    def __init__(self, n, src, dst):\n        self.N = n\n        self.g = [[] for _ in range(n)]\n        self.level = [-1] * n\n        self.iter = [0] * n\n        self.s = src\n        self.t = dst\n    \n    def addEdge(self, u, v, c):\n        self.g[u].append(self.Edge(v, len(self.g[v]), c))\n        self.g[v].append(self.Edge(u, len(self.g[u]) - 1, 0))\n    \n    def bfs(self):\n        self.level = [-1] * self.N\n        q = deque()\n        q.append(self.s)\n        self.level[self.s] = 0\n        while q:\n            u = q.popleft()\n            for e in self.g[u]:\n                if e.cap > 0 and self.level[e.to] == -1:\n                    self.level[e.to] = self.level[u] + 1\n                    q.append(e.to)\n        return self.level[self.t] != -1\n    \n    def dfs(self, u, f):\n        if u == self.t:\n            return f\n        for i in range(self.iter[u], len(self.g[u])):\n            self.iter[u] = i\n            e = self.g[u][i]\n            if e.cap > 0 and self.level[e.to] == self.level[u] + 1:\n                pushed = self.dfs(e.to, min(f, e.cap))\n                if pushed > 0:\n                    e.cap -= pushed\n                    self.g[e.to][e.rev].cap += pushed\n                    return pushed\n        return 0\n    \n    def maxFlow(self):\n        result = 0\n        while self.bfs():\n            self.iter = [0] * self.N\n            pushed = self.dfs(self.s, 1 << 60)\n            while pushed > 0:\n                result += pushed\n                pushed = self.dfs(self.s, 1 << 60)\n        return result\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    \n    if not data:\n        return\n    \n    n, T = map(int, data[0].split())\n    \n    grid = []\n    zy, zx = -1, -1\n    for i in range(1, n + 1):\n        line = data[i]\n        grid.append(line)\n        for j in range(len(line)):\n            if line[j] == 'Z':\n                zy, zx = i - 1, j\n    \n    # Skip two empty lines\n    idx = n + 1\n    while idx < len(data) and data[idx].strip() == '':\n        idx += 1\n    \n    exits = []\n    while idx < len(data) and len(exits) < n:\n        exits.append(data[idx])\n        idx += 1\n    \n    dist = [[-1] * n for _ in range(n)]\n    q = deque()\n    q.append((zy, zx))\n    dist[zy][zx] = 0\n    \n    dy = [1, -1, 0, 0]\n    dx = [0, 0, 1, -1]\n    \n    while q:\n        y, x = q.popleft()\n        for d in range(4):\n            ny, nx = y + dy[d], x + dx[d]\n            if ny < 0 or ny >= n or nx < 0 or nx >= n:\n                continue\n            if dist[ny][nx] != -1 or grid[ny][nx] == 'Y':\n                continue\n            dist[ny][nx] = dist[y][x] + 1\n            if dist[ny][nx] < T:\n                q.append((ny, nx))\n    \n    for i in range(n):\n        for j in range(n):\n            if '0' <= grid[i][j] <= '9':\n                if dist[i][j] == -1:\n                    dist[i][j] = T\n                else:\n                    dist[i][j] = min(dist[i][j], T)\n    \n    nodeId = [[-1] * n for _ in range(n)]\n    nodeCount = 0\n    \n    for i in range(n):\n        for j in range(n):\n            if '0' <= grid[i][j] <= '9':\n                nodeId[i][j] = nodeCount\n                nodeCount += 1\n            if '0' <= exits[i][j] <= '9':\n                nodeId[i][j] = nodeCount\n                nodeCount += 1\n    \n    src = 0\n    dst = nodeCount + 1\n    flow = DinicAlgorithm(nodeCount + 2, src, dst)\n    \n    for i in range(n):\n        for j in range(n):\n            if '1' <= grid[i][j] <= '9':\n                flow.addEdge(src, nodeId[i][j], ord(grid[i][j]) - ord('0'))\n            \n            if '1' <= exits[i][j] <= '9':\n                flow.addEdge(nodeId[i][j], dst, ord(exits[i][j]) - ord('0'))\n            \n            for d in range(4):\n                ni, nj = i + dy[d], j + dx[d]\n                if ni < 0 or