ert>\n#include <cstdint>\n\nusing namespace std;\n\ntypedef long long ll;\n\nstruct Mod998 {\n    static const ll MOD = 998244353LL;\n    vector<ll> factorial;\n    vector<ll> invFactorial;\n\n    Mod998() {\n        factorial.push_back(1LL);\n        invFactorial.push_back(1LL);\n    }\n\n    ll modulus() {\n        return MOD;\n    }\n\n    ll fact(int n) {\n        while ((int)factorial.size() <= n) {\n            factorial.push_back(mult(factorial.back(), (ll)factorial.size()));\n        }\n        return factorial[n];\n    }\n\n    ll fInv(int n) {\n        int lastKnown = (int)invFactorial.size() - 1;\n        if (lastKnown < n) {\n            int len = n - lastKnown;\n            vector<ll> fInv(len);\n            fInv[0] = inv(fact(n));\n            for (int i = 1; i < len; i++) {\n                fInv[i] = mult(fInv[i-1], (ll)(n - i + 1));\n            }\n            for (int i = len - 1; i >= 0; i--) {\n                invFactorial.push_back(fInv[i]);\n            }\n        }\n        return invFactorial[n];\n    }\n\n    ll paritySign(ll k) {\n        return (k & 1) == 0 ? 1 : MOD - 1;\n    }\n\n    ll ncr(int n, int r) {\n        assert(n >= 0);\n        if (r < 0 || n < r) return 0;\n        return mult(fact(n), mult(fInv(r), fInv(n - r)));\n    }\n\n    ll normalize(ll x) {\n        x %= MOD;\n        if (x < 0) x += MOD;\n        return x;\n    }\n\n    ll add(ll a, ll b) {\n        ll v = a + b;\n        return v < MOD ? v : v - MOD;\n    }\n\n    ll mult(ll a, ll b) {\n        return (a * b) % MOD;\n    }\n\n    ll mult(ll a, ll b, ll c) {\n        return mult(mult(a, b), c);\n    }\n\n    ll mult(ll a, ll b, ll c, ll d) {\n        return mult(mult(a, b), mult(c, d));\n    }\n\n    ll pow(ll x, int e) {\n        if (e < 0) {\n            x = inv(x);\n            e = -e;\n        }\n        if (e == 0) return 1;\n        if (e & 1) return mult(x, pow(x, e - 1));\n        return pow(mult(x, x), e / 2);\n    }\n\n    ll inv(ll value) {\n        ll g =