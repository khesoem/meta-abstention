    vector<long long> fact(max_val + 1);\n    vector<long long> invFact(max_val + 1);\n    fact[0] = 1;\n    for (int i = 1; i <= max_val; ++i) {\n        fact[i] = fact[i - 1] * i % MOD;\n    }\n    invFact[max_val] = modInv(fact[max_val]);\n    for (int i = max_val; i >= 1; --i) {\n        invFact[i - 1] = invFact[i] * i % MOD;\n    }\n\n    long long phaseSize = 1;\n    long long p = 1;\n    for (int i = 0; p != 0; ++i) {\n        p = p * (n - i) % MOD * smallInv(n + m - i, fact, invFact) % MOD;\n        phaseSize = add(phaseSize, p);\n    }\n\n    long long answer = 0;\n    for (int k = 1; k <= n; ++k) {\n        long long sign = ((k + 1) & 1) == 0 ? 1 : MOD - 1;\n        long long numPhases = (m + k) % MOD * smallInv(k, fact, invFact) % MOD;\n        long long ncr = fact[n] * invFact[k] % MOD * invFact[n - k] % MOD;\n        long long term = sign * ncr % MOD * numPhases % MOD * phaseSize % MOD;\n        answer = add(answer, term);\n    }\n\n    cout << answer << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.2649508537142538e-05, -0.008440298959612846, -4.768360213347478e-06, 0.0, -1.1920928244535389e-07, -0.00046826363541185856, -0.00020382710499688983, -1.0132738680113107e-05, -0.07893689721822739, -8.106198947643861e-06, -1.0132738680113107e-05, 0.0, -0.000842692912556231, -0.01815686747431755, -0.10025543719530106, -1.1920928244535389e-07, -0.0188381839543581, -1.3133413791656494, -0.00159172632265836, -2.777537883957848e-05, 0.0, -0.03804818540811539, -0.1084037721157074, -1.6569954823353328e-05, -8.344646857949556e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.015282557345926762, -1.7881233361549675e-05, -0.02034311182796955, -1.1920928244535389e-07, -0.07914970815181732, -0.022179409861564636, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, -6.878139538457617e-05, -4.768370445162873e-07, -1.537788011773955e-05, -3.611976353568025e-05, -1.1920928244535389e-07, -6.329813186312094e-