 n = self.N\n        self.mc = 0\n        self.sz = [0] * n\n        self.adj = [[] for _ in range(n)]\n    \n    def add_edge(self, a, b, c=1, p=0):\n        self.mc = max(self.mc, c)\n        # Forward edge\n        self.adj[a].append({'v': b, 'r': self.sz[b], 'f': 0, 'c': c, 'p': p})\n        self.sz[b] += 1\n        # Backward edge\n        self.adj[b].append({'v': a, 'r': self.sz[a], 'f': 0, 'c': 0, 'p': -p})\n        self.sz[a] += 1\n    \n    def min_cost_flow(self, s, t, n=None, sparse=True):\n        if n is None:\n            n = self.N\n        \n        # Initialize potentials\n        pot = [0] * n\n        \n        # Bellman-Ford initialization (if needed for negative edges)\n        # For this problem, all edge costs are non-negative, so we skip it\n        \n        price = 0\n        flow = 0\n        \n        while True:\n            # Dijkstra's algorithm\n            dist = [INF] * n\n            par = [-1] * n\n            vis = [False] * n\n            dist[s] = 0\n            \n            if sparse:\n                # Using priority queue for sparse graph\n                heap = [(0, s)]\n                while heap:\n                    d, u = heapq.heappop(heap)\n                    if vis[u]:\n                        continue\n                    vis[u] = True\n                    for e in self.adj[u]:\n                        if e['f'] < e['c'] and dist[e['v']] > dist[u] + pot[u] - pot[e['v']] + e['p']:\n                            dist[e['v']] = dist[u] + pot[u] - pot[e['v']] + e['p']\n                            par[e['v']] = e['r']\n                            heapq.heappush(heap, (dist[e['v']], e['v']))\n            else:\n                # Dense version\n                for _ in range(n):\n                    u = -1\n                    best = INF\n                    for i in range(n):\n                        if not vis[i] and dist[i] < best:\n                            best = dist[i]\n                            u = i\n                    if u == -1:\n                        break\n                    vis[u] = True\n                    for e in self.adj[u]:\n                        if e['f'] < e['c'] and dist[e['v']] > dist[u] + pot[u] - pot[e['v']] + e['p']:\n                            dist[e['v']] = dist[u] + pot[u] - pot[e['v']] + e['p']\n                            par[e['v']] = e['r']\n            \n            if dist[t] >= INF:\n                break\n            \n            # Find minimum residual capacity along the path\n            df = INF\n            u = t\n            while u != s:\n                e = self.adj[u][par[u]]\n                rev_e = self.adj[e['v']][e['r']]\n                df = min(df, rev_e['c'] - rev_e['f'])\n                u = e['v']\n            \n            # Update flow along the path\n            u = t\n            while u != s:\n                e = self.adj[u][par[u]]\n                rev_e = self.adj[e['v']][e['r']]\n                rev_e['f'] += df\n                e['f'] -= df\n                price += df * rev_e['p']\n                u = e['v']\n            \n            # Update potentials\n            for i in range(n):\n                pot[i] = min(INF, dist[i] + pot[i])\n            \n            flow += df\n        \n        return flow, price\n\ndef main():\n    input = sys.stdin\n    output = sys.stdout\n    \n    n, m, k, c, d = map(int, input.readline().split())\n    \n    source = 0\n    sink = n * T + 1\n    \n    flow_instance = Flow()\n    \n    # Add edges from source to k nodes\n    for _ in range(k):\n        a = int(input.readline())\n        flow_instance.add_edge(source, a, 1, 0)\n    \n    # Add edges for time progression\n    for t in range(T):\n        flow_instance.add_edge(1 + t * n, sink, INF, 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow_instance.add_edge(i + (t - 1) * n, i + t * n, INF, c)\n    \n    # Add edges for m connections\n    for _ in range(m):\n        a, b = map(int, inp