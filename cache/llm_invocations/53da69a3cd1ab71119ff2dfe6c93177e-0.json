 modular exponentiation\n    static long mu(long x, long y) {\n        if (y == 1) return x % mod;\n        long tmp = mu(x, y / 2);\n        tmp = (tmp * tmp) % mod;\n        if (y % 2 == 0) return tmp;\n        return (tmp * x) % mod;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n\n        if (k == 0) {\n            System.out.println(mu(p, p - 1));\n        } else if (k == 1) {\n            System.out.println(mu(p, p));\n        } else {\n            int m = 1;\n            int t = k;\n            while (true) {\n                m++;\n                t = (int) ((long) t * k % p);\n                if (t == 1) {\n                    System.out.println(mu(p, (p - 1) / m));\n                    break;\n                }\n            }\n        }\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.12843044102191925, -0.0007551893359050155, -4.4849443838757e-06, -5.085517113911919e-05, -1.981667537620524e-06, -1.9361264946837764e-07, -0.0003124632057733834, -0.010315627790987492, -1.676292231422849e-05, -3.531315314830863e-06, -3.128163257315464e-07, -7.350386295001954e-05, -0.029761260375380516, -0.0008311899146065116, -0.004647403489798307, -0.003835828974843025, -0.2519293427467346, -0.5759496092796326, -3.531315314830863e-06, -0.0007100477814674377, -0.003179975086823106, 0.0, 0.0, -1.981667537620524e-06, -0.6663199067115784, -6.704273118884885e-07, -3.836184024810791, -0.777275562286377, -2.861492156982422, -0.0012376103550195694, -4.320199877838604e-07, -0.3408544957637787, -5.512236498361744e-07, -0.2896440327167511, -0.01815064437687397, -0.0001342903997283429, -0.012521075084805489, -0.0017031522002071142, -1.2664456789934775e-06, -0.01603436842560768, 0.0, -0.00015038289711810648, -7.896309739408025e-07, -3.128163257315464e-07, 0.0, -0.000452241423772648, -5.1689596148207784e-05, -3.1