{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\n#define DEBUG 0\ntypedef long long ll;\ntypedef pair<int,int> pii;\ntypedef pair<ll,ll> pll;\n#define fore(i,ii,iii) for(int i=ii;i<iii;i++)\n#define pb push_back\n#define SZ(a) ((int)(a).size())\n#define mset(a,b) memset(a,b,sizeof(a));\n#define ALL(a) a.begin(),a.end()\n#define fst first\n#define snd second\n\nconst int MAXN=50*100+15;\nint SRC = MAXN-1;\nint SNC = MAXN-2;\n\ntypedef ll tf; const tf INFFLUJO=1e14;\ntypedef ll tc; const tc INFCOSTO=1e14;\nstruct edge {\n    int u,v; tf cap,flow; tc cost;\n    tf rem(){return cap-flow;}\n};\nint nodes=MAXN;\nvector<int> g[MAXN];\nvector<edge> e;\nvoid add_edge(int u, int v, tf cap, tc cost) {\n    if(DEBUG) {\n        string dem=to_string(u),pen=to_string(v);\n        if(u==SRC)dem=\"SRC\";\n        if(u==SNC)dem=\"SINC\";\n        if(v==SRC)pen=\"SRC\";\n        if(v==SNC)pen=\"SINC\";\n        cout<<\"add edge: \"<<dem<<\" \"<<pen<<\" \"<<cap<<\" \"<<cost<<endl;\n    }\n    g[u].pb(SZ(e)); e.pb((edge){u,v,cap,0,cost});\n    g[v].pb(SZ(e)); e.pb((edge){v,u,0,0,-cost});\n}\n\ntc dist[MAXN], mncost;\nint pre[MAXN];\ntf cap[MAXN], mxflow;\n\nvoid flow(int s, int t) {\n    mxflow = mncost = 0;\n    while(1) {\n        fill(dist, dist+nodes, INFCOSTO); dist[s] = 0;\n        mset(pre, -1); pre[s] = 0;\n        mset(cap, 0); cap[s] = INFFLUJO;\n        // Bellman-Ford (V-1 iterations)\n        fore(iter, 0, nodes-1) {\n            bool updated = false;\n            fore(u, 0, nodes) {\n                if(dist[u] == INFCOSTO) continue;\n                for(int idx : g[u]) {\n                    edge &E = e[idx];\n                    if(E.rem() && dist[E.v] > dist[u] + E.cost + 1e-9) {\n                        dist[E.v] = dist[u] + E.cost;\n                        pre[E.v] = idx;\n                        cap[E.v] = min(cap[u], E.rem());\n                        updated = true;\n                    }\n                }\n            }\n            if(!updated) break;\n        }\n        if(pre[t] < 0) break;\n        mxflow += cap[t];\n        mncost += cap[t] * dist[t];\n        for(int v = t; v != s; v = e[pre[v]].u) {\n            e[pre[v]].flow += cap[t];\n            e[pre[v]^1].flow -= cap[t];\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    ll n,m,k,c,d;\n    cin>>n>>m>>k>>c>>d;\n    int MAXT = n + k;\n    if(DEBUG) cout<<\"MAXT: \"<<MAXT<<endl;\n    vector<int> a(k);\n    fore(i,0,k) {\n        cin>>a[i]; a[i]--;\n        add_edge(SRC, a[i]*MAXT, 1, 0);\n    }\n    fore(j,0,MAXT) add_edge(j, SNC, k, 0);\n    fore(i,0,m) {\n        int x,y; cin>>x>>y; x--,y--;\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(x*MAXT+j, y*MAXT+j+1, 1, c + d*(2*K-1));\n        }\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(y*MAXT+j, x*MAXT+j+1, 1, c + d*(2*K-1));\n        }\n    }\n    fore(i,0,n) {\n        fore(j,0,MAXT-1) fore(K,1,k+1) {\n            add_edge(i*MAXT+j, i*MAXT+j+1, 1, c);\n        }\n    }\n    flow(SRC, SNC);\n    if(DEBUG) cout<<\"mncost: \"<<mncost<<\" mxflow: \"<<mxflow<<endl;\n    cout<<mncost