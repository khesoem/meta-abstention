            inq[u] = false;\n            \n            for (int i = 0; i < gph[u].size(); ++i) {\n                auto &e = gph[u][i];\n                if (e.cap > 0 && dist[e.dest] > dist[u] + e.cost) {\n                    dist[e.dest] = dist[u] + e.cost;\n                    prevV[e.dest] = u;\n                    prevE[e.dest] = i;\n                    if (!inq[e.dest]) {\n                        inq[e.dest] = true;\n                        q.push(e.dest);\n                    }\n                }\n            }\n        }\n        return dist[dst] < INF;\n    }\n    \n    int compute(int s, int t) {\n        int totalCost = 0;\n        while (shortestPath(s, t)) {\n            int flow = INF;\n            for (int v = t; v != s; v = prevV[v]) {\n                flow = min(flow, gph[prevV[v]][prevE[v]].cap);\n            }\n            totalCost += dist[t] * flow;\n            for (int v = t; v != s; v = prevV[v]) {\n                auto &e = gph[prevV[v]][prevE[v]];\n                e.cap -= flow;\n                gph[v][e.revIdx].cap += flow;\n            }\n        }\n        return totalCost;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int src = 0;\n    int dst = n * 100 + 1;\n    MCMF mcmf(dst + 1);\n    \n    // Connect all nodes at level 100 to sink\n    for (int level = 1; level <= 100; ++level) {\n        mcmf.addEdge(level, dst, 100, 0);\n    }\n    \n    // Connect source to starting positions\n    for (int i = 0; i < k; ++i) {\n        int startPos;\n        cin >> startPos;\n        mcmf.addEdge(src, (startPos - 1) * 100 + 1, 1, 0);\n    }\n    \n    // Connect positions within same node: i -> i+1\n    for (int node = 1; node <= n; ++node) {\n        for (int level = 1; level < 100; ++level) {\n            int from = (node - 1) * 100 + level;\n            int to = (node - 1) * 100 + level + 1;\n            mcmf.addEdge(from, to, 100, c