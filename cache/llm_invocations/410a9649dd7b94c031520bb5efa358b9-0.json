], a[j + k]);\n    }\n\n    void get_ln() {\n        p[0] = 0;\n        for (int i = 1; i <= n; i++) {\n            p[i] = h[i] * i;\n            for (int j = 1; j < i; j++)\n                p[i] -= p[j] * h[i - j] % Mo * j;\n            p[i] = p[i] % Mo * inv[i] % Mo;\n        }\n        for (int i = 0; i <= n; i++) h[i] = (p[i] + Mo) % Mo;\n    }\n\n    void get_exp() {\n        p[0] = 1;\n        for (int i = 1; i <= n; i++) {\n            p[i] = 0;\n            for (int j = 1; j <= i; j++)\n                p[i] += h[j] * p[i - j] % Mo * j;\n            p[i] = p[i] % Mo * inv[i] % Mo;\n        }\n        for (int i = 0; i <= n; i++) h[i] = p[i];\n    }\n\n    void solve() {\n        scanf(\"%d%d%d\", &L, &k, &Mo);\n        int all = pwr(k, L);\n\n        if (L & 1) {\n            printf(\"%d\\n\", all);\n            return;\n        }\n\n        fac[0] = 1;\n        for (int i = 1; i <= L; i++) fac[i] = (ll)fac[i - 1] * i % Mo;\n\n        inv[L] = pwr(fac[L], Mo - 2);\n        for (int i = L - 1; i >= 0; i--) inv[i] = (ll)inv[i + 1] * (i + 1) % Mo;\n\n        for (int s = 1; s <= L; s++) cnt[s] = cnt[s ^ (s & -s)] + 1;\n\n        for (int i = 0; i <= 18; i++)\n            if ((L >> i) & 1) bit[++n] = 1 << i;\n\n        len = 1 << n;\n\n        for (int i = 0; i < len; i++) {\n            int s = 0;\n            for (int j = 1; j <= n; j++)\n                if ((i >> (j - 1)) & 1) s += bit[j];\n            g[cnt[i]][i] = inv[s];\n        }\n\n        for (int i = 2; i <= n; i++)\n            inv[i] = (ll)(Mo - Mo / i) * inv[Mo % i] % Mo;\n\n        for (int i = 0; i <= n; i++) fwt(g[i], len);\n\n        for (int s = 0; s < len; s++) {\n            for (int i = 0; i <= n; i++) h[i] = g[i][s];\n            get_ln();\n            for (int i = 0; i <= n; i++) h[i] = h[i] * k;\n            get_exp();\n            for (int i = 0; i <= n; i++) f[i][s] = h[i];\n        }\n\n        ifwt(f[n], len);\n\n        int ans = (ll)f[n][len - 1] * fac[L] % Mo;\n        ans = (all 