n) {\n            long long curRoot = 1;\n            for (int j = st; j < st + len; j++) {\n                long long t = (curRoot * coef[j + len]) % MOD;\n                long long u = coef[j];\n                coef[j] = (u + t) % MOD;\n                long long diff = (u - t) % MOD;\n                if (diff < 0) diff += MOD;\n                coef[j + len] = diff;\n                curRoot = (roots[s] * curRoot) % MOD;\n            }\n        }\n    }\n    if (inverse) {\n        long long invSize = modInverse(coef.size());\n        for (int i = 0; i < (int)coef.size(); i++) {\n            coef[i] = (coef[i] * invSize) % MOD;\n        }\n    }\n    return coef;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    n /= 2;\n    vector<int> nums(m);\n    int maxVal = 0;\n    for (int i = 0; i < m; i++) {\n        cin >> nums[i];\n        if (nums[i] > maxVal) maxVal = nums[i];\n    }\n    int requiredSize = n * maxVal + 1;\n    int k = 0, size = 1;\n    while (size < requiredSize) {\n        size <<= 1;\n        k++;\n    }\n    vector<long long> poly(size, 0);\n    for (int num : nums) poly[num] = 1;\n    poly = performNTT(poly, k, false);\n    for (int i = 0; i < size; i++) poly[i] = modPow(poly[i], n);\n    poly = performNTT(poly, k, true);\n    long long result = 0;\n    for (int i = 0; i < size; i++) {\n        result = (result + poly[i] * poly[i]) % MOD;\n    }\n    long long invSize = modInverse(size);\n    cout << ((result * invSize % MOD) * invSize % MOD) << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002269487304147333, -1.5497195136049413e-06, -1.1920922133867862e-06, -0.0029101900290697813, -4.768370445162873e-07, -0.0001627074379939586, -4.2199197196168825e-05, -1.5497195136049413e-06, -3.4570634852570947e-06, -6.961580220377073e-05, -9.536738616588991e-07, -0.00033682872890494764, -3.933898824470816e-06, -0.0006985607906244695, -0.42870795726776123, -0.16025254130363464, -1.19209282445353