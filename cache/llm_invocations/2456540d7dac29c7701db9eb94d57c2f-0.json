r.rot270().scale(h)))\n        left_int = self.center.add(unit_dir.scale(d1).add(unit_dir.rot90().scale(h)))\n        return [right_int, left_int]\n\ndef find(parent, x):\n    if parent[x] != x:\n        parent[x] = find(parent, parent[x])\n    return parent[x]\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    n = int(input_data[0])\n    circles = []\n    index = 1\n    for i in range(n):\n        x = int(input_data[index])\n        y = int(input_data[index + 1])\n        r = int(input_data[index + 2])\n        index += 3\n        circles.append(Circle(Vec(x, y), r))\n    \n    all_points = []\n    parent = list(range(n))\n    result = 1\n    \n    for i in range(n):\n        current_set = set()\n        for j in range(n):\n            if i == j:\n                continue\n            pts = circles[i].intersect(circles[j])\n            if pts is None:\n                continue\n            \n            root_i = find(parent, i)\n            root_j = find(parent, j)\n            parent[root_i] = root_j\n            \n            for p in pts:\n                if p not in current_set:\n                    current_set.add(p)\n        \n        result += len(current_set)\n        \n        for p in current_set:\n            if p not in all_points:\n                all_points.append(p)\n    \n    result -= len(all_points)\n    components = sum(1 for i in range(n) if parent[i] == i)\n    result += components\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.210611172718927e-05, -9.536738616588991e-07, -7.152555099310121e-07, -0.0018692417070269585, -0.012146905064582825, -6.6756979322235566e-06, -0.054895058274269104, -0.0008803306263871491, -0.05488806217908859, -0.20143720507621765, -0.3368130028247833, -3.576278118089249e-07, -0.015246044844388962, -0.007858077064156532, -0.06609304249286652, -0.0001519802899565547