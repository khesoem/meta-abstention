}\n\treturn dis[t] != INF;\n}\nvoid update() {\n\tint f = flow[t];\n\tint p = t;\n\twhile (p != s) {\n\t\tint i = pre[p];\n\t\tcap[i] -= f;\n\t\tcap[i ^ 1] += f;\n\t\tp = ver[i ^ 1];\n\t}\n\tans += f * dis[t];\n}\nint main() {\n\tios::sync_with_stdio(false);\n\tcin.tie(0);\n\tcin >> n >> m >> k >> c >> d;\n\tt = (n + k - 1) * n + 1;\n\tfor (int i = 1, x; i <= k; i++) {\n\t\tcin >> x;\n\t\tlink(s, x, 1, 0);\n\t}\n\tfor (int i = 1, u, v; i <= m; i++) {\n\t\tcin >> u >> v;\n\t\tfor (int layer = 1; layer <= n + k; layer++) {\n\t\t\tfor (int hop = 1; hop <= k; hop++) {\n\t\t\t\tint w = d * hop * 2 - d + c;\n\t\t\t\tlink(u + (layer - 1) * n, v + layer * n, 1, w);\n\t\t\t\tlink(v + (layer - 1) * n, u + layer * n, 1, w);\n\t\t\t}\n\t\t}\n\t}\n\tfor (int layer = 1; layer < n + k; layer++) {\n\t\tfor (int node = 2; node <= n; node++) {\n\t\t\tlink(node + (layer - 1) * n, node + layer * n, 1000000000, c);\n\t\t}\n\t\tlink(1 + (layer - 1) * n, 1 + layer * n, 1000000000, 0);\n\t}\n\twhile (spfa()) update();\n\tcout << ans << '\\n';\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 10000010;\n    static final int INF = 0x3f3f3f3f;\n    \n    static int n, m, c, d, k, s, t, ans;\n    static int ecnt = 1;\n    static int[] head = new int[MAXN];\n    static int[] ver = new int[MAXN];\n    static int[] edge = new int[MAXN];\n    static int[] cap = new int[MAXN];\n    static int[] cost = new int[MAXN];\n    static int[] dis = new int[MAXN];\n    static int[] flow = new int[MAXN];\n    static int[] pre = new int[MAXN];\n    static boolean[] vis = new boolean[MAXN];\n    \n    static void link(int x, int y, int z, int v) {\n        ver[++ecnt] = y;\n        edge[ecnt] = head[x];\n        head[x] = ecnt;\n        cap[ecnt] = z;\n        cost[ecnt] = v;\n        \n        ver[++ecnt] = x;\n 