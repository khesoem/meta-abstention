{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <map>\nusing namespace std;\n\nconst int MOD = 1000000007;\nconst int MAXN = 10;\n\nint a[MAXN][MAXN];\n\nint add(int x, int y) {\n    x += y;\n    return x >= MOD ? x - MOD : x;\n}\n\nint sub(int x, int y) {\n    x -= y;\n    return x < 0 ? x + MOD : x;\n}\n\nint mul(int x, int y) {\n    return (1LL * x * y) % MOD;\n}\n\nint power(int x, int e) {\n    int res = 1;\n    while (e) {\n        if (e & 1) res = mul(res, x);\n        x = mul(x, x);\n        e >>= 1;\n    }\n    return res;\n}\n\nint inv(int x) {\n    return power(x, MOD - 2);\n}\n\nint divv(int x, int y) {\n    return mul(x, inv(y));\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            cin >> a[i][j];\n            a[i][j] = divv(a[i][j], 100);\n        }\n\n    map<vector<int>, int> dp;\n    dp[{0}] = 1;\n\n    for (int col = 0; col < n; ++col) {\n        map<vector<int>, int> ndp;\n        for (int mask = 0; mask < (1 << n); ++mask) {\n            int prob = 1;\n            for (int row = 0; row < n; ++row) {\n                if (mask & (1 << row))\n                    prob = mul(prob, a[row][col]);\n                else\n                    prob = mul(prob, sub(1, a[row][col]));\n            }\n            for (auto &entry : dp) {\n                vector<int> newVec;\n                for (int m : entry.first) {\n                    int diff = (~m) & mask;\n                    while (diff) {\n                        int bit = diff & -diff;\n                        newVec.push_back(m | bit);\n                        diff ^= bit;\n                    }\n                }\n                if (newVec.empty()) continue;\n                sort(newVec.begin(), newVec.end());\n                newVec.erase(unique(newVec.begin(), newVec.end()), newVec.end());\n                int val = mul(entry.second, prob);\n                auto it = ndp.find(newVec);\n                if (it == ndp.end())\n                    ndp[newVec] = val;\n                else\n                    it->second = add(it->second, val);\n            }\n        }\n        dp = move(ndp);\n    }\n\n    int ans = 0;\n    for (auto &entry : dp)\n        ans = add(ans, entry.second);\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nMOD = 1000000007\n\ndef add(x, y):\n    x += y\n    return x - MOD if x >= MOD else x\n\ndef sub(x, y):\n    x -= y\n    return x + MOD if x < 0 else x\n\ndef mul(x, y):\n    return (x * y) % MOD\n\ndef power(x, e):\n    res = 1\n    while e:\n        if e & 1:\n            res = mul(res, x)\n        x = mul(x, x)\n        e >>= 1\n    return res\n\ndef inv(x):\n    return power(x, MOD - 2)\n\ndef divv(x, y):\n    return mul(x, inv(y))\n\ndef main():\n    import sys\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    n = int(next(it))\n    a = [[0]*n for _ in range(n)]\n    inv100 = inv(100)\n    for i in range(n):\n        for j in range(n):\n            val = int(next(it))\n            a[i][j] = mul(val, inv100)\n\n    dp = {(0,): 1}\n    full_mask = (1 << n) - 1\n\n    for col in range(n):\n        ndp = {}\n        for mask in range(1 << n):\n            prob = 1\n            for row in range(n):\n                if mask & (1 << row):\n                    prob = mul(prob, a[row][col])\n                else:\n                    prob = mul(prob, sub(1, a[row][col]))\n            for entry_key, entry_val in dp.items():\n                new_vec = []\n                for m in entry_key:\n                    diff = (full_mask ^ m) & mask\n                    while diff:\n                        bit = diff & -diff\n                        new_vec.append(m | bit)\n                        diff ^= bit\n                if not new_vec:\n                    continue\n                new_vec = sorted(set(new_vec))\n                new_key = tuple(new_vec)\n                val = mul(entry_val, prob)\n                if new_key in ndp:\n                    ndp[new_key] = add(ndp[new_key], val)\n                else:\n                    ndp[new_key] = val\n        dp = ndp\n\n    ans = 0\n    for val in dp.values():\n        ans = add(ans, val)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.00013433984713628888, -2.3841855067985307e-07, -4.768370445162873e-07, -0.0003813969960901886, -0.48231297731399536, -2.3841855067985307e-07, -3.576278118089249e-07, -7.510157047363464e-06, 0.0, -2.3841855067985307e-07, 0.0, -0.20141957700252533, -1.3589766240329482e-05, -0.00010215714428341016, -2.1576648578047752e-05, -6.437280717364047e-06, 0.0, -5.125986263010418e-06, -1.1920928244535389e-07, -0.00012981049076188356, -9.667406266089529e-05, 0.0, -1.192092824453