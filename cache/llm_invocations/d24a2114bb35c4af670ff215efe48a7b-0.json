else:\n        t[0] = h_vec[0]\n    while K:\n        if K & 1:\n            poly_mult(s, t)\n        poly_mult(t, t)\n        K >>= 1\n    res = 0\n    for i in range(m_len):\n        res = (res + s[i] * a_vec[i]) % MOD\n    return (res % MOD + MOD) % MOD\n\ndef compute(seq, n):\n    global h_vec, a_vec, m_len\n    if n < len(seq):\n        return seq[n]\n    h_vec = berlekamp_massey(seq)\n    m_len = len(h_vec)\n    if m_len == 0:\n        return 0\n    a_vec = seq[:m_len]\n    return eval_seq(n)\n\ndef count_valid(n, upper_bound):\n    cnt = 0\n    s = str(n)\n    length = len(s)\n    if n > 0:\n        cnt += 1\n    for i in range(1, T):\n        base = 1\n        num = n\n        for j in range(i - 1):\n            base *= 10\n        for j in range(length, i):\n            num *= 10\n        if i < length:\n            prefix = s[:i]\n            num = int(prefix) + 1\n        if num > upper_bound:\n            num = upper_bound\n        if num > base:\n            cnt += num - base\n    return cnt\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    n += 1\n    limit = n\n    \n    adjustment = (n % MOD) * ((n // MOD1) + 2) % MOD\n    adjustment = (MOD - adjustment) % MOD\n    \n    total = 0\n    for offset in range(-n // MOD1 - 1, n // MOD1 + 2):\n        count = 0\n        for digits in range(T):\n            left = 0\n            right = 1\n            if digits >= 1:\n                left = 1\n                for k in range(digits - 1):\n                    left *= 10\n                right = left * 10\n            if right > n:\n                right = n\n            last_right = right\n            if left < right:\n                left -= 1\n                while right - left > 1:\n                    mid = (left + right) // 2\n                    if count_valid(mid, limit) > mid + MOD1 * offset - 1:\n                        right = mid\n                    else:\n                        left 