 best_p = ceil_num;\n            best_q = i;\n        }\n    }\n    ll g = gcd(best_p, best_q);\n    best_p /= g;\n    best_q /= g;\n    cout << best_p << \"/\" << best_q;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef lcm(a, b):\n    return a * b // math.gcd(a, b)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x, y, n = map(int, data[:3])\n    if y <= n:\n        g = math.gcd(x, y)\n        while g > 1:\n            x //= g\n            y //= g\n            g = math.gcd(x, y)\n        print(f\"{x}/{y}\")\n        return\n    best = 1e9\n    best_p = 0\n    best_q = 0\n    for i in range(1, n + 1):\n        L = lcm(i, y)\n        w = x * (L // y)\n        step = L // i\n        floor_num = w // step\n        diff_floor = (w - floor_num * step) / L\n        if best > diff_floor:\n            best = diff_floor\n            best_p = floor_num\n            best_q = i\n        ceil_num = (w + step - 1) // step\n        diff_ceil = (ceil_num * step - w) / L\n        if best > diff_ceil:\n            best = diff_ceil\n            best_p = ceil_num\n            best_q = i\n    g = math.gcd(best_p, best_q)\n    best_p //= g\n    best_q //= g\n    print(f\"{best_p}/{best_q}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00036149643710814416, -1.1920928244535389e-07, 0.0, -0.0001282609737245366, -0.0015198357868939638, -0.3868710994720459, -0.0053314645774662495, -0.0015024575404822826, 0.0, -9.715084888739511e-05, -0.038105905055999756, -0.4811272621154785, 0.0, -2.3841855067985307e-07, -0.0024924185127019882, 0.0, -3.814689989667386e-06, -1.1920928244535389e-07, -5.960446742392378e-06, -2.7418097943154862e-06, -0.07888996601104736, 0.0, -1.1920928244535389e-07, -1.072883037522842