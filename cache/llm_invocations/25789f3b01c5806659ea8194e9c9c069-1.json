gn = -1\n            c = self.read()\n        \n        res = 0\n        while c >= ord('0') and c <= ord('9'):\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n            if self.isSpaceChar(c):\n                return res * sgn\n        \n        raise Exception(\"Input mismatch\")\n\n    def next(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        \n        result = bytearray()\n        result.append(c)\n        \n        while not self.isSpaceChar(c = self.read()):\n            result.append(c)\n        \n        return result.decode('ascii')\n\n    @staticmethod\n    def isSpaceChar(c):\n        return c in (32, 10, 13, 9, -1)\n\n\nclass OutputWriter:\n    def __init__(self, outputStream):\n        self.writer = outputStream\n\n    def close(self):\n        pass\n\n    def println(self, i):\n        self.writer.write(str(i) + '\\n')\n\n\nclass TaskC:\n    def __init__(self):\n        self.cv = 0\n        self.ck = 0\n        self.cs = 0\n        self.freq = None\n        self.pos = None\n        self.dp = None\n\n    def solve(self, testNumber, in_reader, out_writer):\n        n = in_reader.nextInt()\n        c_str = in_reader.next()\n        c = list(c_str)\n        \n        self.cv = 0\n        self.ck = 0\n        self.cs = 0\n        self.freq = [[0]*3 for _ in range(n + 1)]\n        self.pos = [[] for _ in range(3)]\n        \n        idx = 0\n        for x in c:\n            self.freq[idx + 1] = self.freq[idx][:]\n            idx += 1\n            if x == 'V':\n                self.freq[idx][0] += 1\n                self.cv += 1\n                self.pos[0].append(idx)\n            elif x == 'K':\n                self.freq[idx][1] += 1\n                self.ck += 1\n                self.pos[1].append(idx)\n            else:\n                self.freq[idx][2] += 1\n                self.cs += 1\n                self.pos[2].append(idx)\n        \n        self.dp = [[[[ -1 for _ in range(3)] for _ in range(self.cs + 1)] for _ in range(self.ck + 1)] for _ in range(self.cv + 1)]\n        \n        result = self.dfs(0, 0, 0, 2)\n        out_writer.println(result)\n\n    def dfs(self, tv, tk, ts, last):\n        if tv == self.cv and tk == self.ck and ts == self.cs:\n            return 0\n        \n        if self.dp[tv][tk][ts][last] != -1:\n            return self.dp[tv][tk][ts][last]\n        \n        ret = 1 << 29\n        \n        if tv < self.cv:\n            p = self.pos[0][tv]\n            move = max(self.freq[p][0] - tv, 0) + max(self.freq[p][1] - tk, 0) + max(self.freq[p][2] - ts, 0) - 1\n            ret = min(ret, self.dfs(tv + 1, tk, ts, 0) + move)\n        \n        if tk < self.ck and last != 0:\n            p = self.pos[1][tk]\n            move = max(self.freq[p][0] - tv, 0) + max(self.freq[p][1] - tk, 0) + max(self.freq[p][2] - ts, 0) - 1\n            ret = min(ret, self.dfs(tv, tk + 1, ts, 1) + move)\n        \n        if ts < self.cs:\n            p = self.pos[2][ts]\n            move = max(self.freq[p][0] - tv, 0) + max(self.freq[p][1] - tk, 0) + max(self.freq[p][2] - ts, 0) - 1\n            ret = min(ret, self.dfs(tv, tk, ts + 1, 2) + move)\n        \n        self.dp[tv][tk][ts][last] = ret\n        return ret\n\n\ndef main():\n    inputStream = sys.stdin\n    outputStream = sys.stdout\n    in_reader = InputReader(inputStream.buffer)\n    out_writer = OutputWriter(outputStream.buffer)\n    solver = TaskC()\n    solver.solve(1, in_reader, out_writer)\n    out_writer.close()\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.961580220377073e-05, -2.861018856492592e-06, -3.576278118089249e-07, -0.000285227142740041, -0.003150858450680971, -0.016118809580802917, -0.25199222564697266, -0.5323423147201538, -1.1920928244535389e-07, -0.014171676710247993, -0.06203416734933853, -0.2812827527523041, -0.131191685795784, -8.344646857949556e-07, -2.980