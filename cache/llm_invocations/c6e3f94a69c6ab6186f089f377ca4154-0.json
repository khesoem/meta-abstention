ec lInt = c.add(unitDir.scale(d1).add(unitDir.rot90().scale(h)));\n        return { rInt, lInt };\n    }\n};\n\nint main() {\n    int n;\n    cin >> n;\n    vector<Circle> circ;\n    circ.reserve(n);\n    for (int i = 0; i < n; ++i) {\n        double x, y, r;\n        cin >> x >> y >> r;\n        circ.emplace_back(Vec(x, y), r);\n    }\n\n    vector<Vec> points;\n    int par[n];\n    iota(par, par + n, 0);\n    int res = 1;\n\n    for (int i = 0; i < n; ++i) {\n        vector<Vec> points2;\n        for (int j = 0; j < n; ++j) {\n            if (i == j) continue;\n            vector<Vec> arr = circ[i].intersect(circ[j]);\n            if (arr.empty()) continue;\n\n            par[i] = par[par[i]];\n            int a = par[i];\n            par[j] = par[par[j]];\n            int b = par[j];\n            par[a] = b;\n\n            for (const Vec& e : arr) {\n                bool dup = false;\n                for (const Vec& e2 : points2) {\n                    if (e == e2) { dup = true; break; }\n                }\n                if (!dup) points2.push_back(e);\n            }\n        }\n\n        res += (int)points2.size();\n        for (const Vec& e : points2) {\n            bool dup = false;\n            for (const Vec& e2 : points) {\n                if (e == e2) { dup = true; break; }\n            }\n            if (!dup) points.push_back(e);\n        }\n    }\n\n    res -= (int)points.size();\n\n    int compCnt = 0;\n    for (int i = 0; i < n; ++i) {\n        if (i == par[i]) compCnt++;\n    }\n    res += compCnt;\n\n    cout << res << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.04916901886463165, -4.446407547220588e-05, -1.1920928244535389e-07, -8.344646857949556e-07, -0.001359015703201294, -0.0006136203301139176, -3.2186455882765586e-06, -0.0015392372151836753, -5.8410845667822286e-05, 0.0, -1.1920928244535389e-07, -0.0023258081637322903, -1.5497195136049413e-06, -1.1920928244535389e-07, 0.0, -0.69687044