0][take100 - cur100]) % MOD\n                    next_state = encode(1, take50, take100)\n                    update(next_state, state, comb, q)\n\ndef update(next_state, prev_state, comb, q):\n    new_depth = states[prev_state].d + 1\n    if next_state not in states:\n        states[next_state] = State(new_depth, 0)\n        q.append(next_state)\n    if states[next_state].d == new_depth:\n        new_ways = (states[next_state].w + states[prev_state].w * comb % MOD) % MOD\n        states[next_state].w = new_ways\n\ndef main():\n    global n, k, cnt50, cnt100\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    n = int(data[0])\n    k = int(data[1])\n    cnt50 = 0\n    cnt100 = 0\n    \n    idx = 2\n    for i in range(n):\n        w = int(data[idx])\n        idx += 1\n        if w == 50:\n            cnt50 += 1\n        else:\n            cnt100 += 1\n    \n    init()\n    start = encode(1, cnt50, cnt100)\n    q = deque()\n    q.append(start)\n    states[start] = State(0, 1)\n    \n    while q:\n        cur = q.popleft()\n        expand(cur, q, cnt50, cnt100)\n    \n    final_state = states.get(0)\n    if final_state is not None:\n        print(f\"{final_state.d}\\n{final_state.w}\")\n    else:\n        print(\"-1\\n0\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.113947918289341e-05, -8.344646857949556e-07, -2.3841855067985307e-07, -0.08915461599826813, -0.05968621373176575, -2.622600959512056e-06, -4.160317621426657e-05, -0.00011920218821614981, -3.576278118089249e-07, -0.002499791095033288, -0.16033540666103363, -0.00033539868309162557, -2.5033637939486653e-05, -0.09617625921964645, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -3.576278118089249e-07, -9.667406266089529e-05, 0.0, -1.5497195136049413e-06, 0.0, -4.768370445162873e-07, 0.0, 0.0, -1.1920928244535389e-07, -0.47408032417297363, -0.0062206219881772995, -1.311301275563892e-06, -0.0004389514