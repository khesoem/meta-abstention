{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.util.*;\n\npublic class GregAndFriends {\n    static int n, k, cnt50 = 0, cnt100 = 0;\n    static final long MOD = 1000000007L;\n    static long[][] C = new long[100][100];\n    static Queue<Integer> q = new LinkedList<>();\n    static Map<Integer, State> states = new HashMap<>();\n\n    static class State {\n        int d;\n        long w;\n\n        State(int depth, long weight) {\n            d = depth;\n            w = weight;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        k = sc.nextInt();\n        for (int i = 0; i < n; i++) {\n            int w = sc.nextInt();\n            if (w == 50) cnt50++;\n            else cnt100++;\n        }\n        sc.close();\n\n        init();\n        int start = encode(1, cnt50, cnt100);\n        q.offer(start);\n        states.put(start, new State(0, 1));\n\n        while (!q.isEmpty()) {\n            int cur = q.poll();\n            expand(cur);\n        }\n\n        State finalState = states.get(0);\n        if (finalState != null) {\n            System.out.println(finalState.d + \"\\n\" + finalState.w);\n        } else {\n            System.out.println(\"-1\\n0\");\n        }\n    }\n\n    static void expand(int state) {\n        int boat = state / 1000000;\n        int cur50 = (state % 1000000) / 100;\n        int cur100 = state % 100;\n\n        if (boat == 1) {\n            for (int take50 = cur50; take50 >= 0 && 50 * (cur50 - take50) <= k; take50--) {\n                for (int take100 = cur100; take100 >= 0 && 50 * (cur50 - take50) + 100 * (cur100 - take100) <= k; take100--) {\n                    if (take50 != cur50 || take100 != cur100) {\n                        long comb = (C[cur50][take50] * C[cur100][take100]) % MOD;\n                        int next = encode(0, take50, take100);\n                        update(next, state, comb);\n                    }\n                }\n            }\n        } else {\n            for (int take50 = cur50; take50 <= cnt50 && 50 * (take50 - cur50) <= k; take50++) {\n                for (int take100 = cur100; take100 <= cnt100 && 50 * (take50 - cur50) + 100 * (take100 - cur100) <= k; take100++) {\n                    if (take50 != cur50 || take100 != cur100) {\n                        long comb = (C[cnt50 - cur50][take50 - cur50] * C[cnt100 - cur100][take100 - cur100]) % MOD;\n                        int next = encode(1, take50, take100);\n                        update(next, state, comb);\n                    }\n                }\n            }\n        }\n    }\n\n    static void update(int next, int prev, long comb) {\n        int newDepth = states.get(prev).d + 1;\n        if (!states.containsKey(next)) {\n            states.put(next, new State(newDepth, 0));\n            q.offer(next);\n        }\n        if (states.get(next).d == newDepth) {\n            long newWays = (states.get(next).w + states.get(prev).w * comb % MOD) % MOD;\n            states.get(next).w = newWays;\n        }\n    }\n\n    static void init() {\n        for (int i = 0; i < 100; i++