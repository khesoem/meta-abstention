{0, s});\n\n        while (!pq.empty()) {\n            auto [du, u] = pq.top();\n            pq.pop();\n\n            if (done[u]) continue;\n            done[u] = 1;\n\n            for (const Edge &e : g[u]) {\n                int v = e.to;\n                if (!e.cap || done[v]) continue;\n\n                int nd = du + potential[u] + e.cost - potential[v];\n                if (dist[v] > nd) {\n                    dist[v] = nd;\n                    pq.push({nd, v});\n                }\n            }\n        }\n\n        return done[t];\n    };\n\n    function<bool(int,int)> buildLevel;\n    buildLevel = [&](int s, int t) -> bool {\n        fill(level.begin(), level.begin() + nodeCnt, 0);\n        queue<int> q;\n        q.push(s);\n        level[s] = 1;\n\n        while (!q.empty()) {\n            int u = q.front();\n            q.pop();\n\n            for (const Edge &e : g[u]) {\n                int v = e.to;\n                if (!e.cap || level[v]) continue;\n\n                if (dist[v] == dist[u] + e.cost - potential[v] + potential[u]) {\n                    level[v] = level[u] + 1;\n                    q.push(v);\n                }\n            }\n        }\n\n        return level[t] != 0;\n    };\n\n    function<int(int,int,int)> dfs;\n    dfs = [&](int u, int t, int f) -> int {\n        if (u == t) return f;\n\n        int sent = 0;\n        for (int &i = iterArr[u]; i < (int)g[u].size(); ++i) {\n            Edge &e = g[u][i];\n            int v = e.to;\n\n            if (!e.cap || level[v] != level[u] + 1) continue;\n            if (dist[v] != dist[u] + e.cost - potential[v] + potential[u]) continue;\n\n            int ret = dfs(v, t, min(f, e.cap));\n            if (ret) {\n                sent += ret;\n                f -= ret;\n                e.cap -= ret;\n                g[v][e.rev].cap += ret;\n                if (!f) break;\n            }\n        }\n\n        return sent;\n    };\n\n    auto minCostFlow = [&](int s, int t, int maxFlow) -> pair<