s\nimport heapq\nfrom collections import deque\n\nINF = 10**18\n\ndef main():\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    MAXN = 10001\n    g = [[] for _ in range(MAXN)]\n\n    nodeCnt = 0\n    def addNode(cnt):\n        nonlocal nodeCnt\n        while cnt > 0:\n            g[nodeCnt].clear()\n            nodeCnt += 1\n            cnt -= 1\n        return nodeCnt - 1\n\n    def addEdge(u, v, cap, cost):\n        g[u].append([v, len(g[v]), cap, cost])\n        g[v].append([u, len(g[u]) - 1, 0, -cost])\n\n    dist = [INF] * MAXN\n    potential = [0] * MAXN\n    level = [0] * MAXN\n    iterArr = [0] * MAXN\n    done = [False] * MAXN\n\n    def dijkstra(s, t):\n        for i in range(nodeCnt):\n            dist[i] = INF\n            done[i] = False\n        dist[s] = 0\n        pq = [(0, s)]\n        while pq:\n            du, u = heapq.heappop(pq)\n            if done[u]:\n                continue\n            done[u] = True\n            for e in g[u]:\n                v = e[0]\n                if e[2] == 0 or done[v]:\n                    continue\n                nd = du + potential[u] + e[3] - potential[v]\n                if dist[v] > nd:\n                    dist[v] = nd\n                    heapq.heappush(pq, (nd, v))\n        return done[t]\n\n    def buildLevel(s, t):\n        for i in range(nodeCnt):\n            level[i] = 0\n        q = deque()\n        q.append(s)\n        level[s] = 1\n        while q:\n            u = q.popleft()\n            for e in g[u]:\n                v = e[0]\n                if e[2] and level[v] == 0 and dist[v] == dist[u] + e[3] - potential[v] + potential[u]:\n                    level[v] = level[u] + 1\n                    q.append(v)\n        return level[t] != 0\n\n    sys.setrecursionlimit(1 << 25)\n    def dfs(u, t, f):\n        if u == t:\n            return f\n        sent = 0\n        i = iterArr[u]\n        while i < len(g[u]):\n            e = g[u][i]\n            v = e[0]\n            if e[2] and level[v] == level[u] + 1 and dist[v] == dist[u] + e[3] - potential[v] + potential[u]:\n                ret = dfs(v, t, min(f, e[2]))\n                if ret:\n                    sent += ret\n                    f -= ret\n                    e[2] -= ret\n                    g[v][e[1]][2] += ret\n                    if f == 0:\n                        break\n            i += 1\n            iterArr[u] = i\n        return sent\n\n    def minCostFlow(s, t, maxFlow):\n        flow = 0\n        cost = 0\n        for i in range(nodeCnt):\n            potential[i] = 0\n        while dijkstra(s, t):\n            phaseFlow = 0\n            while buildLevel(s, t):\n                for i in range(nodeCnt):\n                    iterArr[i] = 0\n                df = dfs(s, t, maxFlow)\n                maxFlow -= df\n                phaseFlow += df\n                if maxFlow == 0:\n                    break\n            flow += phaseFlow\n            cost += (dist[t] + potential[t]) * phaseFlow\n            for i in range(nodeCnt):\n                if dist[i] != INF:\n                    potential[i] += dist[i]\n            if maxFlow == 0:\n                break\n        return (flow, cost)\n\n    L = max(n, k) * 2\n    addNode(L * n)\n    s = addNode(1)\n    t = addNode(1)\n\n    # start nodes\n    for j in range(k):\n        a = int(next(it))\n        a -= 1\n        addEdge(s, a, 1, 0)\n\n    # original edges\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        u -= 1\n        v -= 1\n        for i in range(L - 1):\n            u1 = u + i * n\n            v1 = v + (i + 1) * n\n            u2 = u + (i + 1) * n\n            v2 = v + i * n\n            for j in range(k):\n                w = c + d * (2 * j + 1)\n                addEdge(u1, v1, 1, w)\n                addEdge(v2, u2, 1