            for (int i = 0; i < (1 << n); i++) {\n                BitSet tmp = (BitSet) s.clone();\n                for (int j = 0; j < (1 << n); j++) {\n                    if (!tmp.get(j)) {\n                        int x = i & j;\n                        while (x != 0) {\n                            int t = lowbit(x);\n                            if (s.get(j ^ (Integer.numberOfTrailingZeros(t)))) {\n                                tmp.set(j);\n                                break;\n                            }\n                            x -= t;\n                        }\n                    }\n                }\n                ch[currentId][i] = dfs(tmp, n);\n            }\n            return currentId;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n\n        State state = new State();\n        Map<BitSet, Integer> idMap = new HashMap<>();\n        state.idMap = idMap;\n        state.idCnt = 0;\n\n        int[][] a = new int[n][n];\n\n        // Initialize for dfs\n        BitSet startSet = new BitSet(n);\n        startSet.set(0, n);\n        int rootId = state.dfs(startSet, n);\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < n; j++) {\n                a[i][j] = sc.nextInt();\n                a[i][j] = mult(a[i][j], power(100, MOD - 2));\n            }\n        }\n\n        int[][] q = new int[n][1 << n];\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < (1 << n); j++) {\n                q[i][j] = 1;\n                for (int k = 0; k < n; k++) {\n                    if (((j >> k) & 1) != 0)\n                        q[i][j] = mult(q[i][j], a[i][k]);\n                    else\n                        q[i][j] = mult(q[i][j], dec(1, a[i][k]));\n                }\n            }\n        }\n\n        int idCount = state.idCnt;\n        int[][] ch = new int[idCount + 1][1 << n];\n\n        // Recompute ch for complete recursion\n        for (Map.Entry<BitSet, Integer> entry : idMap.entrySet()) {\n            BitSet s = entry.getKey();\n            int currentId = entry.getValue();\n            for (int i = 0; i < (1 << n); i++) {\n                BitSet tmp = (BitSet) s.clone();\n                for (int j = 0; j < (1 << n); j++) {\n                    if (!tmp.get(j)) {\n                        int x = i & j;\n                        while (x != 0) {\n                            int t = lowbit(x);\n                            int index = Integer.numberOfTrailingZeros(t);\n                            if (s.get(index))\n                                tmp.set(index);\n                            x -= t;\n                        }\n                    }\n                }\n                ch[currentId][i] = state.dfs(tmp, n);\n            }\n        }\n\n        int[][] dp = new int[n + 1][(int) Math.pow(2, n)];\n        // Initialize dp\n        for (int i = 0; i <= n; i++) {\n            Arrays.fill(dp[i], 0);\n        }\n        dp[0][1] = 1;\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j <= idCount; j++) {\n                for (int k = 0; k < (1 << n); k++) {\n                    int toState = ch[j][k];\n                    dp[i][toState] = add(dp[i][toState], mult(dp[i - 1][j], q[i - 1][k]));\n                }\n            }\n        }\n\n        BitSet fullSet = new BitSet(n);\n        fullSet.set(0, n);\n        int answer = dp[n][state.idMap.get(fullSet)];\n        System.out.println(answer);\n        sc.close();\n    }\n}", "token_logprobs": [-0.011730228550732136, -1.9361264946837764e-07, -0.0013844015775248408, -5.505050182342529, -2.522638169466518e-05, -7.896309739408025e-07, -0.004316060803830624, -0.014196290634572506, -0.0022468422539532185, -0.0006591808632947505, -0.003606482408940792, -0.0021852378267794847, -0.6326472163200378, -0.0006272526225075126, -1.0280383548888494e-06, -2.7968066206085496e-05, -3.547789674485102e-05, 0.0, -3.128