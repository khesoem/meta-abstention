atrix base = *this;\n        while (exponent) {\n            if (exponent & 1) result *= base;\n            base *= base;\n            exponent >>= 1;\n        }\n        return result;\n    }\n\n    void output() const {\n        for (int i = 0; i < dimension; ++i) {\n            for (int j = 0; j < dimension; ++j)\n                printf(\"%d \", (int)cells[i][j]);\n            printf(\"\\n\");\n        }\n        printf(\"\\n\");\n    }\n\n    ll* operator[](int index) { return cells[index]; }\n    const ll* operator[](int index) const { return cells[index]; }\n};\n\nint main() {\n#ifdef DBG1\n    freopen(\".in\", \"r\", stdin);\n    freopen(\".out\", \"w\", stdout);\n    freopen(\".err\", \"w\", stderr);\n#endif\n\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    ll input_n;\n    int input_k;\n    cin >> input_n >> input_k;\n\n    if (input_n <= input_k) {\n        cout << ((1LL << input_n) % MOD) << '\\n';\n        return 0;\n    }\n\n    int depth = static_cast<int>(log(input_n + 0.0) / log(input_k + 0.0) + 2);\n\n    Matrix T(input_k + 1, 1);\n    for (int j = 0; j < input_k; ++j) {\n        T[j][j] = 0;\n        T[(j + 1) % input_k][j] = 1;\n    }\n\n    vector<Matrix> pre(depth);\n    pre[0] = Matrix(input_k + 1, 1);\n    for (int i = 1; i <= input_k; ++i)\n        pre[0][0][i] = 1;\n\n    for (int i = 1; i < depth; ++i)\n        pre[i] = (pre[i - 1] * T).binary_exponentiation(input_k);\n\n    int power_index = 0;\n    ll segment_length = 1;\n    while (input_n / segment_length >= input_k) {\n        ++power_index;\n        segment_length *= input_k;\n    }\n\n    Matrix current(input_k + 1, 1);\n    ll leftover = input_n;\n    while (leftover > 0) {\n        if (segment_length <= leftover) {\n            int times = static_cast<int>(leftover / segment_length);\n            current *= (pre[power_index] * T).binary_exponentiation(times);\n            leftover -= segment_length * times;\n        }\n        --power_index;\n        segment_length 