nput_k = int(input_data[1])\n    \n    if input_n <= input_k:\n        result = pow(2, input_n, MOD)\n        print(result)\n        return\n    \n    depth = int(math.log(input_n + 0.0) / math.log(input_k + 0.0) + 2)\n    \n    T = Matrix(input_k + 1, 1)\n    for j in range(input_k):\n        T.cells[j][j] = 0\n        T.cells[(j + 1) % input_k][j] = 1\n    \n    pre = [None] * depth\n    pre[0] = Matrix(input_k + 1, 1)\n    for i in range(1, input_k + 1):\n        pre[0].cells[0][i] = 1\n    \n    for i in range(1, depth):\n        pre[i] = (pre[i - 1] * T).binary_exponentiation(input_k)\n    \n    power_index = 0\n    segment_length = 1\n    while input_n // segment_length >= input_k:\n        power_index += 1\n        segment_length *= input_k\n    \n    current = Matrix(input_k + 1, 1)\n    leftover = input_n\n    while leftover > 0:\n        if segment_length <= leftover:\n            times = leftover // segment_length\n            current = current * (pre[power_index] * T).binary_exponentiation(times)\n            leftover -= segment_length * times\n        power_index -= 1\n        segment_length //= input_k\n    \n    final_answer = 0\n    for i in range(input_k + 1):\n        final_answer = (final_answer + current[i][input_k]) % MOD\n    print(final_answer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001248043408850208, -8.344646857949556e-07, -2.3841855067985307e-07, -0.0009457168052904308, -0.3485565483570099, -0.06997324526309967, -0.014464288018643856, -0.00040665941196493804, -0.0005000770906917751, -0.00029762129997834563, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, 0.0, -0.008635086007416248, 0.0, -4.291525328881107e-06, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -3.576278118089249e-07, -0.007609784137457609, -0.0001597276859683916, -1.3947389561508317e-05, -1.311301275563892e-06, -2.622600959512056e-06, -0.07008939236402512, -4.529942543740617e-06, 0.0, 0.0, -1.3