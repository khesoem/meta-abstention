OException {\n            int[] arr = new int[n];\n            for (int i = 0; i < n; i++) arr[i] = nextInt();\n            return arr;\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        FastInput in = new FastInput();\n        int n = in.nextInt();\n        int budget = in.nextInt();\n        int[] arr = in.nextIntArray(n);\n\n        int[] odd = new int[n + 1];\n        int[] even = new int[n + 1];\n\n        for (int i = 1; i <= n; i++) {\n            odd[i] = odd[i - 1] + (arr[i - 1] & 1);\n            even[i] = even[i - 1] + ((arr[i - 1] & 1) ^ 1);\n        }\n\n        int last = 0;\n        PriorityQueue<Integer> costs = new PriorityQueue<>();\n        for (int i = 1; i < n; i++) {\n            int o = odd[i] - odd[last];\n            int e = even[i] - even[last];\n            if (o == e) {\n                costs.add(Math.abs(arr[i] - arr[i - 1]));\n                last = i;\n            }\n        }\n\n        int total = 0;\n        int k = 0;\n        while (!costs.isEmpty() && total <= budget) {\n            total += costs.poll();\n            k++;\n        }\n\n        if (k == 0) {\n            System.out.println(0);\n        } else {\n            System.out.println(costs.isEmpty() && total <= budget ? k : k - 1);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass FastInput:\n    def __init__(self, stream=sys.stdin):\n        self.buffer = bytearray(1 << 16)\n        self.ptr = 0\n        self.len = 0\n        self.stream = stream\n\n    def fill_buffer(self):\n        self.ptr = 0\n        data = self.stream.read(1 << 16)\n        self.len = len(data)\n        if self.len > 0:\n            self.buffer = data\n\n    def read(self):\n        if self.ptr >= self.len:\n            self.fill_buffer()\n        if self.ptr >= self.len:\n            return -1\n        val = self.buffer[self.ptr]\n        self.ptr += 1\n        return val\n\n    def skip(self):\n        c = self.read()\n        while c <= 32 and c != -1:\n            c = self.read()\n        return c\n\n    def next_int(self):\n        c = self.skip()\n        sign = 1\n        if c == ord('-'):\n            sign = -1\n            c = self.read()\n        val = 0\n        while c > ord(' '):\n            val = val * 10 + (c - ord('0'))\n            c = self.read()\n        return val * sign\n\n    def next_int_array(self, n):\n        return [self.next_int() for _ in range(n)]\n\ndef main():\n    in_stream = FastInput()\n    n = in_stream.next_int()\n    budget = in_stream.next_int()\n    arr = in_stream.next_int_array(n)\n\n    odd = [0] * (n + 1)\n    even = [0] * (n + 1)\n\n    for i in range(1, n + 1):\n        odd[i] = odd[i - 1] + (arr[i - 1] & 1)\n        even[i] = even[i - 1] + ((arr[i - 1] & 1) ^ 1)\n\n    last = 0\n    costs = []\n    for i in range(1, n):\n        o = odd[i] - odd[last]\n        e = even[i] - even[last]\n        if o == e:\n            heapq.heappush(costs, abs(arr[i] - arr[i - 1]))\n            last = i\n\n    total = 0\n    k = 0\n    while costs and total <= budget:\n        total += heapq.heappop(costs)\n        k += 1\n\n    if k == 0:\n        print(0)\n    else:\n        if not costs and total <= budget:\n            print(k)\n        else:\n            print(k - 1)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.471556869451888e-05, -1.7881377516459906e-06, -2.3841855067985307e-07, -9.775113539944869e-06, -0.05476731061935425, -4.100715523236431e-05, -0.001327467616647482, -0.16120074689388275, -0.003643661504611373, -0.02054411917924881, -2.038458114839159e-05, -5.364403477869928e-06, -1.4305104514278355e-06, -4.053033626405522e-05, -1.6689286894688848e-06, -6.556489552167477e-06, -4.768370445162873e-07, 0.0, -8.344646857949556e-07, -0.03364