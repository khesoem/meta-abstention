atic MinCostMaxFlow mcmf = new MinCostMaxFlow();\n    static int[] a = new int[200005];\n    static int[][] node_id = new int[55][2500];\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        for (int i = 1; i <= k; ++i) {\n            a[i] = sc.nextInt();\n        }\n\n        mcmf.init(50 * 50 * 4 + 10);\n        int source = mcmf.nodes - 2;\n        int sink = mcmf.nodes - 3;\n\n        int counter = 0;\n        int max_level = 100;\n\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 0; j <= max_level; ++j) {\n                node_id[i][j] = ++counter;\n            }\n        }\n\n        for (int i = 1; i <= m; ++i) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int level = 0; level < max_level; ++level) {\n                for (int step = 1; step <= k; ++step) {\n                    int delta = step * step * d - (step - 1) * (step - 1) * d;\n                    mcmf.add_bidirectional(node_id[u][level], node_id[v][level + 1], 1, c + delta);\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; ++i) {\n            for (int level = 0; level < max_level; ++level) {\n                mcmf.add_bidirectional(node_id[i][level], node_id[i][level + 1], Integer.MAX_VALUE, c);\n            }\n        }\n\n        for (int i = 1; i <= k; ++i) {\n            mcmf.add_bidirectional(source, node_id[a[i]][0], 1, 0);\n        }\n\n        for (int level = 1; level <= max_level; ++level) {\n            mcmf.add_bidirectional(node_id[1][level], sink, Integer.MAX_VALUE, 0);\n        }\n\n        int[] result = mcmf.compute(source, sink);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00016878610767889768, -2.74