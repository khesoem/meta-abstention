nt[1<<7];\n    static long[][] dp = new long[1<<20][2];\n    static long odw;\n    \n    static long powMod(long a, long w) {\n        if(w == 0) return 1;\n        long b = powMod(a, w/2);\n        b = b*b % MOD;\n        if((w & 1) == 1) b = b*a % MOD;\n        return b;\n    }\n    \n    static int daj(boolean f) {\n        // all 6 permutations of {1,2,3}\n        // we'll iterate using an index variable\n        int mask = 0;\n        for(int p=0; p<6; p++) {\n            int[] s = new int[3];\n            s[0] = ziom_perm[p*3];\n            s[1] = ziom_perm[p*3+1];\n            s[2] = ziom_perm[p*3+2];\n            for(int i=1; i<=6; i++)\n                for(int j=i+1; j<=6; j++)\n                    for(int k=j+1; k<=6; k++) {\n                        if(elo[i][s[0] + (f?3:0)] != 0 &&\n                           elo[j][s[1] + (f?3:0)] != 0 &&\n                           elo[k][s[2] + (f?3:0)] != 0) {\n                            int tmask = ((f ? 126 : 0) ^ ((1<<i) + (1<<j) + (1<<k)));\n                            mask |= maska[tmask];\n                        }\n                    }\n        }\n        return mask;\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int[][] tab = new int[7][7];\n        for(int i=1; i<=n; i++)\n            for(int j=1; j<=n; j++)\n                tab[i][j] = sc.nextInt();\n        for(int i=n+1; i<=6; i++)\n            tab[i][i] = 100;\n        // precompute maska for all triples of vertices 1..6\n        int xd = 0;\n        for(int i=1; i<=6; i++)\n            for(int j=i+1; j<=6; j++)\n                for(int k=j+1; k<=6; k++) {\n                    int idx = (1<<i) ^ (1<<j) ^ (1<<k);\n                    maska[idx] = (1<<xd);\n                    xd++;\n                }\n        // build kraw list of all pairs (i,j) for 1..6\n        List<int[]> kraw = new ArrayList<>();\n        for(int i=1; i<=6; i++)\n            for(int j=1; j<=6; j++)\n                kraw.add(new int[]{i,j});\n        odw = powMod(100, MOD-2);\n        \n        // dp computation\n        for(int k=0; k<2; k++) {\n            for(int i=0; i<(1<<18); i++) {\n                long p = 1;\n                // clear elo\n                for(int a=1; a<=6; a++) Arrays.fill(elo[a], 0);\n                for(int j=0; j<18; j++) {\n                    int[] edge = kraw.get(j + k*18);\n                    int winner = edge[0];\n                    int loser = edge[1];\n                    if(((1<<j) & i) != 0) {\n                        // edge exists\n                        p = p * tab[winner][loser] % MOD * odw % MOD;\n                        elo[loser][winner] = 1;\n                    } else {\n                        p = p * (100 - tab[winner][loser]) % MOD * odw % MOD;\n                        elo[loser][winner] = 0;\n                    }\n                }\n                int cur = daj(k==1);\n                dp[cur][k] = (dp[cur][k] + p) % MOD;\n            }\n        }\n        \n        // SOS DP over dp[..][0]\n        for(int bit=0; bit<20; bit++) {\n            for(int mask=0; mask<(1<<20); mask++) {\n                if((mask & (1<<bit)) != 0) {\n                    dp[mask][0] = (dp[mask][0] + dp[mask ^ (1<<bit)][0]) % MOD;\n                }\n            }\n        }\n        \n        long res = 1;\n        int fullMask = (1<<20)-1;\n        for(int i=0; i<(1<<20); i++) {\n            res = (res - dp[i][0] * dp[fullMask ^ i][1]) % MOD;\n        }\n        res = (res + MOD) % MOD;\n        System.out.println(res);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.38956430554389954, -3.182837463100441e-05, 0.0, -2.3841855067985307e-07, -0.0003364712174516171, -0.008677158504724503, -9.536738616588991e-07, -3.0517112463712692e-05, -0.016460690647363663, -7.60526381782256e-05, -1.1920928244535389e-07, -0.01632477343082428, -0.03808238357305527, -0.00016497205069754273, -0.00