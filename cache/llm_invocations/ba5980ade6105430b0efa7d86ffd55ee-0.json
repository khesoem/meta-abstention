sult\n\n    def readInt(self):\n        c = self.read()\n        while self.isSpaceChar(c):\n            c = self.read()\n        sgn = 1\n        if c == ord('-'):\n            sgn = -1\n            c = self.read()\n        res = 0\n        while not self.isSpaceChar(c):\n            if c < ord('0') or c > ord('9'):\n                raise Exception(\"InputMismatchException\")\n            res *= 10\n            res += c - ord('0')\n            c = self.read()\n        return res * sgn\n\n    def isSpaceChar(self, c):\n        return self.isWhitespace(c)\n\n    @staticmethod\n    def isWhitespace(c):\n        return c == ord(' ') or c == ord('\\n') or c == ord('\\r') or c == ord('\\t') or c == -1\n\nclass ArrayUtils:\n    @staticmethod\n    def fill_2d(array, value):\n        for row in array:\n            for i in range(len(row)):\n                row[i] = value\n\n    @staticmethod\n    def fill_3d(array, value):\n        for subArray in array:\n            ArrayUtils.fill_2d(subArray, value)\n\nclass BLittleCLoves3II:\n    def __init__(self):\n        self.answer = None\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_reader, out_writer):\n        self.n = in_reader.readInt()\n        self.m = in_reader.readInt()\n        if self.n > self.m:\n            self.n, self.m = self.m, self.n\n        if self.n == 1:\n            x = self.m % 6\n            if x <= 3:\n                out_writer.printLine(self.m - x)\n                return\n            if x == 4:\n                out_writer.printLine(self.m - 2)\n                return\n            out_writer.printLine(self.m - 1)\n            return\n        if self.n <= 5 and self.m <= 30:\n            self.answer = [[[-1 for _ in range(1 << (3 * self.n))] for _ in range(int(self.n) + 1)] for _ in range(int(self.m) + 1)]\n            ArrayUtils.fill_3d(self.answer, -1)\n            out_writer.printLine(self.go(0, 0, 0))\n            return\n        out_writer.printLine(self.n * self.m - (self.n * self.m) % 2)\n\n    def go(self, row, col, mask):\n        if self.answer[row][col][mask] != -1:\n            return self.answer[row][col][mask]\n        if row == self.m:\n            self.answer[row][col][mask] = 0 if mask == 0 else float('-inf')\n            return self.answer[row][col][mask]\n        if col == self.n:\n            self.answer[row][col][mask] = self.go(row + 1, 0, mask)\n            return self.answer[row][col][mask]\n        if (mask & 1) == 1:\n            self.answer[row][col][mask] = self.go(row, col + 1, mask >> 1)\n            return self.answer[row][col][mask]\n        best = self.go(row, col + 1, mask >> 1)\n        self.answer[row][col][mask] = best\n        best = max(self.go(row, col + 1, (mask >> 1) + (1 << (3 * self.n - 1))) + 2, best)\n        if col != 0 and ((mask >> (2 * self.n - 1)) & 1) == 0:\n            best = max(best, self.go(row, col + 1, (mask >> 1) + (1 << (2 * self.n - 2))) + 2)\n        if col != self.n - 1 and ((mask >> (2 * self.n + 1)) & 1) == 0:\n            best = max(best, self.go(row, col + 1, (mask >> 1) + (1 << (2 * self.n))) + 2)\n        if col >= 2 and ((mask >> (self.n - 2)) & 1) == 0:\n            best = max(best, self.go(row, col + 1, (mask >> 1) + (1 << (self.n - 3))) + 2)\n        if col < self.n - 1 and ((mask >> (self.n + 2)) & 1) == 0:\n            best = max(best, self.go(row, col + 1, (mask >> 1) + (1 << (self.n + 1))) + 2)\n        self.answer[row][col][mask] = best\n        return best\n\ndef main():\n    solver = BLittleCLoves3II()\n    in_reader = InputReader(sys.stdin.buffer)\n    out_writer = OutputWriter(sys.stdout)\n    solver.solve(1, in_reader, out_writer)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.890059739816934e-05, -1.7881377516459906e-06, -3.576278118089249e-07, -8.356221951544285e-05, -0.0028097457252442837, -0.1604488343000412, -0.16042719781398773, -0.35389718413352966, -0.04894314706325531, 