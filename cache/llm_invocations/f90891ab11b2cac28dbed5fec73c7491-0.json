 - x][n - j];\n                dfs_partb(x - 1, cnta, cntb - 1, sum + tmp);\n            }\n        }\n    }\n}\n\nunordered_map<LL, LL> parta[maxn + 5][maxn + 5];\nLL ans = LLONG_MAX, ans_cnt = 0;\n\nvoid update(const LL &val, const LL &cnt) {\n    if (val < ans) { ans = val; ans_cnt = cnt; }\n    else if (val == ans) ans_cnt += cnt;\n}\n\nvoid bfs_parta() {\n    for (int i = 0; i <= n + m; ++i)\n        for (int j = 0; j <= n + m; ++j)\n            parta[i][j].clear();\n    parta[0][0][0] = 1;\n    for (int i = 0; i <= n + m; ++i) {\n        for (int j = 0; j <= n + m; ++j) {\n            for (auto &u : parta[i][j]) {\n                if (i + j == mid) {\n                    auto it = lower_bound(partb[i][j].begin(), partb[i][j].end(), make_pair(-u.first, -1));\n                    if (it != partb[i][j].end())\n                        update(abs(u.first + it->first), u.second * it->second);\n                    if (it != partb[i][j].begin()) {\n                        --it;\n                        update(abs(u.first + it->first), u.second * it->second);\n                    }\n                } else {\n                    int p = i + j;\n                    for (int k = 0; k < 2; ++k) {\n                        if (~g[p] && k != g[p]) continue;\n                        int cnta = i, cntb = j;\n                        if (k == 0) ++cnta;\n                        else ++cntb;\n                        if (cnta <= n + m && cntb <= n + m) {\n                            LL tmp = 0;\n                            if (k == 0) {\n                                for (int l = 0; l < n; ++l)\n                                    tmp += C[cnta - 1][n - 1] * C[cntb][l] * C[N - p - 1][n - l];\n                            } else {\n                                for (int l = 0; l < n; ++l)\n                                    tmp -= C[cntb - 1][n - 1] * C[cnta][l] * C[N - p - 1][n - l];\n                            }\n                            parta[cnta][cntb][u.first + tmp] +=