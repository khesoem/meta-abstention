nstring arrToString(const vector<int>& x) {\n    ostringstream oss;\n    oss << \"[\";\n    for (size_t i = 0; i < x.size(); ++i) {\n        if (i > 0) oss << \", \";\n        oss << x[i];\n    }\n    oss << \"]\";\n    return oss.str();\n}\n\nstring arrToString(const vector<long long>& x) {\n    ostringstream oss;\n    oss << \"[\";\n    for (size_t i = 0; i < x.size(); ++i) {\n        if (i > 0) oss << \", \";\n        oss << x[i];\n    }\n    oss << \"]\";\n    return oss.str();\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    MScanner sc(cin);\n    \n    fac.resize(200001);\n    fac[0] = 1;\n    for (int i = 1; i < fac.size(); i++) {\n        fac[i] = (fac[i - 1] * i) % MOD;\n    }\n\n    int n = sc.nextInt();\n    long long k = sc.nextLong();\n\n    if (k >= n) {\n        cout << 0 << endl;\n        return 0;\n    }\n    if (k == 0) {\n        cout << fac[n] << endl;\n        return 0;\n    }\n    if (k == n - 1) {\n        cout << 2 * n << endl;\n        return 0;\n    }\n\n    int filledCols = n - k;\n    long long waysToChooseFilledCols = ncr(n, filledCols);\n\n    long long ans = 0;\n\n    for (int emptyCols = 0; emptyCols <= filledCols; emptyCols++) {\n        long long waysToChoose = ncr(filledCols, emptyCols);\n        long long waysToFill = fastpow(filledCols - emptyCols, n);\n        long long val = (waysToChoose * waysToFill) % MOD;\n\n        if (emptyCols % 2 == 1) {\n            val = (MOD - val) % MOD;\n        }\n        ans = (ans + val) % MOD;\n    }\n\n    ans = (ans * waysToChooseFilledCols) % MOD;\n    ans = (ans * 2) % MOD;\n\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.56950321374461e-05, -7.629365427419543e-06, -1.1920922133867862e-06, -0.00029905137489549816, -7.152555099310121e-07, -0.0024827865418046713, -1.0728830375228426e-06, -1.2874520507466514e-05, -2.264974000354414e-06, -0.05410575494170189, -4.768360213347478e-