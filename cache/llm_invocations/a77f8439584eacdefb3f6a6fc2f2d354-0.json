{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 8 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 8 code you have to translate:\n<original_code>\nimport java.io.*;\nimport java.util.*;\nimport java.util.stream.IntStream;\n\npublic class Main {\n    public static void main(String[] args) {\n        InputReader in = new InputReader(System.in);\n        PrintWriter out = new PrintWriter(System.out);\n        new Solver().solve(in, out);\n        out.close();\n    }\n\n    static class Solver {\n        void solve(InputReader in, PrintWriter out) {\n            int n = in.nextInt();\n            int m = in.nextInt();\n            Comb mod = new Comb(n + m);\n\n            long phaseSize = 1;\n            long p = 1;\n            for (int i = 0; p != 0; i++) {\n                p = mod.mult(p, n - i, mod.smallInv(n + m - i));\n                phaseSize = mod.add(phaseSize, p);\n            }\n\n            long[] answer = {0};\n            IntStream.rangeClosed(1, n).forEach(k -> {\n                long term = mod.mult(mod.ncr(n, k), m + k, mod.smallInv(k), phaseSize);\n                answer[0] = (k & 1) == 1 ? mod.add(answer[0], term) : mod.subtract(answer[0], term);\n            });\n\n            out.println(answer[0]);\n        }\n    }\n\n    static class Comb {\n        final long MOD = 998244353L;\n        long[] factArr;\n        long[] invFactArr;\n\n        Comb(int max) {\n            if (max < 0) throw new ArrayIndexOutOfBoundsException(max);\n            factArr = new long[max + 1];\n            invFactArr = new long[max + 1];\n            factArr[0] = 1;\n            for (int i = 1; i <= max; i++) {\n                factArr[i] = factArr[i - 1] * i % MOD;\n            }\n            invFactArr[max] = inv(factArr[max]);\n            for (int i = max; i >= 1; i--) {\n                invFactArr[i - 1] = invFactArr[i] * i % MOD;\n            }\n        }\n\n        long fact(int n) {\n            return factArr[n];\n        }\n\n        long fInv(int n) {\n            return invFactArr[n];\n        }\n\n        long ncr(int n, int r) {\n            if (r < 0 || n < r) return 0;\n            return mult(fact(n), fInv(r), fInv(n - r));\n        }\n\n        long smallInv(int n) {\n            return mult(fInv(n), fact(n - 1));\n        }\n\n        long add(long a, long b) {\n            long v = a + b;\n            return v < MOD ? v : v - MOD;\n        }\n\n        long subtract(long a, long b) {\n            long v = a - b;\n            return v < 0 ? v + MOD : v;\n        }\n\n        long mult(long... values) {\n            long r = 1;\n            for (long value : values) {\n                r = (r * value) % MOD;\n            }\n            return r;\n        }\n\n        long inv(long value) {\n            long g = MOD, x = 0, y = 1;\n            for (long r = value; r != 0; ) {\n                long q = g / r;\n                g %= r;\n                long temp = g;\n                g = r;\n                r = temp;\n                x -= q * y;\n                temp = x;\n                x = y;\n                y = temp;\n            }\n            if (g != 1) throw new AssertionError();\n            if (y != MOD && y != -MOD) throw new AssertionError();\n            long v = x % MOD;\n            if (v < 0) v += MOD;\n            return v;\n        }\n    }\n\n    static class InputReader {\n        public final BufferedReader reader;\n        public StringTokenizer tokenizer;\n\n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream), 32768);\n            tokenizer = null;\n        }\n\n        public String next() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <cstdio>\n#include <cstdlib>\n#include <cstring>\n#include <algorithm>\n#include <vector>\n#include <iostream>\n#include <string>\n#include <sstream>\n#include <cassert>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst ll MOD = 998244353LL;\n\nstruct Comb {\n    vector<ll> factArr;\n    vector<ll> invFactArr;\n\n    Comb(int max) {\n        if (max < 0) {\n            fprintf(stderr, \"ArrayIndexOutOfBoundsException: %d\\n\", max);\n            exit(1);\n        }\n        factArr.resize(max + 1);\n        invFactArr.resize(max + 1);\n        factArr[0] = 1;\n        for (int i = 1; i <= max; i++) {\n            factArr[i] = factArr[i - 1] * i % MOD;\n        }\n        invFactArr[max] = inv(factArr[max]);\n        for (int i = max; i >= 1; i--) {\n            invFactArr[i - 1] = invFactArr[i] * i % MOD;\n        }\n    }\n\n    ll fact(int n) {\n        return factArr[n];\n    }\n\n    ll fInv(int n) {\n        return invFactArr[n];\n    }\n\n    ll ncr(int n, int r) {\n        if (r < 0 || n < r) return 0;\n        return mult(fact(n), fInv(r), fInv(n - r));\n    }\n\n    ll smallInv(int n) {\n        return mult(fInv(n), fact(n - 1));\n    }\n\n    ll add(ll a, ll b) {\n        ll v = a + b;\n        return v < MOD ? v : v - MOD;\n    }\n\n    ll subtract(ll a, ll b) {\n        ll v = a - b;\n        return v < 0 ? v + MOD : v;\n    }\n\n    ll mult(ll a, ll b) {\n        return (a * b) % MOD;\n    }\n\n    ll mult(ll a, ll b, ll c) {\n        return mult(mult(a, b), c);\n    }\n\n    ll mult(ll a, ll b, ll c, ll d) {\n        return mult(mult(a, b, c), d);\n    }\n\n    ll inv(ll value) {\n        ll g = MOD, x = 0, y = 1;\n        for (ll r = value; r != 0; ) {\n            ll q = g / r;\n            g %= r;\n            ll temp = g;\n            g = r;\n            r = temp;\n            x -= q * y;\n            temp = x;\n            x = y;\n            y = temp;\n        }\n        if (g != 1) {\n            fprintf(stderr, \"AssertionError: inverse does not exist\\n\");\n            exit(1);\n        }\n        if (y != MOD && y != -MOD) {\n            fprintf(stderr, \"AssertionError: unexpected y\\n\");\n            exit(1);\n        }\n        ll v = x % MOD;\n        if (v < 0) v += MOD;\n        return v;\n    }\n};\n\nvoid solve() {\n    int n, m;\n    scanf(\"%d %d\", &n, &m);\n    Comb mod(n + m);\n\n    ll phaseSize = 1;\n    ll p = 1;\n    for (int i = 0; p != 0; i++) {\n        p = mod.mult(p, n - i, mod.smallInv(n + m - i));\n        phaseSize = mod.add(phaseSize, p);\n    }\n\n    ll answer = 0;\n    for (int k = 1; k <= n; k++) {\n        ll term = mod.mult(mod.ncr(n, k), m + k, mod.smallInv(k), phaseSize);\n        if (k & 1) {\n            answer = mod.add(answer, term);\n        } else {\n            answer = mod.subtract(answer, term);\n        }\n    }\n\n    printf(\"%lld\\n\", answer);\n}\n\nint main() {\n    solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\