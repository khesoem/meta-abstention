     flow = self.a[t]\n        cost = self.dis[t]\n\n        cur = t\n        while self.pre[cur] != -1:\n            self.edges[self.pre[cur]].flow += self.a[t]\n            self.edges[self.pre[cur] ^ 1].flow -= self.a[t]\n            cur = self.edges[self.pre[cur]].u\n\n        return True, flow, cost\n\n    def solve(self, s, t):\n        total_flow = 0\n        total_cost = 0\n\n        while True:\n            found, f, c = self.spfa(s, t)\n            if not found:\n                break\n            total_flow += f\n            total_cost += f * c\n\n        return total_flow, total_cost\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    C = int(data[idx]); idx += 1\n    D = int(data[idx]); idx += 1\n\n    g = MinCostFlow(n * MAXT + 2)\n    src = n * MAXT\n    dst = n * MAXT + 1\n\n    for t in range(MAXT):\n        g.add_edge(t, dst, k, C * t)\n\n    for i in range(k):\n        x = int(data[idx]); idx += 1\n        x -= 1\n        g.add_edge(src, x * MAXT, 1, 0)\n\n    for i in range(n):\n        for t in range(1, MAXT):\n            g.add_edge(i * MAXT + t - 1, i * MAXT + t, k, 0)\n\n    for _ in range(m):\n        u = int(data[idx]); idx += 1\n        v = int(data[idx]); idx += 1\n        u -= 1\n        v -= 1\n\n        for t in range(1, MAXT):\n            a = u * MAXT + t - 1\n            b = v * MAXT + t\n            c = v * MAXT + t - 1\n            d = u * MAXT + t\n\n            cc = D\n            for i in range(1, k + 1):\n                g.add_edge(a, b, 1, cc)\n                g.add_edge(c, d, 1, cc)\n                cc += 2 * D\n\n    result = g.solve(src, dst)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019500737835187465, -1.311301275563892e-06, -1.1920928244535389e-07, -0.030316103249788284, -0.0