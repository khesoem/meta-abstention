{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\nconst ll INF = 1000000007LL;\nconst int MAXN = 5005;\nconst int MAXT = 100;\n\nstruct Edge {\n    int u, v;\n    ll cap, flow, cost;\n};\n\nclass MinCostFlow {\npublic:\n    int n;\n    vector<int> G[MAXN];\n    vector<Edge> edges;\n    ll dis[MAXN];\n    bool inq[MAXN];\n    int pre[MAXN];\n    ll a[MAXN];\n\n    MinCostFlow(int nodes) : n(nodes) {}\n\n    void add_edge(int u, int v, ll cap, ll cost) {\n        edges.push_back({u, v, cap, 0LL, cost});\n        edges.push_back({v, u, 0LL, 0LL, -cost});\n        int idx = edges.size();\n        G[u].push_back(idx - 2);\n        G[v].push_back(idx - 1);\n    }\n\n    bool spfa(int s, int t, ll &flow, ll &cost) {\n        fill(dis, dis + n, INF);\n        fill(inq, inq + n, false);\n        dis[s] = 0;\n        inq[s] = true;\n        pre[s] = -1;\n        a[s] = INF;\n        queue<int> q;\n        q.push(s);\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n\n            for (int eid : G[u]) {\n                Edge &e = edges[eid];\n                if (e.cap > e.flow && dis[e.v] > dis[u] + e.cost) {\n                    dis[e.v] = dis[u] + e.cost;\n                    pre[e.v] = eid;\n                    a[e.v] = min(a[u], e.cap - e.flow);\n\n                    if (!inq[e.v]) {\n                        inq[e.v] = true;\n                        q.push(e.v);\n                    }\n                }\n            }\n        }\n\n        if (dis[t] == INF) return false;\n\n        flow = a[t];\n        cost = dis[t];\n\n        int cur = t;\n        while (pre[cur] != -1) {\n            edges[pre[cur]].flow += a[t];\n            edges[pre[cur] ^ 1].flow -= a[t];\n            cur = edges[pre[cur]].u;\n        }\n        return true;\n    }\n\n    pair<ll, ll> solve(int s, int t) {\n        ll total_flow = 0, total_cost = 0;\n        ll f, c;\n\n        while (spfa(s, t, f, c)) {\n            total_flow += f;\n            total_cost += f * c;\n        }\n\n        return make_pair(total_flow, total_cost);\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MinCostFlow g(n * MAXT + 2);\n    int src = n * MAXT, dst = n * MAXT + 1;\n\n    for (int t = 0; t < MAXT; ++t)\n        g.add_edge(t, dst, k, C * t);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        g.add_edge(src, x * MAXT, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int t = 1; t < MAXT; ++t)\n            g.add_edge(i * MAXT + t - 1, i * MAXT + t, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u, --v;\n\n        for (int t = 1; t < MAXT; ++t) {\n            int a = u * MAXT + t - 1;\n            int b = v * MAXT + t;\n            int c = v * MAXT + t - 1;\n            int d = u * MAXT + t;\n\n            for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                g.add_edge(a, b, 1, cc);\n                g.add_edge(c, d, 1,