ples": [{"content": "<translated_code>\nimport sys\nimport math\n\nEPS = 1e-9\n\nclass Vec:\n    def __init__(self, x, y):\n        self.x = x\n        self.y = y\n\n    def add(self, o):\n        return Vec(self.x + o.x, self.y + o.y)\n\n    def sub(self, o):\n        return Vec(self.x - o.x, self.y - o.y)\n\n    def scale(self, s):\n        return Vec(self.x * s, self.y * s)\n\n    def dot(self, o):\n        return self.x * o.x + self.y * o.y\n\n    def cross(self, o):\n        return self.x * o.y - self.y * o.x\n\n    def mag2(self):\n        return self.dot(self)\n\n    def mag(self):\n        return math.sqrt(self.mag2())\n\n    def unit(self):\n        return self.scale(1.0 / self.mag())\n\n    def rot90(self):\n        return Vec(-self.y, self.x)\n\n    def rot270(self):\n        return Vec(self.y, -self.x)\n\n    def rotate(self, theta):\n        PI = math.pi\n        newX = self.x * math.cos(theta) + self.y * math.cos(PI / 2 + theta)\n        newY = self.x * math.sin(theta) + self.y * math.sin(PI / 2 + theta)\n        return Vec(newX, newY)\n\n    def angle(self):\n        return (math.atan2(self.y, self.x) + 2 * math.pi) % (2 * math.pi)\n\n    def __eq__(self, o):\n        if not isinstance(o, Vec):\n            return False\n        return abs(self.x - o.x) < EPS and abs(self.y - o.y) < EPS\n\n    def __repr__(self):\n        return f\"({self.x:.2f}, {self.y:.2f})\"\n\n    @staticmethod\n    def eq(a, b):\n        return abs(a - b) < EPS\n\n    @staticmethod\n    def leq(a, b):\n        return a - EPS < b\n\n    @staticmethod\n    def geq(a, b):\n        return a + EPS > b\n\n\nclass Circle:\n    def __init__(self, c, r):\n        self.c = c\n        self.r = r\n\n    def contains(self, v):\n        return self.c.sub(v).mag2() - EPS * EPS <= self.r * self.r\n\n    def intersect(self, o):\n        if self.c == o.c:\n            return None\n        dir_vec = o.c.sub(self.c)\n        d2 = dir_vec.mag2()\n        d = math.sqrt(d2)\n        if self.r + o.r < d or self.r + d < o.r or o.r + d < self.r:\n            return None\n        if Vec.eq(self.r + o.r, d) or Vec.eq(o.r + d, self.r):\n            return [self.c.add(dir_vec.scale(self.r / d))]\n        if Vec.eq(self.r + d, o.r):\n            return [self.c.sub(dir_vec.scale(self.r / d))]\n        d1 = (self.r * self.r + d2 - o.r * o.r) / (2 * d)\n        h = math.sqrt(self.r * self.r - d1 * d1)\n        unit_dir = dir_vec.unit()\n        r_int = self.c.add(unit_dir.scale(d1).add(unit_dir.rot270().scale(h)))\n        l_int = self.c.add(unit_dir.scale(d1).add(unit_dir.rot90().scale(h)))\n        return [r_int, l_int]\n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    circ = []\n    for _ in range(n):\n        x = int(next(it))\n        y = int(next(it))\n        r = int(next(it))\n        circ.append(Circle(Vec(x, y), r))\n    points = []\n    par = list(range(n))\n    res = 1\n    for i in range(n):\n        points2 = []\n        for j in range(n):\n            if i == j:\n                continue\n            arr = circ[i].intersect(circ[j])\n            if arr is None:\n                continue\n            par[i] = par[par[i]]\n            a = par[i]\n            par[j] = par[par[j]]\n            b = par[j]\n            par[a] = b\n            for e in arr:\n                if e not in points2:\n                    points2.append(e)\n        res += len(points2)\n        for e in points2:\n            if e not in points:\n                points.append(e)\n    res -= len(points)\n    roots = sum(1 for i in range(n) if par[i] == i)\n    res += roots\n    print(res)\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.0265558760002023e-06, 0.0, 0.0, -5.495397272170521e-05, -0.00020632999076042324, -7.486063259420916e-05, -0.0011838816571980715, -4.768370445162873e-07, 0.0, -0.0019421778852120042, -0.2049726545810