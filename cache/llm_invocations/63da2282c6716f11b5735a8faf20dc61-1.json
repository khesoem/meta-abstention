push(s);\n        while(!Q.empty() ) {\n            int u = Q.front(); Q.pop();\n            inq[u] = 0;\n\n            for( int i = 0 ; i < G[u].size() ; i ++ ) {\n                Edge &e = E[G[u][i]];\n                if( e.cap > e.flow && d[e.v] > d[u] + e.cost ) {\n                    d[e.v] = d[u] + e.cost;\n                    p[e.v] = G[u][i];\n                    a[e.v] = min( a[u] , e.cap - e.flow );\n\n                    if( inq[e.v ] == 0 ) {\n                        Q.push(e.v);\n                        inq[e.v] = 1;\n                    }\n                }\n            }\n        }\n\n        if( d[t] == INF ) return false;     // No augmenting Path\n        flow = a[t];\n        cost = d[t] ;               // Unit cost\n        int u = t ;\n        while( u  != s ) {\n            E[p[u]].flow += a[t];\n            E[p[u]^1].flow -= a[t];\n            u = E[p[u]].u;\n        }\n        return true;\n    }\n\n    pair<T,T> Mincost (int s, int t) {\n        this->s=s,this->t=t;\n        T Mcost = 0;\n        T Flow = 0;\n        T f = 0 ;    // For Each CaT , The flow\n        T d = 0;      // Shortest Distance / Cost Per Flow\n\n        while(BelmanFord(f,d)) {\n            Flow += f;\n            Mcost += f *d ;\n        }\n        return make_pair(Flow, Mcost);\n    }\n};\n\nint main() {\n    int n, m, k, C, D;\n    cin>>n>>m>>k>>C>>D;\n\n    MCMF solver(n*K+2);\n    int source = n*K, sink = n*K+1;\n\n    for (int i=0; i<K; i++)\n        solver.addEdge(i, sink, k, C*i);\n\n\n    for (int i=0; i<k; i++) {\n        int x;\n        cin>>x;\n        x--;\n        solver.addEdge(source, x*K, 1, 0);\n    }\n\n    for (int i=0; i<n; i++)\n        for (int j=1; j<K; j++)\n            solver.addEdge(i*K+j-1, i*K+j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin>>u>>v;\n        u--; v--;\n\n        for (int j=1; j<K; j++) {\n            int a = u*K+j-1, b = v*K+j;\n            int c = v*K+j-1, d = u*K+j;\n\n            for (int i=1, cc = D; i<=k; i++, cc += 2*D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n    auto pr = solver.Mincost(source, sink);\n    cout<<pr.second<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9 + 7\nK = 100\n\nclass Edge:\n    def __init__(self, u, v, cap, flow, cost):\n        self.u = u\n        self.v = v\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.m = 0\n        self.s = 0\n        self.t = 0\n        self.G = [[] for _ in range(n)]\n        self.E = []\n        self.d = [INF] * n\n        self.inq = [False] * n\n        self.p = [0] * n\n        self.a = [0] * n\n\n    def addEdge(self, u, v, cap, cost):\n        self.E.append(Edge(u, v, cap, 0, cost))\n        self.E.append(Edge(v, u, 0, 0, -cost))\n        self.m = len(self.E)\n        self.G[u].append(self.m - 2)\n        self.G[v].append(self.m - 1)\n\n    def BelmanFord(self):\n        for i in range(self.n):\n            self.d[i] = INF\n        self.inq = [False] * self.n\n        self.d[self.s] = 0\n        self.inq[self.s] = True\n        self.p[self.s] = 0\n        self.a[self.s] = INF\n\n        Q = deque()\n        Q.append(self.s)\n        \n        while Q:\n            u = Q.popleft()\n            self.inq[u] = False\n\n            for i in range(len(self.G[u])):\n                e = self.E[self.G[u][i]]\n                if e.cap > e.flow and self.d[e.v] > self.d[u] + e.cost:\n                    self.d[e.v] = self.d[u] + e.cost\n                    self.p[e.v] = self.G[u][i]\n                    self.a[e.v] = min(self.a[u], e.cap - e.flow)\n\n                    if not self.inq[e.v]:\n                        Q.append(e.v)\n                        self.inq[e.v] = True\n\n        if self.d[self.t] == INF:\n            return False, 0, 0\n        \n        flow = self.a[self.t]\n        cost = self.d[self.t]\n        u = self.t\n        while u != self.s:\n            self.E[self.p[u]].flow += flow\n            self.E[self.p[u] ^ 1].flow -= flow\n            u = self.E[self.p[u]].u\n        \n        return True, flow, cost\n\n    def Mincost(self, s, t):\n        self.s = s\n        self.t = t\n        Mcost = 0\n        Flow = 0\n\n        while True:\n            found, f, d = self.BelmanFord()\n            if not found:\n                break\n            Flow += f\n            Mcost += f * d\n\n        return Flow, Mcost\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n\n    solver = MCMF(n * K + 2)\n    source = n * K\n    sink = n * K + 1\n\n    for i in range(K):\n        solver.addEdge(i, sink, k, C * i)\n\n    for i in range(k):\n        x = int(next(it)) - 1\n        solver.addEdge(source, x * K, 1, 0)\n\n    for i in range(n):\n        for j in range(1, K):\n            solver.addEdge(i * K + j - 1, i * K + j, k, 0)\n\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n\n        for j in range(1, K):\n            a = u * K + j - 1\n            b = v * K + j\n            c = v * K + j - 1\n            d = u * K + j\n\n            cc = D\n            for i in range(1, k + 1):\n                solver.addEdge(a, b, 1, cc)\n                solver.addEdge(c, d, 1, cc)\n                cc += 2 * D\n\n    pr = solver.Mincost(source, sink)\n    print(pr[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014911970356479287, -1.7881377516459906e-06, -1.7881377516459906e-06, -0.002776697976514697, -0.005865504499524832, -5