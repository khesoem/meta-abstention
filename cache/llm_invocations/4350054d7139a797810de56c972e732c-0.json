{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nconst int MAX_N = 1000000;\nint freq[MAX_N + 2], source, sink;\nvector<int> graph[MAX_N + 2];\n\nconst int INF = 1000000000;\n\nstruct Edge {\n    int from, to, flow, cap, cost;\n};\n\nvector<Edge> edges;\nvector<int> adj[MAX_N + 2];\n\nvoid addEdge(int u, int v, int capacity, int cost) {\n    edges.push_back({u, v, 0, capacity, cost});\n    adj[u].push_back(edges.size() - 1);\n    edges.push_back({v, u, 0, 0, -cost});\n    adj[v].push_back(edges.size() - 1);\n}\n\nint dist[MAX_N + 2], inq[MAX_N + 2], minFlow[MAX_N + 2], parentEdge[MAX_N + 2];\n\npair<int, int> spfa(int n) {\n    fill(dist, dist + n + 2, INF);\n    queue<int> q;\n    q.push(source);\n    dist[source] = 0;\n    inq[source] = 1;\n    minFlow[source] = INF;\n\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = 0;\n        for (int id : adj[u]) {\n            int v = edges[id].to;\n            if (edges[id].cap > edges[id].flow && dist[v] > dist[u] + edges[id].cost) {\n                dist[v] = dist[u] + edges[id].cost;\n                parentEdge[v] = id;\n                minFlow[v] = min(minFlow[u], edges[id].cap - edges[id].flow);\n                if (!inq[v]) {\n                    q.push(v);\n                    inq[v] = 1;\n                }\n            }\n        }\n    }\n\n    if (dist[sink] == INF) return {0, 0};\n\n    int augment = minFlow[sink];\n    int cur = sink;\n    while (cur != source) {\n        int eid = parentEdge[cur];\n        edges[eid].flow += augment;\n        edges[eid ^ 1].flow -= augment;\n        cur = edges[eid].from;\n    }\n\n    return {augment, augment * dist[sink]};\n}\n\npair<int, int> mcmf(int n) {\n    int totalFlow = 0, totalCost = 0;\n    while (true) {\n        auto [flow, cost] = spfa(n);\n        if (flow == 0) break;\n        totalFlow += flow;\n        totalCost += cost;\n    }\n    return {totalFlow, totalCost};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; i++) {\n        int x; cin >> x;\n        freq[x]++;\n    }\n\n    for (int i = 0; i < m; i++) {\n        int u, v;\n        cin >> u >> v;\n        graph[u].push_back(v);\n        graph[v].push_back(u);\n    }\n\n    source = 0;\n    sink = 100 * n + n + 1;\n\n    for (int t = 0; t < 100; t++) {\n        for (int i = 1; i <= n; i++) {\n            addEdge(n * t + i, n * (t + 1) + i, k, 0);\n            for (int neighbor : graph[i]) {\n                for (int cp = 1; cp <= k; cp++) {\n                    addEdge(n * t + i, n * (t + 1) + neighbor, 1, d * (2 * cp - 1));\n                }\n            }\n        }\n    }\n\n    for (int i = 1; i <= n; i++) {\n        if (freq[i]) {\n            addEdge(source, i, freq[i], 0);\n        }\n    }\n\n    for (int t = 0; t <= 100; t++) {\n        addEdge(n * t + 1, sink, k, c * t);\n    }\n\n    cout << mcmf(sink).second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAX_N = 1000000;\n    static int[] freq = new int[MAX_N + 2];\n    static int source, sink;\n    static List<List<Integer>> graph = new ArrayList<>(MAX_N + 2);\n\n    static final int INF = 1000000000;\n\n    static class Edge {\n        int from, to, flow, cap, cost;\n        Edge(int from, int to, int flow, int cap, int cost) {\n            this.from = from;\n            this.to = to;\n            this.flow = flow;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static List<Edge> edges = new ArrayList<>();\n    static List<List<Integer>> adj = new ArrayList<>(MAX_N + 2);\n\n    static void addEdge(int u, int v, int capacity, int cost) {\n        edges.add(new Edge(u, v, 0, capacity, cost));\n        adj.get(u).add(edges.size() - 1);\n        edges.add(new Edge(v, u, 0, 0, -cost));\n        adj.get(v).add(edges.size() - 1);\n    }\n\n    static int[] dist = new int[MAX_N + 2];\n    static int[] inq = new int[MAX_N + 2];\n    static int[] minFlow = new int[MAX_N + 2];\n    static int[] parentEdge = new int[MAX_N + 2];\n\n    static class Result {\n        int flow, cost;\n        Result(int flow, int cost) {\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static Result spfa(int n) {\n        Arrays.fill(dist, INF);\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(source);\n        dist[source] = 0;\n        inq[source] = 1;\n        minFlow[source] = INF;\n\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            inq[u] = 0;\n            for (int id : adj.get(u)) {\n                Edge edge = edges.get(id);\n                int v = edge.to;\n                if (edge.cap > edge.flow && dist[v] > dist[u] + edge.cost) {\n                    dist[v] = dist[u] + edge.cost;\n                    parentEdge[v] = id;\n                    minFlow[v] = Math.min(minFlow[u], edge.cap - edge.flow);\n                    if (inq[v] == 0) {\n                        q.offer(v);\n                        inq[v] = 1;\n                    }\n                }\n            }\n        }\n\n        if (dist[sink] == INF) return new Result(0, 0);\n\n        int augment = minFlow[sink];\n        int cur = sink;\n        while (cur != source) {\n            int eid = parentEdge[cur];\n            edges.get(eid).flow += augment;\n            edges.get(eid ^ 1).flow -= augment;\n            cur = edges.get(eid).from;\n        }\n\n        return new Result(augment, augment * dist[sink]);\n    }\n\n    static Result mcmf(int n) {\n        int totalFlow = 0, totalCost = 0;\n        while (true) {\n            Result res = spfa(n);\n            if (res.flow == 0) break;\n            totalFlow += res.flow;\n            totalCost += res.cost;\n        }\n        return new Result(totalFlow, totalCost);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        for (int i = 0; i <= MAX_N + 1; i++) {\n            graph.add(new ArrayList<>());\n            adj.add(new ArrayList<>());\n        }\n\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            freq[x]++;\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            graph.get(u).add(v);\n            graph.get(v).add(u);\n        }\n\n        source = 0;\n        sink = 100 * n + n + 1;\n\n        for (int t = 0; t < 100; t++) {\n            for (int i = 1; i <= n; i++) {\n                addEdge(n * t + i, n * (t + 1) + i, k, 0);\n                for (int neighbor : graph.get(i)) {\n                    for (int cp = 1; cp <= k; cp++) {\n                        addEdge(n * t + i, n * (t + 1) + neighbor, 1, d * (2 * cp - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            if (freq[i] > 0) {\n                addEdge(source, i, freq[i], 0);\n            }\n        }\n\n        for (int t = 0; t <= 100; t++) {\n            addEdge(n * t + 1, sink, k, c * t);\n        }\n\n        System.out.println(mcmf(sink).cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00016759421851020306, -2.0265558760002023e-06, -7.152555099310121e-07, -0.0020079705864191055, -5.686121585313231e-05, -0.313266783952713, -0.34857380390167236, -1.1205610462639015e-05, -7.152555099310121e-07, -6.532455881824717e-05, -0.005929261911660433, -9.059865078597795e-06, -0.006578100845217705, -0.017101796343922615, -5.722029527532868e-06, -0.004083747509866953, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -1.2993727978027891e-05, 0.0, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -7.152555099310121e-07, -2.145764938177308e-06, -2.50339189733495e-06, -0.12695293128490448, -0.010098082944750786, -5.125986263010418e-06, -4.589452510117553e-05, -4.768370445162873e-07, -9.536738616588991e-07, -1.7762025890988298e-05, -3.576278118089249e-07, -3.576278118089249e-07, -3.576278118089249e-07, -9.059865078597795e-06, -1.7762025890988298e-05, -0.00013422065239865333, -7.152555099310121e-07, -2.47952248173533e-05, -0.00025328766787424684, -6.627816765103489e-05, -2.861018856492592e-06, -8.34461570775602e-06, -2.264974000354414e-06, -0.0015061474405229092, -0.3037116527557373, -0.47412097454071045, -0.0017316836165264249, -3.099436753473128e-06, -8.940656698541716e-06, -0.004086834378540516, -2.7656173188006505e-05, -0.00010179955279454589, -0.9391158819198608, -2.706014311115723e-05, -2.3841855067985307e-07, -3.576278118089249e-07, 0.0, -0.00029702542815357447, -0.5231269598007202, -1.5497195136049413e-06, -5.602820692729438e-06, -0.0037275135