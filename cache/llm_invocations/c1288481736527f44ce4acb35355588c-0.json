);\n        }\n        return x < 0 ? x + m : x;\n    }\n    explicit operator int() const { return val; }\n    mod_int& operator+=(const mod_int &other) { val += other.val; if (val >= MOD) val -= MOD; return *this; }\n    mod_int& operator-=(const mod_int &other) { val -= other.val; if (val < 0) val += MOD; return *this; }\n    static unsigned fast_mod(uint64_t x, unsigned m = MOD) {\n#if !defined(_WIN32) || defined(_WIN64)\n        return x % m;\n#else\n        unsigned x_high = x >> 32, x_low = (unsigned)x;\n        unsigned quot, rem;\n        asm(\"divl %4\\n\" : \"=a\"(quot), \"=d\"(rem) : \"d\"(x_high), \"a\"(x_low), \"r\"(m));\n        return rem;\n#endif\n    }\n    mod_int& operator*=(const mod_int &other) { val = fast_mod((uint64_t)val * other.val); return *this; }\n    mod_int& operator/=(const mod_int &other) { return *this *= other.inv(); }\n    friend mod_int operator+(const mod_int &a, const mod_int &b) { return mod_int(a) += b; }\n    friend mod_int operator-(const mod_int &a, const mod_int &b) { return mod_int(a) -= b; }\n    friend mod_int operator*(const mod_int &a, const mod_int &b) { return mod_int(a) *= b; }\n    friend mod_int operator/(const mod_int &a, const mod_int &b) { return mod_int(a) /= b; }\n    mod_int& operator++() { val = val == MOD - 1 ? 0 : val + 1; return *this; }\n    mod_int& operator--() { val = val == 0 ? MOD - 1 : val - 1; return *this; }\n    mod_int operator++(int) { mod_int before = *this; ++*this; return before; }\n    mod_int operator--(int) { mod_int before = *this; --*this; return before; }\n    mod_int operator-() const { return val == 0 ? 0 : MOD - val; }\n    bool operator==(const mod_int &other) const { return val == other.val; }\n    bool operator!=(const mod_int &other) const { return val != other.val; }\n    mod_int inv() const { return mod_inv(val); }\n    mod_int pow(long long p) const { assert(p >= 0); mod_int a = *this, result = 1; while (p) { if (p & 1) result *= a; a *= a; p >>= 1; } return result; }\n};\n\nconst int N_MAX = 10;\nint N;\nmod_int probability[N_MAX][N_MAX];\n\nint main() {\n    cin >> N;\n    for (int i = 0; i < N; i++)\n        for (int j = 0; j < N; j++) {\n            int p;\n            cin >> p;\n            probability[i][j] = mod_int(p) / 100;\n        }\n\n    vector<vector<int>> sets(N + 1);\n    vector<int> position(1 << N, -1);\n    for (int mask = 0; mask < (1 << N); mask++) {\n        int cnt = __builtin_popcount(mask);\n        position[mask] = sets[cnt].size();\n        sets[cnt].push_back(mask);\n    }\n\n    map<ll, mod_int> dp; // ordered map, no custom hash needed\n    dp[1LL << position[0]] = 1;\n\n    for (int person = 0; person < N; person++) {\n        map<ll, mod_int> ndp;\n        vector<mod_int> products(1 << N, 1);\n        for (int cur = 0; cur < (1 << N); cur++)\n            for (int col = 0; col < N; col++)\n                products[cur] *= (cur >> col & 1) ? probability[person][col] : 1 - probability[person][col];\n\n        for (auto it = dp.begin(); it != dp.end(); ++it) {\n            ll state = it->first;\n            mod_int prob = it->second;\n            vector<ll> bits(N, 0);\n            for (int mask : sets[person])\n                if ((state >> position[mask]) & 1)\n                    for (int col = 0; col < N; col++)\n                        if ((mask >> col & 1) == 0)\n                            bits[col] |= 1LL << position[mask | (1 << col)];\n\n            vector<ll> trans(1 << N, 0);\n            for (int cur = 1; cur < (1 << N); cur++) {\n                int low = cur & -cur;\n                trans[cur] = trans[cur ^ low] | bits[__builtin_ctz(low)];\n                ndp[trans[cur]] += prob * products[cur];\n            }\n        }\n        dp = move(ndp);\n        cerr << dp.size() << endl;\n    }\n\n    mod_int answer = 0;\n    int full = (1 << N) - 1;\n    for (auto &p : dp)\n        if ((p.first >> position[full]) & 1)\n            answer += p.second;\n    cout << (int)answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass mod_int:\n    def __init__(self, v=0):\n        if v = int(v)\n        if v < 0:\n        v = v % MOD + MOD\n        if v >= MOD:\n            v %= MOD\n        self.val = v\n    def __int__(self):\n        return self.val\n    def __iadd__(self, other):\n        self.val = (self.val + other.val) % MOD\n        return self\n    def __isub__(self, other):\n        self.val = (self.val - other.val) % MOD\n        return self\n    def __imul__(self, other):\n        self.val = (self.val * other.val) % MOD\n        return self\n    def __itruediv__(self, other):\n        return self * other.inv()\n    def __neg__(self):\n        return mod_int(0 if self.val == 0 else MOD - self.val)\n    def __add__(self, other):\n        return mod_int(self.val + other.val)\n    def __sub__(self, other):\n        return mod_int(self.val - other.val)\n    def __mul__(self, other):\n        return mod_int(self.val * other.val)\n    def __truediv__(self, other):\n        return mod_int(self.val / other.val)\n    def __pow__(self, p):\n        a = self\n        result = mod_int(1)\n        while p:\n            if p & 1:\n            result *= a\n            a *= a\n            p >>= 1\n        return result\n    def inv(self):\n        return mod_int.mod_inv(self.val)\n    def mod_inv(a, m=MOD):\n        g = m\n        r = a\n        x = 0\n        y = 1\n        while r:\n            q = g // r\n            g %= r\n            g, r = r, g\n            x -= q * y\n            x, y = y, x\n        return x + m if x < 0 else x + m\n    def __eq__(self, other):\n        return self.val == other.val\n    def __ne__(self, other):\n        return self.val != other.val\n    def __hash__(self):\n        return hash(self.val)\n\ndef main():\n    N = int(sys.stdin.readline().strip())\n    N = int(N)\n    probability = [[mod_int(0) for _ in range(N)] for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            p = int(sys.stdin.readline().strip())\n            probability[i][j] = mod_int(p) / 100\n    sets = [[] for _ in range(N + 1)]\n    position = [-1 for _ in range(1 << N)]\n    for mask in range(1 << N):\n        cnt = bin(mask).bit_count()\n        position[mask] = len(sets[cnt])\n        sets[cnt].append(mask)\n    dp = {1 << position[0]: mod_int(1)}\n    for person in range(N):\n        ndp = {}\n        products = [mod_int(1 << N) for _ in range(1 << N)]\n        for cur in range(1 << N):\n            for col in range(N):\n                products[cur] *= (probability[person][col] if (cur >> col) & 1) else (1 - probability[person][col])\n        for state, prob in dp.items():\n            bits = [0 for _ in range(N)]\n            for mask in sets[person]:\n                if (state >> position[mask]) & 1:\n                for col in range(N):\n                    if (mask >> col) & 1 == 0:\n                        bits[col] |= 1 << position[mask | (1 << col)]\n            trans = [0 for _ in range(1 << N)]\n            for cur in range(1, 1 << N):\n                low = cur & -cur\n                trans[cur] = trans[cur ^ low] | bits[(low & -low).bit_length() - 1]\n                ndp[trans[cur]] += prob * products[cur]\n        dp = ndp\n    answer = mod_int(0)\n    full = (1 << N) - 1\n    for state, prob in dp.items():\n        if (state >> position[full]) & 1:\n            answer += prob\n    print(int(answer))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -0.0003736513026524335, -0.13104017078876495, -2.9801878554280847e-05, -0.2525554299354553, -3.4450891689630225e-05, -4.887569048150908e-06, -3.814689989667386e-06, -0.00033098942367359996, -1.1920922133867862e-06, -9.536738616588991e-07, -1.549708758830093e-05, 