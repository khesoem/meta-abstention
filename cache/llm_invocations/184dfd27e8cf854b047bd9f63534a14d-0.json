 (1..n)\n        self.g = g  # adjacency list for left nodes (indexed 0..m, index 0 unused)\n        self.pairU = [0] * (m + 1)  # 0 = NIL\n        self.pairV = [0] * (n + 1)\n        self.dis = [0] * (m + 1)\n        self.NIL = 0\n        self.INF = 10_000_000\n\n    def maximumMatching(self):\n        maxMatching = 0\n        while self.bfs():\n            for u in range(1, self.m + 1):\n                if self.pairU[u] == self.NIL and self.dfs(u):\n                    maxMatching += 1\n        return maxMatching\n\n    def bfs(self):\n        q = deque()\n        for u in range(1, self.m + 1):\n            if self.pairU[u] == self.NIL:\n                q.append(u)\n                self.dis[u] = 0\n            else:\n                self.dis[u] = self.INF\n        self.dis[self.NIL] = self.INF\n        while q:\n            u = q.popleft()\n            if self.dis[u] < self.dis[self.NIL]:\n                for v in self.g[u]:\n                    if self.dis[self.pairV[v]] == self.INF:\n                        q.append(self.pairV[v])\n                        self.dis[self.pairV[v]] = self.dis[u] + 2\n        return self.dis[self.NIL] < self.INF\n\n    def dfs(self, u):\n        if u != self.NIL:\n            for v in self.g[u]:\n                if self.dis[self.pairV[v]] == self.dis[u] + 2:\n                    if self.dfs(self.pairV[v]):\n                        self.pairV[v] = u\n                        self.pairU[u] = v\n                        return True\n            self.dis[u] = self.INF\n            return False\n        else:\n            return True\n\ndef addEdge(mat, g, i, j, s, t, n, m):\n    if s <= 0 or t <= 0 or s > n or t > m:\n        return\n    g[mat[i][j]].append(mat[s][t])\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n\n    ans = 0\n\n    if n > 100:\n        nn = (n - 100) % 6\n        nq = (n - 100) // 6\n        ans += nq * 6 * m\n        n = 100 + nn\n\n    if m > 100:\n        nm = (m - 100) % 6\n        mq = (m - 100) // 6\n        ans += mq * 6 * n\n        m = 100 + nm\n\n    mat = [[0] * (m + 1) for _ in range(n + 1)]\n\n    u = 1\n    v = 1\n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            if (i + j) % 2 == 0:\n                mat[i][j] = u\n                u += 1\n\n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            if (i + j) % 2 != 0:\n                mat[i][j] = v\n                v += 1\n\n    # u now = total_even + 1, v = total_odd + 1\n    g = [[] for _ in range(u)]  # index 0 unused, size u\n\n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            if (i + j) % 2 == 0:\n                # all knight move offsets\n                addEdge(mat, g, i, j, i - 3, j, n, m)\n                addEdge(mat, g, i, j, i - 2, j - 1, n, m)\n                addEdge(mat, g, i, j, i - 2, j + 1, n, m)\n                addEdge(mat, g, i, j, i, j - 3, n, m)\n                addEdge(mat, g, i, j, i - 1, j - 2, n, m)\n                addEdge(mat, g, i, j, i + 1, j - 2, n, m)\n                addEdge(mat, g, i, j, i, j + 3, n, m)\n                addEdge(mat, g, i, j, i - 1, j + 2, n, m)\n                addEdge(mat, g, i, j, i + 1, j + 2, n, m)\n                addEdge(mat, g, i, j, i + 3, j, n, m)\n                addEdge(mat, g, i, j, i + 2, j - 1, n, m)\n                addEdge(mat, g, i, j, i + 2, j + 1, n, m)\n\n    bpm = HopcroftKarpBipartiteMatching(u - 1, v - 1, g)\n    ans += 2 * bpm.maximumMatching()\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.074220174108632e-05, -1.1920928244535389e-07, -4.768370445162873e-07, -0.00012540031457319856, -6.103329360485077e-05, 0.0, -5.8412379075889476e-06, -0.003096668515354395, 0.0, 0.0, -1.1920928244535389e-07, -0.04859675467014313, -0.1850796788930893, 0.0, 0.0, 0.0, 0.0, -1.4305104514278355e-06, -0.4119516611