self.n = n\n        self.graph = [[] for _ in range(n)]\n\n    def add_edge(self, fr, to, cap, cost):\n        self.graph[fr].append(Edge(to, len(self.graph[to]), cap, cost))\n        self.graph[to].append(Edge(fr, len(self.graph[fr]) - 1, 0, -cost))\n\n    def min_cost_flow(self, s, t, flow_needed):\n        res = 0\n        h = [0] * self.n\n        while flow_needed > 0:\n            dist = [INF] * self.n\n            prevv = [-1] * self.n\n            preve = [-1] * self.n\n            dist[s] = 0\n\n            # custom binary heap with decrease-key (1-indexed)\n            pq = [0] * (self.n + 1)   # heap array\n            iq = [0] * self.n         # index in heap (0 = not in heap)\n            cnt = 0\n\n            def lt(u, v):\n                return dist[u] < dist[v] or (dist[u] == dist[v] and h[u] < h[v])\n\n            def i2(i):\n                i *= 2\n                if i > cnt:\n                    return 0\n                if i < cnt and lt(pq[i+1], pq[i]):\n                    return i+1\n                return i\n\n            def pq_up(u):\n                nonlocal cnt\n                i = iq[u]\n                while True:\n                    j = i // 2\n                    if j == 0 or not lt(u, pq[j]):\n                        break\n                    pq[i] = pq[j]\n                    iq[pq[j]] = i\n                    i = j\n                pq[i] = u\n                iq[u] = i\n\n            def pq_dn(u):\n                nonlocal cnt\n                i = iq[u]\n                while True:\n                    j = i2(i)\n                    if j == 0 or not lt(pq[j], u):\n                        break\n                    pq[i] = pq[j]\n                    iq[pq[j]] = i\n                    i = j\n                pq[i] = u\n                iq[u] = i\n\n            def pq_add(u):\n                nonlocal cnt\n                cnt += 1\n                iq[u] = cnt\n                pq[cnt] = u\n                pq_up(u)\n\n            def pq_pop():\n                nonlocal cnt\n                u = pq[1]\n                v = pq[cnt]\n                cnt -= 1\n                iq[v] = 1\n                pq_dn(v)\n                return u\n\n            pq_add(s)\n            while cnt:\n                u = pq_pop()\n                for idx, e in enumerate(self.graph[u]):\n                    if e.cap > 0:\n                        nd = dist[u] + e.cost + h[u] - h[e.to]\n                        if nd < dist[e.to]:\n                            dist[e.to] = nd\n                            prevv[e.to] = u\n                            preve[e.to] = idx\n                            if iq[e.to] == 0:\n                                pq_add(e.to)\n                            else:\n                                pq_up(e.to)\n\n            if dist[t] == INF:\n                return -1\n\n            for v in range(self.n):\n                h[v] += dist[v]\n\n            d = flow_needed\n            v = t\n            while v != s:\n                d = min(d, self.graph[prevv[v]][preve[v]].cap)\n                v = prevv[v]\n            flow_needed -= d\n            res += d * h[t]\n            v = t\n            while v != s:\n                e = self.graph[prevv[v]][preve[v]]\n                e.cap -= d\n                self.graph[v][e.rev].cap += d\n                v = prevv[v]\n        return res\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    start = [int(next(it)) - 1 for _ in range(k)]\n    base_adj = [[] for _ in range(n)]\n    for _ in range(m):\n        a = int(next(it)) - 1\n        b = int(next(it)) - 1\n        base_adj[a].append(b)\n        base_adj[b].append(a)\n\n    t = n + k + 1\n    N_total = n * t + 1\n    mcf = MinCostFlow(N_total)\n\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            for j in base_adj[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    mcf.add_edge(u, v, 1, c + (2 * x - 1) * d)\n\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            cost = 0 if i == 0 else c\n            mcf.add_edge(u, v, k, cost)\n\n    source = N_total - 1\n    for h in range(k):\n        mcf.add_edge(source, start[h] * t, 1, 0)\n\n    sink = 0 * t + t - 1\n    print(mcf.min_cost_flow(source, sink, k))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.5258672647178173e-05, 0.0, -3.576278118089249e-07, -0.0013525871327146888, -0.003236177610233426, -0.00015877417172305286, -0.03008200041949749, -0.2519663870334625, -1.1920928244535389e-07, -3.576278118089249e-07, -1.0013530300057027e-05, -0.1602243036031723, -3.886147169396281e-05, -0.029783278703689575, -2.3841855067985307e-07, -0.1269344538450241, -1.1920928244535389e-07, -4.768370445162873e-07, -4.768370445162873e-07, 0.0, 0.0, -4.6491513785440475e-06, -1.1920922133867862e-06, -2.288792165927589e-05, 0.0, -0.0009115354623645544, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -2.622600959512056e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -7.390948667307384e-06, -5.960462772236497e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.0009149893885478377, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.3841830625315197e-06, 0.0, 0.0, 0.0, -3.576278118089249e-07, -1.1920928244535389e-07, -5.006777428206988e-06, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -3.576278118089249e-07, 0.0