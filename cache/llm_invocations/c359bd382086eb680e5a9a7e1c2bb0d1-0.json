)\n            T = T.mul(T)\n            k >>= 1\n        return res\n\nclass Pair:\n    def __init__(self, fi, se):\n        self.fi = fi\n        self.se = se\n\n    def __lt__(self, oth):\n        if self.fi > oth.fi:\n            return False\n        if self.fi < oth.fi:\n            return True\n        if self.se > oth.se:\n            return False\n        if self.se < oth.se:\n            return True\n        return False\n\ndef gcd(a, b):\n    while b != 0:\n        a, b = b, a % b\n    return a\n\ndef lcm(a, b):\n    return a // gcd(a, b) * b\n\ndef fpow(n, k, p):\n    r = 1\n    while k > 0:\n        if k & 1:\n            r = r * n % p\n        n = n * n % p\n        k >>= 1\n    return r\n\ndef FloorOfNthRoot(x, n):\n    sign = (x > 0) - (x < 0)\n    if n <= 0 or sign < 0:\n        raise ValueError()\n    if sign == 0:\n        return 0\n    if n == 1:\n        return x\n    a = None\n    bigN = n\n    bigNMinusOne = n - 1\n    b = 1 << (1 + x.bit_length() // n)\n    while True:\n        a = b\n        b = (a * bigNMinusOne + x // (a ** (n - 1))) // bigN\n        if b >= a:\n            break\n    return a\n\ndef sqrt(A, SCALE):\n    x0 = 0\n    x1 = math.sqrt(A)\n    while True:\n        prev_x1 = x1\n        x1 = A / prev_x1\n        x1 = (x1 + prev_x1) / 2\n        if abs(x1 - prev_x1) < 1e-12:\n            break\n    return x1\n\nMOD = 10**9 + 7\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020854694594163448, -0.0006513170665130019, -3.128163257315464e-07, -2.236549335066229e-05, -0.0007366081699728966, -2.2378990650177, -4.215330409351736e-05, -0.000488110730657354, -0.00021641071361955255, -2.018692970275879, -1.107143759727478, -0.14527754485607147, -0.31437578797340393, -0.040336355566978455, -0.006777303759008646, -4.842555426876061e-06, -0.00024096666311379522, -1.775292158126831, -0.012674804776906967, -0.25954657793045044, -1.3856492842023727e-06, -0.18771345913410187, -0.024851737543940544, -1.1472419600