{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct edge {\n    int y, c, f, w;\n    edge() {}\n    edge(int y, int c, int f, int w) : y(y), c(c), f(f), w(w) {}\n};\n\nconst int N = 14043;\nvector<edge> e;\nvector<vector<int>> g(N);\n\nlong long ans = 0;\nlong long d[N];\nint p[N], pe[N], inq[N];\nconst long long INF = (long long)1e18;\n\nint s = N - 2;\nint t = N - 1;\n\nint rem(int x) { return e[x].c - e[x].f; }\n\nvoid add_edge(int x, int y, int c, int w) {\n    g[x].push_back(e.size());\n    e.push_back(edge(y, c, 0, w));\n    g[y].push_back(e.size());\n    e.push_back(edge(x, 0, 0, -w));\n}\n\nvoid push_flow() {\n    for (int i = 0; i < N; ++i) d[i] = INF, p[i] = -1, pe[i] = -1, inq[i] = 0;\n    d[s] = 0;\n    queue<int> q;\n    q.push(s);\n    inq[s] = 1;\n\n    while (!q.empty()) {\n        int v = q.front();\n        q.pop();\n        inq[v] = 0;\n        for (int id : g[v]) {\n            if (!rem(id)) continue;\n            int y = e[id].y;\n            int w = e[id].w;\n            if (d[y] > d[v] + w) {\n                d[y] = d[v] + w;\n                p[y] = v;\n                pe[y] = id;\n                if (!inq[y]) {\n                    inq[y] = 1;\n                    q.push(y);\n                }\n            }\n        }\n    }\n\n    int cur = t;\n    while (cur != s) {\n        e[pe[cur]].f++;\n        e[pe[cur] ^ 1].f--;\n        cur = p[cur];\n    }\n    ans += d[t];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        add_edge(s, x, 1, 0);\n    }\n\n    int tt = 101;\n\n    for (int i = 0; i < tt; ++i)\n        add_edge(i * n, t, k, i * c);\n\n    for (int i = 0; i < m; ++i) {\n        int x, y;\n        cin >> x >> y;\n        --x; --y;\n\n        for (int tm = 0; tm < tt - 1; ++tm)\n            for (int p = 0; p < k; ++p)\n                add_edge(x + tm * n, y + tm * n + n, 1, d * (p * 2 + 1));\n\n        for (int tm = 0; tm < tt - 1; ++tm)\n            for (int p = 0; p < k; ++p)\n                add_edge(y + tm * n, x + tm * n + n, 1, d * (p * 2 + 1));\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int tm = 0; tm < tt - 1; ++tm)\n            add_edge(i + tm * n, i + tm * n + n, k, 0);\n\n    for (int i = 0; i < k; ++i)\n        push_flow();\n\n    cout << ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int y, c, f, w;\n        Edge(int y, int c, int f, int w) {\n            this.y = y;\n            this.c = c;\n            this.f = f;\n            this.w = w;\n        }\n    }\n\n    static final int N = 14043;\n    static ArrayList<Edge> e = new ArrayList<>();\n    static ArrayList<ArrayList<Integer>> g = new ArrayList<>(N);\n    static long ans = 0;\n    static long[] d = new long[N];\n    static int[] p = new int[N];\n    static int[] pe = new int[N];\n    static int[] inq = new int[N];\n    static final long INF = 1000000000000000000L;\n    static int s = N - 2;\n    static int t = N - 1;\n\n    static int rem(int x) {\n        return e.get(x).c - e.get(x).f;\n    }\n\n    static void add_edge(int x, int y, int c, int w) {\n        g.get(x).add(e.size());\n        e.add(new Edge(y, c, 0, w));\n        g.get(y).add(e.size());\n        e.add(new Edge(x, 0, 0, -w));\n    }\n\n    static void push_flow() {\n        Arrays.fill(d, INF);\n        Arrays.fill(p, -1);\n        Arrays.fill(pe, -1);\n        Arrays.fill(inq, 0);\n        d[s] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.add(s);\n        inq[s] = 1;\n\n        while (!q.isEmpty()) {\n            int v = q.poll();\n            inq[v] = 0;\n            for (int id : g.get(v)) {\n                if (rem(id) == 0) continue;\n                int y = e.get(id).y;\n                int w = e.get(id).w;\n                if (d[y] > d[v] + w) {\n                    d[y] = d[v] + w;\n                    p[y] = v;\n                    pe[y] = id;\n                    if (inq[y] == 0) {\n                        inq[y] = 1;\n                        q.add(y);\n                    }\n                }\n            }\n        }\n\n        int cur = t;\n        while (cur != s) {\n            e.get(pe[cur]).f++;\n            e.get(pe[cur] ^ 1).f--;\n            cur = p[cur];\n        }\n        ans += d[t];\n    }\n\n    public static void main(String[] args) throws IOException {\n        // Initialize graph adjacency lists\n        for (int i = 0; i < N; ++i) {\n            g.add(new ArrayList<>());\n        }\n\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int dCost = Integer.parseInt(st.nextToken()); // renamed to avoid conflict with d array\n\n        // Read start nodes\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; ++i) {\n            int x = Integer.parseInt(st.nextToken());\n            --x;\n            add_edge(s, x, 1, 0);\n        }\n\n        int tt = 101;\n\n        // Add edges from first node of each timeslice to sink\n        for (int i = 0; i < tt; ++i) {\n            add_edge(i * n, t, k, i * c);\n        }\n\n        // Read edges and add time-expanded edges\n        for (int i = 0; i < m; ++i) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            --x; --y;\n\n            for (int tm = 0; tm < tt - 1; ++tm) {\n                for (int p = 0; p < k; ++p) {\n                    add_edge(x + tm * n, y + tm * n + n, 1, dCost * (p * 2 + 1));\n                }\n            }\n\n            for (int tm = 0; tm < tt - 1; ++tm) {\n                for (int p = 0; p < k; ++p) {\n                    add_edge(y + tm * n, x + tm * n + n, 1, dCost * (p * 2 + 1));\n            }\n        }\n\n        // Stay edges at each node across time\n        for (int i = 0; i < n; ++i) {\n            for (int tm = 0; tm < tt - 1; ++tm) {\n                add_edge(i + tm * n, i + tm * n + n, k, 0);\n            }\n        }\n\n        // Send k units of flow\n        for (int i = 0; i < k; ++i) {\n            push_flow();\n        }\n\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.0001037067049765028, -0.019105341285467148, -1.1920922133867862e-06, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.00011228884250158444, -5.411955135059543e-05, -3.576278118089249e-07, -0.12692877650260925, -0.06208469718694687, -2.