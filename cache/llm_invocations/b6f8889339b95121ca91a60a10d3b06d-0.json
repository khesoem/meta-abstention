ng>(candidate2), b};\n        }\n    }\n    \n    cout << best.first << \"/\" << best.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n        \n        double target = (double) x / y;\n        long[] best = {0, 1};\n        double bestDiff = Double.MAX_VALUE;\n        \n        for (long b = 1; b <= n; ++b) {\n            double candidate1 = Math.round(target * b);\n            double candidate2 = candidate1;\n            \n            if (candidate1 != target * b) {\n                candidate2 = candidate1 + (target * b > candidate1 ? 1.0 : -1.0);\n            }\n            \n            double diff1 = Math.abs(target - candidate1 / b);\n            double diff2 = Math.abs(target - candidate2 / b);\n            \n            if (diff1 < bestDiff - 1e-20) {\n                bestDiff = diff1;\n                best[0] = (long) candidate1;\n                best[1] = b;\n            }\n            \n            if (diff2 < bestDiff - 1e-20) {\n                bestDiff = diff2;\n                best[0] = (long) candidate2;\n                best[1] = b;\n            }\n        }\n        \n        System.out.println(best[0] + \"/\" + best[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015221867943182588, -2.622600959512056e-06, -2.3841855067985307e-07, -6.270212179515511e-05, -1.0847986231965479e-05, -0.2158270627260208, -0.6402744054794312, -7.629365427419543e-06, -2.3841855067985307e-07, -3.45700973412022e-05, -2.7894584491150454e-05, -1.0728830375228426e-06, -8.22540732769994e-06, -1.1920922133867862e-06, -7.1525