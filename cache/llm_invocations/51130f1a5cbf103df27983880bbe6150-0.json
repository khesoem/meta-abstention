hElementException();\n\t\t\tint n = 0;\n\t\t\ttry {\n\t\t\t\tbyte b = readByte();\n\t\t\t\tif (b == '-') {\n\t\t\t\t\twhile(isNumber(b = readByte())) n = n * 10 + '0' - b;\n\t\t\t\t\treturn n;\n\t\t\t\t} else if (!isNumber(b)) throw new NumberFormatException();\n\t\t\t\tdo n = n * 10 + b - '0'; while (isNumber(b = readByte()));\n\t\t\t} catch (java.util.NoSuchElementException e) {\n\t\t\t}\n\t\t\treturn n;\n\t\t}\n\t\tpublic double nextDouble() {\n\t\t\treturn Double.parseDouble(next());\n\t\t}\n\t}\n\n\tpublic static class IntMath {\n\t\tpublic static int gcd(int a, int b) {\n\t\t\twhile (a != 0) if ((b %= a) != 0) a %= b; else return a;\n\t\t\treturn b;\n\t\t}\n\t\tpublic static int gcd(int... array) {\n\t\t\tint ret = array[0];\n\t\t\tfor (int i = 1;i < array.length;++ i) ret = gcd(ret, array[i]);\n\t\t\treturn ret;\n\t\t}\n\t\tpublic static long gcd(long a, long b) {\n\t\t\twhile (a != 0) if ((b %= a) != 0) a %= b; else return a;\n\t\t\treturn b;\n\t\t}\n\t\tpublic static long gcd(long... array) {\n\t\t\tlong ret = array[0];\n\t\t\tfor (int i = 1;i < array.length;++ i) ret = gcd(ret, array[i]);\n\t\t\treturn ret;\n\t\t}\n\t\tpublic static long lcm(long a, long b) {\n\t\t\treturn a / gcd(a, b) * b;\n\t\t}\n\t\tpublic static int pow(int a, int b) {\n\t\t\tint ans = 1;\n\t\t\tfor (int mul = a;b > 0;b >>= 1, mul *= mul) if ((b & 1) != 0) ans *= mul;\n\t\t\treturn ans;\n\t\t}\n\t\tpublic static int pow(int a, int b, int mod) {\n\t\t\tif (b < 0) b = b % (mod - 1) + mod - 1;\n\t\t\tlong ans = 1;\n\t\t\tfor (long mul = a;b > 0;b >>= 1, mul = mul * mul % mod) if ((b & 1) != 0) ans = ans * mul % mod;\n\t\t\treturn (int)ans;\n\t\t}\n\t\tpublic static int floorsqrt(long n) {\n\t\t\treturn (int)Math.sqrt(n + 0.1);\n\t\t}\n\t\tpublic static int ceilsqrt(long n) {\n\t\t\treturn n <= 1 ? (int)n : (int)Math.sqrt(n - 0.1) + 1;\n\t\t}\n\t}\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\nclass FastScanner:\n    def __init__(self):\n        self.in_stream = sys.stdin.buffer\n        self.buffer = bytearray()\n        self.ptr = 0\n        self.buflen = 0\n\n    def _read_buffer(self):\n        if self.ptr < self.buflen:\n            return True\n        self.ptr = 0\n        try:\n            self.buffer = self.in_stream.read(1024)\n            self.buflen = len(self.buffer)\n        except:\n            self.buflen = 0\n        return self.buflen > 0\n\n    def _read_byte(self):\n        if self._read_buffer():\n            self.ptr += 1\n            return self.buffer[self.ptr - 1]\n        return -1\n\n    def _is_printable_char(self, c):\n        return c > 32 or c < 0\n\n    def _is_number(self, c):\n        return ord('0') <= c <= ord('9')\n\n    def has_next(self):\n        while self._read_buffer() and not self._is_printable_char(self.buffer[self.ptr]):\n            self.ptr += 1\n        return self._read_buffer()\n\n    def next(self):\n        if not self.has_next():\n            raise Exception(\"No such element\")\n        sb = bytearray()\n        b = self._read_byte()\n        while self._is_printable_char(b):\n            sb.append(b)\n            b = self._read_byte()\n        return sb.decode('ascii')\n\n    def next_long(self):\n        if not self.has_next():\n            raise Exception(\"No such element\")\n        n = 0\n        b = self._read_byte()\n        if b == ord('-'):\n            while self._is_number(self.buffer[self.ptr]):\n                n = n * 10 + ord('0') - self.buffer[self.ptr]\n                self.ptr += 1\n            return n\n        elif not self._is_number(b):\n            raise Exception(\"Number format error\")\n        else:\n            n = b - ord('0')\n            while self._is_number(self.buffer[self.ptr]):\n                n = n * 10 + self.buffer[self.ptr] - ord('0')\n                self.ptr += 1\n            return n\n\n    def next_int(self):\n        return int(self.next_long())\n\n    def next_double(self):\n        return float(self.next())\n\n\nclass IntMath:\n    @staticmethod\n    def gcd(a, b):\n        while a != 0:\n            if (b % a) != 0:\n                a, b = b % a, a\n            else:\n                return a\n        return b\n\n    @staticmethod\n    def gcd_array(array):\n        ret = array[0]\n        for i in range(1, len(array)):\n            ret = IntMath.gcd(ret, array[i])\n        return ret\n\n    @staticmethod\n    def lcm(a, b):\n        return a // IntMath.gcd(a, b) * b\n\n    @staticmethod\n    def pow(a, b):\n        ans = 1\n        mul = a\n        while b > 0:\n            if (b & 1) != 0:\n                ans *= mul\n            mul *= mul\n            b >>= 1\n        return ans\n\n    @staticmethod\n    def pow_mod(a, b, mod):\n        if b < 0:\n            b = b % (mod - 1) + mod - 1\n        ans = 1\n        mul = a\n        while b > 0:\n            if (b & 1) != 0:\n                ans = (ans * mul) % mod\n            mul = (mul * mul) % mod\n            b >>= 1\n        return ans\n\n    @staticmethod\n    def floor_sqrt(n):\n        return int(math.sqrt(n + 0.1))\n\n    @staticmethod\n    def ceil_sqrt(n):\n        if n <= 1:\n            return int(n)\n        return int(math.sqrt(n - 0.1)) + 1\n\n\ndef solve():\n    fs = FastScanner()\n    out = sys.stdout\n    \n    n = fs.next_int()\n    k = fs.next_long()\n    MOD = 998244353\n    \n    fact = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    \n    fact[0] = 1\n    for i in range(n):\n        fact[i + 1] = fact[i] * (i + 1) % MOD\n    \n    inv[n] = IntMath.pow_mod(fact[n], MOD - 2, MOD)\n    for i in range(n, 0, -1):\n        inv[i - 1] = inv[i] * i % MOD\n    \n    def comb(i, j):\n        return fact[i] * inv[j] % MOD * inv[i - j] % MOD\n    \n    if k == 0:\n        out.write(str(fact[n]) + '\\n')\n    elif k > n:\n        out.write('0\\n')\n    else:\n        k2 = int(k)\n        k3 = n - k2\n        ans = 0\n        for i in range(1, k3 + 1):\n            tmp = comb(k3, i) * IntMath.pow_mod(i, n, MOD) % MOD\n            if ((k3 - i) & 1) != 0:\n                ans -= tmp\n            else:\n                ans += tmp\n        ans = (ans % MOD + MOD) % MOD\n        ans = ans * 2 % MOD * comb(n, k2) % MOD\n        out.write(str(ans) + '\\n')\n\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.095255518332124e-05, -1.9073468138230965e-06, -2.3841855067985307e-07, -0.0006908176001161337, -0.4329298436641693, -0.016654038801789284, -0.28128039836883545, -0.00042250767000950873, -0.011396428570151329, -0.06580109894275665, -0.08936896920204163, -1.0371154530730564e-05, -9.298280929215252e-06, -2.145764938177308e-06, -5.960462772236497e-07, -0.00023898606013972312, -8.702239938429557e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -0.20141597092151642, -1.0967194612021558e-05, -5.483612312673358e-06, -0.006922074127942324, -0.051415856927633286, -1.1920928244535389e-07, -2.825220326485578e-05, -5.125986263010418e-06, -0.023822041228413582, -1.3351351299206726e-05, -2.9802276912960224e-06, -7.867782187531702e-06, -2.52720492426306e-05, -8.344646857949556e-07, -0.031948551535606384, -0.001327705685980618, -9.775113539944869e-06, -4.160317621426657e-05, -0.0010481346398591995, -3.576278118089249e-07, 0.0, 0.0, -1.3708974620385561e-05, -4.768360213347478e-06, -1.311301275563892e-06, -0.001046348363161087, -0.00038187362952157855, -0.0004316828562878072, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -0.7048985362052917, -2.0265558760002023e-06, -8.344646857949556e-07, -0.09157969802618027, -0.6132234930992126, -0.38175079226493835, -1.1920928244535389e-07, -3.576272320060525e-06, -3.4570634852570947e-06, -0.11928288638591766, -1.0371154530730564e-05, -0.0002824861148837954, -0.2519640624523163, -0.007606707978993654, -3.576278118089249e-07, -9.536738616588991e-07, -1.788123336154967