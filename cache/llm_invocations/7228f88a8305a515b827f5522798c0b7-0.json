n            for (int i = 1; i < 2 * n; i++) {\n                int prevMaxRunning = Math.min(2 * n - i, i); // how many intervals max were running (covering)\n                int maxRunning = Math.min(2 * n - i - 1, i + 1); // how many intervals max can be running\n                for (int j = 0; j <= prevMaxRunning; j++) {\n                    if (p[i - 1][j] != 0) {\n                        if (j > 0) {\n                            p[i][j - 1] = (p[i][j - 1] + p[i - 1][j] * j % mod * invs[2 * n - i] % mod) % mod; // close an interval\n                        }\n                        if (j < maxRunning) {\n                            p[i][j + 1] = (p[i][j + 1] + p[i - 1][j] * (2 * n - i - j) % mod * invs[2 * n - i] % mod) % mod; // start a new interval\n                        }\n                        if (j >= k)\n                            ans = (ans + p[i - 1][j]) % mod;\n                    }\n                }\n            }\n            if (k <= 1)\n                ans += p[2 * n - 1][1];\n\n            ans = ans * l % mod * invs[2 * n + 1] % mod;\n            out.println(ans);\n        }\n\n    }\n\n    static class FastScanner {\n        private BufferedReader in;\n        private StringTokenizer st;\n\n        public FastScanner(InputStream stream) {\n            in = new BufferedReader(new InputStreamReader(stream));\n        }\n\n        public String ns() {\n            while (st == null || !st.hasMoreTokens()) {\n                try {\n                    String rl = in.readLine();\n                    if (rl == null) {\n                        return null;\n                    }\n                    st = new StringTokenizer(rl);\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return st.nextToken();\n        }\n\n        public int ni() {\n            return Integer.parseInt(ns());\n        }\n\n    }\n\n    static class IntegerUtils {\n        public static long[] invs(int n, long p) {\n            long[] res = new long[n];\n            res[1] = 1;\n            for (int i = 2; i < n; i++) {\n                res[i] = (p - (p / i) * res[(int) (p % i)] % p) % p;\n            }\n            return res;\n        }\n\n    }\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\ndef invs(n, mod):\n    res = [0] * n\n    res[1] = 1\n    for i in range(2, n):\n        res[i] = (mod - (mod // i) * res[mod % i] % mod) % mod\n    return res\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    l = int(data[2])\n    mod = MOD\n    invs_arr = invs(2 * n + 3, mod)\n    p = [[0] * (n + 1) for _ in range(2 * n + 1)]\n    p[0][1] = 1\n    ans = 0\n    for i in range(1, 2 * n):\n        prev_max_running = min(2 * n - i, i)\n        max_running = min(2 * n - i - 1, i + 1)\n        for j in range(prev_max_running + 1):\n            if p[i - 1][j] != 0:\n                if j > 0:\n                    p[i][j - 1] = (p[i][j - 1] + p[i - 1][j] * j % mod * invs_arr[2 * n - i] % mod) % mod\n                if j < max_running:\n                    p[i][j + 1] = (p[i][j + 1] + p[i - 1][j] * (2 * n - i - j) % mod * invs_arr[2 * n - i] % mod) % mod\n                if j >= k:\n                    ans = (ans + p[i - 1][j]) % mod\n    if k <= 1:\n        ans = (ans + p[2 * n - 1][1]) % mod\n    ans = ans * l % mod * invs_arr[2 * n + 1] % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-2.264974000354414e-06, -3.576278118089249e-07, 0.0, -5.447716102935374e-05, -0.00010585224663373083, -2.3841855067985307e-07, -0.0015111466636881232, -0.041638389229774475, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07, -3.576278118