    if self.count >= len(self.data):\n            new_data = [0] * (len(self.data) * 2)\n            for i in range(len(self.data)):\n                new_data[i] = self.data[i]\n            self.data = new_data\n        self.data[self.count] = value\n        self.count += 1\n\n    def size(self):\n        return self.count\n\n    def get(self, index):\n        return self.data[index]\n\nclass Modulus:\n    def __init__(self):\n        self.factorials = IntStack()\n        self.inverseFactorials = IntStack()\n        self.factorials.push(1)\n        self.inverseFactorials.push(1)\n\n    def modulus(self):\n        raise NotImplementedError()\n\n    def sum(self, a, b):\n        v = a + b\n        return v if v < self.modulus() else v - self.modulus()\n\n    def difference(self, a, b):\n        v = a - b\n        return v if v >= 0 else v + self.modulus()\n\n    def multiply(self, a, b):\n        return (a * b) % self.modulus()\n\n    def inverse(self, value):\n        g, x, y = self.modulus(), 0, 1\n        r = value\n        while r != 0:\n            q = g // r\n            g %= r\n            g, r = r, g\n            x -= q * y\n            x, y = y, x\n        result = x % self.modulus()\n        return result if result >= 0 else result + self.modulus()\n\nclass Mod998(Modulus):\n    def __init__(self):\n        super().__init__()\n\n    def modulus(self):\n        return 998244353\n\n    def precomputeFactorials(self, maxN):\n        while self.factorials.size() <= maxN:\n            size = self.factorials.size()\n            next_val = self.multiply(self.getFactorial(size - 1), size)\n            self.factorials.push(int(next_val))\n        while self.inverseFactorials.size() <= maxN:\n            size = self.inverseFactorials.size()\n            inv = self.modularInverse(size)\n            self.inverseFactorials.push(int(inv))\n\n    def getFactorial(self, n):\n        return self.factorials.get(n)\n\n    def modularInverse(self, n):\n        return self.multiply(self.inverseFactorials.get(n), self.getFactorial(n - 1))\n\n    def binomial(self, n, r):\n        if r < 0 or n < r:\n            return 0\n        return self.multiply(self.getFactorial(n), self.multiply(self.inverseFactorials.get(r), self.inverseFactorials.get(n - r)))\n\nclass InputProcessor:\n    def __init__(self, stream):\n        self.reader = sys.stdin\n        self.tokenizer = None\n\n    def next(self):\n        while self.tokenizer is None or not self.tokenizer:\n            line = self.reader.readline()\n            if not line:\n                raise RuntimeError(\"No more input\")\n            self.tokenizer = line.strip().split()\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\ndef main():\n    processor = InputProcessor(sys.stdin)\n    n = processor.nextInt()\n    m = processor.nextInt()\n    \n    mod = Mod998()\n    mod.precomputeFactorials(n + m)\n    \n    phaseSize = 1\n    p = 1\n    i = 0\n    while p != 0:\n        p = mod.multiply(mod.multiply(p, n - i), mod.modularInverse(n + m - i))\n        phaseSize = mod.sum(phaseSize, p)\n        i += 1\n    \n    result = 0\n    for k in range(1, n + 1):\n        phases = mod.multiply(m + k, mod.modularInverse(k))\n        term = mod.multiply(mod.binomial(n, k), mod.multiply(phases, phaseSize))\n        if k % 2 == 1:\n            result = mod.sum(result, term)\n        else:\n            result = mod.difference(result, term)\n    \n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011193125828867778, -5.602820692729438e-06, -4.768370445162873e-07, -0.02253950573503971, -0.0004758894501719624, -0.049457695335149765, -0.4746395945549011, -0.0737331435084343, -8.344646857949556e-07, -0.011137106455862522, -0.006800482980906963, -0.0001829695247579366, -0.5283026099205017, -2.9802276912960224e-06, -1.6689286894688848e-06, -6.687417771900073e-05, -9.536738616