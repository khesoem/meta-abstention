):\n        result = 1\n        base %= self.MOD\n        while exp > 0:\n            if exp & 1:\n                result = (result * base) % self.MOD\n            base = (base * base) % self.MOD\n            exp >>= 1\n        return result\n\n    def nc(self):\n        return self.ns()[0]\n\n    def nLine(self):\n        try:\n            return self.br.readline()\n        except Exception:\n            return \"-1\"\n\n    def nd(self):\n        return float(self.ns())\n\n    def nl(self):\n        return int(self.ns())\n\n    def ni(self):\n        return int(self.ns())\n\n    def ns(self):\n        if self.tokenizer is None or not self.tokenizer:\n            try:\n                line = self.br.readline()\n                self.tokenizer = line.strip().split()\n            except Exception:\n                raise Exception(\"Input mismatch\")\n        return self.tokenizer.pop(0)\n\n    def run(self):\n        self.br = sys.stdin\n        self.out = sys.stdout\n        self.solve()\n        self.out.flush()\n\nif __name__ == \"__main__\":\n    utkarsh_v1().run()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-8.630380034446716e-05, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.0002526917669456452, -0.0022884628269821405, -0.00011002412065863609, -0.006078210659325123, -0.016030944883823395, -0.048590850085020065, -0.5369671583175659, -0.41471558809280396, -6.079655122448457e-06, -1.6689286894688848e-06, -5.304672595229931e-05, -3.421248038648628e-05, -2.253030106658116e-05, -0.25194135308265686, -0.20144033432006836, -1.2278481335670222e-05, -1.311301275563892e-06, -4.768370445162873e-07, -5.960462772236497e-07, -9.536738616588991e-07, -3.933898824470816e-06, -4.076874756719917e-05, -0.25592419505119324, -1.1920928244535389e-07, 0.0, -1.1920922133867862e-06, -8.344646857949556e-07, -1.0728830375228426e-06, -1.3828182090946939e-05, -5.960462772236497e-07, -2.3841830625315197e-06, -2.1576648578047752e-05, -4.6491513785440475e-0