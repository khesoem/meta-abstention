{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\nconstexpr ll INF = 1e18;\nconstexpr int MAXN = 6000;\n\nstruct Edge { int to,cap,cost,rev; };\n\nint n,s,t;\nvector<Edge> G[MAXN];\nll dist[MAXN]; \nint prevv[MAXN], preve[MAXN];\nbool inq[MAXN];\n\nvoid cleargraph(int nodes,int src,int sink) {\n    for(int i=0;i<=nodes;i++) G[i].clear();\n    n=nodes; s=src; t=sink;\n}\n\nvoid link(int u,int v,int cap,int cost) {\n    G[u].emplace_back(v,cap,cost,(int)G[v].size());\n    G[v].emplace_back(u,0,-cost,(int)G[u].size()-1);\n}\n\nll mcmf(int need) {\n    ll ans=0;\n    while(need>0) {\n        fill(dist,dist+n,INF);\n        dist[s]=0;\n        queue<int> q; q.push(s);\n        memset(inq,0,sizeof(inq));\n        inq[s]=true;\n        \n        while(!q.empty()) {\n            int u=q.front(); q.pop(); inq[u]=false;\n            for(int i=0;i<(int)G[u].size();i++) {\n                Edge& e=G[u][i];\n                if(e.cap>0 && dist[u]+e.cost<dist[e.to]) {\n                    dist[e.to]=dist[u]+e.cost;\n                    prevv[e.to]=u; preve[e.to]=i;\n                    if(!inq[e.to]) { inq[e.to]=true; q.push(e.to); }\n                }\n            }\n        }\n        if(dist[t]==INF) return -1;\n        \n        int flow=need;\n        for(int v=t;v!=s;v=prevv[v]) flow=min(flow,G[prevv[v]][preve[v]].cap);\n        need-=flow;\n        ans+=1LL*flow*dist[t];\n        \n        for(int v=t;v!=s;v=prevv[v]) {\n            Edge& e=G[prevv[v]][preve[v]]; \n            e.cap-=flow;\n            G[v][e.rev].cap+=flow;\n        }\n    }\n    return ans;\n}\n\nint N,M,K,C,D;\nint A[58];\nvector<int> H[58];\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(0); cout.tie(0);\n    cin>>N>>M>>K>>C>>D;\n    for(int i=0;i<K;i++) { int x; cin>>x; A[x]++; }\n    for(int i=0;i<M;i++) { int u,v; cin>>u>>v; H[u].push_back(v); H[v].push_back(u); }\n    \n    cleargraph(5103,0,5101);\n    for(int i=2;i<=N;i++) link(0,i,A[i],0);\n    \n    for(int lvl=0;lvl<=100;lvl++) {\n        for(int node=1;node<=N;node++) {\n            link(50*lvl+node,50*(lvl+1)+node,K,0);\n            for(int nb:H[node]) {\n                for(int k=1;k<=K;k++) {\n                    link(50*lvl+node,50*(lvl+1)+nb,1,D*(2*k-1));\n                }\n            }\n        }\n    }\n    for(int lvl=1;lvl<=101;lvl++) link(50*lvl+1,5101,K,C*lvl);\n    \n    cout<<mcmf(K)<<'\\n';\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, cap, cost, rev;\n        Edge(int to, int cap, int cost, int rev) {\n            this.to = to;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static final long INF = (long)1e18;\n    static final int MAXN = 6000;\n\n    static int n, s, t;\n    static List<Edge>[] G = new List[MAXN];\n    static long[] dist = new long[MAXN];\n    static int[] prevv = new int[MAXN];\n    static int[] preve = new int[MAXN];\n    static boolean[] inq = new boolean[MAXN];\n\n    static void cleargraph(int nodes, int src, int sink) {\n        for (int i = 0; i <= nodes; i++) {\n            G[i] = new ArrayList<>();\n        }\n        n = nodes;\n        s = src;\n        t = sink;\n    }\n\n    static void link(int u, int v, int cap, int cost) {\n        G[u].add(new Edge(v, cap, cost, G[v].size()));\n        G[v].add(new Edge(u, 0, -cost, G[u].size() - 1));\n    }\n\n    static long mcmf(int need) {\n        long ans = 0;\n        while (need > 0) {\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            Arrays.fill(inq, false);\n            inq[s] = true;\n\n            while (!q.isEmpty()) {\n                int u = q.poll();\n                inq[u] = false;\n                for (int i = 0; i < G[u].size(); i++) {\n                    Edge e = G[u].get(i);\n                    if (e.cap > 0 && dist[u] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) {\n                return -1;\n            }\n\n            int flow = need;\n            for (int v = t; v != s; v = prevv[v]) {\n                flow = Math.min(flow, G[prevv[v]].get(preve[v]).cap);\n            }\n            need -= flow;\n            ans += (long) flow * dist[t];\n\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = G[prevv[v]].get(preve[v]);\n                e.cap -= flow;\n                G[v].get(e.rev).cap += flow;\n            }\n        }\n        return ans;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = sc.nextInt();\n        int K = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        int[] A = new int[58];\n        List<Integer>[] H = new List[58];\n        for (int i = 0; i < 58; i++) {\n            H[i] = new ArrayList<>();\n        }\n\n        for (int i = 0; i < K; i++) {\n            int x = sc.nextInt();\n            A[x]++;\n        }\n\n        for (int i = 0; i < M; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            H[u].add(v);\n            H[v].add(u);\n        }\n\n        cleargraph(5103, 0, 5101);\n        for (int i = 2; i <= N; i++) {\n            link(0, i, A[i], 0);\n        }\n\n        for (int lvl = 0; lvl <= 100; lvl++) {\n            for (int node = 1; node <= N; node++) {\n                link(50 * lvl + node, 50 * (lvl + 1) + node, K, 0);\n                for (int nb : H[node]) {\n                    for (int k = 1; k <= K; k++) {\n                        link(50 * lvl + node, 50 * (lvl + 1) + nb, 1, D * (2 * k - 1));\n                    }\n                }\n            }\n        }\n\n        for (int lvl = 1; lvl <= 101; lvl++) {\n            link(50 * lvl + 1, 5101, K, C * lvl);\n        }\n\n        System.out.println(mcmf(K));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00014065706636756659, -3.6954811548639555e-06, -5.960462772236497e-07, -0.004279740620404482, -5.018585216021165e-05, -0.2811587452888489, -0.20155034959316254, -1.8954096958623268e-05, -3.576278118089249e-07, -8.332382276421413e-05, -0.002805347554385662, -7.56950321374461e-05, -0.002751257736235857, -0.26968953013420105, -2.777537883957848e-05, -2.3841855067985307e-07, -7.152555099310121e-07, -9.298280929215252e-06, -3.576278118089249e-07, -3.671578815556131e-05, -1.9788545614574105e-05, 0.0, -3.6954811548639555e-06, 0.0, -3