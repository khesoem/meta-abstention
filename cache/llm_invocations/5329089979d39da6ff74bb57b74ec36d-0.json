low;\n    }\n\n    void solve() {\n        string line;\n        while (getline(cin, line)) {\n            if (line.empty()) continue;\n            stringstream ss(line);\n            int N, M, K, C, D;\n            ss >> N >> M >> K >> C >> D;\n\n            vector<int> start(K);\n            getline(cin, line);\n            stringstream ss2(line);\n            for (int i = 0; i < K; i++)\n                ss2 >> start[i];\n\n            vector<vector<int>> graph(N);\n            for (int i = 0; i < M; i++) {\n                getline(cin, line);\n                stringstream ss3(line);\n                int a, b;\n                ss3 >> a >> b;\n                a--; b--;\n                graph[a].push_back(b);\n                graph[b].push_back(a);\n            }\n\n            int T = N + K + 1;\n            int max_n = N * T + 1;\n            int max_m = K + (M * 2 * K + N) * (T - 1);\n            init(max_n, max_m);\n\n            for (int i = 0; i < N; i++) {\n                for (int s = 0; s < T - 1; s++) {\n                    int u = i * T + s;\n                    for (int j : graph[i]) {\n                        int v = j * T + s + 1;\n                        for (int x = 1; x <= K; x++)\n                            link(u, v, 1, C + (x * 2 - 1) * D);\n                    }\n                }\n            }\n\n            for (int i = 0; i < N; i++)\n                for (int s = 0; s < T - 1; s++) {\n                    int u = i * T + s, v = u + 1;\n                    link(u, v, K, i == 0 ? 0 : C);\n                }\n\n            for (int h = 0; h < K; h++)\n                link(max_n - 1, start[h] * T, 1, 0);\n\n            cout << edmonds_karp(max_n - 1, 0 * T + T - 1) << endl;\n        }\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    Solver solver;\n    solver.solve();\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.1934269170742482e-05, 0.0, 0.0, -6.270212179