n res;\n}\n\ni64 modMul(i64 a, i64 b) {\n    return ((a % MOD) * (b % MOD)) % MOD;\n}\n\ni64 modAdd(i64 a, i64 b) {\n    return ((a % MOD) + (b % MOD)) % MOD;\n}\n\ni32 query(i64 fixpre, i64 val) {\n    i64 res = 0;\n    for (int d = 0; d < 7; ++d) {\n        i64 offset = (val - fixpre * modPow(10, d)) % MOD2;\n        if (offset < 0) offset += MOD2;\n        auto it = lower_bound(pos[d].begin(), pos[d].end(), MOD2 - offset);\n        int p = it - pos[d].begin();\n        i64 term = modAdd(modAdd(res, sum[d]), \n                          modMul(offset, (i64)pos[d].size()));\n        term = modAdd(term, MOD2 * ((i64)pos[d].size() - p));\n        res = term % MOD;\n    }\n    return (i32)res;\n}\n\nvoid dfs1(i64 val, int d) {\n    i64 x = ((cnt2 - val) % MOD2 + MOD2) % MOD2;\n    pos[d].push_back((int)x);\n    cnt2++;\n    sum[d] = modAdd(sum[d], x);\n    if (d == 6) return;\n    for (int i = 0; i < 10; ++i) {\n        dfs1(val * 10 + i, d + 1);\n    }\n}\n\nvoid dfs2(i64 val) {\n    if (val * 1000000 + 999999 <= n && val * 10000000 > n) {\n        ans = modAdd(ans, query(val, cnt2 + 1));\n        cnt2 += (i64)pos[0].size() + (i64)pos[1].size() + \n                (i64)pos[2].size() + (i64)pos[3].size() + \n                (i64)pos[4].size() + (i64)pos[5].size() + \n                (i64)pos[6].size();\n    } else {\n        cnt2++;\n        i64 diff = ((cnt2 - val) % MOD2 + MOD2) % MOD2;\n        ans = modAdd(ans, diff);\n        for (int i = (val ? 0 : 1); i < 10; ++i) {\n            if (val * 10 + i <= n) {\n                dfs2(val * 10 + i);\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    dfs1(0, 0);\n    for (int i = 0; i < 7; ++i) {\n        sort(pos[i].begin(), pos[i].end());\n    }\n    \n    cin >> n;\n    cnt2 = -1;\n    dfs2(0);\n    cout << ans << '\\n';\n    \n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "re