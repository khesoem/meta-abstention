{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nconst int INF = 0x3f3f3f3f;\nconst int maxm = 2000015;\nconst int maxn = 105*55;\nint n, m, c, d, k;\n\nint read() {\n    int x = 0, f = 1;\n    char ch = getchar();\n    while (ch < '0' || ch > '9') { if (ch == '-') f = -1; ch = getchar(); }\n    while (ch >= '0' && ch <= '9') { x = x * 10 + ch - '0'; ch = getchar(); }\n    return x * f;\n}\n\nstruct Edge {\n    int to, next, cap, flow, cost;\n} edge[maxm];\n\nint head[maxn], tol;\nint pre[maxn], dis[maxn];\nbool vis[maxn];\nint N;\n\nvoid init(int n) {\n    N = n;\n    tol = 0;\n    memset(head, -1, sizeof(head));\n}\n\nvoid addedge(int u, int v, int cap, int cost) {\n    edge[tol] = {v, head[u], cap, 0, cost};\n    head[u] = tol++;\n    edge[tol] = {u, head[v], 0, 0, -cost};\n    head[v] = tol++;\n}\n\nbool spfa(int s, int t) {\n    queue<int> q;\n    fill(dis, dis + N, INF);\n    fill(vis, vis + N, false);\n    fill(pre, pre + N, -1);\n    dis[s] = 0;\n    vis[s] = true;\n    q.push(s);\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        vis[u] = false;\n        for (int i = head[u]; ~i; i = edge[i].next) {\n            int v = edge[i].to;\n            if (edge[i].cap > edge[i].flow && dis[v] > dis[u] + edge[i].cost) {\n                dis[v] = dis[u] + edge[i].cost;\n                pre[v] = i;\n                if (!vis[v]) {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    return pre[t] != -1;\n}\n\nint minCostMaxflow(int s, int t, int &cost) {\n    int flow = 0;\n    cost = 0;\n    while (spfa(s, t)) {\n        int Min = INF;\n        for (int i = pre[t]; ~i; i = pre[edge[i^1].to])\n            Min = min(Min, edge[i].cap - edge[i].flow);\n        for (int i = pre[t]; ~i; i = pre[edge[i^1].to]) {\n            edge[i].flow += Min;\n            edge[i^1].flow -= Min;\n            cost += edge[i].cost * Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\n\nint point(int x, int y) { return (x-1)*50 + y; }\n\nint main() {\n    int S = 101*55, T = S + 1;\n    n = read(), m = read(), k = read(), c = read(), d = read();\n    int tmp;\n    init(T+1);\n    for (int i = 1; i <= k; i++) {\n        tmp = read();\n        addedge(S, tmp, 1, 0);\n    }\n    for (int i = 1; i <= 50; i++) {\n        for (int j = 1; j <= 103; j++) {\n            int x = point(j, i), y = point(j+1, i);\n            addedge(x, y, INF, c);\n        }\n    }\n    for (int i = 0; i < 102; i++) {\n        int tmp = i*50+1;\n        addedge(tmp, T, INF, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        int u, v;\n        u = read(), v = read();\n        for (int j = 1; j <= 102; j++) {\n            int x = point(j, u), x1 = point(j+1, u);\n            int y1 = point(j+1, v), y = point(j, v);\n            for (int k = 0; k < 50; k++) {\n                int val = d*(k*2+1)+c;\n                addedge(x, y1, 1, val);\n                addedge(y, x1, 1, val);\n            }\n        }\n    }\n    int cost = 0;\n    minCostMaxflow(S, T, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 0x3f3f3f3f\nmaxm = 2000015\nmaxn = 105 * 55\n\ndef read():\n    x = 0\n    f = 1\n    ch = sys.stdin.read(1)\n    while ch < '0' or ch > '9':\n        if ch == '-':\n            f = -1\n        ch = sys.stdin.read(1)\n    while ch >= '0' and ch <= '9':\n        x = x * 10 + ord(ch) - ord('0')\n        ch = sys.stdin.read(1)\n    return x * f\n\nclass Edge:\n    __slots__ = ('to', 'next', 'cap', 'flow', 'cost')\n    def __init__(self, to, next_edge, cap, flow, cost):\n        self.to = to\n        self.next = next_edge\n        self.cap = cap\n        self.flow = flow\n        self.cost = cost\n\nedge = [None] * maxm\nhead = [-1] * maxn\ntol = 0\npre = [-1] * maxn\ndis = [INF] * maxn\nvis = [False] * maxn\nN = 0\n\ndef init(n):\n    global N, tol, head, edge, pre, dis, vis\n    N = n\n    tol = 0\n    head = [-1] * N\n\ndef addedge(u, v, cap, cost):\n    global tol\n    edge[tol] = Edge(v, head[u], cap, 0, cost)\n    head[u] = tol\n    tol += 1\n    edge[tol] = Edge(u, head[v], 0, 0, -cost)\n    head[v] = tol\n    tol += 1\n\ndef spfa(s, t):\n    global dis, vis, pre\n    q = deque()\n    dis = [INF] * N\n    vis = [False] * N\n    pre = [-1] * N\n    dis[s] = 0\n    vis[s] = True\n    q.append(s)\n    while q:\n        u = q.popleft()\n        vis[u] = False\n        i = head[u]\n        while i != -1:\n            v = edge[i].to\n            if edge[i].cap > edge[i].flow and dis[v] > dis[u] + edge[i].cost:\n                dis[v] = dis[u] + edge[i].cost\n                pre[v] = i\n                if not vis[v]:\n                    vis[v] = True\n                    q.append(v)\n            i = edge[i].next\n    return pre[t] != -1\n\ndef minCostMaxflow(s, t):\n    global dis, vis, pre\n    flow = 0\n    cost = 0\n    while spfa(s, t):\n        Min = INF\n        i = pre[t]\n        while i != -1:\n            Min = min(Min, edge[i].cap - edge[i].flow)\n            i = pre[edge[i ^ 1].to]\n        i = pre[t]\n        while i != -1:\n            edge[i].flow += Min\n            edge[i ^ 1].flow -= Min\n            cost += edge[i].cost * Min\n            i = pre[edge[i ^ 1].to]\n        flow += Min\n    return flow\n\ndef point(x, y):\n    return (x - 1) * 50 + y\n\ndef main():\n    global head, edge, pre, dis, vis\n    S = 101 * 55\n    T = S + 1\n    n = read()\n    m = read()\n    k = read()\n    c = read()\n    d = read()\n    init(T + 1)\n    for _ in range(k):\n        tmp = read()\n        addedge(S, tmp, 1, 0)\n    for i in range(1, 51):\n        for j in range(1, 104):\n            x = point(j, i)\n            y = point(j + 1, i)\n            addedge(x, y, INF, c)\n    for i in range(102):\n        tmp = i * 50 + 1\n        addedge(tmp, T, INF, 0)\n    for _ in range(m):\n        u = read()\n        v = read()\n        for j in range(1, 103):\n            x = point(j, u)\n            x1 = point(j + 1, u)\n            y1 = point(j + 1, v)\n            y = point(j, v)\n            for k_val in range(50):\n                val = d * (k_val * 2 + 1) + c\n                addedge(x, y1, 1, val)\n                addedge(y, x1, 1, val)\n    cost = 0\n    minCostMaxflow(S, T)\n    # We need to compute cost separately since minCostMaxflow doesn't return it\n    # Recompute cost by traversing edges into T\n    cost = 0\n    i = head[T]\n    while i != -1:\n        if edge[i].flow > 0:\n            cost += -edge[i].cost * edge[i].flow\n        i = edge[i].next\n    print(cost)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0001389883691444993, -8.344646857949556e-07, -1.1920928244535389e-07, -0.0008466235012747347, -0.00035339308669790626, -1.5497195136049413e-06, -0.0009178477921523154, -0.00029416524921543896, -1.4305104514278355e-06, -0