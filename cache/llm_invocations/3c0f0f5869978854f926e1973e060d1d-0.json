back(idx - 1);\n    }\n\n    bool bellman_ford(int s, int t, int &flow, int &cost) {\n        fill(dist, dist + t + 1, INT_MAX);\n        fill(inq, inq + t + 1, false);\n        dist[s] = 0;\n        inq[s] = true;\n        queue<int> q;\n        q.push(s);\n\n        while (!q.empty()) {\n            int u = q.front(); q.pop();\n            inq[u] = false;\n\n            for (int eid : G[u]) {\n                Edge& e = E[eid];\n                if (e.cap > e.flow && dist[e.to] > dist[u] + e.cost) {\n                    dist[e.to] = dist[u] + e.cost;\n                    prevV[e.to] = u;\n                    prevE[e.to] = eid;\n                    if (!inq[e.to]) {\n                        inq[e.to] = true;\n                        q.push(e.to);\n                    }\n                }\n            }\n        }\n\n        if (dist[t] == INT_MAX) return false;\n        int f = INT_MAX;\n        for (int v = t; v != s; v = prevV[v]) {\n            f = min(f, E[prevE[v]].cap - E[prevE[v]].flow);\n        }\n        flow += f;\n        cost += dist[t] * f;\n        for (int v = t; v != s; v = prevV[v]) {\n            E[prevE[v]].flow += f;\n            E[prevE[v] ^ 1].flow -= f;\n        }\n        return true;\n    }\n\n    int compute(int s, int t) {\n        int total_flow = 0, total_cost = 0;\n        while (bellman_ford(s, t, total_flow, total_cost));\n        return total_cost;\n    }\n} solver;\n\nint main() {\n    N = read(); M = read(); K = read(); C = read(); D = read();\n\n    for (int i = 1; i <= K; ++i) A[i] = read();\n\n    src = 0; dst = N * 100 + 1;\n\n    for (int i = 1; i <= K; ++i) {\n        solver.link(src, 1 + (A[i] - 1) * 100, 1, 0);\n    }\n\n    for (int i = 1; i <= N; ++i) {\n        int base = (i - 1) * 100LL;\n        for (int j = 1; j < 100; ++j) {\n            solver.link(base + j, base + j + 1, INT_MAX, C);\n        }\n    }\n\n    for (int i = 1; i <= 100; ++i) {\n        solver.link(i, dst, INT_MAX, 0);\n    }\n\n    while (M--) {\n    