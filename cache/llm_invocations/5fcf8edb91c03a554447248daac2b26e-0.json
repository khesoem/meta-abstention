{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\ntypedef long long int64;\n\nconst int MAXN = 250250;\nint64 fact[MAXN], rfact[MAXN];\nint64 g[MAXN][17];\nint n, k, p;\n\nint64 mod_pow(int64 a, int b, int m) {\n    int64 res = 1;\n    while (b) {\n        if (b & 1) res = res * a % m;\n        a = a * a % m;\n        b /= 2;\n    }\n    return res;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(0);\n    cin >> n >> k >> p;\n    if (n % 2 == 1) {\n        cout << mod_pow(k, n, p) << \"\\n\";\n        return 0;\n    }\n\n    fact[0] = 1;\n    rfact[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        fact[i] = fact[i - 1] * i % p;\n        rfact[i] = mod_pow(fact[i], p - 2, p);\n    }\n\n    g[0][0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        if ((i & n) != i) continue;\n\n        vector<int> bit;\n        bit.reserve(18);\n        for (int b = 0; b < 18; ++b) {\n            if ((1 << b) & i) bit.push_back(b);\n        }\n\n        int first_bit = bit[0];\n        int szbits = (int)bit.size();\n        int total = 1 << (szbits - 1);\n\n        for (int mask = 0; mask < total; ++mask) {\n            int l = 1 << first_bit;\n            for (int pos = 1; pos < szbits; ++pos) {\n                if (mask & (1 << (pos - 1))) {\n                    l |= (1 << bit[pos]);\n                }\n            }\n            for (int j = 1; j < 17; ++j) {\n                g[i][j] += rfact[l] * g[i ^ l][j - 1];\n                g[i][j] %= p;\n            }\n        }\n\n        for (int j = 0; j < 17; ++j) g[i][j] %= p;\n    }\n\n    int64 ans = 0;\n    for (int i = 1; i <= min(16, k); ++i) {\n        g[n][i] %= p;\n        int64 cur = fact[n] * g[n][i] % p;\n        cur = cur * fact[k] % p;\n        cur = cur * rfact[k - i] % p;\n        ans = (ans + cur) % p;\n    }\n\n    ans = mod_pow(k, n, p) - ans;\n    if (ans < 0) ans += p;\n    cout << ans << \"\\n\";\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_pow(a, b, m):\n    return pow(a, b, m)\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    p = int(data[2])\n\n    if n % 2 == 1:\n        print(mod_pow(k, n, p))\n        return\n\n    fact = [1] * (n + 1)\n    rfact = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fact[i] = fact[i-1] * i % p\n        rfact[i] = pow(fact[i], p-2, p)\n\n    # g[i][j] for i up to n, j up to 16\n    g = [[0]*17 for _ in range(n+1)]\n    g[0][0] = 1\n\n    for i in range(1, n+1):\n        if (i & n) != i:\n            continue\n\n        # extract bits of i\n        bits = []\n        for b in range(18):\n            if (1 << b) & i:\n                bits.append(b)\n        first_bit = bits[0]\n        szbits = len(bits)\n        total = 1 << (szbits - 1)\n\n        for mask in range(total):\n            l = 1 << first_bit\n            for pos in range(1, szbits):\n