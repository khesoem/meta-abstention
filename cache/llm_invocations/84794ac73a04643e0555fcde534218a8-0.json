er(System.in);\n        \n        n = sc.nextInt();\n        int k = sc.nextInt();\n        mod = sc.nextLong();\n        \n        init_combinatorics(n + 5, mod);\n        \n        if (n % 2 == 1) {\n            System.out.println(modPow(k, n, mod));\n            return;\n        }\n        \n        subset_list.clear();\n        for (int i = 2; i <= n; i += 2) {\n            if ((i & n) == i) {\n                subset_list.add(i);\n            }\n        }\n        \n        for (int i = 0; i < 20; i++) {\n            Arrays.fill(dp[i], 0);\n        }\n        dp[0][n] = 1;\n        long total = 0;\n        int max_layer = Math.min(17, k);\n        \n        for (int layer = 1; layer <= max_layer; ++layer) {\n            long layer_sum = 0;\n            for (int idx = 0; idx < subset_list.size(); ++idx) {\n                int val = subset_list.get(idx);\n                if (dp[layer-1][val] == 0) continue;\n                \n                int sub = val & (val - 1);\n                int delta = sub ^ val;\n                \n                for (int cur = delta; cur <= sub; cur += delta) {\n                    if ((cur & sub) == cur) {\n                        dp[layer][cur] = (dp[layer][cur] + \n                            dp[layer-1][val] * fact[val] % mod * \n                            inv_table[cur] % mod * inv_table[val - cur] % mod) % mod;\n                    }\n                }\n                layer_sum = (layer_sum + dp[layer-1][val]) % mod;\n            }\n            total = (total + layer_sum * inv_table[k - layer] % mod) % mod;\n        }\n        \n        total = total * fact[k] % mod;\n        long result = (modPow(k, n, mod) - total % mod + mod) % mod;\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00012706902634818107, -1.6689286894688848e-06, -5.960462772236497e-07, -0.0018129594391211867, -1.8358061424805783e-05, -0.12748239934444427, -0.07004816085100174, -8.165