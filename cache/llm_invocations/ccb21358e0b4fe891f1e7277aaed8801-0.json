       continue\n            for j in range(n - i):\n                tmp[i + j] = (tmp[i + j] + base[i] * base[j]) % p\n        base = tmp\n        k >>= 1\n    return res\n\ndef subset_pow_convol(a, k, p):\n    logn = 19\n    n = len(a)\n    while n != (n & -n):\n        n += n & -n\n    fa = [[0] * n for _ in range(logn)]\n    fc = [[0] * n for _ in range(logn)]\n    for i in range(logn):\n        for j in range(n):\n            if j < len(a) and j.bit_count() == i:\n                fa[i][j] = a[j]\n            else:\n                fa[i][j] = 0\n            fc[i][j] = 0\n        transform(fa[i], n, p, 0)\n    for i in range(n):\n        va = [fa[j][i] for j in range(logn)]\n        va = pow_convol(va, k, p)\n        for j in range(logn):\n            fc[j][i] = va[j]\n    for i in range(logn):\n        transform(fc[i], n, p, 1)\n    res = [0] * n\n    for i in range(logn):\n        for j in range(n):\n            if j.bit_count() == i:\n                res[j] = fc[i][j]\n    return res\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    p = int(next(it))\n    nn = n\n    f = [0] * (n + 1)\n    max_t = 0\n    for i in range(n + 1):\n        if (n & i) == i:\n            t = 0\n            for j in range(20):\n                if (n >> j) & 1:\n                    t <<= 1\n                    t |= ((i >> j) & 1)\n            f[t] = i\n            if t > max_t:\n                max_t = t\n    nn = max_t\n    if n & 1:\n        print(fpow(k, n, p))\n        return\n    maxn = 1000005\n    fac = [1] * maxn\n    for i in range(1, maxn):\n        fac[i] = mult(fac[i - 1], i, p)\n    ifac = [0] * maxn\n    for i in range(maxn):\n        ifac[i] = inv(fac[i], p)\n    a = [0] * (nn + 1)\n    for i in range(nn + 1):\n        a[i] = ifac[f[i]]\n    res = fpow(k, n, p)\n    a = subset_pow_convol(a, k, p)\n    res = submod(res, mult(a[nn], fac[n], p), p)\n    print(res)\n