f.cap[x][i] -= f\n        self.cap[y][j] += f\n        return f\n\n    def solve(self, s, t):\n        ans = 0\n        tot = 0\n        INF_FLOW = 100000000\n        while True:\n            self.spfa(s)\n            if self.dist[t] > 1e9:\n                break\n            f = self.dfs(t, INF_FLOW)\n            tot += f * self.dist[t]\n            ans += f\n        return (ans, tot)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    nn = 6000\n    mcmf = MCMF(nn)\n    s = nn - 1\n    t = nn - 2\n\n    kk = k\n    for _ in range(k):\n        x = int(next(it))\n        mcmf.add_edge(s, get(x, 1), 1, 0)\n    k = kk\n\n    cost_j = [0] * (k + 1)\n    for j in range(1, k + 1):\n        cost_j[j] = d * (2 * j - 1)\n\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                mcmf.add_edge(get(x, i), get(y, i + 1), 1, cost_j[j])\n                mcmf.add_edge(get(y, i), get(x, i + 1), 1, cost_j[j])\n\n    INF_CAP = 100000000\n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            mcmf.add_edge(get(j, i), get(j, i + 1), INF_CAP, 0)\n        mcmf.add_edge(get(1, i), t, INF_CAP, c * (i - 1))\n\n    ans = mcmf.solve(s, t)[1]\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.556489552167477e-06, -2.0265558760002023e-06, 0.0, 0.0, 0.0, -0.0001299296854995191, -0.6065306663513184, -3.755022044060752e-05, -0.005460940767079592, -3.683499380713329e-05, -0.001312943291850388, -4.7444173105759546e-05, -9.417489309271332e-06, -0.01905493438243866, -1.7881233361549675e-05, -1.5497195136049413e-06, -1.1920928244535389e-07, -8.344646857949556e-07, -5.960462772236497e-07, 0.0, 0.0, 0.0, -3.57627811