ng p){\n        long res = 1;\n        x = x % p;\n\n        while (y > 0) {\n\n            if (y % 2 == 1)\n                res = (res * x) % p;\n\n            y = y >> 1;\n            x = (x * x) % p;\n        }\n\n        return res;\n    }\n\n}\n\n</original_code>\n\n<translated_code>\nimport sys\n\nMOD = 998244353\nstirling = [[0 for _ in range(5001)] for _ in range(5001)]\n\ndef main():\n    stirling[0][0] = 1\n    for i in range(1, 5001):\n        for j in range(1, 5001):\n            stirling[i][j] = (stirling[i-1][j-1] % MOD) + (j*stirling[i-1][j]) % MOD\n            stirling[i][j] %= MOD\n\n    n, m, k = map(int, input().split())\n    p = mod_inverse(m, MOD)\n    val = 1\n    ans = 0\n    prob = 1\n    for i in range(k, 0, -1):\n        val *= (n - (k - i))\n        val %= MOD\n        prob *= p\n        prob %= MOD\n        ans += (((val * prob) % MOD) * stirling[k][k - i + 1]) % MOD\n        ans %= MOD\n    print(ans)\n\ndef mod_inverse(x, p):\n    return power(x, p - 2, p)\n\ndef power(x, y, p):\n    res = 1\n    x = x % p\n    while y > 0:\n        if y % 2 == 1:\n            res = (res * x) % p\n        y = y >> 1\n        x = (x * x) % p\n    return res\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.03442329913377762, -0.00011778571206377819, -0.2828740179538727, -0.01161336898803711, -0.006030587013810873, -0.0006352892378345132, -0.0022324188612401485, -4.7565637942170724e-05, -1.23978434203309e-05, -0.0004545887350104749, -0.14471380412578583, -0.0015268651768565178, -9.536747711536009e-07, -2.396135460003279e-05, -3.755163197638467e-05, -0.0002500727423466742, -1.23978434203309e-05, -2.3841860752327193e-07, -0.0010570507729426026, -2.6822450308827683e-05, -1.9431303371675313e-05, -1.23978434203309e-05, -2.0265599687263602e-06, -1.1920930376163597e-07, -0.00010741333971964195, -1.0728893357736524e-05, -1.9073504518019035e-06, -1.1920930376163597e-07, -4.291543518775143e-