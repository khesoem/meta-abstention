{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nusing ll = long long;\n\nconst int MAXN = 262144;\n\nint L, n, k, mod, len;\nint fac[MAXN], inv[MAXN], popcnt[MAXN], g[20][MAXN], f[20][MAXN];\nvector<int> bits;\nll h[20], p[20];\n\ninline int mod_pow(int x, int y) {\n    int res = 1;\n    while (y) {\n        if (y & 1) res = (ll)res * x % mod;\n        x = (ll)x * x % mod;\n        y >>= 1;\n    }\n    return res;\n}\n\ninline void f_add(int &x, int y) {\n    x += y;\n    if (x >= mod) x -= mod;\n}\n\ninline void f_sub(int &x, int y) {\n    x -= y;\n    if (x < 0) x += mod;\n}\n\nvoid fwt(int *a, int m) {\n    for (int i = 1; i < m; i <<= 1)\n        for (int j = 0; j < m; j += i << 1)\n            for (int k = 0; k < i; k++)\n                f_add(a[j + k + i], a[j + k]);\n}\n\nvoid ifwt(int *a, int m) {\n    for (int i = 1; i < m; i <<= 1)\n        for (int j = 0; j < m; j += i << 1)\n            for (int k = 0; k < i; k++)\n                f_sub(a[j + k + i], a[j + k]);\n}\n\nvoid poly_ln() {\n    p[0] = 0;\n    for (int i = 1; i <= n; i++) {\n        p[i] = h[i] * i;\n        for (int j = 1; j < i; j++)\n            p[i] -= p[j] * h[i - j] % mod * j;\n        p[i] = p[i] % mod * inv[i] % mod;\n    }\n    for (int i = 0; i <= n; i++) h[i] = (p[i] + mod) % mod;\n}\n\nvoid poly_exp() {\n    p[0] = 1;\n    for (int i = 1; i <= n; i++) {\n        p[i] = 0;\n        for (int j = 1; j <= i; j++)\n            p[i] += h[j] * p[i - j] % mod * j;\n        p[i] = p[i] % mod * inv[i] % mod;\n    }\n    for (int i = 0; i <= n; i++) h[i] = p[i];\n}\n\nint main() {\n    scanf(\"%d%d%d\", &L, &k, &mod);\n    int all = mod_pow(k, L);\n\n    if (L & 1) {\n        printf(\"%d\\n\", all);\n        return 0;\n    }\n\n    fac[0] = 1;\n    for (int i = 1; i <= L; i++) fac[i] = (ll)fac[i - 1] * i % mod;\n\n    inv[L] = mod_pow(fac[L], mod - 2);\n    for (int i = L - 1; i >= 0; i--) inv[i] = (ll)inv[i + 1] * (i + 1) % mod;\n\n    for (int s = 1; s <= L; s++) popcnt[s] = popcnt[s ^ (s & -s)] + 1;\n\n    for (int i = 0; i < 19; i++)\n        if ((L >> i) & 1) bits.push_back(1 << i);\n\n    n = (int)bits.size();\n    len = 1 << n;\n\n    for (int mask = 0; mask < len; mask++) {\n        int s = 0;\n        for (int j = 0; j < n; j++)\n            if ((mask >> j) & 1) s += bits[j];\n        g[popcnt[mask]][mask] = inv[s];\n    }\n\n    for (int i = 2; i <= n; i++)\n        inv[i] = (ll)(mod - mod / i) * inv[mod % i] % mod;\n\n    for (int i = 0; i <= n; i++) fwt(g[i], len);\n\n    for (int mask = 0; mask < len; mask++) {\n        for (int i = 0; i <= n; i++) h[i] = g[i][mask];\n        poly_ln();\n        for (int i = 0; i <= n; i++) h[i] = h[i] * k;\n        poly_exp();\n        for (int i = 0; i <= n; i++) f[i][mask] = h[i];\n    }\n\n    ifwt(f[n], len);\n\n    int ans = (ll)f[n][len - 1] * fac[L] % mod;\n    ans = (all - ans + mod) % mod;\n\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_pow(x, y, mod):\n    return pow(x, y, mod)\n\ndef fwt(a, m):\n    i = 1\n    while i < m:\n        j = 0\n        while j < m:\n            for k in range(i):\n                a[j + k + i] = (a[j + k + i] + a[j + k]) % mod\n            j += i << 1\n        i <<= 1\n\ndef ifwt(a, m):\n    i = 1\n    while i < m:\n        j = 0\n        while j < m:\n            for k in range(i):\n                a[j + k + i] = (a[j + k + i] - a[j + k]) % mod\n            j += i << 1\n        i <<= 1\n\ndef poly_ln(h, n, inv):\n    p = [0] * (n + 1)\n    p[0] = 0\n    for i in range(1, n + 1):\n        p[i] = h[i] * i % mod\n        for j in range(1, i):\n            p[i] = (p[i] - p[j] * h[i - j] % mod * j) % mod\n        p[i] = p[i] * inv[i] % mod\n    for i in range(n + 1):\n        h[i] = (p[i] + mod) % mod\n\ndef poly_exp(h, n, inv):\n    p = [0] * (n + 1)\n    p[0] = 1\n    for i in range(1, n + 1):\n        p[i] = 0\n        for j in range(1, i + 1):\n            p[i] = (p[i] + h[j] * p[i - j] % mod * j) % mod\n        p[i] = p[i] * inv[i] % mod\n    for i in range(n + 1):\n        h[i] = p[i]\n\ndef main():\n    global mod\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    L = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n\n    all_val = mod_pow(k, L, mod)\n\n    if L & 1:\n        print(all_val)\n        return\n\n    # factorials and inverse factorials up to L\n    fac = [1] * (L + 1)\n    for i in range(1, L + 1):\n        fac[i] = fac[i - 1] * i % mod\n\n    inv_fact = [1] * (L + 1)\n    inv_fact[L] = mod_pow(fac[L], mod - 2, mod)\n    for i in range(L - 1, -1, -1):\n        inv_fact[i] = inv_fact[i + 1] * (i + 1) % mod\n\n    # popcnt for s = 1..L\n    popcnt = [0] * (L + 1)\n    for s in range(1, L + 1):\n        popcnt[s] = popcnt[s ^ (s & -s)] + 1\n\n    # bits from binary representation of L\n    bits = []\n    for i in range(19):\n        if (L >> i) & 1:\n            bits.append(1 << i)\n\n    n = len(bits)\n    m = 1 << n\n\n    # g and f arrays\n    g = [[0] * m for _ in range(n + 1)]\n    f = [[0] * m for _ in range(n + 1)]\n\n    for mask in range(m):\n        s = 0\n        for j in range(n):\n            if (mask >> j) & 1:\n                s += bits[j]\n        g[popcnt[s]][mask] = inv_fact[s]\n\n    # modular inverses of integers 1..n\n    inv = [0] * (n + 1)\n    if n >= 1:\n        inv[1] = 1\n    for i in range(2, n + 1):\n        inv[i] = (mod - mod // i) * inv[mod % i] % mod\n\n    # FWT for each i\n    for i in range(n + 1):\n        fwt(g[i], m)\n\n    # process each mask\n    h = [0] * (n + 1)\n    for mask in range(m):\n        for i in range(n + 1):\n            h[i] = g[i][mask]\n        poly_ln(h, n, inv)\n        for i in range(n + 1):\n            h[i] = h[i] * k % mod\n        poly_exp(h, n, inv)\n        for i in range(n + 1):\n            f[i][mask] = h[i]\n\n    # inverse FWT on f[n]\n    ifwt(f[n], m)\n\n    ans = f[n][m - 1] * fac[L] % mod\n    ans = (all_val - ans + mod) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0059246402233839035, -2.1934269170742482e-05, 0.0, -7.152555099310121e-07, -0.0003486264031380415, -0.010281809605658054, -3.6954811548639555e-06, -0.001515312702395022, -0.008072488009929657, -0.05408565327525139, -4.4225667807040736e-05, 0.0, -0.00013386306818574667, -0.0015031717484816909, 0.0, -0.12698128819465637, -7.521823135903105e-05, -0.00010311071673640981, -9.536738616588991e-07, -4.31528314948082e-05, 0.0, -4.768360213347478e-06, -1.156323378381785e-05, -1.1920928244535389e-07, -5.483612312673358e-06, -3.576278118089249e-07, -3.0874729418428615e-05, -5.745722592109814e-05, -0.007396456319838762, -0.07896201312541962, -0.0007107115816324949, -0.0004320403386373073, -0.0007366804056800902, -0.20143400132656097, -4.768370445162873e-07, -0.007303680758923292, -3.099436753473128e-06, -1.1920928244535389e-07, -7.152555099310121e-07