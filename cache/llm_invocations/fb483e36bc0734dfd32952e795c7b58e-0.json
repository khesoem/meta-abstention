\n\treturn u;\n}\n\nvoid add(int i, int j) {\n\tif (!edgePool1) {\n\t\tedgePool1 = new Node[M * 2 + 1];\n\t\tedgePool1 -= 1;\n\t}\n\tedgePool1->dest = j;\n\tedgePool1->next = aa[i].next;\n\taa[i].next = edgePool1++;\n}\n\nvoid add_(int i, int h) {\n\tif (!edgePool2) {\n\t\tedgePool2 = new Node[M_ * 2 + 1];\n\t\tedgePool2 -= 1;\n\t}\n\tedgePool2->dest = h;\n\tedgePool2->next = aa_[i].next;\n\taa_[i].next = edgePool2++;\n}\n\nint n_, m_;\nint uu[M_], vv[M_], uv[M_], cost[M_], cost_[M_];\nint cc[M_ * 2];\n\nvoid link(int u, int v, int cap, int cos) {\n\tint h = m_++;\n\tuu[h] = u;\n\tvv[h] = v;\n\tuv[h] = u ^ v;\n\tcost[h] = cos;\n\tcc[h << 1 ^ 0] = cap;\n\tadd_(u, h << 1 ^ 0);\n\tadd_(v, h << 1 ^ 1);\n}\n\nvoid dijkstra(int s) {\n\tfill(pi, pi + n_, INF);\n\tpi[s] = 0;\n\tpq_add(s);\n\twhile (cnt) {\n\t\tNode* l;\n\t\tint u = pq_remove_first(), v;\n\t\tint h, h_, p, k = kk[u] + 1;\n\t\tfor (l = aa_[u].next; l; l = l->next) {\n\t\t\tif (cc[h_ = l->dest]) {\n\t\t\t\th = h_ >> 1;\n\t\t\t\tp = pi[u] + ((h_ & 1) == 0 ? cost_[h] : -cost_[h]);\n\t\t\t\tv = u ^ uv[h];\n\t\t\t\tif (pi[v] == INF) {\n\t\t\t\t\tpi[v] = p;\n\t\t\t\t\tkk[v] = k;\n\t\t\t\t\tbb[v] = h_;\n\t\t\t\t\tpq_add(v);\n\t\t\t\t} else if (pi[v] > p || (pi[v] == p && kk[v] > k)) {\n\t\t\t\t\tpi[v] = p;\n\t\t\t\t\tkk[v] = k;\n\t\t\t\t\tbb[v] = h_;\n\t\t\t\t\tpq_up(v);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\nvoid push(int s, int t) {\n\tint u, h, h_;\n\tfor (u = t; u != s; u ^= uv[h]) {\n\t\th = (h_ = bb[u]) >> 1;\n\t\tcc[h_]--;\n\t\tcc[h_ ^ 1]++;\n\t}\n}\n\nint edmonds_karp(int s, int t) {\n\tint c, h;\n\tmemcpy(cost_, cost, m_ * sizeof *cost);\n\twhile (1) {\n\t\tdijkstra(s);\n\t\tif (pi[t] == INF) break;\n\t\tpush(s, t);\n\t\tfor (h = 0; h < m_; h++) {\n\t\t\tint u = uu[h], v = vv[h];\n\t\t\tif (pi[u] != INF && pi[v] != INF)\n\t\t\t\tcost_[h] += pi[u] - pi[v];\n\t\t}\n\t}\n\tc = 0;\n\tfor (h = 0; h < m_; h++)\n\t\tc += cost[h] * cc[h << 1 ^ 1];\n\treturn c;\n}\n\nint main() {\n\tvector<int> ii(K);\n\tint n, m, k,