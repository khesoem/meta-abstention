nvFactorial.size() - 1\n            if last_known < n:\n                f_inv = [0.0] * (n - last_known)\n                f_inv[0] = self.inv(self.fact(n))\n                for i in range(1, len(f_inv)):\n                    f_inv[i] = self.mult(f_inv[i - 1], n - i + 1)\n                for i in range(len(f_inv) - 1, -1, -1):\n                    self.invFactorial.push(int(f_inv[i]))\n            return self.invFactorial.get(n)\n\n        def ncr(self, n, r):\n            if n < 0:\n                raise AssertionError()\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n - r)))\n\n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n - 1))\n\n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult_two(r, x)\n            return r\n\n        def mult_two(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g, x, y = self.modulus(), 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g, r = r, g % r\n                x, y = y, x - q * y\n            if g != 1:\n                raise AssertionError(\"Modular inverse does not exist\")\n            return self.normalize(x)\n\n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\n\nclass HZSShufflesCards:\n    def __init__(self):\n        self.mod = NumberTheory.Mod998()\n        self.n = 0\n        self.m = 0\n\n    def solve(self, testNumber, in_reader, out):\n        self.n = in_reader.nextInt()\n        self.m = in_reader.nextInt()\n\n        phase_size = 1\n        p = 1\n        i = 0\n        while p != 0:\n            p = self.mod.mult(p, self.n - i, self.mod.smallInv(self.n + self.m - i))\n            phase_size = self.mod.add(phase_size, p)\n            i += 1\n\n        answer = 0\n        for k in range(1, self.n + 1):\n            num_phases = self.mod.mult(self.m + k, self.mod.smallInv(k))\n            term = self.mod.mult(self.mod.ncr(self.n, k), num_phases, phase_size)\n            if (k & 1) == 1:\n                answer = self.mod.add(answer, term)\n            else:\n                answer = self.mod.subtract(answer, term)\n\n        out.println(answer)\n\n\ndef main():\n    input_stream = sys.stdin\n    output_stream = sys.stdout\n\n    in_reader = InputReader(input_stream)\n    \n    class PrintWriter:\n        def __init__(self, stream):\n            self.stream = stream\n\n        def println(self, value):\n            self.stream.write(str(value) + '\\n')\n            self.stream.flush()\n\n    out = PrintWriter(output_stream)\n    solver = HZSShufflesCards()\n    solver.solve(1, in_reader, out)\n    out.stream.close()\n\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.961580220377073e-05, -5.960462772236497e-07, -5.960462772236497e-07, -0.0005806190893054008, -0.10070167481899261, -0.0037408152129501104, -0.10024184733629227, -0.73163241147995, -0.023310551419854164, -0.07132839411497116, -0.500820517539978, -1.9073468138230965e-06, -4.529942543740617e-06, -1.1920928244535389e-07, -5.960462772236497e-07, -9.917721035890281e-05, -1.6689286894688848e-06, -4.768370445162873e-07, -2.9802276912960224e-06, -3.576278118089249e-07, -2.8490614567999728e-05, -6.556489552167477e-06, -1.7881377516459906e-06, -2.002696055569686e-05, -0.00011598391574807465, -2.3841855067985307e-07, -0.008970200084149837, -0.00040177378