= num; smaller = den; }\n        else { greater = den; smaller = num; }\n\n        if (smaller == 0)\n        {\n            greater = 1;\n        }\n        else\n        {\n            while (smaller != 0)\n            {\n                rest = greater % smaller;\n                greater = smaller;\n                smaller = rest;\n            }\n        }\n\n        if (rest != 1)\n        {\n            num /= greater;\n            den /= greater;\n        }\n\n        cout << num << \"/\" << den << endl;\n    }\n\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        while (sc.hasNextLong()) {\n            long x = sc.nextLong();\n            long y = sc.nextLong();\n            long limit = sc.nextLong();\n            \n            long num, den, greater, smaller;\n            long rest = 1;\n            float best = 1.0f;\n            \n            if (y <= limit) {\n                num = x;\n                den = y;\n            } else {\n                double ratio = (double) x / (double) y;\n                best = 1.0f;\n                \n                for (long i = 1; i <= limit; i++) {\n                    long floor_val = i * x / y;\n                    \n                    float diff = (float) (ratio - (double) floor_val / (double) i);\n                    if (diff < best) {\n                        best = diff;\n                        num = floor_val;\n                        den = i;\n                    }\n                    \n                    diff = (float) ((double) (floor_val + 1) / (double) i - ratio);\n                    if (diff < best) {\n                        best = diff;\n                        num = floor_val + 1;\n                        den = i;\n                    }\n                }\n            }\n            \n            // At this point num and den are set; if y <= limit, they are x,y; else from loop.\n            if (num > den) {\n                greater = num;\n                smaller = den;\n            } else {\n                greater = den;\n                smaller = num;\n            }\n            \n            if (smaller == 0) {\n                greater = 1;\n            } else {\n                while (smaller != 0) {\n                    rest = greater % smaller;   // remainder\n                    greater = smaller;\n                    smaller = rest;\n                }\n            }\n            \n            if (rest != 1) {\n                num /= greater;\n                den /= greater;\n            }\n            \n            System.out.println(num + \"/\" + den);\n        }\n        \n        sc.close();\n    }\n}\n</translated_code>\n<confidence>0.95</confidence>", "token_logprobs": [-4.970903682988137e-05, -0.003959080204367638, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -7.128461584215984e-05, -6.6756979322235566e-06, -2.3841855067985307e-07, -0.0002321927313460037, -0.0025158440694212914, -0.0024986020289361477, -9.417489309271332e-06, -4.768370445162873e-07, -0.003077178495004773, -0.0003036991402041167, -3.6000557884108275e-05, -1.5139465176616795e-05, -7.152555099310121e-07, -8.344646857949556e-07, 0.0, -4.768360213347478e-06, -0.00016330339713022113, -5.960446742392378e-06, -4.8993817472364753e-05, -2.109982233378105e-05, -1.9073468138230965e-06, -0.0007578838267363608, -0.38778913021087646, -1.4305104514278355e-06, 0.0, -1.1920922133867862e-06, -8.583032467868179e-06, -8.344646857949556e-07, -0.07012662291526794, -1.7014758586883545, -3.576278118089249e-07, -0.006157001480460167, -6.4490144723095e-05, -0.20142288506031036, -2.3841855067985307e-07, -0.0025177467614412308, -8.583032467868179e-06, -1.1801649634435307e-05, -2.622600959512056e-06, -3.3