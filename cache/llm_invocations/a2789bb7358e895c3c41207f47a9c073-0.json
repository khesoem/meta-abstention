lf.minCost = 0\n        while True:\n            self.dist = [INF] * self.nodes\n            self.dist[s] = 0\n            self.pre = [-1] * self.nodes\n            self.pre[s] = 0\n            self.capacity = [0] * self.nodes\n            self.capacity[s] = INF\n            self.inQueue = [False] * self.nodes\n            q = deque()\n            q.append(s)\n            self.inQueue[s] = True\n            while q:\n                u = q.popleft()\n                self.inQueue[u] = False\n                for it in self.adj[u]:\n                    f = self.edges[it]\n                    if f.rem() > 0 and self.dist[f.v] > self.dist[u] + f.cost + 1e-9:\n                        self.dist[f.v] = self.dist[u] + f.cost\n                        self.pre[f.v] = it\n                        self.capacity[f.v] = min(self.capacity[u], f.rem())\n                        if not self.inQueue[f.v]:\n                            q.append(f.v)\n                            self.inQueue[f.v] = True\n            if self.pre[t] < 0:\n                break\n            self.maxFlow += self.capacity[t]\n            self.minCost += self.capacity[t] * self.dist[t]\n            v = t\n            while v != s:\n                self.edges[self.pre[v]].flow += self.capacity[t]\n                self.edges[self.pre[v] ^ 1].flow -= self.capacity[t]\n                v = self.edges[self.pre[v]].u\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n\n    nodes = 105 * n + 2\n    mcmf = MinCostMaxFlow(nodes)\n\n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcmf.addEdge(0, x + 1, 1, 0)\n\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for t in range(105):\n            for j in range(51):\n                mcmf.addEdge(t * n + x + 1, (t + 1) * n + y + 1, 1, c + d * (2 * j +