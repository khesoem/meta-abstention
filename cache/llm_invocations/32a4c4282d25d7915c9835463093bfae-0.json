 Matrix result = identity(size);\n    Matrix current = base;\n    while (exp > 0) {\n        if (exp & 1)\n            result = multiply(result, current, size);\n        current = multiply(current, current, size);\n        exp >>= 1;\n    }\n    return result;\n}\n\nMatrix f[MAX_D];\nint global_k;\n\nMatrix build_shifted_matrix(int depth, int shift) {\n    Matrix res;\n    for (int i = 0; i <= global_k; ++i)\n        for (int j = 0; j <= global_k; ++j) {\n            int ni = (i == global_k) ? i : (i + shift) % global_k;\n            int nj = (j == global_k) ? j : (j + shift) % global_k;\n            res[ni][nj] = f[depth][i][j];\n        }\n    return res;\n}\n\nint digit_sum(llint num, int base) {\n    int s = 0;\n    while (num > 0) {\n        s += num % base;\n        num /= base;\n    }\n    return s % base;\n}\n\nint main() {\n    llint n;\n    int k;\n    scanf(\"%lld %d\", &n, &k);\n    global_k = k;\n\n    int digits = 0;\n    llint t = n;\n    while (t > 0) {\n        t /= k;\n        ++digits;\n    }\n\n    Matrix I = identity(k);\n    f[0] = I;\n    for (int i = 0; i <= k; ++i)\n        f[0][i][0] = 1;\n\n    for (int d = 1; d < digits; ++d) {\n        f[d] = I;\n        for (int shift = 0; shift < k; ++shift)\n            f[d] = multiply(f[d], build_shifted_matrix(d-1, shift), k);\n    }\n\n    llint current = 0;\n    llint power = 1;\n    --digits;\n    for (int i = 0; i < digits; ++i)\n        power *= k;\n\n    Matrix result = I;\n    while (current < n) {\n        assert(digits >= 0);\n        while (current + power <= n) {\n            result = multiply(result, build_shifted_matrix(digits, digit_sum(current, k)), k);\n            current += power;\n        }\n        power /= k;\n        --digits;\n    }\n\n    int total = 0;\n    for (int i = 0; i <= k; ++i)\n        total = add(total, result[k][i]);\n    printf(\"%d\\n\", total);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add(x, y):\n    x += y\n    return x - MOD if x >= MOD else x\n\ndef mul(x, y):\n    return int((x * y) % MOD)\n\nMAX_M = 32\nMAX_D = 64\nMAX_K = 32\n\nclass Matrix:\n    def __init__(self, size=MAX_M):\n        self.data = [[0] * size for _ in range(size)]\n    \n    def __getitem__(self, i):\n        return self.data[i]\n    \n    def __setitem__(self, i, value):\n        self.data[i] = value\n\ndef identity(size):\n    res = Matrix(size)\n    for i in range(size):\n        res[i][i] = 1\n    return res\n\ndef multiply(A, B, size):\n    C = Matrix(size)\n    for i in range(size):\n        for j in range(size):\n            for k in range(size):\n                C[i][j] = add(C[i][j], mul(A[i][k], B[k][j]))\n    return C\n\ndef power_matrix(base, exp, size):\n    result = identity(size)\n    current = Matrix(size)\n    for i in range(size):\n        for j in range(size):\n            current[i][j] = base[i][j]\n    \n    while exp > 0:\n        if exp & 1:\n            result = multiply(result, current, size)\n        current = multiply(current, current, size)\n        exp >>= 1\n    return result\n\nf = [None] * MAX_D\nglobal_k = 0\n\ndef build_shifted_matrix(depth, shift):\n    res = Matrix(global_k + 1)\n    for i in range(global_k + 1):\n        for j in range(global_k + 1):\n            ni = i if i == global_k else (i + shift) % global_k\n            nj = j if j == global_k else (j + shift) % global_k\n            res[ni][nj] = f[depth][i][j]\n    return res\n\ndef digit_sum(num, base):\n    s = 0\n    while num > 0:\n        s += num % base\n        num //= base\n    return s % base\n\ndef main():\n    global global_k, f\n    \n    data = input().split()\n    n = int(data[0])\n    k = int(data[1])\n    global_k = k\n\n    digits = 0\n    t = n\n    while t > 0:\n        t //= k\n        digits += 1\n\n    I = identity(k + 1)\n    f[0] = I\n    for i in range(k + 1):\n        f[0][i][0] = 1\n\n    for d in range(1, digits):\n        f[d] = identity(k + 1)\n        for shift in range(k):\n            f[d] = multiply(f[d], build_shifted_matrix(d-1, shift), k + 1)\n\n    current = 0\n    power = 1\n    digits -= 1\n    for i in range(digits):\n        power *= k\n\n    result = identity(k + 1)\n    while current < n:\n        assert digits >= 0)\n        while current + power <= n:\n            result = multiply(result, build_shifted_matrix(digits, digit_sum(current, k)), k + 1)\n            current += power\n        power //= k\n        digits -= 1\n\n    total = 0\n    for i in range(k + 1):\n        total = add(total, result[k][i])\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-8.761498611420393e-05, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.14355531334877014, -0.0011029120068997145, -0.00219164346344769, -0.01424900908023119, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -0.00010966652916977182, 0.0, -7.152555099310121e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -3.576278118089249e-07, -5.602820692729438e-06, -0.003603158053010702, -0.001110771088860929, -0.0001102625101339072, -7.843663479434326e-05, -2.50339189733495e-06, -3.6954811548639555e-06, -2.50339189733495e-06, -2.3841855067985307e-07, -5.245195097813848e-06, -0.008617713116109371, -4.768370445162873e-07, -7.152555099310121e-07, 0.0, -2.2411095415009186e-05, 0.0, -0.08959602564573288, -3.2186455882765586e-06, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -2.0861407392658293e-05, -4.768370445162873e-07, -1.1920928244535389e-07, -2.9802276912960224e-06, -2.3841855067985307e-07, -8.463501580990851e-05, -2.861018856492592e-06, 0.0, -4.410734163684538e-06, -1.5497195136049413e-06, -6.556489552167477e-06, -4.291525328881107e-06, -0.038194719702005386, -0.005935305263847113, -1.1920928244535389e-07, -8.344646857949556e-07, 0.0, 