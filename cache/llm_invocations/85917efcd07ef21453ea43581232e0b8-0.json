ow = 0;\n    static long total_cost = 0;\n    static long[] dist = new long[MAXN];\n    static int[] par_edge = new int[MAXN];\n\n    static class Edge {\n        int to;\n        int cost;\n        int rev;\n        int cap;\n\n        Edge(int to, int cost, int rev, int cap) {\n            this.to = to;\n            this.cost = cost;\n            this.rev = rev;\n            this.cap = cap;\n        }\n    }\n\n    static List<Edge>[] adj = new List[MAXN];\n\n    static void add_edge(int u, int v, int cost, int cap) {\n        int sz_u = adj[u].size();\n        int sz_v = adj[v].size();\n        adj[u].add(new Edge(v, cost, sz_v, cap));\n        adj[v].add(new Edge(u, -cost, sz_u, 0));\n    }\n\n    static void dijkstra() {\n        Arrays.fill(dist, INF);\n        PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n        dist[S] = 0;\n        pq.offer(new long[]{0, S});\n\n        while (!pq.isEmpty()) {\n            long[] top = pq.poll();\n            long d_val = top[0];\n            int u = (int) top[1];\n\n            if (d_val > dist[u]) continue;\n\n            for (Edge e : adj[u]) {\n                if (e.cap > 0 && dist[e.to] > d_val + e.cost) {\n                    dist[e.to] = d_val + e.cost;\n                    par_edge[e.to] = e.rev;\n                    pq.offer(new long[]{dist[e.to], e.to});\n                }\n            }\n        }\n    }\n\n    static void augment() {\n        int f = K;\n        int cur = T;\n        while (cur != S) {\n            int prev = adj[cur].get(par_edge[cur]).to;\n            int idx = adj[cur].get(par_edge[cur]).rev;\n            f = Math.min(f, adj[prev].get(idx).cap);\n            cur = prev;\n        }\n\n        total_flow += f;\n        total_cost += (long) f * dist[T];\n\n        cur = T;\n        while (cur != S) {\n            int prev = adj[cur].get(par_edge[cur]).to;\n            int idx = adj[cur].get(par_edge[cur]).rev;\n            adj[cur].get(par_edge[cur]).cap += f;\n            adj[prev].get(idx).cap -= f;\n            cur = prev;\n        }\n    }\n\n    static int node(int v, int t) {\n        return v + t * N;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        N = sc.nextInt();\n        M = sc.nextInt();\n        K = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n\n        for (int i = 0; i < MAXN; i++) {\n            adj[i] = new ArrayList<>();\n        }\n\n        S = MAXN - 2;\n        T = MAXN - 1;\n        int max_t = N + K;\n\n        for (int i = 0; i < K; i++) {\n            int u = sc.nextInt();\n            add_edge(S, node(u, 0), 0, 1);\n        }\n\n        for (int t = 0; t <= max_t; t++) {\n            add_edge(node(1, t), T, C * t, K);\n        }\n\n        for (int v = 1; v <= N; v++) {\n            for (int t = 0; t < max_t; t++) {\n                add_edge(node(v, t), node(v, t + 1), 0, K);\n            }\n        }\n\n        for (int i = 0; i < M; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int i2 = 1; i2 <= K; i2++) {\n                for (int t = 0; t < max_t; t++) {\n                    int w = D * (2 * i2 - 1);\n                    add_edge(node(u, t), node(v, t + 1), w, 1);\n                    add_edge(node(v, t), node(u, t + 1), w, 1);\n                }\n            }\n        }\n\n        while (total_flow < K) {\n            dijkstra();\n            augment();\n        }\n\n        System.out.println(total_cost);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00019441144831944257, -1.5497195136049413e-06, -7.152555099310121e-07, -0.004459792748093605, -6.639736966462806e-05, -0.10021434724330902, -0.1002984568476677, -1.5735502529423684e-05, -3.576278118089249e-07, -6.103329360485077e-05, -0.0028058229945600033, -4.577531944960356e-05, -0.0009862087899819016, -0.1117696613073349, -4.255681051290594e-05, -6.7949063122