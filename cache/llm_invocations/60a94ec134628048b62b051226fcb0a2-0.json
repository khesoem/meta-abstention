{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconstexpr int MAXN = 55;\nconstexpr int MAXT = 2 * MAXN;\nconstexpr int MAXP = MAXT * MAXN;\nconstexpr int MAXE = 5 * MAXT * MAXN * MAXN;\nconstexpr int INF = 1000000000;\n\nstruct Edge {\n    int to, rev, cap, cost;\n};\n\nvector<Edge> edges;\nvector<int> adj[MAXP];\n\nint n, m, k, c, d;\nint people[MAXN];\nint id[MAXN][MAXT];\nint src = 1, sink = 2, nodeCnt = 2;\nbool used[MAXP];\nint dist[MAXP];\nint answer;\n\nvoid addEdge(int u, int v, int cost, int cap) {\n    int fwd = (int)edges.size();\n    edges.push_back({v, fwd + 1, cap, cost});\n    edges.push_back({u, fwd, 0, -cost});\n    adj[u].push_back(fwd);\n    adj[v].push_back(fwd + 1);\n}\n\nbool spfa() {\n    for (int i = 1; i <= nodeCnt; ++i) {\n        used[i] = false;\n        dist[i] = INF;\n    }\n    queue<int> q;\n    dist[src] = 0;\n    q.push(src);\n    used[src] = true;\n    while (!q.empty()) {\n        int x = q.front();\n        q.pop();\n        used[x] = false;\n        for (int idx : adj[x]) {\n            const Edge &e = edges[idx];\n            if (e.cap <= 0) continue;\n            int y = e.to;\n            if (dist[y] > dist[x] + e.cost) {\n                dist[y] = dist[x] + e.cost;\n                if (!used[y]) {\n                    q.push(y);\n                    used[y] = true;\n                }\n            }\n        }\n    }\n    return dist[sink] < INF;\n}\n\nint augment(int x, int flow) {\n    if (x == src) return flow;\n    used[x] = true;\n    int pushed = 0;\n    for (int idx : adj[x]) {\n        Edge &e = edges[idx];\n        Edge &rev = edges[e.rev];\n        int y = e.to;\n        if (used[y] || rev.cap <= 0 || dist[x] < dist[y] + rev.cost) continue;\n        int got = augment(y, min(flow - pushed, rev.cap));\n        if (got) {\n            rev.cap -= got;\n            e.cap += got;\n            pushed += got;\n            if (pushed == flow) break;\n        }\n    }\n    return pushed;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    edges.reserve(MAXE);\n\n    cin >> n >> m >> k >> c >> d;\n    for (int i = 1; i <= k; ++i) {\n        int x;\n        cin >> x;\n        ++people[x];\n    }\n    for (int i = 1; i <= n; ++i) {\n        for (int j = 1; j <= k + m + 2; ++j) {\n            id[i][j] = ++nodeCnt;\n            if (i == 1) addEdge(id[i][j], sink, c * (j - 1), INF);\n            if (j > 1) addEdge(id[i][j - 1], id[i][j], 0, INF);\n        }\n        if (people[i]) addEdge(src, id[i][1], 0, people[i]);\n    }\n    for (int i = 1; i <= m; ++i) {\n        int a, b;\n        cin >> a >> b;\n        for (int j = 1; j <= k + m + 1; ++j) {\n            for (int cost = 1; cost <= 2 * k - 1; cost += 2) {\n                addEdge(id[a][j], id[b][j + 1], cost * d, 1);\n                addEdge(id[b][j], id[a][j + 1], cost * d, 1);\n            }\n        }\n    }\n\n    for (int i = 1; i <= nodeCnt; ++i) reverse(adj[i].begin(), adj[i].end());\n\n    int sent = 0;\n    while (spfa()) {\n        int add = -1;\n        while (add) {\n            memset(used, 0, sizeof(used));\n            add = augment(sink, INF);\n            sent += add;\n            answer += dist[sink] * add;\n        }\n    }\n    assert(sent == k);\n    cout << answer << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int MAXN = 55;\n    static final int MAXT = 2 * MAXN;\n    static final int MAXP = MAXT * MAXN + 2; // +2 for src and sink\n    static final int INF = 1_000_000_000;\n\n    static class Edge {\n        int to, rev, cap, cost;\n        Edge(int to, int rev, int cap, int cost) {\n            this.to = to;\n            this.rev = rev;\n            this.cap = cap;\n            this.cost = cost;\n        }\n    }\n\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static ArrayList<Integer>[] adj;\n    static boolean[] used;\n    static int[] dist;\n    static int src = 1, sink = 2, nodeCnt = 2;\n    static int answer = 0;\n\n    static void addEdge(int u, int v, int cost, int cap) {\n        int fwd = edges.size();\n        edges.add(new Edge(v, fwd + 1, cap, cost));\n        edges.add(new Edge(u, fwd, 0, -cost));\n        adj[u].add(fwd);\n        adj[v].add(fwd + 1);\n    }\n\n    static boolean spfa() {\n        Arrays.fill(used, false);\n        Arrays.fill(dist, INF);\n        Queue<Integer> q = new LinkedList<>();\n        dist[src] = 0;\n        q.add(src);\n        used[src] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            used[x] = false;\n            for (int idx : adj[x]) {\n                Edge e = edges.get(idx);\n                if (e.cap <= 0) continue;\n                int y = e.to;\n                if (dist[y] > dist[x] + e.cost) {\n                    dist[y] = dist[x] + e.cost;\n                    if (!used[y]) {\n                        q.add(y);\n                        used[y] = true;\n                    }\n                }\n            }\n        }\n        return dist[sink] < INF;\n    }\n\n    static int augment(int x, int flow) {\n        if (x == src) return flow;\n        used[x] = true;\n        int pushed = 0;\n        for (int idx : adj[x]) {\n            Edge e = edges.get(idx);\n            Edge rev = edges.get(e.rev);\n            int y = e.to;\n            if (used[y] || rev.cap <= 0 || dist[x] < dist[y] + rev.cost) continue;\n            int got = augment(y, Math.min(flow - pushed, rev.cap));\n            if (got > 0) {\n                rev.cap -= got;\n                e.cap += got;\n                pushed += got;\n                if (pushed == flow) break;\n            }\n        }\n        return pushed;\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] people = new int[n + 1];\n        for (int i = 1; i <= k; ++i) {\n            int x = sc.nextInt();\n            ++people[x];\n        }\n\n        // Initialize adjacency list\n        adj = new ArrayList[MAXP + 1];\n        for (int i = 1; i <= MAXP; ++i) {\n            adj[i] = new ArrayList<>();\n        }\n\n        // Time layers: up to k + m + 2\n        int maxTime = k + m + 2;\n        int[][] id = new int[n + 1][maxTime + 1];\n        for (int i = 1; i <= n; ++i) {\n            for (int j = 1; j <= maxTime; ++j) {\n                id[i][j] = ++nodeCnt;\n                if (i == 1) {\n                    addEdge(id[i][j], sink, c * (j - 1), INF);\n                }\n                if (j > 1) {\n                    addEdge(id[i][j - 1], id[i][j], 0, INF);\n                }\n            }\n            if (people[i] > 0) {\n                addEdge(src, id[i][1], 0, people[i]);\n            }\n        }\n\n        for (int i = 1; i <= m; ++i) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 1; j <= maxTime - 1; ++j) {\n                for (int cost = 1; cost <= 2 * k - 1; cost += 2) {\n                    addEdge(id[a][j], id[b][j + 1], cost * d, 1);\n                    addEdge(id[b][j], id[a][j + 1], cost * d, 1);\n                }\n            }\n        }\n\n        // Reverse adjacency lists (as in original code)\n        for (int i = 1; i <= nodeCnt; ++i) {\n            Collections.reverse(adj[i]);\n        }\n\n        used = new boolean[nodeCnt + 1];\n        dist = new int[nodeCnt + 1];\n\n        int sent = 0;\n        while (spfa()) {\n            int add;\n            while (true) {\n                Arrays.fill(used, false);\n                add = augment(sink, INF);\n                if (add == 0) break;\n                sent += add;\n                answer += dist[sink] * add;\n            }\n        }\n        // assert(sent == k); // optional\n        System.out.println(answer);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.533743337262422e-05, 0.0, 0.0, -6.282132380874828e-05, -0.00018690270371735096, 0.0, -0.00020346954988781363, -0.0026429505087435246, -0.00023552982020191848, 0.0, -7.986990567587782e-06, -0.0031794970855116844, -5.602820692729438e-06, -0.0008413827163167298, -0.5760095119476318, -1.1920928244535389e-07, -0.38687247037887573, -2.0146166207268834e-05, -1.1920928244535389e-07, 0.0, -6.556489552167477e-06, -6.687417771900073e-05, 0.0, -3.5523738915799186e-05, -1.0371154530730564e-05, 0.0, -0.00026353701832704246, -9.536697689327411e-06, 0.0, -4.172316494077677e-06, -1.4305104514278355e-06, -1.0728830375228426e-06, -1.1920928244535389e-07, 0.0, -0.014169678092002869, 0.0, -3.5523738915799186e-05, -2.1457441107486375e-05, 0.0, -9.762764238985255e-05, -1.5497195136049413e-06, -8.344646857949556e-07, -1.2397689715726301e-05, -5.829164365422912e-05,