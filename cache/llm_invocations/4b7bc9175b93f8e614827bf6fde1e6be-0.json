{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\nlong long comb[777][777];\nint rows, cols;\nlong long total;\nlong long best_val = (long long) 1e18, best_z = -1;\nvoid dfs(long long x, long long y, int v1, int v2) {\n    long long diff = abs(x - y);\n    if (best_val <= 1 || diff - comb[v1][rows] * comb[v2][rows] >= best_val) return;\n    if (v1 == rows - 1 && v2 == rows - 1) {\n        long long diff = abs(x - y);\n        if (diff < best_val) { best_val = diff; best_z = x; }\n        return;\n    }\n    if (v1 >= rows) {\n        long long cur1 = comb[v1][rows] - comb[v1 - 1][rows];\n        long long sum2 = comb[v2][rows];\n        dfs(x, y + cur1 * sum2, v1 - 1, v2);\n    }\n    if (v2 >= rows) {\n        long long sum1 = comb[v1][rows];\n        long long cur2 = comb[v2][rows] - comb[v2 - 1][rows];\n        dfs(x + sum1 * cur2, y, v1, v2 - 1);\n    }\n}\nchar str[12345];\nint cntA[12345], cntB[12345];\nunordered_map<long long, long long> memo;\nlong long solve(long long x, long long y, int v1, int v2) {\n    long long state = x * 10000 + v1 * 100 + v2;\n    auto it = memo.find(state);\n    if (it != memo.end()) return it->second;\n    long long &res = memo[state];\n    long long diff = abs(x - y);\n    if (diff - comb[v1][rows] * comb[v2][rows] > best_val) return res = 0;\n    if (v1 < rows || v2 < rows) {\n        if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n            int sum = v1 + v2;\n            v1 -= cntA[sum];\n            v2 -= cntB[sum];\n            return res = comb[v1 + v2][v1];\n        }\n        return res = 0;\n    }\n    res = 0;\n    char c = str[v1 + v2 - 1];\n    if (c != 'B') {\n        long long cur1 = comb[v1][rows] - comb[v1 - 1][rows];\n        long long sum2 = comb[v2][rows];\n        res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n    }\n    if (c != 'A') {\n        long long sum1 = comb[v1][rows];\n        long long cur2 = comb[v2][rows] - comb[v2 - 1][rows];\n        res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n    }\n    return res;\n}\nint main() {\n    scanf(\"%d %d\", &rows, &cols);\n    for (int i = 0; i <= 2 * (rows + cols); i++) {\n        for (int j = 0; j <= 2 * (rows + cols); j++) {\n            if (j == 0) comb[i][j] = 1;\n            else if (i == 0) comb[i][j] = 0;\n            else comb[i][j] = comb[i - 1][j] + comb[i - 1][j - 1];\n        }\n    }\n    total = comb[rows + cols][rows] * comb[rows + cols][rows];\n    {\n        long long x = 0, y = 0;\n        int v1 = rows + cols, v2 = rows + cols;\n        while (v1 >= rows && v2 >= rows) {\n            if (x > y) {\n                long long cur1 = comb[v1][rows] - comb[v1 - 1][rows];\n                long long sum2 = comb[v2][rows];\n                y += cur1 * sum2;\n                v1--;\n            } else {\n                long long sum1 = comb[v1][rows];\n                long long cur2 = comb[v2][rows] - comb[v2 - 1][rows];\n                x += sum1 * cur2;\n                v2--;\n            }\n        }\n        best_val = abs(x - y);\n    }\n    dfs(0, 0, rows + cols, rows + cols);\n    scanf(\"%s\", str);\n    cntA[0] = cntB[0] = 0;\n    