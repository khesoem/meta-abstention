ht = mid - 1\n        \n        err_floor = abs(num_floor / denom - x / y)\n        err_ceil = abs(num_ceil / denom - x / y)\n        \n        chosen_num = num_floor\n        chosen_den = denom\n        chosen_err = err_floor\n        \n        if err_ceil < err_floor - 1e-9:\n            chosen_num = num_ceil\n            chosen_den = denom\n            chosen_err = err_ceil\n        \n        g = gcd(chosen_num, chosen_den)\n        chosen_num //= g\n        chosen_den //= g\n        \n        if chosen_err < smallest_error:\n            best_num = chosen_num\n            best_den = chosen_den\n            smallest_error = chosen_err\n    \n    print(f\"{best_num}/{best_den}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.272782724816352e-05, -7.152555099310121e-07, -1.1920928244535389e-07, -0.00033480284037068486, -0.0205991230905056, -0.575977087020874, -0.009776095859706402, -0.00029595286468975246, -9.798523387871683e-05, -1.847726889536716e-05, -0.00011121608258690685, -7.152555099310121e-07, -2.0265558760002023e-06, -1.585470999998506e-05, -1.5020257706055418e-05, -1.1920928244535389e-07, -0.016056284308433533, -5.960462772236497e-07, -2.145764938177308e-06, 0.0, 0.0, 0.0, -0.0001134808044298552, -7.152555099310121e-07, -0.004270956851541996, 0.0, -6.794906312279636e-06, -5.960462772236497e-07, -3.933898824470816e-06, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, 0.0, -2.3841855067985307e-07, -9.536738616588991e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -9.65590606938349e-06, -9.536738616588991e-07, -8.618460560683161e-05, -0.0003045333724003285, -3.290122185717337e-05, -1.311301275563892e-06, -0.10126374661922455, -1.6689286894688848e-06, -0.1621057689189911, -1.4662635294371285e-05, -0.1798572838306427, -1.2516897186287679e-05, -2.2291887944447808e-05, -7.629365427419543e-06, -2.3841855067985307e-07, -0.008614994585514069, -0.001702289