\n            return x\n\n        def add(self, a, b):\n            v = a + b\n            return v if v < self.modulus() else v - self.modulus()\n\n        def subtract(self, a, b):\n            v = a - b\n            return v if v >= 0 else v + self.modulus()\n\n        def mult(self, a, b):\n            return (a * b) % self.modulus()\n\n        def inv(self, value):\n            g = self.modulus()\n            x = 0\n            y = 1\n            for r in range(value):\n                q = g // r\n                g %= r\n\n                x -= q * y\n\n                x, y = y, x\n            assert g == 1\n            assert y == self.modulus() or y == -self.modulus()\n\n            return self.normalize(x)\n\nclass Mod998(NumberTheory.Modulus):\n    def modulus(self):\n        return 998244353\n\ndef main():\n    reader = InputReader(sys.stdin)\n    writer = sys.stdout\n\n    mod = Mod998()\n    n = reader.next_int()\n    m = reader.next_int()\n\n    mod.fInv(n + m)\n\n    phase_size = 1\n    p = 1\n    for i in range(n):\n        p = mod.mult(mod.mult(p, n - i), mod.smallInv(n + m - i))\n        phase_size = mod.add(phase_size, p)\n\n    answer = 0\n    for k in range(1, n + 1):\n        num_phases = mod.mult(m + k, mod.smallInv(k))\n        term = mod.mult(mod.ncr(n, k), mod.mult(num_phases, phase_size))\n        if (k & 1) == 1:\n            answer = mod.add(answer, term)\n        else:\n            answer = mod.subtract(answer, term)\n\n    writer.write(str(answer) + \"\\n\")\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.20385824143886566, -0.0003098729357589036, -0.2830556333065033, -0.16743728518486023, -0.1926872432231903, -0.6369202136993408, -0.7569376826286316, -0.09709393233060837, -0.18490004539489746, -0.06760221719741821, -1.2123974561691284, -0.0295548252761364, -0.00768405431881547, -0.0016868028324097395, -0.007231391035020351, -0.00034385870094411075, -2.622638749