ublic static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        long mod = sc.nextLong();\n        long result = solve(n, mod);\n        System.out.println(result);\n    }\n\n    public static long solve(long n, long mod) {\n        long m = n * (n - 1) / 2;\n        long max_inv = n * (n - 1);\n        \n        // Initialize dp and dp1 arrays\n        long[][] dp = new long[(int)n + 1][(int)max_inv + 1];\n        long[][] dp1 = new long[(int)n + 1][(int)max_inv + 1];\n        \n        dp[1][(int)m] = 1;\n        \n        for (int i = 2; i <= (int)n; i++) {\n            long start_x = m - (i - 1) * (i - 2) / 2;\n            long end_x = m + (i - 1) * (i - 2) / 2;\n            \n            for (long x = start_x; x <= end_x; x++) {\n                if (x < 0 || x > max_inv) continue;\n                for (int d = -i + 1; d < i; d++) {\n                    int target = (int)(x + d);\n                    if (target >= 0 && target <= max_inv) {\n                        dp[i][target] = (dp[i][target] + dp[i - 1][(int)x] * (i - Math.abs(d))) % mod;\n                    }\n                }\n            }\n        }\n        \n        for (int i = 2; i <= (int)n; i++) {\n            long start_x = m - (i - 1) * (i - 2) / 2;\n            long end_x = m + (i - 1) * (i - 2) / 2;\n            \n            for (long x = start_x; x <= end_x; x++) {\n                if (x < 0 || x > max_inv) continue;\n                dp1[i][(int)x] = (dp1[i - 1][(int)x] * i) % mod;\n                for (int d = 1; d < i; d++) {\n                    int target = (int)(x - d);\n                    if (target >= 0 && target <= max_inv) {\n                        dp1[i][target] = (dp1[i][target] + dp[i - 1][(int)x] * (i - d)) % mod;\n                    }\n                }\n            }\n        }\n        \n        long result = 0;\n        for (long x = m + 1; x <= max_inv; x++) {\n            if (x >= 0 && x <= max_inv) {\n    