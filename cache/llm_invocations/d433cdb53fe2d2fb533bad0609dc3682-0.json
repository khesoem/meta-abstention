ong long dfs(int pos,long long flow)\n    {\n        if (pos == t) return flow;\n        vis[pos] = 1;\n        long long tmp = flow;\n        for (int i = cur[pos] != -1 ? cur[pos] : head[pos];i != -1;i = nxt[i])\n            if (!vis[v[i]] && w[i] && dis[v[i]] == dis[pos] + c[i])\n            {\n                cur[pos] = i;\n                long long fl = dfs(v[i],min(flow,w[i]));\n                cost += fl * c[i];\n                w[i] -= fl;w[i ^ 1] += fl;\n                flow -= fl;\n                if (!flow) break;\n            }\n        return tmp - flow;\n    }\npublic:\n    FlowGraph()\n    {memset(head,-1,sizeof(head));memset(nxt,-1,sizeof(nxt));}\n    inline void add_edge(int uu,int vv,long long ww,int cc)\n    {\n        padd_edge(uu,vv,ww,cc);padd_edge(vv,uu,0,-cc);\n    }\n    long long dinic(int s,int t)\n    {\n        cost = 0;this->t = t;\n        while (spfa(s,t)) \n        {\n            memset(cur,-1,sizeof(cur));dfs(s,inf);\n        }\n        return cost;\n    }\n};\nFlowGraph g;\nint n,m,kk,c,d,a[55];\nint main ()\n{\n    ios::sync_with_stdio(false);\n    cin >> n >> m >> kk >> c >> d;\n    for (int i = 1;i <= kk;i++) cin >> a[i];\n    int s = 0,t = n * 100 + 1;\n    for (int i = 1;i <= 100;i++) g.add_edge(i,t,inf,0);\n    for (int i = 1;i <= kk;i++) g.add_edge(s,(a[i] - 1) * 100 + 1,1,0);\n    for (int i = 2;i <= n;i++)\n        for (int j = 1;j < 100;j++)\n            g.add_edge((i - 1) * 100 + j,(i - 1) * 100 + j + 1,inf,c);\n    int t1,t2;\n    for (int _ = 1;_ <= m;_++)\n    {\n        cin >> t1 >> t2;\n        for (int i = 1;i < 100;i++)\n            for (int j = 1;j <= kk;j++) //\u5176\u5b9e\u4e0d\u7528\u679a\u4e3e\u5230kk\uff0c\u679a\u4e3e\u523025\u5de6\u53f3\u5373\u53ef\n            {\n                int val = c + d * (j * j - (j - 1) * (j - 1));\n                g.add_edge((t1 - 1) * 100 + i,(t2 - 1) * 100 + i + 1,1,val);\n                g.add_edge((t2 - 1) * 100 + i,(t1 - 1) * 100 + i + 1,1,val);\n            }\n    }\n    cout << g.dinic(s,t) << endl;\n    return 0;\n}\n// \u6700\u5c0f\u8d39\u7528\u6d41 \u73c2\u4ee5\u5229\u7528\u6d41\u91cf\u6765\u5904\u7406\u591a\u4eba\u8d70\u540c\u4e00\u6761\u8def\u7684\u60c5\u51b5\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int N = 10000;\n    static final int M = N * 100;\n    static final long inf = Long.MAX_VALUE >> 5;\n\n    static class FlowGraph {\n        private int[] head = new int[N];\n        private int[] v = new int[M];\n        private int[] nxt = new int[M];\n        private int[] c = new int[M];\n        private int ptr = 0;\n        private int t;\n        private long[] w = new long[M];\n        private long cost = 0;\n\n        private void padd_edge(int uu, int vv, long ww, int cc) {\n            v[ptr] = vv;\n            w[ptr] = ww;\n            c[ptr] = cc;\n            nxt[ptr] = head[uu];\n            head[uu] = ptr++;\n        }\n\n        private int[] dis = new int[N];\n        private int[] id = new int[N];\n        private int[] cur = new int[N];\n        private boolean[] vis = new boolean[N];\n\n        private boolean spfa(int s, int t) {\n            Arrays.fill(vis, false);\n            Arrays.fill(dis, -1);\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            dis[s] = 0;\n            id[s] = 1;\n\n            while (!q.isEmpty()) {\n                int nd = q.poll();\n                vis[nd] = false;\n                for (int i = head[nd]; i != -1; i = nxt[i]) {\n                    if (w[i] > 0 && (dis[v[i]] == -1 || dis[v[i]] > dis[nd] + c[i])) {\n                        dis[v[i]] = dis[nd] + c[i];\n                        if (!vis[v[i]]) {\n                            vis[v[i]] = true;\n                            q.offer(v[i]);\n                        }\n                    }\n                }\n            }\n            return dis[t] != -1;\n        }\n\n        private long dfs(int pos, long flow) {\n            if (pos == t) return flow;\n            vis[pos] = true;\n            long tmp = flow;\n            int start = cur[pos] != -1 ? cur[pos] : head[pos];\n            for (int i = start; i != -1; i = nxt[i]) {\n                if (!vis[v[i]] && w[i] > 0 && dis[v[i]] == dis[pos] + c[i]) {\n                    cur[pos] = i;\n                    long fl = dfs(v[i], Math.min(flow, w[i]));\n                    cost += fl * c[i];\n                    w[i] -= fl;\n                    w[i ^ 1] += fl;\n                    flow -= fl;\n                    if (flow == 0) break;\n                }\n            }\n            return tmp - flow;\n        }\n\n        public FlowGraph() {\n            Arrays.fill(head, -1);\n            Arrays.fill(nxt, -1);\n        }\n\n        public void add_edge(int uu, int vv, long ww, int cc) {\n            padd_edge(uu, vv, ww, cc);\n            padd_edge(vv, uu, 0, -cc);\n        }\n\n        public long dinic(int s, int t) {\n            this.cost = 0;\n            this.t = t;\n            while (spfa(s, t)) {\n                Arrays.fill(cur, -1);\n                dfs(s, inf);\n            }\n            return cost;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int kk = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        int[] a = new int[55];\n        for (int i = 1; i <= kk; i++) {\n            a[i] = sc.nextInt();\n        }\n        \n        int s = 0;\n        int t = n * 100 + 1;\n        FlowGraph g = new FlowGraph();\n        \n        for (int i = 1; i <= 100; i++) {\n            g.add_edge(i, t, inf, 0);\n        }\n        \n        for (int i = 1; i <= kk; i++) {\n            g.add_edge(s, (a[i] - 1) * 100 + 1, 1, 0);\n        }\n        \n        for (int i = 2; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                g.add_edge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, inf, c);\n            }\n        }\n        \n        int t1, t2;\n        for (int _ = 1; _ <= m; _++) {\n            t1 = sc.nextInt();\n            t2 = sc.nextInt();\n            for (int i = 1; i < 100; i++) {\n                for (int j = 1; j <= kk; j++) {\n                    int val = c + d * (j * j - (j - 1) * (j - 1));\n                    g.add_edge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val);\n                    g.add_edge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val);\n                }\n            }\n        }\n        \n        System.out.println(g.dinic(s, t));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012444675667211413, -2.7418097943154862e-06, -7.152555099310121e-07, -0.0023079682141542435, -2.312633478140924e-05, -0.03805059567093849, -0.17993047833442688, -3.2543604902457446e-05, -4.768370445162873e-07, -0.005317235365509987, -0.0028055852744728327, -1.156323378381785e-05, -0.3876258134841919, -0.03905835375189781, -5.722029527532868e-06, -0.00014673586701974273, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -1.0728830375228426e-06, -5.960462772236497e-07, -0.0028161650989204645, -2.3841830625315197e-06, -2.3841855067985307e-07, -1.585470999998506e-05, -2.8371408916427754e-05, -1.7881377516459906e-06, -1.1920928244535389e-07, -2.1576648578047752e-05, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -5.960462772236497e-07, -1.5020257706055418e-05, -0.00014101465058047324, -2.0265558760002023e-06, -0.0062752352096140385, -2.5748875486897305e-05, -0.5240460634231567, -2.9205850296420977e-05, -0.00024327656137757003, -3.3378044463461265e-05, -1.3351351299206726e-05, -0.4749213457107544, 0.0, -9.536738616588991e-07, -0.34844768047332764, -3.57627811808924