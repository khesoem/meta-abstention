{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<queue>\n#define N 100010\nusing namespace std;\ntypedef int typ;\n#define M 1000010\n#define inf 1000000000\n#define winf 1000000000\nstruct road{\n    int nxt,to,f;\n    typ w;\n}r[M<<1];\nint head[N],cnt=1,all;\nvoid add(int u,int v,int f,typ w)\n{\n    r[++cnt]=(road){head[u],v,f,w};head[u]=cnt;\n    r[++cnt]=(road){head[v],u,0,-w};head[v]=cnt;\n}\nnamespace min_cost_flow{\n    int cur[N];\n    bool vis[N];\n    struct node{\n        int u;typ v;\n        node(int U=0,typ V=0):u(U),v(V){}\n        bool operator <(const node a)const{return v>a.v;}\n    };\n    priority_queue<node>q;\n    typ dis[N],tag[N];\n    bool dij(int s,int t)\n    {\n        for(int i=1;i<=all;i++) dis[i]=winf,cur[i]=head[i];\n        dis[t]=0;q.push(node(t,0));\n        while(!q.empty())\n        {\n            int u=q.top().u;q.pop();\n            if(vis[u]) continue;\n            vis[u]=true;\n            for(int i=head[u];i;i=r[i].nxt)\n            {\n                int v=r[i].to,w=tag[u]+r[i^1].w-tag[v];\n                if(r[i^1].f && dis[u]+w<dis[v]) dis[v]=dis[u]+w,q.push(node(v,dis[v]));\n            }\n        }\n        for(int i=1;i<=all;i++) tag[i]=min(tag[i]+dis[i],winf);\n        if(!vis[s]) return false;\n        for(int i=1;i<=all;i++) vis[i]=false;\n        return true;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && tag[v]+r[i].w==tag[u] && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(dij(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*tag[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\nfrom collections import defaultdict\n\ndef main():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    m = int(input_data[idx]); idx += 1\n    k = int(input_data[idx]); idx += 1\n    c = int(input_data[idx]); idx += 1\n    d = int(input_data[idx]); idx += 1\n    \n    # Initialize graph\n    g = defaultdict(list)\n    \n    # Read k starting points\n    starts = []\n    for _ in range(k):\n        a = int(input_data[idx]); idx += 1\n        starts.append(a)\n    \n    # Read m edges\n    for _ in range(m):\n        u = int(input_data[idx]); idx += 1\n        v = int(input_data[idx]); idx += 1\n        g[u].append(v)\n        g[v].append(u)\n    \n    # Constants\n    INF = 10**9\n    WINF = 10**9\n    \n    # Graph representation: adjacency list with edges stored as [to, capacity, weight, reverse_edge_index]\n    # We'll use a list of lists for edges\n    # Each edge: [to, capacity, weight, reverse_edge_index]\n    edges = []\n    head = [-1] * (n * (n + k + 2) + 10)  # Pre-allocate enough space\n    \n    def add_edge(u, v, f, w):\n        # Forward edge\n        edges.append([v, f, w, len(edges) + 1])\n        # Backward edge\n        edges.append([u, 0, -w, len(edges) - 1])\n        # Update head\n        head[u] = len(edges) - 2 if head[u] == -1 else head[u]\n    \n    # Build graph\n    all_nodes = n + 2  # ss, tt, and nodes for each time step\n    \n    # Helper function to get node id\n    def id_node(t, x):\n        return t * n + x + 2\n    \n    # Add edges from source to starting points\n    for a in starts:\n        add_edge(0, id_node(0, a), 1, 0)\n    \n    # Add edges from node 1 at time 0 to sink\n    add_edge(id_node(0, 1), 1, INF, 0)\n    \n    # Add edges for each time step\n    for t in range(n + k + 1):\n        # Add edges between nodes at time t and t+1\n        for u in range(1, n + 1):\n            for v in g[u]:\n                for p in range(1, k + 1):\n                    add_edge(id_node(t, u), id_node(t + 1, v), 1, d * (2 * p - 1))\n        \n        # Add self-loop edges (stay at same node)\n        for u in range(1, n + 1):\n            add_edge(id_node(t, u), id_node(t + 1, u), INF, 0)\n        \n        # Add edge from node 1 at time t+1 to sink\n        add_edge(id_node(t + 1, 1), 1, INF, c * (t + 1))\n    \n    # Min cost max flow implementation\n    def min_cost_max_flow(source, sink):\n        # Use Dijkstra with potentials\n        n_nodes = len(head)\n        dist = [INF] * n_nodes\n        prevv = [-1] * n_nodes\n        preve = [-1] * n_nodes\n        \n        total_flow = 0\n        total_cost = 0\n        \n        while True:\n            # Dijkstra\n            dist = [INF] * n_nodes\n            dist[source] = 0\n            pq = [(0, source)]\n            prevv = [-1] * n_nodes\n            preve = [-1] * n_nodes\n            \n            while pq:\n                d, u = heapq.heappop(pq)\n                if d > dist[u]:\n                    continue\n                i = head[u]\n                while i != -1:\n                    v, cap, cost, rev = edges[i]\n                    if cap > 0 and dist[u] + cost < dist[v]:\n                        dist[v] = dist[u] + cost\n                        prevv[v] = u\n                        preve[v] = i\n                        heapq.heappush(pq, (dist[v], v))\n                    i = head[u] if i == head[u] else (edges[i ^ 1][3] + 1 if i % 2 == 0 else edges[i ^ 1][3] + 1)\n            \n            if dist[sink] == INF:\n                break\n            \n            # Augment path\n            flow = INF\n            v = sink\n            while v != source:\n                u = prevv[v]\n                i = preve[v]\n                cap = edges[i][1]\n                flow = min(flow, cap)\n                v = u\n            \n            v = sink\n            while v != source:\n                u = prevv[v]\n                i = preve[v]\n                edges[i][1] -= flow\n                edges[i ^ 1][1] += flow\n                total_cost += flow * edges[i][2]\n                v = u\n            \n            total_flow += flow\n        \n        return total_flow, total_cost\n    \n    # Run min cost max flow\n    _, min_cost = min_cost_max_flow(0, 1)\n    print(min_cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.35\n</confidence>", "token_logprobs": [-0.00017486473370809108, -1.5497195136049413e-06, -1.1920928244535389e-07, -0.00010549465514486656, -0.5234367251396179, -0.014286968857049942, -0.005247391294687986, -0.0006437613046728075, -0.06997013092041016, -0.006120154168456793, -0.0001971527235582471, -4.768370445162873e-07, -0.011048921383917332, -0.030694784596562386, -0.6662769913673401, -0.2662738859653473, -1.0728830375228426e-06, -1.6689286894688848e-06, -0.006386466324329376, -0.5376984477043152, -2.7418097943154862e-06, -0.0013002045452594757, -2.622600959512056e-06, -4.279521817807108e-05, -0.006304376758635044, -0.47409018874168396, -0.00015615197480656207, -5.960462772236497e-07, -0.4934903383255005, -1.6689286894688848e-06, -6.6756979322235566e-06, 0.0, -0.00043442347669042647, 0.0, -2.3841830625315197e-06, -0.002805228577926755, -5.960462772236497e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -0.0001389883691444993, -1.5616295058862306e-05, -0.0011703077470883727, -1.0132738680113107e-05, 0.0, -2.622600959512056e-06, -5.960462772236497e-07, 0.0, -1.0728830375228426e-06, -1.7046782886609435e-05, -2.3841855067985307e-07, -2.622600959512056e-06, -2.145764938177308e-06, -0.00029130507027730346, -3.6954811548639555e-06, -8.34461570775602e-06, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.00033825874561443925, -2.50339189733495e-06, -2.3841855067985307e-07, -8.702239938429557e-06, -1.3708974620385561e-05, -7.080780778778717e-05, -1.07287787614041e-05, -1.0371154530730564e-05, -1.1920928244535389e-07, -8.344646857949556e-07, -1.0728830375228426e-06, -5.960462772236497e-07, -4.768370445