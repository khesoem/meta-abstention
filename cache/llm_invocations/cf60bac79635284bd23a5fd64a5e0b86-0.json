ol kuhn_match(int u) {\n    if (used[u]) return false;\n    used[u] = true;\n    for (int v : edge_list[u]) {\n        if (!partner[v] || kuhn_match(partner[v])) {\n            partner[v] = u;\n            return true;\n        }\n    }\n    return false;\n}\n\nvoid run_solution() {\n    read_data();\n\n    int total = 0;\n    for (int u = 0; u < MAX_VERTEX; ++u) {\n        fill(used, used + MAX_VERTEX, false);\n        if (kuhn_match(u)) ++total;\n    }\n\n    cout << total << endl;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n    run_solution();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nLINF = 10**18\nMAX_VERTEX = 1000\n\ndX = [0, 0, -1, 1]\ndY = [-1, 1, 0, 0]\n\nedge_list = [[] for _ in range(MAX_VERTEX)]\nused = [False] * MAX_VERTEX\npartner = [0] * MAX_VERTEX\n\ndef inside(x, y, g):\n    return (x >= 0 and y >= 0 and x < len(g) and y < len(g) and g[x][y] != 'Y' and g[x][y] != 'Z')\n\ndef dist_grid(sx, sy, g):\n    n = len(g)\n    dist = [[LINF] * n for _ in range(n)]\n    q = deque()\n    dist[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for k in range(4):\n            nx, ny = x + dX[k], y + dY[k]\n            if not inside(nx, ny, g) or dist[nx][ny] != LINF:\n                continue\n            dist[nx][ny] = dist[x][y] + 1\n            q.append((nx, ny))\n    return dist\n\ndef read_data():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    g1 = []\n    g2 = []\n    for _ in range(n):\n        g1.append(next(it))\n    for _ in range(n):\n        g2.append(next(it))\n    \n    rx, ry = -1, -1\n    for i in range(n):\n        for j in range(n):\n            if g1[i][j] == 'Z':\n                rx, ry = i, j\n 