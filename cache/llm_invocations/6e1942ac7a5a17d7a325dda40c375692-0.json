              if (!g[pos[i-1]][lis[i]]) {\n                    flag = false;\n                    break;\n                }\n            }\n            if (flag) return true;\n        }\n        return false;\n    }\n\n    static void dfs1(int now, int x, int y) {\n        if (now == 0) return;\n        if (x == 4) {\n            boolean[] used = new boolean[7];\n            for (int i = 1; i <= 6; i++) used[i] = true;\n            int sta = 0;\n            for (int i = 1; i <= 6; i++) {\n                for (int j = i+1; j <= 6; j++) {\n                    for (int k = j+1; k <= 6; k++) {\n                        if (check(i, j, k)) {\n                            used[i] = used[j] = used[k] = false;\n                            int X = -1, Y = -1, Z = -1;\n                            for (int l = 1; l <= 6; l++) {\n                                if (!used[l]) continue;\n                                if (X == -1) X = l;\n                                else if (Y == -1) Y = l;\n                                else Z = l;\n                            }\n                            used[i] = used[j] = used[k] = true;\n                            if (Z == -1) continue;\n                            sta |= num[X][Y][Z];\n                        }\n                    }\n                }\n            }\n            p[sta] = inc(p[sta], now);\n            return;\n        }\n        g[x][y] = true;\n        int nxt = mul(now, a[x][y]);\n        if (y == 6) dfs1(nxt, x+1, 1);\n        else dfs1(nxt, x, y+1);\n        g[x][y] = false;\n        nxt = mul(now, dec(1, a[x][y]));\n        if (y == 6) dfs1(nxt, x+1, 1);\n        else dfs1(nxt, x, y+1);\n    }\n\n    static void dfs2(int now, int x, int y) {\n        if (now == 0) return;\n        if (x == 7) {\n            int sta = 0;\n            for (int i = 1; i <= 6; i++) {\n                for (int j = i+1; j <= 6; j++) {\n                    for (int k = j+1; k <= 6; k++) {\n                        if (check(i, j, k)) 