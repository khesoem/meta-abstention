{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MAXN = 5005;\nconst int INF = 1000000007;\nconst int K = 100;\n\nstruct Edge {\n    int u, v;\n    int cap, flow, cost;\n};\n\nstruct MCMF {\n    int n, m, s, t;\n    vector<int> G[MAXN];\n    vector<Edge> E;\n    int d[MAXN];\n    int prev[MAXN];\n    int aug[MAXN];\n\n    MCMF(int n) : n(n) {}\n\n    void addEdge(int u, int v, int cap, int cost) {\n        E.push_back({u, v, cap, 0, cost});\n        E.push_back({v, u, 0, 0, -cost});\n        m = (int)E.size();\n        G[u].push_back(m - 2);\n        G[v].push_back(m - 1);\n    }\n\n    bool shortestPath(int &f, int &cost) {\n        fill(d, d + n, INF);\n        fill(aug, aug + n, INF);\n        fill(prev, prev + n, -1);\n        d[s] = 0;\n        prev[s] = -1;\n        aug[s] = INF;\n\n        for (int iter = 0; iter < n - 1; ++iter) {\n            bool any = false;\n            for (int u = 0; u < n; ++u) {\n                if (d[u] == INF) continue;\n                for (int id : G[u]) {\n                    Edge &e = E[id];\n                    if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                        d[e.v] = d[u] + e.cost;\n                        prev[e.v] = id;\n                        aug[e.v] = min(aug[u], e.cap - e.flow);\n                        any = true;\n                    }\n                }\n            }\n            if (!any) break;\n        }\n\n        if (d[t] == INF) return false;\n\n        f = aug[t];\n        cost = d[t];\n        for (int v = t; v != s; v = E[prev[v]].u) {\n            E[prev[v]].flow += aug[t];\n            E[prev[v] ^ 1].flow -= aug[t];\n        }\n        return true;\n    }\n\n    pair<int,int> minCost(int s, int t) {\n        this->s = s;\n        this->t = t;\n        int totalFlow = 0;\n        int totalCost = 0;\n        int f, c;\n        while (shortestPath(f, c)) {\n            totalFlow += f;\n            totalCost += f * c;\n        }\n        return {totalFlow, totalCost};\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, C, D;\n    cin >> n >> m >> k >> C >> D;\n\n    MCMF solver(n * K + 2);\n    int source = n * K, sink = n * K + 1;\n\n    for (int i = 0; i < K; ++i)\n        solver.addEdge(i, sink, k, C * i);\n\n    for (int i = 0; i < k; ++i) {\n        int x;\n        cin >> x;\n        --x;\n        solver.addEdge(source, x * K, 1, 0);\n    }\n\n    for (int i = 0; i < n; ++i)\n        for (int j = 1; j < K; ++j)\n            solver.addEdge(i * K + j - 1, i * K + j, k, 0);\n\n    while (m--) {\n        int u, v;\n        cin >> u >> v;\n        --u; --v;\n\n        for (int j = 1; j < K; ++j) {\n            int a = u * K + j - 1, b = v * K + j;\n            int c = v * K + j - 1, d = u * K + j;\n\n            for (int i = 1, cc = D; i <= k; ++i, cc += 2 * D) {\n                solver.addEdge(a, b, 1, cc);\n                solver.addEdge(c, d, 1, cc);\n            }\n        }\n    }\n\n    auto ans = solver.minCost(source, sink);\n    cout << ans.second << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 1.0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int u, v;\n        int cap, flow, cost;\n        Edge(int u, int v, int cap, int flow, int cost) {\n            this.u = u;\n            this.v = v;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n\n    static class MCMF {\n        int n, m, s, t;\n        List<Integer>[] G;\n        List<Edge> E;\n        int[] d;\n        int[] prev;\n        int[] aug;\n        static final int INF = 1000000007;\n\n        @SuppressWarnings(\"unchecked\")\n        MCMF(int n) {\n            this.n = n;\n            m = 0;\n            G = new ArrayList[n];\n            for (int i = 0; i < n; i++) G[i] = new ArrayList<>();\n            d = new int[n];\n            prev = new int[n];\n            aug = new int[n];\n            E = new ArrayList<>();\n        }\n\n        void addEdge(int u, int v, int cap, int cost) {\n            Edge forward = new Edge(u, v, cap, 0, cost);\n            Edge reverse = new Edge(v, u, 0, 0, -cost);\n            E.add(forward);\n            E.add(reverse);\n            m = E.size();\n            G[u].add(m - 2);\n            G[v].add(m - 1);\n        }\n\n        boolean shortestPath(int[] flowOut, int[] costOut) {\n            Arrays.fill(d, INF);\n            Arrays.fill(aug, 0);\n            Arrays.fill(prev, -1);\n            d[s] = 0;\n            prev[s] = -1;\n            aug[s] = INF;\n\n            for (int iter = 0; iter < n - 1; ++iter) {\n                boolean any = false;\n                for (int u = 0; u < n; ++u) {\n                    if (d[u] == INF) continue;\n                    for (int id : G[u]) {\n                        Edge e = E.get(id);\n                if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                    d[e.v] = d[u] + e.cost;\n                prev[e.v] = id;\n                aug[e.v] = Math.min(aug[u], e.cap - e.flow);\n                any = true;\n                    }\n                }\n            if (!any) break;\n            }\n\n            if (d[t] == INF) return false;\n\n            flowOut[0] = aug[t];\n            costOut[0] = d[t];\n            for (int v = t; v != s; v = E.get(prev[v]).u) {\n                Edge e = E.get(prev[v]);\n                e.flow += aug[t];\n                E.get(prev[v] ^ 1).flow -= aug[t];\n            }\n            return true;\n        }\n\n        int[] minCost(int s, int t) {\n            this.s = s;\n            this.t = t;\n            int totalFlow = 0;\n            int totalCost = 0;\n            int[] f = new int[1];\n            int[] c = new int[1];\n            while (shortestPath(f, f)) {\n                totalFlow += f[0];\n                totalCost += f[0] * c[0];\n            }\n            return new int[]{totalFlow, totalCost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int C = Integer.parseInt(st.nextToken());\n        int D = Integer.parseInt(st.nextToken());\n\n        int K = 100;\n        MCMF solver = new MCMF(n * K + 2);\n        int source = n * K;\n        int sink = n * K + 1;\n\n        // Time layers to sink\n        for (int i = 0; i < K; ++i) {\n            solver.addEdge(i, sink, k, C * i);\n        }\n\n        // Initial positions\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; ++i) {\n            int x = Integer.parseInt(st.nextToken());\n            --x;\n            solver.addEdge(source, x * K, 1, 0);\n        }\n\n        // Self loops with zero cost\n        for (int i = 0; i < n; ++i) {\n            for (int j = 1; j < K; ++j) {\n                solver.addEdge(i * K + j - 1, i * K + j, k, 0);\n            }\n        }\n\n        // Roads\n        for (int i = 0; i < m; ++i) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            --u; --v;\n            for (int j = 1; j < K; ++j) {\n                int a = u * K + j - 1;\n                int b = v K + j;\n                int c = v K + j - 1;\n                int d = u K + j;\n                for (int cnt = 1, cc = D; cnt <= k; ++cnt, cc += 2 * D) {\n                    solver.addEdge(a, b, 1, cc);\n                    solver.addEdge(c, d, 1, cc);\n                }\n            }\n        }\n\n        int[] result = solver.minCost(source, sink);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0015243588713929057, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.795983401592821e-05, -4.732496745418757e-05, -1.1920928244535389e-07, -0.16022419929504395, -0.2519771456718445, 0.0, 0.0, -1.1920928244535389e-07, -0.00010072677832795307, -0.038625139743089676, 0.0, -0.003364499658346176, -0.038073889911174774, -0.0007141662063077092, -0.011218564584851265, -0.5761300325393677, -0.0010085977846756577, -1.0728830375228426e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.3470558769768104e-05, -1.4305104514278355e-06, 0.0, -0.3132682740688324, 0.0, -2.3841855067985307e-07, 0.0, -9.536738616588991e-07, -1.4305104514278355e-06, -6.9141146923357155e-06, 0.0, -0.054944705218076706, -0.00036399890086613595, -0.0007102350937202573, -4.0411134250462055e-05, -3.2186455882765586e-06, -1.764281842042692e-05, 0.0, 0.0, 0.0, 0.0, -2.9802276912960224e-06, -4.768370445162873e-07, -1.1920928244535389e-07, -0.0024833811912685633, 