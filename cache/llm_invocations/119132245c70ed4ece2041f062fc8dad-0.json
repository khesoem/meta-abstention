de(0,1),T,INF,0);\n  for (int i=1;i<=k;i++){\n    int p;\n    scanf(\"%d\",&p);\n    add(S,code(0,p),1,0);\n  }\n  for (int i=1;i<=m;i++){\n    scanf(\"%d%d\",&s[i*2].f,&s[i*2].t);\n    s[i*2-1]=(Pair){s[i*2].t,s[i*2].f};\n  }m*=2;\n  for (int t=1;t<=n+k;t++){\n    for (int i=1;i<=n;i++)\n      add(code(t-1,i),code(t,i),INF,0);\n    for (int i=1;i<=m;i++){\n      add(code(t-1,s[i].f),code(t,s[i].t),1,D);\n      pl[t][i]=cnt;st[t][i]=1;\n    }add(code(t,1),T,INF,t*C);\n  }\n  int aug,tot=0;\n  while((aug=spfa())!=0){\n    int u=T;\n    while(u!=S){\n      int v=pre[u];\n      e[last[u]].cap-=aug;\n      e[last[u]^1].cap+=aug;\n      u=v;\n    }tot+=dist[T]*aug;\n    for (int t=1;t<=n+n;t++)\n      for (int i=1;i<=m;i++)\n        if (e[pl[t][i]].cap){\n          st[t][i]++;\n          add(code(t-1,s[i].f),code(t,s[i].t),1,D*(st[t][i]*2-1));\n          pl[t][i]=cnt;\n        }\n  }printf(\"%d\\n\",tot);\n  return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int INF = 1000000000;\n    static int n, m, k, C, D;\n    static int S, T;\n    static int[] head;\n    static ArrayList<Edge> edges;\n    static int cnt;\n    static int[] pre, last, flow, dist;\n    static boolean[] used;\n    static int[][] pl, st;\n    static Pair[] s;\n\n    static class Edge {\n        int nxt, to, cap, cst;\n        Edge(int nxt, int to, int cap, int cst) {\n            this.nxt = nxt;\n            this.to = to;\n            this.cap = cap;\n            this.cst = cst;\n        }\n    }\n\n    static class Pair {\n        int f, t;\n        Pair(int f, int t) {\n            this.f = f;\n            this.t = t;\n        }\n    }\n\n    static int code(int x, int y) {\n        return x * n + y;\n    }\n\n    static int add(int f, int t, int cap, int cst) {\n        edges.add(new Edge(head[f], t, cap, cst));\n        head[f] = cnt;\n        cnt++;\n        edges.add(new Edge(head[t], f, 0, -cst));\n        head[t] = cnt;\n        cnt++;\n        return cnt - 2; // index of forward edge\n    }\n\n    static int spfa() {\n        Arrays.fill(dist, INF);\n        Arrays.fill(flow, 0);\n        flow[S] = INF;\n        dist[S] = 0;\n        LinkedList<Integer> que = new LinkedList<>();\n        que.add(S);\n        used[S] = true;\n        while (!que.isEmpty()) {\n            int u = que.poll();\n            used[u] = false;\n            for (int i = head[u]; i != 0; i = edges.get(i).nxt) {\n                Edge e = edges.get(i);\n                int v = e.to;\n                if (e.cap > 0 && dist[v] > dist[u] + e.cst) {\n                    dist[v] = dist[u] + e.cst;\n                    flow[v] = Math.min(flow[u], e.cap);\n                    last[v] = i;\n                    pre[v] = u;\n                    if (!used[v]) {\n                        used[v] = true;\n                        que.add(v);\n                    }\n                }\n            }\n        }\n        return flow[T];\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        C = sc.nextInt();\n        D = sc.nextInt();\n\n        int maxNodes = n * (n + k + 1) + 2 + 5;\n        head = new int[maxNodes + 5];\n        edges = new ArrayList<>();\n        edges.add(new Edge(0, 0, 0, 0)); // dummy at index 0\n        cnt = 1;\n        pre = new int[maxNodes + 5];\n        last = new int[maxNodes + 5];\n        flow = new int[maxNodes + 5];\n        dist = new int[maxNodes + 5];\n        used = new boolean[maxNodes + 5];\n\n        S = code(n + k, n) + 1;\n        T = S + 2;\n\n        add(code(0, 1), T, INF, 0);\n\n        for (int i = 1; i <= k; i++) {\n            int p = sc.nextInt();\n            add(S, code(0, p), 1, 0);\n        }\n\n        s = new Pair[2 * m + 2];\n        for (int i = 1; i <= m; i++) {\n            int f = sc.nextInt();\n            int t = sc.nextInt();\n            s[2 * i] = new Pair(f, t);\n            s[2 * i - 1] = new Pair(t, f);\n        }\n        m *= 2;\n\n        pl = new int[n + k + 2][2 * m + 2];\n        st = new int[n + k + 2][2 * m + 2];\n\n        for (int t = 1; t <= n + k; t++) {\n            for (int i = 1; i <= n; i++) {\n                add(code(t - 1, i), code(t, i), INF, 0);\n            }\n            for (int i = 1; i <= m; i++) {\n                int idx = add(code(t - 1, s[i].f), code(t, s[i].t), 1, D);\n                pl[t][i] = idx;\n                st[t][i] = 1;\n            }\n            add(code(t, 1), T, INF, t * C);\n        }\n\n        int aug, tot = 0;\n        while ((aug = spfa()) != 0) {\n            int u = T;\n            while (u != S) {\n                int v = pre[u];\n                Edge e = edges.get(last[u]);\n                e.cap -= aug;\n                edges.get(last[u] ^ 1).cap += aug;\n                u = v;\n            }\n            tot += dist[T] * aug;\n            for (int t = 1; t <= n + n; t++) {\n                for (int i = 1; i <= m; i++) {\n                    if (edges.get(pl[t][i]).cap > 0) {\n                        st[t][i]++;\n                        int idx = add(code(t - 1, s[i].f), code(t, s[i].t), 1, D * (st[t][i] * 2 - 1));\n                        pl[t][i] = idx;\n                    }\n                }\n            }\n        }\n        System.out.println(tot);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001740304142003879, -0.005344389472156763, 0.0, -7.033323527139146e-06, -0.0049935863353312016, -0.0005847889697179198, -2.3841855067985307e-07, -0.0019595485646277666, -0.0009179668850265443, -3.182837463100441e-05, -0.0017835675971582532, -0.49847954511642456, -6.198863957251888e-06, -1.2397689715726301e-05, -2.3841855067985307e-07, -1.0728830375228426e-06,