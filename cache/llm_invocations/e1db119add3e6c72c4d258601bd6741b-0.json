System.out.println(finalState.depth + \"\\n\" + finalState.ways);\n        } else {\n            System.out.println(\"-1\\n0\");\n        }\n    }\n\n    static void bfs(int state) {\n        int boat = state / 1000000;\n        int currA = (state % 1000000) / 100;\n        int currB = state % 100;\n\n        if (boat == 1) {\n            for (int takeA = currA; takeA >= 0 && 50 * (currA - takeA) <= k; takeA--) {\n                for (int takeB = currB; takeB >= 0 && 50 * (currA - takeA) + 100 * (currB - takeB) <= k; takeB--) {\n                    if (takeA != currA || takeB != currB) {\n                        long ways = (choose[currA][takeA] * choose[currB][takeB]) % MOD;\n                        updateState(takeA, takeB, 0, state, ways);\n                    }\n                }\n            }\n        } else {\n            for (int takeA = currA; takeA <= a && 50 * (takeA - currA) <= k; takeA++) {\n                for (int takeB = currB; takeB <= b && 50 * (takeA - currA) + 100 * (takeB - currB) <= k; takeB++) {\n                    if (takeA != currA || takeB != currB) {\n                        long ways = (choose[a - currA][takeA - currA] * choose[b - currB][takeB - currB]) % MOD;\n                        updateState(takeA, takeB, 1, state, ways);\n                    }\n                }\n            }\n        }\n    }\n\n    static void updateState(int newA, int newB, int newBoat, int oldState, long edgeWays) {\n        int newState = encodeState(newBoat, newA, newB);\n        int newDepth = stateMap.get(oldState).depth + 1;\n\n        if (!stateMap.containsKey(newState)) {\n            stateMap.put(newState, new State(newDepth, 0));\n            queue.offer(newState);\n        }\n\n        if (stateMap.get(newState).depth == newDepth) {\n            long currentWays = stateMap.get(newState).ways;\n            long updatedWays = (currentWays + (stateMap.get(oldState).ways * edgeWays) % MOD) % MOD;\n            stateMap.get(newState).ways = updatedWays;\n        }\n    }\n\n    static void precomputeBinomialCoefficients() {\n        for (int i = 0; i < 100; i++) {\n            choose[i][0] = 1;\n        }\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= i; j++) {\n                choose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD;\n            }\n        }\n    }\n\n    static int encodeState(int boat, int aCount, int bCount) {\n        return 1000000 * boat + 100 * aCount + bCount;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque, defaultdict\n\nMOD = 1000000007\nchoose = [[0] * 100 for _ in range(100)]\nqueue = deque()\nstate_map = {}\n\nclass State:\n    def __init__(self, depth, ways):\n        self.depth = depth\n        self.ways = ways\n\ndef encode_state(boat, a_count, b_count):\n    return 1000000 * boat + 100 * a_count + b_count\n\ndef precompute_binomial_coefficients():\n    for i in range(100):\n        choose[i][0] = 1\n    for i in range(1, 100):\n        for j in range(1, i + 1):\n            choose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD\n\ndef bfs(state):\n    boat = state // 1000000\n    curr_a = (state % 1000000) // 100\n    curr_b = state % 100\n\n    if boat == 1:\n        for take_a in range(curr_a, -1, -1):\n            if 50 * (curr_a - take_a) > k:\n                continue\n            for take_b in range(curr_b, -1, -1):\n                if 50 * (curr_a - take_a) + 100 * (curr_b - take_b) > k:\n                    continue\n                if take_a != curr_a or take_b != curr_b:\n                    ways = (choose[curr_a][take_a] * choose[curr_b][take_b]) % MOD\n                    update_state(take_a, take_b, 0, state, ways)\n    else:\n        for take_a in range(curr_a, a + 1):\n            if 50 * (take_a - curr_a) > k:\n                continue\n            for take_b