val, bit_idx):\n        if bit_idx < 0:\n            return False\n        return ((val >> bit_idx) & 1) == 1\n\n    def set_bit_if_missing(self, val, bit_idx):\n        if ((val >> bit_idx) & 1) == 0:\n            val |= (1 << bit_idx)\n        return val\n\n    def count_set_bits(self, val):\n        cnt = 0\n        while val != 0:\n            cnt += val & 1\n            val >>= 1\n        return cnt\n\n    def validate(self):\n        if not self.get_bit(5, 0):\n            raise AssertionError()\n        if self.get_bit(5, 1):\n            raise AssertionError()\n        if self.get_bit(5, -1):\n            raise AssertionError()\n        if not self.get_bit(5, 2):\n            raise AssertionError()\n        if not self.get_bit(5, 3):\n            raise AssertionError()\n        if self.set_bit_if_missing(0, 2) != 4:\n            raise AssertionError()\n        if self.set_bit_if_missing(4, 0) != 5:\n            raise AssertionError()\n        if self.set_bit_if_missing(5, 0) != 5:\n            raise AssertionError()\n        if self.count_set_bits(5) != 2:\n            raise AssertionError()\n\n    def memoized_search(self, row, required, prior_pattern):\n        if row == self.height:\n            return 0 if required == 0 else self.IMPOSSIBLE\n        state = Coordinate(required, prior_pattern)\n        if state in self.cache[row]:\n            return self.cache[row][state]\n        best = self.IMPOSSIBLE\n        total_patterns = 1 << self.width\n        for pattern in range(total_patterns):\n            present = 0\n            for idx in range(self.width):\n                if ((pattern >> idx) & 1) == 1:\n                    present |= (1 << idx)\n            acceptable = True\n            for k in range(self.width):\n                if self.get_bit(required, k) and not self.get_bit(present, k):\n                    acceptable = False\n                    break\n            if acceptable:\n                next_required = 0\n                for idx in range(self.width):\n                    if not self.get_bit(present, idx - 1) and not self.get_bit(present, idx) and \\\n                       not self.get_bit(present, idx + 1) and not self.get_bit(prior_pattern, idx):\n                        next_required |= (1 << idx)\n                next_step = self.count_set_bits(present) + self.memoized_search(row + 1, next_required, present)\n                if next_step < best:\n                    best = next_step\n        self.cache[row][state] = best\n        return best\n\n    def run(self, case_num, reader, writer):\n        self.validate()\n        a = reader.read_number()\n        b = reader.read_number()\n        self.width = min(a, b)\n        self.height = max(a, b)\n        self.cache = [dict() for _ in range(self.height)]\n        answer = self.memoized_search(0, 0, 0)\n        writer.print_line(self.width * self.height - answer)\n\ndef main():\n    try:\n        scanner = InputReader(sys.stdin.buffer)\n        printer = OutputWriter(sys.stdout)\n        solver = ProblemTask()\n        solver.run(1, scanner, printer)\n        printer.close()\n    except Exception as ex:\n        sys.stderr.write(\"Error: \" + str(ex) + \"\\n\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010680581908673048, -1.0728830375228426e-06, -1.1920928244535389e-07, -0.0006462631281465292, -0.0017922543920576572, -0.0009248746791854501, -0.5231450796127319, -0.034429728984832764, -2.3841855067985307e-07, -0.00021634146105498075, -0.022383196279406548, -0.02501155436038971, -0.21283932030200958, -2.455681169521995e-05, -2.3841855067985307e-07, -5.483612312673358e-06, -1.5735502529423684e-05, -1.3828182090946939e-05, -1.1920928244535389e-07, -1.311301275563892e-06, 0.0, -0.3868715763092041, -1.1920928244535389e-07, -4.768370445162873e-07, -2.622600959512056e-06, -1.311301275563892e-06, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-0