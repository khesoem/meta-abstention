ream input;\n        private final byte[] buffer = new byte[1024];\n        private int position = 0;\n        private int limit = 0;\n        private SpaceCharacterPredicate condition;\n\n        public InputReader(InputStream stream) {\n            input = stream;\n        }\n\n        private int fetch() {\n            if (position == limit) {\n                position = 0;\n                try {\n                    limit = input.read(buffer);\n                } catch (IOException ex) {\n                    throw new InputMismatchException();\n                }\n                if (limit <= 0) return -1;\n            }\n            return buffer[position++];\n        }\n\n        public int readNumber() {\n            int c = fetch();\n            while (isWhitespace(c)) c = fetch();\n            int multiplier = 1;\n            if (c == '-') {\n                multiplier = -1;\n                c = fetch();\n            }\n            int value = 0;\n            while (!isWhitespace(c)) {\n                if (c < '0' || c > '9') throw new InputMismatchException();\n                value = value * 10 + (c - '0');\n                c = fetch();\n            }\n            return value * multiplier;\n        }\n\n        private boolean isWhitespace(int ch) {\n            if (condition != null) return condition.test(ch);\n            return ch == ' ' || ch == '\\n' || ch == '\\r' || ch == '\\t' || ch == -1;\n        }\n\n        public interface SpaceCharacterPredicate {\n            boolean test(int ch);\n        }\n    }\n\n    static class OutputWriter {\n        private final PrintWriter output;\n\n        public OutputWriter(OutputStream stream) {\n            output = new PrintWriter(new BufferedWriter(new OutputStreamWriter(stream)));\n        }\n\n        public void close() {\n            output.close();\n        }\n\n        public void println(int value) {\n            output.println(value);\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_