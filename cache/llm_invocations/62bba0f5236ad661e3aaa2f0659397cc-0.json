     return (x + y) % MOD;\n    }\n\n    static long sub(long x, long y) {\n        x -= y;\n        return (x < 0 ? x + MOD : x);\n    }\n\n    static long mult(long x, long y) {\n        return (x * y) % MOD;\n    }\n\n    static long modpow(long x, long p) {\n        if (p == 0) return 1;\n        if (p % 2 == 1) return mult(x, modpow(x, p - 1));\n        return modpow(mult(x, x), p / 2);\n    }\n\n    static long modinv(long x) {\n        return modpow(x, MOD - 2);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        PrintWriter pw = new PrintWriter(System.out);\n\n        int n = Integer.parseInt(br.readLine());\n        long[][][] T = new long[MAX_N][1 << MAX_N][1 << MAX_N];\n        Map<Long, Long>[] DP = new Map[n + 1];\n        for (int i = 0; i <= n; i++) {\n            DP[i] = new HashMap<>();\n        }\n        int[] family = new int[1 << MAX_N];\n        int[] family_id = new int[1 << MAX_N];\n        List<List<Integer>> family_mask = new ArrayList<>(n + 1);\n\n        for (int i = 0; i <= n; i++) {\n            family_mask.add(new ArrayList<>());\n        }\n\n        for (int mask = 1; mask < (1 << n); mask++) {\n            family[mask] = family[mask >> 1] + (mask & 1);\n        }\n\n        for (int mask = 0; mask < (1 << n); mask++) {\n            family_id[mask] = family_mask[family[mask]].size();\n            family_mask.get(family[mask]).add(mask);\n        }\n\n        for (int k = 0; k <= n; k++) {\n            for (int i = 0; i < family_mask.get(k).size(); i++) {\n                int cm = family_mask.get(k).get(i);\n                for (int mask = 0; mask < (1 << n); mask++) {\n                    long ans = 0;\n                    if ((mask & cm) == mask) continue;\n                    for (int x = 0; x < n; x++) {\n                        if (cm << x) continue;\n                        if ((mask & (1 << x)) == 0) continue;\n                        int newmask = cm | (1 << x);\n                        ans |= 1L << family_id[newmask];\n                    }\n                    T[k][i][mask] = ans;\n                }\n            }\n        }\n\n        long[][] A = new long[n][n];\n        for (int i = 0; i < n; i++) {\n            StringTokenizer st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; j++) {\n                A[i][j] = Long.parseLong(st.nextToken());\n                A[i][j] = mult(A[i][j], modinv(100));\n            }\n        }\n\n        calc(T, family, family_id, family_mask, A, DP, n);\n\n        pw.println(DP[n].get(1));\n\n        pw.close();\n    }\n\n    static void calc(long[][][] T, int[] family, int[] family_id, List<List<Integer>> family_mask, long[][] A, Map<Long, Long>[] DP, int n) {\n        for (int k = 0; k < n; k++) {\n            for (int edges = 0; edges < (1 << n); edges++) {\n                long prob = 1;\n                for (int i = 0; i < n; i++) {\n                    if (edges << i) prob = mult(prob, A[k][i]);\n                    else prob = mult(prob, sub(1, A[k][i]));\n                }\n                for (Map.Entry<Long, Long> S : DP[k].entrySet()) {\n                    long mask = S.getKey();\n                    long newmask = 0;\n                    long p = mult(prob, S.getValue());\n                    for (int i = 0; i < family_mask.get(k).size(); i++) {\n                        if (mask << i) {\n                            newmask |= T[k][i][edges];\n                        }\n                    }\n                    if (newmask != 0) DP[k + 1].put(newmask, add(DP[k + 1].getOrDefault(newmask, 0L), p));\n                }\n            }\n        }\n    }\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.14622946083545685, -0.006252603139728308, -0.014335858635604382, -0.013944361358880997, -0.00018151261610910296, -0.34913891553878784, -0.542737603187561, -0.00040950815309770405, -