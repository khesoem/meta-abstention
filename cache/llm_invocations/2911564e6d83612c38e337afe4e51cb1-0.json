ns += dis[t];\n}\nint main() {\n    cin >> n >> m >> k >> c >> d;\n    int x,y;\n    for(int i = 1; i<=k;i++) { cin >> x;x--;add_edge(s,x,1,0);}\n    for(int i = 1; i<=101;i++) add_edge((i-1)*n,t,k,(i-1)*c);\n    for(int i = 1; i<=m; i++){\n\t\tcin >> x >> y;x--,y--;\n\t\tfor(int i = 1; i<=100; i++) for(int j = 1; j<=k; j++)\n\t\t\tadd_edge(x+(i-1)*n,y+(i-1)*n+n,1,d*((j-1)*2+1)),add_edge(y+(i-1)*n,x+(i-1)*n+n,1,d*((j-1)*2+1));\n \t}\n \tfor(int i = 1; i<=n; i++) for(int j = 1; j<=100; j++) add_edge(i-1+(j-1)*n,i-1+(j-1)*n+n,k,0);\n    for(int i = 1;i<=k;i++) push_rebel();\n    cout << ans << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static final int maxn = 15000;\n    static class Edge {\n        int to, cap, flow, cost;\n        Edge(int to, int cap, int flow, int cost) {\n            this.to = to;\n            this.cap = cap;\n            this.flow = flow;\n            this.cost = cost;\n        }\n    }\n    \n    static List<Edge> e = new ArrayList<>();\n    static List<Integer>[] head = new List[maxn];\n    static long[] dis = new long[10000];\n    static int[] p = new int[10000];\n    static int[] pe = new int[10000];\n    static int[] inq = new int[10000];\n    static int n, m, k, c, d, s = 9998, t = 9999, cur;\n    static long ans = 0;\n    \n    @SuppressWarnings(\"unchecked\")\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        for (int i = 0; i < maxn; i++) {\n            head[i] = new ArrayList<>();\n        }\n        \n        int x, y;\n        for (int i = 1; i <= k; i++) {\n            x = sc.nextInt();\n            x--;\n            add_edge(s, x, 1, 0);\n        }\n  