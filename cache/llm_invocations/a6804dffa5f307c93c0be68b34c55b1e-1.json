o[v]]=true);\n    }\n    return dep[t]<iinf;\n}\npair<int,int> mcmf(){\n    pair<int,int> res(0,0);\n    while(spfa()){\n        int f=iinf;\n        for(int u=t;u!=s;u=to[pre[u]^1]) f=min(f,fw[pre[u]]);\n        for(int u=t;u!=s;u=to[pre[u]^1]) fw[pre[u]]-=f,fw[pre[u]^1]+=f;\n        res.x+=f,res.y+=dep[t]*f;\n    }\n    return res;\n}\n\n//Main\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0),cout.tie(0);\n    cin>>n>>m>>k>>c>>d,mxt=N*3+1;\n    fn=(t=(s=n*mxt)+1)+1;\n    R(i,0,k){int u;cin>>u,--u,adde(s,u,1,0);}\n    while(m--){\n        int u,v; cin>>u>>v,--u,--v;\n        R(i,0,mxt-1)R(p,1,k+1)\n            adde(i*n+u,(i+1)*n+v,1,2*d*p-d),\n            adde(i*n+v,(i+1)*n+u,1,2*d*p-d);\n    }\n    R(u,0,n)R(i,0,mxt-1) adde(i*n+u,(i+1)*n+u,k,0);\n    R(i,0,mxt) adde(i*n,t,k,i*c);\n    pair<int,int> ans=mcmf();\n    assert(ans.x==k);\n    cout<<ans.y<<'\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    idx = 0\n    n = int(data[idx]); idx += 1\n    m = int(data[idx]); idx += 1\n    k = int(data[idx]); idx += 1\n    c = int(data[idx]); idx += 1\n    d = int(data[idx]); idx += 1\n    \n    mxt = n * 3 + 1\n    \n    # Flow network setup\n    s = n * mxt\n    t = s + 1\n    fn = t + 1\n    \n    # Initialize graph structures\n    e = [[] for _ in range(fn)]\n    to = []\n    fw = []\n    co = []\n    \n    def adde(u, v, w, cost):\n        e[u].append(len(to))\n        to.append(v)\n        fw.append(w)\n        co.append(cost)\n        \n        e[v].append(len(to))\n        to.append(u)\n        fw.append(0)\n        co.append(-cost)\n    \n    # Read sources\n    for _ in range(k):\n        u = int(data[idx]) - 1; idx += 1\n        adde(s, u, 1, 0)\n    \n    # Read edges\n    for _ in range(m):\n        u = int(data[idx]) - 1; idx += 1\n        v = int(data[idx]) - 1; idx += 1\n        for i in range(mxt - 1):\n            for p in range(1, k + 1):\n                adde(i * n + u, (i + 1) * n + v, 1, 2 * d * p - d)\n                adde(i * n + v, (i + 1) * n + u, 1, 2 * d * p - d)\n    \n    # Add self-loop edges\n    for u in range(n):\n        for i in range(mxt - 1):\n            adde(i * n + u, (i + 1) * n + u, k, 0)\n    \n    # Add edges to sink\n    for i in range(mxt):\n        adde(i * n, t, k, i * c)\n    \n    # SPFA for shortest path\n    def spfa():\n        dep = [10**9] * fn\n        pre = [-1] * fn\n        vis = [False] * fn\n        q = deque()\n        q.append(s)\n        vis[s] = True\n        dep[s] = 0\n        \n        while q:\n            u = q.popleft()\n            vis[u] = False\n            for idx_edge in e[u]:\n                v = to[idx_edge]\n                if fw[idx_edge] > 0 and dep[v] > dep[u] + co[idx_edge]:\n                    dep[v] = dep[u] + co[idx_edge]\n                    pre[v] = idx_edge\n                    if not vis[v]:\n                        vis[v] = True\n                        q.append(v)\n        \n        return dep[t] < 10**9\n    \n    # MCMF algorithm\n    def mcmf():\n        res_flow = 0\n        res_cost = 0\n        \n        while spfa():\n            f = 10**9\n            u = t\n            while u != s:\n                f = min(f, fw[pre[u]])\n                u = to[pre[u] ^ 1]\n            \n            u = t\n            while u != s:\n                fw[pre[u]] -= f\n                fw[pre[u] ^ 1] += f\n                u = to[pre[u] ^ 1]\n            \n            res_flow += f\n            res_cost += dep[t] * f\n        \n        return (res_flow, res_cost)\n    \n    ans = mcmf()\n    assert ans[0] == k\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00015293381875380874, -1.311301275563892