0\n        for i in range(n):\n            cls.sz[i] = 0\n            cls.adj[i] = []\n\n    @classmethod\n    def add_edge(cls, a, b, c=1, p=0):\n        cls.mc = max(cls.mc, c)\n        cls.adj[a].append(cls.Edge(b, cls.sz[b], 0, c, p))\n        cls.sz[b] += 1\n        cls.adj[b].append(cls.Edge(a, cls.sz[a], 0, 0, -p))\n        cls.sz[a] += 1\n\n    @classmethod\n    def pot_init(cls, n):\n        cls.pot = [0] * n\n        for i in range(1, n):\n            for u in range(n):\n                for e in cls.adj[u]:\n                    if e.c:\n                        cls.pot[e.v] = min(cls.pot[e.v], cls.pot[u] + e.p)\n\n    @classmethod\n    def mcf(cls, s, t, price, n, sparse):\n        vis = [False] * n\n        dist = [INF] * n\n        par = [-1] * n\n        dist[s] = 0\n\n        if sparse:\n            # SPFA\n            dk = deque([s])\n            while dk:\n                u = dk.popleft()\n                if vis[u]:\n                    continue\n                vis[u] = True\n                for e in cls.adj[u]:\n                    if e.f < e.c and dist[e.v] > dist[u] + cls.pot[u] - cls.pot[e.v] + e.p:\n                        dist[e.v] = dist[u] + cls.pot[u] - cls.pot[e.v] + e.p\n                        par[e.v] = e.r\n                        dk.append(e.v)\n        else:\n            # Dense\n            u = s\n            while u != -1:\n                vis[u] = True\n                for e in cls.adj[u]:\n                    if e.f < e.c and dist[e.v] > dist[u] + cls.pot[u] - cls.pot[e.v] + e.p:\n                        dist[e.v] = dist[u] + cls.pot[u] - cls.pot[e.v] + e.p\n                        par[e.v] = e.r\n                u = -1\n                best = INF\n                for i in range(n):\n                    if not vis[i] and dist[i] < best:\n                        best = dist[i]\n                        u = i\n\n        if dist[t] >= INF:\n            return 0\n        df = INF\n        u = t\n        while u != s:\n            r = c