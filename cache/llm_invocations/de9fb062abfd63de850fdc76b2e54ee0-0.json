en = in.read(buf); } catch (IOException e) { throw new RuntimeException(); }\n                if (len <= 0) return -1;\n            }\n            return buf[ptr++];\n        }\n\n        public int nextInt() {\n            int c = read();\n            while (c <= 32) c = read();\n            int val = 0, sign = 1;\n            if (c == '-') { sign = -1; c = read(); }\n            for (; '0' <= c && c <= '9'; c = read()) val = val * 10 + c - '0';\n            return val * sign;\n        }\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMOD = 1000000007\nINF = 10**18 + 1\n\ndef mul(base, a, b, c, d, comb):\n    base = (base * comb[a][b]) % MOD\n    base = (base * comb[c][d]) % MOD\n    return base\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    idx = 0\n    n = int(input_data[idx]); idx += 1\n    K = int(input_data[idx]); idx += 1\n    cnt50 = 0\n    cnt100 = 0\n    for i in range(n):\n        val = int(input_data[idx]); idx += 1\n        if val == 50:\n            cnt50 += 1\n        else:\n            cnt100 += 1\n\n    # Precompute combinations\n    comb = [[0] * 100 for _ in range(100)]\n    for i in range(100):\n        comb[i][0] = 1\n        comb[i][i] = 1\n        for j in range(1, i):\n            comb[i][j] = (comb[i-1][j] + comb[i-1][j-1]) % MOD\n\n    # Initialize dist and ways\n    dist = [[[INF] * 2 for _ in range(200)] for __ in range(200)]\n    ways = [[[0] * 2 for _ in range(200)] for __ in range(200)]\n    \n    dist[0][0][0] = 0\n    ways[0][0][0] = 1\n\n    q = deque()\n    q.append((0, 0, 0, 0))  # (x, y, side, d)\n\n    while q:\n        x, y, side, d = q.popleft()\n        \n        if side == 0:\n            rem50 = cnt50 - x\n            rem100 = cnt100 - y\n            for take50 in range(rem50 + 1):\n                for take100 in range(rem100 + 1):\n       