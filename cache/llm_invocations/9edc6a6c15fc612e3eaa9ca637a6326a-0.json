          int rowMask = right ? (com[id] ^ 63) : com[id];\n            for (int r = 0; r < 6; ++r)\n                if (rowMask & (1 << r)) rows[cnt++] = r;\n            int a = rows[0], bb = rows[1], cc = rows[2];\n            bool ok = false;\n            for (int pm = 0; pm < 6 && !ok; ++pm) {\n                int c0 = perms[pm][0], c1 = perms[pm][1], c2 = perms[pm][2];\n                if (b[a][base + c0] && b[bb][base + c1] && b[cc][base + c2])\n                    ok = true;\n            }\n            if (ok) mask |= (1 << id);\n        }\n        target[mask] = (target[mask] + prob) % MOD;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j) {\n            int per;\n            cin >> per;\n            p[i][j] = (long long)per * modPow(100, MOD - 2) % MOD;\n        }\n    for (int i = n; i < 6; ++i) p[i][i] = 1;\n\n    for (int x = 0; x < 64; ++x) {\n        int cnt = 0;\n        for (int b = 0; b < 6; ++b) if (x & (1 << b)) ++cnt;\n        if (cnt == 3) com.push_back(x);\n    }\n\n    build(false);\n    build(true);\n\n    for (int bit = 0; bit < 20; ++bit)\n        for (int mask = (1 << 20) - 1; mask >= 0; --mask)\n            if (mask & (1 << bit))\n                g[mask] = (g[mask] + g[mask ^ (1 << bit)]) % MOD;\n\n    int ans = 0, full = (1 << 20) - 1;\n    for (int mask = 0; mask <= full; ++mask)\n        ans = (ans + (long long)f[mask] * g[full ^ mask]) % MOD;\n\n    cout << (1 - ans + MOD) % MOD << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef modPow(a, e):\n    return pow(a, e, MOD)\n\ndef build(right, p, com, f, g):\n    perms = [\n        (0,1,2), (0,2,1), (1,0,2), (1,2,0), (2,0,1), (2,1,0)\n    ]\n    target = g if right else f\n    base