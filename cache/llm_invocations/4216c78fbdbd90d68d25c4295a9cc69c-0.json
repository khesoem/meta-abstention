; j <=n; j++)\n            treach[i][j] = reach[i][j];\n    for (i = 1; i <= n; i++) {\n        for (j = 1; j <= n; j++) {\n            if (treach[i][j] == val) {\n                for (k = 0; k < 4; k++) {\n                    int ni = i + dx[k];\n                    int nj = j + dy[k];\n                    if (ni > 0 && nj > 0 && ni <= n && nj <= n && treach[ni][nj] < val && scien[ni][nj] != 'Y') {\n                        reach[ni][nj] = val;\n                    }\n                }\n            }\n        }\n    }\n}\nbool canreach(int sx, int sy, int tx, int ty, int ix, int iy) {\n    memset(reach, 0, sizeof(reach));\n    reach[sx][sy] = 1;\n    reach[ix][iy] = 2;\n    int iters = 100;\n    while (iters--) {\n        expand(1);\n        if (reach[tx][ty] == 1)\n            return true;\n        expand(2);\n        if (reach[tx][ty] == 2)\n            return false; \n    }\n    return false;\n}\nint main() {\n    int infx, infy;\n    memset(shortest, 1, sizeof(shortest));\n    cin >> n >> t;\n    int i, j;\n    for (i = 1; i <= n; i++) {\n        scanf(\" %s\", scien[i] + 1);\n        for (j = 1; j <= n; j++) {\n            shortest[i][j][i][j] = 0;\n            if (scien[i][j] == 'Z') {\n                infx = i;\n                infy = j;\n            }\n        }\n    }\n    for (i = 1; i <= n; i++) {\n        scanf(\" %s\", reac[i] + 1);\n    }\n    for (i = 1; i <= n; i++) {\n        for (j = 1; j <= n; j++) {\n            for (int k = 0; k < 4; k++) {\n                int ni = i + dx[k];\n                int nj = j + dy[k];\n                if (ni <= n && ni > 0 && nj <= n && nj > 0) {\n                    if (scien[i][j] != 'Y' && scien[ni][nj] != 'Y')\n                        shortest[i][j][ni][nj] = 1;\n                }\n            }\n        }\n    }\n    int ki, kj, ii, ij, ji, jj;\n    for (ki = 1; ki <= n; ki++) {\n        for (kj = 1; kj <= n; kj++) {\n            for (ii = 1; ii <= n; ii++) {\n                for (ij = 1; ij <= n; ij++) {\n                    for (ji = 1; ji <= n; ji++) {\n                        for (jj = 1; jj <= n; jj++) {\n                            shortest[ii][ij][ji][jj] = min(\n                                    shortest[ii][ij][ji][jj], \n                                    shortest[ii][ij][ki][kj] + shortest[ki][kj][ji][jj]\n                                    );\n                        }\n                    }\n                }\n            }\n        }\n    }\n    int src = n * n * 2 + 1;\n    int dest = n * n * 2 + 2;\n    for (i = 1; i <= n; i++) {\n        for (j = 1; j <= n; j++) {\n            if (isdigit(scien[i][j])) {\n                cap[src][getnode(i, j)] = scien[i][j] - '0';\n            }\n            if (isdigit(reac[i][j])) {\n                cap[n * n + getnode(i, j)][dest] = reac[i][j] - '0';\n            }\n\n            if (isdigit(scien[i][j])) {\n                for (ki = 1; ki <= n; ki++) {\n                    for (kj = 1; kj <= n; kj++) {\n                        if (scien[i][j] > '0' && reac[ki][kj] > '0') {\n                            if (isdigit(reac[ki][kj]) && shortest[i][j][ki][kj] <= t && canreach(i, j, ki, kj, infx, infy)) {\n                                // printf(\"(%d, %d) can reach (%d, %d)\\n\", i, j, ki, kj);\n                                cap[getnode(i, j)][n * n + getnode(ki, kj)] = 1000;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    int mflow = 0, ret;\n    while ((ret = aug(src, dest, 1000))) {\n        // cout << endl;\n        mflow += ret;\n        iter ++;\n    }\n    cout << mflow << endl;\n    return 0;\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nINF = 10**9\n\ndef getnode(x, y, n):\n    return (x - 1) * n + (y - 1)\n\ndef expand(reach, val, n, scien, dx, dy):\n    # expand cells with value val to neighbors (if not 'Y')\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if reach[i][j] == val:\n                for k in range(4):\n                    ni = i + dx[k]\n                    nj = j + dy[k]\n                    if 1 <= ni <= n and 1 <= nj <= n:\n                        if reach[ni][nj] < val and scien[ni][nj] != 'Y':\n                            reach[ni][nj] = val\n\ndef canreach(sx, sy, tx, ty, ix, iy, n, scien, dx, dy):\n    # returns True if scientist can reach target before infection from (ix,iy)\n    reach = [[0]*(n+1) for _ in range(n+1)]\n    reach[sx][sy] = 1\n    reach[ix][iy] = 2\n    iters = 100\n    while iters > 0:\n        iters -= 1\n        expand(reach, 1, n, scien, dx, dy)\n        if reach[tx][ty] == 1:\n            return True\n        expand(reach, 2, n, scien, dx, dy)\n        if reach[tx][ty] == 2:\n            return False\n    return False\n\ndef aug(cnode, dest, bneck, cap, vis, iter_val):\n    if cnode == dest:\n        return bneck\n    if vis[cnode] == iter_val:\n        return 0\n    vis[cnode] = iter_val\n    for i in range(dest+1):\n        if cap[cnode][i] > 0:\n            cret = aug(i, dest, min(bneck, cap[cnode][i]), cap, vis, iter_val)\n            if cret:\n                cap[cnode][i] -= cret\n                cap[i][cnode] += cret\n                return cret\n    return 0\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    \n    # 1-indexed grids\n    scien = [['']*(n+1) for _ in range(n+1)]\n    reac = [['']*(n+1) for _ in range(n+1)]\n    \n    infx = infy = 0\n    for i in range(1, n+1):\n        line = next(it)\n        # line is a string of length n\n        for j in range(1, n+1):\n            scien[i][j] = line[j-1]\n            if scien[i][j] == 'Z':\n                infx = i\n                infy = j\n    \n    for i in range(1, n+1):\n        line = next(it)\n        for j in range(1, n+1):\n            reac[i][j] = line[j-1]\n    \n    dx = [1, 0, -1, 0]\n    dy = [0, 1, 0, -1]\n    \n    # shortest distances (all-pairs)\n    shortest = [[[[INF]*(n+1) for _ in range(n+1)] for _ in range(n+1)] for _ in range(n+1)]\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            shortest[i][j][i][j] = 0\n            for k in range(4):\n                ni = i + dx[k]\n                nj = j + dy[k]\n                if 1 <= ni <= n and 1 <= nj <= n:\n                    if scien[i][j] != 'Y' and scien[ni][nj] != 'Y':\n                        shortest[i][j][ni][nj] = 1\n    \n    # Floyd-Warshall\n    for ki in range(1, n+1):\n        for kj in range(1, n+1):\n            for ii in range(1, n+1):\n                for ij in range(1, n+1):\n                    for ji in range(1, n+1):\n                        for jj in range(1, n+1):\n                            if shortest[ii][ij][ki][kj] + shortest[ki][kj][ji][jj] < shortest[ii][ij][ji][jj]:\n                                shortest[ii][ij][ji][jj] = shortest[ii][ij][ki][kj] + shortest[ki][kj][ji][jj]\n    \n    total_nodes = 2 * n * n + 3  # indices 0..2*n*n+2\n    cap = [[0]*total_nodes for _ in range(total_nodes)]\n    src = 2 * n * n + 1\n    dest = 2 * n * n + 2\n    \n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if scien[i][j].isdigit():\n                cap[src][getnode(i, j, n)] = int(scien[i][j])\n            if reac[i][j].isdigit():\n                cap[n*n + getnode(i, j, n)][dest] = int(reac[i][j])\n    \n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if scien[i][j].isdigit() and int(scien[i][j]) > 0:\n                for ki in range(1, n+1):\n                    for kj in range(1, n+1):\n                        if reac[ki][kj].isdigit() and int(reac[ki][kj]) > 0:\n                            if shortest[i][j][ki][kj] <= t and canreach(i, j, ki, kj, infx, infy, n, scien, dx, dy):\n                                cap[getnode(i, j, n)][n*n + getnode(ki, kj, n)] = 1000\n    \n    mflow = 0\n    iter_val = 3\n    vis = [0]*total_nodes\n    while True:\n        ret = aug(src, dest, 1000, cap, vis, iter_val)\n        if ret == 0:\n            break\n        mflow += ret\n        iter_val += 1\n    \n    print(mflow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.4543427823809907e-05, 0.0, -1.1920928244535389e-07, -0.0005270045949146152, -0.002492894185706973, 0.0, -0.31331366300582886, -0.13261258602142334, -1.6689286894688848e-06, -5.006777428206988e-06, -0.0015303102554753423, -0.06197265535593033, -4.8993817472364753e-05, -0.3141813278198242, -0.08296957612037659, -0.7167660593986511, -0.004087665118277073, -0.00043108707177452743, -0.00012373158824630082, -1.1920928244535389e-07, -0.004084815736860037, -1.0728830375228426e-06, -0.00010561384988250211, -2.9802276912960224e-06, -0.6941182613372803, -5.8412379075889476e-06, -8.344646857949556e-07, -0.25193479657173157, -1.1920928244535389e-07, -1.311301275563892e-06, -2.622600959512056e-06, -1.1920928244535389e-07, 0.0, 0.0, -0.014163566753268242, -1.0728830375228426e-06, -1.1920928244535389e-07, -1.5497195136049413e-06, -1.1920928244535389e-07, -0.005240394733846188, -0.006035436410456896, -0.169330894947052, -0.0513693168759346, -5.960462772236497e-07, 0.0, -0.12719061970710754, -2.1457441107486375e-05, -0.034083105623722076, -0.008615112863481045, -0.07924827188253403, -5.960446742392378e-06, -0.12693844735622406, -8.237022848334163e-05, -1.311301275563892e-06, 0.0, -0.00151078961789608, -1.1920922133867862e-06, -0.3218981921672821, -1.253845453262329, -0.9232804179191589, -0.02916264347732067, -0.1246347576379776, -0.7116542458534241, -0.06515350192785263, -0.29533371329307556, -0.46070596575737, -0.11498230695724487, -0.3225982189178467, -0.29241418838500977, -3.576278118089249e-07, -0.48120349645614624, -1.4305104514278355e-06, -0.836099