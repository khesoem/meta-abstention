{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define int long long\n#define ll long long\n\nconst ll INF = 1e17 + 7;\nconst int MAXN = 1001;\n\nint dX[4] = {0, 0, -1, 1};\nint dY[4] = {-1, 1, 0, 0};\n\nvector<int> adj[MAXN];\nbool seen[MAXN];\nint matched[MAXN];\n\nbool isGood(int x, int y, const vector<string>& table) {\n    return x >= 0 && y >= 0 && x < (int)table.size() && y < (int)table.size() &&\n           table[x][y] != 'Y' && table[x][y] != 'Z';\n}\n\nvector<vector<int>> getDist(int startX, int startY, const vector<string>& table) {\n    int n = (int)table.size();\n    vector<vector<int>> dist(n, vector<int>(n, INF));\n    queue<pair<int,int>> q;\n    dist[startX][startY] = 0;\n    q.push({startX, startY});\n\n    while (!q.empty()) {\n        pair<int,int> cur = q.front();\n        q.pop();\n\n        for (int k = 0; k < 4; ++k) {\n            int nx = cur.first + dX[k];\n            int ny = cur.second + dY[k];\n\n            if (!isGood(nx, ny, table) || dist[nx][ny] != INF) continue;\n\n            dist[nx][ny] = dist[cur.first][cur.second] + 1;\n            q.push({nx, ny});\n        }\n    }\n\n    return dist;\n}\n\nvoid addEdges(const vector<string>& A, const vector<string>& B, int i, int j, int x, int y) {\n    int L = 100 * i + 10 * j;\n    int R = 100 * x + 10 * y;\n\n    for (int u = 1; u <= A[i][j] - '0'; ++u) {\n        for (int v = 1; v <= B[x][y] - '0'; ++v) {\n            adj[L + u].push_back(R + v);\n        }\n    }\n}\n\nsigned main() {\n    ios_base::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cout.precision(10);\n\n    int n, t;\n    cin >> n >> t;\n\n    vector<string> A(n), B(n);\n    for (int i = 0; i < n; ++i) cin >> A[i];\n    for (int i = 0; i < n; ++i) cin >> B[i];\n\n    int zx = 0, zy = 0;\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            if (A[i][j] == 'Z') zx = i, zy = j;\n\n    vector<vector<int>> toReactor = getDist(zx, zy, A);\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (!isGood(i, j, A)) continue;\n\n            vector<vector<int>> fromStart = getDist(i, j, A);\n\n            for (int x = 0; x < n; ++x) {\n                for (int y = 0; y < n; ++y) {\n                    if (!isGood(x, y, A) || fromStart[x][y] > t || fromStart[x][y] > toReactor[x][y])\n                        continue;\n\n                    if (fromStart[x][y] == toReactor[x][y]) {\n                        bool better = false;\n                        for (int d = 0; d < 4; ++d) {\n                            int nx = x + dX[d];\n                            int ny = y + dY[d];\n                            if (!isGood(nx, ny, A) || fromStart[nx][ny] >= toReactor[nx][ny])\n                                continue;\n                            better = true;\n                        }\n                        if (!better) continue;\n                    }\n\n                    addEdges(A, B, i, j, x, y);\n                }\n            }\n        }\n    }\n\n    std::function<bool(int)> augment;\n    augment = [&](int v) -> bool {\n        if (seen[v]) return false;\n        seen[v] = true;\n\n        for (int to : adj[v]) {\n            if (matched[to] == 0 || augment(matched[to])) {\n                matched[to] = v;\n                return true;\n            }\n        }\n\n        return false;\n    };\n\n    for (int i = 0; i < MAXN; ++i) {\n        augment(i);\n        fill(seen, seen + MAXN, false);\n    }\n\n    int result = 0;\n    for (int i = 0; i < MAXN; ++i) result += (matched[i] != 0);\n\n    cout << result;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nsys.setrecursionlimit(10000)\n\ndef solve() -> None:\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    A = [list(next(it).strip()) for _ in range(n)]\n    B = [list(next(it).strip()) for _ in range(n)]\n\n    INF = 10**17 + 7\n    MAXN = 1001\n    dX = [0, 0, -1, 1]\n    dY = [-1, 1, 0, 0]\n\n    def isGood(x: int, y: int, table) -> bool:\n        return 0 <= x < n and 0 <= y < n and table[x][y] != 'Y' and table[x][y] != 'Z'\n\n    def getDist(startX: int, startY: int, table) -> list:\n        dist = [[INF]*n for _ in range(n)]\n        from collections import deque\n        q = deque()\n        dist[startX][startY] = 0\n        q.append((startX, startY))\n        while q:\n            cx, cy = q.popleft()\n            for k in range(4):\n                nx = cx + dX[k]\n                ny = cy + dY[k]\n                if not isGood(nx, ny, table) or dist[nx][ny] != INF:\n                    continue\n                dist[nx][ny] = dist[cx][cy] + 1\n                q.append((nx, ny))\n        return dist\n\n    # find reactor position\n    zx = zy = 0\n    for i in range(n):\n        for j in range(n):\n            if A[i][j] == 'Z':\n                zx, zy = i, j\n\n    toReactor = getDist(zx, zy, A)\n\n    adj = [[] for _ in range(MAXN)]\n\n    def addEdges(i, j, x, y):\n        L = 100 * i + 10 * j\n        R = 100 * x + 10 * y\n        for u in range(1, int(A[i][j]) + 1):\n            for v in range(1, int(B[x][y]) + 1):\n                adj[L + u].append(R + v)\n\n    for i in range(n):\n        for j in range(n):\n            if not isGood(i, j, A):\n                continue\n            fromStart = getDist(i, j, A)\n            for x in range(n):\n                for y in range(n):\n                    if not isGood(x, y, A):\n                        continue\n                    d = fromStart[x][y]\n                    if d > t or d > toReactor[x][y]:\n                        continue\n                    if d == toReactor[x][y]:\n                        better = False\n                        for k in range(4):\n                            nx = x + dX[k]\n                            ny = y + dY[k]\n                            if not isGood(nx, ny, A):\n                                continue\n                            if fromStart[nx][ny] < toReactor[nx][ny]:\n                                better = True\n                                break\n                        if not better:\n                            continue\n                    addEdges(i, j, x, y)\n\n    matched = [0] * MAXN\n    seen = [False] * MAXN\n\n    def augment(v: int) -> bool:\n        if seen[v]:\n            return False\n        seen[v] = True\n        for to in adj[v]:\n            if matched[to] == 0 or augment(matched[to]):\n                matched[to] = v\n                return True\n        return False\n\n    for v in range(MAXN):\n        augment(v)\n        seen = [False] * MAXN\n\n    result = sum(1 for m in matched if m != 0)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [0.0, -0.00035255891270935535, -0.0007169060409069061, 0.0, -0.00019560330838430673, -0.45601034164