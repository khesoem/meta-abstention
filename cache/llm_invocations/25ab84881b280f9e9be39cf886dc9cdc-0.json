[int]]:\n    n = len(A)\n    m = len(B)\n    p = len(B[0]) if B else 0\n    C = [[0] * p for _ in range(n)]\n    for i in range(n):\n        for k in range(m):\n            if A[i][k]:\n                for j in range(p):\n                    C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD\n    return C\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    K = int(data[1])\n    \n    # Determine base-K digits count\n    cur = 1\n    cnt = 0\n    while cur <= N:\n        cur *= K\n        cnt += 1\n    if cnt > 0:\n        cur //= K\n    \n    d = [0] * cnt\n    for i in range(cnt):\n        d[i] = N // cur\n        N %= cur\n        cur //= K\n    \n    # Allocate matrices\n    R = [None] * (K + 1)\n    for i in range(K + 1):\n        R[i] = alloc_mat(K + 1, K + 1)\n    \n    D = [[None] * K for _ in range(cnt + 1)]\n    for i in range(cnt + 1):\n        for j in range(K):\n            D[i][j] = alloc_mat(K + 1, K + 1)\n    \n    # Build R matrices\n    R[0][K][K] = 1\n    R[1][K][K] = 1\n    for j in range(K):\n        R[0][j][j] = 1\n        R[1][(j + K - 1) % K][j] = 1\n    \n    for j in range(2, K + 1):\n        R[j] = multiply(R[j - 1], R[1])\n    \n    # Build D matrices\n    for j in range(K + 1):\n        D[0][0][j][j] = 1\n        D[0][0][j][0] = 1\n    \n    for i in range(cnt + 1):\n        for j in range(1, K):\n            D[i][j] = multiply(D[i][j - 1], multiply(multiply(R[K - j], D[i][0]), R[j]))\n        if i < cnt:\n            D[i + 1][0] = D[i][K - 1]\n    \n    # Final computation\n    res = [[0] * (K + 1)]\n    res[0][K] = 1\n    md = 0\n    for i in range(cnt):\n        if d[i]:\n            tmp1 = multiply(R[K - md], D[cnt - i - 1][d[i] - 1])\n            tmp2 = multiply(tmp1, R[md])\n            res = multiply(res, tmp2)\n        md = (md + d[i]) % K\n    \n    out = 0\n    for i in range(K + 1):\n        out = (out + res[0][i]) % MOD\n    print(out)\n\nif __name__ == \"__main__\":\n   