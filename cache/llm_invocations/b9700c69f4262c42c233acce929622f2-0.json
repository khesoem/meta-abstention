{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++0x code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++0x code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstdlib>\n#include <cstring>\n#include <vector>\n#include <cassert>\n\nusing namespace std;\n\ntypedef long long ll;\n\nconst int mod = 1000000007;\nconst int M = 32;\nconst int MAXD = 64;\nconst int MAXK = 32;\n\nint add(int a, int b) {\n    int r = a + b;\n    if (r >= mod) r -= mod;\n    return r;\n}\n\nint mul(int a, int b) {\n    return (ll(a) * b) % mod;\n}\n\nstruct matrix {\n    vector<vector<int>> a;\n    matrix() : a(M, vector<int>(M, 0)) {}\n    int* operator[](int i) { return a[i].data(); }\n    friend matrix operator*(const matrix& x, const matrix& y) {\n        matrix r;\n        for (int i = 0; i < M; ++i)\n            for (int j = 0; j < M; ++j)\n                for (int k = 0; k < M; ++k)\n                    r[i][j] = add(r[i][j], mul(x[i][k], y[k][j]));\n        return r;\n    }\n};\n\nmatrix f[MAXD];\nint k;\n\nmatrix calc_matrix(int n, int off) {\n    matrix ans;\n    for (int i = 0; i <= k; ++i)\n        for (int j = 0; j <= k; ++j) {\n            int ni = (i == k) ? i : (i + off) % k;\n            int nj = (j == k) ? j : (j + off) % k;\n            ans[ni][nj] = f[n][i][j];\n        }\n    return ans;\n}\n\nint sum_digits(ll n) {\n    int s = 0;\n    while (n) {\n        s += n % k;\n        n /= k;\n    }\n    return s % k;\n}\n\nint main() {\n    ll n;\n    scanf(\"%lld %d\", &n, &k);\n\n    int ndigits = 0;\n    ll t = n;\n    while (t) { t /= k; ++ndigits; }\n\n    matrix id;\n    for (int i = 0; i <= k; ++i) id[i][i] = 1;\n\n    f[0] = id;\n    for (int i = 0; i <= k; ++i) f[0][i][0] = 1;\n    for (int i = 1; i < ndigits; ++i) {\n        f[i] = id;\n        for (int j = 0; j < k; ++j)\n            f[i] = f[i] * calc_matrix(i - 1, j);\n    }\n\n    ll cur = 0;\n    ll pw = 1;\n    --ndigits;\n    for (int i = 0; i < ndigits; ++i) pw *= k;\n\n    matrix ans = id;\n    while (cur < n) {\n        while (cur + pw <= n) {\n            ans = ans * calc_matrix(ndigits, sum_digits(cur));\n            cur += pw;\n        }\n        pw /= k;\n        --ndigits;\n    }\n\n    int sum = 0;\n    for (int i = 0; i <= k; ++i) sum = add(sum, ans[k][i]);\n    printf(\"%d\\n\", sum);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nMOD = 1000000007\nM = 32\nMAXD = 64\n\ndef add(a, b):\n    r = a + b\n    if r >= MOD:\n        r -= MOD\n    return r\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef mat_mul(x, y):\n    r = [[0]*M for _ in range(M)]\n    for i in range(M):\n        for j in range(M):\n            s = 0\n            for k in range(M):\n                s = add(s, mul(x[i][k], y[k][j]))\n            r[i][j] = s\n    return r\n\ndef calc_matrix(n, off, f, k):\n    ans = [[0]*M for _ in range(M)]\n    for i in range(k+1):\n        for j in range(k+1):\n            ni = i if i == k else (i + off) % k\n            nj = j if j == k else (j + off) % k\n            ans[ni][nj] = f[n][i][j]\n    return ans\n\ndef sum_digits(n, k):\n    s = 0\n    while n:\n        s += n % k\n        n //= k\n    return s % k\n\ndef main():\n    import sys\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n\n    ndigits = 0\n    t = n\n    while t:\n        t //= k\n        ndigits += 1\n\n    # identity matrix\n    id_mat = [[0]*M for _ in range(M)]\n    for i in range(k+1):\n        id_mat[i][i] = 1\n\n    f = [None] * MAXD\n    f[0] = [row[:] for row in id_mat]\n    for i in range(k+1):\n        f[0][i][0] = 1\n\n    for i in range(1, ndigits):\n        f[i] = [row[:] for row in id_mat]\n        for j in range(k):\n            f[i] = mat_mul(f[i], calc_matrix(i-1, j, f, k))\n\n    cur = 0\n    pw = 1\n    ndigits -= 1\n    for _ in range(ndigits):\n        pw *= k\n\n    ans = [row[:] for row in id_mat]\n    while cur < n:\n        while cur + pw <= n:\n            ans = mat_mul(ans, calc_matrix(ndigits, sum_digits(cur, k), f, k))\n            cur += pw\n        pw //= k\n        ndigits -= 1\n\n    total = 0\n    for i in range(k+1):\n        total = add(total, ans[k][i])\n    print(total)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.106198947643861e-06, 0.0, -1.1920928244535389e-07, -0.00027891082572750747, -0.6484010219573975, -5.960462772236497e-07, -2.3841855067985307e-07, -5.221230458118953e-05, 0.0, -3.576278118089249e-07, 0.0, -0.003185913898050785, -0.0015148365637287498, -1.728519782773219e-05, -1.1920928244535389e-07, -8.344646857949556e-07, -0.24297448992729187, -2.145764938177308e-06, -5.519237674889155e-05, -2.3841855067985307e-07, -2.3841855067985307e-07, -5.006777428206988e-06, -0.4742667078971863, -9.142934868577868e-05, -5.125986263010418e-06, -3.576272320060525e-06, -6.687417771900073e-05, 0.0, -1.7881377516459906e-06, -1.1920928244535389e-07, -9.262132516596466e-05, -1.1920928244535389e-07, -5.364403477869928e-06, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -0.00020358874462544918, 0.0