d[u] = edgeCnt++;\n        }\n    }\n\n    static class HopcroftKarp {\n        static final int INF = 10000000;\n        static final int NIL = 0;\n\n        int m, n;\n        int[] head, to, nxt;\n        int[] pairU, pairV, dist;\n\n        HopcroftKarp(int m, int n, int[] head, int[] to, int[] nxt) {\n            this.m = m;\n            this.n = n;\n            this.head = head;\n            this.to = to;\n            this.nxt = nxt;\n            pairU = new int[m + 1];\n            pairV = new int[n + 1];\n            dist = new int[m + 1];\n        }\n\n        int maxMatching() {\n            Arrays.fill(pairU, NIL);\n            Arrays.fill(pairV, NIL);\n            int res = 0;\n            while (bfs()) {\n                for (int i = 1; i <= m; i++) {\n                    if (pairU[i] == NIL && dfs(i)) res++;\n                }\n            }\n            return res;\n        }\n\n        boolean bfs() {\n            ArrayDeque<Integer> queue = new ArrayDeque<>();\n            for (int i = 1; i <= m; i++) {\n                if (pairU[i] == NIL) {\n                    queue.add(i);\n                    dist[i] = 0;\n                } else {\n                    dist[i] = INF;\n                }\n            }\n            dist[NIL] = INF;\n\n            while (!queue.isEmpty()) {\n                int u = queue.poll();\n                if (dist[u] < dist[NIL]) {\n                    for (int e = head[u]; e != -1; e = nxt[e]) {\n                        int v = to[e];\n                        if (dist[pairV[v]] == INF) {\n                            queue.add(pairV[v]);\n                            dist[pairV[v]] = dist[u] + 2;\n                        }\n                    }\n                }\n            }\n            return dist[NIL] < INF;\n        }\n\n        boolean dfs(int u) {\n            if (u == NIL) return true;\n            for (int e = head[u]; e != -1; e = nxt[e]) {\n                int v = to[e];\n                if (dist[pairV[v]] == dist[u] + 2) {\n                    if (dfs(pairV[v])) {\n                        pairV[v] = u;\n                        pairU[u] = v;\n                        return true;\n                    }\n                }\n            }\n            dist[u] = INF;\n            return false;\n        }\n    }\n\n    static class InputReader {\n        private InputStream stream;\n        private byte[] buf = new byte[1024];\n        private int curChar;\n        private int numChars;\n        private SpaceCharFilter filter;\n\n        public InputReader(InputStream stream) {\n            this.stream = stream;\n        }\n\n        public int read() {\n            if (numChars == -1) throw new InputMismatchException();\n            if (curChar >= numChars) {\n                curChar = 0;\n                try {\n                    numChars = stream.read(buf);\n                } catch (IOException e) {\n                    throw new InputMismatchException();\n                }\n                if (numChars <= 0) return -1;\n            }\n            return buf[curChar++];\n        }\n\n        public int nextInt() {\n            int c = read();\n            while (isSpaceChar(c)) c = read();\n            int sgn = 1;\n            if (c == '-') {\n                sgn = -1;\n                c = read();\n            }\n            int res = 0;\n            do {\n                if (c < '0' || c > '9') throw new InputMismatchException();\n                res = res * 10 + (c - '0');\n                c = read();\n            } while (!isSpaceChar(c));\n            return res * sgn;\n        }\n\n        public boolean isSpaceChar(int c) {\n            if (filter != null) return filter.isSpaceChar(c);\n            return c == ' ' || c == '\\n' || c == '\\r' || c == '\\t' || c == -1;\n        }\n\n        public interface SpaceCharFilter {\n            boolean isSpaceChar(int ch);\n        }\n    }\n\n    static class OutputWriter {\n        private final PrintWriter writer;\n\n      