inal int NN = 6555;\n    static final int inf = 0x3f3f3f3f;\n\n    static class Edge {\n        int to, capacity, cost, rev;\n\n        Edge() {}\n\n        Edge(int to, int _capacity, int _cost, int _rev) {\n            this.to = to;\n            this.capacity = _capacity;\n            this.cost = _cost;\n            this.rev = _rev;\n        }\n    }\n\n    static class MinCostMaxFlow {\n        int V;\n        int[] H = new int[NN + 5];\n        int[] dis = new int[NN + 5];\n        int[] PreV = new int[NN + 5];\n        int[] PreE = new int[NN + 5];\n        List<Edge>[] G = new List[NN + 5];\n\n        @SuppressWarnings(\"unchecked\")\n        MinCostMaxFlow() {\n            for (int i = 0; i <= NN + 4; i++) {\n                G[i] = new ArrayList<>();\n            }\n        }\n\n        void Init(int n) {\n            V = n;\n            for (int i = 0; i <= V; i++) {\n                G[i].clear();\n            }\n        }\n\n        void add_edge(int from, int to, int cap, int cost) {\n            G[from].add(new Edge(to, cap, cost, G[to].size()));\n            G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n        }\n\n        int minCost(int s, int t, int f) {\n            int flow = 0;\n            int res = 0;\n            Arrays.fill(H, 0, 1 + V, 0);\n            while (f > 0) {\n                PriorityQueue<int[]> q = new PriorityQueue<>(Comparator.comparingInt(a -> a[0]));\n                Arrays.fill(dis, 0, 1 + V, inf);\n                dis[s] = 0;\n                q.offer(new int[]{0, s});\n                while (!q.isEmpty()) {\n                    int[] now = q.poll();\n                    int v = now[1];\n                    if (dis[v] < now[0]) continue;\n                    for (int i = 0; i < G[v].size(); i++) {\n                        Edge e = G[v].get(i);\n                        if (e.capacity > 0 && dis[e.to] > dis[v] + e.cost + H[v] - H[e.to]) {\n                            dis[e.to] = dis[v] + e.cost + H[v] - H[e.to];\n                            PreV[e.to] = v;\n                            PreE[e.to] = i;\n                            q.offer(new int[]{dis[e.to], e.to});\n                        }\n                    }\n                }\n                if (dis[t] == inf) break;\n                for (int i = 0; i <= V; i++) {\n                    H[i] += dis[i];\n                }\n                int d = f;\n                for (int v = t; v != s; v = PreV[v]) {\n                    d = Math.min(d, G[PreV[v]][PreE[v]].capacity);\n                }\n                f -= d;\n                flow += d;\n                res += d * H[t];\n                for (int v = t; v != s; v = PreV[v]) {\n                    Edge e = G[PreV[v]][PreE[v]];\n                    e.capacity -= d;\n                    G[v].get(e.rev).capacity += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        \n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n        \n        MinCostMaxFlow mcmf = new MinCostMaxFlow();\n        mcmf.Init(n * (n + 55) + 2);\n        \n        for (int i = 0; i < k; i++) {\n            int u = sc.nextInt();\n            mcmf.add_edge(0, u, 1, 0);\n        }\n        \n        int[][] edges = new int[m][2];\n        for (int i = 0; i < m; i++) {\n            edges[i][0] = sc.nextInt();\n            edges[i][1] = sc.nextInt();\n        }\n        \n        int tar = n * (n + 55) + 1;\n        for (int t = 0; t < n + 54; t++) {\n            for (int[] e : edges) {\n                for (int j = 1; j <= k; j++) {\n                    mcmf.add_edge(e[0] + t * n, e[1] + (t + 1) * n, 1, c + d * (j * 2 - 1));\n                    mcmf.add_edge(e[1] + t * n, e[0] + (t + 1) * n, 1, c + d * (j * 2 - 1));\n                }\n            }\n            for (int i =