   }\n    }\n  }\n  if(minHeight+1!=height[u]){\n    --gap[height[u]];\n    if(gap[height[u]]==0)gridVis[0][0]=false;\n    height[u]=minHeight+1;\n    ++gap[height[u]];\n  }\n}\n\nbool findPath(){\n  pathFound=false;pred[0]=sinkNode;totalPath=0;path[0]=0;\n  augmentPath(0,sinkNode);return pathFound;\n}\n\nvoid pushFlow(){\n  for(int i=1;i<=totalPath;++i){\n    if(path[i]>0)flow[abs(path[i-1])][path[i]]+=pred[0];\n    else flow[-path[i]][abs(path[i-1])]-=pred[0];\n  }\n}\n\nint main(){\n  cin>>m>>limit;\n  for(int i=1;i<=m;++i){\n    cin>>input+1;\n    for(int j=1;j<=m;++j){\n      if(input[j]=='Z'){\n        Point start={i,j,0};bfsQueue.push(start);\n      }else if(input[j]!='Y'){\n        gridVis[i][j]=true;origGrid[i][j]=true;\n        dist[i][j]=limit;\n        int val=input[j]-'0';\n        if(val>0){\n          a[i][j]=++totalNodes;\n          cap[0][totalNodes]=val;\n          sinkNode+=val;\n        }\n      }\n    }\n  }\n  memcpy(origGrid,gridVis,sizeof(gridVis));\n  for(int i=1;i<=m;++i){\n    cin>>input+1;\n    for(int j=1;j<=m;++j){\n      if(input[j]=='Z'||input[j]=='Y')continue;\n      int val=input[j]-'0';\n      if(val>0){\n        b[i][j]=++totalNodes;\n        cap[totalNodes][m*m+1]=val;\n      }\n    }\n  }\n  if(totalNodes!=m*m){\n    for(int i=1;i<=m;++i)\n      for(int j=1;j<=m;++j)\n        if(b[i][j]>0){\n          int idx=b[i][j];\n          cap[idx][totalNodes+1]=cap[idx][m*m+1];\n          cap[idx][m*m+1]=0;\n        }\n  }\n  while(!bfsQueue.empty()){\n    Point cur=bfsQueue.front();bfsQueue.pop();\n    int r=cur.r,c=cur.c;dist[r][c]=cur.dis;\n    for(int k=0;k<4;++k)\n      if(gridVis[r+dr[k]][c+dc[k]]){\n        Point next={r+dr[k],c+dc[k],cur.dis+1};bfsQueue.push(next);\n        gridVis[r+dr[k]][c+dc[k]]=false;\n      }\n  }\n  for(int i=1;i<=m;++i)\n    for(int j=1;j<=m;++j){\n      if(a[i][j]==0)continue;\n      memcpy(gridVis,origGrid,sizeof(origGrid));\n      gridVis[i][j]=false;\n      Point start={i,j,0};bfsQueue.push(start);\n  