or (int i = 0; i < (int)g[u].size(); ++i) {\n                    auto& e = g[u][i];\n                    if (e.cap > 0 && dist[e.to] > dist[u] + e.cost) {\n                        dist[e.to] = dist[u] + e.cost;\n                        prevv[e.to] = u;\n                        preve[e.to] = i;\n                        if (!inq[e.to]) {\n                            inq[e.to] = true;\n                            q.push(e.to);\n                        }\n                    }\n                }\n            }\n            \n            if (dist[T] == INF) break;\n            \n            int flow = INF;\n            for (int v = T; v != S; v = prevv[v])\n                flow = min(flow, g[prevv[v]][preve[v]].cap);\n            \n            result.first += flow;\n            result.second += flow * dist[T];\n            \n            for (int v = T; v != S; v = prevv[v]) {\n                Edge& e = g[prevv[v]][preve[v]];\n                e.cap -= flow;\n                g[v][e.rev].cap += flow;\n            }\n        }\n        return result;\n    }\n};\n\nint idx(int i, int j, int n) { return i * n + j; }\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    \n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n    \n    int cs = 2 * k;\n    int total = cs * n + 2;\n    int src = total - 2, dst = total - 1;\n    \n    MCMF solver(total, src, dst);\n    \n    for (int i = 0; i < k; ++i) {\n        int tp;\n        cin >> tp;\n        solver.link(src, idx(0, tp, n), 1, 0);\n    }\n    \n    vector<pii> E(m);\n    for (int i = 0; i < m; ++i) {\n        cin >> E[i].first >> E[i].second;\n    }\n    \n    for (int layer = 1; layer <= cs - 1; ++layer) {\n        solver.link(idx(layer, 1, n), dst, k, c * layer);\n        for (int node = 1; node <= n; ++node) {\n            solver.link(idx(layer - 1, node, n), idx(layer, node, n), k, 0);\n        }\n        for (int i = 0; i < m; ++i) {\n            int u = E[i].first, v = E[i].second;\n      