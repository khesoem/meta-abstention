  if self.dist[self.T] == 10**9:\n                break\n            \n            flow = 10**9\n            v = self.T\n            while v != self.S:\n                flow = min(flow, self.g[self.prevv[v]][self.preve[v]].cap)\n                v = self.prevv[v]\n            \n            result[0] += flow\n            result[1] += flow * self.dist[self.T]\n            \n            v = self.T\n            while v != self.S:\n                e = self.g[self.prevv[v]][self.preve[v]]\n                e.cap -= flow\n                self.g[v][e.rev].cap += flow\n                v = self.prevv[v]\n        \n        return tuple(result)\n\ndef idx(i, j, n):\n    return i * n + j\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    cs = 2 * k\n    total = cs * n + 2\n    src = total - 2\n    dst = total - 1\n    \n    solver = MCMF(total, src, dst)\n    \n    for i in range(k):\n        tp = int(next(it))\n        solver.link(src, idx(0, tp, n), 1, 0)\n    \n    E = []\n    for i in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        E.append((u, v))\n    \n    for layer in range(1, cs):\n        solver.link(idx(layer, 1, n), dst, k, c * layer)\n        for node in range(1, n + 1):\n            solver.link(idx(layer - 1, node, n), idx(layer, node, n), k, 0)\n        for i in range(m):\n            u, v = E[i]\n            for t in range(1, k + 1):\n                w = (2 * t - 1) * d\n                solver.link(idx(layer - 1, u, n), idx(layer, v, n), 1, w)\n                solver.link(idx(layer - 1, v, n), idx(layer, u, n), 1, w)\n    \n    print(solver.solve()[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00011395759065635502, -1.1920922133867862e-06, -1.1920928244535389e-07, -0.08043121546506882, -0.00