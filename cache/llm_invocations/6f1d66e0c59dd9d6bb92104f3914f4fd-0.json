n):\n        I[i][i] = 1\n    return I\n\ndef process():\n    data = sys.stdin.readline().split()\n    N = int(data[0])\n    B = int(data[1])\n    dim = B + 1\n    \n    # Initialize base_matrices\n    base_matrices = [[None for _ in range(B)] for _ in range(60)]\n    \n    for b in range(B):\n        base_matrices[0][b] = identity_mat(dim)\n        for i in range(dim):\n            for j in range(dim):\n                if i == j or b == i:\n                    base_matrices[0][b][i][j] = 1\n    \n    for level in range(1, 60):\n        for b in range(B):\n            base_matrices[level][b] = identity_mat(dim)\n            for offset in range(B):\n                base_matrices[level][b] = mat_mult(base_matrices[level][b], base_matrices[level-1][(b + offset) % B])\n    \n    result = identity_mat(dim)\n    level = 0\n    step = 1\n    while step <= N // B:\n        level += 1\n        step *= B\n    \n    current_b = 0\n    while level >= 0:\n        count = (N // step) % B\n        for _ in range(count):\n            result = mat_mult(result, base_matrices[level][current_b])\n            current_b += 1\n            if current_b >= B:\n                current_b -= B\n        level -= 1\n        if level >= 0:\n            step //= B\n    \n    answer = 0\n    for i in range(dim):\n        answer = (answer + result[i][B]) % MOD\n    print(answer)\n\nif __name__ == \"__main__\":\n    process()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.00018773700867313892, -8.344646857949556e-07, -1.1920928244535389e-07, -0.11799981445074081, -8.284702198579907e-05, -0.0549030676484108, -0.09209287911653519, 0.0, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, -0.0008058876264840364, 0.0, -5.960462772236497e-07, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.9802276912960224e-06, -0.04859130457043648, -0.01308603398501873, -0.00018880968855228275, -7.867782187531702e-06, -0.15051904320716858, -0.0006325627909973264, -8.570780