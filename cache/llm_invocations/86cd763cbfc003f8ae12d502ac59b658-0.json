AL 999999999\n#define MAX_VAL_2 999999999999999999LL\n#define EPS 1e-6\n#define mp make_pair\n#define pb push_back\n\ntypedef unsigned int UI;\ntypedef long long int LLI;\ntypedef unsigned long long int ULLI;\ntypedef unsigned short int US;\ntypedef pair<int,int> pii;\ntypedef pair<LLI,LLI> plli;\ntypedef vector<int> vi;\ntypedef vector<LLI> vlli;\ntypedef vector<pii> vpii;\ntypedef vector<plli> vplli;\n\n// ---------- END OF TEMPLATE ----------\n#define MOD 1000000007\n\nint inv(int n) {\n    int e = MOD-2, r = 1;\n    while (e > 0) {\n        if (e & 1) r = ((LLI) r * n) % MOD;\n        e >>= 1;\n        n = ((LLI) n * n) % MOD;\n    }\n    return r;\n}\n\n// Recursive function to generate all subsets of edges and compute probability\nvoid generateStates(int row, int maxRow, int n, int state, LLI prob, int* P, int inv100, vector<int>& masks, vector<int>& probArr, int offset) {\n    if (row == maxRow) {\n        // state is a bitmask of edges for rows offset..offset+maxRow-1\n        int poss = 0;\n        for (int idx = 0; idx < (int)masks.size(); idx++) {\n            int mask = masks[idx];\n            // Check if there is a permutation of columns (selected by mask) that matches state\n            vector<int> cols;\n            for (int k = 0; k < n; k++) {\n                if (offset == 0 ? (mask & (1 << k)) : !(mask & (1 << k))) cols.push_back(k);\n            }\n            sort(cols.begin(), cols.end());\n            do {\n                int pmask = 0;\n                for (int r = 0; r < (int)cols.size(); r++) {\n                    int edge = (offset + r) * n + cols[r];\n                    pmask |= (1 << edge);\n                }\n                if ((state & pmask) == pmask) {\n                    poss |= (1 << idx);\n                    break;\n                }\n            } while (next_permutation(cols.begin(), cols.end()));\n        }\n        probArr[poss] = (probArr[poss] + prob) % MOD;\n        return;\n    }\n    for (int col = 0; col < n; col+