  if not data:\n        return\n    n = data[0]\n    P = [[0] * n for _ in range(n)]\n    idx = 1\n    for i in range(n):\n        for j in range(n):\n            P[i][j] = data[idx]\n            idx += 1\n    # flatten P\n    P_flat = [P[i][j] for i in range(n) for j in range(n)]\n\n    inv100 = pow(100, MOD - 2, MOD)\n\n    h = (n + 1) // 2\n    h2 = n - h\n\n    masks = []\n    masks2 = []\n    for m in range(1 << n):\n        cnt = m.bit_count()\n        if cnt == h:\n            masks.append(m)\n        if cnt == h2:\n            masks2.append(m)\n\n    M = len(masks)\n    prob = [0] * (1 << M)\n    prob2 = [0] * (1 << M)\n\n    # recursive function to generate states\n    def generateStates(row, maxRow, state, prob_val, probArr, offset):\n        if row == maxRow:\n            poss = 0\n            for idx, mask in enumerate(probArr is prob and masks or masks2):\n                # determine columns based on offset\n                if offset == 0:\n                    cols = [k for k in range(n) if (mask >> k) & 1]\n                else:\n                    cols = [k for k in range(n) if not ((mask >> k) & 1)]\n                cols.sort()\n                # check permutations\n                from itertools import permutations\n                for perm in permutations(cols):\n                    pmask = 0\n                    for r, col in enumerate(perm):\n                        edge = (offset + r) * n + col\n                        pmask |= (1 << edge)\n                    if (state & pmask) == pmask:\n                        poss |= (1 << idx)\n                        break\n            probArr[poss] = (probArr[poss] + prob_val) % MOD\n            return\n        for col in range(n):\n            edge = (offset + row) * n + col\n            # edge present\n            new_prob = prob_val * (P_flat[edge] * inv100 % MOD) % MOD\n            generateStates(row + 1, maxRow, state | (1 << edge), new_prob, probArr, offset)\n            # edge absent\n            new_prob = prob_val * ((100 - P_flat[edge]) * inv100 % MOD) % MOD\n            generateStates(row + 1, maxRow, state, new_prob, probArr, offset)\n\n    # first half\n    generateStates(0, h, 0, 1, prob, 0)\n    # second half\n    generateStates(0, h2, 0, 1, prob2, h)\n\n    # SOS DP on prob2\n    for i in range(M):\n        for j in range(1 << M):\n            if j & (1 << i):\n                prob2[j] = (prob2[j] + prob2[j ^ (1 << i)]) % MOD\n\n    ans = 0\n    fullMask = (1 << M) - 1\n    for i in range(1 << M):\n        ans = (ans + prob[i] * prob2[fullMask ^ i]) % MOD\n\n    result = (MOD + 1 - ans) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.823885577323381e-05, 0.0, -1.1920928244535389e-07, -0.0007563352701254189, -0.004674815572798252, -1.4305104514278355e-06, -0.5759597420692444, -0.3132723569869995, -4.768370445162873e-07, 0.0, -1.6689286894688848e-06, 0.0, -3.576278118089249e-07, 0.0, -0.0003449321957305074, -1.2278481335670222e-05, -0.7444563508033752, -0.005236718337982893, -2.0265558760002023e-06, -0.00011276562872808427, 0.0, -0.00010215714428341016, 0.0, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -4.172316494077677e-06, 0.0, -1.2993727978027891e-05, -4.768370445162873e-07, 0.0, -2.3841830625315197e-06, -2.264974000354414e-06, 0.0, -0.00015841660206206143, -1.1920928244535389e-07, 0.0, -1.3351351299206726e-05, 0.0, -0.007445444352924824, -5.006777428206988e-06, -5.960462772236497e-07, -2.3841855067985307e-07, -3.576278118089249e-07, -4.1126360883936286e-05, -2.9802276912960224e-06, -0.25917911529541016, -0.07892026007175446, -0.0006939148879610002, -3.576278118089249e-07, -0.5759730935096741, 0.0, -1.311301275563892e-06, 0.0, 0.0, -5.960462772236497e-07, 0.0, -4.768370445162873e-07, -4.768370445162873e-07, -4.768370445162873e-07, -0.00012027494085486978, 0.0, 0.0, -5.483612312673358e-06, 0.0, 0.0, 0.0, -1.1920928244535389e-07, -5.960462772236497e-07, 0.