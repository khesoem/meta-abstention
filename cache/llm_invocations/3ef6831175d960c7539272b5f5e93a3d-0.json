urrent_best = {numerator, denominator, a, b};\n        }\n    }\n}\n\nint main() {\n    long long x, y, n;\n    cin >> x >> y >> n;\n    \n    for (long long i = 1; i <= n; ++i) {\n        process(x, y, i, (i * x) / y);\n        process(x, y, i, (i * x) / y + 1);\n        process(x, y, i, (i * x) / y - 1);\n    }\n    \n    cout << current_best.a_val << \"/\" << current_best.b_val << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport math\n\nclass State:\n    def __init__(self, num, den, a_val, b_val):\n        self.num = num\n        self.den = den\n        self.a_val = a_val\n        self.b_val = b_val\n\ncurrent_best = State(100000, 1, 0, 0)\n\ndef safe_gcd(x, y):\n    x = abs(x)\n    y = abs(y)\n    if x == 0:\n        return y\n    if y == 0:\n        return x\n    while y:\n        r = x % y\n        x = y\n        y = r\n    return x\n\ndef process(x, y, b, a):\n    global current_best\n    if a < 0:\n        return\n    \n    g = safe_gcd(a, b)\n    a //= g\n    b //= g\n    \n    numerator = abs(b * x - a * y)\n    denominator = b * y\n    g = safe_gcd(numerator, denominator)\n    numerator //= g\n    denominator //= g\n    \n    if numerator * current_best.den < current_best.num * denominator:\n        current_best = State(numerator, denominator, a, b)\n    elif numerator * current_best.den == current_best.num * denominator:\n        if b < current_best.b_val or (b == current_best.b_val and a < current_best.a_val):\n            current_best = State(numerator, denominator, a, b)\n\ndef main():\n    global current_best\n    x, y, n = map(int, input().split())\n    \n    for i in range(1, n + 1):\n        process(x, y, i, (i * x) // y)\n        process(x, y, i, (i * x) // y + 1)\n        process(x, y, i, (i * x) // y - 1)\n    \n    print(f\"{current_best.a_val}/{current_best.b_val}\")\n\nif __name__ == \"__main__\":\n