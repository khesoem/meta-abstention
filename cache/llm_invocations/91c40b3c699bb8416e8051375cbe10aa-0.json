ze(); ++i) {\n            auto& e = g[u][i];\n            if (dist[e.to] == dist[u] + 1 && e.cap > 0) {\n                int pushed = dfs(e.to, min(flow, e.cap));\n                if (pushed > 0) {\n                    e.cap -= pushed;\n                    g[e.to][e.rev].cap += pushed;\n                    return pushed;\n                }\n            }\n        }\n        return 0;\n    }\n\n    int max_flow(int s, int t) {\n        src = s; sink = t;\n        int total = 0;\n        while (bfs()) {\n            fill(cur.begin(), cur.end(), 0);\n            while (int pushed = dfs(src, INF)) {\n                total += pushed;\n            }\n        }\n        return total;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false); cin.tie(nullptr);\n    int n, t;\n    cin >> n >> t;\n    vector<string> field(n), capsule(n);\n    int src_node = 2 * n * n, sink_node = src_node + 1;\n    Dinic<210> flow(2 * n * n + 2);\n    \n    int zx = -1, zy = -1;\n    for (int i = 0; i < n; ++i) {\n        cin >> field[i];\n        for (int j = 0; j < n; ++j) {\n            if (field[i][j] == 'Z') {\n                zx = i; zy = j;\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        cin >> capsule[i];\n        for (int j = 0; j < n; ++j) {\n            if (isdigit(capsule[i][j])) {\n                flow.add_edge(i * n + j + n * n, sink_node, capsule[i][j] - '0');\n            }\n        }\n    }\n    \n    vector<vector<int>> distZ(n, vector<int>(n, 1e9));\n    queue<pair<int,int>> q;\n    distZ[zx][zy] = 0;\n    q.push({zx, zy});\n    vector<int> dx = {-1, 1, 0, 0}, dy = {0, 0, -1, 1};\n    \n    while (!q.empty()) {\n        auto [x, y] = q.front(); q.pop();\n        if (distZ[x][y] == t) continue;\n        for (int d = 0; d < 4; ++d) {\n            int nx = x + dx[d], ny = y + dy[d];\n            if (nx >= 0 && nx < n && ny >= 0 && ny < n && capsule[nx][ny] != 'Y' && distZ[nx][ny] == 1e9) {\n                distZ[nx][ny] = distZ[x][y] + 1;\n                if (isdigit(capsule[nx][ny])) {\n                    flow.add_edge(zx * n + zy, nx * n + ny + n * n, 1e9);\n                }\n                q.push({nx, ny});\n            }\n        }\n    }\n    \n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            if (isdigit(field[i][j])) {\n                flow.add_edge(src_node, i * n + j, field[i][j] - '0');\n                vector<vector<int>> distS(n, vector<int>(n, 1e9));\n                queue<pair<int,int>> q2;\n                distS[i][j] = 0;\n                q2.push({i, j});\n                while (!q2.empty()) {\n                    auto [x, y] = q2.front(); q2.pop();\n                    if (distS[x][y] == t) continue;\n                    for (int d = 0; d < 4; ++d) {\n                        int nx = x + dx[d], ny = y + dy[d];\n                        if (nx >= 0 && nx < n && ny >= 0 && ny < n && capsule[nx][ny] != 'Y' && distS[nx][ny] == 1e9) {\n                            distS[nx][ny] = distS[x][y] + 1;\n                            if (isdigit(capsule[nx][ny])) {\n                                flow.add_edge(i * n + j, nx * n + ny + n * n, 1e9);\n                            }\n                            q2.push({nx, ny});\n                        }\n                    }\n                }\n            }\n        }\n    }\n    \n    cout << flow.max_flow(src_node, sink_node) << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\nimport sys\n\nclass Dinic:\n    INF = 10**9\n    \n    def __init__(self, nodes):\n        self.n = nodes\n        self.head = [-1] * nodes\n        self.cur = [0] * nodes\n        self.dist = [-1] * nodes\n        self.g = [[] for _ in range(nodes)]\n    \n    def add_edge(self, u, v, cap):\n        self.g[u].append({'to': v, 'rev': len(self.g[v]), 'cap': cap})\n        self.g[v].append({'to': u, 'rev': len(self.g[u]) - 1, 'cap': 0})\n    \n    def bfs(self, src, sink):\n        self.dist = [-1] * self.n\n        q = deque()\n        q.append(src)\n        self.dist[src] = 0\n        while q:\n            u = q.popleft()\n            for e in self.g[u]:\n                if self.dist[e['to']] == -1 and e['cap'] > 0:\n                    self.dist[e['to']] = self.dist[u] + 1\n                    q.append(e['to'])\n        return self.dist[sink] != -1\n    \n    def dfs(self, u, flow, sink):\n        if u == sink:\n            return flow\n        for i in range(self.cur[u], len(self.g[u])):\n            self.cur[u] = i\n            e = self.g[u][i]\n            if self.dist[e['to']] == self.dist[u] + 1 and e['cap'] > 0:\n                pushed = self.dfs(e['to'], min(flow, e['cap']), sink)\n                if pushed > 0:\n                    e['cap'] -= pushed\n                    self.g[e['to']][e['rev']]['cap'] += pushed\n                    return pushed\n        return 0\n    \n    def max_flow(self, s, t):\n        src = s\n        sink = t\n        total = 0\n        while self.bfs(src, sink):\n            self.cur = [0] * self.n\n            pushed = self.dfs(src, self.INF, sink)\n            while pushed > 0:\n                total += pushed\n                pushed = self.dfs(src, self.INF, sink)\n        return total\n\ndef main():\n    input = sys.stdin.read\n    data = input().splitlines()\n    if not data:\n        return\n    \n    n, t = map(int, data[0].split())\n    field = []\n    capsule = []\n    \n    for i in range(1, n + 1):\n        field.append(data[i])\n    \n    for i in range(n + 1, 2 * n + 1):\n        capsule.append(data[i])\n    \n    src_node = 2 * n * n\n    sink_node = src_node + 1\n    flow = Dinic(2 * n * n + 2)\n    \n    zx, zy = -1, -1\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                zx, zy = i, j\n    \n    for i in range(n):\n        for j in range(n):\n            if capsule[i][j].isdigit():\n                flow.add_edge(i * n + j + n * n, sink_node, int(capsule[i][j]))\n    \n    distZ = [[10**9] * n for _ in range(n)]\n    q = deque()\n    distZ[zx][zy] = 0\n    q.append((zx, zy))\n    dx = [-1, 1, 0, 0]\n    dy = [0, 0, -1, 1]\n    \n    while q:\n        x, y = q.popleft()\n        if distZ[x][y] == t:\n            continue\n        for d in range(4):\n            nx, ny = x + dx[d], y + dy[d]\n            if 0 <= nx < n and 0 <= ny < n and capsule[nx][ny] != 'Y' and distZ[nx][ny] == 10**9:\n                distZ[nx][ny] = distZ[x][y] + 1\n                if capsule[nx][ny].isdigit():\n                    flow.add_edge(zx * n + zy, nx * n + ny + n * n, 10**9)\n                q.append((nx, ny))\n    \n    for i in range(n):\n        for j in range(n):\n            if field[i][j].isdigit():\n                flow.add_edge(src_node, i * n + j, int(field[i][j]))\n                distS = [[10**9] * n for _ in range(n)]\n                q2 = deque()\n                distS[i][j] = 0\n                q2.append((i, j))\n                while q2:\n                    x, y = q2.popleft()\n                    if distS[x][y] == t:\n                        continue\n                    for d in range(4):\n                        nx, ny = x + dx[d], y + dy[d]\n                        if 0 <= nx < n and 0 <= ny < n and capsule[nx][ny] != 'Y' and distS[nx][ny] == 10**9:\n                            distS[nx][ny] = distS[x][y] + 1\n                            if capsule[nx][ny].isdigit():\n                                flow.add_edge(i * n + j, nx * n + ny + n * n, 10**9)\n                            q2.append((nx, ny))\n    \n    print(flow.max_flow(src_node, sink_node))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001445904199499637, -1.9073468138230965e-06, -1.1920928244535389e-07, -0.38347283005714417, -0.00013040646445006132, 