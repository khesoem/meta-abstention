   Matrix Y;\n    int K = N - 1;\n    for(int i=0;i<N;i++)\n        for(int j=0;j<N;j++) {\n            int ni = (i == K) ? K : (i + d) % K;\n            int nj = (j == K) ? K : (j + d) % K;\n            Y[ni][nj] = X[i][j];\n        }\n    return Y;\n}\n\nint main() {\n    long long n;\n    int k;\n    scanf(\"%lld%d\", &n, &k);\n    N = k + 1;\n    vector<int> digits;\n    while(n) {\n        digits.push_back((int)(n % k));\n        n /= k;\n    }\n    vector<Matrix> pw(100);\n    for(int j=0;j<=k;j++) {\n        pw[0][0][j] = 1;\n        pw[0][j][j] = 1;\n    }\n    for(int i=1;i<(int)digits.size();i++) {\n        Matrix cur(true);\n        for(int j=0;j<k;j++)\n            cur = cur * shift(pw[i-1], j);\n        pw[i] = cur;\n    }\n    int add = 0;\n    Matrix ans(true);\n    for(int i=(int)digits.size()-1;i>=0;i--) {\n        for(int j=0;j<digits[i];j++)\n            ans = ans * shift(pw[i], (j + add) % k);\n        add = (add + digits[i]) % k;\n    }\n    int ret = 0;\n    for(int i=0;i<=k;i++) {\n        ret += ans[i][k];\n        if(ret >= MOD) ret -= MOD;\n    }\n    printf(\"%d\\n\", ret);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass Matrix:\n    def __init__(self, n, unit=False):\n        self.n = n\n        self.a = [[0] * n for _ in range(n)]\n        if unit:\n            for i in range(n):\n                self.a[i][i] = 1\n\n    def __getitem__(self, idx):\n        return self.a[idx]\n\n    def __setitem__(self, idx, value):\n        self.a[idx] = value\n\ndef mat_mul(A, B):\n    n = A.n\n    tmp = [[0] * n for _ in range(n)]\n    for k in range(n):\n        for i in range(n):\n            aik = A[i][k]\n            if aik == 0:\n                continue\n            for j in range(n):\n                tmp[i][j] += aik * B[k][j]\n    C = Matrix(n)\n    for i in range(n):\n        for j in range(n):\n            C[i][j] = tmp[i][j] % MOD\n    return C\n\ndef shift(X, d):\n    n = X.n\n    K = n - 1\n    Y = Matrix(n)\n    for i in range(n):\n        for j in range(n):\n            ni = K if i == K else (i + d) % K\n            nj = K if j == K else (j + d) % K\n            Y[ni][nj] = X[i][j]\n    return Y\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    N = k + 1\n    digits = []\n    while n:\n        digits.append(n % k)\n        n //= k\n    pw = [None] * 100\n    pw[0] = Matrix(N)\n    for j in range(k + 1):\n        pw[0][0][j] = 1\n        pw[0][j][j] = 1\n    for i in range(1, len(digits)):\n        cur = Matrix(N, unit=True)\n        for j in range(k):\n            cur = mat_mul(cur, shift(pw[i-1], j))\n        pw[i] = cur\n    add = 0\n    ans = Matrix(N, unit=True)\n    for i in range(len(digits)-1, -1, -1):\n        for j in range(digits[i]):\n            ans = mat_mul(ans, shift(pw[i], (j + add) % k))\n        add = (add + digits[i]) % k\n    ret = 0\n    for i in range(k + 1):\n        ret += ans[i][k]\n        if ret >= MOD:\n            ret -= MOD\n    print(ret)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-8.344646857949556e-07, 0.0, 0.0, -0.00034874555421993136, -0.04915687441825867, -2.3841855067985307e-07, -0.006717953830957413, -2.264974000354414e-06, -1.1920928244535389e-07, 0.0, -3.564294092939235e-05, 0.0, -4.768370445162873e-07, -3.576278118089249e-07, -0.008756572380661964, -0.3876045346260071, -1.4305104514278355e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -0.0007153574260883033, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -0.003395745763555169, -0.00014780859055463225, -2.253030106658116e-05, -5.960462772236497e-07, -4.887569048150908e-06, 0.0, -3.576278118089249e-07, -0.00012957210128661245, 0.0, 0.0, -3.576278118089249e-07, 0.