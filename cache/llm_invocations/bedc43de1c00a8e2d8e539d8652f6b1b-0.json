r1 = curr2 = 0\n    # print(l1, l2)\n    while l1 or l2:\n        try:\n            if 0 == curr1:curr1 = l1.pop()\n            if 0 == curr2:curr2 = l2.pop()\n        except:return ans\n\n        ans += max(0, min(curr1[0], curr2[0]) * match(curr1[1], curr2[1]))\n        # print(curr1, curr2)\n        if curr1[0] < curr2[0]:\n            curr2[0] -= curr1[0]\n            curr1 = 0\n        elif curr1[0] > curr2[0]:\n            curr1[0] -= curr2[0]\n            curr2 = 0\n        else:curr1 = curr2 = 0\n    # print(\"ANS FOR THIS : \", ans)\n    return ans    \n\n\n\n\n\n\n\n\ndef minimum():\n    ans = n\n    l = [[rock1, 1], [sci1, 2], [paper1, 3]]\n    l1 = [list(i) for i in list(permutations(l))]\n    l = [[rock2, 1], [sci2, 2], [paper2, 3]]\n    l2 = [list(i) for i in list(permutations(l))]\n\n\n    ans = float('inf')\n    for i in l1:\n        for j in l2:\n            mylist1 = [temp[:] for temp in i]\n            mylist2 = [temp[:] for temp in j]\n            ans = min(ans, give(mylist1, mylist2))\n\n    \n    return ans\n\n\n\nprint(minimum(), maximum())\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <bits/stdc++.h>\nusing namespace std;\nusing ll = long long;\nconst ll MOD = 998244353;\n\nll mod = 998244353;\n\nll inv_mod(ll n) {\n    ll res = 1, e = mod - 2;\n    while (e) {\n        if (e & 1) res = (res * n) % mod;\n        n = (n * n) % mod;\n        e >>= 1;\n    }\n    return res;\n}\n\nvector<ll> factors(ll n) {\n    vector<ll> v;\n    for (ll i = 1; i * i <= n; ++i) {\n        if (n % i == 0) {\n            v.push_back(i);\n            if (i * i != n) v.push_back(n / i);\n        }\n    }\n    sort(v.begin(), v.end());\n    return v;\n}\n\nll match(ll a, ll b) {\n    if (a == b) return 0;\n    if ((a == 1 && b == 2) || (a == 2 && b == 3) || (a == 3 && b == 1)) return 1;\n    return -1;\n}\n\nll give(vector<pair<ll,ll>>& l1, vector<pair<ll,ll>>& l2) {\n    ll ans = 0;\n    pair<ll,ll> curr1 = {0,0}, curr2 = {0,0};\n    while (!l1.empty() || !l2.empty()) {\n        if (curr1.first == 0 && !l1.empty()) { curr1 = l1.back(); l1.pop_back(); }\n        if (curr2.first == 0 && !l2.empty()) { curr2 = l2.back(); l2.pop_back(); }\n        if (curr1.first == 0 || curr2.first == 0) break;\n        \n        ll m = match(curr1.second, curr2.second);\n        ll take = min(curr1.first, curr2.first);\n        ans += max(0LL, take * m);\n        \n        if (curr1.first < curr2.first) {\n            curr2.first -= curr1.first;\n            curr1.first = 0;\n        } else if (curr1.first > curr2.first) {\n            curr1.first -= curr2.first;\n            curr2.first = 0;\n        } else {\n            curr1.first = curr2.first = 0;\n        }\n    }\n    return ans;\n}\n\nll maximum(ll r1, ll s1, ll p1, ll r2, ll s2, ll p2) {\n    return min(r1, s2) + min(s1, p2) + min(p1, r2);\n}\n\nll minimum(ll n, ll r1, ll s1, ll p1, ll r2, ll s2, ll p2) {\n    vector<pair<ll,ll>> base1 = {{r1,1}, {s1,2}, {p1,3}};\n    vector<pair<ll,ll>> base2 = {{r2,1}, {s2,2}, {p2,3}};\n    \n    sort(base1.begin(), base1.end());\n    sort(base2.begin(), base2.end());\n    \n    ll ans = 1e18;\n    do {\n        do {\n            vector<pair<ll,ll>> l1 = base1;\n            vector<pair<ll,ll>> l2 = base2;\n            ans = min(ans, give(l1, l2));\n        } while (next_permutation(base2.begin(), base2.end()));\n    } while (next_permutation(base1.begin(), base1.end()));\n    \n    return ans;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n    \n    ll n; cin >> n;\n    ll r1, s1, p1; cin >> r1 >> s1 >> p1;\n    ll r2, s2, p2; cin >> r2 >> s2 >> p2;\n    \n    cout << minimum(n, r1, s1, p1, r2, s2, p2) << \" \" << maximum(r1, s1, p1, r2, s2, p2) << \"\\n\";\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.81469e-06, 0.0, -2.3841855e-07,