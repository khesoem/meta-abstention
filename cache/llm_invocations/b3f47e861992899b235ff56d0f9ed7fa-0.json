w(int demand) {\n        long overall = 0;\n        while (demand > 0) {\n            Arrays.fill(potential, INFINITY);\n            potential[start_node] = 0;\n            Queue<Integer> pending = new LinkedList<>();\n            pending.add(start_node);\n            Arrays.fill(queued, false);\n            queued[start_node] = true;\n\n            while (!pending.isEmpty()) {\n                int u = pending.poll();\n                queued[u] = false;\n                for (int idx = 0; idx < network[u].size(); ++idx) {\n                    Stream link = network[u].get(idx);\n                    if (link.limit > 0 && potential[u] + link.fee < potential[link.end]) {\n                        potential[link.end] = potential[u] + link.fee;\n                        ancestor_node[link.end] = u;\n                        ancestor_edge[link.end] = idx;\n                        if (!queued[link.end]) {\n                            queued[link.end] = true;\n                            pending.add(link.end);\n                        }\n                    }\n                }\n            }\n\n            if (potential[end_node] == INFINITY) return -1;\n\n            int throughput = demand;\n            for (int cur = end_node; cur != start_node; cur = ancestor_node[cur]) {\n                throughput = Math.min(throughput, network[ancestor_node[cur]].get(ancestor_edge[cur]).limit);\n            }\n            demand -= throughput;\n            overall += (long) throughput * potential[end_node];\n\n            for (int cur = end_node; cur != start_node; cur = ancestor_node[cur]) {\n                Stream e = network[ancestor_node[cur]].get(ancestor_edge[cur]);\n                e.limit -= throughput;\n                network[cur].get(e.reverse).limit += throughput;\n            }\n        }\n        return overall;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int N = scanner.nextInt();\n        int M = scann