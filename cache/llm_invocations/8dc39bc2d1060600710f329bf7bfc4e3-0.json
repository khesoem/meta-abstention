elf.nodes = n\n        self.graph = [[] for _ in range(n)]\n        self.level = [-1] * n\n        self.iter = [0] * n\n\n    def addEdge(self, u, v, cap):\n        self.graph[u].append(Edge(v, cap, len(self.graph[v])))\n        self.graph[v].append(Edge(u, 0, len(self.graph[u]) - 1))\n\n    def bfs(self, s, t):\n        self.level = [-1] * len(self.level)\n        q = deque()\n        q.append(s)\n        self.level[s] = 0\n        while q:\n            u = q.popleft()\n            for e in self.graph[u]:\n                if self.level[e.to] == -1 and e.capacity > 0:\n                    self.level[e.to] = self.level[u] + 1\n                    q.append(e.to)\n        return self.level[t] != -1\n\n    def dfs(self, u, t, flow):\n        if u == t:\n            return flow\n        for i in range(self.iter[u], len(self.graph[u])):\n            self.iter[u] = i\n            e = self.graph[u][i]\n            if self.level[e.to] == self.level[u] + 1 and e.capacity > 0:\n                pushed = self.dfs(e.to, t, min(flow, e.capacity))\n                if pushed > 0:\n                    e.capacity -= pushed\n                    self.graph[e.to][e.rev_idx].capacity += pushed\n                    return pushed\n        return 0\n\n    def computeMaxFlow(self, s, t):\n        total = 0\n        while self.bfs(s, t):\n            self.iter = [0] * len(self.iter)\n            pushed = self.dfs(s, t, INF)\n            while pushed > 0:\n                total += pushed\n                pushed = self.dfs(s, t, INF)\n        return total\n\ndef main():\n    input = sys.stdin.read\n    data = input().split()\n    idx = 0\n    n = int(data[idx]); idx += 1\n    t = int(data[idx]); idx += 1\n    \n    field = []\n    for i in range(n):\n        field.append(data[idx]); idx += 1\n    \n    capsule = []\n    for i in range(n):\n        capsule.append(data[idx]); idx += 1\n    \n    src = 2 * n * n\n    dst = src + 1\n    mf = MaxFlowSolver(2 * n * n + 2)\n    \n    zx, zy = -1, -1\n 