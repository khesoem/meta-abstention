>\n#include <cstdint>\n\nusing namespace std;\n\nvector<int> sums_from(const vector<int>& a, int start, int cnt, int m) {\n    int upto = min(cnt, 20);\n    vector<int> res;\n    int limit = 1 << upto;\n    for (int mask = 0; mask < limit; ++mask) {\n        long long total = 0;\n        for (int i = 0; i < upto; ++i) {\n            if (mask & (1 << i)) {\n                total += a[start + i];\n            }\n        }\n        res.push_back(total % m);\n    }\n    return res;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<int> a(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> a[i];\n    }\n\n    int half = (n + 1) / 2;          // ceil(n/2)\n    int second_half = n / 2;         // floor(n/2)\n\n    vector<int> b = sums_from(a, 0, half, m);\n    sort(b.begin(), b.end());\n\n    int otv = 0;\n    vector<int> second_sums = sums_from(a, half, second_half, m);\n    for (int second : second_sums) {\n        int target = m - second - 1;\n        auto it = lower_bound(b.begin(), b.end(), target);\n        int t2;\n        if (it != b.end()) {\n            if (*it > target && it != b.begin()) {\n                t2 = *(it - 1);\n            } else {\n                t2 = *it;\n            }\n        } else {\n            t2 = b.back();\n        }\n        otv = max(otv, (second + t2) % m);\n        otv = max(otv, (second + b.back()) % m);\n    }\n\n    cout << otv % m << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-1.1920928244535389e-07, -1.1920928244535389e-07, 0.0, -7.83174327807501e-05, -2.3841574147809297e-05, -3.576278118089249e-07, -0.0019296851241961122, -7.867782187531702e-06, 0.0, 0.0, -8.344646857949556e-07, -9.536738616588991e-07, 0.0, 0.0, 0.0, -0.04859402775764465, -0.06196951866149902, 0.0, -0.47505682706832886, -0.0015792291378602386, -1.7881377516459906e-06, -0.12730754911899567, -0.0024717275518924, -1.4305104514278355e-06, 0.0, -2.932505594799295e-05, -0.00792726594954729, -