n range(ptr[u], len(graph[u])):\n        v, cap, rev = graph[u][i]\n        if cap > 0 and dist[v] == dist[u] + 1:\n            pushed = dfs(v, min(cap, flow), dist, ptr)\n            if pushed > 0:\n                graph[u][i][1] -= pushed\n                graph[v][rev][1] += pushed\n                return pushed\n        ptr[u] += 1\n    return 0\n\ndef maxflow():\n    total = 0\n    while True:\n        dist = bfs()\n        if dist[ed] == -1:\n            break\n        ptr = [0]*(2*tot+2)\n        while True:\n            flow = dfs(st, INF, dist, ptr)\n            if flow == 0:\n                break\n            total += flow\n    return total\n\ndef check(x, y):\n    if x < 0 or y < 0 or x >= n or y >= n:\n        return False\n    if c[x][y] == '#' or c[x][y] == 'Z':\n        return False\n    if not ('0' <= c[x][y] <= '9'):\n        return False\n    return True\n\ndef bfs_dis(sx, sy):\n    dis = [[60]*n for _ in range(n)]\n    vis = [[0]*n for _ in range(n)]\n    dis[sx][sy] = 0\n    vis[sx][sy] = 1\n    q = deque()\n    q.append((sx, sy))\n    while q:\n        ax, ay = q.popleft()\n        for dx, dy in directions:\n            nx, ny = ax+dx, ay+dy\n            if 0 <= nx < n and 0 <= ny < n and not vis[nx][ny] and check(nx, ny):\n                dis[nx][ny] = dis[ax][ay] + 1\n                vis[nx][ny] = 1\n                q.append((nx, ny))\n    return dis\n\ndef find_dis(tx, ty, idx, dis_map, dis_all):\n    v_dis = [[60]*n for _ in range(n)]\n    vis = [[0]*n for _ in range(n)]\n    v_dis[tx][ty] = 0\n    vis[tx][ty] = 1\n    q = deque()\n    q.append((tx, ty))\n    while q:\n        ax, ay = q.popleft()\n        for dx, dy in directions:\n            nx, ny = ax+dx, ay+dy\n            if 0 <= nx < n and 0 <= ny < n and not vis[nx][ny] and check(nx, ny):\n                v_dis[nx][ny] = v_dis[ax][ay] + 1\n                vis[nx][ny] = 1\n                if v_dis[nx][ny] < dis_map[nx][ny]:\n                    q.append((nx, ny))\n    for i in range(n):\n        for j in range(n):\n            if Dis_map[i][j] <= t and S[i][j] > '0' and S[i][j] <= '9' and Dis_map[i][j] <= dis_all[i][j]:\n                add_edge(idx, id_matrix[i][j]+tot, INF)\n\n# Precompute dis for initial BFS\ndis = bfs_dis(sx, sy)\nDis_map = [row[:] for row in dis]\n\n# Build the flow network\nfor i in range(n):\n    for j in range(n):\n        if '0' < c[i][j] <= '9':\n            capacity = int(c[i][j])\n            add_edge(st, id_matrix[i][j], capacity)\n            # For each such cell, find Distances and Update Edges\n            dis_map = bfs_dis(i,j)\n            find_dis(i, j, id_matrix[i][j], dis_map, dis)\n\nfor i in range(n):\n    for j in range(n):\n        if '0' < S[i][j] <= '9':\n            capacity = int(S[i][j])\n            add_edge(id_matrix[i][j] + tot, ed, capacity)\n\nresult = maxflow()\nprint(result)\n\n</translated_code>\n<confidence>\n0.75\n</confidence>", "token_logprobs": [-0.00021188464597798884, -0.00011033779446734115, -6.704273118884885e-07, -2.963691804325208e-05, -0.04293227195739746, -0.105680450797081, -0.20167119801044464, -7.896309739408025e-07, -0.016699066385626793, -1.1472419600977446e-06, -0.0007429223624058068, 0.0, 0.0, -0.8273978233337402, -0.0011461719404906034, -1.2352385965641588e-05, -0.0005537479883059859, -0.03805951029062271, -2.45848218582978e-06, -0.08894122391939163, -0.0005614925175905228, -9.088346359931165e-07, -1.1472419600977446e-06, 0.0, -5.438573680294212e-06, 0.0, -1.9361264946837764e-07, -4.596781946020201e-05, -2.165027217415627e-05, -7.703443770878948e-06, 0.0, -1.318681188422488e-05, 0.0, 0.0, -4.320199877838604e-07, -4.320199877838604e-07, -3.4121114822482923e-06, 0.0, -3.128163257315464e-07, 0.0, -8.180258191714529e-06, -0.0016992258606478572, -1.4785938262939453, -1.6198697090148926, -3.2449655532836914, -0.08750646561384201, -2.15310683415737e-05, -2.570319702499546e-05, -2.5776860184123507e-06, -2.696889623621246e-06, -1.8670179997570813e-05, 0.0, -2.236549335066229e-05