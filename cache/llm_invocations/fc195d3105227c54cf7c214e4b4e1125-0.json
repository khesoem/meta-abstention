(i);\n                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + pot[v] - pot[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + pot[v] - pot[e.to];\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            pq.add(new Pair(dist[e.to], e.to));\n                        }\n                    }\n                }\n                if (dist[t] >= INF) break;\n                for (int v = 0; v < n; v++) pot[v] += dist[v];\n                long add = maxf - flow;\n                for (int v = t; v != s; v = prevv[v]) {\n                    add = Math.min(add, g.get(prevv[v]).get(preve[v]).cap);\n                }\n                flow += add;\n                res += add * pot[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = g.get(prevv[v]).get(preve[v]);\n                    e.cap -= add;\n                    g.get(v).get(e.rev).cap += add;\n                }\n            }\n            return res;\n        }\n\n        static class Pair implements Comparable<Pair> {\n            long dist;\n            int vertex;\n            Pair(long d, int v) {\n                dist = d;\n                vertex = v;\n            }\n            public int compareTo(Pair other) {\n                if (this.dist < other.dist) return -1;\n                if (this.dist > other.dist) return 1;\n                return 0;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int source = 0;\n        int sink = n * T + 1;\n        MinCostFlow mcf = new MinCostFlow(n * T + 2);\n\n        for (int i = 0; i < k; i++) {\n            int a = sc.nextInt();\n            mcf.addEdge(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; t++) {\n            mcf.addEdge(1 + t * n, sink, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; i++) {\n                    mcf.addEdge(i + (t - 1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; j++) {\n                long cost = (long)(j + 1) * (j + 1) - (long)j * j;\n                for (int t = 1; t < T; t++) {\n                    mcf.addEdge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                    mcf.addEdge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n\n        long price = mcf.minCostFlow(source, sink, k);\n        System.out.println(price);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.021495232358574867, -0.4770147204399109, -0.00018892886873800308, -1.1920922133867862e-06, 0.0, -2.8371408916427754e-05, -7.867782187531702e-06, -3.576278118089249e-07, -0.12692804634571075, -0.02137400023639202, -0.001536499592475593, 0.0, -0.038890618830919266, -0.029789874330163002, -0.0011739989276975393, -0.0026956195943057537, -0.47503507137298584, -0.011057410389184952, -2.861018856492592e-06, -0.00034374051028862596, -1.4543427823809907e-05, 0.0, 0.0, -1.9550132492440753e-05, -1.1920928244535389e-07, -4.911301948595792e-05, -0.31544584035873413, -0.0002613918040879071, -3.576272320060525e-06, -0.0005608416395261884, -4.887569048150908e-06, -0.0014110381016507745, -1.3232143828645349e-05, 0.0, -7.510157047363464e-06, -0.00012909532233607024, 0.0, -1.1920928244535389e-07, -1.1920922133867862e-06, 0.0, -3.576278118089249e-07, -1.1920922133867862e-06, -1.1920928244535389e-07, -3.576278118089249e-07, -0.006725058425217867, 0.0, -4.875540980719961e-05, -3.576278118089249e-07, -5.245195097813848e-06, -5.960462772236497e-07, -2.3841855067985307e-07,