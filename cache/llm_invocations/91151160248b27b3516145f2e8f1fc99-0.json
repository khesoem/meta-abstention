 + x * x) % MOD;\n        }\n        pw.println(ans);\n        \n        pw.close();\n        br.close();\n    }\n    \n    private static long[] polyMult(long[] p1, long[] p2, long mod) {\n        int n = p1.length + p2.length - 1;\n        long[] res = new long[n];\n        for (int i = 0; i < p1.length; i++) {\n            for (int j = 0; j < p2.length; j++) {\n                res[i + j] = (res[i + j] + p1[i] * p2[j]) % mod;\n            }\n        }\n        return res;\n    }\n}\n</your_rewritten_code_2>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <algorithm>\nusing namespace std;\n\nvector<long long> polyMult(const vector<long long>& p1, const vector<long long>& p2, long long mod) {\n    int n = p1.size() + p2.size() - 1;\n    vector<long long> res(n, 0);\n    for (int i = 0; i < p1.size(); i++) {\n        for (int j = 0; j < p2.size(); j++) {\n            res[i + j] = (res[i + j] + p1[i] * p2[j]) % mod;\n        }\n    }\n    return res;\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    int N, k;\n    ss >> N >> k;\n    \n    vector<long long> digitCounts(11, 0);\n    for (int i = 0; i < k; i++) {\n        getline(cin, line);\n        int digit = stoi(line);\n        digitCounts[10 - digit] = 1;\n    }\n    \n    int half = N / 2;\n    vector<long long> current = {1};\n    long long MOD = 998244353LL;\n    \n    while (half > 0) {\n        if (half % 2 == 1) {\n            current = polyMult(current, digitCounts, MOD);\n        }\n        digitCounts = polyMult(digitCounts, digitCounts, MOD);\n        half /= 2;\n    }\n    \n    long long ans = 0;\n    for (long long x : current) {\n        ans = (ans + x * x) % MOD;\n    }\n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.9