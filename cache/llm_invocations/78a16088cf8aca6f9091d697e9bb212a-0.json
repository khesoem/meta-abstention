e(y * T + j, x * T + j + 1, 1, cur * d + c);\n                cur += 2;\n            }\n        }\n    }\n\n    auto p = mcf.get_flow(N, N + 1);\n    assert(p.first == k);\n    cout << p.second << endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport heapq\nimport sys\n\nINF = 10**9\n\nclass Edge:\n    __slots__ = ('to', 'rev', 'f', 'cap', 'cost')\n    def __init__(self, to, rev, f, cap, cost):\n        self.to = to\n        self.rev = rev\n        self.f = f\n        self.cap = cap\n        self.cost = cost\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.prio = [INF] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n        self.g = [[] for _ in range(n)]\n        self.q = []\n    \n    def add_edge(self, s, t, cap, cost):\n        self.g[s].append(Edge(t, len(self.g[t]), 0, cap, cost))\n        self.g[t].append(Edge(s, len(self.g[s]) - 1, 0, 0, -cost))\n    \n    def get_flow(self, s, t):\n        flow = 0\n        flowcost = 0\n        \n        while True:\n            heapq.heappush(self.q, (0, s))\n            self.prio = [INF] * self.n\n            self.prio[s] = 0\n            self.curflow = [0] * self.n\n            self.curflow[s] = INF\n            \n            while self.q:\n                d, u = heapq.heappop(self.q)\n                if d != self.prio[u]:\n                    continue\n                \n                for i in range(len(self.g[u])):\n                    e = self.g[u][i]\n                    v = e.to\n                    \n                    if e.cap <= e.f:\n                        continue\n                    \n                    nprio = self.prio[u] + e.cost + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nprio:\n                        self.prio[v] = nprio\n                        heapq.heappush(self.q, (nprio, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e.cap - e.f)\n            \n            if self.prio[t] == INF:\n                break\n            \n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            \n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            \n            v = t\n            while v != s:\n                e = self.g[self.prevnode[v]][self.prevedge[v]]\n                e.f += df\n                self.g[v][e.rev].f -= df\n                flowcost += df * e.cost\n                v = self.prevnode[v]\n        \n        return (flow, flowcost)\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    \n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    T = 150\n    N = n * T\n    mcf = MCF(N + 2)\n    \n    for i in range(n):\n        for j in range(T - 1):\n            mcf.add_edge(i * T + j, i * T + j + 1, INF, c)\n    \n    for i in range(T):\n        mcf.add_edge(i, N + 1, INF, 0)\n    \n    for _ in range(k):\n        x = int(next(it)) - 1\n        mcf.add_edge(N, x * T, 1, 0)\n    \n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        \n        for j in range(T - 1):\n            cur = 1\n            for _ in range(k):\n                mcf.add_edge(x * T + j, y * T + j + 1, 1, cur * d + c)\n                mcf.add_edge(y * T + j, x * T + j + 1, 1, cur * d + c)\n                cur += 2\n    \n    p = mcf.get_flow(N, N + 1)\n    assert p[0] == k\n    print(p[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002233732520835474, -1.1920922133867862e-06, -1.1920928244535389e-07, 