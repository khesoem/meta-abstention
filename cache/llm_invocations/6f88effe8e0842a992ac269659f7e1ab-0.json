{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following PyPy 3 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original PyPy 3 code you have to translate:\n<original_code>\nimport sys\nsys.stderr = sys.stdout\nfrom itertools import accumulate\n\ndef factorials(n, mod):\n    c = [0] * (n + 1)\n    c[n] = 1\n    for k in range(n - 1, -1, -1):\n        c[k] = (c[k + 1] * (k + 1)) % mod\n        if c[k] == 0:\n            break\n    return c\n\ndef build_tables(n, mod):\n    tables = [[[1]]]\n    for i in range(1, n):\n        prev = tables[-1]\n        p = len(prev)\n        pref = [[0] * i for _ in range(p + 1)]\n        for r in range(p):\n            row = prev[r]\n            for col in range(i):\n                pref[r + 1][col] = (pref[r][col] + row[col]) % mod\n        nrows = p + i\n        nxt = [[0] * (i + 1) for _ in range(nrows)]\n        for r in range(nrows):\n            lo = max(0, r - i + 1)\n            hi = min(r, p - 1)\n            if lo <= hi:\n                for col in range(i):\n                    nxt[r][col] = (pref[hi + 1][col] - pref[lo][col]) % mod\n            if 0 <= r - i < p:\n                nxt[r][i] = sum(prev[r - i]) % mod\n        tables.append(nxt)\n    return tables\n\ndef score(table, mod, coeff):\n    R = len(table)\n    D = len(table[0])\n    ss = []\n    for row in table:\n        ss.append(list(reversed(list(accumulate(reversed(row))))))\n    for col in range(D):\n        run = 0\n        for r in range(R):\n            run += ss[r][col]\n            ss[r][col] = run\n    ss = [[x % mod for x in row] for row in ss]\n    part = 0\n    for r in range(1, R):\n        for col in range(D - 1):\n            part = (part + table[r][col] * ss[r - 1][col + 1]) % mod\n    return (part * coeff) % mod\n\ndef solve(n, mod):\n    c = factorials(n, mod)\n    tables = build_tables(n, mod)\n    ans = 0\n    for i in range(1, n):\n        ans = (ans + score(tables[i], mod, c[i + 1])) % mod\n    return ans\n\ndef main():\n    n, m = map(int, input().split())\n    print(solve(n, m))\n\nif __name__ == \"__main__\":\n    main()\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstdint>\nusing namespace std;\ntypedef long long ll;\n\nvector<ll> factorials(int n, ll mod) {\n    vector<ll> c(n + 1);\n    c[n] = 1;\n    for (int k = n - 1; k >= 0; --k) {\n        c[k] = (c[k + 1] * (k + 1)) % mod;\n        if (c[k] == 0) break;\n    }\n    return c;\n}\n\nvector<vector<vector<ll>>> build_tables(int n, ll mod) {\n    vector<vector<vector<ll>>> tables;\n    tables.push_back({{1}}); // i = 0\n    for (int i = 1; i < n; ++i) {\n        const auto& prev = tables.back();\n        int p = prev.size();\n        // pref: (p+1) x i\n        vector<vector<ll>> pref(p + 1, vector<ll>(i, 0));\n        for (int r = 0; r < p; ++r) {\n            const auto& row = prev[r];\n            for (int col = 0; col < i; ++col) {\n                pref[r + 1][col] = (pref[r][col] + row[col]) % mod;\n            }\n        }\n        int nrows = p + i;\n        vector<vector<ll>> nxt(nrows, vector<ll>(i + 1, 0));\n        for (int r = 0; r < nrows; ++r) {\n            int lo = max(0, r - i + 1);\n            int hi = min(r, p - 1);\n            if (lo <= hi) {\n                for (int col = 0; col < i; ++col) {\n                    ll val = (pref[hi + 1][col] - pref[lo][col]) % mod;\n                    if (val < 0) val += mod;\n                    nxt[r][col] = val;\n                }\n            }\n            if (r - i >= 0 && r - i < p) {\n                ll sum = 0;\n                for (ll x : prev[r - i]) sum = (sum + x) % mod;\n                nxt[r][i] = sum;\n            }\n        }\n        tables.push_back(nxt);\n    }\n    return tables;\n}\n\nll score(const vector<vector<ll>>& table, ll mod, ll coeff) {\n    int R = table.size();\n    int D = table[0].size();\n    // compute suffix sums for each row\n    vector<vector<ll>> ss(R, vector<ll>(D));\n    for (int r = 0; r < R; ++r) {\n        ll run = 0;\n        for (int col = D - 1; col >= 0; --col) {\n            run = (run + table[r][col]) % mod;\n            ss[r][col] = run;\n        }\n    }\n    // prefix sums over rows for each column\n    for (int col = 0; col < D; ++col) {\n        ll run = 0;\n        for (int r = 0; r < R; ++r) {\n            run = (run + ss[r][col]) % mod;\n            ss[r][col] = run;\n        }\n    }\n    ll part = 0;\n    for (int r = 1; r < R; ++r) {\n        for (int col = 0; col < D - 1; ++col) {\n            part = (part + table[r][col] * ss[r - 1][col + 1]) % mod;\n        }\n    }\n    return (part * coeff) % mod;\n}\n\nll solve(int n, ll mod) {\n    vector<ll> c = factorials(n, mod);\n    vector<vector<vector<ll>>> tables = build_tables(n, mod);\n    ll ans = 0;\n    for (int i = 1; i < n; ++i) {\n        ans = (ans + score(tables[i], mod, c[i + 1])) % mod;\n    }\n    return ans;\n}\n\nint main() {\n    int n; ll m;\n    cin >> n >> m;\n    cout << solve(n, m) << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.172316494077677e-06, 0.0, -2.3841855