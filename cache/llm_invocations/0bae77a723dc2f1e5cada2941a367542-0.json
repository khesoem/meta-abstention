tB[good] -= win;\n        }\n        return wins[0] + wins[1] + wins[2];\n    }\n\n    private static int getLostMaxFast(int[] inputA, int[] inputB) {\n        int[][] waysToLose = {\n            {0, 2},\n            {1, 0},\n            {2, 1},\n            {0, 0},\n            {1, 1},\n            {2, 2}\n        };\n\n        List<int[][]> permutations = new ArrayList<>();\n        permute(waysToLose, 0, permutations);\n\n        int maxLost = 0;\n        for (int[][] permutation : permutations) {\n            int[] losts = new int[3];\n            int[] inputACopy = Arrays.copyOf(inputA, inputA.length);\n            int[] inputBCopy = Arrays.copyOf(inputB, inputB.length);\n\n            for (int[] wayToLose : permutation) {\n                int aIdx = wayToLose[0];\n                int bIdx = wayToLose[1];\n                int lostAdd = Math.min(inputACopy[aIdx], inputBCopy[bIdx]);\n                inputACopy[aIdx] -= lostAdd;\n                inputBCopy[bIdx] -= lostAdd;\n                losts[aIdx] += lostAdd;\n            }\n\n            int lostSum = losts[0] + losts[1] + losts[2];\n            if (lostSum > maxLost) {\n                maxLost = lostSum;\n            }\n        }\n        return maxLost;\n    }\n\n    private static void permute(int[][] arr, int start, List<int[][]> result) {\n        if (start == arr.length) {\n            int[][] copy = new int[arr.length][2];\n            for (int i = 0; i < arr.length; i++) {\n                copy[i][0] = arr[i][0];\n                copy[i][1] = arr[i][1];\n            }\n            result.add(copy);\n            return;\n        }\n        for (int i = start; i < arr.length; i++) {\n            swap(arr, start, i);\n            permute(arr, start + 1, result);\n            swap(arr, start, i);\n        }\n    }\n\n    private static void swap(int[][] arr, int i, int j) {\n        int[] temp = arr[i];\n        arr[i] = arr[j];\n        arr[j] = temp;\n    }\n}\n</translated_code>\n<confidence>\n0.99\n<