{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Java code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Java 11 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Java 11 code you have to translate:\n<original_code>\nimport java.io.BufferedReader;\nimport java.io.IOException;\nimport java.io.InputStreamReader;\nimport java.math.BigInteger;\nimport java.util.StringTokenizer;\n\npublic class CF1342E_3 {\n    static final long MOD = 998244353L;\n    static final BigInteger BIG_MOD = BigInteger.valueOf(MOD);\n    static final BigInteger EXP = BigInteger.valueOf(MOD - 2);\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringBuilder all = new StringBuilder();\n        String line;\n        while ((line = br.readLine()) != null) {\n            all.append(line).append(' ');\n        }\n        StringTokenizer st = new StringTokenizer(all.toString());\n\n        int n = Integer.parseInt(st.nextToken());\n        long k = Long.parseLong(st.nextToken());\n\n        if (k >= n) {\n            System.out.println(0);\n            return;\n        }\n\n        int c = n - (int) k;\n        int size = n + n;\n        long[] fact = new long[size];\n        long[] invFact = new long[size];\n\n        for (int i = 0; i < size; i++) {\n            fact[i] = (i == 0) ? 1 : fact[i - 1] * i % MOD;\n            invFact[i] = modInverse(fact[i]);\n        }\n\n        long ans = 0;\n        for (int a = 1; a <= c; a++) {\n            long pow = BigInteger.valueOf(a).modPow(BigInteger.valueOf(n), BIG_MOD).longValue();\n            long term = pow * choose(fact, invFact, c, a) % MOD;\n            if (((c - a) & 1) == 0) {\n                ans += term;\n            } else {\n                ans -= term;\n            }\n        }\n\n        ans %= MOD;\n        if (ans < 0) ans += MOD;\n        ans = ans * choose(fact, invFact, n, c) % MOD;\n        if (k > 0) ans = ans * 2 % MOD;\n        System.out.println(ans);\n    }\n\n    static long modInverse(long x) {\n        return BigInteger.valueOf(x).modPow(EXP, BIG_MOD).longValue();\n    }\n\n    static long choose(long[] fact, long[] invFact, int n, int k) {\n        return fact[n] * invFact[k] % MOD * invFact[n - k] % MOD;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <algorithm>\n#include <cstdint>\n\nusing namespace std;\n\nconst long long MOD = 998244353LL;\n\nlong long pow_mod(long long a, long long b, long long mod) {\n    long long res = 1;\n    a %= mod;\n    while (b) {\n        if (b & 1) res = res * a % mod;\n        a = a * a % mod;\n        b >>= 1;\n    }\n    return res;\n}\n\nlong long modInverse(long long x) {\n    return pow_mod(x, MOD - 2, MOD);\n}\n\nlong long choose(const vector<long long>& fact, const vector<long long>& invFact, int n, int k) {\n    return fact[n] * invFact[k] % MOD * invFact[n - k] % MOD;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string all;\n    string line;\n    while (getline(cin, line)) {\n        all += line + \" \";\n    }\n    stringstream ss(all);\n    int n;\n    long long k;\n    ss >> n >> k;\n\n    if (k >= n) {\n        cout << 0 << endl;\n        return 0;\n    }\n\n    int c = n - (int)k;\n    int size = n + n;\n    vector<long long> fact(size);\n    vector<long long> invFact(size);\n\n    for (int i = 0; i < size; i++) {\n        fact[i] = (i == 0) ? 1 : fact[i - 1] * i % MOD;\n        invFact[i] = modInverse(fact[i]);\n    }\n\n    long long ans = 0;\n    for (int a = 1; a <= c; a++) {\n        long long pow_val = pow_mod(a, n, MOD);\n        long long term = pow_val * choose(fact, invFact, c, a) % MOD;\n        if (((c - a) & 1) == 0) {\n            ans += term;\n        } else {\n            ans -= term;\n        }\n    }\n\n    ans %= MOD;\n    if (ans < 0) ans += MOD;\n    ans = ans * choose(fact, invFact, n, c) % MOD;\n    if (k > 0) ans = ans * 2 % MOD;\n    cout << ans << endl;\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.4570634852570947e-06, 0.0, -1.1920928244535389e-07, -0.00022516099852509797, -6.0794889577664435e-05, -7.152555099310121e-07, -0.2519407272338867, -1.0132738680113107e-05, 0.0, 0.0, -0.07076089829206467, -5.960462772236497e-07, 0.0, 0.0, -4.827859811484814e-05, -1.4305104514278355e-06, 0.0, 0.0, -1.9073468138230965e-06, -4.768370445162873e-07, -0.16024024784564972, -0.018164008855819702, 0.0, -0.4742457866668701, -0.575993537902832, -0.10026352107524872, 0.0, -0.0002225389762315899, -0.0015836328966543078, -8.344646857949556e-07, -0.0297741387039423, -0.0016030330443754792, -1.9073468138230965e-06, 0.0, -0.038048986345529556, -0.003193043638020754, -1.4066597032069694e-05, -2.3841855067985307e-07, 0.0, 0.0, -2.3841855067985307e-07, 0.0, 0.0, 0.0, -0.004357961006462574, -0.0007136897183954716, -0.000554288737475872, 0.0, -0.048633772879838943, -9.894321920000948e-06, 0.0, 0.0, -0.0007160721579566598, 0.0, -1.1920928244535389e-07, 0.0, -9.929640509653836e-05, -0.00015841660206206143, -1.1920928244535389e-07,