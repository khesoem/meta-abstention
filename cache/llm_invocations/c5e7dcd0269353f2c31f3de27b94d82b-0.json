n            idx = self.g[x][self.cur[x]]\n            e = self.edg[idx]\n            if self.dist[x] + 1 == self.dist[e.to]:\n                minn = min(cp, e.capacity - e.flow)\n                newflow = self.dfs(e.to, minn)\n                if newflow > 0:\n                    e.flow += newflow\n                    self.edg[idx ^ 1].flow -= newflow\n                    flow += newflow\n                    cp -= newflow\n                    if cp == 0:\n                        break\n            self.cur[x] += 1\n        return flow\n\n    def Dinic(self):\n        flow = 0\n        while self.bfs():\n            self.cur = [0] * MAX_SIZE\n            flow += self.dfs(self.s, 10**9)\n        return flow\n\ndef BFS(x, y, n, g1, visited):\n    q = deque()\n    dist = [[111] * 14 for _ in range(14)]\n    dist[x][y] = 0\n    q.append(((x, y), 0))\n    dx = [1, 0, 0, -1]\n    dy = [0, 1, -1, 0]\n    while q:\n        (cx, cy), d = q.popleft()\n        if visited[cx][cy]:\n            continue\n        visited[cx][cy] = True\n        dist[cx][cy] = d\n        for i in range(4):\n            tx = dx[i] + cx\n            ty = dy[i] + cy\n            if 1 <= tx <= n and 1 <= ty <= n and not visited[tx][ty] and g1[tx][ty] != 'Y':\n                q.append(((tx, ty), d + 1))\n    return dist\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    t = int(next(it))\n    g1 = [None] * 14\n    g2 = [None] * 14\n    for i in range(1, n+1):\n        line = next(it)\n        g1[i] = ' ' + line\n    for i in range(1, n+1):\n        line = next(it)\n        g2[i] = ' ' + line\n\n    mf = Maxflow()\n    mf.s = 0\n    mf.t = MAX_SIZE - 2\n\n    x, y = 0, 0\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if g1[i][j] == 'Z':\n                x, y = i, j\n                break\n        if x:\n            break\n\n    visited = [[False] * 14 for _ in range(14)]\n    dist = BFS(x, y, n, g1, visited)\n\n    def index(level, x, y):\n        return level * n * n + (x - 1) * n + y\n\n    tgt = {}\n    for i in range(1, n*n+1):\n        tgt[i] = MAX_SIZE - 3 - (n*n - i)\n\n    for i in range(1, n+1):\n        for j in range(1, n+1):\n            if '0' <= g1[i][j] <= '9':\n                mf.addedge(mf.s, index(0, i, j), ord(g1[i][j]) - ord('0'))\n            if '0' <= g2[i][j] <= '9':\n                mf.addedge(tgt[index(0, i, j)], mf.t, ord(g2[i][j]) - ord('0'))\n            mf.addedge(index(0, i, j), tgt[index(0, i, j)], 10**9)\n\n    dx = [1, 0, 0, -1]\n    dy = [0, 1, -1, 0]\n    for i in range(1, t+1):\n        for j in range(1, n+1):\n            for k in range(1, n+1):\n                if g1[j][k] in ('Y', 'Z'):\n                    continue\n                for l in range(4):\n                    tx = dx[l] + j\n                    ty = dy[l] + k\n                    if 1 <= tx <= n and 1 <= ty <= n and g1[tx][ty] not in ('Y', 'Z'):\n                        if dist[j][k] >= i and dist[tx][ty] >= i:\n                            mf.addedge(index(i-1, tx, ty), index(i, j, k), 10**9)\n                mf.addedge(index(i, j, k), tgt[index(0, j, k)], 10**9)\n\n    print(mf.Dinic())\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.3112935e-05, 0.0, -2.3841855e-07, -0.0005590545, -0.18072829, -0.0021487023, -0.005315694, -0.013780101, -0.0006625841, -1.1920928e-07, -5.876845e-05, -0.023669075, -0.1499721, -2.741776e-05, -1.5735503e-05, -8.344647e-07, -2.8252203e-05, -1.966934e-05, -3.773345, -0.001070284, -0.0052675502, -0.014163684, -6.3180723e-06, -4.0531077e-06, -0.97417843, -0.014168385, -3.3378547e-06, -2.622601e-06, -1.1369295, 0.0, -2.3841855e-07, -4.76836e-06, -6.9141147e-06, -0.039984584, -0.010192606, -0.018672638, -3.81469e-06, -3.576278e-07, -1.1920922e-06, -5.960463e-07, -5.245195e-06, -2.3841855e-07, -9.5367386e-07, -7.6648634e-05, -0.00027903, -0.00025519452, -1.072883e-06, -8.34464