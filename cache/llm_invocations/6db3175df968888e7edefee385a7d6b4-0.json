l_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        \n        int n = scanner.nextInt();\n        int m = scanner.nextInt();\n        \n        int[] data = new int[n];\n        for (int i = 0; i < n; i++) {\n            data[i] = scanner.nextInt();\n        }\n        \n        int half = n / 2;\n        int[] first_half = Arrays.copyOfRange(data, 0, half);\n        int[] second_half = Arrays.copyOfRange(data, half, n);\n        \n        List<Integer> left_collection = new ArrayList<>();\n        List<Integer> right_collection = new ArrayList<>();\n        \n        traverseLeft(first_half, 0, 0, m, left_collection);\n        traverseRight(second_half, 0, 0, m, right_collection);\n        \n        List<Integer> left_unique = new ArrayList<>(new HashSet<>(left_collection));\n        Collections.sort(left_unique);\n        \n        int best = 0;\n        \n        for (int rv : right_collection) {\n            int target = m - rv;\n            int idx = Collections.binarySearch(left_unique, target);\n            if (idx < 0) {\n                idx = -idx - 1;\n            }\n            \n            int[] candidates = {idx - 1, idx};\n            for (int j : candidates) {\n                if (j >= 0 && j < left_unique.size()) {\n                    int candidate = (left_unique.get(j) + rv) % m;\n                    if (candidate > best) {\n                        best = candidate;\n                    }\n                }\n            }\n        }\n        \n        System.out.println(best);\n    }\n    \n    private static void traverseLeft(int[] first_half, int pos, int acc, int m, List<Integer> left_collection) {\n        if (pos == first_half.length) {\n            left_collection.add(acc % m);\n        } else {\n            traverseLeft(first_half, pos + 1, (acc + first_half[pos]) % m, m, left_collection);\n            traverseLeft(first_half, pos + 1, acc, m, left_collection);\n        }\n    }\n    \n    private static void traverseRight(int[] second_half, int pos, int acc, int m, List<Integer> right_collection) {\n        if (pos == second_half.length) {\n            right_collection.add(acc % m);\n        } else {\n            traverseRight(second_half, pos + 1, (acc + second_half[pos]) % m, m, right_collection);\n            traverseRight(second_half, pos + 1, acc, m, right_collection);\n        }\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00010263393050990999, -1.311301275563892e-06, -2.3841855067985307e-07, -0.00014041867689229548, -2.992108420585282e-05, -0.0036010199692100286, -0.254146546125412, -2.9802276912960224e-06, -3.576278118089249e-07, -0.00035339308669790626, -5.960446742392378e-06, -9.536738616588991e-07, -0.0004758894501719624, -1.4305104514278355e-06, -7.152555099310121e-07, -1.311301275563892e-06, -7.152555099310121e-07, -1.1920928244535389e-07, -5.9960475482512265e-05, -1.1920922133867862e-06, -2.3841855067985307e-07, -2.0265558760002023e-06, -3.111314072157256e-05, -0.38893139362335205, -1.1920928244535389e-07, -3.576278118089249e-07, -9.775113539944869e-06, -3.4570634852570947e-06, -1.9073468138230965e-06, -4.351044481154531e-05, -0.575942873954773, -2.622600959512056e-06, -0.001703836489468813, -1.1920928244535389e-07, -1.1920928244535389e-07, -1.2755313036905136e-05, -1.6689286894688848e-06, -7.152555099310121e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.622600959512056e-06, -2.4199192921514623e-05, -1.1920922133867862e-06, -6.437280717364047e-06, -0.07889074087142944, -1.4305104514278355e-06, -0.007627411279827356, -1.1920928244535389e-07, -3.576278118089249e-07, 0.0, -1.5497195136049413e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -3.576272320060525e-