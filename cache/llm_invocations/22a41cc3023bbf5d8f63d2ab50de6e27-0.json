 process(n) << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static int num(long n) {\n        int cnt = 0;\n        while (n != 0) {\n            n /= 10;\n            cnt++;\n        }\n        return cnt;\n    }\n\n    public static long find(long n) {\n        int ex = num(n);\n        long cur = 0, ad = 1;\n        for (int i = 0; i <= ex - 1; i++) {\n            cur += ad;\n            ad *= 10;\n        }\n        if (cur <= n) return cur;\n        return (cur - 1) / 10;\n    }\n\n    public static long process(long n) {\n        if (n <= 6) return n;\n        if (n <= 11) return 13 - n;\n        long tmp = find(n);\n        long more = tmp * 10 + 1;\n        if (n % tmp == 0) {\n            long t = n / tmp;\n            if (n <= more / 2 + tmp) return num(tmp) * t;\n            else {\n                long cur = process(more - n);\n                return num(more) + cur;\n            }\n        } else {\n            long _m = (n / tmp) * tmp;\n            long _M = (n / tmp + 1) * tmp;\n            long res = process(_m) + process(n - _m);\n            if (n > more / 2) res = Math.min(process(_m) + process(n - _m), num(more) + process(more - n));\n            return res;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        long n = sc.nextLong();\n        System.out.println(process(n));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -1.3470558769768104e-05, -4.768370445162873e-07, 0.0, -1.3828182090946939e-05, -0.0019502682844176888, -0.002478862414136529, -4.6967357775429264e-05, 0.0, -0.01602156087756157, -0.0015043619787320495, -0.001508051878772676, -0.6075332164764404, 0.0, -0.02661135420203209, -1.40665970320