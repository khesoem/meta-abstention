n neg ? cx + c : cx - c;\n    }\n\n    private static long lst(long x) {\n        if (x < 0) x = -x;\n        while (x >= 10) {\n            x /= 10;\n        }\n        return x;\n    }\n\n    private static long del(long x) {\n        if (x < 0) x = -x;\n        List<Integer> digits = new ArrayList<>();\n        while (x >= 10) {\n            digits.add((int)(x % 10));\n            x /= 10;\n        }\n        long res = 0;\n        for (int i = digits.size() - 1; i >= 0; --i) {\n            res = res * 10 + digits.get(i);\n        }\n        return res;\n    }\n\n    private static long f(long x) {\n        if (x <= 11) return Math.min(13 - x, x);\n        if (memo.containsKey(x)) return memo.get(x);\n        \n        long n = 0, t = 1;\n        while (t < x) {\n            t *= 10;\n            t++;\n            n++;\n        }\n        \n        long result;\n        if (x * 2 >= t) {\n            result = Math.min(f(t - x) + n + 1, (x / (t / 10)) * n + f(x % (t / 10)));\n        } else {\n            result = (x / (t / 10)) * n + f(x % (t / 10));\n        }\n        \n        memo.put(x, result);\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long a = scanner.nextLong();\n        System.out.println(f(a));\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001896439935080707, -1.6689286894688848e-06, -4.768370445162873e-07, -4.708655978902243e-05, -2.0146166207268834e-05, -0.005293282680213451, -0.4294126629829407, -2.253030106658116e-05, -9.536738616588991e-07, -5.519237674889155e-05, -0.005929143168032169, -0.0007103541865944862, -0.6871150732040405, -1.5139465176616795e-05, -0.6960896849632263, -3.683499380713329e-05, 0.0, -3.7788631743751466e-05, -1.1920928244535389e-07, -3.3378546504536644e-06, -0.029807347804307938, -3.4570634852570947e-06, -2.9682672902708873e-05, -0.0036032767966389656, -2.3841855067985307e-07, -0.428925424