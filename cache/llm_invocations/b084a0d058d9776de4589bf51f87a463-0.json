umerate(row_str, 1):\n            if ch.isdigit():\n                B[i][j] = int(ch)\n                for _ in range(B[i][j]):\n                    treasureAt[i][j].append(rightCnt)\n                    rightCnt += 1\n    # set unreachable cells to INF\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if F[i][j] < 0:\n                F[i][j] = INF\n    # build edges\n    edges = [[] for _ in range(2000)]\n    leftCnt = 0\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if A[i][j] > 0:\n                cnt = A[i][j]\n                vis = [[-1] * (n + 2) for _ in range(n + 2)]\n                q = deque()\n                q.append((i, j))\n                vis[i][j] = 0\n                while q:\n                    rr, cc = q.popleft()\n                    lim = min(T, F[rr][cc])\n                    if vis[rr][cc] > lim:\n                        continue\n                    for treasure in treasureAt[rr][cc]:\n                        for k in range(cnt):\n                            edges[leftCnt + k].append(treasure)\n                    if vis[rr][cc] == lim:\n                        continue\n                    for k in range(4):\n                        nr = rr + dr[k]\n                        nc = cc + dc[k]\n                        if A[nr][nc] >= 0 and vis[nr][nc] < 0:\n                            vis[nr][nc] = vis[rr][cc] + 1\n                            q.append((nr, nc))\n                leftCnt += cnt\n    # maximum matching\n    matchL = [-1] * 2000\n    matchR = [-1] * 2000\n    seen = [0] * 2000\n    def dfs(x):\n        for y in edges[x]:\n            if seen[y]:\n                continue\n            seen[y] = 1\n            if matchR[y] == -1 or dfs(matchR[y]):\n                matchL[x] = y\n                matchR[y] = x\n                return True\n        return False\n    ans = 0\n    for i in range(leftCnt):\n        seen = [0] * 2000\n        if dfs(i):\n            ans += 1\n    p