emset(F, 255, sizeof(F));\n    qr.push(r);\n    qc.push(c);\n    F[r][c] = 0;\n    while (!qr.empty()) {\n        int rr = qr.front(); qr.pop();\n        int cc = qc.front(); qc.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nr = rr + dr[k];\n            int nc = cc + dc[k];\n            if (A[nr][nc] >= 0 && F[nr][nc] < 0) {\n                F[nr][nc] = F[rr][cc] + 1;\n                qr.push(nr);\n                qc.push(nc);\n            }\n        }\n    }\n}\n\nvoid linkMonsters(int r, int c, int cnt) {\n    int vis[12][12];\n    queue<int> qr, qc;\n    memset(vis, 255, sizeof(vis));\n    qr.push(r);\n    qc.push(c);\n    vis[r][c] = 0;\n    while (!qr.empty()) {\n        int rr = qr.front(); qr.pop();\n        int cc = qc.front(); qc.pop();\n        int lim = min(T, F[rr][cc]);\n        if (vis[rr][cc] > lim) continue;\n        for (int i = 0; i < (int)treasureAt[rr][cc].size(); ++i)\n            for (int k = 0; k < cnt; ++k)\n                edges[leftCnt + k].push_back(treasureAt[rr][cc][i]);\n        if (vis[rr][cc] == lim) continue;\n        for (int k = 0; k < 4; ++k) {\n            int nr = rr + dr[k];\n            int nc = cc + dc[k];\n            if (A[nr][nc] >= 0 && vis[nr][nc] < 0) {\n                vis[nr][nc] = vis[rr][cc] + 1;\n                qr.push(nr);\n                qc.push(nc);\n            }\n        }\n    }\n    leftCnt += cnt;\n}\n\nint main() {\n    scanf(\"%d%d\", &n, &T);\n    memset(A, 255, sizeof(A));\n    memset(B, 255, sizeof(B));\n    for (int i = 1; i <= n; ++i) {\n        while (getchar() != '\\n');\n        for (int j = 1; j <= n; ++j) {\n            int ch = getchar();\n            if (ch >= '0' && ch <= '9') A[i][j] = ch - '0';\n            if (ch == 'Z') {\n                sr = i;\n                sc = j;\n            }\n        }\n    }\n    floodFill(sr, sc);\n    while (getchar() != '\\n');\n    for (int i = 1; i <= n; ++i) {\n        while (getchar() != '\\n');\n        for (int j = 1; j <= n; ++j) {