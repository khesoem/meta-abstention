 > 1) {\n        if (10LL * current * MAX_BOUND > N_val &&\n            1LL * (current + 1) * MAX_BOUND - 1 <= N_val) {\n            for (int k = 0; k < 7; ++k) {\n                lli value = (C_val - current * ten_pow[k]) % MOD_A;\n                if (value < 0) value += MOD_A;\n                int num = static_cast<int>(value);\n                auto iter = lower_bound(container[k].begin(), container[k].end(),\n                                        MOD_A - num);\n                int pos = distance(container[k].begin(), iter);\n                int part1 = static_cast<int>(1LL * num * container[k].size() % MOD_B);\n                int part2 = arr_sum[k];\n                total_ans = union_mod(total_ans, union_mod(part1, part2, MOD_B), MOD_B);\n                int part3 = static_cast<int>(1LL * MOD_A * (container[k].size() - pos) % MOD_B);\n                total_ans = difference_mod(total_ans, part3, MOD_B);\n            }\n            C_val += node_count;\n            return;\n        }\n        ++C_val;\n        int diff = static_cast<int>((C_val - current) % MOD_A + MOD_A) % MOD_A;\n        total_ans = union_mod(total_ans, diff, MOD_B);\n    }\n    for (int digit = (depth == 1 ? 1 : 0); digit <= 9; ++digit) {\n        explore(depth + 1, current * 10 + digit);\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> N_val;\n    ten_pow[0] = 1;\n    for (int i = 1; i < 9; ++i) ten_pow[i] = 10 * ten_pow[i - 1];\n    traverse(1, 0);\n    for (int i = 0; i < 7; ++i) {\n        sort(container[i].begin(), container[i].end());\n    }\n    explore(1, 0);\n    cout << total_ans << '\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long MOD_A = 998244353L;\n    static long MOD_B = 1000000007L;\n    static int MAX_D = 2000000;\n    static long MAX_BOUND = 1000000L;\n\n    static long N_val, C_val;\n    static int node_count, total_ans, upper_limit;\n    static long[] ten_pow = new long[2000000];\n    static int[] arr_sum = new int[2000000];\n    static List<Integer>[] container = new List[2000000];\n\n    @SuppressWarnings(\"unchecked\")\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        N_val = Long.parseLong(st.nextToken());\n\n        for (int i = 0; i < 2000000; i++) {\n            container[i] = new ArrayList<>();\n        }\n\n        ten_pow[0] = 1;\n        for (int i = 1; i < 9; ++i) {\n            ten_pow[i] = 10 * ten_pow[i - 1];\n        }\n\n        traverse(1, 0);\n\n        for (int i = 0; i < 7; ++i) {\n            Collections.sort(container[i]);\n        }\n\n        explore(1, 0);\n        System.out.println(total_ans);\n    }\n\n    static int difference_mod(int a, int b, long M) {\n        return (a - b < 0) ? (a - b + (int) M) : (a - b);\n    }\n\n    static int union_mod(int a, int b, long M) {\n        return (a + b >= (int) M) ? (a + b - (int) M) : (a + b);\n    }\n\n    static void traverse(int depth, int current) {\n        if (current <= N_val) {\n            ++node_count;\n            int val = difference_mod(node_count, current, MOD_A);\n            container[depth - 1].add(val);\n            arr_sum[depth - 1] = union_mod(arr_sum[depth - 1], val, MOD_B);\n        }\n        if (depth > 6) return;\n        for (int d = 0; d <= 9; ++d) {\n            traverse(depth + 1, current * 10 + d);\n        }\n    }\n\n    static void explore(int depth, long current) {\n        if (current > N_val) return;\n        if (depth > 1) {\n            if (10L * current * MAX_BOUND > N_val &&\n                1L * (current + 1) * MAX_BOUND - 1 <= N_val) {\n                for (int k = 0; k < 7; ++k) {\n                    long value = (C_val - current * ten_pow[k]) % MOD_A;\n                    if (value < 0) value += MOD_A;\n                    int num = (int) value;\n                    List<Integer> list = container[k];\n                    int pos = lowerBound(list, (int) (MOD_A - num));\n                    int part1 = (int) (1L * num * list.size() % MOD_B);\n                    int part2 = arr_sum[k];\n                    total_ans = union_mod(total_ans, union_mod(part1, part2, MOD_B), MOD_B);\n                    int part3 = (int) (1L * MOD_A * (list.size() - pos) % MOD_B);\n                    total_ans = difference_mod(total_ans, part3, MOD_B);\n                }\n                C_val += node_count;\n                return;\n            }\n            ++C_val;\n            int diff = (int) ((C_val - current) % MOD_A + MOD_A) % (int) MOD_A;\n            total_ans = union_mod(total_ans, diff, MOD_B);\n        }\n        for (int digit = (depth == 1 ? 1 : 0); digit <= 9; ++digit) {\n            explore(depth + 1, current * 10 + digit);\n        }\n    }\n\n    static int lowerBound(List<Integer> list, int target) {\n        int low = 0, high = list.size();\n        while (low < high) {\n            int mid = (low + high) / 2;\n            if (list.get(mid) < target) {\n                low = mid + 1;\n            } else {\n                high = mid;\n            }\n        }\n        return low;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00012611546844709665, -3.099436753473128e-06, -1.311301275563892e-06, -4.637133679352701e-05, -2.0265373677830212e-05, -0.061981283128261566, -0.4743604063987732, -0.0015280486550182104, -3.194758028257638e-05, -1.5735502529423684e-05, -0.00025376438861712813, -0.00013863079948350787, -1.6689286894688848e-06, -3.7431014789035544e-05, -0.008619130589067936, -2.4676019165781327e-05, -0.08190111815929413, -0.10261741280555725, -0.0003013156820088625, -2.3841855067985307e-07, 0.0, -1.19209282