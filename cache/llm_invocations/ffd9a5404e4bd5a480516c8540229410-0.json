ginal_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringBuilder sb = new StringBuilder();\n        String line;\n        while ((line = br.readLine()) != null) {\n            sb.append(line).append(\" \");\n        }\n        String[] tokens = sb.toString().trim().split(\"\\\\s+\");\n        if (tokens.length == 0) return;\n        int n = Integer.parseInt(tokens[0]);\n        int k = Integer.parseInt(tokens[1]);\n        int[] arr = new int[n];\n        for (int i = 0; i < n; i++) {\n            arr[i] = Integer.parseInt(tokens[2 + i]) % k;\n        }\n        if (n == 1) {\n            System.out.println(arr[0]);\n            return;\n        }\n        int[] left = gen(Arrays.copyOfRange(arr, 0, n / 2), k);\n        int[] right = gen(Arrays.copyOfRange(arr, n / 2, n), k);\n        int ans = Math.max(left[left.length - 1], right[right.length - 1]);\n        for (int x : left) {\n            int target = k - 1 - x;\n            int lo = 0, hi = right.length;\n            while (lo < hi) {\n                int mid = (lo + hi) / 2;\n                if (right[mid] <= target) {\n                    lo = mid + 1;\n                } else {\n                    hi = mid;\n                }\n            }\n            int idx = lo;\n            int y = (idx > 0) ? right[idx - 1] : right[right.length - 1];\n            ans = Math.max(ans, (x + y) % k);\n            ans = Math.max(ans, (x + right[right.length - 1]) % k);\n        }\n        System.out.println(ans);\n    }\n\n    private static int[] gen(int[] part, int k) {\n        int m = part.length;\n        int size = 1 << m;\n        int[] subs = new int[size];\n        Set<Integer> set = new HashSet<>();\n        for (int mask = 1; mask < size; mask++) {\n            int lowBit = mask & -mask;\n            int i = Integer.numberOfTrailingZeros(mask);\n            subs[mask] = (subs[mask ^ lowBit] + part[i]) % k;\n            set.add(subs[mask]);\n        }\n        int[] res = new int[set.size()];\n        int idx = 0;\n        for (int val : set) {\n            res[idx++] = val;\n        }\n        Arrays.sort(res);\n        return res;\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.023475565016269684, -1.0728830375228426e-06, 0.0, 0.0, -2.1815061700181104e-05, -1.2755313036905136e-05, 0.0, -0.25192904472351074, -0.12693308293819427, 0.0, 0.0, -1.1920928244535389e-07, -6.305972783593461e-05, -2.3841830625315197e-06, 0.0, -0.0036206187214702368, -0.0007108307327143848, -6.007967749610543e-05, -0.00030048147891648114, 0.0, -0.00020346954988781363, 0.0, -1.1920928244535389e-07, -4.768370445162873e-07, -3.576278118089249e-07, -1.1920928244535389e-07, -0.0024802894331514835, -0.0297507643699646, -3.576278118089249e-07, -2.3841855067985307e-07, -0.0004323977918829769, -0.20169028639793396, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, 0.0, -3.4570634852570947e-06, -1.680836794548668e-05, -0.21376091241836548, -3.9219088648678735e-05, -9.536738616588991e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.00047886825632303953, -2.861018856492592e-06, -8.749579137656838e-05, -7.152555099310121e-07, -0.00026306029758416116, -6.842378934379667e-05, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, 0.0, -6.305972783593461e-05, -0.0003369478799868375, 0.0, -3.576278118089249e-07, 0.0, -2.253030106658116e-05, -0.02980376034975052, -1.1920928244535389e-07, -0.252694696187973, -8.940656698541716e-06, -1.4305104514278355e-06, -9.536738616588991e-07, -2.264974000354414e-06, -0.009097552858293056, -1.2636104656849056e-05, -0.10695692