nse": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    nau = [list(next(it).strip()) for _ in range(n)]\n    pom = [list(next(it).strip()) for _ in range(n)]\n\n    # Distance array\n    odl = [[1000] * n for _ in range(n)]\n\n    # Find start position\n    sx = sy = -1\n    for i in range(n):\n        for j in range(n):\n            if nau[i][j] == 'Z':\n                sx, sy = i, j\n                break\n        if sx != -1:\n            break\n\n    # Directions\n    dx = [-1, 0, 1, 0, 0]\n    dy = [0, 1, 0, -1, 0]\n\n    def ok(x, y):\n        return 0 <= x < n and 0 <= y < n\n\n    # BFS from start\n    q = deque()\n    odl[sx][sy] = 0\n    q.append((sx, sy))\n    while q:\n        x, y = q.popleft()\n        for i in range(4):\n            nx, ny = x + dx[i], y + dy[i]\n            if ok(nx, ny) and '0' <= nau[nx][ny] <= '9' and odl[nx][ny] == 1000:\n                odl[nx][ny] = odl[x][y] + 1\n                q.append((nx, ny))\n\n    # Reachability DP: moge[k][x1][y1][x2][y2]\n    # Initialize moge as a 5D list of bools\n    moge = [[[[[False for _ in range(10)] for _ in range(10)] for _ in range(10)] for _ in range(10)] for _ in range(min(t, 60))]\n\n    # Step 0 initialization\n    for i in range(n):\n        for j in range(n):\n            if not nau[i][j].isdigit():\n                continue\n            for d in range(5):\n                ni, nj = i + dx[d], j + dy[d]\n                if ok(ni, nj) and nau[ni][nj].isdigit():\n                    moge[0][i][j][ni][nj] = True\n\n    # DP steps\n    for k in range(min(t - 1, 59)):\n        for i in range(n):\n            for j in range(n):\n                if not nau[i][j].isdigit():\n                    continue\n                for l in range(n):\n                    for m in range(n):\n                        if not nau[l][m].isdigit():\n                            continue\n                        if not moge[k][i][j][l][m]:\n                            continue\n                        for d in range(5):\n                            nl, nm = l + dx[d], m + dy[d]\n                            if ok(nl, nm) and nau[nl][nm].isdigit() and odl[l][m] >= k+2 and odl[nl][nm] >= k+2:\n                                moge[k+1][i][j][nl][nm] = True\n\n    # Collect digit positions\n    a = []\n    for i in range(n):\n        for j in range(n):\n            if nau[i][j].isdigit():\n                a.append((i, j))\n\n    V = 2 * len(a) + 2\n    G = [[] for _ in range(V)]  # list of (to, capacity)\n\n    # Source edges\n    for idx, (x, y) in enumerate(a):\n        cap = int(nau[x][y])\n        G[0].append([idx + 1, cap])\n        G[idx + 1].append([0, 0])\n        cap = int(pom[x][y])\n        G[len(a) + 1 + idx].append([V - 1, cap])\n        G[V - 1].append([len(a) + 1 + idx, 0])\n\n    # Middle edges based on reachability\n    for i in range(len(a)):\n        for j in range(len(a)):\n            ok_reach = False\n            for k in range(min(t, 60)):\n                if moge[k][a[i][0]][a[i][1]][a[j][0]][a[j][1]]:\n                    ok_reach = True\n                    break\n            if ok_reach:\n                G[i + 1].append([len(a) + 1 + j, 1000])\n                G[len(a) + 1 + j].append([i + 1, 0])\n\n    # Max flow (Edmonds-Karp)\n    flow = 0\n    while True:\n        vis = [False] * V\n        par = [-1] * V\n        q = deque()\n        vis[0] = True\n        q.append(0)\n        while q:\n            u = q.popleft()\n            for v, cap in G[u]:\n                if not vis[v] and cap > 0:\n                    vis[v] = True\n                    par[v] = u\n                    q.append(v)\n        if par[V - 1] == -1:\n            break\n\n        # Find bottleneck\n        add = 1000\n        v = V - 1\n        while v != 0:\n            u = par[v]\n            for to, cap in G[u]:\n                if to == v:\n                    add = min(add, cap)\n                    break\n            v = u\n\n        # Augment\n        v = V - 1\n        while v != 0:\n            u = par[v]\n            for edge in G[u]:\n                if edge[0] == v:\n                    edge[1] -= add\n                    break\n            for edge in G[v]:\n                if edge[0] == u:\n                    edge[1] += add\n                    break\n            v = u\n        flow += add\n\n    print(flow)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00020418466, 0.0, -1.072883e-06, -0.0019690664, -0.12104711, -4.1603176e-05, -0.006759871, -0.0004042762, -0.00010942814, -2.3841855e-07, -9.989239e-05, -0.016847465, -0.0012153152, -0.1309882, -0.03804784, -8.940657e-06, -0.437525, -3.0993935e-05, -4.8517002e-05, -2.622601e-06, -0.00031204123, -1.394739e-05, -0.1269419, -0.018204277, -9.679326e-05, -0.9783625, -3.6954812e-06, -1.1920928e-07, -0.0019288522, -1.7881378e-06, -3.2186456e-06, -0.00031895319, -3.576278e-07, -0.014686803, -4.7683704e-07, -4.7683704e-07, -1.1920928e-07, -1.2993728e-05, -9.6316464e-05, -9.298281e-06, -8.272783e-05, -2.3841855e-07, -2.3841855e-07, 0.0, -0.0004982899, -4.7683704e-07, -0.0005727558, -9.309812e-05, -1.1920928e-07, -1.1920928e-07, 0.0, -0.2519423, -1.313287, -0.0003525589, -1.2636105e-05, -0.0838477, -0.023512011, -4.0531077e-06, -1.1920928e-07, -0.38691434, -0.00020489977, -5.769563e-05, -2.3841855e-07, -1.1920928e-07, -3.576278e-07, 0.0, -4.7683704e-07, -0.00010966653, -2.3841855e-07, -6.079655e-06, -9.298281e-06, -3.3378547e-06, -3.0994368e-06, -3.576278e-07, 0.0, -3.6954812e-06, 0.0, -7.152555e-07, -1.1920928e-07, -1.1920928e-07, -1.072883e-06, -1.1920928e-07, -2.3841855e-07, -0.47410792, -3.6477377e-05, -0.98224705, -1.8624513, -1.4500475, -0.22358996, 0.0, -0.25355375, -2.145765e-06, -9.5367386e-07, -1.3589766e-05, -8.