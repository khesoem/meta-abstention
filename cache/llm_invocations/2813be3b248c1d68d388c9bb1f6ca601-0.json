m2 = []\n    cur = base\n    until = half\n\n    def brute(pos):\n        nonlocal cur, rem1\n        if pos == until:\n            rem1.append(cur)\n            return\n        oldcur = cur\n        for _ in range(10):\n            brute(pos + 1)\n            cur += variables[pos]\n            if cur >= mod:\n                cur -= mod\n        cur = oldcur\n\n    brute(0)\n    rem2 = rem1[:]\n    rem1 = []\n    cur = 0\n    until = n_vars\n    brute(half)\n\n    rem1.sort()\n    rem2.sort()\n    totalrsum = sum(rem2)\n    j = len(rem2) - 1\n    for a in rem1:\n        while j >= 0 and a + rem2[j] >= mod:\n            j -= 1\n        ans_list[0] += a * len(rem2) + totalrsum - (len(rem2) - 1 - j) * mod\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    if n == 0:\n        print(0)\n        return\n\n    n_str = str(n)\n    mod = 998244353\n    final_mod = 1000000007\n\n    # pw10 up to len(n_str)+1 to be safe\n    pw10 = [1]\n    for i in range(1, len(n_str) + 2):\n        pw10.append(pw10[-1] * 10)\n\n    ans_list = [0]\n\n    # first part: numbers with a prefix different from n_str\n    for length in range(1, len(n_str) + 1):\n        cur = 0\n        curst = \"\"\n        for firstdiff in range(0, min(len(n_str), length)):\n            if firstdiff > 0:\n                cur = 10 * cur + int(n_str[firstdiff - 1])\n                curst += n_str[firstdiff - 1]\n            for lastdig in range(0, 10):\n                if firstdiff == 0 and lastdig == 0:\n                    continue\n                if lastdig == int(n_str[firstdiff]):\n                    continue\n                if length == len(n_str) and lastdig > int(n_str[firstdiff]):\n                    continue\n                curp = 10 * cur + lastdig\n                curstp = curst + str(lastdig)\n                base = 0\n                tmp = \"\"\n                for pos in range(len(curstp)):\n                    start_dig = 1 if