ype)   std::numeric_limits<type>::max()\n#define TYPEMIN(type)   std::numeric_limits<type>::min()\n\nconst int mod = 998244353;\n\nstring toString(__int128_t num) {\n    if (not num)\n        return \"0\";\n    string res;\n\n    while (num) {\n        res += char('0' + num % 10);\n        num /= 10;\n    }\n\n    std::reverse(ALL(res));\n    return res;\n}\n\nvoid solve(vector<int> variables, int base, __int128_t& ans) {\n    int cur, until;\n\n    vector<int> rem1, rem2;\n    \n    std::function<void(int)> brute = [&](int pos) {\n        if (pos == until) {\n            rem1.push_back(cur);\n            return;\n        }\n\n        auto oldcur = cur;\n        for (int t = 0; t < 10; ++t) {\n            brute(pos + 1);\n            cur += variables[pos];\n            if (cur >= mod)\n                cur -= mod;\n        }\n        cur = oldcur;\n    };\n\n    cur = base;\n    until = SZ(variables) / 2;\n    brute(0);\n\n    rem2 = std::move(rem1);\n    cur = 0;\n    until = SZ(variables);\n    brute(SZ(variables) / 2);\n\n    sort(ALL(rem1));\n    sort(ALL(rem2));\n\n    int64_t totalrsum = 0;\n    for (int b: rem2)\n        totalrsum += b;\n\n    int j = SZ(rem2) - 1;\n    for (int a: rem1) {\n        while (j >= 0 and a + rem2[j] >= mod)\n            --j;\n\n        ans += a * int64_t(SZ(rem2)) + totalrsum - (SZ(rem2) - 1 - j) * int64_t(mod);\n    }\n}\n\nint64_t pw10[17];\n\nint64_t count_with_prefix(const string& s, int64_t n, const string& n_str) {\n    int64_t ans = 0;\n\n    int64_t s_val = 0;\n    for (char ch: s)\n        s_val = 10 * s_val + ch - '0';\n    \n    for (int len = SZ(s); len <= SZ(n_str); ++len) {\n        if (len < SZ(n_str))\n            ans += pw10[len - SZ(s)];\n        else {\n            int t = strncmp(s.c_str(), n_str.c_str(), SZ(s));\n            if (t < 0)\n                ans += pw10[len - SZ(s)];\n            else if (t == 0) {\n                ans += (n + 1) - s_val * pw10[SZ(n_str) - SZ(s)];\n            }\n        }\n    }\n  