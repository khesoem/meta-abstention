{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\n#define MAXN 260000\n#define FOR(i, a, b) for (int i = (a); i <= (b); ++i)\n#define FORD(i, a, b) for (int i = (a); i >= (b); --i)\n#define SUB_SUBS(sup, sub) for (int sub = (sup); sub; sub = (sub - 1) & (sup))\n\nint n, k, mod;\nint ways[18][MAXN];\nint fact[MAXN], invFact[MAXN], pop[MAXN];\nbool mark[MAXN];\n\nint mod_pow(int a, int e) {\n    if (e == 0) return 1;\n    int half = mod_pow(a, e / 2);\n    int r = (int)(1LL * half * half % mod);\n    if (e & 1) r = (int)(1LL * r * a % mod);\n    return r;\n}\n\nint main() {\n    scanf(\"%d%d%d\", &n, &k, &mod);\n    if (n & 1) {\n        printf(\"%d\\n\", mod_pow(k, n));\n        return 0;\n    }\n    FOR(i, 0, n) {\n        if (i == 0) fact[i] = 1;\n        else fact[i] = (int)(1LL * fact[i - 1] * i % mod);\n    }\n    invFact[n] = mod_pow(fact[n], mod - 2);\n    FORD(i, n - 1, 0)\n        invFact[i] = (int)(1LL * invFact[i + 1] * (i + 1) % mod);\n\n    ways[0][0] = 1;\n    FOR(i, 0, n) {\n        pop[i] = 0;\n        for (int x = i; x; x &= x - 1) ++pop[i];\n    }\n    for (int i = n;; i = (i - 1) & n) {\n        mark[i] = true;\n        if (i == 0) break;\n    }\n    FOR(i, 1, n) {\n        if (!mark[i]) continue;\n        SUB_SUBS(i, j) {\n            int lim = min(k, pop[i - j] + 1);\n            FOR(s, 1, lim) {\n                if (ways[s - 1][i - j]) {\n                    ways[s][i] = (int)((ways[s][i] + 1LL * ways[s - 1][i - j] * invFact[j]) % mod);\n                }\n            }\n        }\n    }\n    int ans = 0;\n    FOR(i, 0, min(k, pop[n])) {\n        if (!ways[i][n]) continue;\n        int tmp = (int)(1LL * ways[i][n] * fact[k] % mod);\n        tmp = (int)(1LL * tmp * invFact[k - i] % mod);\n        tmp = (int)(1LL * tmp * invFact[i] % mod);\n        tmp = (int)(1LL * tmp * fact[n] % mod);\n        ans = (ans + tmp) % mod;\n    }\n    printf(\"%d\\n\", (mod_pow(k, n) - ans + mod) % mod);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef mod_pow(a, e, mod):\n    if e == 0:\n        return 1\n    half = mod_pow(a, e // 2, mod)\n    r = (half * half) % mod\n    if e & 1:\n        r = (r * a) % mod\n    return r\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n\n    if n & 1:\n        print(pow(k, n, mod))\n        return\n\n    # factorials\n    fact = [0] * (n + 1)\n    fact[0] = 1\n    for i in range(1, n + 1):\n        fact[i] = (fact[i - 1] * i) % mod\n\n    invFact = [0] * (n + 1)\n    invFact[n] = pow(fact[n], mod - 2, mod)\n    for i in range(n - 1, -1, -1):\n        invFact[i] = (invFact[i + 1] * (i + 1)) % mod\n\n    # ways[s][mask] for s=0..k, mask=0..n\n    ways = [[0] * (n + 1) for _ in range(k + 1)]\n    ways[0][0] = 1\n\n    # popcount\n    pop = [0] * (n + 1)\n    for i in range(n + 1):\n        pop[i] = bin(i).count('1')\n\n    # mark all submasks of n\n    mark = [False] * (n + 1)\n    mask = n\n    while True:\n        mark[mask] = True\n        if mask == 0:\n            break\n        mask = (mask - 1) & n\n\n    # DP over submasks\n    for i in range(1, n + 1):\n        if not mark[i]:\n            continue\n        sub = i\n        while sub:\n            j = sub\n            diff = i - j\n            lim = min(k, pop[diff] + 1)\n            for s in range(1, lim + 1):\n                if ways[s - 1][diff]:\n                    ways[s][i] = (ways[s][i] + ways[s - 1][diff] * invFact[j]) % mod\n            sub = (sub - 1) & i\n\n    # compute answer\n    ans = 0\n    max_i = min(k, pop[n])\n    for i in range(max_i + 1):\n        if not ways[i][n]:\n            continue\n        tmp = ways[i][n] * fact[k] % mod\n        tmp = (tmp * invFact[k - i] % mod\n        tmp = (tmp * invFact[i] % mod\n        tmp = (tmp * fact[n]) % mod\n        ans = (ans + tmp) % mod\n\n    result = (pow(k, n, mod) - ans) % mod\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.099436753473128e-06, -0.003195182653144002, -0.0014700806932523847, -0.35392722487449646, -0.0002051381452474743, 0.0, -0.0001062098381225951, -0.0024763653054833412, -1.1920928244535389e-07, -0.0019374187104403973, -0.00033206192892976105, -0.00011431517486926168, -3.814689989667386e-06, -0.02484539896249771, -3.576272320060525e-06, -8.344646857949556e-07, 0.0, -8.940656698541716e-06, -3.123234637314454e-05, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -0.061969295144081116, -2.3841855067985307e-07, -0.00047886825632303953, 0.0, -1.3232143828645349e-05, 0.0, 0.0, -1.4305104514278355e-06, -5.960462772236497e-07, -1.1920928244535389e-07, -0.000890097115188837, -2.3841855067985307e-07, -3.576278118089249e-07, -1.0132738680113107e-05, -1.1920928244535389e-07, -6.69933797325939e-05, 0.0, -0.0016978861531242728, 0.0, -0.002476603025570512, -5.364403477869928e-06, -4.768370445162873e-07