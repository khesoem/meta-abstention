{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <cstdio>\n#include <cstring>\n#include <vector>\n#include <queue>\n#include <utility>\n#include <algorithm>\nusing namespace std;\n\nconst int INF = 1000000000;\nconst int MAXN = 2000;\nconst int dr[] = {0, -1, 0, 1};\nconst int dc[] = {1, 0, -1, 0};\n\nint N, T, ZR, ZC;\nint A[12][12], B[12][12], F[12][12];\nvector<vector<int> > graph;\nvector<int> objects[12][12];\nint monsters = 0, treasures = 0;\n\nclass Hungarian {\npublic:\n    int solve(int leftN, vector<vector<int> >& g, int rightN) {\n        vector<int> left(leftN, -1);\n        vector<int> right(rightN, -1);\n        vector<int> used(rightN, 0);\n        int result = 0;\n        for (int i = 0; i < leftN; ++i) {\n            fill(used.begin(), used.end(), 0);\n            if (augment(i, g, left, right, used)) ++result;\n        }\n        return result;\n    }\n\nprivate:\n    bool augment(int u, vector<vector<int> >& g, vector<int>& left,\n                 vector<int>& right, vector<int>& used) {\n        for (int i = 0; i < (int)g[u].size(); ++i) {\n            int v = g[u][i];\n            if (used[v]) continue;\n            used[v] = 1;\n            if (right[v] == -1 || augment(right[v], g, left, right, used)) {\n                left[u] = v;\n                right[v] = u;\n                return true;\n            }\n        }\n        return false;\n    }\n};\n\nHungarian matcher;\n\nvoid bfsDist(int sr, int sc) {\n    queue<pair<int, int> > q;\n    memset(F, 255, sizeof(F));\n    F[sr][sc] = 0;\n    q.push(make_pair(sr, sc));\n    while (!q.empty()) {\n        int r = q.front().first;\n        int c = q.front().second;\n        q.pop();\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k];\n            int nc = c + dc[k];\n            if (A[nr][nc] >= 0 && F[nr][nc] < 0) {\n                F[nr][nc] = F[r][c] + 1;\n                q.push(make_pair(nr, nc));\n            }\n        }\n    }\n}\n\nvoid linkMonsters(int sr, int sc, int cnt) {\n    int seen[12][12];\n    queue<pair<int, int> > q;\n    memset(seen, 255, sizeof(seen));\n    seen[sr][sc] = 0;\n    q.push(make_pair(sr, sc));\n    while (!q.empty()) {\n        int r = q.front().first;\n        int c = q.front().second;\n        q.pop();\n        int limit = min(T, F[r][c]);\n        if (seen[r][c] > limit) continue;\n        for (int i = 0; i < (int)objects[r][c].size(); ++i)\n            for (int k = 0; k < cnt; ++k)\n                graph[monsters + k].push_back(objects[r][c][i]);\n        if (seen[r][c] == limit) continue;\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k];\n            int nc = c + dc[k];\n            if (A[nr][nc] >= 0 && seen[nr][nc] < 0) {\n                seen[nr][nc] = seen[r][c] + 1;\n                q.push(make_pair(nr, nc));\n            }\n        }\n    }\n    monsters += cnt;\n}\n\nint main() {\n    scanf(\"%d%d\", &N, &T);\n    graph.resize(MAXN);\n    memset(A, 255, sizeof(A));\n    memset(B, 255, sizeof(B));\n    for (int i = 1; i <= N; ++i) {\n        while (fgetc(stdin) != '\\n');\n        for (int j = 1; j <= N; ++j) {\n            int ch = fgetc(stdin);\n            if (ch >= '0' && ch <= '9') A[i][j] = ch - '0';\n            if (ch == 'Z') {\n                ZR = i;\n                ZC = j;\n            }\n        }\n    }\n    bfsDist(ZR, ZC);\n    while (fgetc(stdin) != '\\n');\n    for (int i = 1; i <= N; ++i) {\n        while (fgetc(stdin) != '\\n');\n        for (int j = 1; j <= N; ++j) {\n            int ch = fgetc(stdin);\n            if (ch >= '0' && ch <= '9') B[i][j] = ch - '0';\n            for (int k = 0; k < B[i][j]; ++k)\n                objects[i][j].push_back(treasures++);\n        }\n    }\n    for (int i = 1; i <= N; ++i)\n        for (int j = 1; j <= N; ++j)\n            if (F[i][j] < 0) F[i][j] = INF;\n    for (int i = 1; i <= N; ++i)\n        for (int j = 1; j <= N; ++j)\n            if (A[i][j] > 0) linkMonsters(i, j, A[i][j]);\n    printf(\"%d\\n\", matcher.solve(monsters, graph, treasures));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1000000000\nMAXN = 2000\ndr = [0, -1, 0, 1]\ndc = [1, 0, -1, 0]\n\nclass Hungarian:\n    def solve(self, leftN, g, rightN):\n        left = [-1] * leftN\n        right = [-1] * rightN\n        result = 0\n        for i in range(leftN):\n            used = [0] * rightN\n            if self.augment(i, g, left, right, used):\n                result += 1\n        return result\n\n    def augment(self, u, g, left, right, used):\n        for v in g[u]:\n            if used[v]:\n                continue\n            used[v] = 1\n            if right[v] == -1 or self.augment(right[v], g, left, right, used):\n                left[u] = v\n                right[v] = u\n                return True\n        return False\n\ndef bfsDist(sr, sc, A, N):\n    F = [[-1] * (N + 2) for _ in range(N + 2)]\n    q = deque()\n    F[sr][sc] = 0\n    q.append((sr, sc))\n    while q:\n        r, c = q.popleft()\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if A[nr][nc] >= 0 and F[nr][nc] < 0:\n                F[nr][nc] = F[r][c] + 1\n                q.append((nr, nc))\n    return F\n\ndef linkMonsters(sr, sc, cnt, A, F, objects, graph, monsters, T):\n    seen = [[-1] * (len(A[0])) for _ in range(len(A))]\n    q = deque()\n    seen[sr][sc] = 0\n    q.append((sr, sc))\n    while q:\n        r, c = q.popleft()\n        limit = min(T, F[r][c])\n        if seen[r][c] > limit:\n            continue\n        for obj in objects[r][c]:\n            for k in range(cnt):\n                graph[monsters + k].append(obj)\n        if seen[r][c] == limit:\n            continue\n        for k in range(4):\n            nr = r + dr[k]\n            nc = c + dc[k]\n            if A[nr][nc] >= 0 and seen[nr][nc] < 0:\n                seen[nr][nc] = seen[r][c] + 1\n                q.append((nr, nc))\n    return monsters + cnt\n\ndef main():\n    data = sys.stdin.read().splitlines()\n    # Remove empty lines (as the C++ code skips newlines)\n    lines = [line.rstrip('\\n') for line in data if line.strip() != '']\n    if not lines:\n        return\n    first = lines[0].split()\n    N = int(first[0])\n    T = int(first[1])\n    # Initialize arrays with 1-indexed borders\n    A = [[-1] * (N + 2) for _ in range(N + 2)]\n    B = [[-1] * (N + 2) for _ in range(N + 2)]\n    objects = [[[] for _ in range(N + 2)] for _ in range(N + 2)]\n    ZR = ZC = 0\n    idx = 1\n    # Read A grid\n    for i in range(1, N + 1):\n        line = lines[idx]\n        idx += 1\n        for j, ch in enumerate(line, start=1):\n            if ch.isdigit():\n                A[i][j] = int(ch)\n            elif ch == 'Z':\n                ZR, ZC = i, j\n    # Read B grid\n    treasures = 0\n    for i in range(1, N + 1):\n        line = lines[idx]\n        idx += 1\n        for j, ch in enumerate(line, start=1):\n            if ch.isdigit():\n                B[i][j] = int(ch)\n                for _ in range(B[i][j]):\n                    objects[i][j].append(treasures)\n                    treasures += 1\n    # Compute distances from Z\n    F = bfsDist(ZR, ZC, A, N)\n    for i in range(1, N + 1):\n        for j in range(1, N + 1):\n            if F[i][j] < 0:\n                F[i][j] = INF\n    # Build graph\n    graph = []\n    monsters = 0\n    for i in range(1, N + 1):\n        for j in range(1, N + 1):\n            if A[i][j] > 0:\n                cnt = A[i][j]\n                # Ensure graph has enough lists for new monster nodes\n                while len(graph) < monsters + cnt:\n                    graph.append([])\n                monsters = linkMonsters(i, j, cnt, A, F, objects, graph, monsters, T)\n    # Maximum bipartite matching\n    matcher = Hungarian()\n    result = matcher.solve(monsters, graph, treasures)\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.3378546504536644e-06, 0.0, 0.0, -0.00043466180795803666, -0.00013219437096267939, 0.0, -3.6477376852417365e-05, -1.156323378381785e-05, -1.1920928244535389e-07, 0.0, 0.0, -5.4834770708112046e-05, -0.10587938129901886, 0.0, -2.9802276912960224e-06, -0.00062851223628968, -5.960462772236497e-07, -3.576278118089249e-07, -2.861018856492592e-06, -0.20146401226520538, -0.37017297744750977, -8.427741704508662e-05, -5.125986263010418e-06, -1.1920928244535389e-07, -1.8596476365928538e-05, -1.1920928244535389e-07, -0.08516667038202286, -0.10248765349388123, -5.209310256759636e-05, -0.0002040654799202457, -6.9141146923357155e-06, -9.536738616588991e-07, -1.6689160474925302e-05, -3.576278118089249e-07, -1.1920928244535389e-07, -8.344646857949556e-07, -8.344646857949556e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, 0.0, -4.005352093372494e-05, -1.1920928244535389e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -1.4305104514278355e-06, 0.0, -4.768370445162873