nt)q.size()) {\n        int cur = q[head++];\n        int r = cur / W, c = cur % W;\n        if (D1[cur] >= 0 && D2[cur] >= D1[cur]) continue;\n        for (int k = 0; k < 4; ++k) {\n            int nr = r + dr[k], nc = c + dc[k];\n            if (B[nr][nc] != '.') continue;\n            int ni = idx(nr, nc);\n            if (D2[ni] != -1) continue;\n            if (D1[ni] >= 0 && D1[ni] < D2[cur] + 1) continue;\n            D2[ni] = D2[cur] + 1;\n            q.push_back(ni);\n        }\n    }\n}\n\nint max_flow(int s, int t, vector<vector<int> > cap) {\n    int n = (int)cap.size();\n    int flow = 0;\n    while (true) {\n        vector<int> pre(n, -1);\n        vector<int> q;\n        q.reserve(n);\n        int head = 0;\n        pre[s] = s;\n        q.push_back(s);\n        while (head < (int)q.size() && pre[t] == -1) {\n            int u = q[head++];\n            for (int v = 0; v < n; ++v) {\n                if (pre[v] == -1 && cap[u][v] > 0) {\n                    pre[v] = u;\n                    q.push_back(v);\n                    if (v == t) break;\n                }\n            }\n        }\n        if (pre[t] == -1) break;\n        int add = INT_MAX;\n        for (int v = t; v != s; v = pre[v])\n            add = min(add, cap[pre[v]][v]);\n        for (int v = t; v != s; v = pre[v]) {\n            cap[pre[v]][v] -= add;\n            cap[v][pre[v]] += add;\n        }\n        flow += add;\n    }\n    return flow;\n}\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> N >> T;\n    W = N + 2;\n\n    B.assign(W, string(W, '#'));\n    string line;\n    for (int r = 1; r <= N; ++r) {\n        cin >> line;\n        for (int c = 1; c <= N; ++c) B[r][c] = line[c - 1];\n    }\n    vector<string> B1 = B;\n\n    vector<string> B2(W, string(W, '#'));\n    for (int r = 1; r <= N; ++r) {\n        cin >> line;\n        for (int c = 1; c <= N; ++c) B2[r][c] = line[c - 1];\n    }\n\n    vector<Pos> scientists, capsules;\n    Pos z;\n