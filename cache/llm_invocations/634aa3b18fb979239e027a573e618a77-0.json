{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates Python code to GNU C++11 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following Python 2 code to GNU C++11 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original Python 2 code you have to translate:\n<original_code>\n<your_rewritten_code_1>\nall_cache = {}\nlimit_cache = {}\nn, m = 0, 0\n\ndef searchall(lo, hi):\n    if lo == hi:\n        return 1\n    if (lo, hi) in all_cache:\n        return all_cache[(lo, hi)]\n    all_cache[(lo, hi)] = 0\n    all_cache[(lo, hi)] += searchall(lo + 1, hi)\n    all_cache[(lo, hi)] += searchall(lo, hi - 1)\n    for i in range(lo + 1, hi):\n        all_cache[(lo, hi)] += searchall(lo, i - 1) * searchall(i + 1, hi)\n    return all_cache[(lo, hi)]\n\ndef searchlimit(lo, hi, depth):\n    global m\n    if lo == hi:\n        if depth < m:\n            return 1\n        else:\n            return 0\n    if (lo, hi, depth) in limit_cache:\n        return limit_cache[(lo, hi, depth)]\n    limit_cache[(lo, hi, depth)] = 0\n    limit_cache[(lo, hi, depth)] += searchlimit(lo + 1, hi, depth + 1)\n    limit_cache[(lo, hi, depth)] += searchlimit(lo, hi - 1, depth + 1)\n    for i in range(lo + 1, hi):\n        limit_cache[(lo, hi, depth)] += searchlimit(lo, i - 1, depth + 1) * searchlimit(i + 1, hi, depth + 1)\n    return limit_cache[(lo, hi, depth)]\n\ndef main():\n    global n, m\n    n, m = map(int, input().rstrip().split())\n    ret = searchall(1, n) - searchlimit(1, n, 1)\n    print(ret)\n\nif __name__ == \"__main__\":\n    main()\n</your_rewritten_code_1>\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <map>\n#include <vector>\n#include <string>\n#include <sstream>\n\nusing namespace std;\n\nmap<pair<int, int>, long long> all_cache;\nmap<tuple<int, int, int>, long long> limit_cache;\nint n, m;\n\nlong long searchall(int lo, int hi) {\n    if (lo == hi) {\n        return 1;\n    }\n    pair<int, int> key = make_pair(lo, hi);\n    if (all_cache.find(key) != all_cache.end()) {\n        return all_cache[key];\n    }\n    all_cache[key] = 0;\n    all_cache[key] += searchall(lo + 1, hi);\n    all_cache[key] += searchall(lo, hi - 1);\n    for (int i = lo + 1; i < hi; i++) {\n        all_cache[key] += searchall(lo, i - 1) * searchall(i + 1, hi);\n    }\n    return all_cache[key];\n}\n\nlong long searchlimit(int lo, int hi, int depth) {\n    if (lo == hi) {\n        if (depth < m) {\n            return 1;\n        } else {\n            return 0;\n        }\n    }\n    tuple<int, int, int> key = make_tuple(lo, hi, depth);\n    if (limit_cache.find(key) != limit_cache.end()) {\n        return limit_cache[key];\n    }\n    limit_cache[key] = 0;\n    limit_cache[key] += searchlimit(lo + 1, hi, depth + 1);\n    limit_cache[key] += searchlimit(lo, hi - 1, depth + 1);\n    for (int i = lo + 1; i < hi; i++) {\n        limit_cache[key] += searchlimit(lo, i - 1, depth + 1) * searchlimit(i + 1, hi, depth + 1);\n    }\n    return limit_cache[key];\n}\n\nint main() {\n    string line;\n    getline(cin, line);\n    stringstream ss(line);\n    ss >> n >> m;\n    \n    long long ret = searchall(1, n) - searchlimit(1, n, 1);\n    cout << ret << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</conf