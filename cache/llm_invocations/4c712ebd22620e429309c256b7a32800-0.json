   long res = 0;\n        for (int i = 0; i < base; i++) {\n            long term = mul(fastPow(base - i, exp), nCr(base, i));\n            res = (i % 2 == 0) ? add(res, term) : sub(res, term);\n        }\n        return res;\n    }\n\n    private static void init() {\n        fact = new long[1_000_000];\n        invFact = new long[1_000_000];\n        fact[0] = invFact[0] = 1;\n        for (int i = 1; i < 1_000_000; i++) {\n            fact[i] = mul(fact[i - 1], i);\n        }\n        invFact[999999] = fastPow(fact[999999], MOD - 2);\n        for (int i = 999998; i >= 0; i--) {\n            invFact[i] = mul(invFact[i + 1], i + 1);\n        }\n    }\n\n    private static long nCr(int n, int r) {\n        return mul(fact[n], mul(invFact[r], invFact[n - r]));\n    }\n\n    private static long add(long a, long b) {\n        return (a + b) % MOD;\n    }\n\n    private static long sub(long a, long b) {\n        return ((a - b) % MOD + MOD) % MOD;\n    }\n\n    private static long mul(long a, long b) {\n        return (a * b) % MOD;\n    }\n\n    private static long fastPow(long base, long exp) {\n        if (exp == 0) return 1;\n        long half = fastPow(base, exp >> 1);\n        long sq = mul(half, half);\n        return (exp & 1) == 1 ? mul(sq, base) : sq;\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "qwen/qwen3-coder-next"}, "response": {"samples": [{"content": "<translated_code>\n#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\n#include <cmath>\n\nusing namespace std;\n\nconst long long MOD = 998244353;\nvector<long long> fact;\nvector<long long> invFact;\n\nlong long add(long long a, long long b) {\n    return (a + b) % MOD;\n}\n\nlong long sub(long long a, long long b) {\n    return ((a - b) % MOD + MOD) % MOD;\n}\n\nlong long mul(long long a, long long b) {\n    return (a * b) % MOD;\n}\n\nlong long fastPow(long long base, long long exp) {\n    if (exp == 0) return 1;\n    long long half = fastPow(base, exp >> 1);\n    long long sq = mul(half, half);\n    return (exp & 1) == 1 ? mul(sq, base) : sq;\n}\n\nlong long nCr(int n, int r) {\n    return mul(fact[n], mul(invFact[r], invFact[n - r]));\n}\n\nlong long computeInclusionExclusion(int base, long long exp) {\n    long long res = 0;\n    for (int i = 0; i < base; i++) {\n        long long term = mul(fastPow(base - i, exp), nCr(base, i));\n        if (i % 2 == 0) {\n            res = add(res, term);\n        } else {\n            res = sub(res, term);\n        }\n    }\n    return res;\n}\n\nvoid init() {\n    fact.resize(1000000);\n    invFact.resize(1000000);\n    fact[0] = 1;\n    invFact[0] = 1;\n    for (int i = 1; i < 1000000; i++) {\n        fact[i] = mul(fact[i - 1], i);\n    }\n    invFact[999999] = fastPow(fact[999999], MOD - 2);\n    for (int i = 999998; i >= 0; i--) {\n        invFact[i] = mul(invFact[i + 1], i + 1);\n    }\n}\n\nint main() {\n    init();\n    try {\n        string line;\n        getline(cin, line);\n        istringstream iss(line);\n        int n, k;\n        iss >> n >> k;\n        \n        if (k == 0) {\n            cout << fact[n] << endl;\n            return 0;\n        }\n        if (k >= n) {\n            cout << 0 << endl;\n            return 0;\n        }\n        int usable = n - k;\n        long long assignments = computeInclusionExclusion(usable, n);\n        long long combinations = nCr(n, usable);\n        long long total = mul(assignments, combinations);\n        cout << mul(total, 2) << endl;\n    } catch (...) {\n        cout << 0 << endl;\n    }\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013362467871047556, -9.536738616588991e-07, -4.768370445162873e-07, -0.000446696620201692, -3.576278118089249e-07, -1.3112935448589269e-05, -3.4570634852570947e-06, -2.9802276912960224e-06, -2.3841855067985307e-07, -0.6821438074111938, -4.470248313737102e-05, -9.417489309271332e-06, -4.768370445162873e-07, -0.0063