urn (a % m + m) % m;\n}\n\nbool isPowerOfTwo(int x) {\n    return x != 0 && ((x & (x - 1)) == 0);\n}\n\nbool isprime(int x) {\n    if (x < 2) return false;\n    for (int i = 2; i <= sqrt(x); i++) {\n        if (x % i == 0) return false;\n    }\n    return true;\n}\n\nbool* prime;\nconst int INT_MAX = 1000007;\n\nvoid sieve() {\n    prime = new bool[INT_MAX];\n    memset(prime, true, INT_MAX * sizeof(bool));\n    prime[0] = prime[1] = false;\n    for (int i = 2; i <= sqrt(INT_MAX); i++) {\n        if (prime[i]) {\n            for (int j = i * 2; j < INT_MAX; j += i)\n                prime[j] = false;\n        }\n    }\n}\n\nclass Pair {\npublic:\n    int ff, ss;\n    Pair(int f, int s) : ff(f), ss(s) {}\n};\n\nint main() {\n    FastReader sc;\n    \n    int n = sc.nextInt(), w = sc.nextInt();\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) a[i] = sc.nextInt();\n    \n    int e = 0, o = 0;\n    deque<int> stack;\n    stack.push_front(a[0]);\n    vector<int> cuts;\n    \n    for (int i = 0; i < n - 1; i++) {\n        if ((a[i] & 1) == 0) ++e;\n        else ++o;\n        if (e == o) cuts.push_back(abs(a[i] - a[i + 1]));\n    }\n    \n    n = cuts.size();\n    \n    vector<vector<int>> dp(n + 1, vector<int>(w + 1, 0));\n    \n    for (int i = 0; i <= n; i++) {\n        for (int j = 0; j <= w; j++) {\n            if (i * j == 0) dp[i][j] = 0;\n        }\n    }\n    \n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= w; j++) {\n            if (cuts[i - 1] <= j) {\n                dp[i][j] = max(1 + dp[i - 1][j - cuts[i - 1]], dp[i - 1][j]);\n            } else {\n                dp[i][j] = dp[i - 1][j];\n            }\n        }\n    }\n    \n    int ans = dp[n][w];\n    cout << ans << endl;\n    \n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00013791563105769455, -3.576272320060525e-06, -1.311301275563892e-06, -0.000125281119835563, -4.768370445162873e-07, -0.001046348363161087, -2.7418097943154862e