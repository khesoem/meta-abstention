) {\n                differences.add(Math.abs(arr[i + 1] - arr[i]));\n            }\n        }\n\n        int[] diffArray = new int[differences.size()];\n        for (int i = 0; i < differences.size(); i++) {\n            diffArray[i] = differences.get(i);\n        }\n\n        int[] values = new int[diffArray.length];\n        Arrays.fill(values, 1);\n\n        int[][] dp = new int[diffArray.length + 1][b + 1];\n\n        for (int i = 1; i <= diffArray.length; i++) {\n            for (int w = 0; w <= b; w++) {\n                if (diffArray[i - 1] <= w) {\n                    dp[i][w] = Math.max(values[i - 1] + dp[i - 1][w - diffArray[i - 1]], dp[i - 1][w]);\n                } else {\n                    dp[i][w] = dp[i - 1][w];\n                }\n            }\n        }\n\n        System.out.println(dp[diffArray.length][b]);\n    }\n\n    static class InputReader {\n        private final InputStream stream;\n        private final byte[] buffer = new byte[1024];\n        private int ptr = 0;\n        private int len = 0;\n\n        public InputReader(InputStream stream) {\n            this.stream = stream;\n        }\n\n        private int read() throws IOException {\n            if (ptr >= len) {\n                ptr = 0;\n                len = stream.read(buffer);\n                if (len <= 0) return -1;\n            }\n            return buffer[ptr++];\n        }\n\n        private boolean isWhitespace(int c) {\n            return c <= ' ' || c == -1;\n        }\n\n        public int nextInt() throws IOException {\n            int c;\n            while (isWhitespace(c = read())) {}\n            int sign = 1;\n            if (c == '-') {\n                sign = -1;\n                c = read();\n            }\n            int val = 0;\n            while (!isWhitespace(c)) {\n                val = val * 10 + c - '0';\n                c = read();\n            }\n            return val * sign;\n        }\n\n        public long nextLong() throws IOException {\n    