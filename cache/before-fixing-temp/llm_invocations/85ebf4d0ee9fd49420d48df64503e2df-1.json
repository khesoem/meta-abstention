N\n        self.nxt = [0] * (2 * self.M)\n        self.ep = [0] * (2 * self.M)\n        self.m = 0\n        self.flo = [0] * (2 * self.M)\n        self.cap = [0] * (2 * self.M)\n        self.cost = [0] * (2 * self.M)\n        self.pot = [0] * self.N\n        self.dist = [0] * self.N\n        self.vis = [False] * self.N\n        self.inq = [-1] * self.N\n        self.q = [0] * self.N\n    \n    def add_edge(self, a, b, c=1, p=0):\n        self.nxt[self.m] = self.first[a]\n        self.first[a] = self.m\n        self.ep[self.m] = a\n        self.cap[self.m] = c\n        self.cost[self.m] = p\n        self.flo[self.m] = 0\n        self.m += 1\n        \n        self.nxt[self.m] = self.first[b]\n        self.first[b] = self.m\n        self.ep[self.m] = b\n        self.cap[self.m] = 0\n        self.cost[self.m] = -p\n        self.flo[self.m] = 0\n        self.m += 1\n    \n    def mcf_pot_init(self, n):\n        self.pot = [0] * n\n        for _ in range(n - 1):\n            for e in range(self.m):\n                if self.cap[e]:\n                    u = self.ep[e]\n                    v = self.ep[e ^ 1]\n                    if self.pot[v] > self.pot[u] + self.cost[e]:\n                        self.pot[v] = self.pot[u] + self.cost[e]\n    \n    def mcf_update(self, s, t, price, n):\n        self.vis = [False] * n\n        self.dist = [INF] * n\n        self.dist[s] = 0\n        self.inq = [-1] * n\n        qs = 0\n        self.q[qs] = s\n        self.inq[s] = 0\n        qs += 1\n        \n        while qs:\n            u = self.q[0]\n            self.inq[u] = -1\n            qs -= 1\n            self.q[0] = self.q[qs]\n            if qs:\n                self.inq[self.q[0]] = 0\n            \n            i = 0\n            while 2 * i + 1 < qs:\n                j = 2 * i + 1\n                if j + 1 < qs and self.dist[self.q[j + 1]] < self.dist[self.q[j]]:\n                    j += 1\n                if self.dist[self.q[j]] >= self.dist[self.q[i]]:\n                   