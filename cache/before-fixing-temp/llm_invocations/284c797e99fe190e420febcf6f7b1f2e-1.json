        mat[0][i] = m\n\n    # Determine how many levels of powers are needed\n    ci = 0\n    step = 1\n    while step <= n // base:\n        ci += 1\n        step *= base\n\n    # Build higher\u2011level matrices (same as multiplying base copies of lower level)\n    for i in range(1, ci + 1):\n        for j in range(base):\n            # start with identity matrix\n            m = [[0] * (base + 1) for _ in range(base + 1)]\n            for r in range(base + 1):\n                m[r][r] = 1\n            # multiply by mat[i-1][(j+k)%base] for k = 0..base-1\n            for k in range(base):\n                mat_prev = mat[i - 1][(j + k) % base]\n                tmp = [[0] * (base + 1) for _ in range(base + 1)]\n                for r in range(base + 1):\n                    for c in range(base + 1):\n                        cur = 0\n                        for t in range(base + 1):\n                            cur += m[r][t] * mat_prev[t][c]\n                        tmp[r][c] = cur % MOD\n                m = tmp\n            mat[i][j] = m\n\n    # have = identity matrix\n    have = [[0] * (base + 1) for _ in range(base + 1)]\n    for r in range(base + 1):\n        have[r][r] = 1\n\n    # Process the expansion of n in base, from most significant digit to least\n    cj = 0\n    for level in range(ci, -1, -1):\n        times = (n // step) % base\n        for _ in range(times):\n            mat_cur = mat[level][cj]\n            tmp = [[0] * (base + 1) for _ in range(base + 1)]\n            for r in range(base + 1):\n                for c in range(base + 1):\n                    cur = 0\n                    for t in range(base + 1):\n                        cur += have[r][t] * mat_cur[t][c]\n                    tmp[r][c] = cur % MOD\n            have = tmp\n            cj = (cj + 1) % base\n        step //= base\n\n    # Compute the answer: sum of the last column (index base) modulo MOD\n    ret = 0\n    for r in range(base + 1):\n        ret = (ret + have[r][base]) % MO