 = new HashSet<>();\n\n        // Recursive function to generate subset sums\n        class F {\n            void compute(Set<Integer> set, int[] arr, int index, int limit, int sum) {\n                if (index == limit) {\n                    set.add(sum);\n                } else {\n                    compute(set, arr, index + 1, limit, (sum + arr[index]) % m);\n                    compute(set, arr, index + 1, limit, sum);\n                }\n            }\n        }\n\n        F func = new F();\n\n        int h = n / 2;\n        func.compute(x, a, 0, h, 0);\n        func.compute(y, a, h, n, 0);\n\n        List<Integer> yList = new ArrayList<>(y);\n        Collections.sort(yList);\n\n        int maxSum = 0;\n        for (int i : x) {\n            int target = m - i;\n            int idx = Collections.binarySearch(yList, target);\n            int index;\n            if (idx < 0) {\n                index = -idx - 1;\n            } else {\n                index = idx;\n            }\n\n            if (index > 0) {\n                int candidate = i + yList.get(index - 1);\n                if (candidate > maxSum) {\n                    maxSum = candidate;\n                }\n            }\n        }\n\n        System.out.println(maxSum);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00081963452976197, -0.0001984146365430206, -5.512236498361744e-07, -1.9862216504407115e-05, -3.054500666621607e-06, -3.128163257315464e-07, -2.4391956685576588e-05, -0.062104031443595886, -0.2527255713939667, -6.869017852295656e-06, -0.0336734801530838, -0.000630947935860604, -2.45848218582978e-06, -4.320199877838604e-07, -0.00026777281891554594, -0.00193458900321275, -0.00013488641707226634, -0.0028278196696192026, 0.0, -3.35706390615087e-05, -6.704273118884885e-07, -1.259079363080673e-05, -1.5048530030981055e-06, -4.320199877838604e-07, -9.782141569303349e-05, -0.12700696289539337, -0.0003392767102923244, -0.00010950337309623137, -5.5122364983617