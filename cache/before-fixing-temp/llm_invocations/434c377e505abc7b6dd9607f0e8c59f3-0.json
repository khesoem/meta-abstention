              if not moge[time][x1][y1][x2][y2]:\n                            continue\n                        for d in range(5):\n                            nx2, ny2 = x2 + dx[d], y2 + dy[d]\n                            if Ok(nx2, ny2) and '0' <= nau[nx2][ny2] <= '9' and odl[x2][y2] >= time + 2 and odl[nx2][ny2] >= time + 2:\n                                moge[time + 1][x1][y1][nx2][ny2] = True\n    \n    a = []\n    for i in range(n):\n        for j in range(n):\n            if '0' <= nau[i][j] <= '9':\n                a.append((i, j))\n    \n    V = 2 * len(a) + 2\n    G = [[] for _ in range(V)]\n    # edges from source and to sink\n    for i in range(len(a)):\n        cap_from = int(nau[a[i][0]][a[i][1]])\n        G[0].append([i + 1, cap_from])\n        G[i + 1].append([0, 0])\n        cap_to = int(pom[a[i][0]][a[i][1]])\n        G[len(a) + 1 + i].append([V - 1, cap_to])\n        G[V - 1].append([len(a) + 1 + i, 0])\n    # edges between nodes if reachable\n    for i in range(len(a)):\n        for j in range(len(a)):\n            ok = False\n            for k in range(t):\n                if moge[k][a[i][0]][a[i][1]][a[j][0]][a[j][1]]:\n                    ok = True\n                    break\n            if ok:\n                G[i + 1].append([len(a) + 1 + j, INF])\n                G[len(a) + 1 + j].append([i + 1, 0])\n    \n    # max flow (Edmonds-Karp)\n    total_flow = 0\n    while True:\n        vis = [False] * V\n        parent = [-1] * V\n        q2 = deque()\n        vis[0] = True\n        q2.append(0)\n        while q2:\n            u = q2.popleft()\n            for v, cap in G[u]:\n                if not vis[v] and cap > 0:\n                    vis[v] = True\n                    parent[v] = u\n                    q2.append(v)\n        if parent[V - 1] == -1:\n            break\n        # reconstruct path\n        path = []\n        cur = V - 1\n        while cur != -1:\n            path.append(cur)\n            cur = parent[cur]\n        path.reverse()\n        # find bottleneck\n        flow = INF\n        for i in range(len(path) - 1):\n            u, v = path[i], path[i + 1]\n            for edge in G[u]:\n                if edge[0] == v:\n                    flow = min(flow, edge[1])\n                    break\n        total_flow += flow\n        # update capacities\n        for i in range(len(path) - 1):\n            u, v = path[i], path[i + 1]\n            for edge in G[u]:\n                if edge[0] == v:\n                    edge[1] -= flow\n                    break\n        for i in range(1, len(path)):\n            u, v = path[i], path[i - 1]\n            for edge in G[u]:\n                if edge[0] == v:\n                    edge[1] += flow\n                    break\n    print(total_flow)\n\nif __name__ == \"__main__\":\n    solve()\n```\n\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-4.7730985, -3.8384653e-05, -0.00076145737, -0.010169123, -0.00018666433, -0.0040985877, -0.0002424423, -0.000115149545, -3.576278e-07, -4.875541e-05, -0.0033649749, -0.087878786, -0.65581715, -0.38691548, -1.442422e-05, -9.6316464e-05, -2.384183e-06, -1.6689287e-06, -1.1706129, -0.06198487, -1.4305105e-06, -9.894322e-06, -2.7418098e-06, -0.000109547334, -1.41858045e-05, -0.31327778, -2.1269708, -9.9296405e-05, -0.0004321595, -1.0827632, -8.344647e-07, -7.486063e-05, -1.7881378e-06, -1.1920928e-07, -0.0015243589, -0.06197557, -0.025714941, -0.31153643, -7.092701e-05, -2.0503787e-05, -1.6689287e-06, -4.7683704e-07, -7.152555e-07, -2.0265559e-06, -1.3113013e-06, -1.1920928e-07, -0.00033599453, -0.0019350392, -0.038045317, -0.0010648064, -8.0224636e-05, -0.100310326, -0.023450414, -4.7563375e-05, -4.7683704e-07, -0.0067232824, -0.02975169, -1.5020258e-05, -7.152555e-07, -1.1920928e-07, -4.7683704e-07, -2.3841855e-07, -9.5367386e-07, -8.63038e-05, -1.072883e-06, -4.887569e-06, -4.1841584e-05, -2.3841574e-05, -0.0002038271, -5.960463e-07, 0.0, -2.264974e-06, 0.0, -4.7683704e-07, -1.1920928e-07, 0.0, -1.788137