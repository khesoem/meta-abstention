t = MAX_SIZE - 2\n\n    x = y = 0\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if g1[i][j] == 'Z':\n                x, y = i, j\n                break\n        if x:\n            break\n\n    visited = [[False] * 14 for _ in range(14)]\n    dist = [[111] * 14 for _ in range(14)]\n    bfs_start(x, y, n, g1, visited, dist)\n\n    tgt = [0] * (n * n + 1)\n    for i in range(1, n * n + 1):\n        tgt[i] = MAX_SIZE - 3 - (n * n - i)\n\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if '0' <= g1[i][j] <= '9':\n                mf.addedge(mf.s, index_func(0, i, j, n), ord(g1[i][j]) - ord('0'))\n            if '0' <= g2[i][j] <= '9':\n                mf.addedge(tgt[index_func(0, i, j, n)], mf.t, ord(g2[i][j]) - ord('0'))\n            mf.addedge(index_func(0, i, j, n), tgt[index_func(0, i, j, n)], 10**9)\n\n    dx = [1, 0, 0, -1]\n    dy = [0, 1, -1, 0]\n    for time in range(1, t + 1):\n        for i in range(1, n + 1):\n            for j in range(1, n + 1):\n                if g1[i][j] in ('Y', 'Z'):\n                    continue\n                for k in range(4):\n                    tx = i + dx[k]\n                    ty = j + dy[k]\n                    if 1 <= tx <= n and 1 <= ty <= n and g1[tx][ty] not in ('Y', 'Z'):\n                        if dist[i][j] >= time and dist[tx][ty] >= time:\n                            mf.addedge(index_func(time - 1, tx, ty, n), index_func(time, i, j, n), 10**9)\n                mf.addedge(index_func(time, i, j, n), tgt[index_func(0, i, j, n)], 10**9)\n\n    print(mf.dinic())\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-7.867782e-06, 0.0, -1.1920928e-07, -0.0007215519, -0.26650304, -0.001255082, -0.0042062625, -0.015572027, -0.0003057251, -3.576278e-07, -0.00015889335, -0.03868753, -2.19902, -0.0012209112, -0.018150078, -9.536698e-06, -1.2278481e-05, -1.5065254, -0.00523743, -3.81469e-06, -2.9802277