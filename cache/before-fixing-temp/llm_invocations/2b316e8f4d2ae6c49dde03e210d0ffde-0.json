  if par[i] == -1 and cap[v][i] > 0:\n                par[i] = v\n                qu.append(i)\n    return par[t_node] != -1\n\ndef main():\n    global n, t, rx, ry, lab, sci, mem, cap, par, dist, vis\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    first = data[0].split()\n    n = int(first[0])\n    t = int(first[1])\n    sci = []\n    for i in range(1, n+1):\n        sci.append(data[i].strip())\n    lab = []\n    for i in range(n+1, 2*n+1):\n        lab.append(data[i].strip())\n    pos = []\n    lc = []\n    sc = []\n    for i in range(n):\n        for j in range(n):\n            if sci[i][j] == 'Z':\n                rx = i\n                ry = j\n            elif '0' <= sci[i][j] <= '9':\n                pos.append((i, j))\n                lc.append(ord(lab[i][j]) - ord('0'))\n                sc.append(ord(sci[i][j]) - ord('0'))\n    m = len(pos)\n    # allocate mem with size 12 as in original (since indices up to 11)\n    # but we may need larger if n > 12, but original code assumes n <= 12.\n    # We'll allocate based on n for safety, but to match exactly, use 12.\n    mem = [[[[[-1 for _ in range(62)] for _ in range(12)] for _ in range(12)] for _ in range(12)] for _ in range(12)]\n    cap = [[0]*250 for _ in range(250)]\n    for i in range(m):\n        cap[0][i+1] = sc[i]\n        cap[m+1+i][2*m+1] = lc[i]\n    pre()\n    # reset mem\n    for a in range(12):\n        for b in range(12):\n            for c in range(12):\n                for d in range(12):\n                    for e in range(62):\n                        mem[a][b][c][d][e] = -1\n    for i in range(m):\n        for j in range(m):\n            if dfs(pos[i][0], pos[i][1], pos[j][0], pos[j][1], 0):\n                cap[i+1][m+1+j] = 1000\n    flow = 0\n    N = 2*m + 1\n    while fml(0, N):\n        t_node = N\n        nflow = 10**6\n        while par[t_node] >= 0:\n            nflow = min(nflow, cap[par[t_node]][t_node])\n            t_node = par[t_node]\n        t