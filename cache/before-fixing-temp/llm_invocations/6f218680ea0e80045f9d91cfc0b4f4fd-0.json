ct(BigInteger.ONE);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        String[] input = sc.nextLine().split(\" \");\n        int h = Integer.parseInt(input[0]);\n        int n = Integer.parseInt(input[1]);\n        BigInteger bigN = BigInteger.valueOf(n);\n        BigInteger l = BigInteger.ONE;\n        BigInteger r = BigInteger.valueOf(2).pow(h);\n        int b = h;\n        String dir = \"L\";\n        BigInteger ans = BigInteger.ZERO;\n        BigInteger two = BigInteger.TWO;\n\n        for (int i = 0; i < h; i++) {\n            BigInteger sum = l.add(r);\n            BigInteger twoN = bigN.multiply(two);\n            if (dir.equals(\"L\")) {\n                if (twoN.compareTo(sum) > 0) { // n > (l+r)/2\n                    ans = ans.add(cnt_res(b)).add(BigInteger.ONE);\n                    l = sum.divide(two).add(BigInteger.ONE);\n                } else if (twoN.compareTo(sum) < 0) { // n < (l+r)/2\n                    int parity = sum.testBit(0) ? 1 : 0; // 1 if odd\n                    r = sum.divide(two).add(BigInteger.valueOf(parity)).subtract(BigInteger.ONE);\n                    ans = ans.add(BigInteger.ONE);\n                    dir = \"R\";\n                }\n            } else { // dir == \"R\"\n                if (twoN.compareTo(sum) < 0) { // n < (l+r)/2\n                    ans = ans.add(cnt_res(b)).add(BigInteger.ONE);\n                    int parity = sum.testBit(0) ? 1 : 0;\n                    r = sum.divide(two).add(BigInteger.valueOf(parity)).subtract(BigInteger.ONE);\n                } else if (twoN.compareTo(sum) > 0) { // n > (l+r)/2\n                    ans = ans.add(BigInteger.ONE);\n                    l = sum.divide(two).add(BigInteger.ONE);\n                    dir = \"L\";\n                }\n            }\n            b--;\n        }\n\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1920928244535389e-