     static final int M = 2 * N * C + N + 7;\n        static int[] par = new int[N];\n        static int[] first = new int[N];\n        static int[] nxt = new int[2 * M];\n        static int[] ep = new int[2 * M];\n        static int m;\n        static long[] flo = new long[2 * M];\n        static long[] cap = new long[2 * M];\n        static long[] cost = new long[2 * M];\n\n        static void init() {\n            m = 0;\n            Arrays.fill(first, -1);\n            Arrays.fill(flo, 0);\n        }\n\n        static void addEdge(int a, int b, long c, long p) {\n            nxt[m] = first[a];\n            ep[m] = a;\n            first[a] = m;\n            cap[m] = c;\n            cost[m] = p;\n            ++m;\n\n            nxt[m] = first[b];\n            ep[m] = b;\n            first[b] = m;\n            cap[m] = 0;\n            cost[m] = -p;\n            ++m;\n        }\n\n        static int[] q = new int[N];\n        static int[] inq = new int[N];\n        static boolean[] vis = new boolean[N];\n        static long[] pot = new long[N];\n        static long[] dist = new long[N];\n\n        static void mcfPotInit() {\n            Arrays.fill(pot, 0);\n            for (int k = 1; k < N; ++k) {\n                for (int e = 0; e < m; ++e) {\n                    if (cap[e] > 0) {\n                        int u = ep[e];\n                        int v = ep[e ^ 1];\n                        if (pot[v] > pot[u] + cost[e]) {\n                            pot[v] = pot[u] + cost[e];\n                        }\n                    }\n                }\n            }\n        }\n\n        static long mcfUpdate(int s, int t, long[] price) {\n            Arrays.fill(vis, false);\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            Arrays.fill(inq, -1);\n            int qs = 0;\n            inq[q[qs++] = s] = 0;\n\n            while (qs > 0) {\n                int u = q[0];\n                inq[u] = -1;\n                q[0] = q[--qs];\n                if (qs > 0) inq[q[0]] = 0;\n                for (int i = 0, j = 2 * i + 1; j < qs; i = j, j = 2 * i + 1) {\n                    if (j + 1 < qs && dist[q[j + 1]] < dist[q[j]]) j++;\n                    if (dist[q[j]] >= dist[q[i]]) break;\n                    int temp = q[i]; q[i] = q[j]; q[j] = temp;\n                    temp = inq[q[i]]; inq[q[i]] = inq[q[j]]; inq[q[j]] = temp;\n                }\n                if (vis[u]) continue;\n                vis[u] = true;\n                for (int e = first[u]; e != -1; e = nxt[e]) {\n                    int v = ep[e ^ 1];\n                    if (flo[e] < cap[e] && dist[v] > dist[u] + pot[u] - pot[v] + cost[e]) {\n                        dist[v] = dist[u] + pot[u] - pot[v] + cost[e];\n                        par[v] = e;\n                        if (inq[v] < 0) {\n                            inq[q[qs] = v] = qs;\n                            qs++;\n                        }\n                        for (int i = inq[v], j = (i - 1) / 2; dist[q[i]] < dist[q[j]]; i = j, j = (i - 1) / 2) {\n                            int temp = q[i]; q[i] = q[j]; q[j] = temp;\n                            temp = inq[q[i]]; inq[q[i]] = inq[q[j]]; inq[q[j]] = temp;\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] >= INF) return 0;\n            long df = INF;\n            for (int e, i = t; i != s; i = ep[e]) {\n                e = par[i];\n                df = Math.min(df, cap[e] - flo[e]);\n            }\n            for (int e, i = t; i != s; i = ep[e]) {\n                e = par[i];\n                flo[e] += df;\n                flo[e ^ 1] -= df;\n                price[0] += df * cost[e];\n            }\n            for (int i = 0; i < N; ++i) {\n                pot[i] = Math.min(INF, dist[i] + pot[i]);\n            }\n            return df;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int source = 0;\n        int sink = n * T + 1;\n        Flow.init();\n\n        for (int i = 0; i < k; i++) {\n            int a = sc.nextInt();\n            Flow.addEdge(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; t++) {\n            Flow.addEdge(1 + t * n, sink, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; i++) {\n                    Flow.addEdge(i + (t - 1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            int a = sc.nextInt();\n            int b = sc.nextInt();\n            for (int j = 0; j < C; j++) {\n                long cost = (long)(j + 1) * (j + 1) - (long)j * j;\n                for (int t = 1; t < T; t++) {\n                    Flow.addEdge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                    Flow.addEdge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n\n        Flow.mcfPotInit();\n        long[] price = new long[1];\n        long flow = 0;\n        long df;\n        while ((df = Flow.mcfUpdate(source, sink, price)) != 0) {\n            flow += df;\n        }\n        // assert(flow == k);\n        System.out.println(price[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.1563234e-05, 0.0, 0.0, -4.8517002e-05, -0.0007457336, -1.1920922e-06, -0.2014182, -0.16042669, -3.981511e-05, -3.3378547e-06, -0.86490345, -0.017828448, -0.018613081, -0.0017467969, -1.7881378e-06, -0.0018635303, -0.008637331, -0.0142067, -2.8188388, -3.635817e-05, -0.011082051, -0.06600399, -0.049754456, -6.7949063e-06, 0.0, -1.4781843e-05, -6.2940526e-05, -2.3841855e-07, -2.503392e-06, -1.1920928e-07, -1.1920928e-07, -3.576278e-07, -3.0994368e-06, -1.060957e-05, -1.1920928e-07, -1.0490363e-05, -0.12694265, -0.57594585, -0.0058