250094400L; ans[15][15]=0;\n        ans[16][1]=255; ans[16][2]=18207; ans[16][3]=642447; ans[16][4]=14084415; ans[16][5]=216899991;\n        ans[16][6]=2530499895L; ans[16][7]=23518156167L; ans[16][8]=180305863947L; ans[16][9]=1168649118175L; ans[16][10]=6511045086975L;\n        ans[16][11]=31479019635375L; ans[16][12]=132211882468575L; ans[16][13]=476432168185575L; ans[16][14]=1409850293610375L;\n        ans[17][1]=288; ans[17][2]=23085; ans[17][3]=909720; ans[17][4]=22174425; ans[17][5]=378261576;\n        ans[17][6]=4873620213L; ans[17][7]=49911657840L; ans[17][8]=421129613025L; ans[17][9]=3003942370000L; ans[17][10]=18451716007725L;\n        ans[17][11]=98815801429800L; ans[17][12]=464342770607625L; ans[17][13]=1912322889603000L;\n        ans[18][1]=323; ans[18][2]=28880; ans[18][3]=1263500; ans[18][4]=34051325; ans[18][5]=639970331;\n        ans[18][6]=9058041608L; ans[18][7]=101671895600L; ans[18][8]=938731990625L; ans[18][9]=7322109526875L; ans[18][10]=49204576020600L;\n        ans[18][11]=288924390600300L; ans[18][12]=1496215594180125L;\n        ans[19][1]=360; ans[19][2]=35700; ans[19][3]=1724800; ans[19][4]=51137625; ans[19][5]=1053844176;\n        ans[19][6]=16309493200L; ans[19][7]=199708080000L; ans[19][8]=2008002335625L; ans[19][9]=17037595575000L; ans[19][10]=124510748462100L;\n        ans[19][11]=795771174744000L;\n        ans[20][1]=399; ans[20][2]=43659; ans[20][3]=2318239; ans[20][4]=75274584; ans[20][5]=1693678140;\n        ans[20][6]=28541613100L; ans[20][7]=379694987100L; ans[20][8]=4140135724725L; ans[20][9]=38044950918975L; ans[20][10]=300900975450075L;\n\n        // Precompute ncr\n        for (int a = 0; a < 40; a++) {\n            for (int b = 0; b < 40; b++) {\n                if (b > a) {\n                    ncr[a][b] = 0;\n                } else if (b == 0 || b == a) {\n                    ncr[a][b] = 1;\n                } else {\n                    ncr[a][b] = ncr[a-1][b-1] + ncr[a-1][b];\n                }\n            }\n        }\n\n        long R = sc.nextLong();\n        long C = sc.nextLong();\n        String str = sc.next();\n        long n = R + C;\n\n        long[][] blockarea = new long[(int)n][(int)n];\n        long[][] totalarea = new long[(int)n+1][(int)n+1];\n        for (int a = 0; a < n; a++) {\n            for (int b = 0; b < n; b++) {\n                blockarea[a][b] = ncr[a][(int)R-1] * ncr[b][(int)R-1];\n            }\n        }\n\n        for (int a = 0; a <= n; a++) {\n            for (int b = 0; b <= n; b++) {\n                totalarea[a][b] = 0;\n                if (a == 0 || b == 0) continue;\n                totalarea[a][b] = totalarea[a][b-1] + totalarea[a-1][b] - totalarea[a-1][b-1] + blockarea[a-1][b-1];\n            }\n        }\n\n        long[][] revarea = new long[(int)n+1][(int)n+1];\n        for (int a = 0; a <= n; a++) {\n            for (int b = 0; b <= n; b++) {\n                revarea[a][b] = totalarea[(int)n][(int)n] - totalarea[(int)(n-a)][(int)n]\n                               - totalarea[(int)n][(int)(n-b)] + totalarea[(int)(n-a)][(int)(n-b)];\n            }\n        }\n\n        long d = Math.min(2*n-1, n+R-2);\n\n        Map<Long,Long>[][] dp = new HashMap[(int)n+1][(int)n+1];\n        Map<Long,Long>[][] bp = new HashMap[(int)n+1][(int)n+1];\n        for (int i = 0; i <= n; i++) {\n            for (int j = 0; j <= n; j++) {\n                dp[i][j] = new HashMap<>();\n                bp[i][j] = new HashMap<>();\n            }\n        }\n        dp[0][0].put(0L, 1L);\n        bp[0][0].put(0L, 1L);\n\n        long best = ans[(int)R][(int)C];\n        long m1 = (-best + totalarea[(int)n][(int)n]) / 2;\n        long m2 = totalarea[(int)n][(int)n] - m1;\n        long bestfreq = 0;\n\n        for (int x = 0; x <= n; x++) {\n            // Move right (increase y)\n            for (int y = 0; y < n; y++) {\n                if (x+y+1 <= d && str.charAt(x+y) != 'B') {\n                    for (Map.Entry<Long,Long> it : dp[x][y].entrySet()) {\n                        long area2 = it.getKey() + totalarea[(int)n][y+1] - totalarea[x][y+1];\n                        if (area2 > m2) continue;\n                        dp[x][y+1].put(it.getKey(), dp[x][y+1].getOrDefault(it.getKey(), 0L) + it.getValue());\n                    }\n                }\n                if (x+y+1 <= 2*n-d && str.charAt((int)(n-x+n-y-1)) != 'B') {\n                    for (Map.Entry<Long,Long> it : bp[x][y].entrySet()) {\n                        long area2 = totalarea[(int)n][(int)n] - it.getKey() - totalarea[(int)(n-x)][(int)(n-(y+1))];\n                        if (area2 > m2) continue;\n                        bp[x][y+1].put(it.getKey(), bp[x][y+1].getOrDefault(it.getKey(), 0L) + it.getValue());\n                    }\n                }\n            }\n            if (x == n) continue;\n\n            // Move down (increase x)\n            for (int y = 0; y <= n; y++) {\n                if (x+y+1 <= d && str.charAt(x+y) != 'A') {\n                    long newarea = totalarea[x+1][y] - totalarea[x][y];\n                    for (Map.Entry<Long,Long> it : dp[x][y].entrySet()) {\n                        long c = it.getKey() + newarea;\n                        long area2 = totalarea[x+1][(int)n] - c;\n                        if (area2 > m2) continue;\n                        dp[x+1][y].put(c, dp[x+1][y].getOrDefault(c, 0L) + it.getValue());\n                    }\n                }\n                if (x+y+1 <= 2*n-d && str.charAt((int)(n-x+n-y-1)) != 'A') {\n                    long newarea2 = totalarea[(int)(n-x)][(int)(n-y)] - totalarea[(int)(n-x-1)][(int)(n-y)];\n                    for (Map.Entry<Long,Long> it : bp[x][y].entrySet()) {\n                        if (it.getKey() + newarea2 > m2) continue;\n                        bp[x+1][y].put(it.getKey() + newarea2, bp[x+1][y].getOrDefault(it.getKey() + newarea2, 0L) + it.getValue());\n                    }\n                }\n                if (x+y+1 <= d) dp[x][y].clear();\n                if (x+y+1 <= 2*n-d) bp[x][y].clear();\n            }\n        }\n\n        // Combine results\n        for (int x = 0; x <= n; x++) {\n            long y = d - x;\n            if (y < 0 || y > n) continue;\n            for (Map.Entry<Long,Long> it : dp[x][(int)y].entrySet()) {\n                long c = it.getKey();\n                long freq = it.getValue();\n                bestfreq += freq * bp[(int)(n-x)][(int)(n-y)].getOrDefault(m1 - c, 0L);\n                if (m1 != m2) bestfreq += freq * bp[(int)(n-x)][(int)(n-y)].getOrDefault(m2 - c, 0L);\n            }\n        }\n\n        System.out.println(bestfreq);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": null, "tokens": null}]}, "invocation_time": 1789998428.0398622}