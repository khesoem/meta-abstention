ger> q = new LinkedList<>();\n        q.add(s);\n        dis[s] = 0;\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != 0; i = e_next[i]) {\n                int v = e_to[i];\n                if (e_val[i] > 0 && dis[v] > dis[u] + e_w[i]) {\n                    dis[v] = dis[u] + e_w[i];\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.add(v);\n                    }\n                }\n            }\n        }\n        return dis[t] < Integer.MAX_VALUE;\n    }\n    \n    static int[] mcmf() {\n        int flow = 0, cost = 0;\n        while (SPFA()) {\n            int f = Integer.MAX_VALUE;\n            for (int x = t; x != s; x = e_to[pre[x] ^ 1]) {\n                f = Math.min(f, e_val[pre[x]]);\n            }\n            for (int x = t; x != s; x = e_to[pre[x] ^ 1]) {\n                e_val[pre[x]] -= f;\n                e_val[pre[x] ^ 1] += f;\n            }\n            flow += f;\n            cost += dis[t] * f;\n        }\n        return new int[]{cost, flow};\n    }\n    \n    static int P(int i, int j) {\n        return i * n + j;\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        \n        int cs = 2 * k;\n        tot = cs * n;\n        s = ++tot;\n        t = ++tot;\n        \n        // compute M similarly\n        M = 4 * n * (int)Math.sqrt(n);\n        int size = 2 * M + 5;\n        head = new int[tot + 5];\n        e_to = new int[size];\n        e_next = new int[size];\n        e_val = new int[size];\n        e_w = new int[size];\n        dis = new int[tot + 5];\n        pre = new int[tot + 5];\n        vis = new boolean[tot + 5];\n        \n        for (int i = 1; i <= k; i++) {\n            int tp = sc.nextInt();\n            add(s, P(0, tp), 1, 0);\n        }\n        \n        int[][] E = new int[m + 1][2];\n        for (int i = 1; i <= m; i++) {\n            E[i][0] = sc.nextInt();\n            E[i][1] = sc.nextInt();\n        }\n        \n        for (int i = 1; i <= cs - 1; i++) {\n            add(P(i, 1), t, k, c * i);\n            for (int j = 1; j <= n; j++) {\n                add(P(i - 1, j), P(i, j), k, 0);\n            }\n            for (int j = 1; j <= m; j++) {\n                for (int t = 1; t <= k; t++) {\n                    add(P(i - 1, E[j][0]), P(i, E[j][1]), 1, (2 * t - 1) * d);\n                    add(P(i - 1, E[j][1]), P(i, E[j][0]), 1, (2 * t - 1) * d);\n                }\n            }\n        }\n        \n        int[] res = mcmf();\n        System.out.println(res[0]);\n        sc.close();\n    }\n}\n```", "token_logprobs": [-0.31468185782432556, -0.6940907835960388, -1.6689286894688848e-06, -0.0001591317413840443, -0.00015579440514557064, 0.0, -7.509902934543788e-05, -0.00194110709708184, -0.0004444326623342931, 0.0, -8.082063141046092e-05, -0.005247628316283226, -1.9311717551317997e-05, -0.005403437186032534, -0.003979146480560303, -6.198863957251888e-06, -0.00013743886665906757, -3.40932747349143e-05, -3.576278118089249e-07, -7.629365427419543e-06, -1.1444026313256472e-05, -0.00015245705435518175, -2.0265558760002023e-06, -0.006719611585140228, -2.1272330284118652, -0.003046516329050064, -3.7919304370880127, -0.018466338515281677, -0.1186090037226677, -0.16100165247917175, -0.055719587951898575, -1.5413756370544434, -8.344646857949556e-07, -0.00035470392322167754, -0.4742088317871094, -0.898375391960144, -0.07989770174026489, -0.4768258333206177, -3.576278118089249e-07, -1.680836794548668e-05, -0.00021252757869660854, -0.6932885646820068, -0.008619840256869793, -0.6938260793685913, -3.576278118089249e-07, -0.0005578630371019244, -0.003802689490839839, -0.0011704268399626017, -0.003177833277732134, -3.683499380713329e-05, 