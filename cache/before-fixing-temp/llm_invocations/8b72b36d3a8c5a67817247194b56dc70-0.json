rip().split()\n    if not data:\n        return\n    x, y, n = map(int, data)\n    g = math.gcd(x, y)\n    x //= g\n    y //= g\n    q = x // y\n    r = x % y\n\n    candidates = []  # list of (key, denominator, numerator)\n\n    for b in range(1, n + 1):\n        g = math.gcd(y, b)\n        c = b // g\n        z = y // g\n        t = b * z\n        u = q * t + r * c   # u = x * b // g (exactly, because x = q*y + r)\n        # floor and ceil of u / z\n        a1 = u // z\n        rem = u % z\n        # candidate for floor\n        key_floor = Fraction(rem, t)\n        candidates.append((key_floor, b // g, a1 // g))\n        if rem != 0:\n            a2 = (u + z - 1) // z\n            key_ceil = Fraction(z - rem, t)\n            candidates.append((key_ceil, b // g, a2 // g))\n\n    # sort by key, then denominator, then numerator\n    candidates.sort(key=lambda x: (x[0], x[1], x[2]))\n    # take the first element\n    best = candidates[0]\n    print(f\"{best[2]}/{best[1]}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99</confidence>", "token_logprobs": [-0.0004536076739896089, 0.0, -4.768370445162873e-07, -0.0011818574275821447, -0.00120698066893965, -0.01416344940662384, -0.0031794970855116844, -0.01104797888547182, 0.0, -1.764281842042692e-05, -7.152531907195225e-06, -2.7418097943154862e-06, -2.3841855067985307e-07, -3.576278118089249e-07, -1.7881233361549675e-05, -0.0015326907159760594, -0.029869364574551582, -0.011052694171667099, -5.960446742392378e-06, -0.05516708269715309, -3.576278118089249e-07, -7.986703712958843e-05, 0.0, -0.3132789731025696, -9.63164638960734e-05, -0.25193729996681213, -0.018150078132748604, 0.0, -1.9073468138230965e-06, -4.768370445162873e-07, -0.008664867840707302, -0.0007115454645827413, 0.0, -0.00020394629973452538, -2.3841830625315197e-06, -7.748573807475623e-06, -1.4185804502631072e-05, -2.3841855067985307e-07, -3.6954811548639555e-06, -0.01428003516048193, -1.1920928244535389e-07, -9.536738616588