  dis[s] = 0;\n    vis[s] = true;\n    q.push(s);\n    while(!q.empty())\n    {\n        int u = q.front();\n        q.pop();\n        vis[u] = false;\n        for(int i = head[u]; i != -1; i = edge[i].next)\n        {\n            int v = edge[i].to;\n            if(edge[i].cap > edge[i].flow && dis[v] > dis[u] + edge[i].cost)\n            {\n                dis[v] = dis[u] + edge[i].cost;\n                pre[v] = i;\n                if(!vis[v])\n                {\n                    vis[v] = true;\n                    q.push(v);\n                }\n            }\n        }\n    }\n    if(pre[t] == -1) return false;\n    else return true;\n}\nint minCostMaxflow(int s, int t, int &cost)\n{\n    int flow = 0;\n    cost = 0;\n    while(spfa(s,t))\n    {\n        int Min = INF;\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            if(Min > edge[i].cap - edge[i].flow)\n                Min = edge[i].cap - edge[i].flow;\n        }\n        for(int i = pre[t]; i != -1; i = pre[edge[i^1].to])\n        {\n            edge[i].flow += Min;\n            edge[i^1].flow -= Min;\n            cost +=  edge[i].cost*Min;\n        }\n        flow += Min;\n    }\n    return flow;\n}\nint point(int x, int y){\n    return (x-1)*50+y;\n}\nint main(){\n    int S = 101*55, T = S + 1;\n    n = read(), m = read(), k = read(), c = read(), d = read();\n    int tmp;\n    init(T+1);\n    for(int i = 1; i <= k; i++){\n        tmp = read();\n        addedge(S, tmp, 1, 0);\n    }\n    for(int i = 1; i <= 50; i++){\n        for(int j = 1; j <= 103; j++){\n            int x = point(j, i);\n            int y = point(j+1, i);\n            addedge(x, y, INF, c);\n        }\n    }\n    for(int i = 0; i < 102; i++){\n        int tmp = i*50+1;\n        addedge(tmp, T, INF, 0);\n    }\n    for(int i = 1; i <= m; i++){\n        int u, v;\n        u = read(), v = read();\n        for(int j = 1; j <= 102; j++){\n            int x = point(j, u), x1 = point(j+1, u);\n            int y1 = point(j+1, v), y = point(j, v);\n            for(int k = 0; k < 50; k++){\n                int val = d*(k*2+1)+c;\n                addedge(x, y1, 1, val);\n                addedge(y, x1, 1, val);\n            }\n        }\n    }\n    int cost = 0;\n    minCostMaxflow(S, T, cost);\n    cout << cost << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**18\nmaxm = 2000015\nmaxn = 105 * 55 + 5\n\ndef read_ints():\n    return map(int, sys.stdin.buffer.read().split())\n\ndef init(n):\n    global head, tol, edge\n    head = [-1] * n\n    tol = 0\n    edge = []\n\ndef add_edge(u, v, cap, cost):\n    global tol\n    edge.append([v, head[u], cap, 0, cost])\n    head[u] = tol\n    tol += 1\n    edge.append([u, head[v], 0, 0, -cost])\n    head[v] = tol\n    tol += 1\n\ndef spfa(s, t):\n    dis = [INF] * (N)\n    vis = [False] * (N)\n    pre = [-1] * (N)\n    q = deque()\n    dis[s] = 0\n    vis[s] = True\n    q.append(s)\n    while q:\n        u = q.popleft()\n        vis[u] = False\n        i = head[u]\n        while i != -1:\n            v, next_idx, cap, flow, cost = edge[i]\n            if cap > flow and dis[v] > dis[u] + cost:\n                dis[v] = dis[u] + cost\n                pre[v] = i\n                if not vis[v]:\n                    vis[v] = True\n                    q.append(v)\n            i = next_idx\n    return pre[t] != -1\n\ndef min_cost_maxflow(s, t):\n    flow = 0\n    total_cost = 0\n    while spfa(s, t):\n        Min = INF\n        i = pre[t]\n        while i != -1:\n            cap, flow = edge[i][2], edge[i][3]\n            if Min > cap - flow:\n                Min = cap - flow\n            i = pre[edge[i^1][0]]\n        i = pre[t]\n        while i != -1:\n            edge[i][3] += Min\n            edge[i^1][3] -= Min\n            total_cost += edge[i][4] * Min\n            i = pre[edge[i^1][0]]\n        flow += Min\n    return total_cost\n\ndef point(x, y):\n    return (x - 1) * 50 + y\n\ndef main():\n    it = read_ints()\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    S = 101 * 55\n    T = S + 1\n    N = T + 1\n    init(N)\n    global N\n    for _ in range(k):\n        tmp = next(it)\n        add_edge(S, tmp, 1, 0)\n    for i in range(1, 51):\n        for j in range(1, 104):\n            x = point(j, i)\n            y = point(j + 1, i)\n            add_edge(x, y, INF, c)\n    for i in range(102):\n        tmp = i * 50 + 1\n        add_edge(tmp, T, INF, 0)\n    for _ in range(m):\n        u = next(it); v = next(it)\n        for j in range(1, 103):\n            x = point(j, u)\n            x1 = point(j + 1, u)\n            y = point(j, v)\n            y1 = point(j + 1, v)\n            for kh in range(50):\n                val = d * (2 * kh + 1) + c\n                add_edge(x, y1, 1, val)\n                add_edge(y, x1, 1, val)\n    cost = min_cost_maxflow(S, T)\n    print(cost)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002470903273206204, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.0026052603498101234, -0.00532185984775424, 0.0, -2.1576648578047752e-05, -2.8371408916427754e-05, -4.768370445162873e-07, -3.576278118089249e-07, -2.3841855067985307e-07, -0.0003911683743353933, -0.0352759025990963, -9.643566590966657e-05, -0.0009477414423599839, -0.5895741581916809, -0.061968959867954254, -0.03143473342061043, -1.4215612411499023, -0.42170560359954834, -0.31797027587890625, -0.0005302215577103198, -2.0265558760002023e-06, -8.082063141046092e-05, -0.00017307691450696439, -2.3007127310847864e-05, -0.020838959142565727, -0.0028653775807470083, -6.854299135738984e-05, -0.00011967896716669202, -0.00011598391574807465, -0.003565385239198804, -0.9741132259368896, 0.0, -0.00013481661153491586, -0.64