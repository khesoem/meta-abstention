this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static final int maxn = 6000;\n    static final int inf = Integer.MAX_VALUE;\n    static final long inff = 1000000000000000000L;\n    static final long mod = 1000000007L;\n\n    static List<Edge>[] G = new ArrayList[maxn];\n    static int[] dist = new int[maxn];\n    static int[] prevv = new int[maxn];\n    static int[] preve = new int[maxn];\n    static int[] inq = new int[maxn];\n\n    static int n, s, t;\n\n    static void init(int _n, int _s, int _t) {\n        for (int i = 0; i <= _n; i++) {\n            G[i] = new ArrayList<>();\n        }\n        n = _n;\n        s = _s;\n        t = _t;\n    }\n\n    static void add_edge(int from, int to, int cap, int cost) {\n        G[from].add(new Edge(to, cap, cost, G[to].size()));\n        G[to].add(new Edge(from, 0, -cost, G[from].size() - 1));\n    }\n\n    static int min_cost_flow(int f) {\n        int res = 0;\n        while (f > 0) {\n            Arrays.fill(dist, 0, n, (int) inff);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            Arrays.fill(inq, 0, n, 0);\n            inq[s] = 1;\n            while (!q.isEmpty()) {\n                int now = q.poll();\n                inq[now] = 0;\n                for (int i = 0; i < G[now].size(); i++) {\n                    Edge e = G[now].get(i);\n                    if (e.cap > 0 && dist[now] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[now] + e.cost;\n                        prevv[e.to] = now;\n                        preve[e.to] = i;\n                        if (inq[e.to] == 0) {\n                            inq[e.to] = 1;\n                            q.offer(e.to);\n                        }\n                    }\n                }\n            }\n            if (dist[t] == inff)\n                return -1;\n\n            int d = f;\n            for (int v = t; v != s; v = prevv[v]) {\n                int capacity = G[prevv[v]].get(preve[v]).cap;\n                d = Math.min(d, capacity);\n            }\n            f -= d;\n            res += d * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = G[prevv[v]].get(preve[v]);\n                e.cap -= d;\n                G[v].get(e.rev).cap += d;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = sc.nextInt();\n        int K = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        int[] A = new int[58];\n        List<Integer>[] H = new ArrayList[57];\n        for (int i = 0; i < 57; i++) {\n            H[i] = new ArrayList<>();\n        }\n\n        for (int i = 1; i <= K; i++) {\n            int X = sc.nextInt();\n            A[X]++;\n        }\n        for (int i = 1; i <= M; i++) {\n            int X = sc.nextInt();\n            int Y = sc.nextInt();\n            H[X].add(Y);\n            H[Y].add(X);\n        }\n\n        init(5103, 0, 5101);\n        for (int i = 2; i <= N; i++) {\n            add_edge(0, i, A[i], 0);\n        }\n\n        for (int i = 0; i <= 100; i++) {\n            for (int l = 1; l <= N; l++) {\n                add_edge(50 * i + l, 50 * (i + 1) + l, K, 0);\n                for (int j : H[l]) {\n                    for (int k = 1; k <= K; k++) {\n                        add_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                    }\n                }\n            }\n        }\n\n        for (int i = 1; i <= 101; i++) {\n            add_edge(50 * i + 1, 5101, K, C * i);\n        }\n\n        System.out.println(min_cost_flow(K));\n        sc.close();\n    }\n}\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.02480441704392433, -5.512236498361744e-07, -0.0017025562701746821, -0.43054619431495667, -0.0019376773852854967, -5.51223649