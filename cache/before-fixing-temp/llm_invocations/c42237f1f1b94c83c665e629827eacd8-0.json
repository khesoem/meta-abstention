eader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int mod = Integer.parseInt(st.nextToken());\n        int m = n * (n - 1) / 2;\n        int size = n * (n - 1) + 1;\n        long[][] dp = new long[n + 1][size];\n        long[][] dp1 = new long[n + 1][size];\n        dp[1][m] = 1;\n        for (int i = 2; i <= n; i++) {\n            int prev = (i - 1) * (i - 2) / 2;\n            int low = m - prev;\n            int high = m + prev;\n            for (int x = low; x <= high; x++) {\n                long val = dp[i - 1][x];\n                if (val == 0) continue;\n                for (int d = -i + 1; d < i; d++) {\n                    int idx = x + d;\n                    if (idx >= 0 && idx < size) {\n                        dp[i][idx] = (dp[i][idx] + val * (i - Math.abs(d))) % mod;\n                    }\n                }\n            }\n        }\n        for (int i = 2; i <= n; i++) {\n            int prev = (i - 1) * (i - 2) / 2;\n            int low = m - prev;\n            int high = m + prev;\n            for (int x = low; x <= high; x++) {\n                dp1[i][x] = dp1[i - 1][x] * i % mod;\n            }\n            for (int x = low; x <= high; x++) {\n                long val = dp[i - 1][x];\n                if (val == 0) continue;\n                for (int d = 1; d < i; d++) {\n                    int idx = x - d;\n                    if (idx >= 0 && idx < size) {\n                        dp1[i][idx] = (dp1[i][idx] + val * (i - d)) % mod;\n                    }\n                }\n            }\n        }\n        long ans = 0;\n        for (int j = m + 1; j < size; j++) {\n            ans = (ans + dp1[n][j]) % mod;\n        }\n        System.out.println(ans);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.15053299069404602, -0.000366263062460348, -1.1920928244535389e-07, 0.0, 0.0, -2.8609820219571702e-05, -1.788137751