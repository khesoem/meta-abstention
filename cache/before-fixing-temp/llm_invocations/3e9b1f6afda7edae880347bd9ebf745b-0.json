        break\n            if not bad:\n                cur_mas |= (1 << ind)\n            ind += 1\n        mas[mask] = cur_mas\n\n    p0 = [0] * size_20\n    p1 = [0] * size_20\n\n    for mask in range(size_18):\n        p0[mas[mask]] = (p0[mas[mask]] + sub0[mask]) % MOD\n        p1[cm(mas[mask], comp)] = (p1[cm(mas[mask], comp)] + sub1[mask]) % MOD\n\n    # SOS DP over p1\n    for i in range(20):\n        for mask in range(size_20):\n            if mask & (1 << i):\n                p1[mask] = (p1[mask] + p1[mask ^ (1 << i)]) % MOD\n\n    ans = 0\n    full_mask = (1 << 20) - 1\n    for i in range(size_20):\n        ans = (ans + p0[i] * p1[i ^ full_mask]) % MOD\n\n    ans = (1 - ans) % MOD\n    if ans < 0:\n        ans += MOD\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-9.536738616588991e-07, -0.0003301552205812186, -0.3135785460472107, -7.390948667307384e-06, -0.029759326949715614, -8.22540732769994e-06, -8.344646857949556e-07, -9.536738616588991e-07, -0.00014983485743869096, 0.0, -1.1920928244535389e-07, -1.5497195136049413e-06, -0.00045789722935296595, -8.189342770492658e-05, -4.172316494077677e-06, -0.00020632999076042324, -8.344646857949556e-07, -0.005236006807535887, -1.1920928244535389e-07, -5.2927523938706145e-05, -9.536738616588991e-07, -0.07054607570171356, -3.576278118089249e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.622600959512056e-06, 0.0, -0.059264205396175385, 0.0, -0.12694159150123596, 0.0, -5.960462772236497e-07, -3.576278118089249e-07, 0.0, -2.3841855067985307e-07, -6.198863957251888e-06, -1.5497195136049413e-06, 0.0, 0.0, -3.6954811548639555e-06, -1.311301275563892e-06, 0.0, 0.0, -5.8410845667822286e-05, -1.585470999998506e-05, 0.0, 0.0, 0.0, 0.0, -5.960462772236497e-07, 0.0, -9.536738616588991e-07, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.0, 0.0, 0.0, -1.311301275563892e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -3.55237389157