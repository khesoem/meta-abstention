;\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.offer(v);\n                    }\n                }\n            }\n        }\n        return pre[t] != -1;\n    }\n\n    static int minCostMaxflow(int s, int t, int[] cost) {\n        int flow = 0;\n        cost[0] = 0;\n        while (spfa(s, t)) {\n            int Min = INF;\n            for (int i = pre[t]; i != -1; i = pre[edges[i ^ 1].to]) {\n                if (Min > edges[i].cap - edges[i].flow)\n                    Min = edges[i].cap - edges[i].flow;\n            }\n            for (int i = pre[t]; i != -1; i = pre[edges[i ^ 1].to]) {\n                edges[i].flow += Min;\n                edges[i ^ 1].flow -= Min;\n                cost[0] += edges[i].cost * Min;\n            }\n            flow += Min;\n        }\n        return flow;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        init(MAXN);\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt();\n            addedge(0, x, 1, 0);\n        }\n\n        for (int i = 0; i < 100; i++) {\n            for (int j = 0; j < k; j++)\n                addedge(1 + i * n, 9999, 1, i * c);\n        }\n\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                for (int gg = 1; gg <= k; gg++) {\n                    addedge(u + (j - 1) * n, v + j * n, 1, (2 * gg - 1) * d);\n                    addedge(v + (j - 1) * n, u + j * n, 1, (2 * gg - 1) * d);\n                }\n            }\n        }\n\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                addedge(i + (j - 1) * n, i + j * n, k, 0);\n            }\n        }\n\n        int[] costArr = new int[1];\n        minCostMaxflow(0, 9999, costArr);\n        System.out.println(costArr[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00044663884909823537, -0.00016468366084154695, -7.896309739408025e-07, -0.0004929834394715726, -2.7610454708337784e-05, -3.128163257315464e-07, -0.0010329303331673145, -0.15536753833293915, -0.0019324433524161577, -4.320199877838604e-07, -2.8458354473114014, -0.20158018171787262, -0.010285893455147743, -0.0010223285062238574, -0.12863245606422424, -3.128163257315464e-07, -1.6240566083070007e-06, -7.941850526549388e-06, -2.6060808522743173e-05, -1.1472419600977446e-06, -4.320199877838604e-07, -3.128163257315464e-07, -0.0008295211009681225, -3.054500666621607e-06, -2.1008713702030946e-06, -0.00012654215970542282, 0.0, -6.980854959692806e-05, -3.4121114822482923e-06, -4.127333340875339e-06, -3.128163257315464e-07, -7.896309739408025e-07, -1.9361264946837764e-07, -8.061054359131958e-06, -0.00011677479778882116, -7.896309739408025e-07, -2.2200749754119897e-06, -5.300083648762666e-05, -4.961759259458631e-06, -1.5048530030981055e-06, -9.491498531133402e-06, -1.5020911693572998, -9.088346359931165e-07, -6.301394023466855e-05, -0.19159775972366333, -4.842555426876061e-06, -0.004086355213075876, -0.2036321610212326, -5.438573680294212e-06, -0.00011045700375689194, -2.127018690109253, -5.512236498361744e-07, -1.0921942703134846e-05, -3.128163257315464e-07, -9.13388703338569e-06, -6.704273118884885e-07, -0.0009238460334017873, -6.0033853515051305e-05, -5.288163083605468e-05, -1.9981420336989686e-05, -4.320199877838604e-07, -1.9361264946837764e-07, -2.696889623621246e-06, -3.128163257315464e-07, -0.4741250276565552, -1.9361264946837764e-07, -0.5231332778930664, -0.3486054539680481, -0.0013358361320570111, -5.836499985889532e-05, 0.0, -0.0001049736310960725, -1.282920129597187e-05, 0.0, -1.981667537620524e-06, -1.0280383548888494e-06, 0.0, -0.0002966