{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef bitset<128> u99;\n\nconstexpr const int mod = 1000000007;\nconstexpr const int inv =  570000004;\nconstexpr int add(int a, int b) { return a + b < mod ? a + b : a + b - mod; }\nconstexpr int sub(int a, int b) { return a < b ? a - b + mod : a - b; }\nconstexpr int mul(int a, int b) { return 1LL * a * b % mod; }\n\nunordered_map<u99, int> name;\nint n, dfn, son[65536][128];\nint dfs(u99 s) {\n\tauto ite = name.find(s);\n\tif (ite != name.end()) return ite->second;\n\tint ret = dfn++;\n\tname[s] = ret;\n\tfor (int i = 0; i != (1 << n); ++i) {\n\t\tu99 t = s;\n\t\tfor (int j = 0; j != (1 << n); ++j) if (!t[j])\n\t\t\tfor (int k = i & j; k; k ^= k & -k) if (s[j ^ k & -k]) {\n\t\t\t\tt[j] = 1;\n\t\t\t\tbreak;\n\t\t\t}\n\t\tson[ret][i] = dfs(t);\n\t}\n\treturn ret;\n}\n\nint p[7][7], q[7][128], dp[8][65536];\n\nint main() {\n\tcin >> n;\n\tdfs(1);\n\tfor (int i = 0; i != n; ++i) for (int j = 0; j != n; ++j) cin >> p[i][j], p[i][j] = mul(p[i][j], inv);\n\tfor (int i = 0; i != n; ++i) for (int j = 0; j != (1 << n); ++j) {\n\t\tq[i][j] = 1;\n\t\tfor (int k = 0; k != n; ++k) q[i][j] = mul(q[i][j], j >> k & 1 ? p[k][i] : sub(1, p[k][i]));\n\t}\n\tdp[0][0] = 1;\n\tfor (int i = 0; i != n; ++i) for (int j = 0; j != dfn; ++j) for (int k = 0; k != (1 << n); ++k)\n\t\tdp[i + 1][son[j][k]] = add(dp[i + 1][son[j][k]], mul(dp[i][j], q[i][k]));\n\tu99 res;\n\tfor (int i = 0; i != (1 << n); ++i) res[i] = 1;\n\tcout << dp[n][name[res]] << endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMOD = 1000000007\nINV = 570000004\n\ndef add(a, b):\n    c = a + b\n    return c if c < MOD else c - MOD\n\ndef sub(a, b):\n    c = a - b\n    return c if c >= 0 else c + MOD\n\ndef mul(a, b):\n    return (a * b) % MOD\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    p = [[0]*n for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            p[i][j] = mul(int(next(it)), INV)\n\n    size = 1 << n\n    # compute q[i][j] for i in 0..n-1, j in 0..size-1\n    q = [[1]*size for _ in range(n)]\n    for i in range(n):\n        for j in range(size):\n            prod = 1\n            for k in range(n):\n                if (j >> k) & 1:\n                    prod = mul(prod, p[k][i])\n                else:\n                    prod = mul(prod, sub(1, p[k][i]))\n            q[i][j] = prod\n\n    # build state machine (BFS)\n    state_to_id = {}   # mask -> id\n    masks = []          # id -> mask\n    son = []            # id -> list of next ids for each k\n\n    initial_mask = 1    # bitset with only bit 0 set\n    state_to_id[initial_mask] = 0\n    masks.append(initial_mask)\n    son.append([0]*size)  # placeholder, will be filled when processed\n    dq = deque([0])\n\n    while dq:\n        s_id = dq.popleft()\n        s_mask = masks[s_id]\n        # compute t for each i\n        for i in range(size):\n            t_mask = s_mask\n            # j loop\n            for j in range(size):\n                if not ((t_mask >> j) & 1):\n                    inter = i & j\n                    kbits = inter\n                    while kbits:\n                        lsb = kbits & -kbits\n                        if (s_mask >> (j ^ lsb)) & 1:\n                            t_mask |= (1 << j)\n                            break\n                        kbits ^= lsb\n            # get or create id for t_mask\n            t_id = state_to_id.get(t_mask)\n            if t_id is None:\n                t_id = len(masks)\n                state_to_id[t_mask] = t_id\n                masks.append(t_mask)\n                son.append([0]*size)  # placeholder for future\n                dq.append(t_id)\n            son[s_id][i] = t_id\n\n    dfn = len(masks)\n\n    # DP\n    dp = [[0]*dfn for _ in range(n+1)]\n    dp[0][0] = 1\n    for i in range(n):\n        for j in range(dfn):\n            cur = dp[i][j]\n            if cur == 0:\n                continue\n            nxt_list = son[j]\n            q_i = q[i]\n            for k in range(size):\n                nxt_id = nxt_list[k]\n                dp[i+1][nxt_id] = add(dp[i+1][nxt_id], mul(cur, q_i[k]))\n\n    full_mask = (1 << size) - 1\n    final_id = state_to_id[full_mask]\n    print(dp[n][final_id])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-4.768370445162873e-07, 0.0, 0.0, -0.0004530118894763291, -0.00027104519540444016, 0.0, -0.00015376816736534238, -0.00013016807497479022, -2.622600959512056e-06, 0.0, -1.1920928244535389e-07, -2.312633478140924e-05, -0.062470242381095886, -9.536738616588991e-07, -2.622600959512056e-06, -4.410734163684538e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -2.3841855067985307e-07, -4.768370445162873e-07, -3.8265450712060556e-05, -2.3841855067985307e-07, -3.766942609217949e-05, -6.69933797