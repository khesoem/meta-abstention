\n\t}\n\tfor(int i=0;i<=18;++i)\n\t\tfor(int j=0;j<=n;++j)\n\t\t\tf[i][j]=-1;\n\tprintf(\"%d\\n\",(ksm(k,n)-solve(0,n)+Mod)%Mod);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "```python\nimport sys\nfrom functools import lru_cache\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, Mod = map(int, data[:3])\n\n    if n & 1:\n        print(pow(k, n, Mod))\n        return\n\n    # precompute factorials and inverse factorials\n    fac = [0] * (n + 1)\n    dfac = [0] * (n + 1)\n    inv = [0] * (n + 1)\n    fac[0] = dfac[0] = 1\n    if n >= 1:\n        fac[1] = dfac[1] = 1\n        inv[1] = 1\n    for i in range(2, n + 1):\n        fac[i] = fac[i-1] * i % Mod\n        inv[i] = (Mod - Mod // i) * inv[Mod % i] % Mod\n        dfac[i] = dfac[i-1] * inv[i] % Mod\n\n    @lru_cache(maxsize=None)\n    def solve(use, S):\n        if S == 0:\n            # need fac[n] multiplied by product_{i=1}^{use} (k-i+1)\n            res = fac[n]\n            for i in range(1, use + 1):\n                res = res * (k - i + 1) % Mod\n            return res\n        if use > k:\n            return 0\n        lbit = S & -S\n        U = S - lbit\n        total = 0\n        T = U\n        while True:\n            total = (total + dfac[S - T] * solve(use + 1, T)) % Mod\n            if T == 0:\n                break\n            T = (T - 1) & U\n        return total\n\n    ans = (pow(k, n, Mod) - solve(0, n) + Mod) % Mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-1.1920922133867862e-06, -0.0005586970364674926, -4.2199197196168825e-05, -2.3841855067985307e-07, -0.006720203906297684, -0.002087915316224098, -2.264974000354414e-06, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -2.861018856492592e-06, -2.861018856492592e-06, -0.0036934271920472383, -0.12934283912181854, -0.04859277978539467, -1.6