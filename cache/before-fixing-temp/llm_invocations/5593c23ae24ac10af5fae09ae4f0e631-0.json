        c[sx][sy] = True\n        d[sx][sy] = 0\n        q.append((sx, sy))\n        while q:\n            x, y = q.popleft()\n            for i in range(4):\n                hx = x + xx[i]\n                hy = y + yy[i]\n                if 0 <= hx < n and 0 <= hy < n and not c[hx][hy] and '0' <= a[hx][hy] <= '9':\n                    c[hx][hy] = True\n                    d[hx][hy] = d[x][y] + 1\n                    q.append((hx, hy))\n    bfs(v, sx, sy)\n    \n    # DP: dp[yt][sx][sy][x][y] boolean (total time t+1 layers)\n    dp = [[[[[False] * n for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(t + 1)]\n    for i in range(n):\n        for j in range(n):\n            if '0' <= a[i][j] <= '9':\n                dp[0][i][j][i][j] = True\n    \n    # DP transitions\n    for yt in range(t):\n        for sx_i in range(n):\n            for sy_i in range(n):\n                for x in range(n):\n                    for y in range(n):\n                        if not dp[yt][sx_i][sy_i][x][y]:\n                            continue\n                        if v[x][y] <= yt:\n                            continue\n                        for i in range(4):\n                            hx = x + xx[i]\n                            hy = y + yy[i]\n                            if 0 <= hx < n and 0 <= hy < n and '0' <= a[hx][hy] <= '9':\n                                if v[hx][hy] >= yt + 1:\n                                    dp[yt + 1][sx_i][sy_i][hx][hy] = True\n    \n    # Compute u: reachable pairs across all times\n    u = [[[[False] * n for _ in range(n)] for _ in range(n)] for _ in range(n)]\n    for yt in range(t + 1):\n        for sx_i in range(n):\n            for sy_i in range(n):\n                for x in range(n):\n                    for y in range(n):\n                        if dp[yt][sx_i][sy_i][x][y]:\n                            u[sx_i][sy_i][x][y] = True\n    \n    # Build flow network\n    total_nodes = 2 * n * n + 2\n    g = [[0] * total_nodes for _ in range(total_nodes)]\n    source = 0\n    sink = total_nodes - 1\n    \n    # Source -> a cells\n    for x1 in range(n):\n        for y1 in range(n):\n            if '0' <= a[x1][y1] <= '9':\n                g[source][1 + x1 * n + y1] = ord(a[x1][y1]) - 48\n    \n    # b cells -> sink\n    for x2 in range(n):\n        for y2 in range(n):\n            if '0' <= b[x2][y2] <= '9':\n                g[1 + n * n + x2 * n + y2][sink] = ord(b[x2][y2]) - 48\n    \n    # a cell -> b cell edges (if u true)\n    for x1 in range(n):\n        for y1 in range(n):\n            if not ('0' <= a[x1][y1] <= '9'):\n                continue\n            for x2 in range(n):\n                for y2 in range(n):\n                    if not ('0' <= a[x2][y2] <= '9'):\n                        continue\n                    if not u[x1][y1][x2][y2]:\n                        continue\n                    g[1 + x1 * n + y1][1 + n * n + x2 * n + y2] = INF\n    \n    # Max-flow (Ford-Fulkerson with BFS)\n    p = [-1] * total_nodes\n    def bfs1():\n        c = [False] * total_nodes\n        q = deque()\n        q.append(source)\n        c[source] = True\n        while q:\n            x = q.popleft()\n            if x == sink:\n                return True\n            for h in range(total_nodes):\n                if g[x][h] > 0 and not c[h]:\n                    c[h] = True\n                    p[h] = x\n                    q.append(h)\n        return False\n    \n    while bfs1():\n        minu = INF\n        vtx = sink\n        while vtx != source:\n            minu = min(minu, g[p[vtx]][vtx])\n            vtx = p[vtx]\n        vtx = sink\n        while vtx != source:\n            u_ = p[vtx]\n            g[u_][vtx] -= minu\n            g[vtx][u_] += minu\n            vtx = u_\n    \n    ans = 0\n    for i in range(total_nodes):\n        ans += g[i][source]\n    print(ans)\n\nif __name__ == '__main__':\n    solv()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logpr