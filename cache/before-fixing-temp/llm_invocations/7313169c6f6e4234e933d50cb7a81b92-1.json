{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Java 8 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Java 8 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<iostream>\n#include<cstdio>\n#include<cstring>\n#include<queue>\n#define N 100010\nusing namespace std;\ntypedef int typ;\n#define M 1000010\n#define inf 1000000000\n#define winf 1000000000\nstruct road{\n    int nxt,to,f;\n    typ w;\n}r[M<<1];\nint head[N],cnt=1,all;\nvoid add(int u,int v,int f,typ w)\n{\n    r[++cnt]=(road){head[u],v,f,w};head[u]=cnt;\n    r[++cnt]=(road){head[v],u,0,-w};head[v]=cnt;\n}\nnamespace min_cost_flow{\n    int cur[N];\n    bool vis[N];\n    struct node{\n        int u;typ v;\n        node(int U=0,typ V=0):u(U),v(V){}\n        bool operator <(const node a)const{return v>a.v;}\n    };\n    priority_queue<node>q;\n    typ dis[N],tag[N];\n    bool dij(int s,int t)\n    {\n        for(int i=1;i<=all;i++) dis[i]=winf,cur[i]=head[i];\n        dis[t]=0;q.push(node(t,0));\n        while(!q.empty())\n        {\n            int u=q.top().u;q.pop();\n            if(vis[u]) continue;\n            vis[u]=true;\n            for(int i=head[u];i;i=r[i].nxt)\n            {\n                int v=r[i].to,w=tag[u]+r[i^1].w-tag[v];\n                if(r[i^1].f && dis[u]+w<dis[v]) dis[v]=dis[u]+w,q.push(node(v,dis[v]));\n            }\n        }\n        for(int i=1;i<=all;i++) tag[i]=min(tag[i]+dis[i],winf);\n        if(!vis[s]) return false;\n        for(int i=1;i<=all;i++) vis[i]=false;\n        return true;\n    }\n    int dfs(int u,int t,int fl)\n    {\n        if(u==t || !fl) return fl;\n        int res=0;\n        vis[u]=true;\n        for(int &i=cur[u];i;i=r[i].nxt)\n        if(r[i].f)\n        {\n            int v=r[i].to,f;\n            if(!vis[v] && tag[v]+r[i].w==tag[u] && (f=dfs(v,t,min(fl,r[i].f))))\n            {\n                r[i].f-=f,r[i^1].f+=f;\n                res+=f,fl-=f;\n                if(!fl) break;\n            }\n        }\n        vis[u]=false;\n        return res;\n    }\n    int maxf;typ minw;\n    void work(int s,int t){while(dij(s,t)){int w=dfs(s,t,inf);maxf+=w,minw+=w*tag[s];}}\n}\nint ss=1,tt=2,n,m,k,c,d;\nvector<int>g[N];\ninline int id(int t,int x){return t*n+x+2;}\nvoid work(int t)\n{\n    all+=n;\n    for(int u=1;u<=n;u++)\n        for(int v:g[u])\n        {\n            for(int p=1;p<=k;p++)\n            add(id(t,u),id(t+1,v),1,d*(2*p-1));\n        }\n    for(int u=1;u<=n;u++) add(id(t,u),id(t+1,u),inf,0);\n    add(id(t+1,1),tt,inf,c*(t+1));\n}\nint main()\n{\n    scanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n    all=n+2;\n    for(int i=1;i<=k;i++)\n    {\n        int a;\n        scanf(\"%d\",&a);\n        add(ss,id(0,a),1,0);\n    }\n    for(int i=1;i<=m;i++)\n    {\n        int u,v;\n        scanf(\"%d%d\",&u,&v);\n        g[u].push_back(v);g[v].push_back(u);\n    }\n    add(id(0,1),tt,inf,0);\n    for(int i=0;i<=n+k;i++) work(i);\n    min_cost_flow::work(ss,tt);\n    printf(\"%d\\n\",min_cost_flow::minw);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\n\npublic class Main {\n    static class Edge {\n        int to, rev, cap, cost;\n        Edge(int t, int r, int c, int w) {\n            to = t; rev = r; cap = c; cost = w;\n        }\n    }\n\n    static ArrayList<Edge>[] adj;\n    static int[] tag, dis, cur;\n    static boolean[] vis;\n    static int all;\n    static final int INF = 1000000000;\n    static final int WINF = 1000000000;\n    static int maxf, minw;\n    static PriorityQueue<Node> pq;\n\n    static class Node implements Comparable<Node> {\n        int u, v;\n        Node(int u, int v) { this.u = u; this.v = v; }\n        public int compareTo(Node o) { return this.v - o.v; }\n    }\n\n    static void addEdge(int u, int v, int cap, int cost) {\n        Edge a = new Edge(v, adj[v].size(), cap, cost);\n        Edge b = new Edge(u, adj[u].size(), 0, -cost);\n        adj[u].add(a);\n        adj[v].add(b);\n    }\n\n    static boolean dij(int s, int t) {\n        Arrays.fill(dis, WINF);\n        for (int i = 1; i <= all; i++) cur[i] = 0;\n        Arrays.fill(vis, false);\n        dis[t] = 0;\n        pq.clear();\n        pq.offer(new Node(t, 0));\n        while (!pq.isEmpty()) {\n            Node node = pq.poll();\n            int u = node.u;\n            if (vis[u]) continue;\n            vis[u] = true;\n            for (Edge e : adj[u]) {\n                int v = e.to;\n                Edge rev = adj[v].get(e.rev);\n                if (rev.cap > 0) {\n                    int w = tag[u] + rev.cost - tag[v];\n                    if (dis[u] + w < dis[v]) {\n                        dis[v] = dis[u] + w;\n                        pq.offer(new Node(v, dis[v]));\n                    }\n                }\n            }\n        }\n        for (int i = 1; i <= all; i++) tag[i] = Math.min(tag[i] + dis[i], WINF);\n        if (!vis[s]) return false;\n        Arrays.fill(vis, false);\n        return true;\n    }\n\n    static int dfs(int u, int t, int fl) {\n        if (u == t || fl == 0) return 0;\n        int res = 0;\n        vis[u] = true;\n        int i = cur[u];\n        while (i < adj[u].size()) {\n            Edge e = adj[u].get(i);\n            if (e.cap > 0 && !vis[e.to] && tag[e.to] + e.cost == tag[u]) {\n                int f = dfs(e.to, t, Math.min(fl, e.cap));\n                if (f > 0) {\n                    e.cap -= f;\n                    adj[e.to].get(e.rev).cap += f;\n                    res += f;\n                    fl -= f;\n                    if (fl == 0) {\n                        cur[u] = i;\n                        break;\n                    }\n                }\n            }\n            i++;\n        }\n        if (fl != 0) cur[u] = i;\n        vis[u] = false;\n        return res;\n    }\n\n    static void flowWork(int s, int t) {\n        while (dij(s, t)) {\n            int f = dfs(s, t, INF);\n            maxf += f;\n            minw += f * tag[s];\n        }\n    }\n\n    static int n, m, k, c, d;\n    static List<Integer>[] g;\n\n    static int id(int t, int x) { return t * n + x + 2; }\n\n    static void buildLayer(int t) {\n        all += n;\n        for (int u = 1; u <= n; u++) {\n            for (int v : g[u]) {\n                for (int p = 1; p <= k; p++) {\n                    addEdge(id(t, u), id(t + 1, v), 1, d * (2 * p - 1));\n                }\n            }\n        }\n        for (int u = 1; u <= n; u++) {\n            addEdge(id(t, u), id(t + 1, u), INF, 0);\n        }\n        addEdge(id(t + 1, 1), 2, INF, c * (t + 1));\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n\n        all = n + 2; // ss=1, tt=2, plus initial time 0 nodes\n        int totalNodes = n + 2 + (n + k + 1) * n;\n        adj = new ArrayList[totalNodes + 1];\n        for (int i = 0; i <= totalNodes; i++) adj[i] = new ArrayList<>();\n        tag = new int[totalNodes + 1];\n        dis = new int[totalNodes + 1];\n        cur = new int[totalNodes + 1];\n        vis = new boolean[totalNodes + 1];\n        pq = new PriorityQueue<>();\n\n        g = new ArrayList[n + 2];\n        for (int i = 1; i <= n; i++) g[i] = new ArrayList<>();\n\n        for (int i = 1; i <= k; i++) {\n            int a = sc.nextInt();\n            addEdge(1, id(0, a), 1, 0);\n        }\n\n        for (int i = 1; i <= m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            g[u].add(v);\n            g[v].add(u);\n        }\n\n        addEdge(id(0, 1), 2, INF, 0);\n\n        for (int t = 0; t <= n + k; t++) {\n            buildLayer(t);\n        }\n\n        flowWork(1, 2);\n        System.out.println(minw);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.05564855504781e-05, -4.768370445162873e-07, -4.768370445162873e-07, -0.00020037073409184813, -0.004563868511468172, -4.768370445162873e-07, -0.00014077626110520214, -0.004204838071018457, -4.1126360883936286e-05, 0.0, -8.821448318485636e-06, -0.006736426148563623, -0.0009482178138568997, -0.002059602178633213, -0.018280480057001114, -7.867782187531702e-06, -2.0265558760002023e-06, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -0.00020716428116429597, -1.0728830375228426e-06, -5.722029527532868e-06, -7.510157047363464e-06, -9.536738616588991e-07, -5.006777428206988e-06, -0.0005644158809445798, -3.099436753473128e-06, -7.986990567587782e-06, -2.3364747903542593e-05, -0.16023527085781097, -5.960462772236497e-07, 0.0, -9.905801562126726e-05, -1.7881377516459906e-06, 0.0, -0.005635090172290802, -5.960446742392378e-06, -8.344646857949556e-07, -6.460934673668817e-05, -7.033323527139146e-06, -0.474077433347702, -1.1920922133867862e-06, -0.00012337400403339416, -7.676783570786938e-05, 0.0, -1.501932144165039, -4.756337511935271e-05, -1.1920928244535389e-07, 0.0, -1.0728830375228426e-06, 0.0, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, 0.