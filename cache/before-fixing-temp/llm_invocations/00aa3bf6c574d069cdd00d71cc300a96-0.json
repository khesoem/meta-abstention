\nfrom collections import deque\n\ndef main():\n    INF = 10 * 10 * 10\n    # Read initial inputs\n    dim, time_to_die = map(int, input().split())\n\n    # Initialize graph data structures\n    total_nodes = 2 * dim * dim + 2\n    gr = [[] for _ in range(total_nodes)]\n    cap = [[0] * total_nodes for _ in range(total_nodes)]\n    vert = [[[0, 0] for _ in range(dim)] for _ in range(dim)]\n    \n    # Read ASCII grids\n    labsci = [list(input().strip()) for _ in range(dim)]\n    labcap = [list(input().strip()) for _ in range(dim)]\n    \n    N = 2  # initial node index\n    malfunc = -1\n    \n    # Process laboratories as source nodes\n    for i in range(dim):\n        for j in range(dim):\n            c = labsci[i][j]\n            if c <= '9' and c >= '1':\n                cap[0][N] = int(c)\n                gr[0].append(N)\n                gr[N].append(0)\n                vert[i][j][0] = N\n                N += 1\n            elif c == 'Z':\n                malfunc = 100 * i + j\n                labsci[i][j] = 'Y'  # Replace 'Z' with 'Y' for processing\n\n    M = N\n    # Process lab capacity nodes\n    for i in range(dim):\n        for j in range(dim):\n            c = labcap[i][j]\n            if c <= '9' and c >= '1':\n                cap[M][1] = int(c)\n                gr[M].append(1)\n                gr[1].append(M)\n                vert[i][j][1] = M\n                M += 1\n    \n    # Initialize die array\n    die = [[time_to_die + 1 for _ in range(dim)] for _ in range(dim)]\n    # Mark malfunction point\n    if malfunc != -1:\n        mx, my = divmod(malfunc, 100)\n        die[mx][my] = 0\n    \n    # Directions for BFS\n    ds = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n    \n    # BFS for malfunction propagation\n    q = deque()\n    if malfunc != -1:\n        q.append(malfunc)\n    while q:\n        front = q.popleft()\n        x, y = divmod(front, 100)\n        for dx, dy in ds:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < dim and 0 <= ny < dim:\n                if labsci[nx][ny] != 'Y' and die[nx][ny] > die[x][y] + 1:\n                    die[nx][ny] = die[x][y] + 1\n                    q.append(100 * nx + ny)\n\n    # Build reachability considering fire\n    for i in range(dim):\n        for j in range(dim):\n            c = labsci[i][j]\n            if c <= '9' and c >= '1':\n                reach = [[time_to_die + 1 for _ in range(dim)] for _ in range(dim)]\n                reach[i][j] = 0\n                # If the device is operational\n                if labcap[i][j] <= '9' and labcap[i][j] >= '1':\n                    cap[vert[i][j][0]][vert[i][j][1]] = INF\n                    gr[vert[i][j][0]].append(vert[i][j][1])\n                    gr[vert[i][j][1]].append(vert[i][j][0])\n                q = deque()\n                q.append(100 * i + j)\n                while q:\n                    front = q.popleft()\n                    x, y = divmod(front, 100)\n                    for dx, dy in ds:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < dim and 0 <= ny < dim:\n                            if labsci[nx][ny] != 'Y' and reach[nx][ny] > reach[x][y] + 1:\n                                if labcap[nx][ny] <= '9' and labcap[nx][ny] >= '1':\n                                    if reach[x][y] + 1 <= die[nx][ny]:\n                                        cap[vert[i][j][0]][vert[nx][ny][1]] = INF\n                                        gr[vert[i][j][0]].append(vert[nx][ny][1])\n                                        gr[vert[nx][ny][1]].append(vert[i][j][0])\n                                if reach[x][y] + 1 < die[nx][ny]:\n                                    reach[nx][ny] = reach[x][y] + 1\n                                    q.append(100 * nx + ny)\n\n    # Function to augment flow\n    def augment(u, vis, parent):\n        if u == 1:\n            return INF\n        vis[u] = True\n        for v in gr[u]:\n            if not vis[v] and cap[u][v] > 0:\n                parent[v] = u\n                r = augment(v, vis, parent)\n                if r:\n                    return min(r, cap[u][v])\n        return 0\n\n    # Function for max flow\n    def maxflow():\n        total_flow = 0\n        while True:\n            vis = [False] * total_nodes\n            parent = [-1] * total_nodes\n            flow = augment(0, vis, parent)\n            if not flow:\n                break\n            total_flow += flow\n            v = 1\n            while v != 0:\n                u = parent[v]\n                cap[u][v] -= flow\n                cap[v][u] += flow\n                v = u\n        return total_flow\n\n    # Calculate and output max flow\n    print(maxflow())\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0004113692557439208, -0.0003764535649679601, -1.2664456789934775e-06, -2.3676733690081164e-05, -0.07519033551216125, -3.3391897678375244, -0.04952149838209152, -0.21462860703468323, -0.022299161180853844, -0.34845787286758423, -0.00892902072519064, -1.9361264946837764e-07, -2.339278580620885e-06, -0.016250547021627426, -3.8489084243774414, -0.8514243960380554, -1.8624639324116288e-06, -0.00042745075188577175, -0.6042371988296509, -9.849109119386412e-06, -0.0005950896302238107, -0.0021888066548854113, -0.46070000529289246, -3.8889261304575484e-06, 0.0, -1.7432603272027336e-06, -0.00017958412354346365, -1.9361264946837764e-07, -0.9413930773735046, -2.141186450899113e-05, -0.3466010093688965, -0.014782000333070755, -3.0599868297576904, -0.5076812505722046, -0.09859981387853622, -6.704273118884885e-07, -7.576873758807778e-05, -6.456358823925257e-05, -4.246537173457909e-06, -1.9361264946837764e-07, -9.088346359931165e-07, -5.5577775128767826e-06, -7.896309739408025e-07, -3.128163257315464e-07, -1.2664456789934775e-06, 0.0, 0.0, -9.610702363715973e-06, -0.4746108949184418, -6.704273118884885e-07, -0.10694748908281326, -0.012000000104308128, -0.57318