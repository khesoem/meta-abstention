j[b].append(idx + 1)\n        self.edges.append([a, 0, 0, -cost, -cost])  # reverse\n        return idx\n\n    def djk(self):\n        INF = 10**9\n        dist = [INF] * self.n\n        prev = [-1] * self.n\n        maxf = [0] * self.n\n        dist[self.source] = 0\n        prev[self.source] = -2\n        maxf[self.source] = INF\n        pq = [(0, self.source)]\n        while pq:\n            d, v = heapq.heappop(pq)\n            if d != dist[v]:\n                continue\n            for edid in self.adj[v]:\n                edge = self.edges[edid]\n                u = edge[0]\n                if edge[1] < edge[2] and dist[u] > dist[v] + edge[3]:\n                    dist[u] = dist[v] + edge[3]\n                    prev[u] = edid\n                    maxf[u] = min(maxf[v], edge[2] - edge[1])\n                    heapq.heappush(pq, (dist[u], u))\n        lastid = prev[self.sink]\n        extraflow = maxf[self.sink]\n        atcost = 0\n        if lastid == -1:\n            return (0, 0)\n        # trace back\n        id = lastid\n        while id != -2:\n            self.edges[id][1] += extraflow\n            self.edges[id ^ 1][1] -= extraflow\n            atcost += self.edges[id][4]\n            id = prev[self.edges[id ^ 1][0]]\n        # update potentials\n        for id in range(len(self.edges)):\n            v = self.edges[id ^ 1][0]\n            u = self.edges[id][0]\n            if prev[v] != -1 and prev[u] != -1:\n                self.edges[id][3] += dist[v] - dist[u]\n        return (extraflow, atcost)\n\n    def bellamanford(self):\n        INF = 10**9\n        dist = [INF] * self.n\n        dist[self.source] = 0\n        for rep in range(self.n):\n            changed = False\n            for id in range(len(self.edges)):\n                v = self.edges[id ^ 1][0]\n                u = self.edges[id][0]\n                if self.edges[id][1] < self.edges[id][2] and dist[v] != INF and dist[u] > dist[v] + self.edges[id][3]:\n                    dist[u] = dist[v] + self.edges[id][3]\n                    changed = True\n            if not changed:\n                break\n        for id in range(len(self.edges)):\n            v = self.edges[id ^ 1][0]\n            u = self.edges[id][0]\n            if dist[v] < INF and dist[u] < INF:\n                self.edges[id][3] += dist[v] - dist[u]\n\n    def mfmc(self):\n        flow = 0\n        cost = 0\n        if any(ed[1] > 0 and ed[3] < 0 for ed in self.edges):\n            self.bellamanford()\n        while True:\n            extraflow, atcost = self.djk()\n            if extraflow <= 0:\n                break\n            flow += extraflow\n            cost += extraflow * atcost\n        return (flow, cost)\n\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    a = [int(next(it)) for _ in range(k)]\n    e = [[] for _ in range(n + 1)]\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        e[x].append(y)\n        e[y].append(x)\n\n    max_time = 120\n    nd = 0\n    to = [[0] * (n + 1) for _ in range(max_time)]\n    for i in range(max_time):\n        for j in range(1, n + 1):\n            to[i][j] = nd\n            nd += 1\n    S = nd\n    nd += 1\n    T = nd\n    nd += 1\n    flow = SSP(nd, S, T)\n\n    # source to starting cities at time 0\n    for i in range(k):\n        flow.add_edge(S, to[0][a[i]], 1, 0)\n\n    # sink edges from city 1 at each time\n    for i in range(max_time):\n        flow.add_edge(to[i][1], T, k, c * i)\n\n    # transitions\n    for i in range(max_time - 1):\n        for j in range(1, n + 1):\n            # move to neighbors\n            for nj in e[j]:\n                for z in range(0, 53):\n                    flow.add_edge(to[i][j], to[i + 1][nj], 1, d * (2 * z + 1))\n            # stay in place\n            flow.add_edge(to[i][j], to[i