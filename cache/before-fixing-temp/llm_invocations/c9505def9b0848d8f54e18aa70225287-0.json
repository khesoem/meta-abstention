elf.cntA = [0] * 61\n        self.cntB = [0] * 61\n        self.best = float('inf')\n        self.str = \"\"\n        self.cache = {}\n        \n    def read_int():\n        ans = 0\n        neg = False\n        start = False\n        while True:\n            c = sys.stdin.read(1)\n            if not c:\n                break\n            if c == '-':\n                start = True\n                neg = True\n                continue\n            elif c.isdigit():\n                start = True\n                ans = ans * 10 + int(c)\n            elif start:\n                break\n        return -ans if neg else ans\n\n    def read_long():\n        ans = 0\n        neg = False\n        start = False\n        while True:\n            c = sys.stdin.read(1)\n            if not c:\n                break\n            if c == '-':\n                start = True\n                neg = True\n                continue\n            elif c.isdigit():\n                start = True\n                ans = ans * 10 + int(c)\n            elif start:\n                break\n        return -ans if neg else ans\n\n    def read_string():\n        sb = []\n        start = False\n        while True:\n            c = sys.stdin.read(1)\n            if not c:\n                break\n            if c.isalnum() or c == '?':\n                start = True\n                sb.append(c)\n            elif start:\n                break\n        return ''.join(sb)\n\n    readInt = staticmethod(read_int)\n    readLong = staticmethod(read_long)\n    readString = staticmethod(read_string)\n\n    def dfs(self, x, y, v1, v2):\n        diff = abs(x - y)\n        if self.best <= 1 or diff - self.ch[v1][self.R] * self.ch[v2][self.R] >= self.best:\n            return\n        if v1 == self.R - 1 and v2 == self.R - 1:\n            if diff < self.best:\n                self.best = diff\n            return\n        if v1 >= self.R:\n            cur = self.ch[v1][self.R] - self.ch[v1 - 1][self.R]\n            other = self.ch[v2][self.R]\n            self.dfs(x, y + cur * other, v1 - 1, v2)\n        if v2 >= self.R:\n            cur = self.ch[v2][self.R] - self.ch[v2 - 1][self.R]\n            other = self.ch[v1][self.R]\n            self.dfs(x + cur * other, y, v1, v2 - 1)\n\n    def solve(self, x, y, v1, v2):\n        diff = abs(x - y)\n        if diff - self.ch[v1][self.R] * self.ch[v2][self.R] > self.best:\n            return 0\n        key = (x, v1, v2)\n        v = self.cache.get(key)\n        if v is not None:\n            return v\n        if v1 < self.R or v2 < self.R:\n            if v1 >= self.cntA[v1 + v2] and v2 >= self.cntB[v1 + v2]:\n                s = v1 + v2\n                v1 -= self.cntA[s]\n                v2 -= self.cntB[s]\n                return self.ch[v1 + v2][v1]\n            return 0\n        ans = 0\n        c = self.str[v1 + v2 - 1]\n        if c != 'B':\n            cur = self.ch[v1][self.R] - self.ch[v1 - 1][self.R]\n            other = self.ch[v2][self.R]\n            ans += self.solve(x, y + cur * other, v1 - 1, v2)\n        if c != 'A':\n            cur = self.ch[v2][self.R] - self.ch[v2 - 1][self.R]\n            other = self.ch[v1][self.R]\n            ans += self.solve(x + cur * other, y, v1, v2 - 1)\n        self.cache[key] = ans\n        return ans\n\n    def start(self):\n        self.R = Test.readInt()\n        self.C = Test.readInt()\n        for i in range(2 * (self.R + self.C) + 1):\n            for j in range(i + 1):\n                if j == 0 or j == i:\n                    self.ch[i][j] = 1\n                else:\n                    self.ch[i][j] = self.ch[i - 1][j - 1] + self.ch[i - 1][j]\n        x, y = 0, 0\n        v1 = self.R + self.C\n        v2 = self.R + self.C\n        while v1 >= self.R and v2 >= self.R:\n            if x > y:\n                cur = self.ch[v1][self.R] - self.ch[v1 - 1][self.R]\n                other = self.ch[v2][self.R]\n                y += cur * other\n                v1 -= 1\n            else:\n                cur = self.ch[v2][self.R] - self.ch[v2 - 1][self.R]\n                other = self.ch[v1][self.R]\n                x += cur * other\n                v2 -= 1\n        self.best = abs(x - y)\n        self.dfs(0, 0, self.R + self.C, self.R + self.C)\n        self.str = Test.readString()\n        for i in range(2 * (self.R + self.C)):\n            self.cntA[i + 1] = self.cntA[i] + (1 if self.str[i] == 'A' else 0)\n            self.cntB[i + 1] = self.cntB[i] + (1 if self.str[i] == 'B' else 0)\n        ans = self.solve(0, 0, self.R + self.C, self.R + self.C)\n        print(ans)\n\nif __name__ == \"__main__\":\n    te = Test()\n    te.start()\n</translated_code>\n<confidence>\n0.90\n</confidence>", "token_logprobs": [-6.198864e-06, 0.0, -4.7683704e-07, -0.00010656743, -0.0007636015, -0.0006611545, -0.31482458, -0.16787449, -0.5917287, 0.0, -1.1920928e-07, -6.9141147e-06, 0.0, -2.3841855e-07, -0.00096774945, -0.31647375, -0.00045408428, -1.41858045e-05, -2.467602e-05, -0.0034694022, -1.6569955e-05, -5.960463e-07, -2.3841855e-07, -1.1920928e-07, -4.3272037e-05, -3.576278e-07, -0.00031788065, -0.0254944, -0.0012942518, -0.0012069807, -1.3113013e-06, -1.4305105e-06, 0.0, 0.0, -2.3841855e-07, -1.1920928e-07, -2.3841855e-07, -7.152555e-07, -1.9073468e-06, 0.0, -0.00014292172, -6.758938e-05, -7.152555e-07, -1.7046783e-05, -3.552374e-05, -1.3134402, -1.2993728e-05, -1.2993728e-05, -2.527205e-05, 0.0, 0.0, -1.1920928e-07, -1.1920928e-07, 0.0, -1.1563234e-05, -0.00014101465, -1.1920928e-07, -0.00055702904, -3.5762147e-05, -3.6954812e-06, -8.106199e-06, 0.0, 0.0, 0.0, -2.3841855e-07, 0.0, -6.9141147e-06, -0.000918086, -1.4305105e-06, 0.0, 0.0, -7.152555e-07, 0.0, -3.576278e-07, 0.0, 0.0, -8.344647e-07, -4.7683704e-07, 0.0, -4.7683704e-07, -1.9073468e-06, -2.264974e-06, 0.0, -4.7683704e-07, -3.3378547e-06, 0.0, -5.960463e-07, -0.043818448, -0.00015937012, -8.487341e-05, -6.4490145e-05, -4.7683704e-07, -4.7683704e-07, -0.0002503082, -0.045613885, -0.084047735, -0.03813000