y()) {\n\t\t\t\tll cur=q.top();\n\t\t\t\tint d=cur>>32, u=cur;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u])\n\t\t\t\t\tcontinue;\n\t\t\t\tfor(int i=0; i<SZ(adj[u]); ++i) {\n\t\t\t\t\tEdge &e=adj[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif (e.cap<=e.f)\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\tint nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif (prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push(((ll)nprio<<32)+v);\n\t\t\t\t\t\tprevnode[v]=u;\n\t\t\t\t\t\tprevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INT_MAX)\n\t\t\t\tbreak;\n\t\t\tfor(int i=0; i<n; ++i)\n\t\t\t\tpot[i]+=prio[i];\n\t\t\tint df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tEdge &e=adj[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df;\n\t\t\t\tadj[v][e.rev].f-=df;\n\t\t\t\tflowCost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn make_pair(flow, flowCost);\n\t}\n};\n\nint n,m,k,c,d;\n \nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tMCF nt(6+107*n);\n\tfore(_,0,k){\n\t\tint x;\n\t\tscanf(\"%d\",&x);x--;\n\t\tnt.addEdge(0,1+x,1,0);\n\t}\n\tfore(_,0,m){\n\t\tint x,y;\n\t\tscanf(\"%d%d\",&x,&y);x--;y--;\n\t\tfore(i,0,105){\n\t\t\tfore(j,0,51){\n\t\t\t\tnt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n\t\t\t\tnt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n\t\t\t}\n\t\t}\n\t}\n\tfore(i,0,105)fore(j,0,n)nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n\tfore(i,0,105)nt.addEdge(1+i*n,1+105*n,51,0);\n\tauto ans=nt.minCostFlow(0,1+105*n);\n\tprintf(\"%d\\n\",ans.snd);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.u = [0] * n\n        self.v = [0] * n\n        self.prio = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n        self.adj = [[] for _ in range(n)]\n    \n    def addEdge(self, s, t, cap, cost):\n        self.adj[s].append({'to': t, 'f': 0, 'cap': cap, 'cost': cost, 'rev': len(self.adj[t])})\n        self.adj[t].append({'to': s, 'f': 0, 'cap': 0, 'cost': -cost, 'rev': len(self.adj[s]) - 1})\n\n    def minCostFlow(self, s, t):\n        flow = 0\n        flowCost = 0\n        INF = 10**9\n        while True:\n            pq = []\n            self.prio = [float('inf')] * self.n\n            self.prio[s] = 0\n            self.curflow = [INF] if True else [0] * self.n\n            self.curflow[s] = INF\n            heapq.heappush(pq, (0, s))\n            while pq:\n                d, u = heapq.heappop(pq)\n                if d != self.prio[u]:\n                    continue\n                for i, e in enumerate(self.adj[u]):\n                    if e['cap'] <= e['f']:\n                        continue\n                    nprio = self.prio[u] + e['cost'] + self.pot[u] - self.pot[e['to']]\n                    if self.prio[e['to']] > nprio:\n                        self.prio[e['to']] = nprio\n                        heapq.heappush(pq, (nprio, e['to']))\n                        self.prevnode[e['to']] = u\n                        self.prevedge[e['to']] = i\n                        self.curflow[e['to']] = min(self.curflow[u], e['cap'] - e['f'])\n            if self.prio[t] == float('inf'):\n                break\n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            v = t\n            while v != s:\n                u = self.prevnode[v]\n                e = self.adj[u][self.prevedge[v]]\n                e['f'] += df\n                self.adj[v][e['rev']]['f'] -= df\n                flowCost += df * e['cost']\n                v = u\n        return (flow, flowCost)\n\nn, m, k, c, d = map(int, sys.stdin.read().split())\nnt = MCF(6 + 107 