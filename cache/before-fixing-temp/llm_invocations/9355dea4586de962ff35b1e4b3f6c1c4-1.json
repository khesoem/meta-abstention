;\n            this.cap = cap;\n            this.cost = cost;\n            this.rev = rev;\n        }\n    }\n\n    static int n, s, t;\n    static ArrayList<Edge>[] G;\n    static long[] dist;\n    static int[] prevv, preve;\n    static int[] inq;\n    static final long INF = (long)1e18;\n\n    static void init(int _n, int _s, int _t) {\n        n = _n;\n        s = _s;\n        t = _t;\n        G = new ArrayList[n+1];\n        for (int i = 0; i <= n; i++) G[i] = new ArrayList<>();\n    }\n\n    static void add_edge(int from, int to, int cap, int cost) {\n        G[from].add(new Edge(to, cap, cost, G[to].size()));\n        G[to].add(new Edge(from, 0, -cost, G[from].size()-1));\n    }\n\n    static long min_cost_flow(int f) {\n        long res = 0;\n        dist = new long[n];\n        prevv = new int[n];\n        preve = new int[n];\n        inq = new int[n];\n        while (f > 0) {\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            Queue<Integer> q = new LinkedList<>();\n            q.add(s);\n            inq[s] = 1;\n            while (!q.isEmpty()) {\n                int now = q.poll();\n                inq[now] = 0;\n                for (int i = 0; i < G[now].size(); i++) {\n                    Edge e = G[now].get(i);\n                    if (e.cap > 0 && dist[now] + e.cost < dist[e.to]) {\n                        dist[e.to] = dist[now] + e.cost;\n                        prevv[e.to] = now;\n                        preve[e.to] = i;\n                        if (inq[e.to] == 0) {\n                            inq[e.to] = 1;\n                            q.add(e.to);\n                        }\n                    }\n                }\n            }\n\n            if (dist[t] == INF) return -1;\n\n            int d = f;\n            for (int v = t; v != s; v = prevv[v]) {\n                d = Math.min(d, G[prevv[v]].get(preve[v]).cap);\n            }\n            f -= d;\n            res += d * dist[t];\n            for (int v = t; v != s; v = prevv[v]) {\n                Edge e = G[prevv[v]].get(preve[v]);\n                e.cap -= d;\n                G[v].get(e.rev).cap += d;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int N = sc.nextInt();\n        int M = sc.nextInt();\n        int K = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        int[] A = new int[58];\n        for (int i = 1; i <= K; i++) {\n            int X = sc.nextInt();\n            A[X]++;\n        }\n\n        ArrayList<Integer>[] H = new ArrayList[57];\n        for (int i = 0; i < 57; i++) H[i] = new ArrayList<>();\n        for (int i = 1; i <= M; i++) {\n            int X = sc.nextInt();\n            int Y = sc.nextInt();\n            H[X].add(Y);\n            H[Y].add(X);\n        }\n\n        init(5103, 0, 5101);\n        for (int i = 2; i <= N; i++) {\n            add_edge(0, i, A[i], 0);\n        }\n        for (int i = 0; i <= 100; i++) {\n            for (int l = 1; l <= N; l++) {\n                add_edge(50 * i + l, 50 * (i + 1) + l, K, 0);\n                for (int j : H[l]) {\n                    for (int k = 1; k <= K; k++) {\n                        add_edge(50 * i + l, 50 * (i + 1) + j, 1, D * (2 * k - 1));\n                    }\n                }\n            }\n        }\n        for (int i = 1; i <= 101; i++) {\n            add_edge(50 * i + 1, 5101, K, C * i);\n        }\n\n        long result = min_cost_flow(K);\n        System.out.println(result);\n    }\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-4.887569048150908e-06, -3.576278118089249e-07, -2.3841855067985307e-07, -6.246371776796877e-05, -0.00012039413559250534, -1.1920928244535389e-07, -0.006716769654303789, -0.02370539866387844, -0.0006157647585496306, -2.3841855067985307e-07, -0.004364607855677605, -0.01107415184378624, -0.00047874910524114966, -0.007228057365864515, -0.8604