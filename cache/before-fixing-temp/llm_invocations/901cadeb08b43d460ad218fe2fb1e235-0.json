n    private static long powMod(long base, long exp, int mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n\n        if (k == 0) {\n            System.out.println(powMod(p, p - 1, MOD));\n            return;\n        }\n\n        if (k == 1) {\n            System.out.println(powMod(p, p, MOD));\n            return;\n        }\n\n        int m = 1;\n        long t = k;\n        while (true) {\n            m++;\n            t = (t * k) % p;\n            if (t == 1) {\n                System.out.println(powMod(p, (p - 1) / m, MOD));\n                return;\n            }\n        }\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0007538337376900017, -1.1920928244535389e-07, 0.0, 0.0, -5.757642793469131e-05, -2.3841830625315197e-06, 0.0, -0.00011753345461329445, -0.006838844623416662, -0.0011747133685275912, -2.9444261599564925e-05, -3.576278118089249e-07, -0.06561702489852905, -0.00043418517452664673, -7.56950321374461e-05, -1.138687252998352, -2.861018856492592e-06, -5.125986263010418e-06, -0.0011701886542141438, -0.0015023384476080537, 0.0, -0.0007109498255886137, -0.06196828559041023, 0.0, 0.0, 0.0, -1.1920928244535389e-07, 0.0, -5.245195097813848e-06, -0.011066842824220657, -1.1920922133867862e-06, -0.10725370049476624, -5.960462772236497e-07, -0.0011703077470883727, -0.31533190608024597, -8.296622399939224e-05, -0.0009116546134464443, -0.006401627790182829, 0.0, -0.014163566753268242, -0.0019326595356687903, -0.023245563730597496, -0.00015901254664640874, -0.00056429672986269, -1.4305104514278355e-06, -2.0265558760002023e-06, -2.3841855