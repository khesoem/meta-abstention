w in data]\n        elif n is not None and m is not None:\n            self.v = [[mint(0) for _ in range(m)] for _ in range(n)]\n        else:\n            self.v = []\n\n    def height(self):\n        return len(self.v)\n\n    def width(self):\n        return len(self.v[0])\n\n    def at(self, i, j):\n        return self.v[i][j]\n\n    def set_at(self, i, j, val):\n        self.v[i][j] = val if isinstance(val, mint) else mint(val)\n\n    @staticmethod\n    def identity(n):\n        A = Matrix(n, n)\n        for i in range(n):\n            A.set_at(i, i, 1)\n        return A\n\n    def __imul__(self, other):\n        n = self.height()\n        m = other.width()\n        p = other.height()\n        assert p == self.width()\n        w = [[mint(0) for _ in range(m)] for _ in range(n)]\n        for i in range(n):\n            for j in range(m):\n                x = mint(0)\n                for k in range(p):\n                    x += self.at(i, k) * other.at(k, j)\n                w[i][j] = x\n        self.v = w\n        return self\n\n    def __mul__(self, other):\n        result = Matrix(self.height(), other.width())\n        n = self.height()\n        m = other.width()\n        p = other.height()\n        assert p == self.width()\n        for i in range(n):\n            for j in range(m):\n                x = mint(0)\n                for k in range(p):\n                    x += self.at(i, k) * other.at(k, j)\n                result.set_at(i, j, x)\n        return result\n\ndef mat_pow(t, k):\n    A = t\n    B = Matrix.identity(t.height())\n    while k > 0:\n        if k & 1:\n            B = B * A\n        A = A * A\n        k >>= 1\n    return B\n\ndef get_rotate_matrix(k, t):\n    t = (t % k + k) % k\n    A = Matrix(k + 3, k + 3)\n    for i in range(k):\n        A.set_at(i, (i + t) % k, 1)\n    A.set_at(k, k, 1)\n    A.set_at(k+1, k+1, 1)\n    A.set_at(k+2, k+2, 1)\n    return A\n\ndef get_singleton_matrix(k, j):\n    assert 0 <= j < k\n    A = Matrix(k + 3, k + 3)