{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n#define mod 1000000007\n#define N 33\n#define int long long\nint bin[N*2],n,m;\nstruct matrix{ \n    int mat[N][N];\n    inline matrix operator * (const matrix &a) const {\n        matrix res;\n        memset(res.mat,0,sizeof(res.mat));\n        for (int i=0;i<=m;++i){\n            for (int j=0;j<=m;++j){\n                for (int k=0;k<=m;++k){\n                    res.mat[i][j]=(res.mat[i][j]+mat[i][k]*a.mat[k][j])%mod;\n                }\n            }\n        }\n        return res;\n    }\n}ans,P[N*2][N],S[N*2][N],A[N*2][N];\nint read(){\n    int x=0,f=1;\n    char ch=getchar();\n    while (ch<'0' || ch>'9'){\n        if (ch=='-') f=-1;\n        ch=getchar();\n    }\n    while (ch>='0' && ch<='9'){\n        x=x*10+ch-'0';ch=getchar();\n    }\n    return x*f;\n}\nsigned main(){\n    n=read(),m=read();\n    int n2=n,len=-1;\n    while (n2){ \n        len++;bin[len]=n2%m;n2=n2/m;\n    }\n    len++;\n    for (int i=0;i<=m;++i) ans.mat[0][i]=1; \n    for (int i=0;i<len;++i){\n        for (int j=0;j<=m;++j) A[i][0].mat[j][j]=1;\n        if (!i){ \n            for (int j=0;j<m;++j){\n                A[i][j].mat[m][m]=1;\n                for (int k=0;k<m;++k){\n                    if (k!=j){\n                        A[i][j].mat[k][k]=1;\n                        continue;\n                    }\n                    for (int l=0;l<=m;++l) A[i][j].mat[k][l]=1;\n                }\n            }\n        }else{\n            for (int j=0;j<m;++j){\n                if (!j) A[i][j]=S[i-1][0]; \n                else A[i][j]=S[i-1][j]*P[i-1][j-1];\n            }\n        }\n        P[i][0]=A[i][0];\n        for (int j=1;j<m;++j) P[i][j]=P[i][j-1]*A[i][j];\n        S[i][m-1]=A[i][m-1];\n        for (int j=m-2;j>=0;--j) S[i][j]=A[i][j]*S[i][j+1];\n    }\n    int j=0;\n    for (int i=len-1;i>=0;--i){\n        while (bin[i] --> 0){\n            ans=ans*A[i][j];j++;if (j==m) j=0;\n        }\n    }\n    cout<<ans.mat[0][m]<<endl;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\nclass Matrix:\n    def __init__(self, n, data=None):\n        self.n = n\n        if data is not None:\n            self.mat = [row[:] for row in data]\n        else:\n            self.mat = [[0] * n for _ in range(n)]\n\n    def __mul__(self, other):\n        n = self.n\n        res = Matrix(n)\n        for i in range(n):\n            self_row = self.mat[i]\n            res_row = res.mat[i]\n            for k in range(n):\n                aik = self_row[k]\n                if aik == 0:\n                    continue\n                other_row_k = other.mat[k]\n                for j in range(n):\n                    res_row[j] = (res_row[j] + aik * other_row_k[j]) % MOD\n        return res\n\n    def copy(self):\n        return Matrix(self.n, self.mat)\n\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n\n    # base-m digits (least significant first)\n    digits = []\n    n2 = n\n    while n2:\n        digits.append(n2 % m)\n        n2 //= m\n    length = len(digits)\n\n    # ans matrix: first row all ones\n    ans = Matrix(m + 1)\n    for j in range(m + 1):\n        ans.mat[0][j] = 1\n\n    if length == 0:\n        # n == 0\n        print(ans.mat[0][m])\n        return\n\n    # preallocate A, P, S as lists of length 'length' with m columns each\n    A = [None] * length\n    P = [None] * length\n    S = [None] * length\n\n    for i in range(length):\n        A[i] = [None] * m\n        P[i] = [None] * m\n        S[i] = [None] * m\n\n        # set A[i][0] as identity\n        ident = Matrix(m + 1)\n        for d in range(m + 1):\n            ident.mat[d][d] = 1\n        A[i][0] = ident\n\n        if i == 0:\n            for j in range(m):\n                mat = Matrix(m + 1)\n                # set bottom-right corner to 1\n                mat.mat[m][m] = 1\n                for k in range(m):\n                    if k != j:\n                        mat.mat[k][k] = 1\n                    else:\n                        for l in range(m + 1):\n                            mat.mat[k][l] = 1\n                A[i][j] = mat\n        else:\n            for j in range(m):\n                if j == 0:\n                    A[i][j] = S[i - 1][j].copy()\n                else:\n                    A[i][j] = S[i - 1][j] * P[i - 1][j - 1]\n\n        # compute P and S for this i\n        P[i][0] = A[i][0].copy()\n        for j in range(1, m):\n            P[i][j] = P[i][j - 1] * A[i][j]\n\n        S[i][m - 1] = A[i][m - 1].copy()\n        for j in range(m - 2, -1, -1):\n            S[i][j] = A[i][j] * S[i][j + 1]\n\n    # process digits from most significant to least\n    j_idx = 0\n    for i in range(length - 1, -1, -1):\n        cnt = digits[i]\n        for _ in range(cnt):\n            ans = ans * A[i][j_idx]\n            j_idx += 1\n            if j_idx == m:\n                j_idx = 0\n\n    