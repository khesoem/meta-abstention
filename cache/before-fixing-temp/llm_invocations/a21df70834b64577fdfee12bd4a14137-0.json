= modInv(root);\n        }\n        long[] roots = new long[k];\n        if (k > 0) {\n            roots[k - 1] = root;\n        }\n        for (int i = k - 1; i > 0; i--) {\n            roots[i - 1] = (roots[i] * roots[i]) % MOD;\n        }\n        return roots;\n    }\n\n    /**\n     * Change the indicies of an array, putting them into bit-reverse order.\n     * array should have length 2^k\n     */\n    private static long[] reorderArray(long[] a, int k) {\n        long[] ans = new long[a.length];\n        for (int i = 0; i < a.length; i++) {\n            ans[bitReverse(i, k)] = a[i];\n        }\n        return ans;\n    }\n\n    /**\n     * coef.length = 2^k\n     * Note: When computing the inverse, this function will return 2^k times the\n     * correct answer. Please divide as needed.\n     */\n    private static long[] numberTheoreticTransform(long[] coef, int k, boolean inverse) {\n        coef = reorderArray(coef, k);\n        long[] roots = calcRoots(k, inverse);\n        for (int s = 0; s < k; s++) {\n            int len = 1 << s;\n            for (int st = 0; st < coef.length; st += 2 * len) {\n                // combine the vectors starting at st and st + len\n                long curRoot = 1;\n                for (int j = st; j < st + len; j++) {\n                    long t = (curRoot * coef[j + len]) % MOD;\n                    long u = coef[j];\n                    coef[j] = (u + t) % MOD;\n                    coef[j + len] = (u - t) % MOD;\n                    curRoot = (roots[s] * curRoot) % MOD;\n                }\n            }\n        }\n        return coef;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt() / 2;\n        int m = sc.nextInt();\n        int[] nums = new int[m];\n        int max = 0;\n        for (int i = 0; i < m; i++) {\n            nums[i] = sc.nextInt();\n            max = Math.max(max, nums[i]);\n        }\n        int min_size = n * max + 1;\n        int k = 0;\n        int size = 1;\n        while (size < min_size) {\n            size *= 2;\n            k++;\n        }\n        long[] a = new long[size];\n        for (int i = 0; i < nums.length; i++) {\n            a[nums[i]] = 1;\n        }\n        a = numberTheoreticTransform(a, k, false);\n        for (int i = 0; i < size; i++) {\n            a[i] = modPow(a[i], n);\n        }\n        a = numberTheoreticTransform(a, k, true);\n        long ans = 0;\n        for (int i = 0; i < size; i++) {\n            ans = (ans + a[i] * a[i]) % MOD;\n        }\n        long multiplier = modInv(size);\n        System.out.println((((ans * multiplier) % MOD) * multiplier) % MOD);\n    }\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "#include <bits/stdc++.h>\nusing namespace std;\n\nconst long long MOD = 998244353;\nconst int twoPow = 23;\nconst int ROOT = 15311432;\n\nint bitReverse(int n, int k) {\n    n = ((n & 0x55555555) << 1) | ((n & 0xAAAAAAAA) >> 1);\n    n = ((n & 0x33333333) << 2) | ((n & 0xCCCCCCCC) >> 2);\n    n = ((n & 0x0F0F0F0F) << 4) | ((n & 0xF0F0F0F0) >> 4);\n    n = ((n & 0x00FF00FF) << 8) | ((n & 0xFF00FF00) >> 8);\n    n = ((n & 0x0000FFFF) << 16) | ((n & 0xFFFF0000) >> 16);\n    return n >>> (32 - k);\n}\n\nlong long modPow(long long a, long long p) {\n    long long result = 1;\n    a %= MOD;\n    while (p > 0) {\n        if (p & 1) result = (result * a) % MOD;\n        a = (a * a) % MOD;\n        p >>= 1;\n    }\n    return result;\n}\n\nlong long modInv(long long a) {\n    return modPow(a, MOD - 2);\n}\n\nvector<long long> calcRoots(int k, bool inverse) {\n    long long root = modPow(ROOT, (1LL << twoPow - k));\n    if (inverse) {\n        root = modInv(root);\n    }\n    vector<long long> roots(k);\n    if (k > 0) {\n        roots[k - 1] = root;\n    }\n    for (int i = k - 1; i > 0; i--) {\n        roots[i - 1] = (roots[i] * roots[i]) % MOD;\n    }\n    return roots;\n}\n\nvector<long long> reorderArray(const vector<long long>& a, int k) {\n    int n = a.size();\n    vector<long long> ans(n);\n    for (int i = 0; i < n; i++) {\n        ans[bitReverse(i, k)] = a[i];\n    }\n    return ans;\n}\n\nvector<long long> numberTheoreticTransform(vector<long long> coef, int k, bool inverse) {\n    coef = reorderArray(coef, k);\n    vector<long long> roots = calcRoots(k, inverse);\n    for (int s = 0; s < k; s++) {\n        int len = 1 << s;\n        for (int st = 0; st < (int)coef.size(); st += 2 * len) {\n            long long curRoot = 1;\n            for (int j = st; j < st + len; j++) {\n                long long t = (curRoot * coef[j + len]) % MOD;\n                long long u = coef[j];\n                coef[j] = (u + t) % MOD;\n                coef[j + len] = (u - t + MOD) % MOD;\n                curRoot = (roots[s] * curRoot) % MOD;\n            }\n        }\n    }\n    return coef;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n_input, m;\n    cin >> n_input >> m;\n    int n = n_input / 2;\n    vector<int> nums(m);\n    int max_val = 0;\n    for (int i = 0; i < m; i++) {\n        cin >> nums[i];\n        max_val = max(max_val, nums[i]);\n    }\n    int min_size = n * max_val + 1;\n    int size = 1;\n    int k = 0;\n    while (size < min_size) {\n        size <<= 1;\n        k++;\n    }\n    vector<long long> a(size, 0);\n    for (int num : nums) {\n        a[num] = 1;\n    }\n    a = numberTheoreticTransform(a, k, false);\n    for (int i = 0; i < size; i++) {\n        a[i] = modPow(a[i], n);\n    }\n    a = numberTheoreticTransform(a, k, true);\n    long long ans = 0;\n    for (int i = 0; i < size; i++) {\n        ans = (ans + a[i] * a[i]) % MOD;\n    }\n    long long multiplier = modInv(size);\n    cout << ((ans * multiplier) % MOD * multiplier) % MOD << \"\\n\";\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0077146