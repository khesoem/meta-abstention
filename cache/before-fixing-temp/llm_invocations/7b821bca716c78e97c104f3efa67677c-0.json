g dfs(int pos, long flow, int t) {\n            if (pos == t) return flow;\n            vis[pos] = true;\n            long tmp = flow;\n            for (int i = cur[pos] != -1 ? cur[pos] : head[pos]; i != -1; i = nxt[i]) {\n                if (!vis[v[i]] && w[i] > 0 && dis[v[i]] == dis[pos] + c[i]) {\n                    cur[pos] = i;\n                    long fl = dfs(v[i], Math.min(flow, w[i]), t);\n                    totalCost += fl * c[i];\n                    w[i] -= fl;\n                    w[i ^ 1] += fl;\n                    flow -= fl;\n                    if (flow == 0) break;\n                }\n            }\n            return tmp - flow;\n        }\n\n        void addEdge(int u, int v_, long ww, int cc) {\n            paddEdge(u, v_, ww, cc);\n            paddEdge(v_, u, 0, -cc);\n        }\n\n        long dinic(int s, int t) {\n            totalCost = 0;\n            this.t = t;\n            while (spfa(s, t)) {\n                Arrays.fill(cur, -1);\n                Arrays.fill(vis, false);\n                dfs(s, INF, t);\n            }\n            return totalCost;\n        }\n\n        FlowGraph() {\n            Arrays.fill(head, -1);\n            Arrays.fill(nxt, -1);\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int kk = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] a = new int[kk + 1];\n        for (int i = 1; i <= kk; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        int s = 0;\n        int t = n * 100 + 1;\n        FlowGraph g = new FlowGraph();\n        for (int i = 1; i <= 100; i++) {\n            g.addEdge(i, t, INF, 0);\n        }\n        for (int i = 1; i <= kk; i++) {\n            g.addEdge(s, (a[i] - 1) * 100 + 1, 1, 0);\n        }\n        for (int i = 2; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                g.addEdge((i - 1) * 100 + j, (i - 1) * 100 + j + 1, INF, c);\n            }\n        }\n\n        for (int _ = 0; _ < m; _++) {\n            int t1 = sc.nextInt();\n            int t2 = sc.nextInt();\n            for (int i = 1; i < 100; i++) {\n                int val = c + d * (i * i - (i - 1) * (i - 1));\n                g.addEdge((t1 - 1) * 100 + i, (t2 - 1) * 100 + i + 1, 1, val);\n                g.addEdge((t2 - 1) * 100 + i, (t1 - 1) * 100 + i + 1, 1, val);\n            }\n        }\n        System.out.println(g.dinic(s, t));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0003044802288059145, -4.203409844194539e-05, -7.896309739408025e-07, -6.504040356958285e-05, -4.723352049040841e-06, -3.128163257315464e-07, -0.001730391290038824, -0.35908043384552, -0.20142045617103577, -4.320199877838604e-07, -0.3972364664077759, -1.1160349458805285e-05, -0.038046542555093765, -0.03865675628185272, -0.004503584932535887, -0.1284181922674179, -0.22626091539859772, -0.0003357006062287837, -0.0019397038267925382, -1.27099974633893e-05, -5.512236498361744e-07, -2.339278580620885e-06, -9.088346359931165e-07, -0.11456660181283951, -1.1472419600977446e-06, -1.7432603272027336e-06, -0.00011796683247666806, -0.0021857109386473894, -7.111979357432574e-05, -2.935296834039036e-06, -1.8624639324116288e-06, -2.176947600673884e-05, -6.704273118884885e-07, -1.282920129597187e-05, -0.0002238013403257355, -3.054500666621607e-06, -2.0339031834737398e-05, -0.0019395847339183092, -3.054500666621607e-06, -0.31430622935295105, -2.7133641196996905e-05, -1.0802738870552275e-05, -9.491498531133402e-06, -4.008129963040119e-06, -0.0018888992490246892, -9.088346359931165e-07, -1.981667537620524e-06, -0.11306007206439972, -5.080963092041202e-06, -0.005220594350248575, -3.531315314830863e-06, -0.14335955679416656, -0.00016516048344783485, -0.00018685187387745827, -6.704273118884885e-07, -0.023269006982445717, -0.0003766919835470617, -5.79618472329