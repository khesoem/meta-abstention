ic_bfs(self, s, t):\n        self.vis = [0] * self.n\n        q = deque([s])\n        self.vis[s] = 1\n        while q:\n            u = q.popleft()\n            for e in self.g[u]:\n                v, _, c, w = e\n                if self.vis[v] or not c:\n                    continue\n                if self.dis[v] != self.dis[u] + w - self.pot[v] + self.pot[u]:\n                    continue\n                self.vis[v] = self.vis[u] + 1\n                q.append(v)\n        return self.vis[t] != 0\n\n    def dinic_dfs(self, u, t, f):\n        if u == t:\n            return f\n        sf = 0\n        while self.cur[u] < len(self.g[u]):\n            e = self.g[u][self.cur[u]]\n            v, rev, c, w = e\n            if c and self.vis[v] == self.vis[u] + 1 and self.dis[v] == self.dis[u] + w - self.pot[v] + self.pot[u]:\n                df = self.dinic_dfs(v, t, min(c, f))\n                if df:\n                    sf += df\n                    f -= df\n                    e[2] -= df\n                    self.g[v][rev][2] += df\n                    if not f:\n                        break\n            self.cur[u] += 1\n        return sf\n\n    def mincostflow(self, s, t, mf):\n        sf = 0\n        sc = 0\n        self.pot = [0] * self.n\n        while self.dijkstra(s, t):\n            f = 0\n            while self.dinic_bfs(s, t):\n                self.cur = [0] * self.n\n                df = self.dinic_dfs(s, t, mf)\n                mf -= df\n                f += df\n                if not mf:\n                    break\n            sf += f\n            sc += (self.dis[t] + self.pot[t]) * f\n            for i in range(self.n):\n                self.pot[i] += self.dis[i]\n            if not mf:\n                break\n        return sf, sc\n\ndef main():\n    mcmf = MCMF()\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    l = max(n, k) * 2\n    mcmf.addv(l * n)\n    s = mcmf.addv(1)\n    t = mcmf.addv(1)\n    for _ in range(k):\n        a = int(next(it)) - 1\n        mcmf.adde(s, a, 1, 0)\n    for _ in range(m):\n        u = int(next(it)) - 1\n        v = int(next(it)) - 1\n        for i in range(l - 1):\n            u1 = u + i * n\n            v1 = v + (i + 1) * n\n            u2 = u + (i + 1) * n\n            v2 = v + i * n\n            for j in range(k):\n                w = c + d * (2 * j + 1)\n                mcmf.adde(u1, v1, 1, w)\n                mcmf.adde(v2, u2, 1, w)\n    for i in range(l - 1):\n        for j in range(n):\n            u = j + i * n\n            v = j + (i + 1) * n\n            mcmf.adde(u, v, INF, c)\n    for i in range(l):\n        mcmf.adde(i * n, t, INF, 0)\n    result = mcmf.mincostflow(s, t, INF)[1]\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.3909487e-06, 0.0, -7.152555e-07, -0.0041109347, -0.016975928, -0.03905205, -0.0022793047, -0.038071252, -0.1074642, -0.062200643, -0.04013393, -0.055841014, -5.960463e-07, -0.00030417583, -0.0111544365, -0.1899172, -8.237023e-05, -0.052261706, -0.0017412038, -0.011049629, -0.10453689, -0.014936163, -0.0050723436, -0.01373448, -0.0001491197, -2.0265559e-06, -4.088795e-05, -8.344616e-06, -0.10661665, -1.7881378e-06, -1.1920928e-07, -4.7683704e-07, -1.1920928e-07, -0.5759558, -1.1920928e-07, -6.794699e-05, -0.011605959, -2.2649509e-05, -6.5564896e-06, -0.008140598, -0.00038437606, -0.0004774384, 0.0, -2.7418098e-06, -1.5047755, -9.1790735e-06, -1.3232144e-05, -0.0009664394, -0.00025710138, 0.0, -1.072883e-06, -0.0008422165, -1.072883e-06, -0.039092403, -4.0531077e-06, 0.0, 0.0, 0.0, -0.00055583764, 0.0, -0.006427449, -0.002543074, -9.5367386e-07, -0.033737518, -4.1245563e-05, -1.1920928e-07, -2.860982e-05, -0.00055929273, -0.07889063, -7.152555e-07, -6.0437284e-05, -1.1920928e-07, -3.4570635