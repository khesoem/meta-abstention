\n\t\t\t\tll cur=q.top();\n\t\t\t\tint d=cur>>32, u=cur;\n\t\t\t\tq.pop();\n\t\t\t\tif(d!=prio[u])\n\t\t\t\t\tcontinue;\n\t\t\t\tfor(int i=0; i<SZ(adj[u]); ++i) {\n\t\t\t\t\tEdge &e=adj[u][i];\n\t\t\t\t\tint v=e.to;\n\t\t\t\t\tif (e.cap<=e.f)\n\t\t\t\t\t\tcontinue;\n\t\t\t\t\tint nprio=prio[u]+e.cost+pot[u]-pot[v];\n\t\t\t\t\tif (prio[v]>nprio) {\n\t\t\t\t\t\tprio[v]=nprio;\n\t\t\t\t\t\tq.push(((ll)nprio<<32)+v);\n\t\t\t\t\t\tprevnode[v]=u;\n\t\t\t\t\t\tprevedge[v]=i;\n\t\t\t\t\t\tcurflow[v]=min(curflow[u], e.cap-e.f);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prio[t]==INT_MAX)\n\t\t\t\tbreak;\n\t\t\tfor(int i=0; i<n; ++i)\n\t\t\t\tpot[i]+=prio[i];\n\t\t\tint df=min(curflow[t], INF-flow);\n\t\t\tflow+=df;\n\t\t\tfor(int v=t; v!=s; v=prevnode[v]) {\n\t\t\t\tEdge &e=adj[prevnode[v]][prevedge[v]];\n\t\t\t\te.f+=df;\n\t\t\t\tadj[v][e.rev].f-=df;\n\t\t\t\tflowCost+=df*e.cost;\n\t\t\t}\n\t\t}\n\t\treturn make_pair(flow, flowCost);\n\t}\n};\n\nint n,m,k,c,d;\n \nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\tMCF nt(6+107*n);\n\tfore(_,0,k){\n\t\tint x;\n\t\tscanf(\"%d\",&x);x--;\n\t\tnt.addEdge(0,1+x,1,0);\n\t}\n\tfore(_,0,m){\n\t\tint x,y;\n\t\tscanf(\"%d%d\",&x,&y);x--;y--;\n\t\tfore(i,0,105){\n\t\t\tfore(j,0,51){\n\t\t\t\tnt.addEdge(1+i*n+x,1+(i+1)*n+y,1,c+d*(2*j+1));\n\t\t\t\tnt.addEdge(1+i*n+y,1+(i+1)*n+x,1,c+d*(2*j+1));\n\t\t\t}\n\t\t}\n\t}\n\tfore(i,0,105)fore(j,0,n)nt.addEdge(1+i*n+j,1+(i+1)*n+j,51,c);\n\tfore(i,0,105)nt.addEdge(1+i*n,1+105*n,51,0);\n\tauto ans=nt.minCostFlow(0,1+105*n);\n\tprintf(\"%d\\n\",ans.snd);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MCF:\n    def __init__(self, n):\n        self.n = n\n        self.u = [0] * n\n        self.v = [0] * n\n        self.prio = [0] * n\n        self.curflow = [0] * n\n        self.prevedge = [0] * n\n        self.prevnode = [0] * n\n        self.pot = [0] * n\n        self.adj = [[] for _ in range(n)]\n\n    def addEdge(self, s, t, cap, cost):\n        a = Edge(t, 0, cap, cost, len(self.adj[t]))\n        b = Edge(s, 0, 0, -cost, len(self.adj[s]))\n        self.adj[s].append(a)\n        self.adj[t].append(b)\n\n    def minCostFlow(self, s, t):\n        INF = 10**18\n        flow = 0\n        flowCost = 0\n        while flow < INF:\n            self.prio = [INF] * self.n\n            self.curflow = [0] * self.n\n            self.prio[s] = 0\n            self.curflow[s] = INF\n            pq = []\n            heapq.heappush(pq, (0, s))\n            while pq:\n                d, u = heapq.heappop(pq)\n                if d != self.prio[u]:\n                    continue\n                for i, e in enumerate(self.adj[u]):\n                    v = e.to\n                    if e.cap <= e.f:\n                        continue\n                    nprio = self.prio[u] + e.cost + self.pot[u] - self.pot[v]\n                    if self.prio[v] > nprio:\n                        self.prio[v] = nprio\n                        heapq.heappush(pq, (nprio, v))\n                        self.prevnode[v] = u\n                        self.prevedge[v] = i\n                        self.curflow[v] = min(self.curflow[u], e.cap - e.f)\n            if self.prio[t] == INF:\n                break\n            for i in range(self.n):\n                self.pot[i] += self.prio[i]\n            df = min(self.curflow[t], INF - flow)\n            flow += df\n            v = t\n            while v != s:\n                u = self.prevnode[v]\n                e = self.adj[u][self.prevedge[v]]\n                e.f += df\n                rev = e.rev\n                self.adj[v][rev].f -= df\n                flowCost += df * e.cost\n                v = u\n        return (flow, flowCost)\n\nclass Edge:\n    __slots__ = ('to', 'f', 'cap', 'cost', 'rev')\n    def __init__(self, to, f, cap, cost, rev):\n        self.to = to\n        self.f = f\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    nt = MCF(6 + 107 * n)\n    for _ in range(k):\n        x = int(next(it)) - 1\n        nt.addEdge(0, 1 + x, 1, 0)\n    for _ in range(m):\n        x = int(next(it)) - 1\n        y = int(next(it)) - 1\n        for i in range(105):\n            for j in range(51):\n                nt.addEdge(1 + i * n + x, 1 + (i + 1) * n + y, 1, c + d * (2 * j + 1))\n                nt.addEdge(1 + i * n + y, 1 + (i + 1) * n + x, 1, c + d * (2 * j + 1))\n    for i in range(105):\n        for j in range(n):\n            nt.addEdge(1 + i * n + j, 1 + (i + 1) * n + j, 51, c)\n    for i in range(105):\n        nt.addEdge(1 + i * n, 1 + 105 * n, 51, 0)\n    ans = nt.minCostFlow(0, 1 + 105 * n)\n    print(ans[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-2.3841855067985307e-07, -8.344646857949556e-07, 0.0, -0.00014208737411536276, -0.0016801540041342378, -0.07895485311746597, -0.029772287234663963, -0.0002641328901518136, -0.00017176583060063422, -0.038185425102710724, -0.16139329969882965, -0.8264654874801636, -3.576278118089249e-07, -2.098061486321967e-05, -3.933898824470816e-06, -0.003316855989396572, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -3.3378546504536644e-06, -6.6756979322235566e-06, -0.00017379203927703202, 0.0, -1.311301275563892e-06, -2.9802276912960224e-06, -3.576278118089249e-07, -1.1920928244535389e-07, -0.00017689094238448888, 0.0, -0.00047159992391243577, -0.27473849058151245, -2.3841855067985307e-07, -0.00024351492174901068, -0.0002942844294011593, -0.6933981776237488, -3.933898824470816e-06, -2.3841830625315197e-06, -0.004473440814763308, 0.0, 0.0, -2.38