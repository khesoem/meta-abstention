{\n            Arrays.fill(depth, -1);\n            depth[s] = 0;\n            ArrayDeque<Integer> q = new ArrayDeque<>();\n            q.add(s);\n            while (!q.isEmpty()) {\n                int v = q.poll();\n                for (int[] edge : links[v]) {\n                    int to = edge[1], idx = edge[2];\n                    if (edge[0] > 0 && depth[to] < 0) {\n                        depth[to] = depth[v] + 1;\n                        q.add(to);\n                    }\n                }\n            }\n        }\n\n        void dfs(int v, int t, int flow) {\n            if (v == t) {\n                return;\n            }\n            for (int i = progress[v]; i < links[v].length; i++) {\n                progress[v] = i;\n                int[] edge = links[v][i];\n                if (edge[0] == 0 || depth[v] >= depth[edge[1]]) {\n                    continue;\n                }\n                dfs(edge[1], t, Math.min(flow, edge[0]));\n                edge[0] -= flow;\n                links[edge[1]][edge[2]][0] += flow;\n                return;\n            }\n        }\n\n        int flow(int s, int t) {\n            int flow = 0;\n            while (true) {\n                bfs(s);\n                if (depth[t] < 0) {\n                    return flow;\n                }\n                Arrays.fill(progress, 0);\n                dfs(s, t, Integer.MAX_VALUE);\n                while (true) {\n                    int currentFlow = 0;\n                    for (int i = 0; i < progress.length; i++) {\n                        if (depth[i] != -1 && progress[i] < links[i].length) {\n                            currentFlow += links[i][progress[i]][0];\n                        }\n                    }\n                    if (currentFlow == 0) {\n                        break;\n                    }\n                    flow += currentFlow;\n                    dfs(s, t, currentFlow);\n                }\n            }\n        }\n\n        int[][] getEdges() {\n            int M = pos.length;\n            int[][] res = new int[M][4];\n            for (int i = 0; i < M; i++) {\n                int[] edge = links[pos[i][0]][pos[i][1]];\n                res[i] = new int[] { pos[i][0], edge[1], edge[0] + links[edge[1]][edge[2]][0], links[edge[1]][edge[2]][0] };\n            }\n            return res;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        br = new BufferedReader(new InputStreamReader(System.in));\n        out = new PrintWriter(System.out);\n        int N = nextInt();\n        int M = 3;\n        int[] A = new int[M];\n        for (int i = 0; i < M; i++) {\n            A[i] = nextInt();\n        }\n\n        int ans1 = 0;\n        for (int i = 0; i < M; i++) {\n            ans1 += Math.min(A[i], A[(i + 1) % M]);\n        }\n\n        Dinic dinic = new Dinic(2 * M + 2);\n        int s = 2 * M;\n        int t = 2 * M + 1;\n        for (int i = 0; i < M; i++) {\n            dinic.addEdge(s, i, N);\n            dinic.addEdge(M + i, t, A[i]);\n            dinic.addEdge(i, M + i, A[i]);\n            dinic.addEdge(i, M + (i - 1) % M, A[i]);\n        }\n        int ans2 = N - dinic.flow(s, t);\n\n        out.println(ans2 + \" \" + ans1);\n        out.close();\n    }\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.6078833937644958, -0.00013447711535263807, -0.033120959997177124, -0.00038559717359021306, -1.9073504518019035e-06, -0.3985050618648529, -0.6129478812217712, -8.344653679159819e-07, -1.1920930376163597e-07, -1.0728841743912199e-06, -0.09752319008111954, -1.1920930376163597e-07, -0.00027070133364759386, -1.8596821973915212e-05, -4.768372718899627e-07, -0.21495278179645538, -0.0010713711380958557, -3.802848732448183e-05, -3.099446303167497e-06, -4.768372718899627e-07, -0.00014938040112610906, -0.9903796911239624, -1.0848104466276709e-05, -1.1920930376163597e-07, -1.4806793928146362, -0.016320785507559776, -1.3113030945532955e-06, -8.3446536791