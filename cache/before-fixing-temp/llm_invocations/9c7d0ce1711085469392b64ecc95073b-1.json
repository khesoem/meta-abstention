ange(max_j + 1):\n            # state 0\n            if j + l[i] + delt[i] <= max_j:\n                dp0_cur[j] = dp0_next[j + l[i] + delt[i]]\n            # state 1: initial copy from next layer (no flip)\n            dp1_cur[j] = dp1_next[j]\n            # update dp0_cur with 1 flip from state 1\n            dp0_cur[j] = min(dp0_cur[j], 1 + rmq1.min(j, min(j + l[i], max_j)))\n            # updates involving delta\n            if j + delt[i] <= max_j:\n                # state1 from state0 with 1 flip\n                dp1_cur[j] = min(dp1_cur[j], 1 + rmq0.min(j + delt[i], min(j + l[i] + delt[i], max_j)))\n                # state0 from state0 with 2 flips\n                dp0_cur[j] = min(dp0_cur[j], 2 + rmq0.min(j + delt[i], min(j + l[i] + delt[i], max_j)))\n            # state1 from state1 with 2 flips\n            dp1_cur[j] = min(dp1_cur[j], 2 + rmq1.min(j, min(j + l[i], max_j)))\n        # after finishing row i, set next to current and build new rmq\n        dp0_next = dp0_cur\n        dp1_next = dp1_cur\n        rmq0 = RMQ(dp0_next)\n        rmq1 = RMQ(dp1_next)\n    \n    ans = dp1_next[0]\n    if ans == INF:\n        print(\"Hungry\")\n    else:\n        print(\"Full\")\n        print(ans)\n\nclass RMQ:\n    def __init__(self, a):\n        self.n = len(a)\n        self.log = self.n.bit_length()\n        self.min = [[0] * self.n for _ in range(self.log)]\n        for i in range(self.n):\n            self.min[0][i] = a[i]\n        for k in range(1, self.log):\n            step = 1 << (k - 1)\n            for i in range(self.n - step):\n                self.min[k][i] = min(self.min[k-1][i], self.min[k-1][i + step])\n    \n    def min(self, a, b):\n        # inclusive range [a, b]\n        length = b - a + 1\n        k = length.bit_length() - 1\n        return min(self.min[k][a], self.min[k][b - (1 << k) + 1])\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-1.1920928244535389e-07, -8.225102646974847e-05, -4.410734163684538e-06, -7.86778218