o[v]]=true);\n    }\n    return dep[t]<iinf;\n}\npair<int,int> mcmf(){\n    pair<int,int> res(0,0);\n    while(spfa()){\n        int f=iinf;\n        for(int u=t;u!=s;u=to[pre[u]^1]) f=min(f,fw[pre[u]]);\n        for(int u=t;u!=s;u=to[pre[u]^1]) fw[pre[u]]-=f,fw[pre[u]^1]+=f;\n        res.x+=f,res.y+=dep[t]*f;\n    }\n    return res;\n}\n\n//Main\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0),cout.tie(0);\n    cin>>n>>m>>k>>c>>d,mxt=N*3+1;\n    fn=(t=(s=n*mxt)+1)+1;\n    R(i,0,k){int u;cin>>u,--u,adde(s,u,1,0);}\n    while(m--){\n        int u,v; cin>>u>>v,--u,--v;\n        R(i,0,mxt-1)R(p,1,k+1)\n            adde(i*n+u,(i+1)*n+v,1,2*d*p-d),\n            adde(i*n+v,(i+1)*n+u,1,2*d*p-d);\n    }\n    R(u,0,n)R(i,0,mxt-1) adde(i*n+u,(i+1)*n+u,k,0);\n    R(i,0,mxt) adde(i*n,t,k,i*c);\n    pair<int,int> ans=mcmf();\n    assert(ans.x==k);\n    cout<<ans.y<<'\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\ndef main():\n    input = sys.stdin.readline\n    n, m, k, c, d = map(int, input().split())\n    mxt = 151  # N*3+1 with N=50\n    N_nodes = n * mxt + 2\n    s = n * mxt\n    t = s + 1\n    e = [[] for _ in range(N_nodes)]\n    to = []\n    fw = []\n    co = []\n\n    def adde(u, v, w, cost):\n        e[u].append(len(to))\n        to.append(v)\n        fw.append(w)\n        co.append(cost)\n        e[v].append(len(to))\n        to.append(u)\n        fw.append(0)\n        co.append(-cost)\n\n    for _ in range(k):\n        u = int(input()) - 1\n        adde(s, u, 1, 0)\n\n    for _ in range(m):\n        u, v = map(int, input().split())\n        u -= 1\n        v -= 1\n        for i in range(mxt - 1):\n            for p in range(1, k + 1):\n                adde(i * n + u, (i + 1) * n + v, 1, 2 * d * p - d)\n                adde(i * n + v, (i + 1) * n + u, 1, 2 * d * p - d)\n\n 