inue;\n        if(int df = dfs(v, min(f, e.cap - e.f))) {\n            e.f += df;\n            adj[v][e.rev].f -= df;\n            return df;\n        }\n    }\n    return 0;\n}\n\nint mf() {\n    int res = 0;\n    while(bfs()) {\n        memset(ptr, 0, sizeof ptr);\n        while(int df = dfs(src, INF))\n            res += df;\n    }\n    return res;\n}\n\nint dx[] = {-1, 0, 0, 1};\nint dy[] = {0, -1, 1, 0};\n\nint n, m;\ntypedef vector<vector<int>> grid;\ntypedef array<int, 2> pa;\ngrid obs, tim, dii;\n\nvoid gbfs(int r, int c, grid &dis, bool chk = false) {\n    for(int i = 0; i < n; i++)\n        fill(dis[i].begin(), dis[i].end(), -1);\n    dis[r][c] = 0;\n    queue<pa> q;\n    q.push({r, c});\n    while(q.size()) {\n        auto p = q.front(); q.pop();\n        if(chk && dis[p[0]][p[1]] == tim[p[0]][p[1]])\n        \tcontinue;\n        pa r;\n        for(int i = 0; i < 4; i++) {\n            r = {p[0] + dx[i], p[1] + dy[i]};\n            if(r[0] < 0 || r[0] >= n || r[1] < 0 || r[1] >= n || dis[r[0]][r[1]] != -1 || obs[r[0]][r[1]]) \n                continue;\n            if(chk && tim[r[0]][r[1]] > -1 && dis[p[0]][p[1]] + 1 > tim[r[0]][r[1]])\n            \tcontinue;\n            dis[r[0]][r[1]] = dis[p[0]][p[1]] + 1;\n            q.push(r);\n        }\n    }\n}\n\nvector<string> lab, rea;\n\nint main() {\n    cin >> n >> m;\n    lab.resize(n);\n    rea.resize(n);\n    for(auto &x : lab)\n        cin >> x;\n    for(auto &x : rea)\n        cin >> x;\n    obs.assign(n, vector<int>(n));\n    tim.assign(n, vector<int>(n));\n    dii.assign(n, vector<int>(n));\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tobs[i][j] = (lab[i][j] == 'Y');\n    for(int i = 0; i < n; i++)\n    \tfor(int j = 0; j < n; j++)\n    \t\tif(lab[i][j] == 'Z')\n    \t\t\tgbfs(i, j, tim);\n    src = 2*n*n + 5;\n    dst = src + 1;\n    for(int x = 0; x < n; x++) {\n    \tfor(int y = 0; y < n; y++) {\n    \t\tif(lab[x][y] == 'Z' || lab[x][y] == 'Y')\n    \t\t\tcontinue;\n    \t\tadd_edge(src, n*x + y, lab[x][y] - '0');\n    \t\tadd_edge(n*n + n*x + y, dst, rea[x][y] - '0');\n    \t\tgbfs(x, y, dii, true);\n    \t\tfor(int xp = 0; xp < n; xp++) {\n    \t\t\tfor(int yp = 0; yp < n; yp++) {\n    \t\t\t\tif(dii[xp][yp] != -1 && dii[xp][yp] <= m) {\n    \t\t\t\t\tadd_edge(n*x + y, n*n + n*xp + yp, INF);\n    \t\t\t\t}\n    \t\t\t}\n    \t\t}\n    \t}\n    }\n    cout << mf() << '\\n';\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\nsys.setrecursionlimit(1000000)\n\nINF = 10**9\n\n# Global variables for Dinic\nadj = []\ndis = []\nptr = []\nsrc = 0\ndst = 0\n\n# Global variables for grid\nn = 0\nm = 0\nobs = []\ntim = []\nlab = []\nrea = []\n\ndx = [-1, 0, 0, 1]\ndy = [0, -1, 1, 0]\n\ndef add_edge(u, v, c, rc=0):\n    global adj\n    # Forward edge: to, rev (index in adj[v] before adding reverse), f, cap\n    adj[u].append([v, len(adj[v]), 0, c])\n    # Reverse edge: to, rev (index of forward edge in adj[u]), f, cap\n    adj[v].append([u, len(adj[u]) - 1, 0, rc])\n\ndef bfs():\n    global dis, adj, src, dst\n    for i in range(len(dis)):\n        dis[i] = -1\n    q = deque()\n    dis[src] = 0\n    q.append(src)\n    while q:\n        u = q.popleft()\n        if u == dst:\n            break\n        for e in adj[u]:\n            v = e[0]\n            if dis[v] == -1 and e[2] < e[3]:\n                dis[v] = dis[u] + 1\n                q.append(v)\n    return dis[dst] != -1\n\ndef dfs(u, f):\n    if u == dst or f == 0:\n        return f\n    while ptr[u] < len(adj[u]):\n        e = adj[u][ptr[u]]\n        v = e[0]\n        if dis[v] == dis[u] + 1:\n            df = dfs(v, min(f, e[3] - e[2]))\n            if df > 0:\n                e[2] += df\n                adj[v][e[1]][2] -= df\n                return df\n        ptr[u] += 1\n    return 0\n\ndef mf():\n    global ptr\n    flow = 0\n    while bfs():\n        ptr = [0] * len(ptr)\n        while True:\n            df = dfs(src, INF)\n            if df == 0:\n                break\n            flow += df\n    return flow\n\ndef gbfs(r, c, dis_grid, chk=False):\n    global n, obs, tim, dx, dy\n    for i in range(n):\n        for j in range(n):\n            dis_grid[i][j] = -1\n    dis_grid[r][c] = 0\n    q = deque()\n    q.append((r, c))\n    while q:\n        p = q.popleft()\n        if chk and dis_grid[p[0]][p[1]] == tim[p[0]][p[1]]:\n            continue\n        for i in range(4):\n            nx = p[0] + dx[i]\n            ny = p[1] + dy[i]\n            if nx < 0 or nx >= n or ny < 0 or ny >= n:\n                continue\n            if dis_grid[nx][ny] != -1:\n                continue\n            if obs[nx][ny]:\n                continue\n            if chk and tim[nx][ny] > -1 and dis_grid[p[0]][p[1]] + 1 > tim[nx][ny]:\n                continue\n            dis_grid[nx][ny] = dis_grid[p[0]][p[1]] + 1\n            q.append((nx, ny))\n\ndef main():\n    global n, m, lab, rea, obs, tim, adj, dis, ptr, src, dst\n    input = sys.stdin.readline\n    n, m = map(int, input().split())\n    lab = [input().strip() for _ in range(n)]\n    rea = [input().strip() for _ in range(n)]\n\n    # Initialize grids\n    obs = [[0]*n for _ in range(n)]\n    tim = [[-1]*n for _ in range(n)]\n    dii = [[-1]*n for _ in range(n)]  # temporary, will be reused\n\n    # Fill obstacle grid\n    for i in range(n):\n        for j in range(n):\n            if lab[i][j] == 'Y':\n                obs[i][j] = 1\n\n    # Compute tim distances from Z cells (last Z overwrites)\n    for i in range(n):\n        for j in range(n):\n            if lab[i][j] == 'Z':\n                gbfs(i, j, tim, False)\n\n    # Build flow network\n    total_nodes = 2 * n * n + 7\n    adj = [[] for _ in range(total_nodes)]\n    dis = [0] * total_nodes\n    ptr = [0] * total_nodes\n    src = 2 * n * n + 5\n    dst = src + 1\n\n    for x in range(n):\n        for y in range(n):\n            ch = lab[x][y]\n            if ch == 'Z' or ch == 'Y':\n                continue\n            # digit characters\n            cap_src = ord(ch) - ord('0')\n            cap_dst = ord(rea[x][y]) - ord('0')\n            add_edge(src, n * x + y, cap_src)\n            add_edge(n * n + n * x + y, dst, cap_dst)\n\n            # Compute distances from (x, y) to all cells with time check\n            gbfs(x, y, dii, True)\n            for xp in range(n):\n                for yp in range(n):\n                    d = dii[xp][yp]\n                    if d != -1 and d <= m:\n                        add_edge(n * x + y, n * n + n * xp + yp, INF)\n\n    result = mf()\n    print(result)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.4424220353248529e-05, -1.1920928244535389e-07, -7.152555099310121e-07, -0.002581598935648799, -0.030542518943548203, 0.0, -3.6954811548639555e-06, -0.00035744477645494044, -3.576278118089249e-07, -1.1920928244535389e-07, 0.0, -4.264175891876221, -0.049152448773384094, 0.0, -1.1920928244535389e-07, 0.0, 0.0, -4.768370445162873e-07, -0.09238258004188538, -1.311301275563892e-06, -0.00045563330058939755, -0.0004668337933253497, -0.004544644616544247, -4.768370445162873e-07, -0.005235176533460617, -0.0008890252211131155, -0.1602332442998886, -8.344646857949556e-07, -0.04872654005885124, -0.028386017307639122, -0.6526632905006409, -0.09025663137435913, -0.0002553137019276619, -0.030873609706759453, -8.4638240878121e-06, -0.05520397052168846, -7.867782187531702e-06, -5.209310256759636e-05, -0.006736662704497576, -0.0004574206250254065, -9.536697689327411e-06, -0.0001264730526600033, -9.536738616588991e-07, -4.768370445162873e-07, -2.3364747903542593e-05, -4.541770613286644e-05, -3.0636318115284666e-05, -0.3142603933811188, -2.3841855067985307e-07, -1.1920922133867862e-06, -1.6689286894688848e-06, -7.152555099310121e-07, -2.38418550679853