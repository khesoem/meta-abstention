lse A[x][y]), ck)\n        Calc1(x, y-1, g + (ck * B[x][y]), ck)\n    \n    def Calc2(x, y, g, ck):\n        nonlocal Res, MM\n        if x + y == R + n:\n            if not Q[x][ck]:\n                return\n            target = (TT + 1) // 2\n            lo, hi = 0, len(Q[x][ck])-1\n            t = len(Q[x][ck])\n            while lo <= hi:\n                mid = (lo+hi)//2\n                if Q[x][ck][mid][0] >= target - g:\n                    t = mid\n                    hi = mid-1\n                else:\n                    lo = mid+1\n            if t < len(Q[x][ck]) and Q[x][ck][t][1] > 0:\n                tp = (Q[x][ck][t][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM == tp:\n                    Res += Q[x][ck][t][1]\n            if t > 0 and Q[x][ck][t-1][1] > 0:\n                tp = (Q[x][ck][t-1][0] + g) * 2 - TT\n                if tp < 0:\n                    tp = -tp\n                if MM == tp:\n                    Res += Q[x][ck][t-1][1]\n            return\n        if p[x+y-1] != 'B':\n            Calc2(x-1, y, g + (0 if ck else A[x][y]), ck)\n        if p[x+y-1] != 'A':\n            Calc2(x, y-1, g + (ck * B[x][y]), ck)\n    \n    Calc1(n, n, 0, 0)\n    Calc1(n, n, 0, 1)\n    Calc2(n, n, 0, 0)\n    Calc2(n, n, 0, 1)\n    print(Res)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.0333235e-06, 0.0, -1.072883e-06, -0.0009344026, -0.084324986, -0.0023970462, -0.16057727, -5.731399, -0.5767323, -0.00026222607, 0.0, -0.01817911, -0.048930664, -1.1334679, -0.7812621, -0.0041713617, -8.344616e-06, -0.035717014, -0.010499714, -1.5497195e-06, -2.3483954e-05, -1.0251946e-05, -4.7683704e-07, -5.19739e-05, -0.00010013079, -2.3841855e-07, -0.004111647, -1.716599e-05, -1.072883e-06, -0.008842242, -0.00021073982, -0.023838686, -1.072883e-06, -6.675698e-06, -0.0014484163, -0.038048185, -0.06098179, -2.4556812e-05, -0.00020442304, -5.245