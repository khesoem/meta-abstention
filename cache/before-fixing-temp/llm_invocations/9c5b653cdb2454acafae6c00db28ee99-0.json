 - y);\n    if (diff - ch[v1][R] * ch[v2][R] > best) return 0;\n    unsigned long long key = (unsigned long long)x * 10000 + v1 * 100 + v2;\n    auto it = cache.find(key);\n    if (it != cache.end()) return it->second;\n    if (v1 < R || v2 < R) {\n        if (v1 >= cntA[v1+v2] && v2 >= cntB[v1+v2]) {\n            int sum = v1 + v2;\n            v1 -= cntA[sum];\n            v2 -= cntB[sum];\n            return ch[v1+v2][v1];\n        }\n        return 0;\n    }\n    long long ans = 0;\n    char c = str[v1+v2-1];\n    if (c != 'B') {\n        long long cur = ch[v1][R] - ch[v1-1][R];\n        long long other = ch[v2][R];\n        ans += solve(x, y + cur * other, v1-1, v2);\n    }\n    if (c != 'A') {\n        long long cur = ch[v2][R] - ch[v2-1][R];\n        long long other = ch[v1][R];\n        ans += solve(x + cur * other, y, v1, v2-1);\n    }\n    cache[key] = ans;\n    return ans;\n}\n\nvoid start() {\n    R = readInt();\n    C = readInt();\n    int maxN = 2 * (R + C);\n    for (int i = 0; i <= maxN; i++) {\n        for (int j = 0; j <= i; j++) {\n            if (j == 0 || j == i) ch[i][j] = 1;\n            else ch[i][j] = ch[i-1][j-1] + ch[i-1][j];\n        }\n    }\n    long long x = 0, y = 0;\n    int v1 = R + C, v2 = R + C;\n    while (v1 >= R && v2 >= R) {\n        if (x > y) {\n            long long cur = ch[v1][R] - ch[v1-1][R];\n            long long other = ch[v2][R];\n            y += cur * other;\n            v1--;\n        } else {\n            long long cur = ch[v2][R] - ch[v2-1][R];\n            long long other = ch[v1][R];\n            x += cur * other;\n            v2--;\n        }\n    }\n    best = llabs(x - y);\n    dfs(0, 0, R + C, R + C);\n    str = readString();\n    int len = (int)str.length();\n    for (int i = 0; i < len; i++) {\n        cntA[i+1] = cntA[i] + (str[i] == 'A' ? 1 : 0);\n        cntB[i+1] = cntB[i] + (str[i] == 'B' ? 1 : 0);\n    }\n    long long ans = solve(0, 0, R + C, R + C);\n    cout << ans << '\\n';\n}\n\nint main() {\