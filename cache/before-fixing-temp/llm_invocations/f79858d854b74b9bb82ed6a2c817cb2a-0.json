self):\n        x = self.DFT(0, 1, False)\n        for i in range(len(x)):\n            x[i] = (x[i] * SZ_INV) % MOD\n        return x\n\n    def DFT(self, first, step, straight):\n        if step == self.sz:\n            return [self.v[first] % MOD]\n        zeros = self.DFT(first, step * 2, straight)\n        ones = self.DFT(first + step, step * 2, straight)\n        n = len(zeros)\n        factor_arr = warr if straight else winvarr\n        ans = [0] * (2 * n)\n        for i in range(n):\n            factor = factor_arr[i * step]\n            val = (factor * ones[i]) % MOD\n            ans[i] = (zeros[i] + val) % MOD\n            ans[i + n] = (zeros[i] - val) % MOD\n        return ans\n\ndef naive_fft(a):\n    \"\"\"Compute full DFT (size SZ) of small array a (length 10) using O(SZ * |a|) algorithm.\"\"\"\n    ans = [0] * SZ\n    wth = 1\n    for i in range(SZ):\n        x = 1\n        total = 0\n        for v in a:\n            total = (total + v * x) % MOD\n            x = (x * wth) % MOD\n        ans[i] = total\n        wth = (wth * W) % MOD\n    return ans\n\ndef pow_arr(arr, exp):\n    return [pow(x, exp, MOD) for x in arr]\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    k = int(next(it))\n    arr = [0] * 10\n    for _ in range(k):\n        digit = int(next(it))\n        arr[digit] = 1\n\n    # step 1: forward DFT of arr\n    dft_vals = naive_fft(arr)           # length SZ\n    # step 2: raise each element to n//2\n    dft_vals = pow_arr(dft_vals, n // 2)\n    # step 3: inverse DFT (using same roots) and scale\n    vec = Vector(dft_vals)\n    inv_dft = vec.FFT1()                # length SZ\n    # step 4: sum of squares\n    ans = sum((v * v) % MOD for v in inv_dft) % MOD\n    sys.stdout.write(str(ans) + \"\\n\")\n\nif __name__ == '__main__':\n    sys.setrecursionlimit(1 << 25)\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [