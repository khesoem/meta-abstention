r\n\r\nint main() {\r\n\tscanf(\"%lld\", &n);\r\n\tdfs1(0, 0);\r\n\tfor (int i = 0; i <= 6; ++i) sort(v[i].begin(), v[i].end());\r\n\tcnt = 0;\r\n\tfor (int i = 1; i <= 9; ++i) dfs2(i);\r\n\tprintf(\"%lld\\n\", ans);\r\n\treturn 0;\r\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nsys.setrecursionlimit(1 << 25)\n\nmod1 = 998244353\nmod2 = 1000000007\nbase = 1000000\n\nv = [[] for _ in range(7)]\nsumv = [0] * 7\n\nn = 0\ncnt = 0\nans = 0\n\ndef dfs1(k1, k2):\n    global cnt\n    global ans\n    cnt += 1\n    val = (cnt - k2 + mod1) % mod1\n    v[k1].append(val)\n    sumv[k1] = (sumv[k1] + val) % mod2\n    if k1 == 6:\n        return\n    for i in range(10):\n        dfs1(k1 + 1, k2 * 10 + i)\n\ndef dfs2(x):\n    global cnt\n    global ans\n    if x > n:\n        return\n    if x * base + base - 1 <= n and x * base * 10 > n:\n        now = cnt\n        for i in range(7):\n            mul = 10 ** i\n            dif = ((now - x * mul) % mod1 + mod1) % mod1\n            siz = len(v[i])\n            pos = bisect.bisect_left(v[i], (mod1 - dif) % mod1)\n            ans = (ans + dif * siz + sumv[i]) % mod2\n            ans = (ans - (mod1 * (siz - pos) % mod2) + mod2) % mod2\n            cnt += siz\n        return\n    cnt += 1\n    ans = (ans + ((cnt - x) % mod1 + mod1) % mod1) % mod2\n    for i in range(10):\n        dfs2(x * 10 + i)\n\ndef main():\n    global n\n    global cnt\n    global ans\n    n = int(sys.stdin.readline())\n    dfs1(0, 0)\n    for i in range(7):\n        v[i].sort()\n    cnt = 0\n    for i in range(1, 10):\n        dfs2(i)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.0007788485381752253, -1.1920928244535389e-07, -3.576278118089249e-07, -0.0019464610377326608, -0.0007300095749087632, -1.0728830375228426e-06, -0.