 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {\n                            dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];\n                            prevv[e.to] = v;\n                            preve[e.to] = i;\n                            que.offer(new int[]{dist[e.to], e.to});\n                        }\n                    }\n                }\n                if (dist[t] == Integer.MAX_VALUE)\n                    return -1;\n\n                for (int v = 0; v < V; v++)\n                    h[v] += dist[v];\n\n                int d = f;\n                for (int v = t; v != s; v = prevv[v]) {\n                    d = Math.min(d, G[prevv[v]].get(preve[v]).cap);\n                }\n                f -= d;\n                res += d * h[t];\n                for (int v = t; v != s; v = prevv[v]) {\n                    Edge e = G[prevv[v]].get(preve[v]);\n                    e.cap -= d;\n                    G[v].get(e.rev).cap += d;\n                }\n            }\n            return res;\n        }\n    }\n\n    static int n, m, k, c, d;\n    static int[] a = new int[50];\n    static int[] cnt = new int[50];\n    static List<Integer>[] e = new ArrayList[50];\n\n    static final int T = 100;\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n        k = sc.nextInt();\n        c = sc.nextInt();\n        d = sc.nextInt();\n        for (int i = 0; i < k; i++) {\n            a[i] = sc.nextInt();\n        }\n        for (int i = 0; i < 50; i++) e[i] = new ArrayList<>();\n        for (int i = 0; i < k; i++) {\n            cnt[a[i] - 1]++;\n        }\n        for (int i = 0; i < m; i++) {\n            int x = sc.nextInt();\n            int y = sc.nextInt();\n            x--;\n            y--;\n            e[x].add(y);\n            e[y].add(x);\n        }\n        MinCostFlow mcf = new MinCostFlow();\n        mcf.init(n * T + 2);\n        int S = n * T;\n        int TGT = n * T + 1;\n        for (int i = 0; i < n; i++) {\n            mcf.addEdge(S, i, cnt[i], 0);\n        }\n        for (int i = 0; i < T; i++) {\n            mcf.addEdge(i * n, TGT, k, c * i);\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < T - 1; j++) {\n                mcf.addEdge(j * n + i, (j + 1) * n + i, k, 0);\n            }\n            for (int to : e[i]) {\n                for (int j = 0; j < T - 1; j++) {\n                    for (int u = 0; u < k; u++) {\n                        int cost = (u + 1) * (u + 1) * d - u * u * d;\n                        mcf.addEdge(j * n + i, (j + 1) * n + to, 1, cost);\n                    }\n                }\n            }\n        }\n        System.out.println(mcf.minCostFlow(S, TGT, k));\n        sc.close();\n    }\n}\n\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0005257497541606426, -6.704273118884885e-07, -0.000553151941858232, -0.43552160263061523, -2.262235641479492, -3.128163257315464e-07, -0.6332342624664307, -2.1271092891693115, -0.01276861410588026, -0.00016802136087790132, -0.005283207632601261, -0.0009863656014204025, -0.004176579415798187, -6.704273118884885e-07, -0.0002615742268972099, -3.292907877039397e-06, -3.895693302154541, 0.0, -0.0001234428636962548, -0.002188329817727208, -6.754368223482743e-05, -3.128163257315464e-07, -1.306760805164231e-05, -1.0280383548888494e-06, -1.2113979209971149e-05, -2.339278580620885e-06, -1.1472419600977446e-06, -2.935296834039036e-06, -0.3875519633293152, -6.704273118884885e-07, -0.974092960357666, -0.0003065030323341489, -0.0011759399203583598, -0.000146687583765015, 0.0, -1.6240566083070007e-06, -1.8624639324116288e-06, 0.0, -5.512236498361744e-07, -3.440506407059729e-05, 0.0, -7.896309739408025e-07, -0.006742373108863831, -2.951771421066951e-05, -9.729906196298543e-06, -1.9361264946837764e-07, 0.0, -9.674858301877975e-05, -2.696889623621246e-06, -0.00026217024424113333, -1.8624639324116288e-06, 0.0, -2.22007497541198