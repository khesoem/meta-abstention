{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++ code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++ code you have to translate:\n<original_code>\n#include <iostream>\n#include <cmath>\n\nusing namespace std;\n\nint gcd (int x, int y)\n{\n    int gcd;\n    if (x > y)\n        gcd = x;\n    else\n        gcd = y;\n\n    while (true)\n    {\n        if (x%gcd == 0 && y%gcd == 0)\n            break;\n        gcd--;\n    }\n    return gcd;\n}\n\nvoid diff (double x, double y, double a, double b, double &num, double &den)\n{\n    num = x*b - y*a;\n    num = fabs (num);\n    den = y*b;  \n}\n\n\nint main()\n{\n    double x,y,n,a,b;\n    double min;\n    int mina, minb;\n    min = 1000000;\n\n    cin>>x>>y>>n;\n\n    if (n > y){\n        int gc = gcd (x, y);\n        if (gc != 1){       \n            x = x/gc;\n            y = y/gc;\n        }\n        cout<<x<<\"/\"<<y<<endl;\n        return 0;\n    }\n\n    for (b = n; b >= 1; b--)\n    {\n        a = (x*b)/y;\n        if (floor(a) == a){\n            mina = a;\n            minb = b;\n            break;\n        }\n        else{\n            double temp, tempa, tempb;\n            diff(x,y,floor(a),b,tempa,tempb);\n            temp = tempa/tempb;\n\n            if(temp < min){\n                mina = floor(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(floor(a) < mina){\n                    mina = floor(a);\n                    minb = b;                   \n                }\n            }\n            \n            diff(x,y,ceil(a),b,tempa,tempb);        \n            temp = tempa/tempb;\n\n            if(temp < min){\n                mina = ceil(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(ceil(a) < mina){\n                    mina = ceil(a);\n                    minb = b;                   \n                }\n            }\n        }\n    }\n\n    int gc = gcd (mina, minb);\n    if (gc != 1){       \n        mina = mina/gc;\n        minb = minb/gc;\n    }\n\n    cout<<mina<<\"/\"<<minb<<endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\n\ndef gcd(x, y):\n    # Find gcd using decreasing from max(x,y)\n    if x > y:\n        gcd_val = x\n    else:\n        gcd_val = y\n    while True:\n        if x % gcd_val == 0 and y % gcd_val == 0:\n            break\n        gcd_val -= 1\n    return gcd_val\n\ndef diff(x, y, a, b):\n    # returns numerator and denominator of absolute difference |x/b - a/b|?\n    # Actually computes |x*b - y*a| / (y*b)\n    num = abs(x * b - y * a)\n    den = y * b\n    return num, den\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    x = float(data[0])\n    y = float(data[1])\n    n = float(data[2])  # n is given as floating, but used as integer in loop\n\n    # If denominator is allowed to be up to y, just reduce the fraction\n    if n >= y:\n        # Convert x, y to integers for gcd? Actually they are floats.\n        # But we assume they are integer values as per problem.\n        # Use int conversion for gcd\n        xi = int(x)\n        yi = int(y)\n        g = gcd(xi, yi)\n        if g != 1:\n            xi //= g\n            yi //= g\n        print(f\"{xi}/{yi}\")\n        return\n\n    # Initialize best values\n    min_diff = float('inf')\n    min_a = 0\n    min_b = 0\n\n    # Iterate denominators from n down to 1\n    for b in range(int(n), 0, -1):\n        a = (x * b) / y  # exact numerator as float\n        if math.floor(a) == a:  # integer numerator\n            min_a = int(a)\n            min_b = b\n            break\n        else:\n            floor_a = math.floor(a)\n            ceil_a = math.ceil(a)\n\n            # Consider floor(a)\n            num, den = diff(x, y, floor_a, b)\n            temp = num / den\n            if temp < min_diff:\n                min_a = floor_a\n                min_b = b\n                min_diff = temp\n            elif temp == min_diff:\n                if floor_a < min_a:\n                    min_a = floor_a\n                    min_b = b\n\n            # Consider ceil(a)\n            num, den = diff(x, y, ceil_a, b)\n            temp = num / den\n            if temp < min_diff:\n                min_a = ceil_a\n                min_b = b\n                min_diff = temp\n            elif temp == min_diff:\n                if ceil_a < min_a:\n                    min_a = ceil_a\n                    min_b = b\n\n    # Reduce the best fraction\n    g = gcd(min_a, min_b)\n    if g != 1:\n        min_a //= g\n        min_b //= g\n\n    print(f\"{min_a}/{min_b}\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.2516897186287679e-05, 0.0, -2.3841855067985307e-07, -0.0005651307292282581, -0.0001774868869688362, -0.3868710994720459, -0.004167087841778994, -7.593343616463244e-05, 0.0, -1.1324817933200393e-05, -2.276871418871451e-05, -7.510157047363464e-06, -0.0015824426664039493, -0.00398615188896656,