ader {\n    string line;\n    stringstream ss;\npublic:\n    FastReader() {\n        ios_base::sync_with_stdio(false);\n        cin.tie(nullptr);\n    }\n    string next() {\n        string s;\n        cin >> s;\n        return s;\n    }\n    int nextInt() {\n        int x;\n        cin >> x;\n        return x;\n    }\n    long long nextLong() {\n        long long x;\n        cin >> x;\n        return x;\n    }\n    double nextDouble() {\n        double x;\n        cin >> x;\n        return x;\n    }\n    string nextLine() {\n        string s;\n        getline(cin, s);\n        return s;\n    }\n};\n\nint gcd(int x, int y) {\n    return y == 0 ? x : gcd(y, x % y);\n}\n\nlong long mod_pow(long long a, long long b, long long mod) {\n    a %= mod;\n    if (b == 0) return 1 % mod;\n    if (b & 1) return a * mod_pow(a, b - 1, mod) % mod;\n    long long u = mod_pow(a, b >> 1, mod);\n    return (u * u) % mod;\n}\n\nlong long _pow(long long a, long long b) {\n    if (b == 0) return 1;\n    if (b & 1) return a * _pow(a, b - 1);\n    long long u = _pow(a, b >> 1);\n    return u * u;\n}\n\nint modInv(int a, int m) {\n    if (gcd(a, m) != 1) return -999;\n    return (a % m + m) % m;\n}\n\nbool isPowerOfTwo(int x) {\n    return x && !(x & (x - 1));\n}\n\nbool isprime(int x) {\n    for (int i = 2; i * i <= x; i++)\n        if (x % i == 0) return false;\n    return true;\n}\n\nconst int INT_MAX_VAL = 1000007;\nbool prime[1000007];\n\nvoid sieve() {\n    fill(prime, prime + INT_MAX_VAL, true);\n    prime[0] = prime[1] = false;\n    for (int i = 2; i * i <= INT_MAX_VAL; i++)\n        if (prime[i])\n            for (int j = i * 2; j < INT_MAX_VAL; j += i)\n                prime[j] = false;\n}\n\nstruct Pair {\n    int ff, ss;\n    Pair(int ff, int ss) : ff(ff), ss(ss) {}\n};\n\nint main() {\n    FastReader sc;\n    int n = sc.nextInt(), w = sc.nextInt();\n    vector<int> a(n);\n    for (int i = 0; i < n; i++) a[i] = sc.nextInt();\n    int e = 0, o = 0;\n    vector<int> cuts;\n    for (int i = 0; i < n - 1; i++) {\n        if ((a[i] & 1) == 0) ++e;\n        else ++o;\n        if (e == o) cuts.push_back(abs(a[i] - a[i + 1]));\n    }\n    n = (int)cuts.size();\n    vector<vector<int>> dp(n + 1, vector<int>(w + 1, 0));\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= w; j++) {\n            if (cuts[i - 1] <= j) {\n                dp[i][j] = max(1 + dp[i - 1][j - cuts[i - 1]], dp[i - 1][j]);\n            } else {\n                dp[i][j] = dp[i - 1][j];\n            }\n        }\n    }\n    int ans = dp[n][w];\n    cout << ans << endl;\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-4.76836e-06, 0.0, -1.1920928e-07, -0.0032023122, -0.0005123495, -0.0003380204, -0.062097803, -7.152555e-07, -2.3841855e-07, 0.0, -0.00012432756, -0.00037210216, -2.3841855e-07, 0.0, -0.0007378716, -0.24968328, -0.006452204, -3.576278e-07, -1.9550132e-05, -0.1364138, -3.7132926, -0.85915065, -0.201928, -6.0556486e-05, -2.75076, -0.3910355, -0.0039556366, -0.0022686003, -0.021335144, -7.2717403e-06, -4.0531077e-06, -0.02005607, 0.0, -0.00013696209, -0.772703, -0.00022253898, -0.716374, -0.3868719, -2.3841855e-07, -1.1920928e-07, 0.0, 0.0, -0.0015154317, -0.011277267, -0.00018034739, -2.860982e-05, -5.960463e-07, -1.2060176, -0.000729414, -0.04863059, -0.07889669, -0.38692802, -0.12764682, -0.0003881893, -0.00089950627, -0.00020489977, -3.6954812e-06, -0.8329896, -0.17172417, -0.0007493072, -1.9073468e-06, -0.64406675, -0.00016473368, -0.00021181247, -4.0649542e-05, -4.7683704e-07, -0.0040465863, -1.5497195e-06, -2.8848232e-05, -3.266281e-05, -1.1324818e-05, -7.867782e-06, -0.00045205865, -1.4305105e-06, -3.576278e-07, -5.960463e-07, -0.018150898, -4.7683704e-07, -0.00049495365, -0.015395609, -0.011070379, -1.1920928e-07, -3.445089e-05, -2.8610189e-06, -1.1920928e-07, -4.2915253e-06, -2.3841855e-07, -1.800044e-05, 0.0, -4.0531077e-06, -2.0265559e-06, -1.1086402e-05, -0.0011745943, -0.0008056494, -0.014171911, -