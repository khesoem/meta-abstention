n        q.append(self.src)\n        d[self.src] = 0\n        while q:\n            u = q.popleft()\n            i = self.head[u]\n            while i != -1:\n                v = self.e[i][1]\n                if self.e[i][2] < self.e[i][3] and d[v] == -1:\n                    d[v] = d[u] + 1\n                    q.append(v)\n                i = self.e[i][4]\n        self.d = d\n        return d[self.dst] != -1\n\n    def _dfs(self, u, f):\n        if u == self.dst:\n            return f\n        i = self.work[u]\n        while i != -1:\n            v = self.e[i][1]\n            if self.e[i][2] < self.e[i][3] and self.d[v] == self.d[u] + 1:\n                minf = self._dfs(v, min(f, self.e[i][3] - self.e[i][2]))\n                if minf > 0:\n                    self.e[i][2] += minf\n                    self.e[i ^ 1][2] -= minf\n                    return minf\n            i = self.e[i][4]\n            self.work[u] = i\n        return 0\n\n    def max_flow(self):\n        ret = 0\n        while self._bfs():\n            self.work = self.head[:]\n            while True:\n                delta = self._dfs(self.src, INF)\n                if delta == 0:\n                    break\n                ret += delta\n        return ret\n\ndef solve():\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    for n_str in it:\n        n = int(n_str)\n        t = int(next(it))\n        smp = []\n        for _ in range(n):\n            smp.append(list(next(it)))\n        cmp = []\n        for _ in range(n):\n            cmp.append(list(next(it)))\n\n        N = 2 * n * n + 2\n        S = 2 * n * n\n        T = 2 * n * n + 1\n        dinic = Dinic(N, S, T)\n        \n        zx = zy = -1\n        for i in range(n):\n            for j in range(n):\n                if smp[i][j].isdigit() and smp[i][j] > '0':\n                    dinic.add_edge(S, i * n + j, ord(smp[i][j]) - ord('0'))\n                elif smp[i][j] == 'Z':\n                    zx, zy = i, j\n        \n        for i in range(n):\n            for j in range(n):\n                if cmp[i][j].isdigit() and cmp[i][j] > '0':\n                    dinic.add_edge(n * n + i * n + j, T, ord(cmp[i][j]) - ord('0'))\n        \n        dx = [1, 0, -1, 0]\n        dy = [0, -1, 0, 1]\n        \n        for i in range(n):\n            for j in range(n):\n                if not smp[i][j].isdigit() or smp[i][j] <= '0':\n                    continue\n                # BFS from (i,j) and (zx,zy)\n                vis = [[0]*n for _ in range(n)]\n                work = [row[:] for row in smp]\n                q = deque()\n                q.append((i, j, 0, 0))\n                vis[i][j] = 1\n                if zx != -1 and zy != -1:\n                    q.append((zx, zy, 0, 1))\n                while q:\n                    x, y, time, typ = q.popleft()\n                    if time == t:\n                        break\n                    if typ == 0 and work[x][y].isalpha():\n                        continue\n                    for k in range(4):\n                        nx = x + dx[k]\n                        ny = y + dy[k]\n                        if 0 <= nx < n and 0 <= ny < n:\n                            if typ == 0 and not vis[nx][ny] and not work[nx][ny].isalpha():\n                                vis[nx][ny] = 1\n                                q.append((nx, ny, time+1, 0))\n                            elif typ == 1 and not work[nx][ny].isalpha():\n                                work[nx][ny] = 'Z'\n                                q.append((nx, ny, time+1, 1))\n                \n                for xi in range(n):\n                    for yi in range(n):\n                        if cmp[xi][yi].isdigit() and cmp[xi][yi] > '0' and vis[xi][yi]:\n                            dinic.add_edge(i * n + j, n * n + xi * n + yi, INF)\n        \n        print(dinic.max_flow())\n\nif __name__ == '__main__':\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logpr