ill(vis, 0);\n        Arrays.fill(pre, -1);\n        d[s] = 0;\n        q.add(s);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = 0;\n            for (int i = head[u]; i != -1; i = nt[i]) {\n                if (w[i] > 0 && d[to[i]] > d[u] + ct[i]) {\n                    d[to[i]] = d[u] + ct[i];\n                    pre[to[i]] = u;\n                    id[to[i]] = i;\n                    if (vis[to[i]] == 0) {\n                        vis[to[i]] = 1;\n                        q.add(to[i]);\n                    }\n                }\n            }\n        }\n        return d[t] < INF;\n    }\n    \n    static int minCostFlow(int s, int t) {\n        int Mi, sum = 0;\n        while (spfa(s, t)) {\n            Mi = INF;\n            for (int i = t; i != s; i = pre[i])\n                Mi = Math.min(Mi, w[id[i]]);\n            for (int i = t; i != s; i = pre[i]) {\n                w[id[i]] -= Mi;\n                w[id[i] ^ 1] += Mi;\n            }\n            sum += d[t] * Mi;\n        }\n        return sum;\n    }\n    \n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d_val = Integer.parseInt(st.nextToken());\n        \n        int V = n * 100 + 2;\n        s = 0;\n        t = n * 100 + 1;\n        \n        // Estimate max edges: k + 99*n + 2*99*20*m\n        int E = k + 99 * n + 2 * 99 * 20 * m + 5;\n        init(V, E);\n        \n        // Source to starting vertices' first time layer\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int v = Integer.parseInt(st.nextToken());\n            add(s, (v - 1) * 100 + 1, 1, 0);\n        }\n        \n        // Self-loop edges across time layers\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                add((i - 1) * 100 + j, (i - 1) * 100 + j + 1, 100, c);\n            }\n        }\n        \n        // Read edges and build time-expanded connections\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int u = Integer.parseInt(st.nextToken());\n            int v = Integer.parseInt(st.nextToken());\n            for (int j = 1; j < 100; j++) {\n                int idx = (u - 1) * 100 + j;\n                int idy = (v - 1) * 100 + j + 1;\n                for (int kk = 1; kk <= 20; kk++) {\n                    add(idx, idy, 1, c + (kk * kk - (kk - 1) * (kk - 1)) * d_val);\n                }\n            }\n            for (int j = 1; j < 100; j++) {\n                int idx = (v - 1) * 100 + j;\n                int idy = (u - 1) * 100 + j + 1;\n                for (int kk = 1; kk <= 20; kk++) {\n                    add(idx, idy, 1, c + (kk * kk - (kk - 1) * (kk - 1)) * d_val);\n                }\n            }\n        }\n        \n        System.out.println(minCostFlow(s, t));\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.802703940891661e-05, 0.0, -9.536738616588991e-07, -0.0008406681008636951, -0.0020292659755796194, -5.960462772236497e-07, -0.2519312798976898, -0.10041458904743195, -3.576278118089249e-07, 0.0, -3.2186455882765586e-06, -0.0008030288736335933, -0.00012766500003635883, -2.3841855067985307e-07, -0.0010052633006125689, -0.008698667399585247, -0.000456109904916957, -0.052729878574609756, -0.6959563493728638, -0.890981912612915, -0.0007701530121266842, -0.20229829847812653, -0.012059280648827553, -2.3841830625315197e-06, -0.05156022310256958, -1.0728830375228426e-06, -0.00013052565918769687, -2.0265558760002023e-06, -2.145764938177308e-06, -0.019626934081315994, -2.3841855067985307e-07, -1.3113012755