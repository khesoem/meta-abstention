         ASSERT(g == 1);\n                ASSERT(y == modulus() || y == -modulus());\n\n                return normalize(x);\n            }\n\n        }\n\n        public static class Mod998 extends NumberTheory.Modulus<NumberTheory.Mod998> {\n            public long modulus() {\n                return 998_244_353L;\n            }\n\n        }\n\n    }\n\n    static class InputReader {\n        public final BufferedReader reader;\n        public StringTokenizer tokenizer;\n\n        public InputReader(InputStream stream) {\n            reader = new BufferedReader(new InputStreamReader(stream), 32768);\n            tokenizer = null;\n        }\n\n        public String next() {\n            while (tokenizer == null || !tokenizer.hasMoreTokens()) {\n                try {\n                    tokenizer = new StringTokenizer(reader.readLine());\n                } catch (IOException e) {\n                    throw new RuntimeException(e);\n                }\n            }\n            return tokenizer.nextToken();\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        public long nextLong() {\n            return Long.parseLong(next());\n        }\n\n    }\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 998244353\n\nclass Mod998:\n    def __init__(self):\n        self.factorial = [1]   # fact[0] = 1\n        self.invFactorial = [1]  # invFact[0] = 1\n\n    def fact(self, n):\n        # ensure factorial list has length > n\n        while len(self.factorial) <= n:\n            next_val = self.mult(self.factorial[-1], len(self.factorial))\n            self.factorial.append(next_val)\n        return self.factorial[n]\n\n    def fInv(self, n):\n        last_known = len(self.invFactorial) - 1\n        if last_known < n:\n            # compute inv factorial for indices (last_known+1) ... n\n            # compute fInv[0] = inv(fact(n)), then fInv[i] = fInv[i-1] * (n - i + 1) % MOD\n            size = n - last_known\n            fInv = [0] * size\n            fInv[0] = self.inv(self.fact(n))\n            for i in range(1, size):\n                fInv[i] = self.mult(fInv[i - 1], n - i + 1)\n            # append in reverse: from n down to last_known+1\n            for i in range(size - 1, -1, -1):\n                self.invFactorial.append(fInv[i])\n        return self.invFactorial[n]\n\n    def ncr(self, n, r):\n        if r < 0 or n < r:\n            return 0\n        # fact(n) * invFact(r) * invFact(n-r) % MOD\n        a = self.fact(n)\n        b = self.fInv(r)\n        c = self.fInv(n - r)\n        return self.mult(a, b, c)\n\n    def normalize(self, x):\n        x %= MOD\n        if x < 0:\n            x += MOD\n        return x\n\n    def add(self, a, b):\n        v = a + b\n        return v if v < MOD else v - MOD\n\n    def mult(self, *args):\n        r = 1\n        for x in args:\n            r = (r * x) % MOD\n        return r\n\n    def pow(self, x, e):\n        if e < 0:\n            x = self.inv(x)\n            e = -e\n        if e == 0:\n            return 1\n        if e & 1:\n            return self.mult(x, self.pow(x, e - 1))\n        return self.pow(self.mult(x, x), e // 2)\n\n    def inv(self, value):\n        # extended Euclidean algorithm\n        g = MOD\n        x = 0\n        y = 1\n        r = value\n        while r != 0:\n            q = g // r\n            g %= r\n            g, r = r, g\n            x -= q * y\n            x, y = y, x\n        # g should be 1\n        if g != 1:\n            raise AssertionError(\"Inverse does not exist\")\n        return self.normalize(x)\n\n    def paritySign(self, k):\n        return 1 if (k & 1) == 0 else MOD - 1\n\n\ndef solve():\n    mod = Mod998()\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n\n    if k == 0:\n        print(mod.fact(n))\n        return\n\n    if k > n - 1:\n        print(0)\n        return\n\n    c = n - k\n\n    answer = 0\n    for i in range(1, c + 1):\n        term = mod.mult(mod.paritySign(c - i), mod.ncr(c, i), mod.pow(i, n))\n        answer = mod.add(answer, term)\n\n    answer = mod.mult(answer, 2, mod.ncr(n, c))\n    print(answer)\n\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [0.0, 0.0, 0.0, -0.00020394629973452538, -0.050387267023324966, -0.0001463782973587513, -0.008771461434662342, -0.2026223987340927, -0.0002302858338225633, -1.1920928244535389e-07, 0.0, -0.005235176533460617, -1.9073468138230965e-06, -0.002662567887455225, -0.00023398046323563904, -0.0033627173397690058, -0.005815609358251095, -7.867782187531702e-06, -1.311301275563892e-06, -0.000256982195423916, -1.1920922133867862e-06, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -6.318072337307967e-06, -1.1920928244535389e-07, -0.0001463782973587513, -0.009189452975988388, -0.029797974973917007, -0.0002965487365145236, -1.0728830375228426e-06, -2.3841855067985307e-07, -0.6931552886962891, -0.5780512690544128, -4.768370445162873e-07, -1.146082878112793, -0.586445689201355, -8.344646857949556e-07, -0.0839071124792099, -1.4424220353248529e-05, -2.861018856492592e-06, -6.198863957251888e-06, -8.725739462533966e-05, 0.0, 0.0, -0.00010525626566959545, 0.0, -1.7015223503112793, -0.0002040654799202457, -2.7418097943154862e-06, -4.768370445162873e-07, -2.3841855067985307e-07, -0.018208375200629234, -0.2841012179851532, 0.0, -0.0006451908848248422, -0.08557219803333282, -0.0010631391778588295, -5.960462772236497e-07, -1.5735502529423684e-05, 0.0, -9.536738616588991e-07, -2.3841855067985307e-07, -0.015269643627107143, -2.0265558760002023e-06, -0.0011874536285176873, -0.17828088998794556, 0.0, -1.1920928244535389e-07, 0.0, -0.014183311723172665, -8.344646857949556e-07, -0.9871304035186768, -0.24894803762435