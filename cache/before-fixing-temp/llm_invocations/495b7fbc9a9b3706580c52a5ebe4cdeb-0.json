ons import deque\n\ndef solve() -> None:\n    sys.setrecursionlimit(1000000)\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    dim = int(next(it))\n    time_to_die = int(next(it))\n\n    Nmax = 2 * dim * dim + 2\n    cap = [[0] * Nmax for _ in range(Nmax)]\n    gr = [[] for _ in range(Nmax)]\n\n    labsci = [list(next(it)) for _ in range(dim)]\n    labcap = [next(it) for _ in range(dim)]\n\n    # convert labsci to list of lists for easy modification\n    # also locate 'Z' and change to 'Y'\n    malfunc = None\n    for i in range(dim):\n        row = labsci[i]\n        for j, ch in enumerate(row):\n            if ch == 'Z':\n                malfunc = 100 * i + j\n                row[j] = 'Y'\n                break  # there is exactly one 'Z'\n        # keep as list for later use (still a list of characters)\n\n    N = 2\n    vert = [[[0, 0] for _ in range(dim)] for _ in range(dim)]\n\n    # source side\n    for i in range(dim):\n        row = labsci[i]\n        for j, ch in enumerate(row):\n            if '1' <= ch <= '9':\n                cap[0][N] = int(ch)\n                gr[0].append(N)\n                gr[N].append(0)\n                vert[i][j][0] = N\n                N += 1\n\n    M = N\n    # sink side\n    for i in range(dim):\n        row = labcap[i]\n        for j, ch in enumerate(row):\n            if '1' <= ch <= '9':\n                cap[M][1] = int(ch)\n                gr[M].append(1)\n                gr[1].append(M)\n                vert[i][j][1] = M\n                M += 1\n\n    # die distances from the starting point (malfunc)\n    die = [[time_to_die + 1] * dim for _ in range(dim)]\n    if malfunc is not None:\n        mi = malfunc // 100\n        mj = malfunc % 100\n        die[mi][mj] = 0\n        q = deque()\n        q.append((mi, mj))\n        dirs = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n        while q:\n            x, y = q.popleft()\n            for dx, dy in dirs:\n                nx, ny = x + dx, y + dy\n                if 0 <= nx < dim and 0 <= ny < dim and labsci[nx][ny] != 'Y' and die[nx][ny] > die[x][y] + 1:\n                    die[nx][ny] = die[x][y] + 1\n                    q.append((nx, ny))\n\n    INF = 10 ** 9\n\n    # Build edges from source cells to sink cells based on reachability\n    for i in range(dim):\n        for j in range(dim):\n            if '1' <= labsci[i][j] <= '9':\n                reach = [[time_to_die + 1] * dim for _ in range(dim)]\n                reach[i][j] = 0\n                # edge to the sink node of the same cell (if exists)\n                if '1' <= labcap[i][j] <= '9':\n                    cap[vert[i][j][0]][vert[i][j][1]] = INF\n                    gr[vert[i][j][0]].append(vert[i][j][1])\n                    gr[vert[i][j][1]].append(vert[i][j][0])\n                q = deque()\n                q.append((i, j))\n                while q:\n                    x, y = q.popleft()\n                    for dx, dy in dirs:\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < dim and 0 <= ny < dim and labsci[nx][ny] != 'Y' and reach[nx][ny] > reach[x][y] + 1:\n                            # if there is a sink at (nx,ny) and we can reach it before it dies\n                            if '1' <= labcap[nx][ny] <= '9' and reach[x][y] + 1 <= die[nx][ny]:\n                                cap[vert[i][j][0]][vert[nx][ny][1]] = INF\n                                gr[vert[i][j][0]].append(vert[nx][ny][1])\n                                gr[vert[nx][ny][1]].append(vert[i][j][0])\n                            # continue BFS only if we have time before the cell dies\n                            if reach[x][y] + 1 < die[nx][ny]:\n                                reach[nx][ny] = reach[x][y] + 1\n                                q.append((nx, ny))\n\n    # max flow (augmenting path algorithm)\n    parent = [-1] * M\n\n    def augment(u: int) -> int:\n        if u == 1:\n            return INF\n        vis[u