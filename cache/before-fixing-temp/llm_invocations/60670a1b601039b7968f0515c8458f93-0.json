r):\n        if isinstance(other, ModInt):\n            self.val += other.val\n        else:\n            self.val += other\n        if self.val >= MOD:\n            self.val -= MOD\n        return self\n\n    def __sub__(self, other):\n        if isinstance(other, ModInt):\n            return ModInt(self.val - other.val)\n        return ModInt(self.val - other)\n\n    def __rsub__(self, other):\n        return ModInt(other) - self\n\n    def __isub__(self, other):\n        if isinstance(other, ModInt):\n            self.val -= other.val\n        else:\n            self.val -= other\n        if self.val < 0:\n            self.val += MOD\n        return self\n\n    def __mul__(self, other):\n        if isinstance(other, ModInt):\n            return ModInt(self.val * other.val)\n        return ModInt(self.val * other)\n\n    def __rmul__(self, other):\n        return ModInt(other) * self\n\n    def __imul__(self, other):\n        if isinstance(other, ModInt):\n            self.val = (self.val * other.val) % MOD\n        else:\n            self.val = (self.val * other) % MOD\n        return self\n\n    def __truediv__(self, other):\n        if isinstance(other, ModInt):\n            return ModInt(self.val * mod_inv(other.val))\n        return ModInt(self.val * mod_inv(other))\n\n    def __rtruediv__(self, other):\n        return ModInt(other) / self\n\n    def __itruediv__(self, other):\n        if isinstance(other, ModInt):\n            self.val = (self.val * mod_inv(other.val)) % MOD\n        else:\n            self.val = (self.val * mod_inv(other)) % MOD\n        return self\n\n    def __neg__(self):\n        return ModInt(0) if self.val == 0 else ModInt(MOD - self.val)\n\n    def __eq__(self, other):\n        if isinstance(other, ModInt):\n            return self.val == other.val\n        return self.val == other\n\n    def __ne__(self, other):\n        return not self.__eq__(other)\n\n    def __int__(self):\n        return self.val\n\n    def __repr__(self):\n        return str(self.val)\n\n    def inv(self):\n        return ModInt(mod_inv(self.val))\n\n    def pow(self, p):\n        assert p >= 0\n        a = self\n        result = ModInt(1)\n        while p > 0:\n            if p & 1:\n                result *= a\n            a *= a\n            p >>= 1\n        return result\n\ndef main():\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    N = int(next(it))\n    prob = [[ModInt(0) for _ in range(N)] for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            p = int(next(it))\n            prob[i][j] = ModInt(p) / ModInt(100)\n\n    masks_with_count = [[] for _ in range(N + 1)]\n    lookup = [-1] * (1 << N)\n    for mask in range(1 << N):\n        count = bin(mask).count('1')\n        lookup[mask] = len(masks_with_count[count])\n        masks_with_count[count].append(mask)\n\n    possible_masks = defaultdict(ModInt)\n    possible_masks[1 << lookup[0]] = ModInt(1)\n\n    for left in range(N):\n        new_possible_masks = defaultdict(ModInt)\n        products = [ModInt(1) for _ in range(1 << N)]\n\n        for current in range(1 << N):\n            product = ModInt(1)\n            for right in range(N):\n                if (current >> right) & 1:\n                    product *= prob[left][right]\n                else:\n                    product *= (ModInt(1) - prob[left][right])\n            products[current] = product\n\n        new_bits = [0] * N\n        new_possible = [0] * (1 << N)\n\n        for possible, prob_val in possible_masks.items():\n            new_bits = [0] * N\n\n            for mask in masks_with_count[left]:\n                if (possible >> lookup[mask]) & 1:\n                    for i in range(N):\n                        if (mask >> i) & 1 == 0:\n                            new_bits[i] |= (1 << lookup[mask | (1 << i)])\n\n            # Note: new_possible[0] = 0; we compute for current from 1 to (1<<N)-1\n            new_possible[0] = 0\n            for current in range(1, 1 << N):\n                # get least significant set bit\n                lsb = (current & -current)\n                bit_idx = (lsb.bit_length() - 1)  # ctz\n                new_possible[current] = new_possible[current & (current - 1)] | new_bits[bit_idx]\n                new_possible_masks[new_possible[current]] += prob_val * products[current]\n\n        possible_masks = new_possible_masks\n\n    full_mask = (1 << N) - 1\n    answer = ModInt(0)\n    for possible, prob_val in possible_masks.items():\n        if (possible >> lookup[full_mask]) & 1:\n            answer += prob_val\n\n    print(int(answer))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-5.876845e-05, 0.0, -3.2186456e-06, -0.00072834187, -0.008614758, -0.018242322, -0.023376001, -0.13151762, -0.19868046, -0.008692168, -0.01416909, -0.011718602, -0.38701326, -0.050705057, -0.09966507, -7.152555e-07, -0.00028332035, -0.048634227, -0.0046466943, -1.072883e-06, -0.00029845553, -0.062285554, -0.023247426, -2.3841855e-07, -4.029193e-05, -9.5367386e-07, -5.960463e-07, -0.004088734, -1.163663, -0.062529035, -0.12621969, -1.0132739e-05, -1.0132739e-05, -0.0019873884, -0.0007114263, -4.005352e-05, -4.7683704e-07, -3.4570635e-06, -2.8610189e-06, -1.7020196, -0.16164261, -0.0019744204, -0.3869833, -4.0210967, -0.002409771, -8.523101e-05, -0.0012136482, 0.0, -0.0004764852, -0.07888975, -0.003187221, -0.3868762, -9.95348e-05, -5.4836123e-06, -1.1920922e-06, -0.004097994, 0.0, -3.576278e-07, -0.038260005, -3.576278e-07, -4.887569e-06, -8.344647e-07, -4.76836e-06, -2.3841855e-07, -3.576278e-07, -1.1920922e-06, -9.6316464e-05, 0.0, -2.145765e-06, -1.1920928e-07, -0.000123374, 0.0, -3.576278e-07, -1.072883e-06, -1.1920928e-07, -5.245195e-06, -1.180165e-05, 0.0, -1.1920928e-07, 0.0, -3.576278e-07, 0.0, -4.2915253e-06, -2.580928, -2.3841855e-07, -3.81469e-06, -0.00866735, -2.384185