e(u + i * 50, v + (i + 1) * 50, 1, cost)\n                add_edge(v + i * 50, u + (i + 1) * 50, 1, cost)\n                cost += 2 * d\n    for i in range(100):\n        add_edge(0 + i * 50, 5001, INF, c * i)\n    for i in range(n):\n        for j in range(99):\n            add_edge(i + j * 50, i + (j + 1) * 50, INF, 0)\n\n    res_cost, res_flow = mincost_maxflow(5000, 5001)\n    assert res_flow == k\n    print(res_cost)\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(10**7)\n    solve()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-9.138441237155348e-05, -0.0012833295622840524, -1.0280383548888494e-06, -1.7120533811976202e-05, -0.09535437077283859, -8.160971628967673e-05, -4.596781946020201e-05, -0.022550953552126884, -0.023601820692420006, -0.00043162284418940544, -0.06332878023386002, -0.0038315486162900925, 0.0, -0.003644495503976941, -0.08190645277500153, -2.2200749754119897e-06, -0.033647891134023666, -3.128163257315464e-07, -5.512236498361744e-07, -9.088346359931165e-07, -0.0110868439078331, -1.0087516784551553e-05, -1.1994775377388578e-05, -0.7576255798339844, -0.16025103628635406, -0.007606151048094034, -1.1756367712223437e-05, -1.225117802619934, -0.004181567579507828, -5.512236498361744e-07, -1.0280383548888494e-06, -1.0280383548888494e-06, -3.750436007976532e-05, -5.9153885558771435e-06, 0.0, 0.0, -1.9361264946837764e-07, -9.088346359931165e-07, -0.04247892275452614, -0.030974606052041054, -4.572941179503687e-05, -0.0007107630372047424, -1.3902033970225602e-05, -1.0280383548888494e-06, -6.704273118884885e-07, -6.511406809295295e-06, -4.320199877838604e-07, -4.60414821645827e-06, -1.5690089639974758e-05, -4.310693111619912e-05, -4.246537173457909e-06, -5.5577775128767826e-06, -1.843177233240567e-05, 0.0, 0.0, -4.320199877838604e-07, -6.265633419388905e-05, -1.3782830137643032e-05, -2.339278580620885e-06, -3.128163257315464e-07, 0.0, -1.0280383548888494e-06, -2.3319124011322856e-05, 0.0, -9.088346359931165e-07,