 << i)) && p[i] > 1e-5) {\n\t\t\t\tdp[mask | (1 << i)] += dp[mask] * p[i] / sum[rmask];\n\t\t\t}\n\t\t}\n\t\tvector<double> ans(n);\n\t\tfor (int mask = 0; mask < 1 << n; mask++) {\n\t\t\tint cnt = 0;\n\t\t\tfor (int i = 0; i < n; i++) cnt += (mask & (1 << i)) != 0;\n\t\t\tif (cnt != k) continue;\n\t\t\tfor (int i = 0; i < n; i++) if (mask & (1 << i)) {\n\t\t\t\tans[i] += dp[mask];\n\t\t\t}\n\t\t}\n\t\tfor (int i = 0; i < n; i++) cout << ans[i] << \" \\n\"[i + 1 == n];\n\t}\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    out_lines = []\n    while True:\n        try:\n            n = int(next(it))\n            k = int(next(it))\n        except StopIteration:\n            break\n        p = [float(next(it)) for _ in range(n)]\n        \n        # sum of probabilities for each mask\n        sum_mask = [0.0] * (1 << n)\n        for mask in range(1 << n):\n            s = 0.0\n            for j in range(n):\n                if mask & (1 << j):\n                    s += p[j]\n            sum_mask[mask] = s\n        \n        # count non-zero probabilities\n        cnt_nonzero = sum(1 for val in p if val > 1e-5)\n        if cnt_nonzero <= k:\n            pp = [1.0 if val > 1e-5 else 0.0 for val in p]\n            line = ''\n            for i, val in enumerate(pp):\n                if i == n - 1:\n                    line += f'{val}\\n'\n                else:\n                    line += f'{val} '\n            out_lines.append(line.rstrip('\\n'))\n            continue\n        \n        dp = [0.0] * (1 << n)\n        dp[0] = 1.0\n        for mask in range(1 << n):\n            rmask = (~mask) & ((1 << n) - 1)\n            for i in range(n):\n                if (rmask & (1 << i)) and p[i] > 1e-5:\n                    dp[mask | (1 << i)] += dp[mask] * p[i] / sum_mask[rmask]\n        \n        ans = [0.0] * n\n        for mask in range(1 << n):\n            cnt = bin(mask).count('1')\n            if cnt != k:\n                continue\n            for i in range(n):\n                if mask & (1 << i):\n                    ans[i] += dp[mask]\n        \n        line = ''\n        for i, val in enumerate(ans):\n            if i == n - 1:\n                line += f'{val}\\n'\n            else:\n                line += f'{val} '\n        out_lines.append(line.rstrip('\\n'))\n    \n    sys.stdout.write('\\n'.join(out_lines))\n\nif __name__ == '__main__':\n    solve()\n</translated_code>\n<confidence>\n0.99\n</confidence>", "token_logprobs": [-0.06564917415380478, -3.814689989667386e-06, 0.0, -1.1920928244535389e-07, -0.00027056847466155887, -5.6503606174374e-05, -1.4305104514278355e-06, -0.03858797997236252, -0.0006846229662187397, -0.3870488107204437, -0.10054418444633484, -3.0397906812140718e-05, -0.012193894945085049, -1.9073468138230965e-06, -0.015645261853933334, -1.1920928244535389e-07, -2.0146166207268834e-05, -2.622600959512056e-06, -0.10024023056030273, -3.814689989667386e-06, -2.264974000354414e-06, -6.318072337307967e-06, -3.576278118089249e-07, -0.08044221997261047, -1.1920928244535389e-07, 0.0, -0.00020346954988781363, -8.344646857949556e-07, -3.576278118089249e-07, -3.015949550899677e-05, -4.768370445162873e-07, -0.07432606816291809, -3.576278118089249e-07, -2.3841855067985307e-07, -1.7046782886609435e-05, -8.201262971851975e-05, -0.00012540031457319856, -0.05585555359721184, -0.0009176096064038575, -1.7881377516459906e-06, -0.00042250767000950873, -0.0015051951631903648, -0.13953083753585815, -1.1920928244535389e-07, -3.3378546504536644e-06, -3.576278118089249e-07, -9.536697689327411e-06, -7.152555099310121e-07, -4.768370445162873e-07, -4.768370445162873e-07, -0.000916418619453907, -7.986990567587782e-06, -1.1920928244535389e-07, 0.0, -7.462222856702283e-05, -3.5