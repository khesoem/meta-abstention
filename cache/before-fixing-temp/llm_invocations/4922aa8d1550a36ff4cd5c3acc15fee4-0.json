     if (x<n-1 && m[x+1][y] && h[x+1][y]>h[x][y]+1 && (x+1==x2 && y==y2 && temp[x+1][y]>=h[x][y]+1 || !(x+1==x2 && y==y2) && temp[x+1][y]>h[x][y]+1)) l.push(make_pair(v+1,make_pair(x+1,y)));\n        if (y<n-1 && m[x][y+1] && h[x][y+1]>h[x][y]+1 && (x==x2 && y+1==y2 && temp[x][y+1]>=h[x][y]+1 || !(x==x2 && y+1==y2) && temp[x][y+1]>h[x][y]+1)) l.push(make_pair(v+1,make_pair(x,y+1)));\n    }\n    return h[x2][y2];\n}\nvoid add_edge(int a,int b,int cap)\n{\n    edge e1={a,b,cap,0};\n    edge e2={b,a,0,0};\n    g[a].push_back((int)e.size());\n    e.push_back(e1);\n    g[b].push_back((int)e.size());\n    e.push_back(e2);\n}\nbool bfs()\n{\n    queue <int> q;\n    q.push(0);\n    memset(d,-1,(n*n*2+2)*sizeof d[0]);\n    d[0]=0;\n    while (!q.empty() && d[n*n*2+1]==-1)\n    {\n        int v=q.front();\n        q.pop();\n        for(size_t j=0;j<g[v].size();j++)\n        {\n            int id=g[v][j],to=e[id].b;\n            if (d[to]==-1 && e[id].flow<e[id].cap)\n            {\n                q.push(to);\n                d[to]=d[v]+1;\n            }\n        }\n    }\n    return d[n*n*2+1]!=-1;\n}\nint dfs(int v,int flow)\n{\n    if (!flow) return 0;\n    if (v==n*n*2+1) return flow;\n    for(;ptr[v]<(int)g[v].size();ptr[v]++)\n    {\n        int id=g[v][ptr[v]],to=e[id].b;\n        if (d[to]!=d[v]+1) continue;\n        int pushed=dfs(to,min(flow,e[id].cap-e[id].flow));\n        if (pushed)\n        {\n            e[id].flow+=pushed;\n            e[id^1].flow-=pushed;\n            return pushed;\n        }\n    }\n    return 0;\n}\nint max_flow()\n{\n    int flow=0;\n    for(;;)\n    {\n        if (!bfs()) break;\n        memset(ptr,0,(n*n*2+2)*sizeof ptr[0]);\n        while (int pushed=dfs(0,INF))\n            flow+=pushed;\n    }\n    return flow;\n}\nint main()\n{\n    cin>>n>>t;\n    queue <pair <int,pair <int,int> > > l;\n    char x;\n    int k=1;\n    for(int i=0;i<n;i++)\n    {\n        for(int j=0;j<n;j++)\n        {\n            cin>>x;\n            temp[i][j]=t;\n            if (x=='Z')\n            {\n                xb=i;\n                yb=j;\n                m[i][j]=false;\n            } else\n            if (x=='Y') m[i][j]=false; else m[i][j]=true;\n            add_edge(0,k++,x=='Z' || x=='Y'?0:x-48);\n        }\n    }\n    k=n*n+1;\n    for(int i=0;i<n;i++)\n        for(int j=0;j<n;j++)\n        {\n            cin>>x;\n            if (x>='0' && x<='9') kaps[i][j]=x-48;\n            add_edge(k++,n*n*2+1,x=='Z' || x=='Y'?0:x-48);\n        }\n    l.push(make_pair(0,make_pair(xb,yb)));\n    while (!l.empty())\n    {\n        int v=l.front().first,x=l.front().second.first,y=l.front().second.second;\n        l.pop();\n        temp[x][y]=v;\n        if (x>0 && v+1<temp[x-1][y] && m[x-1][y]) l.push(make_pair(v+1,make_pair(x-1,y)));\n        if (y>0 && v+1<temp[x][y-1] && m[x][y-1]) l.push(make_pair(v+1,make_pair(x,y-1)));\n        if (x<n-1 && v+1<temp[x+1][y] && m[x+1][y]) l.push(make_pair(v+1,make_pair(x+1,y)));\n        if (y<n-1 && v+1<temp[x][y+1] && m[x][y+1]) l.push(make_pair(v+1,make_pair(x,y+1)));\n    }\n    /*for(int i=0;i<n;i++)\n    {\n        for(int j=0;j<n;j++)\n            cout<<temp[i][j]<<\" \";\n        cout<<endl;\n    }*/\n    k=0;\n    for(int i=0;i<n;i++)\n        for(int j=0;j<n;j++)\n        {\n            int k1=n*n;\n            k++;\n            for(int z=0;z<n;z++)\n                for(int w=0;w<n;w++)\n                {\n                    k1++;\n                    if (m[i][j] && m[z][w] && way(i,j,z,w)<=t) add_edge(k,k1,INF);\n                }\n        }\n    /*for(int i=0;i<n*n*2+1;i++)\n        for(size_t j=0;j<g[i].size();j++)\n            if (e[g[i][j]].cap>0) cout<<i<<\" \"<<e[g[i][j]].b<<\" \"<<e[g[i][j]].cap<<endl;*/\n    cout<<max_flow();\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 1 << 29\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n    \n    m = [[False]*11 for _ in range(11)]\n    temp = [[t]*11 for _ in range(11)]\n    kaps = [[0]*11 for _ in range(11)]\n    \n    # graph structures (1-indexed vertices)\n    g = [[] for _ in range(500)]\n    e = []  # list of edges as tuples (a, b, cap, flow)\n    \n    def add_edge(a, b, cap):\n        e.append((a, b, cap, 0))\n        g[a].append(len(e)-1)\n        e.append((b, a, 0, 0))\n        g[b].append(len(e)-1)\n    \n    xb = yb = 0\n    k = 1\n    for i in range(n):\n        for j in range(n):\n            x = next(it)\n            temp[i][j] = t\n            if x == 'Z':\n                xb = i\n                yb = j\n                m[i][j] = False\n            elif x == 'Y':\n                m[i][j] = False\n            else:\n                m[i][j] = True\n            cap = 0 if (x == 'Z' or x == 'Y') else ord(x) - 48\n            add_edge(0, k, cap)\n            k += 1\n    \n    k = n*n + 1\n    for i in range(n):\n        for j in range(n):\n            x = next(it)\n            if '0' <= x <= '9':\n                kaps[i][j] = ord(x) - 48\n            cap = 0 if (x == 'Z' or x == 'Y') else ord(x) - 48\n            add_edge(k, n*n*2+1, cap)\n            k += 1\n    \n    # BFS for temp (time to reach each cell from start)\n    l = deque()\n    l.append((0, xb, yb))\n    while l:\n        v, x, y = l.popleft()\n        temp[x][y] = v\n        if x > 0 and v+1 < temp[x-1][y] and m[x-1][y]:\n            l.append((v+1, x-1, y))\n        if y > 0 and v+1 < temp[x][y-1] and m[x][y-1]:\n            l.append((v+1, x, y-1))\n        if x < n-1 and v+1 < temp[x+1][y] and m[x+1][y]:\n            l.append((v+1, x+1, y))\n        if y < n-1 and v+1 < temp[x][y+1] and m[x][y+1]:\n            l.append((v+1, x, y+1))\n    \n    def way(x1, y1, x2, y2):\n        l = deque()\n        l.append((0, x1, y1))\n        h = [[INF]*11 for _ in range(11)]\n        while l:\n            v, x, y = l.popleft()\n            h[x][y] = v\n            if x > 0 and m[x-1][y] and h[x-1][y] > h[x][y] + 1:\n                if (x-1==x2 and y==y2 and temp[x-1][y] >= h[x][y]+1) or (not (x-1==x2 and y==y2) and temp[x-1][y] > h[x][y]+1):\n                    l.append((v+1, x-1, y))\n            if y > 0 and m[x][y-1] and h[x][y-1] > h[x][y] + 1:\n                if (x==x2 and y-1==y2 and temp[x][y-1] >= h[x][y]+1) or (not (x==x2 and y-1==y2) and temp[x][y-1] > h[x][y]+1):\n                    l.append((v+1, x, y-1))\n            if x < n-1 and m[x+1][y] and h[x+1][y] > h[x][y] + 1:\n                if (x+1==x2 and y==y2 and temp[x+1][y] >= h[x][y]+1) or (not (x+1==x2 and y==y2) and temp[x+1][y] > h[x][y]+1):\n                    l.append((v+1, x+1, y))\n            if y < n-1 and m[x][y+1] and h[x][y+1] > h[x][y] + 1:\n                if (x==x2 and y+1==y2 and temp[x][y+1] >= h[x][y]+1) or (not (x==x2 and y+1==y2) and temp[x][y+1] > h[x][y]+1):\n                    l.append((v+1, x, y+1))\n        return h[x2][y2]\n    \n    # Add edges between all pairs of cells within time limit\n    k = 0\n    for i in range(n):\n        for j in range(n):\n            k += 1\n            k1 = n*n\n            for z in range(n):\n                for w in range(n):\n                    k1 += 1\n                    if m[i][j] and m[z][w] and way(i,j,z,w) <= t:\n                        add_edge(k, k1, INF)\n    \n    # Dinic max flow\n    d = [-1]*500\n    ptr = [0]*500\n    \n    def bfs():\n        q = deque()\n        q.append(0)\n        for i in range(n*n*2+2):\n            d[i] = -1\n        d[0] = 0\n        while q and d[n*n*2+1] == -1:\n            v = q.popleft()\n            for id_ in g[v]:\n                to = e[id_][1]\n                if d[to] == -1 and e[id_][2] - e[id_][3] > 0:\n                    q.append(to)\n                    d[to] = d[v] + 1\n        return d[n*n*2+1] != -1\n    \n    def dfs(v, flow):\n        if flow == 0:\n            return 0\n        if v == n*n*2+1:\n            return flow\n        while ptr[v] < len(g[v]):\n            id_ = g[v][ptr[v]]\n            to = e[id_][1]\n            if d[to] == d[v] + 1:\n                pushed = dfs(to, min(flow, e[id_][2] - e[id_][3]))\n                if pushed:\n                    e[id_] = (e[id_][0], e[id_][1], e[id_][2], e[id_][3] + pushed)\n                    e[id_^1] = (e[id_^1][0], e[id_^1][1], e[id_^1][2], e[id_^1][3] - pushed)\n                    return pushed\n            ptr[v] += 1\n        return 0\n    \n    flow = 0\n    while True:\n        if not bfs():\n            break\n        for i in range(n*n*2+2):\n            ptr[i] = 0\n        while True:\n            pushed = dfs(0, INF)\n            if pushed == 0:\n                break\n            flow += pushed\n    \n    print(flow)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.2993728e-05, 0.0, -3.576278e-07, -0.0009288049, -0.4771093, -0.000952148, -0.0002934502, -0.00041083002, -0.00035363142, -3.576278e-07, -9.3336515e-05, -0.023789564, -0.0123904245, -5.7220295e-06, -0.0008332833, -0.0790725, -0.001265321, -1.1920928e-07, -0.00016473368, -0.6935405, -0.081143305, -0.82216924, -0.06222193, -1.3113013e-06, -0.8260802, -5.2212305e-05, -0.00025138078, -8.344647e-07, -5.3404336e-05, -1.4305105e-06, -1.1369138, -1.1563234e-05, -6.675698e-06, -0.00017093151, -1.3470559e-05, -0.018416133, -3.576278e-07, -1.1920928e-07, -0.00038020534, -2.0265559e-06, -1.3113013e-06, -0.00011860621, -3.576278e-07, -0.013927885, -2.3841855e-07, -4.7683704e-07, -2.3841855e-07, -5.6146e-05, -0.00026151098, -0.00017832119, -0.00012385078, -2.3841855e-07, -3.576278e-07, 0.0, -9.595887e-05, -5.960463e-07, -0.0054211034, -0.013739418, -5.4836123e-06, -2.3841855e-07, -2.3841855e-07, -0.25194377, -0.07892214, -7.152555e-07, -0.17402959, -1.3589766e-05, -5.364