;\n        for(int i = 0; i < n; i++) {\n            a[i] = Integer.parseInt(aStr[i]);\n        }\n\n        List<Integer> a1 = new ArrayList<>();\n        List<Integer> a2 = new ArrayList<>();\n\n        int n1 = n / 2;\n\n        // Generate sums1\n        sums1(0, 0);\n        // Generate sums2\n        sums2(n1, 0);\n\n        // Remove duplicates and sort\n        Set<Integer> a1Set = new HashSet<>(a1);\n        a1 = new ArrayList<>(a1Set);\n        Collections.sort(a1);\n\n        int ans = 0;\n        int end = a2.size() - 1;\n\n        for (int iVal : a2) {\n            int target = (m - iVal);\n            int j = Collections.binarySearch(a1, target);\n            if (j < 0) {\n                j = -j - 1; // insertion point\n            }\n            if (j > 0) {\n                int sumVal = a1.get(j - 1) + iVal;\n                if (ans < sumVal) {\n                    ans = sumVal;\n                }\n            }\n        }\n\n        System.out.println(ans);\n\n        // Helper methods\n        void sums1(int i, int sum) {\n            if (i == n1) {\n                a1.add(sum % m);\n            } else {\n                sums1(i + 1, (sum + a[i]) % m);\n                sums1(i + 1, sum);\n            }\n        }\n\n        void sums2(int i, int sum) {\n            if (i == n) {\n                a2.add(sum);\n            } else {\n                sums2(i + 1, (sum + a[i]) % m);\n                sums2(i + 1, sum);\n            }\n        }\n    }\n}\n\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.9019050598144531, -9.088346359931165e-07, -3.130576806142926e-05, -0.04164442792534828, -0.049290936440229416, -4.723352049040841e-06, -0.22552546858787537, -0.0008015265921130776, -4.5014188799541444e-05, -5.512236498361744e-07, -0.011192589066922665, -0.00318912067450583, -0.0004343645414337516, -1.3856492842023727e-06, 0.0, -2.0339031834737398e-05, 0.0, -9.014684110297821e-06, -1.5048530030981055e-06, -4.320199877838604e-07, -4.9663132813293