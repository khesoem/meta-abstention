              C[i][j] = (C[i][j] + aik * B[k][j]) % MOD\n    return C\n\ndef mat_identity(sz):\n    I = [[0] * sz for _ in range(sz)]\n    for i in range(sz):\n        I[i][i] = 1\n    return I\n\ndef jia(x, d):\n    \"\"\"Rotate the first (sz-1) rows and columns by d, leaving last row/col fixed.\"\"\"\n    sz = len(x)\n    ret = [[0] * sz for _ in range(sz)]\n    for i in range(sz):\n        for j in range(sz):\n            ni = (i + d) % (sz - 1) if i < sz - 1 else sz - 1\n            nj = (j + d) % (sz - 1) if j < sz - 1 else sz - 1\n            ret[ni][nj] = x[i][j] % MOD\n    return ret\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    \n    # base representation: digits from least significant\n    digits = []\n    while n:\n        digits.append(n % k)\n        n //= k\n    tot = len(digits)\n    \n    # matrix size = k+1\n    sz = k + 1\n    # one matrix\n    one = mat_identity(sz)\n    \n    # a[0]\n    a0 = [[0] * sz for _ in range(sz)]\n    for j in range(sz):\n        a0[0][j] = 1\n        a0[j][j] = 1\n    a = [a0]   # indices 0 .. tot-1 (if tot >= 1, else only a[0])\n    \n    # Build a[i] for i = 1 .. tot-1\n    for i in range(1, tot):\n        now = one\n        for j in range(k):\n            now = mat_mul(now, jia(a[i-1], j))\n        a.append(now)\n    \n    # Process digits from most significant to least\n    ans = one\n    ad = 0\n    for i in range(tot - 1, -1, -1):\n        d = digits[i]\n        for j in range(d):\n            ans = mat_mul(ans, jia(a[i], (j + ad) % k))\n        ad = (ad + d) % k\n    \n    # Sum last column of ans\n    result = 0\n    for i in range(sz):\n        result = (result + ans[i][k]) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-5.960462772236497e-07, -8.344646857949556e-07, 0.0, -0.0001805857609724626, -0.0009919252479448915,