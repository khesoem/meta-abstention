n    for _ in range(m):\n        i = int(next(it)) - 1\n        j = int(next(it)) - 1\n        aa[i].append(j)\n        aa[j].append(i)\n\n    t = n + k + 1                  # number of time layers\n    N = n * t + 1                  # total nodes (including source)\n    # We'll store edges in arrays similar to Java code\n    # Edge indexing: each directed edge corresponds to an index\n    # For each edge we store: uu, vv, uv (u xor v), cost, cc (capacity)\n    uu = []\n    vv = []\n    uv = []\n    cost = []\n    cc = []  # capacities\n    adj = [[] for _ in range(N)]   # adjacency list: indices of directed edges\n\n    def link(u, v, cap, cos):\n        \"\"\"add a directed edge from u to v with given capacity and cost,\n           and the reverse edge with 0 capacity and -cost\"\"\"\n        h = len(uu)                # edge pair index\n        uu.append(u)\n        vv.append(v)\n        uv.append(u ^ v)\n        cost.append(cos)\n        cc.append(cap)             # forward capacity\n        cc.append(0)               # reverse capacity (will be set later)\n        adj[u].append(h * 2)       # forward edge index\n        adj[v].append(h * 2 + 1)   # reverse edge index\n\n    # Build the flow network\n    # 1. Edges representing moving along original edges between time steps\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            for j in aa[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    link(u, v, 1, c + (2 * x - 1) * d)\n\n    # 2. Edges representing staying in place\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            stay_cost = 0 if i == 0 else c\n            link(u, v, k, stay_cost)\n\n    # 3. Source edges: source is node N-1, robot starts at time 0\n    src = N - 1\n    for h in range(k):\n        robot_start = ii[h] * t + 0   # node of robot h at time 0\n        link(src, robot_start, 1, 0)\n\n    sink = 0 * t + (t - 1)        # node at time t-1 for location 0\n\n    # Min-cost flow with unit capacity (k pushes)\n    # SPFA and successive shortest path\n\n    pi = [INF] * N   # potentials (distance from source, with potential)\n    dd = [0] * N     # number of edges from source (for tie-breaking)\n    bb = [0] * N     # predecessor edge index (directed edge)\n    iq = [False] * N\n\n    def spfa(s, t):\n        \"\"\"Bellman-Ford (SPFA) to compute shortest distances with potentials\"\"\"\n        for i in range(N):\n            pi[i] = INF\n        pi[s] = 0\n        dd[s] = 0\n        q = deque()\n        q.append(s)\n        iq[s] = True\n        while q:\n            u = q.popleft()\n            iq[u] = False\n            d = dd[u] + 1\n            for h_ in adj[u]:\n                if cc[h_] > 0:\n                    h = h_ // 2\n                    # cost adjustment depending on direction\n                    p = pi[u] + (cost[h] if (h_ & 1) == 0 else -cost[h])\n                    v = u ^ uv[h]\n                    if pi[v] > p or (pi[v] == p and dd[v] > d):\n                        pi[v] = p\n                        dd[v] = d\n                        bb[v] = h_\n                        if not iq[v]:\n                            q.append(v)\n                            iq[v] = True\n        return pi[t] != INF\n\n    def push1(s, t):\n        \"\"\"Augment one unit of flow along the path stored in bb (predecessors)\"\"\"\n        u = t\n        while u != s:\n            h_ = bb[u]\n            h = h_ // 2\n            cc[h_] -= 1\n            cc[h_ ^ 1] += 1\n            u = u ^ uv[h]\n\n    # Actually it's successive shortest path with unit capacities (each push sends 1)\n    while spfa(src, sink):\n        push1(src, sink)\n\n    # Compute total cost: flow on reverse edges gives the cost\n    total = 0\n    for h in range(len(uu)):\n        total += cost[h] * cc[h * 2 + 1]   # reverse edge capacity is flow\n    print(total)\n\nif __name__ == \"__m