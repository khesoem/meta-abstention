,vis[to[v]]=true);\n    }\n    return dep[t]<iinf;\n}\npair<int,int> mcmf(){\n    pair<int,int> res(0,0);\n    while(spfa()){\n        int f=iinf;\n        for(int u=t;u!=s;u=to[pre[u]^1]) f=min(f,fw[pre[u]]);\n        for(int u=t;u!=s;u=to[pre[u]^1]) fw[pre[u]]-=f,fw[pre[u]^1]+=f;\n        res.x+=f,res.y+=dep[t]*f;\n    }\n    return res;\n}\n\n//Main\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0),cout.tie(0);\n    cin>>n>>m>>k>>c>>d,mxt=N*3+1;\n    fn=(t=(s=n*mxt)+1)+1;\n    R(i,0,k){int u;cin>>u,--u,adde(s,u,1,0);}\n    while(m--){\n        int u,v; cin>>u>>v,--u,--v;\n        R(i,0,mxt-1)R(p,1,k+1)\n            adde(i*n+u,(i+1)*n+v,1,2*d*p-d),\n            adde(i*n+v,(i+1)*n+u,1,2*d*p-d);\n    }\n    R(u,0,n)R(i,0,mxt-1) adde(i*n+u,(i+1)*n+u,k,0);\n    R(i,0,mxt) adde(i*n,t,k,i*c);\n    pair<int,int> ans=mcmf();\n    assert(ans.x==k);\n    cout<<ans.y<<'\\n';\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\n# Start\nll = int\ndb = float\nmp = lambda a, b: (a, b)\nx = 0\ny = 1\nbg = lambda a: a[0]\ned = lambda a: a[-1]\nsz = lambda a: len(a)\npb = lambda a, b: a.append(b)\nR = lambda i, a, b: range(a, b)\nL = lambda i, a, b: range(b - 1, a - 1, -1)\n\niinf = 0x3f3f3f3f\nlinf = 0x3f3f3f3f3f3f3f3f\n\n# Data\nN = 50\nn, m, k, c, d = 0, 0, 0, 0, 0\nmxt = 0\n\n# Flows\nfN = (N * 3 + 1) * N + 2\ns = 0\nt = 0\nfn = 0\n\ne = [[] for _ in range(fN)]\nto = []\nfw = []\nco = []\n\ndef adde(u, v, w, c):\n    e[u].append(len(to))\n    to.append(v)\n    fw.append(w)\n    co.append(+c)\n    e[v].append(len(to))\n    to.append(u)\n    fw.append(0)\n    co.append(-c)\n\ndep = [0] * fN\npre = [-1] * fN\nvis = [False] * fN\n\ndef spfa():\n    for i in range(fn):\n        dep[i] = iinf\n        pre[i] = -1\n        vis[i] = False\n    q = deque()\n    q.append(s)\n    vis[s] = True\n    dep[s] = 0\n