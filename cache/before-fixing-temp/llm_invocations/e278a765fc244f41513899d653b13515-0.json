 acc+d+1, res1, already_in);\n    already_in[d+1] -= sign;\n  }\n  return res1 < res2 ? res1 : res2;\n}\n\nint main(int argc, char* argv[]) {\n  int64_t n;\n  std::cin >> n;\n  std::vector<int> already_in(20, 0);\n  std::cout << aux(n, 1, 0, aux2(n), already_in) << std::endl;\n  return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\ndef nb_digits(n):\n    n = -n if n < 0 else n\n    digits = 0\n    while n:\n        digits += 1\n        n //= 10\n    return digits\n\ndef ones(n):\n    res = 0\n    for _ in range(n):\n        res = 10 * res + 1\n    return res\n\ndef aux2(n):\n    if n == 0:\n        return 0\n    n = -n if n < 0 else n\n    d = nb_digits(n)\n    return d + aux2(n - ones(d))\n\ndef aux(n, sign, acc, max_val, already_in):\n    if acc >= max_val:\n        return max_val\n    if n == 0:\n        return acc\n    if n < 0:\n        n = -n\n        sign = -sign\n    d = nb_digits(n)\n    ones_d = ones(d)\n    res1 = max_val\n    res2 = max_val\n\n    # condition: 0 <= already_in[d]*sign and -10 < already_in[d] < 10\n    if 0 <= already_in[d] * sign and -10 < already_in[d] < 10:\n        already_in[d] += sign\n        res1 = aux(n - ones_d, sign, acc + d, max_val, already_in)\n        already_in[d] -= sign\n\n    if 0 <= already_in[1 + d] * sign and -10 < already_in[1 + d] < 10:\n        already_in[d + 1] += sign\n        res2 = aux(n - 10 * ones_d - 1, sign, acc + d + 1, res1, already_in)\n        already_in[d + 1] -= sign\n\n    return res1 if res1 < res2 else res2\n\ndef main():\n    import sys\n    n = int(sys.stdin.readline().strip())\n    already_in = [0] * 20\n    print(aux(n, 1, 0, aux2(n), already_in))\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [0.0, -8.344646857949556e-07, 0.0, -0.00011777184408856556, -1.1422545909881592, -2.9802276912960224e-06,