       for(int k = h[c]; ~k; k = ne[k]) if (cap[k] > 0) {\n                int v = to[k];\n                if(dis[c] + cost[k] < dis[v]){\n                    dis[v] = dis[c] + cost[k];\n                    pre[v] = k;\n                    if(!ing[v]) Q.push(v) , ing[v] = 1;\n                }\n            }\n        }\n        return dis[t] != inf;\n    }\n    U flow; V mincost;\n    pair<U, V> run(int _s,int _t){\n        s = _s , t = _t;\n        flow = mincost = 0;\n        while(spfa()){\n            U pl = inf; int p, k;\n            for(p = t;p != s;p = to[k^1]) pl = min(pl, cap[k = pre[p]]);\n            for(p = t;p != s;p = to[k^1]) cap[k = pre[p]] -= pl, cap[k^1] += pl;\n\t\t\tmincost += pl * dis[t];\n            flow += pl;\n        }\n        return make_pair(flow, mincost);\n    }\n};\nMCMF<int,int> flow;\nint n , m , k ,c , d ,a[N] , id[55][2500];\nint main(){\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);\n\trep(i , 1 , k + 1)\n\t\tscanf(\"%d\",&a[i]);\n\tflow.ini(50*50*4 + 10);\n\tint s = flow.n - 2,t = flow.n - 3;\n\tint cnt = 0 ,mx = 100;\n\trep(i , 1 , n + 1)\n\t\trep(j , 0 , mx + 1)\n\t\t\tid[i][j] = ++cnt;\n\tint u , v;\n\trep(i , 1 , m + 1){\n\t\tscanf(\"%d%d\",&u,&v);\n\t\trep(j , 0 , mx){\n\t\t\trep(h , 1 , k + 1){\n\t\t\t\tint tmp = h*h*d - (h-1)*(h-1)*d;\n\t\t\t\tflow.link(id[u][j] , id[v][j + 1] , 1 , c + tmp);\n\t\t\t\tflow.link(id[v][j] , id[u][j + 1] , 1 , c + tmp);\n\t\t\t}\n\t\t}\n\t}\n\trep(i , 1 , n + 1)\n\t\trep(j , 0 , mx)\n\t\t\tflow.link(id[i][j] , id[i][j + 1] , inf , c);\n\trep(i , 1 , k + 1)\n\t\tflow.link(s , id[a[i]][0] , 1 , 0);\n\trep(j , 1 , mx + 1)flow.link(id[1][j] , t , inf , 0);\n\tint ans = flow.run(s , t).se;\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nclass Edge:\n    __slots__ = ('to', 'cap', 'cost', 'rev')\n    def __init__(self, to, cap, cost, rev):\n        self.to = to\n        self.cap = cap\n        self.cost = cost\n        self.rev = rev\n\nclass MCMF:\n    def __init__(self, n):\n        self.n = n\n        self.graph = [[] for _ in range(n)]\n\n    def add_edge(self, fr, to, cap, cost):\n        forward = Edge(to, cap, cost, len(self.graph[to]))\n        backward = Edge(fr, 0, -cost, len(self.graph[fr]))\n        self.graph[fr].append(forward)\n        self.graph[to].append(backward)\n\n    def spfa(self, s, t):\n        INF = 10**18\n        dist = [INF] * self.n\n        inq = [False] * self.n\n        prevv = [0] * self.n\n        preve = [0] * self.n\n        dist[s] = 0\n        q = deque([s])\n        inq[s] = True\n        while q:\n            v = q.popleft()\n            inq[v] = False\n            for i, e in enumerate(self.graph[v]):\n                if e.cap > 0 and dist[e.to] > dist[v] + e.cost:\n                    dist[e.to] = dist[v] + e.cost\n                    prevv[e.to] = v\n                    preve[e.to] = i\n                    if not inq[e.to]:\n                        q.append(e.to)\n                        inq[e.to] = True\n        if dist[t] == INF:\n            return None\n        return dist[t], prevv, preve\n\n    def run(self, s, t):\n        flow = 0\n        cost = 0\n        INF = 10**18\n        while True:\n            res = self.spfa(s, t)\n            if res is None:\n                break\n            d, prevv, preve = res\n            add = INF\n            v = t\n            while v != s:\n                e = self.graph[prevv[v]][preve[v]]\n                add = min(add, e.cap)\n                v = prevv[v]\n            v = t\n            while v != s:\n                e = self.graph[prevv[v]][preve[v]]\n                e.cap -= add\n                self.graph[v][e.rev].cap += add\n                v = prevv[v]\n            flow += add\n            cost += add * d\n        return flow, cost\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    it = iter(data)\n    n = next(it); m = next(it); k = next(it); c = next(it); d = next(it)\n    a = [next(it) for _ in range(k)]\n    # node indexing: id[i][t] for i=1..n, t=0..mx (mx=100)\n    mx = 100\n    cnt = 0\n    id = [[0]*(mx+1) for _ in range(n+1)]\n    for i in range(1, n+1):\n        for j in range(mx+1):\n            cnt += 1\n            id[i][j] = cnt\n    total_nodes = cnt + 2  # s and t\n    flow = MCMF(total_nodes+5)  # extra margin\n    s = total_nodes - 2\n    t = total_nodes - 3\n    # edges for each original road\n    for _ in range(m):\n        u = next(it); v = next(it)\n        for j in range(mx):\n            for h in range(1, k+1):\n                tmp = h*h*d - (h-1)*(h-1)*d\n                flow.add_edge(id[u][j], id[v][j+1], 1, c + tmp)\n                flow.add_edge(id[v][j], id[u][j+1], 1, c + tmp)\n    # stay edges\n    INF = 10**18\n    for i in range(1, n+1):\n        for j in range(mx):\n            flow.add_edge(id[i][j], id[i][j+1], INF, c)\n    # source to start positions\n    for i in range(k):\n        flow.add_edge(s, id[a[i]][0], 1, 0)\n    # sink edges from node 1 at each time\n    for j in range(1, mx+1):\n        flow.add_edge(id[1][j], t, INF, 0)\n    ans = flow.run(s, t)[1]\n    print(ans)\n\nif __name__ == '__main__':\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-6.151010165922344e-05, 0.0, 0.0, -0.0003638797497842461, -0.008642531931400299, -2.3841830625315197e-06, -0.31344202160835266, -0.05085292086005211, -3.814624506048858e-05, -1.1920928244535389e-07, -0.0002047805901383981, -0.005547722801566124, -0.06451164186000824, -2.127004623413086, -3.814689989667386e-06, -2.169585604860913e-05, -0.16027244925498962, 0.0, -5.960462772236497e-07, -2.145764938177308e-06, -3.6238969187252223e-05, -0.013873571529984474, -7.676783570786938e-05, -0.0009116546134464443, -1.3708974620385561e-05, -0.6931873559951782, -3.576278118089249e-07, -1.