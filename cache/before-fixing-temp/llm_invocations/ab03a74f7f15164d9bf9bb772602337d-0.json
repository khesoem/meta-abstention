dx);\n                    if (e.cap > e.flow && d[e.v] > d[u] + e.cost) {\n                        d[e.v] = d[u] + e.cost;\n                        p[e.v] = idx;\n                        a[e.v] = Math.min(a[u], e.cap - e.flow);\n                        if (!inq[e.v]) {\n                            Q.add(e.v);\n                            inq[e.v] = true;\n                        }\n                    }\n                }\n            }\n\n            if (d[t] == Integer.MAX_VALUE / 2) return false;\n            flowRef[0] = a[t];\n            costRef[0] = d[t];\n            int u = t;\n            while (u != s) {\n                Edge e = E.get(p[u]);\n                e.flow += a[t];\n                E.get(p[u] ^ 1).flow -= a[t];\n                u = e.u;\n            }\n            return true;\n        }\n\n        int[] mincost(int s, int t) {\n            this.s = s;\n            this.t = t;\n            int Mcost = 0, Flow = 0;\n            int[] flowRef = new int[1];\n            int[] costRef = new int[1];\n            while (bellmanFord(flowRef, costRef)) {\n                Flow += flowRef[0];\n                Mcost += flowRef[0] * costRef[0];\n            }\n            return new int[] { Flow, Mcost };\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int C = sc.nextInt();\n        int D = sc.nextInt();\n\n        int totalNodes = n * 100 + 2;\n        int source = n * 100;\n        int sink = n * 100 + 1;\n\n        MCMF solver = new MCMF(totalNodes);\n\n        for (int i = 0; i < 100; i++) {\n            solver.addEdge(i, sink, k, C * i);\n        }\n\n        for (int i = 0; i < k; i++) {\n            int x = sc.nextInt() - 1;\n            solver.addEdge(source, x * 100, 1, 0);\n        }\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 1; j < 100; j++) {\n                solver.addEdge(i * 100 + j - 1, i * 100 + j, k, 0);\n            }\n        }\n\n        while (m-- > 0) {\n            int u = sc.nextInt() - 1;\n            int v = sc.nextInt() - 1;\n\n            for (int j = 1; j < 100; j++) {\n                int a = u * 100 + j - 1;\n                int b = v * 100 + j;\n                int c = v * 100 + j - 1;\n                int d = u * 100 + j;\n\n                for (int i = 1, cost = D; i <= k; i++, cost += 2 * D) {\n                    solver.addEdge(a, b, 1, cost);\n                    solver.addEdge(c, d, 1, cost);\n                }\n            }\n        }\n\n        int[] result = solver.mincost(source, sink);\n        System.out.println(result[1]);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-2.50339189733495e-06, 0.0, -2.3841855067985307e-07, -0.0012663925299420953, -0.10065510869026184, -3.576278118089249e-07, -5.864924969500862e-05, -0.0021548878867179155, -0.04866068437695503, -3.576278118089249e-07, -0.025753280147910118, -0.029776105657219887, -0.004091939423233271, -0.005061550531536341, -0.10060271620750427, -0.061989910900592804, -2.50339189733495e-06, -2.3841855067985307e-07, -1.0490362910786644e-05, -9.536738616588991e-07, -1.5139465176616795e-05, 0.0, -0.2519460916519165, -1.5497195136049413e-06, 0.0, -1.4305104514278355e-06, -9.536738616588991e-07, 0.0, -0.001725019421428442, -1.7762025890988298e-05, -0.0011716175358742476, -2.109982233378105e-05, -2.622600959512056e-06, -1.537788011773955e-05, 0.0, 0.0, 0.0, 0.0, -2.3841830625315197e-06, -1.4305104514278355e-06, -4.410734163684538e-06, -0.018156517297029495, 0.0, 0.0, 0.0, -5.364403477869928e-06, -1.2993727978027891e-05, -7.152555099310121e-07, 0.0, 0.0, -1.3112935448589269e-05, 0.0, -0.20141790807247162, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, 0.0, 0.0, -3.576278118089249e-07, 0.0, 0.0, 0.0, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -9.536738616588991e-07, -4.768370445162873e-07,