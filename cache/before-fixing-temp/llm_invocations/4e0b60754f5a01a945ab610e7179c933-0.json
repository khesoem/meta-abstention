[0])\n    rows_b, cols_b = len(b), len(b[0])\n    c = [[0]*cols_b for _ in range(rows_a)]\n    for i in range(rows_a):\n        for j in range(cols_b):\n            for k in range(cols_a):\n                c[i][j] = (c[i][j] + a[i][k] * b[k][j]) % mod\n    return c\n\ndef matrix_power(matrix, power, mod):\n    result = [[1 if i == j else 0 for j in range(len(matrix))] for i in range(len(matrix))]\n    base = matrix\n    while power > 0:\n        if power & 1:\n            result = matrix_multiply(result, base, mod)\n        base = matrix_multiply(base, base, mod)\n        power >>= 1\n    return result\n\ndef main():\n    data = input().split()\n    n = int(data[0])\n    m = int(data[1])\n    l = int(data[2])\n    r = int(data[3])\n\n    MOD = 998244353\n\n    if n % 2 == 1 and m % 2 == 1:\n        def pow_mod(base, exp):\n            return exp_mod(exp_mod(base, exp, MOD), 1, MOD)\n        print(pow_mod(exp_mod(r - l + 1, n, MOD), m))\n        return\n\n    even = r // 2 - (l + 1) // 2 + 1\n    odd = r - l + 1 - even\n    mat = [[even, odd], [odd, even]]\n\n    mat_n = matrix_power(mat, n, MOD)\n    mat_nm = matrix_power(mat_n, m, MOD)\n    print(mat_nm[0][0])\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00680524529889226, -0.00022165567497722805, -2.2200749754119897e-06, -3.786196975852363e-05, -0.002785623073577881, -0.0036058940459042788, -0.11336025595664978, -2.943578004837036, -0.00016754455282352865, -9.088346359931165e-07, -4.320199877838604e-07, -0.001181777217425406, -0.14401863515377045, -0.5274245738983154, -3.2561755180358887, -0.9409265518188477, -0.5829984545707703, -7.755678961984813e-05, -2.0550622940063477, -5.0259150157216936e-05, -0.19384896755218506, -0.07015617191791534, -7.226628895296017e-06, -0.03151705488562584, -5.9153885558771435e-06, -6.704273118884885e-07, -4.320199877838604e-07, -5.991464786347933e-05, -3.128163257315464e-07, -0.04974576085805893, -0.17984