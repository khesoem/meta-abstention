r\n        return res\r\n    invnum_INF=(N*(N-1))//2\r\n    if k<-invnum_INF-1:\r\n        res=solve(N,-invnum_INF-1,flag)\r\n        memo[N][flag][k]=res\r\n        return res\r\n    if k>=invnum_INF:\r\n        memo[N][flag][k]=0\r\n        return 0\r\n    res=0\r\n\r\n    for delta in range(-N+1,N):\r\n        if flag and (delta>0):\r\n            continue\r\n        wt=min(N-delta,delta+N)\r\n        res+=solve(N-1,k-delta,(delta==0)&flag)*wt\r\n        res%=mod\r\n    memo[N][flag][k]=res%mod\r\n    return res%mod\r\nans=solve(n,0,1)%mod\r\nprint(ans)\r\n\r\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "meta-llama/llama-3.1-8b-instruct"}, "response": {"samples": [{"content": "<original_code>\nfrom functools import lru_cache\nimport itertools\n\ndef invnum(seq):\n    N=len(seq)\n    res=0\n    for i in range(N):\n        for j in range(i+1,N):\n            if seq[i]>seq[j]:\n                res+=1\n    return res\ndef naive(N,k,flag):\n    res=0\n    for p in itertools.permutations(range(N),N):\n        for q in itertools.permutations(range(N),N):\n            if ((p<q) or (not(flag))) and (invnum(p)-invnum(q)>k):\n                res+=1\n    return res\nn,mod=map(int,input().split())\nmemo=[[{},{}] for _ in range(n+1)]\ndef solve(N,k,flag):\n    if k in memo[N][flag]:\n        return memo[N][flag][k]\n    '''\n    \u9577\u3055N\u306e\u9806\u5217\n    invnum(p)-invnum(q)>k\u3068\u306a\u308b\u5834\u5408\u306e\u6570\n    flag=True p<q\u306e\u6761\u4ef6\u3042\u308a\n    flag=False p<q\u306e\u6761\u4ef6\u306a\u3057\n    '''\n    if N==1:\n        res=-1\n        if flag:\n            res=0\n        else:\n            if k<0:\n                res=1\n            else:\n                res=0\n        memo[N][flag][k]=res\n        return res\n    invnum_INF=(N*(N-1))//2\n    if k<-invnum_INF-1:\n        res=solve(N,-invnum_INF-1,flag)\n        memo[N][flag][k]=res\n        return res\n    if k>=invnum_INF:\n        memo[N][flag][k]=0\n        return 0\n    res=0\n\n    for delta in range(-N+1,N):\n        if flag and (delta>0):\n            continue\n        wt=min(N-delta,delta+N)\n        res+=solve(N-1,k-delta,(delta==0)&flag)*wt%mod\n        res%=mod\n    memo[N][flag][k]=res%mod\n    return res%mod\nans=solve(n,0,1)%mod\nprint(ans)\n\n</original_code>\n\n<translated_code>\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        int mod = scanner.nextInt();\n        scanner.nextLine();  // Consume newline left-over\n\n        Map<Integer, Map<Integer, Map<Integer, Integer>>> memo = new HashMap<>();\n        for (int i = 0; i <= n; i++) {\n            memo.put(i, new HashMap<>());\n            memo.get(i).put(0, new HashMap<>());\n            memo.get(i).put(1, new HashMap<>());\n        }\n\n        System.out.println(solve(n, 0, 1, memo, mod));\n    }\n\n    public static int invnum(int[] seq) {\n        int N = seq.length;\n        int res = 0;\n        for (int i = 0; i < N; i++) {\n            for (int j = i + 1; j < N; j++) {\n                if (seq[i] > seq[j]) {\n                    res++;\n                }\n            }\n        }\n        return res;\n    }\n\n    public static int naive(int N, int k, boolean flag, int mod) {\n        int res = 0;\n        for (int[] p : getPermutations(N)) {\n            for (int[] q : getPermutations(N)) {\n                if (((Arrays.compare(p, q) < 0) || !flag) && (invnum(p) - invnum(q) > k)) {\n                    res++;\n                }\n            }\n        }\n        return res;\n    }\n\n    public static int[][] getPermutations(int N) {\n        int[][] permutations = new int[N][N];\n        permute(new int[N], 0, permutations);\n        return permutations;\n    }\n\n    public static void permute(int[] arr, int index, int[][] permutations) {\n        if (index == arr.length) {\n            permutations[permutations.length - 1][index] = arr[0];\n            return;\n        }\n        for (int i = 0; i <= arr.length; i++) {\n            arr[index] = i;\n            permute(arr, index + 1, permutations);\n        }\n    }\n\n    public static int compare(int[] a, int[] b) {\n        for (int i = 0; i < a.length; i++) {\n            if (a[i] < b[i]) {\n                return -1;\n            } else if (a[i] > b[i]) {\n                return 1;\n            }\n        }\n        return 0;\n    }\n\n    public static int solve(int N, int k, boolean flag, Map<Integer, Map<Integer, Map<Integer, Integer>>> memo, int mod) {\n        if (memo.get(N).get(flag ? 1 : 0).get(k) != null) {\n            return memo.get(N).get(flag ? 1 : 0).get(k);\n        }\n\n        if (N == 1) {\n            int res = -1;\n            if (flag) {\n                res = 0;\n            } else {\n                if (k < 0) {\n                    res = 1;\n                } else {\n                    res = 0;\n                }\n            }\n            memo.get(N).get(flag ? 1 : 0).put(k, res);\n            return res;\n        }\n\n        int invnum_INF = (N * (N - 1)) / 2;\n        if (k < -invnum_INF - 1) {\n            int res = solve(N, -invnum_INF - 1, flag, memo, mod);\n            memo.get(N).get(flag ? 1 : 0).put(k, res);\n            return res;\n        }\n\n        if (k >= invnum_INF) {\n            memo.get(N).get(flag ? 1 : 0).put(k, 0);\n            return 0;\n        }\n\n        int res = 0;\n\n        for (int delta = -N + 1; delta < N; delta++) {\n            if (flag && delta > 0) {\n                continue;\n            }\n\n            int wt = Math.min(N - delta, delta + N);\n            res += (solve(N - 1, k - delta, delta == 0 && flag, memo, mod) * wt + mod) % mod;\n            res %= mod;\n        }\n\n        memo.get(N).get(flag ? 1 : 0).put(k, res);\n        return res;\n    }\n}\n\n</translated_code>\n\n<confidence>0.8</confidence>", "token_logprobs": [-0.18