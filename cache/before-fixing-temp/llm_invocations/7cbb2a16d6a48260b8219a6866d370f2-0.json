    void init(int _n) {\n        n = _n;\n        adj.resize(n);\n        pi.resize(n);\n        dd.resize(n);\n        bb.resize(n);\n        inq.assign(n, false);\n        uu.clear(); vv.clear(); uv.clear(); cost.clear(); cc.clear();\n        m = 0;\n    }\n\n    void link(int u, int v, int cap, int cos) {\n        int h = m++;\n        uu.push_back(u);\n        vv.push_back(v);\n        uv.push_back(u ^ v);\n        cost.push_back(cos);\n        cc.push_back(cap);\n        cc.push_back(0);\n        adj[u].push_back(2 * h);\n        adj[v].push_back(2 * h + 1);\n    }\n\n    void enqueue(int v) {\n        if (!inq[v]) {\n            q.push_back(v);\n            inq[v] = true;\n        }\n    }\n\n    int dequeue() {\n        int u = q.front(); q.pop_front();\n        inq[u] = false;\n        return u;\n    }\n\n    bool spfa(int s, int t) {\n        fill(pi.begin(), pi.end(), INF);\n        fill(dd.begin(), dd.end(), 0);\n        fill(bb.begin(), bb.end(), 0);\n        pi[s] = 0;\n        dd[s] = 0;\n        q.clear();\n        enqueue(s);\n        while (!q.empty()) {\n            int u = dequeue();\n            int d = dd[u] + 1;\n            for (int h_ : adj[u]) {\n                if (cc[h_] > 0) {\n                    int h = h_ >> 1;\n                    int p = pi[u] + ((h_ & 1) == 0 ? cost[h] : -cost[h]);\n                    int v = u ^ uv[h];\n                    if (pi[v] > p || (pi[v] == p && dd[v] > d)) {\n                        pi[v] = p;\n                        dd[v] = d;\n                        bb[v] = h_;\n                        enqueue(v);\n                    }\n                }\n            }\n        }\n        return pi[t] != INF;\n    }\n\n    void push1(int s, int t) {\n        for (int u = t; u != s; ) {\n            int h_ = bb[u];\n            int h = h_ >> 1;\n            cc[h_]--;\n            cc[h_ ^ 1]++;\n            u ^= uv[h];\n        }\n    }\n\n    long long edmonds_karp(int s, int t) {\n        while (spfa(s, t))\n            push1(s, t);\n        long long total = 0;\n        for (int h = 0; h < m; h++)\n            total += (long long)cost[h] * cc[2 * h + 1];\n        return total;\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m, k, c, d;\n    cin >> n >> m >> k >> c >> d;\n\n    vector<int> ii(k);\n    for (int i = 0; i < k; ++i) {\n        cin >> ii[i];\n        ii[i]--;\n    }\n\n    vector<vector<int>> orig_adj(n);\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        cin >> u >> v;\n        u--; v--;\n        orig_adj[u].push_back(v);\n        orig_adj[v].push_back(u);\n    }\n\n    int T = n + k + 1; // number of time steps\n    int V = n * T + 1; // total nodes in flow network\n\n    MinCostMaxFlow solver;\n    solver.init(V);\n\n    // edges for movement\n    for (int i = 0; i < n; ++i) {\n        const auto& nei = orig_adj[i];\n        for (int s = 0; s < T - 1; ++s) {\n            int u = i * T + s;\n            for (int j : nei) {\n                int v = j * T + s + 1;\n                for (int x = 1; x <= k; ++x) {\n                    solver.link(u, v, 1, c + (x * 2 - 1) * d);\n                }\n            }\n        }\n    }\n\n    // edges for staying (waiting)\n    for (int i = 0; i < n; ++i) {\n        for (int s = 0; s < T - 1; ++s) {\n            int u = i * T + s, v = u + 1;\n            solver.link(u, v, k, (i == 0 ? 0 : c));\n        }\n    }\n\n    // source edges\n    for (int h = 0; h < k; ++h) {\n        solver.link(V - 1, ii[h] * T + 0, 1, 0);\n    }\n\n    int source = V - 1;\n    int sink = 0 * T + T - 1; // = T-1\n    long long ans = solver.edmonds_karp(source, sink);\n    cout << ans << '\\n';\n\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-0.0004213160718791187, 0.0, -3.576272320060525e-06, -0.0012013844680041075, -0.0032228692434728146, -1.311301275563892e-06, -0.0031825865153223276, -2.4318398573086597e-05, 0.0, 0.0, -3.528532761265