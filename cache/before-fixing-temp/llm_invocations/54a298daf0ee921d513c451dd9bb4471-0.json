000000;\n    int nA = (mask % 1000000) / 100;\n    int nB = mask % 100;\n    if (boat > 0) {\n        for (int i = nA; i >= 0 && 50 * (nA - i) <= k; i--) {\n            for (int j = nB; j >= 0 && 50 * (nA - i) + 100 * (nB - j) <= k; j--) {\n                if (i != nA || j != nB) {\n                    resolve(i, j, boat, mask, choose[nA][i] * choose[nB][j] % MOD);\n                }\n            }\n        }\n    } else {\n        for (int i = nA; i <= a && 50 * (i - nA) <= k; i++) {\n            for (int j = nB; j <= b && 50 * (i - nA) + 100 * (j - nB) <= k; j++) {\n                if (i != nA || j != nB) {\n                    resolve(i, j, boat, mask, choose[a - nA][i - nA] * choose[b - nB][j - jB] % MOD);\n                }\n            }\n        }\n    }\n}\n\nvoid resolve(int i, int j, int boat, int mask, long long edgeWays) {\n    int newMask = 1000000 * (1 - boat) + i * 100 + j;\n    int newD = ways[mask].d + 1;\n    if (ways.find(newMask) == ways.end()) {\n        ways[newMask] = {newD, 0};\n        q.push(newMask);\n    }\n    if (ways[newMask].d == newD) {\n        ways[newMask].w = (ways[newMask].w + ways[mask].w * edgeWays % MOD) % MOD;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> n >> k;\n    for (int i = 0; i < n; i++) {\n        int temp; cin >> temp;\n        if (temp == 50) a++;\n        else b++;\n    }\n    fillChoose();\n    int startMask = 1000000 + 100 * a + b;\n    q.push(startMask);\n    ways[startMask] = {0, 1};\n    while (!q.empty()) {\n        int mask = q.front();\n        q.pop();\n        bfs(mask);\n    }\n    if (ways.find(0) != ways.end()) {\n        cout << ways[0].d << \"\\n\" << ways[0].w << \"\\n\";\n    } else {\n        cout << \"-1\\n0\\n\";\n    }\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.6362568140029907, -0.0005673298146575689, -1.7432603272027336e-06, -0.049272894859313965, -2.1008713702030946e-06, -6.39220297671272