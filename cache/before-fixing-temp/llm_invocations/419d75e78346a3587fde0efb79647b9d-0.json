n\ndef solve():\n    sys.setrecursionlimit(10000)\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    t = int(next(it))\n\n    field = [list(next(it).strip()) for _ in range(n)]\n    capsule = [list(next(it).strip()) for _ in range(n)]\n\n    # find position of 'Z'\n    sx, sy = -1, -1\n    for i in range(n):\n        for j in range(n):\n            if field[i][j] == 'Z':\n                sx, sy = i, j\n\n    # flow network\n    total_nodes = n * n * 2 + 2\n    src = n * n * 2\n    sink = src + 1\n    F = Dinic(total_nodes)\n\n    dx = [-1, 1, 0, 0]\n    dy = [0, 0, -1, 1]\n    INF = 10 ** 9\n\n    def In(i, j):\n        return 0 <= i < n and 0 <= j < n\n\n    def isdigit(ch):\n        return '1' <= ch <= '9'\n\n    # Z distance array (global)\n    Z = [[INF] * n for _ in range(n)]\n\n    # BFS from Z (zombie)\n    def bfs(x, y, d, f):\n        # Initialize d to INF\n        for i in range(n):\n            for j in range(n):\n                d[i][j] = INF\n        d[x][y] = 0\n        q = deque()\n        q.append((x, y))\n        if f and isdigit(capsule[x][y]):\n            F.add_edge(x * n + y, x * n + y + n * n, INF)\n        while q:\n            x, y = q.popleft()\n            if d[x][y] == t:\n                break\n            for o in range(4):\n                xx = x + dx[o]\n                yy = y + dy[o]\n                if In(xx, yy) and capsule[xx][yy] != 'Y':\n                    if Z[xx][yy] > d[x][y] + 1 or (Z[xx][yy] == d[x][y] + 1 and isdigit(capsule[xx][yy])):\n                        d[xx][yy] = d[x][y] + 1\n                        if f and isdigit(capsule[xx][yy]):\n                            F.add_edge(x * n + y, xx * n + yy + n * n, INF)\n                        if Z[xx][yy] > d[x][y] + 1 or not f:\n                            q.append((xx, yy))\n\n    # first BFS from Z\n    bfs(sx, sy, Z, False)\n\n    # add edges for field digits and run BFS from each\n    for i in range(n):\n        for j in range(n):\n            if isdigit(field[i][j]):\n                F.add_edge(src, i * n + j, int(field[i][j]))\n                # temporary distance array for this robot\n                S = [[INF] * n for _ in range(n)]\n                bfs(i, j, S, True)\n\n    # add edges from capsule digits to sink\n    for i in range(n):\n        for j in range(n):\n            if isdigit(capsule[i][j]):\n                F.add_edge(i * n + j + n * n, sink, int(capsule[i][j]))\n\n    print(F.max_flow(src, sink))\n\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-1.966933996300213e-05, 0.0, -8.344646857949556e-07, -0.006764607038348913, -0.000934045237954706, -1.1920928244535389e-07, -8.4638240878121e-06, -0.0003195490571670234, -1.1920928244535389e-07, 0.0, -4.768370445162873e-07, -0.038075610995292664, -1.2324912548065186, -0.026430370286107063, 0.0, -3.6954811548639555e-06, -1.0728830375228426e-06, -0.014956246130168438, -1.1920928244535389e-07, 0.0, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841830625315197e-06, -0.20142561197280884, -9.894321920000948e-06, 0.0, 0.0, -2.9682672902708873e-05, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.0006790239713154733, -2.3841855067985307e-07, -4.768370445162873e-07, -4.768370445162873e-07, 0.0, -5.960462772236497e-07, 0.0, -2.3841855067985307e-07, -0.25196805596351624, -1.311301275563892e-06, -7.724463648628443e-05, -1.2397689715726301e-05, -4.768370445162873e-07, 0.0, 0.0, -0.0015501875896006823, -3.576278118089249e-07, 0.0, 0.0, 0.0, -9.536738616588991e-07, -5.960462772236497e-07, -0.005578189622610807, -1.4185804502631072e-05, -0.0010309863137081265, -5.245195097813848e-06, 0.0, -0.31373128294944763, 0.0, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -1.4305104514278355e-06, -2.3841855067985307e-07, -0.0009118927991949022, 0.0, -3.7788631743751466e-05, 0.0, -1.