ef fpow(a, b, mod):\n    c = 1\n    while b:\n        if b & 1:\n            c = c * a % mod\n        a = a * a % mod\n        b >>= 1\n    return c\n\ndef init(n, mod):\n    global fac, ifac, inv\n    fac = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = fac[i - 1] * i % mod\n    ifac = [1] * (n + 1)\n    ifac[n] = fpow(fac[n], mod - 2, mod)\n    for i in range(n - 1, -1, -1):\n        ifac[i] = ifac[i + 1] * (i + 1) % mod\n    inv = [0] * (n + 1)\n    inv[1] = 1\n    for i in range(2, n + 1):\n        inv[i] = (mod - mod // i) * inv[mod % i] % mod\n\ndef fmt(f, n, mod):\n    l = 1\n    while l < n:\n        for i in range(0, n, l << 1):\n            for j in range(l):\n                f[i + j + l] = add_mod(f[i + j + l], f[i + j], mod)\n        l <<= 1\n\ndef ifmt(f, n, mod):\n    l = 1\n    while l < n:\n        for i in range(0, n, l << 1):\n            for j in range(l):\n                f[i + j + l] = sub_mod(f[i + j + l], f[i + j], mod)\n        l <<= 1\n\ndef popcount(x):\n    return bin(x).count(\"1\")\n\ndef solve():\n    n, k, P = get_ints()\n    ans = fpow(k, n, P)\n    if n % 2 == 0:\n        m = n.bit_length()\n        size = 1 << m\n        init(size, P)\n        f = [[0] * size for _ in range(m + 1)]\n        for i in range(size):\n            f[popcount(i)][i] = ifac[i]\n        for i in range(m + 1):\n            fmt(f[i], size, P)\n        for i in range(n + 1):\n            F = [0] * (m + 1)\n            for j in range(m + 1):\n                F[j] = f[j][i]\n            # compute fpow on F\n            t = F[:]\n            F[0] = (1 - F[0]) % P\n            g = [0] * (m + 1)\n            for idx in range(1, m + 1):\n                F[idx] = 0\n                g[idx] = 0\n                for j in range(1, idx):\n                    F[idx] = (F[idx] + F[idx - j] * g[j]) % P\n                    g[idx] = (g[idx] + t[idx - j] * g[j]) % P\n                F[idx] = sub_mod(F[idx], g[idx], P)\n                F[idx] = (t[idx] + F[idx] * inv[idx]) % P * k % P\n                g[idx] = (t[idx] - g[idx] * inv[idx]) % P * idx % P\n            for j in range(m + 1):\n                f[j][i] = F[j]\n        ifmt(f[popcount(n)], size, P)\n        ans = (ans - f[popcount(n)][n] * fac[n]) % P\n        ans = (P + ans) % P\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.0132739e-05, 0.0, -1.1920928e-07, -0.0041323043, -0.03346398, -0.005257471, -1.1380711, -2.009451, -0.25710917, -0.8350968, -0.0029321795, -1.12056105e-05, -0.015047492, -0.00012051333, -0.0026978783, 0.0, -0.04308418, -0.07960822, -0.48202878, -0.9729853, -0.05256838, -1.5616295e-05, -7.903264e-05, -8.344647e-07, -0.00025447944, -0.58109945, -1.072883e-06, -8.344647e-07, -5.960463e-07, -2.0265559e-06, -0.0004440752, -2.3841855e-07, -9.715085e-05, -3.981511e-05, -0.6804154, -4.6449027, -0.9987109, -0.06223313, -0.00010096517, -0.00016854773, -0.029761989, -0.7268205, -0.0003612581, -8.940657e-06, -0.11051619, -0.0087830415, -2.3841855e-07, -2.0265559e-06, -2.3841855e-07, -0.0011974553, -9.5367386e-07, -3.81469e-06, -5.960463e-07, -0.0015046, -1.5497195e-06, -7.486063e-05, -5.912606e-05, -5.960463e-07, -4.196079e-05, -2.3841855e-07, -9.44093e-05, -1.5497195e-06, -5.042426e-05, -1.2278481e-05, -1.1563234e-05, -2.3364748e-05, -0.0034960124, -5.6028207e-06, -3.266281e-05, -4.672895e-05, -8.344647e-07, -4.911302e-05, -5.960463e-07, -0.00034838807, -0.0002054957, -5.960463e-07, -5.7220295e-06, -2.3841855e-07, -0.014919252, -2.3483954e-05, -0.0020906513, -1.0490363e-05, -1.1920928e-07, -3.755022e-05, -2.384183e-06, -6.675698e-06, -0.00013815402, -0.0004070169, -4.9828242e-05, -2.503392e-06, -0.00012325481, -2.145765e-06, -5.864925e-05, -0.0045745485, -0.3010751, -0.00032348168, -0.16170001, -7.6293654e-06, -1.490105e-05, -6.5564896e-06, -0.0036300023, -1.70147, -3.576278e-07, -0.10103016, -1.1920922e-06, -2.7418098e-06, -2.0265559e-06, -0.00015925094, 0.0, -0