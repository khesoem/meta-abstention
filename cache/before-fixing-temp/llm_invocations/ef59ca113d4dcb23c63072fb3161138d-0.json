  long[] fact = new long[l + 1];\n        fact[0] = 1;\n        for (int i = 1; i <= l; i++) {\n            fact[i] = (i * fact[i - 1]) % mod;\n        }\n\n        long ans;\n        if (n <= 3) {\n            ans = 0;\n        } else {\n            int[] dp = new int[2000];\n            dp[0] = 1;\n            dp[1] = 2;\n            dp[2] = 2;\n            dp[3] = 1;\n\n            tree = make_tree(2005);\n            offset = tree.length / 2;\n            for (int i = 0; i < 4; i++) {\n                update(i, dp[i]);\n            }\n\n            int m = 3;\n            ans = 0;\n            for (int i = 0; i < n - 3; i++) {\n                int[] dp0 = dp.clone();\n                long ans0 = 0;\n                for (int j = 0; j < i + 3; j++) {\n                    for (int k = 1; k <= m + 1; k++) {\n                        ans0 = (ans0 + get_sum(j + k + 1, 2004) * (long) dp0[k - 1]) % mod;\n                        dp[j + k] = (dp[j + k] + dp0[k - 1]) % mod;\n                        update(j + k, dp[j + k]);\n                    }\n                }\n                m += i + 3;\n                ans = (ans + f(i + 4, n) * ans0) % mod;\n            }\n        }\n        System.out.println(ans);\n    }\n\n    static int[] make_tree(int n) {\n        int size = 2;\n        while (size < 2 * n) {\n            size *= 2;\n        }\n        return new int[size];\n    }\n\n    static void update(int i, int x) {\n        i += offset;\n        tree[i] = x;\n        i /= 2;\n        while (i > 0) {\n            tree[i] = (tree[2 * i] + tree[2 * i + 1]) % mod;\n            i /= 2;\n        }\n    }\n\n    static int get_sum(int s, int t) {\n        s += offset;\n        t += offset;\n        int ans = 0;\n        while (s <= t) {\n            if (s % 2 == 0) {\n                s /= 2;\n            } else {\n                ans = (ans + tree[s]) % mod;\n                s = (s + 1) / 2;\n            }\n            if (t % 2 == 1) {\n                t /= 2;\n            } else {\n                ans = (ans + tree[t]) % mod;\n                t = (t - 1) / 2;\n            }\n        }\n        return ans;\n    }\n\n    static ArrayList<Integer> prime_factorize(int n) {\n        ArrayList<Integer> ans = new ArrayList<>();\n        for (int i = 2; i * i <= n; i++) {\n            while (n % i == 0) {\n                ans.add(i);\n                n /= i;\n            }\n            if (n == 1) break;\n        }\n        if (n != 1) ans.add(n);\n        return ans;\n    }\n\n    static long euler_func(int n) {\n        HashSet<Integer> p = new HashSet<>(prime_factorize(n));\n        long x = n;\n        for (int i : p) {\n            x = x * (i - 1) / i;\n        }\n        return x;\n    }\n\n    static long f(int a, int b) {\n        long ans = 1;\n        for (int i = a + 1; i <= b; i++) {\n            ans = (ans * i) % mod;\n        }\n        return ans;\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.50339189733495e-06, 0.0, -1.1920928244535389e-07, -0.0001656871900195256, -1.7523612768854946e-05, -2.3841855067985307e-07, -0.0019286142196506262, -0.16030128300189972, -1.6689286894688848e-06, -1.1920928244535389e-07, -1.6927575416048057e-05, -0.0007489498239010572, -3.755022044060752e-05, -1.1920928244535389e-07, -0.00042489083716645837, -0.001191859133541584, -0.0001833270798670128, -0.009354923851788044, -0.0835539773106575, -0.006311721168458462, -0.00199690624140203, -2.622600959512056e-06, -1.1205610462639015e-05, -7.664863369427621e-05, -0.0025084717199206352, -0.0002101439022226259, -0.024618735536932945, -0.02975435182452202, -0.0004615910293068737, -0.0006254147156141698, -2.134065628051758, -0.8613694310188293, -1.6689286894688848e-06, -0.2708348333835602, 0.0, -0.011049157939851284, -0.07900123298168182, -5.960462772236497e-07, -7.510157047363464e-06, -2.145764938177308e-06, -2.3841855067985307e-07, -0.00030417583184316754, -0.38687628507614136, -3.933898824470816e-06, -2.38418550679