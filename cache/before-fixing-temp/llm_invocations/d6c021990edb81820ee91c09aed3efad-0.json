4-flash"}, "response": {"samples": [{"content": "#include <cstdio>\n#include <cmath>\n#include <vector>\n#include <algorithm>\n\nusing namespace std;\n\nconst int INF = 10000000;\n\nstruct SparseTable {\n    vector<int> a;\n    vector<vector<int>> st;\n\n    SparseTable(const vector<int>& arr) {\n        int n = arr.size();\n        a = arr;\n        int k = (int)floor(log2(n)) + 1;\n        st.assign(n, vector<int>(k));\n        for (int i = 0; i < n; i++) st[i][0] = i;\n        for (int j = 1; (1 << j) <= n; j++) {\n            for (int i = 0; i + (1 << j) - 1 < n; i++) {\n                int left = st[i][j-1];\n                int right = st[i+(1<<(j-1))][j-1];\n                st[i][j] = (a[left] < a[right]) ? left : right;\n            }\n        }\n    }\n\n    int query(int i, int j) {\n        if (i >= (int)a.size()) return INF;\n        j = min(j, (int)a.size() - 1);\n        int len = j - i + 1;\n        int k = (int)floor(log2(len));\n        int left = st[i][k];\n        int right = st[j - (1 << k) + 1][k];\n        return min(a[left], a[right]);\n    }\n};\n\nint main() {\n    int n, k;\n    scanf(\"%d%d\", &n, &k);\n    n *= 2;\n\n    vector<int> l(k + 1), r(k + 1);\n    for (int i = 0; i < k; i++) {\n        scanf(\"%d%d\", &l[i], &r[i]);\n    }\n    l[k] = n;\n\n    SparseTable* seg[2][2] = {{nullptr, nullptr}, {nullptr, nullptr}};\n\n    vector<int> init_a(n/2 + 2, INF);\n    init_a[n/2] = 0;\n    for (int j = 0; j < 2; j++) {\n        seg[1][j] = new SparseTable(init_a);\n    }\n\n    int p = 0;\n    for (int i = k - 1; i >= 0; i--) {\n        for (int j = 0; j < 2; j++) {\n            int size = n/2 + 2;\n            vector<int> a(size, INF);\n            int lim = l[i];\n            for (int c = 0; c <= lim && c < size; c++) {\n                int best = seg[1-p][j]->query(c + l[i+1] - l[i], c + l[i+1] - l[i]);\n                best = min(best, 1 + seg[1-p][1-j]->query(l[i+1] - (c + r[i] - l[i]), l[i+1] - c));\n                if (r[i] > l[i]) {\n                    best = min(best, 2 + seg[1-p][j]->query(c + l[i+1] - r[i], c + l[i+1] - l[i] - 1));\n                }\n                a[c] = best;\n            }\n            if (seg[p][j] != nullptr) delete seg[p][j];\n            seg[p][j] = new SparseTable(a);\n        }\n        p ^= 1;\n    }\n    p ^= 1;\n\n    int ans = min(seg[p][0]->query(l[0], l[0]), seg[p][1]->query(l[0], l[0]));\n    if (ans > 2 * k) {\n        printf(\"Hungry\\n\");\n    } else {\n        printf(\"Full\\n%d\\n\", ans);\n    }\n\n    for (int i = 0; i < 2; i++) {\n        for (int j = 0; j < 2; j++) {\n            if (seg[i][j] != nullptr) delete seg[i][j];\n        }\n    }\n\n    return 0;\n}\n<confidence>0.95</confidence>", "token_logprobs": [-2.889153003692627, -3.290122185717337e-05, -0.0003693613689392805, -3.933898824470816e-06, -0.0003357561945449561, -1.1920928244535389e-07, 0.0, -0.0017177602276206017, -7.033323527139146e-06, 0.0, 0.0, -0.0009708458674140275, -1.6689286894688848e-06, -2.3841855067985307e-07, -2.3841855067985307e-07, -1.8000440832111053e-05, -0.9742417335510254, -0.02990858629345894, -0.0007099968497641385, -1.1920928244535389e-07, -0.0003418338019400835, -0.0004345426568761468, -1.0847986231965479e-05, -0.00020418466010596603, -2.264974000354414e-06, -0.00034564718953333795, -0.0003367095487192273, -1.1920928244535389e-07, -2.264974000354414e-06, -0.0025164387188851833, -0.0067762103863060474, -1.1920928244535389e-07, 0.0, 0.0, -3.2305197237292305e-05, -3.862306402879767e-05, -1.6689286894688848e-06, -3.576278118089249e-07, 0.0, -0.00016091958968900144, -6.115249561844394e-05, 0.0, -2.622600959512056e-06, -1.3828182090946939e-05, -1.1920928244535389e-07, -0.03804164379835129, -1.4305104514278355e-06, -0.39440977573394775, -3.576278118089249e-07, -0.0001387499796692282, 0.0, 0.0, -0.00011002412065863609, -2.3841855067985307e-07, 0.0, -0.00020358874462544918, -1.4185804502631072e-05, -5.8412379075889476e-06, -0.0019361099693924189, -4.410734163684538e-06, 