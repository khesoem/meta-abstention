 {\n            int cm = family_mask[k][i];\n            for (int mask=0; mask<(1<<n); ++mask) {\n                ll ans = 0;\n                if ((mask & cm) == mask) continue;\n                for (int x=0; x<n; ++x) {\n                    if (cm & (1<<x)) continue;\n                    if ((mask & (1<<x))==0) continue;\n                    int newmask = cm | (1<<x);\n                    ans |= (1ll << family_id[newmask]);\n                }\n                T[k][i][mask] = ans;\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin>>n;\n    A.resize(n);\n    for (int i=0; i<n; ++i) {\n        A[i].resize(n);\n        for (int j=0; j<n; ++j) {\n            cin>>A[i][j];\n            A[i][j] = mult(A[i][j],modinv(100));\n        }\n    }\n    calc();\n    DP.resize(n+1);\n    DP[0][1] = 1;\n    for (int k=0; k<n; ++k) {\n        for (int edges=0; edges<(1<<n); ++edges) {\n            ll prob = 1;\n            for (int i=0; i<n; ++i) {\n                if (edges & (1<<i)) prob = mult(prob, A[k][i]);\n                else prob = mult(prob, sub(1,A[k][i]));\n            }\n            for (auto S : DP[k]) {\n                ll mask = S.first;\n                ll newmask = 0;\n                ll p = mult(prob, S.second);\n                for (int i=0; i<(int)family_mask[k].size(); ++i) {\n                    if (mask & (1<<i)) {\n                        newmask |= T[k][i][edges];\n                    }\n                }\n                if (newmask != 0) DP[k+1][newmask] = add(DP[k+1][newmask], p);\n            }\n        }\n    }\n    cout << DP[n][1] << endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nMOD = 1000000007\n\ndef add(x, y):\n    return (x + y) % MOD\n\ndef sub(x, y):\n    x -= y\n    return (x + MOD) % MOD if x < 0 else x\n\ndef mult(x, y):\n    return (x * y