     }\n        return new Step(res, i);\n    }\n    \n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long n = scanner.nextLong();\n        scanner.close();\n        \n        PriorityQueue<Step> pq = new PriorityQueue<>();\n        pq.offer(new Step(n, 0));\n        \n        while (pq.peek().val != 0) {\n            Step current = pq.poll();\n            long val = current.val;\n            int cost = current.cost;\n            \n            if (wasVisited(val))\n                continue;\n            visited.add(val);\n            \n            Step[] nextSteps = {lower(val), upper(val), uupper(val)};\n            for (Step next : nextSteps) {\n                next.cost += cost;\n                next.val = Math.abs(val - next.val);\n                pq.offer(next);\n            }\n        }\n        \n        System.out.println(pq.peek().cost);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.3378547e-06, 0.0, 0.0, -0.00016640233, -4.2795218e-05, -7.152555e-07, -0.02976384, -0.0038182465, -0.038101777, -1.1920928e-07, -0.0074035563, -0.062454563, -0.06210699, -0.1430221, -0.018730553, -1.1920922e-06, -0.029753657, 0.0, -1.1920928e-07, -4.7683704e-07, 0.0, -1.2516897e-05, -4.7683704e-07, -2.6940936e-05, -0.0011701887, -5.1735493e-05, 0.0, -5.1259863e-06, 0.0, -0.47409806, -0.029786866, -1.1920928e-07, -0.008772525, -2.9325056e-05, -0.03804566, -2.4556812e-05, 0.0, -1.1920928e-07, -1.1920922e-06, -7.152555e-07, -2.3841855e-07, 0.0, 0.0, 0.0, -4.7683704e-07, -1.4305105e-06, -2.3841855e-07, 0.0, -2.3841855e-07, 0.0, 0.0, 0.0, -3.576278e-07, -3.576278e-07, -5.8291644e-05, -4.7683704e-07, -9.5367386e-07, -0.0015280487, 0.0, -2.8610189e-06, -8.344647e-07, 0.0, -0.0015023384, -2.3841855e-07, 0.0, -1.1920928e-07, 0.0, -0.01942095, 0.0, -1.6689287e-06, -9.1790735e-06, -0.038298097, -0.1280657, -2.1576649e-05, -0.014287909, -2.3841855e-07, 0.0, -7.152555e-07, -5.0067774e-06, 0.0,