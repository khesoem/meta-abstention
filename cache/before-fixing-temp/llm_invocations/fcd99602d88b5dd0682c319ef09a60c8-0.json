nfor _ in range(M):\n    X,Y=map(int, input().split())\n    H[X].append(Y)\n    H[Y].append(X)\n\nmaxn=6000\ninf=10**9\ninff=10**18\n\nclass Edge:\n    def __init__(self, to, cap, cost, rev):\n        self.to=to\n        self.cap=cap\n        self.cost=cost\n        self.rev=rev\n\nG=[[] for _ in range(5104)]\n\ndef add_edge(from_,to,cap,cost):\n    G[from_].append(Edge(to, cap, cost, len(G[to])))\n    G[to].append(Edge(from_, 0, -cost, len(G[from_])-1))\n\ndef init(_n, _s, _t):\n    for i in range(_n+1):\n        G[i].clear()\n\ns=0\nt=5101\ninit(5103,s,t)\n\nfor i in range(2, N+1):\n    add_edge(0, i, A[i], 0)\nfor i in range(101):\n    for l in range(1, N+1):\n        add_edge(50*i + l, 50*(i+1)+l, K, 0)\n        for j in H[l]:\n            for k in range(1, K+1):\n                add_edge(50*i + l, 50*(i+1)+j, 1, D*(2*k -1))\nfor i in range(1,102):\n    add_edge(50*i + 1, t, K, C*i)\n\ndef min_cost_flow(f):\n    res=0\n    dist=[inff]*(5104)\n    prevv=[0]*5104\n    preve=[0]*5104\n    inq=[0]*5104\n    while f>0:\n        for i in range(5104):\n            dist[i]=inff\n        dist[s]=0\n        inq=[0]*5104\n        from collections import deque\n        q=deque()\n        q.append(s)\n        inq[s]=1\n        while q:\n            now=q.popleft()\n            inq[now]=0\n            for i, e in enumerate(G[now]):\n                if e.cap>0 and dist[now]+e.cost<dist[e.to]:\n                    dist[e.to]=dist[now]+e.cost\n                    prevv[e.to]=now\n                    preve[e.to]=i\n                    if not inq[e.to]:\n                        inq[e.to]=1\n                        q.append(e.to)\n        if dist[t]==inff:\n            return -1\n        d=f\n        v=t\n        while v!=s:\n            d=min(d, G[prevv[v]][preve[v]].cap)\n            v=prevv[v]\n        f-=d\n        res+=d*dist[t]\n        v=t\n        while v!=s:\n            e=G[prevv[v]][preve[v]]\n            e.cap-=d\n            G[v][e.rev].cap+=d\n            v=prevv[v]\n