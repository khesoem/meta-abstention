          u = coef[j]\n                coef[j] = (u + t) % MOD\n                coef[j + length] = (u - t) % MOD\n                curRoot = (roots[s] * curRoot) % MOD\n    return coef\n\ndef main():\n    import sys\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    n = data[0] // 2\n    m = data[1]\n    nums = data[2:]\n    max_num = max(nums)\n    min_size = n * max_num + 1\n\n    size = 1\n    k = 0\n    while size < min_size:\n        size <<= 1\n        k += 1\n\n    a = [0] * size\n    for num in nums:\n        a[num] = 1\n\n    a = ntt(a, k, False)\n    for i in range(len(a)):\n        a[i] = mod_pow(a[i], n)\n    a = ntt(a, k, True)\n\n    ans = 0\n    for value in a:\n        ans = (ans + value * value) % MOD\n\n    multiplier = mod_inv(size)\n    result = (((ans * multiplier) % MOD) * multiplier) % MOD\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.162751704454422, -0.0012329687597230077, -3.128163257315464e-07, -3.726595241460018e-05, -0.47652316093444824, -2.248469718324486e-05, -6.704273118884885e-07, 0.0, -7.896309739408025e-07, -8.180258191714529e-06, -0.009136121720075607, -0.0002858881198335439, -0.10160373896360397, -7.465036105713807e-06, -1.1472419600977446e-06, 0.0, -0.0003552463313098997, -5.512236498361744e-07, -4.008129963040119e-06, -4.320199877838604e-07, -6.704273118884885e-07, 0.0, 0.0, -0.0069865030236542225, -0.0005297990282997489, -3.023293538717553e-05, -0.2519405782222748, -4.723352049040841e-06, -0.0011709370883181691, -1.7432603272027336e-06, -2.7014437364414334e-05, -1.0280383548888494e-06, -0.006976910401135683, -0.0023033395409584045, -0.1527579128742218, -0.00020628207130357623, -0.07788203656673431, -1.9361264946837764e-07, -3.128163257315464e-07, 0.0, -1.8624639324116288e-06, -0.0025085974484682083, -0.06290215253829956, -4.4849443838757e-06, -0.062189731746912, -0.00038038729690015316, -4.320199877838604e-