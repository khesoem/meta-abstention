ther, mint):\n            return self * other.inv()\n        else:\n            return self * mint(other).inv()\n\n    def __pow__(self, p):\n        return mint(pow(self.v, p, MOD))\n\n    def inv(self):\n        return mint(pow(self.v, MOD-2, MOD))\n\n    def __neg__(self):\n        return mint(-self.v)\n\n    def __iadd__(self, other):\n        if isinstance(other, mint):\n            self.v = (self.v + other.v) % MOD\n        else:\n            self.v = (self.v + other) % MOD\n        return self\n\n    def __isub__(self, other):\n        if isinstance(other, mint):\n            self.v = (self.v - other.v) % MOD\n        else:\n            self.v = (self.v - other) % MOD\n        return self\n\n    def __imul__(self, other):\n        if isinstance(other, mint):\n            self.v = (self.v * other.v) % MOD\n        else:\n            self.v = (self.v * other) % MOD\n        return self\n\n    def __itruediv__(self, other):\n        if isinstance(other, mint):\n            self.v = (self.v * other.inv()) % MOD\n        else:\n            self.v = (self.v * mint(other).inv()) % MOD\n        return self\n\n    def __repr__(self):\n        return str(self.v)\n\n    def __int__(self):\n        return self.v\n\n    def __bool__(self):\n        return self.v != 0\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    N = next(it)\n    inv100 = mint(pow(100, MOD-2, MOD))\n    p = [[mint(0) for _ in range(N)] for _ in range(N)]\n    for i in range(N):\n        for j in range(N):\n            v = next(it)\n            p[i][j] = mint(v) * inv100\n\n    cur = {1: mint(1)}  # start with bitset having bit 0 set\n    for i in range(N):\n        nxt = {}\n        for state, val in cur.items():\n            ones = []\n            for x in range(1 << N):\n                if (state >> x) & 1:\n                    ones.append(x)\n            for e in range(1 << N):\n                pr = mint(1)\n             