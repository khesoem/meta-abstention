pend(cap)\n        self.cost.append(cost)\n        self.rev.append(0)  # placeholder\n        # backward edge\n        rev = len(self.to)\n        self.adj[v].append(rev)\n        self.to.append(u)\n        self.cap.append(0)\n        self.cost.append(-cost)\n        self.rev.append(fwd)\n        # update forward reverse\n        self.rev[fwd] = rev\n\n    def spfa(self, s, t):\n        N = self.N\n        INF = 10**18\n        pi = [INF] * N\n        dd = [0] * N\n        bb = [-1] * N\n        in_q = [False] * N\n        q = deque()\n        pi[s] = 0\n        dd[s] = 0\n        q.append(s)\n        in_q[s] = True\n        while q:\n            u = q.popleft()\n            in_q[u] = False\n            d = dd[u] + 1\n            for e in self.adj[u]:\n                if self.cap[e] > 0:\n                    v = self.to[e]\n                    p = pi[u] + self.cost[e]\n                    if pi[v] > p or (pi[v] == p and dd[v] > d):\n                        pi[v] = p\n                        dd[v] = d\n                        bb[v] = e\n                        if not in_q[v]:\n                            q.append(v)\n                            in_q[v] = True\n        self.pi = pi\n        self.dd = dd\n        self.bb = bb\n        return pi[t] != INF\n\n    def edmonds_karp(self, s, t):\n        total_cost = 0\n        while self.spfa(s, t):\n            v = t\n            path_cost = 0\n            while v != s:\n                e = self.bb[v]\n                path_cost += self.cost[e]\n                self.cap[e] -= 1\n                self.cap[self.rev[e]] += 1\n                v = self.to[self.rev[e]]\n            total_cost += path_cost\n        return total_cost\n\ndef solve():\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    ii = [int(next(it)) - 1 for _ in range(k)]\n    aa = [[] for _ in range(n)]\n    for _ in range(m):\n 