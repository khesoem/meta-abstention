ut[v] = ct\n\ndef is_ancestor(u, v):\n    return tin[u] <= tin[v] and tout[u] >= tout[v]\n\ndef lca(u, v):\n    if is_ancestor(u, v):\n        return u\n    if is_ancestor(v, u):\n        return v\n    for i in range(log2(len(adj_list)), -1, -1):\n        if not is_ancestor(BL[u][i], v):\n            u = BL[u][i]\n    return BL[u][0]\n\ndef log2(n):\n    return int(math.ceil(math.log(n) / math.log(2)))\n\nclass FastScanner:\n    def __init__(self, stream):\n        self.stream = stream\n        self.buffer = bytearray(1 << 17)\n        self.pointer = 0\n        self.buffer_len = 0\n\n    def next_byte(self):\n        if self.pointer == self.buffer_len:\n            self.buffer_len = self.stream.readinto(self.buffer)\n            self.pointer = 0\n            if self.buffer_len == 0:\n                raise EOFError\n        self.pointer += 1\n        return self.buffer[self.pointer - 1]\n\n    def next_int(self):\n        ret = 0\n        b = self.next_byte()\n        while b <= 32:\n            b = self.next_byte()\n        negative = False\n        if b == 45:  # '-'\n            negative = True\n            b = self.next_byte()\n        while 48 <= b <= 57:\n            ret = 10 * ret + (b - 48)\n            b = self.next_byte()\n        return -ret if negative else ret\n\n    def next_long(self):\n        return self.next_int()  # Python int is arbitrary precision\n\n    def next_string(self):\n        ret = []\n        b = self.next_byte()\n        while b <= 32:\n            b = self.next_byte()\n        while b > 32:\n            ret.append(chr(b))\n            b = self.next_byte()\n        return ''.join(ret)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.6689287e-06, 0.0, -2.3841855e-07, -0.00026806575, -0.0013898485, -0.0025396259, -0.2540281, -0.0021508434, -0.00052354933, -0.008828298, -0.16470192, -2.6106494e-05, -0.008637922, -0.010863331, -0.030221267, -4.887569e-06, -0.0002638