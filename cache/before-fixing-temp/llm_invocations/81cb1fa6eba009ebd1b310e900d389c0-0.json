alse);\n    cin.tie(nullptr);\n    int n;\n    long long mod;\n    cin >> n >> mod;\n\n    long long m = n * (n - 1) / 2;\n\n    vector<vector<long long>> dp(n + 1, vector<long long>(n * (n - 1) + 1, 0));\n    vector<vector<long long>> dp1(n + 1, vector<long long>(n * (n - 1) + 1, 0));\n\n    dp[1][m] = 1;\n\n    for (int i = 2; i <= n; ++i) {\n        int offset_low = - (i - 1) * (i - 2) / 2;\n        int offset_high = (i - 1) * (i - 2) / 2;\n        int total_range = offset_high - offset_low + 1;\n\n        for (long long x = m + offset_low; x <= m + offset_high; ++x) {\n            for (int d = -i + 1; d < i; ++d) {\n                long long x_index = x + d;\n                if (x_index >= 0 && x_index <= (long long)dp[i].size() - 1) {\n                    dp[i][x_index] = (dp[i][x_index] + dp[i - 1][x] * (i - abs(d))) % mod;\n                }\n            }\n        }\n\n        for (long long x = m + offset_low; x <= m + offset_high; ++x) {\n            dp1[i][x] = (dp1[i - 1][x] * i) % mod;\n        }\n\n        for (long long x = m + offset_low; x <= m + offset_high; ++x) {\n            for (int d = 1; d < i; ++d) {\n                long long x_minus_d = x - d;\n                if (x_minus_d >= 0 && x_minus_d <= (long long)dp1[i].size() - 1) {\n                    dp1[i][x_minus_d] = (dp1[i][x_minus_d] + dp[i - 1][x] * (i - d)) % mod;\n                }\n            }\n        }\n    }\n\n    long long answer = 0;\n    for (long long x = m + 1; x < (long long)dp1[n].size(); ++x) {\n        answer = (answer + dp1[n][x]) % mod;\n    }\n    cout << answer << \"\\n\";\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-1.0601284503936768, -0.0006572735728695989, -1.0280383548888494e-06, -0.0003513125702738762, -1.0280383548888494e-06, -9.729906196298543e-06, -0.2520807683467865, -2.2200749754119897e-06, -6.153795766294934e-06, -5.512236498361744e-07, -0.0009617198375053704, -4.723352049040841e-06, -9.088346359931165e-