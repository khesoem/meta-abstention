{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\nusing namespace std;\n\nconst int maxn = 6010, INF = 0x3f3f3f3f;\nint n, m, k, c, d, cnt, ans, a[maxn], x[maxn], y[maxn];\nint head[maxn], pre[maxn], dist[maxn], inq[maxn];\nqueue<int> q;\nstruct edge { int to, cap, cost, nxt; } e[2000010];\nint id(int t, int v) { return t * n + v; }\n\nvoid add(int from, int to, int cap, int cost) {\n    e[cnt] = (edge){to, cap, cost, head[from]}, head[from] = cnt++;\n    e[cnt] = (edge){from, 0, -cost, head[to]}, head[to] = cnt++;\n}\n\nbool spfa(int s, int t) {\n    memset(dist, 0x3f, sizeof(dist));\n    q.push(s), dist[s] = 0;\n    while (!q.empty()) {\n        int v = q.front(); q.pop(), inq[v] = 0;\n        for (int i = head[v], u; ~i; i = e[i].nxt) {\n            if (e[i].cap && dist[u = e[i].to] > dist[v] + e[i].cost) {\n                dist[u] = dist[v] + e[i].cost, pre[u] = i;\n                if (!inq[u]) q.push(u), inq[u] = 1;\n            }\n        }\n    }\n    return dist[t] < 1e9;\n}\n\nvoid upd(int s, int t) {\n    for (int i = t; i ^ s; i = e[pre[i] ^ 1].to) {\n        e[pre[i]].cap--, e[pre[i] ^ 1].cap++;\n    }\n    ans += dist[t];\n}\n\nint main() {\n    memset(head, -1, sizeof(head));\n    scanf(\"%d %d %d %d %d\", &n, &m, &k, &c, &d);\n    int S = 0, T = 6000;\n    for (int i = 1; i <= k; i++) {\n        scanf(\"%d\", &a[i]), add(S, id(0, a[i]), 1, 0);\n    }\n    for (int i = 1; i <= m; i++) {\n        scanf(\"%d %d\", &x[i], &y[i]);\n    }\n    for (int t = 0; t <= 100; t++) {\n        for (int i = 2; i <= n; i++) {\n            add(id(t, i), id(t + 1, i), k, c);\n        }\n        add(id(t, 1), T, k, 0);\n        for (int i = 1; i <= m; i++) {\n            for (int j = 1; j <= min(k, 25); j++) {\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d);\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d);\n            }\n        }\n    }\n    while (spfa(S, T)) upd(S, T);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nmaxn = 6010\nINF = 0x3f3f3f3f\n\nn = m = k = c = d = cnt = ans = 0\na = [0] * maxn\nx = [0] * maxn\ny = [0] * maxn\nhead = [-1] * maxn\npre = [0] * maxn\ndist = [0] * maxn\ninq = [0] * maxn\ne = [{'to': 0, 'cap': 0, 'cost': 0, 'nxt': 0} for _ in range(2000010)]\n\ndef id(t, v):\n    return t * n + v\n\ndef add(from_, to, cap, cost):\n    global cnt\n    e[cnt] = {'to': to, 'cap': cap, 'cost': cost, 'nxt': head[from_]}\n    head[from_] = cnt\n    cnt += 1\n    e[cnt] = {'to': from_, 'cap': 0, 'cost': -cost, 'nxt': head[to]}\n    head[to] = cnt\n    cnt += 1\n\ndef spfa(s, t):\n    global dist\n    dist = [INF] * maxn\n    q = deque()\n    q.append(s)\n    dist[s] = 0\n    inq[s] = 1\n    while q:\n        v = q.popleft()\n        inq[v] = 0\n        i = head[v]\n        while i != -1:\n            u = e[i]['to']\n            if e[i]['cap'] and dist[u] > dist[v] + e[i]['cost']:\n                dist[u] = dist[v] + e[i]['cost']\n                pre[u] = i\n                if not inq[u]:\n                    q.append(u)\n                    inq[u] = 1\n            i = e[i]['nxt']\n    return dist[t] < 1e9\n\ndef upd(s, t):\n    global ans\n    i = t\n    while i != s:\n        idx = pre[i]\n        e[idx]['cap'] -= 1\n        e[idx ^ 1]['cap'] += 1\n        i = e[idx ^ 1]['to']\n    ans += dist[t]\n\ndef main():\n    global n, m, k, c, d, ans, cnt, a, x, y, head\n    input_data = sys.stdin.read().split()\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    S = 0\n    T = 6000\n    head = [-1] * maxn\n    a = [0] * maxn\n    x = [0] * maxn\n    y = [0] * maxn\n    cnt = 0\n    for i in range(1, k + 1):\n        a[i] = int(next(it))\n        add(S, id(0, a[i]), 1, 0)\n    for i in range(1, m + 1):\n        x[i] = int(next(it))\n        y[i] = int(next(it))\n    for t in range(0, 101):\n        for i in range(2, n + 1):\n            add(id(t, i), id(t + 1, i), k, c)\n        add(id(t, 1), T, k, 0)\n        for i in range(1, m + 1):\n            max_j = min(k, 25)\n            for j in range(1, max_j + 1):\n                add(id(t, x[i]), id(t + 1, y[i]), 1, c + (2 * j - 1) * d)\n                add(id(t, y[i]), id(t + 1, x[i]), 1, c + (2 * j - 1) * d)\n    while spfa(S, T):\n        upd(S, T)\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.5404533e-05, 0.0, -1.1920928e-07, -0.00409372, -1.1409602, -0.008600339, -0.0014331795, -0.0015225734, -0.0025994342, -1.1920928e-07, -0.00018571083, -0.015395491, -1.3375998, -0.0003566106, -0.0009329734, -7.152555e-07, -0.00015031162, -4.76836e-06, -2.9563467e-05, -0.00077182066, -4.5299425e-06, -0.0033041427, -0.011085235, -1.1920928e-07, -2.503392e-06, -0.00033718624, -5.960463e-07, -2.3841855e-07, -2.3841855e-07, 0.0, -6.198864e-06, -2.3841855e-07