Int(inputLine[1]);\n\n        int[] mem = new int[n + 1];\n        mem[0] = 0;\n        mem[1] = 1;\n        int su = 1;\n\n        for (int i = 2; i <= n; i++) {\n            int sq = (int) Math.sqrt(i) + 1;\n            int cur = su;\n\n            for (int f = 2; f < sq; f++) {\n                int index = i / f;\n                if (index < mem.length)\n                    cur = add(cur, mem[index], mod);\n            }\n\n            int be = i;\n            int limit = i / sq;\n            for (int j = 1; j <= limit; j++) {\n                int nxt = i / (j + 1);\n                if (j < mem.length) {\n                    int diff = be - nxt;\n                    cur = add(cur, mult(diff, mem[j], mod), mod);\n                }\n                be = nxt;\n            }\n\n            su = add(su, cur, mod);\n            if (i < mem.length) {\n                mem[i] = cur;\n            }\n        }\n        System.out.println(mem[n]);\n    }\n\n    private static int add(int a, int b, int mod) {\n        return ((a + b) % mod + mod) % mod; // ensures non-negative modulo\n    }\n\n    private static int mult(int a, int b, int mod) {\n        return (int) (((long) a * b) % mod);\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0009507640497758985, -5.512236498361744e-07, -0.00011021859245374799, -0.5105134844779968, -0.0004497381451074034, -0.007633008528500795, -0.8033517003059387, -0.3133307993412018, -0.00022690063633490354, -5.512236498361744e-07, -0.004118649754673243, -0.004100723657757044, -0.0005394508480094373, -0.0025980148930102587, 0.0, -0.0006700247176922858, 0.0, -1.1041145626222715e-05, -2.935296834039036e-06, -4.320199877838604e-07, -3.380904672667384e-05, -0.31335389614105225, -0.0019392271060496569, -0.00018649426056072116, -4.320199877838604e-07, -0.008100077509880066, -1.9361264946837764e-07, -0.0012542768381536007, -7.44574936106801e-05, -6.704273118884885e-07, -3.128163257315464e-07, 0.0, -7.345832273131