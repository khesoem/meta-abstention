{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++17 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++17 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\n#define Fopen freopen(\"_in.txt\",\"r\",stdin); freopen(\"_out.txt\",\"w\",stdout);\n#define LL long long\n#define ULL unsigned LL\n#define fi first\n#define se second\n#define pb push_back\n#define lson l,m,rt<<1\n#define rson m+1,r,rt<<1|1\n#define lch(x) tr[x].son[0]\n#define rch(x) tr[x].son[1]\n#define max3(a,b,c) max(a,max(b,c))\n#define min3(a,b,c) min(a,min(b,c))\ntypedef pair<int,int> pll;\nconst int inf = 0x3f3f3f3f;\nconst int _inf = 0xc0c0c0c0;\nconst LL INF = 0x3f3f3f3f3f3f3f3f;\nconst LL _INF = 0xc0c0c0c0c0c0c0c0;\nconst LL mod =  (int)1e9+7;\nconst int Z = 100;\nconst int N = Z * Z;\nconst int M = Z * Z * Z * 3;\nint px[N], py[N];\nint head[N], to[M], ct[M], w[M], nt[M];\nint d[N], vis[N];\nint pre[N], id[N];\nint s, t, tot;\n \nvoid add(int u, int v, int flow, int cost){\n    to[tot] = v; ct[tot] = cost;\n    w[tot] = flow; nt[tot] = head[u]; head[u] = tot++;\n \n    to[tot] = u; ct[tot] = -cost;\n    w[tot] = 0; nt[tot] = head[v]; head[v] = tot++;\n}\nvoid init(){\n    memset(head, -1, sizeof(head));\n    tot = 0;\n}\nint spfa(int s, int t){\n    queue<int> q;\n    memset(d, inf, sizeof(d));\n    memset(vis, 0, sizeof(vis));\n    memset(pre, -1, sizeof(pre));\n    d[s] = 0;\n    q.push(s);\n    while(!q.empty()){\n        int u = q.front(); q.pop();\n        vis[u] = 0;\n//        cout << u << \" \" << d[u] << endl;\n        for(int i = head[u]; ~i; i = nt[i]){\n            if(w[i] > 0 && d[to[i]] > d[u] + ct[i]){\n                d[to[i]] = d[u] + ct[i];\n                pre[to[i]] = u;\n                id[to[i]] = i;\n//                if(to[i] == 201) cout << \"Updata \" << u << \" \" << to[i] <<\" \" << d[to[i]] <<endl;\n                if(!vis[to[i]]){\n                    vis[to[i]] = 1;\n                    q.push(to[i]);\n                }\n            }\n        }\n \n    }\n//    cout << d[t] << \"? \"<< endl;\n    return d[t] < inf;\n}\nint MaxFlow(int s, int t){\n    int Mi = inf;\n    int sum = 0;\n    int tt = 0;\n//    cout << s << \" ss \" << t  << endl;\n    while(spfa(s, t)){\n        Mi = inf;\n        for(int i = t; i != s; i = pre[i])\n            Mi = min(Mi, w[id[i]]);\n        for(int i = t; i != s; i = pre[i]){\n            w[id[i]] -= Mi;\n            w[id[i]^1] += Mi;\n        }\n        tt += Mi;\n        sum += d[t] * Mi;\n//        cout << d[t] << endl;\n//        cout << \"asd\" << endl;\n    }\n    return sum;\n}\nint main(){\n    init();\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    int s = 0, t = n * 100 + 1;\n    for(int i = 1; i <= 100; ++i)\n        add(i, t, 100, 0);\n    for(int i = 1, v; i <= k; ++i){\n        scanf(\"%d\" , &v);\n        add(s, (v-1)*100+1, 1, 0);\n    }\n    for(int i = 1; i <= n; ++i){\n        for(int j = 1; j < 100; ++j){\n            add((i-1)*100 + j, (i-1)*100 + j + 1, 100, c);\n        }\n    }\n    for(int i = 1, u, v; i <= m; ++i){\n        scanf(\"%d%d\", &u, &v);\n        for(int j = 1; j < 100; ++j){\n            int idx = (u-1) * 100 + j;\n            int idy = (v-1) * 100 + j + 1;\n            for(int k = 1; k <= 50; ++k){\n                add(idx, idy, 1, c + (k * k - (k-1) * (k-1))* d) ;\n            }\n        }\n        for(int j = 1; j < 100; ++j){\n            int idx = (v-1) * 100 + j;\n            int idy = (u-1) * 100 + j + 1;\n            for(int k = 1; k <= 50; ++k){\n                add(idx, idy, 1, c + (k * k - (k-1) * (k-1))* d) ;\n            }\n        }\n    }\n    printf(\"%d\\n\", MaxFlow(s, t));\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nfrom collections import deque\n\ndef solve() -> None:\n    import sys\n    input_data = sys.stdin.read().strip().split()\n    if not input_data:\n        return\n    it = iter(input_data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    \n    # constants from original\n    Z = 100\n    INF = 10**18\n    \n    # node count: 0 = source, t = n*100+1, nodes 1..n*100\n    max_node = n * 100 + 1\n    head = [-1] * (max_node + 1)\n    to = []\n    ct = []\n    w = []\n    nt = []\n    tot = 0\n    \n    def add(u: int, v: int, flow: int, cost: int) -> None:\n        nonlocal tot\n        # forward edge\n        to.append(v)\n        ct.append(cost)\n        w.append(flow)\n        nt.append(head[u])\n        head[u] = tot\n        tot += 1\n        # reverse edge\n        to.append(u)\n        ct.append(-cost)\n        w.append(0)\n        nt.append(head[v])\n        head[v] = tot\n        tot += 1\n    \n    s = 0\n    t = n * 100 + 1\n    \n    # sink edges: from time 100 of node 1 (bug? but original)\n    for i in range(1, 101):\n        add(i, t, 100, 0)\n    \n    # start edges for each person\n    for _ in range(k):\n        v = int(next(it))\n        add(s, (v - 1) * 100 + 1, 1, 0)\n    \n    # wait edges for all nodes\n    for i in range(1, n + 1):\n        for j in range(1, 100):\n            u = (i - 1) * 100 + j\n            v = (i - 1) * 100 + j + 1\n            add(u, v, 100, c)\n    \n    # edges between nodes (bidirectional)\n    for _ in range(m):\n        u = int(next(it))\n        v = int(next(it))\n        for j in range(1, 100):\n            idx = (u - 1) * 100 + j\n            idy = (v - 1) * 100 + j + 1\n            for kk in range(1, 51):\n                cost_edge = c + (kk * kk - (kk - 1) * (kk - 1)) * d\n                add(idx, idy, 1, cost_edge)\n        for j in range(1, 100):\n            idx = (v - 1) * 100 + j\n            idy = (u - 1) * 100 + j + 1\n            for kk in range(1, 51):\n                cost_edge = c + (kk * kk - (kk - 1) * (kk - 1)) * d\n                add(idx, idy, 1, cost_edge)\n    \n    # SPFA\n    d_dist = [INF] * (max_node + 1)\n    vis = [0] * (max_node + 1)\n    pre = [-1] * (max_node + 1)\n    ed_id = [-1] * (max_node + 1)\n    \n    def spfa(s: int, t: int) -> bool:\n        q = deque()\n        for i in range(max_node + 1):\n            d_dist[i] = INF\n            vis[i] = 0\n            pre[i] = -1\n        d_dist[s] = 0\n        q.append(s)\n        while q:\n            u = q.popleft()\n            vis[u] = 0\n            i = head[u]\n            while i != -1:\n                if w[i] > 0 and d_dist[to[i]] > d_dist[u] + ct[i]:\n                    d_dist[to[i]] = d_dist[u] + ct[i]\n                    pre[to[i]] = u\n                    ed_id[to[i]] = i\n                    if not vis[to[i]]:\n                        vis[to[i]] = 1\n                        q.append(to[i])\n                i = nt[i]\n        return d_dist[t] < INF\n    \n    def max_flow(s: int, t: int) -> int:\n        total_cost = 0\n        while spfa(s, t):\n            # find min residual capacity along path\n            mi = INF\n            v = t\n            while v != s:\n                mi = min(mi, w[ed_id[v]])\n                v = pre[v]\n            # update\n            v = t\n            while v != s:\n                i = ed_id[v]\n                w[i] -= mi\n                w[i ^ 1] += mi\n                v = pre[v]\n            total_cost += d_dist[t] * mi\n        return total_cost\n    \n    result = max_flow(s, t)\n    print(result)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0002759314374998212, -2.3841855067985307e-07, -1.1920928244535389e-07, -0.0004049911512993276, -1.9123704433441162, -0.0052535575814545155, -1.1920928244535389e-07, -3.659658250398934e-05, -1.9103877544403076, -0.3237065374851227, -0.5111232995986938, -3.0487797260284424, -0.00043084874050691724, -0.00043132537393830717, -1.0251946150674485e-05, -6.437280717364047e-06, -0.31489357352256775, -0.0001282609737245366, -0.005298144184052944, -5.960462772236497e-07, -0.9972944259643555, -0.31341084837913513, -1.1920922133867862e-06, -0.0012884180760011077, -2.622600959512056e-06, -0.003887834493070841, -2.932505594799295e-05, -0.474107563495636, -1.3112935448589269e-05, -1.311301275563892e-06, -2.47952248173533e-05, -1.811964830267243e-05, -0.023375768214464188, -2.3841855067985307e-07, -1.311301275563892e-06, -3.576278118089249e-07, -0.0009116546134464443, -1.4305104514278355e-06, -2.50339189733495e-06, -0.0001951265730895102, -9.536738616588991e-07, -0.0008422164828516543, -7.152555099310121e-07, -2.3841855067985307e-07, -0.006726006045937538, -1.1920922133867862e-06, -0.005245256703346968, -0.003179021645337343, -0.0008137490367516875, -0.0001658063702052459, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -0.12703514099121094, 0.0, 0.0, -0.00011193125828867778, 0.0, -1.1920928244535389e-07, 0.0, -5.483612312673358e-06, 0.0, -2.6940935640595853e-05, -0.0005169962532818317, 0.0, -1.311301275563892e-06, -2.3841855067985307e-07, -1.0251946150674485e-05, 0.0, -0.0002040654799202457, -0.0036978216376155615, -2.3841855067985307e-07, -8.344646857949556e-07, 0.0, -2.1576648578047752e-05, 0.0, -6.997340824455023e-05,