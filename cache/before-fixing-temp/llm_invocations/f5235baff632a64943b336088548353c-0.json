]];\n      df = min(df, adj[r.v][r.r].c - adj[r.v][r.r].f); u = r.v; }\n    for(int u = t; u != s; ) { Edge& r=adj[u][par[u]], &e=adj[r.v][r.r];\n      e.f += df; r.f -= df; price += df*e.p; u = r.v; }\n    for(int i=0; i<n; i++) { pot[i] = min(INF, dist[i]+pot[i]); } return df; }\n  ll min_cost_flow(int s, int t, ll& price, int n=N, bool sparse=false) {\n    //pot_init(n);\n\t\tll flow = price = 0;\n\t\twhile(ll df=mcf(s, t, price, n, sparse)) { flow += df; } return flow; }\n}\n\nint main() {\n\tios::sync_with_stdio(0);\n\tcin.tie(0); cout.tie(0);\n\tcout << fixed << setprecision(10);\n\n\tint n,m,k,c,d;\n\tcin>>n>>m>>k>>c>>d;\n\n\tconst int source = 0;\n\tconst int sink = n*T+1;\n\n\tfor(int i=0;i<k;i++) {\n\t\tint a;\n\t\tcin>>a;\n\t\tFlow::add_edge(source, a, 1, 0);\n\t}\n\tfor(int t=0;t<T;t++) {\n\t\tFlow::add_edge(1+t*n, sink, INF, 0);\n\t\tif(t>0) {\n\t\t\tfor(int i=1;i<=n;i++) {\n\t\t\t\tFlow::add_edge(i+(t-1)*n, i+t*n, INF, c);\n\t\t\t}\n\t\t}\n\t}\n\n\tfor(int i=0;i<m;i++) {\n\t\tint a, b;\n\t\tcin >> a >> b;\n\t\tfor(int j=0;j<C;j++) {\n\t\t\tint cost = (j+1)*(j+1) - j*j;\n\t\t\tfor(int t=1;t<T;t++) {\n\t\t\t\tFlow::add_edge(a+(t-1)*n, b+t*n, 1, cost*d + c);\n\t\t\t\tFlow::add_edge(b+(t-1)*n, a+t*n, 1, cost*d + c);\n\t\t\t}\n\t\t}\n\t}\n\n\tll price, flow = Flow::min_cost_flow(source, sink, price, sink+1, true);\n\tassert(flow==k);\n\tcout << price << nl;\n\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport math\nimport heapq\n\nclass Flow:\n    class Edge:\n        def __init__(self, v, r, f, c, p):\n            self.v = v\n            self.r = r\n            self.f = f\n            self.c = c\n            self.p = p\n\n    N = 50 * 99 + 2\n\n    def __init__(self):\n        self.adj = [[] for _ in range(Flow.N)]\n        self.sz = [0] * Flow.N\n        self.mc = 0\n\n    def init(self, n=Flow.N):\n        self.mc = 0\n        for i in range(n):\n            self.sz[i] = 0\n            self.adj[i] = []\n\n    def add_edge(self, a, b, c=1, p=0):\n        self.mc = max(self.mc, c)\n        self.adj[a].append(Flow.Edge(b, self.sz[b], 0, c, p))\n        self.sz[b] += 1\n        self.adj[b].append(Flow.Edge(a, self.sz[a], 0, 0, -p))\n        self.sz[a] += 1\n\n    def pot_init(self, n):\n        self.pot = [0] * n\n        for i in range(1, n):\n            for u in range(n):\n                for e in self.adj[u]:\n                    if e.c:\n                        self.pot[e.v] = min(self.pot[e.v], self.pot[u] + e.p)\n\n    def mcf(self, s, t, price, n, sparse):\n        INF = 10**15\n        vis = [False] * n\n        dist = [INF] * n\n        par = [0] * n\n        dist[s] = 0\n        if sparse:\n            dk = []\n            heapq.heappush(dk, (0, s))\n            while dk:\n                d, u = heapq.heappop(dk)\n                if vis[u]:\n                    continue\n                vis[u] = True\n                for e in self.adj[u]:\n                    if e.f < e.c and dist[e.v] > dist[u] + self.pot[u] - self.pot[e.v] + e.p:\n                        dist[e.v] = dist[u] + self.pot[u] - self.pot[e.v] + e.p\n                        par[e.v] = e.r\n                        heapq.heappush(dk, (-dist[e.v], e.v))\n        else:\n            for u in range(s, -1, -1):\n                u_curr = u\n                vis = [False] * n\n                while u_curr != -1:\n                    vis[u_curr] = True\n                    for e in self.adj[u_curr]:\n                        if e.f < e.c and dist[e.v] > dist[u_curr] + self.pot[u_curr] - self.pot[e.v] + e.p:\n                            dist[e.v] = dist[u_curr] + self.pot[u_curr] - self.pot[e.v] + e.p\n                            par[e.v] = e.r\n                    u_curr = -1\n                    best = INF\n                    for i in range(n):\n                        if not vis[i] and dist[i] < best:\n                            best = dist[i]\n                            u_curr = i\n\n        if dist[t] >= 10**15:\n            return 0\n        df = 10**15\n        u = t\n        while u != s:\n            r = self.adj[u][par[u]]\n            r_e = self.adj[r.v][r.r]\n            df = min(df, r_e.c - r_e.f)\n            u = r.v\n        u = t\n        while u != s:\n            r = self.adj[u][par[u]]\n            e = self.adj[r.v][r.r]\n            e.f += df\n            r_e = self.adj[r.v][r.r]\n            r_e.f -= df\n            price[0] += df * e.p\n            u = r.v\n        for i in range(n):\n            self.pot[i] = min(10**15, self.dist[i] + self.pot[i])\n        return df\n\n    def min_cost_flow(self, s, t, price, n=Flow.N, sparse=False):\n        self.pot_init(n)\n        flow = 0\n        while True:\n            df = self.mcf(s, t, price, n, sparse)\n            if df == 0:\n                break\n            flow += df\n        return flow\n\ndef main():\n    input = sys.stdin.read().strip().split()\n    n, m, k, c, d = map(int, input[0:5])\n    ptr = 5\n    source = 0\n    sink = n * 99 + 1\n    flow_solver = Flow()\n    flow_solver.init()\n\n    for _ in range(k):\n        a = int(input[ptr])\n        ptr += 1\n        flow_solver.add_edge(source, a, 1, 0)\n\n    T = 99\n    C = 12\n    \n    for t in range(T):\n        flow_solver.add_edge(1 + t * n, sink, float('inf'), 0)\n        if t > 0:\n            for i in range(1, n + 1):\n                flow_solver.add_edge(i + (t - 1) * n, i + t * n, float('inf'), c)\n\n    for _ in range(m):\n        a = int(input[ptr])\n        b = int(input[ptr + 1])\n        ptr += 2\n        for j in range(C):\n            cost = (j + 1) * (j + 1) - j * j\n            for t in range(1, T):\n                flow_solver.add_edge(a + (t - 1) * n, b + t * n, 1, cost * d + c)\n                flow_solver.add_edge(b + (t - 1) * n, a + t * n, 1, cost * d + c)\n\n    price = [0]\n    flow = flow_solver.min_cost_flow(source, sink, price, sink + 1, True)\n    assert flow == k\n    print(price[0])\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.000520981615409255, -0.012876064516603947, -2.1008713702030946e-06, -3.4285862057004124e-05, -0.026533082127571106, -0.0028423182666301727, -4.8351892473874614e-05, -0.01510506309568882, -0.0014146389439702034, -0.0011711753904819489, -0.18037764728069305, -0.006349169183522463, 0.0, -0.023442061617970467, -2.8572134971618652, -5.526570384972729e-05, -0.0018815194489434361, -0.00015205175441224128, -0.9416422247886658, -1.3663626305060461e-05, -2.5776860184123507e-06, -4.320199877838604e-07, -0.0003809833142440766, -5.512236498361744e-07, 0.0, 0.0, -1.9361264946837764e-07, -7.226628895296017e-06, -1.9361264946837764e-07, -0.002483626827597618, -3.7697225252486533e-06, -6.869017852295656e-06, -4.36574100604048e-06, -0.002187852980569005, 0.0, -3.7697225252486533e-06, 0.0, -2.3080716346157715e-05, -1.8624639324116288e-06, -2.1008713702030946e-06, -5.512236498361744e-07, -0.0002572865632828325, -3.128163257315464e-07, -0.00470483023673296, -4.842555426876061e-06, -1.9361264946837764e-07, -3.128163257315464e-07, -2.339278580620885e-06, 0.0, -6.630610641877865e-06, -6.2729995988775045e-06, 0.0, -3.128163257315464e-07, -9.088346359931165e-07, -2.935296834039036e-06, -5.6934557505883276e-05, -2.339278580620885e-06, 0.0, -1.6240566083070007e-06, -3.128163257315464e-07, -4.320199877838604e-07, -4.320199877838604e-07, -9.088346359931165e-07, 0.0, -1.9361264946837764e-07, -1.9361264946837764e-07, 0.0, -0.04340334236621857, -4.6087021473795176e-05, -0.5768696069717407, -0.0008970508933998644, -0.0013290488859638572, -0.000307575857732445, -0.033661141991615295, -7.505351095460355e-05, -6.392202976712724e-06, -1.9361264946837764e-07, -1.5048530030981055e-06, -5.200166469876422e-06, -0.7976102828979492, -2.7729658540920354e-05, -0.032222677022218704, -9.531813702778891e-05, -1.9361264