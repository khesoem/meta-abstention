i = self.iq[u]\n        while True:\n            j = self.i2(i)\n            if j and lt(self.pq[j], u, self.pi, self.kk):\n                self.pq[self.iq[self.pq[j]] = i] = self.pq[j]\n                i = j\n            else:\n                break\n        self.pq[self.iq[u] = i] = u\n\n    def add(self, u):\n        self.cnt += 1\n        self.iq[u] = self.cnt\n        self.up(u)\n\n    def remove_first(self):\n        u = self.pq[1]\n        v = self.pq[self.cnt]\n        self.cnt -= 1\n        self.iq[v] = 1\n        self.down(v)\n        return u\n\ndef solve():\n    n, m, k, c, d = map(int, sys.stdin.readline().split())\n    ii = [int(x) - 1 for x in sys.stdin.readline().split()]\n    adj = [[] for _ in range(n)]\n    for _ in range(m):\n        i, j = map(int, sys.stdin.readline().split())\n        i -= 1\n        j -= 1\n        adj[i].append(j)\n        adj[j].append(i)\n\n    t = n + k + 1\n    n_ = n * t + 1\n    m_ = 0\n\n    uu = []\n    vv = []\n    uv = []\n    cost = []\n    cost_ = []\n    cc = []\n\n    def add_edge(u, v, cap, cos):\n        nonlocal m_\n        h = m_\n        m_ += 1\n        uu.append(u)\n        vv.append(v)\n        uv.append(u ^ v)\n        cost.append(cos)\n        cc.append(cap)\n        cc.append(0)  # reverse edge capacity initially 0\n        # We'll store adjacency later after all edges are known\n\n    # First pass: collect all edges\n    edges_list = []\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            for j in adj[i]:\n                v = j * t + s + 1\n                for x in range(1, k + 1):\n                    edges_list.append((u, v, 1, c + (x * 2 - 1) * d))\n\n    for i in range(n):\n        for s in range(t - 1):\n            u = i * t + s\n            v = u + 1\n            cap = k\n            cos = 0 if i == 0 else c\n            edges_list.append((u, v, cap, cos))\n\n    for h in range(k):\n        edges_list.append((n_ - 1, ii[h] * t + 0, 1, 0))\n\n    # Now build the graph\n    for u, v, cap, cos in edges_list:\n        add_edge(u, v, cap, cos)\n        add_edge(v, u, 0, -cos)\n\n    # Build adjacency for graph with edges\n    adj_ = [[] for _ in range(n_)]\n    for h in range(m_):\n        adj_[uu[h]].append(h * 2)\n        adj_[vv[h]].append(h * 2 + 1)\n\n    pi = [INF] * n_\n    kk = [0] * n_\n    bb = [0] * n_\n\n    def dijkstra(s):\n        nonlocal pi, kk, bb\n        pi = [INF] * n_\n        pi[s] = 0\n        kk = [0] * n_\n        heap = MinHeap(n_)\n        heap.set_data(pi, kk)\n        heap.add(s)\n        while heap.cnt:\n            u = heap.remove_first()\n            for h_ in adj_[u]:\n                if cc[h_] > 0:\n                    h = h_ // 2\n                    p = pi[u] + (cost_[h] if (h_ & 1) == 0 else -cost_[h])\n                    v = u ^ uv[h]\n                    if pi[v] == INF:\n                        pi[v] = p\n                        kk[v] = kk[u] + 1\n                        bb[v] = h_\n                        heap.add(v)\n                    elif pi[v] > p or (pi[v] == p and kk[v] > kk[u] + 1):\n                        pi[v] = p\n                        kk[v] = kk[u] + 1\n                        bb[v] = h_\n                        heap.up(v)\n\n    def push(s, t):\n        u = t\n        while u != s:\n            h_ = bb[u]\n            h = h_ // 2\n            cc[h_] -= 1\n            cc[h_ ^ 1] += 1\n            u ^= uv[h]\n\n    cost_ = cost[:]\n    while True:\n        dijkstra(n_ - 1)\n        if pi[0 * t + t - 1] == INF:\n            break\n        push(n_ - 1, 0 * t + t - 1)\n        for h in range(m_):\n            u = uu[h]\n            v = vv[h]\n            if pi[u] != INF and pi[v] != INF:\n                cost_[h] += pi[u] - pi[v]\n\n    total_cost = 0\n    for h in range(m_):\n        total_cost += cost[h] * cc[h * 2 + 1]\n    print(total_cost)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": 