\n}\nint main()\n{\n    fn = 100000;    fd = 1;\n    long long int x,i,y,n;\n    cin >> x >> y >> n;\n    int j;\n    for ( int i = 0; i < 19; i++ ) {\n        j = i;\n    }\n    for (i = 1; i <= n; i++) {\n        function (x, y, i, (i*x)/y);\n        function (x, y, i, (i*x)/y + 1);\n        function (x, y, i, (i*x)/y - 1);\n    }\n    cout << ra << \"/\" << rb << endl;\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "import java.util.Scanner;\n\npublic class Main {\n    static long fn, fd;\n    static long ra, rb;\n\n    public static long gcd(long a, long b) {\n        if (b == 0)\n            return a;\n        else\n            return gcd(b, a % b);\n    }\n\n    public static void function(long x, long y, long b, long a) {\n        if (a < 0) {\n            return;\n        }\n        long kkk = gcd(a, b);\n        a = a / kkk;\n        b = b / kkk;\n        long n = Math.abs(b * x - a * y);\n        long d = b * y;\n        long g = gcd(n, d);\n        n = n / g;\n        d = d / g;\n        if (n * fd < fn * d) {\n            fn = n;\n            fd = d;\n            ra = a;\n            rb = b;\n            return;\n        }\n        if (n * fd == fn * d) {\n            if (b < rb) {\n                ra = a;\n                rb = b;\n                return;\n            }\n            if (b > rb) {\n                return;\n            }\n            if (a < ra) {\n                ra = a;\n                rb = b;\n                return;\n            }\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        fn = 100000;\n        fd = 1;\n        long x = sc.nextLong();\n        long y = sc.nextLong();\n        long n = sc.nextLong();\n\n        // The loop with 19 iterations is effectively doing nothing in the original code.\n        // We replicate it to preserve behavior, but it doesn't affect the program.\n        int j = 0;\n        for (int i = 0; i < 19; i++) {\n            j = i;\n        }\n\n        for (long i = 1; i <= n; i++) {\n            function(x, y, i, (i * x) / y);\n            function(x, y, i, (i * x) / y + 1);\n            function(x, y, i, (i * x) / y - 1);\n        }\n        System.out.println(ra + \"/\" + rb);\n        sc.close();\n    }\n}\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.014942072331905365, -1.9361264946837764e-07, -0.00013655527436640114, -0.10384303331375122, -0.000386701402021572, -8.537868779967539e-06, -3.128163257315464e-07, -0.0012102338951081038, -0.0789109393954277, -0.009213611483573914, -0.011329209432005882, -0.00016516048344783485, -0.0007700824644416571, -0.15362779796123505, -1.1279553291387856e-05, -0.015391752123832703, -5.512236498361744e-07, -6.704273118884885e-07, -3.128163257315464e-07, -7.896309739408025e-07, -0.0003811025235336274, -8.537868779967539e-06, -0.023393623530864716, -1.2664456789934775e-06, -0.45849838852882385, 0.0, -0.14268992841243744, 0.0, -1.2352385965641588e-05, -3.128163257315464e-07, -1.0921942703134846e-05, 0.0, 0.0, -0.0004981054808013141, -1.8624639324116288e-06, -3.128163257315464e-07, -0.022708285599946976, -1.9504606825648807e-05, -1.1472419600977446e-06, -7.107425062713446e-06, -1.9361264946837764e-07, -1.9361264946837764e-07, -0.12697000801563263, -1.5048530030981055e-06, 0.0, -4.320199877838604e-07, -2.935296834039036e-06, -5.512236498361744e-07, -0.0015030752401798964, -2.3199920178740285e-05, -6.704273118884885e-07, -1.9361264946837764e-07, 0.0, -7.896309739408025e-07, -2.339278580620885e-06, -1.9361264946837764e-07, -1.3856492842023727e-06, 0.0, -1.3856492842023727e-06, -1.981667537620524e-06, -0.005985797382891178, -6.704273118884885e-07, -0.2291342169046402, -1.9361264946837764e-07, -1.8624639324116288e-06, -0.0031310133635997772, -0.0011851112358272076, 0.0, -1.3856492842023727e-06, 0.0, 0.0, -6.704273118884885e-07, -1.936126494683