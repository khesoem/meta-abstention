n}\n\nvoid dijkstra(int s) {\n    for (int i=0;i<maxn;i++) {\n        d[i] = INF;\n    }\n    d[s] = 0;\n    set<pair<ll,int>> q;\n    q.insert({0,s});\n    while (!q.empty()) {\n        int v = q.begin()->second;\n        q.erase(q.begin());\n        for (int i=0;i<g[v].size();i++) {\n            int eid = g[v][i];\n            if (edges[eid].cap==edges[eid].flow) continue;\n            int to = edges[eid].to;\n            ll len = edges[eid].cost + phi[v] - phi[to];\n            if (d[v]+len<d[to]) {\n                q.erase({d[to],to});\n                d[to] = d[v]+len;\n                par[to] = eid;\n                q.insert({d[to],to});\n            }\n        }\n    }\n}\n\npair<ll,ll> mincost_maxflow(int s, int t) {\n    ford_bellman(s, 50);\n    dijkstra(s);\n    ll flow = 0, cost = 0;\n    while (1) {\n        if (d[t]==INF) break;\n        ll pushed=  INF, sum = 0;\n        for (int tmp = t;tmp!=s;) {\n//            if (tmp==100) {\n//                cout << \"xyu\";\n//            }\n            int eid = par[tmp];\n            pushed = min(pushed, edges[eid].cap-edges[eid].flow);\n            sum+=edges[eid].cost;\n            tmp = edges[eid].from;\n        }\n        flow+=pushed;\n        cost+=pushed*sum;\n        //cout << \"flow: \" << flow << \", cost: \" << cost << endl <<  t << \" \";\n        for (int tmp=t;tmp!=s;) {\n            int eid = par[tmp];\n            edges[eid].flow+=pushed;\n            edges[eid^1].flow-=pushed;\n            tmp = edges[eid].from;\n          //  cout << tmp << \" \";\n        }\n        //cout << endl;\n\n        dijkstra(s);\n        for (int i=0;i<maxn;i++) {\n            phi[i] = d[i];\n        }\n    }\n    return {cost, flow};\n}\nvoid solve() {\n    int n,m,k,c,d;\n    cin >> n >> m >> k >> c >> d;\n    vector<int> cnts(n,0);\n    for (int i=0;i<k;i++) {\n        int ai;\n        cin >> ai;\n        ai--;\n        cnts[ai]++;\n    }\n    for (int i=0;i<n;i++) {\n        add_edge(5000, i, cnts[i],0);\n    }\n    for (int it=0;it<m;it++) {\n        int u,v;\n        cin >> u >> v;\n        u--; v--;\n        for (int i=0;i<99;i++) {\n            ll cost = d;\n            for (int j=0;j<50;j++) {\n                add_edge(u+i*50, v+(i+1)*50, 1, cost);\n                add_edge(v+i*50, u+(i+1)*50, 1, cost);\n                cost+=2*d;\n            }\n        }\n    }\n    for (int i=0;i<=99;i++) {\n        add_edge(0+i*50, 5001, INF, c*i);\n    }\n\n    for (int i=0;i<n;i++) {\n        for (int j=0;j<99;j++) {\n            add_edge(i+j*50, i+(j+1)*50, INF, 0);\n        }\n    }\n    //add_edge(0+99*50, 5001, INF, 0);\n\n    auto p = mincost_maxflow(5000, 5001);\n    assert(p.second==k);\n    cout << p.first;\n}\nint main() {\n    cin.tie(0);\n    cout.tie(0);\n    ios_base::sync_with_stdio(false);\n    cout << setprecision(20) << fixed;\n   // freopen(\"input.txt\",\"r\", stdin);\n//    int t;\n//    cin >> t;\n//    for (int i=0;i<t;i++)\n    solve();\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static class Edge {\n        int from, to;\n        long cap, cost, flow;\n        Edge(int from, int to, long cap, long cost) {\n            this.from = from; this.to = to; this.cap = cap; this.cost = cost; this.flow = 0;\n        }\n    }\n\n    static final int maxn = 5007;\n    static final long INF = (long) 1e9;\n\n    static ArrayList<Edge> edges = new ArrayList<>();\n    static List<Integer>[] g = new ArrayList[maxn];\n    static long[] d = new long[maxn], phi = new long[maxn];\n    static int[] par = new int[maxn];\n\n    static {\n        for (int i = 0; i < maxn; i++) {\n            g[i] = new ArrayList<>();\n        }\n    }\n\n    static void addEdge(int u, int v, long cap, long cost) {\n        g[u].add(edges.size());\n        edges.add(new Edge(u, v, cap, cost));\n        g[v].add(edges.size());\n        edges.add(new Edge(v, u, 0, -cost));\n    }\n\n    static void fordBellman(int s, int n) {\n        Arrays.fill(phi, INF);\n        phi[s] = 0;\n        for (int i = 0; i < n; i++) {\n            for (Edge e : edges) {\n                if (e.cap == e.flow) continue;\n                int from = e.from, to = e.to;\n                long len = e.cost;\n                if (phi[from] == INF) continue;\n                phi[to] = Math.min(phi[to], phi[from] + len);\n            }\n        }\n    }\n\n    static void dijkstra(int s) {\n        Arrays.fill(d, INF);\n        d[s] = 0;\n        PriorityQueue<long[]> q = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n        q.offer(new long[]{0, s});\n        while (!q.isEmpty()) {\n            long[] curr = q.poll();\n            int v = (int) curr[1];\n            long dist = curr[0];\n            if (d[v] < dist) continue;\n            for (int eid : g[v]) {\n                Edge e = edges.get(eid);\n                if (e.cap == e.flow) continue;\n                int to = e.to;\n                long len = e.cost + phi[v] - phi[to];\n                if (d[v] + len < d[to]) {\n                    d[to] = d[v] + len;\n                    par[to] = eid;\n                    q.offer(new long[]{d[to], to});\n                }\n            }\n        }\n    }\n\n    static long[] minCostMaxFlow(int s, int t) {\n        fordBellman(s, 50);\n        dijkstra(s);\n        long flow = 0, cost = 0;\n        while (true) {\n            if (d[t] == INF) break;\n            long pushed = Long.MAX_VALUE, sum = 0;\n            for (int tmp = t; tmp != s; tmp = edges.get(par[tmp]).from) {\n                int eid = par[tmp];\n                pushed = Math.min(pushed, edges.get(eid).cap - edges.get(eid).flow);\n                sum += edges.get(eid).cost;\n            }\n            flow += pushed;\n            cost += pushed * sum;\n            for (int tmp = t; tmp != s; tmp = edges.get(par[tmp]).from) {\n                int eid = par[tmp];\n                edges.get(eid).flow += pushed;\n                edges.get(eid ^ 1).flow -= pushed;\n            }\n            dijkstra(s);\n            for (int i = 0; i < maxn; i++) {\n                phi[i] = d[i];\n            }\n        }\n        return new long[]{cost, flow};\n    }\n\n    static void solve() {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt(), m = sc.nextInt(), k = sc.nextInt(), c = sc.nextInt(), dVal = sc.nextInt();\n        int[] cnts = new int[n];\n        for (int i = 0; i < k; i++) {\n            int ai = sc.nextInt(); ai--;\n            cnts[ai]++;\n        }\n        for (int i = 0; i < n; i++) {\n            addEdge(5000, i, cnts[i], 0);\n        }\n        for (int it = 0; it < m; it++) {\n            int u = sc.nextInt(), v = sc.nextInt();\n            u--; v--;\n            long cost = dVal;\n            for (int i = 0; i < 99; i++) {\n                addEdge(u + i * 50, v + (i + 1) * 50, 1, cost);\n                addEdge(v + i * 50, u + (i + 1) * 50, 1, cost);\n                cost += 2L * dVal;\n            }\n        }\n        for (int i = 0; i <= 99; i++) {\n            addEdge(i * 50, 5001, INF, c * i);\n        }\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < 99; j++) {\n                addEdge(i + j * 50, i + (j + 1) * 50, INF, 0);\n            }\n        }\n        long[] p = minCostMaxFlow(5000, 5001);\n        // assert p[1] == k; (not used in Java)\n        System.out.println(p[0]);\n    }\n\n    public static void main(String[] args) {\n        solve();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0003076950670219958, -4.6087021473795176e-05, -1.0280383548888494e-06, -8.756989700486884e-05, -1.7432603272027336e-06, -6.704273118884885e-07, -0.009808151982724667, -0.11330629885196686, -0.0005996193503960967, -0.0002622894535306841, -0.019912095740437508, -0.000501324015203863