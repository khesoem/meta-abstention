][y1][ptr];\n\tif(ret != -1)return ret;\n\tif(x0 == x1 && y0 == y1)return dist[x0][y0] >= ptr;\n\tif(dist[x0][y0] <= ptr)return ret = 0;\n\tfor(int k = 0; k < 4; k++){\n\t\tint nx = x0 + dx[k];\n\t\tint ny = y0 + dy[k];\n\t\tif(good(nx, ny) && dfs(nx, ny, x1, y1, ptr + 1))return ret = 1;\n\t}\n\treturn ret = 0;\n}\n\nbool fml(int s, int t){\n\tmemset(par, -1, sizeof(par));\n\tpar[s] = -2;\n\tqueue<int> qu;\n\tqu.push(s);\n\twhile(!qu.empty()){\n\t\tint v = qu.front(); qu.pop();\n\t\tfor(int i = s; i <= t; i++){\n\t\t\tif(par[i] == -1 && cap[v][i] > 0){\n\t\t\t\tpar[i] = v;\n\t\t\t\tqu.push(i);\n\t\t\t}\n\t\t}\n\t}\n\treturn par[t] != -1;\n}\n\nint main(){\n\tios::sync_with_stdio(false);\n\tcin.tie(NULL);\n\tcout<<setprecision(32);\n\n\tcin>>n>>t;\n\tfor(int i = 0; i < n; i++){\n\t\tcin>>sci[i];\n\t}\n\tfor(int i = 0; i < n; i++){\n\t\tcin>>lab[i];\n\t}\n\tvector<pair<int, int> > pos;\n\tvector<int> lc, sc;\n\tfor(int i = 0; i < n; i++){\n\t\tfor(int j = 0; j < n; j++){\n\t\t\tif(sci[i][j] == 'Z'){\n\t\t\t\trx = i;\n\t\t\t\try = j;\n\t\t\t}else if('0' <= sci[i][j] && sci[i][j] <= '9'){\n\t\t\t\tpos.push_back({i, j});\n\t\t\t\tlc.push_back(lab[i][j] - '0');\n\t\t\t\tsc.push_back(sci[i][j] - '0');\n\t\t\t}\n\t\t}\n\t}\n\tint m = pos.size();\n\tmemset(cap, 0, sizeof(cap));\n\tfor(int i = 0; i < m; i++){\n\t\tcap[0][i + 1] = sc[i];\n\t\tcap[m + 1 + i][2*m + 1] = lc[i];\n\t}\n\tpre();\n\tmemset(mem, -1, sizeof(mem));\n\tfor(int i = 0; i < m; i++){\n\t\tfor(int j = 0; j < m; j++){\n\t\t\tif(dfs(pos[i].first, pos[i].second, pos[j].first, pos[j].second, 0)){\n\t\t\t\t// cout<<pos[i].first<<\" \"<<pos[i].second<<\" \"<<pos[j].first<<\" \"<<pos[j].second<<endl;\n\t\t\t\tcap[i + 1][m + 1 + j] = 1000;\n\t\t\t}\n\t\t}\n\t}\n\tint flow = 0;\n\twhile(fml(0, 2*m + 1)){\n\t\tint t = 2*m + 1;\n\t\tint nflow = 1e6;\n\t\twhile(par[t] >= 0){\n\t\t\tnflow = min(nflow, cap[par[t]][t]);\n\t\t\tt = par[t];\n\t\t}\n\t\tt = 2*m + 1;\n\t\twhile(par[t] >= 0){\n\t\t\tcap[par[t]][t] -= nflow;\n\t\t\tcap[t][par[t]] += nflow;\n\t\t\tt = par[t];\n\t\t}\n\t\tflow += nflow;\n\t}\n\tcout<<flow;\n\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn = int(input())\nt = int(input())\nsci = [input().strip() for _ in range(n)]\nlab = [input().strip() for _ in range(n)]\n\ndx = [1, -1, 0, 0]\ndy = [0, 0, 1, -1]\n\n# Find the position of 'Z'\nrx, ry = None, None\npos = []\nlc = []\nsc = []\n\nfor i in range(n):\n    for j in range(n):\n        if sci[i][j] == 'Z':\n            rx, ry = i, j\n        elif '0' <= sci[i][j] <= '9':\n            pos.append((i, j))\n            lc.append(int(lab[i][j]))\n            sc.append(int(sci[i][j]))\n\nm = len(pos)\n\n# Initialize data structures\ndist = [[float('inf')] * n for _ in range(n)]\nvis = [[0] * n for _ in range(n)]\n\ndef good(x, y):\n    return 0 <= x < n and 0 <= y < n and lab[x][y] != 'Y' and lab[x][y] != 'Z'\n\ndef pre():\n    for i in range(n):\n        for j in range(n):\n            dist[i][j] = float('inf')\n            vis[i][j] = 0\n    dist[rx][ry] = 0\n    vis[rx][ry] = 1\n    from collections import deque\n    queue = deque()\n    queue.append((rx, ry))\n    while queue:\n        x, y = queue.popleft()\n        for k in range(4):\n            nx = x + dx[k]\n            ny = y + dy[k]\n            if good(nx, ny) and not vis[nx][ny]:\n                dist[nx][ny] = dist[x][y] + 1\n                vis[nx][ny] = 1\n                queue.append((nx, ny))\n\n# Precompute shortest distances\npre()\n\n# Memoization for DFS\nmem = [[[[-1 for _ in range(t+2)] for _ in range(n)] for _ in range(n)] for _ in range(n)]\n\ndef dfs(x0, y0, x1, y1, ptr):\n    if ptr > t:\n        return 0\n    if mem[x0][y0][x1][y1] != -1:\n        return mem[x0][y0][x1][y1]\n    if x0 == x1 and y0 == y1:\n        return 1 if dist[x0][y0] >= ptr else 0\n    if dist[x0][y0] <= ptr:\n        return 0\n    for k in range(4):\n        nx = x0 + dx[k]\n        ny = y0 + dy[k]\n        if good(nx, ny) and dfs(nx, ny, x1, y1, ptr + 1):\n            mem[x0][y0][x1][y1] = 1\n            return 1\n    mem[x0][y0][x1][y1] = 0\n    return 0\n\n# Build capacity graph\ncap = [[0] * (2 * m + 2) for _ in range(2 * m + 2)]\npar = [-1] * (2 * m + 2)\n\nfor i in range(m):\n    cap[0][i + 1] = sc[i]\n    cap[m + 1 + i][2 * m + 1] = lc[i]\n\n# Check reachability between points\nfor i in range(m):\n    for j in range(m):\n        x1_i, y1_i = pos[i]\n        x2_j, y2_j = pos[j]\n        if dfs(x1_i, y1_i, x2_j, y2_j, 0):\n            cap[i + 1][m + 1 + j] = 1000\n\nflow = 0\nwhile True:\n    # Reset parents for BFS\n    for i in range(len(par)):\n        par[i] = -1\n    # BFS to find augmenting path\n    from collections import deque\n    queue = deque()\n    queue.append(0)\n    par[0] = -2\n    while queue:\n        v = queue.popleft()\n        for i in range(len(cap)):\n            if par[i] == -1 and cap[v][i] > 0:\n                par[i] = v\n                queue.append(i)\n    if par[2 * m + 1] == -1:\n        break\n    # Find minimal residual capacity\n    t_node = 2 * m + 1\n    nflow = float('inf')\n    while par[t_node] >= 0:\n        nflow = min(nflow, cap[par[t_node]][t_node])\n        t_node = par[t_node]\n    # Update residual graph\n    t_node = 2 * m + 1\n    while par[t_node] >= 0:\n        cap[par[t_node]][t_node] -= nflow\n        cap[t_node][par[t_node]] += nflow\n        t_node = par[t_node]\n    flow += nflow\n\nprint(flow)\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00026217024424113333, -0.0002273774443892762, -4.320199877838604e-07, -1.652451464906335e-05, -0.06876236945390701, -0.008470961824059486, -0.006798021495342255, -1.3856492842023727e-06, -0.02127060480415821, -2.2200749754119897e-06, -0.0002479886752553284, 0.0, -1.9361264946837764e-07, -0.6937645077705383, -0.3487389385700226, -3.128163257315464e-07, -3.531315314830863e-06,