(ans-solve(0,n)+p)%p;\n\t}\n\tprintf(\"%d\\n\",ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef lowbit(x):\n    return x & -x\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, p = map(int, data)\n    ans = pow(k, n, p)\n    if n % 2 == 0:\n        # init factorials and inverse factorials\n        fac = [1] * (n + 1)\n        for i in range(1, n + 1):\n            fac[i] = (fac[i-1] * i) % p\n        inv = [1] * (n + 1)\n        inv[n] = pow(fac[n], p-2, p)\n        for i in range(n, 0, -1):\n            inv[i-1] = (inv[i] * i) % p\n\n        # allocate DP table\n        max_cur = k + 1  # cur goes up to k, so size k+1\n        f = [ [-1] * (n + 1) for _ in range(max_cur) ]\n\n        def solve(cur, S):\n            if f[cur][S] != -1:\n                return f[cur][S]\n            if S == 0:\n                prod = 1\n                for i in range(1, cur + 1):\n                    prod = (prod * (k - i + 1)) % p\n                res = (fac[n] * prod) % p\n                f[cur][S] = res\n                return res\n            U = S - lowbit(S)\n            total = 0\n            T = U\n            # iterate over all non\u2011empty subsets of U\n            while T:\n                total = (total + inv[S - T] * solve(cur + 1, T)) % p\n                T = (T - 1) & U\n            # add the empty subset\n            total = (total + inv[S] * solve(cur + 1, 0)) % p\n            f[cur][S] = total\n            return total\n\n        ans = (ans - solve(0, n) + p) % p\n\n    sys.stdout.write(str(ans) + \"\\n\")\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -0.0002286172821186483, -0.00031704644788987935, 0.0, -0.00028451209072954953, 