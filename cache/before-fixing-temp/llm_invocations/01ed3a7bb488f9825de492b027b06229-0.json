long msummaddness = calcsum(0, lcnt) + calcsum(0, rcnt);\n            int mlt = choose[lcnt + rcnt][lcnt];\n            ret.ways = (ret.ways + lres.ways * mways % MOD * rres.ways % MOD * mlt) % MOD;\n            ret.summaddness = (ret.summaddness + lres.summaddness * mways % MOD * rres.ways % MOD * mlt\n                              + lres.ways * msummaddness % MOD * rres.ways % MOD * mlt\n                              + lres.ways * mways % MOD * rres.summaddness % MOD * mlt) % MOD;\n        }\n        done2[n] = true;\n        mem2[n] = ret;\n        return ret;\n    }\n\n    static Res go1(int at, int cnt) {\n        if (ncomp - at == cnt) return go2(cnt);\n        if (done1[at][cnt]) return mem1[at][cnt];\n        Res ret = new Res(0, 0);\n        for (int i = at; i < ncomp; i++) {\n            int lcnt = i - at;\n            int rcnt = cnt - lcnt;\n            if (rcnt < 0 || rcnt > ncomp - i - 1) continue;\n            Res lres = (i == at) ? new Res(1, 0) : go2(lcnt);\n            Res rres = (i + 1 == ncomp) ? new Res(1, 0) : go1(i + 1, rcnt);\n            int mlt = choose[lcnt + rcnt][lcnt];\n            ret.ways = (ret.ways + lres.ways * rres.ways % MOD * mlt) % MOD;\n            ret.summaddness = (ret.summaddness + lres.summaddness * rres.ways % MOD * mlt\n                              + lres.ways * rres.summaddness % MOD * mlt) % MOD;\n        }\n        done1[at][cnt] = true;\n        mem1[at][cnt] = ret;\n        return ret;\n    }\n\n    static int solve() {\n        for (int i = 0; i <= ncomp; i++) {\n            choose[i][0] = choose[i][i] = 1;\n            for (int j = 1; j < i; j++) {\n                choose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD;\n            }\n        }\n        Arrays.fill(done2, false);\n        for (int i = 0; i < ncomp; i++) {\n            Arrays.fill(done1[i], false);\n        }\n        return (int) go1(0, npers).summaddness;\n    }\n\n    public static void main(String[] args) throws IOException {\n        