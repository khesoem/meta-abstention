ex[x]==-1) return flow;\n\t\tint y=x;x=prex[y];int i=prei[y],j=rev[x][i];\n\t\tint f=dfs(x,min(flow,cap[x][i]));\n\t\tcap[x][i]-=f,cap[y][j]+=f;\n\t\treturn f;\n\t}\n\t\n\tpii solve(int s,int t)\n\t{\n\t\tint ans=0;tot=0;\n\t\twhile(1)\n\t\t{\n\t\t\tspfa(s);\n\t\t\tif(dist[t]>1e9) break;\n\t\t\tint f=dfs(t,inf);\n\t\t\ttot+=f*dist[t];\n\t\t\tans+=f;\n\t\t}\n\t\treturn mp(ans,tot);\n\t}\n\t\n};\n\n\nint n,m,s=nn-1,t=nn-2;\nint k,c,d;\nint get(int x,int tim){\n\treturn tim*52-52+x;\n}\nint main() \n{\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);int kk=k;\n\twhile(k--){\n\t\tint x;scanf(\"%d\",&x);\n\t\tmcmf::add_edge(s,get(x,1),1,0);\n\t}k=kk;\n\twhile(m--){\n\t\tint x,y;scanf(\"%d%d\",&x,&y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t\t\n\t\tswap(x,y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t}\n\tfor(int i=1;i<100;i++){\n\t\tfor(int j=1;j<=n;j++) mcmf::add_edge(get(j,i),get(j,i+1),inf,0);\n\t\tmcmf::add_edge(get(1,i),t,inf,c*(i-1));\n\t}\n\t\n\tprintf(\"%d\",mcmf::solve(s,t).second);\n\t\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nINF = 10**9\nnn = 6000\n\n# Global graph arrays\nv = [[] for _ in range(nn)]\nrev = [[] for _ in range(nn)]\ncost = [[] for _ in range(nn)]\ncap = [[] for _ in range(nn)]\n\ndef add_edge(x, y, c, w):\n    rev[x].append(len(v[y]))\n    rev[y].append(len(v[x]))\n    v[x].append(y)\n    v[y].append(x)\n    cost[x].append(w)\n    cost[y].append(-w)\n    cap[x].append(c)\n    cap[y].append(0)\n\ndist = [0] * nn\nvis = [0] * nn\nprex = [0] * nn\nprei = [0] * nn\n\ndef spfa(s):\n    for i in range(nn):\n        dist[i] = INF\n        vis[i] = 0\n    dist[s] = 0\n    prex[s] = -1\n    q = deque()\n    q.append(s)\n    vis[s] = 1\n    while q:\n        x = q.popleft()\n        vis[x] = 0\n        for i in range(len(v[x])):\n            y = v[x][i]\n            cc = dist[x] + cost[x][i]\n            if dist[y] > cc and cap[x][i] > 0:\n                dist[y] = cc\n                prex[y] = x\n                prei[y] = i\n                if not vis[y]:\n                    vis[y] = 1\n                    q.append(y)\n\ndef dfs(x, flow):\n    if prex[x] == -1:\n        return flow\n    y = x\n    x = prex[y]\n    i = prei[y]\n    j = rev[x][i]\n    f = dfs(x, min(flow, cap[x][i]))\n    cap[x][i] -= f\n    cap[y][j] += f\n    return f\n\ndef solve(s, t):\n    ans = 0\n    tot = 0\n    while True:\n        spfa(s)\n        if dist[t] > INF // 2:\n            break\n        f = dfs(t, INF)\n        tot += f * dist[t]\n        ans += f\n    return (ans, tot)\n\ndef get(x, tim):\n    return tim * 52 - 52 + x\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    k = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    kk = k\n    s = nn - 1\n    t = nn - 2\n\n    for _ in range(kk):\n        x = int(next(it))\n        add_edge(s, get(x, 1), 1, 0)\n\n    k = kk\n    for _ in range(m):\n        x = int(next(it))\n        y = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        # swap and repeat\n        x, y = y, x\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n\n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            add_edge(get(j, i), get(j, i + 1), INF, 0)\n        add_edge(get(1, i), t, INF, c * (i - 1))\n\n    result = solve(s, t)\n    print(result[1])\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "t