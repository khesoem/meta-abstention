;i++) inv[i]=inv[i-1]*inv[i]%mod;\n}\n\nLL qmod(LL a,LL b,LL c){\n    LL ret=1;\n    for(;b;b>>=1){\n        if(b&1) ret=ret*a%c;\n        a=a*a%c;\n    }\n    return ret;\n}\n\nvector<int> megumi;\nLL mod;\nint k;\nLL dp[20][250005];\n\nint main(){ios_base::sync_with_stdio(0);cin.tie(0);\n    LL n;cin>>n>>k>>mod;\n    CNumberInit(n+5,mod);\n    if(n%2){\n        cout<<qmod(k,n,mod)<<endl;\n    }else{\n        for(int i=2;i<=n;i+=2){\n            if((i&n)==i) megumi.push_back(i);\n        }\n        LL ans=0;\n        dp[0][n]=1;\n        for(int i=1;i<=min(17,k);i++){\n            int tmpans=0;\n            for(int j=0;j<megumi.size();j++){\n                if(!dp[i-1][megumi[j]]) continue;\n                int Megumi=megumi[j]&(megumi[j]-1);\n                int step=Megumi^megumi[j];\n                for(int k=step;k<=Megumi;k+=step){\n                    if((k&Megumi)==k){\n                        dp[i][k]+=dp[i-1][megumi[j]]*p[megumi[j]]%mod\n                            *inv[k]%mod*inv[megumi[j]-k]%mod;\n                        dp[i][k]%=mod;\n                    }\n                }\n                tmpans=(tmpans+dp[i-1][megumi[j]])%mod;\n            }\n            ans+=tmpans*inv[k-i]%mod;\n        }\n        ans=ans*p[k]%mod;\n        ans=qmod(k,n,mod)-ans;\n        ans=(ans%mod+mod)%mod;\n        cout<<ans<<endl;\n    }\n    return 0;\n}\n//1000000007\n//cout.setf(ios::fixed);\n//cout<<fixed<<setprecision(10)<<s<<endl;\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef qmod(a, b, c):\n    res = 1\n    while b:\n        if b & 1:\n            res = res * a % c\n        a = a * a % c\n        b >>= 1\n    return res\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    n = int(data[0])\n    k = int(data[1])\n    mod = int(data[2])\n\n    maxn = n + 5\n    # factorial and inverse factorial arrays\n    p = [1] * (maxn + 1)\n    inv = [1] * (maxn + 1)\n    # inv[i] will store inverse of i (modular) initially, then later factorial inverse\n    inv[0] = inv[1] = 1\n    p[0] = p[1] = 1\n    for i in range(2, maxn + 1):\n        inv[i] = (mod - mod // i) * inv[mod % i] % mod\n        p[i] = p[i-1] * i % mod\n    for i in range(2, maxn + 1):\n        inv[i] = inv[i-1] * inv[i] % mod\n\n    if n % 2 == 1:\n        print(qmod(k, n, mod))\n        return\n\n    # collect even numbers i (2 <= i <= n) such that (i & n) == i\n    megumi = []\n    for i in range(2, n+1, 2):\n        if (i & n) == i:\n            megumi.append(i)\n\n    max_depth = min(17, k)\n    dp = [dict() for _ in range(max_depth + 1)]   # dp[0]..dp[max_depth]\n    dp[0][n] = 1\n    ans = 0\n\n    for i in range(1, max_depth + 1):\n        tmp = 0\n        # iterate over all entries of dp[i-1]\n        for M, val in dp[i-1].items():\n            if val == 0:\n                continue\n            # M must be even and a subset of n\n            M_ = M & (M - 1)          # remove lowest set bit\n            step = M_ ^ M             # lowest set bit\n            # iterate over kk from step to M_ inclusive, step = step\n            kk = step\n            while kk <= M_:\n                if (kk & M_) == kk:   # kk is a subset of M_\n                    # binomial coefficient C(M, kk)\n                    binom = p[M] * inv[kk] % mod * inv[M - kk] % mod\n                    add = val * binom % mod\n                    dp[i][kk] = (dp[i].get(kk, 0) + add) % mod\n                kk += step\n            tmp = (tmp + val) % mod\n        ans = (ans + tmp * inv[k - i]) % mod\n\n    ans = ans * p[k] % mod\n    ans = (qmod(k, n, mod) - ans) % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>0.95</confidence>", "token_logprobs": [-4.768370445162873e-07, 0.0, 0.0, -0.0003197873884346336, -0.0072187078185379505, -1.1920928244535389e-07, -0.02328166924417019, -0