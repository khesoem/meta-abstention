umitri12\n*/\n\nstruct FastReader {\n    std::istream& in;\n    FastReader(std::istream& is) : in(is) {}\n    std::string next() {\n        static std::string token;\n        while (!(in >> token)) {\n            in.clear();\n            in.ignore(std::numeric_limits<std::streamsize>::max(), '\\n');\n        }\n        return token;\n    }\n    int nextInt() {\n        int val;\n        in >> val;\n        return val;\n    }\n    long long nextLong() {\n        long long val;\n        in >> val;\n        return val;\n    }\n    double nextDouble() {\n        double val;\n        in >> val;\n        return val;\n    }\n    std::string nextLine() {\n        std::string line;\n        std::getline(in, line);\n        return line;\n    }\n};\n\nstruct Node {\n    long long pp;\n    long long a, b;\n    Node(long long x, long long y) {\n        a = x;\n        b = y;\n        pp = a * b;\n    }\n};\n\nstruct Comp {\n    bool operator()(const Node& o1, const Node& o2) const {\n        return o1.pp < o2.pp; // For max heap behavior\n    }\n};\n\nint gcd(int x, int y) {\n    while (y != 0) {\n        int tmp = y;\n        y = x % y;\n        x = tmp;\n    }\n    return x;\n}\n\nlong long mod_pow(long long a, long long b, long long mod) {\n    a %= mod;\n    long long result = 1 % mod;\n    while (b > 0) {\n        if (b & 1) result = (result * a) % mod;\n        a = (a * a) % mod;\n        b >>= 1;\n    }\n    return result;\n}\n\nlong long _pow(long long a, long long b) {\n    if (b == 0) return 1;\n    long long u = _pow(a, b >> 1);\n    u = u * u;\n    if (b & 1) u *= a;\n    return u;\n}\n\nint modInv(int a, int m) {\n    if (gcd(a, m) != 1) return -999;\n    return (a % m + m) % m;\n}\n\nbool isPowerOfTwo(int x) {\n    return x != 0 && ((x & (x - 1)) == 0);\n}\n\nbool isprime(int x) {\n    if (x < 2) return false;\n    for (int i = 2; i <= (int)std::sqrt(x); i++) {\n        if (x % i == 0) return false;\n    }\n    return true;\n}\n\nstatic bool prime[1000007];\nstatic const int INT_MAX = 1000007;\n\nvoid sieve() {\n    std::fill(prime, prime + INT_MAX, true);\n    prime[0] = prime[1] = false;\n    for (int i = 2; i <= (int)std::sqrt(INT_MAX); i++) {\n        if (prime[i]) {\n            for (int j = i * 2; j < INT_MAX; j += i)\n                prime[j] = false;\n        }\n    }\n}\n\nstruct Pair {\n    int ff, ss;\n    Pair(int f, int s) : ff(f), ss(s) {}\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    FastReader sc(cin);\n    int n = sc.nextInt(), w = sc.nextInt();\n    std::vector<int> a(n);\n    for (int i = 0; i < n; i++) a[i] = sc.nextInt();\n    int e = 0, o = 0;\n    std::deque<int> stack;\n    stack.push_back(a[0]);\n    std::vector<int> cuts;\n\n    for (int i = 0; i + 1 < n; i++) {\n        if ((a[i] & 1) == 0)\n            ++e;\n        else\n            ++o;\n        if (e == o)\n            cuts.push_back(std::abs(a[i] - a[i + 1]));\n    }\n\n    n = (int)cuts.size();\n    std::vector<std::vector<int>> dp(n + 1, std::vector<int>(w + 1, 0));\n    // initialization handled by vector constructor\n\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= w; j++) {\n            if (cuts[i - 1] <= j) {\n                dp[i][j] = std::max(1 + dp[i - 1][j - cuts[i - 1]], dp[i - 1][j]);\n            } else {\n                dp[i][j] = dp[i - 1][j];\n            }\n        }\n    }\n    int ans = dp[n][w];\n    cout << ans << \"\\n\";\n\n    return 0;\n}\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-0.00372728006914258, -0.001308809849433601, -2.2200749754119897e-06, -0.00015741224342491478, -1.5048530030981055e-06, -1.318681188422488e-05, -0.04301174357533455, -2.696889623621246e-06, -1.0087516784551553e-05, -3.128163257315464e-07, -0.002017144113779068, -2.8206473871250637e-05, 0.0, 0.0, -1.3195983171463013, -2.318939208984375, -0.2519405782222748, -0.06149676442146301, -4.0126840758603066e-05, -0.0034227122087031603, -1.9361264946837764e-07, -2.33