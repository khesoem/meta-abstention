;\n            for (size_t j = 0; j < dp[0].size(); j++) {\n                sum += dp[i][j];\n                sum %= mod;\n                if (sum == 0) sum += mod;\n                sums[i][j] = sum;\n            }\n        }\n\n        vector<long long> fact(501 * 501, 1);\n        for (size_t i = 2; i < fact.size(); i++) {\n            fact[i] = (fact[i - 1] * i) % mod;\n        }\n\n        vector<vector<long long>> ncr(501, vector<long long>(501, 0));\n        ncr[0][0] = 1;\n        for (int i = 1; i < 501; i++) {\n            ncr[i][0] = 1;\n            for (int j = 1; j <= i; j++) {\n                ncr[i][j] = (ncr[i - 1][j] + ncr[i - 1][j - 1]) % mod;\n            }\n        }\n\n        long long res = 0;\n        for (int i = n - 2; i >= 0; i--) {\n            int cnt = n - i;\n            int pre = n - cnt;\n            long long com = (ncr[n][pre] * fact[pre]) % mod;\n            long long sum = 0;\n            for (int dif = 1; dif < cnt; dif++) {\n                for (int inv = dif; inv < (int)dp[0].size(); inv++) {\n                    if (dp[cnt - 2][inv] == 0) {\n                        break;\n                    }\n                    if (inv - dif - 1 < 0) continue;\n                    long long x = dp[cnt - 2][inv];\n                    long long y = sums[cnt - 2][inv - dif - 1];\n                    x *= y;\n                    x %= mod;\n                    if (x == 0) x += mod;\n                    sum += x * (cnt - dif);\n                    sum %= mod;\n                }\n            }\n            res += sum * com;\n            res %= mod;\n            if (res == 0) res += mod;\n        }\n        out << res % mod << \"\\n\";\n    }\n\nprivate:\n    ostream& out;\n    FastScanner& fs;\n};\n\nint main() {\n    FastScanner fs;\n    Solution sol(cout, fs);\n    int T = 1;\n    for (int t = 0; t < T; t++) {\n        sol.solution(T, t);\n    }\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.000