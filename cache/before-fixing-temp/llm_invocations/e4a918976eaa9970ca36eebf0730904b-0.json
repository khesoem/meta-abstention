n            base += choose(i, R - 1) * choose(N - i - 1, R);\n        long unfair = Long.MAX_VALUE;\n        long trg = 2 * base - choose(N, 2 * R);\n\n        long req = 0, excl = 0;\n        long ans = 0;\n        for (int i = 0; i < N; i++) {\n            if (pattern.charAt(i) == 'A')\n                req |= bit(i);\n            else if (pattern.charAt(i) == 'B')\n                excl |= bit(i);\n        }\n\n        long[][] dp = new long[R + C + 1][R + C + 1];\n        dp[0][0] = 1;\n        for (int j = 0; j <= R + C; j++)\n            for (int k = 0; k <= R + C; k++) {\n                if (j >= R - 1 && k >= R) break;\n                if (j < R + C && pattern.charAt(j + k) != 'B')\n                    dp[j + 1][k] += dp[j][k];\n                if (k < R + C && pattern.charAt(j + k) != 'A')\n                    dp[j][k + 1] += dp[j][k];\n            }\n\n        int M = N - C;\n        List<List<Long>> asums2 = new ArrayList<>(R + C + 1);\n        for (int al = 0; al <= R + C; al++) {\n            asums2.add(new ArrayList<>());\n        }\n        for (int al = R - 1; al <= R + C; al++) {\n            recurse(M, N, al, R + C - al, req, excl, 0, asums2.get(al));\n            Collections.sort(asums2.get(al), Collections.reverseOrder());\n        }\n\n        for (int a = R - 1; a <= R + C; a++)\n            for (int b = R; b <= R + C; b++) {\n                if (a > R - 1 && b > R) continue;\n                if (dp[a][b] == 0) continue;\n                int L = a + b;\n                for (int l = 0; l <= M - L; l++) {\n                    int r = R + C - a - l;\n                    if (r > N - M || r < 0) continue;\n                    List<Long> sums1 = new ArrayList<>();\n                    recurse(L, M, a, l, req, excl, 0, sums1);\n                    List<Long> sums2 = asums2.get(a + l);\n                    Collections.sort(sums1);\n                    int p = 0, q = 0;\n                    int p2 = 0, q2 = 0;\n                    while (p < sums1.size()