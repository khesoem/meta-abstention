 p %= mod;\n            return p;\n        }\n\n        public void solve(int testNumber, InputReader in, PrintWriter out) {\n            this.out = out;\n            this.in = in;\n            int n = ni();\n            int K = ni();\n            int cnt1 = 0, cnt2 = 0;\n            int i = 0, j = 0, k = 0;\n            for (i = 0; i < 100; i++) {\n                for (j = 0; j <= i; j++) {\n                    if (j == 0 || j == i)\n                        nCr[i][j] = 1;\n                    else\n                        nCr[i][j] = (nCr[i - 1][j] + nCr[i - 1][j - 1]) % mod;\n                }\n            }\n            for (i = 0; i < n; i++) {\n                if (ni() == 50)\n                    cnt1++;\n                else\n                    cnt2++;\n            }\n            long[][][] dist = new long[200][200][2];\n            long[][][] dp = new long[200][200][2];\n            for (i = 0; i < 200; i++) {\n                for (j = 0; j < 200; j++)\n                    Arrays.fill(dist[i][j], INF);\n            }\n            dist[0][0][0] = 0;\n            dp[0][0][0] = 1;\n            Queue<Tuple> pq = new LinkedList<Tuple>();\n            pq.add(new Tuple(0, 0, 0, 0));\n            while (pq.size() > 0) {\n                Tuple curr = pq.poll();\n                int x = curr.x;\n                int y = curr.y;\n                int z = curr.z;\n                long d = dist[x][y][z];\n                if (z == 0) {\n                    int rem_x = cnt1 - x;\n                    int rem_y = cnt2 - y;\n                    for (i = 0; i <= rem_x; i++) {\n                        for (j = 0; j <= rem_y; j++) {\n                            if (i + j == 0)\n                                continue;\n                            if (i * 50 + j * 100 > K)\n                                break;\n                            if (dist[i + x][j + y][z ^ 1] >= d + 1) {\n                                if (dist[i + x][j + y][z ^ 1] > d + 1) {\n                                    dist[i + x][j + y][z ^ 1] = d + 1;\n                                    pq.add(new Tuple(dist[i + x][j + y][z ^ 1], i + x, j + y, z ^ 1));\n                                    dp[i + x][j + y][z ^ 1] += f(dp[x][y][z], rem_x, i, rem_y, j);\n                                    dp[i + x][j + y][z ^ 1] %= mod;\n                                } else {\n                                    dp[i + x][j + y][z ^ 1] += f(dp[x][y][z], rem_x, i, rem_y, j);\n                                    dp[i + x][j + y][z ^ 1] %= mod;\n                                }\n                            }\n                        }\n                    }\n                } else {\n                    int rem_x = x;\n                    int rem_y = y;\n                    for (i = 0; i <= rem_x; i++) {\n                        for (j = 0; j <= rem_y; j++) {\n                            if (i + j == 0)\n                                continue;\n                            if (i * 50 + j * 100 > K)\n                                break;\n                            if (dist[x - i][y - j][z ^ 1] >= d + 1) {\n                                if (dist[x - i][y - j][z ^ 1] > d + 1) {\n                                    dist[x - i][y - j][z ^ 1] = d + 1;\n                                    pq.add(new Tuple(dist[x - i][y - j][z ^ 1], x - i, y - j, z ^ 1));\n                                    dp[x - i][y - j][z ^ 1] += f(dp[x][y][z], rem_x, i, rem_y, j);\n                                    dp[x - i][y - j][z ^ 1] %= mod;\n                                } else {\n                                    dp[x - i][y - j][z ^ 1] += f(dp[x][y][z], rem_x, i, rem_y, j);\n                                    dp[x - i][y - j][z ^ 1] %= mod;\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n            if (dist[cnt1][cnt2][1] == INF)\n                pn(-1);\n            else\n                pn(dist[cnt1][cnt2][1]);\n            pn(dp[cnt1][cnt2][1]);\n        }\n\n        int ni() {\n            return in.nextInt();\n        }\n\n        void pn(long zx) {\n            out.println(zx);\n        }\n\n        class Tuple {\n            long d;\n            int x;\n            int y;\n            int z;\n\n            Tuple(long d, int x, int y, int z) {\n                this.d = d;\n                this.x = x;\n                this.y = y;\n                this.z = z;\n            }\n\n        }\n\n    }\n\n    static class InputReader {\n        private InputStream stream;\n        private byte[] buf = new byte[1024];\n        private int curChar;\n        private int numChars;\n\n        public InputReader(InputStream stream) {\n            this.stream = stream;\n        }\n\n        public int read() {\n            if (numChars == -1) {\n                throw new UnknownError();\n            }\n            if (curChar >= numChars) {\n                curChar = 0;\n                try {\n                    numChars = stream.read(buf);\n                } catch (IOException e) {\n                    throw new UnknownError();\n                }\n                if (numChars <= 0) {\n                    return -1;\n                }\n            }\n            return buf[curChar++];\n        }\n\n        public int nextInt() {\n            return Integer.parseInt(next());\n        }\n\n        public String next() {\n            int c = read();\n            while (isSpaceChar(c)) {\n                c = read();\n            }\n            StringBuffer res = new StringBuffer();\n            do {\n                res.appendCodePoint(c);\n                c = read();\n            } while (!isSpaceChar(c));\n\n            return res.toString();\n        }\n\n        private boolean isSpaceChar(int c) {\n            return c == ' ' || c == '\\n' || c == '\\r' || c == '\\t' || c == -1;\n        }\n\n    }\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nfrom collections import deque\n\nMOD = 1000000007\nINF = 10**18 + 1\n\n# precompute nCr up to 100\nnCr = [[0] * 100 for _ in range(100)]\nfor i in range(100):\n    for j in range(i + 1):\n        if j == 0 or j == i:\n            nCr[i][j] = 1\n        else:\n            nCr[i][j] = (nCr[i-1][j] + nCr[i-1][j-1]) % MOD\n\ndef f(p, a, b, c, d):\n    p = (p * nCr[a][b]) % MOD\n    p = (p * nCr[c][d]) % MOD\n    return p\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    n = data[0]\n    K = data[1]\n    weights = data[2:2+n]\n    cnt1 = 0\n    cnt2 = 0\n    for w in weights:\n        if w == 50:\n            cnt1 += 1\n        else:\n            cnt2 += 1\n\n    # dist[x][y][z] and dp[x][y][z]: x of 50, y of 100 crossed, boat side z (0 left, 1 right)\n    dist = [[[INF]*2 for _ in range(200)] for _ in range(200)]\n    dp = [[[0]*2 for _ in range(200)] for _ in range(200)]\n    dist[0][0][0] = 0\n    dp[0][0][0] = 1\n\n    q = deque()\n    q.append((0, 0, 0, 0))  # d, x, y, z\n\n    while q:\n        d, x, y, z = q.popleft()\n        if d != dist[x][y][z]:\n            continue\n        if z == 0:\n            # boat on left, move people to right\n            rem_x = cnt1 - x\n            rem_y = cnt2 - y\n            for i in range(rem_x + 1):\n                for j in range(rem_y + 1):\n                    if i + j == 0:\n                        continue\n                    if i * 50 + j * 100 > K:\n                        break\n                    nx = x + i\n                    ny = y + j\n                    nz = 1\n                    nd = d + 1\n                    if dist[nx][ny][nz] >= nd:\n                        if dist[nx][ny][nz] > nd:\n                            dist[nx][ny][nz] = nd\n                            q.append((nd, nx, ny, nz))\n                            dp[nx][ny][nz] = f(dp[x][y][z], rem_x, i, rem_y, j) % MOD\n                        else:\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + f(dp[x][y][z], rem_x, i, rem_y, j)) % MOD\n        else:\n            # boat on right, move people back to left\n            rem_x = x\n            rem_y = y\n            for i in range(rem_x + 1):\n                for j in range(rem_y + 1):\n                    if i + j == 0:\n                        continue\n                    if i * 50 + j * 100 > K:\n                        break\n                    nx = x - i\n                    ny = y - j\n                    nz = 0\n                    nd = d + 1\n                    if dist[nx][ny][nz] >= nd:\n                        if dist[nx][ny][nz] > nd:\n                            dist[nx][ny][nz] = nd\n                            q.append((nd, nx, ny, nz))\n                            dp[nx][ny][nz] = f(dp[x][y][z], rem_x, i, rem_y, j) % MOD\n                        else:\n                            dp[nx][ny][nz] = (dp[nx][ny][nz] + f(dp[x][y][z], rem_x, i, rem_y, j)) % MOD\n\n    if dist[cnt1][cnt2][1] == INF:\n        print(-1)\n    else:\n        print(dist[cnt1][cnt2][1])\n    print(dp[cnt1][cnt2][1] % MOD)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-1.2993727978027891e-05, -1.1920928244535389e-07, -1.1920928244535389e-07, -0.00017617580306250602, -0.004170055501163006, -1.4305012882687151e-05, -8.201262971851975e-05, -0.0015325717395171523, -5.483612312673358e-06, -1.1920922133867862e-06, -4.0531076592742465e-06, -0.0004338276921771467, -0.5176244974136353, -5.960462772236497e-07, -2.3841855067985307e-07, -2.90866428258596e-05, -2.3841855067985307e-07, -7.152555099310121e-07, -1.1920928244535389e-07, -4.529942543740617e-06, -5.960462772236497e-07, -3.4570634852570947e-06, -0.000773369160015136, -3.8742269680369645e-05, -0.023246610537171364, -3.099436753473128e-06, -5.245195097813848e-06, -2.3