nt from, int to, int flow) {\n        int pathFlow = INT_MAX;\n        for (int cur = to; cur != from; cur = p[cur]) {\n            pathFlow = min(pathFlow, res[p[cur]][cur]);\n        }\n        int pathCost = 0;\n        for (; to != from; to = p[to]) {\n            res[p[to]][to] -= pathFlow;\n            res[to][p[to]] += pathFlow;\n            pathCost += cost[p[to]][to] * pathFlow;\n        }\n        return {pathFlow, pathCost};\n    }\n\npublic:\n    pair<int,int> getMinCostMaxFlow() {\n        int flow = 0;\n        int totalCost = 0;\n        while (findCheapestPath()) {\n            auto result = augmentPath(src, sink, INT_MAX);\n            flow += result.first;\n            totalCost += result.second;\n        }\n        return {flow, totalCost};\n    }\n};\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    string s;\n    cin >> n >> s;\n    vector<int> b(n);\n    for (int i = 0; i < n; ++i) {\n        cin >> b[i];\n    }\n\n    vector<int> letCount(letters, 0);\n    for (char c : s) {\n        letCount[c - 'a']++;\n    }\n\n    int source = 0;\n    int charOffSet = 1;\n    int pairOffSet = charOffSet + letters;\n    int sinkOffSet = pairOffSet + n / 2;\n    int sink = sinkOffSet;\n    int vNum = sinkOffSet + 1;\n\n    Graph g(vNum, source, sink);\n\n    // Source -> Letters\n    for (int i = 0; i < letters; ++i) {\n        g.addEdge(source, charOffSet + i, letCount[i], 0);\n    }\n\n    // Letters -> Pairs\n    for (int i = 0; i < letters; ++i) {\n        for (int j = 0; j < n / 2; ++j) {\n            char c1 = s[j];\n            char c2 = s[n - j - 1];\n            if (c1 == 'a' + i) {\n                if (c1 == c2) {\n                    g.addEdge(charOffSet + i, pairOffSet + j,\n                              1, -max(b[j], b[n - j - 1]));\n                } else {\n                    g.addEdge(charOffSet + i, pairOffSet + j,\n                              1, -b[j]);\n                }\n            } else