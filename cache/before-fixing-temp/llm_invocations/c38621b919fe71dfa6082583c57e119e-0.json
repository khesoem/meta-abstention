r\n        return res\r\n    invnum_INF=(N*(N-1))//2\r\n    if k<-invnum_INF-1:\r\n        res=solve(N,-invnum_INF-1,flag)\r\n        memo[N][flag][k]=res\r\n        return res\r\n    if k>=invnum_INF:\r\n        memo[N][flag][k]=0\r\n        return 0\r\n    res=0\r\n\r\n    for delta in range(-N+1,N):\r\n        if flag and (delta>0):\r\n            continue\r\n        wt=min(N-delta,delta+N)\r\n        res+=solve(N-1,k-delta,(delta==0)&flag)*wt\r\n        res%=mod\r\n    memo[N][flag][k]=res%mod\r\n    return res%mod\r\nans=solve(n,0,1)%mod\r\nprint(ans)\r\n\r\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.*;\nimport java.util.stream.*;\n\npublic class Main {\n    static int n, mod;\n    static Map<Long, Integer>[][] memo;\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        mod = sc.nextInt();\n        memo = new HashMap[n+1][2];\n        for (int i = 0; i <= n; i++) {\n            memo[i][0] = new HashMap<>();\n            memo[i][1] = new HashMap<>();\n        }\n        int ans = solve(n, 0, 1) % mod;\n        System.out.println(ans);\n        sc.close();\n    }\n    \n    static int invnum(int[] seq) {\n        int N = seq.length;\n        int res = 0;\n        for (int i = 0; i < N; i++) {\n            for (int j = i+1; j < N; j++) {\n                if (seq[i] > seq[j]) {\n                    res++;\n                }\n            }\n        }\n        return res;\n    }\n    \n    static int naive(int N, int k, boolean flag) {\n        int res = 0;\n        int[] perm = IntStream.range(0, N).toArray();\n        List<int[]> perms = new ArrayList<>();\n        permutation(perm, 0, perms);\n        for (int[] p : perms) {\n            for (int[] q : perms) {\n                boolean condition = (comparePerm(p, q) < 0) || !flag;\n                if (condition && (invnum(p) - invnum(q) > k)) {\n                    res++;\n                }\n            }\n        }\n        return res;\n    }\n    \n    static boolean nextPermutation(int[] arr) {\n        int i = arr.length - 2;\n        while (i >= 0 && arr[i] >= arr[i+1]) i--;\n        if (i < 0) return false;\n        int j = arr.length - 1;\n        while (arr[j] <= arr[i]) j--;\n        swap(arr, i, j);\n        reverse(arr, i+1, arr.length-1);\n        return true;\n    }\n    \n    static void swap(int[] arr, int i, int j) {\n        int tmp = arr[i];\n        arr[i] = arr[j];\n        arr[j] = tmp;\n    }\n    \n    static void reverse(int[] arr, int l, int r) {\n        while (l < r) {\n            swap(arr, l, r);\n            l++;\n            r--;\n        }\n    }\n    \n    static int comparePerm(int[] a, int[] b) {\n        for (int i = 0; i < a.length; i++) {\n            if (a[i] != b[i]) return a[i] - b[i];\n        }\n        return 0;\n    }\n    \n    static void permutation(int[] arr, int start, List<int[]> result) {\n        if (start == arr.length) {\n            result.add(arr.clone());\n            return;\n        }\n        for (int i = start; i < arr.length; i++) {\n            swap(arr, start, i);\n            permutation(arr, start+1, result);\n            swap(arr, start, i);\n        }\n    }\n    \n    static int solve(int N, int k, int flag) {\n        Long key = (long)k;\n        if (memo[N][flag].containsKey(key)) {\n            return memo[N][flag].get(key);\n        }\n        if (N == 1) {\n            int res;\n            if (flag == 1) {\n                res = 0;\n            } else {\n                if (k < 0) {\n                    res = 1;\n                } else {\n                    res = 0;\n                }\n            }\n            memo[N][flag].put(key, res);\n            return res;\n        }\n        int invnum_INF = N * (N-1) / 2;\n        if (k < -invnum_INF - 1) {\n            int res = solve(N, -invnum_INF - 1, flag);\n            memo[N][flag].put(key, res);\n            return res;\n        }\n        if (k >= invnum_INF) {\n            memo[N][flag].put(key, 0);\n            return 0;\n        }\n        long res = 0;\n        for (int delta = -N+1; delta < N; delta++) {\n            if (flag == 1 && delta > 0) continue;\n            int wt = Math.min(N - delta, delta + N);\n            res += (long)solve(N-1, k-delta, (delta == 0 && flag == 1) ? 1 : 0) * wt;\n            res %= mod;\n        }\n        memo[N][flag].put(key, (int)(res % mod));\n        return (int)(res % mod);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-7.152555e-07, 0.0, 0.0, -0.00022075123, -0.00016950125, -2.3841855e-07, -0.014187425, -0.3236101, -0.0015104325, -9.894322e-06, -0.37968412, -0.13171263, -0.12725675, -2.8132996e-05, 0.0, -0.00034421717, -0.0024802894, -0.0007130941, -0.030051462, -0.040458083, -0.5898665, -0.029762104, -3.004029e-05, -5.7576428e-05, -7.986991e-06, -0.00016914368, -0.41150907, -0.00087092136, -1.1920928e-07, -0.062329013, -0.03804153, -0.039810818, -1.7881378e-06, -1.5037777, -0.16028036, -1.0132739e-05, -0.39187247, 0.0, -0.0026383137, -4.7683704e-07, -1.1920928e-07, -2.0265559e-06, -1.6689287e-06, -4.1723165e-06, -0.00030214989, -1.1920928e-07, -3.325884e-05, -0.0010224121, -1.1920928e-07, 0.0, -4.7683704e-07, -2.3841855e-07, 0.0, -1.6689287e-06, -3.576278e-07, -0.004095976, 0.0, -7.867782e-06, -2.3841855e-07, -7.986991e-06, -1.1920928e-07, -4.7683704e-07, -1.1920928e-07, -8.344647e-07, -5.960463e-07, -1.800044e-05, -0.4741019, -0.06589931, 0.0, -0.00020346955, -0.16083135, -0.00026163016, -0.12692983, -4.8278598e-05, -1.1920928e-07, -7.0333235e-06, -4.6371337e-05, -7.0333235e-06, -8.344616e-06, -0.0019287332, 0.0, -2.1576649e-05, -0.00020358874, -2.3841855e-07, -0.00015877417, -3.576278e-07, 0.0, -1.1444026e-05, 0.0, -3.576278e-07, -7.867782e-06, -9.298281e-06, -1.7881378e-06, -7.748574e-06, -0.100229874,