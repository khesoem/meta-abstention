          self.vis[self.v[i]] = True\n                        q.append(self.v[i])\n                i = self.nxt[i]\n        return self.dis[t] != -1\n\n    def dfs(self, pos, flow):\n        if pos == self.t:\n            return flow\n        self.vis[pos] = True\n        tmp = flow\n        i = self.cur[pos] if self.cur[pos] != -1 else self.head[pos]\n        while i != -1:\n            if not self.vis[self.v[i]] and self.w[i] != 0 and self.dis[self.v[i]] == self.dis[pos] + self.c[i]:\n                self.cur[pos] = i\n                fl = self.dfs(self.v[i], min(flow, self.w[i]))\n                self.cost += fl * self.c[i]\n                self.w[i] -= fl\n                self.w[i ^ 1] += fl\n                flow -= fl\n                if flow == 0:\n                    break\n            i = self.nxt[i]\n        return tmp - flow\n\n    def dinic(self, s, t):\n        self.cost = 0\n        self.t = t\n        while self.spfa(s, t):\n            self.cur = [-1] * (self.N + 1)\n            self.dfs(s, 10**18)\n        return self.cost\n\n\ndef main():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it))\n    m = int(next(it))\n    kk = int(next(it))\n    c = int(next(it))\n    d = int(next(it))\n    a = [int(next(it)) for _ in range(kk)]\n\n    max_node = n * 100 + 1\n    g = FlowGraph(max_node)\n    s = 0\n    t = max_node\n\n    # source to initial positions\n    for i in range(1, kk + 1):\n        g.add_edge(s, (a[i - 1] - 1) * 100 + 1, 1, 0)\n\n    # time progression edges for buildings 2..n\n    for i in range(2, n + 1):\n        for j in range(1, 100):\n            u = (i - 1) * 100 + j\n            v = (i - 1) * 100 + j + 1\n            g.add_edge(u, v, 10**18, c)\n\n    # movement edges between buildings\n    for _ in range(m):\n        t1 = int(next(it))\n        t2 = int(next(it))\n        for i in range(1, 100):\n            for j in range(1, kk + 1):\n                val = c + d * (j * j - (j - 1) * (j - 1))\n                u1 = (t1 - 1) * 100 + i\n                u2 = (t2 - 1) * 100 + i + 1\n                v1 = (t2 - 1) * 100 + i\n                v2 = (t1 - 1) * 100 + i + 1\n                g.add_edge(u1, u2, 1, val)\n                g.add_edge(v1, v2, 1, val)\n\n    # sink edges from building\u202f1 time nodes\n    for i in range(1, 101):\n        g.add_edge(i, t, 10**18, 0)\n\n    result = g.dinic(s, t)\n    print(result)\n\n\nif __name__ == \"__main__\":\n    sys.setrecursionlimit(1000000)\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0009341643890365958, 0.0, -5.960462772236497e-07, -0.0005818104837089777, -0.011159741319715977, -1.1920928244535389e-07, -8.284702198579907e-05, -0.009041675366461277, -2.3841855067985307e-07, -1.1920928244535389e-07, -7.152555099310121e-07, -0.03809385746717453, -0.05106714740395546, -4.768370445162873e-07, -1.1920928244535389e-07, -1.0490362910786644e-05, -5.960446742392378e-06, -0.00017998983094003052, -2.3841855067985307e-07, 0.0, -2.3841855067985307e-07, 0.0, -7.152555099310121e-07, -0.002214719308540225, -0.004099537618458271, -5.221230458118953e-05, -1.1920928244535389e-07, -4.2437604861333966e-05, -0.0001879753835964948, -4.768370445162873e-07, -1.1920928244535389e-07, 0.0, -0.011389121413230896, 0.0, -6.002476215362549, -0.19306915998458862, -2.716179132461548, -0.2810632586479187, -0.030134400352835655, -0.06223245710134506, -1.1086402082582936e-05, -0.16027426719665527, -3.177720069885254, -0.7024398446083069, -0.022737741470336914, -0.000705470098182559, -1.128161907196045, 0.0, -3.4927710657939315e-05, -3.576278118089249e-07, -2.145764938177308e-06, -1.0490362910786644e-05, 0.0, -3.576278118089249e-07, -6.437280717364047e-06, -3.6954811548639555e-06, -0.0005536930402740836, 0.0, -2.9802276912960224e-06, -1.1920928244535389e-07, -0.000271521887043491, -0.00408101687207818, -2.3841855067985307e-07, -0.018152419477701187, -0.20264138281345367, -0.0007332258974201977, -1.5735502529423684e-05, 