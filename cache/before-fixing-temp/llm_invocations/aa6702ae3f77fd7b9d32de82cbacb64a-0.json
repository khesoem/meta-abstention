  this.n = n;\n        g = new List[n];\n        for (int i = 0; i < n; i++) {\n            g[i] = new ArrayList<>();\n        }\n        pos = new int[0];\n    }\n\n    public int addEdge(int from, int to, int cap, int cost) {\n        int m = pos.length;\n        pos = Arrays.copyOf(pos, pos.length + 1);\n        pos[pos.length - 1] = new int[]{from, g[from].size()};\n        g[from].add(new Edge(to, g[to].size(), cap, 0, cost, g[to].size()));\n        g[to].add(new Edge(from, g[from].size() - 1, 0, 0, -cost, g[from].size() - 1));\n        return m;\n    }\n\n    public Edge getEdge(int i) {\n        int[] p = pos[i];\n        Edge e = g[p[0]].get(p[1]);\n        Edge re = g[e.to].get(e.rev);\n        return new Edge(p[0], e.to, e.cap + re.cap, re.cap, e.cost, e.rev);\n    }\n\n    public List<Edge> edges() {\n        List<Edge> ret = new ArrayList<>();\n        for (int i = 0; i < pos.length; i++) {\n            Edge e = getEdge(i);\n            Edge re = g[e.to].get(e.rev);\n            ret.add(new Edge(pos[i][0], e.to, e.cap + re.cap, re.cap, e.cost, e.rev));\n        }\n        return ret;\n    }\n\n    public boolean dualRef(int s, int t) {\n        int[] dist = new int[n];\n        int[] pv = new int[n];\n        int[] pe = new int[n];\n        boolean[] vis = new boolean[n];\n\n        PriorityQueue<int[]> que = new PriorityQueue<>((a, b) -> a[0] - b[0]);\n        dist[s] = 0;\n        que.add(new int[]{0, s});\n        while (!que.isEmpty()) {\n            int[] v = que.poll();\n            int idx = v[1] & 0xFFFFFFFF;\n            if (vis[idx]) {\n                continue;\n            }\n            vis[idx] = true;\n            if (idx == t) {\n                break;\n            }\n            for (int i = 0; i < g[idx].size(); i++) {\n                Edge e = g[idx].get(i);\n                if (vis[e.to] || e.cap == 0) {\n                    continue;\n                }\n                int cost = e.cost - dual[idx] + dual[v[1] >> 32];\n              