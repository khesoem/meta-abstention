l=nxt(val,n);\n\t}\n\tNTH=nth;\n\treturn ans;\n}\nint main(){\n#ifndef ONLINE_JUDGE\n\tfreopen(\"in.in\",\"r\",stdin);\n\tfreopen(\"out.out\",\"w\",stdout);\n#endif\n\tpre();\n\t\n\tINT n;\n\tcin>>n;\n\tif(n<10000000){\n\t\tINT ans=0;\n\t\tINT val=1;\n\t\tfor(int i=1;i<=n;i++){\n\t\t\tans=(ans+D(i,val))%mod2;\n\t\t\tif(i==n) break;\n\t\t\tval=nxt(val,n);\n\t\t}\n\t\tcout<<ans<<endl;\n\t\treturn 0;\n\t}\n\t\n\tINT ans=0;\n\tINT val=1,nth=1;\n\tint N=n/1000000;\n\twhile(1){\n\t\tans=(ans+D(nth,val))%mod2;\n\t\tnth++;\n\t\tif(L[val]==L[N]){\n\t\t\tif(val==N){\n\t\t\t\tans=(ans+calc(val*10,nth,n))%mod2;\n\t\t\t\tnth=NTH;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tINT v=val;\n\t\t\tfor(int i=1;i<7;i++){\n\t\t\t\tv*=10;\n\t\t\t\tINT del=D(nth-1,v);\n\t\t\t\tint N=lower_bound(s[i].begin(),s[i].end(),mod1-del)-s[i].begin();\n\t\t\t\tN=N-s[i].size();\n\t\t\t\tans=(ans+sum[i]+1LL*N*mod1%mod2)%mod2;\n\t\t\t\tans=(ans+mod2)%mod2;\n\t\t\t\tans=(ans+del*s[i].size()%mod2)%mod2;\n\t\t\t}\n\t\t\tnth+=1111110;\n\t\t}\n\t\tval=nxt(val,N);\n\t}\n\t\n\tn=1;\n\tfor(int i=1;i<L[N]+6;i++) n*=10;\n\tn--;\n\tN=n/1000000;\n\t\n\tval/=10;\n\tval++;\n\twhile(val%10==0) val/=10;\n\t\n\twhile(val!=1){\n\t\tans=(ans+D(nth,val))%mod2;\n\t\tnth++;\n\t\tif(L[val]==L[N]){\n\t\t\tINT v=val;\n\t\t\tfor(int i=1;i<7;i++){\n\t\t\t\tv*=10;\n\t\t\t\tINT del=D(nth-1,v);\n\t\t\t\tint N=lower_bound(s[i].begin(),s[i].end(),mod1-del)-s[i].begin();\n\t\t\t\tN=N-s[i].size();\n\t\t\t\tans=(ans+sum[i]+1LL*N*mod1%mod2)%mod2;\n\t\t\t\tans=(ans+mod2)%mod2;\n\t\t\t\tans=(ans+del*s[i].size()%mod2)%mod2;\n\t\t\t}\n\t\t\tnth+=1111110;\n\t\t}\n\t\tval=nxt(val,N);\n\t}\n\tcout<<ans<<endl;\n\treturn 0;\n}\n          \n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport bisect\n\nmod1 = 998244353\nmod2 = 1000000007\n\n# D function: (x - y) % mod1\ndef D(x, y):\n    return (x - y) % mod1\n\ndef nxt(val, n):\n    if val * 10 <= n:\n        return val * 10\n    else:\n        val += 1\n        if val <= n:\n            while val % 10 == 0:\n                val //= 10\n        else:\n            val = (val - 1) // 10 + 1\n            while val % 10 == 0:\n                val //= 10\n        return val\n\n# Global arrays\nNN = 1000100\nL = [0] * (NN)  # will be filled up to index 1000000\ns = [[] for _ in range(7)]  # s[1..6] used\nsum_arr = [0] * 7\n\ndef pre():\n    val = 0\n    leng = 1\n    nth = 1\n    for i in range(1, 1111111):  # inclusive up to 1111110\n        s[leng].append(D(nth, val))\n        nth += 1\n        if leng < 6:\n            leng += 1\n            val *= 10\n        else:\n            val += 1\n            while val % 10 == 0:\n                val //= 10\n            leng -= 1\n\n    for i in range(1, 7):\n        s[i].sort()\n        for v in s[i]:\n            sum_arr[i] = (sum_arr[i] + v) % mod2\n\n    ed = 1\n    f = 0\n    for i in range(1, 1000001):\n        if i == ed:\n            ed *= 10\n            f += 1\n        L[i] = f\n\n# Global variable to store NTH from calc\nNTH = 0\n\ndef calc(val, nth, n):\n    global NTH\n    ans = 0\n    st = val // 100\n    st += 1\n    while st % 10 == 0:\n        st //= 10\n    while val != st:\n        ans = (ans + D(nth, val)) % mod2\n        nth += 1\n        val = nxt(val, n)\n    NTH = nth\n    return ans\n\ndef main():\n    pre()\n\n    n = int(sys.stdin.readline().strip())\n    if n < 10000000:\n        ans = 0\n        val = 1\n        nth = 1\n        for i in range(1, n + 1):\n            ans = (ans + D(nth, val)) % mod2\n            if i == n:\n                break\n            val = nxt(val, n)\n        print(ans)\n        return\n\n    ans = 0\n    val = 1\n    nth = 1\n    N = n // 1000000\n    while True:\n        ans = (ans + D(nth, val)) % mod2\n        nth += 1\n        if L[val] == L[N]:\n            if val == N:\n                ans = (ans + calc(val * 10, nth, n)) % mod2\n                nth = NTH\n                break\n            v = val\n            for i in range(1, 7):\n                v *= 10\n                delta = D(nth - 1, v)\n                idx = bisect.bisect_left(s[i], mod1 - delta)\n                N_idx = idx - len(s[i])\n                ans = (ans + sum_arr[i] + (N_idx * mod1) % mod2) % mod2\n                ans = (ans + mod2) % mod2\n                ans = (ans + delta * len(s[i]) % mod2) % mod2\n            nth += 1111110\n        val = nxt(val, N)\n\n    # Second part: handle tail\n    n = 1\n    digits = L[N] + 6\n    for _ in range(digits):\n        n *= 10\n    n -= 1\n    N = n // 1000000\n    val //= 10\n    val += 1\n    while val % 10 == 0:\n        val //= 10\n\n    while val != 1:\n        ans = (ans + D(nth, val)) % mod2\n        nth += 1\n        if L[val] == L[N]:\n            v = val\n            for i in range(1, 7):\n                v *= 10\n                delta = D(nth - 1, v)\n                idx = bisect.bisect_left(s[i], mod1 - delta)\n                N_idx = idx - len(s[i])\n                ans = (ans + sum_arr[i] + (N_idx * mod1) % mod2) % mod2\n                ans = (ans + mod2) % mod2\n                ans = (ans + delta * len(s[i]) % mod2) % mod2\n            nth += 1111110\n        val = nxt(val, N)\n\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.98\n</confidence>", "token_logprobs": [-2.634490556374658e-05, 0.0, -1.1920928244535389e-07, -0.0004717191040981561, -0.011994264088571072, -0.018160028383135796, -0.006837778724730015, -0.001211266964673996, -0.00010108436981681734, -3.576278118089249e-07, -0.000940595637075603, -0.11080988496541977, -7.152555099310121e-07, -5.722029527532868e-06, -2.3841855067985307e-07, 0.0, 0.0, -3.576278118089249e-07, -2.3841855067985307e-07, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -2.9802276912960224e-06, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -0.825944185256958