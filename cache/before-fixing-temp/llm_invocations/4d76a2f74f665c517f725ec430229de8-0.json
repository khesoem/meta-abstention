ng) 1e18, best_z = -1;\n    static String s;\n    static int[] cntA, cntB;\n    static HashMap<Long, Long> mp = new HashMap<>();\n\n    static void dfs(long x, long y, int v1, int v2) {\n        long diff = Math.abs(x - y);\n        if (best <= 1 || diff - C[v1][r] * C[v2][r] >= best) {\n            return;\n        }\n        if (v1 == r - 1 && v2 == r - 1) {\n            long d = Math.abs(x - y);\n            if (d < best) {\n                best = d;\n                best_z = x;\n            }\n            return;\n        }\n        if (v1 >= r) {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            dfs(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (v2 >= r) {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v2 - 1][r];\n            dfs(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n    }\n\n    static long solve(long x, long y, int v1, int v2) {\n        long state = x * 10000 + v1 * 100 + v2;\n        if (mp.containsKey(state)) {\n            return mp.get(state);\n        }\n        long res = 0;\n        long diff = Math.abs(x - y);\n        if (diff - C[v1][r] * C[v2][r] > best) {\n            mp.put(state, res);\n            return res;\n        }\n        if (v1 < r || v2 < r) {\n            if (v1 >= cntA[v1 + v2] && v2 >= cntB[v1 + v2]) {\n                int sum = v1 + v2;\n                v1 -= cntA[sum];\n                v2 -= cntB[sum];\n                res = C[v1 + v2][v1];\n                mp.put(state, res);\n                return res;\n            }\n            res = 0;\n            mp.put(state, res);\n            return res;\n        }\n        char c = s.charAt(v1 + v2 - 1);\n        if (c != 'B') {\n            long cur1 = C[v1][r] - C[v1 - 1][r];\n            long sum2 = C[v2][r];\n            res += solve(x, y + cur1 * sum2, v1 - 1, v2);\n        }\n        if (c != 'A') {\n            long sum1 = C[v1][r];\n            long cur2 = C[v2][r] - C[v2 - 1][r];\n            res += solve(x + sum1 * cur2, y, v1, v2 - 1);\n        }\n        mp.put(state, res);\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        r = sc.nextInt();\n        c = sc.nextInt();\n        int maxN = 2 * (r + c);\n        C = new long[maxN + 1][maxN + 1];\n        for (int i = 0; i <= maxN; i++) {\n            for (int j = 0; j <= maxN; j++) {\n                if (j == 0) C[i][j] = 1;\n                else if (i == 0) C[i][j] = 0;\n                else C[i][j] = C[i - 1][j] + C[i - 1][j - 1];\n            }\n        }\n        total = C[r + c][r] * C[r + c][r];\n        {\n            long x = 0, y = 0;\n            int v1 = r + c, v2 = r + c;\n            while (v1 >= r && v2 >= r) {\n                if (x > y) {\n                    long cur1 = C[v1][r] - C[v1 - 1][r];\n                    long sum2 = C[v2][r];\n                    y += cur1 * sum2;\n                    v1--;\n                } else {\n                    long sum1 = C[v1][r];\n                    long cur2 = C[v2][r] - C[v2 - 1][r];\n                    x += sum1 * cur2;\n                    v2--;\n                }\n            }\n            best = Math.abs(x - y);\n        }\n        dfs(0, 0, r + c, r + c);\n        s = sc.next();\n        cntA = new int[2 * (r + c) + 1];\n        cntB = new int[2 * (r + c) + 1];\n        cntA[0] = cntB[0] = 0;\n        for (int i = 0; i < 2 * (r + c); i++) {\n            cntA[i + 1] = cntA[i] + (s.charAt(i) == 'A' ? 1 : 0);\n            cntB[i + 1] = cntB[i] + (s.charAt(i) == 'B' ? 1 : 0);\n        }\n        long ans = solve(0, 0, r + c, r + c);\n        System.out.println(ans);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.06332939863204956, -1.1920928244535389e-07, 0.0, -1.1920928244535389e-07, -0.00020466140995267779, -0.00016699827392585576, -1.1920928244535389e-07, -5.018585216021165e-05, -0.004639456