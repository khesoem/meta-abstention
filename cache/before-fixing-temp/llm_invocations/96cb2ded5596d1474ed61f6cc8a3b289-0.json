t j = 0; j < bin[tot]; j++)\n                if ((j & bin[i]) != 0) g[j] = (g[j] + g[j ^ bin[i]]) % MOD;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        init(sc);\n        a[1] = 1; a[2] = 2; a[3] = 3;\n        dfs1(1,0,0);\n        Arrays.fill(pts, 0);\n        a[1] = 4; a[2] = 5; a[3] = 6;\n        dfs2(1, 1, 1);\n        for (int i=0; i<bin[tot]; i++) {\n            int t=0;\n            for (int j=1;j<=tot;j++) {\n                int rev=id[bin[n]-1 -sta[j]];\n                if ((i & bin[j - 1]) != 0) t+=bin[rev - 1];\n            }\n            g[t] = f[i]; f[i]=0;\n        }\n        a[1]=4; a[2]=5; a[3]=6;\n        dfs2(1, 1, 1);\n        pre();\n        long ans = 0;\n        for (int i=0; i<bin[tot]; i++) {\n            ans = (ans + (f[i] * g[bin[tot]-1 - i]) % MOD) % MOD;\n        }\n        System.out.println((long)((1 - ans + MOD) % MOD));\n    }\n}\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-0.0005648265941999853, -7.541112427134067e-05, -7.896309739408025e-07, -0.0001593195047462359, -4.127333340875339e-06, 0.0, -0.000667640648316592, -2.7807555198669434, -0.014425676316022873, -0.00014060820103622973, -1.058103322982788, -0.693446934223175, -4.191489642835222e-05, -4.320199877838604e-07, -0.0033433556091040373, -0.0789862871170044, -0.0070488909259438515, -0.0017067246371880174, -0.0027547108475118876, -0.003604224883019924, -0.00033546582562848926, -0.06200074777007103, -0.0009125363430939615, -9.014684110297821e-06, -0.0006155780283734202, -3.650518920039758e-06, -1.981667537620524e-06, -0.00012558852904476225, -1.9361264946837764e-07, -1.0280383548888494e-06, -8.804671233519912e-05, -5.848420551046729e-05, -2.1008713702030946e-06, -2.951771421066951e-05, -4.320199877838604e-07, -1.1875571544806007e-05, -4.0126840758603066e-05, -0.0059290360659360886, -4.127333340875339e-06, -4.215330409351736e-05, -1.5048530030981055e-06, -0.00038801267510280013, -0.0001