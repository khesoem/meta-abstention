;\n\t\t\t\t\tcnt = 0;\n\t\t\t\t}\n\t\t\t\tif (j == 0) break;\n\t\t\t}\n\t\t\tres %= MOD;\n\t\t}\n\t}\n\tint ans = 0;\n\tfor (int i = 0; i <= K; ++ i) (ans += 1LL * f[n] * dp[i][n] % MOD * permute(K, i) % MOD) %= MOD;\n\tprintf(\"%d\\n\", (mpow(K, n) + MOD - ans) % MOD);\n}\n\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nMOD = 1\nimport sys\nsys.setrecursionlimit(10**7)\ninput = sys.stdin.read\n\ndef mpow(x, n):\n    res = 1\n    while n:\n        if n & 1:\n            res = res * x % MOD\n        x = x * x % MOD\n        n >>= 1\n    return res\n\n# Read input\ndata = list(map(int, input().split()))\nn = data[0]\nK = data[1]\nMOD = data[2]\n\nN = 300005\n\n# Initialize factorial and inverse factorial arrays\nf = [1] * (n + 1)\nfor i in range(1, n + 1):\n    f[i] = f[i - 1] * i % MOD\n\nrf = [1] * (n + 1)\ndef modinv(x):\n    return mpow(x, MOD - 2)\n\nrf[n] = modinv(f[n])\nfor i in range(n - 1, -1, -1):\n    rf[i] = rf[i + 1] * (i + 1) % MOD\n\n# Function for permutation\ndef permute(n, m):\n    return f[n] * rf[n - m] % MOD\n\n# Initialize DP array\ndp = [[0] * (N) for _ in range(27)]\ndp[0][0] = 1\n\nif n & 1:\n    print(mpow(K, n))\n    sys.exit(0)\n\nfor k in range(K):\n    for i in range(1, n + 1):\n        if (i & n) != i:\n            continue\n        cnt = 0\n        res = 0\n        # compute highest bit\n        hb = 1 << (31 - (i.bit_length() - 1))\n        j = i - hb\n        while j >= 0:\n            jj = j + hb\n            res += dp[k][i ^ jj] * rf[jj]\n            if cnt == 17:\n                res %= MOD\n                cnt = 0\n            cnt += 1\n            if j == 0:\n                break\n            j = (j - 1) & i\n        dp[k + 1][i] = res % MOD\n\nans = 0\nfor i in range(K + 1):\n    ans += f[n] * dp[i][n] % MOD * permute(K, i) % MOD\n    ans %= MOD\n\nresult = (mpow(K, n) + MOD - ans) % MOD\nprint(result)\n</translat