ong long solve(const vector<char>& str, int n) {\n    if (n == 1 || str[0] == '0') return 0;\n    long long cnt = 0;\n    int un = 0;\n    for (int i = 1; i < n - 2; i++) if (str[i] == '_') ++un;\n\n    cnt += cal(str, \"25\", n, un);\n    cnt += cal(str, \"50\", n, un);\n    cnt += cal(str, \"75\", n, un);\n    if (n > 2 && str[0] == '_') cnt *= 9;\n\n    if (n >= 3) {\n        if ((str[n - 1] == '_' || str[n - 1] == '0') && (str[n - 2] == '_' || str[n - 2] == '0')) {\n            if (n > 3) {\n                long long temp = std::pow(10, un);\n                if (str[0] == '_') temp *= 9;\n                cnt += temp;\n            } else if (n == 3) {\n                if (str[0] == '_') {\n                    cnt += 9;\n                } else {\n                    cnt += 1;\n                }\n            }\n        }\n    }\n    return cnt;\n}\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int test = 1;\n    // Since original code has a loop over test, but test is set to 1\n    while (test-- > 0) {\n        string line;\n        getline(cin, line);\n        vector<char> str(line.begin(), line.end());\n        int n = str.size();\n\n        long long cnt = 0;\n        bool Xp = false;\n        for (int i = 0; i < n; i++) if (str[i] == 'X') Xp = true;\n\n        if (n == 1) {\n            if (str[0] == '0' || str[0] == '_' || str[0] == 'X' || str[0] == '1') {\n                cout << 1 << \"\\n\";\n                continue;\n            }\n        }\n\n        if (Xp) {\n            for (char ch = '0'; ch <= '9'; ch++) {\n                vector<char> gs = generateStrings(str, n, ch);\n                cnt += solve(gs, n);\n            }\n        } else {\n            cnt += solve(str, n);\n        }\n        cout << cnt << \"\\n\";\n    }\n    return 0;\n}\n\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.007058592047542334, -6.778209353797138e-05, -0.029751179739832878, -7.941850526549388e-06, -5.438573680294212e-06, -0.000