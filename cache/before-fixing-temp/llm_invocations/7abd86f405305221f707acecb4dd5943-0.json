turn x + (k - 1) * n;\n    }\n\n    static void add(int from, int to, int val, int cost) {\n        e[++edge_cnt] = new Edge(to, head[from], val, cost);\n        head[from] = edge_cnt;\n        e[++edge_cnt] = new Edge(from, head[to], 0, -cost);\n        head[to] = edge_cnt;\n    }\n\n    static boolean spfa() {\n        Queue<Integer> q = new LinkedList<>();\n        for (int i = s; i <= t; ++i) {\n            dis[i] = inf;\n            vis[i] = false;\n        }\n        q.add(s);\n        dis[s] = 0;\n        vis[s] = true;\n        while (!q.isEmpty()) {\n            int x = q.poll();\n            vis[x] = false;\n            for (int i = head[x]; i != 0; i = e[i].nxt) {\n                int y = e[i].to;\n                int c = e[i].c;\n                if (dis[y] <= dis[x] + c || e[i].v == 0) continue;\n                dis[y] = dis[x] + c;\n                if (!vis[y]) {\n                    vis[y] = true;\n                    q.add(y);\n                }\n            }\n        }\n        return dis[t] != inf;\n    }\n\n    static int dfs(int x, int lim) {\n        if (x == t) return lim;\n        vis[x] = true;\n        int res = lim;\n        for (int i = head[x]; i != 0; i = e[i].nxt) {\n            int y = e[i].to;\n            int v = e[i].v;\n            if (dis[y] != dis[x] + e[i].c || v == 0 || vis[y]) continue;\n            int flow = dfs(y, Math.min(res, v));\n            if (flow > 0) {\n                e[i].v -= flow;\n                e[(i ^ 1)].v += flow;\n                res -= flow;\n                if (res == 0) break;\n            }\n        }\n        return lim - res;\n    }\n\n    static int dinic() {\n        int flow, sum = 0;\n        while (spfa()) {\n            while ((flow = dfs(s, inf)) > 0) {\n                sum += flow * dis[t];\n            }\n        }\n        return sum;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        n = sc.nextInt();\n        m = sc.nextInt();\n 