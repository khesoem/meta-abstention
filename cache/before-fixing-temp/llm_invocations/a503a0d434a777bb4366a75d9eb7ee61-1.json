 < min(0LL + bit[n], m); i++) {\n        for (int j = 0; j < n; j++) {\n            if (!dp[i][j]) continue;\n            int x = n ^ j;\n            for (int k = x, r; k > j; k = (k - 1) & x) {\n                r = k | j;\n                add(dp[i + 1][r], dp[i][j] * inv[k]); \n            }\n        }\n    }\n    for (int i = 1; i <= m; i++) \n        ans -= dp[i][n] * fac[m] % mod * inv[m - i] % mod * fac[n] % mod;\n    ans = (mod + ans % mod) % mod;\n    cout << ans << endl;\n    return 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef solve() -> None:\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n    mod = int(data[2])\n    \n    # factorials and inverse factorials up to n\n    fac = [1] * (n + 1)\n    inv = [1] * (n + 1)\n    # inv[0] and inv[1] are 1\n    for i in range(2, n + 1):\n        r = mod // i\n        x = mod - i * r\n        fac[i] = fac[i - 1] * i % mod\n        inv[i] = (mod - r * inv[x]) % mod\n    for i in range(2, n + 1):\n        inv[i] = inv[i - 1] * inv[i] % mod\n    \n    # ans = m^n mod mod\n    ans = pow(m, n, mod)\n    \n    # bit count of n\n    bit_n = bin(n).count('1')\n    \n    # if n is odd, output ans and return\n    if n & 1:\n        print(ans)\n        return\n    \n    # dp[i][j] : i from 0 to bit_n, j from 0 to n\n    max_i = min(bit_n, m)\n    dp = [[0] * (n + 1) for _ in range(max_i + 1)]\n    dp[0][0] = 1\n    \n    for i in range(max_i):\n        for j in range(n):\n            val = dp[i][j]\n            if val == 0:\n                continue\n            x = n ^ j\n            # iterate over non-empty subsets of x that are > j\n            k = x\n            while k > j:\n                r = k | j\n                dp[i + 1][r] = (dp[i + 1][r] + val * inv[k]) % mod\n                k = (k - 1) & x\n    \n    # subtract contributions\n    fac_m = [1] * (m + 1)\n    inv_m = [1] * (m + 1)\n    # we only need fac[m] and inv[m - i] for i=1..m\n    # compute fac up to m\n    for i in range(1, m + 1):\n        fac_m[i] = fac_m[i - 1] * i % mod\n    # compute inv[m] using the same linear method (if mod is prime)\n    # note: we need inv_m for indices up to m\n    inv_m[0] = 1\n    if m > 0:\n        inv_m[1] = 1\n        for i in range(2, m + 1):\n            r = mod // i\n            x = mod - i * r\n            inv_m[i] = (mod - r * inv_m[x]) % mod\n        for i in range(2, m + 1):\n            inv_m[i] = inv_m[i - 1] * inv_m[i] % mod\n    \n    for i in range(1, m + 1):\n        if i <= max_i:\n            term = dp[i][n] * fac_m[m] % mod * inv_m[m - i] % mod * fac[n] % mod\n        else:\n            term = 0\n        ans = (ans - term) % mod\n    \n    ans = ans % mod\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0005557184922508895, 0.0, 0.0, -0.0009704885887913406, -0.037467338144779205, -2.50339189733495e-06, -0.0007278653793036938, -0.002395143499597907, -0.6792128682136536, -0.3133169114589691, -8.583032467868179e-06, -6.198863957251888e-06, -1.1920922133867862e-06, -4.529942543740617e-06, -0.004615843296051025, -1.5497195136049413e-06, -0.0005685858195647597, 0.0, -0.0031928059179335833, -4.768360213347478e-06, -0.01416497677564621, -2.753696753643453e-05, -1.7881377516459906e-06, -7.867782187531702e-06, -1.1920928244535389e-07, -2.0503786799963564e-05, -3.540453326422721e-05, 0.0, -0.00026127262390218675, -3.576278118089249e-07, -7.152555099310121e-07, -1.311301275563892e-06, -1.1920928244535389e-07, -0.0025924190413206816, -0.3135868310928345, 0.0, -2.3841855067985307e-07, 0.0, -1.1920922133867862e-06, -0.011088063940405846, 0.0, -9.536738616588991e-07, -0.005341543350368738, -4.768370445162873e-07, -5.960462772236497e-07, 0.0, -1.1801649634435307e-05, -5.173549288