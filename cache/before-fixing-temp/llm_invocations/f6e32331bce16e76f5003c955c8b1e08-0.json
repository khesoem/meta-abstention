r = 0;\n                for (int k = 0; k <= base; k++) {\n                    if (cur > LIM) cur %= MOD;\n                    cur += (long)A[i][k] * B[k][j];\n                }\n                C[i][j] = (int)(cur % MOD);\n            }\n        }\n    }\n\n    static void mcopy(int[][] A, int[][] B) {\n        for (int i = 0; i <= base; i++) {\n            System.arraycopy(A[i], 0, B[i], 0, base + 1);\n        }\n    }\n\n    static void run() {\n        // Precompute mats[0][start] matrices\n        int maxExp = 0;\n        long step = 1;\n        while (step <= n / base) {\n            maxExp++;\n            step *= base;\n        }\n        // Allocate mats array: maxExp+1 exponents, each with base possible starts, each (base+1)x(base+1)\n        mats = new int[maxExp + 1][base][base + 1][base + 1];\n        // Initialize mats[0][i] : identity except when i==j or j==k -> 1\n        for (int i = 0; i < base; i++) {\n            for (int j = 0; j <= base; j++) {\n                for (int k = 0; k <= base; k++) {\n                    if (i == j || j == k)\n                        mats[0][i][j][k] = 1;\n                    else\n                        mats[0][i][j][k] = 0;\n                }\n            }\n        }\n        // Build higher exponent matrices\n        for (int e = 1; e <= maxExp; e++) {\n            for (int start = 0; start < base; start++) {\n                // Identity matrix\n                int[][] mat = mats[e][start];\n                for (int j = 0; j <= base; j++) {\n                    Arrays.fill(mat[j], 0);\n                    mat[j][j] = 1;\n                }\n                // Multiply by the sequence of base steps (k from 0 to base-1)\n                int[][] temp = new int[base+1][base+1];\n                for (int k = 0; k < base; k++) {\n                    int nextStart = (start + k) % base;\n                    mmult(mat, mats[e-1][nextStart], temp);\n                    mcopy(temp, mat);\n                }\n            }\n  