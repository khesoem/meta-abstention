n        static final int MAXN = 30000;   // max nodes\n        static final int MAXM = 7010010; // max edges (including reverse)\n\n        int[] h = new int[MAXN];      // head for adjacency list\n        boolean[] ing = new boolean[MAXN]; // in queue flag\n        int[] pre = new int[MAXN];    // previous edge in shortest path\n        int[] to = new int[MAXM];\n        int[] ne = new int[MAXM];\n        int[] cap = new int[MAXM];\n        int[] cost = new int[MAXM];\n        int e, s, t, n;\n        int[] dis; // distance array, allocated in run\n\n        void init(int _n) {\n            n = _n;\n            for (int i = 0; i < n; i++) h[i] = -1;\n            e = 0;\n        }\n\n        void liu(int u, int v, int c, int w) {\n            to[e] = v;\n            ne[e] = h[u];\n            cap[e] = c;\n            cost[e] = w;\n            h[u] = e++;\n        }\n\n        void link(int u, int v, int c, int w) {\n            liu(u, v, c, w);\n            liu(v, u, 0, -w);\n        }\n\n        boolean spfa() {\n            Queue<Integer> q = new LinkedList<>();\n            Arrays.fill(dis, 0, n, Integer.MAX_VALUE);\n            q.add(s);\n            ing[s] = true;\n            dis[s] = 0;\n            while (!q.isEmpty()) {\n                int c = q.poll();\n                ing[c] = false;\n                for (int k = h[c]; k != -1; k = ne[k]) {\n                    if (cap[k] > 0) {\n                        int v = to[k];\n                        if (dis[c] + cost[k] < dis[v]) {\n                            dis[v] = dis[c] + cost[k];\n                            pre[v] = k;\n                            if (!ing[v]) {\n                                q.add(v);\n                                ing[v] = true;\n                            }\n                        }\n                    }\n                }\n            }\n            return dis[t] != Integer.MAX_VALUE;\n        }\n\n        int[] run(int _s, int _t) {\n            s = _s;\n            t = _t;\n            int flow = 0;\n            int mincost = 0;\n            dis = new int[n];\n            while (spfa()) {\n                int pl = Integer.MAX_VALUE;\n                for (int p = t; p != s; p = to[pre[p] ^ 1]) {\n                    pl = Math.min(pl, cap[pre[p]]);\n                }\n                for (int p = t; p != s; p = to[pre[p] ^ 1]) {\n                    int k = pre[p];\n                    cap[k] -= pl;\n                    cap[k ^ 1] += pl;\n                }\n                mincost += pl * dis[t];\n                flow += pl;\n            }\n            return new int[]{flow, mincost};\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c = sc.nextInt();\n        int d = sc.nextInt();\n\n        int[] a = new int[k + 1]; // 1-indexed\n        for (int i = 1; i <= k; i++) {\n            a[i] = sc.nextInt();\n        }\n\n        // id[i][j]: i from 1..n, j from 0..mx (mx = 100)\n        int mx = 100;\n        int[][] id = new int[n + 1][mx + 2];\n        int cnt = 0;\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j <= mx; j++) {\n                id[i][j] = ++cnt;\n            }\n        }\n\n        // total nodes = cnt (numbered 1..cnt) + s and t\n        int totalNodes = cnt + 2;\n        MCMF flow = new MCMF();\n        flow.init(totalNodes);\n        int s = totalNodes - 1; // source\n        int t = totalNodes - 2; // sink (note: C++ uses t = s-1, but we use separate)\n\n        // read edges and create time-expanded edges\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 0; j < mx; j++) {\n                for (int h = 1; h <= k; h++) {\n                    int tmp = h * h * d - (h - 1) * (h - 1) * d;\n                    flow.link(id[u][j], id[v][j + 1], 1, c + tmp);\n                    flow.link(id[v][j], id[u][j + 1], 1, c + tmp);\n                }\n            }\n        }\n\n        // stay edges (infinite capacity)\n        for (int i = 1; i <= n; i++) {\n            for (int j = 0; j < mx; j++) {\n                flow.link(id[i][j], id[i][j + 1], Integer.MAX_VALUE, c);\n            }\n        }\n\n        // source to starting positions\n        for (int i = 1; i <= k; i++) {\n            flow.link(s, id[a[i]][0], 1, 0);\n        }\n\n        // sink from node 1 at all times\n        for (int j = 1; j <= mx; j++) {\n            flow.link(id[1][j], t, Integer.MAX_VALUE, 0);\n        }\n\n        int[] result = flow.run(s, t);\n        int mincost = result[1]; // second element is mincost\n        System.out.println(mincost);\n        sc.close();\n    }\n}\n```\n<confidence>0.98</confidence>", "token_logprobs": [-0.3909651041030884, -5.960446742392378e-06, -0.00026425207033753395, -0.00032669928623363376, -4.768370445162873e-07, -9.667406266089529e-05, -0.06055920943617821, -0.0501738041639328, -1.0371154530730564e-05, -0.005799965001642704, -0.07904044538736343, -0.011084645055234432, -2.136749744415283, -4.958920955657959, -0.005801031831651926, -0.0036459180992096663, -2.3841855067985307e-07, -0.7093666195869446, -0.32853639125823975, -2.288792165927589e-05, 0.0, -0.001932302606292069, -0.6526107788085938, -0.3372771441936493, 0.0, -0.4011285901069641, -1.9073468138230965e-06, -0.0024845702573657036, -0.00012468514614738524, -0.0005803807871416211, -1.680836794548668e-05, -1.9073468138230965e-06, -5.483612312673358e-06, -8.344646857949556e-07, -0.003987576812505722, -2.2172682292875834e-05, -2.264974000354414e-06, -2.584329843521118, -0.2016202211380005, -0.00011205045302631333, -1.0728830375228426e-06, -9.393251093570143e-05, -4.649054244509898e-05, -3.2896909713745117, -1.3905644416809082, -4.0531076592742465e-06, -0.9355104565620422, -0.5776065587997437, -0.019358163699507713, 0.0, -1.4305104514278355e-06, -4.768