):\n        while not self.tokenizer:\n            line = self.stream.readline()\n            if not line:\n                return \"0\"\n            self.tokenizer = line.strip().split()\n        return self.tokenizer.pop(0)\n\n    def nextInt(self):\n        return int(self.next())\n\n    def nextDouble(self):\n        return float(self.next())\n\n    def nextLong(self):\n        return int(self.next())   # long in Python is just int\n\n    def nextBigInteger(self):\n        return int(self.next())   # Python int is arbitrary precision\n\n    def nextLine(self):\n        line = \"\"\n        while line == \"\":\n            line = self.stream.readline()\n            if not line:\n                break\n            line = line.rstrip('\\n')\n        return line\n\n\ndef main():\n    reader = InputReader(sys.stdin)\n    n = reader.nextInt()\n    if n > 11:\n        sys.stdout.write(\"0\\n\")\n        sys.stdout.flush()\n        return\n\n    points = []\n    for _ in range(n):\n        x1 = reader.nextLong()\n        x2 = reader.nextLong()\n        x3 = reader.nextLong()\n        x4 = reader.nextLong()\n        x5 = reader.nextLong()\n        points.append(Point(x1, x2, x3, x4, x5))\n\n    ret = []\n    for i in range(n):\n        if check(points, i):\n            ret.append(i + 1)\n\n    sys.stdout.write(str(len(ret)) + \"\\n\")\n    for x in ret:\n        sys.stdout.write(str(x) + \"\\n\")\n    sys.stdout.flush()\n\n\nif __name__ == \"__main__\":\n    main()\n```", "token_logprobs": [-1.701683759689331, -8.344646857949556e-07, -0.00027259447961114347, -5.447716102935374e-05, -6.318072337307967e-06, -0.06202699616551399, -0.029790222644805908, -0.000723576988093555, -0.25616201758384705, -0.9193367958068848, -0.00018571082910057157, -0.008639813400804996, -0.07904671877622604, -1.9073468138230965e-06, -0.00026973424246534705, -3.576278118089249e-07, -2.8119688034057617, -2.4437606043647975e-05, -0.08068450540304184, -1.168244216387393e-05, -0.0619792677462101, 0.0,