g total;\n    static long best = (long) 1e18;\n    static long best_z = -1;\n    static String s;\n    static int MAXN = 2 * 100; // assuming maximum r and c (you can adjust accordingly)\n    static int MAX_LEN;\n\n    static long[][] memo;\n    static Map<Long, Long> mp = new HashMap<>();\n    static int[] cntA;\n    static int[] cntB;\n\n    static void precomputeC() {\n        int size = MAXN + 1;\n        C = new long[size][size];\n        for (int i = 0; i < size; i++) {\n            for (int j = 0; j < size; j++) {\n                if (j == 0) C[i][j] = 1L;\n                else if (i == 0) C[i][j] = 0;\n                else C[i][j] = C[i - 1][j] + C[i - 1][j - 1];\n            }\n        }\n    }\n\n    static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        r = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n\n        precomputeC();\n\n        int sizeLimit = 2 * (r + c) + 1;\n        // Initialize variables\n        total = C[r + c][r] * C[r + c][r];\n\n        long x=0, y=0;\n        int v1 = r + c;\n        int v2 = r + c;\n        while (v1 >= r && v2 >= r) {\n            if (x > y) {\n                long cur1 = C[v1][r] - C[v1 - 1][r];\n                long sum2 = C[v2][r];\n                y += cur1 * sum2;\n                v1--;\n            } else {\n                long sum1 = C[v1][r];\n                long cur2 = C[v2][r] - C[v2 - 1][r];\n                x += sum1 * cur2;\n                v2--;\n            }\n        }\n        best = Math.abs(x - y);\n        dfs(0, 0, r + c, r + c);\n        s = br.readLine().trim();\n\n        MAX_LEN = s.length() + 2; // for safety\n        cntA = new int[MAX_LEN];\n        cntB = new int[MAX_LEN];\n\n        for (int i=0; i < s.length(); i++) {\n            cntA[i + 1] = cntA[i] + (s.charAt(i) == 'A' ?1 : 0);\n           