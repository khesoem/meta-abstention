 (1 << N); idx++) {\n                    if (b.get(idx)) {\n                        ones.add(idx);\n                    }\n                }\n                for (int e = 0; e < (1 << N); e++) {\n                    ModInt pr = new ModInt(1);\n                    for (int j = 0; j < N; j++) {\n                        if (((e >> j) & 1) == 1) {\n                            pr = pr.multiply(p.get(i).get(j));\n                        } else {\n                            pr = pr.multiply(ModInt.one().subtract(p.get(i).get(j)));\n                        }\n                    }\n                    BitSet nb = new BitSet();\n                    for (int x : ones) {\n                        for (int r = 0; r < N; r++) {\n                            if ((((e >> r) & 1) == 1) && !b.get(r)) {\n                                BitSet temp = (BitSet) b.clone();\n                                temp.set(r);\n                                nb.or(temp);\n                            }\n                        }\n                    }\n                    nxt.put(nb, nxt.getOrDefault(nb, ModInt.zero()).add(sc.multiply(pr)));\n                }\n            }\n            cur = new HashMap<>(nxt);\n            nxt.clear();\n        }\n\n        ModInt ans = ModInt.zero();\n        for (Map.Entry<BitSet, ModInt> entry : cur.entrySet()) {\n            BitSet b = entry.getKey();\n            if (b.get((1 << N) - 1)) {\n                ans = ans.add(entry.getValue());\n            }\n        }\n        System.out.println(ans);\n    }\n}\n\nclass ModInt {\n    private static final long MOD = 1000000007;\n    private final long v;\n\n    public ModInt(long v) {\n        this.v = norm(v);\n    }\n\n    public static ModInt zero() {\n        return new ModInt(0);\n    }\n\n    public static ModInt one() {\n        return new ModInt(1);\n    }\n\n    public ModInt add(ModInt other) {\n        return new ModInt(norm(this.v + other.v));\n    }\n\n    public ModInt subtract(ModInt other) {\n  