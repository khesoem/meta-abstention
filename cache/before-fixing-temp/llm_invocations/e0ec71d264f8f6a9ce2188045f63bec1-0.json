 self.cost[y].append(-w)\n        self.cap[x].append(c)\n        self.cap[y].append(0)\n\n    def spfa(self, s):\n        for i in range(len(self.dist)):\n            self.dist[i] = 0x3f3f3f3f\n        for i in range(len(self.vis)):\n            self.vis[i] = 0\n        self.prex[s] = -1\n        q = deque()\n        q.append(s)\n        self.dist[s] = 0\n        self.vis[s] = 1\n\n        while q:\n            x = q.popleft()\n            self.vis[x] = 0\n            for i, y in enumerate(self.v[x]):\n                cc = self.dist[x] + self.cost[x][i]\n                if self.dist[y] > cc and self.cap[x][i]:\n                    self.dist[y] = cc\n                    self.prex[y] = x\n                    self.prei[y] = i\n                    if not self.vis[y]:\n                        self.vis[y] = 1\n                        q.append(y)\n\n    def dfs(self, x, flow):\n        if self.prex[x] == -1:\n            return flow\n        y = x\n        x = self.prex[y]\n        i = self.prei[y]\n        j = self.rev[x][i]\n        f = self.dfs(x, min(flow, self.cap[x][i]))\n        self.cap[x][i] -= f\n        self.cap[y][j] += f\n        return f\n\n    def solve(self, s, t):\n        ans = 0\n        tot = 0\n        while True:\n            self.spfa(s)\n            if self.dist[t] > 1e9:\n                break\n            f = self.dfs(t, inf)\n            tot += f * self.dist[t]\n            ans += f\n        return ans, tot\n\ndef main():\n    input = sys.stdin.read().split()\n    n, m, k, c, d = map(int, input[0:5])\n    idx = 5\n    max_k = k\n    s = nn - 1\n    t = nn - 2\n    flow_network = MCMF()\n\n    def get(x, tim):\n        return tim * 52 - 52 + x\n\n    # Add edges for initial k nodes\n    for _ in range(k):\n        x = int(input[idx])\n        idx += 1\n        flow_network.add_edge(s, get(x, 1), 1, 0)\n\n    k = max_k\n    # Read m edges\n    for _ in range(m):\n        x = int(input[idx])\n        y = int(input[idx + 1])\n        idx += 2\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                flow_network.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n        x, y = y, x\n        for i in range(1, 100):\n            for j in range(1, k + 1):\n                flow_network.add_edge(get(x, i), get(y, i + 1), 1, d * (j + j - 1))\n    # Connecting layers\n    for i in range(1, 100):\n        for j in range(1, n + 1):\n            flow_network.add_edge(get(j, i), get(j, i + 1), inf, 0)\n        flow_network.add_edge(get(1, i), t, inf, c * (i - 1))\n\n    result = flow_network.solve(s, t)[1]\n    print(result)\n\nif __name__ == \"__main__\":\n    main()\n\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00022415895364247262, -0.0006380964769050479, -1.9361264946837764e-07, -4.0722858102526516e-05, -0.28954070806503296, -0.31551772356033325, -0.03671489283442497, 0.0, -9.269565634895116e-05, 0.0, -0.04746754467487335, -0.049652401357889175, -0.026287293061614037, -0.5582387447357178, -0.02978694438934326, -1.2664456789934775e-06, -0.03268462046980858, -1.6177022457122803, -0.11504698544740677, -0.0006128363311290741, -1.0325924449716695e-05, -0.12838201224803925, -9.77022064034827e-05, 0.0, -0.00016992862219922245, -0.01900789700448513, -1.9366180896759033, -5.991464786347933e-05, -3.214019307051785e-05, -0.5761362314224243, -0.002805110299959779, -6.704273118884885e-07, -0.20214667916297913, -0.004560426808893681, -6.2729995988775045e-06, -9.088346359931165e-07, 0.0, -2.2200749754119897e-06, -0.005734551697969437, -0.024058014154434204, -0.7626778483390808, -0.0074881925247609615, -1.2664456789934775e-06, -1.652451464906335e-05, -2.0339031834737398e-05, -1.723973582556937e-05, -5.512236498361744e-07, 0.0, 0.0, 0.0, -0.03806409612298012, -1.9361264946837764e-07, -0.0011748670367524028, -3.523948907968588e-05, -1.8312570318812504e-05, 0.0, -4.320199877838604e-07, 0.0, -8.895480277715251e-06, 0.0, -1.5048530030981055e-06, -0.0008141548605635762,