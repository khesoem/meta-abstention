st, forward):\n        self.forward = forward\n        self.from_node = from_node\n        self.to_node = to_node\n        self.capacity = capacity\n        self.cost = cost\n        self.flow = 0\n        self.dual = None\n\n    def remaining(self):\n        return self.capacity - self.flow\n\n    def add_flow(self, amount):\n        self.flow += amount\n        self.dual.flow -= amount\n\nclass MaxFlowSolver:\n    def __init__(self, n=0):\n        self.nodes = []\n        for _ in range(n):\n            self.add_node()\n\n    def add_node(self):\n        n = Node()\n        n.index = len(self.nodes)\n        self.nodes.append(n)\n        return n\n\n    def link(self, n1, n2, capacity, cost=1):\n        e12 = Edge(n1, n2, capacity, cost, True)\n        e21 = Edge(n2, n1, 0, -cost, False)\n        e12.dual = e21\n        e21.dual = e12\n        n1.edges.append(e12)\n        n2.edges.append(e21)\n\nclass MinCostMaxFlowSolver(MaxFlowSolver):\n    def get_min_cost_max_flow(self, src, snk):\n        raise NotImplementedError\n\nclass EdmondsKarp(MinCostMaxFlowSolver):\n    INF = 10**15\n\n    def __init__(self, n=0):\n        super().__init__(n)\n        self.min_cost = 0\n\n    def get_min_cost_max_flow(self, src, snk):\n        maxflow = self.get_max_flow(src, snk)\n        return [maxflow, self.min_cost]\n\n    def get_max_flow(self, src, snk):\n        n = len(self.nodes)\n        source = src.index\n        sink = snk.index\n        flow = 0\n        cost = 0\n        potential = [0] * n\n        while True:\n            parent = [None] * n\n            dist = [self.INF] * n\n            dist[source] = 0\n            pq = [(0, source)]\n            while pq:\n                d, v = heapq.heappop(pq)\n                if d != dist[v]:\n                    continue\n                for e in self.nodes[v].edges:\n                    if e.capacity > e.flow:\n                        temp = dist[v] + e.cost + potential[v] - potential[e.to_node.index]\n                        if dist[e.to_node.index] > temp:\n                            dist[e.to_node.index] = temp\n                            parent[e.to_node.index] = e\n                            heapq.heappush(pq, (temp, e.to_node.index))\n            if parent[sink] is None:\n                break\n            for i in range(n):\n                if parent[i] is not None:\n                    potential[i] += dist[i]\n            aug_flow = self.INF\n            i = sink\n            while i != source:\n                e = parent[i]\n                aug_flow = min(aug_flow, e.capacity - e.flow)\n                i = e.from_node.index\n            i = sink\n            while i != source:\n                e = parent[i]\n                e.add_flow(aug_flow)\n                cost += aug_flow * e.cost\n                i = e.from_node.index\n            flow += aug_flow\n        self.min_cost = cost\n        return flow\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    it = iter(data)\n    N = next(it)\n    M = next(it)\n    K = next(it)\n    C = next(it)\n    D = next(it)\n    people = [next(it) - 1 for _ in range(K)]\n\n    solver = EdmondsKarp()\n    src = solver.add_node()\n    snk = solver.add_node()\n    amt = 150\n    time_nodes = [[None] * amt for _ in range(N)]\n    for i in range(N):\n        for j in range(1, amt):\n            time_nodes[i][j] = solver.add_node()\n            if j > 1:\n                solver.link(time_nodes[i][j-1], time_nodes[i][j], 10**15, 0)\n\n    for i in range(K):\n        solver.link(src, time_nodes[people[i]][1], 1, 0)\n\n    for i in range(1, amt):\n        for _ in range(K):  # j from 0 to K-1, each time a parallel edge\n            solver.link(time_nodes[0][i], snk, 1, C * i - C)\n\n    for _ in range(M):\n        a = next(it) - 1\n        b = next(it) - 1\n        for j in range(1, amt - 1):\n            prev = 0\n            for k in range(1, K + 1):\n                cost = D * k * k - prev\n                solver.link(time_nodes[a][j], time_nodes[b][j + 1], 1, cost)\n                solver.link(time_nodes[b][j], time_nodes[a][j + 1], 1, cost)\n                prev = D * k * k\n\n    ret = solver.get_min_cost_max_flow(src, snk)\n    sys.stdout.write(str(ret[1]) + '\\n')\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.821448318485636e-06, 0.0, -3.576278118089249e-07, -0.0009170140838250518, -0.023336755111813545, -0.00033849707688204944, -0.002017725957557559, -0.018158389255404472, -0.006884781178086996, -0.2520217001438141, -0.09399337321519852, -0.055610328912734985, -1.156323378381785e-05, -3.4570634852570947e-06, -0.019161244854331017, -6.198863957251888e-06, -2.3841855067985307e-07, -1.9073468138230965e-06, 0.0, -0.4740962088108063, -1.1920928244535389e-07, -1.1920922133867862e-06, -0.0003361137059982866, -1.1920928244535389e-07, -4.565611743601039e-05, -0.10051852464675903, -5.960462772236497e-07, -1.2993727978027891e-05, -3.731181277544238e-05, -1.4305104514278355e-06, -0.611254870891571, -7.152555099310121e-07, -0.08628905564546585, -0.0011728082317858934, -2.3841855067985307e-07, -9.536738616588991e-07, -5.960462772236497e-07, -0.006765672471374273, -2.3841855067985307e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, 0.0, -1.6689286894688848e-06, -1.3981653451919556, -0.020632637664675713, -0.00012766500003635883, 0.0, -0.0031793781090527773, -1.1920928244535389e-07, -0.0025909922551363707, -1.9788545614574105e-05, -0.2551995515823364, -0.0017482249531894922, -0.0012562725460156798, -0.029930569231510162, -1.1920928244535389e-07, -5.960462772236497e-07, -0.313741534948349, -0.0004450284468475729, -1.7881377516459906e-06, -2.3841855067985307e-07, -0.005497930571436882, 0.0, 0.0, -0.0003875934926327318, -0.0015334049239754677, -3.576278118089249e-07, -4.768370445162873e-07, 0.0, -9.583967766957358e-05, 0.0, 0.0, -2.3841855067985307e-07, -0.014165094122290611, -7.15