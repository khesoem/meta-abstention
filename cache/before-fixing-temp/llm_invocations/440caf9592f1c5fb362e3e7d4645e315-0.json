):\n        # dp[k+1][max_bits+1]\n        dp = [[0] * (max_bits + 1) for _ in range(k + 1)]\n        dp[0][0] = 1\n        for j in range(1, k + 1):\n            for u in range(max_bits + 1):\n                for v in range(max_bits + 1 - u):\n                    dp[j][u + v] = (dp[j][u + v] + a[u][mask] * dp[j-1][v]) % M\n            for v in range(max_bits + 1):\n                dp[j][v] %= M\n        if pn <= max_bits:\n            b[mask] = dp[k][pn]\n        else:\n            b[mask] = 0\n\n    for bit in range(max_bits):\n        for mask in range(size):\n            if (mask >> bit) & 1:\n                b[mask] -= b[mask ^ (1 << bit)]\n\n    result = (qpow(k, n * 2) - b[n] % M * fac[n * 2]) % M\n    print((result + M) % M)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-3.5762147e-05, 0.0, -3.5762723e-06, -0.0011973362, -1.0303942, -1.0251946e-05, -3.325884e-05, -0.011820158, -3.576278e-07, -1.3113013e-06, -0.0031842503, -0.079248495, -0.0014491305, -5.9627123, -0.03252488, -2.7418098e-06, -8.66614e-05, -8.5830325e-06, -0.0630447, -0.12735204, -3.576278e-07, -3.6119764e-05, -0.005259724, 0.0, -0.038051628, -2.4079987e-05, -0.04904735, -0.10260816, -7.152555e-07, -0.000100249985, -0.00022051287, -3.5762723e-06, -0.02976326, 0.0, -0.01447498, -0.100207016, -9.5367386e-07, -0.06197008, -1.1920928e-07, -0.0019392034, -1.4305105e-06, -1.1920928e-07, -1.1920928e-07, -2.384183e-06, 0.0, -0.0001752223, 0.0, -0.018153941, 0.0, -4.7683704e-07, 0.0, -1.9073468e-06, 0.0, 0.0, -1.072883e-06, -2.9802277e-06, 0.0, -2.3841855e-07, -0.0485896, -9.5367386e-07, 0.0, 0.0, -3.576278e-07, -1.1920928e-07, -1.072883e-06, -1.2993728e-05, -0.00043108707, 0.0, -4.7683704e-07, 0.0, -1.1920928e-07, 0.0, 0.0, 0.0, -1.1920928e-07, -2.384183e-06, 0.0, -4.7683704e-07, -8.344647e-07, -3.576278e-07, -3.576278e-07, 0.0, -8.344647e-07, -1.6689287e-06, -0.1028133, -0.07290305, -4.887569e-06, -5.960463e-07, -2.5809443, -6.