]==-1) return flow;\n\t\tint y=x;x=prex[y];int i=prei[y],j=rev[x][i];\n\t\tint f=dfs(x,min(flow,cap[x][i]));\n\t\tcap[x][i]-=f,cap[y][j]+=f;\n\t\treturn f;\n\t}\n\t\n\tpii solve(int s,int t)\n\t{\n\t\tint ans=0;tot=0;\n\t\twhile(1)\n\t\t{\n\t\t\tspfa(s);\n\t\t\tif(dist[t]>1e9) break;\n\t\t\tint f=dfs(t,inf);\n\t\t\ttot+=f*dist[t];\n\t\t\tans+=f;\n\t\t}\n\t\treturn mp(ans,tot);\n\t}\n\t\n};\n\n\nint n,m,s=nn-1,t=nn-2;\nint k,c,d;\nint get(int x,int tim){\n\treturn tim*52-52+x;\n}\nint main() \n{\n\tscanf(\"%d%d%d%d%d\",&n,&m,&k,&c,&d);int kk=k;\n\twhile(k--){\n\t\tint x;scanf(\"%d\",&x);\n\t\tmcmf::add_edge(s,get(x,1),1,0);\n\t}k=kk;\n\twhile(m--){\n\t\tint x,y;scanf(\"%d%d\",&x,&y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t\t\n\t\tswap(x,y);\n\t\tfor(int i=1;i<100;i++)\n\t\t\tfor(int j=1;j<=k;j++) mcmf::add_edge(get(x,i),get(y,i+1),1,d*(j+j-1));\n\t}\n\tfor(int i=1;i<100;i++){\n\t\tfor(int j=1;j<=n;j++) mcmf::add_edge(get(j,i),get(j,i+1),inf,0);\n\t\tmcmf::add_edge(get(1,i),t,inf,c*(i-1));\n\t}\n\t\n\tprintf(\"%d\",mcmf::solve(s,t).second);\n\t\n\treturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.io.*;\nimport java.util.*;\n\npublic class Main {\n    static class MCMF {\n        static final int NN = 6000;\n        static final int INF = 100000000;\n        static ArrayList<Integer>[] v, rev, cost, cap;\n\n        @SuppressWarnings(\"unchecked\")\n        static void init() {\n            v = (ArrayList<Integer>[]) new ArrayList[NN];\n            rev = (ArrayList<Integer>[]) new ArrayList[NN];\n            cost = (ArrayList<Integer>[]) new ArrayList[NN];\n            cap = (ArrayList<Integer>[]) new ArrayList[NN];\n            for (int i = 0; i < NN; i++) {\n                v[i] = new ArrayList<>();\n                rev[i] = new ArrayList<>();\n                cost[i] = new ArrayList<>();\n                cap[i] = new ArrayList<>();\n            }\n        }\n\n        static void addEdge(int x, int y, int c, int w) {\n            rev[x].add(v[y].size());\n            rev[y].add(v[x].size());\n            v[x].add(y);\n            v[y].add(x);\n            cost[x].add(w);\n            cost[y].add(-w);\n            cap[x].add(c);\n            cap[y].add(0);\n        }\n\n        static int[] dist = new int[NN];\n        static boolean[] vis = new boolean[NN];\n        static int[] prex = new int[NN];\n        static int[] prei = new int[NN];\n\n        static void spfa(int s) {\n            Arrays.fill(dist, 0x3f3f3f3f);\n            Arrays.fill(vis, false);\n            prex[s] = -1;\n            Queue<Integer> q = new LinkedList<>();\n            q.offer(s);\n            dist[s] = 0;\n            vis[s] = true;\n\n            while (!q.isEmpty()) {\n                int x = q.poll();\n                vis[x] = false;\n                for (int i = 0; i < v[x].size(); i++) {\n                    int y = v[x].get(i);\n                    int cc = dist[x] + cost[x].get(i);\n                    if (dist[y] > cc && cap[x].get(i) > 0) {\n                        dist[y] = cc;\n                        prex[y] = x;\n                        prei[y] = i;\n                        if (!vis[y]) {\n                            vis[y] = true;\n                            q.offer(y);\n                        }\n                    }\n                }\n            }\n        }\n\n        static int augment(int t) {\n            // find bottleneck flow along path from s to t using prex/prei\n            int flow = INF;\n            int cur = t;\n            while (prex[cur] != -1) {\n                int prev = prex[cur];\n                int edgeIdx = prei[cur];\n                flow = Math.min(flow, cap[prev].get(edgeIdx));\n                cur = prev;\n            }\n            // update capacities\n            cur = t;\n            while (prex[cur] != -1) {\n                int prev = prex[cur];\n                int edgeIdx = prei[cur];\n                int revIdx = rev[prev].get(edgeIdx);\n                cap[prev].set(edgeIdx, cap[prev].get(edgeIdx) - flow);\n                cap[cur].set(revIdx, cap[cur].get(revIdx) + flow);\n                cur = prev;\n            }\n            return flow;\n        }\n\n        static int[] solve(int s, int t) {\n            int flow = 0;\n            int cost = 0;\n            while (true) {\n                spfa(s);\n                if (dist[t] > 1e9) break;\n                int f = augment(t);\n                flow += f;\n                cost += f * dist[t];\n            }\n            return new int[]{flow, cost};\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n        int kk = k;\n\n        int s = MCMF.NN - 1;\n        int t = MCMF.NN - 2;\n        MCMF.init();\n\n        // read start positions\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int x = Integer.parseInt(st.nextToken());\n            MCMF.addEdge(s, getNode(x, 1), 1, 0);\n        }\n        k = kk;\n\n        // read edges\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int x = Integer.parseInt(st.nextToken());\n            int y = Integer.parseInt(st.nextToken());\n            // original loop: i<100, but in C++ it's i<100, meaning i from 1 to 99\n            for (int time = 1; time < 100; time++) {\n                for (int j = 1; j <= k; j++) {\n                    MCMF.addEdge(getNode(x, time), getNode(y, time + 1), 1, d * (j + j - 1));\n                }\n            }\n            // swap x,y and repeat\n            int temp = x; x = y; y = temp;\n            for (int time = 1; time < 100; time++) {\n                for (int j = 1; j <= k; j++) {\n                    MCMF.addEdge(getNode(x, time), getNode(y, time + 1), 1, d * (j + j - 1));\n                }\n            }\n        }\n\n        // add staying and sink edges\n        for (int i = 1; i < 100; i++) {\n            for (int j = 1; j <= n; j++) {\n                MCMF.addEdge(getNode(j, i), getNode(j, i + 1), MCMF.INF, 0);\n            }\n            MCMF.addEdge(getNode(1, i), t, MCMF.INF, c * (i - 1));\n        }\n\n        int[] result = MCMF.solve(s, t);\n        System.out.println(result[1]);\n    }\n\n    static int getNode(int x, int tim) {\n        return tim * 52 - 52 + x;\n    }\n}\n</translated_code>\n<confidence>0.95</confidence>", "token_logprobs": [-1.2159273865108844e-05, 0.0, -8.344646857949556e-07, -0.00018845213344320655, -0.00036221143091097474, -2.3841855067985307e-07, -0.3132617473602295, -0.16027437150478363, 0.0, 0.0, -4.768370445162873e-07, -0.0002953569928649813, -0.007674022112041712, -1.1920928244535389e-07, -4.184158387943171e-05, -0.03811749815940857, -0.008638040162622929, -0.04006074741482735, -0.030313558876514435, -0.00023648326168768108, -2.2053474822314456e-05, -3.576278118089249e-07, -9.536738616588991e-07, -1.1920928244535389e-07, -0.0029321794863790274, -0.0015073377871885896, -1.1920928244535389e-07, -4.049883842468262, -1.1920928244535389e-07, 0.0, -7.390948667307384e-06, -3.576272320060525e-06, -0.00024351492174901068, -8.344646857949556e-07, -8.141662692651153e-05, -0.12866029143333435, -9.417489309271332e-06, -0.0025827880017459393, -0.00040880427695810795, -5.566918844124302e-05, -0.0005769256968051195, -0.02324579656124115, -3.933898824470816e-06, -0.036537621170282364, -0.02325546368956566, -0