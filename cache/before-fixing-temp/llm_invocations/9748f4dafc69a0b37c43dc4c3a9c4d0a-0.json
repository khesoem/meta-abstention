t\t    \tj=(j-1)&j;\n\t\t    }\n    \t}\n    \tfor(i=n;;i=(i-1)&n)\n    \t{\n    \t\tvis[i]=true;\n\t    \tif(i==0)\n\t    \t   break;\n\t    }\n\t    for(i=1;i<=n;i++)\n\t    {\n\t        if(vis[i])\n\t        {\n        \t\tfor(j=i;j>0;j=(j-1)&i)\n        \t\t{\n        \t\t\tint l=min(k,len[i-j]+1);\n\t    \t    \t for(s=1;s<=l;s++)\n\t    \t    \t {\n\t    \t    \t \t if(dp[s-1][i-j])\n \t        \t\t\t     dp[s][i]=(dp[s][i]+1LL*dp[s-1][i-j]*inv[j])%mod;\n\t    \t    \t }\n\t\t\t\t}\n\t        }\n    \t}\n    \tint ans=0;\n    \tfor(i=0;i<=min(k,len[n]);i++)\n    \t{\n\t    \tif(dp[i][n])\n\t    \t{\n\t    \t\tint tmp=1LL*dp[i][n]*fac[k]%mod;\n\t    \t\ttmp=1LL*tmp*inv[k-i]%mod;\n\t    \t\ttmp=1LL*tmp*inv[i]%mod;\n\t    \t\ttmp=1LL*tmp*fac[n]%mod;\n\t    \t\tans=(ans+tmp)%mod;\n\t    \t}\n\t    }\n    \tprintf(\"%d\\n\",(power(k,n)-ans+mod)%mod);\n    }\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\nn = int(input())\nk = int(input())\nmod = int(input())\n\ndef power(a, n):\n    if n == 0:\n        return 1\n    ret = power(a, n // 2)\n    ret = (ret * ret) % mod\n    if n % 2:\n        ret = (ret * a) % mod\n    return ret\n\nif n % 2 == 1:\n    print(power(k, n))\nelse:\n    fac = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = (fac[i - 1] * i) % mod\n    inv = [1] * (n + 1)\n    inv[n] = power(fac[n], mod - 2)\n    for i in range(n - 1, -1, -1):\n        inv[i] = (inv[i + 1] * (i + 1)) % mod\n\n    list_indices = []\n    for i in range(n + 1):\n        if (n & (1 << i)) != 0:\n            list_indices.append(i)\n    cnt_list = len(list_indices)\n\n    # Calculate len array\n    len_arr = [0] * (n + 1)\n    for i in range(n + 1):\n        j = i\n        while j:\n            len_arr[i] += 1\n            j = (j - 1) & j\n\n    # Initialize dp array\n    dp = [[0] * (1 << n) for _ in range(n + 1)]\n    dp[0][0] = 1\n\n    # Calculate all subsets\n    vis = [False] * (1 << n)\n    for i in range((1 << n)):\n        if i != 0:\n            vis[i] = True\n        if i == 0:\n            break\n        # Mark all supersets\n        for j in range(i, (1 << n)):\n            if (j & i) == i:\n                vis[j] = True\n\n    # Fill DP\n    for i in range(1, n + 1):\n        for subset in range(1 << n):\n            if vis[subset]:\n                s_max = min(k, len_arr[subset])\n                j_mask = subset\n                while j_mask:\n                    j_mask = (j_mask - 1) & subset\n                    j = j_mask.bit_count()\n                    for s in range(1, s_max + 1):\n                        if dp[s - 1][subset ^ j_mask]:\n                            dp[s][subset] = (dp[s][subset] + dp[s - 1][subset ^ j_mask] * inv[j_mask.bit_count()]) % mod\n\n    ans = 0\n    max_i = min(k, len_arr[n])\n    for i in range(max_i + 1):\n        if dp[i][(1 << n) - 1]:\n            tmp = dp[i][(1 << n) - 1]\n            tmp = (tmp * fac[k]) % mod\n            tmp = (tmp * inv[k - i]) % mod\n            tmp = (tmp * inv[i]) % mod\n            tmp = (tmp * fac[n]) % mod\n            ans = (ans + tmp) % mod\n\n    result = (power(k, n) - ans + mod) % mod\n    print(result)\n</translated_code>\n<confidence>\n0.65\n</confidence>", "token_logprobs": [-0.00041243841405957937, -0.0004309076175559312, -4.320199877838604e-07, -2.4034345187828876e-05, -0.006096584722399712, -0.10211857408285141, -1.9361264946837764e-07, -5.512236498361744e-07, -0.010109483264386654, -1.9361264946837764e-07, -1.2471589798224159e-05, -1.9361264946837764e-07, -1.9361264946837764e-07, -1.5570885807392187e-05, -1.9385402993066236e-05, -4.008129963040119e-06, 0.0, 0.0, -0.0005941396811977029, -0.000500966387335211, -2.248469718324486e-05, -3.774276774493046e-05, -0.0022726545576006174, -0.000646433443762362, -0.012588170357048512, -8.41866585687967e-06, -0.2658778429031372, -4.320199877838604e-07, -4.5491004129871726e-05, -4.32