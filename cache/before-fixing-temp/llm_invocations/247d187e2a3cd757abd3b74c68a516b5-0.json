v[n] = qpow(fac[n],P - 2);\n    for (int i = n;i > 0;--i) inv[i - 1] = inv[i] * i % P;\n    memset(dp,-1,sizeof(dp));ans = (ans - dfs(0,n) + P) % P;\n    cout << ans << endl;\n    return 0;\n}\n// \u975e\u5361\u5e38\u505a\u6cd5\u9700\u8981\u7528FWT\n// \u5361\u5e38\u505a\u6cd5: \u6bcf\u6b21\u5f3a\u5236\u5c06Ai\u89c4\u5b9a\u4e3a\u542b\u6709msk\u7684lowbit\u7684\u90a3\u4e00\u4e2a\uff0c\u6700\u540e\u5f53msk=0\u65f6\u7528\u6392\u5217\u4e58\u56de\u6765\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\nsys.setrecursionlimit(1000000)\n\ndef qpow(a, b, mod):\n    ret = 1\n    while b:\n        if b & 1:\n            ret = ret * a % mod\n        a = a * a % mod\n        b >>= 1\n    return ret\n\ndef lowbit(x):\n    return x & -x\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    kk = int(data[1])\n    P = int(data[2])\n\n    ans = pow(kk, n, P)\n    if n & 1:\n        print(ans)\n        return\n\n    # precompute factorials and inverse factorials\n    fac = [1] * (n + 1)\n    for i in range(1, n + 1):\n        fac[i] = fac[i-1] * i % P\n    inv = [0] * (n + 1)\n    inv[n] = pow(fac[n], P - 2, P)\n    for i in range(n, 0, -1):\n        inv[i-1] = inv[i] * i % P\n\n    memo = {}\n\n    def dfs(cur, msk):\n        key = (cur, msk)\n        if key in memo:\n            return memo[key]\n\n        if msk == 0:\n            val = fac[n]\n            for i in range(1, cur + 1):\n                val = val * (kk - i + 1) % P\n            memo[key] = val\n            return val\n\n        val = 0\n        tmp = msk - lowbit(msk)\n        i = tmp\n        while i > 0:\n            val = (val + inv[msk - i] * dfs(cur + 1, i)) % P\n            i = (i - 1) & tmp\n        val = (val + inv[msk] * dfs(cur + 1, 0)) % P\n        memo[key] = val\n        return val\n\n    ans = (ans - dfs(0, n)