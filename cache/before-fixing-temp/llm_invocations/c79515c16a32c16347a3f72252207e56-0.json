ic ArrayList<Edge>[] adj;\n        static int[] sz;\n        static long mc;\n\n        static void init(int n) {\n            N = n;\n            adj = new ArrayList[N];\n            for (int i = 0; i < N; i++) {\n                adj[i] = new ArrayList<>();\n            }\n            sz = new int[N];\n            mc = 0;\n        }\n\n        static void addEdge(int a, int b, long c, long p) {\n            mc = Math.max(mc, c);\n            adj[a].add(new Edge(b, sz[b]++, 0, c, p));\n            adj[b].add(new Edge(a, sz[a]++, 0, 0, -p));\n        }\n\n        static boolean[] vis;\n        static int[] par;\n        static long[] pot, dist;\n\n        static void potInit(int n) {\n            pot = new long[n];\n            for (int i = 1; i < n; i++) {\n                for (int u = 0; u < n; u++) {\n                    for (Edge e : adj[u]) {\n                        if (e.c > 0) {\n                            pot[e.v] = Math.min(pot[e.v], pot[u] + e.p);\n                        }\n                    }\n                }\n            }\n        }\n\n        static long mcf(int s, int t, long[] price, int n, boolean sparse) {\n            vis = new boolean[n];\n            dist = new long[n];\n            Arrays.fill(dist, INF);\n            dist[s] = 0;\n            if (sparse) {\n                Queue<Integer> dk = new LinkedList<>();\n                dk.add(s);\n                while (!dk.isEmpty()) {\n                    int u = dk.poll();\n                    if (vis[u]) continue;\n                    for (Edge e : adj[u]) {\n                        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                            par[e.v] = e.r;\n                            dk.add(e.v);\n                        }\n                    }\n                }\n            } else {\n                for (int u = s; u != -1; ) {\n                    vis[u] = true;\n                    for (Edge e : adj[u]) {\n                        if (e.f < e.c && dist[e.v] > dist[u] + pot[u] - pot[e.v] + e.p) {\n                            dist[e.v] = dist[u] + pot[u] - pot[e.v] + e.p;\n                            par[e.v] = e.r;\n                        }\n                    }\n                    u = -1;\n                    long best = INF;\n                    for (int i = 0; i < n; i++) {\n                        if (!vis[i] && dist[i] < best) {\n                            best = dist[i];\n                            u = i;\n                        }\n                    }\n                }\n            }\n            if (dist[t] >= INF) return 0;\n            long df = INF;\n            for (int u = t; u != s; ) {\n                Edge r = adj[u].get(par[u]);\n                df = Math.min(df, adj[r.v].get(r.r).c - adj[r.v].get(r.r).f);\n                u = r.v;\n            }\n            for (int u = t; u != s; ) {\n                Edge r = adj[u].get(par[u]);\n                Edge e = adj[r.v].get(r.r);\n                e.f += df;\n                r.f -= df;\n                price[0] += df * e.p;\n                u = r.v;\n            }\n            for (int i = 0; i < n; i++) {\n                pot[i] = Math.min(INF, dist[i] + pot[i]);\n            }\n            return df;\n        }\n\n        static long minCostFlow(int s, int t, long[] price, int n, boolean sparse) {\n            potInit(n);\n            long flow = 0;\n            price[0] = 0;\n            long df;\n            while ((df = mcf(s, t, price, n, sparse)) > 0) {\n                flow += df;\n            }\n            return flow;\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        int n = Integer.parseInt(st.nextToken());\n        int m = Integer.parseInt(st.nextToken());\n        int k = Integer.parseInt(st.nextToken());\n        int c = Integer.parseInt(st.nextToken());\n        int d = Integer.parseInt(st.nextToken());\n\n        int source = 0;\n        int sink = n * T + 1;\n        Flow.init(n * T + 2);\n\n        st = new StringTokenizer(br.readLine());\n        for (int i = 0; i < k; i++) {\n            int a = Integer.parseInt(st.nextToken());\n            Flow.addEdge(source, a, 1, 0);\n        }\n\n        for (int t = 0; t < T; t++) {\n            Flow.addEdge(1 + t * n, sink, INF, 0);\n            if (t > 0) {\n                for (int i = 1; i <= n; i++) {\n                    Flow.addEdge(i + (t - 1) * n, i + t * n, INF, c);\n                }\n            }\n        }\n\n        for (int i = 0; i < m; i++) {\n            st = new StringTokenizer(br.readLine());\n            int a = Integer.parseInt(st.nextToken());\n            int b = Integer.parseInt(st.nextToken());\n            for (int j = 0; j < C; j++) {\n                int cost = (j + 1) * (j + 1) - j * j;\n                for (int t = 1; t < T; t++) {\n                    Flow.addEdge(a + (t - 1) * n, b + t * n, 1, cost * d + c);\n                    Flow.addEdge(b + (t - 1) * n, a + t * n, 1, cost * d + c);\n                }\n            }\n        }\n\n        long[] price = new long[1];\n        long flow = Flow.minCostFlow(source, sink, price, sink + 1, true);\n        System.out.println(price[0]);\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-2.0265559e-06, 0.0, 0.0, -3.1589963e-05, -0.0012193633, -1.7881378e-06, -2.350213, -0.003309252, 0.0, 0.0, -6.460935e-05, -0.00675099, -0.005310832, -3.576278e-07, -0.0020237935, -0.030653397, -0.008708476, -0.118877254, -0.69342667, -0.10487507, -0.03704756, -2.264974e-06, -1.1920928e-07, -1.1086402e-05, -0.00013827322, -1.1920928e-07, -2.3841855e-07, -3.576278e-07, -7.152555e-07, -4.3868058e-05, -2.0265559e-06, -1.1920928e-07, -1.3113013e-06, -0.054905552, -0.10020788, -9.691246e-