ll*fac[i-1]*i%P;\n\tifac[n]=fpow(fac[n],P-2);\n\tfor(int i=n-1;~i;--i)ifac[i]=ifac[i+1]*(i+1ll)%P;\n\tinv[1]=1;\n\tfor(int i=2;i<=n;++i)inv[i]=1ll*(P-P/i)*inv[P%i]%P;\n}\ninline void add(int &x,int y){x+=y;if(x>=P)x-=P;}\ninline void sub(int &x,int y){x-=y;x-=(x>>31)*P;}\ninline void FMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(RG int j=0;j<l;++j)\n\t\t\t\tadd(f[i+j+l],f[i+j]);\n}\ninline void IFMT(int *f,int n)\n{\n\tfor(int l=1;l<n;l<<=1)\n\t\tfor(int i=0;i<n;i+=l<<1)\n\t\t\tfor(RG int j=0;j<l;++j)\n\t\t\t\tsub(f[i+j+l],f[i+j]);\n}\nint n,k;\n#define pop(x) __builtin_popcount(x)\nint lp[N];\ninline void ln(int *f,int *g,int n){\n\tg[0]=0;\n\tfor(int i=1;i<n;++i)\n\t{\n\t\tg[i]=0;\n\t\tfor(int j=1;j<i;++j)g[i]=(g[i]+1ll*f[i-j]*g[j]%P*j)%P;\n\t\tg[i]=(f[i]+1ll*g[i]*(P-inv[i]))%P;\n\t}\n}\ninline void exp(int *f,int *g,int n){\n\tg[0]=1;\n\tfor(int i=1;i<n;++i){\n\t\tg[i]=0;\n\t\tfor(int j=1;j<=i;++j)g[i]=(g[i]+1ll*g[i-j]*f[j]%P*j)%P;\n\t\tg[i]=(1ll*g[i]*inv[i])%P;\n\t}\n}\nint main(void)\n{\n\t#ifndef ONLINE_JUDGE\n// \tFile(\"onmyodo\");\n\t#endif\n\tn=gi,k=gi,P=gi;\n\tint ans=fpow(k,n);\n\tif(~n&1){\n\t\tint m=(int)log2(n)+1;\n\t\tinit(1<<m);\n\t\tfor(int i=0;i<(1<<m);++i)f[pop(i)][i]=ifac[i];\n\t\tfor(int i=0;i<=m;++i)FMT(f[i],1<<m);\n\t\tstatic int F[20],G[20];\n\t\tfor(int i=0;i<(1<<m);++i){\n\t\t\tfor(int j=0;j<=m;++j)F[j]=f[j][i];\n\t\t\tln(F,G,m+1);\n\t\t\tfor(int j=0;j<=m;++j)G[j]=1ll*G[j]*k%P;\n\t\t\texp(G,F,m+1);\n\t\t\tfor(int j=0;j<=m;++j)f[j][i]=F[j];\n\t\t}\n\t\tIFMT(f[pop(n)],1<<m);\n\t\tans=(P+ans-1ll*f[pop(n)][n]*fac[n]%P)%P;\n\t}\n\tpi(ans);\n\treturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "<translated_code>\n# Import necessary modules\nimport sys\nimport math\n\n# Function to check max\ndef chkmax(x, y):\n    if x < y:\n        return y, True\n    return x, False\n\n# Function to check min\ndef chkmin(x, y):\n    if x > y:\n        return y, True\n    return x, False\n\n# Function to get integer input\ndef geti():\n    return int(sys.stdin.read())\n\n# Fast exponentiation\ndef fpow(a, b, c=1):\n    result = c\n    while b:\n        if b & 1:\n            result = result * a % P\n        a = a * a % P\n        b >>= 1\n    return result\n\n# Initialize factorials and inverses\ndef init(n):\n    fac[0] = 1\n    for i in range(1, n + 1):\n        fac[i] = fac[i - 1] * i % P\n    ifac[n] = fpow(fac[n], P - 2)\n    for i in range(n - 1, -1, -1):\n        ifac[i] = ifac[i + 1] * (i + 1) % P\n    inv[1] = 1\n    for i in range(2, n + 1):\n        inv[i] = (P - P // i) * inv[P % i] % P\n\n# Add and subtract functions\ndef add(x, y):\n    x += y\n    if x >= P:\n        x -= P\n    return x\n\ndef sub(x, y):\n    x -= y\n    if x < 0:\n        x += P\n    return x\n\n# Fast M\u00f6bius transform (FMT)\ndef FMT(f, n):\n    length = 1\n    while length < n:\n        for i in range(0, n, length * 2):\n            for j in range(length):\n                f[i + j + length] = add(f[i + j + length], f[i + j])\n        length <<= 1\n\n# Inverse M\u00f6bius transform (IFMT)\ndef IFMT(f, n):\n    length = 1\n    while length < n:\n        for i in range(0, n, length * 2):\n            for j in range(length):\n                f[i + j + length] = sub(f[i + j + length], f[i + j])\n        length <<= 1\n\n# Polynomial logarithm\ndef ln(f, g, n):\n    g[0] = 0\n    for i in range(1, n):\n        g[i] = 0\n        for j in range(1, i):\n            g[i] = (g[i] + f[i - j] * g[j] % P * j) % P\n        g[i] = (f[i] + g[i] * (P - inv[i])) % P\n\n# Polynomial exponential\ndef exp(f, g, n):\n    g[0] = 1\n    for i in range(1, n):\n        g[i] = 0\n        for j in range(1, i + 1):\n            g[i] = (g[i] + g[i - j] * f[j] % P * j) % P\n        g[i] = (g[i] * inv[i]) % P\n\n# Main execution\nif __name__ == \"__main__\":\n    # Read inputs\n    input_data = sys.stdin.read().split()\n    n = int(input_data[0])\n    k = int(input_data[1])\n    P = int(input_data[2])\n\n    # Initialize factorials and inverses\n    fac = [0] * (300010)\n    ifac = [0] * (300010)\n    inv = [0] * (300010)\n    init(n)\n\n    ans = fpow(k, n)\n    if n % 2 == 0:\n        m = int(math.log2(n)) + 1\n        size = 1 << m\n        f = [[0] * size for _ in range(m + 1)]\n        # Populate f with inverse factorial\n        for i in range(size):\n            f[bin(i).count(\"1\")][i] = ifac[i]\n        # Perform FMT on each row\n        for i in range(m + 1):\n            FMT(f[i], size)\n\n        F = [0] * (m + 1)\n        G = [0] * (m + 1)\n        for i in range(size):\n            for j in range(m + 1):\n                F[j] = f[j][i]\n            ln(F, G, m + 1)\n            for j in range(m + 1):\n                G[j] = G[j] * k % P\n            exp(G, F, m + 1)\n            for j in range(m + 1):\n                f[j][i] = F[j]\n        # Inverse FMT on last row\n        IFMT(f[bin(n).count(\"1\")], size)\n        answer = (P + ans - (f[bin(n).count(\"1\")][n] * fac[n] % P)) % P\n    else:\n        answer = ans\n    print(answer)\n</translated_code>\n<confidence>\n0.85\n</confidence>", "token_logprobs": [-3.523948907968588e-05, -0.0015283133834600449, -4.320199877838604e-07, -8.172891830326989e-05, -0.032706890255212784, -3.6067981719970703, -0.1957084834575653, -0.25131168961524963, -0.020961184054613113, -0.0010039894841611385, -0.31326258182525635, -8.006006828509271e-05, -0.0009362359414808452, -1.7432603272027336e-06, -0.001113189267925918, -0.2034502923488617, -2.754457950592041, -0.08731258660554886, -0.8240836262702942, -1.2890933752059937, -0.039402883499860764, 0.0, -0.0002087853499688208, -0.00013035668234806508, -1.8908587662735954e-05, -0.007615390233695507, -3.128163257315464e-07, -0.00018041854491457343, -3.4121114822482923e-06, -0.12694133818149567, -0.0017029138980433345, -0.004457774106413126, 0.0, -4.60414821645827e-06, -4.320199877838604e-07, -1.