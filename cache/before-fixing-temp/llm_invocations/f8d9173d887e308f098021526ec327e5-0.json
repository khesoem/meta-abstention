{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++11 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++11 code you have to translate:\n<original_code>\n#include<bits/stdc++.h>\nusing namespace std;\n#define ll long long\nll lsc[62],rsc[62],rsc2[62];\nchar s[62];\nmap<pair<ll,int>,ll>nm,mm;\nll comb(int n,int k)\n{\n    if (n<k || k<0)\n        return 0;\n    ll rez=1,i;\n    for(i=0;i<k;i++)\n        rez=rez*(n-i)/(i+1);\n    return rez;\n}\nint main()\n{\n    //freopen(\".in\",\"r\",stdin);\n    //freopen(\".out\",\"w\",stdout);\n    int r,c,n,i,cnta=0,cntb=0,ok,ast,bst;\n    ll msum=0,nsum=0,bsum,rasp=0;\n    scanf(\"%d%d\\n\",&r,&c);\n    n=2*(r+c);\n    scanf(\"%s\",&s);\n    lsc[2*r-1]=1;\n    for(i=2*r;i<n;i++)\n        lsc[i]=lsc[i-1]*i/(1ll*i-1ll*2*r+1ll);\n    for(i=0;i<=n;i++)\n        {\n        rsc[i]=comb(i,r);\n        rsc2[i]=comb(i,r-1);\n        }\n    nsum=rsc[n/2]*rsc[n/2];\n    for(i=n-1;i>=0;i--)\n        {\n        if (msum>0)\n            ok=1;\n        else\n            ok=0;\n        if (cntb==n/2)\n            ok=1;\n        if (cnta==n/2)\n            ok=0;\n        if (ok)\n            {\n            cnta++;\n            msum=msum-rsc2[n/2-cnta]*rsc[n/2-cntb];\n            }\n        else\n            {\n            cntb++;\n            msum=msum+rsc2[n/2-cntb]*rsc[n/2-cnta];\n            }\n        }\n    msum=max(msum,-msum);\n    mm[make_pair(0,0)]=1;\n    for(i=n-1;i>=2*r-1;i--)\n        {\n        nm.clear();\n        for(auto it:mm)\n            {\n            ll sum=it.first.first,ncnt=it.second,asum,bsum;\n            int cnt=it.first.second;\n            ast=n/2-cnt;\n            bst=i+1-ast;\n            asum=sum+rsc2[ast-1]*rsc[bst];\n            bsum=sum-rsc2[bst-1]*rsc[ast];\n            if (s[i]=='A')\n                {\n                nm[make_pair(asum,cnt+1)]+=ncnt;\n                nm[make_pair(bsum,cnt)]+=0;\n                }\n            else\n                if (s[i]=='B')\n                    {\n                    nm[make_pair(asum,cnt+1)]+=0;\n                    nm[make_pair(bsum,cnt)]+=ncnt;\n                    }\n                else\n                    {\n                    nm[make_pair(asum,cnt+1)]+=ncnt;\n                    nm[make_pair(bsum,cnt)]+=ncnt;\n                    }\n            }\n        nsum=nsum-lsc[i];\n        mm.clear();\n        for(auto it:nm)\n            {\n            ll sum=it.first.first,ncnt=it.second;\n            int cnt=it.first.second;\n            ast=n/2-cnt;\n            bst=i-ast;\n            if (cnt>n/2 || n-i-cnt>n/2)\n                continue;\n            if (sum<-msum-rsc[ast]*rsc[bst] || sum>msum+rsc[ast]*rsc[bst])\n                continue;\n            mm[make_pair(sum,cnt)]+=ncnt;\n            }\n        }\n    bsum=1e18;\n    for(auto it:mm)\n        bsum=min(bsum,max(it.first.first,-it.first.first));\n    for(auto it:mm)\n        {\n        ll sum=it.first.first,ncnt=it.second;\n        int cnt=it.first.second;\n        if (sum==bsum || sum==-bsum)\n            {\n            int sem=0;\n            for(i=0;i<2*r-1;i++)\n                if (s[i]=='?')\n                    sem++;\n                else\n                    if (s[i]=='A')\n                        cnt++;\n            ncnt=ncnt*comb(sem,n/2-cnt);\n            rasp+=ncnt;\n            }\n        }\n    printf(\"%lld\\n\",rasp);\nreturn 0;\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\n\ndef comb(n, k):\n    if n < k or k < 0:\n        return 0\n    rez = 1\n    for i in range(k):\n        rez = rez * (n - i) // (i + 1)\n    return rez\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    r = int(data[0])\n    c = int(data[1])\n    s = data[2]   # string of length n\n    n = 2 * (r + c)\n    # pre\u2011allocate arrays (allow index up to n, extra for safety)\n    lsc = [0] * (n + 2)\n    rsc = [0] * (n + 2)\n    rsc2 = [0] * (n + 2)\n\n    # lsc\n    lsc[2 * r - 1] = 1\n    for i in range(2 * r, n):\n        lsc[i] = lsc[i - 1] * i // (i - 2 * r + 1)\n\n    # rsc and rsc2\n    for i in range(n + 1):\n        rsc[i] = comb(i, r)\n        rsc2[i] = comb(i, r - 1)\n\n    half = n // 2\n    nsum = rsc[half] * rsc[half]\n\n    # first loop (determine msum)\n    cnta = 0\n    cntb = 0\n    msum = 0\n    for i in range(n - 1, -1, -1):\n        if msum > 0:\n            ok = 1\n        else:\n            ok = 0\n        if cntb == half:\n            ok = 1\n        if cnta == half:\n            ok = 0\n        if ok:\n            cnta += 1\n            msum = msum - rsc2[half - cnta] * rsc[half - cntb]\n        else:\n            cntb += 1\n            msum = msum + rsc2[half - cntb] * rsc[half - cnta]\n    msum = max(msum, -msum)\n\n    # DP main part\n    mm = {(0, 0): 1}\n    for i in range(n - 1, 2 * r - 2, -1):   # down to 2*r-1 inclusive\n        nm = {}\n        for (sum_val, cnt), ncnt in mm.items():\n            ast = half - cnt\n            bst = i + 1 - ast\n            # compute asum and bsum\n            idx_as = ast - 1\n            if idx_as < 0:\n                rsc2_val_as = 0\n            else:\n                rsc2_val_as = rsc2[idx_as]\n            asum = sum_val + rsc2_val_as * rsc[bst]\n\n            idx_bs = bst - 1\n            if idx_bs < 0:\n                rsc2_val_bs = 0\n            else:\n                rsc2_val_bs = rsc2[idx_bs]\n            bsum = sum_val - rsc2_val_bs * rsc[ast]\n\n            # process according to current character\n            ch = s[i]\n            if ch == 'A':\n                key_as = (asum, cnt + 1)\n                nm[key_as] = nm.get(key_as, 0) + ncnt\n            elif ch == 'B':\n                key_bs = (bsum, cnt)\n                nm[key_bs] = nm.get(key_bs, 0) + ncnt\n            else:   # '?'\n                key_as = (asum, cnt + 1)\n                nm[key_as] = nm.get(key_as, 0) + ncnt\n                key_bs = (bsum, cnt)\n                nm[key_bs] = nm.get(key_bs, 0) + ncnt\n\n        # update nsum\n        nsum = nsum - lsc[i]\n\n        # filter and build new mm\n        mm.clear()\n        for (sum_val, cnt), ncnt in nm.items():\n            ast = half - cnt\n            bst = i - ast\n            if cnt > half or n - i - cnt > half:\n                continue\n            if sum_val < -msum - rsc[ast] * rsc[bst] or sum_val > msum + rsc[ast] * rsc[bst]:\n                continue\n            key = (sum_val, cnt)\n            mm[key] = mm.get(key, 0) + ncnt\n\n    # find bsum (minimum absolute sum)\n    bsum = float('inf')\n    for (sum_val, cnt) in mm:\n        bsum = min(bsum, max(sum_val, -sum_val))\n\n    # final combination count\n    rasp = 0\n    for (sum_val, cnt), ncnt in mm.items():\n        if sum_val == bsum or sum_val == -bsum:\n            sem = 0\n            cnt_tmp = cnt\n            for j in range(2 * r - 1):   # indices 0 .. 2r-2\n                if s[j] == '?':\n                    sem += 1\n                elif s[j] == 'A':\n                    cnt_tmp += 1\n            need = half - cnt_tmp\n            ncnt *= comb(sem, need)\n            rasp += ncnt\n\n    print(rasp)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.8\n</confidence>", "token_logprobs": [-5.245195097813848e-06, -1.1920922133867862e-06, 0.0, -0.0015491163358092308, -0.017027847468852997, -3.576278118089249e-07, -0.07894130051136017, -0.0020967184100300074, -5.030505417380482e-05, -3.814689989667386e-06, -0.01737867295742035, 0.0, -4.887569048150908e-06, -2.9802276912960224e-06, -0.0003474347176961601, -0.006717361975461245, -2.0265558760002023e-06, -1.4781842764932662e-05, -3.099436753473128e-06, 0.0, -1.1920928244535389e-07, -1.1920928244535389e-07, -2.3841855067985307e-07, -7.867782187531702e-06, -2.3841855067985307e-07, 0.0, 0.0, -3.3378546504536644e-06, -2.3841855067985307e-07, -1.0728830375228426e-06, -0.1615326702594757, -1.1920928244535389e-07, 0.0, 0.0, -8.344646857949556e-07, 0.0, -4.732496745418757e-05, -3.2186455882765586e-06, -1.311301275563892e-06, 0.0, -3.576278118089249e-07, -1.5497195136049413e-06, -1.1920928244535389e-07, -0.00023541064001619816, -5.960462772236497e-07, -2.539125671319198e-05, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -4.768360213347478e-06, -2.3841855067985307e-07, -4.768370445162873e-07, -1.1920928244535389e-07, -1.1920928244535389e-07, -4.768370445162873e-07, -5.960462772236497e-07, -1.1920928244535389e-07, 0.0, -1.0251946150674485e-05, -3.576278118089249e-07, 0.0, -1.4305104514278355e-06, -2.2649508537142538e-05, -0.011957748793065548, -2.133329391479492, -0.061980050057172775, -5.960462772236497e-07, -0.00036745471879839897, -1.1920928244535389e-07, -4.768370445162873e-07, 0.0, -4.291525328881107e-06, -2.3841855067985307e-07, -0.0011705459328368306, -3.814689989667386e-06, -3.576278118089249e-07, -0.16029275953769684, -0.02975180558860302, -1.1920928244535389e-07, -0.00020382710499688983, -9.536738616588991e-07, -3.2186455882765586e-06, -1.8000440832111053e-05, 0.0, -9.179073458653875e-06, -0.0019338493002578616, 0.0, 0.0, 0.0, -1.0728830375228426e-06, -0.0032004110980778933, 0.0, 0.0, -5.364403477869928e-06,