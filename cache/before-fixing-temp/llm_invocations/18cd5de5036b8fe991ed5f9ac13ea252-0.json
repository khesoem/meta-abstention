heck):\n        from collections import deque\n        queue = deque()\n        vis = [-1]* (n*n)\n        start_idx = start_i * n + start_j\n        vis[start_idx] = 0\n        queue.append((start_i, start_j))\n        while queue:\n            now_i, now_j = queue.popleft()\n            p_idx = now_i * n + now_j\n            dis = vis[p_idx]\n            if check:\n                if mat[bi * n + bj][p_idx] <= dis or t <= dis:\n                    if mat[bi * n + bj][p_idx] < dis or t < dis:\n                        vis[p_idx] = INF + 1\n                    continue\n            for d in range(4):\n                i_i = dir[d][0] + now_i\n                j_j = dir[d][1] + now_j\n                if i_i < 0 or j_j < 0 or i_i >= n or j_j >= n:\n                    continue\n                if b[i_i][j_j] < '0' or b[i_i][j_j] > '9':\n                    continue\n                q_idx = i_i * n + j_j\n                if vis[q_idx] != -1:\n                    continue\n                vis[q_idx] = dis + 1\n                queue.append((i_i, j_j))\n        return vis\n\n    def build():\n        ca = []\n        cb = []\n        cap = [[0]*(2 + n*n + n*n) for _ in range(2 + n*n + n*n)]\n        for i in range(n):\n            for j in range(n):\n                if a[i][j] > '0' and a[i][j] <= '9':\n                    ca.append(i)\n                    cb.append(j)\n                    p = i*n + j\n                    cap[p+2+n*n][1] = int(a[i][j])\n        z = bi * n + bj\n        for i in range(n):\n            for j in range(n):\n                if a[i][j] > '0' and a[i][j] <= '9':\n                    p = i*n + j\n                    cap[0][p+2] = int(a[i][j])\n                    for k in range(len(ca)):\n                        ii = ca[k]\n                        jj = cb[k]\n                        q = ii * n + jj\n                        if mat[p][q] < INF:\n                            cap[p+2][q+2+n*n] = INF\n        return cap\n\n    a = [list(row) for row in a]