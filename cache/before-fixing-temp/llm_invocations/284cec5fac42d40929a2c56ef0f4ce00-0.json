    tot = 0;\n    }\n\n    static boolean spfa(int s, int t) {\n        Arrays.fill(d, inf);\n        Arrays.fill(vis, false);\n        Arrays.fill(pre, -1);\n        d[s] = 0;\n        Queue<Integer> q = new LinkedList<>();\n        q.offer(s);\n        while (!q.isEmpty()) {\n            int u = q.poll();\n            vis[u] = false;\n            for (int i = head[u]; i != -1; i = nt[i]) {\n                if (w[i] > 0 && d[to[i]] > d[u] + ct[i]) {\n                    d[to[i]] = d[u] + ct[i];\n                    pre[to[i]] = u;\n                    id[to[i]] = i;\n                    if (!vis[to[i]]) {\n                        vis[to[i]] = true;\n                        q.offer(to[i]);\n                    }\n                }\n            }\n        }\n        return d[t] < inf;\n    }\n\n    static int minCostFlow(int s, int t) {\n        int totalCost = 0;\n        int flow;\n        while (spfa(s, t)) {\n            flow = inf;\n            for (int i = t; i != s; i = pre[i]) {\n                flow = Math.min(flow, w[id[i]]);\n            }\n            for (int i = t; i != s; i = pre[i]) {\n                w[id[i]] -= flow;\n                w[id[i] ^ 1] += flow;\n            }\n            totalCost += d[t] * flow;\n        }\n        return totalCost;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        init();\n\n        int n = sc.nextInt();\n        int m = sc.nextInt();\n        int k = sc.nextInt();\n        int c_cost = sc.nextInt();\n        int d_cost = sc.nextInt();\n\n        s = 0;\n        t = n * 100 + 1;\n        // connect time points to sink\n        for (int i = 1; i <= 100; i++) {\n            add(i, t, 100, 0);\n        }\n        // connect source to start points\n        for (int i = 1; i <= k; i++) {\n            int v = sc.nextInt();\n            add(s, (v - 1) * 100 + 1, 1, 0);\n        }\n        // connect each time point to next\n        for (int i = 1; i <= n; i++) {\n            for (int j = 1; j < 100; j++) {\n                int fromIdx = (i - 1) * 100 + j;\n                int toIdx = (i - 1) * 100 + j + 1;\n                add(fromIdx, toIdx, 100, c_cost);\n            }\n        }\n        // add edges based on the input\n        for (int i = 0; i < m; i++) {\n            int u = sc.nextInt();\n            int v = sc.nextInt();\n            for (int j = 1; j < 100; j++) {\n                int idxU = (u - 1) * 100 + j;\n                int idxV = (v - 1) * 100 + j + 1;\n                for (int k = 1; k <= 20; k++) {\n                    int costVal = c_cost + (k * k - (k - 1) * (k - 1)) * d_cost;\n                    add(idxU, idxV, 1, costVal);\n                }\n            }\n            // add reverse\n            for (int j = 1; j < 100; j++) {\n                int idxV = (v - 1) * 100 + j;\n                int idxU = (u - 1) * 100 + j + 1;\n                for (int k = 1; k <= 20; k++) {\n                    int costVal = c_cost + (k * k - (k - 1) * (k - 1)) * d_cost;\n                    add(idxV, idxU, 1, costVal);\n                }\n            }\n        }\n\n        System.out.println(minCostFlow(s, t));\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.7697154879570007, -7.862962229410186e-05, -2.935296834039036e-06, -0.00045486391172744334, -1.4617256056226324e-05, -3.128163257315464e-07, -0.0010329303331673145, -0.720249593257904, -0.00014191943046171218, -3.128163257315464e-07, -0.39574792981147766, -1.8670179997570813e-05, -0.20149528980255127, -0.21900545060634613, -0.014558094553649426, -0.013404681347310543, -0.04310161620378494, -4.668304245569743e-05, -1.1766746044158936, -7.584239938296378e-06, -0.012520132586359978, -0.00020330198458395898, -4.961759259458631e-06, -3.128163257315464e-07, -0.00012761499965563416, 0.0, -4.320199877838604e-07, 0.0, 0.0, -1.0325924449716695e-05, -1.9361264946837764e-07, -0.006957849953323603, -0.0019584903493523598, -0.0031367207411676