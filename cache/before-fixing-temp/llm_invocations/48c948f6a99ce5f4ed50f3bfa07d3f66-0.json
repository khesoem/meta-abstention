 True\n    Q = deque()\n    Q.append((sr, sc))\n    while Q:\n        v = Q.popleft()\n        d = dist[v[0]][v[1]]\n        pos[v[0]][v[1]] = d <= bum[v[0]][v[1]]\n        if d >= bum[v[0]][v[1]]:\n            continue\n        for i in range(4):\n            u = (v[0] + dy[i], v[1] + dx[i])\n            if 0 <= u[0] < n and 0 <= u[1] < n and a[u[0]][u[1]] != 'Y' and d + 1 < dist[u[0]][u[1]]:\n                dist[u[0]][u[1]] = d + 1\n                Q.append(u)\n\ndef BFS(sr, sc, dist_array):\n    from collections import deque\n    global n, a\n    for i in range(n):\n        for j in range(n):\n            dist_array[i][j] = float('inf')\n    dist_array[sr][sc] = 0\n    Q = deque()\n    Q.append((sr, sc))\n    while Q:\n        v = Q.popleft()\n        d = dist_array[v[0]][v[1]]\n        for i in range(4):\n            u = (v[0] + dy[i], v[1] + dx[i])\n            if 0 <= u[0] < n and 0 <= u[1] < n and a[u[0]][u[1]] != 'Y' and d + 1 < dist_array[u[0]][u[1]]:\n                dist_array[u[0]][u[1]] = d + 1\n                Q.append(u)\n\n# Read starting point for BFS1\nfor i in range(n):\n    for j in range(n):\n        if a[i][j] == 'Z':\n            br, bc = i, j\n\nBFS1()\n\nMaxN = 2 * n * n + 2\nN = MaxN\nInf = 1000000000\n\nR = [[0 for _ in range(N)] for _ in range(N)]\nneigh = [[] for _ in range(N)]\nF = [0 for _ in range(N)]\nP = [0 for _ in range(N)]\nres = 0\n\n# Build network flow graph\nfor i in range(n):\n    for j in range(n):\n        if a[i][j].isdigit() and a[i][j] > '0':\n            v = i * n + j + 1\n            R[0][v] = int(a[i][j])\n            neigh[0].append(v)\n            neigh[v].append(0)\n            BFS2(i, j)\n            for i2 in range(n):\n                for j2 in range(n):\n                    if pos[i2][j2] and b[i2][j2].isdigit() and b[i2][j2] > '0':\n                        u = n * n + i2 * n + j2 + 1\n                        R[v][u] = Inf\n                        neigh[v].append(u)\n                        neigh[u].append(v)\n\nfor i in range(n):\n    for j in range(n):\n        if b[i][j].isdigit() and b[i][j] > '0':\n            u = n * n + i * n + j + 1\n            R[u][N - 1] = int(b[i][j])\n            neigh[u].append(N - 1)\n            neigh[N - 1].append(u)\n\ndef getFlow():\n    import heapq\n    for i in range(N):\n        F[i] = 0\n    F[0] = float('inf')\n    heap = [(-F[0], 0)]\n    while heap:\n        f_neg, v = heapq.heappop(heap)\n        f = -f_neg\n        if F[v] != f:\n            continue\n        for u in neigh[v]:\n            capacity = R[v][u]\n            if min(f, capacity) > F[u]:\n                F[u] = min(f, capacity)\n                P[u] = v\n                heapq.heappush(heap, (-F[u], u))\n    v = N - 1\n    if F[v] == 0:\n        return 0\n    flow = F[v]\n    while v:\n        u = P[v]\n        R[u][v] -= flow\n        R[v][u] += flow\n        v = u\n    return flow\n\nwhile True:\n    f = getFlow()\n    if f == 0:\n        break\n    res += f\n\nprint(res)\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-5.061676347395405e-05, -0.001037214300595224, -1.8624639324116288e-06, -1.3782830137643032e-05, -0.08061462640762329, -1.0551074743270874, -6.988221684878226e-06, -4.320199877838604e-07, -0.0002205828350270167, -9.088346359931165e-07, -4.4849443838757e-06, 0.0, 0.0, -3.054500666621607e-06, -0.05503281205892563, -5.438573680294212e-06, -6.754368223482743e-05, -0.007916536182165146, -0.0001514557225164026, -1.6240566083070007e-06, -0.01604258082807064, -0.0054079461842775345, -1.5048530030981055e-06, -7.896309739408025e-07, 0.0, -5.512236498361744e-07, 0.0, -2.975612187583465e-05, -2.2200749754119897e-06, -1.3856492842023727e-06, -4.723352049040841e-06, -1.9361264946837764e-07, -9.088346359931165e-07, 0.0, -4.320199877838604e-07, -2.7968066206085496e-05, -5.512236498361744e-07, -1.1472419600977446e-06, 0.0, -4.320199877838604e-07, 0.0, -1.9361264946837764e-07, -0.34909409284591675, -0.17789636552333832, -0.000488811288960