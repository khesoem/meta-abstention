 p; i++) {\n            if (f.get(i % p) != (k * f.get(i)) % p) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    static int gen(List<Integer> f, int p, int k, int i) {\n        if (i == p) {\n            return isGood(f, p, k) ? 1 : 0;\n        } else {\n            int ans = 0;\n            for (int j = 0; j < p; j++) {\n                f.add(j);\n                ans += gen(f, p, k, i + 1);\n                f.remove(f.size() - 1);\n            }\n            return ans;\n        }\n    }\n\n    static long solve(int p, int k) {\n        long num = 0;\n        Set<Integer> used = new HashSet<>();\n        for (int j = 0; j < p; j++) {\n            if (!used.contains(j)) {\n                num += 1;\n            }\n            int i = j;\n            while (!used.contains(i)) {\n                used.add(i);\n                i = (i * k) % p;\n            }\n        }\n        long exponent = num - (k != 1 ? 1 : 0);\n        return powMod(p, exponent, MOD);\n    }\n\n    static long powMod(long base, long exp, int mod) {\n        long result = 1;\n        long base_mod = base % mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base_mod) % mod;\n            }\n            base_mod = (base_mod * base_mod) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int p = sc.nextInt();\n        int k = sc.nextInt();\n\n        // The original code for gen is commented out, no output needed\n        // System.out.println(gen(new ArrayList<>(), p, k, 0));\n        System.out.println(solve(p, k));\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.029394950717687607, -0.0007266097818501294, -1.5048530030981055e-06, -8.006006828509271e-05, -1.981667537620524e-06, -4.320199877838604e-07, -9.960946772480384e-