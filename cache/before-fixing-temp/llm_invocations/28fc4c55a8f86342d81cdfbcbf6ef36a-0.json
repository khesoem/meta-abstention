\n\n        if (dist[x][y][z] != d) continue; // Lazy delete\n\n        if (z == 0) {\n            int rem_x = cnt1 - x;\n            int rem_y = cnt2 - y;\n            for (int i = 0; i <= rem_x; i++) {\n                for (int j = 0; j <= rem_y; j++) {\n                    if (i == 0 && j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int nx = x + i;\n                    int ny = y + j;\n                    if (dist[nx][ny][1] >= d + 1) {\n                        if (dist[nx][ny][1] > d + 1) {\n                            dist[nx][ny][1] = d + 1;\n                            pq.emplace(dist[nx][ny][1], nx, ny, 1);\n                            dp[nx][ny][1] = 0;\n                        }\n                        long long val = f(dp[x][y][z], rem_x, i, rem_y, j, nCr);\n                        dp[nx][ny][1] = (dp[nx][ny][1] + val) % mod;\n                    }\n                }\n            }\n        } else {\n            int rem_x = x;\n            int rem_y = y;\n            for (int i = 0; i <= rem_x; i++) {\n                for (int j = 0; j <= rem_y; j++) {\n                    if (i == 0 && j == 0) continue;\n                    if (i * 50 + j * 100 > K) break;\n                    int nx = x - i;\n                    int ny = y - j;\n                    if (dist[nx][ny][1] >= d + 1) {\n                        if (dist[nx][ny][1] > d + 1) {\n                            dist[nx][ny][1] = d + 1;\n                            pq.emplace(dist[nx][ny][1], nx, ny, 1);\n                            dp[nx][ny][1] = 0;\n                        }\n                        long long val = f(dp[x][y][z], rem_x, i, rem_y, j, nCr);\n                        dp[nx][ny][1] = (dp[nx][ny][1] + val) % mod;\n                    }\n                }\n            }\n        }\n    }\n\n    int end_x = cnt1;\n    int end_y = cnt2;\n    long long ans_dist = dist[end_x][end_y][1];\n    if (ans_dist == INF)\n        cout << -1 << \"\\n\";\n  