e, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    private static double Tabs(double n) {\n        return Math.abs(n);\n    }\n\n    private static int solveIt(int x, int y, int b) {\n        double target = (double) x / y;\n        int lb = 0, ub = 1000000;\n        for (int i = 0; i < 25; i++) {\n            int a = (lb + ub) / 2;\n            if ((double) a / b < target) lb = a;\n            else ub = a;\n        }\n        int res = 0;\n        double diff = Double.MAX_VALUE;\n        for (int a = lb - 10; a <= ub + 10; a++) {\n            double d = Tabs((double) a / b - target);\n            if (d < diff) {\n                diff = d;\n                res = a;\n            }\n        }\n        return res;\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int x = sc.nextInt();\n        int y = sc.nextInt();\n        int n = sc.nextInt();\n        int ans1 = 0, ans2 = 1;\n        double bestDiff = Double.MAX_VALUE;\n        for (int b = 1; b <= n; b++) {\n            int a = solveIt(x, y, b);\n            double d = Tabs((double) a / b - (double) x / y);\n            if (d < bestDiff) {\n                bestDiff = d;\n                ans1 = a;\n                ans2 = b;\n            }\n        }\n        System.out.println(ans1 + \"/\" + ans2);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.9907753085135482e-05, 0.0, -1.1920928244535389e-07, -2.729855441430118e-05, -3.576272320060525e-06, -2.3841855067985307e-07, -1.680836794548668e-05, -0.004137527663260698, -0.002480527386069298, -0.00020740265608765185, 0.0, -0.01150449924170971, -0.0009166568052023649, -0.002477197675034404, -1.362750768661499, -2.3841855067985307e-07, -0.001335086883045733, -0.5812520980834961, -2.7418097943154862e-06, -1.1920928244535389e-07, -4.160317621426657e-05, -0