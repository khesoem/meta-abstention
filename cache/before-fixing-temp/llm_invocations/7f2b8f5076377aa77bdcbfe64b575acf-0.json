   if(t2 < t1)l = ave;\n\telse r = ave;\n   }\n   ave = l;\n   if((func(l,i,x,y) > func(r,i,x,y)))ave = r;\n   if(func(ave,i,x,y)  < func(a,b,x,y)){\n    a = ave;\n\tb = i;\n   }\n  }\ncout << a << \"/\" << b;\nreturn 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "openai/gpt-4.1-nano"}, "response": {"samples": [{"content": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        long x = scanner.nextLong();\n        long y = scanner.nextLong();\n        long n = scanner.nextLong();\n\n        long a = 0, b = 1;\n        double t1 = (double) x / y;\n        double h = 0;\n        for (long i = 1; i <= n; i++) {\n            long l = 1, r = 1000000, ave;\n            while (r - l > 1) {\n                ave = (l + r) / 2;\n                double t2 = (double) ave / i;\n                if (t2 < t1) {\n                    l = ave;\n                } else {\n                    r = ave;\n                }\n            }\n            ave = l;\n            if (func(l, i, x, y) > func(r, i, x, y)) {\n                ave = r;\n            }\n            if (func(ave, i, x, y) < func(a, b, x, y)) {\n                a = ave;\n                b = i;\n            }\n        }\n        System.out.println(a + \"/\" + b);\n        scanner.close();\n    }\n\n    static long gcd(int x, int y) {\n        int p = x % y;\n        x = y;\n        y = p;\n        if (y > 0) {\n            return gcd(x, y);\n        }\n        return x;\n    }\n\n    static long lcm(int x, int y) {\n        return (long) x * (long) y / gcd(x, y);\n    }\n\n    static double func(long x1, long y1, long x2, long y2) {\n        long s = lcm((int) y1, (int) y2);\n        long s1 = Math.abs(s / y1 * x1 - s / y2 * x2);\n        return (double) s1 / s;\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.3735063374042511, -6.704273118884885e-