cr(self, n, r):\n            if r < 0 or n < r:\n                return 0\n            return self.mult(self.fact(n), self.mult(self.fInv(r), self.fInv(n-r)))\n        \n        def smallInv(self, n):\n            return self.mult(self.fInv(n), self.fact(n-1))\n        \n        def normalize(self, x):\n            x %= self.modulus()\n            if x < 0:\n                x += self.modulus()\n            return x\n        \n        def add(self, a, b):\n            v = a + b\n            if v >= self.modulus():\n                v -= self.modulus()\n            return v\n        \n        def mult(self, *args):\n            r = 1\n            for x in args:\n                r = self.mult(r, x)\n            return r\n        \n        def mult(self, a, b):\n            return (a * b) % self.modulus()\n        \n        def div(self, a, b):\n            return self.mult(a, self.inv(b))\n        \n        def inv(self, value):\n            MOD = self.modulus()\n            g, x, y = MOD, 0, 1\n            r = value\n            while r != 0:\n                q = g // r\n                g %= r\n                g, r = r, g\n                x, y = y, x - q * y\n            # Ensure g == 1\n            if y < 0:\n                y += MOD\n            return y  # normalized (0 < y < MOD)\n        \n    class Mod998(Modulus):\n        def modulus(self):\n            return 998244353\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n = int(data[0])\n    m = int(data[1])\n    mod = NumberTheory.Mod998()\n    mod.fInv(n + m)  # precompute inverse factorials up to n+m\n    \n    phaseSize = 1\n    p = 1\n    i = 0\n    while p != 0:\n        p = mod.mult(p, n - i, mod.smallInv(n + m - i))\n        phaseSize = mod.add(phaseSize, p)\n        i += 1\n    \n    answer = 0\n    for k in range(1, n+1):\n        sign = mod.paritySign(k + 1)\n        numPhases = mod.div(m + k, k)\n        term = mod.mult(sign, mod.ncr(n, k), numPhases,