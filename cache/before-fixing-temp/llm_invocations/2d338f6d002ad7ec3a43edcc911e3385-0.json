Imag, True)\n\n    res = [0] * need\n    for i in range(need):\n        aa = int(faReal[i] + 0.5)\n        bb = int(fbReal[i] + 0.5) % mod\n        cc = int(faImag[i] + 0.5) % mod\n        value = (aa + (bb << 15) + (cc << 30)) % mod\n        res[i] = int(value)\n    return res\n\ndef fft(a, b, inverse):\n    n = len(a)\n    rev = [0] * n\n    for i in range(1, n):\n        rev[i] = (rev[i >> 1] >> 1) + (0 if (i & 1) == 0 else n // 2)\n    for i in range(1, n):\n        j = rev[i]\n        if i < j:\n            a[i], a[j] = a[j], a[i]\n            b[i], b[j] = b[j], b[i]\n    length = 2\n    while length <= n:\n        half_len = length // 2\n        cs = [0.0] * half_len\n        sn = [0.0] * half_len\n        for i in range(half_len):\n            angle = 2 * math.pi * i / length * (-1 if inverse else 1)\n            cs[i] = math.cos(angle)\n            sn[i] = math.sin(angle)\n        for i in range(0, n, length):\n            for j in range(half_len):\n                wA = cs[j]\n                wB = sn[j]\n                uA = a[i + j]\n                uB = b[i + j]\n                vA = a[i + j + half_len] * wA - b[i + j + half_len] * wB\n                vB = a[i + j + half_len] * wB + b[i + j + half_len] * wA\n                a[i + j] = uA + vA\n                b[i + j] = uB + vB\n                a[i + j + half_len] = uA - vA\n                b[i + j + half_len] = uB - vB\n        length <<= 1\n    if inverse:\n        for i in range(n):\n            a[i] /= n\n            b[i] /= n\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    n = data[0]\n    k = data[1]\n    v = [0] * 10\n    for i in range(k):\n        x = data[2 + i]\n        v[x] = 1\n    ans = [1]\n    p = n // 2\n    while True:\n        if p % 2 != 0:\n            ans = multiply_mod(ans, v, MOD)\n        p //= 2\n        if p == 0:\n            break\n        v = multiply_mod(v, v, MOD)\n    res = 0\n    for x in ans:\n        res = (res 