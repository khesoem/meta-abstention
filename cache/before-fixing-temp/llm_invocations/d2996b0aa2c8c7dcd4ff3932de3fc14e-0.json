 and cols)\n    kraw = []\n    for i in range(1,7):\n        for j in range(1,7):\n            kraw.append((i, j))\n    \n    inv100 = pow(100, MOD-2, MOD)  # modular inverse of 100\n    \n    # dp arrays: 2 halves, each with 2^20 size\n    total_masks = 1 << 20\n    dp0 = [0] * total_masks\n    dp1 = [0] * total_masks\n    \n    # process two halves\n    for half in (0, 1):\n        # select edges\n        edges = kraw[18*half:18*(half+1)]\n        f = 1 if half == 1 else 0\n        \n        # precompute present and absent factors for each edge\n        fp = [0]*18\n        fa = [0]*18\n        for idx, (i,j) in enumerate(edges):\n            p = tab[i][j]\n            fp[idx] = p * inv100 % MOD\n            fa[idx] = (100 - p) * inv100 % MOD\n        \n        # precompute triples of edges (smallest index only) for this half\n        triples = [[] for _ in range(18)]  # list for each edge index (only as smallest)\n        for i in range(18):\n            fi_i, se_i = edges[i]\n            for j in range(i+1, 18):\n                fi_j, se_j = edges[j]\n                if fi_i == fi_j or se_i == se_j:\n                    continue\n                for k in range(j+1, 18):\n                    fi_k, se_k = edges[k]\n                    if fi_i == fi_k or fi_j == fi_k or se_i == se_k or se_j == se_k:\n                        continue\n                    # condition satisfied\n                    key = (1<<se_i) | (1<<se_j) | (1<<se_k)\n                    if f:\n                        key ^= 126\n                    contrib = maska[key]\n                    triples[i].append((j, k, contrib))\n        \n        # dp for subsets of 18 edges\n        subset_size = 1 << 18\n        mask_contrib = [0] * subset_size  # computed mask from triples\n        # we also need probability for each subset (computed on the fly)\n        # iterate masks in increasing order\n        for mask in range(1, subset_size):\n            lsb = mask & -mask\n            bit = (lsb.bit_length() - 1)  # index of the edge added\n            prev = mask ^ lsb\n            cur = mask_contrib[prev]\n            # add contributions from triples involving this edge (as smallest)\n            for j, k, contrib in triples[bit]:\n                if (prev >> j) & 1 and (prev >> k) & 1:\n                    cur |= contrib\n            mask_contrib[mask] = cur\n            \n            # compute probability for this subset\n            p = 1\n            for b in range(18):\n                if (mask >> b) & 1:\n                    p = p * fp[b] % MOD\n                else:\n                    p = p * fa[b] % MOD\n            \n            # accumulate to appropriate dp\n            m = cur\n            if half == 0:\n                dp0[m] = (dp0[m] + p) % MOD\n            else:\n                dp1[m] = (dp1[m] + p) % MOD\n    \n    # SOS DP on dp0 (subset sum over supersets? Actually transform to sum over subsets)\n    # The pattern: for bit 0..19, for mask, if bit set, dp[mask] += dp[mask ^ (1<<bit)]\n    # This makes dp[mask] = sum over all subsets of mask.\n    for bit in range(20):\n        step = 1 << bit\n        for mask in range(total_masks):\n            if mask & step:\n                dp0[mask] = (dp0[mask] + dp0[mask ^ step]) % MOD\n    \n    full = (1 << 20) - 1\n    res = 1\n    for mask in range(total_masks):\n        res = (res - dp0[mask] * dp1[full ^ mask]) % MOD\n    res %= MOD\n    print(res)\n\nif __name__ == '__main__':\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.0001662831346038729, -1.1920928244535389e-07, -3.576278118089249e-07, -0.0020560333505272865, -0.006924678571522236, -8.344646857949556e-07, -0.10034795105457306, -0.1934441179037094, -2.50339189733495e-06, -0.00023755589791107923, -0.04048052057623863, -1.680836794548668e-05, -2.3841855067985307e-07, -5.94836674281396e-05, -0.07895959168672562, -0.002126814564689994, -1.0409153699874878, -0.03805369511246681, -7.748573807475623e-06, 