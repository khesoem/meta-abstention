u, int v, int val_, int w_) {\n        addEdge(u, v, val_, w_);\n        addEdge(v, u, 0, -w_);\n    }\n    \n    static boolean SPFA() {\n        Arrays.fill(dis, 1, tot + 1, INF);\n        ArrayDeque<Integer> q = new ArrayDeque<>();\n        q.addLast(s);\n        dis[s] = 0;\n        vis[s] = true;\n        while (!q.isEmpty()) {\n            int u = q.pollFirst();\n            vis[u] = false;\n            for (int i = head[u]; i != 0; i = next[i]) {\n                int v = to[i];\n                if (val[i] > 0 && dis[v] > dis[u] + w[i]) {\n                    dis[v] = dis[u] + w[i];\n                    pre[v] = i;\n                    if (!vis[v]) {\n                        vis[v] = true;\n                        q.addLast(v);\n                    }\n                }\n            }\n        }\n        return dis[t] < INF;\n    }\n    \n    static Cf mcmf() {\n        Cf res = new Cf();\n        while (SPFA()) {\n            int flow = INF;\n            for (int x = t; x != s; x = to[pre[x] ^ 1]) {\n                flow = Math.min(flow, val[pre[x]]);\n            }\n            for (int x = t; x != s; x = to[pre[x] ^ 1]) {\n                val[pre[x]] -= flow;\n                val[pre[x] ^ 1] += flow;\n            }\n            res.f += flow;\n            res.c += dis[t] * flow;\n        }\n        return res;\n    }\n    \n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        m = Integer.parseInt(st.nextToken());\n        k = Integer.parseInt(st.nextToken());\n        c = Integer.parseInt(st.nextToken());\n        d = Integer.parseInt(st.nextToken());\n        \n        int cs = 2 * k;\n        tot = cs * n;\n        s = tot + 1;\n        t = tot + 2;\n        tot = t; // total nodes: cs*n + 2\n        \n        head = new int[tot + 1];\n        dis = new int[tot + 1];\n        vis = new boolean[tot + 1];\n        pre = new int[tot + 1];\n        \n        int maxEdges = M * 2 + 5;\n        to = new int[maxEdges];\n        next = new int[maxEdges];\n        val = new int[maxEdges];\n        w = new int[maxEdges];\n        edgeId = 1;\n        \n        st = new StringTokenizer(br.readLine());\n        int[][] E = new int[m + 1][2];\n        for (int i = 1; i <= k; i++) {\n            int tp = Integer.parseInt(st.nextToken());\n            add(s, P(0, tp), 1, 0);\n        }\n        \n        for (int i = 1; i <= m; i++) {\n            st = new StringTokenizer(br.readLine());\n            E[i][0] = Integer.parseInt(st.nextToken());\n            E[i][1] = Integer.parseInt(st.nextToken());\n        }\n        \n        for (int i = 1; i <= cs - 1; i++) {\n            add(P(i, 1), t, k, c * i);\n            for (int j = 1; j <= n; j++) {\n                add(P(i - 1, j), P(i, j), k, 0);\n            }\n            for (int j = 1; j <= m; j++) {\n                int u = E[j][0];\n                int v = E[j][1];\n                for (int tt = 1; tt <= k; tt++) {\n                    int cost = (2 * tt - 1) * d;\n                    add(P(i - 1, u), P(i, v), 1, cost);\n                    add(P(i - 1, v), P(i, u), 1, cost);\n                }\n            }\n        }\n        \n        Cf result = mcmf();\n        System.out.println(result.c);\n    }\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.8980677345534787e-05, -1.1920928244535389e-07, -7.152555099310121e-07, -0.00036542891757562757, -0.002034024568274617, -8.344646857949556e-07, -0.02324579656124115, -0.16034890711307526, -2.3841855067985307e-07, -1.1920928244535389e-07, -3.576272320060525e-06, -0.0008086272282525897, -0.0003010773507412523, -2.3841855067985307e-07, -0.0006760457181371748, -0.001978346612304449, -0.00043883229955099523, -0.016203967854380608, -0.032087210565805435, -3.93382906622719e-05, -0.0189853403717