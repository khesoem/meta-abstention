MinCostFlow {\n        static class Edge {\n            int v;\n            long c;\n            long w;\n            int r;\n\n            Edge(int v, long c, long w, int r) {\n                this.v = v;\n                this.c = c;\n                this.w = w;\n                this.r = r;\n            }\n        }\n\n        ArrayList<ArrayList<Edge>> G;\n\n        MinCostFlow(int n) {\n            G = new ArrayList<>(n);\n            for (int i = 0; i < n; i++) {\n                G.add(new ArrayList<>());\n            }\n        }\n\n        void add(int u, int v, long c, long w) {\n            int i = G.get(u).size();\n            int j = G.get(v).size();\n            G.get(u).add(new Edge(v, c, w, j));\n            G.get(v).add(new Edge(u, 0, -w, i));\n        }\n\n        long run(int s, int t, long f) {\n            int N = G.size();\n            long res = 0;\n            long[] H = new long[N];\n            long[] D = new long[N];\n            long INF = Long.MAX_VALUE / 2;\n            int[] PV = new int[N];\n            int[] PE = new int[N];\n\n            while (f > 0) {\n                // Priority queue for (distance, vertex), min-heap\n                PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[0]));\n                for (int i = 0; i < N; i++) D[i] = INF;\n                D[s] = 0;\n                pq.add(new long[]{0, s});\n\n                while (!pq.isEmpty()) {\n                    long[] top = pq.poll();\n                    long d = top[0];\n                    int u = (int) top[1];\n                    if (D[u] < d) continue;\n                    for (int i = 0; i < G.get(u).size(); i++) {\n                        Edge e = G.get(u).get(i);\n                        if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n                            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n                            pq.add(new long[]{D[e.v], e.v});\n                            PV[e.v] = u;\n                     