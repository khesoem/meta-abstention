aper2[i] = sc.nextInt();\n        }\n\n        System.out.println(minimum(n, rock1, sci1, paper1, rock2, sci2, paper2));\n        System.out.println(maximum(n, rock1, sci1, paper1, rock2, sci2, paper2));\n    }\n\n    static int minimum(int n, int[] rock1, int[] sci1, int[] paper1, int[] rock2, int[] sci2, int[] paper2) {\n        int ans = n;\n        int[][] l = new int[3][2];\n        int[][] l1 = new int[(int)Math.pow(3, n)][2][2];\n        int[][] l2 = new int[(int)Math.pow(3, n)][2][2];\n\n        for (int i = 0; i < 3; i++) {\n            l[i][0] = rock1[i];\n            l[i][1] = i + 1;\n        }\n\n        for (int i = 0; i < (int)Math.pow(3, n); i++) {\n            l1[i] = l.clone();\n        }\n\n        for (int i = 0; i < 3; i++) {\n            l[i][0] = rock2[i];\n            l[i][1] = i + 1;\n        }\n\n        for (int i = 0; i < (int)Math.pow(3, n); i++) {\n            l2[i] = l.clone();\n        }\n\n        for (int i = 0; i < (int)Math.pow(3, n); i++) {\n            for (int j = 0; j < (int)Math.pow(3, n); j++) {\n                ans = Math.min(ans, give(l1[i], l2[j]));\n            }\n        }\n\n        return ans;\n    }\n\n    static int give(int[][] l1, int[][] l2) {\n        int ans = 0;\n        int[] curr1 = new int[2];\n        int[] curr2 = new int[2];\n        int[][] tempL1 = l1.clone();\n        int[][] tempL2 = l2.clone();\n\n        while (tempL1.length > 0 && tempL2.length > 0) {\n            try {\n                if (curr1[0] == 0) {\n                    curr1 = tempL1[0].clone();\n                    tempL1 = Arrays.copyOfRange(tempL1, 1, tempL1.length);\n                }\n\n                if (curr2[0] == 0) {\n                    curr2 = tempL2[0].clone();\n                    tempL2 = Arrays.copyOfRange(tempL2, 1, tempL2.length);\n                }\n            } catch (ArrayIndexOutOfBoundsException e) {\n                return ans;\n            }\n\n            ans += Math.max(0, Math.min(curr1[0], curr2[0]) * match(c