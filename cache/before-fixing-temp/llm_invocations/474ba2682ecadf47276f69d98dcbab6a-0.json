na = floor(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(floor(a) < mina){\n                    mina = floor(a);\n                    minb = b;                   \n                }\n            }\n            \n            diff(x,y,ceil(a),b,tempa,tempb);        \n            temp = tempa/tempb;\n\n            if(temp < min){\n                mina = ceil(a);\n                minb = b;\n                min = temp;\n            }\n            else if (temp == min){\n                if(ceil(a) < mina){\n                    mina = ceil(a);\n                    minb = b;                   \n                }\n            }\n        }\n    }\n\n    int gc = gcd (mina, minb);\n    if (gc != 1){       \n        mina = mina/gc;\n        minb = minb/gc;\n    }\n\n    cout<<mina<<\"/\"<<minb<<endl;\n\n    return 0;\n}\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport java.util.Scanner;\n\npublic class Main {\n    public static int gcd(int x, int y) {\n        int g = (x > y) ? x : y;\n        while (true) {\n            if (x % g == 0 && y % g == 0) break;\n            g--;\n        }\n        return g;\n    }\n\n    public static double[] diff(double x, double y, double a, double b) {\n        double num = Math.abs(x * b - y * a);\n        double den = y * b;\n        return new double[]{num, den};\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        double x = sc.nextDouble();\n        double y = sc.nextDouble();\n        double n = sc.nextDouble();\n        double min = 1000000.0;\n        int mina = 0, minb = 0;\n\n        if (n > y) {\n            int gc = gcd((int) x, (int) y);\n            if (gc != 1) {\n                x = x / gc;\n                y = y / gc;\n            }\n            System.out.println((int) x + \"/\" + (int) y);\n            sc.close();\n            return;\n        }\n\n        for (int i = (int) n; i >= 1; i--) {\n            double b = (double) i;\n            double a = (x * b) / y;\n\n            if (a == Math.floor(a)) {\n                mina = (int) a;\n                minb = (int) b;\n                break;\n            } else {\n                double floorA = Math.floor(a);\n                double[] res = diff(x, y, floorA, b);\n                double temp = res[0] / res[1];\n\n                if (temp < min) {\n                    mina = (int) floorA;\n                    minb = (int) b;\n                    min = temp;\n                } else if (temp == min) {\n                    if (floorA < mina) {\n                        mina = (int) floorA;\n                        minb = (int) b;\n                    }\n                }\n\n                double ceilA = Math.ceil(a);\n                res = diff(x, y, ceilA, b);\n                temp = res[0] / res[1];\n\n                if (temp < min) {\n                    mina = (int) ceilA;\n                    minb = (int) b;\n                    min = temp;\n                } else if (temp == min) {\n                    if (ceilA < mina) {\n                        mina = (int) ceilA;\n                        minb = (int) b;\n                    }\n                }\n            }\n        }\n\n        int gc = gcd(mina, minb);\n        if (gc != 1) {\n            mina = mina / gc;\n            minb = minb / gc;\n        }\n\n        System.out.println(mina + \"/\" + minb);\n        sc.close();\n    }\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.01477643009275198, -9.179073458653875e-06, 0.0, -1.1920928244535389e-07, -0.0001551984460093081, -8.83301836438477e-05, 0.0, -5.8412379075889476e-06, -0.00045265440712682903, -0.20146313309669495, -6.818538531661034e-05, -1.1920928244535389e-07, -0.10387244075536728, -0.011071676388382912, -0.0298085045069456