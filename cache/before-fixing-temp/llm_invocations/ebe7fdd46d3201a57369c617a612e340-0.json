n\nclass Test:\n    def __init__(self):\n        self.writer = sys.stdout\n        self.R = 0\n        self.C = 0\n        self.ch = [[0]*61 for _ in range(61)]\n        self.cntA = [0]*61\n        self.cntB = [0]*61\n        self.best = float('inf')\n        self.str = \"\"\n        self.cache = {}\n        self.tried = set()\n\n    def start(self):\n        self.R = self.readInt()\n        self.C = self.readInt()\n        for i in range(2*(self.R + self.C) + 1):\n            for j in range(i + 1):\n                if j == 0 or j == i:\n                    self.ch[i][j] = 1\n                else:\n                    self.ch[i][j] = self.ch[i-1][j-1] + self.ch[i-1][j]\n        x, y = 0, 0\n        v1, v2 = self.R + self.C, self.R + self.C\n        while v1 >= self.R and v2 >= self.R:\n            if x > y:\n                cur = self.ch[v1][self.R] - self.ch[v1 - 1][self.R]\n                other = self.ch[v2][self.R]\n                y += cur * other\n                v1 -= 1\n            else:\n                cur = self.ch[v2][self.R] - self.ch[v2 - 1][self.R]\n                other = self.ch[v1][self.R]\n                x += cur * other\n                v2 -= 1\n        self.best = abs(x - y)\n        self.dfs(0, 0, self.R + self.C, self.R + self.C)\n        self.str = sys.stdin.read()\n        str_len = len(self.str)\n        for i in range(str_len):\n            self.cntA[i + 1] = self.cntA[i] + (1 if self.str[i] == 'A' else 0)\n            self.cntB[i + 1] = self.cntB[i] + (1 if self.str[i] == 'B' else 0)\n        ans = self.solve(0, 0, self.R + self.C, self.R + self.C)\n        self.writer.write(str(ans) + \"\\n\")\n        self.writer.flush()\n\n    def readInt(self):\n        ans = 0\n        neg = False\n        start = False\n        while True:\n            c = sys.stdin.read(1)\n            if c == '' or c == '\\n':\n                break\n            if c == '-':\n                start = True\n                neg = True\n                continue\n            elif c.isdigit():\n                start = True\n                ans = ans * 10 + int(c)\n            elif start:\n                break\n        return -ans if neg else ans\n\n    def readLong(self):\n        return self.readInt()  # Same as readInt() for Python\n\n    def readString(self):\n        s = \"\"\n        start = False\n        while True:\n            c = sys.stdin.read(1)\n            if c == '' or c == '\\n':\n                break\n            if not c.isspace():\n                start = True\n                s += c\n            elif start:\n                break\n        return s\n\n    def dfs(self, x, y, v1, v2):\n        diff = abs(x - y)\n        if self.best <= 1 or diff - self.ch[v1][self.R] * self.ch[v2][self.R] >= self.best:\n            return\n        if v1 == self.R - 1 and v2 == self.R - 1:\n            if diff < self.best:\n                self.best = diff\n            return\n        key = x*10000 + v1*100 + v2\n        if key in self.tried:\n            return\n        if v1 >= self.R:\n            cur = self.ch[v1][self.R] - self.ch[v1 - 1][self.R]\n            other = self.ch[v2][self.R]\n            self.dfs(x, y + cur * other, v1 - 1, v2)\n        if v2 >= self.R:\n            cur = self.ch[v2][self.R] - self.ch[v2 - 1][self.R]\n            other = self.ch[v1][self.R]\n            self.dfs(x + cur * other, y, v1, v2 - 1)\n        self.tried.add(key)\n\n    def solve(self, x, y, v1, v2):\n        diff = abs(x - y)\n        if diff - self.ch[v1][self.R] * self.ch[v2][self.R] > self.best:\n            return 0\n        key = x*10000 + v1*100 + v2\n        v = self.cache.get(key)\n        if v is not None:\n            return v\n        if v1 < self.R or v2 < self.R:\n            sum_xy = v1 + v2\n            if v1 >= self.cntA[sum_xy] and v2 >= self.cntB[sum_xy]:\n                v1 -= self.cntA[sum_xy]\n                v2 -= self.cntB[sum_xy]\n                return self.ch[v1 + v2][v1]\n            return 0\n        ans = 0\n        c = self.str[v1 + v2 - 1]\n        if c != 'B':\n            cur = self.ch[v1][self.R] - self.ch[v1 - 1][self.R]\n            other = self.ch[v2][self.R]\n            ans += self.solve(x, y + cur * other, v1 - 1, v2)\n        if c != 'A':\n            cur = self.ch[v2][self.R] - self.ch[v2 - 1][self.R]\n            other = self.ch[v1][self.R]\n            ans += self.solve(x + cur * other, y, v1, v2 - 1)\n        self.cache[key] = ans\n        return ans\n\ntest = Test()\ntest.start()\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.00026264708139933646, -0.00013798571308143437, -7.896309739408025e-07, -0.00013357517309486866, -0.0059620994143188, -4.961759259458631e-06, -0.11354479938745499, -0.3607618808746338, -1.981667537620524e-06, -6.837811088189483e-05, -0.0005586316110566258, -0.000170882252859883, -1.2664456789934775e-06, 0.0, 0.0, -1.9361264946837764e-07, -3.4121114822482923e-06, -1.8624639324116288e-06, -0.0016286444151774049, -0.03601999580860138, -1.318681188422488e-05, -0.0029301566537469625, -0.00015014449309092015, -0.014426976442337036, -9.088346359931165e-07, -5.300083648762666e-05, -1.652451464906335e-05, -0.009760456159710884, -2.8206473871250637e-05, -1.9361264946837764e-07, -2.339278580620885e-06, 0.0, 0.0, 0.0, -5.512236498361744e-07, -2.935296834039036e-06, 0.0, -3.173704271830502e-06, -3.128163257315464e-07, -0.00010521204239921644, -7.896309739408025e-07, -1.1472419600977446e-06, -6.704273118884885e-07, -1.3856492842023727e-06, -0.24471573531627655, -0.004119361750781536, -1.9361264946837764e-07, 0.0, -1.5690089639974758e-05, -6.704273118884885e-07, -3.7697225252486533e-06, -5.204720582696609e-05, -0.009958301670849323, -5.512236498361744e-07, -1.5048530030981055e-06, -3.128163257315464e-07, -3.054500666621607e-06, 0.0, -3.292907877039397e-06, 0.0, -1.9361264946837764e-07, -0.00045712877181358635, -6.2729995988775045e-06, -1.5690089639974758e-05, 0.0, 0.0, -4.320199877838604e-07, 0.0, -1.9361264946837