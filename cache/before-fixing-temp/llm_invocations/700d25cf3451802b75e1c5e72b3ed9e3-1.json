():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, p = map(int, data[:3])\n    pp = p * p  # not used in Python, kept for compatibility but not needed\n\n    if n & 1:\n        print(fast_pow(k, n, p))\n        return\n\n    maxi = lower(n + 1) - 1\n    fac, inv = init(maxi, p)\n\n    ct = [0] * (maxi + 1)\n    for i in range(maxi + 1):\n        ct[i] = bin(i).count('1')  # popcount\n\n    # tmp2: layers 0..19 each of size maxi+1\n    max_layers = 20\n    tmp2 = [[0] * (maxi + 1) for _ in range(max_layers)]\n    for i in range(maxi + 1):\n        tmp2[ct[i]][i] = inv[i]\n    for layer in range(max_layers):\n        FWT(tmp2[layer], maxi + 1, p, invert=False)\n\n    f = [0] * (maxi + 1)\n    f[0] = 1\n\n    res_k = k\n    # exponentiation loop\n    while k:\n        if k & 1:\n            # multi()\n            # Build tmp1 from f\n            tmp1 = [[0] * (maxi + 1) for _ in range(max_layers)]\n            for j in range(maxi + 1):\n                tmp1[ct[j]][j] = f[j] % p\n            for layer in range(max_layers):\n                FWT(tmp1[layer], maxi + 1, p, invert=False)\n\n            # t: 20 arrays to store sums (use Python ints)\n            t = [[0] * (maxi + 1) for _ in range(max_layers)]\n            for q in range(max_layers):\n                for l in range(max_layers - q):\n                    for s in range(maxi + 1):\n                        t[q + l][s] += tmp1[q][s] * tmp2[l][s]\n            # tmp3 = t mod p\n            tmp3 = [[0] * (maxi + 1) for _ in range(max_layers)]\n            for q in range(max_layers):\n                for s in range(maxi + 1):\n                    tmp3[q][s] = t[q][s] % p\n\n            # Inverse FWT on tmp3\n            for layer in range(max_layers):\n                FWT(tmp3[layer], maxi + 1, p, invert=True)\n\n            # Update f\n            for j in range(maxi + 1):\n                f[j] = tmp3[ct[j]][j] % p\n\n        k >>= 1\n        if k:\n            # multi2()\n            # t arrays for squaring tmp2\n            t = [[0] * (maxi + 1) for _ in range(max_layers)]\n            for q in range(max_layers):\n                for l in range(max_layers - q):\n                    for s in range(maxi + 1):\n                        t[q + l][s] += tmp2[q][s] * tmp2[l][s]\n            tmp = [[0] * (maxi + 1) for _ in range(max_layers)]\n            for q in range(max_layers):\n                for s in range(maxi + 1):\n                    tmp[q][s] = t[q][s] % p\n\n            # Inverse FWT on tmp\n            for layer in range(max_layers):\n                FWT(tmp[layer], maxi + 1, p, invert=True)\n\n            # Rebuild tmp2: set after inverse FWT, then forward FWT again\n            new_tmp2 = [[0] * (maxi + 1) for _ in range(max_layers)]\n            for i in range(maxi + 1):\n                new_tmp2[ct[i]][i] = tmp[ct[i]][i] % p\n            for layer in range(max_layers):\n                FWT(new_tmp2[layer], maxi + 1, p, invert=False)\n            tmp2 = new_tmp2\n\n    ans = (fast_pow(res_k, n, p) - fac[n] * f[n]) % p\n    if ans < 0:\n        ans += p\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.08010183274745941, -2.038458114839159e-05, -1.1920928244535389e-07, 0.0, -0.0004673104267567396, -0.0032768147066235542, -7.60526381782256e-05, -0.04863059148192406, -1.347484827041626, -0.00020966715237591416, -2.13382354559144e-05, -0.0297507643699646, -1.8596476365928538e-05, -1.3232143828645349e-05, -1.1920928244535389e-07, -0.00013553177996072918, -0.0002348147245356813, -1.1920928244535389e-07, -1.7881377516459906e-06, -1.081489086151123, -0.4032147526741028, -0.14063332974910736, -4.410734163684538e-06, 0.0, -7.152531907195225e-06, -0.006716177798807621, 0.0, -0.023257093504071236, -0.0486721508204937, -5.435795901576057e-05, -5.960462772236497e-07, -0.0001284993631998077, -0.0024764842819422483, 0.0, -1.1920928244535389e-07, -3.588