{"prompt": {"messages": [{"role": "system", "content": "You are a helpful assistant that translates C++ code to Python 3 code. The code should reads and writes I/O from the console."}, {"role": "user", "content": "Translate the following GNU C++14 code to Python 3 code. The code reads and writes I/O from the console. Your translated code should have the exact same functionality as the given code, meaning that it should have the same output for any given input.\nPrint your translated code and also the confidence score you give to your translation. The confidence score should be a number between 0 and 1. The format of the output should be:\n<translated_code>\n<your_translated_code>\n</translated_code>\n<confidence>\n<your_confidence_score>\n</confidence>\nDo not provide any other text or markdown fences.\n\nHere is the original GNU C++14 code you have to translate:\n<original_code>\n#include <bits/stdc++.h>\n\n#define rep(i, n) for (int i = 0; i < (n); i++)\n#define repr(i, n) for (int i = (n) - 1; i >= 0; i--)\n\nusing namespace std;\nusing ll = long long;\n\nstruct mincostflow {\n  struct edge {\n    int v;\n    long long c;\n    long long w;\n    int r;\n  };\n\n  vector<vector<edge>> G;\n\n  mincostflow(int n) : G(n) {}\n\n  void add(int u, int v, long long c, long long w) {\n    int i = G[u].size();\n    int j = G[v].size();\n    G[u].push_back({v, c, w, j});\n    G[v].push_back({u, 0, -w, i});\n  }\n\n  long long run(int s, int t, long long f) {\n    const int N = G.size();\n    long long res = 0;\n    vector<long long> H(N);\n    vector<long long> D(N);\n    const long long INF = 1e18;\n    vector<int> PE(N), PV(N);\n    while (f > 0) {\n      priority_queue<pair<long long, int>> q;\n      fill(D.begin(), D.end(), INF);\n      D[s] = 0;\n      q.emplace(0, s);\n      while (!q.empty()) {\n        long long d = -q.top().first;\n        int u = q.top().second;\n        q.pop();\n        if (D[u] < d) continue;\n        for (int i = 0; i < G[u].size(); i++) {\n          edge e = G[u][i];\n          if (e.c > 0 && D[e.v] > D[u] + e.w + H[u] - H[e.v]) {\n            D[e.v] = D[u] + e.w + H[u] - H[e.v];\n            q.emplace(-D[e.v], e.v);\n            PV[e.v] = u;\n            PE[e.v] = i;\n          }\n        }\n      }\n      if (D[t] == INF) return -1;\n      for (int i = 0; i < N; i++) H[i] += D[i];\n      long long d = f;\n      for (int i = t; i != s; i = PV[i]) {\n        d = min(d, G[PV[i]][PE[i]].c);\n      }\n      f -= d;\n      res += d * H[t];\n      for (int i = t; i != s; i = PV[i]) {\n        edge &e = G[PV[i]][PE[i]];\n        e.c -= d;\n        G[i][e.r].c += d;\n      }\n    }\n    return res;\n  }\n};\n\nint main() {\n  cin.tie(nullptr);\n  ios::sync_with_stdio(false);\n  ll N, M, K, C, D;\n  cin >> N >> M >> K >> C >> D;\n  vector<int> A(K);\n  rep(i, K) cin >> A[i], A[i]--;\n  vector<int> us(M), vs(M);\n  rep(i, M) {\n    cin >> us[i] >> vs[i];\n    us[i]--;\n    vs[i]--;\n  }\n  mincostflow mcf(N*101+2);\n  int s = N*101;\n  int t = s + 1;\n  for (int i = 0; i < K; i++) {\n    mcf.add(s, A[i], 1, 0);\n  }\n  for (int i = 0; i <= 100; i++) {\n    mcf.add(N * i, t, K, C*i);\n  }\n  for (int i = 0; i < 100; i++) {\n    for (int j = 0; j < N; j++) {\n      mcf.add(i*N+j, (i+1)*N+j, K, 0);\n    }\n    for (int j = 0; j < M; j++) {\n      for (int k = 1; k <= K; k++) {\n        mcf.add(N*i + us[j], N*(i+1) + vs[j], 1, (2*k-1)*D);\n        mcf.add(N*i + vs[j], N*(i+1) + us[j], 1, (2*k-1)*D);\n      }\n    }\n  }\n  cout << mcf.run(s, t, K) << '\\n';\n}\n\n</original_code>\n"}], "temp": 0, "sample_size": 1, "logprobs": true, "model": "deepseek/deepseek-v4-flash"}, "response": {"samples": [{"content": "<translated_code>\nimport sys\nimport heapq\n\nclass MinCostFlow:\n    class Edge:\n        __slots__ = ('v', 'c', 'w', 'r')\n        def __init__(self, v, c, w, r):\n            self.v = v\n            self.c = c  # capacity\n            self.w = w  # cost\n            self.r = r  # reverse edge index\n\n    def __init__(self, n):\n        self.n = n\n        self.G = [[] for _ in range(n)]\n\n    def add_edge(self, u, v, c, w):\n        self.G[u].append(MinCostFlow.Edge(v, c, w, len(self.G[v])))\n        self.G[v].append(MinCostFlow.Edge(u, 0, -w, len(self.G[u]) - 1))\n\n    def run(self, s, t, f):\n        N = self.n\n        res = 0\n        H = [0] * N\n        INF = 10**18\n        while f > 0:\n            dist = [INF] * N\n            prevv = [-1] * N\n            preve = [-1] * N\n            dist[s] = 0\n            pq = [(0, s)]\n            while pq:\n                d, u = heapq.heappop(pq)\n                if dist[u] < d:\n                    continue\n                for i, e in enumerate(self.G[u]):\n                    if e.c > 0 and dist[e.v] > dist[u] + e.w + H[u] - H[e.v]:\n                        dist[e.v] = dist[u] + e.w + H[u] - H[e.v]\n                        heapq.heappush(pq, (dist[e.v], e.v))\n                        prevv[e.v] = u\n                        preve[e.v] = i\n            if dist[t] == INF:\n                return -1\n            for i in range(N):\n                if dist[i] < INF:\n                    H[i] += dist[i]\n            d = f\n            v = t\n            while v != s:\n                d = min(d, self.G[prevv[v]][preve[v]].c)\n                v = prevv[v]\n            f -= d\n            res += d * H[t]\n            v = t\n            while v != s:\n                e = self.G[prevv[v]][preve[v]]\n                e.c -= d\n                self.G[v][e.r].c += d\n                v = prevv[v]\n        return res\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    N = int(next(it))\n    M = int(next(it))\n    K = int(next(it))\n    C = int(next(it))\n    D = int(next(it))\n    A = [int(next(it)) - 1 for _ in range(K)]\n    us = []\n    vs = []\n    for _ in range(M):\n        us.append(int(next(it)) - 1)\n        vs.append(int(next(it)) - 1)\n\n    mcf = MinCostFlow(N * 101 + 2)\n    s = N * 101\n    t = s + 1\n\n    for a in A:\n        mcf.add_edge(s, a, 1, 0)\n\n    for i in range(101):\n        mcf.add_edge(N * i, t, K, C * i)\n\n    for i in range(100):\n        for j in range(N):\n            mcf.add_edge(i * N + j, (i + 1) * N + j, K, 0)\n        for j in range(M):\n            for k in range(1, K + 1):\n                mcf.add_edge(N * i + us[j], N * (i + 1) + vs[j], 1, (2 * k - 1) * D)\n                mcf.add_edge(N * i + vs[j], N * (i + 1) + us[j], 1, (2 * k - 1) * D)\n\n    print(mcf.run(s, t, K))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-1.2159274e-05, 0.0, -1.6689287e-06, -0.0015135272, -0.008388523, -0.2521025, -0.0046847826, -0.011060712, -0.0041911863, -0.12707241, -0.017547129, -0.010327825, -1.0251946e-05, -3.6954812e-06, -1.0490363e-05, -4.410734e-06, -0.69418365, -0.0001849957, -1.9073468e-06, -8.344647e-07, -0.3132708, 0.0, -2.3841855e-07, -5.960463e-07, -2.384183e-06, -0.011844662, -0.011050573, -3.5404533e-05, -1.1920928e-07, -0.00015901255, -5.960463e-07, -1.1920928e-07, 0.0, -1.1920928e-07, -2.3841855e-07, -0.0007105925, -6.12717e-05, -9.536698e-06, 0.0, -1.1920928e-07, 0.0, -1.1920928e-07, -2.3841855e-07, -1.1920928e-07, -2.1576649e-05, -0.005241936, -1.716599e-05, -2.3841855e-07, 0.0, -2.3841855e-07, -5.7220295e-06, -1.4305105e-06, -3.0994368e-06, -9.5367386e-07, 0.0, -1.9073468e-06, -1.0132739e-05, -0.121238366, -3.3378547e-06, 0.0, 0.0, 0.0, -3.4570635e-06, -3.530272, 0.0, -0.0018057008, -0.0024252308, -1.1920928e-07, 0.0, -1.1920928e-07, 0.0, 0.0, -8.8330184e-05, -1.072883e-06, -0.018217973, -0.97518027, -1.1920928e-07, 0.0, -1.1920928e-07, 0.0, -3.576278e-07, -0.0006580571, 0.0, -0.044068065, -0.014215632, -0.00010883216, -0.007017134, -5.245195e-06, -2.2053475e-05, -3.576278e-07, 0.0, -1.1920928e-07, -2.3841855e-07, 0.0, -1.668916e-05, -9.7389246e-05, 0.0, -2.9802277e-06, -0.564572, -2.0265559e-06, -3.576278e-07, -5.2569914e-05, 0.0, -8.106199e-06, -0