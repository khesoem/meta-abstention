cost};\n    g[u].push_back(fw);\n    g[v].push_back(rev);\n}\n\nbool spfa(int s, int t) {\n    fill(pi.begin(), pi.end(), INF);\n    fill(inq.begin(), inq.end(), false);\n    queue<int> q;\n    pi[s] = 0;\n    q.push(s);\n    inq[s] = true;\n    while (!q.empty()) {\n        int u = q.front(); q.pop();\n        inq[u] = false;\n        int d = dd[u] + 1;\n        for (int i = 0; i < (int)g[u].size(); ++i) {\n            Edge& e = g[u][i];\n            if (e.cap > 0) {\n                int v = e.to;\n                int p = pi[u] + e.cost;\n                if (p < pi[v] || (p == pi[v] && d < dd[v])) {\n                    pi[v] = p;\n                    dd[v] = d;\n                    prev[v] = u;\n                    prevedge[v] = i;\n                    if (!inq[v]) {\n                        inq[v] = true;\n                        q.push(v);\n                    }\n                }\n            }\n        }\n    }\n    return pi[t] != INF;\n}\n\nint min_cost_flow(int s, int t) {\n    int total_cost = 0;\n    while (spfa(s, t)) {\n        int path_cost = 0;\n        int v = t;\n        while (v != s) {\n            int u = prev[v];\n            int ei = prevedge[v];\n            path_cost += g[u][ei].cost;\n            v = u;\n        }\n        total_cost += path_cost;\n        // push 1 unit\n        v = t;\n        while (v != s) {\n            int u = prev[v];\n            int ei = prevedge[v];\n            Edge& e = g[u][ei];\n            e.cap--;\n            g[v][e.rev].cap++;\n            v = u;\n        }\n    }\n    return total_cost;\n}\n\nint main() {\n    int n, m, k, c, d;\n    scanf(\"%d%d%d%d%d\", &n, &m, &k, &c, &d);\n    vector<int> start(k);\n    for (int i = 0; i < k; ++i) {\n        scanf(\"%d\", &start[i]);\n        --start[i];\n    }\n    vector<vector<int>> orig(n);\n    for (int i = 0; i < m; ++i) {\n        int u, v;\n        scanf(\"%d%d\", &u, &v);\n        --u; --v;\n        orig[u].push_back(v);\n        orig[v].push_back(u);\n    }\n    int t = n + k + 1;\n    int src = n * t;\n    int sink = t - 1;   // 0 * t + t - 1\n    N = src + 1;\n    g.resize(N);\n    pi.resize(N);\n    dd.resize(N, 0);\n    prev.resize(N);\n    prevedge.resize(N);\n    inq.resize(N, false);\n\n    // build flow network\n    for (int i = 0; i < n; ++i) {\n        for (int s = 0; s < t - 1; ++s) {\n            int u = i * t + s;\n            // edges to neighbours at next time step\n            for (int j : orig[i]) {\n                int v = j * t + s + 1;\n                for (int x = 1; x <= k; ++x) {\n                    add_edge(u, v, 1, c + (2 * x - 1) * d);\n                }\n            }\n            // stay edge\n            int v = u + 1;\n            add_edge(u, v, k, (i == 0 ? 0 : c));\n        }\n    }\n    // source to initial positions\n    for (int h = 0; h < k; ++h) {\n        add_edge(src, start[h] * t + 0, 1, 0);\n    }\n\n    int ans = min_cost_flow(src, sink);\n    printf(\"%d\\n\", ans);\n    return 0;\n}\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-0.00028761065914295614, 0.0, -3.4570634852570947e-06, -0.0002227773511549458, -0.0012774649076163769, -2.622600959512056e-06, -3.576278118089249e-07, -5.960462772236497e-07, -1.680836794548668e-05, 0.0, 0.0, -1.8954096958623268e-05, -5.960462772236497e-07, 0.0, 0.0, -2.3841855067985307e-07, -7.152555099310121e-07, 0.0, 0.0, -4.0531076592742465e-06, -0.01418777834624052, -2.3502988815307617, -9.60780744208023e-05, 0.0, -0.16023151576519012, -6.937739817658439e-05, -1.0609570381348021e-05, -1.1920928244535389e-07, -8.344646857949556e-07, -4.768370445162873e-07, 0.0, -2.3841855067985307e-07, 0.0, -6.198863957251888e-06, 0.0, -3.576278118089249e-07, 0.0, -1.1920928244535389e-07, -2.3841855067985307e-07, -1.1920928244535389e-07, -9.178694017464295e-05, -2.50339189733495e-06, -5.960462772236497e-07, -3.814689989667386e-06, -0.00025078488397412, 0.0, 0.0, -0.000161038784426637, -2.3841855067985307e-07, -0.029800519347190857, -1.