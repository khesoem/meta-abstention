% p\n        return res\n    else:\n        r = pow_convol(a, k >> 1, p)\n        res = [0] * n\n        for i in range(n):\n            if r[i] == 0:\n                continue\n            for j in range(n - i):\n                res[i + j] = (res[i + j] + r[i] * r[j]) % p\n        return res\n\n# ------------------------------------------------------------\n# Subset power convolution\n# ------------------------------------------------------------\ndef subset_pow_convol(a, k, p):\n    LOGN = 19\n    MAXSIZE = 1 << LOGN\n    n = len(a)\n    # round up to power of two\n    while n & (n - 1):\n        n += n & -n\n    # static-like arrays\n    fa = [[0] * MAXSIZE for _ in range(LOGN)]\n    fc = [[0] * MAXSIZE for _ in range(LOGN)]\n    # fill fa\n    for i in range(LOGN):\n        for j in range(n):\n            if bit_count(j) == i:\n                fa[i][j] = a[j] if j < len(a) else 0\n            else:\n                fa[i][j] = 0\n    # forward transform\n    for i in range(LOGN):\n        transform(fa[i], n, p, 0)\n    # power convolution per column\n    for j in range(n):\n        va = [fa[i][j] for i in range(LOGN)]\n        vb = pow_convol(va, k, p)\n        for i in range(LOGN):\n            fc[i][j] = vb[i]\n    # inverse transform\n    res = [0] * n\n    for i in range(LOGN):\n        transform(fc[i], n, p, 1)\n        for j in range(n):\n            if bit_count(j) == i:\n                res[j] = fc[i][j] % p\n    return res\n\n# ------------------------------------------------------------\n# Main solve\n# ------------------------------------------------------------\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    n, k, p = map(int, data[:3])\n\n    nn = n\n    # prepare f[] mapping\n    maxn = 1000005\n    f = [0] * maxn  # but may need up to nn+1, assume nn < maxn\n    for i in range(n + 1):\n        if (n & i) == i:\n            t = 0\n            for j in range(20):\n                if (n >> j) & 1:\n                    t <<= 1\n                    t |= (i >> j) & 1\n            f[t] = i\n            nn = t\n\n    if n & 1:\n        print(fpow(k, n, p))\n        return\n\n    # factorials\n    fac = [1] * maxn\n    for i in range(1, maxn):\n        fac[i] = (fac[i-1] * i) % p\n    ifac = [0] * maxn\n    for i in range(maxn):\n        ifac[i] = inv(fac[i], p)\n\n    # build a\n    a = [0] * (nn + 1)\n    for i in range(nn + 1):\n        a[i] = ifac[f[i]]\n\n    total = fpow(k, n, p)\n    a = subset_pow_convol(a, k, p)\n    total = (total - (a[nn] * fac[n]) % p) % p\n    if total < 0:\n        total += p\n    print(total)\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.880697714630514e-05, -1.1920928244535389e-07, -9.536738616588991e-07, -0.00292932684533298, -0.02367768995463848, -2.1457441107486375e-05, -0.31348663568496704, -0.041479773819446564, -4.9828242481453344e-05, -0.008625631220638752, -1.5161561965942383, -1.5568686723709106, -0.08754725754261017, -0.0067200856283307076, -0.08067537844181061, -1.402333378791809, -0.0018962513422593474, -0.1536293923854828, -0.2031397521495819, -1.3112935448589269e-05, -2.1457441107486375e-05, -0.06197265535593033, -0.009519422426819801, -0.013817725703120232, -4.023898124694824, -2.9205850296420977e-05, -0.20160560309886932, -7.390948667307384e-06, -0.07482340931892395, -0.0031843690667301416, -9.536738616588991e-07, -3.2186455882765586e-06, -2.0265558760002023e-06, -0.00015841660206206143, -1.1920928244535389e-07, -0.0013756821863353252, -0.018254846334457397, -2.4262077808380127, -4.124556289752945e-05, -0.007664794567972422, -0.00010168035078095272, -1.1920928244535389e-07, -2.622600959512056e-06, -0.01823330856859684, -0.0007514513563364744, -1.1920928244535389e-07, -0.43681249022483826, -3.576278118089249e-07, -5.829164365422912e-05, -0.008619958534836769, -3.3378546504536644e-06, -1.3351351299206726e-05, -8.583032467868179e-06, -0.0067573841