      infect_time[ni][nj] = infect_time[i][j] + 1\n                q.append((ni, nj))\n\n    # reach_time from each empty cell\n    reach_time = [[[[ -1 for _ in range(n)] for _ in range(n)] for _ in range(n)] for _ in range(n)]\n    for i in range(n):\n        for j in range(n):\n            if g[i][j] == '.':\n                reach_time[i][j][i][j] = 0\n                q = deque()\n                q.append((i, j))\n                while q:\n                    ii, jj = q.popleft()\n                    if infect_time[ii][jj] == -1 or reach_time[i][j][ii][jj] < infect_time[ii][jj]:\n                        for d in range(4):\n                            ni = ii + di[d]\n                            nj = jj + dj[d]\n                            if 0 <= ni < n and 0 <= nj < n and g[ni][nj] == '.':\n                                if (infect_time[ni][nj] == -1 or reach_time[i][j][ii][jj] + 1 <= infect_time[ni][nj]) and reach_time[i][j][ni][nj] == -1:\n                                    reach_time[i][j][ni][nj] = reach_time[i][j][ii][jj] + 1\n                                    q.append((ni, nj))\n\n    # Max flow (Dinic)\n    V = 2 * n * n + 2\n    src = 2 * n * n\n    sink = 2 * n * n + 1\n    INF = 10 ** 9\n\n    c = [[0] * V for _ in range(V)]\n    f = [[0] * V for _ in range(V)]\n    d = [0] * V\n    p = [0] * V\n    adj = [[] for _ in range(V)]\n    adj_ptr = [0] * V\n\n    def add_edge(u, v, cap):\n        adj[u].append(v)\n        adj[v].append(u)\n        c[u][v] += cap\n\n    def make_level_graph(s, t):\n        for i in range(V):\n            d[i] = -1\n        d[s] = 0\n        q = deque()\n        q.append(s)\n        while q:\n            u = q.popleft()\n            for v in adj[u]:\n                if c[u][v] - f[u][v] > 0 and d[v] == -1:\n                    d[v] = d[u] + 1\n                    q.append(v)\n        return d[t] != -1\n\n    def dfs(u, t):\n        if u == t:\n            return True\n        while adj_ptr[u] < len(adj[u]):\n            v = adj[u][adj_ptr[u]]\n            if d[v] == d[u] + 1 and c[u][v] - f[u][v] > 0:\n                if dfs(v, t):\n                    p[v] = u\n                    return True\n            adj_ptr[u] += 1\n        return False\n\n    def find_aug_path(s, t):\n        for i in range(V):\n            p[i] = -1\n        p[s] = 0\n        return dfs(s, t)\n\n    def max_flow(s, t):\n        flow = 0\n        while make_level_graph(s, t):\n            for i in range(V):\n                adj_ptr[i] = 0\n            while find_aug_path(s, t):\n                b = INF\n                v = t\n                while v != s:\n                    u = p[v]\n                    b = min(b, c[u][v] - f[u][v])\n                    v = u\n                v = t\n                while v != s:\n                    u = p[v]\n                    f[u][v] += b\n                    f[v][u] -= b\n                    v = u\n                flow += b\n        return flow\n\n    # Build graph\n    for i in range(n):\n        for j in range(n):\n            if n_scientists[i][j]:\n                add_edge(src, i * n + j, n_scientists[i][j])\n            if n_rescue[i][j]:\n                add_edge(n * n + i * n + j, sink, n_rescue[i][j])\n    for i in range(n):\n        for j in range(n):\n            for ii in range(n):\n                for jj in range(n):\n                    if 0 <= reach_time[i][j][ii][jj] <= t:\n                        add_edge(i * n + j, n * n + ii * n + jj, INF)\n\n    print(max_flow(src, sink))\n\nif __name__ == \"__main__\":\n    solve()\n</translated_code>\n<confidence>\n0.95\n</confidence>", "token_logprobs": [-8.344646857949556e-07, -1.1920928244535389e-07, 0.0, -0.00033718624035827816, -0.0002543602604418993, 0.0, -1.4305104514278355e-06, -1.1920928244535389e-07, 0.0, 0.0, 0.0, -0.00023541064001619816, -0.005280476063489914, -1.5139465176616795e-05, -0.006720203906297684, -2.145764938177308e-06, -0.01164272241294384, -0.02063777670264244, -2.3841855067985307e-07, 0.0, 