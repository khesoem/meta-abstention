ublic class Main {\n    static final long M = 1000000007L;\n\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int T = 1;\n\n        for (int _ = 0; _ < T; _++) {\n            process(scanner);\n        }\n        scanner.close();\n    }\n\n    static void process(Scanner scanner) {\n        int P, K;\n        String[] parts = scanner.nextLine().split(\" \");\n        P = Integer.parseInt(parts[0]);\n        K = Integer.parseInt(parts[1]);\n\n        int[] k = new int[P];\n        for (int x = 0; x < P; x++) {\n            k[x] = (int)((long)K * x % P);\n        }\n\n        if (K == 0) {\n            System.out.println(modPow(P, P - 1, M));\n            return;\n        }\n\n        int[] f = new int[P];\n        int[] c = new int[P];\n        long ans = 1;\n\n        for (int i = 0; i < P; i++) {\n            if (f[i] != 0) continue;\n\n            int cnt = 1;\n            int u = i;\n            f[u] = 1;\n            while (f[k[u]] == 0) {\n                u = k[u];\n                f[u] = 1;\n                cnt++;\n            }\n            c[cnt]++;\n        }\n\n        for (int i = 1; i < P; i++) {\n            if (c[i] != 0) {\n                long cntVal = i * c[i] + (i > 1 ? c[1] : 0);\n                ans = (ans * modPow(cntVal, c[i], M)) % M;\n            }\n        }\n\n        System.out.println(ans);\n    }\n\n    static long modPow(long base, int exp, long mod) {\n        long result = 1;\n        base %= mod;\n        while (exp > 0) {\n            if ((exp & 1) == 1) {\n                result = (result * base) % mod;\n            }\n            base = (base * base) % mod;\n            exp >>= 1;\n        }\n        return result;\n    }\n}\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.001457139616832137, -0.0013189311139285564, -6.704273118884885e-07, -6.027225754223764e-05, -0.0032136032823473215, -1.9361264946837764e-07, -9.73446003627032e-05, -0.030564198