D;\n    }\n    public static long sub(long x, long y) {\n        x -= y;\n        if (x < 0) x += MOD;\n        return x;\n    }\n    public static long mult(long x, long y) {\n        return (x * y) % MOD;\n    }\n    public static long modpow(long x, long p) {\n        if (p == 0) return 1;\n        if ((p & 1) != 0) return mult(x, modpow(x, p - 1));\n        return modpow(mult(x, x), p >> 1);\n    }\n    public static long modinv(long x) {\n        return modpow(x, MOD - 2);\n    }\n\n    public static int n;\n    public static long[][] A;\n    public static long[][][] T = new long[8][1 << 7][1 << 7];\n    public static ArrayList<HashMap<Long, Long>> DP;\n    public static int[] family;\n    public static int[] family_id;\n    public static ArrayList<ArrayList<Integer>> family_mask;\n\n    public static void calc() {\n        int totalMasks = 1 << n;\n        family = new int[totalMasks];\n        family_id = new int[totalMasks];\n        family_mask = new ArrayList<>(n + 1);\n        for (int i = 0; i <= n; i++) {\n            family_mask.add(new ArrayList<>());\n        }\n        for (int mask = 1; mask < totalMasks; mask++) {\n            family[mask] = family[mask >> 1] + (mask & 1);\n        }\n        for (int mask = 0; mask < totalMasks; mask++) {\n            int cnt = family[mask];\n            family_id[mask] = family_mask.get(cnt).size();\n            family_mask.get(cnt).add(mask);\n        }\n        for (int k = 0; k <= n; k++) {\n            ArrayList<Integer> listK = family_mask.get(k);\n            int sizeK = listK.size();\n            for (int i = 0; i < sizeK; i++) {\n                int cm = listK.get(i);\n                for (int mask = 0; mask < totalMasks; mask++) {\n                    if ((mask & cm) == mask) continue;\n                    long ans = 0;\n                    for (int x = 0; x < n; x++) {\n                        if ((cm & (1 << x)) != 0) continue;\n                        if ((mask & (1 << x)) == 0) continue;\n                        int newmask = cm | (1 << x);\n                        ans |= (1L << family_id[newmask]);\n                    }\n                    T[k][i][mask] = ans;\n                }\n            }\n        }\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringTokenizer st = new StringTokenizer(br.readLine());\n        n = Integer.parseInt(st.nextToken());\n        A = new long[n][n];\n        for (int i = 0; i < n; i++) {\n            st = new StringTokenizer(br.readLine());\n            for (int j = 0; j < n; j++) {\n                long val = Long.parseLong(st.nextToken());\n                A[i][j] = mult(val, modinv(100));\n            }\n        }\n        calc();\n        DP = new ArrayList<>(n + 1);\n        for (int i = 0; i <= n; i++) {\n            DP.add(new HashMap<>());\n        }\n        DP.get(0).put(1L, 1L);\n        int totalMasks = 1 << n;\n        for (int k = 0; k < n; k++) {\n            HashMap<Long, Long> cur = DP.get(k);\n            for (int edges = 0; edges < totalMasks; edges++) {\n                long prob = 1;\n                for (int i = 0; i < n; i++) {\n                    if ((edges & (1 << i)) != 0) {\n                        prob = mult(prob, A[k][i]);\n                    } else {\n                        prob = mult(prob, sub(1, A[k][i]));\n                    }\n                }\n                ArrayList<Integer> listK = family_mask.get(k);\n                int sizeK = listK.size();\n                for (Map.Entry<Long, Long> entry : cur.entrySet()) {\n                    long mask = entry.getKey();\n                    long p = mult(prob, entry.getValue());\n                    long newmask = 0;\n                    for (int i = 0; i < sizeK; i++) {\n                        if ((mask & (1L << i)) != 0) {\n                            newmask |= T[k][i][edges];\n                        }\n               