ntA[v1+v2] and v2 >= self.cntB[v1+v2]:\n                total = v1 + v2\n                v1 -= self.cntA[total]\n                v2 -= self.cntB[total]\n                return self.ch[v1+v2][v1]\n            else:\n                return 0\n        ans = 0\n        c = self.str[v1+v2-1]\n        if c != 'B':\n            cur = self.ch[v1][self.R] - self.ch[v1-1][self.R]\n            other = self.ch[v2][self.R]\n            ans += self.solve(x, y + cur * other, v1-1, v2)\n        if c != 'A':\n            cur = self.ch[v2][self.R] - self.ch[v2-1][self.R]\n            other = self.ch[v1][self.R]\n            ans += self.solve(x + cur * other, y, v1, v2-1)\n        self.cache[key] = ans\n        return ans\n\n    def start(self):\n        data = sys.stdin.buffer.read().split()\n        data = [x.decode() for x in data]\n        self.tokens = data\n        self.token_idx = 0\n        self.R = self.read_int()\n        self.C = self.read_int()\n        max_n = 2 * (self.R + self.C)\n        self.ch = [[0]*(max_n+1) for _ in range(max_n+1)]\n        for i in range(max_n+1):\n            for j in range(i+1):\n                if j == 0 or j == i:\n                    self.ch[i][j] = 1\n                else:\n                    self.ch[i][j] = self.ch[i-1][j-1] + self.ch[i-1][j]\n        x = 0\n        y = 0\n        v1 = self.R + self.C\n        v2 = self.R + self.C\n        while v1 >= self.R and v2 >= self.R:\n            if x > y:\n                cur = self.ch[v1][self.R] - self.ch[v1-1][self.R]\n                other = self.ch[v2][self.R]\n                y += cur * other\n                v1 -= 1\n            else:\n                cur = self.ch[v2][self.R] - self.ch[v2-1][self.R]\n                other = self.ch[v1][self.R]\n                x += cur * other\n                v2 -= 1\n        self.best = abs(x - y)\n        self.dfs(0, 0, self.R + self.C, self.R + self.C)\n        self.str = self.read_string()\n        n = len(self.str)\n        self.cntA = [0]*(n+1)\n 