    self.h[self.source] = self.n\n            self.h[idx] = minH\n        return maxCap - l\n\n    def solve(self, source, sink):\n        if source == sink:\n            return INF\n        self.sink = sink\n        self.source = source\n        self.flow = [[0]*MAXN for _ in range(MAXN)]\n        self.h = [0]*MAXN\n        self.vh = [0]*MAXN\n        ans = 0\n        while self.h[source] != self.n:\n            ans += self.sap(source, INF)\n        return ans\n\nsap = SAP()\n\nclass Node:\n    def __init__(self, x, y, step=0):\n        self.x = x\n        self.y = y\n        self.step = step\n\nn = 0\nt = 0\nsx, sy = 0, 0\ndx = [0, 0, -1, 1]\ndy = [-1, 1, 0, 0]\nmat1 = [['']*MAXN for _ in range(MAXN)]\nmat2 = [['']*MAXN for _ in range(MAXN)]\nflag = [[0]*MAXN for _ in range(MAXN)]\nvis = [[0]*MAXN for _ in range(MAXN)]\n\ndef ID(i, j):\n    return (i - 1) * n + j\n\ndef check(x, y):\n    if x < 1 or x > n or y < 1 or y > n:\n        return False\n    return True\n\ndef BFS1():\n    global sx, sy\n    Q = deque()\n    now = Node(sx, sy, 0)\n    Q.append(now)\n    for i in range(MAXN):\n        for j in range(MAXN):\n            flag[i][j] = 10**9\n            vis[i][j] = 0\n    vis[now.x][now.y] = 1\n    while Q:\n        now = Q.popleft()\n        flag[now.x][now.y] = now.step\n        if now.step > t:\n            break\n        for k in range(4):\n            x = now.x + dx[k]\n            y = now.y + dy[k]\n            if check(x, y) and mat1[x][y] != 'Y' and not vis[x][y]:\n                next_node = Node(x, y, now.step + 1)\n                vis[x][y] = 1\n                Q.append(next_node)\n\ndef BFS2(i, j):\n    Q = deque()\n    now = Node(i, j, 0)\n    Q.append(now)\n    for ii in range(MAXN):\n        for jj in range(MAXN):\n            vis[ii][jj] = 0\n    vis[now.x][now.y] = 1\n    while Q:\n        now = Q.popleft()\n        if now.step > t:\n            break\n        if flag[now.x][now.y] < now.step:\n            continue\n        if flag[now.x][now