translated_code>\nimport sys\nimport math\n\nINF = int(1e8)\n\nclass Node:\n    def __init__(self):\n        self.left = None\n        self.right = None\n        self.batchSetValue = 0\n        self.dirty = False\n        self.min = INF\n\n    def pushUp(self):\n        self.min = min(self.left.min if self.left else INF,\n                       self.right.min if self.right else INF)\n\n    def setValue(self, val):\n        self.min = val\n        self.batchSetValue = val\n        self.dirty = True\n\n    def pushDown(self):\n        if self.dirty:\n            if self.left:\n                self.left.setValue(self.batchSetValue)\n            if self.right:\n                self.right.setValue(self.batchSetValue)\n            self.dirty = False\n\n    def toArray(self, l, r, data):\n        if l == r:\n            data[l] = self.min\n            return\n        self.pushDown()\n        m = (l + r) // 2\n        if self.left:\n            self.left.toArray(l, m, data)\n        if self.right:\n            self.right.toArray(m + 1, r, data)\n\n    def fromArray(self, l, r, data):\n        if l == r:\n            self.min = data[l]\n            return\n        self.dirty = False\n        m = (l + r) // 2\n        if not self.left:\n            self.left = Node()\n        if not self.right:\n            self.right = Node()\n        self.left.fromArray(l, m, data)\n        self.right.fromArray(m + 1, r, data)\n        self.pushUp()\n\n    @staticmethod\n    def build(l, r):\n        node = Node()\n        if l != r:\n            m = (l + r) // 2\n            node.left = Node.build(l, m)\n            node.right = Node.build(m + 1, r)\n        return node\n\n    @staticmethod\n    def query(f, t, l, r, node):\n        if f > r or t < l:\n            return INF\n        if f <= l and r <= t:\n            return node.min\n        node.pushDown()\n        m = (l + r) // 2\n        return min(\n            Node.query(f, t, l, m, node.left),\n            Node.query(f, t, m + 1, r, node.right)\n        )\n\n    @staticmethod\n    def update(i, l, r, val, node):\n        if i > r or i < l:\n            return\n        if l == r:\n            node.min = min(node.min, val)\n            return\n        node.pushDown()\n        m = (l + r) // 2\n        if not node.left:\n            node.left = Node()\n        if not node.right:\n            node.right = Node()\n        Node.update(i, l, m, val, node.left)\n        Node.update(i, m + 1, r, val, node.right)\n        node.pushUp()\n\n\ndef solve():\n    n = int(input())\n    k = int(input())\n\n    intervals = [[0, 0]] + [[int(input()), int(input())] for _ in range(k)]\n    intervals.append([2 * n, 2 * n])\n    k += 1\n\n    loop = [Node.build(0, n), Node.build(0, n)]\n    data = [0] * (n + 1)\n\n    for i in range(1, k+1):\n        curDp = loop[i & 1]\n        lastDp = loop[(i - 1) & 1]\n\n        interval = intervals[i]\n        intervalLength = interval[1] - interval[0]\n        middleLength = interval[0] - intervals[i - 1][1]\n\n        # Convert lastDp to array\n        lastDp.toArray(0, n, data)\n        array_length = min(len(data), intervalLength + middleLength)\n        # Copy data with offset\n        for idx in range(len(data) - 1, -1, -1):\n            if idx + array_length <= n:\n                data[idx + array_length] = data[idx]\n        # Fill first part with INF\n        for j in range(min(len(data), intervalLength + middleLength)):\n            data[j] = INF\n\n        minX = interval[1] - middleLength - intervalLength\n        maxX = interval[1] - middleLength\n        for j in range(n + 1):\n            minNeedTime = Node.query(minX - j, maxX - j, 0, n, lastDp)\n            data[j] = min(data[j], minNeedTime + 1)\n\n        for j in range(n + 1):\n            minNeedTime = Node.query(j - middleLength - intervalLength, j - middleLength, 0, n, lastDp)\n            data[j] = min(data[j], minNeedTime + 2)\n\n        # rebuild current DP from array\n        curDp.fromArray(0, n, data)\n\n    minFlipTime = Node.query(n, n, 0, n, loop[k & 1])\n    if minFlipTime < INF:\n        print(\"Full\")\n        print(minFlipTime)\n    else:\n        print(\"Hungry\")\n\n\nsolve()\n\n</translated_code>\n<confidence>\n0.9\n</confidence>", "token_logprobs": [-0.0033390752505511045, -0.0016613778425380588, -1.3856492842023727e-06, -0.00029518234077841043, -0.07754430919885635, -7.941850526549388e-06, -0.11315375566482544, -0.0031210333108901978, -0.0031275674700737, -0.01693643443286419, -0.007219807710498571, -5.080963092041202e-06, -0.08894917368888855, -3.128163257315464e-07, -1.9361264946837764e-07, -1.0280383548888494e-06, -2.4391956685576588e-05, -0.03214799612760544, -0.08538425713777542, -0.0003479785518720746, -5.319370302458992e-06, -1.1875571544806007e-05, -0.006720705423504114, -6.704273118884885e-07, 0.0, 0.0, 0.0, -0.10027007013559341, -1.9361264946837764e-07, -6.265633419388905e-05, -2.45848218582978e-06, -5.319370302458992e-06, -3.128163257315464e-07, -2.5776860184123507e-06, 0.0, 0.0, -1.9361264946837764e-07, -1.7432603272027336e-06, -6.704273118884885e-07, -1.3856492842023727e-06, -3.128163257315464e-07, -3.173704271830502e-06, -0.00010986098641296849, -0.1798514872789383, -0.00010986098641296849, -1.3856492842023727e-06, -0.02107418142259121, -1.5048530030981055e-06, -1.1756367712223437e-05, 0.0, -4.320199877838604e-07, -5.080963092041202e-06, -1.9361264946837764e-07, -4.320199877838604e-07, -1.1472419600977446e-06, -9.014684110297821e-06, -3.128163257315464e-07, -7.465036105713807e-06, -1.5048530030981055e-06, -0.002160256262868643, -0.12581279873847961, -0.020950792357325554, -8.304016228066757e-05, -0.31328609585762024, -0.7576141357421875, -0.03952917084097862, -1.8624639324116288e-06, -3.128163257315464e-07, -1.9361264946837764e-07, -0.03382031247019768, -4.127333340875339e-06, -9.088346359931165e-07, -2.2961512513575144e-05, -0.018867412582039833, -1.1472419600977446e-06, -4.56102097814437e-05, -0.8981605768203735, -3.12816325731546