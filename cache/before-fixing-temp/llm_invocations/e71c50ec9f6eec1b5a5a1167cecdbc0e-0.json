\n    }\n    return result;\n}\n\nint main() {\n    long long p, k;\n    cin >> p >> k;\n\n    if (k == 0) {\n        cout << modpow(p, p - 1, MOD) << endl;\n    } else if (k == 1) {\n        cout << modpow(p, p, MOD) << endl;\n    } else {\n        long long ord_k = 1;\n        long long k_pow_ord = k % p;\n        while (k_pow_ord != 1) {\n            ord_k++;\n            k_pow_ord = (k * k_pow_ord) % p;\n        }\n        long long comps = (p - 1) / ord_k;\n        cout << modpow(p, comps, MOD) << endl;\n    }\n\n    return 0;\n}\n</translated_code>\n<confidence>\n1.0\n</confidence>", "token_logprobs": [-3.8742269680369645e-05, -1.1920928244535389e-07, -7.152555099310121e-07, -0.0024824298452585936, -1.8954096958623268e-05, -7.510157047363464e-06, -0.008777488023042679, -0.006750516593456268, -0.1369432657957077, -7.152555099310121e-07, -0.15208622813224792, -1.5024161338806152, -0.1660487800836563, -1.4424220353248529e-05, 0.0, -0.004087427631020546, -0.20348061621189117, -0.002479457063600421, -2.264974000354414e-06, -1.0728830375228426e-06, -2.3841855067985307e-07, -8.344646857949556e-07, -0.00015853578224778175, -1.1920928244535389e-07, 0.0, -2.3841830625315197e-06, -0.4743092954158783, -0.00012468514614738524, -0.014165212400257587, 0.0, -0.0031184160616248846, -2.13458251953125, -1.6689286894688848e-06, 0.0, -0.001939084380865097, 0.0, -2.0265558760002023e-06, 0.0, -0.00017534149810671806, -0.1002325713634491, -1.1920928244535389e-07, 0.0, -9.917721035890281e-05, -3.504691630951129e-05, -4.768370445162873e-07, -0.00010024998482549563, -0.00019405389321036637, 0.0, -0.04860583692789078, -3.576278118089249e-07, 0.0, 0.0, -0.23270246386528015, 0.0, -0.008649386465549469, -0.023245446383953094, -7.152555099310121e-07, -2.0265558760002023e-06, -1.0728830375228426e-06, 0.0, -2.884823152271565e-05, -0.00026127262390218675, 0.0, -0.0002618685248307884, 0.0, -1.1920928244535389e-07, -7.152555099310121e-07, -1.1920928244535389e-07, 0.0, 0.0, -1.1920928244535389e-07